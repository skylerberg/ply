//! HTML tokenizing, a safe `Html` type, the `html` literal that builds it, and escaping and
//! decoding of character references.
//!
//! An `Html` never treats ordinary text as markup. A `String` becomes part of an `Html` only
//! through `text`, and `render` escapes it, so a value cannot open a tag, close an attribute or
//! start a character reference.
//!
//! Tokenizer: a `Cursor` reads bytes as the HTML Living Standard's tokenizer does (section 13.2.5).
//! `tokens` returns the sequence of tokens it reads: a doctype, start and end tags with their
//! attributes, comments, processing instructions, text with its character references decoded, and
//! the end of the input. Tokenizing never fails on bad input. Each parse error the standard defines
//! is returned as a `Problem`, which names the standard's error in `code` and the token where it
//! was found. Bytes that are not valid UTF-8 are decoded as the standard's decoder does: each bad
//! sequence becomes U+FFFD, and a carriage return becomes a line feed. `Limits` bounds the number
//! of tokens, the attributes of one tag, the bytes of a name or value, and the total bytes of all
//! tokens. Exceeding a limit raises `html.fail`.
//!
//! The standard leaves the switch into its text states (RCDATA, RAWTEXT, script data, PLAINTEXT,
//! CDATA) to the tree builder. `cursor`, `next` and `with_state` let a caller make that switch.
//! `markup_cursor` makes it for the elements whose content can be tokenized without a tree builder:
//! `title`, `textarea`, `style`, `xmp`, `iframe`, `noembed`, `noframes`, `script` and `plaintext`.
//!
//! Literal: with `import std.html`, `html"<p class={kind}>{name}</p>"` is an `Html`. The checker
//! tokenizes the literal's text as markup. It rejects a parse error, a tag, quote or comment left
//! open, and a hole in a place where its value would be read as more than characters. A hole is a
//! `{...}` placeholder, and the value placed in it must be an `Html`.
//!
//! In an element's content, a hole inserts the `Html`'s markup as it is. Inside a quoted attribute
//! value, a `title` or a `textarea`, it inserts only the characters. When the hole is the whole
//! value of an attribute, as with `class` above, the value is written in quotes. A `String` becomes
//! an `Html` only through `text`.
//!
//! A hole may not appear where its characters would be read as another language: in a tag outside
//! an attribute value, in a comment, in a `script` or `style` element, or in an event handler,
//! `style` or `srcdoc` attribute. In an attribute whose value is a URL (`href`, `src`, `srcset`,
//! `ping`, the `content` of a refresh, and similar), the hole's value is percent-encoded as part of
//! the URL. If the value would give the URL a scheme other than `http`, `https`, `mailto` or `tel`,
//! it raises `html.unsafe_url`, unless it came from `trusted_url`.
//!
//! Escaping: `escape` escapes text for any place a hole may appear. `escape_text` and
//! `escape_attribute` each escape for one place. `unescape` decodes character references as the
//! tokenizer does, using the table of names in `entities.json`, which a build reads once. `license`
//! is the notice the table is distributed under.
//!
//! Templates at run time: `std.template` fills in markup at run time using the same tokenizer state
//! that checks the literal. `reader` returns the state at the start of a text, `run` continues from
//! a given state through another piece of text and returns the state at its end, `hole` reports how
//! a value is inserted in a given state, and `join` merges two states reached by different paths
//! when they behave alike. A `Draft` is a sequence of text pieces and holes in the order they were
//! read. Finishing a `Draft` returns an `Html`, so text in it is still never treated as markup.

import std.bytes (hex_value, is_digit, is_letter)
import std.gen
import std.gen (Gen)
import std.json
import std.json (Json)
import std.laws (inverse)
import std.list
import std.option
import std.seq
import std.seq (Seq)
import std.string
import std.url (url_encode)
import std.value (VCtor, VList, VRecord, VStr, Value, reflect)

/// A part of a document: markup written out as it is, characters that are escaped when written,
/// or a URL the program vouches for. Only this module creates one, so no caller's text is
/// markup.
pub opaque type Piece = | Markup(String) | Chars(String) | Trusted(String)

/// A fragment of a document's content, in the order it is written. Only this module builds one,
/// so its markup is text this module read as markup and every other string in it came through
/// `text` or `trusted_url`.
pub opaque type Html = new { pieces: List<Piece> }

/// `s` as character data: whatever it contains is read as text, in content and in an attribute.
pub fn text(s: String) -> Html = { pieces: [Chars(s)] }

/// `url` as a URL the program vouches for. In a hole that is a URL, it may give the URL any
/// scheme, and is still percent-encoded. Anywhere else it is `text(url)`. Never make one from
/// unchecked text that came from outside the program.
pub fn trusted_url(url: String) -> Html = { pieces: [Trusted(url)] }

/// The fragments one after another, with nothing between them.
pub fn fragment(parts: List<Html>) -> Html = { pieces: parts.flat_map(|h: Html| h.pieces) }

fn piece_text(piece: Piece) -> String =
  match piece { Markup(m) -> m, Chars(s) -> s, Trusted(u) -> u }

/// The document text of `h`: its markup as it is, and its characters escaped.
pub fn render(h: Html) -> String / {abort.raise} =
  String::of_bytes(
    Bytes::concat_all(
      h.pieces.map(|piece: Piece|
        Bytes::of_string(match piece {
          Markup(m) -> m,
          Chars(s) -> escape(s),
          Trusted(u) -> escape(u),
        })),
    ),
  )

fn piece_bytes(h: Html) -> List<Bytes> =
  h.pieces.map(|piece: Piece| Bytes::of_string(piece_text(piece)))

fn raw_text(h: Html) -> String = String::of_bytes_lossy(Bytes::concat_all(piece_bytes(h)))

/// Returns the number of bytes in `h`: its markup plus its characters before escaping. The rendered
/// text of `h` is never shorter than this, and is at most six times as long, because escaping turns
/// one byte into at most six (`"` becomes `&quot;`).
pub fn size(h: Html) -> Int = piece_bytes(h).fold(0, |n: Int, piece: Bytes| n + piece.len())

/// A URL a fragment contains: its text, and whether the program vouches for all of it.
pub type UrlText = { text: String, trusted: Bool }

/// The URL that `h` gives when a hole is a URL: its characters, trusted if `h` is made only of
/// `trusted_url`s. `None` if `h` contains markup, which is never a URL.
pub fn url_text(h: Html) -> Option<UrlText> =
  if contains_markup(h) { None } else {
    Some({
      text: raw_text(h),
      trusted: h.pieces.len() > 0
        && h.pieces.fold(true, |all: Bool, p: Piece|
          all && (match p { Trusted(_) -> true, _ -> false })),
    })
  }

fn contains_markup(h: Html) -> Bool =
  h.pieces.fold(false, |problem: Bool, p: Piece|
    problem || (match p { Markup(_) -> true, _ -> false }))

/// The fragment that `v` represents, when `v` is what `reflect` returns for an `Html`, and `None`
/// for any other value. This is how a fragment stored in data is told apart from a text. Anyone
/// can build a `Value`, so this trusts `v` to come from `reflect`. A value read from outside a
/// program, such as a JSON document, has no constructor and is never a fragment.
pub fn of_value(v: Value) -> Option<Html> =
  match v { VRecord([{ name: "pieces", value: VList(shown) }]) -> html_of_values(shown), _ -> None }

fn html_of_values(shown: List<Value>) -> Option<Html> =
  match Option::traverse(shown, piece_of_value) {
    Some(pieces) -> Some({ pieces: pieces }),
    None -> None,
  }

fn piece_of_value(v: Value) -> Option<Piece> =
  match v {
    VCtor("std.html.Markup", [VStr(markup)]) -> Some(Markup(markup)),
    VCtor("std.html.Chars", [VStr(chars)]) -> Some(Chars(chars)),
    VCtor("std.html.Trusted", [VStr(url)]) -> Some(Trusted(url)),
    _ -> None,
  }

type Escape = { raw: String, written: String }

fn basic_escapes() -> List<Escape> =
  [{ raw: "&", written: "&amp;" }, { raw: "<", written: "&lt;" }, { raw: ">", written: "&gt;" }]

fn quote_escape() -> Escape = { raw: "\"", written: "&quot;" }

fn escape_with(s: String, references: List<Escape>) -> String =
  references.fold(s, |out: String, r: Escape| out.replace(r.raw, r.written))

/// Escapes `&`, `<`, `>`, `"` and `'` in `s` as character references. The result is safe as text in
/// an element's content and as an attribute value between either kind of quotes.
pub fn escape(s: String) -> String =
  escape_with(s, basic_escapes().push(quote_escape()).push({ raw: "'", written: "&#39;" }))

/// Escapes `&`, `<` and `>` in `s`, for text in an element's content, where a quote is an
/// ordinary character. It is not safe as an attribute value: use `escape_attribute` there.
pub fn escape_text(s: String) -> String = escape_with(s, basic_escapes())

/// Escapes `&`, `<`, `>` and `"` in `s`, for the value of an attribute written between double
/// quotes. Between single quotes a `'` would end the value, so use `escape` there.
pub fn escape_attribute(s: String) -> String = escape_with(s, basic_escapes().push(quote_escape()))

/// Decodes each character reference in `s` as the character it names, as the tokenizer reads text
/// in an element's content. A reference is a name from the standard's table with its `;`; or,
/// without a `;`, the longest name the table allows bare, even when more letters follow it; or a
/// number, in decimal or after an `x` in hexadecimal, with or without its `;`. A number that is
/// zero, a surrogate or past U+10FFFF becomes U+FFFD, and one from 0x80 to 0x9F becomes the
/// character Windows-1252 has there. An `&` that begins none of these stays as it is, so every
/// text has a result.
pub fn unescape(s: String) -> String / {abort.raise} = unescaped(s, false)

/// Like `unescape`, for the value of an attribute. There a name without its `;` is left as written
/// when a letter, a digit or `=` follows it, so the `&name=` parameters of a query string stay.
pub fn unescape_attribute(s: String) -> String / {abort.raise} = unescaped(s, true)

/// The notice the table of named character references is distributed under: who made it, where
/// it is published, and the licences that allow copying it.
pub fn license() -> String / {abort.raise} = String::of_bytes(embed("html/LICENSE"))

type NamedReferences = { named: Map<Bytes, Bytes>, bare: Int }

const fn names() -> NamedReferences = names_in(embed("html/entities.json"))

fn names_in(file: Bytes) -> NamedReferences / {abort.raise} =
  match json::parse(file) {
    Ok(json::Object(entries)) ->
      entries.fold(
        { named: Map::new(), bare: 0 },
        |table: NamedReferences, name: String, entry: Json| {
          let key = Bytes::of_string(name.slice(1, name.len()));
          match json::get(entry, "characters") {
            Some(json::Str(characters)) ->
              {
                named: table.named.insert(key, Bytes::of_string(characters)),
                bare: if key.ends_with(b";") { table.bare } else { max(table.bare, key.len()) },
              },
            _ -> panic("`" ++ name ++ "` names no characters"),
          }
        },
      ),
    _ -> panic("the table of named character references is no JSON object"),
  }

type Reference = { characters: Bytes, next: Int, problems: List<Problem> }

type UnescapeState = { from: Int, amp: Option<Int>, pieces: List<Bytes> }

fn unescaped(s: String, attribute: Bool) -> String / {abort.raise} = {
  let text = Bytes::of_string(s);
  match text.index_of(b"&") {
    None -> s,
    Some(first) -> {
      let table = names();
      let pieces = iterate(
        { from: 0, amp: Some(first), pieces: [] },
        text.len() + 1,
        |at: UnescapeState|
          match at.amp {
            None -> Stop(at.pieces.push(text.slice(at.from, text.len()))),
            Some(amp) -> match read_reference(text, amp, table, attribute, true) {
              None -> Continue({ ..at, amp: text.index_of_from(b"&", amp + 1) }),
              Some(read) ->
                Continue({
                  from: read.next,
                  amp: text.index_of_from(b"&", read.next),
                  pieces: at.pieces.push(text.slice(at.from, amp)).push(read.characters),
                }),
            },
          },
      );
      String::of_bytes(Bytes::concat_all(pieces))
    },
  }
}

fn alphanumerics() -> Bytes = b"0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"

fn read_reference(
  text: Bytes,
  amp: Int,
  table: NamedReferences,
  attribute: Bool,
  ended: Bool,
) -> Option<Reference> / {abort.raise} = {
  let c = text.peek(amp + 1);
  if c < 0 && !ended { None }
  else if c == b'#' { numeric_reference(text, amp, ended) }
  else if is_letter(c) || is_digit(c) { named_reference(text, amp, table, attribute, ended) }
  else { Some({ characters: b"&", next: amp + 1, problems: [] }) }
}

fn problem(error: ParseError, offset: Int) -> Problem = { error: error, offset: offset }

fn numeric_reference(text: Bytes, amp: Int, ended: Bool) -> Option<Reference> / {abort.raise} = {
  let n = text.len();
  let hex = text.peek(amp + 2) == b'x' || text.peek(amp + 2) == b'X';
  let from = if hex { amp + 3 } else { amp + 2 };
  let to = text.skip(from, if hex { b"0123456789abcdefABCDEF" } else { b"0123456789" });
  if to >= n && !ended { None } else if to == from {
    Some({
      characters: text.slice(amp, from),
      next: from,
      problems: [problem(AbsenceOfDigitsInNumericCharacterReference, from)],
    })
  } else {
    let code = range(from, to).fold(0, |k: Int, i: Int|
      min(k * (if hex { 16 } else { 10 }) + hex_value(text.at(i)), 0x110000));
    let closed = text.peek(to) == b';';
    let next = if closed { to + 1 } else { to };
    let missing = if closed { [] } else { [problem(MissingSemicolonAfterCharacterReference, to)] };
    Some({
      characters: character(numeric_reference_character(code)),
      next: next,
      problems: match numeric_reference_error(code) {
        Some(e) -> missing.push(problem(e, next)),
        None -> missing,
      },
    })
  }
}

fn numeric_reference_error(code: Int) -> Option<ParseError> =
  if code == 0 { Some(NullCharacterReference) }
  else if code > 0x10FFFF { Some(CharacterReferenceOutsideUnicodeRange) }
  else if code >= 0xD800 && code <= 0xDFFF { Some(SurrogateCharacterReference) }
  else if noncharacter(code) { Some(NoncharacterCharacterReference) }
  else if code == 0x0D || (is_control_code(code) && code != 9 && code != 10 && code != 12) {
    Some(ControlCharacterReference)
  } else { None }

fn noncharacter(code: Int) -> Bool = (code >= 0xFDD0 && code <= 0xFDEF) || code & 0xFFFE == 0xFFFE

fn is_control_code(code: Int) -> Bool = code < 0x20 || (code >= 0x7F && code <= 0x9F)

fn numeric_reference_character(code: Int) -> Int =
  if code == 0 || code > 0x10FFFF || (code >= 0xD800 && code <= 0xDFFF) { 0xFFFD }
  else if code >= 0x80 && code <= 0x9F {
    match windows_1252().at_or(code - 0x80, 0) { 0 -> code, mapped -> mapped }
  } else { code }

fn windows_1252() -> List<Int> =
  [
    0x20AC,
    0,
    0x201A,
    0x0192,
    0x201E,
    0x2026,
    0x2020,
    0x2021,
    0x02C6,
    0x2030,
    0x0160,
    0x2039,
    0x0152,
    0,
    0x017D,
    0,
    0,
    0x2018,
    0x2019,
    0x201C,
    0x201D,
    0x2022,
    0x2013,
    0x2014,
    0x02DC,
    0x2122,
    0x0161,
    0x203A,
    0x0153,
    0,
    0x017E,
    0x0178,
  ]

fn character(code: Int) -> Bytes =
  match Char::of_int(code) {
    Some(c) -> Bytes::of_string(String::of_chars([c])),
    None -> b"\xef\xbf\xbd",
  }

fn named_reference(
  text: Bytes,
  amp: Int,
  table: NamedReferences,
  attribute: Bool,
  ended: Bool,
) -> Option<Reference> / {abort.raise} = {
  let from = amp + 1;
  let to = text.skip(from, alphanumerics());
  let whole = if text.peek(to) == b';' { table.named.get(text.slice(from, to + 1)) } else { None };
  if to >= text.len() && !ended { None } else {
    match whole {
      Some(characters) -> Some({ characters: characters, next: to + 1, problems: [] }),
      None -> match bare_reference(text, from, to, table) {
        None ->
          Some({
            characters: text.slice(amp, to),
            next: to,
            problems: if text.peek(to) == b';' { [problem(UnknownNamedCharacterReference, to)] }
            else { [] },
          }),
        Some(read) -> {
          let after = text.peek(read.next);
          if attribute && (after == b'=' || is_letter(after) || is_digit(after)) {
            Some({ characters: text.slice(amp, read.next), next: read.next, problems: [] })
          } else {
            Some({
              ..read,
              problems: [problem(MissingSemicolonAfterCharacterReference, read.next)],
            })
          }
        },
      },
    }
  }
}

fn bare_reference(
  text: Bytes,
  from: Int,
  to: Int,
  table: NamedReferences,
) -> Option<Reference> / {abort.raise} =
  iterate(min(to - from, table.bare), table.bare + 1, |k: Int|
    if k < 1 { Stop(None) } else {
      match table.named.get(text.slice(from, from + k)) {
        Some(characters) -> Stop(Some({ characters: characters, next: from + k, problems: [] })),
        None -> Continue(k - 1),
      }
    })

/// A parse error of the HTML tokenizer, using the names the HTML standard gives. `code` returns the
/// name. Two standard errors are left out: `surrogate-in-input-stream`, because a byte stream
/// cannot contain a surrogate, and `non-void-html-element-start-tag-with-trailing-solidus`, because
/// only a parser that builds a tree of elements can detect it.
pub type ParseError =
  | AbruptClosingOfEmptyComment
  | AbruptDoctypePublicIdentifier
  | AbruptDoctypeSystemIdentifier
  | AbsenceOfDigitsInNumericCharacterReference
  | CdataInHtmlContent
  | CharacterReferenceOutsideUnicodeRange
  | ControlCharacterInInputStream
  | ControlCharacterReference
  | DisallowedProcessingInstructionTarget
  | DuplicateAttribute
  | EndTagWithAttributes
  | EndTagWithTrailingSolidus
  | EofBeforeTagName
  | EofInCdata
  | EofInComment
  | EofInDoctype
  | EofInProcessingInstruction
  | EofInScriptHtmlCommentLikeText
  | EofInTag
  | IncorrectlyClosedComment
  | IncorrectlyOpenedComment
  | InvalidCharacterSequenceAfterDoctypeName
  | InvalidFirstCharacterOfProcessingInstructionTarget
  | InvalidFirstCharacterOfTagName
  | InvalidProcessingInstructionTarget
  | MissingAttributeValue
  | MissingDoctypeName
  | MissingDoctypePublicIdentifier
  | MissingDoctypeSystemIdentifier
  | MissingEndTagName
  | MissingQuoteBeforeDoctypePublicIdentifier
  | MissingQuoteBeforeDoctypeSystemIdentifier
  | MissingSemicolonAfterCharacterReference
  | MissingWhitespaceAfterDoctypePublicKeyword
  | MissingWhitespaceAfterDoctypeSystemKeyword
  | MissingWhitespaceBeforeDoctypeName
  | MissingWhitespaceBetweenAttributes
  | MissingWhitespaceBetweenDoctypePublicAndSystemIdentifiers
  | NestedComment
  | NoncharacterCharacterReference
  | NoncharacterInInputStream
  | NullCharacterReference
  | SurrogateCharacterReference
  | UnexpectedCharacterAfterDoctypeSystemIdentifier
  | UnexpectedCharacterInAttributeName
  | UnexpectedCharacterInUnquotedAttributeValue
  | UnexpectedEqualsSignBeforeAttributeName
  | UnexpectedNullCharacter
  | UnexpectedSolidusInTag
  | UnknownNamedCharacterReference

/// A parse error, and the byte of the input the tokenizer was at when it found it.
pub type Problem = { error: ParseError, offset: Int }

/// The standard's name for `e`, in lower case with hyphens.
pub fn code(e: ParseError) -> String =
  match e {
    AbruptClosingOfEmptyComment -> "abrupt-closing-of-empty-comment",
    AbruptDoctypePublicIdentifier -> "abrupt-doctype-public-identifier",
    AbruptDoctypeSystemIdentifier -> "abrupt-doctype-system-identifier",
    AbsenceOfDigitsInNumericCharacterReference ->
      "absence-of-digits-in-numeric-character-reference",
    CdataInHtmlContent -> "cdata-in-html-content",
    CharacterReferenceOutsideUnicodeRange -> "character-reference-outside-unicode-range",
    ControlCharacterInInputStream -> "control-character-in-input-stream",
    ControlCharacterReference -> "control-character-reference",
    DisallowedProcessingInstructionTarget -> "disallowed-processing-instruction-target",
    DuplicateAttribute -> "duplicate-attribute",
    EndTagWithAttributes -> "end-tag-with-attributes",
    EndTagWithTrailingSolidus -> "end-tag-with-trailing-solidus",
    EofBeforeTagName -> "eof-before-tag-name",
    EofInCdata -> "eof-in-cdata",
    EofInComment -> "eof-in-comment",
    EofInDoctype -> "eof-in-doctype",
    EofInProcessingInstruction -> "eof-in-processing-instruction",
    EofInScriptHtmlCommentLikeText -> "eof-in-script-html-comment-like-text",
    EofInTag -> "eof-in-tag",
    IncorrectlyClosedComment -> "incorrectly-closed-comment",
    IncorrectlyOpenedComment -> "incorrectly-opened-comment",
    InvalidCharacterSequenceAfterDoctypeName -> "invalid-character-sequence-after-doctype-name",
    InvalidFirstCharacterOfProcessingInstructionTarget ->
      "invalid-first-character-of-processing-instruction-target",
    InvalidFirstCharacterOfTagName -> "invalid-first-character-of-tag-name",
    InvalidProcessingInstructionTarget -> "invalid-processing-instruction-target",
    MissingAttributeValue -> "missing-attribute-value",
    MissingDoctypeName -> "missing-doctype-name",
    MissingDoctypePublicIdentifier -> "missing-doctype-public-identifier",
    MissingDoctypeSystemIdentifier -> "missing-doctype-system-identifier",
    MissingEndTagName -> "missing-end-tag-name",
    MissingQuoteBeforeDoctypePublicIdentifier -> "missing-quote-before-doctype-public-identifier",
    MissingQuoteBeforeDoctypeSystemIdentifier -> "missing-quote-before-doctype-system-identifier",
    MissingSemicolonAfterCharacterReference -> "missing-semicolon-after-character-reference",
    MissingWhitespaceAfterDoctypePublicKeyword -> "missing-whitespace-after-doctype-public-keyword",
    MissingWhitespaceAfterDoctypeSystemKeyword -> "missing-whitespace-after-doctype-system-keyword",
    MissingWhitespaceBeforeDoctypeName -> "missing-whitespace-before-doctype-name",
    MissingWhitespaceBetweenAttributes -> "missing-whitespace-between-attributes",
    MissingWhitespaceBetweenDoctypePublicAndSystemIdentifiers ->
      "missing-whitespace-between-doctype-public-and-system-identifiers",
    NestedComment -> "nested-comment",
    NoncharacterCharacterReference -> "noncharacter-character-reference",
    NoncharacterInInputStream -> "noncharacter-in-input-stream",
    NullCharacterReference -> "null-character-reference",
    SurrogateCharacterReference -> "surrogate-character-reference",
    UnexpectedCharacterAfterDoctypeSystemIdentifier ->
      "unexpected-character-after-doctype-system-identifier",
    UnexpectedCharacterInAttributeName -> "unexpected-character-in-attribute-name",
    UnexpectedCharacterInUnquotedAttributeValue ->
      "unexpected-character-in-unquoted-attribute-value",
    UnexpectedEqualsSignBeforeAttributeName -> "unexpected-equals-sign-before-attribute-name",
    UnexpectedNullCharacter -> "unexpected-null-character",
    UnexpectedSolidusInTag -> "unexpected-solidus-in-tag",
    UnknownNamedCharacterReference -> "unknown-named-character-reference",
  }

/// Describes `e` in a sentence for whoever wrote the markup: its code, and for the errors people
/// make most often, what to write instead.
pub fn explain(e: ParseError) -> String =
  "`" ++ code(e) ++ "`: "
    ++ (match e {
      InvalidFirstCharacterOfTagName ->
        "a `<` opens a tag: write `&lt;` to show a literal `<` character",
      MissingSemicolonAfterCharacterReference ->
        "a character reference ends with `;`: write `&amp;` to show a literal `&` character",
      UnknownNamedCharacterReference ->
        "no HTML character reference has this name: write `&amp;` to show a literal `&` character",
      EofInTag -> "a tag is not closed",
      EofInComment -> "a comment is not closed",
      DuplicateAttribute -> "an attribute is written twice in one tag",
      MissingWhitespaceBetweenAttributes -> "a space goes between attributes",
      MissingAttributeValue -> "an attribute's value is missing after its `=`",
      UnexpectedSolidusInTag -> "a `/` in a tag must be followed by `>`",
      UnexpectedCharacterInUnquotedAttributeValue ->
        "an unquoted attribute value cannot contain a quote, `<`, `=` or a backtick: put the value in quotes",
      UnexpectedCharacterInAttributeName -> "an attribute's name cannot contain a quote or `<`",
      _ -> "the HTML specification defines this as a parse error: fix the markup at this position",
    })

/// A doctype: its name and identifiers if it has them, and whether it would put a document in
/// quirks mode.
pub type Doctype = {
  name: Option<String>,
  public_id: Option<String>,
  system_id: Option<String>,
  force_quirks: Bool,
}

/// An attribute of a tag: its name, in lower case, and its value with its references decoded.
pub type Attribute = { name: String, value: String }

/// A start or an end tag: its name, in lower case; its attributes in the order written, each name
/// once, keeping the first of a repeated name; and whether it ends with `/>`.
pub type Tag = { name: String, attributes: List<Attribute>, self_closing: Bool }

/// What the tokenizer emits. `Text` joins the character tokens between two other tokens into one.
/// An `Instruction` is a processing instruction's target and data. `EndOfFile` comes last, once.
pub type Token =
  | Doctype(Doctype)
  | StartTag(Tag)
  | EndTag(Tag)
  | Comment(String)
  | Text(String)
  | Instruction(String, String)
  | EndOfFile

/// A token, the parse errors found while reading it, and the bytes it was read from.
pub type Lexeme = { token: Token, problems: List<Problem>, from: Int, to: Int }

/// The state a tokenizer starts in. `Data` reads ordinary markup. `Rcdata`, `Rawtext`, `ScriptData`
/// and `Plaintext` read the content of elements such as `title`, `style`, `script` and `plaintext`
/// as text. `CdataSection` reads a `<![CDATA[` section of foreign content. A caller that builds a
/// tree of elements picks the state after each start tag.
pub type State = | Data | Rcdata | Rawtext | ScriptData | Plaintext | CdataSection

/// Where a reading starts: the `state`, the name of the most recent start tag (`last_start_tag`),
/// and whether `<![CDATA[` opens a section of foreign content (`foreign`) rather than a bogus
/// comment. In RCDATA, RAWTEXT and script data, an end tag closes the text only when its name
/// equals `last_start_tag`.
pub type Start = new { state: State, last_start_tag: Option<String>, foreign: Bool }

/// A reading of a document from its beginning.
pub fn start() -> Start = { state: Data, last_start_tag: None, foreign: false }

/// What a reading may use: tokens, attributes on one tag, bytes in one name (of a tag, an
/// attribute, a doctype or a processing instruction's target), bytes in one value (of an
/// attribute, a comment, a doctype identifier or an instruction's data), and bytes of all the
/// tokens' text together.
pub type Limits = new { tokens: Int, attributes: Int, name: Int, value: Int, output: Int }

/// Four million tokens, a thousand attributes, names of 4 KiB, values of 16 MiB and 256 MiB of
/// output.
pub fn default_limits() -> Limits =
  { tokens: 4000000, attributes: 1000, name: 4096, value: 16777216, output: 268435456 }

/// The reason a reading failed: it went over one of the `Limits`, or `InternalError` carries the
/// message of a bug in this module that no input should trigger. Internal bugs are reported as an
/// `Error` so that `html.fail` is the only error a reading raises.
pub type ErrorKind =
  | TooManyTokens
  | TooManyAttributes
  | NameTooLong
  | ValueTooLong
  | OutputTooLong
  | InternalError(String)

/// A reading error, and the byte of the input the reading was at.
pub type Error = new { offset: Int, reason: ErrorKind }

/// What this module raises.
pub effect html {
  /// A reading passed one of its limits.
  raise fail(e: Error)
  /// Raised when a value interpolated into a URL attribute would give the URL a scheme other than
  /// `http`, `https`, `mailto` or `tel`, and the value is not a `trusted_url`. `scheme` is the
  /// rejected scheme.
  raise unsafe_url(scheme: String)
}

type TextKind = | RcdataText | RawText | ScriptText | EscapedText

type Mode =
  | Reading(State)
  | CdataBracket
  | CdataEnd
  | TagOpen
  | EndTagOpen
  | TagName
  | TextLessThan(TextKind)
  | TextEndOpen(TextKind)
  | TextEndName(TextKind)
  | EscapeStart
  | EscapeStartDash
  | Escaped
  | EscapedDash
  | EscapedDashDash
  | DoubleEscapeStart
  | DoubleEscaped
  | DoubleEscapedDash
  | DoubleEscapedDashDash
  | DoubleEscapedLessThan
  | DoubleEscapeEnd
  | BeforeAttributeName
  | AttributeName
  | AfterAttributeName
  | BeforeAttributeValue
  | AttributeValue(Int)
  | AfterAttributeValue
  | SelfClosing
  | BogusComment
  | Declaration
  | CommentStart
  | CommentStartDash
  | InComment
  | CommentLessThan
  | CommentLessThanBang
  | CommentLessThanBangDash
  | CommentLessThanBangDashDash
  | CommentEndDash
  | CommentEnd
  | CommentEndBang
  | DoctypeOpen
  | BeforeDoctypeName
  | DoctypeName
  | AfterDoctypeName
  | AfterKeyword(Bool)
  | BeforeId(Bool)
  | InQuotedId(Bool, Int)
  | AfterId(Bool)
  | BetweenIds
  | BogusDoctype
  | InstructionOpen
  | InstructionTarget
  | AfterInstructionTarget
  | InstructionData
  | InstructionQuestion
  | Ended

type PartialTag = { name: List<Bytes>, end: Bool, attributes: List<Attribute>, closing: Bool }

type PartialAttribute = { name: List<Bytes>, value: List<Bytes>, dropped: Bool, open: Bool }

type PartialDoctype = {
  name: Option<List<Bytes>>,
  public_id: Option<List<Bytes>>,
  system_id: Option<List<Bytes>>,
  quirks: Bool,
}

type Machine = {
  input: Bytes,
  at: Int,
  ended: Bool,
  waiting: Bool,
  mode: Mode,
  from: Int,
  text: List<Bytes>,
  text_size: Int,
  text_from: Int,
  tag: PartialTag,
  attribute: PartialAttribute,
  data: List<Bytes>,
  doctype: PartialDoctype,
  temp: Bytes,
  last_start: Bytes,
  name_size: Int,
  value_size: Int,
  switching: Bool,
  foreign: Bool,
  problems: List<Problem>,
  checked: List<Problem>,
  checked_at: Int,
  checked_to: Int,
  out: List<Lexeme>,
  limits: Limits,
  tokens: Int,
  output: Int,
  stop: Option<Error>,
  urls: Bool,
  link: UrlLayout,
  url: UrlState,
  word: Bytes,
  tag_attributes: List<Bytes>,
  first_invalid_character: Option<InvalidCharacter>,
}

fn no_tag() -> PartialTag = { name: [], end: false, attributes: [], closing: false }

fn no_attribute() -> PartialAttribute = { name: [], value: [], dropped: false, open: false }

fn no_doctype() -> PartialDoctype = { name: None, public_id: None, system_id: None, quirks: false }

fn machine(input: Bytes, s: Start, limits: Limits, switching: Bool, ended: Bool) -> Machine =
  {
    input: input,
    at: 0,
    ended: ended,
    waiting: false,
    mode: Reading(s.state),
    from: 0,
    text: [],
    text_size: 0,
    text_from: 0,
    tag: no_tag(),
    attribute: no_attribute(),
    data: [],
    doctype: no_doctype(),
    temp: b"",
    last_start: match s.last_start_tag {
      Some(name) -> Bytes::of_string(name.ascii_lower()),
      None -> b"",
    },
    name_size: 0,
    value_size: 0,
    switching: switching,
    foreign: s.foreign,
    problems: [],
    checked: [],
    checked_to: 0,
    checked_at: 0,
    out: [],
    limits: limits,
    tokens: 0,
    output: 0,
    stop: None,
    urls: false,
    link: NoUrl,
    url: NotInUrl,
    word: b"",
    tag_attributes: [],
    first_invalid_character: None,
  }

fn decoded(input: Bytes) -> Bytes =
  if input.is_utf8() { input } else { Bytes::of_string(String::of_bytes_lossy(input)) }

fn width(input: Bytes, at: Int) -> Int / {abort.raise} = {
  let c = input.at(at);
  if c == 13 { if input.peek(at + 1) == 10 { 2 } else { 1 } }
  else if c < 0x80 { 1 }
  else if c < 0xE0 { 2 }
  else if c < 0xF0 { 3 }
  else { 4 }
}

fn next_of(m: Machine) -> Int = {
  let c = m.input.peek(m.at);
  if c == 13 { 10 } else { c }
}

fn current(m: Machine) -> Bytes / {abort.raise} =
  if m.input.peek(m.at) == 13 { b"\n" } else { m.input.slice(m.at, m.at + width(m.input, m.at)) }

fn is_space(c: Int) -> Bool = c == 9 || c == 10 || c == 12 || c == 32

fn advance(m: Machine) -> Machine / {abort.raise} = { ..m, at: m.at + width(m.input, m.at) }

fn into(m: Machine, mode: Mode) -> Machine / {abort.raise} =
  { ..m, mode: mode, at: m.at + width(m.input, m.at) }

fn reconsume(m: Machine, mode: Mode) -> Machine = { ..m, mode: mode }

fn fault(m: Machine, e: ParseError) -> Machine =
  { ..m, problems: m.problems.push(problem(e, m.at)) }

fn fail(m: Machine, reason: ErrorKind) -> Machine =
  match m.stop { Some(_) -> m, None -> { ..m, stop: Some({ offset: m.at, reason: reason }) } }

fn add_text(m: Machine, piece: Bytes, offset: Int) -> Machine =
  if piece.len() == 0 { m } else {
    {
      ..m,
      text: m.text.push(piece),
      text_size: m.text_size + piece.len(),
      text_from: if m.text_size == 0 { offset } else { m.text_from },
    }
  }

fn run_text(m: Machine, stops: Bytes) -> Machine / {abort.raise} = {
  let to = m.input.skip_until(m.at, stops);
  add_text({ ..m, at: to }, m.input.slice(m.at, to), m.at)
}

fn run_of(m: Machine, stops: Bytes) -> Bytes / {abort.raise} =
  m.input.slice(m.at, m.input.skip_until(m.at, stops))

fn to_ascii_lower(b: Bytes) -> Bytes / {abort.raise} =
  if b.len() == 0 || b.skip_until(0, upper_letters()) == b.len() { b }
  else { Bytes::of_string(String::of_bytes_lossy(b).ascii_lower()) }

fn upper_letters() -> Bytes = b"ABCDEFGHIJKLMNOPQRSTUVWXYZ"

fn name_grown(m: Machine, size: Int) -> Machine =
  if size > m.limits.name { fail({ ..m, name_size: size }, NameTooLong) }
  else { { ..m, name_size: size } }

fn set_value_size(m: Machine, size: Int) -> Machine =
  if size > m.limits.value { fail({ ..m, value_size: size }, ValueTooLong) }
  else { { ..m, value_size: size } }

fn tag_named(m: Machine, piece: Bytes, to: Int) -> Machine = {
  let size = m.name_size + piece.len();
  let grown: Machine = {
    ..m,
    at: to,
    tag: { ..m.tag, name: m.tag.name.push(piece) },
    name_size: size,
  };
  if size > m.limits.name { fail(grown, NameTooLong) } else { grown }
}

fn data_added(m: Machine, piece: Bytes) -> Machine =
  set_value_size({ ..m, data: m.data.push(piece) }, m.value_size + piece.len())

fn joined_bytes(pieces: List<Bytes>) -> String = String::of_bytes_lossy(Bytes::concat_all(pieces))

fn error_lead_bytes() -> Bytes =
  b"\x01\x02\x03\x04\x05\x06\x07\x08\x0b\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f\x7f\xc2\xef\xf0\xf1\xf2\xf3\xf4"

fn code_point(input: Bytes, at: Int) -> Int / {abort.raise} = {
  let c = input.at(at);
  let more = |k: Int| input.peek(at + k) & 0x3F;
  if c < 0x80 { c }
  else if c < 0xE0 { (c & 0x1F) << 6 | more(1) }
  else if c < 0xF0 { (c & 0x0F) << 12 | more(1) << 6 | more(2) }
  else { (c & 0x07) << 18 | more(1) << 12 | more(2) << 6 | more(3) }
}

fn input_stream_problems(input: Bytes, from: Int) -> List<Problem> / {abort.raise} =
  iterate({ at: from, found: [] }, input.len() + 2, |s: { at: Int, found: List<Problem> }| {
    let i = input.skip_until(s.at, error_lead_bytes());
    if i >= input.len() { Stop(s.found) } else {
      let point = code_point(input, i);
      let next = i + width(input, i);
      if noncharacter(point) {
        Continue({ at: next, found: s.found.push(problem(NoncharacterInInputStream, i)) })
      } else if is_control_code(point) {
        Continue({ at: next, found: s.found.push(problem(ControlCharacterInInputStream, i)) })
      } else { Continue({ at: next, found: s.found }) }
    }
  })

fn merged(a: List<Problem>, b: List<Problem>) -> List<Problem> / {abort.raise} =
  iterate(
    { i: 0, j: 0, out: [] },
    a.len() + b.len() + 1,
    |s: { i: Int, j: Int, out: List<Problem> }|
      match ((a.at(s.i), b.at(s.j))) {
        (None, None) -> Stop(s.out),
        (Some(x), None) -> Continue({ ..s, i: s.i + 1, out: s.out.push(x) }),
        (None, Some(y)) -> Continue({ ..s, j: s.j + 1, out: s.out.push(y) }),
        (Some(x), Some(y)) -> if y.offset < x.offset {
          Continue({ ..s, j: s.j + 1, out: s.out.push(y) })
        } else { Continue({ ..s, i: s.i + 1, out: s.out.push(x) }) },
      },
  )

type TakenProblems = { problems: List<Problem>, m: Machine }

fn take_problems(m: Machine, bound: Int) -> TakenProblems / {abort.raise} =
  if m.problems.len() == 0 && m.checked_at >= m.checked.len() { { problems: [], m: m } }
  else { take_some_problems(m, bound) }

fn take_some_problems(m: Machine, bound: Int) -> TakenProblems / {abort.raise} = {
  let mine = m.problems.filter(|p: Problem| p.offset < bound);
  let rest = m.problems.filter(|p: Problem| p.offset >= bound);
  let upto = iterate(m.checked_at, m.checked.len() + 1, |i: Int|
    match m.checked.at(i) {
      Some(p) -> if p.offset < bound { Continue(i + 1) } else { Stop(i) },
      None -> Stop(i),
    });
  {
    problems: merged(m.checked.slice(m.checked_at, upto), mine),
    m: { ..m, problems: rest, checked_at: upto },
  }
}

fn size_of(s: String) -> Int = Bytes::of_string(s).len()

fn weight(t: Token) -> Int =
  match t {
    Text(s) -> size_of(s),
    Comment(s) -> size_of(s),
    StartTag(tag) | EndTag(tag) ->
      size_of(tag.name)
        + tag.attributes.fold(0, |n: Int, a: Attribute| n + size_of(a.name) + size_of(a.value)),
    Doctype(d) ->
      [d.name, d.public_id, d.system_id].fold(0, |n: Int, part: Option<String>|
        n + (match part { Some(s) -> size_of(s), None -> 0 })),
    Instruction(target, data) -> size_of(target) + size_of(data),
    EndOfFile -> 0,
  }

fn emit(m: Machine, t: Token, from: Int, to: Int) -> Machine / {abort.raise} = {
  let texted = if m.text_size == 0 { m } else {
    let mine = take_problems(m, from);
    push_lexeme({ ..mine.m, text: [], text_size: 0 }, {
      token: Text(joined_bytes(m.text)),
      problems: mine.problems,
      from: m.text_from,
      to: from,
    })
  };
  let rest = take_problems(texted, to + 1);
  push_lexeme(rest.m, { token: t, problems: rest.problems, from: from, to: to })
}

fn push_lexeme(m: Machine, l: Lexeme) -> Machine = {
  let spent = if l.token == EndOfFile { m.tokens } else { m.tokens + 1 };
  let output = m.output + weight(l.token);
  let counted: Machine = { ..m, out: m.out.push(l), tokens: spent, output: output };
  if spent > m.limits.tokens { fail(counted, TooManyTokens) }
  else if output > m.limits.output { fail(counted, OutputTooLong) }
  else { counted }
}

fn emit_end_of_file(m: Machine) -> Machine / {abort.raise} =
  { ..emit(m, EndOfFile, m.input.len(), m.input.len()), mode: Ended }

fn replacement() -> Bytes = b"\xef\xbf\xbd"

fn letters() -> Bytes = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"

fn newline(m: Machine) -> Machine / {abort.raise} = add_text(advance(m), b"\n", m.at)

fn null_text(m: Machine) -> Machine / {abort.raise} =
  add_text(advance(fault(m, UnexpectedNullCharacter)), replacement(), m.at)

fn read_character_reference(m: Machine, attribute: Bool) -> Machine / {abort.raise} =
  match read_reference(m.input, m.at, names(), attribute, m.ended) {
    None -> { ..m, waiting: true },
    Some(r) -> {
      let after_first_part: Machine = { ..m, problems: m.problems.concat(r.problems), at: r.next };
      if attribute { with_value(after_first_part, r.characters, r.next) }
      else { add_text(after_first_part, r.characters, m.at) }
    },
  }

fn read_state(m: Machine, s: State) -> Machine / {abort.raise} = {
  let c = next_of(m);
  if c < 0 {
    if s == CdataSection { emit_end_of_file(fault(m, EofInCdata)) } else { emit_end_of_file(m) }
  } else if c == 10 { newline(m) } else {
    match s {
      Data -> if c == b'<' { { ..m, mode: TagOpen, at: m.at + 1, from: m.at } }
      else if c == b'&' { read_character_reference(m, false) }
      else if c == 0 { add_text(advance(fault(m, UnexpectedNullCharacter)), b"\x00", m.at) }
      else { run_text(m, b"<&\r\x00") },
      Rcdata -> if c == b'<' { { ..m, mode: TextLessThan(RcdataText), at: m.at + 1, from: m.at } }
      else if c == b'&' { read_character_reference(m, false) }
      else if c == 0 { null_text(m) }
      else { run_text(m, b"<&\r\x00") },
      Rawtext -> if c == b'<' { { ..m, mode: TextLessThan(RawText), at: m.at + 1, from: m.at } }
      else if c == 0 { null_text(m) }
      else { run_text(m, b"<\r\x00") },
      ScriptData -> if c == b'<' {
        { ..m, mode: TextLessThan(ScriptText), at: m.at + 1, from: m.at }
      } else if c == 0 { null_text(m) }
      else { run_text(m, b"<\r\x00") },
      Plaintext -> if c == 0 { null_text(m) } else { run_text(m, b"\r\x00") },
      CdataSection -> if c == b']' { into(m, CdataBracket) } else { run_text(m, b"]\r") },
    }
  }
}

fn cdata_bracket(m: Machine) -> Machine / {abort.raise} =
  if next_of(m) == b']' { into(m, CdataEnd) }
  else { reconsume(add_text(m, b"]", m.at - 1), Reading(CdataSection)) }

fn cdata_end(m: Machine) -> Machine / {abort.raise} = {
  let c = next_of(m);
  if c == b']' { add_text(advance(m), b"]", m.at - 2) }
  else if c == b'>' { into(m, Reading(Data)) }
  else { reconsume(add_text(m, b"]]", m.at - 2), Reading(CdataSection)) }
}

fn new_tag(m: Machine, end: Bool, mode: Mode) -> Machine =
  {
    ..m,
    mode: mode,
    tag: { name: [], end: end, attributes: [], closing: false },
    attribute: no_attribute(),
    name_size: 0,
    tag_attributes: [],
  }

fn tag_open(m: Machine) -> Machine / {abort.raise} = {
  let c = next_of(m);
  if c == b'!' { into(m, Declaration) }
  else if c == b'/' { into(m, EndTagOpen) }
  else if is_letter(c) { new_tag(m, false, TagName) }
  else if c == b'?' { { ..into(m, InstructionOpen), temp: b"" } }
  else if c < 0 { emit_end_of_file(add_text(fault(m, EofBeforeTagName), b"<", m.from)) } else {
    reconsume(add_text(fault(m, InvalidFirstCharacterOfTagName), b"<", m.from), Reading(Data))
  }
}

fn end_tag_open(m: Machine) -> Machine / {abort.raise} = {
  let c = next_of(m);
  if is_letter(c) { new_tag(m, true, TagName) }
  else if c == b'>' { into(fault(m, MissingEndTagName), Reading(Data)) }
  else if c < 0 { emit_end_of_file(add_text(fault(m, EofBeforeTagName), b"</", m.from)) } else {
    reconsume({ ..fault(m, InvalidFirstCharacterOfTagName), data: [], value_size: 0 }, BogusComment)
  }
}

fn tag_name(m: Machine) -> Machine / {abort.raise} = {
  let c = next_of(m);
  if is_space(c) { into(m, BeforeAttributeName) }
  else if c == b'/' { into(m, SelfClosing) }
  else if c == b'>' { tag_emitted(m) }
  else if c == 0 { tag_named(fault(m, UnexpectedNullCharacter), replacement(), m.at + 1) }
  else if c < 0 { emit_end_of_file(fault(m, EofInTag)) } else {
    let run = run_of(m, b"\t\n\x0c\r />\x00");
    tag_named(m, to_ascii_lower(run), m.at + run.len())
  }
}

fn switched(name: Bytes) -> Mode =
  if name == b"title" || name == b"textarea" { Reading(Rcdata) }
  else if name == b"style" || name == b"xmp" || name == b"iframe" || name == b"noembed"
      || name == b"noframes" { Reading(Rawtext) }
  else if name == b"script" { Reading(ScriptData) }
  else if name == b"plaintext" { Reading(Plaintext) }
  else { Reading(Data) }

fn tag_emitted(m: Machine) -> Machine / {abort.raise} = {
  let closed = check_refresh_hole(attribute_closed(m));
  let t = closed.tag;
  let name = Bytes::concat_all(t.name);
  let tag: Tag = {
    name: String::of_bytes_lossy(name),
    attributes: t.attributes,
    self_closing: t.closing,
  };
  let to = closed.at + 1;
  if t.end {
    let attributed = if t.attributes.len() > 0 { fault(closed, EndTagWithAttributes) }
    else { closed };
    let slashed = if t.closing { fault(attributed, EndTagWithTrailingSolidus) } else { attributed };
    { ..emit(slashed, EndTag(tag), m.from, to), at: to, mode: Reading(Data) }
  } else {
    {
      ..emit(closed, StartTag(tag), m.from, to),
      at: to,
      mode: if m.switching { switched(name) } else { Reading(Data) },
      last_start: name,
    }
  }
}

fn matches_last_start(m: Machine) -> Bool =
  m.last_start.len() > 0 && Bytes::concat_all(m.tag.name) == m.last_start

fn back(kind: TextKind) -> Mode =
  match kind {
    RcdataText -> Reading(Rcdata),
    RawText -> Reading(Rawtext),
    ScriptText -> Reading(ScriptData),
    EscapedText -> Escaped,
  }

fn text_less_than(m: Machine, kind: TextKind) -> Machine / {abort.raise} = {
  let c = next_of(m);
  if c == b'/' { { ..into(m, TextEndOpen(kind)), temp: b"" } }
  else if kind == ScriptText && c == b'!' { add_text(into(m, EscapeStart), b"<!", m.from) }
  else if kind == EscapedText && is_letter(c) {
    reconsume({ ..add_text(m, b"<", m.from), temp: b"" }, DoubleEscapeStart)
  } else { reconsume(add_text(m, b"<", m.from), back(kind)) }
}

fn text_end_open(m: Machine, kind: TextKind) -> Machine =
  if is_letter(next_of(m)) { new_tag(m, true, TextEndName(kind)) }
  else { reconsume(add_text(m, b"</", m.from), back(kind)) }

fn text_end_name(m: Machine, kind: TextKind) -> Machine / {abort.raise} = {
  let c = next_of(m);
  if is_letter(c) {
    let run = m.input.slice(m.at, m.input.skip(m.at, letters()));
    { ..tag_named(m, to_ascii_lower(run), m.at + run.len()), temp: m.temp.concat(run) }
  } else if is_space(c) && matches_last_start(m) { into(m, BeforeAttributeName) }
  else if c == b'/' && matches_last_start(m) { into(m, SelfClosing) }
  else if c == b'>' && matches_last_start(m) { tag_emitted(m) }
  else { reconsume(add_text(m, b"</".concat(m.temp), m.from), back(kind)) }
}

fn escape_start(m: Machine, dashes: Int) -> Machine / {abort.raise} =
  if next_of(m) == b'-' {
    add_text(into(m, if dashes == 0 { EscapeStartDash } else { EscapedDashDash }), b"-", m.at)
  } else { reconsume(m, Reading(ScriptData)) }

fn escaped(m: Machine, double: Bool, dashes: Int) -> Machine / {abort.raise} = {
  let c = next_of(m);
  let raw_text = if double { DoubleEscaped } else { Escaped };
  if c == b'-' {
    if dashes == 2 { add_text(advance(m), b"-", m.at) } else {
      let more = if double { if dashes == 0 { DoubleEscapedDash } else { DoubleEscapedDashDash } }
      else if dashes == 0 { EscapedDash }
      else { EscapedDashDash };
      add_text(into(m, more), b"-", m.at)
    }
  } else if c == b'<' {
    if double { add_text(into(m, DoubleEscapedLessThan), b"<", m.at) }
    else { { ..m, mode: TextLessThan(EscapedText), at: m.at + 1, from: m.at } }
  } else if c == b'>' && dashes == 2 { add_text(into(m, Reading(ScriptData)), b">", m.at) }
  else if c == 0 { reconsume(null_text(m), raw_text) }
  else if c < 0 { emit_end_of_file(fault(m, EofInScriptHtmlCommentLikeText)) }
  else if dashes > 0 { reconsume(m, raw_text) }
  else if c == 10 { newline(m) }
  else { run_text(m, b"-<\r\x00") }
}

fn double_escape(m: Machine, ending: Bool) -> Machine / {abort.raise} = {
  let c = next_of(m);
  let named_script = m.temp == b"script";
  if is_space(c) || c == b'/' || c == b'>' {
    let next = if named_script == ending { Escaped } else { DoubleEscaped };
    add_text(into(m, next), current(m), m.at)
  } else if is_letter(c) {
    let run = m.input.slice(m.at, m.input.skip(m.at, letters()));
    add_text({ ..m, at: m.at + run.len(), temp: m.temp.concat(to_ascii_lower(run)) }, run, m.at)
  } else { reconsume(m, if ending { DoubleEscaped } else { Escaped }) }
}

fn double_escaped_less_than(m: Machine) -> Machine / {abort.raise} =
  if next_of(m) == b'/' { add_text({ ..into(m, DoubleEscapeEnd), temp: b"" }, b"/", m.at) }
  else { reconsume(m, DoubleEscaped) }

fn attribute_closed(m: Machine) -> Machine =
  if !m.attribute.open || m.attribute.dropped { { ..m, attribute: no_attribute() } } else {
    let finished_attribute: Attribute = {
      name: joined_bytes(m.attribute.name),
      value: joined_bytes(m.attribute.value),
    };
    {
      ..m,
      attribute: no_attribute(),
      tag: { ..m.tag, attributes: m.tag.attributes.push(finished_attribute) },
    }
  }

fn new_attribute(m: Machine) -> Machine = {
  let closed = attribute_closed(m);
  let opened: Machine = {
    ..closed,
    attribute: { name: [], value: [], dropped: false, open: true },
    name_size: 0,
    value_size: 0,
    link: NoUrl,
    url: NotInUrl,
    word: b"",
  };
  if closed.tag.attributes.len() + 1 > m.limits.attributes { fail(opened, TooManyAttributes) }
  else { opened }
}

fn attribute_named(m: Machine, piece: Bytes, to: Int) -> Machine = {
  let size = m.name_size + piece.len();
  let grown: Machine = {
    ..m,
    at: to,
    attribute: { ..m.attribute, name: m.attribute.name.push(piece) },
    name_size: size,
  };
  if size > m.limits.name { fail(grown, NameTooLong) } else { grown }
}

fn name_left(m: Machine) -> Machine = {
  let name = joined_bytes(m.attribute.name);
  if m.tag.attributes.fold(false, |seen: Bool, a: Attribute| seen || a.name == name) {
    { ..fault(m, DuplicateAttribute), attribute: { ..m.attribute, dropped: true } }
  } else { m }
}

fn with_value(m: Machine, piece: Bytes, to: Int) -> Machine / {abort.raise} = {
  let size = m.value_size + piece.len();
  let grown: Machine = {
    ..m,
    at: to,
    attribute: { ..m.attribute, value: m.attribute.value.push(piece) },
    value_size: size,
  };
  let limited = if size > m.limits.value { fail(grown, ValueTooLong) } else { grown };
  if m.link == NoUrl { limited } else { scan_url(limited, piece) }
}

fn before_attribute_name(m: Machine) -> Machine / {abort.raise} = {
  let c = next_of(m);
  if is_space(c) { advance(m) }
  else if c == b'/' || c == b'>' || c < 0 { reconsume(m, AfterAttributeName) } else if c == b'=' {
    reconsume(
      attribute_named(
        new_attribute(fault(m, UnexpectedEqualsSignBeforeAttributeName)),
        b"=",
        m.at + 1,
      ),
      AttributeName,
    )
  } else { reconsume(new_attribute(m), AttributeName) }
}

fn attribute_name(m: Machine) -> Machine / {abort.raise} = {
  let c = next_of(m);
  if is_space(c) || c == b'/' || c == b'>' || c < 0 { reconsume(name_left(m), AfterAttributeName) }
  else if c == b'=' { into(name_left(m), BeforeAttributeValue) }
  else if c == 0 { attribute_named(fault(m, UnexpectedNullCharacter), replacement(), m.at + 1) }
  else if c == b'"' || c == b'\'' || c == b'<' {
    attribute_named(fault(m, UnexpectedCharacterInAttributeName), current(m), m.at + 1)
  } else {
    let run = run_of(m, b"\t\n\x0c\r />=\x00\"'<");
    attribute_named(m, to_ascii_lower(run), m.at + run.len())
  }
}

fn after_attribute_name(m: Machine) -> Machine / {abort.raise} = {
  let c = next_of(m);
  if is_space(c) { advance(m) }
  else if c == b'/' { into(m, SelfClosing) }
  else if c == b'=' { into(m, BeforeAttributeValue) }
  else if c == b'>' { tag_emitted(m) }
  else if c < 0 { emit_end_of_file(fault(m, EofInTag)) }
  else { reconsume(new_attribute(m), AttributeName) }
}

fn before_attribute_value(m: Machine) -> Machine / {abort.raise} = {
  let c = next_of(m);
  if is_space(c) { advance(m) }
  else if c == b'"' || c == b'\'' { into(value_opened(m), AttributeValue(c)) }
  else if c == b'>' { tag_emitted(fault(m, MissingAttributeValue)) }
  else { reconsume(value_opened(m), AttributeValue(0)) }
}

fn attribute_value(m: Machine, quote: Int) -> Machine / {abort.raise} = {
  let c = next_of(m);
  if c == b'&' { read_character_reference(m, true) }
  else if c == 0 { with_value(fault(m, UnexpectedNullCharacter), replacement(), m.at + 1) }
  else if c < 0 { emit_end_of_file(fault(m, EofInTag)) } else if quote != 0 {
    if c == quote { into(m, AfterAttributeValue) }
    else if c == 10 { with_value(m, b"\n", m.at + width(m.input, m.at)) } else {
      let run = run_of(m, if quote == b'"' { b"\"&\r\x00" } else { b"'&\r\x00" });
      with_value(m, run, m.at + run.len())
    }
  } else if is_space(c) { into(m, BeforeAttributeName) }
  else if c == b'>' { tag_emitted(m) }
  else if c == b'"' || c == b'\'' || c == b'<' || c == b'=' || c == b'`' {
    with_value(fault(m, UnexpectedCharacterInUnquotedAttributeValue), current(m), m.at + 1)
  } else {
    let run = run_of(m, b"\t\n\x0c\r >&\x00\"'<=`");
    with_value(m, run, m.at + run.len())
  }
}

fn after_attribute_value(m: Machine) -> Machine / {abort.raise} = {
  let c = next_of(m);
  if is_space(c) { into(m, BeforeAttributeName) }
  else if c == b'/' { into(m, SelfClosing) }
  else if c == b'>' { tag_emitted(m) }
  else if c < 0 { emit_end_of_file(fault(m, EofInTag)) }
  else { reconsume(fault(m, MissingWhitespaceBetweenAttributes), BeforeAttributeName) }
}

fn self_closing(m: Machine) -> Machine / {abort.raise} = {
  let c = next_of(m);
  if c == b'>' { tag_emitted({ ..m, tag: { ..m.tag, closing: true } }) }
  else if c < 0 { emit_end_of_file(fault(m, EofInTag)) }
  else { reconsume(fault(m, UnexpectedSolidusInTag), BeforeAttributeName) }
}

fn emit_comment(m: Machine) -> Machine / {abort.raise} =
  {
    ..emit(m, Comment(joined_bytes(m.data)), m.from, m.at + 1),
    at: m.at + 1,
    mode: Reading(Data),
    data: [],
  }

fn comment_ended(m: Machine) -> Machine / {abort.raise} =
  emit_end_of_file(emit(m, Comment(joined_bytes(m.data)), m.from, m.at))

fn bogus_comment(m: Machine) -> Machine / {abort.raise} = {
  let c = next_of(m);
  if c == b'>' { emit_comment(m) }
  else if c < 0 { comment_ended(m) }
  else if c == 0 { advance(data_added(fault(m, UnexpectedNullCharacter), replacement())) }
  else if c == 10 { advance(data_added(m, b"\n")) } else {
    let run = run_of(m, b">\r\x00");
    data_added({ ..m, at: m.at + run.len() }, run)
  }
}

fn is_declaration_prefix(input: Bytes, at: Int) -> Bool / {abort.raise} = {
  let rest = input.slice(at, input.len());
  b"--".starts_with(rest) || b"doctype".starts_with(to_ascii_lower(rest))
    || b"[CDATA[".starts_with(rest)
}

fn declaration(m: Machine) -> Machine / {abort.raise} =
  if m.input.starts_at(m.at, b"--") {
    { ..m, at: m.at + 2, mode: CommentStart, data: [], value_size: 0 }
  } else if to_ascii_lower(m.input.slice(m.at, min(m.at + 7, m.input.len()))) == b"doctype" {
    { ..m, at: m.at + 7, mode: DoctypeOpen, doctype: no_doctype(), name_size: 0, value_size: 0 }
  } else if m.input.starts_at(m.at, b"[CDATA[") {
    if m.foreign { { ..m, at: m.at + 7, mode: Reading(CdataSection) } } else {
      {
        ..fault({ ..m, at: m.at + 6 }, CdataInHtmlContent),
        at: m.at + 7,
        mode: BogusComment,
        data: [b"[CDATA["],
        value_size: 7,
      }
    }
  } else if !m.ended && is_declaration_prefix(m.input, m.at) { { ..m, waiting: true } }
  else { { ..fault(m, IncorrectlyOpenedComment), mode: BogusComment, data: [], value_size: 0 } }

fn comment_state(m: Machine) -> Machine / {abort.raise} = {
  let c = next_of(m);
  match m.mode {
    CommentStart -> if c == b'-' { into(m, CommentStartDash) }
    else if c == b'>' { emit_comment(fault(m, AbruptClosingOfEmptyComment)) }
    else { reconsume(m, InComment) },
    CommentStartDash -> if c == b'-' { into(m, CommentEnd) }
    else if c == b'>' { emit_comment(fault(m, AbruptClosingOfEmptyComment)) }
    else if c < 0 { comment_ended(fault(m, EofInComment)) }
    else { reconsume(data_added(m, b"-"), InComment) },
    InComment -> if c == b'<' { into(data_added(m, b"<"), CommentLessThan) }
    else if c == b'-' { into(m, CommentEndDash) }
    else if c == 0 { advance(data_added(fault(m, UnexpectedNullCharacter), replacement())) }
    else if c < 0 { comment_ended(fault(m, EofInComment)) }
    else if c == 10 { advance(data_added(m, b"\n")) } else {
      let run = run_of(m, b"<-\r\x00");
      data_added({ ..m, at: m.at + run.len() }, run)
    },
    CommentLessThan -> if c == b'!' { into(data_added(m, b"!"), CommentLessThanBang) }
    else if c == b'<' { advance(data_added(m, b"<")) }
    else { reconsume(m, InComment) },
    CommentLessThanBang -> if c == b'-' { into(m, CommentLessThanBangDash) }
    else { reconsume(m, InComment) },
    CommentLessThanBangDash -> if c == b'-' { into(m, CommentLessThanBangDashDash) }
    else { reconsume(m, CommentEndDash) },
    CommentLessThanBangDashDash -> if c == b'>' || c < 0 { reconsume(m, CommentEnd) }
    else { reconsume(fault(m, NestedComment), CommentEnd) },
    CommentEndDash -> if c == b'-' { into(m, CommentEnd) }
    else if c < 0 { comment_ended(fault(m, EofInComment)) }
    else { reconsume(data_added(m, b"-"), InComment) },
    CommentEnd -> if c == b'>' { emit_comment(m) }
    else if c == b'!' { into(m, CommentEndBang) }
    else if c == b'-' { advance(data_added(m, b"-")) }
    else if c < 0 { comment_ended(fault(m, EofInComment)) }
    else { reconsume(data_added(m, b"--"), InComment) },
    _ -> if c == b'-' { into(data_added(m, b"--!"), CommentEndDash) }
    else if c == b'>' { emit_comment(fault(m, IncorrectlyClosedComment)) }
    else if c < 0 { comment_ended(fault(m, EofInComment)) }
    else { reconsume(data_added(m, b"--!"), InComment) },
  }
}

fn set_force_quirks(m: Machine) -> Machine = { ..m, doctype: { ..m.doctype, quirks: true } }

fn doctype_token(m: Machine) -> Token =
  Doctype({
    name: option_map_bytes(m.doctype.name),
    public_id: option_map_bytes(m.doctype.public_id),
    system_id: option_map_bytes(m.doctype.system_id),
    force_quirks: m.doctype.quirks,
  })

fn option_map_bytes(pieces: Option<List<Bytes>>) -> Option<String> =
  match pieces { Some(p) -> Some(joined_bytes(p)), None -> None }

fn emit_doctype(m: Machine) -> Machine / {abort.raise} =
  { ..emit(m, doctype_token(m), m.from, m.at + 1), at: m.at + 1, mode: Reading(Data) }

fn doctype_ended(m: Machine) -> Machine / {abort.raise} = {
  let q = set_force_quirks(fault(m, EofInDoctype));
  emit_end_of_file(emit(q, doctype_token(q), m.from, m.at))
}

fn doctype_named(m: Machine, piece: Bytes) -> Machine = {
  let name = match m.doctype.name { Some(p) -> p.push(piece), None -> [piece] };
  name_grown({ ..m, doctype: { ..m.doctype, name: Some(name) } }, m.name_size + piece.len())
}

fn id_added(m: Machine, public: Bool, piece: Bytes) -> Machine = {
  let grow = |id: Option<List<Bytes>>|
    match id {
      Some(p) -> Some(if piece.len() == 0 { p } else { p.push(piece) }),
      None -> Some(if piece.len() == 0 { [] } else { [piece] }),
    };
  set_value_size(
    if public { { ..m, doctype: { ..m.doctype, public_id: grow(m.doctype.public_id) } } }
    else { { ..m, doctype: { ..m.doctype, system_id: grow(m.doctype.system_id) } } },
    m.value_size + piece.len(),
  )
}

fn doctype_open(m: Machine) -> Machine / {abort.raise} = {
  let c = next_of(m);
  if is_space(c) { into(m, BeforeDoctypeName) }
  else if c == b'>' { reconsume(m, BeforeDoctypeName) }
  else if c < 0 { doctype_ended(m) }
  else { reconsume(fault(m, MissingWhitespaceBeforeDoctypeName), BeforeDoctypeName) }
}

fn before_doctype_name(m: Machine) -> Machine / {abort.raise} = {
  let c = next_of(m);
  if is_space(c) { advance(m) } else if c == 0 {
    into(doctype_named(fault(m, UnexpectedNullCharacter), replacement()), DoctypeName)
  } else if c == b'>' { emit_doctype(set_force_quirks(fault(m, MissingDoctypeName))) }
  else if c < 0 { doctype_ended(m) }
  else { into(doctype_named(m, to_ascii_lower(current(m))), DoctypeName) }
}

fn doctype_name(m: Machine) -> Machine / {abort.raise} = {
  let c = next_of(m);
  if is_space(c) { into(m, AfterDoctypeName) }
  else if c == b'>' { emit_doctype(m) }
  else if c == 0 { advance(doctype_named(fault(m, UnexpectedNullCharacter), replacement())) }
  else if c < 0 { doctype_ended(m) } else {
    let run = run_of(m, b"\t\n\x0c\r >\x00");
    doctype_named({ ..m, at: m.at + run.len() }, to_ascii_lower(run))
  }
}

fn after_doctype_name(m: Machine) -> Machine / {abort.raise} = {
  let c = next_of(m);
  let word = to_ascii_lower(m.input.slice(m.at, min(m.at + 6, m.input.len())));
  if is_space(c) { advance(m) }
  else if c == b'>' { emit_doctype(m) }
  else if c < 0 { doctype_ended(m) }
  else if word == b"public" { { ..m, at: m.at + 6, mode: AfterKeyword(true) } }
  else if word == b"system" { { ..m, at: m.at + 6, mode: AfterKeyword(false) } }
  else if !m.ended && (b"public".starts_with(word) || b"system".starts_with(word)) {
    { ..m, waiting: true }
  } else {
    reconsume(set_force_quirks(fault(m, InvalidCharacterSequenceAfterDoctypeName)), BogusDoctype)
  }
}

fn missing_quote(public: Bool) -> ParseError =
  if public { MissingQuoteBeforeDoctypePublicIdentifier }
  else { MissingQuoteBeforeDoctypeSystemIdentifier }

fn missing_id(public: Bool) -> ParseError =
  if public { MissingDoctypePublicIdentifier } else { MissingDoctypeSystemIdentifier }

fn after_keyword(m: Machine, public: Bool) -> Machine / {abort.raise} = {
  let c = next_of(m);
  if is_space(c) { into(m, BeforeId(public)) } else if c == b'"' || c == b'\'' {
    let e = if public { MissingWhitespaceAfterDoctypePublicKeyword }
    else { MissingWhitespaceAfterDoctypeSystemKeyword };
    into(id_added(fault(m, e), public, b""), InQuotedId(public, c))
  } else if c == b'>' { emit_doctype(set_force_quirks(fault(m, missing_id(public)))) }
  else if c < 0 { doctype_ended(m) }
  else { reconsume(set_force_quirks(fault(m, missing_quote(public))), BogusDoctype) }
}

fn before_id(m: Machine, public: Bool) -> Machine / {abort.raise} = {
  let c = next_of(m);
  if is_space(c) { advance(m) }
  else if c == b'"' || c == b'\'' { into(id_added(m, public, b""), InQuotedId(public, c)) }
  else if c == b'>' { emit_doctype(set_force_quirks(fault(m, missing_id(public)))) }
  else if c < 0 { doctype_ended(m) }
  else { reconsume(set_force_quirks(fault(m, missing_quote(public))), BogusDoctype) }
}

fn in_id(m: Machine, public: Bool, quote: Int) -> Machine / {abort.raise} = {
  let c = next_of(m);
  if c == quote { into(m, AfterId(public)) }
  else if c == 0 { advance(id_added(fault(m, UnexpectedNullCharacter), public, replacement())) }
  else if c == b'>' {
    let e = if public { AbruptDoctypePublicIdentifier } else { AbruptDoctypeSystemIdentifier };
    emit_doctype(set_force_quirks(fault(m, e)))
  } else if c < 0 { doctype_ended(m) }
  else if c == 10 { advance(id_added(m, public, b"\n")) } else {
    let run = run_of(m, if quote == b'"' { b"\">\r\x00" } else { b"'>\r\x00" });
    id_added({ ..m, at: m.at + run.len() }, public, run)
  }
}

fn after_id(m: Machine, public: Bool) -> Machine / {abort.raise} = {
  let c = next_of(m);
  if is_space(c) { if public { into(m, BetweenIds) } else { advance(m) } }
  else if c == b'>' { emit_doctype(m) }
  else if c < 0 { doctype_ended(m) } else if public && (c == b'"' || c == b'\'') {
    into(
      id_added(fault(m, MissingWhitespaceBetweenDoctypePublicAndSystemIdentifiers), false, b""),
      InQuotedId(false, c),
    )
  } else if public {
    reconsume(set_force_quirks(fault(m, MissingQuoteBeforeDoctypeSystemIdentifier)), BogusDoctype)
  } else { reconsume(fault(m, UnexpectedCharacterAfterDoctypeSystemIdentifier), BogusDoctype) }
}

fn between_doctype_ids(m: Machine) -> Machine / {abort.raise} = {
  let c = next_of(m);
  if is_space(c) { advance(m) }
  else if c == b'>' { emit_doctype(m) }
  else if c == b'"' || c == b'\'' { into(id_added(m, false, b""), InQuotedId(false, c)) }
  else if c < 0 { doctype_ended(m) } else {
    reconsume(set_force_quirks(fault(m, MissingQuoteBeforeDoctypeSystemIdentifier)), BogusDoctype)
  }
}

fn bogus_doctype(m: Machine) -> Machine / {abort.raise} = {
  let c = next_of(m);
  if c == b'>' { emit_doctype(m) }
  else if c == 0 { advance(fault(m, UnexpectedNullCharacter)) }
  else if c < 0 { emit_end_of_file(emit(m, doctype_token(m), m.from, m.at)) }
  else { { ..m, at: m.input.skip_until(m.at + 1, b">\x00") } }
}

fn instruction_as_comment(m: Machine, e: ParseError) -> Machine =
  reconsume(
    { ..fault(m, e), data: [b"?".concat(m.temp)], value_size: m.temp.len() + 1 },
    BogusComment,
  )

fn instruction_open(m: Machine) -> Machine / {abort.raise} = {
  let c = next_of(m);
  if is_letter(c) || c == b'_' { reconsume(m, InstructionTarget) }
  else if c < 0 { emit_end_of_file(fault(m, EofInProcessingInstruction)) }
  else { instruction_as_comment(m, InvalidFirstCharacterOfProcessingInstructionTarget) }
}

fn instruction_target(m: Machine) -> Machine / {abort.raise} = {
  let c = next_of(m);
  if is_space(c) || c == b'?' || c == b'>' {
    let target = to_ascii_lower(m.temp);
    if target == b"xml" || target == b"xml-stylesheet" {
      instruction_as_comment(m, DisallowedProcessingInstructionTarget)
    } else { reconsume({ ..m, data: [], value_size: 0 }, AfterInstructionTarget) }
  } else if is_letter(c) || is_digit(c) || c == b'-' || c == b'_' {
    let run = m.input.slice(
      m.at,
      m.input.skip(m.at, b"-_0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"),
    );
    name_grown({ ..m, at: m.at + run.len(), temp: m.temp.concat(run) }, m.temp.len() + run.len())
  } else if c < 0 { emit_end_of_file(fault(m, EofInProcessingInstruction)) }
  else { instruction_as_comment(m, InvalidProcessingInstructionTarget) }
}

fn emit_instruction(m: Machine) -> Machine / {abort.raise} =
  {
    ..emit(m, Instruction(String::of_bytes_lossy(m.temp), joined_bytes(m.data)), m.from, m.at + 1),
    at: m.at + 1,
    mode: Reading(Data),
    data: [],
  }

fn instruction_data(m: Machine) -> Machine / {abort.raise} = {
  let c = next_of(m);
  match m.mode {
    AfterInstructionTarget -> if is_space(c) { advance(m) } else { reconsume(m, InstructionData) },
    InstructionQuestion -> if c == b'>' { emit_instruction(m) }
    else if c < 0 { emit_end_of_file(fault(m, EofInProcessingInstruction)) }
    else { reconsume(data_added(m, b"?"), InstructionData) },
    _ -> if c == b'?' { into(m, InstructionQuestion) }
    else if c == b'>' { emit_instruction(m) }
    else if c < 0 { emit_end_of_file(fault(m, EofInProcessingInstruction)) }
    else if c == 10 { advance(data_added(m, b"\n")) } else {
      let run = run_of(m, b"?>\r");
      data_added({ ..m, at: m.at + run.len() }, run)
    },
  }
}

fn step(m: Machine) -> Machine / {abort.raise} =
  match m.mode {
    Reading(s) -> read_state(m, s),
    CdataBracket -> cdata_bracket(m),
    CdataEnd -> cdata_end(m),
    TagOpen -> tag_open(m),
    EndTagOpen -> end_tag_open(m),
    TagName -> tag_name(m),
    TextLessThan(kind) -> text_less_than(m, kind),
    TextEndOpen(kind) -> text_end_open(m, kind),
    TextEndName(kind) -> text_end_name(m, kind),
    EscapeStart -> escape_start(m, 0),
    EscapeStartDash -> escape_start(m, 1),
    Escaped -> escaped(m, false, 0),
    EscapedDash -> escaped(m, false, 1),
    EscapedDashDash -> escaped(m, false, 2),
    DoubleEscapeStart -> double_escape(m, false),
    DoubleEscaped -> escaped(m, true, 0),
    DoubleEscapedDash -> escaped(m, true, 1),
    DoubleEscapedDashDash -> escaped(m, true, 2),
    DoubleEscapedLessThan -> double_escaped_less_than(m),
    DoubleEscapeEnd -> double_escape(m, true),
    BeforeAttributeName -> before_attribute_name(m),
    AttributeName -> attribute_name(m),
    AfterAttributeName -> after_attribute_name(m),
    BeforeAttributeValue -> before_attribute_value(m),
    AttributeValue(quote) -> attribute_value(m, quote),
    AfterAttributeValue -> after_attribute_value(m),
    SelfClosing -> self_closing(m),
    BogusComment -> bogus_comment(m),
    Declaration -> declaration(m),
    DoctypeOpen -> doctype_open(m),
    BeforeDoctypeName -> before_doctype_name(m),
    DoctypeName -> doctype_name(m),
    AfterDoctypeName -> after_doctype_name(m),
    AfterKeyword(public) -> after_keyword(m, public),
    BeforeId(public) -> before_id(m, public),
    InQuotedId(public, quote) -> in_id(m, public, quote),
    AfterId(public) -> after_id(m, public),
    BetweenIds -> between_doctype_ids(m),
    BogusDoctype -> bogus_doctype(m),
    InstructionOpen -> instruction_open(m),
    InstructionTarget -> instruction_target(m),
    AfterInstructionTarget | InstructionData | InstructionQuestion -> instruction_data(m),
    Ended -> m,
    _ -> comment_state(m),
  }

fn can_continue(m: Machine) -> Bool =
  m.stop == None && !m.waiting && m.out.len() == 0 && m.mode != Ended
    && (m.at < m.input.len() || m.ended)

fn scan_input_stream(m: Machine) -> Machine / {abort.raise} =
  if m.checked_to >= m.input.len() { m } else {
    {
      ..m,
      checked: m.checked.concat(input_stream_problems(m.input, m.checked_to)),
      checked_to: m.input.len(),
    }
  }

fn run_machine(m: Machine) -> Machine / {abort.raise} =
  iterate(scan_input_stream(m), 4 * (m.input.len() - m.at) + 64, |s: Machine|
    if can_continue(s) { Continue(step(s)) } else { Stop(s) })

/// Tracks the progress of tokenizing: the input read so far and the state that reads next. Only
/// this module creates a `Cursor`, so its state is always one the tokenizer itself reached.
pub opaque type Cursor = | Cursor(Machine)

fn machine_of(c: Cursor) -> Machine = match c { Cursor(m) -> m }

/// Returns a cursor that reads `input` from the tokenizer state `start`. The caller chooses the
/// tokenizer state for each following token with `with_state`, as an HTML tree builder does.
pub fn cursor(input: Bytes, start: Start, limits: Limits) -> Cursor =
  Cursor(machine(decoded(input), start, limits, false, true))

/// Returns a cursor that reads `input` from the initial tokenizer state. It switches the tokenizer
/// state itself after the start tags of `title`, `textarea`, `style`, `xmp`, `iframe`, `noembed`,
/// `noframes`, `script` and `plaintext`, so the caller needs no tree builder.
pub fn markup_cursor(input: Bytes, limits: Limits) -> Cursor =
  Cursor(machine(decoded(input), start(), limits, true, true))

/// The reading with its next token read in `state`, which the tree builder decides after the
/// token it was last given.
pub fn with_state(c: Cursor, state: State) -> Cursor =
  Cursor({ ..machine_of(c), mode: Reading(state) })

/// Returns a cursor that reads `<![CDATA[` as a CDATA section if `foreign` is true, and as a bogus
/// comment otherwise. A tree builder sets `foreign` to true when the element being read is not in
/// the HTML namespace, such as an element inside `svg`.
pub fn with_foreign(c: Cursor, foreign: Bool) -> Cursor =
  Cursor({ ..machine_of(c), foreign: foreign })

/// The next token and the reading after it, or `None` after `EndOfFile`. Raises `html.fail` if
/// the token would pass a limit.
pub fn next(c: Cursor) -> Option<{ lexeme: Lexeme, rest: Cursor }> / {html.fail} = {
  let m = machine_of(c);
  let read = if m.out.len() > 0 { m } else {
    handle {
      run_machine(m)
    } with {
      abort.raise(add_text) ->
        { ..m, stop: Some({ offset: m.at, reason: InternalError(add_text) }) },
    }
  };
  match read.stop {
    Some(rejection) -> html.fail(rejection),
    None -> match read.out {
      [] -> None,
      [first, ..rest] -> Some({ lexeme: first, rest: Cursor({ ..read, out: rest }) }),
    },
  }
}

/// The reading's tokens as a sequence, each read when it is pulled.
pub fn tokens(c: Cursor) -> Seq<Lexeme | {html.fail}> =
  token_sequence(c, machine_of(c).limits.tokens + 2)

fn token_sequence(c: Cursor, fuel: Int) -> Seq<Lexeme | {html.fail}> =
  ||
    if fuel <= 0 { seq::Done } else {
      match next(c) {
        None -> seq::Done,
        Some(t) -> seq::Yield(t.lexeme, token_sequence(t.rest, fuel - 1)),
      }
    }

/// Every token of the reading, `EndOfFile` last, or the error for the first one that would pass
/// a limit.
pub fn tokenize(c: Cursor) -> Result<List<Lexeme>, Error> =
  try { collect_tokens(c, [], machine_of(c).limits.tokens + 2) }

fn collect_tokens(c: Cursor, accumulator: List<Lexeme>, fuel: Int) -> List<Lexeme> / {html.fail} =
  if fuel <= 0 { accumulator } else {
    match next(c) {
      None -> accumulator,
      Some(t) -> collect_tokens(t.rest, accumulator.push(t.lexeme), fuel - 1),
    }
  }

/// Where in a URL an attribute value is written. `Start` is the beginning of the URL, so the value
/// may begin it with a scheme. `First` is inside the first part of the URL, where a scheme could
/// still end. `Path` is the path. `Query` is after a `?` or a `#`.
pub type UrlPart = | Start | First | Path | Query

/// Returns `value` encoded for writing at `part` of a URL, or `Err` with the scheme `value` would
/// give the URL when that scheme is not allowed. In `Query` the whole value is percent-encoded. In
/// the other parts only the bytes a URL cannot contain unencoded are encoded (RFC 3986 §2), so the
/// value's own `/`, `?` and `%XX` keep their meaning. At `Start` the scheme must be `http`,
/// `https`, `mailto` or `tel`. At `First` any scheme is rejected. A value with no `:` before its
/// first `/`, `?` or `#` has no scheme. When `trusted` is true, no scheme is rejected.
pub fn url_value(
  part: UrlPart,
  value: String,
  trusted: Bool,
) -> Result<String, String> / {abort.raise} =
  match part {
    Query -> Ok(url_encode(value)),
    Path -> Ok(raw_encoded(value)),
    Start -> check_scheme(raw_encoded(value), trusted, true),
    First -> check_scheme(raw_encoded(value), trusted, false),
  }

fn check_scheme(url: String, trusted: Bool, opens: Bool) -> Result<String, String> / {abort.raise} = {
  let text = Bytes::of_string(url);
  let stop = text.skip_until(0, b":/?#");
  if text.peek(stop) != b':' || trusted { Ok(url) } else {
    let scheme = text.slice(0, stop);
    if opens && is_allowed_scheme(to_ascii_lower(scheme)) { Ok(url) }
    else { Err(String::of_bytes(scheme)) }
  }
}

fn is_allowed_scheme(scheme: Bytes) -> Bool =
  scheme == b"http" || scheme == b"https" || scheme == b"mailto" || scheme == b"tel"

fn is_scheme_char(c: Int) -> Bool =
  is_letter(c) || is_digit(c) || c == b'+' || c == b'-' || c == b'.'

type SchemeScan = { name: Bytes, open: Bool, colon: Bool }

/// Returns the scheme a browser takes `url` to have, in lower case, or `None` if it takes `url` to
/// have none. It follows the URL Standard's parser: leading blanks and control characters are
/// dropped, and tabs and line ends are dropped anywhere in `url`, even inside the scheme. The
/// scheme is a letter followed by letters, digits, `+`, `-` or `.`, and ends at a `:`. A program
/// should check a URL with this function before passing it to `url_value` with `trusted` set to
/// true.
pub fn browser_scheme(url: String) -> Option<String> / {abort.raise} = {
  let bytes = Bytes::of_string(url);
  let read = range(0, bytes.len()).fold(
    { name: b"", open: true, colon: false },
    |s: SchemeScan, i: Int| {
      let c = bytes.at(i);
      if !s.open || c == 9 || c == 10 || c == 13 || (s.name == b"" && c <= 32) { s }
      else if c == b':' { { ..s, open: false, colon: true } }
      else if is_scheme_char(c) { { ..s, name: s.name.concat(to_ascii_lower(byte_of_int(c))) } }
      else { { ..s, open: false } }
    },
  );
  if read.colon && is_letter(read.name.peek(0)) { Some(String::of_bytes(read.name)) } else { None }
}

fn raw_encoded(value: String) -> String / {abort.raise} = {
  let text = Bytes::of_string(value);
  let digit = |n: Int| b"0123456789ABCDEF".slice(n, n + 1);
  String::of_bytes(
    Bytes::concat_all(
      range(0, text.len()).map(|i: Int| {
        let c = text.at(i);
        let escaped = c == b'%' && hex_value(text.peek(i + 1)) >= 0
          && hex_value(text.peek(i + 2)) >= 0;
        if is_letter(c) || is_digit(c) || escaped
            || b"-._~:/?#[]@!$&'()*+,;=".index_of_byte(c) != None { byte_of_int(c) }
        else { Bytes::concat_all([b"%", digit(c / 16), digit(c % 16)]) }
      }),
    ),
  )
}

fn url_attributes() -> List<Bytes> =
  [
    b"href",
    b"src",
    b"action",
    b"formaction",
    b"cite",
    b"data",
    b"poster",
    b"background",
    b"manifest",
    b"icon",
    b"longdesc",
    b"codebase",
    b"classid",
    b"archive",
    b"profile",
    b"usemap",
  ]

fn contains_url(attribute: Bytes) -> Bool / {abort.raise} = {
  let named_reference = if attribute.starts_with(b"data-") { attribute.slice(5, attribute.len()) }
  else {
    match attribute.index_of(b":") {
      Some(colon) -> attribute.slice(colon + 1, attribute.len()),
      None -> attribute,
    }
  };
  url_attributes().contains(named_reference)
}

type UrlLayout = | NoUrl | SingleUrl | SpaceSeparatedUrls | SrcsetCandidates | RefreshUrl

type UrlState =
  | NotInUrl
  | UrlStart
  | SchemeLetters
  | HoleInFirstPart
  | InPath
  | InQuery
  | DisallowedScheme
  | Mixed
  | Barred
  | InDescriptors
  | RefreshDelay
  | AfterDelay
  | UrlKey
  | AfterKey

type InvalidCharacter = { message: String, offset: Int }

fn refresh_declared(m: Machine) -> Bool =
  m.tag.attributes.fold(false, |seen: Bool, a: Attribute|
    seen || (a.name == "http-equiv" && a.value.ascii_lower() == "refresh"))

fn value_opened(m: Machine) -> Machine / {abort.raise} =
  if !m.urls { m } else {
    let name = Bytes::concat_all(m.attribute.name);
    let link = if name == b"srcset" || name == b"imagesrcset" { SrcsetCandidates }
    else if name == b"ping" { SpaceSeparatedUrls }
    else if name == b"content" && Bytes::concat_all(m.tag.name) == b"meta" && refresh_declared(m) {
      RefreshUrl
    } else if contains_url(name) { SingleUrl }
    else { NoUrl };
    {
      ..m,
      link: link,
      url: match link { NoUrl -> NotInUrl, RefreshUrl -> RefreshDelay, _ -> UrlStart },
      word: b"",
    }
  }

type UrlScan = { url: UrlState, word: Bytes, broken: Bool }

fn after_first_part(c: Int) -> UrlState = if c == b'?' || c == b'#' { InQuery } else { InPath }

fn url_step(t: UrlScan, c: Int) -> UrlScan / {abort.raise} = {
  let to = |u: UrlState|
    { url: u, word: if u == DisallowedScheme { t.word } else { b"" }, broken: false };
  let fresh = { url: UrlStart, word: b"", broken: false };
  match t.url {
    RefreshDelay -> if is_digit(c) || c == b'.' || is_space(c) { t }
    else if c == b';' || c == b',' { to(AfterDelay) }
    else { in_url(fresh, c) },
    AfterDelay -> if is_space(c) { t }
    else if c == b'u' || c == b'U' { { url: UrlKey, word: b"u", broken: false } }
    else if c == b'"' || c == b'\'' { fresh }
    else { in_url(fresh, c) },
    UrlKey -> {
      let longer = t.word.concat(to_ascii_lower(byte_of_int(c)));
      if b"url".starts_with(longer) { { ..t, word: longer } }
      else if t.word == b"url" && is_space(c) { t }
      else if t.word == b"url" && c == b'=' { to(AfterKey) }
      else { range(0, longer.len()).fold(fresh, |u: UrlScan, i: Int| in_url(u, longer.at(i))) }
    },
    AfterKey -> if is_space(c) { t }
    else if c == b'"' || c == b'\'' { fresh }
    else { in_url(fresh, c) },
    _ -> in_url(t, c),
  }
}

fn in_url(t: UrlScan, c: Int) -> UrlScan / {abort.raise} = {
  let to = |u: UrlState|
    { url: u, word: if u == DisallowedScheme { t.word } else { b"" }, broken: false };
  match t.url {
    UrlStart -> if c <= 32 { t } else if is_letter(c) {
      { url: SchemeLetters, word: to_ascii_lower(byte_of_int(c)), broken: false }
    } else { to(after_first_part(c)) },
    SchemeLetters -> if c == 9 || c == 10 || c == 13 { t }
    else if is_scheme_char(c) { { ..t, word: t.word.concat(to_ascii_lower(byte_of_int(c))) } }
    else if c == b':' { to(if is_allowed_scheme(t.word) { InPath } else { DisallowedScheme }) }
    else { to(after_first_part(c)) },
    HoleInFirstPart -> if c == b':' { { ..t, broken: true } }
    else if c == b'/' || c == b'\\' || c == b'?' || c == b'#' { to(after_first_part(c)) }
    else { t },
    InPath -> if c == b'?' || c == b'#' { to(InQuery) } else { t },
    Mixed -> if c == b':' { { ..t, broken: true } }
    else if c == b'?' || c == b'#' { to(InQuery) }
    else { t },
    Barred -> if c == b':' { { ..t, broken: true } } else { t },
    InDescriptors -> if c == b',' { to(UrlStart) } else { t },
    _ -> t,
  }
}

fn linked_step(link: UrlLayout, t: UrlScan, c: Int) -> UrlScan / {abort.raise} = {
  let spaced = c == 9 || c == 10 || c == 12 || c == 13 || c == 32;
  let in_url = t.url != UrlStart && t.url != InDescriptors && t.url != NotInUrl;
  if link == SpaceSeparatedUrls && spaced && in_url { { url: UrlStart, word: b"", broken: false } }
  else if link == SrcsetCandidates && spaced && in_url {
    { url: InDescriptors, word: b"", broken: false }
  } else { url_step(t, c) }
}

fn scan_url(m: Machine, piece: Bytes) -> Machine / {abort.raise} = {
  let start = max(m.at - piece.len(), 0);
  let read = iterate(
    { i: 0, t: { url: m.url, word: m.word, broken: false }, stray: m.first_invalid_character },
    piece.len() + 1,
    |s: { i: Int, t: UrlScan, stray: Option<InvalidCharacter> }|
      if s.i >= piece.len() { Stop(s) } else {
        let t = linked_step(m.link, s.t, piece.at(s.i));
        let stray = if t.broken && s.stray == None {
          Some({
            message: "a `:` after a hole makes the hole's value a URL scheme such as `https`: write the scheme in the markup, or put the whole URL in the hole",
            offset: start + s.i,
          })
        } else { s.stray };
        Continue({ i: s.i + 1, t: { ..t, broken: false }, stray: stray })
      },
  );
  { ..m, url: read.t.url, word: read.t.word, first_invalid_character: read.stray }
}

fn check_refresh_hole(m: Machine) -> Machine =
  if m.tag_attributes.len() == 0 || Bytes::concat_all(m.tag.name) != b"meta"
      || !m.tag_attributes.contains(b"content")
      || !refresh_declared(m) { m } else {
    match m.first_invalid_character {
      Some(_) -> m,
      None ->
        {
          ..m,
          first_invalid_character: Some({
            message: "a hole in a `<meta>` tag's `content` comes before its `http-equiv=refresh`, so the hole is not read as a URL: write `http-equiv` before `content`",
            offset: m.at,
          }),
        },
    }
  }

/// A position in markup that is read in pieces: in an element's content, in a tag, in an
/// attribute's value, or in a comment. It is the state of the tokenizer between two pieces of text.
/// The tokenizer switches state itself for elements whose content needs no tree builder.
pub opaque type Context = | Context(Machine)

fn machine_at(c: Context) -> Machine = match c { Context(m) -> m }

fn unlimited() -> Limits =
  {
    tokens: 4611686018427387903,
    attributes: 4611686018427387903,
    name: 4611686018427387903,
    value: 4611686018427387903,
    output: 4611686018427387903,
  }

/// Where a reader starts: in an element's content. With `urls`, it follows the URL of each
/// attribute that contains one, so `hole` reports how much of the URL comes before a hole. It then
/// rejects a hole under a scheme that `url_value` does not allow, and a `:` that would make a
/// hole's value the scheme. Without `urls`, URLs are not checked.
pub fn reader(urls: Bool) -> Context =
  Context({ ..machine(b"", start(), unlimited(), true, false), urls: urls })

/// Markup text together with the positions before and after it. Only `run` creates one, so the text
/// was read in full, starting at the `from` position.
pub opaque type Run = new { markup: String, from: Context, to: Context }

fn feed(m: Machine, text: Bytes) -> Machine / {abort.raise} = {
  let held_back = m.input.slice(m.at, m.input.len());
  {
    ..m,
    input: held_back.concat(text),
    at: 0,
    waiting: false,
    from: m.from - m.at,
    text_from: m.text_from - m.at,
    problems: m.problems.map(|p: Problem| { ..p, offset: p.offset - m.at }),
    checked: [],
    checked_at: 0,
    checked_to: held_back.len(),
    first_invalid_character: match m.first_invalid_character {
      Some(s) -> Some({ ..s, offset: s.offset - m.at }),
      None -> None,
    },
  }
}

type DrainResult = { m: Machine, problems: List<Problem> }

fn drain(m: Machine) -> DrainResult / {abort.raise} =
  iterate({ m: m, problems: [] }, 4 * m.input.len() + 64, |d: DrainResult| {
    let read = run_machine(d.m);
    let problem = read.out.fold(d.problems, |all: List<Problem>, l: Lexeme| all.concat(l.problems));
    if read.out.len() > 0 { Continue({ m: { ..read, out: [] }, problems: problem }) } else {
      Stop({
        m: read,
        problems: problem.concat(
          read.problems.concat(read.checked.slice(read.checked_at, read.checked.len())),
        ),
      })
    }
  })

fn first_problem(
  d: DrainResult,
  text: Bytes,
  skipped: Int,
) -> Option<{ message: String, offset: Int }> / {abort.raise} = {
  let chars = |byte: Int|
    String::of_bytes_lossy(text.slice(0, min(max(byte - skipped, 0), text.len()))).len();
  let earliest = d.problems.fold(None, |best: Option<Problem>, p: Problem|
    match best { Some(b) -> if p.offset < b.offset { Some(p) } else { best }, None -> Some(p) });
  match ((earliest, d.m.first_invalid_character)) {
    (Some(p), Some(s)) -> if s.offset < p.offset {
      Some({ message: s.message, offset: chars(s.offset) })
    } else { Some({ message: explain(p.error), offset: chars(p.offset) }) },
    (Some(p), None) -> Some({ message: explain(p.error), offset: chars(p.offset) }),
    (None, Some(s)) -> Some({ message: s.message, offset: chars(s.offset) }),
    (None, None) -> None,
  }
}

/// Reads `text` as markup from `from`, or returns the first character that is not allowed where
/// it appears, with its offset in `text`: a parse error, or a `:` that would make a hole's value a
/// URL's scheme.
pub fn run(
  from: Context,
  text: String,
) -> Result<Run, { message: String, offset: Int }> / {abort.raise} = {
  let m = machine_at(from);
  let bytes = Bytes::of_string(text);
  let d = drain(feed(m, bytes));
  match first_problem(d, bytes, m.input.len() - m.at) {
    Some(amiss) -> Err(amiss),
    None ->
      Ok({
        markup: text,
        from: from,
        to: Context({ ..d.m, problems: [], first_invalid_character: None }),
      }),
  }
}

/// A hole at the reader position `from`: how its value is written; how much of a URL comes before
/// it, if the reader follows URLs and the hole's attribute contains one, and whether it is in a
/// list whose commas separate URLs; and the reader position after it.
pub opaque type Hole = new {
  place: Place,
  url: Option<UrlPart>,
  listed: Bool,
  from: Context,
  to: Context,
}

type HolePosition = { place: Place, url: Option<UrlPart>, listed: Bool, m: Machine }

fn element_of(m: Machine) -> String = String::of_bytes_lossy(m.last_start)

fn is_code_attribute(attribute: Bytes) -> Bool =
  attribute.starts_with(b"on") || attribute == b"style" || attribute == b"srcdoc"
    || attribute == b"http-equiv"

fn in_value(m: Machine, place: Place) -> Result<HolePosition, String> = {
  let listed = m.link == SrcsetCandidates;
  let at = |part: UrlPart, next: UrlState|
    Ok({ place: place, url: Some(part), listed: listed, m: { ..m, url: next } });
  match m.url {
    NotInUrl ->
      Ok({
        place: place,
        url: None,
        listed: false,
        m: { ..m, tag_attributes: m.tag_attributes.push(Bytes::concat_all(m.attribute.name)) },
      }),
    UrlStart | AfterDelay | AfterKey -> at(Start, HoleInFirstPart),
    SchemeLetters | HoleInFirstPart | UrlKey -> at(First, HoleInFirstPart),
    InPath -> at(Path, InPath),
    InQuery -> at(Query, InQuery),
    DisallowedScheme ->
      Err(
        "a hole is allowed in a URL with no scheme or with the scheme `http`, `https`, `mailto` or `tel`: this URL's scheme is `"
          ++ String::of_bytes_lossy(m.word)
          ++ "`",
      ),
    Mixed ->
      Err(
        "the markup before this hole ends in more than one part of the URL, such as the path and the query, so it is unclear where in the URL the hole is: end the markup in one part",
      ),
    Barred ->
      Err(
        "the markup before this hole ends in an incomplete URL scheme or in a part of the URL where a hole is not allowed: write the scheme in full, or move the hole",
      ),
    InDescriptors ->
      Err("a hole in a `srcset` must be in a candidate's URL, not in its descriptors"),
    RefreshDelay -> Err("a hole in a refresh's `content` must be in its URL, not in its delay"),
  }
}

fn hole_position(m: Machine) -> Result<HolePosition, String> / {abort.raise} = {
  let attribute = Bytes::concat_all(m.attribute.name);
  let code = "a hole in `" ++ String::of_bytes_lossy(attribute)
    ++ "` would be read as program code, and escaping cannot turn the hole's value into text";
  let raw = "a hole in `<" ++ element_of(m)
    ++ ">` would be read as the element's script or style text";
  if m.at < m.input.len() {
    Err(
      "the markup before this hole ends inside a character reference such as `&am`, a `<!` or a doctype keyword: finish that markup before the hole",
    )
  } else {
    match m.mode {
      Reading(Data) -> Ok({ place: Content, url: None, listed: false, m: m }),
      Reading(Rcdata) -> Ok({ place: Characters, url: None, listed: false, m: m }),
      AttributeValue(quote) -> if is_code_attribute(attribute) { Err(code) } else if quote == 0 {
        Err("quote the value: a hole must be inside its quotes, or be the whole value")
      } else { in_value(m, Characters) },
      BeforeAttributeValue -> if is_code_attribute(attribute) { Err(code) } else {
        match in_value(value_opened(m), Value) {
          Ok(s) -> Ok({ ..s, m: { ..s.m, mode: AfterAttributeValue } }),
          Err(reason) -> Err(reason),
        }
      },
      Reading(_) | TextLessThan(_) | TextEndOpen(_) | TextEndName(_) | EscapeStart | EscapeStartDash | Escaped | EscapedDash | EscapedDashDash | DoubleEscapeStart | DoubleEscaped | DoubleEscapedDash | DoubleEscapedDashDash | DoubleEscapedLessThan | DoubleEscapeEnd | CdataBracket | CdataEnd ->
        Err(raw),
      BogusComment | Declaration | CommentStart | CommentStartDash | InComment | CommentLessThan | CommentLessThanBang | CommentLessThanBangDash | CommentLessThanBangDashDash | CommentEndDash | CommentEnd | CommentEndBang ->
        Err("a hole cannot be inside a comment"),
      DoctypeOpen | BeforeDoctypeName | DoctypeName | AfterDoctypeName | AfterKeyword(_) | BeforeId(_) | InQuotedId(_, _) | AfterId(_) | BetweenIds | BogusDoctype ->
        Err("a hole cannot be inside a doctype"),
      InstructionOpen | InstructionTarget | AfterInstructionTarget | InstructionData | InstructionQuestion ->
        Err("a hole cannot be inside a processing instruction"),
      _ -> Err("a hole can appear only in an element's content or in an attribute's value"),
    }
  }
}

/// The hole a value may fill at `at`, or why no hole may appear there.
pub fn hole(at: Context) -> Result<Hole, String> / {abort.raise} =
  match hole_position(machine_at(at)) {
    Err(message) -> Err(message),
    Ok(s) -> Ok({ place: s.place, url: s.url, listed: s.listed, from: at, to: Context(s.m) }),
  }

/// What markup that ends at `at` is missing, if anything: `None` if the input could end there
/// with no parse error and no text element left open.
pub fn missing_markup(at: Context) -> Option<String> / {abort.raise} = {
  let m = machine_at(at);
  match m.mode {
    Reading(Data) | TagOpen | EndTagOpen | TagName | BeforeAttributeName | AttributeName | AfterAttributeName | BeforeAttributeValue | AttributeValue(_) | AfterAttributeValue | SelfClosing | BogusComment | Declaration | CommentStart | CommentStartDash | InComment | CommentLessThan | CommentLessThanBang | CommentLessThanBangDash | CommentLessThanBangDashDash | CommentEndDash | CommentEnd | CommentEndBang | DoctypeOpen | BeforeDoctypeName | DoctypeName | AfterDoctypeName | AfterKeyword(_) | BeforeId(_) | InQuotedId(_, _) | AfterId(_) | BetweenIds | BogusDoctype | InstructionOpen | InstructionTarget | AfterInstructionTarget | InstructionData | InstructionQuestion -> {
      let d = drain({ ..m, ended: true, waiting: false });
      match first_problem(d, b"", 0) {
        Some(amiss) -> Some(amiss.message),
        None -> if d.m.mode == Ended || d.m.mode == Reading(Data) { None }
        else { Some("a tag is not closed") },
      }
    },
    _ -> Some("`<" ++ element_of(m) ++ ">` is not closed"),
  }
}

fn normalize_state(m: Machine) -> Machine / {abort.raise} = {
  let cleared: Machine = {
    ..m,
    input: m.input.slice(m.at, m.input.len()),
    at: 0,
    from: 0,
    text: [],
    text_size: 0,
    text_from: 0,
    data: [],
    doctype: no_doctype(),
    checked: [],
    checked_at: 0,
    checked_to: m.input.len() - m.at,
    out: [],
    tokens: 0,
    output: 0,
    name_size: 0,
    value_size: 0,
    attribute: { ..m.attribute, value: [] },
  };
  let named_reference = |s: Machine|
    {
      ..s,
      tag: { ..s.tag, attributes: names_only(s.tag.attributes) },
      tag_attributes: unique_sorted(s.tag_attributes),
      temp: b"",
    };
  let unlinked = |s: Machine| { ..named_reference(s), link: NoUrl, url: NotInUrl, word: b"" };
  match m.mode {
    Reading(Data) ->
      {
        ..cleared,
        tag: no_tag(),
        attribute: no_attribute(),
        tag_attributes: [],
        last_start: b"",
        temp: b"",
        link: NoUrl,
        url: NotInUrl,
        word: b"",
      },
    TagName -> unlinked({ ..cleared, mode: AfterAttributeValue }),
    AttributeName ->
      unlinked({ ..attribute_closed(name_left(cleared)), mode: AfterAttributeValue }),
    BeforeAttributeName | AfterAttributeValue | SelfClosing -> unlinked(attribute_closed(cleared)),
    AfterAttributeName | BeforeAttributeValue -> unlinked(cleared),
    AttributeValue(_) -> named_reference(cleared),
    TextEndName(_) ->
      {
        ..cleared,
        tag: { ..no_tag(), name: m.tag.name, end: true },
        attribute: no_attribute(),
        tag_attributes: [],
      },
    _ ->
      {
        ..cleared,
        tag: no_tag(),
        attribute: no_attribute(),
        tag_attributes: [],
        link: NoUrl,
        url: NotInUrl,
        word: b"",
      },
  }
}

fn names_only(attributes: List<Attribute>) -> List<Attribute> =
  unique_sorted(attributes.map(|a: Attribute| Bytes::of_string(a.name))).map(|name: Bytes|
    { name: String::of_bytes_lossy(name), value: "" })

fn unique_sorted(xs: List<Bytes>) -> List<Bytes> =
  xs.sort().fold([], |out: List<Bytes>, x: Bytes|
    match out.at(out.len() - 1) {
      Some(last) -> if last == x { out } else { out.push(x) },
      None -> out.push(x),
    })

/// Returns a position that either `a` or `b` may have reached, or `None` if no single position
/// covers both, such as an element's content and the inside of a tag. Text read from the result is
/// read the same way as from `a` and from `b`, and a hole there behaves as it does in both.
///
/// Inside a tag, the result has the attributes of both positions. It is after a space only if both
/// positions are, and it is inside a name only where the next character must end the name.
///
/// Inside an attribute's URL, a hole is allowed only at a point both positions allow one. Once a
/// `?` or `#` has been read in both, the position is in the query.
pub fn join(a: Context, b: Context) -> Option<Context> / {abort.raise} = {
  let x0 = normalize_state(machine_at(a));
  let y0 = normalize_state(machine_at(b));
  let gap = |s: Machine|
    s.mode == AfterAttributeValue || s.mode == BeforeAttributeName || s.mode == AfterAttributeName;
  let loose = |s: Machine| s.mode == BeforeAttributeName || s.mode == AfterAttributeName;
  let both_gap = gap(x0) && gap(y0);
  let mode = if loose(x0) && loose(y0) { BeforeAttributeName } else { AfterAttributeValue };
  let resolved = |s: Machine|
    if !both_gap { s }
    else if s.mode == AfterAttributeName { { ..attribute_closed(s), mode: mode } }
    else { { ..s, mode: mode } };
  let xs = resolved(x0);
  let ys = resolved(y0);
  let attributes = names_only(xs.tag.attributes.concat(ys.tag.attributes));
  let merged_attributes = unique_sorted(xs.tag_attributes.concat(ys.tag_attributes));
  let x = { ..xs, tag: { ..xs.tag, attributes: attributes }, tag_attributes: merged_attributes };
  let y = { ..ys, tag: { ..ys.tag, attributes: attributes }, tag_attributes: merged_attributes };
  let barred = |s: Machine|
    s.url != UrlStart && s.url != SchemeLetters && s.url != HoleInFirstPart && s.url != InPath
      && s.url != InQuery
      && s.url != Mixed;
  let mixed = |s: Machine|
    { ..s, word: b"", url: if barred(x) || barred(y) { Barred } else { Mixed } };
  if x0 == y0 { Some(Context(x0)) }
  else if x == y { Some(Context(x)) }
  else if x.url != NotInUrl && mixed(x) == mixed(y) { Some(Context(mixed(x))) }
  else { None }
}

fn follows(at: Context, from: Context) -> Bool / {abort.raise} =
  at == from || join(at, from) == Some(from)

/// A fragment being written: its pieces so far, and the position of a reader after them.
pub opaque type Draft = new { pieces: List<Piece>, at: Context }

/// An empty draft, at the position where `reader(urls)` starts.
pub fn draft(urls: Bool) -> Draft = { pieces: [], at: reader(urls) }

/// Appends `r` to the draft, or returns `None` if `r` was not read from the draft's position.
pub fn append_markup(d: Draft, r: Run) -> Option<Draft> / {abort.raise} =
  if follows(d.at, r.from) { Some({ pieces: d.pieces.push(Markup(r.markup)), at: r.to }) }
  else { None }

/// Appends `value` in the hole `h`, written as the hole's place requires, or returns `None` if `h`
/// is not a hole at the draft's position.
pub fn place(d: Draft, h: Hole, value: Html) -> Option<Draft> / {abort.raise} =
  if follows(d.at, h.from) {
    Some({ pieces: d.pieces.concat(pieces_for(h.place, value)), at: h.to })
  } else { None }

/// The fragment the draft has built, or `None` if its markup is not finished: a tag, a value, a
/// comment or a text element left open, or a parse error at its end.
pub fn finish(d: Draft) -> Option<Html> / {abort.raise} =
  if missing_markup(d.at) == None { Some({ pieces: d.pieces }) } else { None }

/// Returns the text to write for the URL value `u` placed in hole `h`. If the hole is in a URL, the
/// value is percent-encoded for the part of the URL where the hole is, and commas become `%2C` when
/// the URL is one of the URLs in a `srcset`. Returns `Err` with the scheme the value would give the
/// URL when that scheme is not allowed, unless the value is trusted. If the hole is not in a URL,
/// returns the text unchanged.
pub fn written_url(h: Hole, u: UrlText) -> Result<String, String> / {abort.raise} =
  url_written(h.url, h.listed, u)

fn url_written(
  url: Option<UrlPart>,
  listed: Bool,
  u: UrlText,
) -> Result<String, String> / {abort.raise} =
  match url {
    None -> Ok(u.text),
    Some(part) -> match url_value(part, u.text, u.trusted) {
      Ok(written) -> Ok(if listed { written.replace(",", "%2C") } else { written }),
      Err(scheme) -> Err(scheme),
    },
  }

/// Where a hole is: in an element's content; inside a quoted attribute value, a `title` or a
/// `textarea`, where only characters may appear; or as the whole of an attribute's value.
pub type Place = | Content | Characters | Value

type Slot = { place: Place, url: Option<UrlPart>, listed: Bool }

/// A literal's markup after reading: its texts as written, and where the hole after each one is.
/// Only `compile` returns one, so `fill` never writes a hole where the markup was not checked to
/// allow it.
pub opaque type Template = new { texts: List<String>, slots: List<Slot> }

/// Why a literal's markup is rejected, and at which character of which text.
pub type CompileError = { message: String, offset: Int, part: Int }

fn pieces_for(place: Place, value: Html) -> List<Piece> =
  match place {
    Content -> value.pieces,
    Characters -> [Chars(raw_text(value))],
    Value -> [Markup("\""), Chars(raw_text(value)), Markup("\"")],
  }

type CompileState = { at: Context, slots: List<Slot> }

/// Checks an `html"..."` literal with holes: reads the texts around its holes as markup,
/// following each attribute's URL, or returns the first character, hole or end that is not allowed
/// where it is. An error just past a text belongs to the hole after it, or after the last text, to
/// the literal's end.
pub fn compile(parts: List<String>) -> Result<Template, CompileError> / {abort.raise} = {
  let last = parts.len() - 1;
  let read = range(0, parts.len()).fold(
    Ok({ at: reader(true), slots: [] }),
    |accumulator: Result<CompileState, CompileError>, part: Int|
      match accumulator {
        Err(_) -> accumulator,
        Ok(c) -> {
          let text = parts.at_or(part, "");
          let ends = |message: String| Err({ message: message, offset: text.len(), part: part });
          match run(c.at, text) {
            Err(amiss) -> Err({ message: amiss.message, offset: amiss.offset, part: part }),
            Ok(r) -> if part < last {
              match hole(r.to) {
                Err(message) -> ends(message),
                Ok(h) ->
                  Ok({
                    at: h.to,
                    slots: c.slots.push({ place: h.place, url: h.url, listed: h.listed }),
                  }),
              }
            } else {
              match missing_markup(r.to) {
                Some(message) -> ends(message),
                None -> Ok({ ..c, at: r.to }),
              }
            },
          }
        },
      },
  );
  match read { Err(rejected) -> Err(rejected), Ok(c) -> Ok({ texts: parts, slots: c.slots }) }
}

/// Returns the document made by writing each value of `holes` into the matching hole of the literal
/// `t`. A value is written as markup in content, as characters inside an attribute's quotes, or as
/// a quoted value when it is the whole attribute value. In a URL, the value is percent-encoded for
/// its part of the URL, and `html.unsafe_url` is raised if it would give the URL a scheme that no
/// value may give, unless the value is a `trusted_url`. A hole with no value in `holes` is written
/// as empty.
pub fn fill(t: Template, holes: List<Html>) -> Html / {html.unsafe_url, abort.raise} =
  {
    pieces: range(0, t.texts.len()).fold([], |out: List<Piece>, i: Int| {
      let written = out.push(Markup(t.texts.at_or(i, "")));
      match t.slots.at(i) {
        None -> written,
        Some(slot) -> {
          let value = holes.at_or(i, fragment([]));
          let checked_value = match slot.url {
            None -> value,
            Some(_) -> {
              let u = match url_text(value) {
                Some(u) -> u,
                None -> { text: raw_text(value), trusted: false },
              };
              match url_written(slot.url, slot.listed, u) {
                Ok(url) -> text(url),
                Err(scheme) -> html.unsafe_url(scheme),
              }
            },
          };
          written.concat(pieces_for(slot.place, checked_value))
        },
      }
    }),
  }

/// Checks an `html"..."` literal with no hole: returns the text as markup, or where it stops being
/// valid markup.
pub fn literal(text: String) -> Result<Html, { message: String, offset: Int }> / {abort.raise} =
  match compile([text]) {
    Ok(_) -> Ok({ pieces: [Markup(text)] }),
    Err(rejected) -> Err({ message: rejected.message, offset: rejected.offset }),
  }

/// A text built from the pieces of markup, URLs and character references, for testing claims
/// about escaping: `forall (h: Hostile)` generates quotes, angle brackets, ampersands, schemes and
/// reference names far more often than a `String` does.
pub type Hostile = | Hostile(String)

/// Generates any `Hostile`.
pub fn hostile() -> Gen<Hostile> =
  gen::map(gen::list_of(gen::elements(hostile_parts()), 12), |parts: List<String>|
    Hostile(String::join(parts, "")))

fn hostile_parts() -> List<String> =
  [
    "a",
    "<",
    ">",
    "&",
    "\"",
    "'",
    " ",
    "=",
    "/",
    ":",
    ";",
    "?",
    "#",
    "%",
    "`",
    "\\",
    "-",
    "!",
    "x",
    "0",
    "amp",
    "lt",
    "not",
    "#38",
    "#x3c",
    "script",
    "javascript",
    "http",
    "data",
    "onclick",
    "%0A",
    "{{",
    "}}",
    "\t",
    "\n",
    "\u{e9}",
    "\u{0}",
  ]

/// The text of a `Hostile`.
pub fn hostile_text(h: Hostile) -> String = match h { Hostile(s) -> s }

fn written(parts: List<String>, holes: List<Html>) -> String / {abort.raise} =
  match compile(parts) {
    Ok(t) -> match try[html.unsafe_url] { fill(t, holes) } {
      Ok(page) -> render(page),
      Err(scheme) -> "unsafe " ++ scheme,
    },
    Err(rejected) -> rejected.message,
  }

fn rejected(parts: List<String>) -> Option<{ offset: Int, part: Int }> / {abort.raise} =
  match compile(parts) {
    Ok(_) -> None,
    Err(rejected) -> Some({ offset: rejected.offset, part: rejected.part }),
  }

test "a string filled into a template is escaped as text in content and in attributes, and never becomes markup" {
  let attack = text("<script>alert(\"x\")</script>");
  assert_eq(
    written(["<p>", "</p>"], [attack]),
    "<p>&lt;script&gt;alert(&quot;x&quot;)&lt;/script&gt;</p>",
  );
  assert_eq(
    written(["<a title='", "'>x</a>"], [text("' onclick='alert(1)")]),
    "<a title='&#39; onclick=&#39;alert(1)'>x</a>",
  );
  assert_eq(
    written(["<a title=", ">x</a>"], [text("a b\" onclick=\"alert(1)")]),
    "<a title=\"a b&quot; onclick=&quot;alert(1)\">x</a>",
  );
  assert_eq(written(["<p>", "</p>"], [text("a &amp; b")]), "<p>a &amp;amp; b</p>");
  assert_eq(
    written(["<title>", "</title>"], [text("</title><script>")]),
    "<title>&lt;/title&gt;&lt;script&gt;</title>",
  )
}

test "markup filled into a template is written as markup in content and escaped as text in an attribute value" {
  let inner = match compile(["<b>", "</b>"]) {
    Ok(t) -> match try[html.unsafe_url] { fill(t, [text("a < b")]) } {
      Ok(page) -> page,
      Err(_) -> fragment([]),
    },
    Err(_) -> fragment([]),
  };
  assert_eq(
    written(["<p>", " and ", "</p>"], [inner, inner]),
    "<p><b>a &lt; b</b> and <b>a &lt; b</b></p>",
  );
  assert_eq(render(fragment([inner, text("&"), inner])), "<b>a &lt; b</b>&amp;<b>a &lt; b</b>");
  assert_eq(
    written(["<i title=", "></i>"], [inner]),
    "<i title=\"&lt;b&gt;a &lt; b&lt;/b&gt;\"></i>",
  );
  assert_eq(written(["<p>", "</p>"], []), "<p></p>");
  assert_eq(written(["<i title=", "></i>"], []), "<i title=\"\"></i>")
}

test "a template accepts values in content and attribute values, and rejects them in tags, comments, scripts, styles and event handlers" {
  assert_eq(
    rejected(["<p class=x id='a", "b' ", ">", "</p><!-- c --><br/>"]),
    Some({ offset: 3, part: 1 }),
  );
  assert_eq(rejected(["<p class=", " id='a", "'>", "</p><!-- c --><br/>"]), None);
  assert_eq(rejected(["<", ">"]), Some({ offset: 1, part: 0 }));
  assert_eq(rejected(["<p ", ">"]), Some({ offset: 3, part: 0 }));
  assert_eq(rejected(["<p class=a", ">"]), Some({ offset: 10, part: 0 }));
  assert_eq(rejected(["<!-- ", " -->"]), Some({ offset: 5, part: 0 }));
  assert_eq(rejected(["<script>var x = '", "';</script>"]), Some({ offset: 17, part: 0 }));
  assert_eq(rejected(["<STYLE>p { color: ", " }</STYLE>"]), Some({ offset: 18, part: 0 }));
  assert_eq(rejected(["<a onclick='go(", ")'>"]), Some({ offset: 15, part: 0 }));
  assert_eq(rejected(["<a OnClick=", ">"]), Some({ offset: 11, part: 0 }));
  assert_eq(rejected(["<p style='color: ", "'>"]), Some({ offset: 17, part: 0 }));
  assert_eq(rejected(["<iframe srcdoc=", "></iframe>"]), Some({ offset: 15, part: 0 }));
  assert_eq(rejected(["<meta http-equiv='", "'>"]), Some({ offset: 18, part: 0 }));
  assert_eq(rejected(["<textarea>", "</textarea><script>x</script>"]), None);
  assert_eq(rejected(["<a href='&am", "'>"]), Some({ offset: 12, part: 0 }));
  assert_eq(rejected(["<!", "-- x -->"]), Some({ offset: 2, part: 0 }))
}

test "a literal checks the URL a hole is in, as a template does" {
  assert_eq(rejected(["<a href='javascript:go(", ")'>x</a>"]), Some({ offset: 23, part: 0 }));
  assert_eq(rejected(["<a href='", "://", "'>x</a>"]), Some({ offset: 0, part: 1 }));
  assert_eq(rejected(["<a href=", ">x</a>"]), None);
  assert_eq(written(["<a href=", ">x</a>"], [text("/a b?c")]), "<a href=\"/a%20b?c\">x</a>");
  assert_eq(written(["<a href='?q=", "'>x</a>"], [text("a&b")]), "<a href='?q=a%26b'>x</a>");
  assert_eq(written(["<a href=", ">x</a>"], [text("JavaScript:alert(1)")]), "unsafe JavaScript");
  assert_eq(
    written(["<a href=", ">x</a>"], [trusted_url("javascript:void(0)")]),
    "<a href=\"javascript:void(0)\">x</a>",
  );
  assert_eq(written(["<p>", "</p>"], [trusted_url("a<b")]), "<p>a&lt;b</p>")
}

test "values filled into `srcset`, `ping` and a refresh's `content` attributes are checked as URLs" {
  assert_eq(
    written(["<img srcset='", " 1x, /b.png 2x'>"], [text("/a,b c.png")]),
    "<img srcset='/a%2Cb%20c.png 1x, /b.png 2x'>",
  );
  assert_eq(
    written(["<img srcset='/a.png 1x, ", " 2x'>"], [text("javascript:x")]),
    "unsafe javascript",
  );
  assert_eq(rejected(["<img srcset='/a.png ", "x'>"]), Some({ offset: 20, part: 0 }));
  assert_eq(written(["<a ping='/a ", "'>x</a>"], [text("javascript:x")]), "unsafe javascript");
  assert_eq(written(["<a ping='", " /b'>x</a>"], [text("/a b")]), "<a ping='/a%20b /b'>x</a>");
  assert_eq(
    written(["<meta http-equiv='refresh' content='0; url=", "'>"], [text("javascript:x")]),
    "unsafe javascript",
  );
  assert_eq(
    written(["<meta http-equiv='refresh' content='5;", "'>"], [text("url=javascript:x")]),
    "unsafe url=javascript",
  );
  assert_eq(
    written(["<meta http-equiv=refresh content='0; URL=", "'>"], [text("/next page")]),
    "<meta http-equiv=refresh content='0; URL=/next%20page'>",
  );
  assert_eq(
    rejected(["<meta http-equiv='refresh' content='", "'>"]),
    Some({ offset: 36, part: 0 }),
  );
  assert_eq(
    rejected(["<meta content='0;url=", "' http-equiv='refresh'>"]),
    Some({ offset: 22, part: 1 }),
  );
  assert_eq(
    written(["<meta name='description' content='", "'>"], [text("a: b")]),
    "<meta name='description' content='a: b'>",
  )
}

test "markup that is not well formed is rejected with the offset of the first character that is wrong" {
  assert_eq(literal("a < b"), Err({ message: explain(InvalidFirstCharacterOfTagName), offset: 3 }));
  assert_eq(
    literal("a &bogus; b"),
    Err({ message: explain(UnknownNamedCharacterReference), offset: 8 }),
  );
  assert_eq(
    literal("caf\u{e9} &notit; bar"),
    Err({ message: explain(MissingSemicolonAfterCharacterReference), offset: 9 }),
  );
  assert_eq(rejected(["a &amp; b &#38; c &#x26; d & e"]), None);
  assert_eq(rejected(["<p title='a &amp b'>"]), Some({ offset: 16, part: 0 }));
  assert_eq(rejected(["<p title=>"]), Some({ offset: 9, part: 0 }));
  assert_eq(rejected(["<p title='a'id=b>"]), Some({ offset: 12, part: 0 }));
  assert_eq(rejected(["<p id=1 id=2>"]), Some({ offset: 10, part: 0 }));
  assert_eq(literal("<p"), Err({ message: explain(EofInTag), offset: 2 }));
  assert_eq(literal("<p title='a"), Err({ message: explain(EofInTag), offset: 11 }));
  assert_eq(literal("<!-- a"), Err({ message: explain(EofInComment), offset: 6 }));
  assert_eq(literal("<script>x"), Err({ message: "`<script>` is not closed", offset: 9 }));
  assert_eq(rejected(["<plaintext>"]), Some({ offset: 11, part: 0 }));
  assert_eq(rejected(["<!DOCTYPE html><p>a</p ><br />"]), None)
}

test "`literal` of text with no holes renders back as the same markup" {
  assert_eq(match literal("<br>") { Ok(h) -> render(h), Err(rejected) -> rejected.message }, "<br>")
}

test "`escape`, `escape_text` and `escape_attribute` each replace only the characters that are unsafe in their context" {
  let s = "a & <b> \"c\" 'd'";
  assert_eq(escape(s), "a &amp; &lt;b&gt; &quot;c&quot; &#39;d&#39;");
  assert_eq(escape_text(s), "a &amp; &lt;b&gt; \"c\" 'd'");
  assert_eq(escape_attribute(s), "a &amp; &lt;b&gt; &quot;c&quot; 'd'");
  assert_eq(escape("&amp;"), "&amp;amp;");
  assert_eq(escape(""), "")
}

type ReferenceCase = { text: String, content: String, value: String }

fn same_in_both(text: String, read: String) -> ReferenceCase =
  { text: text, content: read, value: read }

fn reference_cases() -> List<ReferenceCase> =
  [
    {
      text: "I'm &notit; I tell you",
      content: "I'm \u{ac}it; I tell you",
      value: "I'm &notit; I tell you",
    },
    same_in_both("I'm &notin; I tell you", "I'm \u{2209} I tell you"),
    same_in_both("&lt;p&gt; &amp; &quot;q&quot; &apos;", "<p> & \"q\" '"),
    same_in_both("&amp;lt;", "&lt;"),
    same_in_both("&amp", "&"),
    same_in_both("&amp &amp. &amp; &amp<", "& &. & &<"),
    { text: "&ampx", content: "&x", value: "&ampx" },
    { text: "&amp=1", content: "&=1", value: "&amp=1" },
    { text: "&copy2024", content: "\u{a9}2024", value: "&copy2024" },
    { text: "?a=1&not=2&lt=3", content: "?a=1\u{ac}=2<=3", value: "?a=1&not=2&lt=3" },
    same_in_both("&copy 2024", "\u{a9} 2024"),
    same_in_both("&AMP; &LT &GT; &QUOT", "& < > \""),
    same_in_both("&Amp; &unknown; &a; &;", "&Amp; &unknown; &a; &;"),
    same_in_both("&notin; &notindot; &notinE;", "\u{2209} \u{22f5}\u{338} \u{22f9}\u{338}"),
    same_in_both("&NotEqualTilde; &fjlig;", "\u{2242}\u{338} fj"),
    same_in_both("&CounterClockwiseContourIntegral;", "\u{2233}"),
    same_in_both("&CounterClockwiseContourIntegralx;", "&CounterClockwiseContourIntegralx;"),
    same_in_both("&#65;&#x42;&#X43;&#x6a;&#x6A;", "ABCjj"),
    same_in_both("&#65 &#x42 &#65", "A B A"),
    same_in_both("&#x41g &#65a", "Ag Aa"),
    same_in_both("&#; &#x; &#xg; &#a; &# &#x", "&#; &#x; &#xg; &#a; &# &#x"),
    same_in_both("&#0; &#x0; &#00", "\u{fffd} \u{fffd} \u{fffd}"),
    same_in_both("&#xD800; &#xDFFF; &#55296;", "\u{fffd} \u{fffd} \u{fffd}"),
    same_in_both(
      "&#x110000; &#1114112; &#99999999999999999999999999;",
      "\u{fffd} \u{fffd} \u{fffd}",
    ),
    same_in_both("&#x10FFFF; &#xFFFF; &#xFDD0;", "\u{10ffff} \u{ffff} \u{fdd0}"),
    same_in_both(
      "&#x80; &#x82; &#x8C; &#x9F; &#150;",
      "\u{20ac} \u{201a} \u{152} \u{178} \u{2013}",
    ),
    same_in_both("&#x81; &#x8D; &#x8F; &#x90; &#x9D;", "\u{81} \u{8d} \u{8f} \u{90} \u{9d}"),
    same_in_both("&#x7F; &#xA0; &#x1; &#xD;", "\u{7f} \u{a0} \u{1} \r"),
    same_in_both("& && &&amp; a&b", "& && && a&b"),
    same_in_both("caf\u{e9} &eacute; \u{1F600} &#x1F600;", "caf\u{e9} \u{e9} \u{1F600} \u{1F600}"),
    same_in_both("", ""),
  ]

test "`unescape` and `unescape_attribute` decode `{c.text}` as the HTML standard specifies" for c: ReferenceCase in reference_cases(
  ) {
  assert_eq(unescape(c.text), c.content);
  assert_eq(unescape_attribute(c.text), c.value)
}

fn code_points(entry: Json) -> String / {abort.raise} =
  match json::get(entry, "codepoints") {
    Some(json::Array(points)) ->
      String::of_bytes(
        Bytes::concat_all(
          points.map(|point: Json|
            match point {
              json::Number(n) -> match Int::of_decimal(n, Down) {
                Some(code) -> character(code),
                None -> panic("a code point past an `Int`"),
              },
              _ -> panic("a code point that is no number"),
            }),
        ),
      ),
    _ -> panic("an entry with no code points"),
  }

test "every name of the standard's table is read as the code points the table gives it" {
  let published = match json::parse(embed("html/entities.json")) {
    Ok(json::Object(entries)) -> entries,
    _ -> panic("the table is no JSON object"),
  };
  assert_eq(published.len(), 2231);
  assert_eq(names().named.len(), 2231);
  assert_eq(names().bare, 6);
  published.fold((), |u: Unit, name: String, entry: Json| {
    let points = code_points(entry);
    assert_eq(unescape(name), points);
    assert_eq(unescape(name ++ " "), points ++ " ");
    if name.ends_with(";") { assert_eq(unescape_attribute(name ++ "x=1"), points ++ "x=1") } else {
      assert(published.contains(name ++ ";"), Some(name));
      assert_eq(unescape_attribute(name ++ "=1"), name ++ "=1");
      assert_eq(unescape_attribute(name ++ "/"), points ++ "/")
    }
  })
}

test "the table's notice names who made it and the licences it is distributed under" {
  assert(license().contains("Copyright © WHATWG (Apple, Google, Mozilla, Microsoft)"));
  assert(license().contains("https://creativecommons.org/licenses/by/4.0/legalcode"));
  assert(license().contains("BSD 3-Clause License"));
  assert(license().contains("https://html.spec.whatwg.org/entities.json"))
}

test "`unescape` of an escaped string returns the original string" {
  gen::check(gen::text(), |x: String| inverse(escape, unescape, x))
}

test "an escape contains no character that opens a tag or closes a value" {
  gen::check(hostile(), |h: Hostile| {
    let content = escape_text(hostile_text(h));
    let value = escape_attribute(hostile_text(h));
    let anywhere = escape(hostile_text(h));
    !content.contains("<") && !value.contains("<") && !value.contains("\"")
      && !anywhere.contains("\"")
      && !anywhere.contains("'")
      && !anywhere.contains("<")
  })
}

test "`of_value` returns a fragment only for a value that `reflect` produced from a fragment" {
  let page = fragment([
    text("a < b"),
    trusted_url("/x"),
    match literal("<b>") { Ok(h) -> h, Err(_) -> text("") },
  ]);
  assert_eq(of_value(reflect(page)), Some(page));
  assert_eq(of_value(reflect(fragment([]))), Some(fragment([])));
  assert_eq(of_value(reflect("<b>")), None);
  assert_eq(of_value(reflect({ pieces: ["<b>"] })), None);
  assert_eq(of_value(reflect(#{"pieces": [Markup("<b>")]})), None);
  assert_eq(of_value(reflect({ pieces: [Markup("<b>")], more: 1 })), None)
}

test "`url_text` returns the text of a fragment with no markup, and the text is trusted only if every piece is a trusted URL" {
  assert_eq(url_text(text("/a")), Some({ text: "/a", trusted: false }));
  assert_eq(url_text(trusted_url("javascript:x")), Some({ text: "javascript:x", trusted: true }));
  assert_eq(
    url_text(fragment([trusted_url("/a"), text("b")])),
    Some({ text: "/ab", trusted: false }),
  );
  assert_eq(url_text(fragment([])), Some({ text: "", trusted: false }));
  assert_eq(url_text(match literal("<b>") { Ok(h) -> h, Err(_) -> text("") }), None)
}

fn url_hole(text: String) -> Result<Option<UrlPart>, String> / {abort.raise} =
  match run(reader(true), text) {
    Err(stray) -> Err(stray.message),
    Ok(r) -> match hole(r.to) { Err(message) -> Err(message), Ok(h) -> Ok(h.url) },
  }

type UrlHole = { markup: String, part: Option<UrlPart> }

fn url_holes() -> List<UrlHole> =
  [
    { markup: "<a href=\"", part: Some(Start) },
    { markup: "<a href='  ", part: Some(Start) },
    { markup: "<a href=", part: Some(Start) },
    { markup: "<a HREF = \"", part: Some(Start) },
    { markup: "<a href=\"page-", part: Some(First) },
    { markup: "<a href=\"x", part: Some(First) },
    { markup: "<a href=\"/users/", part: Some(Path) },
    { markup: "<a href=\"./", part: Some(Path) },
    { markup: "<a href=\"https://example.com/", part: Some(Path) },
    { markup: "<a href=\"HTTPS://", part: Some(Path) },
    { markup: "<a href=\"mailto:", part: Some(Path) },
    { markup: "<a href=\"tel:", part: Some(Path) },
    { markup: "<a href=\"x&amp;", part: Some(Path) },
    { markup: "<a href=\"/search?q=", part: Some(Query) },
    { markup: "<a href=\"?", part: Some(Query) },
    { markup: "<a href=\"#", part: Some(Query) },
    { markup: "<a href=\"/a?b=1&amp;c=", part: Some(Query) },
    { markup: "<a href=\"/a#top-", part: Some(Query) },
    { markup: "<img src=\"", part: Some(Start) },
    { markup: "<form action=\"", part: Some(Start) },
    { markup: "<button formaction=\"", part: Some(Start) },
    { markup: "<div data-href=\"", part: Some(Start) },
    { markup: "<use xlink:href=\"", part: Some(Start) },
    { markup: "<img srcset=\"/a.png 1x, ", part: Some(Start) },
    { markup: "<a ping=\"/a ", part: Some(Start) },
    { markup: "<meta http-equiv=\"refresh\" content=\"3;url='", part: Some(Start) },
    { markup: "<meta http-equiv=\"refresh\" content=\"3; ", part: Some(Start) },
    { markup: "<a title=\"", part: None },
    { markup: "<a class=\"a b ", part: None },
    { markup: "<a hreflang=\"", part: None },
    { markup: "<meta content=\"", part: None },
    { markup: "<p>", part: None },
    { markup: "<title>", part: None },
  ]

test "`url_hole` returns the part of a URL (such as path or query) where a value inserted after `{c.markup}` would land" for c: UrlHole in url_holes(
  ) { assert_eq(url_hole(c.markup), Ok(c.part)) }

fn no_url_hole() -> List<String> =
  [
    "<a href=\"javascript:",
    "<a href=\"JavaScript:go(",
    "<a href=\" java\tscript:",
    "<a href=\"data:text/html,",
    "<a href=\"vbscript:",
    "<a href=\"ftp://",
    "<a href=\"&#106;avascript:",
    "<a href=\"javascript&#58;?x=",
    "<img srcset=\"/a.png ",
    "<meta http-equiv=\"refresh\" content=\"",
  ]

test "no hole may appear in a URL after `{c}`" for c: String in no_url_hole() {
  assert(match url_hole(c) { Err(_) -> true, Ok(_) -> false })
}

test "a hole's value is never the scheme of the URL it is in" {
  let after = |markup: String, more: String|
    match run(reader(true), markup) {
      Err(stray) -> Err(stray.message),
      Ok(r) -> match hole(r.to) {
        Err(message) -> Err(message),
        Ok(h) -> match run(h.to, more) {
          Err(stray) -> Err(stray.offset.to_string()),
          Ok(next) -> match hole(next.to) {
            Err(message) -> Err(message),
            Ok(second) -> Ok(second.url),
          },
        },
      },
    };
  assert_eq(after("<a href=\"", ""), Ok(Some(First)));
  assert_eq(after("<a href=\"", "/"), Ok(Some(Path)));
  assert_eq(after("<a href=\"", "?next="), Ok(Some(Query)));
  assert_eq(after("<a href=\"", ".html#"), Ok(Some(Query)));
  assert_eq(after("<a href=\"", "://"), Err("0"));
  assert_eq(after("<a href=\"page", "s:"), Err("1"));
  assert_eq(after("<a href=", " src=\""), Ok(Some(Start)));
  assert_eq(after("<a title=\"", ":"), Ok(None))
}

type Encoded = { part: UrlPart, value: String, url: Result<String, String> }

fn url_values() -> List<Encoded> =
  [
    { part: Start, value: "/a b?c=d&e=\"f\"#g", url: Ok("/a%20b?c=d&e=%22f%22#g") },
    { part: Start, value: "https://example.com/?q=a%20b", url: Ok("https://example.com/?q=a%20b") },
    { part: Start, value: "HTTP://example.com", url: Ok("HTTP://example.com") },
    { part: Start, value: "mailto:a@example.com", url: Ok("mailto:a@example.com") },
    { part: Start, value: "tel:+15550100", url: Ok("tel:+15550100") },
    { part: Start, value: "page.html", url: Ok("page.html") },
    { part: Start, value: "a/b:c", url: Ok("a/b:c") },
    { part: Start, value: "?next=x:y", url: Ok("?next=x:y") },
    { part: Start, value: "", url: Ok("") },
    { part: Start, value: "100%", url: Ok("100%25") },
    { part: Start, value: "caf\u{e9}<\\>", url: Ok("caf%C3%A9%3C%5C%3E") },
    { part: Start, value: "javascript:alert(1)", url: Err("javascript") },
    { part: Start, value: "JaVaScRiPt:alert(1)", url: Err("JaVaScRiPt") },
    { part: Start, value: " javascript:alert(1)", url: Err("%20javascript") },
    { part: Start, value: "java\tscript:alert(1)", url: Err("java%09script") },
    { part: Start, value: "\u{1}javascript:alert(1)", url: Err("%01javascript") },
    { part: Start, value: "data:text/html,<script>", url: Err("data") },
    { part: Start, value: "vbscript:x", url: Err("vbscript") },
    { part: Start, value: ":x", url: Err("") },
    { part: First, value: "7", url: Ok("7") },
    { part: First, value: "s/x:y", url: Ok("s/x:y") },
    { part: First, value: "script:alert(1)", url: Err("script") },
    { part: First, value: "s://example.com", url: Err("s") },
    { part: First, value: ":80", url: Err("") },
    { part: Path, value: "a b/../c:d?e#f", url: Ok("a%20b/../c:d?e#f") },
    { part: Path, value: "\"><script>", url: Ok("%22%3E%3Cscript%3E") },
    { part: Query, value: "a b&c=d/e:f", url: Ok("a%20b%26c%3Dd%2Fe%3Af") },
    { part: Query, value: "javascript:alert(1)", url: Ok("javascript%3Aalert%281%29") },
  ]

test "`{c.value}` is written into a URL as its {c.part} part requires" for c: Encoded in url_values(
  ) { assert_eq(url_value(c.part, c.value, false), c.url) }

test "a trusted URL value is encoded but may use any scheme" {
  assert_eq(url_value(Start, "javascript:void(0)", true), Ok("javascript:void(0)"));
  assert_eq(url_value(Start, "sms:+15550100?body=a b", true), Ok("sms:+15550100?body=a%20b"));
  assert_eq(url_value(First, "x:y", true), Ok("x:y"));
  assert_eq(url_value(Query, "a:b", true), Ok("a%3Ab"))
}

test "`browser_scheme` ignores the whitespace and control characters a browser removes before reading a URL's scheme" {
  assert_eq(browser_scheme("https://example.com"), Some("https"));
  assert_eq(browser_scheme(" \u{1}JavaScript:alert(1)"), Some("javascript"));
  assert_eq(browser_scheme("java\tscr\nipt:alert(1)"), Some("javascript"));
  assert_eq(browser_scheme("x-app+v1.2:open"), Some("x-app+v1.2"));
  assert_eq(browser_scheme("/a:b"), None);
  assert_eq(browser_scheme("a b:c"), None);
  assert_eq(browser_scheme("%20javascript:x"), None);
  assert_eq(browser_scheme("1a:b"), None);
  assert_eq(browser_scheme(":b"), None);
  assert_eq(browser_scheme("page"), None);
  assert_eq(browser_scheme(""), None)
}

test "a value filled in where a URL starts never produces a scheme other than an allowed one" {
  gen::check(hostile(), |h: Hostile| {
    match url_value(Start, hostile_text(h), false) {
      Err(_) -> true,
      Ok(url) -> match browser_scheme(unescape_attribute(escape(url))) {
        None -> true,
        Some(scheme) -> is_allowed_scheme(Bytes::of_string(scheme)),
      },
    }
  })
}

fn markup_of_steps(
  steps: List<Result<String, Html>>,
  urls: Bool,
) -> Option<String> / {abort.raise} = {
  let end = steps.fold(Some(draft(urls)), |d: Option<Draft>, s: Result<String, Html>|
    match d {
      None -> None,
      Some(so_far) -> match s {
        Ok(markup) -> match run(so_far.at, markup) {
          Ok(r) -> append_markup(so_far, r),
          Err(_) -> None,
        },
        Err(value) -> match hole(so_far.at) { Ok(h) -> place(so_far, h, value), Err(_) -> None },
      },
    });
  match end {
    None -> None,
    Some(d) -> match finish(d) { Some(page) -> Some(render(page)), None -> None },
  }
}

test "`markup_of_steps` builds the template's fragment from literal pieces and holes added in reading order" {
  let value = text("a\"<b>&");
  assert_eq(
    markup_of_steps(
      [Ok("<p class="), Err(value), Ok(" id='x-"), Err(value), Ok("'>"), Err(value), Ok("</p>")],
      false,
    ),
    Some(written(["<p class=", " id='x-", "'>", "</p>"], [value, value, value])),
  );
  assert_eq(markup_of_steps([], false), Some(""));
  assert_eq(markup_of_steps([Ok("<p"), Ok(">x</p>")], true), Some("<p>x</p>"));
  assert_eq(markup_of_steps([Ok("<p")], false), None);
  assert_eq(markup_of_steps([Ok("<p title='"), Err(value)], false), None);
  assert_eq(markup_of_steps([Ok("<!-- ")], false), None)
}

test "a draft rejects markup and holes that were read starting from a different reader state than the draft's current one" {
  let start = reader(true);
  let tag = match run(start, "<p ") { Ok(r) -> r, Err(_) -> panic("refused") };
  let more = match run(tag.to, "class='a'>") { Ok(r) -> r, Err(_) -> panic("refused") };
  let content = match hole(start) { Ok(h) -> h, Err(_) -> panic("refused") };
  let d = draft(true);
  assert(append_markup(d, more) == None);
  assert(append_markup(d, tag) != None);
  let in_tag = match append_markup(d, tag) { Some(next) -> next, None -> d };
  assert(place(in_tag, content, text("x")) == None);
  assert(append_markup(in_tag, tag) == None);
  assert(append_markup(in_tag, more) != None);
  assert(append_markup(draft(false), tag) == None)
}

fn read_from(from: Context, markup: String) -> Run / {abort.raise} =
  match run(from, markup) { Ok(r) -> r, Err(stray) -> panic(stray.message) }

test "a draft rejects text that extends a tag name when it is appended after an attribute of that same tag" {
  let named_reference = read_from(reader(false), "<script");
  let longer = read_from(named_reference.to, "x>");
  let attribute = read_from(named_reference.to, " id='1'");
  assert(match hole(longer.to) { Ok(h) -> h.place == Content, Err(_) -> false });
  let written = |runs: List<Run>|
    runs.fold(Some(draft(false)), |d: Option<Draft>, r: Run|
      match d { Some(so_far) -> append_markup(so_far, r), None -> None });
  assert(written([named_reference, longer]) != None);
  assert(written([named_reference, attribute]) != None);
  assert(written([named_reference, attribute, longer]) == None);
  let either = match join(named_reference.to, attribute.to) {
    Some(c) -> c,
    None -> panic("apart"),
  };
  let closed = read_from(either, " class='a'>");
  assert(written([named_reference, closed]) != None);
  assert(written([named_reference, attribute, closed]) != None);
  assert(match run(either, "x>") { Err(_) -> true, Ok(_) -> false })
}

fn at(markup: String) -> Context / {abort.raise} =
  match run(reader(true), markup) { Ok(r) -> r.to, Err(stray) -> panic(stray.message) }

fn joined_hole(a: String, b: String, more: String) -> Option<Hole> / {abort.raise} =
  match join(at(a), at(b)) {
    None -> None,
    Some(both) -> match run(both, more) {
      Err(_) -> None,
      Ok(r) -> match hole(r.to) { Ok(h) -> Some(h), Err(_) -> None },
    },
  }

test "`join` combines two reader states only when any text that follows is read the same way from both, and returns nothing otherwise" {
  let same = |a: String, b: String| join(at(a), at(b)) != None;
  assert(same("<b>x</b>", "<i class='y'>z</i> w"));
  assert(same("", "<br>"));
  assert(!same("<p", "<p>"));
  assert(!same("<p title='", "<p title=\""));
  assert(!same("<p title='", "<p class='"));
  assert(!same("<textarea>", "<title>"));
  assert(same("<textarea>", "<textarea rows='2'>x"));
  assert(same("<p", "<p class='a'"));
  assert(same("<p", "<p hidden"));
  assert(same("<p class='a'", "<p class='a' "));
  assert(!same("<p", "<q"));
  assert(joined_hole("<p", "<p hidden", " title='") != None);
  assert(joined_hole("<p", "<p hidden", "x title='") == None);
  assert(joined_hole("<p ", "<p hidden ", "title='") != None);
  assert(joined_hole("<p ", "<p hidden ", "='") == None);
  assert(joined_hole("<p hidden", "<p hidden", "='") == None);
  assert(joined_hole("<p", "<p id='1'", " id='") == None);
  assert(same("<a href='/a", "<a href='/b/"));
  assert(joined_hole("<a href='/a", "<a href='/b/", "") != None);
  assert(same("<a href='/a", "<a href='?"));
  assert(joined_hole("<a href='/a", "<a href='?", "") == None);
  assert(joined_hole("<a href='/a", "<a href='?", "#") != None);
  assert(joined_hole("<a href='", "<a href='x", "/y?q=") != None);
  assert(joined_hole("<a href='", "<a href='x", "y:") == None);
  assert(joined_hole("<a href='javascript:", "<a href='/a", "?q=") == None);
  assert(joined_hole("<a href='javascript:", "<a href='data:", "?q=") == None);
  assert(joined_hole("<a href='https:", "<a href='http:", "//example.com/") != None);
  assert(joined_hole("<a href='", "<a href='/a", "'>") != None);
  assert(joined_hole("<a title='a", "<a title='b?", "") != None)
}

fn tokens_of(input: String, s: Start) -> List<Token> =
  match tokenize(cursor(Bytes::of_string(input), s, default_limits())) {
    Ok(all) -> all.map(|l: Lexeme| l.token),
    Err(_) -> [],
  }

fn codes_of(input: String) -> List<String> =
  match tokenize(cursor(Bytes::of_string(input), start(), default_limits())) {
    Ok(all) -> all.flat_map(|l: Lexeme| l.problems.map(|p: Problem| code(p.error))),
    Err(_) -> ["refused"],
  }

fn tag(name: String, attributes: List<Attribute>) -> Tag =
  { name: name, attributes: attributes, self_closing: false }

test "a document is read as the standard's tokenizer reads it" {
  assert_eq(
    tokens_of("<!DOCTYPE html><P Class=\"a&amp;b\" id=x>Hi &amp; <!-- c --><br/></p>", start()),
    [
      Doctype({ name: Some("html"), public_id: None, system_id: None, force_quirks: false }),
      StartTag(tag("p", [{ name: "class", value: "a&b" }, { name: "id", value: "x" }])),
      Text("Hi & "),
      Comment(" c "),
      StartTag({ name: "br", attributes: [], self_closing: true }),
      EndTag(tag("p", [])),
      EndOfFile,
    ],
  );
  assert_eq(tokens_of("a\r\nb\rc", start()), [Text("a\nb\nc"), EndOfFile]);
  assert_eq(tokens_of("<?php x ?>", start()), [Instruction("php", "x "), EndOfFile]);
  assert_eq(tokens_of("", start()), [EndOfFile]);
  assert_eq(
    match tokenize(cursor(b"caf\xe9", start(), default_limits())) {
      Ok(all) -> all.map(|l: Lexeme| l.token),
      Err(_) -> [],
    },
    [Text("caf\u{fffd}"), EndOfFile],
  )
}

test "the tokenizer starts in the state the caller passes, such as title text, script code or foreign content, and tokenizes accordingly" {
  let titled: Start = { state: Rcdata, last_start_tag: Some("title"), foreign: false };
  assert_eq(tokens_of("a<b>&amp;</title>c", titled), [
    Text("a<b>&"),
    EndTag(tag("title", [])),
    Text("c"),
    EndOfFile,
  ]);
  let is_code_attribute: Start = {
    state: ScriptData,
    last_start_tag: Some("script"),
    foreign: false,
  };
  assert_eq(tokens_of("if (a<b) x = '</scr' + 'ipt>';</script>", is_code_attribute), [
    Text("if (a<b) x = '</scr' + 'ipt>';"),
    EndTag(tag("script", [])),
    EndOfFile,
  ]);
  assert_eq(tokens_of("<![CDATA[a<b]]>c", { state: Data, last_start_tag: None, foreign: true }), [
    Text("a<bc"),
    EndOfFile,
  ]);
  assert_eq(tokens_of("<![CDATA[a]]>", start()), [Comment("[CDATA[a]]"), EndOfFile])
}

test "`tokenize` reads the contents of `title` and `script` elements as text without a tree builder" {
  let read = match tokenize(
      markup_cursor(b"<title>a<b></title><script>x<y</script><p>", default_limits()),
    ) {
    Ok(all) -> all.map(|l: Lexeme| l.token),
    Err(_) -> [],
  };
  assert_eq(read, [
    StartTag(tag("title", [])),
    Text("a<b>"),
    EndTag(tag("title", [])),
    StartTag(tag("script", [])),
    Text("x<y"),
    EndTag(tag("script", [])),
    StartTag(tag("p", [])),
    EndOfFile,
  ])
}

test "a parse error is returned with the token it was found in, under the standard's name" {
  assert_eq(codes_of("<p a=1 a=2>"), ["duplicate-attribute"]);
  assert_eq(codes_of("a\u{1}b"), ["control-character-in-input-stream"]);
  assert_eq(codes_of("\u{fdd0}"), ["noncharacter-in-input-stream"]);
  assert_eq(codes_of("<!-- x"), ["eof-in-comment"]);
  assert_eq(codes_of("&notit;"), ["missing-semicolon-after-character-reference"]);
  assert_eq(codes_of("<p>ok</p>"), [])
}

test "a reading fails past each of its limits, at its position" {
  let rejection = |input: String, limits: Limits|
    match tokenize(cursor(Bytes::of_string(input), start(), limits)) {
      Ok(_) -> None,
      Err(r) -> Some(r.reason),
    };
  let roomy: Limits = { tokens: 100, attributes: 10, name: 10, value: 10, output: 100 };
  assert_eq(rejection("<a b=1 c=2>x", roomy), None);
  assert_eq(rejection("<a><b><c>", { ..roomy, tokens: 2 }), Some(TooManyTokens));
  assert_eq(rejection("<a b c d>", { ..roomy, attributes: 2 }), Some(TooManyAttributes));
  assert_eq(rejection("<abcdefghijkl>", roomy), Some(NameTooLong));
  assert_eq(rejection("<a b='12345678901'>", roomy), Some(ValueTooLong));
  assert_eq(rejection("<!--12345678901-->", roomy), Some(ValueTooLong));
  assert_eq(rejection("0123456789", { ..roomy, output: 5 }), Some(OutputTooLong))
}

test "after `next` returns a token, a cursor continues reading in the state set by `with_state`" {
  let first = match next(cursor(b"<textarea>a<b></textarea>", start(), default_limits())) {
    Some(t) -> t,
    None -> panic("no token"),
  };
  assert_eq(first.lexeme.token, StartTag(tag("textarea", [])));
  assert_eq({ from: first.lexeme.from, to: first.lexeme.to }, { from: 0, to: 10 });
  let switched = with_state(first.rest, Rcdata);
  let rest = match tokenize(switched) { Ok(all) -> all.map(|l: Lexeme| l.token), Err(_) -> [] };
  assert_eq(rest, [Text("a<b>"), EndTag(tag("textarea", [])), EndOfFile]);
  assert_eq(seq::to_list(tokens(cursor(b"a<b>c", start(), default_limits())), 10).len(), 4)
}

fn read_whole(input: Bytes, all: List<Lexeme>) -> Bool =
  all.fold(
      { ok: true, at: 0, ended: false },
      |s: { ok: Bool, at: Int, ended: Bool }, l: Lexeme|
        {
          ok: s.ok && !s.ended && l.from >= s.at && l.to >= l.from && l.to <= input.len()
            && l.problems.fold(true, |inside: Bool, p: Problem|
              inside && p.offset >= 0 && p.offset <= input.len()),
          at: l.to,
          ended: l.token == EndOfFile,
        },
    ).ok
    && (match all.at(all.len() - 1) { Some(l) -> l.token == EndOfFile, None -> false })

test "tokenizing any bytes consumes the whole input, with tokens in order and within the input" {
  gen::check(gen::bytes(), |b: Bytes| {
    let input = decoded(b);
    match tokenize(cursor(b, start(), default_limits())) {
      Ok(all) -> read_whole(input, all),
      Err(_) -> false,
    }
  })
}
