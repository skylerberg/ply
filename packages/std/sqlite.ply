//! SQLite: an embedded SQL database, stored in a file under a root directory or as an image in
//! memory.
//!
//! The effect's label names the root directory of a database, bound the way `std.fs` binds its
//! labels: `--fs app=./data` grants the directory, and `sqlite.query[app]` reads a database under
//! it. A path that leaves its root is `E0452`, and an unbound label is `E0451`. No part of a
//! database's path, nor the journal beside it, may be a symbolic link. Only one connection can
//! write a database at a time, so two functions that both use `sqlite.execute[app]` (or another
//! writing operation) with the same label conflict, while two functions that only use
//! `sqlite.query[app]` do not. The engine is SQLite, compiled into `ply`, so it is the same on
//! every machine.
//!
//! A connection is opened under a `with_scope`, which closes it however its body ends:
//! `with_scope[db](sqlite::opening[app]("app.db", sqlite::Create, options), |c| sqlite::close(c)) {
//! conn -> .. }`. It is opened once with settings no statement can change: write-ahead logging,
//! foreign keys enforced, the wait `Options.busy_ms` on another connection's lock, defensive mode,
//! an untrusted schema, no extension loading, no attached database, no temporary or virtual table,
//! and, with `Options.strict`, no table that is not `STRICT` (declare tables `STRICT` either way:
//! without it a column accepts any value). The engine's authorizer enforces these rules inside the
//! engine, so views and triggers are bound by them too. It rejects `ATTACH`, `DETACH` and `VACUUM`,
//! any pragma other than `user_version`, `application_id`, `optimize` and those that describe or
//! check a schema, and any function not in `functions`.
//!
//! A statement is a `Bound`: text the parser has accepted, and its parameters. `bound(stmt(".."),
//! ps)` makes one from text a program built. The tag `sqlite"insert into t (a) values
//! ({IntParameter(n)})"` makes one whose text is parsed when the program is checked and whose holes
//! are its parameters, bound as `?1`, `?2`. Nothing in a hole ever becomes statement text. The
//! parameters are `std.sql`'s `Param`: null, an integer, a float, text and bytes are what SQLite
//! stores, and a `BoolParameter` is bound as 1 or 0. The caller must encode a `Decimal`, a date,
//! JSON or an array as text or an integer, so `NumericParameter`, `JsonParameter` and
//! `ArrayParameter` are rejected.
//!
//! `query` returns rows, each a `std.sql` `Row`, read a column at a time by `int`, `float`, `text`
//! and `bytes`, and through `optional` when a column may be null. `execute` returns the number of
//! rows a statement changed and the row id it last inserted. `returning` is a write that returns
//! rows. `run` returns either as `std.sql`'s `QueryResult`. Every one takes its `Limits`, and none
//! can be called without them.
//!
//! `transaction` runs its body between `BEGIN IMMEDIATE` and `COMMIT`, and rolls back if the body
//! raises or its task is cancelled. Inside another transaction it is a savepoint. `snapshot` does
//! the same for a transaction that only reads, which sees one state of the database throughout.
//! `fold_rows` reads a large result a page at a time. `backup` writes a compacted copy under the
//! same root.
//!
//! Errors are raised as `sql.fail` with an `Error`. `Busy` means another connection had the lock
//! past the wait, and it is the one error worth retrying (`is_retryable`). `Constraint` gives the
//! constraint's kind and the name the engine reports: `table.column` for a unique, not-null or
//! strict-type failure, the constraint's name for a check, and nothing for a foreign key. `try`
//! turns any call into a `Result`.
//!
//! A statement reads no clock and draws no random number. `CURRENT_TIMESTAMP`, `random()` and
//! `randomblob()` are rejected, and so is a date or time function given no time, the time `'now'`,
//! or the modifier `'localtime'` or `'utc'`, whether written in the statement or bound to it. The
//! functions `last_insert_rowid()`, `changes()` and `total_changes()` are rejected too, since
//! `execute` returns what they would. So is a row id of 9223372036854775807, past which the engine
//! picks row ids at random. So a statement's result depends only on the database and the values
//! bound.
//!
//! The in-memory handler `in_memory[app](|| ..)` runs the same engine on an image of the database
//! in memory. It handles every operation with `sqlite_run`, a native function that performs no
//! effects. So a test that uses it is deterministic and cached, a law can check it against many
//! generated inputs, and neither needs a root. The handler stores a database for each path, gives
//! each transaction its own copy, and returns `Busy` at once to a second writer. It differs from a
//! file in three ways: a deferred foreign key is checked at its statement, not at the commit;
//! `backup` copies the image without compacting it; and each statement costs a copy of the
//! database. So a test that fills a large database belongs on a file under a root that `--fs`
//! grants.
//!
//! A schema's version is `pragma user_version`: a migration is a `transaction` that reads it, runs
//! the statements after it and sets it.

import std.sql (Statement, statement_of, Param, NullParameter, IntParameter, BoolParameter,
                TextParameter, BytesParameter, FloatParameter, NumericParameter, JsonParameter,
                ArrayParameter, Datum, NullDatum, IntDatum, FloatDatum, TextDatum, BytesDatum, Row,
                QueryResult, Rows, Count, Failed, Sqlite, scan_statement, rejection_byte)
import std.bytes (i64_be)
import std.fs
import std.internal.native (native, wait, job_wait, observed, found, parts, encode_parts,
                            decode_int)
import std.laws (agrees)
import std.list
import std.math (rem_euclid)
import std.option
import std.gen

extern fn sqlite_run(
  image: Bytes,
  connection: String,
  params: Bytes,
  reads_only: Bool,
  strict: Bool,
  limits: Bytes,
) -> Bytes

extern fn sqlite_functions() -> Bytes

/// How a database file is opened: to be read, to be read and written, or created if it does not
/// exist.
pub type Mode = | ReadOnly | ReadWrite | Create

/// What a connection is opened with: whether every table it makes must be `STRICT`, the
/// milliseconds a statement waits on another connection's lock before it is `Busy`, and how many
/// prepared statements the connection caches for reuse by a later statement with the same text.
pub type Options = { strict: Bool, busy_ms: Int, statements: Int }

/// Sets what one statement may take and return: the bytes of its text, its parameters, the rows it
/// returns, the bytes of the values in them (a text's or a blob's length, eight for a number), and
/// the steps of the engine's virtual machine it may run, in thousands. The step limit bounds the
/// work without a clock, so the same statement on the same database always gives the same result:
/// always rejected, or always accepted.
pub type Limits = { sql_bytes: Int, params: Int, rows: Int, bytes: Int, steps: Int }

/// One value as the engine binds and returns it: `kind` is 0 for null, 1 for an integer in `int`,
/// 2 for a float in `real`, 3 for text and 4 for bytes, both in `bytes`.
pub type Scalar = { kind: Int, int: Int, real: Float, bytes: Bytes }

/// Describes why the engine did not do what was requested. `kind` is a short word naming the
/// category of failure, which `rejection_of` maps to an `Error`. `name` is the constraint, limit or
/// engine code involved, and `detail` is the engine's own message.
pub type Failure = { kind: String, name: String, detail: String }

/// The engine's result for one operation: the columns and rows of a statement that returns them,
/// whether the statement could have changed the database, the number of rows it changed itself,
/// the row id it last inserted or 0, and why it did not run.
pub type Reply = {
  columns: List<String>,
  rows: List<List<Scalar>>,
  wrote: Bool,
  changed: Int,
  last_row_id: Int,
  failure: Option<Failure>,
}

/// One step of a connection's transaction. `Begin` takes the write lock at once and `BeginRead`
/// reads one snapshot; either is a savepoint inside a transaction, where `Commit` and `Rollback`
/// close the innermost.
pub type TransactionStep = | Begin | BeginRead | Commit | Rollback

/// A database under the root directory bound to the effect's label. Every operation on a connection
/// goes to the engine one at a time, in the order it was performed.
pub nondet effect sqlite {
  /// Opens the database at `path`, returning the connection's number.
  write open[d](path: String, mode: Mode, options: Options) -> Result<Int, Failure>
  /// Closes a connection, rolling back what it left open; `false` for a number that names none.
  write close[d](conn: Int) -> Bool
  /// Runs a statement that only reads.
  read query[d](conn: Int, sql: String, params: List<Scalar>, limits: Limits) -> Reply
  /// Runs a statement that may write. When the engine rejects the statement after running it,
  /// because of the rows it returned or the state it left the database in, the statement's changes
  /// are rolled back.
  write execute[d](conn: Int, sql: String, params: List<Scalar>, limits: Limits) -> Reply
  /// Opens or closes a transaction or a savepoint.
  write control[d](conn: Int, step: TransactionStep) -> Reply
  /// Writes a compacted copy of the database to `path`, where no file exists yet.
  write backup[d](conn: Int, path: String) -> Reply
  /// Opens a read-only statement to be fetched a page at a time, returning its columns.
  /// Nothing else runs on the connection until `finish`.
  write cursor[d](conn: Int, sql: String, params: List<Scalar>, limits: Limits) -> Reply
  /// The next `rows` rows of the open statement; fewer means the end. `limits.rows` limits all its
  /// pages together, and `limits.bytes` each page.
  write fetch[d](conn: Int, rows: Int) -> Reply
  /// Ends the open statement; `false` when none is open.
  write finish[d](conn: Int) -> Bool
}

/// What this module raises. It is a separate effect from `sqlite`, so a handler that handles every
/// `sqlite` operation, such as the in-memory handler, is deterministic even though a database
/// operation can still fail.
pub effect sql {
  /// A database did not do what was requested.
  raise fail(connection: Error)
}

/// The constraint a write broke: a unique index or a primary key, a foreign key, `NOT NULL`, a
/// `CHECK`, a `STRICT` column's type, or another the engine enforces (a trigger's `RAISE`).
pub type Violation = | Unique | ForeignKey | NotNull | Check | Datatype | Other

/// Why a database did not do what was requested.
///
/// `Busy`: another connection had the lock past the wait the connection was opened with.
/// `Constraint`: a write broke a constraint, with the name the engine reports. `Unopened`: the
/// database did not open. `Rejected`: the statement is one this module does not run, as the parser
/// or the engine's authorizer reported before it ran. `Malformed`: the engine could not parse the
/// statement, or it names something the database does not contain. `LimitExceeded`: a limit the
/// caller set was exceeded, given by its field's name, or `value` for a single text or blob larger
/// than the engine accepts. `Mistyped`: a column does not contain the type a reader requested.
/// `Closed`: the connection is closed, or the transaction the statement was running in was rolled
/// back before the statement finished. `Engine`: anything else, with the engine's code.
pub type Error =
  | Busy
  | Constraint(Violation, String)
  | Unopened(String)
  | Rejected(String)
  | Malformed(String)
  | LimitExceeded(String)
  | Mistyped(String, String)
  | Closed(String)
  | Engine(String, String)

/// Whether running the same operation again may succeed. Only `Busy` may.
pub fn is_retryable(reason: Error) -> Bool = match reason { Busy -> true, _ -> false }

/// Converts a `Failure` to an `Error` by its `kind`: `busy` becomes `Busy`, the constraint kinds
/// become `Constraint` with the matching `Violation` and the failure's `name`, and a kind this
/// module does not recognize becomes `Engine`.
pub fn rejection_of(f: Failure) -> Error =
  if f.kind == "busy" { Busy }
  else if f.kind == "unique" { Constraint(Unique, f.name) }
  else if f.kind == "foreign_key" { Constraint(ForeignKey, f.name) }
  else if f.kind == "not_null" { Constraint(NotNull, f.name) }
  else { rejection_of_rest(f) }

fn rejection_of_rest(f: Failure) -> Error =
  if f.kind == "check" { Constraint(Check, f.name) }
  else if f.kind == "datatype" { Constraint(Datatype, f.name) }
  else if f.kind == "constraint" { Constraint(Other, f.name) }
  else if f.kind == "unopened" { Unopened(f.detail) }
  else { rejection_of_last(f) }

fn rejection_of_last(f: Failure) -> Error =
  if f.kind == "refused" || f.kind == "writes" || f.kind == "read_only" || f.kind == "exists" {
    Rejected(f.detail)
  } else if f.kind == "statement" { Malformed(f.detail) }
  else if f.kind == "too_large" { LimitExceeded(f.name) }
  else if f.kind == "steps" { LimitExceeded("steps") }
  else if f.kind == "closed" || f.kind == "aborted" { Closed(f.detail) }
  else { Engine(if f.name == "" { f.kind } else { f.name }, f.detail) }

/// The SQL functions a statement may call, in order.
pub const functions: List<String> =
  parts(sqlite_functions()).map(|name: Bytes| String::of_bytes_lossy(name))

/// A statement the parser has accepted, with the values bound to its `?1`, `?2`.
pub opaque type Bound = | Bound(String, List<Scalar>)

/// Returns `bare_statement` with the parameters `ps` bound to its placeholders, in order. Raises
/// `Rejected` for a statement the parser rejects and for a parameter type SQLite does not store.
pub fn bound(bare_statement: Statement, ps: List<Param>) -> Bound / {sql.fail, abort.raise} =
  match scan_statement(Sqlite, bare_statement.sql) {
    Err(e) -> sql.fail(Rejected(e.detail)),
    Ok(_) -> Bound(bare_statement.sql, scalars(ps)),
  }

/// The statement in a `Bound`.
pub fn statement(b: Bound) -> Statement = match b { Bound(sql, _) -> statement_of(sql) }

/// Checks a tagged literal with no holes, such as `sqlite"select count(*) from t"`, when the
/// program is checked.
pub fn literal(text: String) -> Result<Bound, { message: String, offset: Int }> / {abort.raise} =
  match compile([text]) {
    Ok(bare_statement) -> Ok(Bound(bare_statement.sql, [])),
    Err(e) -> Err({ message: e.message, offset: e.offset }),
  }

/// The statement made from a tagged literal's texts, with each hole between two of them written
/// `?1`, `?2`. It is parsed when the program is checked, and rejected there if the parser rejects
/// it.
pub fn compile(
  texts: List<String>,
) -> Result<Statement, { message: String, offset: Int, part: Int }> / {abort.raise} = {
  let sql = range(0, texts.len()).fold("", |accumulator: String, i: Int|
    match texts.at(i) {
      Some(text) -> if i == 0 { text } else { accumulator ++ "?" ++ i.to_string() ++ text },
      None -> accumulator,
    });
  match scan_statement(Sqlite, sql) {
    Ok(_) -> Ok(statement_of(sql)),
    Err(e) -> Err(error_in_part(texts, rejection_byte(e).unwrap_or(0), e.detail)),
  }
}

/// A tagged literal's statement with its holes bound, each a `Param`.
pub fn fill(c: Statement, holes: List<Param>) -> Bound / {sql.fail} = Bound(c.sql, scalars(holes))

type PartSearch = { begins: Int, part: Int, offset: Int, found: Bool }

fn error_in_part(
  texts: List<String>,
  at: Int,
  message: String,
) -> { message: String, offset: Int, part: Int } / {abort.raise} = {
  let last = range(0, texts.len()).fold(
    { begins: 0, part: 0, offset: 0, found: false },
    |bare_statement: PartSearch, i: Int| {
      let text = Bytes::of_string(texts.at(i).unwrap_or(""));
      let begins = bare_statement.begins + (if i == 0 { 0 } else { 1 + i.to_string().len() });
      let ends = begins + text.len();
      if bare_statement.found { bare_statement } else if at > ends {
        { begins: ends, part: i, offset: character_count(text, text.len()), found: false }
      } else { { begins: ends, part: i, offset: character_count(text, at - begins), found: true } }
    },
  );
  { message: message, offset: last.offset, part: last.part }
}

fn character_count(text: Bytes, n: Int) -> Int / {abort.raise} =
  if n <= 0 { 0 } else { String::of_bytes(text.slice(0, min(n, text.len()))).chars().len() }

fn scalars(ps: List<Param>) -> List<Scalar> / {sql.fail} =
  range(0, ps.len()).map(|i: Int|
    match ps.at(i) { Some(p) -> scalar_of(p, i + 1), None -> null_scalar })

const null_scalar: Scalar = { kind: 0, int: 0, real: 0.0, bytes: b"" }

fn scalar_of(p: Param, place: Int) -> Scalar / {sql.fail} =
  match p {
    NullParameter -> null_scalar,
    IntParameter(n) -> { kind: 1, int: n, real: 0.0, bytes: b"" },
    BoolParameter(b) -> { kind: 1, int: if b { 1 } else { 0 }, real: 0.0, bytes: b"" },
    FloatParameter(x) -> { kind: 2, int: 0, real: x, bytes: b"" },
    TextParameter(bare_statement) ->
      { kind: 3, int: 0, real: 0.0, bytes: Bytes::of_string(bare_statement) },
    BytesParameter(b) -> { kind: 4, int: 0, real: 0.0, bytes: b },
    NumericParameter(_) -> unbindable(place, "PNumeric", "a `Decimal`"),
    JsonParameter(_) -> unbindable(place, "PJson", "JSON"),
    ArrayParameter(_) -> unbindable(place, "PArray", "an array"),
  }

fn unbindable<a>(place: Int, name: String, what: String) -> a / {sql.fail} =
  sql.fail(
    Rejected(
      "parameter " ++ place.to_string() ++ " is a `" ++ name
        ++ "`, and SQLite stores null, integers, floats, text and bytes: encode "
        ++ what
        ++ " as a `PText` or a `PInt`",
    ),
  )

fn datum_of(bare_statement: Scalar) -> Datum / {abort.raise} =
  if bare_statement.kind == 1 { IntDatum(bare_statement.int) }
  else if bare_statement.kind == 2 { FloatDatum(bare_statement.real) }
  else if bare_statement.kind == 3 { TextDatum(String::of_bytes(bare_statement.bytes)) }
  else if bare_statement.kind == 4 { BytesDatum(bare_statement.bytes) }
  else { NullDatum }

fn rows_of(columns: List<String>, rows: List<List<Scalar>>) -> List<Row> / {sql.fail, abort.raise} = {
  let names = columns.fold(Map::new(), |seen: Map<String, Unit>, c: String| seen.insert(c, ()));
  if names.len() != columns.len() {
    sql.fail(
      Rejected(
        "the statement returns two columns of one name, and a row is read by name: name each with `as`",
      ),
    )
  } else {
    rows.map(|row: List<Scalar>|
      range(0, columns.len()).fold(Map::new(), |accumulator: Row, i: Int|
        match ((columns.at(i), row.at(i))) {
          (Some(name), Some(value)) -> accumulator.insert(name, datum_of(value)),
          _ -> accumulator,
        }))
  }
}

fn raise_on_failure(r: Reply) -> Reply / {sql.fail} =
  match r.failure { None -> r, Some(f) -> sql.fail(rejection_of(f)) }

/// An open database under the root `d`. It is useless once its `with_scope` has closed it: any
/// operation on it then raises `Closed`.
pub opaque type Connection<[d]> = | Connection(Int)

/// Opens the database at `path` under the root `d` with `mode` and `options`. A `with_scope`
/// acquires a connection with this. Raises `Unopened` when the database does not open.
pub fn opening<[d]>(
  path: String,
  mode: Mode,
  options: Options,
) -> Connection<[d]> / {sqlite.open[d], sql.fail} =
  match sqlite.open[d](path, mode, options) {
    Ok(connection) -> Connection(connection),
    Err(f) -> sql.fail(rejection_of(f)),
  }

/// Closes a connection, rolling back any transaction it left open. A `with_scope` over a connection
/// releases it with this, written `|c| sqlite::close(c)`.
pub fn close<[d]>(c: Connection<[d]>) -> Unit / {sqlite.close[d]} =
  match c {
    Connection(connection) -> {
      sqlite.close[d](connection);
      ()
    },
  }

fn connection_number<[d]>(c: Connection<[d]>) -> Int = match c { Connection(conn) -> conn }

/// The rows a read-only statement returns. Raises `Rejected` for a statement that could write.
pub fn query<[d], [r]>(
  connection: Scoped<Connection<[d]>, [r]>,
  q: Bound,
  limits: Limits,
) -> List<Row> / {scoped.read[r], sqlite.query[d], sql.fail, abort.raise} =
  match q {
    Bound(sql, params) -> {
      let reply = raise_on_failure(
        sqlite.query[d](connection_number(connection.get()), sql, params, limits),
      );
      rows_of(reply.columns, reply.rows)
    },
  }

/// What a write did: the number of rows the statement itself changed, not counting a trigger's,
/// and the row id of the last row it inserted, or 0 when it inserted none.
pub type ExecuteResult = { rows: Int, last_row_id: Int }

/// Runs a statement that writes, including a schema statement.
pub fn execute<[d], [r]>(
  connection: Scoped<Connection<[d]>, [r]>,
  q: Bound,
  limits: Limits,
) -> ExecuteResult / {scoped.read[r], sqlite.execute[d], sql.fail} =
  match q {
    Bound(sql, params) -> {
      let reply = raise_on_failure(
        sqlite.execute[d](connection_number(connection.get()), sql, params, limits),
      );
      { rows: reply.changed, last_row_id: reply.last_row_id }
    },
  }

/// Runs a statement that writes and returns rows, as one with `returning` does.
pub fn returning<[d], [r]>(
  connection: Scoped<Connection<[d]>, [r]>,
  q: Bound,
  limits: Limits,
) -> List<Row> / {scoped.read[r], sqlite.execute[d], sql.fail, abort.raise} =
  match q {
    Bound(sql, params) -> {
      let reply = raise_on_failure(
        sqlite.execute[d](connection_number(connection.get()), sql, params, limits),
      );
      rows_of(reply.columns, reply.rows)
    },
  }

/// Runs a statement that writes and returns its result as a `std.sql` `QueryResult`: `Rows` when
/// the statement returns columns, otherwise `Count` of the rows it changed. A failure is returned
/// as `Failed` instead of being raised: its `code` is the `Failure`'s `kind` and its `constraint`
/// is the `Failure`'s `name`.
pub fn run<[d], [r]>(
  connection: Scoped<Connection<[d]>, [r]>,
  q: Bound,
  limits: Limits,
) -> QueryResult / {scoped.read[r], sqlite.execute[d], abort.raise} =
  match q {
    Bound(sql, params) -> {
      let reply = sqlite.execute[d](connection_number(connection.get()), sql, params, limits);
      match reply.failure {
        Some(f) -> Failed({ code: f.kind, constraint: f.name, detail: f.detail }),
        None -> if reply.columns.len() == 0 { Count(reply.changed) } else {
          match try { rows_of(reply.columns, reply.rows) } {
            Ok(rows) -> Rows(rows),
            Err(_) ->
              Failed({
                code: "refused",
                constraint: "",
                detail: "the statement returns two columns of one name",
              }),
          }
        },
      }
    },
  }

/// Runs `body` inside a transaction that holds the write lock from the start, so nothing in it
/// waits on a lock again. The transaction commits when the body returns. It rolls back when the
/// body raises, when a handler clause unwinds through it, or when its task is cancelled. Inside
/// another transaction it is a savepoint, which rolls back on its own. Raises `Busy` when another
/// connection holds the lock past the wait. On a connection opened to read, it takes no lock and
/// is a `snapshot`.
pub fn transaction<a, [d], [r] | e>(
  connection: Scoped<Connection<[d]>, [r]>,
  body: () -> a / e,
) -> a / {scoped.read[r], sqlite.control[d], sql.fail | e} =
  in_transaction[d](connection_number(connection.get()), Begin, body)

/// Runs `body` inside a transaction that only reads: every query in it sees the database as it was
/// at the first query. A write in it raises `Busy` if another connection has written since.
pub fn snapshot<a, [d], [r] | e>(
  connection: Scoped<Connection<[d]>, [r]>,
  body: () -> a / e,
) -> a / {scoped.read[r], sqlite.control[d], sql.fail | e} =
  in_transaction[d](connection_number(connection.get()), BeginRead, body)

fn in_transaction<a, [d] | e>(
  connection: Int,
  opens: TransactionStep,
  body: () -> a / e,
) -> a / {sqlite.control[d], sql.fail | e} = {
  raise_on_failure(sqlite.control[d](connection, opens));
  handle {
    bracket(
      || (),
      |_u: Unit|
        if !body_finished.ended() {
          sqlite.control[d](connection, Rollback);
          ()
        },
      |_u: Unit| {
        let value = body();
        body_finished.end();
        raise_on_failure(sqlite.control[d](connection, Commit));
        value
      },
    )
  } with {
    var ended = false,
    body_finished.end() -> {
      ended = true;
    },
    body_finished.ended() -> ended,
  }
}

effect body_finished {
  write end() -> Unit
  read ended() -> Bool
}

/// Folds `f` over each row a read-only statement returns, fetching `page` rows at a time, so only
/// one page of a large result is in memory at once. `limits.rows` is the most rows it folds over;
/// past that it raises `LimitExceeded`. `limits.bytes` limits the size of each page. The connection
/// cannot run other statements during the fold, so `f` must not use it. `f` can read from another
/// connection, or collect rows to write after the fold ends.
pub fn fold_rows<a, [d], [r] | e>(
  connection: Scoped<Connection<[d]>, [r]>,
  q: Bound,
  limits: Limits,
  page: Int,
  init: a,
  f: (a, Row) -> a / e,
) -> a / {scoped.read[r], sqlite.cursor[d], sqlite.fetch[d], sqlite.finish[d], sql.fail, abort.raise | e} =
  match q {
    Bound(sql, params) -> {
      let id = connection_number(connection.get());
      if page < 1 { panic("the page size must be at least 1 row") } else {
        bracket(
          || raise_on_failure(sqlite.cursor[d](id, sql, params, limits)).columns,
          |_c: List<String>| {
            sqlite.finish[d](id);
            ()
          },
          |columns: List<String>|
            iterate(init, max(limits.rows, 0) / page + 2, |accumulator: a| {
              let got = raise_on_failure(sqlite.fetch[d](id, page));
              let next = rows_of(columns, got.rows).fold(accumulator, f);
              if got.rows.len() < page { Stop(next) } else { Continue(next) }
            }),
        )
      }
    },
  }

/// Writes a compacted copy of the database to `path` under the same root, using `VACUUM INTO`. No
/// file may exist at `path` yet. The copy is a separate database and is consistent even if other
/// connections write meanwhile. Raises `Malformed` inside a transaction, because the engine cannot
/// copy then.
pub fn backup<[d], [r]>(
  connection: Scoped<Connection<[d]>, [r]>,
  path: String,
) -> Unit / {scoped.read[r], sqlite.backup[d], sql.fail} = {
  raise_on_failure(sqlite.backup[d](connection_number(connection.get()), path));
  ()
}

fn column_value(row: Row, column: String) -> Datum / {sql.fail} =
  match row.get(column) {
    Some(value) -> value,
    None -> sql.fail(Mistyped(column, "a column of the result")),
  }

/// The integer in `column`. Raises `Mistyped` for anything else, including null and a missing
/// column.
pub fn int(row: Row, column: String) -> Int / {sql.fail} =
  match column_value(row, column) {
    IntDatum(n) -> n,
    _ -> sql.fail(Mistyped(column, "an integer")),
  }

/// Returns the float in `column`. An integer is not a float and raises `Mistyped`. A `STRICT`
/// table's `REAL` column returns floats, and a query can use `CAST(... AS REAL)` to convert an
/// expression to one.
pub fn float(row: Row, column: String) -> Float / {sql.fail} =
  match column_value(row, column) { FloatDatum(x) -> x, _ -> sql.fail(Mistyped(column, "a float")) }

/// The text in `column`.
pub fn text(row: Row, column: String) -> String / {sql.fail} =
  match column_value(row, column) {
    TextDatum(bare_statement) -> bare_statement,
    _ -> sql.fail(Mistyped(column, "text")),
  }

/// The bytes in `column`.
pub fn bytes(row: Row, column: String) -> Bytes / {sql.fail} =
  match column_value(row, column) { BytesDatum(b) -> b, _ -> sql.fail(Mistyped(column, "bytes")) }

/// `None` when `column` is null, and otherwise what `read` returns for it, as in
/// `optional(row, "note", sqlite::text)`.
pub fn optional<a | e>(
  row: Row,
  column: String,
  read: (Row, String) -> a / e,
) -> Option<a> / {sql.fail | e} =
  match column_value(row, column) { NullDatum -> None, _ -> Some(read(row, column)) }

host for sqlite by host_handler

fn host_handler<a | e>(
  go: () -> a / {sqlite.read[*], sqlite.write[*] | e},
) -> a / {native.read, wait.read, abort.raise | e} =
  handle {
    go()
  } with {
    sqlite.open[*label](path, mode, options) -> {
      let takes_write_lock = sqlite_open(
        label,
        path,
        mode_number(mode),
        options.strict,
        options.busy_ms,
        options.statements,
      );
      let opened = decode_open_reply(job_wait(takes_write_lock));
      match opened { Ok(_) -> record_opened_files(label, path, mode), Err(_) -> () };
      opened
    },
    sqlite.close[*label](connection) -> job_wait(sqlite_close(label, connection)) == b"\x01",
    sqlite.query[*label](connection, sql, params, limits) ->
      decode_reply(
        job_wait(
          sqlite_query(label, connection, sql, encode_scalars(params), encode_limits(limits)),
        ),
      ),
    sqlite.execute[*label](connection, sql, params, limits) ->
      decode_reply(
        job_wait(
          sqlite_execute(label, connection, sql, encode_scalars(params), encode_limits(limits)),
        ),
      ),
    sqlite.control[*label](connection, step) ->
      decode_reply(job_wait(sqlite_control(label, connection, step_number(step)))),
    sqlite.backup[*label](connection, path) -> {
      let reply = decode_reply(job_wait(sqlite_backup(label, connection, path)));
      match reply.failure { None -> observed(label, path, 4), Some(_) -> () };
      reply
    },
    sqlite.cursor[*label](connection, sql, params, limits) ->
      decode_reply(
        job_wait(
          sqlite_cursor(label, connection, sql, encode_scalars(params), encode_limits(limits)),
        ),
      ),
    sqlite.fetch[*label](connection, rows) ->
      decode_reply(job_wait(sqlite_fetch(label, connection, rows))),
    sqlite.finish[*label](connection) -> job_wait(sqlite_finish(label, connection)) == b"\x01",
  }

extern fn sqlite_open(
  label: String,
  connection: String,
  mode: Int,
  strict: Bool,
  busy_ms: Int,
  statements: Int,
) -> Int / {native.read}

extern fn sqlite_close(label: String, connection: Int) -> Int / {native.read}

extern fn sqlite_query(
  label: String,
  connection: Int,
  sql: String,
  params: Bytes,
  limits: Bytes,
) -> Int / {native.read}

extern fn sqlite_execute(
  label: String,
  connection: Int,
  sql: String,
  params: Bytes,
  limits: Bytes,
) -> Int / {native.read}

extern fn sqlite_cursor(
  label: String,
  connection: Int,
  sql: String,
  params: Bytes,
  limits: Bytes,
) -> Int / {native.read}

extern fn sqlite_control(label: String, connection: Int, step: Int) -> Int / {native.read}

extern fn sqlite_backup(label: String, connection: Int, path: String) -> Int / {native.read}

extern fn sqlite_fetch(label: String, connection: Int, rows: Int) -> Int / {native.read}

extern fn sqlite_finish(label: String, connection: Int) -> Int / {native.read}

fn mode_number(mode: Mode) -> Int = match mode { ReadOnly -> 0, ReadWrite -> 1, Create -> 2 }

fn record_opened_files(label: String, path: String, mode: Mode) -> Unit / {native.read} =
  match mode {
    ReadOnly -> {
      observed(label, path, 0);
      observed(label, path ++ "-wal", 0)
    },
    _ ->
      ["", "-journal", "-wal", "-shm"].fold((), |u: Unit, suffix: String|
        observed(label, path ++ suffix, 4)),
  }

fn step_number(step: TransactionStep) -> Int =
  match step { Begin -> 0, BeginRead -> 1, Commit -> 2, Rollback -> 3 }

fn encode_scalar(bare_statement: Scalar) -> Bytes =
  match bare_statement.kind {
    1 -> b"\x01".concat(i64_be(bare_statement.int)),
    2 -> b"\x02".concat(i64_be(bits_of_float(bare_statement.real))),
    3 -> b"\x03".concat(bare_statement.bytes),
    4 -> b"\x04".concat(bare_statement.bytes),
    _ -> b"\x00",
  }

fn encode_scalars(params: List<Scalar>) -> Bytes = encode_parts(params.map(encode_scalar))

fn encode_limits(l: Limits) -> Bytes =
  Bytes::concat_all([l.sql_bytes, l.params, l.rows, l.bytes, l.steps].map(i64_be))

fn decode_scalar(flat: Bytes) -> Scalar / {abort.raise} = {
  let rest = flat.slice(1, flat.len());
  match flat.at(0) {
    1 -> { kind: 1, int: decode_int(rest), real: 0.0, bytes: b"" },
    2 -> { kind: 2, int: 0, real: Float::of_bits(decode_int(rest)), bytes: b"" },
    3 -> { kind: 3, int: 0, real: 0.0, bytes: rest },
    4 -> { kind: 4, int: 0, real: 0.0, bytes: rest },
    _ -> null_scalar,
  }
}

fn decode_failure(flat: Bytes) -> Failure / {abort.raise} =
  match parts(flat) {
    [kind, name, detail] ->
      {
        kind: String::of_bytes_lossy(kind),
        name: String::of_bytes_lossy(name),
        detail: String::of_bytes_lossy(detail),
      },
    _ ->
      panic(
        "the SQLite library returned a failure that does not have the expected kind, name and detail",
      ),
  }

fn decode_open_reply(encoded: Bytes) -> Result<Int, Failure> / {abort.raise} = {
  let rest = encoded.slice(1, encoded.len());
  if encoded.at(0) == 1 { Ok(decode_int(rest)) } else { Err(decode_failure(rest)) }
}

fn decode_reply(encoded: Bytes) -> Reply / {abort.raise} =
  match parts(encoded) {
    [columns, rows, wrote, changed, last_row_id, failure] ->
      {
        columns: parts(columns).map(|c: Bytes| String::of_bytes_lossy(c)),
        rows: parts(rows).map(|row: Bytes| parts(row).map(decode_scalar)),
        wrote: wrote == b"\x01",
        changed: decode_int(changed),
        last_row_id: decode_int(last_row_id),
        failure: match found(failure) { Some(f) -> Some(decode_failure(f)), None -> None },
      },
    _ -> panic("the SQLite library returned a reply in an unreadable format"),
  }

type OpenCursor = { rows: List<List<Scalar>>, at: Int, bytes: Int }

type FakeConnection = {
  path: String,
  mode: Mode,
  strict: Bool,
  saved: List<Bytes>,
  working: Bytes,
  base: Bytes,
  writes: Bool,
  cursor: Option<OpenCursor>,
}

type Fake = {
  files: Map<String, Bytes>,
  open: Map<Int, FakeConnection>,
  writer: Map<String, Int>,
  next: Int,
}

type FakeStep = { fake: Fake, reply: Reply }

/// The databases of one root, in memory: each path's bytes as a file would contain them, and the
/// connections open on them.
pub opaque type Memory = | Memory(Fake)

/// A root with no databases.
pub const memory: Memory =
  Memory({ files: Map::new(), open: Map::new(), writer: Map::new(), next: 1 })

/// The bytes of the database at `path`, as a file would contain them: the last committed state.
pub fn database_bytes(m: Memory, path: String) -> Option<Bytes> =
  match m { Memory(t) -> t.files.get(path) }

/// `m` with the database at `path` set to `image`, a database file's bytes.
pub fn with_database_bytes(m: Memory, path: String, image: Bytes) -> Memory =
  match m { Memory(t) -> Memory({ ..t, files: t.files.insert(path, image) }) }

/// What `go` returned with a fake, and the fake's final state.
pub type RunResult<a> = { value: a, memory: Memory }

/// Runs `go` with `m` as the root that `go`'s database operations use, handling each operation with
/// the engine on an in-memory image. It performs no effects, so a test that uses it needs no real
/// root and its result can be cached. A path that leaves the root raises with the message of
/// `E0452`.
pub fn on_memory<a, [d] | e>(
  m: Memory,
  go: () -> a / {sqlite.read[d], sqlite.write[d] | e},
) -> RunResult<a> / {abort.raise | e bounded} =
  handle {
    go()
  } with {
    var t = match m { Memory(t) -> t },
    sqlite.open[d](path, mode, options) -> {
      let opened = fake_open(t, path, mode, options);
      t = opened.fake;
      opened.conn
    },
    sqlite.close[d](connection) -> {
      let now = t;
      t = fake_close(now, connection);
      now.open.contains(connection)
    },
    sqlite.query[d](connection, sql, params, limits) -> {
      let bare_statement = fake_run(t, connection, sql, params, limits, true);
      t = bare_statement.fake;
      bare_statement.reply
    },
    sqlite.execute[d](connection, sql, params, limits) -> {
      let bare_statement = fake_run(t, connection, sql, params, limits, false);
      t = bare_statement.fake;
      bare_statement.reply
    },
    sqlite.control[d](connection, step) -> {
      let bare_statement = fake_control(t, connection, step);
      t = bare_statement.fake;
      bare_statement.reply
    },
    sqlite.backup[d](connection, path) -> {
      let bare_statement = fake_backup(t, connection, path);
      t = bare_statement.fake;
      bare_statement.reply
    },
    sqlite.cursor[d](connection, sql, params, limits) -> {
      let bare_statement = fake_cursor(t, connection, sql, params, limits);
      t = bare_statement.fake;
      bare_statement.reply
    },
    sqlite.fetch[d](connection, rows) -> {
      let bare_statement = fake_fetch(t, connection, rows);
      t = bare_statement.fake;
      bare_statement.reply
    },
    sqlite.finish[d](connection) -> {
      let now = t;
      match now.open.get(connection) {
        Some(o) -> {
          t = { ..now, open: now.open.insert(connection, { ..o, cursor: None }) };
          o.cursor != None
        },
        None -> false,
      }
    },
    return value -> { value: value, memory: Memory(t) },
  }

/// Runs `go` with a root that contains no databases yet. Use it in tests of code that opens
/// databases.
pub fn in_memory<a, [d] | e>(
  go: () -> a / {sqlite.read[d], sqlite.write[d] | e},
) -> a / {abort.raise | e bounded} = on_memory[d](memory, go).value

const empty_reply: Reply =
  { columns: [], rows: [], wrote: false, changed: 0, last_row_id: 0, failure: None }

fn failure_reply(kind: String, name: String, detail: String) -> Reply =
  { ..empty_reply, failure: Some({ kind: kind, name: name, detail: detail }) }

const no_connection_reply: Reply =
  failure_reply("closed", "", "no connection is open under this number")

const busy_reply: Reply = failure_reply("busy", "", "database is locked")

const cursor_open_reply: Reply =
  failure_reply(
    "refused",
    "",
    "a fold is reading this connection: nothing else runs on it until the fold ends",
  )

fn confined(path: String) -> String / {abort.raise} =
  if fs::mem_confined(path) { path } else { panic("`" ++ path ++ "` leaves the root it was given") }

fn committed_database(t: Fake, path: String) -> Bytes = t.files.get(path).unwrap_or(b"")

fn image_of(t: Fake, o: FakeConnection) -> Bytes =
  if o.saved.len() > 0 { o.working } else { committed_database(t, o.path) }

fn written_by_another(t: Fake, path: String, connection: Int) -> Bool =
  match t.writer.get(path) { Some(holder) -> holder != connection, None -> false }

fn fake_open(
  t: Fake,
  path: String,
  mode: Mode,
  options: Options,
) -> { fake: Fake, conn: Result<Int, Failure> } / {abort.raise} = {
  let at = confined(path);
  if mode != Create && !t.files.contains(at) {
    { fake: t, conn: Err({ kind: "unopened", name: "", detail: "unable to open database file" }) }
  } else {
    let files = if t.files.contains(at) { t.files } else { t.files.insert(at, b"") };
    let opened = {
      path: at,
      mode: mode,
      strict: options.strict,
      saved: [],
      working: b"",
      base: b"",
      writes: false,
      cursor: None,
    };
    {
      fake: { ..t, files: files, open: t.open.insert(t.next, opened), next: t.next + 1 },
      conn: Ok(t.next),
    }
  }
}

fn fake_close(t: Fake, connection: Int) -> Fake =
  match t.open.get(connection) {
    None -> t,
    Some(o) -> { ..unlocked(t, o, connection), open: t.open.remove(connection) },
  }

fn unlocked(t: Fake, o: FakeConnection, connection: Int) -> Fake =
  if t.writer.get(o.path) == Some(connection) { { ..t, writer: t.writer.remove(o.path) } }
  else { t }

type StatementResult = { database_after: Bytes, reply: Reply }

fn run_on_image(
  image: Bytes,
  sql: String,
  params: List<Scalar>,
  reads_only: Bool,
  strict: Bool,
  limits: Limits,
) -> StatementResult / {abort.raise} =
  match parts(
      sqlite_run(image, sql, encode_scalars(params), reads_only, strict, encode_limits(limits)),
    ) {
    [left, reply] -> { database_after: found(left).unwrap_or(image), reply: decode_reply(reply) },
    _ ->
      panic(
        "the SQLite library returned a reply in an unreadable format while running the fake database",
      ),
  }

fn fake_run(
  t: Fake,
  connection: Int,
  sql: String,
  params: List<Scalar>,
  limits: Limits,
  querying: Bool,
) -> FakeStep / {abort.raise} =
  match t.open.get(connection) {
    None -> { fake: t, reply: no_connection_reply },
    Some(o) -> if o.cursor != None { { fake: t, reply: cursor_open_reply } } else {
      let ran = run_on_image(
        image_of(t, o),
        sql,
        params,
        querying || o.mode == ReadOnly,
        o.strict,
        limits,
      );
      match ran.reply.failure {
        Some(f) -> if f.kind == "writes" && !querying {
          {
            fake: t,
            reply: failure_reply(
              "read_only",
              "",
              "this statement writes, and the connection was opened to read",
            ),
          }
        } else { { fake: t, reply: ran.reply } },
        None -> if ran.reply.wrote {
          fake_apply_write(t, connection, o, ran.database_after, ran.reply)
        } else { { fake: t, reply: ran.reply } },
      }
    },
  }

fn fake_apply_write(
  t: Fake,
  connection: Int,
  o: FakeConnection,
  image: Bytes,
  reply: Reply,
) -> FakeStep =
  if written_by_another(t, o.path, connection) { { fake: t, reply: busy_reply } }
  else if o.saved.len() == 0 {
    { fake: { ..t, files: t.files.insert(o.path, image) }, reply: reply }
  } else if !o.writes && committed_database(t, o.path) != o.base { { fake: t, reply: busy_reply } }
  else {
    {
      fake: {
        ..t,
        open: t.open.insert(connection, { ..o, working: image, writes: true }),
        writer: t.writer.insert(o.path, connection),
      },
      reply: reply,
    }
  }

fn fake_control(t: Fake, connection: Int, step: TransactionStep) -> FakeStep =
  match t.open.get(connection) {
    None -> { fake: t, reply: no_connection_reply },
    Some(o) -> if o.cursor != None { { fake: t, reply: cursor_open_reply } } else {
      match step {
        Begin -> fake_begin(t, connection, o, true),
        BeginRead -> fake_begin(t, connection, o, false),
        Commit -> fake_end(t, connection, o, true),
        Rollback -> fake_end(t, connection, o, false),
      }
    },
  }

fn fake_begin(t: Fake, connection: Int, o: FakeConnection, takes_write_lock: Bool) -> FakeStep = {
  let writes = takes_write_lock && o.mode != ReadOnly;
  if o.saved.len() >= 32 {
    {
      fake: t,
      reply: failure_reply("refused", "", "a connection allows at most 32 nested transactions"),
    }
  } else if o.saved.len() > 0 {
    {
      fake: { ..t, open: t.open.insert(connection, { ..o, saved: o.saved.push(o.working) }) },
      reply: empty_reply,
    }
  } else if writes && written_by_another(t, o.path, connection) { { fake: t, reply: busy_reply } }
  else {
    let image = committed_database(t, o.path);
    {
      fake: {
        ..t,
        open: t.open.insert(connection, {
          ..o,
          saved: [image],
          working: image,
          base: image,
          writes: writes,
        }),
        writer: if writes { t.writer.insert(o.path, connection) } else { t.writer },
      },
      reply: empty_reply,
    }
  }
}

fn fake_end(t: Fake, connection: Int, o: FakeConnection, stored_datum: Bool) -> FakeStep = {
  let depth = o.saved.len();
  if depth == 0 { { fake: t, reply: failure_reply("refused", "", "no transaction is open") } }
  else if depth > 1 {
    let outer = o.saved.slice(0, depth - 1);
    let working = if stored_datum { o.working } else { o.saved.at(depth - 1).unwrap_or(o.working) };
    {
      fake: { ..t, open: t.open.insert(connection, { ..o, saved: outer, working: working }) },
      reply: empty_reply,
    }
  } else {
    let files = if stored_datum && o.writes { t.files.insert(o.path, o.working) } else { t.files };
    let ended = { ..o, saved: [], working: b"", base: b"", writes: false };
    {
      fake: { ..unlocked(t, o, connection), files: files, open: t.open.insert(connection, ended) },
      reply: empty_reply,
    }
  }
}

fn fake_backup(t: Fake, connection: Int, path: String) -> FakeStep / {abort.raise} =
  match t.open.get(connection) {
    None -> { fake: t, reply: no_connection_reply },
    Some(o) -> {
      let to = confined(path);
      if o.cursor != None { { fake: t, reply: cursor_open_reply } } else if o.saved.len() > 0 {
        {
          fake: t,
          reply: failure_reply("statement", "", "cannot VACUUM from within a transaction"),
        }
      } else if t.files.contains(to) {
        {
          fake: t,
          reply: failure_reply(
            "exists",
            "",
            "`" ++ path ++ "` is there already, and a backup writes a new file",
          ),
        }
      } else {
        {
          fake: { ..t, files: t.files.insert(to, committed_database(t, o.path)) },
          reply: empty_reply,
        }
      }
    },
  }

fn fake_cursor(
  t: Fake,
  connection: Int,
  sql: String,
  params: List<Scalar>,
  limits: Limits,
) -> FakeStep / {abort.raise} =
  match t.open.get(connection) {
    None -> { fake: t, reply: no_connection_reply },
    Some(o) -> if o.cursor != None { { fake: t, reply: cursor_open_reply } } else {
      let ran = run_on_image(image_of(t, o), sql, params, true, o.strict, {
        ..limits,
        bytes: 9223372036854775807,
      });
      match ran.reply.failure {
        Some(_) -> { fake: t, reply: ran.reply },
        None -> {
          let folding = Some({ rows: ran.reply.rows, at: 0, bytes: limits.bytes });
          {
            fake: { ..t, open: t.open.insert(connection, { ..o, cursor: folding }) },
            reply: { ..empty_reply, columns: ran.reply.columns },
          }
        },
      }
    },
  }

fn fake_fetch(t: Fake, connection: Int, rows: Int) -> FakeStep =
  match t.open.get(connection) {
    None -> { fake: t, reply: no_connection_reply },
    Some(o) -> match o.cursor {
      None -> { fake: t, reply: failure_reply("closed", "", "no fold is open on this connection") },
      Some(f) -> {
        let page = f.rows.slice(f.at, min(f.at + max(rows, 0), f.rows.len()));
        let size = page.fold(0, |n: Int, row: List<Scalar>|
          row.fold(n, |m: Int, bare_statement: Scalar|
            m
              + (if bare_statement.kind == 0 { 0 }
              else if bare_statement.kind < 3 { 8 }
              else { bare_statement.bytes.len() })));
        if size > f.bytes {
          {
            fake: t,
            reply: failure_reply(
              "too_large",
              "bytes",
              "the page is larger than the byte limit the caller set",
            ),
          }
        } else {
          let folding = Some({ ..f, at: f.at + page.len() });
          {
            fake: { ..t, open: t.open.insert(connection, { ..o, cursor: folding }) },
            reply: { ..empty_reply, rows: page },
          }
        }
      },
    },
  }

const generous_limits: Limits =
  { sql_bytes: 10000, params: 100, rows: 1000, bytes: 1000000, steps: 100000 }

const strict_options: Options = { strict: true, busy_ms: 0, statements: 16 }

fn stored_datum(p: Param) -> Datum / {abort.raise} = {
  let read = try {
    in_memory[scratch](||
      with_scope[kept_value](
        opening[scratch]("v.db", Create, strict_options),
        |c| close(c),
      ) { connection -> {
        execute(
          connection,
          bound(statement_of("create table v (x any) strict"), []),
          generous_limits,
        );
        execute(
          connection,
          bound(statement_of("insert into v (x) values (?1)"), [p]),
          generous_limits,
        );
        column_value(
          query(connection, bound(statement_of("select x from v"), []), generous_limits).at(
            0,
          ).unwrap_or(
            Map::new(),
          ),
          "x",
        )
      } })
  };
  match read { Ok(d) -> d, Err(_) -> panic("a value was rejected") }
}

test "a float written is the float read, and a NaN is stored as null" {
  gen::check(gen::float(), |p: Float|
    agrees(
      |x: Float| stored_datum(FloatParameter(x)),
      |x: Float| if x != x { NullDatum } else { FloatDatum(x) },
      p,
    ))
}

fn after_a_failed_transaction(ns: List<Int>) -> List<Int> / {abort.raise} = {
  let read = try {
    in_memory[scratch](||
      with_scope[rolled_back](
        opening[scratch]("t.db", Create, strict_options),
        |c| close(c),
      ) { connection -> {
        execute(
          connection,
          bound(statement_of("create table t (n integer) strict"), []),
          generous_limits,
        );
        execute(
          connection,
          bound(statement_of("insert into t (n) values (7)"), []),
          generous_limits,
        );
        let gave_up: Result<Unit, Error> = try {
          transaction(connection, || {
            ns.map(|n: Int|
              execute(
                connection,
                bound(statement_of("insert into t (n) values (?1)"), [IntParameter(n)]),
                generous_limits,
              ));
            sql.fail(Closed("the transaction function failed on purpose"))
          })
        };
        query(
          connection,
          bound(statement_of("select n from t order by rowid"), []),
          generous_limits,
        ).map(|row: Row| int(row, "n"))
      } })
  };
  match read { Ok(column_value) -> column_value, Err(_) -> panic("the table was not read") }
}

test "a transaction whose body raises changes nothing" {
  gen::check(gen::list(gen::any_int()), |x: List<Int>|
    agrees(after_a_failed_transaction, |_: List<Int>| [7], x))
}

fn rows_returned(column_value: Int, limit: Int) -> Int / {abort.raise} = {
  let read = try {
    in_memory[scratch](||
      with_scope[limited](opening[scratch]("t.db", Create, strict_options), |c|
        close(c)) { connection -> {
        execute(
          connection,
          bound(statement_of("create table t (n integer) strict"), []),
          generous_limits,
        );
        execute(
          connection,
          bound(
            statement_of(
              "with recursive c(i) as (select 1 union all select i + 1 from c where i < ?1) insert into t select i from c where ?1 > 0",
            ),
            [IntParameter(column_value)],
          ),
          generous_limits,
        );
        query(connection, bound(statement_of("select n from t"), []), {
          ..generous_limits,
          rows: limit,
        }).len(
        )
      } })
  };
  match read { Ok(n) -> n, Err(_) -> -1 }
}

test "a query returns all rows when their count is within the row limit, and fails when above it" {
  gen::check(
    gen::map2(gen::any_int(), gen::any_int(), |column_value: Int, limit: Int|
      { held: column_value, limit: limit }),
    |x: { held: Int, limit: Int }|
      agrees(
        |c: { held: Int, limit: Int }|
          rows_returned(rem_euclid(c.held, 24), rem_euclid(c.limit, 24)),
        |c: { held: Int, limit: Int }|
          if rem_euclid(c.held, 24) <= rem_euclid(c.limit, 24) { rem_euclid(c.held, 24) }
          else { -1 },
        x,
      ),
  )
}

const clock_and_random_statements: List<String> =
  [
    "select random()",
    "select randomblob(4)",
    "select current_timestamp",
    "select current_date",
    "select current_time",
    "select datetime('now')",
    "select date()",
    "select strftime('%s', 'now')",
    "select time('12:00', 'localtime')",
  ]

fn rejected_before_running(sql: String) -> Bool / {abort.raise} =
  match try { bound(statement_of(sql), []) } { Err(Rejected(_)) -> true, _ -> false }

test "a statement that reads the clock or draws a random number is rejected before it runs" {
  gen::check(gen::any_int(), |x: Int|
    agrees(
      |i: Int|
        rejected_before_running(
          clock_and_random_statements.at(
            rem_euclid(i, clock_and_random_statements.len()),
          ).unwrap_or(
            "",
          ),
        ),
      |_: Int| true,
      x,
    ))
}

fn bare_statement(sql: String) -> Bound / {sql.fail, abort.raise} = bound(statement_of(sql), [])

fn numbers(rows: List<Row>, column: String) -> List<Int> / {sql.fail} =
  rows.map(|row: Row| int(row, column))

fn rejection<a | e>(go: () -> a / {sql.fail | e}) -> Option<Error> / e =
  match try[sql.fail] { go() } { Ok(_) -> None, Err(reason) -> Some(reason) }

test "a database written and closed is read back when it is opened again" {
  let wrote = over_fake(memory, ||
    with_scope[first](opening[app]("data/app.db", Create, strict_options), |c|
      close(c)) { connection -> {
      execute(
        connection,
        bare_statement("create table person (id integer primary key, name text not null) strict"),
        generous_limits,
      );
      execute(
        connection,
        bound(statement_of("insert into person (name) values (?1)"), [TextParameter("Ada")]),
        generous_limits,
      )
    } });
  let left = match wrote { Ok(over) -> over, Err(_) -> panic("the database was not written") };
  assert_eq(left.value, { rows: 1, last_row_id: 1 });
  let names = in_fake(left.memory, ||
    with_scope[second](
      opening[app]("data/app.db", ReadOnly, strict_options),
      |c| close(c),
    ) { connection ->
      query(connection, bare_statement("select id, name from person"), generous_limits).map(
        |row: Row| text(row, "name"),
      )
    });
  assert_eq(names, Ok(["Ada"]))
}

fn over_fake<a>(
  m: Memory,
  go: () -> a / {sqlite.read[app], sqlite.write[app], sql.fail, abort.raise},
) -> Result<RunResult<a>, Error> / {abort.raise} = try[sql.fail] { on_memory[app](m, go) }

fn in_fake<a>(
  m: Memory,
  go: () -> a / {sqlite.read[app], sqlite.write[app], sql.fail, abort.raise},
) -> Result<a, Error> / {abort.raise} = try[sql.fail] { on_memory[app](m, go).value }

fn in_empty_fake<a>(
  go: () -> a / {sqlite.read[app], sqlite.write[app], sql.fail, abort.raise},
) -> Result<a, Error> / {abort.raise} = in_fake(memory, go)

test "a database that does not exist opens only in Create mode" {
  assert_eq(
    in_empty_fake(||
      with_scope[missing](opening[app]("no.db", ReadWrite, strict_options), |c|
        close(c)) { connection -> 1 }),
    Err(Unopened("unable to open database file")),
  );
  assert_eq(
    in_empty_fake(||
      with_scope[made](opening[app]("no.db", Create, strict_options), |c| close(c)) { connection ->
        1
      }),
    Ok(1),
  )
}

test "each value kind is read with its matching reader, and a null column reads as `None` through `optional`" {
  let read = in_empty_fake(||
    with_scope[typed](opening[app]("t.db", Create, strict_options), |c| close(c)) { connection -> {
      execute(
        connection,
        bare_statement("create table v (i integer, r real, t text, b blob, n text) strict"),
        generous_limits,
      );
      execute(
        connection,
        bound(statement_of("insert into v values (?1, ?2, ?3, ?4, ?5)"), [
          IntParameter(-9223372036854775807 - 1),
          FloatParameter(1.5),
          TextParameter("a\0b \u{1F600}"),
          BytesParameter(b"\x00\xff"),
          NullParameter,
        ]),
        generous_limits,
      );
      let rows = query(connection, bare_statement("select i, r, t, b, n from v"), generous_limits);
      let row = rows.at(0).unwrap_or(Map::new());
      {
        i: int(row, "i"),
        r: float(row, "r"),
        t: text(row, "t"),
        b: bytes(row, "b"),
        n: optional(row, "n", text),
        t_again: optional(row, "t", text),
        mistyped: rejection(|| int(row, "t")),
        missing: rejection(|| int(row, "absent")),
      }
    } });
  assert_eq(
    read,
    Ok({
      i: -9223372036854775807 - 1,
      r: 1.5,
      t: "a\0b \u{1F600}",
      b: b"\x00\xff",
      n: None,
      t_again: Some("a\0b \u{1F600}"),
      mistyped: Some(Mistyped("t", "an integer")),
      missing: Some(Mistyped("absent", "a column of the result")),
    }),
  )
}

test "a boolean is bound as 1 or 0, and a parameter type SQLite cannot store is rejected" {
  let read = in_empty_fake(||
    with_scope[bools](opening[app]("t.db", Create, strict_options), |c| close(c)) { connection ->
      numbers(
        query(
          connection,
          bound(statement_of("select ?1 as a union all select ?2"), [
            BoolParameter(true),
            BoolParameter(false),
          ]),
          generous_limits,
        ),
        "a",
      )
    });
  assert_eq(read, Ok([1, 0]));
  let unbound = rejection(|| bound(statement_of("select ?1"), [NumericParameter(1.50m)]));
  assert(match unbound { Some(Rejected(_)) -> true, _ -> false })
}

test "a transaction commits when its body returns and rolls back when it raises" {
  let read = in_empty_fake(||
    with_scope[txn](opening[app]("t.db", Create, strict_options), |c| close(c)) { connection -> {
      execute(connection, bare_statement("create table t (n integer) strict"), generous_limits);
      transaction(connection, ||
        execute(connection, bare_statement("insert into t values (1)"), generous_limits));
      let failed = rejection(||
        transaction(connection, || {
          execute(connection, bare_statement("insert into t values (2)"), generous_limits);
          execute(connection, bare_statement("insert into t values ('two')"), generous_limits)
        }));
      let inner = transaction(connection, || {
        execute(connection, bare_statement("insert into t values (3)"), generous_limits);
        let gave_up = rejection(||
          transaction(connection, || {
            execute(connection, bare_statement("insert into t values (4)"), generous_limits);
            sql.fail(Closed("no"))
          }));
        execute(connection, bare_statement("insert into t values (5)"), generous_limits);
        gave_up
      });
      {
        held: numbers(
          query(connection, bare_statement("select n from t order by n"), generous_limits),
          "n",
        ),
        failed: failed,
        inner: inner,
      }
    } });
  assert_eq(
    read,
    Ok({ held: [1, 3, 5], failed: Some(Constraint(Datatype, "t.n")), inner: Some(Closed("no")) }),
  )
}

test "a second writer fails with `Busy` (database locked), and a reader sees only committed rows" {
  let read = in_empty_fake(||
    with_scope[writer](opening[app]("t.db", Create, strict_options), |c| close(c)) { one ->
      with_scope[reader](opening[app]("t.db", ReadWrite, strict_options), |c| close(c)) { two -> {
        execute(one, bare_statement("create table t (n integer) strict"), generous_limits);
        execute(one, bare_statement("insert into t values (1)"), generous_limits);
        let during = transaction(one, || {
          execute(one, bare_statement("insert into t values (2)"), generous_limits);
          {
            seen: numbers(
              query(two, bare_statement("select n from t order by n"), generous_limits),
              "n",
            ),
            written: rejection(||
              execute(two, bare_statement("insert into t values (3)"), generous_limits)),
            begun: rejection(|| transaction(two, || 0)),
          }
        });
        {
          during: during,
          after: numbers(
            query(two, bare_statement("select n from t order by n"), generous_limits),
            "n",
          ),
          then: execute(two, bare_statement("insert into t values (3)"), generous_limits).rows,
        }
      } }
    });
  assert_eq(
    read,
    Ok({ during: { seen: [1], written: Some(Busy), begun: Some(Busy) }, after: [1, 2], then: 1 }),
  );
  assert(is_retryable(Busy));
  assert(!is_retryable(Constraint(Unique, "t.n")))
}

test "a snapshot sees one consistent state, and writing in it fails with `Busy` after another connection wrote" {
  let read = in_empty_fake(||
    with_scope[snap](opening[app]("t.db", Create, strict_options), |c| close(c)) { one ->
      with_scope[other](opening[app]("t.db", ReadWrite, strict_options), |c| close(c)) { two -> {
        execute(one, bare_statement("create table t (n integer) strict"), generous_limits);
        snapshot(one, || {
          let before = query(one, bare_statement("select n from t"), generous_limits).len();
          execute(two, bare_statement("insert into t values (1)"), generous_limits);
          {
            before: before,
            still: query(one, bare_statement("select n from t"), generous_limits).len(),
            stale: rejection(||
              execute(one, bare_statement("insert into t values (2)"), generous_limits)),
          }
        })
      } }
    });
  assert_eq(read, Ok({ before: 0, still: 0, stale: Some(Busy) }))
}

type ViolationCase = { sql: String, reason: Error }

const violation_cases: List<ViolationCase> =
  [
    { sql: "insert into p values (2, 'a')", reason: Constraint(Unique, "p.code") },
    { sql: "insert into p values (1, 'b')", reason: Constraint(Unique, "p.id") },
    { sql: "insert into p (code) values (null)", reason: Constraint(NotNull, "p.code") },
    { sql: "insert into c (p, n) values (1, 0)", reason: Constraint(Check, "positive") },
    { sql: "insert into c (p, n) values (9, 1)", reason: Constraint(ForeignKey, "") },
    { sql: "insert into c (p, n) values (1, 'many')", reason: Constraint(Datatype, "c.n") },
    { sql: "delete from p", reason: Constraint(ForeignKey, "") },
  ]

test "executing `{c.sql}` fails with the constraint violation the case expects" for c: ViolationCase in violation_cases {
  let read = in_empty_fake(||
    with_scope[constrained](opening[app]("t.db", Create, strict_options), |x|
      close(x)) { connection -> {
      execute(
        connection,
        bare_statement("create table p (id integer primary key, code text not null unique) strict"),
        generous_limits,
      );
      execute(
        connection,
        bare_statement(
          "create table c (id integer primary key, p integer not null references p (id), n integer, constraint positive check (n > 0)) strict",
        ),
        generous_limits,
      );
      execute(connection, bare_statement("insert into p values (1, 'a')"), generous_limits);
      execute(connection, bare_statement("insert into c (p, n) values (1, 1)"), generous_limits);
      rejection(|| execute(connection, bare_statement(c.sql), generous_limits))
    } });
  assert_eq(read, Ok(Some(c.reason)))
}

test "a query that exceeds a limit is rejected, and the error names that limit" {
  let read = in_empty_fake(||
    with_scope[bounded](opening[app]("t.db", Create, strict_options), |c| close(c)) { connection -> {
      execute(connection, bare_statement("create table t (n integer) strict"), generous_limits);
      execute(connection, bare_statement("insert into t values (1), (2), (3)"), generous_limits);
      [
        rejection(||
          query(connection, bare_statement("select n from t"), { ..generous_limits, rows: 2 })),
        rejection(||
          query(connection, bare_statement("select 'abcdef' as a"), {
            ..generous_limits,
            bytes: 5,
          })),
        rejection(||
          query(connection, bare_statement("select 1 as a"), { ..generous_limits, sql_bytes: 5 })),
        rejection(||
          query(
            connection,
            bound(statement_of("select ?1 as a, ?2 as b"), [IntParameter(1), IntParameter(2)]),
            { ..generous_limits, params: 1 },
          )),
        rejection(||
          query(
            connection,
            bare_statement(
              "with recursive c(i) as (select 1 union all select i + 1 from c where i < 1000000) select count(*) as n from c",
            ),
            { ..generous_limits, steps: 10 },
          )),
        rejection(||
          returning(connection, bare_statement("delete from t returning n"), {
            ..generous_limits,
            rows: 1,
          })),
        rejection(||
          query(connection, bare_statement("select n from t"), { ..generous_limits, rows: 3 })),
      ]
    } });
  assert_eq(
    read,
    Ok([
      Some(LimitExceeded("rows")),
      Some(LimitExceeded("bytes")),
      Some(LimitExceeded("sql_bytes")),
      Some(LimitExceeded("params")),
      Some(LimitExceeded("steps")),
      Some(LimitExceeded("rows")),
      None,
    ]),
  )
}

test "a write whose returned rows exceed the row limit is rolled back and changes nothing" {
  let read = in_empty_fake(||
    with_scope[undone](opening[app]("t.db", Create, strict_options), |c| close(c)) { connection -> {
      execute(connection, bare_statement("create table t (n integer) strict"), generous_limits);
      execute(connection, bare_statement("insert into t values (1), (2), (3)"), generous_limits);
      let over = rejection(||
        returning(connection, bare_statement("delete from t returning n"), {
          ..generous_limits,
          rows: 1,
        }));
      let gone = numbers(
        returning(
          connection,
          bare_statement("delete from t where n = 2 returning n"),
          generous_limits,
        ),
        "n",
      );
      {
        over: over,
        gone: gone,
        left: numbers(
          query(connection, bare_statement("select n from t order by n"), generous_limits),
          "n",
        ),
      }
    } });
  assert_eq(read, Ok({ over: Some(LimitExceeded("rows")), gone: [2], left: [1, 3] }))
}

test "fold_rows reads every row a page at a time and nothing else runs meanwhile" {
  let read = in_empty_fake(||
    with_scope[folding](opening[app]("t.db", Create, strict_options), |c| close(c)) { connection -> {
      execute(connection, bare_statement("create table t (n integer) strict"), generous_limits);
      execute(
        connection,
        bare_statement(
          "with recursive c(i) as (select 1 union all select i + 1 from c where i < 10) insert into t select i from c",
        ),
        generous_limits,
      );
      let all = bare_statement("select n from t order by n");
      let counted = |accumulator: Int, _: Row| accumulator + 1;
      {
        sum: fold_rows(connection, all, generous_limits, 3, 0, |accumulator: Int, row: Row|
          accumulator + int(row, "n")),
        whole: fold_rows(connection, all, generous_limits, 10, 0, counted),
        none: fold_rows(
          connection,
          bare_statement("select n from t where n > 99"),
          generous_limits,
          4,
          0,
          counted,
        ),
        over: rejection(||
          fold_rows(connection, all, { ..generous_limits, rows: 7 }, 3, 0, counted)),
        meanwhile: is_rejected(
          fold_rows(connection, all, generous_limits, 20, None, |_: Option<Error>, _: Row|
            rejection(|| query(connection, bare_statement("select 1 as a"), generous_limits))),
        ),
        writes: is_rejected(
          rejection(||
            fold_rows(
              connection,
              bare_statement("delete from t returning n"),
              generous_limits,
              3,
              0,
              counted,
            )),
        ),
        after: query(connection, all, generous_limits).len(),
      }
    } });
  assert_eq(
    read,
    Ok({
      sum: 55,
      whole: 10,
      none: 0,
      over: Some(LimitExceeded("rows")),
      meanwhile: true,
      writes: true,
      after: 10,
    }),
  )
}

fn is_rejected(reason: Option<Error>) -> Bool =
  match reason { Some(Rejected(_)) -> true, _ -> false }

test "a backup is a separate database, and never overwrites a file" {
  let made = over_fake(memory, ||
    with_scope[source](opening[app]("t.db", Create, strict_options), |c| close(c)) { connection -> {
      execute(connection, bare_statement("create table t (n integer) strict"), generous_limits);
      execute(connection, bare_statement("insert into t values (1)"), generous_limits);
      backup(connection, "copies/t.db");
      execute(connection, bare_statement("insert into t values (2)"), generous_limits);
      {
        reprinted: is_rejected(rejection(|| backup(connection, "copies/t.db"))),
        inside: rejection(|| transaction(connection, || backup(connection, "copies/u.db"))),
      }
    } });
  let left = match made { Ok(over) -> over, Err(_) -> panic("the backup was not made") };
  assert_eq(left.value, {
    reprinted: true,
    inside: Some(Malformed("cannot VACUUM from within a transaction")),
  });
  let copy = in_fake(left.memory, ||
    with_scope[copied](
      opening[app]("copies/t.db", ReadOnly, strict_options),
      |c| close(c),
    ) { connection ->
      numbers(query(connection, bare_statement("select n from t"), generous_limits), "n")
    });
  assert_eq(copy, Ok([1]));
  assert(database_bytes(left.memory, "copies/u.db") == None);
  assert(database_bytes(left.memory, "copies/t.db") != database_bytes(left.memory, "t.db"))
}

test "a connection opened to read writes nothing, and a query never writes" {
  let read = in_empty_fake(|| {
    with_scope[seeded](opening[app]("t.db", Create, strict_options), |c| close(c)) { connection ->
      execute(connection, bare_statement("create table t (n integer) strict"), generous_limits)
    };
    with_scope[reading](opening[app]("t.db", ReadOnly, strict_options), |c|
      close(c)) { connection ->
      [
        rejection(||
          execute(connection, bare_statement("insert into t values (1)"), generous_limits)),
        rejection(||
          query(
            connection,
            bare_statement("insert into t values (1) returning n"),
            generous_limits,
          )),
        rejection(||
          transaction(connection, ||
            execute(connection, bare_statement("insert into t values (1)"), generous_limits))),
        rejection(||
          transaction(connection, ||
            query(connection, bare_statement("select n from t"), generous_limits).len())),
        rejection(||
          snapshot(connection, ||
            query(connection, bare_statement("select n from t"), generous_limits).len())),
      ]
    }
  });
  assert(match read {
    Ok([Some(Rejected(_)), Some(Rejected(_)), Some(Rejected(_)), None, None]) -> true,
    _ -> false,
  })
}

test "a strict connection rejects a table that is not strict, and another connection accepts it" {
  let made = |strict: Bool|
    in_empty_fake(||
      with_scope[strictness](
        opening[app]("t.db", Create, { ..strict_options, strict: strict }),
        |c| close(c),
      ) { connection ->
        rejection(|| execute(connection, bare_statement("create table loose (a)"), generous_limits))
      });
  assert(match made(true) { Ok(Some(Rejected(_))) -> true, _ -> false });
  assert_eq(made(false), Ok(None))
}

const engine_rejects: List<String> =
  [
    "select last_insert_rowid() as a",
    "select changes() as a",
    "pragma journal_mode = delete",
    "pragma database_list",
    "select datetime(?1) as a",
    "select * from pragma_database_list",
    "create view v as select 1 as a; drop table t",
  ]

test "the engine rejects `{c}` when it runs, though the SQL parser accepts it" for c: String in engine_rejects {
  let read = in_empty_fake(||
    with_scope[authorized](opening[app]("t.db", Create, strict_options), |x|
      close(x)) { connection -> {
      execute(connection, bare_statement("create table t (n integer) strict"), generous_limits);
      let params = if c.contains("?1") { [TextParameter("now")] } else { [] };
      rejection(|| execute(connection, bound(statement_of(c), params), generous_limits))
    } });
  assert(match read { Ok(Some(Rejected(_))) -> true, _ -> false })
}

test "a view and a trigger are bound by the same rules as a statement" {
  let read = in_empty_fake(||
    with_scope[smuggled](opening[app]("t.db", Create, strict_options), |c|
      close(c)) { connection -> {
      execute(
        connection,
        bare_statement("create table t (n integer, at text) strict"),
        generous_limits,
      );
      execute(
        connection,
        bare_statement("create view stamped as select datetime(at) as at from t"),
        generous_limits,
      );
      execute(
        connection,
        bare_statement(
          "create trigger stamp after insert on t begin update t set at = datetime(new.at, '+1 day'); end",
        ),
        generous_limits,
      );
      execute(
        connection,
        bare_statement("insert into t values (1, '2024-01-31 12:00:00')"),
        generous_limits,
      );
      let stored_datum = query(
        connection,
        bare_statement("select at from stamped"),
        generous_limits,
      ).map(|row: Row| text(row, "at"));
      let now = rejection(||
        execute(connection, bare_statement("insert into t values (2, 'now')"), generous_limits));
      {
        retained: stored_datum,
        now: now,
        held: query(connection, bare_statement("select n from t"), generous_limits).len(),
      }
    } });
  assert(match read {
    Ok(r) ->
      r.retained == ["2024-02-01 12:00:00"] && r.held == 1
        && (match r.now { Some(Rejected(_)) -> true, _ -> false }),
    Err(_) -> false,
  })
}

test "a SQL template's interpolated values become `?1`, `?2` parameters, and a rejected statement's error gives the template part number and text offset" {
  assert_eq(
    compile(["select n from t where a = ", " and b = ", ""]),
    Ok(statement_of("select n from t where a = ?1 and b = ?2")),
  );
  let filled = fill(statement_of("select ?1 as a, ?2 as b"), [IntParameter(1), TextParameter("x")]);
  assert_eq(statement(filled), statement_of("select ?1 as a, ?2 as b"));
  let placed_at = |texts: List<String>|
    match compile(texts) { Err(e) -> Some({ part: e.part, offset: e.offset }), Ok(_) -> None };
  assert_eq(placed_at(["select random()"]), Some({ part: 0, offset: 7 }));
  assert_eq(placed_at(["select ", ", é, current_date"]), Some({ part: 1, offset: 5 }));
  assert_eq(placed_at(["attach ", " as x"]), Some({ part: 0, offset: 0 }));
  assert(match literal("vacuum") { Err(e) -> e.offset == 0, Ok(_) -> false });
  assert(match literal("select 1") { Ok(_) -> true, Err(_) -> false })
}

test "a path that leaves its root is rejected with E0452's message" {
  let escaped = try[abort.raise] {
    in_empty_fake(||
      with_scope[escaping](opening[app]("../t.db", Create, strict_options), |c|
        close(c)) { connection -> 0 })
  };
  assert_eq(escaped, Err("`../t.db` leaves the root it was given"))
}

test "using a connection after it was closed, or one that was never opened, fails with `Closed`" {
  let read = in_empty_fake(|| {
    let stored_datum = with_scope[leaving](
      opening[app]("t.db", Create, strict_options),
      |c| close(c),
    ) { connection -> connection.get() };
    with_scope[again](stored_datum, |_: Connection<[app]>| ()) { connection ->
      rejection(|| query(connection, bare_statement("select 1 as a"), generous_limits))
    }
  });
  assert(match read { Ok(Some(Closed(_))) -> true, _ -> false })
}

test "every allowed function is listed once, in order" {
  let names = functions;
  assert(names.len() > 80);
  assert(
    range(1, names.len()).fold(true, |ok: Bool, i: Int|
      ok && compare(names.at(i - 1), names.at(i)) == Less),
  )
}
