//! SQLite: an embedded SQL database, stored in a file under a root or as an image in memory.
//!
//! The effect's label is a database's root, bound as `std.fs`'s labels are: `--fs app=./data`
//! grants the directory, and `sqlite.query[app]` reads a database under it. A path that leaves its
//! root is `E0452`, and an unbound label is `E0451`. No part of a database's path, nor the journal
//! beside it, may be a symbolic link. One writer writes a database at a time, so two endpoints that
//! write `[app]` conflict and two that query it do not. The engine is SQLite 3.53.2, compiled into
//! `ply` and the same on every machine.
//!
//! A connection is opened under a `with_scope`, which closes it however its body ends:
//! `with_scope[db](sqlite::opening[app]("app.db", sqlite::Create, options), |c| sqlite::close(c))
//! { conn -> .. }`. It is opened once with settings no statement can change: write-ahead
//! logging, foreign keys enforced, the wait `Options.busy_ms` on another connection's lock,
//! defensive mode, an untrusted schema, no extension loading, no attached database, no temporary
//! or virtual table, and, with `Options.strict`, no table that is not `STRICT` (declare tables
//! `STRICT` either way: without it a column accepts any value). The engine's authorizer enforces
//! these rules inside the engine, so views and triggers are bound by them too. It rejects
//! `ATTACH`, `DETACH` and `VACUUM`, any pragma other than `user_version`, `application_id`,
//! `optimize` and those that describe or check a schema, and any function not in `functions()`.
//!
//! A statement is a `Bound`: text the parser has accepted, and its parameters.
//! `bound(stmt(".."), ps)` makes one from text a program built. The tag
//! `sqlite"insert into t (a) values ({IntParameter(n)})"` makes one whose text is parsed when the
//! program is checked and whose holes are its parameters, bound as `?1`, `?2`. Nothing in a hole
//! ever becomes statement text. The parameters are `std.sql`'s `Param`: null, an integer, a float,
//! text and bytes are what SQLite stores, and a `BoolParameter` is bound as 1 or 0. The caller must
//! encode a `Decimal`, a date, JSON or an array as text or an integer, so `NumericParameter`,
//! `JsonParameter` and `ArrayParameter` are rejected.
//!
//! `query` returns rows, each a `std.sql` `Row`, read a column at a time by `int`, `float`, `text`
//! and `bytes`, and through `optional` when a column may be null. `execute` returns the number of
//! rows a statement changed and the row id it last inserted. `returning` is a write that returns
//! rows. `run` returns either as `std.sql`'s `QueryResult`. Every one takes its `Limits`, and none
//! can be called without them.
//!
//! `transaction` runs its body between `BEGIN IMMEDIATE` and `COMMIT`, and rolls back if the body
//! raises or its task is cancelled. Inside another transaction it is a savepoint. `snapshot` does
//! the same for a transaction that only reads, which sees one state of the database throughout.
//! `fold_rows` reads a large result a page at a time. `backup` writes a compacted copy under the
//! same root.
//!
//! Errors are raised as `sql.fail` with an `Error`. `Busy` means another connection held the lock
//! past the wait, and it is the one error worth retrying (`is_retryable`). `Constraint` gives the
//! constraint's kind and the name the engine reports: `table.column` for a unique, not-null or
//! strict-type failure, the constraint's name for a check, and nothing for a foreign key. `try`
//! turns any call into a `Result`.
//!
//! A statement reads no clock and draws no random number. `CURRENT_TIMESTAMP`, `random()` and
//! `randomblob()` are rejected, and so is a date or time function given no time, the time `'now'`,
//! or the modifier `'localtime'` or `'utc'`, whether written in the statement or bound to it. The
//! functions `last_insert_rowid()`, `changes()` and `total_changes()` are rejected too, since
//! `execute` returns what they would. So is a row id of 9223372036854775807, past which the engine
//! picks row ids at random. So a statement's result depends only on the database and the values
//! bound.
//!
//! The same engine runs on an image in memory as the fake: `in_memory[app](|| ..)` handles every
//! operation with `sqlite_run`, a native function that performs no effects. So a test that uses it
//! is deterministic and cached, a law may quantify over it, and neither needs a root. The fake
//! keeps a database for each path, gives a transaction its own copy, and returns `Busy` at once to
//! a second writer. It differs from a file in three ways: a deferred foreign key is checked at its
//! statement, not at the commit; `backup` copies the image without compacting it; and each
//! statement costs a copy of the database. So a test that fills a large database belongs on a file
//! under a root that `--fs` grants.
//!
//! A schema's version is `pragma user_version`: a migration is a `transaction` that reads it, runs
//! the statements after it and sets it.

import std.sql (Statement, stmt, Param, NullParameter, IntParameter, BoolParameter, TextParameter,
                BytesParameter, FloatParameter, NumericParameter, JsonParameter, ArrayParameter,
                Datum, NullDatum, IntDatum, FloatDatum, TextDatum, BytesDatum, Row, QueryResult,
                Rows, Count, Failed, Sqlite, scan_statement, refusal_byte)
import std.bytes (i64_be)
import std.fs
import std.internal.native (native, wait, job_wait, observed, found, parts, encode_parts,
                            decode_int)
import std.laws (agrees)
import std.list
import std.math (rem_euclid)
import std.option
import std.gen

/// Runs one SQL statement with SQLite on the database in `image`: a database file's bytes, or
/// empty for an empty database. Its values and limits are encoded as the native functions below
/// read them. Returns as parts the image it left, present when it wrote and stored what it wrote,
/// and its reply. The result depends only on the arguments: every `ply` of this version carries
/// the same engine, and a statement that would read a clock, entropy or another file is rejected.
/// `reads_only` rejects a statement that could write, and `strict` a table that is not `STRICT`.
/// `run_on_image` is how the fake runs one.
extern fn sqlite_run(
  image: Bytes,
  sql: String,
  params: Bytes,
  reads_only: Bool,
  strict: Bool,
  limits: Bytes,
) -> Bytes

/// The SQL functions a statement run by `sqlite_run` may call, in order, as parts. Any other
/// function is rejected.
extern fn sqlite_functions() -> Bytes

/// How a database file is opened: to be read, to be read and written, or created if it does not
/// exist.
pub type Mode = | ReadOnly | ReadWrite | Create

/// What a connection is opened with: whether every table it makes must be `STRICT`, the
/// milliseconds a statement waits on another connection's lock before it is `Busy`, and how many
/// prepared statements the connection caches for reuse by a later statement with the same text.
pub type Options = { strict: Bool, busy_ms: Int, statements: Int }

/// What one statement may take and return: the bytes of its text, its parameters, the rows it
/// returns, the bytes of the values in them (a text's or a blob's length, eight for a number),
/// and the steps of the engine's virtual machine it may run, in thousands. The steps limit its
/// work without a clock, so the same statement on the same database is always rejected or never.
pub type Limits = { sql_bytes: Int, params: Int, rows: Int, bytes: Int, steps: Int }

/// One value as the engine binds and returns it: `kind` is 0 for null, 1 for an integer in `int`,
/// 2 for a float in `real`, 3 for text and 4 for bytes, both in `bytes`.
pub type Scalar = { kind: Int, int: Int, real: Float, bytes: Bytes }

/// Why the engine did not do what was requested: the kind word that `refusal_of` turns into an
/// `Error`, the constraint, limit or engine code it names, and the engine's own message.
pub type Failure = { kind: String, name: String, detail: String }

/// The engine's result for one operation: the columns and rows of a statement that returns them,
/// whether the statement could have changed the database, the number of rows it changed itself,
/// the row id it last inserted or 0, and why it did not run.
pub type Reply = {
  columns: List<String>,
  rows: List<List<Scalar>>,
  wrote: Bool,
  changed: Int,
  last_row_id: Int,
  failure: Option<Failure>,
}

/// One step of a connection's transaction. `Begin` takes the write lock at once and `BeginRead`
/// reads one snapshot; either is a savepoint inside a transaction, where `Commit` and `Rollback`
/// close the innermost.
pub type Control = | Begin | BeginRead | Commit | Rollback

/// A database under the root its label names. Every operation on a connection goes to the
/// engine one at a time, in the order it was performed.
pub nondet effect sqlite {
  /// Opens the database at `path`, returning the connection's number.
  write open[d](path: String, mode: Mode, options: Options) -> Result<Int, Failure>
  /// Closes a connection, rolling back what it left open; `false` for a number that names none.
  write close[d](conn: Int) -> Bool
  /// Runs a statement that only reads.
  read query[d](conn: Int, sql: String, params: List<Scalar>, limits: Limits) -> Reply
  /// Runs a statement that may write. A statement rejected after it ran, because of what it
  /// returned or left, leaves no changes behind.
  write execute[d](conn: Int, sql: String, params: List<Scalar>, limits: Limits) -> Reply
  /// Opens or closes a transaction or a savepoint.
  write control[d](conn: Int, step: Control) -> Reply
  /// Writes a compacted copy of the database to `path`, where no file exists yet.
  write backup[d](conn: Int, path: String) -> Reply
  /// Opens a read-only statement to be fetched a page at a time, returning its columns.
  /// Nothing else runs on the connection until `finish`.
  write cursor[d](conn: Int, sql: String, params: List<Scalar>, limits: Limits) -> Reply
  /// The next `rows` rows of the open statement; fewer means the end. `limits.rows` limits all its
  /// pages together, and `limits.bytes` each page.
  write fetch[d](conn: Int, rows: Int) -> Reply
  /// Ends the open statement; `false` when none is open.
  write finish[d](conn: Int) -> Bool
}

/// What this module raises. It is a separate effect, so code that handles every `sqlite`
/// operation, as the fake does, is deterministic even though it may still fail.
pub effect sql {
  /// A database did not do what was requested.
  raise fail(why: Error)
}

/// The constraint a write broke: a unique index or a primary key, a foreign key, `NOT NULL`, a
/// `CHECK`, a `STRICT` column's type, or another the engine enforces (a trigger's `RAISE`).
pub type Violation = | Unique | ForeignKey | NotNull | Check | Datatype | Other

/// Why a database did not do what was requested.
///
/// `Busy`: another connection held the lock past the wait the connection was opened with.
/// `Constraint`: a write broke a constraint, with the name the engine reports. `Unopened`: the
/// database did not open. `Refused`: the statement is one this module does not run, as the parser
/// or the engine's authorizer reported before it ran. `Malformed`: the engine could not parse the
/// statement, or it names something the database does not contain. `LimitExceeded`: a limit the
/// caller set was exceeded, given by its field's name, or `value` for one text or blob over
/// 64 MiB. `Mistyped`: a column does not contain the type a reader requested. `Closed`: the
/// connection is closed, or its transaction was rolled back under it. `Engine`: anything else,
/// with the engine's code.
pub type Error =
  | Busy
  | Constraint(Violation, String)
  | Unopened(String)
  | Refused(String)
  | Malformed(String)
  | LimitExceeded(String)
  | Mistyped(String, String)
  | Closed(String)
  | Engine(String, String)

/// Whether running the same operation again may succeed. Only `Busy` may.
pub fn is_retryable(why: Error) -> Bool = match why { Busy -> true, _ -> false }

/// A `Failure` converted to an `Error`.
pub fn refusal_of(f: Failure) -> Error =
  if f.kind == "busy" { Busy }
  else if f.kind == "unique" { Constraint(Unique, f.name) }
  else if f.kind == "foreign_key" { Constraint(ForeignKey, f.name) }
  else if f.kind == "not_null" { Constraint(NotNull, f.name) }
  else { refusal_of_rest(f) }

fn refusal_of_rest(f: Failure) -> Error =
  if f.kind == "check" { Constraint(Check, f.name) }
  else if f.kind == "datatype" { Constraint(Datatype, f.name) }
  else if f.kind == "constraint" { Constraint(Other, f.name) }
  else if f.kind == "unopened" { Unopened(f.detail) }
  else { refusal_of_last(f) }

fn refusal_of_last(f: Failure) -> Error =
  if f.kind == "refused" || f.kind == "writes" || f.kind == "read_only" || f.kind == "exists" {
    Refused(f.detail)
  } else if f.kind == "statement" { Malformed(f.detail) }
  else if f.kind == "too_large" { LimitExceeded(f.name) }
  else if f.kind == "steps" { LimitExceeded("steps") }
  else if f.kind == "closed" || f.kind == "aborted" { Closed(f.detail) }
  else { Engine(if f.name == "" { f.kind } else { f.name }, f.detail) }

/// The SQL functions a statement may call, in order.
pub fn functions() -> List<String> / {abort.raise} =
  parts(sqlite_functions()).map(|name: Bytes| String::of_bytes_lossy(name))

// --- A statement and its parameters ------------------------------------------------------

/// A statement the parser has accepted, with the values bound to its `?1`, `?2`.
pub opaque type Bound = | Bound(String, List<Scalar>)

/// `bare_statement` with `ps` bound to its placeholders, in order. Raises `Refused` for a statement
/// the parser rejects and for a parameter type SQLite does not store.
pub fn bound(bare_statement: Statement, ps: List<Param>) -> Bound / {sql.fail, abort.raise} =
  match scan_statement(Sqlite, bare_statement.sql) {
    Err(e) -> sql.fail(Refused(e.detail)),
    Ok(_) -> Bound(bare_statement.sql, scalars(ps)),
  }

/// The statement in a `Bound`.
pub fn statement(b: Bound) -> Statement = match b { Bound(sql, _) -> stmt(sql) }

/// Checks a tagged literal with no holes, such as `sqlite"select count(*) from t"`, when the
/// program is checked.
pub fn literal(text: String) -> Result<Bound, { message: String, offset: Int }> / {abort.raise} =
  match compile([text]) {
    Ok(bare_statement) -> Ok(Bound(bare_statement.sql, [])),
    Err(e) -> Err({ message: e.message, offset: e.offset }),
  }

/// The statement made from a tagged literal's texts, with each hole between two of them written
/// `?1`, `?2`. It is parsed when the program is checked, and rejected there if the parser rejects
/// it.
pub fn compile(
  texts: List<String>,
) -> Result<Statement, { message: String, offset: Int, part: Int }> / {abort.raise} = {
  let sql = range(0, texts.len()).fold("", |acc: String, i: Int|
    match texts.at(i) {
      Some(text) -> if i == 0 { text } else { acc ++ "?" ++ i.to_string() ++ text },
      None -> acc,
    });
  match scan_statement(Sqlite, sql) {
    Ok(_) -> Ok(stmt(sql)),
    Err(e) -> Err(error_in_part(texts, refusal_byte(e).unwrap_or(0), e.detail)),
  }
}

/// A tagged literal's statement with its holes bound, each a `Param`.
pub fn fill(c: Statement, holes: List<Param>) -> Bound / {sql.fail} = Bound(c.sql, scalars(holes))

type PartSearch = { begins: Int, part: Int, offset: Int, found: Bool }

/// Locates byte `at` of the statement the texts make: the text it is in, and the number of
/// characters before it there. A byte in a hole's `?n` counts as the end of the text before the
/// hole.
fn error_in_part(
  texts: List<String>,
  at: Int,
  message: String,
) -> { message: String, offset: Int, part: Int } / {abort.raise} = {
  let last = range(0, texts.len()).fold(
    { begins: 0, part: 0, offset: 0, found: false },
    |bare_statement: PartSearch, i: Int| {
      let text = Bytes::of_string(texts.at(i).unwrap_or(""));
      let begins = bare_statement.begins + (if i == 0 { 0 } else { 1 + i.to_string().len() });
      let ends = begins + text.len();
      if bare_statement.found { bare_statement } else if at > ends {
        { begins: ends, part: i, offset: character_count(text, text.len()), found: false }
      } else { { begins: ends, part: i, offset: character_count(text, at - begins), found: true } }
    },
  );
  { message: message, offset: last.offset, part: last.part }
}

/// How many characters the first `n` bytes of `text` contain.
fn character_count(text: Bytes, n: Int) -> Int / {abort.raise} =
  if n <= 0 { 0 } else { String::of_bytes(text.slice(0, min(n, text.len()))).chars().len() }

fn scalars(ps: List<Param>) -> List<Scalar> / {sql.fail} =
  range(0, ps.len()).map(|i: Int|
    match ps.at(i) { Some(p) -> scalar_of(p, i + 1), None -> null_scalar() })

fn null_scalar() -> Scalar = { kind: 0, int: 0, real: 0.0, bytes: b"" }

fn scalar_of(p: Param, place: Int) -> Scalar / {sql.fail} =
  match p {
    NullParameter -> null_scalar(),
    IntParameter(n) -> { kind: 1, int: n, real: 0.0, bytes: b"" },
    BoolParameter(b) -> { kind: 1, int: if b { 1 } else { 0 }, real: 0.0, bytes: b"" },
    FloatParameter(x) -> { kind: 2, int: 0, real: x, bytes: b"" },
    TextParameter(bare_statement) ->
      { kind: 3, int: 0, real: 0.0, bytes: Bytes::of_string(bare_statement) },
    BytesParameter(b) -> { kind: 4, int: 0, real: 0.0, bytes: b },
    NumericParameter(_) -> unbindable(place, "PNumeric", "a `Decimal`"),
    JsonParameter(_) -> unbindable(place, "PJson", "JSON"),
    ArrayParameter(_) -> unbindable(place, "PArray", "an array"),
  }

fn unbindable<a>(place: Int, name: String, what: String) -> a / {sql.fail} =
  sql.fail(
    Refused(
      "parameter " ++ place.to_string() ++ " is a `" ++ name
        ++ "`, and SQLite stores null, integers, floats, text and bytes: encode "
        ++ what
        ++ " as a `PText` or a `PInt`",
    ),
  )

/// A column's value as `std.sql` writes one.
fn datum_of(bare_statement: Scalar) -> Datum / {abort.raise} =
  if bare_statement.kind == 1 { IntDatum(bare_statement.int) }
  else if bare_statement.kind == 2 { FloatDatum(bare_statement.real) }
  else if bare_statement.kind == 3 { TextDatum(String::of_bytes(bare_statement.bytes)) }
  else if bare_statement.kind == 4 { BytesDatum(bare_statement.bytes) }
  else { NullDatum }

/// The rows of a reply, each keyed by column name. Two columns with one name would be one entry,
/// so a statement that returns them is rejected: name each with `as`.
fn rows_of(columns: List<String>, rows: List<List<Scalar>>) -> List<Row> / {sql.fail, abort.raise} = {
  let names = columns.fold(Map::new(), |seen: Map<String, Unit>, c: String| seen.insert(c, ()));
  if names.len() != columns.len() {
    sql.fail(
      Refused(
        "the statement answers two columns of one name, and a row is read by name: name each with `as`",
      ),
    )
  } else {
    rows.map(|row: List<Scalar>|
      range(0, columns.len()).fold(Map::new(), |acc: Row, i: Int|
        match ((columns.at(i), row.at(i))) {
          (Some(name), Some(value)) -> acc.insert(name, datum_of(value)),
          _ -> acc,
        }))
  }
}

fn raise_on_failure(r: Reply) -> Reply / {sql.fail} =
  match r.failure { None -> r, Some(f) -> sql.fail(refusal_of(f)) }

// --- A connection ------------------------------------------------------------------------

/// An open database under the root `d`. It is useless once its `with_scope` has closed it: any
/// operation on it then raises `Closed`.
pub opaque type Connection<[d]> = | Connection(Int)

/// Opens the database at `path` under the root `d` with `mode` and `options`. A `with_scope`
/// acquires a connection with this. Raises `Unopened` when the database does not open.
pub fn opening<[d]>(
  path: String,
  mode: Mode,
  options: Options,
) -> Connection<[d]> / {sqlite.open[d], sql.fail} =
  match sqlite.open[d](path, mode, options) {
    Ok(conn) -> Connection(conn),
    Err(f) -> sql.fail(refusal_of(f)),
  }

/// Closes a connection, rolling back any transaction it left open. A `with_scope` over a connection
/// releases it with this, written `|c| sqlite::close(c)`.
pub fn close<[d]>(c: Connection<[d]>) -> Unit / {sqlite.close[d]} =
  match c {
    Connection(conn) -> {
      sqlite.close[d](conn);
      ()
    },
  }

fn connection_number<[d]>(c: Connection<[d]>) -> Int = match c { Connection(conn) -> conn }

/// The rows a read-only statement returns. Raises `Refused` for a statement that could write.
pub fn query<[d], [r]>(
  conn: Scoped<Connection<[d]>, [r]>,
  q: Bound,
  limits: Limits,
) -> List<Row> / {scoped.read[r], sqlite.query[d], sql.fail, abort.raise} =
  match q {
    Bound(sql, params) -> {
      let reply = raise_on_failure(
        sqlite.query[d](connection_number(conn.get()), sql, params, limits),
      );
      rows_of(reply.columns, reply.rows)
    },
  }

/// What a write did: the number of rows the statement itself changed, not counting a trigger's,
/// and the row id of the last row it inserted, or 0 when it inserted none.
pub type ExecuteResult = { rows: Int, last_row_id: Int }

/// Runs a statement that writes, including a schema statement.
pub fn execute<[d], [r]>(
  conn: Scoped<Connection<[d]>, [r]>,
  q: Bound,
  limits: Limits,
) -> ExecuteResult / {scoped.read[r], sqlite.execute[d], sql.fail} =
  match q {
    Bound(sql, params) -> {
      let reply = raise_on_failure(
        sqlite.execute[d](connection_number(conn.get()), sql, params, limits),
      );
      { rows: reply.changed, last_row_id: reply.last_row_id }
    },
  }

/// Runs a statement that writes and returns rows, as one with `returning` does.
pub fn returning<[d], [r]>(
  conn: Scoped<Connection<[d]>, [r]>,
  q: Bound,
  limits: Limits,
) -> List<Row> / {scoped.read[r], sqlite.execute[d], sql.fail, abort.raise} =
  match q {
    Bound(sql, params) -> {
      let reply = raise_on_failure(
        sqlite.execute[d](connection_number(conn.get()), sql, params, limits),
      );
      rows_of(reply.columns, reply.rows)
    },
  }

/// A statement's result in `std.sql`'s form: `Rows` when it returns columns, otherwise `Count` of
/// the rows it changed, and `Failed` in place of a raise, with a `Failure`'s `kind` as its `code`
/// and the `name` as its `constraint`.
pub fn run<[d], [r]>(
  conn: Scoped<Connection<[d]>, [r]>,
  q: Bound,
  limits: Limits,
) -> QueryResult / {scoped.read[r], sqlite.execute[d], abort.raise} =
  match q {
    Bound(sql, params) -> {
      let reply = sqlite.execute[d](connection_number(conn.get()), sql, params, limits);
      match reply.failure {
        Some(f) -> Failed({ code: f.kind, constraint: f.name, detail: f.detail }),
        None -> if reply.columns.len() == 0 { Count(reply.changed) } else {
          match try { rows_of(reply.columns, reply.rows) } {
            Ok(rows) -> Rows(rows),
            Err(_) ->
              Failed({
                code: "refused",
                constraint: "",
                detail: "the statement answers two columns of one name",
              }),
          }
        },
      }
    },
  }

/// Runs `body` inside a transaction that holds the write lock from the start, so nothing in it
/// waits on a lock again. The transaction commits when the body returns. It rolls back when the
/// body raises, when a handler clause unwinds through it, or when its task is cancelled. Inside
/// another transaction it is a savepoint, which rolls back on its own. Raises `Busy` when another
/// connection holds the lock past the wait. On a connection opened to read, it takes no lock and
/// is a `snapshot`.
pub fn transaction<a, [d], [r] | e>(
  conn: Scoped<Connection<[d]>, [r]>,
  body: () -> a / e,
) -> a / {scoped.read[r], sqlite.control[d], sql.fail | e} =
  in_transaction[d](connection_number(conn.get()), Begin, body)

/// Runs `body` inside a transaction that only reads: every query in it sees the database as it was
/// at the first query. A write in it raises `Busy` if another connection has written since.
pub fn snapshot<a, [d], [r] | e>(
  conn: Scoped<Connection<[d]>, [r]>,
  body: () -> a / e,
) -> a / {scoped.read[r], sqlite.control[d], sql.fail | e} =
  in_transaction[d](connection_number(conn.get()), BeginRead, body)

fn in_transaction<a, [d] | e>(
  conn: Int,
  opens: Control,
  body: () -> a / e,
) -> a / {sqlite.control[d], sql.fail | e} = {
  raise_on_failure(sqlite.control[d](conn, opens));
  handle {
    bracket(
      || (),
      |_u: Unit|
        if !scope_end.ended() {
          sqlite.control[d](conn, Rollback);
          ()
        },
      |_u: Unit| {
        let value = body();
        // Whatever the commit returns, its scope is closed.
        scope_end.end();
        raise_on_failure(sqlite.control[d](conn, Commit));
        value
      },
    )
  } with {
    var ended = false,
    scope_end.end() -> {
      ended = true;
    },
    scope_end.ended() -> ended,
  }
}

/// Whether a transaction's body got as far as its commit. The release step reads it.
effect scope_end {
  write end() -> Unit
  read ended() -> Bool
}

/// Folds `f` over each row a read-only statement returns, fetched `page` rows at a time, so only
/// one page of a large result is in memory at once. `limits.rows` is the most rows it folds over;
/// past that it raises `LimitExceeded`. `limits.bytes` limits each page. Nothing else runs on the
/// connection during the fold: `f` reads from another connection, or collects what it will write
/// later.
pub fn fold_rows<a, [d], [r] | e>(
  conn: Scoped<Connection<[d]>, [r]>,
  q: Bound,
  limits: Limits,
  page: Int,
  init: a,
  f: (a, Row) -> a / e,
) -> a / {scoped.read[r], sqlite.cursor[d], sqlite.fetch[d], sqlite.finish[d], sql.fail, abort.raise | e} =
  match q {
    Bound(sql, params) -> {
      let id = connection_number(conn.get());
      if page < 1 { panic("a page is at least one row") } else {
        bracket(
          || raise_on_failure(sqlite.cursor[d](id, sql, params, limits)).columns,
          |_c: List<String>| {
            sqlite.finish[d](id);
            ()
          },
          |columns: List<String>|
            iterate(init, max(limits.rows, 0) / page + 2, |acc: a| {
              let got = raise_on_failure(sqlite.fetch[d](id, page));
              let next = rows_of(columns, got.rows).fold(acc, f);
              if got.rows.len() < page { Stop(next) } else { Continue(next) }
            }),
        )
      }
    },
  }

/// Writes a compacted copy of the database to `path` under the same root, where no file may exist
/// yet: `VACUUM INTO`. The copy is a separate database, consistent even if others write meanwhile.
/// Raises `Malformed` inside a transaction, where the engine cannot copy.
pub fn backup<[d], [r]>(
  conn: Scoped<Connection<[d]>, [r]>,
  path: String,
) -> Unit / {scoped.read[r], sqlite.backup[d], sql.fail} = {
  raise_on_failure(sqlite.backup[d](connection_number(conn.get()), path));
  ()
}

// --- Reading a row -----------------------------------------------------------------------

fn column_value(row: Row, column: String) -> Datum / {sql.fail} =
  match row.get(column) {
    Some(value) -> value,
    None -> sql.fail(Mistyped(column, "a column of the answer")),
  }

/// The integer in `column`. Raises `Mistyped` for anything else, including null and a missing
/// column.
pub fn int(row: Row, column: String) -> Int / {sql.fail} =
  match column_value(row, column) {
    IntDatum(n) -> n,
    _ -> sql.fail(Mistyped(column, "an integer")),
  }

/// The float in `column`. An integer is not a float: a `STRICT` table's `REAL` column returns
/// floats, and an expression can be cast.
pub fn float(row: Row, column: String) -> Float / {sql.fail} =
  match column_value(row, column) { FloatDatum(x) -> x, _ -> sql.fail(Mistyped(column, "a float")) }

/// The text in `column`.
pub fn text(row: Row, column: String) -> String / {sql.fail} =
  match column_value(row, column) {
    TextDatum(bare_statement) -> bare_statement,
    _ -> sql.fail(Mistyped(column, "text")),
  }

/// The bytes in `column`.
pub fn bytes(row: Row, column: String) -> Bytes / {sql.fail} =
  match column_value(row, column) { BytesDatum(b) -> b, _ -> sql.fail(Mistyped(column, "bytes")) }

/// `None` when `column` is null, and otherwise what `read` returns for it, as in
/// `optional(row, "note", sqlite::text)`.
pub fn optional<a | e>(
  row: Row,
  column: String,
  read: (Row, String) -> a / e,
) -> Option<a> / {sql.fail | e} =
  match column_value(row, column) { NullDatum -> None, _ -> Some(read(row, column)) }

// --- The host handler --------------------------------------------------------------------

host for sqlite by served

/// Runs `go`, opening each database under the root its label names on the machine. The calling
/// task waits for each operation.
fn served<a | e>(
  go: () -> a / {sqlite.read[*], sqlite.write[*] | e},
) -> a / {native.read, wait.read, abort.raise | e} =
  handle {
    go()
  } with {
    sqlite.open[*label](path, mode, options) -> {
      let takes_write_lock = sqlite_open(
        label,
        path,
        mode_number(mode),
        options.strict,
        options.busy_ms,
        options.statements,
      );
      let opened = decode_open_reply(job_wait(takes_write_lock));
      match opened { Ok(_) -> record_opened_files(label, path, mode), Err(_) -> () };
      opened
    },
    sqlite.close[*label](conn) -> job_wait(sqlite_close(label, conn)) == b"\x01",
    sqlite.query[*label](conn, sql, params, limits) ->
      decode_reply(
        job_wait(sqlite_query(label, conn, sql, encode_scalars(params), encode_limits(limits))),
      ),
    sqlite.execute[*label](conn, sql, params, limits) ->
      decode_reply(
        job_wait(sqlite_execute(label, conn, sql, encode_scalars(params), encode_limits(limits))),
      ),
    sqlite.control[*label](conn, step) ->
      decode_reply(job_wait(sqlite_control(label, conn, step_number(step)))),
    sqlite.backup[*label](conn, path) -> {
      let reply = decode_reply(job_wait(sqlite_backup(label, conn, path)));
      match reply.failure { None -> observed(label, path, 4), Some(_) -> () };
      reply
    },
    sqlite.cursor[*label](conn, sql, params, limits) ->
      decode_reply(
        job_wait(sqlite_cursor(label, conn, sql, encode_scalars(params), encode_limits(limits))),
      ),
    sqlite.fetch[*label](conn, rows) -> decode_reply(job_wait(sqlite_fetch(label, conn, rows))),
    sqlite.finish[*label](conn) -> job_wait(sqlite_finish(label, conn)) == b"\x01",
  }

/// The ticket for opening the database at `path` under the root `label` names, in the mode
/// `mode_number` numbers.
extern fn sqlite_open(
  label: String,
  path: String,
  mode: Int,
  strict: Bool,
  busy_ms: Int,
  statements: Int,
) -> Int / {native.read}

/// The ticket for closing a connection.
extern fn sqlite_close(label: String, conn: Int) -> Int / {native.read}

/// The ticket for running a read-only statement, with its values and limits encoded.
extern fn sqlite_query(
  label: String,
  conn: Int,
  sql: String,
  params: Bytes,
  limits: Bytes,
) -> Int / {native.read}

/// The ticket for running a statement that may write, with its values and limits encoded.
extern fn sqlite_execute(
  label: String,
  conn: Int,
  sql: String,
  params: Bytes,
  limits: Bytes,
) -> Int / {native.read}

/// The ticket for opening a statement to be fetched a page at a time.
extern fn sqlite_cursor(
  label: String,
  conn: Int,
  sql: String,
  params: Bytes,
  limits: Bytes,
) -> Int / {native.read}

/// The ticket for a step of a connection's transaction, numbered by `step_number`.
extern fn sqlite_control(label: String, conn: Int, step: Int) -> Int / {native.read}

/// The ticket for writing a compacted copy of a connection's database to `path`.
extern fn sqlite_backup(label: String, conn: Int, path: String) -> Int / {native.read}

/// The ticket for fetching the next `rows` rows of a connection's open statement.
extern fn sqlite_fetch(label: String, conn: Int, rows: Int) -> Int / {native.read}

/// The ticket for ending a connection's open statement.
extern fn sqlite_finish(label: String, conn: Int) -> Int / {native.read}

fn mode_number(mode: Mode) -> Int = match mode { ReadOnly -> 0, ReadWrite -> 1, Create -> 2 }

/// Records, for an observed test, the files that opening the database at `path` touches. A
/// read-only open reads the file and the log beside it. Otherwise it may write all of them,
/// including the files the engine keeps beside the database.
fn record_opened_files(label: String, path: String, mode: Mode) -> Unit / {native.read} =
  match mode {
    ReadOnly -> {
      observed(label, path, 0);
      observed(label, path ++ "-wal", 0)
    },
    _ ->
      ["", "-journal", "-wal", "-shm"].fold((), |u: Unit, suffix: String|
        observed(label, path ++ suffix, 4)),
  }

fn step_number(step: Control) -> Int =
  match step { Begin -> 0, BeginRead -> 1, Commit -> 2, Rollback -> 3 }

/// A value encoded as the native functions read it: its kind's byte, then a number's eight bytes or
/// the contents of the text or bytes.
fn encode_scalar(bare_statement: Scalar) -> Bytes =
  match bare_statement.kind {
    1 -> b"\x01".concat(i64_be(bare_statement.int)),
    2 -> b"\x02".concat(i64_be(bits_of_float(bare_statement.real))),
    3 -> b"\x03".concat(bare_statement.bytes),
    4 -> b"\x04".concat(bare_statement.bytes),
    _ -> b"\x00",
  }

fn encode_scalars(params: List<Scalar>) -> Bytes = encode_parts(params.map(encode_scalar))

fn encode_limits(l: Limits) -> Bytes =
  Bytes::concat_all([l.sql_bytes, l.params, l.rows, l.bytes, l.steps].map(i64_be))

fn decode_scalar(flat: Bytes) -> Scalar / {abort.raise} = {
  let rest = flat.slice(1, flat.len());
  match flat.at(0) {
    1 -> { kind: 1, int: decode_int(rest), real: 0.0, bytes: b"" },
    2 -> { kind: 2, int: 0, real: Float::of_bits(decode_int(rest)), bytes: b"" },
    3 -> { kind: 3, int: 0, real: 0.0, bytes: rest },
    4 -> { kind: 4, int: 0, real: 0.0, bytes: rest },
    _ -> null_scalar(),
  }
}

fn decode_failure(flat: Bytes) -> Failure / {abort.raise} =
  match parts(flat) {
    [kind, name, detail] ->
      {
        kind: String::of_bytes_lossy(kind),
        name: String::of_bytes_lossy(name),
        detail: String::of_bytes_lossy(detail),
      },
    _ -> panic("a database native wrote no failure"),
  }

/// Decodes the reply to opening a database: byte 1 and the connection's number, or byte 0 and why
/// it failed.
fn decode_open_reply(encoded: Bytes) -> Result<Int, Failure> / {abort.raise} = {
  let rest = encoded.slice(1, encoded.len());
  if encoded.at(0) == 1 { Ok(decode_int(rest)) } else { Err(decode_failure(rest)) }
}

/// Decodes a reply as the native functions write it: parts for the columns, the rows, whether it
/// could have written, the rows it changed, the row id it last inserted, and its failure encoded
/// for `found`.
fn decode_reply(encoded: Bytes) -> Reply / {abort.raise} =
  match parts(encoded) {
    [columns, rows, wrote, changed, last_row_id, failure] ->
      {
        columns: parts(columns).map(|c: Bytes| String::of_bytes_lossy(c)),
        rows: parts(rows).map(|row: Bytes| parts(row).map(decode_scalar)),
        wrote: wrote == b"\x01",
        changed: decode_int(changed),
        last_row_id: decode_int(last_row_id),
        failure: match found(failure) { Some(f) -> Some(decode_failure(f)), None -> None },
      },
    _ -> panic("a database native wrote no reply"),
  }

// --- The fake ----------------------------------------------------------------------------

/// A statement a fold has open: the rows it returned, how many were fetched, and each page's limit
/// in bytes.
type OpenCursor = { rows: List<List<Scalar>>, at: Int, bytes: Int }

/// A fake's connection. `saved` stores the image each open transaction and savepoint rolls back
/// to, outermost first, and `working` is the image the transaction has made. `base` is the image
/// it began from, and `writes` is whether it holds the write lock.
type FakeConnection = {
  path: String,
  mode: Mode,
  strict: Bool,
  saved: List<Bytes>,
  working: Bytes,
  base: Bytes,
  writes: Bool,
  folding: Option<OpenCursor>,
}

type Twin = {
  files: Map<String, Bytes>,
  open: Map<Int, FakeConnection>,
  writer: Map<String, Int>,
  next: Int,
}

type FakeStep = { twin: Twin, reply: Reply }

/// The databases of one root, in memory: each path's bytes as a file would contain them, and the
/// connections open on them.
pub opaque type Memory = | Memory(Twin)

/// A root with no databases.
pub fn memory() -> Memory =
  Memory({ files: Map::new(), open: Map::new(), writer: Map::new(), next: 1 })

/// The bytes of the database at `path`, as a file would contain them: the last committed state.
pub fn database_bytes(m: Memory, path: String) -> Option<Bytes> =
  match m { Memory(t) -> t.files.get(path) }

/// `m` with the database at `path` set to `image`, a database file's bytes.
pub fn with_database_bytes(m: Memory, path: String, image: Bytes) -> Memory =
  match m { Memory(t) -> Memory({ ..t, files: t.files.insert(path, image) }) }

/// What `go` returned with a fake, and the fake's final state.
pub type RunResult<a> = { value: a, memory: Memory }

/// Runs `go` with `m` as the root its effect row names, handling every operation with the engine
/// on an image in memory. It performs no effects, so a test or a law that uses it needs no root
/// and is cached. A path that leaves the root raises with `E0452`'s message.
pub fn on_memory<a, [d] | e>(
  m: Memory,
  go: () -> a / {sqlite.read[d], sqlite.write[d] | e},
) -> RunResult<a> / {abort.raise | e bounded} =
  handle {
    go()
  } with {
    var t = match m { Memory(t) -> t },
    sqlite.open[d](path, mode, options) -> {
      let opened = twin_open(t, path, mode, options);
      t = opened.twin;
      opened.conn
    },
    sqlite.close[d](conn) -> {
      let now = t;
      t = twin_close(now, conn);
      now.open.contains(conn)
    },
    sqlite.query[d](conn, sql, params, limits) -> {
      let bare_statement = twin_run(t, conn, sql, params, limits, true);
      t = bare_statement.twin;
      bare_statement.reply
    },
    sqlite.execute[d](conn, sql, params, limits) -> {
      let bare_statement = twin_run(t, conn, sql, params, limits, false);
      t = bare_statement.twin;
      bare_statement.reply
    },
    sqlite.control[d](conn, step) -> {
      let bare_statement = twin_control(t, conn, step);
      t = bare_statement.twin;
      bare_statement.reply
    },
    sqlite.backup[d](conn, path) -> {
      let bare_statement = twin_backup(t, conn, path);
      t = bare_statement.twin;
      bare_statement.reply
    },
    sqlite.cursor[d](conn, sql, params, limits) -> {
      let bare_statement = twin_cursor(t, conn, sql, params, limits);
      t = bare_statement.twin;
      bare_statement.reply
    },
    sqlite.fetch[d](conn, rows) -> {
      let bare_statement = twin_fetch(t, conn, rows);
      t = bare_statement.twin;
      bare_statement.reply
    },
    sqlite.finish[d](conn) -> {
      let now = t;
      match now.open.get(conn) {
        Some(o) -> {
          t = { ..now, open: now.open.insert(conn, { ..o, folding: None }) };
          o.folding != None
        },
        None -> false,
      }
    },
    return value -> { value: value, memory: Memory(t) },
  }

/// Runs `go` over a root with no databases yet: what a test gives to code written against a root.
pub fn in_memory<a, [d] | e>(
  go: () -> a / {sqlite.read[d], sqlite.write[d] | e},
) -> a / {abort.raise | e bounded} = on_memory[d](memory(), go).value

fn empty_reply() -> Reply =
  { columns: [], rows: [], wrote: false, changed: 0, last_row_id: 0, failure: None }

fn failure_reply(kind: String, name: String, detail: String) -> Reply =
  { ..empty_reply(), failure: Some({ kind: kind, name: name, detail: detail }) }

fn no_connection_reply() -> Reply =
  failure_reply("closed", "", "no connection is open under this number")

fn busy_reply() -> Reply = failure_reply("busy", "", "database is locked")

fn cursor_open_reply() -> Reply =
  failure_reply(
    "refused",
    "",
    "a fold is reading this connection: nothing else runs on it until the fold ends",
  )

fn confined(path: String) -> String / {abort.raise} =
  if fs::mem_confined(path) { path } else { panic("`" ++ path ++ "` leaves the root it was given") }

fn committed(t: Twin, path: String) -> Bytes = t.files.get(path).unwrap_or(b"")

/// The image a connection's next statement runs on: its transaction's, or the last committed one.
fn image_of(t: Twin, o: FakeConnection) -> Bytes =
  if o.saved.len() > 0 { o.working } else { committed(t, o.path) }

fn written_by_another(t: Twin, path: String, conn: Int) -> Bool =
  match t.writer.get(path) { Some(holder) -> holder != conn, None -> false }

fn twin_open(
  t: Twin,
  path: String,
  mode: Mode,
  options: Options,
) -> { twin: Twin, conn: Result<Int, Failure> } / {abort.raise} = {
  let at = confined(path);
  if mode != Create && !t.files.contains(at) {
    { twin: t, conn: Err({ kind: "unopened", name: "", detail: "unable to open database file" }) }
  } else {
    let files = if t.files.contains(at) { t.files } else { t.files.insert(at, b"") };
    let opened = {
      path: at,
      mode: mode,
      strict: options.strict,
      saved: [],
      working: b"",
      base: b"",
      writes: false,
      folding: None,
    };
    {
      twin: { ..t, files: files, open: t.open.insert(t.next, opened), next: t.next + 1 },
      conn: Ok(t.next),
    }
  }
}

fn twin_close(t: Twin, conn: Int) -> Twin =
  match t.open.get(conn) {
    None -> t,
    Some(o) -> { ..unlocked(t, o, conn), open: t.open.remove(conn) },
  }

/// `t` with the write lock on a connection's database released, if the connection holds it.
fn unlocked(t: Twin, o: FakeConnection, conn: Int) -> Twin =
  if t.writer.get(o.path) == Some(conn) { { ..t, writer: t.writer.remove(o.path) } } else { t }

/// What one statement on an image returned, and the image it left, which is the one passed in when
/// it failed or only read.
type StatementResult = { image: Bytes, reply: Reply }

/// Runs `sql` on the database in `image`, as `sqlite_run` runs it.
fn run_on_image(
  image: Bytes,
  sql: String,
  params: List<Scalar>,
  reads_only: Bool,
  strict: Bool,
  limits: Limits,
) -> StatementResult / {abort.raise} =
  match parts(
      sqlite_run(image, sql, encode_scalars(params), reads_only, strict, encode_limits(limits)),
    ) {
    [left, reply] -> { image: found(left).unwrap_or(image), reply: decode_reply(reply) },
    _ -> panic("the twin's engine wrote no reply"),
  }

fn twin_run(
  t: Twin,
  conn: Int,
  sql: String,
  params: List<Scalar>,
  limits: Limits,
  querying: Bool,
) -> FakeStep / {abort.raise} =
  match t.open.get(conn) {
    None -> { twin: t, reply: no_connection_reply() },
    Some(o) -> if o.folding != None { { twin: t, reply: cursor_open_reply() } } else {
      let ran = run_on_image(
        image_of(t, o),
        sql,
        params,
        querying || o.mode == ReadOnly,
        o.strict,
        limits,
      );
      match ran.reply.failure {
        Some(f) -> if f.kind == "writes" && !querying {
          {
            twin: t,
            reply: failure_reply(
              "read_only",
              "",
              "this statement writes, and the connection was opened to read",
            ),
          }
        } else { { twin: t, reply: ran.reply } },
        None -> if ran.reply.wrote { fake_apply_write(t, conn, o, ran.image, ran.reply) }
        else { { twin: t, reply: ran.reply } },
      }
    },
  }

/// Stores the result of a statement that wrote. When another connection holds the write lock, or
/// has written since this one's transaction began reading, the result is `busy` and nothing is
/// stored.
fn fake_apply_write(t: Twin, conn: Int, o: FakeConnection, image: Bytes, reply: Reply) -> FakeStep =
  if written_by_another(t, o.path, conn) { { twin: t, reply: busy_reply() } }
  else if o.saved.len() == 0 {
    { twin: { ..t, files: t.files.insert(o.path, image) }, reply: reply }
  } else if !o.writes && committed(t, o.path) != o.base { { twin: t, reply: busy_reply() } } else {
    {
      twin: {
        ..t,
        open: t.open.insert(conn, { ..o, working: image, writes: true }),
        writer: t.writer.insert(o.path, conn),
      },
      reply: reply,
    }
  }

fn twin_control(t: Twin, conn: Int, step: Control) -> FakeStep =
  match t.open.get(conn) {
    None -> { twin: t, reply: no_connection_reply() },
    Some(o) -> if o.folding != None { { twin: t, reply: cursor_open_reply() } } else {
      match step {
        Begin -> twin_begin(t, conn, o, true),
        BeginRead -> twin_begin(t, conn, o, false),
        Commit -> twin_end(t, conn, o, true),
        Rollback -> twin_end(t, conn, o, false),
      }
    },
  }

/// `takes_write_lock` is whether the write lock was requested. A connection opened to read never
/// takes it: its transaction only reads, as the engine's does.
fn twin_begin(t: Twin, conn: Int, o: FakeConnection, takes_write_lock: Bool) -> FakeStep = {
  let writes = takes_write_lock && o.mode != ReadOnly;
  if o.saved.len() >= 32 {
    { twin: t, reply: failure_reply("refused", "", "a connection nests 32 transactions at most") }
  } else if o.saved.len() > 0 {
    {
      twin: { ..t, open: t.open.insert(conn, { ..o, saved: o.saved.push(o.working) }) },
      reply: empty_reply(),
    }
  } else if writes && written_by_another(t, o.path, conn) { { twin: t, reply: busy_reply() } }
  else {
    let image = committed(t, o.path);
    {
      twin: {
        ..t,
        open: t.open.insert(conn, {
          ..o,
          saved: [image],
          working: image,
          base: image,
          writes: writes,
        }),
        writer: if writes { t.writer.insert(o.path, conn) } else { t.writer },
      },
      reply: empty_reply(),
    }
  }
}

/// Closes the innermost scope: committed, or rolled back to the image it began from.
fn twin_end(t: Twin, conn: Int, o: FakeConnection, kept: Bool) -> FakeStep = {
  let depth = o.saved.len();
  if depth == 0 { { twin: t, reply: failure_reply("refused", "", "no transaction is open") } }
  else if depth > 1 {
    let outer = o.saved.slice(0, depth - 1);
    let working = if kept { o.working } else { o.saved.at(depth - 1).unwrap_or(o.working) };
    {
      twin: { ..t, open: t.open.insert(conn, { ..o, saved: outer, working: working }) },
      reply: empty_reply(),
    }
  } else {
    let files = if kept && o.writes { t.files.insert(o.path, o.working) } else { t.files };
    let ended = { ..o, saved: [], working: b"", base: b"", writes: false };
    {
      twin: { ..unlocked(t, o, conn), files: files, open: t.open.insert(conn, ended) },
      reply: empty_reply(),
    }
  }
}

fn twin_backup(t: Twin, conn: Int, path: String) -> FakeStep / {abort.raise} =
  match t.open.get(conn) {
    None -> { twin: t, reply: no_connection_reply() },
    Some(o) -> {
      let to = confined(path);
      if o.folding != None { { twin: t, reply: cursor_open_reply() } } else if o.saved.len() > 0 {
        {
          twin: t,
          reply: failure_reply("statement", "", "cannot VACUUM from within a transaction"),
        }
      } else if t.files.contains(to) {
        {
          twin: t,
          reply: failure_reply(
            "exists",
            "",
            "`" ++ path ++ "` is there already, and a backup writes a new file",
          ),
        }
      } else {
        { twin: { ..t, files: t.files.insert(to, committed(t, o.path)) }, reply: empty_reply() }
      }
    },
  }

fn twin_cursor(
  t: Twin,
  conn: Int,
  sql: String,
  params: List<Scalar>,
  limits: Limits,
) -> FakeStep / {abort.raise} =
  match t.open.get(conn) {
    None -> { twin: t, reply: no_connection_reply() },
    Some(o) -> if o.folding != None { { twin: t, reply: cursor_open_reply() } } else {
      // Fetch every row at once; each page's byte limit is enforced as it is fetched.
      let ran = run_on_image(image_of(t, o), sql, params, true, o.strict, {
        ..limits,
        bytes: 9223372036854775807,
      });
      match ran.reply.failure {
        Some(_) -> { twin: t, reply: ran.reply },
        None -> {
          let folding = Some({ rows: ran.reply.rows, at: 0, bytes: limits.bytes });
          {
            twin: { ..t, open: t.open.insert(conn, { ..o, folding: folding }) },
            reply: { ..empty_reply(), columns: ran.reply.columns },
          }
        },
      }
    },
  }

fn twin_fetch(t: Twin, conn: Int, rows: Int) -> FakeStep =
  match t.open.get(conn) {
    None -> { twin: t, reply: no_connection_reply() },
    Some(o) -> match o.folding {
      None -> { twin: t, reply: failure_reply("closed", "", "no fold is open on this connection") },
      Some(f) -> {
        let page = f.rows.slice(f.at, min(f.at + max(rows, 0), f.rows.len()));
        let size = page.fold(0, |n: Int, row: List<Scalar>|
          row.fold(n, |m: Int, bare_statement: Scalar|
            m
              + (if bare_statement.kind == 0 { 0 }
              else if bare_statement.kind < 3 { 8 }
              else { bare_statement.bytes.len() })));
        if size > f.bytes {
          { twin: t, reply: failure_reply("too_large", "bytes", "more than its caller allowed") }
        } else {
          let folding = Some({ ..f, at: f.at + page.len() });
          {
            twin: { ..t, open: t.open.insert(conn, { ..o, folding: folding }) },
            reply: { ..empty_reply(), rows: page },
          }
        }
      },
    },
  }

// --- Properties --------------------------------------------------------------------------

fn generous_limits() -> Limits =
  { sql_bytes: 10000, params: 100, rows: 1000, bytes: 1000000, steps: 100000 }

fn strict_options() -> Options = { strict: true, busy_ms: 0, statements: 16 }

/// What a column of any type contains after `p` is written to it, read back through the engine.
fn kept(p: Param) -> Datum / {abort.raise} = {
  let read = try {
    in_memory[scratch](||
      with_scope[kept_value](opening[scratch]("v.db", Create, strict_options()), |c|
        close(c)) { conn -> {
        execute(conn, bound(stmt("create table v (x any) strict"), []), generous_limits());
        execute(conn, bound(stmt("insert into v (x) values (?1)"), [p]), generous_limits());
        column_value(
          query(conn, bound(stmt("select x from v"), []), generous_limits()).at(0).unwrap_or(
            Map::new(),
          ),
          "x",
        )
      } })
  };
  match read { Ok(d) -> d, Err(_) -> panic("a value was refused") }
}

test "a float written is the float read, and a NaN is stored as null" {
  gen::check(gen::float(), |p: Float|
    agrees(
      |x: Float| kept(FloatParameter(x)),
      |x: Float| if x != x { NullDatum } else { FloatDatum(x) },
      p,
    ))
}

/// The integers a table contains after `ns` are inserted in a transaction that then raises.
fn after_a_failed_transaction(ns: List<Int>) -> List<Int> / {abort.raise} = {
  let read = try {
    in_memory[scratch](||
      with_scope[rolled_back](opening[scratch]("t.db", Create, strict_options()), |c|
        close(c)) { conn -> {
        execute(conn, bound(stmt("create table t (n integer) strict"), []), generous_limits());
        execute(conn, bound(stmt("insert into t (n) values (7)"), []), generous_limits());
        let gave_up: Result<Unit, Error> = try {
          transaction(conn, || {
            ns.map(|n: Int|
              execute(
                conn,
                bound(stmt("insert into t (n) values (?1)"), [IntParameter(n)]),
                generous_limits(),
              ));
            sql.fail(Closed("the body gave up"))
          })
        };
        query(conn, bound(stmt("select n from t order by rowid"), []), generous_limits()).map(
          |row: Row| int(row, "n"),
        )
      } })
  };
  match read { Ok(column_value) -> column_value, Err(_) -> panic("the table was not read") }
}

test "a transaction whose body raises changes nothing" {
  gen::check(gen::list(gen::any_int()), |x: List<Int>|
    agrees(after_a_failed_transaction, |_: List<Int>| [7], x))
}

/// How many rows a query limited to `limit` returns from a table of `column_value` rows, or -1 when
/// it is rejected.
fn rows_returned(column_value: Int, limit: Int) -> Int / {abort.raise} = {
  let read = try {
    in_memory[scratch](||
      with_scope[limited](opening[scratch]("t.db", Create, strict_options()), |c|
        close(c)) { conn -> {
        execute(conn, bound(stmt("create table t (n integer) strict"), []), generous_limits());
        execute(
          conn,
          bound(
            stmt(
              "with recursive c(i) as (select 1 union all select i + 1 from c where i < ?1) insert into t select i from c where ?1 > 0",
            ),
            [IntParameter(column_value)],
          ),
          generous_limits(),
        );
        query(conn, bound(stmt("select n from t"), []), { ..generous_limits(), rows: limit }).len()
      } })
  };
  match read { Ok(n) -> n, Err(_) -> -1 }
}

// Each input is reduced to 0 to 23, so a law over every integer reads small tables.
test "a query returns every row within its limit, and is rejected past it" {
  gen::check(
    gen::map2(gen::any_int(), gen::any_int(), |column_value: Int, limit: Int|
      { held: column_value, limit: limit }),
    |x: { held: Int, limit: Int }|
      agrees(
        |c: { held: Int, limit: Int }|
          rows_returned(rem_euclid(c.held, 24), rem_euclid(c.limit, 24)),
        |c: { held: Int, limit: Int }|
          if rem_euclid(c.held, 24) <= rem_euclid(c.limit, 24) { rem_euclid(c.held, 24) }
          else { -1 },
        x,
      ),
  )
}

fn clock_and_random_statements() -> List<String> =
  [
    "select random()",
    "select randomblob(4)",
    "select current_timestamp",
    "select current_date",
    "select current_time",
    "select datetime('now')",
    "select date()",
    "select strftime('%s', 'now')",
    "select time('12:00', 'localtime')",
  ]

/// Whether `bound` rejects the statement, before any connection is used.
fn refused_before_running(sql: String) -> Bool / {abort.raise} =
  match try { bound(stmt(sql), []) } { Err(Refused(_)) -> true, _ -> false }

test "a statement that reads the clock or draws a random number is rejected before it runs" {
  gen::check(gen::any_int(), |x: Int|
    agrees(
      |i: Int|
        refused_before_running(
          clock_and_random_statements().at(
            rem_euclid(i, clock_and_random_statements().len()),
          ).unwrap_or(
            "",
          ),
        ),
      |_: Int| true,
      x,
    ))
}

// --- Tests -------------------------------------------------------------------------------

fn bare_statement(sql: String) -> Bound / {sql.fail, abort.raise} = bound(stmt(sql), [])

fn numbers(rows: List<Row>, column: String) -> List<Int> / {sql.fail} =
  rows.map(|row: Row| int(row, column))

fn refusal<a | e>(go: () -> a / {sql.fail | e}) -> Option<Error> / e =
  match try[sql.fail] { go() } { Ok(_) -> None, Err(why) -> Some(why) }

test "a database written and closed is read back when it is opened again" {
  let wrote = over_twin(memory(), ||
    with_scope[first](opening[app]("data/app.db", Create, strict_options()), |c|
      close(c)) { conn -> {
      execute(
        conn,
        bare_statement("create table person (id integer primary key, name text not null) strict"),
        generous_limits(),
      );
      execute(
        conn,
        bound(stmt("insert into person (name) values (?1)"), [TextParameter("Ada")]),
        generous_limits(),
      )
    } });
  let left = match wrote { Ok(over) -> over, Err(_) -> panic("the database was not written") };
  assert_eq(left.value, { rows: 1, last_row_id: 1 });
  let names = in_twin(left.memory, ||
    with_scope[second](opening[app]("data/app.db", ReadOnly, strict_options()), |c|
      close(c)) { conn ->
      query(conn, bare_statement("select id, name from person"), generous_limits()).map(
        |row: Row| text(row, "name"),
      )
    });
  assert_eq(names, Ok(["Ada"]))
}

fn over_twin<a>(
  m: Memory,
  go: () -> a / {sqlite.read[app], sqlite.write[app], sql.fail, abort.raise},
) -> Result<RunResult<a>, Error> / {abort.raise} = try[sql.fail] { on_memory[app](m, go) }

fn in_twin<a>(
  m: Memory,
  go: () -> a / {sqlite.read[app], sqlite.write[app], sql.fail, abort.raise},
) -> Result<a, Error> / {abort.raise} = try[sql.fail] { on_memory[app](m, go).value }

fn fresh<a>(
  go: () -> a / {sqlite.read[app], sqlite.write[app], sql.fail, abort.raise},
) -> Result<a, Error> / {abort.raise} = in_twin(memory(), go)

test "a database that does not exist opens only in Create mode" {
  assert_eq(
    fresh(||
      with_scope[missing](opening[app]("no.db", ReadWrite, strict_options()), |c|
        close(c)) { conn -> 1 }),
    Err(Unopened("unable to open database file")),
  );
  assert_eq(
    fresh(||
      with_scope[made](opening[app]("no.db", Create, strict_options()), |c| close(c)) { conn -> 1 }),
    Ok(1),
  )
}

test "each kind of value is read by its reader, and null through optional" {
  let read = fresh(||
    with_scope[typed](opening[app]("t.db", Create, strict_options()), |c| close(c)) { conn -> {
      execute(
        conn,
        bare_statement("create table v (i integer, r real, t text, b blob, n text) strict"),
        generous_limits(),
      );
      execute(
        conn,
        bound(stmt("insert into v values (?1, ?2, ?3, ?4, ?5)"), [
          IntParameter(-9223372036854775807 - 1),
          FloatParameter(1.5),
          TextParameter("a\0b \u{1F600}"),
          BytesParameter(b"\x00\xff"),
          NullParameter,
        ]),
        generous_limits(),
      );
      let rows = query(conn, bare_statement("select i, r, t, b, n from v"), generous_limits());
      let row = rows.at(0).unwrap_or(Map::new());
      {
        i: int(row, "i"),
        r: float(row, "r"),
        t: text(row, "t"),
        b: bytes(row, "b"),
        n: optional(row, "n", text),
        t_again: optional(row, "t", text),
        mistyped: refusal(|| int(row, "t")),
        missing: refusal(|| int(row, "absent")),
      }
    } });
  assert_eq(
    read,
    Ok({
      i: -9223372036854775807 - 1,
      r: 1.5,
      t: "a\0b \u{1F600}",
      b: b"\x00\xff",
      n: None,
      t_again: Some("a\0b \u{1F600}"),
      mistyped: Some(Mistyped("t", "an integer")),
      missing: Some(Mistyped("absent", "a column of the answer")),
    }),
  )
}

test "a boolean is bound as 1 or 0, and what SQLite does not store is rejected" {
  let read = fresh(||
    with_scope[bools](opening[app]("t.db", Create, strict_options()), |c| close(c)) { conn ->
      numbers(
        query(
          conn,
          bound(stmt("select ?1 as a union all select ?2"), [
            BoolParameter(true),
            BoolParameter(false),
          ]),
          generous_limits(),
        ),
        "a",
      )
    });
  assert_eq(read, Ok([1, 0]));
  let unbound = refusal(|| bound(stmt("select ?1"), [NumericParameter(1.50m)]));
  assert(match unbound { Some(Refused(_)) -> true, _ -> false })
}

test "a transaction commits when its body returns and rolls back when it raises" {
  let read = fresh(||
    with_scope[txn](opening[app]("t.db", Create, strict_options()), |c| close(c)) { conn -> {
      execute(conn, bare_statement("create table t (n integer) strict"), generous_limits());
      transaction(conn, ||
        execute(conn, bare_statement("insert into t values (1)"), generous_limits()));
      let failed = refusal(||
        transaction(conn, || {
          execute(conn, bare_statement("insert into t values (2)"), generous_limits());
          execute(conn, bare_statement("insert into t values ('two')"), generous_limits())
        }));
      let inner = transaction(conn, || {
        execute(conn, bare_statement("insert into t values (3)"), generous_limits());
        let gave_up = refusal(||
          transaction(conn, || {
            execute(conn, bare_statement("insert into t values (4)"), generous_limits());
            sql.fail(Closed("no"))
          }));
        execute(conn, bare_statement("insert into t values (5)"), generous_limits());
        gave_up
      });
      {
        held: numbers(
          query(conn, bare_statement("select n from t order by n"), generous_limits()),
          "n",
        ),
        failed: failed,
        inner: inner,
      }
    } });
  assert_eq(
    read,
    Ok({ held: [1, 3, 5], failed: Some(Constraint(Datatype, "t.n")), inner: Some(Closed("no")) }),
  )
}

test "a second writer is Busy, and a reader sees what was committed" {
  let read = fresh(||
    with_scope[writer](opening[app]("t.db", Create, strict_options()), |c| close(c)) { one ->
      with_scope[reader](opening[app]("t.db", ReadWrite, strict_options()), |c| close(c)) { two -> {
        execute(one, bare_statement("create table t (n integer) strict"), generous_limits());
        execute(one, bare_statement("insert into t values (1)"), generous_limits());
        let during = transaction(one, || {
          execute(one, bare_statement("insert into t values (2)"), generous_limits());
          {
            seen: numbers(
              query(two, bare_statement("select n from t order by n"), generous_limits()),
              "n",
            ),
            written: refusal(||
              execute(two, bare_statement("insert into t values (3)"), generous_limits())),
            begun: refusal(|| transaction(two, || 0)),
          }
        });
        {
          during: during,
          after: numbers(
            query(two, bare_statement("select n from t order by n"), generous_limits()),
            "n",
          ),
          then: execute(two, bare_statement("insert into t values (3)"), generous_limits()).rows,
        }
      } }
    });
  assert_eq(
    read,
    Ok({ during: { seen: [1], written: Some(Busy), begun: Some(Busy) }, after: [1, 2], then: 1 }),
  );
  assert(is_retryable(Busy));
  assert(!is_retryable(Constraint(Unique, "t.n")))
}

test "a snapshot reads one state, and its write is Busy once another has written" {
  let read = fresh(||
    with_scope[snap](opening[app]("t.db", Create, strict_options()), |c| close(c)) { one ->
      with_scope[other](opening[app]("t.db", ReadWrite, strict_options()), |c| close(c)) { two -> {
        execute(one, bare_statement("create table t (n integer) strict"), generous_limits());
        snapshot(one, || {
          let before = query(one, bare_statement("select n from t"), generous_limits()).len();
          execute(two, bare_statement("insert into t values (1)"), generous_limits());
          {
            before: before,
            still: query(one, bare_statement("select n from t"), generous_limits()).len(),
            stale: refusal(||
              execute(one, bare_statement("insert into t values (2)"), generous_limits())),
          }
        })
      } }
    });
  assert_eq(read, Ok({ before: 0, still: 0, stale: Some(Busy) }))
}

type ViolationCase = { sql: String, reason: Error }

fn violation_cases() -> List<ViolationCase> =
  [
    { sql: "insert into p values (2, 'a')", reason: Constraint(Unique, "p.code") },
    { sql: "insert into p values (1, 'b')", reason: Constraint(Unique, "p.id") },
    { sql: "insert into p (code) values (null)", reason: Constraint(NotNull, "p.code") },
    { sql: "insert into c (p, n) values (1, 0)", reason: Constraint(Check, "positive") },
    { sql: "insert into c (p, n) values (9, 1)", reason: Constraint(ForeignKey, "") },
    { sql: "insert into c (p, n) values (1, 'many')", reason: Constraint(Datatype, "c.n") },
    { sql: "delete from p", reason: Constraint(ForeignKey, "") },
  ]

test "{c.sql} breaks the constraint it names" for c: ViolationCase in violation_cases() {
  let read = fresh(||
    with_scope[constrained](opening[app]("t.db", Create, strict_options()), |x| close(x)) { conn -> {
      execute(
        conn,
        bare_statement("create table p (id integer primary key, code text not null unique) strict"),
        generous_limits(),
      );
      execute(
        conn,
        bare_statement(
          "create table c (id integer primary key, p integer not null references p (id), n integer, constraint positive check (n > 0)) strict",
        ),
        generous_limits(),
      );
      execute(conn, bare_statement("insert into p values (1, 'a')"), generous_limits());
      execute(conn, bare_statement("insert into c (p, n) values (1, 1)"), generous_limits());
      refusal(|| execute(conn, bare_statement(c.sql), generous_limits()))
    } });
  assert_eq(read, Ok(Some(c.reason)))
}

test "each limit rejects what exceeds it, reporting its name" {
  let read = fresh(||
    with_scope[bounded](opening[app]("t.db", Create, strict_options()), |c| close(c)) { conn -> {
      execute(conn, bare_statement("create table t (n integer) strict"), generous_limits());
      execute(conn, bare_statement("insert into t values (1), (2), (3)"), generous_limits());
      [
        refusal(||
          query(conn, bare_statement("select n from t"), { ..generous_limits(), rows: 2 })),
        refusal(||
          query(conn, bare_statement("select 'abcdef' as a"), { ..generous_limits(), bytes: 5 })),
        refusal(||
          query(conn, bare_statement("select 1 as a"), { ..generous_limits(), sql_bytes: 5 })),
        refusal(||
          query(
            conn,
            bound(stmt("select ?1 as a, ?2 as b"), [IntParameter(1), IntParameter(2)]),
            { ..generous_limits(), params: 1 },
          )),
        refusal(||
          query(
            conn,
            bare_statement(
              "with recursive c(i) as (select 1 union all select i + 1 from c where i < 1000000) select count(*) as n from c",
            ),
            { ..generous_limits(), steps: 10 },
          )),
        refusal(||
          returning(conn, bare_statement("delete from t returning n"), {
            ..generous_limits(),
            rows: 1,
          })),
        refusal(||
          query(conn, bare_statement("select n from t"), { ..generous_limits(), rows: 3 })),
      ]
    } });
  assert_eq(
    read,
    Ok([
      Some(LimitExceeded("rows")),
      Some(LimitExceeded("bytes")),
      Some(LimitExceeded("sql_bytes")),
      Some(LimitExceeded("params")),
      Some(LimitExceeded("steps")),
      Some(LimitExceeded("rows")),
      None,
    ]),
  )
}

test "a write rejected for what it returned leaves nothing behind" {
  let read = fresh(||
    with_scope[undone](opening[app]("t.db", Create, strict_options()), |c| close(c)) { conn -> {
      execute(conn, bare_statement("create table t (n integer) strict"), generous_limits());
      execute(conn, bare_statement("insert into t values (1), (2), (3)"), generous_limits());
      let over = refusal(||
        returning(conn, bare_statement("delete from t returning n"), {
          ..generous_limits(),
          rows: 1,
        }));
      let gone = numbers(
        returning(conn, bare_statement("delete from t where n = 2 returning n"), generous_limits()),
        "n",
      );
      {
        over: over,
        gone: gone,
        left: numbers(
          query(conn, bare_statement("select n from t order by n"), generous_limits()),
          "n",
        ),
      }
    } });
  assert_eq(read, Ok({ over: Some(LimitExceeded("rows")), gone: [2], left: [1, 3] }))
}

test "fold_rows reads every row a page at a time and nothing else runs meanwhile" {
  let read = fresh(||
    with_scope[folding](opening[app]("t.db", Create, strict_options()), |c| close(c)) { conn -> {
      execute(conn, bare_statement("create table t (n integer) strict"), generous_limits());
      execute(
        conn,
        bare_statement(
          "with recursive c(i) as (select 1 union all select i + 1 from c where i < 10) insert into t select i from c",
        ),
        generous_limits(),
      );
      let all = bare_statement("select n from t order by n");
      let counted = |acc: Int, _: Row| acc + 1;
      {
        sum: fold_rows(conn, all, generous_limits(), 3, 0, |acc: Int, row: Row|
          acc + int(row, "n")),
        whole: fold_rows(conn, all, generous_limits(), 10, 0, counted),
        none: fold_rows(
          conn,
          bare_statement("select n from t where n > 99"),
          generous_limits(),
          4,
          0,
          counted,
        ),
        over: refusal(|| fold_rows(conn, all, { ..generous_limits(), rows: 7 }, 3, 0, counted)),
        meanwhile: is_refused(
          fold_rows(conn, all, generous_limits(), 20, None, |_: Option<Error>, _: Row|
            refusal(|| query(conn, bare_statement("select 1 as a"), generous_limits()))),
        ),
        writes: is_refused(
          refusal(||
            fold_rows(
              conn,
              bare_statement("delete from t returning n"),
              generous_limits(),
              3,
              0,
              counted,
            )),
        ),
        after: query(conn, all, generous_limits()).len(),
      }
    } });
  assert_eq(
    read,
    Ok({
      sum: 55,
      whole: 10,
      none: 0,
      over: Some(LimitExceeded("rows")),
      meanwhile: true,
      writes: true,
      after: 10,
    }),
  )
}

fn is_refused(why: Option<Error>) -> Bool = match why { Some(Refused(_)) -> true, _ -> false }

test "a backup is a separate database, and never overwrites a file" {
  let made = over_twin(memory(), ||
    with_scope[source](opening[app]("t.db", Create, strict_options()), |c| close(c)) { conn -> {
      execute(conn, bare_statement("create table t (n integer) strict"), generous_limits());
      execute(conn, bare_statement("insert into t values (1)"), generous_limits());
      backup(conn, "copies/t.db");
      execute(conn, bare_statement("insert into t values (2)"), generous_limits());
      {
        again: is_refused(refusal(|| backup(conn, "copies/t.db"))),
        inside: refusal(|| transaction(conn, || backup(conn, "copies/u.db"))),
      }
    } });
  let left = match made { Ok(over) -> over, Err(_) -> panic("the backup was not made") };
  assert_eq(left.value, {
    again: true,
    inside: Some(Malformed("cannot VACUUM from within a transaction")),
  });
  let copy = in_twin(left.memory, ||
    with_scope[copied](opening[app]("copies/t.db", ReadOnly, strict_options()), |c|
      close(c)) { conn ->
      numbers(query(conn, bare_statement("select n from t"), generous_limits()), "n")
    });
  assert_eq(copy, Ok([1]));
  assert(database_bytes(left.memory, "copies/u.db") == None);
  assert(database_bytes(left.memory, "copies/t.db") != database_bytes(left.memory, "t.db"))
}

test "a connection opened to read writes nothing, and a query never writes" {
  let read = fresh(|| {
    with_scope[seeded](opening[app]("t.db", Create, strict_options()), |c| close(c)) { conn ->
      execute(conn, bare_statement("create table t (n integer) strict"), generous_limits())
    };
    with_scope[reading](opening[app]("t.db", ReadOnly, strict_options()), |c| close(c)) { conn ->
      [
        refusal(|| execute(conn, bare_statement("insert into t values (1)"), generous_limits())),
        refusal(||
          query(conn, bare_statement("insert into t values (1) returning n"), generous_limits())),
        refusal(||
          transaction(conn, ||
            execute(conn, bare_statement("insert into t values (1)"), generous_limits()))),
        refusal(||
          transaction(conn, ||
            query(conn, bare_statement("select n from t"), generous_limits()).len())),
        refusal(||
          snapshot(conn, ||
            query(conn, bare_statement("select n from t"), generous_limits()).len())),
      ]
    }
  });
  assert(match read {
    Ok([Some(Refused(_)), Some(Refused(_)), Some(Refused(_)), None, None]) -> true,
    _ -> false,
  })
}

test "a strict connection rejects a table that is not strict, and another connection accepts it" {
  let made = |strict: Bool|
    fresh(||
      with_scope[strictness](
        opening[app]("t.db", Create, { ..strict_options(), strict: strict }),
        |c| close(c),
      ) { conn ->
        refusal(|| execute(conn, bare_statement("create table loose (a)"), generous_limits()))
      });
  assert(match made(true) { Ok(Some(Refused(_))) -> true, _ -> false });
  assert_eq(made(false), Ok(None))
}

fn engine_refuses() -> List<String> =
  [
    "select last_insert_rowid() as a",
    "select changes() as a",
    "pragma journal_mode = delete",
    "pragma database_list",
    "select datetime(?1) as a",
    "select * from pragma_database_list",
    "create view v as select 1 as a; drop table t",
  ]

test "the engine rejects {c}, which the parser cannot detect" for c: String in engine_refuses() {
  let read = fresh(||
    with_scope[authorized](opening[app]("t.db", Create, strict_options()), |x| close(x)) { conn -> {
      execute(conn, bare_statement("create table t (n integer) strict"), generous_limits());
      let params = if c.contains("?1") { [TextParameter("now")] } else { [] };
      refusal(|| execute(conn, bound(stmt(c), params), generous_limits()))
    } });
  assert(match read { Ok(Some(Refused(_))) -> true, _ -> false })
}

test "a view and a trigger are bound by the same rules as a statement" {
  let read = fresh(||
    with_scope[smuggled](opening[app]("t.db", Create, strict_options()), |c| close(c)) { conn -> {
      execute(
        conn,
        bare_statement("create table t (n integer, at text) strict"),
        generous_limits(),
      );
      execute(
        conn,
        bare_statement("create view stamped as select datetime(at) as at from t"),
        generous_limits(),
      );
      execute(
        conn,
        bare_statement(
          "create trigger stamp after insert on t begin update t set at = datetime(new.at, '+1 day'); end",
        ),
        generous_limits(),
      );
      execute(
        conn,
        bare_statement("insert into t values (1, '2024-01-31 12:00:00')"),
        generous_limits(),
      );
      let kept = query(conn, bare_statement("select at from stamped"), generous_limits()).map(
        |row: Row| text(row, "at"),
      );
      let now = refusal(||
        execute(conn, bare_statement("insert into t values (2, 'now')"), generous_limits()));
      {
        kept: kept,
        now: now,
        held: query(conn, bare_statement("select n from t"), generous_limits()).len(),
      }
    } });
  assert(match read {
    Ok(r) ->
      r.kept == ["2024-02-01 12:00:00"] && r.held == 1
        && (match r.now { Some(Refused(_)) -> true, _ -> false }),
    Err(_) -> false,
  })
}

test "a tagged literal's holes are its parameters, and an error points where its text is rejected" {
  assert_eq(
    compile(["select n from t where a = ", " and b = ", ""]),
    Ok(stmt("select n from t where a = ?1 and b = ?2")),
  );
  let filled = fill(stmt("select ?1 as a, ?2 as b"), [IntParameter(1), TextParameter("x")]);
  assert_eq(statement(filled), stmt("select ?1 as a, ?2 as b"));
  let placed_at = |texts: List<String>|
    match compile(texts) { Err(e) -> Some({ part: e.part, offset: e.offset }), Ok(_) -> None };
  assert_eq(placed_at(["select random()"]), Some({ part: 0, offset: 7 }));
  assert_eq(placed_at(["select ", ", é, current_date"]), Some({ part: 1, offset: 5 }));
  assert_eq(placed_at(["attach ", " as x"]), Some({ part: 0, offset: 0 }));
  assert(match literal("vacuum") { Err(e) -> e.offset == 0, Ok(_) -> false });
  assert(match literal("select 1") { Ok(_) -> true, Err(_) -> false })
}

test "a path that leaves its root is rejected with E0452's message" {
  let escaped = try[abort.raise] {
    fresh(||
      with_scope[escaping](opening[app]("../t.db", Create, strict_options()), |c|
        close(c)) { conn -> 0 })
  };
  assert_eq(escaped, Err("`../t.db` leaves the root it was given"))
}

test "what was closed, and what was never opened, is Closed" {
  let read = fresh(|| {
    let kept = with_scope[leaving](opening[app]("t.db", Create, strict_options()), |c|
      close(c)) { conn -> conn.get() };
    with_scope[again](kept, |_: Connection<[app]>| ()) { conn ->
      refusal(|| query(conn, bare_statement("select 1 as a"), generous_limits()))
    }
  });
  assert(match read { Ok(Some(Closed(_))) -> true, _ -> false })
}

test "every allowed function is listed once, in order" {
  let names = functions();
  assert(names.len() > 80);
  assert(
    range(1, names.len()).fold(true, |ok: Bool, i: Int|
      ok && compare(names.at(i - 1), names.at(i)) == Less),
  )
}
