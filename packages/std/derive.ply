//! The types a deriver reads and returns.
//!
//! For `derive d for T`, where `d` is a module binder, the check calls `d::derive(declaration)` on
//! the module `d` names before it reads the rest of the deriving module.
//!
//! A deriver is a function
//! `pub fn derive(declaration: derive::Declaration) -> Result<String, derive::Refused>` whose only
//! effect is a raise. It receives the deriving module's declarations as data. It returns
//! the source of the functions it derives, and the check reads that source into the deriving module
//! as if it were written there. Names in the source resolve through that module's imports, and
//! `declaration.binder` is the binder for the deriver's own module. The check runs a deriver as it
//! runs a `const fn`: on a separate machine, under the same budget. It caches the result, keyed by
//! the contents of the deriver's modules and the declaration it read. A deriver that raises fails
//! the derivation.

import std.list
import std.string

/// A type's name as the deriving module writes it: `T`, or `m::T` through the binder `m`.
pub type TypeName = { module: Option<String>, name: String }

/// A type as it is written in a declaration.
pub type Type =
  /// One of the declaration's type parameters.
  | Param(String)
  /// A named type applied to its arguments, labels and rows, each label and row as it is written:
  /// `Int`, `List<a>`, `m::Sink<a, [l] | e>`.
  | Applied(TypeName, List<Type>, List<String>, List<String>)
  /// A function's parameters, its result and its row as it is written, empty where it writes none.
  | Function(List<Type>, Type, String)
  | Record(List<Field>)
  | Unit

/// A record's field: its name and its type.
pub type Field = { name: String, ty: Type }

/// A sum's variant: its constructor's name and the type of each of its fields, in order.
pub type Variant = { name: String, fields: List<Type> }

/// An alias names a type; a `new` record (`Nominal`) and a sum are types of their own; an `extern
/// type` has nothing a deriver can read.
pub type Body = | Alias(Type) | Nominal(Type) | Sum(List<Variant>) | Extern

/// A type the module declares, with its type, row and label parameters in order.
pub type TypeDeclaration = {
  name: String,
  public: Bool,
  types: List<String>,
  rows: List<String>,
  labels: List<String>,
  body: Body,
}

/// A module the deriving module imports, and the binder its source uses for it. A deriver's text
/// refers to that module's names through this binder.
pub type Imported = { module: String, binder: String }

/// The input to a deriver: the target type, the deriving module and every type it declares, the
/// binder that module uses for the deriver's module, every type it derives with this deriver
/// (including the target), and each module it imports.
pub type Declaration = {
  target: String,
  module: String,
  binder: String,
  types: List<TypeDeclaration>,
  derived: List<String>,
  imports: List<Imported>,
}

/// Why a type cannot be derived: what blocks it, the field or variant of the target that blocks it
/// if there is one, and notes on what to do instead.
pub type Refused = { message: String, at: Option<String>, notes: List<String> }

/// The declaration of the type a derivation is for.
pub fn target(d: Declaration) -> TypeDeclaration / {abort.raise} =
  match declared(d, d.target) {
    Some(t) -> t,
    None -> panic("a declaration whose target the module does not declare: " ++ d.target),
  }

/// The type the module declares under `name`.
pub fn declared(d: Declaration, name: String) -> Option<TypeDeclaration> =
  d.types.find(|t: TypeDeclaration| t.name == name)

/// A type's name as the module writes it.
pub fn name_text(n: TypeName) -> String =
  match n.module { Some(m) -> m ++ "::" ++ n.name, None -> n.name }

/// `t` as Ply source.
pub fn type_text(t: Type) -> String =
  match t {
    Param(p) -> p,
    Applied(n, args, labels, rows) -> name_text(n) ++ angled(args, labels, rows),
    Function(params, result, row) -> {
      let head = "(" ++ String::join(params.map(type_text), ", ") ++ ") -> " ++ type_text(result);
      if row == "" { head } else { head ++ " / " ++ row }
    },
    Record(fields) ->
      "{ " ++ String::join(fields.map(|f: Field| f.name ++ ": " ++ type_text(f.ty)), ", ") ++ " }",
    Unit -> "()",
  }

/// The parameters a type is declared over, as its declaration writes them: `<a, [l] | e>`.
pub fn parameters_text(t: TypeDeclaration) -> String = angled(t.types.map(Param), t.labels, t.rows)

/// `<..>` over arguments, labels in brackets and rows after a bar; nothing where there are none.
fn angled(args: List<Type>, labels: List<String>, rows: List<String>) -> String = {
  let front = args.map(type_text).concat(labels.map(|l: String| "[" ++ l ++ "]"));
  if front.len() == 0 && rows.len() == 0 { "" }
  else if rows.len() == 0 { "<" ++ String::join(front, ", ") ++ ">" }
  else if front.len() == 0 { "<| " ++ String::join(rows, ", ") ++ ">" }
  else { "<" ++ String::join(front, ", ") ++ " | " ++ String::join(rows, ", ") ++ ">" }
}

test "a type is written as the module writes it" {
  let list = Applied({ module: None, name: "List" }, [Param("a")], [], []);
  let sink = Applied({ module: Some("m"), name: "Sink" }, [Param("a")], ["l"], ["e"]);
  assert_eq(type_text(list), "List<a>");
  assert_eq(type_text(sink), "m::Sink<a, [l] | e>");
  assert_eq(type_text(Function([list], Unit, "")), "(List<a>) -> ()");
  assert_eq(
    type_text(Function([], sink, "{log.write | e}")),
    "() -> m::Sink<a, [l] | e> / {log.write | e}",
  );
  assert_eq(type_text(Record([{ name: "x", ty: Param("a") }])), "{ x: a }");
  let declared = { name: "T", public: true, types: ["a"], rows: ["e"], labels: [], body: Extern };
  assert_eq(parameters_text(declared), "<a | e>");
  assert_eq(parameters_text({ ..declared, types: [], rows: [] }), "")
}
