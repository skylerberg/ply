//! Parser combinators: a parser is a value, and a bigger one is built from smaller ones.
//!
//! A parser takes the input and a position, and returns a `Match` or `None`. A failed parse is
//! `None` rather than a diagnostic. Every loop is bounded by the input rather than by a budget:
//! `many` stops when its parser consumes nothing or returns a position past the input, and `separator_by`
//! stops when a separator and an item together consume nothing. So a parser that can match the
//! empty string still cannot loop, and no parser needs a fuel argument.
//!
//! A parser returns at most one match, so a sequence never goes back to try another branch of an
//! earlier choice. `or_else` runs its second parser from the same position as the first, so a
//! failed first parser leaves nothing to undo.

import std.list (prepend)

/// What a parser reads.
pub type Input = String

/// A position in an `Input`, in characters.
pub type Position = Int

/// The result of a successful parse: the value, and the position just after what it consumed.
pub type Match<a> = { value: a, at: Position }

/// A parser. Given the input and a position, it returns a `Match`, or `None` if it does not match
/// there.
pub type Parser<a> = (Input, Position) -> Option<Match<a>> / {abort.raise}

/// The value `input` parses to, or `None` if the parser does not consume all of it. Unparsed input
/// left at the end is a failure; `run_prefix` parses a prefix.
pub fn run<a>(parser: Parser<a>, input: Input) -> Option<a> / {abort.raise} =
  match parser(input, 0) {
    None -> None,
    Some(step) -> if step.at == input.len() { Some(step.value) } else { None },
  }

/// Runs the parser at `position` and returns its `Match`, leaving the rest of the input unread.
pub fn run_prefix<a>(
  parser: Parser<a>,
  input: Input,
  position: Position,
) -> Option<Match<a>> / {abort.raise} = parser(input, position)

/// One character for which `ok` returns true.
pub fn satisfy(ok: keep (String) -> Bool / {abort.raise}) -> Parser<String> =
  |input: Input, position: Position|
    if position < input.len() {
      let c = input.slice(position, position + 1);
      if ok(c) { Some({ value: c, at: position + 1 }) } else { None }
    } else { None }

/// Parses the single character `c` and returns it. Fails when the input at the position is anything
/// else.
pub fn char(c: String) -> Parser<String> = text(c)

/// The literal text `t`. An empty `t` matches at every position.
pub fn text(t: String) -> Parser<String> =
  |input: Input, position: Position|
    if position + t.len() > input.len() { None }
    else if input.slice(position, position + t.len()) == t {
      Some({ value: t, at: position + t.len() })
    } else { None }

/// `parser`, with its value passed through `f`.
pub fn map<a, b>(parser: Parser<a>, f: keep (a) -> b / {abort.raise}) -> Parser<b> =
  |input: Input, position: Position|
    match parser(input, position) {
      None -> None,
      Some(step) -> Some({ value: f(step.value), at: step.at }),
    }

/// `parser`, then the parser `f` returns for its value, run from where `parser` stopped.
pub fn and_then<a, b>(parser: Parser<a>, f: keep (a) -> Parser<b>) -> Parser<b> =
  |input: Input, position: Position|
    match parser(input, position) { None -> None, Some(step) -> f(step.value)(input, step.at) }

/// `p`, or `q` from the same position when `p` fails.
pub fn or_else<a>(p: Parser<a>, q: Parser<a>) -> Parser<a> =
  |input: Input, position: Position|
    match p(input, position) { None -> q(input, position), Some(step) -> Some(step) }

/// `parser` zero or more times. It stops at the first position where the parser fails or matches
/// without consuming anything, so a parser that matches the empty string cannot loop.
pub fn many<a>(parser: Parser<a>) -> Parser<List<a>> =
  |input: Input, position: Position| many_from(parser, input, position, [], input.len() - position)

/// `parser` at least once.
pub fn many1<a>(parser: Parser<a>) -> Parser<List<a>> =
  and_then(parser, |first: a| map(many(parser), |rest: List<a>| prepend(first, rest)))

/// Parses `parser` and returns its value as `Some`. When `parser` fails, returns `None` without
/// consuming any input, so `opt` itself never fails.
pub fn opt<a>(parser: Parser<a>) -> Parser<Option<a>> =
  |input: Input, position: Position|
    match parser(input, position) {
      None -> Some({ value: None, at: position }),
      Some(step) -> Some({ value: Some(step.value), at: step.at }),
    }

/// Zero or more of `parser`, separated by `sep`. A trailing separator makes the whole parse fail
/// rather than ending the list early. Like `many`, it stops where a separator and an item together
/// consume nothing.
pub fn separator_by<a, b>(parser: Parser<a>, sep: Parser<b>) -> Parser<List<a>> =
  |input: Input, position: Position|
    match parser(input, position) {
      None -> Some({ value: [], at: position }),
      Some(first) -> separated(parser, sep, input, first.at, [first.value], input.len() - first.at),
    }

/// `s`, then `p`, returning `p`'s value. Use it to skip a delimiter before an item.
pub fn after<s, a>(s: Parser<s>, p: Parser<a>) -> Parser<a> = and_then(s, |_: s| p)

/// `p`, then `s`, returning `s`'s value.
pub fn before<a, s>(p: Parser<a>, s: Parser<s>) -> Parser<s> = and_then(p, |_: a| s)

/// One decimal digit, as its text.
pub fn digit() -> Parser<String> = satisfy(|c: String| "0123456789".contains(c))

/// One or more decimal digits, as their text.
pub fn digits() -> Parser<String> = map(many1(digit()), |ds: List<String>| joined(ds))

/// Zero or more spaces or tabs, as their text.
pub fn spaces() -> Parser<String> =
  map(many(satisfy(|c: String| c == " " || c == "\t")), |cs: List<String>| joined(cs))

/// A non-empty run of characters that are not `stop`.
pub fn word(stop: String) -> Parser<String> =
  map(many1(satisfy(|c: String| !stop.contains(c))), |cs: List<String>| joined(cs))

fn joined(xs: List<String>) -> String =
  xs.fold("", |accumulator: String, x: String| accumulator ++ x)

fn many_from<a>(
  parser: Parser<a>,
  input: Input,
  position: Position,
  accumulator: List<a>,
  left: Int,
) -> Option<Match<List<a>>> / {abort.raise} =
  match parser(input, position) {
    None -> Some({ value: accumulator, at: position }),
    Some(step) -> if step.at <= position || step.at > input.len() {
      Some({ value: accumulator, at: position })
    } else if left <= 0 {
      panic(
        "a repeated parser ran more times than the input has characters, so it is probably looping without consuming input",
      )
    } else { many_from(parser, input, step.at, accumulator.push(step.value), left - 1) },
  }

fn separated<a, b>(
  parser: Parser<a>,
  sep: Parser<b>,
  input: Input,
  position: Position,
  accumulator: List<a>,
  left: Int,
) -> Option<Match<List<a>>> / {abort.raise} =
  match sep(input, position) {
    None -> Some({ value: accumulator, at: position }),
    Some(separator_step) -> match parser(input, separator_step.at) {
      None -> None,
      Some(step) -> if step.at <= position || step.at > input.len() {
        Some({ value: accumulator, at: position })
      } else if left <= 0 {
        panic(
          "a repeated parser ran more times than the input has characters, so it is probably looping without consuming input",
        )
      } else { separated(parser, sep, input, step.at, accumulator.push(step.value), left - 1) },
    },
  }

fn integer() -> Parser<Int> =
  map(digits(), |ds: String|
    range(0, ds.len()).fold(0, |accumulator: Int, i: Int|
      accumulator * 10 + "0123456789".find(ds.slice(i, i + 1))))

test "a literal consumes exactly what it matches, and `run` requires the whole input" {
  assert_eq(run(text("ab"), "ab"), Some("ab"));
  assert_eq(run(text("ab"), "abc"), None);
  assert_eq(run(char("a"), "a"), Some("a"));
  assert_eq(run(char("a"), "b"), None);
  assert_eq(run(text(""), ""), Some(""));
  assert_eq(run_prefix(text("ab"), "abc", 0), Some({ value: "ab", at: 2 }));
  assert_eq(run_prefix(text("ab"), "xab", 1), Some({ value: "ab", at: 3 }))
}

test "`or_else` tries the second parser from the same position where the first parser started" {
  let p = or_else(text("ab"), text("ac"));
  assert_eq(run(p, "ab"), Some("ab"));
  assert_eq(run(p, "ac"), Some("ac"));
  assert_eq(run(p, "ad"), None);
  assert_eq(run_prefix(p, "ac", 2), None);
  assert_eq(run_prefix(p, "ab", 0), Some({ value: "ab", at: 2 }))
}

test "many stops where its parser fails or consumes nothing" {
  assert_eq(run(many(digit()), "123"), Some(["1", "2", "3"]));
  assert_eq(run(many(digit()), ""), Some([]));
  assert_eq(run_prefix(many(text("")), "abc", 0), Some({ value: [], at: 0 }));
  assert_eq(run(many(text("")), ""), Some([]));
  assert_eq(run(many1(digit()), ""), None);
  assert_eq(run(map(digits(), |ds: String| ds.len()), "12345"), Some(5))
}

test "`separator_by` fails on a trailing separator, `opt` returns `None` when its parser does not match, and `and_then`, `after` and `before` run two parsers in sequence" {
  let row = separator_by(word(","), char(","));
  assert_eq(run(row, "a,b,c"), Some(["a", "b", "c"]));
  assert_eq(run(row, "a,b,"), None);
  assert_eq(run(row, ""), Some([]));
  assert_eq(run(separator_by(opt(char("x")), opt(char(","))), ""), Some([None]));
  assert_eq(run_prefix(opt(char("+")), "x", 0), Some({ value: None, at: 0 }));
  assert_eq(run(opt(char("+")), ""), Some(None));
  assert_eq(run(opt(char("+")), "+"), Some(Some("+")));
  let sum = and_then(integer(), |a: Int| map(after(char(":"), integer()), |b: Int| a + b));
  assert_eq(run(sum, "12:30"), Some(42));
  assert_eq(run(before(spaces(), text("end")), "   end"), Some("end"))
}
