//! SQL statements as values, and a parser that works out what a statement does before it runs.
//!
//! A `Statement` is a statement's text. A `Param` is a value bound to one of its placeholders. A
//! `Row` is one row a statement returns, holding a `Datum` per column. A `QueryResult` is the rows,
//! the count or the database error a statement produced. A `Schema` is a database's tables as a
//! value.
//!
//! `check_statement` checks a statement against the call that runs it and against a schema: its
//! tables and columns, the type each placeholder represents, and the columns it returns, compared
//! with the fields of the row type they are read into. `ply check` runs it on every statement a
//! program runs whose text it can compute, against the program's constant of type `Schema`, and
//! `std.db` runs it again on a statement as it sends it. A `RowCodec`, which `derive sql` writes
//! for a record type, reads a row as a record and writes a record as parameters.

import std.bytes (is_digit)
import std.json
import std.string
import std.list
import std.option
import std.result
import std.derive
import std.derive.codec (derive_row)

/// `derive sql for T`: `<snake_case(T)>_row`, the `RowCodec` of the record `T`, as
/// `std.derive.codec` writes it.
pub fn derive(declaration: derive::Declaration) -> Result<String, derive::Refused> / {abort.raise} =
  derive_row(declaration)

/// A statement's text, with `$1`, `$2`.. where its parameters go.
pub type Statement = { sql: String }

/// A statement of this text.
pub fn statement_of(sql: String) -> Statement = { sql: sql }

/// A value bound to a statement's placeholder.
pub type Param =
  | NullParameter
  | IntParameter(Int)
  | BoolParameter(Bool)
  | TextParameter(String)
  | BytesParameter(Bytes)
  | FloatParameter(Float)
  | NumericParameter(Decimal)
  | JsonParameter(json::Json)
  | ArrayParameter(List<Param>)

/// A value in one column of a row: null, or a value of one of the SQL types the library supports.
pub type Datum =
  | NullDatum
  | IntDatum(Int)
  | BoolDatum(Bool)
  | TextDatum(String)
  | BytesDatum(Bytes)
  | FloatDatum(Float)
  | NumericDatum(Decimal)
  | JsonDatum(json::Json)
  | ArrayDatum(List<Datum>)

/// A row returned by a statement, as a map from column name to the `Datum` in that column.
pub type Row = Map<String, Datum>

/// An error from the database: the SQLSTATE code the server returned, the name of the violated
/// `constraint` and a `detail` message. `constraint` and `detail` are empty strings when the server
/// gave none.
pub type DbError = { code: String, constraint: String, detail: String }

/// Rows for a statement that returns them, a count for one that writes, or the server's error.
pub type QueryResult = | Rows(List<Row>) | Count(Int) | Failed(DbError)

/// A column's type in a `Schema`; `TNumeric(precision, scale)`.
pub type ColumnType =
  | IntColumn
  | BoolColumn
  | TText
  | BytesColumn
  | FloatColumn
  | TNumeric(Int, Int)
  | JsonColumn
  | TArray(ColumnType)

/// What a column gets when an insert gives it no value: nothing, the next value of a sequence, or
/// a literal.
pub type ColumnDefault = | DNone | SequenceDefault(String) | LiteralDefault(Param)

/// A column of a table in a `Schema`. `nullable` says whether the column may hold null, and
/// `default` is the value an insert gives it when it supplies none.
pub type Column = { name: String, ty: ColumnType, nullable: Bool, default: ColumnDefault }

/// A foreign key: `columns` of this table refer to `refers_to` of the table `references`.
pub type ForeignKey = {
  name: String,
  columns: List<String>,
  references: String,
  refers_to: List<String>,
}

/// A named check constraint over SQL text.
pub type Check = { name: String, expression: String }

/// A unique constraint named `name` that requires the combination of values in `columns` to be
/// unique across the table's rows.
pub type Unique = { name: String, columns: List<String> }

/// A table in a `Schema`. `create_schema` renders it as SQL, and the in-memory database in
/// `std.sql` enforces its keys and constraints.
pub type Table = {
  name: String,
  columns: List<Column>,
  primary_key: List<String>,
  unique: List<Unique>,
  foreign_keys: List<ForeignKey>,
  checks: List<Check>,
}

/// The tables of a database, in the order they are created.
pub type Schema = { tables: List<Table> }

/// Returns a `DbError` with the given SQLSTATE `code`, `constraint` and `detail`, as the in-memory
/// database returns when a statement violates a constraint.
pub fn db_error(code: String, constraint: String, detail: String) -> DbError =
  { code: code, constraint: constraint, detail: detail }

/// A column with no default.
pub fn column(name: String, ty: ColumnType, nullable: Bool) -> Column =
  { name: name, ty: ty, nullable: nullable, default: DNone }

/// A column with a default.
pub fn column_default(name: String, ty: ColumnType, nullable: Bool, d: ColumnDefault) -> Column =
  { name: name, ty: ty, nullable: nullable, default: d }

fn is_space_byte(c: Int) -> Bool = c == 32 || c == 9 || c == 10 || c == 13 || c == 11 || c == 12

fn is_word_byte(c: Int) -> Bool =
  (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95 || (c >= 48 && c <= 57)

/// The SQL dialect a statement is written in. The dialect decides how the parser splits the
/// statement into tokens and how much of it the parser reads.
///
/// A `Postgres` statement is parsed completely, so the tables it reads and writes are known. A
/// `Sqlite` statement is parsed only for its verb and for the words that read a clock or draw a
/// random number, so its tables are not known. The SQLite engine rejects any other error when it
/// prepares the statement (`std.sqlite`).
pub type Dialect = | Postgres | Sqlite

/// The kind of a statement, which decides what permission a program needs to run it. Only a
/// `Sqlite` statement can be `SchemaChange`, which creates, drops or alters a schema object, or
/// `Pragma`.
pub type StatementKind = | Select | Insert | Update | Delete | Values | SchemaChange | Pragma

/// Whether a statement of this kind writes. A pragma may read or set a value, which only the engine
/// can tell.
pub fn kind_writes(k: StatementKind) -> Bool =
  match k {
    Select -> false,
    Values -> false,
    Pragma -> false,
    Insert -> true,
    Update -> true,
    Delete -> true,
    SchemaChange -> true,
  }

/// The verb a statement of this kind starts with.
pub fn kind_text(k: StatementKind) -> String =
  match k {
    Select -> "select",
    Values -> "values",
    Insert -> "insert",
    Update -> "update",
    Delete -> "delete",
    SchemaChange -> "create",
    Pragma -> "pragma",
  }

/// The tables a statement names, split by what it does to them and deduplicated: one name is one
/// entry, and a table that is written is not also reported as read.
pub type SqlTables = { written: List<String>, read: List<String> }

/// A statement that names no table.
pub const no_sql_tables: SqlTables = { written: [], read: [] }

fn sql_note_written(t: SqlTables, name: String) -> SqlTables / {abort.raise} =
  { ..t, written: sql_insert_sorted(t.written, name), read: sql_without_table(t.read, name) }

fn sql_note_read(t: SqlTables, name: String) -> SqlTables / {abort.raise} =
  if t.written.contains(name) { t } else { { ..t, read: sql_insert_sorted(t.read, name) } }

fn sql_merge_tables(t: SqlTables, other: SqlTables) -> SqlTables / {abort.raise} =
  other.written.fold(
    other.read.fold(t, |accumulator: SqlTables, n: String| sql_note_read(accumulator, n)),
    |accumulator: SqlTables, n: String| sql_note_written(accumulator, n),
  )

fn sql_insert_sorted(names: List<String>, name: String) -> List<String> / {abort.raise} =
  if names.contains(name) { names } else { sql_in_order(names, name, []) }

fn sql_in_order(
  names: List<String>,
  name: String,
  before: List<String>,
) -> List<String> / {abort.raise} =
  match names {
    [] -> before.push(name),
    [h, ..rest] -> if sql_name_before(name, h) { before.push(name).concat(names) }
    else { sql_in_order(rest, name, before.push(h)) },
  }

fn sql_name_before(a: String, b: String) -> Bool / {abort.raise} =
  sql_bytes_compare(Bytes::of_string(a), Bytes::of_string(b)) < 0

fn sql_bytes_compare(a: Bytes, b: Bytes) -> Int / {abort.raise} = {
  let shorter = if a.len() < b.len() { a.len() } else { b.len() };
  let first = range(0, shorter).fold(0, |found: Int, i: Int|
    if found != 0 { found }
    else if a.at(i) < b.at(i) { -1 }
    else if a.at(i) > b.at(i) { 1 }
    else { 0 });
  if first != 0 { first }
  else if a.len() < b.len() { -1 }
  else if a.len() > b.len() { 1 }
  else { 0 }
}

/// Every table the statement names, written and read as one sorted list.
pub fn scan_table_names(t: SqlTables) -> List<String> / {abort.raise} =
  sql_merge_names(t.written, t.read)

fn sql_merge_names(a: List<String>, b: List<String>) -> List<String> / {abort.raise} =
  match a {
    [] -> b,
    [ah, ..at] -> match b {
      [] -> a,
      [bh, ..bt] -> if ah == bh { [ah].concat(sql_merge_names(at, bt)) }
      else if sql_name_before(ah, bh) { [ah].concat(sql_merge_names(at, b)) }
      else { [bh].concat(sql_merge_names(a, bt)) },
    },
  }

fn sql_without_table(names: List<String>, name: String) -> List<String> =
  names.fold([], |accumulator: List<String>, n: String|
    if n == name { accumulator } else { accumulator.push(n) })

/// A token, with the source text it was read from, so an error can name it.
pub type SqlToken =
  | SqlWord({ text: String, quoted: Bool })
  | SqlNumber
  | SqlText
  | SqlPlaceholder
  | SqlPunctuation(String)
  | SqlSemicolon

/// A token, where it starts in the statement, and its text.
pub type SqlTokenAt = { token: SqlToken, at: Int, text: String }

/// Whether the token is the unquoted word `word`.
pub fn sql_is_word(t: SqlToken, word: String) -> Bool =
  match t { SqlWord(w) -> if w.quoted { false } else { w.text == word }, _ -> false }

/// Whether the token is the punctuation `p`.
pub fn sql_is_punctuation(t: SqlToken, p: String) -> Bool =
  match t { SqlPunctuation(x) -> x == p, _ -> false }

/// Whether the token is a `;`.
pub fn sql_is_semicolon(t: SqlToken) -> Bool = match t { SqlSemicolon -> true, _ -> false }

/// Splits `sql` into tokens, in order, using the rules of `dialect`. Whitespace and comments are
/// dropped. Returns a `DbError` if a quote or block comment is never closed, because the parser
/// could not tell where quoted text ends and SQL begins.
pub fn tokenize(
  dialect: Dialect,
  sql: String,
) -> Result<List<SqlTokenAt>, DbError> / {abort.raise} = {
  let b = Bytes::of_string(sql);
  sql_tokens_from(dialect, b, 0, [], b.len() + 1)
}

fn sql_tokens_from(
  dialect: Dialect,
  b: Bytes,
  at: Int,
  accumulator: List<SqlTokenAt>,
  left: Int,
) -> Result<List<SqlTokenAt>, DbError> / {abort.raise} =
  if left <= 0 { panic("the SQL scanner looped more times than the input is long") } else {
    let i = sql_skip_trivia(dialect, b, at, b.len() + 1)?;
    if i >= b.len() { Ok(accumulator) } else {
      let lexed = match dialect {
        Postgres -> sql_next_token(b, i),
        Sqlite -> sqlite_next_token(b, i),
      };
      let step = lexed?;
      sql_tokens_from(dialect, b, step.next, accumulator.push(step.token), left - 1)
    }
  }

fn sql_skip_trivia(
  dialect: Dialect,
  b: Bytes,
  at: Int,
  left: Int,
) -> Result<Int, DbError> / {abort.raise} =
  if left <= 0 { panic("the SQL scanner looped more times than the input is long") } else {
    if at >= b.len() { Ok(at) }
    else if is_space_byte(b.at(at)) { sql_skip_trivia(dialect, b, at + 1, left - 1) }
    else if b.at(at) == 45 && sql_byte_is(b, at + 1, 45) {
      sql_skip_trivia(dialect, b, sql_past_line(b, at), left - 1)
    } else if b.at(at) == 47 && sql_byte_is(b, at + 1, 42) {
      match sql_past_comment(b, at + 2, 1, sql_comments_nest(dialect)) {
        Err(_) -> Err(sql_unclosed(b, at, "a block comment")),
        Ok(e) -> sql_skip_trivia(dialect, b, e, left - 1),
      }
    } else { Ok(at) }
  }

fn sql_comments_nest(dialect: Dialect) -> Bool = match dialect { Postgres -> true, Sqlite -> false }

fn sql_byte_is(b: Bytes, at: Int, c: Int) -> Bool / {abort.raise} = at < b.len() && b.at(at) == c

fn sql_past_line(b: Bytes, at: Int) -> Int / {abort.raise} =
  if at >= b.len() { at } else if b.at(at) == 10 { at + 1 } else { sql_past_line(b, at + 1) }

fn sql_past_comment(
  b: Bytes,
  at: Int,
  depth: Int,
  nests: Bool,
) -> Result<Int, Int> / {abort.raise} =
  if at >= b.len() { Err(at) } else if nests && b.at(at) == 47 && sql_byte_is(b, at + 1, 42) {
    sql_past_comment(b, at + 2, depth + 1, nests)
  } else if b.at(at) == 42 && sql_byte_is(b, at + 1, 47) {
    if depth == 1 { Ok(at + 2) } else { sql_past_comment(b, at + 2, depth - 1, nests) }
  } else { sql_past_comment(b, at + 1, depth, nests) }

fn sql_next_token(
  b: Bytes,
  at: Int,
) -> Result<{ token: SqlTokenAt, next: Int }, DbError> / {abort.raise} = {
  let c = b.at(at);
  if c == 59 { Ok(sql_token_between(b, at, at + 1, SqlSemicolon)) }
  else if c == 39 { sql_literal(b, at, at + 1, at, false) }
  else if (c == 101 || c == 69) && sql_byte_is(b, at + 1, 39) {
    sql_literal(b, at, at + 2, at + 1, true)
  } else if (c == 98 || c == 66 || c == 120 || c == 88) && sql_byte_is(b, at + 1, 39) {
    sql_literal(b, at, at + 2, at + 1, false)
  } else if (c == 117 || c == 85) && sql_byte_is(b, at + 1, 38) && sql_byte_is(b, at + 2, 39) {
    sql_literal(b, at, at + 3, at + 2, false)
  } else if c == 34 { sql_quoted_word(b, at, at + 1, at) } else if c == 36 {
    match sql_digit_end(b, at + 1) {
      Some(e) -> Ok(sql_token_between(b, at, e, SqlPlaceholder)),
      None -> sql_dollar_quoted(b, at),
    }
  } else if is_digit(c) { Ok(sql_token_between(b, at, sql_past_number(b, at), SqlNumber)) }
  else if sql_is_name_byte(c) {
    let end = sql_past_word(b, at);
    let word = String::of_bytes(b.slice(at, end)).ascii_lower();
    Ok(sql_token_between(b, at, end, SqlWord({ text: word, quoted: false })))
  } else {
    Ok(sql_token_between(b, at, at + 1, SqlPunctuation(String::of_bytes(b.slice(at, at + 1)))))
  }
}

fn sqlite_next_token(
  b: Bytes,
  at: Int,
) -> Result<{ token: SqlTokenAt, next: Int }, DbError> / {abort.raise} = {
  let c = b.at(at);
  if c == 59 { Ok(sql_token_between(b, at, at + 1, SqlSemicolon)) }
  else if c == 39 { sql_literal(b, at, at + 1, at, false) }
  else if (c == 120 || c == 88) && sql_byte_is(b, at + 1, 39) {
    sql_literal(b, at, at + 2, at + 1, false)
  } else if c == 34 { sql_quoted_word(b, at, at + 1, at) }
  else if c == 96 { sqlite_quoted_word(b, at, 96) }
  else if c == 91 { sqlite_quoted_word(b, at, 93) }
  else if c == 63 { Ok(sql_token_between(b, at, sqlite_past_digits(b, at + 1), SqlPlaceholder)) }
  else if c == 58 || c == 64 || c == 36 {
    Err(
      sql_reject(
        "`" ++ String::of_bytes(b.slice(at, at + 1)) ++ "`",
        at,
        "a named parameter is not bound: write `?1`, `?2` where the parameters go",
      ),
    )
  } else if is_digit(c) { Ok(sql_token_between(b, at, sql_past_number(b, at), SqlNumber)) }
  else if sql_is_name_byte(c) {
    let end = sql_past_word(b, at);
    let word = String::of_bytes(b.slice(at, end)).ascii_lower();
    Ok(sql_token_between(b, at, end, SqlWord({ text: word, quoted: false })))
  } else {
    Ok(sql_token_between(b, at, at + 1, SqlPunctuation(String::of_bytes(b.slice(at, at + 1)))))
  }
}

fn sqlite_quoted_word(
  b: Bytes,
  at: Int,
  close: Int,
) -> Result<{ token: SqlTokenAt, next: Int }, DbError> / {abort.raise} =
  match sqlite_end_of_quoted(b, at + 1, at, close) {
    Err(e) -> Err(e),
    Ok(e) ->
      Ok(
        sql_token_between(
          b,
          at,
          e,
          SqlWord({ text: String::of_bytes(b.slice(at + 1, e - 1)), quoted: true }),
        ),
      ),
  }

fn sqlite_end_of_quoted(
  b: Bytes,
  at: Int,
  open: Int,
  close: Int,
) -> Result<Int, DbError> / {abort.raise} =
  if at >= b.len() { Err(sql_unclosed(b, open, "a quoted identifier")) }
  else if close == 96 && b.at(at) == 96 && sql_byte_is(b, at + 1, 96) {
    sqlite_end_of_quoted(b, at + 2, open, close)
  } else if b.at(at) == close { Ok(at + 1) }
  else { sqlite_end_of_quoted(b, at + 1, open, close) }

fn sqlite_past_digits(b: Bytes, at: Int) -> Int / {abort.raise} =
  if at < b.len() && is_digit(b.at(at)) { sqlite_past_digits(b, at + 1) } else { at }

fn sql_token_between(
  b: Bytes,
  at: Int,
  next: Int,
  token: SqlToken,
) -> { token: SqlTokenAt, next: Int } / {abort.raise} =
  { token: { token: token, at: at, text: String::of_bytes(b.slice(at, next)) }, next: next }

fn sql_unclosed(b: Bytes, at: Int, what: String) -> DbError =
  db_error(
    "0A000",
    "",
    what ++ " opened" ++ sql_byte_prefix ++ at.to_string()
      ++ " is never closed, so the parser cannot tell where it ends and treats the rest of the statement as part of it",
  )

fn sql_end_of_literal(
  b: Bytes,
  at: Int,
  open: Int,
  escapes: Bool,
) -> Result<Int, DbError> / {abort.raise} =
  if at >= b.len() { Err(sql_unclosed(b, open, "a string literal")) }
  else if escapes && b.at(at) == 92 { sql_end_of_literal(b, at + 2, open, escapes) }
  else if b.at(at) == 39 && sql_byte_is(b, at + 1, 39) {
    sql_end_of_literal(b, at + 2, open, escapes)
  } else if b.at(at) == 39 { Ok(at + 1) }
  else { sql_end_of_literal(b, at + 1, open, escapes) }

fn sql_literal(
  b: Bytes,
  start: Int,
  body: Int,
  quote: Int,
  escapes: Bool,
) -> Result<{ token: SqlTokenAt, next: Int }, DbError> / {abort.raise} =
  match sql_end_of_literal(b, body, quote, escapes) {
    Err(e) -> Err(e),
    Ok(e) -> Ok(sql_token_between(b, start, e, SqlText)),
  }

fn sql_end_of_quoted(b: Bytes, at: Int, open: Int) -> Result<Int, DbError> / {abort.raise} =
  if at >= b.len() { Err(sql_unclosed(b, open, "a quoted identifier")) }
  else if b.at(at) == 34 && sql_byte_is(b, at + 1, 34) { sql_end_of_quoted(b, at + 2, open) }
  else if b.at(at) == 34 { Ok(at + 1) }
  else { sql_end_of_quoted(b, at + 1, open) }

fn sql_quoted_word(
  b: Bytes,
  start: Int,
  body: Int,
  quote: Int,
) -> Result<{ token: SqlTokenAt, next: Int }, DbError> / {abort.raise} =
  match sql_end_of_quoted(b, body, quote) {
    Err(e) -> Err(e),
    Ok(e) ->
      Ok(
        sql_token_between(
          b,
          start,
          e,
          SqlWord({ text: sql_unquoted(b, body, e - 1, b""), quoted: true }),
        ),
      ),
  }

fn sql_unquoted(b: Bytes, at: Int, end: Int, accumulator: Bytes) -> String / {abort.raise} =
  if at >= end { String::of_bytes(accumulator) }
  else if b.at(at) == 34 && sql_byte_is(b, at + 1, 34) {
    sql_unquoted(b, at + 2, end, accumulator.concat(byte_of_int(34)))
  } else { sql_unquoted(b, at + 1, end, accumulator.concat(byte_of_int(b.at(at)))) }

fn sql_digit_end(b: Bytes, at: Int) -> Option<Int> / {abort.raise} =
  if at >= b.len() || !is_digit(b.at(at)) { None } else { Some(sql_past_number(b, at)) }

fn sql_dollar_quoted(
  b: Bytes,
  at: Int,
) -> Result<{ token: SqlTokenAt, next: Int }, DbError> / {abort.raise} = {
  let tag_end = sql_past_tag(b, at + 1);
  if !sql_byte_is(b, tag_end, 36) { Err(sql_unclosed(b, at, "a dollar-quoted string")) } else {
    let tag = b.slice(at, tag_end + 1);
    match sql_find_tag(b, tag, tag_end + 1) {
      None -> Err(sql_unclosed(b, at, "a dollar-quoted string")),
      Some(e) -> Ok(sql_token_between(b, at, e + tag.len(), SqlText)),
    }
  }
}

fn sql_past_tag(b: Bytes, at: Int) -> Int / {abort.raise} =
  if at < b.len() && (sql_is_name_byte(b.at(at)) || is_digit(b.at(at))) { sql_past_tag(b, at + 1) }
  else { at }

fn sql_find_tag(b: Bytes, tag: Bytes, at: Int) -> Option<Int> / {abort.raise} =
  iterate(at, b.len() - at + 1, |i: Int|
    if i + tag.len() > b.len() { Stop(None) }
    else if sql_tag_at(b, tag, i) { Stop(Some(i)) }
    else { Continue(i + 1) })

fn sql_tag_at(b: Bytes, tag: Bytes, at: Int) -> Bool / {abort.raise} =
  range(0, tag.len()).fold(true, |accumulator: Bool, i: Int|
    accumulator && b.at(at + i) == tag.at(i))

fn sql_past_number(b: Bytes, at: Int) -> Int / {abort.raise} =
  if at < b.len() && (is_word_byte(b.at(at)) || b.at(at) == 46) { sql_past_number(b, at + 1) }
  else { at }

fn sql_past_word(b: Bytes, at: Int) -> Int / {abort.raise} =
  if at < b.len() && (sql_is_name_byte(b.at(at)) || is_digit(b.at(at)) || b.at(at) == 36) {
    sql_past_word(b, at + 1)
  } else { at }

fn sql_is_name_byte(c: Int) -> Bool =
  (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95 || c >= 128

/// A description of a token, which tests of the parser compare and errors quote back.
pub fn sql_token_summary(t: SqlTokenAt) -> String =
  match t.token {
    SqlWord(w) -> if w.quoted { "quoted:" ++ w.text } else { "word:" ++ w.text },
    SqlNumber -> "number:" ++ t.text,
    SqlText -> "text:" ++ t.text,
    SqlPlaceholder -> "placeholder:" ++ t.text,
    SqlPunctuation(p) -> "punct:" ++ p,
    SqlSemicolon -> "semi",
  }

/// `tokenize`, each token as `sql_token_summary` writes it.
pub fn sql_tokenize_summary(
  dialect: Dialect,
  sql: String,
) -> Result<List<String>, DbError> / {abort.raise} =
  match tokenize(dialect, sql) {
    Err(e) -> Err(e),
    Ok(ts) -> Ok(ts.map(|t: SqlTokenAt| sql_token_summary(t))),
  }

/// Describes a parsed statement: its kind, and the tables it writes and reads. The effects declared
/// at the call site are checked against `written` and `read`. The parser therefore rejects any
/// construct it cannot analyze, since it could do more than those effects say.
pub type SqlScan = { kind: StatementKind, tables: SqlTables }

/// Returns whether the statement writes. It is a write if its kind is a write or if it writes any
/// table, including a write inside a `with` clause.
pub fn scan_writes(s: SqlScan) -> Bool = kind_writes(s.kind) || s.tables.written.len() > 0

type SqlParser = { tokens: List<SqlTokenAt>, ctes: List<String>, depth: Int, end_pos: Int }

const sql_max_depth: Int = 32

fn sql_reject(where_: String, at: Int, reason: String) -> DbError =
  db_error(
    "0A000",
    "",
    "the database driver rejects this statement: " ++ where_ ++ sql_byte_prefix ++ at.to_string()
      ++ ". "
      ++ reason,
  )

fn sql_reject_token(t: SqlTokenAt, reason: String) -> DbError =
  sql_reject("`" ++ t.text ++ "`", t.at, reason)

fn sql_reject_here(parser: SqlParser, reason: String) -> DbError =
  match sql_head(parser.tokens) {
    Some(t) -> sql_reject_token(t, reason),
    None -> sql_reject("the statement ends", parser.end_pos, reason),
  }

fn sql_second_statement_error(at: Int) -> DbError =
  db_error(
    "0A000",
    "",
    "the database driver rejects this statement: a `Statement` must contain exactly one SQL statement, but it contains a second one after a `;`"
      ++ sql_byte_prefix
      ++ at.to_string()
      ++ ". Allowing only one statement stops injected text from adding a second statement",
  )

fn sql_head(tokens: List<SqlTokenAt>) -> Option<SqlTokenAt> =
  match tokens { [] -> None, [h, ..rest] -> Some(h) }

fn sql_rest(tokens: List<SqlTokenAt>) -> List<SqlTokenAt> =
  match tokens { [] -> [], [h, ..rest] -> rest }

fn sql_nth(tokens: List<SqlTokenAt>, n: Int) -> Option<SqlTokenAt> =
  if n <= 0 { sql_head(tokens) }
  else { match tokens { [] -> None, [h, ..rest] -> sql_nth(rest, n - 1) } }

fn sql_step(parser: SqlParser) -> SqlParser = { ..parser, tokens: sql_rest(parser.tokens) }

fn sql_at_word(parser: SqlParser, word: String) -> Bool =
  match sql_head(parser.tokens) { Some(t) -> sql_is_word(t.token, word), None -> false }

fn sql_at_punctuation(parser: SqlParser, k: String) -> Bool =
  match sql_head(parser.tokens) { Some(t) -> sql_is_punctuation(t.token, k), None -> false }

fn sql_eat_word(parser: SqlParser, word: String) -> { parser: SqlParser, ate: Bool } =
  if sql_at_word(parser, word) { { parser: sql_step(parser), ate: true } }
  else { { parser: parser, ate: false } }

fn sql_eat_punctuation(parser: SqlParser, k: String) -> { parser: SqlParser, ate: Bool } =
  if sql_at_punctuation(parser, k) { { parser: sql_step(parser), ate: true } }
  else { { parser: parser, ate: false } }

fn sql_expect_word(parser: SqlParser, word: String) -> Result<SqlParser, DbError> =
  if sql_at_word(parser, word) { Ok(sql_step(parser)) }
  else { Err(sql_reject_here(parser, "`" ++ word ++ "` was expected here")) }

fn sql_expect_punctuation(parser: SqlParser, k: String) -> Result<SqlParser, DbError> =
  if sql_at_punctuation(parser, k) { Ok(sql_step(parser)) }
  else { Err(sql_reject_here(parser, "`" ++ k ++ "` was expected here")) }

fn sql_identifier(
  parser: SqlParser,
  what: String,
) -> Result<{ parser: SqlParser, name: String }, DbError> =
  match sql_head(parser.tokens) {
    Some(t) -> match t.token {
      SqlWord(w) -> Ok({ parser: sql_step(parser), name: w.text }),
      _ -> Err(sql_reject_token(t, what ++ " was expected here")),
    },
    None -> Err(sql_reject_here(parser, what ++ " was expected here")),
  }

fn sql_qualified_name(
  parser: SqlParser,
  rest: Int,
) -> Result<{ parser: SqlParser, name: String }, DbError> = {
  let first = sql_identifier(parser, "a table name")?;
  sql_more_names(first.parser, first.name, first.parser.tokens.len() + 1)
}

fn sql_more_names(
  parser: SqlParser,
  name: String,
  left: Int,
) -> Result<{ parser: SqlParser, name: String }, DbError> =
  if left <= 0 {
    Err(db_error("XX000", "", "the SQL scanner looped more times than the input is long"))
  } else {
    if !sql_at_punctuation(parser, ".") { Ok({ parser: parser, name: name }) } else {
      match sql_nth(parser.tokens, 1) {
        Some(next) -> match next.token {
          SqlWord(w) -> {
            let after = sql_step(sql_step(parser));
            sql_more_names(after, w.text, left - 1)
          },
          _ -> Ok({ parser: parser, name: name }),
        },
        None -> Ok({ parser: parser, name: name }),
      }
    }
  }

fn sql_alias(parser: SqlParser) -> Result<SqlParser, DbError> = {
  let as_ = sql_eat_word(parser, "as");
  if as_.ate {
    let named = sql_identifier(as_.parser, "an alias")?;
    sql_alias_columns(named.parser)
  } else {
    match sql_head(parser.tokens) {
      Some(t) -> match t.token {
        SqlWord(w) -> if w.quoted || !sql_reserved(w.text) { sql_alias_columns(sql_step(parser)) }
        else { Ok(parser) },
        _ -> Ok(parser),
      },
      None -> Ok(parser),
    }
  }
}

fn sql_alias_columns(parser: SqlParser) -> Result<SqlParser, DbError> = {
  let open = sql_eat_punctuation(parser, "(");
  if open.ate { sql_name_list(open.parser, open.parser.tokens.len() + 1) } else { Ok(parser) }
}

fn sql_name_list(parser: SqlParser, left: Int) -> Result<SqlParser, DbError> =
  if left <= 0 {
    Err(db_error("XX000", "", "the SQL scanner looped more times than the input is long"))
  } else {
    let first = sql_identifier(parser, "a column name")?;
    let comma = sql_eat_punctuation(first.parser, ",");
    if comma.ate { sql_name_list(comma.parser, left - 1) }
    else { sql_expect_punctuation(first.parser, ")") }
  }

const sql_syntactic_forms: List<String> =
  ["array", "cast", "exists", "row", "any", "some", "nullif"]

const sql_nondeterministic_functions: List<String> =
  [
    "now",
    "random",
    "current_timestamp",
    "current_date",
    "current_time",
    "localtime",
    "localtimestamp",
    "clock_timestamp",
    "statement_timestamp",
    "transaction_timestamp",
    "timeofday",
    "gen_random_uuid",
  ]

const sql_allowed_functions: List<String> =
  [
    "avg",
    "count",
    "max",
    "min",
    "sum",
    "coalesce",
    "greatest",
    "least",
    "nullif",
    "abs",
    "ceil",
    "ceiling",
    "div",
    "exp",
    "floor",
    "ln",
    "log",
    "mod",
    "power",
    "round",
    "sign",
    "sqrt",
    "trunc",
    "btrim",
    "char_length",
    "character_length",
    "concat",
    "concat_ws",
    "decode",
    "encode",
    "left",
    "length",
    "lower",
    "lpad",
    "ltrim",
    "md5",
    "octet_length",
    "overlay",
    "position",
    "repeat",
    "replace",
    "reverse",
    "right",
    "rpad",
    "rtrim",
    "split_part",
    "starts_with",
    "strpos",
    "substr",
    "substring",
    "translate",
    "trim",
    "upper",
    "json_build_array",
    "json_build_object",
    "jsonb_array_length",
    "jsonb_build_array",
    "jsonb_build_object",
    "jsonb_extract_path",
    "jsonb_extract_path_text",
    "jsonb_strip_nulls",
    "jsonb_typeof",
    "to_json",
    "to_jsonb",
  ]

const sql_clause_words: List<String> =
  [
    "from",
    "where",
    "group",
    "having",
    "window",
    "order",
    "limit",
    "offset",
    "fetch",
    "for",
    "union",
    "intersect",
    "except",
    "returning",
    "using",
    "on",
    "set",
    "values",
    "join",
    "inner",
    "left",
    "right",
    "full",
    "cross",
    "natural",
    "as",
  ]

fn sql_reserved(word: String) -> Bool =
  sql_clause_words.contains(word)
    || [
      "select",
      "insert",
      "update",
      "delete",
      "with",
      "into",
      "and",
      "or",
      "not",
      "null",
      "is",
      "in",
      "between",
      "like",
      "ilike",
      "similar",
      "when",
      "then",
      "else",
      "end",
      "case",
      "asc",
      "desc",
      "nulls",
      "first",
      "last",
      "all",
      "distinct",
      "only",
      "lateral",
      "default",
      "conflict",
      "do",
      "nothing",
      "recursive",
      "materialized",
      "by",
      "outer",
    ].contains(
      word,
    )

fn sql_check_call(parser: SqlParser) -> Result<SqlParser, DbError> =
  match sql_head(parser.tokens) {
    None -> Ok(parser),
    Some(t) -> match t.token {
      SqlWord(w) -> if w.quoted || !sql_at_punctuation(sql_step(parser), "(") { Ok(parser) }
      else if sql_reserved(w.text) || sql_syntactic_forms.contains(w.text)
          || sql_allowed_functions.contains(w.text) { Ok(parser) } else {
        Err(
          sql_reject_token(
            t,
            "this function call is not allowed: a call can read tables that are not in the statement's own table list, and the checker can only report the tables named in the statement",
          ),
        )
      },
      _ -> Ok(parser),
    },
  }

fn sql_reject_nondeterministic(parser: SqlParser) -> Result<SqlParser, DbError> =
  match sql_reject_in(sql_nondeterministic_functions, parser.tokens) {
    Err(e) -> Err(e),
    Ok(_) -> Ok(parser),
  }

fn sql_reject_in(words: List<String>, tokens: List<SqlTokenAt>) -> Result<(), DbError> =
  match tokens {
    [] -> Ok(()),
    [t, ..rest] -> match t.token {
      SqlWord(w) -> if !w.quoted && words.contains(w.text) {
        Err(sql_nondeterministic_error(t, w.text))
      } else { sql_reject_in(words, rest) },
      _ -> sql_reject_in(words, rest),
    },
  }

fn sql_nondeterministic_error(t: SqlTokenAt, word: String) -> DbError =
  sql_reject_token(
    t,
    "`" ++ word
      ++ "` returns a different value each time it runs, so it is not allowed in statement text: pass the value as a parameter, so the call site shows where the value comes from",
  )

fn sql_statement(
  parser: SqlParser,
  left: Int,
) -> Result<{ parser: SqlParser, scan: SqlScan }, DbError> / {abort.raise} =
  if left <= 0 { panic("the SQL parser recursed more times than the statement has tokens") } else {
    let deeper = { ..parser, depth: parser.depth + 1 };
    if deeper.depth > sql_max_depth {
      Err(sql_reject_here(parser, "this statement is nested too deeply for the SQL parser"))
    } else {
      match sql_reject_nondeterministic(deeper) {
        Err(e) -> Err(e),
        Ok(check_statement) -> sql_with_clause(check_statement, left - 1),
      }
    }
  }

fn sql_with_clause(
  parser: SqlParser,
  left: Int,
) -> Result<{ parser: SqlParser, scan: SqlScan }, DbError> / {abort.raise} =
  if left <= 0 { panic("the SQL parser recursed more times than the statement has tokens") } else {
    let opening = sql_eat_word(parser, "with");
    if !opening.ate { sql_body(parser, left - 1) } else {
      let recursive = sql_eat_word(opening.parser, "recursive");
      sql_cte_list(recursive.parser, recursive.ate, no_sql_tables, left - 1)
    }
  }

fn sql_cte_list(
  parser: SqlParser,
  recursive: Bool,
  gathered: SqlTables,
  left: Int,
) -> Result<{ parser: SqlParser, scan: SqlScan }, DbError> / {abort.raise} =
  if left <= 0 { panic("the SQL parser recursed more times than the statement has tokens") } else {
    match sql_cte(parser, recursive, left - 1) {
      Err(e) -> Err(e),
      Ok(one) -> {
        let absorbed = sql_merge_tables(gathered, one.tables);
        let comma = sql_eat_punctuation(one.parser, ",");
        if comma.ate { sql_cte_list(comma.parser, recursive, absorbed, left - 1) } else {
          match sql_body(comma.parser, left - 1) {
            Err(e) -> Err(e),
            Ok(b) ->
              Ok({
                parser: b.parser,
                scan: { kind: b.scan.kind, tables: sql_merge_tables(absorbed, b.scan.tables) },
              }),
          }
        }
      },
    }
  }

fn sql_cte(
  parser: SqlParser,
  recursive: Bool,
  left: Int,
) -> Result<{ parser: SqlParser, tables: SqlTables }, DbError> / {abort.raise} =
  if left <= 0 { panic("the SQL parser recursed more times than the statement has tokens") } else {
    let named = sql_identifier(parser, "a common table expression's name")?;
    let scope = if recursive { named.parser.ctes.push(named.name) } else { named.parser.ctes };
    let in_scope = { ..named.parser, ctes: scope };
    let columns = sql_eat_punctuation(in_scope, "(");
    match sql_after_columns(columns) {
      Err(e) -> Err(e),
      Ok(listed) -> match sql_expect_word(listed, "as") {
        Err(e) -> Err(e),
        Ok(after_as) -> {
          let not_ = sql_eat_word(after_as, "not");
          let materialized = sql_eat_word(not_.parser, "materialized");
          match sql_expect_punctuation(materialized.parser, "(") {
            Err(e) -> Err(e),
            Ok(inside) -> match sql_statement(inside, left - 1) {
              Err(e) -> Err(e),
              Ok(inner) -> match sql_expect_punctuation(inner.parser, ")") {
                Err(e) -> Err(e),
                Ok(after) ->
                  Ok({
                    parser: { ..after, ctes: after.ctes.push(named.name) },
                    tables: sql_without_names(inner.scan.tables, after.ctes),
                  }),
              },
            },
          }
        },
      },
    }
  }

fn sql_after_columns(columns: { parser: SqlParser, ate: Bool }) -> Result<SqlParser, DbError> =
  if columns.ate { sql_name_list(columns.parser, columns.parser.tokens.len() + 1) }
  else { Ok(columns.parser) }

fn sql_without_names(tables: SqlTables, names: List<String>) -> SqlTables =
  {
    written: names.fold(tables.written, |accumulator: List<String>, n: String|
      sql_without_table(accumulator, n)),
    read: names.fold(tables.read, |accumulator: List<String>, n: String|
      sql_without_table(accumulator, n)),
  }

fn sql_body(
  parser: SqlParser,
  left: Int,
) -> Result<{ parser: SqlParser, scan: SqlScan }, DbError> / {abort.raise} =
  if left <= 0 { panic("the SQL parser recursed more times than the statement has tokens") } else {
    match sql_head(parser.tokens) {
      None -> Err(sql_reject_here(parser, "this statement is empty")),
      Some(t) -> if sql_is_semicolon(t.token) { Err(sql_second_statement_error(t.at)) }
      else if sql_is_word(t.token, "select") || sql_is_punctuation(t.token, "(") {
        match sql_select_statement(parser, left - 1) {
          Err(e) -> Err(e),
          Ok(s) -> Ok({ parser: s.parser, scan: { kind: Select, tables: s.tables } }),
        }
      } else if sql_is_word(t.token, "values") {
        match sql_select_statement(parser, left - 1) {
          Err(e) -> Err(e),
          Ok(s) -> Ok({ parser: s.parser, scan: { kind: Values, tables: s.tables } }),
        }
      } else if sql_is_word(t.token, "insert") { sql_insert(parser, left - 1) }
      else if sql_is_word(t.token, "update") { sql_update(parser, left - 1) }
      else if sql_is_word(t.token, "delete") { sql_delete(parser, left - 1) } else {
        Err(
          sql_reject_token(
            t,
            "a statement begins with one of `select`, `insert`, `update`, `delete` or `values`, with an optional `with`",
          ),
        )
      },
    }
  }

fn sql_select_statement(
  parser: SqlParser,
  left: Int,
) -> Result<{ parser: SqlParser, tables: SqlTables }, DbError> / {abort.raise} =
  if left <= 0 { panic("the SQL parser recursed more times than the statement has tokens") } else {
    match sql_select_core(parser, left - 1) {
      Err(e) -> Err(e),
      Ok(core) -> {
        match sql_set_operations(core.parser, core.tables, left - 1) {
          Err(e) -> Err(e),
          Ok(armed) -> sql_select_tail(armed.parser, armed.tables, left - 1),
        }
      },
    }
  }

fn sql_set_operations(
  parser: SqlParser,
  tables: SqlTables,
  left: Int,
) -> Result<{ parser: SqlParser, tables: SqlTables }, DbError> / {abort.raise} =
  if left <= 0 { panic("the SQL parser recursed more times than the statement has tokens") } else {
    if sql_at_word(parser, "union") || sql_at_word(parser, "intersect")
        || sql_at_word(parser, "except") {
      let opened = sql_step(parser);
      let quantified = sql_eat_word(sql_eat_word(opened, "all").parser, "distinct");
      match sql_select_core(quantified.parser, left - 1) {
        Err(e) -> Err(e),
        Ok(inner) ->
          sql_set_operations(inner.parser, sql_merge_tables(tables, inner.tables), left - 1),
      }
    } else { Ok({ parser: parser, tables: tables }) }
  }

fn sql_select_tail(
  parser: SqlParser,
  tables: SqlTables,
  left: Int,
) -> Result<{ parser: SqlParser, tables: SqlTables }, DbError> / {abort.raise} =
  if left <= 0 { panic("the SQL parser recursed more times than the statement has tokens") } else {
    let ordered = sql_eat_word(parser, "order");
    let after_order = if ordered.ate {
      match sql_expect_word(ordered.parser, "by") {
        Err(e) -> Err(e),
        Ok(after) ->
          sql_skip_expression(after, tables, ["limit", "offset", "fetch", "for"], false, left - 1),
      }
    } else { Ok({ parser: parser, tables: tables }) };
    match after_order { Err(e) -> Err(e), Ok(o) -> sql_limit_clauses(o.parser, o.tables, left - 1) }
  }

fn sql_limit_clauses(
  parser: SqlParser,
  tables: SqlTables,
  left: Int,
) -> Result<{ parser: SqlParser, tables: SqlTables }, DbError> / {abort.raise} =
  if left <= 0 { panic("the SQL parser recursed more times than the statement has tokens") } else {
    if sql_at_word(parser, "limit") || sql_at_word(parser, "offset") {
      let opened = sql_step(parser);
      match sql_skip_expression(
          opened,
          tables,
          ["limit", "offset", "fetch", "for"],
          false,
          left - 1,
        ) {
        Err(e) -> Err(e),
        Ok(o) -> sql_limit_clauses(o.parser, o.tables, left - 1),
      }
    } else if sql_at_word(parser, "fetch") || sql_at_word(parser, "for") {
      match sql_head(parser.tokens) {
        Some(t) ->
          Err(
            sql_reject_token(
              t,
              "`fetch` and the row-locking clauses are not supported: a row lock is a write, and this checker only accepts read-only statements",
            ),
          ),
        None -> Err(sql_reject_here(parser, "the statement ends mid-clause")),
      }
    } else { Ok({ parser: parser, tables: tables }) }
  }

fn sql_select_core(
  parser: SqlParser,
  left: Int,
) -> Result<{ parser: SqlParser, tables: SqlTables }, DbError> / {abort.raise} =
  if left <= 0 { panic("the SQL parser recursed more times than the statement has tokens") } else {
    let open = sql_eat_punctuation(parser, "(");
    if open.ate {
      match sql_select_statement(open.parser, left - 1) {
        Err(e) -> Err(e),
        Ok(inner) -> match sql_expect_punctuation(inner.parser, ")") {
          Err(e) -> Err(e),
          Ok(after) -> Ok({ parser: after, tables: inner.tables }),
        },
      }
    } else if sql_at_word(parser, "values") {
      sql_values_rows(sql_step(parser), no_sql_tables, parser.tokens.len() + 1)
    } else {
      let opened = sql_expect_word(parser, "select");
      match opened {
        Err(e) -> Err(e),
        Ok(after_select) -> {
          let alls = sql_eat_word(after_select, "all");
          let distinct = sql_eat_word(alls.parser, "distinct");
          let on_prefix = if distinct.ate { sql_eat_word(distinct.parser, "on") }
          else { { parser: distinct.parser, ate: false } };
          let after_prefix = if on_prefix.ate {
            match sql_expect_punctuation(on_prefix.parser, "(") {
              Err(e) -> Err(e),
              Ok(open) -> sql_skip_parens(open, no_sql_tables, left - 1),
            }
          } else { Ok({ parser: distinct.parser, tables: no_sql_tables }) };
          match after_prefix {
            Err(e) -> Err(e),
            Ok(prefixed) -> match sql_target_list(prefixed.parser, prefixed.tables, left - 1) {
              Err(e) -> Err(e),
              Ok(targets) -> sql_select_rest(targets, left - 1),
            },
          }
        },
      }
    }
  }

fn sql_select_rest(
  at: { parser: SqlParser, tables: SqlTables },
  left: Int,
) -> Result<{ parser: SqlParser, tables: SqlTables }, DbError> / {abort.raise} =
  if left <= 0 { panic("the SQL parser recursed more times than the statement has tokens") } else {
    let from = sql_source_after_from(at, left - 1)?;
    let filtered = sql_select_filter(from, left - 1)?;
    let grouped = sql_select_grouped(filtered, left - 1)?;
    sql_select_having(grouped, left - 1)
  }

fn sql_source_after_from(
  at: { parser: SqlParser, tables: SqlTables },
  left: Int,
) -> Result<{ parser: SqlParser, tables: SqlTables }, DbError> / {abort.raise} =
  if left <= 0 { panic("the SQL parser recursed more times than the statement has tokens") } else {
    let from = sql_eat_word(at.parser, "from");
    if from.ate { sql_source_list(from.parser, at.tables, left - 1) } else { Ok(at) }
  }

fn sql_select_filter(
  at: { parser: SqlParser, tables: SqlTables },
  left: Int,
) -> Result<{ parser: SqlParser, tables: SqlTables }, DbError> / {abort.raise} =
  if left <= 0 { panic("the SQL parser recursed more times than the statement has tokens") } else {
    let where_ = sql_eat_word(at.parser, "where");
    if where_.ate {
      sql_skip_expression(where_.parser, at.tables, sql_clause_words, false, left - 1)
    } else { Ok(at) }
  }

fn sql_select_grouped(
  at: { parser: SqlParser, tables: SqlTables },
  left: Int,
) -> Result<{ parser: SqlParser, tables: SqlTables }, DbError> / {abort.raise} =
  if left <= 0 { panic("the SQL parser recursed more times than the statement has tokens") } else {
    let group = sql_eat_word(at.parser, "group");
    if group.ate {
      match sql_expect_word(group.parser, "by") {
        Err(e) -> Err(e),
        Ok(after) -> sql_skip_expression(after, at.tables, sql_clause_words, false, left - 1),
      }
    } else { Ok(at) }
  }

fn sql_select_having(
  at: { parser: SqlParser, tables: SqlTables },
  left: Int,
) -> Result<{ parser: SqlParser, tables: SqlTables }, DbError> / {abort.raise} =
  if left <= 0 { panic("the SQL parser recursed more times than the statement has tokens") } else {
    let having = sql_eat_word(at.parser, "having");
    let after = if having.ate {
      sql_skip_expression(having.parser, at.tables, sql_clause_words, false, left - 1)
    } else { Ok(at) };
    match after {
      Err(e) -> Err(e),
      Ok(h) -> if sql_at_word(h.parser, "window") {
        match sql_head(h.parser.tokens) {
          Some(t) -> Err(sql_reject_token(t, "window definitions are not modelled")),
          None -> Err(sql_reject_here(h.parser, "the statement ends mid-clause")),
        }
      } else { Ok(h) },
    }
  }

fn sql_source_list(
  parser: SqlParser,
  tables: SqlTables,
  left: Int,
) -> Result<{ parser: SqlParser, tables: SqlTables }, DbError> / {abort.raise} =
  if left <= 0 { panic("the SQL parser recursed more times than the statement has tokens") } else {
    match sql_source_item(parser, tables, left - 1) {
      Err(e) -> Err(e),
      Ok(one) -> {
        let comma = sql_eat_punctuation(one.parser, ",");
        if comma.ate { sql_source_list(comma.parser, one.tables, left - 1) } else { Ok(one) }
      },
    }
  }

fn sql_source_item(
  parser: SqlParser,
  tables: SqlTables,
  left: Int,
) -> Result<{ parser: SqlParser, tables: SqlTables }, DbError> / {abort.raise} =
  if left <= 0 { panic("the SQL parser recursed more times than the statement has tokens") } else {
    match sql_source_base(parser, tables, left - 1) {
      Err(e) -> Err(e),
      Ok(base) -> sql_joins(base.parser, base.tables, left - 1),
    }
  }

fn sql_joins(
  parser: SqlParser,
  tables: SqlTables,
  left: Int,
) -> Result<{ parser: SqlParser, tables: SqlTables }, DbError> / {abort.raise} =
  if left <= 0 { panic("the SQL parser recursed more times than the statement has tokens") } else {
    let natural = sql_eat_word(parser, "natural");
    let joined = sql_at_word(natural.parser, "join") || sql_at_word(natural.parser, "inner")
      || sql_at_word(natural.parser, "left")
      || sql_at_word(natural.parser, "right")
      || sql_at_word(natural.parser, "full")
      || sql_at_word(natural.parser, "cross");
    if !joined {
      if natural.ate {
        Err(sql_reject_here(natural.parser, "`natural` must be followed by a join"))
      } else { Ok({ parser: parser, tables: tables }) }
    } else {
      let inner = sql_eat_word(natural.parser, "inner");
      let side = sql_eat_word(inner.parser, "left");
      let side2 = sql_eat_word(side.parser, "right");
      let side3 = sql_eat_word(side2.parser, "full");
      let after_side = if side.ate || side2.ate || side3.ate {
        sql_eat_word(side3.parser, "outer").parser
      } else { side3.parser };
      let cross = sql_eat_word(after_side, "cross");
      let join = sql_expect_word(cross.parser, "join");
      match join {
        Err(e) -> Err(e),
        Ok(after_join) -> match sql_source_base(after_join, tables, left - 1) {
          Err(e) -> Err(e),
          Ok(base) -> {
            let on = sql_eat_word(base.parser, "on");
            let after_on = if on.ate {
              sql_skip_expression(on.parser, base.tables, sql_clause_words, true, left - 1)
            } else {
              let using = sql_eat_word(base.parser, "using");
              if using.ate {
                match sql_expect_punctuation(using.parser, "(") {
                  Err(e) -> Err(e),
                  Ok(open) -> match sql_name_list(open, open.tokens.len() + 1) {
                    Err(e) -> Err(e),
                    Ok(after) -> Ok({ parser: after, tables: base.tables }),
                  },
                }
              } else { Ok({ parser: base.parser, tables: base.tables }) }
            };
            match after_on {
              Err(e) -> Err(e),
              Ok(tail) -> sql_joins(tail.parser, tail.tables, left - 1),
            }
          },
        },
      }
    }
  }

fn sql_source_base(
  parser: SqlParser,
  tables: SqlTables,
  left: Int,
) -> Result<{ parser: SqlParser, tables: SqlTables }, DbError> / {abort.raise} =
  if left <= 0 { panic("the SQL parser recursed more times than the statement has tokens") } else {
    let lateral = sql_eat_word(parser, "lateral");
    let open_at = match sql_head(lateral.parser.tokens) {
      Some(t) -> t.at,
      None -> lateral.parser.end_pos,
    };
    let open = sql_eat_punctuation(lateral.parser, "(");
    if open.ate {
      if sql_at_word(open.parser, "select") || sql_at_word(open.parser, "values")
          || sql_at_word(open.parser, "with") {
        match sql_statement(open.parser, left - 1) {
          Err(e) -> Err(e),
          Ok(inner) -> match sql_expect_punctuation(inner.parser, ")") {
            Err(e) -> Err(e),
            Ok(after) -> {
              let aliased = sql_alias(after);
              match aliased {
                Err(e) -> Err(e),
                Ok(done) ->
                  Ok({ parser: done, tables: sql_merge_tables(tables, inner.scan.tables) }),
              }
            },
          },
        }
      } else { Err(sql_reject("`(`", open_at, "a parenthesised item in `from` is not supported")) }
    } else {
      let only = sql_eat_word(lateral.parser, "only");
      match sql_qualified_name(only.parser, 0) {
        Err(e) -> Err(e),
        Ok(named) -> if sql_at_punctuation(named.parser, "(") {
          match sql_head(named.parser.tokens) {
            Some(t) ->
              Err(
                sql_reject_token(
                  t,
                  "a function that returns rows in `from` is not supported: the checker cannot tell which tables it reads",
                ),
              ),
            None -> Err(sql_reject_here(named.parser, "the statement ends mid-clause")),
          }
        } else {
          let starred = sql_eat_punctuation(named.parser, "*");
          let noted = if named.parser.ctes.contains(named.name) { tables }
          else { sql_note_read(tables, named.name) };
          match sql_alias(starred.parser) {
            Err(e) -> Err(e),
            Ok(after) -> Ok({ parser: after, tables: noted }),
          }
        },
      }
    }
  }

fn sql_target_list(
  parser: SqlParser,
  tables: SqlTables,
  left: Int,
) -> Result<{ parser: SqlParser, tables: SqlTables }, DbError> / {abort.raise} =
  if left <= 0 { panic("the SQL parser made more nested calls than the statement has tokens") }
  else {
    match sql_skip_expression(parser, tables, sql_clause_words, true, left - 1) {
      Err(e) -> Err(e),
      Ok(item) -> {
        let as_ = sql_eat_word(item.parser, "as");
        let named = if as_.ate {
          match sql_identifier(as_.parser, "an output column name") {
            Err(e) -> Err(e),
            Ok(n) -> Ok(n.parser),
          }
        } else { Ok(item.parser) };
        match named {
          Err(e) -> Err(e),
          Ok(after) -> {
            let comma = sql_eat_punctuation(after, ",");
            if comma.ate { sql_target_list(comma.parser, item.tables, left - 1) }
            else { Ok({ parser: after, tables: item.tables }) }
          },
        }
      },
    }
  }

fn sql_insert(
  parser: SqlParser,
  left: Int,
) -> Result<{ parser: SqlParser, scan: SqlScan }, DbError> / {abort.raise} =
  if left <= 0 { panic("the SQL parser made more nested calls than the statement has tokens") }
  else {
    let after_insert = sql_expect_word(parser, "insert")?;
    let into = sql_expect_word(after_insert, "into")?;
    let named = sql_qualified_name(into, 0)?;
    let to_parameter = sql_note_written(no_sql_tables, named.name);
    let aliased = sql_alias(named.parser)?;
    let columns = sql_eat_punctuation(aliased, "(");
    match sql_after_columns(columns) {
      Err(e) -> Err(e),
      Ok(after_columns) -> {
        let default = sql_eat_word(after_columns, "default");
        match sql_insert_source(default, after_columns, left - 1) {
          Err(e) -> Err(e),
          Ok(source) -> {
            let rows = sql_merge_tables(to_parameter, source.tables);
            if sql_at_word(source.parser, "on") {
              match sql_head(source.parser.tokens) {
                Some(t) ->
                  Err(
                    sql_reject_token(
                      t,
                      "`on conflict` is not modelled: an upsert is a write whose outcome the engine cannot reproduce",
                    ),
                  ),
                None -> Err(sql_reject_here(source.parser, "the statement ends mid-clause")),
              }
            } else {
              match sql_returning(source.parser, rows, left - 1) {
                Err(e) -> Err(e),
                Ok(done) ->
                  Ok({ parser: done.parser, scan: { kind: Insert, tables: done.tables } }),
              }
            }
          },
        }
      },
    }
  }

fn sql_insert_source(
  default: { parser: SqlParser, ate: Bool },
  after_columns: SqlParser,
  left: Int,
) -> Result<{ parser: SqlParser, tables: SqlTables }, DbError> / {abort.raise} =
  if left <= 0 { panic("the SQL parser made more nested calls than the statement has tokens") }
  else {
    if default.ate {
      match sql_expect_word(default.parser, "values") {
        Err(e) -> Err(e),
        Ok(after) -> Ok({ parser: after, tables: no_sql_tables }),
      }
    } else { sql_select_statement(after_columns, left - 1) }
  }

fn sql_update(
  parser: SqlParser,
  left: Int,
) -> Result<{ parser: SqlParser, scan: SqlScan }, DbError> / {abort.raise} =
  if left <= 0 { panic("the SQL parser made more nested calls than the statement has tokens") }
  else {
    let after_update = sql_expect_word(parser, "update")?;
    let only = sql_eat_word(after_update, "only");
    let named = sql_qualified_name(only.parser, 0)?;
    let to_parameter = sql_note_written(no_sql_tables, named.name);
    let aliased = sql_alias(named.parser)?;
    let after_set = sql_expect_word(aliased, "set")?;
    let assignments = sql_skip_expression(
      after_set,
      to_parameter,
      ["from", "where", "returning"],
      false,
      left - 1,
    )?;
    let from = sql_eat_word(assignments.parser, "from");
    let after_from = if from.ate { sql_source_list(from.parser, assignments.tables, left - 1) }
    else { Ok(assignments) };
    let sourced = match after_from { Err(e) -> Err(e), Ok(s) -> Ok(s) };
    let filtered = match sourced {
      Err(e) -> Err(e),
      Ok(s) -> {
        let where_ = sql_eat_word(s.parser, "where");
        if where_.ate {
          sql_skip_expression(where_.parser, s.tables, ["returning"], false, left - 1)
        } else { Ok(s) }
      },
    };
    match filtered {
      Err(e) -> Err(e),
      Ok(f) -> match sql_returning(f.parser, f.tables, left - 1) {
        Err(e) -> Err(e),
        Ok(done) -> Ok({ parser: done.parser, scan: { kind: Update, tables: done.tables } }),
      },
    }
  }

fn sql_delete(
  parser: SqlParser,
  left: Int,
) -> Result<{ parser: SqlParser, scan: SqlScan }, DbError> / {abort.raise} =
  if left <= 0 { panic("the SQL parser made more nested calls than the statement has tokens") }
  else {
    let after_delete = sql_expect_word(parser, "delete")?;
    let from = sql_expect_word(after_delete, "from")?;
    let only = sql_eat_word(from, "only");
    let named = sql_qualified_name(only.parser, 0)?;
    let to_parameter = sql_note_written(no_sql_tables, named.name);
    let aliased = sql_alias(named.parser)?;
    let using = sql_eat_word(aliased, "using");
    let sourced = if using.ate { sql_source_list(using.parser, to_parameter, left - 1) }
    else { Ok({ parser: aliased, tables: to_parameter }) };
    let filtered = match sourced {
      Err(e) -> Err(e),
      Ok(s) -> {
        let where_ = sql_eat_word(s.parser, "where");
        if where_.ate {
          sql_skip_expression(where_.parser, s.tables, ["returning"], false, left - 1)
        } else { Ok(s) }
      },
    };
    match filtered {
      Err(e) -> Err(e),
      Ok(f) -> match sql_returning(f.parser, f.tables, left - 1) {
        Err(e) -> Err(e),
        Ok(done) -> Ok({ parser: done.parser, scan: { kind: Delete, tables: done.tables } }),
      },
    }
  }

fn sql_returning(
  parser: SqlParser,
  tables: SqlTables,
  left: Int,
) -> Result<{ parser: SqlParser, tables: SqlTables }, DbError> / {abort.raise} =
  if left <= 0 { panic("the SQL parser made more nested calls than the statement has tokens") }
  else {
    let returning = sql_eat_word(parser, "returning");
    if returning.ate { sql_skip_expression(returning.parser, tables, [], false, left - 1) }
    else { Ok({ parser: parser, tables: tables }) }
  }

fn sql_values_rows(
  parser: SqlParser,
  tables: SqlTables,
  left: Int,
) -> Result<{ parser: SqlParser, tables: SqlTables }, DbError> =
  if left <= 0 {
    Err(
      db_error("XX000", "", "the SQL parser read more `values` rows than the statement has tokens"),
    )
  } else {
    let open = sql_expect_punctuation(parser, "(");
    match open {
      Err(e) -> Err(e),
      Ok(after) -> match sql_row_body(after, tables, 1, after.tokens.len() + 1) {
        Err(e) -> Err(e),
        Ok(row) -> {
          let comma = sql_eat_punctuation(row.parser, ",");
          if comma.ate { sql_values_rows(comma.parser, row.tables, left - 1) } else { Ok(row) }
        },
      },
    }
  }

fn sql_row_body(
  parser: SqlParser,
  tables: SqlTables,
  depth: Int,
  left: Int,
) -> Result<{ parser: SqlParser, tables: SqlTables }, DbError> =
  if left <= 0 {
    Err(
      db_error(
        "XX000",
        "",
        "the SQL parser took more steps in a row than the statement has tokens",
      ),
    )
  } else {
    match sql_head(parser.tokens) {
      None -> Err(sql_reject_here(parser, "this row is never closed")),
      Some(t) -> if sql_is_punctuation(t.token, "(") {
        sql_row_body(sql_step(parser), tables, depth + 1, left - 1)
      } else if sql_is_punctuation(t.token, ")") {
        if depth == 1 { Ok({ parser: sql_step(parser), tables: tables }) }
        else { sql_row_body(sql_step(parser), tables, depth - 1, left - 1) }
      } else if sql_is_semicolon(t.token) { Err(sql_second_statement_error(t.at)) } else {
        match sql_check_call(parser) {
          Err(e) -> Err(e),
          Ok(_) -> sql_row_body(sql_step(parser), tables, depth, left - 1),
        }
      },
    }
  }

fn sql_skip_expression(
  parser: SqlParser,
  tables: SqlTables,
  stops: List<String>,
  stop_at_comma: Bool,
  left: Int,
) -> Result<{ parser: SqlParser, tables: SqlTables }, DbError> / {abort.raise} =
  if left <= 0 { panic("the SQL parser made more nested calls than the statement has tokens") }
  else {
    match sql_head(parser.tokens) {
      None -> Ok({ parser: parser, tables: tables }),
      Some(t) -> if sql_is_semicolon(t.token) { Err(sql_second_statement_error(t.at)) }
      else if sql_is_punctuation(t.token, "(") {
        sql_skip_paren(parser, tables, stops, stop_at_comma, left - 1)
      } else if sql_is_punctuation(t.token, ")") { Ok({ parser: parser, tables: tables }) }
      else if stop_at_comma && sql_is_punctuation(t.token, ",") {
        Ok({ parser: parser, tables: tables })
      } else { sql_skip_word(parser, t, tables, stops, stop_at_comma, left - 1) },
    }
  }

fn sql_skip_word(
  parser: SqlParser,
  t: SqlTokenAt,
  tables: SqlTables,
  stops: List<String>,
  stop_at_comma: Bool,
  left: Int,
) -> Result<{ parser: SqlParser, tables: SqlTables }, DbError> / {abort.raise} =
  if left <= 0 { panic("the SQL parser made more nested calls than the statement has tokens") }
  else {
    match t.token {
      SqlWord(w) -> if !w.quoted && stops.contains(w.text) {
        Ok({ parser: parser, tables: tables })
      } else {
        match sql_check_call(parser) {
          Err(e) -> Err(e),
          Ok(_) -> sql_skip_expression(sql_step(parser), tables, stops, stop_at_comma, left - 1),
        }
      },
      _ -> match sql_check_call(parser) {
        Err(e) -> Err(e),
        Ok(_) -> sql_skip_expression(sql_step(parser), tables, stops, stop_at_comma, left - 1),
      },
    }
  }

fn sql_skip_paren(
  parser: SqlParser,
  tables: SqlTables,
  stops: List<String>,
  stop_at_comma: Bool,
  left: Int,
) -> Result<{ parser: SqlParser, tables: SqlTables }, DbError> / {abort.raise} =
  if left <= 0 { panic("the SQL parser made more nested calls than the statement has tokens") }
  else {
    let opened = sql_step(parser);
    if sql_at_word(opened, "select") || sql_at_word(opened, "values")
        || sql_at_word(opened, "with") {
      match sql_statement(opened, left - 1) {
        Err(e) -> Err(e),
        Ok(inner) -> match sql_expect_punctuation(inner.parser, ")") {
          Err(e) -> Err(e),
          Ok(after) ->
            sql_skip_expression(
              after,
              sql_merge_tables(tables, inner.scan.tables),
              stops,
              stop_at_comma,
              left - 1,
            ),
        },
      }
    } else {
      match sql_skip_group(opened, tables, 1, left - 1) {
        Err(e) -> Err(e),
        Ok(closed) ->
          sql_skip_expression(closed.parser, closed.tables, stops, stop_at_comma, left - 1),
      }
    }
  }

fn sql_skip_group(
  parser: SqlParser,
  tables: SqlTables,
  depth: Int,
  left: Int,
) -> Result<{ parser: SqlParser, tables: SqlTables }, DbError> / {abort.raise} =
  if left <= 0 { panic("the SQL parser made more nested calls than the statement has tokens") }
  else {
    match sql_head(parser.tokens) {
      None -> Err(sql_reject_here(parser, "this `(` has no matching `)`")),
      Some(t) -> if sql_is_semicolon(t.token) { Err(sql_second_statement_error(t.at)) }
      else if sql_is_punctuation(t.token, "(") {
        match sql_check_call(parser) {
          Err(e) -> Err(e),
          Ok(_) -> sql_skip_group(sql_step(parser), tables, depth + 1, left - 1),
        }
      } else if sql_is_punctuation(t.token, ")") {
        if depth == 1 { Ok({ parser: sql_step(parser), tables: tables }) } else {
          match sql_check_call(parser) {
            Err(e) -> Err(e),
            Ok(_) -> sql_skip_group(sql_step(parser), tables, depth - 1, left - 1),
          }
        }
      } else if sql_at_word(parser, "select") || sql_at_word(parser, "values")
          || sql_at_word(parser, "with") {
        match sql_statement(parser, left - 1) {
          Err(e) -> Err(e),
          Ok(inner) ->
            sql_skip_group(
              inner.parser,
              sql_merge_tables(tables, inner.scan.tables),
              depth,
              left - 1,
            ),
        }
      } else {
        match sql_check_call(parser) {
          Err(e) -> Err(e),
          Ok(_) -> sql_skip_group(sql_step(parser), tables, depth, left - 1),
        }
      },
    }
  }

fn sql_skip_parens(
  parser: SqlParser,
  tables: SqlTables,
  left: Int,
) -> Result<{ parser: SqlParser, tables: SqlTables }, DbError> / {abort.raise} =
  if left <= 0 { panic("the SQL parser made more nested calls than the statement has tokens") }
  else {
    match sql_skip_group(parser, tables, 1, left - 1) {
      Err(e) -> Err(e),
      Ok(closed) -> Ok({ parser: closed.parser, tables: closed.tables }),
    }
  }

const reader_function_count: Int = 30

/// Scans a statement and returns what it does and which tables it uses, or an error saying why it
/// is rejected. The scanner rejects any construct it does not model, because a wrong table set
/// could let the scheduler run two writers on the same table at once.
pub fn scan_statement(dialect: Dialect, sql: String) -> Result<SqlScan, DbError> / {abort.raise} =
  match tokenize(dialect, sql) {
    Err(e) -> Err(e),
    Ok(tokens) -> match dialect {
      Sqlite -> sqlite_scan(tokens, Bytes::of_string(sql).len()),
      Postgres -> match sql_statement(
          { tokens: tokens, ctes: [], depth: 0, end_pos: Bytes::of_string(sql).len() },
          (tokens.len() + 1) * reader_function_count,
        ) {
        Err(e) -> Err(e),
        Ok(s) -> match sql_nothing_left(s.parser) { Err(e) -> Err(e), Ok(_) -> Ok(s.scan) },
      },
    },
  }

/// The byte of the statement where a parser error occurred, which its message names. `None` for an
/// error the parser did not make.
pub fn rejection_byte(e: DbError) -> Option<Int> / {abort.raise} = {
  let words = Bytes::of_string(e.detail);
  let marker = Bytes::of_string(sql_byte_prefix);
  let last = iterate(
    { from: 0, found: None },
    words.len() + 1,
    |s: { from: Int, found: Option<Int> }|
      match words.index_of_from(marker, s.from) {
        None -> Stop(s.found),
        Some(i) -> Continue({ from: i + 1, found: Some(i) }),
      },
  );
  match last {
    None -> None,
    Some(i) -> {
      let from = i + marker.len();
      let end = sqlite_past_digits(words, from);
      if end == from { None } else { String::of_bytes(words.slice(from, end)).int_of_string() }
    },
  }
}

const sql_byte_prefix: String = " at byte "

const sqlite_clock_words: List<String> = ["current_timestamp", "current_date", "current_time"]

const sqlite_random_functions: List<String> = ["random", "randomblob"]

const sqlite_date_functions: List<String> =
  ["date", "time", "datetime", "julianday", "unixepoch", "strftime", "timediff"]

fn sqlite_scan(tokens: List<SqlTokenAt>, end: Int) -> Result<SqlScan, DbError> =
  match tokens {
    [] -> Err(sql_reject("the statement ends", end, "this statement is empty")),
    [t, ..rest] -> {
      let kind = sqlite_kind(t, rest)?;
      sql_reject_in(sqlite_clock_words, tokens)?;
      sqlite_check_calls(tokens)?;
      Ok({ kind: kind, tables: no_sql_tables })
    },
  }

fn sqlite_kind(t: SqlTokenAt, rest: List<SqlTokenAt>) -> Result<StatementKind, DbError> = {
  let verb = match t.token { SqlWord(w) -> if w.quoted { "" } else { w.text }, _ -> "" };
  if verb == "select" { Ok(Select) }
  else if verb == "values" { Ok(Values) }
  else if verb == "insert" || verb == "replace" { Ok(Insert) }
  else if verb == "update" { Ok(Update) }
  else if verb == "delete" { Ok(Delete) }
  else if verb == "with" { sqlite_after_with(t, rest, 0) }
  else if verb == "pragma" { Ok(Pragma) }
  else if verb == "create" { sqlite_create_kind(t, rest) }
  else if ["drop", "alter", "reindex", "analyze"].contains(verb) { Ok(SchemaChange) }
  else { Err(sql_reject_token(t, sqlite_verb_rejection(verb))) }
}

fn sqlite_verb_rejection(verb: String) -> String =
  if ["attach", "detach", "vacuum"].contains(verb) {
    "`attach`, `detach` and `vacuum` are not allowed: a connection can use only the database it was opened with. To write a copy of the database into a directory, use `backup` from `std.sqlite`"
  } else if ["begin", "commit", "end", "rollback", "savepoint", "release"].contains(verb) {
    "a statement cannot begin or end a transaction: use `transaction` from `std.sqlite`"
  } else {
    "a statement must begin with one of `select`, `insert`, `replace`, `update`, `delete`, `values`, `with`, `create`, `drop`, `alter`, `reindex`, `analyze` or `pragma`"
  }

fn sqlite_after_with(
  with_: SqlTokenAt,
  tokens: List<SqlTokenAt>,
  depth: Int,
) -> Result<StatementKind, DbError> =
  match tokens {
    [] -> Err(sql_reject_token(with_, "this `with` leads to no statement")),
    [t, ..rest] -> if sql_is_punctuation(t.token, "(") { sqlite_after_with(with_, rest, depth + 1) }
    else if sql_is_punctuation(t.token, ")") { sqlite_after_with(with_, rest, depth - 1) }
    else if depth > 0 { sqlite_after_with(with_, rest, depth) }
    else if sql_is_word(t.token, "select") { Ok(Select) }
    else if sql_is_word(t.token, "values") { Ok(Values) }
    else if sql_is_word(t.token, "insert") || sql_is_word(t.token, "replace") { Ok(Insert) }
    else if sql_is_word(t.token, "update") { Ok(Update) }
    else if sql_is_word(t.token, "delete") { Ok(Delete) }
    else { sqlite_after_with(with_, rest, depth) },
  }

fn sqlite_create_kind(
  create: SqlTokenAt,
  rest: List<SqlTokenAt>,
) -> Result<StatementKind, DbError> =
  match rest {
    [t, ..] -> if sql_is_word(t.token, "temp") || sql_is_word(t.token, "temporary") {
      Err(
        sql_reject_token(
          t,
          "temporary tables, indexes, triggers and views belong to a connection, not to the database",
        ),
      )
    } else if sql_is_word(t.token, "virtual") {
      Err(sql_reject_token(t, "virtual tables are not supported"))
    } else { Ok(SchemaChange) },
    [] -> Err(sql_reject_token(create, "this `create` is not followed by anything to create")),
  }

fn sqlite_check_calls(tokens: List<SqlTokenAt>) -> Result<(), DbError> =
  match tokens {
    [] -> Ok(()),
    [t, ..rest] -> {
      let called = match t.token {
        SqlWord(w) -> if !w.quoted && sql_opens_parenthesis(rest) { w.text } else { "" },
        _ -> "",
      };
      if sqlite_random_functions.contains(called) { Err(sql_nondeterministic_error(t, called)) }
      else if sqlite_date_functions.contains(called) {
        sqlite_check_date_arguments(t, called, sql_rest(rest), 1, true)?;
        sqlite_check_calls(rest)
      } else { sqlite_check_calls(rest) }
    },
  }

fn sql_opens_parenthesis(tokens: List<SqlTokenAt>) -> Bool =
  match tokens { [t, ..] -> sql_is_punctuation(t.token, "("), [] -> false }

fn sqlite_check_date_arguments(
  call: SqlTokenAt,
  name: String,
  tokens: List<SqlTokenAt>,
  depth: Int,
  bare: Bool,
) -> Result<(), DbError> =
  match tokens {
    [] -> Ok(()),
    [t, ..rest] -> if sql_is_punctuation(t.token, ")") {
      if depth > 1 { sqlite_check_date_arguments(call, name, rest, depth - 1, false) }
      else if bare {
        Err(
          sql_reject_token(
            call,
            "`" ++ name
              ++ "` called without a time argument reads the current time from the clock: pass the time as a parameter, so the effects the program declares show where the time comes from",
          ),
        )
      } else { Ok(()) }
    } else if sql_is_punctuation(t.token, "(") {
      sqlite_check_date_arguments(call, name, rest, depth + 1, false)
    } else if sqlite_reads_system_clock(t) {
      Err(
        sql_reject_token(
          t,
          "`" ++ name ++ "` of " ++ t.text
            ++ " reads the machine's clock or its time zone: pass the time as a parameter, so the effect system can see where the time comes from",
        ),
      )
    } else { sqlite_check_date_arguments(call, name, rest, depth, false) },
  }

fn sqlite_reads_system_clock(t: SqlTokenAt) -> Bool =
  match t.token {
    SqlText -> {
      let word = t.text.ascii_lower();
      word == "'now'" || word == "'localtime'" || word == "'utc'"
    },
    _ -> false,
  }

fn sql_nothing_left(parser: SqlParser) -> Result<(), DbError> =
  match sql_head(parser.tokens) {
    None -> Ok(()),
    Some(t) -> if sql_is_semicolon(t.token) { Err(sql_second_statement_error(t.at)) }
    else { Err(sql_reject_token(t, "the statement ends here")) },
  }

/// Returns the tables a statement writes and reads as text for an error message, such as "`a`
/// (written) and `b` (read)", or "no table" when there are none.
pub fn describe_tables(t: SqlTables) -> String =
  if t.written.len() > 0 && t.read.len() > 0 {
    "`" ++ String::join(t.written, "`, `") ++ "` (written) and `" ++ String::join(t.read, "`, `")
      ++ "` (read)"
  } else if t.written.len() > 0 { "`" ++ String::join(t.written, "`, `") ++ "` (written)" }
  else if t.read.len() > 0 { "`" ++ String::join(t.read, "`, `") ++ "` (read)" }
  else { "no table" }

/// Returns the postgres name of a value's type, as used in error messages.
pub fn datum_type(v: Datum) -> String =
  match v {
    NullDatum -> "unknown",
    IntDatum(_) -> "bigint",
    BoolDatum(_) -> "boolean",
    TextDatum(_) -> "text",
    BytesDatum(_) -> "bytea",
    FloatDatum(_) -> "double precision",
    NumericDatum(_) -> "numeric",
    JsonDatum(_) -> "jsonb",
    ArrayDatum(_) -> "array",
  }

/// How a call performs its statement: `Reads` returns rows and may not write, `Writes` writes and
/// returns a count, `WritesRows` writes and returns the rows its `returning` names, and `ReadWrite`
/// returns whichever the statement does.
pub type Operation = | Reads | Writes | WritesRows | ReadWrite

/// What a field of a row type contains, as stored in the column it is read from. `JsonField` is a
/// document, whatever type its codec reads it as; `OptionalField` is a field that may be null.
pub type FieldKind =
  | TextField
  | IntField
  | BoolField
  | FloatField
  | NumericField
  | BytesField
  | JsonField
  | ArrayField(FieldKind)
  | OptionalField(FieldKind)

/// A field of a row type: the column it is read from, by name, and what it contains.
pub type Field = { name: String, kind: FieldKind }

/// Describes a call that performs a statement, so the statement can be checked against a schema.
/// `operation` is how the call performs it. `label` is the table the call names, when the label is
/// a table (a `std.db` label is a table; a `std.sqlite` label is a database).
/// `parameter_constructors` lists, for each parameter written in a list, the name of its
/// constructor, or `None` when it is not a constructor call. `row` lists the fields of the row type
/// the rows are read into.
pub type CallSite = {
  dialect: Dialect,
  operation: Operation,
  label: Option<String>,
  parameter_constructors: Option<List<Option<String>>>,
  row: Option<List<Field>>,
}

/// Why a statement does not fit where it is performed: text the parser rejects (`Unreadable`), a
/// table or column the schema does not declare (`Undeclared`), tables that do not include the
/// call's label (`LabelMismatch`), a statement the operation does not perform
/// (`OperationMismatch`), a `*`, which returns whatever columns a table has when it runs
/// (`SelectStar`), a construct the check does not follow (`Unsupported`), columns that disagree
/// with the row type (`RowMismatch`), and values or parameters that disagree with what they
/// represent (`ValueMismatch`).
pub type FindingKind =
  | Unreadable
  | Undeclared
  | LabelMismatch
  | OperationMismatch
  | SelectStar
  | Unsupported
  | RowMismatch
  | ValueMismatch

/// One thing wrong with a statement: its kind, the byte of the text where it is, and why. An
/// `Unsupported` message names the construct the check stopped at.
pub type Finding = { kind: FindingKind, at: Int, message: String }

/// Everything wrong with `sql` performed at `site`. When the parser rejects the text, that is the
/// only finding. Otherwise: tables that do not include the label, an operation that does not
/// perform the statement, and more or fewer parameters than placeholders. Against `schema` too:
/// each table and column it names that the schema does not declare, a `*`, a construct the check
/// does not follow, columns that disagree with the row type, and parameters written with a
/// constructor that disagrees with the column they are compared with or stored in.
pub fn check_statement(
  schema: Option<Schema>,
  site: CallSite,
  sql: String,
) -> List<Finding> / {abort.raise} =
  match scan_statement(site.dialect, sql) {
    Err(e) -> [{ kind: Unreadable, at: rejection_byte(e).unwrap_or(0), message: e.detail }],
    Ok(scan) -> {
      let tokens = match tokenize(site.dialect, sql) {
        Ok(ts) -> number_placeholders(ts),
        Err(_) -> [],
      };
      let framed = check_label(site, scan).concat(
        check_operation(site, scan, has_returning(tokens)),
      ).concat(
        check_parameter_count(site, tokens),
      );
      match schema {
        None -> framed,
        Some(s) -> if names_no_table(scan.kind) { framed }
        else { framed.concat(check_against_schema(s, site, sql, tokens)) },
      }
    },
  }

fn names_no_table(k: StatementKind) -> Bool =
  match k { SchemaChange -> true, Pragma -> true, Values -> true, _ -> false }

fn placeholder_mark(dialect: Dialect) -> String = match dialect { Postgres -> "$", Sqlite -> "?" }

fn number_placeholders(tokens: List<SqlTokenAt>) -> List<SqlTokenAt> / {abort.raise} =
  tokens.fold(
    { out: [], high: 0 },
    |accumulator: { out: List<SqlTokenAt>, high: Int }, t: SqlTokenAt|
      match t.token {
        SqlPlaceholder -> {
          let n = placeholder_number(t.text, accumulator.high);
          {
            out: accumulator.out.push({ ..t, text: "$" ++ n.to_string() }),
            high: max(accumulator.high, n),
          }
        },
        _ -> { out: accumulator.out.push(t), high: accumulator.high },
      },
  ).out

fn placeholder_number(text: String, high: Int) -> Int / {abort.raise} =
  if text.len() <= 1 { high + 1 } else { text.slice(1, text.len()).int_of_string().unwrap_or(0) }

fn highest_placeholder(tokens: List<SqlTokenAt>) -> Int / {abort.raise} =
  tokens.fold(0, |high: Int, t: SqlTokenAt|
    match t.token { SqlPlaceholder -> max(high, placeholder_number(t.text, high)), _ -> high })

fn has_returning(tokens: List<SqlTokenAt>) -> Bool =
  tokens.fold({ depth: 0, found: false }, |s: { depth: Int, found: Bool }, t: SqlTokenAt|
    if sql_is_punctuation(t.token, "(") { { ..s, depth: s.depth + 1 } }
    else if sql_is_punctuation(t.token, ")") { { ..s, depth: s.depth - 1 } }
    else if s.depth == 0 && sql_is_word(t.token, "returning") { { ..s, found: true } }
    else { s }).found

fn check_label(site: CallSite, scan: SqlScan) -> List<Finding> / {abort.raise} =
  match ((site.dialect, site.label)) {
    (Postgres, Some(label)) -> if scan_table_names(scan.tables).contains(label) { [] } else {
      [
        {
          kind: LabelMismatch,
          at: 0,
          message: "the call names the table `" ++ label ++ "`, but the statement uses "
            ++ describe_tables(scan.tables)
            ++ ": change the table name in the call to a table the statement uses, or split the statement into several statements",
        },
      ]
    },
    _ -> [],
  }

fn check_operation(site: CallSite, scan: SqlScan, returns: Bool) -> List<Finding> = {
  let writes = scan_writes(scan) || (match scan.kind { Pragma -> true, _ -> false });
  let wrong = |reason: String| [{ kind: OperationMismatch, at: 0, message: reason }];
  match site.operation {
    Reads -> if scan_writes(scan) {
      wrong(
        "the statement writes, but the call is read-only, and a read-only call cannot run a write: use `execute` or `returning` instead. Read-only calls may run at the same time as other calls, but two writes must not run at the same time",
      )
    } else { [] },
    Writes -> if !writes {
      wrong(
        "the statement only reads, and the call writes and returns a count: perform it as a query",
      )
    } else if returns {
      wrong(
        "the statement returns rows through `returning`, and the call returns a count: perform it as `returning`",
      )
    } else { [] },
    WritesRows -> if !writes {
      wrong("the statement only reads, and the call writes: perform it as a query")
    } else if !returns {
      wrong(
        "the statement returns no rows, and the call reads the rows its `returning` names: add `returning`, or perform it as `execute`",
      )
    } else { [] },
    ReadWrite -> [],
  }
}

fn check_parameter_count(
  site: CallSite,
  tokens: List<SqlTokenAt>,
) -> List<Finding> / {abort.raise} =
  match site.parameter_constructors {
    None -> [],
    Some(given) -> {
      let wanted = highest_placeholder(tokens);
      if given.len() == wanted { [] } else {
        [
          {
            kind: ValueMismatch,
            at: 0,
            message: (if wanted == 0 { "the statement has no placeholder" } else {
                "the statement's placeholders run to `" ++ placeholder_mark(site.dialect)
                  ++ wanted.to_string()
                  ++ "`"
              })
              ++ ", and the call passes "
              ++ count_text(given.len(), "parameter"),
          },
        ]
      }
    },
  }

fn count_text(n: Int, what: String) -> String =
  if n == 0 { "no " ++ what }
  else if n == 1 { "one " ++ what }
  else { n.to_string() ++ " " ++ what ++ "s" }

fn check_against_schema(
  schema: Schema,
  site: CallSite,
  sql: String,
  tokens: List<SqlTokenAt>,
) -> List<Finding> / {abort.raise} = {
  let room = (tokens.len() + 2) * 24;
  match parse_statement(
      { tokens: tokens, ctes: [], depth: 0, end_pos: Bytes::of_string(sql).len() },
      room,
    ) {
    Err(f) -> [f],
    Ok(statement) -> {
      let checked = type_check_statement(
        {
          findings: [],
          placed: [],
          schema: schema,
          dialect: site.dialect,
          sql: Bytes::of_string(sql),
        },
        statement,
        room,
      );
      let shaped = match site.row {
        None -> [],
        Some(fields) -> if checked.j.findings.len() > 0 { [] }
        else { check_row_fields(fields, checked.returned) },
      };
      let bound = match site.parameter_constructors {
        None -> [],
        Some(given) -> check_parameter_types(site.dialect, given, checked.j.placed),
      };
      checked.j.findings.concat(shaped).concat(bound)
    },
  }
}

type ValueType =
  | IntType
  | BoolType
  | TextType
  | BytesType
  | FloatType
  | NumericType
  | JsonType
  | ArrayType(ValueType)
  | NullType
  | UnknownType

type ColumnReference = { table: String, column: String, at: Int }

type QueryExpression =
  | ColumnExpression(ColumnReference)
  | PlaceholderExpression({ n: Int, at: Int })
  | LiteralExpression(ValueType)
  | NullExpression
  | CallExpression({ name: String, args: List<QueryExpression> })
  | CountStarExpression
  | BinaryExpression({ operation: String, left_operand: QueryExpression, right_operand: QueryExpression })
  | NotExpression(QueryExpression)
  | NegateExpression(QueryExpression)
  | IsNullExpression(QueryExpression)
  | InListExpression({ value: QueryExpression, items: List<QueryExpression> })
  | InSelectExpression({ value: QueryExpression, query: SelectQuery })
  | ExistsExpression(SelectQuery)
  | SubqueryExpression(SelectQuery)
  | BetweenExpression({ value: QueryExpression, low: QueryExpression, high: QueryExpression })
  | CastExpression({ value: QueryExpression, ty: ValueType })
  | CaseExpression({ subject: Option<QueryExpression>, whens: List<When>, otherwise: Option<QueryExpression> })
  | AnyExpression(QueryExpression)

type When = { cond: QueryExpression, value: QueryExpression }

type SelectItem =
  | Wildcard({ table: String, at: Int })
  | ExpressionItem({ value: QueryExpression, name: Option<String>, from: Int, to: Int })

type Source = { table: String, alias: String, at: Int, optional: Bool }

type SelectQuery = {
  items: List<SelectItem>,
  sources: List<Source>,
  conditions: List<QueryExpression>,
  filter: Option<QueryExpression>,
  group: List<QueryExpression>,
  having: Option<QueryExpression>,
  order: List<QueryExpression>,
  bounds: List<QueryExpression>,
}

type Assignment = { column: ColumnReference, value: QueryExpression }

type InsertSource = | ByValues(List<List<QueryExpression>>) | BySelect(SelectQuery) | ByDefaults

type ParsedStatement =
  | SelectStatement(SelectQuery)
  | InsertStatement({ target: Source, columns: List<ColumnReference>, rows: InsertSource, returning: List<SelectItem> })
  | UpdateStatement({ target: Source, sets: List<Assignment>, sources: List<Source>, conditions: List<QueryExpression>, filter: Option<QueryExpression>, returning: List<SelectItem> })
  | DeleteStatement({ target: Source, sources: List<Source>, conditions: List<QueryExpression>, filter: Option<QueryExpression>, returning: List<SelectItem> })

type ParseOutput<a> = { parser: SqlParser, value: a }

type FromClause = { sources: List<Source>, conditions: List<QueryExpression> }

type JoinKind = { parser: SqlParser, optional: Bool, before: Bool, cross: Bool }

type Operator = { operator: String, parser: SqlParser }

fn parse_output<a>(parser: SqlParser, value: a) -> ParseOutput<a> = { parser: parser, value: value }

fn current_offset(parser: SqlParser) -> Int =
  match sql_head(parser.tokens) { Some(t) -> t.at, None -> parser.end_pos }

fn unsupported<a>(parser: SqlParser, what: String) -> Result<a, Finding> =
  Err({ kind: Unsupported, at: current_offset(parser), message: what })

fn unsupported_here<a>(parser: SqlParser) -> Result<a, Finding> =
  match sql_head(parser.tokens) {
    Some(t) -> unsupported(parser, "`" ++ t.text ++ "` here"),
    None -> unsupported(parser, "the statement ends here, but the parser expected more tokens"),
  }

fn too_deep<a>(parser: SqlParser) -> Result<a, Finding> =
  unsupported(parser, "a statement nested this deep")

fn expect_word(parser: SqlParser, word: String) -> Result<SqlParser, Finding> =
  if sql_at_word(parser, word) { Ok(sql_step(parser)) } else { unsupported_here(parser) }

fn expect_punctuation(parser: SqlParser, p: String) -> Result<SqlParser, Finding> =
  if sql_at_punctuation(parser, p) { Ok(sql_step(parser)) } else { unsupported_here(parser) }

fn parse_name(
  parser: SqlParser,
  left: Int,
) -> Result<ParseOutput<{ name: String, at: Int }>, Finding> =
  if left <= 0 { too_deep(parser) } else {
    match sql_head(parser.tokens) {
      Some(t) -> match t.token {
        SqlWord(w) -> if !w.quoted && sql_reserved(w.text) { unsupported_here(parser) } else {
          let after = sql_step(parser);
          let dotted = match sql_nth(after.tokens, 1) {
            Some(n) -> match n.token { SqlWord(_) -> sql_at_punctuation(after, "."), _ -> false },
            None -> false,
          };
          if dotted { parse_name(sql_step(after), left - 1) }
          else { Ok(parse_output(after, { name: w.text, at: t.at })) }
        },
        _ -> unsupported_here(parser),
      },
      None -> unsupported_here(parser),
    }
  }

fn parse_alias(parser: SqlParser) -> Result<ParseOutput<Option<String>>, Finding> = {
  let as_ = sql_eat_word(parser, "as");
  match sql_head(as_.parser.tokens) {
    Some(t) -> match t.token {
      SqlWord(w) -> if as_.ate || w.quoted || !sql_reserved(w.text) {
        Ok(parse_output(sql_step(as_.parser), Some(w.text)))
      } else { Ok(parse_output(parser, None)) },
      _ -> if as_.ate { unsupported_here(as_.parser) } else { Ok(parse_output(parser, None)) },
    },
    None -> if as_.ate { unsupported_here(as_.parser) } else { Ok(parse_output(parser, None)) },
  }
}

fn parse_statement(
  parser: SqlParser,
  left: Int,
) -> Result<ParsedStatement, Finding> / {abort.raise} =
  if left <= 0 { too_deep(parser) } else {
    let read = parse_by_verb(parser, left - 1)?;
    match sql_head(read.parser.tokens) {
      None -> Ok(read.value),
      Some(_) -> unsupported_here(read.parser),
    }
  }

fn parse_by_verb(
  parser: SqlParser,
  left: Int,
) -> Result<ParseOutput<ParsedStatement>, Finding> / {abort.raise} =
  if sql_at_word(parser, "select") {
    let q = parse_select(parser, left)?;
    Ok(parse_output(q.parser, SelectStatement(q.value)))
  } else if sql_at_word(parser, "insert") || sql_at_word(parser, "replace") {
    parse_insert(parser, left)
  } else if sql_at_word(parser, "update") { parse_update(parser, left) }
  else if sql_at_word(parser, "delete") { parse_delete(parser, left) }
  else { unsupported_here(parser) }

fn parse_select_prefix(parser: SqlParser) -> Result<SqlParser, Finding> = {
  let opened = sql_step(parser);
  let distinct = sql_eat_word(opened, "distinct");
  if distinct.ate && sql_at_word(distinct.parser, "on") {
    unsupported(distinct.parser, "`distinct on`")
  } else if distinct.ate { Ok(distinct.parser) }
  else { Ok(sql_eat_word(opened, "all").parser) }
}

fn parse_from(
  parser: SqlParser,
  word: String,
  left: Int,
) -> Result<ParseOutput<FromClause>, Finding> / {abort.raise} =
  if sql_at_word(parser, word) { parse_sources(sql_step(parser), [], [], left) }
  else { Ok(parse_output(parser, { sources: [], conditions: [] })) }

fn parse_by(
  parser: SqlParser,
  word: String,
  left: Int,
) -> Result<ParseOutput<List<QueryExpression>>, Finding> / {abort.raise} =
  if !sql_at_word(parser, word) { Ok(parse_output(parser, [])) } else {
    let by = expect_word(sql_step(parser), "by")?;
    if word == "order" { parse_order(by, [], left) } else { parse_expressions(by, [], left) }
  }

fn parse_select(
  parser: SqlParser,
  left: Int,
) -> Result<ParseOutput<SelectQuery>, Finding> / {abort.raise} =
  if left <= 0 { too_deep(parser) } else {
    let listed = parse_select_prefix(parser)?;
    let items = parse_select_items(listed, [], left - 1)?;
    let from = parse_from(items.parser, "from", left - 1)?;
    let filter = parse_condition(from.parser, "where", left - 1)?;
    let group = parse_by(filter.parser, "group", left - 1)?;
    let having = parse_condition(group.parser, "having", left - 1)?;
    let order = parse_by(having.parser, "order", left - 1)?;
    let bounds = parse_limit_offset(order.parser, [], left - 1)?;
    Ok(
      parse_output(bounds.parser, {
        items: items.value,
        sources: from.value.sources,
        conditions: from.value.conditions,
        filter: filter.value,
        group: group.value,
        having: having.value,
        order: order.value,
        bounds: bounds.value,
      }),
    )
  }

fn parse_select_items(
  parser: SqlParser,
  accumulator: List<SelectItem>,
  left: Int,
) -> Result<ParseOutput<List<SelectItem>>, Finding> / {abort.raise} =
  if left <= 0 { too_deep(parser) } else {
    let one = parse_select_item(parser, left - 1)?;
    let comma = sql_eat_punctuation(one.parser, ",");
    if comma.ate { parse_select_items(comma.parser, accumulator.push(one.value), left - 1) }
    else { Ok(parse_output(one.parser, accumulator.push(one.value))) }
  }

fn parse_select_item(
  parser: SqlParser,
  left: Int,
) -> Result<ParseOutput<SelectItem>, Finding> / {abort.raise} =
  if sql_at_punctuation(parser, "*") {
    Ok(parse_output(sql_step(parser), Wildcard({ table: "", at: current_offset(parser) })))
  } else {
    match qualified_wildcard_table(parser) {
      Some(table) ->
        Ok(
          parse_output(
            sql_step(sql_step(sql_step(parser))),
            Wildcard({ table: table, at: current_offset(parser) }),
          ),
        ),
      None -> {
        let value = parse_expression(parser, left)?;
        let named = parse_alias(value.parser)?;
        Ok(
          parse_output(
            named.parser,
            ExpressionItem({
              value: value.value,
              name: named.value,
              from: current_offset(parser),
              to: current_offset(value.parser),
            }),
          ),
        )
      },
    }
  }

fn qualified_wildcard_table(parser: SqlParser) -> Option<String> =
  match ((sql_head(parser.tokens), sql_nth(parser.tokens, 1), sql_nth(parser.tokens, 2))) {
    (Some(t), Some(d), Some(s)) -> match t.token {
      SqlWord(w) -> if sql_is_punctuation(d.token, ".") && sql_is_punctuation(s.token, "*") {
        Some(w.text)
      } else { None },
      _ -> None,
    },
    _ -> None,
  }

fn parse_sources(
  parser: SqlParser,
  sources: List<Source>,
  conditions: List<QueryExpression>,
  left: Int,
) -> Result<ParseOutput<FromClause>, Finding> / {abort.raise} =
  if left <= 0 { too_deep(parser) } else {
    let first = parse_source(parser, false, left - 1)?;
    parse_joins(first.parser, sources.push(first.value), conditions, left - 1)
  }

fn parse_joins(
  parser: SqlParser,
  sources: List<Source>,
  conditions: List<QueryExpression>,
  left: Int,
) -> Result<ParseOutput<FromClause>, Finding> / {abort.raise} =
  if left <= 0 { too_deep(parser) } else if sql_at_punctuation(parser, ",") {
    parse_sources(sql_step(parser), sources, conditions, left - 1)
  } else {
    match parse_join_kind(parser) {
      None -> Ok(parse_output(parser, { sources: sources, conditions: conditions })),
      Some(kind) -> {
        let joined = parse_source(kind.parser, kind.optional, left - 1)?;
        let before = if kind.before { sources.map(|s: Source| { ..s, optional: true }) }
        else { sources };
        let all = before.push(joined.value);
        if kind.cross { parse_joins(joined.parser, all, conditions, left - 1) }
        else if sql_at_word(joined.parser, "on") {
          let on = parse_expression(sql_step(joined.parser), left - 1)?;
          parse_joins(on.parser, all, conditions.push(on.value), left - 1)
        } else { unsupported_here(joined.parser) }
      },
    }
  }

fn parse_join_kind(parser: SqlParser) -> Option<JoinKind> = {
  let past = |p: SqlParser, optional: Bool, before: Bool, cross: Bool|
    if sql_at_word(p, "join") {
      Some({ parser: sql_step(p), optional: optional, before: before, cross: cross })
    } else { None };
  let outer = |p: SqlParser| sql_eat_word(sql_step(p), "outer").parser;
  if sql_at_word(parser, "join") { past(parser, false, false, false) }
  else if sql_at_word(parser, "inner") { past(sql_step(parser), false, false, false) }
  else if sql_at_word(parser, "cross") { past(sql_step(parser), false, false, true) }
  else if sql_at_word(parser, "left") { past(outer(parser), true, false, false) }
  else if sql_at_word(parser, "right") { past(outer(parser), false, true, false) }
  else if sql_at_word(parser, "full") { past(outer(parser), true, true, false) }
  else { None }
}

fn parse_source(
  parser: SqlParser,
  optional: Bool,
  left: Int,
) -> Result<ParseOutput<Source>, Finding> =
  if sql_at_punctuation(parser, "(") { unsupported(parser, "a subquery in `from`") } else {
    let named = parse_name(parser, left)?;
    if sql_at_punctuation(named.parser, "(") { unsupported(parser, "a function in `from`") } else {
      let alias = parse_alias(named.parser)?;
      if sql_at_punctuation(alias.parser, "(") {
        unsupported(alias.parser, "an alias that renames columns")
      } else {
        Ok(
          parse_output(alias.parser, {
            table: named.value.name,
            alias: alias.value.unwrap_or(named.value.name),
            at: named.value.at,
            optional: optional,
          }),
        )
      }
    }
  }

fn parse_condition(
  parser: SqlParser,
  word: String,
  left: Int,
) -> Result<ParseOutput<Option<QueryExpression>>, Finding> / {abort.raise} =
  if sql_at_word(parser, word) {
    let e = parse_expression(sql_step(parser), left)?;
    Ok(parse_output(e.parser, Some(e.value)))
  } else { Ok(parse_output(parser, None)) }

fn parse_expressions(
  parser: SqlParser,
  accumulator: List<QueryExpression>,
  left: Int,
) -> Result<ParseOutput<List<QueryExpression>>, Finding> / {abort.raise} =
  if left <= 0 { too_deep(parser) } else {
    let one = parse_expression(parser, left - 1)?;
    let comma = sql_eat_punctuation(one.parser, ",");
    if comma.ate { parse_expressions(comma.parser, accumulator.push(one.value), left - 1) }
    else { Ok(parse_output(one.parser, accumulator.push(one.value))) }
  }

fn parse_order(
  parser: SqlParser,
  accumulator: List<QueryExpression>,
  left: Int,
) -> Result<ParseOutput<List<QueryExpression>>, Finding> / {abort.raise} =
  if left <= 0 { too_deep(parser) } else {
    let one = parse_expression(parser, left - 1)?;
    let ordered = if sql_at_word(one.parser, "asc") || sql_at_word(one.parser, "desc") {
      sql_step(one.parser)
    } else { one.parser };
    let nulls = if sql_at_word(ordered, "nulls")
        && (sql_at_word(sql_step(ordered), "first") || sql_at_word(sql_step(ordered), "last")) {
      sql_step(sql_step(ordered))
    } else { ordered };
    let comma = sql_eat_punctuation(nulls, ",");
    if comma.ate { parse_order(comma.parser, accumulator.push(one.value), left - 1) }
    else { Ok(parse_output(nulls, accumulator.push(one.value))) }
  }

fn parse_limit_offset(
  parser: SqlParser,
  accumulator: List<QueryExpression>,
  left: Int,
) -> Result<ParseOutput<List<QueryExpression>>, Finding> / {abort.raise} =
  if left <= 0 { too_deep(parser) } else if sql_at_word(parser, "limit") {
    if sql_at_word(sql_step(parser), "all") {
      parse_limit_offset(sql_step(sql_step(parser)), accumulator, left - 1)
    } else {
      let n = parse_expression(sql_step(parser), left - 1)?;
      parse_limit_offset(n.parser, accumulator.push(n.value), left - 1)
    }
  } else if sql_at_word(parser, "offset") {
    let n = parse_expression(sql_step(parser), left - 1)?;
    let past = if sql_at_word(n.parser, "row") || sql_at_word(n.parser, "rows") {
      sql_step(n.parser)
    } else { n.parser };
    parse_limit_offset(past, accumulator.push(n.value), left - 1)
  } else { Ok(parse_output(parser, accumulator)) }

fn parse_expression(
  parser: SqlParser,
  left: Int,
) -> Result<ParseOutput<QueryExpression>, Finding> / {abort.raise} =
  if left <= 0 { too_deep(parser) } else {
    let first = parse_and(parser, left - 1)?;
    parse_or_more(first, left - 1)
  }

fn parse_or_more(
  so_far: ParseOutput<QueryExpression>,
  left: Int,
) -> Result<ParseOutput<QueryExpression>, Finding> / {abort.raise} =
  if left <= 0 { too_deep(so_far.parser) } else if sql_at_word(so_far.parser, "or") {
    let next = parse_and(sql_step(so_far.parser), left - 1)?;
    parse_or_more(
      parse_output(
        next.parser,
        BinaryExpression({
          operation: "or",
          left_operand: so_far.value,
          right_operand: next.value,
        }),
      ),
      left - 1,
    )
  } else { Ok(so_far) }

fn parse_and(
  parser: SqlParser,
  left: Int,
) -> Result<ParseOutput<QueryExpression>, Finding> / {abort.raise} =
  if left <= 0 { too_deep(parser) } else {
    let first = parse_not(parser, left - 1)?;
    parse_and_more(first, left - 1)
  }

fn parse_and_more(
  so_far: ParseOutput<QueryExpression>,
  left: Int,
) -> Result<ParseOutput<QueryExpression>, Finding> / {abort.raise} =
  if left <= 0 { too_deep(so_far.parser) } else if sql_at_word(so_far.parser, "and") {
    let next = parse_not(sql_step(so_far.parser), left - 1)?;
    parse_and_more(
      parse_output(
        next.parser,
        BinaryExpression({
          operation: "and",
          left_operand: so_far.value,
          right_operand: next.value,
        }),
      ),
      left - 1,
    )
  } else { Ok(so_far) }

fn parse_not(
  parser: SqlParser,
  left: Int,
) -> Result<ParseOutput<QueryExpression>, Finding> / {abort.raise} =
  if left <= 0 { too_deep(parser) } else if sql_at_word(parser, "not") {
    let inner = parse_not(sql_step(parser), left - 1)?;
    Ok(parse_output(inner.parser, NotExpression(inner.value)))
  } else {
    let left_operand = parse_sum(parser, left - 1)?;
    parse_predicate(left_operand, left - 1)
  }

fn parse_predicate(
  left_operand: ParseOutput<QueryExpression>,
  left: Int,
) -> Result<ParseOutput<QueryExpression>, Finding> / {abort.raise} =
  if left <= 0 { too_deep(left_operand.parser) } else {
    match parse_comparison(left_operand.parser) {
      Some(c) -> {
        let right_operand = parse_sum(c.parser, left - 1)?;
        Ok(
          parse_output(
            right_operand.parser,
            BinaryExpression({
              operation: c.operator,
              left_operand: left_operand.value,
              right_operand: right_operand.value,
            }),
          ),
        )
      },
      None -> if sql_at_word(left_operand.parser, "is") {
        let p = sql_eat_word(sql_step(left_operand.parser), "not").parser;
        if sql_at_word(p, "null") {
          Ok(parse_output(sql_step(p), IsNullExpression(left_operand.value)))
        } else if sql_at_word(p, "true") || sql_at_word(p, "false") {
          Ok(
            parse_output(
              sql_step(p),
              BinaryExpression({
                operation: "=",
                left_operand: left_operand.value,
                right_operand: LiteralExpression(BoolType),
              }),
            ),
          )
        } else { unsupported_here(p) }
      } else {
        let negated = sql_eat_word(left_operand.parser, "not");
        let p = negated.parser;
        if sql_at_word(p, "in") { parse_in(left_operand.value, sql_step(p), left - 1) }
        else if sql_at_word(p, "between") {
          let low = parse_sum(sql_step(p), left - 1)?;
          let high = parse_sum(expect_word(low.parser, "and")?, left - 1)?;
          Ok(
            parse_output(
              high.parser,
              BetweenExpression({ value: left_operand.value, low: low.value, high: high.value }),
            ),
          )
        } else if sql_at_word(p, "like") || sql_at_word(p, "ilike") {
          let pattern = parse_sum(sql_step(p), left - 1)?;
          Ok(
            parse_output(
              pattern.parser,
              BinaryExpression({
                operation: "like",
                left_operand: left_operand.value,
                right_operand: pattern.value,
              }),
            ),
          )
        } else if negated.ate { unsupported_here(p) }
        else { Ok(left_operand) }
      },
    }
  }

fn parse_in(
  value: QueryExpression,
  parser: SqlParser,
  left: Int,
) -> Result<ParseOutput<QueryExpression>, Finding> / {abort.raise} =
  if left <= 0 { too_deep(parser) } else {
    let opened = expect_punctuation(parser, "(")?;
    if sql_at_word(opened, "select") {
      let q = parse_select(opened, left - 1)?;
      Ok(
        parse_output(
          expect_punctuation(q.parser, ")")?,
          InSelectExpression({ value: value, query: q.value }),
        ),
      )
    } else {
      let items = parse_expressions(opened, [], left - 1)?;
      Ok(
        parse_output(
          expect_punctuation(items.parser, ")")?,
          InListExpression({ value: value, items: items.value }),
        ),
      )
    }
  }

fn touching_punctuation(parser: SqlParser, t: SqlTokenAt) -> String =
  match sql_nth(parser.tokens, 1) {
    Some(n) -> match n.token {
      SqlPunctuation(q) -> if n.at == t.at + t.text.len() { q } else { "" },
      _ -> "",
    },
    None -> "",
  }

fn parse_comparison(parser: SqlParser) -> Option<Operator> =
  match sql_head(parser.tokens) {
    Some(t) -> match t.token {
      SqlPunctuation(p) -> {
        let second = touching_punctuation(parser, t);
        let two = sql_step(sql_step(parser));
        if p == "=" && second == "" { Some({ operator: "=", parser: sql_step(parser) }) }
        else if p == "<" && (second == "=" || second == ">") {
          Some({ operator: p ++ second, parser: two })
        } else if p == ">" && second == "=" { Some({ operator: ">=", parser: two }) }
        else if p == "!" && second == "=" { Some({ operator: "<>", parser: two }) }
        else if (p == "<" || p == ">") && second == "" {
          Some({ operator: p, parser: sql_step(parser) })
        } else { None }
      },
      _ -> None,
    },
    None -> None,
  }

fn parse_sum(
  parser: SqlParser,
  left: Int,
) -> Result<ParseOutput<QueryExpression>, Finding> / {abort.raise} =
  if left <= 0 { too_deep(parser) } else {
    let first = parse_product(parser, left - 1)?;
    parse_sum_more(first, left - 1)
  }

fn parse_sum_more(
  so_far: ParseOutput<QueryExpression>,
  left: Int,
) -> Result<ParseOutput<QueryExpression>, Finding> / {abort.raise} =
  if left <= 0 { too_deep(so_far.parser) } else {
    match sql_head(so_far.parser.tokens) {
      Some(t) -> match t.token {
        SqlPunctuation(p) -> {
          let second = touching_punctuation(so_far.parser, t);
          if p == "|" && second == "|" {
            let next = parse_product(sql_step(sql_step(so_far.parser)), left - 1)?;
            parse_sum_more(
              parse_output(
                next.parser,
                BinaryExpression({
                  operation: "||",
                  left_operand: so_far.value,
                  right_operand: next.value,
                }),
              ),
              left - 1,
            )
          } else if (p == "+" || p == "-") && second == "" {
            let next = parse_product(sql_step(so_far.parser), left - 1)?;
            parse_sum_more(
              parse_output(
                next.parser,
                BinaryExpression({
                  operation: p,
                  left_operand: so_far.value,
                  right_operand: next.value,
                }),
              ),
              left - 1,
            )
          } else { Ok(so_far) }
        },
        _ -> Ok(so_far),
      },
      None -> Ok(so_far),
    }
  }

fn parse_product(
  parser: SqlParser,
  left: Int,
) -> Result<ParseOutput<QueryExpression>, Finding> / {abort.raise} =
  if left <= 0 { too_deep(parser) } else {
    let first = parse_unary(parser, left - 1)?;
    parse_product_more(first, left - 1)
  }

fn parse_product_more(
  so_far: ParseOutput<QueryExpression>,
  left: Int,
) -> Result<ParseOutput<QueryExpression>, Finding> / {abort.raise} =
  if left <= 0 { too_deep(so_far.parser) } else {
    match sql_head(so_far.parser.tokens) {
      Some(t) -> match t.token {
        SqlPunctuation(p) -> if ["*", "/", "%"].contains(p)
            && touching_punctuation(so_far.parser, t) == "" {
          let next = parse_unary(sql_step(so_far.parser), left - 1)?;
          parse_product_more(
            parse_output(
              next.parser,
              BinaryExpression({
                operation: p,
                left_operand: so_far.value,
                right_operand: next.value,
              }),
            ),
            left - 1,
          )
        } else { Ok(so_far) },
        _ -> Ok(so_far),
      },
      None -> Ok(so_far),
    }
  }

fn parse_unary(
  parser: SqlParser,
  left: Int,
) -> Result<ParseOutput<QueryExpression>, Finding> / {abort.raise} =
  if left <= 0 { too_deep(parser) }
  else if sql_at_punctuation(parser, "-") || sql_at_punctuation(parser, "+") {
    let inner = parse_unary(sql_step(parser), left - 1)?;
    Ok(parse_output(inner.parser, NegateExpression(inner.value)))
  } else {
    let primary = parse_primary(parser, left - 1)?;
    parse_casts(primary, left - 1)
  }

fn parse_casts(
  so_far: ParseOutput<QueryExpression>,
  left: Int,
) -> Result<ParseOutput<QueryExpression>, Finding> =
  if left <= 0 { too_deep(so_far.parser) } else {
    match sql_head(so_far.parser.tokens) {
      Some(t) -> if sql_is_punctuation(t.token, ":")
          && touching_punctuation(so_far.parser, t) == ":" {
        let ty = parse_type(sql_step(sql_step(so_far.parser)), left - 1)?;
        parse_casts(
          parse_output(ty.parser, CastExpression({ value: so_far.value, ty: ty.value })),
          left - 1,
        )
      } else if sql_is_punctuation(t.token, "[") { unsupported(so_far.parser, "a subscript") }
      else { Ok(so_far) },
      None -> Ok(so_far),
    }
  }

fn parse_type(parser: SqlParser, left: Int) -> Result<ParseOutput<ValueType>, Finding> =
  match sql_head(parser.tokens) {
    Some(t) -> match t.token {
      SqlWord(w) -> {
        let named = sql_step(parser);
        let worded = if sql_at_word(named, "precision") || sql_at_word(named, "varying") {
          sql_step(named)
        } else { named };
        let sized = parse_type_size(worded, left)?;
        let closes = match sql_nth(sized.tokens, 1) {
          Some(c) -> sql_is_punctuation(c.token, "]"),
          None -> false,
        };
        if sql_at_punctuation(sized, "[") && closes {
          Ok(parse_output(sql_step(sql_step(sized)), ArrayType(value_type_named(w.text))))
        } else { Ok(parse_output(sized, value_type_named(w.text))) }
      },
      _ -> unsupported_here(parser),
    },
    None -> unsupported_here(parser),
  }

fn parse_type_size(parser: SqlParser, left: Int) -> Result<SqlParser, Finding> =
  if sql_at_punctuation(parser, "(") { parse_type_size_list(sql_step(parser), left) }
  else { Ok(parser) }

fn parse_type_size_list(parser: SqlParser, left: Int) -> Result<SqlParser, Finding> =
  if left <= 0 { too_deep(parser) }
  else if sql_at_punctuation(parser, ")") { Ok(sql_step(parser)) } else {
    match sql_head(parser.tokens) {
      Some(t) -> match t.token {
        SqlNumber -> parse_type_size_list(sql_step(parser), left - 1),
        SqlPunctuation(p) -> if p == "," { parse_type_size_list(sql_step(parser), left - 1) }
        else { unsupported_here(parser) },
        _ -> unsupported_here(parser),
      },
      None -> unsupported_here(parser),
    }
  }

fn value_type_named(word: String) -> ValueType =
  if ["int", "integer", "bigint", "smallint", "int2", "int4", "int8"].contains(word) { IntType }
  else if ["text", "varchar", "char", "character", "citext", "name"].contains(word) { TextType }
  else if ["numeric", "decimal"].contains(word) { NumericType }
  else if ["real", "float", "float4", "float8", "double"].contains(word) { FloatType }
  else if ["boolean", "bool"].contains(word) { BoolType }
  else if ["bytea", "blob"].contains(word) { BytesType }
  else if ["json", "jsonb"].contains(word) { JsonType }
  else { UnknownType }

fn parse_primary(
  parser: SqlParser,
  left: Int,
) -> Result<ParseOutput<QueryExpression>, Finding> / {abort.raise} =
  if left <= 0 { too_deep(parser) } else {
    match sql_head(parser.tokens) {
      None -> unsupported_here(parser),
      Some(t) -> match t.token {
        SqlPlaceholder ->
          Ok(
            parse_output(
              sql_step(parser),
              PlaceholderExpression({ n: placeholder_number(t.text, 0), at: t.at }),
            ),
          ),
        SqlNumber ->
          Ok(
            parse_output(
              sql_step(parser),
              LiteralExpression(if t.text.contains(".") || t.text.contains("e") { NumericType }
              else { IntType }),
            ),
          ),
        SqlText -> Ok(parse_output(sql_step(parser), LiteralExpression(TextType))),
        SqlSemicolon -> unsupported_here(parser),
        SqlPunctuation(p) -> if p == "(" { parse_parenthesized(sql_step(parser), left - 1) }
        else { unsupported_here(parser) },
        SqlWord(w) -> if w.quoted { parse_column(parser, w.text, t.at) }
        else { parse_word(parser, w.text, t.at, left - 1) },
      },
    }
  }

fn parse_parenthesized(
  parser: SqlParser,
  left: Int,
) -> Result<ParseOutput<QueryExpression>, Finding> / {abort.raise} =
  if left <= 0 { too_deep(parser) } else if sql_at_word(parser, "select") {
    let q = parse_select(parser, left - 1)?;
    Ok(parse_output(expect_punctuation(q.parser, ")")?, SubqueryExpression(q.value)))
  } else {
    let inner = parse_expression(parser, left - 1)?;
    if sql_at_punctuation(inner.parser, ",") { unsupported(inner.parser, "a row of values") }
    else { Ok(parse_output(expect_punctuation(inner.parser, ")")?, inner.value)) }
  }

fn parse_word(
  parser: SqlParser,
  word: String,
  at: Int,
  left: Int,
) -> Result<ParseOutput<QueryExpression>, Finding> / {abort.raise} =
  if left <= 0 { too_deep(parser) }
  else if word == "null" { Ok(parse_output(sql_step(parser), NullExpression)) }
  else if word == "true" || word == "false" {
    Ok(parse_output(sql_step(parser), LiteralExpression(BoolType)))
  } else if word == "case" { parse_case(sql_step(parser), left - 1) } else if word == "exists" {
    let opened = expect_punctuation(sql_step(parser), "(")?;
    if !sql_at_word(opened, "select") { unsupported_here(opened) } else {
      let q = parse_select(opened, left - 1)?;
      Ok(parse_output(expect_punctuation(q.parser, ")")?, ExistsExpression(q.value)))
    }
  } else if word == "cast" {
    let value = parse_expression(expect_punctuation(sql_step(parser), "(")?, left - 1)?;
    let ty = parse_type(expect_word(value.parser, "as")?, left - 1)?;
    Ok(
      parse_output(
        expect_punctuation(ty.parser, ")")?,
        CastExpression({ value: value.value, ty: ty.value }),
      ),
    )
  } else if (word == "any" || word == "some") && sql_at_punctuation(sql_step(parser), "(") {
    let value = parse_expression(sql_step(sql_step(parser)), left - 1)?;
    Ok(parse_output(expect_punctuation(value.parser, ")")?, AnyExpression(value.value)))
  } else if sql_reserved(word) || word == "array" { unsupported_here(parser) }
  else if sql_at_punctuation(sql_step(parser), "(") {
    parse_call(sql_step(sql_step(parser)), word, left - 1)
  } else { parse_column(parser, word, at) }

fn parse_call(
  parser: SqlParser,
  name: String,
  left: Int,
) -> Result<ParseOutput<QueryExpression>, Finding> / {abort.raise} = {
  let called = parse_arguments(parser, name, left)?;
  if sql_at_word(called.parser, "over") || sql_at_word(called.parser, "filter")
      || sql_at_word(called.parser, "within") { unsupported_here(called.parser) }
  else { Ok(called) }
}

fn parse_arguments(
  parser: SqlParser,
  name: String,
  left: Int,
) -> Result<ParseOutput<QueryExpression>, Finding> / {abort.raise} =
  if sql_at_punctuation(parser, "*") {
    Ok(parse_output(expect_punctuation(sql_step(parser), ")")?, CountStarExpression))
  } else if sql_at_punctuation(parser, ")") {
    Ok(parse_output(sql_step(parser), CallExpression({ name: name, args: [] })))
  } else {
    let opened = if sql_at_word(parser, "distinct") || sql_at_word(parser, "all") {
      sql_step(parser)
    } else { parser };
    let args = parse_expressions(opened, [], left)?;
    Ok(
      parse_output(
        expect_punctuation(args.parser, ")")?,
        CallExpression({ name: name, args: args.value }),
      ),
    )
  }

fn parse_column(
  parser: SqlParser,
  word: String,
  at: Int,
) -> Result<ParseOutput<QueryExpression>, Finding> = {
  let after = sql_step(parser);
  if !sql_at_punctuation(after, ".") {
    Ok(parse_output(after, ColumnExpression({ table: "", column: word, at: at })))
  } else {
    match sql_nth(after.tokens, 1) {
      Some(n) -> match n.token {
        SqlWord(w) -> {
          let past = sql_step(sql_step(after));
          if sql_at_punctuation(past, ".") { unsupported_here(past) } else {
            Ok(parse_output(past, ColumnExpression({ table: word, column: w.text, at: n.at })))
          }
        },
        _ -> unsupported_here(after),
      },
      None -> unsupported_here(after),
    }
  }
}

fn parse_case(
  parser: SqlParser,
  left: Int,
) -> Result<ParseOutput<QueryExpression>, Finding> / {abort.raise} =
  if left <= 0 { too_deep(parser) } else {
    let subject = parse_case_subject(parser, left - 1)?;
    let whens = parse_whens(subject.parser, [], left - 1)?;
    let otherwise = parse_condition(whens.parser, "else", left - 1)?;
    Ok(
      parse_output(
        expect_word(otherwise.parser, "end")?,
        CaseExpression({ subject: subject.value, whens: whens.value, otherwise: otherwise.value }),
      ),
    )
  }

fn parse_case_subject(
  parser: SqlParser,
  left: Int,
) -> Result<ParseOutput<Option<QueryExpression>>, Finding> / {abort.raise} =
  if sql_at_word(parser, "when") { Ok(parse_output(parser, None)) } else {
    let s = parse_expression(parser, left)?;
    Ok(parse_output(s.parser, Some(s.value)))
  }

fn parse_whens(
  parser: SqlParser,
  accumulator: List<When>,
  left: Int,
) -> Result<ParseOutput<List<When>>, Finding> / {abort.raise} =
  if left <= 0 { too_deep(parser) } else if !sql_at_word(parser, "when") {
    if accumulator.len() == 0 { unsupported_here(parser) }
    else { Ok(parse_output(parser, accumulator)) }
  } else {
    let tested = parse_expression(sql_step(parser), left - 1)?;
    let value = parse_expression(expect_word(tested.parser, "then")?, left - 1)?;
    parse_whens(
      value.parser,
      accumulator.push({ cond: tested.value, value: value.value }),
      left - 1,
    )
  }

fn parse_insert(
  parser: SqlParser,
  left: Int,
) -> Result<ParseOutput<ParsedStatement>, Finding> / {abort.raise} =
  if left <= 0 { too_deep(parser) } else {
    let verb = sql_step(parser);
    let resolved = if sql_at_word(verb, "or") { sql_step(sql_step(verb)) } else { verb };
    let target = parse_name(expect_word(resolved, "into")?, left - 1)?;
    let aliased = parse_into_alias(target.parser, target.value.name, left - 1)?;
    let columns = parse_insert_columns(aliased.parser, left - 1)?;
    let rows = parse_insert_source(columns.parser, left - 1)?;
    if sql_at_word(rows.parser, "on") { unsupported(rows.parser, "`on conflict`") } else {
      let returning = parse_returning(rows.parser, left - 1)?;
      Ok(
        parse_output(
          returning.parser,
          InsertStatement({
            target: {
              table: target.value.name,
              alias: aliased.value,
              at: target.value.at,
              optional: false,
            },
            columns: columns.value,
            rows: rows.value,
            returning: returning.value,
          }),
        ),
      )
    }
  }

fn parse_into_alias(
  parser: SqlParser,
  table: String,
  left: Int,
) -> Result<ParseOutput<String>, Finding> =
  if sql_at_word(parser, "as") {
    let a = parse_name(sql_step(parser), left)?;
    Ok(parse_output(a.parser, a.value.name))
  } else { Ok(parse_output(parser, table)) }

fn parse_insert_columns(
  parser: SqlParser,
  left: Int,
) -> Result<ParseOutput<List<ColumnReference>>, Finding> =
  if sql_at_punctuation(parser, "(") { parse_column_list(sql_step(parser), [], left) }
  else { Ok(parse_output(parser, [])) }

fn parse_column_list(
  parser: SqlParser,
  accumulator: List<ColumnReference>,
  left: Int,
) -> Result<ParseOutput<List<ColumnReference>>, Finding> =
  if left <= 0 { too_deep(parser) } else {
    let one = parse_name(parser, left - 1)?;
    let column = { table: "", column: one.value.name, at: one.value.at };
    let comma = sql_eat_punctuation(one.parser, ",");
    if comma.ate { parse_column_list(comma.parser, accumulator.push(column), left - 1) }
    else { Ok(parse_output(expect_punctuation(one.parser, ")")?, accumulator.push(column))) }
  }

fn parse_insert_source(
  parser: SqlParser,
  left: Int,
) -> Result<ParseOutput<InsertSource>, Finding> / {abort.raise} =
  if sql_at_word(parser, "values") {
    let rows = parse_value_rows(sql_step(parser), [], left)?;
    Ok(parse_output(rows.parser, ByValues(rows.value)))
  } else if sql_at_word(parser, "select") {
    let q = parse_select(parser, left)?;
    Ok(parse_output(q.parser, BySelect(q.value)))
  } else if sql_at_word(parser, "default") {
    Ok(parse_output(expect_word(sql_step(parser), "values")?, ByDefaults))
  } else { unsupported_here(parser) }

fn parse_value_rows(
  parser: SqlParser,
  accumulator: List<List<QueryExpression>>,
  left: Int,
) -> Result<ParseOutput<List<List<QueryExpression>>>, Finding> / {abort.raise} =
  if left <= 0 { too_deep(parser) } else {
    let values = parse_expressions(expect_punctuation(parser, "(")?, [], left - 1)?;
    let closed = expect_punctuation(values.parser, ")")?;
    let comma = sql_eat_punctuation(closed, ",");
    if comma.ate { parse_value_rows(comma.parser, accumulator.push(values.value), left - 1) }
    else { Ok(parse_output(closed, accumulator.push(values.value))) }
  }

fn parse_returning(
  parser: SqlParser,
  left: Int,
) -> Result<ParseOutput<List<SelectItem>>, Finding> / {abort.raise} =
  if sql_at_word(parser, "returning") { parse_select_items(sql_step(parser), [], left) }
  else { Ok(parse_output(parser, [])) }

fn parse_update(
  parser: SqlParser,
  left: Int,
) -> Result<ParseOutput<ParsedStatement>, Finding> / {abort.raise} =
  if left <= 0 { too_deep(parser) } else {
    let verb = sql_step(parser);
    let resolved = if sql_at_word(verb, "or") { sql_step(sql_step(verb)) } else { verb };
    let target = parse_source(resolved, false, left - 1)?;
    let sets = parse_assignments(expect_word(target.parser, "set")?, [], left - 1)?;
    let from = parse_from(sets.parser, "from", left - 1)?;
    let filter = parse_condition(from.parser, "where", left - 1)?;
    let returning = parse_returning(filter.parser, left - 1)?;
    Ok(
      parse_output(
        returning.parser,
        UpdateStatement({
          target: target.value,
          sets: sets.value,
          sources: from.value.sources,
          conditions: from.value.conditions,
          filter: filter.value,
          returning: returning.value,
        }),
      ),
    )
  }

fn parse_assignments(
  parser: SqlParser,
  accumulator: List<Assignment>,
  left: Int,
) -> Result<ParseOutput<List<Assignment>>, Finding> / {abort.raise} =
  if left <= 0 { too_deep(parser) } else if sql_at_punctuation(parser, "(") {
    unsupported(
      parser,
      "assigning several columns at once with `set (a, b) = ...` is not supported",
    )
  } else {
    let column = parse_name(parser, left - 1)?;
    let eq = expect_punctuation(column.parser, "=")?;
    let value = parse_expression(eq, left - 1)?;
    let one = {
      column: { table: "", column: column.value.name, at: column.value.at },
      value: value.value,
    };
    let comma = sql_eat_punctuation(value.parser, ",");
    if comma.ate { parse_assignments(comma.parser, accumulator.push(one), left - 1) }
    else { Ok(parse_output(value.parser, accumulator.push(one))) }
  }

fn parse_delete(
  parser: SqlParser,
  left: Int,
) -> Result<ParseOutput<ParsedStatement>, Finding> / {abort.raise} =
  if left <= 0 { too_deep(parser) } else {
    let target = parse_source(expect_word(sql_step(parser), "from")?, false, left - 1)?;
    let using = parse_from(target.parser, "using", left - 1)?;
    let filter = parse_condition(using.parser, "where", left - 1)?;
    let returning = parse_returning(filter.parser, left - 1)?;
    Ok(
      parse_output(
        returning.parser,
        DeleteStatement({
          target: target.value,
          sources: using.value.sources,
          conditions: using.value.conditions,
          filter: filter.value,
          returning: returning.value,
        }),
      ),
    )
  }

type TableBinding = { name: String, table: Option<Table>, optional: Bool }

type ExpressionType = { ty: ValueType, nullable: Bool }

type PlaceholderType = { n: Int, at: Int, ty: ValueType, what: String }

type ResultColumn = { name: String, ty: ValueType, nullable: Bool }

type CheckState = {
  findings: List<Finding>,
  placed: List<PlaceholderType>,
  schema: Schema,
  dialect: Dialect,
  sql: Bytes,
}

type TypeResult = { j: CheckState, t: ExpressionType }

type ResultColumns = { j: CheckState, returned: List<ResultColumn> }

type Target = { description: String, ty: ValueType }

type Targets = { j: CheckState, targets: List<Target> }

type Lookup = | Found(ExpressionType) | Missing(String) | Unknown

fn add_finding(j: CheckState, misfit: FindingKind, at: Int, message: String) -> CheckState =
  { ..j, findings: j.findings.push({ kind: misfit, at: at, message: message }) }

fn type_result(j: CheckState, ty: ValueType, nullable: Bool) -> TypeResult =
  { j: j, t: { ty: ty, nullable: nullable } }

fn column_value_type(t: ColumnType) -> ValueType =
  match t {
    IntColumn -> IntType,
    BoolColumn -> BoolType,
    TText -> TextType,
    BytesColumn -> BytesType,
    FloatColumn -> FloatType,
    TNumeric(_, _) -> NumericType,
    JsonColumn -> JsonType,
    TArray(inner) -> ArrayType(column_value_type(inner)),
  }

fn column_type_in(t: Table, optional: Bool, name: String) -> Option<ExpressionType> =
  match t.columns.find(|c: Column| c.name == name) {
    None -> None,
    Some(c) ->
      Some({
        ty: column_value_type(c.ty),
        nullable: optional || (c.nullable && !t.primary_key.contains(c.name)),
      }),
  }

fn bind_source(j: CheckState, s: Source) -> { j: CheckState, bound: TableBinding } =
  match j.schema.tables.find(|t: Table| t.name == s.table) {
    Some(t) -> { j: j, bound: { name: s.alias, table: Some(t), optional: s.optional } },
    None ->
      {
        j: add_finding(
          j,
          Undeclared,
          s.at,
          "names the table `" ++ s.table ++ "`, which the schema does not declare",
        ),
        bound: { name: s.alias, table: None, optional: s.optional },
      },
  }

fn bind_sources(
  j: CheckState,
  sources: List<Source>,
) -> { j: CheckState, level: List<TableBinding> } =
  sources.fold(
    { j: j, level: [] },
    |accumulator: { j: CheckState, level: List<TableBinding> }, s: Source| {
      let b = bind_source(accumulator.j, s);
      { j: b.j, level: accumulator.level.push(b.bound) }
    },
  )

fn binding_table_name(b: TableBinding) -> String =
  match b.table { Some(t) -> t.name, None -> b.name }

fn lookup_column(scope: List<List<TableBinding>>, r: ColumnReference) -> Lookup =
  if r.table == "" {
    match scope {
      [] -> Missing("names the column `" ++ r.column ++ "`, and reads no table"),
      [level, ..] -> lookup_bare_column(scope, r.column, missing_column_message(level, r.column)),
    }
  } else {
    match scope.fold(None, |found: Option<TableBinding>, level: List<TableBinding>|
        match found { Some(_) -> found, None -> level.find(|b: TableBinding| b.name == r.table) }) {
      None ->
        Missing(
          "names `" ++ r.table ++ "." ++ r.column ++ "`, and no table it reads is called `"
            ++ r.table
            ++ "`",
        ),
      Some(b) -> match b.table {
        None -> Unknown,
        Some(t) -> match column_type_in(t, b.optional, r.column) {
          Some(typed) -> Found(typed),
          None ->
            Missing(
              "names the column `" ++ r.column ++ "`, which `" ++ t.name ++ "` does not have",
            ),
        },
      },
    }
  }

fn lookup_bare_column(scope: List<List<TableBinding>>, column: String, missing: String) -> Lookup =
  match scope {
    [] -> Missing(missing),
    [level, ..outer] -> {
      let matching_bindings = level.filter(|b: TableBinding|
        match b.table { Some(t) -> column_type_in(t, false, column) != None, None -> false });
      match matching_bindings {
        [first, second, ..] ->
          Missing(
            "names the column `" ++ column ++ "`, which `" ++ binding_table_name(first) ++ "` and `"
              ++ binding_table_name(second)
              ++ "` both have: name it with its table",
          ),
        [only] -> match only.table {
          Some(t) -> match column_type_in(t, only.optional, column) {
            Some(typed) -> Found(typed),
            None -> Unknown,
          },
          None -> Unknown,
        },
        [] -> if level.find(|b: TableBinding| b.table == None) != None { Unknown }
        else { lookup_bare_column(outer, column, missing) },
      }
    },
  }

fn missing_column_message(level: List<TableBinding>, column: String) -> String =
  match level {
    [] -> "names the column `" ++ column ++ "`, and reads no table",
    [one] ->
      "names the column `" ++ column ++ "`, which `" ++ binding_table_name(one)
        ++ "` does not have",
    _ ->
      "names the column `" ++ column ++ "`, which none of `"
        ++ String::join(level.map(binding_table_name), "`, `")
        ++ "` has",
  }

fn record_placeholder(j: CheckState, n: Int, at: Int, ty: ValueType, what: String) -> CheckState =
  if ty == UnknownType || j.placed.find(|p: PlaceholderType| p.n == n) != None { j }
  else { { ..j, placed: j.placed.push({ n: n, at: at, ty: ty, what: what }) } }

fn is_placeholder(e: QueryExpression) -> Bool =
  match e { PlaceholderExpression(_) -> true, _ -> false }

fn operand_description(e: QueryExpression) -> String =
  match e {
    ColumnExpression(r) ->
      "`" ++ (if r.table == "" { r.column } else { r.table ++ "." ++ r.column }) ++ "`",
    _ -> "an expression",
  }

fn check_expression(
  j: CheckState,
  scope: List<List<TableBinding>>,
  e: QueryExpression,
  want: ValueType,
  what: String,
  left: Int,
) -> TypeResult / {abort.raise} =
  if left <= 0 { type_result(j, UnknownType, true) } else {
    match e {
      ColumnExpression(r) -> match lookup_column(scope, r) {
        Found(t) -> { j: j, t: t },
        Unknown -> type_result(j, UnknownType, true),
        Missing(reason) -> type_result(add_finding(j, Undeclared, r.at, reason), UnknownType, true),
      },
      PlaceholderExpression(p) ->
        type_result(record_placeholder(j, p.n, p.at, want, what), want, false),
      LiteralExpression(ty) -> type_result(j, ty, false),
      NullExpression -> type_result(j, NullType, true),
      CountStarExpression -> type_result(j, IntType, false),
      CallExpression(c) -> check_call(j, scope, c.name, c.args, want, left - 1),
      BinaryExpression(o) ->
        check_operator(
          j,
          scope,
          o.operation,
          o.left_operand,
          o.right_operand,
          want,
          what,
          left - 1,
        ),
      NotExpression(x) -> {
        let inner = check_expression(j, scope, x, BoolType, "a condition", left - 1);
        type_result(inner.j, BoolType, inner.t.nullable)
      },
      NegateExpression(x) -> check_expression(j, scope, x, want, what, left - 1),
      IsNullExpression(x) ->
        type_result(check_expression(j, scope, x, UnknownType, "", left - 1).j, BoolType, false),
      InListExpression(i) -> check_in_list(j, scope, i.value, i.items, left - 1),
      InSelectExpression(i) -> {
        let q = check_select(j, scope, i.query, left - 1);
        let column = match q.returned { [a, ..] -> a.ty, [] -> UnknownType };
        type_result(
          check_expression(q.j, scope, i.value, column, "an expression", left - 1).j,
          BoolType,
          true,
        )
      },
      ExistsExpression(q) -> type_result(check_select(j, scope, q, left - 1).j, BoolType, false),
      SubqueryExpression(q) -> {
        let s = check_select(j, scope, q, left - 1);
        match s.returned {
          [a, ..] -> type_result(s.j, a.ty, true),
          [] -> type_result(s.j, UnknownType, true),
        }
      },
      BetweenExpression(b) -> {
        let v = check_expression(j, scope, b.value, UnknownType, "", left - 1);
        let low = check_expression(
          v.j,
          scope,
          b.low,
          v.t.ty,
          operand_description(b.value),
          left - 1,
        );
        let high = check_expression(
          low.j,
          scope,
          b.high,
          v.t.ty,
          operand_description(b.value),
          left - 1,
        );
        type_result(high.j, BoolType, v.t.nullable || low.t.nullable || high.t.nullable)
      },
      CastExpression(c) -> {
        let v = check_expression(
          j,
          scope,
          c.value,
          c.ty,
          "a value cast to " ++ value_type_text(c.ty),
          left - 1,
        );
        type_result(v.j, c.ty, v.t.nullable)
      },
      CaseExpression(c) ->
        check_case(j, scope, c.subject, c.whens, c.otherwise, want, what, left - 1),
      AnyExpression(x) -> {
        let v = check_expression(
          j,
          scope,
          x,
          if want == UnknownType { UnknownType } else { ArrayType(want) },
          what,
          left - 1,
        );
        type_result(v.j, want, false)
      },
    }
  }

fn is_comparison(operator: String) -> Bool = ["=", "<>", "<", "<=", ">", ">="].contains(operator)

fn check_operator(
  j: CheckState,
  scope: List<List<TableBinding>>,
  operator: String,
  left_operand: QueryExpression,
  right_operand: QueryExpression,
  want: ValueType,
  what: String,
  left: Int,
) -> TypeResult / {abort.raise} =
  if operator == "and" || operator == "or" {
    let l = check_expression(j, scope, left_operand, BoolType, "a condition", left - 1);
    let r = check_expression(l.j, scope, right_operand, BoolType, "a condition", left - 1);
    type_result(r.j, BoolType, l.t.nullable || r.t.nullable)
  } else if operator == "||" || operator == "like" {
    let l = check_expression(
      j,
      scope,
      left_operand,
      TextType,
      operand_description(right_operand),
      left - 1,
    );
    let r = check_expression(
      l.j,
      scope,
      right_operand,
      TextType,
      operand_description(left_operand),
      left - 1,
    );
    type_result(
      r.j,
      if operator == "like" { BoolType } else { TextType },
      l.t.nullable || r.t.nullable,
    )
  } else if is_comparison(operator) {
    let pair = check_operands(j, scope, left_operand, right_operand, UnknownType, "", left - 1);
    type_result(pair.j, BoolType, pair.l.nullable || pair.r.nullable)
  } else {
    let pair = check_operands(j, scope, left_operand, right_operand, want, what, left - 1);
    type_result(pair.j, arithmetic_type(pair.l.ty, pair.r.ty), pair.l.nullable || pair.r.nullable)
  }

fn check_operands(
  j: CheckState,
  scope: List<List<TableBinding>>,
  left_operand: QueryExpression,
  right_operand: QueryExpression,
  want: ValueType,
  what: String,
  left: Int,
) -> { j: CheckState, l: ExpressionType, r: ExpressionType } / {abort.raise} =
  if is_placeholder(left_operand) && !is_placeholder(right_operand) {
    let r = check_expression(j, scope, right_operand, want, what, left);
    let l = check_expression(
      r.j,
      scope,
      left_operand,
      r.t.ty,
      operand_description(right_operand),
      left,
    );
    { j: l.j, l: l.t, r: r.t }
  } else {
    let l = check_expression(j, scope, left_operand, want, what, left);
    let r = check_expression(
      l.j,
      scope,
      right_operand,
      l.t.ty,
      operand_description(left_operand),
      left,
    );
    { j: r.j, l: l.t, r: r.t }
  }

fn arithmetic_type(l: ValueType, r: ValueType) -> ValueType =
  if l == UnknownType || l == NullType { r }
  else if r == UnknownType || r == NullType { l }
  else if l == FloatType || r == FloatType { FloatType }
  else if l == NumericType || r == NumericType { NumericType }
  else { l }

fn check_in_list(
  j: CheckState,
  scope: List<List<TableBinding>>,
  value: QueryExpression,
  items: List<QueryExpression>,
  left: Int,
) -> TypeResult / {abort.raise} =
  if is_placeholder(value) {
    let typed = check_arguments(j, scope, items, UnknownType, true, left);
    type_result(
      check_expression(
        typed.j,
        scope,
        value,
        first_known_type(typed.types),
        "an expression",
        left,
      ).j,
      BoolType,
      true,
    )
  } else {
    let v = check_expression(j, scope, value, UnknownType, "", left);
    let listed = items.fold(v.j, |accumulator: CheckState, x: QueryExpression|
      check_expression(accumulator, scope, x, v.t.ty, operand_description(value), left).j);
    type_result(listed, BoolType, true)
  }

fn check_arguments(
  j: CheckState,
  scope: List<List<TableBinding>>,
  args: List<QueryExpression>,
  want: ValueType,
  follow: Bool,
  left: Int,
) -> { j: CheckState, types: List<ExpressionType> } / {abort.raise} =
  args.fold(
    { j: j, types: [] },
    |accumulator: { j: CheckState, types: List<ExpressionType> }, x: QueryExpression| {
      let lead = if !follow { UnknownType }
      else if want != UnknownType { want }
      else { first_known_type(accumulator.types) };
      let t = check_expression(accumulator.j, scope, x, lead, "an argument", left);
      { j: t.j, types: accumulator.types.push(t.t) }
    },
  )

fn first_known_type(types: List<ExpressionType>) -> ValueType =
  types.fold(UnknownType, |found: ValueType, t: ExpressionType|
    if found == UnknownType && t.ty != NullType { t.ty } else { found })

const text_functions: List<String> =
  [
    "lower",
    "upper",
    "trim",
    "btrim",
    "ltrim",
    "rtrim",
    "substr",
    "substring",
    "replace",
    "left",
    "right",
    "lpad",
    "rpad",
    "repeat",
    "reverse",
    "translate",
    "split_part",
    "md5",
    "concat",
    "concat_ws",
    "overlay",
    "encode",
    "jsonb_extract_path_text",
    "jsonb_typeof",
    "group_concat",
    "string_agg",
    "hex",
    "quote",
    "printf",
    "format",
  ]

const json_functions: List<String> =
  [
    "json_build_array",
    "json_build_object",
    "jsonb_build_array",
    "jsonb_build_object",
    "to_json",
    "to_jsonb",
    "jsonb_extract_path",
    "jsonb_strip_nulls",
  ]

fn check_call(
  j: CheckState,
  scope: List<List<TableBinding>>,
  name: String,
  args: List<QueryExpression>,
  want: ValueType,
  left: Int,
) -> TypeResult / {abort.raise} = {
  let follows = ["coalesce", "ifnull", "greatest", "least", "nullif", "min", "max"].contains(name);
  let typed = check_arguments(j, scope, args, want, follows, left);
  let first: ExpressionType = match typed.types {
    [t, ..] -> t,
    [] -> { ty: UnknownType, nullable: true },
  };
  let any_null = typed.types.fold(false, |n: Bool, t: ExpressionType| n || t.nullable);
  let all_null = typed.types.fold(true, |n: Bool, t: ExpressionType| n && t.nullable);
  let real = if first.ty == FloatType { FloatType } else { NumericType };
  if name == "count" { type_result(typed.j, IntType, false) } else if name == "sum" {
    type_result(
      typed.j,
      if first.ty == IntType && j.dialect == Postgres { NumericType } else { first.ty },
      true,
    )
  } else if name == "total" { type_result(typed.j, FloatType, false) }
  else if name == "avg" { type_result(typed.j, real, true) }
  else if ["min", "max", "nullif"].contains(name) {
    type_result(typed.j, first_known_type(typed.types), true)
  } else if ["coalesce", "ifnull", "greatest", "least"].contains(name) {
    type_result(typed.j, first_known_type(typed.types), all_null)
  } else if text_functions.contains(name) {
    type_result(typed.j, TextType, name != "concat" && any_null)
  } else if [
      "length",
      "char_length",
      "character_length",
      "octet_length",
      "strpos",
      "position",
      "jsonb_array_length",
    ].contains(
      name,
    ) { type_result(typed.j, IntType, any_null) }
  else if ["abs", "round", "ceil", "ceiling", "floor", "trunc", "sign", "mod", "div"].contains(
      name,
    ) { type_result(typed.j, first.ty, any_null) }
  else if ["sqrt", "exp", "ln", "log", "power"].contains(name) {
    type_result(typed.j, real, any_null)
  } else if name == "starts_with" { type_result(typed.j, BoolType, any_null) }
  else if json_functions.contains(name) { type_result(typed.j, JsonType, any_null) }
  else if name == "decode" { type_result(typed.j, BytesType, any_null) }
  else { type_result(typed.j, UnknownType, true) }
}

fn check_case(
  j: CheckState,
  scope: List<List<TableBinding>>,
  subject: Option<QueryExpression>,
  whens: List<When>,
  otherwise: Option<QueryExpression>,
  want: ValueType,
  what: String,
  left: Int,
) -> TypeResult / {abort.raise} = {
  let tested: { j: CheckState, ty: ValueType, what: String } = match subject {
    Some(x) -> {
      let t = check_expression(j, scope, x, UnknownType, "", left);
      { j: t.j, ty: t.t.ty, what: operand_description(x) }
    },
    None -> { j: j, ty: BoolType, what: "a condition" },
  };
  let arms = whens.fold(
    { j: tested.j, types: [] },
    |accumulator: { j: CheckState, types: List<ExpressionType> }, w: When| {
      let tried = check_expression(accumulator.j, scope, w.cond, tested.ty, tested.what, left);
      let lead = if want != UnknownType { want } else { first_known_type(accumulator.types) };
      let value = check_expression(tried.j, scope, w.value, lead, what, left);
      { j: value.j, types: accumulator.types.push(value.t) }
    },
  );
  match otherwise {
    Some(x) -> {
      let t = check_expression(
        arms.j,
        scope,
        x,
        if want != UnknownType { want } else { first_known_type(arms.types) },
        what,
        left,
      );
      let types = arms.types.push(t.t);
      type_result(
        t.j,
        first_known_type(types),
        types.fold(false, |n: Bool, a: ExpressionType| n || a.nullable),
      )
    },
    None -> type_result(arms.j, first_known_type(arms.types), true),
  }
}

fn check_conditions(
  j: CheckState,
  scope: List<List<TableBinding>>,
  conditions: List<QueryExpression>,
  left: Int,
) -> CheckState / {abort.raise} =
  conditions.fold(j, |accumulator: CheckState, c: QueryExpression|
    check_expression(accumulator, scope, c, BoolType, "a condition", left).j)

fn option_to_list(e: Option<QueryExpression>) -> List<QueryExpression> =
  match e { Some(x) -> [x], None -> [] }

fn check_select(
  j: CheckState,
  outer: List<List<TableBinding>>,
  q: SelectQuery,
  left: Int,
) -> ResultColumns / {abort.raise} =
  if left <= 0 { { j: j, returned: [] } } else {
    let bound = bind_sources(j, q.sources);
    let scope = [bound.level].concat(outer);
    let conditioned = check_conditions(
      bound.j,
      scope,
      q.conditions.concat(option_to_list(q.filter)),
      left - 1,
    );
    let grouped = q.group.fold(conditioned, |accumulator: CheckState, g: QueryExpression|
      check_expression(accumulator, scope, g, UnknownType, "", left - 1).j);
    let had = check_conditions(grouped, scope, option_to_list(q.having), left - 1);
    let items = check_result_columns(had, scope, bound.level, q.items, left - 1);
    let names = items.returned.map(|a: ResultColumn| a.name);
    let ordered = q.order.fold(items.j, |accumulator: CheckState, o: QueryExpression|
      match o {
        ColumnExpression(r) -> if r.table == "" && names.contains(r.column) { accumulator }
        else { check_expression(accumulator, scope, o, UnknownType, "", left - 1).j },
        LiteralExpression(_) -> accumulator,
        _ -> check_expression(accumulator, scope, o, UnknownType, "", left - 1).j,
      });
    let bounded = q.bounds.fold(ordered, |accumulator: CheckState, b: QueryExpression|
      check_expression(accumulator, scope, b, IntType, "a `limit` or an `offset`", left - 1).j);
    { j: bounded, returned: items.returned }
  }

fn check_result_columns(
  j: CheckState,
  scope: List<List<TableBinding>>,
  level: List<TableBinding>,
  items: List<SelectItem>,
  left: Int,
) -> ResultColumns / {abort.raise} =
  items.fold({ j: j, returned: [] }, |accumulator: ResultColumns, item: SelectItem|
    match item {
      Wildcard(a) ->
        {
          j: add_finding(
            accumulator.j,
            SelectStar,
            a.at,
            "`*` returns whatever columns "
              ++ (if a.table == "" { "the tables have" } else { "`" ++ a.table ++ "` has" })
              ++ " when the statement runs, so a column added to the schema changes every row it returns: name the columns",
          ),
          returned: accumulator.returned.concat(every_column(level, a.table)),
        },
      ExpressionItem(o) -> {
        let t = check_expression(
          accumulator.j,
          scope,
          o.value,
          UnknownType,
          "a returned expression",
          left,
        );
        {
          j: t.j,
          returned: accumulator.returned.push({
            name: result_column_name(j.dialect, j.sql, o.value, o.name, o.from, o.to),
            ty: t.t.ty,
            nullable: t.t.nullable,
          }),
        }
      },
    })

fn every_column(level: List<TableBinding>, table: String) -> List<ResultColumn> =
  level.fold([], |accumulator: List<ResultColumn>, b: TableBinding|
    if table != "" && b.name != table { accumulator } else {
      match b.table {
        None -> accumulator,
        Some(t) ->
          accumulator.concat(
            t.columns.map(|c: Column| {
              let typed = column_type_in(t, b.optional, c.name).unwrap_or({
                ty: UnknownType,
                nullable: true,
              });
              { name: c.name, ty: typed.ty, nullable: typed.nullable }
            }),
          ),
      }
    })

fn result_column_name(
  dialect: Dialect,
  sql: Bytes,
  value: QueryExpression,
  alias: Option<String>,
  from: Int,
  to: Int,
) -> String / {abort.raise} =
  match alias {
    Some(n) -> n,
    None -> match value {
      ColumnExpression(r) -> r.column,
      _ -> match dialect {
        Postgres -> postgres_column_name(value),
        Sqlite -> {
          let end = min(to, sql.len());
          let start = min(max(from, 0), end);
          let trimmed = iterate(end, end - start + 1, |e: Int|
            if e > start && is_space_byte(sql.at(e - 1)) { Continue(e - 1) } else { Stop(e) });
          String::of_bytes_lossy(sql.slice(start, trimmed))
        },
      },
    },
  }

fn postgres_column_name(e: QueryExpression) -> String =
  match e {
    ColumnExpression(r) -> r.column,
    CallExpression(c) -> c.name,
    CountStarExpression -> "count",
    CastExpression(c) -> match c.value {
      ColumnExpression(r) -> r.column,
      CallExpression(f) -> f.name,
      CountStarExpression -> "count",
      _ -> postgres_type_name(c.ty),
    },
    CaseExpression(_) -> "case",
    ExistsExpression(_) -> "exists",
    _ -> "?column?",
  }

fn postgres_type_name(ty: ValueType) -> String =
  match ty {
    IntType -> "int8",
    BoolType -> "bool",
    TextType -> "text",
    BytesType -> "bytea",
    FloatType -> "float8",
    NumericType -> "numeric",
    JsonType -> "jsonb",
    _ -> "?column?",
  }

fn type_check_statement(
  j: CheckState,
  s: ParsedStatement,
  left: Int,
) -> ResultColumns / {abort.raise} =
  match s {
    SelectStatement(q) -> check_select(j, [], q, left),
    InsertStatement(i) -> {
      let target = bind_source(j, i.target);
      let columns = insert_targets(target.j, target.bound, i.columns);
      let filled = match i.rows {
        ByValues(tuples) ->
          tuples.fold(columns.j, |accumulator: CheckState, tuple: List<QueryExpression>|
            check_value_row(accumulator, columns.targets, tuple, i.target.at, left - 1)),
        BySelect(q) -> {
          let a = check_select(columns.j, [], q, left - 1);
          if columns.targets.len() == 0 || a.returned.len() == columns.targets.len() { a.j } else {
            add_finding(
              a.j,
              ValueMismatch,
              i.target.at,
              "the `select` returns " ++ count_text(a.returned.len(), "column") ++ " for "
                ++ count_text(columns.targets.len(), "column"),
            )
          }
        },
        ByDefaults -> columns.j,
      };
      check_result_columns(filled, [[target.bound]], [target.bound], i.returning, left - 1)
    },
    UpdateStatement(u) -> {
      let target = bind_source(j, u.target);
      let others = bind_sources(target.j, u.sources);
      let level = [target.bound].concat(others.level);
      let set = u.sets.fold(others.j, |accumulator: CheckState, a: Assignment|
        check_assignment(accumulator, [level], target.bound, a, left - 1));
      let filtered = check_conditions(
        set,
        [level],
        u.conditions.concat(option_to_list(u.filter)),
        left - 1,
      );
      check_result_columns(filtered, [level], level, u.returning, left - 1)
    },
    DeleteStatement(d) -> {
      let target = bind_source(j, d.target);
      let others = bind_sources(target.j, d.sources);
      let level = [target.bound].concat(others.level);
      let filtered = check_conditions(
        others.j,
        [level],
        d.conditions.concat(option_to_list(d.filter)),
        left - 1,
      );
      check_result_columns(filtered, [level], level, d.returning, left - 1)
    },
  }

fn insert_targets(j: CheckState, bound: TableBinding, columns: List<ColumnReference>) -> Targets =
  match bound.table {
    None ->
      {
        j: j,
        targets: columns.map(|r: ColumnReference|
          { description: "`" ++ r.column ++ "`", ty: UnknownType }),
      },
    Some(t) -> if columns.len() == 0 {
      {
        j: j,
        targets: t.columns.map(|c: Column|
          { description: "`" ++ t.name ++ "." ++ c.name ++ "`", ty: column_value_type(c.ty) }),
      }
    } else {
      columns.fold({ j: j, targets: [] }, |accumulator: Targets, r: ColumnReference|
        match t.columns.find(|c: Column| c.name == r.column) {
          Some(c) ->
            {
              j: accumulator.j,
              targets: accumulator.targets.push({
                description: "`" ++ t.name ++ "." ++ c.name ++ "`",
                ty: column_value_type(c.ty),
              }),
            },
          None ->
            {
              j: add_finding(
                accumulator.j,
                Undeclared,
                r.at,
                "names the column `" ++ r.column ++ "`, which `" ++ t.name ++ "` does not have",
              ),
              targets: accumulator.targets.push({
                description: "`" ++ r.column ++ "`",
                ty: UnknownType,
              }),
            },
        })
    },
  }

fn check_value_row(
  j: CheckState,
  targets: List<Target>,
  tuple: List<QueryExpression>,
  at: Int,
  left: Int,
) -> CheckState / {abort.raise} = {
  let counted = if targets.len() == 0 || tuple.len() == targets.len() { j } else {
    add_finding(
      j,
      ValueMismatch,
      at,
      "a row of the `values` holds " ++ count_text(tuple.len(), "value") ++ " for "
        ++ count_text(targets.len(), "column"),
    )
  };
  range(0, tuple.len()).fold(counted, |accumulator: CheckState, i: Int|
    match tuple.at(i) {
      None -> accumulator,
      Some(x) -> match targets.at(i) {
        Some(target) -> check_expression(accumulator, [], x, target.ty, target.description, left).j,
        None -> check_expression(accumulator, [], x, UnknownType, "", left).j,
      },
    })
}

fn check_assignment(
  j: CheckState,
  scope: List<List<TableBinding>>,
  target: TableBinding,
  a: Assignment,
  left: Int,
) -> CheckState / {abort.raise} =
  match target.table {
    None -> check_expression(j, scope, a.value, UnknownType, "", left).j,
    Some(t) -> match t.columns.find(|c: Column| c.name == a.column.column) {
      None ->
        check_expression(
          add_finding(
            j,
            Undeclared,
            a.column.at,
            "names the column `" ++ a.column.column ++ "`, which `" ++ t.name ++ "` does not have",
          ),
          scope,
          a.value,
          UnknownType,
          "",
          left,
        ).j,
      Some(c) ->
        check_expression(
          j,
          scope,
          a.value,
          column_value_type(c.ty),
          "`" ++ t.name ++ "." ++ c.name ++ "`",
          left,
        ).j,
    },
  }

fn row_mismatch(reason: String) -> Finding = { kind: RowMismatch, at: 0, message: reason }

fn check_row_fields(fields: List<Field>, returned: List<ResultColumn>) -> List<Finding> = {
  let named = returned.fold(
    { seen: [], found: [] },
    |accumulator: { seen: List<String>, found: List<Finding> }, a: ResultColumn|
      if accumulator.seen.contains(a.name) {
        {
          seen: accumulator.seen,
          found: accumulator.found.push(
            row_mismatch(
              "the statement returns two columns named `" ++ a.name ++ "`: name one with `as`",
            ),
          ),
        }
      } else { { seen: accumulator.seen.push(a.name), found: accumulator.found } },
  );
  let fielded = fields.fold(named.found, |accumulator: List<Finding>, f: Field|
    match returned.find(|a: ResultColumn| a.name == f.name) {
      None ->
        accumulator.push(
          row_mismatch(
            "the row type's field `" ++ f.name ++ "` is no column the statement returns",
          ),
        ),
      Some(a) -> match field_mismatch(f.kind, a) {
        None -> accumulator,
        Some(reason) -> accumulator.push(row_mismatch(reason)),
      },
    });
  returned.fold(fielded, |accumulator: List<Finding>, a: ResultColumn|
    if fields.find(|f: Field| f.name == a.name) == None {
      accumulator.push(
        row_mismatch(
          "the statement returns `" ++ a.name ++ "`, and the row type has no field for it",
        ),
      )
    } else { accumulator })
}

fn field_mismatch(kind: FieldKind, a: ResultColumn) -> Option<String> =
  match kind {
    OptionalField(inner) -> if a.ty == NullType || field_kind_fits(inner, a.ty) { None }
    else { Some(field_type_message(kind, a)) },
    _ -> if !field_kind_fits(kind, a.ty) { Some(field_type_message(kind, a)) } else if a.nullable {
      Some(
        "the column `" ++ a.name
          ++ "` may be null, and the row type's field for it is not an `Option`",
      )
    } else { None },
  }

fn field_type_message(kind: FieldKind, a: ResultColumn) -> String =
  "the column `" ++ a.name ++ "` is " ++ value_type_text(a.ty)
    ++ ", and the row type's field for it is "
    ++ field_text(kind)

fn field_kind_fits(kind: FieldKind, ty: ValueType) -> Bool =
  match ty {
    UnknownType -> true,
    NullType -> false,
    _ -> match kind {
      TextField -> ty == TextType,
      IntField -> ty == IntType,
      BoolField -> ty == BoolType,
      FloatField -> ty == FloatType,
      NumericField -> ty == NumericType,
      BytesField -> ty == BytesType,
      JsonField -> ty == JsonType,
      ArrayField(inner) -> match ty { ArrayType(t) -> field_kind_fits(inner, t), _ -> false },
      OptionalField(inner) -> field_kind_fits(inner, ty),
    },
  }

fn value_type_text(ty: ValueType) -> String =
  match ty {
    IntType -> "`bigint`",
    BoolType -> "`boolean`",
    TextType -> "`text`",
    BytesType -> "`bytea`",
    FloatType -> "`double precision`",
    NumericType -> "`numeric`",
    JsonType -> "`jsonb`",
    ArrayType(inner) -> "an array of " ++ value_type_text(inner),
    NullType -> "`null`",
    UnknownType -> "of a type the check cannot tell",
  }

/// What a field of this kind contains, as a phrase for a message.
pub fn field_text(kind: FieldKind) -> String =
  match kind {
    TextField -> "`String`",
    IntField -> "`Int`",
    BoolField -> "`Bool`",
    FloatField -> "`Float`",
    NumericField -> "`Decimal`",
    BytesField -> "`Bytes`",
    JsonField -> "a JSON document",
    ArrayField(inner) -> "a `List` of " ++ field_text(inner),
    OptionalField(inner) -> "an `Option` of " ++ field_text(inner),
  }

fn check_parameter_types(
  dialect: Dialect,
  given: List<Option<String>>,
  placed: List<PlaceholderType>,
) -> List<Finding> =
  placed.fold([], |accumulator: List<Finding>, p: PlaceholderType|
    match given.at(p.n - 1) {
      Some(Some(constructor)) -> if parameter_fits(constructor, p.ty) { accumulator } else {
        accumulator.push({
          kind: ValueMismatch,
          at: p.at,
          message: "`" ++ placeholder_mark(dialect) ++ p.n.to_string() ++ "` stands for " ++ p.what
            ++ ", which is "
            ++ value_type_text(p.ty)
            ++ ", and the call passes a `"
            ++ constructor
            ++ "`",
        })
      },
      _ -> accumulator,
    })

fn parameter_fits(constructor: String, ty: ValueType) -> Bool =
  constructor == "PNull"
    || (match ty {
      UnknownType -> true,
      NullType -> true,
      TextType -> constructor == "PText",
      IntType -> constructor == "PInt",
      BoolType -> constructor == "PBool",
      BytesType -> constructor == "PBytes",
      FloatType -> constructor == "PFloat" || constructor == "PInt" || constructor == "PNumeric",
      NumericType -> constructor == "PNumeric" || constructor == "PInt" || constructor == "PFloat",
      JsonType -> constructor == "PJson",
      ArrayType(_) -> constructor == "PArray",
    })

/// Why a row could not be read as a value: the column, what the field expected, and what the row
/// contained.
pub type RowError = { column: String, expected: String, found: String }

/// Describes how one record field maps to a database column: `read` converts a column value to the
/// field's value, `write` converts the field's value to a statement parameter, and `kind` is the
/// field's column type.
pub type FieldCodec<a> = {
  kind: FieldKind,
  read: (Datum) -> Option<a> / {abort.raise},
  write: (a) -> Param / {abort.raise},
}

/// Describes how a record type `a` maps to database rows: its columns, how to decode a row into a
/// record, and how to turn a record into statement parameters in column order. `derive sql for T`
/// generates a function `t_row()` that returns this value. The statement checker takes the columns
/// from `T`'s definition, and compares them with the columns of each statement that `std.db`'s
/// `fetch` decodes with this codec.
pub type RowCodec<a> = {
  fields: List<Field>,
  decode: (Row) -> Result<a, RowError> / {abort.raise},
  params: (a) -> List<Param> / {abort.raise},
}

/// Why a result could not be read as values: the database rejected the statement, it returned a
/// count, or a row could not be read.
pub type FetchError = | Rejected(DbError) | UnexpectedCount(Int) | InvalidRow(RowError)

/// Each row of `result`, read by `codec`.
pub fn decode_rows<a>(
  result: QueryResult,
  codec: RowCodec<a>,
) -> Result<List<a>, FetchError> / {abort.raise} =
  match result {
    Failed(e) -> Err(Rejected(e)),
    Count(n) -> Err(UnexpectedCount(n)),
    Rows(rows) ->
      rows.fold(Ok([]), |accumulator: Result<List<a>, FetchError>, r: Row|
        match accumulator {
          Err(_) -> accumulator,
          Ok(xs) -> match (codec.decode)(r) {
            Ok(x) -> Ok(xs.push(x)),
            Err(e) -> Err(InvalidRow(e)),
          },
        }),
  }

/// The field `name` and what `r` reads it as.
pub fn field<a>(name: String, r: FieldCodec<a>) -> Field = { name: name, kind: r.kind }

/// The column `name` of `row`, read by `r`.
pub fn read<a>(row: Row, name: String, r: FieldCodec<a>) -> Result<a, RowError> / {abort.raise} =
  match row.get(name) {
    None -> Err({ column: name, expected: field_text(r.kind), found: "no such column" }),
    Some(d) -> match (r.read)(d) {
      Some(x) -> Ok(x),
      None -> Err({ column: name, expected: field_text(r.kind), found: datum_type(d) }),
    },
  }

/// `x` as the parameter `r` writes it as.
pub fn to_parameter<a>(r: FieldCodec<a>, x: a) -> Param / {abort.raise} = (r.write)(x)

/// A `text` column as a `String`.
pub fn text_field() -> FieldCodec<String> =
  {
    kind: TextField,
    read: |d: Datum| match d { TextDatum(s) -> Some(s), _ -> None },
    write: |s: String| TextParameter(s),
  }

/// A `bigint` column as an `Int`.
pub fn int_field() -> FieldCodec<Int> =
  {
    kind: IntField,
    read: |d: Datum| match d { IntDatum(n) -> Some(n), _ -> None },
    write: |n: Int| IntParameter(n),
  }

/// A `boolean` column as a `Bool`.
pub fn bool_field() -> FieldCodec<Bool> =
  {
    kind: BoolField,
    read: |d: Datum| match d { BoolDatum(b) -> Some(b), _ -> None },
    write: |b: Bool| BoolParameter(b),
  }

/// A `double precision` column as a `Float`.
pub fn float_field() -> FieldCodec<Float> =
  {
    kind: FloatField,
    read: |d: Datum| match d { FloatDatum(x) -> Some(x), _ -> None },
    write: |x: Float| FloatParameter(x),
  }

/// A `numeric` column as a `Decimal`.
pub fn numeric_field() -> FieldCodec<Decimal> =
  {
    kind: NumericField,
    read: |d: Datum| match d { NumericDatum(x) -> Some(x), _ -> None },
    write: |x: Decimal| NumericParameter(x),
  }

/// A `bytea` column as `Bytes`.
pub fn bytes_field() -> FieldCodec<Bytes> =
  {
    kind: BytesField,
    read: |d: Datum| match d { BytesDatum(b) -> Some(b), _ -> None },
    write: |b: Bytes| BytesParameter(b),
  }

/// A `jsonb` column as the document it contains.
pub fn document_field() -> FieldCodec<json::Json> =
  {
    kind: JsonField,
    read: |d: Datum| match d { JsonDatum(j) -> Some(j), _ -> None },
    write: |j: json::Json| JsonParameter(j),
  }

/// A `jsonb` column read and written through a type's own JSON codec, so the program stores and
/// sends the same text.
pub fn json_field<a>(c: json::JsonCodec<a>) -> FieldCodec<a> =
  {
    kind: JsonField,
    read: |d: Datum|
      match d {
        JsonDatum(j) -> match (c.decode)(j) { Ok(x) -> Some(x), Err(_) -> None },
        _ -> None,
      },
    write: |x: a| JsonParameter((c.encode)(x)),
  }

/// A column that may be null, `None` when it is null.
pub fn optional_field<a>(r: FieldCodec<a>) -> FieldCodec<Option<a>> =
  {
    kind: OptionalField(r.kind),
    read: |d: Datum|
      match d {
        NullDatum -> Some(None),
        _ -> match (r.read)(d) { Some(x) -> Some(Some(x)), None -> None },
      },
    write: |o: Option<a>| match o { None -> NullParameter, Some(x) -> (r.write)(x) },
  }

/// An array column, each element read by `r`.
pub fn array_field<a>(r: FieldCodec<a>) -> FieldCodec<List<a>> =
  {
    kind: ArrayField(r.kind),
    read: |d: Datum|
      match d {
        ArrayDatum(items) ->
          items.fold(Some([]), |accumulator: Option<List<a>>, item: Datum|
            match accumulator {
              None -> None,
              Some(xs) -> match (r.read)(item) { Some(x) -> Some(xs.push(x)), None -> None },
            }),
        _ -> None,
      },
    write: |xs: List<a>| ArrayParameter(xs.map(r.write)),
  }

test "the tokenizer lowercases keywords and unquoted names, and a quoted identifier keeps its original case" {
  assert_eq(
    sql_tokenize_summary(Postgres, "SELECT t.Sku FROM parts AS t"),
    Ok([
      "word:select",
      "word:t",
      "punct:.",
      "word:sku",
      "word:from",
      "word:parts",
      "word:as",
      "word:t",
    ]),
  );
  assert_eq(
    sql_tokenize_summary(Postgres, "select \"MiXeD\" from \"a\"\"b\""),
    Ok(["word:select", "quoted:MiXeD", "word:from", "quoted:a\"b"]),
  )
}

test "a comment is not a token, and a block comment nests" {
  assert_eq(
    sql_tokenize_summary(Postgres, "select 1 -- and the rest\nfrom t"),
    Ok(["word:select", "number:1", "word:from", "word:t"]),
  );
  assert_eq(
    sql_tokenize_summary(Postgres, "select /* a /* b */ c */ 1"),
    Ok(["word:select", "number:1"]),
  )
}

test "a semicolon is its own token, and one inside a literal is text" {
  assert_eq(
    sql_tokenize_summary(Postgres, "select 1; drop table t"),
    Ok(["word:select", "number:1", "semi", "word:drop", "word:table", "word:t"]),
  );
  assert_eq(sql_tokenize_summary(Postgres, "select ';a'"), Ok(["word:select", "text:';a'"]));
  assert_eq(
    sql_tokenize_summary(Postgres, "select $tag$a;b$tag$"),
    Ok(["word:select", "text:$tag$a;b$tag$"]),
  );
  assert_eq(sql_tokenize_summary(Postgres, "select 'it''s'"), Ok(["word:select", "text:'it''s'"]))
}

test "`$1` is a placeholder token, not the start of a `$tag$` quoted string, and `e'..'`, `b'..'` and `x'..'` literals are text tokens" {
  assert_eq(
    sql_tokenize_summary(Postgres, "select $1, $23"),
    Ok(["word:select", "placeholder:$1", "punct:,", "placeholder:$23"]),
  );
  assert_eq(sql_tokenize_summary(Postgres, "select e'a b'"), Ok(["word:select", "text:e'a b'"]));
  assert_eq(
    sql_tokenize_summary(Postgres, "select b'0110', x'ff'"),
    Ok(["word:select", "text:b'0110'", "punct:,", "text:x'ff'"]),
  )
}

test "a number is one token however it is written" {
  assert_eq(
    sql_tokenize_summary(Postgres, "select 1, 1.5, 1e3, 0x1f, 12ab"),
    Ok([
      "word:select",
      "number:1",
      "punct:,",
      "number:1.5",
      "punct:,",
      "number:1e3",
      "punct:,",
      "number:0x1f",
      "punct:,",
      "number:12ab",
    ]),
  )
}

test "punctuation is one byte each, and a non-ascii name is one word" {
  assert_eq(
    sql_tokenize_summary(Postgres, "a.b::int[] @ 1 <> 2"),
    Ok([
      "word:a",
      "punct:.",
      "word:b",
      "punct::",
      "punct::",
      "word:int",
      "punct:[",
      "punct:]",
      "punct:@",
      "number:1",
      "punct:<",
      "punct:>",
      "number:2",
    ]),
  );
  assert_eq(
    sql_tokenize_summary(Postgres, "select ünïcode"),
    Ok(["word:select", "word:ünïcode"]),
  )
}

test "a quote that is never closed is rejected, not guessed at" {
  assert(is_error(sql_tokenize_summary(Postgres, "select '")));
  assert(is_error(sql_tokenize_summary(Postgres, "select \"x")));
  assert(is_error(sql_tokenize_summary(Postgres, "select /* never")));
  assert(is_error(sql_tokenize_summary(Postgres, "select $tag$ never")));
  assert(is_error(sql_tokenize_summary(Postgres, "select $ ")))
}

fn is_error<a>(r: Result<List<a>, DbError>) -> Bool = match r { Err(_) -> true, Ok(_) -> false }

test "SQLite tokenizing differs from Postgres: block comments do not nest, `$tag$` strings are not recognized, and backticks, brackets and double quotes quote names" {
  assert_eq(
    sql_tokenize_summary(Sqlite, "select /* a /* b */ random() -- c\n"),
    Ok(["word:select", "word:random", "punct:(", "punct:)"]),
  );
  assert_eq(
    sql_tokenize_summary(Sqlite, "select `a``b`, [c d], \"e\" from t where x = ?1 or y = ?"),
    Ok([
      "word:select",
      "quoted:a``b",
      "punct:,",
      "quoted:c d",
      "punct:,",
      "quoted:e",
      "word:from",
      "word:t",
      "word:where",
      "word:x",
      "punct:=",
      "placeholder:?1",
      "word:or",
      "word:y",
      "punct:=",
      "placeholder:?",
    ]),
  );
  assert_eq(
    sql_tokenize_summary(Sqlite, "select 'it''s', x'ff', e'a\\'"),
    Ok(["word:select", "text:'it''s'", "punct:,", "text:x'ff'", "punct:,", "word:e", "text:'a\\'"]),
  );
  assert(is_error(sql_tokenize_summary(Sqlite, "select $1")));
  assert(is_error(sql_tokenize_summary(Sqlite, "select :name")));
  assert(is_error(sql_tokenize_summary(Sqlite, "select @name")));
  assert(is_error(sql_tokenize_summary(Sqlite, "select [never")));
  assert(is_error(sql_tokenize_summary(Sqlite, "select `never")))
}

type KindCase = { sql: String, kind: StatementKind }

const sqlite_kind_cases: List<KindCase> =
  [
    { sql: "select 1", kind: Select },
    { sql: "values (1), (2)", kind: Values },
    { sql: "insert or ignore into t (a) values (?1)", kind: Insert },
    { sql: "replace into t (a) values (?1)", kind: Insert },
    { sql: "insert into t (a) values (1) on conflict (a) do update set a = 2", kind: Insert },
    { sql: "update t set a = a + 1 returning a", kind: Update },
    { sql: "delete from t where a in (select a from u)", kind: Delete },
    { sql: "with n(i) as (select 1) select i from n", kind: Select },
    { sql: "with n(i) as (select 1) insert into t select i from n", kind: Insert },
    { sql: "with n as (select 1 as i) delete from t where a in (select i from n)", kind: Delete },
    { sql: "create table t (a integer primary key, at text) strict", kind: SchemaChange },
    {
      sql: "create trigger tr after insert on t begin update t set a = 1; delete from u; end",
      kind: SchemaChange,
    },
    { sql: "drop index t_a", kind: SchemaChange },
    { sql: "alter table t rename column a to b", kind: SchemaChange },
    { sql: "analyze", kind: SchemaChange },
    { sql: "pragma user_version = 3", kind: Pragma },
    { sql: "select datetime(at, '+1 day'), strftime('%Y', at) from t", kind: Select },
    { sql: "select \"random\", [current_date] from \"time\"", kind: Select },
    { sql: "insert into time (at) values (?1)", kind: Insert },
  ]

test "`scan_statement` returns the expected statement kind for the SQLite statement {c.sql}" for c: KindCase in sqlite_kind_cases {
  assert_eq(scan_statement(Sqlite, c.sql).map(|s: SqlScan| s.kind), Ok(c.kind))
}

type ErrorCase = { sql: String, at: Int }

const sqlite_rejection_cases: List<ErrorCase> =
  [
    { sql: "", at: 0 },
    { sql: "attach database '/etc/passwd' as other", at: 0 },
    { sql: "detach database other", at: 0 },
    { sql: "vacuum into '/tmp/copy.db'", at: 0 },
    { sql: "begin immediate", at: 0 },
    { sql: "commit", at: 0 },
    { sql: "savepoint s", at: 0 },
    { sql: "explain select 1", at: 0 },
    { sql: "create temp table t (a)", at: 7 },
    { sql: "create virtual table f using fts5(a)", at: 7 },
    { sql: "with n as (select 1)", at: 0 },
    { sql: "select random()", at: 7 },
    { sql: "select randomblob(8)", at: 7 },
    { sql: "insert into t values (CURRENT_TIMESTAMP)", at: 22 },
    { sql: "select current_date", at: 7 },
    { sql: "select datetime('now')", at: 16 },
    { sql: "select datetime()", at: 7 },
    { sql: "select strftime('%s', 'NOW')", at: 22 },
    { sql: "select date(at, 'localtime') from t", at: 16 },
    { sql: "select time('12:00', 'utc')", at: 21 },
    { sql: "select 1 where a = $1", at: 19 },
  ]

test "`scan_statement` rejects the SQLite statement {c.sql} and reports the byte offset where it fails" for c: ErrorCase in sqlite_rejection_cases {
  assert_eq(scan_statement(Sqlite, c.sql).map_err(|e: DbError| rejection_byte(e)), Err(Some(c.at)))
}

test "`rejection_byte` returns the number after the last `at byte` in an error message, even when the quoted statement also contains `at byte`, and returns `None` when the message has none" {
  assert_eq(
    rejection_byte(db_error("0A000", "", "`' at byte 9'` at byte 31. the statement ends here")),
    Some(31),
  );
  assert_eq(rejection_byte(db_error("23505", "items_pkey", "a duplicate key")), None)
}

fn scan_ok(sql: String) -> SqlScan / {abort.raise} =
  match scan_statement(Postgres, sql) { Err(e) -> panic(e.detail), Ok(s) -> s }

fn scan_names(sql: String) -> List<String> / {abort.raise} = scan_table_names(scan_ok(sql).tables)

fn scan_rejects(sql: String) -> Bool / {abort.raise} =
  match scan_statement(Postgres, sql) { Err(_) -> true, Ok(_) -> false }

fn scan_rejects_at(sql: String, byte: Int) -> Bool / {abort.raise} =
  match scan_statement(Postgres, sql) {
    Err(e) -> e.detail.contains("byte " ++ byte.to_string()),
    Ok(_) -> false,
  }

test "a select names the table it reads" {
  assert_eq(scan_names("select sku from items"), ["items"]);
  assert_eq(scan_ok("select sku from items").kind, Select);
  assert_eq(scan_ok("select sku from items").tables.written, [])
}

test "a join names both tables" {
  assert_eq(scan_names("select o.id, i.sku from orders o join items i on i.sku = o.sku"), [
    "items",
    "orders",
  ]);
  assert_eq(scan_names("select * from orders, items where orders.sku = items.sku"), [
    "items",
    "orders",
  ]);
  assert_eq(
    scan_names("select * from a left outer join b on a.x = b.x full join c on c.y = a.y"),
    ["a", "b", "c"],
  );
  assert_eq(scan_names("select * from a natural join b"), ["a", "b"]);
  assert_eq(scan_names("select * from a join b using (x)"), ["a", "b"])
}

test "a set operation (`union`, `intersect`, `except`) reports the tables of every select in it" {
  assert_eq(scan_names("select sku from items union all select sku from orders"), [
    "items",
    "orders",
  ]);
  assert_eq(scan_names("select a from x intersect select a from y except select a from z"), [
    "x",
    "y",
    "z",
  ]);
  assert_eq(scan_names("(select a from x) union (select a from y)"), ["x", "y"])
}

test "the tables used inside subqueries are included in the tables a statement reads" {
  assert_eq(scan_names("select sku from items where sku in (select sku from orders)"), [
    "items",
    "orders",
  ]);
  assert_eq(scan_names("select (select count(*) from orders) from items"), ["items", "orders"]);
  assert_eq(scan_names("select * from (select sku from orders) o"), ["orders"]);
  assert_eq(
    scan_names(
      "select * from items where exists (select 1 from orders where orders.sku = items.sku)",
    ),
    ["items", "orders"],
  )
}

test "a common table expression resolves to its own sources" {
  assert_eq(scan_names("with recent as (select * from orders) select * from recent"), ["orders"]);
  assert_eq(
    scan_names(
      "with a as (select * from x), b as (select * from a join y on true) select * from b",
    ),
    ["x", "y"],
  );
  assert_eq(
    scan_names("with recursive t(n) as (select 1 union all select n+1 from t) select n from t"),
    [],
  )
}

test "a data-modifying common table expression reports its write" {
  let s = scan_ok("with gone as (delete from stale returning id) select id from gone");
  assert_eq(s.kind, Select);
  assert_eq(s.tables.written, ["stale"]);
  assert(scan_writes(s))
}

test "an insert writes its target and reads its source" {
  let one = scan_ok("insert into items (sku, name) values ($1, $2)");
  assert_eq(one.kind, Insert);
  assert_eq(one.tables.written, ["items"]);
  assert_eq(one.tables.read, []);
  let two = scan_ok("insert into archive select * from items where on_hand = 0");
  assert_eq(two.tables.written, ["archive"]);
  assert_eq(two.tables.read, ["items"]);
  assert_eq(scan_names("insert into items default values"), ["items"]);
  assert_eq(scan_names("insert into items (sku) values ($1) returning sku"), ["items"])
}

test "an update writes its target and reads its from list" {
  let s = scan_ok(
    "update items set on_hand = on_hand - l.qty from lines l where l.sku = items.sku",
  );
  assert_eq(s.kind, Update);
  assert_eq(s.tables.written, ["items"]);
  assert_eq(s.tables.read, ["lines"])
}

test "a delete writes its target and reads its using list" {
  let s = scan_ok(
    "delete from orders using items where items.sku = orders.sku returning orders.id",
  );
  assert_eq(s.kind, Delete);
  assert_eq(s.tables.written, ["orders"]);
  assert_eq(s.tables.read, ["items"])
}

test "a table read and written by one statement is a write" {
  let s = scan_ok("update items set n = n + 1 where sku in (select sku from items where n < 3)");
  assert_eq(s.tables.written, ["items"]);
  assert_eq(s.tables.read, [])
}

test "a schema-qualified name is its last segment" {
  assert_eq(scan_names("select * from public.items"), ["items"]);
  assert_eq(scan_names("insert into public.items values ($1)"), ["items"])
}

test "unquoted table names are lowercased as Postgres does, and quoted names keep their case" {
  assert_eq(scan_names("SELECT * FROM Items"), ["items"]);
  assert_eq(scan_names("select * from \"Items\""), ["Items"]);
  assert_eq(scan_names("select * from \"has space\""), ["has space"])
}

test "a second statement after a semicolon is rejected, and the error gives its position" {
  assert(scan_rejects_at("select 1 from items; drop table items", 19));
  assert(scan_rejects("insert into items values (1); delete from items"))
}

test "a semicolon inside a string literal or quoted name does not end the statement" {
  assert_eq(scan_names("select * from items where sku = '; drop table items; --'"), ["items"]);
  assert_eq(scan_names("select * from items where sku = $tag$; drop table items$tag$"), ["items"]);
  assert_eq(scan_names("select * from items where sku = $$;$$"), ["items"]);
  assert_eq(scan_names("select * from items where sku = e'\\'; drop table items; --'"), ["items"]);
  assert_eq(scan_names("select * from items where name = 'it''s; fine'"), ["items"]);
  assert_eq(scan_names("select * from \"weird;name\""), ["weird;name"])
}

test "comments are ignored when scanning a statement, and an unclosed comment is rejected" {
  assert_eq(scan_names("select 1 from items -- ; drop table items"), ["items"]);
  assert_eq(scan_names("select 1 /* ; drop table items */ from items"), ["items"]);
  assert_eq(scan_names("select 1 /* outer /* inner ; */ still comment */ from items"), ["items"]);
  assert(scan_rejects("select 1 /* never closed from items"))
}

test "an unterminated literal is rejected rather than guessed at" {
  assert(scan_rejects_at("select * from items where sku = 'open", 32));
  assert(scan_rejects_at("select * from \"open", 14));
  assert(scan_rejects_at("select * from items where sku = $tag$open", 32))
}

test "statements other than select, insert, update, delete, values and with are rejected, as is empty text" {
  assert(scan_rejects("create table t (a int)"));
  assert(scan_rejects("alter table t add column b int"));
  assert(scan_rejects("drop table t"));
  assert(scan_rejects("truncate t"));
  assert(scan_rejects("copy t from stdin"));
  assert(scan_rejects("do $$ begin end $$"));
  assert(scan_rejects("call p()"));
  assert(scan_rejects("lock table t"));
  assert(scan_rejects("listen chan"));
  assert(scan_rejects("notify chan"));
  assert(scan_rejects("set statement_timeout = 0"));
  assert(scan_rejects("show all"));
  assert(scan_rejects("grant select on t to r"));
  assert(scan_rejects("explain select * from t"));
  assert(scan_rejects("begin"));
  assert(scan_rejects("commit"));
  assert(scan_rejects("vacuum"));
  assert(scan_rejects("table items"));
  assert(scan_rejects(""));
  assert(scan_rejects("   "))
}

test "constructs whose table reads or writes the scanner cannot report, such as row locks and upserts, are rejected" {
  assert(scan_rejects("select * from generate_series(1, 10)"));
  assert(scan_rejects("select * from items for update"));
  assert(scan_rejects("select * from items limit 1 for share"));
  assert(scan_rejects("insert into items values ($1) on conflict do nothing"));
  assert(scan_rejects("select rank() over w from items window w as (order by sku)"));
  assert(scan_rejects("select * from (items join orders on true)"))
}

test "a column alias in the select list is not read as a table name" {
  assert_eq(scan_names("select id as ident from items"), ["items"]);
  assert_eq(scan_names("select count(*) as n from items"), ["items"]);
  assert_eq(scan_names("select id ident from items"), ["items"]);
  assert_eq(
    scan_names("select a.id as a_id, b.id as b_id from items as a join orders as b on a.id = b.id"),
    ["items", "orders"],
  );
  assert_eq(scan_names("select (select max(n) from orders) as top, sku from items"), [
    "items",
    "orders",
  ]);
  assert_eq(scan_names("select n as v from items where n > $1 order by n limit 3"), ["items"])
}

test "a function the parser does not allow is rejected" {
  assert(scan_rejects("select set_config('search_path', 'pg_catalog', false) from items"));
  assert(scan_rejects("select pg_advisory_lock(918) from items"));
  assert(scan_rejects("select pg_read_file('/etc/hosts') from items"));
  assert(scan_rejects("select pg_sleep(0) from items"));
  assert(scan_rejects("select id from items where pg_backend_pid() > 0"));
  assert(scan_rejects("insert into items (id) values (pg_backend_pid())"));
  assert(scan_rejects("update items set n = pg_backend_pid()"));
  assert(scan_rejects("delete from items where id = pg_backend_pid()"));
  assert_eq(scan_names("select count(*) from items"), ["items"]);
  assert_eq(scan_names("select sum(n) from items"), ["items"]);
  assert_eq(scan_names("select coalesce(n, 0) from items"), ["items"]);
  assert_eq(scan_names("select lower(sku), length(sku) from items"), ["items"]);
  assert_eq(scan_names("select id from items where id = any($1)"), ["items"]);
  assert_eq(scan_names("select id from items where sku in (select sku from orders)"), [
    "items",
    "orders",
  ]);
  assert_eq(scan_names("select cast(n as text) from items"), ["items"]);
  assert_eq(scan_names("select id from items where not (n > $1)"), ["items"]);
  assert_eq(scan_names("select case when n > $1 then upper(sku) else sku end from items"), [
    "items",
  ]);
  assert_eq(scan_names("select \"pg_sleep\" from items"), ["items"])
}

test "a nondeterministic function in statement text is rejected" {
  assert(scan_rejects("insert into items (at) values (now())"));
  assert(scan_rejects("select * from items where at < current_timestamp"));
  assert(scan_rejects("select random() from items"));
  assert(scan_rejects("update items set at = clock_timestamp()"));
  assert(scan_rejects("select * from items where d = current_date"));
  assert_eq(scan_names("select \"now\" from items"), ["items"])
}

test "nesting is bounded rather than a stack overflow" { assert(scan_rejects(nested_selects(64))) }

fn nested_selects(n: Int) -> String = nested_from("select * from items", n)

fn nested_from(sql: String, n: Int) -> String =
  if n <= 0 { sql } else { nested_from("select * from (" ++ sql ++ ") t", n - 1) }

test "malformed SQL makes `scan_statement` return normally and never panic" {
  let _ = scan_statement(Postgres, "select");
  let _ = scan_statement(Postgres, "select * from");
  let _ = scan_statement(Postgres, "select * from (");
  let _ = scan_statement(Postgres, "insert into");
  let _ = scan_statement(Postgres, "update");
  let _ = scan_statement(Postgres, "update t");
  let _ = scan_statement(Postgres, "update t set");
  let _ = scan_statement(Postgres, "delete");
  let _ = scan_statement(Postgres, "delete from");
  let _ = scan_statement(Postgres, "with");
  let _ = scan_statement(Postgres, "with a");
  let _ = scan_statement(Postgres, "with a as");
  let _ = scan_statement(Postgres, "with a as (");
  let _ = scan_statement(Postgres, "select * from a join");
  let _ = scan_statement(Postgres, "select * from a join b on");
  let _ = scan_statement(Postgres, "((((");
  let _ = scan_statement(Postgres, "))))");
  let _ = scan_statement(Postgres, "$");
  let _ = scan_statement(Postgres, "$$");
  let _ = scan_statement(Postgres, "'");
  let _ = scan_statement(Postgres, "\"");
  let _ = scan_statement(Postgres, "select * from items order by");
  let _ = scan_statement(Postgres, "select * from items group by");
  let _ = scan_statement(Postgres, "select ,,, from items");
  let _ = scan_statement(Postgres, "select * from items where (");
  let _ = scan_statement(Postgres, "натурально");
  let _ = scan_statement(Postgres, "select * from ünïcode");
  assert(scan_rejects("with a as ("))
}

test "a statement with an injected second statement is rejected, and an injected `union select` lists its second table" {
  assert(scan_rejects("select * from items where sku = '' ; drop table items --'"));
  assert_eq(scan_names("select * from items where sku = '' union select * from pg_shadow --'"), [
    "items",
    "pg_shadow",
  ]);
  assert_eq(scan_names("select * from items where sku = '' or 1=1"), ["items"])
}

test "a `$1` placeholder is scanned as a parameter and is never replaced by text" {
  assert_eq(scan_names("select * from items where sku = $1 and n > $22"), ["items"]);
  assert_eq(scan_names("insert into items values ($1, $2, $3) returning sku"), ["items"])
}

test "the scan reports whether a statement writes, so a read-only call that runs a write statement can be rejected" {
  assert(!kind_writes(scan_ok("select * from items").kind));
  assert(!kind_writes(scan_ok("values (1), (2)").kind));
  assert(kind_writes(scan_ok("insert into items values ($1)").kind));
  assert(kind_writes(scan_ok("update items set a = 1").kind));
  assert(kind_writes(scan_ok("delete from items").kind));
  assert(scan_writes(scan_ok("with gone as (delete from items returning id) select * from gone")))
}

const test_schema: Schema =
  {
    tables: [
      {
        name: "items",
        columns: [
          column("sku", TText, false),
          column("name", TText, false),
          column("price", TNumeric(12, 2), false),
          column("on_hand", IntColumn, false),
          column("note", TText, true),
        ],
        primary_key: ["sku"],
        unique: [],
        foreign_keys: [],
        checks: [],
      },
      {
        name: "orders",
        columns: [
          column_default("id", IntColumn, false, SequenceDefault("orders_id_seq")),
          column("sku", TText, false),
          column("qty", IntColumn, false),
          column("state", JsonColumn, false),
        ],
        primary_key: ["id"],
        unique: [],
        foreign_keys: [],
        checks: [],
      },
    ],
  }

fn test_site(operation: Operation, label: String) -> CallSite =
  {
    dialect: Postgres,
    operation: operation,
    label: Some(label),
    parameter_constructors: None,
    row: None,
  }

fn test_findings(
  site: CallSite,
  sql: String,
) -> List<{ kind: FindingKind, at: Int }> / {abort.raise} =
  check_statement(Some(test_schema), site, sql).map(|f: Finding| { kind: f.kind, at: f.at })

fn test_parameter_findings(
  given: List<Option<String>>,
  sql: String,
) -> List<{ kind: FindingKind, at: Int }> / {abort.raise} =
  test_findings({ ..test_site(Reads, "items"), parameter_constructors: Some(given) }, sql)

fn test_row_findings(row: List<Field>, sql: String) -> List<FindingKind> / {abort.raise} =
  check_statement(Some(test_schema), { ..test_site(Reads, "items"), row: Some(row) }, sql).map(
    |f: Finding| f.kind,
  )

test "the check reports an error at the position of a table or column the schema does not declare" {
  let reads = test_site(Reads, "items");
  assert_eq(
    test_findings(reads, "select sku, name, price from items where on_hand > $1 order by sku"),
    [],
  );
  assert_eq(test_findings(reads, "select sku, nmae from items"), [{ kind: Undeclared, at: 12 }]);
  assert_eq(
    check_statement(Some(test_schema), reads, "select sku, nmae from items").map(|f: Finding|
      f.message),
    ["names the column `nmae`, which `items` does not have"],
  );
  assert_eq(test_findings(test_site(Reads, "itemz"), "select sku from itemz"), [
    { kind: Undeclared, at: 16 },
  ]);
  assert_eq(test_findings(reads, "select i.sku, i.prise from items i"), [
    { kind: Undeclared, at: 16 },
  ]);
  assert_eq(
    test_findings(test_site(Writes, "items"), "update items set on_hnd = $1 where sku = $2"),
    [{ kind: Undeclared, at: 17 }],
  );
  assert_eq(
    test_findings(test_site(Writes, "items"), "insert into items (sku, nam) values ($1, $2)"),
    [{ kind: Undeclared, at: 24 }],
  )
}

test "a column in two tables must be qualified with its table name, and left-joined columns must be optional" {
  assert_eq(
    check_statement(
      Some(test_schema),
      test_site(Reads, "items"),
      "select sku from items join orders on orders.sku = items.sku",
    ).map(|f: Finding| f.message),
    ["names the column `sku`, which `items` and `orders` both have: name it with its table"],
  );
  let joined = "select items.sku, orders.qty from items left join orders on orders.sku = items.sku";
  assert_eq(test_row_findings([field("sku", text_field()), field("qty", int_field())], joined), [
    RowMismatch,
  ]);
  assert_eq(
    test_row_findings(
      [field("sku", text_field()), field("qty", optional_field(int_field()))],
      joined,
    ),
    [],
  )
}

test "the check fails when the call's table is not in the statement or its operation differs from the statement's" {
  assert_eq(test_findings(test_site(Reads, "orders"), "select sku from items"), [
    { kind: LabelMismatch, at: 0 },
  ]);
  assert_eq(test_findings(test_site(Reads, "items"), "update items set on_hand = 1"), [
    { kind: OperationMismatch, at: 0 },
  ]);
  assert_eq(test_findings(test_site(Writes, "items"), "select sku from items"), [
    { kind: OperationMismatch, at: 0 },
  ]);
  assert_eq(
    test_findings(test_site(Writes, "items"), "update items set on_hand = 1 returning sku"),
    [{ kind: OperationMismatch, at: 0 }],
  );
  assert_eq(test_findings(test_site(WritesRows, "items"), "update items set on_hand = 1"), [
    { kind: OperationMismatch, at: 0 },
  ]);
  assert_eq(
    test_findings(test_site(WritesRows, "items"), "update items set on_hand = 1 returning sku"),
    [],
  )
}

test "the check reports `*` selections and unsupported constructs at their position in the statement" {
  let reads = test_site(Reads, "items");
  assert_eq(test_findings(reads, "select * from items"), [{ kind: SelectStar, at: 7 }]);
  assert_eq(test_findings(reads, "select i.* from items i"), [{ kind: SelectStar, at: 7 }]);
  assert_eq(test_findings(reads, "with n as (select sku from items) select sku from n"), [
    { kind: Unsupported, at: 0 },
  ]);
  assert_eq(test_findings(reads, "select sku from items union select sku from orders"), [
    { kind: Unsupported, at: 22 },
  ]);
  assert_eq(test_findings(reads, "select sku from (select sku from items) s"), [
    { kind: Unsupported, at: 16 },
  ])
}

test "a placeholder takes the type of what it is compared with or stored in" {
  let compared = "select sku from items where sku = $1";
  assert_eq(test_parameter_findings([Some("PText")], compared), []);
  assert_eq(test_parameter_findings([None], compared), []);
  assert_eq(test_parameter_findings([Some("PInt")], compared), [{ kind: ValueMismatch, at: 34 }]);
  assert_eq(
    check_statement(
      Some(test_schema),
      { ..test_site(Reads, "items"), parameter_constructors: Some([Some("PInt")]) },
      compared,
    ).map(|f: Finding| f.message),
    ["`$1` stands for `sku`, which is `text`, and the call passes a `PInt`"],
  );
  assert_eq(
    test_findings(
      {
        ..test_site(Writes, "items"),
        parameter_constructors: Some([Some("PText"), Some("PText")]),
      },
      "insert into items (sku, on_hand) values ($1, $2)",
    ),
    [{ kind: ValueMismatch, at: 45 }],
  );
  assert_eq(
    test_findings(
      { ..test_site(Writes, "items"), parameter_constructors: Some([Some("PInt"), Some("PText")]) },
      "update items set on_hand = on_hand - $1 where sku = $2",
    ),
    [],
  );
  assert_eq(test_parameter_findings([Some("PText")], "select sku from items limit $1"), [
    { kind: ValueMismatch, at: 28 },
  ])
}

test "a call passes as many parameters as the statement has placeholders" {
  let compared = "select sku from items where sku = $1";
  assert_eq(test_parameter_findings([], compared), [{ kind: ValueMismatch, at: 0 }]);
  assert_eq(test_parameter_findings([Some("PText"), Some("PText")], compared), [
    { kind: ValueMismatch, at: 0 },
  ]);
  assert_eq(
    check_statement(
      None,
      { ..test_site(Reads, "items"), parameter_constructors: Some([]) },
      compared,
    ).map(|f: Finding| f.message),
    ["the statement's placeholders run to `$1`, and the call passes no parameter"],
  )
}

test "the check fails when a row type's fields differ from the statement's columns in name, type or nullability" {
  let priced = "select sku, price from items";
  assert_eq(
    test_row_findings([field("sku", text_field()), field("price", numeric_field())], priced),
    [],
  );
  assert_eq(
    test_row_findings([field("sku", text_field()), field("price", int_field())], priced),
    [RowMismatch],
  );
  assert_eq(test_row_findings([field("sku", text_field())], priced), [RowMismatch]);
  assert_eq(
    test_row_findings(
      [field("sku", text_field()), field("price", numeric_field()), field("name", text_field())],
      priced,
    ),
    [RowMismatch],
  );
  assert_eq(test_row_findings([field("note", text_field())], "select note from items"), [
    RowMismatch,
  ]);
  assert_eq(
    test_row_findings([field("note", optional_field(text_field()))], "select note from items"),
    [],
  );
  assert_eq(test_row_findings([field("count", int_field())], "select count(*) from items"), []);
  assert_eq(
    test_row_findings(
      [field("total", optional_field(numeric_field()))],
      "select sum(on_hand) as total from items",
    ),
    [],
  )
}

test "without a schema, the check compares a statement only with the call's table and operation" {
  assert_eq(check_statement(None, test_site(Reads, "items"), "select nmae from items"), []);
  assert_eq(
    check_statement(None, test_site(Reads, "items"), "delete from items").map(|f: Finding| f.kind),
    [OperationMismatch],
  )
}

test "for SQL the parser rejects, the check reports a single unreadable-statement error" {
  assert_eq(test_findings(test_site(Reads, "items"), "select sku from items; drop table items"), [
    { kind: Unreadable, at: 21 },
  ])
}

test "a SQLite statement is checked in its own dialect, its columns named as SQLite names them" {
  let site = {
    dialect: Sqlite,
    operation: Reads,
    label: Some("app"),
    parameter_constructors: Some([Some("PText"), Some("PInt")]),
    row: Some([field("sku", text_field()), field("on_hand + 1", int_field())]),
  };
  let sql = "select sku, on_hand + 1 from items where sku = ? and on_hand > ?";
  assert_eq(test_findings(site, sql), []);
  assert_eq(
    check_statement(
      Some(test_schema),
      { ..site, parameter_constructors: Some([Some("PInt"), Some("PInt")]) },
      sql,
    ).map(|f: Finding| (f.at, f.message)),
    [(47, "`?1` stands for `sku`, which is `text`, and the call passes a `PInt`")],
  )
}

test "the check returns findings and never panics on unsupported or malformed statements" {
  let reads = test_site(Reads, "items");
  let _ = check_statement(Some(test_schema), reads, "select sku from items where (");
  let _ = check_statement(
    Some(test_schema),
    reads,
    "select case when sku = $1 then 1 else 2 end from items",
  );
  let _ = check_statement(
    Some(test_schema),
    reads,
    "select cast(price as numeric(12, 2)) from items",
  );
  let _ = check_statement(
    Some(test_schema),
    reads,
    "select price::text from items where sku in ($1, $2)",
  );
  let _ = check_statement(
    Some(test_schema),
    reads,
    "select sku from items where exists (select 1 from orders)",
  );
  let _ = check_statement(
    Some(test_schema),
    reads,
    "select sku from items where on_hand between $1 and $2",
  );
  assert_eq(test_findings(reads, nested_from("select sku from items", 3)), [
    { kind: Unsupported, at: 14 },
  ])
}

type TestPart = { sku: String, note: Option<String> }

fn test_part_row() -> RowCodec<TestPart> =
  {
    fields: [field("sku", text_field()), field("note", optional_field(text_field()))],
    decode: |r: Row|
      match read(r, "sku", text_field()) {
        Err(e) -> Err(e),
        Ok(sku) -> match read(r, "note", optional_field(text_field())) {
          Err(e) -> Err(e),
          Ok(note) -> Ok({ sku: sku, note: note }),
        },
      },
    params: |p: TestPart|
      [to_parameter(text_field(), p.sku), to_parameter(optional_field(text_field()), p.note)],
  }

test "a row decodes into its fields, and a column of the wrong type returns an error naming the column" {
  let row = Map::new().insert("sku", TextDatum("a")).insert("note", NullDatum);
  assert_eq(decode_rows(Rows([row]), test_part_row()), Ok([{ sku: "a", note: None }]));
  assert_eq(
    decode_rows(Rows([row.insert("sku", IntDatum(1))]), test_part_row()),
    Err(InvalidRow({ column: "sku", expected: "`String`", found: "bigint" })),
  );
  assert_eq(decode_rows(Count(2), test_part_row()), Err(UnexpectedCount(2)));
  assert_eq(test_part_row().params({ sku: "a", note: None }), [TextParameter("a"), NullParameter]);
  assert_eq(array_field(int_field()).read(ArrayDatum([IntDatum(1), IntDatum(2)])), Some([1, 2]));
  assert_eq(array_field(int_field()).read(ArrayDatum([IntDatum(1), TextDatum("2")])), None)
}
