//! Text as Unicode compares it: the four normalization forms, full case mapping and case folding,
//! and case-insensitive matching.
//!
//! One text can be written several ways, such as an accented letter as one character or as a letter
//! followed by a mark. A normalization form picks one way. `nfc` and `nfd` preserve the text's
//! meaning, and canonically equivalent texts have the same NFC and the same NFD: `equivalent`
//! compares by them. `nfkc` and `nfkd` also replace compatibility characters, such as a ligature or
//! a full-width letter, by what they represent, which loses the distinction. Most text is already
//! in the requested form, so each function first scans the text without building anything to check
//! this. The scan takes constant time for ASCII and time proportional to the number of characters
//! for other text. Hangul syllables are composed and decomposed by arithmetic. Nothing limits how
//! many marks may follow one character, so a text is reordered as a whole. `stream_safe` applies
//! the standard's limit of thirty, for code that must reorder text as it arrives.
//!
//! `uppercase`, `lowercase` and `titlecase` are the full case mappings, which the one-character
//! mappings of `std.char` cannot express: `U+00DF` in capitals is two letters, a capital sigma
//! lowers to one of two letters depending on its position, and Turkish, Azeri and Lithuanian map
//! `i` their own way. A language's mappings are requested by name, as a `Tailoring`. Nothing is
//! read from the environment a program runs in. `case_fold` is for comparing, not for display, and
//! `caseless` is the comparison. Folding alone misses texts that differ only in how they write an
//! accent, so `caseless` decomposes, folds, decomposes again and folds again, as the standard
//! defines a canonical caseless match.
//!
//! The tables come from `std.ucd`, for the Unicode version it names. `std.segment` splits a text
//! into what a reader sees as characters, or into words, and `std.width` measures its width in a
//! terminal.

import std.bytes
import std.char
import std.char (sample_text, text_of)
import std.list
import std.string
import std.ucd
import std.ucd (SequencePool, Run, Table, ValueRun)
import std.gen

type NormalizationTable = { words: Table, points: Array<Int>, pairs: Map<Int, Int> }

const nfc_no: Int = 0x100

const nfc_maybe: Int = 0x200

const nfkc_no: Int = 0x400

const nfkc_maybe: Int = 0x800

fn canonical_decomposition_position(word: Int) -> Int = word >> 12 & 0x3FFFFF

fn compatibility_decomposition_position(word: Int) -> Int = word >> 34 & 0x3FFFFF

fn quick_bit(letter: Int) -> Int / {abort.raise} =
  match letter {
    b'C' -> nfc_no,
    b'c' -> nfc_maybe,
    b'K' -> nfkc_no,
    b'k' -> nfkc_maybe,
    _ ->
      panic(
        "a quick check letter must be C (NFC no), c (NFC maybe), K (NFKC no) or k (NFKC maybe)",
      ),
  }

type DecompositionMapping = { compatibility: Bool, to: List<Int> }

type Entry = { first: Int, last: Int, bits: Int, decomposition: Option<DecompositionMapping> }

fn entry(run: Run) -> Entry / {abort.raise} = {
  let field = |i: Int| match run.fields.at(i) { Some(text) -> text, None -> b"" };
  let class = if field(0).len() == 0 { 0 } else {
    match field(0).int_of_ascii() {
      Some(n) -> if n < 0 || n > 254 { panic("a combining class is 0 to 254") } else { n },
      None -> panic("a combining class is 0 to 254"),
    }
  };
  let quick = range(0, field(2).len()).fold(0, |bits: Int, i: Int|
    bits | quick_bit(field(2).at(i)));
  let mapping = field(1);
  {
    first: run.first,
    last: run.last,
    bits: class | quick,
    decomposition: if mapping.len() == 0 { None } else if mapping.starts_with(b"~") {
      Some({ compatibility: true, to: ucd::code_points(mapping.slice(1, mapping.len())) })
    } else { Some({ compatibility: false, to: ucd::code_points(mapping) }) },
  }
}

fn expanded(
  steps: Map<Int, DecompositionMapping>,
  code_point: Int,
  compatibility: Bool,
  depth: Int,
) -> List<Int> =
  if depth <= 0 { [code_point] } else {
    match steps.get(code_point) {
      None -> [code_point],
      Some(step) -> if step.compatibility && !compatibility { [code_point] } else {
        step.to.fold([], |all: List<Int>, next: Int|
          all.concat(expanded(steps, next, compatibility, depth - 1)))
      },
    }
  }

type NormalizationState = { valued: List<ValueRun>, gathering: SequencePool, pairs: Map<Int, Int> }

fn normalization_table_of(runs: List<Run>) -> NormalizationTable / {abort.raise} = {
  let entries = runs.map(entry);
  let steps = entries.fold(Map::new(), |all: Map<Int, DecompositionMapping>, e: Entry|
    match e.decomposition {
      None -> all,
      Some(step) ->
        range(e.first, e.last + 1).fold(
          all,
          |table: Map<Int, DecompositionMapping>, code_point: Int| table.insert(code_point, step),
        ),
    });
  let made = entries.fold(
    { valued: [], gathering: ucd::empty_pool, pairs: Map::new() },
    |m: NormalizationState, e: Entry|
      match e.decomposition {
        None ->
          {
            valued: m.valued.push({ first: e.first, last: e.last, value: e.bits }),
            gathering: m.gathering,
            pairs: m.pairs,
          },
        Some(step) -> {
          let canonical = if step.compatibility { { gathering: m.gathering, place: 0 } }
          else { ucd::intern(m.gathering, expanded(steps, e.first, false, 8)) };
          let compatibility = ucd::intern(canonical.gathering, expanded(steps, e.first, true, 8));
          {
            valued: m.valued.push({
              first: e.first,
              last: e.last,
              value: e.bits | canonical.place << 12 | compatibility.place << 34,
            }),
            gathering: compatibility.gathering,
            pairs: match step.to {
              [a, b] -> if step.compatibility || e.bits & nfc_no != 0 { m.pairs }
              else { m.pairs.insert(a << 21 | b, e.first) },
              _ -> m.pairs,
            },
          }
        },
      },
  );
  {
    words: ucd::table_of(made.valued, 0),
    points: Array::of_list(made.gathering.points),
    pairs: made.pairs,
  }
}

const normalization_table: NormalizationTable =
  normalization_table_of(ucd::runs(embed("ucd/normalization.txt")))

fn is_syllable(code_point: Int) -> Bool = code_point >= 0xAC00 && code_point <= 0xD7A3

fn hangul_syllable(a: Int, b: Int) -> Int =
  if a >= 0x1100 && a <= 0x1112 && b >= 0x1161 && b <= 0x1175 {
    0xAC00 + ((a - 0x1100) * 21 + (b - 0x1161)) * 28
  } else if is_syllable(a) && (a - 0xAC00) % 28 == 0 && b >= 0x11A8 && b <= 0x11C2 {
    a + (b - 0x11A7)
  } else { -1 }

fn letters(code_point: Int) -> List<Int> = {
  let index = code_point - 0xAC00;
  let pair = [0x1100 + index / 588, 0x1161 + index % 588 / 28];
  if index % 28 == 0 { pair } else { pair.push(0x11A7 + index % 28) }
}

type OrderState = { out: List<Int>, marks: List<Int> }

fn flush_marks(so_far: OrderState) -> List<Int> =
  match so_far.marks {
    [] -> so_far.out,
    [one] -> so_far.out.push(one & 0x1FFFFF),
    _ ->
      so_far.marks.sort().fold(so_far.out, |out: List<Int>, mark: Int| out.push(mark & 0x1FFFFF)),
  }

fn add_ordered(so_far: OrderState, code_point: Int, class: Int) -> OrderState =
  if class == 0 { { out: flush_marks(so_far).push(code_point), marks: [] } } else {
    {
      out: so_far.out,
      marks: so_far.marks.push(class << 42 | so_far.marks.len() << 21 | code_point),
    }
  }

fn decompose_into(
  table: NormalizationTable,
  so_far: OrderState,
  code_point: Int,
  compatibility: Bool,
) -> OrderState =
  if is_syllable(code_point) { { out: flush_marks(so_far).concat(letters(code_point)), marks: [] } }
  else {
    let word = ucd::lookup(table.words, code_point);
    let mapping_handle = if compatibility { compatibility_decomposition_position(word) }
    else { canonical_decomposition_position(word) };
    if mapping_handle == 0 { add_ordered(so_far, code_point, word & 255) } else {
      ucd::sequence(table.points, mapping_handle).fold(so_far, |ordering: OrderState, part: Int|
        add_ordered(ordering, part, ucd::lookup(table.words, part) & 255))
    }
  }

fn decomposed(table: NormalizationTable, chars: List<Char>, compatibility: Bool) -> List<Int> =
  flush_marks(
    chars.fold({ out: [], marks: [] }, |so_far: OrderState, c: Char|
      decompose_into(table, so_far, Int::of_char(c), compatibility)),
  )

type ComposeState = { out: List<Int>, starter: Int, marks: List<Int>, last: Int }

fn finish_composition(so_far: ComposeState) -> List<Int> =
  so_far.marks.fold(
    if so_far.starter < 0 { so_far.out } else { so_far.out.push(so_far.starter) },
    |out: List<Int>, mark: Int| out.push(mark),
  )

fn primary_composite(table: NormalizationTable, a: Int, b: Int) -> Int = {
  let made = hangul_syllable(a, b);
  if made >= 0 { made }
  else { match table.pairs.get(a << 21 | b) { Some(composite) -> composite, None -> -1 } }
}

fn compose_next(table: NormalizationTable, so_far: ComposeState, code_point: Int) -> ComposeState = {
  let class = ucd::lookup(table.words, code_point) & 255;
  if so_far.starter < 0 {
    if class == 0 { { out: so_far.out, starter: code_point, marks: [], last: 0 } }
    else { { out: so_far.out.push(code_point), starter: -1, marks: [], last: 0 } }
  } else {
    let blocked = so_far.marks.len() > 0 && so_far.last >= class;
    let composite = if blocked { -1 } else { primary_composite(table, so_far.starter, code_point) };
    if composite >= 0 {
      { out: so_far.out, starter: composite, marks: so_far.marks, last: so_far.last }
    } else if class == 0 {
      { out: finish_composition(so_far), starter: code_point, marks: [], last: 0 }
    } else {
      {
        out: so_far.out,
        starter: so_far.starter,
        marks: so_far.marks.push(code_point),
        last: class,
      }
    }
  }
}

fn composed(table: NormalizationTable, points: List<Int>) -> List<Int> =
  finish_composition(
    points.fold(
      { out: [], starter: -1, marks: [], last: 0 },
      |so_far: ComposeState, code_point: Int| compose_next(table, so_far, code_point),
    ),
  )

/// A Unicode normalization form: a standard way to write text so that equivalent texts become
/// identical.
pub type Form =
  /// Canonical decomposition followed by canonical composition. Most text is stored in this form.
  | Nfc
  /// Canonical decomposition.
  | Nfd
  /// Compatibility decomposition, then canonical composition.
  | Nfkc
  /// Compatibility decomposition.
  | Nfkd

/// The outcome of a quick check, which inspects text in one pass without normalizing it.
pub type QuickCheckResult =
  /// The text is in the form.
  | Yes
  /// The text is in the form unless a character in it composes with an earlier character. Only
  /// normalizing the text can tell whether one does.
  | Maybe
  /// The text is not in the form.
  | No

type QuickCheckMasks = { no: Int, maybe: Int, decomposes: Bool }

fn quick_check_masks(form: Form) -> QuickCheckMasks =
  match form {
    Nfc -> { no: nfc_no, maybe: nfc_maybe, decomposes: false },
    Nfkc -> { no: nfkc_no, maybe: nfkc_maybe, decomposes: false },
    Nfd -> { no: 0x3FFFFF << 12, maybe: 0, decomposes: true },
    Nfkd -> { no: 0x3FFFFF << 34, maybe: 0, decomposes: true },
  }

fn quick_check_code(table: NormalizationTable, chars: List<Char>, form: Form) -> Int = {
  let reads = quick_check_masks(form);
  chars.fold(0, |state: Int, c: Char|
      if state >> 8 == 2 { state } else {
        let code_point = Int::of_char(c);
        let word = ucd::lookup(table.words, code_point);
        let class = word & 255;
        if (class != 0 && state & 255 > class) || word & reads.no != 0
            || (reads.decomposes && is_syllable(code_point)) { 2 << 8 }
        else if word & reads.maybe != 0 { class | 1 << 8 }
        else { class | state >> 8 << 8 }
      })
    >> 8
}

/// Whether `text` is in `form`, as far as one pass over it can tell without normalizing it.
/// ASCII is `Yes` in a fixed number of steps.
pub fn quick_check(text: String, form: Form) -> QuickCheckResult =
  if text.is_ascii() { Yes } else {
    match quick_check_code(normalization_table, text.chars(), form) {
      0 -> Yes,
      1 -> Maybe,
      _ -> No,
    }
  }

/// `text` in `form`. A text whose quick check is `Yes`, as most text is, is returned unchanged
/// after that one pass. Any other text is decomposed, put in canonical order and, for the composed
/// forms, composed.
pub fn normalize(text: String, form: Form) -> String =
  if text.is_ascii() { text } else {
    let table = normalization_table;
    let chars = text.chars();
    if quick_check_code(table, chars, form) == 0 { text } else {
      text_of(match form {
        Nfd -> decomposed(table, chars, false),
        Nfkd -> decomposed(table, chars, true),
        Nfc -> composed(table, decomposed(table, chars, false)),
        Nfkc -> composed(table, decomposed(table, chars, true)),
      })
    }
  }

/// `text` in Normalization Form C: canonically equivalent texts have one NFC.
pub fn nfc(text: String) -> String = normalize(text, Nfc)

/// Returns `text` with every character canonically decomposed and its marks in canonical order.
pub fn nfd(text: String) -> String = normalize(text, Nfd)

/// `text` in Normalization Form KC, which also replaces compatibility characters, such as a
/// ligature or a full-width letter, by what they represent, and so loses the distinction.
pub fn nfkc(text: String) -> String = normalize(text, Nfkc)

/// Returns `text` with every character decomposed, including compatibility characters, and its
/// marks in canonical order. Like `nfkc`, it loses the distinction between compatibility characters
/// and what they represent.
pub fn nfkd(text: String) -> String = normalize(text, Nfkd)

/// Whether `text` is in `form`: the quick check's result when it is `Yes` or `No`, and a comparison
/// with the normalized text when it is `Maybe`.
pub fn is_normalized(text: String, form: Form) -> Bool =
  match quick_check(text, form) { Yes -> true, No -> false, Maybe -> normalize(text, form) == text }

/// Whether `a` and `b` are canonically equivalent: the same text, however each writes its accents
/// and syllables.
pub fn equivalent(a: String, b: String) -> Bool = a == b || nfd(a) == nfd(b)

/// The Canonical_Combining_Class of `c`: `0` for a starter, and for a mark the number that
/// orders it among the marks on one starter.
pub fn combining_class(c: Char) -> Int =
  ucd::lookup(normalization_table.words, Int::of_char(c)) & 255

const stream_safe_run: Int = 30

type StreamSafeState = { out: List<Char>, run: Int }

/// Returns `text` in the Stream-Safe Text Format of UAX #15. Inserts `U+034F`, the combining
/// grapheme joiner, wherever more than thirty marks in a row would otherwise appear once the text
/// is decomposed, so that normalizing the result never buffers more than thirty marks to order
/// them. Text that needs no insertion is returned unchanged. An inserted joiner changes how the
/// marks around it are ordered.
pub fn stream_safe(text: String) -> String =
  if text.is_ascii() { text } else {
    let table = normalization_table;
    String::of_chars(
      text.chars().fold({ out: [], run: 0 }, |so_far: StreamSafeState, c: Char| {
        let marks = flush_marks(
          decompose_into(table, { out: [], marks: [] }, Int::of_char(c), true),
        ).map(|code_point: Int| ucd::lookup(table.words, code_point) & 255 != 0);
        let leading = marks.fold(
          { count: 0, open: true },
          |lead: { count: Int, open: Bool }, mark: Bool|
            if lead.open && mark { { count: lead.count + 1, open: true } }
            else { { count: lead.count, open: false } },
        ).count;
        let trailing = marks.fold(0, |count: Int, mark: Bool| if mark { count + 1 } else { 0 });
        let compose_next = so_far.run + leading > stream_safe_run;
        {
          out: List::push(if compose_next { so_far.out.push('\u{34F}') } else { so_far.out }, c),
          run: if leading == marks.len() { (if compose_next { 0 } else { so_far.run }) + leading }
          else { trailing },
        }
      }).out,
    )
  }

type Casing = { words: Table, rows: Array<Int>, points: Array<Int> }

const is_cased: Int = 0x100000

const is_ignorable: Int = 0x200000

const is_soft_dotted: Int = 0x400000

const is_above: Int = 0x800000

const is_mark: Int = 0x1000000

fn case_bit(letter: Int) -> Int / {abort.raise} =
  match letter {
    b'c' -> is_cased,
    b'i' -> is_ignorable,
    b's' -> is_soft_dotted,
    b'a' -> is_above,
    b'b' -> is_mark,
    _ ->
      panic(
        "a casing flag letter must be c (cased), i (case-ignorable), s (soft-dotted), a (above) or b (mark)",
      ),
  }

type CasingState = { valued: List<ValueRun>, gathering: SequencePool, mapping_positions: List<Int> }

fn casing_of(runs: List<Run>) -> Casing / {abort.raise} = {
  let made = runs.fold(
    { valued: [], gathering: ucd::empty_pool, mapping_positions: [0] },
    |m: CasingState, run: Run| {
      let field = |i: Int| match run.fields.at(i) { Some(text) -> text, None -> b"" };
      let flags = range(0, field(5).len()).fold(0, |bits: Int, i: Int|
        bits | case_bit(field(5).at(i)));
      let append_fold = ucd::intern(m.gathering, ucd::code_points(field(1)));
      let lower = ucd::intern(append_fold.gathering, ucd::code_points(field(2)));
      let title = ucd::intern(lower.gathering, ucd::code_points(field(3)));
      let upper = ucd::intern(title.gathering, ucd::code_points(field(4)));
      let row = append_fold.place | lower.place << 15 | title.place << 30 | upper.place << 45;
      if upper.place >= 0x8000 {
        panic(
          "the case mappings of several characters are too large to store: the code points they map to start beyond the first 32768 entries of the table",
        )
      } else {
        {
          valued: m.valued.push({
            first: run.first,
            last: run.last,
            value: ucd::parse_offset(field(0)) | flags
              | (if row == 0 { 0 } else { m.mapping_positions.len() << 25 }),
          }),
          gathering: upper.gathering,
          mapping_positions: if row == 0 { m.mapping_positions }
          else { m.mapping_positions.push(row) },
        }
      }
    },
  );
  {
    words: ucd::table_of(made.valued, 0),
    rows: Array::of_list(made.mapping_positions),
    points: Array::of_list(made.gathering.points),
  }
}

const casing: Casing = casing_of(ucd::runs(embed("ucd/casing.txt")))

const fold_shift: Int = 0

const lowercase_shift: Int = 15

const titlecase_shift: Int = 30

const uppercase_shift: Int = 45

fn mapping_handle(table: Casing, word: Int, shift: Int) -> Int =
  match table.rows.at(word >> 25) { Some(row) -> row >> shift & 0x7FFF, None -> 0 }

fn simple_mapping(code_point: Int, simple: (Char) -> Char) -> Int =
  match Char::of_int(code_point) { Some(c) -> Int::of_char(simple(c)), None -> code_point }

fn append_mapping(
  table: Casing,
  out: List<Int>,
  code_point: Int,
  shift: Int,
  simple: (Char) -> Char,
) -> List<Int> = {
  let word = ucd::lookup(table.words, code_point);
  if word == 0 { out.push(code_point) } else {
    let at = mapping_handle(table, word, shift);
    if at == 0 { out.push(simple_mapping(code_point, simple)) }
    else { ucd::sequence(table.points, at).fold(out, |all: List<Int>, part: Int| all.push(part)) }
  }
}

type CasingContext = { code_points: Array<Int>, casing: Casing }

fn has_flag(around: CasingContext, code_point: Int, flag: Int) -> Bool =
  ucd::lookup(around.casing.words, code_point) & flag != 0

fn cased_before(around: CasingContext, i: Int) -> Bool =
  if i < 0 { false } else {
    match around.code_points.at(i) {
      None -> false,
      Some(code_point) -> if has_flag(around, code_point, is_ignorable) {
        cased_before(around, i - 1)
      } else { has_flag(around, code_point, is_cased) },
    }
  }

fn cased_after(around: CasingContext, i: Int) -> Bool =
  match around.code_points.at(i) {
    None -> false,
    Some(code_point) -> if has_flag(around, code_point, is_ignorable) { cased_after(around, i + 1) }
    else { has_flag(around, code_point, is_cased) },
  }

fn final_sigma(around: CasingContext, i: Int) -> Bool =
  cased_before(around, i - 1) && !cased_after(around, i + 1)

fn above_after(around: CasingContext, i: Int, dot: Bool) -> Bool =
  match around.code_points.at(i) {
    None -> false,
    Some(code_point) -> if dot && code_point == 0x307 { true }
    else if has_flag(around, code_point, is_above) { !dot }
    else { has_flag(around, code_point, is_mark) && above_after(around, i + 1, dot) },
  }

fn dotted_before(around: CasingContext, i: Int, capital_i: Bool) -> Bool =
  if i < 0 { false } else {
    match around.code_points.at(i) {
      None -> false,
      Some(code_point) -> if capital_i && code_point == 0x49 { true }
      else if !capital_i && has_flag(around, code_point, is_soft_dotted) { true }
      else { has_flag(around, code_point, is_mark) && dotted_before(around, i - 1, capital_i) },
    }
  }

/// A language with its own case mappings. No function here reads the language from the
/// environment.
pub type Tailoring =
  /// The mappings of every language except those below.
  | Untailored
  /// Turkish and Azeri, which have two separate letters for `i`: a dotted pair, lowercase `i` with
  /// capital `U+0130`, and a dotless pair, lowercase `U+0131` with capital `I`.
  | Turkic
  /// Lithuanian, where a lowercase `i` keeps its dot when an accent sits above it. Lowercasing a
  /// capital `I`, `J` or `Į` (`I` with ogonek, `U+012E`) before a mark above adds a dot (`U+0307`)
  /// after the letter. Uppercasing removes that dot.
  | Lithuanian

fn append_lowercase(
  around: CasingContext,
  out: List<Int>,
  i: Int,
  code_point: Int,
  tailoring: Tailoring,
) -> List<Int> =
  if code_point == 0x3A3 { out.push(if final_sigma(around, i) { 0x3C2 } else { 0x3C3 }) } else {
    match tailoring {
      Untailored ->
        append_mapping(around.casing, out, code_point, lowercase_shift, Char::to_lowercase),
      Turkic -> if code_point == 0x130 { out.push(0x69) }
      else if code_point == 0x307 && dotted_before(around, i - 1, true) { out }
      else if code_point == 0x49 && !above_after(around, i + 1, true) { out.push(0x131) }
      else { append_mapping(around.casing, out, code_point, lowercase_shift, Char::to_lowercase) },
      Lithuanian -> append_lithuanian_lowercase(around, out, i, code_point),
    }
  }

fn append_lithuanian_lowercase(
  around: CasingContext,
  out: List<Int>,
  i: Int,
  code_point: Int,
) -> List<Int> =
  match code_point {
    0x49 | 0x4A | 0x12E -> {
      let small = out.push(simple_mapping(code_point, Char::to_lowercase));
      if above_after(around, i + 1, false) { small.push(0x307) } else { small }
    },
    0xCC -> out.push(0x69).push(0x307).push(0x300),
    0xCD -> out.push(0x69).push(0x307).push(0x301),
    0x128 -> out.push(0x69).push(0x307).push(0x303),
    _ -> append_mapping(around.casing, out, code_point, lowercase_shift, Char::to_lowercase),
  }

fn append_uppercase(
  around: CasingContext,
  out: List<Int>,
  i: Int,
  code_point: Int,
  tailoring: Tailoring,
  shift: Int,
  simple: (Char) -> Char,
) -> List<Int> =
  if tailoring == Turkic && code_point == 0x69 { out.push(0x130) }
  else if tailoring == Lithuanian && code_point == 0x307 && dotted_before(around, i - 1, false) {
    out
  } else { append_mapping(around.casing, out, code_point, shift, simple) }

fn map_code_points(
  text: String,
  each: (CasingContext, List<Int>, Int, Int) -> List<Int>,
) -> String = {
  let around = { code_points: Array::of_list(text.chars().map(Int::of_char)), casing: casing };
  text_of(
    range(0, around.code_points.len()).fold([], |out: List<Int>, i: Int|
      match around.code_points.at(i) {
        Some(code_point) -> each(around, out, i, code_point),
        None -> out,
      }),
  )
}

/// `text` in lowercase, by the full mappings: a character may become several, and a capital sigma
/// becomes the final small sigma at the end of a word. A character outside ASCII can become an
/// ASCII letter (the Kelvin sign `U+212A` becomes `k`), so use `std.string`'s `ascii_lower` for a
/// name that is compared.
pub fn lowercase(text: String, tailoring: Tailoring = Untailored) -> String =
  if text.is_ascii() && tailoring != Turkic {
    String::of_chars(text.chars().map(Char::to_ascii_lowercase))
  } else {
    map_code_points(text, |around: CasingContext, out: List<Int>, i: Int, code_point: Int|
      append_lowercase(around, out, i, code_point, tailoring))
  }

/// `text` in uppercase, by the full mappings: `U+00DF` becomes `SS`, and a ligature becomes its
/// letters. Use `std.string`'s `ascii_upper` for a name that is compared.
pub fn uppercase(text: String, tailoring: Tailoring = Untailored) -> String =
  if text.is_ascii() && tailoring != Turkic {
    String::of_chars(text.chars().map(Char::to_ascii_uppercase))
  } else {
    map_code_points(text, |around: CasingContext, out: List<Int>, i: Int, code_point: Int|
      append_uppercase(around, out, i, code_point, tailoring, uppercase_shift, Char::to_uppercase))
  }

/// `text` as one word in titlecase: its first cased character in titlecase, every later character
/// in lowercase, and anything before it unchanged. Title a text of several words one word at a
/// time.
pub fn titlecase(text: String, tailoring: Tailoring = Untailored) -> String = {
  let around = { code_points: Array::of_list(text.chars().map(Int::of_char)), casing: casing };
  text_of(
    range(0, around.code_points.len()).fold(
      { out: [], begun: false },
      |so_far: { out: List<Int>, begun: Bool }, i: Int|
        match around.code_points.at(i) {
          None -> so_far,
          Some(code_point) -> if so_far.begun {
            { out: append_lowercase(around, so_far.out, i, code_point, tailoring), begun: true }
          } else if has_flag(around, code_point, is_cased) {
            {
              out: append_uppercase(
                around,
                so_far.out,
                i,
                code_point,
                tailoring,
                titlecase_shift,
                Char::to_titlecase,
              ),
              begun: true,
            }
          } else { { out: so_far.out.push(code_point), begun: false } },
        },
    ).out,
  )
}

fn simple_fold(table: Casing, code_point: Int, turkic: Bool) -> Int =
  if turkic && code_point == 0x49 { 0x131 }
  else if turkic && code_point == 0x130 { 0x69 }
  else { ucd::apply_distance(code_point, ucd::lookup(table.words, code_point)) }

fn append_fold(table: Casing, out: List<Int>, code_point: Int, turkic: Bool) -> List<Int> = {
  let at = if turkic && (code_point == 0x49 || code_point == 0x130) { 0 }
  else { mapping_handle(table, ucd::lookup(table.words, code_point), fold_shift) };
  if at == 0 { out.push(simple_fold(table, code_point, turkic)) }
  else { ucd::sequence(table.points, at).fold(out, |all: List<Int>, part: Int| all.push(part)) }
}

/// Returns `text` with full case folding, for case-insensitive comparison. Each character is
/// replaced by its folded form, which may be several characters, so `U+00DF` and `SS` fold to the
/// same text. With `turkic`, `I` folds to dotless `U+0131` and `U+0130` folds to `i`, as in Turkish
/// and Azeri. Folded text is for comparing and is not the same as lowercase.
///
/// Each character folds on its own, so two ways of writing the same text can fold to different
/// results. For example, a text with an iota subscript placed before another combining mark can
/// fold differently from the same text with the subscript placed after that mark. With `turkic`,
/// `U+0130` folds differently from `I` followed by a separate dot above `U+0307`. `caseless` and
/// `caseless_key` compare texts correctly however they are written.
pub fn case_fold(text: String, turkic: Bool = false) -> String =
  if text.is_ascii() && !turkic { String::of_chars(text.chars().map(Char::to_ascii_lowercase)) }
  else {
    let table = casing;
    text_of(
      text.chars().fold([], |out: List<Int>, c: Char|
        append_fold(table, out, Int::of_char(c), turkic)),
    )
  }

/// Returns `text` case-folded one character to one character. Works like `case_fold`, except that a
/// character whose full folding is several characters uses its single-character simple folding. The
/// result has the same number of characters as `text`, and `U+00DF` does not fold to the same text
/// as `ss`.
pub fn simple_case_fold(text: String, turkic: Bool = false) -> String = {
  let table = casing;
  text_of(text.chars().map(|c: Char| simple_fold(table, Int::of_char(c), turkic)))
}

fn turkic_folded(decomposed: String) -> String =
  map_code_points(decomposed, |around: CasingContext, out: List<Int>, i: Int, code_point: Int|
    if code_point == 0x307 && dotted_before(around, i - 1, true) { out }
    else if code_point == 0x49 && above_after(around, i + 1, true) { out.push(0x69) }
    else { append_fold(around.casing, out, code_point, true) })

/// What `caseless` compares: `text` decomposed, folded and decomposed again, as the standard
/// defines a canonical caseless match. Two texts match case-insensitively exactly when their keys
/// are equal, so use this as the key to store them under. The key of a key is itself. With
/// `turkic`, the folding is the Turkic one, and `U+0130` folds to `i` however it is written.
pub fn caseless_key(text: String, turkic: Bool = false) -> String =
  nfd(if turkic { turkic_folded(nfd(text)) } else { case_fold(nfd(text)) })

/// Returns whether `a` and `b` are the same text ignoring case, however each writes its accents (a
/// canonical caseless match). Comparing lowercased or case-folded texts directly gets accented and
/// multi-letter characters wrong: two canonically equivalent texts can fold to different results
/// unless each is decomposed first. With `turkic`, `I` matches `U+0131` and `U+0130` matches `i`,
/// but `I` does not match `i`, and `U+0130` does not match `U+0131`.
pub fn caseless(a: String, b: String, turkic: Bool = false) -> Bool =
  a == b || caseless_key(a, turkic) == caseless_key(b, turkic)

const forms: List<Form> = [Nfc, Nfd, Nfkc, Nfkd]

test "normalizing already normalized text changes nothing, and `is_normalized` is true and `quick_check` is not `No`" {
  gen::check(gen::any_int(), |seed: Int| {
    let text = sample_text(seed);
    forms.all(|form: Form| {
      let normalization_table = normalize(text, form);
      normalize(normalization_table, form) == normalization_table
        && is_normalized(normalization_table, form)
        && quick_check(normalization_table, form) != No
    })
  })
}

test "`quick_check` returning `Yes` means `normalize` leaves the text unchanged, and `No` means it changes the text" {
  gen::check(gen::any_int(), |seed: Int| {
    let text = sample_text(seed);
    forms.all(|form: Form|
      match quick_check(text, form) {
        Yes -> normalize(text, form) == text,
        No -> normalize(text, form) != text,
        Maybe -> true,
      })
  })
}

test "a text is canonically equivalent to itself, to its `nfc` form and to its `nfd` form" {
  gen::check(gen::any_int(), |seed: Int| {
    let text = sample_text(seed);
    equivalent(text, text) && equivalent(text, nfc(text)) && equivalent(nfd(text), text)
  })
}

test "`caseless` is symmetric and ignores canonical differences, and `caseless_key` is unchanged when applied again" {
  gen::check3(gen::any_int(), gen::any_int(), gen::bool(), |seed: Int, other: Int, turkic: Bool| {
    let a = sample_text(seed);
    let b = sample_text(other);
    let key = caseless_key(a, turkic);
    caseless(a, a, turkic) && caseless(a, b, turkic) == caseless(b, a, turkic)
      && caseless(a, nfc(a), turkic)
      && caseless(nfd(a), a, turkic)
      && caseless_key(key, turkic) == key
      && caseless(a, key, turkic)
  })
}

test "`nfc`, `nfd`, `nfkc` and `nfkd` compose and decompose text, using canonical and compatibility mappings" {
  assert_eq(nfc("e\u{301}"), "\u{E9}");
  assert_eq(nfd("\u{E9}"), "e\u{301}");
  assert_eq(nfc("\u{1E9B}\u{323}"), "\u{1E9B}\u{323}");
  assert_eq(nfd("\u{1E9B}\u{323}"), "\u{17F}\u{323}\u{307}");
  assert_eq(nfkc("\u{1E9B}\u{323}"), "\u{1E69}");
  assert_eq(nfkd("\u{1E9B}\u{323}"), "s\u{323}\u{307}");
  assert_eq(nfkc("\u{FB01}"), "fi");
  assert_eq(nfc("\u{FB01}"), "\u{FB01}");
  assert_eq(nfc("\u{2126}"), "\u{3A9}");
  assert_eq(nfc("plain"), "plain");
  assert_eq(nfd(""), "")
}

test "normalization sorts combining marks after a base character by combining class, and keeps marks of equal class in their original order" {
  assert_eq(nfd("a\u{301}\u{323}"), "a\u{323}\u{301}");
  assert_eq(nfd("a\u{301}\u{300}"), "a\u{301}\u{300}");
  assert_eq(nfc("a\u{323}\u{301}"), "\u{1EA1}\u{301}");
  assert_eq(nfc("a\u{301}\u{323}"), "\u{1EA1}\u{301}");
  assert_eq(nfc("a\u{5AE}\u{300}"), "\u{E0}\u{5AE}");
  assert_eq(nfc("a\u{300}\u{5AE}"), "\u{E0}\u{5AE}");
  assert_eq(nfc("a\u{301}\u{300}"), "\u{E1}\u{300}")
}

test "`nfd` and `nfc` split a Hangul syllable into its jamo letters and join them back by computation" {
  assert_eq(nfd("\u{AC00}"), "\u{1100}\u{1161}");
  assert_eq(nfd("\u{D4DB}"), "\u{1111}\u{1171}\u{11B6}");
  assert_eq(nfc("\u{1111}\u{1171}\u{11B6}"), "\u{D4DB}");
  assert_eq(nfc("\u{1100}\u{1161}"), "\u{AC00}");
  assert_eq(nfc("\u{AC00}\u{11A8}"), "\u{AC01}");
  assert_eq(nfc("\u{AC01}\u{11A8}"), "\u{AC01}\u{11A8}");
  assert_eq(nfc("\u{1100}\u{1100}"), "\u{1100}\u{1100}")
}

test "`quick_check` returns `Yes`, `No` or `Maybe` after one scan, and `is_normalized` returns a definite true or false even when `quick_check` returns `Maybe`" {
  assert_eq(quick_check("abc", Nfc), Yes);
  assert_eq(quick_check("\u{E9}", Nfc), Yes);
  assert_eq(quick_check("\u{E9}", Nfd), No);
  assert_eq(quick_check("e\u{301}", Nfc), Maybe);
  assert_eq(quick_check("e\u{301}", Nfd), Yes);
  assert_eq(quick_check("q\u{301}", Nfc), Maybe);
  assert_eq(quick_check("\u{2126}", Nfc), No);
  assert_eq(quick_check("a\u{301}\u{323}", Nfd), No);
  assert_eq(quick_check("\u{AC00}", Nfc), Yes);
  assert_eq(quick_check("\u{AC00}", Nfkd), No);
  assert_eq(quick_check("\u{FB01}", Nfc), Yes);
  assert_eq(quick_check("\u{FB01}", Nfkc), No);
  assert(is_normalized("q\u{301}", Nfc) && !is_normalized("e\u{301}", Nfc));
  assert(is_normalized("e\u{301}", Nfd) && !is_normalized("\u{E9}", Nfkd))
}

test "`equivalent` is true for texts that are different spellings of the same character, but false for compatibility characters such as the `fi` ligature" {
  assert(equivalent("\u{E9}", "e\u{301}"));
  assert(equivalent("\u{212B}", "\u{C5}"));
  assert(equivalent("\u{D4DB}", "\u{1111}\u{1171}\u{11B6}"));
  assert(!equivalent("\u{FB01}", "fi"));
  assert(!equivalent("a", "A"))
}

test "`combining_class` returns a nonzero class for combining marks and 0 for base characters" {
  assert_eq(['a', '\u{301}', '\u{323}', '\u{94D}', '\u{AC00}'].map(combining_class), [
    0,
    230,
    220,
    9,
    0,
  ])
}

test "`stream_safe` allows up to thirty combining marks in a row and inserts a combining grapheme joiner before the next mark" {
  let marks = |n: Int| String::of_chars(range(0, n).map(|_: Int| '\u{301}'));
  assert_eq(stream_safe("a" ++ marks(30)), "a" ++ marks(30));
  assert_eq(stream_safe("a" ++ marks(31)), "a" ++ marks(30) ++ "\u{34F}\u{301}");
  assert_eq(stream_safe(marks(65)), marks(30) ++ "\u{34F}" ++ marks(30) ++ "\u{34F}" ++ marks(5));
  assert_eq(stream_safe("a" ++ marks(29) ++ "\u{344}"), "a" ++ marks(29) ++ "\u{34F}\u{344}");
  assert_eq(stream_safe("plain"), "plain")
}

test "`uppercase`, `lowercase` and `titlecase` map one character to several where Unicode defines it, such as `ß` to `SS`" {
  assert_eq(uppercase("stra\u{DF}e"), "STRASSE");
  assert_eq(uppercase("\u{FB03}"), "FFI");
  assert_eq(uppercase("\u{149}"), "\u{2BC}N");
  assert_eq(lowercase("\u{130}"), "i\u{307}");
  assert_eq(titlecase("\u{FB03}x"), "Ffix");
  assert_eq(titlecase("\u{1C6}UNGLA"), "\u{1C5}ungla");
  assert_eq(titlecase("'tWAS"), "'Twas");
  assert_eq(titlecase("\u{DF}"), "Ss");
  assert_eq(lowercase("PLAIN text"), "plain text");
  assert_eq(uppercase("plain TEXT"), "PLAIN TEXT");
  assert_eq(uppercase(""), "")
}

test "`lowercase` turns a capital sigma into the final sigma when it ends a word" {
  assert_eq(lowercase("\u{39F}\u{394}\u{39F}\u{3A3}"), "\u{3BF}\u{3B4}\u{3BF}\u{3C2}");
  assert_eq(lowercase("\u{3A3}"), "\u{3C3}");
  assert_eq(lowercase("\u{3A3}\u{391}"), "\u{3C3}\u{3B1}");
  assert_eq(lowercase("\u{391}\u{3A3}\u{391}"), "\u{3B1}\u{3C3}\u{3B1}");
  assert_eq(lowercase("\u{391}\u{3A3}."), "\u{3B1}\u{3C2}.");
  assert_eq(lowercase("\u{391}\u{3A3}.\u{391}"), "\u{3B1}\u{3C3}.\u{3B1}");
  assert_eq(lowercase("\u{391}'\u{3A3} \u{391}"), "\u{3B1}'\u{3C2} \u{3B1}");
  assert_eq(titlecase("\u{3BF}\u{394}\u{39F}\u{3A3}"), "\u{39F}\u{3B4}\u{3BF}\u{3C2}")
}

test "with the Turkish and Azeri option, dotted and dotless i stay distinct when changing case or folding case" {
  assert_eq(uppercase("i\u{131}", Turkic), "\u{130}I");
  assert_eq(lowercase("I\u{130}", Turkic), "\u{131}i");
  assert_eq(lowercase("I\u{307}", Turkic), "i");
  assert_eq(lowercase("I\u{323}\u{307}", Turkic), "i\u{323}");
  assert_eq(lowercase("I\u{307}"), "i\u{307}");
  assert_eq(titlecase("istanbul", Turkic), "\u{130}stanbul");
  assert_eq(titlecase("ISTANBUL III", Turkic), "Istanbul \u{131}\u{131}\u{131}");
  assert_eq(case_fold("I\u{130}", turkic: true), "\u{131}i");
  assert_eq(case_fold("I\u{130}"), "ii\u{307}");
  assert_eq(simple_case_fold("I\u{130}"), "i\u{130}")
}

test "with the Lithuanian option, `lowercase` keeps the dot on i when an accent is above it, and `uppercase` removes that dot" {
  assert_eq(lowercase("I\u{300}", Lithuanian), "i\u{307}\u{300}");
  assert_eq(lowercase("J\u{303}", Lithuanian), "j\u{307}\u{303}");
  assert_eq(lowercase("\u{12E}\u{301}", Lithuanian), "\u{12F}\u{307}\u{301}");
  assert_eq(lowercase("\u{CC}", Lithuanian), "i\u{307}\u{300}");
  assert_eq(lowercase("I", Lithuanian), "i");
  assert_eq(lowercase("I\u{323}", Lithuanian), "i\u{323}");
  assert_eq(lowercase("I\u{300}"), "i\u{300}");
  assert_eq(uppercase("i\u{307}\u{300}", Lithuanian), "I\u{300}");
  assert_eq(uppercase("i\u{307}"), "I\u{307}")
}

test "`case_fold` maps all case variants of a letter to one form, possibly to several characters, and `simple_case_fold` maps one character to one" {
  assert_eq(case_fold("Stra\u{DF}e"), "strasse");
  assert_eq(simple_case_fold("Stra\u{DF}e"), "stra\u{DF}e");
  assert_eq(case_fold("\u{1E9E}"), "ss");
  assert_eq(simple_case_fold("\u{1E9E}"), "\u{DF}");
  assert_eq(case_fold("\u{3A3}\u{3C3}\u{3C2}"), "\u{3C3}\u{3C3}\u{3C3}");
  assert_eq(case_fold("\u{13A0}\u{AB70}"), "\u{13A0}\u{13A0}");
  assert_eq(case_fold("\u{FB03}"), "ffi");
  assert_eq(case_fold("\u{212A}elvin"), "kelvin");
  assert_eq(case_fold("PLAIN Text"), "plain text")
}

test "`caseless` matches texts that differ only in case, whichever way their accents are written" {
  assert(caseless("Stra\u{DF}e", "STRASSE"));
  assert(caseless("\u{C9}COLE", "e\u{301}cole"));
  assert(
    caseless(
      "\u{3A3}\u{3AF}\u{3C3}\u{3C5}\u{3C6}\u{3BF}\u{3C2}",
      "\u{3A3}\u{38A}\u{3A3}\u{3A5}\u{3A6}\u{39F}\u{3A3}",
    ),
  );
  assert(!caseless("resume", "r\u{E9}sum\u{E9}"));
  assert_eq(caseless_key("\u{C5}"), "a\u{30A}")
}

test "`caseless` decomposes text before case folding, because folding an iota subscript turns that combining mark into a letter" {
  let written = "\u{1FB3}\u{313}";
  let composed = "\u{1F80}";
  assert(equivalent(written, composed));
  assert(nfd(case_fold(written)) != nfd(case_fold(composed)));
  assert(caseless(written, composed));
  assert(!caseless(written, case_fold(written)));
  assert(caseless(written, case_fold(nfd(written))));
  assert(caseless("\u{1FBC}\u{313}", "\u{3B1}\u{313}\u{3B9}"))
}

test "with the Turkish and Azeri option, `caseless` matches dotted i with dotted capital İ and dotless ı with I, in any canonical spelling" {
  assert(!caseless("I", "\u{131}"));
  assert(caseless("I", "\u{131}", turkic: true));
  assert(!caseless("I", "i", turkic: true));
  assert(caseless("\u{130}stanbul", "istanbul", turkic: true));
  assert(caseless("I\u{307}stanbul", "istanbul", turkic: true));
  assert(caseless("I\u{307}", "\u{130}", turkic: true));
  assert(caseless("I\u{323}\u{307}", "i\u{323}", turkic: true));
  assert(!caseless("I\u{301}\u{307}", "i\u{301}", turkic: true));
  assert(!caseless("\u{130}", "i"));
  assert(caseless("\u{130}", "i\u{307}"));
  assert_eq(caseless_key("DI\u{307}YARBAKIR", turkic: true), "diyarbak\u{131}r");
  assert_eq(case_fold("I\u{307}", turkic: true), "\u{131}\u{307}")
}

type CaseExample = { text: String, ascii: String, unicode: String }

const lowercase_examples: List<CaseExample> =
  [
    { text: "\u{212A}", ascii: "\u{212A}", unicode: "k" },
    { text: "\u{130}", ascii: "\u{130}", unicode: "i\u{307}" },
    { text: "ÉCOLE", ascii: "École", unicode: "école" },
    { text: "ΟΔΟΣ", ascii: "ΟΔΟΣ", unicode: "οδος" },
  ]

const uppercase_examples: List<CaseExample> =
  [
    { text: "straße", ascii: "STRAßE", unicode: "STRASSE" },
    { text: "ﬁn", ascii: "ﬁN", unicode: "FIN" },
    { text: "ŉ", ascii: "ŉ", unicode: "ʼN" },
    { text: "\u{17F}et", ascii: "\u{17F}ET", unicode: "SET" },
    { text: "\u{131}d", ascii: "\u{131}D", unicode: "ID" },
  ]

test "outside ASCII, `ascii_lower` leaves characters unchanged where `lowercase` changes them" {
  lowercase_examples.fold((), |_: Unit, c: CaseExample| {
    assert_eq(c.text.ascii_lower(), c.ascii);
    assert_eq(lowercase(c.text), c.unicode);
    assert_eq(c.text.ascii_lower().len(), c.text.len())
  })
}

test "outside ASCII, `ascii_upper` leaves characters unchanged where `uppercase` changes them" {
  uppercase_examples.fold((), |_: Unit, c: CaseExample| {
    assert_eq(c.text.ascii_upper(), c.ascii);
    assert_eq(uppercase(c.text), c.unicode);
    assert_eq(c.text.ascii_upper().len(), c.text.len())
  })
}

test "for every character, when `uppercase` or `lowercase` returns one character it equals the result of `std.char`'s `to_uppercase` or `to_lowercase`" {
  let unlike = range(0, 0x110000).fold([], |found: List<Int>, n: Int|
    match Char::of_int(n) {
      Some(c) -> {
        let upper = uppercase(String::of_chars([c]));
        let lower = lowercase(String::of_chars([c]));
        if (upper.len() == 1 && upper != String::of_chars([c.to_uppercase()]))
            || (lower.len() == 1 && lower != String::of_chars([c.to_lowercase()])) { found.push(n) }
        else { found }
      },
      None -> found,
    });
  assert_eq(unlike, [])
}

test "without a language option, `lowercase` and `uppercase` use Unicode's full case mappings for characters outside ASCII" {
  let cases = [
    ("AbC1 é", "abc1 é", "ABC1 É"),
    ("straße", "straße", "STRASSE"),
    ("İ", "i\u{307}", "İ"),
    ("ΟΔΟΣ", "οδος", "ΟΔΟΣ"),
    ("Σ", "σ", "Σ"),
    ("\u{212A}", "k", "\u{212A}"),
    ("ſ", "ſ", "S"),
    ("ŉ", "ŉ", "\u{2BC}N"),
    ("ﬁ", "ﬁ", "FI"),
    ("ǆ", "ǆ", "Ǆ"),
    ("", "", ""),
  ];
  cases.fold((), |u: Unit, c: (String, String, String)|
    match c {
      (text, lower, upper) -> {
        assert_eq(lowercase(text), lower);
        assert_eq(uppercase(text), upper)
      },
    })
}
