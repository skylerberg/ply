//! Support for tests that run once for each case of a table.
//!
//! `test "{c.name}" for c: T in table() { .. }` runs one test for each element of its table. Each
//! element is a *case*. A test run identifies a case by its value as it was built, so a case keeps
//! its recorded pass when the table moves it. Two cases that a test body can tell apart never share
//! an identity: `1.5m` and `1.50m` are two cases, as are two values whose type's `key` returns the
//! same for both. A run calls `listed` to learn the cases and `chosen` to start the test for one. A
//! module with such a test imports this module, so this module cannot contain one.

import std.value (Value, VUnit, VBool, VInt, VFloat, VDecimal, VFixed, VChar, VStr, VBytes, VList,
                  VArray, VRecord, VCtor, VMap, VFn, FAnonymous, Field, Entry, ctor_name, reflect)

/// The cases a test runs over, in the order a report lists them.
pub type Table<a> = List<a>

/// A case as a test run identifies it.
pub type Case = {
  /// The name its test is reported under, which `--filter` matches.
  label: String,
  /// The BLAKE3 hash of its value as built. Two cases built the same way share an identity. Two
  /// that `==` calls equal but that are built differently do not.
  identity: Bytes,
}

/// Lists each case of `table` in the table's order, with the label `label` gives it.
///
/// The hash ignores any `key` the type declares, since cases are told apart by what they contain.
/// Raises on a value that contains a function, a handle or a credential.
pub fn listed<a | e>(table: List<a>, label: (a) -> String / e) -> List<Case> / {abort.raise | e}
  where derivable(hash, a)
= table.map(|c: a| { label: label(c), identity: identity(c) })

/// Returns the case whose identity is `wanted`.
///
/// Returns the element at index `at` if it still has that identity, and otherwise the first
/// element with that identity anywhere in the table. Raises when no element has it.
pub fn chosen<a>(table: List<a>, at: Int, wanted: Bytes) -> a / {abort.raise}
  where derivable(hash, a)
=
  match table.at(at) {
    Some(c) -> if identity(c) == wanted { c } else { find_by_identity(table, wanted) },
    None -> find_by_identity(table, wanted),
  }

fn find_by_identity<a>(table: List<a>, wanted: Bytes) -> a / {abort.raise}
  where derivable(hash, a)
=
  match table.filter(|c: a| identity(c) == wanted) {
    [c, ..] -> c,
    [] -> panic("the table no longer holds this case"),
  }

/// The BLAKE3 hash of `c` as it was built. `digest` is coarser, because it agrees with `==`.
fn identity<a>(c: a) -> Bytes / {abort.raise} = encode_value(reflect(c)).blake3()

/// Encodes `v` as bytes that no other value encodes to, with two exceptions that never merge two
/// cases of one type. An integer narrower than 64 bits is written as the `Int` of its value, which
/// is how compiled code stores one. A constructor is written under its name without the module
/// path, so cases keep their identity when their module moves. A `Decimal` keeps its scale, and a
/// value whose type declares a `key` keeps all its fields. Raises on a function, a handle or a
/// credential, which have no data to write.
fn encode_value(v: Value) -> Bytes / {abort.raise} =
  match v {
    VUnit -> b"u",
    VBool(yes) -> if yes { b"t" } else { b"f" },
    VInt(n) -> text(b"i", n.to_string()),
    VFixed(ty, bits) -> match narrow(ty, bits) {
      Some(n) -> text(b"i", n.to_string()),
      None -> text(b"w", ty ++ " " ++ bits.to_string()),
    },
    VFloat(f) -> text(b"g", bits_of_float(f).to_string()),
    VDecimal(d) -> text(b"d", d.to_string()),
    VChar(c) -> text(b"c", String::of_chars([c])),
    VStr(s) -> text(b"s", s),
    VBytes(bytes) -> framed(b"b", bytes),
    VList(items) -> counted(b"l", items.map(|x: Value| encode_value(x))),
    VArray(items) -> counted(b"a", items.map(|x: Value| encode_value(x))),
    VRecord(fields) ->
      counted(b"r", fields.map(|f: Field| text(b"n", f.name).concat(encode_value(f.value)))),
    VCtor(name, args) ->
      text(b"k", ctor_name(name)).concat(counted(b"p", args.map(|x: Value| encode_value(x)))),
    VMap(entries) ->
      counted(b"m", entries.map(|e: Entry| encode_value(e.key).concat(encode_value(e.value)))),
    _ ->
      panic("a case holds a function, a handle or a credential, which no run tells from another"),
  }

/// Writes `tag`, the length of `payload`, `:`, then `payload`, so a reader learns where it ends
/// before reading it.
fn framed(tag: Bytes, payload: Bytes) -> Bytes =
  Bytes::concat_all([tag, Bytes::of_string(payload.len().to_string()), b":", payload])

fn text(tag: Bytes, s: String) -> Bytes = framed(tag, Bytes::of_string(s))

/// Writes `tag`, the number of `parts`, `:`, then each part, which marks its own end.
fn counted(tag: Bytes, parts: List<Bytes>) -> Bytes =
  Bytes::concat_all([
    tag,
    Bytes::of_string(parts.len().to_string()),
    b":",
    Bytes::concat_all(parts),
  ])

/// The `Int` value of an integer narrower than 64 bits, or `None` for a wider one.
fn narrow(ty: String, bits: U128) -> Option<Int> / {abort.raise} =
  if ty == "U8" || ty == "U16" || ty == "U32" { Some(Int::of_u128(bits)) }
  else if ty == "I8" { Some(signed(Int::of_u128(bits), 128)) }
  else if ty == "I16" { Some(signed(Int::of_u128(bits), 32768)) }
  else if ty == "I32" { Some(signed(Int::of_u128(bits), 2147483648)) }
  else { None }

/// Reads a bit pattern as signed: a pattern at or above `half` its width's range is negative.
fn signed(pattern: Int, half: Int) -> Int =
  if pattern >= half { pattern - 2 * half } else { pattern }

test "a listing labels each case and identifies it as it was built, in the table's order" {
  assert_eq(listed([3, 4], |n: Int| n.to_string()), [
    { label: "3", identity: identity(3) },
    { label: "4", identity: identity(4) },
  ]);
  assert_eq(listed([], |n: Int| n.to_string()), [])
}

test "a case is found by its identity, at its index or wherever it now is in the table" {
  assert_eq(chosen(["a", "b"], 1, identity("b")), "b");
  assert_eq(chosen(["new", "a", "b"], 1, identity("b")), "b");
  assert_eq(chosen(["b"], 4, identity("b")), "b")
}

fn missing() -> Result<String, String> =
  handle { Ok(chosen(["a"], 0, identity("b"))) } with { abort.raise(reason) -> Err(reason) }

test "choosing a case the table no longer contains raises" {
  assert_eq(missing(), Err("the table no longer holds this case"))
}

test "two values that `==` calls equal are two cases when they are built differently" {
  assert(1.5m == 1.50m);
  assert(identity(1.5m) != identity(1.50m));
  assert(identity([{ price: 2.0m }]) != identity([{ price: 2.00m }]));
  assert_eq(chosen([1.5m, 1.50m], 0, identity(1.50m)).to_string(), "1.50");
  assert_eq(identity([1.50m]), identity([1.50m]));
  // A `Map` stores a key at the scale it was given, so these build one map in two ways.
  assert(
    identity(Map::of_entries([{ key: 1.50m, value: 0 }]))
      != identity(Map::of_entries([{ key: 1.5m, value: 0 }])),
  )
}

fn kinds() -> List<Value> =
  [
    VUnit,
    VBool(true),
    VBool(false),
    VInt(3),
    VFixed("U64", 3u128),
    VFixed("I64", 3u128),
    VFixed("U128", 3u128),
    VFloat(3.0),
    VDecimal(3m),
    VDecimal(3.0m),
    VChar('3'),
    VStr("3"),
    VBytes(b"3"),
    VList([VInt(3)]),
    VArray([VInt(3)]),
    VCtor("m.Some", [VInt(3)]),
    VCtor("m.Some", []),
    VRecord([{ name: "a", value: VInt(3) }]),
    VMap([{ key: VStr("a"), value: VInt(3) }]),
    VList([VStr("ab")]),
    VList([VStr("a"), VStr("b")]),
    VList([VStr("a"), VList([VStr("b")])]),
    VList([VList([VStr("a")]), VStr("b")]),
    VList([VList([VStr("a"), VStr("b")])]),
    VList([]),
    VList([VList([])]),
    VStr(""),
    VBytes(b""),
    VRecord([{ name: "a", value: VStr("b") }, { name: "c", value: VStr("d") }]),
    VRecord([{ name: "a", value: VRecord([{ name: "c", value: VStr("d") }]) }]),
    VMap([{ key: VStr("a"), value: VStr("b") }, { key: VStr("c"), value: VStr("d") }]),
    VList([VStr("1:a"), VStr("b")]),
    VList([VStr("1:as1:b")]),
  ]

test "no two values encode to the same bytes" {
  let all = kinds().map(|v: Value| encode_value(v));
  assert_eq(
    range(0, all.len()).filter(|i: Int| all.filter(|w: Bytes| Some(w) == all.at(i)).len() != 1),
    [],
  )
}

test "a narrow integer encodes as the Int of its value, and a constructor by its bare name" {
  assert_eq(encode_value(VFixed("U8", 255u128)), encode_value(VInt(255)));
  assert_eq(encode_value(VFixed("I8", 255u128)), encode_value(VInt(-1)));
  assert_eq(encode_value(VFixed("I16", 65535u128)), encode_value(VInt(-1)));
  assert_eq(encode_value(VFixed("I32", 2147483648u128)), encode_value(VInt(-2147483648)));
  assert_eq(encode_value(VFixed("U32", 4294967295u128)), encode_value(VInt(4294967295)));
  assert_eq(
    encode_value(VCtor("orders.Shipped", [VInt(2)])),
    encode_value(VCtor("app.models.Shipped", [VInt(2)])),
  );
  assert(encode_value(VCtor("Shipped", [VInt(2)])) != encode_value(VCtor("Held", [VInt(2)])))
}

fn unwritten() -> Result<Bytes, String> =
  handle { Ok(encode_value(VList([VFn(FAnonymous)]))) } with { abort.raise(reason) -> Err(reason) }

test "encoding a value that contains a function raises" {
  assert_eq(
    unwritten(),
    Err("a case holds a function, a handle or a credential, which no run tells from another"),
  )
}
