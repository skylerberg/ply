//! Support for tests that run once for each case of a table.
//!
//! `test "{c.name}" for c: T in table() { .. }` runs one test for each element of its table. Each
//! element is a *case*. A test run identifies a case by a hash of its value, so a case is still
//! recognized as the same case after the table moves it to another position, and its earlier
//! passing result still applies. Cases that a test body can tell apart never share an identity:
//! `1.5m` and `1.50m` are two cases. So are two different values that the type's `key` treats as
//! equal. A run calls `listed` to find the cases and `chosen` to start the test for one case. A
//! module with such a test imports this module, so this module cannot contain one.

import std.value (Value, VUnit, VBool, VInt, VFloat, VDecimal, VFixed, VChar, VStr, VBytes, VList,
                  VArray, VRecord, VCtor, VMap, VFn, FAnonymous, Field, Entry, constructor_name,
                  reflect)

/// The cases a test runs over, in the order a report lists them.
pub type Table<a> = List<a>

/// A test case: the label it is reported under and an identity that selects it.
pub type Case = {
  /// The name its test is reported under, which `--filter` matches.
  label: String,
  /// The BLAKE3 hash of the case's value. Two cases built the same way have the same identity. Two
  /// values that `==` calls equal but that are represented differently, such as `1.5m` and `1.50m`,
  /// have different identities.
  identity: Bytes,
}

/// Lists each case of `table` in the table's order, labeled by `label`.
///
/// The identity ignores any `key` the type declares: it covers all of a value's fields. Raises on a
/// value that contains a function, a handle or a credential.
pub fn listed<a | e>(table: List<a>, label: (a) -> String / e) -> List<Case> / {abort.raise | e}
  where derivable(hash, a)
= table.map(|c: a| { label: label(c), identity: content_hash(c) })

/// Returns the case whose identity is `wanted`.
///
/// Returns the element at index `at` if it still has that identity, and otherwise the first
/// element with that identity anywhere in the table. Raises when no element has it.
pub fn chosen<a>(table: List<a>, at: Int, wanted: Bytes) -> a / {abort.raise}
  where derivable(hash, a)
=
  match table.at(at) {
    Some(c) -> if content_hash(c) == wanted { c } else { find_by_identity(table, wanted) },
    None -> find_by_identity(table, wanted),
  }

fn find_by_identity<a>(table: List<a>, wanted: Bytes) -> a / {abort.raise}
  where derivable(hash, a)
=
  match table.filter(|c: a| content_hash(c) == wanted) {
    [c, ..] -> c,
    [] -> panic("no value in the table has the content hash being looked up"),
  }

fn content_hash<a>(c: a) -> Bytes / {abort.raise} = encode_value(reflect(c)).blake3()

fn encode_value(v: Value) -> Bytes / {abort.raise} =
  match v {
    VUnit -> b"u",
    VBool(yes) -> if yes { b"t" } else { b"f" },
    VInt(n) -> text(b"i", n.to_string()),
    VFixed(ty, bits) -> match narrow(ty, bits) {
      Some(n) -> text(b"i", n.to_string()),
      None -> text(b"w", ty ++ " " ++ bits.to_string()),
    },
    VFloat(f) -> text(b"g", bits_of_float(f).to_string()),
    VDecimal(d) -> text(b"d", d.to_string()),
    VChar(c) -> text(b"c", String::of_chars([c])),
    VStr(s) -> text(b"s", s),
    VBytes(bytes) -> framed(b"b", bytes),
    VList(items) -> counted(b"l", items.map(|x: Value| encode_value(x))),
    VArray(items) -> counted(b"a", items.map(|x: Value| encode_value(x))),
    VRecord(fields) ->
      counted(b"r", fields.map(|f: Field| text(b"n", f.name).concat(encode_value(f.value)))),
    VCtor(name, args) ->
      text(b"k", constructor_name(name)).concat(
        counted(b"p", args.map(|x: Value| encode_value(x))),
      ),
    VMap(entries) ->
      counted(b"m", entries.map(|e: Entry| encode_value(e.key).concat(encode_value(e.value)))),
    _ ->
      panic(
        "a value that contains a function, a handle or a credential cannot be encoded, because they have no data to write",
      ),
  }

fn framed(tag: Bytes, payload: Bytes) -> Bytes =
  Bytes::concat_all([tag, Bytes::of_string(payload.len().to_string()), b":", payload])

fn text(tag: Bytes, s: String) -> Bytes = framed(tag, Bytes::of_string(s))

fn counted(tag: Bytes, parts: List<Bytes>) -> Bytes =
  Bytes::concat_all([
    tag,
    Bytes::of_string(parts.len().to_string()),
    b":",
    Bytes::concat_all(parts),
  ])

fn narrow(ty: String, bits: U128) -> Option<Int> / {abort.raise} =
  if ty == "U8" || ty == "U16" || ty == "U32" { Some(Int::of_u128(bits)) }
  else if ty == "I8" { Some(signed_from_bits(Int::of_u128(bits), 128)) }
  else if ty == "I16" { Some(signed_from_bits(Int::of_u128(bits), 32768)) }
  else if ty == "I32" { Some(signed_from_bits(Int::of_u128(bits), 2147483648)) }
  else { None }

fn signed_from_bits(pattern: Int, half: Int) -> Int =
  if pattern >= half { pattern - 2 * half } else { pattern }

test "`listed` returns a label and a content hash for each value, in the order of the input list" {
  assert_eq(listed([3, 4], |n: Int| n.to_string()), [
    { label: "3", identity: content_hash(3) },
    { label: "4", identity: content_hash(4) },
  ]);
  assert_eq(listed([], |n: Int| n.to_string()), [])
}

test "`chosen` returns the case whose content hash matches, whether it is at the given index, at a later index, or before it" {
  assert_eq(chosen(["a", "b"], 1, content_hash("b")), "b");
  assert_eq(chosen(["new", "a", "b"], 1, content_hash("b")), "b");
  assert_eq(chosen(["b"], 4, content_hash("b")), "b")
}

fn missing() -> Result<String, String> =
  handle { Ok(chosen(["a"], 0, content_hash("b"))) } with { abort.raise(reason) -> Err(reason) }

test "choosing a case the table no longer contains raises" {
  assert_eq(missing(), Err("no value in the table has the content hash being looked up"))
}

test "decimals that are equal under `==` but have different scales get different content hashes" {
  assert(1.5m == 1.50m);
  assert(content_hash(1.5m) != content_hash(1.50m));
  assert(content_hash([{ price: 2.0m }]) != content_hash([{ price: 2.00m }]));
  assert_eq(chosen([1.5m, 1.50m], 0, content_hash(1.50m)).to_string(), "1.50");
  assert_eq(content_hash([1.50m]), content_hash([1.50m]));
  assert(
    content_hash(Map::of_entries([{ key: 1.50m, value: 0 }]))
      != content_hash(Map::of_entries([{ key: 1.5m, value: 0 }])),
  )
}

fn kinds() -> List<Value> =
  [
    VUnit,
    VBool(true),
    VBool(false),
    VInt(3),
    VFixed("U64", 3u128),
    VFixed("I64", 3u128),
    VFixed("U128", 3u128),
    VFloat(3.0),
    VDecimal(3m),
    VDecimal(3.0m),
    VChar('3'),
    VStr("3"),
    VBytes(b"3"),
    VList([VInt(3)]),
    VArray([VInt(3)]),
    VCtor("m.Some", [VInt(3)]),
    VCtor("m.Some", []),
    VRecord([{ name: "a", value: VInt(3) }]),
    VMap([{ key: VStr("a"), value: VInt(3) }]),
    VList([VStr("ab")]),
    VList([VStr("a"), VStr("b")]),
    VList([VStr("a"), VList([VStr("b")])]),
    VList([VList([VStr("a")]), VStr("b")]),
    VList([VList([VStr("a"), VStr("b")])]),
    VList([]),
    VList([VList([])]),
    VStr(""),
    VBytes(b""),
    VRecord([{ name: "a", value: VStr("b") }, { name: "c", value: VStr("d") }]),
    VRecord([{ name: "a", value: VRecord([{ name: "c", value: VStr("d") }]) }]),
    VMap([{ key: VStr("a"), value: VStr("b") }, { key: VStr("c"), value: VStr("d") }]),
    VList([VStr("1:a"), VStr("b")]),
    VList([VStr("1:as1:b")]),
  ]

test "no two values encode to the same bytes" {
  let all = kinds().map(|v: Value| encode_value(v));
  assert_eq(
    range(0, all.len()).filter(|i: Int| all.filter(|w: Bytes| Some(w) == all.at(i)).len() != 1),
    [],
  )
}

test "`encode_value` encodes a `VFixed` integer as the `VInt` it wraps to, and a `VCtor` ignores the module path in its name" {
  assert_eq(encode_value(VFixed("U8", 255u128)), encode_value(VInt(255)));
  assert_eq(encode_value(VFixed("I8", 255u128)), encode_value(VInt(-1)));
  assert_eq(encode_value(VFixed("I16", 65535u128)), encode_value(VInt(-1)));
  assert_eq(encode_value(VFixed("I32", 2147483648u128)), encode_value(VInt(-2147483648)));
  assert_eq(encode_value(VFixed("U32", 4294967295u128)), encode_value(VInt(4294967295)));
  assert_eq(
    encode_value(VCtor("orders.Shipped", [VInt(2)])),
    encode_value(VCtor("app.models.Shipped", [VInt(2)])),
  );
  assert(encode_value(VCtor("Shipped", [VInt(2)])) != encode_value(VCtor("Held", [VInt(2)])))
}

fn unwritten() -> Result<Bytes, String> =
  handle { Ok(encode_value(VList([VFn(FAnonymous)]))) } with { abort.raise(reason) -> Err(reason) }

test "encoding a value that contains a function raises" {
  assert_eq(
    unwritten(),
    Err(
      "a value that contains a function, a handle or a credential cannot be encoded, because they have no data to write",
    ),
  )
}
