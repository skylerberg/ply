//! Byte strings: integers in them, hex, ASCII decimal, searching and scanning.
//!
//! What a container format, a network protocol and a hand-written parser need, little-endian and
//! big-endian.
//!
//! A read past either end answers `None` rather than raising, and so does a `u64` past what an
//! `Int` holds, so an answer is never a negative length. `Bytes::int_of_ascii_radix` is the one
//! integer parser the shipped modules share, `Bytes::int_of_ascii` is it in decimal, and
//! `std.math`'s `from_radix` is it over a `String`. Hex is `std.radix` at its lowercase alphabet.

import std.radix
import std.gen

/// The low four bytes of `n`, least significant first.
pub fn u32_le(n: Int) -> Bytes =
  Bytes::concat_all([
    byte_of_int(n & 0xFF),
    byte_of_int(n >>> 8 & 0xFF),
    byte_of_int(n >>> 16 & 0xFF),
    byte_of_int(n >>> 24 & 0xFF),
  ])

/// The low eight bytes of `n`, least significant first.
pub fn u64_le(n: Int) -> Bytes = u32_le(n).concat(u32_le(n >>> 32))

/// The four bytes at `at`, least significant first; `None` past either end.
pub fn Bytes::u32_at(b: Bytes, at: Int) -> Option<Int> =
  if at < 0 || at > b.len() - 4 { None } else { Some(Int::of_u32(b.u32_le(at))) }

/// The eight bytes at `at`, least significant first; `None` past either end, and `None` for a
/// value past what an `Int` holds, so an answer is never a negative length.
pub fn Bytes::u64_at(b: Bytes, at: Int) -> Option<Int> =
  match b.u32_at(at) {
    None -> None,
    Some(low) -> match b.u32_at(at + 4) {
      None -> None,
      Some(high) -> if high > 0x7FFF_FFFF { None } else { Some(low | high << 32) },
    },
  }

/// The `n` bytes at `at`; `None` when the string is shorter or the bounds are not a range.
pub fn Bytes::slice_at(b: Bytes, at: Int, n: Int) -> Option<Bytes> =
  if at < 0 || n < 0 || at > b.len() || n > b.len() - at { None } else { Some(b.slice(at, at + n)) }

/// Every byte xored with one byte, which is what an HMAC key pad is.
pub fn Bytes::xor_byte(b: Bytes, constant: Int) -> Bytes / {abort.raise} =
  Bytes::concat_all(range(0, b.len()).map(|i: Int| byte_of_int(b.at(i) ^ constant)))

/// Two byte strings xored, up to the shorter one's length.
pub fn Bytes::xor(a: Bytes, b: Bytes) -> Bytes =
  Bytes::concat_all(range(0, min(a.len(), b.len())).map(|i: Int| byte_of_int(a.at(i) ^ b.at(i))))

// --- Big-endian ------------------------------------------------------------------

/// The two bytes of `n`, most significant first.
pub fn u16_be(n: Int) -> Bytes =
  Bytes::concat_all([byte_of_int(n >>> 8 & 0xFF), byte_of_int(n & 0xFF)])

/// The low four bytes of `n`, most significant first.
pub fn u32_be(n: Int) -> Bytes =
  Bytes::concat_all([
    byte_of_int(n >>> 24 & 0xFF),
    byte_of_int(n >>> 16 & 0xFF),
    byte_of_int(n >>> 8 & 0xFF),
    byte_of_int(n & 0xFF),
  ])

/// The low eight bytes of `n`, most significant first.
pub fn u64_be(n: Int) -> Bytes = u32_be(n >>> 32).concat(u32_be(n))

/// A signed write is the same bytes: two's complement is the representation, so these are one
/// function with two names, for the call site to say which it meant.
pub fn i16_be(n: Int) -> Bytes = u16_be(n)

/// The same bytes as `u32_be`, for a call site writing a signed value.
pub fn i32_be(n: Int) -> Bytes = u32_be(n)

/// The same bytes as `u64_be`, for a call site writing a signed value.
pub fn i64_be(n: Int) -> Bytes = u64_be(n)

/// The two bytes at `at`, most significant first; `None` past either end.
pub fn Bytes::u16_be_at(b: Bytes, at: Int) -> Option<Int> =
  if at < 0 || at > b.len() - 2 { None } else { Some(b.at(at) << 8 | b.at(at + 1)) }

/// The four bytes at `at`, most significant first; `None` past either end.
pub fn Bytes::u32_be_at(b: Bytes, at: Int) -> Option<Int> =
  if at < 0 || at > b.len() - 4 { None }
  else { Some(b.at(at) << 24 | b.at(at + 1) << 16 | b.at(at + 2) << 8 | b.at(at + 3)) }

/// The eight bytes at `at`, most significant first; `None` past either end, and `None` for a
/// value past what an `Int` holds, so an answer is never a negative length.
pub fn Bytes::u64_be_at(b: Bytes, at: Int) -> Option<Int> =
  match b.u32_be_at(at) {
    None -> None,
    Some(high) -> match b.u32_be_at(at + 4) {
      None -> None,
      Some(low) -> if high > 0x7FFF_FFFF { None } else { Some(high << 32 | low) },
    },
  }

/// The two bytes at `at` as a signed value, most significant first: `0xFFFE` reads as -2.
pub fn Bytes::i16_be_at(b: Bytes, at: Int) -> Option<Int> =
  match b.u16_be_at(at) {
    None -> None,
    Some(v) -> Some(if v >= 0x8000 { v - 0x1_0000 } else { v }),
  }

/// The four bytes at `at` as a signed value, most significant first.
pub fn Bytes::i32_be_at(b: Bytes, at: Int) -> Option<Int> =
  match b.i16_be_at(at) {
    None -> None,
    Some(high) -> match b.u16_be_at(at + 2) { None -> None, Some(low) -> Some(high << 16 | low) },
  }

/// The eight bytes at `at` as a signed value, most significant first; every `Int` is reachable,
/// so unlike `Bytes::u64_be_at` this answers for the whole range.
pub fn Bytes::i64_be_at(b: Bytes, at: Int) -> Option<Int> =
  match b.i32_be_at(at) {
    None -> None,
    Some(high) -> match b.u32_be_at(at + 4) { None -> None, Some(low) -> Some(high << 32 | low) },
  }

// --- Tests ------------------------------------------------------------------

test "a u32 is four bytes, least significant first" {
  assert_eq(u32_le(0), b"\x00\x00\x00\x00");
  assert_eq(u32_le(1), b"\x01\x00\x00\x00");
  assert_eq(u32_le(0x0102_0304), b"\x04\x03\x02\x01");
  assert_eq(u32_le(4294967295), b"\xff\xff\xff\xff")
}

test "a u64 is eight bytes, least significant first" {
  assert_eq(u64_le(0), b"\x00\x00\x00\x00\x00\x00\x00\x00");
  assert_eq(u64_le(1), b"\x01\x00\x00\x00\x00\x00\x00\x00");
  assert_eq(u64_le(0x0102_0304_0506_0708), b"\x08\x07\x06\x05\x04\x03\x02\x01")
}

test "what is written reads back" {
  assert_eq(u32_le(123456789).u32_at(0), Some(123456789));
  assert_eq(u64_le(1099511627776).u64_at(0), Some(1099511627776));
  assert_eq(b"ab".concat(u32_le(7)).u32_at(2), Some(7));
  assert_eq(b"ab".concat(u64_le(7)).u64_at(2), Some(7))
}

test "a read past either end answers None rather than raising" {
  assert_eq(b"abc".u32_at(0), None);
  assert_eq(b"abcd".u32_at(1), None);
  assert_eq(b"abcd".u32_at(-1), None);
  assert_eq(b"".u32_at(0), None);
  assert_eq(b"abcdefg".u64_at(0), None)
}

test "a u64 past what an Int holds is refused rather than answered negative" {
  assert_eq(b"\x00\x00\x00\x00\x00\x00\x00\x80".u64_at(0), None);
  assert_eq(b"\xff\xff\xff\xff\xff\xff\xff\xff".u64_at(0), None);
  assert_eq(b"\xff\xff\xff\xff\xff\xff\xff\x7f".u64_at(0), Some(9223372036854775807))
}

test "a slice past the end answers None" {
  assert_eq(b"abcdef".slice_at(2, 3), Some(b"cde"));
  assert_eq(b"abcdef".slice_at(0, 6), Some(b"abcdef"));
  assert_eq(b"abcdef".slice_at(6, 0), Some(b""));
  assert_eq(b"abcdef".slice_at(4, 3), None);
  assert_eq(b"abcdef".slice_at(7, 0), None);
  assert_eq(b"abcdef".slice_at(-1, 2), None);
  assert_eq(b"abcdef".slice_at(2, -1), None)
}

test "a big-endian integer is most significant first" {
  assert_eq(u16_be(0x0102), b"\x01\x02");
  assert_eq(u32_be(0x0102_0304), b"\x01\x02\x03\x04");
  assert_eq(u64_be(0x0102_0304_0506_0708), b"\x01\x02\x03\x04\x05\x06\x07\x08");
  assert_eq(u32_be(1), b"\x00\x00\x00\x01");
  assert_eq(u32_be(4294967295), b"\xff\xff\xff\xff")
}

test "a negative integer writes its two's complement, most significant first" {
  assert_eq(i16_be(-2), b"\xff\xfe");
  assert_eq(i32_be(-1), b"\xff\xff\xff\xff");
  assert_eq(i32_be(-2147483648), b"\x80\x00\x00\x00");
  assert_eq(i64_be(-1), b"\xff\xff\xff\xff\xff\xff\xff\xff")
}

test "what is written big-endian reads back" {
  assert_eq(u16_be(0x0102).u16_be_at(0), Some(0x0102));
  assert_eq(u32_be(123456789).u32_be_at(0), Some(123456789));
  assert_eq(u64_be(1099511627776).u64_be_at(0), Some(1099511627776));
  assert_eq(b"ab".concat(u32_be(7)).u32_be_at(2), Some(7));
  // The four bytes a protocol prefixes a message with, which is what these are for.
  assert_eq(u32_be(16).slice_at(0, 4), Some(b"\x00\x00\x00\x10"))
}

test "a signed read carries the sign, and the whole Int range reads" {
  assert_eq(b"\xff\xfe".i16_be_at(0), Some(-2));
  assert_eq(b"\x80\x00".i16_be_at(0), Some(-32768));
  assert_eq(b"\x7f\xff".i16_be_at(0), Some(32767));
  assert_eq(b"\xff\xff\xff\xff".i32_be_at(0), Some(-1));
  assert_eq(b"\x80\x00\x00\x00".i32_be_at(0), Some(-2147483648));
  assert_eq(b"\x7f\xff\xff\xff".i32_be_at(0), Some(2147483647));
  assert_eq(b"\xff\xff\xff\xff\xff\xff\xff\xff".i64_be_at(0), Some(-1));
  assert_eq(b"\x80\x00\x00\x00\x00\x00\x00\x01".i64_be_at(0), Some(-9223372036854775807));
  assert_eq(b"\x7f\xff\xff\xff\xff\xff\xff\xff".i64_be_at(0), Some(9223372036854775807))
}

test "a big-endian read past either end answers None rather than raising" {
  assert_eq(b"a".u16_be_at(0), None);
  assert_eq(b"ab".u16_be_at(1), None);
  assert_eq(b"ab".u16_be_at(-1), None);
  assert_eq(b"abc".u32_be_at(0), None);
  assert_eq(b"abcd".u32_be_at(1), None);
  assert_eq(b"abcd".u32_be_at(-1), None);
  assert_eq(b"".u32_be_at(0), None);
  assert_eq(b"abcdefg".u64_be_at(0), None);
  assert_eq(b"abc".i32_be_at(0), None);
  assert_eq(b"abcdefg".i64_be_at(0), None)
}

test "a u64 big-endian past what an Int holds is refused rather than answered negative" {
  assert_eq(b"\x80\x00\x00\x00\x00\x00\x00\x00".u64_be_at(0), None);
  assert_eq(b"\xff\xff\xff\xff\xff\xff\xff\xff".u64_be_at(0), None);
  assert_eq(b"\x7f\xff\xff\xff\xff\xff\xff\xff".u64_be_at(0), Some(9223372036854775807))
}

test "the two byte orders read the same bytes as different numbers" {
  assert_eq(b"\x04\x03\x02\x01".u32_be_at(0), Some(0x04030201));
  assert_eq(b"\x04\x03\x02\x01".u32_at(0), Some(0x01020304))
}

test "two byte strings xor to their difference" {
  assert_eq(b"\x00\xff\x0f".xor(b"\xff\xff\xf0"), b"\xff\x00\xff");
  assert_eq(b"abc".xor(b"abc"), b"\x00\x00\x00");
  // The shorter one bounds the answer, so a pad of the wrong length cannot read past either.
  assert_eq(b"\x01\x02".xor(b"\x01"), b"\x00")
}

test "a byte xored with a constant is a key pad" {
  assert_eq(b"\x00\xff".xor_byte(0xFF), b"\xff\x00");
  assert_eq(b"".xor_byte(0x36), b"")
}

/// Whether `part` occurs in `b`.
pub fn Bytes::contains(b: Bytes, part: Bytes) -> Bool =
  match b.index_of(part) { Some(_) -> true, None -> false }

/// `b` with every occurrence of `from` replaced by `to`, left to right; an empty `from` occurs nowhere.
pub fn Bytes::replace(b: Bytes, from: Bytes, to: Bytes) -> Bytes =
  if from.len() == 0 { b } else { Bytes::join(b.split(from), to) }

/// Every piece, with `sep` between them, in one allocation over the whole list.
pub fn Bytes::join(pieces: List<Bytes>, sep: Bytes) -> Bytes =
  match pieces {
    [] -> b"",
    [first, ..rest] -> first.concat(Bytes::concat_all(rest.map(|p: Bytes| sep.concat(p)))),
  }

/// The bytes lexicographic order: the first byte that differs decides, and a prefix sorts before
/// what extends it. The same order a `Map` keyed on `Bytes` is kept in.
pub fn Bytes::compare(a: Bytes, b: Bytes) -> Ordering / {abort.raise} = compare_from(a, b, 0)

/// Whether the byte is an ASCII decimal digit.
pub fn is_digit(b: Int) -> Bool = b >= 48 && b <= 57

/// Whether the byte is an ASCII letter, of either case.
pub fn is_letter(b: Int) -> Bool = (b >= 65 && b <= 90) || (b >= 97 && b <= 122)

/// Whether the byte is a space or a tab: the blanks a line of a protocol's text holds.
pub fn is_blank(b: Int) -> Bool = b == b' ' || b == b'\t'

/// The lowercase hex digit for `v`, which is below 16.
pub fn hex_digit(v: Int) -> Bytes / {abort.raise} = radix::hex().symbols.slice(v, v + 1)

/// The value of the hex digit `c`, in either case, or `-1` for any other byte.
pub fn hex_value(c: Int) -> Int =
  if c >= 48 && c <= 57 { c - 48 }
  else if c >= 97 && c <= 102 { c - 87 }
  else if c >= 65 && c <= 70 { c - 55 }
  else { -1 }

/// The byte at `i`, or `-1` where `b` has none.
pub fn Bytes::peek(b: Bytes, i: Int) -> Int = if i < 0 || i >= b.len() { -1 } else { b.at(i) }

/// Whether `word` stands in `b` at `i`.
pub fn Bytes::starts_at(b: Bytes, i: Int, word: Bytes) -> Bool / {abort.raise} =
  i + word.len() <= b.len() && b.slice(i, i + word.len()) == word

/// From `i`, where the first byte not in `set` is: the length of `b` if there is none.
pub fn Bytes::skip(b: Bytes, i: Int, set: Bytes) -> Int / {abort.raise} =
  if i >= b.len() { b.len() } else { b.scan(i, set, b.len()) }

/// From `i`, where the first byte in `set` is: the length of `b` if there is none.
pub fn Bytes::skip_until(b: Bytes, i: Int, set: Bytes) -> Int / {abort.raise} =
  if i >= b.len() { b.len() } else { b.scan_until(i, set, b.len()) }

/// `n` in decimal ASCII: what `Bytes::int_of_ascii` reads back.
pub fn ascii_of_int(n: Int) -> Bytes = Bytes::of_string(n.to_string())

/// `s` and a NUL after it, as C and the wire protocols that borrow its strings spell one.
pub fn cstring(s: String) -> Bytes = Bytes::of_string(s).concat(b"\x00")

/// `b` repeated `n` times; a non-positive `n` is the empty bytes.
pub fn Bytes::repeat(b: Bytes, n: Int) -> Bytes =
  Bytes::concat_all(range(0, if n > 0 { n } else { 0 }).map(|_: Int| b))

fn doubled(pattern: Bytes, n: Int, left: Int) -> Bytes =
  if left <= 0 || pattern.len() >= n { pattern }
  else { doubled(pattern.concat(pattern), n, left - 1) }

/// `pattern` over and over until it is `n` bytes, the last copy cut short: what a match copies
/// that reaches into what it is itself writing. Empty for an empty pattern and for an `n` below
/// one. It doubles what it has, so it takes steps in the logarithm of `n`.
pub fn Bytes::cycle(pattern: Bytes, n: Int) -> Bytes / {abort.raise} =
  if n <= 0 || pattern.len() == 0 { b"" } else { doubled(pattern, n, 62).slice(0, n) }

/// `data` with the byte at `at` made `byte`. Raises where `data` has no such byte, or `byte` is
/// none.
pub fn Bytes::with_byte(data: Bytes, at: Int, byte: Int) -> Bytes / {abort.raise} =
  Bytes::concat_all([data.slice(0, at), byte_of_int(byte), data.slice(at + 1, data.len())])

fn pieces_from(
  data: Bytes,
  sizes: Array<Int>,
  at: Int,
  out: List<Bytes>,
  fuel: Int,
) -> List<Bytes> / {abort.raise} =
  if fuel <= 0 || at >= data.len() { out } else {
    let size = max(1, sizes.get(out.len() % sizes.len()));
    let end = if size >= data.len() - at { data.len() } else { at + size };
    pieces_from(data, sizes, end, out.push(data.slice(at, end)), fuel - 1)
  }

/// `data` cut into pieces as long as `sizes` say in turn, round and round: what a reader is
/// handed that takes its input a chunk at a time. A size below one counts as one and the last
/// piece is what is left; no sizes give one piece, and no bytes give none.
pub fn Bytes::pieces(data: Bytes, sizes: List<Int>) -> List<Bytes> / {abort.raise} =
  if data.len() == 0 { [] }
  else if sizes.len() == 0 { [data] }
  else { pieces_from(data, Array::of_list(sizes), 0, [], data.len()) }

/// How many bytes from `a` and from `b` are the same, up to `most`, given that the first `n`
/// are: how long a match is. It compares four at a time while four remain, and raises where
/// `most` bytes from either pass the end.
pub fn Bytes::agreeing(data: Bytes, a: Int, b: Int, most: Int, n: Int) -> Int / {abort.raise} =
  if n + 4 <= most && data.u32_le(a + n) == data.u32_le(b + n) { data.agreeing(a, b, most, n + 4) }
  else { match_length_bytewise(data, a, b, most, n) }

fn match_length_bytewise(data: Bytes, a: Int, b: Int, most: Int, n: Int) -> Int / {abort.raise} =
  if n < most && data.at(a + n) == data.at(b + n) { match_length_bytewise(data, a, b, most, n + 1) }
  else { n }

/// The eight bytes at `at` as the 64 bits of an `Int`, the first byte lowest, so the last byte's
/// high bit is its sign. Raises unless all eight are there.
pub fn Bytes::word_at(b: Bytes, at: Int) -> Int / {abort.raise} =
  Int::of_u32(b.u32_le(at)) | Int::of_u32(b.u32_le(at + 4)) << 32

/// The `n` bits from bit `bit`, each byte's lowest bit first, as a bit stream that fills bytes
/// from their low end reads them. `n` is at most 56, and the eight bytes from the one `bit` is in
/// must be there.
pub fn Bytes::bits_at(b: Bytes, bit: Int, n: Int) -> Int / {abort.raise} =
  b.word_at(bit >>> 3) >>> (bit & 7) & (1 << n) - 1

/// `b` from its first byte that is not zero: a big-endian number in its fewest bytes, none for zero.
pub fn Bytes::strip_leading_zeros(b: Bytes) -> Bytes / {abort.raise} =
  b.slice(b.skip(0, b"\x00"), b.len())

/// A hash as every table in the language spells it back: lowercase hex, two characters a byte. This
/// is the form a key crosses in, and the form a caller computing one has to match.
pub fn Bytes::hex_of(b: Bytes) -> String / {abort.raise} = radix::encode(radix::hex(), b)

/// The bytes a hex string names: the inverse of `Bytes::hex_of`. Raises on a text `Bytes::hex_of`
/// does not write: an odd length, or a character that is not a lowercase hex digit. `std.hex`'s
/// `decode` answers `None` for one instead.
pub fn Bytes::of_hex(text: String) -> Bytes / {abort.raise} =
  match radix::decode(radix::hex(), text) {
    Some(b) -> b,
    None -> panic("not lowercase hex, two digits a byte: " ++ text),
  }

fn compare_from(a: Bytes, b: Bytes, i: Int) -> Ordering / {abort.raise} =
  if i >= a.len() { if i >= b.len() { Equal } else { Less } }
  else if i >= b.len() { Greater } else {
    let x = a.at(i);
    let y = b.at(i);
    if x < y { Less } else if x > y { Greater } else { compare_from(a, b, i + 1) }
  }

test "compare is the lexicographic order, and a prefix sorts first" {
  assert_eq(b"".compare(b""), Equal);
  assert_eq(b"".compare(b"a"), Less);
  assert_eq(b"a".compare(b""), Greater);
  assert_eq(b"a".compare(b"a"), Equal);
  assert_eq(b"a".compare(b"b"), Less);
  assert_eq(b"b".compare(b"a"), Greater);
  assert_eq(b"a".compare(b"aa"), Less);
  assert_eq(b"ab".compare(b"aa"), Greater)
}

test "repeat repeats, and a non-positive count is the empty bytes" {
  assert_eq(b"ab".repeat(3), b"ababab");
  assert_eq(b"ab".repeat(0), b"");
  assert_eq(b"ab".repeat(0 - 2), b"");
  assert_eq(b"".repeat(5), b"");
  assert_eq(b"x".repeat(1024).len(), 1024)
}

test "leading zeros are stripped, and only leading ones" {
  assert_eq(b"\x00\x00\x01\x00".strip_leading_zeros(), b"\x01\x00");
  assert_eq(b"\x01\x00".strip_leading_zeros(), b"\x01\x00");
  assert_eq(b"\x00\x00".strip_leading_zeros(), b"");
  assert_eq(b"".strip_leading_zeros(), b"")
}

/// A decimal integer in ASCII: an optional `-`, then one or more digits, and nothing else. `None`
/// for anything else, and for a number past what an `Int` holds.
pub fn Bytes::int_of_ascii(b: Bytes) -> Option<Int> / {abort.raise} = b.int_of_ascii_radix(10)

/// An integer in ASCII in `radix`: an optional `-`, then one or more digits, each `0-9`, `a-z` or
/// `A-Z` and below the radix, and nothing else: no `+`, no prefix such as `0x`, no separator and
/// no blank. `None` for anything else, and for a number past what an `Int` holds. Raises for a
/// radix outside `2..=36`.
pub fn Bytes::int_of_ascii_radix(b: Bytes, radix: Int) -> Option<Int> / {abort.raise} =
  if radix < 2 || radix > 36 { panic("a radix is 2 to 36") } else {
    let negative = b.len() > 0 && b.at(0) == 45;
    let start = if negative { 1 } else { 0 };
    if start >= b.len() { None } else {
      match digits_below(b, start, radix, 0) {
        Some(below) -> if negative { Some(below) } else { checked_neg(below) },
        None -> None,
      }
    }
  }

/// The value of the digit `c` of a radix up to 36, in either case, or `-1` for any other byte.
pub fn digit_value(c: Int) -> Int =
  if c >= 48 && c <= 57 { c - 48 }
  else if c >= 97 && c <= 122 { c - 87 }
  else if c >= 65 && c <= 90 { c - 55 }
  else { -1 }

/// The digits from `i` on, read below zero, because the least `Int` has no positive twin.
fn digits_below(b: Bytes, i: Int, radix: Int, acc: Int) -> Option<Int> / {abort.raise} =
  if i >= b.len() { Some(acc) } else {
    let d = digit_value(b.at(i));
    if d < 0 || d >= radix { None } else {
      match checked_mul(acc, radix) {
        None -> None,
        Some(scaled) -> match checked_sub(scaled, d) {
          None -> None,
          Some(next) -> digits_below(b, i + 1, radix, next),
        },
      }
    }
  }

test "a decimal integer reads back, signed, over the whole Int range" {
  assert_eq(b"0".int_of_ascii(), Some(0));
  assert_eq(b"42".int_of_ascii(), Some(42));
  assert_eq(b"-42".int_of_ascii(), Some(0 - 42));
  assert_eq(b"007".int_of_ascii(), Some(7));
  assert_eq(b"9223372036854775807".int_of_ascii(), Some(9223372036854775807));
  assert_eq(b"-9223372036854775808".int_of_ascii(), Some(0 - 9223372036854775807 - 1))
}

test "an integer reads in any radix, in either case, and its digits are below the radix" {
  assert_eq(b"ff".int_of_ascii_radix(16), Some(255));
  assert_eq(b"-FF".int_of_ascii_radix(16), Some(0 - 255));
  assert_eq(b"-8000000000000000".int_of_ascii_radix(16), Some(0 - 9223372036854775807 - 1));
  assert_eq(b"8000000000000000".int_of_ascii_radix(16), None);
  assert_eq(b"zz".int_of_ascii_radix(36), Some(1295));
  assert_eq(b"12".int_of_ascii_radix(2), None);
  assert_eq(b"0x10".int_of_ascii_radix(16), None);
  assert_eq([47, 48, 57, 58, 64, 65, 90, 91, 96, 97, 122, 123].map(digit_value), [
    -1,
    0,
    9,
    -1,
    -1,
    10,
    35,
    -1,
    -1,
    10,
    35,
    -1,
  ]);
  assert_eq(try[abort.raise] { b"1".int_of_ascii_radix(37) }, Err("a radix is 2 to 36"))
}

test "anything but an optional minus and digits is refused, and so is a number past Int" {
  assert_eq(b"".int_of_ascii(), None);
  assert_eq(b"-".int_of_ascii(), None);
  assert_eq(b"+1".int_of_ascii(), None);
  assert_eq(b"7.5".int_of_ascii(), None);
  assert_eq(b" 7".int_of_ascii(), None);
  assert_eq(b"1_000".int_of_ascii(), None);
  assert_eq(b"0x10".int_of_ascii(), None);
  assert_eq(b"9223372036854775808".int_of_ascii(), None);
  assert_eq(b"-9223372036854775809".int_of_ascii(), None);
  assert_eq(b"99999999999999999999".int_of_ascii(), None)
}

test "peek and the scans read the end of the bytes as where they stop" {
  assert_eq(b"ab".peek(1), 98);
  assert_eq(b"ab".peek(2), -1);
  assert_eq(b"ab".peek(-1), -1);
  assert_eq(b"  x".skip(0, b" "), 2);
  assert_eq(b"   ".skip(0, b" "), 3);
  assert_eq(b"ab".skip(5, b" "), 2);
  assert_eq(b"ab,c".skip_until(0, b","), 2);
  assert_eq(b"abc".skip_until(1, b","), 3)
}

test "a pattern cycles to any length" {
  assert_eq(b"abc".cycle(8), b"abcabcab");
  assert_eq(b"abc".cycle(3), b"abc");
  assert_eq(b"abc".cycle(2), b"ab");
  assert_eq(b"x".cycle(5), b"xxxxx");
  assert_eq(b"".cycle(5), b"");
  assert_eq(b"abc".cycle(0), b"");
  assert_eq(b"abc".cycle(-1), b"");
  assert_eq(b"ab".cycle(100000), b"ab".repeat(50000))
}

test "one byte is changed, and a place the bytes do not hold is no place to change" {
  assert_eq(b"abc".with_byte(0, 120), b"xbc");
  assert_eq(b"abc".with_byte(2, 0), b"ab\x00");
  let past: Result<Bytes, String> = try[abort.raise] { b"abc".with_byte(3, 120) };
  let wide: Result<Bytes, String> = try[abort.raise] { b"abc".with_byte(1, 256) };
  assert(match past { Err(_) -> true, Ok(_) -> false });
  assert(match wide { Err(_) -> true, Ok(_) -> false })
}

test "bytes are cut into pieces of the sizes given in turn, and the pieces are the bytes" {
  assert_eq(b"abcdefgh".pieces([1, 3]), [b"a", b"bcd", b"e", b"fgh"]);
  assert_eq(b"abcde".pieces([2]), [b"ab", b"cd", b"e"]);
  assert_eq(b"abc".pieces([0, -5, 9]), [b"a", b"b", b"c"]);
  assert_eq(b"abc".pieces([9223372036854775807]), [b"abc"]);
  assert_eq(b"abc".pieces([]), [b"abc"]);
  assert_eq(b"".pieces([3]), [])
}

test "bytes cut into pieces are the pieces joined" {
  gen::check2(gen::bytes(), gen::list(gen::any_int()), |x: Bytes, sizes: List<Int>| {
    Bytes::concat_all(x.pieces(sizes)) == x
  })
}

test "two places agree for as long as their bytes do, and no longer than asked" {
  let b = b"abcdefgh-abcdefgX-abcdefgh";
  assert_eq(b.agreeing(0, 9, 17, 0), 7);
  assert_eq(b.agreeing(0, 18, 8, 0), 8);
  assert_eq(b.agreeing(0, 18, 5, 0), 5);
  assert_eq(b.agreeing(0, 18, 8, 4), 8);
  assert_eq(b.agreeing(0, 1, 8, 0), 0);
  assert_eq(b.agreeing(3, 3, 0, 0), 0)
}

test "a word is eight bytes with the first lowest, and bits are read from a byte's low end" {
  let b = b"\x01\x02\x03\x04\x05\x06\x07\x88\xff";
  assert_eq(b.word_at(0), 0x8807_0605_0403_0201);
  assert(b.word_at(0) < 0);
  assert_eq(b.word_at(1) & 0xFF, 2);
  assert_eq(b.word_at(1) >>> 56, 0xFF);
  assert_eq(b.bits_at(0, 1), 1);
  assert_eq(b.bits_at(0, 0), 0);
  assert_eq(b.bits_at(1, 8), 0);
  assert_eq(b.bits_at(4, 8), 0x20);
  assert_eq(b.bits_at(7, 56), b.word_at(0) >>> 7 & 0xFF_FFFF_FFFF_FFFF);
  let past: Result<Int, String> = try[abort.raise] { b.word_at(2) };
  assert(match past { Err(_) -> true, Ok(_) -> false })
}

test "a hex digit's value in either case, a decimal integer in ASCII, and a C string" {
  assert_eq([48, 57, 97, 102, 65, 70, 103].map(hex_value), [0, 9, 10, 15, 10, 15, -1]);
  assert_eq([32, 9, 10, 13, 11, 160, -1].map(is_blank), [
    true,
    true,
    false,
    false,
    false,
    false,
    false,
  ]);
  assert_eq(ascii_of_int(0 - 42), b"-42");
  assert_eq(ascii_of_int(9223372036854775807).int_of_ascii(), Some(9223372036854775807));
  assert_eq(cstring("ab"), b"ab\x00")
}

test "hex is lowercase, two digits a byte, and reads back" {
  assert_eq(b"\x00\x0f\xa5\xff".hex_of(), "000fa5ff");
  assert_eq(b"".hex_of(), "");
  assert_eq(Bytes::of_hex("000fa5ff"), b"\x00\x0f\xa5\xff");
  assert_eq(Bytes::of_hex(""), b"");
  assert_eq(Bytes::concat_all(range(0, 16).map(hex_digit)), b"0123456789abcdef")
}

test "a text hex_of does not write is refused whole, never read in part" {
  let read = |text: String| try[abort.raise] { Bytes::of_hex(text) };
  assert_eq(read("abc"), Err("not lowercase hex, two digits a byte: abc"));
  assert_eq(read("AB"), Err("not lowercase hex, two digits a byte: AB"));
  assert_eq(read("0g"), Err("not lowercase hex, two digits a byte: 0g"));
  assert_eq(read("ab"), Ok(b"\xab"))
}

test "contains finds a part, and replace swaps every occurrence left to right" {
  assert(b"abcabc".contains(b"ca"));
  assert(!b"abc".contains(b"x"));
  assert_eq(b"a.b.c".replace(b".", b"::"), b"a::b::c");
  assert_eq(b"aaa".replace(b"aa", b"b"), b"ba");
  assert_eq(b"abc".replace(b"", b"x"), b"abc");
  assert_eq(b"abc".replace(b"z", b"x"), b"abc")
}
