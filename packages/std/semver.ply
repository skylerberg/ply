type Same = { range: String, other: String }

const crate_same_ranges: List<Same> =
  [
    { range: "*", other: "x" },
    { range: "*", other: "X" },
    { range: "1.*", other: "1.x" },
    { range: "1.*", other: "1.X" },
    { range: "1.*", other: "1.*.*" },
    { range: "1.2.*", other: "1.2.x" },
    { range: "1.2.*", other: "1.2.X" },
  ]

test "`range` parses `{c.other}` into the same range as `{c.range}`" for c: Same in crate_same_ranges {
  assert_eq(range(c.other), range(c.range))
}

const crate_comparators: List<Same> =
  [
    { range: "1.2.3-alpha", other: "^1.2.3-alpha" },
    { range: "2.X", other: "2.*" },
    { range: "2", other: "^2" },
    { range: "2.x.x", other: "2.*" },
  ]

test "`{c.range}` is written back `{c.other}`" for c: Same in crate_comparators {
  assert_eq(render_range(range(c.range)), c.other);
  assert_eq(range(c.other), range(c.range))
}

const leading_digits: List<String> =
  ["=", ">", ">=", "<", "<=", "~", "^"].flat_map(|operator: String|
    [
      "1.2.3-1a",
      "1.2.3+1a",
      "1.2.3-01a",
      "1.2.3+01",
      "1.2.3-1+1",
      "1.2.3-1-1+1-1-1",
      "1.2.3-1a+1a",
      "1.2.3-1a-1a+1a-1a-1a",
    ].map(|form: String| operator ++ " " ++ form))

test "`range` parses `{text}` into a range with exactly one comparator, and that range renders and parses back unchanged" for text: String in leading_digits {
  let r = range(text);
  assert_eq(comparators(r).len(), 1);
  assert_eq(parse_range(render_range(r)), Ok(r))
}

test "`render_range` writes range `{c.range}` as `{c.written}`, which parses back to the same range, and `satisfies` accepts {c.all} but none of {c.none}" for c: MatchCase in rust_matched.concat(
    extra_matched,
  ) {
  let r = range(c.range);
  assert_eq(render_range(r), c.written);
  assert_eq(parse_range(c.written), Ok(r));
  assert_eq(c.all.filter(|v: String| !satisfies(version(v), r)), []);
  assert_eq(c.none.filter(|v: String| satisfies(version(v), r)), [])
}

