//! Semantic Versioning 2.0.0: versions, their precedence, and the ranges Cargo writes over them.
//!
//! A `Version` is three numbers, the identifiers of a pre-release and the identifiers of build
//! metadata. `parse` reads exactly the specification's grammar and reports where and why it
//! rejects any other text. It also limits what the specification leaves open: a number or a
//! numeric identifier too large for an `Int` is rejected. `coerce` is the separate, lenient reader.
//!
//! `==`, `compare`, `digest` and a `Map`'s keys see a version through its precedence, §11 of the
//! specification. Version numbers compare as numbers, and a pre-release is below its release.
//! Numeric identifiers compare as numbers and are below alphanumeric ones, which compare in ASCII
//! order, and a longer list of identifiers is above its prefix. Build metadata is stored in the
//! value and written by `render`, but is not part of precedence, so `1.0.0+a == 1.0.0+b`.
//! `compare_exact` and `identical` tell the two apart.
//!
//! A `Range` is Cargo's version requirement: comparators that must all hold. Each is an operator
//! (`=`, `>`, `>=`, `<`, `<=`, `~`, `^`, or none, which means `^`) before a version whose minor
//! and patch may be left out or written `*`. A comma separates two comparators, and may be left
//! out where blanks separate them, as in `>=1.0 <2.0`. npm's `||` and hyphen ranges are rejected,
//! and a bare `1.2.3` means `^1.2.3` as Cargo reads it, not npm's `=1.2.3`. A pre-release
//! satisfies a range only when a comparator names a pre-release of the same three numbers:
//! `1.3.0-rc.1` does not satisfy `^1.2`, and `1.2.3-rc.2` satisfies `>=1.2.3-rc.1`.
//!
//! With `import std.semver`, `semver"1.2.3-rc.1"` is a version checked when the program is
//! checked, and with `import std.semver_range`, `semver_range">=1.2, <2"` is a range.
//!
//! `std.pkg`'s `Version` is not this type. A manifest's version is three numbers with no
//! pre-release, compared field by field, and a dependency requests a minimum version, not a
//! range. `core` and `of_core` convert between the two.

import std.bytes
import std.laws (agrees, total_order)
import std.list
import std.option
import std.show (show)
import std.string
import std.gen

/// One dot-separated part of a pre-release: digits, read as a number, or any other text of
/// letters, digits and `-`.
pub type Identifier = | Numeric(Int) | Alphanumeric(String)

/// The parts of a version.
pub type Parts = {
  major: Int,
  minor: Int,
  patch: Int,
  /// The pre-release's identifiers; none for a release.
  pre: List<Identifier>,
  /// The build metadata's identifiers, which precedence ignores.
  build: List<String>,
}

/// A version. `of_parts`, `of_core`, `parse` and `coerce` make only versions the specification
/// allows, but the constructor accepts any `Parts`.
pub type Version = | Version(Parts)

key for Version by precedence_of

show for Version by render

fn precedence_of(v: Version) -> (Int, Int, Int, Int, List<(Int, Int, String)>) =
  match v { Version(p) -> (p.major, p.minor, p.patch, rank(p.pre), ordered(p.pre)) }

fn rank(pre: List<Identifier>) -> Int = if pre.len() == 0 { 1 } else { 0 }

fn ordered(pre: List<Identifier>) -> List<(Int, Int, String)> =
  pre.map(|i: Identifier| match i { Numeric(n) -> (0, n, ""), Alphanumeric(text) -> (1, 0, text) })

fn pre_compare(a: List<Identifier>, b: List<Identifier>) -> Ordering =
  compare((rank(a), ordered(a)), (rank(b), ordered(b)))

/// The version's parts.
pub fn parts(v: Version) -> Parts = match v { Version(p) -> p }

/// The version of these parts, or `None` when the specification does not allow it: a negative
/// number or numeric identifier, or an identifier that is empty, contains a character other than a
/// letter, a digit or `-`, or is an `Alphanumeric` of only digits.
pub fn of_parts(p: Parts) -> Option<Version> / {abort.raise} =
  if p.major < 0 || p.minor < 0 || p.patch < 0 { None }
  else if p.pre.all(is_prerelease_identifier) && p.build.all(is_identifier) { Some(Version(p)) }
  else { None }

fn is_prerelease_identifier(i: Identifier) -> Bool / {abort.raise} =
  match i {
    Numeric(n) -> n >= 0,
    Alphanumeric(text) -> is_identifier(text) && !all_digits(Bytes::of_string(text)),
  }

fn is_identifier(text: String) -> Bool / {abort.raise} = {
  let b = Bytes::of_string(text);
  b.len() > 0 && b.skip(0, identifier_bytes) == b.len()
}

fn all_digits(b: Bytes) -> Bool / {abort.raise} = b.skip(0, digit_bytes) == b.len()

/// The three numbers, which is what a `std.pkg` `Version` is.
pub fn core(v: Version) -> { major: Int, minor: Int, patch: Int } =
  match v { Version(p) -> { major: p.major, minor: p.minor, patch: p.patch } }

/// The release with these three numbers, or `None` if one is negative.
pub fn of_core(c: { major: Int, minor: Int, patch: Int }) -> Option<Version> =
  if c.major < 0 || c.minor < 0 || c.patch < 0 { None }
  else { Some(release(c.major, c.minor, c.patch)) }

fn release(major: Int, minor: Int, patch: Int) -> Version =
  Version({ major: major, minor: minor, patch: patch, pre: [], build: [] })

/// Whether the version is a pre-release.
pub fn is_prerelease(v: Version) -> Bool = match v { Version(p) -> p.pre.len() > 0 }

/// Compares two versions, and returns `Equal` only when they are written identically. It orders by
/// precedence, then by build metadata identifier by identifier, as the Rust `semver` crate does. An
/// all-digit identifier sorts before any other text and compares as a number, so `+9 < +10`. Among
/// all-digit identifiers with the same number, the one with fewer leading zeros sorts first, so `+1
/// < +01`. Other identifiers sort in ASCII order.
pub fn compare_exact(a: Version, b: Version) -> Ordering =
  match compare(a, b) {
    Equal -> compare(parts(a).build.map(build_order), parts(b).build.map(build_order)),
    apart -> apart,
  }

fn build_order(word: String) -> (Int, Int, String, Int) = {
  let chars = word.chars();
  if !chars.all(|c: Char| c >= '0' && c <= '9') { (1, 0, word, 0) } else {
    let number = chars.drop_while(|c: Char| c == '0');
    (0, number.len(), String::of_chars(number), chars.len())
  }
}

/// Whether two versions are written the same, including build metadata, which `==` ignores.
pub fn identical(a: Version, b: Version) -> Bool = compare_exact(a, b) == Equal

/// The version as the specification writes it, which `parse` reads back.
pub fn render(v: Version) -> String =
  match v {
    Version(p) ->
      dotted_core(p.major, Some(p.minor), Some(p.patch)) ++ pre_text(p.pre)
        ++ (if p.build.len() == 0 { "" } else { "+" ++ String::join(p.build, ".") }),
  }

fn dotted_core(major: Int, minor: Option<Int>, patch: Option<Int>) -> String =
  major.to_string() ++ number_text(minor) ++ number_text(patch)

fn number_text(count: Option<Int>) -> String =
  match count { None -> "", Some(n) -> "." ++ n.to_string() }

fn pre_text(pre: List<Identifier>) -> String =
  if pre.len() == 0 { "" } else { "-" ++ String::join(pre.map(identifier_text), ".") }

fn identifier_text(i: Identifier) -> String =
  match i { Numeric(n) -> n.to_string(), Alphanumeric(text) -> text }

/// The reasons the readers of this module reject a text.
pub type ErrorKind =
  /// A number is expected here, and there is no digit.
  | MissingNumber
  /// A count or a numeric identifier is written with a leading zero.
  | LeadingZero
  /// A number or a numeric identifier is too large for an `Int`.
  | TooLarge
  /// A `.` is missing after a version's first or second number.
  | MissingDot
  /// An identifier has no characters.
  | EmptyIdentifier
  | UnexpectedCharacter
  /// A `*` in place of a range's first number, which only the range `*` on its own allows.
  | WildcardFirst
  /// Something other than a `*` follows a `*`.
  | AfterWildcard
  /// A range has more than 32 comparators.
  | TooManyComparators

/// Why a text was rejected, and the index of the character the reader was at.
pub type Error = { at: Int, reason: ErrorKind }

/// The effect this module's readers raise when they reject a text.
pub effect semver {
  /// The text is not a version, or not a range.
  raise fail(e: Error)
}

/// Returns a sentence that describes `reason`, for use in a diagnostic.
pub fn reason(reason: ErrorKind) -> String =
  match reason {
    MissingNumber -> "a number goes here, such as the `1` in `1.2.3`",
    LeadingZero -> "a number cannot start with `0` unless it is exactly `0`",
    TooLarge -> "this number is too large to fit in an `Int`",
    MissingDot -> "a `.` and the next number go here",
    EmptyIdentifier -> "an identifier goes here",
    UnexpectedCharacter -> "this character cannot appear here",
    WildcardFirst -> "a `*` as the first number matches every version, so only `*` can follow it",
    AfterWildcard -> "after a `*` number, every later number must also be `*`",
    TooManyComparators -> "a range contains at most 32 comparisons, such as `>=1.0.0`",
  }

/// Parses `text` as a version. Returns an `Error` with the position and reason if `text` is not a
/// version.
pub fn parse(text: String) -> Result<Version, Error> / {abort.raise} = try { read(text) }

/// Parses `text` as a version. Raises `semver.fail` where `parse` returns `Err`.
pub fn read(text: String) -> Version / {semver.fail, abort.raise} = {
  let b = Bytes::of_string(text);
  let major = number_at(b, 0, true);
  let minor = number_at(b, past_dot(b, major.at), true);
  let patch = number_at(b, past_dot(b, minor.at), true);
  finish_version(b, major.value, minor.value, patch.value, patch.at)
}

/// Checks the text of a `semver"..."` literal. Returns the version, or a message and the offset of
/// the character where the text stops being a version.
pub fn literal(text: String) -> Result<Version, { message: String, offset: Int }> / {abort.raise} =
  match parse(text) {
    Ok(v) -> Ok(v),
    Err(rejected) -> Err({ message: reason(rejected.reason), offset: rejected.at }),
  }

/// Reads a version leniently, as a person or another tool might write one. It accepts blanks
/// around it, a leading `v`, and one to three numbers, with missing ones zero and leading zeros
/// dropped. A pre-release and build metadata follow as `parse` reads them. `None` for anything
/// else.
pub fn coerce(text: String) -> Option<Version> / {abort.raise} = {
  let read = try { read_lenient(Bytes::of_string(text.trim())) };
  match read { Ok(v) -> Some(v), Err(_) -> None }
}

fn read_lenient(b: Bytes) -> Version / {semver.fail, abort.raise} = {
  let first = b.peek(0);
  let major = number_at(b, if first == 118 || first == 86 { 1 } else { 0 }, false);
  let minor = loose_number_at(b, major.at);
  let patch = loose_number_at(b, minor.at);
  finish_version(b, major.value, minor.value, patch.value, patch.at)
}

fn fail<a>(at: Int, reason: ErrorKind) -> a / {semver.fail} =
  semver.fail({ at: at, reason: reason })

type Number = { value: Int, at: Int }

const digit_bytes: Bytes = b"0123456789"

const identifier_bytes: Bytes = b"0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz-"

const dotted_identifier_bytes: Bytes =
  b"0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz-."

fn number_at(b: Bytes, at: Int, strict: Bool) -> Number / {semver.fail, abort.raise} = {
  let end = b.skip(at, digit_bytes);
  if end <= at { fail(at, MissingNumber) }
  else if strict && end - at > 1 && b.at(at) == 48 { fail(at, LeadingZero) } else {
    match b.slice(at, end).int_of_ascii() {
      Some(value) -> { value: value, at: end },
      None -> fail(at, TooLarge),
    }
  }
}

fn loose_number_at(b: Bytes, at: Int) -> Number / {semver.fail, abort.raise} =
  if b.peek(at) == 46 { number_at(b, at + 1, false) } else { { value: 0, at: at } }

fn past_dot(b: Bytes, at: Int) -> Int / {semver.fail} =
  if b.peek(at) == 46 { at + 1 } else { fail(at, MissingDot) }

fn finish_version(
  b: Bytes,
  major: Int,
  minor: Int,
  patch: Int,
  at: Int,
) -> Version / {semver.fail, abort.raise} = {
  let tail = tail_at(b, at);
  if tail.at < b.len() { fail(tail.at, UnexpectedCharacter) }
  else { Version({ major: major, minor: minor, patch: patch, pre: tail.pre, build: tail.build }) }
}

type Tail = { pre: List<Identifier>, build: List<String>, at: Int }

fn tail_at(b: Bytes, at: Int) -> Tail / {semver.fail, abort.raise} = {
  let pre = if b.peek(at) == 45 { identifiers_at(b, at + 1) } else { { words: [], at: at } };
  let build = if b.peek(pre.at) == 43 { identifiers_at(b, pre.at + 1) }
  else { { words: [], at: pre.at } };
  {
    pre: pre.words.map(pre_identifier),
    build: build.words.map(|w: RawIdentifier| String::of_bytes(w.text)),
    at: build.at,
  }
}

type RawIdentifier = { text: Bytes, at: Int }

fn identifiers_at(
  b: Bytes,
  at: Int,
) -> { words: List<RawIdentifier>, at: Int } / {semver.fail, abort.raise} = {
  let end = b.skip(at, dotted_identifier_bytes);
  let read = if end <= at { fail(at, EmptyIdentifier) } else {
    b.slice(at, end).split(b".").fold(
      { words: [], at: at },
      |accumulator: { words: List<RawIdentifier>, at: Int }, text: Bytes|
        if text.len() == 0 { fail(accumulator.at, EmptyIdentifier) } else {
          {
            words: accumulator.words.push({ text: text, at: accumulator.at }),
            at: accumulator.at + text.len() + 1,
          }
        },
    )
  };
  { words: read.words, at: end }
}

fn pre_identifier(w: RawIdentifier) -> Identifier / {semver.fail, abort.raise} =
  if !all_digits(w.text) { Alphanumeric(String::of_bytes(w.text)) }
  else if w.text.len() > 1 && w.text.at(0) == 48 { fail(w.at, LeadingZero) }
  else { match w.text.int_of_ascii() { Some(n) -> Numeric(n), None -> fail(w.at, TooLarge) } }

/// Which number a release increments.
pub type Level = | Major | Minor | Patch

/// Returns the next release of `level` after `v`, with no pre-release and no build metadata: the
/// number at `level` increases by one and the numbers below it become zero. If `v` is a pre-release
/// of that release, returns that release, so `2.0.0-rc.1` incremented by `Major` is `2.0.0`.
pub fn increment(v: Version, level: Level) -> Version = {
  let p = parts(v);
  let pre = p.pre.len() > 0;
  match level {
    Major -> release(if pre && p.minor == 0 && p.patch == 0 { p.major } else { p.major + 1 }, 0, 0),
    Minor -> release(p.major, if pre && p.patch == 0 { p.minor } else { p.minor + 1 }, 0),
    Patch -> release(p.major, p.minor, if pre { p.patch } else { p.patch + 1 }),
  }
}

/// How a comparator compares a version with the version the comparator describes. `Wildcard` is a
/// comparator written with a `*` and no operator, such as `1.2.*`.
pub type ComparisonOperator =
  | Exactly
  | Above
  | AtLeast
  | Below
  | AtMost
  | Tilde
  | Caret
  | Wildcard

/// One comparator of a range. A `minor` or `patch` left out or written `*` is `None`; a `patch`
/// is written only after a `minor`, and a pre-release only after a `patch`.
pub type Comparator = {
  operator: ComparisonOperator,
  major: Int,
  minor: Option<Int>,
  patch: Option<Int>,
  pre: List<Identifier>,
}

/// The comparators a version must all satisfy. No comparators means `*`, which every release
/// satisfies.
pub type Range = | Range(List<Comparator>)

show for Range by render_range

/// The range's comparators.
pub fn comparators(r: Range) -> List<Comparator> = match r { Range(cs) -> cs }

/// The range as Cargo writes it, with comparators separated by `, `. `parse_range` reads it back.
pub fn render_range(r: Range) -> String =
  match r {
    Range(cs) -> if cs.len() == 0 { "*" } else { String::join(cs.map(comparator_text), ", ") },
  }

fn comparator_text(c: Comparator) -> String =
  match c.operator {
    Wildcard -> dotted_core(c.major, c.minor, c.patch) ++ (if c.patch == None { ".*" } else { "" }),
    _ -> operator_text(c.operator) ++ dotted_core(c.major, c.minor, c.patch) ++ pre_text(c.pre),
  }

fn operator_text(operator: ComparisonOperator) -> String =
  match operator {
    Exactly -> "=",
    Above -> ">",
    AtLeast -> ">=",
    Below -> "<",
    AtMost -> "<=",
    Tilde -> "~",
    Caret -> "^",
    Wildcard -> "",
  }

/// Parses `text` as a range. Returns an `Error` with the position and reason if `text` is not a
/// range.
pub fn parse_range(text: String) -> Result<Range, Error> / {abort.raise} = try { read_range(text) }

/// Parses `text` as a range. Raises `semver.fail` where `parse_range` returns `Err`. Build metadata
/// on a comparator is read and dropped.
pub fn read_range(text: String) -> Range / {semver.fail, abort.raise} = {
  let b = Bytes::of_string(text);
  let at = blanks(b, 0);
  if is_wildcard(b.peek(at)) && blanks(b, at + 1) == b.len() { Range([]) }
  else { Range(comparators_from(b, at)) }
}

/// Parses `text` as a range like `parse_range`, but returns a message and an offset on failure. The
/// range literal in `std.semver_range` uses it to check its text.
pub fn range_literal(
  text: String,
) -> Result<Range, { message: String, offset: Int }> / {abort.raise} =
  match parse_range(text) {
    Ok(r) -> Ok(r),
    Err(rejected) -> Err({ message: reason(rejected.reason), offset: rejected.at }),
  }

const max_comparators: Int = 32

fn blanks(b: Bytes, at: Int) -> Int / {abort.raise} = b.skip(at, b" ")

fn is_wildcard(c: Int) -> Bool = c == 42 || c == 120 || c == 88

fn comparators_from(b: Bytes, at: Int) -> List<Comparator> / {semver.fail, abort.raise} =
  iterate({ at: at, read: [] }, max_comparators + 1, |s: { at: Int, read: List<Comparator> }|
    if s.read.len() == max_comparators { fail(s.at, TooManyComparators) } else {
      let c = comparator_at(b, s.at);
      let after = blanks(b, c.at);
      let read = s.read.push(c.comparator);
      if after == b.len() { Stop(read) }
      else if b.peek(after) == 44 { Continue({ at: blanks(b, after + 1), read: read }) }
      else if after > c.at { Continue({ at: after, read: read }) }
      else { fail(after, UnexpectedCharacter) }
    })

type Operator = { operator: ComparisonOperator, written: Bool, at: Int }

fn operator_at(b: Bytes, at: Int) -> Operator = {
  let c = b.peek(at);
  let equals = b.peek(at + 1) == 61;
  if c == 61 { { operator: Exactly, written: true, at: at + 1 } }
  else if c == 62 && equals { { operator: AtLeast, written: true, at: at + 2 } }
  else if c == 62 { { operator: Above, written: true, at: at + 1 } }
  else if c == 60 && equals { { operator: AtMost, written: true, at: at + 2 } }
  else if c == 60 { { operator: Below, written: true, at: at + 1 } }
  else if c == 126 { { operator: Tilde, written: true, at: at + 1 } }
  else if c == 94 { { operator: Caret, written: true, at: at + 1 } }
  else { { operator: Caret, written: false, at: at } }
}

type PartialNumber = { count: Option<Int>, wildcard: Bool, at: Int }

fn partial_number_at(
  b: Bytes,
  at: Int,
  after_wild: Bool,
) -> PartialNumber / {semver.fail, abort.raise} =
  if b.peek(at) != 46 { { count: None, wildcard: false, at: at } }
  else if is_wildcard(b.peek(at + 1)) { { count: None, wildcard: true, at: at + 2 } }
  else if after_wild { fail(at + 1, AfterWildcard) } else {
    let n = number_at(b, at + 1, true);
    { count: Some(n.value), wildcard: false, at: n.at }
  }

fn comparator_at(
  b: Bytes,
  from: Int,
) -> { comparator: Comparator, at: Int } / {semver.fail, abort.raise} = {
  let prefix = operator_at(b, from);
  let at = blanks(b, prefix.at);
  if is_wildcard(b.peek(at)) { fail(at, WildcardFirst) } else {
    let major = number_at(b, at, true);
    let minor = partial_number_at(b, major.at, false);
    let patch = partial_number_at(b, minor.at, minor.wildcard);
    let tail = if patch.count == None { { pre: [], build: [], at: patch.at } }
    else { tail_at(b, patch.at) };
    {
      comparator: {
        operator: if !prefix.written && (minor.wildcard || patch.wildcard) { Wildcard }
        else { prefix.operator },
        major: major.value,
        minor: minor.count,
        patch: patch.count,
        pre: tail.pre,
      },
      at: tail.at,
    }
  }
}

/// Returns whether `v` satisfies every comparator of `r`. If `v` is a pre-release, `r` must also
/// contain a comparator with a pre-release and the same major, minor and patch numbers as `v`.
pub fn satisfies(v: Version, r: Range) -> Bool = {
  let p = parts(v);
  let cs = comparators(r);
  cs.all(|c: Comparator| comparator_satisfies(c, p))
    && (p.pre.len() == 0 || cs.any(|c: Comparator| has_pre_release(c, p)))
}

/// The greatest of `versions` that satisfies `r`. When several share that precedence and differ
/// only in build metadata, the first of them.
pub fn max_satisfying(versions: List<Version>, r: Range) -> Option<Version> =
  best_satisfying(versions, r, Greater)

/// The least of `versions` that satisfies `r`, and the first of them when several share that
/// precedence.
pub fn min_satisfying(versions: List<Version>, r: Range) -> Option<Version> =
  best_satisfying(versions, r, Less)

fn best_satisfying(versions: List<Version>, r: Range, better: Ordering) -> Option<Version> =
  versions.fold(None, |best: Option<Version>, v: Version|
    if !satisfies(v, r) { best } else {
      match best {
        None -> Some(v),
        Some(current_best) -> if compare(v, current_best) == better { Some(v) } else { best },
      }
    })

fn has_pre_release(c: Comparator, v: Parts) -> Bool =
  c.major == v.major && c.minor == Some(v.minor) && c.patch == Some(v.patch) && c.pre.len() > 0

fn comparator_satisfies(c: Comparator, v: Parts) -> Bool =
  match c.operator {
    Exactly | Wildcard -> at_version(c, v),
    Above -> compare_with(c, v) == Greater,
    AtLeast -> at_version(c, v) || compare_with(c, v) == Greater,
    Below -> compare_with(c, v) == Less,
    AtMost -> at_version(c, v) || compare_with(c, v) == Less,
    Tilde -> tilde(c, v),
    Caret -> caret(c, v),
  }

fn matches_number(place: Option<Int>, count: Int) -> Bool =
  match place { None -> true, Some(n) -> n == count }

fn at_version(c: Comparator, v: Parts) -> Bool =
  v.major == c.major && matches_number(c.minor, v.minor) && matches_number(c.patch, v.patch)
    && v.pre == c.pre

fn compare_with(c: Comparator, v: Parts) -> Ordering =
  if v.major != c.major { compare(v.major, c.major) } else {
    match ((c.minor, c.patch)) {
      (Some(minor), _) if v.minor != minor -> compare(v.minor, minor),
      (Some(_), Some(patch)) if v.patch != patch -> compare(v.patch, patch),
      (Some(_), Some(_)) -> pre_compare(v.pre, c.pre),
      _ -> Equal,
    }
  }

fn tilde(c: Comparator, v: Parts) -> Bool =
  v.major == c.major && matches_number(c.minor, v.minor)
    && (match c.patch {
      Some(patch) if v.patch != patch -> v.patch > patch,
      _ -> pre_compare(v.pre, c.pre) != Less,
    })

fn caret(c: Comparator, v: Parts) -> Bool =
  if v.major != c.major { false } else {
    match ((c.minor, c.patch)) {
      (None, _) -> true,
      (Some(minor), None) -> if c.major > 0 { v.minor >= minor } else { v.minor == minor },
      (Some(minor), Some(patch)) -> if c.major > 0 && v.minor != minor { v.minor > minor }
      else if c.major == 0 && (v.minor != minor || (minor == 0 && v.patch != patch)) { false }
      else if v.patch != patch { v.patch > patch }
      else { pre_compare(v.pre, c.pre) != Less },
    }
  }

fn version(text: String) -> Version / {abort.raise} =
  match parse(text) {
    Ok(v) -> v,
    Err(_) -> panic("`" ++ text ++ "` is not a valid version, but this test needs it to parse"),
  }

fn range(text: String) -> Range / {abort.raise} =
  match parse_range(text) {
    Ok(r) -> r,
    Err(_) -> panic("`" ++ text ++ "` is not a valid range, but this test needs it to parse"),
  }

