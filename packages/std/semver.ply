  assert_eq(option_text(coerce(text)), "")
}

type ComparisonCase = { left: String, operator: String, right: String, expected: Bool }

const crate_compared: List<ComparisonCase> =
  [
    { left: "1.2.3", operator: "==", right: "1.2.3", expected: true },
    { left: "1.2.3-alpha1", operator: "==", right: "1.2.3-alpha1", expected: true },
    { left: "1.2.3+build.42", operator: "==", right: "1.2.3+build.42", expected: true },
    { left: "1.2.3-alpha1+42", operator: "==", right: "1.2.3-alpha1+42", expected: true },
    { left: "0.0.0", operator: "!=", right: "0.0.1", expected: true },
    { left: "0.0.0", operator: "!=", right: "0.1.0", expected: true },
    { left: "0.0.0", operator: "!=", right: "1.0.0", expected: true },
    { left: "1.2.3-alpha", operator: "!=", right: "1.2.3-beta", expected: true },
    { left: "1.2.3+23", operator: "!=", right: "1.2.3+42", expected: true },
    { left: "0.0.0", operator: "<", right: "1.2.3-alpha2", expected: true },
    { left: "1.0.0", operator: "<", right: "1.2.3-alpha2", expected: true },
    { left: "1.2.0", operator: "<", right: "1.2.3-alpha2", expected: true },
    { left: "1.2.3-alpha1", operator: "<", right: "1.2.3", expected: true },
    { left: "1.2.3-alpha1", operator: "<", right: "1.2.3-alpha2", expected: true },
    { left: "1.2.3-alpha2", operator: "<", right: "1.2.3-alpha2", expected: false },
    { left: "1.2.3+23", operator: "<", right: "1.2.3+42", expected: true },
    { left: "0.0.0", operator: "<=", right: "1.2.3-alpha2", expected: true },
    { left: "1.0.0", operator: "<=", right: "1.2.3-alpha2", expected: true },
    { left: "1.2.0", operator: "<=", right: "1.2.3-alpha2", expected: true },
    { left: "1.2.3-alpha1", operator: "<=", right: "1.2.3-alpha2", expected: true },
    { left: "1.2.3-alpha2", operator: "<=", right: "1.2.3-alpha2", expected: true },
    { left: "1.2.3+23", operator: "<=", right: "1.2.3+42", expected: true },
    { left: "1.2.3-alpha2", operator: ">", right: "0.0.0", expected: true },
    { left: "1.2.3-alpha2", operator: ">", right: "1.0.0", expected: true },
    { left: "1.2.3-alpha2", operator: ">", right: "1.2.0", expected: true },
    { left: "1.2.3-alpha2", operator: ">", right: "1.2.3-alpha1", expected: true },
    { left: "1.2.3", operator: ">", right: "1.2.3-alpha2", expected: true },
    { left: "1.2.3-alpha2", operator: ">", right: "1.2.3-alpha2", expected: false },
    { left: "1.2.3+23", operator: ">", right: "1.2.3+42", expected: false },
    { left: "1.2.3-alpha2", operator: ">=", right: "0.0.0", expected: true },
    { left: "1.2.3-alpha2", operator: ">=", right: "1.0.0", expected: true },
    { left: "1.2.3-alpha2", operator: ">=", right: "1.2.0", expected: true },
    { left: "1.2.3-alpha2", operator: ">=", right: "1.2.3-alpha1", expected: true },
    { left: "1.2.3-alpha2", operator: ">=", right: "1.2.3-alpha2", expected: true },
    { left: "1.2.3+23", operator: ">=", right: "1.2.3+42", expected: false },
  ]

test "`compare_exact` makes the comparison {c.left} {c.operator} {c.right} come out as {c.expected}, with build metadata counted" for c: ComparisonCase in crate_compared {
  let order = compare_exact(version(c.left), version(c.right));
  assert_eq(
    if c.operator == "==" { order == Equal }
    else if c.operator == "!=" { order != Equal }
    else if c.operator == "<" { order == Less }
    else if c.operator == "<=" { order != Greater }
    else if c.operator == ">" { order == Greater }
    else { order != Less },
    c.expected,
  );
  assert_eq(identical(version(c.left), version(c.right)), order == Equal)
}

test "build metadata orders as the Rust `semver` crate's source orders it" {
  let builds = ["0", "00", "1", "01", "001", "2", "02", "002", "10"];
  let versions = builds.map(|b: String| version("1.0.0+" ++ b));
  assert(
    steps(builds).all(|s: Step|
      compare_exact(version("1.0.0+" ++ s.lower), version("1.0.0+" ++ s.higher)) == Less),
  );
  assert(versions.all(|v: Version| v == version("1.0.0")));
  assert_eq(compare_exact(version("1.0.0+9"), version("1.0.0+10")), Less);
  assert_eq(compare_exact(version("1.0.0+10"), version("1.0.0+a")), Less);
  assert_eq(compare_exact(version("1.0.0+a"), version("1.0.0+a.0")), Less);
  assert_eq(compare_exact(version("1.0.0+B"), version("1.0.0+a")), Less)
}

test "build metadata is stored and written, and is not part of precedence" {
  let a = version("1.0.0-rc.1+linux.x86");
  let b = version("1.0.0-rc.1+darwin");
  assert(a == b);
  assert_eq(compare(a, b), Equal);
  assert_eq(digest(a), digest(b));
  assert_eq(#{a: (), b: (), version("1.0.0-rc.1"): ()}.len(), 1);
  assert_eq(parts(a).build, ["linux", "x86"]);
  assert_eq(render(a), "1.0.0-rc.1+linux.x86");
  assert(!identical(a, b));
  assert(identical(a, version("1.0.0-rc.1+linux.x86")));
  assert_eq(compare_exact(a, b), Greater);
  assert_eq(compare_exact(version("1.0.0"), version("1.0.0+0")), Less);
  assert_eq(f"{a}", "1.0.0-rc.1+linux.x86")
}

test "a version is made only of parts the specification allows" {
  let p: Parts = {
    major: 1,
    minor: 2,
    patch: 3,
    pre: [Alphanumeric("rc"), Numeric(1)],
    build: ["001"],
  };
  assert_eq(option_text(of_parts(p)), "1.2.3-rc.1+001");
  assert_eq(of_parts({ ..p, minor: -1 }), None);
  assert_eq(of_parts({ ..p, pre: [Numeric(-1)] }), None);
  assert_eq(of_parts({ ..p, pre: [Alphanumeric("")] }), None);
  assert_eq(of_parts({ ..p, pre: [Alphanumeric("007")] }), None);
  assert_eq(of_parts({ ..p, pre: [Alphanumeric("a.b")] }), None);
  assert_eq(of_parts({ ..p, build: ["a+b"] }), None);
  assert_eq(of_parts({ ..p, build: [""] }), None);
  assert_eq(core(version("4.5.6-rc.1+x")), { major: 4, minor: 5, patch: 6 });
  assert_eq(option_text(of_core({ major: 4, minor: 5, patch: 6 })), "4.5.6");
  assert_eq(of_core({ major: 4, minor: 5, patch: -6 }), None);
  assert(is_prerelease(version("1.0.0-0")));
  assert(!is_prerelease(version("1.0.0+0")))
}

fn option_text(v: Option<Version>) -> String =
  match v { Some(version_of_seed) -> render(version_of_seed), None -> "" }

type Lenient = { text: String, version: String }

const coerce_cases: List<Lenient> =
  [
    { text: "1.2.3", version: "1.2.3" },
    { text: "v1.2.3", version: "1.2.3" },
    { text: "V1.2", version: "1.2.0" },
    { text: "v1", version: "1.0.0" },
    { text: "  1.2  ", version: "1.2.0" },
    { text: "01.002.0003", version: "1.2.3" },
    { text: "1.2-rc.1", version: "1.2.0-rc.1" },
    { text: "2+build.5", version: "2.0.0+build.5" },
    { text: "v1.2.3-beta+exp.sha.5114f85", version: "1.2.3-beta+exp.sha.5114f85" },
    { text: "", version: "" },
    { text: "v", version: "" },
    { text: "vv1", version: "" },
    { text: "1.2.3.4", version: "" },
    { text: "1..2", version: "" },
    { text: "1.2.3-01", version: "" },
    { text: "one", version: "" },
    { text: "1 . 2", version: "" },
  ]

test "`{c.text}` read leniently is `{c.version}`" for c: Lenient in coerce_cases {
  assert_eq(option_text(coerce(c.text)), c.version)
}

type IncrementCase = { from: String, level: Level, to: String }

const node_increments: List<IncrementCase> =
  [
    { from: "1.2.3", level: Major, to: "2.0.0" },
    { from: "1.2.3", level: Minor, to: "1.3.0" },
    { from: "1.2.3", level: Patch, to: "1.2.4" },
    { from: "1.2.3-tag", level: Major, to: "2.0.0" },
    { from: "1.2.0-0", level: Patch, to: "1.2.0" },
    { from: "1.2.3-4", level: Major, to: "2.0.0" },
    { from: "1.2.3-4", level: Minor, to: "1.3.0" },
    { from: "1.2.3-4", level: Patch, to: "1.2.3" },
    { from: "1.2.3-alpha.0.beta", level: Major, to: "2.0.0" },
    { from: "1.2.3-alpha.0.beta", level: Minor, to: "1.3.0" },
    { from: "1.2.3-alpha.0.beta", level: Patch, to: "1.2.3" },
    { from: "1.2.0-1", level: Minor, to: "1.2.0" },
    { from: "1.0.0-1", level: Major, to: "1.0.0" },
  ]

const extra_increments: List<IncrementCase> =
  [
    { from: "0.0.0", level: Patch, to: "0.0.1" },
    { from: "1.2.3+build", level: Patch, to: "1.2.4" },
    { from: "1.0.0-rc.1+build.4", level: Patch, to: "1.0.0" },
  ]

test "{c.from} incremented is {c.to}" for c: IncrementCase in node_increments.concat(
    extra_increments,
  ) { assert_eq(render(increment(version(c.from), c.level)), c.to) }

