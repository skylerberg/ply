const own_versions: List<String> =
  [
    "9223372036854775807.0.0-9223372036854775807",
    "90071992547409910.0.0",
    "0.90071992547409910.0",
    "0.0.90071992547409910",
  ]

test "{text} is a version, and is written as it was read" for text: String in spec_versions.concat(
    own_versions,
  ) {
  match parse(text) {
    Ok(v) -> {
      assert_eq(render(v), text);
      assert_eq(of_parts(parts(v)), Some(v));
      assert(identical(v, version(text)))
    },
    Err(rejected) -> panic(reason(rejected.reason) ++ " at " ++ rejected.at.to_string()),
  }
}

