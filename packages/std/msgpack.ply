//! MessagePack, a compact binary format for the same data JSON carries.
//!
//! This module supports the subset a program needs: nil, booleans, integers of every width,
//! float64, UTF-8 text, binary, arrays and maps. The writer emits the shortest signed encoding that
//! fits a value and never a `uint`, so each value has exactly one encoding. The reader also accepts
//! the `uint` widths, because other writers use them.
//!
//! The reader is total. It rejects, reporting why and at which byte: a truncated input, a length
//! that claims more bytes than remain, a value nested deeper than 64 levels, a `float32`, an
//! extension type, the reserved `0xc1`, a `uint64` too large for an `Int`, text that is not UTF-8,
//! and bytes after the one value. Every length is checked against the remaining bytes before the
//! reader visits its elements, so a hostile header cannot make it loop. `msgpack_decode` returns an
//! error as an `Err`, and `msgpack_read` raises it.

import std.bytes (i16_be, i32_be, i64_be, u16_be, u32_be)

/// A MessagePack value of the subset this module reads and writes.
pub type Value =
  | Nil
  | Boolean(Bool)
  | Int(Int)
  | Float(Float)
  | Text(String)
  | Binary(Bytes)
  | Array(List<Value>)
  | Map(List<Entry>)

/// One key and value of a map. A map is an ordered list of entries, since a key may be any value.
pub type Entry = { key: Value, value: Value }

/// A map entry.
pub fn entry(key: Value, value: Value) -> Entry = { key: key, value: value }

/// Returns the MessagePack encoding of `v`, using the shortest form for each integer and each
/// length. Raises when a length does not fit in 32 bits.
pub fn msgpack_encode(v: Value) -> Bytes / {abort.raise} =
  match v {
    Nil -> byte_of_int(0xC0),
    Boolean(b) -> if b { byte_of_int(0xC3) } else { byte_of_int(0xC2) },
    Int(n) -> int_bytes(n),
    Float(f) -> byte_of_int(0xCB).concat(i64_be(bits_of_float(f))),
    Text(s) -> with_head(text_head(Bytes::of_string(s).len()), Bytes::of_string(s)),
    Binary(b) -> with_head(binary_head(b.len()), b),
    Array(xs) -> with_head(array_head(xs.len()), Bytes::concat_all(xs.map(msgpack_encode))),
    Map(kvs) ->
      with_head(
        map_head(kvs.len()),
        Bytes::concat_all(
          kvs.map(|f: Entry| msgpack_encode(f.key).concat(msgpack_encode(f.value))),
        ),
      ),
  }

fn with_head(head: Bytes, body: Bytes) -> Bytes = head.concat(body)

fn int_bytes(n: Int) -> Bytes =
  if n >= 0 && n <= 127 { byte_of_int(n) }
  else if n >= 0 - 32 && n < 0 { byte_of_int(0xE0 | n & 0x1F) }
  else if n >= 0 - 128 && n <= 127 { byte_of_int(0xD0).concat(byte_of_int(n & 0xFF)) }
  else if n >= 0 - 32768 && n <= 32767 { byte_of_int(0xD1).concat(i16_be(n)) }
  else if n >= 0 - 2147483648 && n <= 2147483647 { byte_of_int(0xD2).concat(i32_be(n)) }
  else { byte_of_int(0xD3).concat(i64_be(n)) }

fn text_head(n: Int) -> Bytes / {abort.raise} =
  if n <= 31 { byte_of_int(0xA0 | n) }
  else if n <= 255 { byte_of_int(0xD9).concat(byte_of_int(n)) }
  else if n <= 65535 { byte_of_int(0xDA).concat(u16_be(n)) }
  else { byte_of_int(0xDB).concat(u32_be(n)) }

fn binary_head(n: Int) -> Bytes / {abort.raise} =
  if n <= 255 { byte_of_int(0xC4).concat(byte_of_int(n)) }
  else if n <= 65535 { byte_of_int(0xC5).concat(u16_be(n)) }
  else { byte_of_int(0xC6).concat(u32_be(n)) }

fn array_head(n: Int) -> Bytes / {abort.raise} =
  if n <= 15 { byte_of_int(0x90 | n) }
  else if n <= 65535 { byte_of_int(0xDC).concat(u16_be(n)) }
  else { byte_of_int(0xDD).concat(u32_be(n)) }

fn map_head(n: Int) -> Bytes / {abort.raise} =
  if n <= 15 { byte_of_int(0x80 | n) }
  else if n <= 65535 { byte_of_int(0xDE).concat(u16_be(n)) }
  else { byte_of_int(0xDF).concat(u32_be(n)) }

/// Why the reader rejected its input. `Truncated` is an input that ends before a value does.
/// `TooDeep` is a value nested deeper than 64 levels. `Unsupported` is a tag outside this subset,
/// and carries the tag. `TooWide` is a `uint64` too large for an `Int`. `NotUtf8` is text that is
/// not UTF-8. `Trailing` is bytes after the one value.
pub type ErrorKind = | Truncated | TooDeep | Unsupported(Int) | TooWide | NotUtf8 | Trailing

/// A decoding error, and the offset of the byte the reader was at.
pub type Error = { at: Int, reason: ErrorKind }

/// The effect this module's reader raises when it rejects its input.
pub effect msgpack {
  /// The input is not exactly one value of this subset.
  raise fail(e: Error)
}

/// Decodes `data`, or returns why it is not exactly one value of this subset.
pub fn msgpack_decode(data: Bytes) -> Result<Value, Error> / {abort.raise} =
  try { msgpack_read(data) }

/// Decodes `data`, raising `msgpack.fail` where `msgpack_decode` returns `Err`.
pub fn msgpack_read(data: Bytes) -> Value / {msgpack.fail, abort.raise} = {
  let read = read_at(data, 0, max_depth());
  if read.at == data.len() { read.value } else { fail(read.at, Trailing) }
}

fn fail<a>(at: Int, reason: ErrorKind) -> a / {msgpack.fail} =
  msgpack.fail({ at: at, reason: reason })

/// A decoded value, and the offset just after it.
pub type ReadResult = { value: Value, at: Int }

fn max_depth() -> Int = 64

fn read_at(data: Bytes, at: Int, depth_left: Int) -> ReadResult / {msgpack.fail, abort.raise} =
  if depth_left < 0 { fail(at, TooDeep) }
  else if at < 0 || at >= data.len() { fail(at, Truncated) } else {
    let tag = data.at(at);
    if tag <= 0x7F { { value: Int(tag), at: at + 1 } }
    else if tag >= 0xE0 { { value: Int(tag - 256), at: at + 1 } }
    else if tag >= 0x80 && tag <= 0x8F { read_map(data, at + 1, tag & 0x0F, depth_left - 1) }
    else if tag >= 0x90 && tag <= 0x9F { read_array(data, at + 1, tag & 0x0F, depth_left - 1) }
    else if tag >= 0xA0 && tag <= 0xBF { read_text(data, at + 1, tag & 0x1F) }
    else { read_tagged(data, at, tag, depth_left - 1) }
  }

fn read_tagged(
  data: Bytes,
  at: Int,
  tag: Int,
  depth_left: Int,
) -> ReadResult / {msgpack.fail, abort.raise} =
  match tag {
    0xC0 -> { value: Nil, at: at + 1 },
    0xC2 -> { value: Boolean(false), at: at + 1 },
    0xC3 -> { value: Boolean(true), at: at + 1 },
    0xC4 -> read_length(data, at + 1, 1, BinaryKind, depth_left),
    0xC5 -> read_length(data, at + 1, 2, BinaryKind, depth_left),
    0xC6 -> read_length(data, at + 1, 4, BinaryKind, depth_left),
    0xCB -> read_float(data, at),
    0xCC -> read_unsigned(data, at, 1, 2),
    0xCD -> read_unsigned(data, at, 2, 3),
    0xCE -> read_unsigned(data, at, 4, 5),
    0xCF -> read_uint64(data, at),
    0xD0 -> read_signed(data, at, 1, 0x80, 256),
    0xD1 -> read_signed(data, at, 2, 0x8000, 0x1_0000),
    0xD2 -> read_signed(data, at, 4, 0x8000_0000, 0x1_0000_0000),
    0xD3 -> read_int64(data, at),
    0xD9 -> read_length(data, at + 1, 1, TextKind, depth_left),
    0xDA -> read_length(data, at + 1, 2, TextKind, depth_left),
    0xDB -> read_length(data, at + 1, 4, TextKind, depth_left),
    0xDC -> read_length(data, at + 1, 2, ArrayKind, depth_left),
    0xDD -> read_length(data, at + 1, 4, ArrayKind, depth_left),
    0xDE -> read_length(data, at + 1, 2, MapKind, depth_left),
    0xDF -> read_length(data, at + 1, 4, MapKind, depth_left),
    _ -> fail(at, Unsupported(tag)),
  }

fn read_float(data: Bytes, at: Int) -> ReadResult / {msgpack.fail} =
  { value: Float(Float::of_bits(big_endian_int(read_bytes(data, at + 1, 8)))), at: at + 9 }

fn read_int64(data: Bytes, at: Int) -> ReadResult / {msgpack.fail} =
  { value: Int(big_endian_int(read_bytes(data, at + 1, 8))), at: at + 9 }

fn read_uint64(data: Bytes, at: Int) -> ReadResult / {msgpack.fail, abort.raise} = {
  let eight = read_bytes(data, at + 1, 8);
  if eight.at(0) & 0x80 != 0 { fail(at, TooWide) }
  else { { value: Int(big_endian_int(eight)), at: at + 9 } }
}

fn read_signed(
  data: Bytes,
  at: Int,
  width: Int,
  high: Int,
  span: Int,
) -> ReadResult / {msgpack.fail} =
  {
    value: Int(sign_extend(big_endian_int(read_bytes(data, at + 1, width)), high, span)),
    at: at + 1 + width,
  }

type PayloadKind = | BinaryKind | TextKind | ArrayKind | MapKind

fn read_length(
  data: Bytes,
  at: Int,
  width: Int,
  kind: PayloadKind,
  depth_left: Int,
) -> ReadResult / {msgpack.fail, abort.raise} = {
  let n = big_endian_int(read_bytes(data, at, width));
  let from = at + width;
  if n < 0 || n > data.len() - from { fail(from, Truncated) }
  else if kind == BinaryKind { { value: Binary(read_bytes(data, from, n)), at: from + n } }
  else if kind == TextKind { read_text(data, from, n) }
  else if kind == ArrayKind { read_array(data, from, n, depth_left) }
  else { read_map(data, from, n, depth_left) }
}

fn read_unsigned(data: Bytes, at: Int, width: Int, after: Int) -> ReadResult / {msgpack.fail} =
  { value: Int(big_endian_int(read_bytes(data, at + 1, width))), at: at + after }

fn read_bytes(data: Bytes, at: Int, n: Int) -> Bytes / {msgpack.fail} =
  if at < 0 || n < 0 || at + n > data.len() { fail(at, Truncated) } else { data.slice(at, at + n) }

fn read_text(data: Bytes, at: Int, n: Int) -> ReadResult / {msgpack.fail, abort.raise} = {
  let payload = read_bytes(data, at, n);
  if payload.is_utf8() { { value: Text(String::of_bytes(payload)), at: at + n } }
  else { fail(at, NotUtf8) }
}

fn read_array(
  data: Bytes,
  at: Int,
  n: Int,
  depth_left: Int,
) -> ReadResult / {msgpack.fail, abort.raise} = {
  let done = read_values(data, at, n, depth_left, []);
  { value: Array(done.items), at: done.at }
}

fn read_values(
  data: Bytes,
  at: Int,
  n: Int,
  depth_left: Int,
  accumulator: List<Value>,
) -> { items: List<Value>, at: Int } / {msgpack.fail, abort.raise} =
  if n <= 0 { { items: accumulator, at: at } } else {
    let read = read_at(data, at, depth_left);
    read_values(data, read.at, n - 1, depth_left, accumulator.push(read.value))
  }

fn read_map(
  data: Bytes,
  at: Int,
  n: Int,
  depth_left: Int,
) -> ReadResult / {msgpack.fail, abort.raise} = {
  let done = read_entries(data, at, n, depth_left, []);
  { value: Map(done.fields), at: done.at }
}

fn read_entries(
  data: Bytes,
  at: Int,
  n: Int,
  depth_left: Int,
  accumulator: List<Entry>,
) -> { fields: List<Entry>, at: Int } / {msgpack.fail, abort.raise} =
  if n <= 0 { { fields: accumulator, at: at } } else {
    let key = read_at(data, at, depth_left);
    let value = read_at(data, key.at, depth_left);
    read_entries(
      data,
      value.at,
      n - 1,
      depth_left,
      accumulator.push({ key: key.value, value: value.value }),
    )
  }

fn big_endian_int(data: Bytes) -> Int =
  range(0, data.len()).fold(0, |accumulator: Int, i: Int| accumulator << 8 | data.at(i))

fn sign_extend(n: Int, high: Int, span: Int) -> Int = if n >= high { n - span } else { n }

test "`msgpack_encode` writes each integer in the fewest bytes its value allows, and `msgpack_decode` returns the original values for integers, floats, text and binary" {
  assert_eq(msgpack_encode(Nil), Bytes::of_hex("c0"));
  assert_eq(msgpack_encode(Boolean(false)), Bytes::of_hex("c2"));
  assert_eq(msgpack_encode(Boolean(true)), Bytes::of_hex("c3"));
  assert_eq(msgpack_encode(Int(0)), Bytes::of_hex("00"));
  assert_eq(msgpack_encode(Int(127)), Bytes::of_hex("7f"));
  assert_eq(msgpack_encode(Int(-1)), Bytes::of_hex("ff"));
  assert_eq(msgpack_encode(Int(-32)), Bytes::of_hex("e0"));
  assert_eq(msgpack_encode(Int(-33)), Bytes::of_hex("d0df"));
  assert_eq(msgpack_encode(Int(128)), Bytes::of_hex("d10080"));
  assert_eq(msgpack_encode(Int(-32768)), Bytes::of_hex("d18000"));
  assert_eq(msgpack_encode(Int(-32769)), Bytes::of_hex("d2ffff7fff"));
  assert_eq(msgpack_encode(Float(1.5)), Bytes::of_hex("cb3ff8000000000000"));
  assert_eq(msgpack_decode(msgpack_encode(Int(70000))), Ok(Int(70000)));
  assert_eq(msgpack_decode(msgpack_encode(Float(-0.5))), Ok(Float(-0.5)));
  assert_eq(msgpack_decode(msgpack_encode(Text("héllo"))), Ok(Text("héllo")));
  assert_eq(msgpack_decode(msgpack_encode(Binary(b"\x00\xff"))), Ok(Binary(b"\x00\xff")))
}

test "text, binary, arrays and maps round-trip, and two concatenated values are rejected" {
  assert_eq(msgpack_encode(Text("hello")), Bytes::of_hex("a568656c6c6f"));
  assert_eq(msgpack_encode(Binary(b"\x01\x02")), Bytes::of_hex("c4020102"));
  assert_eq(msgpack_encode(Array([Int(1), Int(2)])), Bytes::of_hex("920102"));
  assert_eq(msgpack_encode(Map([entry(Text("a"), Int(1))])), Bytes::of_hex("81a16101"));
  let nested = Array([Int(1), Array([Boolean(true)]), Map([entry(Text("k"), Binary(b"v"))])]);
  assert_eq(msgpack_decode(msgpack_encode(nested)), Ok(nested));
  let two = msgpack_encode(Int(1)).concat(msgpack_encode(Int(2)));
  assert_eq(msgpack_decode(two), Err({ at: 1, reason: Trailing }))
}

test "`msgpack_decode` accepts unsigned integer widths and rejects MessagePack types that the library does not support" {
  assert_eq(msgpack_decode(Bytes::of_hex("cc80")), Ok(Int(128)));
  assert_eq(msgpack_decode(Bytes::of_hex("cd0100")), Ok(Int(256)));
  assert_eq(msgpack_decode(Bytes::of_hex("ce00010000")), Ok(Int(65536)));
  let rejected = |hex: String, at: Int, reason: ErrorKind|
    assert_eq(msgpack_decode(Bytes::of_hex(hex)), Err({ at: at, reason: reason }));
  rejected("ca3fc00000", 0, Unsupported(0xCA));
  rejected("c70102ff", 0, Unsupported(0xC7));
  rejected("c1", 0, Unsupported(0xC1));
  rejected("d90561", 2, Truncated);
  rejected("db0000000561", 5, Truncated);
  rejected("cfffffffffffffffff", 0, TooWide);
  rejected("9201", 2, Truncated);
  rejected("a1ff", 1, NotUtf8);
  rejected("", 0, Truncated)
}

test "a value nested past the depth limit is rejected at the byte where the limit ran out" {
  let nested = |levels: Int|
    Bytes::concat_all(range(0, levels).map(|_: Int| byte_of_int(0x91))).concat(b"\xc0");
  assert(match msgpack_decode(nested(64)) { Ok(_) -> true, Err(_) -> false });
  assert_eq(msgpack_decode(nested(65)), Err({ at: 65, reason: TooDeep }))
}

test "`msgpack_read` raises the same error that `msgpack_decode` returns, and it can run inside a spawned task" {
  assert_eq(try { msgpack_read(Bytes::of_hex("c1")) }, Err({ at: 0, reason: Unsupported(0xC1) }));
  let read = simulate {
    let t = task.spawn(|| try { msgpack_read(Bytes::of_hex("9201")) });
    task.join(t)
  };
  assert_eq(read, Err({ at: 2, reason: Truncated }))
}
