//! The postgres wire protocol, as framing and nothing else.
//!
//! Every message the front end (the client) sends after start-up is one kind byte, an `Int32`
//! length that counts itself, and a body. The start-up, SSL and cancel requests are the exceptions:
//! they start with their length. Values travel as text in both directions, so a parameter is the
//! text the server would print, and a column is the text the server printed. This layer never
//! decodes a value. `read` takes the bytes a socket returned and returns the whole messages in them
//! plus the leftover bytes, so a short read is not an error.
//!
//! `connect` brings a session to the point where the server accepts queries. It authenticates with
//! a clear-text password or SCRAM-SHA-256, and rejects md5 with an error that names it. The caller
//! supplies the client's SCRAM nonce, drawn from the `random` effect, so the run's `random` seed
//! determines the nonce and a test can fix it. The password is a `Secret<Bytes>` throughout. SCRAM
//! derives its proof from it under `std.sasl`. A clear-text password is sent with
//! `net.send_secret`: the message's kind and length go out in the clear before it and its NUL after
//! it, so no plain value in the program ever contains the password. `simple_query` and
//! `extended_query` return the columns, the rows and the command tag. The SCRAM steps belong to
//! `std.sasl` and the connection to `std.net`. Which statements to send, what a transaction is and
//! when to retry belong to `std.db`.
//!
//! `connect` secures the connection before start-up when `Tls` requests it. After an `SSLRequest`
//! the server replies yes or no. A no fails with `Declined` instead of continuing in plaintext.
//! With direct negotiation the TLS handshake begins at once. The server is verified as
//! `net.start_tls` verifies it, and plaintext the server sends after its yes fails with `Injected`.
//! Over TLS, SCRAM is bound to the channel when the server offers that (SCRAM-SHA-256-PLUS). The
//! binding is the `tls-server-end-point` hash of the certificate the server presented
//! (`end_point`), so a proof made for one connection proves nothing on another. When the server
//! does not offer channel binding, the client tells the server that it supports channel binding but
//! was not offered it. A server whose offer was stripped in transit then rejects the exchange. If
//! the server offers channel binding but the client cannot compute it, because the certificate's
//! signature names no hash, the client rejects the offer instead of continuing unbound.
//!
//! A session that has sent `LISTEN` receives notifications with `await_notification`. A
//! notification that arrives while a statement is running is stored in the session until the next
//! wait. A copy moves rows in `COPY`'s text format: `copy_row` writes one row and `copy_fields`
//! reads one row. `copy_in_begin`, `copy_send` and `copy_in_end` send rows, and `CopyFail` discards
//! all of them. `copy_out_begin` and `copy_out_take` read rows a piece at a time.

import std.bytes
import std.bytes (contains_bytes, u16_be, u32_be, i32_be, cstring)
import std.ip
import std.net
import std.net (Sends, net, send_all)
import std.list
import std.option
import std.hash (sha256, sha384, sha512)
import std.sasl (scram_challenge, scram_final, scram_first, scram_first_bare, scram_verify,
                 ChannelBinding, Unbound, Unoffered, ServerEndPoint)
import std.gen

/// What the front end sends.
pub type Frontend =
  | Query
  | Parse
  | Bind
  | Describe
  | Execute
  | Sync
  | Close
  | Flush
  | Terminate
  | CopyData
  | CopyDone
  | CopyFail

/// The kind byte a front-end message is sent with.
pub fn frontend_byte(f: Frontend) -> Int =
  match f {
    Query -> 81,
    Parse -> 80,
    Bind -> 66,
    Describe -> 68,
    Execute -> 69,
    Sync -> 83,
    Close -> 67,
    Flush -> 72,
    Terminate -> 88,
    CopyData -> 100,
    CopyDone -> 99,
    CopyFail -> 102,
  }

/// The message's name as the protocol documents it.
pub fn frontend_name(f: Frontend) -> String =
  match f {
    Query -> "Query",
    Parse -> "Parse",
    Bind -> "Bind",
    Describe -> "Describe",
    Execute -> "Execute",
    Sync -> "Sync",
    Close -> "Close",
    Flush -> "Flush",
    Terminate -> "Terminate",
    CopyData -> "CopyData",
    CopyDone -> "CopyDone",
    CopyFail -> "CopyFail",
  }

/// What the back end (the server) sends. `Other` carries the kind byte, so a message this module
/// does not name can still be reported instead of silently dropped.
pub type Backend =
  | Authentication
  | ParameterStatus
  | BackendKeyData
  | ReadyForQuery
  | RowDescription
  | DataRow
  | CommandComplete
  | ErrorResponse
  | NoticeResponse
  | ParseComplete
  | BindComplete
  | CloseComplete
  | NoData
  | ParameterDescription
  | EmptyQueryResponse
  | NotificationResponse
  | CopyInResponse
  | CopyOutResponse
  /// `CopyData` from the server: a piece of what a copy out sends.
  | CopyChunk
  /// `CopyDone` from the server: the server has sent all the data of a copy out.
  | CopyEnd
  | Other(Int)

/// The kind byte a back-end message arrives with.
pub fn backend_byte(k: Backend) -> Int =
  match k {
    NotificationResponse -> 65,
    CopyInResponse -> 71,
    CopyOutResponse -> 72,
    CopyChunk -> 100,
    CopyEnd -> 99,
    Authentication -> 82,
    ParameterStatus -> 83,
    BackendKeyData -> 75,
    ReadyForQuery -> 90,
    RowDescription -> 84,
    DataRow -> 68,
    CommandComplete -> 67,
    ErrorResponse -> 69,
    NoticeResponse -> 78,
    ParseComplete -> 49,
    BindComplete -> 50,
    CloseComplete -> 51,
    NoData -> 110,
    ParameterDescription -> 116,
    EmptyQueryResponse -> 73,
    Other(b) -> b,
  }

/// The message's name as the protocol documents it.
pub fn backend_name(k: Backend) -> String =
  match k {
    Authentication -> "Authentication",
    ParameterStatus -> "ParameterStatus",
    BackendKeyData -> "BackendKeyData",
    ReadyForQuery -> "ReadyForQuery",
    RowDescription -> "RowDescription",
    DataRow -> "DataRow",
    CommandComplete -> "CommandComplete",
    ErrorResponse -> "ErrorResponse",
    NoticeResponse -> "NoticeResponse",
    ParseComplete -> "ParseComplete",
    BindComplete -> "BindComplete",
    CloseComplete -> "CloseComplete",
    NoData -> "NoData",
    ParameterDescription -> "ParameterDescription",
    EmptyQueryResponse -> "EmptyQueryResponse",
    NotificationResponse -> "NotificationResponse",
    CopyInResponse -> "CopyInResponse",
    CopyOutResponse -> "CopyOutResponse",
    CopyChunk -> "CopyData",
    CopyEnd -> "CopyDone",
    Other(b) -> "Other(" ++ b.to_string() ++ ")",
  }

/// The back-end message a kind byte names; `Other` for one this module does not.
pub fn backend_of(b: Int) -> Backend = if b < 75 { backend_low(b) } else { backend_high(b) }

fn backend_low(b: Int) -> Backend =
  if b == 49 { ParseComplete }
  else if b == 50 { BindComplete }
  else if b == 51 { CloseComplete }
  else if b == 65 { NotificationResponse }
  else if b == 67 { CommandComplete }
  else if b == 68 { DataRow }
  else if b == 69 { ErrorResponse }
  else if b == 71 { CopyInResponse }
  else if b == 72 { CopyOutResponse }
  else if b == 73 { EmptyQueryResponse }
  else { Other(b) }

fn backend_high(b: Int) -> Backend =
  if b == 75 { BackendKeyData }
  else if b == 78 { NoticeResponse }
  else if b == 82 { Authentication }
  else if b == 83 { ParameterStatus }
  else if b == 84 { RowDescription }
  else if b == 90 { ReadyForQuery }
  else if b == 99 { CopyEnd }
  else if b == 100 { CopyChunk }
  else if b == 110 { NoData }
  else if b == 116 { ParameterDescription }
  else { Other(b) }

/// One back-end message: its kind and its body, without the length.
pub type Message = { kind: Backend, body: Bytes }

/// A buffer read into whole messages, with whatever trailing bytes are not yet a whole one.
pub type Frames = { done: List<Message>, rest: Bytes }

fn length_prefixed(body: Bytes) -> Bytes = u32_be(body.len() + 4).concat(body)

fn frontend(f: Frontend, body: Bytes) -> Bytes / {abort.raise} =
  byte_of_int(frontend_byte(f)).concat(length_prefixed(body))

/// Returns the start-up message: the protocol version, then the parameters, then a zero byte. It
/// has no kind byte, because the connection has not yet negotiated a message format. Each entry in
/// `parameters` is a run-time setting that the server applies to the session before it replies.
pub fn startup(user: String, database: String, parameters: List<Parameter>) -> Bytes =
  length_prefixed(
    Bytes::concat_all([
      u32_be(196608),
      cstring("user"),
      cstring(user),
      cstring("database"),
      cstring(database),
      Bytes::concat_all(parameters.map(|p: Parameter| cstring(p.name).concat(cstring(p.value)))),
      byte_of_int(0),
    ]),
  )

/// Returns the `SSLRequest` message, which asks the server to speak TLS. Its code is 80877103,
/// which is 1234 in the high 16 bits and 5679 in the low 16 bits. The protocol reserves it so that
/// it can never be mistaken for a supported protocol version.
pub const ssl_request: Bytes = length_prefixed(u32_be(80877103))

/// The byte a server sends in reply to an SSL request when it will speak TLS.
pub const ssl_response: Bytes = byte_of_int(83)

/// The request that cancels the statement a session is running, named by its backend key.
pub fn cancel_request(pid: Int, secret: Int) -> Bytes =
  length_prefixed(Bytes::concat_all([u32_be(80877102), u32_be(pid), u32_be(secret)]))

/// The simple query protocol: one statement, to which the server replies with rows and a command
/// tag.
pub fn query(sql: String) -> Bytes / {abort.raise} = frontend(Query, cstring(sql))

/// Returns a `Parse` message for the extended protocol. The extended protocol works in steps:
/// `parse` creates a named statement, `bind` creates a portal over it, `execute` runs the portal,
/// and `sync` makes the server reply. Parameters and results are sent as text, not in binary.
pub fn parse(statement: String, sql: String, param_types: List<Int>) -> Bytes / {abort.raise} =
  frontend(
    Parse,
    Bytes::concat_all([
      cstring(statement),
      cstring(sql),
      u16_be(param_types.len()),
      Bytes::concat_all(param_types.map(|t: Int| u32_be(t))),
    ]),
  )

fn bound_value(p: Option<String>) -> Bytes =
  match p {
    None -> i32_be(-1),
    Some(text) -> {
      let raw = Bytes::of_string(text);
      i32_be(raw.len()).concat(raw)
    },
  }

/// `Bind` of a portal over a prepared statement, every parameter in text and `None` for NULL, and
/// every result in text.
pub fn bind(
  portal: String,
  statement: String,
  params: List<Option<String>>,
) -> Bytes / {abort.raise} =
  frontend(
    Bind,
    Bytes::concat_all([
      cstring(portal),
      cstring(statement),
      u16_be(0),
      u16_be(params.len()),
      Bytes::concat_all(params.map(|p: Option<String>| bound_value(p))),
      u16_be(0),
    ]),
  )

/// `statement` describes the prepared statement, otherwise the portal.
pub fn describe(statement: Bool, name: String) -> Bytes / {abort.raise} =
  frontend(Describe, byte_of_int(if statement { 83 } else { 80 }).concat(cstring(name)))

/// `max_rows` of zero is no limit.
pub fn execute(portal: String, max_rows: Int) -> Bytes / {abort.raise} =
  frontend(Execute, cstring(portal).concat(u32_be(max_rows)))

/// `Sync`, which ends an extended-protocol exchange and makes the server reply.
pub const sync: Bytes = frontend(Sync, b"")

/// `Flush`, which asks the server for what it has without ending the exchange.
pub const flush: Bytes = frontend(Flush, b"")

/// `Close` of a prepared statement, or of a portal.
pub fn close(statement: Bool, name: String) -> Bytes / {abort.raise} =
  frontend(Close, byte_of_int(if statement { 83 } else { 80 }).concat(cstring(name)))

/// `Terminate`, after which the server expects nothing more.
pub const terminate: Bytes = frontend(Terminate, b"")

/// The result of reading the first frame from a buffer. `frame` is that frame, or `None` when the
/// buffer does not yet contain a whole frame, including when its length field is missing or
/// invalid. `rest` is the bytes after the frame, or the whole buffer when `frame` is `None`.
pub type Partial = { frame: Option<Message>, rest: Bytes }

/// The first whole frame in `buffer`, and the bytes after it.
pub fn first_frame(buffer: Bytes) -> Partial = {
  let n = buffer.len();
  if n < 5 { { frame: None, rest: buffer } } else {
    match buffer.u32_be_at(1) {
      None -> { frame: None, rest: buffer },
      Some(len) -> if len < 4 || 1 + len > n { { frame: None, rest: buffer } } else {
        {
          frame: Some({ kind: backend_of(buffer.at(0)), body: buffer.slice(5, 1 + len) }),
          rest: buffer.slice(1 + len, n),
        }
      },
    }
  }
}

/// Every whole frame in `buffer`, and the bytes that are not yet one.
pub fn read(buffer: Bytes) -> Frames / {abort.raise} = read_all(buffer, [], buffer.len())

fn read_all(buffer: Bytes, accumulator: List<Message>, left: Int) -> Frames / {abort.raise} = {
  let p = first_frame(buffer);
  match p.frame {
    None -> { done: accumulator, rest: p.rest },
    Some(m) -> if left <= 0 {
      panic(
        "the PostgreSQL message reader found another complete message after it had already consumed every byte of the buffer, which is a bug in the reader",
      )
    } else { read_all(p.rest, accumulator.push(m), left - 1) },
  }
}

/// A zero-terminated string starting at `at`, and where the next field begins.
pub type CString = { text: String, next: Int }

/// The zero-terminated string at `at`; `None` when no zero byte ends it.
pub fn read_cstring(b: Bytes, at: Int) -> Option<CString> / {abort.raise} =
  if at < 0 || at >= b.len() { None } else {
    match b.slice(at, b.len()).index_of_byte(0) {
      None -> None,
      Some(i) -> Some({ text: String::of_bytes(b.slice(at, at + i)), next: at + i + 1 }),
    }
  }

/// The authentication code the server sends before it accepts queries: 0 is authenticated, 3
/// requests a clear-text password, 5 requests md5, 10 offers SASL, and 11 and 12 are its two SASL
/// steps.
pub fn auth_code(message: Message) -> Option<Int> = message.body.u32_be_at(0)

/// Returns the name of an authentication code as it appears in error messages, such as
/// `AuthenticationOk`.
pub fn auth_name(code: Int) -> String =
  if code == 0 { "AuthenticationOk" }
  else if code == 3 { "AuthenticationCleartextPassword" }
  else if code == 5 { "AuthenticationMD5Password" }
  else if code == 10 { "AuthenticationSASL" }
  else if code == 11 { "AuthenticationSASLContinue" }
  else if code == 12 { "AuthenticationSASLFinal" }
  else { "Authentication(" ++ code.to_string() ++ ")" }

/// The bytes after the code, which is what a SASL step carries.
pub fn auth_body(message: Message) -> Option<Bytes> =
  message.body.slice_at(4, message.body.len() - 4)

/// 'I' idle, 'T' in a transaction, 'E' in a failed transaction, which rejects everything but
/// `ROLLBACK` until it ends.
pub fn ready_status(message: Message) -> Option<Int> =
  if message.body.len() < 1 { None } else { Some(message.body.at(0)) }

/// Where a session's transaction stands, as `ReadyForQuery` reports.
pub type Status = | Idle | InTransaction | FailedTransaction | Unknown(Int)

/// The status a `ReadyForQuery` byte names.
pub fn status_of(b: Int) -> Status =
  if b == 73 { Idle }
  else if b == 84 { InTransaction }
  else if b == 69 { FailedTransaction }
  else { Unknown(b) }

/// Returns a status as text for use in error messages, such as `in a failed transaction`.
pub fn status_name(s: Status) -> String =
  match s {
    Idle -> "idle",
    InTransaction -> "in transaction",
    FailedTransaction -> "in a failed transaction",
    Unknown(b) -> "unknown(" ++ b.to_string() ++ ")",
  }

/// The process and secret a server names a session by, which `cancel_request` needs.
pub type BackendKey = { pid: Int, secret: Int }

/// The key a `BackendKeyData` message carries.
pub fn backend_key(message: Message) -> Option<BackendKey> =
  match message.body.u32_be_at(0) {
    None -> None,
    Some(pid) -> match message.body.u32_be_at(4) {
      None -> None,
      Some(secret) -> Some({ pid: pid, secret: secret }),
    },
  }

/// A run-time parameter and its value.
pub type Parameter = { name: String, value: String }

/// The parameter a `ParameterStatus` message sets.
pub fn parameter_status(message: Message) -> Option<Parameter> / {abort.raise} =
  match read_cstring(message.body, 0) {
    None -> None,
    Some(name) -> match read_cstring(message.body, name.next) {
      None -> None,
      Some(value) -> Some({ name: name.text, value: value.text }),
    },
  }

/// A column's name, its type's OID and the format its values arrive in: 0 text, 1 binary.
pub type Column = { name: String, ty: Int, format: Int }

/// The columns a `RowDescription` describes.
pub fn row_description(message: Message) -> Option<List<Column>> / {abort.raise} =
  match message.body.u16_be_at(0) {
    None -> None,
    Some(count) -> columns(message.body, 2, count, []),
  }

fn columns(
  body: Bytes,
  at: Int,
  left: Int,
  accumulator: List<Column>,
) -> Option<List<Column>> / {abort.raise} =
  if left <= 0 { Some(accumulator) } else {
    match read_cstring(body, at) {
      None -> None,
      Some(name) -> match body.u32_be_at(name.next + 6) {
        None -> None,
        Some(ty) -> match body.u16_be_at(name.next + 16) {
          None -> None,
          Some(format) ->
            columns(
              body,
              name.next + 18,
              left - 1,
              accumulator.push({ name: name.text, ty: ty, format: format }),
            ),
        },
      },
    }
  }

/// Returns the column values of one `DataRow` message, with `None` for a NULL column. Each value is
/// preceded by its length in bytes, and a length of -1 means NULL.
pub fn data_row(message: Message) -> Option<List<Option<Bytes>>> =
  match message.body.u16_be_at(0) {
    None -> None,
    Some(count) -> values(message.body, 2, count, []),
  }

fn values(
  body: Bytes,
  at: Int,
  left: Int,
  accumulator: List<Option<Bytes>>,
) -> Option<List<Option<Bytes>>> =
  if left <= 0 { Some(accumulator) } else {
    match body.i32_be_at(at) {
      None -> None,
      Some(len) -> if len < 0 { values(body, at + 4, left - 1, accumulator.push(None)) } else {
        match body.slice_at(at + 4, len) {
          None -> None,
          Some(raw) -> values(body, at + 4 + len, left - 1, accumulator.push(Some(raw))),
        }
      },
    }
  }

/// The tag a completed command reports: `SELECT 3`, `INSERT 0 1`, `BEGIN`.
pub fn command_tag(message: Message) -> Option<String> / {abort.raise} =
  match read_cstring(message.body, 0) { None -> None, Some(tag) -> Some(tag.text) }

/// The type OIDs a `ParameterDescription` lists for a statement's parameters.
pub fn parameter_types(message: Message) -> Option<List<Int>> =
  match message.body.u16_be_at(0) { None -> None, Some(count) -> oids(message.body, 2, count, []) }

fn oids(body: Bytes, at: Int, left: Int, accumulator: List<Int>) -> Option<List<Int>> =
  if left <= 0 { Some(accumulator) } else {
    match body.u32_be_at(at) {
      None -> None,
      Some(oid) -> oids(body, at + 4, left - 1, accumulator.push(oid)),
    }
  }

/// An `ErrorResponse` and a `NoticeResponse` are the same shape: a field type byte, the field's
/// text, and a zero byte at the end. `S` is severity, `C` the SQLSTATE, `M` the message, `D` its
/// detail and `n` the constraint a violation names.
pub type Field = { code: Int, text: String }

/// Every field of an `ErrorResponse` or a `NoticeResponse`.
pub fn diagnostic_fields(message: Message) -> List<Field> / {abort.raise} =
  fields_of(message.body, 0, [], message.body.len())

fn fields_of(
  b: Bytes,
  at: Int,
  accumulator: List<Field>,
  left: Int,
) -> List<Field> / {abort.raise} =
  if at >= b.len() { accumulator }
  else if b.at(at) == 0 { accumulator } else {
    let code = b.at(at);
    match read_cstring(b, at + 1) {
      None -> accumulator,
      Some(field) -> if left <= 0 { panic("an error or notice message has more fields than bytes") }
      else {
        fields_of(b, field.next, accumulator.push({ code: code, text: field.text }), left - 1)
      },
    }
  }

/// The diagnostic field with this type byte, such as the SQLSTATE under `C`.
pub fn field_of(message: Message, code: Int) -> Option<String> / {abort.raise} =
  diagnostic_fields(message).fold(None, |accumulator: Option<String>, f: Field|
    if f.code == code { Some(f.text) } else { accumulator })

/// How long a client waits, in milliseconds: to connect, for a read, for a write.
pub type Timeouts = { connect_ms: Int, read_ms: Int, write_ms: Int }

/// Five seconds to connect, thirty to read or write.
pub const default_timeouts: Timeouts = { connect_ms: 5000, read_ms: 30000, write_ms: 30000 }

/// The most bytes one `net.recv` asks for.
pub const read_size: Int = 65536

/// An error the server reported when it rejected a request. A program should branch on `code`, the
/// SQLSTATE. `constraint` names the constraint that a constraint violation broke. The other fields
/// are for display.
pub type ServerError = {
  severity: String,
  code: String,
  message: String,
  detail: String,
  constraint: String,
}

/// A connection with a server, the bytes read from it that are not yet a whole frame, the
/// parameters it set at start-up, where its transaction stood at the last `ReadyForQuery`, and the
/// notifications that arrived while it was reading something else, oldest first.
pub type Session = {
  connection: Int,
  buffer: Bytes,
  user: String,
  database: String,
  settings: List<Parameter>,
  status: Status,
  notices: List<Notification>,
}

/// How a connection is secured before its start-up, verifying the server as `name`: not at all;
/// by asking the server first with an `SSLRequest`; or by starting TLS at once, Postgres 17's
/// direct negotiation, which a server before 17 does not understand. Either way the handshake
/// offers the application protocol `postgresql`, and the server's certificate is verified as
/// `net.start_tls` verifies one: against the built-in roots and `--trust`, for the name.
pub type Tls = | NoTls | Requested(String) | Direct(String)

/// Why a client operation failed.
pub type ClientError =
  | Unreachable
  | NotSent
  | TimedOut
  | Closed
  /// TLS was requested and the server replied that it does not support it. Nothing continues in
  /// plaintext.
  | Declined
  /// TLS did not complete: the certificate is not trusted for the name, plaintext was waiting
  /// where the handshake was to begin, or the handshake failed.
  | Unsecured(net::Error)
  /// The server rejected the client and no connection is left to use: it rejected the client
  /// before accepting queries, or its error ended the session.
  | ConnectionRejected(ServerError)
  /// A statement was rejected. The connection is still usable, since the server is waiting for the
  /// next statement, so the session is returned with the error for the caller to handle.
  | Rejected(Session, ServerError)
  | Unexpected(String)

/// A server error as text: the severity, the message, and the SQLSTATE a program branches on.
pub fn server_error_text(server: ServerError) -> String =
  server.severity ++ ": " ++ server.message ++ " (" ++ server.code ++ ")"

/// A client error as text.
pub fn client_error_text(e: ClientError) -> String =
  match e {
    Unreachable -> "the server could not be reached",
    NotSent -> "a message could not be sent",
    TimedOut -> "the server did not respond in time",
    Closed -> "the server closed the connection",
    Declined -> "the server does not support TLS, which this connection requires",
    Unsecured(reason) -> "TLS did not complete: " ++ net::error_message(reason),
    ConnectionRejected(s) -> server_error_text(s),
    Rejected(_, s) -> server_error_text(s),
    Unexpected(what) -> what,
  }

/// The value the server set `name` to at start-up.
pub fn setting(s: Session, name: String) -> Option<String> =
  s.settings.fold(None, |accumulator: Option<String>, set: Parameter|
    if set.name == name { Some(set.value) } else { accumulator })

type ReceivedMessage = { message: Message, rest: Bytes }

fn read_message<[l]>(
  c: Int,
  buffer: Bytes,
  timeout_ms: Int,
) -> Result<ReceivedMessage, ClientError> / {net.recv[l], abort.raise} =
  match arriving[l](c, buffer, timeout_ms) {
    Ok(Arrived(got)) -> Ok(got),
    Ok(Incomplete(_)) -> Err(TimedOut),
    Err(e) -> Err(e),
  }

type Arrival = | Arrived(ReceivedMessage) | Incomplete(Bytes)

fn arriving<[l]>(
  c: Int,
  buffer: Bytes,
  timeout_ms: Int,
) -> Result<Arrival, ClientError> / {net.recv[l], abort.raise} =
  awaiting[l](c, buffer, timeout_ms, 4294967297)

fn awaiting<[l]>(
  c: Int,
  buffer: Bytes,
  timeout_ms: Int,
  rounds_left: Int,
) -> Result<Arrival, ClientError> / {net.recv[l], abort.raise} = {
  let p = first_frame(buffer);
  match p.frame {
    Some(m) -> Ok(Arrived({ message: m, rest: p.rest })),
    None -> if buffer.len() >= 5
        && (match buffer.u32_be_at(1) { Some(n) -> n < 4, None -> false }) {
      Err(Unexpected("a message declares a length below 4, the size of the length field itself"))
    } else if rounds_left <= 0 {
      panic("a message is still incomplete after more reads than its declared length can need")
    } else {
      match net.recv[l](c, read_size, timeout_ms) {
        None -> Ok(Incomplete(buffer)),
        Some(bytes) -> if bytes.len() == 0 { Err(Closed) }
        else { awaiting[l](c, buffer.concat(bytes), timeout_ms, rounds_left - 1) },
      }
    },
  }
}

fn server_error_of(message: Message) -> ServerError / {abort.raise} =
  {
    severity: field_or(message, 83, "ERROR"),
    code: field_or(message, 67, ""),
    message: field_or(message, 77, ""),
    detail: field_or(message, 68, ""),
    constraint: field_or(message, 110, ""),
  }

fn status_after(message: Message) -> Status =
  match ready_status(message) { Some(b) -> status_of(b), None -> Unknown(0) }

fn field_or(m: Message, code: Int, fallback: String) -> String / {abort.raise} =
  match field_of(m, code) { Some(text) -> text, None -> fallback }

/// Opens a socket, secures it as `tls` directs, and brings the session to the point where the
/// server accepts queries: start-up, whatever authentication the server requests, its parameters,
/// and `ReadyForQuery`.
pub fn connect<[l]>(
  host: String,
  port: Int,
  tls: Tls,
  user: String,
  database: String,
  parameters: List<Parameter>,
  password: Option<Secret<Bytes>>,
  nonce: String,
  timeouts: Timeouts,
) -> Result<Session, ClientError> / {net.connect[l], net.start_tls[l], net.peer_certificate[l], net.send[l], net.send_secret[l], net.recv[l], net.close[l], abort.raise, diverges} =
  match net.connect[l](host, port, timeouts.connect_ms) {
    None -> Err(Unreachable),
    Some(connection) -> {
      let opening: Session = {
        connection: connection,
        buffer: b"",
        user: user,
        database: database,
        settings: [],
        status: Idle,
        notices: [],
      };
      let started = match secured[l](connection, tls, timeouts) {
        Err(e) -> Err(e),
        Ok(channel) -> if !send_all[l](
            connection,
            startup(user, database, parameters),
            timeouts.write_ms,
          ) { Err(NotSent) }
        else { greet[l](opening, password, nonce, timeouts, empty_greeting(channel)) },
      };
      match started {
        Ok(s) -> Ok(s),
        Err(e) -> {
          net.close[l](connection);
          Err(e)
        },
      }
    },
  }

/// The application protocol a TLS handshake with a server offers, which Postgres 17 requires of a
/// direct one.
pub const alpn: String = "postgresql"

type Channel = | Plaintext | Secured(Option<Bytes>)

fn secured<[l]>(
  connection: Int,
  tls: Tls,
  timeouts: Timeouts,
) -> Result<Channel, ClientError> / {net.send[l], net.recv[l], net.start_tls[l], net.peer_certificate[l], abort.raise} =
  match tls {
    NoTls -> Ok(Plaintext),
    Direct(name) -> upgraded[l](connection, name, timeouts),
    Requested(name) -> if !send_all[l](connection, ssl_request, timeouts.write_ms) { Err(NotSent) }
    else {
      match net.recv[l](connection, 1, timeouts.read_ms) {
        None -> Err(TimedOut),
        Some(result) -> if result.len() == 0 { Err(Closed) }
        else if result.at(0) == 83 { upgraded[l](connection, name, timeouts) }
        else if result.at(0) == 78 { Err(Declined) } else {
          Err(Unexpected("the server responded to the SSL request with neither `S` nor `N`"))
        },
      }
    },
  }

fn upgraded<[l]>(
  connection: Int,
  name: String,
  timeouts: Timeouts,
) -> Result<Channel, ClientError> / {net.start_tls[l], net.peer_certificate[l]} =
  match net.start_tls[l](connection, name, [alpn], b"", timeouts.connect_ms) {
    Ok(_) -> Ok(Secured(net.peer_certificate[l](connection))),
    Err(reason) -> Err(Unsecured(reason)),
  }

fn greet<[l]>(
  s: Session,
  password: Option<Secret<Bytes>>,
  nonce: String,
  timeouts: Timeouts,
  accumulator: Greeting,
) -> Result<Session, ClientError> / {net.send[l], net.send_secret[l], net.recv[l], abort.raise, diverges} =
  match read_message[l](s.connection, s.buffer, timeouts.read_ms) {
    Err(e) -> Err(e),
    Ok(got) -> {
      let m = got.message;
      let rest: Session = { ..s, buffer: got.rest };
      match m.kind {
        Authentication -> match auth_code(m) {
          None -> Err(Unexpected("an authentication message with no code")),
          Some(0) -> greet[l](rest, password, nonce, timeouts, accumulator),
          Some(3) -> match password {
            None -> Err(ConnectionRejected(no_password(s.user, "a clear-text password"))),
            Some(secret) -> if !net.send_secret[l](
                rest.connection,
                password_head(secret.len()),
                secret,
                "raw",
                b"\x00",
                timeouts.write_ms,
              ) { Err(NotSent) }
            else { greet[l](rest, password, nonce, timeouts, accumulator) },
          },
          Some(10) -> scram_begin[l](rest, password, nonce, timeouts, accumulator, m),
          Some(11) -> scram_continue[l](rest, password, nonce, timeouts, accumulator, m),
          Some(12) -> match accumulator.sasl.expected {
            None ->
              Err(
                Unexpected(
                  "the server sent its final SASL message before the client sent its own message",
                ),
              ),
            Some(expected) -> match auth_text(m) {
              None -> Err(Unexpected("the final SASL authentication message is not text")),
              Some(text) -> if !scram_verify(text, expected) {
                Err(Unexpected("the server's proof did not verify"))
              } else { greet[l](rest, password, nonce, timeouts, accumulator) },
            },
          },
          Some(other) ->
            Err(
              Unexpected(
                "the server asks for " ++ auth_name(other)
                  ++ ", which this client does not handle yet",
              ),
            ),
        },
        ParameterStatus -> match parameter_status(m) {
          Some(set) ->
            greet[l](rest, password, nonce, timeouts, {
              ..accumulator,
              settings: accumulator.settings.push(set),
            }),
          None -> greet[l](rest, password, nonce, timeouts, accumulator),
        },
        BackendKeyData -> greet[l](rest, password, nonce, timeouts, accumulator),
        NoticeResponse -> greet[l](rest, password, nonce, timeouts, accumulator),
        ErrorResponse -> Err(ConnectionRejected(server_error_of(m))),
        ReadyForQuery -> Ok({ ..rest, settings: accumulator.settings, status: status_after(m) }),
        _ -> Err(Unexpected("a " ++ backend_name(m.kind) ++ " before the server was ready")),
      }
    },
  }

fn no_password(user: String, what: String) -> ServerError =
  {
    severity: "ERROR",
    code: "28000",
    message: "the server wants " ++ what ++ " for `" ++ user ++ "`, and none was given",
    detail: "",
    constraint: "",
  }

/// Returns the first five bytes of a `PasswordMessage` for a password of `length` bytes: the kind
/// byte, then a length that counts itself, the password and the NUL after it. These bytes are the
/// only part of the message sent in the clear.
pub fn password_head(length: Int) -> Bytes = byte_of_int(112).concat(u32_be(length + 5))

type Greeting = { settings: List<Parameter>, sasl: Sasl, channel: Channel }

type Sasl = { first_bare: String, binding: ChannelBinding, expected: Option<Bytes> }

fn empty_greeting(channel: Channel) -> Greeting =
  { settings: [], sasl: { first_bare: "", binding: Unbound, expected: None }, channel: channel }

fn auth_text(message: Message) -> Option<String> / {abort.raise} =
  match auth_body(message) { None -> None, Some(bytes) -> Some(String::of_bytes(bytes)) }

fn mechanisms(message: Message) -> List<String> / {abort.raise} =
  match auth_body(message) { None -> [], Some(bytes) -> names_from(bytes, 0, [], bytes.len()) }

fn names_from(
  b: Bytes,
  at: Int,
  accumulator: List<String>,
  left: Int,
) -> List<String> / {abort.raise} =
  if at >= b.len() { accumulator } else {
    match read_cstring(b, at) {
      None -> accumulator,
      Some(name) -> if name.text.len() == 0 { accumulator }
      else if left <= 0 { panic("the list of SASL mechanisms has more names than bytes") }
      else { names_from(b, name.next, accumulator.push(name.text), left - 1) },
    }
  }

fn choose_binding(
  channel: Channel,
  offered: List<String>,
) -> Result<ChannelBinding, ClientError> / {abort.raise} = {
  let plain = offered.contains("SCRAM-SHA-256");
  match channel {
    Plaintext -> if plain { Ok(Unbound) } else { Err(no_scram) },
    Secured(certificate) -> if !offered.contains("SCRAM-SHA-256-PLUS") {
      if plain { Ok(Unoffered) } else { Err(no_scram) }
    } else {
      match certificate {
        None ->
          Err(
            Unexpected(
              "the server offers SCRAM-SHA-256-PLUS, which needs the server's TLS certificate, but the server sent no certificate",
            ),
          ),
        Some(der) -> match end_point(der) {
          Some(hash) -> Ok(ServerEndPoint(hash)),
          None ->
            Err(
              Unexpected(
                "the server offers SCRAM-SHA-256-PLUS, and its certificate is signed under an algorithm that names no hash to bind it by; this client does not accept the offer unbound",
              ),
            ),
        },
      }
    },
  }
}

const no_scram: ClientError = Unexpected("the server offers no SCRAM-SHA-256 mechanism")

fn scram_mechanism(b: ChannelBinding) -> String =
  match b { ServerEndPoint(_) -> "SCRAM-SHA-256-PLUS", _ -> "SCRAM-SHA-256" }

fn scram_begin<[l]>(
  s: Session,
  password: Option<Secret<Bytes>>,
  nonce: String,
  timeouts: Timeouts,
  accumulator: Greeting,
  message: Message,
) -> Result<Session, ClientError> / {net.send[l], net.send_secret[l], net.recv[l], abort.raise, diverges} =
  match password {
    None -> Err(ConnectionRejected(no_password(s.user, "a password"))),
    Some(_) -> match choose_binding(accumulator.channel, mechanisms(message)) {
      Err(e) -> Err(e),
      Ok(binding) -> {
        let first_bare = scram_first_bare(s.user, nonce);
        let raw = Bytes::of_string(scram_first(binding, s.user, nonce));
        let payload = Bytes::concat_all([
          cstring(scram_mechanism(binding)),
          i32_be(raw.len()),
          raw,
        ]);
        if !send_all[l](
            s.connection,
            byte_of_int(112).concat(length_prefixed(payload)),
            timeouts.write_ms,
          ) { Err(NotSent) } else {
          greet[l](s, password, nonce, timeouts, {
            ..accumulator,
            sasl: { first_bare: first_bare, binding: binding, expected: None },
          })
        }
      },
    },
  }

type Element = { tag: Int, start: Int, end: Int }

fn der_at(b: Bytes, at: Int) -> Option<Element> =
  if at < 0 || at + 2 > b.len() { None } else {
    let first_frame = b.at(at + 1);
    let n = if first_frame < 128 { 0 } else { first_frame - 128 };
    if n > 4 || at + 2 + n > b.len() || first_frame == 128 { None } else {
      let length = if n == 0 { first_frame }
      else { range(0, n).fold(0, |accumulator: Int, i: Int| accumulator * 256 + b.at(at + 2 + i)) };
      let start = at + 2 + n;
      if start + length > b.len() { None }
      else { Some({ tag: b.at(at), start: start, end: start + length }) }
    }
  }

fn der_oid(b: Bytes, at: Int) -> Option<Bytes> / {abort.raise} =
  match der_at(b, at) {
    Some(e) -> if e.tag == 6 { Some(b.slice(e.start, e.end)) } else { None },
    None -> None,
  }

fn signature_hash_name(
  b: Bytes,
  algorithm: Bytes,
  params: Int,
  end: Int,
) -> Option<String> / {abort.raise} = {
  let rsa = b"\x2a\x86\x48\x86\xf7\x0d\x01\x01";
  let ecdsa = b"\x2a\x86\x48\xce\x3d\x04";
  if [
      rsa.concat(b"\x04"),
      rsa.concat(b"\x05"),
      rsa.concat(b"\x0b"),
      ecdsa.concat(b"\x01"),
      ecdsa.concat(b"\x03\x02"),
    ].contains(
      algorithm,
    ) { Some("SHA-256") }
  else if algorithm == rsa.concat(b"\x0c") || algorithm == ecdsa.concat(b"\x03\x03") {
    Some("SHA-384")
  } else if algorithm == rsa.concat(b"\x0d") || algorithm == ecdsa.concat(b"\x03\x04") {
    Some("SHA-512")
  } else if algorithm == rsa.concat(b"\x0a") { pss_hash(b, params, end) }
  else { None }
}

fn pss_hash(b: Bytes, params: Int, end: Int) -> Option<String> / {abort.raise} =
  if params >= end { Some("SHA-256") } else {
    match der_at(b, params) {
      None -> None,
      Some(sequence) -> match der_at(b, sequence.start) {
        None -> Some("SHA-256"),
        Some(first_frame) -> if first_frame.tag != 160 || sequence.start >= sequence.end {
          Some("SHA-256")
        } else {
          match der_at(b, first_frame.start) {
            None -> None,
            Some(identifier) -> match der_oid(b, identifier.start) {
              None -> None,
              Some(hash) -> {
                let nist = b"\x60\x86\x48\x01\x65\x03\x04\x02";
                if hash == nist.concat(b"\x01") || hash == b"\x2b\x0e\x03\x02\x1a" {
                  Some("SHA-256")
                } else if hash == nist.concat(b"\x02") { Some("SHA-384") }
                else if hash == nist.concat(b"\x03") { Some("SHA-512") }
                else { None }
              },
            },
          }
        },
      },
    }
  }

/// The `tls-server-end-point` data of a DER certificate (RFC 5929 §4.1): the certificate's hash
/// under the hash its signature algorithm names. `None` for a certificate that cannot be read, and
/// for an algorithm that names no hash, as Ed25519's does not.
pub fn end_point(der: Bytes) -> Option<Bytes> / {abort.raise} =
  match der_at(der, 0) {
    None -> None,
    Some(certificate) -> match der_at(der, certificate.start) {
      None -> None,
      Some(signed) -> match der_at(der, signed.end) {
        None -> None,
        Some(algorithm) -> match der_at(der, algorithm.start) {
          None -> None,
          Some(identifier) -> if identifier.tag != 6 { None } else {
            match signature_hash_name(
                der,
                der.slice(identifier.start, identifier.end),
                identifier.end,
                algorithm.end,
              ) {
              Some("SHA-256") -> Some(sha256(der)),
              Some("SHA-384") -> Some(sha384(der)),
              Some("SHA-512") -> Some(sha512(der)),
              _ -> None,
            }
          },
        },
      },
    },
  }

fn scram_continue<[l]>(
  s: Session,
  password: Option<Secret<Bytes>>,
  nonce: String,
  timeouts: Timeouts,
  accumulator: Greeting,
  message: Message,
) -> Result<Session, ClientError> / {net.send[l], net.send_secret[l], net.recv[l], abort.raise, diverges} =
  match password {
    None -> Err(ConnectionRejected(no_password(s.user, "a password"))),
    Some(secret) -> match auth_text(message) {
      None -> Err(Unexpected("the server's SASL challenge message is not text")),
      Some(server_first) -> match scram_challenge(server_first) {
        None ->
          Err(
            Unexpected("the server's SASL challenge message could not be parsed: " ++ server_first),
          ),
        Some(challenge) -> match scram_final(
            accumulator.sasl.binding,
            secret,
            accumulator.sasl.first_bare,
            server_first,
            challenge,
          ) {
          None ->
            Err(
              Unexpected(
                "the server's SASL challenge does not contain the random nonce this client sent",
              ),
            ),
          Some(proof) -> {
            let raw = Bytes::of_string(proof.reply);
            if !send_all[l](
                s.connection,
                byte_of_int(112).concat(length_prefixed(raw)),
                timeouts.write_ms,
              ) { Err(NotSent) } else {
              greet[l](s, password, nonce, timeouts, {
                ..accumulator,
                sasl: { ..accumulator.sasl, expected: Some(proof.expected) },
              })
            }
          },
        },
      },
    },
  }

/// What a query returned: its columns, its rows with `None` for NULL, and its command tag.
pub type QueryResult = { columns: List<Column>, rows: List<List<Option<Bytes>>>, tag: String }

/// The session after a query, and its result.
pub type Reply = { session: Session, result: QueryResult }

/// The simple query protocol: one statement, no parameters.
pub fn simple_query<[l]>(
  s: Session,
  sql: String,
  timeouts: Timeouts,
) -> Result<Reply, ClientError> / {net.send[l], net.recv[l], abort.raise, diverges} =
  if !send_all[l](s.connection, query(sql), timeouts.write_ms) { Err(NotSent) }
  else { gather[l](s, timeouts, empty_result) }

/// Runs one statement with parameters using the extended query protocol. Parameters and results use
/// the text format, so a parameter is the text the server would print for that value. The statement
/// and its result cursor (Postgres calls it a portal) are unnamed, so each call parses, binds and
/// executes the statement in a single exchange and leaves nothing behind.
pub fn extended_query<[l]>(
  s: Session,
  sql: String,
  params: List<Option<String>>,
  timeouts: Timeouts,
) -> Result<Reply, ClientError> / {net.send[l], net.recv[l], abort.raise, diverges} =
  if !send_all[l](
      s.connection,
      Bytes::concat_all([
        parse("", sql, []),
        bind("", "", params),
        describe(false, ""),
        execute("", 0),
        sync,
      ]),
      timeouts.write_ms,
    ) { Err(NotSent) }
  else { gather[l](s, timeouts, empty_result) }

/// The columns `sql` would return, as its `RowDescription` names them, without running it: none
/// for a statement that returns no rows.
pub fn describe_statement<[l]>(
  s: Session,
  sql: String,
  timeouts: Timeouts,
) -> Result<Reply, ClientError> / {net.send[l], net.recv[l], abort.raise, diverges} =
  if !send_all[l](
      s.connection,
      Bytes::concat_all([parse("", sql, []), describe(true, ""), sync]),
      timeouts.write_ms,
    ) { Err(NotSent) }
  else { gather[l](s, timeouts, empty_result) }

type PartialResult = {
  columns: List<Column>,
  rows: List<List<Option<Bytes>>>,
  tag: String,
  rejected: Option<ServerError>,
}

const empty_result: PartialResult = { columns: [], rows: [], tag: "", rejected: None }

fn gather<[l]>(
  s: Session,
  timeouts: Timeouts,
  accumulator: PartialResult,
) -> Result<Reply, ClientError> / {net.recv[l], abort.raise, diverges} =
  match read_message[l](s.connection, s.buffer, timeouts.read_ms) {
    Err(e) -> match accumulator.rejected {
      Some(server) -> Err(ConnectionRejected(server)),
      None -> Err(e),
    },
    Ok(got) -> {
      let m = got.message;
      let rest: Session = { ..s, buffer: got.rest };
      match m.kind {
        RowDescription ->
          gather[l](rest, timeouts, {
            ..accumulator,
            columns: match row_description(m) { Some(c) -> c, None -> accumulator.columns },
          }),
        DataRow ->
          gather[l](rest, timeouts, {
            ..accumulator,
            rows: accumulator.rows.concat([match data_row(m) { Some(r) -> r, None -> [] }]),
          }),
        CommandComplete ->
          gather[l](rest, timeouts, {
            ..accumulator,
            tag: match command_tag(m) { Some(t) -> t, None -> accumulator.tag },
          }),
        ErrorResponse ->
          gather[l](rest, timeouts, { ..accumulator, rejected: Some(server_error_of(m)) }),
        NoticeResponse -> gather[l](rest, timeouts, accumulator),
        NotificationResponse -> gather[l](queue_notification(rest, m), timeouts, accumulator),
        ReadyForQuery -> {
          let ready = { ..rest, status: status_after(m) };
          match accumulator.rejected {
            Some(server) -> Err(Rejected(ready, server)),
            None ->
              Ok({
                session: ready,
                result: {
                  columns: accumulator.columns,
                  rows: accumulator.rows,
                  tag: accumulator.tag,
                },
              }),
          }
        },
        _ -> gather[l](rest, timeouts, accumulator),
      }
    },
  }

/// The connection is done; the server expects nothing more.
pub fn finish<[l]>(
  s: Session,
  timeouts: Timeouts,
) -> Unit / {net.send[l], net.close[l], abort.raise} = {
  send_all[l](s.connection, terminate, timeouts.write_ms);
  net.close[l](s.connection)
}

/// What a `NOTIFY` delivered: the server process of the session that sent it, its channel, and its
/// payload.
pub type Notification = { sender: Int, channel: String, payload: String }

/// The notification a `NotificationResponse` carries.
pub fn notification(message: Message) -> Option<Notification> / {abort.raise} =
  match message.body.i32_be_at(0) {
    None -> None,
    Some(sender) -> match read_cstring(message.body, 4) {
      None -> None,
      Some(channel) -> match read_cstring(message.body, channel.next) {
        None -> None,
        Some(payload) -> Some({ sender: sender, channel: channel.text, payload: payload.text }),
      },
    },
  }

fn queue_notification(s: Session, message: Message) -> Session / {abort.raise} =
  match notification(message) { Some(n) -> { ..s, notices: s.notices.push(n) }, None -> s }

/// The session after a wait, and the notification it received: `None` when the deadline passed
/// first.
pub type WaitResult = { session: Session, notification: Option<Notification> }

/// Returns the next notification for a session that has sent `LISTEN`: the oldest one already
/// stored in the session, or the next one to arrive within `timeout_ms`. Parameter changes and
/// notices that arrive in between are skipped. An error response from the server in this wait means
/// the server is ending the session.
pub fn await_notification<[l]>(
  s: Session,
  timeout_ms: Int,
) -> Result<WaitResult, ClientError> / {net.recv[l], abort.raise, diverges} =
  match s.notices {
    [oldest, ..later] -> Ok({ session: { ..s, notices: later }, notification: Some(oldest) }),
    [] -> match arriving[l](s.connection, s.buffer, timeout_ms) {
      Err(e) -> Err(e),
      Ok(Incomplete(buffer)) -> Ok({ session: { ..s, buffer: buffer }, notification: None }),
      Ok(Arrived(got)) -> {
        let rest = { ..s, buffer: got.rest };
        let m = got.message;
        match m.kind {
          NotificationResponse -> match notification(m) {
            Some(n) -> Ok({ session: rest, notification: Some(n) }),
            None -> Err(Unexpected("a notification message could not be parsed")),
          },
          ParameterStatus -> await_notification[l](rest, timeout_ms),
          NoticeResponse -> await_notification[l](rest, timeout_ms),
          ErrorResponse -> Err(ConnectionRejected(server_error_of(m))),
          _ -> Err(Unexpected("a " ++ backend_name(m.kind) ++ " between statements")),
        }
      },
    },
  }

/// `CopyData`, a piece of what a copy in sends: a row need not end where a piece does.
pub fn copy_data(data: Bytes) -> Bytes / {abort.raise} = frontend(CopyData, data)

/// `CopyDone`, which ends a copy in and tells the server to keep what it was sent.
pub const copy_done: Bytes = frontend(CopyDone, b"")

/// `CopyFail`, which ends a copy in and tells the server to discard all of it, giving the reason.
pub fn copy_fail(reason: String) -> Bytes / {abort.raise} = frontend(CopyFail, cstring(reason))

/// One row in `COPY`'s text format: the values separated by tabs, `\N` for NULL, and a newline at
/// the end. A backslash, a tab, a newline and a carriage return in a value are written escaped, so
/// a value can contain any text.
pub fn copy_row(values: List<Option<String>>) -> Bytes =
  Bytes::join(
    values.map(|v: Option<String>|
      match v { None -> b"\\N", Some(text) -> copy_escaped(Bytes::of_string(text)) }),
    b"\t",
  ).concat(
    b"\n",
  )

fn copy_escaped(raw: Bytes) -> Bytes =
  Bytes::concat_all(
    range(0, raw.len()).map(|i: Int| {
      let c = raw.at(i);
      if c == 92 { b"\\\\" }
      else if c == 9 { b"\\t" }
      else if c == 10 { b"\\n" }
      else if c == 13 { b"\\r" }
      else { raw.slice(i, i + 1) }
    }),
  )

/// The values of one row in `COPY`'s text format, its newline already removed: `None` for a
/// NULL, and each other value the text the server printed, with its escapes decoded. A row that
/// ends in a backslash is not a valid row.
pub fn copy_fields(line: Bytes) -> Option<List<Option<Bytes>>> / {abort.raise} =
  match copy_split(line, 0, 0, [], line.len() + 1) {
    None -> None,
    Some(raw) ->
      Option::all(
        raw.map(|field: Bytes|
          if field == b"\\N" { Some(None) }
          else { match copy_unescaped(field) { Some(v) -> Some(Some(v)), None -> None } }),
      ),
  }

fn copy_split(
  line: Bytes,
  start: Int,
  at: Int,
  accumulator: List<Bytes>,
  left: Int,
) -> Option<List<Bytes>> / {abort.raise} =
  if left <= 0 { panic("splitting a copy line ran more steps than the line has bytes") }
  else if at >= line.len() { Some(accumulator.push(line.slice(start, at))) } else {
    let c = line.at(at);
    if c == 92 {
      if at + 1 >= line.len() { None }
      else { copy_split(line, start, at + 2, accumulator, left - 1) }
    } else if c == 9 {
      copy_split(line, at + 1, at + 1, accumulator.push(line.slice(start, at)), left - 1)
    } else { copy_split(line, start, at + 1, accumulator, left - 1) }
  }

fn copy_unescaped(field: Bytes) -> Option<Bytes> / {abort.raise} =
  unescaping(field, 0, b"", field.len() + 1)

fn unescaping(
  field: Bytes,
  at: Int,
  accumulator: Bytes,
  left: Int,
) -> Option<Bytes> / {abort.raise} =
  if left <= 0 { panic("decoding a copy field ran more steps than the field has bytes") }
  else if at >= field.len() { Some(accumulator) } else if field.at(at) != 92 {
    unescaping(field, at + 1, accumulator.concat(field.slice(at, at + 1)), left - 1)
  } else if at + 1 >= field.len() { None } else {
    let e = escape_at(field, at + 1);
    unescaping(field, e.next, accumulator.concat(e.byte), left - 1)
  }

type Escape = { byte: Bytes, next: Int }

fn escape_at(field: Bytes, at: Int) -> Escape / {abort.raise} = {
  let c = field.at(at);
  let one = |b: Int| { byte: byte_of_int(b), next: at + 1 };
  if c == 98 { one(8) }
  else if c == 102 { one(12) }
  else if c == 110 { one(10) }
  else if c == 114 { one(13) }
  else if c == 116 { one(9) }
  else if c == 118 { one(11) }
  else if c >= 48 && c <= 55 { digits(field, at, 8, 3) }
  else if c == 120 && at + 1 < field.len() && bytes::hex_value(field.at(at + 1)) >= 0 {
    digits(field, at + 1, 16, 2)
  } else { { byte: field.slice(at, at + 1), next: at + 1 } }
}

fn digits(field: Bytes, at: Int, radix: Int, most: Int) -> Escape / {abort.raise} = {
  let taken = range(0, most).fold(
    { value: 0, next: at, open: true },
    |accumulator: { value: Int, next: Int, open: Bool }, i: Int|
      if !accumulator.open || accumulator.next >= field.len() { { ..accumulator, open: false } }
      else {
        let d = bytes::digit_value(field.at(accumulator.next));
        if d < 0 || d >= radix { { ..accumulator, open: false } }
        else { { value: accumulator.value * radix + d, next: accumulator.next + 1, open: true } }
      },
  );
  { byte: byte_of_int(taken.value & 255), next: taken.next }
}

/// A copy in under way: the session, and how many columns the server expects in each row.
pub type CopyIn = { session: Session, columns: Int }

/// Sends `sql`, a `COPY ... FROM STDIN`, and returns once the server is waiting for rows. A
/// statement the server rejects leaves the session ready for the next one, as a rejected query
/// does.
pub fn copy_in_begin<[l]>(
  s: Session,
  sql: String,
  timeouts: Timeouts,
) -> Result<CopyIn, ClientError> / {net.send[l], net.recv[l], abort.raise, diverges} =
  if !send_all[l](s.connection, query(sql), timeouts.write_ms) { Err(NotSent) }
  else { copy_opened[l](s, timeouts, CopyInResponse) }

fn copy_opened<[l]>(
  s: Session,
  timeouts: Timeouts,
  opens: Backend,
) -> Result<CopyIn, ClientError> / {net.recv[l], abort.raise, diverges} =
  match read_message[l](s.connection, s.buffer, timeouts.read_ms) {
    Err(e) -> Err(e),
    Ok(got) -> {
      let m = got.message;
      let rest: Session = { ..s, buffer: got.rest };
      if m.kind == opens {
        match m.body.u16_be_at(1) {
          Some(n) -> Ok({ session: rest, columns: n }),
          None -> Err(Unexpected("a " ++ backend_name(opens) ++ " with no column count")),
        }
      } else {
        match m.kind {
          ErrorResponse -> match gather[l](rest, timeouts, {
              ..empty_result,
              rejected: Some(server_error_of(m)),
            }) {
            Ok(r) ->
              Err(
                Unexpected(
                  "the server rejected the copy, then reported the command tag " ++ r.result.tag,
                ),
              ),
            Err(e) -> Err(e),
          },
          NoticeResponse -> copy_opened[l](rest, timeouts, opens),
          NotificationResponse -> copy_opened[l](queue_notification(rest, m), timeouts, opens),
          _ -> Err(Unexpected("a " ++ backend_name(m.kind) ++ " where a copy was to begin")),
        }
      }
    },
  }

/// Sends a piece of a copy in; the server sends no reply until the copy ends.
pub fn copy_send<[l]>(
  c: CopyIn,
  data: Bytes,
  timeouts: Timeouts,
) -> Result<CopyIn, ClientError> / {net.send[l], abort.raise} =
  if data.len() == 0 || send_all[l](c.session.connection, copy_data(data), timeouts.write_ms) {
    Ok(c)
  } else { Err(NotSent) }

/// Ends a copy in and returns the server's reply. With `None`, the server commits the rows sent,
/// and the result's tag is `COPY n`, where `n` is the number of rows it accepted. With
/// `Some(reason)`, this sends `CopyFail`, the server discards everything sent, and the result is
/// its error (`57014`). Either way the session is ready for the next statement. If the server
/// rejected a row, that is also returned as an error here.
pub fn copy_in_end<[l]>(
  c: CopyIn,
  failure: Option<String>,
  timeouts: Timeouts,
) -> Result<Reply, ClientError> / {net.send[l], net.recv[l], abort.raise, diverges} = {
  let ending = match failure { None -> copy_done, Some(reason) -> copy_fail(reason) };
  if !send_all[l](c.session.connection, ending, timeouts.write_ms) { Err(NotSent) }
  else { gather[l](c.session, timeouts, empty_result) }
}

/// Sends `sql`, a `COPY ... TO STDOUT`, and returns once the server has begun to send rows, with
/// how many columns each has.
pub fn copy_out_begin<[l]>(
  s: Session,
  sql: String,
  timeouts: Timeouts,
) -> Result<CopyIn, ClientError> / {net.send[l], net.recv[l], abort.raise, diverges} =
  if !send_all[l](s.connection, query(sql), timeouts.write_ms) { Err(NotSent) }
  else { copy_opened[l](s, timeouts, CopyOutResponse) }

/// The session after a read of a copy out, and the piece read: `None` once the server has sent
/// everything and is ready for the next statement.
pub type Piece = { session: Session, data: Option<Bytes> }

/// The next piece of a copy out. An error partway through, such as a statement failing on a row,
/// is returned as that error, with the session ready for the next statement.
pub fn copy_out_take<[l]>(
  s: Session,
  timeouts: Timeouts,
) -> Result<Piece, ClientError> / {net.recv[l], abort.raise, diverges} =
  match read_message[l](s.connection, s.buffer, timeouts.read_ms) {
    Err(e) -> Err(e),
    Ok(got) -> {
      let m = got.message;
      let rest: Session = { ..s, buffer: got.rest };
      match m.kind {
        CopyChunk -> Ok({ session: rest, data: Some(m.body) }),
        CopyEnd -> match gather[l](rest, timeouts, empty_result) {
          Ok(r) -> Ok({ session: r.session, data: None }),
          Err(e) -> Err(e),
        },
        ErrorResponse -> match gather[l](rest, timeouts, {
            ..empty_result,
            rejected: Some(server_error_of(m)),
          }) {
          Ok(r) ->
            Err(
              Unexpected(
                "the server rejected the copy, then reported the command tag " ++ r.result.tag,
              ),
            ),
          Err(e) -> Err(e),
        },
        NoticeResponse -> copy_out_take[l](rest, timeouts),
        NotificationResponse -> copy_out_take[l](queue_notification(rest, m), timeouts),
        _ -> Err(Unexpected("a " ++ backend_name(m.kind) ++ " inside a copy out")),
      }
    },
  }

test "a start-up message is a length, the version, then the parameters" {
  let frame = startup("me", "db", []);
  assert_eq(frame.u32_be_at(0), Some(29));
  assert_eq(frame.u32_be_at(4), Some(196608));
  assert_eq(frame.slice_at(8, 5), Some(b"user\x00"));
  assert_eq(frame.slice_at(13, 3), Some(b"me\x00"));
  assert_eq(frame.slice_at(16, 9), Some(b"database\x00"));
  assert_eq(frame.at(frame.len() - 1), 0)
}

test "`startup` appends each run-time setting to the start-up message as a name and a value, in order" {
  let plain = startup("me", "db", []);
  let with_settings = startup("me", "db", [
    { name: "statement_timeout", value: "250" },
    { name: "application_name", value: "service" },
  ]);
  let settings = b"statement_timeout\x00250\x00application_name\x00service\x00";
  assert_eq(with_settings.u32_be_at(0), Some(29 + settings.len()));
  assert_eq(with_settings.slice_at(28, settings.len()), Some(settings));
  assert_eq(with_settings.slice(4, 28), plain.slice(4, 28));
  assert_eq(with_settings.at(with_settings.len() - 1), 0)
}

test "`ssl_request` returns the 8-byte message that carries the protocol's reserved code 80877103" {
  assert_eq(ssl_request, u32_be(8).concat(u32_be(80877103)))
}

test "a simple query is a kind byte, a length and the text" {
  assert_eq(query("select 1"), Bytes::concat_all([b"Q", u32_be(13), b"select 1", b"\x00"]))
}

test "a bind carries its values as text, with -1 for null" {
  let frame = bind("", "", [Some("a"), None]);
  let body = Bytes::concat_all([
    b"\x00",
    b"\x00",
    u16_be(0),
    u16_be(2),
    i32_be(1),
    b"a",
    i32_be(-1),
    u16_be(0),
  ]);
  assert_eq(frame, Bytes::concat_all([b"B", u32_be(body.len() + 4), body]))
}

test "`read` returns the complete frames in a buffer and returns an incomplete trailing frame as unread bytes" {
  let one = Bytes::concat_all([byte_of_int(90), u32_be(5), b"I"]);
  let two = Bytes::concat_all([byte_of_int(67), u32_be(13), b"SELECT 1\x00"]);
  let whole = Bytes::concat_all([one, two]);
  let frames = read(whole);
  assert_eq(frames.done.len(), 2);
  assert_eq(frames.rest, b"");
  assert_eq(frames.done, [
    { kind: ReadyForQuery, body: b"I" },
    { kind: CommandComplete, body: b"SELECT 1\x00" },
  ]);
  let partial = one.concat(two.slice(0, 6));
  let waiting = read(partial);
  assert_eq(waiting.done.len(), 1);
  assert_eq(waiting.rest, two.slice(0, 6))
}

test "a frame with a length shorter than its own header is not a frame" {
  let frames = read(Bytes::concat_all([byte_of_int(90), u32_be(3), b"I"]));
  assert_eq(frames.done.len(), 0);
  assert_eq(frames.rest, Bytes::concat_all([byte_of_int(90), u32_be(3), b"I"]))
}

test "a message with an unknown type byte is read as `Other` holding that byte, and `backend_name` prints it as `Other(87)`" {
  let frames = read(Bytes::concat_all([byte_of_int(87), u32_be(4)]));
  assert_eq(frames.done, [{ kind: Other(87), body: b"" }]);
  assert_eq(backend_name(Other(87)), "Other(87)")
}

test "`auth_code` and `auth_body` return an authentication message's code and payload, and `auth_name` maps a code to its name or `Authentication(code)`" {
  let ok = { kind: Authentication, body: u32_be(0).concat(b"") };
  assert_eq(auth_code(ok), Some(0));
  assert_eq(auth_name(0), "AuthenticationOk");
  let sasl = { kind: Authentication, body: u32_be(10).concat(b"SCRAM-SHA-256\x00") };
  assert_eq(auth_code(sasl), Some(10));
  assert_eq(auth_body(sasl), Some(b"SCRAM-SHA-256\x00"));
  assert_eq(auth_name(5), "AuthenticationMD5Password");
  assert_eq(auth_name(99), "Authentication(99)")
}

test "a ready-for-query reports which state the transaction is in" {
  assert_eq(ready_status({ kind: ReadyForQuery, body: b"I" }), Some(73));
  assert_eq(status_of(73), Idle);
  assert_eq(status_of(69), FailedTransaction);
  assert_eq(status_name(status_of(84)), "in transaction");
  assert_eq(ready_status({ kind: ReadyForQuery, body: b"" }), None)
}

test "a data row is its columns, with None for a null" {
  let body = Bytes::concat_all([u16_be(2), i32_be(3), b"abc", i32_be(-1)]);
  assert_eq(data_row({ kind: DataRow, body: body }), Some([Some(b"abc"), None]));
  let short = Bytes::concat_all([u16_be(1), i32_be(9), b"abc"]);
  assert_eq(data_row({ kind: DataRow, body: short }), None)
}

test "a row description names its columns and their types" {
  let body = Bytes::concat_all([
    u16_be(1),
    b"sku\x00",
    u32_be(16385),
    u16_be(1),
    u32_be(25),
    u16_be(-1),
    i32_be(-1),
    u16_be(0),
  ]);
  assert_eq(
    row_description({ kind: RowDescription, body: body }),
    Some([{ name: "sku", ty: 25, format: 0 }]),
  );
  assert_eq(row_description({ kind: RowDescription, body: u16_be(0) }), Some([]))
}

test "a diagnostic is a list of fields, and one is found by its code" {
  let body = Bytes::concat_all([b"SERROR\x00", b"C42P01\x00", b"Mno such table\x00", b"\x00"]);
  let m = { kind: ErrorResponse, body: body };
  assert_eq(diagnostic_fields(m), [
    { code: 83, text: "ERROR" },
    { code: 67, text: "42P01" },
    { code: 77, text: "no such table" },
  ]);
  assert_eq(field_of(m, 67), Some("42P01"));
  assert_eq(field_of(m, 90), None);
  assert_eq(diagnostic_fields({ kind: ErrorResponse, body: b"\x00" }), [])
}

test "`command_tag`, `parameter_status` and `parameter_types` parse their messages, and return none for an empty command tag" {
  assert_eq(command_tag({ kind: CommandComplete, body: b"SELECT 3\x00" }), Some("SELECT 3"));
  assert_eq(command_tag({ kind: CommandComplete, body: b"" }), None);
  assert_eq(
    parameter_status({ kind: ParameterStatus, body: b"server_version\x00\x31\x36\x00" }),
    Some({ name: "server_version", value: "16" }),
  );
  assert_eq(
    parameter_types({
      kind: ParameterDescription,
      body: Bytes::concat_all([u16_be(2), u32_be(23), u32_be(25)]),
    }),
    Some([23, 25]),
  )
}

test "a backend key message parses into the process id and secret key that a cancel request needs" {
  assert_eq(
    backend_key({ kind: BackendKeyData, body: u32_be(4321).concat(u32_be(8765)) }),
    Some({ pid: 4321, secret: 8765 }),
  );
  assert_eq(backend_key({ kind: BackendKeyData, body: b"abc" }), None)
}

test "the mechanisms an authentication message offers" {
  let offered = Bytes::concat_all([b"SCRAM-SHA-256\x00", b"PLAIN\x00", b"\x00"]);
  assert_eq(mechanisms({ kind: Authentication, body: u32_be(10).concat(offered) }), [
    "SCRAM-SHA-256",
    "PLAIN",
  ]);
  let plain = Bytes::concat_all([b"PLAIN\x00", b"\x00"]);
  assert_eq(mechanisms({ kind: Authentication, body: u32_be(10).concat(plain) }), ["PLAIN"]);
  assert_eq(choose_binding(Plaintext, ["PLAIN"]), Err(no_scram))
}

fn sample_certificate(algorithm: Bytes, params: Bytes) -> Bytes / {abort.raise} = {
  let length = |n: Int|
    if n < 128 { byte_of_int(n) }
    else { Bytes::concat_all([byte_of_int(130), byte_of_int(n / 256), byte_of_int(n % 256)]) };
  let element = |tag: Int, content: Bytes|
    Bytes::concat_all([byte_of_int(tag), length(content.len()), content]);
  let subject = range(0, 300).fold(b"", |accumulator: Bytes, i: Int| accumulator.concat(b"s"));
  element(
    48,
    Bytes::concat_all([
      element(48, element(2, b"\x01").concat(element(4, subject))),
      element(48, element(6, algorithm).concat(params)),
      element(3, b"\x00\x01"),
    ]),
  )
}

test "`end_point` hashes a certificate with the hash algorithm its signature names, using SHA-256 for MD5 and SHA-1" {
  let rsa = |last: Bytes| b"\x2a\x86\x48\x86\xf7\x0d\x01\x01".concat(last);
  let ecdsa = |rest: Bytes| b"\x2a\x86\x48\xce\x3d\x04".concat(rest);
  let bound = |algorithm: Bytes, params: Bytes| {
    let der = sample_certificate(algorithm, params);
    (end_point(der), der)
  };
  let sha256_of = |p: (Option<Bytes>, Bytes)| p._0 == Some(sha256(p._1));
  assert(sha256_of(bound(rsa(b"\x0b"), b"\x05\x00")));
  assert(sha256_of(bound(rsa(b"\x05"), b"\x05\x00")));
  assert(sha256_of(bound(rsa(b"\x04"), b"\x05\x00")));
  assert(sha256_of(bound(ecdsa(b"\x03\x02"), b"")));
  assert(sha256_of(bound(ecdsa(b"\x01"), b"")));
  let sha384_rsa = bound(rsa(b"\x0c"), b"\x05\x00");
  assert_eq(sha384_rsa._0, Some(sha384(sha384_rsa._1)));
  let sha512_ecdsa = bound(ecdsa(b"\x03\x04"), b"");
  assert_eq(sha512_ecdsa._0, Some(sha512(sha512_ecdsa._1)));
  let pss_sha384 = bound(
    rsa(b"\x0a"),
    b"\x30\x0f\xa0\x0d\x30\x0b\x06\x09\x60\x86\x48\x01\x65\x03\x04\x02\x02",
  );
  assert_eq(pss_sha384._0, Some(sha384(pss_sha384._1)));
  assert(sha256_of(bound(rsa(b"\x0a"), b"\x30\x00")));
  assert_eq(bound(b"\x2b\x65\x70", b"")._0, None);
  assert_eq(end_point(b"\x30\x05\x30"), None);
  let whole = sample_certificate(rsa(b"\x0b"), b"\x05\x00");
  assert_eq(end_point(whole.slice(0, whole.len() - 1)), None)
}

fn scram_outcome(
  script: List<net::Step>,
  tls: Tls,
  certificate: Bytes,
) -> String / {abort.raise, diverges} = {
  let server = ip::socket_at(ip::loopback_v4, 5432);
  let world = net::mem_server_certificate(
    net::mem_serving(net::mem_empty(), server, [script]),
    "db.example",
    certificate,
  );
  let over = net::on_mem(world, ||
    connect[conn](
      "127.0.0.1",
      5432,
      tls,
      "ply",
      "ply",
      [],
      Some(Secret::of_bytes(b"pencil")),
      "n",
      default_timeouts,
    ));
  match over.value { Ok(_) -> "connected", Err(e) -> client_error_text(e) }
}

fn sasl_offer(names: List<String>) -> Bytes / {abort.raise} =
  message_frame(82, Bytes::concat_all([u32_be(10), Bytes::concat_all(names.map(cstring)), b"\x00"]))

fn scram_first_frame(mechanism: String, header: String) -> Bytes / {abort.raise} = {
  let raw = Bytes::of_string(header ++ "n=ply,r=n");
  message_frame(112, Bytes::concat_all([cstring(mechanism), i32_be(raw.len()), raw]))
}

test "over TLS, SCRAM binds to the server's certificate when the server offers SCRAM-SHA-256-PLUS, and otherwise runs without binding" {
  let begun = startup("ply", "ply", []);
  let rejected = message_frame(69, b"SFATAL\x00C28P01\x00Mno\x00\x00");
  let der = sample_certificate(b"\x2a\x86\x48\xce\x3d\x04\x03\x02", b"");
  let both = sasl_offer(["SCRAM-SHA-256-PLUS", "SCRAM-SHA-256"]);
  let plus = scram_outcome(
    [
      net::Upgrades,
      net::Expects(begun),
      Sends(both),
      net::Expects(scram_first_frame("SCRAM-SHA-256-PLUS", "p=tls-server-end-point,,")),
      Sends(rejected),
    ],
    Direct("db.example"),
    der,
  );
  assert(plus.contains("28P01"));
  let stripped = scram_outcome(
    [
      net::Upgrades,
      net::Expects(begun),
      Sends(sasl_offer(["SCRAM-SHA-256"])),
      net::Expects(scram_first_frame("SCRAM-SHA-256", "y,,")),
      Sends(rejected),
    ],
    Direct("db.example"),
    der,
  );
  assert(stripped.contains("28P01"));
  let plain = scram_outcome(
    [
      net::Expects(begun),
      Sends(both),
      net::Expects(scram_first_frame("SCRAM-SHA-256", "n,,")),
      Sends(rejected),
    ],
    NoTls,
    der,
  );
  assert(plain.contains("28P01"));
  let unbindable = scram_outcome(
    [net::Upgrades, net::Expects(begun), Sends(both)],
    Direct("db.example"),
    sample_certificate(b"\x2b\x65\x70", b""),
  );
  assert(unbindable.contains("names no hash"))
}

fn message_frame(kind: Int, body: Bytes) -> Bytes / {abort.raise} =
  byte_of_int(kind).concat(length_prefixed(body))

fn sample_session(connection: Int) -> Session =
  {
    connection: connection,
    buffer: b"",
    user: "ply",
    database: "ply",
    settings: [],
    status: Idle,
    notices: [],
  }

fn scripted_queries(
  chunks: List<Bytes>,
  sqls: List<String>,
) -> List<Result<Reply, ClientError>> / {net::socket.fail, abort.raise, diverges} = {
  let server = ip::socket_at(ip::loopback_v4, 5432);
  let scripted = net::mem_serving(net::mem_empty(), server, [
    chunks.map(|chunk: Bytes| Sends(chunk)),
  ]);
  net::on_mem(scripted, ||
    sqls.fold(
      { session: sample_session(net::dial_address[conn](server, [], 1000)), results: [] },
      |accumulator: { session: Session, results: List<Result<Reply, ClientError>> }, sql: String| {
        let result = simple_query[conn](accumulator.session, sql, default_timeouts);
        let next = match result {
          Ok(r) -> r.session,
          Err(Rejected(s, _)) -> s,
          Err(_) -> accumulator.session,
        };
        { session: next, results: accumulator.results.push(result) }
      },
    ).results).value
}

test "a server error carries its SQLSTATE, the constraint it names and its detail" {
  let body = Bytes::concat_all([
    b"SERROR\x00",
    b"C23505\x00",
    b"Mduplicate key value violates unique constraint \"part_pkey\"\x00",
    b"DKey (sku)=(a) already exists.\x00",
    b"npart_pkey\x00",
    b"\x00",
  ]);
  assert_eq(server_error_of({ kind: ErrorResponse, body: body }), {
    severity: "ERROR",
    code: "23505",
    message: "duplicate key value violates unique constraint \"part_pkey\"",
    detail: "Key (sku)=(a) already exists.",
    constraint: "part_pkey",
  })
}

test "a server error that ends the session still returns its SQLSTATE code and severity" {
  let fatal = message_frame(
    69,
    b"SFATAL\x00C57P01\x00Mterminating connection due to administrator command\x00\x00",
  );
  match scripted_queries([fatal], ["select 1"]) {
    [Err(ConnectionRejected(s))] -> {
      assert_eq(s.code, "57P01");
      assert_eq(s.severity, "FATAL")
    },
    _ -> panic("the rejection was lost to the hang-up"),
  }
}

test "a frame shorter than its own length field is rejected rather than waited on" {
  let short = Bytes::concat_all([byte_of_int(90), u32_be(3), b"I"]);
  match scripted_queries([short, short], ["select 1"]) {
    [Err(Unexpected(reason))] ->
      assert(reason.contains("a length below 4, the size of the length field itself")),
    _ -> panic("a malformed frame was waited on"),
  }
}

test "a session records the transaction status from the server's last ready-for-query message" {
  let rejected = message_frame(69, b"SERROR\x00C22012\x00Mdivision by zero\x00\x00").concat(
    message_frame(90, b"E"),
  );
  let rolled = message_frame(67, b"ROLLBACK\x00").concat(message_frame(90, b"I"));
  match scripted_queries([rejected, rolled], ["select 1/0", "rollback"]) {
    [Err(Rejected(failed, s)), Ok(r)] -> {
      assert_eq(s.code, "22012");
      assert_eq(failed.status, FailedTransaction);
      assert_eq(r.session.status, Idle);
      assert_eq(r.result.tag, "ROLLBACK")
    },
    _ -> panic("the two exchanges did not respond with a rejection and then a rollback"),
  }
}

const welcome: Bytes = message_frame(82, u32_be(0)).concat(message_frame(90, b"I"))

type ConnectOutcome = { outcome: String, secured: Option<String>, sent: Bytes }

fn scripted_connect(script: List<net::Step>, tls: Tls) -> ConnectOutcome / {abort.raise, diverges} = {
  let server = ip::socket_at(ip::loopback_v4, 5432);
  let over = net::on_mem(net::mem_serving(net::mem_empty(), server, [script]), ||
    connect[conn]("127.0.0.1", 5432, tls, "ply", "ply", [], None, "n", default_timeouts));
  {
    outcome: match over.value { Ok(_) -> "connected", Err(e) -> client_error_text(e) },
    secured: net::mem_secured(over.net, 1),
    sent: net::mem_sent(over.net, 1),
  }
}

test "an ssl request the server accepts secures the connection before the start-up is sent" {
  let begun = startup("ply", "ply", []);
  let c = scripted_connect(
    [net::Expects(ssl_request), Sends(b"S"), net::Upgrades, net::Expects(begun), Sends(welcome)],
    Requested("db.example"),
  );
  assert_eq(c.outcome, "connected");
  assert_eq(c.secured, Some("db.example"));
  assert_eq(c.sent, ssl_request.concat(begun))
}

test "a server that will not speak TLS is rejected, and nothing more is sent in plaintext" {
  let c = scripted_connect([net::Expects(ssl_request), Sends(b"N")], Requested("db.example"));
  assert_eq(c.outcome, client_error_text(Declined));
  assert_eq(c.secured, None);
  assert_eq(c.sent, ssl_request)
}

test "connecting fails with an unsecured error when the server sends extra plaintext after agreeing to TLS, and no handshake starts" {
  let c = scripted_connect(
    [net::Expects(ssl_request), Sends(b"SR\x00\x00\x00\x08\x00\x00\x00\x00"), net::Upgrades],
    Requested("db.example"),
  );
  assert_eq(c.outcome, client_error_text(Unsecured(net::Injected)));
  assert_eq(c.secured, None);
  assert_eq(c.sent, ssl_request)
}

test "a certificate not trusted for the name ends the connection before the start-up" {
  let c = scripted_connect(
    [net::Expects(ssl_request), Sends(b"S"), net::Rejects(net::Untrusted)],
    Requested("db.example"),
  );
  assert_eq(c.outcome, client_error_text(Unsecured(net::Untrusted)));
  assert_eq(c.sent, ssl_request)
}

test "direct negotiation begins the handshake first, with no ssl request" {
  let begun = startup("ply", "ply", []);
  let c = scripted_connect(
    [net::Upgrades, net::Expects(begun), Sends(welcome)],
    Direct("db.example"),
  );
  assert_eq(c.outcome, "connected");
  assert_eq(c.secured, Some("db.example"));
  assert_eq(c.sent, begun);
  let plain = scripted_connect([net::Expects(begun), Sends(welcome)], NoTls);
  assert_eq(plain.outcome, "connected");
  assert_eq(plain.secured, None)
}

fn scripted_authentication(
  script: List<net::Step>,
  password: Option<Secret<Bytes>>,
) -> { outcome: String, sent: Bytes, sealed: Int } / {abort.raise, diverges} = {
  let server = ip::socket_at(ip::loopback_v4, 5432);
  let over = net::on_mem(net::mem_serving(net::mem_empty(), server, [script]), ||
    connect[conn]("127.0.0.1", 5432, NoTls, "ply", "ply", [], password, "n", default_timeouts));
  {
    outcome: match over.value { Ok(_) -> "connected", Err(e) -> client_error_text(e) },
    sent: net::mem_sent(over.net, 1),
    sealed: net::mem_sent_secrets(over.net, 1).len(),
  }
}

test "a clear-text password is sent only as one secret message of `p`, length, password and a zero byte, and never appears in the plain sent bytes" {
  let begun = startup("ply", "ply", []);
  let authentication_request = message_frame(82, u32_be(3));
  let c = scripted_authentication(
    [
      net::Expects(begun),
      Sends(authentication_request),
      net::ExpectsSecret(Bytes::concat_all([b"p", u32_be(11), b"pencil\x00"])),
      Sends(welcome),
    ],
    Some(Secret::of_bytes(b"pencil")),
  );
  assert_eq(c.outcome, "connected");
  assert_eq(c.sent, begun);
  assert_eq(c.sealed, 1);
  let none = scripted_authentication([net::Expects(begun), Sends(authentication_request)], None);
  assert_eq(
    none.outcome,
    client_error_text(ConnectionRejected(no_password("ply", "a clear-text password"))),
  );
  assert_eq(none.sent, begun);
  assert_eq(none.sealed, 0)
}

fn notification_frame(sender: Int, channel: String, payload: String) -> Bytes / {abort.raise} =
  message_frame(65, Bytes::concat_all([u32_be(sender), cstring(channel), cstring(payload)]))

fn scripted_waits(
  script: List<net::Step>,
  waits: Int,
) -> List<Option<Notification>> / {net::socket.fail, abort.raise, diverges} = {
  let server = ip::socket_at(ip::loopback_v4, 5432);
  net::on_mem(net::mem_serving(net::mem_empty(), server, [script]), || {
    let s = sample_session(net::dial_address[conn](server, [], 1000));
    range(0, waits).fold(
      { session: s, output_lines: [] },
      |accumulator: { session: Session, output_lines: List<Option<Notification>> }, i: Int|
        match await_notification[conn](accumulator.session, 50) {
          Ok(w) ->
            { session: w.session, output_lines: accumulator.output_lines.push(w.notification) },
          Err(e) -> panic(client_error_text(e)),
        },
    ).output_lines
  }).value
}

test "a notification split across several reads is parsed whole, and a timeout during the wait loses no bytes" {
  let one = notification_frame(4242, "orders", "7");
  let two = notification_frame(4242, "orders", "");
  let settings = message_frame(83, b"TimeZone\x00UTC\x00");
  assert_eq(
    scripted_waits(
      [
        Sends(one.slice(0, 7)),
        net::Stalls,
        Sends(one.slice(7, one.len())),
        Sends(settings.concat(two)),
        net::Silent,
      ],
      4,
    ),
    [
      None,
      Some({ sender: 4242, channel: "orders", payload: "7" }),
      Some({ sender: 4242, channel: "orders", payload: "" }),
      None,
    ],
  )
}

test "a notification that arrives while a statement is running is stored for the next wait" {
  let server = ip::socket_at(ip::loopback_v4, 5432);
  let returned = Bytes::concat_all([
    message_frame(67, b"LISTEN\x00"),
    notification_frame(9, "jobs", "early"),
    message_frame(90, b"I"),
  ]);
  let received_notification = net::on_mem(
    net::mem_serving(net::mem_empty(), server, [
      [net::Expects(query("listen jobs")), Sends(returned), net::Silent],
    ]),
    || {
      let s = sample_session(net::dial_address[conn](server, [], 1000));
      match simple_query[conn](s, "listen jobs", default_timeouts) {
        Err(e) -> panic(client_error_text(e)),
        Ok(r) -> match await_notification[conn](r.session, 50) {
          Err(e) -> panic(client_error_text(e)),
          Ok(w) -> w.notification,
        },
      }
    },
  ).value;
  assert_eq(received_notification, Some({ sender: 9, channel: "jobs", payload: "early" }))
}

test "a row's values are written in COPY's text format, every escape where one is needed" {
  assert_eq(copy_row([Some("a"), None, Some("")]), b"a\t\\N\t\n");
  assert_eq(
    copy_row([Some("tab\there"), Some("line\nbreak\r"), Some("back\\slash")]),
    b"tab\\there\tline\\nbreak\\r\tback\\\\slash\n",
  );
  assert_eq(copy_row([Some("\\N")]), b"\\\\N\n")
}

test "`copy_fields` parses a COPY text row, decoding each escape sequence the server may write, and fails on a trailing backslash" {
  assert_eq(copy_fields(b"a\t\\N\t"), Some([Some(b"a"), None, Some(b"")]));
  assert_eq(copy_fields(b"\\b\\f\\v\\101\\x41\\q\\\\N"), Some([Some(b"\x08\x0c\x0bAAq\\N")]));
  assert_eq(copy_fields(b"one\\\ttab"), Some([Some(b"one\ttab")]));
  assert_eq(copy_fields(b"cut\\"), None)
}

test "a row written in COPY's text format reads back as the values it was written from" {
  gen::check(gen::list(gen::option_of(gen::text())), |values: List<Option<String>>|
    if values.len() > 0 {
      copy_fields(copy_row(values).slice(0, copy_row(values).len() - 1))
        == Some(
          values.map(|v: Option<String>|
            match v { Some(t) -> Some(Bytes::of_string(t)), None -> None }),
        )
    } else { true })
}

fn scripted_copy<a>(
  script: List<net::Step>,
  go: (Session) -> a / {net.send[conn], net.recv[conn], abort.raise, diverges},
) -> a / {net::socket.fail, abort.raise, diverges} = {
  let server = ip::socket_at(ip::loopback_v4, 5432);
  net::on_mem(net::mem_serving(net::mem_empty(), server, [script]), ||
    go(sample_session(net::dial_address[conn](server, [], 1000)))).value
}

fn copy_response_frame(kind: Int, columns: Int) -> Bytes / {abort.raise} =
  message_frame(
    kind,
    Bytes::concat_all([
      b"\x00",
      u16_be(columns),
      Bytes::concat_all(range(0, columns).map(|i: Int| u16_be(0))),
    ]),
  )

test "a copy in sends its rows as data and reports how many the server accepted" {
  let sql = "copy items (id, name) from stdin";
  let rows = copy_row([Some("1"), Some("one")]).concat(copy_row([Some("2"), None]));
  let tag = scripted_copy(
    [
      net::Expects(query(sql)),
      Sends(copy_response_frame(71, 2)),
      net::Expects(copy_data(rows)),
      net::Expects(copy_done),
      Sends(message_frame(67, b"COPY 2\x00").concat(message_frame(90, b"I"))),
    ],
    |s: Session|
      match copy_in_begin[conn](s, sql, default_timeouts) {
        Err(e) -> client_error_text(e),
        Ok(c) -> {
          assert_eq(c.columns, 2);
          match copy_send[conn](c, rows, default_timeouts) {
            Err(e) -> client_error_text(e),
            Ok(sent) -> match copy_in_end[conn](sent, None, default_timeouts) {
              Err(e) -> client_error_text(e),
              Ok(r) -> r.result.tag,
            },
          }
        },
      },
  );
  assert_eq(tag, "COPY 2")
}

test "a failed copy in returns the server's error, and the session is left ready" {
  let sql = "copy items (id) from stdin";
  let code = scripted_copy(
    [
      net::Expects(query(sql)),
      Sends(copy_response_frame(71, 1)),
      net::Expects(copy_fail("the rows ran out")),
      Sends(
        message_frame(
          69,
          b"SERROR\x00C57014\x00MCOPY from stdin failed: the rows ran out\x00\x00",
        ).concat(
          message_frame(90, b"I"),
        ),
      ),
    ],
    |s: Session|
      match copy_in_begin[conn](s, sql, default_timeouts) {
        Err(e) -> client_error_text(e),
        Ok(c) -> match copy_in_end[conn](c, Some("the rows ran out"), default_timeouts) {
          Err(Rejected(after, server)) -> server.code ++ " " ++ status_name(after.status),
          Err(e) -> client_error_text(e),
          Ok(_) -> "kept",
        },
      },
  );
  assert_eq(code, "57014 idle")
}

test "a copy out returns one chunk of data per call, then returns no data once the server is ready again" {
  let sql = "copy (select id from items) to stdout";
  let pieces = scripted_copy(
    [
      net::Expects(query(sql)),
      Sends(
        Bytes::concat_all([
          copy_response_frame(72, 1),
          message_frame(100, b"1\n"),
          message_frame(100, b"2\n3\n"),
          message_frame(99, b""),
          message_frame(67, b"COPY 3\x00"),
          message_frame(90, b"I"),
        ]),
      ),
    ],
    |s: Session|
      match copy_out_begin[conn](s, sql, default_timeouts) {
        Err(e) -> [client_error_text(e)],
        Ok(c) ->
          range(0, 3).fold(
            { session: c.session, messages: [] },
            |accumulator: { session: Session, messages: List<String> }, i: Int|
              match copy_out_take[conn](accumulator.session, default_timeouts) {
                Err(e) ->
                  { ..accumulator, messages: accumulator.messages.push(client_error_text(e)) },
                Ok(p) ->
                  {
                    session: p.session,
                    messages: accumulator.messages.push(match p.data {
                      Some(d) -> String::of_bytes(d),
                      None -> "end",
                    }),
                  },
              },
          ).messages,
      },
  );
  assert_eq(pieces, ["1\n", "2\n3\n", "end"])
}

const server_greeting: Bytes =
  Bytes::concat_all([
    message_frame(82, u32_be(0)),
    message_frame(83, cstring("server_version").concat(cstring("16.0"))),
    message_frame(75, u32_be(7).concat(u32_be(9))),
    message_frame(90, b"I"),
  ])

fn one_row_frames(value: String) -> Bytes / {abort.raise} =
  message_frame(
    84,
    Bytes::concat_all([
      u16_be(1),
      cstring("?column?"),
      u32_be(0),
      u16_be(0),
      u32_be(23),
      u16_be(4),
      i32_be(0 - 1),
      u16_be(0),
    ]),
  ).concat(
    message_frame(68, Bytes::concat_all([u16_be(1), u32_be(value.len()), Bytes::of_string(value)])),
  )

const select_one_frames: Bytes =
  Bytes::concat_all([
    one_row_frames("1"),
    message_frame(67, cstring("SELECT 1")),
    message_frame(90, b"I"),
  ])

fn extended_one_frames(value: String) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    message_frame(49, b""),
    message_frame(50, b""),
    one_row_frames(value),
    message_frame(67, cstring("SELECT 1")),
    message_frame(90, b"I"),
  ])

fn error_frames(code: String, text: String) -> Bytes / {abort.raise} =
  message_frame(
    69,
    Bytes::concat_all([b"S", cstring("ERROR"), b"C", cstring(code), b"M", cstring(text), b"\x00"]),
  ).concat(
    message_frame(90, b"I"),
  )

fn first_value_text(result: QueryResult) -> String / {abort.raise} =
  match result.rows {
    [[Some(text), ..], ..] -> String::of_bytes(text),
    [[None, ..], ..] -> "null",
    _ -> "no value",
  }

fn scripted_exchange(
  chunks: List<Bytes>,
  password: Option<Secret<Bytes>>,
  nonce: String,
  ask: (Session) -> Result<String, ClientError> / {net.send[conn], net.recv[conn], net.close[conn], abort.raise, diverges},
) -> { result: Result<String, String>, sent: Bytes } / {abort.raise, diverges} = {
  let server = ip::socket_at(ip::loopback_v4, 5432);
  let over = net::on_mem(
    net::mem_serving(net::mem_empty(), server, [chunks.map(|c: Bytes| Sends(c))]),
    ||
      match connect[conn](
          "127.0.0.1",
          5432,
          NoTls,
          "user",
          "ply",
          [],
          password,
          nonce,
          default_timeouts,
        ) {
        Err(e) -> Err(client_error_text(e)),
        Ok(session) -> match ask(session) {
          Err(e) -> Err(client_error_text(e)),
          Ok(text) -> Ok(text),
        },
      },
  );
  { result: over.value, sent: net::mem_sent(over.net, 1) }
}

test "a client shakes hands, runs a query and terminates over a scripted server" {
  let ran = scripted_exchange([server_greeting, select_one_frames], None, "n", |s: Session|
    match simple_query[conn](s, "select 1", default_timeouts) {
      Err(e) -> Err(e),
      Ok(reply) -> {
        finish[conn](reply.session, default_timeouts);
        Ok(first_value_text(reply.result))
      },
    });
  assert_eq(ran.result, Ok("1"));
  let declared = match ran.sent.u32_be_at(0) { Some(n) -> n, None -> 0 };
  assert_eq(ran.sent.u32_be_at(4), Some(196608));
  assert_eq(ran.sent.at(declared), 81);
  assert(contains_bytes(ran.sent, b"user\x00user\x00database\x00ply\x00"));
  assert(contains_bytes(ran.sent, b"select 1"));
  assert(ran.sent.ends_with(b"X\x00\x00\x00\x04"))
}

test "`extended_query` sends its parameters as text in a single parse message" {
  let ran = scripted_exchange(
    [server_greeting, extended_one_frames("hello")],
    None,
    "n",
    |s: Session|
      match extended_query[conn](s, "select $1", [Some("hello")], default_timeouts) {
        Err(e) -> Err(e),
        Ok(reply) -> Ok(first_value_text(reply.result)),
      },
  );
  assert_eq(ran.result, Ok("hello"));
  assert(contains_bytes(ran.sent, b"select $1") && contains_bytes(ran.sent, b"hello"));
  assert_eq(ran.sent.split(b"\x00P").len() - 1, 1)
}

test "an error comes back with its SQLSTATE and leaves the connection usable" {
  let ran = scripted_exchange(
    [server_greeting, error_frames("42P01", "relation \"nope\" does not exist"), select_one_frames],
    None,
    "n",
    |s: Session|
      match simple_query[conn](s, "select nope", default_timeouts) {
        Err(Rejected(after, rejection)) -> match simple_query[conn](
            after,
            "select 1",
            default_timeouts,
          ) {
          Err(e) -> Err(e),
          Ok(reply) ->
            Ok(server_error_text(rejection) ++ " then " ++ first_value_text(reply.result)),
        },
        Err(e) -> Err(e),
        Ok(_) -> Ok("the server accepted what it should have rejected"),
      },
  );
  match ran.result {
    Ok(text) -> assert(text.contains("42P01") && text.ends_with("then 1"), Some(text)),
    Err(reason) -> panic(reason),
  };
  assert(contains_bytes(ran.sent, b"select nope") && contains_bytes(ran.sent, b"select 1"))
}

const scram_server_greeting: Bytes =
  Bytes::concat_all([
    message_frame(82, Bytes::concat_all([u32_be(10), cstring("SCRAM-SHA-256"), b"\x00"])),
    message_frame(
      82,
      u32_be(11).concat(
        b"r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,s=W22ZaJ0SNY7soEsUEjb6gQ==,i=4096",
      ),
    ),
    message_frame(82, u32_be(12).concat(b"v=6rriTRBi23WpRR/wtup+mMhUZUn/dB5nLTJRsjl95G4=")),
    message_frame(82, u32_be(0)),
    message_frame(90, b"I"),
  ])

test "the client sends the SCRAM proof from RFC 7677 and verifies the server's proof" {
  let ran = scripted_exchange(
    [scram_server_greeting, select_one_frames],
    Some(Secret::of_string("pencil").bytes()),
    "rOprNGfwEbeRWgbNEkqO",
    |s: Session|
      match simple_query[conn](s, "select 1", default_timeouts) {
        Err(e) -> Err(e),
        Ok(reply) -> Ok(first_value_text(reply.result)),
      },
  );
  assert_eq(ran.result, Ok("1"));
  assert(contains_bytes(ran.sent, b"SCRAM-SHA-256"));
  assert(contains_bytes(ran.sent, b"n=user,r=rOprNGfwEbeRWgbNEkqO"));
  assert(contains_bytes(ran.sent, b"p=dHzbZapWIk4jUhN+Ute9ytag9zjfMHgsqmmiz7AndVQ="))
}
