//! Code shared by the `std.zstd` and `std.brotli` encoders: finding repeated bytes, and building a
//! prefix code from how often each symbol occurs.
//!
//! `find_matches` searches a block for matches and returns it as sequences, each a run of literals
//! followed by a match. `code_lengths` builds a Huffman code limited to a maximum length.
//! `code_bases` builds the table both formats use to write a length or a count as a code plus a
//! few extra bits.

import std.bytes
import std.list

/// Each code's base value and number of extra bits, packed as `base << 5 | extra`. A code's base
/// is where the code before it ends, and the first code's base is `first`.
pub fn code_bases(extra: List<Int>, first: Int) -> Array<Int> =
  Array::of_list(
    extra.fold({ out: [], base: first }, |s: { out: List<Int>, base: Int }, e: Int|
      { out: s.out.push(s.base << 5 | e), base: s.base + (1 << e) }).out,
  )

fn tally_from(b: Bytes, i: Int, counts: Array<Int>) -> Array<Int> / {abort.raise} =
  if i >= b.len() { counts } else {
    let v = b.at(i);
    tally_from(b, i + 1, counts.set(v, counts.get(v) + 1))
  }

/// How many times each byte value occurs in `b`, indexed by value.
pub fn tally(b: Bytes) -> Array<Int> / {abort.raise} = tally_from(b, 0, Array::new(256, 0))

fn build_tree(
  weight: Array<Int>,
  parent: Array<Int>,
  i: Int,
  j: Int,
  m: Int,
  n: Int,
) -> Array<Int> / {abort.raise} =
  if m >= parent.len() { parent } else {
    let a = if i < n && (j >= m || weight.get(i) <= weight.get(j)) { i } else { j };
    let i1 = if a < n { i + 1 } else { i };
    let j1 = if a < n { j } else { j + 1 };
    let b = if i1 < n && (j1 >= m || weight.get(i1) <= weight.get(j1)) { i1 } else { j1 };
    let sum = weight.get(a) + weight.get(b);
    build_tree(
      weight.set(m, sum),
      parent.set(a, m).set(b, m),
      if b < n { i1 + 1 } else { i1 },
      if b < n { j1 } else { j1 + 1 },
      m + 1,
      n,
    )
  }

fn node_depths(parent: Array<Int>, k: Int, depth: Array<Int>) -> Array<Int> / {abort.raise} =
  if k < 0 { depth } else { node_depths(parent, k - 1, depth.set(k, depth.get(parent.get(k)) + 1)) }

fn limited_lengths(
  keyed: List<Int>,
  most: Int,
  symbols: Int,
  fuel: Int,
) -> Array<Int> / {abort.raise} = {
  let n = keyed.len();
  let weight = Array::of_list(
    range(0, n - 1).fold(keyed.map(|k: Int| k >>> 10), |all: List<Int>, _: Int| all.push(0)),
  );
  let parent = build_tree(weight, Array::new(2 * n - 1, 2 * n - 2), 0, n, n, n);
  let depth = node_depths(parent, 2 * n - 3, Array::new(2 * n - 1, 0));
  if depth.get(0) > most && fuel > 0 {
    limited_lengths(keyed.map(|k: Int| (k >>> 11) + 1 << 10 | k & 1023), most, symbols, fuel - 1)
  } else {
    range(0, n).fold(Array::new(symbols, 0), |lengths: Array<Int>, i: Int|
      lengths.set((match keyed.at(i) { Some(k) -> k, None -> 0 }) & 1023, depth.get(i)))
  }
}

/// The length of each symbol's code in a Huffman code of at most `most` bits, indexed by symbol,
/// with 0 for a symbol that does not occur. `most` is at least eight. `counts` gives how often
/// each symbol occurs, for an alphabet of at most 1024 symbols, and at least two symbols occur. If
/// a code would be longer than `most`, it is rebuilt from halved counts, so the code stays
/// complete and close to optimal.
pub fn code_lengths(counts: Array<Int>, most: Int) -> Array<Int> / {abort.raise} =
  limited_lengths(
    range(0, counts.len()).map(|s: Int| counts.get(s) << 10 | s).filter(|k: Int| k > 1023).sort(),
    most,
    counts.len(),
    40,
  )

const fn single_bytes() -> Array<Bytes> = Array::of_list(range(0, 256).map(byte_of_int))

/// Appends to `out` the whole bytes among the `n` bits in `accumulator`, lowest byte first. This is how a
/// bit writer flushes its buffer. The bits still to write are `accumulator >>> (n & 0x78)`, which has
/// `n & 7` bits.
pub fn flush_bits(out: Bytes, accumulator: Int, n: Int) -> Bytes / {abort.raise} =
  if n < 8 { out }
  else if n < 16 { out ++ single_bytes().get(accumulator & 255) } else {
    flush_bits(
      out ++ single_bytes().get(accumulator & 255) ++ single_bytes().get(accumulator >>> 8 & 255),
      accumulator >>> 16,
      n - 16,
    )
  }

/// Returns one byte for each `v` from 0 up to `n`: the code for the value `v + first`. The code is
/// the index of the last entry of `code_bases` whose base is no greater than that value.
pub fn codes_below(code_bases: Array<Int>, first: Int, n: Int) -> Bytes / {abort.raise} =
  Bytes::concat_all(
    range(0, n).map(|v: Int|
      byte_of_int(
        range(0, code_bases.len()).fold(0, |code: Int, c: Int|
          if code_bases.get(c) >>> 5 <= v + first { c } else { code }),
      )),
  )

/// The result of searching a block for matches. `table` records where each four-byte value last
/// occurred. `sequences` lists the block's sequences, each packed as
/// `literals | match length << 20 | distance << 40`. `anchor` is where the last match ended.
pub type Matches = { table: Array<Int>, sequences: List<Int>, anchor: Int }

/// Finds the matches in `buffer` from position `i` to `end`. At each position it first tries a match
/// at the distance of the previous match. Failing that, it tries the most recent earlier position,
/// within the maximum match distance, whose next four bytes hash to the same `table` slot. It uses
/// a candidate only if its four bytes equal the four bytes at the current position. `table` maps
/// each hash to a stream position plus one; stream positions count from the start of the stream,
/// which is `shift` bytes before the start of `buffer`. `anchor` is where the block's unmatched bytes
/// start. After a position with no match, the search skips further ahead the longer it has gone
/// without a match. `fuel` limits how many positions are tried.
pub fn find_matches(
  buffer: Bytes,
  i: Int,
  anchor: Int,
  end: Int,
  table: Array<Int>,
  seqs: List<Int>,
  last: Int,
  shift: Int,
  fuel: Int,
) -> Matches / {abort.raise} =
  if fuel <= 0 || i + 8 > end { { table: table, sequences: seqs, anchor: anchor } } else {
    let v = Int::of_u32(buffer.u32_le(i));
    let h = v * 506832829 >>> 44;
    let seen = table.get(h) - 1 - shift;
    let marked = table.set(h, i + shift + 1);
    let near = last > 0 && i - last >= 0 && Int::of_u32(buffer.u32_le(i - last)) == v;
    let dist = if near { last }
    else if seen >= 0 && seen < i && i - seen <= 2097152 && Int::of_u32(buffer.u32_le(seen)) == v {
      i - seen
    } else { 0 };
    if dist == 0 {
      find_matches(
        buffer,
        i + 1 + (i - anchor >>> 7),
        anchor,
        end,
        marked,
        seqs,
        last,
        shift,
        fuel - 1,
      )
    } else {
      let length = buffer.match_length(i - dist, i, end - i, 4);
      let inner = marked.set(Int::of_u32(buffer.u32_le(i + 2)) * 506832829 >>> 44, i + shift + 3);
      let tail = i + length - 2;
      find_matches(
        buffer,
        i + length,
        i + length,
        end,
        if tail + 4 > end { inner }
        else { inner.set(Int::of_u32(buffer.u32_le(tail)) * 506832829 >>> 44, tail + shift + 1) },
        seqs.push(i - anchor | length << 20 | dist << 40),
        dist,
        shift,
        fuel - 1,
      )
    }
  }

test "each code starts where the one before it ends" {
  assert_eq(code_bases([0, 0, 1, 2], 3).to_list(), [3 << 5, 4 << 5, 5 << 5 | 1, 7 << 5 | 2])
}

test "`code_lengths` gives a valid prefix code, never gives a more common symbol a longer code, and respects the maximum length" {
  let counts = Array::of_list([40, 0, 30, 10, 10, 5, 3, 1, 1]);
  let lengths = code_lengths(counts, 15).to_list();
  assert_eq(lengths, [1, 0, 2, 4, 4, 4, 5, 6, 6]);
  let limited_lengths = code_lengths(counts, 8).to_list();
  assert_eq(
    limited_lengths.fold(0, |sum: Int, l: Int| if l == 0 { sum } else { sum + (256 >>> l) }),
    256,
  );
  let steep = Array::of_list(range(0, 30).map(|i: Int| 1 << i));
  let capped = code_lengths(steep, 11).to_list();
  assert_eq(capped.fold(0, |sum: Int, l: Int| sum + (2048 >>> l)), 2048);
  assert_eq(capped.fold(0, |most: Int, l: Int| max(most, l)), 11);
  assert_eq(code_lengths(Array::of_list([0, 7, 0, 9]), 15).to_list(), [0, 1, 0, 1])
}

test "a byte is counted each time it occurs" {
  let counts = tally(b"abracadabra");
  assert_eq(counts.get(97), 5);
  assert_eq(counts.get(98), 2);
  assert_eq(counts.get(122), 0)
}

test "repeated text is found as literals and a match, and text with no repeats stays unmatched" {
  let text = b"a sentence with a sentence in it, and a sentence with a sentence in it again";
  let seen = find_matches(text, 0, 0, text.len(), Array::new(131072, 0), [], 0, 0, 1000);
  let total = seen.sequences.fold(0, |n: Int, s: Int| n + (s & 0xF_FFFF) + (s >>> 20 & 0xF_FFFF));
  assert(seen.sequences.len() >= 2);
  assert_eq(total, seen.anchor);
  assert(seen.anchor > 40);
  let none = find_matches(
    b"abcdefghijklmnopqrstuvwxyz",
    0,
    0,
    26,
    Array::new(131072, 0),
    [],
    0,
    0,
    100,
  );
  assert_eq(none.sequences, []);
  assert_eq(none.anchor, 0)
}
