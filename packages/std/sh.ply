//! Argument lists written like a command line, with no shell involved.
//!
//! With `import std.sh`, `sh"-n {pattern} {file}"` is the `List<String>` that starts a program
//! (`process.spawn`, `process.start`). The literal's text is words separated by blanks, parsed when
//! the program is checked. It may not contain a character that a POSIX shell treats as special
//! (Shell Command Language §2.2 and §2.6: a quote, `\`, `$`, a backtick, `|`, `&`, `;`, `<`, `>`,
//! `(`, `)`, `*`, `?`, `[`, `]`, `#`, `~` and a line break). So its words are the ones such a shell
//! would pass the program, and a reader needs to know nothing about quoting.
//!
//! A hole is a `String` whose characters become part of one word. A hole on its own is one
//! argument whatever it contains, even when empty. A hole next to text or another hole is part of
//! the word they form. No hole is split, joined to another word or expanded, because no shell ever
//! sees it.

import std.list
import std.string

/// A part of a word: either literal text, or an interpolated hole, identified by its index among
/// the literal's holes.
pub type Piece = | Text(String) | Hole(Int)

/// A literal's parsed words, each as the pieces it is joined from.
pub type Words = new { words: List<List<Piece>> }

/// Why a literal's text is rejected, at which character (`offset`) of which text (`part`).
pub type Error = { message: String, offset: Int, part: Int }

type ReadState = { done: List<List<Piece>>, word: List<Piece>, text: String }

fn special() -> String = "'\"\\$`|&;<>()*?[]#~\n\r"

fn end_text(r: ReadState) -> ReadState =
  if r.text == "" { r } else { { ..r, word: r.word.push(Text(r.text)), text: "" } }

fn end_word(r: ReadState) -> ReadState = {
  let c = end_text(r);
  if c.word.len() == 0 { c } else { { done: c.done.push(c.word), word: [], text: "" } }
}

fn read_part(r: ReadState, text: String, part: Int) -> Result<ReadState, Error> =
  text.chars().fold(
    { at: 0, read: Ok(r) },
    |accumulator: { at: Int, read: Result<ReadState, Error> }, c: Char|
      {
        at: accumulator.at + 1,
        read: match accumulator.read {
          Err(_) -> accumulator.read,
          Ok(reading) -> {
            let written = String::of_chars([c]);
            if c == ' ' || c == '\t' { Ok(end_word(reading)) } else if special().contains(written) {
              Err({
                message: "the shell treats `" ++ written
                  ++ "` as an operator, not as text: to use it as text, insert it as a hole in the literal",
                offset: accumulator.at,
                part: part,
              })
            } else { Ok({ ..reading, text: reading.text ++ written }) }
          },
        },
      },
  ).read

/// Checks an `sh"..."` literal with holes, given the texts around its holes. Returns the words,
/// with each hole as a piece of the word it is in, or an error at the first character a shell
/// treats as special.
pub fn compile(parts: List<String>) -> Result<Words, Error> = {
  let last = parts.len() - 1;
  let all = range(0, parts.len()).fold(
    Ok({ done: [], word: [], text: "" }),
    |accumulator: Result<ReadState, Error>, part: Int|
      match accumulator {
        Err(_) -> accumulator,
        Ok(r) -> match read_part(r, parts.at_or(part, ""), part) {
          Err(rejected) -> Err(rejected),
          Ok(after) -> if part == last { Ok(after) }
          else { Ok({ ..end_text(after), word: end_text(after).word.push(Hole(part)) }) },
        },
      },
  );
  match all { Err(rejected) -> Err(rejected), Ok(r) -> Ok({ words: end_word(r).done }) }
}

/// Returns a literal's arguments with `holes` filled in. Each word is its pieces joined, with a
/// hole's characters unchanged. A hole missing from `holes` is empty.
pub fn fill(w: Words, holes: List<String>) -> List<String> =
  w.words.map(|word: List<Piece>|
    String::join(
      word.map(|piece: Piece| match piece { Text(s) -> s, Hole(i) -> holes.at_or(i, "") }),
      "",
    ))

/// Checks an `sh"..."` literal with no holes. Returns the text's words, or an error at the first
/// character a shell treats as special.
pub fn literal(text: String) -> Result<List<String>, { message: String, offset: Int }> =
  match compile([text]) {
    Ok(w) -> Ok(fill(w, [])),
    Err(rejected) -> Err({ message: rejected.message, offset: rejected.offset }),
  }

fn filled(parts: List<String>, holes: List<String>) -> List<String> =
  match compile(parts) { Ok(w) -> fill(w, holes), Err(rejected) -> [rejected.message] }

test "each substituted value becomes one shell argument or part of one, however many spaces or special characters it has" {
  assert_eq(filled(["-n ", " ", ""], ["a b; rm -rf /", "$(reboot)"]), [
    "-n",
    "a b; rm -rf /",
    "$(reboot)",
  ]);
  assert_eq(filled(["--to=", "/", " x"], ["a b", "*"]), ["--to=a b/*", "x"]);
  assert_eq(filled(["", ""], [""]), [""]);
  assert_eq(filled(["-n ", "", " x"], ["", ""]), ["-n", "", "x"]);
  assert_eq(filled(["a ", " b"], []), ["a", "", "b"])
}

test "the texts split into words at blanks, and each word into its pieces" {
  assert_eq(
    compile(["-l  a\t", "b ", ""]),
    Ok({ words: [[Text("-l")], [Text("a")], [Hole(0), Text("b")], [Hole(1)]] }),
  );
  assert_eq(literal(" -l  src/main.ply "), Ok(["-l", "src/main.ply"]));
  assert_eq(literal(""), Ok([]))
}

test "a character special to a shell is rejected at its position" {
  let rejected = |parts: List<String>|
    match compile(parts) { Ok(_) -> None, Err(no) -> Some({ offset: no.offset, part: no.part }) };
  assert_eq(rejected(["-n 'a b'"]), Some({ offset: 3, part: 0 }));
  assert_eq(rejected(["caf\u{e9} ", " *.txt"]), Some({ offset: 1, part: 1 }));
  assert_eq(rejected(["a | b"]), Some({ offset: 2, part: 0 }));
  assert_eq(rejected(["a=b %1 {x} ! -name,x:y@z+w"]), None);
  assert_eq(
    literal("echo $HOME"),
    Err({
      message: "the shell treats `$` as an operator, not as text: to use it as text, insert it as a hole in the literal",
      offset: 5,
    }),
  )
}
