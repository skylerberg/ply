//! A double-ended queue: elements are added and removed at either end, and read by position.
//!
//! A `List` already appends at its back with `List::push` and drops its first element by sharing
//! the rest, so a first-in, first-out queue needs only `List::push` and a `[x, ..rest]` pattern. A
//! `List` cannot cheaply add an element at the front or remove the last one, because each copies
//! the list.
//!
//! A `Deque` is two lists, and each list has a live range: the slice that holds the deque's current
//! elements. Elements outside the range have been removed but are still stored. The back list grows
//! by `List::push`. The front list stores the leading elements in reverse order, so it grows the
//! same way. Removing an element moves the edge of a live range and writes nothing. A push, a pop,
//! a read by position, a drop and a reversal each take a constant number of steps. When more than
//! half of a list lies outside its live range, the list is copied to contain only the live range.
//! The removals that left the list mostly unused have already paid for that copy.
//!
//! Using a deque again after modifying it copies one path of a list, as reusing a shared `List`
//! does. A use that also triggers the compacting copy pays for that copy again.
//!
//! A deque equals its elements, front to back. `to_list` is its `key`, so two deques with the same
//! sequence are `==`, have the same `digest` and are the same `Map` key, whatever their lists and
//! limits are. Every operation is tested against that list, and against `limit` where it has one.
//!
//! A bounded deque (`bounded`) contains at most its limit. A push past the limit at one end drops
//! an element from the other end, which makes a sliding window. The limit is not part of what a
//! deque equals.

import std.gen
import std.list (prepend)
import std.list as list

/// A sequence of `a`s that grows and shrinks at both ends.
///
/// The fields are, in order: the front list, the start and end of the front list's live range, the
/// back list, the start and end of the back list's live range, and the limit. The live range is the
/// part of a list that contains the deque's current elements. The front list stores its elements in
/// reverse order. An index outside its list is treated as the nearest valid index, either 0 or the
/// list's length, and a limit below zero is treated as zero, so every value of the type is a valid
/// deque.
pub type Deque<a> = | Deque(List<a>, Int, Int, List<a>, Int, Int, Option<Int>)

key for Deque by to_list

/// An empty deque with no limit.
pub fn empty<a>() -> Deque<a>
  ensures to_list(result) == []
  ensures limit(result) == None
= Deque([], 0, 0, [], 0, 0, None)

/// Returns an empty deque that contains at most `most` elements. A `most` below zero counts as
/// zero.
pub fn bounded<a>(most: Int) -> Deque<a> = Deque([], 0, 0, [], 0, 0, Some(max(most, 0)))

/// The deque of the elements of `xs`, the first at the front, with no limit.
pub fn of_list<a>(xs: List<a>) -> Deque<a> = Deque([], 0, 0, xs, 0, xs.len(), None)

/// Returns the most elements the deque can contain, or `None` for a deque with no limit.
pub fn limit<a>(d: Deque<a>) -> Option<Int> =
  match d {
    Deque(_, _, _, _, _, _, most) -> match most {
      None -> None,
      Some(n) -> if n < 0 { Some(0) } else { most },
    },
  }

/// Returns the number of elements in the deque.
pub fn size<a>(d: Deque<a>) -> Int =
  match d {
    Deque(front, front_from, front_to, back, back_from, back_to, _) -> {
      let front_end = max(0, min(front_to, front.len()));
      let back_end = max(0, min(back_to, back.len()));
      front_end - max(0, min(front_from, front_end)) + back_end - max(0, min(back_from, back_end))
    },
  }

/// Whether the deque holds nothing.
pub fn is_empty<a>(d: Deque<a>) -> Bool = size(d) == 0

/// The elements, front to back.
pub fn to_list<a>(d: Deque<a>) -> List<a> =
  match d {
    Deque(front, front_from, front_to, back, back_from, back_to, _) -> {
      let front_end = max(0, min(front_to, front.len()));
      let front_start = max(0, min(front_from, front_end));
      let back_end = max(0, min(back_to, back.len()));
      let back_start = max(0, min(back_from, back_end));
      if front_end == front_start && back_start == 0 && back_end == back.len() { back } else {
        range(back_start, back_end).fold(
          range(0, front_end - front_start).fold([], |accumulator: List<a>, i: Int|
            match front.at(front_end - 1 - i) {
              Some(x) -> accumulator.push(x),
              None -> accumulator,
            }),
          |accumulator: List<a>, i: Int|
            match back.at(i) { Some(x) -> accumulator.push(x), None -> accumulator },
        )
      }
    },
  }

/// The element at index `i` from the front, or `None` if `i` is out of range.
pub fn get<a>(d: Deque<a>, i: Int) -> Option<a> =
  match d {
    Deque(front, front_from, front_to, back, back_from, back_to, _) -> {
      let front_end = max(0, min(front_to, front.len()));
      let ahead = front_end - max(0, min(front_from, front_end));
      let back_end = max(0, min(back_to, back.len()));
      let back_start = max(0, min(back_from, back_end));
      if i < 0 { None }
      else if i < ahead { front.at(front_end - 1 - i) }
      else if i - ahead < back_end - back_start { back.at(back_start + i - ahead) }
      else { None }
    },
  }

/// The first element, or `None` for an empty deque.
pub fn peek_front<a>(d: Deque<a>) -> Option<a> = get(d, 0)

/// The last element, or `None` for an empty deque.
pub fn peek_back<a>(d: Deque<a>) -> Option<a> = get(d, size(d) - 1)

/// Adds `x` at the front. A bounded deque already at its limit drops its last element to make
/// room, and one whose limit is zero stays empty.
pub fn push_front<a>(d: Deque<a>, x: a) -> Deque<a> =
  match d {
    Deque(front, front_from, front_to, back, back_from, back_to, most) -> {
      let to = max(0, min(front_to, front.len()));
      let from = max(0, min(front_from, to));
      let grown = if to == front.len() { front.push(x) } else { set_inside(front, to, x) };
      match most {
        None -> Deque(grown, from, to + 1, back, back_from, back_to, most),
        Some(_) -> trim_back(Deque(grown, from, to + 1, back, back_from, back_to, most)),
      }
    },
  }

/// Adds `x` at the back. A bounded deque already at its limit drops its first element to make
/// room, and one whose limit is zero stays empty.
pub fn push_back<a>(d: Deque<a>, x: a) -> Deque<a> =
  match d {
    Deque(front, front_from, front_to, back, back_from, back_to, most) -> {
      let to = max(0, min(back_to, back.len()));
      let from = max(0, min(back_from, to));
      let grown = if to == back.len() { back.push(x) } else { set_inside(back, to, x) };
      match most {
        None -> Deque(front, front_from, front_to, grown, from, to + 1, most),
        Some(_) -> trim_front(Deque(front, front_from, front_to, grown, from, to + 1, most)),
      }
    },
  }

/// The first element and the deque without it, or `None` for an empty deque.
pub fn pop_front<a>(d: Deque<a>) -> Option<{ value: a, rest: Deque<a> }> =
  match d {
    Deque(front, front_from, front_to, back, back_from, back_to, most) -> {
      let front_end = max(0, min(front_to, front.len()));
      let front_start = max(0, min(front_from, front_end));
      let back_end = max(0, min(back_to, back.len()));
      let back_start = max(0, min(back_from, back_end));
      if front_end > front_start {
        match front.at(front_end - 1) {
          Some(x) ->
            Some({
              value: x,
              rest: compact(front, front_start, front_end - 1, back, back_start, back_end, most),
            }),
          None -> None,
        }
      } else if back_end > back_start {
        match back.at(back_start) {
          Some(x) ->
            Some({
              value: x,
              rest: compact(front, front_start, front_end, back, back_start + 1, back_end, most),
            }),
          None -> None,
        }
      } else { None }
    },
  }

/// The last element and the deque without it, or `None` for an empty deque.
pub fn pop_back<a>(d: Deque<a>) -> Option<{ value: a, rest: Deque<a> }> =
  match d {
    Deque(front, front_from, front_to, back, back_from, back_to, most) -> {
      let front_end = max(0, min(front_to, front.len()));
      let front_start = max(0, min(front_from, front_end));
      let back_end = max(0, min(back_to, back.len()));
      let back_start = max(0, min(back_from, back_end));
      if back_end > back_start {
        match back.at(back_end - 1) {
          Some(x) ->
            Some({
              value: x,
              rest: compact(front, front_start, front_end, back, back_start, back_end - 1, most),
            }),
          None -> None,
        }
      } else if front_end > front_start {
        match front.at(front_start) {
          Some(x) ->
            Some({
              value: x,
              rest: compact(front, front_start + 1, front_end, back, back_start, back_end, most),
            }),
          None -> None,
        }
      } else { None }
    },
  }

/// Removes the first `n` elements. An `n` below one returns the deque unchanged, and an `n` past
/// the size returns an empty deque.
pub fn drop_front<a>(d: Deque<a>, n: Int) -> Deque<a> =
  if n <= 0 { d } else {
    match d {
      Deque(front, front_from, front_to, back, back_from, back_to, most) -> {
        let front_end = max(0, min(front_to, front.len()));
        let front_start = max(0, min(front_from, front_end));
        let back_end = max(0, min(back_to, back.len()));
        let back_start = max(0, min(back_from, back_end));
        let ahead = min(n, front_end - front_start);
        compact(
          front,
          front_start,
          front_end - ahead,
          back,
          back_start + min(n - ahead, back_end - back_start),
          back_end,
          most,
        )
      },
    }
  }

/// Removes the last `n` elements. An `n` below one returns the deque unchanged, and an `n` past
/// the size returns an empty deque.
pub fn drop_back<a>(d: Deque<a>, n: Int) -> Deque<a> =
  if n <= 0 { d } else {
    match d {
      Deque(front, front_from, front_to, back, back_from, back_to, most) -> {
        let front_end = max(0, min(front_to, front.len()));
        let front_start = max(0, min(front_from, front_end));
        let back_end = max(0, min(back_to, back.len()));
        let back_start = max(0, min(back_from, back_end));
        let behind = min(n, back_end - back_start);
        compact(
          front,
          front_start + min(n - behind, front_end - front_start),
          front_end,
          back,
          back_start,
          back_end - behind,
          most,
        )
      },
    }
  }

/// The elements back to front, in a deque of the same limit. Nothing is copied.
pub fn reverse<a>(d: Deque<a>) -> Deque<a> =
  match d {
    Deque(front, front_from, front_to, back, back_from, back_to, most) ->
      Deque(back, back_from, back_to, front, front_from, front_to, most),
  }

/// Returns `d` with limit `most`, or with no limit for `None`. A limit drops elements from the
/// front until at most `most` remain.
pub fn with_limit<a>(d: Deque<a>, most: Option<Int>) -> Deque<a> =
  match d {
    Deque(front, front_from, front_to, back, back_from, back_to, _) ->
      trim_front(Deque(front, front_from, front_to, back, back_from, back_to, most)),
  }

/// Returns the elements of `a` followed by the elements of `b`, with `a`'s limit. If `a` has a
/// limit, the result keeps only the last elements that fit.
pub fn concat<a>(a: Deque<a>, b: Deque<a>) -> Deque<a> =
  match limit(a) {
    None -> if size(a) < size(b) {
      fold_back(a, with_limit(b, None), |d: Deque<a>, x: a| push_front(d, x))
    } else { fold_front(b, a, |d: Deque<a>, x: a| push_back(d, x)) },
    Some(_) -> trim_front(fold_front(b, a, |d: Deque<a>, x: a| push_back(d, x))),
  }

/// Folds `f` over the elements from the front, as the prelude's `List::fold` does over a list.
pub fn fold_front<a, b | e>(d: Deque<a>, init: b, f: (b, a) -> b / e) -> b / e =
  match d {
    Deque(front, front_from, front_to, back, back_from, back_to, _) -> {
      let front_end = max(0, min(front_to, front.len()));
      let front_start = max(0, min(front_from, front_end));
      let back_end = max(0, min(back_to, back.len()));
      let back_start = max(0, min(back_from, back_end));
      range(back_start, back_end).fold(
        range(0, front_end - front_start).fold(init, |accumulator: b, i: Int|
          match front.at(front_end - 1 - i) { Some(x) -> f(accumulator, x), None -> accumulator }),
        |accumulator: b, i: Int|
          match back.at(i) { Some(x) -> f(accumulator, x), None -> accumulator },
      )
    },
  }

/// Folds `f` over the elements from the back.
pub fn fold_back<a, b | e>(d: Deque<a>, init: b, f: (b, a) -> b / e) -> b / e =
  fold_front(reverse(d), init, f)

/// Returns the last `most` elements of `xs`, or all of them when `most` is `None`. This is what a
/// deque with that limit contains after its elements are added at the back.
pub fn last_within_limit<a>(xs: List<a>, most: Option<Int>) -> List<a> =
  match most { None -> xs, Some(n) -> xs.drop(xs.len() - max(n, 0)) }

/// Returns the first `most` elements of `xs`, or all of them when `most` is `None`. This is what a
/// deque with that limit contains after its elements are added at the front.
pub fn first_within_limit<a>(xs: List<a>, most: Option<Int>) -> List<a> =
  match most { None -> xs, Some(n) -> xs.take(max(n, 0)) }

fn trim_front<a>(d: Deque<a>) -> Deque<a> =
  match limit(d) { None -> d, Some(most) -> drop_front(d, size(d) - most) }

fn trim_back<a>(d: Deque<a>) -> Deque<a> =
  match limit(d) { None -> d, Some(most) -> drop_back(d, size(d) - most) }

fn compact<a>(
  front: List<a>,
  front_from: Int,
  front_to: Int,
  back: List<a>,
  back_from: Int,
  back_to: Int,
  most: Option<Int>,
) -> Deque<a> =
  if front_to - front_from + back_to - back_from == 0 { Deque([], 0, 0, [], 0, 0, most) } else {
    let ahead = front.len() >= 2 * (front_to - front_from) + 32;
    let behind = back.len() >= 2 * (back_to - back_from) + 32;
    Deque(
      if ahead { front.slice(front_from, front_to) } else { front },
      if ahead { 0 } else { front_from },
      if ahead { front_to - front_from } else { front_to },
      if behind { back.slice(back_from, back_to) } else { back },
      if behind { 0 } else { back_from },
      if behind { back_to - back_from } else { back_to },
      most,
    )
  }

fn set_inside<a>(xs: List<a>, i: Int, x: a) -> List<a> =
  handle { xs.set(i, x) } with { abort.raise(_) -> xs }

fn counting(n: Int) -> Deque<Int> = of_list(range(0, n))

fn popped_front(d: Deque<Int>) -> Deque<Int> =
  match pop_front(d) { Some(popped) -> popped.rest, None -> d }

fn popped_back(d: Deque<Int>) -> Deque<Int> =
  match pop_back(d) { Some(popped) -> popped.rest, None -> d }

test "elements are added and removed at both ends" {
  let d = push_front(push_back(push_back(push_front(empty(), 2), 3), 4), 1);
  assert_eq(to_list(d), [1, 2, 3, 4]);
  assert_eq(size(d), 4);
  assert(!is_empty(d));
  assert_eq(peek_front(d), Some(1));
  assert_eq(peek_back(d), Some(4));
  assert(pop_front(d) == Some({ value: 1, rest: of_list([2, 3, 4]) }));
  assert(pop_back(d) == Some({ value: 4, rest: of_list([1, 2, 3]) }));
  assert_eq(to_list(popped_back(popped_back(popped_back(d)))), [1]);
  assert_eq(to_list(popped_front(popped_front(popped_front(d)))), [4]);
  assert_eq(to_list(push_back(popped_back(popped_front(d)), 9)), [2, 3, 9]);
  assert_eq(to_list(push_front(popped_front(popped_back(d)), 9)), [9, 2, 3])
}

test "every read of an empty deque returns nothing" {
  let none: Deque<Int> = empty();
  assert(is_empty(none));
  assert_eq(size(none), 0);
  assert_eq(peek_front(none), None);
  assert_eq(peek_back(none), None);
  assert(pop_front(none) == None);
  assert(pop_back(none) == None);
  assert_eq(get(none, 0), None);
  assert_eq(to_list(none), []);
  assert(is_empty(popped_front(push_back(none, 1))))
}

test "an element is read by its index from the front" {
  let d = push_front(push_front(counting(3), 8), 9);
  assert_eq(range(0, 5).map(|i: Int| get(d, i)), [Some(9), Some(8), Some(0), Some(1), Some(2)]);
  assert_eq(get(d, 5), None);
  assert_eq(get(d, 0 - 1), None)
}

test "`to_list`, `size`, `get` and the other reads match the expected list after pushing and popping at both ends" {
  let ahead = popped_back(
    popped_back(popped_front(range(0, 6).fold(empty(), |d: Deque<Int>, i: Int| push_front(d, i)))),
  );
  assert_eq(to_list(ahead), [4, 3, 2]);
  assert_eq(size(ahead), 3);
  assert_eq(range(0, 4).map(|i: Int| get(ahead, i)), [Some(4), Some(3), Some(2), None]);
  assert_eq(peek_back(ahead), Some(2));
  let behind = popped_back(popped_front(popped_front(counting(6))));
  assert_eq(to_list(behind), [2, 3, 4]);
  assert_eq(range(0, 4).map(|i: Int| get(behind, i)), [Some(2), Some(3), Some(4), None]);
  let both = popped_back(push_front(push_front(behind, 8), 9));
  assert_eq(to_list(both), [9, 8, 2, 3]);
  assert_eq(size(both), 4);
  assert_eq(range(0, 5).map(|i: Int| get(both, i)), [Some(9), Some(8), Some(2), Some(3), None]);
  assert_eq(fold_front(both, [], |accumulator: List<Int>, x: Int| accumulator.push(x)), [
    9,
    8,
    2,
    3,
  ]);
  assert_eq(fold_back(both, [], |accumulator: List<Int>, x: Int| accumulator.push(x)), [
    3,
    2,
    8,
    9,
  ]);
  assert_eq(to_list(drop_front(both, 3)), [3]);
  assert_eq(to_list(drop_back(both, 3)), [9])
}

test "after popping from the back or the front of a deque, pushing new elements at that end replaces the popped ones and leaves the other elements unchanged" {
  let back = popped_back(popped_back(counting(3)));
  assert_eq(to_list(push_back(back, 7)), [0, 7]);
  assert_eq(to_list(push_back(push_back(push_back(back, 7), 8), 9)), [0, 7, 8, 9]);
  let front = popped_front(
    popped_front(range(0, 3).fold(empty(), |d: Deque<Int>, i: Int| push_front(d, i))),
  );
  assert_eq(to_list(push_front(front, 7)), [7, 0]);
  assert_eq(to_list(push_front(push_front(push_front(front, 7), 8), 9)), [9, 8, 7, 0]);
  assert_eq(to_list(push_back(with_limit(back, Some(5)), 7)), [0, 7]);
  assert_eq(to_list(push_front(with_limit(front, Some(5)), 7)), [7, 0])
}

test "`drop_front` and `drop_back` remove the correct elements when the count is larger than the elements stored at that end of the deque" {
  let front_first = push_back(
    push_back(
      popped_back(popped_back(range(0, 4).fold(empty(), |d: Deque<Int>, i: Int| push_front(d, i)))),
      7,
    ),
    8,
  );
  assert_eq(to_list(front_first), [3, 2, 7, 8]);
  assert_eq(to_list(drop_front(front_first, 3)), [8]);
  assert_eq(to_list(drop_back(front_first, 3)), [3]);
  let back_first = push_front(push_front(popped_front(popped_front(counting(4))), 9), 8);
  assert_eq(to_list(back_first), [8, 9, 2, 3]);
  assert_eq(to_list(drop_back(back_first, 3)), [8]);
  assert_eq(to_list(drop_front(back_first, 3)), [3])
}

test "a bounded deque is a window: a push past its limit drops from the other end" {
  let window = range(0, 10).fold(bounded(3), |d: Deque<Int>, i: Int| push_back(d, i));
  assert_eq(to_list(window), [7, 8, 9]);
  assert_eq(limit(window), Some(3));
  assert_eq(to_list(push_front(window, 0)), [0, 7, 8]);
  assert_eq(to_list(push_back(push_back(bounded(0), 1), 2)), []);
  assert_eq(limit(push_back(bounded(0 - 4), 1)), Some(0));
  assert_eq(to_list(push_front(bounded(1), 5)), [5]);
  assert_eq(to_list(push_front(push_front(bounded(1), 5), 6)), [6]);
  assert_eq(limit(counting(2)), None);
  assert_eq(to_list(with_limit(counting(5), Some(2))), [3, 4]);
  assert_eq(limit(with_limit(window, None)), None);
  assert_eq(to_list(push_back(with_limit(window, None), 10)), [7, 8, 9, 10])
}

test "`drop_front`, `drop_back`, `reverse` and `concat` return the same elements as the matching list operations" {
  let d = push_front(counting(4), 9);
  assert_eq(to_list(drop_front(d, 2)), [1, 2, 3]);
  assert_eq(to_list(drop_back(d, 2)), [9, 0, 1]);
  assert_eq(to_list(drop_front(d, 0)), [9, 0, 1, 2, 3]);
  assert_eq(to_list(drop_back(d, 99)), []);
  assert_eq(to_list(reverse(d)), [3, 2, 1, 0, 9]);
  assert_eq(to_list(push_back(reverse(d), 7)), [3, 2, 1, 0, 9, 7]);
  assert_eq(to_list(concat(d, counting(2))), [9, 0, 1, 2, 3, 0, 1]);
  assert_eq(to_list(concat(counting(2), d)), [0, 1, 9, 0, 1, 2, 3]);
  assert_eq(to_list(concat(d, empty())), to_list(d));
  assert_eq(to_list(concat(empty(), d)), to_list(d));
  assert_eq(to_list(concat(bounded(3), d)), [1, 2, 3]);
  assert_eq(limit(concat(bounded(3), d)), Some(3));
  assert_eq(limit(concat(d, bounded(3))), None)
}

effect counter {
  write tick() -> Unit
}

test "a fold runs from either end, and its callback may perform effects" {
  let d = push_front(counting(3), 9);
  assert_eq(fold_front(d, "", |accumulator: String, x: Int| accumulator ++ x.to_string()), "9012");
  assert_eq(fold_back(d, "", |accumulator: String, x: Int| accumulator ++ x.to_string()), "2109");
  let calls = handle {
    fold_front(d, 0, |accumulator: Int, x: Int| {
      counter.tick();
      accumulator + x
    })
  } with {
    var calls = 0,
    counter.tick() -> {
      calls = calls + 1;
    },
    return total -> { total: total, calls: calls },
  };
  assert_eq(calls, { total: 12, calls: 4 })
}

test "two deques with the same sequence are equal, whatever their lists and limits are" {
  let pushed_back = counting(3);
  let pushed_front = push_front(push_front(push_front(empty(), 2), 1), 0);
  let window = range(0 - 4, 3).fold(bounded(3), |d: Deque<Int>, i: Int| push_back(d, i));
  assert(pushed_back == pushed_front);
  assert(pushed_back == window);
  assert_eq(pushed_front, window);
  assert_eq(digest(pushed_back), digest(pushed_front));
  assert_eq(digest(pushed_back), digest(window));
  assert_eq(compare(pushed_front, window), Equal);
  assert_eq(#{pushed_back: 1, pushed_front: 2, window: 3}.len(), 1);
  assert(pushed_back != push_back(pushed_front, 3));
  assert_eq(compare(pushed_back, push_back(pushed_front, 3)), Less);
  let nested = push_back(push_back(empty(), pushed_back), empty());
  assert(nested == push_front(push_front(empty(), empty()), window))
}

test "a deque is a value: deriving new deques from one leaves it unchanged" {
  let d = popped_back(counting(40));
  let one = push_back(d, 100);
  let other = push_back(d, 200);
  assert_eq(peek_back(d), Some(38));
  assert_eq(peek_back(one), Some(100));
  assert_eq(peek_back(other), Some(200));
  assert_eq(size(d), 39);
  assert_eq(to_list(d), range(0, 39));
  let front = popped_front(push_front(d, 7));
  assert_eq(to_list(push_front(front, 8)), list::prepend(8, range(0, 39)));
  assert_eq(to_list(push_front(front, 9)), list::prepend(9, range(0, 39)))
}

fn stored_length(d: Deque<Int>) -> Int =
  match d { Deque(front, _, _, back, _, _, _) -> front.len() + back.len() }

test "after many pushes and pops, a deque with a size limit contains only the newest elements and stores a bounded number of them" {
  let queue = range(0, 5000).fold(counting(10), |d: Deque<Int>, i: Int|
    push_back(popped_front(d), i));
  assert_eq(to_list(queue), range(4990, 5000));
  assert(stored_length(queue) <= 2 * 10 + 32 + 1, Some(stored_length(queue).to_string()));
  let window = range(0, 5000).fold(bounded(10), |d: Deque<Int>, i: Int| push_front(d, i));
  assert_eq(to_list(window), range(4990, 5000).reverse());
  assert(stored_length(window) <= 2 * 10 + 32 + 1, Some(stored_length(window).to_string()));
  assert_eq(
    stored_length(range(0, 100).fold(counting(100), |d: Deque<Int>, _i: Int| popped_back(d))),
    0,
  );
  assert_eq(
    stored_length(range(0, 5).fold(counting(5), |d: Deque<Int>, _i: Int| popped_front(d))),
    0,
  )
}

test "a `Deque` built directly with head or tail indexes outside its lists still behaves as a deque, using the nearest valid index" {
  let odd = Deque([1, 2, 3], 0 - 5, 99, [4, 5], 7, 1, Some(0 - 2));
  assert_eq(to_list(odd), [3, 2, 1]);
  assert_eq(size(odd), 3);
  assert_eq(limit(odd), Some(0));
  let hollow = Deque([9, 8], 0, 0, [1, 2, 3], 1, 1, None);
  assert(pop_front(hollow) == None);
  assert(pop_back(hollow) == None);
  assert_eq(peek_front(hollow), None);
  assert_eq(get(hollow, 0), None);
  assert_eq(to_list(push_back(Deque([1, 2, 3], 1, 2, [4, 5], 9, 9, None), 6)), [2, 6]);
  assert_eq(to_list(push_back(Deque([1], 0, 1, [2, 3], 0, 2, Some(2)), 4)), [3, 4])
}

fn deques() -> gen::Gen<Deque<Int>> = {
  let index = gen::one_of([gen::int_between(0 - 2, 18), gen::any_int()]);
  gen::and_then(
    gen::map3(gen::list(gen::any_int()), index, index, |front: List<Int>, from: Int, to: Int|
      (front, from, to)),
    |ahead: (List<Int>, Int, Int)|
      gen::map4(
        gen::list(gen::any_int()),
        index,
        index,
        gen::option_of(index),
        |back: List<Int>, from: Int, to: Int, most: Option<Int>|
          Deque(ahead._0, ahead._1, ahead._2, back, from, to, most),
      ),
  )
}

test "a deque's size, its ends and an element by index match its list's" {
  gen::check2(deques(), gen::int_between(0 - 2, 18), |d: Deque<Int>, i: Int|
    size(d) == to_list(d).len() && is_empty(d) == (to_list(d) == [])
      && get(d, i) == to_list(d).at(i)
      && peek_front(d) == to_list(d).first()
      && peek_back(d) == to_list(d).last())
}

test "`pop_front` and `pop_back` return the end element and the remaining deque, which has the same size limit as the original" {
  gen::check(deques(), |d: Deque<Int>|
    (match pop_front(d) {
        None -> to_list(d) == [],
        Some(popped) ->
          to_list(d) == prepend(popped.value, to_list(popped.rest))
            && limit(popped.rest) == limit(d),
      })
      && (match pop_back(d) {
        None -> to_list(d) == [],
        Some(popped) ->
          to_list(d) == to_list(popped.rest).push(popped.value) && limit(popped.rest) == limit(d),
      }))
}

test "`drop_front`, `drop_back` and `reverse` return the elements that `drop`, `take` and `reverse` give on the list, and keep the limit" {
  gen::check2(deques(), gen::int_between(0 - 2, 18), |d: Deque<Int>, n: Int|
    to_list(drop_front(d, n)) == to_list(d).drop(n) && limit(drop_front(d, n)) == limit(d)
      && to_list(drop_back(d, n)) == to_list(d).take(to_list(d).len() - max(n, 0))
      && limit(drop_back(d, n)) == limit(d)
      && to_list(reverse(d)) == to_list(d).reverse()
      && limit(reverse(d)) == limit(d))
}
