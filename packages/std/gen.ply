//! Generators: how a test produces the values it checks a property against.
//!
//! A `Gen<a>` builds a value from a sequence of draws. A draw is a whole number below a bound that
//! the generator chooses. Normally the draws come from a pseudorandom stream selected by a root and
//! a key, so a value depends only on its root, its key and its size, on every machine.
//!
//! A generator records every draw it takes. Given a record instead of the stream, it replays the
//! record and makes the same value. A shorter record, or one with lower numbers, makes a smaller
//! value that the generator could also have drawn. This is how `check` shrinks a failing value: it
//! shrinks the record, not the value, so shrinking works for any generator, including one built
//! with `map`, `and_then` or `such_that`. Past the end of a record every draw is `0`, so a
//! generator's lowest draws should make its simplest value.
//!
//! `check` asserts a property over drawn values. This is evidence for a test, not a proof. A
//! property that must hold for every value is a `law`, which `ply prove` checks. A generator may
//! give up, when `such_that` has used up its budget or there was nothing to choose from. It then
//! returns no value, and `check` moves on to its next case.
//!
//! This module imports no other module, so any module may import it to test itself.

/// What a generator draws from, and what it has drawn.
pub type Draws = new {
  /// The stream's current state: thirty-two bytes. Each draw replaces it with its digest.
  stream: Bytes,
  /// A record to replay in place of the stream. Each replayed draw is clamped below its bound.
  replay: Option<List<Int>>,
  /// How large a value may grow. `check` passes a size that rises over its run, up to 63.
  size: Int,
  /// The draws taken so far, oldest first. Replaying them makes the same value.
  taken: List<Int>,
  /// How many values `such_that` rejected.
  rejections: Int,
}

/// What a generator returns: the value, or `None` if it gave up, and the draws after it.
pub type DrawResult<a> = { value: Option<a>, draws: Draws }

/// How a value of `a` is drawn.
pub type Gen<a> = | Gen((Draws) -> DrawResult<a> / {abort.raise})

/// One run of a generator: its value, or `None` if it gave up; the draws it took, which make the
/// value again when replayed; and how many values `such_that` rejected along the way.
pub type Sample<a> = { value: Option<a>, record: List<Int>, rejections: Int }

/// Runs `g` at `size` and returns the value, the list of draws it took, and the rejection count.
/// The draws come from a pseudo-random sequence that is fixed by `root` and `key`, so the same
/// arguments give the same result. When `replay` is given, `g` takes its draws from that list
/// instead.
pub fn sample<a>(
  g: Gen<a>,
  root: Int,
  key: Bytes,
  size: Int,
  replay: Option<List<Int>>,
) -> Sample<a> / {abort.raise} = {
  let out = run(g, {
    stream: Bytes::concat_all([
      b"ply.gen.stream.1 ",
      Bytes::of_string(root.to_string()),
      b" ",
      key,
    ]).blake3(
    ),
    replay: replay,
    size: size,
    taken: [],
    rejections: 0,
  });
  { value: out.value, record: out.draws.taken, rejections: out.draws.rejections }
}

/// Runs `g` on `draws`. Use it to write a combinator of your own.
pub fn run<a>(g: Gen<a>, draws: Draws) -> DrawResult<a> / {abort.raise} =
  match g { Gen(f) -> f(draws) }

fn gave_up<a>(draws: Draws) -> DrawResult<a> = { value: None, draws: draws }

fn draw_at(record: List<Int>, i: Int) -> Int = match record.at(i) { Some(v) -> v, None -> 0 }

fn next(draws: Draws, bound: Int) -> { value: Int, draws: Draws } / {abort.raise} =
  match draws.replay {
    Some(record) -> {
      let v = min(max(draw_at(record, draws.taken.len()), 0), bound - 1);
      { value: v, draws: { ..draws, taken: draws.taken.push(v) } }
    },
    None -> {
      let digest = draws.stream.blake3();
      let low = Int::of_u32(digest.u32_le(0));
      let high = Int::of_u32(digest.u32_le(4)) & 0x7FFF_FFFF;
      let v = (high << 32 | low) % bound;
      { value: v, draws: { ..draws, stream: digest, taken: draws.taken.push(v) } }
    },
  }

/// Always `x`, with nothing drawn.
pub fn constant<a>(x: a) -> Gen<a> = Gen(|d: Draws| { value: Some(x), draws: d })

/// A whole number from `0` up to but not including `bound`. It takes one draw, and every other
/// generator is built from it. Gives up for a bound below one.
pub fn below(bound: Int) -> Gen<Int> =
  Gen(|d: Draws|
    if bound < 1 { gave_up(d) } else {
      let step = next(d, bound);
      { value: Some(step.value), draws: step.draws }
    })

/// A whole number from `low` to `high`, both included, shrinking toward `low`. Gives up when
/// `high` is below `low`.
pub fn int_between(low: Int, high: Int) -> Gen<Int> =
  if high < low { Gen(|d: Draws| gave_up(d)) } else {
    match checked_sub(high, low) {
      Some(span) -> if span < max_bound { map(below(span + 1), |k: Int| low + k) }
      else { wide_between(low, high) },
      None -> wide_between(low, high),
    }
  }

const max_bound: Int = 0x7FFF_FFFF_FFFF_FFFF

fn wide_between(low: Int, high: Int) -> Gen<Int> =
  map2(below(4294967296), below(4294967296), |hi: Int, lo: Int| {
    let span = I128::of_int(high) - I128::of_int(low) + 1i128;
    let offset = (I128::of_int(hi) * 4294967296i128 + I128::of_int(lo)) % span;
    Int::of_i128(I128::of_int(low) + offset)
  })

/// A whole number of either sign that grows with the size, shrinking toward `0`.
pub fn int() -> Gen<Int> =
  sized(|size: Int|
    map2(below((1 << 8 + min(max(size, 0), 54)) + 1), below(2), |magnitude: Int, sign: Int|
      if sign == 1 { 0 - magnitude } else { magnitude }))

/// `false` or `true`, shrinking toward `false`.
pub fn bool() -> Gen<Bool> = map(below(2), |k: Int| k == 1)

/// One of `xs`, shrinking toward the first. Gives up for an empty list.
pub fn elements<a>(xs: List<a>) -> Gen<a> =
  Gen(|d: Draws|
    if xs.len() == 0 { gave_up(d) } else {
      let step = next(d, xs.len());
      { value: xs.at(step.value), draws: step.draws }
    })

fn leading<a>(xs: List<a>, n: Int) -> List<a> =
  range(0, min(n, xs.len())).fold([], |accumulator: List<a>, i: Int|
    match xs.at(i) { Some(x) -> accumulator.push(x), None -> accumulator })

/// A value from one of `gs`, shrinking toward the first. Gives up for an empty list.
pub fn one_of<a>(gs: List<Gen<a>>) -> Gen<a> =
  Gen(|d: Draws|
    if gs.len() == 0 { gave_up(d) } else {
      let step = next(d, gs.len());
      match gs.at(step.value) { Some(g) -> run(g, step.draws), None -> gave_up(step.draws) }
    })

/// `Some` of what `g` draws, or `None`, shrinking toward `None`.
pub fn option_of<a>(g: Gen<a>) -> Gen<Option<a>> =
  and_then(below(2), |k: Int| if k == 0 { constant(None) } else { map(g, |x: a| Some(x)) })

/// A list of values `g` draws, with at most `most` elements and no more than the size, shrinking
/// toward the empty list.
pub fn list_of<a>(g: Gen<a>, most: Int) -> Gen<List<a>> =
  Gen(|d: Draws| {
    let length = next(d, 1 + max(0, min(most, d.size)));
    draw_many(g, length.value, length.draws)
  })

/// Draws `n` values with `g` and returns them as a list. Gives up if `g` gives up.
pub fn list_of_length<a>(g: Gen<a>, n: Int) -> Gen<List<a>> = Gen(|d: Draws| draw_many(g, n, d))

fn draw_many<a>(g: Gen<a>, n: Int, draws: Draws) -> DrawResult<List<a>> / {abort.raise} = {
  let start: DrawResult<List<a>> = { value: Some([]), draws: draws };
  range(0, n).fold(start, |accumulator: DrawResult<List<a>>, _i: Int|
    match accumulator.value {
      None -> accumulator,
      Some(xs) -> {
        let x = run(g, accumulator.draws);
        { value: match x.value { Some(v) -> Some(xs.push(v)), None -> None }, draws: x.draws }
      },
    })
}

/// Exactly `n` bytes, each shrinking toward zero.
pub fn bytes_of(n: Int) -> Gen<Bytes> =
  map(list_of_length(below(256), n), |octets: List<Int>|
    octets.fold(b"", |accumulator: Bytes, b: Int| accumulator.concat(byte_of_int(b))))

/// Returns a generator that draws a value with `g` and passes it to `f`.
pub fn map<a, b>(g: Gen<a>, f: keep (a) -> b / {abort.raise}) -> Gen<b> =
  Gen(|d: Draws| {
    let x = run(g, d);
    { value: match x.value { Some(v) -> Some(f(v)), None -> None }, draws: x.draws }
  })

/// Returns a generator that draws a value with `ga`, then one with `gb`, and passes both to `f`.
pub fn map2<a, b, c>(ga: Gen<a>, gb: Gen<b>, f: keep (a, b) -> c / {abort.raise}) -> Gen<c> =
  and_then(ga, |x: a| map(gb, |y: b| f(x, y)))

/// Returns a generator that draws a value with each of `ga`, `gb` and `gc` in that order, and
/// passes all three to `f`.
pub fn map3<a, b, c, d>(
  ga: Gen<a>,
  gb: Gen<b>,
  gc: Gen<c>,
  f: keep (a, b, c) -> d / {abort.raise},
) -> Gen<d> = and_then(ga, |x: a| map2(gb, gc, |y: b, z: c| f(x, y, z)))

/// Returns a generator that draws a value with each of `ga`, `gb`, `gc` and `gd` in that order, and
/// passes all four to `f`.
pub fn map4<a, b, c, d, r>(
  ga: Gen<a>,
  gb: Gen<b>,
  gc: Gen<c>,
  gd: Gen<d>,
  f: keep (a, b, c, d) -> r / {abort.raise},
) -> Gen<r> = and_then(ga, |x: a| map3(gb, gc, gd, |y: b, z: c, w: d| f(x, y, z, w)))

/// Draws a value with `g`, then draws with the generator `f` returns for that value. Use it when
/// one value decides how the rest are drawn.
pub fn and_then<a, b>(g: Gen<a>, f: keep (a) -> Gen<b> / {abort.raise}) -> Gen<b> =
  Gen(|d: Draws| {
    let x = run(g, d);
    match x.value { Some(v) -> run(f(v), x.draws), None -> gave_up(x.draws) }
  })

/// The generator `f` returns for the current size. Use it for a generator that grows with the size
/// in its own way.
pub fn sized<a>(f: keep (Int) -> Gen<a> / {abort.raise}) -> Gen<a> =
  Gen(|d: Draws| run(f(d.size), d))

/// A value `g` draws that `keep` accepts. It draws again for each rejected value, counting it in
/// `rejections`, and gives up after `budget` rejections.
pub fn such_that<a>(g: Gen<a>, keep: keep (a) -> Bool / {abort.raise}, budget: Int) -> Gen<a> =
  Gen(|d: Draws|
    iterate({ draws: d, left: budget }, max(budget, 0) + 1, |s: { draws: Draws, left: Int }|
      if s.left <= 0 { Stop(gave_up(s.draws)) } else {
        let x = run(g, s.draws);
        match x.value {
          None -> Stop(x),
          Some(v) -> if keep(v) { Stop(x) } else {
            Continue({ draws: { ..x.draws, rejections: x.draws.rejections + 1 }, left: s.left - 1 })
          },
        }
      }))

const edge_ints: List<Int> = [0, 1, 0 - 1, 0 - 9223372036854775807 - 1, 9223372036854775807]

/// Returns any whole number. About one value in six is an edge case: zero, one, minus one, or the
/// least or greatest `Int`, which make checked arithmetic overflow. The other values are drawn by
/// `int`, which draws a number whose range grows with the generator's size. Shrinks toward `0`.
pub fn any_int() -> Gen<Int> =
  and_then(below(32), |k: Int| if k < 27 { int() } else { constant(draw_at(edge_ints, k - 27)) })

fn length() -> Gen<Int> =
  sized(|size: Int| {
    let most = min(16, 1 + max(size, 0) / 4);
    map2(below(most + 1), below(most + 1), |one: Int, other: Int| min(one, other))
  })

/// A list of values `g` draws, with at most sixteen elements and fewer at a small size, shrinking
/// toward the empty list.
pub fn list<a>(g: Gen<a>) -> Gen<List<a>> = and_then(length(), |n: Int| list_of_length(g, n))

/// A map of the keys `gk` draws to the values `gv` draws, of at most eight entries, shrinking
/// toward the empty map.
pub fn map_of<k, v>(gk: Gen<k>, gv: Gen<v>) -> Gen<Map<k, v>>
  where derivable(ord, k)
=
  map(
    list(map2(gk, gv, |key: k, value: v| { key: key, value: value })),
    |entries: List<{ key: k, value: v }>| Map::of_entries(leading(entries, 8)),
  )

/// A string of at most sixteen letters from `a` to `p`, shrinking toward the empty string.
pub fn text() -> Gen<String> =
  map(list(below(16)), |letters: List<Int>|
    letters.fold("", |accumulator: String, i: Int|
      accumulator ++ "abcdefghijklmnop".slice(i, i + 1)))

/// Returns a byte string of at most sixteen bytes. Each byte shrinks toward zero, and the string
/// shrinks toward the empty string.
pub fn bytes() -> Gen<Bytes> =
  map(list(below(256)), |octets: List<Int>|
    octets.fold(b"", |accumulator: Bytes, b: Int| accumulator.concat(byte_of_int(b))))

const edge_chars: List<Char> = ['\0', '\n', ' ', '\'', '\u{e9}', '\u{1F600}', '\u{10FFFF}']

/// A character: mostly one of the letters `text` draws, and one time in eight a character that
/// often breaks text handling. Shrinks toward `a`.
pub fn char() -> Gen<Char> =
  and_then(below(8), |k: Int|
    if k < 7 { map(below(16), |i: Int| match Char::of_int(97 + i) { Some(c) -> c, None -> 'a' }) }
    else { elements(edge_chars) })

const edge_floats: List<Float> =
  [
    Float::of_bits(0x7FF8_0000_0000_0000),
    Float::of_bits(0x8000_0000_0000_0000),
    1.0,
    0.0 - 1.0,
    Float::of_bits(0x7FF0_0000_0000_0000),
    Float::of_bits(0xFFF0_0000_0000_0000),
    Float::of_bits(0x7FEF_FFFF_FFFF_FFFF),
  ]

/// A float. One time in four it is NaN, minus zero, one, minus one, an infinity or the greatest
/// finite float. Otherwise it is a whole number below `2^53` of either sign, scaled by a power of
/// two that grows with the size. Shrinks toward `0.0`.
pub fn float() -> Gen<Float> =
  and_then(below(4), |k: Int|
    if k == 3 { elements(edge_floats) } else {
      sized(|size: Int|
        map3(
          below(9007199254740992),
          below(1 + min(max(size, 0), 60)),
          below(2),
          |mantissa: Int, exponent: Int, sign: Int| {
            let scale = Float::of_bits(exponent - 30 + 1023 << 52);
            let magnitude = Float::of_int(mantissa) * scale;
            if sign == 1 { 0.0 - magnitude } else { magnitude }
          },
        ))
    })

const edge_decimals: List<Decimal> = {
  let greatest = match Decimal::of_string("79228162514264337593543950335") {
    Some(d) -> d,
    None -> 0m,
  };
  [1m, 0m - 1m, Decimal::div(0m, 100m, 2, Down), greatest, 0m - greatest]
}

/// A decimal. One time in five it is one, minus one, a zero of scale two, the greatest or the
/// least. Otherwise it is a whole number that grows with the size, at a scale of up to six. Shrinks
/// toward `0`.
pub fn decimal() -> Gen<Decimal> =
  and_then(below(5), |k: Int|
    if k < 4 {
      map2(int(), below(7), |mantissa: Int, scale: Int| {
        let unit = range(0, scale).fold(1, |power: Int, _place: Int| power * 10);
        Decimal::of_int(mantissa).div(Decimal::of_int(unit), scale, Down)
      })
    } else { elements(edge_decimals) })

/// Any `U32`, shrinking toward `0`.
pub fn u32() -> Gen<U32> = map(below(4294967296), |n: Int| U32::of_int(n))

/// Any `U64`, its two halves drawn separately, shrinking toward `0`.
pub fn u64() -> Gen<U64> =
  map2(below(4294967296), below(4294967296), |high: Int, low: Int|
    U64::of_int(high) << 32 | U64::of_int(low))

/// `Ok` of what `ok` draws or `Err` of what `err` draws, shrinking toward `Ok`.
pub fn result_of<a, b>(ok: Gen<a>, err: Gen<b>) -> Gen<Result<a, b>> =
  and_then(below(2), |k: Int| if k == 0 { map(ok, |x: a| Ok(x)) } else { map(err, |x: b| Err(x)) })

const shrink_budget: Int = 2000

type Outcome = | Passed | Failed | Raised(String)

type Counterexample<a> = { value: a, record: List<Int>, size: Int, reason: Outcome }

fn property_outcome<a | e>(property: (a) -> Bool / {abort.raise | e}, x: a) -> Outcome / e =
  handle {
    if property(x) { Passed } else { Failed }
  } with {
    abort.raise(message) -> Raised(message),
  }

/// The result of checking a property over the values a generator drew.
pub type CheckResult<a> =
  | Holds
  /// The smallest value found for which the property returns `false`.
  | FailsAt(a)
  /// The smallest value found for which the property raises, and the message it raised.
  | RaisesAt(a, String)
  /// No case drew a value: the generator gave up every time.
  | NothingDrawn

/// Checks `property` over `cases` values drawn by `g`. Each case uses its own stream, and the size
/// rises from 0 at the first case to 63 at the last, so a run of few cases still draws large
/// values. The first value for which `property` returns `false` or raises is shrunk to a smaller value
/// that `g` could have drawn and that fails the same way.
pub fn checked<a | e>(
  g: Gen<a>,
  property: (a) -> Bool / {abort.raise | e},
  cases: Int = 25,
) -> CheckResult<a> / {abort.raise | e} = {
  let start: { drawn: Int, found: Option<Counterexample<a>> } = { drawn: 0, found: None };
  let ran = range(0, cases).fold(
    start,
    |accumulator: { drawn: Int, found: Option<Counterexample<a>> }, case: Int|
      match accumulator.found {
        Some(_) -> accumulator,
        None -> {
          let size = if cases <= 1 { 0 } else { case * 63 / (cases - 1) };
          let drew = sample(g, case, b"check", size, None);
          match drew.value {
            None -> accumulator,
            Some(x) -> match property_outcome(property, x) {
              Passed -> { ..accumulator, drawn: accumulator.drawn + 1 },
              reason ->
                {
                  drawn: accumulator.drawn + 1,
                  found: Some({ value: x, record: drew.record, size: size, reason: reason }),
                },
            },
          }
        },
      },
  );
  match ran.found {
    None -> if ran.drawn > 0 { Holds } else { NothingDrawn },
    Some(first) -> {
      let least = shrink(g, property, first);
      match least.reason {
        Raised(message) -> RaisesAt(least.value, message),
        _ -> FailsAt(least.value),
      }
    },
  }
}

/// Asserts `property` for every value `g` draws, drawn as `checked` draws them. The test fails when
/// `property` returns `false` or raises, naming the smallest such value found. It also fails when `g`
/// drew no value.
pub fn check<a | e>(
  g: Gen<a>,
  property: (a) -> Bool / {abort.raise | e},
  cases: Int = 25,
) -> Unit / {abort.raise | e} = assert_eq(checked(g, property, cases: cases), Holds)

/// `check` of a property of two values, drawn one after the other.
pub fn check2<a, b | e>(
  ga: Gen<a>,
  gb: Gen<b>,
  property: (a, b) -> Bool / {abort.raise | e},
  cases: Int = 25,
) -> Unit / {abort.raise | e} =
  check(map2(ga, gb, |x: a, y: b| (x, y)), |p: (a, b)| property(p._0, p._1), cases: cases)

/// `check` of a property of three values.
pub fn check3<a, b, c | e>(
  ga: Gen<a>,
  gb: Gen<b>,
  gc: Gen<c>,
  property: (a, b, c) -> Bool / {abort.raise | e},
  cases: Int = 25,
) -> Unit / {abort.raise | e} =
  check(
    map3(ga, gb, gc, |x: a, y: b, z: c| (x, y, z)),
    |p: (a, b, c)| property(p._0, p._1, p._2),
    cases: cases,
  )

/// `check` of a property of four values.
pub fn check4<a, b, c, d | e>(
  ga: Gen<a>,
  gb: Gen<b>,
  gc: Gen<c>,
  gd: Gen<d>,
  property: (a, b, c, d) -> Bool / {abort.raise | e},
  cases: Int = 25,
) -> Unit / {abort.raise | e} =
  check(
    map4(ga, gb, gc, gd, |x: a, y: b, z: c, w: d| (x, y, z, w)),
    |p: (a, b, c, d)| property(p._0, p._1, p._2, p._3),
    cases: cases,
  )

fn shrink_candidate(record: List<Int>, k: Int) -> Option<List<Int>> =
  if k == 0 { Some(leading(record, record.len() / 2)) }
  else if k == 1 { Some(leading(record, record.len() - 1)) } else {
    let i = (k - 2) / 3;
    match record.at(i) {
      None -> None,
      Some(v) -> {
        let way = (k - 2) % 3;
        let to = if way == 0 { 0 } else if way == 1 { v / 2 } else { max(v - 1, 0) };
        Some(
          range(0, record.len()).fold([], |accumulator: List<Int>, j: Int|
            accumulator.push(if j == i { to } else { draw_at(record, j) })),
        )
      },
    }
  }

fn before(one: List<Int>, other: List<Int>) -> Bool =
  if one.len() != other.len() { one.len() < other.len() } else {
    range(0, one.len()).fold(None, |decided: Option<Bool>, i: Int|
        match decided {
          Some(_) -> decided,
          None -> {
            let x = draw_at(one, i);
            let y = draw_at(other, i);
            if x == y { None } else { Some(x < y) }
          },
        })
      == Some(true)
  }

fn ends_alike(one: Outcome, other: Outcome) -> Bool =
  match ((one, other)) { (Failed, Failed) -> true, (Raised(_), Raised(_)) -> true, _ -> false }

fn shrink<a | e>(
  g: Gen<a>,
  property: (a) -> Bool / {abort.raise | e},
  first: Counterexample<a>,
) -> Counterexample<a> / {abort.raise | e} =
  range(0, shrink_budget).fold(
    { found: first, way: 0 },
    |s: { found: Counterexample<a>, way: Int }, _step: Int|
      match shrink_candidate(s.found.record, s.way) {
        None -> s,
        Some(record) -> if record == s.found.record { { ..s, way: s.way + 1 } } else {
          let again = sample(g, 0, b"", s.found.size, Some(record));
          match again.value {
            None -> { ..s, way: s.way + 1 },
            Some(x) -> {
              let reason = property_outcome(property, x);
              if ends_alike(reason, s.found.reason) && before(again.record, s.found.record) {
                {
                  found: { value: x, record: again.record, size: s.found.size, reason: reason },
                  way: 0,
                }
              } else { { ..s, way: s.way + 1 } }
            },
          }
        },
      },
  ).found

fn drawn<a>(g: Gen<a>, root: Int, size: Int) -> Sample<a> / {abort.raise} =
  sample(g, root, b"test", size, None)

fn replayed<a>(g: Gen<a>, record: List<Int>) -> Sample<a> / {abort.raise} =
  sample(g, 0, b"", 0, Some(record))

fn pairs() -> Gen<{ small: Int, items: List<Int> }> =
  and_then(int_between(1, 6), |n: Int|
    map(list_of_length(int_between(0 - n, n), n), |items: List<Int>| { small: n, items: items }))

test "`replayed` on the record of a generated sample returns the same value and the same record" {
  check2(any_int(), any_int(), |root: Int, size: Int| {
    let first = sample(pairs(), root, b"law", size, None);
    let again = replayed(pairs(), first.record);
    again.value == first.value && again.record == first.record
  })
}

test "a whole number drawn between two bounds is within them" {
  check3(any_int(), any_int(), any_int(), |low: Int, high: Int, root: Int|
    low > high
      || (match sample(int_between(low, high), root, b"law", 0, None).value {
        Some(n) -> low <= n && n <= high,
        None -> false,
      }))
}

test "a sampled `list_of` is no longer than its maximum length or the sample size, whichever is smaller" {
  check3(
    int_between(0 - 8, 63),
    int_between(0 - 8, 63),
    any_int(),
    |most: Int, size: Int, root: Int|
      match sample(list_of(bool(), most), root, b"law", size, None).value {
        Some(xs) -> xs.len() <= max(0, most) && xs.len() <= max(0, size),
        None -> false,
      },
  )
}

test "`checked` passes a property true of every drawn value, and for a failing one reports the smallest failing value" {
  assert_eq(checked(any_int(), |n: Int| n == n), Holds);
  assert_eq(checked(int_between(0, 1000), |n: Int| n < 10), FailsAt(10));
  let pair = map2(list(int()), int_between(0, 9), |xs: List<Int>, n: Int| (xs, n));
  assert_eq(
    checked(pair, |p: (List<Int>, Int)| p._0.len() < 3 || p._1 < 2),
    FailsAt(([0, 0, 0], 2)),
  )
}

test "a property that raises names the least value it raises at, with what it raised" {
  assert_eq(
    checked(int_between(0, 1000), |n: Int| if n > 4 { panic("past four") } else { true }),
    RaisesAt(5, "past four"),
  )
}

test "a check whose generator draws no value reports that nothing was drawn" {
  let none: Gen<Int> = below(0);
  assert_eq(checked(none, |n: Int| true), NothingDrawn)
}

test "`check` fails its test when the property is false for some value, and passes when it is always true" {
  let failed = |run: () -> Unit / {abort.raise}|
    handle { run() } with { abort.raise(_) -> true, return _done -> false };
  assert(!failed(|| check(bool(), |b: Bool| b || !b)));
  assert(failed(|| check(bool(), |b: Bool| b)));
  assert(failed(|| check3(bool(), bool(), bool(), |x: Bool, y: Bool, z: Bool| x || y || !z)));
  assert(
    !failed(||
      check4(int(), int(), bool(), text(), |x: Int, y: Int, b: Bool, s: String|
        x + y == y + x && (b || s == s))),
  )
}

test "`replayed` with an empty record returns each built-in generator's simplest value, such as 0, an empty list or an empty string" {
  assert_eq(replayed(any_int(), []).value, Some(0));
  assert_eq(replayed(list(any_int()), []).value, Some([]));
  assert_eq(replayed(text(), []).value, Some(""));
  assert_eq(replayed(bytes(), []).value, Some(b""));
  assert_eq(replayed(char(), []).value, Some('a'));
  assert_eq(replayed(float(), []).value, Some(0.0));
  assert_eq(replayed(decimal(), []).value, Some(0m));
  assert_eq(replayed(u32(), []).value, Some(0u32));
  assert_eq(replayed(u64(), [1, 2]).value, Some(4294967298u64));
  assert_eq(replayed(result_of(int(), bool()), []).value, Some(Ok(0)));
  assert_eq(replayed(map_of(int(), bool()), []).value, Some(Map::new()))
}

test "`any_int` sometimes draws the largest integer, and text and lists never exceed sixteen items at large sizes" {
  let greatest = range(0, 200).fold(false, |seen: Bool, root: Int|
    seen || drawn(any_int(), root, 63).value == Some(9223372036854775807));
  assert(greatest);
  assert(
    range(0, 200).fold(true, |ok: Bool, root: Int|
      ok && (match drawn(text(), root, 63).value { Some(s) -> s.len() <= 16, None -> false })
        && (match drawn(list(bool()), root, 3).value { Some(xs) -> xs.len() <= 1, None -> false })),
  )
}

test "`drawn` and `sample` return the same result for the same seed, label and size, and differ when any of them changes" {
  assert_eq(drawn(pairs(), 7, 20), drawn(pairs(), 7, 20));
  assert(
    range(0, 20).fold(false, |differs: Bool, root: Int|
      differs || drawn(pairs(), root, 20).value != drawn(pairs(), root + 1, 20).value),
  );
  assert(sample(int(), 3, b"a", 30, None) != sample(int(), 3, b"b", 30, None))
}

test "`replayed` on the record of a generated value returns the same value and the same record" {
  let all = range(0, 50).fold(true, |ok: Bool, root: Int| {
    let first = drawn(pairs(), root, root);
    let again = replayed(pairs(), first.record);
    ok && again.value == first.value && again.record == first.record
  });
  assert(all)
}

test "`replayed` reads a missing record entry as zero and clamps an entry outside the generator's range" {
  assert_eq(replayed(pairs(), []).value, Some({ small: 1, items: [0 - 1] }));
  assert_eq(replayed(int_between(10, 20), [99]), { value: Some(20), record: [10], rejections: 0 });
  assert_eq(replayed(int_between(10, 20), [0 - 5]).value, Some(10));
  assert_eq(replayed(int(), []).value, Some(0));
  assert_eq(replayed(bool(), []).value, Some(false));
  assert_eq(replayed(list_of(int(), 9), []).value, Some([]));
  assert_eq(replayed(option_of(int()), []).value, Some(None));
  assert_eq(replayed(bytes_of(3), []).value, Some(b"\x00\x00\x00"))
}

test "a bounded draw stays in its bounds, the widest span included" {
  let least = 0 - 9223372036854775807 - 1;
  assert(
    range(0, 200).fold(true, |ok: Bool, root: Int| {
      let narrow = drawn(int_between(0 - 3, 4), root, 10).value;
      let wide = drawn(int_between(least, 9223372036854775807), root, 10).value;
      ok && (match narrow { Some(n) -> n >= 0 - 3 && n <= 4, None -> false }) && wide != None
    }),
  );
  assert_eq(replayed(int_between(least, 9223372036854775807), []).value, Some(least));
  assert_eq(drawn(int_between(5, 4), 0, 10).value, None);
  assert_eq(drawn(below(0), 0, 10).value, None)
}

test "a generated `list_of` list is never longer than its maximum length or the size, and is empty at size zero" {
  assert(
    range(0, 100).fold(true, |ok: Bool, root: Int|
      ok
        && (match drawn(list_of(bool(), 5), root, 40).value {
          Some(xs) -> xs.len() <= 5,
          None -> false,
        })
        && (match drawn(list_of(bool(), 50), root, 3).value {
          Some(xs) -> xs.len() <= 3,
          None -> false,
        })),
  );
  assert_eq(drawn(list_of(bool(), 50), 0, 0).value, Some([]))
}

test "a choice draws each of its options, and none from an empty list" {
  let seen = range(0, 60).fold([], |accumulator: List<Int>, root: Int|
    match drawn(one_of([constant(1), constant(2), elements([3, 4])]), root, 0).value {
      Some(n) -> if accumulator.fold(false, |hit: Bool, x: Int| hit || x == n) { accumulator }
      else { accumulator.push(n) },
      None -> accumulator,
    });
  assert_eq(seen.len(), 4);
  let nothing: List<Int> = [];
  let none: List<Gen<Int>> = [];
  assert_eq(drawn(elements(nothing), 0, 0).value, None);
  assert_eq(drawn(one_of(none), 0, 0).value, None)
}

test "such_that returns what its predicate accepts, counts what it rejected, and gives up at its budget" {
  let even = such_that(int_between(0, 99), |n: Int| n % 2 == 0, 50);
  let run = range(0, 40).fold(
    { ok: true, rejections: 0 },
    |accumulator: { ok: Bool, rejections: Int }, root: Int| {
      let s = drawn(even, root, 0);
      {
        ok: accumulator.ok && (match s.value { Some(n) -> n % 2 == 0, None -> false }),
        rejections: accumulator.rejections + s.rejections,
      }
    },
  );
  assert(run.ok);
  assert(run.rejections > 0);
  let never = drawn(such_that(int_between(0, 99), |n: Int| n > 100, 7), 0, 0);
  assert_eq(never.value, None);
  assert_eq(never.rejections, 7);
  let odd = such_that(int_between(0, 9), |n: Int| n % 2 == 1, 20);
  assert_eq(replayed(odd, [4, 2, 7]), { value: Some(7), record: [4, 2, 7], rejections: 2 })
}

test "a generator that gives up makes what is built from it give up too" {
  let none: Gen<Int> = below(0);
  assert_eq(drawn(map(none, |n: Int| n + 1), 0, 0).value, None);
  assert_eq(drawn(and_then(none, |n: Int| constant(n)), 0, 0).value, None);
  assert_eq(drawn(list_of_length(none, 2), 0, 0).value, None);
  assert_eq(drawn(list_of_length(none, 0), 0, 0).value, Some([]))
}
