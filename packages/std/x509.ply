//! Reads, verifies and builds X.509 certificates as RFC 5280 defines them, and builds certificate
//! requests (PKCS #10).
//!
//! A `Certificate` can only be created by reading one. `read` checks the bytes against DER and the
//! certificate's structure, and stores the exact bytes its signature covers. It parses each
//! extension it knows into a `Content`, and stores any other extension as its DER together with its
//! criticality flag. `Strict` follows RFC 5280 to the letter. `Tolerant` accepts certificates as
//! servers send them: a trusted root with a serial number of zero, and extensions that write out a
//! `critical` flag of false, which DER omits.
//!
//! `verify` depends only on its arguments: the leaf certificate, the certificates sent with it, the
//! trusted anchors, the time, the expected identity, the purpose, and a `Policy`. The time is an
//! argument, so a test of expiry gives the same result on any day. `verify` builds a path by trying
//! every issuer with a matching name until one works, so a certificate cross-signed by an expired
//! root does not hide a path through a root that has not expired. A policy limits the signatures
//! checked and the names compared, so a crafted bundle costs a bounded amount of work. When no path
//! exists, the result names the certificate that failed and a `Fault` saying why.
//!
//! Names follow RFC 9525. A certificate matches a host by its subject alternative names alone; the
//! subject's common name is never read. A wildcard must be the whole first label and matches
//! exactly one label. It is rejected when fewer than two labels follow it, which excludes every
//! name directly under a top-level domain. No list of public suffixes is consulted, so `*.co.uk` is
//! accepted as written. A host given in another script is converted with `std.idna` and compared by
//! its A-labels; an IP address is compared as an address, never as text.
//!
//! Verification supports the algorithms the runtime supports: RSA PKCS #1 and PSS with keys of 2048
//! bits or more over SHA-256, SHA-384 and SHA-512; ECDSA on P-256 and P-384 over SHA-256 and
//! SHA-384; and Ed25519. Signatures with MD5, SHA-1, DSA or any other curve are `Unverifiable`
//! under every policy.
//!
//! Revocation is not checked: nothing here fetches anything, and no CRL or OCSP response is read. A
//! valid path shows only that the certificate was good when it was issued. `AuthorityAccess` and
//! `CrlPoints` give the places a caller could query. Checking the replies would need a reader for
//! CRLs and OCSP responses and the time at which each is valid, and that time would be an argument,
//! as the verification time is.

import std.asn1
import std.asn1 (asn1, Bits, ReadResult, Reader, Ia5String, Value)
import std.bytes
import std.crypto
import std.crypto (Digest, Sha256, Sha384, Sha512, VerifyingKey)
import std.date
import std.date (OffsetDateTime)
import std.hash (sha256)
import std.idna
import std.ip
import std.ip (Ip, Prefix)
import std.list
import std.oid
import std.oid (Oid)
import std.pem
import std.result
import std.show (show)
import std.string
import std.time (nanos_at)
import std.gen

/// The most a reader accepts of one certificate.
pub type Limits = new {
  /// The maximum size of the certificate in bytes.
  bytes: Int,
  /// The maximum number of extensions in the certificate.
  extensions: Int,
  /// The attributes of one name, and the names of one extension.
  names: Int,
  /// The maximum nesting depth of the certificate's DER.
  depth: Int,
}

/// Returns limits far above what any certificate on the public web needs.
pub fn limits() -> Limits = { bytes: 65536, extensions: 64, names: 1024, depth: 16 }

/// One attribute of a name: its type and its text, whatever string type encoded it. A value that is
/// not a string is written as `#` followed by its DER in hex.
pub type Attribute = new { id: Oid, value: String }

/// A distinguished name: its relative names, outermost first, each a set of attributes, and the
/// DER it was read from, which is what two names are compared by.
pub type Name = new { rdns: List<List<Attribute>>, der: Bytes }

/// A name of one of the kinds that X.509 allows in a certificate, such as in its subject
/// alternative names.
pub type GeneralName =
  /// A DNS name exactly as written, including a leading `*.` for a wildcard.
  | Dns(String)
  /// A mailbox.
  | Email(String)
  | Uri(String)
  | Address(Ip)
  | Directory(Name)
  /// An `otherName`: its type and its value's DER.
  | Other(Oid, Bytes)
  | Registered(Oid)
  /// A name of a kind this module does not parse, such as `x400Address` (tag 3) or `ediPartyName`
  /// (tag 5): the tag number and the name's DER bytes.
  | UnsupportedName(Int, Bytes)

/// A set of names that a name constraint permits or excludes.
pub type Subtree =
  /// A DNS name and every name under it; the empty name is every name.
  | DnsTree(String)
  /// A mailbox, every mailbox of a host, or with a leading `.` every mailbox of a domain's hosts.
  | EmailTree(String)
  /// A URI's host, or with a leading `.` every host of a domain.
  | UriTree(String)
  | Network(Prefix)
  /// Every directory name that starts with this one.
  | DirectoryTree(Name)
  /// A set of names of a kind this module does not compare, identified by its tag number.
  | OtherTree(Int)

/// A use a key is certified for.
pub type Usage =
  | DigitalSignature
  | ContentCommitment
  | KeyEncipherment
  | DataEncipherment
  | KeyAgreement
  | KeyCertSign
  | CrlSign
  | EncipherOnly
  | DecipherOnly

/// Where something about a certificate is fetched: the access method and the place.
pub type Access = new { method: Oid, location: GeneralName }

/// The content of an extension, for the extensions this module reads.
pub type Content =
  /// `basicConstraints`: whether the subject is a CA, and how many CAs may follow it.
  | Basic(Bool, Option<Int>)
  | KeyUsage(List<Usage>)
  | ExtendedKeyUsage(List<Oid>)
  | SubjectAltName(List<GeneralName>)
  | IssuerAltName(List<GeneralName>)
  /// `nameConstraints`: the permitted subtrees, then the excluded subtrees.
  | NameConstraints(List<Subtree>, List<Subtree>)
  | SubjectKeyId(Bytes)
  /// `authorityKeyIdentifier`: the key identifier, and whether it names an issuer and serial too.
  | AuthorityKeyId(Option<Bytes>, Bool)
  /// `authorityInfoAccess`: where the issuer's certificate and its OCSP responder are.
  | AuthorityAccess(List<Access>)
  /// `cRLDistributionPoints`: the full names of the points.
  | CrlPoints(List<GeneralName>)
  /// `certificatePolicies`: the policies' identifiers.
  | Policies(List<Oid>)
  /// An extension this module does not parse. Only the raw bytes in `value` are available.
  | Unparsed

/// An extension: its type, whether a verifier that does not understand it must reject the
/// certificate, the DER its `OCTET STRING` contains, and what that DER means.
pub type Extension = new { id: Oid, critical: Bool, value: Bytes, content: Content }

/// A subject's public key.
pub type Key =
  /// RSA: a PKCS #1 `RSAPublicKey`.
  | RsaKey(Bytes)
  /// An elliptic-curve key: the named curve and the point.
  | EcKey(Oid, Bytes)
  /// Ed25519: 32 bytes.
  | Ed25519Key(Bytes)
  /// A key whose algorithm this module cannot verify signatures with, or whose encoding it does not
  /// parse: the algorithm and the key's bits.
  | OtherKey(Oid, Bytes)

/// How a certificate is signed.
pub type Algorithm =
  | RsaPkcs1(Digest)
  | RsaPss(Digest)
  | Ecdsa(Digest)
  | Ed25519
  /// A signature algorithm this module cannot verify, such as one using MD5 or SHA-1.
  | OtherAlgorithm(Oid)

/// The fields of a certificate.
pub type Info = new {
  /// The certificate version: 1, 2 or 3.
  version: Int,
  /// The serial number: an `INTEGER`'s content.
  serial: Bytes,
  algorithm: Algorithm,
  issuer: Name,
  subject: Name,
  not_before: OffsetDateTime,
  not_after: OffsetDateTime,
  key: Key,
  /// The `SubjectPublicKeyInfo`, in DER.
  spki: Bytes,
  extensions: List<Extension>,
}

/// A certificate that was read: its fields, and the bytes they were read from.
pub opaque type Certificate = new { der: Bytes, tbs: Bytes, signature: Bytes, info: Info }

/// Why bytes are not a certificate this module reads.
pub type Error =
  /// The input is longer than the byte limit; the `Int` is its length in bytes.
  | TooLong(Int)
  /// Not DER, or not a certificate's structure.
  | NotDer(asn1::Error)
  /// A version other than 1, 2 or 3, or a version that is too low for the certificate's contents,
  /// such as extensions in a version 1 certificate.
  | BadVersion(Int)
  /// A serial number that is negative. Under `Strict`, a serial number that is zero or longer than
  /// twenty octets is also rejected.
  | BadSerial
  /// The certificate's two copies of the signature algorithm differ.
  | AlgorithmMismatch
  /// A signature that is not whole octets.
  | BadSignature
  /// An extension this module reads whose value does not match its type.
  | Malformed(Oid)
  /// An invalid name: a relative name with no attributes, an IP address that is not four or
  /// sixteen octets, a network whose mask has a hole.
  | BadName
  /// An extension written twice.
  | Duplicate(Oid)
  /// More extensions or names than the limit.
  | TooMany
  /// A PEM text that is not certificates.
  | NotPem
  /// A request not signed by the key it carries.
  | Unproven
  /// A draft contains text that no string type can encode, or a time that cannot be written in a
  /// certificate.
  | Unwritable

/// What this module raises when it rejects input.
pub effect x509 {
  /// The bytes are not a certificate.
  raise fail(e: Error)
}

/// The fields of `c`.
pub fn info(c: Certificate) -> Info = c.info

/// The certificate, in DER.
pub fn der(c: Certificate) -> Bytes = c.der

/// The bytes the signature is over: the `TBSCertificate`, in DER.
pub fn signed_bytes(c: Certificate) -> Bytes = c.tbs

/// The signature.
pub fn signature(c: Certificate) -> Bytes = c.signature

/// SHA-256 of the certificate.
pub fn fingerprint(c: Certificate) -> Bytes / {abort.raise} = sha256(c.der)

/// Returns the SHA-256 hash of the certificate's `SubjectPublicKeyInfo`. Comparing this hash to a
/// known value (a key pin) checks that a certificate has the expected public key, even after the
/// certificate is renewed.
pub fn key_pin(c: Certificate) -> Bytes / {abort.raise} = sha256(c.info.spki)

/// The extension `id`, or `None` when the certificate has none.
pub fn extension(c: Certificate, id: Oid) -> Option<Extension> =
  c.info.extensions.find(|e: Extension| e.id == id)

/// Returns the names in the certificate's `subjectAltName` extension, or an empty list when it has
/// none.
pub fn alt_names(c: Certificate) -> List<GeneralName> =
  c.info.extensions.flat_map(|e: Extension|
    match e.content { SubjectAltName(matches_identity) -> matches_identity, _ -> [] })

/// Whether `basicConstraints` marks the subject as a CA.
pub fn is_ca(c: Certificate) -> Bool =
  c.info.extensions.any(|e: Extension| match e.content { Basic(ca, _) -> ca, _ -> false })

/// Whether the subject and the issuer are one name.
pub fn is_self_issued(c: Certificate) -> Bool = c.info.subject.der == c.info.issuer.der

/// `commonName`, the attribute a client certificate's subject names its holder by.
pub fn common_name() -> Oid = oid::Oid([2, 5, 4, 3])

/// Returns the values of the attributes of type `id` in `n`, in the order they appear in the
/// certificate. That order starts with the most general attribute (such as the country), the
/// reverse of the order `name_text` writes.
pub fn values_of(n: Name, id: Oid) -> List<String> =
  n.rdns.flat_map(|rdn: List<Attribute>|
    rdn.filter(|a: Attribute| a.id == id).map(|a: Attribute| a.value))

/// Returns `n` as a string in the format of RFC 4514. The name's parts are written most specific
/// first, separated by `,`. Attributes within one part are separated by `+`. Each attribute is
/// `TYPE=value`, where `TYPE` is the short name from RFC 4514 (`CN`, `L`, `ST`, `O`, `OU`, `C`,
/// `STREET`, `DC` or `UID`) or else the dotted identifier. Values are escaped as RFC 4514 section
/// 2.4 requires.
pub fn name_text(n: Name) -> String =
  String::join(
    n.rdns.reverse().map(|rdn: List<Attribute>|
      String::join(rdn.map(|a: Attribute| type_text(a.id) ++ "=" ++ escaped_value(a.value)), "+")),
    ",",
  )

fn type_text(id: Oid) -> String =
  match oid::arcs(id) {
    [2, 5, 4, 3] -> "CN",
    [2, 5, 4, 7] -> "L",
    [2, 5, 4, 8] -> "ST",
    [2, 5, 4, 10] -> "O",
    [2, 5, 4, 11] -> "OU",
    [2, 5, 4, 6] -> "C",
    [2, 5, 4, 9] -> "STREET",
    [0, 9, 2342, 19200300, 100, 1, 25] -> "DC",
    [0, 9, 2342, 19200300, 100, 1, 1] -> "UID",
    _ -> oid::to_string(id),
  }

fn escaped_value(v: String) -> String =
  if v.starts_with("#") && v.len() > 1 && all_hex(v.slice(1, v.len())) { v } else {
    let chars = v.chars();
    let last = chars.len() - 1;
    String::join(
      chars.fold({ at: 0, out: [] }, |s: { at: Int, out: List<String> }, c: Char| {
        let n = Int::of_char(c);
        let one = String::of_chars([c]);
        let catch_unwritable = if n == 0 { "\\00" }
        else if n == 34 || n == 43 || n == 44 || n == 59 || n == 60 || n == 62 || n == 92 {
          "\\" ++ one
        } else if (s.at == 0 && (n == 32 || n == 35)) || (s.at == last && n == 32) { "\\" ++ one }
        else { one };
        { at: s.at + 1, out: s.out.push(catch_unwritable) }
      }).out,
      "",
    )
  }

fn all_hex(s: String) -> Bool =
  s.chars().all(|c: Char| {
    let n = Int::of_char(c);
    (n >= 48 && n <= 57) || (n >= 97 && n <= 102) || (n >= 65 && n <= 70)
  })

fn extension_oid(last: Int) -> Oid = oid::Oid([2, 5, 29, last])

fn pkix(arcs: List<Int>) -> Oid = oid::Oid([1, 3, 6, 1, 5, 5, 7].concat(arcs))

/// Returns the extended key usage identifier for authenticating a TLS server (`id-kp-serverAuth`).
pub fn server_auth() -> Oid = pkix([3, 1])

/// Returns the extended key usage identifier for authenticating a TLS client (`id-kp-clientAuth`).
pub fn client_auth() -> Oid = pkix([3, 2])

/// Returns the extended key usage identifier that allows a certificate to be used for any purpose
/// (`anyExtendedKeyUsage`).
pub fn any_purpose() -> Oid = oid::Oid([2, 5, 29, 37, 0])

/// `id-ad-ocsp`: the access method of an OCSP responder.
pub fn ocsp() -> Oid = pkix([48, 1])

/// `id-ad-caIssuers`: the access method of the issuer's certificate.
pub fn ca_issuers() -> Oid = pkix([48, 2])

/// How strictly a certificate is checked against RFC 5280 as it is read.
pub type Strictness =
  /// Rejects any certificate that breaks a rule of RFC 5280.
  | Strict
  /// Follows RFC 5280 except for mistakes that certificates in use make. It accepts a serial number
  /// that is zero (as some trusted roots have) or longer than twenty octets, and an extension that
  /// writes `critical` as false explicitly. It still rejects a negative serial number.
  | Tolerant

effect set ReadEffects = {asn1.fail, x509.fail, abort.raise}

/// Returns the certificate encoded in `data`, which must be DER with nothing after it. Fails with
/// `x509.fail` when `data` does not follow the structure of RFC 5280. The checks cover the version,
/// the serial number, the two copies of the signature algorithm (which must match), and every
/// extension this module reads.
pub fn read(
  data: Bytes,
  limits: Limits,
  mode: Strictness,
) -> Certificate / {x509.fail, abort.raise} =
  if data.len() > limits.bytes { x509.fail(TooLong(data.len())) } else {
    match asn1::decode_with(data, limits.depth, |r: Reader| certificate_at(r, data, limits, mode)) {
      Ok(c) -> c,
      Err(e) -> x509.fail(NotDer(e)),
    }
  }

/// `read`, returning an error as an `Err`.
pub fn parse(
  data: Bytes,
  limits: Limits,
  mode: Strictness,
) -> Result<Certificate, Error> / {abort.raise} = try { read(data, limits, mode) }

/// The certificates in a PEM text, in order, each read as `read` reads one. Raises `NotPem` for a
/// text that is not PEM or contains a block that is not a `CERTIFICATE`.
pub fn read_pem(
  text: String,
  limits: Limits,
  mode: Strictness,
) -> List<Certificate> / {x509.fail, abort.raise} =
  match pem::decode(text, limits.bytes * 64) {
    Err(_) -> x509.fail(NotPem),
    Ok(items) ->
      items.map(|item: pem::Item|
        match item {
          pem::Open(block) -> if pem::label_text(block.label) == "CERTIFICATE" {
            read(block.data, limits, mode)
          } else { x509.fail(NotPem) },
          pem::Sealed(_) -> x509.fail(NotPem),
        }),
  }

/// Returns `certificates` as PEM text, with one `CERTIFICATE` block per certificate in order.
/// `read_pem` reads the result back. To write the chain file a server sends, list the leaf
/// certificate first, then its intermediates.
pub fn write_pem(certificates: List<Certificate>) -> String / {abort.raise} =
  certificates.fold("", |text: String, c: Certificate| {
    let block: pem::Block = { label: pem::Certificate, headers: [], data: c.der };
    match pem::encode(block) {
      Ok(catch_unwritable) -> text ++ catch_unwritable,
      Err(_) -> panic("encoding a `CERTIFICATE` block as PEM never fails"),
    }
  })

fn certificate_at(
  r: Reader,
  data: Bytes,
  limits: Limits,
  mode: Strictness,
) -> ReadResult<Certificate> / {ReadEffects} =
  asn1::within(asn1::read_sequence(r), |fields: Reader| {
    let tbs = asn1::read_raw(fields);
    let body = asn1::within(asn1::read_sequence(fields), |t: Reader| body_at(t, limits, mode));
    let outer = asn1::read_raw(body.rest);
    let signature = asn1::read_bit_string(outer.rest);
    if outer.value != body.value.algorithm { x509.fail(AlgorithmMismatch) }
    else if signature.value.unused != 0 { x509.fail(BadSignature) } else {
      {
        value: {
          der: data,
          tbs: tbs.value,
          signature: signature.value.bytes,
          info: body.value.info,
        },
        rest: signature.rest,
      }
    }
  })

fn body_at(
  t: Reader,
  limits: Limits,
  mode: Strictness,
) -> ReadResult<{ info: Info, algorithm: Bytes }> / {ReadEffects} = {
  let version = asn1::read_default(t, asn1::context(0), 0, |r: Reader|
    asn1::read_explicit(r, asn1::context(0), asn1::read_int));
  let serial = asn1::read_integer(version.rest);
  let catch_unwritable = asn1::read_raw(serial.rest);
  let algorithm = algorithm_at(serial.rest);
  let issuer = name_at(algorithm.rest, limits);
  let validity = asn1::within(asn1::read_sequence(issuer.rest), |v: Reader| {
    let from = asn1::read_time(v);
    let until = asn1::read_time(from.rest);
    { value: { from: from.value, until: until.value }, rest: until.rest }
  });
  let subject = name_at(validity.rest, limits);
  let spki = asn1::read_raw(subject.rest);
  let key = key_at(subject.rest);
  let issuer_id = asn1::read_optional(key.rest, asn1::context(1), |r: Reader|
    asn1::read_implicit(r, asn1::context(1), asn1::read_bit_string));
  let subject_id = asn1::read_optional(issuer_id.rest, asn1::context(2), |r: Reader|
    asn1::read_implicit(r, asn1::context(2), asn1::read_bit_string));
  let extensions = asn1::read_optional(subject_id.rest, asn1::context(3), |r: Reader|
    asn1::read_explicit(r, asn1::context(3), |x: Reader|
      asn1::read_sequence_of(x, |e: Reader| extension_at(e, limits, mode))));
  let ids = issuer_id.value != None || subject_id.value != None;
  let listed = match extensions.value { Some(list) -> list, None -> [] };
  if version.value < 0 || version.value > 2 { x509.fail(BadVersion(version.value + 1)) }
  else if (version.value < 2 && extensions.value != None) || (version.value < 1 && ids)
      || extensions.value == Some([]) { x509.fail(BadVersion(version.value + 1)) }
  else if !serial_allowed(serial.value, mode) { x509.fail(BadSerial) }
  else if listed.len() > limits.extensions { x509.fail(TooMany) } else {
    check_unique_extensions(listed);
    {
      value: {
        info: {
          version: version.value + 1,
          serial: serial.value,
          algorithm: algorithm.value,
          issuer: issuer.value,
          subject: subject.value,
          not_before: validity.value.from,
          not_after: validity.value.until,
          key: key.value,
          spki: spki.value,
          extensions: listed,
        },
        algorithm: catch_unwritable.value,
      },
      rest: extensions.rest,
    }
  }
}

fn serial_allowed(serial: Bytes, mode: Strictness) -> Bool / {abort.raise} =
  serial.at(0) < 0x80 && (mode == Tolerant || (serial.len() <= 20 && serial != b"\x00"))

fn check_unique_extensions(extensions: List<Extension>) -> Unit / {x509.fail} = {
  extensions.fold([], |seen: List<Oid>, e: Extension|
    if seen.contains(e.id) { x509.fail(Duplicate(e.id)) } else { seen.push(e.id) });
  ()
}

fn algorithm_identifier_at(
  r: Reader,
) -> ReadResult<{ id: Oid, parameters: Option<Value> }> / {asn1.fail, abort.raise} =
  asn1::within(asn1::read_sequence(r), |a: Reader| {
    let id = asn1::read_oid(a);
    if asn1::is_empty(id.rest) { { value: { id: id.value, parameters: None }, rest: id.rest } }
    else {
      let parameters = asn1::read_any(id.rest);
      { value: { id: id.value, parameters: Some(parameters.value) }, rest: parameters.rest }
    }
  })

fn digest_of(id: Oid) -> Option<Digest> =
  if id == oid::sha256() { Some(Sha256) }
  else if id == oid::sha384() { Some(Sha384) }
  else if id == oid::sha512() { Some(Sha512) }
  else { None }

fn digest_length(d: Digest) -> Int = match d { Sha256 -> 32, Sha384 -> 48, Sha512 -> 64 }

fn hash_named(v: Value) -> Option<Digest> =
  match v {
    asn1::Sequence([asn1::ObjectId(id)]) -> digest_of(id),
    asn1::Sequence([asn1::ObjectId(id), asn1::Null]) -> digest_of(id),
    _ -> None,
  }

fn pss_digest(parameters: Value) -> Option<Digest> =
  match parameters {
    asn1::Sequence([asn1::Constructed(_, [hash]), asn1::Constructed(_, [asn1::Sequence([asn1::ObjectId(mgf), masked])]), asn1::Constructed(_, [asn1::Integer(salt)])]) -> match hash_named(
        hash,
      ) {
      Some(d) -> if mgf == oid::Oid([1, 2, 840, 113549, 1, 1, 8]) && hash_named(masked) == Some(d)
          && asn1::int_of_integer(salt) == Some(digest_length(d)) { Some(d) }
      else { None },
      None -> None,
    },
    _ -> None,
  }

fn algorithm_at(r: Reader) -> ReadResult<Algorithm> / {asn1.fail, abort.raise} = {
  let found = algorithm_identifier_at(r);
  let id = found.value.id;
  let bare = found.value.parameters == None;
  let null = found.value.parameters == Some(asn1::Null);
  let rsa = |d: Digest| if null { RsaPkcs1(d) } else { OtherAlgorithm(id) };
  let ec = |d: Digest| if bare { Ecdsa(d) } else { OtherAlgorithm(id) };
  let algorithm = if id == oid::sha256_with_rsa_encryption() { rsa(Sha256) }
  else if id == oid::sha384_with_rsa_encryption() { rsa(Sha384) }
  else if id == oid::sha512_with_rsa_encryption() { rsa(Sha512) }
  else if id == oid::ecdsa_with_sha256() { ec(Sha256) }
  else if id == oid::ecdsa_with_sha384() { ec(Sha384) }
  else if id == oid::Oid([1, 2, 840, 10045, 4, 3, 4]) { ec(Sha512) }
  else if id == oid::ed25519() && bare { Ed25519 } else if id == oid::rsassa_pss() {
    match found.value.parameters {
      Some(parameters) -> match pss_digest(parameters) {
        Some(d) -> RsaPss(d),
        None -> OtherAlgorithm(id),
      },
      None -> OtherAlgorithm(id),
    }
  } else { OtherAlgorithm(id) };
  { value: algorithm, rest: found.rest }
}

fn key_at(r: Reader) -> ReadResult<Key> / {asn1.fail, abort.raise} =
  asn1::within(asn1::read_sequence(r), |s: Reader| {
    let found = algorithm_identifier_at(s);
    let bits = asn1::read_bit_string(found.rest);
    let id = found.value.id;
    let whole = bits.value.unused == 0;
    let key = if id == oid::rsa_encryption() && found.value.parameters == Some(asn1::Null) && whole
        && crypto::rsa_modulus_bits(bits.value.bytes) != None { RsaKey(bits.value.bytes) }
    else if id == oid::ed25519() && found.value.parameters == None && whole
        && bits.value.bytes.len() == 32 { Ed25519Key(bits.value.bytes) }
    else if id == oid::ec_public_key() && whole {
      match found.value.parameters {
        Some(asn1::ObjectId(curve)) -> EcKey(curve, bits.value.bytes),
        _ -> OtherKey(id, bits.value.bytes),
      }
    } else { OtherKey(id, bits.value.bytes) };
    { value: key, rest: bits.rest }
  })

fn latin1(bytes: Bytes) -> String / {abort.raise} =
  String::of_chars(
    range(0, bytes.len()).flat_map(|i: Int|
      match Char::of_int(bytes.at(i)) { Some(c) -> [c], None -> [] }),
  )

fn attribute_at(r: Reader) -> ReadResult<Attribute> / {asn1.fail, abort.raise} =
  asn1::within(asn1::read_sequence(r), |a: Reader| {
    let id = asn1::read_oid(a);
    let raw = asn1::read_raw(id.rest);
    let value = asn1::read_any(id.rest);
    let text = match value.value {
      asn1::Text(_, text) -> text,
      asn1::Primitive(tag, content) -> if tag == asn1::universal(20) { latin1(content) }
      else { "#" ++ raw.value.hex_of() },
      _ -> "#" ++ raw.value.hex_of(),
    };
    { value: { id: id.value, value: text }, rest: value.rest }
  })

fn name_at(r: Reader, limits: Limits) -> ReadResult<Name> / {ReadEffects} = {
  let raw = asn1::read_raw(r);
  let rdns = asn1::read_sequence_of(r, |rdn: Reader| asn1::read_set_of(rdn, attribute_at));
  if rdns.value.fold(0, |n: Int, rdn: List<Attribute>| n + rdn.len()) > limits.names {
    x509.fail(TooMany)
  } else if rdns.value.any(|rdn: List<Attribute>| rdn.len() == 0) { x509.fail(BadName) }
  else { { value: { rdns: rdns.value, der: raw.value }, rest: rdns.rest } }
}

fn ia5(r: Reader, number: Int) -> ReadResult<String> / {asn1.fail, abort.raise} =
  asn1::read_implicit(r, asn1::context(number), |x: Reader| asn1::read_string(x, Ia5String))

fn general_name_at(r: Reader, limits: Limits) -> ReadResult<GeneralName> / {ReadEffects} = {
  let number = match asn1::peek(r) { Some(tag) -> tag.number, None -> 0 - 1 };
  if number == 1 {
    let text = ia5(r, 1);
    { value: Email(text.value), rest: text.rest }
  } else if number == 2 {
    let text = ia5(r, 2);
    { value: Dns(text.value), rest: text.rest }
  } else if number == 6 {
    let text = ia5(r, 6);
    { value: Uri(text.value), rest: text.rest }
  } else if number == 7 {
    let octets = asn1::read_primitive(r, asn1::context(7));
    match ip::of_bytes(octets.value) {
      Some(address) -> { value: Address(address), rest: octets.rest },
      None -> x509.fail(BadName),
    }
  } else if number == 4 {
    let name = asn1::read_explicit(r, asn1::context(4), |x: Reader| name_at(x, limits));
    { value: Directory(name.value), rest: name.rest }
  } else if number == 8 {
    let id = asn1::read_implicit(r, asn1::context(8), asn1::read_oid);
    { value: Registered(id.value), rest: id.rest }
  } else if number == 0 {
    let other = asn1::within(asn1::read_constructed(r, asn1::context(0)), |x: Reader| {
      let id = asn1::read_oid(x);
      let value = asn1::read_raw(id.rest);
      { value: Other(id.value, value.value), rest: value.rest }
    });
    other
  } else {
    let raw = asn1::read_raw(r);
    { value: UnsupportedName(number, raw.value), rest: raw.rest }
  }
}

fn general_names_at(r: Reader, limits: Limits) -> ReadResult<List<GeneralName>> / {ReadEffects} = {
  let matches_identity = asn1::read_sequence_of(r, |x: Reader| general_name_at(x, limits));
  if matches_identity.value.len() > limits.names { x509.fail(TooMany) } else { matches_identity }
}

fn mask_length(mask: Bytes) -> Option<Int> / {abort.raise} = {
  let bits = range(0, mask.len()).flat_map(|i: Int|
    range(0, 8).map(|b: Int| mask.at(i) >>> 7 - b & 1));
  let ones = bits.count(|b: Int| b == 1);
  if range(0, bits.len()).fold(true, |ok: Bool, i: Int|
      ok && bits.at(i) == Some(if i < ones { 1 } else { 0 })) { Some(ones) }
  else { None }
}

fn subtree_at(r: Reader, limits: Limits) -> ReadResult<Subtree> / {ReadEffects} =
  asn1::within(asn1::read_sequence(r), |s: Reader| {
    if asn1::peek(s) == Some(asn1::context(7)) {
      let octets = asn1::read_primitive(s, asn1::context(7));
      let half = octets.value.len() / 2;
      let network = match ((
          ip::of_bytes(octets.value.slice(0, half)),
          mask_length(octets.value.slice(half, 2 * half)),
        )) {
        (Some(address), Some(length)) -> ip::prefix_containing(address, length),
        _ -> None,
      };
      match network {
        Some(p) -> { value: Network(p), rest: octets.rest },
        None -> x509.fail(BadName),
      }
    } else {
      let base = general_name_at(s, limits);
      let tree = match base.value {
        Dns(name) -> DnsTree(name),
        Email(mailbox) -> EmailTree(mailbox),
        Uri(host) -> UriTree(host),
        Directory(name) -> DirectoryTree(name),
        Address(_) -> x509.fail(BadName),
        Other(_, _) -> OtherTree(0),
        Registered(_) -> OtherTree(8),
        UnsupportedName(number, _) -> OtherTree(number),
      };
      { value: tree, rest: base.rest }
    }
  })

fn subtrees_at(
  r: Reader,
  number: Int,
  limits: Limits,
) -> ReadResult<Option<List<Subtree>>> / {ReadEffects} =
  asn1::read_optional(r, asn1::context(number), |x: Reader| {
    let trees = asn1::read_implicit(x, asn1::context(number), |y: Reader|
      asn1::read_sequence_of(y, |s: Reader| subtree_at(s, limits)));
    if trees.value.len() == 0 { x509.fail(BadName) }
    else if trees.value.len() > limits.names { x509.fail(TooMany) }
    else { trees }
  })

fn usage_at(bit: Int) -> Option<Usage> =
  [
    DigitalSignature,
    ContentCommitment,
    KeyEncipherment,
    DataEncipherment,
    KeyAgreement,
    KeyCertSign,
    CrlSign,
    EncipherOnly,
    DecipherOnly,
  ].at(
    bit,
  )

fn content_at(id: Oid, r: Reader, limits: Limits) -> ReadResult<Content> / {ReadEffects} =
  if id == oid::basic_constraints() {
    asn1::within(asn1::read_sequence(r), |s: Reader| {
      let ca = asn1::read_default(s, asn1::universal(1), false, asn1::read_boolean);
      let length = asn1::read_optional(ca.rest, asn1::universal(2), asn1::read_int);
      { value: Basic(ca.value, length.value), rest: length.rest }
    })
  } else if id == oid::key_usage() {
    let bits = asn1::read_named_bits(r);
    let width = bits.value.bytes.len() * 8 - bits.value.unused;
    {
      value: KeyUsage(
        range(0, min(width, 9)).flat_map(|i: Int|
          if asn1::bit_at(bits.value, i) { match usage_at(i) { Some(u) -> [u], None -> [] } }
          else { [] }),
      ),
      rest: bits.rest,
    }
  } else if id == oid::extended_key_usage() {
    let purposes = asn1::read_sequence_of(r, asn1::read_oid);
    if purposes.value.len() == 0 { x509.fail(Malformed(id)) }
    else { { value: ExtendedKeyUsage(purposes.value), rest: purposes.rest } }
  } else if id == oid::subject_alt_name() || id == extension_oid(18) {
    let matches_identity = general_names_at(r, limits);
    if matches_identity.value.len() == 0 { x509.fail(Malformed(id)) }
    else if id == extension_oid(18) {
      { value: IssuerAltName(matches_identity.value), rest: matches_identity.rest }
    } else { { value: SubjectAltName(matches_identity.value), rest: matches_identity.rest } }
  } else if id == extension_oid(30) {
    asn1::within(asn1::read_sequence(r), |s: Reader| {
      let permitted = subtrees_at(s, 0, limits);
      let excluded = subtrees_at(permitted.rest, 1, limits);
      if permitted.value == None && excluded.value == None { x509.fail(Malformed(id)) } else {
        {
          value: NameConstraints(
            match permitted.value { Some(trees) -> trees, None -> [] },
            match excluded.value { Some(trees) -> trees, None -> [] },
          ),
          rest: excluded.rest,
        }
      }
    })
  } else if id == oid::subject_key_identifier() {
    let key = asn1::read_octet_string(r);
    { value: SubjectKeyId(key.value), rest: key.rest }
  } else if id == oid::authority_key_identifier() {
    asn1::within(asn1::read_sequence(r), |s: Reader| {
      let key = asn1::read_optional(s, asn1::context(0), |x: Reader|
        asn1::read_implicit(x, asn1::context(0), asn1::read_octet_string));
      let issuer = asn1::read_optional(key.rest, asn1::context(1), asn1::read_raw);
      let serial = asn1::read_optional(issuer.rest, asn1::context(2), asn1::read_raw);
      {
        value: AuthorityKeyId(key.value, issuer.value != None || serial.value != None),
        rest: serial.rest,
      }
    })
  } else if id == pkix([1, 1]) {
    let places = asn1::read_sequence_of(r, |x: Reader|
      asn1::within(asn1::read_sequence(x), |a: Reader| {
        let method = asn1::read_oid(a);
        let location = general_name_at(method.rest, limits);
        let access: Access = { method: method.value, location: location.value };
        { value: access, rest: location.rest }
      }));
    if places.value.len() == 0 { x509.fail(Malformed(id)) }
    else { { value: AuthorityAccess(places.value), rest: places.rest } }
  } else if id == extension_oid(31) {
    let points = asn1::read_sequence_of(r, |x: Reader|
      asn1::within(asn1::read_sequence(x), |p: Reader| {
        let named = asn1::read_optional(p, asn1::context(0), |n: Reader|
          asn1::read_explicit(n, asn1::context(0), |full: Reader|
            if asn1::peek(full) == Some(asn1::context(0)) {
              asn1::read_implicit(full, asn1::context(0), |g: Reader| general_names_at(g, limits))
            } else {
              let relative = asn1::read_raw(full);
              { value: [], rest: relative.rest }
            }));
        let reasons = asn1::read_optional(named.rest, asn1::context(1), asn1::read_raw);
        let issuer = asn1::read_optional(reasons.rest, asn1::context(2), asn1::read_raw);
        {
          value: match named.value { Some(matches_identity) -> matches_identity, None -> [] },
          rest: issuer.rest,
        }
      }));
    {
      value: CrlPoints(
        points.value.flat_map(|matches_identity: List<GeneralName>| matches_identity),
      ),
      rest: points.rest,
    }
  } else if id == extension_oid(32) {
    let policies = asn1::read_sequence_of(r, |x: Reader|
      asn1::within(asn1::read_sequence(x), |p: Reader| {
        let policy = asn1::read_oid(p);
        let qualifiers = asn1::read_optional(policy.rest, asn1::universal(16), asn1::read_raw);
        { value: policy.value, rest: qualifiers.rest }
      }));
    { value: Policies(policies.value), rest: policies.rest }
  } else {
    let whole = asn1::read_raw(r);
    { value: Unparsed, rest: whole.rest }
  }

fn is_supported_extension(id: Oid) -> Bool =
  [
    oid::basic_constraints(),
    oid::key_usage(),
    oid::extended_key_usage(),
    oid::subject_alt_name(),
    extension_oid(18),
    extension_oid(30),
    oid::subject_key_identifier(),
    oid::authority_key_identifier(),
    pkix([1, 1]),
    extension_oid(31),
    extension_oid(32),
  ].contains(
    id,
  )

fn extension_at(
  r: Reader,
  limits: Limits,
  mode: Strictness,
) -> ReadResult<Extension> / {ReadEffects} =
  asn1::within(asn1::read_sequence(r), |e: Reader| {
    let id = asn1::read_oid(e);
    let critical = if mode == Strict {
      asn1::read_default(id.rest, asn1::universal(1), false, asn1::read_boolean)
    } else {
      let catch_unwritable = asn1::read_optional(id.rest, asn1::universal(1), asn1::read_boolean);
      { value: catch_unwritable.value == Some(true), rest: catch_unwritable.rest }
    };
    let value = asn1::read_octet_string(critical.rest);
    let content = if !is_supported_extension(id.value) { Unparsed } else {
      match asn1::decode_with(value.value, limits.depth, |x: Reader|
          content_at(id.value, x, limits)) {
        Ok(content) -> content,
        Err(_) -> x509.fail(Malformed(id.value)),
      }
    };
    {
      value: { id: id.value, critical: critical.value, value: value.value, content: content },
      rest: value.rest,
    }
  })

fn is_valid_label(label: String) -> Bool = {
  let b = Bytes::of_string(label);
  let n = b.len();
  n >= 1 && n <= 63 && b.scan(0, b"abcdefghijklmnopqrstuvwxyz0123456789-", n) == n
    && b.at(0) != b'-'
    && b.at(n - 1) != b'-'
}

fn all_digits(label: String) -> Bool = {
  let b = Bytes::of_string(label);
  b.scan(0, b"0123456789", b.len()) == b.len()
}

fn labels_of(name: String) -> Option<List<String>> =
  if !name.is_ascii() || name.len() == 0 || name.len() > 253 { None } else {
    let labels = name.ascii_lower().split(".");
    let numeric = match labels.at(labels.len() - 1) { Some(l) -> all_digits(l), None -> true };
    if labels.all(is_valid_label) && !numeric { Some(labels) } else { None }
  }

type Pattern = { wildcard: Bool, labels: List<String> }

fn pattern_of(name: String) -> Option<Pattern> / {abort.raise} = {
  let wildcard = name.starts_with("*.");
  match labels_of(if wildcard { name.slice(2, name.len()) } else { name }) {
    Some(labels) -> if wildcard && labels.len() < 2 { None }
    else { Some({ wildcard: wildcard, labels: labels }) },
    None -> None,
  }
}

fn host_labels(host: String) -> Option<List<String>> / {abort.raise} = {
  let bare = if host.ends_with(".") { host.slice(0, host.len() - 1) } else { host };
  if bare.is_ascii() { labels_of(bare) } else {
    match idna::to_ascii(bare, idna::strict()) { Ok(name) -> labels_of(name), Err(_) -> None }
  }
}

fn tail_of(labels: List<String>, n: Int) -> List<String> =
  range(max(labels.len() - n, 0), labels.len()).fold([], |tail: List<String>, i: Int|
    match labels.at(i) { Some(l) -> tail.push(l), None -> tail })

fn ends_with(labels: List<String>, tail: List<String>) -> Bool =
  labels.len() >= tail.len() && tail_of(labels, tail.len()) == tail

/// Who a certificate is expected to be for.
pub type Identity =
  /// A host identified by its DNS name, written in ASCII or in Unicode.
  | Host(String)
  /// A host, by its address.
  | IpAddress(Ip)
  /// Whoever the certificate names: no name is checked.
  | Anyone

/// Whether `c` is for `who`, as RFC 9525 reads a certificate: by its subject alternative names
/// alone, never the subject's common name. A DNS name matches a host without regard to case, with
/// a wildcard matching exactly one label, the first; an IP address matches an address.
pub fn matches_identity(c: Certificate, who: Identity) -> Bool / {abort.raise} =
  match who {
    Anyone -> true,
    IpAddress(address) -> alt_names(c).any(|n: GeneralName| n == Address(address)),
    Host(host) -> match host_labels(host) {
      None -> false,
      Some(labels) ->
        alt_names(c).any(|n: GeneralName|
          match n {
            Dns(presented) -> match pattern_of(presented) {
              Some(p) -> if p.wildcard {
                labels.len() == p.labels.len() + 1 && ends_with(labels, p.labels)
              } else { labels == p.labels },
              None -> false,
            },
            _ -> false,
          }),
    },
  }

type Containment = | Inside | Outside | Garbled

fn containment_if(inside: Bool) -> Containment = if inside { Inside } else { Outside }

fn mailbox_of(mailbox: String) -> Option<{ local: String, host: List<String> }> =
  match mailbox.split("@") {
    [local, host] -> match labels_of(host) {
      Some(labels) -> if local == "" { None } else { Some({ local: local, host: labels }) },
      None -> None,
    },
    _ -> None,
  }

fn uri_host(uri: String) -> Option<List<String>> =
  match uri.split("://") {
    [_, rest, ..] -> {
      let authority = match rest.split("/") { [a, ..] -> a, [] -> rest };
      let unqueried = match authority.split("?") { [a, ..] -> a, [] -> authority };
      let host = match unqueried.split("@") { [_, h] -> h, [h] -> h, _ -> "" };
      labels_of(match host.split(":") { [h, ..] -> h, [] -> host })
    },
    _ -> None,
  }

fn host_containment(host: List<String>, tree: String) -> Containment / {abort.raise} =
  if tree.starts_with(".") {
    match labels_of(tree.slice(1, tree.len())) {
      Some(domain) -> containment_if(host.len() > domain.len() && ends_with(host, domain)),
      None -> Garbled,
    }
  } else { match labels_of(tree) { Some(exact) -> containment_if(host == exact), None -> Garbled } }

fn containment(name: GeneralName, tree: Subtree, excluding: Bool) -> Containment / {abort.raise} =
  match ((name, tree)) {
    (Dns(presented), DnsTree(base)) -> match ((pattern_of(presented), labels_of(base))) {
      (Some(p), None) -> if base == "" { Inside } else { Garbled },
      (Some(p), Some(under)) ->
        containment_if(
          ends_with(p.labels, under)
            || (excluding && p.wildcard && under.len() == p.labels.len() + 1
            && ends_with(under, p.labels)),
        ),
      _ -> Garbled,
    },
    (Email(mailbox), EmailTree(base)) -> match mailbox_of(mailbox) {
      None -> Garbled,
      Some(m) -> if base.contains("@") {
        match mailbox_of(base) {
          Some(exact) -> containment_if(m.local == exact.local && m.host == exact.host),
          None -> Garbled,
        }
      } else { host_containment(m.host, base) },
    },
    (Uri(uri), UriTree(base)) -> match uri_host(uri) {
      Some(host) -> host_containment(host, base),
      None -> Garbled,
    },
    (Address(address), Network(net)) -> containment_if(ip::contains(net, address)),
    (Directory(found), DirectoryTree(base)) ->
      containment_if(
        found.rdns.len() >= base.rdns.len()
          && range(0, base.rdns.len()).fold(true, |same: Bool, i: Int|
            same && found.rdns.at(i) == base.rdns.at(i)),
      ),
    _ -> Garbled,
  }

fn name_kind(name: GeneralName) -> Int =
  match name {
    Other(_, _) -> 0,
    Email(_) -> 1,
    Dns(_) -> 2,
    UnsupportedName(number, _) -> number,
    Directory(_) -> 4,
    Uri(_) -> 6,
    Address(_) -> 7,
    Registered(_) -> 8,
  }

fn tree_kind(tree: Subtree) -> Int =
  match tree {
    OtherTree(number) -> number,
    EmailTree(_) -> 1,
    DnsTree(_) -> 2,
    DirectoryTree(_) -> 4,
    UriTree(_) -> 6,
    Network(_) -> 7,
  }

fn constrained_names(c: Certificate) -> List<GeneralName> =
  if c.info.subject.rdns.len() == 0 { alt_names(c) }
  else { alt_names(c).push(Directory(c.info.subject)) }

/// What a certificate's key is to be used for.
pub type Purpose =
  /// Proving a server's name to a client: `id-kp-serverAuth`.
  | ServerAuth
  /// Proving a client to a server: `id-kp-clientAuth`.
  | ClientAuth

/// The most a verification may spend, and the rules it checks a path against.
pub type Policy = new {
  /// The most signatures checked.
  signatures: Int,
  /// The most CAs allowed between the leaf and the anchor. A self-issued CA is not counted.
  depth: Int,
  /// The most comparisons of a name with a constraint.
  comparisons: Int,
  /// The fewest bits of an RSA modulus.
  rsa_bits: Int,
  /// Whether a path must also meet the CA/Browser Forum's requirements for public certificates,
  /// which go beyond RFC 5280. They are checked by `profile_fault`.
  web: Bool,
}

/// Returns the policy for verifying public certificates. It allows at most 100 signature checks, 6
/// CAs between the leaf and the trust anchor, and 100000 name comparisons, requires RSA keys of at
/// least 2048 bits, and enforces the CA/Browser Forum requirements.
pub fn strict() -> Policy =
  { signatures: 100, depth: 6, comparisons: 100000, rsa_bits: 2048, web: true }

/// `strict` without the web's profile, for a private CA not built to that profile.
pub fn private_ca() -> Policy = { ..strict(), web: false }

/// Why no valid path exists.
pub type Fault =
  /// The time is before the certificate's first instant.
  | NotYetValid
  /// The time is after the certificate's last valid instant.
  | Expired
  /// The certificate is not valid for the name or identity that was expected.
  | NameMismatch
  /// Its extended key usage does not include the purpose.
  | WrongPurpose
  /// The certificate's key usage does not allow the use it is put to. A CA must allow signing
  /// certificates; a certificate that is not a CA must not.
  | WrongUsage
  /// A leaf marked as a CA.
  | LeafIsCa
  /// An issuer that is not a CA: no `basicConstraints` marking it as one, or a key usage without
  /// `keyCertSign`.
  | NotACa
  /// More CAs follow it than its path length allows.
  | PathLength
  /// No issuer was found for the certificate. Neither the offered certificates nor the trusted
  /// anchors contain a certificate whose subject is this certificate's issuer name and whose key
  /// verifies this certificate's signature.
  | Unissued
  /// A critical extension this module does not read.
  | UnknownCritical(Oid)
  /// An RSA key with fewer bits than the policy's `rsa_bits`, or with a modulus whose size is not a
  /// whole number of bytes.
  | WeakKey
  /// A key or signature uses an algorithm this module cannot verify: MD5, SHA-1, DSA, or an
  /// elliptic curve other than P-256 and P-384.
  | Unverifiable
  /// A name that a CA above the certificate excludes, or a name that cannot be checked against a
  /// constraint.
  | Excluded(GeneralName)
  /// A name outside what a CA above it permits.
  | NotPermitted(GeneralName)
  /// An extension that is not allowed where it appears or in the profile the policy requires, or a
  /// required extension that is missing.
  | Misplaced(Oid)
  /// The path is longer than the policy's depth.
  | TooDeep
  /// The policy's budget of signatures or comparisons ran out.
  | Spent

/// Why verification failed: the certificate at fault, and the reason.
pub type Failure = new { certificate: Certificate, reason: Fault }

fn first_fault(faults: List<Option<Fault>>) -> Option<Fault> =
  faults.fold(None, |found: Option<Fault>, next: Option<Fault>|
    if found == None { next } else { found })

fn fault_if(fault: Fault, condition: Bool) -> Option<Fault> =
  if condition { Some(fault) } else { None }

fn validity_fault(c: Certificate, seconds: Int) -> Option<Fault> =
  if seconds < date::unix_seconds(c.info.not_before) { Some(NotYetValid) }
  else if seconds > date::unix_seconds(c.info.not_after) { Some(Expired) }
  else { None }

fn unknown_critical(c: Certificate) -> Option<Fault> =
  match c.info.extensions.find(|e: Extension| e.critical && e.content == Unparsed) {
    Some(e) -> Some(UnknownCritical(e.id)),
    None -> None,
  }

fn key_fault(key: Key, policy: Policy) -> Option<Fault> =
  match key {
    RsaKey(public) -> match crypto::rsa_modulus_bits(public) {
      Some(bits) -> fault_if(WeakKey, bits < policy.rsa_bits || bits % 8 != 0),
      None -> Some(Unverifiable),
    },
    EcKey(curve, point) ->
      fault_if(Unverifiable, match signing_curve(curve) {
        Some(c) -> point.len() != 2 * crypto::scalar_size(c) + 1,
        None -> true,
      }),
    Ed25519Key(_) -> None,
    OtherKey(_, _) -> Some(Unverifiable),
  }

fn signing_curve(curve: Oid) -> Option<crypto::EcdsaCurve> =
  if curve == oid::prime256v1() { Some(crypto::NistP256) }
  else if curve == oid::secp384r1() { Some(crypto::NistP384) }
  else { None }

fn verifier(key: Key, algorithm: Algorithm, policy: Policy) -> Result<VerifyingKey, Fault> =
  match key_fault(key, policy) {
    Some(fault) -> Err(fault),
    None -> {
      let fixture = match ((key, algorithm)) {
        (RsaKey(public), RsaPkcs1(d)) -> crypto::rsa_pkcs1_verifying(public, d),
        (RsaKey(public), RsaPss(d)) -> crypto::rsa_pss_verifying(public, d),
        (EcKey(curve, point), Ecdsa(d)) -> match signing_curve(curve) {
          Some(c) -> crypto::ecdsa_verifying(c, d, point, crypto::Der),
          None -> None,
        },
        (Ed25519Key(public), Ed25519) -> crypto::ed25519_verifying(public),
        _ -> None,
      };
      match fixture { Some(k) -> Ok(k), None -> Err(Unverifiable) }
    },
  }

fn purpose_id(purpose: Purpose) -> Oid =
  match purpose { ServerAuth -> server_auth(), ClientAuth -> client_auth() }

fn allows_purpose(c: Certificate, purpose: Purpose, ca: Bool) -> Bool =
  c.info.extensions.all(|e: Extension|
    match e.content {
      ExtendedKeyUsage(containment) ->
        containment.contains(purpose_id(purpose)) || (ca && containment.contains(any_purpose())),
      _ -> true,
    })

fn usages(c: Certificate) -> Option<List<Usage>> =
  c.info.extensions.fold(None, |found: Option<List<Usage>>, e: Extension|
    match e.content { KeyUsage(containment) -> Some(containment), _ -> found })

fn has(c: Certificate, id: Oid) -> Bool = extension(c, id) != None

fn is_critical(c: Certificate, id: Oid) -> Bool =
  match extension(c, id) { Some(e) -> e.critical, None -> false }

fn leaf_fault(
  leaf: Certificate,
  seconds: Int,
  who: Identity,
  purpose: Purpose,
  policy: Policy,
) -> Option<Fault> / {abort.raise} =
  first_fault([
    validity_fault(leaf, seconds),
    unknown_critical(leaf),
    fault_if(LeafIsCa, is_ca(leaf)),
    fault_if(WrongUsage, match usages(leaf) {
      Some(containment) -> containment.contains(KeyCertSign),
      None -> false,
    }),
    fault_if(Misplaced(extension_oid(30)), has(leaf, extension_oid(30))),
    fault_if(WrongPurpose, !allows_purpose(leaf, purpose, false)),
    fault_if(NameMismatch, !matches_identity(leaf, who)),
    key_fault(leaf.info.key, policy),
  ])

fn profile_fault(c: Certificate, leaf: Bool, anchor: Bool) -> Option<Fault> = {
  let aki = oid::authority_key_identifier();
  let ski = oid::subject_key_identifier();
  let san = oid::subject_alt_name();
  let unnamed = c.info.subject.rdns.len() == 0;
  let key_id = match extension(c, aki) {
    Some(e) -> match e.content { AuthorityKeyId(Some(id), false) -> Some(id), _ -> None },
    None -> None,
  };
  let own_id = match extension(c, ski) {
    Some(e) -> match e.content { SubjectKeyId(id) -> Some(id), _ -> None },
    None -> None,
  };
  let root = anchor && is_self_issued(c);
  first_fault([
    fault_if(Misplaced(oid::basic_constraints()), c.info.version != 3),
    fault_if(Misplaced(aki), is_critical(c, aki) || (!anchor && key_id == None)),
    fault_if(Misplaced(aki), root && has(c, aki) && (key_id == None || key_id != own_id)),
    fault_if(Misplaced(ski), is_critical(c, ski) || (!leaf && own_id == None)),
    fault_if(
      Misplaced(oid::basic_constraints()),
      !leaf && !is_critical(c, oid::basic_constraints()),
    ),
    fault_if(Misplaced(pkix([1, 1])), is_critical(c, pkix([1, 1]))),
    fault_if(Unissued, c.info.issuer.rdns.len() == 0),
    fault_if(NotACa, !leaf && unnamed),
    fault_if(Misplaced(san), leaf && has(c, san) && is_critical(c, san) != unnamed),
  ])
}

type VerifyInput = {
  intermediates: List<Certificate>,
  anchors: List<Certificate>,
  seconds: Int,
  purpose: Purpose,
  policy: Policy,
}

type PathSearch = {
  path: Option<List<Certificate>>,
  checks: Int,
  failure: Failure,
  furthest_depth: Int,
}

fn failed(c: Certificate, reason: Fault) -> Failure = { certificate: c, reason: reason }

fn record_failure(h: PathSearch, c: Certificate, reason: Fault, depth: Int) -> PathSearch =
  if depth > h.furthest_depth { { ..h, failure: failed(c, reason), furthest_depth: depth } }
  else { h }

fn issuer_fault(case: VerifyInput, path: List<Certificate>, issuer: Certificate) -> Option<Fault> = {
  let following = path.count(|c: Certificate| !is_self_issued(c)) - 1;
  let basic = issuer.info.extensions.fold(None, |found: Option<Content>, e: Extension|
    match e.content { Basic(_, _) -> Some(e.content), _ -> found });
  first_fault([
    validity_fault(issuer, case.seconds),
    match basic {
      Some(Basic(true, None)) -> None,
      Some(Basic(true, Some(most))) -> fault_if(PathLength, max(following, 0) > most),
      _ -> Some(NotACa),
    },
    fault_if(NotACa, match usages(issuer) {
      Some(containment) -> !containment.contains(KeyCertSign),
      None -> false,
    }),
  ])
}

fn path_fault(case: VerifyInput, path: List<Certificate>) -> Option<Failure> / {abort.raise} = {
  let last = path.len() - 1;
  let own = range(0, path.len()).fold(None, |found: Option<Failure>, i: Int|
    match ((found, path.at(i))) {
      (None, Some(c)) -> {
        let fault = first_fault([
          unknown_critical(c),
          key_fault(c.info.key, case.policy),
          fault_if(WrongPurpose, i > 0 && i < last && !allows_purpose(c, case.purpose, true)),
          if case.policy.web { profile_fault(c, i == 0, i == last) } else { None },
        ]);
        match fault { Some(reason) -> Some(failed(c, reason)), None -> None }
      },
      _ -> found,
    });
  if own != None { own } else { constraints_fault(case, path) }
}

fn trees_of(c: Certificate) -> { permitted: List<Subtree>, excluded: List<Subtree> } =
  c.info.extensions.fold(
    { permitted: [], excluded: [] },
    |found: { permitted: List<Subtree>, excluded: List<Subtree> }, e: Extension|
      match e.content {
        NameConstraints(permitted, excluded) -> { permitted: permitted, excluded: excluded },
        _ -> found,
      },
  )

fn constraints_fault(
  case: VerifyInput,
  path: List<Certificate>,
) -> Option<Failure> / {abort.raise} = {
  let pairs = range(1, path.len()).flat_map(|above: Int|
    range(0, above).flat_map(|below: Int|
      match ((path.at(above), path.at(below))) {
        (Some(ca), Some(c)) -> {
          let trees = trees_of(ca);
          if trees.permitted.len() + trees.excluded.len() == 0 || (below > 0 && is_self_issued(c)) {
            []
          } else { [{ trees: trees, certificate: c, names: constrained_names(c) }] }
        },
        _ -> [],
      }));
  let cost = pairs.fold(0, |n: Int, p: Checked|
    n + p.names.len() * (p.trees.permitted.len() + p.trees.excluded.len()));
  if cost > case.policy.comparisons {
    match path.at(0) { Some(leaf) -> Some(failed(leaf, Spent)), None -> None }
  } else {
    pairs.fold(None, |found: Option<Failure>, p: Checked|
      if found != None { found } else {
        match first_fault(
            p.names.map(|n: GeneralName| name_fault(n, p.trees.permitted, p.trees.excluded)),
          ) {
          Some(reason) -> Some(failed(p.certificate, reason)),
          None -> None,
        }
      })
  }
}

type Checked = {
  trees: { permitted: List<Subtree>, excluded: List<Subtree> },
  certificate: Certificate,
  names: List<GeneralName>,
}

fn name_fault(
  name: GeneralName,
  permitted: List<Subtree>,
  excluded: List<Subtree>,
) -> Option<Fault> / {abort.raise} = {
  let kind = name_kind(name);
  let open = permitted.filter(|t: Subtree| tree_kind(t) == kind);
  let shut = excluded.filter(|t: Subtree| tree_kind(t) == kind);
  if shut.any(|t: Subtree| containment(name, t, true) != Outside) { Some(Excluded(name)) }
  else if open.len() > 0 && !open.any(|t: Subtree| containment(name, t, false) == Inside) {
    Some(NotPermitted(name))
  } else { None }
}

fn in_path(path: List<Certificate>, c: Certificate) -> Bool =
  path.any(|p: Certificate|
    p.der == c.der || (p.info.subject.der == c.info.subject.der && p.info.spki == c.info.spki))

fn search_issuers(
  case: VerifyInput,
  path: List<Certificate>,
  hunt: PathSearch,
  certificates_left: Int,
) -> PathSearch / {abort.raise} =
  match path.at(path.len() - 1) {
    None -> hunt,
    Some(current) -> {
      let issued = |c: Certificate|
        c.info.subject.der == current.info.issuer.der && !in_path(path, c);
      let ways = case.anchors.filter(issued).map(|c: Certificate|
        { issuer: c, trusted: true }).concat(
        case.intermediates.filter(issued).map(|c: Certificate| { issuer: c, trusted: false }),
      );
      ways.fold(hunt, |h: PathSearch, way: { issuer: Certificate, trusted: Bool }|
        if h.path != None { h } else {
          match try_issuer(case, path, current, way.issuer, way.trusted, h) {
            Finished(after) -> after,
            Extended(after) -> {
              let longer = path.push(way.issuer);
              let between = longer.count(|c: Certificate| !is_self_issued(c)) - 1;
              if certificates_left <= 1 || between > case.policy.depth {
                record_failure(after, way.issuer, TooDeep, path.len())
              } else { search_issuers(case, longer, after, certificates_left - 1) }
            },
          }
        })
    },
  }

type Attempt = | Finished(PathSearch) | Extended(PathSearch)

fn try_issuer(
  case: VerifyInput,
  path: List<Certificate>,
  current: Certificate,
  issuer: Certificate,
  trusted: Bool,
  h: PathSearch,
) -> Attempt / {abort.raise} = {
  let depth = path.len();
  if h.checks >= case.policy.signatures {
    Finished(record_failure(h, current, Spent, h.furthest_depth + 1))
  } else {
    match issuer_fault(case, path, issuer) {
      Some(reason) -> Finished(record_failure(h, issuer, reason, depth)),
      None -> match verifier(issuer.info.key, current.info.algorithm, case.policy) {
        Err(reason) -> Finished(record_failure(h, current, reason, depth)),
        Ok(key) -> {
          let checked = { ..h, checks: h.checks + 1 };
          if !crypto::verify(key, current.tbs, current.signature) {
            Finished(record_failure(checked, current, Unissued, depth))
          } else if !trusted { Extended(checked) } else {
            let whole = path.push(issuer);
            match path_fault(case, whole) {
              None -> Finished({ ..checked, path: Some(whole) }),
              Some(failure) ->
                Finished(record_failure(checked, failure.certificate, failure.reason, depth + 1)),
            }
          }
        },
      },
    }
  }
}

/// Verifies a certificate path at time `at` and returns it from `leaf` to an anchor, or the failure
/// that explains why no path is valid.
///
/// A path is valid when every certificate is within its validity period and is signed by the next
/// one. Each issuer must be a CA whose path length allows the certificates below it. No certificate
/// may have a critical extension this module does not read, and every name must satisfy the name
/// constraints of every CA above it. Every CA's extended key usage must allow `purpose`, and the
/// leaf must be valid for `who` and `purpose`.
///
/// The search tries every candidate path, trusted anchors first, until one is valid or the limits
/// in `policy` are exhausted. If none is valid, the failure comes from the attempt that got deepest
/// into the path. A leaf that is itself an anchor is a valid path of one certificate. Nothing is
/// fetched and revocation is not checked.
pub fn verify(
  leaf: Certificate,
  offered: List<Certificate>,
  anchors: List<Certificate>,
  at: Instant,
  who: Identity,
  purpose: Purpose,
  policy: Policy,
) -> Result<List<Certificate>, Failure> / {abort.raise} = {
  let seconds = nanos_at(at) / 1000000000;
  let case = {
    intermediates: offered,
    anchors: anchors,
    seconds: seconds,
    purpose: purpose,
    policy: policy,
  };
  match leaf_fault(leaf, seconds, who, purpose, policy) {
    Some(reason) -> Err(failed(leaf, reason)),
    None -> if anchors.any(|a: Certificate| a.der == leaf.der) { Ok([leaf]) } else {
      let start = { path: None, checks: 0, failure: failed(leaf, Unissued), furthest_depth: 0 };
      let hunt = search_issuers(case, [leaf], start, offered.len() + 2);
      match hunt.path { Some(path) -> Ok(path), None -> Err(hunt.failure) }
    },
  }
}

/// What a certificate or request to be built states about its subject.
pub type Draft = new {
  /// The subject's name as a list of attributes, outermost first. Each attribute is one item of a
  /// relative distinguished name, which is one level of the name.
  subject: List<Attribute>,
  alt_names: List<GeneralName>,
  /// `Some` for a CA, containing its path length if it has one.
  ca: Option<Option<Int>>,
  usages: List<Usage>,
  purposes: List<Oid>,
  /// The subtrees a CA's name constraints permit, and those they exclude.
  permitted: List<Subtree>,
  excluded: List<Subtree>,
  /// Extensions added to the certificate unchanged, each with its type, criticality and value.
  extra: List<Extension>,
}

/// An empty draft: no name, no alternative names, no extensions.
pub fn draft() -> Draft =
  {
    subject: [],
    alt_names: [],
    ca: None,
    usages: [],
    purposes: [],
    permitted: [],
    excluded: [],
    extra: [],
  }

/// A certificate request, PKCS #10, that was read: the requester, their key, and the requested
/// extensions. One exists only when the request is signed by the key it carries.
pub opaque type Request = new {
  der: Bytes,
  subject: Name,
  key: Key,
  spki: Bytes,
  extensions: List<Extension>,
}

/// The request, in DER.
pub fn request_der(r: Request) -> Bytes = r.der

/// The requester.
pub fn request_subject(r: Request) -> Name = r.subject

/// The key to be certified.
pub fn request_key(r: Request) -> Key = r.key

/// The requested extensions.
pub fn request_extensions(r: Request) -> List<Extension> = r.extensions

effect set WriteEffects = {asn1.unwritable, abort.raise}

fn text_der(text: String) -> Bytes / {WriteEffects} =
  handle {
    asn1::string(asn1::PrintableString, text)
  } with {
    asn1.unwritable(_) -> asn1::string(asn1::Utf8String, text),
  }

fn name_der(attributes: List<Attribute>) -> Bytes / {WriteEffects} =
  asn1::sequence(
    attributes.map(|a: Attribute|
      asn1::set_of([asn1::sequence([asn1::oid(a.id), text_der(a.value)])])),
  )

fn general_name_der(name: GeneralName) -> Bytes / {WriteEffects} =
  match name {
    Email(text) -> asn1::implicit(asn1::context(1), asn1::string(Ia5String, text)),
    Dns(text) -> asn1::implicit(asn1::context(2), asn1::string(Ia5String, text)),
    Uri(text) -> asn1::implicit(asn1::context(6), asn1::string(Ia5String, text)),
    Address(address) -> asn1::primitive(asn1::context(7), ip::to_bytes(address)),
    Directory(found) -> asn1::explicit(asn1::context(4), found.der),
    Registered(id) -> asn1::implicit(asn1::context(8), asn1::oid(id)),
    Other(id, value) -> asn1::constructed(asn1::context(0), [asn1::oid(id), value]),
    UnsupportedName(_, catch_unwritable) -> catch_unwritable,
  }

fn extension_der(id: Oid, critical: Bool, value: Bytes) -> Bytes / {WriteEffects} =
  asn1::sequence(
    [asn1::oid(id)].concat(
      List::concat(if critical { [asn1::boolean(true)] } else { [] }, [asn1::octet_string(value)]),
    ),
  )

fn usage_bit(usage: Usage) -> Int =
  match usage {
    DigitalSignature -> 0,
    ContentCommitment -> 1,
    KeyEncipherment -> 2,
    DataEncipherment -> 3,
    KeyAgreement -> 4,
    KeyCertSign -> 5,
    CrlSign -> 6,
    EncipherOnly -> 7,
    DecipherOnly -> 8,
  }

fn draft_extensions(draft: Draft) -> List<Bytes> / {WriteEffects} =
  List::concat(
    match draft.ca {
      Some(length) ->
        [
          extension_der(
            oid::basic_constraints(),
            true,
            asn1::sequence(
              [asn1::boolean(true)].concat(match length {
                Some(most) -> [asn1::int(most)],
                None -> [],
              }),
            ),
          ),
        ],
      None -> [],
    },
    List::concat(
      if draft.usages.len() == 0 { [] } else {
        [extension_der(oid::key_usage(), true, asn1::named_bits(draft.usages.map(usage_bit)))]
      },
      List::concat(
        if draft.purposes.len() == 0 { [] } else {
          [
            extension_der(
              oid::extended_key_usage(),
              false,
              asn1::sequence(draft.purposes.map(|id: Oid| asn1::oid(id))),
            ),
          ]
        },
        List::concat(
          if draft.alt_names.len() == 0 { [] } else {
            [
              extension_der(
                oid::subject_alt_name(),
                draft.subject.len() == 0,
                asn1::sequence(draft.alt_names.map(general_name_der)),
              ),
            ]
          },
          constraints_der(draft.permitted, draft.excluded).concat(
            draft.extra.map(|e: Extension| extension_der(e.id, e.critical, e.value)),
          ),
        ),
      ),
    ),
  )

fn mask_bytes(bits: Int, octets: Int) -> Bytes =
  Bytes::concat_all(
    range(0, octets).map(|i: Int| {
      let ones = min(max(bits - 8 * i, 0), 8);
      byte_of_int(0xFF << 8 - ones & 0xFF)
    }),
  )

fn subtree_der(tree: Subtree) -> Bytes / {WriteEffects} =
  asn1::sequence([
    match tree {
      EmailTree(mailbox) -> asn1::implicit(asn1::context(1), asn1::string(Ia5String, mailbox)),
      DnsTree(name) -> asn1::implicit(asn1::context(2), asn1::string(Ia5String, name)),
      UriTree(host) -> asn1::implicit(asn1::context(6), asn1::string(Ia5String, host)),
      Network(net) -> {
        let address = ip::to_bytes(ip::network(net));
        asn1::primitive(asn1::context(7), address.concat(mask_bytes(ip::bits(net), address.len())))
      },
      DirectoryTree(name) -> asn1::explicit(asn1::context(4), name.der),
      OtherTree(_) -> asn1.unwritable(asn1::BadTag),
    },
  ])

fn constraints_der(
  permitted: List<Subtree>,
  excluded: List<Subtree>,
) -> List<Bytes> / {WriteEffects} = {
  let trees = |number: Int, list: List<Subtree>|
    if list.len() == 0 { [] }
    else { [asn1::implicit(asn1::context(number), asn1::sequence(list.map(subtree_der)))] };
  if permitted.len() + excluded.len() == 0 { [] } else {
    [
      extension_der(
        extension_oid(30),
        true,
        asn1::sequence(trees(0, permitted).concat(trees(1, excluded))),
      ),
    ]
  }
}

fn spki_der(key: VerifyingKey) -> Bytes / {WriteEffects} = {
  let public = crypto::verifying_bytes(key);
  let algorithm = match crypto::signature_algorithm(key) {
    crypto::Ed25519Signature -> [asn1::oid(oid::ed25519())],
    crypto::EcdsaSignature(curve, _, _) ->
      [asn1::oid(oid::ec_public_key()), asn1::oid(crypto::curve_oid(curve))],
    _ -> [asn1::oid(oid::rsa_encryption()), asn1::null()],
  };
  asn1::sequence([asn1::sequence(algorithm), asn1::bit_string({ unused: 0, bytes: public })])
}

fn signing_der(key: VerifyingKey) -> Bytes / {WriteEffects} =
  asn1::sequence(match crypto::signature_algorithm(key) {
    crypto::Ed25519Signature -> [asn1::oid(oid::ed25519())],
    crypto::EcdsaSignature(_, Sha256, _) -> [asn1::oid(oid::ecdsa_with_sha256())],
    crypto::EcdsaSignature(_, Sha384, _) -> [asn1::oid(oid::ecdsa_with_sha384())],
    crypto::EcdsaSignature(_, Sha512, _) -> [asn1::oid(oid::Oid([1, 2, 840, 10045, 4, 3, 4]))],
    crypto::RsaPkcs1Signature(Sha256) ->
      [asn1::oid(oid::sha256_with_rsa_encryption()), asn1::null()],
    crypto::RsaPkcs1Signature(Sha384) ->
      [asn1::oid(oid::sha384_with_rsa_encryption()), asn1::null()],
    crypto::RsaPkcs1Signature(Sha512) ->
      [asn1::oid(oid::sha512_with_rsa_encryption()), asn1::null()],
    crypto::RsaPssSignature(d) -> [asn1::oid(oid::rsassa_pss()), pss_parameters(d)],
  })

fn pss_parameters(d: Digest) -> Bytes / {WriteEffects} = {
  let hash = asn1::sequence([
    asn1::oid(match d {
      Sha256 -> oid::sha256(),
      Sha384 -> oid::sha384(),
      Sha512 -> oid::sha512(),
    }),
    asn1::null(),
  ]);
  asn1::sequence([
    asn1::explicit(asn1::context(0), hash),
    asn1::explicit(
      asn1::context(1),
      asn1::sequence([asn1::oid(oid::Oid([1, 2, 840, 113549, 1, 1, 8])), hash]),
    ),
    asn1::explicit(asn1::context(2), asn1::int(digest_length(d))),
  ])
}

fn signature_der(signer: crypto::SigningKey, message: Bytes) -> Bytes / {abort.raise} = {
  let fixture = crypto::sign(signer, message);
  match crypto::signature_algorithm(crypto::verifying_key(signer)) {
    crypto::EcdsaSignature(_, _, crypto::Raw) -> {
      let half = fixture.len() / 2;
      asn1::sequence([
        asn1::unsigned(fixture.slice(0, half)),
        asn1::unsigned(fixture.slice(half, 2 * half)),
      ])
    },
    _ -> fixture,
  }
}

fn signed_structure(body: Bytes, signer: crypto::SigningKey) -> Bytes / {WriteEffects} =
  asn1::sequence([
    body,
    signing_der(crypto::verifying_key(signer)),
    asn1::bit_string({ unused: 0, bytes: signature_der(signer, body) }),
  ])

fn key_id(spki: Bytes) -> Bytes / {abort.raise} = sha256(spki).slice(0, 20)

fn catch_unwritable<a>(
  body: () -> a / {asn1.unwritable, x509.fail, abort.raise},
) -> a / {x509.fail, abort.raise} =
  handle { body() } with { asn1.unwritable(_) -> x509.fail(Unwritable) }

/// Returns the certificate for `subject`'s key, described by `draft`, with the given `serial` and
/// validity from `not_before` to `not_after`. The certificate is signed with `signer`. If `issuer`
/// is `Some`, that certificate is the issuer. If `issuer` is `None`, the certificate is
/// self-signed.
///
/// The certificate is version 3. It has the draft's extensions and a subject key identifier. When
/// the issuer has a subject key identifier, it also has an authority key identifier.
/// `basicConstraints` and the key usage are critical, and the alternative names are critical when
/// the subject is empty.
///
/// Before returning, the function parses the encoded certificate again with `Strict`. If the draft
/// cannot make a valid certificate, it fails with the same error `read` would, such as a serial
/// that is zero or longer than twenty octets, or an invalid name. It also raises `Unwritable` for
/// text that no string type can encode and for an instant that no time type can write. It does not
/// check that `issuer` and `signer` belong to the same CA.
pub fn certificate(
  draft: Draft,
  subject: VerifyingKey,
  serial: Bytes,
  not_before: OffsetDateTime,
  not_after: OffsetDateTime,
  issuer: Option<Certificate>,
  signer: crypto::SigningKey,
) -> Certificate / {x509.fail, abort.raise} =
  catch_unwritable(|| {
    let name = name_der(draft.subject);
    let spki = spki_der(subject);
    let above = match issuer {
      Some(ca) ->
        ca.info.extensions.fold([], |found: List<Bytes>, e: Extension|
          match e.content {
            SubjectKeyId(id) ->
              [
                extension_der(
                  oid::authority_key_identifier(),
                  false,
                  asn1::sequence([asn1::implicit(asn1::context(0), asn1::octet_string(id))]),
                ),
              ],
            _ -> found,
          }),
      None -> [],
    };
    let extensions = draft_extensions(draft).concat(
      [
        extension_der(oid::subject_key_identifier(), false, asn1::octet_string(key_id(spki))),
      ].concat(
        above,
      ),
    );
    let body = asn1::sequence([
      asn1::explicit(asn1::context(0), asn1::int(2)),
      asn1::unsigned(serial),
      signing_der(crypto::verifying_key(signer)),
      match issuer { Some(ca) -> ca.info.subject.der, None -> name },
      asn1::sequence([asn1::time(not_before), asn1::time(not_after)]),
      name,
      spki,
      asn1::explicit(asn1::context(3), asn1::sequence(extensions)),
    ]);
    read(signed_structure(body, signer), limits(), Strict)
  })

/// `certificate` for the key that signs it: a root, or a certificate trusted by itself.
pub fn self_signed(
  draft: Draft,
  serial: Bytes,
  not_before: OffsetDateTime,
  not_after: OffsetDateTime,
  key: crypto::SigningKey,
) -> Certificate / {x509.fail, abort.raise} =
  certificate(draft, crypto::verifying_key(key), serial, not_before, not_after, None, key)

/// A certificate request for `draft`, signed by the key to be certified: PKCS #10, in DER, with the
/// draft's extensions as an extension request.
pub fn request(draft: Draft, key: crypto::SigningKey) -> Bytes / {x509.fail, abort.raise} =
  catch_unwritable(|| {
    let requested_extensions = draft_extensions(draft);
    let attributes = if requested_extensions.len() == 0 { [] } else {
      [
        asn1::sequence([
          asn1::oid(oid::Oid([1, 2, 840, 113549, 1, 9, 14])),
          asn1::set_of([asn1::sequence(requested_extensions)]),
        ]),
      ]
    };
    let body = asn1::sequence([
      asn1::int(0),
      name_der(draft.subject),
      spki_der(crypto::verifying_key(key)),
      asn1::implicit(asn1::context(0), asn1::set_of(attributes)),
    ]);
    signed_structure(body, key)
  })

fn request_at(r: Reader, data: Bytes, limits: Limits) -> ReadResult<Request> / {ReadEffects} =
  asn1::within(asn1::read_sequence(r), |fields: Reader| {
    let body = asn1::read_raw(fields);
    let info = asn1::within(asn1::read_sequence(fields), |i: Reader| {
      let version = asn1::read_int(i);
      let subject = name_at(version.rest, limits);
      let spki = asn1::read_raw(subject.rest);
      let key = key_at(subject.rest);
      let attributes = asn1::read_implicit(key.rest, asn1::context(0), |x: Reader|
        asn1::read_set_of(x, |a: Reader|
          asn1::within(asn1::read_sequence(a), |one: Reader| {
            let id = asn1::read_oid(one);
            if id.value != oid::Oid([1, 2, 840, 113549, 1, 9, 14]) {
              let values = asn1::read_raw(id.rest);
              { value: [], rest: values.rest }
            } else {
              let extension_lists = asn1::read_set_of(id.rest, |v: Reader|
                asn1::read_sequence_of(v, |e: Reader| extension_at(e, limits, Strict)));
              {
                value: extension_lists.value.flat_map(|list: List<Extension>| list),
                rest: extension_lists.rest,
              }
            }
          })));
      if version.value != 0 { x509.fail(BadVersion(version.value + 1)) } else {
        {
          value: {
            subject: subject.value,
            key: key.value,
            spki: spki.value,
            extensions: attributes.value.flat_map(|list: List<Extension>| list),
          },
          rest: attributes.rest,
        }
      }
    });
    let algorithm = algorithm_at(info.rest);
    let signature = asn1::read_bit_string(algorithm.rest);
    let proven = match verifier(info.value.key, algorithm.value, strict()) {
      Ok(key) ->
        signature.value.unused == 0 && crypto::verify(key, body.value, signature.value.bytes),
      Err(_) -> false,
    };
    if !proven { x509.fail(Unproven) } else {
      {
        value: {
          der: data,
          subject: info.value.subject,
          key: info.value.key,
          spki: info.value.spki,
          extensions: info.value.extensions,
        },
        rest: signature.rest,
      }
    }
  })

/// The request in `data`, in DER. Raises `Unproven` unless it is signed by the key it carries,
/// under an algorithm and a key that `strict` accepts.
pub fn read_request(data: Bytes, limits: Limits) -> Request / {x509.fail, abort.raise} =
  if data.len() > limits.bytes { x509.fail(TooLong(data.len())) } else {
    match asn1::decode_with(data, limits.depth, |r: Reader| request_at(r, data, limits)) {
      Ok(found) -> found,
      Err(e) -> x509.fail(NotDer(e)),
    }
  }

fn key_of(seed: Int) -> crypto::SigningKey / {abort.raise} =
  match crypto::ed25519_signing(
      Secret::of_bytes(Bytes::concat_all(range(0, 32).map(|i: Int| byte_of_int(seed + i & 0xFF)))),
    ) {
    Some(key) -> key,
    None -> panic("an Ed25519 signing key can be made from any 32 bytes, so this cannot fail"),
  }

fn day(n: Int) -> OffsetDateTime =
  match date::of_unix_seconds(n * 86400) { Some(t) -> t, None -> date::of_instant(Instant(0)) }

fn at_day(n: Int) -> Instant = Instant(n * 86400000000000)

fn named_subject(name: String) -> List<Attribute> = [{ id: oid::common_name(), value: name }]

fn ca_draft(name: String, length: Option<Int>) -> Draft =
  { ..draft(), subject: named_subject(name), ca: Some(length), usages: [KeyCertSign, CrlSign] }

fn leaf_draft(host: String) -> Draft =
  {
    ..draft(),
    subject: named_subject(host),
    alt_names: [Dns(host)],
    usages: [DigitalSignature],
    purposes: [server_auth()],
  }

fn issued(
  d: Draft,
  key: Int,
  issuer: Option<Certificate>,
  signer: Int,
) -> Certificate / {x509.fail, abort.raise} =
  certificate(
    d,
    crypto::verifying_key(key_of(key)),
    byte_of_int(key),
    day(100),
    day(900),
    issuer,
    key_of(signer),
  )

type Pki = { root: Certificate, middle: Certificate, leaf: Certificate }

fn pki() -> Pki / {x509.fail, abort.raise} = {
  let root = issued(ca_draft("Root", None), 1, None, 1);
  let middle = issued(ca_draft("Middle", Some(0)), 2, Some(root), 1);
  let leaf = certificate(
    leaf_draft("www.example.com"),
    crypto::verifying_key(key_of(3)),
    b"\x03",
    day(300),
    day(400),
    Some(middle),
    key_of(2),
  );
  { root: root, middle: middle, leaf: leaf }
}

fn checked(
  leaf: Certificate,
  offered: List<Certificate>,
  anchors: List<Certificate>,
  on: Int,
  host: String,
) -> Result<Int, Fault> / {abort.raise} =
  match verify(leaf, offered, anchors, at_day(on), Host(host), ServerAuth, strict()) {
    Ok(path) -> Ok(path.len()),
    Err(failure) -> Err(failure.reason),
  }

fn fixture<a>(body: () -> a / {x509.fail, abort.raise}) -> a / {abort.raise} =
  match try { body() } { Ok(x) -> x, Err(rejection) -> panic("the fixture is rejected") }

fn attribute(arcs: List<Int>, value: String) -> Attribute = { id: oid::Oid(arcs), value: value }

test "`name_text` writes a name as RFC 4514 does, with the last component first and the required escapes" {
  let n: Name = {
    rdns: [
      [attribute([2, 5, 4, 6], "US")],
      [attribute([2, 5, 4, 10], "Example, Inc.")],
      [attribute([2, 5, 4, 11], "Sales"), attribute([2, 5, 4, 3], " Jo+Ann ")],
      [attribute([1, 2, 3, 4], "#04024869")],
      [attribute([0, 9, 2342, 19200300, 100, 1, 25], "#example;<x>")],
    ],
    der: b"",
  };
  assert_eq(
    name_text(n),
    "DC=\\#example\\;\\<x\\>,1.2.3.4=#04024869,OU=Sales+CN=\\ Jo\\+Ann\\ ,O=Example\\, Inc.,C=US",
  );
  assert_eq(values_of(n, common_name()), [" Jo+Ann "])
}

test "a built chain verifies to its root, and the path is the leaf, the CA and the root" {
  let p = fixture(pki);
  assert_eq(
    verify(
      p.leaf,
      [p.middle],
      [p.root],
      at_day(350),
      Host("www.example.com"),
      ServerAuth,
      strict(),
    ).ok(
    ),
    Some([p.leaf, p.middle, p.root]),
  );
  assert_eq(checked(p.leaf, [p.middle, p.root, p.leaf], [p.root], 350, "WWW.Example.COM."), Ok(3));
  assert_eq(
    try { read_pem(write_pem([p.leaf, p.middle]), limits(), Strict) },
    Ok([p.leaf, p.middle]),
  );
  assert_eq(write_pem([]), "");
  assert_eq(info(p.leaf).version, 3);
  assert_eq(info(p.leaf).serial, b"\x03");
  assert_eq(info(p.leaf).issuer, info(p.middle).subject);
  assert_eq(alt_names(p.leaf), [Dns("www.example.com")]);
  assert_eq(fingerprint(p.leaf).len(), 32);
  assert_eq(key_pin(p.middle), sha256(info(p.middle).spki));
  assert(is_ca(p.root) && is_self_issued(p.root) && !is_ca(p.leaf))
}

test "`verify` fails a chain that is expired, not yet valid, issued for another host name, missing its CA, or used for another purpose" {
  let p = fixture(pki);
  let record_failure = |on: Int, host: String, offered: List<Certificate>|
    match verify(p.leaf, offered, [p.root], at_day(on), Host(host), ServerAuth, strict()) {
      Ok(_) -> None,
      Err(failure) -> Some({ leaf: failure.certificate == p.leaf, reason: failure.reason }),
    };
  assert_eq(
    record_failure(401, "www.example.com", [p.middle]),
    Some({ leaf: true, reason: Expired }),
  );
  assert_eq(
    record_failure(299, "www.example.com", [p.middle]),
    Some({ leaf: true, reason: NotYetValid }),
  );
  assert_eq(
    record_failure(350, "example.com", [p.middle]),
    Some({ leaf: true, reason: NameMismatch }),
  );
  assert_eq(
    record_failure(350, "www.example.org", [p.middle]),
    Some({ leaf: true, reason: NameMismatch }),
  );
  assert_eq(record_failure(350, "www.example.com", []), Some({ leaf: true, reason: Unissued }));
  assert_eq(
    verify(
      p.leaf,
      [p.middle],
      [p.root],
      at_day(350),
      Host("www.example.com"),
      ClientAuth,
      strict(),
    ).err(
    ),
    Some({ certificate: p.leaf, reason: WrongPurpose }),
  );
  assert_eq(checked(p.leaf, [p.middle], [], 350, "www.example.com"), Err(Unissued));
  assert_eq(checked(p.leaf, [p.middle], [p.middle], 350, "www.example.com"), Ok(2))
}

test "a CA certificate outside its validity period is reported as the failing certificate, and `verify` can still succeed through another chain" {
  let p = fixture(pki);
  let lapsed = fixture(||
    certificate(
      ca_draft("Middle", Some(0)),
      crypto::verifying_key(key_of(2)),
      b"\x09",
      day(100),
      day(320),
      Some(p.root),
      key_of(1),
    ));
  assert_eq(
    verify(
      p.leaf,
      [lapsed],
      [p.root],
      at_day(350),
      Host("www.example.com"),
      ServerAuth,
      strict(),
    ).err(
    ),
    Some({ certificate: lapsed, reason: Expired }),
  );
  assert_eq(checked(p.leaf, [lapsed, p.middle], [p.root], 350, "www.example.com"), Ok(3));
  assert_eq(checked(p.leaf, [p.middle, lapsed], [p.root], 350, "www.example.com"), Ok(3))
}

test "`verify` fails a chain whose issuer is a leaf certificate and a chain that exceeds a CA's path length limit" {
  let p = fixture(pki);
  let forged = fixture(|| issued(leaf_draft("bank.example"), 4, Some(p.leaf), 3));
  assert_eq(
    verify(
      forged,
      [p.leaf, p.middle],
      [p.root],
      at_day(350),
      Host("bank.example"),
      ServerAuth,
      strict(),
    ).err(
    ),
    Some({ certificate: p.leaf, reason: NotACa }),
  );
  let lower = fixture(|| issued(ca_draft("Lower", None), 5, Some(p.middle), 2));
  let below = fixture(|| issued(leaf_draft("deep.example"), 6, Some(lower), 5));
  assert_eq(
    verify(
      below,
      [lower, p.middle],
      [p.root],
      at_day(350),
      Host("deep.example"),
      ServerAuth,
      strict(),
    ).err(
    ),
    Some({ certificate: p.middle, reason: PathLength }),
  );
  assert_eq(checked(p.root, [], [p.root], 350, "www.example.com"), Err(LeafIsCa))
}

test "a trusted self-signed certificate verifies as a chain of one, and an untrusted self-signed certificate has no chain and fails" {
  let alone = fixture(|| issued(leaf_draft("localhost"), 7, None, 7));
  assert_eq(checked(alone, [], [alone], 350, "localhost"), Ok(1));
  assert_eq(checked(alone, [], [alone], 350, "example.com"), Err(NameMismatch));
  assert_eq(checked(alone, [], [], 350, "localhost"), Err(Unissued));
  assert_eq(checked(alone, [], [alone], 901, "localhost"), Err(Expired))
}

type NameMatchCase = { presented: GeneralName, host: String, matches: Bool }

fn name_match_cases() -> List<NameMatchCase> =
  [
    { presented: Dns("example.com"), host: "example.com", matches: true },
    { presented: Dns("EXAMPLE.com"), host: "example.COM", matches: true },
    { presented: Dns("example.com"), host: "example.com.", matches: true },
    { presented: Dns("example.com"), host: "www.example.com", matches: false },
    { presented: Dns("*.example.com"), host: "www.example.com", matches: true },
    { presented: Dns("*.example.com"), host: "example.com", matches: false },
    { presented: Dns("*.example.com"), host: "a.b.example.com", matches: false },
    { presented: Dns("w*.example.com"), host: "www.example.com", matches: false },
    { presented: Dns("www.*.com"), host: "www.example.com", matches: false },
    { presented: Dns("*.com"), host: "example.com", matches: false },
    { presented: Dns("*"), host: "example", matches: false },
    { presented: Dns("under_score.example.com"), host: "under_score.example.com", matches: false },
    { presented: Dns("192.0.2.1"), host: "192.0.2.1", matches: false },
    { presented: Dns("xn--mnchen-3ya.de"), host: "münchen.de", matches: true },
    { presented: Dns("xn--mnchen-3ya.de"), host: "XN--MNCHEN-3YA.de", matches: true },
    { presented: Dns("*.xn--mnchen-3ya.de"), host: "www.münchen.de", matches: true },
    { presented: Dns("muenchen.de"), host: "münchen.de", matches: false },
    { presented: Email("www@example.com"), host: "example.com", matches: false },
    { presented: Uri("https://example.com/"), host: "example.com", matches: false },
  ]

test "`matches_identity` for a certificate with alternative name {show(c.presented)} and host {c.host} returns {c.matches}" for c: NameMatchCase in name_match_cases(
  ) {
  let leaf = fixture(|| issued({ ..leaf_draft("any"), alt_names: [c.presented] }, 8, None, 8));
  assert_eq(matches_identity(leaf, Host(c.host)), c.matches)
}

test "an IP address matches only an IP address alternative name, never a DNS-style host name, and a common name never matches a host" {
  let four = ip_of("192.0.2.1");
  let six = ip_of("2001:db8::1");
  let leaf = fixture(||
    issued(
      { ..leaf_draft("192.0.2.9"), alt_names: [Address(four), Address(six), Dns("a.example")] },
      8,
      None,
      8,
    ));
  assert(
    matches_identity(leaf, IpAddress(four)) && matches_identity(leaf, IpAddress(six))
      && matches_identity(leaf, Anyone),
  );
  assert(!matches_identity(leaf, IpAddress(ip_of("192.0.2.2"))));
  assert(!matches_identity(leaf, Host("192.0.2.1")) && !matches_identity(leaf, Host("192.0.2.9")));
  let bare = fixture(|| issued({ ..leaf_draft("cn.example"), alt_names: [] }, 8, None, 8));
  assert(!matches_identity(bare, Host("cn.example")) && matches_identity(bare, Anyone))
}

type ConstraintCase = {
  name: String,
  permitted: List<Subtree>,
  excluded: List<Subtree>,
  presented: GeneralName,
  fault: Option<Fault>,
}

fn ip_of(text: String) -> Ip / {abort.raise} =
  match ip::parse(text) { Ok(a) -> a, Err(_) -> panic("an address") }

fn net(text: String, bits: Int) -> Subtree / {abort.raise} =
  match ip::prefix_containing(ip_of(text), bits) {
    Some(p) -> Network(p),
    None -> panic("a prefix"),
  }

fn address(text: String) -> GeneralName / {abort.raise} = Address(ip_of(text))

fn constraint_cases() -> List<ConstraintCase> / {abort.raise} = {
  let on = |name: String, permitted: List<Subtree>, excluded: List<Subtree>, presented: GeneralName, fault: Option<Fault>|
    { name: name, permitted: permitted, excluded: excluded, presented: presented, fault: fault };
  let host = Dns("www.example.com");
  [
    on("a name under a permitted one", [DnsTree("example.com")], [], host, None),
    on("the permitted name itself", [DnsTree("www.example.com")], [], host, None),
    on("every name, under the empty one", [DnsTree("")], [], host, None),
    on(
      "a name beside a permitted one",
      [DnsTree("example.org")],
      [],
      host,
      Some(NotPermitted(host)),
    ),
    on(
      "a name that only ends like one",
      [DnsTree("ample.com")],
      [],
      host,
      Some(NotPermitted(host)),
    ),
    on("a name under an excluded one", [], [DnsTree("example.com")], host, Some(Excluded(host))),
    on("a name beside an excluded one", [], [DnsTree("example.org")], host, None),
    on(
      "a name both permitted and excluded",
      [DnsTree("example.com")],
      [DnsTree("www.example.com")],
      host,
      Some(Excluded(host)),
    ),
    on(
      "a constraint with a leading dot",
      [DnsTree(".example.com")],
      [],
      host,
      Some(NotPermitted(host)),
    ),
    on(
      "an excluded constraint that is no name",
      [],
      [DnsTree("*.example.org")],
      host,
      Some(Excluded(host)),
    ),
    on(
      "a wildcard under a permitted name",
      [DnsTree("example.com")],
      [],
      Dns("*.example.com"),
      None,
    ),
    on(
      "a wildcard over an excluded name",
      [],
      [DnsTree("www.example.com")],
      Dns("*.example.com"),
      Some(Excluded(Dns("*.example.com"))),
    ),
    on(
      "a name of a kind not constrained",
      [EmailTree("example.org")],
      [net("10.0.0.0", 8)],
      host,
      None,
    ),
    on(
      "an address in a permitted network",
      [net("192.0.2.0", 24)],
      [],
      address("192.0.2.77"),
      None,
    ),
    on(
      "an address outside it",
      [net("192.0.2.0", 24)],
      [],
      address("192.0.3.1"),
      Some(NotPermitted(address("192.0.3.1"))),
    ),
    on(
      "an address of the other family",
      [net("192.0.2.0", 24)],
      [],
      address("2001:db8::1"),
      Some(NotPermitted(address("2001:db8::1"))),
    ),
    on(
      "an address in an excluded network",
      [],
      [net("2001:db8::", 32)],
      address("2001:db8::1"),
      Some(Excluded(address("2001:db8::1"))),
    ),
    on(
      "a mailbox that is the permitted one",
      [EmailTree("a@example.com")],
      [],
      Email("a@example.com"),
      None,
    ),
    on(
      "another mailbox of its host",
      [EmailTree("a@example.com")],
      [],
      Email("b@example.com"),
      Some(NotPermitted(Email("b@example.com"))),
    ),
    on(
      "a mailbox of a permitted host",
      [EmailTree("example.com")],
      [],
      Email("b@EXAMPLE.com"),
      None,
    ),
    on(
      "a mailbox of a host under it",
      [EmailTree("example.com")],
      [],
      Email("b@mail.example.com"),
      Some(NotPermitted(Email("b@mail.example.com"))),
    ),
    on(
      "a mailbox of a host under a domain",
      [EmailTree(".example.com")],
      [],
      Email("b@mail.example.com"),
      None,
    ),
    on(
      "a mailbox of the domain's own host",
      [EmailTree(".example.com")],
      [],
      Email("b@example.com"),
      Some(NotPermitted(Email("b@example.com"))),
    ),
    on(
      "a URI of a permitted host",
      [UriTree("example.com")],
      [],
      Uri("https://user@example.com:8443/a?b"),
      None,
    ),
    on(
      "a URI of a host under it",
      [UriTree("example.com")],
      [],
      Uri("https://www.example.com/"),
      Some(NotPermitted(Uri("https://www.example.com/"))),
    ),
    on(
      "a URI with no host",
      [UriTree("example.com")],
      [],
      Uri("urn:example"),
      Some(NotPermitted(Uri("urn:example"))),
    ),
    on(
      "a URI of an address, excluded for not being compared",
      [],
      [UriTree("example.com")],
      Uri("https://192.0.2.1/"),
      Some(Excluded(Uri("https://192.0.2.1/"))),
    ),
  ]
}

test "`verify` of a certificate with {c.name} under a CA's name constraints returns the fault {show(c.fault)}" for c: ConstraintCase in constraint_cases(
  ) {
  let root = fixture(||
    issued({ ..ca_draft("Root", None), permitted: c.permitted, excluded: c.excluded }, 1, None, 1));
  let leaf = fixture(||
    issued({ ..leaf_draft("leaf"), subject: [], alt_names: [c.presented] }, 3, Some(root), 1));
  assert_eq(
    verify(leaf, [], [root], at_day(350), Anyone, ServerAuth, strict()).err(),
    match c.fault { Some(reason) -> Some({ certificate: leaf, reason: reason }), None -> None },
  )
}

fn organization() -> List<Attribute> = [{ id: oid::organization_name(), value: "Example" }]

fn org(name: String) -> List<Attribute> =
  organization().push({ id: oid::common_name(), value: name })

test "a CA's name constraints apply to every certificate below it, checking both alternative names and the subject" {
  let tree = DirectoryTree(
    info(fixture(|| issued({ ..leaf_draft("x"), subject: organization() }, 9, None, 9))).subject,
  );
  let root = fixture(||
    issued({ ..ca_draft("Root", None), permitted: [DnsTree("example.com"), tree] }, 1, None, 1));
  let middle = fixture(||
    issued({ ..ca_draft("Middle", None), subject: org("Middle") }, 2, Some(root), 1));
  let leaf = |host: String, subject: List<Attribute>|
    fixture(|| issued({ ..leaf_draft(host), subject: subject }, 3, Some(middle), 2));
  let fault = |c: Certificate|
    match verify(c, [middle], [root], at_day(350), Anyone, ServerAuth, strict()) {
      Ok(_) -> None,
      Err(failure) -> Some(failure.reason),
    };
  assert_eq(fault(leaf("www.example.com", org("www"))), None);
  assert_eq(fault(leaf("www.example.org", org("www"))), Some(NotPermitted(Dns("www.example.org"))));
  assert(fault(leaf("www.example.com", named_subject("www"))) != None);
  let outside = fixture(|| issued(ca_draft("Middle", None), 2, Some(root), 1));
  assert(
    verify(
        leaf("www.example.com", org("www")),
        [outside],
        [root],
        at_day(350),
        Anyone,
        ServerAuth,
        strict(),
      ).err(
      )
      != None,
  )
}

test "`verify` rejects a chain with a critical extension it does not understand, but accepts one with that extension on a certificate outside the chain" {
  let odd: Extension = {
    id: oid::Oid([1, 3, 6, 1, 4, 1, 99999, 1]),
    critical: true,
    value: b"\x05\x00",
    content: Unparsed,
  };
  let p = fixture(pki);
  let marked = fixture(||
    issued({ ..leaf_draft("www.example.com"), extra: [odd] }, 3, Some(p.middle), 2));
  assert_eq(
    checked(marked, [p.middle], [p.root], 350, "www.example.com"),
    Err(UnknownCritical(odd.id)),
  );
  let quiet = fixture(||
    issued(
      { ..leaf_draft("www.example.com"), extra: [{ ..odd, critical: false }] },
      3,
      Some(p.middle),
      2,
    ));
  assert_eq(checked(quiet, [p.middle], [p.root], 350, "www.example.com"), Ok(3));
  let stray = fixture(|| issued({ ..ca_draft("Stray", None), extra: [odd] }, 5, Some(p.root), 1));
  assert_eq(checked(p.leaf, [stray, p.middle], [p.root], 350, "www.example.com"), Ok(3));
  let above = fixture(||
    issued({ ..ca_draft("Middle", Some(0)), extra: [odd] }, 2, Some(p.root), 1));
  assert_eq(
    verify(
      p.leaf,
      [above],
      [p.root],
      at_day(350),
      Host("www.example.com"),
      ServerAuth,
      strict(),
    ).err(
    ),
    Some({ certificate: above, reason: UnknownCritical(odd.id) }),
  )
}

test "a certificate breaking RFC 5280 is rejected, and so is a request its key did not sign" {
  let p = fixture(pki);
  let whole = der(p.leaf);
  assert_eq(parse(whole, limits(), Strict), Ok(p.leaf));
  assert_eq(parse(whole, limits(), Tolerant), Ok(p.leaf));
  assert_eq(
    parse(whole, { ..limits(), bytes: whole.len() - 1 }, Strict),
    Err(TooLong(whole.len())),
  );
  assert_eq(parse(whole, { ..limits(), extensions: 3 }, Strict).ok(), None);
  assert_eq(parse(whole.concat(b"\x00"), limits(), Strict).ok(), None);
  assert_eq(parse(whole.slice(0, whole.len() - 1), limits(), Strict).ok(), None);
  assert_eq(parse(b"", limits(), Strict).ok(), None);
  let zero = try {
    certificate(
      leaf_draft("a.example"),
      crypto::verifying_key(key_of(3)),
      b"\x00",
      day(1),
      day(2),
      None,
      key_of(3),
    )
  };
  assert_eq(zero.err(), Some(BadSerial));
  let long = try {
    certificate(
      leaf_draft("a.example"),
      crypto::verifying_key(key_of(3)),
      Bytes::concat_all(range(0, 21).map(|_: Int| b"\x01")),
      day(1),
      day(2),
      None,
      key_of(3),
    )
  };
  assert_eq(long.err(), Some(BadSerial));
  let request_bytes = fixture(||
    request(
      {
        ..leaf_draft("www.example.com"),
        subject: [{ id: oid::organization_name(), value: "Exämple" }],
      },
      key_of(3),
    ));
  let read_back = fixture(|| read_request(request_bytes, limits()));
  assert_eq(request_der(read_back), request_bytes);
  assert_eq(request_key(read_back), info(p.leaf).key);
  assert_eq(
    request_subject(read_back).rdns.map(|rdn: List<Attribute>| rdn.map(|a: Attribute| a.value)),
    [["Exämple"]],
  );
  assert_eq(request_extensions(read_back).map(|e: Extension| e.content), [
    KeyUsage([DigitalSignature]),
    ExtendedKeyUsage([server_auth()]),
    SubjectAltName([Dns("www.example.com")]),
  ]);
  let n = request_bytes.len();
  let forged = Bytes::concat_all([
    request_bytes.slice(0, n - 1),
    byte_of_int(request_bytes.at(n - 1) ^ 1),
  ]);
  assert_eq(Result::err(try { read_request(forged, limits()) }), Some(Unproven))
}

fn unused_intermediates(k: Int, root: Certificate) -> List<Certificate> / {abort.raise} =
  range(0, k).map(|i: Int| fixture(|| issued(ca_draft("Middle", None), 40 + i, Some(root), 1)))

test "`verify` checks no more signatures than its policy allows, and fails with `Spent` when the limit is reached" {
  let p = fixture(pki);
  let crowd = unused_intermediates(12, p.root);
  let spent = |most: Int|
    verify(p.leaf, crowd, [p.root], at_day(350), Host("www.example.com"), ServerAuth, {
      ..strict(),
      signatures: most,
    }).err(
    );
  assert_eq(spent(5), Some({ certificate: p.leaf, reason: Spent }));
  assert_eq(spent(100), Some({ certificate: p.leaf, reason: Unissued }));
  assert_eq(checked(p.leaf, crowd.push(p.middle), [p.root], 350, "www.example.com"), Ok(3))
}

test "the search for a certificate chain checks no more signatures than the policy allows, however many certificates are offered" {
  gen::check2(gen::any_int(), gen::any_int(), |decoy: Int, budget: Int| {
    let p = fixture(pki);
    let most = (budget & 15) + 1;
    let case = {
      intermediates: unused_intermediates(decoy & 7, p.root).push(p.middle),
      anchors: [p.root],
      seconds: 350 * 86400,
      purpose: ServerAuth,
      policy: { ..strict(), signatures: most },
    };
    let start = { path: None, checks: 0, failure: failed(p.leaf, Unissued), furthest_depth: 0 };
    search_issuers(case, [p.leaf], start, 12).checks <= most
  })
}

test "a chain verifies at exactly the times every certificate in it is valid" {
  gen::check(gen::any_int(), |t: Int| {
    let p = fixture(pki);
    let on = (t % 1000 + 1000) % 1000;
    checked(p.leaf, [p.middle], [p.root], on, "www.example.com") == Ok(3)
      == (on >= 300 && on <= 400)
  })
}

test "a certificate with one byte changed either fails to parse or fails to verify" {
  gen::check2(gen::any_int(), gen::any_int(), |at: Int, to: Int| {
    let p = fixture(pki);
    let whole = der(p.leaf);
    let i = (at % whole.len() + whole.len()) % whole.len();
    let altered = Bytes::concat_all([
      whole.slice(0, i),
      byte_of_int(to & 0xFF),
      whole.slice(i + 1, whole.len()),
    ]);
    altered == whole
      || (match parse(altered, limits(), Tolerant) {
        Err(_) -> true,
        Ok(c) ->
          verify(c, [p.middle], [p.root], at_day(350), Anyone, ServerAuth, strict()).ok() == None,
      })
  })
}

test "bytes are read as a certificate or rejected, and never abort" {
  gen::check(gen::bytes(), |data: Bytes| {
    let p = fixture(pki);
    [data, data.concat(der(p.leaf)), der(p.leaf).slice(0, 40).concat(data)].all(
      |candidate: Bytes|
        match parse(candidate, limits(), Tolerant) { Ok(_) -> true, Err(_) -> true },
    )
  })
}

test "a built certificate and a built request read back as what was built" {
  gen::check3(
    gen::any_int(),
    gen::list(gen::bool()),
    gen::bool(),
    |seed: Int, hosts: List<Bool>, ca: Bool| {
      let matches_identity = range(0, hosts.len() & 3).map(|i: Int|
        Dns("h" ++ i.to_string() ++ ".example.com"));
      let d = if ca { ca_draft("CA " ++ Int::to_string(seed & 7), Some(seed & 3)) } else {
        {
          ..leaf_draft("leaf.example.com"),
          alt_names: matches_identity.push(Dns("leaf.example.com")),
        }
      };
      let key = key_of(seed & 0xFF);
      let built = fixture(|| self_signed(d, b"\x05", day(1), day(2), key));
      let parsed_request = fixture(|| read_request(request(d, key), limits()));
      parse(der(built), limits(), Strict) == Ok(built) && alt_names(built) == d.alt_names
        && is_ca(built) == ca
        && request_subject(parsed_request) == info(built).subject
        && request_key(parsed_request) == info(built).key
    },
  )
}
