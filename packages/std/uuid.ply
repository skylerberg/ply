//! A 128-bit identifier (UUID) with its canonical text, the information its bits record about how
//! it was made, and the RFC 9562 versions a program can create itself.
//!
//! A `Uuid` is sixteen octets, and only this module builds one, so every `Uuid` has exactly
//! sixteen. Two identifiers compare by their octets, and the first octet that differs decides.
//! Their canonical texts sort in the same order, and so does a `Map` of them. Parsing and rendering
//! never raise: a string that is not in canonical form parses to `None`. To get a shorter text,
//! pass the `octets` to `std.radix` with any alphabet.
//!
//! Version 4 is random and carries no information. Version 5 is computed from a namespace and a
//! name, so two programs create the same identifier for the same name without communicating.
//! Version 7 starts with the millisecond in which it was made, so identifiers sort in the order
//! they were made, which suits a database key. Anyone who sees a version 7 identifier can also read
//! when it was made. `uuid_v4` and `uuid_v7` draw random numbers from the `entropy` effect of
//! `std.random`, and `uuid_v7` reads the clock of `std.time`. A test makes them repeatable by
//! handling those effects with fixed values. `uuid_v7_at` makes the same identifier from a time and
//! random numbers passed as arguments.
//!
//! Two version 7 identifiers made in the same millisecond have no defined order, and after the
//! clock is set back, new identifiers sort before ones made earlier. `uuid_v7_after(previous)`
//! returns an identifier that sorts after `previous`, whatever the clock did in between. It puts a
//! counter in the twelve bits after the version. In a new millisecond the counter starts at a
//! random number. In the same millisecond as `previous`, or an earlier one, the counter is
//! `previous`'s counter plus one. When the counter overflows, the identifier moves to the next
//! millisecond. RFC 9562 §6.2 also allows those twelve bits to hold a finer time fraction, but the
//! clock reads whole milliseconds, so there is nothing finer to store. The sixty-two bits after the
//! variant stay random in every identifier, so an identifier cannot be guessed from the one before
//! it. The caller stores the last identifier made and passes it as `previous` next time.

import std.bytes
import std.bytes (u16_be, u64_be)
import std.gen
import std.gen (Gen)
import std.hash.legacy (sha1)
import std.laws (round_trip)
import std.list
import std.option
import std.random (entropy)
import std.string
import std.time (at_millis, nanos_at, time)

/// A 128-bit identifier as its sixteen octets, which two identifiers compare by.
pub opaque type Uuid = new { octets: Bytes }

/// Which layout an identifier's bits follow, read from the leading bits of its ninth octet
/// (RFC 9562 §4.1).
pub type UuidVariant =
  /// `0xxx`: Apollo NCS's layout, reserved for identifiers older than the RFCs. The nil identifier
  /// has this variant.
  | Ncs
  /// `10xx`: the layout RFC 9562 defines, as RFC 4122 did. Only this variant has a version.
  | Rfc
  /// `110x`: Microsoft's layout, reserved for old GUIDs.
  | Microsoft
  /// `111x`: reserved for a future layout. The max identifier has this variant.
  | Future

/// The `Uuid` of these octets, or `None` unless there are exactly sixteen.
pub fn uuid_of_octets(octets: Bytes) -> Option<Uuid> =
  if octets.len() == 16 { Some({ octets: octets }) } else { None }

/// Generates every kind of identifier: the nil and max ones, and sixteen octets with each of the
/// sixteen versions and each of the four variants. The RFC's variant is the most common, since
/// only it has versions.
pub fn uuid_gen() -> Gen<Uuid> =
  gen::and_then(gen::below(16), |pick: Int|
    if pick == 0 { gen::constant(uuid_nil()) }
    else if pick == 1 { gen::constant(uuid_max()) } else {
      gen::map2(gen::bytes_of(16), gen::below(16), |raw: Bytes, version: Int|
        with_version_and_variant(raw, version, variant_picked(pick)))
    })

fn variant_picked(pick: Int) -> UuidVariant =
  if pick == 2 { Ncs } else if pick == 3 { Microsoft } else if pick == 4 { Future } else { Rfc }

/// Sixteen zero octets: the identifier that means none, and sorts before every other
/// (RFC 9562 §5.9).
pub fn uuid_nil() -> Uuid =
  { octets: b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00" }

/// Sixteen `0xFF` octets: the identifier that sorts after every other (RFC 9562 §5.10).
pub fn uuid_max() -> Uuid =
  { octets: b"\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff" }

/// The canonical form: lowercase hex, 8-4-4-4-12, as RFC 9562 §4 writes it.
pub fn uuid_render(u: Uuid) -> String / {abort.raise} = {
  let h = u.octets.hex_of();
  h.slice(0, 8) ++ "-" ++ h.slice(8, 12) ++ "-" ++ h.slice(12, 16) ++ "-" ++ h.slice(16, 20) ++ "-"
    ++ h.slice(20, 32)
}

/// Parses canonical text, or returns `None`. Upper case is accepted, because RFC 9562 says a
/// reader must accept it, and `uuid_render` always writes lower case.
pub fn uuid_parse(text: String) -> Option<Uuid> / {abort.raise} =
  if text.len() != 36 { None }
  else if text.slice(8, 9) != "-" || text.slice(13, 14) != "-" || text.slice(18, 19) != "-"
      || text.slice(23, 24) != "-" { None } else {
    let h = String::ascii_lower(
      text.slice(0, 8) ++ text.slice(9, 13) ++ text.slice(14, 18) ++ text.slice(19, 23)
        ++ text.slice(24, 36),
    );
    if is_hex(h) { Some({ octets: Bytes::of_hex(h) }) } else { None }
  }

/// Checks a `uuid"..."` literal. Returns the `Uuid` the canonical text represents, or an error at
/// the first character that makes the text not canonical.
pub fn literal(text: String) -> Result<Uuid, { message: String, offset: Int }> / {abort.raise} =
  match uuid_parse(text) {
    Some(u) -> Ok(u),
    None -> {
      let n = text.len();
      let stray = range(0, min(n, 36)).fold(None, |found: Option<Int>, i: Int|
        if found != None || is_canonical_at(text, i) { found } else { Some(i) });
      Err(match stray {
        Some(i) ->
          { message: if hyphen_at(i) { "a `-` goes here" } else { "not a hex digit" }, offset: i },
        None -> { message: "a UUID is 36 characters, written 8-4-4-4-12", offset: min(n, 36) },
      })
    },
  }

fn hyphen_at(i: Int) -> Bool = i == 8 || i == 13 || i == 18 || i == 23

fn is_canonical_at(text: String, i: Int) -> Bool / {abort.raise} = {
  let c = text.slice(i, i + 1);
  if hyphen_at(i) { c == "-" } else { is_hex(c.ascii_lower()) }
}

fn is_hex(text: String) -> Bool =
  range(0, text.len()).fold(true, |ok: Bool, i: Int|
    ok && hex_digits().contains(text.slice(i, i + 1)))

fn hex_digits() -> String = "0123456789abcdef"

/// The layout `u`'s bits follow.
pub fn uuid_variant(u: Uuid) -> UuidVariant / {abort.raise} = {
  let lead = u.octets.at(8);
  if lead < 0x80 { Ncs }
  else if lead < 0xC0 { Rfc }
  else if lead < 0xE0 { Microsoft }
  else { Future }
}

/// The version of `u`: the first four bits of its seventh octet, which RFC 9562 defines from 1 to
/// 8. `None` for any variant but the RFC's, where those bits mean something else, so the nil and
/// max identifiers have no version.
pub fn uuid_version(u: Uuid) -> Option<Int> / {abort.raise} =
  match uuid_variant(u) { Rfc -> Some(u.octets.at(6) >> 4), _ -> None }

/// Returns the time at which `u` says it was made, as an `Instant` (nanoseconds since
/// 1970-01-01T00:00:00Z). A version 7 identifier stores a millisecond count since 1970. A version 1
/// or 6 identifier stores a count of 100 ns intervals since 1582-10-15. Returns `None` for any
/// other version, which stores no time, and for a time after the year 2262, which an `Instant`
/// cannot represent. The time is whatever the maker wrote, so it is not proof of when the
/// identifier was made.
pub fn uuid_time(u: Uuid) -> Option<Instant> / {abort.raise} =
  match uuid_version(u) {
    Some(7) -> instant_of(field(u, 0, 6), 1000000),
    Some(6) -> since_1582(field(u, 0, 6) << 12 | field(u, 6, 8) & 0x0FFF),
    Some(1) -> since_1582((field(u, 6, 8) & 0x0FFF) << 48 | field(u, 4, 6) << 32 | field(u, 0, 4)),
    _ -> None,
  }

fn since_1582(ticks: Int) -> Option<Instant> = instant_of(ticks - 0x01B2_1DD2_1381_4000, 100)

fn instant_of(count: Int, nanoseconds: Int) -> Option<Instant> =
  checked_mul(count, nanoseconds).map(|n: Int| Instant(n))

fn field(u: Uuid, from: Int, to: Int) -> Int / {abort.raise} =
  range(from, to).fold(0, |n: Int, i: Int| n << 8 | u.octets.at(i))

fn with_version_and_variant(
  raw: Bytes,
  version: Int,
  variant: UuidVariant,
) -> Uuid / {abort.raise} = {
  let lead = variant_bits(variant);
  {
    octets: Bytes::concat_all([
      raw.slice(0, 6),
      byte_of_int(raw.at(6) & 0x0F | version << 4),
      raw.slice(7, 8),
      byte_of_int(raw.at(8) & lead.retained | lead.set),
      raw.slice(9, 16),
    ]),
  }
}

fn variant_bits(v: UuidVariant) -> { retained: Int, set: Int } =
  match v {
    Ncs -> { retained: 0x7F, set: 0x00 },
    Rfc -> { retained: 0x3F, set: 0x80 },
    Microsoft -> { retained: 0x1F, set: 0xC0 },
    Future -> { retained: 0x1F, set: 0xE0 },
  }

/// A version 4 identifier: sixteen random octets with the version and variant written over six
/// of their bits.
pub fn uuid_v4() -> Uuid / {entropy.next bounded, abort.raise} = {
  let raw = Bytes::concat_all([
    low_octets(entropy.next(), 6),
    low_octets(entropy.next(), 6),
    low_octets(entropy.next(), 4),
  ]);
  with_version_and_variant(raw, 4, Rfc)
}

fn low_octets(n: Int, count: Int) -> Bytes / {abort.raise} = u64_be(n).slice(8 - count, 8)

/// The namespace of fully qualified domain names (RFC 9562 §6.6).
pub fn uuid_namespace_dns() -> Uuid =
  { octets: b"\x6b\xa7\xb8\x10\x9d\xad\x11\xd1\x80\xb4\x00\xc0\x4f\xd4\x30\xc8" }

/// The namespace of URLs.
pub fn uuid_namespace_url() -> Uuid =
  { octets: b"\x6b\xa7\xb8\x11\x9d\xad\x11\xd1\x80\xb4\x00\xc0\x4f\xd4\x30\xc8" }

/// The namespace of ISO object identifiers, written in dots: `1.3.6.1`.
pub fn uuid_namespace_oid() -> Uuid =
  { octets: b"\x6b\xa7\xb8\x12\x9d\xad\x11\xd1\x80\xb4\x00\xc0\x4f\xd4\x30\xc8" }

/// The namespace of X.500 distinguished names.
pub fn uuid_namespace_x500() -> Uuid =
  { octets: b"\x6b\xa7\xb8\x14\x9d\xad\x11\xd1\x80\xb4\x00\xc0\x4f\xd4\x30\xc8" }

/// Returns the version 5 identifier of `name` in `namespace` (RFC 9562 §5.5): the first sixteen
/// octets of the SHA-1 of the namespace's octets followed by the name's, with the version and
/// variant bits set.
///
/// The same namespace and name give the same identifier on every machine. Pass a text name as its
/// UTF-8 bytes. SHA-1 is no longer collision resistant, so someone who chooses the names can make
/// two different names with the same identifier. Use this only when no attacker chooses the names.
pub fn uuid_v5(namespace: Uuid, name: Bytes) -> Uuid / {abort.raise} =
  with_version_and_variant(sha1(namespace.octets.concat(name)).slice(0, 16), 5, Rfc)

/// Returns a version 7 identifier: the current millisecond from the clock, then random bits (RFC
/// 9562 §5.7).
///
/// An identifier made in a later millisecond sorts after one made in an earlier millisecond. Two
/// made in the same millisecond have no defined order. If the clock is set back, identifiers made
/// later can sort before earlier ones. `uuid_v7_after` always returns identifiers in order. Anyone
/// with the identifier can read the time it was made with `uuid_time`.
pub fn uuid_v7() -> Uuid / {time.now_ms bounded, entropy.next bounded, abort.raise} = {
  let ms = time.now_ms();
  let rand_a = entropy.next();
  v7_of(clamped_ms(ms), rand_a, entropy.next())
}

/// Returns a version 7 identifier that sorts after `previous`, the last identifier the caller made.
///
/// If the clock is past `previous`'s millisecond, this behaves like `uuid_v7`. Otherwise the result
/// uses `previous`'s millisecond with its counter increased by one, or the next millisecond if the
/// counter is at its maximum. So a clock that stands still or moves backward never produces an
/// identifier out of order. A burst of more than a few thousand identifiers in one millisecond
/// makes the identifiers' time run ahead of the clock.
///
/// `previous` may be any identifier, of any version. Returns `None` only when no version 7
/// identifier can sort after it: that is when `previous` has the largest millisecond that 48 bits
/// can hold (in the year 10889) and its seventh and eighth octets are `0x7FFF` or more.
pub fn uuid_v7_after(
  previous: Uuid,
) -> Option<Uuid> / {time.now_ms bounded, entropy.next bounded, abort.raise} = {
  let ms = time.now_ms();
  let rand_a = entropy.next();
  v7_after(previous, clamped_ms(ms), rand_a, entropy.next())
}

/// `uuid_v7` with the time `at` and two random draws as arguments: the millisecond `at` falls in,
/// the low twelve bits of `rand_a` after the version, and the low sixty-two bits of `rand_b` after
/// the variant. A time before 1970 counts as 1970.
pub fn uuid_v7_at(at: Instant, rand_a: Int, rand_b: Int) -> Uuid / {abort.raise} =
  v7_of(ms_of(at), rand_a, rand_b)

/// `uuid_v7_after` with the time `at` and two random draws as arguments. When the result is in
/// `previous`'s millisecond, its twelve counter bits are one more than `previous`'s and `rand_a`
/// is not read.
pub fn uuid_v7_after_at(
  previous: Uuid,
  at: Instant,
  rand_a: Int,
  rand_b: Int,
) -> Option<Uuid> / {abort.raise} = v7_after(previous, ms_of(at), rand_a, rand_b)

fn v7_after(previous: Uuid, now: Int, rand_a: Int, rand_b: Int) -> Option<Uuid> / {abort.raise} = {
  let last = field(previous, 0, 6);
  let version_and_counter = field(previous, 6, 8);
  if now > last { Some(v7_of(now, rand_a, rand_b)) }
  else if version_and_counter < 0x7000 { Some(v7_of(last, rand_a, rand_b)) }
  else if version_and_counter < 0x7FFF { Some(v7_of(last, version_and_counter + 1, rand_b)) }
  else if last < last_ms() { Some(v7_of(last + 1, rand_a, rand_b)) }
  else { None }
}

fn v7_of(ms: Int, rand_a: Int, rand_b: Int) -> Uuid / {abort.raise} =
  with_version_and_variant(
    Bytes::concat_all([u64_be(ms).slice(2, 8), u16_be(rand_a), u64_be(rand_b)]),
    7,
    Rfc,
  )

fn last_ms() -> Int = 0xFFFF_FFFF_FFFF

fn clamped_ms(ms: Int) -> Int = min(max(ms, 0), last_ms())

fn ms_of(at: Instant) -> Int = clamped_ms(nanos_at(at) / 1000000)

fn parsed(text: String) -> Uuid / {abort.raise} = uuid_parse(text).expect(text)

fn v7_inputs() -> gen::Gen<V7Input> =
  gen::map3(
    gen::map(gen::any_int(), |n: Int| Instant(n)),
    gen::any_int(),
    gen::any_int(),
    |at: Instant, rand_a: Int, rand_b: Int| { at: at, rand_a: rand_a, rand_b: rand_b },
  )

test "a UUID's text parses back to the same UUID" {
  gen::check(uuid_gen(), |x: Uuid| round_trip(uuid_render, uuid_parse, x))
}

test "a UUID has a version only when its variant is RFC, and has a time only when its version is 1, 6 or 7" {
  gen::check(uuid_gen(), |u: Uuid| {
    (if uuid_variant(u) == Rfc { uuid_version(u) != None } else { uuid_version(u) == None })
      && (uuid_time(u) == None || [Some(1), Some(6), Some(7)].contains(uuid_version(u)))
  })
}

type V7Input = { at: Instant, rand_a: Int, rand_b: Int }

test "version 7 UUIDs made one after another sort in increasing order, whether the clock stays the same, advances or goes backwards" {
  gen::check2(v7_inputs(), gen::list(v7_inputs()), |first: V7Input, rest: List<V7Input>| {
    rest.fold(
      { last: uuid_v7_at(first.at, first.rand_a, first.rand_b), ordered: true },
      |made: { last: Uuid, ordered: Bool }, r: V7Input|
        match uuid_v7_after_at(made.last, r.at, r.rand_a, r.rand_b) {
          Some(next) ->
            {
              last: next,
              ordered: made.ordered && compare(next, made.last) == Greater
                && compare(uuid_render(next), uuid_render(made.last)) == Greater,
            },
          None -> { last: made.last, ordered: false },
        },
    ).ordered
  })
}

test "render is the canonical lowercase form and parse is its inverse" {
  let u: Uuid = { octets: Bytes::of_hex("0190f5e2c3a74b6d8e1f2a3b4c5d6e7f") };
  assert_eq(uuid_render(u), "0190f5e2-c3a7-4b6d-8e1f-2a3b4c5d6e7f");
  assert_eq(uuid_parse("0190f5e2-c3a7-4b6d-8e1f-2a3b4c5d6e7f"), Some(u));
  assert_eq(uuid_parse("0190F5E2-C3A7-4B6D-8E1F-2A3B4C5D6E7F"), Some(u))
}

test "parse rejects anything that is not 8-4-4-4-12 hex" {
  assert_eq(uuid_parse("0190f5e2c3a74b6d8e1f2a3b4c5d6e7f"), None);
  assert_eq(uuid_parse("0190f5e2-c3a7-4b6d-8e1f-2a3b4c5d6e7"), None);
  assert_eq(uuid_parse("0190f5e2-c3a7-4b6d-8e1f-2a3b4c5d6e7g"), None);
  assert_eq(uuid_parse("0190f5e2c3a7-4b6d-8e1f-2a3b-4c5d6e7f"), None);
  assert_eq(uuid_parse("0190f5e20c3a7-4b6d-8e1f-2a3b4c5d6e7f"), None);
  assert_eq(uuid_parse("0190f5e2-c3a704b6d-8e1f-2a3b4c5d6e7f"), None);
  assert_eq(uuid_parse("0190f5e2-c3a7-4b6d08e1f-2a3b4c5d6e7f"), None);
  assert_eq(uuid_parse("0190f5e2-c3a7-4b6d-8e1f02a3b4c5d6e7f"), None)
}

test "`literal` returns the UUID for valid text, and an error with a message and offset for text that is not a UUID" {
  assert_eq(
    literal("0190f5e2-c3a7-4b6d-8e1f-2a3b4c5d6e7f"),
    Ok({ octets: Bytes::of_hex("0190f5e2c3a74b6d8e1f2a3b4c5d6e7f") }),
  );
  assert_eq(
    literal("0190f5e2-c3a7-4b6d-8e1f-2a3b4c5d6e7g"),
    Err({ message: "not a hex digit", offset: 35 }),
  );
  assert_eq(
    literal("0190f5e2c3a7-4b6d-8e1f-2a3b-4c5d6e7f"),
    Err({ message: "a `-` goes here", offset: 8 }),
  );
  assert_eq(
    literal("g190f5e2-c3a7-4b6d-8e1f-2a3b4c5d6e7f"),
    Err({ message: "not a hex digit", offset: 0 }),
  );
  let short = Err({ message: "a UUID is 36 characters, written 8-4-4-4-12", offset: 8 });
  assert_eq(literal("0190f5e2"), short);
  assert_eq(
    literal("0190f5e2-c3a7-4b6d-8e1f-2a3b4c5d6e7fz"),
    Err({ message: "a UUID is 36 characters, written 8-4-4-4-12", offset: 36 }),
  );
  assert_eq(
    literal("0190f5e2-c3a7-4b6d-8e1f-2a3b4c5d6e7f0"),
    Err({ message: "a UUID is 36 characters, written 8-4-4-4-12", offset: 36 }),
  )
}

test "sixteen octets are a UUID, and no other number of them is" {
  let octets = Bytes::of_hex("0190f5e2c3a74b6d8e1f2a3b4c5d6e7f");
  assert_eq(uuid_of_octets(octets), uuid_parse("0190f5e2-c3a7-4b6d-8e1f-2a3b4c5d6e7f"));
  assert_eq(uuid_of_octets(octets.slice(0, 15)), None);
  assert_eq(uuid_of_octets(octets.concat(b"\x00")), None);
  assert_eq(uuid_of_octets(b""), None)
}

test "the nil and max UUIDs are all zeros and all ones, of no version" {
  assert_eq(uuid_render(uuid_nil()), "00000000-0000-0000-0000-000000000000");
  assert_eq(uuid_render(uuid_max()), "ffffffff-ffff-ffff-ffff-ffffffffffff");
  assert_eq(uuid_variant(uuid_nil()), Ncs);
  assert_eq(uuid_variant(uuid_max()), Future);
  assert_eq(uuid_version(uuid_nil()), None);
  assert_eq(uuid_version(uuid_max()), None);
  assert_eq(uuid_time(uuid_max()), None)
}

type VariantCase = { ninth: String, variant: UuidVariant }

fn variant_cases() -> List<VariantCase> =
  [
    { ninth: "00", variant: Ncs },
    { ninth: "7f", variant: Ncs },
    { ninth: "80", variant: Rfc },
    { ninth: "bf", variant: Rfc },
    { ninth: "c0", variant: Microsoft },
    { ninth: "df", variant: Microsoft },
    { ninth: "e0", variant: Future },
    { ninth: "ff", variant: Future },
  ]

test "a UUID whose ninth octet is {c.ninth} has the {c.variant} variant" for c: VariantCase in variant_cases(
  ) {
  let u = parsed("0190f5e2-c3a7-7b6d-" ++ c.ninth ++ "1f-2a3b4c5d6e7f");
  assert_eq(uuid_variant(u), c.variant);
  assert_eq(uuid_version(u), if c.variant == Rfc { Some(7) } else { None })
}

type Example = { section: String, text: String, version: Int, made_ms: Option<Int> }

fn rfc_examples() -> List<Example> =
  [
    {
      section: "A.1",
      text: "C232AB00-9414-11EC-B3C8-9F6BDECED846",
      version: 1,
      made_ms: Some(1645557742000),
    },
    { section: "A.2", text: "5df41881-3aed-3515-88a7-2f4a814cf09e", version: 3, made_ms: None },
    { section: "A.3", text: "919108f7-52d1-4320-9bac-f847db4148a8", version: 4, made_ms: None },
    { section: "A.4", text: "2ed6657d-e927-568b-95e1-2665a8aea6a2", version: 5, made_ms: None },
    {
      section: "A.5",
      text: "1EC9414C-232A-6B00-B3C8-9F6BDECED846",
      version: 6,
      made_ms: Some(1645557742000),
    },
    {
      section: "A.6",
      text: "017F22E2-79B0-7CC3-98C4-DC0C0C07398F",
      version: 7,
      made_ms: Some(1645557742000),
    },
    { section: "B.1", text: "2489E9AD-2EE2-8E00-8EC9-32D5F69181C0", version: 8, made_ms: None },
    { section: "B.2", text: "5c146b14-3c52-8afd-938a-375d0df1fbf6", version: 8, made_ms: None },
  ]

test "RFC 9562's example {c.section} is of version {c.version}" for c: Example in rfc_examples() {
  let u = parsed(c.text);
  assert_eq(uuid_variant(u), Rfc);
  assert_eq(uuid_version(u), Some(c.version));
  assert_eq(uuid_time(u), c.made_ms.map(at_millis))
}

type Namespace = { name: String, namespace: Uuid, text: String }

fn rfc_namespaces() -> List<Namespace> =
  [
    { name: "DNS", namespace: uuid_namespace_dns(), text: "6ba7b810-9dad-11d1-80b4-00c04fd430c8" },
    { name: "URL", namespace: uuid_namespace_url(), text: "6ba7b811-9dad-11d1-80b4-00c04fd430c8" },
    { name: "OID", namespace: uuid_namespace_oid(), text: "6ba7b812-9dad-11d1-80b4-00c04fd430c8" },
    {
      name: "X500",
      namespace: uuid_namespace_x500(),
      text: "6ba7b814-9dad-11d1-80b4-00c04fd430c8",
    },
  ]

test "the {c.name} namespace is the one RFC 9562 registers" for c: Namespace in rfc_namespaces() {
  assert_eq(uuid_render(c.namespace), c.text)
}

type NameCase = { namespace: Uuid, name: String, id: String }

fn name_cases() -> List<NameCase> =
  [
    {
      namespace: uuid_namespace_dns(),
      name: "www.example.com",
      id: "2ed6657d-e927-568b-95e1-2665a8aea6a2",
    },
    {
      namespace: uuid_namespace_dns(),
      name: "python.org",
      id: "886313e1-3b8a-5372-9b90-0c9aee199e5d",
    },
    { namespace: uuid_namespace_dns(), name: "", id: "4ebd0208-8328-5d69-8c44-ec50939c0967" },
    {
      namespace: uuid_namespace_dns(),
      name: "b\u{fc}cher.example",
      id: "849d4d8f-6c8e-59fa-9721-89ccba396bf9",
    },
    {
      namespace: uuid_namespace_url(),
      name: "https://example.com/a?b=c",
      id: "c33ae727-a88e-54fd-83c1-eb80bc195938",
    },
    {
      namespace: uuid_namespace_oid(),
      name: "1.3.6.1.4.1",
      id: "106dd502-8b3e-50db-80ed-1134f5c18eae",
    },
    {
      namespace: uuid_namespace_x500(),
      name: "CN=Ply,O=Example",
      id: "a5da2c06-acbd-558e-b610-d880b37d6132",
    },
    { namespace: uuid_nil(), name: "x", id: "f3e951bb-a80b-5e6c-a038-a56ee0caa25d" },
  ]

test "`uuid_v5` of `{c.name}` in the namespace {uuid_render(c.namespace)} returns the expected UUID" for c: NameCase in name_cases(
  ) { assert_eq(uuid_render(uuid_v5(c.namespace, Bytes::of_string(c.name))), c.id) }

test "v4 overwrites the version and variant bits and nothing else" {
  let zeros = handle { uuid_v4() } with { entropy.next() -> 0 };
  assert_eq(uuid_render(zeros), "00000000-0000-4000-8000-000000000000");
  let ones = handle { uuid_v4() } with { entropy.next() -> 0x7FFF_FFFF_FFFF_FFFF };
  assert_eq(uuid_render(ones), "ffffffff-ffff-4fff-bfff-ffffffffffff");
  assert_eq(uuid_version(ones), Some(4));
  let counted = handle { uuid_v4() } with { entropy.next() -> 0x0102_0304_0506_0708 };
  assert_eq(uuid_render(counted), "03040506-0708-4304-8506-070805060708")
}

test "RFC 9562's version 7 example is its millisecond followed by its random fields" {
  let made = at_millis(1645557742000);
  let u = uuid_v7_at(made, 0xCC3, 0x18C4_DC0C_0C07_398F);
  assert_eq(u, parsed("017F22E2-79B0-7CC3-98C4-DC0C0C07398F"));
  assert_eq(uuid_v7_at(made, 0x7FFF_FFFF_FFFF_FCC3, 0x58C4_DC0C_0C07_398F), u);
  assert_eq(uuid_v7_at(Instant(1645557742000999999), 0xCC3, 0x18C4_DC0C_0C07_398F), u)
}

test "`uuid_v7` is built from the clock's millisecond and two random draws, so fixed clock and random values give a fixed UUID" {
  let u = handle {
    uuid_v7()
  } with {
    time.now_ms() -> 1645557742000,
    entropy.next() -> 0x18C4_DC0C_0C07_398F,
  };
  assert_eq(uuid_render(u), "017f22e2-79b0-798f-98c4-dc0c0c07398f");
  assert_eq(uuid_time(u), Some(at_millis(1645557742000)))
}

test "`uuid_v7_at` writes a time before 1970 as 1970, and a time beyond 48 bits as the last millisecond that fits" {
  assert_eq(uuid_time(uuid_v7_at(Instant(0 - 1), 0, 0)), Some(Instant(0)));
  assert_eq(
    uuid_render(uuid_v7_at(Instant(0 - 5000000000), 1, 2)),
    "00000000-0000-7001-8000-000000000002",
  );
  let late = handle {
    uuid_v7()
  } with {
    time.now_ms() -> 0x7FFF_FFFF_FFFF_FFFF,
    entropy.next() -> 0,
  };
  assert_eq(uuid_render(late), "ffffffff-ffff-7000-8000-000000000000");
  let early = handle { uuid_v7() } with { time.now_ms() -> 0 - 1, entropy.next() -> 0 };
  assert_eq(uuid_render(early), "00000000-0000-7000-8000-000000000000")
}

test "a version 7 UUID made after another adds one to the previous counter while the clock is not ahead of the previous millisecond" {
  let first = uuid_v7_at(at_millis(1000), 0x123, 5);
  assert_eq(uuid_render(first), "00000000-03e8-7123-8000-000000000005");
  let same = uuid_v7_after_at(first, at_millis(1000), 0xABC, 6);
  assert_eq(same.map(uuid_render), Some("00000000-03e8-7124-8000-000000000006"));
  let back = uuid_v7_after_at(first, at_millis(999), 0xABC, 7);
  assert_eq(back.map(uuid_render), Some("00000000-03e8-7124-8000-000000000007"));
  let on = uuid_v7_after_at(first, at_millis(1001), 0xABC, 8);
  assert_eq(on.map(uuid_render), Some("00000000-03e9-7abc-8000-000000000008"));
  let zero = uuid_v7_after_at(uuid_v7_at(at_millis(1000), 0, 5), at_millis(1000), 0, 0);
  assert_eq(zero.map(uuid_render), Some("00000000-03e8-7001-8000-000000000000"))
}

test "`uuid_v7_after_at` moves to the next millisecond when the previous counter is at its maximum, and restarts the counter from zero when the previous UUID is not version 7" {
  let spent = uuid_v7_at(at_millis(1000), 0xFFF, 5);
  let carried = uuid_v7_after_at(spent, at_millis(1000), 0xABC, 6);
  assert_eq(carried.map(uuid_render), Some("00000000-03e9-7abc-8000-000000000006"));
  let random = parsed("00000000-03e8-4fff-bfff-ffffffffffff");
  let passed = uuid_v7_after_at(random, at_millis(1000), 0xABC, 6);
  assert_eq(passed.map(uuid_render), Some("00000000-03e8-7abc-8000-000000000006"));
  let custom = parsed("00000000-03e8-8000-8000-000000000000");
  let past = uuid_v7_after_at(custom, at_millis(1000), 0xABC, 6);
  assert_eq(past.map(uuid_render), Some("00000000-03e9-7abc-8000-000000000006"))
}

test "`uuid_v7_after_at` returns `None` when the previous UUID has the maximum timestamp and the maximum counter, so no later version 7 UUID exists" {
  let nearly = parsed("ffffffff-ffff-7ffe-8000-000000000000");
  assert_eq(
    uuid_v7_after_at(nearly, at_millis(0), 0, 9).map(uuid_render),
    Some("ffffffff-ffff-7fff-8000-000000000009"),
  );
  assert_eq(
    uuid_v7_after_at(parsed("ffffffff-ffff-7fff-8000-000000000000"), at_millis(0), 0, 0),
    None,
  );
  assert_eq(uuid_v7_after_at(uuid_max(), at_millis(0), 0, 0), None)
}

test "v7 made after another under a clock that stands still comes out in order" {
  let made = handle {
    let first = uuid_v7();
    let second = uuid_v7_after(first).expect("a second");
    [first, second, uuid_v7_after(second).expect("a third")]
  } with {
    time.now_ms() -> 1645557742000,
    entropy.next() -> 0x18C4_DC0C_0C07_398F,
  };
  assert_eq(made.map(uuid_render), [
    "017f22e2-79b0-798f-98c4-dc0c0c07398f",
    "017f22e2-79b0-7990-98c4-dc0c0c07398f",
    "017f22e2-79b0-7991-98c4-dc0c0c07398f",
  ])
}

test "a map keyed by version 7 UUIDs lists them in the order they were made" {
  let made = range(1, 24).fold(
    [uuid_v7_at(at_millis(1645557742000), 0xFFE, 1)],
    |us: List<Uuid>, i: Int|
      match us.last().and_then(|u: Uuid|
          uuid_v7_after_at(u, at_millis(1645557742000 + i / 8), 7919 * i, 104729 * (24 - i))) {
        Some(next) -> us.push(next),
        None -> us,
      },
  );
  assert_eq(made.len(), 24);
  let entries = range(0, 24).fold(Map::new(), |m: Map<Uuid, Int>, i: Int| {
    let place = i * 7 % 24;
    match made.at(place) { Some(u) -> m.insert(u, place), None -> m }
  });
  assert_eq(entries.keys(), made);
  assert_eq(entries.values(), range(0, 24))
}

test "the generator draws the nil and max UUIDs, every variant and every version" {
  let drawn = range(0, 400).fold([], |us: List<Uuid>, root: Int|
    match gen::sample(uuid_gen(), root, b"uuid", root % 64, None).value {
      Some(u) -> us.push(u),
      None -> us,
    });
  assert_eq(drawn.len(), 400);
  assert(drawn.contains(uuid_nil()));
  assert(drawn.contains(uuid_max()));
  let variants = drawn.filter(|u: Uuid| u != uuid_nil() && u != uuid_max()).map(uuid_variant);
  assert_eq([Ncs, Rfc, Microsoft, Future].filter(|v: UuidVariant| !variants.contains(v)), []);
  let versions = drawn.map(uuid_version);
  assert_eq(range(0, 16).filter(|v: Int| !versions.contains(Some(v))), []);
  assert_eq(gen::sample(uuid_gen(), 0, b"", 0, Some([])).value, Some(uuid_nil()))
}
