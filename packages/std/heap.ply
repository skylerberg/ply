//! A priority queue: values stored under priorities, with the least priority leaving first.
//!
//! The priority is separate from the value, so values need no wrapper to be ordered. Entries with
//! the same priority leave in the order they were pushed, so a scheduler built on a heap is
//! deterministic. The order is either the priorities' own `compare` (`empty`) or a comparison like
//! the one `sort_by` takes (`empty_by`). To get the greatest priority first, pass `empty_by` the
//! reversed comparison. Entries cannot be looked up after they are pushed. Use
//! `std.priority_search_queue` for a queue whose entries can be changed or removed by key.
//!
//! A `Heap` is a leftist tree. `push`, `pop_min` and `merge` each visit one path of the tree, which
//! takes time logarithmic in its size, even when other code still uses the original heap. Reusing a
//! heap therefore costs the same as using a new one. `of_list` builds a heap in linear time.
//!
//! Two heaps are equal when they pop the same entries in the same order. The heap declares
//! `to_list` as its equality key, so heaps with the same entries are `==`, have the same `digest`
//! and are the same `Map` key, however each was built. The key function receives only the heap, so
//! the heap stores its ordering function in a field. Each comparison calls `to_list` on both heaps,
//! which pops every entry.

import std.laws (agrees)
import std.list as list
import std.math (ilog2)
import std.gen

/// A value and the priority it was pushed under.
pub type Entry<p, a> = { priority: p, value: a }

/// A priority queue of values of type `a` under priorities of type `p`.
///
/// The fields are, in order: the function that orders priorities, a `Bool` that is true when that
/// function is the priorities' own `compare`, the tree, the number of entries, and the sequence
/// number of the next push.
pub type Heap<p, a> = | Heap((p, p) -> Ordering, Bool, Tree<p, a>, Int, Int)

key for Heap by to_list

type Tree<p, a> = | Leaf | Node(Int, Int, p, Int, a, Tree<p, a>, Tree<p, a>)

/// An empty heap in the priorities' own order: the least by `compare` leaves first.
pub fn empty<p, a>() -> Heap<p, a>
  where derivable(ord, p)
= Heap(|x: p, y: p| compare(x, y), true, Leaf, 0, 0)

/// Returns an empty heap ordered by `before`, which returns whether its first argument must leave
/// the heap before its second, as the comparison of `sort_by` does. Two priorities are equal when
/// `before` returns false for both orders of the arguments. Entries with equal priorities leave in
/// the order they were pushed.
pub fn empty_by<p, a>(before: keep (p, p) -> Bool) -> Heap<p, a> =
  Heap(ordering(before), false, Leaf, 0, 0)

/// A heap of `entries` in the priorities' own order. An earlier entry leaves before a later one
/// with the same priority. Takes time linear in the number of entries.
pub fn of_list<p, a>(entries: List<Entry<p, a>>) -> Heap<p, a>
  where derivable(ord, p)
= build(|x: p, y: p| compare(x, y), true, entries)

/// A heap of `entries` ordered by `before`, as for `empty_by`.
pub fn of_list_by<p, a>(entries: List<Entry<p, a>>, before: keep (p, p) -> Bool) -> Heap<p, a> =
  build(ordering(before), false, entries)

/// How many entries the heap holds.
pub fn size<p, a>(h: Heap<p, a>) -> Int = match h { Heap(_, _, _, n, _) -> n }

/// Whether the heap is empty.
pub fn is_empty<p, a>(h: Heap<p, a>) -> Bool =
  match h { Heap(_, _, tree, _, _) -> match tree { Leaf -> true, _ -> false } }

/// `h` with `x` added under `priority`, after every entry it already has with that priority.
pub fn push<p, a>(h: Heap<p, a>, priority: p, x: a) -> Heap<p, a> =
  match h {
    Heap(order, natural, tree, n, next) ->
      Heap(
        order,
        natural,
        meld(order, tree, 0, Node(1, 0, priority, next, x, Leaf, Leaf), 0),
        n + 1,
        next + 1,
      ),
  }

/// The entry `pop_min` would take, or `None` for an empty heap.
pub fn peek_min<p, a>(h: Heap<p, a>) -> Option<Entry<p, a>> =
  match h {
    Heap(_, _, tree, _, _) -> match tree {
      Leaf -> None,
      Node(_, _, priority, _, value, _, _) -> Some({ priority: priority, value: value }),
    },
  }

/// Removes the entry that leaves first, which is the earliest pushed of the least priority.
/// Returns it with the rest of the heap, or `None` for an empty heap.
pub fn pop_min<p, a>(h: Heap<p, a>) -> Option<{ priority: p, value: a, rest: Heap<p, a> }> =
  match h {
    Heap(order, natural, tree, n, next) -> match tree {
      Leaf -> None,
      Node(_, shift, priority, _, value, left, right) ->
        Some({
          priority: priority,
          value: value,
          rest: match meld(order, left, shift, right, shift) {
            Leaf -> Heap(order, natural, Leaf, 0, 0),
            rest -> Heap(order, natural, rest, n - 1, next),
          },
        }),
    },
  }

/// Returns a heap containing every entry of `a` and `b`, ordered by the same ordering as `a`. An
/// entry of `a` leaves before an entry of `b` with the same priority.
///
/// If both heaps use the priorities' own order, this combines their trees directly. A heap made by
/// `empty_by` or `of_list_by` may use a different ordering than `a`, so in that case the entries of
/// `b` are pushed onto `a` one by one.
pub fn merge<p, a>(a: Heap<p, a>, b: Heap<p, a>) -> Heap<p, a> =
  match a {
    Heap(order, natural, tree, n, next) -> match b {
      Heap(_, also_natural, other, m, other_next) -> if !(natural && also_natural) {
        to_list(b).fold(a, |h: Heap<p, a>, e: Entry<p, a>| push(h, e.priority, e.value))
      } else if other_next <= max_sequence_number - next {
        Heap(order, natural, meld(order, tree, 0, other, next), n + m, next + other_next)
      } else { build(order, natural, to_list(a).concat(to_list(b))) },
    },
  }

/// The entries in the order `pop_min` would return them. Heaps are compared, ordered and digested
/// by this list.
pub fn to_list<p, a>(h: Heap<p, a>) -> List<Entry<p, a>> =
  match h { Heap(order, _, tree, n, _) -> first_entries(order, tree, n, []) }

/// The first `k` entries `pop_min` would return, or all of them if the heap has fewer.
pub fn top_k<p, a>(h: Heap<p, a>, k: Int) -> List<Entry<p, a>> =
  match h { Heap(order, _, tree, n, _) -> first_entries(order, tree, min(k, n), []) }

/// Merges runs that are each already ascending into one ascending list. Merging `k` runs with `n`
/// elements in total takes `n log k` comparisons. Equal elements keep the order of their runs,
/// and their order within a run.
pub fn merge_sorted<a>(runs: List<List<a>>) -> List<a>
  where derivable(ord, a)
= merge_sorted_by(runs, |x: a, y: a| compare(x, y) == Less)

/// `merge_sorted` for runs that are each ordered by `before`, as `sort_by` orders a list.
pub fn merge_sorted_by<a>(runs: List<List<a>>, before: keep (a, a) -> Bool) -> List<a> = {
  let order = ordering(before);
  let by_head = |x: Head<a>, y: Head<a>|
    match order(x.head, y.head) { Equal -> compare(x.run_index, y.run_index), decided -> decided };
  let heads = range(0, runs.len()).fold(
    Heap(by_head, false, Leaf, 0, 0),
    |h: Heap<Head<a>, List<a>>, i: Int|
      match runs.at(i) { Some(run) -> push_next_element(h, i, run), None -> h },
  );
  range(0, runs.fold(0, |n: Int, run: List<a>| n + run.len())).fold(
    { rest: heads, out: [] },
    |s: { rest: Heap<Head<a>, List<a>>, out: List<a> }, _i: Int|
      match pop_min(s.rest) {
        None -> s,
        Some(top) ->
          {
            rest: push_next_element(top.rest, top.priority.run_index, top.value),
            out: s.out.concat([top.priority.head]),
          },
      },
  ).out
}

type Head<a> = { head: a, run_index: Int }

fn push_next_element<a>(
  h: Heap<Head<a>, List<a>>,
  run: Int,
  xs: List<a>,
) -> Heap<Head<a>, List<a>> =
  match xs { [] -> h, [x, ..rest] -> push(h, { head: x, run_index: run }, rest) }

fn ordering<p>(before: keep (p, p) -> Bool) -> (p, p) -> Ordering =
  |x: p, y: p|
    if before(x, y) { if before(y, x) { Equal } else { Less } }
    else if before(y, x) { Greater }
    else { Equal }

const max_sequence_number: Int = 4611686018427387904

fn build<p, a>(
  order: keep (p, p) -> Ordering,
  natural: Bool,
  entries: List<Entry<p, a>>,
) -> Heap<p, a> = {
  let n = entries.len();
  let singles = range(0, n).map(|i: Int|
    match entries.at(i) {
      Some(e) -> Node(1, 0, e.priority, i, e.value, Leaf, Leaf),
      None -> Leaf,
    });
  let rounds = range(0, 64).fold(singles, |trees: List<Tree<p, a>>, _round: Int|
    if trees.len() <= 1 { trees } else {
      range(0, (trees.len() + 1) / 2).map(|i: Int|
        match trees.at(2 * i) {
          None -> Leaf,
          Some(left) -> match trees.at(2 * i + 1) {
            None -> left,
            Some(right) -> meld(order, left, 0, right, 0),
          },
        })
    });
  Heap(order, natural, match rounds { [tree, ..] -> tree, [] -> Leaf }, n, n)
}

fn first_entries<p, a>(
  order: (p, p) -> Ordering,
  tree: Tree<p, a>,
  k: Int,
  out: List<Entry<p, a>>,
) -> List<Entry<p, a>> =
  if k <= 0 { out } else {
    match tree {
      Leaf -> out,
      Node(_, shift, priority, _, value, left, right) ->
        first_entries(
          order,
          meld(order, left, shift, right, shift),
          k - 1,
          out.concat([{ priority: priority, value: value }]),
        ),
    }
  }

fn meld<p, a>(
  order: (p, p) -> Ordering,
  x: Tree<p, a>,
  dx: Int,
  y: Tree<p, a>,
  dy: Int,
) -> Tree<p, a> =
  match x {
    Leaf -> if dy == 0 { y } else { shifted(y, dy) },
    Node(_, sx, px, qx, vx, lx, rx) -> match y {
      Leaf -> if dx == 0 { x } else { shifted(x, dx) },
      Node(_, sy, py, qy, vy, ly, ry) -> {
        let context = dx + sx;
        let cy = dy + sy;
        if match order(px, py) { Less -> true, Greater -> false, Equal -> qx + context < qy + cy } {
          make_node(
            px,
            qx + context,
            vx,
            if context == 0 { lx } else { shifted(lx, context) },
            meld(order, rx, context, y, dy),
          )
        } else {
          make_node(
            py,
            qy + cy,
            vy,
            if cy == 0 { ly } else { shifted(ly, cy) },
            meld(order, x, dx, ry, cy),
          )
        }
      },
    },
  }

fn shifted<p, a>(tree: Tree<p, a>, by: Int) -> Tree<p, a> =
  match tree {
    Leaf -> Leaf,
    Node(rank, shift, priority, seq, value, left, right) ->
      Node(rank, shift + by, priority, seq, value, left, right),
  }

fn make_node<p, a>(
  priority: p,
  seq: Int,
  value: a,
  left: Tree<p, a>,
  right: Tree<p, a>,
) -> Tree<p, a> =
  match left {
    Leaf -> Node(1, 0, priority, seq, value, right, Leaf),
    Node(l, _, _, _, _, _, _) -> match right {
      Leaf -> Node(1, 0, priority, seq, value, left, Leaf),
      Node(r, _, _, _, _, _, _) -> if l >= r { Node(r + 1, 0, priority, seq, value, left, right) }
      else { Node(l + 1, 0, priority, seq, value, right, left) },
    },
  }

fn letters() -> Heap<Int, String> = push(push(push(push(empty(), 2, "b"), 1, "a"), 2, "c"), 1, "d")

test "entries leave least priority first, and equal priorities in the order they came" {
  let h = letters();
  assert_eq(size(h), 4);
  assert(!is_empty(h));
  assert_eq(to_list(h), [
    { priority: 1, value: "a" },
    { priority: 1, value: "d" },
    { priority: 2, value: "b" },
    { priority: 2, value: "c" },
  ]);
  assert_eq(peek_min(h), Some({ priority: 1, value: "a" }));
  match pop_min(h) {
    None -> assert(false),
    Some(top) -> {
      assert_eq({ priority: top.priority, value: top.value }, { priority: 1, value: "a" });
      assert_eq(size(top.rest), 3);
      assert_eq(peek_min(top.rest), Some({ priority: 1, value: "d" }))
    },
  }
}

test "an empty heap has nothing to return" {
  let none: Heap<Int, String> = empty();
  assert(is_empty(none));
  assert_eq(size(none), 0);
  assert_eq(peek_min(none), None);
  assert(pop_min(none) == None);
  assert_eq(to_list(none), []);
  assert_eq(top_k(none, 3), [])
}

test "a heap emptied and then refilled returns equal priorities in the order they were pushed" {
  let once = match pop_min(push(empty(), 1, "a")) { Some(top) -> top.rest, None -> empty() };
  assert(is_empty(once));
  assert_eq(size(once), 0);
  assert_eq(to_list(push(push(once, 5, "x"), 5, "y")), [
    { priority: 5, value: "x" },
    { priority: 5, value: "y" },
  ])
}

test "a caller's comparison orders the heap, and equal priorities still leave as they came" {
  let most_first = |entries: List<Entry<Int, String>>|
    to_list(of_list_by(entries, |x: Int, y: Int| x > y));
  let entries = [
    { priority: 1, value: "a" },
    { priority: 3, value: "b" },
    { priority: 3, value: "c" },
    { priority: 2, value: "d" },
  ];
  let expected = [
    { priority: 3, value: "b" },
    { priority: 3, value: "c" },
    { priority: 2, value: "d" },
    { priority: 1, value: "a" },
  ];
  assert_eq(most_first(entries), expected);
  assert_eq(to_list(of_list_by(entries, |x: Int, y: Int| x >= y)), expected);
  assert_eq(
    to_list(
      push(
        push(push(empty_by(|x: String, y: String| x.len() < y.len()), "bb", 1), "a", 2),
        "cc",
        3,
      ),
    ),
    [{ priority: "a", value: 2 }, { priority: "bb", value: 1 }, { priority: "cc", value: 3 }],
  )
}

test "`merge` puts the first heap's entries before the second heap's among entries of equal priority" {
  let a = of_list([{ priority: 1, value: "a1" }, { priority: 1, value: "a2" }]);
  let b = of_list([{ priority: 1, value: "b1" }, { priority: 0, value: "b0" }]);
  let both = merge(a, b);
  assert_eq(size(both), 4);
  assert_eq(to_list(both).map(|e: Entry<Int, String>| e.value), ["b0", "a1", "a2", "b1"]);
  let again = push(merge(both, a), 1, "z");
  assert_eq(to_list(again).map(|e: Entry<Int, String>| e.value), [
    "b0",
    "a1",
    "a2",
    "b1",
    "a1",
    "a2",
    "z",
  ]);
  assert_eq(to_list(merge(b, merge(a, b))).map(|e: Entry<Int, String>| e.value), [
    "b0",
    "b0",
    "b1",
    "a1",
    "a2",
    "b1",
  ]);
  assert_eq(to_list(merge(a, empty())), to_list(a));
  assert_eq(to_list(merge(empty(), a)), to_list(a))
}

test "entries of equal priority come out in insertion order across merges, pushes and pops" {
  let named = |names: List<String>| of_list(names.map(|name: String| { priority: 1, value: name }));
  let values = |h: Heap<Int, String>| to_list(h).map(|e: Entry<Int, String>| e.value);
  let a = named(["a1", "a2", "a3"]);
  let b = push(named(["b1", "b2", "b3"]), 0, "b0");
  let both = merge(a, b);
  assert_eq(values(both), ["b0", "a1", "a2", "a3", "b1", "b2", "b3"]);
  let twice = merge(both, push(both, 1, "z"));
  assert_eq(values(twice), [
    "b0",
    "b0",
    "a1",
    "a2",
    "a3",
    "b1",
    "b2",
    "b3",
    "a1",
    "a2",
    "a3",
    "b1",
    "b2",
    "b3",
    "z",
  ]);
  let later = match pop_min(twice) {
    Some(first) -> match pop_min(first.rest) {
      Some(second) -> match pop_min(second.rest) { Some(third) -> third.rest, None -> second.rest },
      None -> first.rest,
    },
    None -> twice,
  };
  assert_eq(values(merge(push(later, 1, "y"), b)), [
    "b0",
    "a2",
    "a3",
    "b1",
    "b2",
    "b3",
    "a1",
    "a2",
    "a3",
    "b1",
    "b2",
    "b3",
    "z",
    "y",
    "b1",
    "b2",
    "b3",
  ])
}

test "`merge` of heaps built with a custom comparison orders the result by the first heap's comparison" {
  let down = of_list_by(
    [{ priority: 1, value: "a" }, { priority: 3, value: "b" }],
    |x: Int, y: Int| x > y,
  );
  let up = of_list([{ priority: 2, value: "c" }, { priority: 3, value: "d" }]);
  assert_eq(to_list(merge(down, up)).map(|e: Entry<Int, String>| e.value), ["b", "d", "c", "a"]);
  assert_eq(to_list(merge(up, down)).map(|e: Entry<Int, String>| e.value), ["a", "c", "d", "b"])
}

test "two heaps with the same entries are equal, however each was built" {
  let pushed = push(push(push(empty(), 3, "c"), 1, "a"), 2, "b");
  let first_entries = of_list([
    { priority: 1, value: "a" },
    { priority: 2, value: "b" },
    { priority: 3, value: "c" },
  ]);
  let merged = merge(push(empty(), 2, "b"), push(push(empty(), 3, "c"), 1, "a"));
  assert(pushed == first_entries);
  assert(pushed == merged);
  assert_eq(digest(pushed), digest(first_entries));
  assert_eq(digest(pushed), digest(merged));
  assert_eq(compare(pushed, merged), Equal);
  assert_eq(#{pushed: 1, first_entries: 2, merged: 3}.len(), 1);
  assert(pushed != push(first_entries, 0, "z"));
  assert_eq(compare(push(first_entries, 0, "z"), pushed), Less);
  assert(push(push(empty(), 1, "a"), 1, "b") != push(push(empty(), 1, "b"), 1, "a"))
}

test "a heap is a value: pushes, pops and merges leave the original unchanged" {
  let h = letters();
  let grown = push(h, 0, "z");
  let shrunk = match pop_min(h) { Some(top) -> top.rest, None -> h };
  assert_eq(size(h), 4);
  assert_eq(peek_min(h), Some({ priority: 1, value: "a" }));
  assert_eq(peek_min(grown), Some({ priority: 0, value: "z" }));
  assert_eq(peek_min(shrunk), Some({ priority: 1, value: "d" }));
  assert_eq(size(merge(h, h)), 8);
  assert_eq(size(h), 4)
}

test "top_k returns the first k, and no more than there are" {
  let h = letters();
  assert_eq(top_k(h, 2), [{ priority: 1, value: "a" }, { priority: 1, value: "d" }]);
  assert_eq(top_k(h, 0), []);
  assert_eq(top_k(h, 0 - 1), []);
  assert_eq(top_k(h, 99), to_list(h))
}

test "merge_sorted merges the runs, an earlier run first among equals" {
  assert_eq(merge_sorted([[1, 3, 5], [2, 3, 4], [], [3]]), [1, 2, 3, 3, 3, 4, 5]);
  assert_eq(merge_sorted([[1, 2]]), [1, 2]);
  let none: List<List<Int>> = [];
  assert_eq(merge_sorted(none), []);
  assert_eq(
    merge_sorted_by(
      [
        [{ priority: 1, value: "a" }, { priority: 1, value: "b" }, { priority: 2, value: "c" }],
        [{ priority: 1, value: "d" }, { priority: 2, value: "e" }],
      ],
      |x: Entry<Int, String>, y: Entry<Int, String>| x.priority < y.priority,
    ),
    [
      { priority: 1, value: "a" },
      { priority: 1, value: "b" },
      { priority: 1, value: "d" },
      { priority: 2, value: "c" },
      { priority: 2, value: "e" },
    ],
  );
  assert_eq(merge_sorted_by([[3, 1], [2]], |x: Int, y: Int| x > y), [3, 2, 1])
}

test "a push and a pop on a large heap leave the original unchanged" {
  let h = of_list(scattered(1024));
  assert_eq(size(push(h, 512, 0)), 1025);
  assert_eq(match pop_min(h) { Some(top) -> size(top.rest), None -> 0 }, 1023);
  assert_eq(size(h), 1024)
}

fn coarse_priorities(entries: List<Entry<Int, Int>>) -> List<Entry<Int, Int>> =
  entries.map(|e: Entry<Int, Int>| { priority: e.priority & 3, value: e.value })

fn by_priority(entries: List<Entry<Int, Int>>) -> List<Entry<Int, Int>> =
  entries.sort_by(|x: Entry<Int, Int>, y: Entry<Int, Int>| x.priority < y.priority)

fn pushed_all(entries: List<Entry<Int, Int>>) -> Heap<Int, Int> =
  entries.fold(empty(), |h: Heap<Int, Int>, e: Entry<Int, Int>| push(h, e.priority, e.value))

test "popping everything returns the stable sort of what was pushed" {
  gen::check(
    gen::list(
      gen::map2(gen::any_int(), gen::any_int(), |priority: Int, value: Int|
        { priority: priority, value: value }),
    ),
    |x: List<Entry<Int, Int>>|
      agrees(
        |entries: List<Entry<Int, Int>>| to_list(pushed_all(coarse_priorities(entries))),
        |entries: List<Entry<Int, Int>>| by_priority(coarse_priorities(entries)),
        x,
      ),
  )
}

test "a heap built at once is the heap pushed one by one" {
  gen::check(
    gen::list(
      gen::map2(gen::any_int(), gen::any_int(), |priority: Int, value: Int|
        { priority: priority, value: value }),
    ),
    |x: List<Entry<Int, Int>>|
      agrees(
        |entries: List<Entry<Int, Int>>| of_list(coarse_priorities(entries)),
        |entries: List<Entry<Int, Int>>| pushed_all(coarse_priorities(entries)),
        x,
      ),
  )
}

test "merging sorted runs is sorting them together" {
  gen::check(gen::list(gen::list(gen::any_int())), |x: List<List<Int>>|
    agrees(
      |runs: List<List<Int>>| merge_sorted(runs.map(|run: List<Int>| run.sort())),
      |runs: List<List<Int>>| runs.flatten().sort(),
      x,
    ))
}

fn scattered(n: Int) -> List<Entry<Int, Int>> =
  range(0, n).map(|i: Int| { priority: i * 7919 % n, value: i })
