//! WebSockets (RFC 6455) over an HTTP/1.1 `Upgrade`, with permessage-deflate (RFC 7692).
//!
//! The protocol core does no I/O: it takes bytes in and produces events. Sessions over `std.net`
//! are built on top of it. `decode_frame` reads one frame from the front of a buffer under
//! `Limits`, and `encode_frame` writes one, masked when a key is given. `handle_frame` is the state
//! machine. It takes the frames a peer sent, in order, and returns the messages they complete, the
//! pongs and close frame this end must send back, and the failure that ends the connection, if any.
//! Every protocol violation fails the connection with the close code RFC 6455 §7.4 assigns: a frame
//! from a client that is not masked or from a server that is masked (1002), a reserved bit or
//! opcode (1002), a control frame that is fragmented or longer than 125 bytes (1002), a
//! continuation frame with nothing to continue or a new message started inside a fragmented one
//! (1002), a close code no endpoint may send (1002), text that is not UTF-8 (1007), and a frame,
//! message or fragment count above `Limits` (1009). A close from the peer is echoed back, and no
//! frames are read after it.
//!
//! `upgrade` responds to a request as a server does. It returns the `101` response that switches
//! protocols, choosing the subprotocol this server prefers among the client's offers. For a request
//! it cannot accept, it returns a rejection: `426` naming version 13 when the request asks for
//! another version, or `400` when the request is not a handshake. `handshake` builds a client's
//! request, and `check_response` checks the server's `101` against it.
//!
//! By default, permessage-deflate reuses each end's compression context for the next message (RFC
//! 7692 §7.2.1). The two ends can negotiate to turn this off for either end, using the parameters
//! `server_no_context_takeover` and `client_no_context_takeover`. A server accepts a client's offer
//! as it is. The server's response includes `server_no_context_takeover` when the client's offer
//! includes it or `Options.takeover` is off. It includes `client_no_context_takeover` when the
//! client's offer includes it or `Options.takeover` is off. A client with `Options.takeover` off
//! offers both parameters. A message is compressed with the writer from `std.gzip` and ended with a
//! sync flush. The flush's trailing bytes `00 00 ff ff` are removed before sending, and added back
//! before decompressing. Decompression is limited by `Limits.max_message`, so a decompression bomb
//! fails with 1009 instead of exhausting memory. Each context uses 32 KiB per direction while the
//! connection is open. When a compressed stream ends with a final deflate block, the next message
//! starts a new context.
//!
//! `serve_connection` reads one request on a connection, upgrades it, and replies to each message
//! with what `respond` returns for it. `connect` opens a client session to a `ws` or `wss` URL.
//! `receive`, `send` and `close` work on a session at either end. A client masks each frame with a
//! key drawn from `entropy`.

import std.base64 (base64_decode, base64_encode)
import std.bytes (u16_be, u64_be)
import std.dns
import std.dns (dns)
import std.gzip
import std.hash.legacy (sha1)
import std.http
import std.http (Request, Response)
import std.ip
import std.ip (ip)
import std.list
import std.net
import std.net (Sends, net, send_all)
import std.random (entropy, rand, token_bytes, with_rand)
import std.string
import std.task
import std.url
import std.url (Url)
import std.gen

/// What a frame is.
pub type Opcode = | Continuation | Text | Binary | Close | Ping | Pong

/// A frame as the protocol reads it, unmasked: whether it ends its message, whether its message
/// is compressed (RSV1), what it is, and its payload.
pub type Frame = { fin: Bool, compressed: Bool, opcode: Opcode, payload: Bytes }

/// Size limits for one connection.
pub type Limits = {
  /// Payload bytes in one frame.
  max_frame: Int,
  /// Maximum bytes in one message, counting all its fragments and measured after decompression.
  max_message: Int,
  /// Frames one message is sent in.
  max_fragments: Int,
}

/// Frames of 1 MiB, messages of 4 MiB, and 128 fragments.
pub const default_limits: Limits = { max_frame: 1048576, max_message: 4194304, max_fragments: 128 }

/// The reason a connection fails: the close code to send and a description.
pub type Failure = { code: Int, reason: String }

/// What the front of a buffer contains.
pub type DecodeResult =
  /// Not a whole frame yet.
  | NeedMore
  /// A frame, whether it was masked, and the bytes it took.
  | Got({ frame: Frame, masked: Bool, used: Int })
  /// What the connection is failed with.
  | Invalid(Failure)

fn protocol_error(reason: String) -> Failure = { code: 1002, reason: reason }

fn too_big(reason: String) -> Failure = { code: 1009, reason: reason }

fn opcode_of(n: Int) -> Option<Opcode> =
  match n {
    0 -> Some(Continuation),
    1 -> Some(Text),
    2 -> Some(Binary),
    8 -> Some(Close),
    9 -> Some(Ping),
    10 -> Some(Pong),
    _ -> None,
  }

fn code_of(o: Opcode) -> Int =
  match o { Continuation -> 0, Text -> 1, Binary -> 2, Close -> 8, Ping -> 9, Pong -> 10 }

/// Whether a frame of this kind is a control frame.
pub fn is_control(o: Opcode) -> Bool = o == Close || o == Ping || o == Pong

/// The frame at the front of `head`, read under `limits`; a compressed frame is rejected unless
/// `compression` was negotiated.
pub fn decode_frame(
  frame_bytes: Bytes,
  limits: Limits,
  compression: Bool,
) -> DecodeResult / {abort.raise} =
  if frame_bytes.len() < 2 { NeedMore } else {
    let b0 = frame_bytes.at(0);
    let b1 = frame_bytes.at(1);
    match opcode_of(b0 & 15) {
      None -> Invalid(protocol_error("a reserved opcode")),
      Some(opcode) -> if b0 & 0x30 != 0 { Invalid(protocol_error("a reserved bit is set")) }
      else if b0 & 0x40 != 0 && (!compression || is_control(opcode)) {
        Invalid(protocol_error("a frame is marked compressed with nothing agreed to compress it"))
      } else if is_control(opcode) && (b0 & 0x80 == 0 || b1 & 0x7f > 125) {
        Invalid(protocol_error("a control frame is fragmented or longer than 125 bytes"))
      } else { sized(frame_bytes, b0, b1, opcode, limits) },
    }
  }

fn sized(
  frame_bytes: Bytes,
  b0: Int,
  b1: Int,
  opcode: Opcode,
  limits: Limits,
) -> DecodeResult / {abort.raise} = {
  let short = b1 & 0x7f;
  let length = if short == 126 { frame_bytes.u16_be_at(2) }
  else if short == 127 { frame_bytes.u64_be_at(2) }
  else { Some(short) };
  let header = if short == 126 { 4 } else if short == 127 { 10 } else { 2 };
  let masked = b1 & 0x80 != 0;
  let top = short == 127 && frame_bytes.len() > 2 && frame_bytes.at(2) & 0x80 != 0;
  match length {
    None -> if top { Invalid(protocol_error("a length with its top bit set")) } else { NeedMore },
    Some(n) -> if n < 0 || top { Invalid(protocol_error("a length with its top bit set")) }
    else if (short == 126 && n < 126) || (short == 127 && n < 65536) {
      Invalid(protocol_error("a length not written in its shortest form"))
    } else if n > limits.max_frame { Invalid(too_big("a frame is longer than the limit")) } else {
      let start = header + (if masked { 4 } else { 0 });
      if frame_bytes.len() < start + n { NeedMore } else {
        let raw = frame_bytes.slice(start, start + n);
        let payload = if masked { unmasked(raw, frame_bytes.slice(header, header + 4)) }
        else { raw };
        Got({
          frame: {
            fin: b0 & 0x80 != 0,
            compressed: b0 & 0x40 != 0,
            opcode: opcode,
            payload: payload,
          },
          masked: masked,
          used: start + n,
        })
      }
    },
  }
}

/// `payload` XORed with the four-byte masking key `key`. The same operation masks and unmasks.
pub fn unmasked(payload: Bytes, key: Bytes) -> Bytes / {abort.raise} =
  payload.xor(key.cycle(payload.len()))

/// `f` as wire bytes, masked with `key` when one is given (a client's frames must be masked).
pub fn encode_frame(f: Frame, key: Option<Bytes>) -> Bytes / {abort.raise} = {
  let n = f.payload.len();
  let first = (if f.fin { 0x80 } else { 0 }) | (if f.compressed { 0x40 } else { 0 })
    | code_of(f.opcode);
  let mask_bit = match key { Some(_) -> 0x80, None -> 0 };
  let length = if n < 126 { byte_of_int(mask_bit | n) }
  else if n < 65536 { byte_of_int(mask_bit | 126).concat(u16_be(n)) }
  else { byte_of_int(mask_bit | 127).concat(u64_be(n)) };
  match key {
    Some(k) -> Bytes::concat_all([byte_of_int(first), length, k, unmasked(f.payload, k)]),
    None -> Bytes::concat_all([byte_of_int(first), length, f.payload]),
  }
}

/// Which end of a connection this is.
pub type Role = | Server | Client

/// A whole message.
pub type Message = | TextMessage(String) | BinaryMessage(Bytes)

type Partial = { opcode: Opcode, parts: List<Bytes>, size: Int, count: Int, compressed: Bool }

/// Whether each end reuses its compression context for the next message instead of starting a new
/// one, as permessage-deflate negotiated (RFC 7692 §7.1.1).
pub type ContextTakeover = { server: Bool, client: Bool }

/// One end of a connection, as `handle_frame` leaves it.
pub type State = {
  role: Role,
  limits: Limits,
  /// What permessage-deflate negotiated, if it was negotiated.
  compression: Option<ContextTakeover>,
  /// The context this end compresses its messages in, or `None` when each message starts a new
  /// context.
  deflater: Option<gzip::Writer>,
  /// The context the peer's messages are decompressed in, or `None` when the peer starts a new
  /// context for each message.
  inflater: Option<gzip::Reader>,
  partial: Option<Partial>,
  /// This end has sent its close.
  closing: Bool,
  /// The close handshake is over, or the connection failed: nothing more is read.
  closed: Bool,
}

/// Returns the state of a connection before any frame has arrived. `role` is this end's role,
/// `limits` bounds incoming messages, and `compression` is the negotiated permessage-deflate
/// setting, or `None` when compression is off.
pub fn initial_state(role: Role, limits: Limits, compression: Option<ContextTakeover>) -> State =
  {
    role: role,
    limits: limits,
    compression: compression,
    deflater: None,
    inflater: None,
    partial: None,
    closing: false,
    closed: false,
  }

/// Describes what a received frame means to the application: a message, a ping, a pong, a close or
/// a failure.
pub type Event =
  /// A complete message, assembled from its fragments if it was sent in several frames.
  | Received(Message)
  /// A ping; the replies include a pong for it.
  | Pinged(Bytes)
  | Ponged(Bytes)
  /// The peer closed with this code and reason (1005 for a close with no code). The replies
  /// include a close in response unless this end had closed first.
  | ClosedBy({ code: Int, reason: String })
  /// The connection failed: a close with the failure's code is among the replies.
  | Failed(Failure)

/// What `handle_frame` returns: the state after the frame, what it meant, and the frames to send
/// back.
pub type Step = { state: State, events: List<Event>, replies: List<Frame> }

/// Returns the close frame for `code` and `reason`. For code 1005, which means no code was given,
/// the payload is empty and `reason` is dropped.
pub fn close_frame(code: Int, reason: String) -> Frame =
  {
    fin: true,
    compressed: false,
    opcode: Close,
    payload: if code == 1005 { b"" } else { u16_be(code).concat(Bytes::of_string(reason)) },
  }

fn failed(s: State, f: Failure) -> Step =
  {
    state: { ..s, closing: true, closed: true, partial: None },
    events: [Failed(f)],
    replies: [close_frame(f.code, f.reason)],
  }

/// What `f`, the next frame the peer sent, means to `s`.
pub fn handle_frame(s: State, f: Frame, masked: Bool) -> Step / {abort.raise} =
  if s.closed { { state: s, events: [], replies: [] } } else if masked != (s.role == Server) {
    failed(
      s,
      protocol_error(if masked { "a server's frame is masked" }
      else { "a client's frame is not masked" }),
    )
  } else {
    match f.opcode {
      Ping ->
        {
          state: s,
          events: [Pinged(f.payload)],
          replies: [{ fin: true, compressed: false, opcode: Pong, payload: f.payload }],
        },
      Pong -> { state: s, events: [Ponged(f.payload)], replies: [] },
      Close -> handle_close(s, f.payload),
      Continuation -> match s.partial {
        None -> failed(s, protocol_error("a continuation with no message to continue")),
        Some(p) -> if f.compressed { failed(s, protocol_error("a continuation marked compressed")) }
        else {
          gathered(
            s,
            {
              ..p,
              parts: p.parts.push(f.payload),
              size: p.size + f.payload.len(),
              count: p.count + 1,
            },
            f.fin,
          )
        },
      },
      _ -> match s.partial {
        Some(_) -> failed(s, protocol_error("a new message inside a fragmented one")),
        None ->
          gathered(
            s,
            {
              opcode: f.opcode,
              parts: [f.payload],
              size: f.payload.len(),
              count: 1,
              compressed: f.compressed,
            },
            f.fin,
          ),
      },
    }
  }

fn gathered(s: State, p: Partial, fin: Bool) -> Step / {abort.raise} =
  if p.size > s.limits.max_message { failed(s, too_big("a message is longer than the limit")) }
  else if p.count > s.limits.max_fragments {
    failed(s, too_big("a message is in more fragments than the limit"))
  } else if !fin { { state: { ..s, partial: Some(p) }, events: [], replies: [] } } else {
    let whole = Bytes::concat_all(p.parts);
    match if p.compressed { inflated(s, whole) }
      else { Ok({ bytes: whole, inflater: s.inflater }) } {
      Err(reason) -> failed({ ..s, partial: None }, reason),
      Ok(read) -> {
        let next = { ..s, partial: None, inflater: read.inflater };
        match p.opcode {
          Text -> match utf8(read.bytes) {
            Some(text) -> { state: next, events: [Received(TextMessage(text))], replies: [] },
            None -> failed(next, { code: 1007, reason: "a text message is not UTF-8" }),
          },
          _ -> { state: next, events: [Received(BinaryMessage(read.bytes))], replies: [] },
        }
      },
    }
  }

fn utf8(b: Bytes) -> Option<String> =
  match try[abort.raise] { String::of_bytes(b) } { Ok(t) -> Some(t), Err(_) -> None }

/// Returns whether an endpoint may send `code` in a close frame: 1000 to 1003, 1007 to 1014, or the
/// registered and private range 3000 to 4999.
pub fn sendable_code(code: Int) -> Bool =
  (code >= 1000 && code <= 1003) || (code >= 1007 && code <= 1014) || (code >= 3000 && code <= 4999)

fn handle_close(s: State, payload: Bytes) -> Step / {abort.raise} =
  if payload.len() == 1 { failed(s, protocol_error("a close of one byte")) } else {
    let code = if payload.len() == 0 { 1005 }
    else { match payload.u16_be_at(0) { Some(n) -> n, None -> 1005 } };
    let reason = utf8(payload.slice(if payload.len() == 0 { 0 } else { 2 }, payload.len()));
    if code != 1005 && !sendable_code(code) {
      failed(s, protocol_error("a close code no endpoint may send"))
    } else {
      match reason {
        None -> failed(s, { code: 1007, reason: "a close reason is not UTF-8" }),
        Some(text) ->
          {
            state: { ..s, closing: true, closed: true, partial: None },
            events: [ClosedBy({ code: code, reason: text })],
            replies: if s.closing { [] }
            else { [close_frame(if code == 1005 { 1005 } else { code }, "")] },
          },
      }
    }
  }

const flush_tail: Bytes = b"\x00\x00\xff\xff"

fn retains_context(s: State, c: ContextTakeover) -> Bool =
  match s.role { Server -> c.server, Client -> c.client }

fn peer_retains_context(s: State, c: ContextTakeover) -> Bool =
  match s.role { Server -> c.client, Client -> c.server }

fn inflated(
  s: State,
  data: Bytes,
) -> Result<{ bytes: Bytes, inflater: Option<gzip::Reader> }, Failure> / {abort.raise} = {
  let limit = s.limits.max_message;
  let start = match s.inflater {
    Some(r) -> gzip::allowing(r, limit),
    None -> gzip::reader(gzip::Deflate, limit),
  };
  let read: Result<{ bytes: Bytes, after: gzip::Reader }, gzip::Error> = try {
    let body = gzip::read(start, data);
    if gzip::ended(body.next) { { bytes: body.out, after: body.next } } else {
      let tail = gzip::read(body.next, flush_tail);
      { bytes: body.out.concat(tail.out), after: tail.next }
    }
  };
  match read {
    Ok(got) ->
      Ok({
        bytes: got.bytes,
        inflater: match s.compression {
          Some(c) -> if peer_retains_context(s, c) && !gzip::ended(got.after) { Some(got.after) }
          else { None },
          None -> None,
        },
      }),
    Err(r) ->
      Err(if r.reason == gzip::OverLimit { too_big("a message decompresses past the limit") }
      else { { code: 1007, reason: "a compressed message does not decompress" } }),
  }
}

/// Returns the frame that carries message `m`, compressed if permessage-deflate was negotiated,
/// together with the state updated with this end's compression state.
pub fn message_frame(s: State, m: Message) -> { state: State, frame: Frame } / {abort.raise} = {
  let plain = match m { TextMessage(t) -> Bytes::of_string(t), BinaryMessage(b) -> b };
  let opcode = match m { TextMessage(_) -> Text, BinaryMessage(_) -> Binary };
  match s.compression {
    None -> { state: s, frame: { fin: true, compressed: false, opcode: opcode, payload: plain } },
    Some(c) -> {
      let start = match s.deflater { Some(w) -> w, None -> gzip::writer(gzip::Deflate) };
      let took = gzip::write(start, plain, gzip::Deflate);
      let flushed = gzip::flush(took.next, gzip::Deflate);
      let all = took.out.concat(flushed.out);
      {
        state: { ..s, deflater: if retains_context(s, c) { Some(flushed.next) } else { None } },
        frame: {
          fin: true,
          compressed: true,
          opcode: opcode,
          payload: all.slice(0, all.len() - flush_tail.len()),
        },
      }
    },
  }
}

const guid: String = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"

/// The `Sec-WebSocket-Accept` value a server returns for the key `key`.
pub fn accept_key(key: String) -> String / {abort.raise} =
  base64_encode(sha1(Bytes::of_string(key ++ guid)))

fn deflate_field(c: ContextTakeover) -> String =
  "permessage-deflate" ++ (if c.server { "" } else { "; server_no_context_takeover" })
    ++ (if c.client { "" } else { "; client_no_context_takeover" })

/// What this end supports, and its limits.
pub type Options = {
  /// Subprotocols in the order this end prefers them.
  protocols: List<String>,
  /// Whether permessage-deflate is offered or accepted.
  compression: Bool,
  /// Whether either end may keep its compression context from one message to the next: 32 KiB per
  /// direction per connection, so messages compress against the ones before them.
  takeover: Bool,
  limits: Limits,
  /// The longest wait for the next frame.
  idle_timeout_ms: Int,
  /// How many messages are handled on one connection before it is closed.
  max_messages: Int,
}

/// Returns the default options: no subprotocols, compression enabled and compression state retained
/// between messages, `default_limits`, an idle timeout of 60 seconds, and at most 10000 messages
/// per connection.
pub const default_options: Options =
  {
    protocols: [],
    compression: true,
    takeover: true,
    limits: default_limits,
    idle_timeout_ms: 60000,
    max_messages: 10000,
  }

/// What a server agreed to in its `101`: a subprotocol, and permessage-deflate's context settings
/// if it accepted that.
pub type Agreement = { protocol: Option<String>, compression: Option<ContextTakeover> }

/// The server's response to an upgrade request.
pub type Upgrade =
  /// The written `101` that switches the connection, and what it agreed to.
  | Accept({ head: Bytes, negotiated: Agreement })
  /// The response that rejects it.
  | Reject(Response<| {}>)

fn tokens(headers: http::Headers, name: String) -> List<String> =
  http::header_lines(headers, name).fold([], |accumulator: List<String>, line: String|
    line.split(",").fold(accumulator, |inner: List<String>, part: String| {
      let t = part.ascii_trim();
      if t.len() == 0 { inner } else { inner.push(t) }
    }))

fn has_token(headers: http::Headers, name: String, token: String) -> Bool =
  tokens(headers, name).any(|t: String| t.eq_ignore_ascii_case(token))

fn deflate_offer(headers: http::Headers) -> Option<List<String>> =
  tokens(headers, "sec-websocket-extensions").fold(
    None,
    |found: Option<List<String>>, offer: String|
      match found {
        Some(_) -> found,
        None -> match offer.split(";").map(|p: String| p.ascii_trim().ascii_lower()) {
          [first, ..params] -> if first == "permessage-deflate"
              && params.all(is_supported_parameter) { Some(params) }
          else { None },
          [] -> None,
        },
      },
  )

fn is_supported_parameter(param: String) -> Bool =
  param == "server_no_context_takeover" || param == "client_no_context_takeover"
    || param == "server_max_window_bits=15"
    || param.starts_with("client_max_window_bits")

/// The response to `request` from a server configured by `options`.
pub fn upgrade(request: Request, options: Options) -> Upgrade / {abort.raise} = {
  let h = request.headers;
  let key = match http::header(h, "sec-websocket-key") { Some(k) -> k.ascii_trim(), None -> "" };
  let key_reads = match base64_decode(key) { Some(b) -> b.len() == 16, None -> false };
  if request.method != http::Get || request.version != http::Http11
      || !has_token(h, "upgrade", "websocket")
      || !has_token(h, "connection", "upgrade")
      || !key_reads { Reject(http::text_response(400, "this is not a WebSocket handshake\n")) }
  else if http::header(h, "sec-websocket-version") != Some("13") {
    let r = http::text_response(426, "this server speaks WebSocket version 13\n");
    Reject({ ..r, headers: http::set_header(r.headers, "sec-websocket-version", "13") })
  } else {
    let offered = tokens(h, "sec-websocket-protocol");
    let protocol = offered.fold(None, |chosen: Option<String>, p: String|
      match chosen {
        Some(_) -> chosen,
        None -> if options.protocols.contains(p) { Some(p) } else { None },
      });
    let compression = if !options.compression { None } else {
      match deflate_offer(h) {
        None -> None,
        Some(params) ->
          Some({
            server: options.takeover && !params.contains("server_no_context_takeover"),
            client: options.takeover && !params.contains("client_no_context_takeover"),
          }),
      }
    };
    let lines = [
      "HTTP/1.1 101 Switching Protocols\r\n",
      "Upgrade: websocket\r\n",
      "Connection: Upgrade\r\n",
      "Sec-WebSocket-Accept: " ++ accept_key(key) ++ "\r\n",
      match protocol { Some(p) -> "Sec-WebSocket-Protocol: " ++ p ++ "\r\n", None -> "" },
      match compression {
        Some(c) -> "Sec-WebSocket-Extensions: " ++ deflate_field(c) ++ "\r\n",
        None -> "",
      },
      "\r\n",
    ];
    Accept({
      head: Bytes::of_string(String::join(lines, "")),
      negotiated: { protocol: protocol, compression: compression },
    })
  }
}

/// A client's opening request to `target` at `authority` under `key` (sixteen bytes in base64).
pub fn handshake(authority: String, target: String, key: String, options: Options) -> Bytes = {
  let lines = [
    "GET " ++ target ++ " HTTP/1.1\r\n",
    "Host: " ++ authority ++ "\r\n",
    "Upgrade: websocket\r\n",
    "Connection: Upgrade\r\n",
    "Sec-WebSocket-Key: " ++ key ++ "\r\n",
    "Sec-WebSocket-Version: 13\r\n",
    match options.protocols {
      [] -> "",
      ps -> "Sec-WebSocket-Protocol: " ++ String::join(ps, ", ") ++ "\r\n",
    },
    if options.compression {
      "Sec-WebSocket-Extensions: "
        ++ deflate_field({ server: options.takeover, client: options.takeover })
        ++ "\r\n"
    } else { "" },
    "\r\n",
  ];
  Bytes::of_string(String::join(lines, ""))
}

/// Checks a server's response to the client handshake and returns what the server agreed to, or a
/// message saying why the response is not a valid `101`. Reasons include a wrong status or accept
/// key, a subprotocol or extension the client did not offer, and permessage-deflate parameters the
/// client cannot support or that retain compression state the client asked the server not to
/// retain.
pub fn check_response(
  head: http::ResponseHead,
  key: String,
  options: Options,
) -> Result<Agreement, String> / {abort.raise} = {
  let h = head.headers;
  let protocol = http::header(h, "sec-websocket-protocol");
  let extensions = tokens(h, "sec-websocket-extensions");
  let deflates = extensions.filter(|e: String| e.ascii_lower().starts_with("permessage-deflate"));
  let params = match deflates {
    [one] -> one.split(";").map(|p: String| p.ascii_trim().ascii_lower()).drop(1),
    _ -> [],
  };
  let server_none = params.contains("server_no_context_takeover");
  let client_none = params.contains("client_no_context_takeover");
  if head.status != 101 { Err("the server responded " ++ head.status.to_string()) }
  else if !has_token(h, "upgrade", "websocket") || !has_token(h, "connection", "upgrade") {
    Err("the response does not switch to WebSocket")
  } else if http::header(h, "sec-websocket-accept") != Some(accept_key(key)) {
    Err("the accept key is not this request's")
  } else if match protocol { Some(p) -> !options.protocols.contains(p), None -> false } {
    Err("a subprotocol that was not offered")
  } else if deflates.len() > 1 || extensions.len() > deflates.len() {
    Err("an extension that was not offered")
  } else if deflates != [] && !options.compression { Err("compression that was not offered") }
  else if params.any(|p: String|
      p != "server_no_context_takeover" && p != "client_no_context_takeover"
        && !p.starts_with("server_max_window_bits")) {
    Err("compression with a parameter this client cannot honour")
  } else if deflates != [] && !options.takeover && (!server_none || !client_none) {
    Err("compression that keeps a context this client asked it not to")
  } else {
    Ok({
      protocol: protocol,
      compression: if deflates == [] { None }
      else { Some({ server: !server_none, client: !client_none }) },
    })
  }
}

/// One end of an open connection: its handle, its state, and the bytes read past the last frame.
pub type Session = { connection: Int, state: State, buffer: Bytes, negotiated: Agreement }

/// The outcome of `receive`: a message, or the reason there is none.
pub type Got =
  | Message(Message)
  /// The close handshake ended, with the peer's code and reason.
  | Closed({ code: Int, reason: String })
  /// The connection failed, and a close saying why was sent.
  | Failure(Failure)
  /// Nothing came within the wait.
  | TimedOut
  /// The peer went away without closing.
  | Gone

fn frame_budget(limits: Limits) -> Int = limits.max_fragments + 256

/// The next message on `s`, replying to pings and to a close along the way. Each read waits at
/// most `timeout_ms`.
pub fn receive<[l]>(
  s: Session,
  timeout_ms: Int,
) -> { session: Session, got: Got } / {net.recv[l], net.send[l], entropy.next, abort.raise} = {
  let budget = frame_budget(s.state.limits) * 2;
  iterate(
    { session: s, got: None, left: budget },
    budget + 2,
    |r: { session: Session, got: Option<Got>, left: Int }|
      match r.got {
        Some(g) -> Stop({ session: r.session, got: g }),
        None -> if r.left <= 0 {
          let f = { code: 1008, reason: "too many frames without a message" };
          send_frames[l](r.session, [close_frame(f.code, f.reason)], timeout_ms);
          Stop({
            session: { ..r.session, state: { ..r.session.state, closed: true, closing: true } },
            got: Failure(f),
          })
        } else {
          let next = receive_step[l](r.session, timeout_ms);
          Continue({ session: next.session, got: next.got, left: r.left - 1 })
        },
      },
  )
}

fn receive_step<[l]>(
  s: Session,
  timeout_ms: Int,
) -> { session: Session, got: Option<Got> } / {net.recv[l], net.send[l], entropy.next, abort.raise} =
  if s.state.closed { { session: s, got: Some(Closed({ code: 1006, reason: "" })) } } else {
    match decode_frame(s.buffer, s.state.limits, s.state.compression != None) {
      Invalid(f) -> {
        send_frames[l](s, [close_frame(f.code, f.reason)], timeout_ms);
        {
          session: { ..s, state: { ..s.state, closed: true, closing: true } },
          got: Some(Failure(f)),
        }
      },
      NeedMore -> match net.recv[l](s.connection, http::read_size, timeout_ms) {
        None -> { session: s, got: Some(TimedOut) },
        Some(chunk) -> if chunk.len() == 0 { { session: s, got: Some(Gone) } }
        else { { session: { ..s, buffer: s.buffer.concat(chunk) }, got: None } },
      },
      Got(g) -> {
        let step = handle_frame(s.state, g.frame, g.masked);
        send_frames[l](s, step.replies, timeout_ms);
        let next = { ..s, state: step.state, buffer: s.buffer.slice(g.used, s.buffer.len()) };
        { session: next, got: receive_result_of(step.events) }
      },
    }
  }

fn receive_result_of(events: List<Event>) -> Option<Got> =
  events.fold(None, |g: Option<Got>, e: Event|
    match g {
      Some(_) -> g,
      None -> match e {
        Received(m) -> Some(Message(m)),
        ClosedBy(c) -> Some(Closed(c)),
        Failed(f) -> Some(Failure(f)),
        _ -> None,
      },
    })

fn send_frames<[l]>(
  s: Session,
  frames: List<Frame>,
  timeout_ms: Int,
) -> Bool / {net.send[l], entropy.next, abort.raise} =
  frames.fold(true, |ok: Bool, f: Frame|
    ok
      && send_all[l](
        s.connection,
        encode_frame(f, match s.state.role { Client -> Some(token_bytes(4)), Server -> None }),
        timeout_ms,
      ))

/// Sends `m` on `s`. Returns the session after it, with its compression context advanced, and
/// whether the send succeeded.
pub fn send<[l]>(
  s: Session,
  m: Message,
  timeout_ms: Int,
) -> { session: Session, sent: Bool } / {net.send[l], entropy.next, abort.raise} =
  if s.state.closing { { session: s, sent: false } } else {
    let made = message_frame(s.state, m);
    let next = { ..s, state: made.state };
    { session: next, sent: send_frames[l](next, [made.frame], timeout_ms) }
  }

/// Sends a close with `code` and `reason`; the peer's close is read with `receive`.
pub fn close<[l]>(
  s: Session,
  code: Int,
  reason: String,
  timeout_ms: Int,
) -> Session / {net.send[l], entropy.next, abort.raise} =
  if s.state.closing { s } else {
    send_frames[l](s, [close_frame(code, reason)], timeout_ms);
    { ..s, state: { ..s.state, closing: true } }
  }

/// Reads one request on connection `c`, then either upgrades it to a WebSocket as `options` specify
/// or sends a response saying why it cannot. After an upgrade, replies to each received message
/// with the messages `respond` returns, up to `options.max_messages`. Closes the connection however
/// this ends.
pub fn serve_connection<[l] | e>(
  c: Int,
  limits: http::Limits,
  options: Options,
  respond: (Message) -> List<Message> / e,
) -> Unit / {net.recv[l], net.send[l], net.close[l], entropy.next, abort.raise | e} =
  bracket(|| c, |h: Int| net.close[l](h), |h: Int|
    match http::read_head[l](h, b"", limits, false) {
      http::HeadBytes(got) -> match http::parse_head(got.head, limits) {
        http::Parsed(head) -> match upgrade(head.request, options) {
          Reject(r) -> {
            send_all[l](
              h,
              http::encode(head.request.method, head.request.version, false, r),
              limits.write_timeout_ms,
            );
            ()
          },
          Accept(u) -> if send_all[l](h, u.head, limits.write_timeout_ms) {
            serve_messages[l](
              {
                connection: h,
                state: initial_state(Server, options.limits, u.negotiated.compression),
                buffer: got.head.slice(head.consumed, got.head.len()),
                negotiated: u.negotiated,
              },
              options,
              respond,
              options.max_messages,
            )
          } else { () },
        },
        http::HeadRejected(r) -> {
          send_all[l](
            h,
            http::encode(http::Get, http::Http11, false, http::error_response(r)),
            limits.write_timeout_ms,
          );
          ()
        },
        http::Incomplete -> (),
      },
      _ -> (),
    })

fn serve_messages<[l] | e>(
  s: Session,
  options: Options,
  respond: (Message) -> List<Message> / e,
  left: Int,
) -> Unit / {net.recv[l], net.send[l], entropy.next, abort.raise | e} =
  if left <= 0 {
    close[l](s, 1008, "this connection reached its limit on messages", options.idle_timeout_ms);
    ()
  } else {
    let r = receive[l](s, options.idle_timeout_ms);
    match r.got {
      Message(m) -> {
        let returned = respond(m).fold(
          { session: r.session, sent: true },
          |at: { session: Session, sent: Bool }, out: Message|
            if at.sent { send[l](at.session, out, options.idle_timeout_ms) } else { at },
        );
        serve_messages[l](returned.session, options, respond, left - 1)
      },
      TimedOut -> {
        close[l](r.session, 1001, "idle", options.idle_timeout_ms);
        ()
      },
      _ -> (),
    }
  }

/// The reasons `connect` can fail to return a session.
pub type ConnectError =
  /// The URL is not `ws` or `wss` with a host.
  | NotWebSocket(String)
  /// No connection was made, or it was not secured.
  | NoConnection(net::Error)
  /// The server's response was not a valid `101` for this request. The String gives the reason.
  | Declined(String)

/// Opens a client session to the URL `to`, over TCP for `ws` and over TLS for `wss`, using the
/// WebSocket `options` and the HTTP `limits`. Fails with a `ConnectError` when the URL is not a
/// WebSocket URL, the connection fails, or the server's response is not a valid handshake.
pub fn connect<[l]>(
  to: Url,
  options: Options,
  limits: http::Limits,
) -> Result<Session, ConnectError> / {dns.lookup, net.connect_to[l], net.start_tls[l], net.send[l], net.recv[l], net.close[l], task.write, clock.read, clock.write, task::deadline.at, entropy.next, abort.raise} = {
  let scheme = url::url_scheme(to);
  let host = match url::url_host(to) {
    Some(url::Name(n)) -> Some(n),
    Some(url::V4(a)) -> Some(ip::render(ip::V4(a))),
    Some(url::V6(a)) -> Some(ip::render(ip::V6(a))),
    None -> None,
  };
  let port = match url::url_port(to) {
    Some(p) -> Some(p),
    None -> if scheme == "wss" { Some(443) } else { Some(80) },
  };
  match ((host, port, url::url_host_port(to))) {
    (Some(h), Some(p), Some(authority)) -> if scheme != "ws" && scheme != "wss" {
      Err(NotWebSocket(url::url_redacted(to)))
    } else {
      let initial_state: Result<Int, net::Error> = if scheme == "wss" {
        try { net::dial_tls[l](h, p, ["http/1.1"], [], limits.connect_timeout_ms) }
      } else { try { net::dial[l](h, p, [], limits.connect_timeout_ms) } };
      match initial_state {
        Err(reason) -> Err(NoConnection(reason)),
        Ok(c) -> {
          let target = (if url::url_path(to) == "" { "/" } else { url::url_path(to) })
            ++ (match url::url_query(to) { Some(q) -> "?" ++ q, None -> "" });
          let key = base64_encode(token_bytes(16));
          let returned = finish_handshake[l](c, authority, target, key, options, limits);
          match returned { Err(_) -> net.close[l](c), Ok(_) -> () };
          returned
        },
      }
    },
    _ -> Err(NotWebSocket(url::url_redacted(to))),
  }
}

fn finish_handshake<[l]>(
  c: Int,
  authority: String,
  target: String,
  key: String,
  options: Options,
  limits: http::Limits,
) -> Result<Session, ConnectError> / {net.send[l], net.recv[l], abort.raise} =
  if !send_all[l](c, handshake(authority, target, key, options), limits.write_timeout_ms) {
    Err(Declined("the request was not sent"))
  } else {
    match http::read_head[l](c, b"", limits, false) {
      http::HeadBytes(got) -> match http::parse_response_head(got.head, http::Get, limits) {
        http::ResponseParsed(head) -> match check_response(head, key, options) {
          Ok(agreed) ->
            Ok({
              connection: c,
              state: initial_state(Client, options.limits, agreed.compression),
              buffer: got.head.slice(head.consumed, got.head.len()),
              negotiated: agreed,
            }),
          Err(reason) -> Err(Declined(reason)),
        },
        _ -> Err(Declined("the response is not HTTP")),
      },
      _ -> Err(Declined("no response came")),
    }
  }

fn frame(fin: Bool, opcode: Opcode, payload: Bytes) -> Frame =
  { fin: fin, compressed: false, opcode: opcode, payload: payload }

fn text(t: String) -> Frame = frame(true, Text, Bytes::of_string(t))

fn key() -> Bytes = b"\x37\xfa\x21\x3d"

const hello: Bytes = b"Hello"

fn bytes_of(n: Int) -> Bytes =
  Bytes::of_string(range(0, n).fold("", |accumulator: String, _i: Int| accumulator ++ "x"))

test "RFC 6455's example frames are read and written as it writes them: {c.what}" for c: { what: String, wire: Bytes, frame: Frame, key: Option<Bytes> } in [
    { what: "a text frame", wire: b"\x81\x05Hello", frame: text("Hello"), key: None },
    {
      what: "a masked text frame",
      wire: b"\x81\x85\x37\xfa\x21\x3d\x7f\x9f\x4d\x51\x58",
      frame: text("Hello"),
      key: Some(key()),
    },
    {
      what: "a first fragment",
      wire: b"\x01\x03Hel",
      frame: frame(false, Text, b"Hel"),
      key: None,
    },
    {
      what: "a last fragment",
      wire: b"\x80\x02lo",
      frame: frame(true, Continuation, b"lo"),
      key: None,
    },
    { what: "a ping", wire: b"\x89\x05Hello", frame: frame(true, Ping, hello), key: None },
    {
      what: "a masked pong",
      wire: b"\x8a\x85\x37\xfa\x21\x3d\x7f\x9f\x4d\x51\x58",
      frame: frame(true, Pong, hello),
      key: Some(key()),
    },
    {
      what: "256 bytes in a 16-bit length",
      wire: b"\x82\x7e\x01\x00".concat(bytes_of(256)),
      frame: frame(true, Binary, bytes_of(256)),
      key: None,
    },
    {
      what: "64 KiB in a 64-bit length",
      wire: b"\x82\x7f\x00\x00\x00\x00\x00\x01\x00\x00".concat(bytes_of(65536)),
      frame: frame(true, Binary, bytes_of(65536)),
      key: None,
    },
  ] {
  assert_eq(encode_frame(c.frame, c.key), c.wire);
  assert_eq(
    decode_frame(c.wire, default_limits, false),
    Got({ frame: c.frame, masked: c.key != None, used: c.wire.len() }),
  );
  assert_eq(decode_frame(c.wire.slice(0, c.wire.len() - 1), default_limits, false), NeedMore)
}

test "a length not in its shortest form, or with its top bit set, is a protocol error" {
  assert_eq(
    decode_frame(b"\x82\x7e\x00\x05Hello", default_limits, false),
    Invalid({ code: 1002, reason: "a length not written in its shortest form" }),
  );
  assert_eq(
    decode_frame(b"\x82\x7f\x80\x00\x00\x00\x00\x00\x00\x05Hello", default_limits, false),
    Invalid({ code: 1002, reason: "a length with its top bit set" }),
  )
}

test "a frame reads back as it was written, masked or not" {
  gen::check3(gen::bytes(), gen::bool(), gen::bool(), |payload: Bytes, masked: Bool, fin: Bool| {
    let f = frame(fin, Binary, payload);
    let wire = encode_frame(f, if masked { Some(key()) } else { None });
    decode_frame(wire, default_limits, false) == Got({ frame: f, masked: masked, used: wire.len() })
  })
}

fn opening(extra: String) -> Bytes =
  Bytes::of_string(
    "GET /chat HTTP/1.1\r\nHost: server.example.com\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n"
      ++ extra
      ++ "\r\n",
  )

fn request_of(raw: Bytes) -> Request / {abort.raise} =
  match http::parse_head(raw, http::default_limits) {
    http::Parsed(h) -> h.request,
    _ -> panic("a request head"),
  }

test "the server's key is the one RFC 6455 derives from the client's" {
  assert_eq(accept_key("dGhlIHNhbXBsZSBub25jZQ=="), "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=")
}

test "a valid handshake gets a 101 response that selects the first shared subprotocol and enables compression" {
  let options = { ..default_options, protocols: ["chat", "superchat"] };
  match upgrade(
      request_of(
        opening(
          "Sec-WebSocket-Protocol: superchat, chat\r\nSec-WebSocket-Extensions: permessage-deflate; client_max_window_bits\r\n",
        ),
      ),
      options,
    ) {
    Accept(u) -> {
      assert_eq(u.negotiated, {
        protocol: Some("superchat"),
        compression: Some({ server: true, client: true }),
      });
      assert_eq(
        u.head,
        b"HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\nSec-WebSocket-Protocol: superchat\r\nSec-WebSocket-Extensions: permessage-deflate\r\n\r\n",
      )
    },
    Reject(_) -> panic("the handshake is one"),
  }
}

test "`upgrade` rejects a request that is not a valid WebSocket handshake with status 400, or 426 for an unsupported protocol version: {c.what}" for c: { what: String, raw: Bytes, status: Int } in [
    {
      what: "no Upgrade",
      raw: b"GET / HTTP/1.1\r\nHost: x\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n",
      status: 400,
    },
    {
      what: "a key of the wrong length",
      raw: b"GET / HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: AAAA\r\nSec-WebSocket-Version: 13\r\n\r\n",
      status: 400,
    },
    {
      what: "a POST",
      raw: b"POST / HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nContent-Length: 0\r\n\r\n",
      status: 400,
    },
    {
      what: "version 8",
      raw: b"GET / HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 8\r\n\r\n",
      status: 426,
    },
  ] {
  match upgrade(request_of(c.raw), default_options) {
    Reject(r) -> {
      assert_eq(r.status, c.status);
      assert_eq(http::header(r.headers, "sec-websocket-version"), if c.status == 426 { Some("13") }
      else { None })
    },
    Accept(_) -> panic("no switch"),
  }
}

fn result_head(extra: String) -> http::ResponseHead / {abort.raise} =
  match http::parse_response_head(
      Bytes::of_string(
        "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\n"
          ++ extra
          ++ "\r\n",
      ),
      http::Get,
      http::default_limits,
    ) {
    http::ResponseParsed(h) -> h,
    _ -> panic("a response head"),
  }

test "a client accepts a 101 that matches its request, and nothing else: {c.what}" for c: { what: String, extra: String, negotiated: Result<Agreement, String> } in [
    { what: "a plain switch", extra: "", negotiated: Ok({ protocol: None, compression: None }) },
    {
      what: "a subprotocol offered",
      extra: "Sec-WebSocket-Protocol: chat\r\n",
      negotiated: Ok({ protocol: Some("chat"), compression: None }),
    },
    {
      what: "a subprotocol not offered",
      extra: "Sec-WebSocket-Protocol: other\r\n",
      negotiated: Err("a subprotocol that was not offered"),
    },
    {
      what: "compression whose server keeps no context",
      extra: "Sec-WebSocket-Extensions: permessage-deflate; server_no_context_takeover\r\n",
      negotiated: Ok({ protocol: None, compression: Some({ server: false, client: true }) }),
    },
    {
      what: "compression that keeps context both ways",
      extra: "Sec-WebSocket-Extensions: permessage-deflate\r\n",
      negotiated: Ok({ protocol: None, compression: Some({ server: true, client: true }) }),
    },
    {
      what: "compression with a server window of its own",
      extra: "Sec-WebSocket-Extensions: permessage-deflate; server_max_window_bits=10\r\n",
      negotiated: Ok({ protocol: None, compression: Some({ server: true, client: true }) }),
    },
    {
      what: "compression that bounds the client's window, which this client did not offer",
      extra: "Sec-WebSocket-Extensions: permessage-deflate; client_max_window_bits=10\r\n",
      negotiated: Err("compression with a parameter this client cannot honour"),
    },
    {
      what: "an extension not offered",
      extra: "Sec-WebSocket-Extensions: x-webkit-deflate-frame\r\n",
      negotiated: Err("an extension that was not offered"),
    },
  ] {
  let options = { ..default_options, protocols: ["chat"] };
  assert_eq(check_response(result_head(c.extra), "dGhlIHNhbXBsZSBub25jZQ==", options), c.negotiated)
}

test "with `takeover` off, the client handshake offers `server_no_context_takeover` and `client_no_context_takeover`, and `check_response` rejects a server response without `client_no_context_takeover`" {
  let options = { ..default_options, takeover: false };
  assert(
    handshake("x", "/", "dGhlIHNhbXBsZSBub25jZQ==", options).index_of(
        b"Sec-WebSocket-Extensions: permessage-deflate; server_no_context_takeover; client_no_context_takeover\r\n",
      )
      != None,
  );
  assert_eq(
    check_response(
      result_head("Sec-WebSocket-Extensions: permessage-deflate; server_no_context_takeover\r\n"),
      "dGhlIHNhbXBsZSBub25jZQ==",
      options,
    ),
    Err("compression that keeps a context this client asked it not to"),
  )
}

test "an accept key for another request is rejected" {
  assert_eq(
    check_response(result_head(""), "AQIDBAUGBwgJCgsMDQ4PEA==", default_options),
    Err("the accept key is not this request's"),
  )
}

const small_limit_options: Options =
  { ..default_options, limits: { max_frame: 64, max_message: 128, max_fragments: 4 } }

fn echoed(extra: String, frames: Bytes, options: Options) -> Bytes / {ip.fail, abort.raise} = {
  let left = with_rand(rand(7), ||
    net::on_mem(
      net::mem_calling(net::mem_empty(), ip::read_socket("198.51.100.4:5000"), [
        Sends(opening(extra).concat(frames)),
      ]),
      || {
        let listener = net.listen[listener](0);
        serve_connection[conn](
          net.accept[listener](listener),
          http::default_limits,
          options,
          |m: Message| [m],
        )
      },
    ).net).value;
  let wrote = net::mem_sent(left, 2);
  match wrote.index_of(b"\r\n\r\n") { Some(at) -> wrote.slice(at + 4, wrote.len()), None -> wrote }
}

fn client_says(frames: List<Frame>) -> Bytes / {abort.raise} =
  Bytes::concat_all(frames.map(|f: Frame| encode_frame(f, Some(key()))))

fn server_says(frames: List<Frame>) -> Bytes / {abort.raise} =
  Bytes::concat_all(frames.map(|f: Frame| encode_frame(f, None)))

fn closing(code: Int) -> Frame = close_frame(code, "")

fn closed_on(code: Int, reason: String) -> Frame = close_frame(code, reason)

const invalid_utf8: Bytes = b"\xce\xba\xe1\xbd\xb9\xcf\x83\xce\xbc\xce\xb5\xed\xa0\x80"

type Case = { case: String, client_sent: Bytes, returned: List<Frame> }

const autobahn_cases: List<Case> =
  [
    {
      case: "1.1.1 an empty text message",
      client_sent: client_says([text(""), closing(1000)]),
      returned: [text(""), closing(1000)],
    },
    {
      case: "1.2.1 a binary message",
      client_sent: client_says([frame(true, Binary, b"\x00\xff"), closing(1000)]),
      returned: [frame(true, Binary, b"\x00\xff"), closing(1000)],
    },
    {
      case: "2.1 a ping with no payload",
      client_sent: client_says([frame(true, Ping, b""), closing(1000)]),
      returned: [frame(true, Pong, b""), closing(1000)],
    },
    {
      case: "2.3 a ping with a binary payload",
      client_sent: client_says([frame(true, Ping, b"\x00\xff\xfe\xfd"), closing(1000)]),
      returned: [frame(true, Pong, b"\x00\xff\xfe\xfd"), closing(1000)],
    },
    {
      case: "2.5 a ping of 126 bytes",
      client_sent: client_says([frame(true, Ping, bytes_of(126))]),
      returned: [closed_on(1002, "a control frame is fragmented or longer than 125 bytes")],
    },
    {
      case: "2.6 a pong nobody asked for",
      client_sent: client_says([frame(true, Pong, b"x"), closing(1000)]),
      returned: [closing(1000)],
    },
    {
      case: "3.1 a frame with RSV2 set",
      client_sent: b"\xa1\x80".concat(key()),
      returned: [closed_on(1002, "a reserved bit is set")],
    },
    {
      case: "4.1.1 a reserved opcode for data",
      client_sent: b"\x83\x80".concat(key()),
      returned: [closed_on(1002, "a reserved opcode")],
    },
    {
      case: "4.2.1 a reserved opcode for control",
      client_sent: b"\x8b\x80".concat(key()),
      returned: [closed_on(1002, "a reserved opcode")],
    },
    {
      case: "5.1 a fragmented ping",
      client_sent: client_says([frame(false, Ping, b"x")]),
      returned: [closed_on(1002, "a control frame is fragmented or longer than 125 bytes")],
    },
    {
      case: "5.3 a text message in two fragments",
      client_sent: client_says([
        frame(false, Text, b"frag"),
        frame(true, Continuation, b"ment"),
        closing(1000),
      ]),
      returned: [text("fragment"), closing(1000)],
    },
    {
      case: "5.6 a ping between fragments",
      client_sent: client_says([
        frame(false, Text, b"a"),
        frame(true, Ping, b"p"),
        frame(true, Continuation, b"b"),
        closing(1000),
      ]),
      returned: [frame(true, Pong, b"p"), text("ab"), closing(1000)],
    },
    {
      case: "5.9 a continuation with nothing to continue",
      client_sent: client_says([frame(true, Continuation, b"x")]),
      returned: [closed_on(1002, "a continuation with no message to continue")],
    },
    {
      case: "5.18 a new message inside a fragmented one",
      client_sent: client_says([frame(false, Text, b"a"), text("b")]),
      returned: [closed_on(1002, "a new message inside a fragmented one")],
    },
    {
      case: "6.3.1 text that is not UTF-8",
      client_sent: client_says([frame(true, Text, invalid_utf8)]),
      returned: [closed_on(1007, "a text message is not UTF-8")],
    },
    {
      case: "7.1.1 a message, a close, and nothing after it",
      client_sent: client_says([text("Hello"), closing(1000), text("late")]),
      returned: [text("Hello"), closing(1000)],
    },
    {
      case: "7.3.1 a close with no code",
      client_sent: client_says([frame(true, Close, b"")]),
      returned: [frame(true, Close, b"")],
    },
    {
      case: "7.3.2 a close of one byte",
      client_sent: client_says([frame(true, Close, b"\x03")]),
      returned: [closed_on(1002, "a close of one byte")],
    },
    {
      case: "7.5.1 a close whose reason is not UTF-8",
      client_sent: client_says([frame(true, Close, b"\x03\xe8".concat(invalid_utf8))]),
      returned: [closed_on(1007, "a close reason is not UTF-8")],
    },
    {
      case: "7.7.4 a close of code 3000",
      client_sent: client_says([closing(3000)]),
      returned: [closing(3000)],
    },
    {
      case: "7.7.13 a close of code 4999",
      client_sent: client_says([closing(4999)]),
      returned: [closing(4999)],
    },
    {
      case: "7.9.1 a close of code 0",
      client_sent: client_says([frame(true, Close, b"\x00\x00")]),
      returned: [closed_on(1002, "a close code no endpoint may send")],
    },
    {
      case: "7.9.3 a close of code 1004",
      client_sent: client_says([frame(true, Close, b"\x03\xec")]),
      returned: [closed_on(1002, "a close code no endpoint may send")],
    },
    {
      case: "7.13.2 a close of code 5000",
      client_sent: client_says([frame(true, Close, b"\x13\x88")]),
      returned: [closed_on(1002, "a close code no endpoint may send")],
    },
    {
      case: "9.1 a frame past the limit",
      client_sent: client_says([frame(true, Binary, bytes_of(65))]),
      returned: [closed_on(1009, "a frame is longer than the limit")],
    },
    {
      case: "9.2 a message past the limit",
      client_sent: client_says([
        frame(false, Binary, bytes_of(64)),
        frame(false, Continuation, bytes_of(64)),
        frame(true, Continuation, b"x"),
      ]),
      returned: [closed_on(1009, "a message is longer than the limit")],
    },
    {
      case: "9.3 a message in too many fragments",
      client_sent: client_says([
        frame(false, Text, b"a"),
        frame(false, Continuation, b"b"),
        frame(false, Continuation, b"c"),
        frame(false, Continuation, b"d"),
        frame(true, Continuation, b"e"),
      ]),
      returned: [closed_on(1009, "a message is in more fragments than the limit")],
    },
    {
      case: "an unmasked frame from a client",
      client_sent: encode_frame(text("x"), None),
      returned: [closed_on(1002, "a client's frame is not masked")],
    },
  ]

test "Autobahn {c.case}: an echo server responds as the suite expects" for c: Case in autobahn_cases {
  assert_eq(echoed("", c.client_sent, small_limit_options), server_says(c.returned))
}

fn compressed(
  role: Role,
  contexts: ContextTakeover,
  messages: List<Message>,
) -> List<Frame> / {abort.raise} =
  messages.fold(
    { state: initial_state(role, default_limits, Some(contexts)), frames: [] },
    |at: { state: State, frames: List<Frame> }, m: Message| {
      let made = message_frame(at.state, m);
      { state: made.state, frames: at.frames.push(made.frame) }
    },
  ).frames

fn decompressed(
  role: Role,
  contexts: ContextTakeover,
  frames: List<Frame>,
) -> List<Event> / {abort.raise} =
  frames.fold(
    { state: initial_state(role, default_limits, Some(contexts)), events: [] },
    |at: { state: State, events: List<Event> }, f: Frame| {
      let step = handle_frame(at.state, f, role == Server);
      { state: step.state, events: at.events.concat(step.events) }
    },
  ).events

fn of_size(n: Int) -> Message / {abort.raise} =
  TextMessage(
    String::of_bytes_lossy(
      Bytes::concat_all(range(0, n / 16 + 1).map(|_i: Int| b"compress me now ")).slice(0, n),
    ),
  )

type Deflating = {
  case: String,
  offer: String,
  result: String,
  contexts: ContextTakeover,
  sizes: List<Int>,
}

const deflating: List<Deflating> =
  [
    {
      case: "12.1.1 small messages, each end keeping its context",
      offer: "permessage-deflate",
      result: "permessage-deflate",
      contexts: { server: true, client: true },
      sizes: [16, 16, 16, 16],
    },
    {
      case: "12.2.1 messages of 64 bytes",
      offer: "permessage-deflate; client_max_window_bits",
      result: "permessage-deflate",
      contexts: { server: true, client: true },
      sizes: [64, 64, 64],
    },
    {
      case: "12.4.1 messages of 1 KiB",
      offer: "permessage-deflate",
      result: "permessage-deflate",
      contexts: { server: true, client: true },
      sizes: [1024, 1024],
    },
    {
      case: "12.5.1 messages of 64 KiB",
      offer: "permessage-deflate",
      result: "permessage-deflate",
      contexts: { server: true, client: true },
      sizes: [65536, 65536],
    },
    {
      case: "13.2.1 a client that keeps no context",
      offer: "permessage-deflate; client_no_context_takeover",
      result: "permessage-deflate; client_no_context_takeover",
      contexts: { server: true, client: false },
      sizes: [16, 64, 16],
    },
    {
      case: "13.3.1 a server asked to keep none",
      offer: "permessage-deflate; server_no_context_takeover",
      result: "permessage-deflate; server_no_context_takeover",
      contexts: { server: false, client: true },
      sizes: [16, 64, 16],
    },
    {
      case: "13.4.1 neither end keeping one",
      offer: "permessage-deflate; server_no_context_takeover; client_no_context_takeover",
      result: "permessage-deflate; server_no_context_takeover; client_no_context_takeover",
      contexts: { server: false, client: false },
      sizes: [16, 1024],
    },
  ]

test "in the Autobahn conformance case {c.case}, an echo server accepts the offered compression and echoes each message compressed with the negotiated compression context" for c: Deflating in deflating {
  let limits = { max_frame: 1048576, max_message: 1048576, max_fragments: 4 };
  let options = { ..default_options, limits: limits };
  match upgrade(request_of(opening("Sec-WebSocket-Extensions: " ++ c.offer ++ "\r\n")), options) {
    Accept(u) -> {
      assert_eq(u.negotiated.compression, Some(c.contexts));
      assert(
        u.head.index_of(Bytes::of_string("Sec-WebSocket-Extensions: " ++ c.result ++ "\r\n"))
          != None,
      )
    },
    Reject(_) -> panic("the offer is taken"),
  };
  let messages = c.sizes.map(of_size);
  let client_bytes = client_says(compressed(Client, c.contexts, messages).push(closing(1000)));
  let echo = echoed("Sec-WebSocket-Extensions: " ++ c.offer ++ "\r\n", client_bytes, options);
  assert_eq(echo, server_says(compressed(Server, c.contexts, messages).push(closing(1000))));
  let frames = compressed(Server, c.contexts, messages);
  assert_eq(decompressed(Client, c.contexts, frames), messages.map(|m: Message| Received(m)))
}

test "Autobahn 13.5.1: an offer with a server window under 32 KiB is declined, and messages are sent uncompressed" {
  match upgrade(
      request_of(
        opening("Sec-WebSocket-Extensions: permessage-deflate; server_max_window_bits=9\r\n"),
      ),
      default_options,
    ) {
    Accept(u) -> {
      assert_eq(u.negotiated.compression, None);
      assert_eq(u.head.index_of(b"Sec-WebSocket-Extensions"), None)
    },
    Reject(_) -> panic("the handshake is one"),
  }
}

test "a compressor that keeps its history between messages sends a repeated message as a short back-reference" {
  let both = { server: true, client: true };
  let again = TextMessage("Hello, compressed world, hello again, compressed world");
  let with_history = compressed(Server, both, [again, again]);
  let fresh = compressed(Server, { server: false, client: true }, [again, again]);
  let size = |f: Frame| f.payload.len();
  assert(size(with_history.at_or(1, close_frame(1000, ""))) < 8);
  assert_eq(
    size(fresh.at_or(1, close_frame(1000, ""))),
    size(fresh.at_or(0, close_frame(1000, ""))),
  )
}

test "RFC 7692 §7.2.3.2: a second Hello in the first one's window reads as Hello" {
  let first = {
    fin: true,
    compressed: true,
    opcode: Text,
    payload: b"\xf2\x48\xcd\xc9\xc9\x07\x00",
  };
  let second = { fin: true, compressed: true, opcode: Text, payload: b"\xf2\x00\x11\x00\x00" };
  assert_eq(decompressed(Client, { server: true, client: true }, [first, second]), [
    Received(TextMessage("Hello")),
    Received(TextMessage("Hello")),
  ])
}

test "RFC 7692's compressed frame with {c.what} decompresses to the text message `Hello`" for c: { what: String, wire: Bytes } in [
    { what: "a compressed block flushed", wire: b"\xc1\x07\xf2\x48\xcd\xc9\xc9\x07\x00" },
    {
      what: "a stored block flushed",
      wire: b"\xc1\x0b\x00\x05\x00\xfa\xff\x48\x65\x6c\x6c\x6f\x00",
    },
    { what: "a final block", wire: b"\xc1\x08\xf3\x48\xcd\xc9\xc9\x07\x00\x00" },
  ] {
  match decode_frame(c.wire, default_limits, true) {
    Got(g) ->
      assert_eq(
        handle_frame(
          initial_state(Client, default_limits, Some({ server: false, client: false })),
          g.frame,
          g.masked,
        ).events,
        [Received(TextMessage("Hello"))],
      ),
    _ -> panic("a whole frame"),
  }
}

test "a compressed message that would decompress past the size limit fails the connection before it uses more memory" {
  let bomb = {
    fin: true,
    compressed: true,
    opcode: Binary,
    payload: gzip::deflate(bytes_of(4096)),
  };
  let step = handle_frame(
    initial_state(
      Server,
      { max_frame: 1024, max_message: 1024, max_fragments: 4 },
      Some({ server: true, client: true }),
    ),
    bomb,
    true,
  );
  assert_eq(step.events, [Failed({ code: 1009, reason: "a message decompresses past the limit" })])
}

test "a client opens a session, sends masked frames, and reads its server's reply and close" {
  let wanted = with_rand(rand(7), || base64_encode(token_bytes(16))).value;
  let result = Bytes::concat_all([
    Bytes::of_string(
      "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: "
        ++ accept_key(wanted)
        ++ "\r\n\r\n",
    ),
    server_says([text("hi back"), closing(1000)]),
  ]);
  let world = net::mem_serving(
    net::mem_resolving(
      net::mem_empty(),
      dns::with_name(dns::table, "chat.example", [ip::read("192.0.2.40")]),
    ),
    ip::read_socket("192.0.2.40:80"),
    [[Sends(result)]],
  );
  let options = { ..default_options, compression: false };
  let ran = net::on_mem(world, ||
    simulate {
      task::unbounded(||
        with_rand(rand(7), ||
          match connect[chat](url"ws://chat.example/room?x=1", options, http::default_limits) {
            Err(_) -> [],
            Ok(s) -> {
              let wrote = send[chat](s, TextMessage("hi"), 1000);
              let first = receive[chat](wrote.session, 1000);
              let second = receive[chat](first.session, 1000);
              [
                Some(wrote.sent),
                Some(first.got == Message(TextMessage("hi back"))),
                Some(second.got == Closed({ code: 1000, reason: "" })),
              ]
            },
          }).value)
    });
  assert_eq(ran.value, [Some(true), Some(true), Some(true)]);
  let send_frames = net::mem_sent(ran.net, 1);
  let text_sent = String::of_bytes_lossy(send_frames);
  assert(
    text_sent.starts_with("GET /room?x=1 HTTP/1.1\r\nHost: chat.example\r\nUpgrade: websocket\r\n"),
  );
  let frames = match send_frames.index_of(b"\r\n\r\n") {
    Some(at) -> send_frames.slice(at + 4, send_frames.len()),
    None -> b"",
  };
  assert_eq(frames.slice(0, 2), b"\x81\x82");
  assert_eq(frames.at(8) & 0x8f, 0x88)
}
