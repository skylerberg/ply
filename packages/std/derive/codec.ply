//! The codecs that `derive json`, `derive bin` and `derive sql` generate: the target's `std.json`
//! `JsonCodec`, `std.bin` `BinCodec` and `std.sql` `RowCodec`, named `<snake_case(T)>_json`,
//! `_bin` and `_row`. Each is the `derive` of its module.
//!
//! A codec is built from the codecs of the types its type contains. Scalars and containers use
//! their runtime module's codecs. A type the module derives with the same deriver is referenced by
//! its generated function, and an imported type by its module's. A parameterized type's codec takes
//! one codec per type parameter, named after the parameter. A codec that is not on a cycle is one
//! definition. A codec whose type reaches itself through types the module derives takes a
//! remaining depth and passes one less to its cycle, so the checker can see the recursion ends. A
//! `json` codec on a cycle is two definitions: the named one calls `_at` with `json::max_depth()`.
//! A `bin` codec on a cycle is one definition per function, each calling its cycle's functions by
//! name, and the named one passes each function to its definition with `bin::max_depth()`.
//!
//! A row is a record's fields, one column per field under the field's name. A scalar is read by
//! `std.sql`'s reader for it, an `Option` by `optional_field`, a `List` of scalars as an array, a
//! `Json` as the document it is, and anything else as a document through the type's own JSON
//! codec, which requires the module to import `std.json`.

import std.derive
import std.derive (Declaration, TypeDeclaration, Type, TypeName, Field, Variant, Refused, Param,
                   Applied, Function, Record, Unit, Alias, Nominal, Sum, Extern, type_text,
                   declared)
import std.list
import std.string
import std.text

/// `derive json`: the target's `JsonCodec`, or why it has none.
pub fn derive_json(declaration: Declaration) -> Result<String, Refused> / {abort.raise} =
  derived(declaration, Json)

/// `derive bin`: the target's `BinCodec`, or why it has none.
pub fn derive_bin(declaration: Declaration) -> Result<String, Refused> / {abort.raise} =
  derived(declaration, Bin)

/// `derive sql`: the target's `RowCodec`, or why it has none.
pub fn derive_row(declaration: Declaration) -> Result<String, Refused> / {abort.raise} =
  derived(declaration, Row)

/// The codec a derivation writes.
type Format = | Json | Bin | Row

fn derived(declaration: Declaration, format: Format) -> Result<String, Refused> / {abort.raise} = {
  let target = derive::target(declaration);
  match error_of(declaration, target, format) {
    Some(r) -> Err(r),
    None -> match json_module_of(declaration, target, format) {
      Err(r) -> Err(r),
      Ok(documents) ->
        Ok(
          String::join(
            emitted(
              {
                format: format,
                runtime: declaration.binder ++ "::",
                fresh: binder_prefix_for(target),
                declaration: declaration,
                cycle: cycle_of(declaration, format, target.name),
                documents: documents,
              },
              target,
            ),
            "\n",
          ),
        ),
    },
  }
}

/// The word a format's functions end with.
fn suffix(format: Format) -> String = match format { Json -> "json", Bin -> "bin", Row -> "row" }

/// What every step of a derivation reads: the format, how the module refers to the format's module
/// (`json::`), a prefix for every generated binder that no type parameter starts with, the
/// declaration, the derived types whose codecs call the target's and are called back by it, and how
/// a row's document fields refer to `std.json`.
type Context = {
  format: Format,
  runtime: String,
  fresh: String,
  declaration: Declaration,
  cycle: List<String>,
  documents: String,
}

fn binder_prefix_for(target: TypeDeclaration) -> String / {abort.raise} =
  iterate("d", target.types.len() + 2, |x: String|
    if target.types.any(|p: String| p.starts_with(x)) { Continue(x ++ "_") } else { Stop(x) })

fn snake(name: String) -> String = text::snake_case(name)

/// The function `format` writes for the type `name`.
fn generated_name(format: Format, name: String) -> String = snake(name) ++ "_" ++ suffix(format)

// --- What a codec cannot be derived over ----------------------------------------------------------

/// How a format reads a value of a type constructor: as one of its runtime module's scalars, as a
/// container through its runtime module, not at all and why, or through the type's own codec.
type Shape = | Leaf | Structural | Blocked(Blocker) | OwnCodec

/// Why a type blocks a derivation, and an optional note of advice for the error.
type Blocker = { reason: String, note: Option<String> }

fn is_fixed_width(name: String) -> Bool =
  ["U8", "U16", "U32", "U64", "U128", "I8", "I16", "I32", "I64", "I128"].contains(name)

/// How `format` reads the type constructor `name`, or, `ordered`, how a `Map` key of it orders.
fn codec_kind(format: Format, name: String, ordered: Bool) -> Shape =
  if ["Int", "Bool", "String", "Bytes", "Unit", "Decimal", "Char"].contains(name) { Leaf }
  else if name == "Float" {
    if ordered { Blocked({ reason: "`Float` is not ordered: `NaN != NaN`", note: None }) }
    else { Leaf }
  } else if [
      "List",
      "Array",
      "Columns",
      "Option",
      "Map",
      "Result",
      "Ordering",
      "Rounding",
      "Instant",
      "Duration",
    ].contains(
      name,
    ) { Structural }
  else if !ordered && format == Bin && is_fixed_width(name) { Leaf }
  else if !ordered && format == Bin && name == "Iter" { Structural }
  else if ["Scoped", "Task", "Chan"].contains(name) {
    Blocked({ reason: "a `" ++ name ++ "` names a location rather than a value", note: None })
  } else if name == "Secret" {
    if ordered {
      Blocked({
        reason: "a credential has no order",
        note: Some(
          "an ordering over a credential leaks a bit of position per comparison and recovers the value in calls proportional to its length; `==` compares two, and `Secret::verify` is the check a program actually wants",
        ),
      })
    } else {
      Blocked({
        reason: match format {
          Json -> "a derived codec would write the credential into the document",
          Bin -> "a derived codec would write the credential into the bytes",
          Row -> "a derived row would write the credential into the database",
        },
        note: Some(
          "move the `Secret` field out of the type being derived, or write the codec by hand over the fields that are not credentials \u{2014} there is no way to encode a `Secret`, which is the guarantee",
        ),
      })
    }
  } else { OwnCodec }

fn function_reason(format: Format, ordered: Bool) -> String =
  if ordered { "functions cannot be ordered" } else {
    match format {
      Json -> "a function has no JSON encoding",
      Bin -> "a function has no binary encoding",
      Row -> "a function has no column to be stored in",
    }
  }

/// Whether `t` encodes as the document `null`, which is how an `Option` writes `None`.
fn encodes_as_null(t: Type) -> Bool =
  match t {
    Unit -> true,
    Applied(n, _, _, _) -> n.name == "Unit" || n.name == "Option",
    _ -> false,
  }

/// What blocks a value of `t` from `format`'s codec, if anything; `ordered`, from ordering it as a
/// `Map` key. A type parameter is derivable by assumption.
fn blocker_of(format: Format, t: Type, ordered: Bool) -> Option<Blocker> / {abort.raise} =
  match t {
    Param(_) -> None,
    Unit -> None,
    Function(_, _, _) -> Some({ reason: function_reason(format, ordered), note: None }),
    Record(fields) -> first_blocker(format, fields.map(|f: Field| f.ty), ordered),
    Applied(n, args, labels, _) -> if labels.len() > 0 {
      Some({ reason: label_reason(), note: None })
    } else {
      match codec_kind(format, n.name, ordered) {
        Blocked(b) ->
          Some({ ..b, reason: b.reason ++ ", so `" ++ n.name ++ "` has no derivation" }),
        _ -> if !ordered && format == Json && n.name == "Option" && args.len() > 0
            && encodes_as_null(args.get(0)) {
          let inner = match args.get(0) { Applied(i, _, _, _) -> i.name, _ -> "Unit" };
          Some({
            reason: "`" ++ inner
              ++ "` encodes as `null`, which is how an `Option` writes `None`, so `Some` and `None` are the same document",
            note: Some(
              "wrap the inner value in a record or a one-field variant \u{2014} both are tagged, and a tagged encoding has no `null` to collide with",
            ),
          })
        } else {
          let key = if n.name == "Map" && args.len() > 0 {
            blocker_of(format, args.get(0), true).map(|b: Blocker|
              { ..b, reason: b.reason ++ ", and a `Map` key type must be ordered" })
          } else { None };
          match key { Some(b) -> Some(b), None -> first_blocker(format, args, ordered) }
        },
      }
    },
  }

fn first_blocker(format: Format, ts: List<Type>, ordered: Bool) -> Option<Blocker> / {abort.raise} =
  ts.fold(None, |acc: Option<Blocker>, t: Type|
    match acc { Some(_) -> acc, None -> blocker_of(format, t, ordered) })

fn label_reason() -> String = "a type that takes a label has no derivation"

/// Why the target has no codec, if it has none: a label, a row whose target is not a record, or the
/// first field that blocks it.
fn error_of(
  declaration: Declaration,
  target: TypeDeclaration,
  format: Format,
) -> Option<Refused> / {abort.raise} = {
  let deriving = "`derive " ++ declaration.binder ++ " for " ++ target.name ++ "`";
  let rejected = |reason: String, at: Option<String>, notes: List<String>|
    Some({ message: reason, at: at, notes: notes });
  let field_rejected = |b: Blocker, field: Option<String>, variant: Option<String>|
    rejected(
      b.reason,
      match field { Some(f) -> Some(f), None -> variant },
      [deriving ++ " requires every field to be derivable"].concat(match b.note {
        Some(n) -> [n],
        None -> [],
      }).concat(match variant {
        Some(v) -> ["the field is in variant `" ++ v ++ "`"],
        None -> [],
      }).push(
        "remove the field from `" ++ target.name ++ "`, or write the codec by hand",
      ),
    );
  let body = |t: Type|
    match t {
      Record(fields) ->
        fields.fold(None, |acc: Option<Refused>, f: Field|
          match acc {
            Some(_) -> acc,
            None -> match blocker_of(format, f.ty, false) {
              Some(b) -> field_rejected(b, Some(f.name), None),
              None -> None,
            },
          }),
      _ -> match blocker_of(format, t, false) {
        Some(b) -> field_rejected(b, None, None),
        None -> None,
      },
    };
  match target.labels.at(0) {
    Some(label) ->
      rejected(label_reason(), None, [
        "a label is what a function's effects are performed under, and a type that contains a function has no derivation, so `["
          ++ label
          ++ "]` is used by no field a derivation could read",
        "drop `[" ++ label ++ "]` from `" ++ target.name ++ "`, or write the codec by hand",
      ]),
    None -> if format == Row { row_error(target, body) } else {
      match target.body {
        Alias(t) -> body(t),
        Nominal(t) -> body(t),
        Sum(variants) ->
          variants.fold(None, |acc: Option<Refused>, v: Variant|
            match acc {
              Some(_) -> acc,
              None -> match first_blocker(format, v.fields, false) {
                Some(b) -> field_rejected(b, None, Some(v.name)),
                None -> None,
              },
            }),
        Extern ->
          rejected("laid out by the toolchain, with no field a derivation could read", None, [
            "write the codec by hand over what its module's functions read of a value",
          ]),
      }
    },
  }
}

/// Why the target has no row, if it has none. A row is a record's fields, one column per field,
/// each of one type.
fn row_error(
  target: TypeDeclaration,
  body: (Type) -> Option<Refused> / {abort.raise},
) -> Option<Refused> / {abort.raise} = {
  let rejected = |reason: String| Some({ message: reason, at: None, notes: [] });
  if target.types.len() > 0 || target.rows.len() > 0 {
    rejected("a column holds one type, so a type with parameters has no row")
  } else {
    match record_fields(target) {
      None -> rejected("a row is a record's fields, a column each"),
      Some(fields) -> if fields.len() == 0 { rejected("a row has a column at least") }
      else { body(Record(fields)) },
    }
  }
}

/// The fields of a record type, as written.
fn record_fields(target: TypeDeclaration) -> Option<List<Field>> =
  match target.body {
    Alias(Record(fields)) -> Some(fields),
    Nominal(Record(fields)) -> Some(fields),
    _ -> None,
  }

// --- Codecs on a cycle ----------------------------------------------------------------------------

/// The types declared in this module that `t`'s codec calls by name.
fn named_in(format: Format, t: Type) -> List<String> =
  match t {
    Applied(n, args, _, _) -> {
      let inner = args.fold([], |acc: List<String>, a: Type| acc.concat(named_in(format, a)));
      match codec_kind(format, n.name, false) {
        OwnCodec -> if n.module == None { inner.push(n.name) } else { inner },
        _ -> inner,
      }
    },
    Record(fields) ->
      fields.fold([], |acc: List<String>, f: Field| acc.concat(named_in(format, f.ty))),
    _ -> [],
  }

fn named_in_body(format: Format, body: derive::Body) -> List<String> =
  match body {
    Alias(t) -> named_in(format, t),
    Nominal(t) -> named_in(format, t),
    Sum(variants) ->
      variants.fold([], |acc: List<String>, v: Variant|
        v.fields.fold(acc, |inner: List<String>, t: Type| inner.concat(named_in(format, t)))),
    Extern -> [],
  }

/// A type the module derives with this deriver, and the derived types its codec calls by name.
type Calls = { name: String, calls: List<String> }

fn callees(calls: List<Calls>, name: String) -> List<String> =
  calls.fold([], |acc: List<String>, c: Calls|
    if c.name == name { acc.concat(c.calls) } else { acc })

/// Every type reachable from `from` through one or more calls. No chain needs to be longer than the
/// number of types.
fn reached(calls: List<Calls>, from: String) -> List<String> =
  range(0, calls.len()).fold(callees(calls, from), |seen: List<String>, _: Int|
    seen.fold(seen, |acc: List<String>, n: String|
      callees(calls, n).fold(acc, |more: List<String>, m: String|
        if more.contains(m) { more } else { more.push(m) })))

/// The types on `target`'s cycle: empty unless `target`'s codec calls itself, directly or through
/// others.
fn cycle_of(declaration: Declaration, format: Format, target: String) -> List<String> = {
  let names = declaration.derived;
  let calls = names.fold([], |acc: List<Calls>, name: String|
    match declared(declaration, name) {
      Some(t) ->
        acc.push({
          name: name,
          calls: named_in_body(format, t.body).filter(|n: String| names.contains(n)),
        }),
      None -> acc,
    });
  reached(calls, target).filter(|n: String| reached(calls, n).contains(target))
}

// --- Generated definitions, as Ply source ---------------------------------------------------------

/// One of a codec's functions as it is generated: what it takes after the dictionaries, what it
/// returns, and a body that refers to its parameters by name.
type Member = {
  name: String,
  params: List<{ name: String, ty: String }>,
  result: String,
  body: String,
}

fn typed_parameters(m: Member) -> List<String> =
  m.params.map(|p: { name: String, ty: String }| p.name ++ ": " ++ p.ty)

fn param_names(m: Member) -> List<String> = m.params.map(|p: { name: String, ty: String }| p.name)

/// A dictionary whose fields are `members`, each a lambda.
fn literal(members: List<Member>) -> String =
  "{"
    ++ String::join(
      members.map(|m: Member|
        m.name ++ ": |" ++ String::join(typed_parameters(m), ", ") ++ "| " ++ m.body),
      ", ",
    )
    ++ "}"

/// The codec type of `arg`.
fn dictionary_type(at: Context, arg: String) -> String =
  at.runtime ++ (match at.format { Json -> "JsonCodec<", Bin -> "BinCodec<", Row -> "RowCodec<" })
    ++ arg
    ++ ">"

/// The definitions of the target's codec. Off a cycle it is one definition, its dictionary. On a
/// cycle, a `bin` codec is one definition per function, and a `json` codec is the named definition
/// and its `_at`.
fn emitted(at: Context, target: TypeDeclaration) -> List<String> / {abort.raise} = {
  let name = generated_name(at.format, target.name);
  let annotation = target.name ++ derive::parameters_text(target);
  let generics = derive::parameters_text(target);
  let dictionaries = target.types.map(|p: String| p ++ ": " ++ dictionary_type(at, p));
  let head = |function: String, params: List<String>, result: String|
    "fn " ++ function ++ generics ++ "(" ++ String::join(params, ", ") ++ ") -> " ++ result
      ++ " = ";
  let public = if target.public { "pub " } else { "" };
  let dictionary_of = dictionary_type(at, annotation);
  if at.cycle.len() == 0 {
    [public ++ head(name, dictionaries, dictionary_of) ++ dictionary(at, target, annotation)]
  } else if at.format != Bin {
    let deeper = name ++ "_at";
    [
      public ++ head(name, dictionaries, dictionary_of) ++ deeper ++ "("
        ++ String::join(target.types.push(at.runtime ++ "max_depth()"), ", ")
        ++ ")",
      head(deeper, dictionaries.push(at.fresh ++ "depth: Int"), dictionary_of) ++ "if " ++ at.fresh
        ++ "depth <= 0 {"
        ++ at.runtime
        ++ "too_deep()} else {"
        ++ dictionary(at, target, annotation)
        ++ "}",
    ]
  } else {
    let depth = at.fresh ++ "depth";
    let deep = dictionaries.push(depth ++ ": Int");
    let members = cycle_members(at, target, annotation);
    let function = |m: Member| name ++ "_" ++ m.name;
    let deepest = target.types.push(at.runtime ++ "max_depth()");
    [
      public ++ head(name, dictionaries, dictionary_of) ++ "{"
        ++ String::join(
          members.map(|m: Member|
            m.name ++ ": |" ++ String::join(typed_parameters(m), ", ") ++ "| " ++ function(m) ++ "("
              ++ String::join(deepest.concat(param_names(m)), ", ")
              ++ ")"),
          ", ",
        )
        ++ "}",
    ].concat(
      members.map(|m: Member|
        head(function(m), deep.concat(typed_parameters(m)), m.result ++ " / {abort.raise}") ++ "if "
          ++ depth
          ++ " <= 0 {("
          ++ at.runtime
          ++ "too_deep()."
          ++ m.name
          ++ ")("
          ++ String::join(param_names(m), ", ")
          ++ ")} else {"
          ++ m.body
          ++ "}"),
    )
  }
}

fn dictionary(at: Context, target: TypeDeclaration, annotation: String) -> String / {abort.raise} =
  match at.format {
    Row -> match record_fields(target) {
      Some(fields) -> row_record(at, fields, annotation),
      None -> "()",
    },
    _ -> match target.body {
      Alias(t) -> codec(at, t, annotation),
      Nominal(t) -> codec(at, t, annotation),
      Sum(variants) ->
        literal(match at.format {
          Json -> json_sum(at, variants, annotation),
          _ -> bin_sum(at, target, variants, annotation),
        }),
      Extern -> "()",
    },
  }

/// The functions of the `bin` codec of `target`, a type on a cycle.
fn cycle_members(
  at: Context,
  target: TypeDeclaration,
  annotation: String,
) -> List<Member> / {abort.raise} =
  match target.body {
    Alias(t) -> aliased_members(at, t, annotation),
    Nominal(t) -> aliased_members(at, t, annotation),
    Sum(variants) -> bin_sum(at, target, variants, annotation),
    Extern -> [],
  }

/// The functions of the `bin` codec of a type on a cycle that is written as `t`.
fn aliased_members(at: Context, t: Type, annotation: String) -> List<Member> / {abort.raise} =
  match t {
    Record(fields) -> bin_record(at, fields, annotation),
    _ ->
      bin_members(
        at,
        annotation,
        bin_put(at, t, at.fresh ++ "w", at.fresh ++ "v"),
        bin_take(at, t, at.fresh ++ "n", ""),
        match cycle_call(at, t, "shape", [at.fresh ++ "s"]) {
          Some(call) -> call,
          None -> "(" ++ codec(at, t, annotation) ++ ".shape)(" ++ at.fresh ++ "s)",
        },
      ),
  }

fn record_members(
  at: Context,
  fields: List<Field>,
  annotation: String,
) -> List<Member> / {abort.raise} =
  match at.format {
    Bin -> bin_record(at, fields, annotation),
    _ -> json_record(at, fields, annotation),
  }

/// An expression of the codec of `t`.
fn codec(at: Context, t: Type, annotation: String) -> String / {abort.raise} =
  match t {
    Param(p) -> p,
    Unit -> at.runtime ++ "unit_" ++ suffix(at.format) ++ "()",
    Function(_, _, _) -> "()",
    Record(fields) -> literal(record_members(at, fields, annotation)),
    Applied(n, args, _, _) -> {
      let codecs = args.map(|a: Type| codec(at, a, type_text(a)));
      // A `Columns` is written as the list of its records, through its builtins.
      if n.name == "Columns" && args.len() == 1 {
        columns_codec(at, codecs.get(0), type_text(args.get(0)))
      } else if at.format == Json && n.name == "Map" && args.len() == 2
          && is_string(at, args.get(0)) { at.runtime ++ "string_map_json(" ++ codecs.get(1) ++ ")" }
      else {
        let call = generated_name(at.format, n.name) ++ "(" ++ String::join(codecs, ", ") ++ ")";
        // A named type's codec is called by name, never inlined.
        match codec_kind(at.format, n.name, false) {
          OwnCodec -> match n.module {
            Some(m) -> m ++ "::" ++ call,
            None -> if !at.cycle.contains(n.name) { call }
            else if at.format == Bin { cycle_codec(at, t) } else {
              generated_name(at.format, n.name) ++ "_at("
                ++ String::join(codecs.push(at.fresh ++ "depth - 1"), ", ")
                ++ ")"
            },
          },
          _ -> at.runtime ++ call,
        }
      }
    },
  }

/// Whether a written type *is* `String`, following the module's own parameterless aliases.
fn is_string(at: Context, t: Type) -> Bool / {abort.raise} =
  iterate({ now: t, steps: 0 }, 66, |s: { now: Type, steps: Int }|
    if s.steps >= 64 { Stop(false) } else {
      match s.now {
        Applied(n, args, _, _) -> if n.module != None || args.len() > 0 { Stop(false) }
        else if n.name == "String" { Stop(true) } else {
          match alias_body(at.declaration, n.name) {
            Some(body) -> Continue({ now: body, steps: s.steps + 1 }),
            None -> Stop(false),
          }
        },
        _ -> Stop(false),
      }
    })

/// What the module's parameterless alias `name` names.
fn alias_body(declaration: Declaration, name: String) -> Option<Type> =
  match declared(declaration, name) {
    Some(t) -> if t.types.len() > 0 || t.rows.len() > 0 || t.labels.len() > 0 { None }
    else { match t.body { Alias(body) -> Some(body), _ -> None } },
    None -> None,
  }

/// The JSON or binary codec of a `Columns` of `element`, whose records' codec is `item`: the list
/// codec, over the records `Columns::to_list` returns and `Columns::of_list` collects again.
fn columns_codec(at: Context, item: String, element: String) -> String = {
  let b = at.fresh;
  let rt = at.runtime;
  let held = "Columns<" ++ element ++ ">";
  if at.format == Json {
    let list = rt ++ "list_json(" ++ item ++ ")";
    "{encode: |" ++ b ++ "c: " ++ held ++ "| (" ++ list ++ ".encode)(Columns::to_list(" ++ b
      ++ "c)), decode: |"
      ++ b
      ++ "j: "
      ++ rt
      ++ "Json| match ("
      ++ list
      ++ ".decode)("
      ++ b
      ++ "j) {Ok("
      ++ b
      ++ "l) -> Ok(Columns::of_list("
      ++ b
      ++ "l)), Err("
      ++ b
      ++ "e) -> Err("
      ++ b
      ++ "e)}}"
  } else {
    "{put: |" ++ b ++ "w: Bytes, " ++ b ++ "c: " ++ held ++ "| " ++ rt ++ "put_list(" ++ b ++ "w, "
      ++ "Columns::to_list("
      ++ b
      ++ "c), ("
      ++ item
      ++ ").put), take: |"
      ++ b
      ++ "d: Bytes, "
      ++ b
      ++ "n: Int| match "
      ++ rt
      ++ "take_list("
      ++ b
      ++ "d, "
      ++ b
      ++ "n, ("
      ++ item
      ++ ").take) {Ok("
      ++ b
      ++ "t) -> Ok({value: Columns::of_list("
      ++ b
      ++ "t.value), at: "
      ++ b
      ++ "t.at}), Err("
      ++ b
      ++ "e) -> Err("
      ++ b
      ++ "e)}, shape: |"
      ++ b
      ++ "s: "
      ++ rt
      ++ "Shapes| "
      ++ rt
      ++ "applied_shape("
      ++ b
      ++ "s, \"Columns\", [("
      ++ item
      ++ ").shape])}"
  }
}

// --- `json` ---------------------------------------------------------------------------------------

fn json_members(at: Context, annotation: String, encode: String, decode: String) -> List<Member> =
  [
    {
      name: "encode",
      params: [{ name: at.fresh ++ "v", ty: annotation }],
      result: at.runtime ++ "Json",
      body: encode,
    },
    {
      name: "decode",
      params: [{ name: at.fresh ++ "j", ty: at.runtime ++ "Json" }],
      result: "Result<" ++ annotation ++ ", " ++ at.runtime ++ "DecodeError>",
      body: decode,
    },
  ]

/// The document of `x`, a value of the type `t`: a record's is written in place.
fn json_encode(at: Context, t: Type, x: String) -> String / {abort.raise} =
  match t {
    Record(fields) -> json_object(at, fields, x),
    _ -> "(" ++ codec(at, t, type_text(t)) ++ ".encode)(" ++ x ++ ")",
  }

fn json_object(at: Context, fields: List<Field>, x: String) -> String / {abort.raise} =
  at.runtime ++ "object(["
    ++ String::join(
      fields.map(|f: Field|
        "{key: \"" ++ f.name ++ "\", value: " ++ json_encode(at, f.ty, x ++ "." ++ f.name) ++ "}"),
      ", ",
    )
    ++ "])"

fn json_record(
  at: Context,
  fields: List<Field>,
  annotation: String,
) -> List<Member> / {abort.raise} = {
  let built = range(0, fields.len()).map(|i: Int|
    fields.get(i).name ++ ": " ++ at.fresh ++ i.to_string());
  let decode = range(0, fields.len()).fold(
    "Ok({" ++ String::join(built, ", ") ++ "})",
    |acc: String, k: Int| {
      let i = fields.len() - 1 - k;
      let f = fields.get(i);
      "match " ++ at.runtime ++ "field(" ++ at.fresh ++ "j, \"" ++ f.name ++ "\", "
        ++ codec(at, f.ty, type_text(f.ty))
        ++ ") {Err("
        ++ at.fresh
        ++ "e) -> Err("
        ++ at.fresh
        ++ "e), Ok("
        ++ at.fresh
        ++ i.to_string()
        ++ ") -> "
        ++ acc
        ++ "}"
    },
  );
  json_members(at, annotation, json_object(at, fields, at.fresh ++ "v"), decode)
}

/// A variant is encoded by its declared name and its fields in order.
fn json_sum(
  at: Context,
  variants: List<Variant>,
  annotation: String,
) -> List<Member> / {abort.raise} = {
  let b = at.fresh;
  let rt = at.runtime;
  let held = |v: Variant| range(0, v.fields.len()).map(|i: Int| b ++ i.to_string());
  let arms = variants.map(|v: Variant| {
    let binders = held(v);
    let pattern = if binders.len() == 0 { v.name }
    else { v.name ++ "(" ++ String::join(binders, ", ") ++ ")" };
    let values = range(0, v.fields.len()).map(|i: Int|
      json_encode(at, v.fields.get(i), binders.get(i)));
    pattern ++ " -> " ++ rt ++ "variant(\"" ++ v.name ++ "\", [" ++ String::join(values, ", ")
      ++ "])"
  });
  let encode = "match " ++ b ++ "v {" ++ String::join(arms, ", ") ++ "}";
  let names = variants.map(|v: Variant| "\"" ++ v.name ++ "\"");
  let chain = range(0, variants.len()).fold(
    rt ++ "unknown_variant(" ++ b ++ "t.tag, [" ++ String::join(names, ", ") ++ "])",
    |acc: String, k: Int| {
      let v = variants.get(variants.len() - 1 - k);
      let arguments = if v.fields.len() == 0 { "" }
      else { "(" ++ String::join(held(v), ", ") ++ ")" };
      let built = range(0, v.fields.len()).fold(
        "Ok(" ++ v.name ++ arguments ++ ")",
        |inner: String, kk: Int| {
          let i = v.fields.len() - 1 - kk;
          "match " ++ rt ++ "decode_and_then(" ++ rt ++ "variant_value(" ++ b ++ "t, "
            ++ i.to_string()
            ++ "), "
            ++ codec(at, v.fields.get(i), type_text(v.fields.get(i)))
            ++ ".decode) {Err("
            ++ b
            ++ "e) -> Err("
            ++ b
            ++ "e), Ok("
            ++ b
            ++ i.to_string()
            ++ ") -> "
            ++ inner
            ++ "}"
        },
      );
      // On a cycle the tag test is a call, not `==`: the emitter records an operator's type by
      // span, every operator here shares the `derive` item's span, and the depth's are on `Int`s.
      let tested = if at.cycle.len() == 0 { b ++ "t.tag == \"" ++ v.name ++ "\"" }
      else { rt ++ "has_tag(" ++ b ++ "t, \"" ++ v.name ++ "\")" };
      "if " ++ tested ++ " {" ++ built ++ "} else {" ++ acc ++ "}"
    },
  );
  let decode = "match " ++ rt ++ "variant_of(" ++ b ++ "j) {Err(" ++ b ++ "e) -> Err(" ++ b
    ++ "e), Ok("
    ++ b
    ++ "t) -> "
    ++ chain
    ++ "}";
  json_members(at, annotation, encode, decode)
}

// --- `bin` ----------------------------------------------------------------------------------------

fn bin_members(
  at: Context,
  annotation: String,
  put: String,
  take: String,
  shape: String,
) -> List<Member> =
  [
    {
      name: "put",
      params: [{ name: at.fresh ++ "w", ty: "Bytes" }, { name: at.fresh ++ "v", ty: annotation }],
      result: "Bytes",
      body: put,
    },
    {
      name: "take",
      params: [{ name: at.fresh ++ "d", ty: "Bytes" }, { name: at.fresh ++ "n", ty: "Int" }],
      result: "Result<" ++ at.runtime ++ "Taken<" ++ annotation ++ ">, " ++ at.runtime
        ++ "BinError>",
      body: take,
    },
    {
      name: "shape",
      params: [{ name: at.fresh ++ "s", ty: at.runtime ++ "Shapes" }],
      result: at.runtime ++ "Shaped",
      body: shape,
    },
  ]

/// A scalar is written and read by `std.bin`'s own functions rather than through a codec.
fn bin_scalar(t: Type) -> Option<String> =
  match t {
    Unit -> Some("unit"),
    Applied(n, _, _, _) -> match codec_kind(Bin, n.name, false) {
      Leaf -> Some(snake(n.name)),
      _ -> None,
    },
    _ -> None,
  }

/// `x`, a value of the type `t`, appended to `w`: a record's fields in place.
fn bin_put(at: Context, t: Type, w: String, x: String) -> String / {abort.raise} =
  match t {
    Record(fields) ->
      fields.fold(w, |acc: String, f: Field| bin_put(at, f.ty, acc, x ++ "." ++ f.name)),
    _ -> bin_call(at, t, "put", [w, x]),
  }

/// The read of a value of the type `t` at `from`: a record's fields in place. `path` keeps the
/// binders of a record's fields distinct from those of the enclosing record.
fn bin_take(at: Context, t: Type, from: String, path: String) -> String / {abort.raise} =
  match t {
    Record(fields) -> record_take(at, fields, from, path),
    _ -> bin_call(at, t, "take", [at.fresh ++ "d", from]),
  }

/// The call of `member` (`put` or `take`) of the codec of `t`, which is not a record, on `args`.
/// It calls `std.bin`'s function for a scalar, or for a builtin type with the functions of its
/// parts; the definition of a type on the cycle; and a dictionary's field for any other type.
fn bin_call(at: Context, t: Type, member: String, args: List<String>) -> String / {abort.raise} = {
  let through = ||
    "(" ++ codec(at, t, type_text(t)) ++ "." ++ member ++ ")(" ++ String::join(args, ", ") ++ ")";
  match bin_scalar(t) {
    Some(s) -> at.runtime ++ member ++ "_" ++ s ++ "(" ++ String::join(args, ", ") ++ ")",
    None -> match cycle_call(at, t, member, args) {
      Some(call) -> call,
      None -> match t {
        Applied(n, parts, _, _) -> match codec_kind(Bin, n.name, false) {
          Structural -> if n.name == "Columns" { through() } else {
            at.runtime ++ member ++ "_" ++ snake(n.name) ++ "("
              ++ String::join(args.concat(parts.map(|a: Type| bin_function(at, a, member))), ", ")
              ++ ")"
          },
          _ -> through(),
        },
        _ -> through(),
      },
    },
  }
}

/// `member` (`put` or `take`) of the codec of `t` as a function value: a bare name when that is
/// enough, otherwise a lambda around the call.
fn bin_function(at: Context, t: Type, member: String) -> String / {abort.raise} = {
  let field = || codec(at, t, type_text(t)) ++ "." ++ member;
  let named = match bin_scalar(t) {
    Some(s) -> Some(at.runtime ++ member ++ "_" ++ s),
    None -> match t {
      Record(_) -> None,
      Applied(n, parts, _, _) -> match codec_kind(Bin, n.name, false) {
        Structural -> if parts.len() > 0 { None }
        else { Some(at.runtime ++ member ++ "_" ++ snake(n.name)) },
        _ -> if on_cycle(at, t) { None } else { Some(field()) },
      },
      _ -> Some(field()),
    },
  };
  match named {
    Some(f) -> f,
    None -> if member == "put" {
      let w = at.fresh ++ "w";
      let v = at.fresh ++ "v";
      "|" ++ w ++ ": Bytes, " ++ v ++ ": " ++ type_text(t) ++ "| " ++ bin_put(at, t, w, v)
    } else {
      let n = at.fresh ++ "n";
      "|" ++ at.fresh ++ "d: Bytes, " ++ n ++ ": Int| " ++ bin_take(at, t, n, "")
    },
  }
}

/// Whether `t` is a type of this module on the target's cycle, whose `bin` codec's functions are
/// separate definitions.
fn on_cycle(at: Context, t: Type) -> Bool =
  match t {
    Applied(n, _, _, _) -> at.format == Bin && n.module == None && at.cycle.contains(n.name),
    _ -> false,
  }

/// The call of `member` of the codec of `t` on `args`, where `t` is on the target's cycle: its
/// definition by name, one level deeper, and no dictionary made for it.
fn cycle_call(
  at: Context,
  t: Type,
  member: String,
  args: List<String>,
) -> Option<String> / {abort.raise} =
  match t {
    Applied(n, parts, _, _) -> if !on_cycle(at, t) { None } else {
      let codecs = parts.map(|a: Type| codec(at, a, type_text(a)));
      Some(
        generated_name(at.format, n.name) ++ "_" ++ member ++ "("
          ++ String::join(codecs.push(at.fresh ++ "depth - 1").concat(args), ", ")
          ++ ")",
      )
    },
    _ -> None,
  }

/// The `bin` codec of `t`, a type on the target's cycle, one level deeper: each of its functions
/// passed to the definition of that name.
fn cycle_codec(at: Context, t: Type) -> String / {abort.raise} = {
  let call = |member: String, args: List<String>|
    match cycle_call(at, t, member, args) { Some(c) -> c, None -> "()" };
  let named = |x: String| at.fresh ++ x;
  literal(
    bin_members(
      at,
      type_text(t),
      call("put", [named("w"), named("v")]),
      call("take", [named("d"), named("n")]),
      call("shape", [named("s")]),
    ),
  )
}

/// Each of `ts` read where the last ended, the first at `start`, then `built` over their values.
fn bin_takes(
  at: Context,
  ts: List<Type>,
  start: String,
  built: String,
  path: String,
) -> String / {abort.raise} = {
  let n = ts.len();
  let binder = |i: Int| at.fresh ++ path ++ i.to_string();
  let end_of = |i: Int| if i < 0 { start } else { binder(i) ++ ".at" };
  range(0, n).fold(
    "Ok({value: " ++ built ++ ", at: " ++ end_of(n - 1) ++ "})",
    |acc: String, k: Int| {
      let i = n - 1 - k;
      "match " ++ bin_take(at, ts.get(i), end_of(i - 1), path ++ i.to_string() ++ "_") ++ " {Err("
        ++ at.fresh
        ++ "e) -> Err("
        ++ at.fresh
        ++ "e), Ok("
        ++ binder(i)
        ++ ") -> "
        ++ acc
        ++ "}"
    },
  )
}

/// A record's fields read in order from `from`, and the record built of them.
fn record_take(
  at: Context,
  fields: List<Field>,
  from: String,
  path: String,
) -> String / {abort.raise} = {
  let built = range(0, fields.len()).map(|i: Int|
    fields.get(i).name ++ ": " ++ at.fresh ++ path ++ i.to_string() ++ ".value");
  bin_takes(at, fields.map(|f: Field| f.ty), from, "{" ++ String::join(built, ", ") ++ "}", path)
}

/// The shape of the type `t` as a function of the shapes visited so far: a type on the cycle uses
/// its definition, one level deeper.
fn bin_shape(at: Context, t: Type) -> String / {abort.raise} = {
  let s = at.fresh ++ "s";
  match cycle_call(at, t, "shape", [s]) {
    Some(call) -> "|" ++ s ++ ": " ++ at.runtime ++ "Shapes| " ++ call,
    None -> codec(at, t, type_text(t)) ++ ".shape",
  }
}

fn bin_record(
  at: Context,
  fields: List<Field>,
  annotation: String,
) -> List<Member> / {abort.raise} = {
  let v = at.fresh ++ "v";
  let shapes = fields.map(|f: Field|
    "{name: \"" ++ f.name ++ "\", shape: " ++ bin_shape(at, f.ty) ++ "}");
  bin_members(
    at,
    annotation,
    fields.fold(at.fresh ++ "w", |acc: String, f: Field|
      bin_put(at, f.ty, acc, v ++ "." ++ f.name)),
    record_take(at, fields, at.fresh ++ "n", ""),
    at.runtime ++ "record_shape(" ++ at.fresh ++ "s, [" ++ String::join(shapes, ", ") ++ "])",
  )
}

/// A variant is its index among the declared constructors, then its fields in order.
fn bin_sum(
  at: Context,
  target: TypeDeclaration,
  variants: List<Variant>,
  annotation: String,
) -> List<Member> / {abort.raise} = {
  let b = at.fresh;
  let count = variants.len();
  let arms = range(0, count).map(|index: Int| {
    let v = variants.get(index);
    let binders = range(0, v.fields.len()).map(|i: Int| b ++ i.to_string());
    let pattern = if binders.len() == 0 { v.name }
    else { v.name ++ "(" ++ String::join(binders, ", ") ++ ")" };
    let tagged = at.runtime ++ "put_tag(" ++ b ++ "w, " ++ index.to_string() ++ ")";
    pattern ++ " -> "
      ++ range(0, v.fields.len()).fold(tagged, |acc: String, i: Int|
        bin_put(at, v.fields.get(i), acc, binders.get(i)))
  });
  // A record argument is read field by field into a literal, so no separate record is made first.
  let cases = range(0, count).map(|index: Int| {
    let v = variants.get(index);
    let read = v.fields.fold(
      { types: [], args: [] },
      |acc: { types: List<Type>, args: List<String> }, t: Type|
        match t {
          Record(fields) ->
            {
              types: acc.types.concat(fields.map(|f: Field| f.ty)),
              args: acc.args.push(
                "{"
                  ++ String::join(
                    range(0, fields.len()).map(|k: Int|
                      fields.get(k).name ++ ": " ++ b ++ (acc.types.len() + k).to_string()
                        ++ ".value"),
                    ", ",
                  )
                  ++ "}",
              ),
            },
          _ ->
            {
              types: acc.types.push(t),
              args: acc.args.push(b ++ acc.types.len().to_string() ++ ".value"),
            },
        },
    );
    let arguments = if v.fields.len() == 0 { "" }
    else { "(" ++ String::join(read.args, ", ") ++ ")" };
    (if index == count - 1 { "_" } else { index.to_string() }) ++ " -> "
      ++ bin_takes(at, read.types, b ++ "t.at", v.name ++ arguments, "")
  });
  let shapes = variants.map(|v: Variant|
    "{name: \"" ++ v.name ++ "\", fields: ["
      ++ String::join(v.fields.map(|t: Type| bin_shape(at, t)), ", ")
      ++ "]}");
  let params = String::join(target.types.map(|p: String| p ++ ".shape"), ", ");
  bin_members(
    at,
    annotation,
    "match " ++ b ++ "v {" ++ String::join(arms, ", ") ++ "}",
    "match " ++ at.runtime ++ "take_tag(" ++ b ++ "d, " ++ b ++ "n, " ++ count.to_string()
      ++ ") {Err("
      ++ b
      ++ "e) -> Err("
      ++ b
      ++ "e), Ok("
      ++ b
      ++ "t) -> match "
      ++ b
      ++ "t.value {"
      ++ String::join(cases, ", ")
      ++ "}}",
    at.runtime ++ "sum_shape(" ++ b ++ "s, \"" ++ at.declaration.module ++ "." ++ target.name
      ++ "\", \""
      ++ target.name
      ++ "\", ["
      ++ params
      ++ "], ["
      ++ String::join(shapes, ", ")
      ++ "])",
  )
}

// --- `sql`: a record's row ------------------------------------------------------------------------

/// How a field of a row is read: by the named `std.sql` reader, as an `Option` of an inner read, as
/// an array read by the named reader, as the document it contains, or through the type's own JSON
/// codec.
pub type RowRead = | Scalar(String) | Optional(RowRead) | Array(String) | Document | ByJson(Type)

/// A column of a record's row: the field's name and how it is read.
pub type RowColumn = { name: String, read: RowRead }

/// The columns `derive sql` reads the declaration's target from, in field order. The checker
/// compares a statement's columns against these. `None` when the target is not a record.
pub fn row_columns(declaration: Declaration) -> Option<List<RowColumn>> / {abort.raise} = {
  let at = {
    format: Row,
    runtime: "",
    fresh: "",
    declaration: declaration,
    cycle: [],
    documents: "",
  };
  record_fields(derive::target(declaration)).map(|fields: List<Field>|
    fields.map(|f: Field| { name: f.name, read: row_read(at, f.ty, 8) }))
}

/// The function `derive sql for T` writes: `<snake_case(T)>_row`.
pub fn row_function(target: String) -> String = generated_name(Row, target)

/// A field type as the module writes it, through its own parameterless aliases.
fn resolve_aliases(at: Context, t: Type) -> Type / {abort.raise} =
  iterate({ now: t, steps: 0 }, 66, |s: { now: Type, steps: Int }|
    if s.steps >= 64 { Stop(s.now) } else {
      match s.now {
        Applied(n, args, _, _) -> if n.module != None || args.len() > 0 { Stop(s.now) } else {
          match alias_body(at.declaration, n.name) {
            Some(body) -> Continue({ now: body, steps: s.steps + 1 }),
            None -> Stop(s.now),
          }
        },
        _ -> Stop(s.now),
      }
    })

/// The `std.sql` reader of a scalar field type.
fn row_scalar(t: Type) -> Option<String> =
  match t {
    Applied(n, args, _, _) -> if n.module != None || args.len() > 0 { None } else {
      match n.name {
        "String" -> Some("text_field"),
        "Int" -> Some("int_field"),
        "Bool" -> Some("bool_field"),
        "Float" -> Some("float_field"),
        "Decimal" -> Some("numeric_field"),
        "Bytes" -> Some("bytes_field"),
        _ -> None,
      }
    },
    _ -> None,
  }

fn row_read(at: Context, t: Type, left: Int) -> RowRead / {abort.raise} = {
  let resolved = resolve_aliases(at, t);
  match row_scalar(resolved) {
    Some(reader) -> Scalar(reader),
    None -> match resolved {
      Applied(n, args, _, _) -> if left > 0 && n.name == "Option" && args.len() == 1 {
        Optional(row_read(at, args.get(0), left - 1))
      } else if n.name == "List" && args.len() == 1 {
        match row_scalar(resolve_aliases(at, args.get(0))) {
          Some(reader) -> Array(reader),
          None -> ByJson(resolved),
        }
      } else if n.name == "Json" && n.module != None { Document }
      else { ByJson(resolved) },
      _ -> ByJson(resolved),
    },
  }
}

/// Whether a field of this type is stored as a document through its JSON codec.
fn row_by_json(read: RowRead) -> Bool =
  match read { ByJson(_) -> true, Optional(inner) -> row_by_json(inner), _ -> false }

/// How a row's documents refer to `std.json`: by the name the module imports it as, which a row
/// with a field stored through its JSON codec needs. Empty for any other derivation.
fn json_module_of(
  declaration: Declaration,
  target: TypeDeclaration,
  format: Format,
) -> Result<String, Refused> / {abort.raise} = {
  let at = {
    format: Row,
    runtime: "",
    fresh: "",
    declaration: declaration,
    cycle: [],
    documents: "",
  };
  let wanted = format == Row
    && (match record_fields(target) {
      Some(fields) -> fields.any(|f: Field| row_by_json(row_read(at, f.ty, 8))),
      None -> false,
    });
  if !wanted { Ok("") } else {
    match declaration.imports.find(|i: derive::Imported| i.module == "std.json") {
      Some(i) -> Ok(i.binder ++ "::"),
      None ->
        Err({
          message: "a field this row stores as a document is read through its JSON codec, and this module does not import `std.json`",
          at: None,
          notes: ["add `import std.json`, and `derive json` for the field's type"],
        }),
    }
  }
}

/// The reader of a field read this way, as an expression the module can write.
fn row_reader(at: Context, read: RowRead) -> String / {abort.raise} =
  match read {
    Scalar(reader) -> at.runtime ++ reader ++ "()",
    Optional(inner) -> at.runtime ++ "optional_field(" ++ row_reader(at, inner) ++ ")",
    Array(reader) -> at.runtime ++ "array_field(" ++ at.runtime ++ reader ++ "())",
    Document -> at.runtime ++ "document_field()",
    ByJson(t) ->
      at.runtime ++ "json_field("
        ++ codec({ ..at, format: Json, runtime: at.documents, cycle: [] }, t, type_text(t))
        ++ ")",
  }

fn row_record(at: Context, fields: List<Field>, annotation: String) -> String / {abort.raise} = {
  let b = at.fresh;
  let rt = at.runtime;
  let readers = fields.map(|f: Field| row_reader(at, row_read(at, f.ty, 8)));
  let name = |i: Int| fields.get(i).name;
  let listed = range(0, fields.len()).map(|i: Int|
    rt ++ "field(\"" ++ name(i) ++ "\", " ++ readers.get(i) ++ ")");
  let built = range(0, fields.len()).map(|i: Int| name(i) ++ ": " ++ b ++ i.to_string());
  let decode = range(0, fields.len()).fold(
    "Ok({" ++ String::join(built, ", ") ++ "})",
    |acc: String, k: Int| {
      let i = fields.len() - 1 - k;
      "match " ++ rt ++ "read(" ++ b ++ "r, \"" ++ name(i) ++ "\", " ++ readers.get(i) ++ ") {Err("
        ++ b
        ++ "e) -> Err("
        ++ b
        ++ "e), Ok("
        ++ b
        ++ i.to_string()
        ++ ") -> "
        ++ acc
        ++ "}"
    },
  );
  let params = range(0, fields.len()).map(|i: Int|
    rt ++ "to_parameter(" ++ readers.get(i) ++ ", " ++ b ++ "v." ++ name(i) ++ ")");
  "{fields: [" ++ String::join(listed, ", ") ++ "], decode: |" ++ b ++ "r: " ++ rt ++ "Row| "
    ++ decode
    ++ ", params: |"
    ++ b
    ++ "v: "
    ++ annotation
    ++ "| ["
    ++ String::join(params, ", ")
    ++ "]}"
}

// --- Tests ----------------------------------------------------------------------------------------

fn named(name: String, args: List<Type>) -> Type =
  Applied({ module: None, name: name }, args, [], [])

fn record(name: String, fields: List<Field>) -> TypeDeclaration =
  { name: name, public: true, types: [], rows: [], labels: [], body: Alias(Record(fields)) }

fn declaring(target: String, types: List<TypeDeclaration>, binder: String) -> Declaration =
  {
    target: target,
    module: "m",
    binder: binder,
    types: types,
    derived: types.map(|t: TypeDeclaration| t.name),
    imports: [{ module: "std.json", binder: "json" }],
  }

fn written(r: Result<String, Refused>) -> String =
  match r { Ok(text) -> text, Err(rejected) -> "rejected: " ++ rejected.message }

test "a codec is built from its fields' codecs: a scalar's from its module, a derived type's by name" {
  let line = record("Line", [
    { name: "sku", ty: named("String", []) },
    { name: "qty", ty: named("Int", []) },
  ]);
  let order = record("Order", [{ name: "lines", ty: named("List", [named("Line", [])]) }]);
  let json = written(derive_json(declaring("Order", [line, order], "json")));
  assert(json.starts_with("pub fn order_json() -> json::JsonCodec<Order> = "), Some(json));
  assert(json.contains("json::list_json(line_json())"), Some(json));
  let bin = written(derive_bin(declaring("Line", [line], "bin")));
  assert(bin.contains("bin::put_string(") && bin.contains("bin::take_int("), Some(bin))
}

test "a codec of a parameterized type takes one for each parameter, named as the parameter is" {
  let boxed = {
    name: "Box",
    public: false,
    types: ["a"],
    rows: [],
    labels: [],
    body: Alias(Record([{ name: "inner", ty: Param("a") }])),
  };
  let json = written(derive_json(declaring("Box", [boxed], "j")));
  assert(
    json.starts_with("fn box_json<a>(a: j::JsonCodec<a>) -> j::JsonCodec<Box<a>> = "),
    Some(json),
  )
}

test "a field no codec can write is rejected at its field, and a variant's at its variant" {
  let at = |types: List<TypeDeclaration>, target: String|
    match derive_json(declaring(target, types, "json")) {
      Ok(text) -> panic("derived " ++ text),
      Err(r) -> { message: r.message, at: r.at },
    };
  let held = |ty: Type| at([record("R", [{ name: "x", ty: ty }])], "R");
  assert(held(Function([], Unit, "")).message.contains("a function has no JSON encoding"), None);
  assert_eq(held(Function([], Unit, "")).at, Some("x"));
  assert(held(named("Secret", [named("String", [])])).message.contains("credential"), None);
  assert(held(named("Task", [named("Int", [])])).message.contains("names a location"), None);
  assert(held(named("Option", [Unit])).message.contains("encodes as `null`"), None);
  assert(
    held(named("Map", [named("Float", []), named("Int", [])])).message.contains("must be ordered"),
    None,
  );
  let sum = {
    name: "S",
    public: false,
    types: [],
    rows: [],
    labels: [],
    body: Sum([{ name: "Fine", fields: [] }, { name: "Held", fields: [Function([], Unit, "")] }]),
  };
  assert_eq(at([sum], "S").at, Some("Held"));
  assert(
    written(
      derive_bin(
        declaring("R", [record("R", [{ name: "x", ty: named("Option", [Unit]) }])], "bin"),
      ),
    ).starts_with(
      "pub fn r_bin()",
    ),
    None,
  )
}

test "a codec whose type reaches itself takes how much deeper it may nest" {
  let tree = {
    name: "Tree",
    public: false,
    types: [],
    rows: [],
    labels: [],
    body: Sum([
      { name: "Leaf", fields: [] },
      { name: "Node", fields: [named("List", [named("Tree", [])])] },
    ]),
  };
  let json = written(derive_json(declaring("Tree", [tree], "json")));
  assert(
    json.contains("fn tree_json() -> json::JsonCodec<Tree> = tree_json_at(json::max_depth())"),
    Some(json),
  );
  assert(json.contains("tree_json_at(ddepth - 1)"), Some(json));
  let bin = written(derive_bin(declaring("Tree", [tree], "bin")));
  assert(
    bin.contains("fn tree_bin_put(") && bin.contains("fn tree_bin_take(")
      && bin.contains("fn tree_bin_shape("),
    Some(bin),
  )
}

test "a row reads a column per field, a document through the type's own codec" {
  let line = record("Line", [{ name: "sku", ty: named("String", []) }]);
  let order = record("Order", [
    { name: "id", ty: named("Int", []) },
    { name: "note", ty: named("Option", [named("String", [])]) },
    { name: "lines", ty: named("List", [named("Line", [])]) },
  ]);
  let row = written(derive_row(declaring("Order", [line, order], "sql")));
  assert(row.starts_with("pub fn order_row() -> sql::RowCodec<Order> = "), Some(row));
  assert(row.contains("sql::field(\"id\", sql::int_field())"), Some(row));
  assert(row.contains("sql::optional_field(sql::text_field())"), Some(row));
  assert(row.contains("sql::json_field(json::list_json(line_json()))"), Some(row));
  assert_eq(
    row_columns(declaring("Order", [line, order], "sql")).map(|cs: List<RowColumn>|
      cs.map(|c: RowColumn| c.name)),
    Some(["id", "note", "lines"]),
  );
  // A document is read through `std.json`, which the module must import.
  match derive_row({ ..declaring("Order", [line, order], "sql"), imports: [] }) {
    Ok(text) -> panic("derived " ++ text),
    Err(r) -> assert(r.message.contains("does not import `std.json`"), Some(r.message)),
  }
}

test "a row is a record's fields: a sum, a type with parameters and an empty record have none" {
  let rejected = |t: TypeDeclaration|
    match derive_row(declaring(t.name, [t], "sql")) { Ok(_) -> "", Err(r) -> r.message };
  assert(rejected({ ..record("E", []) }).contains("a column at least"), None);
  assert(
    rejected({ ..record("P", [{ name: "x", ty: Param("a") }]), types: ["a"] }).contains(
      "parameters",
    ),
    None,
  );
  assert(
    rejected({ ..record("S", []), body: Sum([{ name: "A", fields: [] }]) }).contains(
      "a record's fields",
    ),
    None,
  )
}
