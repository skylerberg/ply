//! `derive children for T` derives functions that walk a tree of `T` values. Their names start with
//! `snake_case(T)`, the same prefix a codec uses, and they work for an alias of a record as well as
//! for a sum. Below, `<t>` stands for that prefix.
//!
//! - `<t>_children(x)`: returns the `T`s directly inside `x`, in the order `x` stores them. -
//! `<t>_children_mapped(x, f)`: returns `x` with each of those `T`s replaced by the result of `f`
//! on it. - `<t>_nodes(x)`: returns `x` and every `T` inside it, each node before the `T`s inside
//! it. - `<t>_nodes_folded(x, init, f)`: folds `f`, starting from `init`, over those nodes in that
//! order, without building a list of them. - `<t>_nodes_mapped(x, f)`: returns `x` rebuilt with `f`
//! applied to each node after the nodes inside it have been rebuilt.
//!
//! A walk finds a `T` inside `x` by going through fields whose types are declared in the module,
//! and through the elements of records, `List`s, `Option`s and the values of a `Map`. All other
//! parts are left unchanged. `f` runs in the order the walk visits the nodes, and the effects of
//! `f` are effects of the walk.

import std.derive
import std.derive (rejection_of, declared_type, applied_type, Declaration, TypeDeclaration, Type,
                   TypeName, Field, Variant, Refused, Param, Applied, Function, Record, Unit, Alias,
                   Nominal, Sum, Extern, type_text, declared)
import std.list
import std.string
import std.text

/// Returns the source of the five walk functions for the declaration's target type, or a `Refused`
/// when the type has nothing to walk.
pub fn derive(declaration: Declaration) -> Result<String, Refused> / {abort.raise} = {
  let target = derive::target(declaration);
  let w = {
    d: declaration,
    target: target,
    snake_name: text::snake_case(target.name),
    target_type: target.name ++ derive::parameters_text(target),
    folded: fresh_type(target),
  };
  if target.labels.len() > 0 {
    rejected(
      "a type with a label parameter contains a function, and `derive` cannot look inside a function",
    )
  } else {
    match fields_of(w, target.body) {
      Err(r) -> Err(r),
      Ok(parts) -> if !parts.any(|t: Type| contains_target(w, t)) {
        rejected(
          "`" ++ target.name ++ "` has no field that contains a `" ++ target.name
            ++ "`, so `derive` has nothing to traverse",
        )
      } else {
        match ((
            gathered(w, target.body, "[]", Children),
            gathered(w, target.body, "acc.push(x)", Nodes),
            gathered(w, target.body, "f(init, x)", Folded),
            rebuilt_whole(w, target.body, ChildrenMapped),
            rebuilt_whole(w, target.body, NodesMapped),
          )) {
          (Ok(children), Ok(nodes), Ok(folded), Ok(mapped), Ok(nodes_mapped)) ->
            Ok(
              walks_text(w, {
                children: children,
                nodes: nodes,
                folded: folded,
                mapped: mapped,
                nodes_mapped: nodes_mapped,
              }),
            ),
          (Err(r), _, _, _, _) -> Err(r),
          (_, Err(r), _, _, _) -> Err(r),
          (_, _, Err(r), _, _) -> Err(r),
          (_, _, _, Err(r), _) -> Err(r),
          (_, _, _, _, Err(r)) -> Err(r),
        }
      },
    }
  }
}

fn rejected(message: String) -> Result<String, Refused> =
  Err({ message: message, at: None, notes: [] })

fn depth() -> Int = 256

type Walking = {
  d: Declaration,
  target: TypeDeclaration,
  snake_name: String,
  target_type: String,
  folded: String,
}

type Gathering = | Children | Nodes | Folded

fn accumulator_type(w: Walking, how: Gathering) -> String =
  match how { Folded -> w.folded, _ -> "List<" ++ w.target_type ++ ">" }

type Rebuilding = | ChildrenMapped | NodesMapped

fn fields_of(w: Walking, body: derive::Body) -> Result<List<Type>, Refused> =
  match body {
    Alias(Record(fields)) -> Ok(fields.map(|f: Field| f.ty)),
    Nominal(Record(fields)) -> Ok(fields.map(|f: Field| f.ty)),
    Sum(variants) ->
      Ok(variants.fold([], |accumulator: List<Type>, v: Variant| accumulator.concat(v.fields))),
    Alias(_) ->
      Err(
        rejection(
          "`" ++ w.target.name
            ++ "` is an alias of a type that is not a record, and `derive` needs a record or a sum type",
        ),
      ),
    Nominal(_) ->
      Err(
        rejection(
          "`" ++ w.target.name
            ++ "` is a `new` type that is not a record, and `derive` needs a record or a sum type",
        ),
      ),
    Extern ->
      Err(
        rejection(
          "`" ++ w.target.name ++ "` is a built-in type, so `derive` cannot see its fields",
        ),
      ),
  }

type Bodies = {
  children: String,
  nodes: String,
  folded: String,
  mapped: String,
  nodes_mapped: String,
}

fn walks_text(w: Walking, b: Bodies) -> String / {abort.raise} = {
  let t = w.target;
  let row = fresh_effects(t);
  let plain = generics(t.types, t.rows);
  let effectful = generics(t.types, t.rows.push(row));
  let folding = generics(t.types.push(w.folded), t.rows.push(row));
  let list = "List<" ++ w.target_type ++ ">";
  let f = "f: (" ++ w.target_type ++ ") -> " ++ w.target_type ++ " / " ++ row;
  let step = "f: (" ++ w.folded ++ ", " ++ w.target_type ++ ") -> " ++ w.folded ++ " / " ++ row;
  let public = if t.public { "pub " } else { "" };
  String::join(
    [
      public ++ "fn " ++ w.snake_name ++ "_children" ++ plain ++ "(x: " ++ w.target_type ++ ") -> "
        ++ list
        ++ " =\n  "
        ++ b.children
        ++ "\n",
      public ++ "fn " ++ w.snake_name ++ "_nodes" ++ plain ++ "(x: " ++ w.target_type ++ ") -> "
        ++ list
        ++ " =\n  "
        ++ w.snake_name
        ++ "_nodes_onto([], x)\n",
      "fn " ++ w.snake_name ++ "_nodes_onto" ++ plain ++ "(acc: " ++ list ++ ", x: "
        ++ w.target_type
        ++ ") -> "
        ++ list
        ++ " =\n  "
        ++ b.nodes
        ++ "\n",
      public ++ "fn " ++ w.snake_name ++ "_nodes_folded" ++ folding ++ "(x: " ++ w.target_type
        ++ ", init: "
        ++ w.folded
        ++ ", "
        ++ step
        ++ ") -> "
        ++ w.folded
        ++ " / "
        ++ row
        ++ " =\n  "
        ++ b.folded
        ++ "\n",
      public ++ "fn " ++ w.snake_name ++ "_children_mapped" ++ effectful ++ "(x: " ++ w.target_type
        ++ ", "
        ++ f
        ++ ") -> "
        ++ w.target_type
        ++ " / "
        ++ row
        ++ " =\n  "
        ++ b.mapped
        ++ "\n",
      public ++ "fn " ++ w.snake_name ++ "_nodes_mapped" ++ effectful ++ "(x: " ++ w.target_type
        ++ ", "
        ++ f
        ++ ") -> "
        ++ w.target_type
        ++ " / "
        ++ row
        ++ " =\n  f("
        ++ b.nodes_mapped
        ++ ")\n",
    ],
    "\n",
  )
}

fn generics(types: List<String>, rows: List<String>) -> String =
  if types.len() == 0 && rows.len() == 0 { "" }
  else if rows.len() == 0 { "<" ++ String::join(types, ", ") ++ ">" }
  else if types.len() == 0 { "<| " ++ String::join(rows, ", ") ++ ">" }
  else { "<" ++ String::join(types, ", ") ++ " | " ++ String::join(rows, ", ") ++ ">" }

fn fresh_type(t: TypeDeclaration) -> String / {abort.raise} =
  iterate("folded", t.types.len() + t.rows.len() + 1, |n: String|
    if t.types.contains(n) || t.rows.contains(n) { Continue(n ++ "_") } else { Stop(n) })

fn fresh_effects(t: TypeDeclaration) -> String / {abort.raise} =
  iterate("e", t.types.len() + t.rows.len() + 1, |n: String|
    if t.types.contains(n) || t.rows.contains(n) { Continue(n ++ "_") } else { Stop(n) })

const too_deep: Refused =
  {
    message: "a part's type has too many levels of nesting for `derive` to follow",
    at: None,
    notes: [],
  }

fn contains_target(w: Walking, t: Type) -> Bool / {abort.raise} =
  contains_target_within(w, t, [], depth())

fn contains_target_within(
  w: Walking,
  t: Type,
  seen: List<String>,
  depth: Int,
) -> Bool / {abort.raise} =
  if depth <= 0 { true } else {
    match t {
      Param(_) -> false,
      Unit -> false,
      Record(fields) -> fields.any(|f: Field| contains_target_within(w, f.ty, seen, depth - 1)),
      Function(params, result, _) ->
        params.any(|a: Type| contains_target_within(w, a, seen, depth - 1))
          || contains_target_within(w, result, seen, depth - 1),
      Applied(n, args, _, _) -> if is_target(w, n) { true }
      else if args.any(|a: Type| contains_target_within(w, a, seen, depth - 1)) { true } else {
        match own_declaration(w, n) {
          None -> false,
          Some(u) -> if seen.contains(u.name) { false } else {
            let inner = seen.push(u.name);
            match u.body {
              Alias(body) ->
                contains_target_within(w, substituted(body, u.types, args), inner, depth - 1),
              Nominal(body) ->
                contains_target_within(w, substituted(body, u.types, args), inner, depth - 1),
              Sum(variants) ->
                variants.any(|v: Variant|
                  v.fields.any(|x: Type|
                    contains_target_within(w, substituted(x, u.types, args), inner, depth - 1))),
              Extern -> false,
            }
          },
        }
      },
    }
  }

fn is_target(w: Walking, n: TypeName) -> Bool = n.module == None && n.name == w.target.name

fn own_declaration(w: Walking, n: TypeName) -> Option<TypeDeclaration> =
  match n.module {
    Some(_) -> None,
    None -> if n.name == w.target.name { None } else { declared(w.d, n.name) },
  }

fn substituted(t: Type, params: List<String>, args: List<Type>) -> Type / {abort.raise} =
  match t {
    Param(p) -> match range(0, params.len()).find(|i: Int| params.get(i) == p) {
      Some(i) -> match args.at(i) { Some(a) -> a, None -> t },
      None -> t,
    },
    Applied(n, xs, labels, rows) ->
      Applied(n, xs.map(|x: Type| substituted(x, params, args)), labels, rows),
    Function(ps, result, row) ->
      Function(
        ps.map(|x: Type| substituted(x, params, args)),
        substituted(result, params, args),
        row,
      ),
    Record(fields) ->
      Record(fields.map(|f: Field| { name: f.name, ty: substituted(f.ty, params, args) })),
    Unit -> Unit,
  }

fn own_arguments(w: Walking, args: List<Type>) -> Bool =
  args == w.target.types.map(|p: String| Param(p))

fn rejection(message: String) -> Refused = { message: message, at: None, notes: [] }

fn walk_rejection(w: Walking, t: Type) -> Option<Refused> =
  match t {
    Function(_, _, _) ->
      Some(
        rejection(
          "a function contains a `" ++ w.target.name
            ++ "`, and `derive` cannot look inside a function",
        ),
      ),
    Applied(n, args, _, _) -> if is_target(w, n) {
      if own_arguments(w, args) { None } else {
        Some(
          rejection(
            "a `" ++ w.target.name
              ++ "` appears with type arguments that differ from the parameters of its declaration",
          ),
        )
      }
    } else if n.module == None && (n.name == "List" || n.name == "Option" || n.name == "Map") {
      None
    } else {
      match own_declaration(w, n) {
        Some(_) -> None,
        None ->
          Some(
            rejection(
              "`" ++ derive::name_text(n) ++ "` holds a `" ++ w.target.name
                ++ "`, but `derive` looks only inside `List`, `Option`, `Map` and types declared in this module",
            ),
          ),
      }
    },
    _ -> None,
  }

fn gathered(
  w: Walking,
  body: derive::Body,
  accumulator: String,
  how: Gathering,
) -> Result<String, Refused> / {abort.raise} =
  match body {
    Sum(variants) -> gathered_cases(w, variants, [], "x", accumulator, how, 0, [], depth()),
    Alias(Record(fields)) -> gathered_fields(w, fields, "x", accumulator, how, 0, [], depth()),
    Nominal(Record(fields)) -> gathered_fields(w, fields, "x", accumulator, how, 0, [], depth()),
    _ ->
      Err(rejection("`" ++ w.target.name ++ "` has no fields or variants for `derive` to look at")),
  }

fn gathering(
  w: Walking,
  t: Type,
  v: String,
  accumulator: String,
  how: Gathering,
  n: Int,
  seen: List<String>,
  depth: Int,
) -> Result<String, Refused> / {abort.raise} =
  if depth <= 0 { Err(too_deep) }
  else if !contains_target(w, t) { Ok(accumulator) } else {
    match walk_rejection(w, t) {
      Some(r) -> Err(r),
      None -> match t {
        Record(fields) -> gathered_fields(w, fields, v, accumulator, how, n, seen, depth - 1),
        Applied(name, args, _, _) -> if is_target(w, name) {
          Ok(match how {
            Children -> accumulator ++ ".push(" ++ v ++ ")",
            Nodes -> w.snake_name ++ "_nodes_onto(" ++ accumulator ++ ", " ++ v ++ ")",
            Folded -> w.snake_name ++ "_nodes_folded(" ++ v ++ ", " ++ accumulator ++ ", f)",
          })
        } else {
          let y = "y" ++ n.to_string();
          let a = "a" ++ n.to_string();
          let list = accumulator_type(w, how);
          match ((name.name, args)) {
            ("List", [item]) -> match gathering(w, item, y, a, how, n + 1, seen, depth - 1) {
              Err(r) -> Err(r),
              Ok(e) ->
                Ok(
                  v ++ ".fold(" ++ accumulator ++ ", |" ++ a ++ ": " ++ list ++ ", " ++ y ++ ": "
                    ++ type_text(item)
                    ++ "| "
                    ++ e
                    ++ ")",
                ),
            },
            ("Option", [item]) -> {
              let shared_accumulator = shared(accumulator, n);
              match gathering(w, item, y, shared_accumulator.name, how, n + 1, seen, depth - 1) {
                Err(r) -> Err(r),
                Ok(e) ->
                  Ok(
                    shared_accumulator.around(
                      "match " ++ v ++ " { Some(" ++ y ++ ") -> " ++ e ++ ", None -> "
                        ++ shared_accumulator.name
                        ++ " }",
                    ),
                  ),
              }
            },
            ("Map", [key, item]) -> if contains_target(w, key) {
              Err(
                rejection(
                  "a `Map` key contains a `" ++ w.target.name
                    ++ "`, and `derive` does not look inside map keys",
                ),
              )
            } else {
              match gathering(w, item, y, a, how, n + 1, seen, depth - 1) {
                Err(r) -> Err(r),
                Ok(e) ->
                  Ok(
                    v ++ ".fold(" ++ accumulator ++ ", |" ++ a ++ ": " ++ list ++ ", k"
                      ++ n.to_string()
                      ++ ": "
                      ++ type_text(key)
                      ++ ", "
                      ++ y
                      ++ ": "
                      ++ type_text(item)
                      ++ "| "
                      ++ e
                      ++ ")",
                  ),
              }
            },
            _ -> match own_declaration(w, name) {
              None -> Ok(accumulator),
              Some(u) -> if seen.contains(u.name) {
                Err(
                  rejection(
                    "`" ++ u.name ++ "` holds itself other than through `" ++ w.target.name
                      ++ "`, and `derive` cannot follow a type that contains itself that way",
                  ),
                )
              } else {
                let inner = seen.push(u.name);
                match u.body {
                  Alias(body) ->
                    gathering(
                      w,
                      substituted(body, u.types, args),
                      v,
                      accumulator,
                      how,
                      n,
                      inner,
                      depth - 1,
                    ),
                  Nominal(Record(fields)) ->
                    gathered_fields(
                      w,
                      fields.map(|f: Field| { name: f.name, ty: substituted(f.ty, u.types, args) }),
                      v,
                      accumulator,
                      how,
                      n,
                      inner,
                      depth - 1,
                    ),
                  Sum(variants) ->
                    gathered_cases(
                      w,
                      variants,
                      u.types,
                      v,
                      accumulator,
                      how,
                      n,
                      inner,
                      depth - 1,
                      args,
                    ),
                  _ -> Ok(accumulator),
                }
              },
            },
          }
        },
        _ -> Ok(accumulator),
      },
    }
  }

fn gathered_fields(
  w: Walking,
  fields: List<Field>,
  v: String,
  accumulator: String,
  how: Gathering,
  n: Int,
  seen: List<String>,
  depth: Int,
) -> Result<String, Refused> / {abort.raise} =
  fields.fold(Ok(accumulator), |out: Result<String, Refused>, f: Field|
    match out {
      Err(r) -> Err(r),
      Ok(a) -> gathering(w, f.ty, v ++ "." ++ f.name, a, how, n, seen, depth),
    })

fn gathered_cases(
  w: Walking,
  variants: List<Variant>,
  params: List<String>,
  v: String,
  accumulator: String,
  how: Gathering,
  n: Int,
  seen: List<String>,
  depth: Int,
  args: List<Type> = [],
) -> Result<String, Refused> / {abort.raise} = {
  let shared_accumulator = shared(accumulator, n);
  let arms = variants.fold(Ok([]), |out: Result<List<String>, Refused>, c: Variant|
    match out {
      Err(r) -> Err(r),
      Ok(xs) -> {
        let fields = c.fields.map(|t: Type| substituted(t, params, args));
        if !fields.any(|t: Type| contains_target(w, t)) { Ok(xs) } else {
          let names = range(0, fields.len()).map(|i: Int|
            "h" ++ n.to_string() ++ "_" ++ i.to_string());
          let walked = range(0, fields.len()).fold(
            Ok(shared_accumulator.name),
            |e: Result<String, Refused>, i: Int|
              match e {
                Err(r) -> Err(r),
                Ok(a) -> gathering(w, fields.get(i), names.get(i), a, how, n + 1, seen, depth),
              },
          );
          match walked {
            Err(r) -> Err({ ..r, at: Some(c.name) }),
            Ok(e) -> Ok(xs.push(c.name ++ case_pattern(w, fields, names) ++ " -> " ++ e)),
          }
        }
      },
    });
  match arms {
    Err(r) -> Err(r),
    Ok(xs) -> {
      let all = variants.all(|c: Variant|
        c.fields.any(|t: Type| contains_target(w, substituted(t, params, args))));
      Ok(
        shared_accumulator.around(
          "match " ++ v ++ " { "
            ++ String::join(
              if all { xs } else { xs.push("_ -> " ++ shared_accumulator.name) },
              ", ",
            )
            ++ " }",
        ),
      )
    },
  }
}

fn shared(accumulator: String, n: Int) -> { name: String, around: (String) -> String } =
  if accumulator == "[]"
      || !accumulator.chars().any(|c: Char| c == '(' || c == '{' || c == '[' || c == ' ') {
    { name: accumulator, around: |e: String| e }
  } else {
    let name = "s" ++ n.to_string();
    {
      name: name,
      around: |e: String| "{ let " ++ name ++ " = " ++ accumulator ++ "; " ++ e ++ " }",
    }
  }

fn case_pattern(w: Walking, fields: List<Type>, names: List<String>) -> String / {abort.raise} =
  if fields.len() == 0 { "" } else {
    "("
      ++ String::join(
        range(0, fields.len()).map(|i: Int|
          if contains_target(w, fields.get(i)) { names.get(i) } else { "_" }),
        ", ",
      )
      ++ ")"
  }

fn rebuilt_whole(
  w: Walking,
  body: derive::Body,
  how: Rebuilding,
) -> Result<String, Refused> / {abort.raise} =
  match body {
    Sum(variants) -> match rebuilt_cases(w, variants, [], [], "x", how, 0, [], depth()) {
      Err(r) -> Err(r),
      Ok(e) -> Ok(match e { Some(x) -> x, None -> "x" }),
    },
    Alias(Record(fields)) -> rebuilt_record(w, fields, "x", how, 0, [], depth()),
    Nominal(Record(fields)) -> rebuilt_record(w, fields, "x", how, 0, [], depth()),
    _ ->
      Err(rejection("`" ++ w.target.name ++ "` has no fields or variants for `derive` to look at")),
  }

fn rebuilding(
  w: Walking,
  t: Type,
  v: String,
  how: Rebuilding,
  n: Int,
  seen: List<String>,
  depth: Int,
) -> Result<Option<String>, Refused> / {abort.raise} =
  if depth <= 0 { Err(too_deep) }
  else if !contains_target(w, t) { Ok(None) } else {
    match walk_rejection(w, t) {
      Some(r) -> Err(r),
      None -> match t {
        Record(fields) -> match rebuilt_record(w, fields, v, how, n, seen, depth - 1) {
          Err(r) -> Err(r),
          Ok(e) -> Ok(Some(e)),
        },
        Applied(name, args, _, _) -> if is_target(w, name) {
          Ok(
            Some(match how {
              ChildrenMapped -> "f(" ++ v ++ ")",
              NodesMapped -> w.snake_name ++ "_nodes_mapped(" ++ v ++ ", f)",
            }),
          )
        } else {
          let y = "y" ++ n.to_string();
          let inner = |item: Type| rebuilding(w, item, y, how, n + 1, seen, depth - 1);
          match ((name.name, args)) {
            ("List", [item]) -> match inner(item) {
              Err(r) -> Err(r),
              Ok(e) ->
                Ok(
                  Some(
                    v ++ ".map(|" ++ y ++ ": " ++ type_text(item) ++ "| " ++ rebuilt(e, y) ++ ")",
                  ),
                ),
            },
            ("Option", [item]) -> match inner(item) {
              Err(r) -> Err(r),
              Ok(e) ->
                Ok(
                  Some(
                    "match " ++ v ++ " { Some(" ++ y ++ ") -> Some(" ++ rebuilt(e, y)
                      ++ "), None -> None }",
                  ),
                ),
            },
            ("Map", [key, item]) -> if contains_target(w, key) {
              Err(
                rejection(
                  "a `Map` key contains a `" ++ w.target.name
                    ++ "`, and `derive` does not look inside map keys",
                ),
              )
            } else {
              match inner(item) {
                Err(r) -> Err(r),
                Ok(e) ->
                  Ok(
                    Some(
                      v ++ ".map(|" ++ y ++ ": " ++ type_text(item) ++ "| " ++ rebuilt(e, y) ++ ")",
                    ),
                  ),
              }
            },
            _ -> match own_declaration(w, name) {
              None -> Ok(None),
              Some(u) -> if seen.contains(u.name) {
                Err(
                  rejection(
                    "`" ++ u.name ++ "` holds itself other than through `" ++ w.target.name
                      ++ "`, and `derive` cannot follow a type that contains itself that way",
                  ),
                )
              } else {
                let within = seen.push(u.name);
                match u.body {
                  Alias(body) ->
                    rebuilding(w, substituted(body, u.types, args), v, how, n, within, depth - 1),
                  Nominal(Record(fields)) -> match rebuilt_record(
                      w,
                      fields.map(|f: Field| { name: f.name, ty: substituted(f.ty, u.types, args) }),
                      v,
                      how,
                      n,
                      within,
                      depth - 1,
                    ) {
                    Err(r) -> Err(r),
                    Ok(e) -> Ok(Some(e)),
                  },
                  Sum(variants) ->
                    rebuilt_cases(w, variants, u.types, args, v, how, n, within, depth - 1),
                  _ -> Ok(None),
                }
              },
            },
          }
        },
        _ -> Ok(None),
      },
    }
  }

fn rebuilt(e: Option<String>, y: String) -> String = match e { Some(x) -> x, None -> y }

fn rebuilt_record(
  w: Walking,
  fields: List<Field>,
  v: String,
  how: Rebuilding,
  n: Int,
  seen: List<String>,
  depth: Int,
) -> Result<String, Refused> / {abort.raise} =
  match fields.fold(Ok([]), |out: Result<List<String>, Refused>, f: Field|
      match out {
        Err(r) -> Err(r),
        Ok(xs) -> match rebuilding(w, f.ty, v ++ "." ++ f.name, how, n, seen, depth) {
          Err(r) -> Err({ ..r, at: Some(f.name) }),
          Ok(None) -> Ok(xs),
          Ok(Some(e)) -> Ok(xs.push(f.name ++ ": " ++ e)),
        },
      }) {
    Err(r) -> Err(r),
    Ok(xs) -> Ok("{ .." ++ v ++ ", " ++ String::join(xs, ", ") ++ " }"),
  }

fn rebuilt_cases(
  w: Walking,
  variants: List<Variant>,
  params: List<String>,
  args: List<Type>,
  v: String,
  how: Rebuilding,
  n: Int,
  seen: List<String>,
  depth: Int,
) -> Result<Option<String>, Refused> / {abort.raise} = {
  let arms = variants.fold(Ok([]), |out: Result<List<String>, Refused>, c: Variant|
    match out {
      Err(r) -> Err(r),
      Ok(xs) -> {
        let fields = c.fields.map(|t: Type| substituted(t, params, args));
        if !fields.any(|t: Type| contains_target(w, t)) { Ok(xs) } else {
          let names = range(0, fields.len()).map(|i: Int|
            "h" ++ n.to_string() ++ "_" ++ i.to_string());
          let built = range(0, fields.len()).fold(
            Ok([]),
            |e: Result<List<String>, Refused>, i: Int|
              match e {
                Err(r) -> Err(r),
                Ok(ys) -> match rebuilding(
                    w,
                    fields.get(i),
                    names.get(i),
                    how,
                    n + 1,
                    seen,
                    depth,
                  ) {
                  Err(r) -> Err(r),
                  Ok(m) -> Ok(ys.push(rebuilt(m, names.get(i)))),
                },
              },
          );
          match built {
            Err(r) -> Err({ ..r, at: Some(c.name) }),
            Ok(ys) ->
              Ok(
                xs.push(
                  c.name ++ "(" ++ String::join(names, ", ") ++ ") -> " ++ c.name ++ "("
                    ++ String::join(ys, ", ")
                    ++ ")",
                ),
              ),
          }
        }
      },
    });
  match arms {
    Err(r) -> Err(r),
    Ok(xs) -> if xs.len() == 0 { Ok(None) } else {
      let all = variants.all(|c: Variant|
        c.fields.any(|t: Type| contains_target(w, substituted(t, params, args))));
      let o = "o" ++ n.to_string();
      Ok(
        Some(
          "match " ++ v ++ " { "
            ++ String::join(if all { xs } else { xs.push(o ++ " -> " ++ o) }, ", ")
            ++ " }",
        ),
      )
    },
  }
}

fn derived(
  target: String,
  types: List<TypeDeclaration>,
) -> Result<String, Refused> / {abort.raise} =
  derive({
    target: target,
    module: "m",
    binder: "children",
    types: types,
    derived: [target],
    imports: [],
  })

test "a walk over a type's children descends into records, lists, options and the module's own types, and leaves every other type unchanged" {
  let expression = |args: List<Type>| applied_type("E", args);
  let types = [
    declared_type(
      "E",
      ["t"],
      Alias(
        Record([
          { name: "node", ty: applied_type("N", [Param("t")]) },
          { name: "ty", ty: Param("t") },
        ]),
      ),
    ),
    declared_type(
      "N",
      ["t"],
      Sum([
        { name: "Lit", fields: [applied_type("Int", [])] },
        {
          name: "Call",
          fields: [
            Record([
              { name: "callee", ty: expression([Param("t")]) },
              { name: "args", ty: applied_type("List", [expression([Param("t")])]) },
            ]),
          ],
        },
        {
          name: "Maybe",
          fields: [applied_type("Option", [expression([Param("t")])]), applied_type("String", [])],
        },
      ]),
    ),
  ];
  match derived("E", types) {
    Err(r) -> panic("rejected: " ++ r.message),
    Ok(text) -> {
      assert(
        text.contains(
          "fn e_children<t>(x: E<t>) -> List<E<t>> =\n  match x.node { Call(h0_0) -> h0_0.args.fold([].push(h0_0.callee), |a1: List<E<t>>, y1: E<t>| a1.push(y1)), Maybe(h0_0, _) -> match h0_0 { Some(y1) -> [].push(y1), None -> [] }, _ -> [] }\n",
        ),
      );
      assert(
        text.contains(
          "fn e_nodes_onto<t>(acc: List<E<t>>, x: E<t>) -> List<E<t>> =\n  { let s0 = acc.push(x); match x.node { Call(h0_0) -> h0_0.args.fold(e_nodes_onto(s0, h0_0.callee), |a1: List<E<t>>, y1: E<t>| e_nodes_onto(a1, y1)), ",
        ),
      );
      assert(
        text.contains(
          "fn e_nodes_folded<t, folded | e>(x: E<t>, init: folded, f: (folded, E<t>) -> folded / e) -> folded / e =\n  { let s0 = f(init, x); match x.node { Call(h0_0) -> h0_0.args.fold(e_nodes_folded(h0_0.callee, s0, f), |a1: folded, y1: E<t>| e_nodes_folded(y1, a1, f)), ",
        ),
      );
      assert(
        text.contains(
          "fn e_nodes_mapped<t | e>(x: E<t>, f: (E<t>) -> E<t> / e) -> E<t> / e =\n  f({ ..x, node: match x.node { Call(h0_0) -> Call({ ..h0_0, callee: e_nodes_mapped(h0_0.callee, f), args: h0_0.args.map(|y1: E<t>| e_nodes_mapped(y1, f)) }), Maybe(h0_0, h0_1) -> Maybe(match h0_0 { Some(y1) -> Some(e_nodes_mapped(y1, f)), None -> None }, h0_1), o0 -> o0 } })\n",
        ),
      )
    },
  }
}

test "deriving a walk fails for a type it cannot descend into, and names the variant that contains that type" {
  let sum = |fields: List<Type>|
    [declared_type("T", [], Sum([{ name: "V", fields: fields }, { name: "Leaf", fields: [] }]))];
  assert_eq(
    rejection_of(derived("T", sum([Function([applied_type("T", [])], Unit, "")]))).at,
    Some("V"),
  );
  assert_eq(
    rejection_of(
      derived("T", sum([applied_type("Map", [applied_type("T", []), applied_type("Int", [])])])),
    ).message,
    "a `Map` key contains a `T`, and `derive` does not look inside map keys",
  );
  let loop = [
    declared_type("T", [], Sum([{ name: "V", fields: [applied_type("U", [])] }])),
    declared_type(
      "U",
      [],
      Sum([
        { name: "More", fields: [applied_type("U", [])] },
        { name: "Here", fields: [applied_type("T", [])] },
      ]),
    ),
  ];
  assert_eq(
    rejection_of(derived("T", loop)).message,
    "`U` holds itself other than through `T`, and `derive` cannot follow a type that contains itself that way",
  );
  assert_eq(
    rejection_of(
      derived("T", [
        declared_type("T", [], Sum([{ name: "V", fields: [applied_type("Int", [])] }])),
      ]),
    ).message,
    "`T` has no field that contains a `T`, so `derive` has nothing to traverse",
  )
}
