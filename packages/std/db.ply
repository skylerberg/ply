//! PostgreSQL: the `db` effect, its driver over `std.pg`, and an in-memory fake.
//!
//! Each operation names a table in brackets, and `db.query[items]` counts as `db.read[items]`.
//! Transaction operations name no table, so they conflict with every other write and transactions
//! never run side by side. SQL errors are values: a `DbError` gives the SQLSTATE, the constraint a
//! violation names, and the server's message and detail.
//!
//! The driver parses a statement before it sends it. It rejects a statement that writes but is
//! performed as `db.query`, because the scheduler would treat the code that performs it as a
//! reader. It rejects text the parser cannot fully analyze (a second statement after a `;`, `for
//! update`, `on conflict`, a call it does not allow, a function whose result does not depend only
//! on the program's state), because the scheduler could then run two writers side by side on a
//! wrong guess about which tables they write. And it rejects a statement whose tables do not
//! include the table the call site named. Each rejection is raised, so a program cannot ignore it.
//! `ply check` runs these checks as `std.sql`'s `check_statement`, before anything runs, on every
//! statement whose text it can compute. `fetch` reads a statement's rows as values of a record type
//! through the codec that `derive sql` writes for it.
//!
//! `with_server(url, size, body)` handles the effect using a connection string. The connection
//! pool, the transaction scope and the text of every value are implemented in Ply, and the host
//! provides only `net`. A statement outside a transaction takes a free connection from the pool, or
//! opens one while fewer than `size` are open, and returns it to the pool once the server has
//! replied. If none is available, it fails with `53300`. A `begin` takes a connection for its
//! transaction, a `begin` inside it is a savepoint on that connection, and the `commit` or `abort`
//! that closes the transaction returns the connection to the pool whatever the server replied. A
//! `commit` the server turned into a rollback is `25P02`, as it is in the fake.
//!
//! A handler cannot see which task performs an operation. So `serve` sends each operation to the
//! one open transaction that is not waiting for a reply from the server. For this to be
//! unambiguous, a task with an open transaction must not wait on anything except its own
//! statements. If an operation is performed while two open transactions are both not waiting for a
//! reply, `serve` cannot tell which one it belongs to and raises an error.
//!
//! A connection that fails is class `08`: `08001` when it could not be opened, TLS included,
//! `08006` when it broke, `08P01` when a reply could not be read, `08003` when the transaction's
//! connection is gone and the transaction with it, and `08007` for a `commit` whose outcome is
//! unknown. A server that requests a password when none was given is `28000`. A connection string's
//! `sslmode` decides whether every connection uses TLS, and a connection that uses TLS is always
//! verified. The `Ssl` type records this choice. The password is a `Secret<Bytes>` from where it is
//! read, the connection string or `with_server`'s `password` (as `config.secret` returns one), all
//! the way to the wire.
//!
//! `db.notify` is a statement like any other, on its transaction's connection, so the server
//! delivers it when that transaction commits. Listening is different: `db.listen` opens a
//! connection of the driver's own, outside the pool and never inside a transaction, and
//! `db.next_notification` waits for a notification on it, one task at a time. That connection can
//! be lost, and notifications sent while it is lost are lost with it. So the wait that opens a new
//! connection and listens again returns `Reconnected` before any notification received after it: a
//! program that builds state from notifications should reload it then. The wait is an operation
//! rather than a `std.seq` sequence because each wait needs its own deadline and changes the
//! listener (its buffer and its connection). Pulling a sequence a second time would start it again
//! from the beginning and repeat those changes.
//!
//! `copy_into` and `copy_from` move rows with `COPY` in its text format, with values as text, as in
//! every statement. `copy_into` takes a sequence of rows, sends it a chunk at a time, and stores
//! all of it or none. `copy_from` returns a sequence of the rows a statement returns, read a page
//! at a time. Each uses one connection, a transaction's or one from the pool, until it ends. The
//! operations `db.copy_in`, `db.copy_rows`, `db.copy_end`, `db.copy_out` and `db.copy_take` are
//! what `copy_into` and `copy_from` perform.
//!
//! `MemDb` is the in-memory fake: `open` a schema, then `step`, `begin_step`, `commit_step` and
//! `abort_step` return what a server would, and `notify_step`, `listen_step`, `unlisten_step`,
//! `next_notification_step` and `disconnect_step` return what a server would for notifications. It
//! does not model `COPY`.

import std.bytes (u32_be, cstring)
import std.json
import std.net (net)
import std.random (entropy, nonce)
import std.pg
import std.string
import std.list
import std.seq
import std.seq (Seq, Done, Skip, Yield, seq)
import std.bytes
import std.option
import std.result
import std.sql
import std.sql (Statement, Param, QueryResult, DbError, Row, Failed, db_error, statement_of, Count,
                Schema, Table, Column, SequenceDefault, DNone, LiteralDefault, Unique, ForeignKey,
                Check, ColumnType, IntColumn, BoolColumn, TText, BytesColumn, FloatColumn, TNumeric,
                JsonColumn, TArray, NullParameter, IntParameter, BoolParameter, TextParameter,
                NumericParameter, FloatParameter, BytesParameter, JsonParameter, ArrayParameter,
                column, Datum, TextDatum, NullDatum, BoolDatum, NumericDatum, IntDatum, BytesDatum,
                FloatDatum, JsonDatum, ArrayDatum, Rows, column_default, Postgres, tokenize,
                SqlTokenAt, SqlPlaceholder, sql_is_semicolon, datum_type, Operation, Reads, Writes,
                WritesRows)

/// The PostgreSQL database. Each operation names the table it touches in brackets, as in
/// `db.query[items]`, and runs a statement or controls a transaction on the connection the handler
/// provides.
pub nondet effect db {
  /// Runs a statement that only reads, its `$n` placeholders bound to `ps`.
  read query[t](s: Statement, ps: List<Param>) -> QueryResult
  /// Runs the statement once for each parameter list. Each result is what its own `query` would
  /// have returned.
  read batch[t](s: Statement, each: List<List<Param>>) -> List<QueryResult>
  /// Runs a statement that writes, returning the number of rows it touched as `Count`.
  write execute[t](s: Statement, ps: List<Param>) -> QueryResult
  /// Runs a statement that writes and returns rows, as one with `returning` does.
  write returning[t](s: Statement, ps: List<Param>) -> QueryResult
  /// Begins a transaction with the given isolation level and access, or a savepoint when a
  /// transaction is already open. It names no table, so it conflicts with every other `db.write`.
  write begin(level: Isolation, access: Access) -> QueryResult
  /// Commits the innermost open transaction or savepoint.
  write commit() -> QueryResult
  /// Rolls back the innermost open transaction or savepoint.
  write abort() -> QueryResult
  /// Rolls back the enclosing `transaction` with `reason`. `transaction` handles this operation
  /// itself, so no handler of `db` should implement it.
  write rollback(reason: String) -> Unit
  /// Sends a notification with `payload` on the channel `c`. Every session listening on `c`
  /// receives it when the transaction it is performed in commits, or immediately outside a
  /// transaction, and never if the transaction rolls back. Two notifications with the same payload
  /// in one transaction are delivered once. Returns the error `22023` for a payload of 8000 bytes
  /// or more.
  write notify[c](payload: String) -> QueryResult
  /// Listens on the channel `c`, on a connection of its own outside the pool that `next_notification`
  /// reads.
  write listen[c]() -> QueryResult
  /// Stops listening on the channel `c`.
  write unlisten[c]() -> QueryResult
  /// The next notification on a channel the program listens on, waiting at most `timeout_ms` for
  /// one, or what happened to the connection it arrives on. One task waits at a time.
  write next_notification(timeout_ms: Int) -> Notice
  /// Starts copying rows into the `columns` of table `t` with `COPY`, and returns the copy's
  /// number. Inside a transaction the copy runs on the transaction's connection, which runs nothing
  /// else until the copy ends. Outside a transaction the copy keeps one connection from the pool in
  /// use until it ends.
  write copy_in[t](columns: List<String>) -> Result<Int, DbError>
  /// Sends rows to a copy that `copy_in` started, each row its columns' values in order.
  write copy_rows[t](copy: Int, rows: List<List<Param>>) -> Result<Unit, DbError>
  /// Ends the copy numbered `copy`. For a copy in, `failure` of `None` makes the server store every
  /// row sent and returns how many. `Some(reason)` makes the server store none of them and returns
  /// the error `57014`. A copy in also returns that error when the server could not accept a row.
  /// For a copy out, `copy_end` discards the rows not yet taken and returns how many rows were
  /// taken, or the error that made the copy fail.
  write copy_end[t](copy: Int, failure: Option<String>) -> Result<Int, DbError>
  /// Starts copying the rows that the statement `s` returns out of the server with `COPY`, and
  /// returns the copy's number. Like `copy_in`, the copy keeps one connection in use until it ends:
  /// the transaction's connection, or one from the pool.
  read copy_out[t](s: Statement) -> Result<Int, DbError>
  /// At most `rows` more rows of a copy out, as `query` would have returned them. None once the
  /// server has sent every row or the copy failed, which `copy_end` then reports.
  read copy_take[t](copy: Int, rows: Int) -> Result<List<Row>, DbError>
}

/// What a wait for a notification returns.
pub type Notice =
  /// A notification on a channel the program listens on.
  | Notified(pg::Notification)
  /// The listening connection was lost and a new one listens again on every channel. Notifications
  /// sent while it was lost are gone, so a program that builds state from notifications should
  /// reload that state.
  | Reconnected
  /// The listening connection was lost and a new one could not be opened. The `DbError` is the
  /// reason it could not be opened. The next wait tries again, and returns `Reconnected` once it
  /// succeeds.
  | ListenFailed(DbError)
  /// Nothing arrived before the deadline.
  | Quiet

/// A transaction's isolation level, as postgres names them.
pub type Isolation = | ReadCommitted | RepeatableRead | Serializable

/// Whether a transaction may write.
pub type Access = | ReadWrite | ReadOnly

/// Why a transaction rolled back: the reason `db.rollback` gave, and the error that caused it, if one
/// did.
pub type Rollback = { reason: String, error: Option<DbError> }

/// Runs `body` in a transaction and returns its result, or a `Rollback` when `begin` or `commit`
/// fails or `body` performs `db.rollback`. A `db.rollback` anywhere inside `body`, however deeply
/// nested, discards the rest of `body`. The transaction is aborted whenever `body` ends before the
/// commit, including when a handler outside `body` exits it early or the task is cancelled.
pub fn transaction<a | e>(
  level: Isolation,
  access: Access,
  body: () -> a / {db.rollback | e},
) -> Result<a, Rollback> / {db.begin bounded, db.commit bounded, db.abort bounded | e bounded} =
  match db.begin(level, access) {
    Failed(err) -> Err({ reason: "begin", error: Some(err) }),
    _ -> handle {
      bracket(|| (), |u: Unit| if !closing.closed() { abort_quietly() }, |u: Unit|
        match attempt(body) {
          Err(rolled) -> Err(rolled),
          Ok(value) -> {
            closing.close();
            match db.commit() {
              Failed(err) -> Err({ reason: "commit", error: Some(err) }),
              _ -> Ok(value),
            }
          },
        })
    } with {
      var closed = false,
      closing.close() -> {
        closed = true;
      },
      closing.closed() -> closed,
    },
  }

effect closing {
  write close() -> Unit
  read closed() -> Bool
}

fn attempt<a | e>(body: () -> a / {db.rollback | e}) -> Result<a, Rollback> / e =
  handle {
    Ok(body())
  } with {
    db.rollback(reason) resume k -> Err({ reason: reason, error: None }),
  }

/// A transaction that always rolls back, whatever the body did.
pub fn sandbox<a | e>(
  body: () -> a / e,
) -> a / {abort.raise, db.begin bounded, db.abort bounded | e bounded} =
  bracket(
    || assert(succeeded(db.begin(ReadCommitted, ReadWrite))),
    |u: Unit| abort_quietly(),
    |u: Unit| body(),
  )

fn abort_quietly() -> Unit / {db.abort} = {
  db.abort();
  ()
}

fn succeeded(a: QueryResult) -> Bool = match a { Failed(_) -> false, _ -> true }

/// A serialization failure or a deadlock: the server is asking the program to retry.
pub fn is_retryable(e: DbError) -> Bool = e.code == "40001" || e.code == "40P01"

/// The rows `s` returns, each read by `codec`. When the check can compute the statement and the
/// codec is derived, it checks the columns the statement returns against the codec's fields.
pub fn fetch<a, [t]>(
  s: Statement,
  codec: sql::RowCodec<a>,
  ps: List<Param>,
) -> Result<List<a>, sql::FetchError> / {db.query[t], abort.raise} =
  sql::decode_rows(db.query[t](s, ps), codec)

/// `fetch` over a statement that writes and returns the rows its `returning` names.
pub fn fetch_returning<a, [t]>(
  s: Statement,
  codec: sql::RowCodec<a>,
  ps: List<Param>,
) -> Result<List<a>, sql::FetchError> / {db.returning[t], abort.raise} =
  sql::decode_rows(db.returning[t](s, ps), codec)

/// Copies `rows` into the `columns` of table `t` with `COPY`, sending at most `chunk` rows at a
/// time so that no more than one chunk is in memory, and returns how many rows the server accepted.
/// Rows are pulled from the sequence as they are sent. Pulling stops with `seq.spent` once it has
/// used `budget` steps, counting both elements and `Skip` steps. The copy stores every row or none.
/// It fails with `CopyFail` if the server rejects a chunk or the budget runs out. If pulling a row
/// raises an error, the copy is cancelled so that no rows are stored, and then the same error is
/// raised again to the caller.
pub fn copy_into<[t] | e>(
  columns: List<String>,
  rows: Seq<List<Param> | e>,
  chunk: Int,
  budget: Int,
) -> Result<Int, DbError> / {db.copy_in[t], db.copy_rows[t], db.copy_end[t], seq.spent | e} =
  match db.copy_in[t](columns) {
    Err(e) -> Err(e),
    Ok(id) -> handle {
      bracket(
        || (),
        |u: Unit|
          if !closing.closed() {
            db.copy_end[t](id, Some("the copy stopped before all rows were sent"));
            ()
          },
        |u: Unit|
          match send_chunks[t](id, rows, max(chunk, 1), budget, budget, []) {
            Err(e) -> Err(e),
            Ok(_) -> {
              closing.close();
              db.copy_end[t](id, None)
            },
          },
      )
    } with {
      var closed = false,
      closing.close() -> {
        closed = true;
      },
      closing.closed() -> closed,
    },
  }

fn send_chunks<[t] | e>(
  id: Int,
  s: Seq<List<Param> | e>,
  chunk: Int,
  budget: Int,
  left: Int,
  buffered_rows: List<List<Param>>,
) -> Result<Unit, DbError> / {db.copy_rows[t], seq.spent | e} =
  match s() {
    Done -> if buffered_rows.len() == 0 { Ok(()) } else { db.copy_rows[t](id, buffered_rows) },
    Skip(rest) -> if left <= 0 { seq.spent(budget) }
    else { send_chunks[t](id, rest, chunk, budget, left - 1, buffered_rows) },
    Yield(row, rest) -> if left <= 0 { seq.spent(budget) } else {
      let more = buffered_rows.push(row);
      if more.len() < chunk { send_chunks[t](id, rest, chunk, budget, left - 1, more) } else {
        match db.copy_rows[t](id, more) {
          Err(e) -> Err(e),
          Ok(_) -> send_chunks[t](id, rest, chunk, budget, left - 1, []),
        }
      }
    },
  }

/// Copies the rows the statement `s` returns out of the server with `COPY`, and passes them to
/// `body` as a sequence whose pulls read them `page` at a time, so no more than a page is in
/// memory. Each row is what `query` would have returned. The copy ends when `body` returns, and the
/// rows it did not pull are read and dropped. The result is `body`'s, or what failed the copy,
/// which ends the sequence early.
pub fn copy_from<a, [t] | e>(
  s: Statement,
  page: Int,
  body: (Seq<Row | {db.copy_take[t]}>) -> a / e,
) -> Result<a, DbError> / {db.copy_out[t], db.copy_end[t] | e} =
  match db.copy_out[t](s) {
    Err(e) -> Err(e),
    Ok(id) -> handle {
      bracket(
        || (),
        |u: Unit|
          if !closing.closed() {
            db.copy_end[t](id, None);
            ()
          },
        |u: Unit| {
          let result = body(page_rows[t](id, max(page, 1), [], 4611686018427387903));
          closing.close();
          match db.copy_end[t](id, None) { Err(e) -> Err(e), Ok(_) -> Ok(result) }
        },
      )
    } with {
      var closed = false,
      closing.close() -> {
        closed = true;
      },
      closing.closed() -> closed,
    },
  }

fn page_rows<[t]>(
  id: Int,
  page: Int,
  buffered_rows: List<Row>,
  fuel: Int,
) -> Seq<Row | {db.copy_take[t]}> =
  ||
    match buffered_rows {
      [row, ..rest] -> Yield(row, page_rows[t](id, page, rest, fuel)),
      [] -> if fuel <= 0 { Done } else {
        match db.copy_take[t](id, page) {
          Ok(rows) -> if rows.len() == 0 { Done }
          else { Skip(page_rows[t](id, page, rows, fuel - 1)) },
          Err(_) -> Done,
        }
      },
    }

type Pending<b> =
  | Completed(b)
  | Querying(Statement, List<Param>, once (QueryResult) -> Pending<b>)

type Step<b> = | Finished(b) | Asked({ s: Statement, ps: List<Param> })

type Continuations<b> =
  | NoContinuations
  | Waits(once (QueryResult) -> Pending<b>, Continuations<b>)

type Round<b> = { steps: List<Step<b>>, waiting: Continuations<b> }

/// `lookup` applied to each of `xs`, returning what `List::map` would. Each lookup runs until it
/// queries the store, and the queries of one round that share a statement become one `db.batch`. A
/// lookup only reads, so its queries may run in any order, and each result is the one its own
/// `db.query` would have returned.
pub fn map_batched<a, b, [t]>(
  xs: List<a>,
  lookup: keep (a) -> b / {db.query[t]},
) -> List<b> / {db.query[t], db.batch[t], abort.raise, diverges} =
  run_rounds[t](start_lookups[t](xs, lookup, { steps: [], waiting: NoContinuations }))

fn start_lookup<b, [t]>(go: keep () -> b / {db.query[t]}) -> Pending<b> =
  handle { Completed(go()) } with { db.query[t](s, ps) resume k -> Querying(s, ps, k) }

fn start_lookups<a, b, [t]>(
  xs: List<a>,
  lookup: keep (a) -> b / {db.query[t]},
  round: keep Round<b>,
) -> Round<b> =
  match xs {
    [] -> round,
    [x, ..rest] ->
      start_lookups[t](rest, lookup, append_step(round, start_lookup[t](|| lookup(x)))),
  }

fn append_step<b>(round: keep Round<b>, p: keep Pending<b>) -> Round<b> = {
  let { steps, waiting } = round;
  match p {
    Completed(v) -> { steps: steps.push(Finished(v)), waiting: waiting },
    Querying(s, ps, k) ->
      { steps: steps.push(Asked({ s: s, ps: ps })), waiting: Waits(k, waiting) },
  }
}

fn run_rounds<b, [t]>(
  round: keep Round<b>,
) -> List<b> / {db.query[t], db.batch[t], abort.raise, diverges} = {
  let { steps, waiting } = round;
  let query_indices = range(0, steps.len()).filter(|i: Int|
    match steps.at(i) { Some(Asked(_)) -> true, _ -> false });
  if query_indices.len() == 0 {
    steps.fold([], |accumulator: List<b>, s: Step<b>|
      match s { Finished(v) -> accumulator.push(v), _ -> accumulator })
  } else {
    let results = run_round_queries[t](steps, query_indices);
    run_rounds[t](
      resumed(steps, 0, results, reversed(waiting, NoContinuations), {
        steps: [],
        waiting: NoContinuations,
      }),
    )
  }
}

fn reversed<b>(waiting: keep Continuations<b>, onto: keep Continuations<b>) -> Continuations<b> =
  match waiting { NoContinuations -> onto, Waits(k, rest) -> reversed(rest, Waits(k, onto)) }

fn resumed<b>(
  steps: List<Step<b>>,
  at: Int,
  results: Map<Int, QueryResult>,
  waiting: keep Continuations<b>,
  next: keep Round<b>,
) -> Round<b> / {abort.raise} =
  match steps {
    [] -> next,
    [Finished(v), ..rest] ->
      resumed(rest, at + 1, results, waiting, append_step(next, Completed(v))),
    [Asked(_), ..rest] -> match waiting {
      Waits(k, later) -> {
        let result = match results.get(at) {
          Some(result) -> result,
          None ->
            Failed(db_error("XX000", "", "the database returned no result for a query in a batch")),
        };
        resumed(rest, at + 1, results, later, append_step(next, k(result)))
      },
      NoContinuations ->
        panic(
          "a database query is waiting for its result, but the program has no code to continue with that result",
        ),
    },
  }

fn run_round_queries<b, [t]>(
  steps: List<Step<b>>,
  query_indices: List<Int>,
) -> Map<Int, QueryResult> / {db.query[t], db.batch[t]} = {
  let groups = query_indices.fold(
    [],
    |accumulator: List<{ s: Statement, at: List<Int> }>, i: Int|
      match steps.at(i) {
        Some(Asked(a)) -> match range(0, accumulator.len()).fold(
            None,
            |found: Option<Int>, g: Int|
              match found {
                Some(_) -> found,
                None -> match accumulator.at(g) {
                  Some(x) -> if x.s == a.s { Some(g) } else { None },
                  None -> None,
                },
              },
          ) {
          Some(g) -> match accumulator.at(g) {
            Some(x) -> accumulator.set(g, { ..x, at: x.at.push(i) }),
            None -> accumulator,
          },
          None -> accumulator.push({ s: a.s, at: [i] }),
        },
        _ -> accumulator,
      },
  );
  let params = |i: Int| match steps.at(i) { Some(Asked(a)) -> a.ps, _ -> [] };
  groups.fold(
    Map::new(),
    |accumulator: Map<Int, QueryResult>, g: { s: Statement, at: List<Int> }|
      match g.at {
        [only] -> accumulator.insert(only, db.query[t](g.s, params(only))),
        _ -> {
          let results = db.batch[t](g.s, g.at.map(params));
          range(0, g.at.len()).fold(accumulator, |m: Map<Int, QueryResult>, k: Int|
            match ((g.at.at(k), results.at(k))) {
              (Some(i), Some(result)) -> m.insert(i, result),
              (Some(i), None) ->
                m.insert(
                  i,
                  Failed(
                    db_error("XX000", "", "a batch responded to fewer requests than it was given"),
                  ),
                ),
              _ -> m,
            })
        },
      },
  )
}

fn charge(stock: Bool) -> Int / {db.execute[items], db.rollback} = {
  db.execute[items](statement_of("insert one"), []);
  reserve(stock);
  db.execute[items](statement_of("insert three"), []);
  3
}

fn reserve(stock: Bool) -> Unit / {db.execute[items], db.rollback} =
  if stock {
    db.execute[items](statement_of("insert two"), []);
    ()
  } else { db.rollback("no stock") }

test "a rollback aborts the transaction and skips the rest of the body, and `transaction` returns the reason as an error" {
  let journal = handle {
    let out = transaction(ReadCommitted, ReadWrite, || {
      db.execute[items](statement_of("insert one"), []);
      db.rollback("out of stock");
      db.execute[items](statement_of("insert two"), []);
      7
    });
    assert_eq(out, Err({ reason: "out of stock", error: None }));
  } with {
    var j: List<String> = [],
    db.begin(level, access) -> {
      j = j.push("begin");
      Count(0)
    },
    db.commit() -> {
      j = j.push("commit");
      Count(0)
    },
    db.abort() -> {
      j = j.push("abort");
      Count(0)
    },
    db.execute[items](s, ps) -> {
      j = j.push(s.sql);
      Count(1)
    },
    return u -> j,
  };
  assert_eq(journal, ["begin", "insert one", "abort"])
}

test "a transaction body that returns normally commits, and `transaction` returns the body's value" {
  let journal = handle {
    let out = transaction(Serializable, ReadWrite, || {
      db.execute[items](statement_of("insert one"), []);
      "done"
    });
    assert_eq(out, Ok("done"))
  } with {
    var j: List<String> = [],
    db.begin(level, access) -> {
      j = j.push("begin");
      Count(0)
    },
    db.commit() -> {
      j = j.push("commit");
      Count(0)
    },
    db.abort() -> {
      j = j.push("abort");
      Count(0)
    },
    db.execute[items](s, ps) -> {
      j = j.push(s.sql);
      Count(1)
    },
    return u -> j,
  };
  assert_eq(journal, ["begin", "insert one", "commit"])
}

test "a begin that fails runs no body and issues no abort" {
  let journal = handle {
    let out = transaction(ReadCommitted, ReadWrite, || {
      db.execute[items](statement_of("insert one"), []);
      7
    });
    assert_eq(
      out,
      Err({
        reason: "begin",
        error: Some({ code: "53300", constraint: "", detail: "too many clients already" }),
      }),
    )
  } with {
    var j: List<String> = [],
    db.begin(level, access) -> {
      j = j.push("begin");
      Failed({ code: "53300", constraint: "", detail: "too many clients already" })
    },
    db.commit() -> {
      j = j.push("commit");
      Count(0)
    },
    db.abort() -> {
      j = j.push("abort");
      Count(0)
    },
    db.execute[items](s, ps) -> {
      j = j.push(s.sql);
      Count(1)
    },
    return u -> j,
  };
  assert_eq(journal, ["begin"])
}

test "a commit that fails is an Err carrying the SQLSTATE" {
  let journal = handle {
    let out = transaction(Serializable, ReadWrite, || {
      db.execute[items](statement_of("insert one"), []);
      7
    });
    let retryable = match out {
      Err(r) -> match r.error { Some(e) -> is_retryable(e), None -> false },
      Ok(_) -> false,
    };
    assert(retryable)
  } with {
    var j: List<String> = [],
    db.begin(level, access) -> {
      j = j.push("begin");
      Count(0)
    },
    db.commit() -> {
      j = j.push("commit");
      Failed({ code: "40001", constraint: "", detail: "could not serialize access" })
    },
    db.abort() -> {
      j = j.push("abort");
      Count(0)
    },
    db.execute[items](s, ps) -> {
      j = j.push(s.sql);
      Count(1)
    },
    return u -> j,
  };
  assert_eq(journal, ["begin", "insert one", "commit"])
}

test "a rollback in a function called two levels below the transaction body aborts the whole transaction" {
  let journal = handle {
    let out = transaction(ReadCommitted, ReadWrite, || charge(false));
    assert_eq(out, Err({ reason: "no stock", error: None }))
  } with {
    var j: List<String> = [],
    db.begin(level, access) -> {
      j = j.push("begin");
      Count(0)
    },
    db.commit() -> {
      j = j.push("commit");
      Count(0)
    },
    db.abort() -> {
      j = j.push("abort");
      Count(0)
    },
    db.execute[items](s, ps) -> {
      j = j.push(s.sql);
      Count(1)
    },
    return u -> j,
  };
  assert_eq(journal, ["begin", "insert one", "abort"])
}

test "the same body without the rollback runs to its end and commits" {
  let journal = handle {
    assert_eq(transaction(ReadCommitted, ReadWrite, || charge(true)), Ok(3))
  } with {
    var j: List<String> = [],
    db.begin(level, access) -> {
      j = j.push("begin");
      Count(0)
    },
    db.commit() -> {
      j = j.push("commit");
      Count(0)
    },
    db.abort() -> {
      j = j.push("abort");
      Count(0)
    },
    db.execute[items](s, ps) -> {
      j = j.push(s.sql);
      Count(1)
    },
    return u -> j,
  };
  assert_eq(journal, ["begin", "insert one", "insert two", "insert three", "commit"])
}

test "an inner rollback leaves the outer transaction running" {
  let journal = handle {
    let out = transaction(ReadCommitted, ReadWrite, || {
      db.execute[items](statement_of("outer one"), []);
      let inner = transaction(ReadCommitted, ReadWrite, || {
        db.execute[items](statement_of("inner one"), []);
        db.rollback("inner gave up");
        db.execute[items](statement_of("inner two"), []);
        1
      });
      db.execute[items](statement_of("outer two"), []);
      inner
    });
    assert_eq(out, Ok(Err({ reason: "inner gave up", error: None })))
  } with {
    var j: List<String> = [],
    db.begin(level, access) -> {
      j = j.push("begin");
      Count(0)
    },
    db.commit() -> {
      j = j.push("commit");
      Count(0)
    },
    db.abort() -> {
      j = j.push("abort");
      Count(0)
    },
    db.execute[items](s, ps) -> {
      j = j.push(s.sql);
      Count(1)
    },
    return u -> j,
  };
  assert_eq(journal, ["begin", "outer one", "begin", "inner one", "abort", "outer two", "commit"])
}

test "an outer rollback discards a committed inner scope" {
  let journal = handle {
    let out = transaction(ReadCommitted, ReadWrite, || {
      let inner = transaction(ReadCommitted, ReadWrite, || {
        db.execute[items](statement_of("inner one"), []);
        1
      });
      db.rollback("the outer gave up");
      inner
    });
    assert_eq(out, Err({ reason: "the outer gave up", error: None }))
  } with {
    var j: List<String> = [],
    db.begin(level, access) -> {
      j = j.push("begin");
      Count(0)
    },
    db.commit() -> {
      j = j.push("commit");
      Count(0)
    },
    db.abort() -> {
      j = j.push("abort");
      Count(0)
    },
    db.execute[items](s, ps) -> {
      j = j.push(s.sql);
      Count(1)
    },
    return u -> j,
  };
  assert_eq(journal, ["begin", "begin", "inner one", "commit", "abort"])
}

test "sandbox runs the body, returns its value and aborts" {
  let journal = handle {
    assert_eq(
      sandbox(|| {
        db.execute[items](statement_of("insert one"), []);
        "kept"
      }),
      "kept",
    )
  } with {
    var j: List<String> = [],
    db.begin(level, access) -> {
      j = j.push("begin");
      Count(0)
    },
    db.commit() -> {
      j = j.push("commit");
      Count(0)
    },
    db.abort() -> {
      j = j.push("abort");
      Count(0)
    },
    db.execute[items](s, ps) -> {
      j = j.push(s.sql);
      Count(1)
    },
    return u -> j,
  };
  assert_eq(journal, ["begin", "insert one", "abort"])
}

test "a rollback inside a `sandbox` within a `transaction` aborts the sandbox's database work, then the transaction, and `transaction` returns the rollback reason as an error" {
  let journal = handle {
    let out = transaction(ReadCommitted, ReadWrite, ||
      sandbox(|| {
        db.execute[items](statement_of("insert one"), []);
        db.rollback("give up");
        2
      }));
    assert_eq(out, Err({ reason: "give up", error: None }));
  } with {
    var j: List<String> = [],
    db.begin(level, access) -> {
      j = j.push("begin");
      Count(0)
    },
    db.commit() -> {
      j = j.push("commit");
      Count(0)
    },
    db.abort() -> {
      j = j.push("abort");
      Count(0)
    },
    db.execute[items](s, ps) -> {
      j = j.push(s.sql);
      Count(1)
    },
    return u -> j,
  };
  assert_eq(journal, ["begin", "begin", "insert one", "abort", "abort"])
}

test "is_retryable accepts the two codes the server uses to ask the program to retry" {
  assert(is_retryable({ code: "40001", constraint: "", detail: "" }));
  assert(is_retryable({ code: "40P01", constraint: "", detail: "" }));
  assert(!is_retryable({ code: "23505", constraint: "items_pkey", detail: "" }));
  assert(!is_retryable({ code: "25006", constraint: "", detail: "" }))
}

/// Returns the deepest savepoint nesting the in-memory fake of the database allows. Nesting deeper
/// fails with SQLSTATE `54000`, which protects against a program that creates savepoints in an
/// endless recursion.
pub fn max_savepoints() -> Int = 16

/// The statements that create a schema's sequences and then its tables, in order.
pub fn create_schema(s: Schema) -> List<Statement> =
  s.tables.fold(sequence_statements(s), |accumulator: List<Statement>, t: Table|
    accumulator.push(statement_of(create_table_sql(t))))

/// The statements that drop a schema's tables, last created first, and then its sequences.
pub fn drop_schema(s: Schema) -> List<Statement> = {
  let drops = reverse_list(s.tables).fold([], |accumulator: List<Statement>, t: Table|
    accumulator.push(
      statement_of("drop table if exists " ++ quote_identifier(t.name) ++ " cascade"),
    ));
  sequence_names(s).fold(drops, |accumulator: List<Statement>, n: String|
    accumulator.push(statement_of("drop sequence if exists " ++ quote_identifier(n))))
}

fn sequence_statements(s: Schema) -> List<Statement> =
  sequence_names(s).fold([], |accumulator: List<Statement>, n: String|
    accumulator.push(statement_of("create sequence " ++ quote_identifier(n))))

fn sequence_names(s: Schema) -> List<String> =
  s.tables.fold([], |accumulator: List<String>, t: Table|
    t.columns.fold(accumulator, |inner: List<String>, c: Column|
      match c.default {
        SequenceDefault(n) -> inner.push(n),
        DNone -> inner,
        LiteralDefault(_) -> inner,
      }))

fn create_table_sql(t: Table) -> String = {
  let cols = t.columns.map(|c: Column| column_sql(c));
  let pk = if t.primary_key.len() == 0 { [] }
  else { ["primary key (" ++ comma(t.primary_key.map(|n: String| quote_identifier(n))) ++ ")"] };
  let uq = t.unique.map(|u: Unique|
    "constraint " ++ quote_identifier(u.name) ++ " unique ("
      ++ comma(u.columns.map(|n: String| quote_identifier(n)))
      ++ ")");
  let fks = t.foreign_keys.map(|f: ForeignKey|
    "constraint " ++ quote_identifier(f.name) ++ " foreign key ("
      ++ comma(f.columns.map(|n: String| quote_identifier(n)))
      ++ ") references "
      ++ quote_identifier(f.references)
      ++ " ("
      ++ comma(f.refers_to.map(|n: String| quote_identifier(n)))
      ++ ")");
  let cks = t.checks.map(|c: Check|
    "constraint " ++ quote_identifier(c.name) ++ " check (" ++ c.expression ++ ")");
  "create table " ++ quote_identifier(t.name) ++ " ("
    ++ comma(cols.concat(pk).concat(uq).concat(fks).concat(cks))
    ++ ")"
}

fn column_sql(c: Column) -> String =
  quote_identifier(c.name) ++ " " ++ type_sql(c.ty) ++ (if c.nullable { "" } else { " not null" })
    ++ (match c.default {
      DNone -> "",
      SequenceDefault(n) -> " default nextval('" ++ n ++ "')",
      LiteralDefault(p) -> " default " ++ literal_sql(p),
    })

fn type_sql(t: ColumnType) -> String =
  match t {
    IntColumn -> "bigint",
    BoolColumn -> "boolean",
    TText -> "text",
    BytesColumn -> "bytea",
    FloatColumn -> "double precision",
    TNumeric(p, s) -> "numeric(" ++ p.to_string() ++ "," ++ s.to_string() ++ ")",
    JsonColumn -> "jsonb",
    TArray(inner) -> type_sql(inner) ++ "[]",
  }

fn literal_sql(p: Param) -> String =
  match p {
    NullParameter -> "null",
    IntParameter(n) -> n.to_string(),
    BoolParameter(b) -> if b { "true" } else { "false" },
    TextParameter(s) -> "'" ++ String::join(s.split("'"), "''") ++ "'",
    NumericParameter(d) -> d.to_string(),
    FloatParameter(_) -> "null",
    BytesParameter(_) -> "null",
    JsonParameter(_) -> "null",
    ArrayParameter(_) -> "null",
  }

fn quote_identifier(s: String) -> String = "\"" ++ String::join(s.split("\""), "\"\"") ++ "\""

fn comma(pieces: List<String>) -> String = String::join(pieces, ", ")

fn reverse_list<a>(xs: List<a>) -> List<a> =
  xs.fold([], |accumulator: List<a>, x: a| [x].concat(accumulator))

fn last<a>(xs: List<a>) -> Option<a> = match xs { [] -> None, [h] -> Some(h), [_, ..t] -> last(t) }

/// A table of the fake and the rows it contains.
pub type MemTable = { definition: Table, rows: List<Row> }

/// The state of the fake database when a transaction scope was opened. `MemDb.stack` has one
/// `Frame` for each open scope, and rolling back to a scope restores that scope's `Frame`.
pub type Frame = {
  tables: List<MemTable>,
  failed: Bool,
  level: Isolation,
  access: Access,
  pending: List<pg::Notification>,
}

/// The program's listener in the fake: the channels it listens on, what was delivered to it and not
/// yet taken, and whether its connection was cut, in which case the next wait returns
/// `Reconnected`.
pub type MemListener = { channels: List<String>, inbox: List<pg::Notification>, disconnected: Bool }

/// The in-memory fake of a database: its tables, sequences, the transaction scopes open on it, the
/// notifications the open transaction will deliver when it commits, and the program's listener.
pub type MemDb = {
  tables: List<MemTable>,
  sequences: Map<String, Int>,
  stack: List<Frame>,
  failed: Bool,
  pending: List<pg::Notification>,
  listener: MemListener,
}

/// The fake after an operation, and what the operation returned.
pub type Outcome = { db: MemDb, out: QueryResult }

/// An empty fake of a schema, every sequence at zero, nothing listened to.
pub fn open(s: Schema) -> MemDb =
  {
    tables: s.tables.map(|t: Table| { definition: t, rows: [] }),
    sequences: sequence_names(s).fold(Map::new(), |accumulator: Map<String, Int>, n: String|
      accumulator.insert(n, 0)),
    stack: [],
    failed: false,
    pending: [],
    listener: { channels: [], inbox: [], disconnected: false },
  }

fn memdb(
  db: MemDb,
  tables: List<MemTable>,
  sequences: Map<String, Int>,
  stack: List<Frame>,
  failed: Bool,
) -> MemDb = { ..db, tables: tables, sequences: sequences, stack: stack, failed: failed }

fn mark_failed(db: MemDb) -> MemDb =
  if db.stack.len() == 0 { db } else { memdb(db, db.tables, db.sequences, db.stack, true) }

fn fail(db: MemDb, e: DbError) -> Outcome = { db: mark_failed(db), out: Failed(e) }

fn done(db: MemDb, a: QueryResult) -> Outcome = { db: db, out: a }

fn unsupported(what: String) -> DbError = db_error("0A000", "", what)

fn in_failed_txn() -> DbError =
  db_error(
    "25P02",
    "",
    "current transaction is aborted, commands ignored until end of transaction block",
  )

fn undefined_table(n: String) -> DbError =
  db_error("42P01", "", "relation \"" ++ n ++ "\" does not exist")

fn undefined_column(n: String) -> DbError =
  db_error("42703", "", "column \"" ++ n ++ "\" does not exist")

fn read_only_txn(what: String) -> DbError =
  db_error("25006", "", "cannot execute " ++ what ++ " in a read-only transaction")

type Token =
  | WordToken(String)
  | QuotedToken(String)
  | StringToken(String)
  | NumberToken(String)
  | ParameterToken(Int)
  | SymbolToken(String)

fn sql_whitespace() -> Bytes = b" \t\r\n"
fn sql_digits() -> Bytes = b"0123456789"
fn identifier_rest() -> Bytes = b"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789$"
fn identifier_start() -> Bytes = b"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_"

fn in_set(set: Bytes, c: Int) -> Bool / {abort.raise} =
  if c < 0 { false } else { match set.index_of_byte(c) { Some(_) -> true, None -> false } }

fn lex_all(sql: String) -> Result<List<Token>, DbError> / {abort.raise} = {
  let source = Bytes::of_string(sql);
  if !source.is_utf8() { Err(unsupported("statement text that is not valid UTF-8")) }
  else { lex(source, 0, [], 2 * source.len() + 2) }
}

reuse fn lex(
  src: Bytes,
  i: Int,
  accumulator: List<Token>,
  left: Int,
) -> Result<List<Token>, DbError> / {abort.raise} =
  if left <= 0 {
    panic(
      "splitting the statement into tokens made more calls than the limit of two per byte of statement text",
    )
  } else {
    let j = src.skip(i, sql_whitespace());
    let c = src.peek(j);
    if c < 0 { Ok(accumulator) }
    else if c == 59 { Err(unsupported("more than one statement in one `Statement`")) }
    else if c == 45 && src.peek(j + 1) == 45 {
      lex(src, line_comment_end(src, j + 2), accumulator, left - 1)
    } else if c == 47 && src.peek(j + 1) == 42 {
      match block_comment_end(src, j + 2, 1) {
        None -> Err(unsupported("a block comment that is never closed")),
        Some(end) -> lex(src, end, accumulator, left - 1),
      }
    } else if in_set(identifier_start(), c) {
      let end = src.skip(j, identifier_rest());
      lex(
        src,
        end,
        accumulator.push(WordToken(String::of_bytes(src.slice(j, end)).ascii_lower())),
        left - 1,
      )
    } else if in_set(sql_digits(), c) { lex_number(src, j, accumulator, left - 1) }
    else if c == 39 { lex_string(src, j + 1, b"", accumulator, left - 1) }
    else if c == 34 { lex_quoted(src, j + 1, b"", accumulator, left - 1) }
    else if c == 36 { lex_param(src, j, accumulator, left - 1) }
    else { lex_symbol(src, j, accumulator, left - 1) }
  }

fn line_comment_end(source: Bytes, i: Int) -> Int =
  if i >= source.len() || source.peek(i) == 10 { i + 1 } else { line_comment_end(source, i + 1) }

fn block_comment_end(source: Bytes, i: Int, depth: Int) -> Option<Int> =
  if depth == 0 { Some(i) }
  else if i >= source.len() { None } else if source.peek(i) == 47 && source.peek(i + 1) == 42 {
    block_comment_end(source, i + 2, depth + 1)
  } else if source.peek(i) == 42 && source.peek(i + 1) == 47 {
    block_comment_end(source, i + 2, depth - 1)
  } else { block_comment_end(source, i + 1, depth) }

reuse fn lex_number(
  src: Bytes,
  i: Int,
  accumulator: List<Token>,
  left: Int,
) -> Result<List<Token>, DbError> / {abort.raise} =
  if left <= 0 {
    panic(
      "splitting the statement into tokens made more calls than the limit of two per byte of statement text",
    )
  } else {
    let whole = src.skip(i, sql_digits());
    let end = if src.peek(whole) == 46 { src.skip(whole + 1, sql_digits()) } else { whole };
    let after = src.peek(end);
    if after == 101 || after == 69 { Err(unsupported("a number in exponent notation")) }
    else if in_set(identifier_start(), after) { Err(unsupported("a number followed by a letter")) }
    else {
      lex(src, end, accumulator.push(NumberToken(String::of_bytes(src.slice(i, end)))), left - 1)
    }
  }

reuse fn lex_string(
  src: Bytes,
  i: Int,
  so_far: Bytes,
  accumulator: List<Token>,
  left: Int,
) -> Result<List<Token>, DbError> / {abort.raise} =
  if left <= 0 { panic("more tokens than bytes") } else {
    let stop = if i >= src.len() { src.len() } else { src.scan_until(i, b"'", src.len()) };
    if stop >= src.len() { Err(unsupported("a string literal with no closing quote")) } else {
      let piece = so_far.concat(src.slice(i, stop));
      if src.peek(stop + 1) == 39 {
        lex_string(src, stop + 2, piece.concat(b"'"), accumulator, left - 1)
      } else {
        lex(src, stop + 1, accumulator.push(StringToken(String::of_bytes(piece))), left - 1)
      }
    }
  }

reuse fn lex_quoted(
  src: Bytes,
  i: Int,
  so_far: Bytes,
  accumulator: List<Token>,
  left: Int,
) -> Result<List<Token>, DbError> / {abort.raise} =
  if left <= 0 { panic("more tokens than bytes") } else {
    let stop = if i >= src.len() { src.len() } else { src.scan_until(i, b"\"", src.len()) };
    if stop >= src.len() { Err(unsupported("a quoted identifier with no closing quote")) } else {
      let piece = so_far.concat(src.slice(i, stop));
      if src.peek(stop + 1) == 34 {
        lex_quoted(src, stop + 2, piece.concat(b"\""), accumulator, left - 1)
      } else {
        lex(src, stop + 1, accumulator.push(QuotedToken(String::of_bytes(piece))), left - 1)
      }
    }
  }

reuse fn lex_param(
  src: Bytes,
  i: Int,
  accumulator: List<Token>,
  left: Int,
) -> Result<List<Token>, DbError> / {abort.raise} =
  if left <= 0 { panic("more tokens than bytes") } else {
    let end = src.skip(i + 1, sql_digits());
    if end == i + 1 { Err(unsupported("a dollar-quoted string, or a `$` that is not a parameter")) }
    else {
      match String::of_bytes(src.slice(i + 1, end)).int_of_string() {
        None -> Err(unsupported("a parameter number too large to read")),
        Some(n) -> lex(src, end, accumulator.push(ParameterToken(n)), left - 1),
      }
    }
  }

reuse fn lex_symbol(
  src: Bytes,
  i: Int,
  accumulator: List<Token>,
  left: Int,
) -> Result<List<Token>, DbError> / {abort.raise} =
  if left <= 0 { panic("more tokens than bytes") } else {
    let c = src.peek(i);
    let d = src.peek(i + 1);
    let two = if (c == 60 && d == 62) || (c == 33 && d == 61) { "<>" }
    else if c == 60 && d == 61 { "<=" }
    else if c == 62 && d == 61 { ">=" }
    else { "" };
    if two != "" { lex(src, i + 2, accumulator.push(SymbolToken(two)), left - 1) }
    else if c == 40 || c == 41 || c == 44 || c == 42 || c == 61 || c == 60 || c == 62 || c == 46
        || c == 45
        || c == 43 {
      lex(
        src,
        i + 1,
        accumulator.push(SymbolToken(String::of_bytes(src.slice(i, i + 1)))),
        left - 1,
      )
    } else {
      Err(
        unsupported(
          "the token `" ++ String::of_bytes_lossy(src.slice(i, i + 1)) ++ "` at byte "
            ++ i.to_string(),
        ),
      )
    }
  }

type Target = { column: String, name: String }

type Projection = | StarProjection | ColumnProjection(List<Target>) | CountProjection(String)

type Comparison = | EqualTo | NotEqualTo | LessThan | LessOrEqual | GreaterThan | GreaterOrEqual

type Expression =
  | ColumnName(String)
  | Placeholder(Int)
  | LiteralValue(Datum)
  | DefaultKeyword
  | Not(Expression)
  | And(Expression, Expression)
  | Or(Expression, Expression)
  | Compare(Comparison, Expression, Expression)
  | IsNull(Expression, Bool)
  | InList(Expression, List<Expression>, Bool)
  | Between(Expression, Expression, Expression, Bool)
  | Like(Expression, Expression, Bool)

type OrderKey = { column: String, descending: Bool, nulls_first: Bool }

type SelectQuery = {
  source: String,
  proj: Projection,
  filter: Option<Expression>,
  order: List<OrderKey>,
  limit: Option<Expression>,
  offset: Option<Expression>,
}

type InsertQuery = {
  source: String,
  columns: List<String>,
  tuples: List<List<Expression>>,
  returning: Option<Projection>,
}

type Assignment = { column: String, value: Expression }

type UpdateQuery = {
  source: String,
  sets: List<Assignment>,
  filter: Option<Expression>,
  returning: Option<Projection>,
}

type DeleteQuery = { source: String, filter: Option<Expression>, returning: Option<Projection> }

type Query = | Select(SelectQuery) | Insert(InsertQuery) | Update(UpdateQuery) | Delete(DeleteQuery)

type Parsed<a> = { value: a, rest: List<Token> }

fn parsed<a>(v: a, rest: List<Token>) -> Parsed<a> = { value: v, rest: rest }

fn token_word(ts: List<Token>) -> String = match ts { [WordToken(w), ..] -> w, _ -> "" }

fn token_symbol(ts: List<Token>) -> String = match ts { [SymbolToken(s), ..] -> s, _ -> "" }

fn rest_of(ts: List<Token>) -> List<Token> = match ts { [] -> [], [_, ..t] -> t }

fn expected(what: String, ts: List<Token>) -> DbError =
  unsupported("expected " ++ what ++ ", found " ++ show_token(ts))

fn show_token(ts: List<Token>) -> String =
  match ts {
    [] -> "the end of the statement",
    [WordToken(w), ..] -> "`" ++ w ++ "`",
    [QuotedToken(w), ..] -> "`\"" ++ w ++ "\"`",
    [StringToken(_), ..] -> "a string literal",
    [NumberToken(n), ..] -> "`" ++ n ++ "`",
    [ParameterToken(n), ..] -> "`$" ++ n.to_string() ++ "`",
    [SymbolToken(s), ..] -> "`" ++ s ++ "`",
    _ -> "a token",
  }

fn expect_word(ts: List<Token>, w: String) -> Result<List<Token>, DbError> =
  if token_word(ts) == w { Ok(rest_of(ts)) } else { Err(expected("`" ++ w ++ "`", ts)) }

fn expect_symbol(ts: List<Token>, s: String) -> Result<List<Token>, DbError> =
  if token_symbol(ts) == s { Ok(rest_of(ts)) } else { Err(expected("`" ++ s ++ "`", ts)) }

fn parse_name(ts: List<Token>) -> Result<Parsed<String>, DbError> =
  match ts {
    [WordToken(w), ..t] -> Ok(parsed(w, t)),
    [QuotedToken(w), ..t] -> Ok(parsed(w, t)),
    _ -> Err(expected("a name", ts)),
  }

fn parse_colref(ts: List<Token>) -> Result<Parsed<String>, DbError> = {
  let c = parse_name(ts)?;
  if token_symbol(c.rest) == "." { parse_name(rest_of(c.rest)) } else { Ok(c) }
}

fn expression_room(ts: List<Token>) -> Int = (ts.len() + 1) * 11

fn parse_expression_text(s: String) -> Result<Expression, DbError> / {abort.raise} = {
  let ts = lex_all(s)?;
  let c = parse_or(ts, expression_room(ts))?;
  if c.rest.len() == 0 { Ok(c.value) } else { Err(expected("the end of the expression", c.rest)) }
}

fn parse_or(ts: List<Token>, left: Int) -> Result<Parsed<Expression>, DbError> / {abort.raise} =
  if left <= 0 {
    panic("parsing the expression made more nested calls than the limit of eleven per token")
  } else { parse_or_more(parse_and(ts, left - 1)?, left - 1) }

fn parse_or_more(
  c: Parsed<Expression>,
  left: Int,
) -> Result<Parsed<Expression>, DbError> / {abort.raise} =
  if left <= 0 {
    panic("parsing the expression made more nested calls than the limit of eleven per token")
  } else {
    if token_word(c.rest) == "or" {
      let r = parse_and(rest_of(c.rest), left - 1)?;
      parse_or_more(parsed(Or(c.value, r.value), r.rest), left - 1)
    } else { Ok(c) }
  }

fn parse_and(ts: List<Token>, left: Int) -> Result<Parsed<Expression>, DbError> / {abort.raise} =
  if left <= 0 {
    panic("parsing the expression made more nested calls than the limit of eleven per token")
  } else { parse_and_more(parse_not(ts, left - 1)?, left - 1) }

fn parse_and_more(
  c: Parsed<Expression>,
  left: Int,
) -> Result<Parsed<Expression>, DbError> / {abort.raise} =
  if left <= 0 {
    panic("parsing the expression made more nested calls than the limit of eleven per token")
  } else {
    if token_word(c.rest) == "and" {
      let r = parse_not(rest_of(c.rest), left - 1)?;
      parse_and_more(parsed(And(c.value, r.value), r.rest), left - 1)
    } else { Ok(c) }
  }

fn parse_not(ts: List<Token>, left: Int) -> Result<Parsed<Expression>, DbError> / {abort.raise} =
  if left <= 0 {
    panic("parsing the expression made more nested calls than the limit of eleven per token")
  } else {
    if token_word(ts) == "not" {
      let c = parse_not(rest_of(ts), left - 1)?;
      Ok(parsed(Not(c.value), c.rest))
    } else { parse_pred_tail(parse_primary(ts, left - 1)?, left - 1) }
  }

fn parse_pred_tail(
  c: Parsed<Expression>,
  left: Int,
) -> Result<Parsed<Expression>, DbError> / {abort.raise} =
  if left <= 0 {
    panic("parsing the expression made more nested calls than the limit of eleven per token")
  } else {
    let w = token_word(c.rest);
    let s = token_symbol(c.rest);
    if s == "=" || s == "<>" || s == "<" || s == "<=" || s == ">" || s == ">=" {
      let r = parse_primary(rest_of(c.rest), left - 1)?;
      Ok(parsed(Compare(comparison_of(s), c.value, r.value), r.rest))
    } else if w == "is" { parse_is(c, rest_of(c.rest)) }
    else if w == "in" { parse_in(c, false, rest_of(c.rest), left - 1) }
    else if w == "between" { parse_between(c, false, rest_of(c.rest), left - 1) }
    else if w == "like" { parse_like(c, false, rest_of(c.rest), left - 1) } else if w == "not" {
      let after = rest_of(c.rest);
      let w2 = token_word(after);
      if w2 == "in" { parse_in(c, true, rest_of(after), left - 1) }
      else if w2 == "between" { parse_between(c, true, rest_of(after), left - 1) }
      else if w2 == "like" { parse_like(c, true, rest_of(after), left - 1) }
      else { Err(expected("`in`, `between` or `like` after `not`", after)) }
    } else { Ok(c) }
  }

fn comparison_of(s: String) -> Comparison =
  if s == "=" { EqualTo }
  else if s == "<>" { NotEqualTo }
  else if s == "<" { LessThan }
  else if s == "<=" { LessOrEqual }
  else if s == ">" { GreaterThan }
  else { GreaterOrEqual }

fn parse_is(c: Parsed<Expression>, ts: List<Token>) -> Result<Parsed<Expression>, DbError> =
  if token_word(ts) == "null" { Ok(parsed(IsNull(c.value, true), rest_of(ts))) }
  else if token_word(ts) == "not" && token_word(rest_of(ts)) == "null" {
    Ok(parsed(IsNull(c.value, false), rest_of(rest_of(ts))))
  } else { Err(expected("`null` or `not null` after `is`", ts)) }

fn parse_in(
  c: Parsed<Expression>,
  negated: Bool,
  ts: List<Token>,
  left: Int,
) -> Result<Parsed<Expression>, DbError> / {abort.raise} =
  if left <= 0 {
    panic("parsing the expression made more nested calls than the limit of eleven per token")
  } else {
    let after = expect_symbol(ts, "(")?;
    let items = parse_expression_list(after, [], left - 1)?;
    Ok(parsed(InList(c.value, items.value, negated), items.rest))
  }

fn parse_expression_list(
  ts: List<Token>,
  accumulator: List<Expression>,
  left: Int,
) -> Result<Parsed<List<Expression>>, DbError> / {abort.raise} =
  if left <= 0 {
    panic("parsing the expression made more nested calls than the limit of eleven per token")
  } else {
    let c = parse_or(ts, left - 1)?;
    let items = accumulator.push(c.value);
    if token_symbol(c.rest) == "," { parse_expression_list(rest_of(c.rest), items, left - 1) }
    else {
      let after = expect_symbol(c.rest, ")")?;
      Ok(parsed(items, after))
    }
  }

fn parse_between(
  c: Parsed<Expression>,
  negated: Bool,
  ts: List<Token>,
  left: Int,
) -> Result<Parsed<Expression>, DbError> / {abort.raise} =
  if left <= 0 {
    panic("parsing the expression made more nested calls than the limit of eleven per token")
  } else {
    let lo = parse_primary(ts, left - 1)?;
    let after = expect_word(lo.rest, "and")?;
    let hi = parse_primary(after, left - 1)?;
    Ok(parsed(Between(c.value, lo.value, hi.value, negated), hi.rest))
  }

fn parse_like(
  c: Parsed<Expression>,
  negated: Bool,
  ts: List<Token>,
  left: Int,
) -> Result<Parsed<Expression>, DbError> / {abort.raise} =
  if left <= 0 {
    panic("parsing the expression made more nested calls than the limit of eleven per token")
  } else {
    let p = parse_primary(ts, left - 1)?;
    if token_word(p.rest) == "escape" { Err(unsupported("`like ... escape`")) }
    else { Ok(parsed(Like(c.value, p.value, negated), p.rest)) }
  }

fn parse_primary(
  ts: List<Token>,
  left: Int,
) -> Result<Parsed<Expression>, DbError> / {abort.raise} =
  if left <= 0 { panic("more calls than tokens allow") } else {
    match ts {
      [] -> Err(unsupported("the statement ended where a value was expected")),
      [ParameterToken(n), ..t] -> Ok(parsed(Placeholder(n), t)),
      [StringToken(s), ..t] -> Ok(parsed(LiteralValue(TextDatum(s)), t)),
      [NumberToken(s), ..t] -> number_literal(s, false, t),
      [QuotedToken(w), ..t] -> parse_column_tail(w, t),
      [SymbolToken(s), ..t] -> if s == "(" {
        let c = parse_or(t, left - 1)?;
        let after = expect_symbol(c.rest, ")")?;
        Ok(parsed(c.value, after))
      } else if s == "-" {
        match t {
          [NumberToken(n), ..t2] -> number_literal(n, true, t2),
          _ -> Err(expected("a number after `-`", t)),
        }
      } else { Err(expected("a value", ts)) },
      [WordToken(w), ..t] -> if w == "null" { Ok(parsed(LiteralValue(NullDatum), t)) }
      else if w == "true" { Ok(parsed(LiteralValue(BoolDatum(true)), t)) }
      else if w == "false" { Ok(parsed(LiteralValue(BoolDatum(false)), t)) }
      else if w == "default" { Ok(parsed(DefaultKeyword, t)) }
      else if w == "count" || w == "sum" || w == "avg" || w == "min" || w == "max" {
        Err(unsupported("the aggregate `" ++ w ++ "` outside a bare `count(*)` projection"))
      } else if w == "select" { Err(unsupported("a subquery")) }
      else { parse_column_tail(w, t) },
      _ -> Err(expected("a value", ts)),
    }
  }

fn parse_column_tail(name: String, ts: List<Token>) -> Result<Parsed<Expression>, DbError> =
  if token_symbol(ts) == "." {
    let c = parse_name(rest_of(ts))?;
    Ok(parsed(ColumnName(c.value), c.rest))
  } else if token_symbol(ts) == "(" { Err(unsupported("the function `" ++ name ++ "`")) }
  else { Ok(parsed(ColumnName(name), ts)) }

fn number_literal(
  s: String,
  negative: Bool,
  ts: List<Token>,
) -> Result<Parsed<Expression>, DbError> / {abort.raise} = {
  let text = if negative { "-" ++ s } else { s };
  if s.contains(".") {
    match Decimal::of_string(text) {
      None -> Err(unsupported("the numeric literal `" ++ text ++ "`")),
      Some(d) -> Ok(parsed(LiteralValue(NumericDatum(d)), ts)),
    }
  } else {
    match text.int_of_string() {
      None -> Err(unsupported("the integer literal `" ++ text ++ "`")),
      Some(n) -> Ok(parsed(LiteralValue(IntDatum(n)), ts)),
    }
  }
}

fn parse_statement(sql: String) -> Result<Query, DbError> / {abort.raise} = {
  let ts = lex_all(sql)?;
  let c = parse_query(ts)?;
  if c.rest.len() == 0 { Ok(c.value) } else { Err(expected("the end of the statement", c.rest)) }
}

fn parse_query(ts: List<Token>) -> Result<Parsed<Query>, DbError> / {abort.raise} = {
  let w = token_word(ts);
  if w == "select" { parse_select(rest_of(ts)) }
  else if w == "insert" { parse_insert(rest_of(ts)) }
  else if w == "update" { parse_update(rest_of(ts)) }
  else if w == "delete" { parse_delete(rest_of(ts)) }
  else if w == "with" { Err(unsupported("a common table expression")) }
  else if w == "values" { Err(unsupported("a bare `values` statement")) }
  else { Err(expected("`select`, `insert`, `update` or `delete`", ts)) }
}

fn parse_select(ts: List<Token>) -> Result<Parsed<Query>, DbError> / {abort.raise} = {
  let p = parse_proj(ts)?;
  let after = expect_word(p.rest, "from")?;
  let table = parse_name(after)?;
  parse_select_tail(table.value, p.value, table.rest)
}

fn parse_select_tail(
  source: String,
  proj: Projection,
  ts: List<Token>,
) -> Result<Parsed<Query>, DbError> / {abort.raise} = {
  let w = parse_where(ts)?;
  let o = parse_order(w.rest)?;
  let lo = parse_limit_offset(o.rest)?;
  Ok(
    parsed(
      Select({
        source: source,
        proj: proj,
        filter: w.value,
        order: o.value,
        limit: lo.value.limit,
        offset: lo.value.offset,
      }),
      lo.rest,
    ),
  )
}

fn parse_proj(ts: List<Token>) -> Result<Parsed<Projection>, DbError> =
  if token_symbol(ts) == "*" { Ok(parsed(StarProjection, rest_of(ts))) }
  else if token_word(ts) == "count" {
    let a = expect_symbol(rest_of(ts), "(")?;
    match expect_symbol(a, "*") {
      Err(_) -> Err(unsupported("`count` of anything but `*`")),
      Ok(b) -> {
        let c = expect_symbol(b, ")")?;
        let a = parse_alias(c, "count")?;
        Ok(parsed(CountProjection(a.value), a.rest))
      },
    }
  } else { parse_proj_columns(ts, [], ts.len() + 1) }

fn parse_proj_columns(
  ts: List<Token>,
  accumulator: List<Target>,
  left: Int,
) -> Result<Parsed<Projection>, DbError> =
  if left <= 0 {
    Err(db_error("XX000", "", "the parsed list has more items than the statement has tokens"))
  } else {
    let c = parse_colref(ts)?;
    let a = parse_alias(c.rest, c.value)?;
    let targets = accumulator.push({ column: c.value, name: a.value });
    if token_symbol(a.rest) == "," { parse_proj_columns(rest_of(a.rest), targets, left - 1) }
    else { Ok(parsed(ColumnProjection(targets), a.rest)) }
  }

fn parse_alias(ts: List<Token>, dflt: String) -> Result<Parsed<String>, DbError> =
  if token_word(ts) == "as" {
    let n = parse_name(rest_of(ts))?;
    Ok(parsed(n.value, n.rest))
  } else { Ok(parsed(dflt, ts)) }

fn parse_where(ts: List<Token>) -> Result<Parsed<Option<Expression>>, DbError> / {abort.raise} =
  if token_word(ts) == "where" {
    let c = parse_or(rest_of(ts), expression_room(ts))?;
    Ok(parsed(Some(c.value), c.rest))
  } else { Ok(parsed(None, ts)) }

fn parse_order(ts: List<Token>) -> Result<Parsed<List<OrderKey>>, DbError> =
  if token_word(ts) == "order" {
    let after = expect_word(rest_of(ts), "by")?;
    parse_order_keys(after, [], after.len() + 1)
  } else { Ok(parsed([], ts)) }

fn parse_order_keys(
  ts: List<Token>,
  accumulator: List<OrderKey>,
  left: Int,
) -> Result<Parsed<List<OrderKey>>, DbError> =
  if left <= 0 {
    Err(db_error("XX000", "", "the parsed list has more items than the statement has tokens"))
  } else {
    let c = parse_colref(ts)?;
    let dir = token_word(c.rest);
    let descending = dir == "desc";
    let after_dir = if dir == "asc" || dir == "desc" { rest_of(c.rest) } else { c.rest };
    {
      let n = parse_nulls(after_dir, descending)?;
      let keys = accumulator.push({
        column: c.value,
        descending: descending,
        nulls_first: n.value,
      });
      if token_symbol(n.rest) == "," { parse_order_keys(rest_of(n.rest), keys, left - 1) }
      else { Ok(parsed(keys, n.rest)) }
    }
  }

fn parse_nulls(ts: List<Token>, descending: Bool) -> Result<Parsed<Bool>, DbError> =
  if token_word(ts) == "nulls" {
    let w = token_word(rest_of(ts));
    if w == "first" { Ok(parsed(true, rest_of(rest_of(ts)))) }
    else if w == "last" { Ok(parsed(false, rest_of(rest_of(ts)))) }
    else { Err(expected("`first` or `last` after `nulls`", rest_of(ts))) }
  } else { Ok(parsed(descending, ts)) }

type Slice = { limit: Option<Expression>, offset: Option<Expression> }

fn parse_limit_offset(ts: List<Token>) -> Result<Parsed<Slice>, DbError> / {abort.raise} = {
  let l = parse_one_bound(ts, "limit")?;
  let o = parse_one_bound(l.rest, "offset")?;
  Ok(parsed({ limit: l.value, offset: o.value }, o.rest))
}

fn parse_one_bound(
  ts: List<Token>,
  word: String,
) -> Result<Parsed<Option<Expression>>, DbError> / {abort.raise} =
  if token_word(ts) == word {
    let c = parse_primary(rest_of(ts), expression_room(ts))?;
    Ok(parsed(Some(c.value), c.rest))
  } else { Ok(parsed(None, ts)) }

fn parse_insert(ts: List<Token>) -> Result<Parsed<Query>, DbError> / {abort.raise} = {
  let a = expect_word(ts, "into")?;
  let table = parse_name(a)?;
  let cols = parse_insert_columns(table.rest)?;
  match expect_word(cols.rest, "values") {
    Err(_) -> Err(unsupported("an `insert` whose source is not a `values` list")),
    Ok(b) -> {
      let tuples = parse_tuples(b, [], b.len() + 1)?;
      let r = parse_returning(tuples.rest)?;
      Ok(
        parsed(
          Insert({
            source: table.value,
            columns: cols.value,
            tuples: tuples.value,
            returning: r.value,
          }),
          r.rest,
        ),
      )
    },
  }
}

fn parse_insert_columns(ts: List<Token>) -> Result<Parsed<List<String>>, DbError> =
  if token_symbol(ts) == "(" { parse_name_list(rest_of(ts), [], ts.len() + 1) }
  else { Ok(parsed([], ts)) }

fn parse_name_list(
  ts: List<Token>,
  accumulator: List<String>,
  left: Int,
) -> Result<Parsed<List<String>>, DbError> =
  if left <= 0 {
    Err(db_error("XX000", "", "the parsed list has more items than the statement has tokens"))
  } else {
    let c = parse_name(ts)?;
    let names = accumulator.push(c.value);
    if token_symbol(c.rest) == "," { parse_name_list(rest_of(c.rest), names, left - 1) } else {
      let after = expect_symbol(c.rest, ")")?;
      Ok(parsed(names, after))
    }
  }

fn parse_tuples(
  ts: List<Token>,
  accumulator: List<List<Expression>>,
  left: Int,
) -> Result<Parsed<List<List<Expression>>>, DbError> / {abort.raise} =
  if left <= 0 { panic("the parsed list has more items than the statement has tokens") } else {
    let a = expect_symbol(ts, "(")?;
    let c = parse_expression_list(a, [], expression_room(a))?;
    let tuples = accumulator.push(c.value);
    if token_symbol(c.rest) == "," { parse_tuples(rest_of(c.rest), tuples, left - 1) }
    else { Ok(parsed(tuples, c.rest)) }
  }

fn parse_returning(ts: List<Token>) -> Result<Parsed<Option<Projection>>, DbError> =
  if token_word(ts) == "returning" {
    let c = parse_proj(rest_of(ts))?;
    match c.value {
      CountProjection(_) -> Err(unsupported("`returning count(*)`")),
      StarProjection -> Ok(parsed(Some(c.value), c.rest)),
      ColumnProjection(_) -> Ok(parsed(Some(c.value), c.rest)),
    }
  } else { Ok(parsed(None, ts)) }

fn parse_update(ts: List<Token>) -> Result<Parsed<Query>, DbError> / {abort.raise} = {
  let table = parse_name(ts)?;
  let a = expect_word(table.rest, "set")?;
  let sets = parse_assignments(a, [], a.len() + 1)?;
  if token_word(sets.rest) == "from" { Err(unsupported("`update ... from`")) } else {
    let w = parse_where(sets.rest)?;
    let r = parse_returning(w.rest)?;
    Ok(
      parsed(
        Update({ source: table.value, sets: sets.value, filter: w.value, returning: r.value }),
        r.rest,
      ),
    )
  }
}

fn parse_assignments(
  ts: List<Token>,
  accumulator: List<Assignment>,
  left: Int,
) -> Result<Parsed<List<Assignment>>, DbError> / {abort.raise} =
  if left <= 0 { panic("the parsed list has more items than the statement has tokens") } else {
    let n = parse_name(ts)?;
    let a = expect_symbol(n.rest, "=")?;
    let v = parse_primary(a, expression_room(a))?;
    let sets = accumulator.push({ column: n.value, value: v.value });
    if token_symbol(v.rest) == "," { parse_assignments(rest_of(v.rest), sets, left - 1) }
    else { Ok(parsed(sets, v.rest)) }
  }

fn parse_delete(ts: List<Token>) -> Result<Parsed<Query>, DbError> / {abort.raise} = {
  let a = expect_word(ts, "from")?;
  let table = parse_name(a)?;
  if token_word(table.rest) == "using" { Err(unsupported("`delete ... using`")) } else {
    let w = parse_where(table.rest)?;
    let r = parse_returning(w.rest)?;
    Ok(parsed(Delete({ source: table.value, filter: w.value, returning: r.value }), r.rest))
  }
}

type SqlBool = | SqlTrue | SqlFalse | SqlUnknown

fn sql_bool_of(b: Bool) -> SqlBool = if b { SqlTrue } else { SqlFalse }

fn is_null(v: Datum) -> Bool = match v { NullDatum -> true, _ -> false }

fn sql_not(t: SqlBool) -> SqlBool =
  match t { SqlTrue -> SqlFalse, SqlFalse -> SqlTrue, SqlUnknown -> SqlUnknown }

fn sql_and(a: SqlBool, b: SqlBool) -> SqlBool =
  match a {
    SqlFalse -> SqlFalse,
    SqlTrue -> b,
    SqlUnknown -> match b { SqlFalse -> SqlFalse, _ -> SqlUnknown },
  }

fn sql_or(a: SqlBool, b: SqlBool) -> SqlBool =
  match a {
    SqlTrue -> SqlTrue,
    SqlFalse -> b,
    SqlUnknown -> match b { SqlTrue -> SqlTrue, _ -> SqlUnknown },
  }

/// Returns the `Datum` the fake stores for the parameter `p`.
pub fn param_datum(p: Param) -> Datum =
  match p {
    NullParameter -> NullDatum,
    IntParameter(n) -> IntDatum(n),
    BoolParameter(b) -> BoolDatum(b),
    TextParameter(s) -> TextDatum(s),
    BytesParameter(b) -> BytesDatum(b),
    FloatParameter(f) -> FloatDatum(f),
    NumericParameter(d) -> NumericDatum(d),
    JsonParameter(j) -> JsonDatum(j),
    ArrayParameter(xs) -> ArrayDatum(xs.map(|x: Param| param_datum(x))),
  }

fn eval_value(row: Row, ps: List<Param>, e: Expression) -> Result<Datum, DbError> / {abort.raise} =
  match e {
    Not(_) -> eval_bool_value(row, ps, e),
    And(_, _) -> eval_bool_value(row, ps, e),
    Or(_, _) -> eval_bool_value(row, ps, e),
    Compare(_, _, _) -> eval_bool_value(row, ps, e),
    IsNull(_, _) -> eval_bool_value(row, ps, e),
    InList(_, _, _) -> eval_bool_value(row, ps, e),
    Between(_, _, _, _) -> eval_bool_value(row, ps, e),
    Like(_, _, _) -> eval_bool_value(row, ps, e),
    _ -> leaf_value(row, ps, e),
  }

fn leaf_value(r: Row, ps: List<Param>, e: Expression) -> Result<Datum, DbError> / {abort.raise} =
  match e {
    LiteralValue(v) -> Ok(v),
    ColumnName(n) -> match r.get(n) { None -> Err(undefined_column(n)), Some(v) -> Ok(v) },
    Placeholder(n) -> match ps.at(n - 1) {
      None -> Err(db_error("42P02", "", "there is no parameter $" ++ n.to_string())),
      Some(p) -> Ok(param_datum(p)),
    },
    DefaultKeyword -> Err(unsupported("`default` outside an `insert ... values` list")),
    _ -> panic("a condition was evaluated as a single value"),
  }

fn eval_bool_value(
  row: Row,
  ps: List<Param>,
  e: Expression,
) -> Result<Datum, DbError> / {abort.raise} = {
  let t = eval_pred(row, ps, e)?;
  Ok(match t { SqlTrue -> BoolDatum(true), SqlFalse -> BoolDatum(false), SqlUnknown -> NullDatum })
}

fn eval_pred(row: Row, ps: List<Param>, e: Expression) -> Result<SqlBool, DbError> / {abort.raise} =
  match e {
    Not(x) -> {
      let t = eval_pred(row, ps, x)?;
      Ok(sql_not(t))
    },
    And(a, b) -> {
      let ta = eval_pred(row, ps, a)?;
      let tb = eval_pred(row, ps, b)?;
      Ok(sql_and(ta, tb))
    },
    Or(a, b) -> {
      let ta = eval_pred(row, ps, a)?;
      let tb = eval_pred(row, ps, b)?;
      Ok(sql_or(ta, tb))
    },
    Compare(comparison, a, b) -> eval_compare(row, ps, comparison, a, b),
    IsNull(x, want) -> {
      let v = eval_value(row, ps, x)?;
      Ok(sql_bool_of(if want { is_null(v) } else { !is_null(v) }))
    },
    InList(x, items, negated) -> eval_in(row, ps, x, items, negated),
    Between(x, lo, hi, negated) -> eval_between(row, ps, x, lo, hi, negated),
    Like(x, p, negated) -> eval_like(row, ps, x, p, negated),
    LiteralValue(_) -> eval_pred_of_value(row, ps, e),
    ColumnName(_) -> eval_pred_of_value(row, ps, e),
    Placeholder(_) -> eval_pred_of_value(row, ps, e),
    DefaultKeyword -> Err(unsupported("`default` in a predicate")),
  }

fn eval_pred_of_value(
  row: Row,
  ps: List<Param>,
  e: Expression,
) -> Result<SqlBool, DbError> / {abort.raise} = {
  let v = leaf_value(row, ps, e)?;
  match v {
    NullDatum -> Ok(SqlUnknown),
    BoolDatum(b) -> Ok(sql_bool_of(b)),
    _ ->
      Err(db_error("42804", "", "argument of a condition must be boolean, not " ++ datum_type(v))),
  }
}

fn eval_compare(
  row: Row,
  ps: List<Param>,
  comparison: Comparison,
  a: Expression,
  b: Expression,
) -> Result<SqlBool, DbError> / {abort.raise} = {
  let av = eval_value(row, ps, a)?;
  let bv = eval_value(row, ps, b)?;
  let o = compare_datums(av, bv)?;
  match o {
    None -> Ok(SqlUnknown),
    Some(c) ->
      Ok(
        sql_bool_of(match comparison {
          EqualTo -> c == 0,
          NotEqualTo -> c != 0,
          LessThan -> c < 0,
          LessOrEqual -> c <= 0,
          GreaterThan -> c > 0,
          GreaterOrEqual -> c >= 0,
        }),
      ),
  }
}

fn eval_in(
  row: Row,
  ps: List<Param>,
  x: Expression,
  items: List<Expression>,
  negated: Bool,
) -> Result<SqlBool, DbError> / {abort.raise} = {
  let v = eval_value(row, ps, x)?;
  let t = in_scan(row, ps, v, items, SqlFalse)?;
  Ok(if negated { sql_not(t) } else { t })
}

fn in_scan(
  row: Row,
  ps: List<Param>,
  v: Datum,
  items: List<Expression>,
  so_far: SqlBool,
) -> Result<SqlBool, DbError> / {abort.raise} =
  match items {
    [] -> Ok(so_far),
    [h, ..t] -> {
      let hv = eval_value(row, ps, h)?;
      let o = compare_datums(v, hv)?;
      match o {
        None -> in_scan(row, ps, v, t, sql_or(so_far, SqlUnknown)),
        Some(c) -> if c == 0 { Ok(SqlTrue) } else { in_scan(row, ps, v, t, so_far) },
      }
    },
  }

fn eval_between(
  row: Row,
  ps: List<Param>,
  x: Expression,
  lo: Expression,
  hi: Expression,
  negated: Bool,
) -> Result<SqlBool, DbError> / {abort.raise} = {
  let a = eval_compare(row, ps, GreaterOrEqual, x, lo)?;
  let b = eval_compare(row, ps, LessOrEqual, x, hi)?;
  Ok(if negated { sql_not(sql_and(a, b)) } else { sql_and(a, b) })
}

fn eval_like(
  row: Row,
  ps: List<Param>,
  x: Expression,
  p: Expression,
  negated: Bool,
) -> Result<SqlBool, DbError> / {abort.raise} = {
  let xv = eval_value(row, ps, x)?;
  let pv = eval_value(row, ps, p)?;
  like_of(xv, pv, negated)
}

fn like_of(xv: Datum, pv: Datum, negated: Bool) -> Result<SqlBool, DbError> / {abort.raise} =
  match xv {
    NullDatum -> Ok(SqlUnknown),
    TextDatum(s) -> match pv {
      NullDatum -> Ok(SqlUnknown),
      TextDatum(p) -> {
        let hit = like_match(s, p, 0, 0);
        Ok(sql_bool_of(if negated { !hit } else { hit }))
      },
      _ -> Err(db_error("42883", "", "operator does not exist: text like " ++ datum_type(pv))),
    },
    _ -> Err(db_error("42883", "", "operator does not exist: " ++ datum_type(xv) ++ " like ...")),
  }

fn like_match(s: String, p: String, si: Int, pi: Int) -> Bool / {abort.raise} =
  if pi >= p.len() { si >= s.len() } else {
    let pc = p.slice(pi, pi + 1);
    if pc == "%" { like_star(s, p, si, pi + 1) }
    else if pc == "_" { if si >= s.len() { false } else { like_match(s, p, si + 1, pi + 1) } }
    else if pc == "\\" {
      if pi + 1 >= p.len() { false }
      else if si < s.len() && s.slice(si, si + 1) == p.slice(pi + 1, pi + 2) {
        like_match(s, p, si + 1, pi + 2)
      } else { false }
    } else if si < s.len() && s.slice(si, si + 1) == pc { like_match(s, p, si + 1, pi + 1) }
    else { false }
  }

fn like_star(s: String, p: String, si: Int, pi: Int) -> Bool / {abort.raise} =
  if like_match(s, p, si, pi) { true }
  else if si >= s.len() { false }
  else { like_star(s, p, si + 1, pi) }

fn ordering_sign(o: Ordering) -> Int = match o { Less -> -1, Equal -> 0, Greater -> 1 }

fn sign_of(a: Int, b: Int) -> Int = if a < b { -1 } else if a > b { 1 } else { 0 }

fn compare_floats(a: Float, b: Float) -> Int =
  if a != a { if b != b { 0 } else { 1 } }
  else if b != b { -1 }
  else if a < b { -1 }
  else if a > b { 1 }
  else { 0 }

fn compare_decimals(a: Decimal, b: Decimal) -> Int = if a < b { -1 } else if a > b { 1 } else { 0 }

fn compare_datums(a: Datum, b: Datum) -> Result<Option<Int>, DbError> =
  match a {
    NullDatum -> Ok(None),
    IntDatum(x) -> match b {
      NullDatum -> Ok(None),
      IntDatum(y) -> Ok(Some(sign_of(x, y))),
      NumericDatum(y) -> Ok(Some(compare_decimals(Decimal::of_int(x), y))),
      FloatDatum(y) -> Ok(Some(compare_floats(Float::of_decimal(Decimal::of_int(x)), y))),
      _ -> Err(no_operator(a, b)),
    },
    NumericDatum(x) -> match b {
      NullDatum -> Ok(None),
      NumericDatum(y) -> Ok(Some(compare_decimals(x, y))),
      IntDatum(y) -> Ok(Some(compare_decimals(x, Decimal::of_int(y)))),
      FloatDatum(y) -> Ok(Some(compare_floats(Float::of_decimal(x), y))),
      _ -> Err(no_operator(a, b)),
    },
    FloatDatum(x) -> match b {
      NullDatum -> Ok(None),
      FloatDatum(y) -> Ok(Some(compare_floats(x, y))),
      IntDatum(y) -> Ok(Some(compare_floats(x, Float::of_decimal(Decimal::of_int(y))))),
      NumericDatum(y) -> Ok(Some(compare_floats(x, Float::of_decimal(y)))),
      _ -> Err(no_operator(a, b)),
    },
    TextDatum(x) -> match b {
      NullDatum -> Ok(None),
      TextDatum(y) -> Ok(Some(ordering_sign(compare(x, y)))),
      _ -> Err(no_operator(a, b)),
    },
    BoolDatum(x) -> match b {
      NullDatum -> Ok(None),
      BoolDatum(y) -> Ok(Some(sign_of(if x { 1 } else { 0 }, if y { 1 } else { 0 }))),
      _ -> Err(no_operator(a, b)),
    },
    BytesDatum(x) -> match b {
      NullDatum -> Ok(None),
      BytesDatum(y) -> Ok(Some(ordering_sign(compare(x, y)))),
      _ -> Err(no_operator(a, b)),
    },
    JsonDatum(_) -> Err(unsupported("comparing `jsonb`")),
    ArrayDatum(_) -> Err(unsupported("comparing arrays")),
  }

fn no_operator(a: Datum, b: Datum) -> DbError =
  db_error("42883", "", "operator does not exist: " ++ datum_type(a) ++ " = " ++ datum_type(b))

fn zeros(n: Int) -> String = range(0, n).fold("", |accumulator: String, i: Int| accumulator ++ "0")

fn rescale(d: Decimal, s: Int) -> Option<Decimal> / {abort.raise} = {
  let reduced = if d.scale() > s { d.round(s, HalfUp) } else { d };
  let text = reduced.to_string();
  let have = reduced.scale();
  if have >= s { Decimal::of_string(text) }
  else if have == 0 { Decimal::of_string(if s > 0 { text ++ "." ++ zeros(s) } else { text }) }
  else { Decimal::of_string(text ++ zeros(s - have)) }
}

fn strip_leading_zeros(s: String) -> String / {abort.raise} = {
  let n = s.len();
  let first = range(0, n).fold(n, |at: Int, i: Int|
    if at < n || s.slice(i, i + 1) == "0" { at } else { i });
  s.slice(first, n)
}

fn numeric_fits(d: Decimal, p: Int, s: Int) -> Bool / {abort.raise} = {
  let text = d.to_string();
  let unsigned = if text.starts_with("-") { text.slice(1, text.len()) } else { text };
  let whole = if unsigned.contains(".") { unsigned.slice(0, unsigned.find(".")) } else { unsigned };
  strip_leading_zeros(whole).len() <= p - s
}

fn is_text(v: Datum) -> Bool = match v { TextDatum(_) -> true, _ -> false }

fn wrong_type(c: Column, v: Datum, from_param: Bool, want: String) -> DbError =
  if !from_param && is_text(v) { db_error("22P02", "", "invalid input syntax for type " ++ want) }
  else {
    db_error(
      "42804",
      "",
      "column \"" ++ c.name ++ "\" is of type " ++ want ++ " but expression is of type "
        ++ datum_type(v),
    )
  }

fn coerce(
  c: Column,
  ty: ColumnType,
  v: Datum,
  from_param: Bool,
) -> Result<Datum, DbError> / {abort.raise} =
  match v { NullDatum -> Ok(NullDatum), _ -> coerce_value(c, ty, v, from_param) }

/// The name postgres prints for a column type in a `22P02` or `42804`.
pub fn type_name(ty: ColumnType) -> String =
  match ty {
    IntColumn -> "bigint",
    BoolColumn -> "boolean",
    TText -> "text",
    BytesColumn -> "bytea",
    FloatColumn -> "double precision",
    TNumeric(_, _) -> "numeric",
    JsonColumn -> "jsonb",
    TArray(_) -> "array",
  }

fn coerce_value(
  c: Column,
  ty: ColumnType,
  v: Datum,
  from_param: Bool,
) -> Result<Datum, DbError> / {abort.raise} =
  match v {
    TextDatum(s) -> if from_param { coerce_typed(c, ty, v, from_param) }
    else { coerce_unknown(c, ty, s) },
    _ -> coerce_typed(c, ty, v, from_param),
  }

fn coerce_unknown(c: Column, ty: ColumnType, s: String) -> Result<Datum, DbError> / {abort.raise} =
  match unknown_datum(ty, s) {
    None -> Err(bad_input(ty, s)),
    Some(v) -> coerce_typed(c, ty, v, false),
  }

fn bad_input(ty: ColumnType, s: String) -> DbError =
  db_error("22P02", "", "invalid input syntax for type " ++ type_name(ty) ++ ": \"" ++ s ++ "\"")

fn unknown_datum(ty: ColumnType, s: String) -> Option<Datum> =
  match ty {
    IntColumn -> {
      let n = whole_of_string(s)?;
      Some(IntDatum(n))
    },
    BoolColumn -> unknown_bool(s),
    TText -> Some(TextDatum(s)),
    FloatColumn -> {
      let d = Decimal::of_string(s)?;
      Some(FloatDatum(Float::of_decimal(d)))
    },
    TNumeric(_, _) -> {
      let d = Decimal::of_string(s)?;
      Some(NumericDatum(d))
    },
    BytesColumn -> None,
    JsonColumn -> None,
    TArray(_) -> None,
  }

fn whole_of_string(s: String) -> Option<Int> = {
  let d = Decimal::of_string(s)?;
  let n = Int::of_decimal(d, Down)?;
  if Decimal::of_int(n) == d { Some(n) } else { None }
}

fn unknown_bool(s: String) -> Option<Datum> = {
  let t = s.ascii_lower();
  if t == "t" || t == "true" || t == "yes" || t == "on" || t == "1" { Some(BoolDatum(true)) }
  else if t == "f" || t == "false" || t == "no" || t == "off" || t == "0" { Some(BoolDatum(false)) }
  else { None }
}

fn coerce_typed(
  c: Column,
  ty: ColumnType,
  v: Datum,
  from_param: Bool,
) -> Result<Datum, DbError> / {abort.raise} =
  match ty {
    IntColumn -> match v {
      IntDatum(_) -> Ok(v),
      NumericDatum(d) -> int_from_decimal(d),
      _ -> Err(wrong_type(c, v, from_param, "bigint")),
    },
    BoolColumn -> match v {
      BoolDatum(_) -> Ok(v),
      _ -> Err(wrong_type(c, v, from_param, "boolean")),
    },
    TText -> match v { TextDatum(_) -> Ok(v), _ -> Err(wrong_type(c, v, from_param, "text")) },
    BytesColumn -> match v {
      BytesDatum(_) -> Ok(v),
      _ -> Err(wrong_type(c, v, from_param, "bytea")),
    },
    JsonColumn -> match v {
      JsonDatum(_) -> Ok(v),
      _ -> Err(wrong_type(c, v, from_param, "jsonb")),
    },
    FloatColumn -> match v {
      FloatDatum(_) -> Ok(v),
      IntDatum(n) -> Ok(FloatDatum(Float::of_decimal(Decimal::of_int(n)))),
      NumericDatum(d) -> Ok(FloatDatum(Float::of_decimal(d))),
      _ -> Err(wrong_type(c, v, from_param, "double precision")),
    },
    TNumeric(p, s) -> match v {
      NumericDatum(d) -> numeric_into(c, d, p, s),
      IntDatum(n) -> numeric_into(c, Decimal::of_int(n), p, s),
      _ -> Err(wrong_type(c, v, from_param, "numeric")),
    },
    TArray(inner) -> match v {
      ArrayDatum(xs) -> coerce_elements(c, inner, xs, from_param, []),
      _ -> Err(wrong_type(c, v, from_param, "array")),
    },
  }

fn int_from_decimal(d: Decimal) -> Result<Datum, DbError> =
  match Int::of_decimal(d.round(0, HalfUp), Down) {
    None -> Err(db_error("22003", "", "bigint out of range")),
    Some(n) -> Ok(IntDatum(n)),
  }

fn numeric_into(c: Column, d: Decimal, p: Int, s: Int) -> Result<Datum, DbError> / {abort.raise} =
  if !numeric_fits(d, p, s) { Err(numeric_overflow(p, s)) } else {
    match rescale(d, s) {
      None ->
        Err(unsupported("a `numeric` value that needs more than 28 decimal places or 29 digits")),
      Some(r) -> if numeric_fits(r, p, s) { Ok(NumericDatum(r)) }
      else { Err(numeric_overflow(p, s)) },
    }
  }

fn numeric_overflow(p: Int, s: Int) -> DbError =
  db_error(
    "22003",
    "",
    "numeric field overflow: a field with precision " ++ p.to_string() ++ ", scale "
      ++ s.to_string()
      ++ " must round to an absolute value less than 10^"
      ++ Int::to_string(p - s),
  )

fn coerce_elements(
  c: Column,
  inner: ColumnType,
  xs: List<Datum>,
  from_param: Bool,
  accumulator: List<Datum>,
) -> Result<Datum, DbError> / {abort.raise} =
  match xs {
    [] -> Ok(ArrayDatum(accumulator)),
    [h, ..t] -> match h {
      NullDatum -> Err(unsupported("an array that contains NULL")),
      _ -> {
        let v = coerce_value(c, inner, h, from_param)?;
        coerce_elements(c, inner, t, from_param, accumulator.push(v))
      },
    },
  }

fn find_table(ts: List<MemTable>, name: String) -> Option<MemTable> =
  match ts {
    [] -> None,
    [h, ..t] -> if h.definition.name == name { Some(h) } else { find_table(t, name) },
  }

fn put_table(ts: List<MemTable>, mt: MemTable) -> List<MemTable> =
  ts.map(|x: MemTable| if x.definition.name == mt.definition.name { mt } else { x })

fn find_column(cs: List<Column>, n: String) -> Option<Column> =
  match cs { [] -> None, [h, ..t] -> if h.name == n { Some(h) } else { find_column(t, n) } }

fn index_of(xs: List<String>, s: String) -> Option<Int> = index_from(xs, s, 0)

fn index_from(xs: List<String>, s: String, i: Int) -> Option<Int> =
  match xs { [] -> None, [h, ..t] -> if h == s { Some(i) } else { index_from(t, s, i + 1) } }

fn cell_of(r: Row, n: String) -> Datum = match r.get(n) { None -> NullDatum, Some(v) -> v }

fn not_null_here(definition: Table, c: Column) -> Bool =
  !c.nullable || definition.primary_key.contains(c.name)

fn validate_row(
  definition: Table,
  rows: List<Row>,
  row: Row,
  skip: Int,
) -> Option<DbError> / {abort.raise} =
  match check_not_null(definition, definition.columns, row) {
    Some(e) -> Some(e),
    None -> match check_checks(definition, definition.checks, row) {
      Some(e) -> Some(e),
      None -> check_unique(definition, rows, row, skip),
    },
  }

fn check_not_null(definition: Table, cs: List<Column>, row: Row) -> Option<DbError> =
  match cs {
    [] -> None,
    [c, ..t] -> if not_null_here(definition, c) && is_null(cell_of(row, c.name)) {
      Some(
        db_error(
          "23502",
          "",
          "null value in column \"" ++ c.name ++ "\" of relation \"" ++ definition.name
            ++ "\" violates not-null constraint",
        ),
      )
    } else { check_not_null(definition, t, row) },
  }

fn check_checks(definition: Table, cs: List<Check>, row: Row) -> Option<DbError> / {abort.raise} =
  match cs {
    [] -> None,
    [c, ..t] -> match parse_expression_text(c.expression) {
      Err(e) -> Some(e),
      Ok(x) -> match eval_pred(row, [], x) {
        Err(e) -> Some(e),
        Ok(SqlFalse) ->
          Some(
            db_error(
              "23514",
              c.name,
              "new row for relation \"" ++ definition.name ++ "\" violates check constraint \""
                ++ c.name
                ++ "\"",
            ),
          ),
        Ok(_) -> check_checks(definition, t, row),
      },
    },
  }

fn check_unique(definition: Table, rows: List<Row>, row: Row, skip: Int) -> Option<DbError> =
  match unique_violation(
      definition,
      rows,
      row,
      skip,
      definition.primary_key,
      definition.name ++ "_pkey",
    ) {
    Some(e) -> Some(e),
    None -> check_unique_list(definition, definition.unique, rows, row, skip),
  }

fn check_unique_list(
  definition: Table,
  us: List<Unique>,
  rows: List<Row>,
  row: Row,
  skip: Int,
) -> Option<DbError> =
  match us {
    [] -> None,
    [u, ..t] -> match unique_violation(definition, rows, row, skip, u.columns, u.name) {
      Some(e) -> Some(e),
      None -> check_unique_list(definition, t, rows, row, skip),
    },
  }

fn unique_violation(
  definition: Table,
  rows: List<Row>,
  row: Row,
  skip: Int,
  cols: List<String>,
  name: String,
) -> Option<DbError> =
  if cols.len() == 0 || key_has_null(row, cols) { None }
  else if collides(rows, row, cols, skip, 0) {
    Some(
      db_error("23505", name, "duplicate key value violates unique constraint \"" ++ name ++ "\""),
    )
  } else { None }

fn key_has_null(row: Row, cols: List<String>) -> Bool =
  cols.fold(false, |accumulator: Bool, c: String| accumulator || is_null(cell_of(row, c)))

fn collides(rows: List<Row>, row: Row, cols: List<String>, skip: Int, i: Int) -> Bool =
  match rows {
    [] -> false,
    [h, ..t] -> if i != skip && key_equal(h, row, cols) { true }
    else { collides(t, row, cols, skip, i + 1) },
  }

fn key_equal(a: Row, b: Row, cols: List<String>) -> Bool =
  cols.fold(true, |accumulator: Bool, c: String| accumulator && cell_of(a, c) == cell_of(b, c))

fn check_referential(ts: List<MemTable>) -> Option<DbError> = check_ref_from(ts, ts)

fn check_ref_from(all: List<MemTable>, ts: List<MemTable>) -> Option<DbError> =
  match ts {
    [] -> None,
    [h, ..t] -> match check_table_fks(all, h, h.definition.foreign_keys) {
      Some(e) -> Some(e),
      None -> check_ref_from(all, t),
    },
  }

fn check_table_fks(ts: List<MemTable>, mt: MemTable, fks: List<ForeignKey>) -> Option<DbError> =
  match fks {
    [] -> None,
    [f, ..rest] -> match check_fk_rows(ts, mt.rows, f) {
      Some(e) -> Some(e),
      None -> check_table_fks(ts, mt, rest),
    },
  }

fn check_fk_rows(ts: List<MemTable>, rows: List<Row>, f: ForeignKey) -> Option<DbError> =
  match rows {
    [] -> None,
    [r, ..t] -> if key_has_null(r, f.columns) { check_fk_rows(ts, t, f) } else {
      match find_table(ts, f.references) {
        None -> Some(undefined_table(f.references)),
        Some(parent) -> if parent_present(parent.rows, r, f) { check_fk_rows(ts, t, f) } else {
          Some(
            db_error(
              "23503",
              f.name,
              "insert or update on table violates foreign key constraint \"" ++ f.name ++ "\"",
            ),
          )
        },
      }
    },
  }

fn parent_present(rows: List<Row>, child: Row, f: ForeignKey) -> Bool =
  match rows {
    [] -> false,
    [p, ..t] -> if fk_matches(p, child, f) { true } else { parent_present(t, child, f) },
  }

fn fk_matches(parent: Row, child: Row, f: ForeignKey) -> Bool =
  fk_pairs(parent, child, f.columns, f.refers_to)

fn fk_pairs(parent: Row, child: Row, cs: List<String>, rs: List<String>) -> Bool =
  match cs {
    [] -> true,
    [c, ..ct] -> match rs {
      [] -> false,
      [r, ..rt] -> cell_of(child, c) == cell_of(parent, r) && fk_pairs(parent, child, ct, rt),
    },
  }

/// The result's shape follows the statement: a `RETURNING` returns `Rows` and a bare write `Count`.
pub fn step(d: MemDb, s: Statement, ps: List<Param>) -> Outcome / {abort.raise} =
  if d.failed { fail(d, in_failed_txn()) }
  else { match parse_statement(s.sql) { Err(e) -> fail(d, e), Ok(q) -> exec(d, q, ps) } }

fn exec(db: MemDb, q: Query, ps: List<Param>) -> Outcome / {abort.raise} =
  match q {
    Select(sq) -> exec_select(db, sq, ps),
    Insert(iq) -> if read_only(db) { fail(db, read_only_txn("INSERT")) }
    else { exec_insert(db, iq, ps) },
    Update(uq) -> if read_only(db) { fail(db, read_only_txn("UPDATE")) }
    else { exec_update(db, uq, ps) },
    Delete(dq) -> if read_only(db) { fail(db, read_only_txn("DELETE")) }
    else { exec_delete(db, dq, ps) },
  }

fn read_only(db: MemDb) -> Bool =
  match db.stack.at(0) {
    None -> false,
    Some(f) -> match f.access { ReadOnly -> true, ReadWrite -> false },
  }

type Operands = { left: Expression, right: Expression }

fn plan_filter(definition: Table, f: Option<Expression>) -> Result<Option<Expression>, DbError> =
  match f {
    None -> Ok(None),
    Some(e) -> {
      let x = plan_expression(definition, e)?;
      Ok(Some(x))
    },
  }

fn plan_expression(definition: Table, e: Expression) -> Result<Expression, DbError> =
  match e {
    ColumnName(n) -> match find_column(definition.columns, n) {
      None -> Err(undefined_column(n)),
      Some(_) -> Ok(e),
    },
    Placeholder(_) -> Ok(e),
    LiteralValue(_) -> Ok(e),
    DefaultKeyword -> Ok(e),
    Not(x) -> {
      let a = plan_expression(definition, x)?;
      Ok(Not(a))
    },
    And(a, b) -> {
      let pa = plan_expression(definition, a)?;
      let pb = plan_expression(definition, b)?;
      Ok(And(pa, pb))
    },
    Or(a, b) -> {
      let pa = plan_expression(definition, a)?;
      let pb = plan_expression(definition, b)?;
      Ok(Or(pa, pb))
    },
    Compare(comparison, a, b) -> {
      let p = plan_operands(definition, a, b)?;
      Ok(Compare(comparison, p.left, p.right))
    },
    IsNull(x, want) -> {
      let a = plan_expression(definition, x)?;
      Ok(IsNull(a, want))
    },
    InList(x, items, negated) -> {
      let px = plan_expression(definition, x)?;
      let pis = plan_items(definition, column_type_of(definition, px), items, [])?;
      Ok(InList(px, pis, negated))
    },
    Between(x, lo, hi, negated) -> {
      let a = plan_operands(definition, x, lo)?;
      let ph = plan_expression(definition, hi)?;
      let b = paired(definition, a.left, ph)?;
      Ok(Between(b.left, a.right, b.right, negated))
    },
    Like(x, p, negated) -> {
      let px = plan_expression(definition, x)?;
      let pp = plan_expression(definition, p)?;
      Ok(Like(px, pp, negated))
    },
  }

fn plan_operands(definition: Table, a: Expression, b: Expression) -> Result<Operands, DbError> = {
  let pa = plan_expression(definition, a)?;
  let pb = plan_expression(definition, b)?;
  paired(definition, pa, pb)
}

fn paired(definition: Table, pa: Expression, pb: Expression) -> Result<Operands, DbError> =
  match column_type_of(definition, pa) {
    Some(ty) -> {
      let nb = retype(ty, pb)?;
      Ok({ left: pa, right: nb })
    },
    None -> match column_type_of(definition, pb) {
      Some(ty) -> {
        let na = retype(ty, pa)?;
        Ok({ left: na, right: pb })
      },
      None -> Ok({ left: pa, right: pb }),
    },
  }

fn plan_items(
  definition: Table,
  ty: Option<ColumnType>,
  items: List<Expression>,
  accumulator: List<Expression>,
) -> Result<List<Expression>, DbError> =
  match items {
    [] -> Ok(accumulator),
    [h, ..t] -> {
      let ph = plan_expression(definition, h)?;
      match ty {
        None -> plan_items(definition, ty, t, accumulator.push(ph)),
        Some(want) -> {
          let rh = retype(want, ph)?;
          plan_items(definition, ty, t, accumulator.push(rh))
        },
      }
    },
  }

fn column_type_of(definition: Table, e: Expression) -> Option<ColumnType> =
  match e {
    ColumnName(n) -> {
      let c = find_column(definition.columns, n)?;
      Some(c.ty)
    },
    _ -> None,
  }

fn retype(ty: ColumnType, e: Expression) -> Result<Expression, DbError> =
  match e {
    LiteralValue(v) -> match v {
      TextDatum(s) -> match ty {
        TText -> Ok(e),
        _ -> match unknown_datum(ty, s) {
          None -> Err(bad_input(ty, s)),
          Some(nv) -> Ok(LiteralValue(nv)),
        },
      },
      _ -> Ok(e),
    },
    _ -> Ok(e),
  }

fn check_projection(definition: Table, proj: Projection) -> Option<DbError> =
  match proj {
    StarProjection -> None,
    CountProjection(_) -> None,
    ColumnProjection(ns) -> check_result_columns(definition, ns, []),
  }

fn check_result_columns(
  definition: Table,
  ns: List<Target>,
  seen: List<String>,
) -> Option<DbError> =
  match ns {
    [] -> None,
    [h, ..t] -> match find_column(definition.columns, h.column) {
      None -> Some(undefined_column(h.column)),
      Some(_) -> if seen.contains(h.name) {
        Some(unsupported("a result with two columns that have the same name `" ++ h.name ++ "`"))
      } else { check_result_columns(definition, t, seen.push(h.name)) },
    },
  }

fn check_returning(definition: Table, r: Option<Projection>) -> Option<DbError> = {
  let p = r?;
  check_projection(definition, p)
}

fn exec_select(db: MemDb, q: SelectQuery, ps: List<Param>) -> Outcome / {abort.raise} =
  match find_table(db.tables, q.source) {
    None -> fail(db, undefined_table(q.source)),
    Some(mt) -> match plan_select(mt.definition, q) {
      Err(e) -> fail(db, e),
      Ok(planned) -> match select_rows(mt.rows, ps, planned.filter, []) {
        Err(e) -> fail(db, e),
        Ok(rows) -> finish_select(db, mt, planned, ps, rows),
      },
    },
  }

fn plan_select(definition: Table, q: SelectQuery) -> Result<SelectQuery, DbError> =
  match check_projection(definition, q.proj) {
    Some(e) -> Err(e),
    None -> match check_order_columns(definition, q.order) {
      Some(e) -> Err(e),
      None -> {
        let f = plan_filter(definition, q.filter)?;
        Ok({
          source: q.source,
          proj: q.proj,
          filter: f,
          order: q.order,
          limit: q.limit,
          offset: q.offset,
        })
      },
    },
  }

fn select_rows(
  rows: List<Row>,
  ps: List<Param>,
  filter: Option<Expression>,
  accumulator: List<Row>,
) -> Result<List<Row>, DbError> / {abort.raise} =
  match rows {
    [] -> Ok(accumulator),
    [h, ..t] -> {
      let k = passes_filter(h, ps, filter)?;
      select_rows(t, ps, filter, if k { accumulator.push(h) } else { accumulator })
    },
  }

fn passes_filter(
  row: Row,
  ps: List<Param>,
  filter: Option<Expression>,
) -> Result<Bool, DbError> / {abort.raise} =
  match filter {
    None -> Ok(true),
    Some(e) -> {
      let t = eval_pred(row, ps, e)?;
      Ok(match t { SqlTrue -> true, SqlFalse -> false, SqlUnknown -> false })
    },
  }

fn finish_select(
  db: MemDb,
  mt: MemTable,
  q: SelectQuery,
  ps: List<Param>,
  rows: List<Row>,
) -> Outcome / {abort.raise} =
  match q.proj {
    CountProjection(name) -> if q.order.len() > 0 || is_bound(q.limit) || is_bound(q.offset) {
      fail(db, unsupported("`count(*)` combined with `order by`, `limit` or `offset`"))
    } else { done(db, Rows([Map::new().insert(name, IntDatum(rows.len()))])) },
    StarProjection -> ordered_slice(db, mt, q, ps, rows, StarProjection),
    ColumnProjection(ns) -> ordered_slice(db, mt, q, ps, rows, ColumnProjection(ns)),
  }

fn is_bound(e: Option<Expression>) -> Bool = match e { None -> false, Some(_) -> true }

fn ordered_slice(
  db: MemDb,
  mt: MemTable,
  q: SelectQuery,
  ps: List<Param>,
  rows: List<Row>,
  proj: Projection,
) -> Outcome / {abort.raise} =
  match check_order_columns(mt.definition, q.order) {
    Some(e) -> fail(db, e),
    None -> match sort_rows(rows, q.order, []) {
      Err(e) -> fail(db, e),
      Ok(sorted) -> slice_and_project(db, q, ps, sorted, proj),
    },
  }

fn check_order_columns(definition: Table, keys: List<OrderKey>) -> Option<DbError> =
  match keys {
    [] -> None,
    [k, ..t] -> match find_column(definition.columns, k.column) {
      None -> Some(undefined_column(k.column)),
      Some(_) -> check_order_columns(definition, t),
    },
  }

fn slice_and_project(
  db: MemDb,
  q: SelectQuery,
  ps: List<Param>,
  rows: List<Row>,
  proj: Projection,
) -> Outcome / {abort.raise} =
  match eval_bound(ps, q.offset, 0, "2201X", "OFFSET") {
    Err(e) -> fail(db, e),
    Ok(off) -> match eval_bound(ps, q.limit, -1, "2201W", "LIMIT") {
      Err(e) -> fail(db, e),
      Ok(lim) -> {
        let after = drop_n(rows, off);
        let bounded = if lim < 0 { after } else { take_n(after, lim, []) };
        match project_rows(bounded, proj, []) {
          Err(e) -> fail(db, e),
          Ok(out) -> done(db, Rows(out)),
        }
      },
    },
  }

fn eval_bound(
  ps: List<Param>,
  e: Option<Expression>,
  dflt: Int,
  code: String,
  what: String,
) -> Result<Int, DbError> / {abort.raise} =
  match e {
    None -> Ok(dflt),
    Some(x) -> {
      let v = eval_value(Map::new(), ps, x)?;
      match v {
        NullDatum -> Ok(dflt),
        IntDatum(n) -> if n < 0 { Err(db_error(code, "", what ++ " must not be negative")) }
        else { Ok(n) },
        _ -> Err(db_error("42804", "", "argument of " ++ what ++ " must be integer")),
      }
    },
  }

fn drop_n<a>(xs: List<a>, n: Int) -> List<a> =
  if n <= 0 { xs } else { match xs { [] -> [], [_, ..t] -> drop_n(t, n - 1) } }

fn take_n<a>(xs: List<a>, n: Int, accumulator: List<a>) -> List<a> =
  if n <= 0 { accumulator }
  else { match xs { [] -> accumulator, [h, ..t] -> take_n(t, n - 1, accumulator.push(h)) } }

fn sort_rows(
  rows: List<Row>,
  keys: List<OrderKey>,
  accumulator: List<Row>,
) -> Result<List<Row>, DbError> =
  if keys.len() == 0 { Ok(accumulator.concat(rows)) } else {
    match rows {
      [] -> Ok(accumulator),
      [h, ..t] -> {
        let next = insert_sorted(accumulator, h, keys, [])?;
        sort_rows(t, keys, next)
      },
    }
  }

reuse fn insert_sorted(
  sorted: List<Row>,
  row: Row,
  keys: List<OrderKey>,
  before: List<Row>,
) -> Result<List<Row>, DbError> =
  match sorted {
    [] -> Ok(before.push(row)),
    [h, ..t] -> {
      let c = compare_rows(row, h, keys)?;
      if c < 0 { Ok(before.push(row).concat(sorted)) }
      else { insert_sorted(t, row, keys, before.push(h)) }
    },
  }

fn compare_rows(a: Row, b: Row, keys: List<OrderKey>) -> Result<Int, DbError> =
  match keys {
    [] -> Ok(0),
    [k, ..t] -> {
      let c = compare_by_key(a, b, k)?;
      if c == 0 { compare_rows(a, b, t) } else { Ok(c) }
    },
  }

fn compare_by_key(a: Row, b: Row, k: OrderKey) -> Result<Int, DbError> = {
  let av = cell_of(a, k.column);
  let bv = cell_of(b, k.column);
  if is_null(av) && is_null(bv) { Ok(0) }
  else if is_null(av) { Ok(if k.nulls_first { -1 } else { 1 }) }
  else if is_null(bv) { Ok(if k.nulls_first { 1 } else { -1 }) } else {
    let o = compare_datums(av, bv)?;
    match o { None -> Ok(0), Some(c) -> Ok(if k.descending { 0 - c } else { c }) }
  }
}

fn project_rows(
  rows: List<Row>,
  proj: Projection,
  accumulator: List<Row>,
) -> Result<List<Row>, DbError> =
  match rows {
    [] -> Ok(accumulator),
    [h, ..t] -> {
      let r = project_row(h, proj)?;
      project_rows(t, proj, accumulator.push(r))
    },
  }

fn project_row(r: Row, proj: Projection) -> Result<Row, DbError> =
  match proj {
    StarProjection -> Ok(r),
    CountProjection(_) -> Ok(r),
    ColumnProjection(ns) -> project_cols(r, ns, Map::new()),
  }

fn project_cols(row: Row, ns: List<Target>, accumulator: Row) -> Result<Row, DbError> =
  match ns {
    [] -> Ok(accumulator),
    [h, ..t] -> match row.get(h.column) {
      None -> Err(undefined_column(h.column)),
      Some(v) -> project_cols(row, t, accumulator.insert(h.name, v)),
    },
  }

type EffectsAccumulator = { sequences: Map<String, Int>, row: Row, err: Option<DbError> }

type Build = { sequences: Map<String, Int>, rows: List<Row>, err: Option<DbError> }

fn exec_insert(db: MemDb, q: InsertQuery, ps: List<Param>) -> Outcome / {abort.raise} =
  match find_table(db.tables, q.source) {
    None -> fail(db, undefined_table(q.source)),
    Some(mt) -> {
      let cols = if q.columns.len() == 0 { mt.definition.columns.map(|c: Column| c.name) }
      else { q.columns };
      match check_column_list(mt.definition, cols, []) {
        Some(e) -> fail(db, e),
        None -> match check_returning(mt.definition, q.returning) {
          Some(e) -> fail(db, e),
          None -> insert_build(db, mt, cols, q, ps),
        },
      }
    },
  }

fn check_column_list(definition: Table, cols: List<String>, seen: List<String>) -> Option<DbError> =
  match cols {
    [] -> None,
    [h, ..t] -> match find_column(definition.columns, h) {
      None -> Some(undefined_column(h)),
      Some(_) -> if seen.contains(h) {
        Some(db_error("42701", "", "column \"" ++ h ++ "\" specified more than once"))
      } else { check_column_list(definition, t, seen.push(h)) },
    },
  }

fn insert_build(
  db: MemDb,
  mt: MemTable,
  cols: List<String>,
  q: InsertQuery,
  ps: List<Param>,
) -> Outcome / {abort.raise} = {
  let b = q.tuples.fold(
    { sequences: db.sequences, rows: [], err: None },
    |accumulator: Build, expressions: List<Expression>|
      build_tuple(mt.definition, cols, expressions, ps, accumulator),
  );
  let advanced = memdb(db, db.tables, b.sequences, db.stack, db.failed);
  match b.err { Some(e) -> fail(advanced, e), None -> insert_rows(advanced, mt, b.rows, q) }
}

fn build_tuple(
  definition: Table,
  cols: List<String>,
  expressions: List<Expression>,
  ps: List<Param>,
  accumulator: Build,
) -> Build / {abort.raise} =
  match accumulator.err {
    Some(_) -> accumulator,
    None -> if expressions.len() != cols.len() {
      {
        sequences: accumulator.sequences,
        rows: accumulator.rows,
        err: Some(
          db_error(
            "42601",
            "",
            "INSERT has " ++ (if expressions.len() > cols.len() { "more" } else { "fewer" })
              ++ " expressions than target columns",
          ),
        ),
      }
    } else {
      append_built_row(
        build_columns(definition, definition.columns, cols, expressions, ps, {
          sequences: accumulator.sequences,
          row: Map::new(),
          err: None,
        }),
        accumulator,
      )
    },
  }

fn append_built_row(built: EffectsAccumulator, accumulator: Build) -> Build =
  match built.err {
    Some(e) -> { sequences: built.sequences, rows: accumulator.rows, err: Some(e) },
    None -> { sequences: built.sequences, rows: accumulator.rows.push(built.row), err: None },
  }

fn build_columns(
  definition: Table,
  cs: List<Column>,
  cols: List<String>,
  expressions: List<Expression>,
  ps: List<Param>,
  accumulator: EffectsAccumulator,
) -> EffectsAccumulator / {abort.raise} =
  match cs {
    [] -> accumulator,
    [c, ..rest] -> match accumulator.err {
      Some(_) -> accumulator,
      None ->
        build_columns(
          definition,
          rest,
          cols,
          expressions,
          ps,
          build_column(c, cols, expressions, ps, accumulator),
        ),
    },
  }

fn build_column(
  c: Column,
  cols: List<String>,
  expressions: List<Expression>,
  ps: List<Param>,
  accumulator: EffectsAccumulator,
) -> EffectsAccumulator / {abort.raise} =
  match index_of(cols, c.name) {
    None -> default_into(c, accumulator),
    Some(i) -> match expressions.at(i) {
      None -> default_into(c, accumulator),
      Some(e) -> match e {
        DefaultKeyword -> default_into(c, accumulator),
        _ -> store_value(c, eval_value(Map::new(), ps, e), is_param(e), accumulator),
      },
    },
  }

fn is_param(e: Expression) -> Bool = match e { Placeholder(_) -> true, _ -> false }

fn store_value(
  c: Column,
  r: Result<Datum, DbError>,
  from_param: Bool,
  accumulator: EffectsAccumulator,
) -> EffectsAccumulator / {abort.raise} =
  match r {
    Err(e) -> { sequences: accumulator.sequences, row: accumulator.row, err: Some(e) },
    Ok(v) -> match coerce(c, c.ty, v, from_param) {
      Err(e) -> { sequences: accumulator.sequences, row: accumulator.row, err: Some(e) },
      Ok(cv) ->
        { sequences: accumulator.sequences, row: accumulator.row.insert(c.name, cv), err: None },
    },
  }

fn default_into(c: Column, accumulator: EffectsAccumulator) -> EffectsAccumulator / {abort.raise} =
  match c.default {
    DNone ->
      {
        sequences: accumulator.sequences,
        row: accumulator.row.insert(c.name, NullDatum),
        err: None,
      },
    LiteralDefault(p) -> store_value(c, Ok(param_datum(p)), false, accumulator),
    SequenceDefault(n) -> {
      let next = match accumulator.sequences.get(n) { None -> 1, Some(v) -> v + 1 };
      {
        sequences: accumulator.sequences.insert(n, next),
        row: accumulator.row.insert(c.name, IntDatum(next)),
        err: None,
      }
    },
  }

fn insert_rows(
  db: MemDb,
  mt: MemTable,
  rows: List<Row>,
  q: InsertQuery,
) -> Outcome / {abort.raise} =
  match append_rows(mt, rows) {
    Err(e) -> fail(db, e),
    Ok(mt2) -> {
      let tables = put_table(db.tables, mt2);
      match check_referential(tables) {
        Some(e) -> fail(db, e),
        None ->
          finish_write(
            memdb(db, tables, db.sequences, db.stack, db.failed),
            rows,
            q.returning,
            rows.len(),
          ),
      }
    },
  }

fn append_rows(mt: MemTable, rows: List<Row>) -> Result<MemTable, DbError> / {abort.raise} =
  match rows {
    [] -> Ok(mt),
    [h, ..t] -> match validate_row(mt.definition, mt.rows, h, -1) {
      Some(e) -> Err(e),
      None -> append_rows({ definition: mt.definition, rows: mt.rows.push(h) }, t),
    },
  }

fn finish_write(db: MemDb, rows: List<Row>, returning: Option<Projection>, count: Int) -> Outcome =
  match returning {
    None -> done(db, Count(count)),
    Some(p) -> match project_rows(rows, p, []) {
      Err(e) -> fail(db, e),
      Ok(out) -> done(db, Rows(out)),
    },
  }

type ChangedRow = { at: Int, row: Row }

type UpAccumulator = { rows: List<Row>, changed: List<ChangedRow>, at: Int, err: Option<DbError> }

fn exec_update(db: MemDb, q: UpdateQuery, ps: List<Param>) -> Outcome / {abort.raise} =
  match find_table(db.tables, q.source) {
    None -> fail(db, undefined_table(q.source)),
    Some(mt) -> match plan_update(mt.definition, q, ps) {
      Err(e) -> fail(db, e),
      Ok(planned) -> {
        let accumulator = update_rows(mt.definition, mt.rows, planned, ps, {
          rows: [],
          changed: [],
          at: 0,
          err: None,
        });
        match accumulator.err {
          Some(e) -> fail(db, e),
          None -> finish_update(db, mt, accumulator, planned),
        }
      },
    },
  }

fn plan_update(
  definition: Table,
  q: UpdateQuery,
  ps: List<Param>,
) -> Result<UpdateQuery, DbError> / {abort.raise} =
  match check_returning(definition, q.returning) {
    Some(e) -> Err(e),
    None -> match constant_sets(definition, q.sets, ps) {
      Some(e) -> Err(e),
      None -> {
        let f = plan_filter(definition, q.filter)?;
        Ok({ source: q.source, sets: q.sets, filter: f, returning: q.returning })
      },
    },
  }

fn constant_sets(
  definition: Table,
  sets: List<Assignment>,
  ps: List<Param>,
) -> Option<DbError> / {abort.raise} =
  match sets {
    [] -> None,
    [s, ..t] -> match find_column(definition.columns, s.column) {
      None -> Some(undefined_column(s.column)),
      Some(c) -> match constant_of(s.value, ps) {
        None -> constant_sets(definition, t, ps),
        Some(v) -> match coerce(c, c.ty, v, is_param(s.value)) {
          Err(e) -> Some(e),
          Ok(_) -> constant_sets(definition, t, ps),
        },
      },
    },
  }

fn constant_of(e: Expression, ps: List<Param>) -> Option<Datum> =
  match e {
    LiteralValue(v) -> Some(v),
    Placeholder(n) -> {
      let p = ps.at(n - 1)?;
      Some(param_datum(p))
    },
    _ -> None,
  }

fn update_rows(
  definition: Table,
  rows: List<Row>,
  q: UpdateQuery,
  ps: List<Param>,
  accumulator: UpAccumulator,
) -> UpAccumulator / {abort.raise} =
  match rows {
    [] -> accumulator,
    [h, ..t] -> match accumulator.err {
      Some(_) -> accumulator,
      None -> update_rows(definition, t, q, ps, update_one(definition, h, q, ps, accumulator)),
    },
  }

fn update_one(
  definition: Table,
  row: Row,
  q: UpdateQuery,
  ps: List<Param>,
  accumulator: UpAccumulator,
) -> UpAccumulator / {abort.raise} =
  match passes_filter(row, ps, q.filter) {
    Err(e) ->
      { rows: accumulator.rows, changed: accumulator.changed, at: accumulator.at, err: Some(e) },
    Ok(hit) -> if hit { update_matching_row(definition, row, q, ps, accumulator) } else {
      {
        rows: accumulator.rows.push(row),
        changed: accumulator.changed,
        at: accumulator.at + 1,
        err: None,
      }
    },
  }

fn update_matching_row(
  definition: Table,
  row: Row,
  q: UpdateQuery,
  ps: List<Param>,
  accumulator: UpAccumulator,
) -> UpAccumulator / {abort.raise} =
  match apply_sets(definition, row, q.sets, ps) {
    Err(e) ->
      { rows: accumulator.rows, changed: accumulator.changed, at: accumulator.at, err: Some(e) },
    Ok(nr) ->
      {
        rows: accumulator.rows.push(nr),
        changed: accumulator.changed.push({ at: accumulator.at, row: nr }),
        at: accumulator.at + 1,
        err: None,
      },
  }

fn apply_sets(
  definition: Table,
  row: Row,
  sets: List<Assignment>,
  ps: List<Param>,
) -> Result<Row, DbError> / {abort.raise} =
  match sets {
    [] -> Ok(row),
    [s, ..t] -> match find_column(definition.columns, s.column) {
      None -> Err(undefined_column(s.column)),
      Some(c) -> {
        let nr = set_value(c, row, s.value, ps)?;
        apply_sets(definition, nr, t, ps)
      },
    },
  }

fn set_value(
  c: Column,
  row: Row,
  e: Expression,
  ps: List<Param>,
) -> Result<Row, DbError> / {abort.raise} =
  match e {
    DefaultKeyword -> match c.default {
      SequenceDefault(_) ->
        Err(unsupported("`set ... = default` on a column that uses a sequence")),
      DNone -> Ok(row.insert(c.name, NullDatum)),
      LiteralDefault(p) -> {
        let v = coerce(c, c.ty, param_datum(p), false)?;
        Ok(row.insert(c.name, v))
      },
    },
    _ -> {
      let v = eval_value(row, ps, e)?;
      let cv = coerce(c, c.ty, v, is_param(e))?;
      Ok(row.insert(c.name, cv))
    },
  }

fn finish_update(
  db: MemDb,
  mt: MemTable,
  accumulator: UpAccumulator,
  q: UpdateQuery,
) -> Outcome / {abort.raise} =
  match validate_changed(mt.definition, accumulator.rows, accumulator.changed) {
    Some(e) -> fail(db, e),
    None -> {
      let tables = put_table(db.tables, { definition: mt.definition, rows: accumulator.rows });
      match check_referential(tables) {
        Some(e) -> fail(db, e),
        None ->
          finish_write(
            memdb(db, tables, db.sequences, db.stack, db.failed),
            accumulator.changed.map(|c: ChangedRow| c.row),
            q.returning,
            accumulator.changed.len(),
          ),
      }
    },
  }

fn validate_changed(
  definition: Table,
  rows: List<Row>,
  cs: List<ChangedRow>,
) -> Option<DbError> / {abort.raise} =
  match cs {
    [] -> None,
    [h, ..t] -> match validate_row(definition, rows, h.row, h.at) {
      Some(e) -> Some(e),
      None -> validate_changed(definition, rows, t),
    },
  }

type DelAccumulator = { rows: List<Row>, gone: List<Row>, err: Option<DbError> }

fn exec_delete(db: MemDb, q: DeleteQuery, ps: List<Param>) -> Outcome / {abort.raise} =
  match find_table(db.tables, q.source) {
    None -> fail(db, undefined_table(q.source)),
    Some(mt) -> match plan_delete(mt.definition, q) {
      Err(e) -> fail(db, e),
      Ok(q) -> {
        let accumulator = delete_rows(mt.rows, q, ps, { rows: [], gone: [], err: None });
        match accumulator.err {
          Some(e) -> fail(db, e),
          None -> {
            let tables = put_table(db.tables, {
              definition: mt.definition,
              rows: accumulator.rows,
            });
            match check_referential(tables) {
              Some(e) -> fail(db, e),
              None ->
                finish_write(
                  memdb(db, tables, db.sequences, db.stack, db.failed),
                  accumulator.gone,
                  q.returning,
                  accumulator.gone.len(),
                ),
            }
          },
        }
      },
    },
  }

fn plan_delete(definition: Table, q: DeleteQuery) -> Result<DeleteQuery, DbError> =
  match check_returning(definition, q.returning) {
    Some(e) -> Err(e),
    None -> {
      let f = plan_filter(definition, q.filter)?;
      Ok({ source: q.source, filter: f, returning: q.returning })
    },
  }

fn delete_rows(
  rows: List<Row>,
  q: DeleteQuery,
  ps: List<Param>,
  accumulator: DelAccumulator,
) -> DelAccumulator / {abort.raise} =
  match rows {
    [] -> accumulator,
    [h, ..t] -> match accumulator.err {
      Some(_) -> accumulator,
      None -> match passes_filter(h, ps, q.filter) {
        Err(e) -> { rows: accumulator.rows, gone: accumulator.gone, err: Some(e) },
        Ok(hit) ->
          delete_rows(t, q, ps, if hit {
            { rows: accumulator.rows, gone: accumulator.gone.push(h), err: None }
          } else { { rows: accumulator.rows.push(h), gone: accumulator.gone, err: None } }),
      },
    },
  }

/// A rejected `begin` does not abort the transaction it is nested inside.
pub fn begin_step(db: MemDb, level: Isolation, access: Access) -> Outcome = {
  let frame = {
    tables: db.tables,
    failed: false,
    level: level,
    access: access,
    pending: db.pending,
  };
  match db.stack.at(0) {
    None -> done(memdb(db, db.tables, db.sequences, [frame], false), Count(0)),
    Some(outer) -> match nested_begin_error(
        db.failed,
        db.stack.len(),
        outer.level,
        outer.access,
        level,
        access,
      ) {
      Some(e) -> fail_open(db, e),
      None -> done(memdb(db, db.tables, db.sequences, db.stack.push(frame), db.failed), Count(0)),
    },
  }
}

fn nested_begin_error(
  failed: Bool,
  depth: Int,
  outer: Isolation,
  outer_access: Access,
  level: Isolation,
  access: Access,
) -> Option<DbError> =
  if failed { Some(in_failed_txn()) } else if depth > max_savepoints() {
    Some(db_error("54000", "", "savepoint stack deeper than " ++ max_savepoints().to_string()))
  } else if !same_isolation(outer, level) {
    Some(
      db_error(
        "25001",
        "",
        "the open transaction is " ++ isolation_name(outer) ++ " and this nested `begin` asks for "
          ++ isolation_name(level),
      ),
    )
  } else if widens(outer_access, access) {
    Some(
      db_error(
        "25001",
        "",
        "the open transaction is " ++ access_name(outer_access)
          ++ " and this nested `begin` asks for "
          ++ access_name(access)
          ++ "; a savepoint cannot widen what the transaction may do",
      ),
    )
  } else { None }

fn widens(outer: Access, inner: Access) -> Bool =
  match outer {
    ReadOnly -> match inner { ReadWrite -> true, ReadOnly -> false },
    ReadWrite -> false,
  }

/// The access mode as `begin` writes it.
pub fn access_name(a: Access) -> String =
  match a { ReadWrite -> "read write", ReadOnly -> "read only" }

fn same_isolation(a: Isolation, b: Isolation) -> Bool =
  match a {
    ReadCommitted -> match b { ReadCommitted -> true, _ -> false },
    RepeatableRead -> match b { RepeatableRead -> true, _ -> false },
    Serializable -> match b { Serializable -> true, _ -> false },
  }

/// The isolation level as `begin` writes it.
pub fn isolation_name(a: Isolation) -> String =
  match a {
    ReadCommitted -> "read committed",
    RepeatableRead -> "repeatable read",
    Serializable -> "serializable",
  }

/// Commits the innermost scope. Committing a transaction that has already failed returns `25P02`,
/// which is stricter than Postgres. A successful outermost commit delivers the notifications the
/// transaction sent, and a failed one discards them.
pub fn commit_step(db: MemDb) -> Outcome =
  match last(db.stack) {
    None -> fail_open(db, no_transaction("`db.commit`")),
    Some(frame) -> if db.stack.len() == 1 {
      if db.failed {
        {
          db: { ..memdb(db, frame.tables, db.sequences, [], false), pending: frame.pending },
          out: Failed(in_failed_txn()),
        }
      } else {
        done(
          deliver({ ..memdb(db, db.tables, db.sequences, [], false), pending: [] }, db.pending),
          Count(0),
        )
      }
    } else if db.failed {
      {
        db: {
          ..memdb(db, frame.tables, db.sequences, db.stack.drop_last(1), true),
          pending: frame.pending,
        },
        out: Failed(in_failed_txn()),
      }
    } else { done(memdb(db, db.tables, db.sequences, db.stack.drop_last(1), db.failed), Count(0)) },
  }

/// Implements `db.abort` on the fake: undoes the innermost scope's changes and discards the
/// notifications that scope sent.
pub fn abort_step(db: MemDb) -> Outcome =
  match last(db.stack) {
    None -> fail_open(db, no_transaction("`db.abort`")),
    Some(frame) ->
      done(
        {
          ..memdb(db, frame.tables, db.sequences, db.stack.drop_last(1), frame.failed),
          pending: frame.pending,
        },
        Count(0),
      ),
  }

fn deliver(db: MemDb, notes: List<pg::Notification>) -> MemDb =
  if db.listener.disconnected { db } else {
    {
      ..db,
      listener: {
        ..db.listener,
        inbox: notes.fold(
          db.listener.inbox,
          |inbox: List<pg::Notification>, n: pg::Notification|
            if db.listener.channels.contains(n.channel) { inbox.push(n) } else { inbox },
        ),
      },
    }
  }

/// The most bytes a notification's payload may contain, one less than the 8000 postgres rejects.
pub fn max_payload() -> Int = 7999

/// Implements `db.notify[channel]` on the fake. Inside a transaction the notification is queued
/// until the transaction commits, and a duplicate of a queued notification is ignored. Outside a
/// transaction it is delivered at once. Its sender is `0`, because the fake is not a server
/// process.
pub fn notify_step(db: MemDb, channel: String, payload: String) -> Outcome =
  if db.failed { fail(db, in_failed_txn()) }
  else if Bytes::of_string(payload).len() > max_payload() {
    fail(db, db_error("22023", "", "payload string too long"))
  } else {
    let n = { sender: 0, channel: channel, payload: payload };
    if db.stack.len() == 0 { done(deliver(db, [n]), Count(1)) }
    else if db.pending.contains(n) { done(db, Count(1)) }
    else { done({ ..db, pending: db.pending.push(n) }, Count(1)) }
  }

/// `db.listen[channel]` on the fake: from now on, notifications on it are received.
pub fn listen_step(db: MemDb, channel: String) -> Outcome =
  if db.listener.channels.contains(channel) { done(db, Count(0)) } else {
    done(
      { ..db, listener: { ..db.listener, channels: db.listener.channels.push(channel) } },
      Count(0),
    )
  }

/// Implements `db.unlisten[channel]` on the fake: stops receiving new notifications on the channel.
/// Notifications already in the inbox stay there, and `next_notification` still returns them.
pub fn unlisten_step(db: MemDb, channel: String) -> Outcome =
  done(
    {
      ..db,
      listener: { ..db.listener, channels: db.listener.channels.filter(|c: String| c != channel) },
    },
    Count(0),
  )

/// The fake after a wait for a notification, and what the wait returned.
pub type FakeWaitResult = { db: MemDb, notification: Notice }

/// Implements `db.next_notification` on the fake. If the connection was cut, it reconnects and
/// returns `Reconnected`. Otherwise it returns the oldest notification in the inbox, or `Quiet` at
/// once if the inbox is empty, because the fake never waits. It panics if no channel is listened
/// to, as the driver does.
pub fn next_notification_step(db: MemDb) -> FakeWaitResult / {abort.raise} =
  if db.listener.channels.len() == 0 { panic(nothing_listened()) }
  else if db.listener.disconnected {
    { db: { ..db, listener: { ..db.listener, disconnected: false } }, notification: Reconnected }
  } else {
    match db.listener.inbox {
      [oldest, ..later] ->
        { db: { ..db, listener: { ..db.listener, inbox: later } }, notification: Notified(oldest) },
      [] -> { db: db, notification: Quiet },
    }
  }

/// Returns the fake with its listener's connection cut. Notifications received but not yet taken by
/// a wait are discarded, and notifications sent before the next wait starts listening again are
/// also discarded.
pub fn disconnect_step(db: MemDb) -> MemDb =
  { ..db, listener: { ..db.listener, inbox: [], disconnected: true } }

fn nothing_listened() -> String =
  "`db.notified` waits on the channels `db.listen` named, and there are none"

fn no_transaction(what: String) -> DbError =
  db_error("25P01", "", what ++ " with no transaction open")

fn fail_open(db: MemDb, e: DbError) -> Outcome = { db: db, out: Failed(e) }

fn test_schema() -> Schema = { tables: [test_part(), test_bin()] }

fn test_part() -> Table =
  {
    name: "part",
    columns: [
      column("sku", TText, false),
      column("price", TNumeric(10, 4), false),
      column("tag", TText, true),
      column("n", IntColumn, true),
    ],
    primary_key: ["sku"],
    unique: [{ name: "part_tag_key", columns: ["tag"] }],
    foreign_keys: [],
    checks: [{ name: "part_price_check", expression: "price >= 0" }],
  }

fn test_bin() -> Table =
  {
    name: "bin",
    columns: [
      column_default("id", IntColumn, false, SequenceDefault("bin_id_seq")),
      column("sku", TText, true),
      column("qty", IntColumn, true),
    ],
    primary_key: ["id"],
    unique: [],
    foreign_keys: [
      { name: "bin_sku_fkey", columns: ["sku"], references: "part", refers_to: ["sku"] },
    ],
    checks: [{ name: "bin_qty_check", expression: "qty >= 0" }],
  }

fn test_run(db: MemDb, sql: String, ps: List<Param>) -> Outcome / {abort.raise} =
  step(db, statement_of(sql), ps)

fn test_out(db: MemDb, sql: String, ps: List<Param>) -> QueryResult / {abort.raise} =
  test_run(db, sql, ps).out

fn test_seed() -> MemDb / {abort.raise} = {
  let a = test_run(
    open(test_schema()),
    "insert into part (sku, price, tag, n) values ($1,$2,$3,$4)",
    [TextParameter("a"), NumericParameter(1m), TextParameter("t1"), IntParameter(1)],
  );
  let b = test_run(a.db, "insert into part (sku, price, tag, n) values ($1,$2,$3,$4)", [
    TextParameter("b"),
    NumericParameter(2m),
    TextParameter("t2"),
    NullParameter,
  ]);
  test_run(b.db, "insert into part (sku, price, tag, n) values ($1,$2,$3,$4)", [
    TextParameter("c"),
    NumericParameter(3m),
    NullParameter,
    IntParameter(3),
  ]).db
}

fn test_code(a: QueryResult) -> String =
  match a { Failed(e) -> e.code, Rows(_) -> "rows", Count(_) -> "count" }

fn test_constraint(a: QueryResult) -> String = match a { Failed(e) -> e.constraint, _ -> "" }

fn test_skus(a: QueryResult) -> List<String> =
  match a {
    Rows(rs) -> rs.map(|r: Row| match cell_of(r, "sku") { TextDatum(s) -> s, _ -> "?" }),
    _ -> [],
  }

fn test_count(a: QueryResult) -> Int =
  match a {
    Rows(rs) -> match rs {
      [r, ..] -> match cell_of(r, "count") { IntDatum(n) -> n, _ -> -1 },
      _ -> -1,
    },
    _ -> -1,
  }

test "create_schema renders one statement per table and one per sequence" {
  let sqls = create_schema(test_schema()).map(|s: Statement| s.sql);
  assert_eq(sqls.len(), 3);
  assert_eq(sqls.at(0), Some("create sequence \"bin_id_seq\""));
  assert_eq(
    sqls.at(1),
    Some(
      "create table \"part\" (\"sku\" text not null, \"price\" numeric(10,4) not null, "
        ++ "\"tag\" text, \"n\" bigint, primary key (\"sku\"), "
        ++ "constraint \"part_tag_key\" unique (\"tag\"), "
        ++ "constraint \"part_price_check\" check (price >= 0))",
    ),
  )
}

test "a select filters rows with `where`, sorts them with `order by`, and trims them with `limit` and `offset`" {
  let d = test_seed();
  assert_eq(test_skus(test_out(d, "select sku from part order by sku", [])), ["a", "b", "c"]);
  assert_eq(test_skus(test_out(d, "select sku from part order by sku desc", [])), ["c", "b", "a"]);
  assert_eq(test_skus(test_out(d, "select sku from part order by sku limit 2", [])), ["a", "b"]);
  assert_eq(test_skus(test_out(d, "select sku from part order by sku limit 2 offset 1", [])), [
    "b",
    "c",
  ]);
  assert_eq(test_skus(test_out(d, "select sku from part where price > 1 order by sku", [])), [
    "b",
    "c",
  ]);
  assert_eq(
    test_skus(test_out(d, "select sku from part where sku in ('a','c') order by sku", [])),
    ["a", "c"],
  );
  assert_eq(
    test_skus(test_out(d, "select sku from part where price between 2 and 3 order by sku", [])),
    ["b", "c"],
  );
  assert_eq(test_skus(test_out(d, "select sku from part where tag like 't%' order by sku", [])), [
    "a",
    "b",
  ]);
  assert_eq(test_skus(test_out(d, "select sku from part where sku = 'zz' order by sku", [])), []);
  assert_eq(test_count(test_out(d, "select count(*) from part", [])), 3)
}

test "a comparison with null is unknown, and a `where` selects only rows for which the condition is true" {
  let d = test_seed();
  assert_eq(test_skus(test_out(d, "select sku from part where n = 1 order by sku", [])), ["a"]);
  assert_eq(test_skus(test_out(d, "select sku from part where n <> 1 order by sku", [])), ["c"]);
  assert_eq(test_skus(test_out(d, "select sku from part where n is null order by sku", [])), ["b"]);
  assert_eq(test_skus(test_out(d, "select sku from part where not (n = 1) order by sku", [])), [
    "c",
  ]);
  assert_eq(
    test_skus(test_out(d, "select sku from part where n = 1 or tag = 't2' order by sku", [])),
    ["a", "b"],
  )
}

test "nulls sort last under ascending order and first under descending, and `nulls first` overrides that default" {
  let d = test_seed();
  assert_eq(test_skus(test_out(d, "select sku, n from part order by n, sku", [])), ["a", "c", "b"]);
  assert_eq(test_skus(test_out(d, "select sku, n from part order by n desc, sku", [])), [
    "b",
    "c",
    "a",
  ]);
  assert_eq(test_skus(test_out(d, "select sku, n from part order by n nulls first, sku", [])), [
    "b",
    "a",
    "c",
  ])
}

test "insert returns a count, and returning returns the rows" {
  let d = open(test_schema());
  assert_eq(test_out(d, "insert into part (sku, price) values ('a', 1)", []), Count(1));
  assert_eq(test_out(d, "insert into part (sku, price) values ('a', 1), ('b', 2)", []), Count(2));
  assert_eq(
    test_skus(test_out(d, "insert into part (sku, price) values ('a', 1) returning sku", [])),
    ["a"],
  )
}

test "a numeric column stores the column's scale and rejects what will not fit" {
  let d = open(test_schema());
  let r = test_run(d, "insert into part (sku, price) values ('a', $1) returning price", [
    NumericParameter(1.00m),
  ]);
  match r.out {
    Rows(rs) -> match rs {
      [row, ..] -> match cell_of(row, "price") {
        NumericDatum(v) -> assert_eq(v.to_string(), "1.0000"),
        _ -> assert(false),
      },
      _ -> assert(false),
    },
    _ -> assert(false),
  };
  assert_eq(
    test_code(test_out(d, "insert into part (sku, price) values ('a', 1.00005)", [])),
    "count",
  );
  assert_eq(
    test_code(test_out(d, "insert into part (sku, price) values ('a', 1000000)", [])),
    "22003",
  )
}

test "a constant that will not fit the column fails even when no row matches" {
  let d = test_seed();
  assert_eq(
    test_code(test_out(d, "update part set price = 1000000 where sku = 'zz'", [])),
    "22003",
  );
  assert_eq(test_out(d, "update part set price = 9 where sku = 'zz'", []), Count(0))
}

test "the four constraint classes carry the codes and the names postgres sends" {
  let d = test_seed();
  let dup = test_out(d, "insert into part (sku, price) values ('a', 1)", []);
  assert_eq(test_code(dup), "23505");
  assert_eq(test_constraint(dup), "part_pkey");
  let tag = test_out(d, "insert into part (sku, price, tag) values ('z', 1, 't1')", []);
  assert_eq(test_code(tag), "23505");
  assert_eq(test_constraint(tag), "part_tag_key");
  let nn = test_out(d, "insert into part (sku, price) values ('z', null)", []);
  assert_eq(test_code(nn), "23502");
  assert_eq(test_constraint(nn), "");
  let ck = test_out(d, "insert into part (sku, price) values ('z', -1)", []);
  assert_eq(test_code(ck), "23514");
  assert_eq(test_constraint(ck), "part_price_check");
  let fk = test_out(d, "insert into bin (sku, qty) values ('zz', 1)", []);
  assert_eq(test_code(fk), "23503");
  assert_eq(test_constraint(fk), "bin_sku_fkey")
}

test "two nulls in a unique column do not collide" {
  let d = test_seed();
  assert_eq(test_out(d, "insert into part (sku, price, tag) values ('z', 1, null)", []), Count(1))
}

test "a check passes on unknown and fails only on false" {
  let d = test_seed();
  assert_eq(test_out(d, "insert into bin (sku, qty) values ('a', null)", []), Count(1));
  assert_eq(test_code(test_out(d, "insert into bin (sku, qty) values ('a', -1)", [])), "23514")
}

test "a parent with a child cannot be deleted" {
  let d0 = test_seed();
  let d1 = test_run(d0, "insert into bin (sku, qty) values ('a', 1)", []).db;
  assert_eq(test_code(test_out(d1, "delete from part where sku = 'a'", [])), "23503");
  assert_eq(test_out(d1, "delete from part where sku = 'b'", []), Count(1))
}

test "a parameter carrying SQL is a value and never syntax" {
  let d = open(test_schema());
  let r = test_run(d, "insert into part (sku, price) values ($1, 1) returning sku", [
    TextParameter("'; drop table part; --"),
  ]);
  assert_eq(test_skus(r.out), ["'; drop table part; --"]);
  assert_eq(test_count(test_out(r.db, "select count(*) from part", [])), 1)
}

test "a committed scope is visible and an aborted one is not" {
  let d0 = test_seed();
  let b = begin_step(d0, ReadCommitted, ReadWrite);
  let i = test_run(b.db, "insert into part (sku, price) values ('z', 1)", []);
  assert_eq(test_count(test_out(i.db, "select count(*) from part", [])), 4);
  let c = commit_step(i.db);
  assert_eq(test_count(test_out(c.db, "select count(*) from part", [])), 4);
  let b2 = begin_step(c.db, ReadCommitted, ReadWrite);
  let i2 = test_run(b2.db, "delete from part where sku = 'z'", []);
  let a2 = abort_step(i2.db);
  assert_eq(test_count(test_out(a2.db, "select count(*) from part", [])), 4)
}

test "after a statement fails inside a transaction, every later statement fails with error 25P02, meaning the transaction is aborted" {
  let d0 = test_seed();
  let b = begin_step(d0, ReadCommitted, ReadWrite);
  let bad = test_run(b.db, "insert into part (sku, price) values ('a', 1)", []);
  assert_eq(test_code(bad.out), "23505");
  assert_eq(test_code(test_out(bad.db, "select count(*) from part", [])), "25P02");
  let c = commit_step(bad.db);
  assert_eq(test_code(c.out), "25P02");
  assert_eq(test_count(test_out(c.db, "select count(*) from part", [])), 3)
}

test "rolling back to a savepoint clears the failed state and the inner writes" {
  let d0 = test_seed();
  let b = begin_step(d0, ReadCommitted, ReadWrite);
  let i = test_run(b.db, "insert into part (sku, price) values ('z', 1)", []);
  let savepoint = begin_step(i.db, ReadCommitted, ReadWrite);
  let bad = test_run(savepoint.db, "insert into part (sku, price) values ('z', 2)", []);
  assert_eq(test_code(bad.out), "23505");
  let back = abort_step(bad.db);
  assert_eq(test_count(test_out(back.db, "select count(*) from part", [])), 4);
  let c = commit_step(back.db);
  assert_eq(test_count(test_out(c.db, "select count(*) from part", [])), 4)
}

test "releasing a savepoint in an aborted transaction fails as an aborted transaction, and the later commit also fails and writes nothing" {
  let d0 = test_seed();
  let b = begin_step(d0, ReadCommitted, ReadWrite);
  let i = test_run(b.db, "insert into part (sku, price) values ('z', 1)", []);
  let savepoint = begin_step(i.db, ReadCommitted, ReadWrite);
  let bad = test_run(savepoint.db, "insert into part (sku, price) values ('z', 2)", []);
  let rel = commit_step(bad.db);
  assert_eq(test_code(rel.out), "25P02");
  let c = commit_step(rel.db);
  assert_eq(test_code(c.out), "25P02");
  assert_eq(test_count(test_out(c.db, "select count(*) from part", [])), 3)
}

test "an id from a serial column is not reused after the transaction that took it rolls back" {
  let d0 = test_seed();
  let b = begin_step(d0, ReadCommitted, ReadWrite);
  let i = test_run(b.db, "insert into bin (sku, qty) values ('a', 1) returning id", []);
  assert_eq(i.out, Rows([Map::new().insert("id", IntDatum(1))]));
  let a = abort_step(i.db);
  let j = test_run(a.db, "insert into bin (sku, qty) values ('a', 2) returning id", []);
  assert_eq(j.out, Rows([Map::new().insert("id", IntDatum(2))]))
}

test "a write in a read-only transaction fails, and beginning a nested transaction at a different isolation level fails" {
  let d0 = test_seed();
  let ro = begin_step(d0, ReadCommitted, ReadOnly);
  assert_eq(
    test_code(test_out(ro.db, "insert into part (sku, price) values ('z', 1)", [])),
    "25006",
  );
  assert_eq(test_count(test_out(ro.db, "select count(*) from part", [])), 3);
  let rw = begin_step(d0, Serializable, ReadWrite);
  let nested = begin_step(rw.db, ReadCommitted, ReadWrite);
  assert_eq(test_code(nested.out), "25001")
}

test "the savepoint stack is bounded" {
  assert_eq(
    test_code(
      test_deepen(
        begin_step(open(test_schema()), ReadCommitted, ReadWrite).db,
        max_savepoints() + 1,
      ).out,
    ),
    "54000",
  )
}

fn test_deepen(db: MemDb, left: Int) -> Outcome = {
  let r = begin_step(db, ReadCommitted, ReadWrite);
  if left <= 1 { r } else { test_deepen(r.db, left - 1) }
}

test "the fake database rejects each SQL feature it does not support with the not-supported error code" {
  let d = test_seed();
  let rejected = [
    "select p.sku from part p join bin b on p.sku = b.sku",
    "select sku from part where sku in (select sku from bin)",
    "select count(*), sku from part group by sku",
    "select sum(n) from part",
    "select sku from part union select sku from bin",
    "with x as (select 1) select sku from part",
    "insert into part (sku, price) values ('a', 1) on conflict do nothing",
    "select sku from part; select 1 from part",
    "create table t (a int)",
    "select sku from part order by n + 1",
    "select sku from part where tag like 'a%' escape '!'",
    "select 1e3 from part",
    "select now() from part",
    "select sku from part order by 1",
  ];
  assert_eq(
    rejected.map(|s: String| test_code(test_out(d, s, []))),
    rejected.map(|s: String| "0A000"),
  )
}

test "a comment and a result-column alias are ordinary SQL, not rejected" {
  let d = test_seed();
  assert_eq(test_code(test_out(d, "select sku from part -- trailing", [])), "rows");
  assert_eq(test_code(test_out(d, "select /* leading */ sku from part order by sku", [])), "rows");
  assert_eq(test_code(test_out(d, "select /* a /* nested */ one */ sku from part", [])), "rows");
  assert_eq(
    test_out(d, "select sku as ident from part order by sku", []),
    Rows([
      Map::new().insert("ident", TextDatum("a")),
      Map::new().insert("ident", TextDatum("b")),
      Map::new().insert("ident", TextDatum("c")),
    ]),
  );
  assert_eq(
    test_out(d, "select count(*) as c from part", []),
    Rows([Map::new().insert("c", IntDatum(3))]),
  );
  assert_eq(test_code(test_out(d, "select sku, sku from part", [])), "0A000");
  assert_eq(test_code(test_out(d, "select sku as x, tag as x from part", [])), "0A000");
  assert_eq(test_code(test_out(d, "select sku from part /* never closed", [])), "0A000")
}

test "a query on a missing table or a missing column fails with the undefined-table or undefined-column error code" {
  let d = test_seed();
  assert_eq(test_code(test_out(d, "select sku from nosuch order by sku", [])), "42P01");
  assert_eq(test_code(test_out(d, "select nosuch from part", [])), "42703");
  assert_eq(test_code(test_out(d, "select sku from part order by nosuch", [])), "42703")
}

test "a text parameter in an integer column is rejected rather than coerced" {
  let d = open(test_schema());
  assert_eq(
    test_code(
      test_out(d, "insert into part (sku, price, n) values ('a', 1, $1)", [TextParameter("x")]),
    ),
    "42804",
  );
  assert_eq(
    test_code(test_out(d, "insert into part (sku, price, n) values ('a', 1, 'x')", [])),
    "22P02",
  )
}

test "a parameter numbered past the ones given, or below one, is rejected" {
  let d = open(test_schema());
  assert_eq(
    test_code(test_out(d, "insert into part (sku, price) values ($2, 1)", [TextParameter("a")])),
    "42P02",
  );
  assert_eq(
    test_code(test_out(d, "insert into part (sku, price) values ($0, 1)", [TextParameter("a")])),
    "42P02",
  )
}

fn test_notification(channel: String, payload: String) -> Notice =
  Notified({ sender: 0, channel: channel, payload: payload })

fn test_listening() -> MemDb = listen_step(open({ tables: [] }), "jobs").db

fn test_notified(db: MemDb, payload: String) -> MemDb = notify_step(db, "jobs", payload).db

fn test_begun(db: MemDb) -> MemDb = begin_step(db, ReadCommitted, ReadWrite).db

test "the fake delivers a notification when its transaction commits, and never when it rolls back" {
  let queued = test_notified(test_notified(test_begun(test_listening()), "a"), "a");
  assert_eq(next_notification_step(queued).notification, Quiet);
  let others = notify_step(queued, "audit", "x").db;
  let commit_result = next_notification_step(commit_step(others).db);
  assert_eq(commit_result.notification, test_notification("jobs", "a"));
  assert_eq(next_notification_step(commit_result.db).notification, Quiet);
  let rolled = abort_step(test_notified(test_begun(commit_result.db), "b")).db;
  assert_eq(next_notification_step(rolled).notification, Quiet);
  let now = test_notified(rolled, "c");
  assert_eq(next_notification_step(now).notification, test_notification("jobs", "c"))
}

test "rolling back a savepoint drops notifications sent inside it, but notifications sent earlier in the transaction are still delivered on commit" {
  let outer = test_notified(test_begun(test_listening()), "kept");
  let inner = abort_step(test_notified(test_begun(outer), "undone")).db;
  let first = next_notification_step(commit_step(inner).db);
  assert_eq(first.notification, test_notification("jobs", "kept"));
  assert_eq(next_notification_step(first.db).notification, Quiet)
}

test "the fake database fails a notification with the same error codes as a real server, for an oversized payload and for an aborted transaction" {
  let long = String::of_bytes(Bytes::concat_all(range(0, 8000).map(|i: Int| b"x")));
  assert_eq(test_code(notify_step(test_listening(), "jobs", long).out), "22023");
  let failed = test_run(test_begun(test_listening()), "select * from missing", []).db;
  assert_eq(test_code(notify_step(failed, "jobs", "x").out), "25P02")
}

test "after the connection is cut, a listener drops its queued notifications and ignores those sent meanwhile, and its next wait returns `Reconnected`" {
  let notified = test_notified(test_listening(), "before");
  let cut = disconnect_step(notified);
  let lost = test_notified(cut, "during");
  let back = next_notification_step(lost);
  assert_eq(back.notification, Reconnected);
  assert_eq(next_notification_step(back.db).notification, Quiet);
  let after = next_notification_step(test_notified(back.db, "after"));
  assert_eq(after.notification, test_notification("jobs", "after"));
  let unheard = unlisten_step(after.db, "jobs").db;
  assert_eq(unheard.listener.channels, []);
  assert_eq(test_notified(unheard, "gone").listener.inbox, [])
}

effect outage {
  write cut() -> Unit
}

fn on_fake<a | e>(
  body: () -> a / {db.begin, db.commit, db.abort, db.notify[jobs], db.listen[jobs], db.next_notification, outage.cut | e},
) -> a / {abort.raise | e} =
  handle {
    body()
  } with {
    var t = open({ tables: [] }),
    db.begin(level, access) -> {
      let o = begin_step(t, level, access);
      t = o.db;
      o.out
    },
    db.commit() -> {
      let o = commit_step(t);
      t = o.db;
      o.out
    },
    db.abort() -> {
      let o = abort_step(t);
      t = o.db;
      o.out
    },
    db.notify[jobs](payload) -> {
      let o = notify_step(t, "jobs", payload);
      t = o.db;
      o.out
    },
    db.listen[jobs]() -> {
      let o = listen_step(t, "jobs");
      t = o.db;
      o.out
    },
    db.next_notification(timeout_ms) -> {
      let w = next_notification_step(t);
      t = w.db;
      w.notification
    },
    outage.cut() -> {
      t = disconnect_step(t);
    },
  }

type SmallCount = | Never | Once | Twice

fn times(t: SmallCount) -> Int = match t { Never -> 0, Once -> 1, Twice -> 2 }

fn test_waits(waits: Int) -> List<Notice> / {db.next_notification, task.yield} =
  range(0, waits).fold([], |notices: List<Notice>, i: Int| {
    let n = db.next_notification(100);
    task.yield();
    notices.push(n)
  })

fn announced(notices: List<Notice>, sent: Int) -> Bool / {abort.raise} = {
  let walked = notices.fold(
    { next: 0, warned: false, ok: true },
    |at: { next: Int, warned: Bool, ok: Bool }, n: Notice|
      match n {
        Reconnected -> { ..at, warned: true },
        Notified(note) -> match note.payload.int_of_string() {
          Some(i) -> if i == at.next { { next: i + 1, warned: false, ok: at.ok } }
          else if i > at.next && at.warned { { next: i + 1, warned: false, ok: at.ok } }
          else { { ..at, ok: false } },
          None -> { ..at, ok: false },
        },
        _ -> at,
      },
  );
  walked.ok && (walked.next == sent || walked.warned)
}

type Strain = { extra_notices: SmallCount, disconnects: SmallCount }

fn strains() -> List<Strain> =
  [Never, Once, Twice].fold([], |accumulator: List<Strain>, sent: SmallCount|
    [Never, Once, Twice].fold(accumulator, |inner: List<Strain>, cut: SmallCount|
      inner.push({ extra_notices: sent, disconnects: cut })))

test "a listener on the fake database receives every committed notification in order and learns of every disconnect, whatever the task scheduling, with {times(c.extra_notices) + 1} notifications and {times(c.disconnects)} disconnects" for c: Strain in strains(
  ) {
  simulate {
    let n = times(c.extra_notices) + 1;
    let notices = on_fake(|| {
      db.listen[jobs]();
      let notifier = task.spawn(||
        range(0, n).fold((), |u: Unit, i: Int| {
          transaction(ReadCommitted, ReadWrite, || db.notify[jobs](i.to_string()));
          task.yield()
        }));
      let cutter = task.spawn(||
        range(0, times(c.disconnects)).fold((), |u: Unit, i: Int| {
          task.yield();
          outage.cut()
        }));
      let early = test_waits(n + 1);
      task.join(notifier);
      task.join(cutter);
      early.concat(test_waits(n + 2))
    });
    let deliver = notices.filter(|h: Notice| match h { Notified(_) -> true, _ -> false });
    assert(announced(notices, n));
    assert(c.disconnects != Never || (deliver.len() == n && !notices.contains(Reconnected)))
  }
}

/// Whether the driver's connections are secured: not at all; with TLS after asking the server, as
/// `sslmode=require`, `verify-ca` and `verify-full` request; or with TLS at once, as
/// `sslnegotiation=direct` requests of a server from Postgres 17 on. Whenever TLS is requested, the
/// server's certificate is verified for the host as `verify-full` verifies it, against the built-in
/// roots and `--trust`. `std.net` has no handshake that skips verification, so `require` and
/// `verify-ca` here mean `verify-full`, never libpq's weaker meanings.
pub type Ssl = | Disabled | Negotiated | Immediate

/// Describes the Postgres server to connect to and the settings each connection starts with.
/// `server` builds one with no settings, and `server_of` parses one from a connection string. The
/// password is a `Secret` from parsing until it is sent with `net.send_secret`.
pub type Server = {
  host: String,
  port: Int,
  ssl: Ssl,
  user: String,
  database: String,
  password: Option<Secret<Bytes>>,
  /// Settings sent to the server when each connection starts, so every connection the pool opens
  /// uses them. `statement_timeout_ms` is the longest a statement may run, and
  /// `idle_in_transaction_timeout_ms` is the longest a transaction may sit idle between statements.
  /// The server ends the statement or transaction when the limit passes. Both are in milliseconds,
  /// and `None` uses the server's default. `application_name` is the name the server lists the
  /// session under.
  statement_timeout_ms: Option<Int>,
  idle_in_transaction_timeout_ms: Option<Int>,
  application_name: Option<String>,
  client: pg::Timeouts,
}

/// A server reached in plaintext, with none of the start-up settings.
pub fn server(
  host: String,
  port: Int,
  user: String,
  database: String,
  password: Option<Secret<Bytes>>,
) -> Server =
  {
    host: host,
    port: port,
    ssl: Disabled,
    user: user,
    database: database,
    password: password,
    statement_timeout_ms: None,
    idle_in_transaction_timeout_ms: None,
    application_name: None,
    client: pg::default_timeouts(),
  }

/// The settings a connection starts with, under the names postgres gives them.
pub fn startup_parameters(s: Server) -> List<pg::Parameter> =
  parameter("application_name", s.application_name).concat(
    parameter("statement_timeout", millis_text(s.statement_timeout_ms)),
  ).concat(
    parameter("idle_in_transaction_session_timeout", millis_text(s.idle_in_transaction_timeout_ms)),
  )

fn parameter(name: String, value: Option<String>) -> List<pg::Parameter> =
  match value { Some(v) -> [{ name: name, value: v }], None -> [] }

fn millis_text(ms: Option<Int>) -> Option<String> =
  match ms { Some(n) -> Some(n.to_string()), None -> None }

type PooledConnection = { n: Int, session: pg::Session }

type Scope = {
  n: Int,
  session: Option<pg::Session>,
  depth: Int,
  level: Isolation,
  access: Access,
  busy: Bool,
  copying: Bool,
}

type Copy = {
  id: Int,
  n: Int,
  session: Option<pg::Session>,
  in_transaction: Bool,
  out: Bool,
  columns: List<pg::Column>,
  pending: Bytes,
  done: Bool,
  rows_taken: Int,
  failed: Option<DbError>,
}

type Listener = {
  session: Option<pg::Session>,
  channels: List<String>,
  waiting: Bool,
  lost: Bool,
  connections_opened: Int,
}

type Pool = {
  idle: List<PooledConnection>,
  opened: Int,
  made: Int,
  open: List<Scope>,
  copied_fields: List<Copy>,
  copied: Int,
  listener: Listener,
}

fn hex_of(b: Bytes) -> String =
  range(0, b.len()).fold("", |accumulator: String, i: Int| {
    let v = b.at(i);
    accumulator ++ "0123456789abcdef".slice(v >>> 4, (v >>> 4) + 1)
      ++ "0123456789abcdef".slice(v & 0xF, (v & 0xF) + 1)
  })

fn hex_value(c: Int) -> Int =
  if c >= 48 && c <= 57 { c - 48 }
  else if c >= 97 && c <= 102 { c - 87 }
  else if c >= 65 && c <= 70 { c - 55 }
  else { 0 }

fn unhex_text(text: String) -> Bytes / {abort.raise} = {
  let b = Bytes::of_string(text);
  Bytes::concat_all(
    range(0, b.len() / 2).map(|i: Int|
      byte_of_int(hex_value(b.at(i * 2)) * 16 + hex_value(b.at(i * 2 + 1)))),
  )
}

fn bytes_of_bytea(text: String) -> Bytes / {abort.raise} =
  if text.starts_with("\\x") { unhex_text(text.slice(2, text.len())) }
  else { Bytes::of_string(text) }

fn int_or_zero(text: String) -> Int / {abort.raise} = text.int_of_string().unwrap_or(0)

fn float_of_text(text: String) -> Float = match Float::of_string(text) { Some(f) -> f, None -> 0.0 }

fn json_of_text(text: String) -> json::Json / {abort.raise} =
  match json::parse_string(text) { Ok(j) -> j, Err(_) -> json::Str(text) }

fn element_oid(oid: Int) -> Int =
  if oid == 1000 { 16 }
  else if oid == 1001 { 17 }
  else if oid == 1005 { 21 }
  else if oid == 1007 { 23 }
  else if oid == 1016 { 20 }
  else if oid == 1009 { 25 }
  else if oid == 1015 { 1043 }
  else if oid == 1021 { 700 }
  else if oid == 1022 { 701 }
  else if oid == 1231 { 1700 }
  else if oid == 199 { 114 }
  else if oid == 3807 { 3802 }
  else { 0 }

type ArrayScan = {
  items: List<Datum>,
  piece: String,
  quoted: Bool,
  was_quoted: Bool,
  escaped: Bool,
  done: Bool,
}

fn array_values(element: Int, text: String) -> List<Datum> / {abort.raise} = {
  let inner = if text.len() >= 2 { text.slice(1, text.len() - 1) } else { "" };
  let end = range(0, inner.len()).fold(
    { items: [], piece: "", quoted: false, was_quoted: false, escaped: false, done: false },
    |accumulator: ArrayScan, i: Int|
      if accumulator.done { accumulator } else {
        let c = inner.slice(i, i + 1);
        if accumulator.escaped { { ..accumulator, piece: accumulator.piece ++ c, escaped: false } }
        else if accumulator.quoted && c == "\\" { { ..accumulator, escaped: true } }
        else if c == "\"" { { ..accumulator, quoted: !accumulator.quoted, was_quoted: true } }
        else if !accumulator.quoted && c == "," {
          {
            ..accumulator,
            items: accumulator.items.push(
              array_value(element, accumulator.piece, accumulator.was_quoted),
            ),
            piece: "",
            was_quoted: false,
          }
        } else { { ..accumulator, piece: accumulator.piece ++ c } }
      },
  );
  if inner.len() == 0 { [] }
  else { end.items.push(array_value(element, end.piece, end.was_quoted)) }
}

fn array_value(element: Int, piece: String, was_quoted: Bool) -> Datum / {abort.raise} =
  if !was_quoted && piece == "NULL" { NullDatum } else { scalar_datum(element, piece) }

fn datum_of(oid: Int, text: Option<String>) -> Datum / {abort.raise} =
  match text {
    None -> NullDatum,
    Some(t) -> if element_oid(oid) != 0 { ArrayDatum(array_values(element_oid(oid), t)) }
    else { scalar_datum(oid, t) },
  }

fn scalar_datum(oid: Int, t: String) -> Datum / {abort.raise} =
  if oid == 16 { BoolDatum(t == "t") }
  else if oid == 20 || oid == 21 || oid == 23 { IntDatum(int_or_zero(t)) }
  else if oid == 700 || oid == 701 { FloatDatum(float_of_text(t)) }
  else if oid == 1700 { NumericDatum(Decimal::of_string(t).unwrap_or(Decimal::of_int(0))) }
  else if oid == 17 { BytesDatum(bytes_of_bytea(t)) }
  else if oid == 114 || oid == 3802 { JsonDatum(json_of_text(t)) }
  else { TextDatum(t) }

fn datum_bytes(oid: Int, raw: Option<Bytes>) -> Datum / {abort.raise} =
  match raw { None -> NullDatum, Some(b) -> datum_of(oid, Some(String::of_bytes_lossy(b))) }

fn param_text(p: Param) -> Option<String> / {abort.raise} =
  match p {
    NullParameter -> None,
    IntParameter(n) -> Some(n.to_string()),
    BoolParameter(b) -> Some(if b { "t" } else { "f" }),
    TextParameter(s) -> Some(s),
    BytesParameter(b) -> Some("\\x" ++ hex_of(b)),
    FloatParameter(f) -> Some(f.to_string()),
    NumericParameter(d) -> Some(d.to_string()),
    JsonParameter(j) -> Some(json::to_string(j)),
    ArrayParameter(items) ->
      Some("{" ++ String::join(items.map(|p: Param| array_element_text(p)), ",") ++ "}"),
  }

fn array_element_text(p: Param) -> String / {abort.raise} =
  match param_text(p) {
    None -> "NULL",
    Some(t) ->
      "\""
        ++ range(0, t.len()).fold("", |accumulator: String, i: Int| {
          let c = t.slice(i, i + 1);
          if c == "\"" || c == "\\" { accumulator ++ "\\" ++ c } else { accumulator ++ c }
        })
        ++ "\"",
  }

fn last_word(text: String) -> Option<String> =
  text.split(" ").fold(None, |accumulator: Option<String>, w: String|
    if w.len() > 0 { Some(w) } else { accumulator })

fn count_of(tag: String) -> Int / {abort.raise} =
  match last_word(tag) { Some(w) -> int_or_zero(w), None -> 0 }

fn row_of(
  columns: List<pg::Column>,
  values: List<Option<Bytes>>,
  i: Int,
  accumulator: Row,
) -> Row / {abort.raise} =
  if i >= columns.len() { accumulator } else {
    match columns.at(i) {
      None -> accumulator,
      Some(column) -> {
        let raw = match values.at(i) { Some(v) -> v, None -> None };
        row_of(columns, values, i + 1, accumulator.insert(column.name, datum_bytes(column.ty, raw)))
      },
    }
  }

fn rows_of(
  columns: List<pg::Column>,
  rows: List<List<Option<Bytes>>>,
) -> List<Row> / {abort.raise} =
  rows.map(|r: List<Option<Bytes>>| row_of(columns, r, 0, Map::new()))

fn isolation_sql(level: Isolation) -> String =
  match level {
    ReadCommitted -> "read committed",
    RepeatableRead -> "repeatable read",
    Serializable -> "serializable",
  }

fn access_sql(access: Access) -> String =
  match access { ReadWrite -> "read write", ReadOnly -> "read only" }

fn savepoint_name(depth: Int) -> String = "ply_sp" ++ depth.to_string()

type Route = | Own(Scope) | NoTransaction | Ambiguous

fn route(open: List<Scope>) -> Route =
  match open.filter(|s: Scope| !s.busy) { [] -> NoTransaction, [s] -> Own(s), _ -> Ambiguous }

fn ambiguous(what: String) -> String =
  what
    ++ " was performed while two transactions were idle, so the driver cannot tell which transaction it belongs to. A transaction is idle when its task is not waiting on the server. A task with an open transaction should wait only for its own statements"

type Claim = | Idle(PooledConnection) | Fresh(Int)

fn claim_n(c: Claim) -> Int = match c { Idle(l) -> l.n, Fresh(n) -> n }

type Plan = | Returned(QueryResult) | Outside(Claim) | Within(Scope, pg::Session)

type Decision = { pool: Pool, plan: Plan }

fn outside_transaction(p: Pool, size: Int) -> Decision =
  match p.idle {
    [first, ..rest] -> { pool: { ..p, idle: rest }, plan: Outside(Idle(first)) },
    [] -> if p.opened >= size { { pool: p, plan: Returned(Failed(pool_busy(size))) } } else {
      { pool: { ..p, opened: p.opened + 1, made: p.made + 1 }, plan: Outside(Fresh(p.made)) }
    },
  }

fn pool_busy(size: Int) -> DbError =
  db_error("53300", "", "the pool of " ++ size.to_string() ++ " connection(s) is busy")

fn within(p: Pool, scope: Scope) -> Decision =
  if scope.copying { { pool: p, plan: Returned(Failed(copy_in_use())) } } else {
    match scope.session {
      None -> { pool: p, plan: Returned(Failed(connection_lost())) },
      Some(session) -> { pool: mark_scope_busy(p, scope.n), plan: Within(scope, session) },
    }
  }

fn copy_in_use() -> DbError =
  db_error(
    "55000",
    "",
    "this transaction's connection is in use by a copy, and cannot run anything else until the copy ends",
  )

fn mark_scope_busy(p: Pool, n: Int) -> Pool =
  { ..p, open: p.open.map(|s: Scope| if s.n == n { { ..s, busy: true } } else { s }) }

fn for_statement(p: Pool, size: Int, what: String) -> Decision / {abort.raise} =
  match route(p.open) {
    Ambiguous -> panic(ambiguous(what)),
    Own(scope) -> within(p, scope),
    NoTransaction -> outside_transaction(p, size),
  }

fn for_begin(p: Pool, size: Int, level: Isolation, access: Access) -> Decision / {abort.raise} =
  match route(p.open) {
    Ambiguous -> panic(ambiguous("`db.begin`")),
    NoTransaction -> outside_transaction(p, size),
    Own(scope) -> match scope.session {
      None -> within(p, scope),
      Some(s) -> match nested_begin_error(
          s.status == pg::FailedTransaction,
          scope.depth,
          scope.level,
          scope.access,
          level,
          access,
        ) {
        Some(e) -> { pool: p, plan: Returned(Failed(e)) },
        None -> within(p, scope),
      },
    },
  }

type Closing = | Resolved(QueryResult) | Closes(Scope, pg::Session)

type ToClose = { pool: Pool, closing: Closing }

fn prepare_transaction_close(p: Pool, what: String, lost: QueryResult) -> ToClose / {abort.raise} =
  match route(p.open) {
    Ambiguous -> panic(ambiguous(what)),
    NoTransaction -> { pool: p, closing: Resolved(Failed(no_transaction(what))) },
    Own(scope) -> if scope.copying { { pool: p, closing: Resolved(Failed(copy_in_use())) } } else {
      match scope.session {
        None -> { pool: { ..p, open: without_scope(p.open, scope) }, closing: Resolved(lost) },
        Some(session) -> { pool: mark_scope_busy(p, scope.n), closing: Closes(scope, session) },
      }
    },
  }

fn without_scope(open: List<Scope>, scope: Scope) -> List<Scope> = {
  let others = open.filter(|s: Scope| s.n != scope.n);
  if scope.depth > 1 { others.push({ ..scope, depth: scope.depth - 1 }) } else { others }
}

type Release = | Reuse(PooledConnection) | Lost

type OperationResult = { result: QueryResult, n: Int, scope: Option<Scope>, freed: Option<Release> }

fn apply_result(p: Pool, left: OperationResult) -> Pool = {
  let others = p.open.filter(|s: Scope| s.n != left.n);
  let q = { ..p, open: match left.scope { Some(s) -> others.push(s), None -> others } };
  match left.freed {
    None -> q,
    Some(Reuse(l)) -> { ..q, idle: q.idle.push(l) },
    Some(Lost) -> { ..q, opened: q.opened - 1 },
  }
}

fn client_error(e: pg::ClientError) -> DbError =
  match e {
    pg::Rejected(_, s) -> server_error(s),
    pg::ConnectionRejected(s) -> server_error(s),
    pg::Unreachable -> db_error("08001", "", pg::client_error_text(e)),
    pg::Declined -> db_error("08001", "", pg::client_error_text(e)),
    pg::Unsecured(_) -> db_error("08001", "", pg::client_error_text(e)),
    pg::Unexpected(what) -> db_error("08P01", "", what),
    _ -> db_error("08006", "", pg::client_error_text(e)),
  }

fn server_error(s: pg::ServerError) -> DbError = {
  let message = if s.detail == "" { s.message } else { s.message ++ ": " ++ s.detail };
  db_error(s.code, s.constraint, message)
}

fn connection_lost() -> DbError =
  db_error(
    "08003",
    "",
    "the connection this transaction ran on was lost, and the transaction with it",
  )

fn unresolved(e: pg::ClientError) -> DbError =
  db_error(
    "08007",
    "",
    "the connection failed before the server responded to the commit: " ++ pg::client_error_text(e),
  )

type StatementResult = { session: pg::Session, result: QueryResult }

fn check_statement(
  s: Statement,
  operation: Operation,
  label: String,
  what: String,
) -> Unit / {abort.raise} =
  match sql::check_statement(
      None,
      {
        dialect: Postgres,
        operation: operation,
        label: Some(label),
        parameter_constructors: None,
        row: None,
      },
      s.sql,
    ) {
    [] -> (),
    [f, ..] -> panic(what ++ " rejects this statement: " ++ f.message),
  }

fn run_checked(
  session: pg::Session,
  s: Statement,
  ps: List<Param>,
  rows: Bool,
  config: Server,
) -> Result<StatementResult, pg::ClientError> / {net.send[link], net.recv[link], abort.raise, diverges} =
  match pg::extended_query[link](
      session,
      s.sql,
      ps.map(|param: Param| param_text(param)),
      config.client,
    ) {
    Err(e) -> Err(e),
    Ok(reply) ->
      Ok({
        session: reply.session,
        result: if rows { Rows(rows_of(reply.result.columns, reply.result.rows)) }
        else { Count(count_of(reply.result.tag)) },
      }),
  }

fn control(
  session: pg::Session,
  sql: String,
  config: Server,
) -> Result<pg::Reply, pg::ClientError> / {net.send[link], net.recv[link], abort.raise, diverges} =
  pg::simple_query[link](session, sql, config.client)

fn tls_of(config: Server) -> pg::Tls =
  match config.ssl {
    Disabled -> pg::NoTls,
    Negotiated -> pg::Requested(config.host),
    Immediate -> pg::Direct(config.host),
  }

fn open_connection(
  config: Server,
  nonce: String,
  c: Claim,
) -> Result<PooledConnection, DbError> / {net.connect[link], net.start_tls[link], net.peer_certificate[link], net.send[link], net.send_secret[link], net.recv[link], net.close[link], abort.raise, diverges} =
  match c {
    Idle(l) -> Ok(l),
    Fresh(n) -> match pg::connect[link](
        config.host,
        config.port,
        tls_of(config),
        config.user,
        config.database,
        startup_parameters(config),
        config.password,
        nonce ++ "-" ++ n.to_string(),
        config.client,
      ) {
      Err(e) -> Err(client_error(e)),
      Ok(session) -> Ok({ n: n, session: session }),
    },
  }

fn release_after_failure(
  l: PooledConnection,
  e: pg::ClientError,
  config: Server,
) -> OperationResult / {net.send[link], net.close[link], abort.raise} =
  match e {
    pg::Rejected(session, server) ->
      {
        result: Failed(server_error(server)),
        n: l.n,
        scope: None,
        freed: Some(Reuse({ ..l, session: session })),
      },
    _ -> {
      pg::finish[link](l.session, config.client);
      { result: Failed(client_error(e)), n: l.n, scope: None, freed: Some(Lost) }
    },
  }

fn updated_scope(scope: Scope, session: pg::Session, deeper: Int) -> Scope =
  { ..scope, session: Some(session), depth: scope.depth + deeper, busy: false }

fn failed_in_transaction(
  scope: Scope,
  session: pg::Session,
  e: pg::ClientError,
  config: Server,
  deeper: Int,
) -> OperationResult / {net.send[link], net.close[link], abort.raise} =
  match e {
    pg::Rejected(after, server) ->
      {
        result: Failed(server_error(server)),
        n: scope.n,
        scope: Some(updated_scope(scope, after, deeper)),
        freed: None,
      },
    _ -> {
      pg::finish[link](session, config.client);
      {
        result: Failed(client_error(e)),
        n: scope.n,
        scope: Some({ ..scope, session: None, depth: scope.depth + deeper, busy: false }),
        freed: Some(Lost),
      }
    },
  }

fn statement_outside(
  config: Server,
  nonce: String,
  c: Claim,
  s: Statement,
  ps: List<Param>,
  rows: Bool,
) -> OperationResult / {net.connect[link], net.start_tls[link], net.peer_certificate[link], net.send[link], net.send_secret[link], net.recv[link], net.close[link], abort.raise, diverges} =
  match open_connection(config, nonce, c) {
    Err(e) -> { result: Failed(e), n: claim_n(c), scope: None, freed: Some(Lost) },
    Ok(l) -> match run_checked(l.session, s, ps, rows, config) {
      Ok(ran) ->
        {
          result: ran.result,
          n: l.n,
          scope: None,
          freed: Some(Reuse({ ..l, session: ran.session })),
        },
      Err(e) -> release_after_failure(l, e, config),
    },
  }

fn statement_within(
  config: Server,
  scope: Scope,
  session: pg::Session,
  s: Statement,
  ps: List<Param>,
  rows: Bool,
) -> OperationResult / {net.send[link], net.recv[link], net.close[link], abort.raise, diverges} =
  match run_checked(session, s, ps, rows, config) {
    Ok(ran) ->
      {
        result: ran.result,
        n: scope.n,
        scope: Some(updated_scope(scope, ran.session, 0)),
        freed: None,
      },
    Err(e) -> failed_in_transaction(scope, session, e, config, 0),
  }

fn open_transaction(
  config: Server,
  nonce: String,
  c: Claim,
  level: Isolation,
  access: Access,
) -> OperationResult / {net.connect[link], net.start_tls[link], net.peer_certificate[link], net.send[link], net.send_secret[link], net.recv[link], net.close[link], abort.raise, diverges} =
  match open_connection(config, nonce, c) {
    Err(e) -> { result: Failed(e), n: claim_n(c), scope: None, freed: Some(Lost) },
    Ok(l) -> match control(
        l.session,
        "begin isolation level " ++ isolation_sql(level) ++ " " ++ access_sql(access),
        config,
      ) {
      Ok(reply) ->
        {
          result: Count(0),
          n: l.n,
          scope: Some({
            n: l.n,
            session: Some(reply.session),
            depth: 1,
            level: level,
            access: access,
            busy: false,
            copying: false,
          }),
          freed: None,
        },
      Err(e) -> release_after_failure(l, e, config),
    },
  }

fn open_savepoint(
  config: Server,
  scope: Scope,
  session: pg::Session,
) -> OperationResult / {net.send[link], net.recv[link], net.close[link], abort.raise, diverges} =
  match control(session, "savepoint " ++ savepoint_name(scope.depth + 1), config) {
    Ok(reply) ->
      {
        result: Count(0),
        n: scope.n,
        scope: Some(updated_scope(scope, reply.session, 1)),
        freed: None,
      },
    Err(e) -> failed_in_transaction(scope, session, e, config, 0),
  }

fn end_transaction(scope: Scope, session: pg::Session, result: QueryResult) -> OperationResult =
  { result: result, n: scope.n, scope: None, freed: Some(Reuse({ n: scope.n, session: session })) }

fn commit_scope(
  config: Server,
  scope: Scope,
  session: pg::Session,
) -> OperationResult / {net.send[link], net.recv[link], net.close[link], abort.raise, diverges} =
  if scope.depth > 1 {
    match control(session, "release savepoint " ++ savepoint_name(scope.depth), config) {
      Ok(reply) ->
        {
          result: Count(0),
          n: scope.n,
          scope: Some(updated_scope(scope, reply.session, -1)),
          freed: None,
        },
      Err(e) -> failed_in_transaction(scope, session, e, config, -1),
    }
  } else {
    match control(session, "commit", config) {
      Ok(reply) -> end_transaction(scope, reply.session, commit_result(reply.result.tag)),
      Err(pg::Rejected(after, server)) ->
        end_transaction(scope, after, Failed(server_error(server))),
      Err(e) -> {
        pg::finish[link](session, config.client);
        { result: Failed(unresolved(e)), n: scope.n, scope: None, freed: Some(Lost) }
      },
    }
  }

fn commit_result(tag: String) -> QueryResult =
  if tag == "ROLLBACK" { Failed(in_failed_txn()) } else { Count(0) }

fn abort_scope(
  config: Server,
  scope: Scope,
  session: pg::Session,
) -> OperationResult / {net.send[link], net.recv[link], net.close[link], abort.raise, diverges} =
  if scope.depth > 1 {
    let name = savepoint_name(scope.depth);
    match control(
        session,
        "rollback to savepoint " ++ name ++ "; release savepoint " ++ name,
        config,
      ) {
      Ok(reply) ->
        {
          result: Count(0),
          n: scope.n,
          scope: Some(updated_scope(scope, reply.session, -1)),
          freed: None,
        },
      Err(e) -> failed_in_transaction(scope, session, e, config, -1),
    }
  } else {
    match control(session, "rollback", config) {
      Ok(reply) -> end_transaction(scope, reply.session, Count(0)),
      Err(e) -> release_after_failure({ n: scope.n, session: session }, e, config),
    }
  }

type CopyClaim =
  | CopyRejected(DbError)
  | CopyOutsideTransaction(Claim)
  | CopyWithin(Scope, pg::Session)

type ClaimedCopy = { pool: Pool, claim: CopyClaim }

fn for_copy(p: Pool, size: Int, what: String) -> ClaimedCopy / {abort.raise} =
  match route(p.open) {
    Ambiguous -> panic(ambiguous(what)),
    NoTransaction -> {
      let d = outside_transaction(p, size);
      match d.plan {
        Outside(c) -> { pool: d.pool, claim: CopyOutsideTransaction(c) },
        Returned(Failed(e)) -> { pool: d.pool, claim: CopyRejected(e) },
        _ -> { pool: d.pool, claim: CopyRejected(pool_busy(size)) },
      }
    },
    Own(scope) -> if scope.copying { { pool: p, claim: CopyRejected(copy_in_use()) } } else {
      match scope.session {
        None -> { pool: p, claim: CopyRejected(connection_lost()) },
        Some(session) ->
          {
            pool: {
              ..p,
              open: p.open.map(|s: Scope| if s.n == scope.n { { ..s, copying: true } } else { s }),
            },
            claim: CopyWithin(scope, session),
          },
      }
    },
  }

type CopyStart = {
  n: Int,
  in_transaction: Bool,
  session: Option<pg::Session>,
  columns: List<pg::Column>,
  failed: Option<DbError>,
}

fn begin_copy(
  config: Server,
  nonce: String,
  claim: CopyClaim,
  sql: String,
  out: Option<String>,
) -> CopyStart / {net.connect[link], net.start_tls[link], net.peer_certificate[link], net.send[link], net.send_secret[link], net.recv[link], net.close[link], abort.raise, diverges} =
  match claim {
    CopyRejected(e) ->
      { n: 0 - 1, in_transaction: false, session: None, columns: [], failed: Some(e) },
    CopyOutsideTransaction(c) -> match open_connection(config, nonce, c) {
      Err(e) ->
        { n: claim_n(c), in_transaction: false, session: None, columns: [], failed: Some(e) },
      Ok(l) -> copy_on(config, l.n, false, l.session, sql, out),
    },
    CopyWithin(scope, session) -> copy_on(config, scope.n, true, session, sql, out),
  }

fn copy_on(
  config: Server,
  n: Int,
  within: Bool,
  session: pg::Session,
  sql: String,
  out: Option<String>,
) -> CopyStart / {net.send[link], net.recv[link], net.close[link], abort.raise, diverges} =
  match out {
    None -> match pg::copy_in_begin[link](session, sql, config.client) {
      Ok(c) ->
        { n: n, in_transaction: within, session: Some(c.session), columns: [], failed: None },
      Err(e) -> copy_rejected(config, n, within, session, e),
    },
    Some(query) -> match pg::describe_statement[link](session, query, config.client) {
      Err(e) -> copy_rejected(config, n, within, session, e),
      Ok(r) -> match pg::copy_out_begin[link](r.session, sql, config.client) {
        Ok(c) ->
          {
            n: n,
            in_transaction: within,
            session: Some(c.session),
            columns: r.result.columns,
            failed: None,
          },
        Err(e) -> copy_rejected(config, n, within, r.session, e),
      },
    },
  }

fn copy_rejected(
  config: Server,
  n: Int,
  within: Bool,
  session: pg::Session,
  e: pg::ClientError,
) -> CopyStart / {net.send[link], net.close[link], abort.raise} =
  match e {
    pg::Rejected(after, server) ->
      {
        n: n,
        in_transaction: within,
        session: Some(after),
        columns: [],
        failed: Some(server_error(server)),
      },
    _ -> {
      pg::finish[link](session, config.client);
      { n: n, in_transaction: within, session: None, columns: [], failed: Some(client_error(e)) }
    },
  }

fn release_copy_connection(p: Pool, n: Int, within: Bool, session: Option<pg::Session>) -> Pool = {
  let counted = match session { Some(_) -> p, None -> { ..p, opened: p.opened - 1 } };
  if within {
    {
      ..counted,
      open: counted.open.map(|s: Scope|
        if s.n == n { { ..s, copying: false, session: session } } else { s }),
    }
  } else {
    match session {
      Some(talking) -> { ..counted, idle: counted.idle.push({ n: n, session: talking }) },
      None -> counted,
    }
  }
}

fn copy_of(p: Pool, id: Int) -> Option<Copy> = p.copied_fields.find(|c: Copy| c.id == id)

fn with_copy(p: Pool, c: Copy) -> Pool =
  {
    ..p,
    copied_fields: p.copied_fields.map(|existing: Copy|
      if existing.id == c.id { c } else { existing }),
  }

fn without_copy(p: Pool, id: Int) -> Pool =
  { ..p, copied_fields: p.copied_fields.filter(|existing: Copy| existing.id != id) }

fn unknown_copy(id: Int) -> DbError =
  db_error("55000", "", "no copy is open under the number " ++ id.to_string())

fn copy_busy(id: Int) -> DbError =
  db_error("55000", "", "copy " ++ id.to_string() ++ " is already in use by another operation")

fn wrong_copy_direction(id: Int, out: Bool) -> DbError =
  db_error(
    "55000",
    "",
    "copy " ++ id.to_string() ++ " is a copy " ++ (if out { "out" } else { "in" })
      ++ ", and this operation is the other way",
  )

type CopyConnection = { pool: Pool, copy: Copy, session: pg::Session }

fn take_copy_connection(p: Pool, id: Int, out: Bool) -> Result<CopyConnection, DbError> =
  match copy_of(p, id) {
    None -> Err(unknown_copy(id)),
    Some(c) -> if c.out != out { Err(wrong_copy_direction(id, c.out)) } else {
      match c.session {
        None -> Err(copy_busy(id)),
        Some(session) ->
          Ok({ pool: with_copy(p, { ..c, session: None }), copy: c, session: session }),
      }
    },
  }

fn copy_text(rows: List<List<Param>>) -> Bytes / {abort.raise} =
  Bytes::concat_all(rows.map(|row: List<Param>| pg::copy_row(row.map(param_text))))

type Lines = { lines: List<Bytes>, rest: Bytes }

fn first_lines(data: Bytes, most: Int) -> Lines / {abort.raise} = {
  let split = range(0, max(most, 0)).fold(
    { lines: [], rest: data, open: true },
    |accumulator: { lines: List<Bytes>, rest: Bytes, open: Bool }, i: Int|
      if !accumulator.open { accumulator } else {
        match accumulator.rest.index_of_byte(10) {
          None -> { ..accumulator, open: false },
          Some(at) ->
            {
              lines: accumulator.lines.push(accumulator.rest.slice(0, at)),
              rest: accumulator.rest.slice(at + 1, accumulator.rest.len()),
              open: true,
            },
        }
      },
  );
  { lines: split.lines, rest: split.rest }
}

fn copied_rows(
  columns: List<pg::Column>,
  lines: List<Bytes>,
) -> Result<List<Row>, DbError> / {abort.raise} =
  lines.fold(Ok([]), |accumulator: Result<List<Row>, DbError>, line: Bytes|
    match accumulator {
      Err(e) -> Err(e),
      Ok(rows) -> match pg::copy_fields(line) {
        None ->
          Err(db_error("08P01", "", "a row of the copy cannot be parsed: it ends in a backslash")),
        Some(values) -> Ok(rows.push(row_of(columns, values, 0, Map::new()))),
      },
    })

type TakeResult = {
  copy: Copy,
  connection_on_finish: Option<Option<pg::Session>>,
  result: Result<List<Row>, DbError>,
}

fn take_rows(
  config: Server,
  c: Copy,
  session: Option<pg::Session>,
  rows: Int,
) -> TakeResult / {net.send[link], net.recv[link], net.close[link], abort.raise, diverges} = {
  let ready = first_lines(c.pending, rows);
  let returned = |copy: Copy, release: Option<Option<pg::Session>>, lines: Lines|
    match copied_rows(copy.columns, lines.lines) {
      Ok(found) ->
        {
          copy: { ..copy, pending: lines.rest, rows_taken: copy.rows_taken + found.len() },
          connection_on_finish: release,
          result: Ok(found),
        },
      Err(e) ->
        { copy: { ..copy, failed: Some(e) }, connection_on_finish: release, result: Err(e) },
    };
  match session {
    None -> returned(c, None, ready),
    Some(s) -> if ready.lines.len() >= rows { returned({ ..c, session: Some(s) }, None, ready) }
    else {
      match pg::copy_out_take[link](s, config.client) {
        Ok(piece) -> match piece.data {
          Some(data) ->
            take_rows(config, { ..c, pending: c.pending.concat(data) }, Some(piece.session), rows),
          None ->
            returned(
              { ..c, session: None, done: true },
              Some(Some(piece.session)),
              first_lines(c.pending, rows),
            ),
        },
        Err(pg::Rejected(after, server)) -> {
          let failed = server_error(server);
          {
            copy: { ..c, session: None, done: true, failed: Some(failed) },
            connection_on_finish: Some(Some(after)),
            result: Err(failed),
          }
        },
        Err(e) -> {
          pg::finish[link](s, config.client);
          let failed = client_error(e);
          {
            copy: { ..c, session: None, done: true, failed: Some(failed) },
            connection_on_finish: Some(None),
            result: Err(failed),
          }
        },
      }
    },
  }
}

fn drain_copy_out(
  config: Server,
  s: pg::Session,
) -> Result<pg::Session, pg::ClientError> / {net.recv[link], abort.raise, diverges} =
  match pg::copy_out_take[link](s, config.client) {
    Err(e) -> Err(e),
    Ok(piece) -> match piece.data {
      None -> Ok(piece.session),
      Some(_) -> drain_copy_out(config, piece.session),
    },
  }

type CopyEnd = { session: Option<pg::Session>, result: Result<Int, DbError> }

fn end_copy_in(
  config: Server,
  session: pg::Session,
  failure: Option<String>,
) -> CopyEnd / {net.send[link], net.recv[link], net.close[link], abort.raise, diverges} =
  match pg::copy_in_end[link]({ session: session, columns: 0 }, failure, config.client) {
    Ok(r) -> { session: Some(r.session), result: Ok(count_of(r.result.tag)) },
    Err(pg::Rejected(after, server)) -> { session: Some(after), result: Err(server_error(server)) },
    Err(e) -> {
      pg::finish[link](session, config.client);
      { session: None, result: Err(client_error(e)) }
    },
  }

fn end_copy_out(
  config: Server,
  c: Copy,
  session: pg::Session,
) -> CopyEnd / {net.send[link], net.recv[link], net.close[link], abort.raise, diverges} =
  match drain_copy_out(config, session) {
    Ok(s) -> { session: Some(s), result: Ok(c.rows_taken) },
    Err(pg::Rejected(after, server)) -> { session: Some(after), result: Err(server_error(server)) },
    Err(e) -> {
      pg::finish[link](session, config.client);
      { session: None, result: Err(client_error(e)) }
    },
  }

fn copy_in_sql(t: String, columns: List<String>) -> String =
  "copy " ++ quote_identifier(t) ++ " (" ++ comma(columns.map(quote_identifier)) ++ ") from stdin"

fn connect_listener(
  config: Server,
  nonce: String,
  made: Int,
  channels: List<String>,
) -> Result<pg::Session, DbError> / {net.connect[link], net.start_tls[link], net.peer_certificate[link], net.send[link], net.send_secret[link], net.recv[link], net.close[link], abort.raise, diverges} =
  match pg::connect[link](
      config.host,
      config.port,
      tls_of(config),
      config.user,
      config.database,
      startup_parameters(config),
      config.password,
      nonce ++ "-listener-" ++ made.to_string(),
      config.client,
    ) {
    Err(e) -> Err(client_error(e)),
    Ok(s) ->
      channels.fold(Ok(s), |accumulator: Result<pg::Session, DbError>, channel: String|
        match accumulator {
          Err(e) -> Err(e),
          Ok(talking) -> match control(talking, "listen " ++ quote_identifier(channel), config) {
            Ok(r) -> Ok(r.session),
            Err(e) -> {
              pg::finish[link](talking, config.client);
              Err(client_error(e))
            },
          },
        }),
  }

type WaitResult = { listener: Listener, notification: Notice }

type ListenResult = { listener: Listener, result: QueryResult }

fn listen_on(
  config: Server,
  nonce: String,
  l: Listener,
  channel: String,
) -> ListenResult / {net.connect[link], net.start_tls[link], net.peer_certificate[link], net.send[link], net.send_secret[link], net.recv[link], net.close[link], abort.raise, diverges} =
  match l.session {
    None -> match connect_listener(config, nonce, l.connections_opened, l.channels.push(channel)) {
      Err(e) ->
        { listener: { ..l, connections_opened: l.connections_opened + 1 }, result: Failed(e) },
      Ok(s) ->
        {
          listener: {
            ..l,
            session: Some(s),
            channels: l.channels.push(channel),
            connections_opened: l.connections_opened + 1,
          },
          result: Count(0),
        },
    },
    Some(s) -> match control(s, "listen " ++ quote_identifier(channel), config) {
      Ok(r) ->
        {
          listener: { ..l, session: Some(r.session), channels: l.channels.push(channel) },
          result: Count(0),
        },
      Err(pg::Rejected(after, server)) ->
        { listener: { ..l, session: Some(after) }, result: Failed(server_error(server)) },
      Err(e) -> {
        pg::finish[link](s, config.client);
        { listener: { ..l, session: None, lost: true }, result: Failed(client_error(e)) }
      },
    },
  }

fn unlisten_on(
  config: Server,
  l: Listener,
  channel: String,
) -> ListenResult / {net.send[link], net.recv[link], net.close[link], abort.raise, diverges} = {
  let rest = l.channels.filter(|c: String| c != channel);
  match l.session {
    None -> { listener: { ..l, channels: rest }, result: Count(0) },
    Some(s) -> match control(s, "unlisten " ++ quote_identifier(channel), config) {
      Ok(r) -> { listener: { ..l, session: Some(r.session), channels: rest }, result: Count(0) },
      Err(pg::Rejected(after, server)) ->
        { listener: { ..l, session: Some(after) }, result: Failed(server_error(server)) },
      Err(e) -> {
        pg::finish[link](s, config.client);
        { listener: { ..l, session: None, channels: rest, lost: true }, result: Count(0) }
      },
    },
  }
}

fn wait_for_notification(
  config: Server,
  nonce: String,
  l: Listener,
  timeout_ms: Int,
) -> WaitResult / {net.connect[link], net.start_tls[link], net.peer_certificate[link], net.send[link], net.send_secret[link], net.recv[link], net.close[link], abort.raise, diverges} =
  match l.session {
    None -> reopen_listener(config, nonce, l),
    Some(s) -> match pg::await_notification[link](s, timeout_ms) {
      Ok(w) ->
        {
          listener: { ..l, session: Some(w.session) },
          notification: match w.notification { Some(n) -> Notified(n), None -> Quiet },
        },
      Err(_) -> {
        pg::finish[link](s, config.client);
        reopen_listener(config, nonce, { ..l, session: None, lost: true })
      },
    },
  }

fn reopen_listener(
  config: Server,
  nonce: String,
  l: Listener,
) -> WaitResult / {net.connect[link], net.start_tls[link], net.peer_certificate[link], net.send[link], net.send_secret[link], net.recv[link], net.close[link], abort.raise, diverges} =
  match connect_listener(config, nonce, l.connections_opened, l.channels) {
    Ok(s) ->
      {
        listener: {
          ..l,
          session: Some(s),
          lost: false,
          connections_opened: l.connections_opened + 1,
        },
        notification: Reconnected,
      },
    Err(e) ->
      {
        listener: { ..l, lost: true, connections_opened: l.connections_opened + 1 },
        notification: ListenFailed(e),
      },
  }

fn listener_busy() -> String =
  "the listener was used while another operation on it, such as waiting for a notification, was still running. Only one task can use a listener at a time"

/// Runs `body` with the `db` effect handled by a live server. The caller supplies `nonce`, so a
/// test can fix it and a program can derive it from the random seed of its run. Each connection's
/// nonce is `nonce` followed by a number unique to that connection.
pub fn serve<a | e>(
  config: Server,
  size: Int,
  nonce: String,
  body: () -> a / {db.read[*], db.write[*] | e},
) -> a / {diverges, abort.raise, net.connect[link], net.start_tls[link], net.peer_certificate[link], net.send[link], net.send_secret[link], net.recv[link], net.close[link] | e} =
  handle {
    let taken = |d: Decision| {
      pool_state.replace(d.pool);
      d.plan
    };
    let resolved = |left: OperationResult| {
      pool_state.replace(apply_result(pool_state.current(), left));
      left.result
    };
    let statement = |s: Statement, ps: List<Param>, rows: Bool, what: String|
      match taken(for_statement(pool_state.current(), size, what)) {
        Returned(a) -> a,
        Outside(c) -> resolved(statement_outside(config, nonce, c, s, ps, rows)),
        Within(scope, session) -> resolved(statement_within(config, scope, session, s, ps, rows)),
      };
    let closing = |d: ToClose| {
      pool_state.replace(d.pool);
      d.closing
    };
    let alone = |s: Statement, each: List<List<Param>>|
      each.map(|ps: List<Param>| statement(s, ps, true, "`db.batch`"));
    let shared = |s: Statement, each: List<List<Param>>|
      match combine_batch(s, each) {
        None -> None,
        Some(c) -> match statement(c.s, c.ps, true, "`db.batch`") {
          Rows(rows) -> Some(split_query_results(rows, each.len())),
          _ -> None,
        },
      };
    let ended_savepoint = |updated_scope: Bool|
      match closing(prepare_transaction_close(pool_state.current(), "`db.batch`", Count(0))) {
        Resolved(_) -> (),
        Closes(scope, session) -> {
          resolved(if updated_scope { commit_scope(config, scope, session) }
          else { abort_scope(config, scope, session) });
          ()
        },
      };
    let batch = |s: Statement, each: List<List<Param>>|
      if each.len() < 2 { alone(s, each) } else {
        match route(pool_state.current().open) {
          Own(scope) -> match taken(
              for_begin(pool_state.current(), size, scope.level, scope.access),
            ) {
            Within(inner, session) -> match resolved(open_savepoint(config, inner, session)) {
              Failed(_) -> alone(s, each),
              _ -> match shared(s, each) {
                Some(results) -> {
                  ended_savepoint(true);
                  results
                },
                None -> {
                  ended_savepoint(false);
                  alone(s, each)
                },
              },
            },
            _ -> alone(s, each),
          },
          _ -> match shared(s, each) { Some(results) -> results, None -> alone(s, each) },
        }
      };
    let copy_begin = |sql: String, out: Option<String>, what: String| {
      let claimed = for_copy(pool_state.current(), size, what);
      pool_state.replace(claimed.pool);
      match claimed.claim {
        CopyRejected(e) -> Err(e),
        claim -> {
          let b = begin_copy(config, nonce, claim, sql, out);
          match b.failed {
            Some(e) -> {
              pool_state.replace(
                release_copy_connection(pool_state.current(), b.n, b.in_transaction, b.session),
              );
              Err(e)
            },
            None -> {
              let p = pool_state.current();
              pool_state.replace({
                ..p,
                copied_fields: p.copied_fields.push({
                  id: p.copied,
                  n: b.n,
                  session: b.session,
                  in_transaction: b.in_transaction,
                  out: out != None,
                  columns: b.columns,
                  pending: b"",
                  done: false,
                  rows_taken: 0,
                  failed: None,
                }),
                copied: p.copied + 1,
              });
              Ok(p.copied)
            },
          }
        },
      }
    };
    let copy_closed = |c: Copy, e: CopyEnd| {
      pool_state.replace(
        release_copy_connection(
          without_copy(pool_state.current(), c.id),
          c.n,
          c.in_transaction,
          e.session,
        ),
      );
      e.result
    };
    let copy_end = |id: Int, failure: Option<String>|
      match copy_of(pool_state.current(), id) {
        None -> Err(unknown_copy(id)),
        Some(c) -> if c.out && c.done {
          pool_state.replace(without_copy(pool_state.current(), id));
          match c.failed { Some(e) -> Err(e), None -> Ok(c.rows_taken) }
        } else {
          match take_copy_connection(pool_state.current(), id, c.out) {
            Err(e) -> Err(e),
            Ok(t) -> {
              pool_state.replace(t.pool);
              copy_closed(c, if c.out { end_copy_out(config, c, t.session) }
              else { end_copy_in(config, t.session, failure) })
            },
          }
        },
      };
    let taken_from = |c: Copy, session: Option<pg::Session>, rows: Int| {
      let t = take_rows(config, c, session, rows);
      let updated_scope = with_copy(pool_state.current(), t.copy);
      pool_state.replace(match t.connection_on_finish {
        None -> updated_scope,
        Some(left) -> release_copy_connection(updated_scope, c.n, c.in_transaction, left),
      });
      t.result
    };
    let copy_take = |id: Int, rows: Int|
      match copy_of(pool_state.current(), id) {
        None -> Err(unknown_copy(id)),
        Some(c) -> if !c.out { Err(wrong_copy_direction(id, false)) }
        else if c.done { taken_from(c, None, rows) } else {
          match take_copy_connection(pool_state.current(), id, true) {
            Err(e) -> Err(e),
            Ok(t) -> {
              pool_state.replace(t.pool);
              taken_from(c, Some(t.session), rows)
            },
          }
        },
      };
    let listener_taken = || {
      let p = pool_state.current();
      if p.listener.waiting { panic(listener_busy()) } else {
        pool_state.replace({ ..p, listener: { ..p.listener, waiting: true } });
        p.listener
      }
    };
    let listener_back = |l: Listener| {
      pool_state.replace({ ..pool_state.current(), listener: { ..l, waiting: false } });
      ()
    };
    let result = handle {
      body()
    } with {
      db.query[*t](s, ps) -> {
        check_statement(s, Reads, t, "`db.query`");
        statement(s, ps, true, "`db.query`")
      },
      db.batch[*t](s, each) -> {
        check_statement(s, Reads, t, "`db.batch`");
        batch(s, each)
      },
      db.execute[*t](s, ps) -> {
        check_statement(s, Writes, t, "`db.execute`");
        statement(s, ps, false, "`db.execute`")
      },
      db.returning[*t](s, ps) -> {
        check_statement(s, WritesRows, t, "`db.returning`");
        statement(s, ps, true, "`db.returning`")
      },
      db.begin(level, access) -> match taken(for_begin(pool_state.current(), size, level, access)) {
        Returned(a) -> a,
        Outside(c) -> resolved(open_transaction(config, nonce, c, level, access)),
        Within(scope, session) -> resolved(open_savepoint(config, scope, session)),
      },
      db.commit() -> match closing(
          prepare_transaction_close(pool_state.current(), "`db.commit`", Failed(connection_lost())),
        ) {
        Resolved(a) -> a,
        Closes(scope, session) -> resolved(commit_scope(config, scope, session)),
      },
      db.abort() -> match closing(
          prepare_transaction_close(pool_state.current(), "`db.abort`", Count(0)),
        ) {
        Resolved(a) -> a,
        Closes(scope, session) -> resolved(abort_scope(config, scope, session)),
      },
      db.notify[*c](payload) ->
        statement(
          notify_statement(),
          [TextParameter(c), TextParameter(payload)],
          false,
          "`db.notify`",
        ),
      db.listen[*c]() -> {
        let l = listener_taken();
        if l.channels.contains(c) {
          listener_back(l);
          Count(0)
        } else {
          let s = listen_on(config, nonce, l, c);
          listener_back(s.listener);
          s.result
        }
      },
      db.unlisten[*c]() -> {
        let s = unlisten_on(config, listener_taken(), c);
        listener_back(s.listener);
        s.result
      },
      db.next_notification(timeout_ms) -> {
        if pool_state.current().listener.channels.len() == 0 { panic(nothing_listened()) }
        else { () };
        let w = wait_for_notification(config, nonce, listener_taken(), timeout_ms);
        listener_back(w.listener);
        w.notification
      },
      db.copy_in[*t](columns) -> copy_begin(copy_in_sql(t, columns), None, "`db.copy_in`"),
      db.copy_rows[*t](id, rows) -> match take_copy_connection(pool_state.current(), id, false) {
        Err(e) -> Err(e),
        Ok(took_rows) -> {
          pool_state.replace(took_rows.pool);
          match pg::copy_send[link](
              { session: took_rows.session, columns: 0 },
              copy_text(rows),
              config.client,
            ) {
            Ok(c) -> {
              pool_state.replace(
                with_copy(pool_state.current(), { ..took_rows.copy, session: Some(c.session) }),
              );
              Ok(())
            },
            Err(e) -> {
              pg::finish[link](took_rows.session, config.client);
              copy_closed(took_rows.copy, { session: None, result: Err(client_error(e)) });
              Err(client_error(e))
            },
          }
        },
      },
      db.copy_end[*t](id, failure) -> copy_end(id, failure),
      db.copy_out[*t](s) -> {
        check_statement(s, Reads, t, "`db.copy_out`");
        let body = statement_text(s.sql);
        copy_begin("copy (" ++ body ++ ") to stdout", Some(body), "`db.copy_out`")
      },
      db.copy_take[*t](id, rows) -> copy_take(id, rows),
    };
    close_pool(pool_state.current(), config);
    result
  } with {
    var pool: Pool = {
      idle: [],
      opened: 0,
      made: 0,
      open: [],
      copied_fields: [],
      copied: 0,
      listener: { session: None, channels: [], waiting: false, lost: false, connections_opened: 0 },
    },
    pool_state.current() -> pool,
    pool_state.replace(next) -> {
      pool = next;
    },
  }

effect pool_state {
  read current() -> Pool
  write replace(next: Pool) -> Unit
}

fn notify_statement() -> Statement = statement_of("select pg_notify($1, $2)")

fn statement_text(sql: String) -> String / {abort.raise} =
  match tokenize(Postgres, sql) {
    Err(_) -> sql,
    Ok(ts) -> match statement_body(sql, ts) { Some(body) -> body, None -> sql },
  }

fn combine_batch(
  s: Statement,
  each: List<List<Param>>,
) -> Option<{ s: Statement, ps: List<Param> }> / {abort.raise} =
  match tokenize(Postgres, s.sql) {
    Err(_) -> None,
    Ok(ts) -> match statement_body(s.sql, ts) {
      None -> None,
      Some(body) -> {
        let places = ts.filter(|t: SqlTokenAt|
          match t.token { SqlPlaceholder -> true, _ -> false });
        let width = places.fold(0, |m: Int, t: SqlTokenAt| max(m, placeholder_number(t.text)));
        let fits = each.fold(true, |ok: Bool, ps: List<Param>| ok && ps.len() == width);
        if !fits || width * each.len() > 65535 { None } else {
          let arms = range(0, each.len()).map(|i: Int|
            "select " ++ i.to_string()
              ++ " as \"ply.ask\", row_number() over () as \"ply.row\", \"ply.arm\".* from ("
              ++ renumber_placeholders(body, places, i * width)
              ++ ") as \"ply.arm\"");
          Some({
            s: statement_of(
              "select * from (" ++ String::join(arms, " union all ")
                ++ ") as \"ply.batch\" order by \"ply.ask\", \"ply.row\"",
            ),
            ps: each.fold([], |accumulator: List<Param>, ps: List<Param>|
              ps.fold(accumulator, List::push)),
          })
        }
      },
    },
  }

fn statement_body(sql: String, ts: List<SqlTokenAt>) -> Option<String> / {abort.raise} = {
  let semis = range(0, ts.len()).filter(|i: Int|
    match ts.at(i) { Some(t) -> sql_is_semicolon(t.token), None -> false });
  match semis {
    [] -> Some(sql),
    [i] -> if i == ts.len() - 1 {
      match ts.at(i) {
        Some(t) -> Some(String::of_bytes(Bytes::of_string(sql).slice(0, t.at))),
        None -> None,
      }
    } else { None },
    _ -> None,
  }
}

fn placeholder_number(text: String) -> Int / {abort.raise} = int_or_zero(text.slice(1, text.len()))

fn renumber_placeholders(
  body: String,
  places: List<SqlTokenAt>,
  by: Int,
) -> String / {abort.raise} = {
  let b = Bytes::of_string(body);
  let walked = places.fold(
    { at: 0, out: b"" },
    |accumulator: { at: Int, out: Bytes }, t: SqlTokenAt|
      if t.at < accumulator.at || t.at >= b.len() { accumulator } else {
        {
          at: t.at + Bytes::of_string(t.text).len(),
          out: Bytes::concat_all([
            accumulator.out,
            b.slice(accumulator.at, t.at),
            Bytes::of_string("$" ++ Int::to_string(placeholder_number(t.text) + by)),
          ]),
        }
      },
  );
  String::of_bytes(walked.out.concat(b.slice(walked.at, b.len())))
}

fn split_query_results(rows: List<Row>, query_count: Int) -> List<QueryResult> = {
  let rows_by_query = rows.fold(Map::new(), |accumulator: Map<Int, List<Row>>, row: Row|
    match row.get("ply.ask") {
      Some(IntDatum(i)) ->
        accumulator.insert(
          i,
          List::push(
            match accumulator.get(i) { Some(xs) -> xs, None -> [] },
            row.remove("ply.ask").remove("ply.row"),
          ),
        ),
      _ -> accumulator,
    });
  range(0, query_count).map(|i: Int|
    Rows(match rows_by_query.get(i) { Some(xs) -> xs, None -> [] }))
}

fn close_pool(p: Pool, config: Server) -> Unit / {net.send[link], net.close[link], abort.raise} = {
  let close = |s: Option<pg::Session>|
    match s { Some(session) -> pg::finish[link](session, config.client), None -> () };
  p.idle.fold((), |done: Unit, l: PooledConnection| pg::finish[link](l.session, config.client));
  p.open.fold((), |done: Unit, scope: Scope| close(scope.session));
  p.copied_fields.filter(|c: Copy| !c.in_transaction).fold((), |done: Unit, c: Copy|
    close(c.session));
  close(p.listener.session)
}

type Split = { head: String, tail: String }

fn split_at(text: String, sep: String) -> Option<Split> / {abort.raise} =
  match Bytes::of_string(text).index_of(Bytes::of_string(sep)) {
    None -> None,
    Some(i) -> {
      let whole = Bytes::of_string(text);
      let after = i + Bytes::of_string(sep).len();
      Some({
        head: String::of_bytes(whole.slice(0, i)),
        tail: String::of_bytes(whole.slice(after, whole.len())),
      })
    },
  }

fn rsplit_at(text: String, sep: String) -> Option<Split> / {abort.raise} = {
  let whole = Bytes::of_string(text);
  let needle = Bytes::of_string(sep);
  let last = range(0, whole.len()).fold(0 - 1, |accumulator: Int, i: Int|
    if i + needle.len() <= whole.len() && whole.slice(i, i + needle.len()) == needle { i }
    else { accumulator });
  if last < 0 { None } else {
    Some({
      head: String::of_bytes(whole.slice(0, last)),
      tail: String::of_bytes(whole.slice(last + needle.len(), whole.len())),
    })
  }
}

fn unpercent(text: String) -> Result<String, String> / {abort.raise} =
  match unpercent_from(Bytes::of_string(text), 0, b"") {
    Err(reason) -> Err(reason),
    Ok(bytes) -> if bytes.is_utf8() { Ok(String::of_bytes(bytes)) }
    else { Err("a `%` escape in the URL is not UTF-8") },
  }

fn unpercent_from(
  whole: Bytes,
  at: Int,
  accumulator: Bytes,
) -> Result<Bytes, String> / {abort.raise} =
  if at >= whole.len() { Ok(accumulator) } else if whole.at(at) == 37 {
    if at + 2 >= whole.len() || !is_hex(whole.at(at + 1)) || !is_hex(whole.at(at + 2)) {
      Err("a `%` in the URL is not followed by two hex digits")
    } else {
      unpercent_from(
        whole,
        at + 3,
        accumulator.concat(
          byte_of_int(hex_value(whole.at(at + 1)) * 16 + hex_value(whole.at(at + 2))),
        ),
      )
    }
  } else { unpercent_from(whole, at + 1, accumulator.concat(whole.slice(at, at + 1))) }

fn is_hex(c: Int) -> Bool = (c >= 48 && c <= 57) || (c >= 97 && c <= 102) || (c >= 65 && c <= 70)

fn url_error_message(url: String) -> String =
  if url.contains("=") && !url.contains("://") {
    "this is libpq's keyword/value form; the URI form is `postgres://user@host:5432/database`"
  } else { "a connection string begins `postgres://`, as in `postgres://user@host:5432/database`" }

/// Parses `postgres://user[:password]@host[:port]/database` into a `Server`. The query may set
/// `statement_timeout`, `idle_in_transaction_session_timeout` (whole milliseconds, `0` for none, at
/// most 2147483647), `application_name`, `sslmode` and `sslnegotiation`. Any other key, or a key
/// given twice, is rejected.
///
/// Without `sslmode`, connections are plaintext, as with `sslmode=disable`. `require`, `verify-ca`
/// and `verify-full` all encrypt every connection and verify the server as `verify-full` does
/// (`Ssl` explains why). `allow` and `prefer` are rejected: each falls back to plaintext when the
/// server says it does not support TLS, and anyone between the client and the server can send that
/// message.
///
/// `sslnegotiation=direct` starts TLS without first asking the server, which servers older than
/// Postgres 17 do not understand, and it requires an `sslmode` that encrypts. The default,
/// `postgres`, asks first.
///
/// The password is turned into a secret before the rest of the string is parsed. The bytes after
/// the `:` in the userinfo, up to the last `@` before the host, are percent-decoded directly into a
/// secret. The rest of the parsing then sees the string with those bytes removed. No parsing step
/// has the password as an ordinary string.
pub fn server_of(url: String) -> Result<Server, String> / {abort.raise} =
  match extract_password(url) {
    Err(reason) -> Err(reason),
    Ok(unsealed) -> match split_at(unsealed.url, "://") {
      None -> Err(url_error_message(unsealed.url)),
      Some(scheme) -> if scheme.head != "postgres" && scheme.head != "postgresql" {
        Err(
          "`" ++ scheme.head
            ++ "` is not a supported database scheme; use `postgres://` or `postgresql://`",
        )
      } else { server_parts(scheme.tail, unsealed.password) },
    },
  }

type ExtractedPassword = { url: String, password: Option<Secret<Bytes>> }

fn extract_password(url: String) -> Result<ExtractedPassword, String> / {abort.raise} = {
  let b = Bytes::of_string(url);
  let start = match b.index_of(b"://") { Some(i) -> i + 3, None -> 0 };
  let end = match b.index_of_from(b"/", start) { Some(i) -> i, None -> b.len() };
  let at = range(start, end).fold(0 - 1, |found: Int, i: Int|
    if b.at(i) == 64 { i } else { found });
  let colon = match b.index_of_from(b":", start) { Some(i) -> i, None -> end };
  if at < 0 || colon >= at { Ok({ url: url, password: None }) } else {
    match percent_decode_secret(b, colon + 1, at, Secret::of_bytes(b""), at - colon + 1) {
      Err(reason) -> Err(reason),
      Ok(password) ->
        Ok({
          url: String::of_bytes(b.slice(0, colon).concat(b.slice(at, b.len()))),
          password: if password.is_empty() { None } else { Some(password) },
        }),
    }
  }
}

fn percent_decode_secret(
  b: Bytes,
  at: Int,
  end: Int,
  accumulator: Secret<Bytes>,
  left: Int,
) -> Result<Secret<Bytes>, String> / {abort.raise} =
  if at >= end || left <= 0 { Ok(accumulator) } else if b.at(at) == 37 {
    if at + 2 >= end || !is_hex(b.at(at + 1)) || !is_hex(b.at(at + 2)) {
      Err("a `%` in the URL is not followed by two hex digits")
    } else {
      percent_decode_secret(
        b,
        at + 3,
        end,
        accumulator.concat(
          Secret::of_bytes(byte_of_int(hex_value(b.at(at + 1)) * 16 + hex_value(b.at(at + 2)))),
        ),
        left - 1,
      )
    }
  } else {
    let run = match b.index_of_from(b"%", at) { Some(i) -> min(i, end), None -> end };
    percent_decode_secret(
      b,
      run,
      end,
      accumulator.concat(Secret::of_bytes(b.slice(at, run))),
      left - 1,
    )
  }

fn user_of(userinfo: String) -> Result<String, String> / {abort.raise} =
  match unpercent(userinfo) {
    Err(reason) -> Err(reason),
    Ok(user) -> if user.len() == 0 { Err("the user is empty") } else { Ok(user) },
  }

type HostPort = { host: String, port: Int }

fn hostport_of(text: String) -> Result<HostPort, String> / {abort.raise} =
  match rsplit_at(text, ":") {
    None -> checked_host(text, 5432),
    Some(s) -> match natural_of(s.tail) {
      None -> Err("`" ++ s.tail ++ "` is not a port"),
      Some(port) -> if port == 0 { Err("port 0 is not a port a server listens on") }
      else { checked_host(s.head, port) },
    },
  }

fn natural_of(text: String) -> Option<Int> / {abort.raise} =
  match text.int_of_string() {
    Some(n) -> if n >= 0 && n.to_string() == text { Some(n) } else { None },
    None -> None,
  }

fn checked_host(host: String, port: Int) -> Result<HostPort, String> =
  if host.len() == 0 { Err("there is no host; a unix socket path is not configurable here") }
  else { Ok({ host: host, port: port }) }

type Database = { name: String, query: String }

fn database_of(path_and_query: String) -> Result<Database, String> / {abort.raise} = {
  let split = match split_at(path_and_query, "?") {
    Some(s) -> s,
    None -> { head: path_and_query, tail: "" },
  };
  match unpercent(split.head) {
    Err(reason) -> Err(reason),
    Ok(name) -> if name.len() == 0 { Err("there is no database name after the host") }
    else { Ok({ name: name, query: split.tail }) },
  }
}

fn server_parts(
  rest: String,
  password: Option<Secret<Bytes>>,
) -> Result<Server, String> / {abort.raise} = {
  let split = match split_at(rest, "/") { Some(s) -> s, None -> { head: rest, tail: "" } };
  match rsplit_at(split.head, "@") {
    None ->
      Err(
        "there is no `user@` before the host; a run whose database user comes from the environment is a run whose identity depends on who invoked it",
      ),
    Some(who) -> match user_of(who.head) {
      Err(reason) -> Err(reason),
      Ok(user) -> match hostport_of(who.tail) {
        Err(reason) -> Err(reason),
        Ok(hp) -> match database_of(split.tail) {
          Err(reason) -> Err(reason),
          Ok(database) ->
            with_query(database.query, server(hp.host, hp.port, user, database.name, password)),
        },
      },
    },
  }
}

type QuerySettings = { server: Server, mode: Option<String>, negotiation: Option<String> }

fn with_query(query: String, s: Server) -> Result<Server, String> / {abort.raise} =
  if query.len() == 0 { Ok(s) } else {
    let read = query.split("&").fold(
      Ok({ server: s, mode: None, negotiation: None }),
      |accumulator: Result<QuerySettings, String>, pair: String|
        match accumulator {
          Err(reason) -> Err(reason),
          Ok(so_far) -> match split_at(pair, "=") {
            None -> Err("`" ++ pair ++ "` is not a `key=value` parameter"),
            Some(key_value) -> match unpercent(key_value.tail) {
              Err(reason) -> Err(reason),
              Ok(value) -> with_parameter(so_far, key_value.head, value),
            },
          },
        },
    );
    match read {
      Err(reason) -> Err(reason),
      Ok(r) -> match ssl_of(r.mode, r.negotiation) {
        Err(reason) -> Err(reason),
        Ok(ssl) -> Ok({ ..r.server, ssl: ssl }),
      },
    }
  }

fn with_parameter(
  r: QuerySettings,
  key: String,
  value: String,
) -> Result<QuerySettings, String> / {abort.raise} =
  if key == "sslmode" {
    match r.mode {
      Some(_) -> Err("`sslmode` is given twice"),
      None -> Ok({ ..r, mode: Some(value) }),
    }
  } else if key == "sslnegotiation" {
    match r.negotiation {
      Some(_) -> Err("`sslnegotiation` is given twice"),
      None -> Ok({ ..r, negotiation: Some(value) }),
    }
  } else {
    match with_setting(r.server, key, value) {
      Err(reason) -> Err(reason),
      Ok(server) -> Ok({ ..r, server: server }),
    }
  }

fn ssl_of(mode: Option<String>, negotiation: Option<String>) -> Result<Ssl, String> =
  match secures(mode) {
    Err(reason) -> Err(reason),
    Ok(secured) -> match negotiation {
      None -> Ok(if secured { Negotiated } else { Disabled }),
      Some(way) -> if way == "postgres" { Ok(if secured { Negotiated } else { Disabled }) }
      else if way == "direct" {
        if secured { Ok(Immediate) } else {
          Err(
            "`sslnegotiation=direct` begins TLS at once, and this `sslmode` does not secure the connection: add `sslmode=verify-full`",
          )
        }
      } else {
        Err("`sslnegotiation=" ++ way ++ "` is not a negotiation; `postgres` and `direct` are")
      },
    },
  }

fn secures(mode: Option<String>) -> Result<Bool, String> =
  match mode {
    None -> Ok(false),
    Some(m) -> if m == "disable" { Ok(false) }
    else if m == "require" || m == "verify-ca" || m == "verify-full" { Ok(true) }
    else if m == "allow" || m == "prefer" {
      Err(
        "`sslmode=" ++ m
          ++ "` goes on in plaintext when the server says it does not speak TLS, which anyone between the two can say: write `sslmode=verify-full`, or `sslmode=disable` for a server that is reached in plaintext",
      )
    } else {
      Err(
        "`sslmode=" ++ m
          ++ "` is not a mode; the accepted modes are `disable`, `require`, `verify-ca` and `verify-full`",
      )
    },
  }

fn with_setting(s: Server, key: String, value: String) -> Result<Server, String> / {abort.raise} =
  if key == "application_name" {
    if value.contains("\0") { Err("an `application_name` may not hold a zero byte") }
    else { set_once(s.application_name, key, { ..s, application_name: Some(value) }) }
  } else if key == "statement_timeout" {
    match millis_of(key, value) {
      Err(reason) -> Err(reason),
      Ok(ms) -> set_once(s.statement_timeout_ms, key, { ..s, statement_timeout_ms: Some(ms) }),
    }
  } else if key == "idle_in_transaction_session_timeout" {
    match millis_of(key, value) {
      Err(reason) -> Err(reason),
      Ok(ms) ->
        set_once(s.idle_in_transaction_timeout_ms, key, {
          ..s,
          idle_in_transaction_timeout_ms: Some(ms),
        }),
    }
  } else { Err("`" ++ key ++ "` is not a parameter this driver supports") }

fn set_once<a>(given: Option<a>, key: String, set: Server) -> Result<Server, String> =
  match given { Some(_) -> Err("`" ++ key ++ "` is given twice"), None -> Ok(set) }

fn millis_of(key: String, text: String) -> Result<Int, String> / {abort.raise} =
  match natural_of(text) {
    None -> Err("`" ++ key ++ "=" ++ text ++ "`: a timeout is a whole number of milliseconds"),
    Some(ms) -> if ms > most_millis() {
      Err(
        "`" ++ key ++ "=" ++ text ++ "` is above the maximum postgres accepts, "
          ++ most_millis().to_string()
          ++ " milliseconds",
      )
    } else { Ok(ms) },
  }

fn most_millis() -> Int = 2147483647

/// Runs `body` with the `db` effect handled by a driver connected to the server that the connection
/// string `url` names. The password comes from the connection string or from `password` (for
/// example one returned by `config.secret`). Returns an error if `url` is invalid or both give a
/// password.
pub fn with_server<a | e>(
  url: String,
  size: Int,
  body: () -> a / {db.read[*], db.write[*] | e},
  password: Option<Secret<Bytes>> = None,
) -> Result<a, String> / {diverges, abort.raise, net.connect[link], net.start_tls[link], net.peer_certificate[link], net.send[link], net.send_secret[link], net.recv[link], net.close[link], entropy.next | e} =
  match server_of(url) {
    Err(reason) -> Err(reason),
    Ok(read) -> match with_password(read, password) {
      Err(reason) -> Err(reason),
      Ok(config) -> Ok(serve(config, size, nonce(), body)),
    },
  }

/// Returns `s` with its password set to `password` when `password` is given. Returns an error when
/// `s` already has a password.
pub fn with_password(s: Server, password: Option<Secret<Bytes>>) -> Result<Server, String> =
  match ((s.password, password)) {
    (Some(_), Some(_)) ->
      Err("the password is in the connection string and given beside it; give it once"),
    (None, Some(given)) -> Ok({ ..s, password: Some(given) }),
    _ -> Ok(s),
  }

test "`server_of` parses a connection URL into user, password, host, port, database and application name" {
  match server_of(
      "postgres://ply:hunter2@127.0.0.1:5433/app?sslmode=disable&application_name=ply",
    ) {
    Err(reason) -> panic(reason),
    Ok(s) -> {
      assert_eq(s.user, "ply");
      assert_eq(s.password, Some(Secret::of_bytes(b"hunter2")));
      assert_eq(s.host, "127.0.0.1");
      assert_eq(s.port, 5433);
      assert_eq(s.database, "app");
      assert_eq(s.application_name, Some("ply"))
    },
  }
}

test "`startup_parameters` returns the timeouts and application name from a connection URL as the settings sent when a connection starts" {
  match server_of(
      "postgres://ply@db/app?statement_timeout=250&application_name=the%20service&idle_in_transaction_session_timeout=0",
    ) {
    Err(reason) -> panic(reason),
    Ok(s) -> {
      assert_eq(s.statement_timeout_ms, Some(250));
      assert_eq(s.idle_in_transaction_timeout_ms, Some(0));
      assert_eq(startup_parameters(s), [
        { name: "application_name", value: "the service" },
        { name: "statement_timeout", value: "250" },
        { name: "idle_in_transaction_session_timeout", value: "0" },
      ])
    },
  };
  match server_of("postgres://ply@db/app?sslmode=disable") {
    Err(reason) -> panic(reason),
    Ok(s) -> {
      assert_eq(s.statement_timeout_ms, None);
      assert_eq(startup_parameters(s), [])
    },
  }
}

test "a timeout in a connection URL must be a whole number of milliseconds within the server's maximum and appear only once" {
  assert_err("postgres://ply@db/app?statement_timeout=5s", "whole number of milliseconds");
  assert_err("postgres://ply@db/app?statement_timeout=-1", "whole number of milliseconds");
  assert_err("postgres://ply@db/app?idle_in_transaction_session_timeout=", "whole number");
  assert_err(
    "postgres://ply@db/app?statement_timeout=2147483648",
    "is above the maximum postgres accepts",
  );
  assert_err("postgres://ply@db/app?statement_timeout=1&statement_timeout=2", "given twice");
  assert_err("postgres://ply@db/app?application_name=a%00b", "zero byte")
}

test "a connection string may leave out the port, the password and the parameters" {
  match server_of("postgresql://ply@db/app") {
    Err(reason) -> panic(reason),
    Ok(s) -> {
      assert_eq(s.port, 5432);
      assert_eq(s.password, None);
      assert_eq(s.database, "app")
    },
  }
}

test "a URL password may contain percent-escaped characters such as `@` and `:`, and `server_of` stores it as a `Secret`" {
  match server_of("postgres://ply:a%40b%3Ac@db:5433/app") {
    Err(reason) -> panic(reason),
    Ok(s) -> {
      assert_eq(s.password, Some(Secret::of_bytes(b"a@b:c")));
      assert_eq(s.user, "ply");
      assert_eq(s.port, 5433)
    },
  };
  match server_of("postgres://ply:p@ss%FF@db/app") {
    Err(reason) -> panic(reason),
    Ok(s) -> assert_eq(s.password, Some(Secret::of_bytes(b"p@ss\xff"))),
  };
  match server_of("postgres://ply:@db/app") {
    Err(reason) -> panic(reason),
    Ok(s) -> assert_eq(s.password, None),
  };
  assert_err("postgres://ply:a%4@db/app", "two hex digits")
}

test "`with_password` adds a password given in settings to a URL without one, and fails when the URL has its own password" {
  let given = Some(Secret::of_bytes(b"b"));
  match server_of("postgres://ply@db/app") {
    Err(reason) -> panic(reason),
    Ok(s) -> assert_eq(with_password(s, given).map(|t: Server| t.password), Ok(given)),
  };
  match server_of("postgres://ply:a@db/app") {
    Err(reason) -> panic(reason),
    Ok(s) -> {
      assert(with_password(s, given).map(|t: Server| t.password) != Ok(given));
      assert_eq(with_password(s, None).map(|t: Server| t.password), Ok(s.password))
    },
  }
}

test "`server_of` returns an error for a connection string it cannot interpret, instead of guessing" {
  assert_err("host=db user=ply", "keyword");
  assert_err("mysql://ply@db/app", "is not a supported database scheme");
  assert_err("postgres://db/app", "user@");
  assert_err("postgres://@db/app", "user is empty");
  assert_err("postgres://ply@/app", "no host");
  assert_err("postgres://ply@db:0/app", "port 0");
  assert_err("postgres://ply@db:nine/app", "is not a port");
  assert_err("postgres://ply@db/", "no database name");
  assert_err("postgres://ply@db/app?timeout=3", "not a parameter");
  assert_err("postgres://ply@db/app?sslmode", "key=value")
}

fn ssl_of_url(url: String) -> Ssl / {abort.raise} =
  match server_of(url) { Ok(s) -> s.ssl, Err(reason) -> panic(reason) }

test "`ssl_of_url` accepts only sslmode values that verify the server, and rejects modes that allow plaintext or a TLS downgrade" {
  assert_eq(ssl_of_url("postgres://ply@db/app"), Disabled);
  assert_eq(ssl_of_url("postgres://ply@db/app?sslmode=disable"), Disabled);
  assert_eq(ssl_of_url("postgres://ply@db/app?sslmode=require"), Negotiated);
  assert_eq(ssl_of_url("postgres://ply@db/app?sslmode=verify-ca"), Negotiated);
  assert_eq(
    ssl_of_url("postgres://ply@db/app?sslmode=verify-full&sslnegotiation=postgres"),
    Negotiated,
  );
  assert_eq(
    ssl_of_url("postgres://ply@db/app?sslnegotiation=direct&sslmode=verify-full"),
    Immediate,
  );
  assert_err("postgres://ply@db/app?sslmode=prefer", "plaintext");
  assert_err("postgres://ply@db/app?sslmode=allow", "plaintext");
  assert_err("postgres://ply@db/app?sslmode=on", "not a mode");
  assert_err("postgres://ply@db/app?sslnegotiation=direct", "does not secure");
  assert_err("postgres://ply@db/app?sslmode=disable&sslnegotiation=direct", "does not secure");
  assert_err("postgres://ply@db/app?sslnegotiation=fast&sslmode=require", "not a negotiation");
  assert_err("postgres://ply@db/app?sslmode=require&sslmode=disable", "given twice")
}

fn assert_err(url: String, wanted: String) -> Unit / {abort.raise} =
  match server_of(url) {
    Ok(_) -> panic("`" ++ url ++ "` was accepted"),
    Err(reason) ->
      assert(
        reason.contains(wanted),
        Some(
          "`" ++ url ++ "` was rejected with `" ++ reason ++ "`, which does not name `" ++ wanted
            ++ "`",
        ),
      ),
  }

type ScriptedError = {
  statement_prefix: String,
  code: String,
  constraint: String,
  message: String,
  detail: String,
  fatal: Bool,
}

fn scripted_error(
  on: String,
  code: String,
  constraint: String,
  message: String,
  detail: String,
) -> ScriptedError =
  {
    statement_prefix: on,
    code: code,
    constraint: constraint,
    message: message,
    detail: detail,
    fatal: false,
  }

fn hang_up(on: String, code: String) -> ScriptedError =
  {
    statement_prefix: on,
    code: code,
    constraint: "",
    message: "terminating connection",
    detail: "",
    fatal: true,
  }

type FakeConnection = {
  inbox: Bytes,
  outbox: Bytes,
  started: Bool,
  status: Int,
  parsed: String,
  statements: List<String>,
  open: Bool,
}

type FakeServer = { wires: List<FakeConnection>, rejections: List<ScriptedError> }

type FeedResult = { wire: FakeConnection, rejections: List<ScriptedError> }

type ScriptRun<a> = { value: a, wires: List<FakeConnection> }

fn test_frame(kind: Int, body: Bytes) -> Bytes / {abort.raise} =
  Bytes::concat_all([byte_of_int(kind), u32_be(body.len() + 4), body])

fn test_ready(status: Int) -> Bytes / {abort.raise} = test_frame(90, byte_of_int(status))

fn test_command_complete(tag: String) -> Bytes / {abort.raise} = test_frame(67, cstring(tag))

fn test_field(code: String, text: String) -> Bytes =
  if text == "" { b"" } else { Bytes::of_string(code).concat(cstring(text)) }

fn test_error(severity: String, r: ScriptedError) -> Bytes / {abort.raise} =
  test_frame(
    69,
    Bytes::concat_all([
      test_field("S", severity),
      test_field("C", r.code),
      test_field("M", r.message),
      test_field("D", r.detail),
      test_field("n", r.constraint),
      b"\x00",
    ]),
  )

fn test_aborted() -> ScriptedError =
  scripted_error(
    "",
    "25P02",
    "",
    "current transaction is aborted, commands ignored until end of transaction block",
    "",
  )

fn test_greeted() -> FakeConnection / {abort.raise} =
  {
    inbox: b"",
    outbox: test_frame(82, u32_be(0)).concat(test_ready(73)),
    started: false,
    status: 73,
    parsed: "",
    statements: [],
    open: true,
  }

type FakeReply = { bytes: Bytes, status: Int }

fn test_tagged(tag: String, status: Int) -> FakeReply / {abort.raise} =
  { bytes: test_command_complete(tag), status: status }

fn test_in_failed() -> FakeReply / {abort.raise} =
  { bytes: test_error("ERROR", test_aborted()), status: 69 }

fn test_rolled_back_to() -> FakeReply / {abort.raise} =
  { bytes: test_command_complete("ROLLBACK").concat(test_command_complete("RELEASE")), status: 84 }

fn test_result(sql: String, status: Int, extended: Bool) -> FakeReply / {abort.raise} =
  if extended { test_extended(sql, status) } else { test_simple(sql, status) }

fn test_extended(sql: String, status: Int) -> FakeReply / {abort.raise} =
  if status == 69 { test_in_failed() } else {
    {
      bytes: Bytes::concat_all([
        test_frame(49, b""),
        test_frame(50, b""),
        test_frame(110, b""),
        test_command_complete(test_tag(sql)),
      ]),
      status: status,
    }
  }

fn test_simple(sql: String, status: Int) -> FakeReply / {abort.raise} =
  if sql.starts_with("begin") { test_tagged("BEGIN", 84) }
  else if sql == "commit" { test_tagged(if status == 69 { "ROLLBACK" } else { "COMMIT" }, 73) }
  else if sql == "rollback" { test_tagged("ROLLBACK", 73) }
  else if sql.starts_with("rollback to") { test_rolled_back_to() }
  else if status == 69 { test_in_failed() }
  else if sql.starts_with("savepoint") { test_tagged("SAVEPOINT", status) }
  else { test_tagged("RELEASE", status) }

fn test_tag(sql: String) -> String =
  if sql.starts_with("insert") { "INSERT 0 1" }
  else if sql.starts_with("update") { "UPDATE 1" }
  else { "DELETE 1" }

fn test_after_error(sql: String, status: Int) -> Int =
  if sql == "commit" { 73 } else if status == 84 { 69 } else { status }

type PickResult = { found: Option<ScriptedError>, rest: List<ScriptedError> }

fn test_pick(rejections: List<ScriptedError>, sql: String) -> PickResult =
  rejections.fold({ found: None, rest: [] }, |accumulator: PickResult, r: ScriptedError|
    match accumulator.found {
      None -> if sql.starts_with(r.statement_prefix) { { ..accumulator, found: Some(r) } }
      else { { ..accumulator, rest: accumulator.rest.push(r) } },
      Some(_) -> { ..accumulator, rest: accumulator.rest.push(r) },
    })

fn test_statement(
  w: FakeConnection,
  rejections: List<ScriptedError>,
  sql: String,
  extended: Bool,
) -> FeedResult / {abort.raise} = {
  let recorded = { ..w, statements: w.statements.push(sql) };
  let picked = test_pick(rejections, sql);
  match picked.found {
    Some(r) -> if r.fatal {
      {
        wire: { ..recorded, outbox: recorded.outbox.concat(test_error("FATAL", r)), open: false },
        rejections: picked.rest,
      }
    } else {
      let status = test_after_error(sql, w.status);
      {
        wire: {
          ..recorded,
          outbox: Bytes::concat_all([recorded.outbox, test_error("ERROR", r), test_ready(status)]),
          status: status,
        },
        rejections: picked.rest,
      }
    },
    None -> {
      let a = test_result(sql, w.status, extended);
      {
        wire: {
          ..recorded,
          outbox: Bytes::concat_all([recorded.outbox, a.bytes, test_ready(a.status)]),
          status: a.status,
        },
        rejections: picked.rest,
      }
    },
  }
}

fn test_cstring(b: Bytes, at: Int) -> String / {abort.raise} =
  match pg::read_cstring(b, at) { Some(c) -> c.text, None -> "" }

fn test_message(
  w: FakeConnection,
  rejections: List<ScriptedError>,
  kind: Int,
  body: Bytes,
) -> FeedResult / {abort.raise} =
  if (kind == 81 || kind == 80) && w.outbox.len() > 0 {
    panic("a connection was sent a statement before its last one had a response")
  } else if kind == 81 { test_statement(w, rejections, test_cstring(body, 0), false) }
  else if kind == 80 {
    match pg::read_cstring(body, 0) {
      Some(name) ->
        { wire: { ..w, parsed: test_cstring(body, name.next) }, rejections: rejections },
      None -> { wire: w, rejections: rejections },
    }
  } else if kind == 83 { test_statement(w, rejections, w.parsed, true) }
  else if kind == 88 { { wire: { ..w, open: false }, rejections: rejections } }
  else { { wire: w, rejections: rejections } }

fn test_feed(
  w: FakeConnection,
  rejections: List<ScriptedError>,
  left: Int,
) -> FeedResult / {abort.raise} =
  if left <= 0 { panic("the fake connection parsed more messages than its input can contain") }
  else {
    if !w.started {
      match w.inbox.u32_be_at(0) {
        None -> { wire: w, rejections: rejections },
        Some(n) -> if n < 4 || w.inbox.len() < n { { wire: w, rejections: rejections } } else {
          test_feed(
            { ..w, inbox: w.inbox.slice(n, w.inbox.len()), started: true },
            rejections,
            left - 1,
          )
        },
      }
    } else {
      match w.inbox.u32_be_at(1) {
        None -> { wire: w, rejections: rejections },
        Some(n) -> if n < 4 || w.inbox.len() < 1 + n { { wire: w, rejections: rejections } } else {
          let fed = test_message(
            { ..w, inbox: w.inbox.slice(1 + n, w.inbox.len()) },
            rejections,
            w.inbox.at(0),
            w.inbox.slice(5, 1 + n),
          );
          test_feed(fed.wire, fed.rejections, left - 1)
        },
      }
    }
  }

fn test_sent(f: FakeServer, c: Int, payload: Bytes) -> FakeServer / {abort.raise} =
  match f.wires.at(c) {
    None -> panic("a send on a connection the script never opened"),
    Some(w) -> if !w.open { f } else {
      let inbox = w.inbox.concat(payload);
      let fed = test_feed({ ..w, inbox: inbox }, f.rejections, inbox.len() + 1);
      { wires: f.wires.set(c, fed.wire), rejections: fed.rejections }
    },
  }

type ReadResult = { fake: FakeServer, bytes: Bytes }

fn test_read(f: FakeServer, c: Int) -> ReadResult / {abort.raise} =
  match f.wires.at(c) {
    None -> panic("a read on a connection the script never opened"),
    Some(w) -> if w.outbox.len() > 0 {
      { fake: { ..f, wires: f.wires.set(c, { ..w, outbox: b"" }) }, bytes: w.outbox }
    } else if w.open { panic("the driver waited on a reply the script never sends") }
    else { { fake: f, bytes: b"" } },
  }

fn test_closed(f: FakeServer, c: Int) -> FakeServer =
  match f.wires.at(c) { None -> f, Some(w) -> { ..f, wires: f.wires.set(c, { ..w, open: false }) } }

fn over_script<a | e>(
  size: Int,
  rejections: List<ScriptedError>,
  body: () -> a / {db.read[*], db.write[*] | e},
) -> ScriptRun<a> / {diverges, abort.raise, task.yield | e} =
  handle {
    serve(server("db", 5432, "ply", "ply", None), size, "t", body)
  } with {
    var fake = { wires: [], rejections: rejections },
    net.connect[link](host, port, timeout_ms) -> {
      let f = fake;
      fake = { ..f, wires: f.wires.push(test_greeted()) };
      Some(f.wires.len())
    },
    net.send[link](c, payload, timeout_ms) -> {
      fake = test_sent(fake, c, payload);
      Some(payload.len())
    },
    net.recv[link](c, max, timeout_ms) -> {
      if test_talking(fake, c) { task.yield() };
      let received = test_read(fake, c);
      fake = received.fake;
      Some(received.bytes)
    },
    net.close[link](c) -> {
      fake = test_closed(fake, c);
    },
    net.start_tls[link](c, name, alpn, unread, timeout_ms) ->
      panic("the scripted server speaks no TLS"),
    net.peer_certificate[link](c) -> panic("the scripted server speaks no TLS"),
    net.send_secret[link](c, before, secret, encoding, after, timeout_ms) ->
      panic("the scripted server asks for no password"),
    return value -> { value: value, wires: fake.wires },
  }

fn test_talking(f: FakeServer, c: Int) -> Bool =
  match f.wires.at(c) { Some(w) -> w.statements.len() > 0, None -> false }

fn test_statements(wires: List<FakeConnection>) -> List<List<String>> =
  wires.map(|w: FakeConnection| w.statements)

fn test_insert(sku: String) -> Statement =
  statement_of("insert into part (sku) values ('" ++ sku ++ "')")

fn test_begin(level: String) -> String = "begin isolation level " ++ level ++ " read write"

fn test_runs(wires: List<FakeConnection>) -> List<List<String>> =
  wires.fold([], |accumulator: List<List<String>>, w: FakeConnection|
    accumulator.concat(test_cut(w.statements, [], [])))

fn test_cut(
  statements: List<String>,
  run: List<String>,
  accumulator: List<List<String>>,
) -> List<List<String>> =
  match statements {
    [] -> if run.len() == 0 { accumulator } else { accumulator.push(run) },
    [s, ..rest] -> if s == "commit" || s == "rollback" {
      test_cut(rest, [], accumulator.push(run.push(s)))
    } else { test_cut(rest, run.push(s), accumulator) },
  }

fn test_has_run(runs: List<List<String>>, run: List<String>) -> Bool =
  runs.fold(false, |accumulator: Bool, r: List<String>| accumulator || r == run)

fn retry_serializable(
  left: Int,
  seen: List<String>,
) -> { result: Result<Int, Rollback>, seen: List<String> } / {db.begin, db.commit, db.abort, db.execute[part]} =
  match transaction(Serializable, ReadWrite, || {
      db.execute[part](test_insert("a"), []);
      1
    }) {
    Ok(v) -> { result: Ok(v), seen: seen },
    Err(rolled) -> match rolled.error {
      None -> { result: Err(rolled), seen: seen },
      Some(e) -> if is_retryable(e) && left > 1 { retry_serializable(left - 1, seen.push(e.code)) }
      else { { result: Err(rolled), seen: seen.push(e.code) } },
    },
  }

test "a server error is reported with its SQLSTATE code, constraint name and message, and the connection stays usable" {
  simulate {
    let r = over_script(
      1,
      [
        scripted_error(
          test_insert("a").sql,
          "23505",
          "part_pkey",
          "duplicate key value violates unique constraint \"part_pkey\"",
          "Key (sku)=(a) already exists.",
        ),
      ],
      || [db.execute[part](test_insert("a"), []), db.execute[part](test_insert("b"), [])],
    );
    assert_eq(r.value, [
      Failed({
        code: "23505",
        constraint: "part_pkey",
        detail: "duplicate key value violates unique constraint \"part_pkey\": Key (sku)=(a) already exists.",
      }),
      Count(1),
    ]);
    assert_eq(test_statements(r.wires), [[test_insert("a").sql, test_insert("b").sql]])
  }
}

test "a pool closes every connection it opened when the function running inside it returns" {
  simulate {
    let r = over_script(2, [], || {
      let first = db.execute[part](test_insert("a"), []);
      [first, db.execute[part](test_insert("b"), [])]
    });
    assert_eq(r.value, [Count(1), Count(1)]);
    assert(r.wires.len() > 0);
    assert(r.wires.fold(true, |all: Bool, w: FakeConnection| all && !w.open))
  }
}

test "a serialization failure at commit is retryable, and the retry begins a transaction afresh" {
  simulate {
    let r = over_script(
      1,
      [
        scripted_error(
          "commit",
          "40001",
          "",
          "could not serialize access due to read/write dependencies among transactions",
          "",
        ),
      ],
      || retry_serializable(3, []),
    );
    assert_eq(r.value, { result: Ok(1), seen: ["40001"] });
    let begin = test_begin("serializable");
    assert_eq(test_statements(r.wires), [
      [begin, test_insert("a").sql, "commit", begin, test_insert("a").sql, "commit"],
    ])
  }
}

test "transactions in two concurrent tasks each use their own connection, in either order of execution" {
  simulate {
    let r = over_script(2, [], || {
      let a = task.spawn(||
        transaction(ReadCommitted, ReadWrite, || {
          db.execute[part](test_insert("a1"), []);
          "a"
        }));
      let b = task.spawn(||
        transaction(ReadCommitted, ReadWrite, || {
          db.execute[part](test_insert("b1"), []);
          db.rollback("b gave up")
        }));
      { a: task.join(a), b: task.join(b) }
    });
    assert_eq(r.value.a, Ok("a"));
    assert_eq(r.value.b, Err({ reason: "b gave up", error: None }));
    let begin = test_begin("read committed");
    let runs = test_runs(r.wires);
    assert_eq(runs.len(), 2);
    assert(test_has_run(runs, [begin, test_insert("a1").sql, "commit"]));
    assert(test_has_run(runs, [begin, test_insert("b1").sql, "rollback"]))
  }
}

test "`route` picks the one open transaction that is not waiting on the server for an operation, and returns `NoTransaction` when all are waiting" {
  let s = {
    n: 0,
    session: None,
    depth: 1,
    level: ReadCommitted,
    access: ReadWrite,
    busy: false,
    copying: false,
  };
  let waiting = { ..s, n: 1, busy: true };
  assert_eq(route([]), NoTransaction);
  assert_eq(route([waiting]), NoTransaction);
  assert_eq(route([waiting, s]), Own(s));
  assert_eq(route([s, { ..s, n: 2 }]), Ambiguous)
}

test "a pool gives a connection to one statement at a time, and reports when it has none left" {
  simulate {
    let r = over_script(1, [], || {
      let a = task.spawn(|| db.execute[part](test_insert("t1"), []));
      let b = task.spawn(|| db.execute[part](test_insert("t2"), []));
      let c = task.spawn(|| db.execute[part](test_insert("t3"), []));
      [task.join(a), task.join(b), task.join(c)]
    });
    assert(
      r.value.fold(true, |accumulator: Bool, a: QueryResult|
        accumulator && (a == Count(1) || test_code(a) == "53300")),
    );
    assert(r.value.fold(false, |accumulator: Bool, a: QueryResult| accumulator || a == Count(1)));
    assert_eq(r.wires.len(), 1)
  }
}

test "`db.notify` runs on the connection of the current transaction, with the channel and payload sent as parameters" {
  simulate {
    let r = over_script(1, [], || {
      let inside = transaction(ReadCommitted, ReadWrite, || db.notify[jobs]("in"));
      { inside: inside, outside: db.notify[jobs]("out") }
    });
    assert_eq(r.value.inside, Ok(Count(1)));
    assert_eq(r.value.outside, Count(1));
    assert_eq(test_statements(r.wires), [
      [test_begin("read committed"), notify_statement().sql, "commit", notify_statement().sql],
    ])
  }
}

test "an inner abort closes its savepoint, and the transaction around it still commits" {
  simulate {
    let r = over_script(1, [], || {
      let out = transaction(ReadCommitted, ReadWrite, || {
        db.execute[part](test_insert("x"), []);
        let inner = transaction(ReadCommitted, ReadWrite, || {
          db.execute[part](test_insert("y"), []);
          db.rollback("inner gave up")
        });
        db.execute[part](test_insert("z"), []);
        inner
      });
      let after = transaction(ReadCommitted, ReadWrite, || db.execute[part](test_insert("w"), []));
      { out: out, after: after }
    });
    assert_eq(r.value.out, Ok(Err({ reason: "inner gave up", error: None })));
    assert_eq(r.value.after, Ok(Count(1)));
    let begin = test_begin("read committed");
    assert_eq(test_statements(r.wires), [
      [
        begin,
        test_insert("x").sql,
        "savepoint ply_sp2",
        test_insert("y").sql,
        "rollback to savepoint ply_sp2; release savepoint ply_sp2",
        test_insert("z").sql,
        "commit",
        begin,
        test_insert("w").sql,
        "commit",
      ],
    ])
  }
}

test "when the server turns a commit into a rollback it fails as an aborted transaction, and the connection returns to the pool" {
  simulate {
    let r = over_script(
      1,
      [
        scripted_error(
          test_insert("a").sql,
          "23505",
          "part_pkey",
          "duplicate key value violates unique constraint \"part_pkey\"",
          "",
        ),
      ],
      || {
        let out = transaction(ReadCommitted, ReadWrite, || db.execute[part](test_insert("a"), []));
        { out: out, next: db.execute[part](test_insert("b"), []) }
      },
    );
    assert_eq(r.value.out, Err({ reason: "commit", error: Some(in_failed_txn()) }));
    assert_eq(r.value.next, Count(1));
    assert_eq(test_statements(r.wires), [
      [test_begin("read committed"), test_insert("a").sql, "commit", test_insert("b").sql],
    ])
  }
}

test "a nested begin the transaction cannot accept is rejected before anything is sent" {
  simulate {
    let r = over_script(
      1,
      [scripted_error(test_insert("a").sql, "23505", "part_pkey", "duplicate key", "")],
      || {
        let bounded = transaction(ReadCommitted, ReadOnly, ||
          [db.begin(Serializable, ReadOnly), db.begin(ReadCommitted, ReadWrite)]);
        let failed = sandbox(|| {
          db.execute[part](test_insert("a"), []);
          db.begin(ReadCommitted, ReadWrite)
        });
        { bounded: bounded, failed: failed }
      },
    );
    assert_eq(match r.value.bounded { Ok(results) -> results.map(test_code), Err(_) -> [] }, [
      "25001",
      "25001",
    ]);
    assert_eq(test_code(r.value.failed), "25P02");
    assert_eq(test_statements(r.wires), [
      [
        "begin isolation level read committed read only",
        "commit",
        test_begin("read committed"),
        test_insert("a").sql,
        "rollback",
      ],
    ])
  }
}

test "after a connection is lost inside a transaction, its remaining statements fail and are not run on another connection" {
  simulate {
    let r = over_script(
      1,
      [hang_up(test_insert("a").sql, "57P01"), hang_up(test_insert("d").sql, "57P01")],
      || {
        let rest = sandbox(||
          [
            db.execute[part](test_insert("a"), []),
            db.execute[part](test_insert("b"), []),
            db.begin(ReadCommitted, ReadWrite),
          ]);
        let next = db.execute[part](test_insert("c"), []);
        let commit_result = transaction(ReadCommitted, ReadWrite, ||
          db.execute[part](test_insert("d"), []));
        { rest: rest.map(test_code), next: next, committed: commit_result }
      },
    );
    assert_eq(r.value.rest, ["57P01", "08003", "08003"]);
    assert_eq(r.value.next, Count(1));
    assert_eq(r.value.committed, Err({ reason: "commit", error: Some(connection_lost()) }));
    let begin = test_begin("read committed");
    assert_eq(test_statements(r.wires), [
      [begin, test_insert("a").sql],
      [test_insert("c").sql, begin, test_insert("d").sql],
    ]);
    assert_eq(r.wires.map(|w: FakeConnection| w.open), [false, false])
  }
}

fn times_ten_store<a>(
  go: () -> a / {db.query[items], db.batch[items], abort.raise, diverges},
) -> { value: a, queries: Int, batches: Int } / {abort.raise, diverges} = {
  let row = |ps: List<Param>|
    match ps {
      [IntParameter(id)] -> Rows([Map::new().insert("v", IntDatum(id * 10))]),
      _ -> Failed(db_error("08P01", "", "one id")),
    };
  handle {
    go()
  } with {
    var counts = { queries: 0, batches: 0 },
    db.query[items](s, ps) -> {
      counts = { ..counts, queries: counts.queries + 1 };
      row(ps)
    },
    db.batch[items](s, each) -> {
      counts = { ..counts, batches: counts.batches + 1 };
      each.map(row)
    },
    return value -> { value: value, queries: counts.queries, batches: counts.batches },
  }
}

fn ten_of(id: Int) -> Int / {db.query[items]} =
  match db.query[items](statement_of("select v from items where id = $1"), [IntParameter(id)]) {
    Rows([r]) -> match r.get("v") { Some(IntDatum(v)) -> v, _ -> 0 - 1 },
    _ -> 0 - 1,
  }

test "`map_batched` runs one query for all ids and returns the same values as mapping the lookup over each id separately" {
  let ids = [3, 1, 4, 1, 5];
  let alone = times_ten_store(|| ids.map(ten_of));
  let together = times_ten_store(|| map_batched[items](ids, ten_of));
  assert_eq(together.value, alone.value);
  assert_eq({ queries: alone.queries, batches: alone.batches }, { queries: 5, batches: 0 });
  assert_eq({ queries: together.queries, batches: together.batches }, { queries: 0, batches: 1 })
}

test "a lookup with two queries runs two batched queries, and a single id runs one plain `db.query`" {
  let twice = |id: Int| ten_of(id) + ten_of(id + 100);
  let r = times_ten_store(|| map_batched[items]([1, 2, 3], twice));
  assert_eq(r.value, [1020, 1040, 1060]);
  assert_eq({ queries: r.queries, batches: r.batches }, { queries: 0, batches: 2 });
  let one = times_ten_store(|| map_batched[items]([7], ten_of));
  assert_eq({ value: one.value, queries: one.queries, batches: one.batches }, {
    value: [70],
    queries: 1,
    batches: 0,
  })
}

test "`combine_batch` builds one SQL statement that repeats the statement once per query, renumbers each copy's placeholders and adds columns that mark each row's query and position" {
  let c = combine_batch(statement_of("select v from items where id = $1 and kind = $2;"), [
    [IntParameter(1), TextParameter("a")],
    [IntParameter(2), TextParameter("b")],
  ]);
  assert_eq(
    match c { Some(x) -> x.s.sql, None -> "" },
    "select * from (select 0 as \"ply.ask\", row_number() over () as \"ply.row\", \"ply.arm\".* from (select v from items where id = $1 and kind = $2) as \"ply.arm\" union all select 1 as \"ply.ask\", row_number() over () as \"ply.row\", \"ply.arm\".* from (select v from items where id = $3 and kind = $4) as \"ply.arm\") as \"ply.batch\" order by \"ply.ask\", \"ply.row\"",
  );
  assert_eq(match c { Some(x) -> x.ps, None -> [] }, [
    IntParameter(1),
    TextParameter("a"),
    IntParameter(2),
    TextParameter("b"),
  ]);
  assert_eq(
    combine_batch(statement_of("select v from items where id = $1"), [[IntParameter(1)], []]),
    None,
  );
  assert_eq(
    match combine_batch(statement_of("select '$1' as t from items where id = $1"), [
        [IntParameter(1)],
        [IntParameter(2)],
      ]) {
      Some(x) -> x.s.sql.contains("select '$1' as t from items where id = $2"),
      None -> false,
    },
    true,
  )
}

test "`split_asks` groups the rows of a combined batch result by the query that produced them, in order, and drops the `ply.ask` and `ply.row` columns" {
  let marked = |ask: Int, place: Int, v: Int|
    Map::new().insert("ply.ask", IntDatum(ask)).insert("ply.row", IntDatum(place)).insert(
      "v",
      IntDatum(v),
    );
  assert_eq(split_query_results([marked(0, 1, 5), marked(0, 2, 6), marked(2, 1, 7)], 3), [
    Rows([Map::new().insert("v", IntDatum(5)), Map::new().insert("v", IntDatum(6))]),
    Rows([]),
    Rows([Map::new().insert("v", IntDatum(7))]),
  ])
}
