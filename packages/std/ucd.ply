//! The Unicode Character Database as `ply` ships it: its version, the format of its tables, and how
//! a module reads one.
//!
//! A table is a text file under `ucd/`, made from the database's own files by keeping only the
//! fields a module reads. The first line is `# Unicode` followed by the version. Every other line
//! is either a comment starting with `#`, or `first[..last];field[;field..]`: a run of code points
//! in hexadecimal, then the fields that apply to each code point in the run. Runs are in increasing
//! order and do not overlap. A code point in no run gets the missing value its reader chooses.
//!
//! `runs` parses the lines. `table` builds from them a `Table` that `lookup` reads with two array
//! reads, for any code point and any number of runs. A module stores its `Table` in a `const`,
//! so the build reads the file once and the program reads only the `Table`. `std.char` stores the
//! two tables it uses to classify and map characters. A module that needs another Unicode property
//! adds a table file and a `const` for it.
//!
//! Every table is of the version `version` returns, and `runs` rejects a file of any other version,
//! so modules built on tables cannot mix two versions of Unicode. The files are the Unicode
//! Consortium's data, distributed under the license `license` returns.

import std.bytes (u16_be, u32_be)
import std.list

/// The version of the Unicode Standard every table under `ucd/` is made from.
pub const version: { major: Int, minor: Int, update: Int } = { major: 17, minor: 0, update: 0 }

/// The Unicode License v3: the copyright and permission notice that must accompany every copy of
/// the tables, including a program built with them.
pub const license: String = String::of_bytes(embed("ucd/LICENSE"))

/// A run of code points, `first` to `last` inclusive, and the fields one line of a table gives
/// them.
pub type Run = { first: Int, last: Int, fields: List<Bytes> }

/// A run of code points and the value a table stores for each of them.
pub type ValueRun = { first: Int, last: Int, value: Int }

/// A table made for `lookup`.
pub opaque type Table = new {
  /// For each group of 256 code points starting at zero, the number of the block in `blocks` that
  /// contains the values of that group.
  index: Array<Int>,
  /// The blocks one after another, 256 values each. Groups with the same values share a block.
  blocks: Array<Int>,
  /// The value for an `Int` that is not a code point.
  missing: Int,
}

const version_line: Bytes = {
  let v = version;
  Bytes::of_string(f"# Unicode {v.major}.{v.minor}.{v.update}")
}

fn line_error(line: Bytes, reason: String) -> String = f"`{String::of_bytes_lossy(line)}` {reason}"

fn code_point(digits: Bytes, line: Bytes) -> Int / {abort.raise} =
  match digits.int_of_ascii_radix(16) {
    Some(point) -> if point < 0 {
      panic(line_error(line, "is not a code point or a range of code points"))
    } else if point > 0x10FFFF { panic(line_error(line, "is past U+10FFFF")) }
    else { point },
    None -> panic(line_error(line, "is not a code point or a range of code points")),
  }

fn parse_run(line: Bytes) -> Run / {abort.raise} =
  match line.split(b";") {
    [span, ..fields] -> if fields.len() == 0 { panic(line_error(line, "holds no field")) } else {
      match span.split(b"..") {
        [one] -> { first: code_point(one, line), last: code_point(one, line), fields: fields },
        [first, last] ->
          { first: code_point(first, line), last: code_point(last, line), fields: fields },
        _ -> panic(line_error(line, "is not a code point or a range of code points")),
      }
    },
    [] -> panic(line_error(line, "is not a code point or a range of code points")),
  }

type ReadState = { runs: List<Run>, next: Int }

/// Returns the runs in a table's text, in code point order. Raises when the text does not start
/// with this version's line. Every other line must be empty, a comment starting with `#`, or a run
/// with a code point range and its fields. Raises for a run past `U+10FFFF`, a run that ends before
/// it starts, and a run that does not come after the run before it.
pub fn runs(text: Bytes) -> List<Run> / {abort.raise} = {
  let lines = text.split(b"\n");
  if lines.at(0) != Some(version_line) {
    panic(f"a table opens with `{String::of_bytes(version_line)}`")
  } else {
    lines.fold({ runs: [], next: 0 }, |read: ReadState, line: Bytes|
      if line.len() == 0 || line.at(0) == b'#' { read } else {
        let run = parse_run(line);
        if run.last < run.first {
          panic(line_error(line, "has a range that ends before it starts"))
        } else if run.first < read.next {
          panic(
            line_error(line, "has a range that must start after the previous line's range ends"),
          )
        } else { { runs: read.runs.push(run), next: run.last + 1 } }
      }).runs
  }
}

type Span = { count: Int, value: Int }

type CoverState = { spans: List<Span>, next: Int }

fn covering(runs: List<ValueRun>, missing: Int) -> List<Span> / {abort.raise} = {
  let covered = runs.fold({ spans: [], next: 0 }, |accumulator: CoverState, run: ValueRun|
    if run.first < accumulator.next || run.last < run.first || run.last > 0x10FFFF {
      panic(
        "a table's ranges must be in ascending order, must not overlap and must end at or before U+10FFFF",
      )
    } else {
      let before = if run.first > accumulator.next {
        accumulator.spans.push({ count: run.first - accumulator.next, value: missing })
      } else { accumulator.spans };
      {
        spans: before.push({ count: run.last - run.first + 1, value: run.value }),
        next: run.last + 1,
      }
    });
  if covered.next > 0x10FFFF { covered.spans }
  else { covered.spans.push({ count: 0x110000 - covered.next, value: missing }) }
}

type Numbering = { ids: Map<Int, Int>, values: List<Int> }

fn number_values(spans: List<Span>) -> Numbering =
  spans.fold({ ids: Map::new(), values: [] }, |accumulator: Numbering, span: Span|
    if accumulator.ids.contains(span.value) { accumulator } else {
      {
        ids: accumulator.ids.insert(span.value, accumulator.values.len()),
        values: accumulator.values.push(span.value),
      }
    })

fn repeated(unit: Bytes, n: Int) -> Bytes =
  if n <= 0 { b"" }
  else if n == 1 { unit } else {
    let half = repeated(unit, n / 2);
    if n % 2 == 0 { half.concat(half) } else { Bytes::concat_all([half, half, unit]) }
  }

type BlockState = { index: List<Int>, blocks: List<Bytes>, seen: Map<Bytes, Int> }

/// The table of the runs in `text`. Each run's value is what `value` returns for its fields, and a
/// code point in no run has the value `missing`. Raises where `runs` or `value` raises, and for
/// more than 65536 distinct values. Its cost grows with the number of runs and of distinct blocks,
/// so call it in a `const`.
pub fn table(
  text: Bytes,
  missing: Int,
  value: (List<Bytes>) -> Int / {abort.raise},
) -> Table / {abort.raise} =
  table_of(
    runs(text).map(|run: Run| { first: run.first, last: run.last, value: value(run.fields) }),
    missing,
  )

/// Returns the table that stores each value in `valued` for its run, and `missing` for a code point
/// in no run. Use it instead of `table` when a value depends on more than one line, such as an
/// index into data gathered from every line. Raises for runs out of order or overlapping, for a run
/// past `U+10FFFF`, and for more than 65536 distinct values.
pub fn table_of(valued: List<ValueRun>, missing: Int) -> Table / {abort.raise} = {
  let spans = covering(valued, missing);
  let known = number_values(spans);
  if known.values.len() > 65536 { panic("a table holds at most 65536 distinct values") } else {
    let numbers = Bytes::concat_all(
      spans.map(|span: Span|
        match known.ids.get(span.value) {
          Some(id) -> repeated(u16_be(id), span.count),
          None ->
            panic("a value in the table was not given a number when the values were numbered"),
        }),
    );
    let cut = range(0, 4352).fold(
      { index: [], blocks: [], seen: Map::new() },
      |accumulator: BlockState, i: Int| {
        let block = numbers.slice(i * 512, i * 512 + 512);
        match accumulator.seen.get(block) {
          Some(at) ->
            {
              index: accumulator.index.push(at),
              blocks: accumulator.blocks,
              seen: accumulator.seen,
            },
          None ->
            {
              index: accumulator.index.push(accumulator.blocks.len()),
              blocks: accumulator.blocks.push(block),
              seen: accumulator.seen.insert(block, accumulator.blocks.len()),
            },
        }
      },
    );
    let block_bytes = Bytes::concat_all(cut.blocks);
    let values = Array::of_list(known.values);
    {
      index: Array::of_list(cut.index),
      blocks: Array::of_list(
        range(0, block_bytes.len() / 2).map(|i: Int|
          values.get(block_bytes.at(2 * i) << 8 | block_bytes.at(2 * i + 1))),
      ),
      missing: missing,
    }
  }
}

/// The code points a field lists, each in hexadecimal, separated by spaces. Empty for an empty
/// field. Raises for a field that contains anything else.
pub fn code_points(field: Bytes) -> List<Int> / {abort.raise} =
  field.split(b" ").filter(|part: Bytes| part.len() > 0).map(|part: Bytes|
    match part.int_of_ascii_radix(16) {
      Some(point) -> if point < 0 || point > 0x10FFFF {
        panic(line_error(field, "lists no code points"))
      } else { point },
      None -> panic(line_error(field, "lists no code points")),
    })

/// The distance from a code point to its mapping, parsed from a table's decimal text, with a `-`
/// for a mapping below. Returns twenty bits in two's complement, which a value can store beside
/// other fields and `apply_distance` reads. An empty text is `0`. Raises for any other text, and
/// for a distance past `2^19`.
pub fn parse_offset(text: Bytes) -> Int / {abort.raise} =
  if text.len() == 0 { 0 } else {
    match text.int_of_ascii() {
      Some(d) -> if d < -0x80000 || d > 0x7FFFF {
        panic(line_error(text, "is not a decimal integer from -524288 to 524287"))
      } else { d & 0xFFFFF },
      None -> panic(line_error(text, "is not a decimal integer from -524288 to 524287")),
    }
  }

/// Returns the code point at a signed distance from `cp`. The distance is stored in the low twenty
/// bits of `held`.
pub fn apply_distance(code_point: Int, distance: Int) -> Int =
  code_point + (distance & 0xFFFFF ^ 0x80000) - 0x80000

/// Sequences of code points stored end to end, for a table whose values are sequences. The table
/// stores the place `intern` returns, and `sequence` reads the sequence back from it.
pub type SequencePool = {
  /// Every sequence stored, one after another.
  points: List<Int>,
  /// Where each distinct sequence was stored, so that a sequence added twice is stored once.
  places: Map<List<Int>, Int>,
}

/// A pool with no sequences.
pub const empty_pool: SequencePool = { points: [], places: Map::new() }

/// Returns `so_far` with `sequence` added, and the place of `sequence` in it. The place is the
/// index where the sequence starts, shifted left five bits, with the sequence's length in the low
/// five bits. So a non-empty sequence never has place zero, which is the place of the empty
/// sequence. Raises for a sequence of more than 31 code points.
pub fn intern(
  so_far: SequencePool,
  sequence: List<Int>,
) -> { gathering: SequencePool, place: Int } / {abort.raise} =
  if sequence.len() > 31 { panic("a mapping in a Unicode data table has at most 31 code points") }
  else if sequence.len() == 0 { { gathering: so_far, place: 0 } } else {
    match so_far.places.get(sequence) {
      Some(place) -> { gathering: so_far, place: place },
      None -> {
        let place = so_far.points.len() << 5 | sequence.len();
        {
          gathering: {
            points: sequence.fold(so_far.points, |all: List<Int>, code_point: Int|
              all.push(code_point)),
            places: so_far.places.insert(sequence, place),
          },
          place: place,
        }
      },
    }
  }

/// The sequence at `place` among the stored `code_points`. Empty for a place of zero.
pub fn sequence(code_points: Array<Int>, place: Int) -> List<Int> =
  range(place >> 5, (place >> 5) + (place & 31)).fold([], |found: List<Int>, i: Int|
    match code_points.at(i) { Some(code_point) -> found.push(code_point), None -> found })

/// Returns the value `held` stores for the code point `cp`, or the table's missing value when `cp`
/// is not a code point. Always does two array reads, whatever `cp` is.
pub fn lookup(table: Table, code_point: Int) -> Int
  cost 1
=
  match table.index.at(code_point >> 8) {
    Some(block) -> match table.blocks.at(block << 8 | code_point & 255) {
      Some(value) -> value,
      None -> table.missing,
    },
    None -> table.missing,
  }

fn text_of(lines: List<String>) -> Bytes =
  Bytes::concat_all(
    [String::of_bytes_lossy(version_line)].concat(lines).map(|line: String|
      Bytes::of_string(line ++ "\n")),
  )

const letters: Bytes =
  text_of(["# a comment", "0041..005A;Lu;AU", "0061;Ll", "10FFFE..10FFFF;Co;;7"])

test "`runs` parses each table line into a range of code points with its fields, and skips comments" {
  assert_eq(runs(letters), [
    { first: 0x41, last: 0x5A, fields: [b"Lu", b"AU"] },
    { first: 0x61, last: 0x61, fields: [b"Ll"] },
    { first: 0x10FFFE, last: 0x10FFFF, fields: [b"Co", b"", b"7"] },
  ]);
  assert_eq(runs(text_of([])), [])
}

type InvalidLineCase = { line: String, reason: String }

const invalid_lines: List<InvalidLineCase> =
  [
    { line: "0041", reason: "`0041` holds no field" },
    { line: ";Lu", reason: "`;Lu` is not a code point or a range of code points" },
    {
      line: "0041..005A..0060;Lu",
      reason: "`0041..005A..0060;Lu` is not a code point or a range of code points",
    },
    { line: "004G;Lu", reason: "`004G;Lu` is not a code point or a range of code points" },
    { line: "0041 ;Lu", reason: "`0041 ;Lu` is not a code point or a range of code points" },
    { line: "110000;Cn", reason: "`110000;Cn` is past U+10FFFF" },
    { line: "-0041;Lu", reason: "`-0041;Lu` is not a code point or a range of code points" },
    { line: "005A..0041;Lu", reason: "`005A..0041;Lu` has a range that ends before it starts" },
    {
      line: "0030;Nd",
      reason: "`0030;Nd` has a range that must start after the previous line's range ends",
    },
    {
      line: "005A;Lu",
      reason: "`005A;Lu` has a range that must start after the previous line's range ends",
    },
  ]

test "`runs` rejects the line {c.line} after the valid line 0041..005A, with the error the case lists" for c: InvalidLineCase in invalid_lines {
  assert_eq(try[abort.raise] { runs(text_of(["0041..005A;Lu", c.line])) }, Err(c.reason))
}

test "a table of another version, or with no version, is rejected" {
  let expected_error = Err("a table opens with `# Unicode 17.0.0`");
  assert_eq(try[abort.raise] { runs(b"# Unicode 16.0.0\n0041;Lu\n") }, expected_error);
  assert_eq(try[abort.raise] { runs(b"0041;Lu\n") }, expected_error);
  assert_eq(try[abort.raise] { runs(b"") }, expected_error)
}

fn first_byte(fields: List<Bytes>) -> Int / {abort.raise} =
  match fields { [field, ..] -> field.at(0), [] -> panic("no field") }

test "`lookup` returns the value of the range containing a code point, and the default value elsewhere" {
  let letters_table = table(letters, -1, first_byte);
  assert_eq(
    [0, 0x40, 0x41, 0x5A, 0x5B, 0x60, 0x61, 0x62, 0xFFFF, 0x10FFFD, 0x10FFFE, 0x10FFFF].map(
      |code_point: Int| lookup(letters_table, code_point),
    ),
    [-1, -1, 76, 76, -1, -1, 76, -1, -1, -1, 67, 67],
  );
  assert_eq([-1, -256, 0x110000, 9223372036854775807].map(|n: Int| lookup(letters_table, n)), [
    -1,
    -1,
    -1,
    -1,
  ])
}

fn distinct_blocks_table(count: Int) -> Bytes / {abort.raise} =
  text_of(
    range(0, count).map(|i: Int|
      f"{u32_be(i * 257).hex_of()}..{u32_be(i * 257 + 255).hex_of()};{i}"),
  )

fn number(fields: List<Bytes>) -> Int / {abort.raise} =
  match fields {
    [field] -> match field.int_of_ascii_radix(10) { Some(n) -> n, None -> panic("no number") },
    _ -> panic("one field"),
  }

test "`lookup` returns the right value for every code point in a table with more distinct values than fit in a byte" {
  let block_table = table(distinct_blocks_table(1200), -7, number);
  let wrong = range(0, 1200 * 257 + 600).filter(|code_point: Int|
    lookup(block_table, code_point)
      != (if code_point >= 1200 * 257 || code_point % 257 == 256 { -7 } else { code_point / 257 }));
  assert_eq(wrong, [])
}

test "`table_of` builds a lookup table from value ranges, and rejects ranges that overlap or run backward" {
  let range_table = table_of(
    [{ first: 0x41, last: 0x5A, value: 7 }, { first: 0x61, last: 0x61, value: 9 }],
    0,
  );
  assert_eq(
    [0x40, 0x41, 0x5A, 0x5B, 0x61, 0x62].map(|code_point: Int| lookup(range_table, code_point)),
    [0, 7, 7, 0, 9, 0],
  );
  let expected_error = Err(
    "a table's ranges must be in ascending order, must not overlap and must end at or before U+10FFFF",
  );
  let made = |runs: List<ValueRun>| try[abort.raise] { lookup(table_of(runs, 0), 0) };
  assert_eq(
    made([{ first: 5, last: 9, value: 1 }, { first: 9, last: 12, value: 2 }]),
    expected_error,
  );
  assert_eq(made([{ first: 5, last: 4, value: 1 }]), expected_error);
  assert_eq(made([{ first: 0x10FFFF, last: 0x110000, value: 1 }]), expected_error)
}

test "`code_points` parses a field of hex code points, and rejects a field containing anything else" {
  assert_eq(code_points(b"0041 0300  10FFFF"), [0x41, 0x300, 0x10FFFF]);
  assert_eq(code_points(b""), []);
  assert_eq(try[abort.raise] { code_points(b"0041 x") }, Err("`0041 x` lists no code points"));
  assert_eq(try[abort.raise] { code_points(b"110000") }, Err("`110000` lists no code points"))
}

test "`intern` stores a code point sequence and returns its position, and adding the same sequence twice stores it once" {
  let one = intern(empty_pool, [0x73, 0x73]);
  let two = intern(one.gathering, [0x66, 0x66, 0x69]);
  let again = intern(two.gathering, [0x73, 0x73]);
  let stored_points = Array::of_list(again.gathering.points);
  assert_eq(stored_points.len(), 5);
  assert_eq(again.place, one.place);
  assert_eq(sequence(stored_points, one.place), [0x73, 0x73]);
  assert_eq(sequence(stored_points, two.place), [0x66, 0x66, 0x69]);
  assert_eq(sequence(stored_points, 0), []);
  assert_eq(intern(again.gathering, []).place, 0);
  assert_eq(
    [b"", b"0", b"32", b"-32"].map(|text: Bytes| apply_distance(100, parse_offset(text))),
    [100, 100, 132, 68],
  );
  assert_eq(
    try[abort.raise] { intern(empty_pool, range(0, 32)).place },
    Err("a mapping in a Unicode data table has at most 31 code points"),
  )
}

test "the licence shipped is the Unicode License v3" {
  assert(license.starts_with("UNICODE LICENSE V3\n"));
  assert(license.contains("COPYRIGHT AND PERMISSION NOTICE"))
}
