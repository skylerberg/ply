//! Observability as an effect: events, spans and metrics, each written to a channel named by the
//! label `c` on the effect's operations.
//!
//! Each record is written when its operation is performed. A span still open when its task finishes
//! or its entry point ends is closed as `Abandoned`, innermost first, and written. The run then
//! warns (`W0609`), but its exit code does not change. A test collects records in a `Sink` and
//! reads them with `drain`, `named`, `on_channel` and `counter_total`.

import std.bytes (i64_be)
import std.internal.native (native, encode_parts)
import std.json

/// An event's severity.
pub type Level = | Debug | Info | Warn | Error

/// One structured value.
pub type Field =
  | IntField(Int)
  | BoolField(Bool)
  | StringField(String)
  | FloatField(Float)
  | DecimalField(Decimal)
  | BytesField(Bytes)
  | JsonField(json::Json)

/// A `Map`, so two field sets built in different orders are equal.
pub type Fields = Map<String, Field>

/// Identifies a span by its `id` and the `channel` it was opened on.
pub type Span = { id: Int, channel: String }

/// How a span ended.
pub type Outcome = | Ok | Failed(String) | Abandoned

/// Writes structured trace records (events, spans and metrics). The label in brackets, such as
/// `trace.event[orders]`, names the channel: a string that tags each record so a reader can select
/// the records from one part of the program.
pub nondet effect trace {
  /// Records one event with a severity `level`, a `name` and extra `fields`, inside the innermost
  /// open span.
  write event[c](level: Level, name: String, fields: Fields) -> Unit
  /// Opens a span inside the innermost open span.
  write enter[c](name: String, fields: Fields) -> Span
  /// Closes a span with how it ended, and every span opened inside it that is still open.
  write exit[c](span: Span, outcome: Outcome) -> Unit
  /// Adds `delta` to a counter.
  write count[c](name: String, delta: Int, fields: Fields) -> Unit
  /// Records the current `value` of a measurement that can go up or down, such as a queue length,
  /// under `name`.
  write gauge[c](name: String, value: Decimal, fields: Fields) -> Unit
  /// Records a duration in microseconds.
  write time[c](name: String, micros: Int, fields: Fields) -> Unit
}

host for trace by host_handler

fn host_handler<a | e>(go: () -> a / {trace.write[*] | e}) -> a / {native.read, abort.raise | e} =
  handle {
    go()
  } with {
    trace.event[*channel](level, name, fields) -> {
      let at = level_number(level);
      if trace_wants(at) { trace_record(0, channel, at, name, 0, "", encode_fields(fields)) }
    },
    trace.enter[*channel](name, fields) ->
      { id: trace_enter(channel, name, encode_fields(fields)), channel: channel },
    trace.exit[*channel](span, outcome) -> match outcome {
      Ok -> trace_exit(channel, span.id, 0, ""),
      Failed(reason) -> trace_exit(channel, span.id, 1, reason),
      Abandoned -> trace_exit(channel, span.id, 2, ""),
    },
    trace.count[*channel](name, delta, fields) -> metric(1, channel, name, delta, "", fields),
    trace.gauge[*channel](name, value, fields) ->
      metric(2, channel, name, 0, value.to_string(), fields),
    trace.time[*channel](name, micros, fields) -> metric(3, channel, name, micros, "", fields),
  }

extern fn trace_wants(level: Int) -> Bool / {native.read}

extern fn trace_record(
  kind: Int,
  channel: String,
  level: Int,
  name: String,
  amount: Int,
  value: String,
  fields: Bytes,
) -> Unit / {native.read}

extern fn trace_enter(channel: String, name: String, fields: Bytes) -> Int / {native.read}

extern fn trace_exit(channel: String, id: Int, outcome: Int, reason: String) -> Unit / {native.read}

fn metric(
  kind: Int,
  channel: String,
  name: String,
  amount: Int,
  value: String,
  fields: Fields,
) -> Unit / {native.read, abort.raise} =
  if trace_wants(1) { trace_record(kind, channel, 1, name, amount, value, encode_fields(fields)) }

fn level_number(level: Level) -> Int = match level { Debug -> 0, Info -> 1, Warn -> 2, Error -> 3 }

fn encode_fields(fields: Fields) -> Bytes / {abort.raise} =
  encode_parts(
    fields.fold([], |accumulator: List<Bytes>, name: String, field: Field|
      accumulator.push(Bytes::of_string(name)).push(encode_field(field))),
  )

fn encode_field(field: Field) -> Bytes / {abort.raise} =
  match field {
    IntField(n) -> b"\x00".concat(i64_be(n)),
    BoolField(on) -> if on { b"\x01\x01" } else { b"\x01\x00" },
    StringField(text) -> b"\x02".concat(Bytes::of_string(text)),
    FloatField(x) -> b"\x03".concat(i64_be(bits_of_float(x))),
    DecimalField(d) -> b"\x04".concat(Bytes::of_string(d.to_string())),
    BytesField(b) -> b"\x05".concat(b),
    JsonField(j) -> b"\x06".concat(json::to_bytes(j)),
  }

/// Which operation wrote a record.
pub type Kind = | Event | Enter | Exit | Count | Gauge | Timing

/// One collected record. `span` is the record's span; for an event or a metric, that is the
/// innermost open span. `parent` is that span's parent.
pub type Record = {
  sequence: Int,
  kind: Kind,
  level: Level,
  channel: String,
  name: String,
  span: Int,
  parent: Int,
  fields: Fields,
  outcome: Outcome,
  amount: Int,
  value: Decimal,
}

type OpenSpan = { id: Int, channel: String, name: String, parent: Int }

/// The records a test has collected, and the spans still open.
pub type Sink = { records: List<Record>, open: List<OpenSpan>, next: Int }

/// An empty sink.
pub const sink: Sink = { records: [], open: [], next: 1 }

/// The sink after `enter_step`, and the span it opened.
pub type EnterResult = { sink: Sink, span: Span }

/// The sink after `exit_step`; `ok` is false when the span was not open.
pub type ExitResult = { sink: Sink, ok: Bool }

/// The sink after recording a `trace.event`.
pub fn event_step(s: Sink, c: String, l: Level, n: String, field_values: Fields) -> Sink =
  append(s, record(s, Event, l, c, n, innermost(s), field_values, Ok, 0, 0m))

/// The sink after recording a `trace.count`.
pub fn count_step(s: Sink, c: String, n: String, d: Int, field_values: Fields) -> Sink =
  append(s, record(s, Count, Info, c, n, innermost(s), field_values, Ok, d, 0m))

/// The sink after recording a `trace.gauge`.
pub fn gauge_step(s: Sink, c: String, n: String, v: Decimal, field_values: Fields) -> Sink =
  append(s, record(s, Gauge, Info, c, n, innermost(s), field_values, Ok, 0, v))

/// The sink after recording a `trace.time`.
pub fn time_step(s: Sink, c: String, n: String, microseconds: Int, field_values: Fields) -> Sink =
  append(s, record(s, Timing, Info, c, n, innermost(s), field_values, Ok, microseconds, 0m))

/// The sink after recording a `trace.enter`, and the span it opened.
pub fn enter_step(s: Sink, c: String, n: String, field_values: Fields) -> EnterResult = {
  let opened = { id: s.next, channel: c, name: n, parent: current_id(s) };
  let pushed = { records: s.records, open: cons(opened, s.open), next: s.next + 1 };
  {
    sink: append(pushed, record(pushed, Enter, Info, c, n, Some(opened), field_values, Ok, 0, 0m)),
    span: { id: opened.id, channel: c },
  }
}

/// Closes `trace_span` with outcome `o`, and closes every span opened inside it as `Abandoned`.
pub fn exit_step(s: Sink, trace_span: Span, o: Outcome) -> ExitResult =
  if is_open(s.open, trace_span) { { sink: close_through(s, trace_span.id, o), ok: true } }
  else { { sink: s, ok: false } }

/// Closes every still-open span as `Abandoned`, then returns the records in `sequence` order.
pub fn drain(s: Sink) -> List<Record> = close_open_spans(s).records

/// How many spans are open.
pub fn open_spans(s: Sink) -> Int = s.open.len()

/// The records named `n`.
pub fn named(record_list: List<Record>, n: String) -> List<Record> =
  record_list.filter(|r: Record| r.name == n)

/// The records on channel `c`.
pub fn on_channel(record_list: List<Record>, c: String) -> List<Record> =
  record_list.filter(|r: Record| r.channel == c)

/// The sum of every count recorded under `n`.
pub fn counter_total(record_list: List<Record>, n: String) -> Int =
  record_list.fold(0, |accumulator: Int, r: Record|
    match r.kind {
      Count -> if r.name == n { accumulator + r.amount } else { accumulator },
      _ -> accumulator,
    })

reuse fn cons<a>(x: a, xs: List<a>) -> List<a> =
  xs.fold([].push(x), |accumulator: List<a>, y: a| accumulator.push(y))

fn append(s: Sink, r: Record) -> Sink = { open: s.open, next: s.next, records: s.records.push(r) }

fn record(
  s: Sink,
  k: Kind,
  l: Level,
  c: String,
  n: String,
  at: Option<OpenSpan>,
  field_values: Fields,
  o: Outcome,
  amount: Int,
  value: Decimal,
) -> Record =
  {
    sequence: s.records.len() + 1,
    kind: k,
    level: l,
    channel: c,
    name: n,
    span: match at { Some(open) -> open.id, None -> 0 },
    parent: match at { Some(open) -> open.parent, None -> 0 },
    fields: field_values,
    outcome: o,
    amount: amount,
    value: value,
  }

fn innermost(s: Sink) -> Option<OpenSpan> = match s.open { [first, ..] -> Some(first), _ -> None }

fn current_id(s: Sink) -> Int = match s.open { [first, ..] -> first.id, _ -> 0 }

fn is_open(spans: List<OpenSpan>, trace_span: Span) -> Bool =
  match spans {
    [] -> false,
    [first, ..rest] -> if first.id == trace_span.id { first.channel == trace_span.channel }
    else { is_open(rest, trace_span) },
  }

fn close_through(s: Sink, id: Int, o: Outcome) -> Sink = close_spans(s, s.open, id, o)

fn close_spans(s: Sink, open: List<OpenSpan>, id: Int, o: Outcome) -> Sink =
  match open {
    [] -> s,
    [first, ..rest] -> {
      let popped = { records: s.records, open: rest, next: s.next };
      let outcome = if first.id == id { o } else { Abandoned };
      let closed = append(
        popped,
        record(
          popped,
          Exit,
          Info,
          first.channel,
          first.name,
          Some(first),
          Map::new(),
          outcome,
          0,
          0m,
        ),
      );
      if first.id == id { closed } else { close_spans(closed, rest, id, o) }
    },
  }

fn close_open_spans(s: Sink) -> Sink = abandon_spans(s, s.open)

fn abandon_spans(s: Sink, open: List<OpenSpan>) -> Sink =
  match open {
    [] -> s,
    [first, ..rest] -> abandon_spans(close_through(s, first.id, Abandoned), rest),
  }

fn one_field(k: String, v: Field) -> Fields = Map::new().insert(k, v)

fn place_order(
  sku: String,
) -> Unit / {trace.enter[orders], trace.count[orders], trace.exit[orders]} = {
  let span = trace.enter[orders]("place_order", one_field("sku", StringField(sku)));
  trace.count[orders]("orders_placed", 1, Map::new());
  trace.exit[orders](span, Ok)
}

fn kinds(record_list: List<Record>) -> List<Kind> = record_list.map(|r: Record| r.kind)

fn span_ids(record_list: List<Record>) -> List<Int> = record_list.map(|r: Record| r.span)

fn parents(record_list: List<Record>) -> List<Int> = record_list.map(|r: Record| r.parent)

fn outcomes(record_list: List<Record>) -> List<Outcome> = record_list.map(|r: Record| r.outcome)

fn record_names(record_list: List<Record>) -> List<String> = record_list.map(|r: Record| r.name)

test "a collecting handler handles every operation this test performs" {
  let record_list = handle {
    place_order("BOLT-1")
  } with {
    var s = sink,
    trace.enter[orders](n, field_values) -> {
      let out = enter_step(s, "orders", n, field_values);
      s = out.sink;
      out.span
    },
    trace.exit[orders](trace_span, o) -> {
      let out = exit_step(s, trace_span, o);
      s = out.sink;
      assert(out.ok)
    },
    trace.count[orders](n, d, field_values) -> {
      s = count_step(s, "orders", n, d, field_values);
    },
    return place_order -> drain(s),
  };
  assert_eq(kinds(record_list), [Enter, Count, Exit]);
  assert_eq(record_names(record_list), ["place_order", "orders_placed", "place_order"]);
  assert_eq(counter_total(record_list, "orders_placed"), 1);
  assert_eq(on_channel(record_list, "items"), [])
}

test "a span nested in a span links to its parent, and closing is innermost first" {
  let outer = enter_step(sink, "http", "request", Map::new());
  let inner = enter_step(outer.sink, "http", "query", Map::new());
  let closed_inner = exit_step(inner.sink, inner.span, Ok);
  let closed_outer = exit_step(closed_inner.sink, outer.span, Ok);
  assert(closed_inner.ok);
  assert(closed_outer.ok);
  let record_list = drain(closed_outer.sink);
  assert_eq(span_ids(record_list), [1, 2, 2, 1]);
  assert_eq(parents(record_list), [0, 1, 1, 0]);
  assert_eq(kinds(record_list), [Enter, Enter, Exit, Exit]);
  assert_eq(outcomes(record_list), [Ok, Ok, Ok, Ok])
}

test "an event inside a span carries the span it was recorded in" {
  let outer = enter_step(sink, "http", "request", Map::new());
  let noted = event_step(outer.sink, "http", Warn, "slow", Map::new());
  assert_eq(span_ids(drain(noted)), [1, 1, 1]);
  assert_eq(named(drain(noted), "slow").map(|r: Record| r.level), [Warn])
}

test "`exit_step` on an outer span also closes the still-open spans entered inside it, giving them the outcome `Abandoned`" {
  let outer = enter_step(sink, "orders", "place_order", Map::new());
  let inner = enter_step(outer.sink, "orders", "reserve", Map::new());
  let deeper = enter_step(inner.sink, "orders", "charge", Map::new());
  let closed = exit_step(deeper.sink, outer.span, Failed("rolled back"));
  assert(closed.ok);
  let record_list = drain(closed.sink);
  assert_eq(kinds(record_list), [Enter, Enter, Enter, Exit, Exit, Exit]);
  assert_eq(span_ids(record_list), [1, 2, 3, 3, 2, 1]);
  assert_eq(outcomes(record_list), [Ok, Ok, Ok, Abandoned, Abandoned, Failed("rolled back")])
}

test "`drain` closes spans that were never closed with the outcome `Abandoned`, the most recently entered first" {
  let outer = enter_step(sink, "http", "request", Map::new());
  let inner = enter_step(outer.sink, "http", "query", Map::new());
  assert_eq(open_spans(inner.sink), 2);
  let record_list = drain(inner.sink);
  assert_eq(kinds(record_list), [Enter, Enter, Exit, Exit]);
  assert_eq(span_ids(record_list), [1, 2, 2, 1]);
  assert_eq(outcomes(record_list), [Ok, Ok, Abandoned, Abandoned])
}

test "an exit naming a span that is not open returns false and records nothing" {
  let opened = enter_step(sink, "http", "request", Map::new());
  let closed = exit_step(opened.sink, opened.span, Ok);

  let twice = exit_step(closed.sink, opened.span, Ok);
  assert(!twice.ok);
  assert_eq(drain(twice.sink).len(), 2);

  let never = exit_step(closed.sink, { id: 41, channel: "http" }, Ok);
  assert(!never.ok);

  let elsewhere = exit_step(opened.sink, { id: opened.span.id, channel: "orders" }, Ok);
  assert(!elsewhere.ok)
}

test "ids ascend and are never reused, across sibling spans" {
  let first = enter_step(sink, "http", "a", Map::new());
  let closed = exit_step(first.sink, first.span, Ok);
  let second = enter_step(closed.sink, "http", "b", Map::new());
  assert_eq(first.span.id, 1);
  assert_eq(second.span.id, 2);
  assert_eq(second.span.channel, "http")
}

test "a metric is a record like any other, and a total is a fold over them" {
  let s = count_step(sink, "orders", "placed", 2, Map::new());
  let s2 = count_step(s, "orders", "placed", 3, Map::new());
  let s3 = gauge_step(s2, "orders", "shelf", 41.75m, Map::new());
  let s4 = time_step(s3, "orders", "place_order", 8213, Map::new());
  let record_list = drain(s4);
  assert_eq(counter_total(record_list, "placed"), 5);
  assert_eq(counter_total(record_list, "nothing"), 0);
  assert_eq(kinds(record_list), [Count, Count, Gauge, Timing]);
  assert_eq(named(record_list, "shelf").map(|r: Record| r.value), [41.75m]);
  assert_eq(named(record_list, "place_order").map(|r: Record| r.amount), [8213])
}

test "event fields are stored as a map, so two field sets inserted in different orders are equal" {
  let one = Map::new().insert("sku", StringField("BOLT-1")).insert("n", IntField(2));
  let other = Map::new().insert("n", IntField(2)).insert("sku", StringField("BOLT-1"));
  let s = event_step(sink, "orders", Info, "placed", one);
  assert_eq(drain(s).map(|r: Record| r.fields), [other])
}

test "`sequence` is the total order in which the sink returns records" {
  let a = event_step(sink, "http", Info, "one", Map::new());
  let b = count_step(a, "http", "two", 1, Map::new());
  let c = enter_step(b, "http", "three", Map::new());
  assert_eq(drain(c.sink).map(|r: Record| r.sequence), [1, 2, 3, 4])
}
