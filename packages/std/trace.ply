//! Observability as an effect: events, spans and metrics, each on a channel label.
//!
//! Every perform is written at its call site. A span still open when its task retires or its entry
//! point ends is closed `Abandoned`, innermost first, and written; the run warns of it (`W0609`), which
//! changes no exit code. A test collects records in a `Sink` with the `_step` functions and reads them
//! with `drain`, `named`, `on_channel` and `counter_total`.

import std.bytes (i64_be)
import std.internal.native (native, in_parts)
import std.json

/// An event's severity.
pub type Level = | Debug | Info | Warn | Error

/// One structured value.
pub type Field =
  | FInt(Int)
  | FBool(Bool)
  | FText(String)
  | FFloat(Float)
  | FDecimal(Decimal)
  | FBytes(Bytes)
  | FJson(json::Json)

/// A `Map`, so two field sets built in different orders are equal.
pub type Fields = Map<String, Field>

/// A span's identity.
pub type Span = { id: Int, channel: String }

/// How a span ended.
pub type Outcome = | Ok | Failed(String) | Abandoned

/// Structured records, on the channel the label names.
pub nondet effect trace {
  /// One event.
  write event[c](level: Level, name: String, fields: Fields) -> Unit
  /// Opens a span, inside the innermost one open.
  write enter[c](name: String, fields: Fields) -> Span
  /// Closes a span with how it ended, and every span opened inside it that is still open.
  write exit[c](span: Span, outcome: Outcome) -> Unit
  /// Adds `delta` to a counter.
  write count[c](name: String, delta: Int, fields: Fields) -> Unit
  /// Sets a gauge.
  write gauge[c](name: String, value: Decimal, fields: Fields) -> Unit
  /// Records a duration in microseconds.
  write time[c](name: String, micros: Int, fields: Fields) -> Unit
}

// --- The real handler ------------------------------------------------------------

host for trace by served

/// `go` with every record written to the run's sink, a record the sink does not want costing no
/// more than the asking, and each span kept open for the task that opened it until it is closed.
fn served<a | e>(go: () -> a / {trace.write[*] | e}) -> a / {native.read, abort.raise | e} =
  handle {
    go()
  } with {
    trace.event[*channel](level, name, fields) -> {
      let at = level_number(level);
      if trace_wants(at) { trace_record(0, channel, at, name, 0, "", fields_written(fields)) }
    },
    trace.enter[*channel](name, fields) ->
      { id: trace_enter(channel, name, fields_written(fields)), channel: channel },
    trace.exit[*channel](span, outcome) -> match outcome {
      Ok -> trace_exit(channel, span.id, 0, ""),
      Failed(reason) -> trace_exit(channel, span.id, 1, reason),
      Abandoned -> trace_exit(channel, span.id, 2, ""),
    },
    trace.count[*channel](name, delta, fields) -> metric(1, channel, name, delta, "", fields),
    trace.gauge[*channel](name, value, fields) ->
      metric(2, channel, name, 0, value.to_string(), fields),
    trace.time[*channel](name, micros, fields) -> metric(3, channel, name, micros, "", fields),
  }

/// Whether the run's sink writes a record at the level `level_number` numbers.
extern fn trace_wants(level: Int) -> Bool / {native.read}

/// One record on `channel` of the kind numbered `kind`, `event` 0, `count` 1, `gauge` 2 and `time`
/// 3: a count's delta or a time's microseconds in `amount`, and a gauge's value as decimal text.
extern fn trace_record(
  kind: Int,
  channel: String,
  level: Int,
  name: String,
  amount: Int,
  value: String,
  fields: Bytes,
) -> Unit / {native.read}

/// Opens a span on `channel` inside the innermost one the asking task has open, answering its id.
extern fn trace_enter(channel: String, name: String, fields: Bytes) -> Int / {native.read}

/// Closes span `id` on `channel` with the outcome numbered `outcome`, `Ok` 0, `Failed` 1 for
/// `reason` and `Abandoned` 2, and every span opened inside it. One that is not open ends the run.
extern fn trace_exit(channel: String, id: Int, outcome: Int, reason: String) -> Unit / {native.read}

/// A metric, written at `Info` where the sink wants that.
fn metric(
  kind: Int,
  channel: String,
  name: String,
  amount: Int,
  value: String,
  fields: Fields,
) -> Unit / {native.read, abort.raise} =
  if trace_wants(1) { trace_record(kind, channel, 1, name, amount, value, fields_written(fields)) }

fn level_number(level: Level) -> Int = match level { Debug -> 0, Info -> 1, Warn -> 2, Error -> 3 }

/// Fields as the natives read them: parts, each name and then its field.
fn fields_written(fields: Fields) -> Bytes / {abort.raise} =
  in_parts(
    fields.fold([], |acc: List<Bytes>, name: String, field: Field|
      acc.push(Bytes::of_string(name)).push(field_written(field))),
  )

/// A field as its kind's byte and what it holds: a number in eight bytes, a flag in one, and a
/// decimal or JSON as its text.
fn field_written(field: Field) -> Bytes / {abort.raise} =
  match field {
    FInt(n) -> b"\x00".concat(i64_be(n)),
    FBool(on) -> if on { b"\x01\x01" } else { b"\x01\x00" },
    FText(text) -> b"\x02".concat(Bytes::of_string(text)),
    FFloat(x) -> b"\x03".concat(i64_be(bits_of_float(x))),
    FDecimal(d) -> b"\x04".concat(Bytes::of_string(d.to_string())),
    FBytes(b) -> b"\x05".concat(b),
    FJson(j) -> b"\x06".concat(json::to_bytes(j)),
  }

// --- The collecting twin ---------------------------------------------------------

/// Which operation wrote a record.
pub type Kind = | KEvent | KEnter | KExit | KCount | KGauge | KTime

/// `span` is the record's span (for an event or a metric, the innermost one open); `parent` is its parent.
pub type Record = {
  seq: Int,
  kind: Kind,
  level: Level,
  channel: String,
  name: String,
  span: Int,
  parent: Int,
  fields: Fields,
  outcome: Outcome,
  amount: Int,
  value: Decimal,
}

/// Innermost first, so pushing and popping are both at the head.
type OpenSpan = { id: Int, channel: String, name: String, parent: Int }

/// The records a test has collected, and the spans still open.
pub type Sink = { records: List<Record>, open: List<OpenSpan>, next: Int }

/// An empty sink.
pub fn sink() -> Sink = { records: [], open: [], next: 1 }

/// The sink after `enter_step`, and the span it opened.
pub type Entered = { sink: Sink, span: Span }

/// The sink after `exit_step`; `ok` is false when the span was not open.
pub type Exited = { sink: Sink, ok: Bool }

/// What `trace.event` records.
pub fn event_step(s: Sink, c: String, l: Level, n: String, fs: Fields) -> Sink =
  append(s, record(s, KEvent, l, c, n, innermost(s), fs, Ok, 0, 0m))

/// What `trace.count` records.
pub fn count_step(s: Sink, c: String, n: String, d: Int, fs: Fields) -> Sink =
  append(s, record(s, KCount, Info, c, n, innermost(s), fs, Ok, d, 0m))

/// What `trace.gauge` records.
pub fn gauge_step(s: Sink, c: String, n: String, v: Decimal, fs: Fields) -> Sink =
  append(s, record(s, KGauge, Info, c, n, innermost(s), fs, Ok, 0, v))

/// What `trace.time` records.
pub fn time_step(s: Sink, c: String, n: String, us: Int, fs: Fields) -> Sink =
  append(s, record(s, KTime, Info, c, n, innermost(s), fs, Ok, us, 0m))

/// What `trace.enter` records.
pub fn enter_step(s: Sink, c: String, n: String, fs: Fields) -> Entered = {
  let opened = { id: s.next, channel: c, name: n, parent: current_id(s) };
  let pushed = { records: s.records, open: cons(opened, s.open), next: s.next + 1 };
  {
    sink: append(pushed, record(pushed, KEnter, Info, c, n, Some(opened), fs, Ok, 0, 0m)),
    span: { id: opened.id, channel: c },
  }
}

/// Closes `sp` and every span opened above it, each of the latter `Abandoned`.
pub fn exit_step(s: Sink, sp: Span, o: Outcome) -> Exited =
  if is_open(s.open, sp) { { sink: close_through(s, sp.id, o), ok: true } }
  else { { sink: s, ok: false } }

/// Closes every still-open span as `Abandoned`, then answers the records in `seq` order.
pub fn drain(s: Sink) -> List<Record> = abandon_all(s).records

/// How many spans are open.
pub fn open_spans(s: Sink) -> Int = s.open.len()

/// The records named `n`.
pub fn named(rs: List<Record>, n: String) -> List<Record> = rs.filter(|r: Record| r.name == n)

/// The records on channel `c`.
pub fn on_channel(rs: List<Record>, c: String) -> List<Record> =
  rs.filter(|r: Record| r.channel == c)

/// The sum of every count recorded under `n`.
pub fn counter_total(rs: List<Record>, n: String) -> Int =
  rs.fold(0, |acc: Int, r: Record|
    match r.kind { KCount -> if r.name == n { acc + r.amount } else { acc }, _ -> acc })

// --- The twin's own machinery ----------------------------------------------------

reuse fn cons<a>(x: a, xs: List<a>) -> List<a> =
  xs.fold([].push(x), |acc: List<a>, y: a| acc.push(y))

fn append(s: Sink, r: Record) -> Sink = { open: s.open, next: s.next, records: s.records.push(r) }

fn record(
  s: Sink,
  k: Kind,
  l: Level,
  c: String,
  n: String,
  at: Option<OpenSpan>,
  fs: Fields,
  o: Outcome,
  amount: Int,
  value: Decimal,
) -> Record =
  {
    seq: s.records.len() + 1,
    kind: k,
    level: l,
    channel: c,
    name: n,
    span: match at { Some(open) -> open.id, None -> 0 },
    parent: match at { Some(open) -> open.parent, None -> 0 },
    fields: fs,
    outcome: o,
    amount: amount,
    value: value,
  }

fn innermost(s: Sink) -> Option<OpenSpan> = match s.open { [first, ..] -> Some(first), _ -> None }

fn current_id(s: Sink) -> Int = match s.open { [first, ..] -> first.id, _ -> 0 }

/// The channel is compared as well as the id.
fn is_open(os: List<OpenSpan>, sp: Span) -> Bool =
  match os {
    [] -> false,
    [first, ..rest] -> if first.id == sp.id { first.channel == sp.channel }
    else { is_open(rest, sp) },
  }

/// Pops spans innermost-first, recording each, until `id` has been closed.
fn close_through(s: Sink, id: Int, o: Outcome) -> Sink = closing(s, s.open, id, o)

/// `open` is `s.open`, walked as a list of its own.
fn closing(s: Sink, open: List<OpenSpan>, id: Int, o: Outcome) -> Sink =
  match open {
    [] -> s,
    [first, ..rest] -> {
      let popped = { records: s.records, open: rest, next: s.next };
      let outcome = if first.id == id { o } else { Abandoned };
      let closed = append(
        popped,
        record(
          popped,
          KExit,
          Info,
          first.channel,
          first.name,
          Some(first),
          Map::new(),
          outcome,
          0,
          0m,
        ),
      );
      if first.id == id { closed } else { closing(closed, rest, id, o) }
    },
  }

fn abandon_all(s: Sink) -> Sink = abandoning(s, s.open)

/// `open` as in `closing`: each round closes its head, which leaves the rest open.
fn abandoning(s: Sink, open: List<OpenSpan>) -> Sink =
  match open { [] -> s, [first, ..rest] -> abandoning(close_through(s, first.id, Abandoned), rest) }

// --- Tests ------------------------------------------------------------------

fn one_field(k: String, v: Field) -> Fields = Map::new().insert(k, v)

fn placed(sku: String) -> Unit / {trace.enter[orders], trace.count[orders], trace.exit[orders]} = {
  let span = trace.enter[orders]("place_order", one_field("sku", FText(sku)));
  trace.count[orders]("orders_placed", 1, Map::new());
  trace.exit[orders](span, Ok)
}

fn kinds(rs: List<Record>) -> List<Kind> = rs.map(|r: Record| r.kind)

fn span_ids(rs: List<Record>) -> List<Int> = rs.map(|r: Record| r.span)

fn parents(rs: List<Record>) -> List<Int> = rs.map(|r: Record| r.parent)

fn outcomes(rs: List<Record>) -> List<Outcome> = rs.map(|r: Record| r.outcome)

fn record_names(rs: List<Record>) -> List<String> = rs.map(|r: Record| r.name)

test "a collecting handler discharges every atom this test reaches" {
  let rs = handle {
    placed("BOLT-1")
  } with {
    var s = sink(),
    trace.enter[orders](n, fs) -> {
      let out = enter_step(s, "orders", n, fs);
      s = out.sink;
      out.span
    },
    trace.exit[orders](sp, o) -> {
      let out = exit_step(s, sp, o);
      s = out.sink;
      assert(out.ok)
    },
    trace.count[orders](n, d, fs) -> {
      s = count_step(s, "orders", n, d, fs);
    },
    return placed -> drain(s),
  };
  assert_eq(kinds(rs), [KEnter, KCount, KExit]);
  assert_eq(record_names(rs), ["place_order", "orders_placed", "place_order"]);
  assert_eq(counter_total(rs, "orders_placed"), 1);
  assert_eq(on_channel(rs, "items"), [])
}

test "a span nested in a span links to its parent, and closing is innermost first" {
  let outer = enter_step(sink(), "http", "request", Map::new());
  let inner = enter_step(outer.sink, "http", "query", Map::new());
  let closed_inner = exit_step(inner.sink, inner.span, Ok);
  let closed_outer = exit_step(closed_inner.sink, outer.span, Ok);
  assert(closed_inner.ok);
  assert(closed_outer.ok);
  let rs = drain(closed_outer.sink);
  assert_eq(span_ids(rs), [1, 2, 2, 1]);
  assert_eq(parents(rs), [0, 1, 1, 0]);
  assert_eq(kinds(rs), [KEnter, KEnter, KExit, KExit]);
  assert_eq(outcomes(rs), [Ok, Ok, Ok, Ok])
}

// The record list alone reconstructs the span tree.
test "an event inside a span carries the span it was recorded in" {
  let outer = enter_step(sink(), "http", "request", Map::new());
  let noted = event_step(outer.sink, "http", Warn, "slow", Map::new());
  assert_eq(span_ids(drain(noted)), [1, 1, 1]);
  assert_eq(named(drain(noted), "slow").map(|r: Record| r.level), [Warn])
}

// The rollback case.
test "closing an outer span abandons the spans still open above it" {
  let outer = enter_step(sink(), "orders", "place_order", Map::new());
  let inner = enter_step(outer.sink, "orders", "reserve", Map::new());
  let deeper = enter_step(inner.sink, "orders", "charge", Map::new());
  let closed = exit_step(deeper.sink, outer.span, Failed("rolled back"));
  assert(closed.ok);
  let rs = drain(closed.sink);
  assert_eq(kinds(rs), [KEnter, KEnter, KEnter, KExit, KExit, KExit]);
  assert_eq(span_ids(rs), [1, 2, 3, 3, 2, 1]);
  assert_eq(outcomes(rs), [Ok, Ok, Ok, Abandoned, Abandoned, Failed("rolled back")])
}

test "a span nobody closed is drained as abandoned, innermost first" {
  let outer = enter_step(sink(), "http", "request", Map::new());
  let inner = enter_step(outer.sink, "http", "query", Map::new());
  assert_eq(open_spans(inner.sink), 2);
  let rs = drain(inner.sink);
  assert_eq(kinds(rs), [KEnter, KEnter, KExit, KExit]);
  assert_eq(span_ids(rs), [1, 2, 2, 1]);
  assert_eq(outcomes(rs), [Ok, Ok, Abandoned, Abandoned])
}

// Closed twice, never opened, and opened on another channel: each answers `ok: false` and records nothing.
test "an exit naming a span that is not open answers false and records nothing" {
  let opened = enter_step(sink(), "http", "request", Map::new());
  let closed = exit_step(opened.sink, opened.span, Ok);

  let twice = exit_step(closed.sink, opened.span, Ok);
  assert(!twice.ok);
  assert_eq(drain(twice.sink).len(), 2);

  let never = exit_step(closed.sink, { id: 41, channel: "http" }, Ok);
  assert(!never.ok);

  let elsewhere = exit_step(opened.sink, { id: opened.span.id, channel: "orders" }, Ok);
  assert(!elsewhere.ok)
}

test "ids ascend and are never reused, across sibling spans" {
  let first = enter_step(sink(), "http", "a", Map::new());
  let closed = exit_step(first.sink, first.span, Ok);
  let second = enter_step(closed.sink, "http", "b", Map::new());
  assert_eq(first.span.id, 1);
  assert_eq(second.span.id, 2);
  assert_eq(second.span.channel, "http")
}

test "a metric is a record like any other, and a total is a fold over them" {
  let s = count_step(sink(), "orders", "placed", 2, Map::new());
  let s2 = count_step(s, "orders", "placed", 3, Map::new());
  let s3 = gauge_step(s2, "orders", "shelf", 41.75m, Map::new());
  let s4 = time_step(s3, "orders", "place_order", 8213, Map::new());
  let rs = drain(s4);
  assert_eq(counter_total(rs, "placed"), 5);
  assert_eq(counter_total(rs, "nothing"), 0);
  assert_eq(kinds(rs), [KCount, KCount, KGauge, KTime]);
  assert_eq(named(rs, "shelf").map(|r: Record| r.value), [41.75m]);
  assert_eq(named(rs, "place_order").map(|r: Record| r.amount), [8213])
}

test "fields survive as a map, so two sets built in different orders are equal" {
  let one = Map::new().insert("sku", FText("BOLT-1")).insert("n", FInt(2));
  let other = Map::new().insert("n", FInt(2)).insert("sku", FText("BOLT-1"));
  let s = event_step(sink(), "orders", Info, "placed", one);
  assert_eq(drain(s).map(|r: Record| r.fields), [other])
}

test "seq is the total order the sink hands records out in" {
  let a = event_step(sink(), "http", Info, "one", Map::new());
  let b = count_step(a, "http", "two", 1, Map::new());
  let c = enter_step(b, "http", "three", Map::new());
  assert_eq(drain(c.sink).map(|r: Record| r.seq), [1, 2, 3, 4])
}
