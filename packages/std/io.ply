//! Streams: bytes read and written a chunk at a time, through a scoped value that is released when
//! its scope ends.
//!
//! A `Source` is where bytes come from and a `Sink` is where they go. Each is a pair of functions,
//! so a file, a socket and a pipe are all read by the same `read`, `fold_lines` and `copy`. Open a
//! stream with `with_scope` over `reading`, `writing` or `appending`, and release it with
//! `close_source` or `close_sink`, which closes it however the scope ends. The stream is read or
//! written through the scoped value, which cannot leave the scope.
//!
//! A read returns at most the number of bytes requested, and costs no more than that, however much
//! the source has. A result shorter than requested is not the end; an empty result is. Every loop
//! here takes the most bytes it may read in total, and raises `io.too_long` past that limit, so
//! none runs without a bound.
//!
//! `chunks` and `lines` turn a source into a `std.seq` sequence, for `seq::map`, `seq::filter` and
//! the rest. Each pull is one read. The sequence's effects say it reads a scoped value, so it must
//! be consumed inside the scope that opened the source. The sequence itself has no limit on length:
//! the code that consumes it must stop after a bounded number of items. A decoder with its own
//! state is a step function passed to `seq::unfold` over `read` or `fill`.
//!
//! File functions take a file system label such as `[l]`, which names a directory the program is
//! given access to with `--fs NAME=PATH`. Code written for any such label runs unchanged over
//! `std.fs`'s in-memory fake (`fs::on_mem`). With `fs::mem_short_reads`, the fake gives the short
//! reads that a file on disk rarely gives.
//!
//! `stdin`, `stdout` and `stderr` are the process's own streams, as a source and two sinks. So a
//! filter is `copy(from, to, ..)`, and a line reader is `fold_lines` over standard input, each
//! under `with_scope` like any stream. These streams belong to the process and outlive every scope.
//! Closing standard output flushes its buffer, and closing the other two does nothing. A write
//! whose reader has gone away raises `std.process`'s `pipe.broken`, and never returns `false`. Code
//! written against them runs unchanged over `std.process`'s fake (`process::over`).

import std.fs
import std.fs (fs, files, FileError, ToRead, ToWrite, ToAppend)
import std.laws (agrees)
import std.list
import std.process
import std.process (process, pipe, Stdout, Stderr)
import std.random (entropy, rand, with_rand)
import std.seq
import std.seq (Seq, seq)
import std.gen

/// Where bytes are read from. `pull(max)` returns the next bytes, at most `max` of them, and none
/// at the end. `close` releases the source. A source is a value, so `Scoped::get` returns a copy
/// that can leave the scope even though the scoped value cannot. Pulling from such a copy after
/// `close` raises, and never looks like the end.
pub type Source<| e> = { pull: (Int) -> Bytes / e, close: () -> Unit / e }

/// Where bytes are written to. `push(bytes)` accepts all of the bytes or returns `false`. `close`
/// releases the sink.
pub type Sink<| e> = { push: (Bytes) -> Bool / e, close: () -> Unit / e }

/// The errors a stream raises.
pub effect io {
  /// The file at `path` could not be opened.
  raise fail(path: String, reason: FileError)
  /// A source had more than the `limit` bytes its reader may read.
  raise too_long(limit: Int)
  /// A sink did not accept what was written to it.
  raise write_failed()
  /// A source was read after it was closed.
  raise closed()
}

/// The file at `path` under the root `l`, open to be read from its start.
pub fn reading<[l]>(
  path: String,
) -> Source<| {fs.read_chunk[l], fs.close[l], io.closed}> / {fs.open[l], io.fail} =
  match fs.open[l](path, ToRead) {
    Ok(file) ->
      {
        pull: |size: Int|
          match fs.read_chunk[l](file, size) { Some(bytes) -> bytes, None -> io.closed() },
        close: || {
          fs.close[l](file);
          ()
        },
      },
    Err(reason) -> io.fail(path, reason),
  }

/// The file at `path` under the root `l`, truncated or created, open to be written from its start.
pub fn writing<[l]>(
  path: String,
) -> Sink<| {fs.write_chunk[l], fs.close[l]}> / {fs.open[l], io.fail} =
  match fs.open[l](path, ToWrite) {
    Ok(file) -> file_sink[l](file),
    Err(reason) -> io.fail(path, reason),
  }

/// The file at `path` under the root `l`, created if it does not exist, open to be written at its
/// end.
pub fn appending<[l]>(
  path: String,
) -> Sink<| {fs.write_chunk[l], fs.close[l]}> / {fs.open[l], io.fail} =
  match fs.open[l](path, ToAppend) {
    Ok(file) -> file_sink[l](file),
    Err(reason) -> io.fail(path, reason),
  }

fn file_sink<[l]>(file: Int) -> Sink<| {fs.write_chunk[l], fs.close[l]}> =
  {
    push: |bytes: Bytes| fs.write_chunk[l](file, bytes),
    close: || {
      fs.close[l](file);
      ()
    },
  }

/// Standard input as a source. Closing it does nothing.
pub fn stdin<[p]>() -> Source<| {process.in_bytes[p]}> =
  { pull: |max: Int| process.in_bytes[p](max), close: || () }

/// Standard output as a sink. A write whose reader has gone away raises `pipe.broken`. Closing the
/// sink flushes the stream's buffer.
pub fn stdout<[p]>() -> Sink<| {process.out_bytes[p], process.flush[p], pipe.broken}> =
  {
    push: |bytes: Bytes| {
      process::write_out[p](bytes);
      true
    },
    close: || process::flush_out[p](),
  }

/// Standard error as a sink. A write whose reader has gone away raises `pipe.broken`. Closing the
/// sink does nothing, because the stream is not buffered.
pub fn stderr<[p]>() -> Sink<| {process.err_bytes[p], pipe.broken}> =
  {
    push: |bytes: Bytes| {
      process::write_err[p](bytes);
      true
    },
    close: || (),
  }

/// Runs `body` to write the file at `path` through a sink, replacing the file completely or not at
/// all, as `fs::write_atomic` does for bytes in memory. The path is inside the directory that the
/// file system label `l` names. What `body` writes goes to a temporary file beside the path. Once
/// `body` returns, the temporary file is renamed over the path, so a file of any size is replaced
/// using the memory of one chunk. If a raise unwinds through `body`, or its task is cancelled, the
/// temporary file is removed and the path still has its old contents. `durability` and `mode` are
/// as for `fs::commit_atomic`.
///
/// The sink is passed to `body` as a plain `Sink` value, not as a `Scoped` value, and closing it
/// does nothing. `body` can call the sink's `push` directly. To use `write` and `copy`, which take
/// a `Scoped` sink, `body` wraps the sink itself with `with_scope[out](sink, close_sink) { .. }`.
/// Once `body` has returned, the sink accepts nothing more.
pub fn replacing<a, [l] | e>(
  path: String,
  durability: fs::Durability,
  mode: Option<fs::Mode>,
  body: (Sink<| {fs.write_chunk[l]}>) -> a / e,
) -> a / {fs.open[l], fs.sync[l], fs.close[l], fs.stat[l], fs.set_mode[l], fs.rename[l], fs.remove[l], files.fail, entropy.next, abort.raise | e} =
  with_scope[pending](fs::begin_atomic[l](path), |p: fs::Pending|
    fs::abandon_atomic[l](p)) { pending_scope -> {
    let p = pending_scope.get();
    let value = body(non_closing_sink[l](p.file));
    fs::commit_atomic[l](p, mode, durability);
    value
  } }

fn non_closing_sink<[l]>(file: Int) -> Sink<| {fs.write_chunk[l]}> =
  { push: |bytes: Bytes| fs.write_chunk[l](file, bytes), close: || () }

/// Closes a source. Pass it to `with_scope` as the release function.
pub fn close_source<| e>(source: Source<| e>) -> Unit / e = (source.close)()

/// Closes a sink. Pass it to `with_scope` as the release function.
pub fn close_sink<| e>(sink: Sink<| e>) -> Unit / e = (sink.close)()

/// The next bytes of the source, at most `max` of them, and empty at its end. Every reader is built
/// from this one step.
pub fn read<[r] | e>(source: Scoped<Source<| e>, [r]>, max: Int) -> Bytes / {scoped.read[r] | e} =
  source.get().pull(max)

/// Writes all of `bytes`.
pub fn write<[r] | e>(
  sink: Scoped<Sink<| e>, [r]>,
  bytes: Bytes,
) -> Unit / {scoped.read[r], io.write_failed | e} =
  if sink.get().push(bytes) { () } else { io.write_failed() }

/// Folds `f` over each chunk of the source until the source ends, and returns the result. No chunk
/// is longer than `chunk` bytes, which must be at least one. Reads at most `limit` bytes in total,
/// raising `io.too_long` if the source has more, and has only one chunk in memory at a time.
pub fn fold_chunks<a, [r] | e>(
  source: Scoped<Source<| e>, [r]>,
  chunk: Int,
  limit: Int,
  init: a,
  f: (a, Bytes) -> a / e,
) -> a / {scoped.read[r], io.too_long, abort.raise | e} =
  iterate(
    { accumulator: init, read: 0 },
    max_reads(chunk, limit),
    |s: { accumulator: a, read: Int }| {
      let bytes = next_chunk(source, chunk, limit, s.read);
      if bytes.len() == 0 { Stop(s.accumulator) }
      else { Continue({ accumulator: f(s.accumulator, bytes), read: s.read + bytes.len() }) }
    },
  )

fn max_reads(chunk: Int, limit: Int) -> Int / {abort.raise} =
  if chunk < 1 { panic("a chunk is at least one byte") } else { max(limit, 0) + 2 }

fn next_chunk<[r] | e>(
  source: Scoped<Source<| e>, [r]>,
  chunk: Int,
  limit: Int,
  so_far: Int,
) -> Bytes / {scoped.read[r], io.too_long | e} = {
  let bytes = read(source, min(chunk, max(limit - so_far, 0) + 1));
  if so_far + bytes.len() > limit { io.too_long(limit) } else { bytes }
}

/// Everything left in the source, read `chunk` bytes at a time, up to `limit` bytes.
pub fn read_all<[r] | e>(
  source: Scoped<Source<| e>, [r]>,
  chunk: Int,
  limit: Int,
) -> Bytes / {scoped.read[r], io.too_long, abort.raise | e} =
  Bytes::concat_all(
    fold_chunks(source, chunk, limit, [], |parts: List<Bytes>, bytes: Bytes| parts.push(bytes)),
  )

/// One step of a line reader. Returns the lines that `chunk` completes after the unfinished line
/// `pending`, each without its `\n`, and the new unfinished line, which the reader passes back with
/// the next chunk. Only `chunk` is searched, and `pending` grows in place when the caller has the
/// only reference to it. So a line read across many chunks costs time linear in its length.
pub fn split_lines(
  pending: Bytes,
  chunk: Bytes,
) -> { lines: List<Bytes>, pending: Bytes } / {abort.raise} =
  match chunk.index_of_byte(10) {
    None -> { lines: [], pending: pending ++ chunk },
    Some(cut) -> {
      let parts = chunk.slice(cut + 1, chunk.len()).split(b"\n");
      let whole = parts.len() - 1;
      {
        lines: [pending ++ chunk.slice(0, cut)].concat(parts.take(whole)),
        pending: parts.get(whole),
      }
    },
  }

/// Folds `f` over each line of the source, without its `\n`. The last line need not end in `\n`,
/// and a source that ends in `\n` has no empty line after it. Reads `chunk` bytes at a time and at
/// most `limit` in total. A line costs time linear in its length, however many chunks it spans.
pub fn fold_lines<a, [r] | e>(
  source: Scoped<Source<| e>, [r]>,
  chunk: Int,
  limit: Int,
  init: a,
  f: (a, Bytes) -> a / e,
) -> a / {scoped.read[r], io.too_long, abort.raise | e} = {
  let ended = iterate(
    { accumulator: init, pending: b"", read: 0 },
    max_reads(chunk, limit),
    |s: { accumulator: a, pending: Bytes, read: Int }| {
      let bytes = next_chunk(source, chunk, limit, s.read);
      if bytes.len() == 0 { Stop(s) } else {
        let split = split_lines(s.pending, bytes);
        Continue({
          accumulator: split.lines.fold(s.accumulator, f),
          pending: split.pending,
          read: s.read + bytes.len(),
        })
      }
    },
  );
  if ended.pending.len() == 0 { ended.accumulator } else { f(ended.accumulator, ended.pending) }
}

/// Copies what is left in the source into the sink, `chunk` bytes at a time, using the memory of
/// one chunk, up to `limit` bytes. Returns the number of bytes copied.
pub fn copy<[r], [w] | e>(
  from: Scoped<Source<| e>, [r]>,
  to: Scoped<Sink<| e>, [w]>,
  chunk: Int,
  limit: Int,
) -> Int / {scoped.read[r], scoped.read[w], io.too_long, io.write_failed, abort.raise | e} =
  iterate(0, max_reads(chunk, limit), |copied: Int| {
    let bytes = next_chunk(from, chunk, limit, copied);
    if bytes.len() == 0 { Stop(copied) } else {
      write(to, bytes);
      Continue(copied + bytes.len())
    }
  })

/// The next `n` bytes of the source, or fewer only if it ends first. Reads repeatedly until it has
/// them, however short each read is.
pub fn fill<[r] | e>(
  source: Scoped<Source<| e>, [r]>,
  n: Int,
) -> Bytes / {scoped.read[r], abort.raise | e} =
  Bytes::concat_all(
    iterate({ parts: [], got: 0 }, max(n, 0) + 1, |s: { parts: List<Bytes>, got: Int }|
      if s.got >= n { Stop(s.parts) } else {
        let bytes = read(source, n - s.got);
        if bytes.len() == 0 { Stop(s.parts) }
        else { Continue({ parts: s.parts.push(bytes), got: s.got + bytes.len() }) }
      }),
  )

/// Returns the chunks of a source as a sequence, each at most `size` bytes, ending where the source
/// does. Each step of the sequence makes one read, so a consumer allowed `b` items makes at most `b
/// + 1` reads. The sequence reads the source as it is consumed. Consuming the sequence a second
/// time continues from the source's current position, not from the beginning of the source.
pub fn chunks<[r] | e>(
  source: Scoped<Source<| e>, [r]>,
  size: Int,
) -> Seq<Bytes | {scoped.read[r] | e}> =
  seq::unfold((), |u: Unit| {
    let bytes = read(source, size);
    if bytes.len() == 0 { None } else { Some({ value: bytes, next: () }) }
  })

/// The lines of a source as a sequence, each without its `\n`, as `fold_lines` reads them. A pull
/// reads at most one chunk of `chunk` bytes, and a chunk that completes no line yields no line.
/// Like `chunks`, it can be pulled through only once.
pub fn lines<[r] | e>(
  source: Scoped<Source<| e>, [r]>,
  chunk: Int,
) -> Seq<Bytes | {scoped.read[r], abort.raise | e}> =
  seq::flat_map(
    seq::unfold(Some(b""), |left: Option<Bytes>|
      match left {
        None -> None,
        Some(pending) -> {
          let bytes = read(source, chunk);
          if bytes.len() == 0 {
            Some({ value: if pending.len() == 0 { [] } else { [pending] }, next: None })
          } else {
            let split = split_lines(pending, bytes);
            Some({ value: split.lines, next: Some(split.pending) })
          }
        },
      }),
    |ready: List<Bytes>| seq::of_list(ready),
  )

type Halves = { head: List<Int>, tail: List<Int> }

fn parity_bytes(picks: List<Int>) -> Bytes =
  Bytes::concat_all(picks.map(|p: Int| if p % 2 == 0 { b"\n" } else { b"a" }))

fn split_in_two(h: Halves) -> { lines: List<Bytes>, rest: Bytes } / {abort.raise} = {
  let first = split_lines(b"", parity_bytes(h.head));
  let second = split_lines(first.pending, parity_bytes(h.tail));
  { lines: first.lines.concat(second.lines), rest: second.pending }
}

fn split_whole(h: Halves) -> { lines: List<Bytes>, rest: Bytes } / {abort.raise} = {
  let one = split_lines(b"", parity_bytes(h.head).concat(parity_bytes(h.tail)));
  { lines: one.lines, rest: one.pending }
}

fn halves_generator() -> gen::Gen<Halves> =
  gen::map2(
    gen::list(gen::any_int()),
    gen::list(gen::any_int()),
    |head: List<Int>, tail: List<Int>| { head: head, tail: tail },
  )

test "the lines of a text are the same wherever a chunk ends" {
  gen::check(halves_generator(), |x: Halves| agrees(split_in_two, split_whole, x))
}

fn tree() -> fs::MemFs / {abort.raise} =
  fs::mem_of([{ path: "notes/poem.txt", body: b"one\ntwo\nthree" }, { path: "empty", body: b"" }])

fn lines_of(
  path: String,
  chunk: Int,
) -> List<Bytes> / {fs.open[data], fs.read_chunk[data], fs.close[data], io.fail, io.too_long, io.closed, abort.raise} =
  with_scope[file](
    reading[data](path),
    close_source,
  ) { source ->
    fold_lines(source, chunk, 1024, [], |lines: List<Bytes>, line: Bytes| lines.push(line))
  }

test "a file is read in chunks no longer than requested, and ends with an empty one" {
  let over = fs::on_mem[data](tree(), ||
    with_scope[file](
      reading[data]("notes/poem.txt"),
      close_source,
    ) { source -> [read(source, 5), read(source, 5), read(source, 5), read(source, 5)] });
  assert_eq(over.value, [b"one\nt", b"wo\nth", b"ree", b""]);
  assert_eq(over.tree.opened.len(), 0)
}

test "the lines of a file are the same whatever the chunk, and whatever short reads the source gives: {c}" for c: { chunk: Int, short: Int } in [
    { chunk: 1, short: 0 },
    { chunk: 2, short: 0 },
    { chunk: 4, short: 0 },
    { chunk: 5, short: 0 },
    { chunk: 64, short: 0 },
    { chunk: 64, short: 1 },
    { chunk: 64, short: 3 },
    { chunk: 7, short: 5 },
  ] {
  let read = fs::on_mem[data](fs::mem_short_reads(tree(), c.short), ||
    lines_of("notes/poem.txt", c.chunk));
  assert_eq(read.value, [b"one", b"two", b"three"])
}

test "a file that ends in a newline has no empty line after it, and an empty file has no lines" {
  let ended = fs::mem_write(tree(), "notes/poem.txt", b"one\n\ntwo\n").fs;
  assert_eq(fs::on_mem[data](ended, || lines_of("notes/poem.txt", 3)).value, [b"one", b"", b"two"]);
  assert_eq(fs::on_mem[data](tree(), || lines_of("empty", 3)).value, [])
}

test "a source with more bytes than its reader may read fails, and is still closed" {
  let over = fs::on_mem[data](tree(), || {
    let read: Result<Bytes, Int> = try[io.too_long] {
      with_scope[file](
        reading[data]("notes/poem.txt"),
        close_source,
      ) { source -> read_all(source, 4, 12) }
    };
    let whole: Result<Bytes, Int> = try[io.too_long] {
      with_scope[file](
        reading[data]("notes/poem.txt"),
        close_source,
      ) { source -> read_all(source, 4, 13) }
    };
    [read, whole]
  });
  assert_eq(over.value, [Err(12), Ok(b"one\ntwo\nthree")]);
  assert_eq(over.tree.opened.len(), 0)
}

test "reading from a source after its scope closed it raises an error instead of reporting end of input" {
  let over = fs::on_mem[data](tree(), || {
    let escaped = with_scope[file](
      reading[data]("notes/poem.txt"),
      close_source,
    ) { source -> source.get() };
    let late: Result<Bytes, Unit> = try[io.closed] { (escaped.pull)(4) };
    late
  });
  assert_eq(over.value, Err(()))
}

test "a file that does not open reports why, and nothing is left open" {
  let over = fs::on_mem[data](tree(), || {
    let reason = |path: String| {
      let opened: Result<Int, (String, FileError)> = try[io.fail] {
        with_scope[file](reading[data](path), close_source) { source -> read(source, 1).len() }
      };
      opened
    };
    [reason("notes/absent.txt"), reason("notes"), reason("empty")]
  });
  assert_eq(over.value, [
    Err(("notes/absent.txt", fs::NotFound)),
    Err(("notes", fs::NotAFile)),
    Ok(0),
  ]);
  assert_eq(over.tree.opened.len(), 0)
}

test "writing a file stores its chunks in order, and appending adds to the existing contents or creates the file" {
  let over = fs::on_mem[data](tree(), || {
    with_scope[out](
      writing[data]("notes/poem.txt"),
      close_sink,
    ) { sink -> {
      write(sink, b"a");
      write(sink, b"bc")
    } };
    with_scope[out](appending[data]("notes/poem.txt"), close_sink) { sink -> write(sink, b"\nd") };
    with_scope[out](appending[data]("notes/new.txt"), close_sink) { sink -> write(sink, b"e") }
  });
  assert_eq(fs::mem_read(over.tree, "notes/poem.txt"), Some(b"abc\nd"));
  assert_eq(fs::mem_read(over.tree, "notes/new.txt"), Some(b"e"));
  assert_eq(over.tree.opened.len(), 0)
}

test "a copy moves a file a chunk at a time and returns how much it moved" {
  let over = fs::on_mem[data](fs::mem_short_reads(tree(), 2), ||
    with_scope[from](
      reading[data]("notes/poem.txt"),
      close_source,
    ) { source ->
      with_scope[to](
        writing[data]("notes/copy.txt"),
        close_sink,
      ) { sink -> copy(source, sink, 4, 1024) }
    });
  assert_eq(over.value, 13);
  assert_eq(fs::mem_read(over.tree, "notes/copy.txt"), Some(b"one\ntwo\nthree"))
}

test "a reader still closes its file when a raise unwinds through it" {
  let over = fs::on_mem[data](tree(), || {
    let first: Result<Bytes, Int> = try[io.too_long] {
      with_scope[file](
        reading[data]("notes/poem.txt"),
        close_source,
      ) { source ->
        fold_lines(source, 2, 1024, b"", |found: Bytes, line: Bytes| io.too_long(line.len()))
      }
    };
    first
  });
  assert_eq(over.value, Err(3));
  assert_eq(over.tree.opened.len(), 0)
}

test "`fill` keeps reading until it has the requested number of bytes despite short reads, and returns fewer only at the end of the file" {
  let over = fs::on_mem[data](fs::mem_short_reads(tree(), 2), ||
    with_scope[file](
      reading[data]("notes/poem.txt"),
      close_source,
    ) { source -> [fill(source, 5), fill(source, 0), fill(source, 100), fill(source, 3)] });
  assert_eq(over.value, [b"one\nt", b"", b"wo\nthree", b""])
}

test "the chunks of a source are a sequence that ends where the source does" {
  let over = fs::on_mem[data](tree(), ||
    with_scope[file](
      reading[data]("notes/poem.txt"),
      close_source,
    ) { source -> seq::to_list(seq::map(chunks(source, 5), Bytes::len), 8) });
  assert_eq(over.value, [5, 5, 3]);
  assert_eq(over.tree.opened.len(), 0)
}

test "`lines` returns the same lines for every chunk size and short-read size in {c}" for c: { chunk: Int, short: Int } in [
    { chunk: 1, short: 0 },
    { chunk: 4, short: 0 },
    { chunk: 5, short: 0 },
    { chunk: 64, short: 0 },
    { chunk: 64, short: 3 },
    { chunk: 7, short: 5 },
  ] {
  let read = fs::on_mem[data](fs::mem_short_reads(tree(), c.short), ||
    with_scope[file](
      reading[data]("notes/poem.txt"),
      close_source,
    ) { source -> seq::to_list(lines(source, c.chunk), 64) });
  assert_eq(read.value, [b"one", b"two", b"three"])
}

test "`chunks` reads a chunk only when the sequence is consumed, and taking one chunk then one more reads two chunks in total" {
  let over = fs::on_mem[data](tree(), ||
    with_scope[file](
      reading[data]("notes/poem.txt"),
      close_source,
    ) { source -> {
      let pulled = chunks(source, 4);
      let first = seq::to_list(seq::take(pulled, 1), 4);
      let spent: Result<List<Bytes>, Int> = try[seq.spent] { seq::to_list(pulled, 1) };
      { first: first, spent: spent, left: read(source, 100) }
    } });
  assert_eq(over.value.first, [b"one\n"]);
  assert_eq(over.value.spent, Err(1));
  assert_eq(over.value.left, b"e")
}

fn cat(
  chunk: Int,
) -> Int / {process.in_bytes[proc], process.out_bytes[proc], process.flush[proc], pipe.broken, io.too_long, io.write_failed, abort.raise} =
  with_scope[input](
    stdin[proc](),
    close_source,
  ) { from ->
    with_scope[output](stdout[proc](), close_sink) { to -> copy(from, to, chunk, 1048576) }
  }

test "standard input is copied to standard output byte for byte, whatever the reads: {c}" for c: { chunks: List<Bytes>, chunk: Int } in [
    { chunks: [b"\x00\xff\xfe\n\x80binary\x00"], chunk: 1 },
    { chunks: [b"\x00\xff\xfe\n\x80binary\x00"], chunk: 4 },
    { chunks: [b"\x00\xff", b"\xfe", b"\n\x80bin", b"ary\x00"], chunk: 64 },
    { chunks: [b"\x00\xff", b"\xfe", b"\n\x80bin", b"ary\x00"], chunk: 3 },
    { chunks: [], chunk: 8 },
  ] {
  let ran = process::over[proc](process::with_chunks(process::captured([]), c.chunks), ||
    cat(c.chunk));
  let all = Bytes::concat_all(c.chunks);
  assert_eq(ran.value, Some(all.len()));
  assert_eq(process::written_to(ran.captured, Stdout), all);
  assert_eq(process::written_to(ran.captured, Stderr), b"")
}

test "reading lines from standard input gives the same lines as reading them from a file" {
  let typed = process::with_chunks(process::captured([]), [b"one\ntw", b"o\n", b"three"]);
  let ran = process::over[proc](typed, ||
    with_scope[input](
      stdin[proc](),
      close_source,
    ) { source ->
      fold_lines(source, 4, 1024, [], |lines: List<Bytes>, line: Bytes| lines.push(line))
    });
  assert_eq(ran.value, Some([b"one", b"two", b"three"]))
}

test "standard error receives exactly the bytes written to it, and closing standard output flushes the bytes written to standard output" {
  let ran = process::over[proc](process::captured([]), || {
    with_scope[errors](stderr[proc](), close_sink) { sink -> write(sink, b"\x00warn") };
    with_scope[output](stdout[proc](), close_sink) { sink -> write(sink, b"half a line") }
  });
  assert_eq(process::written_to(ran.captured, Stderr), b"\x00warn");
  assert_eq(process::written_to(ran.captured, Stdout), b"half a line");
  let closed = process::over[proc](process::hung_up(process::captured([]), Stdout), || {
    let wrote: Result<Unit, process::Stream> = try[pipe.broken] {
      with_scope[output](stdout[proc](), close_sink) { sink -> write(sink, b"into nothing") }
    };
    let let_go: Result<Unit, process::Stream> = try[pipe.broken] {
      with_scope[output](stdout[proc](), close_sink) { unwritten -> () }
    };
    [wrote, let_go]
  });
  assert_eq(closed.value, Some([Err(Stdout), Err(Stdout)]))
}

test "`replacing` leaves the old file contents in place until the function passed to it returns, and then the file contains every written chunk" {
  let over = fs::on_mem[data](tree(), ||
    with_rand(rand(0), ||
      replacing[data](
        "notes/poem.txt",
        fs::Durable,
        None,
        |sink: Sink<| {fs.write_chunk[data]}>|
          with_scope[out](
            sink,
            close_sink,
          ) { out -> {
            write(out, b"uno\n");
            let during = fs.read_file[data]("notes/poem.txt");
            write(out, b"dos");
            during
          } },
      )).value);
  assert_eq(over.value, Some(b"one\ntwo\nthree"));
  assert_eq(fs::mem_read(over.tree, "notes/poem.txt"), Some(b"uno\ndos"));
  assert_eq(fs::listed_names(fs::mem_list(over.tree, "notes")), Some(["poem.txt"]));
  assert_eq(over.tree.opened.len(), 0)
}

test "a body that raises leaves the file it was replacing as it was, and no temporary beside it" {
  let over = fs::on_mem[data](tree(), ||
    with_rand(rand(0), || {
      let wrote: Result<Unit, Int> = try[io.too_long] {
        replacing[data]("notes/poem.txt", fs::Fast, None, |sink: Sink<| {fs.write_chunk[data]}>|
          if (sink.push)(b"half") { io.too_long(4) } else { () })
      };
      wrote
    }).value);
  assert_eq(over.value, Err(4));
  assert_eq(fs::mem_read(over.tree, "notes/poem.txt"), Some(b"one\ntwo\nthree"));
  assert_eq(fs::listed_names(fs::mem_list(over.tree, "notes")), Some(["poem.txt"]));
  assert_eq(over.tree.opened.len(), 0)
}
