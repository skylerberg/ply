const http_examples: List<String> =
  ["Sun, 06 Nov 1994 08:49:37 GMT", "Sunday, 06-Nov-94 08:49:37 GMT", "Sun Nov  6 08:49:37 1994"]

test "`parse_http_date` parses the RFC 9110 example date `{c}`, and `http_date` formats it as `Sun, 06 Nov 1994 08:49:37 GMT`" for c: String in http_examples {
  let o = parse_http_date(c, Instant(1791117000000000000)).expect(c);
  assert_eq(Some(o), of_unix_seconds(784111777));
  assert_eq(http_date(o), "Sun, 06 Nov 1994 08:49:37 GMT")
}

test "two digits of a year are read relative to the present, fifty years ahead at most" {
  let in_2019 = Instant(1546300800000000000);
  let in_2026 = Instant(1791117000000000000);
  let format_fields = "Thursday, 01-Jan-70 00:00:00 GMT";
  assert_eq(parse_http_date(format_fields, in_2019), of_unix_seconds(0));
  assert_eq(parse_http_date(format_fields, in_2026), None);
  assert_eq(
    parse_http_date("Wednesday, 01-Jan-70 00:00:00 GMT", in_2026),
    Some(the_instant("2070-01-01T00:00:00Z")),
  );
  assert_eq(
    parse_http_date("Sunday, 04-Oct-76 12:30:00 GMT", in_2026),
    Some(the_instant("2076-10-04T12:30:00Z")),
  );
  assert_eq(
    parse_http_date("Monday, 04-Oct-76 12:30:01 GMT", in_2026),
    Some(the_instant("1976-10-04T12:30:01Z")),
  )
}

