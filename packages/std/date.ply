//! Calendar dates, times of day and date-times, and the text formats that carry them.
//!
//! There is a separate type for each thing a text can mean, so a value never has a zone that may or
//! may not be present. A `Date` is a calendar day, a `Time` a time of day, a `DateTime` the two
//! together with no zone, and an `OffsetDateTime` a `DateTime` at a stated offset from UTC, which
//! identifies an instant. A `Period` is a count of calendar months and days, separate from the
//! prelude's exact `Duration`. Named time zones are not supported.
//!
//! The calendar is the proleptic Gregorian one over the years 0000 to 9999, the range every format
//! here can write. A time has nanosecond precision. An offset is whole minutes, within a day either
//! side of UTC. Values of one type order chronologically, an `OffsetDateTime` by its instant and
//! then its offset, and `show` writes each as ISO 8601 does. Use the functions here to create
//! values: they check the range and return `None` outside it, which a constructor called directly
//! does not. A tagged string literal builds a value at compile time: `date"2026-10-04"` is a
//! `Date`, and the tags `std.timeofday`, `std.datetime`, `std.timestamp` and `std.strftime` build a
//! `Time`, a `DateTime`, an `OffsetDateTime` and a `Pattern`.
//!
//! Nothing here reads a clock: the one function that needs the current time, `parse_http_date`,
//! takes it as an argument. Month and weekday names are English, in every format and pattern.
//!
//! Parsing accepts a seconds field of `60` only in a text with an offset, and only for 23:59:60 UTC
//! on the last day of a month. It reads that time as 23:59:59 with the same fraction. No function
//! writes a leap second.

import std.bytes (is_digit)
import std.laws (agrees)
import std.list
import std.math (clamp, pow)
import std.option
import std.result
import std.show (show)
import std.string
import std.time (as_nanos, nanos, nanos_at)
import std.gen

/// A day of the calendar, 0000-01-01 to 9999-12-31, as its count of days from 1970-01-01.
pub type Date = | Date(Int)

/// A time of day to the nanosecond, 00:00:00 up to but not 24:00:00, as nanoseconds from midnight.
pub type Time = | Time(Int)

/// A date and a time of day with no zone: what some wall clock shows, not an instant.
pub type DateTime = | DateTime(Date, Time)

/// An instant as shown by a wall clock at a fixed offset from UTC: the UTC date-time, and the
/// minutes the wall clock is east of UTC. Two values for the same instant at different offsets are
/// not `==`.
pub type OffsetDateTime = | OffsetDateTime(DateTime, Int)

/// A span of the calendar: whole months, then whole days. A year is twelve months and a week seven
/// days. How long either is in hours depends on where it starts, which is why it is not a
/// `Duration`.
pub type Period = new { months: Int, days: Int }

/// A day of the week.
pub type Weekday = | Monday | Tuesday | Wednesday | Thursday | Friday | Saturday | Sunday

/// A month of the year.
pub type Month =
  | January
  | February
  | March
  | April
  | May
  | June
  | July
  | August
  | September
  | October
  | November
  | December

/// What adding months does when the day it lands on is past the end of its month.
pub type Overflow =
  /// The month's last day: a month after 31 January is 28 or 29 February.
  | Clamp
  /// Makes adding months or years return `None` when the resulting month has no such day, such as
  /// 31 January plus one month.
  | Reject

/// A length of time a `Time` or a `DateTime` is truncated or rounded to.
pub type TimeUnit = | Days | Hours | Minutes | Seconds | Milliseconds | Microseconds | Nanoseconds

/// A date as its year, its month from 1 and its day of the month from 1.
pub type YearMonthDay = { year: Int, month: Int, day: Int }

/// An ISO 8601 week: its week-numbering year, and the week from 1.
pub type IsoWeek = { year: Int, week: Int }

/// Why a text could not be read, and the offset of the character where it went wrong.
pub type Error = { message: String, offset: Int }

show for Date by text

show for Time by time_text

show for DateTime by date_time_text

show for OffsetDateTime by rfc3339

const first_day: Int = -719528

const last_day: Int = 2932896

const day_nanos: Int = 86400000000000

fn days_from_civil(year: Int, month: Int, day: Int) -> Int = {
  let y = if month <= 2 { year - 1 } else { year };
  let era = (if y >= 0 { y } else { y - 399 }) / 400;
  let year_of_era = y - era * 400;
  let month_from_march = if month > 2 { month - 3 } else { month + 9 };
  let day_of_year = (153 * month_from_march + 2) / 5 + day - 1;
  let day_of_era = year_of_era * 365 + year_of_era / 4 - year_of_era / 100 + day_of_year;
  era * 146097 + day_of_era - 719468
}

fn civil_from_days(days: Int) -> YearMonthDay = {
  let z = days + 719468;
  let era = (if z >= 0 { z } else { z - 146096 }) / 146097;
  let day_of_era = z - era * 146097;
  let year_of_era = (day_of_era - day_of_era / 1460 + day_of_era / 36524 - day_of_era / 146096)
    / 365;
  let day_of_year = day_of_era - (365 * year_of_era + year_of_era / 4 - year_of_era / 100);
  let month_from_march = (5 * day_of_year + 2) / 153;
  let month = if month_from_march < 10 { month_from_march + 3 } else { month_from_march - 9 };
  {
    year: year_of_era + era * 400 + (if month <= 2 { 1 } else { 0 }),
    month: month,
    day: day_of_year - (153 * month_from_march + 2) / 5 + 1,
  }
}

fn month_length(year: Int, month: Int) -> Int =
  if month == 2 { if is_leap_year(year) { 29 } else { 28 } }
  else if month == 4 || month == 6 || month == 9 || month == 11 { 30 }
  else { 31 }

fn year_in_range(year: Int) -> Bool = year >= 0 && year <= 9999

fn day_in_range(days: Int) -> Bool = days >= first_day && days <= last_day

/// The date of a year, a month from 1 and a day of the month from 1; `None` for a day its month
/// does not have, a month past 12 or a year outside 0000 to 9999.
pub fn of(year: Int, month: Int, day: Int) -> Option<Date> =
  if !year_in_range(year) || month < 1 || month > 12 || day < 1 || day > month_length(year, month) {
    None
  } else { Some(Date(days_from_civil(year, month, day))) }

/// The date of a year and a day of the year from 1, an ISO 8601 ordinal date; `None` for a day the
/// year does not have.
pub fn of_ordinal(year: Int, day_of_year: Int) -> Option<Date> =
  if !year_in_range(year) || day_of_year < 1 || day_of_year > days_in_year(year) { None }
  else { Some(Date(days_from_civil(year, 1, 1) + day_of_year - 1)) }

/// The date of an ISO 8601 week date: a week-numbering year, a week from 1 and a weekday; `None`
/// for a week the year does not have.
pub fn of_week(year: Int, week: Int, day: Weekday) -> Option<Date> =
  if year < -1 || year > 10000 || week < 1 || week > 53 { None } else {
    let fourth = days_from_civil(year, 1, 4);
    let days = fourth - weekday_index(fourth) + (week - 1) * 7 + weekday_number(day) - 1;
    let found: IsoWeek = { year: year, week: week };
    if day_in_range(days) && week_of_days(days) == found { Some(Date(days)) } else { None }
  }

/// The date `days` days after 1970-01-01, or before it for a negative count.
pub fn of_unix_days(days: Int) -> Option<Date> =
  if day_in_range(days) { Some(Date(days)) } else { None }

/// The days from 1970-01-01 to the date, negative before it.
pub fn unix_days(d: Date) -> Int = match d { Date(days) -> days }

/// 0000-01-01, the first date there is.
pub const earliest: Date = Date(first_day)

/// 9999-12-31, the last.
pub const latest: Date = Date(last_day)

/// The date's year, month and day as numbers.
pub fn parts(d: Date) -> YearMonthDay = civil_from_days(unix_days(d))

/// The year, 0 to 9999.
pub fn year(d: Date) -> Int = parts(d).year

/// The month.
pub fn month(d: Date) -> Month = month_at(parts(d).month)

/// The day of the month, from 1.
pub fn day(d: Date) -> Int = parts(d).day

/// The day of the week.
pub fn weekday(d: Date) -> Weekday = weekday_at(weekday_index(unix_days(d)))

/// The day of the year, from 1: 366 on 31 December of a leap year.
pub fn day_of_year(d: Date) -> Int = unix_days(d) - days_from_civil(year(d), 1, 1) + 1

/// The ISO 8601 week the date is in. A week runs Monday to Sunday and belongs to the year its
/// Thursday is in, so the first days of January may be in the last week of the year before, and
/// the last of December in the first week of the year after.
pub fn week(d: Date) -> IsoWeek = week_of_days(unix_days(d))

/// Returns whether the year has a 29 February: a year divisible by 4, except that a century year
/// must also be divisible by 400.
pub fn is_leap_year(year: Int) -> Bool = year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)

/// How many days the year has.
pub fn days_in_year(year: Int) -> Int = if is_leap_year(year) { 366 } else { 365 }

/// How many days the month has in that year.
pub fn days_in_month(year: Int, month: Month) -> Int = month_length(year, month_number(month))

/// Returns the month's number, from 1 for January to 12 for December.
pub fn month_number(m: Month) -> Int =
  match m {
    January -> 1,
    February -> 2,
    March -> 3,
    April -> 4,
    May -> 5,
    June -> 6,
    July -> 7,
    August -> 8,
    September -> 9,
    October -> 10,
    November -> 11,
    December -> 12,
  }

/// The month of a number from 1 to 12.
pub fn month_of_number(n: Int) -> Option<Month> =
  if n < 1 || n > 12 { None } else { Some(month_at(n)) }

/// The month's English name.
pub fn month_name(m: Month) -> String =
  match m {
    January -> "January",
    February -> "February",
    March -> "March",
    April -> "April",
    May -> "May",
    June -> "June",
    July -> "July",
    August -> "August",
    September -> "September",
    October -> "October",
    November -> "November",
    December -> "December",
  }

/// The weekday's ISO 8601 number, Monday 1 to Sunday 7.
pub fn weekday_number(day: Weekday) -> Int =
  match day {
    Monday -> 1,
    Tuesday -> 2,
    Wednesday -> 3,
    Thursday -> 4,
    Friday -> 5,
    Saturday -> 6,
    Sunday -> 7,
  }

/// The weekday of an ISO 8601 number from 1 to 7.
pub fn weekday_of_number(n: Int) -> Option<Weekday> =
  if n < 1 || n > 7 { None } else { Some(weekday_at(n - 1)) }

/// The weekday's English name.
pub fn weekday_name(day: Weekday) -> String =
  match day {
    Monday -> "Monday",
    Tuesday -> "Tuesday",
    Wednesday -> "Wednesday",
    Thursday -> "Thursday",
    Friday -> "Friday",
    Saturday -> "Saturday",
    Sunday -> "Sunday",
  }

fn month_at(n: Int) -> Month =
  match n {
    1 -> January,
    2 -> February,
    3 -> March,
    4 -> April,
    5 -> May,
    6 -> June,
    7 -> July,
    8 -> August,
    9 -> September,
    10 -> October,
    11 -> November,
    _ -> December,
  }

fn weekday_at(index: Int) -> Weekday =
  match index {
    0 -> Monday,
    1 -> Tuesday,
    2 -> Wednesday,
    3 -> Thursday,
    4 -> Friday,
    5 -> Saturday,
    _ -> Sunday,
  }

fn weekday_index(days: Int) -> Int = {
  let from_monday = days + 3;
  from_monday - weeks_floor(from_monday) * 7
}

fn weeks_floor(days: Int) -> Int = if days >= 0 { days / 7 } else { (days + 1) / 7 - 1 }

fn week_of_days(days: Int) -> IsoWeek = {
  let thursday = days - weekday_index(days) + 3;
  let year = civil_from_days(thursday).year;
  { year: year, week: (thursday - days_from_civil(year, 1, 1)) / 7 + 1 }
}

/// Returns a `Period` of `n` years.
pub fn years(n: Int) -> Period = { months: n * 12, days: 0 }

/// `n` months.
pub fn months(n: Int) -> Period = { months: n, days: 0 }

/// `n` weeks.
pub fn weeks(n: Int) -> Period = { months: 0, days: n * 7 }

/// `n` days.
pub fn days(n: Int) -> Period = { months: 0, days: n }

/// Returns the sum of two periods: their months added together and their days added together.
pub fn plus(a: Period, b: Period) -> Period = { months: a.months + b.months, days: a.days + b.days }

/// The date `n` days later, or earlier for a negative `n`; `None` past either end of the calendar.
pub fn add_days(d: Date, n: Int) -> Option<Date> =
  match checked_add(unix_days(d), n) { Some(days) -> of_unix_days(days), None -> None }

/// The same day of the month `n` months later, or earlier for a negative `n`. If that month is too
/// short to have the day, `overflow` decides whether the result is its last day or `None`. Past
/// either end of the calendar the result is `None`.
pub fn add_months(d: Date, n: Int, overflow: Overflow) -> Option<Date> = {
  let from = parts(d);
  match checked_add(from.year * 12 + from.month - 1, n) {
    None -> None,
    Some(index) -> if index < 0 || index > 119999 { None } else {
      let year = index / 12;
      let month = index % 12 + 1;
      let length = month_length(year, month);
      if from.day <= length { of(year, month, from.day) }
      else { match overflow { Clamp -> of(year, month, length), Reject -> None } }
    },
  }
}

/// Returns the date `n` years later, or earlier for a negative `n`, by calling `add_months` with `n
/// * 12` months. A 29 February in a year without one is handled as `add_months` handles a day the
/// month lacks: `overflow` chooses 28 February or `None`.
pub fn add_years(d: Date, n: Int, overflow: Overflow) -> Option<Date> =
  match checked_mul(n, 12) { Some(count) -> add_months(d, count, overflow), None -> None }

/// The date a period later: its months first, as `add_months` adds them, and then its days.
pub fn add(d: Date, p: Period, overflow: Overflow) -> Option<Date> =
  match add_months(d, p.months, overflow) {
    Some(add_nanos) -> add_days(add_nanos, p.days),
    None -> None,
  }

/// The days from one date to another, negative when `to` is the earlier.
pub fn days_between(from: Date, to: Date) -> Int = unix_days(to) - unix_days(from)

/// Returns the whole months from one date to another and the days left over, both negative when
/// `to` is the earlier. This is the period that `add` with `Clamp` takes from `from` to `to`. A
/// month counts only when `to` has reached the day of the month that `from` is on, so 31 January to
/// 28 February is 28 days and no months.
pub fn period_between(from: Date, to: Date) -> Period = {
  let a = parts(from);
  let b = parts(to);
  let apart = (b.year - a.year) * 12 + b.month - a.month;
  let whole = if unix_days(to) >= unix_days(from) { if b.day < a.day { apart - 1 } else { apart } }
  else if b.day > a.day { apart + 1 }
  else { apart };
  match add_months(from, whole, Clamp) {
    Some(shifted) -> { months: whole, days: days_between(shifted, to) },
    None -> { months: 0, days: days_between(from, to) },
  }
}

/// The first day of the date's month.
pub fn start_of_month(d: Date) -> Date = Date(unix_days(d) - day(d) + 1)

/// The last day of the date's month.
pub fn end_of_month(d: Date) -> Date = {
  let at = parts(d);
  Date(unix_days(d) - at.day + month_length(at.year, at.month))
}

/// The first day of the date's year.
pub fn start_of_year(d: Date) -> Date = Date(unix_days(d) - day_of_year(d) + 1)

/// The time of an hour from 0 to 23, a minute and a second from 0 to 59, and a nanosecond below a
/// thousand million.
pub fn time(hour: Int, minute: Int, second: Int, nanosecond: Int) -> Option<Time> =
  if hour < 0 || hour > 23 || minute < 0 || minute > 59 || second < 0 || second > 59
      || nanosecond < 0
      || nanosecond > 999999999 { None }
  else { Some(Time(((hour * 60 + minute) * 60 + second) * 1000000000 + nanosecond)) }

/// 00:00:00, the first time of a day.
pub const midnight: Time = Time(0)

/// The time `nanos` nanoseconds after midnight, or `None` for a negative count or a full day or
/// more.
pub fn time_of_nanos(nanos: Int) -> Option<Time> =
  if nanos >= 0 && nanos < day_nanos { Some(Time(nanos)) } else { None }

/// The nanoseconds from midnight to the time.
pub fn nanos_of_day(t: Time) -> Int = match t { Time(nanos) -> nanos }

/// The hour, 0 to 23.
pub fn hour(t: Time) -> Int = nanos_of_day(t) / 3600000000000

/// The minute of the hour, 0 to 59.
pub fn minute(t: Time) -> Int = nanos_of_day(t) / 60000000000 % 60

/// The second of the minute, 0 to 59.
pub fn second(t: Time) -> Int = nanos_of_day(t) / 1000000000 % 60

/// The nanosecond of the second.
pub fn nanosecond(t: Time) -> Int = nanos_of_day(t) % 1000000000

/// The time a duration later on a clock that turns over at midnight, or earlier for a negative one.
pub fn time_after(t: Time, d: Duration) -> Time =
  Time(nanos_in_day(nanos_of_day(t) + nanos_in_day(as_nanos(d))))

/// From one time to another of the same day, negative when `to` is the earlier.
pub fn time_between(from: Time, to: Time) -> Duration = nanos(nanos_of_day(to) - nanos_of_day(from))

/// The time with everything finer than the unit dropped; `Days` is midnight.
pub fn truncate_time(t: Time, to: TimeUnit) -> Time = Time(round_nanos(nanos_of_day(t), to, Down))

/// The time rounded to a whole unit, with `mode` choosing between the one before and the one
/// after. `HalfEven` picks the even count of units since midnight. A time rounded up past the end
/// of the day becomes midnight.
pub fn round_time(t: Time, to: TimeUnit, mode: Rounding) -> Time =
  Time(nanos_in_day(round_nanos(nanos_of_day(t), to, mode)))

fn whole_days(nanos: Int) -> Int =
  if nanos >= 0 { nanos / 86400000000000 } else { (nanos + 1) / 86400000000000 - 1 }

fn nanos_in_day(nanos: Int) -> Int =
  if nanos >= 0 { nanos % 86400000000000 } else { (nanos + 1) % 86400000000000 + 86399999999999 }

type Split = { whole: Int, rest: Int, size: Int }

fn split(nanos: Int, unit: TimeUnit) -> Split =
  match unit {
    Days -> { whole: nanos / 86400000000000, rest: nanos % 86400000000000, size: 86400000000000 },
    Hours -> { whole: nanos / 3600000000000, rest: nanos % 3600000000000, size: 3600000000000 },
    Minutes -> { whole: nanos / 60000000000, rest: nanos % 60000000000, size: 60000000000 },
    Seconds -> { whole: nanos / 1000000000, rest: nanos % 1000000000, size: 1000000000 },
    Milliseconds -> { whole: nanos / 1000000, rest: nanos % 1000000, size: 1000000 },
    Microseconds -> { whole: nanos / 1000, rest: nanos % 1000, size: 1000 },
    Nanoseconds -> { whole: nanos, rest: 0, size: 1 },
  }

fn round_nanos(nanos: Int, unit: TimeUnit, mode: Rounding) -> Int = {
  let s = split(nanos, unit);
  let twice = s.rest * 2;
  let up = match mode {
    Down | Floor -> false,
    Up | Ceiling -> s.rest > 0,
    HalfUp -> twice >= s.size,
    HalfEven -> twice > s.size || (twice == s.size && s.whole % 2 == 1),
  };
  (if up { s.whole + 1 } else { s.whole }) * s.size
}

/// Returns the date-time made from the date `d` and the time of day `t`.
pub fn at(d: Date, t: Time) -> DateTime = DateTime(d, t)

/// Returns the date-time with the given year, month, day, hour, minute and second, and a nanosecond
/// of 0. Returns `None` when `of` rejects the date or `time` rejects the time of day.
pub fn date_time(
  year: Int,
  month: Int,
  day: Int,
  hour: Int,
  minute: Int,
  second: Int,
) -> Option<DateTime> =
  match of(year, month, day) {
    Some(d) -> match time(hour, minute, second, 0) {
      Some(t) -> Some(DateTime(d, t)),
      None -> None,
    },
    None -> None,
  }

/// The date-time's date.
pub fn date_of(dt: DateTime) -> Date = match dt { DateTime(d, _) -> d }

/// The date-time's time of day.
pub fn time_of(dt: DateTime) -> Time = match dt { DateTime(_, t) -> t }

/// The date-time a duration later, every day twenty-four hours long, or earlier for a negative
/// one; `None` past either end of the calendar.
pub fn date_time_after(dt: DateTime, d: Duration) -> Option<DateTime> =
  in_calendar(add_nanos(dt, as_nanos(d)))

/// The date-time a period later at the same time of day, as `add` moves its date.
pub fn date_time_add(dt: DateTime, p: Period, overflow: Overflow) -> Option<DateTime> =
  match add(date_of(dt), p, overflow) { Some(d) -> Some(DateTime(d, time_of(dt))), None -> None }

/// Returns the time from `from` to `to`, negative when `to` is earlier, counting every day as
/// twenty-four hours. Returns `None` when the difference does not fit in a `Duration`.
pub fn date_time_between(from: DateTime, to: DateTime) -> Option<Duration> = {
  let apart = days_between(date_of(from), date_of(to));
  let rest = nanos_of_day(time_of(to)) - nanos_of_day(time_of(from));
  let span = if rest >= 0 { nanos_of_span(apart, rest) }
  else { nanos_of_span(apart - 1, rest + day_nanos) };
  match span { Some(n) -> Some(nanos(n)), None -> None }
}

/// The date-time with everything finer than the unit dropped; `Days` is the date's midnight.
pub fn truncate_date_time(dt: DateTime, to: TimeUnit) -> DateTime =
  DateTime(date_of(dt), truncate_time(time_of(dt), to))

/// The date-time rounded to a whole unit as `round_time` rounds, moving to the next day if rounding
/// passes the end of this one. `None` if the next day is past the end of the calendar.
pub fn round_date_time(dt: DateTime, to: TimeUnit, mode: Rounding) -> Option<DateTime> = {
  let rounded = round_nanos(nanos_of_day(time_of(dt)), to, mode);
  if rounded < day_nanos { Some(DateTime(date_of(dt), Time(rounded))) } else {
    match add_days(date_of(dt), 1) { Some(next) -> Some(DateTime(next, Time(0))), None -> None }
  }
}

fn add_nanos(dt: DateTime, by: Int) -> DateTime =
  match dt {
    DateTime(Date(days), Time(of_day)) -> {
      let within = of_day + nanos_in_day(by);
      if within < day_nanos { DateTime(Date(days + whole_days(by)), Time(within)) }
      else { DateTime(Date(days + whole_days(by) + 1), Time(within - day_nanos)) }
    },
  }

fn in_calendar(dt: DateTime) -> Option<DateTime> =
  if day_in_range(unix_days(date_of(dt))) { Some(dt) } else { None }

/// The date-time as a UTC time.
pub fn utc(dt: DateTime) -> OffsetDateTime = OffsetDateTime(dt, 0)

/// The date-time as shown by a clock `minutes` minutes east of UTC, negative for west. `None` for
/// an offset of a day or more, and when the instant is past either end of the calendar in UTC.
pub fn at_offset(local: DateTime, minutes: Int) -> Option<OffsetDateTime> =
  if minutes < -1439 || minutes > 1439 { None }
  else { offset_date_time(add_nanos(local, -minutes * 60000000000), minutes) }

/// Returns the same instant as shown by a clock `minutes` minutes east of UTC, negative for west.
/// Returns `None` for an offset of a day or more.
pub fn in_offset(o: OffsetDateTime, minutes: Int) -> Option<OffsetDateTime> =
  match o { OffsetDateTime(universal, _) -> offset_date_time(universal, minutes) }

/// The same instant at UTC.
pub fn in_utc(o: OffsetDateTime) -> OffsetDateTime =
  match o { OffsetDateTime(universal, _) -> OffsetDateTime(universal, 0) }

/// Returns the local date-time of `o`: the date and time its own clock shows, without the offset.
pub fn local(o: OffsetDateTime) -> DateTime =
  match o { OffsetDateTime(universal, minutes) -> add_nanos(universal, minutes * 60000000000) }

/// The minutes the clock is east of UTC, negative for west.
pub fn offset_minutes(o: OffsetDateTime) -> Int = match o { OffsetDateTime(_, minutes) -> minutes }

/// Whether the two are the same instant, whatever their offsets.
pub fn same_instant(a: OffsetDateTime, b: OffsetDateTime) -> Bool = in_utc(a) == in_utc(b)

/// The instant a duration later, at the same offset; `None` past either end of the calendar.
pub fn offset_after(o: OffsetDateTime, d: Duration) -> Option<OffsetDateTime> =
  match o {
    OffsetDateTime(universal, minutes) ->
      offset_date_time(add_nanos(universal, as_nanos(d)), minutes),
  }

/// The same clock time a period later, at the same offset, with the date moved as `add` moves it.
pub fn offset_add(o: OffsetDateTime, p: Period, overflow: Overflow) -> Option<OffsetDateTime> =
  match date_time_add(local(o), p, overflow) {
    Some(reading) -> at_offset(reading, offset_minutes(o)),
    None -> None,
  }

/// From one instant to another, or `None` when the span does not fit in a `Duration`.
pub fn offset_between(from: OffsetDateTime, to: OffsetDateTime) -> Option<Duration> =
  date_time_between(local(in_utc(from)), local(in_utc(to)))

/// The instant `seconds` seconds after 1970-01-01T00:00:00Z, at UTC.
pub fn of_unix_seconds(seconds: Int) -> Option<OffsetDateTime> = {
  let days = if seconds >= 0 { seconds / 86400 } else { (seconds + 1) / 86400 - 1 };
  let of_day = if seconds >= 0 { seconds % 86400 } else { (seconds + 1) % 86400 + 86399 };
  offset_date_time(DateTime(Date(days), Time(of_day * 1000000000)), 0)
}

/// The whole seconds from 1970-01-01T00:00:00Z to the instant, negative before it.
pub fn unix_seconds(o: OffsetDateTime) -> Int =
  match o {
    OffsetDateTime(DateTime(Date(days), Time(of_day)), _) -> days * 86400 + of_day / 1000000000,
  }

/// The instant `millis` milliseconds after 1970-01-01T00:00:00Z, at UTC.
pub fn of_unix_millis(millis: Int) -> Option<OffsetDateTime> = {
  let days = if millis >= 0 { millis / 86400000 } else { (millis + 1) / 86400000 - 1 };
  let of_day = if millis >= 0 { millis % 86400000 } else { (millis + 1) % 86400000 + 86399999 };
  offset_date_time(DateTime(Date(days), Time(of_day * 1000000)), 0)
}

/// The whole milliseconds from 1970-01-01T00:00:00Z to the instant.
pub fn unix_millis(o: OffsetDateTime) -> Int =
  match o {
    OffsetDateTime(DateTime(Date(days), Time(of_day)), _) -> days * 86400000 + of_day / 1000000,
  }

/// The `Instant` at UTC, taking it as nanoseconds from 1970-01-01T00:00:00Z.
pub fn of_instant(i: Instant) -> OffsetDateTime =
  OffsetDateTime(DateTime(Date(whole_days(nanos_at(i))), Time(nanos_in_day(nanos_at(i)))), 0)

/// The instant as nanoseconds from 1970-01-01T00:00:00Z, or `None` outside the range of an
/// `Instant`, which is 1677-09-21 to 2262-04-11.
pub fn instant(o: OffsetDateTime) -> Option<Instant> =
  match o {
    OffsetDateTime(DateTime(Date(days), Time(of_day)), _) -> match nanos_of_span(days, of_day) {
      Some(n) -> Some(Instant(n)),
      None -> None,
    },
  }

fn nanos_of_span(days: Int, rest: Int) -> Option<Int> = {
  let whole = if days >= 0 { days } else { days + 1 };
  let part = if days >= 0 { rest } else { rest - day_nanos };
  match checked_mul(whole, day_nanos) { Some(n) -> checked_add(n, part), None -> None }
}

fn offset_date_time(universal: DateTime, minutes: Int) -> Option<OffsetDateTime> =
  if minutes < -1439 || minutes > 1439 { None } else {
    match in_calendar(universal) {
      None -> None,
      Some(_) -> match in_calendar(add_nanos(universal, minutes * 60000000000)) {
        Some(_) -> Some(OffsetDateTime(universal, minutes)),
        None -> None,
      },
    }
  }

/// The date as ISO 8601 and RFC 3339 write it, `2026-10-04`.
pub fn text(d: Date) -> String = {
  let at = parts(d);
  zero_padded(at.year, 4) ++ "-" ++ zero_padded(at.month, 2) ++ "-" ++ zero_padded(at.day, 2)
}

/// Parses an RFC 3339 `full-date`: a four-digit year, a two-digit month and a two-digit day, where
/// the day exists in that month.
pub fn parse(text: String) -> Option<Date> = literal(text).ok()

/// Checks the text of a `date"..."` literal. Returns the date `parse` reads, or an error that says
/// why the text is not a date and at which character position it stops being one.
pub fn literal(text: String) -> Result<Date, Error> = {
  let cs = char_codes(text);
  let read = read_date(cs, 0)?;
  let _ = expect_end(cs, read.at)?;
  Ok(read.value)
}

/// The time as RFC 3339 writes it, `12:30:00`, with as many digits of a fraction as it has.
pub fn time_text(t: Time) -> String = {
  let fraction = nanosecond(t);
  zero_padded(hour(t), 2) ++ ":" ++ zero_padded(minute(t), 2) ++ ":" ++ zero_padded(second(t), 2)
    ++ (if fraction == 0 { "" } else { "." ++ fraction_digits(fraction, 9) })
}

/// Reads an RFC 3339 `partial-time`: `hh:mm:ss`, then an optional fraction of one to nine digits.
/// A second of `60` is rejected, since without an offset it is unknown whether UTC could show one.
pub fn parse_time(text: String) -> Option<Time> = time_literal(text).ok()

/// Behaves like `parse_time`, but returns an error that says why the text is not a time and the
/// offset of the character where it stops being one. The `time"..."` literal syntax uses this
/// function to check its text.
pub fn time_literal(text: String) -> Result<Time, Error> = {
  let cs = char_codes(text);
  let read = read_time(cs, 0)?;
  let _ = expect_end(cs, read.at)?;
  reject_leap_second(read.value, 6)
}

/// The date-time as ISO 8601 writes it, `2026-10-04T12:30:00`.
pub fn date_time_text(dt: DateTime) -> String = text(date_of(dt)) ++ "T" ++ time_text(time_of(dt))

/// Reads a date-time with no offset: an RFC 3339 `full-date`, a `T` or `t`, and a `partial-time`.
pub fn parse_date_time(text: String) -> Option<DateTime> = date_time_literal(text).ok()

/// `parse_date_time`, returning why a text is not a date-time and where.
pub fn date_time_literal(text: String) -> Result<DateTime, Error> = {
  let cs = char_codes(text);
  let date = read_date(cs, 0)?;
  let _ = expect_either(cs, 10, 84, 116, "a `T` goes here")?;
  let clock = read_time(cs, 11)?;
  let _ = expect_end(cs, clock.at)?;
  let time = reject_leap_second(clock.value, 17)?;
  Ok(DateTime(date.value, time))
}

/// The instant as RFC 3339 writes it: the local date-time and its offset, with `Z` for a zero
/// offset.
pub fn rfc3339(o: OffsetDateTime) -> String =
  date_time_text(local(o))
    ++ (if offset_minutes(o) == 0 { "Z" } else { offset_text(offset_minutes(o), ":") })

/// Parses an RFC 3339 `date-time` strictly. `T` and `Z` may be in either case, and the offset is
/// `Z` or a sign followed by `hh:mm`. It accepts nothing beyond RFC 3339, even where ISO 8601 would
/// allow it. `-00:00` is read as UTC.
pub fn parse_rfc3339(text: String) -> Option<OffsetDateTime> = rfc3339_literal(text).ok()

/// `parse_rfc3339`, returning why a text is not an instant and where.
pub fn rfc3339_literal(text: String) -> Result<OffsetDateTime, Error> = {
  let cs = char_codes(text);
  let read = read_rfc3339(cs)?;
  let _ = expect_end(cs, read.at)?;
  Ok(read.value)
}

/// A time zone an RFC 9557 suffix names, as its text: an IANA name or a numeric offset.
pub type ZoneTag = { name: String, critical: Bool }

/// Any other RFC 9557 suffix tag: a key and its value.
pub type SuffixTag = { key: String, value: String, critical: Bool }

/// An RFC 3339 instant with the bracketed suffix RFC 9557 adds to it, stored as text. `critical` is
/// the `!` a tag was written with. A reader that does not act on a critical tag must reject the
/// whole text, and this module acts on none.
pub type ExtendedDateTime = {
  instant: OffsetDateTime,
  zone: Option<ZoneTag>,
  tags: List<SuffixTag>,
}

/// The instant and its suffix as RFC 9557 writes them.
pub fn rfc9557(e: ExtendedDateTime) -> String =
  rfc3339(e.instant)
    ++ (match e.zone { Some(zone) -> bracketed(zone.critical, zone.name), None -> "" })
    ++ e.tags.fold("", |format_fields: String, tag: SuffixTag|
      format_fields ++ bracketed(tag.critical, tag.key ++ "=" ++ tag.value))

/// Reads an RFC 9557 text: an RFC 3339 `date-time`, then an optional zone in brackets, then any
/// number of `key=value` tags in brackets. It does not check whether the zone agrees with the
/// offset.
pub fn parse_rfc9557(text: String) -> Option<ExtendedDateTime> = {
  let cs = char_codes(text);
  match read_rfc3339(cs) {
    Err(_) -> None,
    Ok(read) ->
      read_suffix_tags(
        text.chars(),
        cs,
        read.at,
        { instant: read.value, zone: None, tags: [] },
        cs.len(),
      ),
  }
}

fn bracketed(critical: Bool, inside: String) -> String =
  "[" ++ (if critical { "!" } else { "" }) ++ inside ++ "]"

fn read_suffix_tags(
  chars: List<Char>,
  cs: Array<Int>,
  at: Int,
  so_far: ExtendedDateTime,
  left: Int,
) -> Option<ExtendedDateTime> =
  if at == cs.len() { Some(so_far) }
  else if left <= 0 || code_at(cs, at) != 91 { None } else {
    let critical = code_at(cs, at + 1) == 33;
    let from = if critical { at + 2 } else { at + 1 };
    let close = index_of(cs, from, 93);
    let equals = index_of(cs, from, 61);
    if close < 0 { None } else if equals >= 0 && equals < close {
      if is_suffix_key(cs, from, equals) && is_suffix_values(cs, equals + 1, close) {
        read_suffix_tags(
          chars,
          cs,
          close + 1,
          {
            ..so_far,
            tags: so_far.tags.push({
              key: cut(chars, from, equals),
              value: cut(chars, equals + 1, close),
              critical: critical,
            }),
          },
          left - 1,
        )
      } else { None }
    } else if so_far.zone == None && so_far.tags == [] && is_zone(cs, from, close) {
      read_suffix_tags(
        chars,
        cs,
        close + 1,
        { ..so_far, zone: Some({ name: cut(chars, from, close), critical: critical }) },
        left - 1,
      )
    } else { None }
  }

fn cut(chars: List<Char>, from: Int, to: Int) -> String =
  String::of_chars(chars.drop(from).take(to - from))

fn index_of(cs: Array<Int>, at: Int, code: Int) -> Int =
  match cs.at(at) { None -> -1, Some(c) -> if c == code { at } else { index_of(cs, at + 1, code) } }

fn every(cs: Array<Int>, from: Int, to: Int, ok: (Int) -> Bool) -> Bool =
  range(from, to).fold(true, |so_far: Bool, i: Int| so_far && ok(code_at(cs, i)))

fn is_alpha(c: Int) -> Bool = {
  let lowered = c | 32;
  lowered >= 97 && lowered <= 122
}

fn is_suffix_key(cs: Array<Int>, from: Int, to: Int) -> Bool = {
  let initial = |c: Int| (c >= 97 && c <= 122) || c == 95;
  from < to && initial(code_at(cs, from))
    && every(cs, from, to, |c: Int| initial(c) || is_digit(c) || c == 45)
}

fn is_suffix_values(cs: Array<Int>, from: Int, to: Int) -> Bool =
  from < to && code_at(cs, from) != 45 && code_at(cs, to - 1) != 45
    && every(cs, from, to, |c: Int| is_alpha(c) || is_digit(c) || c == 45)
    && range(from, to - 1).fold(true, |so_far: Bool, i: Int|
      so_far && !(code_at(cs, i) == 45 && code_at(cs, i + 1) == 45))

fn is_zone(cs: Array<Int>, from: Int, to: Int) -> Bool = {
  let first = code_at(cs, from);
  if first == 43 || first == 45 {
    match read_numeric_offset(cs, from) { Ok(read) -> read.at == to, Err(_) -> false }
  } else { from < to && is_zone_name(cs, from, to) }
}

fn is_zone_name(cs: Array<Int>, from: Int, to: Int) -> Bool =
  range(from, to).fold(true, |so_far: Bool, i: Int| {
    let c = code_at(cs, i);
    let starts = i == from || code_at(cs, i - 1) == 47;
    let ends = i + 1 == to || code_at(cs, i + 1) == 47;
    let initial = is_alpha(c) || c == 46 || c == 95;
    so_far
      && (if c == 47 { !starts && !ends }
      else if starts { initial && !(c == 46 && (ends || is_dots_part(cs, i, to))) }
      else { initial || is_digit(c) || c == 45 || c == 43 })
  })

fn is_dots_part(cs: Array<Int>, at: Int, to: Int) -> Bool =
  code_at(cs, at + 1) == 46 && (at + 2 == to || code_at(cs, at + 2) == 47)

type Read<a> = { value: a, at: Int }

type Clock = { time: Time, leap: Bool }

fn char_codes(text: String) -> Array<Int> = Array::of_list(text.chars().map(Int::of_char))

fn code_at(cs: Array<Int>, at: Int) -> Int = match cs.at(at) { Some(c) -> c, None -> -1 }

fn error_at<a>(message: String, offset: Int) -> Result<a, Error> =
  Err({ message: message, offset: offset })

fn expect_end(cs: Array<Int>, at: Int) -> Result<Int, Error> =
  if at == cs.len() { Ok(at) } else { error_at("nothing follows here", at) }

fn expect_char(cs: Array<Int>, at: Int, code: Int, message: String) -> Result<Int, Error> =
  expect_either(cs, at, code, code, message)

fn expect_either(cs: Array<Int>, at: Int, a: Int, b: Int, message: String) -> Result<Int, Error> =
  if code_at(cs, at) == a || code_at(cs, at) == b { Ok(at + 1) } else { error_at(message, at) }

fn digits_end(cs: Array<Int>, at: Int) -> Int =
  match cs.at(at) { Some(c) -> if is_digit(c) { digits_end(cs, at + 1) } else { at }, None -> at }

fn number_at(cs: Array<Int>, at: Int, count: Int) -> Option<Int> =
  if digits_end(cs, at) < at + count { None }
  else { Some(range(at, at + count).fold(0, |n: Int, i: Int| n * 10 + code_at(cs, i) - 48)) }

fn digits(cs: Array<Int>, at: Int, count: Int, message: String) -> Result<Int, Error> =
  match number_at(cs, at, count) { Some(n) -> Ok(n), None -> error_at(message, digits_end(cs, at)) }

fn read_date(cs: Array<Int>, at: Int) -> Result<Read<Date>, Error> = {
  let year = digits(cs, at, 4, "a year is four digits")?;
  let _ = expect_char(cs, at + 4, 45, "a `-` goes here")?;
  let month = digits(cs, at + 5, 2, "a month is two digits")?;
  let _ = expect_char(cs, at + 7, 45, "a `-` goes here")?;
  let day = digits(cs, at + 8, 2, "a day is two digits")?;
  if month < 1 || month > 12 { error_at("a month is 01 to 12", at + 5) } else {
    match of(year, month, day) {
      Some(d) -> Ok({ value: d, at: at + 10 }),
      None ->
        error_at(
          month_name(month_at(month)) ++ " " ++ zero_padded(year, 4) ++ " has days 01 to "
            ++ month_length(year, month).to_string(),
          at + 8,
        ),
    }
  }
}

fn read_time(cs: Array<Int>, at: Int) -> Result<Read<Clock>, Error> = {
  let clock = read_clock(cs, at)?;
  let fraction = read_fraction(cs, at + 8)?;
  Ok({
    value: { time: Time(nanos_of_day(clock.time) + fraction.value), leap: clock.leap },
    at: fraction.at,
  })
}

fn read_clock(cs: Array<Int>, at: Int) -> Result<Clock, Error> = {
  let hour = digits(cs, at, 2, "an hour is two digits")?;
  let _ = expect_char(cs, at + 2, 58, "a `:` goes here")?;
  let minute = digits(cs, at + 3, 2, "a minute is two digits")?;
  let _ = expect_char(cs, at + 5, 58, "a `:` goes here")?;
  let second = digits(cs, at + 6, 2, "a second is two digits")?;
  clock_of(hour, minute, second, at)
}

fn clock_of(hour: Int, minute: Int, second: Int, at: Int) -> Result<Clock, Error> =
  if hour > 23 { error_at("an hour is 00 to 23", at) }
  else if minute > 59 { error_at("a minute is 00 to 59", at + 3) }
  else if second > 60 { error_at("a second is 00 to 59", at + 6) } else {
    Ok({
      time: Time(((hour * 60 + minute) * 60 + min(second, 59)) * 1000000000),
      leap: second == 60,
    })
  }

fn read_fraction(cs: Array<Int>, at: Int) -> Result<Read<Int>, Error> =
  if code_at(cs, at) != 46 { Ok({ value: 0, at: at }) } else {
    let end = digits_end(cs, at + 1);
    let count = end - at - 1;
    if count == 0 { error_at("a fraction has a digit", end) }
    else if count > 9 { error_at("a fraction is nine digits at most", at + 10) } else {
      match number_at(cs, at + 1, count) {
        Some(n) -> Ok({ value: n * pow(10, 9 - count), at: end }),
        None -> error_at("a fraction has a digit", end),
      }
    }
  }

fn reject_leap_second(clock: Clock, at: Int) -> Result<Time, Error> =
  if clock.leap { error_at("a second is 00 to 59", at) } else { Ok(clock.time) }

fn read_offset(cs: Array<Int>, at: Int) -> Result<Read<Int>, Error> =
  if code_at(cs, at) == 90 || code_at(cs, at) == 122 { Ok({ value: 0, at: at + 1 }) }
  else { read_numeric_offset(cs, at) }

fn read_numeric_offset(cs: Array<Int>, at: Int) -> Result<Read<Int>, Error> = {
  let _ = expect_either(cs, at, 43, 45, "an offset is `Z`, or `+` or `-` and hh:mm")?;
  let hours = digits(cs, at + 1, 2, "an offset's hours are two digits")?;
  let _ = expect_char(cs, at + 3, 58, "a `:` goes here")?;
  let minutes = digits(cs, at + 4, 2, "an offset's minutes are two digits")?;
  if hours > 23 { error_at("an offset's hours are 00 to 23", at + 1) }
  else if minutes > 59 { error_at("an offset's minutes are 00 to 59", at + 4) } else {
    let east = hours * 60 + minutes;
    Ok({ value: if code_at(cs, at) == 45 { -east } else { east }, at: at + 6 })
  }
}

fn read_rfc3339(cs: Array<Int>) -> Result<Read<OffsetDateTime>, Error> = {
  let date = read_date(cs, 0)?;
  let _ = expect_either(cs, 10, 84, 116, "a `T` goes here")?;
  let clock = read_time(cs, 11)?;
  let offset = read_offset(cs, clock.at)?;
  let instant = instant_of(date.value, clock.value, offset.value, 17)?;
  Ok({ value: instant, at: offset.at })
}

fn instant_of(
  date: Date,
  clock: Clock,
  minutes: Int,
  seconds_at: Int,
) -> Result<OffsetDateTime, Error> =
  match at_offset(DateTime(date, clock.time), minutes) {
    None -> error_at("in UTC this is outside the years 0000 to 9999", 0),
    Some(o) -> if clock.leap && !ends_utc_month(o) {
      error_at("a second of 60 is valid only at the end of a UTC month", seconds_at)
    } else { Ok(o) },
  }

fn ends_utc_month(o: OffsetDateTime) -> Bool = {
  let universal = local(in_utc(o));
  let time = time_of(universal);
  hour(time) == 23 && minute(time) == 59 && end_of_month(date_of(universal)) == date_of(universal)
}

fn zero_padded(n: Int, width: Int) -> String = n.to_string().pad_left(width, "0")

fn fraction_digits(n: Int, width: Int) -> String =
  if width > 1 && n % 10 == 0 { fraction_digits(n / 10, width - 1) } else { zero_padded(n, width) }

fn offset_text(minutes: Int, between: String) -> String = {
  let east = if minutes < 0 { -minutes } else { minutes };
  (if minutes < 0 { "-" } else { "+" }) ++ zero_padded(east / 60, 2) ++ between
    ++ zero_padded(east % 60, 2)
}

fn abbreviated(name: String) -> String = String::of_chars(name.chars().take(3))

/// The month's name as the RFCs shorten it, `Jan` to `Dec`.
pub fn month_abbreviation(m: Month) -> String = abbreviated(month_name(m))

/// The weekday's name as the RFCs shorten it, `Mon` to `Sun`.
pub fn weekday_abbreviation(day: Weekday) -> String = abbreviated(weekday_name(day))

fn word_at(cs: Array<Int>, at: Int, word: String, any_case: Bool) -> Bool =
  word.chars().fold(at, |i: Int, c: Char|
      if i >= 0 && same_letter(code_at(cs, i), Int::of_char(c), any_case) { i + 1 } else { -1 })
    >= 0

fn same_letter(a: Int, b: Int, any_case: Bool) -> Bool =
  a == b || (any_case && is_alpha(a) && a | 32 == b | 32)

fn name_index_at(
  cs: Array<Int>,
  at: Int,
  names: List<String>,
  any_case: Bool,
) -> Option<Read<Int>> =
  range(0, names.len()).fold(None, |found: Option<Read<Int>>, i: Int|
    match found {
      Some(read) -> Some(read),
      None -> match names.at(i) {
        Some(name) -> if word_at(cs, at, name, any_case) {
          Some({ value: i + 1, at: at + name.len() })
        } else { None },
        None -> None,
      },
    })

const month_names: List<String> = range(1, 13).map(|n: Int| month_name(month_at(n)))

const weekday_names: List<String> = range(0, 7).map(|n: Int| weekday_name(weekday_at(n)))

fn short_month(cs: Array<Int>, at: Int, any_case: Bool) -> Result<Read<Int>, Error> =
  match name_index_at(cs, at, month_names.map(abbreviated), any_case) {
    Some(read) -> Ok(read),
    None -> error_at("a month is `Jan` to `Dec`", at),
  }

fn short_weekday(cs: Array<Int>, at: Int, any_case: Bool) -> Result<Read<Int>, Error> =
  match name_index_at(cs, at, weekday_names.map(abbreviated), any_case) {
    Some(read) -> Ok(read),
    None -> error_at("a weekday is `Mon` to `Sun`", at),
  }

fn expect_word(cs: Array<Int>, at: Int, word: String) -> Result<Int, Error> =
  if word_at(cs, at, word, false) { Ok(at + word.len()) }
  else { error_at("`" ++ word ++ "` goes here", at) }

fn instant_of_fields(
  year: Int,
  month: Int,
  day: Int,
  clock: Clock,
  minutes: Int,
  written_day: Option<Int>,
) -> Result<OffsetDateTime, Error> =
  match of(year, month, day) {
    None -> error_at("no such day", 0),
    Some(d) -> if written_day != None && written_day != Some(weekday_number(weekday(d))) {
      error_at("the date is another day of the week", 0)
    } else { instant_of(d, clock, minutes, 0) },
  }

/// The instant as an HTTP field writes it, RFC 9110's `IMF-fixdate`: in GMT, to the second.
/// Anything finer than a second is dropped.
pub fn http_date(o: OffsetDateTime) -> String = {
  let universal = local(in_utc(o));
  let date = date_of(universal);
  weekday_abbreviation(weekday(date)) ++ ", " ++ zero_padded(day(date), 2) ++ " "
    ++ month_abbreviation(month(date))
    ++ " "
    ++ zero_padded(year(date), 4)
    ++ " "
    ++ time_text(truncate_time(time_of(universal), Seconds))
    ++ " GMT"
}

/// Reads an RFC 9110 `HTTP-date` in any of its three forms, at UTC:
/// `Sun, 06 Nov 1994 08:49:37 GMT`, the obsolete `Sunday, 06-Nov-94 08:49:37 GMT`, and
/// `asctime`'s `Sun Nov  6 08:49:37 1994`. Each is read exactly, and its weekday must match the
/// date.
///
/// The second form has a two-digit year, which the RFC reads relative to the present. `now` gives
/// the present, and a date more than fifty years after it is taken as the one a century earlier.
pub fn parse_http_date(text: String, now: Instant) -> Option<OffsetDateTime> = {
  let cs = char_codes(text);
  match read_fixdate(cs) {
    Ok(o) -> Some(o),
    Err(_) -> match read_rfc850(cs, of_instant(now)) {
      Ok(o) -> Some(o),
      Err(_) -> read_asctime(cs).ok(),
    },
  }
}

fn read_fixdate(cs: Array<Int>) -> Result<OffsetDateTime, Error> = {
  let weekday = short_weekday(cs, 0, false)?;
  let _ = expect_word(cs, 3, ", ")?;
  let day = digits(cs, 5, 2, "a day is two digits")?;
  let _ = expect_char(cs, 7, 32, "a space goes here")?;
  let month = short_month(cs, 8, false)?;
  let _ = expect_char(cs, 11, 32, "a space goes here")?;
  let year = digits(cs, 12, 4, "a year is four digits")?;
  let _ = expect_char(cs, 16, 32, "a space goes here")?;
  let clock = read_clock(cs, 17)?;
  let _ = expect_word(cs, 25, " GMT")?;
  let _ = expect_end(cs, 29)?;
  instant_of_fields(year, month.value, day, clock, 0, Some(weekday.value))
}

fn long_weekday(cs: Array<Int>) -> Result<Read<Int>, Error> =
  match name_index_at(cs, 0, weekday_names, false) {
    Some(read) -> Ok(read),
    None -> error_at("a weekday is `Monday` to `Sunday`", 0),
  }

fn read_rfc850(cs: Array<Int>, now: OffsetDateTime) -> Result<OffsetDateTime, Error> = {
  let weekday = long_weekday(cs)?;
  let at = expect_word(cs, weekday.at, ", ")?;
  let day = digits(cs, at, 2, "a day is two digits")?;
  let _ = expect_char(cs, at + 2, 45, "a `-` goes here")?;
  let month = short_month(cs, at + 3, false)?;
  let _ = expect_char(cs, at + 6, 45, "a `-` goes here")?;
  let year = digits(cs, at + 7, 2, "a year is two digits here")?;
  let _ = expect_char(cs, at + 9, 32, "a space goes here")?;
  let clock = read_clock(cs, at + 10)?;
  let _ = expect_word(cs, at + 18, " GMT")?;
  let _ = expect_end(cs, at + 22)?;
  instant_of_fields(
    century_of(year, month.value, day, clock, now),
    month.value,
    day,
    clock,
    0,
    Some(weekday.value),
  )
}

fn century_of(two: Int, month: Int, day: Int, clock: Clock, now: OffsetDateTime) -> Int = {
  let present = local(now);
  let today = parts(date_of(present));
  let year = today.year / 100 * 100 + two;
  let limit = (today.year + 50, today.month, today.day, nanos_of_day(time_of(present)));
  if compare((year, month, day, nanos_of_day(clock.time)), limit) == Greater { year - 100 }
  else { year }
}

fn padded_day(cs: Array<Int>) -> Result<Int, Error> =
  match number_at(cs, 8, 2) {
    Some(n) -> Ok(n),
    None -> if code_at(cs, 8) == 32 { digits(cs, 9, 1, "a day goes here") }
    else { error_at("a day goes here", 8) },
  }

fn read_asctime(cs: Array<Int>) -> Result<OffsetDateTime, Error> = {
  let weekday = short_weekday(cs, 0, false)?;
  let _ = expect_char(cs, 3, 32, "a space goes here")?;
  let month = short_month(cs, 4, false)?;
  let _ = expect_char(cs, 7, 32, "a space goes here")?;
  let day = padded_day(cs)?;
  let _ = expect_char(cs, 10, 32, "a space goes here")?;
  let clock = read_clock(cs, 11)?;
  let _ = expect_char(cs, 19, 32, "a space goes here")?;
  let year = digits(cs, 20, 4, "a year is four digits")?;
  let _ = expect_end(cs, 24)?;
  instant_of_fields(year, month.value, day, clock, 0, Some(weekday.value))
}

/// The instant as an Internet message writes it, RFC 5322's `date-time`: the local date-time and
/// its offset, to the second.
pub fn rfc5322(o: OffsetDateTime) -> String = {
  let reading = local(o);
  let date = date_of(reading);
  weekday_abbreviation(weekday(date)) ++ ", " ++ zero_padded(day(date), 2) ++ " "
    ++ month_abbreviation(month(date))
    ++ " "
    ++ zero_padded(year(date), 4)
    ++ " "
    ++ time_text(truncate_time(time_of(reading), Seconds))
    ++ " "
    ++ offset_text(offset_minutes(o), "")
}

/// Parses an RFC 5322 `date-time`, including its obsolete forms, and returns `None` if the text is
/// invalid.
///
/// The weekday is optional, but a weekday that is written must match the date. The day has one or
/// two digits, month and weekday names may be in any case, and seconds are optional. White space
/// and parenthesized comments may appear between any two parts.
///
/// A year of two digits is in the 2000s for `00` to `49` and in the 1900s otherwise. For a year of
/// three digits, 1900 is added to the number, so `126` is 2026.
///
/// A zone is a sign and `hhmm`, `UT`, `GMT`, one of the eight North American zone names at the
/// offsets the RFC gives them, or any other run of letters, which the RFC says to read as UTC.
pub fn parse_rfc5322(text: String) -> Option<OffsetDateTime> = read_rfc5322(char_codes(text)).ok()

fn read_rfc5322(cs: Array<Int>) -> Result<OffsetDateTime, Error> = {
  let weekday = leading_weekday(cs, skip_cfws(cs, 0))?;
  let day_at = skip_cfws(cs, weekday.at);
  let day_end = digits_end(cs, day_at);
  let day = digits(cs, day_at, clamp(day_end - day_at, 1, 2), "a day goes here")?;
  let month = short_month(cs, skip_cfws(cs, min(day_end, day_at + 2)), true)?;
  let year = message_year(cs, skip_cfws(cs, month.at))?;
  let hour_at = skip_cfws(cs, year.at);
  let hour = digits(cs, hour_at, 2, "an hour is two digits")?;
  let colon_end = expect_char(cs, skip_cfws(cs, hour_at + 2), 58, "a `:` goes here")?;
  let minute_at = skip_cfws(cs, colon_end);
  let minute = digits(cs, minute_at, 2, "a minute is two digits")?;
  let second = message_second(cs, skip_cfws(cs, minute_at + 2))?;
  let clock = clock_of(hour, minute, second.value, hour_at)?;
  let zone = message_zone(cs, skip_cfws(cs, second.at))?;
  let _ = expect_end(cs, skip_cfws(cs, zone.at))?;
  instant_of_fields(year.value, month.value, day, clock, zone.value, weekday.value)
}

fn skip_cfws(cs: Array<Int>, at: Int) -> Int = cfws_end(cs, at, 0)

fn cfws_end(cs: Array<Int>, at: Int, depth: Int) -> Int =
  match cs.at(at) {
    None -> if depth == 0 { at } else { at + 1 },
    Some(c) -> if depth > 0 {
      if c == 92 { cfws_end(cs, at + 2, depth) }
      else if c == 40 { cfws_end(cs, at + 1, depth + 1) }
      else if c == 41 { cfws_end(cs, at + 1, depth - 1) }
      else { cfws_end(cs, at + 1, depth) }
    } else if c == 32 || c == 9 { cfws_end(cs, at + 1, 0) }
    else if c == 13 && code_at(cs, at + 1) == 10
        && (code_at(cs, at + 2) == 32 || code_at(cs, at + 2) == 9) { cfws_end(cs, at + 3, 0) }
    else if c == 40 { cfws_end(cs, at + 1, 1) }
    else { at },
  }

fn leading_weekday(cs: Array<Int>, at: Int) -> Result<Read<Option<Int>>, Error> =
  if !is_alpha(code_at(cs, at)) { Ok({ value: None, at: at }) } else {
    let name = short_weekday(cs, at, true)?;
    let after = expect_char(cs, skip_cfws(cs, name.at), 44, "a `,` goes here")?;
    Ok({ value: Some(name.value), at: after })
  }

fn message_year(cs: Array<Int>, at: Int) -> Result<Read<Int>, Error> = {
  let end = digits_end(cs, at);
  let count = end - at;
  if count < 2 { error_at("a year is two digits or more", end) }
  else if count > 4 { error_at("a year is 0000 to 9999", at) } else {
    let format_fields = digits(cs, at, count, "a year is two digits or more")?;
    Ok({
      value: if count == 4 { format_fields }
      else if count == 2 && format_fields < 50 { format_fields + 2000 }
      else { format_fields + 1900 },
      at: end,
    })
  }
}

fn message_second(cs: Array<Int>, at: Int) -> Result<Read<Int>, Error> =
  if code_at(cs, at) != 58 { Ok({ value: 0, at: at }) } else {
    let second_at = skip_cfws(cs, at + 1);
    let second = digits(cs, second_at, 2, "a second is two digits")?;
    Ok({ value: second, at: second_at + 2 })
  }

fn message_zone(cs: Array<Int>, at: Int) -> Result<Read<Int>, Error> =
  if is_alpha(code_at(cs, at)) { Ok(named_zone(cs, at)) } else {
    let _ = expect_either(cs, at, 43, 45, "a zone is a sign and four digits, or a name")?;
    let hours = digits(cs, at + 1, 2, "a zone is four digits")?;
    let minutes = digits(cs, at + 3, 2, "a zone is four digits")?;
    if hours > 23 || minutes > 59 {
      error_at("a zone's hours must be 00 to 23 and its minutes 00 to 59", at + 1)
    } else {
      let east = hours * 60 + minutes;
      Ok({ value: if code_at(cs, at) == 45 { -east } else { east }, at: at + 5 })
    }
  }

fn named_zone(cs: Array<Int>, at: Int) -> Read<Int> = {
  let end = letters_end(cs, at);
  let hours = north_american.fold(0, |found: Int, zone: { name: String, hours: Int }|
    if end - at == 3 && word_at(cs, at, zone.name, true) { zone.hours } else { found });
  { value: hours * 60, at: end }
}

const north_american: List<{ name: String, hours: Int }> =
  [
    { name: "EDT", hours: -4 },
    { name: "EST", hours: -5 },
    { name: "CDT", hours: -5 },
    { name: "CST", hours: -6 },
    { name: "MDT", hours: -6 },
    { name: "MST", hours: -7 },
    { name: "PDT", hours: -7 },
    { name: "PST", hours: -8 },
  ]

fn letters_end(cs: Array<Int>, at: Int) -> Int =
  match cs.at(at) { Some(c) -> if is_alpha(c) { letters_end(cs, at + 1) } else { at }, None -> at }

/// A `strftime` pattern, parsed once: what `pattern` returns, and what the formatters and
/// `parse_with` use.
pub type Pattern = new { items: List<Item> }

type Item =
  | Verbatim(String)
  | OfDate(DateField, Padding)
  | OfTime(TimeField, Padding)
  | OfOffset(Bool)

type DateField =
  | FullYear
  | ShortYear
  | MonthNumber
  | MonthName
  | MonthAbbreviation
  | DayOfMonth
  | DayOfYear
  | WeekdayName
  | WeekdayAbbreviation
  | WeekdayNumber
  | WeekdayFromSunday
  | WeekYear
  | WeekOfYear

type TimeField = | Hour24 | Hour12 | Meridiem | MinuteOfHour | SecondOfMinute | Fraction(Int)

type Padding = | Zeros | Spaces | Unpadded

/// The values a pattern reads from a text. `date` is present if the pattern names a whole date,
/// `time` if it names an hour, and `offset` if it has an offset field.
pub type Parsed = { date: Option<Date>, time: Option<Time>, offset: Option<Int> }

/// Parses a `strftime` pattern. Returns an error giving the reason and the position of the `%`
/// where the pattern is invalid.
///
/// Text outside a `%` field is literal. A field starts with `%` and ends with its letter or one of
/// the symbols below. Date fields: `%Y` is the year in four digits and `%y` its last two, `%m` the
/// month, `%d` the day, `%e` the day padded with a space, `%j` the day of the year, `%B` and `%b`
/// the month's name and its first three letters, `%A` and `%a` the same for the weekday, `%u` the
/// weekday numbered from Monday as 1, `%w` the weekday numbered from Sunday as 0, `%G` and `%V` the
/// ISO 8601 week-based year and week number. Time fields: `%H` is the hour, `%I` the hour on a
/// twelve-hour clock, `%p` is `AM` or `PM`, `%M` the minute, `%S` the second, `%N` the nanoseconds,
/// and `%1N` to `%9N` that many digits of the nanoseconds. Offset fields: `%z` is `+hhmm` and `%:z`
/// is `+hh:mm`. `%F` means `%Y-%m-%d`, `%T` means `%H:%M:%S`, and `%R` means `%H:%M`. `%%`, `%n`
/// and `%t` are a percent sign, a line break and a tab. A `-` after the `%` of a numeric field
/// writes the number with no padding, and a `_` pads it with spaces.
///
/// Fields that depend on a locale or a zone name (`%c`, `%x`, `%X`, `%Z`) are not supported.
pub fn pattern(text: String) -> Result<Pattern, Error> = {
  let start: PatternState = { at: 0, items: [], run: [], open: None, rejection: None };
  let end = text.chars().fold(start, compile_char);
  match end.rejection {
    Some(rejection) -> Err(rejection),
    None -> match end.open {
      Some(open) -> error_at("a `%` wants a letter after it", open.at),
      None -> Ok({ items: flush_text(end) }),
    },
  }
}

type Directive = { at: Int, padding: Option<Padding>, width: Option<Int>, colon: Bool }

type PatternState = {
  at: Int,
  items: List<Item>,
  run: List<Char>,
  open: Option<Directive>,
  rejection: Option<Error>,
}

fn flush_text(c: PatternState) -> List<Item> =
  if c.run == [] { c.items } else { c.items.push(Verbatim(String::of_chars(c.run))) }

fn compile_char(c: PatternState, letter: Char) -> PatternState = {
  let next = { ..c, at: c.at + 1 };
  if c.rejection != None { c } else {
    match c.open {
      None -> if letter == '%' {
        { ..next, open: Some({ at: c.at, padding: None, width: None, colon: false }) }
      } else { { ..next, run: c.run.push(letter) } },
      Some(open) -> match with_flag(open, letter) {
        Some(more) -> { ..next, open: Some(more) },
        None -> match directive_items(open, String::of_chars([letter])) {
          Ok(items) -> { ..next, open: None, run: [], items: flush_text(c).concat(items) },
          Err(message) -> { ..next, rejection: Some({ message: message, offset: open.at }) },
        },
      },
    }
  }
}

fn with_flag(open: Directive, letter: Char) -> Option<Directive> = {
  let bare = open.padding == None && open.width == None && !open.colon;
  if letter == '-' && bare { Some({ ..open, padding: Some(Unpadded) }) }
  else if letter == '_' && bare { Some({ ..open, padding: Some(Spaces) }) }
  else if letter == ':' && bare { Some({ ..open, colon: true }) }
  else if letter >= '1' && letter <= '9' && bare {
    Some({ ..open, width: Some(Int::of_char(letter) - 48) })
  } else { None }
}

fn directive_items(open: Directive, letter: String) -> Result<List<Item>, String> = {
  let plain = open.padding == None && open.width == None && !open.colon;
  let padding = match open.padding { Some(chosen) -> chosen, None -> Zeros };
  match numbered_field(letter) {
    Some(item) -> if open.width == None && !open.colon { Ok([item(padding)]) }
    else { Err("`%" ++ letter ++ "` takes `-` or `_` and nothing else") },
    None -> if letter == "N" {
      if open.padding == None && !open.colon {
        Ok([OfTime(Fraction(match open.width { Some(width) -> width, None -> 9 }), Zeros)])
      } else { Err("`%N` takes a count of digits from 1 to 9 and nothing else") }
    } else if letter == "z" {
      if open.padding == None && open.width == None { Ok([OfOffset(open.colon)]) }
      else { Err("`%z` takes `:` and nothing else") }
    } else {
      match unflagged(letter) {
        Ok(items) -> if plain { Ok(items) } else { Err("`%" ++ letter ++ "` takes no flag") },
        Err(message) -> Err(message),
      }
    },
  }
}

fn numbered_field(letter: String) -> Option<(Padding) -> Item> =
  match letter {
    "Y" -> Some(|p: Padding| OfDate(FullYear, p)),
    "y" -> Some(|p: Padding| OfDate(ShortYear, p)),
    "m" -> Some(|p: Padding| OfDate(MonthNumber, p)),
    "d" -> Some(|p: Padding| OfDate(DayOfMonth, p)),
    "j" -> Some(|p: Padding| OfDate(DayOfYear, p)),
    "G" -> Some(|p: Padding| OfDate(WeekYear, p)),
    "V" -> Some(|p: Padding| OfDate(WeekOfYear, p)),
    "H" -> Some(|p: Padding| OfTime(Hour24, p)),
    "I" -> Some(|p: Padding| OfTime(Hour12, p)),
    "M" -> Some(|p: Padding| OfTime(MinuteOfHour, p)),
    "S" -> Some(|p: Padding| OfTime(SecondOfMinute, p)),
    _ -> None,
  }

fn unflagged(letter: String) -> Result<List<Item>, String> =
  match letter {
    "e" -> Ok([OfDate(DayOfMonth, Spaces)]),
    "B" -> Ok([OfDate(MonthName, Unpadded)]),
    "b" -> Ok([OfDate(MonthAbbreviation, Unpadded)]),
    "A" -> Ok([OfDate(WeekdayName, Unpadded)]),
    "a" -> Ok([OfDate(WeekdayAbbreviation, Unpadded)]),
    "u" -> Ok([OfDate(WeekdayNumber, Unpadded)]),
    "w" -> Ok([OfDate(WeekdayFromSunday, Unpadded)]),
    "p" -> Ok([OfTime(Meridiem, Unpadded)]),
    "F" ->
      Ok([
        OfDate(FullYear, Zeros),
        Verbatim("-"),
        OfDate(MonthNumber, Zeros),
        Verbatim("-"),
        OfDate(DayOfMonth, Zeros),
      ]),
    "T" ->
      Ok([
        OfTime(Hour24, Zeros),
        Verbatim(":"),
        OfTime(MinuteOfHour, Zeros),
        Verbatim(":"),
        OfTime(SecondOfMinute, Zeros),
      ]),
    "R" -> Ok([OfTime(Hour24, Zeros), Verbatim(":"), OfTime(MinuteOfHour, Zeros)]),
    "%" -> Ok([Verbatim("%")]),
    "n" -> Ok([Verbatim("\n")]),
    "t" -> Ok([Verbatim("\t")]),
    "c" | "x" | "X" ->
      Err("`%" ++ letter ++ "` depends on the locale, and format patterns have no locale"),
    "Z" ->
      Err(
        "`%Z` writes a zone's name, and an offset has no zone name: use `%z` to write the offset",
      ),
    "f" ->
      Err(
        "`%f` is not a directive: use `%N` to write the nanoseconds or `%6N` to write them as six digits",
      ),
    _ -> Err("`%" ++ letter ++ "` is not a directive"),
  }

/// The instant written by the pattern, with every field taken from the local time at its offset.
pub fn format(p: Pattern, o: OffsetDateTime) -> String = {
  let reading = local(o);
  format_fields(p, {
    date: Some(date_of(reading)),
    time: Some(time_of(reading)),
    offset: Some(offset_minutes(o)),
  })
}

/// The date written by the pattern, or `None` if the pattern needs a time or an offset.
pub fn format_date(p: Pattern, d: Date) -> Option<String> =
  if needs_only(p, true, false) {
    Some(format_fields(p, { date: Some(d), time: None, offset: None }))
  } else { None }

/// The time written by the pattern, or `None` if the pattern needs a date or an offset.
pub fn format_time(p: Pattern, t: Time) -> Option<String> =
  if needs_only(p, false, true) {
    Some(format_fields(p, { date: None, time: Some(t), offset: None }))
  } else { None }

/// The date-time written by the pattern, or `None` if the pattern needs an offset.
pub fn format_date_time(p: Pattern, dt: DateTime) -> Option<String> =
  if needs_only(p, true, true) {
    Some(format_fields(p, { date: Some(date_of(dt)), time: Some(time_of(dt)), offset: None }))
  } else { None }

fn needs_only(p: Pattern, date: Bool, time: Bool) -> Bool =
  p.items.fold(true, |so_far: Bool, item: Item|
    so_far
      && (match item {
        Verbatim(_) -> true,
        OfDate(_, _) -> date,
        OfTime(_, _) -> time,
        OfOffset(_) -> false,
      }))

fn format_fields(p: Pattern, of: Parsed) -> String =
  p.items.fold("", |so_far: String, item: Item|
    so_far
      ++ (match item {
        Verbatim(text) -> text,
        OfDate(field, padding) -> match of.date {
          Some(d) -> date_piece(field, padding, d),
          None -> "",
        },
        OfTime(field, padding) -> match of.time {
          Some(t) -> time_piece(field, padding, t),
          None -> "",
        },
        OfOffset(colon) -> match of.offset {
          Some(minutes) -> offset_text(minutes, if colon { ":" } else { "" }),
          None -> "",
        },
      }))

fn date_piece(field: DateField, padding: Padding, d: Date) -> String =
  match field {
    FullYear -> padded(year(d), 4, padding),
    ShortYear -> padded(year(d) % 100, 2, padding),
    MonthNumber -> padded(month_number(month(d)), 2, padding),
    MonthName -> month_name(month(d)),
    MonthAbbreviation -> month_abbreviation(month(d)),
    DayOfMonth -> padded(day(d), 2, padding),
    DayOfYear -> padded(day_of_year(d), 3, padding),
    WeekdayName -> weekday_name(weekday(d)),
    WeekdayAbbreviation -> weekday_abbreviation(weekday(d)),
    WeekdayNumber -> weekday_number(weekday(d)).to_string(),
    WeekdayFromSunday -> Int::to_string(weekday_number(weekday(d)) % 7),
    WeekYear -> padded(week(d).year, 4, padding),
    WeekOfYear -> padded(week(d).week, 2, padding),
  }

fn time_piece(field: TimeField, padding: Padding, t: Time) -> String =
  match field {
    Hour24 -> padded(hour(t), 2, padding),
    Hour12 -> padded((hour(t) + 11) % 12 + 1, 2, padding),
    Meridiem -> if hour(t) < 12 { "AM" } else { "PM" },
    MinuteOfHour -> padded(minute(t), 2, padding),
    SecondOfMinute -> padded(second(t), 2, padding),
    Fraction(count) -> zero_padded(leading_digits(nanosecond(t), count), count),
  }

fn leading_digits(nanosecond: Int, count: Int) -> Int =
  match count {
    1 -> nanosecond / 100000000,
    2 -> nanosecond / 10000000,
    3 -> nanosecond / 1000000,
    4 -> nanosecond / 100000,
    5 -> nanosecond / 10000,
    6 -> nanosecond / 1000,
    7 -> nanosecond / 100,
    8 -> nanosecond / 10,
    _ -> nanosecond,
  }

fn padded(n: Int, width: Int, padding: Padding) -> String =
  match padding {
    Zeros -> zero_padded(n, width),
    Spaces -> n.to_string().pad_left(width, " "),
    Unpadded -> n.to_string(),
  }

/// Parses a text that was written with the pattern, reading the fields in the pattern's order.
/// Literal text must match exactly.
///
/// A number must have the same padding the pattern writes: zeros or spaces fill the field's full
/// width, and with `-` (no padding) it has between one and the field's width digits. A month or
/// weekday name must be spelled as this module writes it, in English. `%y` is read as POSIX does:
/// `69` to `99` are in the 1900s and the rest are in the 2000s.
///
/// Returns `None` if the text does not match the pattern, if two fields disagree (a weekday that
/// does not match the date, or a day of the year that does not match the month and day), if the
/// date fields are too few to name a date, or if time fields are present without an hour.
pub fn parse_with(p: Pattern, text: String) -> Option<Parsed> = {
  let cs = char_codes(text);
  let start: Option<ScanState> = Some({ at: 0, seen: Map::new() });
  match p.items.fold(start, |so_far: Option<ScanState>, item: Item|
      match so_far { Some(s) -> scan_item(cs, s, item), None -> None }) {
    Some(s) -> if s.at == cs.len() { resolve_fields(s.seen) } else { None },
    None -> None,
  }
}

type ScanState = { at: Int, seen: Map<String, Int> }

fn scan_item(cs: Array<Int>, s: ScanState, item: Item) -> Option<ScanState> =
  match item {
    Verbatim(text) -> if word_at(cs, s.at, text, false) { Some({ ..s, at: s.at + text.len() }) }
    else { None },
    OfDate(field, padding) -> match field {
      FullYear -> scan_number(cs, s, "year", 4, padding),
      ShortYear -> match read_padded_number(cs, s.at, 2, padding) {
        Some(read) ->
          record_field(
            s,
            "year",
            if read.value >= 69 { read.value + 1900 } else { read.value + 2000 },
            read.at,
          ),
        None -> None,
      },
      MonthNumber -> scan_number(cs, s, "month", 2, padding),
      MonthName -> scan_name(cs, s, "month", month_names),
      MonthAbbreviation -> scan_name(cs, s, "month", month_names.map(abbreviated)),
      DayOfMonth -> scan_number(cs, s, "day", 2, padding),
      DayOfYear -> scan_number(cs, s, "day of year", 3, padding),
      WeekdayName -> scan_name(cs, s, "weekday", weekday_names),
      WeekdayAbbreviation -> scan_name(cs, s, "weekday", weekday_names.map(abbreviated)),
      WeekdayNumber -> scan_number(cs, s, "weekday", 1, Zeros),
      WeekdayFromSunday -> match read_padded_number(cs, s.at, 1, Zeros) {
        Some(read) ->
          record_field(s, "weekday", if read.value == 0 { 7 } else { read.value }, read.at),
        None -> None,
      },
      WeekYear -> scan_number(cs, s, "week year", 4, padding),
      WeekOfYear -> scan_number(cs, s, "week", 2, padding),
    },
    OfTime(field, padding) -> match field {
      Hour24 -> scan_number(cs, s, "hour", 2, padding),
      Hour12 -> scan_number(cs, s, "hour of twelve", 2, padding),
      Meridiem -> scan_name(cs, s, "half", ["AM", "PM"]),
      MinuteOfHour -> scan_number(cs, s, "minute", 2, padding),
      SecondOfMinute -> scan_number(cs, s, "second", 2, padding),
      Fraction(count) -> match number_at(cs, s.at, count) {
        Some(n) -> record_field(s, "nanosecond", n * pow(10, 9 - count), s.at + count),
        None -> None,
      },
    },
    OfOffset(colon) -> scan_offset(cs, s, colon),
  }

fn record_field(s: ScanState, name: String, value: Int, at: Int) -> Option<ScanState> =
  match s.seen.get(name) {
    Some(earlier) -> if earlier == value { Some({ ..s, at: at }) } else { None },
    None -> Some({ at: at, seen: s.seen.insert(name, value) }),
  }

fn scan_number(
  cs: Array<Int>,
  s: ScanState,
  name: String,
  width: Int,
  padding: Padding,
) -> Option<ScanState> =
  match read_padded_number(cs, s.at, width, padding) {
    Some(read) -> record_field(s, name, read.value, read.at),
    None -> None,
  }

fn scan_name(cs: Array<Int>, s: ScanState, name: String, names: List<String>) -> Option<ScanState> =
  match name_index_at(cs, s.at, names, false) {
    Some(read) -> record_field(s, name, read.value, read.at),
    None -> None,
  }

fn scan_offset(cs: Array<Int>, s: ScanState, colon: Bool) -> Option<ScanState> = {
  let minutes_at = if colon { s.at + 4 } else { s.at + 3 };
  let sign = code_at(cs, s.at);
  if (sign != 43 && sign != 45) || (colon && code_at(cs, s.at + 3) != 58) { None } else {
    match number_at(cs, s.at + 1, 2) {
      None -> None,
      Some(hours) -> match number_at(cs, minutes_at, 2) {
        None -> None,
        Some(minutes) -> if hours > 23 || minutes > 59 { None } else {
          let east = hours * 60 + minutes;
          record_field(s, "offset", if sign == 45 { -east } else { east }, minutes_at + 2)
        },
      },
    }
  }
}

fn read_padded_number(cs: Array<Int>, at: Int, width: Int, padding: Padding) -> Option<Read<Int>> =
  match padding {
    Zeros -> match number_at(cs, at, width) {
      Some(n) -> Some({ value: n, at: at + width }),
      None -> None,
    },
    Spaces -> {
      let from = spaces_end(cs, at, at + width - 1);
      match number_at(cs, from, at + width - from) {
        Some(n) -> if digits_end(cs, from) >= at + width { Some({ value: n, at: at + width }) }
        else { None },
        None -> None,
      }
    },
    Unpadded -> {
      let count = min(digits_end(cs, at) - at, width);
      match number_at(cs, at, count) {
        Some(n) -> if count > 0 { Some({ value: n, at: at + count }) } else { None },
        None -> None,
      }
    },
  }

fn spaces_end(cs: Array<Int>, at: Int, limit: Int) -> Int =
  match cs.at(at) {
    Some(c) -> if c == 32 && at < limit { spaces_end(cs, at + 1, limit) } else { at },
    None -> at,
  }

fn resolve_fields(fields: Map<String, Int>) -> Option<Parsed> =
  match resolve_date(fields) {
    None -> None,
    Some(date) -> match resolve_time(fields) {
      None -> None,
      Some(time) -> Some({ date: date, time: time, offset: fields.get("offset") }),
    },
  }

fn resolve_date(fields: Map<String, Int>) -> Option<Option<Date>> = {
  let year = fields.get("year");
  let month = fields.get("month");
  let day = fields.get("day");
  let ordinal = fields.get("day of year");
  let named_day = fields.get("weekday");
  let week_year = fields.get("week year");
  let in_week = fields.get("week");
  let by_month: List<Option<Date>> = if month == None && day == None { [] }
  else { [calendar_date(year, month, day)] };
  let by_ordinal: List<Option<Date>> = match ordinal {
    None -> [],
    Some(n) -> [match year { Some(y) -> of_ordinal(y, n), None -> None }],
  };
  let by_week: List<Option<Date>> = if week_year == None && in_week == None { [] }
  else { [week_date(week_year, in_week, named_day)] };
  match by_month.concat(by_ordinal.concat(by_week)) {
    [] -> if year == None && named_day == None { Some(None) } else { None },
    [first, ..rest] -> match first {
      None -> None,
      Some(d) -> if rest.fold(true, |same: Bool, other: Option<Date>| same && other == first)
          && (named_day == None || named_day == Some(weekday_number(weekday(d)))) { Some(Some(d)) }
      else { None },
    },
  }
}

fn calendar_date(year: Option<Int>, month: Option<Int>, day: Option<Int>) -> Option<Date> =
  match ((year, month, day)) { (Some(y), Some(m), Some(d)) -> of(y, m, d), _ -> None }

fn week_date(year: Option<Int>, week: Option<Int>, day: Option<Int>) -> Option<Date> =
  match ((year, week, day)) {
    (Some(y), Some(w), Some(d)) -> match weekday_of_number(d) {
      Some(on) -> of_week(y, w, on),
      None -> None,
    },
    _ -> None,
  }

fn resolve_time(fields: Map<String, Int>) -> Option<Option<Time>> = {
  let of_twelve = match ((fields.get("hour of twelve"), fields.get("half"))) {
    (Some(h), Some(half)) -> if h >= 1 && h <= 12 { [h % 12 + (half - 1) * 12] } else { [-1] },
    (None, None) -> [],
    _ -> [-1],
  };
  let hours = List::concat(match fields.get("hour") { Some(h) -> [h], None -> [] }, of_twelve);
  let part = |name: String| fields.get(name).unwrap_or(0);
  match hours {
    [] -> if fields.contains("minute") || fields.contains("second")
        || fields.contains("nanosecond") { None }
    else { Some(None) },
    [h, ..rest] -> if rest != [] && rest != [h] { None }
    else { time(h, part("minute"), part("second"), part("nanosecond")).map(|t: Time| Some(t)) },
  }
}

fn wrap_count(n: Int) -> Int = if n >= 0 { n % 3720000 } else { (n + 1) % 3720000 + 3719999 }

fn wrap_date(d: Date) -> Date = {
  let n = unix_days(d);
  let round = if n >= 0 { n % 3652425 } else { (n + 1) % 3652425 + 3652424 };
  Date(if round > last_day { round - 3652425 } else { round })
}

fn wrap_time(t: Time) -> Time = Time(nanos_in_day(nanos_of_day(t)))

fn wrap_date_time(dt: DateTime) -> DateTime =
  DateTime(wrap_date(date_of(dt)), wrap_time(time_of(dt)))

fn wrap_offset(minutes: Int) -> Int = {
  let round = if minutes >= 0 { minutes % 2879 } else { (minutes + 1) % 2879 + 2878 };
  if round > 1439 { round - 2879 } else { round }
}

fn wrap_instant(o: OffsetDateTime) -> OffsetDateTime =
  match o {
    OffsetDateTime(universal, minutes) -> {
      let reading = wrap_date_time(universal);
      match offset_date_time(reading, wrap_offset(minutes)) {
        Some(made) -> made,
        None -> OffsetDateTime(reading, 0),
      }
    },
  }

fn to_the_second(o: OffsetDateTime) -> Option<OffsetDateTime> =
  at_offset(truncate_date_time(local(o), Seconds), offset_minutes(o))

fn dates() -> gen::Gen<Date> = gen::map(gen::any_int(), |f0: Int| Date(f0))

fn times() -> gen::Gen<Time> = gen::map(gen::any_int(), |f0: Int| Time(f0))

fn date_times() -> gen::Gen<DateTime> =
  gen::map2(dates(), times(), |f0: Date, f1: Time| DateTime(f0, f1))

/// An `OffsetDateTime` as a test draws one.
pub fn offset_date_times() -> gen::Gen<OffsetDateTime> =
  gen::map2(date_times(), gen::any_int(), |f0: DateTime, f1: Int| OffsetDateTime(f0, f1))

test "a date moved by days and moved back is the date" {
  gen::check2(dates(), gen::any_int(), |d: Date, n: Int| {
    let from = wrap_date(d);
    let by = wrap_count(n) - 1860000;
    match add_days(from, by) { Some(there) -> add_days(there, -by) == Some(from), None -> true }
  })
}

test "a date reads back from its text" {
  gen::check(dates(), |x: Date|
    agrees(|d: Date| parse(text(wrap_date(d))), |d: Date| Some(wrap_date(d)), x))
}

test "a time reads back from its text" {
  gen::check(times(), |x: Time|
    agrees(|t: Time| parse_time(time_text(wrap_time(t))), |t: Time| Some(wrap_time(t)), x))
}

test "a date-time reads back from its text" {
  gen::check(date_times(), |x: DateTime|
    agrees(
      |dt: DateTime| parse_date_time(date_time_text(wrap_date_time(dt))),
      |dt: DateTime| Some(wrap_date_time(dt)),
      x,
    ))
}

test "an instant reads back from its RFC 3339 text" {
  gen::check(offset_date_times(), |x: OffsetDateTime|
    agrees(
      |o: OffsetDateTime| parse_rfc3339(rfc3339(wrap_instant(o))),
      |o: OffsetDateTime| Some(wrap_instant(o)),
      x,
    ))
}

fn in_paris(o: OffsetDateTime) -> ExtendedDateTime =
  {
    instant: wrap_instant(o),
    zone: Some({ name: "Europe/Paris", critical: true }),
    tags: [{ key: "u-ca", value: "gregory", critical: false }],
  }

test "`parse_rfc9557` parses an instant and its bracketed time zone from RFC 9557 text" {
  gen::check(offset_date_times(), |x: OffsetDateTime|
    agrees(
      |o: OffsetDateTime| parse_rfc9557(rfc9557(in_paris(o))),
      |o: OffsetDateTime| Some(in_paris(o)),
      x,
    ))
}

test "an instant reads back from its HTTP date, in UTC and to the second" {
  gen::check(offset_date_times(), |x: OffsetDateTime|
    agrees(
      |o: OffsetDateTime| parse_http_date(http_date(wrap_instant(o)), Instant(0)),
      |o: OffsetDateTime| to_the_second(in_utc(wrap_instant(o))),
      x,
    ))
}

test "an instant reads back from its RFC 5322 date, to the second" {
  gen::check(offset_date_times(), |x: OffsetDateTime|
    agrees(
      |o: OffsetDateTime| parse_rfc5322(rfc5322(wrap_instant(o))),
      |o: OffsetDateTime| to_the_second(wrap_instant(o)),
      x,
    ))
}

fn the_date(text: String) -> Date / {abort.raise} = parse(text).expect(text)

fn the_time(text: String) -> Time / {abort.raise} = parse_time(text).expect(text)

fn the_date_time(text: String) -> DateTime / {abort.raise} = parse_date_time(text).expect(text)

fn the_instant(text: String) -> OffsetDateTime / {abort.raise} = parse_rfc3339(text).expect(text)

fn the_pattern(text: String) -> Pattern / {abort.raise} = pattern(text).ok().expect(text)

fn days_are_consecutive(days: Int, last: Int, year: Int, month: Int, day: Int) -> Bool =
  if days > last { true }
  else if days_from_civil(year, month, day) != days || !is_civil(days, year, month, day) { false }
  else if day < month_length(year, month) {
    days_are_consecutive(days + 1, last, year, month, day + 1)
  } else if month < 12 { days_are_consecutive(days + 1, last, year, month + 1, 1) }
  else { days_are_consecutive(days + 1, last, year + 1, 1, 1) }

fn is_civil(days: Int, year: Int, month: Int, day: Int) -> Bool = {
  let civil = civil_from_days(days);
  civil.year == year && civil.month == month && civil.day == day
}

test "every date from the first to the last is the day after the previous one, and the last date is 9999-12-31" {
  assert(days_are_consecutive(first_day, last_day, 0, 1, 1));
  assert_eq(parts(latest), { year: 9999, month: 12, day: 31 })
}

test "a date is made of a year, a month and a day its month has" {
  assert_eq(of(1970, 1, 1), of_unix_days(0));
  assert_eq(of(2026, 10, 4).map(unix_days), Some(20730));
  assert_eq(of(2000, 2, 29).map(text), Some("2000-02-29"));
  assert_eq(of(1900, 2, 29), None);
  assert_eq(of(2026, 13, 1), None);
  assert_eq(of(2026, 4, 31), None);
  assert_eq(of(2026, 4, 0), None);
  assert_eq(of(-1, 12, 31), None);
  assert_eq(of(10000, 1, 1), None);
  assert_eq(of(0, 1, 1), Some(earliest));
  assert_eq(of(9999, 12, 31), Some(latest));
  assert_eq(of_unix_days(2932897), None)
}

test "a date reads as its year, month, day and weekday" {
  let d = the_date("2026-10-04");
  assert_eq(year(d), 2026);
  assert_eq(month(d), October);
  assert_eq(day(d), 4);
  assert_eq(parts(d), { year: 2026, month: 10, day: 4 });
  assert_eq(weekday(d), Sunday);
  assert_eq(weekday(the_date("1970-01-01")), Thursday);
  assert_eq(weekday(earliest), Saturday);
  assert_eq(weekday(latest), Friday);
  assert_eq(day_of_year(d), 277);
  assert_eq(day_of_year(the_date("2020-12-31")), 366);
  assert_eq(days_in_month(2024, February), 29);
  assert_eq(days_in_month(2100, February), 28);
  assert_eq(days_in_year(2000), 366);
  assert_eq(month_of_number(13), None);
  assert_eq(weekday_of_number(7), Some(Sunday));
  assert_eq(month_abbreviation(September) ++ " " ++ weekday_abbreviation(Wednesday), "Sep Wed")
}

type WeekDate = { date: String, year: Int, week: Int, day: Weekday }

const week_dates: List<WeekDate> =
  [
    { date: "1970-01-01", year: 1970, week: 1, day: Thursday },
    { date: "2021-01-03", year: 2020, week: 53, day: Sunday },
    { date: "2024-12-30", year: 2025, week: 1, day: Monday },
    { date: "2026-01-01", year: 2026, week: 1, day: Thursday },
    { date: "2026-10-04", year: 2026, week: 40, day: Sunday },
    { date: "2027-01-01", year: 2026, week: 53, day: Friday },
    { date: "9999-12-31", year: 9999, week: 52, day: Friday },
  ]

test "`week` returns ISO week {c.week} of year {c.year} for the date {c.date}, and `of_week` converts that week, year and weekday back to the date" for c: WeekDate in week_dates {
  let d = the_date(c.date);
  assert_eq(week(d), { year: c.year, week: c.week });
  assert_eq(weekday(d), c.day);
  assert_eq(of_week(c.year, c.week, c.day), Some(d))
}

test "`of_week` and `of_ordinal` return `None` for a week or day number the year lacks, such as week 53 or day 366 of a common year" {
  assert_eq(of_week(2026, 54, Monday), None);
  assert_eq(of_week(2025, 53, Monday), None);
  assert_eq(of_week(2026, 0, Monday), None);
  assert_eq(week(earliest), { year: -1, week: 52 });
  assert_eq(of_week(-1, 52, Saturday), Some(earliest));
  assert_eq(of_week(-1, 52, Friday), None);
  assert_eq(of_ordinal(2026, 277), Some(the_date("2026-10-04")));
  assert_eq(of_ordinal(2026, 366), None);
  assert_eq(of_ordinal(2024, 366), Some(the_date("2024-12-31")));
  assert_eq(of_ordinal(2026, 0), None)
}

test "`add_months` and `add_years` take a `Clamp` or `Reject` argument for a day missing from the target month, while `add_days` takes none" {
  let end_of_january = the_date("2026-01-31");
  assert_eq(add_months(end_of_january, 1, Clamp), Some(the_date("2026-02-28")));
  assert_eq(add_months(end_of_january, 1, Reject), None);
  assert_eq(add_months(end_of_january, 2, Reject), Some(the_date("2026-03-31")));
  assert_eq(add_months(end_of_january, -2, Clamp), Some(the_date("2025-11-30")));
  assert_eq(add_months(end_of_january, 13, Clamp), Some(the_date("2027-02-28")));
  assert_eq(add_years(the_date("2024-02-29"), 1, Clamp), Some(the_date("2025-02-28")));
  assert_eq(add_years(the_date("2024-02-29"), 4, Reject), Some(the_date("2028-02-29")));
  assert_eq(add_days(end_of_january, 29), Some(the_date("2026-03-01")));
  assert_eq(add_days(the_date("2024-02-28"), 2), Some(the_date("2024-03-01")));
  assert_eq(add_days(latest, 1), None);
  assert_eq(add_days(earliest, -1), None);
  assert_eq(add_months(the_date("9999-12-01"), 1, Clamp), None);
  assert_eq(add_months(the_date("0000-01-31"), -1, Clamp), None);
  assert_eq(add_days(earliest, 9223372036854775807), None)
}

test "a period is months then days, and `period_between` returns the period that, added to the first date, gives the second" {
  assert_eq(years(2), months(24));
  assert_eq(weeks(2), days(14));
  assert_eq(plus(months(1), days(3)), { months: 1, days: 3 });
  let from = the_date("2026-01-31");
  assert_eq(add(from, plus(months(1), days(1)), Clamp), Some(the_date("2026-03-01")));
  assert_eq(add(from, plus(months(1), days(1)), Reject), None);
  assert_eq(period_between(from, the_date("2026-02-28")), { months: 0, days: 28 });
  assert_eq(period_between(from, the_date("2026-03-31")), { months: 2, days: 0 });
  assert_eq(period_between(from, the_date("2026-03-01")), { months: 1, days: 1 });
  assert_eq(period_between(the_date("2026-03-31"), from), { months: -2, days: 0 });
  assert_eq(period_between(the_date("2026-03-01"), from), { months: -1, days: -1 });
  assert_eq(period_between(earliest, latest), { months: 119999, days: 30 });
  assert_eq(days_between(the_date("2026-01-01"), the_date("2027-01-01")), 365);
  assert_eq(days_between(the_date("2027-01-01"), the_date("2026-01-01")), -365);
  assert_eq(start_of_month(the_date("2024-02-17")), the_date("2024-02-01"));
  assert_eq(end_of_month(the_date("2024-02-17")), the_date("2024-02-29"));
  assert_eq(start_of_year(the_date("2024-02-17")), the_date("2024-01-01"))
}

test "dates, times and date-times compare chronologically, and instants compare by the moment they name, whatever their offsets" {
  assert_eq(compare(the_date("2026-10-04"), the_date("2026-10-05")), Less);
  assert_eq(compare(the_date("2027-01-01"), the_date("2026-12-31")), Greater);
  assert_eq(compare(the_time("09:00:00"), the_time("10:00:00")), Less);
  assert_eq(
    compare(the_date_time("2026-10-04T23:59:59"), the_date_time("2026-10-05T00:00:00")),
    Less,
  );
  let noon = the_instant("2026-10-04T12:00:00Z");
  let same = the_instant("2026-10-04T14:00:00+02:00");
  assert_eq(compare(the_instant("2026-10-04T13:59:59+02:00"), noon), Less);
  assert_eq(compare(noon, same), Less);
  assert(noon != same);
  assert(same_instant(noon, same));
  assert_eq(in_utc(same), noon);
  assert_eq(in_offset(noon, 120), Some(same))
}

test "`show` writes each value as ISO 8601 does" {
  let d = the_date("2026-10-04");
  let t = the_time("12:30:00.5");
  assert_eq(f"{d}", "2026-10-04");
  assert_eq(f"{t}", "12:30:00.5");
  assert_eq(f"{at(d, t)}", "2026-10-04T12:30:00.5");
  assert_eq(f"{utc(at(d, t))}", "2026-10-04T12:30:00.5Z");
  assert_eq(f"{[earliest, latest]}", "[0000-01-01, 9999-12-31]")
}

test "a time of day is an hour, a minute, a second and a nanosecond" {
  assert_eq(time(12, 30, 15, 250000000), Some(the_time("12:30:15.25")));
  assert_eq(time(24, 0, 0, 0), None);
  assert_eq(time(23, 60, 0, 0), None);
  assert_eq(time(23, 59, 60, 0), None);
  assert_eq(time(0, 0, 0, 1000000000), None);
  assert_eq(time(0, 0, 0, 0), Some(midnight));
  let t = the_time("23:59:58.123456789");
  assert_eq(hour(t), 23);
  assert_eq(minute(t), 59);
  assert_eq(second(t), 58);
  assert_eq(nanosecond(t), 123456789);
  assert_eq(time_of_nanos(nanos_of_day(t)), Some(t));
  assert_eq(time_of_nanos(86400000000000), None);
  assert_eq(time_after(the_time("23:30:00"), nanos(3600000000000)), the_time("00:30:00"));
  assert_eq(time_after(the_time("00:30:00"), nanos(-3600000000000)), the_time("23:30:00"));
  assert_eq(as_nanos(time_between(the_time("09:00:00"), the_time("08:59:59"))), -1000000000);
  assert_eq(time_text(the_time("07:08:09.000000100")), "07:08:09.0000001")
}

type RoundingCase = { time: String, unit: TimeUnit, mode: Rounding, to: String }

const roundings: List<RoundingCase> =
  [
    { time: "12:34:56.789", unit: Hours, mode: Down, to: "12:00:00" },
    { time: "12:34:56.789", unit: Hours, mode: HalfUp, to: "13:00:00" },
    { time: "12:34:56.789", unit: Minutes, mode: Ceiling, to: "12:35:00" },
    { time: "12:34:56.789", unit: Seconds, mode: HalfEven, to: "12:34:57" },
    { time: "12:34:56.789", unit: Milliseconds, mode: Up, to: "12:34:56.789" },
    { time: "12:34:56.7895", unit: Milliseconds, mode: HalfEven, to: "12:34:56.79" },
    { time: "12:34:56.7885", unit: Milliseconds, mode: HalfEven, to: "12:34:56.788" },
    { time: "12:34:56.7885", unit: Milliseconds, mode: HalfUp, to: "12:34:56.789" },
    { time: "12:34:56.0000005", unit: Microseconds, mode: Floor, to: "12:34:56" },
    { time: "12:34:56.000000001", unit: Nanoseconds, mode: Up, to: "12:34:56.000000001" },
    { time: "12:30:00", unit: Hours, mode: HalfEven, to: "12:00:00" },
    { time: "13:30:00", unit: Hours, mode: HalfEven, to: "14:00:00" },
    { time: "12:00:00", unit: Days, mode: HalfEven, to: "00:00:00" },
    { time: "23:59:59.5", unit: Seconds, mode: HalfUp, to: "00:00:00" },
  ]

test "`round_time` rounds the time {c.time} to whole {c.unit} using rounding mode {c.mode}, and returns {c.to}" for c: RoundingCase in roundings {
  assert_eq(round_time(the_time(c.time), c.unit, c.mode), the_time(c.to))
}

test "`round_date_time` can round up into the next day, but `truncate_date_time` never leaves the date-time's own day" {
  let late = the_date_time("2026-12-31T23:59:59.5");
  assert_eq(round_date_time(late, Seconds, HalfUp), Some(the_date_time("2027-01-01T00:00:00")));
  assert_eq(round_date_time(late, Days, HalfUp), Some(the_date_time("2027-01-01T00:00:00")));
  assert_eq(round_date_time(late, Seconds, Down), Some(the_date_time("2026-12-31T23:59:59")));
  assert_eq(truncate_date_time(late, Days), the_date_time("2026-12-31T00:00:00"));
  assert_eq(truncate_date_time(late, Minutes), the_date_time("2026-12-31T23:59:00"));
  assert_eq(round_date_time(at(latest, the_time("23:59:59.5")), Seconds, HalfUp), None);
  assert_eq(truncate_time(the_time("12:34:56.789"), Seconds), the_time("12:34:56"))
}

test "a calendar day and twenty-four hours are added by different functions" {
  let start = the_date_time("2026-01-31T18:00:00");
  let a_day = nanos(86400000000000);
  assert_eq(date_time_add(start, days(1), Clamp), Some(the_date_time("2026-02-01T18:00:00")));
  assert_eq(date_time_after(start, a_day), Some(the_date_time("2026-02-01T18:00:00")));
  assert_eq(date_time_add(start, months(1), Clamp), Some(the_date_time("2026-02-28T18:00:00")));
  assert_eq(date_time_add(start, months(1), Reject), None);
  assert_eq(
    date_time_after(start, nanos(-64800000000001)),
    Some(the_date_time("2026-01-30T23:59:59.999999999")),
  );
  assert_eq(date_time_between(start, the_date_time("2026-02-01T18:00:00")), Some(a_day));
  assert_eq(date_time_between(at(earliest, midnight), at(latest, midnight)), None);
  assert_eq(date_time_after(at(latest, the_time("23:00:00")), nanos(3600000000000)), None);
  let there = the_instant("2026-01-31T18:00:00+05:30");
  assert_eq(offset_add(there, months(1), Clamp), Some(the_instant("2026-02-28T18:00:00+05:30")));
  assert_eq(offset_after(there, a_day), Some(the_instant("2026-02-01T18:00:00+05:30")));
  assert_eq(offset_between(there, the_instant("2026-01-31T12:30:00Z")), Some(nanos(0)));
  assert_eq(date_time(2026, 1, 31, 18, 0, 0), Some(start));
  assert_eq(date_time(2026, 1, 32, 18, 0, 0), None)
}

test "an instant is a local time at an offset, and Unix time counts from 1970 in UTC" {
  let reading = the_date_time("2026-10-04T12:30:00");
  let there = at_offset(reading, 120).expect("an offset of two hours");
  assert_eq(local(there), reading);
  assert_eq(offset_minutes(there), 120);
  assert_eq(local(in_utc(there)), the_date_time("2026-10-04T10:30:00"));
  assert_eq(unix_seconds(there), 1791109800);
  assert_eq(unix_seconds(utc(reading)), 1791117000);
  assert_eq(of_unix_seconds(0), Some(the_instant("1970-01-01T00:00:00Z")));
  assert_eq(of_unix_seconds(-1), Some(the_instant("1969-12-31T23:59:59Z")));
  assert_eq(of_unix_seconds(253402300799), Some(the_instant("9999-12-31T23:59:59Z")));
  assert_eq(of_unix_seconds(253402300800), None);
  assert_eq(of_unix_millis(-1), Some(the_instant("1969-12-31T23:59:59.999Z")));
  assert_eq(unix_millis(the_instant("1970-01-01T00:00:01.5Z")), 1500);
  assert_eq(unix_seconds(the_instant("1969-12-31T23:59:59.5Z")), -1);
  assert_eq(of_instant(Instant(1500000000)), the_instant("1970-01-01T00:00:01.5Z"));
  assert_eq(of_instant(Instant(-1)), the_instant("1969-12-31T23:59:59.999999999Z"));
  assert_eq(instant(the_instant("1970-01-01T01:00:00+01:00")), Some(Instant(0)));
  assert_eq(
    instant(the_instant("2262-04-11T23:47:16.854775807Z")),
    Some(Instant(9223372036854775807)),
  );
  assert_eq(instant(the_instant("2262-04-11T23:47:16.854775808Z")), None);
  assert_eq(
    instant(the_instant("1677-09-21T00:12:43.145224192Z")),
    Some(Instant(-9223372036854775807 - 1)),
  );
  assert_eq(instant(the_instant("1677-09-21T00:12:43.145224191Z")), None)
}

test "an offset must be under a day, and the local time and the UTC time must both be valid dates in the supported range" {
  let reading = the_date_time("2026-10-04T12:30:00");
  assert_eq(at_offset(reading, 1440), None);
  assert_eq(at_offset(reading, -1440), None);
  assert_eq(at_offset(reading, -1439).map(rfc3339), Some("2026-10-04T12:30:00-23:59"));
  assert_eq(at_offset(at(earliest, midnight), 1), None);
  assert_eq(at_offset(at(latest, the_time("23:59:59")), -1), None);
  assert_eq(parse_rfc3339("0000-01-01T00:00:00+00:01"), None);
  assert_eq(in_offset(utc(at(latest, the_time("23:59:59"))), 1), None);
  assert_eq(
    in_offset(utc(at(earliest, midnight)), 1).map(rfc3339),
    Some("0000-01-01T00:01:00+00:01"),
  )
}

type Rfc3339Example = {
  text: String,
  unix_seconds: Int,
  nanosecond: Int,
  offset: Int,
  written: String,
}

const rfc_3339_examples: List<Rfc3339Example> =
  [
    {
      text: "1985-04-12T23:20:50.52Z",
      unix_seconds: 482196050,
      nanosecond: 520000000,
      offset: 0,
      written: "1985-04-12T23:20:50.52Z",
    },
    {
      text: "1996-12-19T16:39:57-08:00",
      unix_seconds: 851042397,
      nanosecond: 0,
      offset: -480,
      written: "1996-12-19T16:39:57-08:00",
    },
    {
      text: "1990-12-31T23:59:60Z",
      unix_seconds: 662687999,
      nanosecond: 0,
      offset: 0,
      written: "1990-12-31T23:59:59Z",
    },
    {
      text: "1990-12-31T15:59:60-08:00",
      unix_seconds: 662687999,
      nanosecond: 0,
      offset: -480,
      written: "1990-12-31T15:59:59-08:00",
    },
    {
      text: "1937-01-01T12:00:27.87+00:20",
      unix_seconds: -1041337173,
      nanosecond: 870000000,
      offset: 20,
      written: "1937-01-01T12:00:27.87+00:20",
    },
  ]

test "RFC 3339's example {c.text} is read and written" for c: Rfc3339Example in rfc_3339_examples {
  let o = the_instant(c.text);
  assert_eq(unix_seconds(o), c.unix_seconds);
  assert_eq(nanosecond(time_of(local(o))), c.nanosecond);
  assert_eq(offset_minutes(o), c.offset);
  assert_eq(rfc3339(o), c.written)
}

test "RFC 3339's second example is the UTC instant its text states" {
  assert(
    same_instant(the_instant("1996-12-19T16:39:57-08:00"), the_instant("1996-12-20T00:39:57Z")),
  )
}

