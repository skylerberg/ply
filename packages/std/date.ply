test "an HTTP date is written in GMT, to the second, in years of four digits" {
  assert_eq(
    http_date(the_instant("2026-10-04T14:30:00.999+02:00")),
    "Sun, 04 Oct 2026 12:30:00 GMT",
  );
  assert_eq(http_date(the_instant("0000-01-01T00:00:00Z")), "Sat, 01 Jan 0000 00:00:00 GMT");
  assert_eq(http_date(the_instant("9999-12-31T23:59:59Z")), "Fri, 31 Dec 9999 23:59:59 GMT");
  assert_eq(parse_http_date("Sun Nov 16 08:49:37 1994", Instant(0)), None);
  assert_eq(
    parse_http_date("Wed Nov 16 08:49:37 1994", Instant(0)),
    Some(the_instant("1994-11-16T08:49:37Z")),
  )
}

type Message = { text: String, instant: String }

const rfc_5322_examples: List<Message> =
  [
    { text: "Fri, 21 Nov 1997 09:55:06 -0600", instant: "1997-11-21T09:55:06-06:00" },
    { text: "Tue, 1 Jul 2003 10:52:37 +0200", instant: "2003-07-01T10:52:37+02:00" },
    { text: "Thu, 13 Feb 1969 23:32:54 -0330", instant: "1969-02-13T23:32:54-03:30" },
    { text: "Mon, 24 Nov 1997 14:22:01 -0800", instant: "1997-11-24T14:22:01-08:00" },
    {
      text: "Thu,\r\n      13\r\n        Feb\r\n          1969\r\n      23:32\r\n               -0330 (Newfoundland Time)",
      instant: "1969-02-13T23:32:00-03:30",
    },
    { text: "21 Nov 97 09:55:06 GMT", instant: "1997-11-21T09:55:06Z" },
    {
      text: "Fri, 21 Nov 1997 09(comment):   55  :  06 -0600",
      instant: "1997-11-21T09:55:06-06:00",
    },
  ]

test "RFC 5322's example {show(c.text)} is read as `{c.instant}`" for c: Message in rfc_5322_examples {
  assert_eq(parse_rfc5322(c.text).map(rfc3339), Some(c.instant))
}

const obsolete_dates: List<Message> =
  [
    { text: "1 Jan 49 00:00 UT", instant: "2049-01-01T00:00:00Z" },
    { text: "1 Jan 50 00:00 UT", instant: "1950-01-01T00:00:00Z" },
    { text: "1 Jan 100 00:00 UT", instant: "2000-01-01T00:00:00Z" },
    { text: "1 Jan 126 00:00 UT", instant: "2026-01-01T00:00:00Z" },
    { text: "4 Oct 2026 12:30 EDT", instant: "2026-10-04T12:30:00-04:00" },
    { text: "4 Oct 2026 12:30 est", instant: "2026-10-04T12:30:00-05:00" },
    { text: "4 Oct 2026 12:30 CDT", instant: "2026-10-04T12:30:00-05:00" },
    { text: "4 Oct 2026 12:30 CST", instant: "2026-10-04T12:30:00-06:00" },
    { text: "4 Oct 2026 12:30 MDT", instant: "2026-10-04T12:30:00-06:00" },
    { text: "4 Oct 2026 12:30 MST", instant: "2026-10-04T12:30:00-07:00" },
    { text: "4 Oct 2026 12:30 PDT", instant: "2026-10-04T12:30:00-07:00" },
    { text: "4 Oct 2026 12:30 PST", instant: "2026-10-04T12:30:00-08:00" },
    { text: "4 Oct 2026 12:30 A", instant: "2026-10-04T12:30:00Z" },
    { text: "4 Oct 2026 12:30 CET", instant: "2026-10-04T12:30:00Z" },
    { text: "4 Oct 2026 12:30 -0000", instant: "2026-10-04T12:30:00Z" },
    { text: "SUN , 4 oct 2026 12:30:15 +0530", instant: "2026-10-04T12:30:15+05:30" },
    {
      text: "(a (nested \\) one)) 4 Oct 2026 12:30 +0000 (and after)",
      instant: "2026-10-04T12:30:00Z",
    },
    { text: "4Oct2026 12:30+0000", instant: "2026-10-04T12:30:00Z" },
  ]

test "RFC 5322 reads `{c.text}` as {c.instant}" for c: Message in obsolete_dates {
  assert_eq(parse_rfc5322(c.text).map(rfc3339), Some(c.instant))
}

const not_rfc_5322: List<String> =
  [
    "",
    "Sat, 4 Oct 2026 12:30 +0000",
    "4 Oct 2026 12:30",
    "4 Oct 2026 12 +0000",
    "4 Oct 2026 1230 +0000",
    "4 October 2026 12:30 +0000",
    "4 Oct 6 12:30 +0000",
    "4 Oct 20260 12:30 +0000",
    "32 Oct 2026 12:30 +0000",
    "004 Oct 2026 12:30 +0000",
    "4 Oct 2026 24:00 +0000",
    "4 Oct 2026 12:30 +2400",
    "4 Oct 2026 12:30 +0060",
    "4 Oct 2026 12:30 +00:00",
    "4 Oct 2026 12:30 +0000 trailing",
    "4 Oct 2026 12:30 +0000 (unclosed",
    "Sun 4 Oct 2026 12:30 +0000",
    "4 Oct 2026\r\n12:30 +0000",
  ]

test "RFC 5322 does not allow {show(c)}" for c: String in not_rfc_5322 {
  assert_eq(parse_rfc5322(c), None)
}

test "an RFC 5322 date is written with its weekday and offset, to the second" {
  assert_eq(
    rfc5322(the_instant("1997-11-21T09:55:06.75-06:00")),
    "Fri, 21 Nov 1997 09:55:06 -0600",
  );
  assert_eq(rfc5322(the_instant("2026-10-04T12:30:00Z")), "Sun, 04 Oct 2026 12:30:00 +0000");
  assert_eq(rfc5322(the_instant("2026-10-04T12:30:00+05:30")), "Sun, 04 Oct 2026 12:30:00 +0530")
}

const faulty_patterns: List<ErrorCase> =
  [
    { text: "%Y-%m-%", message: "a `%` wants a letter after it", offset: 6 },
    { text: "%Y %Q", message: "`%Q` is not a directive", offset: 3 },
    {
      text: "at %c",
      message: "`%c` depends on the locale, and format patterns have no locale",
      offset: 3,
    },
    {
      text: "%H:%M %Z",
      message: "`%Z` writes a zone's name, and an offset has no zone name: use `%z` to write the offset",
      offset: 6,
    },
    {
      text: "%S.%f",
      message: "`%f` is not a directive: use `%N` to write the nanoseconds or `%6N` to write them as six digits",
      offset: 3,
    },
    { text: "%-B", message: "`%B` takes no flag", offset: 0 },
    { text: "%3Y", message: "`%Y` takes `-` or `_` and nothing else", offset: 0 },
    { text: "%:H", message: "`%H` takes `-` or `_` and nothing else", offset: 0 },
    {
      text: "%-N",
      message: "`%N` takes a count of digits from 1 to 9 and nothing else",
      offset: 0,
    },
    { text: "%3z", message: "`%z` takes `:` and nothing else", offset: 0 },
    { text: "%--d", message: "`%-` is not a directive", offset: 0 },
    { text: "%0d", message: "`%0` is not a directive", offset: 0 },
  ]

test "the pattern `{c.text}` is rejected at {c.offset}: {c.message}" for c: ErrorCase in faulty_patterns {
  assert_eq(pattern(c.text).err(), Some({ message: c.message, offset: c.offset }))
}

type FormatCase = { pattern: String, text: String }

const written_patterns: List<FormatCase> =
  [
    { pattern: "%Y-%m-%dT%H:%M:%S%:z", text: "2026-03-04T05:06:07+05:30" },
    { pattern: "%FT%T.%3N%z", text: "2026-03-04T05:06:07.089+0530" },
    { pattern: "%A, %-d %B %Y", text: "Wednesday, 4 March 2026" },
    { pattern: "%a %b %e %R %y", text: "Wed Mar  4 05:06 26" },
    { pattern: "%I:%M %p", text: "05:06 AM" },
    { pattern: "%-I.%M%p", text: "5.06AM" },
    { pattern: "%_H|%_m|%-j|%j", text: " 5| 3|63|063" },
    { pattern: "%G-W%V-%u (%w)", text: "2026-W10-3 (3)" },
    { pattern: "%N %6N %1N", text: "089123456 089123 0" },
    { pattern: "100%% done%n%t.", text: "100% done\n\t." },
    { pattern: "", text: "" },
  ]

test "`{c.pattern}` writes {show(c.text)}" for c: FormatCase in written_patterns {
  assert_eq(
    format(the_pattern(c.pattern), the_instant("2026-03-04T05:06:07.089123456+05:30")),
    c.text,
  )
}

test "formatting a date, a time or a date-time with a pattern returns `None` when the pattern needs a field the value lacks" {
  let d = the_date("2026-03-04");
  let t = the_time("17:06:07");
  assert_eq(format_date(the_pattern("%d/%m/%Y"), d), Some("04/03/2026"));
  assert_eq(format_date(the_pattern("%d/%m/%Y %H"), d), None);
  assert_eq(format_time(the_pattern("%-I %p"), t), Some("5 PM"));
  assert_eq(format_time(the_pattern("%I %p"), midnight), Some("12 AM"));
  assert_eq(format_time(the_pattern("%I %p"), the_time("12:00:00")), Some("12 PM"));
  assert_eq(format_time(the_pattern("%F"), t), None);
  assert_eq(format_date_time(the_pattern("%F %T"), at(d, t)), Some("2026-03-04 17:06:07"));
  assert_eq(format_date_time(the_pattern("%F %T %z"), at(d, t)), None)
}

test "`parse_with` returns the date, time and offset that a pattern names, and `None` for each part it does not name" {
  let d = the_date("2026-03-04");
  assert_eq(
    parse_with(the_pattern("%d/%m/%Y"), "04/03/2026"),
    Some({ date: Some(d), time: None, offset: None }),
  );
  assert_eq(
    parse_with(the_pattern("%Y-%j"), "2026-063"),
    Some({ date: Some(d), time: None, offset: None }),
  );
  assert_eq(
    parse_with(the_pattern("%G-W%V-%u"), "2026-W10-3"),
    Some({ date: Some(d), time: None, offset: None }),
  );
  assert_eq(
    parse_with(the_pattern("%a %b %e %y, %-I.%M%p"), "Wed Mar  4 26, 5.06PM"),
    Some({ date: Some(d), time: time(17, 6, 0, 0), offset: None }),
  );
  assert_eq(
    parse_with(the_pattern("%H:%M:%S.%3N %z"), "05:06:07.089 -0330"),
    Some({ date: None, time: time(5, 6, 7, 89000000), offset: Some(-210) }),
  );
  assert_eq(
    parse_with(the_pattern("%I %p"), "12 AM"),
    Some({ date: None, time: Some(midnight), offset: None }),
  );
  assert_eq(
    parse_with(the_pattern("%d %b %y"), "04 Mar 69"),
    Some({ date: of(1969, 3, 4), time: None, offset: None }),
  );
  assert_eq(
    parse_with(the_pattern("at %%"), "at %"),
    Some({ date: None, time: None, offset: None }),
  )
}

type ParseFailureCase = { pattern: String, text: String }

const parse_failures: List<ParseFailureCase> =
  [
    { pattern: "%d/%m/%Y", text: "4/3/2026" },
    { pattern: "%d/%m/%Y", text: "04/03/2026 " },
    { pattern: "%d/%m/%Y", text: "31/04/2026" },
    { pattern: "%d/%m", text: "04/03" },
    { pattern: "%Y", text: "2026" },
    { pattern: "%A", text: "Wednesday" },
    { pattern: "%A %F", text: "Thursday 2026-03-04" },
    { pattern: "%A %F", text: "wednesday 2026-03-04" },
    { pattern: "%F %j", text: "2026-03-04 064" },
    { pattern: "%F %Y", text: "2026-03-04 2027" },
    { pattern: "%M:%S", text: "06:07" },
    { pattern: "%I:%M", text: "05:06" },
    { pattern: "%H %p", text: "05 AM" },
    { pattern: "%I %p", text: "13 PM" },
    { pattern: "%H %I %p", text: "17 05 AM" },
    { pattern: "%H:%M", text: "24:00" },
    { pattern: "%z", text: "Z" },
    { pattern: "%z", text: "+05:30" },
    { pattern: "%:z", text: "+0530" },
    { pattern: "%-d", text: "" },
    { pattern: "%e/%m/%Y", text: "4/03/2026" },
  ]

test "`{c.pattern}` does not read `{c.text}`" for c: ParseFailureCase in parse_failures {
  assert_eq(parse_with(the_pattern(c.pattern), c.text), None)
}
