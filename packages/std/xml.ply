//! Reads and writes XML 1.0 (Fifth Edition) with Namespaces in XML 1.0. It has a reader that
//! returns a document as events, a tree built from those events, a writer that escapes text, and
//! the `xml"..."` literal.
//!
//! A document type declaration is rejected with `Doctype` wherever it appears. This departs from
//! the standard on purpose: a conforming non-validating processor reads `<!DOCTYPE ...>` and the
//! entities and attribute defaults in its internal subset, but this module reads no document that
//! contains one. Without a declaration there are no external entities, no parameter entities and no
//! entities to expand. The only references are `&lt;`, `&gt;`, `&amp;`, `&apos;`, `&quot;` and
//! numeric references, and each must name a character a document may contain. Every reader takes
//! `Limits`, and no reader nests deeper than `maximum_depth`, whatever the limits say.
//!
//! `start` and `next` are the reader. `start` returns a `Cursor` over the bytes. `next` takes a
//! cursor and returns the next `Event` and the cursor after it. A caller can stop at any point,
//! `skip` a subtree, or build one with `subtree`. The reader checks every well-formedness and
//! namespace rule, and `read` and `parse` build the tree from its events. Character data,
//! references and CDATA sections between two pieces of markup become one `Characters` event and one
//! `Text` node, so a CDATA section cannot be told apart from the text it contains. Line ends are
//! read as line feeds (§2.11). An attribute value is normalized as §3.3.3 does for type CDATA,
//! which is the type of every attribute when the document has no declaration.
//!
//! A `Name` is a namespace name and a local name. The prefix a document used for a name, and the
//! namespace declarations on an element, are stored as `Spelling`s. `write` writes a tree with the
//! prefixes it was read with. No comparison looks at a `Spelling`, so two trees that differ only in
//! prefixes are `==`. `write` declares a namespace where a name first needs it, and invents the
//! prefixes `ns1`, `ns2` and so on when the tree gives none. It rejects a tree that no document can
//! represent instead of writing something that reads back as a different tree: `parse(write(d,
//! Compact), limits)` is `d` for every tree `write` writes.
//!
//! UTF-8 is read with or without a byte order mark, and UTF-16 only with one. Any other encoding is
//! rejected by name. An error carries its byte offset, line and column, counted in the document as
//! UTF-8. For a UTF-16 document these are not positions in its own bytes. `write` writes UTF-8.
//!
//! With `import std.xml`, `xml"<a href={chars(url)}>{rows}</a>"` is an `Element`: the compiler
//! reads the literal's text as one element. Each `{...}` placeholder is a `List<Node>`. In element
//! content it becomes those nodes, and in an attribute value it becomes their text, so nothing
//! inside a placeholder is read as markup.

import std.bytes
import std.bytes (hex_value)
import std.laws (agrees)
import std.list
import std.option
import std.string
import std.gen

/// The namespace the prefix `xml` is bound to in every document.
pub const xml_namespace: String = "http://www.w3.org/XML/1998/namespace"

/// The namespace of namespace declarations themselves. No name may be written in it.
pub const xmlns_namespace: String = "http://www.w3.org/2000/xmlns/"

/// The most elements any reader here has open at once, and the deepest tree `write` writes. The
/// tree functions nest a few calls per level, so documents are bounded at a depth where they still
/// return.
pub const maximum_depth: Int = 1000

/// Something a document wrote that no comparison looks at: every `Spelling` is `==` every other, so
/// a value compares by the rest of its contents.
pub type Spelling<a> = | Spelling(a)

key for Spelling by spelling_key

fn spelling_key<a>(_: Spelling<a>) -> Unit = ()

/// The value inside a `Spelling`.
pub fn spelling_value<a>(s: Spelling<a>) -> a = match s { Spelling(x) -> x }

/// An element's or an attribute's name: its namespace name, `""` for none, and its local name.
/// `prefix` is the one it was written with, `""` for none, which `write` uses where it can.
pub type Name = new { namespace: String, local: String, prefix: Spelling<String> }

/// A name in no namespace.
pub fn name(local: String) -> Name = { namespace: "", local: local, prefix: Spelling("") }

/// A name in `namespace`, for `write` to write with whatever prefix is in scope.
pub fn qualified(namespace: String, local: String) -> Name =
  { namespace: namespace, local: local, prefix: Spelling("") }

/// Returns a name in `namespace`. `write` uses `prefix` for it unless `prefix` is already bound to
/// a different namespace in scope.
pub fn prefixed(namespace: String, prefix: String, local: String) -> Name =
  { namespace: namespace, local: local, prefix: Spelling(prefix) }

/// An attribute: its name, and its value with references replaced and white space normalized.
pub type Attribute = new { name: Name, value: String }

/// An attribute.
pub fn attribute(name: Name, value: String) -> Attribute = { name: name, value: value }

/// A namespace declaration: `xmlns:prefix="namespace"`, or `xmlns="namespace"` where `prefix` is
/// `""`. The default one with `namespace` `""` puts unprefixed elements back in no namespace.
pub type Binding = new { prefix: String, namespace: String }

/// What may appear anywhere in a document and is not part of its data: a comment's text, or a
/// processing instruction's target and data.
pub type Miscellaneous = | Comment(String) | Instruction(String, String)

/// One child of an element.
pub type Node = | Element(Element) | Text(String) | Miscellaneous(Miscellaneous)

/// An element: its name, its attributes in document order with no namespace declaration among them,
/// and its children. `declared` is the declarations its start tag carried, in order.
pub type Element = new {
  name: Name,
  attributes: List<Attribute>,
  children: List<Node>,
  declared: Spelling<List<Binding>>,
}

/// An element with no declarations of its own. Adjacent text nodes become one and an empty one is
/// dropped, which is how a document reads them back.
pub fn element(name: Name, attributes: List<Attribute>, children: List<Node>) -> Element =
  {
    name: name,
    attributes: attributes,
    children: flush_text(children.fold({ nodes: [], text: [] }, join_text)),
    declared: Spelling([]),
  }

type JoinState = { nodes: List<Node>, text: List<Bytes> }

fn join_text(j: JoinState, node: Node) -> JoinState =
  match node {
    Text(t) -> { ..j, text: j.text.push(Bytes::of_string(t)) },
    _ -> { nodes: flush_text(j).push(node), text: [] },
  }

fn flush_text(j: JoinState) -> List<Node> = {
  let text = String::of_bytes_lossy(Bytes::concat_all(j.text));
  if text == "" { j.nodes } else { j.nodes.push(Text(text)) }
}

/// An XML declaration: its version, the encoding it names, and its `standalone` value.
pub type Declaration = new { version: String, encoding: Option<String>, standalone: Option<Bool> }

/// A document: its root element and the comments and instructions before and after it.
/// `declaration` is the XML declaration it opened with.
pub type Document = new {
  declaration: Spelling<Option<Declaration>>,
  before: List<Miscellaneous>,
  root: Element,
  after: List<Miscellaneous>,
}

/// The document that is `root` and nothing else.
pub fn document(root: Element) -> Document =
  { declaration: Spelling(None), before: [], root: root, after: [] }

/// Why a reader rejected bytes, or `write` a tree.
pub type ErrorKind =
  /// A document type declaration, which this module reads no part of.
  | Doctype
  /// An encoding other than UTF-8, or UTF-16 under a byte order mark, by the name the document
  /// declares or its first bytes show.
  | Encoding(String)
  /// Bytes that are not UTF-8.
  | NotUtf8
  /// UTF-16 with half a code unit, or a surrogate that has no pair.
  | NotUtf16
  /// A character a document cannot contain at that position, by its code point: a control other
  /// than tab, line feed and carriage return, U+FFFE or U+FFFF. For `write`, also a carriage return
  /// in a comment or an instruction, which a reader would return as a line feed.
  | IllegalChar(Int)
  /// The document ends inside its root element or inside a piece of markup.
  | Truncated
  /// The document contains no element.
  | NoRoot
  /// Text, a reference, a CDATA section, an end tag or a second element outside the root element.
  | OutsideRoot
  /// A `<` that opens no valid markup.
  | BadMarkup
  /// A name is missing where one is required, or has a colon where namespaces allow none.
  | BadName
  /// A tag malformed past its name: an attribute with no space before it, a `/` with no `>`, or
  /// anything in an end tag but its name.
  | BadTag
  /// An attribute with no `=`, or a value with no quotes.
  | BadAttribute
  /// A `<` in an attribute's value.
  | LessThanInValue
  /// An attribute an element has twice, by its name as written: twice with the same prefix, or
  /// under two prefixes bound to one namespace.
  | DuplicateAttribute(String)
  /// An end tag that does not close the open element, with the open element's name as written.
  | Mismatched(String)
  /// `--` inside a comment, or a comment that ends in `-`.
  | DoubleHyphen
  /// `]]>` in text.
  | CDataEnd
  /// A processing instruction that is malformed. Reading and writing both reject the target `xml`
  /// in any letter case. Reading also rejects a target followed by anything but white space or
  /// `?>`. Writing also rejects data that contains `?>` or begins with white space.
  | BadInstruction
  /// An XML declaration that is malformed, or whose version is not `1.` followed by one or more
  /// digits.
  | BadDeclaration
  /// An `&` that begins no `&name;`, `&#digits;` or `&#xhex;`.
  | BadReference
  /// A reference to an entity other than the five predefined ones (`lt`, `gt`, `amp`, `apos`,
  /// `quot`), carrying the entity's name.
  | UnknownEntity(String)
  /// A numeric reference to a number that is not a valid XML character, carrying that number. Valid
  /// characters are tab, line feed, carriage return, and the code points from `0x20` to `0x10FFFF`
  /// except surrogates, `0xFFFE` and `0xFFFF`. A number of `0x110000` or more is reported as
  /// `0x110000`.
  | IllegalReference(Int)
  /// A prefix no declaration in scope binds.
  | UnboundPrefix(String)
  /// A namespace declaration that no document may contain, carrying its prefix. These are:
  /// declaring the prefix `xmlns`; binding `xml` to any namespace other than the XML namespace;
  /// binding any other prefix to the XML namespace or the `xmlns` namespace; and binding a prefix
  /// to the empty namespace. For `write`, it also means declaring one prefix twice on one element.
  /// It also reports an element or attribute name written with the prefix `xmlns`.
  | BadNamespace(String)
  /// For `write`: a local name, prefix or instruction target that is not a valid name or that
  /// contains a colon, or an attribute with no namespace whose name is `xmlns`.
  | NotAName(String)
  /// For `write`: an empty text node, or two text nodes next to each other. Reading the written
  /// document would not return the same nodes.
  | SplitText
  /// Elements nested past `Limits.max_depth` or `maximum_depth`.
  | TooDeep
  /// More attributes on an element than `Limits.max_attributes`.
  | TooManyAttributes
  /// A name longer than `Limits.max_name_bytes`.
  | NameTooLong
  /// Text, a value, a comment or an instruction's data longer than `Limits.max_text_bytes`.
  | TextTooLong
  /// More events than `Limits.max_events`.
  | TooManyEvents
  /// A document longer than `Limits.max_document_bytes`.
  | TooLarge

/// A reading error. It gives the reason, the byte offset where it happened in the document as
/// UTF-8, and the line and column of that offset. Line and column count from 1, and the column
/// counts characters.
pub type Error = new { at: Int, line: Int, column: Int, reason: ErrorKind }

/// The effects this module raises when it rejects its input.
pub effect xml {
  /// The bytes are not a document this module reads.
  raise fail(e: Error)
  /// The tree is not one a document can represent.
  raise unwritable(reason: ErrorKind)
}

/// A place in a document: a byte offset, and the line and column that offset falls on. The line and
/// column count from 1; the offset counts from 0.
pub type Position = new { offset: Int, line: Int, column: Int }

/// Returns the position of `offset` in `data`, read as UTF-8. A line ends at a line feed, a
/// carriage return, or a carriage return followed by a line feed. The column counts characters and
/// ignores a byte order mark at the start of `data`. An offset outside `data` is clamped to its
/// start or end. The cost grows with the number of bytes before `offset`.
pub fn position(data: Bytes, offset: Int) -> Position / {abort.raise} = {
  let at = min(max(offset, 0), data.len());
  let marked = if data.starts_with(b"\xef\xbb\xbf") { 3 } else { 0 };
  let line = line_of(data, at, min(marked, at), 1, at + 1);
  { offset: at, line: line.number, column: column_of(data, line.from, at, 1) }
}

fn line_of(
  data: Bytes,
  at: Int,
  from: Int,
  number: Int,
  left: Int,
) -> { from: Int, number: Int } / {abort.raise} = {
  let stop = if from >= at { at } else { data.scan_until(from, b"\r\n", at - from) };
  if stop >= at || left <= 0 { { from: from, number: number } } else {
    let paired = data.at(stop) == b'\r' && data.peek(stop + 1) == b'\n';
    let next = if paired { stop + 2 } else { stop + 1 };
    if next > at { { from: from, number: number } }
    else { line_of(data, at, next, number + 1, left - 1) }
  }
}

fn column_of(data: Bytes, i: Int, at: Int, column: Int) -> Int / {abort.raise} =
  if i >= at { column }
  else { column_of(data, i + 1, at, if data.at(i) & 0xC0 == 0x80 { column } else { column + 1 }) }

fn fail_at<a>(data: Bytes, at: Int, reason: ErrorKind) -> a / {xml.fail, abort.raise} = {
  let p = position(data, at);
  xml.fail({ at: p.offset, line: p.line, column: p.column, reason: reason })
}

type Point = { point: Int, width: Int }

fn point_at(data: Bytes, i: Int) -> Point = {
  let b = data.peek(i);
  if b < 0x80 { { point: b, width: if b < 0 { 0 } else { 1 } } }
  else if b < 0xE0 { { point: (b & 0x1F) << 6 | continuation_bits(data, i + 1), width: 2 } }
  else if b < 0xF0 {
    {
      point: (b & 0x0F) << 12 | continuation_bits(data, i + 1) << 6
        | continuation_bits(data, i + 2),
      width: 3,
    }
  } else {
    {
      point: (b & 0x07) << 18 | continuation_bits(data, i + 1) << 12
        | continuation_bits(data, i + 2) << 6
        | continuation_bits(data, i + 3),
      width: 4,
    }
  }
}

fn continuation_bits(data: Bytes, i: Int) -> Int = max(data.peek(i), 0) & 0x3F

fn is_continuation(b: Int) -> Bool = b >= 0x80 && b <= 0xBF

fn utf8_width(data: Bytes, i: Int) -> Int / {abort.raise} = {
  let b = data.peek(i + 1);
  let c = is_continuation(data.peek(i + 2));
  let d = is_continuation(data.peek(i + 3));
  match data.at(i) {
    0x00..=0x7F -> 1,
    0xC2..=0xDF -> if is_continuation(b) { 2 } else { 0 },
    0xE0 -> if b >= 0xA0 && b <= 0xBF && c { 3 } else { 0 },
    0xED -> if b >= 0x80 && b <= 0x9F && c { 3 } else { 0 },
    0xE1..=0xEF -> if is_continuation(b) && c { 3 } else { 0 },
    0xF0 -> if b >= 0x90 && b <= 0xBF && c && d { 4 } else { 0 },
    0xF4 -> if b >= 0x80 && b <= 0x8F && c && d { 4 } else { 0 },
    0xF1..=0xF3 -> if is_continuation(b) && c && d { 4 } else { 0 },
    _ -> 0,
  }
}

fn utf8_prefix(data: Bytes, i: Int, left: Int) -> Int / {abort.raise} =
  if i >= data.len() || left <= 0 { i } else {
    let width = utf8_width(data, i);
    if width == 0 { i } else { utf8_prefix(data, i + width, left - 1) }
  }

const control_characters: Bytes =
  b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x0b\x0c\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f"

fn first_illegal_char(data: Bytes) -> { at: Int, point: Int } / {abort.raise} = {
  let n = data.len();
  let control = data.skip_until(0, control_characters);
  let fffe = data.index_of(b"\xef\xbf\xbe").unwrap_or(n);
  let ffff = data.index_of(b"\xef\xbf\xbf").unwrap_or(n);
  let at = min(control, min(fffe, ffff));
  if at >= n { { at: n, point: -1 } }
  else if at == control { { at: at, point: data.at(at) } }
  else { { at: at, point: if at == fffe { 0xFFFE } else { 0xFFFF } } }
}

fn is_char(n: Int) -> Bool =
  match n {
    0x9 | 0xA | 0xD | 0x20..=0xD7FF | 0xE000..=0xFFFD | 0x10000..=0x10FFFF -> true,
    _ -> false,
  }

fn starts_name(point: Int) -> Bool =
  match point {
    b':' | b'A'..=b'Z' | b'_' | b'a'..=b'z' -> true,
    0xC0..=0xD6 | 0xD8..=0xF6 | 0xF8..=0x2FF | 0x370..=0x37D | 0x37F..=0x1FFF -> true,
    0x200C..=0x200D | 0x2070..=0x218F | 0x2C00..=0x2FEF | 0x3001..=0xD7FF -> true,
    0xF900..=0xFDCF | 0xFDF0..=0xFFFD | 0x10000..=0xEFFFF -> true,
    _ -> false,
  }

fn continues_name(point: Int) -> Bool =
  starts_name(point)
    || (match point {
      b'-' | b'.' | b'0'..=b'9' | 0xB7 | 0x300..=0x36F | 0x203F..=0x2040 -> true,
      _ -> false,
    })

const name_bytes: Bytes = b"-.0123456789:ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz"

fn point_before(data: Bytes, i: Int, limit: Int) -> Point =
  if i >= limit { { point: -1, width: 0 } } else { point_at(data, i) }

fn name_end(data: Bytes, i: Int, limit: Int) -> Int / {abort.raise} = {
  let head = point_before(data, i, limit);
  if starts_name(head.point) { name_rest(data, i + head.width, limit, limit - i) } else { i }
}

fn name_rest(data: Bytes, i: Int, limit: Int, left: Int) -> Int / {abort.raise} = {
  let j = min(data.skip(i, name_bytes), limit);
  let next = point_before(data, j, limit);
  if next.point < 0x80 || !continues_name(next.point) || left <= 0 { j }
  else { name_rest(data, j + next.width, limit, left - 1) }
}

fn is_ncname(raw: Bytes) -> Bool / {abort.raise} =
  raw.len() > 0 && !raw.contains(b":") && name_end(raw, 0, raw.len()) == raw.len()

const whitespace: Bytes = b" \t\n\r"

fn is_whitespace(b: Int) -> Bool = b == b' ' || b == b'\t' || b == b'\n' || b == b'\r'

fn line_ends(b: Bytes) -> Bytes =
  if b.contains(b"\r") { b.replace(b"\r\n", b"\n").replace(b"\r", b"\n") } else { b }

fn joined(pieces: List<Bytes>) -> Bytes =
  match pieces { [] -> b"", [only] -> only, _ -> Bytes::concat_all(pieces) }

/// What a reader may spend on one document. A limit that is not positive allows nothing of its
/// kind.
pub type Limits = new {
  /// Elements open at once; never more than `maximum_depth`.
  max_depth: Int,
  /// Attributes on one element, its namespace declarations among them.
  max_attributes: Int,
  /// Bytes in one name as written, its prefix and colon among them.
  max_name_bytes: Int,
  /// Bytes in one run of text, one attribute's value, one comment or one instruction's data.
  max_text_bytes: Int,
  /// The most events a document may produce. An element counts as two events, a start and an end.
  /// Each text, comment or instruction counts as one.
  max_events: Int,
  /// Bytes in the whole document.
  max_document_bytes: Int,
}

/// 256 levels, 256 attributes, names of 1 KiB, text of 4 MiB, four million events and 64 MiB.
pub const default_limits: Limits =
  {
    max_depth: 256,
    max_attributes: 256,
    max_name_bytes: 1024,
    max_text_bytes: 4194304,
    max_events: 4000000,
    max_document_bytes: 67108864,
  }

type Stage = | Prolog | Content | Epilog

type OpenElement = {
  tag: Bytes,
  name: Name,
  outer: Map<String, String>,
  known: Option<Map<Bytes, Name>>,
}

type OpenStack = | Outermost | Within(OpenElement, OpenStack)

/// A reader's position in a document: `data` is the document as UTF-8, and `at` is the offset where
/// `next` reads. The rest is the reader's own state: the open elements and the namespaces in scope.
pub type Cursor = new {
  data: Bytes,
  at: Int,
  limits: Limits,
  stage: Stage,
  open: OpenStack,
  depth: Int,
  scope: Map<String, String>,
  tags: Map<Bytes, Name>,
  plain: Map<Bytes, Name>,
  closing: Bool,
  events: Int,
  sound: Int,
  flaw: ErrorKind,
  wide: Bool,
}

/// A start tag: the element's name, its attributes in document order, and the namespace
/// declarations it carried, which are not among the attributes.
pub type Start = new { name: Name, attributes: List<Attribute>, declared: List<Binding> }

/// One piece of a document, in the order it is written.
pub type Event =
  /// The XML declaration, which can only be a document's first event.
  | XmlDeclaration(Declaration)
  /// A start tag, or the start of an empty-element tag, which an `EndElement` follows at once.
  | StartElement(Start)
  /// The end of the element of this name.
  | EndElement(Name)
  /// Text between two pieces of markup inside the root element, never empty: its character data,
  /// references and CDATA sections as the characters they represent.
  | Characters(String)
  /// A comment or a processing instruction.
  | CommentOrInstruction(Miscellaneous)

/// An event, the offset in `Cursor.data` at which it begins, and the cursor past it.
pub type Step = new { event: Event, at: Int, rest: Cursor }

/// A cursor at the start of `data`: past a byte order mark, with UTF-16 read as UTF-8. Raises
/// `xml.fail` for an encoding this module does not read and for a document longer than
/// `max_document_bytes`.
pub fn start(data: Bytes, limits: Limits) -> Cursor / {xml.fail, abort.raise} = {
  let a = data.peek(0);
  let b = data.peek(1);
  let four = (a << 24 | max(b, 0) << 16 | max(data.peek(2), 0) << 8 | max(data.peek(3), 0))
    & 0xFFFF_FFFF;
  if data.len() > limits.max_document_bytes { fail_at(b"", 0, TooLarge) }
  else if a == 0xEF && b == 0xBB && data.peek(2) == 0xBF { initial_cursor(data, 3, false, limits) }
  else if data.len() >= 4 && unsupported_encoding(four) != "" {
    fail_at(b"", 0, Encoding(unsupported_encoding(four)))
  } else if a == 0xFE && b == 0xFF { initial_cursor(utf16_to_utf8(data, true), 0, true, limits) }
  else if a == 0xFF && b == 0xFE { initial_cursor(utf16_to_utf8(data, false), 0, true, limits) }
  else { initial_cursor(data, 0, false, limits) }
}

fn unsupported_encoding(four: Int) -> String =
  match four {
    0x0000_FEFF | 0xFFFE_0000 | 0x0000_003C | 0x3C00_0000 -> "UCS-4",
    0x003C_003F -> "UTF-16BE",
    0x3C00_3F00 -> "UTF-16LE",
    0x4C6F_A794 -> "EBCDIC",
    _ -> "",
  }

fn initial_cursor(data: Bytes, origin: Int, wide: Bool, limits: Limits) -> Cursor / {abort.raise} = {
  let n = data.len();
  let whole = if data.is_utf8() { n } else { utf8_prefix(data, 0, n) };
  let odd = first_illegal_char(data);
  {
    data: data,
    at: origin,
    limits: { ..limits, max_depth: min(limits.max_depth, maximum_depth) },
    stage: Prolog,
    open: Outermost,
    depth: 0,
    scope: Map::new(),
    tags: Map::new(),
    plain: Map::new(),
    closing: false,
    events: 0,
    sound: min(odd.at, whole),
    flaw: if odd.at < whole { IllegalChar(odd.point) } else { NotUtf8 },
    wide: wide,
  }
}

type Utf16State = { chars: List<Char>, high: Int, bad: Bool }

fn utf16_to_utf8(data: Bytes, big: Bool) -> Bytes / {xml.fail, abort.raise} = {
  let units = (data.len() - 2) / 2;
  let read = range(0, units).fold({ chars: [], high: -1, bad: false }, |w: Utf16State, k: Int| {
    let first_byte = data.at(2 + 2 * k);
    let second_byte = data.at(3 + 2 * k);
    add_utf16_unit(w, if big { first_byte << 8 | second_byte }
    else { second_byte << 8 | first_byte })
  });
  let text = Bytes::of_string(String::of_chars(read.chars));
  if read.bad || read.high >= 0 || data.len() % 2 != 0 { fail_at(text, text.len(), NotUtf16) }
  else { text }
}

fn add_utf16_unit(w: Utf16State, unit: Int) -> Utf16State =
  if w.bad { w } else if w.high >= 0 {
    if unit >= 0xDC00 && unit <= 0xDFFF {
      with_char({ ..w, high: -1 }, 0x10000 + (w.high - 0xD800 << 10) + (unit - 0xDC00))
    } else { { ..w, bad: true } }
  } else if unit >= 0xD800 && unit <= 0xDBFF { { ..w, high: unit } }
  else { with_char(w, unit) }

fn with_char(w: Utf16State, point: Int) -> Utf16State =
  match Char::of_int(point) {
    Some(ch) -> { ..w, chars: w.chars.push(ch) },
    None -> { ..w, bad: true },
  }

fn fail<a>(c: Cursor, at: Int, reason: ErrorKind) -> a / {xml.fail, abort.raise} =
  if c.sound < c.data.len() && c.sound <= at { fail_at(c.data, c.sound, c.flaw) }
  else { fail_at(c.data, at, reason) }

fn piece(c: Cursor, from: Int, to: Int) -> Bytes / {xml.fail, abort.raise} =
  if to > c.sound { fail_at(c.data, c.sound, c.flaw) } else { c.data.slice(from, to) }

fn limited_text(c: Cursor, at: Int, text: Bytes) -> String / {xml.fail, abort.raise} =
  if text.len() > c.limits.max_text_bytes { fail(c, at, TextTooLong) }
  else { String::of_bytes(text) }

fn make_step(c: Cursor, at: Int, event: Event, rest: Cursor) -> Step / {xml.fail, abort.raise} =
  if c.events >= c.limits.max_events { fail(c, at, TooManyEvents) }
  else { { event: event, at: at, rest: { ..rest, events: c.events + 1 } } }

/// The next event of the document and the cursor past it, or `None` when the document has ended
/// properly: its root element closed, with nothing but comments, instructions and white space after
/// it. Raises `xml.fail` when the document is not well formed, is not namespace-well-formed,
/// contains a document type declaration or exceeds a limit, at the first byte that makes it so.
pub fn next(c: Cursor) -> Option<Step> / {xml.fail, abort.raise} =
  if c.closing { Some(close_element(c, c.at, c.at)) } else {
    match c.stage {
      Prolog -> Some(before_root(c)),
      Content -> Some(inside(c)),
      Epilog -> after_root(c),
    }
  }

fn before_root(c: Cursor) -> Step / {xml.fail, abort.raise} =
  if c.events == 0 && c.data.starts_at(c.at, b"<?xml") && is_whitespace(c.data.peek(c.at + 5)) {
    declaration(c)
  } else {
    let i = c.data.skip(c.at, whitespace);
    let b = c.data.peek(i);
    if b < 0 { fail(c, i, NoRoot) }
    else if b != b'<' { fail(c, i, OutsideRoot) }
    else { markup(c, i) }
  }

fn after_root(c: Cursor) -> Option<Step> / {xml.fail, abort.raise} = {
  let i = c.data.skip(c.at, whitespace);
  let b = c.data.peek(i + 1);
  if i >= c.data.len() { None }
  else if c.data.peek(i) == b'<' && (b == b'?' || b == b'!') { Some(markup(c, i)) }
  else { fail(c, i, OutsideRoot) }
}

fn inside(c: Cursor) -> Step / {xml.fail, abort.raise} = {
  let b = c.data.peek(c.at);
  if b < 0 { fail(c, c.at, Truncated) }
  else if b == b'<' && !(c.data.peek(c.at + 1) == b'!' && c.data.starts_at(c.at, b"<![CDATA[")) {
    markup(c, c.at)
  } else {
    let run = text_run(c, c.at, [], c.data.len() - c.at + 1);
    if run.bytes.len() > 0 {
      make_step(c, c.at, Characters(limited_text(c, c.at, run.bytes)), { ..c, at: run.next })
    } else if run.next >= c.data.len() { fail(c, run.next, Truncated) }
    else { markup(c, run.next) }
  }
}

fn markup(c: Cursor, i: Int) -> Step / {xml.fail, abort.raise} =
  match c.data.peek(i + 1) {
    b'?' -> {
      let read = instruction(c, i);
      make_step(c, i, CommentOrInstruction(Instruction(read.target, read.data)), {
        ..c,
        at: read.next,
      })
    },
    b'!' -> if c.data.starts_at(i, b"<!--") {
      let read = read_comment(c, i);
      make_step(c, i, CommentOrInstruction(Comment(read.text)), { ..c, at: read.next })
    } else if c.data.starts_at(i, b"<!DOCTYPE") { fail(c, i, Doctype) }
    else if c.data.starts_at(i, b"<![CDATA[") { fail(c, i, OutsideRoot) }
    else { fail(c, i, BadMarkup) },
    b'/' -> end_tag(c, i),
    _ -> start_tag(c, i),
  }

type Run = { bytes: Bytes, next: Int }

fn text_run(c: Cursor, i: Int, pieces: List<Bytes>, left: Int) -> Run / {xml.fail, abort.raise} = {
  let stop = c.data.skip_until(i, b"<&]\r");
  let extended_pieces = if stop > i { pieces.push(piece(c, i, stop)) } else { pieces };
  if left <= 0 { panic("more pieces of text than bytes") } else {
    match c.data.peek(stop) {
      b'&' -> {
        let name_out = reference(c, stop);
        text_run(c, name_out.next, extended_pieces.push(name_out.bytes), left - 1)
      },
      b']' -> square_brackets(c, stop, extended_pieces, left),
      b'\r' -> {
        let next = if c.data.peek(stop + 1) == b'\n' { stop + 2 } else { stop + 1 };
        text_run(c, next, extended_pieces.push(b"\n"), left - 1)
      },
      b'<' -> if c.data.starts_at(stop, b"<![CDATA[") { section(c, stop, extended_pieces, left) }
      else { { bytes: joined(extended_pieces), next: stop } },
      _ -> { bytes: joined(extended_pieces), next: stop },
    }
  }
}

fn square_brackets(
  c: Cursor,
  i: Int,
  pieces: List<Bytes>,
  left: Int,
) -> Run / {xml.fail, abort.raise} = {
  let end = c.data.skip(i, b"]");
  if end - i >= 2 && c.data.peek(end) == b'>' { fail(c, end - 2, CDataEnd) }
  else if left <= 0 { panic("more pieces of text than bytes") }
  else { text_run(c, end, pieces.push(piece(c, i, end)), left - 1) }
}

fn section(c: Cursor, i: Int, pieces: List<Bytes>, left: Int) -> Run / {xml.fail, abort.raise} =
  match c.data.index_of_from(b"]]>", i + 9) {
    None -> fail(c, i, Truncated),
    Some(end) -> if left <= 0 { panic("more pieces of text than bytes") }
    else { text_run(c, end + 3, pieces.push(line_ends(piece(c, i + 9, end))), left - 1) },
  }

fn reference(c: Cursor, i: Int) -> Run / {xml.fail, abort.raise} =
  if c.data.peek(i + 1) == b'#' { char_reference(c, i) } else {
    let end = name_end(c.data, i + 1, c.sound);
    if end == i + 1 || c.data.peek(end) != b';' { fail(c, i, BadReference) }
    else { { bytes: entity(c, i, piece(c, i + 1, end)), next: end + 1 } }
  }

fn entity(c: Cursor, i: Int, name_out: Bytes) -> Bytes / {xml.fail, abort.raise} =
  match name_out {
    b"lt" -> b"<",
    b"gt" -> b">",
    b"amp" -> b"&",
    b"apos" -> b"'",
    b"quot" -> b"\"",
    _ -> fail(c, i, UnknownEntity(String::of_bytes(name_out))),
  }

fn char_reference(c: Cursor, i: Int) -> Run / {xml.fail, abort.raise} = {
  let hex = c.data.peek(i + 2) == b'x';
  let from = if hex { i + 3 } else { i + 2 };
  let end = c.data.skip(from, if hex { b"0123456789ABCDEFabcdef" } else { b"0123456789" });
  let base = if hex { 16 } else { 10 };
  if end == from || c.data.peek(end) != b';' { fail(c, i, BadReference) } else {
    let n = range(from, end).fold(0, |accumulator: Int, k: Int|
      min(accumulator * base + hex_value(c.data.at(k)), 0x110000));
    match Char::of_int(if is_char(n) { n } else { -1 }) {
      Some(ch) -> { bytes: Bytes::of_string(String::of_chars([ch])), next: end + 1 },
      None -> fail(c, i, IllegalReference(n)),
    }
  }
}

type RawAttribute = { name: Bytes, value: String, at: Int }

type Tag = { raws: List<RawAttribute>, next: Int, empty: Bool }

type Bound = {
  scope: Map<String, String>,
  declared: List<Binding>,
  seen: Map<Bytes, Unit>,
  plain: List<RawAttribute>,
}

type Resolved = {
  attributes: List<Attribute>,
  expanded: Map<(String, String), Unit>,
  plain: Map<Bytes, Name>,
}

fn start_tag(c: Cursor, i: Int) -> Step / {xml.fail, abort.raise} = {
  let end = name_end(c.data, i + 1, c.sound);
  if end == i + 1 { fail(c, i, if i + 1 >= c.data.len() { Truncated } else { BadMarkup }) }
  else if c.stage == Epilog { fail(c, i, OutsideRoot) }
  else if end - i - 1 > c.limits.max_name_bytes { fail(c, i + 1, NameTooLong) }
  else if c.depth >= c.limits.max_depth { fail(c, i, TooDeep) }
  else { open_element(c, i, piece(c, i + 1, end), attributes(c, end, [], c.data.len() - end + 1)) }
}

fn attributes(
  c: Cursor,
  i: Int,
  accumulator: List<RawAttribute>,
  left: Int,
) -> Tag / {xml.fail, abort.raise} = {
  let j = c.data.skip(i, whitespace);
  let b = c.data.peek(j);
  if b == b'>' { { raws: accumulator, next: j + 1, empty: false } } else if b == b'/' {
    if c.data.peek(j + 1) == b'>' { { raws: accumulator, next: j + 2, empty: true } }
    else { fail(c, j, BadTag) }
  } else if b < 0 { fail(c, j, Truncated) }
  else if j == i { fail(c, j, BadTag) }
  else if accumulator.len() >= c.limits.max_attributes { fail(c, j, TooManyAttributes) }
  else if left <= 0 { panic("more attributes than bytes") } else {
    let read = raw_attribute(c, j);
    attributes(c, read.next, accumulator.push(read.raw), left - 1)
  }
}

fn raw_attribute(c: Cursor, i: Int) -> { raw: RawAttribute, next: Int } / {xml.fail, abort.raise} = {
  let end = name_end(c.data, i, c.sound);
  let equals = c.data.skip(end, whitespace);
  let quote = c.data.skip(equals + 1, whitespace);
  if end == i { fail(c, i, BadName) }
  else if end - i > c.limits.max_name_bytes { fail(c, i, NameTooLong) }
  else if c.data.peek(equals) != b'=' { fail(c, equals, BadAttribute) }
  else if c.data.peek(quote) != b'"' && c.data.peek(quote) != b'\'' { fail(c, quote, BadAttribute) }
  else {
    let read = value(c, quote + 1, c.data.at(quote), [], c.data.len() - quote);
    {
      raw: { name: piece(c, i, end), value: limited_text(c, quote, read.bytes), at: i },
      next: read.next,
    }
  }
}

fn value(
  c: Cursor,
  i: Int,
  quote: Int,
  pieces: List<Bytes>,
  left: Int,
) -> Run / {xml.fail, abort.raise} = {
  let stop = c.data.skip_until(i, if quote == b'"' { b"\"<&\t\n\r" } else { b"'<&\t\n\r" });
  let extended_pieces = if stop > i { pieces.push(piece(c, i, stop)) } else { pieces };
  let b = c.data.peek(stop);
  if b == quote { { bytes: joined(extended_pieces), next: stop + 1 } }
  else if b < 0 { fail(c, stop, Truncated) }
  else if b == b'<' { fail(c, stop, LessThanInValue) }
  else if left <= 0 { panic("more pieces of a value than bytes") } else if b == b'&' {
    let name_out = reference(c, stop);
    value(c, name_out.next, quote, extended_pieces.push(name_out.bytes), left - 1)
  } else {
    let paired = b == b'\r' && c.data.peek(stop + 1) == b'\n';
    value(c, if paired { stop + 2 } else { stop + 1 }, quote, extended_pieces.push(b" "), left - 1)
  }
}

fn open_element(c: Cursor, i: Int, tag: Bytes, read: Tag) -> Step / {xml.fail, abort.raise} = {
  let bound = read.raws.fold(
    { scope: c.scope, declared: [], seen: Map::new(), plain: [] },
    |b: Bound, raw: RawAttribute| declare(c, b, raw),
  );
  let rescoped = !bound.declared.is_empty();
  let known = if rescoped { None } else { c.tags.get(tag) };
  let name_out = match known {
    Some(name) -> name,
    None -> element_name(c, i + 1, tag, bound.scope),
  };
  let tags = match known {
    Some(_) -> c.tags,
    None -> Map::insert(if rescoped { Map::new() } else { c.tags }, tag, name_out),
  };
  let resolved = bound.plain.fold(
    { attributes: [], expanded: Map::new(), plain: c.plain },
    |r: Resolved, raw: RawAttribute| resolve(c, bound.scope, r, raw),
  );
  make_step(
    c,
    i,
    StartElement({ name: name_out, attributes: resolved.attributes, declared: bound.declared }),
    {
      ..c,
      at: read.next,
      stage: Content,
      open: Within(
        {
          tag: tag,
          name: name_out,
          outer: c.scope,
          known: if rescoped { Some(c.tags) } else { None },
        },
        c.open,
      ),
      depth: c.depth + 1,
      scope: bound.scope,
      tags: tags,
      plain: resolved.plain,
      closing: read.empty,
    },
  )
}

fn declare(c: Cursor, b: Bound, raw: RawAttribute) -> Bound / {xml.fail, abort.raise} =
  if b.seen.contains(raw.name) { fail(c, raw.at, DuplicateAttribute(String::of_bytes(raw.name))) }
  else {
    let seen: Bound = { ..b, seen: b.seen.insert(raw.name, ()) };
    if raw.name == b"xmlns" { bind(c, seen, raw, "") } else if raw.name.starts_with(b"xmlns:") {
      bind(c, seen, raw, local_of(c, raw.at, raw.name.slice(6, raw.name.len())))
    } else { { ..seen, plain: seen.plain.push(raw) } }
  }

fn bind(c: Cursor, b: Bound, raw: RawAttribute, prefix: String) -> Bound / {xml.fail, abort.raise} =
  if !bindable(prefix, raw.value) { fail(c, raw.at, BadNamespace(prefix)) } else {
    {
      ..b,
      scope: b.scope.insert(prefix, raw.value),
      declared: b.declared.push({ prefix: prefix, namespace: raw.value }),
    }
  }

fn bindable(prefix: String, namespace: String) -> Bool =
  if prefix == "xmlns" { false }
  else if prefix == "xml" { namespace == xml_namespace }
  else if namespace == xml_namespace || namespace == xmlns_namespace { false }
  else { prefix == "" || namespace != "" }

type QName = { prefix: String, local: String }

fn qualified_name(c: Cursor, at: Int, raw: Bytes) -> QName / {xml.fail, abort.raise} =
  match raw.index_of_byte(b':') {
    None -> { prefix: "", local: String::of_bytes(raw) },
    Some(colon) -> if colon == 0 { fail(c, at, BadName) } else {
      {
        prefix: String::of_bytes(raw.slice(0, colon)),
        local: local_of(c, at, raw.slice(colon + 1, raw.len())),
      }
    },
  }

fn local_of(c: Cursor, at: Int, raw: Bytes) -> String / {xml.fail, abort.raise} =
  if is_ncname(raw) { String::of_bytes(raw) } else { fail(c, at, BadName) }

fn bound_to(
  c: Cursor,
  at: Int,
  prefix: String,
  scope: Map<String, String>,
) -> String / {xml.fail, abort.raise} =
  if prefix == "xml" { xml_namespace }
  else if prefix == "xmlns" { fail(c, at, BadNamespace(prefix)) }
  else { match scope.get(prefix) { Some(uri) -> uri, None -> fail(c, at, UnboundPrefix(prefix)) } }

fn element_name(
  c: Cursor,
  at: Int,
  tag: Bytes,
  scope: Map<String, String>,
) -> Name / {xml.fail, abort.raise} = {
  let q = qualified_name(c, at, tag);
  let namespace = if q.prefix == "" { scope.get("").unwrap_or("") }
  else { bound_to(c, at, q.prefix, scope) };
  { namespace: namespace, local: q.local, prefix: Spelling(q.prefix) }
}

fn resolve(
  c: Cursor,
  scope: Map<String, String>,
  r: Resolved,
  raw: RawAttribute,
) -> Resolved / {xml.fail, abort.raise} =
  match r.plain.get(raw.name) {
    Some(known) -> { ..r, attributes: r.attributes.push({ name: known, value: raw.value }) },
    None -> {
      let q = qualified_name(c, raw.at, raw.name);
      let namespace = if q.prefix == "" { "" } else { bound_to(c, raw.at, q.prefix, scope) };
      let name_out: Name = { namespace: namespace, local: q.local, prefix: Spelling(q.prefix) };
      let extended_attributes = r.attributes.push({ name: name_out, value: raw.value });
      if namespace == "" {
        { ..r, attributes: extended_attributes, plain: r.plain.insert(raw.name, name_out) }
      } else if r.expanded.contains((namespace, q.local)) {
        fail(c, raw.at, DuplicateAttribute(String::of_bytes(raw.name)))
      } else {
        {
          ..r,
          attributes: extended_attributes,
          expanded: r.expanded.insert((namespace, q.local), ()),
        }
      }
    },
  }

fn end_tag(c: Cursor, i: Int) -> Step / {xml.fail, abort.raise} =
  match c.open {
    Outermost -> fail(c, i, OutsideRoot),
    Within(top, _) -> {
      let after = i + 2 + top.tag.len();
      let close = c.data.skip(after, whitespace);
      let longer = continues_name(point_before(c.data, after, c.sound).point);
      if !c.data.starts_at(i + 2, top.tag) || longer {
        fail(c, i, Mismatched(String::of_bytes(top.tag)))
      } else if c.data.peek(close) == b'>' { close_element(c, i, close + 1) }
      else { fail(c, close, if close >= c.data.len() { Truncated } else { BadTag }) }
    },
  }

fn close_element(c: Cursor, from: Int, at: Int) -> Step / {xml.fail, abort.raise} =
  match c.open {
    Outermost -> fail(c, from, OutsideRoot),
    Within(top, below) ->
      make_step(c, from, EndElement(top.name), {
        ..c,
        at: at,
        open: below,
        depth: c.depth - 1,
        scope: top.outer,
        tags: match top.known { Some(outer) -> outer, None -> c.tags },
        closing: false,
        stage: match below { Outermost -> Epilog, Within(_, _) -> Content },
      }),
  }

fn read_comment(c: Cursor, i: Int) -> { text: String, next: Int } / {xml.fail, abort.raise} =
  match c.data.index_of_from(b"--", i + 4) {
    None -> fail(c, i, Truncated),
    Some(end) -> if c.data.peek(end + 2) != b'>' {
      fail(c, end, if end + 2 >= c.data.len() { Truncated } else { DoubleHyphen })
    } else { { text: limited_text(c, i, line_ends(piece(c, i + 4, end))), next: end + 3 } },
  }

type InstructionResult = { target: String, data: String, next: Int }

fn instruction(c: Cursor, i: Int) -> InstructionResult / {xml.fail, abort.raise} = {
  let end = name_end(c.data, i + 2, c.sound);
  let target = piece(c, i + 2, end);
  if end == i + 2 || !is_ncname(target) { fail(c, i + 2, BadName) }
  else if end - i - 2 > c.limits.max_name_bytes { fail(c, i + 2, NameTooLong) }
  else if String::of_bytes(target).ascii_lower() == "xml" { fail(c, i, BadInstruction) }
  else if c.data.starts_at(end, b"?>") {
    { target: String::of_bytes(target), data: "", next: end + 2 }
  } else if end >= c.data.len() { fail(c, end, Truncated) }
  else if !is_whitespace(c.data.peek(end)) { fail(c, end, BadInstruction) } else {
    let from = c.data.skip(end, whitespace);
    match c.data.index_of_from(b"?>", from) {
      None -> fail(c, i, Truncated),
      Some(close) ->
        {
          target: String::of_bytes(target),
          data: limited_text(c, i, line_ends(piece(c, from, close))),
          next: close + 2,
        },
    }
  }
}

type PseudoAttribute = { name: Bytes, value: Bytes, at: Int, next: Int }

fn pseudo_attribute(c: Cursor, i: Int) -> Option<PseudoAttribute> / {xml.fail, abort.raise} = {
  let from = c.data.skip(i, whitespace);
  let end = c.data.skip(from, b"abcdefghijklmnopqrstuvwxyz");
  let equals = c.data.skip(end, whitespace);
  let quote = c.data.skip(equals + 1, whitespace);
  let mark = c.data.peek(quote);
  if c.data.starts_at(from, b"?>") { None }
  else if from == i || end == from || c.data.peek(equals) != b'=' {
    fail(c, from, if from >= c.data.len() { Truncated } else { BadDeclaration })
  } else if mark != b'"' && mark != b'\'' { fail(c, quote, BadDeclaration) } else {
    match c.data.index_of_from(c.data.slice(quote, quote + 1), quote + 1) {
      None -> fail(c, quote, Truncated),
      Some(close) ->
        Some({
          name: piece(c, from, end),
          value: piece(c, quote + 1, close),
          at: quote + 1,
          next: close + 1,
        }),
    }
  }
}

fn declaration(c: Cursor) -> Step / {xml.fail, abort.raise} =
  match pseudo_attribute(c, c.at + 5) {
    None -> fail(c, c.at, BadDeclaration),
    Some(version) -> if version.name != b"version" || !is_version(version.value) {
      fail(c, version.at, BadDeclaration)
    } else {
      let second = pseudo_attribute(c, version.next);
      let encoding = match second {
        Some(p) -> if p.name == b"encoding" { second } else { None },
        None -> None,
      };
      let standalone = match encoding { Some(p) -> pseudo_attribute(c, p.next), None -> second };
      let end = match standalone {
        Some(p) -> p.next,
        None -> match encoding { Some(p) -> p.next, None -> version.next },
      };
      let close = c.data.skip(end, whitespace);
      if !c.data.starts_at(close, b"?>") { fail(c, close, BadDeclaration) } else {
        make_step(
          c,
          c.at,
          XmlDeclaration({
            version: String::of_bytes(version.value),
            encoding: declared_encoding(c, encoding),
            standalone: declared_standalone(c, standalone),
          }),
          { ..c, at: close + 2 },
        )
      }
    },
  }

fn is_version(text: Bytes) -> Bool / {abort.raise} =
  text.len() > 2 && text.starts_with(b"1.") && text.skip(2, b"0123456789") == text.len()

fn declared_encoding(
  c: Cursor,
  p: Option<PseudoAttribute>,
) -> Option<String> / {xml.fail, abort.raise} =
  match p {
    None -> None,
    Some(name_out) -> {
      let letters = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz";
      let rest = name_out.value.skip(1, letters.concat(b"0123456789._-"));
      let text = String::of_bytes(name_out.value);
      if name_out.value.skip(0, letters) == 0 || rest != name_out.value.len() {
        fail(c, name_out.at, BadDeclaration)
      } else if text.ascii_lower() != (if c.wide { "utf-16" } else { "utf-8" }) {
        fail(c, name_out.at, Encoding(text))
      } else { Some(text) }
    },
  }

fn declared_standalone(
  c: Cursor,
  p: Option<PseudoAttribute>,
) -> Option<Bool> / {xml.fail, abort.raise} =
  match p {
    None -> None,
    Some(pseudo_attribute) -> if pseudo_attribute.name == b"standalone"
        && pseudo_attribute.value == b"yes" { Some(true) }
    else if pseudo_attribute.name == b"standalone" && pseudo_attribute.value == b"no" {
      Some(false)
    } else { fail(c, pseudo_attribute.at, BadDeclaration) },
  }

type Frame = { start: Start, children: List<Node> }

type OpenElements = | Ground | Open(Frame, OpenElements)

/// Returns every event of the document in `data`, in order. Fails with `xml.fail` where `next`
/// would, including when the document exceeds `limits`.
pub fn events(data: Bytes, limits: Limits) -> List<Event> / {xml.fail, abort.raise} =
  collect_events(start(data, limits), [], data.len() + 2)

fn collect_events(
  c: Cursor,
  accumulator: List<Event>,
  left: Int,
) -> List<Event> / {xml.fail, abort.raise} =
  match next(c) {
    None -> accumulator,
    Some(step) -> if left <= 0 { panic("more events than bytes") }
    else { collect_events(step.rest, accumulator.push(step.event), left - 1) },
  }

/// The element whose `start` was the last event read, and the cursor past its end.
pub fn subtree(
  start: Start,
  c: Cursor,
) -> { element: Element, rest: Cursor } / {xml.fail, abort.raise} =
  build_subtree(Open({ start: start, children: [] }, Ground), c, c.data.len() - c.at + 2)

fn build_subtree(
  frames: OpenElements,
  c: Cursor,
  left: Int,
) -> { element: Element, rest: Cursor } / {xml.fail, abort.raise} =
  match next(c) {
    None -> fail(c, c.at, Truncated),
    Some(step) -> if left <= 0 { panic("more events than bytes") } else {
      match step.event {
        StartElement(s) ->
          build_subtree(Open({ start: s, children: [] }, frames), step.rest, left - 1),
        EndElement(_) -> match frames {
          Ground -> fail(c, c.at, OutsideRoot),
          Open(top, below) -> match below {
            Ground -> { element: frame_element(top), rest: step.rest },
            Open(_, _) ->
              build_subtree(add_child(below, Element(frame_element(top))), step.rest, left - 1),
          },
        },
        Characters(t) -> build_subtree(add_child(frames, Text(t)), step.rest, left - 1),
        CommentOrInstruction(m) ->
          build_subtree(add_child(frames, Miscellaneous(m)), step.rest, left - 1),
        XmlDeclaration(_) -> build_subtree(frames, step.rest, left - 1),
      }
    },
  }

fn frame_element(f: Frame) -> Element =
  {
    name: f.start.name,
    attributes: f.start.attributes,
    children: f.children,
    declared: Spelling(f.start.declared),
  }

fn add_child(frames: OpenElements, node: Node) -> OpenElements =
  match frames {
    Ground -> Ground,
    Open(top, below) -> Open({ start: top.start, children: top.children.push(node) }, below),
  }

/// Returns the cursor after the end of the element whose start tag was the last event read. The
/// skipped content is still checked, so this fails with `xml.fail` exactly where reading it with
/// `next` would.
pub fn skip(c: Cursor) -> Cursor / {xml.fail, abort.raise} =
  skip_element(c, 0, c.data.len() - c.at + 2)

fn skip_element(c: Cursor, inner: Int, left: Int) -> Cursor / {xml.fail, abort.raise} =
  match next(c) {
    None -> fail(c, c.at, Truncated),
    Some(step) -> if left <= 0 { panic("more events than bytes") } else {
      match step.event {
        StartElement(_) -> skip_element(step.rest, inner + 1, left - 1),
        EndElement(_) -> if inner == 0 { step.rest }
        else { skip_element(step.rest, inner - 1, left - 1) },
        _ -> skip_element(step.rest, inner, left - 1),
      }
    },
  }

type Prologue = { declaration: Option<Declaration>, before: List<Miscellaneous> }

/// The document in `data`. Raises `xml.fail` where `next` would.
pub fn read(data: Bytes, limits: Limits) -> Document / {xml.fail, abort.raise} =
  read_document(start(data, limits), { declaration: None, before: [] }, data.len() + 2)

fn read_document(c: Cursor, p: Prologue, left: Int) -> Document / {xml.fail, abort.raise} =
  match next(c) {
    None -> fail(c, c.at, NoRoot),
    Some(step) -> if left <= 0 { panic("more events than bytes") } else {
      match step.event {
        XmlDeclaration(d) -> read_document(step.rest, { ..p, declaration: Some(d) }, left - 1),
        CommentOrInstruction(m) ->
          read_document(step.rest, { ..p, before: p.before.push(m) }, left - 1),
        StartElement(s) -> {
          let root = subtree(s, step.rest);
          {
            declaration: Spelling(p.declaration),
            before: p.before,
            root: root.element,
            after: trailing(root.rest, [], left),
          }
        },
        _ -> fail(c, c.at, OutsideRoot),
      }
    },
  }

fn trailing(
  c: Cursor,
  accumulator: List<Miscellaneous>,
  left: Int,
) -> List<Miscellaneous> / {xml.fail, abort.raise} =
  match next(c) {
    None -> accumulator,
    Some(step) -> if left <= 0 { panic("more events than bytes") } else {
      match step.event {
        CommentOrInstruction(m) -> trailing(step.rest, accumulator.push(m), left - 1),
        _ -> fail(c, c.at, OutsideRoot),
      }
    },
  }

/// The document in `data`, or why and where it is not one this module reads.
pub fn parse(data: Bytes, limits: Limits) -> Result<Document, Error> / {abort.raise} =
  try { read(data, limits) }

/// How `write` lays a document out.
pub type Layout =
  /// Writes no white space or line breaks beyond what the tree contains, so reading the document
  /// back gives the same tree.
  | Compact
  /// A line for each piece of the document, and for each child of an element that contains no text,
  /// indented by this many spaces per level. An element that contains text is written as `Compact`
  /// writes it, whatever is inside it, so no text gains white space.
  | Indented(Int)

type Formatting = { indent: Int, level: Int, flat: Bool }

type NamespaceScope = Map<String, String>

type TagBindings = { prefixes: NamespaceScope, order: List<Binding> }

type NameResult = { text: Bytes, claims: TagBindings }

type AttributeState = {
  claims: TagBindings,
  pieces: List<Bytes>,
  seen: Map<(String, String), Unit>,
}

type ChildrenState = { out: List<Bytes>, has_text: Bool }

type Escape = { raw: Bytes, written: Bytes }

/// Returns the document as UTF-8. A namespace is declared on the first element that needs it. The
/// prefix is chosen in this order: the prefix the name was written with, if no other namespace is
/// bound to it there; a prefix already bound to that namespace by an enclosing element; or a
/// generated prefix `ns1`, `ns2` and so on. An element's own `declared` bindings are written as
/// given, except that a default namespace binding is dropped from an element that is itself in no
/// namespace. Fails with `xml.unwritable` for a tree that no document can represent: see
/// `ErrorKind`.
pub fn write(d: Document, layout: Layout) -> Bytes / {xml.unwritable, abort.raise} = {
  let look = match layout {
    Compact -> { indent: 0, level: 0, flat: true },
    Indented(n) -> { indent: max(n, 0), level: 0, flat: false },
  };
  let line = if look.flat { b"" } else { b"\n" };
  let head = match spelling_value(d.declaration) {
    Some(declaration_spelling) -> [declaration_out(declaration_spelling), line],
    None -> [],
  };
  let before = d.before.fold(head, |out: List<Bytes>, m: Miscellaneous|
    out.push(write_miscellaneous(m)).push(line));
  let root = element_out(d.root, Map::new(), look, maximum_depth, before);
  let after = d.after.fold(root, |out: List<Bytes>, m: Miscellaneous|
    out.push(line).push(write_miscellaneous(m)));
  Bytes::concat_all(after.push(line))
}

/// The document as UTF-8, or why no document can represent the tree.
pub fn encode(d: Document, layout: Layout) -> Result<Bytes, ErrorKind> / {abort.raise} =
  try { write(d, layout) }

fn declaration_out(d: Declaration) -> Bytes / {xml.unwritable, abort.raise} =
  if !is_version(Bytes::of_string(d.version)) { xml.unwritable(BadDeclaration) } else {
    Bytes::concat_all([
      b"<?xml version=\"",
      Bytes::of_string(d.version),
      match d.encoding { Some(_) -> b"\" encoding=\"UTF-8", None -> b"" },
      match d.standalone {
        Some(alone) -> if alone { b"\" standalone=\"yes" } else { b"\" standalone=\"no" },
        None -> b"",
      },
      b"\"?>",
    ])
  }

fn write_miscellaneous(m: Miscellaneous) -> Bytes / {xml.unwritable, abort.raise} =
  match m {
    Comment(text) -> {
      let raw = checked_bytes(text);
      if raw.contains(b"--") || raw.ends_with(b"-") { xml.unwritable(DoubleHyphen) }
      else if raw.contains(b"\r") { xml.unwritable(IllegalChar(b'\r')) }
      else { Bytes::concat_all([b"<!--", raw, b"-->"]) }
    },
    Instruction(target, data) -> {
      let raw = checked_bytes(data);
      if !is_name(target) { xml.unwritable(NotAName(target)) }
      else if target.ascii_lower() == "xml" || raw.contains(b"?>") || is_whitespace(raw.peek(0)) {
        xml.unwritable(BadInstruction)
      } else if raw.contains(b"\r") { xml.unwritable(IllegalChar(b'\r')) }
      else if raw.len() == 0 { Bytes::concat_all([b"<?", Bytes::of_string(target), b"?>"]) }
      else { Bytes::concat_all([b"<?", Bytes::of_string(target), b" ", raw, b"?>"]) }
    },
  }

fn checked_bytes(text: String) -> Bytes / {xml.unwritable, abort.raise} = {
  let raw = Bytes::of_string(text);
  let odd = first_illegal_char(raw);
  if odd.at < raw.len() { xml.unwritable(IllegalChar(odd.point)) } else { raw }
}

fn escaped(
  text: String,
  stops: Bytes,
  escapes: List<Escape>,
) -> Bytes / {xml.unwritable, abort.raise} = {
  let raw = checked_bytes(text);
  if raw.skip_until(0, stops) >= raw.len() { raw }
  else { escapes.fold(raw, |b: Bytes, e: Escape| b.replace(e.raw, e.written)) }
}

fn text_out(text: String) -> Bytes / {xml.unwritable, abort.raise} =
  escaped(text, b"&<>\r", [
    { raw: b"&", written: b"&amp;" },
    { raw: b"<", written: b"&lt;" },
    { raw: b">", written: b"&gt;" },
    { raw: b"\r", written: b"&#xD;" },
  ])

fn value_out(text: String) -> Bytes / {xml.unwritable, abort.raise} =
  escaped(text, b"&<\"\t\n\r", [
    { raw: b"&", written: b"&amp;" },
    { raw: b"<", written: b"&lt;" },
    { raw: b"\"", written: b"&quot;" },
    { raw: b"\t", written: b"&#x9;" },
    { raw: b"\n", written: b"&#xA;" },
    { raw: b"\r", written: b"&#xD;" },
  ])

fn is_name(text: String) -> Bool / {abort.raise} = is_ncname(Bytes::of_string(text))

fn newline_indent(look: Formatting) -> Bytes = b"\n".concat(b" ".repeat(look.indent * look.level))

fn element_out(
  e: Element,
  outer: NamespaceScope,
  look: Formatting,
  room: Int,
  out: List<Bytes>,
) -> List<Bytes> / {xml.unwritable, abort.raise} =
  if room <= 0 { xml.unwritable(TooDeep) } else {
    let tag = tag_out(e, outer, out);
    if e.children.is_empty() { tag.out.push(b"/>") } else {
      let flat = look.flat || e.children.any(|n: Node| match n { Text(_) -> true, _ -> false });
      let inner = { indent: look.indent, level: look.level + 1, flat: flat };
      let filled = e.children.fold(
        { out: tag.out.push(b">"), has_text: false },
        |f: ChildrenState, child: Node| child_out(child, tag.scope, inner, room - 1, f),
      );
      let closing = if flat { filled.out } else { filled.out.push(newline_indent(look)) };
      closing.push(b"</").push(tag.name).push(b">")
    }
  }

fn child_out(
  child: Node,
  scope: NamespaceScope,
  look: Formatting,
  room: Int,
  f: ChildrenState,
) -> ChildrenState / {xml.unwritable, abort.raise} = {
  let lead = if look.flat { f.out } else { f.out.push(newline_indent(look)) };
  match child {
    Element(e) -> { out: element_out(e, scope, look, room, lead), has_text: false },
    Text(t) -> if f.has_text || t == "" { xml.unwritable(SplitText) }
    else { { out: lead.push(text_out(t)), has_text: true } },
    Miscellaneous(m) -> { out: lead.push(write_miscellaneous(m)), has_text: false },
  }
}

type TagResult = { out: List<Bytes>, name: Bytes, scope: NamespaceScope }

fn tag_out(
  e: Element,
  outer: NamespaceScope,
  out: List<Bytes>,
) -> TagResult / {xml.unwritable, abort.raise} = {
  let declared = spelling_value(e.declared).fold(
    { prefixes: Map::new(), order: [] },
    add_declaration,
  );
  let own = name_out(e.name, declared, outer, false);
  let write_compact = e.attributes.fold(
    { claims: own.claims, pieces: [], seen: Map::new() },
    |a: AttributeState, x: Attribute| attribute_out(a, x, outer),
  );
  let opened_tag = out.push(b"<").push(own.text);
  let bound = write_compact.claims.order.fold(opened_tag, |o: List<Bytes>, b: Binding|
    o.push(xmlns_attribute_name(b.prefix)).push(value_out(b.namespace)).push(b"\""));
  {
    out: write_compact.pieces.fold(bound, |o: List<Bytes>, p: Bytes| o.push(p)),
    name: own.text,
    scope: outer.merge(write_compact.claims.prefixes),
  }
}

fn xmlns_attribute_name(prefix: String) -> Bytes =
  if prefix == "" { b" xmlns=\"" } else { Bytes::of_string(" xmlns:" ++ prefix ++ "=\"") }

fn add_declaration(c: TagBindings, b: Binding) -> TagBindings / {xml.unwritable, abort.raise} =
  if !bindable(b.prefix, b.namespace) || c.prefixes.contains(b.prefix) {
    xml.unwritable(BadNamespace(b.prefix))
  } else if b.prefix != "" && !is_name(b.prefix) { xml.unwritable(NotAName(b.prefix)) }
  else { bind_prefix(c, b.prefix, b.namespace) }

fn bind_prefix(c: TagBindings, prefix: String, namespace: String) -> TagBindings =
  {
    prefixes: c.prefixes.insert(prefix, namespace),
    order: c.order.push({ prefix: prefix, namespace: namespace }),
  }

fn attribute_out(
  a: AttributeState,
  x: Attribute,
  outer: NamespaceScope,
) -> AttributeState / {xml.unwritable, abort.raise} = {
  let own = name_out(x.name, a.claims, outer, true);
  let key = (x.name.namespace, x.name.local);
  if a.seen.contains(key) { xml.unwritable(DuplicateAttribute(x.name.local)) } else {
    {
      claims: own.claims,
      pieces: a.pieces.push(b" ").push(own.text).push(b"=\"").push(value_out(x.value)).push(b"\""),
      seen: a.seen.insert(key, ()),
    }
  }
}

fn name_out(
  n: Name,
  claims: TagBindings,
  outer: NamespaceScope,
  attribute: Bool,
) -> NameResult / {xml.unwritable, abort.raise} =
  if !is_name(n.local) || (attribute && n.namespace == "" && n.local == "xmlns") {
    xml.unwritable(NotAName(n.local))
  } else if n.namespace == "" {
    {
      text: Bytes::of_string(n.local),
      claims: if attribute { claims } else { without_default_namespace(claims, outer) },
    }
  } else if n.namespace == xml_namespace {
    { text: Bytes::of_string("xml:" ++ n.local), claims: claims }
  } else if n.namespace == xmlns_namespace { xml.unwritable(BadNamespace("xmlns")) } else {
    let chosen = prefix_for(n.namespace, spelling_value(n.prefix), claims, outer, attribute);
    {
      text: Bytes::of_string(if chosen.prefix == "" { n.local }
      else { chosen.prefix ++ ":" ++ n.local }),
      claims: chosen.claims,
    }
  }

fn without_default_namespace(claims: TagBindings, outer: NamespaceScope) -> TagBindings = {
  let own = claims.prefixes.get("");
  let inherited = outer.get("").unwrap_or("");
  let without: TagBindings = {
    prefixes: claims.prefixes.remove(""),
    order: claims.order.filter(|b: Binding| b.prefix != ""),
  };
  if own == Some("") { claims }
  else if inherited == "" { without }
  else { bind_prefix(without, "", "") }
}

type PrefixChoice = { prefix: String, claims: TagBindings }

fn bound_in(claims: TagBindings, outer: NamespaceScope, prefix: String) -> Option<String> =
  match claims.prefixes.get(prefix) { Some(uri) -> Some(uri), None -> outer.get(prefix) }

fn prefix_for(
  namespace: String,
  hint: String,
  claims: TagBindings,
  outer: NamespaceScope,
  attribute: Bool,
) -> PrefixChoice / {xml.unwritable, abort.raise} = {
  let usable = !(attribute && hint == "");
  if hint != "" && (!is_name(hint) || hint == "xml" || hint == "xmlns") {
    xml.unwritable(NotAName(hint))
  } else if usable && bound_in(claims, outer, hint) == Some(namespace) {
    { prefix: hint, claims: { ..claims, prefixes: claims.prefixes.insert(hint, namespace) } }
  } else if usable && !claims.prefixes.contains(hint) {
    { prefix: hint, claims: bind_prefix(claims, hint, namespace) }
  } else {
    let scope = outer.merge(claims.prefixes);
    let found = scope.entries().filter(|e: { key: String, value: String }|
      e.value == namespace && !(attribute && e.key == "")).first(
    );
    match found {
      Some(e) ->
        { prefix: e.key, claims: { ..claims, prefixes: claims.prefixes.insert(e.key, namespace) } },
      None -> {
        let fresh = generated_prefix(scope, 1, scope.len() + 1);
        { prefix: fresh, claims: bind_prefix(claims, fresh, namespace) }
      },
    }
  }
}

fn generated_prefix(scope: NamespaceScope, k: Int, left: Int) -> String / {abort.raise} = {
  let prefix = "ns" ++ k.to_string();
  if !scope.contains(prefix) { prefix } else if left <= 0 {
    panic(
      "internal error: no unused prefix of the form `ns1`, `ns2`, ... exists, although the namespace scope has fewer prefixes than candidates",
    )
  } else { generated_prefix(scope, k + 1, left - 1) }
}

/// The value of the attribute `name`, whatever prefix it was written with.
pub fn attribute_value(e: Element, name: Name) -> Option<String> =
  match e.attributes.filter(|a: Attribute| a.name == name).first() {
    Some(a) -> Some(a.value),
    None -> None,
  }

/// Every child element, in order.
pub fn elements(e: Element) -> List<Element> =
  e.children.fold([], |found: List<Element>, n: Node|
    match n { Element(child) -> found.push(child), _ -> found })

/// Every child element named `name`, in order.
pub fn children(e: Element, name: Name) -> List<Element> =
  elements(e).filter(|child: Element| child.name == name)

/// The first child element named `name`.
pub fn child(e: Element, name: Name) -> Option<Element> = children(e, name).first()

/// Every element inside `e` named `name`, at any depth, in document order. `e` is not among them.
pub fn descendants(e: Element, name: Name) -> List<Element> = within(e, name, [])

fn within(e: Element, name: Name, found: List<Element>) -> List<Element> =
  e.children.fold(found, |accumulator: List<Element>, n: Node|
    match n {
      Element(child) ->
        within(child, name, if child.name == name { accumulator.push(child) } else { accumulator }),
      _ -> accumulator,
    })

/// All the text inside `e`, at any depth, in document order, with nothing between the pieces.
pub fn text(e: Element) -> String = String::of_bytes_lossy(Bytes::concat_all(append_text(e, [])))

fn append_text(e: Element, pieces: List<Bytes>) -> List<Bytes> =
  e.children.fold(pieces, |accumulator: List<Bytes>, n: Node|
    match n {
      Element(child) -> append_text(child, accumulator),
      Text(t) -> accumulator.push(Bytes::of_string(t)),
      Miscellaneous(_) -> accumulator,
    })

/// Every element a path of child names leads to from `e`, in document order. The path is names
/// separated by `/`, each a local name for an element in no namespace or `{namespace}local` for one
/// in a namespace: `channel/item`, `{http://www.w3.org/2005/Atom}entry`. An empty path is `e`
/// itself, and one that is not such a path leads nowhere.
pub fn find_all(e: Element, path: String) -> List<Element> / {abort.raise} =
  if path == "" { [e] } else {
    match steps(Bytes::of_string(path), 0, [], path.len() + 1) {
      None -> [],
      Some(names) ->
        names.fold([e], |from: List<Element>, name: Name|
          from.flat_map(|parent: Element| children(parent, name))),
    }
  }

/// The first element `find_all` returns.
pub fn find(e: Element, path: String) -> Option<Element> / {abort.raise} = find_all(e, path).first()

fn steps(path: Bytes, i: Int, names: List<Name>, left: Int) -> Option<List<Name>> / {abort.raise} = {
  let n = path.len();
  let braced = path.peek(i) == b'{';
  let closing = if braced { path.skip_until(i, b"}") } else { i - 1 };
  let end = path.skip_until(closing + 1, b"/");
  if closing >= n { None } else {
    let name_out = names.push(
      qualified(
        String::of_bytes(if braced { path.slice(i + 1, closing) } else { b"" }),
        String::of_bytes(path.slice(closing + 1, end)),
      ),
    );
    if end >= n || left <= 0 { Some(name_out) } else { steps(path, end + 1, name_out, left - 1) }
  }
}

/// `e` without the white space that only lays it out: in every element whose text is all white
/// space, at any depth, that text is dropped. What `write` adds under `Indented` is such text.
pub fn without_indentation(e: Element) -> Element = {
  let blank = |n: Node| match n { Text(t) -> t.ascii_trim() == "", _ -> true };
  let laid_out = e.children.fold(true, |all: Bool, n: Node| all && blank(n));
  {
    ..e,
    children: e.children.fold([], |nodes: List<Node>, n: Node|
      match n {
        Element(child) -> nodes.push(Element(without_indentation(child))),
        Text(_) -> if laid_out { nodes } else { nodes.push(n) },
        Miscellaneous(_) -> nodes.push(n),
      }),
  }
}

/// Returns a phrase that describes an error's reason, to place at the end of an error message.
pub fn explain(reason: ErrorKind) -> String =
  match reason {
    Doctype -> "a document type declaration (`<!DOCTYPE ...>`), which this parser rejects",
    Encoding(name_out) ->
      "the encoding " ++ name_out
        ++ ", which this parser rejects (only UTF-8 and UTF-16 are accepted)",
    NotUtf8 -> "bytes that are not valid UTF-8",
    NotUtf16 -> "UTF-16 that ends in the middle of a code unit or contains an unpaired surrogate",
    IllegalChar(point) ->
      "the character " ++ point.to_string() ++ ", which an XML document may not contain here",
    Truncated -> "the document ends inside an element or a piece of markup",
    NoRoot -> "the document contains no element",
    OutsideRoot -> "only comments and instructions may appear outside the root element",
    BadMarkup -> "a `<` opens a tag, a comment or an instruction: write `&lt;` for the character",
    BadName -> "a name is missing, or contains a colon where XML namespaces allow none",
    BadTag ->
      "a tag is written as its name, then attributes that each start with a space, then `>` or `/>`",
    BadAttribute -> "an attribute is written as its name, `=` and a quoted value",
    LessThanInValue -> "an attribute value may not contain `<`: write `&lt;` for the character",
    DuplicateAttribute(name_out) -> "the attribute " ++ name_out ++ " is written twice",
    Mismatched(name_out) -> "this end tag does not close " ++ name_out ++ ", the element open here",
    DoubleHyphen -> "a comment may not contain `--` or end in `-`",
    CDataEnd -> "text may not contain `]]>`: write `]]&gt;`",
    BadInstruction ->
      "a processing instruction is written as a name other than `xml`, a space, then data that does not contain `?>`",
    BadDeclaration ->
      "an XML declaration is written as a version (`1.` followed by digits), then an optional encoding, then an optional `standalone`",
    BadReference -> "an `&` begins a reference: write `&amp;` for the character",
    UnknownEntity(name_out) ->
      "the entity " ++ name_out ++ " is not one of lt, gt, amp, apos and quot",
    IllegalReference(point) ->
      "a reference to " ++ point.to_string()
        ++ ", which is not a character an XML document may contain",
    UnboundPrefix(prefix) -> "no declaration in scope binds the prefix " ++ prefix,
    BadNamespace(prefix) ->
      "the prefix `" ++ prefix
        ++ "` is declared or used in a way the XML namespace rules do not allow",
    NotAName(text) -> "`" ++ text ++ "` is not a name, or it contains a colon",
    SplitText -> "two text nodes are next to each other, or a text node is empty",
    TooDeep -> "elements are nested deeper than the limit",
    TooManyAttributes -> "an element has more attributes than the limit",
    NameTooLong -> "a name is longer than the limit",
    TextTooLong -> "text, an attribute value, a comment or an instruction is longer than the limit",
    TooManyEvents ->
      "the document produces more parse events (tags, text and comments) than the limit",
    TooLarge -> "the document is longer than the limit",
  }

/// The parsed form of an `xml"..."` literal: its root element, with the texts that lie between the
/// literal's holes. A hole is a place in the literal where a value is inserted.
pub type Template = new { root: Mold }

type Mold = new {
  name: Name,
  attributes: List<Valued>,
  children: List<Cast>,
  declared: List<Binding>,
}

type Valued = { name: Name, texts: List<String> }

type Cast = | Child(Mold) | Texts(List<String>) | Annotation(Miscellaneous)

fn element_to_mold(e: Element) -> Mold =
  {
    name: e.name,
    attributes: e.attributes.map(|a: Attribute| { name: a.name, texts: a.value.split("\u{fdd0}") }),
    children: e.children.map(|n: Node|
      match n {
        Element(child) -> Child(element_to_mold(child)),
        Text(t) -> Texts(t.split("\u{fdd0}")),
        Miscellaneous(m) -> Annotation(m),
      }),
    declared: spelling_value(e.declared),
  }

/// Why a literal's markup is rejected, and at which character of which text.
pub type LiteralError = { message: String, offset: Int, part: Int }

/// `text` as the contents of a hole: one text node, or nothing for the empty string.
pub fn chars(text: String) -> List<Node> = if text == "" { [] } else { [Text(text)] }

const hole_mark: Bytes = b"\xef\xb7\x90"

fn marks_in(text: String) -> Int / {abort.raise} = Bytes::of_string(text).split(hole_mark).len() - 1

type Joined = { pieces: List<Bytes>, at: Int, starts: List<Int>, marks: List<Int> }

fn joined_parts(parts: List<String>, quoted: List<Bool>) -> Joined =
  range(0, parts.len()).fold({ pieces: [], at: 0, starts: [], marks: [] }, |j: Joined, k: Int| {
    let text = Bytes::of_string(parts.at_or(k, ""));
    let after = j.at + text.len();
    let lead = if quoted.at_or(k, false) { 1 } else { 0 };
    if k == parts.len() - 1 {
      { ..j, pieces: j.pieces.push(text), at: after, starts: j.starts.push(j.at) }
    } else {
      {
        pieces: j.pieces.push(text).push(if lead == 1 { b"\"\xef\xb7\x90\"" } else { hole_mark }),
        at: after + 3 + 2 * lead,
        starts: j.starts.push(j.at),
        marks: j.marks.push(after + lead),
      }
    }
  })

/// Checks an `xml"..."` literal that has holes. Takes the texts around the holes and returns them
/// as one element template, or an error at the first character, hole or end of the literal that is
/// invalid. A hole may be in an element's content, inside a quoted attribute value, or be a whole
/// attribute value, as in `name={hole}`. An error just past the end of a text is reported at the
/// hole that follows that text, or at the end of the literal after the last text.
pub fn compile(parts: List<String>) -> Result<Template, LiteralError> / {abort.raise} =
  match parts.find_index(|p: String| p.contains("\u{fdd0}")) {
    Some(k) ->
      Err({
        message: "a literal cannot contain the character U+FDD0, which the compiler reserves to mark each hole in the literal",
        offset: parts.at_or(k, "").find("\u{fdd0}"),
        part: k,
      }),
    None -> templated(parts, parts.map(|_: String| false), parts.len()),
  }

fn templated(
  parts: List<String>,
  quoted: List<Bool>,
  left: Int,
) -> Result<Template, LiteralError> / {abort.raise} = {
  let j = joined_parts(parts, quoted);
  let text = Bytes::concat_all(j.pieces);
  match try { placed(text, parts) } {
    Ok(make_step) -> make_step,
    Err(rejection) -> match j.marks.index_of(rejection.at) {
      Some(k) -> if rejection.reason == BadAttribute && left > 0 && !quoted.at_or(k, true) {
        templated(parts, quoted.set(k, true), left - 1)
      } else {
        Err(
          at_hole(
            parts,
            k,
            "a hole can appear only in an element's content or in an attribute's value",
          ),
        )
      },
      None -> Err(literal_error(parts, j.starts, rejection)),
    },
  }
}

fn at_hole(parts: List<String>, k: Int, message: String) -> LiteralError =
  { message: message, offset: parts.at_or(k, "").len(), part: k }

fn literal_error(
  parts: List<String>,
  starts: List<Int>,
  rejection: Error,
) -> LiteralError / {abort.raise} = {
  let part = max(starts.filter(|from: Int| from <= rejection.at).len() - 1, 0);
  let text = Bytes::of_string(parts.at_or(part, ""));
  let within = min(max(rejection.at - starts.at_or(part, 0), 0), text.len());
  { message: explain(rejection.reason), offset: column_of(text, 0, within, 0), part: part }
}

fn placed(
  text: Bytes,
  parts: List<String>,
) -> Result<Template, LiteralError> / {xml.fail, abort.raise} = {
  let d = read(text, default_limits);
  let walk = scan_holes(start(text, default_limits), 0, text.len() + 2);
  match walk.hole_error {
    Some(message) -> Err(at_hole(parts, walk.seen, message)),
    None -> if walk.seen != parts.len() - 1 {
      Err({
        message: "a character reference to U+FDD0 is not allowed, because U+FDD0 marks an interpolation",
        offset: 0,
        part: 0,
      })
    } else if spelling_value(d.declaration) != None || !d.before.is_empty() || !d.after.is_empty() {
      Err({
        message: "a literal must be a single element, with no declaration or other content before or after it",
        offset: 0,
        part: 0,
      })
    } else { Ok({ root: element_to_mold(d.root) }) },
  }
}

type Walk = { hole_error: Option<String>, seen: Int }

fn scan_holes(c: Cursor, seen: Int, left: Int) -> Walk / {xml.fail, abort.raise} =
  match next(c) {
    None -> { hole_error: None, seen: seen },
    Some(step) -> if left <= 0 { panic("more events than bytes") } else {
      match step.event {
        Characters(text) -> scan_holes(step.rest, seen + marks_in(text), left - 1),
        CommentOrInstruction(Comment(text)) -> if marks_in(text) > 0 {
          { hole_error: Some("a hole cannot be inside a comment"), seen: seen }
        } else { scan_holes(step.rest, seen, left - 1) },
        CommentOrInstruction(Instruction(_, data)) -> if marks_in(data) > 0 {
          {
            hole_error: Some("a processing instruction cannot contain an interpolation"),
            seen: seen,
          }
        } else { scan_holes(step.rest, seen, left - 1) },
        StartElement(_) -> {
          let tag = raws_at(c, step.at).fold(
            { hole_error: None, seen: seen },
            |w: Walk, raw: RawAttribute| {
              let declares = raw.name == b"xmlns" || raw.name.starts_with(b"xmlns:");
              if w.hole_error != None { w } else if declares && marks_in(raw.value) > 0 {
                { ..w, hole_error: Some("a namespace declaration cannot contain an interpolation") }
              } else { { ..w, seen: w.seen + marks_in(raw.value) } }
            },
          );
          if tag.hole_error != None { tag } else { scan_holes(step.rest, tag.seen, left - 1) }
        },
        _ -> scan_holes(step.rest, seen, left - 1),
      }
    },
  }

fn raws_at(c: Cursor, i: Int) -> List<RawAttribute> / {xml.fail, abort.raise} =
  attributes(c, name_end(c.data, i + 1, c.sound), [], c.data.len() - i).raws

/// The element a literal makes with `holes` filled in. In content a hole becomes its nodes, and in
/// an attribute's value their text. A hole with no entry in the list is empty.
pub fn fill(t: Template, holes: List<List<Node>>) -> Element = filled(t.root, holes, 0).element

type Filled = { element: Element, next: Int }

type FilledAttributes = { attributes: List<Attribute>, next: Int }

type FilledChildren = { joining: JoinState, next: Int }

fn filled(m: Mold, holes: List<List<Node>>, from: Int) -> Filled = {
  let woven_values = m.attributes.fold(
    { attributes: [], next: from },
    |w: FilledAttributes, a: Valued|
      {
        attributes: w.attributes.push({ name: a.name, value: woven(a.texts, holes, w.next) }),
        next: w.next + a.texts.len() - 1,
      },
  );
  let grafted = m.children.fold(
    { joining: { nodes: [], text: [] }, next: woven_values.next },
    |g: FilledChildren, c: Cast|
      match c {
        Texts(texts) -> grafts(texts, holes, g),
        Child(child) -> {
          let inner = filled(child, holes, g.next);
          { joining: join_text(g.joining, Element(inner.element)), next: inner.next }
        },
        Annotation(miscellaneous) ->
          { ..g, joining: join_text(g.joining, Miscellaneous(miscellaneous)) },
      },
  );
  {
    element: {
      name: m.name,
      attributes: woven_values.attributes,
      children: flush_text(grafted.joining),
      declared: Spelling(m.declared),
    },
    next: grafted.next,
  }
}

fn woven(texts: List<String>, holes: List<List<Node>>, from: Int) -> String =
  String::of_bytes_lossy(
    Bytes::concat_all(
      range(0, texts.len()).fold([], |out: List<Bytes>, k: Int| {
        let with_text = out.push(Bytes::of_string(texts.at_or(k, "")));
        if k == texts.len() - 1 { with_text }
        else { holes.at_or(from + k, []).fold(with_text, append_node_text) }
      }),
    ),
  )

fn append_node_text(out: List<Bytes>, n: Node) -> List<Bytes> =
  match n {
    Text(t) -> out.push(Bytes::of_string(t)),
    Element(e) -> append_text(e, out),
    Miscellaneous(_) -> out,
  }

fn grafts(texts: List<String>, holes: List<List<Node>>, g: FilledChildren) -> FilledChildren =
  range(0, texts.len()).fold(g, |accumulator: FilledChildren, k: Int| {
    let with_text = join_text(accumulator.joining, Text(texts.at_or(k, "")));
    if k == texts.len() - 1 { { ..accumulator, joining: with_text } } else {
      {
        joining: holes.at_or(accumulator.next, []).fold(with_text, join_text),
        next: accumulator.next + 1,
      }
    }
  })

/// Checks an `xml"..."` literal with no holes. Returns the text as one element, or the message and
/// character offset of the first error.
pub fn literal(text: String) -> Result<Element, { message: String, offset: Int }> / {abort.raise} =
  match compile([text]) {
    Ok(t) -> Ok(fill(t, [])),
    Err(rejected) -> Err({ message: rejected.message, offset: rejected.offset }),
  }

fn planted(numbers: List<Int>) -> Element = element(name("root"), [], numbers.fold([], sprouted))

fn sprouted(nodes: List<Node>, n: Int) -> List<Node> = {
  let k = (n & 0xFFFF) / 8;
  match n & 7 {
    0 | 1 -> nodes.push(Text(words.at_or(k % 8, "x"))),
    2 -> nodes.push(Miscellaneous(Comment(words.at_or(k % 3, "x")))),
    3 ->
      nodes.push(
        Miscellaneous(Instruction("p" ++ Int::to_string(k % 3), ["", "a", "b c"].at_or(k % 3, ""))),
      ),
    _ -> {
      let wrap_start = nodes.len() - min(k % 4, nodes.len());
      nodes.take(wrap_start).push(
        Element(
          element(
            names().at_or(k / 4 % 8, name("a")),
            attribute_sets.at_or(k / 32 % 5, []),
            nodes.drop(wrap_start),
          ),
        ),
      )
    },
  }
}

const words: List<String> =
  ["a", "b c", " d ", "<&>", "]]>", "\"'", "\t\n\r \r\n", "\u{e9}\u{1d11e}"]

fn names() -> List<Name> =
  [
    name("a"),
    name("b"),
    qualified("urn:x", "a"),
    prefixed("urn:x", "p", "b"),
    prefixed("urn:y", "p", "c"),
    qualified("urn:y", "d"),
    prefixed("urn:z", "q", "e"),
    qualified(xml_namespace, "f"),
  ]

const attribute_sets: List<List<Attribute>> =
  [
    [],
    [attribute(name("k"), "<&>\"'")],
    [attribute(prefixed("urn:x", "p", "k"), "\t\n\r"), attribute(name("k"), " a  b ")],
    [attribute(qualified("urn:y", "k"), "v"), attribute(prefixed("urn:x", "q", "j"), "]]>")],
    [attribute(qualified(xml_namespace, "lang"), "en"), attribute(prefixed("urn:z", "p", "k"), "")],
  ]

fn write_then_parse(numbers: List<Int>) -> Result<Document, Error> / {xml.unwritable, abort.raise} =
  parse(write(document(planted(numbers)), Compact), default_limits)

fn reserialize(text: Bytes) -> Bytes / {abort.raise} =
  match parse(text, default_limits) {
    Err(_) -> text,
    Ok(d) -> match encode(d, Compact) { Ok(write_compact) -> write_compact, Err(_) -> text },
  }

test "a tree the writer writes reads back as itself" {
  gen::check(gen::list(gen::any_int()), |x: List<Int>|
    agrees(write_then_parse, |numbers: List<Int>| Ok(document(planted(numbers))), x))
}

test "writing a tree with any indentation, parsing that text and writing it again gives the same text" {
  gen::check2(gen::list(gen::any_int()), gen::any_int(), |numbers: List<Int>, indent: Int| {
    let once = reserialize(write(document(planted(numbers)), Indented(indent & 7)));
    reserialize(once) == once
  })
}

const tight: Limits =
  {
    max_depth: 2,
    max_attributes: 2,
    max_name_bytes: 8,
    max_text_bytes: 8,
    max_events: 8,
    max_document_bytes: 64,
  }

fn failure_of(text: Bytes, limits: Limits) -> Option<ErrorKind> / {abort.raise} =
  match parse(text, limits) { Ok(_) -> None, Err(rejection) -> Some(rejection.reason) }

fn rewritten(text: String) -> String / {abort.raise} =
  match parse(Bytes::of_string(text), default_limits) {
    Err(_) -> "refused",
    Ok(d) -> match encode(d, Compact) { Ok(b) -> String::of_bytes(b), Err(_) -> "unwritable" },
  }

fn write_compact(e: Element) -> Result<String, ErrorKind> / {abort.raise} =
  match encode(document(e), Compact) {
    Ok(b) -> Ok(String::of_bytes(b)),
    Err(reason) -> Err(reason),
  }

fn plain(local: String, children: List<Node>) -> Element = element(name(local), [], children)

fn root_of(text: String) -> Element / {abort.raise} =
  match parse(Bytes::of_string(text), default_limits) {
    Ok(d) -> d.root,
    Err(_) -> plain("refused", []),
  }

type Rejected = { name: String, text: Bytes, at: Int, line: Int, column: Int, reason: ErrorKind }

const rejections: List<Rejected> =
  [
    {
      name: "a document type declaration",
      text: b"<!DOCTYPE a><a/>",
      at: 0,
      line: 1,
      column: 1,
      reason: Doctype,
    },
    {
      name: "an entity declared in an internal subset",
      text: b"<?xml version=\"1.0\"?>\n<!DOCTYPE a [<!ENTITY x SYSTEM \"file:///etc/passwd\">]><a>&x;</a>",
      at: 22,
      line: 2,
      column: 1,
      reason: Doctype,
    },
    {
      name: "a declaration after the root",
      text: b"<a/><!DOCTYPE a>",
      at: 4,
      line: 1,
      column: 5,
      reason: Doctype,
    },
    {
      name: "a declaration inside the root",
      text: b"<a><!DOCTYPE a></a>",
      at: 3,
      line: 1,
      column: 4,
      reason: Doctype,
    },
    {
      name: "Latin-1 by its declaration",
      text: b"<?xml version='1.0' encoding='ISO-8859-1'?><a/>",
      at: 30,
      line: 1,
      column: 31,
      reason: Encoding("ISO-8859-1"),
    },
    {
      name: "UTF-16 with no mark",
      text: b"\x00<\x00?\x00x\x00m",
      at: 0,
      line: 1,
      column: 1,
      reason: Encoding("UTF-16BE"),
    },
    {
      name: "UCS-4",
      text: b"\x00\x00\x00<\x00\x00\x00a",
      at: 0,
      line: 1,
      column: 1,
      reason: Encoding("UCS-4"),
    },
    {
      name: "a byte that is not UTF-8",
      text: b"<a>\xc3\xa9\xff</a>",
      at: 5,
      line: 1,
      column: 5,
      reason: NotUtf8,
    },
    {
      name: "a surrogate written in UTF-8",
      text: b"<a>\xed\xa0\x80</a>",
      at: 3,
      line: 1,
      column: 4,
      reason: NotUtf8,
    },
    {
      name: "a UTF-16 surrogate with no pair",
      text: b"\xfe\xff\x00<\xd8\x00\x00a",
      at: 1,
      line: 1,
      column: 2,
      reason: NotUtf16,
    },
    {
      name: "a control character",
      text: b"<a>\n\x01</a>",
      at: 4,
      line: 2,
      column: 1,
      reason: IllegalChar(1),
    },
    {
      name: "U+FFFE",
      text: b"<a>\xef\xbf\xbe</a>",
      at: 3,
      line: 1,
      column: 4,
      reason: IllegalChar(0xFFFE),
    },
    {
      name: "a control character before a later mistake",
      text: b"<a \x02></b>",
      at: 3,
      line: 1,
      column: 4,
      reason: IllegalChar(2),
    },
    {
      name: "an element left open",
      text: b"<a><b></b>",
      at: 10,
      line: 1,
      column: 11,
      reason: Truncated,
    },
    { name: "a tag left open", text: b"<a x='1'", at: 8, line: 1, column: 9, reason: Truncated },
    {
      name: "a comment left open",
      text: b"<a><!-- c",
      at: 3,
      line: 1,
      column: 4,
      reason: Truncated,
    },
    {
      name: "nothing but a comment",
      text: b"<!--c-->\r\n",
      at: 10,
      line: 2,
      column: 1,
      reason: NoRoot,
    },
    { name: "text after the root", text: b"<a/>x", at: 4, line: 1, column: 5, reason: OutsideRoot },
    {
      name: "text before the root",
      text: b"x<a/>",
      at: 0,
      line: 1,
      column: 1,
      reason: OutsideRoot,
    },
    { name: "a second root", text: b"<a/>\r<b/>", at: 5, line: 2, column: 1, reason: OutsideRoot },
    {
      name: "a reference after the root",
      text: b"<a/>&#32;",
      at: 4,
      line: 1,
      column: 5,
      reason: OutsideRoot,
    },
    {
      name: "a bare less-than sign",
      text: b"<a>1 < 2</a>",
      at: 5,
      line: 1,
      column: 6,
      reason: BadMarkup,
    },
    {
      name: "an attribute named by a digit",
      text: b"<a 1='x'/>",
      at: 3,
      line: 1,
      column: 4,
      reason: BadName,
