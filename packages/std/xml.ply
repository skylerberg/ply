      at: 5,
      line: 1,
      column: 6,
      reason: BadReference,
    },
    {
      name: "a reference with no semicolon",
      text: b"<a x='&amp'/>",
      at: 6,
      line: 1,
      column: 7,
      reason: BadReference,
    },
    {
      name: "an entity nothing declares",
      text: b"<a>&nbsp;</a>",
      at: 3,
      line: 1,
      column: 4,
      reason: UnknownEntity("nbsp"),
    },
    {
      name: "a reference to U+0000",
      text: b"<a>&#0;</a>",
      at: 3,
      line: 1,
      column: 4,
      reason: IllegalReference(0),
    },
    {
      name: "a reference to a surrogate",
      text: b"<a>&#xD800;</a>",
      at: 3,
      line: 1,
      column: 4,
      reason: IllegalReference(0xD800),
    },
    {
      name: "a reference past Unicode",
      text: b"<a>&#99999999999999999999;</a>",
      at: 3,
      line: 1,
      column: 4,
      reason: IllegalReference(0x110000),
    },
    {
      name: "a prefix nothing binds",
      text: b"<a><p:b/></a>",
      at: 4,
      line: 1,
      column: 5,
      reason: UnboundPrefix("p"),
    },
    {
      name: "a prefix out of scope",
      text: b"<a><b xmlns:p='u'/><c p:x='1'/></a>",
      at: 22,
      line: 1,
      column: 23,
      reason: UnboundPrefix("p"),
    },
    {
      name: "the prefix xmlns declared",
      text: b"<a xmlns:xmlns='u'/>",
      at: 3,
      line: 1,
      column: 4,
      reason: BadNamespace("xmlns"),
    },
    {
      name: "a prefix bound to nothing",
      text: b"<a xmlns:p=''/>",
      at: 3,
      line: 1,
      column: 4,
      reason: BadNamespace("p"),
    },
    {
      name: "the prefix xml bound elsewhere",
      text: b"<a xmlns:xml='u'/>",
      at: 3,
      line: 1,
      column: 4,
      reason: BadNamespace("xml"),
    },
    {
      name: "an element named with xmlns",
      text: b"<xmlns:a/>",
      at: 1,
      line: 1,
      column: 2,
      reason: BadNamespace("xmlns"),
    },
  ]

test "`parse` rejects the malformed input {c.name} with the expected line, column and reason" for c: Rejected in rejections {
  assert_eq(
    parse(c.text, default_limits),
    Err({ at: c.at, line: c.line, column: c.column, reason: c.reason }),
  )
}

type Limited = { name: String, text: Bytes, reason: ErrorKind }

const past_limits: List<Limited> =
  [
    { name: "a third level", text: b"<a><b><c/></b></a>", reason: TooDeep },
    { name: "a third attribute", text: b"<a x='1' y='2' xmlns:p='u'/>", reason: TooManyAttributes },
    { name: "a name of nine bytes", text: b"<abcdefghi/>", reason: NameTooLong },
    { name: "an attribute name of nine bytes", text: b"<a abcdefghi='1'/>", reason: NameTooLong },
    { name: "text of nine bytes", text: b"<a>12345678&#57;</a>", reason: TextTooLong },
    { name: "a value of nine bytes", text: b"<a x='123456789'/>", reason: TextTooLong },
    { name: "a comment of nine bytes", text: b"<a/><!--123456789-->", reason: TextTooLong },
    { name: "a ninth event", text: b"<a><b/>1<b/>2<b/>3<b/></a>", reason: TooManyEvents },
    {
      name: "a sixty-fifth byte",
      text: Bytes::concat_all([b"<a>", b" ".repeat(58), b"</a>"]),
      reason: TooLarge,
    },
  ]

test "a document past its limits is rejected: {c.name}" for c: Limited in past_limits {
  assert_eq(failure_of(c.text, tight), Some(c.reason))
}

test "a document at its limits is read, and a limit that is not positive allows nothing" {
  assert_eq(failure_of(b"<a x='1' y='2'><abcdefgh>12345678</abcdefgh><!--c--></a>", tight), None);
  assert_eq(failure_of(b"<a/>", { ..tight, max_depth: 0 }), Some(TooDeep));
  assert_eq(failure_of(b"<a/>", { ..tight, max_events: 0 }), Some(TooManyEvents));
  assert_eq(failure_of(b"<a x=''/>", { ..tight, max_attributes: 0 }), Some(TooManyAttributes));
  let nested = |levels: Int| Bytes::concat_all([b"<a>".repeat(levels), b"</a>".repeat(levels)]);
  let roomy: Limits = { ..default_limits, max_depth: 1000000 };
  assert_eq(failure_of(nested(maximum_depth), roomy), None);
  assert_eq(failure_of(nested(maximum_depth + 1), roomy), Some(TooDeep))
}

test "`events` returns a document's events in order, and joins the text between markup into one `Characters` event" {
  assert_eq(
    try {
      events(
        b"<?xml version=\"1.0\"?>\n<a x='1'>hi<b/>&amp;<![CDATA[<]]>&#x21;</a><!--c--><?p d ?>\n",
        default_limits,
      )
    },
    Ok([
      XmlDeclaration({ version: "1.0", encoding: None, standalone: None }),
      StartElement({ name: name("a"), attributes: [attribute(name("x"), "1")], declared: [] }),
      Characters("hi"),
      StartElement({ name: name("b"), attributes: [], declared: [] }),
      EndElement(name("b")),
      Characters("&<!"),
      EndElement(name("a")),
      CommentOrInstruction(Comment("c")),
      CommentOrInstruction(Instruction("p", "d ")),
    ]),
  );
  assert_eq(
    try {
      events(
        b"\xef\xbb\xbf<?xml version='1.1' encoding='utf-8' standalone='no'?><a><![CDATA[]]></a>",
        default_limits,
      )
    },
    Ok([
      XmlDeclaration({ version: "1.1", encoding: Some("utf-8"), standalone: Some(false) }),
      StartElement({ name: name("a"), attributes: [], declared: [] }),
      EndElement(name("a")),
    ]),
  )
}

test "element and attribute names resolve against the namespace declarations in scope, and each start event lists its own declarations" {
  assert_eq(
    try {
      events(
        b"<a xmlns='u' xmlns:p='v' p:x='1' y='2'><p:b xmlns=''><c xml:lang='en'/></p:b></a>",
        default_limits,
      )
    },
    Ok([
      StartElement({
        name: qualified("u", "a"),
        attributes: [attribute(qualified("v", "x"), "1"), attribute(name("y"), "2")],
        declared: [{ prefix: "", namespace: "u" }, { prefix: "p", namespace: "v" }],
      }),
      StartElement({
        name: qualified("v", "b"),
        attributes: [],
        declared: [{ prefix: "", namespace: "" }],
      }),
      StartElement({
        name: name("c"),
        attributes: [attribute(qualified(xml_namespace, "lang"), "en")],
        declared: [],
      }),
      EndElement(name("c")),
      EndElement(qualified("v", "b")),
      EndElement(qualified("u", "a")),
    ]),
  );
  let read = root_of("<p:a xmlns:p='u'/>");
  assert_eq(read.name, qualified("u", "a"));
  assert_eq(spelling_value(read.name.prefix), "p");
  assert_eq(spelling_value(read.declared), [{ prefix: "p", namespace: "u" }]);
  assert_eq(root_of("<p:a xmlns:p='u' p:k='1'/>"), root_of("<a xmlns='u' xmlns:q='u' q:k='1'/>"));
  assert(root_of("<p:a xmlns:p='u'/>") != root_of("<p:a xmlns:p='v'/>"))
}

test "a name is resolved under the scope it is read in, however often it was read before" {
  let spaces = |text: String|
    match try { events(Bytes::of_string(text), default_limits) } {
      Ok(all) ->
        all.fold([], |found: List<String>, e: Event|
          match e { StartElement(s) -> found.push(s.name.namespace), _ -> found }),
      Err(_) -> [],
    };
  assert_eq(spaces("<p:a xmlns:p='u'><p:a xmlns:p='v'><p:a/></p:a><p:a/></p:a>"), [
    "u",
    "v",
    "v",
    "u",
  ]);
  assert_eq(spaces("<r xmlns='u'><a/><b xmlns='v'><a/><c><a/></c></b><a/></r>"), [
    "u",
    "u",
    "v",
    "v",
    "v",
    "v",
    "u",
  ]);
  assert_eq(
    root_of("<r k='1' xmlns:p='u'><a k='2' p:k='3'/><a k='4'/></r>"),
    element(name("r"), [attribute(name("k"), "1")], [
      Element(
        element(name("a"), [attribute(name("k"), "2"), attribute(qualified("u", "k"), "3")], []),
      ),
      Element(element(name("a"), [attribute(name("k"), "4")], [])),
    ]),
  )
}

test "line ends become line feeds, and white space in an attribute value becomes spaces unless a character reference wrote it" {
  assert_eq(
    root_of(
      "<a x=' a\tb\r\nc\rd&#9;&#10;&#13; '>e\r\nf\rg&#13;<!--h\r\ni--><?p j\rk?><![CDATA[l\r\nm]]></a>",
    ),
    element(name("a"), [attribute(name("x"), " a b c d\t\n\r ")], [
      Text("e\nf\ng\r"),
      Miscellaneous(Comment("h\ni")),
      Miscellaneous(Instruction("p", "j\nk")),
      Text("l\nm"),
    ]),
  )
}

test "UTF-16 with either byte order mark parses to the same document as the UTF-8 text" {
  let wide = |big: Bool, text: String|
    Bytes::concat_all(
      text.chars().map(|ch: Char| {
        let unit = Int::of_char(ch);
        if big { byte_of_int(unit >> 8).concat(byte_of_int(unit & 0xFF)) }
        else { byte_of_int(unit & 0xFF).concat(byte_of_int(unit >> 8)) }
      }),
    );
  let text = "<?xml version='1.0' encoding='UTF-16'?><a k='\u{e9}'>\u{4e2d}</a>";
  let expected = Ok(element(name("a"), [attribute(name("k"), "\u{e9}")], [Text("\u{4e2d}")]));
  let root = |data: Bytes|
    match parse(data, default_limits) {
      Ok(d) -> Ok(d.root),
      Err(rejection) -> Err(rejection.reason),
    };
  assert_eq(root(b"\xfe\xff".concat(wide(true, text))), expected);
  assert_eq(root(b"\xff\xfe".concat(wide(false, text))), expected);
  assert_eq(
    root(b"\xfe\xff\x00<\x00a\x00>\xd8\x34\xdd\x1e\x00<\x00/\x00a\x00>"),
    Ok(element(name("a"), [], [Text("\u{1d11e}")])),
  );
  assert_eq(root(Bytes::of_string(text)), Err(Encoding("UTF-16")));
  assert_eq(
    root(b"\xfe\xff".concat(wide(true, "<?xml version='1.0' encoding='UTF-8'?><a/>"))),
    Err(Encoding("UTF-8")),
  )
}

test "a cursor stops, skips an element, or builds a subtree exactly where the caller asks" {
  let c = start(b"<r><skip><x>1</x><y/></skip><keep k='v'>2<z/></keep><more/></r>", default_limits);
  let read = try {
    let root = match next(c) { Some(step) -> step.rest, None -> c };
    let skip_element = match next(root) { Some(step) -> skip(step.rest), None -> root };
    match next(skip_element) {
      Some(step) -> match step.event {
        StartElement(open_element) -> {
          let subtree_result = subtree(open_element, step.rest);
          { element: subtree_result.element, at: subtree_result.rest.at }
        },
        _ -> { element: plain("none", []), at: 0 },
      },
      None -> { element: plain("none", []), at: 0 },
    }
  };
  assert_eq(
    read,
    Ok({
      element: element(name("keep"), [attribute(name("k"), "v")], [
        Text("2"),
        Element(plain("z", [])),
      ]),
      at: 52,
    }),
  );
  assert_eq(position(b"a\r\nb\xc3\xa9c\rd", 6), { offset: 6, line: 2, column: 3 });
  assert_eq(position(b"a\r\nb\xc3\xa9c\rd", 8), { offset: 8, line: 3, column: 1 });
  assert_eq(position(b"\xef\xbb\xbf<a>", 4), { offset: 4, line: 1, column: 2 });
  assert_eq(
    parse(b"\xef\xbb\xbf<a></b>", default_limits),
    Err({ at: 6, line: 1, column: 4, reason: Mismatched("a") }),
  )
}

test "a tree is written as it was read, and escaped where needed" {
  assert_eq(rewritten("<a x='1'>hi<b/></a>"), "<a x=\"1\">hi<b/></a>");
  assert_eq(rewritten("<a  x = \"1\" ></a >"), "<a x=\"1\"/>");
  assert_eq(
    rewritten(
      "<?xml version='1.0' encoding='utf-8' standalone='yes'?>\n<!--c-->\n<a/>\n<?p  d ?>\n",
    ),
    "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?><!--c--><a/><?p d ?>",
  );
  assert_eq(
    rewritten("<a>1 &lt; 2 &amp; 3 > 2 <![CDATA[<&>]]> ]]&gt;&#13;</a>"),
    "<a>1 &lt; 2 &amp; 3 &gt; 2 &lt;&amp;&gt; ]]&gt;&#xD;</a>",
  );
  assert_eq(
    rewritten("<a x='a\tb\nc&#9;d&#10;e&#13;f\"g&apos;h&lt;'/>"),
    "<a x=\"a b c&#x9;d&#xA;e&#xD;f&quot;g'h&lt;\"/>",
  );
  let spelled_out = "<p:a xmlns:p=\"u\" xmlns=\"v\" xmlns:unused=\"w\"><b p:x=\"1\"/><c xmlns=\"\"/></p:a>";
  assert_eq(rewritten(spelled_out), spelled_out)
}

test "a namespace is declared where a name first needs it" {
  assert_eq(write_compact(element(qualified("u", "a"), [], [])), Ok("<a xmlns=\"u\"/>"));
  assert_eq(
    write_compact(element(prefixed("u", "p", "a"), [attribute(qualified("u", "x"), "1")], [])),
    Ok("<p:a xmlns:p=\"u\" p:x=\"1\"/>"),
  );
  assert_eq(
    write_compact(element(qualified("u", "a"), [attribute(qualified("u", "x"), "1")], [])),
    Ok("<a xmlns=\"u\" xmlns:ns1=\"u\" ns1:x=\"1\"/>"),
  );
  assert_eq(
    write_compact(
      element(qualified("u", "a"), [], [
        Element(plain("b", [Element(element(qualified("u", "c"), [], []))])),
      ]),
    ),
    Ok("<a xmlns=\"u\"><b xmlns=\"\"><c xmlns=\"u\"/></b></a>"),
  );
  assert_eq(
    write_compact(
      element(
        prefixed("u", "p", "a"),
        [attribute(prefixed("v", "p", "x"), "1"), attribute(prefixed("w", "p", "y"), "2")],
        [
          Element(element(prefixed("v", "p", "b"), [], [])),
          Element(element(prefixed("u", "q", "c"), [], [])),
        ],
      ),
    ),
    Ok(
      "<p:a xmlns:p=\"u\" xmlns:ns1=\"v\" xmlns:ns2=\"w\" ns1:x=\"1\" ns2:y=\"2\"><p:b xmlns:p=\"v\"/><q:c xmlns:q=\"u\"/></p:a>",
    ),
  );
  assert_eq(
    write_compact(element(name("a"), [attribute(qualified(xml_namespace, "lang"), "en")], [])),
    Ok("<a xml:lang=\"en\"/>"),
  );
  let defaulted: Element = {
    name: name("a"),
    attributes: [],
    children: [],
    declared: Spelling([{ prefix: "", namespace: "u" }, { prefix: "p", namespace: "v" }]),
  };
  assert_eq(write_compact(defaulted), Ok("<a xmlns:p=\"v\"/>"))
}

type Unwritable = { name: String, tree: Element, reason: ErrorKind }

fn hollow(children: List<Node>) -> Element =
  { name: name("a"), attributes: [], children: children, declared: Spelling([]) }

fn declaring_of(prefix: String, namespace: String) -> Element =
  {
    name: name("a"),
    attributes: [],
    children: [],
    declared: Spelling([{ prefix: prefix, namespace: namespace }]),
  }

const unwritables: List<Unwritable> =
  [
    { name: "a name with a space", tree: plain("a b", []), reason: NotAName("a b") },
    { name: "a name with a colon", tree: plain("a:b", []), reason: NotAName("a:b") },
    { name: "an empty name", tree: plain("", []), reason: NotAName("") },
    {
      name: "a prefix that is no name",
      tree: element(prefixed("u", "1", "a"), [], []),
      reason: NotAName("1"),
    },
    {
      name: "the prefix xml on another namespace",
      tree: element(prefixed("u", "xml", "a"), [], []),
      reason: NotAName("xml"),
    },
    {
      name: "an attribute called xmlns",
      tree: element(name("a"), [attribute(name("xmlns"), "u")], []),
      reason: NotAName("xmlns"),
    },
    {
      name: "an instruction's target with a colon",
      tree: plain("a", [Miscellaneous(Instruction("p:q", ""))]),
      reason: NotAName("p:q"),
    },
    {
      name: "a name in the namespace of declarations",
      tree: element(qualified(xmlns_namespace, "a"), [], []),
      reason: BadNamespace("xmlns"),
    },
    {
      name: "two text nodes side by side",
      tree: hollow([Text("x"), Text("y")]),
      reason: SplitText,
    },
    { name: "an empty text node", tree: hollow([Text("")]), reason: SplitText },
    {
      name: "a control character in text",
      tree: plain("a", [Text("\u{1}")]),
      reason: IllegalChar(1),
    },
    {
      name: "U+FFFF in a value",
      tree: element(name("a"), [attribute(name("x"), "\u{ffff}")], []),
      reason: IllegalChar(0xFFFF),
    },
    {
      name: "a carriage return in a comment",
      tree: plain("a", [Miscellaneous(Comment("b\rc"))]),
      reason: IllegalChar(13),
    },
    {
      name: "two hyphens in a comment",
      tree: plain("a", [Miscellaneous(Comment("b--c"))]),
      reason: DoubleHyphen,
    },
    {
      name: "a comment that ends in a hyphen",
      tree: plain("a", [Miscellaneous(Comment("b-"))]),
      reason: DoubleHyphen,
    },
    {
      name: "an instruction for xml",
      tree: plain("a", [Miscellaneous(Instruction("XML", ""))]),
      reason: BadInstruction,
    },
    {
      name: "an instruction that ends itself",
      tree: plain("a", [Miscellaneous(Instruction("p", "a?>b"))]),
      reason: BadInstruction,
    },
    {
      name: "an instruction's data led by a space",
      tree: plain("a", [Miscellaneous(Instruction("p", " a"))]),
      reason: BadInstruction,
    },
    {
      name: "an attribute twice",
      tree: element(
        name("a"),
        [attribute(prefixed("u", "p", "x"), "1"), attribute(prefixed("u", "q", "x"), "2")],
        [],
      ),
      reason: DuplicateAttribute("x"),
    },
    {
      name: "the prefix xmlns declared",
      tree: declaring_of("xmlns", "u"),
      reason: BadNamespace("xmlns"),
    },
    {
      name: "a prefix declared for no namespace",
      tree: declaring_of("p", ""),
      reason: BadNamespace("p"),
    },
    {
      name: "a prefix declared for the xml namespace",
      tree: declaring_of("p", xml_namespace),
      reason: BadNamespace("p"),
    },
    {
      name: "a prefix declared twice",
      tree: {
        name: name("a"),
        attributes: [],
        children: [],
        declared: Spelling([{ prefix: "p", namespace: "u" }, { prefix: "p", namespace: "v" }]),
      },
      reason: BadNamespace("p"),
    },
  ]

test "a tree no document can represent is rejected: {c.name}" for c: Unwritable in unwritables {
  assert_eq(write_compact(c.tree), Err(c.reason))
}

test "a tree deeper than `deepest()` is rejected, and a declaration is written as given" {
  let nested = range(0, maximum_depth).fold(plain("a", []), |inner: Element, _: Int|
    plain("a", [Element(inner)]));
  assert_eq(write_compact(nested), Err(TooDeep));
  let declared = |version: String|
    encode(
      {
        declaration: Spelling(
          Some({ version: version, encoding: Some("latin1"), standalone: Some(false) }),
        ),
        before: [],
        root: plain("a", []),
        after: [],
      },
      Compact,
    );
  assert_eq(
    declared("1.1"),
    Ok(b"<?xml version=\"1.1\" encoding=\"UTF-8\" standalone=\"no\"?><a/>"),
  );
  assert_eq(declared("2"), Err(BadDeclaration))
}

test "indentation gives a line to each child of an element that contains no text, and to nothing else" {
  let doc: Document = {
    declaration: Spelling(Some({ version: "1.0", encoding: None, standalone: None })),
    before: [Comment("b")],
    root: plain("a", [
      Element(plain("b", [Element(plain("c", [])), Miscellaneous(Comment("d"))])),
      Element(plain("e", [Text("x"), Element(plain("f", [Element(plain("g", []))]))])),
    ]),
    after: [Instruction("p", "")],
  };
  assert_eq(
    encode(doc, Indented(2)),
    Ok(
      b"<?xml version=\"1.0\"?>\n<!--b-->\n<a>\n  <b>\n    <c/>\n    <!--d-->\n  </b>\n  <e>x<f><g/></f></e>\n</a>\n<?p?>\n",
    ),
  );
  assert_eq(
    encode(doc, Compact),
    Ok(b"<?xml version=\"1.0\"?><!--b--><a><b><c/><!--d--></b><e>x<f><g/></f></e></a><?p?>"),
  );
  assert_eq(
    without_indentation(root_of("<a>\n  <b> x </b>\n  <c>\n  </c>\n</a>")),
    plain("a", [Element(plain("b", [Text(" x ")])), Element(plain("c", []))]),
  )
}

test "`plain` merges adjacent text nodes, and the lookup functions find elements by name whatever the prefix" {
  assert_eq(
    plain("a", [Text("x"), Text(""), Text("y"), Miscellaneous(Comment("c")), Text("")]).children,
    [Text("xy"), Miscellaneous(Comment("c"))],
  );
  let root = root_of(
    "<r><a k='1' n:k='2' xmlns:n='u'>x<b>y</b></a><a>z<!--c--></a><n:a xmlns:n='u'><b/></n:a></r>",
  );
  assert_eq(elements(root).len(), 3);
  assert_eq(children(root, name("a")).len(), 2);
  assert_eq(
    children(root, prefixed("u", "other", "a")).map(|e: Element| spelling_value(e.name.prefix)),
    ["n"],
  );
  assert_eq(text(root), "xyz");
  assert_eq(descendants(root, name("b")).len(), 2);
  assert_eq(descendants(root, name("r")).len(), 0);
  let first_a = match child(root, name("a")) { Some(a) -> a, None -> root };
  assert_eq(attribute_value(first_a, name("k")), Some("1"));
  assert_eq(attribute_value(first_a, qualified("u", "k")), Some("2"));
  assert_eq(attribute_value(first_a, name("missing")), None);
  assert_eq(child(root, name("b")), None);
  assert_eq(match find(root, "a/b") { Some(b) -> text(b), None -> "none" }, "y");
  assert_eq(find_all(root, "a").len(), 2);
  assert_eq(find_all(root, "{u}a").len(), 1);
  assert_eq(find_all(root, "{u}a/b").len(), 1);
  assert_eq(find_all(root, ""), [root]);
  assert_eq(find_all(root, "{u"), []);
  assert_eq(find_all(root, "a//b"), []);
  assert_eq(find(root, "b"), None)
}

test "`read` raises the same error that `parse` returns, and works inside a spawned task" {
  assert_eq(
    try { read(b"<a>", default_limits) },
    Err({ at: 3, line: 1, column: 4, reason: Truncated }),
  );
  let read_in_a_task = simulate {
    let t = task.spawn(|| try { read(b"<!DOCTYPE a><a/>", default_limits) });
    task.join(t)
  };
  assert_eq(read_in_a_task, Err({ at: 0, line: 1, column: 1, reason: Doctype }));
  assert_eq(try { write(document(plain("1", [])), Compact) }, Err(NotAName("1")))
}

fn filled_with(parts: List<String>, holes: List<List<Node>>) -> String / {abort.raise} =
  match compile(parts) {
    Err(rejected) -> rejected.message,
    Ok(t) -> match write_compact(fill(t, holes)) {
      Ok(text) -> text,
      Err(reason) -> explain(reason),
    },
  }

fn misplaced(parts: List<String>) -> Option<{ offset: Int, part: Int }> / {abort.raise} =
  match compile(parts) {
    Ok(_) -> None,
    Err(rejected) -> Some({ offset: rejected.offset, part: rejected.part }),
  }

test "an interpolated value is escaped as characters in an attribute value and as nodes in content, and is never read as markup" {
  assert_eq(
    filled_with(["<a href=", ">", "</a>"], [chars("x\" onclick=\"y"), chars("<script>&")]),
    "<a href=\"x&quot; onclick=&quot;y\">&lt;script&gt;&amp;</a>",
  );
  assert_eq(
    filled_with(["<a href='/u/", "?q=", "'>", " and ", "</a>"], [
      chars("a b"),
      [Element(plain("i", [Text("1")]))],
      [Element(plain("b", [])), Text("x")],
      [],
    ]),
    "<a href=\"/u/a b?q=1\"><b/>x and </a>",
  );
  assert_eq(filled_with(["<a>", "</a>"], []), "<a/>");
  assert_eq(filled_with(["<a k=", "/>"], []), "<a k=\"\"/>");
  assert_eq(filled_with(["<a k=", " j=", "/>"], [chars("1"), chars("2")]), "<a k=\"1\" j=\"2\"/>");
  assert_eq(
    filled_with(["<p:a xmlns:p='u'><![CDATA[", "]]><!--c--></p:a>"], [chars("]]>")]),
    "<p:a xmlns:p=\"u\">]]&gt;<!--c--></p:a>",
  )
}

test "an XML literal with markup split across interpolated values is rejected unless it forms one element, and the error gives the text offset and value index" {
  assert_eq(misplaced(["<a>", "</a>"]), None);
  assert_eq(misplaced(["<a ", ">x</a>"]), Some({ offset: 3, part: 0 }));
  assert_eq(misplaced(["<", "/>"]), Some({ offset: 0, part: 0 }));
  assert_eq(misplaced(["<a k=", "", "/>"]), Some({ offset: 0, part: 1 }));
  assert_eq(misplaced(["<a/>", ""]), Some({ offset: 4, part: 0 }));
  assert_eq(misplaced(["<a><!-- ", " --></a>"]), Some({ offset: 8, part: 0 }));
  assert_eq(misplaced(["<a><?p ", "?></a>"]), Some({ offset: 7, part: 0 }));
  assert_eq(misplaced(["<a x=", " xmlns:p=", " y='", "'/>"]), Some({ offset: 9, part: 1 }));
  assert_eq(misplaced(["<a>", "</b>"]), Some({ offset: 0, part: 1 }));
  assert_eq(misplaced(["<a>"]), Some({ offset: 3, part: 0 }));
  assert_eq(misplaced(["<a/><b/>"]), Some({ offset: 4, part: 0 }));
  assert_eq(misplaced(["<!--c--><a/>"]), Some({ offset: 0, part: 0 }));
  assert_eq(misplaced(["<a>caf\u{e9} & ", "</a>"]), Some({ offset: 8, part: 0 }));
  assert_eq(misplaced(["<a>\u{fdd0}</a>"]), Some({ offset: 3, part: 0 }));
  assert_eq(misplaced(["<a>&#xFDD0;", "</a>"]), Some({ offset: 0, part: 0 }));
  assert_eq(
    literal("<a x='1'>t</a>"),
    Ok(element(name("a"), [attribute(name("x"), "1")], [Text("t")])),
  );
  assert_eq(literal("<a>"), Err({ message: explain(Truncated), offset: 3 }))
}
