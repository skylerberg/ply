    {
      name: "a colon in a target",
      text: b"<?p:q?><a/>",
      at: 2,
      line: 1,
      column: 3,
      reason: BadName,
    },
    {
      name: "attributes with no space between",
      text: b"<a x='1'y='2'/>",
      at: 8,
      line: 1,
      column: 9,
      reason: BadTag,
    },
    {
      name: "an end tag with an attribute",
      text: b"<a></a x='1'>",
      at: 7,
      line: 1,
      column: 8,
      reason: BadTag,
    },
    {
      name: "an attribute with no value",
      text: b"<a x/>",
      at: 4,
      line: 1,
      column: 5,
      reason: BadAttribute,
    },
    {
      name: "a value with no quotes",
      text: b"<a x=1/>",
      at: 5,
      line: 1,
      column: 6,
      reason: BadAttribute,
    },
    {
      name: "a less-than sign in a value",
      text: b"<a x='<'/>",
      at: 6,
      line: 1,
      column: 7,
      reason: LessThanInValue,
    },
    {
      name: "an attribute written twice",
      text: b"<a x='1' x='2'/>",
      at: 9,
      line: 1,
      column: 10,
      reason: DuplicateAttribute("x"),
    },
    {
      name: "an attribute under two prefixes of one namespace",
      text: b"<a xmlns:p='u' xmlns:q='u' p:x='1' q:x='2'/>",
      at: 35,
      line: 1,
      column: 36,
      reason: DuplicateAttribute("q:x"),
    },
    {
      name: "an end tag for another element",
      text: b"<a>\n  <b></c>",
      at: 9,
      line: 2,
      column: 6,
      reason: Mismatched("b"),
    },
    {
      name: "an end tag for a longer name",
      text: b"<a></ab>",
      at: 3,
      line: 1,
      column: 4,
      reason: Mismatched("a"),
    },
    {
      name: "two hyphens in a comment",
      text: b"<a><!-- b -- c --></a>",
      at: 10,
      line: 1,
      column: 11,
      reason: DoubleHyphen,
    },
    {
      name: "a CDATA end in text",
      text: b"<a>\xc3\xa9]]></a>",
      at: 5,
      line: 1,
      column: 5,
      reason: CDataEnd,
    },
    {
      name: "an XML declaration inside the root",
      text: b"<a><?xml version='1.0'?></a>",
      at: 3,
      line: 1,
      column: 4,
      reason: BadInstruction,
    },
    {
      name: "a target with no space after it",
      text: b"<?p+?><a/>",
      at: 3,
      line: 1,
      column: 4,
      reason: BadInstruction,
    },
    {
      name: "version 2.0",
      text: b"<?xml version='2.0'?><a/>",
      at: 15,
      line: 1,
      column: 16,
      reason: BadDeclaration,
    },
    {
      name: "a declaration with its encoding first",
      text: b"<?xml encoding='UTF-8' version='1.0'?><a/>",
      at: 16,
      line: 1,
      column: 17,
      reason: BadDeclaration,
    },
    {
      name: "an ampersand that begins nothing",
