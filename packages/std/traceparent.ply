//! W3C Trace Context: the `traceparent` and `tracestate` headers that carry a request's trace.
//!
//! A `Traceparent` is the header as the Recommendation (level 1) defines it: a trace id of sixteen
//! bytes, the caller's span id of eight bytes (neither all zero), and eight flag bits. The first
//! flag is `sampled`. The second is level 2's `random`.
//!
//! `parse` accepts version `00`. For a later version it follows the Recommendation's rule for
//! unknown versions: it parses the first 55 characters as version `00` and ignores anything after a
//! `-` that follows them. It rejects any other input and reports the reason and the position of the
//! offending character. `render` always writes version `00`.
//!
//! A `Tracestate` is a list of vendor entries in order, with each key appearing once. `parse_state`
//! checks keys and values against the level 1 grammar (a key may be `tenant@system`) and rejects
//! more than 32 entries. `put` adds an entry, or replaces the entry with the same key, and places
//! it first, as the Recommendation requires for the entry a participant wrote last. `render_state`
//! writes at most 512 characters. It drops entries longer than 128 characters first, then drops
//! entries from the end.
//!
//! A parse error does not fail the request. The Recommendation says a participant that cannot parse
//! `traceparent` starts a new trace and ignores `tracestate`. `incoming` implements that rule: it
//! returns the `Context` to continue, or `None` to start a new trace.
//!
//! `new_trace_id` and `new_span_id` draw ids through the `entropy` effect of `std.random`, so a
//! test fixes them by handling it. `rand_trace_id` and `rand_span_id` draw ids from a `Rand`
//! instead. A `Traceparent` built from an id made here should set the `random` flag, because all of
//! the id's bytes are random.

import std.bytes
import std.gen
import std.gen (Gen)
import std.hex
import std.list
import std.random (Rand, entropy, rand, token_bytes, with_rand)
import std.string

/// A trace's id: sixteen bytes, not all zero.
pub opaque type TraceId = | TraceId(Bytes)

/// A span's id: eight bytes, not all zero.
pub opaque type SpanId = | SpanId(Bytes)

show for TraceId by trace_id_hex

show for SpanId by span_id_hex

/// Generates random trace ids of sixteen bytes, none of them all zero, for property tests.
pub fn trace_ids() -> Gen<TraceId> = gen::map(gen::bytes_of(16), |raw: Bytes| TraceId(nonzero(raw)))

/// Generates random span ids of eight bytes, none of them all zero, for property tests.
pub fn span_ids() -> Gen<SpanId> = gen::map(gen::bytes_of(8), |raw: Bytes| SpanId(nonzero(raw)))

/// The trace id of these bytes. `None` unless there are sixteen and at least one is not zero.
pub fn trace_id(raw: Bytes) -> Option<TraceId> / {abort.raise} =
  if raw.len() == 16 && !all_zero(raw) { Some(TraceId(raw)) } else { None }

/// The span id of these bytes. `None` unless there are eight and at least one is not zero.
pub fn span_id(raw: Bytes) -> Option<SpanId> / {abort.raise} =
  if raw.len() == 8 && !all_zero(raw) { Some(SpanId(raw)) } else { None }

/// A trace id's sixteen bytes.
pub fn trace_id_bytes(id: TraceId) -> Bytes = match id { TraceId(raw) -> raw }

/// A span id's eight bytes.
pub fn span_id_bytes(id: SpanId) -> Bytes = match id { SpanId(raw) -> raw }

/// A trace id as the header writes it: 32 lower-case hex digits.
pub fn trace_id_hex(id: TraceId) -> String = lower_hex(trace_id_bytes(id))

/// A span id as the header writes it: 16 lower-case hex digits.
pub fn span_id_hex(id: SpanId) -> String = lower_hex(span_id_bytes(id))

/// The trace id written as 32 lower-case hex digits. `None` for any other text, and for all zeros.
pub fn trace_id_of_hex(text: String) -> Option<TraceId> / {abort.raise} =
  match hex::decode(text) { Some(raw) -> trace_id(raw), None -> None }

/// The span id written as 16 lower-case hex digits. `None` for any other text, and for all zeros.
pub fn span_id_of_hex(text: String) -> Option<SpanId> / {abort.raise} =
  match hex::decode(text) { Some(raw) -> span_id(raw), None -> None }

/// Returns a new random trace id, generated from the operating system's entropy.
pub fn new_trace_id() -> TraceId / {entropy.next, abort.raise} = TraceId(nonzero(token_bytes(16)))

/// Returns a new random span id, generated from the operating system's entropy.
pub fn new_span_id() -> SpanId / {entropy.next, abort.raise} = SpanId(nonzero(token_bytes(8)))

/// Returns a trace id made by `new_trace_id` from the random generator `r`, together with the
/// generator to use next. Use it for reproducible ids.
pub fn rand_trace_id(r: Rand) -> { value: TraceId, rand: Rand } / {abort.raise} =
  with_rand(r, new_trace_id)

/// Returns a span id made by `new_span_id` from the random generator `r`, together with the
/// generator to use next. Use it for reproducible ids.
pub fn rand_span_id(r: Rand) -> { value: SpanId, rand: Rand } / {abort.raise} =
  with_rand(r, new_span_id)

fn nonzero(raw: Bytes) -> Bytes / {abort.raise} =
  if all_zero(raw) { raw.slice(0, raw.len() - 1).concat(b"\x01") } else { raw }

fn all_zero(raw: Bytes) -> Bool / {abort.raise} = raw.skip(0, b"\x00") >= raw.len()

fn lower_hex(raw: Bytes) -> String =
  match try[abort.raise] { raw.hex_of() } { Ok(text) -> text, Err(_) -> "" }

/// The `traceparent` header: which trace a request belongs to, which span of it made the
/// request, and the flags that span set.
pub opaque type Traceparent = new { trace_id: TraceId, parent_id: SpanId, flags: Int }

/// A generator of `Traceparent` values for tests.
pub fn traceparents() -> Gen<Traceparent> =
  gen::and_then(trace_ids(), |trace: TraceId|
    gen::map2(span_ids(), gen::below(256), |span: SpanId, flags: Int|
      { trace_id: trace, parent_id: span, flags: flags }))

/// The flag bit that means the caller recorded its span.
pub fn sampled_flag() -> Int = 1

/// The flag bit that means the trace id's last seven bytes are random. The W3C Trace Context Level
/// 2 specification defines it.
pub fn random_flag() -> Int = 2

/// A `traceparent` of these parts, keeping only the low eight bits of `flags`.
pub fn of_ids(trace: TraceId, parent: SpanId, flags: Int) -> Traceparent =
  { trace_id: trace, parent_id: parent, flags: flags & 0xFF }

/// Whether the caller recorded its span.
pub fn sampled(t: Traceparent) -> Bool = t.flags & sampled_flag() != 0

/// Returns whether the random flag is set: whether the trace id's last seven bytes are random, as
/// the W3C Trace Context Level 2 specification defines.
pub fn random(t: Traceparent) -> Bool = t.flags & random_flag() != 0

/// `t` with the sampled flag set to `recorded`.
pub fn with_sampled(t: Traceparent, recorded: Bool) -> Traceparent =
  {
    ..t,
    flags: if recorded { t.flags | sampled_flag() } else { t.flags & (0xFF ^ sampled_flag()) },
  }

/// Returns the header that a child span, `span`, sends in the same trace: the trace id of `t`,
/// `span` as the parent id, and the flags of `t`. Only the sampled and random flags are copied; any
/// other flag bit is cleared.
pub fn child(t: Traceparent, span: SpanId) -> Traceparent =
  { trace_id: t.trace_id, parent_id: span, flags: t.flags & (sampled_flag() | random_flag()) }

/// The header's text, always as version `00`: `00-<trace id>-<parent id>-<flags>`.
pub fn render(t: Traceparent) -> String =
  "00-" ++ trace_id_hex(t.trace_id) ++ "-" ++ span_id_hex(t.parent_id) ++ "-"
    ++ lower_hex(flag_byte(t.flags))

fn flag_byte(flags: Int) -> Bytes =
  match try[abort.raise] { byte_of_int(flags & 0xFF) } { Ok(b) -> b, Err(_) -> b"\x00" }

/// Why a `traceparent` was rejected.
pub type ErrorKind =
  /// Fewer than the 55 characters every version has.
  | Short
  /// The header's version is `ff`, which the W3C Trace Context specification forbids.
  | Version
  /// A character that is not a lower-case hex digit where one belongs.
  | NotHexDigit
  /// A character that is not `-` where one separates two fields.
  | MissingDash
  /// A trace id of all zeros.
  | ZeroTrace
  /// A parent id of all zeros.
  | ZeroParent
  /// Characters after the flags. Version `00` allows none. A later version allows them only when
  /// the first character after the flags is `-`.
  | Trailing

/// Why a `traceparent` was rejected, and the position of the character where it failed.
pub type Error = new { reason: ErrorKind, at: Int }

/// Parses a `traceparent` header's text, or returns why it is not one.
pub fn parse(text: String) -> Result<Traceparent, Error> =
  match try[abort.raise] { parse_bytes(Bytes::of_string(text)) } {
    Ok(result) -> result,
    Err(_) -> Err({ reason: Short, at: 0 }),
  }

fn parse_bytes(raw: Bytes) -> Result<Traceparent, Error> / {abort.raise} = {
  let n = raw.len();
  if n < 55 { Err({ reason: Short, at: n }) } else {
    match first_misplaced(raw) {
      Some(rejection) -> Err(rejection),
      None -> {
        let version = raw.slice(0, 2);
        if version == b"ff" { Err({ reason: Version, at: 0 }) }
        else if n > 55 && (version == b"00" || raw.at(55) != b'-') {
          Err({ reason: Trailing, at: 55 })
        } else { ids_of(raw) }
      },
    }
  }
}

fn first_misplaced(raw: Bytes) -> Option<Error> / {abort.raise} =
  range(0, 55).fold(None, |found: Option<Error>, i: Int| -> Option<Error> {
    match found { Some(_) -> found, None -> misplaced(raw.at(i), i) }
  })

fn misplaced(c: Int, i: Int) -> Option<Error> =
  if i == 2 || i == 35 || i == 52 {
    if c == b'-' { None } else { Some({ reason: MissingDash, at: i }) }
  } else if is_lower_hex(c) { None }
  else { Some({ reason: NotHexDigit, at: i }) }

fn is_lower_hex(c: Int) -> Bool = match c { b'0'..=b'9' | b'a'..=b'f' -> true, _ -> false }

fn ids_of(raw: Bytes) -> Result<Traceparent, Error> / {abort.raise} = {
  let hex_at = |from: Int, to: Int|
    match hex::decode(String::of_bytes(raw.slice(from, to))) { Some(b) -> b, None -> b"" };
  match trace_id(hex_at(3, 35)) {
    None -> Err({ reason: ZeroTrace, at: 3 }),
    Some(trace) -> match span_id(hex_at(36, 52)) {
      None -> Err({ reason: ZeroParent, at: 36 }),
      Some(parent) -> Ok({ trace_id: trace, parent_id: parent, flags: hex_at(53, 55).at(0) }),
    },
  }
}

/// Checks a `traceparent"..."` literal.
pub fn literal(text: String) -> Result<Traceparent, { message: String, offset: Int }> =
  match parse(text) {
    Ok(t) -> Ok(t),
    Err(r) -> Err({ message: reason(r.reason), offset: min(r.at, text.len()) }),
  }

/// The rule a rejected `traceparent` broke, in words.
pub fn reason(reason: ErrorKind) -> String =
  match reason {
    Short ->
      "a traceparent is 55 characters: `00-`, 32 hex digits, `-`, 16 hex digits, `-` and 2 hex digits",
    Version ->
      "the version, the first two hex digits, is `ff`, which is reserved and not supported",
    NotHexDigit -> "a lower-case hex digit goes here",
    MissingDash -> "a `-` goes here",
    ZeroTrace -> "a trace id is not all zeros",
    ZeroParent -> "a parent id is not all zeros",
    Trailing ->
      "there is extra text after the flags: version `00` allows none, and a later version allows only text that starts with `-`",
  }

/// One vendor's entry.
pub type Entry = new { key: String, value: String }

/// The `tracestate` header: entries in order, most recently written first, each key once.
pub opaque type Tracestate = | Tracestate(List<Entry>)

show for Tracestate by render_state

/// A generator of `Tracestate` values for tests.
pub fn tracestates() -> Gen<Tracestate> =
  gen::map(
    gen::list_of(
      gen::map2(
        gen::elements(["rojo", "congo", "a", "fw529a3039@dt", "0tenant@sys", "a_b-c*d/e"]),
        gen::elements(["00f067aa0ba902b7", "t61rcWkgMzE", "x", "a b", "!\"#$%&'()*+-./:;<>?@~"]),
        |key: String, value: String| -> Entry { { key: key, value: value } },
      ),
      6,
    ),
    |entries: List<Entry>|
      entries.fold(empty(), |state: Tracestate, e: Entry|
        match put(state, e.key, e.value) { Some(next) -> next, None -> state }),
  )

/// The most entries a `tracestate` can contain.
pub fn max_entries() -> Int = 32

/// The most characters `render_state` writes.
pub fn max_length() -> Int = 512

/// A `tracestate` with no entries, which is how a new trace starts.
pub fn empty() -> Tracestate = Tracestate([])

/// The entries, most recently written first.
pub fn entries(state: Tracestate) -> List<Entry> =
  match state { Tracestate(entry_list) -> entry_list }

/// The value under `key`.
pub fn get(state: Tracestate, key: String) -> Option<String> =
  entries(state).fold(None, |found: Option<String>, e: Entry|
    match found { Some(_) -> found, None -> if e.key == key { Some(e.value) } else { None } })

/// Returns `state` with `key` set to `value` and moved to the front, as a service writes its own
/// entry. When this exceeds `max_entries`, the last entry is dropped. Returns `None` when `key` or
/// `value` is not valid under `is_key` and `is_value`.
pub fn put(state: Tracestate, key: String, value: String) -> Option<Tracestate> =
  if !is_key(key) || !is_value(value) { None } else {
    let rest = entries(remove(state, key));
    let entry: Entry = { key: key, value: value };
    Some(
      Tracestate(
        rest.fold([entry], |accumulator: List<Entry>, e: Entry| accumulator.push(e)).take(
          max_entries(),
        ),
      ),
    )
  }

/// `state` without the entry under `key`.
pub fn remove(state: Tracestate, key: String) -> Tracestate =
  Tracestate(entries(state).filter(|e: Entry| e.key != key))

/// Whether `key` is valid in a `tracestate`: a lower-case letter followed by up to 255 lower-case
/// letters, digits and `_-*/`; or `tenant@system`, where the tenant may start with a digit and has
/// up to 241 characters, and the system up to 14.
pub fn is_key(key: String) -> Bool =
  match try[abort.raise] { is_key_bytes(Bytes::of_string(key)) } {
    Ok(result) -> result,
    Err(_) -> false,
  }

fn is_key_bytes(raw: Bytes) -> Bool / {abort.raise} =
  match raw.index_of_byte(b'@') {
    None -> key_part(raw, 256, false),
    Some(at) ->
      key_part(raw.slice(0, at), 241, true) && key_part(raw.slice(at + 1, raw.len()), 14, false),
  }

fn key_part(raw: Bytes, most: Int, digit_first: Bool) -> Bool / {abort.raise} = {
  let n = raw.len();
  n >= 1 && n <= most && is_key_start(raw.at(0), digit_first)
    && raw.skip(0, b"abcdefghijklmnopqrstuvwxyz0123456789_-*/") >= n
}

fn is_key_start(c: Int, digit_first: Bool) -> Bool =
  match c { b'a'..=b'z' -> true, b'0'..=b'9' -> digit_first, _ -> false }

/// Whether `value` is valid in a `tracestate`: up to 256 printable ASCII characters, none of them
/// `,` or `=`, and the last not a space.
pub fn is_value(value: String) -> Bool =
  match try[abort.raise] { is_value_bytes(Bytes::of_string(value)) } {
    Ok(result) -> result,
    Err(_) -> false,
  }

fn is_value_bytes(raw: Bytes) -> Bool / {abort.raise} = {
  let n = raw.len();
  n >= 1 && n <= 256 && raw.at(n - 1) != b' ' && range(0, n).all(|i: Int| is_value_char(raw.at(i)))
}

fn is_value_char(c: Int) -> Bool = c >= 0x20 && c <= 0x7E && c != b',' && c != b'='

/// Why a `tracestate` was rejected.
pub type StateErrorKind =
  /// An entry with no `=`.
  | NoValue
  /// A key outside the grammar.
  | BadKey
  /// A value outside the grammar.
  | BadValue
  /// A key written twice.
  | DuplicateKey
  /// More than `max_entries` entries.
  | TooMany

/// Why a `tracestate` was rejected, and the list member where it failed, counted from zero.
pub type StateError = new { reason: StateErrorKind, member: Int }

/// Parses a `tracestate` header's text, or returns why it is not one. Several header lines are one
/// text joined by commas. Spaces and tabs around a member, and empty members, are skipped.
pub fn parse_state(text: String) -> Result<Tracestate, StateError> =
  match try[abort.raise] { parse_members(Bytes::of_string(text).split(b",")) } {
    Ok(result) -> result,
    Err(_) -> Err({ reason: NoValue, member: 0 }),
  }

fn parse_members(members: List<Bytes>) -> Result<Tracestate, StateError> / {abort.raise} = {
  let start: Result<List<Entry>, StateError> = Ok([]);
  let read = range(0, members.len()).fold(
    start,
    |accumulator: Result<List<Entry>, StateError>, i: Int|
      match accumulator {
        Err(_) -> accumulator,
        Ok(entry_list) -> match members.at(i) {
          None -> accumulator,
          Some(member) ->
            add_member(
              entry_list,
              Bytes::of_string(String::of_bytes_lossy(member).ascii_trim()),
              i,
            ),
        },
      },
  );
  match read { Ok(entry_list) -> Ok(Tracestate(entry_list)), Err(e) -> Err(e) }
}

fn add_member(
  entry_list: List<Entry>,
  member: Bytes,
  i: Int,
) -> Result<List<Entry>, StateError> / {abort.raise} =
  if member.len() == 0 { Ok(entry_list) } else {
    match member.index_of_byte(b'=') {
      None -> Err({ reason: NoValue, member: i }),
      Some(at) -> {
        let key = String::of_bytes_lossy(member.slice(0, at));
        let value = String::of_bytes_lossy(member.slice(at + 1, member.len()));
        if !is_key(key) { Err({ reason: BadKey, member: i }) }
        else if !is_value(value) { Err({ reason: BadValue, member: i }) }
        else if entry_list.any(|e: Entry| e.key == key) { Err({ reason: DuplicateKey, member: i }) }
        else if entry_list.len() >= max_entries() { Err({ reason: TooMany, member: i }) }
        else { Ok(entry_list.push({ key: key, value: value })) }
      },
    }
  }

/// Renders a `Tracestate` as header text: `key=value` entries joined by commas. When the text is
/// longer than `max_length()` characters, entries are removed one at a time until it fits. Each
/// time, the last entry longer than 128 characters is removed; if no entry is that long, the last
/// entry is removed.
pub fn render_state(state: Tracestate) -> String =
  String::join(fit_entries(entries(state), entries(state).len()).map(entry_text), ",")

fn entry_text(e: Entry) -> String = e.key ++ "=" ++ e.value

fn length_of(entry_list: List<Entry>) -> Int =
  entry_list.fold(0, |n: Int, e: Entry| n + entry_text(e).len()) + max(entry_list.len() - 1, 0)

fn fit_entries(entry_list: List<Entry>, left: Int) -> List<Entry> =
  if left <= 0 || length_of(entry_list) <= max_length() { entry_list } else {
    let long = range(0, entry_list.len()).fold(None, |found: Option<Int>, i: Int|
      match entry_list.at(i) {
        Some(e) -> if entry_text(e).len() > 128 { Some(i) } else { found },
        None -> found,
      });
    let drop = match long { Some(i) -> i, None -> entry_list.len() - 1 };
    fit_entries(
      range(0, entry_list.len()).fold([], |accumulator: List<Entry>, i: Int|
        match entry_list.at(i) {
          Some(e) -> if i == drop { accumulator } else { accumulator.push(e) },
          None -> accumulator,
        }),
      left - 1,
    )
  }

/// The trace data a request carries: both headers.
pub type Context = new { parent: Traceparent, state: Tracestate }

/// The context a request's `traceparent` and `tracestate` field lines carry, or `None` when the
/// request starts a new trace: no `traceparent`, more than one, or one that does not parse. A
/// `tracestate` that does not parse is treated as empty, and the trace still continues.
pub fn incoming(traceparents: List<String>, tracestates: List<String>) -> Option<Context> =
  match traceparents {
    [only] -> match parse(only) {
      Ok(parent) ->
        Some({
          parent: parent,
          state: match parse_state(String::join(tracestates, ",")) {
            Ok(state) -> state,
            Err(_) -> empty(),
          },
        }),
      Err(_) -> None,
    },
    _ -> None,
  }

test "a traceparent reads back from its text" {
  gen::check(traceparents(), |t: Traceparent| { parse(render(t)) == Ok(t) })
}

test "`parse_state` returns the same tracestate that `render_state` wrote as text" {
  gen::check(tracestates(), |s: Tracestate| { parse_state(render_state(s)) == Ok(s) })
}

test "`parse` splits the example traceparent from the W3C Trace Context specification into its fields" {
  let read = parse("00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01");
  match read {
    Ok(t) -> {
      assert_eq(trace_id_hex(t.trace_id), "4bf92f3577b34da6a3ce929d0e0e4736");
      assert_eq(span_id_hex(t.parent_id), "00f067aa0ba902b7");
      assert(sampled(t));
      assert(!random(t));
      assert_eq(render(t), "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01")
    },
    Err(r) -> panic(reason(r.reason)),
  }
}

type ErrorCase = { name: String, text: String, reason: ErrorKind, at: Int }

fn parent_error_cases() -> List<ErrorCase> =
  [
    { name: "nothing", text: "", reason: Short, at: 0 },
    {
      name: "a flag digit short",
      text: "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-0",
      reason: Short,
      at: 54,
    },
    {
      name: "version ff",
      text: "ff-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01",
      reason: Version,
      at: 0,
    },
    {
      name: "an upper-case digit",
      text: "00-4BF92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01",
      reason: NotHexDigit,
      at: 4,
    },
    {
      name: "a version that is no hex",
      text: "0g-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01",
      reason: NotHexDigit,
      at: 1,
    },
    {
      name: "a field one digit long",
      text: "00-4bf92f3577b34da6a3ce929d0e0e47360-0f067aa0ba902b7-01",
      reason: MissingDash,
      at: 35,
    },
    {
      name: "a trace id of zeros",
      text: "00-00000000000000000000000000000000-00f067aa0ba902b7-01",
      reason: ZeroTrace,
      at: 3,
    },
    {
      name: "a parent id of zeros",
      text: "00-4bf92f3577b34da6a3ce929d0e0e4736-0000000000000000-01",
      reason: ZeroParent,
      at: 36,
    },
    {
      name: "version 00 with more after its flags",
      text: "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01-extra",
      reason: Trailing,
      at: 55,
    },
    {
      name: "a later version with more that no dash opens",
      text: "01-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01extra",
      reason: Trailing,
      at: 55,
    },
    {
      name: "flags that are no hex",
      text: "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-0x",
      reason: NotHexDigit,
      at: 54,
    },
  ]

test "`parse` rejects the invalid traceparent {c.name} with the error reason and position the case lists" for c: ErrorCase in parent_error_cases(
  ) { assert_eq(parse(c.text), Err({ reason: c.reason, at: c.at })) }

test "a later version is read by its first 55 characters and written back as version 00" {
  let exact = parse("cc-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-09");
  let longer = parse("cc-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-09-what-comes-next");
  assert_eq(exact, longer);
  match exact {
    Ok(t) -> {
      assert_eq(render(t), "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-09");
      assert_eq(t.flags, 9);
      match span_id_of_hex("b7ad6b7169203331") {
        Some(span) ->
          assert_eq(
            render(child(t, span)),
            "00-4bf92f3577b34da6a3ce929d0e0e4736-b7ad6b7169203331-01",
          ),
        None -> panic("a span id"),
      }
    },
    Err(r) -> panic(reason(r.reason)),
  }
}

test "the sampled flag is set and cleared without touching the others" {
  match parse("00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-02") {
    Ok(t) -> {
      assert(random(t));
      assert(!sampled(t));
      assert_eq(with_sampled(t, true).flags, 3);
      assert_eq(with_sampled(with_sampled(t, true), false), t)
    },
    Err(r) -> panic(reason(r.reason)),
  }
}

type KeyCase = { key: String, valid: Bool }

fn keys() -> List<KeyCase> =
  [
    { key: "rojo", valid: true },
    { key: "a", valid: true },
    { key: "a_b-c*d/e9", valid: true },
    { key: "fw529a3039@dt", valid: true },
    { key: "0tenant@sys", valid: true },
    { key: "", valid: false },
    { key: "9rojo", valid: false },
    { key: "Rojo", valid: false },
    { key: "ro jo", valid: false },
    { key: "tenant@", valid: false },
    { key: "@sys", valid: false },
    { key: "tenant@9sys", valid: false },
    { key: "tenant@system-id-of-15", valid: false },
    { key: "a@b@c", valid: false },
  ]

test "`is_key` returns whether the tracestate key `{c.key}` is valid under the tracestate key grammar" for c: KeyCase in keys(
  ) { assert_eq(is_key(c.key), c.valid) }

test "a key and a value are limited to their maximum lengths" {
  assert(is_key("a".repeat(256)));
  assert(!is_key("a".repeat(257)));
  assert(is_key("a".repeat(241) ++ "@" ++ "a".repeat(14)));
  assert(!is_key("a".repeat(242) ++ "@" ++ "a".repeat(14)));
  assert(is_value("a".repeat(256)));
  assert(!is_value("a".repeat(257)));
  assert(!is_value(""));
  assert(!is_value("ends in a space "));
  assert(is_value(" opens with one"));
  assert(!is_value("a,b"));
  assert(!is_value("a=b"));
  assert(!is_value("tab\there"))
}

test "a tracestate parses in order, skipping optional white space and empty members" {
  let read = parse_state("rojo=00f067aa0ba902b7 ,\tcongo=t61rcWkgMzE,, ");
  match read {
    Ok(state) -> {
      assert_eq(entries(state).map(|e: Entry| e.key), ["rojo", "congo"]);
      assert_eq(get(state, "congo"), Some("t61rcWkgMzE"));
      assert_eq(get(state, "absent"), None);
      assert_eq(render_state(state), "rojo=00f067aa0ba902b7,congo=t61rcWkgMzE")
    },
    Err(_) -> panic("refused"),
  }
}

type StateCase = { name: String, text: String, reason: StateErrorKind, member: Int }

fn state_error_cases() -> List<StateCase> =
  [
    { name: "a member with no value", text: "rojo=1,congo", reason: NoValue, member: 1 },
    { name: "a key in upper case", text: "Rojo=1", reason: BadKey, member: 0 },
    { name: "an empty value", text: "rojo=", reason: BadValue, member: 0 },
    { name: "a value holding an equals sign", text: "rojo=a=b", reason: BadValue, member: 0 },
    { name: "a key written twice", text: "rojo=1,congo=2,rojo=3", reason: DuplicateKey, member: 2 },
  ]

test "`parse_state` rejects the invalid tracestate {c.name} with the error reason and member the case lists" for c: StateCase in state_error_cases(
  ) { assert_eq(parse_state(c.text), Err({ reason: c.reason, member: c.member })) }

fn numbered_entries(n: Int) -> String =
  String::join(range(0, n).map(|i: Int| "k" ++ i.to_string() ++ "=v"), ",")

test "a tracestate has at most 32 entries" {
  assert_eq(
    match parse_state(numbered_entries(32)) { Ok(state) -> entries(state).len(), Err(_) -> -1 },
    32,
  );
  assert_eq(parse_state(numbered_entries(33)), Err({ reason: TooMany, member: 32 }));
  match parse_state(numbered_entries(32)) {
    Ok(full) -> match put(full, "mine", "1") {
      Some(next) -> {
        assert_eq(entries(next).len(), 32);
        assert_eq(get(next, "k31"), None);
        assert_eq(get(next, "mine"), Some("1"))
      },
      None -> panic("put"),
    },
    Err(_) -> panic("refused"),
  }
}

test "`put` on an existing key moves its entry to the front and leaves the other entries in order" {
  match parse_state("rojo=1,congo=2,ply=3") {
    Ok(state) -> match put(state, "congo", "9") {
      Some(next) -> assert_eq(render_state(next), "congo=9,rojo=1,ply=3"),
      None -> panic("put"),
    },
    Err(_) -> panic("refused"),
  }
}

fn long_entry(key: String, n: Int) -> String = key ++ "=" ++ "a".repeat(n)

test "a tracestate past 512 characters loses its long entries first, then its last ones" {
  let text = String::join(
    [
      long_entry("a", 120),
      long_entry("long", 200),
      long_entry("b", 120),
      long_entry("c", 120),
      long_entry("d", 120),
    ],
    ",",
  );
  match parse_state(text) {
    Ok(state) -> {
      assert_eq(entries(state).len(), 5);
      let out = render_state(state);
      assert(out.len() <= 512);
      assert_eq(
        out,
        String::join(
          [long_entry("a", 120), long_entry("b", 120), long_entry("c", 120), long_entry("d", 120)],
          ",",
        ),
      )
    },
    Err(_) -> panic("refused"),
  };
  let even = String::join(range(0, 6).map(|i: Int| long_entry("k" ++ i.to_string(), 100)), ",");
  match parse_state(even) {
    Ok(state) ->
      assert_eq(
        render_state(state),
        String::join(range(0, 4).map(|i: Int| long_entry("k" ++ i.to_string(), 100)), ","),
      ),
    Err(_) -> panic("refused"),
  }
}

test "a request continues the trace its headers name, or starts one" {
  let parent = "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01";
  match incoming([parent], ["rojo=1", "congo=2"]) {
    Some(context) -> {
      assert_eq(render(context.parent), parent);
      assert_eq(render_state(context.state), "rojo=1,congo=2")
    },
    None -> panic("a context"),
  };
  assert_eq(
    match incoming([parent], ["Rojo=1"]) {
      Some(context) -> entries(context.state).len(),
      None -> -1,
    },
    0,
  );
  assert_eq(incoming([], ["rojo=1"]), None);
  assert_eq(incoming([parent, parent], []), None);
  assert_eq(incoming(["00-00000000000000000000000000000000-00f067aa0ba902b7-01"], []), None)
}

test "a trace id is drawn from entropy, and a random stream with the same seed draws the same trace id" {
  let first = try[abort.raise] { rand_trace_id(rand(7)) };
  match first {
    Ok(drawn) -> {
      assert_eq(trace_id_bytes(drawn.value).len(), 16);
      assert_eq(try[abort.raise] { with_rand(rand(7), new_trace_id).value }, Ok(drawn.value));
      let span = try[abort.raise] { rand_span_id(drawn.rand).value };
      assert_eq(match span { Ok(id) -> span_id_bytes(id).len(), Err(_) -> -1 }, 8)
    },
    Err(m) -> panic(m),
  };
  let zeros = try[abort.raise] { handle { new_span_id() } with { entropy.next() -> 0 } };
  assert_eq(match zeros { Ok(id) -> span_id_hex(id), Err(_) -> "" }, "0000000000000001")
}
