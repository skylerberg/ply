//! Work on a list split across `parallel` blocks.
//!
//! A list is cut in halves, each pair under a `parallel` block, until a piece holds `grain_size()` items;
//! the pieces are the same on every run however many threads there are, so each function answers what
//! its sequential counterpart answers. The functions it is handed are pure.

import std.list

/// The items a piece holds before it is cut in two.
pub fn grain_size() -> Int = 512

/// `xs.map(f)`, its pieces mapped at once.
pub fn par_map<a, b>(xs: List<a>, f: (a) -> b) -> List<b> =
  map_range(xs, f, 0, xs.len(), max_splits())

/// How many times a piece may be cut: 64 halvings take any length to one.
fn max_splits() -> Int = 64

fn map_range<a, b>(xs: List<a>, f: (a) -> b, lo: Int, hi: Int, splits_left: Int) -> List<b> =
  if hi - lo <= grain_size() || splits_left <= 0 {
    range(lo, hi).fold([], |out: List<b>, i: Int|
      match xs.at(i) { Some(x) -> out.push(f(x)), None -> out })
  } else {
    let mid = lo + (hi - lo) / 2;
    let halves = parallel {
      map_range(xs, f, lo, mid, splits_left - 1),
      map_range(xs, f, mid, hi, splits_left - 1),
    };
    halves._0.concat(halves._1)
  }

/// Each piece folded from `zero` by `step`, and the pieces' answers merged left to right. This is
/// `xs.fold(zero, step)` when `merge` is associative, `zero` is its identity and `step(b, x)` is
/// `merge(b, step(zero, x))`, as a sum's or a count's are; the pieces are the same on every run.
pub fn par_fold<a, b>(xs: List<a>, zero: b, step: (b, a) -> b, merge: (b, b) -> b) -> b =
  fold_range(xs, zero, step, merge, 0, xs.len(), max_splits())

fn fold_range<a, b>(
  xs: List<a>,
  zero: b,
  step: (b, a) -> b,
  merge: (b, b) -> b,
  lo: Int,
  hi: Int,
  splits_left: Int,
) -> b =
  if hi - lo <= grain_size() || splits_left <= 0 {
    range(lo, hi).fold(zero, |acc: b, i: Int|
      match xs.at(i) { Some(x) -> step(acc, x), None -> acc })
  } else {
    let mid = lo + (hi - lo) / 2;
    let halves = parallel {
      fold_range(xs, zero, step, merge, lo, mid, splits_left - 1),
      fold_range(xs, zero, step, merge, mid, hi, splits_left - 1),
    };
    merge(halves._0, halves._1)
  }

test "par_map answers what map answers, in order, at every size around a piece" {
  let sizes = [0, 1, grain_size() - 1, grain_size(), grain_size() + 1, 10 * grain_size() + 7];
  sizes.fold((), |_u: Unit, n: Int| {
    let xs = range(0, n);
    assert_eq(par_map(xs, |x: Int| x * 3 - 1), xs.map(|x: Int| x * 3 - 1))
  });
  let words = par_map(range(0, 3 * grain_size()), |i: Int| "w" ++ i.to_string());
  assert_eq(words.at(2 * grain_size()), Some("w" ++ Int::to_string(2 * grain_size())))
}

test "par_fold answers what fold answers for a merge that is associative with its identity" {
  let xs = range(0, 20 * grain_size() + 3);
  assert_eq(
    par_fold(xs, 0, |acc: Int, x: Int| acc + x, |a: Int, b: Int| a + b),
    xs.fold(0, |acc: Int, x: Int| acc + x),
  );
  // A list is a monoid under concatenation, so the pieces come back in order.
  let evens = par_fold(
    xs,
    [],
    |acc: List<Int>, x: Int| if x % 2 == 0 { acc.push(x) } else { acc },
    List::concat,
  );
  assert_eq(evens, xs.filter(|x: Int| x % 2 == 0))
}

test "a block's answer holds each `Float` as a record of its type holds one" {
  let halves = parallel { 1.5, 2.0 * 1.25 };
  assert_eq(halves._0 + halves._1, 4.0)
}
