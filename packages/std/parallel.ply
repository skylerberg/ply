//! Processes a list in pieces across `parallel` blocks.
//!
//! A list is split in half repeatedly, with each pair of halves run in a `parallel` block, until a
//! piece has at most `grain_size` items. The pieces are the same on every run, whatever the
//! number of threads, so each function returns what its sequential counterpart returns. The
//! functions passed in are pure.

import std.list

/// The most items a piece can have without being split in two.
pub const grain_size: Int = 512

/// `xs.map(f)`, with the pieces mapped in parallel.
pub fn par_map<a, b>(xs: List<a>, f: (a) -> b) -> List<b> =
  map_range(xs, f, 0, xs.len(), max_splits)

const max_splits: Int = 64

fn map_range<a, b>(xs: List<a>, f: (a) -> b, lo: Int, hi: Int, splits_left: Int) -> List<b> =
  if hi - lo <= grain_size || splits_left <= 0 {
    range(lo, hi).fold([], |out: List<b>, i: Int|
      match xs.at(i) { Some(x) -> out.push(f(x)), None -> out })
  } else {
    let mid = lo + (hi - lo) / 2;
    let halves = parallel {
      map_range(xs, f, lo, mid, splits_left - 1),
      map_range(xs, f, mid, hi, splits_left - 1),
    };
    halves._0.concat(halves._1)
  }

/// Folds each piece from `zero` with `step`, then merges the pieces' results from left to right.
/// The result equals `xs.fold(zero, step)` when `merge` is associative, `zero` is its identity,
/// and `step(b, x)` equals `merge(b, step(zero, x))`, as for a sum or a count. The pieces are the
/// same on every run.
pub fn par_fold<a, b>(xs: List<a>, zero: b, step: (b, a) -> b, merge: (b, b) -> b) -> b =
  fold_range(xs, zero, step, merge, 0, xs.len(), max_splits)

fn fold_range<a, b>(
  xs: List<a>,
  zero: b,
  step: (b, a) -> b,
  merge: (b, b) -> b,
  lo: Int,
  hi: Int,
  splits_left: Int,
) -> b =
  if hi - lo <= grain_size || splits_left <= 0 {
    range(lo, hi).fold(zero, |accumulator: b, i: Int|
      match xs.at(i) { Some(x) -> step(accumulator, x), None -> accumulator })
  } else {
    let mid = lo + (hi - lo) / 2;
    let halves = parallel {
      fold_range(xs, zero, step, merge, lo, mid, splits_left - 1),
      fold_range(xs, zero, step, merge, mid, hi, splits_left - 1),
    };
    merge(halves._0, halves._1)
  }

test "`par_map` returns what `map` returns, in order, for sizes 0, 1, just below, at and just above `grain_size()`, and much larger" {
  let sizes = [0, 1, grain_size - 1, grain_size, grain_size + 1, 10 * grain_size + 7];
  sizes.fold((), |_u: Unit, n: Int| {
    let xs = range(0, n);
    assert_eq(par_map(xs, |x: Int| x * 3 - 1), xs.map(|x: Int| x * 3 - 1))
  });
  let words = par_map(range(0, 3 * grain_size), |i: Int| "w" ++ i.to_string());
  assert_eq(words.at(2 * grain_size), Some("w" ++ Int::to_string(2 * grain_size)))
}

test "par_fold returns what fold returns for an associative merge with an identity" {
  let xs = range(0, 20 * grain_size + 3);
  assert_eq(
    par_fold(xs, 0, |accumulator: Int, x: Int| accumulator + x, |a: Int, b: Int| a + b),
    xs.fold(0, |accumulator: Int, x: Int| accumulator + x),
  );
  let evens = par_fold(
    xs,
    [],
    |accumulator: List<Int>, x: Int| if x % 2 == 0 { accumulator.push(x) } else { accumulator },
    List::concat,
  );
  assert_eq(evens, xs.filter(|x: Int| x % 2 == 0))
}

test "a `parallel` block returns its `Float` results in tuple fields that can be read and added correctly" {
  let halves = parallel { 1.5, 2.0 * 1.25 };
  assert_eq(halves._0 + halves._1, 4.0)
}
