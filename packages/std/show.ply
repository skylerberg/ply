//! Converts any value to text written in Ply's own syntax.
//!
//! The text includes every nested value, such as record fields and list elements, at every depth,
//! as `std.value.render_all` writes it. A value whose type defines its own `show` is written by
//! that function. This is the text `derive show` produces, and the text an interpolated string
//! inserts for each placeholder.

import std.value (Value, VRecord, VList, VCtor, VInt, VStr, VChar, render, render_all, shown)
import std.string

/// `x` written in Ply's syntax.
pub fn show<a>(x: a) -> String
  where derivable(show, a)
= render_all(shown(x))

/// Writes a string or a character as itself, and any other value as `show` does. An interpolated
/// string calls this for each placeholder.
pub fn display<a>(x: a) -> String
  where derivable(show, a)
= match shown(x) { VStr(s) -> s, VChar(c) -> String::of_chars([c]), v -> render_all(v) }

test "show writes any value as render does, every item at every depth" {
  assert_eq(show({ a: 1, b: [Some(2)] }), "{a: 1, b: [Some(2)]}");
  assert_eq(
    show({ a: 1, b: [Some(2)] }),
    render(
      VRecord([
        { name: "a", value: VInt(1) },
        { name: "b", value: VList([VCtor("Some", [VInt(2)])]) },
      ]),
    ),
  );
  assert_eq(show("a\"b"), "\"a\\\"b\"");
  assert_eq(show('x'), "'x'");
  assert_eq(
    show(range(0, 40)),
    "[" ++ String::join(range(0, 40).map(|i: Int| i.to_string()), ", ") ++ "]",
  );
  assert_eq(show(Array::of_list([1, 2])), "Array::of_list([1, 2])");
  assert_eq(show(VInt(3)), "VInt(3)")
}

test "display writes a string or a character as itself and anything else as show does" {
  assert_eq(display("a\"b"), "a\"b");
  assert_eq(display('x'), "x");
  assert_eq(display(Some("x")), "Some(\"x\")");
  assert_eq(display(1.5), "1.5");
  assert_eq(display(()), "()")
}
