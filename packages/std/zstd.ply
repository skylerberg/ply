//! Zstandard (RFC 8878): reading and writing frames.
//!
//! `decompress` reads the output of any writer of the format. It decodes raw blocks, blocks of one
//! repeated byte, and blocks of literals and sequences in every mode the format defines for each.
//! It decodes several frames as one stream and skips skippable frames among them. It checks a
//! frame's length when the frame declares one, and its checksum when the frame ends with one.
//! `decompress_with` decodes frames written with a dictionary. `first` decodes one frame and
//! reports where it ended.
//!
//! Every decoder takes `Limits`; there is no decoder without them. `output` is the most bytes a
//! decoder returns, and a frame that declares more is rejected at its header. `window` is the most
//! bytes of history a frame may require the decoder to remember. A frame of a few bytes can request
//! gigabytes, so a frame that requests more than `window` is rejected at its header, before any
//! block is decoded. An error reports why it failed and at which byte of the input. `decompress`
//! raises it as `zstd.fail`, and `try_decompress` returns it. Bytes after the last frame that do
//! not start another frame are rejected.
//!
//! `compress` writes one frame. `Fast` is the compression level that searches for repeated bytes
//! cheaply: at each position it checks only one earlier position for a match. It codes literals
//! with a Huffman code. For each block it builds tables for the sequence codes. `Stored` writes the
//! bytes as they are. The output of either depends only on the input bytes.
//!
//! `decoded` and `encoded` do the same over a `std.seq` sequence of chunks, such as the chunks that
//! `chunks` in `std.io` returns for a file. A stream of any length is decoded or encoded in the
//! memory of its window and one block. `decoded` returns the same bytes as `decompress` however the
//! input is split.

import std.bytes (u32_le)
import std.checksum
import std.checksum (Xxh64)
import std.laws (inverse)
import std.list
import std.lz (code_lengths, codes_below, flush_bits, find_matches, code_bases, tally)
import std.math (bit_length)
import std.seq
import std.seq (seq, Seq, Done, Skip, Yield)
import std.gen

/// Why a reader failed.
pub type ErrorKind =
  /// The bytes do not start with a frame's magic number.
  | NotThisFormat
  /// The stream contains, or a frame declares, more bytes than `Limits.output`.
  | OverLimit
  /// A frame requires its reader to keep more bytes of history than `Limits.window`.
  | Window
  /// The input ends before the stream does.
  | Truncated
  /// A frame header with a reserved bit set.
  | Header
  /// A block of the type the format reserves.
  | BlockType
  /// A block longer than the frame allows, compressed or decompressed.
  | BlockSize
  /// A literals section whose sizes disagree, whose streams do not end at their stated sizes, or
  /// that reuses a code no earlier block set.
  | Literals
  /// Weights that do not form a prefix code of at most eleven bits.
  | Weights
  /// A table of sequence codes that is not a valid distribution, names a code the format does not
  /// define, or repeats a table no earlier block set.
  | Table
  /// A sequences section with a reserved bit set, or whose bits do not end where its sequences do.
  | Sequences
  /// A match whose offset points before the start of the bytes it may copy from, or an offset of
  /// zero.
  | Offset
  /// A frame that names a dictionary other than the one given, or bytes that are not a dictionary.
  | Dictionary
  /// A frame whose checksum does not match its content.
  | Checksum
  /// A frame that contains a different number of bytes than its header declares.
  | Length
  /// Bytes after a frame that do not begin another frame.
  | Trailing

/// Why a reader failed, and the offset of the input byte it was at.
pub type Error = new { at: Int, reason: ErrorKind }

/// The error this module's readers raise.
pub effect zstd {
  /// The input is not whole frames, or requires more than the limits allow.
  raise fail(e: Error)
}

fn fail<a>(at: Int, reason: ErrorKind) -> a / {zstd.fail} = zstd.fail({ at: at, reason: reason })

/// What a reader may use: the most bytes it returns, and the most bytes of history a frame may
/// require it to keep.
pub type Limits = new { output: Int, window: Int }

const fn single_bytes() -> Array<Bytes> = Array::of_list(range(0, 256).map(byte_of_int))

fn padded(input: Bytes, from: Int, to: Int) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00",
    input.slice(from, to),
    b"\x00\x00\x00\x00\x00\x00\x00\x00",
  ])

type NormalizedCounts = { counts: List<Int>, table_log: Int, next: Int }

type CountState = { counts: List<Int>, bit: Int, left: Int }

fn read_counts(
  padded_block: Bytes,
  bit: Int,
  stop: Int,
  left: Int,
  counts: List<Int>,
  fuel: Int,
) -> CountState / {abort.raise} =
  if left <= 0 || fuel <= 0 || bit > stop { { counts: counts, bit: bit, left: left } } else {
    let width = bit_length(left + 1);
    let raw = padded_block.bits_at(bit, width);
    let low = (1 << width - 1) - 1;
    let threshold = (1 << width) - 2 - left;
    let short = raw & low < threshold;
    let value = if short { raw & low } else if raw > low { raw - threshold } else { raw };
    let used = if short { width - 1 } else { width };
    let after = left - (if value == 0 { 1 } else { value - 1 });
    if value == 1 { zero_run(padded_block, bit + used, stop, after, counts.push(0), fuel - 1) }
    else { read_counts(padded_block, bit + used, stop, after, counts.push(value - 1), fuel - 1) }
  }

fn zero_run(
  padded_block: Bytes,
  bit: Int,
  stop: Int,
  left: Int,
  counts: List<Int>,
  fuel: Int,
) -> CountState / {abort.raise} =
  if fuel <= 0 || bit > stop { { counts: counts, bit: bit, left: left } } else {
    let more = padded_block.bits_at(bit, 2);
    let filled = range(0, more).fold(counts, |c: List<Int>, _: Int| c.push(0));
    if more == 3 { zero_run(padded_block, bit + 2, stop, left, filled, fuel - 1) }
    else { read_counts(padded_block, bit + 2, stop, left, filled, fuel - 1) }
  }

fn read_normalized_counts(
  padded_block: Bytes,
  at: Int,
  end: Int,
  max_table_log: Int,
  most: Int,
  where: Int,
) -> NormalizedCounts / {zstd.fail, abort.raise} =
  if at >= end { fail(where, Table) } else {
    let log = 5 + (padded_block.at(at) & 15);
    if log > max_table_log { fail(where, Table) } else {
      let read = read_counts(padded_block, at * 8 + 4, end * 8, 1 << log, [], 2 * most + 8);
      if read.left != 0 || read.bit > end * 8 || read.counts.len() > most + 1 { fail(where, Table) }
      else { { counts: read.counts, table_log: log, next: read.bit + 7 >>> 3 } }
    }
  }

type LowSymbolCells = { cells: Array<Int>, high: Int }

fn place_low_symbols(
  c: Array<Int>,
  s: Int,
  high: Int,
  cells: Array<Int>,
) -> LowSymbolCells / {abort.raise} =
  if s >= c.len() { { cells: cells, high: high } }
  else if c.get(s) == -1 { place_low_symbols(c, s + 1, high - 1, cells.set(high - 1, s)) }
  else { place_low_symbols(c, s + 1, high, cells) }

fn next_cell(position: Int, size: Int, high: Int, fuel: Int) -> Int = {
  let next = position + (size >>> 1) + (size >>> 3) + 3 & size - 1;
  if next >= high && fuel > 0 { next_cell(next, size, high, fuel - 1) } else { next }
}

fn spread_symbols(
  c: Array<Int>,
  s: Int,
  left: Int,
  position: Int,
  high: Int,
  cells: Array<Int>,
  fuel: Int,
) -> Array<Int> / {abort.raise} =
  if fuel <= 0 || s >= c.len() { cells } else if left <= 0 {
    let more = if s + 1 < c.len() { max(c.get(s + 1), 0) } else { 0 };
    spread_symbols(c, s + 1, more, position, high, cells, fuel - 1)
  } else {
    let size = cells.len();
    spread_symbols(
      c,
      s,
      left - 1,
      next_cell(position, size, high, size),
      high,
      cells.set(position, s),
      fuel - 1,
    )
  }

fn decoding_states(
  cells: Array<Int>,
  i: Int,
  next: Array<Int>,
  log: Int,
  code_baselines: Array<Int>,
) -> Array<Int> / {abort.raise} =
  if i >= cells.len() { cells } else {
    let s = cells.get(i);
    let n = next.get(s);
    let width = log + 1 - bit_length(n);
    decoding_states(
      cells.set(i, code_baselines.get(s) << 14 | width << 10 | (n << width) - (1 << log)),
      i + 1,
      next.set(s, n + 1),
      log,
      code_baselines,
    )
  }

fn fse(counts: List<Int>, log: Int, code_baselines: Array<Int>) -> Array<Int> / {abort.raise} = {
  let c = Array::of_list(counts);
  let size = 1 << log;
  let low = place_low_symbols(c, 0, size, Array::new(size, 0));
  let high = low.high;
  let first = if c.len() > 0 { max(c.get(0), 0) } else { 0 };
  let cells = spread_symbols(c, 0, first, 0, high, low.cells, size + c.len() + 2);
  decoding_states(
    cells,
    0,
    Array::of_list(counts.map(|p: Int| if p == -1 { 1 } else { p })),
    log,
    code_baselines,
  )
}

