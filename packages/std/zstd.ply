const fn offset_codes() -> Array<Int> =
  Array::of_list(range(0, 32).map(|code: Int| 1 << code << 5 | code))

const fn plain_codes() -> Array<Int> = Array::of_list(range(0, 256))

fn table_start(kind: Int) -> Int = if kind == 0 { 0 } else if kind == 1 { 1024 } else { 512 }

fn code_baselines(kind: Int) -> Array<Int> =
  if kind == 0 { length_codes() } else if kind == 1 { offset_codes() } else { match_codes() }

fn max_symbol(kind: Int) -> Int = if kind == 0 { 35 } else if kind == 1 { 31 } else { 52 }

fn max_table_log(kind: Int) -> Int = if kind == 1 { 8 } else { 9 }

fn default_log(kind: Int) -> Int = if kind == 1 { 5 } else { 6 }

fn copy_table(all: Array<Int>, base: Int, table: Array<Int>, i: Int) -> Array<Int> / {abort.raise} =
  if i >= table.len() { all }
  else { copy_table(all.set(base + i, table.get(i)), base, table, i + 1) }

fn copy_cells(
  all: Array<Int>,
  from: Array<Int>,
  base: Int,
  n: Int,
  i: Int,
) -> Array<Int> / {abort.raise} =
  if i >= n { all } else { copy_cells(all.set(base + i, from.get(base + i)), from, base, n, i + 1) }

const fn predefined() -> Array<Int> = {
  let lengths = fse(
    [
      4,
      3,
      2,
      2,
      2,
      2,
      2,
      2,
      2,
      2,
      2,
      2,
      2,
