//! URLs as RFC 3986 defines them: parsing, resolving, normalizing, percent-encoding and query
//! strings.
//!
//! A `Url` is an absolute URI: a scheme, then an optional authority (userinfo, host, port), a path,
//! an optional query and an optional fragment. A `Reference` is the form a document writes in place
//! of a URL: it may omit the scheme and more, which come from a base. `url_resolve` turns a
//! reference into a `Url` against a base (§5.2), so a relative reference can never be passed where
//! a `Url` is required. Only this module builds either type, by parsing text.
//!
//! The grammar is exactly RFC 3986's, not that of the WHATWG URL Standard that browsers follow.
//! This parser repairs nothing and trims nothing, so a text parses one way or not at all. It
//! rejects a backslash, a tab, a newline, a space, a character outside ASCII anywhere but in a
//! host's name, a `%` that is not an escape, and a second `@`. The two standards disagree on some
//! texts. If a validator and a fetcher parse the same text differently, they can pick different
//! hosts, which is how server-side request forgery and open redirects happen. A parse error reports
//! where and why: `url_parse` returns it as an `Err` and `url_read` raises it.
//!
//! A host is typed: a `Name`, an IPv4 address or an IPv6 address. The addresses are `std.ip`'s,
//! parsed by its strict parsers. RFC 3986 treats any host that is not four decimal octets as a
//! registered name, while other parsers read `127.1`, `0x7f.0.0.1` and `2130706433` as addresses.
//! So a host whose last label is a number is either an address or rejected (`NumericHost`), never a
//! name. A zone in brackets and an address of a future version are rejected. `[::ffff:127.0.0.1]`
//! is the IPv6 address it spells; `std.ip`'s classifiers treat it as the IPv4 address it maps to.
//!
//! An internationalized name is accepted in any of three forms: as A-labels (`xn--...`), in its own
//! script, or as the escaped UTF-8 that RFC 3986 §3.2.2 requires. `std.idna` converts the last two,
//! applying the checks the URL Standard applies to a host. So `url_host` returns the A-labels,
//! which are what to query a resolver with, whichever form was parsed. Parsing fails with `Idna` if
//! the conversion rejects the name, and with `NumericHost` if the conversion turns the name into an
//! IP address, or if the converted name contains a character that is a delimiter in a URL.
//! `url_display_host` returns the name in Unicode. A name written in ASCII is only converted to
//! lower case, as browsers read it and as DNS stores it: a label that starts with `xn--` is not
//! checked to be valid Punycode. A host may use an escape only where one is needed. An escape that
//! hides an ASCII character, such as the digits or dots of `%31%32%37.0.0.1`, is rejected
//! (`EncodedHost`).
//!
//! A `Url` stores its text: `url_render` of a parsed `Url` returns the parsed text character for
//! character, and two URLs are equal, and sort, as their texts do. So a program that checks a URL
//! and passes it on passes on exactly what it checked. The accessors return the normalized parts
//! that comparing texts would miss: `url_scheme` is in lower case, `url_host` is typed with its
//! name in lower case and in ASCII, and `url_port` is a number.
//!
//! `url_normalized` returns the equivalent URL that RFC 3986 §6.2.2 and §6.2.3 describe: scheme and
//! host in lower case, a name as its A-labels, escapes in upper case, escaped unreserved characters
//! written plain, dot segments removed, an empty path beside an authority replaced by `/`, and an
//! empty port or the scheme's default port (`http`, `https`, `ws`, `wss`, `ftp`) dropped. A
//! normalized URL is ASCII, which is what a protocol carries; a text parsed with a name in its own
//! script is not ASCII until it is normalized. Nothing is normalized unless requested, because what
//! counts as equivalent depends on the scheme. To check whether two URLs are equivalent, compare
//! `url_normalized` of each.
//!
//! `show`, and so an interpolated string, writes `url_redacted`: the text with a password in the
//! userinfo hidden, as §3.2.1 requires. `url_render` writes the password.
//!
//! The path is stored as written, and `url_path_segments` decodes it segment by segment, so an
//! escaped `/` is never a separator. A query is text. `url_query_pairs` parses it as `query_parse`
//! does, and `url_set_param` and the functions beside it write it back as `query_build` does.
//!
//! Percent-encoding: `url_encode` and `url_decode` implement RFC 3986 §2.1. Every byte that is not
//! unreserved (`A-Za-z0-9-._~`) becomes `%XX` with upper-case hex. `form_encode` and `form_decode`
//! implement `application/x-www-form-urlencoded`, which writes a space as `+`. A query string and a
//! form body use that encoding, which is why `query_parse` and `query_build` use it. A decoder
//! returns `None` for a `%` not followed by two hex digits, or for bytes that are not UTF-8.
//!
//! With `import std.url`, `url"https://example.com/a?b#c"` is a URL checked at compile time.

import std.bytes
import std.gen
import std.gen (Gen)
import std.idna
import std.ip
import std.ip (Ipv4, Ipv6)
import std.laws (round_trip)
import std.list
import std.option
import std.result
import std.show (show)
import std.string

/// One `name=value` part of a query string, decoded.
pub type Pair = { name: String, value: String }

/// What a URL's authority names.
pub type Host =
  /// A registered name in lower case and in ASCII, never empty. It is usually a DNS name, with an
  /// internationalized name as its A-labels, though any text of RFC 3986's unreserved characters
  /// and sub-delimiters is allowed.
  | Name(String)
  /// An IPv4 address, written as four decimal octets.
  | V4(Ipv4)
  /// An IPv6 address, written in brackets.
  | V6(Ipv6)

type Scheme = { written: String, name: String }

type Authority = {
  userinfo: Option<String>,
  redacted_userinfo: Option<String>,
  host: String,
  named: Option<Host>,
  port: Option<String>,
  number: Option<Int>,
}

type Parts = {
  scheme: Option<Scheme>,
  authority: Option<Authority>,
  path: String,
  query: Option<String>,
  fragment: Option<String>,
}

/// An absolute URL: RFC 3986's URI, which has a scheme. It stores its text exactly as it was
/// parsed.
pub opaque type Url = | Url(String, Parts)

/// A URI reference: a URL, or a relative reference that leaves its scheme, and perhaps its
/// authority and part of its path, to the base it is resolved against.
pub opaque type Reference = | Reference(String, Parts)

key for Url by url_render

show for Url by url_redacted

key for Reference by reference_render

show for Reference by reference_redacted

/// RFC 3986 percent-encoding: every byte outside the unreserved set as `%XX`.
pub fn url_encode(text: String) -> String / {abort.raise} =
  percent_encode(Bytes::of_string(text), false)

/// Returns the text that `url_encode` would turn into `text`, or `None` if `text` has a `%` not
/// followed by two hex digits or decodes to bytes that are not UTF-8.
pub fn url_decode(text: String) -> Option<String> / {abort.raise} =
  percent_decode(Bytes::of_string(text), false)

/// `application/x-www-form-urlencoded`: `url_encode` with a space as `+`.
pub fn form_encode(text: String) -> String / {abort.raise} =
  percent_encode(Bytes::of_string(text), true)

/// Returns the text that `form_encode` would turn into `text`, reading `+` as a space. Returns
/// `None` in the same cases as `url_decode`.
pub fn form_decode(text: String) -> Option<String> / {abort.raise} =
  percent_decode(Bytes::of_string(text), true)

/// A query string as `name`/`value` pairs, in the order they appear. `None` if any pair is not
/// valid form encoding. An empty part (`a=1&&b=2`) is skipped; a part with no `=` is a name with
/// an empty value.
pub fn query_parse(query: String) -> Option<List<Pair>> / {abort.raise} =
  Option::traverse(query.split("&").filter(|part: String| part.len() > 0), query_pair)

/// The query string for a list of pairs, in the order given, with each side form-encoded.
pub fn query_build(pairs: List<Pair>) -> String / {abort.raise} =
  String::join(pairs.map(|p: Pair| form_encode(p.name) ++ "=" ++ form_encode(p.value)), "&")

/// The value of the first pair named `name`, or `None` where there is none.
pub fn query_get(pairs: List<Pair>, name: String) -> Option<String> =
  match pairs.find(|p: Pair| p.name == name) { Some(p) -> Some(p.value), None -> None }

/// The pairs with `name` set to `value`. The first pair with that name takes the value in its
/// place, and any later ones are dropped. A name not among the pairs is added last.
pub fn query_set(pairs: List<Pair>, name: String, value: String) -> List<Pair> = {
  let set = pairs.fold(
    { seen: false, unique: [] },
    |s: { seen: Bool, unique: List<Pair> }, p: Pair|
      if p.name != name { { seen: s.seen, unique: s.unique.push(p) } }
      else if s.seen { s }
      else { { seen: true, unique: s.unique.push({ name: name, value: value }) } },
  );
  if set.seen { set.unique } else { set.unique.push({ name: name, value: value }) }
}

/// Returns the pairs whose name is not `name`, in their original order.
pub fn query_remove(pairs: List<Pair>, name: String) -> List<Pair> =
  pairs.filter(|p: Pair| p.name != name)

fn query_pair(part: String) -> Option<Pair> / {abort.raise} =
  if part.contains("=") {
    let at = part.find("=");
    match form_decode(part.slice(0, at)) {
      None -> None,
      Some(name) -> match form_decode(part.slice(at + 1, part.len())) {
        None -> None,
        Some(value) -> Some({ name: name, value: value }),
      },
    }
  } else { match form_decode(part) { None -> None, Some(name) -> Some({ name: name, value: "" }) } }

fn percent_encode(data: Bytes, form: Bool) -> String / {abort.raise} =
  range(0, data.len()).fold("", |accumulator: String, i: Int| {
    let c = data.at(i);
    if unreserved(c) { accumulator ++ String::of_bytes(byte_of_int(c)) }
    else if form && c == 32 { accumulator ++ "+" }
    else { accumulator ++ "%" ++ hex_digit(c / 16) ++ hex_digit(c % 16) }
  })

fn percent_decode(data: Bytes, form: Bool) -> Option<String> / {abort.raise} =
  match percent_bytes(data, 0, b"", form) {
    None -> None,
    Some(out) -> if out.is_utf8() { Some(String::of_bytes(out)) } else { None },
  }

fn percent_bytes(
  data: Bytes,
  at: Int,
  accumulator: Bytes,
  form: Bool,
) -> Option<Bytes> / {abort.raise} =
  if at >= data.len() { Some(accumulator) } else {
    let c = data.at(at);
    if c == 37 {
      if at + 2 >= data.len() { None } else {
        let high = hex_value(data.at(at + 1));
        let low = hex_value(data.at(at + 2));
        if high < 0 || low < 0 { None }
        else { percent_bytes(data, at + 3, accumulator.concat(byte_of_int(high * 16 + low)), form) }
      }
    } else if form && c == 43 {
      percent_bytes(data, at + 1, accumulator.concat(byte_of_int(32)), form)
    } else { percent_bytes(data, at + 1, accumulator.concat(byte_of_int(c)), form) }
  }

fn unreserved(c: Int) -> Bool =
  (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 45 || c == 46
    || c == 95
    || c == 126

fn hex_digit(n: Int) -> String / {abort.raise} = "0123456789ABCDEF".slice(n, n + 1)

fn hex_value(c: Int) -> Int =
  if c >= 48 && c <= 57 { c - 48 }
  else if c >= 97 && c <= 102 { c - 87 }
  else if c >= 65 && c <= 70 { c - 55 }
  else { 0 - 1 }

/// Why a text was rejected.
pub type ErrorKind =
  /// A character outside ASCII anywhere but in a host's name. A URL must percent-encode it.
  | NotAscii
  /// A control character, a space, or one of `"<>\^{|}` and the backquote, which no part of a
  /// URL may contain unencoded.
  | Forbidden
  /// A `%` not followed by two hex digits.
  | BadEscape
  /// No scheme: the text is a relative reference, which `reference_parse` parses.
  | NoScheme
  /// The text before the first `:` is not a scheme, which is a letter followed by letters,
  /// digits, `+`, `-` and `.`. A relative path whose first segment contains a `:` must be written
  /// `./a:b`.
  | BadScheme
  /// A second `@` in the authority. Userinfo may not contain an unencoded `@`.
  | SecondAt
  /// A `[` starts an address and no `]` ends it.
  | OpenBracket
  /// The brackets contain an address of a future version (`[v1.x]`), which is not supported.
  | FutureAddress
  /// The host is not an IP address, and `std.ip` says why. A host in brackets must be an IPv6
  /// address. A host outside brackets that is only digits and dots must be four decimal octets.
  | Address(ip::ErrorKind)
  /// The host's last label is a number and the host is not four decimal octets. Other parsers
  /// treat `127.1`, `0x7f.1` and `2130706433` as addresses.
  | NumericHost
  /// The host contains a `%` escape that does not decode to part of the UTF-8 bytes of a non-ASCII
  /// character. Only non-ASCII characters may be escaped in a host, so an escape cannot hide a dot,
  /// a digit or a letter.
  | EncodedHost
  /// The host contains non-ASCII characters and is not a valid domain name. `std.idna` lists each
  /// problem together with the label it is in. A problem is one of two kinds: the UTS #46 checks
  /// that the URL Standard applies to a host reject the name, or converting the name to ASCII gives
  /// an empty name or a character that no registered name may contain.
  | Idna(List<idna::Problem>)
  /// The port contains something other than decimal digits.
  | BadPort
  /// The port is above 65535.
  | PortRange
  /// A character that cannot appear here unencoded: a `[` or `]` outside a host's brackets, or a
  /// `#` in a fragment.
  | UnexpectedCharacter

/// Why a text was rejected, and the offset in the text where the parser stopped, counted in
/// characters.
pub type Error = { at: Int, reason: ErrorKind }

/// What this module's parsers raise when they fail.
pub effect url {
  /// The text is not a URL, or not a reference.
  raise fail(e: Error)
}

/// An error's reason as a sentence, which a literal's diagnostic reports.
pub fn url_reason(reason: ErrorKind) -> String =
  match reason {
    NotAscii ->
      "outside a host name a URL contains only ASCII characters: write this character as a `%` escape",
    Forbidden -> "a URL cannot contain this character unless it is written as a `%` escape",
    BadEscape -> "a `%` must be followed by two hexadecimal digits",
    NoScheme -> "a URL must start with a scheme followed by a `:`",
    BadScheme ->
      "a scheme must start with a letter and continue with letters, digits, `+`, `-` or `.`",
    SecondAt -> "an authority can contain only one `@`",
    OpenBracket -> "a `[` that starts an address must be closed by a `]`",
    FutureAddress -> "addresses of future IP versions are not supported",
    Address(inner) -> "the host is not a valid IP address: " ++ ip::reason(inner),
    NumericHost -> "a host that ends in a number must be an IPv4 address of four decimal numbers",
    EncodedHost -> "a `%` escape in a host can only stand for a character outside ASCII",
    Idna(problems) ->
      "the host is not a valid domain name: "
        ++ (match problems { [first, ..] -> idna::reason(first.reason), [] -> "it is empty" }),
    BadPort -> "a port must be written in decimal digits",
    PortRange -> "a port must be at most 65535",
    UnexpectedCharacter -> "this character cannot appear here unless it is written as a `%` escape",
  }

fn fail<a>(at: Int, reason: ErrorKind) -> a / {url.fail} = url.fail({ at: at, reason: reason })

/// Parses `text` as a URL, or returns where and why it is not one.
pub fn url_parse(text: String) -> Result<Url, Error> / {abort.raise} = try { url_read(text) }

/// Parses `text` as a URL, raising `url.fail` where `url_parse` returns `Err`.
pub fn url_read(text: String) -> Url / {url.fail, abort.raise} = {
  let parts = parse_parts(text);
  match parts.scheme { Some(_) -> Url(text, parts), None -> fail(0, NoScheme) }
}

/// Parses `text` as a reference, either a URL or a relative reference, or returns where and why it
/// is neither.
pub fn reference_parse(text: String) -> Result<Reference, Error> / {abort.raise} =
  try { reference_read(text) }

/// Parses `text` as a reference, raising `url.fail` where `reference_parse` returns `Err`.
pub fn reference_read(text: String) -> Reference / {url.fail, abort.raise} =
  Reference(text, parse_parts(text))

fn parse_parts(text: String) -> Parts / {url.fail, abort.raise} =
  match try { split_parts(text) } {
    Ok(parts) -> parts,
    Err(rejected) -> {
      let b = Bytes::of_string(text);
      fail(
        if text.len() == b.len() { rejected.at }
        else { String::of_bytes_lossy(b.slice(0, rejected.at)).len() },
        rejected.reason,
      )
    },
  }

/// Checks a `url"..."` literal. Returns the URL, or an error with the offset of the character that
/// makes the text invalid.
pub fn literal(text: String) -> Result<Url, { message: String, offset: Int }> / {abort.raise} =
  match url_parse(text) {
    Ok(u) -> Ok(u),
    Err(rejected) -> Err({ message: url_reason(rejected.reason), offset: rejected.at }),
  }

fn letters() -> Bytes = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"

fn decimal_digits() -> Bytes = b"0123456789"

fn scheme_bytes() -> Bytes = Bytes::concat_all([letters(), decimal_digits(), b"+-."])

fn name_bytes() -> Bytes = Bytes::concat_all([letters(), decimal_digits(), b"-._~!$&'()*+,;="])

fn userinfo_bytes() -> Bytes = name_bytes().concat(b":%")

fn path_bytes() -> Bytes = name_bytes().concat(b":@%/")

fn query_bytes() -> Bytes = path_bytes().concat(b"?")

fn url_bytes() -> Bytes = query_bytes().concat(b"#[]")

fn split_parts(text: String) -> Parts / {url.fail, abort.raise} = {
  let raw = Bytes::of_string(text);
  let name = host_span(raw);
  let b = check_characters(raw, name.from, name.to);
  let n = b.len();
  let hier = scheme_end(b);
  let slashed = b.slice(hier, n).starts_with(b"//");
  let path_from = if slashed { b.skip_until(hier + 2, b"/?#") } else { hier };
  let path_to = b.skip_until(path_from, b"?#");
  let query_to = if b.peek(path_to) == b'?' { b.skip_until(path_to, b"#") } else { path_to };
  {
    scheme: if hier == 0 { None } else { Some(scheme_of(String::of_bytes(b.slice(0, hier - 1)))) },
    authority: if slashed { Some(authority_of(b.slice(hier + 2, path_from), hier + 2)) }
    else { None },
    path: part(b, path_from, path_to, path_bytes(), 0),
    query: if query_to > path_to { Some(part(b, path_to + 1, query_to, query_bytes(), 0)) }
    else { None },
    fragment: if query_to < n { Some(part(b, query_to + 1, n, query_bytes(), 0)) } else { None },
  }
}

fn host_span(b: Bytes) -> { from: Int, to: Int } / {abort.raise} = {
  let stop = b.skip_until(0, b":/?#");
  let hier = if b.peek(stop) == b':' { stop + 1 } else { 0 };
  if !b.starts_at(hier, b"//") { { from: 0, to: 0 } } else {
    let end = b.skip_until(hier + 2, b"/?#");
    let at = b.skip_until(hier + 2, b"@");
    let from = if at < end { at + 1 } else { hier + 2 };
    if b.peek(from) == b'[' { { from: 0, to: 0 } }
    else { { from: from, to: min(end, b.skip_until(from, b":")) } }
  }
}

fn check_characters(b: Bytes, open: Int, close: Int) -> Bytes / {url.fail, abort.raise} = {
  let n = b.len();
  let allowed = url_bytes();
  let stop = iterate(0, n + 1, |at: Int| {
    let next = b.skip(at, allowed);
    if next < n && next >= open && next < close && b.at(next) >= 128 { Continue(next + 1) }
    else { Stop(next) }
  });
  if stop < n { fail(stop, if b.at(stop) >= 128 { NotAscii } else { Forbidden }) } else {
    let bad = iterate(0, n + 1, |at: Int| {
      let mark = b.skip_until(at, b"%");
      if mark >= n { Stop(n) }
      else if hex_value(b.peek(mark + 1)) < 0 || hex_value(b.peek(mark + 2)) < 0 { Stop(mark) }
      else { Continue(mark + 3) }
    });
    if bad < n { fail(bad, BadEscape) } else { b }
  }
}

fn scheme_end(b: Bytes) -> Int / {url.fail, abort.raise} = {
  let stop = b.skip_until(0, b":/?#");
  if b.peek(stop) != b':' { 0 }
  else if stop > 0 && b.skip(0, letters()) > 0 && b.skip(0, scheme_bytes()) == stop { stop + 1 }
  else { fail(0, BadScheme) }
}

fn scheme_of(url_text_gen: String) -> Scheme =
  { written: url_text_gen, name: url_text_gen.ascii_lower() }

fn part(b: Bytes, from: Int, to: Int, set: Bytes, base: Int) -> String / {url.fail, abort.raise} =
  if b.skip(from, set) < to { fail(base + b.skip(from, set), UnexpectedCharacter) }
  else { String::of_bytes(b.slice(from, to)) }

fn authority_of(a: Bytes, base: Int) -> Authority / {url.fail, abort.raise} = {
  let n = a.len();
  let at = a.skip_until(0, b"@");
  let from = if at < n { at + 1 } else { 0 };
  let userinfo = if at < n { Some(part(a, 0, at, userinfo_bytes(), base)) } else { None };
  if a.skip_until(from, b"@") < n { fail(base + a.skip_until(from, b"@"), SecondAt) } else {
    let to = if a.peek(from) == b'[' { bracket_end(a, from, base) }
    else { a.skip_until(from, b":") };
    {
      userinfo: userinfo,
      redacted_userinfo: match userinfo {
        Some(url_text_gen) -> Some(redact_userinfo(url_text_gen)),
        None -> None,
      },
      host: String::of_bytes(a.slice(from, to)),
      named: host_of(a, from, to, base),
      port: if to < n { Some(String::of_bytes(a.slice(to + 1, n))) } else { None },
      number: if to < n { port_of(a, to + 1, base) } else { None },
    }
  }
}

fn bracket_end(a: Bytes, from: Int, base: Int) -> Int / {url.fail, abort.raise} = {
  let close = a.skip_until(from, b"]");
  if close >= a.len() { fail(base + from, OpenBracket) }
  else if close + 1 < a.len() && a.at(close + 1) != b':' {
    fail(base + close + 1, UnexpectedCharacter)
  } else { close + 1 }
}

fn host_of(a: Bytes, from: Int, to: Int, base: Int) -> Option<Host> / {url.fail, abort.raise} =
  if from == to { None }
  else if a.at(from) == b'[' { Some(V6(bracketed(a.slice(from + 1, to - 1), base + from + 1))) }
  else { Some(named_host(a.slice(from, to), base + from)) }

fn bracketed(inside: Bytes, base: Int) -> Ipv6 / {url.fail, abort.raise} =
  if inside.peek(0) | 32 == b'v' { fail(base, FutureAddress) } else {
    match ip::parse_v6(String::of_bytes(inside)) {
      Ok(six) -> six,
      Err(rejected) -> fail(base + rejected.at, Address(rejected.reason)),
    }
  }

fn named_host(h: Bytes, base: Int) -> Host / {url.fail, abort.raise} =
  if h.skip(0, name_bytes()) < h.len() { international_host(h, base) } else {
    match ip::parse_v4(String::of_bytes(h)) {
      Ok(four) -> V4(four),
      Err(rejected) -> if h.skip(0, b"0123456789.") >= h.len() {
        fail(base + rejected.at, Address(rejected.reason))
      } else if ends_in_number(h) { fail(base, NumericHost) }
      else { Name(String::of_bytes(h).ascii_lower()) },
    }
  }

fn international_host(h: Bytes, base: Int) -> Host / {url.fail, abort.raise} = {
  let n = h.len();
  let allowed = name_bytes().concat(b"%");
  let stray = iterate(0, n + 1, |at: Int| {
    let next = h.skip(at, allowed);
    if next < n && h.at(next) >= 128 { Continue(next + 1) } else { Stop(next) }
  });
  if stray < n { fail(base + stray, UnexpectedCharacter) } else {
    let unescaped = unescaped_name(h, base);
    if !unescaped.is_utf8() { fail(base + h.skip_until(0, b"%"), EncodedHost) } else {
      match idna::to_ascii(String::of_bytes(unescaped), idna::web()) {
        Err(problems) -> fail(base, Idna(problems)),
        Ok(name) -> registered_name_host(name, base),
      }
    }
  }
}

type UnescapeState = { out: Bytes, at: Int }

fn unescaped_name(h: Bytes, base: Int) -> Bytes / {url.fail, abort.raise} = {
  let pieces = h.split(b"%");
  let plain = pieces.at_or(0, b"");
  pieces.drop(1).fold({ out: plain, at: plain.len() }, |so_far: UnescapeState, piece: Bytes| {
    let byte = hex_value(piece.at(0)) * 16 + hex_value(piece.at(1));
    if byte < 128 { fail(base + so_far.at, EncodedHost) } else {
      {
        out: Bytes::concat_all([so_far.out, byte_of_int(byte), piece.slice(2, piece.len())]),
        at: so_far.at + 1 + piece.len(),
      }
    }
  }).out
}

fn registered_name_host(name: String, base: Int) -> Host / {url.fail, abort.raise} = {
  let b = Bytes::of_string(name);
  let n = b.len();
  let stop = b.skip(0, name_bytes());
  if n == 0 { fail(base, Idna([{ label: 0, reason: idna::EmptyLabel }])) } else if stop < n {
    let label = b.slice(0, stop).split(b".").len() - 1;
    fail(base, Idna([{ label: label, reason: idna::Disallowed }]))
  } else if b.skip(0, b"0123456789.") >= n || ends_in_number(b) { fail(base, NumericHost) }
  else { Name(name) }
}

fn ends_in_number(h: Bytes) -> Bool / {abort.raise} = {
  let n = h.len();
  let labels = Bytes::split(if h.ends_with(b".") { h.slice(0, n - 1) } else { h }, b".");
  let last = labels.at_or(labels.len() - 1, b"");
  let m = last.len();
  m > 0
    && (last.skip(0, decimal_digits()) == m
    || (m >= 2 && last.at(0) == b'0' && last.at(1) | 32 == b'x'
    && last.skip(2, b"0123456789abcdefABCDEF") == m))
}

fn port_of(a: Bytes, from: Int, base: Int) -> Option<Int> / {url.fail, abort.raise} = {
  let n = a.len();
  let digits = a.skip(from, b"0");
  if a.skip(from, decimal_digits()) < n { fail(base + a.skip(from, decimal_digits()), BadPort) }
  else if from >= n { None }
  else if n - digits > 5 { fail(base + from, PortRange) } else {
    let number = range(digits, n).fold(0, |accumulator: Int, i: Int|
      accumulator * 10 + a.at(i) - b'0');
    if number > 65535 { fail(base + from, PortRange) } else { Some(number) }
  }
}

fn redact_userinfo(userinfo: String) -> String / {abort.raise} = {
  let b = Bytes::of_string(userinfo);
  let colon = b.skip_until(0, b":");
  if colon + 1 >= b.len() { userinfo } else { String::of_bytes(b.slice(0, colon + 1)) ++ "xxxxx" }
}

fn composed(parts: Parts, redact: Bool) -> String =
  (match parts.scheme { Some(scheme) -> scheme.written ++ ":", None -> "" })
    ++ (match parts.authority { Some(a) -> "//" ++ authority_text(a, redact), None -> "" })
    ++ parts.path
    ++ (match parts.query { Some(query) -> "?" ++ query, None -> "" })
    ++ (match parts.fragment { Some(fragment) -> "#" ++ fragment, None -> "" })

fn authority_text(a: Authority, redact: Bool) -> String =
  (match if redact { a.redacted_userinfo } else { a.userinfo } { Some(u) -> u ++ "@", None -> "" })
    ++ a.host
    ++ (match a.port { Some(port) -> ":" ++ port, None -> "" })

/// The URL's text, which is the text it was parsed from.
pub fn url_render(u: Url) -> String = match u { Url(text, _) -> text }

/// The URL's text with a password hidden: what follows the first `:` of its userinfo is written
/// `xxxxx`. This is what `show` writes.
pub fn url_redacted(u: Url) -> String = match u { Url(_, parts) -> composed(parts, true) }

/// The reference's text, which is the text it was parsed from.
pub fn reference_render(r: Reference) -> String = match r { Reference(text, _) -> text }

/// The reference's text with a password hidden, as `url_redacted` hides one.
pub fn reference_redacted(r: Reference) -> String =
  match r { Reference(_, parts) -> composed(parts, true) }

/// Returns the URL as a reference. Resolving this reference against any base gives back the URL,
/// except that dot segments (`.` and `..`) in the path are removed.
pub fn reference_of(u: Url) -> Reference = match u { Url(text, parts) -> Reference(text, parts) }

/// The reference as a URL when it has a scheme, or `None` for a relative reference.
pub fn reference_url(r: Reference) -> Option<Url> =
  match r {
    Reference(text, parts) -> match parts.scheme {
      Some(_) -> Some(Url(text, parts)),
      None -> None,
    },
  }

fn parts_of(u: Url) -> Parts = match u { Url(_, parts) -> parts }

/// The scheme in lower case, whatever case it was written in.
pub fn url_scheme(u: Url) -> String =
  match parts_of(u).scheme { Some(scheme) -> scheme.name, None -> "" }

/// The authority as written, without its `//`: userinfo, host and port. `None` where the URL
/// has none, as `mailto:a@example.com` has none.
pub fn url_authority(u: Url) -> Option<String> =
  match parts_of(u).authority { Some(a) -> Some(authority_text(a, false)), None -> None }

/// The userinfo as written, without its `@`. `None` where the URL has none.
pub fn url_userinfo(u: Url) -> Option<String> =
  match parts_of(u).authority { Some(a) -> a.userinfo, None -> None }

/// The host the authority names. `None` where the URL has no authority or its host is empty, as
/// in `file:///etc/hosts`.
pub fn url_host(u: Url) -> Option<Host> =
  match parts_of(u).authority { Some(a) -> a.named, None -> None }

/// Returns the host as a person would read it, or `None` when `url_host` is `None`. For a domain
/// name, a label that starts with `xn--` is shown in Unicode, as `idna::to_unicode` converts it
/// with the URL Standard's host rules. A label that starts with `xn--` but cannot be converted is
/// shown as written. An IPv4 or IPv6 address is written as `url_normalized` writes it. This does
/// not check whether the name is safe to show to a user, for example against lookalike characters.
pub fn url_display_host(u: Url) -> Option<String> / {abort.raise} =
  match url_host(u) {
    None -> None,
    Some(Name(name)) -> if !name.contains("xn--") { Some(name) } else {
      let shown = idna::to_unicode(name, idna::web());
      Some(if shown.problems.len() == 0 { shown.name } else { name })
    },
    Some(V4(four)) -> Some(ip::render_v4(four)),
    Some(V6(six)) -> Some("[" ++ ip::render_v6(six) ++ "]"),
  }

/// The host and port as written, without userinfo. `None` where the URL has no authority. An HTTP
/// `Host` field carries this value for the normalized URL, which is ASCII.
pub fn url_host_port(u: Url) -> Option<String> =
  match parts_of(u).authority {
    Some(a) -> Some(a.host ++ (match a.port { Some(port) -> ":" ++ port, None -> "" })),
    None -> None,
  }

/// The port written in the authority, from 0 to 65535. `None` when there is none, including a `:`
/// with no digits.
pub fn url_port(u: Url) -> Option<Int> =
  match parts_of(u).authority { Some(a) -> a.number, None -> None }

/// The port a scheme's URLs use when they do not write one: 80 for `http` and `ws`, 443 for `https`
/// and `wss`, 21 for `ftp`, and `None` for any other scheme. The scheme is given in lower case.
pub fn url_default_port(scheme: String) -> Option<Int> =
  match scheme {
    "http" -> Some(80),
    "ws" -> Some(80),
    "https" -> Some(443),
    "wss" -> Some(443),
    "ftp" -> Some(21),
    _ -> None,
  }

/// The port written in the URL, or its scheme's default when none is written.
pub fn url_port_or_default(u: Url) -> Option<Int> =
  match url_port(u) { Some(port) -> Some(port), None -> url_default_port(url_scheme(u)) }

/// The path as written, escapes and all. Empty, or starting with `/`, where the URL has an
/// authority.
pub fn url_path(u: Url) -> String = parts_of(u).path

/// The path's segments, each percent-decoded, so an escaped `/` is part of its segment. The
/// `/` that starts a path starts its first segment: `/a/b` is `a` and `b`, `/a/` ends with an
/// empty segment, `/` is one empty segment, and the empty path has none. `None` where a segment
/// decodes to bytes that are not UTF-8.
pub fn url_path_segments(u: Url) -> Option<List<String>> / {abort.raise} = {
  let path = url_path(u);
  if path == "" { Some([]) } else {
    let split = path.split("/");
    Option::traverse(if path.starts_with("/") { split.drop(1) } else { split }, url_decode)
  }
}

/// The query as written, without its `?`. `None` where the URL has none; `Some("")` for a `?`
/// with nothing after it.
pub fn url_query(u: Url) -> Option<String> = parts_of(u).query

/// The fragment as written, without its `#`. `None` where the URL has none.
pub fn url_fragment(u: Url) -> Option<String> = parts_of(u).fragment

/// A scheme, a host and a port: what two URLs share when a browser calls them the same origin
/// (RFC 6454).
pub type Origin = { scheme: String, host: Host, port: Int }

/// The URL's origin: its scheme, its host, and its port, as written or its scheme's default.
/// `None` when it has no host, or has no port and a scheme whose default this module does not
/// know.
pub fn url_origin(u: Url) -> Option<Origin> =
  match url_host(u) {
    None -> None,
    Some(host) -> match url_port_or_default(u) {
      None -> None,
      Some(port) -> Some({ scheme: url_scheme(u), host: host, port: port }),
    },
  }

fn reread(text: String) -> Url / {abort.raise} =
  match url_parse(text) {
    Ok(u) -> u,
    Err(_) -> panic("std.url built a URL text that it cannot parse: " ++ text),
  }

fn guarded(parts: Parts) -> Parts =
  match parts.authority {
    Some(_) -> parts,
    None -> if parts.path.starts_with("//") { { ..parts, path: "/." ++ parts.path } }
    else { parts },
  }

fn with_query(u: Url, query: Option<String>) -> Url / {abort.raise} =
  reread(composed({ ..parts_of(u), query: query }, false))

/// The query as `name`/`value` pairs, as `query_parse` parses them, and no pairs when the URL has
/// no query. `None` when the query is not valid form encoding.
pub fn url_query_pairs(u: Url) -> Option<List<Pair>> / {abort.raise} =
  match url_query(u) { Some(query) -> query_parse(query), None -> Some([]) }

/// The URL with its query replaced by what `query_build` writes for `pairs`, or with no query when
/// there are no pairs.
pub fn url_with_query_pairs(u: Url, pairs: List<Pair>) -> Url / {abort.raise} =
  with_query(u, if pairs.len() == 0 { None } else { Some(query_build(pairs)) })

/// The value of the URL's first query parameter named `name`. `None` where it has none, or its
/// query is not valid form encoding.
pub fn url_param(u: Url, name: String) -> Option<String> / {abort.raise} =
  match url_query_pairs(u) { Some(pairs) -> query_get(pairs, name), None -> None }

/// Returns the values of every query parameter named `name`, in order. Returns an empty list when
/// there is no such parameter or when the query is not valid form encoding.
pub fn url_params(u: Url, name: String) -> List<String> / {abort.raise} =
  match url_query_pairs(u) {
    Some(pairs) -> pairs.filter(|p: Pair| p.name == name).map(|p: Pair| p.value),
    None -> [],
  }

/// The URL with its query parameter `name` set to `value`, placed as `query_set` places it, and
/// the query written as `query_build` writes one. `None` when the query is not valid form encoding.
pub fn url_set_param(u: Url, name: String, value: String) -> Option<Url> / {abort.raise} =
  match url_query_pairs(u) {
    Some(pairs) -> Some(url_with_query_pairs(u, query_set(pairs, name, value))),
    None -> None,
  }

/// The URL with a query parameter added after its existing ones, which stay. `None` when the query
/// is not valid form encoding.
pub fn url_add_param(u: Url, name: String, value: String) -> Option<Url> / {abort.raise} =
  match url_query_pairs(u) {
    Some(pairs) -> Some(url_with_query_pairs(u, pairs.push({ name: name, value: value }))),
    None -> None,
  }

/// The URL without any query parameter named `name`. `None` where the query is not valid form
/// encoding.
pub fn url_remove_param(u: Url, name: String) -> Option<Url> / {abort.raise} =
  match url_query_pairs(u) {
    Some(pairs) -> Some(url_with_query_pairs(u, query_remove(pairs, name))),
    None -> None,
  }

/// The URL with `segments` added to its path, and its query and fragment dropped. Each segment is
/// percent-encoded whole, so no segment adds a `/` of its own. `None` when a segment is empty, `.`
/// or `..`: the added segments name something below the path and cannot climb out of it.
pub fn url_join_path(u: Url, segments: List<String>) -> Option<Url> / {abort.raise} =
  if segments.any(|s: String| s == "" || s == "." || s == "..") { None } else {
    let parts = parts_of(u);
    let stem = if parts.path.ends_with("/") { parts.path.slice(0, parts.path.len() - 1) }
    else { parts.path };
    let path = segments.fold(stem, |accumulator: String, s: String|
      accumulator ++ "/" ++ url_encode(s));
    Some(reread(composed({ ..parts, path: path, query: None, fragment: None }, false)))
  }

/// Returns the URL that `reference` means when `base` is the URL of the document containing it, as
/// RFC 3986 §5.2.2 defines. A reference with a scheme is returned as itself with its dot segments
/// removed, even when the scheme equals the base's: `http:g` against an `http` base is `http:g`.
/// For any other reference, each part it leaves out (scheme, authority, path) is taken from `base`;
/// a relative path is joined to the base path up to its last `/`. The result never has the base's
/// fragment.
pub fn url_resolve(base: Url, reference: Reference) -> Url / {abort.raise} =
  match reference {
    Reference(_, r) -> reread(composed(guarded(resolve_parts(parts_of(base), r)), false)),
  }

/// The URL that `reference` means against `base`: `reference_parse`, then `url_resolve`.
pub fn url_join(base: Url, reference: String) -> Result<Url, Error> / {abort.raise} =
  match reference_parse(reference) {
    Ok(r) -> Ok(url_resolve(base, r)),
    Err(rejected) -> Err(rejected),
  }

fn resolve_parts(base: Parts, r: Parts) -> Parts / {abort.raise} =
  match r.scheme {
    Some(_) -> { ..r, path: without_dots(r.path) },
    None -> match r.authority {
      Some(_) -> { ..r, scheme: base.scheme, path: without_dots(r.path) },
      None -> if r.path == "" {
        {
          ..base,
          query: match r.query { Some(_) -> r.query, None -> base.query },
          fragment: r.fragment,
        }
      } else {
        {
          ..base,
          path: without_dots(if r.path.starts_with("/") { r.path } else { merged(base, r.path) }),
          query: r.query,
          fragment: r.fragment,
        }
      },
    },
  }

fn merged(base: Parts, path: String) -> String =
  match base.authority {
    Some(_) -> if base.path == "" { "/" ++ path } else { stem(base.path) ++ path },
    None -> stem(base.path) ++ path,
  }

fn stem(path: String) -> String = {
  let pieces = path.split("/");
  range(0, pieces.len() - 1).fold("", |accumulator: String, i: Int|
    accumulator ++ pieces.at_or(i, "") ++ "/")
}

type DotRemovalState = { at: Int, out: List<Bytes> }

fn without_dots(path: String) -> String / {abort.raise} = {
  let b = Bytes::of_string(path);
  let start: DotRemovalState = { at: 0, out: [] };
  String::of_bytes(
    Bytes::concat_all(iterate(start, b.len() + 2, |w: DotRemovalState| dot_step(b, w))),
  )
}

fn dot_step(b: Bytes, w: DotRemovalState) -> Iter<DotRemovalState, List<Bytes>> / {abort.raise} =
  if w.at >= b.len() { Stop(w.out) }
  else if b.starts_at(w.at, b"../") { Continue({ at: w.at + 3, out: w.out }) }
  else if b.starts_at(w.at, b"./") || b.starts_at(w.at, b"/./") {
    Continue({ at: w.at + 2, out: w.out })
  } else if rest_is(b, w.at, b"/.") { Stop(w.out.push(b"/")) } else if b.starts_at(w.at, b"/../") {
    Continue({ at: w.at + 3, out: w.out.take(w.out.len() - 1) })
  } else if rest_is(b, w.at, b"/..") { Stop(w.out.take(w.out.len() - 1).push(b"/")) }
  else if rest_is(b, w.at, b".") || rest_is(b, w.at, b"..") { Stop(w.out) } else {
    let end = b.skip_until(if b.at(w.at) == b'/' { w.at + 1 } else { w.at }, b"/");
    Continue({ at: end, out: w.out.push(b.slice(w.at, end)) })
  }

fn rest_is(b: Bytes, at: Int, whole: Bytes) -> Bool / {abort.raise} =
  b.len() - at == whole.len() && b.starts_at(at, whole)

/// The URL that RFC 3986 §6.2.2 and §6.2.3 consider equivalent to `u`: its scheme and host in lower
/// case, an address as `std.ip` writes it, every escape in upper case, an escaped unreserved
/// character written plain, dot segments removed (§5.2.4), an empty path beside an authority
/// made `/`, and a port that is empty or its scheme's default dropped. Normalizing again
/// changes nothing. A query's `+` and `%20`, the order of its parameters, and a trailing `/`
/// are left as written.
pub fn url_normalized(u: Url) -> Url / {abort.raise} = {
  let parts = parts_of(u);
  let path = without_dots(plain_escapes(parts.path));
  let authority = match parts.authority {
    Some(a) -> "//" ++ normal_authority(a, url_default_port(url_scheme(u))),
    None -> "",
  };
  let rooted = if path == "" && authority != "" { "/" }
  else if authority == "" && path.starts_with("//") { "/." ++ path }
  else { path };
  reread(
    url_scheme(u) ++ ":" ++ authority ++ rooted
      ++ (match parts.query { Some(query) -> "?" ++ plain_escapes(query), None -> "" })
      ++ (match parts.fragment { Some(fragment) -> "#" ++ plain_escapes(fragment), None -> "" }),
  )
}

fn normal_authority(a: Authority, default: Option<Int>) -> String / {abort.raise} =
  (match a.userinfo { Some(userinfo) -> plain_escapes(userinfo) ++ "@", None -> "" })
    ++ (match a.named {
      Some(Name(name)) -> name,
      Some(V4(four)) -> ip::render_v4(four),
      Some(V6(six)) -> "[" ++ ip::render_v6(six) ++ "]",
      None -> "",
    })
    ++ (match a.number {
      Some(port) -> if Some(port) == default { "" } else { ":" ++ port.to_string() },
      None -> "",
    })

fn plain_escapes(text: String) -> String / {abort.raise} = {
  let pieces = Bytes::of_string(text).split(b"%");
  String::of_bytes(
    range(1, pieces.len()).fold(pieces.at_or(0, b""), |accumulator: Bytes, i: Int| {
      let piece = pieces.at_or(i, b"");
      let byte = hex_value(piece.at(0)) * 16 + hex_value(piece.at(1));
      Bytes::concat_all([
        accumulator,
        if unreserved(byte) { byte_of_int(byte) }
        else { Bytes::of_string("%" ++ hex_digit(byte / 16) ++ hex_digit(byte % 16)) },
        piece.slice(2, piece.len()),
      ])
    }),
  )
}

/// Generates URLs. Each URL has a scheme, either one whose default port this module knows or
/// another scheme. It may have an authority. Its path mixes plain, escaped and dot segments. It may
/// have a query, a fragment, both or neither.
pub fn url_gen() -> Gen<Url> =
  gen::and_then(url_text_gen(true), |text: String|
    match url_parse(text) { Ok(u) -> gen::constant(u), Err(_) -> gen::elements([]) })

/// A generator of references: a URL, or a relative reference of each kind §4.2 names.
pub fn reference_gen() -> Gen<Reference> =
  gen::and_then(gen::one_of([url_text_gen(false), url_text_gen(true)]), |text: String|
    match reference_parse(text) { Ok(r) -> gen::constant(r), Err(_) -> gen::elements([]) })

fn url_text_gen(absolute: Bool) -> Gen<String> =
  gen::and_then(gen::bool(), |with_authority: Bool|
    gen::map2(
      gen::map2(
        if absolute { gen::elements(schemes()) } else { gen::constant("") },
        if with_authority { gen::map(authority_text_gen(), |a: String| "//" ++ a) }
        else { gen::constant("") },
        |scheme: String, authority: String| scheme ++ authority,
      ),
      gen::map2(path_gen(with_authority, absolute), tail_gen(), |path: String, tail: String|
        path ++ tail),
      |front: String, back: String| front ++ back,
    ))

fn schemes() -> List<String> =
  [
    "http:",
    "https:",
    "ws:",
    "wss:",
    "ftp:",
    "file:",
    "mailto:",
    "urn:",
    "HTTP:",
    "hTTps:",
    "a+b-c.d:",
    "x1:",
  ]

fn authority_text_gen() -> Gen<String> / {abort.raise} =
  gen::map2(
    gen::map2(
      gen::elements(["", "", "user@", "user:pass@", "u%41:%7e@", ":@", "@", "a;b=c:d:e@"]),
      host_text_gen(),
      |userinfo: String, host: String| userinfo ++ host,
    ),
    gen::elements([
      "",
      "",
      ":",
      ":80",
      ":443",
      ":8080",
      ":0",
      ":65535",
      ":0080",
      ":21",
      ":00000443",
    ]),
    |front: String, port: String| front ++ port,
  )

fn host_text_gen() -> Gen<String> / {abort.raise} =
  gen::one_of([
    gen::elements([
      "example.com",
      "EXAMPLE.Com",
      "a",
      "localhost",
      "xn--bcher-kva.example",
      "B\u{FC}cher.example",
      "b%C3%BCcher.Example",
      "\u{4F8B}\u{3048}\u{3002}jp",
      "fa\u{DF}.de.",
      "xn--a",
      "\u{5D0}\u{5D1}.xn--4dbc",
      "a-b.c_d",
      "sub.Example.ORG.",
      "1.2.3.4.example",
      "a!$&'()*+,;=b",
      "",
      "0x7f.example",
      "1e3",
    ]),
    gen::map(ip::arbitrary_v4(), ip::render_v4),
    gen::map(ip::arbitrary_v6(), |six: Ipv6| "[" ++ ip::render_v6(six) ++ "]"),
    gen::elements([
      "[2001:DB8::1]",
      "[::FFFF:192.0.2.1]",
      "[0:0:0:0:0:0:0:1]",
      "[::ffff:c000:201]",
    ]),
  ])

fn segment_texts() -> List<String> =
  [
    "a",
    "b",
    "",
    ".",
    "..",
    "%7Euser",
    "%7euser",
    "a%2Fb",
    "%41",
    "c;p=1",
    "x:y",
    "@",
    "%2e",
    "%2E%2e",
    "g.",
    "..g",
    "%C3%A9",
    "-._~",
    "!$&'()*+,;=",
    "%00",
  ]

fn path_gen(with_authority: Bool, absolute: Bool) -> Gen<String> =
  gen::map2(
    gen::bool(),
    gen::list_of(gen::elements(segment_texts()), 6),
    |rooted: Bool, parts: List<String>|
      if parts.len() == 0 { if rooted { "/" } else { "" } }
      else if with_authority { "/" ++ String::join(parts, "/") } else {
        let first = parts.at_or(0, "");
        let safe = if first == "" || (!absolute && !rooted && first == "x:y") { "s" }
        else { first };
        (if rooted { "/" } else { "" }) ++ String::join([safe].concat(parts.drop(1)), "/")
      },
  )

fn tail_gen() -> Gen<String> =
  gen::map2(
    gen::elements([
      "",
      "",
      "?",
      "?q",
      "?a=1&b=2",
      "?a=%20b+c",
      "?/?",
      "?a=1&a=2",
      "?k=%7E&%41=%7e",
      "?a&&b=",
      "?%FF=1",
    ]),
    gen::elements(["", "", "#", "#f", "#/?", "#%7E", "#a:b@c"]),
    |query: String, fragment: String| query ++ fragment,
  )

fn parsed_url(text: String) -> Url / {abort.raise} =
  match url_parse(text) { Ok(u) -> u, Err(_) -> panic("not a URL: " ++ text) }

fn parsed_reference(text: String) -> Reference / {abort.raise} =
  match reference_parse(text) { Ok(r) -> r, Err(_) -> panic("not a reference: " ++ text) }

fn pairs() -> gen::Gen<Pair> =
  gen::map2(gen::text(), gen::text(), |name: String, value: String| { name: name, value: value })

test "`url_decode` of `url_encode` of a text returns the original text" {
  gen::check(gen::text(), |x: String| round_trip(url_encode, url_decode, x))
}

test "`query_parse` of `query_build` of a list of pairs returns the same pairs" {
  gen::check(gen::list(pairs()), |x: List<Pair>| round_trip(query_build, query_parse, x))
}

test "`url_parse` of `url_render` of a URL returns the same URL" {
  gen::check(url_gen(), |x: Url| round_trip(url_render, |text: String| url_parse(text).ok(), x))
}

test "a text that parses as a URL or reference renders back to the same text, and any text either parses or fails with an error" {
  gen::check(gen::text(), |text: String| {
    (match url_parse(text) { Ok(u) -> url_render(u) == text, Err(_) -> true })
      && (match reference_parse(text) { Ok(r) -> reference_render(r) == text, Err(_) -> true })
  })
}

fn anatomy(
  u: Url,
) -> (String, Option<String>, Option<Host>, Option<Int>, String, Option<String>, Option<String>) =
  (
    url_scheme(u),
    url_userinfo(u),
    url_host(u),
    url_port(u),
    url_path(u),
    url_query(u),
    url_fragment(u),
  )

fn round_trips(u: Url) -> Bool / {abort.raise} =
  match url_parse(url_render(u)) { Ok(again) -> anatomy(again) == anatomy(u), Err(_) -> false }

test "a normalized URL renders and parses back to itself, normalizing again changes nothing, and its scheme, host and effective port are unchanged" {
  gen::check(url_gen(), |u: Url| {
    let normal = url_normalized(u);
    round_trips(normal) && url_normalized(normal) == normal && url_scheme(normal) == url_scheme(u)
      && url_host(normal) == url_host(u)
      && url_port_or_default(normal) == url_port_or_default(u)
      && (url_port(normal) == None || url_port(normal) != url_default_port(url_scheme(normal)))
      && url_render(normal).starts_with(url_scheme(normal) ++ ":")
  })
}

test "a resolved URL renders and parses back to itself, and takes its fragment only from the reference" {
  gen::check2(url_gen(), reference_gen(), |base: Url, r: Reference| {
    let resolved = url_resolve(base, r);
    round_trips(resolved)
      && Some(resolved)
      == (match reference_parse(reference_render(r)) {
        Ok(again) -> Some(url_resolve(base, again)),
        Err(_) -> None,
      })
      && (match reference_url(r) {
        Some(whole) ->
          url_fragment(resolved) == url_fragment(whole)
            && url_scheme(resolved) == url_scheme(whole),
        None -> url_scheme(resolved) == url_scheme(base),
      })
  })
}

test "a redacted URL parses as a URL with the same host, path and query, but with the password in its userinfo replaced by `xxxxx`" {
  gen::check(url_gen(), |u: Url| {
    match url_parse(url_redacted(u)) {
      Err(_) -> false,
      Ok(hidden) ->
        url_host(hidden) == url_host(u) && url_path(hidden) == url_path(u)
          && url_query(hidden) == url_query(u)
          && show(u) == url_redacted(u)
          && (match password_of(url_userinfo(u)) {
            Some(url_text_gen) ->
              url_userinfo(hidden) == Some(url_text_gen.head ++ ":xxxxx")
                && url_text_gen.tail != "",
            None -> url_redacted(u) == url_render(u),
          }),
    }
  })
}

fn password_of(userinfo: Option<String>) -> Option<{ head: String, tail: String }> / {abort.raise} =
  match userinfo {
    None -> None,
    Some(info) -> match info.split_once(":") {
      Some(parts) -> if parts.tail == "" { None } else { Some(parts) },
      None -> None,
    },
  }

test "`url_gen` and `reference_gen` always generate a value, and 300 generated URLs include no authority, IPv6, IPv4 and named hosts, userinfo, and non-normalized URLs" {
  let urls = range(0, 300).map(|i: Int| gen::sample(url_gen(), i, b"urls", i % 40, None).value);
  let references = range(0, 300).map(|i: Int|
    gen::sample(reference_gen(), i, b"refs", i % 40, None).value);
  assert(urls.all(|u: Option<Url>| u != None));
  assert(references.all(|r: Option<Reference>| r != None));
  let some = |keep: (Url) -> Bool / {abort.raise}|
    urls.any(|drawn: Option<Url>| match drawn { Some(u) -> keep(u), None -> false });
  assert(some(|u: Url| url_authority(u) == None));
  assert(some(|u: Url| match url_host(u) { Some(V6(_)) -> true, _ -> false }));
  assert(some(|u: Url| match url_host(u) { Some(V4(_)) -> true, _ -> false }));
  assert(some(|u: Url| match url_host(u) { Some(Name(_)) -> true, _ -> false }));
  assert(some(|u: Url| url_userinfo(u) != None && url_redacted(u) != url_render(u)));
  assert(some(|u: Url| url_normalized(u) != u));
  assert(some(|u: Url| url_query_pairs(u) == None));
  assert(
    references.any(|drawn: Option<Reference>|
      match drawn { Some(r) -> reference_url(r) == None, None -> false }),
  )
}

type Resolution = { reference: String, target: String }

fn normal_examples() -> List<Resolution> =
  [
    { reference: "g:h", target: "g:h" },
    { reference: "g", target: "http://a/b/c/g" },
    { reference: "./g", target: "http://a/b/c/g" },
    { reference: "g/", target: "http://a/b/c/g/" },
    { reference: "/g", target: "http://a/g" },
    { reference: "//g", target: "http://g" },
    { reference: "?y", target: "http://a/b/c/d;p?y" },
    { reference: "g?y", target: "http://a/b/c/g?y" },
    { reference: "#s", target: "http://a/b/c/d;p?q#s" },
    { reference: "g#s", target: "http://a/b/c/g#s" },
    { reference: "g?y#s", target: "http://a/b/c/g?y#s" },
    { reference: ";x", target: "http://a/b/c/;x" },
    { reference: "g;x", target: "http://a/b/c/g;x" },
    { reference: "g;x?y#s", target: "http://a/b/c/g;x?y#s" },
    { reference: "", target: "http://a/b/c/d;p?q" },
    { reference: ".", target: "http://a/b/c/" },
    { reference: "./", target: "http://a/b/c/" },
    { reference: "..", target: "http://a/b/" },
    { reference: "../", target: "http://a/b/" },
    { reference: "../g", target: "http://a/b/g" },
    { reference: "../..", target: "http://a/" },
    { reference: "../../", target: "http://a/" },
    { reference: "../../g", target: "http://a/g" },
  ]

fn abnormal_examples() -> List<Resolution> =
  [
    { reference: "../../../g", target: "http://a/g" },
    { reference: "../../../../g", target: "http://a/g" },
    { reference: "/./g", target: "http://a/g" },
    { reference: "/../g", target: "http://a/g" },
    { reference: "g.", target: "http://a/b/c/g." },
    { reference: ".g", target: "http://a/b/c/.g" },
    { reference: "g..", target: "http://a/b/c/g.." },
    { reference: "..g", target: "http://a/b/c/..g" },
    { reference: "./../g", target: "http://a/b/g" },
    { reference: "./g/.", target: "http://a/b/c/g/" },
    { reference: "g/./h", target: "http://a/b/c/g/h" },
    { reference: "g/../h", target: "http://a/b/c/h" },
    { reference: "g;x=1/./y", target: "http://a/b/c/g;x=1/y" },
    { reference: "g;x=1/../y", target: "http://a/b/c/y" },
    { reference: "g?y/./x", target: "http://a/b/c/g?y/./x" },
    { reference: "g?y/../x", target: "http://a/b/c/g?y/../x" },
    { reference: "g#s/./x", target: "http://a/b/c/g#s/./x" },
    { reference: "g#s/../x", target: "http://a/b/c/g#s/../x" },
    { reference: "http:g", target: "http:g" },
  ]

test "resolving `{c.reference}` against the base `http://a/b/c/d;p?q` gives `{c.target}`" for c: Resolution in normal_examples(
  ).concat(
    abnormal_examples(),
  ) {
  let base = parsed_url("http://a/b/c/d;p?q");
  assert_eq(url_render(url_resolve(base, parsed_reference(c.reference))), c.target);
  assert_eq(url_join(base, c.reference), Ok(parsed_url(c.target)))
}

type ResolutionCase = { base: String, reference: String, target: String }

fn resolutions() -> List<ResolutionCase> =
  [
    { base: "http://a", reference: "g", target: "http://a/g" },
    { base: "http://a", reference: "", target: "http://a" },
    { base: "http://a?q#f", reference: "", target: "http://a?q" },
    { base: "http://a/b?q#f", reference: "#", target: "http://a/b?q#" },
    { base: "http://a/b?q#f", reference: "?", target: "http://a/b?" },
    { base: "http://u:p@a:81/b", reference: "/c", target: "http://u:p@a:81/c" },
    { base: "http://u:p@a:81/b", reference: "//h", target: "http://h" },
    { base: "HTTP://A/b", reference: "c", target: "HTTP://A/c" },
    { base: "mailto:a@example.com", reference: "b@example.com", target: "mailto:b@example.com" },
    { base: "urn:a:b", reference: "c", target: "urn:c" },
    { base: "file:///a/b", reference: "../../../c", target: "file:///c" },
    { base: "a:/b", reference: ".//c", target: "a:/.//c" },
    { base: "a:b/c", reference: "..//d", target: "a:/.//d" },
    { base: "a:/b", reference: "//c", target: "a://c" },
    { base: "a:b", reference: "c:d/../e", target: "c:/e" },
    { base: "http://a/b/c", reference: "%2e%2e/d", target: "http://a/b/%2e%2e/d" },
    { base: "http://a/b/c", reference: "./x:y", target: "http://a/b/x:y" },
    { base: "http://a/b/c/", reference: "..", target: "http://a/b/" },
    { base: "http://a/b/c/", reference: "", target: "http://a/b/c/" },
    {
      base: "http://a/b/c",
      reference: "http://[::1]:8080/x?y#z",
      target: "http://[::1]:8080/x?y#z",
    },
  ]

test "resolving `{c.reference}` against the base `{c.base}` gives `{c.target}`" for c: ResolutionCase in resolutions(
  ) {
  assert_eq(url_render(url_resolve(parsed_url(c.base), parsed_reference(c.reference))), c.target)
}

type Anatomy = {
  text: String,
  scheme: String,
  userinfo: Option<String>,
  host: String,
  port: Option<Int>,
  path: String,
  query: Option<String>,
  fragment: Option<String>,
}

fn host_text(host: Option<Host>) -> String =
  match host {
    Some(Name(name)) -> "name " ++ name,
    Some(V4(four)) -> "v4 " ++ ip::render_v4(four),
    Some(V6(six)) -> "v6 " ++ ip::render_v6(six),
    None -> "none",
  }

