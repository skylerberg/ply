test "`describe_parse` of `{escape_controls(c.text)}` returns `{c.result}`" for c: ConfusionCase in confusions(
  ) { assert_eq(describe_parse(c.text), c.result) }

type NormalizationCase = { text: String, normal: String }

fn normals() -> List<NormalizationCase> =
  [
    { text: "example://a/b/c/%7Bfoo%7D", normal: "example://a/b/c/%7Bfoo%7D" },
    { text: "eXAMPLE://a/./b/../b/%63/%7bfoo%7d", normal: "example://a/b/c/%7Bfoo%7D" },
    { text: "http://example.com", normal: "http://example.com/" },
    { text: "http://example.com/", normal: "http://example.com/" },
    { text: "http://example.com:/", normal: "http://example.com/" },
    { text: "http://example.com:80/", normal: "http://example.com/" },
    { text: "HTTP://www.EXAMPLE.com/", normal: "http://www.example.com/" },
    { text: "http://example.com:0080", normal: "http://example.com/" },
    { text: "http://example.com:8080", normal: "http://example.com:8080/" },
    { text: "https://example.com:443/a", normal: "https://example.com/a" },
    { text: "https://example.com:80/a", normal: "https://example.com:80/a" },
    { text: "ws://h:80", normal: "ws://h/" },
    { text: "wss://h:443", normal: "wss://h/" },
    { text: "ftp://h:21/x", normal: "ftp://h/x" },
    { text: "foo://h:80", normal: "foo://h:80/" },
    { text: "http://[2001:DB8:0:0:0:0:0:1]/", normal: "http://[2001:db8::1]/" },
    { text: "http://[::FFFF:C000:201]:080/", normal: "http://[::ffff:192.0.2.1]/" },
    {
      text: "http://USER:Pass@Host/%7euser/%2e%2E/x?%7e=%2f#%7E%2f",
      normal: "http://USER:Pass@host/x?~=%2F#~%2F",
    },
    { text: "http://h/a/%2e/b", normal: "http://h/a/b" },
    { text: "http://h/a%2Fb/../c", normal: "http://h/c" },
    { text: "http://h/..", normal: "http://h/" },
    { text: "http://h/a?b/../c#d/./e", normal: "http://h/a?b/../c#d/./e" },
    { text: "mailto:John.Doe@Example.COM", normal: "mailto:John.Doe@Example.COM" },
    { text: "URN:ISBN:0-395-36341-1", normal: "urn:ISBN:0-395-36341-1" },
    { text: "file:///a/../b", normal: "file:///b" },
    { text: "a:/..//b", normal: "a:/.//b" },
    { text: "http://h?", normal: "http://h/?" },
    { text: "http://@h", normal: "http://@h/" },
    { text: "http://h/a+b%20c?d+e%20f", normal: "http://h/a+b%20c?d+e%20f" },
    { text: "http://B\u{FC}cher.example", normal: "http://xn--bcher-kva.example/" },
    { text: "HTTP://b%c3%bccher.EXAMPLE:80/", normal: "http://xn--bcher-kva.example/" },
    { text: "http://XN--Bcher-KVA.example/", normal: "http://xn--bcher-kva.example/" },
    {
      text: "https://u@\u{4F8B}\u{3048}\u{FF0E}jp:8443/%7e",
      normal: "https://u@xn--r8jz45g.jp:8443/~",
    },
  ]

test "`{c.text}` normalizes to `{c.normal}`" for c: NormalizationCase in normals() {
  assert_eq(url_render(url_normalized(parsed_url(c.text))), c.normal);
  assert_eq(url_normalized(parsed_url(c.normal)), parsed_url(c.normal))
}

test "URLs are equal only when their texts are equal, and are equivalent when their normalized forms are equal" {
  assert(parsed_url("http://example.com/") != parsed_url("HTTP://EXAMPLE.COM:80/"));
  assert_eq(
    url_normalized(parsed_url("http://example.com/")),
    url_normalized(parsed_url("HTTP://EXAMPLE.COM:80/")),
  );
  let spellings = [
    "http://b\u{FC}cher.example/",
    "http://b%C3%BCcher.example/",
    "http://xn--bcher-kva.example/",
  ].map(
    parsed_url,
  );
  assert_eq(spellings.map(url_render), [
    "http://b\u{FC}cher.example/",
    "http://b%C3%BCcher.example/",
    "http://xn--bcher-kva.example/",
  ]);
  assert_eq(spellings.map(url_host), spellings.map(|_: Url| Some(Name("xn--bcher-kva.example"))));
  assert_eq(
    spellings.map(url_normalized),
    spellings.map(|_: Url| parsed_url("http://xn--bcher-kva.example/")),
  );
  assert_eq(compare(parsed_url("http://a/"), parsed_url("http://b/")), Less);
  let seen: Map<Url, Int> = Map::new().insert(parsed_url("http://b/"), 2).insert(
    parsed_url("http://a/"),
    1,
  );
  assert_eq(seen.keys().map(url_render), ["http://a/", "http://b/"])
}

test "`url_display_host` shows a host in Unicode when its labels are IDNA `xn--` labels, and shows it as written when they are not" {
  let shown = |text: String| url_display_host(parsed_url(text));
  assert_eq(shown("http://xn--bcher-kva.example/"), Some("b\u{FC}cher.example"));
  assert_eq(shown("http://B\u{FC}CHER.example:80/"), Some("b\u{FC}cher.example"));
  assert_eq(shown("http://%E4%BE%8B%E3%81%88.JP/"), Some("\u{4F8B}\u{3048}.jp"));
  assert_eq(shown("http://xn--fa-hia.de/"), Some("fa\u{DF}.de"));
  assert_eq(shown("http://EXAMPLE.com/"), Some("example.com"));
  assert_eq(shown("http://xn--a.example/"), Some("xn--a.example"));
  assert_eq(shown("http://xn--abc-.example/"), Some("xn--abc-.example"));
  assert_eq(shown("http://192.0.2.1/"), Some("192.0.2.1"));
  assert_eq(shown("http://[2001:DB8::1]/"), Some("[2001:db8::1]"));
  assert_eq(shown("mailto:a@example.com"), None);
  assert_eq(
    url_host_port(url_normalized(parsed_url("http://B\u{FC}cher.example:8080/"))),
    Some("xn--bcher-kva.example:8080"),
  )
}

test "showing a URL hides its password, but `url_render` includes the password" {
  let u = parsed_url("https://alice:s3cret@example.com/x");
  assert_eq(show(u), "https://alice:xxxxx@example.com/x");
  assert_eq(f"{u}", "https://alice:xxxxx@example.com/x");
  assert_eq(url_redacted(u), "https://alice:xxxxx@example.com/x");
  assert_eq(url_render(u), "https://alice:s3cret@example.com/x");
  assert_eq(url_userinfo(u), Some("alice:s3cret"));
  assert_eq(url_redacted(parsed_url("https://alice@example.com/")), "https://alice@example.com/");
  assert_eq(url_redacted(parsed_url("https://alice:@example.com/")), "https://alice:@example.com/");
  assert_eq(url_redacted(parsed_url("https://:pw@example.com/")), "https://:xxxxx@example.com/");
  assert_eq(url_redacted(parsed_url("https://a:b:c@example.com/")), "https://a:xxxxx@example.com/")
}

test "`url_path_segments` decodes each path segment separately, so an encoded slash does not split a segment" {
  let decoded = |text: String| url_path_segments(parsed_url(text));
  assert_eq(decoded("http://h/a/b"), Some(["a", "b"]));
  assert_eq(decoded("http://h/a%2Fb/c"), Some(["a/b", "c"]));
  assert_eq(decoded("http://h/a/"), Some(["a", ""]));
  assert_eq(decoded("http://h/"), Some([""]));
  assert_eq(decoded("http://h"), Some([]));
  assert_eq(decoded("http://h//a"), Some(["", "a"]));
  assert_eq(decoded("mailto:a@b/c%20d"), Some(["a@b", "c d"]));
  assert_eq(decoded("http://h/%C3%A9"), Some(["\u{E9}"]));
  assert_eq(decoded("http://h/%FF"), None)
}

test "`url_port` returns the port written in a URL if it is a valid number, and `url_port_or_default` returns the scheme's default port when none is written" {
  assert_eq(url_port(parsed_url("http://h:8080/")), Some(8080));
  assert_eq(url_port(parsed_url("http://h:0/")), Some(0));
  assert_eq(url_port(parsed_url("http://h:65535/")), Some(65535));
  assert_eq(url_port(parsed_url("http://h:000000080/")), Some(80));
  assert_eq(url_port(parsed_url("http://h:/")), None);
  assert_eq(url_port(parsed_url("http://h/")), None);
  assert_eq(url_port_or_default(parsed_url("http://h/")), Some(80));
  assert_eq(url_port_or_default(parsed_url("HTTPS://h/")), Some(443));
  assert_eq(url_port_or_default(parsed_url("ws://h")), Some(80));
  assert_eq(url_port_or_default(parsed_url("wss://h")), Some(443));
  assert_eq(url_port_or_default(parsed_url("ftp://h")), Some(21));
  assert_eq(url_port_or_default(parsed_url("gopher://h")), None);
  assert_eq(url_port_or_default(parsed_url("gopher://h:70")), Some(70));
  assert_eq(url_host_port(parsed_url("http://u@H:080/")), Some("H:080"));
  assert_eq(url_host_port(parsed_url("http://[::1]/")), Some("[::1]"));
  assert_eq(url_host_port(parsed_url("mailto:a@b")), None)
}

test "`url_origin` is the scheme, host and port of a URL, and two URLs with the same scheme, host and port have equal origins" {
  assert_eq(
    url_origin(parsed_url("https://Example.com/a?b")),
    Some({ scheme: "https", host: Name("example.com"), port: 443 }),
  );
  assert_eq(
    url_origin(parsed_url("HTTPS://example.com:443/x")),
    url_origin(parsed_url("https://EXAMPLE.com/y")),
  );
  assert(
    url_origin(parsed_url("https://example.com/")) != url_origin(parsed_url("http://example.com/")),
  );
  assert(
    url_origin(parsed_url("https://example.com/"))
      != url_origin(parsed_url("https://example.com:8443/")),
  );
  assert_eq(url_origin(parsed_url("file:///etc/hosts")), None);
  assert_eq(url_origin(parsed_url("gopher://h/")), None);
  assert_eq(url_origin(parsed_url("mailto:a@b")), None)
}

test "query parameters of a URL can be read, set, added and removed, and keep their order" {
  let u = parsed_url("https://example.com/search?q=two%20words&page=2&q=again#top");
  assert_eq(url_param(u, "q"), Some("two words"));
  assert_eq(url_params(u, "q"), ["two words", "again"]);
  assert_eq(url_param(u, "missing"), None);
  assert_eq(
    url_query_pairs(u),
    Some([
      { name: "q", value: "two words" },
      { name: "page", value: "2" },
      { name: "q", value: "again" },
    ]),
  );
  let rendered = |changed: Option<Url>| match changed { Some(c) -> url_render(c), None -> "" };
  assert_eq(
    rendered(url_set_param(u, "page", "3")),
    "https://example.com/search?q=two+words&page=3&q=again#top",
  );
  assert_eq(rendered(url_set_param(u, "q", "one")), "https://example.com/search?q=one&page=2#top");
  assert_eq(
    rendered(url_set_param(u, "lang", "en")),
    "https://example.com/search?q=two+words&page=2&q=again&lang=en#top",
  );
  assert_eq(
    rendered(url_add_param(u, "q", "a&b=c")),
    "https://example.com/search?q=two+words&page=2&q=again&q=a%26b%3Dc#top",
  );
  assert_eq(rendered(url_remove_param(u, "q")), "https://example.com/search?page=2#top");
  assert_eq(
    rendered(url_remove_param(parsed_url("https://example.com/?a=1#f"), "a")),
    "https://example.com/#f",
  );
  assert_eq(
    rendered(url_add_param(parsed_url("mailto:a@b"), "subject", "hi there")),
    "mailto:a@b?subject=hi+there",
  );
  assert_eq(url_query_pairs(parsed_url("http://h/")), Some([]));
  assert_eq(url_query_pairs(parsed_url("http://h/?")), Some([]));
  assert_eq(url_query_pairs(parsed_url("http://h/?a=%FF")), None);
  assert_eq(url_set_param(parsed_url("http://h/?a=%FF"), "a", "1"), None);
  assert_eq(url_params(parsed_url("http://h/?a=%FF"), "a"), [])
}

test "`url_join_path` appends segments to a URL's existing path, and fails when a segment is `..`, `.` or empty" {
  let joined = |text: String, segments: List<String>|
    match url_join_path(parsed_url(text), segments) { Some(u) -> url_render(u), None -> "refused" };
  assert_eq(joined("https://h/api", ["users", "42"]), "https://h/api/users/42");
  assert_eq(joined("https://h/api/", ["users"]), "https://h/api/users");
  assert_eq(joined("https://h", ["a b", "c/d"]), "https://h/a%20b/c%2Fd");
  assert_eq(joined("https://h/x?q#f", ["y"]), "https://h/x/y");
  assert_eq(joined("https://h/x", ["..", "y"]), "refused");
  assert_eq(joined("https://h/x", ["."]), "refused");
  assert_eq(joined("https://h/x", [""]), "refused");
  assert_eq(joined("https://h/x", ["%2e%2e", "..."]), "https://h/x/%252e%252e/...");
  assert_eq(joined("https://h/x", []), "https://h/x")
}

test "`literal` returns the URL for valid text, or an error with the offset of the character that makes the text invalid" {
  assert_eq(literal("https://example.com/a?b#c"), Ok(parsed_url("https://example.com/a?b#c")));
  assert_eq(
    literal("https://exa mple.com/"),
    Err({
      message: "a URL cannot contain this character unless it is written as a `%` escape",
      offset: 11,
    }),
  );
  assert_eq(
    literal("example.com"),
    Err({ message: "a URL must start with a scheme followed by a `:`", offset: 0 }),
  );
  assert_eq(
    literal("http://[::1%25eth0]/"),
    Err({
      message: "the host is not a valid IP address: a zone is no part of an address",
      offset: 11,
    }),
  )
}

test "`url_encode` leaves unreserved characters as they are and percent-encodes all others with upper-case hex digits" {
  assert_eq(url_encode("a-b_c.d~e"), "a-b_c.d~e");
  assert_eq(url_encode("a b"), "a%20b");
  assert_eq(url_encode("/?"), "%2F%3F");
  assert_eq(url_encode("é"), "%C3%A9");
  assert_eq(url_decode("%C3%A9"), Some("é"));
  assert_eq(url_decode("a%2fb"), Some("a/b"))
}

test "form encoding writes a space as `+` and otherwise encodes the same as percent-encoding" {
  assert_eq(form_encode("a b+c"), "a+b%2Bc");
  assert_eq(form_decode("a+b%2Bc"), Some("a b+c"));
  assert_eq(form_encode("a b"), "a+b");
  assert_eq(url_encode("a b"), "a%20b")
}

test "`url_decode` rejects a percent sign not followed by two hex digits, and rejects bytes that are not valid UTF-8" {
  assert_eq(url_decode("%2"), None);
  assert_eq(url_decode("%zz"), None);
  assert_eq(url_decode("%"), None);
  assert_eq(url_decode("%FF"), None);
}

test "a query string parses to pairs and builds back to itself" {
  assert_eq(
    query_parse("a=1&b=two%20words&c=&d"),
    Some([
      { name: "a", value: "1" },
      { name: "b", value: "two words" },
      { name: "c", value: "" },
      { name: "d", value: "" },
    ]),
  );
  assert_eq(query_parse(""), Some([]));
  assert_eq(query_parse("a=1&&b=2"), Some([{ name: "a", value: "1" }, { name: "b", value: "2" }]));
  assert_eq(
    query_build([{ name: "a", value: "1" }, { name: "b", value: "two words" }]),
    "a=1&b=two+words",
  );
  assert_eq(query_parse("a=%zz"), None)
}

test "pairs are read, set and removed by name, leaving the other pairs in place" {
  let pairs = [{ name: "a", value: "1" }, { name: "b", value: "2" }, { name: "a", value: "3" }];
  assert_eq(query_get(pairs, "a"), Some("1"));
  assert_eq(query_get(pairs, "c"), None);
  assert_eq(query_set(pairs, "a", "9"), [{ name: "a", value: "9" }, { name: "b", value: "2" }]);
  assert_eq(query_set(pairs, "c", "9"), pairs.push({ name: "c", value: "9" }));
  assert_eq(query_remove(pairs, "a"), [{ name: "b", value: "2" }]);
  assert_eq(query_remove(pairs, "c"), pairs)
}
