      result: "rejected at 7: the host is not a valid domain name: a label contains a character that a domain name may not contain",
    },
    {
      text: "http://evil.com\u{FF0F}@example.com/",
      result: "rejected at 15: outside a host name a URL contains only ASCII characters: write this character as a `%` escape",
