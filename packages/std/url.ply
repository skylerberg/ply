      result: "rejected at 19: a URL cannot contain this character unless it is written as a `%` escape",
    },
    {
      text: "http:\\\\evil.com/",
      result: "rejected at 5: a URL cannot contain this character unless it is written as a `%` escape",
    },
    {
      text: "http:/\\evil.com/",
      result: "rejected at 6: a URL cannot contain this character unless it is written as a `%` escape",
    },
    { text: "http:///evil.com/", result: "none, path /evil.com/" },
    { text: "http:evil.com", result: "none, path evil.com" },
    { text: "http:/evil.com", result: "none, path /evil.com" },
    { text: "http://example.com?@evil.com/", result: "name example.com, path " },
    { text: "http://example.com/@evil.com/", result: "name example.com, path /@evil.com/" },
    {
      text: "http://example.com&@evil.com/",
      result: "name evil.com, userinfo example.com&, path /",
    },
    {
      text: "http://example.com;@evil.com/",
      result: "name evil.com, userinfo example.com;, path /",
    },
    {
      text: "http://example.com%2F@evil.com/",
      result: "name evil.com, userinfo example.com%2F, path /",
    },
    {
      text: "http://example.com%23@evil.com/",
      result: "name evil.com, userinfo example.com%23, path /",
    },
    {
      text: "http://evil.com%2F@example.com/",
      result: "name example.com, userinfo evil.com%2F, path /",
    },
    {
      text: "http://127.0.0.1%2F@evil.example/",
      result: "name evil.example, userinfo 127.0.0.1%2F, path /",
    },
    {
      text: "http://0x7f.1/",
      result: "rejected at 7: a host that ends in a number must be an IPv4 address of four decimal numbers",
    },
    {
      text: "http://0177.0.0.1/",
      result: "rejected at 7: the host is not a valid IP address: a number is written with no leading zero",
    },
    {
      text: "http://2130706433/",
      result: "rejected at 7: the host is not a valid IP address: an octet is at most 255",
    },
    { text: "http://127.0.0.1.nip.io/", result: "name 127.0.0.1.nip.io, path /" },
    {
      text: "http://127.0.0.1:80\\@evil.com/",
      result: "rejected at 19: a URL cannot contain this character unless it is written as a `%` escape",
    },
    {
      text: "http://[::1]@evil.com/",
      result: "rejected at 7: this character cannot appear here unless it is written as a `%` escape",
    },
    { text: "http://evil.com@[::1]/", result: "v6 ::1, userinfo evil.com, path /" },
    {
      text: "http://[::1]:80@evil.com/",
      result: "rejected at 7: this character cannot appear here unless it is written as a `%` escape",
    },
    {
      text: "http://example.com\t.evil.com/",
      result: "rejected at 18: a URL cannot contain this character unless it is written as a `%` escape",
