test "`{c.text}` parses into the expected scheme, userinfo, host, port, path, query and fragment, and renders back to the same text" for c: Anatomy in anatomies(
  ) {
  let u = parsed_url(c.text);
  assert_eq(url_scheme(u), c.scheme);
  assert_eq(url_userinfo(u), c.userinfo);
  assert_eq(host_text(url_host(u)), c.host);
  assert_eq(url_port(u), c.port);
  assert_eq(url_path(u), c.path);
  assert_eq(url_query(u), c.query);
  assert_eq(url_fragment(u), c.fragment);
  assert_eq(url_render(u), c.text)
}

type ErrorCase = { text: String, at: Int, reason: ErrorKind }

fn url_error_cases() -> List<ErrorCase> =
  [
    { text: "", at: 0, reason: NoScheme },
    { text: "example.com/path", at: 0, reason: NoScheme },
    { text: "//example.com/path", at: 0, reason: NoScheme },
    { text: "/path", at: 0, reason: NoScheme },
    { text: "?q", at: 0, reason: NoScheme },
    { text: "1http://a/", at: 0, reason: BadScheme },
    { text: "://a/", at: 0, reason: BadScheme },
    { text: "ht_tp://a/", at: 0, reason: BadScheme },
    { text: "ht%74p://a/", at: 0, reason: BadScheme },
    { text: "http://a b/", at: 8, reason: Forbidden },
    { text: " http://a/", at: 0, reason: Forbidden },
    { text: "http://a/ ", at: 9, reason: Forbidden },
    { text: "http://a/\tb", at: 9, reason: Forbidden },
    { text: "ht\ttp://a/", at: 2, reason: Forbidden },
    { text: "http://a/\nb", at: 9, reason: Forbidden },
    { text: "http://a/b\r\n", at: 10, reason: Forbidden },
    { text: "http://a\\b/", at: 8, reason: Forbidden },
    { text: "http:\\\\a/", at: 5, reason: Forbidden },
    { text: "http://a/<b>", at: 9, reason: Forbidden },
    { text: "http://a/{b}", at: 9, reason: Forbidden },
    { text: "http://a/b|c", at: 10, reason: Forbidden },
    { text: "http://a/b^c", at: 10, reason: Forbidden },
    { text: "http://a/\"b\"", at: 9, reason: Forbidden },
    { text: "http://a/b`c", at: 10, reason: Forbidden },
    { text: "http://a/\0", at: 9, reason: Forbidden },
    { text: "http://a/\u{7F}", at: 9, reason: Forbidden },
    { text: "http://a/\u{E9}", at: 9, reason: NotAscii },
    { text: "http://b\u{FC}cher.example/\u{E9}", at: 22, reason: NotAscii },
    { text: "http://\u{E9}@b\u{FC}cher.example/", at: 7, reason: NotAscii },
    { text: "http://b\u{FC}cher.example:\u{661}/", at: 22, reason: NotAscii },
    { text: "http://[\u{E9}]/", at: 8, reason: NotAscii },
    { text: "\u{E9}://a/", at: 0, reason: NotAscii },
    { text: "http://b\u{FC}cher.example:x/", at: 22, reason: BadPort },
    {
      text: "http://\u{FFFD}.example/",
      at: 7,
      reason: Idna([{ label: 0, reason: idna::Disallowed }]),
    },
    {
      text: "http://a.\u{200D}b.example/",
      at: 7,
      reason: Idna([{ label: 1, reason: idna::Joiner }]),
    },
    {
      text: "http://\u{5D0}a.b\u{FC}cher/",
      at: 7,
      reason: Idna([{ label: 0, reason: idna::Bidi }]),
    },
    {
      text: "http://xn--a.b\u{FC}cher/",
      at: 7,
      reason: Idna([{ label: 0, reason: idna::Disallowed }]),
    },
    { text: "http://\u{AD}/", at: 7, reason: Idna([{ label: 0, reason: idna::EmptyLabel }]) },
    {
      text: "http://a.b\u{FF0F}c.\u{E9}/",
      at: 7,
      reason: Idna([{ label: 1, reason: idna::Disallowed }]),
    },
    {
      text: "http://\u{FF05}41.\u{E9}/",
      at: 7,
      reason: Idna([{ label: 0, reason: idna::Disallowed }]),
    },
    { text: "http://\u{FF11}\u{FF12}\u{FF17}.0.0.1/", at: 7, reason: NumericHost },
    { text: "http://\u{E9}.\u{FF10}x7f/", at: 7, reason: NumericHost },
    { text: "http://\u{3002}/", at: 7, reason: NumericHost },
    { text: "http://b%C3%BCcher.ex%61mple/", at: 21, reason: EncodedHost },
    { text: "http://b%FCcher.example/", at: 8, reason: EncodedHost },
    { text: "http://b\u{FC}%C3.example/", at: 9, reason: EncodedHost },
    { text: "http://b\u{FC}cher[.example/", at: 13, reason: UnexpectedCharacter },
    { text: "http://a/%", at: 9, reason: BadEscape },
    { text: "http://a/%2", at: 9, reason: BadEscape },
    { text: "http://a/%zz", at: 9, reason: BadEscape },
    { text: "http://a/%2%41", at: 9, reason: BadEscape },
    { text: "http://a/?q=%G0", at: 12, reason: BadEscape },
    { text: "http://a/#%", at: 10, reason: BadEscape },
    { text: "http://a@b@c/", at: 10, reason: SecondAt },
    { text: "http://a:b@c:d@e/", at: 14, reason: SecondAt },
    { text: "http://user@@host/", at: 12, reason: SecondAt },
    { text: "http://[::1/", at: 7, reason: OpenBracket },
    { text: "http://[::1", at: 7, reason: OpenBracket },
    { text: "http://[::1]x/", at: 12, reason: UnexpectedCharacter },
    { text: "http://[v1.fe80]/", at: 8, reason: FutureAddress },
    { text: "http://[V7.a]/", at: 8, reason: FutureAddress },
    { text: "http://[::1%25eth0]/", at: 11, reason: Address(ip::Zone) },
    { text: "http://[fe80::1%eth0]/", at: 15, reason: BadEscape },
    { text: "http://[1.2.3.4]/", at: 15, reason: Address(ip::FewGroups) },
    { text: "http://[::g]/", at: 10, reason: Address(ip::NoGroup) },
    { text: "http://[]/", at: 8, reason: Address(ip::Empty) },
    { text: "http://[::ffff:010.0.0.1]/", at: 15, reason: Address(ip::LeadingZero) },
    { text: "http://[1:2:3:4:5:6:7:8:9]/", at: 24, reason: Address(ip::ManyGroups) },
    { text: "http://a[b]/", at: 8, reason: UnexpectedCharacter },
    { text: "http://a]/", at: 8, reason: UnexpectedCharacter },
    { text: "http://127.1/", at: 12, reason: Address(ip::FewOctets) },
    { text: "http://127.0.0.1./", at: 16, reason: Address(ip::ManyOctets) },
    { text: "http://010.0.0.1/", at: 7, reason: Address(ip::LeadingZero) },
    { text: "http://0177.0.0.1/", at: 7, reason: Address(ip::LeadingZero) },
    { text: "http://2130706433/", at: 7, reason: Address(ip::OctetRange) },
    { text: "http://1.2.3.256/", at: 13, reason: Address(ip::OctetRange) },
    { text: "http://1.2.3/", at: 12, reason: Address(ip::FewOctets) },
    { text: "http://1.2.3.4.5/", at: 14, reason: Address(ip::ManyOctets) },
    { text: "http://0x7f.0.0.1/", at: 7, reason: NumericHost },
    { text: "http://0x7f000001/", at: 7, reason: NumericHost },
    { text: "http://0X7F.1/", at: 7, reason: NumericHost },
    { text: "http://example.0x10/", at: 7, reason: NumericHost },
    { text: "http://example.123/", at: 7, reason: NumericHost },
    { text: "http://example.123./", at: 7, reason: NumericHost },
    { text: "http://a.0x/", at: 7, reason: NumericHost },
    { text: "http://1.2.3.04a.5/", at: 7, reason: NumericHost },
    { text: "http://ex%61mple.com/", at: 9, reason: EncodedHost },
    { text: "http://%31%32%37.0.0.1/", at: 7, reason: EncodedHost },
    { text: "http://example%2Ecom/", at: 14, reason: EncodedHost },
    { text: "http://a:b/", at: 9, reason: BadPort },
    { text: "http://a:80:443/", at: 11, reason: BadPort },
    { text: "http://a:-1/", at: 9, reason: BadPort },
    { text: "http://a:+80/", at: 9, reason: BadPort },
    { text: "http://a:8%30/", at: 10, reason: BadPort },
    { text: "http://a:65536/", at: 9, reason: PortRange },
    { text: "http://a:99999999999999999999/", at: 9, reason: PortRange },
    { text: "http://[::1]:65536/", at: 13, reason: PortRange },
    { text: "http://a/b[c]", at: 10, reason: UnexpectedCharacter },
    { text: "http://a/?q[]=1", at: 11, reason: UnexpectedCharacter },
    { text: "http://a/#f#g", at: 11, reason: UnexpectedCharacter },
    { text: "http://a/#[", at: 10, reason: UnexpectedCharacter },
    { text: "http://u[@a/", at: 8, reason: UnexpectedCharacter },
    { text: "mailto:a[b]", at: 8, reason: UnexpectedCharacter },
  ]

fn escape_controls(text: String) -> String =
  text.replace("\n", "\\n").replace("\t", "\\t").replace("\r", "\\r").replace("\0", "\\0")

test "`url_parse` fails on `{escape_controls(c.text)}` with the expected position and reason" for c: ErrorCase in url_error_cases(
  ) { assert_eq(url_parse(c.text), Err({ at: c.at, reason: c.reason })) }

fn reference_error_cases() -> List<ErrorCase> =
  [
    { text: "1a:b", at: 0, reason: BadScheme },
    { text: ":b", at: 0, reason: BadScheme },
    { text: "a b", at: 1, reason: Forbidden },
    { text: "a\\b", at: 1, reason: Forbidden },
    { text: "\\\\evil.example/x", at: 0, reason: Forbidden },
    { text: "/\\evil.example/x", at: 1, reason: Forbidden },
    { text: "//a@b@c", at: 5, reason: SecondAt },
    { text: "//127.1/x", at: 7, reason: Address(ip::FewOctets) },
    { text: "/a%", at: 2, reason: BadEscape },
    { text: "?a[b]", at: 2, reason: UnexpectedCharacter },
    { text: "\u{E9}", at: 0, reason: NotAscii },
  ]

test "`reference_parse` fails on `{c.text}` with the expected position and reason" for c: ErrorCase in reference_error_cases(
  ) { assert_eq(reference_parse(c.text), Err({ at: c.at, reason: c.reason })) }

test "a relative reference parses into its parts and renders back to the same text, but `reference_url` returns no URL for it" {
  let texts = [
    "",
    "g",
    "./g",
    "../g",
    "/g",
    "//g",
    "//g/h?i#j",
    "?y",
    "#s",
    "g;x?y#s",
    "./a:b",
    "a/b:c",
    "//u@h:1",
  ];
  assert(texts.all(|text: String| reference_parse(text) != Err({ at: 0, reason: NoScheme })));
  assert(texts.all(|text: String| reference_render(parsed_reference(text)) == text));
  assert(texts.all(|text: String| reference_url(parsed_reference(text)) == None));
  assert_eq(reference_url(parsed_reference("a:b")), Some(parsed_url("a:b")));
  assert_eq(reference_of(parsed_url("http://a/b")), parsed_reference("http://a/b"));
  assert_eq(show(parsed_reference("//u:secret@h/p")), "//u:xxxxx@h/p")
}

type ConfusionCase = { text: String, result: String }

fn describe_parse(text: String) -> String / {abort.raise} =
  match url_parse(text) {
    Ok(u) ->
      host_text(url_host(u))
        ++ (match url_userinfo(u) { Some(info) -> ", userinfo " ++ info, None -> "" })
        ++ ", path "
        ++ url_path(u),
    Err(rejected) ->
      "rejected at " ++ rejected.at.to_string() ++ ": " ++ url_reason(rejected.reason),
  }

fn confusions() -> List<ConfusionCase> =
  [
    { text: "http://a@b@c/", result: "rejected at 10: an authority can contain only one `@`" },
    {
      text: "http://a\\@b/",
      result: "rejected at 8: a URL cannot contain this character unless it is written as a `%` escape",
    },
    {
      text: "http://127.1/",
      result: "rejected at 12: the host is not a valid IP address: an IPv4 address is four octets",
    },
    { text: "http://[::ffff:127.0.0.1]/", result: "v6 ::ffff:127.0.0.1, path /" },
    { text: "http://example.com#@evil.com/", result: "name example.com, path " },
    {
      text: "http://user@evil.com@example.com/",
      result: "rejected at 20: an authority can contain only one `@`",
    },
    {
      text: "http://example.com:80@evil.com/",
      result: "name evil.com, userinfo example.com:80, path /",
    },
    {
      text: "http://example.com\\@evil.com/",
      result: "rejected at 18: a URL cannot contain this character unless it is written as a `%` escape",
    },
    {
      text: "http://example.com\\.evil.com/",
      result: "rejected at 18: a URL cannot contain this character unless it is written as a `%` escape",
    },
    {
