//! Implements the client side of SASL (RFC 4422) for PLAIN, LOGIN, SCRAM-SHA-256, OAUTHBEARER and
//! XOAUTH2.
//!
//! A mechanism is an exchange of byte strings that a protocol wraps in its own framing: SMTP's
//! `AUTH` uses lines of base64, and postgres uses its own messages. `begin` returns the client's
//! first message, and `respond` returns the client's reply to each server message.
//! `is_authenticated` reports whether the server may now treat the exchange as a success. Under
//! SCRAM that is true only after the server has also proved that it knows the password. Nothing
//! here reads a socket, a clock or the host's entropy: the nonce that SCRAM needs and the largest
//! iteration count a server may request are arguments.
//!
//! A `Credential` is built here and never written out. `show` prints its user and `***` in place of
//! the secret, and `show` of an `Exchange` or a `Response` prints nothing of their contents. A
//! password or token is a `Secret<Bytes>` from the moment it is passed in, as `std.config` returns
//! one, and never a plain value. SCRAM derives its keys from the password in the runtime without
//! revealing it, and the mechanisms that send the credential itself put it into their messages as a
//! secret. So every `Response` is secret, and `secret_bytes` is the only way to read it: a protocol
//! frames those bytes and writes them to a connection with `std.net`'s `send_secret`, as SMTP does
//! in base64 on an `AUTH` line. `reveals` reports whether a mechanism sends the credential itself;
//! a protocol should allow that only on a connection that no one else can read. A name and a
//! password are used as their UTF-8 bytes. SASLprep (RFC 4013) is not applied, so only ASCII names
//! and passwords are certain to match what a server stored.
//!
//! `begin` and `respond` use no channel binding. A protocol that has a channel to bind builds the
//! SCRAM messages itself with `scram_first`, `scram_final` and a `ChannelBinding`, as postgres does
//! to bind a TLS connection to the server's certificate under SCRAM-SHA-256-PLUS.

import std.base64 (base64_decode, base64_encode)
import std.bytes
import std.hash (hmac_sha256, pbkdf2_sha256, sha256, tags_match)
import std.laws (round_trip)
import std.list
import std.show (show)
import std.string
import std.gen

/// One way a client proves who it is.
pub type Mechanism =
  /// RFC 4616: the name and the password, sent as they are.
  | Plain
  /// The name and then the password, each sent when the server prompts for it. Servers older
  /// than PLAIN accept it.
  | Login
  /// RFC 7677: a proof of the password, never the password itself, and the server's proof in
  /// return.
  | ScramSha256
  /// RFC 7628: an OAuth 2.0 bearer token.
  | OAuthBearer
  /// The bearer-token mechanism mail providers adopted before RFC 7628.
  | XOAuth2

/// Every mechanism this module supports: first the one that never sends the credential, then the
/// token mechanisms, then those that send the password as it is.
pub const mechanisms: List<Mechanism> = [ScramSha256, OAuthBearer, XOAuth2, Plain, Login]

/// The registered name a server uses to offer a mechanism.
pub fn mechanism_name(m: Mechanism) -> String =
  match m {
    Plain -> "PLAIN",
    Login -> "LOGIN",
    ScramSha256 -> "SCRAM-SHA-256",
    OAuthBearer -> "OAUTHBEARER",
    XOAuth2 -> "XOAUTH2",
  }

/// Returns the mechanism whose registered name equals `offered`, ignoring case, or `None` if this
/// module does not support it.
pub fn mechanism_named(offered: String) -> Option<Mechanism> =
  mechanisms.find(|m: Mechanism| mechanism_name(m).eq_ignore_ascii_case(offered))

/// Whether a mechanism sends the credential itself, so that anyone who reads the connection learns
/// it. True for every mechanism but SCRAM.
pub fn reveals(m: Mechanism) -> Bool = m != ScramSha256

/// Why an exchange cannot continue.
pub type Error =
  /// A name, a password or a token no mechanism can send: empty, or containing a control
  /// character.
  | BadCredential
  /// The credential is not the kind the mechanism takes: a token under PLAIN, a password under
  /// OAUTHBEARER.
  | WrongCredential
  /// A nonce that is empty or contains a comma or a character outside printable ASCII.
  | BadNonce
  /// The server sent a message the mechanism cannot reply to: a SCRAM message that cannot be read
  /// or whose nonce does not start with the client's, or anything after the last reply.
  | BadChallenge
  /// The SCRAM server requested this many iterations, more than the exchange's limit.
  | TooManyIterations(Int)
  /// The server's SCRAM proof does not match the password, so the server does not know it.
  | BadServerProof

/// The error this module raises.
pub effect sasl {
  /// No mechanism can send the credential, or the exchange cannot continue.
  raise fail(reason: Error)
}

/// What a client proves its identity with: a name and a password, or a name and a bearer token.
/// The password and the token are secret.
pub opaque type Credential = | Password(String, Secret<Bytes>) | Token(String, Secret<Bytes>)

show for Credential by credential_text

fn credential_text(c: Credential) -> String =
  match c {
    Password(user, _) -> "password(" ++ show(user) ++ ", ****)",
    Token(user, _) -> "bearer(" ++ show(user) ++ ", ****)",
  }

/// Returns a password `Credential` for `user`, with the password as a secret. Raises
/// `sasl.fail(BadCredential)` if `user` is empty or contains a control character, or if the
/// password is empty. The password's bytes are not otherwise checked, so the server, not this
/// function, rejects a password that contains a NUL byte, which PLAIN cannot send.
pub fn password(user: String, secret: Secret<Bytes>) -> Credential / {sasl.fail} =
  if !is_name(user) || secret.is_empty() { sasl.fail(BadCredential) }
  else { Password(user, secret) }

/// The name `user` with a secret OAuth 2.0 bearer token (RFC 6750) issued to it. Raises
/// `sasl.fail(BadCredential)` for an empty name or token, or a control character in the name. The
/// token's contents are not read, so one that is not RFC 6750's printable ASCII is rejected by the
/// server rather than here.
pub fn bearer(user: String, token: Secret<Bytes>) -> Credential / {sasl.fail} =
  if !is_name(user) || token.is_empty() { sasl.fail(BadCredential) } else { Token(user, token) }

fn is_name(user: String) -> Bool =
  user != "" && user.chars().all(|c: Char| Int::of_char(c) >= 32 && Int::of_char(c) != 127)

/// The name a credential is for.
pub fn user_of(c: Credential) -> String =
  match c { Password(user, _) -> user, Token(user, _) -> user }

/// Whether a credential is the kind a mechanism takes: a password for PLAIN, LOGIN and SCRAM, a
/// token for OAUTHBEARER and XOAUTH2.
pub fn supports(c: Credential, m: Mechanism) -> Bool =
  match c {
    Password(_, _) -> m == Plain || m == Login || m == ScramSha256,
    Token(_, _) -> m == OAuthBearer || m == XOAuth2,
  }

/// What an exchange starts with besides the credential.
pub type Options = new {
  /// SCRAM's client nonce: printable ASCII with no comma, fresh for each exchange.
  nonce: String,
  /// The most iterations of its hash a SCRAM server may request.
  max_iterations: Int,
  /// The host the connection was made to, which OAUTHBEARER sends to the server.
  host: String,
  /// The port it was made to.
  port: Int,
}

/// The current state of an exchange. It shows as `Exchange(****)`, whatever it contains.
pub opaque type Exchange =
  | Finished(Bool)
  | LoginName(String, Secret<Bytes>)
  | LoginSecret(Secret<Bytes>)
  | ScramFirst(Secret<Bytes>, String, Int)
  | ScramFinal(Bytes)
  | BearerSent(Mechanism)

show for Exchange by exchange_text

fn exchange_text(x: Exchange) -> String = "Exchange(****)"

/// A message the client sends in an exchange. It is secret whether or not it contains the
/// credential, so a protocol sends every one the same way. It shows as `Response(****)`.
pub opaque type Response = | Response(Secret<Bytes>)

show for Response by response_text

fn response_text(r: Response) -> String = "Response(****)"

/// A response's bytes, as a secret, for the protocol to frame and write with `std.net`'s
/// `send_secret`.
pub fn secret_bytes(r: Response) -> Secret<Bytes> = match r { Response(bytes) -> bytes }

fn plain_response(bytes: Bytes) -> Response = Response(Secret::of_bytes(bytes))

/// A started exchange: its state, and the client's first message, sent before the server sends
/// anything. `None` under a mechanism where the server speaks first.
pub type ExchangeStart = { exchange: Exchange, first: Option<Response> }

/// An exchange one step further: its state, and the client's reply.
pub type ExchangeStep = { exchange: Exchange, response: Response }

/// The exchange that proves `c` under `m`. Raises `sasl.fail`: `WrongCredential` for a credential
/// the mechanism does not take, `BadNonce` for a nonce SCRAM cannot send.
pub fn begin(m: Mechanism, c: Credential, s: Options) -> ExchangeStart / {sasl.fail} =
  match c {
    Password(user, secret) -> match m {
      Plain -> { exchange: Finished(true), first: Some(Response(plain_message(user, secret))) },
      Login -> { exchange: LoginName(user, secret), first: None },
      ScramSha256 -> begin_scram(user, secret, s),
      _ -> sasl.fail(WrongCredential),
    },
    Token(user, token) -> if m != OAuthBearer && m != XOAuth2 { sasl.fail(WrongCredential) }
    else { { exchange: BearerSent(m), first: Some(Response(bearer_message(m, user, token, s))) } },
  }

fn begin_scram(user: String, secret: Secret<Bytes>, s: Options) -> ExchangeStart / {sasl.fail} =
  if !is_nonce(s.nonce) { sasl.fail(BadNonce) } else {
    let bare = scram_first_bare(user, s.nonce);
    {
      exchange: ScramFirst(secret, bare, s.max_iterations),
      first: Some(plain_response(Bytes::of_string(gs2_header(Unbound) ++ bare))),
    }
  }

/// The client's reply to `challenge`. Raises `sasl.fail`: `BadChallenge` when the mechanism cannot
/// reply to it, `TooManyIterations` for a SCRAM server requesting more iterations than the
/// exchange allows, `BadServerProof` for a SCRAM server whose proof does not match the password.
///
/// A token mechanism's server sends a message only to explain why it is about to reject the
/// client. The reply is then the dummy response the mechanism requires, and the exchange proves
/// nothing.
pub fn respond(x: Exchange, challenge: Bytes) -> ExchangeStep / {sasl.fail, abort.raise} =
  match x {
    Finished(_) -> sasl.fail(BadChallenge),
    LoginName(user, secret) ->
      { exchange: LoginSecret(secret), response: plain_response(Bytes::of_string(user)) },
    LoginSecret(secret) -> { exchange: Finished(true), response: Response(secret) },
    ScramFirst(secret, bare, most) -> if !challenge.is_utf8() { sasl.fail(BadChallenge) } else {
      let secret_bytes = String::of_bytes(challenge);
      match scram_challenge(secret_bytes) {
        None -> sasl.fail(BadChallenge),
        Some(parsed_challenge) -> if parsed_challenge.iterations > most {
          sasl.fail(TooManyIterations(parsed_challenge.iterations))
        } else {
          match scram_final(Unbound, secret, bare, secret_bytes, parsed_challenge) {
            None -> sasl.fail(BadChallenge),
            Some(proof) ->
              {
                exchange: ScramFinal(proof.expected),
                response: plain_response(Bytes::of_string(proof.reply)),
              },
          }
        },
      }
    },
    ScramFinal(expected) -> if challenge.is_utf8()
        && scram_verify(String::of_bytes(challenge), expected) {
      { exchange: Finished(true), response: plain_response(b"") }
    } else { sasl.fail(BadServerProof) },
    BearerSent(m) ->
      {
        exchange: Finished(false),
        response: plain_response(if m == OAuthBearer { b"\x01" } else { b"" }),
      },
  }

/// Returns whether the exchange has authenticated the client. A client must not treat the server's
/// success message as final while this returns `false`, because the mechanism's required checks
/// have not finished.
pub fn is_authenticated(x: Exchange) -> Bool =
  match x { Finished(ok) -> ok, BearerSent(_) -> true, _ -> false }

fn is_nonce(nonce: String) -> Bool =
  nonce != ""
    && nonce.chars().all(|c: Char| Int::of_char(c) > 32 && Int::of_char(c) < 127 && c != ',')

fn between(before: Bytes, secret: Secret<Bytes>, after: Bytes) -> Secret<Bytes> =
  Secret::of_bytes(before).concat(secret).concat(Secret::of_bytes(after))

fn plain_message(user: String, secret: Secret<Bytes>) -> Secret<Bytes> =
  between(Bytes::concat_all([b"\x00", Bytes::of_string(user), b"\x00"]), secret, b"")

fn bearer_message(m: Mechanism, user: String, token: Secret<Bytes>, s: Options) -> Secret<Bytes> = {
  let named = if m == OAuthBearer {
    "n,a=" ++ scram_name(user) ++ ",\u{1}host=" ++ s.host ++ "\u{1}port=" ++ s.port.to_string()
      ++ "\u{1}auth=Bearer "
  } else { "user=" ++ user ++ "\u{1}auth=Bearer " };
  between(Bytes::of_string(named), token, b"\x01\x01")
}

/// The channel binding of a SCRAM exchange (RFC 5802 §6), which ties the authentication to the
/// connection it runs over. `Unbound` (GS2 flag `n`) means the client has no binding to offer.
/// `Unoffered` (`y`) means the client supports binding but the server offered none, so a server
/// that did offer one can detect that the offer was removed in transit. `ServerEndPoint` (`p`)
/// binds to the hash of the server's certificate (RFC 5929 `tls-server-end-point`) and requires the
/// mechanism's `-PLUS` name.
pub type ChannelBinding = | Unbound | Unoffered | ServerEndPoint(Bytes)

/// The GS2 header that starts the first message of a SCRAM exchange under `b`.
pub fn gs2_header(b: ChannelBinding) -> String =
  match b { Unbound -> "n,,", Unoffered -> "y,,", ServerEndPoint(_) -> "p=tls-server-end-point,," }

fn channel_text(b: ChannelBinding) -> String / {abort.raise} =
  base64_encode(
    Bytes::of_string(gs2_header(b)).concat(match b { ServerEndPoint(data) -> data, _ -> b"" }),
  )

/// SCRAM's first message: the GS2 header for `b`, then the bare message.
pub fn scram_first(b: ChannelBinding, user: String, nonce: String) -> String =
  gs2_header(b) ++ scram_first_bare(user, nonce)

/// The client's first message without its GS2 header, which the signatures cover: the user and
/// the client's nonce. `=` and `,` in the name are escaped, because they separate the fields.
pub fn scram_first_bare(user: String, nonce: String) -> String =
  "n=" ++ scram_name(user) ++ ",r=" ++ nonce

fn scram_name(user: String) -> String =
  range(0, user.len()).fold("", |accumulator: String, i: Int| {
    let c = user.slice(i, i + 1);
    if c == "=" { accumulator ++ "=3D" }
    else if c == "," { accumulator ++ "=2C" }
    else { accumulator ++ c }
  })

fn scram_attribute(secret_bytes: String, attribute: String) -> Option<String> / {abort.raise} =
  secret_bytes.split(",").fold(None, |accumulator: Option<String>, part: String|
    match accumulator {
      Some(found) -> Some(found),
      None -> if part.starts_with(attribute ++ "=") {
        Some(part.slice(attribute.len() + 1, part.len()))
      } else { None },
    })

fn count_of(digits: String) -> Option<Int> / {abort.raise} =
  if digits.starts_with("-") { None } else { Bytes::of_string(digits).int_of_ascii() }

/// The fields of the server's first SCRAM message: `nonce` is its `r` field, `salt` is its `s`
/// field decoded from base64, and `iterations` is its `i` field.
pub type Challenge = { nonce: String, salt: Bytes, iterations: Int }

/// The nonce, salt and iteration count from the server's first SCRAM message. `None` for a message
/// that lacks any of them, requests no iterations, or starts with an extension (`m=`) that a
/// client must not continue past.
pub fn scram_challenge(server_first: String) -> Option<Challenge> / {abort.raise} =
  if server_first.starts_with("m=") { None } else {
    match scram_attribute(server_first, "r") {
      None -> None,
      Some(nonce) -> match scram_attribute(server_first, "s") {
        None -> None,
        Some(salt) -> match scram_attribute(server_first, "i") {
          None -> None,
          Some(count) -> match base64_decode(salt) {
            None -> None,
            Some(salt_bytes) -> match count_of(count) {
              None -> None,
              Some(iterations) -> if iterations < 1 { None }
              else { Some({ nonce: nonce, salt: salt_bytes, iterations: iterations }) },
            },
          },
        },
      },
    }
  }

/// What the keys produce: the reply that carries the proof, and the signature the server must
/// prove itself with next.
pub type Proof = { reply: String, expected: Bytes }

/// Returns the client's final SCRAM message and the signature the server must send back, computed
/// from the password's UTF-8 bytes. The password is never exposed: the runtime derives the keys
/// from it as secrets. Returns `None` if the challenge's nonce does not begin with the client's own
/// nonce, which any server that received the first message does. `b` is the channel binding that
/// the first message's header declared.
///
/// Both sides sign the client's bare first message, the server's first message and the final
/// message without its proof, joined by commas. The final message includes the binding, so a proof
/// made over one channel is not valid over another.
pub fn scram_final(
  b: ChannelBinding,
  password: Secret<Bytes>,
  first_bare: String,
  server_first: String,
  challenge: Challenge,
) -> Option<Proof> / {abort.raise} =
  match scram_attribute(first_bare, "r") {
    None -> None,
    Some(own) -> if own == "" || !challenge.nonce.starts_with(own) { None } else {
      let without_proof = "c=" ++ channel_text(b) ++ ",r=" ++ challenge.nonce;
      let signed = Bytes::of_string(first_bare ++ "," ++ server_first ++ "," ++ without_proof);
      let salted = pbkdf2_sha256(password, challenge.salt, challenge.iterations);
      let client_key = hmac_sha256(salted, b"Client Key");
      let signature = hmac_sha256(Secret::of_bytes(sha256(client_key)), signed);
      Some({
        reply: without_proof ++ ",p=" ++ base64_encode(client_key.xor(signature)),
        expected: hmac_sha256(Secret::of_bytes(hmac_sha256(salted, b"Server Key")), signed),
      })
    },
  }

/// Whether the `v=` value in the server's last message matches the signature the keys predicted.
pub fn scram_verify(server_final: String, expected: Bytes) -> Bool / {abort.raise} =
  match scram_attribute(server_final, "v") {
    None -> false,
    Some(encoded) -> match base64_decode(encoded) {
      None -> false,
      Some(got) -> tags_match(got, expected),
    },
  }

fn setting(nonce: String) -> Options =
  { nonce: nonce, max_iterations: 100000, host: "server.example.com", port: 587 }

fn begun(m: Mechanism, c: Result<Credential, Error>, s: Options) -> Result<ExchangeStart, Error> =
  match c { Err(reason) -> Err(reason), Ok(held) -> try { begin(m, held, s) } }

fn tim_password_credential() -> Result<Credential, Error> =
  try { password("tim", Secret::of_bytes(b"tanstaaftanstaaf")) }

fn token() -> Result<Credential, Error> =
  try {
    bearer("user@example.com", Secret::of_bytes(b"vF9dft4qmTc2Nvb3RlckBhbHRhdmlzdGEuY29tCg=="))
  }

fn first_of(b: Result<ExchangeStart, Error>) -> Option<Secret<Bytes>> =
  match b {
    Ok(started) -> match started.first { Some(first) -> Some(secret_bytes(first)), None -> None },
    Err(_) -> None,
  }

fn says(r: Response, bytes: Bytes) -> Bool = secret_bytes(r) == Secret::of_bytes(bytes)

fn respond_all(
  b: Result<ExchangeStart, Error>,
  challenges: List<Bytes>,
) -> Result<ExchangeStep, Error> / {abort.raise} =
  match b {
    Err(reason) -> Err(reason),
    Ok(started) -> try {
      challenges.fold(
        { exchange: started.exchange, response: plain_response(b"") },
        |a: ExchangeStep, challenge: Bytes| respond(a.exchange, challenge),
      )
    },
  }

test "PLAIN sends RFC 4616's message first, and nothing follows it" {
  let started = begun(Plain, tim_password_credential(), setting("unused"));
  assert(first_of(started) == Some(Secret::of_bytes(b"\x00tim\x00tanstaaftanstaaf")));
  assert_eq(result_is_authenticated(started), Ok(true));
  assert_eq(respond_all(started, [b"more?"]), Err(BadChallenge))
}

fn result_is_authenticated(b: Result<ExchangeStart, Error>) -> Result<Bool, Error> =
  match b { Ok(started) -> Ok(is_authenticated(started.exchange)), Err(reason) -> Err(reason) }

test "LOGIN waits for prompts, and sends the name and then the password" {
  let started = begun(Login, tim_password_credential(), setting("unused"));
  assert(first_of(started) == None);
  assert_eq(result_is_authenticated(started), Ok(false));
  match respond_all(started, [b"Username:"]) {
    Ok(a) -> {
      assert(says(a.response, b"tim"));
      assert(!is_authenticated(a.exchange))
    },
    Err(_) -> panic("LOGIN rejected its first question"),
  };
  match respond_all(started, [b"Username:", b"Password:"]) {
    Ok(a) -> {
      assert(says(a.response, b"tanstaaftanstaaf"));
      assert(is_authenticated(a.exchange))
    },
    Err(_) -> panic("LOGIN rejected its second question"),
  };
  assert_eq(respond_all(started, [b"Username:", b"Password:", b"Again:"]), Err(BadChallenge))
}

test "OAUTHBEARER sends RFC 7628's message, and replies to a rejection with one byte" {
  let started = begun(OAuthBearer, token(), setting("unused"));
  assert(
    first_of(started)
      == Some(
        sealed_base64(
          "bixhPXVzZXJAZXhhbXBsZS5jb20sAWhvc3Q9c2VydmVyLmV4YW1wbGUuY29tAXBvcnQ9NTg3AWF1dGg9QmVhcmVyIHZGOWRmdDRxbVRjMk52YjNSbGNrQmhiSFJoZG1semRHRXVZMjl0Q2c9PQEB",
        ),
      ),
  );
  assert_eq(result_is_authenticated(started), Ok(true));
  match respond_all(started, [b"{\"status\":\"invalid_token\"}"]) {
    Ok(a) -> {
      assert(says(a.response, b"\x01"));
      assert(!is_authenticated(a.exchange))
    },
    Err(_) -> panic("a rejection was not responded to"),
  }
}

fn sealed_base64(text: String) -> Secret<Bytes> / {abort.raise} =
  match base64_decode(text) {
    Some(bytes) -> Secret::of_bytes(bytes),
    None -> panic("the test's base64 text cannot be decoded"),
  }

test "XOAUTH2 sends the user and the token, and replies to a rejection with nothing" {
  let credential = try {
    bearer(
      "someuser@example.com",
      Secret::of_bytes(b"ya29.vF9dft4qmTc2Nvb3RlckBhdHRhdmlzdGEuY29tCg"),
    )
  };
  let started = begun(XOAuth2, credential, setting("unused"));
  assert(
    first_of(started)
      == Some(
        Secret::of_bytes(
          b"user=someuser@example.com\x01auth=Bearer ya29.vF9dft4qmTc2Nvb3RlckBhdHRhdmlzdGEuY29tCg\x01\x01",
        ),
      ),
  );
  match respond_all(started, [b"{\"status\":\"401\"}"]) {
    Ok(a) -> {
      assert(says(a.response, b""));
      assert(!is_authenticated(a.exchange))
    },
    Err(_) -> panic("a rejection was not responded to"),
  }
}

test "SCRAM matches RFC 7677's worked example" {
  let first_bare = scram_first_bare("user", "rOprNGfwEbeRWgbNEkqO");
  assert_eq(first_bare, "n=user,r=rOprNGfwEbeRWgbNEkqO");
  let server_first = "r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,s=W22ZaJ0SNY7soEsUEjb6gQ==,i=4096";
  match scram_challenge(server_first) {
    None -> panic("the example's challenge does not read"),
    Some(challenge) -> {
      assert_eq(challenge.iterations, 4096);
      assert_eq(challenge.salt.len(), 16);
      match scram_final(Unbound, Secret::of_bytes(b"pencil"), first_bare, server_first, challenge) {
        None -> panic("the example's nonce is not the client's"),
        Some(proof) -> {
          assert_eq(
            proof.reply,
            "c=biws,r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,p=dHzbZapWIk4jUhN+Ute9ytag9zjfMHgsqmmiz7AndVQ=",
          );
          assert(scram_verify("v=6rriTRBi23WpRR/wtup+mMhUZUn/dB5nLTJRsjl95G4=", proof.expected));
          assert(!scram_verify("v=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=", proof.expected));
          assert(!scram_verify("e=other", proof.expected));
          match scram_final(
              ServerEndPoint(b"\x01\x02"),
              Secret::of_bytes(b"pencil"),
              first_bare,
              server_first,
              challenge,
            ) {
            None -> panic("a bound exchange has no proof"),
            Some(bound) -> {
              assert(bound.reply.starts_with("c=cD10bHMtc2VydmVyLWVuZC1wb2ludCwsAQI=,r="));
              assert(bound.expected != proof.expected)
            },
          }
        },
      }
    },
  }
}

fn pencil_password_credential() -> Result<Credential, Error> =
  try { password("user", Secret::of_bytes(b"pencil")) }

const example_first: Bytes =
  b"r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,s=W22ZaJ0SNY7soEsUEjb6gQ==,i=4096"

test "a SCRAM exchange follows RFC 7677, and only the server's correct proof completes it" {
  let started = begun(ScramSha256, pencil_password_credential(), setting("rOprNGfwEbeRWgbNEkqO"));
  assert(first_of(started) == Some(Secret::of_bytes(b"n,,n=user,r=rOprNGfwEbeRWgbNEkqO")));
  assert_eq(result_is_authenticated(started), Ok(false));
  match respond_all(started, [example_first]) {
    Ok(a) -> {
      assert(
        says(
          a.response,
          b"c=biws,r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,p=dHzbZapWIk4jUhN+Ute9ytag9zjfMHgsqmmiz7AndVQ=",
        ),
      );
      assert(!is_authenticated(a.exchange))
    },
    Err(_) -> panic("the example's challenge was rejected"),
  };
  match respond_all(started, [example_first, b"v=6rriTRBi23WpRR/wtup+mMhUZUn/dB5nLTJRsjl95G4="]) {
    Ok(a) -> {
      assert(says(a.response, b""));
      assert(is_authenticated(a.exchange))
    },
    Err(_) -> panic("the example's proof was rejected"),
  };
  assert_eq(
    respond_all(started, [example_first, b"v=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="]),
    Err(BadServerProof),
  );
  assert_eq(respond_all(started, [example_first, b"e=invalid-proof"]), Err(BadServerProof))
}

test "a SCRAM server must echo the client's nonce, stay within the iteration limit, and send readable messages" {
  let started = begun(ScramSha256, pencil_password_credential(), setting("rOprNGfwEbeRWgbNEkqO"));
  assert_eq(
    respond_all(started, [
      b"r=another%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,s=W22ZaJ0SNY7soEsUEjb6gQ==,i=4096",
    ]),
    Err(BadChallenge),
  );
  assert_eq(
    respond_all(started, [b"r=rOprNGfwEbeRWgbNEkqOx,s=W22ZaJ0SNY7soEsUEjb6gQ==,i=100001"]),
    Err(TooManyIterations(100001)),
  );
  assert_eq(respond_all(started, [b"\xff\xfe"]), Err(BadChallenge));
  assert_eq(respond_all(started, [b"e=unknown-user"]), Err(BadChallenge));
  assert_eq(
    respond_all(started, [b"m=ext,r=rOprNGfwEbeRWgbNEkqOx,s=W22ZaJ0SNY7soEsUEjb6gQ==,i=4096"]),
    Err(BadChallenge),
  );
  assert_eq(begun(ScramSha256, pencil_password_credential(), setting("a,b")), Err(BadNonce));
  assert_eq(begun(ScramSha256, pencil_password_credential(), setting("")), Err(BadNonce))
}

fn configured_pencil() -> Result<Credential, Error> =
  try { password("user", Secret::of_string("pencil").bytes()) }

test "a password credential built from text behaves like one built from bytes in SCRAM, PLAIN and the other mechanisms" {
  let proofs = [pencil_password_credential(), configured_pencil()].map(
    |c: Result<Credential, Error>|
      result_map_response(
        respond_all(begun(ScramSha256, c, setting("rOprNGfwEbeRWgbNEkqO")), [
          example_first,
          b"v=6rriTRBi23WpRR/wtup+mMhUZUn/dB5nLTJRsjl95G4=",
        ]),
      ),
  );
  assert_eq(proofs, [Ok(true), Ok(true)]);
  assert(
    first_of(begun(Plain, configured_pencil(), setting("n")))
      == first_of(begun(Plain, pencil_password_credential(), setting("n"))),
  );
  assert(
    mechanisms.all(|m: Mechanism|
      match configured_pencil() {
        Ok(c) ->
          supports(c, m) == (m == Plain || m == Login || m == ScramSha256)
            && supports(c, m) == result_is_begun(begun(m, configured_pencil(), setting("n"))),
        Err(_) -> false,
      }),
  )
}

fn result_map_response(a: Result<ExchangeStep, Error>) -> Result<Bool, Error> =
  match a { Ok(done) -> Ok(is_authenticated(done.exchange)), Err(reason) -> Err(reason) }

test "SCRAM escapes `=` and `,` in a user name so they cannot be mistaken for field separators" {
  assert_eq(scram_first_bare("a=b,c", "n"), "n=a=3Db=2Cc,r=n");
  assert_eq(scram_first(Unbound, "user", "n1"), "n,,n=user,r=n1");
  assert_eq(scram_first(Unoffered, "user", "n1"), "y,,n=user,r=n1");
  assert_eq(scram_first(ServerEndPoint(b"h"), "user", "n1"), "p=tls-server-end-point,,n=user,r=n1")
}

test "`scram_challenge` returns `None` for a malformed challenge instead of substituting default values" {
  assert_eq(scram_challenge("r=abc,s=!!,i=1"), None);
  assert_eq(scram_challenge("r=abc,s=AAAA,i=x"), None);
  assert_eq(scram_challenge("r=abc,s=AAAA,i=0"), None);
  assert_eq(scram_challenge("s=AAAA,i=1"), None);
  assert_eq(scram_challenge("r=abc,s=AAAA"), None);
  assert_eq(scram_challenge("m=x,r=abc,s=AAAA,i=1"), None)
}

type CredentialCase = { what: String, user: Result<String, Error>, expect: Option<String> }

fn credential_user(c: Result<Credential, Error>) -> Result<String, Error> =
  match c { Ok(credential) -> Ok(user_of(credential)), Err(reason) -> Err(reason) }

const credential_cases: List<CredentialCase> =
  [
    {
      what: "a password",
      user: credential_user(try { password("tim", Secret::of_bytes(b"x")) }),
      expect: Some("tim"),
    },
    {
      what: "a password with no user",
      user: credential_user(try { password("", Secret::of_bytes(b"x")) }),
      expect: None,
    },
    {
      what: "an empty password",
      user: credential_user(try { password("tim", Secret::of_bytes(b"")) }),
      expect: None,
    },
    {
      what: "a password whose user holds NUL",
      user: credential_user(try { password("ti\0m", Secret::of_bytes(b"x")) }),
      expect: None,
    },
    {
      what: "a password whose user holds a line feed",
      user: credential_user(try { password("ti\nm", Secret::of_bytes(b"x")) }),
      expect: None,
    },
    {
      what: "a password whose user holds a carriage return",
      user: credential_user(try { password("ti\rm", Secret::of_bytes(b"x")) }),
      expect: None,
    },
    {
      what: "a password that holds NUL",
      user: credential_user(try { password("tim", Secret::of_bytes(b"a\x00b")) }),
      expect: Some("tim"),
    },
    {
      what: "a password past ASCII",
      user: credential_user(try {
        password("j\u{fc}rgen", Secret::of_string("p\u{e4}ss wort\n").bytes())
      }),
      expect: Some("j\u{fc}rgen"),
    },
    {
      what: "a bearer token",
      user: credential_user(try { bearer("tim", Secret::of_bytes(b"ya29.a-b_c~d+e/f=")) }),
      expect: Some("tim"),
    },
    {
      what: "an empty bearer token",
      user: credential_user(try { bearer("tim", Secret::of_bytes(b"")) }),
      expect: None,
    },
    {
      what: "a bearer token that holds a space",
      user: credential_user(try { bearer("tim", Secret::of_bytes(b"a b")) }),
      expect: Some("tim"),
    },
    {
      what: "a bearer token with no user",
      user: credential_user(try { bearer("", Secret::of_bytes(b"abc")) }),
      expect: None,
    },
  ]

test "a SASL user name built from {m.what} is accepted, or rejected with `BadCredential`" for m: CredentialCase in credential_cases {
  assert_eq(
    match m.user {
      Ok(user) -> Some(user),
      Err(reason) -> if reason == BadCredential { None } else { Some("") },
    },
    m.expect,
  )
}

test "starting a mechanism with a credential of the wrong kind fails with `WrongCredential`" {
  assert_eq(begun(Plain, token(), setting("n")), Err(WrongCredential));
  assert_eq(begun(Login, token(), setting("n")), Err(WrongCredential));
  assert_eq(begun(ScramSha256, token(), setting("n")), Err(WrongCredential));
  assert_eq(begun(OAuthBearer, tim_password_credential(), setting("n")), Err(WrongCredential));
  assert_eq(begun(XOAuth2, tim_password_credential(), setting("n")), Err(WrongCredential));
  assert(
    mechanisms.all(|m: Mechanism|
      match tim_password_credential() {
        Ok(c) ->
          supports(c, m) == result_is_begun(begun(m, tim_password_credential(), setting("n"))),
        Err(_) -> false,
      }),
  )
}

fn result_is_begun(b: Result<ExchangeStart, Error>) -> Bool =
  match b { Ok(_) -> true, Err(_) -> false }

law "a mechanism is found by the name a server offers it under" =
  round_trip(mechanism_name, mechanism_named)

test "`mechanism_named` finds a SASL mechanism by name in any case, and `ScramSha256` is the only mechanism for which `reveals` is false" {
  assert_eq(mechanisms.len(), 5);
  assert_eq(mechanism_named("scram-sha-256"), Some(ScramSha256));
  assert_eq(mechanism_named("Plain"), Some(Plain));
  assert_eq(mechanism_named("CRAM-MD5"), None);
  assert_eq(mechanism_named(""), None);
  assert_eq(mechanisms.filter(|m: Mechanism| !reveals(m)), [ScramSha256])
}

test "nothing shows a credential's secret, in the credential or in an exchange that contains it" {
  let credential = tim_password_credential();
  assert_eq(show(credential), "Ok(password(\"tim\", ****))");
  assert_eq(show(token()), "Ok(bearer(\"user@example.com\", ****))");
  let exchanges = [
    begun(Plain, credential, setting("n")),
    begun(Login, credential, setting("n")),
    begun(ScramSha256, credential, setting("n")),
    begun(OAuthBearer, token(), setting("n")),
  ];
  assert(
    exchanges.all(|b: Result<ExchangeStart, Error>|
      match b { Ok(started) -> show(started.exchange) == "Exchange(****)", Err(_) -> false }),
  );
  assert(
    exchanges.all(|b: Result<ExchangeStart, Error>|
      !show(b).contains("tanstaaf") && !show(b).contains("vF9dft")),
  );
  assert_eq(
    show(begun(Plain, credential, setting("n"))),
    "Ok({exchange: Exchange(****), first: Some(Response(****))})",
  );
  assert(
    !show(respond_all(begun(Login, credential, setting("n")), [b"Username:"])).contains("tanstaaf"),
  )
}

test "`show` of a password credential contains only the user name and is the same whatever the secret" {
  gen::check3(
    gen::text(),
    gen::text(),
    gen::text(),
    |user: String, secret: String, other: String| {
      match try { password(user, Secret::of_string(secret).bytes()) } {
        Err(_) -> true,
        Ok(c) -> match try { password(user, Secret::of_string(other).bytes()) } {
          Err(_) -> true,
          Ok(d) -> show(c) == show(d),
        },
      }
    },
  )
}

fn server_signature(
  secret: String,
  salt: Bytes,
  iterations: Int,
  signed: String,
  proof: Bytes,
) -> Option<Bytes> / {abort.raise} = {
  let salted = pbkdf2_sha256(Secret::of_string(secret).bytes(), salt, iterations);
  let stored = sha256(hmac_sha256(salted, b"Client Key"));
  let client_key = proof.xor(hmac_sha256(Secret::of_bytes(stored), Bytes::of_string(signed)));
  if !tags_match(sha256(client_key), stored) { None } else {
    Some(
      hmac_sha256(Secret::of_bytes(hmac_sha256(salted, b"Server Key")), Bytes::of_string(signed)),
    )
  }
}

test "a server that stores a password's verifier accepts the client's SCRAM proof, and the client accepts the server's signature" {
  gen::check4(
    gen::text(),
    gen::bytes(),
    gen::any_int(),
    gen::text(),
    |secret: String, salt: Bytes, tail: Int, wrong: String| {
      let first_bare = scram_first_bare("user", "clientnonce");
      let server_first = "r=clientnonce" ++ tail.to_string() ++ ",s=" ++ base64_encode(salt)
        ++ ",i=2";
      match scram_challenge(server_first) {
        None -> false,
        Some(challenge) -> match scram_final(
            Unbound,
            Secret::of_string(secret).bytes(),
            first_bare,
            server_first,
            challenge,
          ) {
          None -> false,
          Some(proof) -> {
            let signed = first_bare ++ "," ++ server_first ++ ",c=biws,r=" ++ challenge.nonce;
            let sent = match scram_attribute(proof.reply, "p") {
              Some(encoded) -> base64_decode(encoded),
              None -> None,
            };
            match sent {
              None -> false,
              Some(given) -> match server_signature(secret, salt, 2, signed, given) {
                None -> false,
                Some(signature) ->
                  scram_verify("v=" ++ base64_encode(signature), proof.expected)
                    && (wrong == secret || server_signature(wrong, salt, 2, signed, given) == None),
              },
            }
          },
        },
      }
    },
  )
}
