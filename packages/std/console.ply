//! A line to or from a console stream.
//!
//! `print` and `eprint` are `std.process`'s `out` and `err` under the conventional `proc` label:
//! one line to standard output and standard error, and `read_line` is its `line`, one line of
//! standard input. A value that is not a `String` is written by
//! interpolation, `print(f"{x}")`, which is `std.show.display`. Either reaches the process effect,
//! so a program that prints runs under `ply run`, and a test answers it with
//! `std.process.over`.
//!
//! `Console` is the three streams as an `effect set`, so a program that reads and prints writes
//! `fn main() -> Unit / {Console}` rather than naming them.

import std.process (process, Stdout, Stderr, captured, over, with_input, written_to)

/// Standard input, standard output and standard error as one row.
pub effect set Console = {process.line[proc], process.out[proc], process.err[proc]}

/// `text` written to standard output, with a line ending.
pub fn print(text: String) -> Unit / {process.out[proc]} = process.out[proc](text)

/// `text` written to standard error, with a line ending.
pub fn eprint(text: String) -> Unit / {process.err[proc]} = process.err[proc](text)

/// The next line of standard input without its line ending, or `None` once input has ended.
pub fn read_line() -> Option<String> / {process.line[proc]} = process.line[proc]()

test "each line goes to its own stream" {
  let ran = over[proc](captured([]), || {
    print("plain");
    eprint("trouble")
  });
  assert_eq(written_to(ran.captured, Stdout), b"plain\n");
  assert_eq(written_to(ran.captured, Stderr), b"trouble\n")
}

test "a line read is one the input holds, and none once it ends" {
  let ran = over[proc](with_input(captured([]), ["first", "second"]), || {
    let a = read_line();
    let b = read_line();
    [a, b, read_line()]
  });
  assert_eq(ran.value, Some([Some("first"), Some("second"), None]))
}
