//! Reading and writing lines on the console.
//!
//! `print` and `eprint` call `std.process`'s `out` and `err` operations under the conventional
//! `proc` label. Each writes one line, to standard output or standard error. `read_line` calls
//! `line`, which reads one line of standard input. To print a value that is not a `String`,
//! interpolate it: `print(f"{x}")` formats it with `std.show.display`. These functions perform the
//! process effect, so a program that prints runs under `ply run`, and a test handles the effect
//! with `std.process.over`.
//!
//! `Console` is an `effect set` of all three streams, so a program that reads and prints can write
//! `fn main() -> Unit / {Console}` instead of naming each one.

import std.process (process, Stdout, Stderr, captured, over, with_input, written_to)

/// Standard input, standard output and standard error as one effect set.
pub effect set Console = {process.line[proc], process.out[proc], process.err[proc]}

/// `text` written to standard output, with a line ending.
pub fn print(text: String) -> Unit / {process.out[proc]} = process.out[proc](text)

/// `text` written to standard error, with a line ending.
pub fn eprint(text: String) -> Unit / {process.err[proc]} = process.err[proc](text)

/// The next line of standard input without its line ending, or `None` once input has ended.
pub fn read_line() -> Option<String> / {process.line[proc]} = process.line[proc]()

test "`print` writes a line to standard output and `eprint` writes a line to standard error" {
  let ran = over[proc](captured([]), || {
    print("plain");
    eprint("trouble")
  });
  assert_eq(written_to(ran.captured, Stdout), b"plain\n");
  assert_eq(written_to(ran.captured, Stderr), b"trouble\n")
}

test "each line read is the next line of input, and none once input ends" {
  let ran = over[proc](with_input(captured([]), ["first", "second"]), || {
    let a = read_line();
    let b = read_line();
    [a, b, read_line()]
  });
  assert_eq(ran.value, Some([Some("first"), Some("second"), None]))
}
