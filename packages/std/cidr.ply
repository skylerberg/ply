//! The `cidr"10.0.0.0/8"` literal: a `std.ip` network, checked when the program is checked.
//!
//! A literal's tag is a module. The `std.ip` tag reads an address, so a network needs this
//! separate tag. The type and its operations live in `std.ip`.

import std.ip (Prefix, parse_prefix, prefix_literal, render_prefix)
import std.result

/// Checks a `cidr"..."` literal.
///
/// Returns the network that `std.ip`'s `parse_prefix` reads. Otherwise returns why the text is not
/// a network, and the offset of the character where it stops being one.
pub fn literal(text: String) -> Result<Prefix, { message: String, offset: Int }> / {abort.raise} =
  prefix_literal(text)

test "`literal` returns the parsed network, or an error with a message and the offset where the text stops being a valid network" {
  assert_eq(literal("10.0.0.0/8").ok(), parse_prefix("10.0.0.0/8").ok());
  assert_eq(
    match literal("2001:DB8::/32") { Ok(p) -> render_prefix(p), Err(_) -> "" },
    "2001:db8::/32",
  );
  assert_eq(
    literal("10.0.0.1/8"),
    Err({ message: "a bit past the prefix length is set", offset: 9 }),
  );
  assert_eq(literal("10.0.0.0"), Err({ message: "a `/` and a prefix length go here", offset: 8 }))
}
