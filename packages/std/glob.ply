//! Shell-style patterns over paths, compiled once and matched in one pass over the path.
//!
//! A path is text, and nothing here reads a file system. The dialect is not any one shell's:
//!
//! - A pattern writes `/` between segments, whatever separates the path's segments.
//! `Options.separator` names the path's separator, and nothing is read from the platform. - `?`
//! matches one character and `*` any run of them, never including the separator. - `[abc]`, `[a-z]`
//! and `[!a-z]` (also written `[^a-z]`) match one character of a class, as in Go's `path.Match`. A
//! class must contain at least one character: `[]` and `[!]` are errors. A `]`, `-` or `\` in it is
//! written `\]`, `\-` or `\\`. A range's ends are in order of their scalar values, never a locale's
//! order. A class never matches the separator, and there are no named classes. - `**` matches whole
//! segments, and is allowed only between a `/` or the pattern's start and a `/` or its end. `**/`
//! matches zero or more segments, so `a/**/b` matches `a/b`. A closing `/**` matches everything
//! below, so `a/**` matches `a/b/c` but not `a`, as a `.gitignore` reads it. `**` alone matches
//! every path except the empty one. - `{a,b}` matches either alternative, as a shell expands it. An
//! alternative may be empty, contain `/` and wildcards, and contain another brace. A `,` outside
//! braces matches itself, and a `}` that closes nothing is an error. - `\` makes the next character
//! match itself, and `escape` writes the pattern that matches a text and nothing else. - A `.` at
//! the start of a path segment is matched only by a `.` at the start of a pattern segment, as in
//! `fnmatch` and the shells: `*.ply` matches neither `.hidden.ply` nor `.ply`, and `**` does not
//! enter `.git`. `Options.match_hidden` lets every wildcard match one. - Case matters unless
//! `Options.ignore_case` is set. Then both sides are lower-cased one character at a time with
//! Unicode's simple mapping (`char::to_lowercase`). This keeps the text's length, so `?` still
//! matches one character of the path whatever its case. The full mapping would not: it turns
//! `U+0130` into two characters.
//!
//! Nothing is normalised: `a//b` and `a/./b` are not `a/b`, and `std.path` normalises them.
//!
//! A match tracks every state the pattern could be in after each character, rather than trying one
//! and backtracking, so no pattern takes time exponential in its length. The time grows with the
//! path's length multiplied by the pattern's length. It grows by the pattern's length once more
//! only when the pattern has several alternatives in a row that can each be empty, such as
//! `{a,}{b,}{c,}`.
//!
//! `base` returns the directory a walk should start from, and `enters` tells a walk whether a
//! directory can contain a match, so the walk can skip directories that cannot.

import std.char
import std.laws (agrees)
import std.list (enumerate)
import std.map
import std.gen

/// How a pattern matches a path.
pub type Options = {
  /// The character between a path's segments, which a `/` in the pattern matches.
  separator: Char,
  /// Whether `A` matches `a`.
  ignore_case: Bool,
  /// Whether `*`, `?`, a class and `**` match a `.` that leads a segment.
  match_hidden: Bool,
}

/// The default options: `/` between segments, case-sensitive, and a leading `.` matched only by a
/// literal `.`.
pub fn options() -> Options = { separator: '/', ignore_case: false, match_hidden: false }

type CharRange = { lo: Char, hi: Char }

type Symbol =
  | Literal(Char)
  | Separator
  | One
  | Run
  | Any
  | Deep
  | Among(Bool, List<CharRange>)
  | End

type State = { symbol: Symbol, next: List<Int>, first: List<Int> }

/// A compiled pattern. Two are equal when their patterns and options are the same.
pub type Glob = new {
  options: Options,
  states: Array<State>,
  /// The states a match starts in.
  start: Map<Int, Unit>,
  /// The states in `start` that a match reaches before it consumes any `*`.
  first: Map<Int, Unit>,
  /// The directory every match is under: the pattern's leading segments that contain no wildcard,
  /// or empty when the first segment contains one.
  base: String,
  /// The one path the pattern matches when it contains no wildcard, otherwise `None`.
  exact: Option<String>,
}

/// Why a pattern is invalid.
pub type ErrorKind =
  /// A `[` whose class is not closed before the pattern ends.
  | UnclosedClass
  /// A class of no characters, `[]` or `[!]`.
  | EmptyClass
  /// A `-` in a class that is not between two characters in order.
  | BadRange
  /// A `{` with no `}`.
  | UnclosedBrace
  /// A `}` with no `{`.
  | UnopenedBrace
  /// A `\` with no character after it.
  | TrailingEscape
  /// A `**` that is not a whole segment.
  | Globstar

/// Why a pattern is invalid, and the index of the character the error is at.
pub type Error = { at: Int, reason: ErrorKind }

/// What `read` raises for an invalid pattern.
pub effect glob {
  /// The text is not a pattern of this dialect.
  raise fail(e: Error)
}

/// Returns a sentence that explains why a pattern is invalid, for an error message.
pub fn reason(reason: ErrorKind) -> String =
  match reason {
    UnclosedClass -> "this `[` starts a set of characters but has no closing `]`",
    EmptyClass -> "a set of characters in `[]` must contain at least one character",
    BadRange ->
      "a `-` in a set of characters must have a character on each side, with the first before the second in order, or be written `\\-`",
    UnclosedBrace -> "this `{` has no closing `}`",
    UnopenedBrace -> "this `}` closes nothing: write `\\}` for the character",
    TrailingEscape -> "a `\\` must be followed by the character it escapes",
    Globstar ->
      "`**` must be the only text between two `/` characters, or between a `/` and the start or end of the pattern",
  }

/// Compiles the pattern under `options()`, or returns where and why it is invalid.
pub fn compile(pattern: String) -> Result<Glob, Error> / {abort.raise} =
  try { read(pattern, options()) }

/// Compiles the pattern to match paths as `o` specifies, or returns where and why it is invalid.
pub fn compile_with(pattern: String, o: Options) -> Result<Glob, Error> / {abort.raise} =
  try { read(pattern, o) }

/// Compiles the pattern to match paths as `o` specifies. Raises `glob.fail` where `compile_with`
/// returns `Err`.
pub fn read(pattern: String, o: Options) -> Glob / {glob.fail, abort.raise} = {
  let written = program_of(pattern);
  let prefix = literal_prefix(written, o.separator);
  let states = states_of(if o.ignore_case { program_of(lowered(pattern)) } else { written });
  {
    options: o,
    states: states.states,
    start: states.start,
    first: states.first,
    base: if prefix.cut < 0 { "" } else { String::of_chars(prefix.text.take(max(prefix.cut, 1))) },
    exact: if prefix.whole { Some(String::of_chars(prefix.text)) } else { None },
  }
}

/// Checks the text of a `glob"..."` literal. Returns the pattern compiled under `options()`, or the
/// character where it is invalid. A literal's text doubles each brace, so `{a,b}` is written
/// `{{a,b}}` there, and a `\` is written `\\`.
pub fn literal(text: String) -> Result<Glob, { message: String, offset: Int }> / {abort.raise} =
  match compile(text) {
    Ok(g) -> Ok(g),
    Err(rejected) -> Err({ message: reason(rejected.reason), offset: rejected.at }),
  }

/// The pattern that matches `text` and nothing else under a `/` separator. Each character with a
/// special meaning in a pattern gets a `\` before it.
pub fn escape(text: String) -> String =
  String::of_chars(
    text.chars().fold([], |accumulator: List<Char>, c: Char|
      if is_special(c) { accumulator.push('\\').push(c) } else { accumulator.push(c) }),
  )

fn is_special(c: Char) -> Bool =
  c == '*' || c == '?' || c == '[' || c == ']' || c == '{' || c == '}' || c == ',' || c == '\\'

/// Whether the whole of `path` matches.
pub fn matches(g: Glob, path: String) -> Bool = {
  let on = states_after(g, path);
  on.contains(g.states.len() - 1)
}

/// Returns the directory that every match is under, for a walk to start from. It is the pattern's
/// leading segments that contain no wildcard, written as a path, or empty when the first segment
/// contains a wildcard. It is not lower-cased, even when `ignore_case` is set.
pub fn base(g: Glob) -> String = g.base

/// The one path a pattern with no wildcard matches, which a walk can look up by name.
pub fn exact(g: Glob) -> Option<String> = g.exact

/// Whether a walk needs to list the directory `dir`: `false` only when no path under it can match.
/// The empty `dir` is where the walk starts, and it is always entered.
pub fn enters(g: Glob, dir: String) -> Bool = {
  let separator = String::of_chars([g.options.separator]);
  let under = if dir == "" || dir.ends_with(separator) { dir } else { dir ++ separator };
  states_after(g, under).len() > 0
}

type MatchState = { on: Map<Int, Unit>, first: Map<Int, Unit>, at_segment_start: Bool }

fn lowered(text: String) -> String = String::of_chars(text.chars().map(Char::to_lowercase))

fn states_after(g: Glob, text: String) -> Map<Int, Unit> =
  String::chars(if g.options.ignore_case { lowered(text) } else { text }).fold(
    { on: g.start, first: g.first, at_segment_start: true },
    |w: MatchState, c: Char| advance(g, w, c),
  ).on

fn advance(g: Glob, w: MatchState, c: Char) -> MatchState = {
  let hidden = w.at_segment_start && c == '.' && !g.options.match_hidden;
  let leads = c == g.options.separator;
  w.on.fold(
    { on: Map::new(), first: Map::new(), at_segment_start: leads },
    |next: MatchState, at: Int, _: Unit|
      match g.states.at(at) {
        Some(state) if accepts(
            state.symbol,
            c,
            g.options.separator,
            hidden,
            w.first.contains(at),
          ) ->
          {
            on: insert_all(next.on, state.next),
            first: if leads { insert_all(next.first, state.first) } else { next.first },
            at_segment_start: leads,
          },
        _ -> next,
      },
  )
}

fn insert_all(set: Map<Int, Unit>, more: List<Int>) -> Map<Int, Unit> =
  more.fold(set, |states: Map<Int, Unit>, to: Int| states.insert(to, ()))

fn accepts(symbol: Symbol, c: Char, separator: Char, hidden: Bool, first: Bool) -> Bool =
  match symbol {
    Literal(written) -> c == written && (!hidden || first),
    Separator -> c == separator,
    One | Run -> c != separator && !hidden,
    Any | Deep -> !hidden,
    Among(negated, spans) -> c != separator && !hidden && within(spans, c) != negated,
    End -> false,
  }

fn within(spans: List<CharRange>, c: Char) -> Bool =
  spans.any(|s: CharRange| c >= s.lo && c <= s.hi)

type Instruction = | Take(Symbol) | Fork(Int) | Jump(Int)

type Brace = { at: Int, fork_index: Int, jumps: List<Int> }

type Before = | SegmentStart | Star(Bool) | DoubleStar | Mid

type Step = | First | Item | PendingChar(Char) | Dash(Char)

type Class = { open: Int, negated: Bool, spans: List<CharRange>, step: Step, escaped: Bool }

type Mode = | Plain | Escaped | InClass(Class)

type Parser = {
  at: Int,
  program: List<Instruction>,
  mode: Mode,
  braces: List<Brace>,
  before: Before,
}

fn fail<a>(at: Int, reason: ErrorKind) -> a / {glob.fail} = glob.fail({ at: at, reason: reason })

fn program_of(pattern: String) -> List<Instruction> / {glob.fail, abort.raise} =
  finish_program(
    pattern.chars().fold(
      { at: 0, program: [], mode: Plain, braces: [], before: SegmentStart },
      |p: Parser, c: Char| {
        let read = match p.mode {
          Plain -> parse_plain(p, c),
          Escaped -> emit(p, Literal(c)),
          InClass(k) -> parse_class_char(p, k, c),
        };
        { ..read, at: p.at + 1 }
      },
    ),
  )

fn emit(p: Parser, symbol: Symbol) -> Parser =
  { ..p, program: p.program.push(Take(symbol)), mode: Plain, before: Mid }

fn parse_plain(p: Parser, c: Char) -> Parser / {glob.fail, abort.raise} =
  if p.before == DoubleStar {
    if c == '/' {
      let star = p.program.len() - 1;
      {
        ..p,
        program: p.program.set(star, Fork(star + 3)).push(Take(Deep)).push(Take(Separator)),
        before: SegmentStart,
      }
    } else { fail(p.at - 2, Globstar) }
  } else if c == '*' {
    match p.before {
      Star(true) -> { ..p, before: DoubleStar },
      Star(false) -> fail(p.at - 1, Globstar),
      SegmentStart -> { ..emit(p, Run), before: Star(true) },
      _ -> { ..emit(p, Run), before: Star(false) },
    }
  } else if c == '?' { emit(p, One) } else if c == '[' {
    { ..p, mode: InClass({ open: p.at, negated: false, spans: [], step: First, escaped: false }) }
  } else if c == '{' {
    {
      ..p,
      program: p.program.push(Fork(0)),
      braces: p.braces.push({ at: p.at, fork_index: p.program.len(), jumps: [] }),
      before: Mid,
    }
  } else if c == ',' { next_alternative(p) }
  else if c == '}' { close_brace(p) }
  else if c == '\\' { { ..p, mode: Escaped } }
  else if c == '/' { { ..emit(p, Separator), before: SegmentStart } }
  else { emit(p, Literal(c)) }

fn next_alternative(p: Parser) -> Parser / {abort.raise} =
  match p.braces.at(p.braces.len() - 1) {
    None -> emit(p, Literal(',')),
    Some(b) -> {
      let jump = p.program.len();
      {
        ..p,
        program: p.program.set(b.fork_index, Fork(jump + 1)).push(Jump(0)).push(Fork(0)),
        braces: p.braces.set(p.braces.len() - 1, {
          ..b,
          fork_index: jump + 1,
          jumps: b.jumps.push(jump),
        }),
        before: Mid,
      }
    },
  }

fn close_brace(p: Parser) -> Parser / {glob.fail, abort.raise} =
  match p.braces.at(p.braces.len() - 1) {
    None -> fail(p.at, UnopenedBrace),
    Some(b) -> {
      let end = p.program.len();
      {
        ..p,
        program: b.jumps.fold(
          p.program.set(b.fork_index, Jump(b.fork_index + 1)),
          |program: List<Instruction>, jump: Int| program.set(jump, Jump(end)),
        ),
        braces: p.braces.take(p.braces.len() - 1),
        before: Mid,
      }
    },
  }

fn parse_class_char(p: Parser, k: Class, c: Char) -> Parser / {glob.fail} =
  if k.escaped { member(p, { ..k, escaped: false }, c) }
  else if c == '\\' { { ..p, mode: InClass({ ..k, escaped: true }) } }
  else if k.step == First && (c == '!' || c == '^') {
    { ..p, mode: InClass({ ..k, negated: true, step: Item }) }
  } else if c == ']' {
    match k.step {
      Dash(_) -> fail(p.at, BadRange),
      PendingChar(lo) -> emit(p, Among(k.negated, k.spans.push({ lo: lo, hi: lo }))),
      _ -> if k.spans.len() == 0 { fail(k.open, EmptyClass) }
      else { emit(p, Among(k.negated, k.spans)) },
    }
  } else if c == '-' {
    match k.step {
      PendingChar(lo) -> { ..p, mode: InClass({ ..k, step: Dash(lo) }) },
      _ -> fail(p.at, BadRange),
    }
  } else { member(p, k, c) }

fn member(p: Parser, k: Class, c: Char) -> Parser / {glob.fail} =
  match k.step {
    Dash(lo) -> if c < lo { fail(p.at, BadRange) }
    else { { ..p, mode: InClass({ ..k, spans: k.spans.push({ lo: lo, hi: c }), step: Item }) } },
    PendingChar(lo) ->
      {
        ..p,
        mode: InClass({ ..k, spans: k.spans.push({ lo: lo, hi: lo }), step: PendingChar(c) }),
      },
    _ -> { ..p, mode: InClass({ ..k, step: PendingChar(c) }) },
  }

fn finish_program(p: Parser) -> List<Instruction> / {glob.fail, abort.raise} =
  match p.mode {
    Escaped -> fail(p.at - 1, TrailingEscape),
    InClass(k) -> fail(k.open, UnclosedClass),
    Plain -> match p.braces.at(p.braces.len() - 1) {
      Some(b) -> fail(b.at, UnclosedBrace),
      None ->
        List::push(
          if p.before == DoubleStar {
            p.program.set(p.program.len() - 1, Take(Any)).push(Take(Deep))
          } else { p.program },
          Take(End),
        ),
    },
  }

fn matches_any_length(symbol: Symbol) -> Bool = symbol == Run || symbol == Deep

fn states_of(
  program: List<Instruction>,
) -> { states: Array<State>, start: Map<Int, Unit>, first: Map<Int, Unit> } = {
  let closures = epsilon_closures(program, true);
  let led = epsilon_closures(program, false);
  {
    states: Array::of_list(
      enumerate(program).map(|i: { index: Int, value: Instruction }|
        match i.value {
          Take(symbol) -> {
            let states_after = if matches_any_length(symbol) { i.index } else { i.index + 1 };
            {
              symbol: symbol,
              next: closure_at(closures, states_after).keys(),
              first: closure_at(led, states_after).keys(),
            }
          },
          _ -> { symbol: End, next: [], first: [] },
        }),
    ),
    start: closure_at(closures, 0),
    first: closure_at(led, 0),
  }
}

fn epsilon_closures(program: List<Instruction>, past_loops: Bool) -> Map<Int, Map<Int, Unit>> =
  enumerate(program).reverse().fold(
    Map::new(),
    |done: Map<Int, Map<Int, Unit>>, i: { index: Int, value: Instruction }|
      done.insert(i.index, match i.value {
        Take(symbol) ->
          Map::insert(
            if past_loops && matches_any_length(symbol) { closure_at(done, i.index + 1) }
            else { Map::new() },
            i.index,
            (),
          ),
        Fork(to) -> closure_at(done, i.index + 1).merge(closure_at(done, to)),
        Jump(to) -> closure_at(done, to),
      }),
  )

fn closure_at(closures: Map<Int, Map<Int, Unit>>, at: Int) -> Map<Int, Unit> =
  closures.get_or(at, Map::new())

fn literal_prefix(
  program: List<Instruction>,
  separator: Char,
) -> { text: List<Char>, cut: Int, open: Bool, whole: Bool } =
  program.fold(
    { text: [], cut: -1, open: true, whole: false },
    |s: { text: List<Char>, cut: Int, open: Bool, whole: Bool }, instruction: Instruction|
      if !s.open { s } else {
        match instruction {
          Take(Literal(c)) -> { ..s, text: s.text.push(c) },
          Take(Separator) -> { ..s, text: s.text.push(separator), cut: s.text.len() },
          Take(End) -> { ..s, open: false, whole: true },
          _ -> { ..s, open: false },
        }
      },
  )

fn glob_of(pattern: String) -> Glob / {abort.raise} =
  match compile(pattern) {
    Ok(g) -> g,
    Err(_) -> panic("`" ++ pattern ++ "` is an invalid pattern in a test fixture"),
  }

type Case = { pattern: String, path: String, matches: Bool }

fn matching_case(pattern: String, path: String) -> Case =
  { pattern: pattern, path: path, matches: true }

fn non_matching_case(pattern: String, path: String) -> Case =
  { pattern: pattern, path: path, matches: false }

fn go_matches() -> List<Case> =
  [
    matching_case("abc", "abc"),
    matching_case("*", "abc"),
    matching_case("*c", "abc"),
    matching_case("a*", "a"),
    matching_case("a*", "abc"),
    non_matching_case("a*", "ab/c"),
    matching_case("a*/b", "abc/b"),
    non_matching_case("a*/b", "a/c/b"),
    matching_case("a*b*c*d*e*/f", "axbxcxdxe/f"),
    matching_case("a*b*c*d*e*/f", "axbxcxdxexxx/f"),
    non_matching_case("a*b*c*d*e*/f", "axbxcxdxe/xxx/f"),
    non_matching_case("a*b*c*d*e*/f", "axbxcxdxexxx/fff"),
    matching_case("a*b?c*x", "abxbbxdbxebxczzx"),
    non_matching_case("a*b?c*x", "abxbbxdbxebxczzy"),
    matching_case("ab[c]", "abc"),
    matching_case("ab[b-d]", "abc"),
    non_matching_case("ab[e-g]", "abc"),
    non_matching_case("ab[^c]", "abc"),
    non_matching_case("ab[^b-d]", "abc"),
    matching_case("ab[^e-g]", "abc"),
    matching_case("a\\*b", "a*b"),
    non_matching_case("a\\*b", "ab"),
    matching_case("a?b", "a\u{263a}b"),
    matching_case("a[^a]b", "a\u{263a}b"),
    non_matching_case("a???b", "a\u{263a}b"),
    non_matching_case("a[^a][^a][^a]b", "a\u{263a}b"),
    matching_case("[a-\u{3b6}]*", "\u{3b1}"),
    non_matching_case("*[a-\u{3b6}]", "A"),
    non_matching_case("a?b", "a/b"),
    non_matching_case("a*b", "a/b"),
    matching_case("[\\]a]", "]"),
    matching_case("[\\-]", "-"),
    matching_case("[x\\-]", "x"),
    matching_case("[x\\-]", "-"),
    non_matching_case("[x\\-]", "z"),
    matching_case("[\\-x]", "x"),
    matching_case("[\\-x]", "-"),
    non_matching_case("[\\-x]", "a"),
    matching_case("*x", "xxx"),
  ]

fn own_matches() -> List<Case> =
  [
    matching_case("", ""),
    non_matching_case("", "a"),
    non_matching_case("a", ""),
    matching_case("*", ""),
    non_matching_case("?", ""),
    matching_case("a/b", "a/b"),
    non_matching_case("a/b", "a//b"),
    non_matching_case("a/b", "a/b/"),
    matching_case("a/b/", "a/b/"),
    matching_case("**", "a"),
    matching_case("**", "a/b/c"),
    non_matching_case("**", ""),
    matching_case("**/c", "c"),
    matching_case("**/c", "a/c"),
    matching_case("**/c", "a/b/c"),
    non_matching_case("**/c", "a/bc"),
    non_matching_case("**/c", "c/d"),
    matching_case("a/**", "a/b"),
    matching_case("a/**", "a/b/c"),
    non_matching_case("a/**", "a"),
    non_matching_case("a/**", "a/"),
    non_matching_case("a/**", "ab/c"),
    matching_case("a/**/c", "a/c"),
    matching_case("a/**/c", "a/b/c"),
    matching_case("a/**/c", "a/b/b/c"),
    non_matching_case("a/**/c", "ac"),
    non_matching_case("a/**/c", "a/b/cd"),
    matching_case("**/*.ply", "main.ply"),
    matching_case("**/*.ply", "src/lib/main.ply"),
    non_matching_case("**/*.ply", "src/lib/main.rs"),
    matching_case("src/**/*.ply", "src/main.ply"),
    matching_case("src/**/*.ply", "src/a/b/main.ply"),
    non_matching_case("src/**/*.ply", "test/main.ply"),
    matching_case("**/**/a", "a"),
    matching_case("**/**/a", "x/y/a"),
    matching_case("**/a/**", "x/a/y"),
    matching_case("**/a/**", "a/y"),
    non_matching_case("**/a/**", "x/a"),
    matching_case("*.{ply,md}", "main.ply"),
    matching_case("*.{ply,md}", "README.md"),
    non_matching_case("*.{ply,md}", "main.rs"),
    matching_case("{src,test/unit}/*.ply", "src/a.ply"),
    matching_case("{src,test/unit}/*.ply", "test/unit/a.ply"),
    non_matching_case("{src,test/unit}/*.ply", "test/a.ply"),
    matching_case("a{,b}c", "ac"),
    matching_case("a{,b}c", "abc"),
    non_matching_case("a{,b}c", "abbc"),
    matching_case("{a,b{c,d}}e", "ae"),
    matching_case("{a,b{c,d}}e", "bce"),
    matching_case("{a,b{c,d}}e", "bde"),
    non_matching_case("{a,b{c,d}}e", "be"),
    matching_case("{a}", "a"),
    matching_case("{}", ""),
    matching_case("{a/**/b,c}", "a/x/b"),
    matching_case("{a/**/b,c}", "a/b"),
    matching_case("{a/**/b,c}", "c"),
    matching_case("{*,?x}", "ax"),
    matching_case("a,b", "a,b"),
    matching_case("{a\\,b,c}", "a,b"),
    non_matching_case("{a\\,b,c}", "a"),
    matching_case("\\{a\\}", "{a}"),
    matching_case("[!a-c]", "d"),
    non_matching_case("[!a-c]", "b"),
    matching_case("[\\!a]", "!"),
    matching_case("[a\\\\]", "\\"),
    non_matching_case("[!a]", "/"),
    non_matching_case("[/]", "/"),
    matching_case("a\\/b", "a/b"),
    non_matching_case("*", ".hidden"),
    non_matching_case("?hidden", ".hidden"),
    non_matching_case("[.]hidden", ".hidden"),
    non_matching_case("[!a]hidden", ".hidden"),
    matching_case(".*", ".hidden"),
    matching_case(".hidden", ".hidden"),
    matching_case("a*", "a.b"),
    matching_case("*.ply", "a.b.ply"),
    non_matching_case("*.ply", ".a.ply"),
    non_matching_case("src/*", "src/.git"),
    matching_case("src/.*", "src/.git"),
    non_matching_case("**", ".git"),
    non_matching_case("**", "a/.git"),
    non_matching_case("**/config", ".git/config"),
    matching_case("**/.git/config", "a/.git/config"),
    non_matching_case("**/*.ply", "a/.b/c.ply"),
    non_matching_case("a/**", "a/.b"),
    matching_case("{.,}*", ".a"),
    non_matching_case("ABC", "abc"),
    non_matching_case("[A-Z]", "a"),
    non_matching_case("*.ply", ".ply"),
    non_matching_case("*.", "."),
    non_matching_case("*\\.", "."),
    non_matching_case("/*.", "/."),
    non_matching_case("*.a", ".a"),
    non_matching_case("*.*", ".a"),
    non_matching_case("a/*.b", "a/.b"),
    non_matching_case("*{.a,b}", ".a"),
    non_matching_case("{a/,*}.b", ".b"),
    matching_case("{a/,*}.b", "a/.b"),
    matching_case("{*,}.a", ".a"),
    matching_case("**/.a", ".a"),
    matching_case("a/{.b,c}", "a/.b"),
    matching_case("\\.a", ".a"),
    matching_case("*.a", "b.a"),
  ]

test "`matches` agrees with the expected result for pattern `{c.pattern}` and path `{c.path}`, taken from Go's glob tests" for c: Case in go_matches(
  ) { assert_eq(matches(glob_of(c.pattern), c.path), c.matches) }

test "`matches` agrees with the expected result for pattern `{c.pattern}` and path `{c.path}`, from this project's own cases" for c: Case in own_matches(
  ) { assert_eq(matches(glob_of(c.pattern), c.path), c.matches) }

