//! Shell-style patterns over paths, compiled once and matched in one pass over the path.
//!
//! A path is text, and nothing here reads a file system. The dialect is not any one shell's:
//!
//! - A pattern writes `/` between segments, whatever separates the path's segments.
//!   `Options.separator` names the path's separator, and nothing is read from the platform.
//! - `?` matches one character and `*` any run of them, never including the separator.
//! - `[abc]`, `[a-z]` and `[!a-z]` (also written `[^a-z]`) match one character of a class, as in
//!   Go's `path.Match`. A class is not empty. A `]`, `-` or `\` in it is written `\]`, `\-` or
//!   `\\`. A range's ends are in order of their scalar values, never a locale's order. A class
//!   never matches the separator, and there are no named classes.
//! - `**` matches whole segments, and is allowed only between a `/` or the pattern's start and a
//!   `/` or its end. `**/` matches zero or more segments, so `a/**/b` matches `a/b`. A closing
//!   `/**` matches everything below, so `a/**` matches `a/b/c` but not `a`, as a `.gitignore`
//!   reads it. `**` alone matches every path except the empty one.
//! - `{a,b}` matches either alternative, as a shell expands it. An alternative may be empty,
//!   contain `/` and wildcards, and contain another brace. A `,` outside braces matches itself,
//!   and a `}` that closes nothing is an error.
//! - `\` makes the next character match itself, and `escape` writes the pattern that matches a
//!   text and nothing else.
//! - A `.` at the start of a path segment is matched only by a `.` at the start of a pattern
//!   segment, as in `fnmatch` and the shells: `*.ply` matches neither `.hidden.ply` nor `.ply`,
//!   and `**` does not enter `.git`. `Options.match_hidden` lets every wildcard match one.
//! - Case matters unless `Options.ignore_case` is set, which lower-cases both sides one character
//!   at a time by Unicode's simple mapping (`char::to_lowercase`). That keeps a text's length, so
//!   `?` matches one character of the path whatever its case. The full mapping would turn `U+0130`
//!   into two characters, and a capital sigma into a final sigma depending on its position.
//!
//! Nothing is normalised: `a//b` and `a/./b` are not `a/b`, and `std.path` normalises them. A
//! match tracks every state the pattern could be in after each character, rather than trying one
//! and backtracking, so no pattern takes time exponential in its length. The time grows with the
//! path's length times the pattern's, and times the pattern's again only where alternatives that
//! may be empty appear in a row. `base` and `enters` let a directory walk prune its search.

import std.char
import std.laws (agrees)
import std.list (enumerate)
import std.map
import std.gen

/// How a pattern matches a path.
pub type Options = {
  /// The character between a path's segments, which a `/` in the pattern matches.
  separator: Char,
  /// Whether `A` matches `a`.
  ignore_case: Bool,
  /// Whether `*`, `?`, a class and `**` match a `.` that leads a segment.
  match_hidden: Bool,
}

/// The default options: `/` between segments, case-sensitive, and a leading `.` matched only by a
/// literal `.`.
pub fn options() -> Options = { separator: '/', ignore_case: false, match_hidden: false }

/// The characters from `lo` to `hi`, inclusive.
type CharRange = { lo: Char, hi: Char }

/// What a pattern state consumes from a path: one character, or any number for `Run` and `Deep`.
type Symbol =
  /// This character.
  | Literal(Char)
  /// The separator.
  | Separator
  /// A character within a segment.
  | One
  /// Characters within a segment, as `*` matches them.
  | Run
  /// Any character, including the separator.
  | Any
  /// Characters across segments, as `**` matches them.
  | Deep
  /// A character within a segment that is in one of the ranges, or in none of them when the flag
  /// is set.
  | Among(Bool, List<CharRange>)
  /// Nothing: the pattern has matched.
  | End

/// One state of a compiled pattern: what it consumes, the states that may follow it, and the ones
/// among them reached without passing over a `*`.
type State = { symbol: Symbol, next: List<Int>, first: List<Int> }

/// A compiled pattern. Two are equal when their patterns and options are the same.
pub type Glob = new {
  options: Options,
  states: Array<State>,
  /// The states a match starts in.
  start: Map<Int, Unit>,
  /// The states of `start` reached without passing over a `*`.
  first: Map<Int, Unit>,
  /// What `base` returns.
  base: String,
  /// What `exact` returns.
  exact: Option<String>,
}

/// Why a pattern is invalid.
pub type ErrorKind =
  /// A `[` whose class is not closed before the pattern ends.
  | UnclosedClass
  /// A class of no characters, `[]` or `[!]`.
  | EmptyClass
  /// A `-` in a class that is not between two characters in order.
  | BadRange
  /// A `{` with no `}`.
  | UnclosedBrace
  /// A `}` with no `{`.
  | UnopenedBrace
  /// A `\` with no character after it.
  | TrailingEscape
  /// A `**` that is not a whole segment.
  | Globstar

/// Why a pattern is invalid, and the index of the character the error is at.
pub type Error = { at: Int, reason: ErrorKind }

/// What `read` raises for an invalid pattern.
pub effect glob {
  /// The text is not a pattern of this dialect.
  raise fail(e: Error)
}

/// An error's reason as a sentence, as a literal's diagnostic shows it.
pub fn reason(reason: ErrorKind) -> String =
  match reason {
    UnclosedClass -> "this class has no closing `]`",
    EmptyClass -> "a class holds at least one character",
    BadRange -> "a `-` stands between two characters in order, or is written `\\-`",
    UnclosedBrace -> "this `{` has no closing `}`",
    UnopenedBrace -> "this `}` closes nothing: write `\\}` for the character",
    TrailingEscape -> "a `\\` goes before a character",
    Globstar -> "`**` is a whole segment: only `/` or an end of the pattern stands beside it",
  }

/// Compiles the pattern under `options()`, or returns where and why it is invalid.
pub fn compile(pattern: String) -> Result<Glob, Error> / {abort.raise} =
  try { read(pattern, options()) }

/// Compiles the pattern to match paths as `o` specifies, or returns where and why it is invalid.
pub fn compile_with(pattern: String, o: Options) -> Result<Glob, Error> / {abort.raise} =
  try { read(pattern, o) }

/// Compiles the pattern to match paths as `o` specifies. Raises `glob.fail` where `compile_with`
/// returns `Err`.
pub fn read(pattern: String, o: Options) -> Glob / {glob.fail, abort.raise} = {
  let written = program_of(pattern);
  let prefix = literal_prefix(written, o.separator);
  let states = states_of(if o.ignore_case { program_of(lowered(pattern)) } else { written });
  {
    options: o,
    states: states.states,
    start: states.start,
    first: states.first,
    base: if prefix.cut < 0 { "" } else { String::of_chars(prefix.text.take(max(prefix.cut, 1))) },
    exact: if prefix.whole { Some(String::of_chars(prefix.text)) } else { None },
  }
}

/// Checks the text of a `glob"..."` literal. Returns the pattern compiled under `options()`, or the
/// character where it is invalid. A literal's text doubles each brace, so `{a,b}` is written
/// `{{a,b}}` there, and a `\` is written `\\`.
pub fn literal(text: String) -> Result<Glob, { message: String, offset: Int }> / {abort.raise} =
  match compile(text) {
    Ok(g) -> Ok(g),
    Err(rejected) -> Err({ message: reason(rejected.reason), offset: rejected.at }),
  }

/// The pattern that matches `text` and nothing else under a `/` separator. Each character with a
/// special meaning in a pattern gets a `\` before it.
pub fn escape(text: String) -> String =
  String::of_chars(
    text.chars().fold([], |acc: List<Char>, c: Char|
      if is_special(c) { acc.push('\\').push(c) } else { acc.push(c) }),
  )

fn is_special(c: Char) -> Bool =
  c == '*' || c == '?' || c == '[' || c == ']' || c == '{' || c == '}' || c == ',' || c == '\\'

// --- Matching ---------------------------------------------------------------

/// Whether the whole of `path` matches.
pub fn matches(g: Glob, path: String) -> Bool = {
  let on = states_after(g, path);
  on.contains(g.states.len() - 1)
}

/// The directory every match is under, for a walk to start from. It is the pattern's leading
/// segments that contain no wildcard, written as a path, or empty when the first segment contains
/// one. It keeps the pattern's own case, whatever `ignore_case` is set to.
pub fn base(g: Glob) -> String = g.base

/// The one path a pattern with no wildcard matches, which a walk can look up by name.
pub fn exact(g: Glob) -> Option<String> = g.exact

/// Whether a walk needs to list the directory `dir`: `false` only when no path under it can match.
/// The empty `dir` is where the walk starts, and it is always entered.
pub fn enters(g: Glob, dir: String) -> Bool = {
  let separator = String::of_chars([g.options.separator]);
  let under = if dir == "" || dir.ends_with(separator) { dir } else { dir ++ separator };
  states_after(g, under).len() > 0
}

/// The progress of a match through a path: the states it may be in, those of them that start a
/// segment of the pattern, and whether the next character starts a segment of the path.
type MatchState = { on: Map<Int, Unit>, first: Map<Int, Unit>, leads: Bool }

/// `text` with each character lower-cased on its own, so that it keeps its length.
fn lowered(text: String) -> String = String::of_chars(text.chars().map(Char::to_lowercase))

/// The states the pattern may be in once `text` is read.
fn states_after(g: Glob, text: String) -> Map<Int, Unit> =
  String::chars(if g.options.ignore_case { lowered(text) } else { text }).fold(
    { on: g.start, first: g.first, leads: true },
    |w: MatchState, c: Char| advance(g, w, c),
  ).on

fn advance(g: Glob, w: MatchState, c: Char) -> MatchState = {
  let hidden = w.leads && c == '.' && !g.options.match_hidden;
  let leads = c == g.options.separator;
  w.on.fold(
    { on: Map::new(), first: Map::new(), leads: leads },
    |next: MatchState, at: Int, _: Unit|
      match g.states.at(at) {
        Some(state) if accepts(
            state.symbol,
            c,
            g.options.separator,
            hidden,
            w.first.contains(at),
          ) ->
          {
            on: insert_all(next.on, state.next),
            first: if leads { insert_all(next.first, state.first) } else { next.first },
            leads: leads,
          },
        _ -> next,
      },
  )
}

fn insert_all(set: Map<Int, Unit>, more: List<Int>) -> Map<Int, Unit> =
  more.fold(set, |reached: Map<Int, Unit>, to: Int| reached.insert(to, ()))

/// Whether a state accepts `c`. `hidden` means `c` is a `.` that starts a segment of the path,
/// which only a `Literal` that is `first`, starting its segment of the pattern, accepts.
fn accepts(symbol: Symbol, c: Char, separator: Char, hidden: Bool, first: Bool) -> Bool =
  match symbol {
    Literal(written) -> c == written && (!hidden || first),
    Separator -> c == separator,
    One | Run -> c != separator && !hidden,
    Any | Deep -> !hidden,
    Among(negated, spans) -> c != separator && !hidden && within(spans, c) != negated,
    End -> false,
  }

fn within(spans: List<CharRange>, c: Char) -> Bool =
  spans.any(|s: CharRange| c >= s.lo && c <= s.hi)

// --- Compiling --------------------------------------------------------------

/// A pattern as instructions: a state, or a choice of where to continue without consuming
/// anything. Every `Fork` and `Jump` goes forward, which lets `states_of` compute their closures in
/// one pass.
type Inst =
  | Take(Symbol)
  /// The next instruction, or the one at this index.
  | Fork(Int)
  | Jump(Int)

/// An open `{`: its position, the `Fork` that started its current alternative, and the `Jump` that
/// ends each earlier alternative.
type Brace = { at: Int, fork: Int, jumps: List<Int> }

/// What comes before the character being read, as far as a `**` cares: a segment's start, one `*`
/// and whether it was at a segment's start, a `**`, or anything else.
type Before = | SegmentStart | Star(Bool) | DoubleStar | Mid

type Step = | First | Item | PendingChar(Char) | Dash(Char)

type Class = { open: Int, negated: Bool, spans: List<CharRange>, step: Step, escaped: Bool }

type Mode = | Plain | Escaped | InClass(Class)

type Parser = { at: Int, program: List<Inst>, mode: Mode, braces: List<Brace>, before: Before }

fn fail<a>(at: Int, reason: ErrorKind) -> a / {glob.fail} = glob.fail({ at: at, reason: reason })

fn program_of(pattern: String) -> List<Inst> / {glob.fail, abort.raise} =
  finish_program(
    pattern.chars().fold(
      { at: 0, program: [], mode: Plain, braces: [], before: SegmentStart },
      |p: Parser, c: Char| {
        let read = match p.mode {
          Plain -> parse_plain(p, c),
          Escaped -> emit(p, Literal(c)),
          InClass(k) -> parse_class_char(p, k, c),
        };
        { ..read, at: p.at + 1 }
      },
    ),
  )

fn emit(p: Parser, symbol: Symbol) -> Parser =
  { ..p, program: p.program.push(Take(symbol)), mode: Plain, before: Mid }

fn parse_plain(p: Parser, c: Char) -> Parser / {glob.fail, abort.raise} =
  if p.before == DoubleStar {
    if c == '/' {
      let star = p.program.len() - 1;
      {
        ..p,
        program: p.program.set(star, Fork(star + 3)).push(Take(Deep)).push(Take(Separator)),
        before: SegmentStart,
      }
    } else { fail(p.at - 2, Globstar) }
  } else if c == '*' {
    match p.before {
      Star(true) -> { ..p, before: DoubleStar },
      Star(false) -> fail(p.at - 1, Globstar),
      SegmentStart -> { ..emit(p, Run), before: Star(true) },
      _ -> { ..emit(p, Run), before: Star(false) },
    }
  } else if c == '?' { emit(p, One) } else if c == '[' {
    { ..p, mode: InClass({ open: p.at, negated: false, spans: [], step: First, escaped: false }) }
  } else if c == '{' {
    {
      ..p,
      program: p.program.push(Fork(0)),
      braces: p.braces.push({ at: p.at, fork: p.program.len(), jumps: [] }),
      before: Mid,
    }
  } else if c == ',' { next_alternative(p) }
  else if c == '}' { close_brace(p) }
  else if c == '\\' { { ..p, mode: Escaped } }
  else if c == '/' { { ..emit(p, Separator), before: SegmentStart } }
  else { emit(p, Literal(c)) }

/// A `,`: the end of one alternative of the innermost brace and the start of its next.
fn next_alternative(p: Parser) -> Parser / {abort.raise} =
  match p.braces.at(p.braces.len() - 1) {
    None -> emit(p, Literal(',')),
    Some(b) -> {
      let jump = p.program.len();
      {
        ..p,
        program: p.program.set(b.fork, Fork(jump + 1)).push(Jump(0)).push(Fork(0)),
        braces: p.braces.set(p.braces.len() - 1, {
          ..b,
          fork: jump + 1,
          jumps: b.jumps.push(jump),
        }),
        before: Mid,
      }
    },
  }

/// A `}`: the last alternative has no further one to fork to, and every earlier one continues from
/// here.
fn close_brace(p: Parser) -> Parser / {glob.fail, abort.raise} =
  match p.braces.at(p.braces.len() - 1) {
    None -> fail(p.at, UnopenedBrace),
    Some(b) -> {
      let end = p.program.len();
      {
        ..p,
        program: b.jumps.fold(
          p.program.set(b.fork, Jump(b.fork + 1)),
          |program: List<Inst>, jump: Int| program.set(jump, Jump(end)),
        ),
        braces: p.braces.take(p.braces.len() - 1),
        before: Mid,
      }
    },
  }

fn parse_class_char(p: Parser, k: Class, c: Char) -> Parser / {glob.fail} =
  if k.escaped { member(p, { ..k, escaped: false }, c) }
  else if c == '\\' { { ..p, mode: InClass({ ..k, escaped: true }) } }
  else if k.step == First && (c == '!' || c == '^') {
    { ..p, mode: InClass({ ..k, negated: true, step: Item }) }
  } else if c == ']' {
    match k.step {
      Dash(_) -> fail(p.at, BadRange),
      PendingChar(lo) -> emit(p, Among(k.negated, k.spans.push({ lo: lo, hi: lo }))),
      _ -> if k.spans.len() == 0 { fail(k.open, EmptyClass) }
      else { emit(p, Among(k.negated, k.spans)) },
    }
  } else if c == '-' {
    match k.step {
      PendingChar(lo) -> { ..p, mode: InClass({ ..k, step: Dash(lo) }) },
      _ -> fail(p.at, BadRange),
    }
  } else { member(p, k, c) }

/// A character of a class: a range's upper end, or one that may yet open a range.
fn member(p: Parser, k: Class, c: Char) -> Parser / {glob.fail} =
  match k.step {
    Dash(lo) -> if c < lo { fail(p.at, BadRange) }
    else { { ..p, mode: InClass({ ..k, spans: k.spans.push({ lo: lo, hi: c }), step: Item }) } },
    PendingChar(lo) ->
      {
        ..p,
        mode: InClass({ ..k, spans: k.spans.push({ lo: lo, hi: lo }), step: PendingChar(c) }),
      },
    _ -> { ..p, mode: InClass({ ..k, step: PendingChar(c) }) },
  }

fn finish_program(p: Parser) -> List<Inst> / {glob.fail, abort.raise} =
  match p.mode {
    Escaped -> fail(p.at - 1, TrailingEscape),
    InClass(k) -> fail(k.open, UnclosedClass),
    Plain -> match p.braces.at(p.braces.len() - 1) {
      Some(b) -> fail(b.at, UnclosedBrace),
      None ->
        List::push(
          if p.before == DoubleStar {
            p.program.set(p.program.len() - 1, Take(Any)).push(Take(Deep))
          } else { p.program },
          Take(End),
        ),
    },
  }

fn loops(symbol: Symbol) -> Bool = symbol == Run || symbol == Deep

/// Each instruction as a state, and the states a match starts in. A state is followed by every
/// state reachable without consuming anything from the next instruction, or from itself when it
/// loops. `first` are the states reached without skipping a loop, that is, without passing over a
/// `*`.
fn states_of(
  program: List<Inst>,
) -> { states: Array<State>, start: Map<Int, Unit>, first: Map<Int, Unit> } = {
  let reached = epsilon_closures(program, true);
  let led = epsilon_closures(program, false);
  {
    states: Array::of_list(
      enumerate(program).map(|i: { index: Int, value: Inst }|
        match i.value {
          Take(symbol) -> {
            let states_after = if loops(symbol) { i.index } else { i.index + 1 };
            {
              symbol: symbol,
              next: closure_at(reached, states_after).keys(),
              first: closure_at(led, states_after).keys(),
            }
          },
          _ -> { symbol: End, next: [], first: [] },
        }),
    ),
    start: closure_at(reached, 0),
    first: closure_at(led, 0),
  }
}

/// For each instruction, the states reachable from it without consuming anything. A loop continues
/// to what follows it only when `past_loops` is set.
fn epsilon_closures(program: List<Inst>, past_loops: Bool) -> Map<Int, Map<Int, Unit>> =
  enumerate(program).reverse().fold(
    Map::new(),
    |done: Map<Int, Map<Int, Unit>>, i: { index: Int, value: Inst }|
      done.insert(i.index, match i.value {
        Take(symbol) ->
          Map::insert(
            if past_loops && loops(symbol) { closure_at(done, i.index + 1) } else { Map::new() },
            i.index,
            (),
          ),
        Fork(to) -> closure_at(done, i.index + 1).merge(closure_at(done, to)),
        Jump(to) -> closure_at(done, to),
      }),
  )

/// The states reachable from the instruction at `at` without consuming anything, and none past the
/// last instruction.
fn closure_at(reached: Map<Int, Map<Int, Unit>>, at: Int) -> Map<Int, Unit> =
  reached.get_or(at, Map::new())

/// The characters a pattern starts with before its first wildcard or brace, the position of the
/// last separator among them, and whether they are the whole pattern.
fn literal_prefix(
  program: List<Inst>,
  separator: Char,
) -> { text: List<Char>, cut: Int, open: Bool, whole: Bool } =
  program.fold(
    { text: [], cut: -1, open: true, whole: false },
    |s: { text: List<Char>, cut: Int, open: Bool, whole: Bool }, inst: Inst|
      if !s.open { s } else {
        match inst {
          Take(Literal(c)) -> { ..s, text: s.text.push(c) },
          Take(Separator) -> { ..s, text: s.text.push(separator), cut: s.text.len() },
          Take(End) -> { ..s, open: false, whole: true },
          _ -> { ..s, open: false },
        }
      },
  )

// --- Tests ------------------------------------------------------------------

fn glob_of(pattern: String) -> Glob / {abort.raise} =
  match compile(pattern) {
    Ok(g) -> g,
    Err(_) -> panic("`" ++ pattern ++ "` is a fixture's pattern"),
  }

type Case = { pattern: String, path: String, matches: Bool }

fn yes(pattern: String, path: String) -> Case = { pattern: pattern, path: path, matches: true }

fn no(pattern: String, path: String) -> Case = { pattern: pattern, path: path, matches: false }

/// The rows of Go's `matchTests`, which `path/filepath` and `path` both contain, that have a valid
/// pattern. Go has no `**`, no braces and no `!`, and its `*` matches a leading `.`, which no row
/// here tests.
fn go_matches() -> List<Case> =
  [
    yes("abc", "abc"),
    yes("*", "abc"),
    yes("*c", "abc"),
    yes("a*", "a"),
    yes("a*", "abc"),
    no("a*", "ab/c"),
    yes("a*/b", "abc/b"),
    no("a*/b", "a/c/b"),
    yes("a*b*c*d*e*/f", "axbxcxdxe/f"),
    yes("a*b*c*d*e*/f", "axbxcxdxexxx/f"),
    no("a*b*c*d*e*/f", "axbxcxdxe/xxx/f"),
    no("a*b*c*d*e*/f", "axbxcxdxexxx/fff"),
    yes("a*b?c*x", "abxbbxdbxebxczzx"),
    no("a*b?c*x", "abxbbxdbxebxczzy"),
    yes("ab[c]", "abc"),
    yes("ab[b-d]", "abc"),
    no("ab[e-g]", "abc"),
    no("ab[^c]", "abc"),
    no("ab[^b-d]", "abc"),
    yes("ab[^e-g]", "abc"),
    yes("a\\*b", "a*b"),
    no("a\\*b", "ab"),
    yes("a?b", "a\u{263a}b"),
    yes("a[^a]b", "a\u{263a}b"),
    no("a???b", "a\u{263a}b"),
    no("a[^a][^a][^a]b", "a\u{263a}b"),
    yes("[a-\u{3b6}]*", "\u{3b1}"),
    no("*[a-\u{3b6}]", "A"),
    no("a?b", "a/b"),
    no("a*b", "a/b"),
    yes("[\\]a]", "]"),
    yes("[\\-]", "-"),
    yes("[x\\-]", "x"),
    yes("[x\\-]", "-"),
    no("[x\\-]", "z"),
    yes("[\\-x]", "x"),
    yes("[\\-x]", "-"),
    no("[\\-x]", "a"),
    yes("*x", "xxx"),
  ]

/// What this dialect adds to Go's: `**`, braces, hidden segments, and `!` in a class.
fn own_matches() -> List<Case> =
  [
    yes("", ""),
    no("", "a"),
    no("a", ""),
    yes("*", ""),
    no("?", ""),
    yes("a/b", "a/b"),
    no("a/b", "a//b"),
    no("a/b", "a/b/"),
    yes("a/b/", "a/b/"),
    yes("**", "a"),
    yes("**", "a/b/c"),
    no("**", ""),
    yes("**/c", "c"),
    yes("**/c", "a/c"),
    yes("**/c", "a/b/c"),
    no("**/c", "a/bc"),
    no("**/c", "c/d"),
    yes("a/**", "a/b"),
    yes("a/**", "a/b/c"),
    no("a/**", "a"),
    no("a/**", "a/"),
    no("a/**", "ab/c"),
    yes("a/**/c", "a/c"),
    yes("a/**/c", "a/b/c"),
    yes("a/**/c", "a/b/b/c"),
    no("a/**/c", "ac"),
    no("a/**/c", "a/b/cd"),
    yes("**/*.ply", "main.ply"),
    yes("**/*.ply", "src/lib/main.ply"),
    no("**/*.ply", "src/lib/main.rs"),
    yes("src/**/*.ply", "src/main.ply"),
    yes("src/**/*.ply", "src/a/b/main.ply"),
    no("src/**/*.ply", "test/main.ply"),
    yes("**/**/a", "a"),
    yes("**/**/a", "x/y/a"),
    yes("**/a/**", "x/a/y"),
    yes("**/a/**", "a/y"),
    no("**/a/**", "x/a"),
    yes("*.{ply,md}", "main.ply"),
    yes("*.{ply,md}", "README.md"),
    no("*.{ply,md}", "main.rs"),
    yes("{src,test/unit}/*.ply", "src/a.ply"),
    yes("{src,test/unit}/*.ply", "test/unit/a.ply"),
    no("{src,test/unit}/*.ply", "test/a.ply"),
    yes("a{,b}c", "ac"),
    yes("a{,b}c", "abc"),
    no("a{,b}c", "abbc"),
    yes("{a,b{c,d}}e", "ae"),
    yes("{a,b{c,d}}e", "bce"),
    yes("{a,b{c,d}}e", "bde"),
    no("{a,b{c,d}}e", "be"),
    yes("{a}", "a"),
    yes("{}", ""),
    yes("{a/**/b,c}", "a/x/b"),
    yes("{a/**/b,c}", "a/b"),
    yes("{a/**/b,c}", "c"),
    yes("{*,?x}", "ax"),
    yes("a,b", "a,b"),
    yes("{a\\,b,c}", "a,b"),
    no("{a\\,b,c}", "a"),
    yes("\\{a\\}", "{a}"),
    yes("[!a-c]", "d"),
    no("[!a-c]", "b"),
    yes("[\\!a]", "!"),
    yes("[a\\\\]", "\\"),
    no("[!a]", "/"),
    no("[/]", "/"),
    yes("a\\/b", "a/b"),
    no("*", ".hidden"),
    no("?hidden", ".hidden"),
    no("[.]hidden", ".hidden"),
    no("[!a]hidden", ".hidden"),
    yes(".*", ".hidden"),
    yes(".hidden", ".hidden"),
    yes("a*", "a.b"),
    yes("*.ply", "a.b.ply"),
    no("*.ply", ".a.ply"),
    no("src/*", "src/.git"),
    yes("src/.*", "src/.git"),
    no("**", ".git"),
    no("**", "a/.git"),
    no("**/config", ".git/config"),
    yes("**/.git/config", "a/.git/config"),
    no("**/*.ply", "a/.b/c.ply"),
    no("a/**", "a/.b"),
    yes("{.,}*", ".a"),
    no("ABC", "abc"),
    no("[A-Z]", "a"),
    no("*.ply", ".ply"),
    no("*.", "."),
    no("*\\.", "."),
    no("/*.", "/."),
    no("*.a", ".a"),
    no("*.*", ".a"),
    no("a/*.b", "a/.b"),
    no("*{.a,b}", ".a"),
    no("{a/,*}.b", ".b"),
    yes("{a/,*}.b", "a/.b"),
    yes("{*,}.a", ".a"),
    yes("**/.a", ".a"),
    yes("a/{.b,c}", "a/.b"),
    yes("\\.a", ".a"),
    yes("*.a", "b.a"),
  ]

test "`{c.pattern}` and `{c.path}`, as Go's table has them" for c: Case in go_matches() {
  assert_eq(matches(glob_of(c.pattern), c.path), c.matches)
}

test "`{c.pattern}` and `{c.path}`" for c: Case in own_matches() {
  assert_eq(matches(glob_of(c.pattern), c.path), c.matches)
}

/// The paths of one small tree, including its directories.
fn tree() -> List<String> =
  [
    ".git",
    ".git/config",
    ".hidden",
    "a",
    "a.b",
    "ab",
    "c",
    "src",
    "src/.cache",
    "src/.cache/x.ply",
    "src/README.md",
    "src/lib",
    "src/lib/deep",
    "src/lib/deep/more.ply",
    "src/lib/util.ply",
    "src/main.ply",
    "test",
    "test/unit",
    "test/unit/t.ply",
    "x",
    "x/a",
    "x/a/y",
    "x/c",
  ]

type Expanded = { pattern: String, paths: List<String> }

/// What bash 3.2, zsh 5.9 and Python 3.14's `glob` each expand a pattern to over `tree`, for
/// patterns where every one that supports the pattern gives the same result. Bash has no `**`
/// there, and Python no braces.
fn expanded() -> List<Expanded> =
  [
    { pattern: "*", paths: ["a", "a.b", "ab", "c", "src", "test", "x"] },
    { pattern: "?", paths: ["a", "c", "x"] },
    { pattern: "??", paths: ["ab"] },
    { pattern: "a*", paths: ["a", "a.b", "ab"] },
    { pattern: "*b", paths: ["a.b", "ab"] },
    { pattern: "*.ply", paths: [] },
    { pattern: ".*", paths: [".git", ".hidden"] },
    { pattern: ".h*", paths: [".hidden"] },
    { pattern: "src/*", paths: ["src/README.md", "src/lib", "src/main.ply"] },
    { pattern: "src/*.ply", paths: ["src/main.ply"] },
    { pattern: "src/.*", paths: ["src/.cache"] },
    { pattern: "src/.*/*", paths: ["src/.cache/x.ply"] },
    {
      pattern: "*/*",
      paths: ["src/README.md", "src/lib", "src/main.ply", "test/unit", "x/a", "x/c"],
    },
    { pattern: "*/*/*", paths: ["src/lib/deep", "src/lib/util.ply", "test/unit/t.ply", "x/a/y"] },
    { pattern: "*/*/*.ply", paths: ["src/lib/util.ply", "test/unit/t.ply"] },
    { pattern: "src/*/*.ply", paths: ["src/lib/util.ply"] },
    { pattern: "[a-c]", paths: ["a", "c"] },
    { pattern: "[!a-c]*", paths: ["src", "test", "x"] },
    { pattern: "[ac]*", paths: ["a", "a.b", "ab", "c"] },
    { pattern: "?[.b]*", paths: ["a.b", "ab"] },
    { pattern: "{a,c}", paths: ["a", "c"] },
    { pattern: "*.{ply,md}", paths: [] },
    { pattern: "src/*.{ply,md}", paths: ["src/README.md", "src/main.ply"] },
    { pattern: "{src,test/unit}/*.ply", paths: ["src/main.ply", "test/unit/t.ply"] },
    { pattern: "a{,b}", paths: ["a", "ab"] },
    { pattern: "a{b,.b}", paths: ["a.b", "ab"] },
    { pattern: "{a,.hidden}", paths: [".hidden", "a"] },
    { pattern: "{src,x}/{lib,a}/*", paths: ["src/lib/deep", "src/lib/util.ply", "x/a/y"] },
    { pattern: "{*.b,?}", paths: ["a", "a.b", "c", "x"] },
    {
      pattern: "**/*.ply",
      paths: ["src/lib/deep/more.ply", "src/lib/util.ply", "src/main.ply", "test/unit/t.ply"],
    },
    {
      pattern: "src/**/*.ply",
      paths: ["src/lib/deep/more.ply", "src/lib/util.ply", "src/main.ply"],
    },
    { pattern: "**/c", paths: ["c", "x/c"] },
    { pattern: "**/a", paths: ["a", "x/a"] },
    { pattern: "**/y", paths: ["x/a/y"] },
    { pattern: "x/**/y", paths: ["x/a/y"] },
    { pattern: "x/**/c", paths: ["x/c"] },
    { pattern: "**/.git/config", paths: [".git/config"] },
    { pattern: "**/config", paths: [] },
    { pattern: "**/lib/**/*.ply", paths: ["src/lib/deep/more.ply", "src/lib/util.ply"] },
    {
      pattern: "**/*",
      paths: [
        "a",
        "a.b",
        "ab",
        "c",
        "src",
        "src/README.md",
        "src/lib",
        "src/lib/deep",
        "src/lib/deep/more.ply",
        "src/lib/util.ply",
        "src/main.ply",
        "test",
        "test/unit",
        "test/unit/t.ply",
        "x",
        "x/a",
        "x/a/y",
        "x/c",
      ],
    },
  ]

/// A closing `**`, where those three disagree and this dialect differs from all of them. Zsh reads
/// it as `*`. Python, like bash's `globstar`, also returns the directory itself. Here it matches
/// everything under the directory but not the directory.
fn expanded_here() -> List<Expanded> =
  [
    {
      pattern: "src/**",
      paths: [
        "src/README.md",
        "src/lib",
        "src/lib/deep",
        "src/lib/deep/more.ply",
        "src/lib/util.ply",
        "src/main.ply",
      ],
    },
    { pattern: "x/**", paths: ["x/a", "x/a/y", "x/c"] },
    {
      pattern: "**",
      paths: [
        "a",
        "a.b",
        "ab",
        "c",
        "src",
        "src/README.md",
        "src/lib",
        "src/lib/deep",
        "src/lib/deep/more.ply",
        "src/lib/util.ply",
        "src/main.ply",
        "test",
        "test/unit",
        "test/unit/t.ply",
        "x",
        "x/a",
        "x/a/y",
        "x/c",
      ],
    },
  ]

test "`{c.pattern}` over the tree is what its row lists" for c: Expanded in expanded().concat(
    expanded_here(),
  ) {
  let g = glob_of(c.pattern);
  assert_eq(tree().filter(|path: String| matches(g, path)), c.paths)
}

type ErrorCase = { pattern: String, at: Int, reason: ErrorKind }

/// The malformed patterns of Go's `matchTests`. Go reports each as an error only for some paths,
/// and this reader rejects each for all paths.
fn go_rejected() -> List<ErrorCase> =
  [
    { pattern: "[]a]", at: 0, reason: EmptyClass },
    { pattern: "[-]", at: 1, reason: BadRange },
    { pattern: "[x-]", at: 3, reason: BadRange },
    { pattern: "[-x]", at: 1, reason: BadRange },
    { pattern: "\\", at: 0, reason: TrailingEscape },
    { pattern: "[a-b-c]", at: 4, reason: BadRange },
    { pattern: "[", at: 0, reason: UnclosedClass },
    { pattern: "[^", at: 0, reason: UnclosedClass },
    { pattern: "[^bc", at: 0, reason: UnclosedClass },
    { pattern: "a[", at: 1, reason: UnclosedClass },
    { pattern: "a/b[", at: 3, reason: UnclosedClass },
  ]

fn own_rejected() -> List<ErrorCase> =
  [
    { pattern: "[!]", at: 0, reason: EmptyClass },
    { pattern: "[z-a]", at: 3, reason: BadRange },
    { pattern: "[a--]", at: 3, reason: BadRange },
    { pattern: "[a\\", at: 0, reason: UnclosedClass },
    { pattern: "ab\\", at: 2, reason: TrailingEscape },
    { pattern: "{a,b", at: 0, reason: UnclosedBrace },
    { pattern: "x{a,{b}", at: 1, reason: UnclosedBrace },
    { pattern: "a}", at: 1, reason: UnopenedBrace },
    { pattern: "{a}}", at: 3, reason: UnopenedBrace },
    { pattern: "a**", at: 1, reason: Globstar },
    { pattern: "**a", at: 0, reason: Globstar },
    { pattern: "a/**b", at: 2, reason: Globstar },
    { pattern: "a/b**/c", at: 3, reason: Globstar },
    { pattern: "***", at: 0, reason: Globstar },
    { pattern: "{**,a}", at: 1, reason: Globstar },
    { pattern: "{a,**}", at: 3, reason: Globstar },
    { pattern: "{a/**,b}", at: 3, reason: Globstar },
    { pattern: "a/**\\/b", at: 2, reason: Globstar },
  ]

test "`{c.pattern}` is rejected where it goes wrong" for c: ErrorCase in go_rejected().concat(
    own_rejected(),
  ) {
  assert_eq(compile(c.pattern), Err({ at: c.at, reason: c.reason }));
  assert_eq(try { read(c.pattern, options()) }, Err({ at: c.at, reason: c.reason }))
}

test "the options set the separator, case and hidden segments" {
  let windows = { ..options(), separator: '\\' };
  let g = result_glob(compile_with("src/**/*.ply", windows));
  assert(matches(g, "src\\a\\b.ply"));
  assert(!matches(g, "src/a/b.ply"));
  assert(matches(result_glob(compile_with("*", windows)), "a/b"));
  assert(!matches(result_glob(compile_with("*", windows)), "a\\b"));
  let folded = result_glob(compile_with("SRC/[A-C]*.Ply", { ..options(), ignore_case: true }));
  assert(matches(folded, "src/bee.PLY"));
  assert(matches(folded, "Src/Cee.ply"));
  assert(!matches(folded, "src/dee.ply"));
  let cased = |pattern: String|
    result_glob(compile_with(pattern, { ..options(), ignore_case: true }));
  // Each character is lower-cased on its own: `U+0130` stays one character, and a sigma lower-cases
  // the same wherever it is.
  assert(matches(cased("?stanbul"), "\u{130}STANBUL"));
  assert(matches(cased("\u{130}*"), "\u{130}zmir"));
  assert(!matches(cased("i?stanbul"), "\u{130}stanbul"));
  assert(matches(cased("\u{39f}\u{394}\u{39f}\u{3a3}"), "\u{3bf}\u{3b4}\u{3bf}\u{3c3}"));
  assert(matches(cased("\u{c9}t\u{c9}.txt"), "\u{e9}T\u{e9}.TXT"));
  assert(matches(cased("stra\u{df}e"), "STRA\u{df}E"));
  assert(!matches(cased("strasse"), "stra\u{df}e"));
  assert(!matches(result_glob(compile("\u{c9}")), "\u{e9}"));
  let dotted = result_glob(compile_with("**/*", { ..options(), match_hidden: true }));
  assert(matches(dotted, ".git/config"));
  assert(matches(dotted, "a/.hidden"));
  assert(!matches(glob_of("**/*"), "a/.hidden"))
}

fn result_glob(r: Result<Glob, Error>) -> Glob / {abort.raise} =
  match r { Ok(g) -> g, Err(e) -> panic(reason(e.reason)) }

type Start = { pattern: String, base: String, exact: Option<String> }

fn starts() -> List<Start> =
  [
    { pattern: "src/lib/**/*.ply", base: "src/lib", exact: None },
    { pattern: "src/*.ply", base: "src", exact: None },
    { pattern: "src/lib*/x", base: "src", exact: None },
    { pattern: "*.ply", base: "", exact: None },
    { pattern: "**", base: "", exact: None },
    { pattern: "{a,b}/x", base: "", exact: None },
    { pattern: "src/{a,b}", base: "src", exact: None },
    { pattern: "src/main.ply", base: "src", exact: Some("src/main.ply") },
    { pattern: "main.ply", base: "", exact: Some("main.ply") },
    { pattern: "/etc/*.conf", base: "/etc", exact: None },
    { pattern: "/*.conf", base: "/", exact: None },
    { pattern: "a\\*b/c*", base: "a*b", exact: None },
    { pattern: "", base: "", exact: Some("") },
  ]

test "a walk for `{c.pattern}` starts at `{c.base}`" for c: Start in starts() {
  let g = glob_of(c.pattern);
  assert_eq(base(g), c.base);
  assert_eq(exact(g), c.exact);
  assert(enters(g, c.base))
}

test "a walk enters only the directories a match can lie under" {
  let sources = glob_of("src/**/*.ply");
  assert(enters(sources, ""));
  assert(enters(sources, "src"));
  assert(enters(sources, "src/"));
  assert(enters(sources, "src/a/b"));
  assert(!enters(sources, "test"));
  assert(!enters(sources, "src/.git"));
  assert(!enters(sources, "srcs"));
  let flat = glob_of("src/*.ply");
  assert(enters(flat, "src"));
  assert(!enters(flat, "src/a"));
  assert(!enters(glob_of("src/main.ply"), "src/main.ply"));
  let cased = result_glob(compile_with("Src/*.ply", { ..options(), ignore_case: true }));
  assert_eq(base(cased), "Src");
  assert(enters(cased, "SRC"));
  let windows = result_glob(compile_with("src/lib/*", { ..options(), separator: '\\' }));
  assert_eq(base(windows), "src\\lib");
  assert(enters(windows, "src\\lib"))
}

test "an escaped text is the pattern of that text alone" {
  assert_eq(escape("a*b?[c]{d,e}\\"), "a\\*b\\?\\[c\\]\\{d\\,e\\}\\\\");
  assert_eq(escape("src/main.ply"), "src/main.ply");
  let g = glob_of(escape("*.{ply,md}"));
  assert(matches(g, "*.{ply,md}"));
  assert(!matches(g, "a.ply"));
  assert_eq(exact(g), Some("*.{ply,md}"))
}

test "a literal's check returns the pattern, or the character where it is invalid" {
  assert_eq(literal("src/**/*.ply"), Ok(glob_of("src/**/*.ply")));
  assert_eq(
    literal("src/**.ply"),
    Err({
      message: "`**` is a whole segment: only `/` or an end of the pattern stands beside it",
      offset: 4,
    }),
  );
  assert_eq(literal("[a"), Err({ message: "this class has no closing `]`", offset: 0 }))
}

/// `a*a*..a*b`, which a backtracking matcher takes `2^n` steps to reject.
fn stars(n: Int) -> String = range(0, n).fold("", |acc: String, _: Int| acc ++ "a*") ++ "b"

fn run_of(n: Int) -> String = range(0, n).fold("", |acc: String, _: Int| acc ++ "a")

test "a pattern of many stars rejects a run that lacks its last character, and matches one that ends in it" {
  let g = glob_of(stars(24));
  assert(!matches(g, run_of(48)));
  assert(matches(g, run_of(48) ++ "b"))
}

/// `{,a}{,a}..`, whose every alternative may be empty, so each state has all the later ones
/// after it.
fn options_in_a_row(n: Int) -> String = range(0, n).fold("", |acc: String, _: Int| acc ++ "{,a}")

test "alternatives that may be empty match a run as long as all of them, and no longer" {
  let g = glob_of(options_in_a_row(24));
  assert(matches(g, run_of(24)));
  assert(!matches(g, run_of(25)))
}

/// A `Drawn` as a test draws one.
fn drawns() -> gen::Gen<Drawn> =
  gen::map3(
    gen::list(gen::any_int()),
    gen::bool(),
    gen::list(gen::any_int()),
    |pattern: List<Int>, deep: Bool, path: List<Int>| { pattern: pattern, deep: deep, path: path },
  )

test "an escaped text compiles, and matches that text and no other" {
  gen::check2(gen::text(), gen::text(), |text: String, other: String| {
    let g = glob_of(escape(text));
    matches(g, text) && matches(g, other) == (other == text)
  })
}

/// A pattern as a test draws one: the pieces a naive matcher reads directly.
type Piece = | Exactly(Char) | Slash | Single | Many | Dirs | Rest | Ranged(Bool, Char, Char)

/// Pieces from any integers, with `**` only where a whole segment may be, and no two `*` side by
/// side, which would form a `**`. The alphabet is small and heavy with dots, stars and slashes, so
/// a drawn pattern often matches a drawn path and often meets a leading dot.
fn pieces_of(seeds: List<Int>) -> List<Piece> =
  seeds.fold([], |pieces: List<Piece>, n: Int| {
    let last = pieces.at(pieces.len() - 1);
    let fresh = last == None || last == Some(Slash) || last == Some(Dirs);
    let star = if last == Some(Many) { Single } else { Many };
    pieces.push(match n & 7 {
      0 -> Slash,
      1 -> Single,
      2 -> star,
      3 -> if fresh && n & 8 != 0 { Dirs } else { star },
      4 -> Ranged(n & 8 != 0, 'a', if n & 16 != 0 { 'b' } else { 'a' }),
      5 | 6 -> Exactly('.'),
      _ -> Exactly(if n & 8 != 0 { 'a' } else { 'b' }),
    })
  })

fn closing(seeds: List<Int>, deep: Bool) -> List<Piece> = {
  let pieces = pieces_of(seeds);
  let last = pieces.at(pieces.len() - 1);
  if deep && (last == None || last == Some(Slash) || last == Some(Dirs)) { pieces.push(Rest) }
  else { pieces }
}

fn pattern_of(pieces: List<Piece>) -> String =
  pieces.fold("", |acc: String, p: Piece|
    acc
      ++ (match p {
        Exactly(c) -> String::of_chars([c]),
        Slash -> "/",
        Single -> "?",
        Many -> "*",
        Dirs -> "**/",
        Rest -> "**",
        Ranged(negated, lo, hi) ->
          "[" ++ (if negated { "!" } else { "" }) ++ String::of_chars([lo, '-', hi]) ++ "]",
      }))

fn path_of(seeds: List<Int>) -> String =
  String::of_chars(
    seeds.map(|n: Int| match n & 7 { 0 | 1 -> '/', 2 | 3 | 4 -> '.', 5 | 6 -> 'a', _ -> 'b' }),
  )

/// Whether `pieces` match `path`, found by trying every way to match. `fresh` is whether the path
/// is at a segment's start. `led` is whether the pattern is at the start of one of its own
/// segments, which it is not after passing over a `*`.
fn naive(pieces: List<Piece>, path: List<Char>, fresh: Bool, led: Bool) -> Bool =
  match pieces {
    [] -> path.len() == 0,
    [Many, ..rest] ->
      naive(rest, path, fresh, false)
        || (match path {
          [c, ..more] -> inside(c, fresh) && naive(pieces, more, false, false),
          [] -> false,
        }),
    [Dirs, ..rest] -> naive(rest, path, fresh, led) || deep(rest, path, fresh),
    [Rest, ..] -> path.len() > 0 && whole(path, fresh),
    [piece, ..rest] -> match path {
      [] -> false,
      [c, ..more] -> one(piece, c, fresh, led) && naive(rest, more, c == '/', piece == Slash),
    },
  }

/// `**/` past its first character: any run that ends in a separator, then the rest.
fn deep(rest: List<Piece>, path: List<Char>, fresh: Bool) -> Bool =
  match path {
    [] -> false,
    [c, ..more] ->
      (c == '/' && naive(rest, more, true, true))
        || (shown(c, fresh) && deep(rest, more, c == '/')),
  }

fn whole(path: List<Char>, fresh: Bool) -> Bool =
  match path { [] -> true, [c, ..more] -> shown(c, fresh) && whole(more, c == '/') }

fn shown(c: Char, fresh: Bool) -> Bool = !(fresh && c == '.')

fn inside(c: Char, fresh: Bool) -> Bool = c != '/' && shown(c, fresh)

fn one(piece: Piece, c: Char, fresh: Bool, led: Bool) -> Bool =
  match piece {
    Exactly(written) -> c == written && (led || shown(c, fresh)),
    Slash -> c == '/',
    Single -> inside(c, fresh),
    Ranged(negated, lo, hi) -> inside(c, fresh) && (c >= lo && c <= hi) != negated,
    _ -> false,
  }

type Drawn = { pattern: List<Int>, deep: Bool, path: List<Int> }

test "the automaton matches what trying every way to match does" {
  gen::check(drawns(), |x: Drawn|
    agrees(
      |d: Drawn| matches(glob_of(pattern_of(closing(d.pattern, d.deep))), path_of(d.path)),
      |d: Drawn| naive(closing(d.pattern, d.deep), path_of(d.path).chars(), true, true),
      x,
    ))
}
