  [
    ".git",
    ".git/config",
    ".hidden",
    "a",
    "a.b",
    "ab",
    "c",
    "src",
    "src/.cache",
    "src/.cache/x.ply",
    "src/README.md",
    "src/lib",
    "src/lib/deep",
