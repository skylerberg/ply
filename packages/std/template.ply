//! Templates: text with places for data, read once and filled without running anything.
//!
//! A template is text in which `{{ ... }}` is an action. `read` parses one into a `Template`, or
//! refuses with the place and the reason, and `fill` writes it over data: a `std.value` `Value`,
//! which `reflect(x)` makes of any value and `of_json` of a JSON document. Whatever keeps a
//! template from being filled is a typed failure and never an empty place in the output: a path
//! with nothing at it, a value of the wrong kind for its use, a template `include` cannot find.
//! Filling performs nothing, so a template read from anywhere can only compute, and `Limits`
//! bounds how much.
//!
//! The actions:
//!
//! - `{{ user.name }}` writes a value. A path's first name is a loop's variable, or else a field
//!   of the data, and each name after it a field of a record or a key of a map; `.` is the data
//!   itself and `.name` a field of it whatever a loop has bound. A `Some` is read as what it
//!   holds. A text, a number, a boolean and a character are written; any other value is no text;
//!   and a path nothing stands at, or a `None` there, is missing.
//! - `{{ name | upper }}` passes the value through pipes, left to right. `html` and `url` escape
//!   it, as `std.html`'s `escape` and `std.url`'s `url_encode` do; `json` writes it as JSON;
//!   `upper` and `lower` fold ASCII letters; `length` counts a text's characters or the entries
//!   of a list or a map; `join ", "` joins a list of texts; and `default "none"` stands in where
//!   the value is missing. A pipe's argument is a path or a value written out: `"text"`, `12`,
//!   `true`.
//! - `{{ if paid }} ... {{ else if due }} ... {{ else }} ... {{ end }}` writes the first branch
//!   whose condition holds. A boolean holds as it says; a `None`, an empty text, an empty list
//!   and an empty map do not; every other value does.
//! - `{{ for item in items }} ... {{ else }} ... {{ end }}` writes its body for each element of a
//!   list, in order, or each value of a map, in the order of its keys, and the `else` branch
//!   where there is none. `{{ for i, item in items }}` also binds a list's index, from 0, or a
//!   map's key.
//! - `{{ include "row" item }}` writes the template handed to `fill` under that name, filled from
//!   the value given, or from `.` where none is given.
//! - `{{! a comment }}` writes nothing. `{{-` and `-}}` open and close any action and also drop
//!   the blanks and line ends that touch it on that side.
//!
//! `read_html` reads the same language where the text is HTML, with `std.html`'s tokenizer, and
//! writes each value by where it stands. In an element's content and in a quoted attribute value
//! it is characters, escaped; as the whole of an unquoted value it is written quoted. In an
//! attribute that holds a URL (`href`, `src`, `action`, `formaction` and the like, each URL of a
//! `srcset` or a `ping`, and a refresh's in a `<meta http-equiv=refresh>`'s `content`) it is
//! percent-encoded as that part of the URL, and one that would give the URL a scheme other than
//! `http`, `https`, `mailto` or `tel` fails the filling unless it is a `std.html` `trusted_url`.
//! A value that is an `Html` is markup already and is written as it is, which is the one way a
//! value is not escaped; an HTML template's own filling is one (`fill_html`), and an `include`
//! writes another HTML template's so. A template's markup is refused when it is read where the
//! standard's tokenizer reads a parse error in it, and where it would write a value where no
//! escaping makes it text: in a tag outside an attribute's value, in an unquoted value it is only
//! part of, in a comment, a `script` or a `style`, in an event handler, a `style`, a `srcdoc` or an
//! `http-equiv` attribute, in a `srcset` candidate's descriptors or a refresh's delay, and in a URL
//! whose scheme its text wrote otherwise. So is one whose branches leave the markup at different
//! places, as an `if` that opens a tag its `else` does not, or that write one attribute twice in
//! a tag; and one that ends an action on the `html` pipe, or on `url` in a URL, where the value
//! would be escaped twice.

import std.bytes (is_digit, is_letter)
import std.gen
import std.gen (Gen)
import std.html
import std.html (Html)
import std.json
import std.json (Json)
import std.list (enumerate, zip_with)
import std.string
import std.url (url_encode)
import std.value
import std.value (Entry, Field, VArray, VBool, VBytes, VChar, VCtor, VDecimal, VFixed, VFloat, VInt,
                  VList, VMap, VRecord, VShown, VStr, VUnit, Value, reflect)

// --- What is read and what is refused -----------------------------------------

/// Why a template is refused where it is read, or why it has no filling.
pub type ErrorKind =
  /// A `{{` that no `}}` closes.
  | Unclosed
  /// An action that is none of the language's, with what was expected there: `a path`.
  | Expected(String)
  /// A pipe this module has none of, by the name written.
  | UnknownPipe(String)
  /// An `else` or an `end`, as written, with no `if` or `for` open.
  | Unopened(String)
  /// An `if` or a `for`, as written, that no `end` closes.
  | Unended(String)
  /// Blocks nested deeper than `max_depth`.
  | Nested
  /// As HTML: markup `std.html`'s reader refuses, with what it said.
  | Markup(String)
  /// As HTML: a value where no escaping would make it text, with what `std.html` said of the place.
  | Misplaced(String)
  /// As HTML: the branches of an `if`, or one pass of a `for` and the next, leave the markup at
  /// different places.
  | Uneven
  /// As HTML: the escape pipe named, where the template escapes the value itself.
  | EscapedTwice(String)
  /// Nothing stands at the path written: no variable, field or key of that name, or a `None`.
  | Missing(String)
  /// A value of the wrong kind for its use: what the use takes, then what it was given.
  | WrongKind(String, String)
  /// No template was handed to the filling under the name an `include` names.
  | NoPartial(String)
  /// As HTML: a value that would give a URL the scheme carried.
  | UnsafeUrl(String)
  /// The output is past the limit's `output`.
  | TooLong
  /// More passes of loops and includes than the limit's `iterations`.
  | TooManyPasses
  /// Includes inside includes deeper than the limit's `depth`.
  | TooDeep
  /// This module failed, with what it said: its own defect, answered as a refusal so that
  /// reading and filling raise nothing else.
  | Defect(String)

/// A template refused: the character of its text the reader stood at, that character's line and
/// column, both from 1, and why.
pub type Error = new { offset: Int, line: Int, column: Int, reason: ErrorKind }

/// A filling that failed: the template it failed in, `None` for the one being filled and the
/// name of an included one otherwise; the character of that template's text its action starts
/// at; and why.
pub type Failure = new { partial: Option<String>, offset: Int, reason: ErrorKind }

/// What a filling is held to: how many bytes it may write, counted before a value's characters
/// are escaped; how many passes its loops and includes may make between them; and how deep an
/// include may stand inside others, which is never deeper than `max_depth()` whatever is asked.
pub type Limits = new { output: Int, iterations: Int, depth: Int }

/// Limits for a page: a mebibyte of output, ten thousand passes, and includes sixteen deep.
pub fn default_limits() -> Limits = { output: 1048576, iterations: 10000, depth: 16 }

/// How deep the blocks of a template may nest, and its includes: each level nests a few calls of
/// the program that fills it, and this many of both stay well inside what calls may nest.
pub fn max_depth() -> Int = 32

/// What reading and filling raise where they refuse.
pub effect template {
  /// The text is no template, or as HTML none that writes every value as text.
  raise fail(e: Error)
  /// The template has no filling from this data within these limits.
  raise failed(e: Failure)
}

/// A reason as a sentence.
pub fn explain(why: ErrorKind) -> String =
  match why {
    Unclosed -> "this `{{` is not closed by a `}}`",
    Expected(what) -> "expected " ++ what,
    UnknownPipe(name) ->
      "there is no pipe `" ++ name
        ++ "`: the pipes are html, url, json, upper, lower, length, join and default",
    Unopened(word) -> "this `" ++ word ++ "` has no `if` or `for` open before it",
    Unended(word) -> "this `" ++ word ++ "` is not closed by an `end`",
    Nested -> "blocks are nested deeper than a template may nest them",
    Markup(message) -> message,
    Misplaced(message) -> message,
    Uneven -> "the branches here leave the markup at different places",
    EscapedTwice(pipe) ->
      "the template escapes this value where it stands, so `" ++ pipe ++ "` would escape it twice",
    Missing(path) -> "nothing stands at `" ++ path ++ "`",
    WrongKind(taken, given) -> "this takes " ++ taken ++ " and was given " ++ given,
    NoPartial(name) -> "no template named `" ++ name ++ "` was handed to the filling",
    UnsafeUrl(scheme) -> "a value here would give the URL the scheme `" ++ scheme ++ "`",
    TooLong -> "the output is past its limit",
    TooManyPasses -> "the loops and includes made more passes than their limit",
    TooDeep -> "includes are nested deeper than their limit",
    Defect(message) ->
      "std.template failed, which is its defect and no fault of the template: " ++ message,
  }

/// The line and the column, both from 1, of the character at `offset` of `source`: where a
/// refusal's or a failure's offset stands in its template's text.
pub fn position(source: String, offset: Int) -> { line: Int, column: Int } / {abort.raise} = {
  let lines = source.slice(0, min(max(offset, 0), source.len())).split("\n");
  { line: lines.len(), column: lines.at_or(lines.len() - 1, "").len() + 1 }
}

// --- Syntax -----------------------------------------------------------------

type Token = | Word(String) | Quote(String) | Number(Int) | Dot | Bar | Comma

/// What an action reads: the value at a path, from the data alone where the flag is set and else
/// from a loop's variable of the first name where there is one; or a value written out.
type Operand = | Path(Bool, List<String>) | Literal(Value)

type Pipe = | AsHtml | AsUrl | AsJson | Upper | Lower | Length | Default(Operand) | Join(Operand)

type Expr = { from: Operand, pipes: List<Pipe> }

type Action =
  | Shows(Expr)
  | If(Expr)
  | ElseIf(Expr)
  | Else
  | End
  | For(Option<String>, String, Expr)
  | Includes(String, Expr)

/// A template's own text: as it is where the template is text, and as `std.html` read it where
/// it is HTML.
type Chunk = | Plain(String) | HtmlRun(html::Run)

/// Where a value is written: anywhere in a text, and in the hole `std.html` read in markup.
type Spot = | Anywhere | In(html::Hole)

type Lit = { chunk: Chunk, size: Int, at: Int }

type Interpolation = { value: Expr, position: Spot, at: Int }

type Arm = { cond: Expr, at: Int, body: List<Node> }

type Loop = {
  key: Option<String>,
  item: String,
  over: Expr,
  at: Int,
  body: List<Node>,
  empty: List<Node>,
}

type Inclusion = { name: String, data: Expr, position: Spot, at: Int }

type Node =
  | Text(Lit)
  | Show(Interpolation)
  | When(List<Arm>, List<Node>)
  | Each(Loop)
  | Include(Inclusion)

/// A template once read. Only this module's readers answer one, so an HTML template's every
/// value has a place `std.html` read for it.
pub opaque type Template = new { markup: Bool, nodes: List<Node> }

/// Where the reader stands, in characters, or what it found there.
effect read_error {
  raise at(offset: Int, why: ErrorKind)
}

fn read_error_at<a>(src: Bytes, byte: Int, why: ErrorKind) -> a / {read_error.at, abort.raise} =
  read_error.at(String::of_bytes_lossy(src.slice(0, byte)).len(), why)

fn blank() -> Bytes = b" \t\r\n"

fn name_characters() -> Bytes = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_"

/// An action's tokens, where the text goes on after its `}}`, and whether a `-` before that
/// drops the blanks that follow.
type Tokens = { tokens: List<Token>, next: Int, trim: Bool }

type TokenizerState = { at: Int, tokens: List<Token> }

type Quoted = { text: String, next: Int }

type QuoteState = { at: Int, parts: List<Bytes> }

fn escaped(c: Int) -> Option<Bytes> =
  match c {
    b'\\' -> Some(b"\\"),
    b'"' -> Some(b"\""),
    b'n' -> Some(b"\n"),
    b't' -> Some(b"\t"),
    _ -> None,
  }

/// The text written between the `"` before `from` and the next one.
fn read_quoted(src: Bytes, from: Int, open: Int) -> Quoted / {read_error.at, abort.raise} =
  iterate({ at: from, parts: [] }, src.len() - from + 2, |s: QuoteState| {
    let to = src.skip_until(s.at, b"\"\\");
    let kept = s.parts.push(src.slice(s.at, to));
    if src.peek(to) < 0 { read_error_at(src, open, Unclosed) } else if src.peek(to) == b'"' {
      Stop({ text: String::of_bytes(Bytes::concat_all(kept)), next: to + 1 })
    } else {
      match escaped(src.peek(to + 1)) {
        Some(fill_template) -> Continue({ at: to + 2, parts: kept.push(fill_template) }),
        None -> read_error_at(src, to, Expected("`\\\\`, `\\\"`, `\\n` or `\\t` after a `\\`")),
      }
    }
  })

fn read_number(src: Bytes, at: Int) -> { value: Int, next: Int } / {read_error.at, abort.raise} = {
  let negative = src.peek(at) == b'-';
  let from = if negative { at + 1 } else { at };
  let to = src.skip(from, b"0123456789");
  match src.slice(from, to).int_of_ascii() {
    Some(n) -> { value: if negative { 0 - n } else { n }, next: to },
    None -> read_error_at(src, at, Expected("a number an `Int` holds")),
  }
}

/// The tokens of the action that opened at `open`, read from `from`.
fn read_action_tokens(src: Bytes, from: Int, open: Int) -> Tokens / {read_error.at, abort.raise} =
  iterate({ at: from, tokens: [] }, src.len() - from + 2, |s: TokenizerState| {
    let at = src.skip(s.at, blank());
    let c = src.peek(at);
    let one = |token: Token, next: Int| Continue({ at: next, tokens: s.tokens.push(token) });
    if c < 0 { read_error_at(src, open, Unclosed) } else if c == b'}' && src.peek(at + 1) == b'}' {
      Stop({ tokens: s.tokens, next: at + 2, trim: false })
    } else if c == b'-' && src.peek(at + 1) == b'}' && src.peek(at + 2) == b'}' {
      Stop({ tokens: s.tokens, next: at + 3, trim: true })
    } else if c == b'"' {
      let read = read_quoted(src, at + 1, open);
      one(Quote(read.text), read.next)
    } else if is_digit(c) || (c == b'-' && is_digit(src.peek(at + 1))) {
      let read = read_number(src, at);
      one(Number(read.value), read.next)
    } else if is_letter(c) || c == b'_' {
      let to = src.skip(at, name_characters());
      one(Word(String::of_bytes(src.slice(at, to))), to)
    } else if c == b'.' { one(Dot, at + 1) }
    else if c == b'|' { one(Bar, at + 1) }
    else if c == b',' { one(Comma, at + 1) }
    else { read_error_at(src, at, Expected("a name, a value written out, `.`, `|`, `,` or `}}`")) }
  })

/// A comment's end, read from its `!`.
fn skip_comment(src: Bytes, from: Int, open: Int) -> Tokens / {read_error.at, abort.raise} =
  match src.index_of_from(b"}}", from) {
    None -> read_error_at(src, open, Unclosed),
    Some(close) -> { tokens: [], next: close + 2, trim: src.peek(close - 1) == b'-' },
  }

type OperandResult = { operand: Operand, rest: List<Token> }

fn read_path(
  read_action_tokens: List<Token>,
  rooted: Bool,
  names: List<String>,
) -> Result<OperandResult, ErrorKind> =
  match read_action_tokens {
    [Dot, Word(name), ..rest] -> read_path(rest, rooted, names.push(name)),
    [Dot, ..] -> Err(Expected("a name after `.`")),
    _ -> Ok({ operand: Path(rooted, names), rest: read_action_tokens }),
  }

fn operand(read_action_tokens: List<Token>) -> Result<OperandResult, ErrorKind> =
  match read_action_tokens {
    [Quote(text), ..rest] -> Ok({ operand: Literal(VStr(text)), rest: rest }),
    [Number(n), ..rest] -> Ok({ operand: Literal(VInt(n)), rest: rest }),
    [Word("true"), ..rest] -> Ok({ operand: Literal(VBool(true)), rest: rest }),
    [Word("false"), ..rest] -> Ok({ operand: Literal(VBool(false)), rest: rest }),
    [Dot, Word(name), ..rest] -> read_path(rest, true, [name]),
    [Dot, ..rest] -> Ok({ operand: Path(true, []), rest: rest }),
    [Word(name), ..rest] -> read_path(rest, false, [name]),
    _ -> Err(Expected("a path, `.` or a value written out")),
  }

type PipeResult = { pipe: Pipe, rest: List<Token> }

fn pipe(name: String, read_action_tokens: List<Token>) -> Result<PipeResult, ErrorKind> = {
  let plain = |p: Pipe| Ok({ pipe: p, rest: read_action_tokens });
  let taking = |build_template: (Operand) -> Pipe|
    match operand(read_action_tokens) {
      Err(why) -> Err(why),
      Ok(read) -> Ok({ pipe: build_template(read.operand), rest: read.rest }),
    };
  match name {
    "html" -> plain(AsHtml),
    "url" -> plain(AsUrl),
    "json" -> plain(AsJson),
    "upper" -> plain(Upper),
    "lower" -> plain(Lower),
    "length" -> plain(Length),
    "default" -> taking(|spare: Operand| Default(spare)),
    "join" -> taking(|between: Operand| Join(between)),
    _ -> Err(UnknownPipe(name)),
  }
}

type PipeState = { rest: List<Token>, pipes: List<Pipe> }

fn expression(read_action_tokens: List<Token>) -> Result<Expr, ErrorKind> / {abort.raise} =
  match operand(read_action_tokens) {
    Err(why) -> Err(why),
    Ok(read) ->
      iterate({ rest: read.rest, pipes: [] }, read_action_tokens.len() + 1, |s: PipeState|
        match s.rest {
          [] -> Stop(Ok({ from: read.operand, pipes: s.pipes })),
          [Bar, Word(name), ..rest] -> match pipe(name, rest) {
            Err(why) -> Stop(Err(why)),
            Ok(apply_pipe) ->
              Continue({ rest: apply_pipe.rest, pipes: s.pipes.push(apply_pipe.pipe) }),
          },
          _ -> Stop(Err(Expected("`|` and a pipe's name, or the end of the action"))),
        }),
  }

fn action(read_action_tokens: List<Token>) -> Result<Action, ErrorKind> / {abort.raise} = {
  let of = |rest: List<Token>, build_template: (Expr) -> Action|
    match expression(rest) { Err(why) -> Err(why), Ok(e) -> Ok(build_template(e)) };
  match read_action_tokens {
    [] -> Err(Expected("an action between `{{` and `}}`")),
    [Word("end")] -> Ok(End),
    [Word("else")] -> Ok(Else),
    [Word("else"), Word("if"), ..rest] -> of(rest, |e: Expr| ElseIf(e)),
    [Word("if"), ..rest] -> of(rest, |e: Expr| If(e)),
    [Word("for"), Word(item), Word("in"), ..rest] -> of(rest, |e: Expr| For(None, item, e)),
    [Word("for"), Word(key), Comma, Word(item), Word("in"), ..rest] ->
      of(rest, |e: Expr| For(Some(key), item, e)),
    [Word("for"), ..] -> Err(Expected("`for item in list` or `for key, item in map`")),
    [Word("include"), Quote(name)] -> Ok(Includes(name, { from: Path(true, []), pipes: [] })),
    [Word("include"), Quote(name), ..rest] -> of(rest, |e: Expr| Includes(name, e)),
    [Word("include"), ..] -> Err(Expected("`include`, a template's name in quotes, and its data")),
    [Word("end"), ..] | [Word("else"), ..] -> Err(Expected("`}}` after this word")),
    _ -> of(read_action_tokens, |e: Expr| Shows(e)),
  }
}

/// A template's text between two actions, or an action, each with the character it starts at.
type Piece = | TextPiece(String, Int) | ActionPiece(Action, Int)

type LexerState = { at: Int, chars: Int, trim: Bool, pieces: List<Piece> }

/// `chunk` without the blanks at its start where `left` and at its end where `right`, and how
/// many characters were dropped before it.
fn trim_blanks(
  chunk: Bytes,
  left: Bool,
  right: Bool,
) -> { text: Bytes, dropped: Int } / {abort.raise} = {
  let n = chunk.len();
  let from = if left { chunk.skip(0, blank()) } else { 0 };
  let to = if !right { n } else {
    iterate(n, n + 1, |i: Int|
      if i > from && blank().index_of_byte(chunk.at(i - 1)) != None { Continue(i - 1) }
      else { Stop(i) })
  };
  { text: chunk.slice(from, to), dropped: from }
}

/// The lexing past the text that runs to `to`, where an action opens or the template ends.
fn add_text(src: Bytes, s: LexerState, to: Int, right: Bool) -> LexerState / {abort.raise} = {
  let chunk = src.slice(s.at, to);
  let kept = trim_blanks(chunk, s.trim, right);
  {
    at: to,
    chars: s.chars + String::of_bytes(chunk).len(),
    trim: false,
    pieces: if kept.text.len() == 0 { s.pieces }
    else { s.pieces.push(TextPiece(String::of_bytes(kept.text), s.chars + kept.dropped)) },
  }
}

fn lex(src: Bytes) -> List<Piece> / {read_error.at, abort.raise} =
  iterate({ at: 0, chars: 0, trim: false, pieces: [] }, src.len() + 2, |s: LexerState|
    match src.index_of_from(b"{{", s.at) {
      None -> Stop(add_text(src, s, src.len(), false).pieces),
      Some(open) -> {
        let trims = src.peek(open + 2) == b'-';
        let before = add_text(src, s, open, trims);
        let from = if trims { open + 3 } else { open + 2 };
        let comment = src.peek(from) == b'!';
        let read = if comment { skip_comment(src, from, open) }
        else { read_action_tokens(src, from, open) };
        Continue({
          at: read.next,
          chars: before.chars + String::of_bytes(src.slice(open, read.next)).len(),
          trim: read.trim,
          pieces: if comment { before.pieces } else {
            match action(read.tokens) {
              Ok(a) -> before.pieces.push(ActionPiece(a, before.chars)),
              Err(why) -> read_error.at(before.chars, why),
            }
          },
        })
      },
    })

// --- Blocks ---------------------------------------------------------------------

/// What a block being read is: the template itself; an `if`, with its finished arms, and the
/// condition of the one being read and where it is written; an `if`'s `else`; a `for`'s body; and
/// a `for`'s `else`.
type Frame = | Top | InIf(List<Arm>, Expr, Int) | InElse(List<Arm>) | InFor(Loop) | InForElse(Loop)

type OpenBlock = { frame: Frame, at: Int, nodes: List<Node> }

type BlockStack = { below: List<OpenBlock>, top: OpenBlock }

fn add_node(b: BlockStack, n: Node) -> BlockStack =
  { ..b, top: { ..b.top, nodes: b.top.nodes.push(n) } }

fn open_block(b: BlockStack, frame: Frame, at: Int) -> BlockStack / {read_error.at} =
  if b.below.len() >= max_depth() { read_error.at(at, Nested) }
  else { { below: b.below.push(b.top), top: { frame: frame, at: at, nodes: [] } } }

fn close_block(b: BlockStack, n: Node, at: Int) -> BlockStack / {read_error.at} =
  match b.below.last() {
    None -> read_error.at(at, Unopened("end")),
    Some(under) ->
      { below: b.below.take(b.below.len() - 1), top: { ..under, nodes: under.nodes.push(n) } },
  }

fn apply_action(b: BlockStack, action: Action, at: Int) -> BlockStack / {read_error.at} = {
  let top = b.top;
  let arms = |done: List<Arm>, cond: Expr, cond_at: Int|
    done.push({ cond: cond, at: cond_at, body: top.nodes });
  let turned = |frame: Frame| { ..b, top: { ..top, frame: frame, nodes: [] } };
  match action {
    Shows(e) -> add_node(b, Show({ value: e, position: Anywhere, at: at })),
    Includes(name, e) -> add_node(b, Include({ name: name, data: e, position: Anywhere, at: at })),
    If(e) -> open_block(b, InIf([], e, at), at),
    For(key, item, render_with_partials) ->
      open_block(
        b,
        InFor({ key: key, item: item, over: render_with_partials, at: at, body: [], empty: [] }),
        at,
      ),
    ElseIf(e) -> match top.frame {
      InIf(done, cond, cond_at) -> turned(InIf(arms(done, cond, cond_at), e, at)),
      _ -> read_error.at(at, Unopened("else if")),
    },
    Else -> match top.frame {
      InIf(done, cond, cond_at) -> turned(InElse(arms(done, cond, cond_at))),
      InFor(l) -> turned(InForElse({ ..l, body: top.nodes })),
      _ -> read_error.at(at, Unopened("else")),
    },
    End -> match top.frame {
      Top -> read_error.at(at, Unopened("end")),
      InIf(done, cond, cond_at) -> close_block(b, When(arms(done, cond, cond_at), []), at),
      InElse(done) -> close_block(b, When(done, top.nodes), at),
      InFor(l) -> close_block(b, Each({ ..l, body: top.nodes }), at),
      InForElse(l) -> close_block(b, Each({ ..l, empty: top.nodes }), at),
    },
  }
}

fn build_nodes(lex: List<Piece>) -> List<Node> / {read_error.at} = {
  let end = lex.fold(
    { below: [], top: { frame: Top, at: 0, nodes: [] } },
    |b: BlockStack, p: Piece|
      match p {
        TextPiece(text, at) ->
          add_node(b, Text({ chunk: Plain(text), size: Bytes::of_string(text).len(), at: at })),
        ActionPiece(a, at) -> apply_action(b, a, at),
      },
  );
  match end.top.frame {
    Top -> end.top.nodes,
    InFor(_) | InForElse(_) -> read_error.at(end.top.at, Unended("for")),
    InIf(_, _, _) | InElse(_) -> read_error.at(end.top.at, Unended("if")),
  }
}

// --- As HTML --------------------------------------------------------------------

/// Nodes with their text read as markup and their values placed, and where the reader stands
/// after them.
type NodesInContext = { nodes: List<Node>, at: html::Context }

type NodeInContext = { node: Node, at: html::Context }

/// The hole a value stands in at `from`, or the refusal of a value there.
fn hole_at(from: html::Context, value: Expr, at: Int) -> html::Hole / {read_error.at, abort.raise} =
  match html::hole(from) {
    Err(message) -> read_error.at(at, Misplaced(message)),
    Ok(h) -> match value.pipes.last() {
      Some(AsHtml) -> read_error.at(at, EscapedTwice("html")),
      Some(AsUrl) -> if h.url == None { h } else { read_error.at(at, EscapedTwice("url")) },
      _ -> h,
    },
  }

fn resolve_contexts(
  nodes: List<Node>,
  from: html::Context,
) -> NodesInContext / {read_error.at, abort.raise} =
  nodes.fold({ nodes: [], at: from }, |s: NodesInContext, n: Node| {
    let one = resolve_context(n, s.at);
    { nodes: s.nodes.push(one.node), at: one.at }
  })

fn resolve_context(n: Node, from: html::Context) -> NodeInContext / {read_error.at, abort.raise} =
  match n {
    Text(lit) -> match lit.chunk {
      HtmlRun(r) -> { node: n, at: r.to },
      Plain(text) -> match html::run(from, text) {
        Err(stray) -> read_error.at(lit.at + stray.offset, Markup(stray.message)),
        Ok(r) -> { node: Text({ ..lit, chunk: HtmlRun(r) }), at: r.to },
      },
    },
    Show(write_value) -> {
      let h = hole_at(from, write_value.value, write_value.at);
      { node: Show({ ..write_value, position: In(h) }), at: h.to }
    },
    Include(inc) -> {
      let h = hole_at(from, inc.data, inc.at);
      { node: Include({ ..inc, position: In(h) }), at: h.to }
    },
    When(arms, otherwise) -> {
      let bodies = arms.map(|arm: Arm| resolve_contexts(arm.body, from));
      let other = resolve_contexts(otherwise, from);
      let end = bodies.fold(Some(other.at), |both: Option<html::Context>, s: NodesInContext|
        match both { None -> None, Some(c) -> html::join(c, s.at) });
      match end {
        None -> read_error.at(match arms { [first, ..] -> first.at, [] -> 0 }, Uneven),
        Some(c) ->
          {
            node: When(
              zip_with(arms, bodies, |arm: Arm, s: NodesInContext| { ..arm, body: s.nodes }),
              other.nodes,
            ),
            at: c,
          },
      }
    },
    Each(l) -> {
      let none = resolve_contexts(l.empty, from);
      let pass = resolve_loop_context(l, from);
      match html::join(pass.at, none.at) {
        None -> read_error.at(l.at, Uneven),
        Some(end) -> { node: Each({ ..l, body: pass.nodes, empty: none.nodes }), at: end },
      }
    },
  }

/// A loop's body read from a place that is both where the loop starts and where a pass ends,
/// since a pass is written after either, and that place. The body is read again only where its
/// first reading ended somewhere its start does not cover, which a second reading then does.
fn resolve_loop_context(
  l: Loop,
  from: html::Context,
) -> NodesInContext / {read_error.at, abort.raise} = {
  let covers = |around: html::Context, s: NodesInContext|
    if html::join(s.at, around) == Some(around) { { nodes: s.nodes, at: around } }
    else { read_error.at(l.at, Uneven) };
  match html::join(from, from) {
    None -> read_error.at(l.at, Uneven),
    Some(start) -> {
      let once = resolve_contexts(l.body, start);
      match html::join(start, once.at) {
        None -> read_error.at(l.at, Uneven),
        Some(around) -> if around == start { covers(around, once) }
        else { covers(around, resolve_contexts(l.body, around)) },
      }
    },
  }
}

// --- Reading --------------------------------------------------------------------

fn build_template(source: String, markup: Bool) -> Template / {read_error.at, abort.raise} = {
  let nodes = build_nodes(lex(Bytes::of_string(source)));
  if !markup { { markup: false, nodes: nodes } } else {
    let read = resolve_contexts(nodes, html::reader(true));
    match html::unfinished(read.at) {
      Some(message) -> read_error.at(source.len(), Markup(message)),
      None -> { markup: true, nodes: read.nodes },
    }
  }
}

fn read_as(source: String, markup: Bool) -> Template / {template.fail} =
  handle {
    handle {
      build_template(source, markup)
    } with {
      read_error.at(offset, why) -> {
        let stood = position(source, offset);
        template.fail({ offset: offset, line: stood.line, column: stood.column, reason: why })
      },
    }
  } with {
    abort.raise(message) ->
      template.fail({ offset: 0, line: 1, column: 1, reason: Defect(message) }),
  }

/// The template `source` is as text, raising `template.fail` where `parse` answers `Err`.
pub fn read(source: String) -> Template / {template.fail} = read_as(source, false)

/// The template `source` is as text, or the first place it is none: an action left open, one
/// that is none of the language's, or a block with no `end`.
pub fn parse(source: String) -> Result<Template, Error> = try { read(source) }

/// The template `source` is as HTML, raising `template.fail` where `parse_html` answers `Err`.
pub fn read_html(source: String) -> Template / {template.fail} = read_as(source, true)

/// The template `source` is as HTML, or the first place it is none: where `parse` refuses, where
/// its text is no markup, where a value would stand where no escaping makes it text, and where
/// branches leave the markup at different places.
pub fn parse_html(source: String) -> Result<Template, Error> = try { read_html(source) }

// --- Data -----------------------------------------------------------------------

/// The data a JSON document is: an object as a map of its members, an array as a list, a whole
/// number as an `Int` and any other as a `Decimal`, and `null` as `None`.
pub fn of_json(j: Json) -> Value =
  match j {
    json::Null -> VCtor("None", []),
    json::Bool(b) -> VBool(b),
    json::Number(d) -> match Int::of_decimal(d, Down) {
      Some(n) -> if Decimal::of_int(n) == d { VInt(n) } else { VDecimal(d) },
      None -> VDecimal(d),
    },
    json::Str(s) -> VStr(s),
    json::Array(items) -> VList(items.map(of_json)),
    json::Object(members) ->
      VMap(
        members.entries().map(|m: { key: String, value: Json }|
          { key: VStr(m.key), value: of_json(m.value) }),
      ),
  }

/// What a path finds: a value; a `None`; or nothing of that name.
type Lookup = | Found(Value) | FoundNone | NotFound

type Binding = { name: String, value: Value }

type Scope = { data: Value, bound: List<Binding> }

fn lookup_value(v: Value) -> Lookup =
  match v {
    VCtor("Some", [hole_at]) -> lookup_value(hole_at),
    VCtor("None", []) -> FoundNone,
    _ -> Found(v),
  }

fn lookup_field(of: Lookup, name: String) -> Lookup =
  match of {
    Found(VRecord(fields)) -> match value::field_named(fields, name) {
      Some(v) -> lookup_value(v),
      None -> NotFound,
    },
    Found(VMap(entries)) -> match entries.find(|e: Entry|
        match e.key { VStr(key) -> key == name, _ -> false }) {
      Some(e) -> lookup_value(e.value),
      None -> NotFound,
    },
    Found(_) -> NotFound,
    _ -> of,
  }

fn lookup_operand(scope: Scope, operand: Operand) -> Lookup =
  match operand {
    Literal(v) -> Found(v),
    Path(_, []) -> lookup_value(scope.data),
    Path(rooted, [first, ..rest]) -> match if rooted { None }
      else { scope.bound.find_last(|b: Binding| b.name == first) } {
      Some(b) -> rest.fold(lookup_value(b.value), lookup_field),
      None -> rest.fold(lookup_field(lookup_value(scope.data), first), lookup_field),
    },
  }

fn operand_text(operand: Operand) -> String =
  match operand {
    Literal(v) -> value::render(v),
    Path(rooted, names) ->
      (if rooted || names.len() == 0 { "." } else { "" }) ++ String::join(names, "."),
  }

fn describe_kind(v: Value) -> String =
  match v {
    VStr(_) | VShown(_) | VChar(_) -> "a text",
    VInt(_) | VDecimal(_) | VFloat(_) | VFixed(_, _) -> "a number",
    VBool(_) -> "a boolean",
    VList(_) | VArray(_) -> "a list",
    VMap(_) -> "a map",
    VRecord(_) -> if html::of_value(v) == None { "a record" } else { "markup" },
    VCtor(name, _) -> "a `" ++ value::ctor_name(name) ++ "`",
    VBytes(_) -> "bytes",
    VUnit -> "`()`",
    _ -> "a value no template writes",
  }

/// What a value is written as, or `None` for one that is no text.
fn text(v: Value) -> Option<String> =
  match v {
    VStr(s) | VShown(s) -> Some(s),
    VInt(n) -> Some(n.to_string()),
    VBool(b) -> Some(if b { "true" } else { "false" }),
    VDecimal(d) -> Some(d.to_string()),
    VFloat(f) -> Some(f.to_string()),
    VChar(c) -> Some(String::of_chars([c])),
    _ -> None,
  }

// --- Filling ----------------------------------------------------------------

type Env = { partials: Map<String, Template>, limits: Limits, partial: Option<String> }

/// What is written to: the pieces of a text, or the draft of a page.
type Sink = | TextOutput(List<Bytes>) | HtmlOutput(html::Draft)

type FillState = { out: Sink, size: Int, passes: Int }

/// What an action writes: characters, or markup.
type Output = | Characters(String) | Fragment(Html)

fn fail<a>(env: Env, at: Int, why: ErrorKind) -> a / {template.failed} =
  template.failed({ partial: env.partial, offset: at, reason: why })

fn mode_mismatch<a>(env: Env, at: Int) -> a / {template.failed} =
  fail(env, at, Defect("a template was written where it was not read to be"))

fn require_value(l: Lookup, e: Expr, env: Env, at: Int) -> Value / {template.failed} =
  match l { Found(v) -> v, _ -> fail(env, at, Missing(operand_text(e.from))) }

fn text_of(v: Value, env: Env, at: Int) -> String / {template.failed} =
  match text(v) { Some(s) -> s, None -> fail(env, at, WrongKind("a text", describe_kind(v))) }

fn json_of(v: Value, env: Env, at: Int) -> Json / {template.failed} =
  match v {
    VStr(s) | VShown(s) -> json::Str(s),
    VChar(c) -> json::Str(String::of_chars([c])),
    VInt(n) -> json::int(n),
    VDecimal(d) -> json::Number(d),
    VBool(b) -> json::Bool(b),
    VFloat(f) -> match Decimal::of_float(f) {
      Some(d) -> json::Number(d),
      None -> fail(env, at, WrongKind("a number JSON writes", "one that is not finite")),
    },
    VList(items) | VArray(items) -> json::Array(items.map(|x: Value| json_of(x, env, at))),
    VRecord(fields) ->
      json::object(fields.map(|f: Field| { key: f.name, value: json_of(f.value, env, at) })),
    VMap(entries) ->
      json::object(
        entries.map(|e: Entry|
          {
            key: match e.key {
              VStr(key) -> key,
              other ->
                fail(env, at, WrongKind("a text for a JSON object's key", describe_kind(other))),
            },
            value: json_of(e.value, env, at),
          }),
      ),
    VCtor("Some", [hole_at]) -> json_of(hole_at, env, at),
    VCtor("None", []) -> json::Null,
    _ -> fail(env, at, WrongKind("data JSON writes", describe_kind(v))),
  }

fn apply_pipe(
  l: Lookup,
  p: Pipe,
  e: Expr,
  scope: Scope,
  env: Env,
  at: Int,
) -> Lookup / {template.failed, abort.raise} = {
  let add_text = |v: Value| text_of(v, env, at);
  let given = |from: Lookup| require_value(from, e, env, at);
  match p {
    Default(spare) -> match l { Found(_) -> l, _ -> lookup_operand(scope, spare) },
    AsHtml -> Found(VStr(html::escape(add_text(given(l))))),
    AsUrl -> Found(VStr(url_encode(add_text(given(l))))),
    AsJson -> match l {
      FoundNone -> Found(VStr("null")),
      _ -> Found(VStr(json::to_string(json_of(given(l), env, at)))),
    },
    Upper -> Found(VStr(add_text(given(l)).ascii_upper())),
    Lower -> Found(VStr(add_text(given(l)).ascii_lower())),
    Length -> match given(l) {
      VStr(s) -> Found(VInt(s.len())),
      VList(items) | VArray(items) -> Found(VInt(items.len())),
      VMap(entries) -> Found(VInt(entries.len())),
      other -> fail(env, at, WrongKind("a text, a list or a map", describe_kind(other))),
    },
    Join(between) -> match given(l) {
      VList(items) | VArray(items) ->
        Found(
          VStr(
            String::join(
              items.map(|x: Value| add_text(given(lookup_value(x)))),
              add_text(given(lookup_operand(scope, between))),
            ),
          ),
        ),
      other -> fail(env, at, WrongKind("a list", describe_kind(other))),
    },
  }
}

fn evaluate(e: Expr, scope: Scope, env: Env, at: Int) -> Lookup / {template.failed, abort.raise} =
  e.pipes.fold(lookup_operand(scope, e.from), |l: Lookup, p: Pipe|
    apply_pipe(l, p, e, scope, env, at))

fn is_truthy(l: Lookup, e: Expr, env: Env, at: Int) -> Bool / {template.failed} =
  match l {
    NotFound -> fail(env, at, Missing(operand_text(e.from))),
    FoundNone -> false,
    Found(VBool(b)) -> b,
    Found(VStr("")) | Found(VList([])) | Found(VArray([])) | Found(VMap([])) -> false,
    Found(_) -> true,
  }

type LoopItem = { key: Value, item: Value }

fn loop_items(l: Lookup, e: Expr, env: Env, at: Int) -> List<LoopItem> / {template.failed} =
  match require_value(l, e, env, at) {
    VList(items) | VArray(items) ->
      enumerate(items).map(|x: { index: Int, value: Value }| { key: VInt(x.index), item: x.value }),
    VMap(entries) -> entries.map(|x: Entry| { key: x.key, item: x.value }),
    other -> fail(env, at, WrongKind("a list or a map", describe_kind(other))),
  }

fn bind_loop(scope: Scope, l: Loop, p: LoopItem) -> Scope = {
  let keyed = match l.key {
    Some(name) -> scope.bound.push({ name: name, value: p.key }),
    None -> scope.bound,
  };
  { ..scope, bound: keyed.push({ name: l.item, value: p.item }) }
}

fn count_output(f: FillState, more: Int, env: Env, at: Int) -> FillState / {template.failed} =
  if f.size + more > env.limits.output { fail(env, at, TooLong) }
  else { { ..f, size: f.size + more } }

fn count_pass(f: FillState, env: Env, at: Int) -> FillState / {template.failed} =
  if f.passes >= env.limits.iterations { fail(env, at, TooManyPasses) }
  else { { ..f, passes: f.passes + 1 } }

fn sink(markup: Bool) -> Sink = if markup { HtmlOutput(html::draft(true)) } else { TextOutput([]) }

fn finish_output(out: Sink, env: Env, at: Int) -> Output / {template.failed, abort.raise} =
  match out {
    TextOutput(parts) -> Characters(String::of_bytes(Bytes::concat_all(parts))),
    HtmlOutput(d) -> match html::finish(d) {
      Some(page) -> Fragment(page),
      None -> mode_mismatch(env, at),
    },
  }

fn write_text(lit: Lit, f: FillState, env: Env) -> FillState / {template.failed, abort.raise} = {
  let room = count_output(f, lit.size, env, lit.at);
  match ((lit.chunk, room.out)) {
    (Plain(fill_template), TextOutput(parts)) ->
      { ..room, out: TextOutput(parts.push(Bytes::of_string(fill_template))) },
    (HtmlRun(r), HtmlOutput(d)) -> match html::write(d, r) {
      Some(next) -> { ..room, out: HtmlOutput(next) },
      None -> mode_mismatch(env, lit.at),
    },
    _ -> mode_mismatch(env, lit.at),
  }
}

/// What `w` is where `h` is a URL: its text, which is no markup's, and whether it is trusted.
fn url_of(w: Output, env: Env, at: Int) -> html::UrlText / {template.failed} =
  match w {
    Characters(s) -> { text: s, trusted: false },
    Fragment(page) -> match html::url_text(page) {
      Some(u) -> u,
      None -> fail(env, at, WrongKind("the text of a URL", "markup")),
    },
  }

/// `w` written at `spot`: into a text as it is, and into a page as its hole reads it, a URL's
/// part percent-encoded and refused where it would name a scheme no value may.
fn put(
  w: Output,
  spot: Spot,
  f: FillState,
  env: Env,
  at: Int,
) -> FillState / {template.failed, abort.raise} =
  match f.out {
    TextOutput(parts) ->
      {
        ..f,
        out: TextOutput(
          parts.push(
            Bytes::of_string(match w { Characters(s) -> s, Fragment(page) -> html::render(page) }),
          ),
        ),
      },
    HtmlOutput(d) -> match spot {
      Anywhere -> mode_mismatch(env, at),
      In(h) -> {
        let value = match ((h.url, w)) {
          (None, Characters(s)) -> html::text(s),
          (None, Fragment(page)) -> page,
          _ -> match html::written_url(h, url_of(w, env, at)) {
            Ok(url) -> html::text(url),
            Err(scheme) -> fail(env, at, UnsafeUrl(scheme)),
          },
        };
        match html::place(d, h, value) {
          Some(next) -> { ..f, out: HtmlOutput(next) },
          None -> mode_mismatch(env, at),
        }
      },
    },
  }

/// A value as an action writes it: an `Html` as the markup it is, and anything else as its text.
fn write_value(
  v: Value,
  spot: Spot,
  f: FillState,
  env: Env,
  at: Int,
) -> FillState / {template.failed, abort.raise} =
  match html::of_value(v) {
    Some(page) -> put(Fragment(page), spot, count_output(f, html::size(page), env, at), env, at),
    None -> {
      let fill_template = text_of(v, env, at);
      put(
        Characters(fill_template),
        spot,
        count_output(f, Bytes::of_string(fill_template).len(), env, at),
        env,
        at,
      )
    },
  }

type BranchState = { done: Bool, filling: FillState }

fn fill_node(
  n: Node,
  scope: Scope,
  env: Env,
  depth: Int,
  f: FillState,
) -> FillState / {template.failed, abort.raise} =
  match n {
    Text(lit) -> write_text(lit, f, env),
    Show(s) ->
      write_value(
        require_value(evaluate(s.value, scope, env, s.at), s.value, env, s.at),
        s.position,
        f,
        env,
        s.at,
      ),
    When(arms, otherwise) -> {
      let chosen = arms.fold({ done: false, filling: f }, |c: BranchState, arm: Arm|
        if c.done || !is_truthy(evaluate(arm.cond, scope, env, arm.at), arm.cond, env, arm.at) { c }
        else {
          {
            done: true,
            filling: arm.body.fold(c.filling, |a: FillState, m: Node|
              fill_node(m, scope, env, depth, a)),
          }
        });
      if chosen.done { chosen.filling }
      else { otherwise.fold(f, |a: FillState, m: Node| fill_node(m, scope, env, depth, a)) }
    },
    Each(l) -> match loop_items(evaluate(l.over, scope, env, l.at), l.over, env, l.at) {
      [] -> l.empty.fold(f, |a: FillState, m: Node| fill_node(m, scope, env, depth, a)),
      each ->
        each.fold(f, |a: FillState, p: LoopItem| {
          let inner = bind_loop(scope, l, p);
          l.body.fold(count_pass(a, env, l.at), |b: FillState, m: Node|
            fill_node(m, inner, env, depth, b))
        }),
    },
    Include(inc) -> if depth <= 0 { fail(env, inc.at, TooDeep) } else {
      match env.partials.get(inc.name) {
        None -> fail(env, inc.at, NoPartial(inc.name)),
        Some(t) -> {
          let data = require_value(evaluate(inc.data, scope, env, inc.at), inc.data, env, inc.at);
          let within: Env = { ..env, partial: Some(inc.name) };
          let inner = t.nodes.fold(
            { ..count_pass(f, env, inc.at), out: sink(t.markup) },
            |a: FillState, m: Node| fill_node(m, { data: data, bound: [] }, within, depth - 1, a),
          );
          put(
            finish_output(inner.out, env, inc.at),
            inc.position,
            { ..inner, out: f.out },
            env,
            inc.at,
          )
        },
      }
    },
  }

fn fill_template(
  t: Template,
  data: Value,
  partials: Map<String, Template>,
  limits: Limits,
) -> Output / {template.failed, abort.raise} = {
  let env: Env = { partials: partials, limits: limits, partial: None };
  let end = t.nodes.fold({ out: sink(t.markup), size: 0, passes: 0 }, |f: FillState, n: Node|
    fill_node(n, { data: data, bound: [] }, env, min(limits.depth, max_depth()), f));
  finish_output(end.out, env, 0)
}

fn defect_failure(message: String) -> Failure =
  { partial: None, offset: 0, reason: Defect(message) }

/// The text `t` is with `data` in its places and each `include` filled from `partials`, raising
/// `template.failed` where `render` answers `Err`. An HTML template's text is its document's.
pub fn fill(
  t: Template,
  data: Value,
  partials: Map<String, Template>,
  limits: Limits,
) -> String / {template.failed} =
  handle {
    match fill_template(t, data, partials, limits) {
      Characters(s) -> s,
      Fragment(page) -> html::render(page),
    }
  } with {
    abort.raise(message) -> template.failed(defect_failure(message)),
  }

/// The text `t` is with `data` in its places, or why it has none: a path nothing stands at, a
/// value of the wrong kind for its use, an `include` of no template handed in, a value that
/// would name a URL's scheme, or a limit passed.
pub fn render(
  t: Template,
  data: Value,
  partials: Map<String, Template>,
  limits: Limits,
) -> Result<String, Failure> = try { fill(t, data, partials, limits) }

/// The markup `t` is with `data` in its places, raising `template.failed` where `render_html`
/// answers `Err`. A template read as text is all characters: its filling, escaped.
pub fn fill_html(
  t: Template,
  data: Value,
  partials: Map<String, Template>,
  limits: Limits,
) -> Html / {template.failed} =
  handle {
    match fill_template(t, data, partials, limits) {
      Characters(s) -> html::text(s),
      Fragment(page) -> page,
    }
  } with {
    abort.raise(message) -> template.failed(defect_failure(message)),
  }

/// The markup `t` is with `data` in its places, or why it has none, on `render`'s terms.
pub fn render_html(
  t: Template,
  data: Value,
  partials: Map<String, Template>,
  limits: Limits,
) -> Result<Html, Failure> = try { fill_html(t, data, partials, limits) }

// --- Tests ------------------------------------------------------------------

type Line = { sku: String, qty: Int, note: Option<String> }

type Order = {
  id: Int,
  customer: String,
  lines: List<Line>,
  paid: Bool,
  due: Bool,
  tags: List<String>,
  none: List<String>,
  totals: Map<String, Int>,
  vip: Option<String>,
  rate: Decimal,
}

fn order() -> Value = {
  let o: Order = {
    id: 7,
    customer: "Ann & Bob",
    lines: [{ sku: "a1", qty: 2, note: Some("gift") }, { sku: "b2", qty: 1, note: None }],
    paid: true,
    due: false,
    tags: ["x", "y"],
    none: [],
    totals: #{"tax": 2, "net": 10},
    vip: None,
    rate: 1.50m,
  };
  reflect(o)
}

/// The templates an `include` in these tests may name.
fn partials() -> Map<String, Template> / {abort.raise} = {
  let named = |name: String, source: String|
    {
      key: name,
      value: match parse(source) { Ok(t) -> t, Err(r) -> panic(name ++ ": " ++ explain(r.reason)) },
    };
  Map::of_entries([
    named("line", "{{ sku }}({{ qty }})"),
    named("who", "{{ customer }}"),
    named("word", "[{{ . }}]"),
    named("again", "x{{ include \"again\" }}"),
  ])
}

fn render_with_partials(source: String, data: Value) -> Result<String, Failure> / {abort.raise} =
  match parse(source) {
    Ok(t) -> render(t, data, partials(), default_limits()),
    Err(r) -> panic("refused: " ++ explain(r.reason)),
  }

type FillCase = { source: String, text: String }

fn fill_cases() -> List<FillCase> =
  [
    { source: "Hello, {{ customer }}!", text: "Hello, Ann & Bob!" },
    { source: "{{id}} {{ paid }} {{ rate }} {{ .id }}", text: "7 true 1.50 7" },
    { source: "{{ lines | length }} {{ customer | length }} {{ totals | length }}", text: "2 9 2" },
    { source: "{{ for l in lines }}{{ l.sku }}x{{ l.qty }};{{ end }}", text: "a1x2;b2x1;" },
    { source: "{{ for i, l in lines }}{{ i }}:{{ l.sku }} {{ end }}", text: "0:a1 1:b2 " },
    { source: "{{ for k, v in totals }}{{ k }}={{ v }},{{ end }}", text: "net=10,tax=2," },
    { source: "{{ for v in totals }}{{ v }} {{ end }}", text: "10 2 " },
    { source: "{{ for t in none }}x{{ else }}nothing{{ end }}", text: "nothing" },
    { source: "{{ for t in tags }}{{ t }}{{ else }}nothing{{ end }}", text: "xy" },
    { source: "{{ if paid }}yes{{ else }}no{{ end }}", text: "yes" },
    { source: "{{ if due }}yes{{ end }}|{{ if due }}yes{{ else }}no{{ end }}", text: "|no" },
    { source: "{{ if vip }}vip{{ else if paid }}paid{{ else }}-{{ end }}", text: "paid" },
    {
      source: "{{ if none }}some{{ else }}none{{ end }} {{ if tags }}some{{ end }}",
      text: "none some",
    },
    { source: "{{ if id }}id{{ end }}{{ if customer }} named{{ end }}", text: "id named" },
    { source: "{{ if \"\" }}a{{ else if 0 }}b{{ end }}", text: "b" },
    { source: "{{ vip | default \"no\" }} {{ nope | default id }}", text: "no 7" },
    { source: "{{ if nope | default false }}a{{ else }}b{{ end }}", text: "b" },
    { source: "{{ tags | join \", \" }}|{{ none | join \",\" }}", text: "x, y|" },
    { source: "{{ customer | upper }} {{ customer | lower }}", text: "ANN & BOB ann & bob" },
    { source: "{{ customer | html }} {{ customer | url }}", text: "Ann &amp; Bob Ann%20%26%20Bob" },
    {
      source: "{{ totals | json }} {{ tags | json }} {{ vip | json }}",
      text: "{\"net\":10,\"tax\":2} [\"x\",\"y\"] null",
    },
    {
      source: "{{ lines | json }}",
      text: "[{\"note\":\"gift\",\"qty\":2,\"sku\":\"a1\"},{\"note\":null,\"qty\":1,\"sku\":\"b2\"}]",
    },
    {
      source: "{{ \"{{\" }} {{ 12 }} {{ true }} {{ -3 }} {{ \"a\\\"b\\\\\\n\" }}",
      text: "{{ 12 true -3 a\"b\\\n",
    },
    { source: "a \n {{- id -}} \n b", text: "a7b" },
    { source: "a {{ id -}}  b {{- id }} c", text: "a 7b7 c" },
    { source: "{{! a note }}x{{! }} y {{-! gone -}} z", text: "x yz" },
    {
      source: "{{ for l in lines }}{{ for t in tags }}{{ l.sku }}{{ t }} {{ end }}{{ end }}",
      text: "a1x a1y b2x b2y ",
    },
    { source: "{{ for id in tags }}{{ id }}{{ .id }} {{ end }}{{ id }}", text: "x7 y7 7" },
    {
      source: "{{ for l in lines }}{{ l.note | default \"-\" }}{{ if l.note }}!{{ end }} {{ end }}",
      text: "gift! - ",
    },
    {
      source: "{{ for l in lines }}{{ include \"line\" l }} {{ end }}{{ include \"who\" }}",
      text: "a1(2) b2(1) Ann & Bob",
    },
    {
      source: "{{ include \"word\" customer | upper }}{{ include \"word\" 3 }}",
      text: "[ANN & BOB][3]",
    },
    { source: "no action } here { at all }}", text: "no action } here { at all }}" },
    { source: "", text: "" },
  ]

test "`{c.source}` is filled as the language says" for c: FillCase in fill_cases() {
  assert_eq(render_with_partials(c.source, order()), Ok(c.text))
}

type FailureCase = { source: String, offset: Int, reason: ErrorKind }

fn failure_cases() -> List<FailureCase> =
  [
    { source: "{{ nope }}", offset: 0, reason: Missing("nope") },
    { source: "ab{{ customer.first }}", offset: 2, reason: Missing("customer.first") },
    { source: "\u{e9}{{ .lines.sku }}", offset: 1, reason: Missing(".lines.sku") },
    { source: "{{ vip }}", offset: 0, reason: Missing("vip") },
    { source: "{{ vip | upper }}", offset: 0, reason: Missing("vip") },
    { source: "{{ nope | default gone }}", offset: 0, reason: Missing("nope") },
    { source: "{{ lines }}", offset: 0, reason: WrongKind("a text", "a list") },
    { source: "{{ totals }}", offset: 0, reason: WrongKind("a text", "a map") },
    { source: "{{ . }}", offset: 0, reason: WrongKind("a text", "a record") },
    {
      source: "{{ for c in customer }}{{ end }}",
      offset: 0,
      reason: WrongKind("a list or a map", "a text"),
    },
    {
      source: "{{ for c in . }}{{ end }}",
      offset: 0,
      reason: WrongKind("a list or a map", "a record"),
    },
    { source: "{{ for c in nope }}{{ end }}", offset: 0, reason: Missing("nope") },
    { source: "{{ for c in vip }}{{ else }}{{ end }}", offset: 0, reason: Missing("vip") },
    { source: "x{{ if nope }}x{{ end }}", offset: 1, reason: Missing("nope") },
    { source: "{{ if due }}{{ else if nope }}{{ end }}", offset: 12, reason: Missing("nope") },
    { source: "{{ include \"gone\" }}", offset: 0, reason: NoPartial("gone") },
    { source: "{{ include \"who\" nope }}", offset: 0, reason: Missing("nope") },
    { source: "{{ tags | upper }}", offset: 0, reason: WrongKind("a text", "a list") },
    { source: "{{ id | join \",\" }}", offset: 0, reason: WrongKind("a list", "a number") },
    { source: "{{ lines | join \",\" }}", offset: 0, reason: WrongKind("a text", "a record") },
    {
      source: "{{ id | length }}",
      offset: 0,
      reason: WrongKind("a text, a list or a map", "a number"),
    },
    { source: "{{ include \"again\" }}", offset: 1, reason: TooDeep },
  ]

test "`{c.source}` has no filling, and says why" for c: FailureCase in failure_cases() {
  let failed = render_with_partials(c.source, order());
  assert_eq(
    failed,
    Err({
      partial: match failed { Err(f) -> f.partial, Ok(_) -> None },
      offset: c.offset,
      reason: c.reason,
    }),
  )
}

test "a failure in an included template names it, and where in its own text" {
  assert_eq(
    render_with_partials("{{ for l in lines }}{{ include \"line\" l.note }}{{ end }}", order()),
    Err({ partial: Some("line"), offset: 0, reason: Missing("sku") }),
  );
  assert_eq(
    render_with_partials("{{ include \"again\" }}", order()),
    Err({ partial: Some("again"), offset: 1, reason: TooDeep }),
  )
}

test "a filling stops at each of its limits" {
  let t = match parse("{{ for a in tags }}{{ for b in tags }}ab{{ end }}{{ end }}") {
    Ok(t) -> t,
    Err(_) -> panic("refused"),
  };
  let within = |limits: Limits|
    match render(t, order(), partials(), limits) { Ok(text) -> Ok(text), Err(f) -> Err(f.reason) };
  assert_eq(within({ output: 8, iterations: 6, depth: 0 }), Ok("abababab"));
  assert_eq(within({ output: 7, iterations: 6, depth: 0 }), Err(TooLong));
  assert_eq(within({ output: 8, iterations: 5, depth: 0 }), Err(TooManyPasses));
  let looping = match parse("{{ include \"who\" }}{{ include \"who\" }}") {
    Ok(t) -> t,
    Err(_) -> panic("refused"),
  };
  let included = |limits: Limits|
    match render(looping, order(), partials(), limits) {
      Ok(text) -> Ok(text),
      Err(f) -> Err(f.reason),
    };
  assert_eq(included({ output: 18, iterations: 2, depth: 1 }), Ok("Ann & BobAnn & Bob"));
  assert_eq(included({ output: 17, iterations: 2, depth: 1 }), Err(TooLong));
  assert_eq(included({ output: 18, iterations: 1, depth: 1 }), Err(TooManyPasses));
  assert_eq(included({ output: 18, iterations: 2, depth: 0 }), Err(TooDeep));
  // A template that includes itself ends at the deepest an include stands, whatever was asked.
  assert_eq(
    match parse("{{ include \"again\" }}") {
      Ok(endless) ->
        render(endless, order(), partials(), { output: 1000, iterations: 1000, depth: 1000000 }),
      Err(_) -> panic("refused"),
    },
    Err({ partial: Some("again"), offset: 1, reason: TooDeep }),
  )
}

type ErrorCase = { source: String, offset: Int, reason: ErrorKind }

fn error_cases() -> List<ErrorCase> =
  [
    { source: "a {{ b", offset: 2, reason: Unclosed },
    { source: "a {{ \"b }}", offset: 2, reason: Unclosed },
    { source: "{{! b", offset: 0, reason: Unclosed },
    { source: "{{ }}", offset: 0, reason: Expected("an action between `{{` and `}}`") },
    { source: "{{-  -}}", offset: 0, reason: Expected("an action between `{{` and `}}`") },
    { source: "{{ a | nope }}", offset: 0, reason: UnknownPipe("nope") },
    { source: "x{{ end }}", offset: 1, reason: Unopened("end") },
    { source: "{{ else }}", offset: 0, reason: Unopened("else") },
    { source: "{{ for a in b }}{{ else if c }}{{ end }}", offset: 16, reason: Unopened("else if") },
    { source: "{{ if a }}{{ else }}{{ else }}{{ end }}", offset: 20, reason: Unopened("else") },
    { source: "{{ if a }}x", offset: 0, reason: Unended("if") },
    { source: "{{ if a }}{{ for b in c }}{{ else }}", offset: 10, reason: Unended("for") },
    { source: "{{ if a }}{{ else }}", offset: 0, reason: Unended("if") },
    {
      source: "{{ for a b }}",
      offset: 0,
      reason: Expected("`for item in list` or `for key, item in map`"),
    },
    {
      source: "{{ a b }}",
      offset: 0,
      reason: Expected("`|` and a pipe's name, or the end of the action"),
    },
    { source: "{{ a. }}", offset: 0, reason: Expected("a name after `.`") },
    {
      source: "{{ a | default }}",
      offset: 0,
      reason: Expected("a path, `.` or a value written out"),
    },
    { source: "{{ | upper }}", offset: 0, reason: Expected("a path, `.` or a value written out") },
    { source: "{{ end x }}", offset: 0, reason: Expected("`}}` after this word") },
    {
      source: "{{ include who }}",
      offset: 0,
      reason: Expected("`include`, a template's name in quotes, and its data"),
    },
    {
      source: "\u{e9}{{ a $ }}",
      offset: 6,
      reason: Expected("a name, a value written out, `.`, `|`, `,` or `}}`"),
    },
    {
      source: "{{ \"a\\q\" }}",
      offset: 5,
      reason: Expected("`\\\\`, `\\\"`, `\\n` or `\\t` after a `\\`"),
    },
    {
      source: "{{ 99999999999999999999 }}",
      offset: 3,
      reason: Expected("a number an `Int` holds"),
    },
  ]

test "`{c.source}` is refused where it is no template" for c: ErrorCase in error_cases() {
  let place = position(c.source, c.offset);
  assert_eq(
    parse(c.source),
    Err({ offset: c.offset, line: place.line, column: place.column, reason: c.reason }),
  );
  assert(match parse_html(c.source) { Err(_) -> true, Ok(_) -> false })
}

test "a refusal stands at a line and a column of the template's text" {
  assert_eq(
    parse("line one\n  {{ end }}"),
    Err({ offset: 11, line: 2, column: 3, reason: Unopened("end") }),
  );
  assert_eq(position("a\n\u{e9}b\nc", 5), { line: 3, column: 1 });
  assert_eq(position("abc", 99), { line: 1, column: 4 });
  assert_eq(position("", 0), { line: 1, column: 1 });
  let nested = |n: Int|
    String::join(range(0, n).map(|_: Int| "{{ if a }}"), "")
      ++ String::join(range(0, n).map(|_: Int| "{{ end }}"), "");
  assert(match parse(nested(max_depth())) { Ok(_) -> true, Err(_) -> false });
  assert_eq(
    parse(nested(max_depth() + 1)),
    Err({ offset: 10 * max_depth(), line: 1, column: 10 * max_depth() + 1, reason: Nested }),
  )
}

test "a JSON document is data: its objects maps, its arrays lists and its null a `None`" {
  let data = match json::parse_string(
      "{\"name\":\"Ann\",\"n\":3,\"half\":0.5,\"on\":true,\"gone\":null,\"tags\":[\"x\",\"y\"],\"at\":{\"city\":\"Oslo\"}}",
    ) {
    Ok(j) -> of_json(j),
    Err(_) -> panic("no JSON"),
  };
  assert_eq(
    render_with_partials(
      "{{ name }} {{ n }} {{ half }} {{ on }} {{ gone | default \"-\" }} {{ at.city }} {{ tags | join \"+\" }}",
      data,
    ),
    Ok("Ann 3 0.5 true - Oslo x+y"),
  );
  assert_eq(
    render_with_partials("{{ for k, v in at }}{{ k }}:{{ v }}{{ end }}", data),
    Ok("city:Oslo"),
  );
  assert_eq(render_with_partials("{{ if gone }}a{{ else }}b{{ end }}", data), Ok("b"));
  assert_eq(render_with_partials("{{ . | json }}", of_json(json::int(3))), Ok("3"));
  assert_eq(of_json(json::Null), reflect(vacant()));
  assert_eq(
    render_with_partials(
      "{{ pieces }}",
      of_json(json::object([{ key: "pieces", value: json::Str("<b>") }])),
    ),
    Ok("<b>"),
  )
}

fn vacant() -> Option<Int> = None

// --- Tests as HTML ------------------------------------------------------------

type Link = { label: String, kind: String }

type HtmlOutput = {
  name: String,
  url: String,
  q: String,
  js: String,
  vouched: Html,
  safe: Html,
  n: Int,
  on: Bool,
  off: Bool,
  links: List<Link>,
}

fn page() -> Value = {
  let p: HtmlOutput = {
    name: "<b>O'Neil & \"Co\"</b>",
    url: "/a b?c=d&e",
    q: "a b&c=/",
    js: "JavaScript:alert(1)",
    vouched: html::trusted_url("javascript:void(0)"),
    safe: html::fragment([html::text("1 < 2")]),
    n: 3,
    on: true,
    off: false,
    links: [{ label: "A&B", kind: "x\" onclick=\"y" }, { label: "<C>", kind: "z" }],
  };
  reflect(p)
}

fn render_page(source: String, data: Value) -> Result<String, Failure> / {abort.raise} =
  match parse_html(source) {
    Ok(t) -> render(t, data, html_partials(), default_limits()),
    Err(r) -> panic("refused: " ++ explain(r.reason)),
  }

fn html_partials() -> Map<String, Template> / {abort.raise} =
  Map::of_entries([
    {
      key: "link",
      value: match parse_html("<a class=\"{{ kind }}\">{{ label }}</a>") {
        Ok(t) -> t,
        Err(r) -> panic(explain(r.reason)),
      },
    },
    {
      key: "plain",
      value: match parse("<{{ label }}>") { Ok(t) -> t, Err(r) -> panic(explain(r.reason)) },
    },
  ])

/// The places a value stands in, after the contexts Go's `html/template` tells apart, each with
/// what this module writes there.
fn html_fill_cases() -> List<FillCase> =
  [
    {
      source: "<p>{{ name }}</p>",
      text: "<p>&lt;b&gt;O&#39;Neil &amp; &quot;Co&quot;&lt;/b&gt;</p>",
    },
    {
      source: "<p title=\"{{ name }}\">x</p>",
      text: "<p title=\"&lt;b&gt;O&#39;Neil &amp; &quot;Co&quot;&lt;/b&gt;\">x</p>",
    },
    {
      source: "<p title='a {{ name }} b'>x</p>",
      text: "<p title='a &lt;b&gt;O&#39;Neil &amp; &quot;Co&quot;&lt;/b&gt; b'>x</p>",
    },
    {
      source: "<p title={{ name }} id={{ n }}>x</p>",
      text: "<p title=\"&lt;b&gt;O&#39;Neil &amp; &quot;Co&quot;&lt;/b&gt;\" id=\"3\">x</p>",
    },
    {
      source: "<textarea>{{ name }}</textarea><title>{{ name }}</title>",
      text: "<textarea>&lt;b&gt;O&#39;Neil &amp; &quot;Co&quot;&lt;/b&gt;</textarea><title>&lt;b&gt;O&#39;Neil &amp; &quot;Co&quot;&lt;/b&gt;</title>",
    },
    { source: "<a href=\"{{ url }}\">x</a>", text: "<a href=\"/a%20b?c=d&amp;e\">x</a>" },
    { source: "<a href={{ url }}>x</a>", text: "<a href=\"/a%20b?c=d&amp;e\">x</a>" },
    { source: "<a href='/u/{{ q }}/x'>x</a>", text: "<a href='/u/a%20b&amp;c=//x'>x</a>" },
    {
      source: "<a href=\"/s?q={{ q }}&amp;n={{ n }}\">x</a>",
      text: "<a href=\"/s?q=a%20b%26c%3D%2F&amp;n=3\">x</a>",
    },
    { source: "<a href=\"#{{ q }}\">x</a>", text: "<a href=\"#a%20b%26c%3D%2F\">x</a>" },
    {
      source: "<a href=\"https://example.com/{{ q }}\">x</a>",
      text: "<a href=\"https://example.com/a%20b&amp;c=/\">x</a>",
    },
    {
      source: "<a href=\"mailto:{{ name }}\">x</a>",
      text: "<a href=\"mailto:%3Cb%3EO&#39;Neil%20&amp;%20%22Co%22%3C/b%3E\">x</a>",
    },
    { source: "<a href=\"p{{ n }}.html\">x</a>", text: "<a href=\"p3.html\">x</a>" },
    {
      source: "<img src=\"{{ url }}\"><form action=\"{{ url }}\"></form>",
      text: "<img src=\"/a%20b?c=d&amp;e\"><form action=\"/a%20b?c=d&amp;e\"></form>",
    },
    {
      source: "<a href=\"{{ vouched }}\">{{ vouched }}</a>",
      text: "<a href=\"javascript:void(0)\">javascript:void(0)</a>",
    },
    {
      source: "<a title=\"{{ js }}\">{{ js }}</a>",
      text: "<a title=\"JavaScript:alert(1)\">JavaScript:alert(1)</a>",
    },
    {
      source: "<p>{{ safe }}</p><p title=\"{{ safe }}\"></p>",
      text: "<p>1 &lt; 2</p><p title=\"1 &lt; 2\"></p>",
    },
    {
      source: "<p>{{ q | url }} {{ name | upper | length }}</p>",
      text: "<p>a%20b%26c%3D%2F 20</p>",
    },
    {
      source: "<ul>{{ for l in links }}<li class=\"{{ l.kind }}\">{{ l.label }}</li>{{ else }}<li>none</li>{{ end }}</ul>",
      text: "<ul><li class=\"x&quot; onclick=&quot;y\">A&amp;B</li><li class=\"z\">&lt;C&gt;</li></ul>",
    },
    {
      source: "<input type=\"checkbox\"{{ if on }} checked{{ end }}{{ if off }} disabled{{ end }}>",
      text: "<input type=\"checkbox\" checked>",
    },
    {
      source: "<a{{ if url }} href=\"{{ url }}\"{{ end }} {{ if off }}hidden {{ end }}id=\"a\">x</a>",
      text: "<a href=\"/a%20b?c=d&amp;e\" id=\"a\">x</a>",
    },
    {
      source: "<p{{ if on }} data-{{! none }}k=\"{{ name }}\"{{ end }}>x</p>",
      text: "<p data-k=\"&lt;b&gt;O&#39;Neil &amp; &quot;Co&quot;&lt;/b&gt;\">x</p>",
    },
    {
      source: "{{ if on }}<b>{{ else }}<i>{{ end }}{{ n }}{{ if on }}</b>{{ else }}</i>{{ end }}",
      text: "<b>3</b>",
    },
    {
      source: "<a href=\"{{ if on }}/on{{ else }}/off/{{ end }}{{ n }}\" title=\"{{ if off }}a{{ end }}{{ n }}\">x</a>",
      text: "<a href=\"/on3\" title=\"3\">x</a>",
    },
    {
      source: "<p>{{ for l in links }}{{ include \"link\" l }}{{ include \"plain\" l }}{{ end }}</p>",
      text: "<p><a class=\"x&quot; onclick=&quot;y\">A&amp;B</a>&lt;A&amp;B&gt;<a class=\"z\">&lt;C&gt;</a>&lt;&lt;C&gt;&gt;</p>",
    },
    {
      source: "<p title=\"{{ for l in links }}{{ include \"link\" l }}{{ end }}\">x</p>",
      text: "<p title=\"&lt;a class=&quot;x&quot; onclick=&quot;y&quot;&gt;A&amp;B&lt;/a&gt;&lt;a class=&quot;z&quot;&gt;&lt;C&gt;&lt;/a&gt;\">x</p>",
    },
    { source: "<!DOCTYPE html>\n<p>\n  {{- n -}}\n</p>", text: "<!DOCTYPE html>\n<p>3</p>" },
    {
      source: "<a href=\"/x{{ if on }}?q={{ q }}{{ end }}#{{ n }}\">x</a>",
      text: "<a href=\"/x?q=a%20b%26c%3D%2F#3\">x</a>",
    },
  ]

test "as HTML, `{c.source}` writes each value as its place reads it" for c: FillCase in html_fill_cases(
  ) { assert_eq(render_page(c.source, page()), Ok(c.text)) }

fn html_error_cases() -> List<ErrorCase> =
  [
    {
      source: "<script>var n = {{ n }};</script>",
      offset: 16,
      reason: Misplaced("a hole in `<script>` would be read as its code"),
    },
    {
      source: "<style>p { width: {{ n }}px }</style>",
      offset: 18,
      reason: Misplaced("a hole in `<style>` would be read as its code"),
    },
    {
      source: "<a onclick=\"go({{ n }})\">x</a>",
      offset: 15,
      reason: Misplaced("a hole in `onclick` would be read as code, which no escaping makes text"),
    },
    {
      source: "<p style=\"width: {{ n }}px\">x</p>",
      offset: 17,
      reason: Misplaced("a hole in `style` would be read as code, which no escaping makes text"),
    },
    {
      source: "<p {{ name }}>x</p>",
      offset: 3,
      reason: Misplaced("a hole stands in an element's content or in an attribute's value"),
    },
    {
      source: "<{{ name }}>x",
      offset: 1,
      reason: Misplaced("a hole stands in an element's content or in an attribute's value"),
    },
    {
      source: "<p class=a{{ name }}>x</p>",
      offset: 10,
      reason: Misplaced("quote the value: a hole stands inside its quotes, or as the whole of it"),
    },
    { source: "<!-- {{ name }} -->", offset: 5, reason: Misplaced("a comment holds no hole") },
    {
      source: "<a href=\"javascript:go({{ n }})\">x</a>",
      offset: 23,
      reason: Misplaced(
        "a hole stands in a URL with no scheme, or with `http`, `https`, `mailto` or `tel`: this one's is `javascript`",
      ),
    },
    {
      source: "<a href=\"{{ if on }}/a{{ else }}?{{ end }}{{ n }}\">x</a>",
      offset: 42,
      reason: Misplaced("the markup before this hole leaves its URL at more than one part"),
    },
    {
      source: "<a href=\"{{ name }}://example.com\">x</a>",
      offset: 19,
      reason: Markup(
        "a `:` here makes the value before it the URL's scheme: write the scheme out, or let one hole hold the whole URL",
      ),
    },
    {
      source: "a < b",
      offset: 3,
      reason: Markup(html::explain(html::InvalidFirstCharacterOfTagName)),
    },
    { source: "<p>{{ n }}</p", offset: 13, reason: Markup(html::explain(html::EofInTag)) },
    { source: "<p title=\"{{ n }}", offset: 17, reason: Markup(html::explain(html::EofInTag)) },
    {
      source: "<p{{ for l in links }} data-{{! none }}k=\"{{ l.label }}\"{{ end }}>x</p>",
      offset: 40,
      reason: Markup(html::explain(html::DuplicateAttribute)),
    },
    {
      source: "<img srcset=\"/a.png {{ n }}x\">",
      offset: 20,
      reason: Misplaced("a hole in a `srcset` stands in a candidate's URL, not in its descriptors"),
    },
    { source: "{{ if on }}<p{{ end }}>x</p>", offset: 0, reason: Uneven },
    { source: "<p{{ if on }} title=\"{{ else }}>{{ end }}", offset: 2, reason: Uneven },
    { source: "<p title=\"{{ for l in links }}\"{{ end }}>", offset: 10, reason: Uneven },
    { source: "{{ for l in links }}<p {{ end }}>", offset: 0, reason: Uneven },
    { source: "<p>{{ for l in links }}<b{{ else }}<i>{{ end }}</p>", offset: 3, reason: Uneven },
    { source: "<p>{{ name | html }}</p>", offset: 3, reason: EscapedTwice("html") },
    { source: "<a href=\"/s?q={{ q | url }}\">x</a>", offset: 14, reason: EscapedTwice("url") },
    { source: "<p>{{ include \"link\" . | html }}</p>", offset: 3, reason: EscapedTwice("html") },
  ]

test "as HTML, `{c.source}` is refused where it is read" for c: ErrorCase in html_error_cases() {
  let place = position(c.source, c.offset);
  assert_eq(
    parse_html(c.source),
    Err({ offset: c.offset, line: place.line, column: place.column, reason: c.reason }),
  )
}

test "loops nested thirty deep in an attribute are read as HTML" {
  let nested = "<a href=\"" ++ "{{ for x in xs }}".repeat(30) ++ "/x" ++ "{{ end }}".repeat(30)
    ++ "\">x</a>";
  assert(match parse_html(nested) { Ok(_) -> true, Err(_) -> false })
}

test "a value that would name a URL's scheme fails the filling, unless it is vouched for" {
  let why = |source: String|
    match render_page(source, page()) { Ok(text) -> Ok(text), Err(f) -> Err(f.reason) };
  assert_eq(why("<a href=\"{{ js }}\">x</a>"), Err(UnsafeUrl("JavaScript")));
  assert_eq(why("<a href={{ js }}>x</a>"), Err(UnsafeUrl("JavaScript")));
  assert_eq(why("<a href=\"x{{ js }}\">x</a>"), Err(UnsafeUrl("JavaScript")));
  assert_eq(why("<a href=\"{{ n }}{{ js }}\">x</a>"), Err(UnsafeUrl("JavaScript")));
  assert_eq(why("<a href=\"/{{ js }}\">x</a>"), Ok("<a href=\"/JavaScript:alert(1)\">x</a>"));
  assert_eq(
    why("<a href=\"?u={{ js }}\">x</a>"),
    Ok("<a href=\"?u=JavaScript%3Aalert%281%29\">x</a>"),
  );
  assert_eq(why("<a href=\"x{{ vouched }}\">x</a>"), Ok("<a href=\"xjavascript:void(0)\">x</a>"));
  assert_eq(why("<a href=\"{{ vouched | lower }}\">x</a>"), Err(WrongKind("a text", "markup")));
  assert_eq(why("<a href=\"{{ safe }}\">x</a>"), Ok("<a href=\"1%20%3C%202\">x</a>"));
  let bold = match html::literal("<b>x</b>") { Ok(h) -> h, Err(_) -> html::text("") };
  assert_eq(
    match render_page("<a href=\"{{ m }}\">x</a>", reflect({ m: bold })) {
      Ok(text) -> Ok(text),
      Err(f) -> Err(f.reason),
    },
    Err(WrongKind("the text of a URL", "markup")),
  );
  assert_eq(why("<img srcset=\"{{ url }} 2x\">"), Ok("<img srcset=\"/a%20b?c=d&amp;e 2x\">"));
  assert_eq(why("<a ping=\"/p {{ js }}\">x</a>"), Err(UnsafeUrl("JavaScript")));
  assert_eq(
    why("<meta http-equiv=\"refresh\" content=\"0;url={{ js }}\">"),
    Err(UnsafeUrl("JavaScript")),
  );
  assert_eq(
    why("<meta http-equiv=\"refresh\" content=\"0; {{ url }}\">"),
    Ok("<meta http-equiv=\"refresh\" content=\"0; /a%20b?c=d&amp;e\">"),
  );
  assert_eq(why("<a href=\"{{ links }}\">x</a>"), Err(WrongKind("a text", "a list")))
}

test "a template's filling is markup or text, whichever way it was read" {
  let markup = match parse_html("<b>{{ name }}</b>") { Ok(t) -> t, Err(_) -> panic("refused") };
  let words = match parse("<b>{{ name }}</b>") { Ok(t) -> t, Err(_) -> panic("refused") };
  let data = reflect({ name: "a<b" });
  let filled_as = |t: Template|
    match render_html(t, data, Map::new(), default_limits()) {
      Ok(page) -> html::render(page),
      Err(f) -> explain(f.reason),
    };
  assert_eq(filled_as(markup), "<b>a&lt;b</b>");
  assert_eq(filled_as(words), "&lt;b&gt;a&lt;b&lt;/b&gt;");
  assert_eq(render(words, data, Map::new(), default_limits()), Ok("<b>a<b</b>"));
  // What an HTML template wrote is markup to the next one, and text to a template of text.
  let inner = match render_html(markup, data, Map::new(), default_limits()) {
    Ok(page) -> reflect({ name: page }),
    Err(_) -> panic("failed"),
  };
  assert_eq(filled_as(markup), "<b>a&lt;b</b>");
  assert_eq(render(markup, inner, Map::new(), default_limits()), Ok("<b><b>a&lt;b</b></b>"));
  assert_eq(render(words, inner, Map::new(), default_limits()), Ok("<b><b>a&lt;b</b></b>"))
}

/// What the browser reads the one `href` of a page as: its value with its references read.
fn href_of(page: String) -> String / {abort.raise} =
  match page.split("href=\"") {
    [_, after, ..] -> match after.split("\"") {
      [value, ..] -> html::unescape_attribute(value),
      [] -> "",
    },
    _ -> "",
  }

fn url_sources() -> List<String> =
  [
    "<a href=\"{{ u }}\">x</a>",
    "<a href={{ u }}>x</a>",
    "<a href=\" {{ u }}\">x</a>",
    "<a href=\"{{ u }}{{ u }}\">x</a>",
    "<a href=\"x{{ u }}\">x</a>",
    "<a href=\"{{ u }}/{{ u }}\">x</a>",
    "<a href=\"{{ u }}?{{ u }}\">x</a>",
    "<a href=\"{{ if on }}{{ u }}{{ end }}\">x</a>",
    "<a href=\"{{ if on }}{{ u }}{{ else }}/b{{ end }}?{{ u }}\">x</a>",
    "<a href=\"/a{{ if on }}?x={{ u }}{{ end }}#{{ u }}\">x</a>",
  ]

test "a value written into a URL never gives it a scheme but `http`, `https`, `mailto` or `tel`" {
  gen::check2(html::hostile(), gen::any_int(), |h: html::Hostile, n: Int| {
    let source = url_sources().at_or(n & 15, "<a href=\"{{ u }}\">x</a>");
    let data = reflect({ u: html::hostile_text(h), on: true });
    match render_page(source, data) {
      Err(f) -> match f.reason { UnsafeUrl(_) -> true, _ -> false },
      Ok(text) -> match html::browser_scheme(href_of(text)) {
        None -> true,
        Some(scheme) ->
          scheme == "http" || scheme == "https" || scheme == "mailto" || scheme == "tel",
      },
    }
  })
}

/// A template made of the pieces a template is written of, in any order.
type Sketch = | Sketch(String)

fn sketches() -> Gen<Sketch> =
  gen::map(gen::list_of(gen::elements(sketch_parts()), 10), |parts: List<String>|
    Sketch(String::join(parts, "")))

fn sketch_parts() -> List<String> =
  [
    "x",
    " ",
    "{{ s }}",
    "<p>{{ s }}</p>",
    "<p title=\"{{ s }}\" id={{ n }}>",
    "</p>",
    "<a href=\"{{ s }}\">",
    "<a href='/{{ s }}?q={{ s }}#{{ n }}'>",
    "</a>",
    "<textarea>{{ s }}</textarea>",
    "<!-- {{! c }} -->",
    "{{ include \"p\" }}",
    "{{ if on }}<b>{{ else }}<i>{{ end }}",
    "<p{{ if on }} title=\"{{ s }}\"{{ end }}{{ if off }} hidden{{ end }}>",
    "<ul>{{ for x in xs }}<li class='{{ x }}'>{{- x -}}</li>{{ else }}{{ n }}{{ end }}</ul>",
    "<a href=\"{{ if off }}/a{{ else }}/b/{{ end }}{{ n }}\">",
    "<p{{ for x in xs }} data-x=\"{{ x }}\"{{ end }}>",
    "{{ if on }}",
    "{{ if off }}",
    "{{ else }}",
    "{{ end }}",
    "{{ for x in xs }}",
    "{{ x }}",
    "<p",
    ">",
    " title=\"",
    " href=\"",
    " class='",
    " id=",
    "\"",
    "'",
    "/",
    "?",
    ":",
    "&amp;",
    "<textarea>",
    "</textarea>",
  ]

fn sketch_data() -> Value =
  reflect({ s: "\"'><script>&:/?#", n: 1, on: true, off: false, xs: ["a b", "'\"", ""] })

fn sketch_partials() -> Map<String, Template> / {abort.raise} =
  match parse_html("<i>{{ s }}</i>") { Ok(t) -> #{"p": t}, Err(r) -> panic(explain(r.reason)) }

test "a template read as HTML fills to markup `std.html` reads again, and by no defect" {
  gen::check(sketches(), |k: Sketch| {
    match k {
      Sketch(source) -> match parse_html(source) {
        Err(r) -> match r.reason { Defect(_) -> false, _ -> true },
        Ok(t) -> match render(t, sketch_data(), sketch_partials(), default_limits()) {
          Err(f) -> match f.reason { Defect(_) -> false, _ -> true },
          Ok(text) -> match html::literal(text) { Ok(_) -> true, Err(_) -> false },
        },
      },
    }
  })
}

test "a template read as text is filled or fails, and by no defect" {
  gen::check(sketches(), |k: Sketch| {
    match k {
      Sketch(source) -> match parse(source) {
        Err(r) -> match r.reason { Defect(_) -> false, _ -> true },
        Ok(t) -> match render(t, sketch_data(), sketch_partials(), default_limits()) {
          Err(f) -> match f.reason { Defect(_) -> false, _ -> true },
          Ok(_) -> true,
        },
      },
    }
  })
}
