      text: "<a href=\"/x?q=a%20b%26c%3D%2F#3\">x</a>",
    },
  ]

test "rendering `{c.source}` as HTML escapes each value for its place: element text, attribute value or URL" for c: FillCase in html_fill_cases {
  assert_eq(render_page(c.source, page()), Ok(c.text))
}

const html_error_cases: List<ErrorCase> =
  [
    {
      source: "<script>var n = {{ n }};</script>",
      offset: 16,
      reason: Misplaced("a hole in `<script>` would be read as the element's script or style text"),
    },
    {
      source: "<style>p { width: {{ n }}px }</style>",
      offset: 18,
      reason: Misplaced("a hole in `<style>` would be read as the element's script or style text"),
    },
    {
      source: "<a onclick=\"go({{ n }})\">x</a>",
      offset: 15,
      reason: Misplaced(
        "a hole in `onclick` would be read as program code, and escaping cannot turn the hole's value into text",
      ),
    },
    {
      source: "<p style=\"width: {{ n }}px\">x</p>",
      offset: 17,
      reason: Misplaced(
        "a hole in `style` would be read as program code, and escaping cannot turn the hole's value into text",
      ),
    },
    {
      source: "<p {{ name }}>x</p>",
      offset: 3,
      reason: Misplaced(
        "a hole can appear only in an element's content or in an attribute's value",
      ),
    },
    {
      source: "<{{ name }}>x",
      offset: 1,
      reason: Misplaced(
        "a hole can appear only in an element's content or in an attribute's value",
      ),
    },
    {
      source: "<p class=a{{ name }}>x</p>",
      offset: 10,
      reason: Misplaced("quote the value: a hole must be inside its quotes, or be the whole value"),
    },
    {
      source: "<!-- {{ name }} -->",
      offset: 5,
      reason: Misplaced("a hole cannot be inside a comment"),
    },
    {
      source: "<a href=\"javascript:go({{ n }})\">x</a>",
      offset: 23,
      reason: Misplaced(
        "a hole is allowed in a URL with no scheme or with the scheme `http`, `https`, `mailto` or `tel`: this URL's scheme is `javascript`",
      ),
    },
    {
      source: "<a href=\"{{ if on }}/a{{ else }}?{{ end }}{{ n }}\">x</a>",
      offset: 42,
      reason: Misplaced(
        "the markup before this hole ends in more than one part of the URL, such as the path and the query, so it is unclear where in the URL the hole is: end the markup in one part",
      ),
    },
    {
      source: "<a href=\"{{ name }}://example.com\">x</a>",
      offset: 19,
      reason: Markup(
        "a `:` after a hole makes the hole's value a URL scheme such as `https`: write the scheme in the markup, or put the whole URL in the hole",
      ),
    },
    {
      source: "a < b",
      offset: 3,
      reason: Markup(html::explain(html::InvalidFirstCharacterOfTagName)),
    },
    { source: "<p>{{ n }}</p", offset: 13, reason: Markup(html::explain(html::EofInTag)) },
    { source: "<p title=\"{{ n }}", offset: 17, reason: Markup(html::explain(html::EofInTag)) },
    {
      source: "<p{{ for l in links }} data-{{! none }}k=\"{{ l.label }}\"{{ end }}>x</p>",
      offset: 40,
      reason: Markup(html::explain(html::DuplicateAttribute)),
    },
    {
      source: "<img srcset=\"/a.png {{ n }}x\">",
      offset: 20,
      reason: Misplaced(
        "a hole in a `srcset` must be in a candidate's URL, not in its descriptors",
      ),
    },
    { source: "{{ if on }}<p{{ end }}>x</p>", offset: 0, reason: Uneven },
    { source: "<p{{ if on }} title=\"{{ else }}>{{ end }}", offset: 2, reason: Uneven },
    { source: "<p title=\"{{ for l in links }}\"{{ end }}>", offset: 10, reason: Uneven },
    { source: "{{ for l in links }}<p {{ end }}>", offset: 0, reason: Uneven },
    { source: "<p>{{ for l in links }}<b{{ else }}<i>{{ end }}</p>", offset: 3, reason: Uneven },
    { source: "<p>{{ name | html }}</p>", offset: 3, reason: EscapedTwice("html") },
    { source: "<a href=\"/s?q={{ q | url }}\">x</a>", offset: 14, reason: EscapedTwice("url") },
    { source: "<p>{{ include \"link\" . | html }}</p>", offset: 3, reason: EscapedTwice("html") },
  ]

test "as HTML, `{c.source}` is rejected when parsed" for c: ErrorCase in html_error_cases {
  let place = position(c.source, c.offset);
  assert_eq(
    parse_html(c.source),
    Err({ offset: c.offset, line: place.line, column: place.column, reason: c.reason }),
  )
}

test "`parse_html` accepts thirty nested loops inside an attribute value" {
  let nested = "<a href=\"" ++ "{{ for x in xs }}".repeat(30) ++ "/x" ++ "{{ end }}".repeat(30)
    ++ "\">x</a>";
  assert(match parse_html(nested) { Ok(_) -> true, Err(_) -> false })
}

test "rendering HTML fails when a value could start a URL with a scheme such as `javascript:`, unless the value is a trusted URL" {
  let reason = |source: String|
    match render_page(source, page()) { Ok(text) -> Ok(text), Err(f) -> Err(f.reason) };
  assert_eq(reason("<a href=\"{{ js }}\">x</a>"), Err(UnsafeUrl("JavaScript")));
  assert_eq(reason("<a href={{ js }}>x</a>"), Err(UnsafeUrl("JavaScript")));
  assert_eq(reason("<a href=\"x{{ js }}\">x</a>"), Err(UnsafeUrl("JavaScript")));
  assert_eq(reason("<a href=\"{{ n }}{{ js }}\">x</a>"), Err(UnsafeUrl("JavaScript")));
  assert_eq(reason("<a href=\"/{{ js }}\">x</a>"), Ok("<a href=\"/JavaScript:alert(1)\">x</a>"));
  assert_eq(
    reason("<a href=\"?u={{ js }}\">x</a>"),
    Ok("<a href=\"?u=JavaScript%3Aalert%281%29\">x</a>"),
  );
  assert_eq(
    reason("<a href=\"x{{ trusted_url }}\">x</a>"),
    Ok("<a href=\"xjavascript:void(0)\">x</a>"),
  );
  assert_eq(
    reason("<a href=\"{{ trusted_url | lower }}\">x</a>"),
    Err(WrongKind("a text", "markup")),
  );
  assert_eq(reason("<a href=\"{{ safe }}\">x</a>"), Ok("<a href=\"1%20%3C%202\">x</a>"));
  let bold = match html::literal("<b>x</b>") { Ok(h) -> h, Err(_) -> html::text("") };
  assert_eq(
    match render_page("<a href=\"{{ m }}\">x</a>", reflect({ m: bold })) {
      Ok(text) -> Ok(text),
      Err(f) -> Err(f.reason),
    },
    Err(WrongKind("the text of a URL", "markup")),
  );
  assert_eq(reason("<img srcset=\"{{ url }} 2x\">"), Ok("<img srcset=\"/a%20b?c=d&amp;e 2x\">"));
  assert_eq(reason("<a ping=\"/p {{ js }}\">x</a>"), Err(UnsafeUrl("JavaScript")));
  assert_eq(
    reason("<meta http-equiv=\"refresh\" content=\"0;url={{ js }}\">"),
    Err(UnsafeUrl("JavaScript")),
  );
  assert_eq(
    reason("<meta http-equiv=\"refresh\" content=\"0; {{ url }}\">"),
    Ok("<meta http-equiv=\"refresh\" content=\"0; /a%20b?c=d&amp;e\">"),
  );
  assert_eq(reason("<a href=\"{{ links }}\">x</a>"), Err(WrongKind("a text", "a list")))
}

test "a template parsed with `parse_html` renders values as markup, and one parsed with `parse` renders them as text" {
  let markup = match parse_html("<b>{{ name }}</b>") { Ok(t) -> t, Err(_) -> panic("refused") };
  let words = match parse("<b>{{ name }}</b>") { Ok(t) -> t, Err(_) -> panic("refused") };
  let data = reflect({ name: "a<b" });
  let filled_as = |t: Template|
    match render_html(t, data, Map::new(), default_limits) {
      Ok(page) -> html::render(page),
      Err(f) -> explain(f.reason),
    };
  assert_eq(filled_as(markup), "<b>a&lt;b</b>");
  assert_eq(filled_as(words), "&lt;b&gt;a&lt;b&lt;/b&gt;");
  assert_eq(render(words, data, Map::new(), default_limits), Ok("<b>a<b</b>"));
  let inner = match render_html(markup, data, Map::new(), default_limits) {
    Ok(page) -> reflect({ name: page }),
    Err(_) -> panic("failed"),
  };
  assert_eq(filled_as(markup), "<b>a&lt;b</b>");
  assert_eq(render(markup, inner, Map::new(), default_limits), Ok("<b><b>a&lt;b</b></b>"));
  assert_eq(render(words, inner, Map::new(), default_limits), Ok("<b><b>a&lt;b</b></b>"))
}

fn href_of(page: String) -> String / {abort.raise} =
  match page.split("href=\"") {
    [_, after, ..] -> match after.split("\"") {
      [value, ..] -> html::unescape_attribute(value),
      [] -> "",
    },
    _ -> "",
  }

const url_sources: List<String> =
  [
    "<a href=\"{{ u }}\">x</a>",
    "<a href={{ u }}>x</a>",
    "<a href=\" {{ u }}\">x</a>",
    "<a href=\"{{ u }}{{ u }}\">x</a>",
    "<a href=\"x{{ u }}\">x</a>",
    "<a href=\"{{ u }}/{{ u }}\">x</a>",
    "<a href=\"{{ u }}?{{ u }}\">x</a>",
    "<a href=\"{{ if on }}{{ u }}{{ end }}\">x</a>",
    "<a href=\"{{ if on }}{{ u }}{{ else }}/b{{ end }}?{{ u }}\">x</a>",
    "<a href=\"/a{{ if on }}?x={{ u }}{{ end }}#{{ u }}\">x</a>",
  ]

test "a value written into a URL never gives the URL a scheme other than `http`, `https`, `mailto` or `tel`" {
  gen::check2(html::hostile(), gen::any_int(), |h: html::Hostile, n: Int| {
    let source = url_sources.at_or(n & 15, "<a href=\"{{ u }}\">x</a>");
    let data = reflect({ u: html::hostile_text(h), on: true });
    match render_page(source, data) {
      Err(f) -> match f.reason { UnsafeUrl(_) -> true, _ -> false },
      Ok(text) -> match html::browser_scheme(href_of(text)) {
        None -> true,
        Some(scheme) ->
          scheme == "http" || scheme == "https" || scheme == "mailto" || scheme == "tel",
      },
    }
  })
}

type Sketch = | Sketch(String)

fn sketches() -> Gen<Sketch> =
  gen::map(gen::list_of(gen::elements(sketch_parts), 10), |parts: List<String>|
    Sketch(String::join(parts, "")))

const sketch_parts: List<String> =
  [
    "x",
    " ",
    "{{ s }}",
    "<p>{{ s }}</p>",
    "<p title=\"{{ s }}\" id={{ n }}>",
    "</p>",
    "<a href=\"{{ s }}\">",
    "<a href='/{{ s }}?q={{ s }}#{{ n }}'>",
    "</a>",
    "<textarea>{{ s }}</textarea>",
    "<!-- {{! c }} -->",
    "{{ include \"p\" }}",
    "{{ if on }}<b>{{ else }}<i>{{ end }}",
    "<p{{ if on }} title=\"{{ s }}\"{{ end }}{{ if off }} hidden{{ end }}>",
    "<ul>{{ for x in xs }}<li class='{{ x }}'>{{- x -}}</li>{{ else }}{{ n }}{{ end }}</ul>",
    "<a href=\"{{ if off }}/a{{ else }}/b/{{ end }}{{ n }}\">",
    "<p{{ for x in xs }} data-x=\"{{ x }}\"{{ end }}>",
    "{{ if on }}",
    "{{ if off }}",
    "{{ else }}",
    "{{ end }}",
    "{{ for x in xs }}",
    "{{ x }}",
    "<p",
    ">",
    " title=\"",
    " href=\"",
    " class='",
    " id=",
    "\"",
    "'",
    "/",
    "?",
    ":",
    "&amp;",
    "<textarea>",
    "</textarea>",
  ]

const sketch_data: Value =
  reflect({ s: "\"'><script>&:/?#", n: 1, on: true, off: false, xs: ["a b", "'\"", ""] })

const sketch_partials: Map<String, Template> =
  match parse_html("<i>{{ s }}</i>") { Ok(t) -> #{"p": t}, Err(r) -> panic(explain(r.reason)) }

test "a template parsed as HTML renders to markup that `std.html` parses again, and never fails with an internal `Defect`" {
  gen::check(sketches(), |k: Sketch| {
    match k {
      Sketch(source) -> match parse_html(source) {
        Err(r) -> match r.reason { Defect(_) -> false, _ -> true },
        Ok(t) -> match render(t, sketch_data, sketch_partials, default_limits) {
          Err(f) -> match f.reason { Defect(_) -> false, _ -> true },
          Ok(text) -> match html::literal(text) { Ok(_) -> true, Err(_) -> false },
        },
      },
    }
  })
}

test "a template parsed as text renders or fails with a normal error, and never fails with an internal `Defect`" {
  gen::check(sketches(), |k: Sketch| {
    match k {
      Sketch(source) -> match parse(source) {
        Err(r) -> match r.reason { Defect(_) -> false, _ -> true },
        Ok(t) -> match render(t, sketch_data, sketch_partials, default_limits) {
          Err(f) -> match f.reason { Defect(_) -> false, _ -> true },
          Ok(_) -> true,
        },
      },
    }
  })
}
