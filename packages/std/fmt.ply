//! Numbers, sizes and spans of time as text for people to read.
//!
//! The prelude writes a number one way: `Int::to_string`, `Decimal::to_string` at the value's own
//! scale, and `Float::to_string`, the shortest text that reads back. Here a number can be written
//! to a fixed number of places (`fixed`), in scientific notation (`scientific`), to a number of
//! significant digits (`general`) or as a percentage (`percent`). A number's text can be grouped,
//! signed and zero-padded (`grouped`, `signed`, `zero_padded`). A `Decimal` and an `Int` can be
//! written the same ways (`fixed_decimal`, `scientific_decimal`, `scientific_int`), and so can an
//! `Int` that counts small units in whole ones (`fixed_point`). A count of bytes is written in
//! readable units (`size`, parsed back by `parse_size`), and a `Duration` roughly (`duration`).
//!
//! Each is a function with named options, not a format string, so a wrong option fails to check.
//! Every one is total and performs no effects, and none reads a locale: a separator is an
//! argument, and each function's doc states its default.
//!
//! The digits are exact. A `Float` is a whole number over a power of two, so it has a last decimal
//! digit. What is written is that expansion rounded once, by the given `Rounding`: `0.125` to two
//! places is `0.12` under `HalfEven` and `0.13` under `HalfUp`, and `2.675`, whose nearest float
//! lies just below it, is `2.67` under both. `HalfEven`, the default, and `HalfUp` take the
//! nearest value, with a tie going to the even digit or away from zero. `Down` rounds toward zero,
//! `Up` away from it, `Ceiling` toward positive infinity and `Floor` toward negative infinity. A
//! sign is the value's own, so `-0.0` and a negative number that rounds to zero are written `-0`.
//! `NaN`, `Infinity` and `-Infinity` are written as `Float::to_string` writes them, in every
//! notation.
//!
//! Padding to a width and aligning in columns belong to text functions: `std.string`'s `pad_left`
//! and `pad_right`, and `std.text`'s `aligned` and `table`.

import std.bigint
import std.bytes (is_digit)
import std.decimal
import std.list
import std.option
import std.string
import std.gen

// --- A number, exactly ------------------------------------------------------

/// A finite number: whether it is below zero, and its decimal digits, most significant first
/// and with no leading zero, the last `scale` of them after the point. A scale below zero means
/// that many zeros after the last digit. Zero has no digits.
type Exact = { negative: Bool, digits: List<Char>, scale: Int }

/// The float's exact value, which is its 53-bit mantissa times a power of two. For a power of at
/// least zero it is a whole number. For `2^-k` it is the mantissa times `5^k`, with `k` decimal
/// places. `None` for a NaN or an infinity.
fn exact_of_float(x: Float) -> Option<Exact> = {
  let bits = bits_of_float(x);
  let biased = bits >>> 52 & 0x7FF;
  let fraction = bits & 0xF_FFFF_FFFF_FFFF;
  if biased == 0x7FF { None } else {
    let mantissa = limbs_of(if biased == 0 { fraction } else { fraction | 1 << 52 });
    let twos = if biased == 0 { 0 - 1074 } else { biased - 1075 };
    Some(if twos >= 0 {
      { negative: bits < 0, digits: digits_of(times_power_of_two(mantissa, twos)), scale: 0 }
    } else {
      {
        negative: bits < 0,
        digits: digits_of(times_power_of_five(mantissa, 0 - twos)),
        scale: 0 - twos,
      }
    })
  }
}

fn exact_of_decimal(d: Decimal) -> Exact = {
  let text = d.to_string().chars();
  let body = text.filter(|c: Char| c != '-');
  {
    negative: text.at(0) == Some('-'),
    digits: body.filter(|c: Char| c != '.').drop_while(|c: Char| c == '0'),
    scale: body.drop_while(|c: Char| c != '.').drop(1).len(),
  }
}

fn exact_of_int(n: Int, scale: Int) -> Exact =
  { negative: n < 0, digits: digits_of(limbs_of(n)), scale: scale }

/// A whole number as its decimal digits in groups of nine, least significant first, with no zero
/// group at the top. Multiplying this form by a small number takes one pass.
fn limbs_of(n: Int) -> List<Int> = {
  let below = if n > 0 { 0 - n } else { n };
  let all = [
    0 - below % 1000000000,
    0 - below / 1000000000 % 1000000000,
    0 - below / 1000000000000000000,
  ];
  all.take(if below / 1000000000000000000 != 0 { 3 }
  else if below / 1000000000 != 0 { 2 }
  else if below != 0 { 1 }
  else { 0 })
}

/// `limbs` times `factor`, which is at most `5^13`, so a limb times it plus the carry from the
/// limb below fits in an `Int`.
fn times(limbs: List<Int>, factor: Int) -> List<Int> = {
  let run = limbs.fold({ out: [], carry: 0 }, |s: { out: List<Int>, carry: Int }, limb: Int| {
    let product = limb * factor + s.carry;
    { out: s.out.push(product % 1000000000), carry: product / 1000000000 }
  });
  if run.carry == 0 { run.out }
  else if run.carry < 1000000000 { run.out.push(run.carry) }
  else { run.out.push(run.carry % 1000000000).push(run.carry / 1000000000) }
}

/// `limbs` times two to the `n`, thirty doublings at a time.
fn times_power_of_two(limbs: List<Int>, n: Int) -> List<Int> =
  times(range(0, n / 30).fold(limbs, |acc: List<Int>, _: Int| times(acc, 1073741824)), 1 << n % 30)

/// `limbs` times five to the `n`, thirteen at a time.
fn times_power_of_five(limbs: List<Int>, n: Int) -> List<Int> =
  times(
    range(0, n / 13).fold(limbs, |acc: List<Int>, _: Int| times(acc, 1220703125)),
    range(0, n % 13).fold(1, |power: Int, _: Int| power * 5),
  )

fn digits_of(limbs: List<Int>) -> List<Char> =
  limbs.reverse().fold([], |acc: List<Char>, limb: Int| {
    let written = limb.to_string().chars();
    if acc.len() == 0 { written } else { acc.concat(zeros(9 - written.len())).concat(written) }
  })

fn zeros(n: Int) -> List<Char> = range(0, n).map(|_: Int| '0')

fn is_digit_char(c: Char) -> Bool = is_digit(Int::of_char(c))

// --- Rounding ---------------------------------------------------------------

/// Whether a number rounds to the next step away from zero. `half` compares the dropped part with
/// half a step, `any` is whether anything is dropped at all, and `odd` is whether the step it would
/// otherwise stay on is odd.
fn rounds_away(rounding: Rounding, negative: Bool, odd: Bool, half: Ordering, any: Bool) -> Bool =
  match rounding {
    HalfEven -> half == Greater || (half == Equal && odd),
    HalfUp -> half != Less,
    Down -> false,
    Up -> any,
    Ceiling -> any && !negative,
    Floor -> any && negative,
  }

/// `e` times ten to the `places`, rounded to a whole number: its digits, none for zero.
fn round_digits(e: Exact, places: Int, rounding: Rounding) -> List<Char> = {
  let keep = e.digits.len() - e.scale + places;
  if e.digits.len() == 0 { [] }
  else if keep >= e.digits.len() { e.digits.concat(zeros(keep - e.digits.len())) } else {
    let kept = e.digits.take(keep);
    let next = if keep < 0 { '0' } else { e.digits.at_or(keep, '0') };
    let more = keep < 0 || !e.digits.drop(keep + 1).all(|c: Char| c == '0');
    let half = if next > '5' || (next == '5' && more) { Greater }
    else if next == '5' { Equal }
    else { Less };
    let odd = Int::of_char(kept.at_or(kept.len() - 1, '0')) % 2 == 1;
    if rounds_away(rounding, e.negative, odd, half, more || next != '0') { increment(kept) }
    else { kept }
  }
}

/// The whole number `digits` plus one.
fn increment(digits: List<Char>) -> List<Char> = {
  let run = digits.reverse().fold(
    { out: [], carry: true },
    |s: { out: List<Char>, carry: Bool }, c: Char|
      if !s.carry { { out: s.out.push(c), carry: false } }
      else if c == '9' { { out: s.out.push('0'), carry: true } } else {
        {
          out: s.out.push(match Char::of_int(Int::of_char(c) + 1) { Some(up) -> up, None -> c }),
          carry: false,
        }
      },
  );
  List::reverse(if run.carry { run.out.push('1') } else { run.out })
}

/// The whole number `digits` with a point `places` from its end, and at least one digit before
/// the point.
fn with_decimal_point(digits: List<Char>, places: Int) -> String =
  if places <= 0 {
    if digits.len() == 0 { "0" } else { String::of_chars(digits.concat(zeros(0 - places))) }
  } else {
    let all = zeros(places + 1 - digits.len()).concat(digits);
    String::of_chars(all.take(all.len() - places)) ++ "."
      ++ String::of_chars(all.drop(all.len() - places))
  }

fn sign_of(e: Exact) -> String = if e.negative { "-" } else { "" }

fn in_fixed(e: Exact, digits: Int, rounding: Rounding) -> String =
  sign_of(e) ++ with_decimal_point(round_digits(e, max(digits, 0), rounding), max(digits, 0))

/// A number's digits rounded to `count` significant ones, and the power of ten of its first digit.
fn significant_digits(
  e: Exact,
  count: Int,
  rounding: Rounding,
) -> { digits: List<Char>, power: Int } =
  if e.digits.len() == 0 { { digits: zeros(count), power: 0 } } else {
    let power = e.digits.len() - e.scale - 1;
    let all = round_digits(e, count - 1 - power, rounding);
    if all.len() > count { { digits: all.take(count), power: power + 1 } }
    else { { digits: all, power: power } }
  }

fn in_scientific(e: Exact, digits: Int, rounding: Rounding) -> String = {
  let places = max(digits, 0);
  let led = significant_digits(e, places + 1, rounding);
  sign_of(e) ++ with_decimal_point(led.digits, places) ++ "e" ++ led.power.to_string()
}

fn in_general(e: Exact, digits: Int, rounding: Rounding) -> String = {
  let count = max(digits, 1);
  let led = significant_digits(e, count, rounding);
  if led.power < 0 - 4 || led.power >= count {
    sign_of(e) ++ trim_trailing_zeros(with_decimal_point(led.digits, count - 1)) ++ "e"
      ++ led.power.to_string()
  } else {
    sign_of(e) ++ trim_trailing_zeros(with_decimal_point(led.digits, count - 1 - led.power))
  }
}

/// A decimal text without trailing zeros in its fraction, and without the point when nothing is
/// left after it.
fn trim_trailing_zeros(text: String) -> String = {
  let cs = text.chars();
  let whole = cs.take_while(|c: Char| c != '.');
  let fraction = cs.drop(whole.len() + 1).reverse().drop_while(|c: Char| c == '0').reverse();
  if fraction.len() == 0 { String::of_chars(whole) }
  else { String::of_chars(whole) ++ "." ++ String::of_chars(fraction) }
}

// --- Floats -----------------------------------------------------------------

/// `x` with exactly `digits` digits after the point, and no point when `digits` is zero: `1.5` to
/// two is `1.50`. A count below zero counts as zero.
pub fn fixed(x: Float, digits: Int, rounding: Rounding = HalfEven) -> String =
  match exact_of_float(x) { Some(e) -> in_fixed(e, digits, rounding), None -> x.to_string() }

/// `x` as one digit, `digits` more after the point, and the power of ten: `1234.5` to two is
/// `1.23e3`, and `0.00012` to one is `1.2e-4`. The text is a valid `Float` literal, so
/// `Float::of_string` reads it. Zero is written with `e0`.
pub fn scientific(x: Float, digits: Int, rounding: Rounding = HalfEven) -> String =
  match exact_of_float(x) { Some(e) -> in_scientific(e, digits, rounding), None -> x.to_string() }

/// `x` to `digits` significant digits, at least one and six by default, without trailing zeros in
/// its fraction. It is written plainly when its first digit's power of ten is from `-4` to
/// `digits - 1`, and in `scientific`'s notation otherwise, as C's `%g` chooses.
pub fn general(x: Float, digits: Int = 6, rounding: Rounding = HalfEven) -> String =
  match exact_of_float(x) { Some(e) -> in_general(e, digits, rounding), None -> x.to_string() }

/// `x` as a percentage, to `digits` places, followed by `%`: `0.125` to one place is `12.5%`, and
/// to none, the default, `12%`. The multiplication by a hundred is exact, not a float product.
pub fn percent(x: Float, digits: Int = 0, rounding: Rounding = HalfEven) -> String =
  match exact_of_float(x) {
    Some(e) -> in_fixed({ ..e, scale: e.scale - 2 }, digits, rounding) ++ "%",
    None -> x.to_string() ++ "%",
  }

// --- Decimals and integers --------------------------------------------------

/// `d` with exactly `digits` digits after the point, rounded or padded with zeros. Use
/// `Decimal::to_string` to keep `d`'s own scale.
pub fn fixed_decimal(d: Decimal, digits: Int, rounding: Rounding = HalfEven) -> String =
  in_fixed(exact_of_decimal(d), digits, rounding)

/// `d` in `scientific`'s notation.
pub fn scientific_decimal(d: Decimal, digits: Int, rounding: Rounding = HalfEven) -> String =
  in_scientific(exact_of_decimal(d), digits, rounding)

/// `n` in `scientific`'s notation: `123456` to two is `1.23e5`.
pub fn scientific_int(n: Int, digits: Int, rounding: Rounding = HalfEven) -> String =
  in_scientific(exact_of_int(n, 0), digits, rounding)

/// `n` counted in units of ten to the minus `places`, written in whole units: `1234` at two
/// places is `12.34`, and `-5` at three is `-0.005`. Nothing is rounded.
pub fn fixed_point(n: Int, places: Int) -> String = {
  let e = exact_of_int(n, places);
  sign_of(e) ++ with_decimal_point(round_digits(e, places, Down), places)
}

// --- A number's text --------------------------------------------------------

type Parts = { sign: List<Char>, whole: List<Char>, rest: List<Char> }

/// A number's text as its sign, the decimal digits that follow it, and whatever follows those.
fn parts_of(number: String) -> Parts = {
  let cs = number.chars();
  let signed = cs.at(0) == Some('-') || cs.at(0) == Some('+');
  let body = if signed { cs.drop(1) } else { cs };
  let whole = body.take_while(is_digit_char);
  { sign: if signed { cs.take(1) } else { [] }, whole: whole, rest: body.drop(whole.len()) }
}

/// `number` with `separator` between each group of `size` digits of its whole part, counted from
/// the point: with the defaults, a comma and three, `1234567.891` is `1,234,567.891`. The whole
/// part is the decimal digits after the sign, so a fraction, an exponent and a unit are left
/// unchanged, as is a text that does not start with digits. A size below one groups nothing.
pub fn grouped(number: String, separator: String = ",", size: Int = 3) -> String = {
  let parts = parts_of(number);
  if size < 1 || parts.whole.len() <= size { number } else {
    let groups = parts.whole.reverse().chunks(size).reverse().map(|group: List<Char>|
      String::of_chars(group.reverse()));
    String::of_chars(parts.sign) ++ String::join(groups, separator) ++ String::of_chars(parts.rest)
  }
}

/// `number` with `plus` before it unless it starts with `-`, so every number has a sign. `plus` is
/// `+` by default, and a single space keeps a column of positive and negative numbers aligned.
pub fn signed(number: String, plus: String = "+") -> String =
  if number.starts_with("-") { number } else { plus ++ number }

/// `number` padded to `width` characters with zeros between its sign and its digits: `-42` in six
/// is `-00042`. A text in another base works the same way (`-ff` is `-000ff`). A text that is not
/// a number (`NaN`, `Infinity`) is padded with spaces before it instead, and a text already that
/// wide is unchanged. Pad before grouping.
pub fn zero_padded(number: String, width: Int) -> String = {
  let cs = number.chars();
  let signed = cs.at(0) == Some('-') || cs.at(0) == Some('+');
  let body = String::of_chars(if signed { cs.drop(1) } else { cs });
  let missing = width - cs.len();
  if missing <= 0 { number }
  else if body == "NaN" || body == "Infinity" { " ".repeat(missing) ++ number } else {
    String::of_chars(List::concat(if signed { cs.take(1) } else { [] }, zeros(missing))) ++ body
  }
}

// --- Sizes ------------------------------------------------------------------

/// The multiples a count of bytes is written in.
pub type Units =
  /// Powers of 1024, named as IEC 80000-13 names them: `KiB`, `MiB`, `GiB`, `TiB`, `PiB`, `EiB`.
  | Iec
  /// Powers of 1000, with the SI prefixes: `kB`, `MB`, `GB`, `TB`, `PB`, `EB`.
  | Si

fn names(units: Units) -> List<String> =
  match units {
    Iec -> ["B", "KiB", "MiB", "GiB", "TiB", "PiB", "EiB"],
    Si -> ["B", "kB", "MB", "GB", "TB", "PB", "EB"],
  }

fn steps(units: Units) -> List<Int> =
  match units {
    Iec -> [1, 1024, 1048576, 1073741824, 1099511627776, 1125899906842624, 1152921504606846976],
    Si -> [1, 1000, 1000000, 1000000000, 1000000000000, 1000000000000000, 1000000000000000000],
  }

/// `bytes` in the unit at `power`, exactly. Dividing by a power of 1000 moves the point. Dividing
/// by `1024^power`, which is `2^(10 * power)`, multiplies by `5^(10 * power)` and moves the point
/// that many places.
fn in_unit(bytes: Int, units: Units, power: Int) -> Exact =
  match units {
    Si -> exact_of_int(bytes, 3 * power),
    Iec ->
      {
        negative: bytes < 0,
        digits: digits_of(times_power_of_five(limbs_of(bytes), 10 * power)),
        scale: 10 * power,
      },
  }

/// A count of bytes in the largest unit it fills, to `digits` places: `1572864` is `1.5 MiB`, or
/// `1.6 MB` in `Si` units. The defaults are `Iec` units and one place. Below the first multiple it
/// is the exact count, such as `512 B`. A count that rounds up to the next unit is written in that
/// unit, so `1048575` is `1.0 MiB`, never `1024.0 KiB`.
pub fn size(
  bytes: Int,
  units: Units = Iec,
  digits: Int = 1,
  rounding: Rounding = HalfEven,
) -> String = {
  let places = max(digits, 0);
  let power = range(1, 7).fold(0, |most: Int, i: Int|
    if bytes >= steps(units).at_or(i, 0) || bytes <= 0 - steps(units).at_or(i, 0) { i }
    else { most });
  if power == 0 { bytes.to_string() ++ " B" } else {
    let shown = round_digits(in_unit(bytes, units, power), places, rounding);
    let over = power < 6 && whole_of(shown.take(shown.len() - places)) >= steps(units).at_or(1, 0);
    let at = if over { power + 1 } else { power };
    (if bytes < 0 { "-" } else { "" })
      ++ with_decimal_point(
        if over { round_digits(in_unit(bytes, units, at), places, rounding) } else { shown },
        places,
      )
      ++ " "
      ++ names(units).at_or(at, "")
  }
}

/// The small whole number that these digits represent.
fn whole_of(digits: List<Char>) -> Int =
  digits.take(9).fold(0, |n: Int, c: Char| n * 10 + Int::of_char(c) - 48)

/// Parses a size into a count of bytes. A size is digits, an optional fraction after a point, and
/// then, after any spaces, a unit of either system, where `B` or no unit means bytes. A leading
/// `-` is allowed, and `kB` may be written `KB`. A count that is not a whole number of bytes is
/// rounded to the nearest, with a half going to even. `None` for any other text, and for a count
/// that does not fit in an `Int`.
pub fn parse_size(text: String) -> Option<Int> = {
  let cs = text.chars();
  let negative = cs.at(0) == Some('-');
  let body = if negative { cs.drop(1) } else { cs };
  let whole = body.take_while(is_digit_char);
  let after = body.drop(whole.len());
  let has_point = after.at(0) == Some('.');
  let fraction = if has_point { after.drop(1).take_while(is_digit_char) } else { [] };
  let unit = String::of_chars(
    after.drop(if has_point { 1 + fraction.len() } else { 0 }).drop_while(|c: Char| c == ' '),
  );
  if whole.len() == 0 || (has_point && fraction.len() == 0) { None } else {
    match multiple_named(unit) {
      None -> None,
      Some(m) -> {
        let digits = whole.concat(fraction).drop_while(|c: Char| c == '0');
        let e = match m.units {
          Si -> { negative: negative, digits: digits, scale: fraction.len() - 3 * m.power },
          Iec ->
            {
              negative: negative,
              digits: digits_of(times_power_of_two(limbs_of_digits(digits), 10 * m.power)),
              scale: fraction.len(),
            },
        };
        int_of_digits(negative, round_digits(e, 0, HalfEven))
      },
    }
  }
}

fn multiple_named(unit: String) -> Option<{ units: Units, power: Int }> =
  if unit == "" || unit == "KB" { Some({ units: Si, power: if unit == "" { 0 } else { 1 } }) }
  else {
    range(0, 7).fold(None, |found: Option<{ units: Units, power: Int }>, i: Int|
      if names(Si).at_or(i, "") == unit { Some({ units: Si, power: i }) }
      else if names(Iec).at_or(i, "") == unit { Some({ units: Iec, power: i }) }
      else { found })
  }

fn limbs_of_digits(digits: List<Char>) -> List<Int> =
  digits.reverse().chunks(9).map(|group: List<Char>| whole_of(group.reverse()))

/// The `Int` that these digits represent with the given sign, or `None` if it does not fit.
fn int_of_digits(negative: Bool, digits: List<Char>) -> Option<Int> =
  digits.fold(Some(0), |acc: Option<Int>, c: Char|
    match acc {
      None -> None,
      Some(n) -> match checked_mul(n, 10) {
        None -> None,
        Some(tens) -> if negative { checked_sub(tens, Int::of_char(c) - 48) }
        else { checked_add(tens, Int::of_char(c) - 48) },
      },
    })

// --- Durations --------------------------------------------------------------

/// `whole` steps plus `left` out of a step of size `step`, rounded to a count of steps.
fn round_steps(whole: Int, left: Int, step: Int, rounding: Rounding, negative: Bool) -> Int =
  if rounds_away(rounding, negative, whole % 2 == 1, compare(left * 2, step), left > 0) {
    whole + 1
  } else { whole }

/// A count of tenths as a number: `15` is `1.5`, and `20` is `2`.
fn tenths(n: Int) -> String =
  if n % 10 == 0 { Int::to_string(n / 10) }
  else { Int::to_string(n / 10) ++ "." ++ Int::to_string(n % 10) }

/// Two units, leaving out the smaller one when it is zero.
fn paired(big: Int, big_unit: String, small: Int, small_unit: String) -> String =
  if small == 0 { big.to_string() ++ " " ++ big_unit }
  else { big.to_string() ++ " " ++ big_unit ++ " " ++ small.to_string() ++ " " ++ small_unit }

/// The span roughly, as a person would say it. Under a minute, it is in the largest unit it fills,
/// to a tenth when it is not whole: `1.5 s`, `250 ms`, `40 ns`, and microseconds with the micro
/// sign. From a minute up, it is in the largest unit and the next one down, rounded to the smaller:
/// `3 min`, `2 h 5 min`, `3 d 4 h`. A span that rounds up to the next unit is written in that unit,
/// a negative span starts with `-`, and zero is `0 s`. The text is for reading and does not give
/// the span exactly.
pub fn duration(d: Duration, rounding: Rounding = HalfEven) -> String = {
  let nanos = match d { Duration(n) -> n };
  let negative = nanos < 0;
  let below = if negative { nanos } else { 0 - nanos };
  let said = if below > 0 - 1000 { Int::to_string(0 - below) ++ " ns" }
  else if below > 0 - 1000000 {
    let n = round_steps(0 - below / 100, 0 - below % 100, 100, rounding, negative);
    if n >= 10000 { "1 ms" } else { tenths(n) ++ " \u{b5}s" }
  } else if below > 0 - 1000000000 {
    let n = round_steps(0 - below / 100000, 0 - below % 100000, 100000, rounding, negative);
    if n >= 10000 { "1 s" } else { tenths(n) ++ " ms" }
  } else if below > 0 - 60000000000 {
    let n = round_steps(
      0 - below / 100000000,
      0 - below % 100000000,
      100000000,
      rounding,
      negative,
    );
    if n >= 600 { "1 min" } else { tenths(n) ++ " s" }
  } else if below > 0 - 3600000000000 {
    let n = round_steps(
      0 - below / 1000000000,
      0 - below % 1000000000,
      1000000000,
      rounding,
      negative,
    );
    if n >= 3600 { "1 h" } else { paired(n / 60, "min", n % 60, "s") }
  } else if below > 0 - 86400000000000 {
    let n = round_steps(
      0 - below / 60000000000,
      0 - below % 60000000000,
      60000000000,
      rounding,
      negative,
    );
    if n >= 1440 { "1 d" } else { paired(n / 60, "h", n % 60, "min") }
  } else {
    let n = round_steps(
      0 - below / 3600000000000,
      0 - below % 3600000000000,
      3600000000000,
      rounding,
      negative,
    );
    paired(n / 24, "d", n % 24, "h")
  };
  if nanos == 0 { "0 s" } else if negative { "-" ++ said } else { said }
}

// --- Tests ------------------------------------------------------------------

type Tie = { rounding: Rounding, above: String, below: String }

/// An eighth is a tie at two places, and a float represents it exactly.
fn eighths() -> List<Tie> =
  [
    { rounding: HalfEven, above: "0.12", below: "-0.12" },
    { rounding: HalfUp, above: "0.13", below: "-0.13" },
    { rounding: Down, above: "0.12", below: "-0.12" },
    { rounding: Up, above: "0.13", below: "-0.13" },
    { rounding: Ceiling, above: "0.13", below: "-0.12" },
    { rounding: Floor, above: "0.12", below: "-0.13" },
  ]

test "0.125 to two places {c.rounding} is {c.above}, and its negation {c.below}" for c: Tie in eighths(
  ) {
  assert_eq(fixed(0.125, 2, c.rounding), c.above);
  assert_eq(fixed(0.0 - 0.125, 2, c.rounding), c.below);
  assert_eq(fixed_decimal(0.125m, 2, c.rounding), c.above);
  assert_eq(fixed_decimal(0m - 0.125m, 2, c.rounding), c.below)
}

test "a tie goes to the even digit or away from zero, and a float just short of one does not tie" {
  assert_eq(fixed(0.375, 2), "0.38");
  assert_eq(fixed(2.5, 0), "2");
  assert_eq(fixed(3.5, 0), "4");
  assert_eq(fixed(2.5, 0, HalfUp), "3");
  assert_eq(fixed(0.5, 0), "0");
  assert_eq(fixed(0.0 - 0.5, 0), "-0");
  assert_eq(fixed(2.675, 2), "2.67");
  assert_eq(fixed(2.675, 2, HalfUp), "2.67");
  assert_eq(fixed(1.005, 2, HalfUp), "1.00");
  assert_eq(fixed_decimal(1.005m, 2), "1.00");
  assert_eq(fixed_decimal(1.005m, 2, HalfUp), "1.01");
  assert_eq(fixed_decimal(1.015m, 2), "1.02")
}

test "fixed writes exactly the places requested, from the float's exact digits" {
  assert_eq(fixed(1.5, 2), "1.50");
  assert_eq(fixed(1234.5678, 0), "1235");
  assert_eq(fixed(1.0, 0 - 3), "1");
  assert_eq(fixed(0.004, 1), "0.0");
  assert_eq(fixed(0.004, 1, Up), "0.1");
  assert_eq(fixed(0.1, 20), "0.10000000000000000555");
  assert_eq(fixed(0.1, 55), "0.1000000000000000055511151231257827021181583404541015625");
  assert_eq(fixed(0.1, 57), "0.100000000000000005551115123125782702118158340454101562500");
  assert_eq(fixed(1.0e21, 0), "1000000000000000000000");
  assert_eq(fixed(4.0e-324, 3), "0.000");
  assert_eq(fixed(9007199254740993.0, 1), "9007199254740992.0")
}

test "negative zero keeps its sign, and a non-number is written as `Float::to_string` writes it" {
  let minus_zero = Float::of_bits(0x8000_0000_0000_0000);
  let nan = Float::of_bits(0x7FF8_0000_0000_0000);
  let infinity = Float::of_bits(0x7FF0_0000_0000_0000);
  assert_eq(fixed(minus_zero, 2), "-0.00");
  assert_eq(fixed(0.0, 2), "0.00");
  assert_eq(fixed(0.0 - 0.001, 2), "-0.00");
  assert_eq(scientific(minus_zero, 1), "-0.0e0");
  assert_eq(general(minus_zero), "-0");
  assert_eq(percent(minus_zero), "-0%");
  assert_eq(fixed(nan, 2), "NaN");
  assert_eq(scientific(nan, 2), "NaN");
  assert_eq(general(nan), "NaN");
  assert_eq(percent(nan, 1), "NaN%");
  assert_eq(fixed(infinity, 2), "Infinity");
  assert_eq(fixed(0.0 - infinity, 2), "-Infinity");
  assert_eq(scientific(0.0 - infinity, 2), "-Infinity");
  assert_eq(general(infinity), "Infinity");
  assert_eq(fixed_decimal(0m - 0.001m, 2), "-0.00")
}

test "scientific notation is one digit, the places requested, and a power of ten" {
  assert_eq(scientific(1234.5, 2), "1.23e3");
  assert_eq(scientific(0.00012, 1), "1.2e-4");
  assert_eq(scientific(9.999, 2), "1.00e1");
  assert_eq(scientific(0.0, 2), "0.00e0");
  assert_eq(scientific(1.0, 0), "1e0");
  assert_eq(scientific(123456.0, 0), "1e5");
  assert_eq(scientific(0.25, 0), "2e-1");
  assert_eq(scientific(0.25, 0, HalfUp), "3e-1");
  assert_eq(scientific(4.0e-324, 3), "4.941e-324");
  assert_eq(scientific(1.7976931348623157e308, 3), "1.798e308");
  assert_eq(scientific(0.0 - 1234.5, 1), "-1.2e3");
  assert_eq(scientific_decimal(1234.5m, 2), "1.23e3");
  assert_eq(scientific_decimal(0.00012m, 1), "1.2e-4");
  assert_eq(scientific_decimal(0.00m, 1), "0.0e0");
  assert_eq(scientific_int(123456, 2), "1.23e5");
  assert_eq(scientific_int(999, 1), "1.0e3");
  assert_eq(scientific_int(0, 0), "0e0");
  assert_eq(scientific_int(0 - 9223372036854775807 - 1, 3), "-9.223e18")
}

test "general keeps the significant digits and chooses the notation by the first one's position" {
  assert_eq(general(0.0001), "0.0001");
  assert_eq(general(0.00001), "1e-5");
  assert_eq(general(123456.0), "123456");
  assert_eq(general(1234567.0), "1.23457e6");
  assert_eq(general(999999.5), "1e6");
  assert_eq(general(100.0), "100");
  assert_eq(general(1.5), "1.5");
  assert_eq(general(0.1 + 0.2), "0.3");
  assert_eq(general(0.1 + 0.2, 17), "0.30000000000000004");
  assert_eq(general(1234.5678, 2), "1.2e3");
  assert_eq(general(1234.5678, 0), "1e3");
  assert_eq(general(0.0), "0");
  assert_eq(general(0.0 - 2.5, 1), "-2");
  assert_eq(general(1.0e21), "1e21")
}

test "a percentage is exactly a hundred times the value, rounded once" {
  assert_eq(percent(0.125, 1), "12.5%");
  assert_eq(percent(0.125), "12%");
  assert_eq(percent(0.125, 0, HalfUp), "13%");
  assert_eq(percent(0.07), "7%");
  assert_eq(percent(0.07, 2), "7.00%");
  assert_eq(percent(1.0), "100%");
  assert_eq(percent(0.0 - 0.5, 1), "-50.0%");
  assert_eq(percent(12.0), "1200%")
}

test "a decimal is written to the places requested, padded or rounded" {
  assert_eq(fixed_decimal(1.5m, 3), "1.500");
  assert_eq(fixed_decimal(123m, 0), "123");
  assert_eq(fixed_decimal(123m, 2), "123.00");
  assert_eq(fixed_decimal(0m, 2), "0.00");
  assert_eq(fixed_decimal(0.999m, 2), "1.00");
  assert_eq(fixed_decimal(0m - 12.345m, 1), "-12.3");
  assert_eq(fixed_decimal(1.50m, 30), "1.500000000000000000000000000000")
}

test "an integer counting small units is written in whole ones" {
  assert_eq(fixed_point(1234, 2), "12.34");
  assert_eq(fixed_point(0 - 5, 3), "-0.005");
  assert_eq(fixed_point(7, 0), "7");
  assert_eq(fixed_point(0, 2), "0.00");
  assert_eq(fixed_point(12, 0 - 2), "1200");
  assert_eq(fixed_point(0, 0 - 2), "0");
  assert_eq(fixed_point(0 - 9223372036854775807 - 1, 2), "-92233720368547758.08")
}

test "digits are grouped from the point, and nothing else is touched" {
  assert_eq(grouped("1234567"), "1,234,567");
  assert_eq(grouped("-1234"), "-1,234");
  assert_eq(grouped("+1234"), "+1,234");
  assert_eq(grouped("123"), "123");
  assert_eq(grouped(""), "");
  assert_eq(grouped("1234567.891"), "1,234,567.891");
  assert_eq(grouped(fixed(1234567.891, 2)), "1,234,567.89");
  assert_eq(grouped("12345%"), "12,345%");
  assert_eq(grouped("1e21"), "1e21");
  assert_eq(grouped("NaN"), "NaN");
  assert_eq(grouped("1234567", separator: "_"), "1_234_567");
  assert_eq(grouped("1234567", separator: "."), "1.234.567");
  assert_eq(grouped("1234567", separator: " ", size: 4), "123 4567");
  assert_eq(grouped("1234567", size: 0), "1234567")
}

test "a sign is shown on request, and zero padding goes between it and the digits" {
  assert_eq(signed("5"), "+5");
  assert_eq(signed("-5"), "-5");
  assert_eq(signed("0.0"), "+0.0");
  assert_eq(signed("5", plus: " "), " 5");
  assert_eq(zero_padded("42", 5), "00042");
  assert_eq(zero_padded("-42", 6), "-00042");
  assert_eq(zero_padded("+42", 6), "+00042");
  assert_eq(zero_padded("ff", 4), "00ff");
  assert_eq(zero_padded("-ff", 6), "-000ff");
  assert_eq(zero_padded("1.50", 6), "001.50");
  assert_eq(zero_padded("12345", 3), "12345");
  assert_eq(zero_padded("NaN", 6), "   NaN");
  assert_eq(zero_padded("-Infinity", 12), "   -Infinity");
  assert_eq(grouped(zero_padded("1234", 8)), "00,001,234")
}

test "a size is written in the largest unit it fills, in the system requested" {
  assert_eq(size(0), "0 B");
  assert_eq(size(512), "512 B");
  assert_eq(size(1023), "1023 B");
  assert_eq(size(1024), "1.0 KiB");
  assert_eq(size(1536), "1.5 KiB");
  assert_eq(size(1572864), "1.5 MiB");
  assert_eq(size(1572864, Si), "1.6 MB");
  assert_eq(size(999, Si), "999 B");
  assert_eq(size(1000, Si), "1.0 kB");
  assert_eq(size(0 - 1536), "-1.5 KiB");
  assert_eq(size(12750000, digits: 2), "12.16 MiB");
  assert_eq(size(3145728, digits: 0), "3 MiB");
  assert_eq(size(9223372036854775807), "8.0 EiB");
  assert_eq(size(9223372036854775807, Si), "9.2 EB");
  assert_eq(size(0 - 9223372036854775807 - 1), "-8.0 EiB")
}

test "a size that rounds up to the next unit is written in it, and a half rounds as requested" {
  assert_eq(size(1048575), "1.0 MiB");
  assert_eq(size(1048575, rounding: Down), "1023.9 KiB");
  assert_eq(size(999999, Si), "1.0 MB");
  assert_eq(size(999949, Si), "999.9 kB");
  assert_eq(size(2560, digits: 0), "2 KiB");
  assert_eq(size(2560, digits: 0, rounding: HalfUp), "3 KiB");
  assert_eq(size(1088, digits: 1), "1.1 KiB");
  assert_eq(size(1126, digits: 1), "1.1 KiB");
  assert_eq(size(1127, digits: 1, rounding: Up), "1.2 KiB")
}

type SizeCase = { text: String, bytes: Option<Int> }

fn sizes() -> List<SizeCase> =
  [
    { text: "512", bytes: Some(512) },
    { text: "512 B", bytes: Some(512) },
    { text: "1.5 MiB", bytes: Some(1572864) },
    { text: "1.6 MB", bytes: Some(1600000) },
    { text: "1.5KiB", bytes: Some(1536) },
    { text: "1 kB", bytes: Some(1000) },
    { text: "1 KB", bytes: Some(1000) },
    { text: "-1.5 KiB", bytes: Some(0 - 1536) },
    { text: "0.3 kB", bytes: Some(300) },
    { text: "1.1 KiB", bytes: Some(1126) },
    { text: "0.5 B", bytes: Some(0) },
    { text: "1.5 B", bytes: Some(2) },
    { text: "2.5 B", bytes: Some(2) },
    { text: "0.00000000000000000000000000001 EB", bytes: Some(0) },
    { text: "007 B", bytes: Some(7) },
    { text: "7.9 EiB", bytes: Some(9108079886394091110) },
    { text: "8 EiB", bytes: None },
    { text: "-8 EiB", bytes: Some(0 - 9223372036854775807 - 1) },
    { text: "99999999999999999999 B", bytes: None },
    { text: "", bytes: None },
    { text: "MiB", bytes: None },
    { text: "1.", bytes: None },
    { text: ".5 MiB", bytes: None },
    { text: "1 mib", bytes: None },
    { text: "1 MiB ", bytes: None },
    { text: " 1 MiB", bytes: None },
    { text: "1e3", bytes: None },
    { text: "1,024", bytes: None },
    { text: "+5", bytes: None },
  ]

test "the size {c.text} parses to its bytes" for c: SizeCase in sizes() {
  assert_eq(parse_size(c.text), c.bytes)
}

type DurationCase = { nanos: Int, text: String }

fn spans() -> List<DurationCase> =
  [
    { nanos: 0, text: "0 s" },
    { nanos: 40, text: "40 ns" },
    { nanos: 999, text: "999 ns" },
    { nanos: 1000, text: "1 \u{b5}s" },
    { nanos: 1500, text: "1.5 \u{b5}s" },
    { nanos: 12340, text: "12.3 \u{b5}s" },
    { nanos: 999949, text: "999.9 \u{b5}s" },
    { nanos: 999950, text: "1 ms" },
    { nanos: 250000000, text: "250 ms" },
    { nanos: 1500000000, text: "1.5 s" },
    { nanos: 2000000000, text: "2 s" },
    { nanos: 1250000000, text: "1.2 s" },
    { nanos: 1350000000, text: "1.4 s" },
    { nanos: 59940000000, text: "59.9 s" },
    { nanos: 59960000000, text: "1 min" },
    { nanos: 60000000000, text: "1 min" },
    { nanos: 180000000000, text: "3 min" },
    { nanos: 185400000000, text: "3 min 5 s" },
    { nanos: 3599600000000, text: "1 h" },
    { nanos: 7200000000000, text: "2 h" },
    { nanos: 7500000000000, text: "2 h 5 min" },
    { nanos: 86399000000000, text: "1 d" },
    { nanos: 86400000000000, text: "1 d" },
    { nanos: 273600000000000, text: "3 d 4 h" },
    { nanos: 0 - 1500000000, text: "-1.5 s" },
    { nanos: 0 - 7500000000000, text: "-2 h 5 min" },
    { nanos: 0 - 9223372036854775807 - 1, text: "-106752 d" },
  ]

test "{c.nanos} nanoseconds are written as {c.text}" for c: DurationCase in spans() {
  assert_eq(duration(Duration(c.nanos)), c.text)
}

test "a span at a tie follows the given rounding" {
  assert_eq(duration(Duration(1250000000), HalfUp), "1.3 s");
  assert_eq(duration(Duration(1210000000), Up), "1.3 s");
  assert_eq(duration(Duration(1290000000), Down), "1.2 s");
  assert_eq(duration(Duration(0 - 1210000000), Floor), "-1.3 s");
  assert_eq(duration(Duration(0 - 1290000000), Ceiling), "-1.2 s");
  assert_eq(duration(Duration(90000000000), HalfUp), "1 min 30 s");
  assert_eq(duration(Duration(5430000000000)), "1 h 30 min");
  assert_eq(duration(Duration(5370000000000)), "1 h 30 min")
}

fn limbs_text(limbs: List<Int>) -> String =
  if limbs.len() == 0 { "0" } else { String::of_chars(digits_of(limbs)) }

test "a float's digits are its mantissa times a power of two or of five, as std.bigint multiplies" {
  gen::check2(gen::any_int(), gen::any_int(), |m: Int, k: Int| {
    let mantissa = m & 0x1F_FFFF_FFFF_FFFF;
    let power = k & 1023;
    limbs_text(times_power_of_two(limbs_of(mantissa), power))
      == bigint::to_string(
        bigint::mul(bigint::of_int(mantissa), bigint::pow(bigint::of_int(2), power)),
      )
      && limbs_text(times_power_of_five(limbs_of(mantissa), power))
      == bigint::to_string(
        bigint::mul(bigint::of_int(mantissa), bigint::pow(bigint::of_int(5), power)),
      )
  })
}

test "seventeen significant digits read back as the float" {
  gen::check(gen::float(), |x: Float|
    if x - x == 0.0 { Float::of_string(scientific(x, 16)) == Some(x) } else { true })
}

test "grouping adds separators and nothing else, three digits to a group" {
  gen::check(gen::any_int(), |n: Int| {
    let text = grouped(n.to_string());
    String::join(text.split(","), "") == n.to_string()
      && text.split(",").drop(1).all(|group: String| group.len() == 3)
      && grouped(text) == text
  })
}
