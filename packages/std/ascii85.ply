//! Ascii85 encoding in Adobe's variant, which PostScript and PDF use to embed binary data. Every
//! four bytes become five characters from `!` to `u`.
//!
//! Each group of four bytes is read as one big-endian number and written in base 85, with `!` for
//! zero. Four zero bytes are written as the single character `z`. A final group of one to three
//! bytes is padded with zero bytes, encoded, and truncated to one more character than it had
//! bytes. `encode` returns just the characters, and `encode_framed` wraps them in PostScript's
//! `<~` and `~>`. The older btoa variant is not supported: no `y` for four spaces, and no `xbtoa`
//! lines.
//!
//! `decode` accepts exactly what `encode` writes, so decoding an encoding returns the bytes and
//! encoding a decoding returns the text. `decode` rejects five `!` where a `z` belongs, a `z`
//! inside a group, a group too large for four bytes, a final group of one character, a final group
//! whose truncated digits differ from what `encode` writes, and whitespace. To read text that a
//! PostScript writer split into lines, remove the line breaks with `strip_whitespace` first.

import std.bytes (u32_be)
import std.laws (round_trip)
import std.list (somes)
import std.gen

/// Returns `data` encoded in Adobe's ascii85, without the `<~` and `~>` frame.
pub fn encode(data: Bytes) -> String / {abort.raise}
  cost data.len()
= {
  let n = data.len();
  String::of_bytes(
    Bytes::concat_all(
      range(0, (n + 3) / 4).map(|g: Int| encode_group(data, g * 4, min(4, n - g * 4))),
    ),
  )
}

/// Decodes text that `encode` wrote. Returns `None` for any other text.
pub fn decode(text: String) -> Option<Bytes> / {abort.raise} = {
  let runs = Bytes::of_string(text).split(b"z");
  let read = somes(
    range(0, runs.len()).map(|i: Int| decode_run(runs.at_or(i, b""), i + 1 == runs.len())),
  );
  if read.len() == runs.len() { Some(Bytes::join(read, b"\x00\x00\x00\x00")) } else { None }
}

/// `data` as PostScript writes it: `encode`'s characters between `<~` and `~>`.
pub fn encode_framed(data: Bytes) -> String / {abort.raise} = "<~" ++ encode(data) ++ "~>"

/// Decodes text that `encode_framed` wrote. Returns `None` for any other text, including unframed
/// text.
pub fn decode_framed(text: String) -> Option<Bytes> / {abort.raise} = {
  let n = text.len();
  if n < 4 || !text.starts_with("<~") || !text.ends_with("~>") { None }
  else { decode(text.slice(2, n - 2)) }
}

/// Removes the whitespace that Adobe's readers skip: space, tab, line feed, form feed, carriage
/// return and NUL. Text that a writer split into lines can then be decoded.
pub fn strip_whitespace(text: String) -> String / {abort.raise} =
  String::of_bytes(
    [b" ", b"\t", b"\n", b"\x0c", b"\r", b"\x00"].fold(
      Bytes::of_string(text),
      |t: Bytes, w: Bytes| t.replace(w, b""),
    ),
  )

fn encode_group(data: Bytes, at: Int, count: Int) -> Bytes / {abort.raise} = {
  let v = range(0, 4).fold(0, |m: Int, k: Int|
    m << 8 | (if k < count { data.at(at + k) } else { 0 }));
  if v == 0 && count == 4 { b"z" } else { digits(v).slice(0, count + 1) }
}

fn digits(v: Int) -> Bytes / {abort.raise} =
  Bytes::concat_all([52200625, 614125, 7225, 85, 1].map(|p: Int| byte_of_int(v / p % 85 + 33)))

fn decode_run(run: Bytes, last: Bool) -> Option<Bytes> / {abort.raise} = {
  let n = run.len();
  let whole = n / 5;
  let rest = n % 5;
  let values = range(0, whole).map(|g: Int| group_value(run, g * 5, 5));
  if run.position(0, |c: Int| c < 33 || c > 117) != None { None }
  else if rest == 1 || (rest > 0 && !last) { None }
  else if values.fold(false, |bad: Bool, v: Int| bad || v == 0 || v > 0xFFFF_FFFF) { None } else {
    let full = Bytes::concat_all(values.map(u32_be));
    if rest == 0 { Some(full) } else {
      let v = group_value(run, whole * 5, rest);
      let tail = u32_be(v & 0xFFFF_FFFF).slice(0, rest - 1);
      if v > 0xFFFF_FFFF || encode_group(tail, 0, rest - 1) != run.slice(whole * 5, n) { None }
      else { Some(full.concat(tail)) }
    }
  }
}

fn group_value(run: Bytes, at: Int, count: Int) -> Int / {abort.raise} =
  range(0, 5).fold(0, |m: Int, k: Int| m * 85 + (if k < count { run.at(at + k) - 33 } else { 84 }))

test "a decode of an encode is the bytes encoded" {
  gen::check(gen::bytes(), |x: Bytes| round_trip(encode, decode, x))
}

type Vector = { bytes: Bytes, text: String }

const vectors: List<Vector> =
  [
    { bytes: b"\x03\x1c\x84\xb1", text: "\"!!!!" },
    { bytes: b"\x00\x09\x5e\xed", text: "!\"!!!" },
    { bytes: b"\x00\x00\x1c\x39", text: "!!\"!!" },
    { bytes: b"\x00\x00\x00\x55", text: "!!!\"!" },
    { bytes: b"\x00\x00\x00\x01", text: "!!!!\"" },
    { bytes: b"", text: "" },
    { bytes: b"M", text: "9`" },
    { bytes: b"Ma", text: "9jn" },
    { bytes: b"Man", text: "9jqo" },
    { bytes: b"Man ", text: "9jqo^" },
    { bytes: b"Man is", text: "9jqo^Bla" },
    { bytes: b"hello world", text: "BOu!rD]j7BEbo7" },
    { bytes: b"\x00\x00\x00\x00", text: "z" },
    { bytes: b"\x00\x00\x00\x00\x00\x00\x00\x00", text: "zz" },
    { bytes: b"\x00", text: "!!" },
    { bytes: b"\x00\x00\x00", text: "!!!!" },
    { bytes: b"a\x00\x00\x00\x00b", text: "@/p9-!+G" },
    { bytes: b"\x00\x00\x00\x00\x00", text: "z!!" },
    { bytes: b"\x00\x00\x00\x00a", text: "z@/" },
    { bytes: b"ab\x00\x00\x00\x00", text: "@:B3:!!!" },
    { bytes: b"\xff\xff\xff\xff", text: "s8W-!" },
  ]

test "{v.bytes} is written {v.text}, and read back" for v: Vector in vectors {
  assert_eq(encode(v.bytes), v.text);
  assert_eq(decode(v.text), Some(v.bytes))
}

test "a decoder rejects what an encoder would not write" {
  assert_eq(decode("!!!!!"), None);
  assert_eq(decode("9jzqo"), None);
  assert_eq(decode("9`z9`"), None);
  assert_eq(decode("9jqov"), None);
  assert_eq(decode("s8W-\""), None);
  assert_eq(decode("9"), None);
  assert_eq(decode("!"), None);
  assert_eq(decode("9jqo^B"), None);
  assert_eq(decode("9a"), None);
  assert_eq(decode("9jqo^ Bla"), None);
  assert_eq(decode("<~9jqo^~>"), None)
}

test "`encode_framed` wraps text in `<~` and `~>`, `decode_framed` requires both markers, and the caller must remove whitespace before decoding" {
  assert_eq(encode_framed(b"Man "), "<~9jqo^~>");
  assert_eq(decode_framed("<~9jqo^~>"), Some(b"Man "));
  assert_eq(encode_framed(b""), "<~~>");
  assert_eq(decode_framed("<~~>"), Some(b""));
  assert_eq(decode_framed("9jqo^"), None);
  assert_eq(decode_framed("<~9`!!"), None);
  assert_eq(decode_framed("!!9`~>"), None);
  assert_eq(decode_framed("<~>"), None);
  assert_eq(decode_framed("<~9jqo^\n~>"), None);
  assert_eq(strip_whitespace("<~9jqo^\r\n Bla\t~>\n"), "<~9jqo^Bla~>");
  assert_eq(decode_framed(strip_whitespace("<~9jqo^\r\n Bla\t~>\n")), Some(b"Man is"))
}
