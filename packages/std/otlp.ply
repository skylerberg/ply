//! OTLP, the OpenTelemetry protocol: its traces and metrics as values, the two encodings a
//! collector accepts over HTTP, and an exporter that is a `trace` handler.
//!
//! The model follows the protocol, using the protocol's field widths where it gives them: a time is
//! a `U64` of nanoseconds since the Unix epoch and a dropped count is a `U32`, so every value of a
//! type has an encoding and reads back as itself. Trace ids and span ids are the types from
//! `std.traceparent`. Metrics are a gauge, a sum and a histogram with explicit bounds. Exponential
//! histograms and summaries are not modelled, and a reader rejects a metric of either kind and
//! names it. Exemplars, a data point's flags, a metric's metadata and a resource's entity
//! references are skipped, as is any field a later protocol version adds.
//!
//! `encode_traces` and `encode_metrics` write a request in either `Encoding`. `Protobuf` is the
//! binary form a collector expects by default, written by field number over `std.protobuf`. `Json`
//! is OTLP's JSON mapping, which differs from proto3's: ids are hex, a 64-bit number is a decimal
//! string, an enum is its number, keys are lowerCamelCase and bytes are base64. A double that JSON
//! has no number for is written as a string: `NaN`, `Infinity` or `-Infinity`. A finite double that
//! `std.json`'s `Decimal` cannot represent is written as a string of its decimal digits. Readers
//! also accept these strings, as the mapping allows. Either reader takes its `Limits`, skips a
//! field it does not know, and reports why and where it fails. The `decode_` functions return the
//! error as an `Err`, and the `read_` functions raise it. The field numbers are those of
//! `opentelemetry-proto` 1.11.1.
//!
//! `exporting` is the sink: a handler for `trace` that records what a program traces, a span from
//! its `enter` to its `exit` and each counter, gauge and timing as a series. It sends them to a
//! collector through `std.http`'s client in batches, from a bounded queue, with retries. Nothing is
//! exported until a program installs it.

import std.base64 (base64_decode, base64_encode)
import std.bytes
import std.float
import std.gen
import std.gen (Gen)
import std.gzip
import std.json
import std.json (Json, Null, Number, Str)
import std.protobuf
import std.protobuf (Field, Message, protobuf)
import std.http
import std.ip
import std.list
import std.net
import std.net (Sends, net)
import std.random (entropy, rand, with_rand)
import std.show (show)
import std.string
import std.telemetry
import std.telemetry (Sampler, Tracing, tracing)
import std.time (time)
import std.trace
import std.trace (Fields, trace)
import std.traceparent
import std.traceparent (SpanId, TraceId)

/// An attribute's value.
pub type AnyValue =
  | StringValue(String)
  | BoolValue(Bool)
  | IntValue(Int)
  | DoubleValue(Float)
  | ArrayValue(List<AnyValue>)
  /// Keys and values in order. The protocol requires that no key repeats, and nothing here checks.
  | KvlistValue(List<KeyValue>)
  | BytesValue(Bytes)
  /// A value that was not set, which the protocol allows, and which an array's null element is.
  | NoValue

/// A key and its value, used for attributes on resources, scopes, spans, events and links.
pub type KeyValue = new { key: String, value: AnyValue }

/// What produced the telemetry: `service.name` and its siblings.
pub type Resource = new { attributes: List<KeyValue>, dropped_attributes: U32 }

/// The instrumentation that recorded the telemetry. The exporter in this module sets `name` to the
/// `trace` channel name that produced each span.
pub type Scope = new {
  name: String,
  version: String,
  attributes: List<KeyValue>,
  dropped_attributes: U32,
}

/// Which side of a call a span is.
pub type SpanKind = | Unspecified | Internal | Server | Client | Producer | Consumer

/// How a span ended.
pub type StatusCode = | StatusUnset | StatusOk | StatusError

/// A span's status. `message` describes what went wrong under `StatusError`.
pub type Status = new { code: StatusCode, message: String }

/// Something that happened at one moment of a span.
pub type Event = new {
  time: U64,
  name: String,
  attributes: List<KeyValue>,
  dropped_attributes: U32,
}

/// Another span this one is related to, in any trace.
pub type Link = new {
  trace_id: TraceId,
  span_id: SpanId,
  trace_state: String,
  attributes: List<KeyValue>,
  dropped_attributes: U32,
  flags: U32,
}

/// One operation of a trace.
pub type Span = new {
  trace_id: TraceId,
  span_id: SpanId,
  /// The `tracestate` header's text.
  trace_state: String,
  /// `None` on a trace's first span.
  parent: Option<SpanId>,
  /// The span's flags. The low eight bits are the W3C trace flags. Bit 8 is set when the flags say
  /// whether the parent span is remote (in another process), and bit 9 is set when the parent is
  /// remote. Bit 9 means nothing unless bit 8 is set.
  flags: U32,
  name: String,
  kind: SpanKind,
  start: U64,
  end: U64,
  attributes: List<KeyValue>,
  dropped_attributes: U32,
  events: List<Event>,
  dropped_events: U32,
  links: List<Link>,
  dropped_links: U32,
  status: Status,
}

/// The spans one scope recorded.
pub type ScopeSpans = new { scope: Scope, spans: List<Span>, schema_url: String }

/// The spans of one resource.
pub type ResourceSpans = new {
  resource: Resource,
  scope_spans: List<ScopeSpans>,
  schema_url: String,
}

/// A request to `/v1/traces`.
pub type Traces = new { resource_spans: List<ResourceSpans> }

/// Whether a point covers the time since the last one, or since `start`.
pub type Temporality = | Delta | Cumulative

/// A measurement.
pub type Number = | AsDouble(Float) | AsInt(Int)

/// One series of a gauge or a sum at one time.
pub type NumberPoint = new {
  attributes: List<KeyValue>,
  /// When the series began to be counted; zero where that is not known.
  start: U64,
  time: U64,
  value: Number,
}

/// One series of a histogram at one time. `bucket_counts` contains one count more than
/// `explicit_bounds` has bounds: a bound is the greatest value its bucket counts, and the last
/// bucket counts what is past them all.
pub type HistogramPoint = new {
  attributes: List<KeyValue>,
  start: U64,
  time: U64,
  count: U64,
  sum: Option<Float>,
  bucket_counts: List<U64>,
  explicit_bounds: List<Float>,
  min: Option<Float>,
  max: Option<Float>,
}

/// What a metric contains.
pub type Data =
  | Gauge(List<NumberPoint>)
  /// The points, how they add up over time, and whether the sum only ever grows.
  | Sum(List<NumberPoint>, Temporality, Bool)
  | Histogram(List<HistogramPoint>, Temporality)

/// One metric and its series.
pub type Metric = new { name: String, description: String, unit: String, data: Data }

/// The metrics one scope recorded.
pub type ScopeMetrics = new { scope: Scope, metrics: List<Metric>, schema_url: String }

/// The metrics of one resource.
pub type ResourceMetrics = new {
  resource: Resource,
  scope_metrics: List<ScopeMetrics>,
  schema_url: String,
}

/// A request to `/v1/metrics`.
pub type Metrics = new { resource_metrics: List<ResourceMetrics> }

/// A collector's reply to a request it accepted only part of: how many spans or data points it
/// rejected, and why. When it accepted everything, the count is zero and the message empty.
pub type ExportResponse = new { rejected: Int, message: String }

/// A resource with no attributes.
pub fn empty_resource() -> Resource = { attributes: [], dropped_attributes: 0u32 }

/// A scope named `name`, with no other fields set.
pub fn scope(name: String) -> Scope =
  { name: name, version: "", attributes: [], dropped_attributes: 0u32 }

/// An unset status with no message.
pub fn unset() -> Status = { code: StatusUnset, message: "" }

/// An attribute.
pub fn attribute(key: String, value: AnyValue) -> KeyValue = { key: key, value: value }

/// The HTTP path where a collector accepts traces.
pub fn traces_path() -> String = "/v1/traces"

/// The HTTP path where a collector accepts metrics.
pub fn metrics_path() -> String = "/v1/metrics"

fn doubles() -> Gen<Float> =
  gen::one_of([
    gen::elements([
      0.0,
      1.5,
      -2.25,
      0.1,
      1e300,
      -1e-300,
      5e-324,
      123456789.125,
      0.30000000000000004,
    ]),
    gen::map(gen::int(), |n: Int| Float::of_int(n)),
    gen::map2(gen::int(), gen::int_between(-80, 80), |m: Int, e: Int|
      Float::of_int(m) * Float::pow2(e)),
    gen::elements([Float::infinity(), Float::neg_infinity()]),
  ])

fn texts() -> Gen<String> =
  gen::one_of([
    gen::elements([
      "",
      "a",
      "service.name",
      "two words",
      "quote \" slash \\ line\nfeed",
      "h\u{e9}llo \u{1F600}",
    ]),
    gen::map(gen::list_of(gen::int_between(32, 767), 12), |points: List<Int>|
      String::of_chars(
        points.fold([], |accumulator: List<Char>, p: Int|
          match Char::of_int(p) { Some(c) -> accumulator.push(c), None -> accumulator }),
      )),
  ])

fn u64s() -> Gen<U64> =
  gen::map2(gen::below(4294967296), gen::below(4294967296), |high: Int, low: Int|
    U64::of_int(high) << 32 | U64::of_int(low))

fn any_values() -> Gen<AnyValue> = gen::sized(|size: Int| values_at(min(max(size / 16, 0), 3)))

fn scalars() -> Gen<AnyValue> =
  gen::one_of([
    gen::map(texts(), |s: String| StringValue(s)),
    gen::map(gen::bool(), |b: Bool| BoolValue(b)),
    gen::map(gen::int(), |n: Int| IntValue(n)),
    gen::map(doubles(), |f: Float| DoubleValue(f)),
    gen::map(gen::and_then(gen::below(5), |n: Int| gen::bytes_of(n)), |b: Bytes| BytesValue(b)),
    gen::constant(NoValue),
  ])

fn values_at(depth: Int) -> Gen<AnyValue> =
  if depth <= 0 { scalars() } else {
    gen::one_of([
      scalars(),
      gen::map(gen::list_of(values_at(depth - 1), 3), |xs: List<AnyValue>| ArrayValue(xs)),
      gen::map(gen::list_of(key_values_at(depth - 1), 3), |kvs: List<KeyValue>| KvlistValue(kvs)),
    ])
  }

fn key_values_at(depth: Int) -> Gen<KeyValue> =
  gen::map2(texts(), values_at(depth), |key: String, value: AnyValue| -> KeyValue {
    { key: key, value: value }
  })

fn numbers() -> Gen<Number> =
  gen::one_of([
    gen::map(gen::int(), |n: Int| AsInt(n)),
    gen::map(doubles(), |f: Float| AsDouble(f)),
  ])

fn histogram_points() -> Gen<HistogramPoint> =
  gen::and_then(gen::list_of(key_values_at(1), 3), |attributes: List<KeyValue>|
    gen::and_then(gen::list_of_length(u64s(), 3), |times: List<U64>|
      gen::and_then(
        gen::list_of_length(gen::option_of(doubles()), 3),
        |stats: List<Option<Float>>|
          gen::map2(
            gen::list_of(u64s(), 5),
            gen::list_of(doubles(), 4),
            |counts: List<U64>, bounds: List<Float>| -> HistogramPoint {
              {
                attributes: attributes,
                start: u64_at(times, 0),
                time: u64_at(times, 1),
                count: u64_at(times, 2),
                sum: stat_at(stats, 0),
                bucket_counts: counts,
                explicit_bounds: bounds,
                min: stat_at(stats, 1),
                max: stat_at(stats, 2),
              }
            },
          ),
      )))

fn u64_at(xs: List<U64>, i: Int) -> U64 = match xs.at(i) { Some(x) -> x, None -> 0u64 }

fn stat_at(xs: List<Option<Float>>, i: Int) -> Option<Float> =
  match xs.at(i) { Some(x) -> x, None -> None }

/// Why a reader rejected a request.
pub type ErrorKind =
  /// The bytes are not the protobuf of a request: `std.protobuf`'s own error.
  | NotProtobuf(protobuf::ErrorKind)
  /// The text is not JSON, with the parser's message.
  | NotJson(String)
  /// A JSON value has the wrong type for its field. The `String` names the type the field expects,
  /// such as `a string` or `an array`.
  | WrongKind(String)
  /// A trace id that is not sixteen bytes or a span id that is not eight, or one all zeros.
  | BadId
  /// An enum number that names no value.
  | BadEnum(Int)
  /// A value that is not a whole number, or that exceeds its field's width.
  | BadNumber
  /// Text that should be hex or base64 and is not.
  | BadText
  /// A metric of a kind this module does not model: `exponential_histogram` or `summary`.
  | Unsupported(String)
  /// A required part of a message is absent: a metric's data, a point's value, or a sum or
  /// histogram's aggregation temporality (whether its values are cumulative or per interval).
  | Missing(String)
  /// Longer than `Limits.length`.
  | TooLong
  /// Attribute values nested deeper than `Limits.depth`.
  | TooDeep

/// An error: why, at which byte, and in which field.
pub type Error = new {
  reason: ErrorKind,
  /// For protobuf, the offset of the rejected field. For JSON, the byte where the parser stopped,
  /// or -1 for a value rejected after the text had parsed.
  at: Int,
  /// The field's name as the JSON mapping writes it, such as `traceId`. Empty when the error is in
  /// the encoding and not in a field.
  field: String,
}

/// The operations a program performs on the OTLP exporter (the handler that queues telemetry and
/// sends it to a collector), plus the failure that this module's readers raise.
pub effect otlp {
  /// The bytes are not a request this module models.
  raise fail(e: Error)
  /// Sends all the telemetry the exporter has queued to the collector, and returns the exporter's
  /// statistics.
  write flush() -> Stats
  /// Returns the exporter's statistics so far.
  read stats() -> Stats
}

/// The limits a reader enforces on a request.
pub type Limits = new {
  /// The most bytes a request may be.
  length: Int,
  /// How deep messages may nest, including an attribute's arrays and lists.
  depth: Int,
}

/// Returns the limits a collector accepts by default. They are larger than any request this module
/// writes.
pub fn default_limits() -> Limits = { length: 4194304, depth: 64 }

fn fail<a>(reason: ErrorKind, at: Int, field: String) -> a / {otlp.fail} =
  otlp.fail({ reason: reason, at: at, field: field })

/// How a request is written.
pub type Encoding =
  /// The binary form: `application/x-protobuf`.
  | Protobuf
  /// OTLP's JSON mapping: `application/json`.
  | Json

/// Says whether a collector's reply belongs to a traces request or a metrics request. The JSON
/// reply names rejected spans and rejected data points with different field names.
pub type Signal = | TraceSignal | MetricSignal

/// The `Content-Type` a request in this encoding is sent with.
pub fn content_type(e: Encoding) -> String =
  match e { Protobuf -> "application/x-protobuf", Json -> "application/json" }

/// A request to `/v1/traces`.
pub fn encode_traces(e: Encoding, t: Traces) -> Bytes / {abort.raise} =
  match e { Protobuf -> traces_body(t), Json -> json::to_bytes(traces_json(t)) }

/// A request to `/v1/metrics`.
pub fn encode_metrics(e: Encoding, m: Metrics) -> Bytes / {abort.raise} =
  match e { Protobuf -> metrics_body(m), Json -> json::to_bytes(metrics_json(m)) }

/// Encodes a collector's reply to `signal` in the given encoding. A reply that rejects nothing and
/// has no message encodes as the empty protobuf message.
pub fn encode_response(e: Encoding, signal: Signal, r: ExportResponse) -> Bytes / {abort.raise} =
  match e { Protobuf -> response_body(r), Json -> json::to_bytes(response_json(signal, r)) }

/// The traces in a request. Raises `otlp.fail` where `decode_traces` returns `Err`.
pub fn read_traces(e: Encoding, data: Bytes, limits: Limits) -> Traces / {otlp.fail, abort.raise} =
  match e {
    Protobuf -> from_protobuf(data, limits, |m: Message| traces_of(m, limits.depth)),
    Json -> traces_of_json(parsed(data, limits), limits.depth),
  }

/// The metrics in a request. Raises `otlp.fail` where `decode_metrics` returns `Err`.
pub fn read_metrics(
  e: Encoding,
  data: Bytes,
  limits: Limits,
) -> Metrics / {otlp.fail, abort.raise} =
  match e {
    Protobuf -> from_protobuf(data, limits, |m: Message| metrics_of(m, limits.depth)),
    Json -> metrics_of_json(parsed(data, limits), limits.depth),
  }

/// The receipt in a collector's reply. Raises `otlp.fail` where `decode_response` returns
/// `Err`.
pub fn read_response(
  e: Encoding,
  signal: Signal,
  data: Bytes,
  limits: Limits,
) -> ExportResponse / {otlp.fail, abort.raise} =
  match e {
    Protobuf -> from_protobuf(data, limits, response_of),
    Json -> response_of_json(signal, parsed(data, limits)),
  }

/// The traces in a request, or why it was rejected.
pub fn decode_traces(
  e: Encoding,
  data: Bytes,
  limits: Limits,
) -> Result<Traces, Error> / {abort.raise} = try { read_traces(e, data, limits) }

/// The metrics in a request, or why it was rejected.
pub fn decode_metrics(
  e: Encoding,
  data: Bytes,
  limits: Limits,
) -> Result<Metrics, Error> / {abort.raise} = try { read_metrics(e, data, limits) }

/// The receipt in a collector's reply, or why it was rejected.
pub fn decode_response(
  e: Encoding,
  signal: Signal,
  data: Bytes,
  limits: Limits,
) -> Result<ExportResponse, Error> / {abort.raise} = try { read_response(e, signal, data, limits) }

fn string_if_set(field: Int, s: String) -> Bytes / {abort.raise} =
  if s == "" { b"" } else { protobuf::string_field(field, s) }

fn u32_if_set(field: Int, n: U32) -> Bytes / {abort.raise} =
  if n == 0u32 { b"" } else { protobuf::int_field(field, Int::of_u32(n)) }

fn time_if_set(field: Int, n: U64) -> Bytes / {abort.raise} =
  if n == 0u64 { b"" } else { protobuf::fixed64_field(field, n) }

fn int_if_set(field: Int, n: Int) -> Bytes / {abort.raise} =
  if n == 0 { b"" } else { protobuf::int_field(field, n) }

fn repeated_messages(field: Int, bodies: List<Bytes>) -> Bytes / {abort.raise} =
  Bytes::concat_all(bodies.map(|body: Bytes| protobuf::message_field(field, body)))

fn value_body(v: AnyValue) -> Bytes / {abort.raise} =
  match v {
    StringValue(s) -> protobuf::string_field(1, s),
    BoolValue(b) -> protobuf::bool_field(2, b),
    IntValue(n) -> protobuf::int_field(3, n),
    DoubleValue(f) -> protobuf::double_field(4, f),
    ArrayValue(xs) -> protobuf::message_field(5, repeated_messages(1, xs.map(value_body))),
    KvlistValue(kvs) -> protobuf::message_field(6, repeated_messages(1, kvs.map(key_value_body))),
    BytesValue(b) -> protobuf::bytes_field(7, b),
    NoValue -> b"",
  }

fn key_value_body(key_value: KeyValue) -> Bytes / {abort.raise} =
  string_if_set(1, key_value.key).concat(match key_value.value {
    NoValue -> b"",
    value -> protobuf::message_field(2, value_body(value)),
  })

fn attributes_at(field: Int, kvs: List<KeyValue>) -> Bytes / {abort.raise} =
  repeated_messages(field, kvs.map(key_value_body))

fn resource_body(r: Resource) -> Bytes / {abort.raise} =
  attributes_at(1, r.attributes).concat(u32_if_set(2, r.dropped_attributes))

fn scope_body(s: Scope) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    string_if_set(1, s.name),
    string_if_set(2, s.version),
    attributes_at(3, s.attributes),
    u32_if_set(4, s.dropped_attributes),
  ])

fn kind_number(k: SpanKind) -> Int =
  match k {
    Unspecified -> 0,
    Internal -> 1,
    Server -> 2,
    Client -> 3,
    Producer -> 4,
    Consumer -> 5,
  }

fn code_number(c: StatusCode) -> Int = match c { StatusUnset -> 0, StatusOk -> 1, StatusError -> 2 }

fn temporality_number(t: Temporality) -> Int = match t { Delta -> 1, Cumulative -> 2 }

fn status_at(field: Int, s: Status) -> Bytes / {abort.raise} =
  if s == unset() { b"" } else {
    protobuf::message_field(
      field,
      string_if_set(2, s.message).concat(int_if_set(3, code_number(s.code))),
    )
  }

fn flags_at(field: Int, flags: U32) -> Bytes / {abort.raise} =
  if flags == 0u32 { b"" } else { protobuf::fixed32_field(field, flags) }

fn event_body(e: Event) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    time_if_set(1, e.time),
    string_if_set(2, e.name),
    attributes_at(3, e.attributes),
    u32_if_set(4, e.dropped_attributes),
  ])

fn link_body(l: Link) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    protobuf::bytes_field(1, traceparent::trace_id_bytes(l.trace_id)),
    protobuf::bytes_field(2, traceparent::span_id_bytes(l.span_id)),
    string_if_set(3, l.trace_state),
    attributes_at(4, l.attributes),
    u32_if_set(5, l.dropped_attributes),
    flags_at(6, l.flags),
  ])

fn span_body(s: Span) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    protobuf::bytes_field(1, traceparent::trace_id_bytes(s.trace_id)),
    protobuf::bytes_field(2, traceparent::span_id_bytes(s.span_id)),
    string_if_set(3, s.trace_state),
    match s.parent {
      Some(id) -> protobuf::bytes_field(4, traceparent::span_id_bytes(id)),
      None -> b"",
    },
    string_if_set(5, s.name),
    int_if_set(6, kind_number(s.kind)),
    time_if_set(7, s.start),
    time_if_set(8, s.end),
    attributes_at(9, s.attributes),
    u32_if_set(10, s.dropped_attributes),
    repeated_messages(11, s.events.map(event_body)),
    u32_if_set(12, s.dropped_events),
    repeated_messages(13, s.links.map(link_body)),
    u32_if_set(14, s.dropped_links),
    status_at(15, s.status),
    flags_at(16, s.flags),
  ])

fn scope_spans_body(s: ScopeSpans) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    protobuf::message_field(1, scope_body(s.scope)),
    repeated_messages(2, s.spans.map(span_body)),
    string_if_set(3, s.schema_url),
  ])

fn resource_spans_body(r: ResourceSpans) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    protobuf::message_field(1, resource_body(r.resource)),
    repeated_messages(2, r.scope_spans.map(scope_spans_body)),
    string_if_set(3, r.schema_url),
  ])

fn traces_body(t: Traces) -> Bytes / {abort.raise} =
  repeated_messages(1, t.resource_spans.map(resource_spans_body))

fn number_point_body(p: NumberPoint) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    time_if_set(2, p.start),
    time_if_set(3, p.time),
    match p.value { AsDouble(f) -> protobuf::double_field(4, f), AsInt(_) -> b"" },
    match p.value { AsInt(n) -> protobuf::sfixed64_field(6, n), AsDouble(_) -> b"" },
    attributes_at(7, p.attributes),
  ])

fn optional_double(field: Int, f: Option<Float>) -> Bytes / {abort.raise} =
  match f { Some(x) -> protobuf::double_field(field, x), None -> b"" }

fn histogram_point_body(p: HistogramPoint) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    time_if_set(2, p.start),
    time_if_set(3, p.time),
    time_if_set(4, p.count),
    optional_double(5, p.sum),
    protobuf::packed_fixed64(6, p.bucket_counts),
    protobuf::packed_doubles(7, p.explicit_bounds),
    attributes_at(9, p.attributes),
    optional_double(11, p.min),
    optional_double(12, p.max),
  ])

fn data_body(d: Data) -> Bytes / {abort.raise} =
  match d {
    Gauge(points) ->
      protobuf::message_field(5, repeated_messages(1, points.map(number_point_body))),
    Sum(points, temporality, monotonic) ->
      protobuf::message_field(
        7,
        Bytes::concat_all([
          repeated_messages(1, points.map(number_point_body)),
          protobuf::int_field(2, temporality_number(temporality)),
          if monotonic { protobuf::bool_field(3, true) } else { b"" },
        ]),
      ),
    Histogram(points, temporality) ->
      protobuf::message_field(
        9,
        repeated_messages(1, points.map(histogram_point_body)).concat(
          protobuf::int_field(2, temporality_number(temporality)),
        ),
      ),
  }

fn metric_body(m: Metric) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    string_if_set(1, m.name),
    string_if_set(2, m.description),
    string_if_set(3, m.unit),
    data_body(m.data),
  ])

fn scope_metrics_body(s: ScopeMetrics) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    protobuf::message_field(1, scope_body(s.scope)),
    repeated_messages(2, s.metrics.map(metric_body)),
    string_if_set(3, s.schema_url),
  ])

fn resource_metrics_body(r: ResourceMetrics) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    protobuf::message_field(1, resource_body(r.resource)),
    repeated_messages(2, r.scope_metrics.map(scope_metrics_body)),
    string_if_set(3, r.schema_url),
  ])

fn metrics_body(m: Metrics) -> Bytes / {abort.raise} =
  repeated_messages(1, m.resource_metrics.map(resource_metrics_body))

fn response_body(r: ExportResponse) -> Bytes / {abort.raise} =
  if r.rejected == 0 && r.message == "" { b"" }
  else { protobuf::message_field(1, int_if_set(1, r.rejected).concat(string_if_set(2, r.message))) }

fn from_protobuf<a>(
  data: Bytes,
  limits: Limits,
  read: (Message) -> a / {otlp.fail, protobuf.fail, abort.raise},
) -> a / {otlp.fail, abort.raise} =
  match try[protobuf.fail] {
      read(protobuf::message(data, { depth: limits.depth, length: limits.length }))
    } {
    Ok(result) -> result,
    Err(e) -> fail(NotProtobuf(e.reason), e.at, ""),
  }

effect set Reading = {otlp.fail, protobuf.fail, abort.raise}

fn value_of(m: Message, depth_left: Int) -> AnyValue / {Reading} =
  if depth_left <= 0 { fail(TooDeep, protobuf::offset(m), "value") } else {
    protobuf::fields(m).fold(NoValue, |value: AnyValue, f: Field|
      match f.number {
        1 -> StringValue(protobuf::string_of(f)),
        2 -> BoolValue(protobuf::bool_of(f)),
        3 -> IntValue(protobuf::int_of(f)),
        4 -> DoubleValue(protobuf::double_of(f)),
        5 -> ArrayValue(values_in(protobuf::message_of(f), depth_left - 1)),
        6 -> KvlistValue(key_values_in(protobuf::message_of(f), 1, depth_left - 1)),
        7 -> BytesValue(protobuf::bytes_of(f)),
        _ -> value,
      })
  }

fn values_in(m: Message, depth_left: Int) -> List<AnyValue> / {Reading} =
  protobuf::fields(m).fold([], |accumulator: List<AnyValue>, f: Field|
    match f.number {
      1 -> accumulator.push(value_of(protobuf::message_of(f), depth_left)),
      _ -> accumulator,
    })

fn key_values_in(m: Message, int_if_set: Int, depth_left: Int) -> List<KeyValue> / {Reading} =
  protobuf::fields(m).fold([], |accumulator: List<KeyValue>, f: Field|
    if f.number == int_if_set {
      accumulator.push(key_value_of(protobuf::message_of(f), depth_left))
    } else { accumulator })

fn key_value_of(m: Message, depth_left: Int) -> KeyValue / {Reading} = {
  let start: KeyValue = { key: "", value: NoValue };
  protobuf::fields(m).fold(start, |key_value: KeyValue, f: Field|
    match f.number {
      1 -> { ..key_value, key: protobuf::string_of(f) },
      2 -> { ..key_value, value: value_of(protobuf::message_of(f), depth_left) },
      _ -> key_value,
    })
}

fn resource_of(m: Message, depth_left: Int) -> Resource / {Reading} =
  protobuf::fields(m).fold(empty_resource(), |r: Resource, f: Field|
    match f.number {
      1 ->
        { ..r, attributes: r.attributes.push(key_value_of(protobuf::message_of(f), depth_left)) },
      2 -> { ..r, dropped_attributes: protobuf::uint32_of(f) },
      _ -> r,
    })

fn scope_of(m: Message, depth_left: Int) -> Scope / {Reading} =
  protobuf::fields(m).fold(scope(""), |s: Scope, f: Field|
    match f.number {
      1 -> { ..s, name: protobuf::string_of(f) },
      2 -> { ..s, version: protobuf::string_of(f) },
      3 ->
        { ..s, attributes: s.attributes.push(key_value_of(protobuf::message_of(f), depth_left)) },
      4 -> { ..s, dropped_attributes: protobuf::uint32_of(f) },
      _ -> s,
    })

fn kind_of(n: Int, at: Int) -> SpanKind / {otlp.fail} =
  match n {
    0 -> Unspecified,
    1 -> Internal,
    2 -> Server,
    3 -> Client,
    4 -> Producer,
    5 -> Consumer,
    _ -> fail(BadEnum(n), at, "kind"),
  }

fn code_of(n: Int, at: Int) -> StatusCode / {otlp.fail} =
  match n { 0 -> StatusUnset, 1 -> StatusOk, 2 -> StatusError, _ -> fail(BadEnum(n), at, "code") }

fn temporality_of(n: Int, at: Int) -> Temporality / {otlp.fail} =
  match n {
    1 -> Delta,
    2 -> Cumulative,
    0 -> fail(Missing("aggregationTemporality"), at, "aggregationTemporality"),
    _ -> fail(BadEnum(n), at, "aggregationTemporality"),
  }

fn status_of(m: Message) -> Status / {Reading} =
  protobuf::fields(m).fold(unset(), |s: Status, f: Field|
    match f.number {
      2 -> { ..s, message: protobuf::string_of(f) },
      3 -> { ..s, code: code_of(protobuf::int_of(f), f.at) },
      _ -> s,
    })

fn event_of(m: Message, depth_left: Int) -> Event / {Reading} = {
  let start: Event = { time: 0u64, name: "", attributes: [], dropped_attributes: 0u32 };
  protobuf::fields(m).fold(start, |e: Event, f: Field|
    match f.number {
      1 -> { ..e, time: protobuf::fixed64_of(f) },
      2 -> { ..e, name: protobuf::string_of(f) },
      3 ->
        { ..e, attributes: e.attributes.push(key_value_of(protobuf::message_of(f), depth_left)) },
      4 -> { ..e, dropped_attributes: protobuf::uint32_of(f) },
      _ -> e,
    })
}

type Raw = {
  trace_id: Bytes,
  span_id: Bytes,
  parent: Bytes,
  trace_state: String,
  flags: U32,
  name: String,
  kind: SpanKind,
  start: U64,
  end: U64,
  attributes: List<KeyValue>,
  dropped_attributes: U32,
  events: List<Event>,
  dropped_events: U32,
  links: List<Link>,
  dropped_links: U32,
  status: Status,
  at: Int,
}

fn raw_at(at: Int) -> Raw =
  {
    trace_id: b"",
    span_id: b"",
    parent: b"",
    trace_state: "",
    flags: 0u32,
    name: "",
    kind: Unspecified,
    start: 0u64,
    end: 0u64,
    attributes: [],
    dropped_attributes: 0u32,
    events: [],
    dropped_events: 0u32,
    links: [],
    dropped_links: 0u32,
    status: unset(),
    at: at,
  }

fn trace_id_of(raw: Bytes, at: Int) -> TraceId / {otlp.fail, abort.raise} =
  match traceparent::trace_id(raw) { Some(id) -> id, None -> fail(BadId, at, "traceId") }

fn span_id_of(raw: Bytes, at: Int, field: String) -> SpanId / {otlp.fail, abort.raise} =
  match traceparent::span_id(raw) { Some(id) -> id, None -> fail(BadId, at, field) }

fn parent_of(raw: Bytes, at: Int) -> Option<SpanId> / {otlp.fail, abort.raise} =
  if raw.len() == 0 || raw == b"\x00\x00\x00\x00\x00\x00\x00\x00" { None }
  else { Some(span_id_of(raw, at, "parentSpanId")) }

fn span_from(r: Raw) -> Span / {otlp.fail, abort.raise} =
  {
    trace_id: trace_id_of(r.trace_id, r.at),
    span_id: span_id_of(r.span_id, r.at, "spanId"),
    trace_state: r.trace_state,
    parent: parent_of(r.parent, r.at),
    flags: r.flags,
    name: r.name,
    kind: r.kind,
    start: r.start,
    end: r.end,
    attributes: r.attributes,
    dropped_attributes: r.dropped_attributes,
    events: r.events,
    dropped_events: r.dropped_events,
    links: r.links,
    dropped_links: r.dropped_links,
    status: r.status,
  }

fn link_from(r: Raw) -> Link / {otlp.fail, abort.raise} =
  {
    trace_id: trace_id_of(r.trace_id, r.at),
    span_id: span_id_of(r.span_id, r.at, "spanId"),
    trace_state: r.trace_state,
    attributes: r.attributes,
    dropped_attributes: r.dropped_attributes,
    flags: r.flags,
  }

fn link_of(m: Message, depth_left: Int) -> Link / {Reading} =
  link_from(
    protobuf::fields(m).fold(raw_at(protobuf::offset(m)), |r: Raw, f: Field|
      match f.number {
        1 -> { ..r, trace_id: protobuf::bytes_of(f) },
        2 -> { ..r, span_id: protobuf::bytes_of(f) },
        3 -> { ..r, trace_state: protobuf::string_of(f) },
        4 ->
          { ..r, attributes: r.attributes.push(key_value_of(protobuf::message_of(f), depth_left)) },
        5 -> { ..r, dropped_attributes: protobuf::uint32_of(f) },
        6 -> { ..r, flags: protobuf::fixed32_of(f) },
        _ -> r,
      }),
  )

fn span_of(m: Message, depth_left: Int) -> Span / {Reading} =
  span_from(
    protobuf::fields(m).fold(raw_at(protobuf::offset(m)), |r: Raw, f: Field|
      if f.number <= 8 { span_head(r, f) } else { span_tail(r, f, depth_left) }),
  )

fn span_head(r: Raw, f: Field) -> Raw / {Reading} =
  match f.number {
    1 -> { ..r, trace_id: protobuf::bytes_of(f) },
    2 -> { ..r, span_id: protobuf::bytes_of(f) },
    3 -> { ..r, trace_state: protobuf::string_of(f) },
    4 -> { ..r, parent: protobuf::bytes_of(f) },
    5 -> { ..r, name: protobuf::string_of(f) },
    6 -> { ..r, kind: kind_of(protobuf::int_of(f), f.at) },
    7 -> { ..r, start: protobuf::fixed64_of(f) },
    8 -> { ..r, end: protobuf::fixed64_of(f) },
    _ -> r,
  }

fn span_tail(r: Raw, f: Field, depth_left: Int) -> Raw / {Reading} =
  match f.number {
    9 -> { ..r, attributes: r.attributes.push(key_value_of(protobuf::message_of(f), depth_left)) },
    10 -> { ..r, dropped_attributes: protobuf::uint32_of(f) },
    11 -> { ..r, events: r.events.push(event_of(protobuf::message_of(f), depth_left)) },
    12 -> { ..r, dropped_events: protobuf::uint32_of(f) },
    13 -> { ..r, links: r.links.push(link_of(protobuf::message_of(f), depth_left)) },
    14 -> { ..r, dropped_links: protobuf::uint32_of(f) },
    15 -> { ..r, status: status_of(protobuf::message_of(f)) },
    16 -> { ..r, flags: protobuf::fixed32_of(f) },
    _ -> r,
  }

fn scope_spans_of(m: Message, depth_left: Int) -> ScopeSpans / {Reading} = {
  let start: ScopeSpans = { scope: scope(""), spans: [], schema_url: "" };
  protobuf::fields(m).fold(start, |s: ScopeSpans, f: Field|
    match f.number {
      1 -> { ..s, scope: scope_of(protobuf::message_of(f), depth_left) },
      2 -> { ..s, spans: s.spans.push(span_of(protobuf::message_of(f), depth_left)) },
      3 -> { ..s, schema_url: protobuf::string_of(f) },
      _ -> s,
    })
}

fn resource_spans_of(m: Message, depth_left: Int) -> ResourceSpans / {Reading} = {
  let start: ResourceSpans = { resource: empty_resource(), scope_spans: [], schema_url: "" };
  protobuf::fields(m).fold(start, |r: ResourceSpans, f: Field|
    match f.number {
      1 -> { ..r, resource: resource_of(protobuf::message_of(f), depth_left) },
      2 ->
        {
          ..r,
          scope_spans: r.scope_spans.push(scope_spans_of(protobuf::message_of(f), depth_left)),
        },
      3 -> { ..r, schema_url: protobuf::string_of(f) },
      _ -> r,
    })
}

fn traces_of(m: Message, depth_left: Int) -> Traces / {Reading} = {
  let start: Traces = { resource_spans: [] };
  protobuf::fields(m).fold(start, |t: Traces, f: Field|
    match f.number {
      1 ->
        {
          resource_spans: t.resource_spans.push(
            resource_spans_of(protobuf::message_of(f), depth_left),
          ),
        },
      _ -> t,
    })
}

type RawPoint = {
  attributes: List<KeyValue>,
  start: U64,
  time: U64,
  value: Option<Number>,
  at: Int,
}

fn number_point_of(m: Message, depth_left: Int) -> NumberPoint / {Reading} = {
  let start: RawPoint = {
    attributes: [],
    start: 0u64,
    time: 0u64,
    value: None,
    at: protobuf::offset(m),
  };
  let raw = protobuf::fields(m).fold(start, |p: RawPoint, f: Field|
    match f.number {
      2 -> { ..p, start: protobuf::fixed64_of(f) },
      3 -> { ..p, time: protobuf::fixed64_of(f) },
      4 -> { ..p, value: Some(AsDouble(protobuf::double_of(f))) },
      6 -> { ..p, value: Some(AsInt(protobuf::sfixed64_of(f))) },
      7 ->
        { ..p, attributes: p.attributes.push(key_value_of(protobuf::message_of(f), depth_left)) },
      _ -> p,
    });
  match raw.value {
    Some(value) -> { attributes: raw.attributes, start: raw.start, time: raw.time, value: value },
    None -> fail(Missing("value"), raw.at, "asDouble"),
  }
}

fn empty_histogram_point() -> HistogramPoint =
  {
    attributes: [],
    start: 0u64,
    time: 0u64,
    count: 0u64,
    sum: None,
    bucket_counts: [],
    explicit_bounds: [],
    min: None,
    max: None,
  }

fn histogram_point_of(m: Message, depth_left: Int) -> HistogramPoint / {Reading} =
  protobuf::fields(m).fold(empty_histogram_point(), |p: HistogramPoint, f: Field|
    match f.number {
      2 -> { ..p, start: protobuf::fixed64_of(f) },
      3 -> { ..p, time: protobuf::fixed64_of(f) },
      4 -> { ..p, count: protobuf::fixed64_of(f) },
      5 -> { ..p, sum: Some(protobuf::double_of(f)) },
      6 ->
        {
          ..p,
          bucket_counts: protobuf::fixed64s_of(f).fold(
            p.bucket_counts,
            |accumulator: List<U64>, n: U64| accumulator.push(n),
          ),
        },
      7 ->
        {
          ..p,
          explicit_bounds: protobuf::doubles_of(f).fold(
            p.explicit_bounds,
            |accumulator: List<Float>, x: Float| accumulator.push(x),
          ),
        },
      9 ->
        { ..p, attributes: p.attributes.push(key_value_of(protobuf::message_of(f), depth_left)) },
      11 -> { ..p, min: Some(protobuf::double_of(f)) },
      12 -> { ..p, max: Some(protobuf::double_of(f)) },
      _ -> p,
    })

type RawData<p> = { points: List<p>, temporality: Int, monotonic: Bool }

fn number_data_of(m: Message, depth_left: Int) -> RawData<NumberPoint> / {Reading} = {
  let start: RawData<NumberPoint> = { points: [], temporality: 0, monotonic: false };
  protobuf::fields(m).fold(start, |d: RawData<NumberPoint>, f: Field|
    match f.number {
      1 -> { ..d, points: d.points.push(number_point_of(protobuf::message_of(f), depth_left)) },
      2 -> { ..d, temporality: protobuf::int_of(f) },
      3 -> { ..d, monotonic: protobuf::bool_of(f) },
      _ -> d,
    })
}

fn histogram_data_of(m: Message, depth_left: Int) -> RawData<HistogramPoint> / {Reading} = {
  let start: RawData<HistogramPoint> = { points: [], temporality: 0, monotonic: false };
  protobuf::fields(m).fold(start, |d: RawData<HistogramPoint>, f: Field|
    match f.number {
      1 -> { ..d, points: d.points.push(histogram_point_of(protobuf::message_of(f), depth_left)) },
      2 -> { ..d, temporality: protobuf::int_of(f) },
      _ -> d,
    })
}

type RawMetric = { name: String, description: String, unit: String, data: Option<Data>, at: Int }

fn metric_of(m: Message, depth_left: Int) -> Metric / {Reading} = {
  let start: RawMetric = {
    name: "",
    description: "",
    unit: "",
    data: None,
    at: protobuf::offset(m),
  };
  let raw = protobuf::fields(m).fold(start, |r: RawMetric, f: Field|
    match f.number {
      1 -> { ..r, name: protobuf::string_of(f) },
      2 -> { ..r, description: protobuf::string_of(f) },
      3 -> { ..r, unit: protobuf::string_of(f) },
      5 -> { ..r, data: Some(Gauge(number_data_of(protobuf::message_of(f), depth_left).points)) },
      7 -> {
        let d = number_data_of(protobuf::message_of(f), depth_left);
        { ..r, data: Some(Sum(d.points, temporality_of(d.temporality, f.at), d.monotonic)) }
      },
      9 -> {
        let d = histogram_data_of(protobuf::message_of(f), depth_left);
        { ..r, data: Some(Histogram(d.points, temporality_of(d.temporality, f.at))) }
      },
      10 -> fail(Unsupported("exponential_histogram"), f.at, "exponentialHistogram"),
      11 -> fail(Unsupported("summary"), f.at, "summary"),
      _ -> r,
    });
  match raw.data {
    Some(data) -> { name: raw.name, description: raw.description, unit: raw.unit, data: data },
    None -> fail(Missing("data"), raw.at, "data"),
  }
}

fn scope_metrics_of(m: Message, depth_left: Int) -> ScopeMetrics / {Reading} = {
  let start: ScopeMetrics = { scope: scope(""), metrics: [], schema_url: "" };
  protobuf::fields(m).fold(start, |s: ScopeMetrics, f: Field|
    match f.number {
      1 -> { ..s, scope: scope_of(protobuf::message_of(f), depth_left) },
      2 -> { ..s, metrics: s.metrics.push(metric_of(protobuf::message_of(f), depth_left)) },
      3 -> { ..s, schema_url: protobuf::string_of(f) },
      _ -> s,
    })
}

fn resource_metrics_of(m: Message, depth_left: Int) -> ResourceMetrics / {Reading} = {
  let start: ResourceMetrics = { resource: empty_resource(), scope_metrics: [], schema_url: "" };
  protobuf::fields(m).fold(start, |r: ResourceMetrics, f: Field|
    match f.number {
      1 -> { ..r, resource: resource_of(protobuf::message_of(f), depth_left) },
      2 ->
        {
          ..r,
          scope_metrics: r.scope_metrics.push(
            scope_metrics_of(protobuf::message_of(f), depth_left),
          ),
        },
      3 -> { ..r, schema_url: protobuf::string_of(f) },
      _ -> r,
    })
}

fn metrics_of(m: Message, depth_left: Int) -> Metrics / {Reading} = {
  let start: Metrics = { resource_metrics: [] };
  protobuf::fields(m).fold(start, |metrics: Metrics, f: Field|
    match f.number {
      1 ->
        {
          resource_metrics: metrics.resource_metrics.push(
            resource_metrics_of(protobuf::message_of(f), depth_left),
          ),
        },
      _ -> metrics,
    })
}

fn response_of(m: Message) -> ExportResponse / {protobuf.fail, abort.raise} = {
  let start: ExportResponse = { rejected: 0, message: "" };
  protobuf::fields(m).fold(start, |r: ExportResponse, f: Field|
    match f.number {
      1 ->
        protobuf::fields(protobuf::message_of(f)).fold(r, |inner: ExportResponse, g: Field|
          match g.number {
            1 -> { ..inner, rejected: protobuf::int_of(g) },
            2 -> { ..inner, message: protobuf::string_of(g) },
            _ -> inner,
          }),
      _ -> r,
    })
}

type Member = { key: String, value: Json }

fn object(members: List<Member>) -> Json =
  json::Object(
    members.fold(Map::new(), |m: Map<String, Json>, e: Member|
      match e.value { Null -> m, held -> m.insert(e.key, held) }),
  )

fn json_if(present: Bool, j: Json) -> Json = if present { j } else { Null }

fn text_json(s: String) -> Json = json_if(s != "", Str(s))

fn u32_json(n: U32) -> Json = json_if(n != 0u32, json::int(Int::of_u32(n)))

fn u64_text(n: U64) -> String / {abort.raise} =
  U128::to_string(
    U128::of_int(Int::of_u64(n >>> 32)) * 4294967296u128
      + U128::of_int(Int::of_u64(n & 0xFFFF_FFFFu64)),
  )

fn time_json(n: U64) -> Json / {abort.raise} = if n == 0u64 { Null } else { Str(u64_text(n)) }

fn list_json(items: List<Json>) -> Json = json_if(items.len() > 0, json::Array(items))

fn float_json(f: Float) -> Json =
  if f != f { Str("NaN") }
  else if f == Float::infinity() { Str("Infinity") }
  else if f == Float::neg_infinity() { Str("-Infinity") } else {
    match Decimal::of_float(f) {
      Some(d) -> if Float::of_decimal(d) == f { Number(d) } else { Str(f.to_string()) },
      None -> Str(f.to_string()),
    }
  }

fn value_json(v: AnyValue) -> Json / {abort.raise} =
  match v {
    StringValue(s) -> json::object([{ key: "stringValue", value: Str(s) }]),
    BoolValue(b) -> json::object([{ key: "boolValue", value: json::Bool(b) }]),
    IntValue(n) -> json::object([{ key: "intValue", value: Str(n.to_string()) }]),
    DoubleValue(f) -> json::object([{ key: "doubleValue", value: float_json(f) }]),
    ArrayValue(xs) ->
      json::object([
        {
          key: "arrayValue",
          value: object([{ key: "values", value: list_json(xs.map(value_json)) }]),
        },
      ]),
    KvlistValue(kvs) ->
      json::object([
        { key: "kvlistValue", value: object([{ key: "values", value: attributes_json(kvs) }]) },
      ]),
    BytesValue(b) -> json::object([{ key: "bytesValue", value: Str(base64_encode(b)) }]),
    NoValue -> json::object([]),
  }

fn key_value_json(key_value: KeyValue) -> Json / {abort.raise} =
  object([
    { key: "key", value: text_json(key_value.key) },
    { key: "value", value: match key_value.value { NoValue -> Null, held -> value_json(held) } },
  ])

fn attributes_json(kvs: List<KeyValue>) -> Json / {abort.raise} = list_json(kvs.map(key_value_json))

fn resource_json(r: Resource) -> Json / {abort.raise} =
  object([
    { key: "attributes", value: attributes_json(r.attributes) },
    { key: "droppedAttributesCount", value: u32_json(r.dropped_attributes) },
  ])

fn scope_json(s: Scope) -> Json / {abort.raise} =
  object([
    { key: "name", value: text_json(s.name) },
    { key: "version", value: text_json(s.version) },
    { key: "attributes", value: attributes_json(s.attributes) },
    { key: "droppedAttributesCount", value: u32_json(s.dropped_attributes) },
  ])

fn enum_json(n: Int) -> Json = json_if(n != 0, json::int(n))

fn status_json(s: Status) -> Json =
  if s == unset() { Null } else {
    object([
      { key: "message", value: text_json(s.message) },
      { key: "code", value: enum_json(code_number(s.code)) },
    ])
  }

fn event_json(e: Event) -> Json / {abort.raise} =
  object([
    { key: "timeUnixNano", value: time_json(e.time) },
    { key: "name", value: text_json(e.name) },
    { key: "attributes", value: attributes_json(e.attributes) },
    { key: "droppedAttributesCount", value: u32_json(e.dropped_attributes) },
  ])

fn link_json(l: Link) -> Json / {abort.raise} =
  object([
    { key: "traceId", value: Str(traceparent::trace_id_hex(l.trace_id)) },
    { key: "spanId", value: Str(traceparent::span_id_hex(l.span_id)) },
    { key: "traceState", value: text_json(l.trace_state) },
    { key: "attributes", value: attributes_json(l.attributes) },
    { key: "droppedAttributesCount", value: u32_json(l.dropped_attributes) },
    { key: "flags", value: u32_json(l.flags) },
  ])

fn span_json(s: Span) -> Json / {abort.raise} =
  object([
    { key: "traceId", value: Str(traceparent::trace_id_hex(s.trace_id)) },
    { key: "spanId", value: Str(traceparent::span_id_hex(s.span_id)) },
    { key: "traceState", value: text_json(s.trace_state) },
    {
      key: "parentSpanId",
      value: match s.parent { Some(id) -> Str(traceparent::span_id_hex(id)), None -> Null },
    },
    { key: "flags", value: u32_json(s.flags) },
    { key: "name", value: text_json(s.name) },
    { key: "kind", value: enum_json(kind_number(s.kind)) },
    { key: "startTimeUnixNano", value: time_json(s.start) },
    { key: "endTimeUnixNano", value: time_json(s.end) },
    { key: "attributes", value: attributes_json(s.attributes) },
    { key: "droppedAttributesCount", value: u32_json(s.dropped_attributes) },
    { key: "events", value: list_json(s.events.map(event_json)) },
    { key: "droppedEventsCount", value: u32_json(s.dropped_events) },
    { key: "links", value: list_json(s.links.map(link_json)) },
    { key: "droppedLinksCount", value: u32_json(s.dropped_links) },
    { key: "status", value: status_json(s.status) },
  ])

fn scope_spans_json(s: ScopeSpans) -> Json / {abort.raise} =
  object([
    { key: "scope", value: scope_json(s.scope) },
    { key: "spans", value: list_json(s.spans.map(span_json)) },
    { key: "schemaUrl", value: text_json(s.schema_url) },
  ])

fn resource_spans_json(r: ResourceSpans) -> Json / {abort.raise} =
  object([
    { key: "resource", value: resource_json(r.resource) },
    { key: "scopeSpans", value: list_json(r.scope_spans.map(scope_spans_json)) },
    { key: "schemaUrl", value: text_json(r.schema_url) },
  ])

fn traces_json(t: Traces) -> Json / {abort.raise} =
  object([{ key: "resourceSpans", value: list_json(t.resource_spans.map(resource_spans_json)) }])

fn number_point_json(p: NumberPoint) -> Json / {abort.raise} =
  object([
    { key: "attributes", value: attributes_json(p.attributes) },
    { key: "startTimeUnixNano", value: time_json(p.start) },
    { key: "timeUnixNano", value: time_json(p.time) },
    match p.value {
      AsDouble(f) -> { key: "asDouble", value: float_json(f) },
      AsInt(n) -> { key: "asInt", value: Str(n.to_string()) },
    },
  ])

fn optional_double_json(f: Option<Float>) -> Json =
  match f { Some(x) -> float_json(x), None -> Null }

fn histogram_point_json(p: HistogramPoint) -> Json / {abort.raise} =
  object([
    { key: "attributes", value: attributes_json(p.attributes) },
    { key: "startTimeUnixNano", value: time_json(p.start) },
    { key: "timeUnixNano", value: time_json(p.time) },
    { key: "count", value: time_json(p.count) },
    { key: "sum", value: optional_double_json(p.sum) },
    { key: "bucketCounts", value: list_json(p.bucket_counts.map(|n: U64| Str(u64_text(n)))) },
    { key: "explicitBounds", value: list_json(p.explicit_bounds.map(float_json)) },
    { key: "min", value: optional_double_json(p.min) },
    { key: "max", value: optional_double_json(p.max) },
  ])

fn data_member(d: Data) -> Member / {abort.raise} =
  match d {
    Gauge(points) ->
      {
        key: "gauge",
        value: json::object([
          { key: "dataPoints", value: json::Array(points.map(number_point_json)) },
        ]),
      },
    Sum(points, temporality, monotonic) ->
      {
        key: "sum",
        value: object([
          { key: "dataPoints", value: list_json(points.map(number_point_json)) },
          { key: "aggregationTemporality", value: json::int(temporality_number(temporality)) },
          { key: "isMonotonic", value: if monotonic { json::Bool(true) } else { Null } },
        ]),
      },
    Histogram(points, temporality) ->
      {
        key: "histogram",
        value: object([
          { key: "dataPoints", value: list_json(points.map(histogram_point_json)) },
          { key: "aggregationTemporality", value: json::int(temporality_number(temporality)) },
        ]),
      },
  }

fn metric_json(m: Metric) -> Json / {abort.raise} =
  object([
    { key: "name", value: text_json(m.name) },
    { key: "description", value: text_json(m.description) },
    { key: "unit", value: text_json(m.unit) },
    data_member(m.data),
  ])

fn scope_metrics_json(s: ScopeMetrics) -> Json / {abort.raise} =
  object([
    { key: "scope", value: scope_json(s.scope) },
    { key: "metrics", value: list_json(s.metrics.map(metric_json)) },
    { key: "schemaUrl", value: text_json(s.schema_url) },
  ])

fn resource_metrics_json(r: ResourceMetrics) -> Json / {abort.raise} =
  object([
    { key: "resource", value: resource_json(r.resource) },
    { key: "scopeMetrics", value: list_json(r.scope_metrics.map(scope_metrics_json)) },
    { key: "schemaUrl", value: text_json(r.schema_url) },
  ])

fn metrics_json(m: Metrics) -> Json / {abort.raise} =
  object([
    { key: "resourceMetrics", value: list_json(m.resource_metrics.map(resource_metrics_json)) },
  ])

fn rejected_name(signal: Signal) -> String =
  match signal { TraceSignal -> "rejectedSpans", MetricSignal -> "rejectedDataPoints" }

fn response_json(signal: Signal, r: ExportResponse) -> Json =
  if r.rejected == 0 && r.message == "" { json::object([]) } else {
    json::object([
      {
        key: "partialSuccess",
        value: object([
          {
            key: rejected_name(signal),
            value: if r.rejected == 0 { Null } else { Str(r.rejected.to_string()) },
          },
          { key: "errorMessage", value: text_json(r.message) },
        ]),
      },
    ])
  }

type Members = Map<String, Json>

fn parsed(data: Bytes, limits: Limits) -> Json / {otlp.fail, abort.raise} =
  if data.len() > limits.length { fail(TooLong, limits.length, "") } else {
    match json::parse(data) {
      Ok(j) -> j,
      Err(e) -> fail(NotJson(e.message), match e.offset { Some(at) -> at, None -> -1 }, ""),
    }
  }

fn fail_field<a>(reason: ErrorKind, field: String) -> a / {otlp.fail} = fail(reason, -1, field)

fn member(o: Members, name: String) -> Option<Json> =
  match o.get(name) { Some(Null) -> None, other -> other }

fn members_of(j: Json, field: String) -> Members / {otlp.fail} =
  match j { json::Object(m) -> m, _ -> fail_field(WrongKind("an object"), field) }

fn members_in(o: Members, name: String) -> Members / {otlp.fail} =
  match member(o, name) { Some(j) -> members_of(j, name), None -> Map::new() }

fn items_in(o: Members, name: String) -> List<Json> / {otlp.fail} =
  match member(o, name) {
    Some(json::Array(items)) -> items,
    Some(_) -> fail_field(WrongKind("an array"), name),
    None -> [],
  }

fn text_in(o: Members, name: String) -> String / {otlp.fail} =
  match member(o, name) {
    Some(Str(s)) -> s,
    Some(_) -> fail_field(WrongKind("a string"), name),
    None -> "",
  }

fn all_digits(raw: Bytes) -> Bool =
  raw.len() > 0 && raw.scan(0, b"0123456789", raw.len()) >= raw.len()

fn whole_text(j: Json, field: String) -> String / {otlp.fail} =
  match j {
    Str(s) -> s,
    Number(d) -> d.to_string(),
    _ -> fail_field(WrongKind("a whole number, as a string of digits or a number"), field),
  }

fn u64_of_json(j: Json, field: String) -> U64 / {otlp.fail, abort.raise} = {
  let digits = whole_text(j, field);
  if !all_digits(Bytes::of_string(digits)) || digits.len() > 20 { fail_field(BadNumber, field) }
  else {
    match U128::of_string(digits) {
      Some(n) -> if n > 18446744073709551615u128 { fail_field(BadNumber, field) } else {
        U64::of_int(Int::of_u128(n / 4294967296u128)) << 32
          | U64::of_int(Int::of_u128(n % 4294967296u128))
      },
      None -> fail_field(BadNumber, field),
    }
  }
}

fn u64_in(o: Members, name: String) -> U64 / {otlp.fail, abort.raise} =
  match member(o, name) { Some(j) -> u64_of_json(j, name), None -> 0u64 }

fn int_of_json(j: Json, field: String) -> Int / {otlp.fail, abort.raise} = {
  let written = whole_text(j, field);
  let raw = Bytes::of_string(written);
  let negative = raw.starts_with(b"-");
  let digits = if negative { raw.slice(1, raw.len()) } else { raw };
  if !all_digits(digits) || digits.len() > 19 { fail_field(BadNumber, field) } else {
    match I128::of_string(written) {
      Some(n) -> if n > 9223372036854775807i128 || n < 0i128 - 9223372036854775808i128 {
        fail_field(BadNumber, field)
      } else { Int::of_i128(n) },
      None -> fail_field(BadNumber, field),
    }
  }
}

fn int_in(o: Members, name: String) -> Int / {otlp.fail, abort.raise} =
  match member(o, name) { Some(j) -> int_of_json(j, name), None -> 0 }

fn u32_in(o: Members, name: String) -> U32 / {otlp.fail, abort.raise} =
  match member(o, name) {
    None -> 0u32,
    Some(j) -> {
      let n = int_of_json(j, name);
      if n < 0 || n > 4294967295 { fail_field(BadNumber, name) } else { U32::of_int(n) }
    },
  }

fn enum_in(o: Members, name: String) -> Int / {otlp.fail, abort.raise} =
  match member(o, name) {
    None -> 0,
    Some(Number(d)) -> int_of_json(Number(d), name),
    Some(_) -> fail_field(WrongKind("an enum's number"), name),
  }

fn double_of_json(j: Json, field: String) -> Float / {otlp.fail} =
  match j {
    Number(d) -> Float::of_decimal(d),
    Str("NaN") -> Float::nan(),
    Str("Infinity") -> Float::infinity(),
    Str("-Infinity") -> Float::neg_infinity(),
    Str(s) -> match Float::of_string(s) {
      Some(f) -> f,
      None -> fail_field(WrongKind("a number"), field),
    },
    _ -> fail_field(WrongKind("a number"), field),
  }

fn optional_double_in(o: Members, name: String) -> Option<Float> / {otlp.fail} =
  match member(o, name) { Some(j) -> Some(double_of_json(j, name)), None -> None }

fn bool_in(o: Members, name: String) -> Bool / {otlp.fail} =
  match member(o, name) {
    Some(json::Bool(b)) -> b,
    Some(_) -> fail_field(WrongKind("true or false"), name),
    None -> false,
  }

fn hex_in(o: Members, name: String) -> Bytes / {otlp.fail} = {
  let written = text_in(o, name).ascii_lower();
  match try[abort.raise] { Bytes::of_hex(written) } {
    Ok(raw) -> raw,
    Err(_) -> fail_field(BadText, name),
  }
}

fn value_of_json(j: Json, depth_left: Int) -> AnyValue / {otlp.fail, abort.raise} =
  if depth_left <= 0 { fail_field(TooDeep, "value") } else {
    let o = members_of(j, "value");
    match ((member(o, "stringValue"), member(o, "boolValue"), member(o, "intValue"))) {
      (Some(Str(s)), _, _) -> StringValue(s),
      (Some(_), _, _) -> fail_field(WrongKind("a string"), "stringValue"),
      (_, Some(json::Bool(b)), _) -> BoolValue(b),
      (_, Some(_), _) -> fail_field(WrongKind("true or false"), "boolValue"),
      (_, _, Some(n)) -> IntValue(int_of_json(n, "intValue")),
      _ -> compound_of_json(o, depth_left - 1),
    }
  }

fn compound_of_json(o: Members, depth_left: Int) -> AnyValue / {otlp.fail, abort.raise} =
  match member(o, "doubleValue") {
    Some(f) -> DoubleValue(double_of_json(f, "doubleValue")),
    None -> match member(o, "arrayValue") {
      Some(array_value) ->
        ArrayValue(
          items_in(members_of(array_value, "arrayValue"), "values").map(|x: Json|
            value_of_json(x, depth_left)),
        ),
      None -> match member(o, "kvlistValue") {
        Some(kvlist_value) ->
          KvlistValue(
            key_values_of_json(members_of(kvlist_value, "kvlistValue"), "values", depth_left),
          ),
        None -> match member(o, "bytesValue") {
          Some(Str(string_if_set)) -> match base64_decode(string_if_set) {
            Some(raw) -> BytesValue(raw),
            None -> fail_field(BadText, "bytesValue"),
          },
          Some(_) -> fail_field(WrongKind("a string of base64"), "bytesValue"),
          None -> NoValue,
        },
      },
    },
  }

fn key_values_of_json(
  o: Members,
  name: String,
  depth_left: Int,
) -> List<KeyValue> / {otlp.fail, abort.raise} =
  items_in(o, name).map(|j: Json| -> KeyValue {
    let key_value = members_of(j, name);
    {
      key: text_in(key_value, "key"),
      value: match member(key_value, "value") {
        Some(v) -> value_of_json(v, depth_left),
        None -> NoValue,
      },
    }
  })

fn resource_of_json(o: Members, depth_left: Int) -> Resource / {otlp.fail, abort.raise} =
  {
    attributes: key_values_of_json(o, "attributes", depth_left),
    dropped_attributes: u32_in(o, "droppedAttributesCount"),
  }

fn scope_of_json(o: Members, depth_left: Int) -> Scope / {otlp.fail, abort.raise} =
  {
    name: text_in(o, "name"),
    version: text_in(o, "version"),
    attributes: key_values_of_json(o, "attributes", depth_left),
    dropped_attributes: u32_in(o, "droppedAttributesCount"),
  }

fn status_of_json(o: Members) -> Status / {otlp.fail, abort.raise} =
  { code: code_of(enum_in(o, "code"), -1), message: text_in(o, "message") }

fn event_of_json(j: Json, depth_left: Int) -> Event / {otlp.fail, abort.raise} = {
  let o = members_of(j, "events");
  {
    time: u64_in(o, "timeUnixNano"),
    name: text_in(o, "name"),
    attributes: key_values_of_json(o, "attributes", depth_left),
    dropped_attributes: u32_in(o, "droppedAttributesCount"),
  }
}

fn link_of_json(j: Json, depth_left: Int) -> Link / {otlp.fail, abort.raise} = {
  let o = members_of(j, "links");
  {
    trace_id: trace_id_of(hex_in(o, "traceId"), -1),
    span_id: span_id_of(hex_in(o, "spanId"), -1, "spanId"),
    trace_state: text_in(o, "traceState"),
    attributes: key_values_of_json(o, "attributes", depth_left),
    dropped_attributes: u32_in(o, "droppedAttributesCount"),
    flags: u32_in(o, "flags"),
  }
}

fn span_of_json(j: Json, depth_left: Int) -> Span / {otlp.fail, abort.raise} = {
  let o = members_of(j, "spans");
  {
    trace_id: trace_id_of(hex_in(o, "traceId"), -1),
    span_id: span_id_of(hex_in(o, "spanId"), -1, "spanId"),
    trace_state: text_in(o, "traceState"),
    parent: parent_of(hex_in(o, "parentSpanId"), -1),
    flags: u32_in(o, "flags"),
    name: text_in(o, "name"),
    kind: kind_of(enum_in(o, "kind"), -1),
    start: u64_in(o, "startTimeUnixNano"),
    end: u64_in(o, "endTimeUnixNano"),
    attributes: key_values_of_json(o, "attributes", depth_left),
    dropped_attributes: u32_in(o, "droppedAttributesCount"),
    events: items_in(o, "events").map(|e: Json| event_of_json(e, depth_left)),
    dropped_events: u32_in(o, "droppedEventsCount"),
    links: items_in(o, "links").map(|l: Json| link_of_json(l, depth_left)),
    dropped_links: u32_in(o, "droppedLinksCount"),
    status: status_of_json(members_in(o, "status")),
  }
}

fn traces_of_json(j: Json, depth_left: Int) -> Traces / {otlp.fail, abort.raise} =
  {
    resource_spans: items_in(members_of(j, ""), "resourceSpans").map(|r: Json| -> ResourceSpans {
      let o = members_of(r, "resourceSpans");
      {
        resource: resource_of_json(members_in(o, "resource"), depth_left),
        scope_spans: items_in(o, "scopeSpans").map(|s: Json| -> ScopeSpans {
          let scope_members = members_of(s, "scopeSpans");
          {
            scope: scope_of_json(members_in(scope_members, "scope"), depth_left),
            spans: items_in(scope_members, "spans").map(|x: Json| span_of_json(x, depth_left)),
            schema_url: text_in(scope_members, "schemaUrl"),
          }
        }),
        schema_url: text_in(o, "schemaUrl"),
      }
    }),
  }

fn number_point_of_json(j: Json, depth_left: Int) -> NumberPoint / {otlp.fail, abort.raise} = {
  let o = members_of(j, "dataPoints");
  {
    attributes: key_values_of_json(o, "attributes", depth_left),
    start: u64_in(o, "startTimeUnixNano"),
    time: u64_in(o, "timeUnixNano"),
    value: match ((member(o, "asDouble"), member(o, "asInt"))) {
      (Some(f), _) -> AsDouble(double_of_json(f, "asDouble")),
      (_, Some(n)) -> AsInt(int_of_json(n, "asInt")),
      _ -> fail_field(Missing("value"), "asDouble"),
    },
  }
}

fn histogram_point_of_json(j: Json, depth_left: Int) -> HistogramPoint / {otlp.fail, abort.raise} = {
  let o = members_of(j, "dataPoints");
  {
    attributes: key_values_of_json(o, "attributes", depth_left),
    start: u64_in(o, "startTimeUnixNano"),
    time: u64_in(o, "timeUnixNano"),
    count: u64_in(o, "count"),
    sum: optional_double_in(o, "sum"),
    bucket_counts: items_in(o, "bucketCounts").map(|n: Json| u64_of_json(n, "bucketCounts")),
    explicit_bounds: items_in(o, "explicitBounds").map(|x: Json|
      double_of_json(x, "explicitBounds")),
    min: optional_double_in(o, "min"),
    max: optional_double_in(o, "max"),
  }
}

fn data_of_json(o: Members, depth_left: Int) -> Data / {otlp.fail, abort.raise} =
  match ((member(o, "gauge"), member(o, "sum"), member(o, "histogram"))) {
    (Some(g), _, _) ->
      Gauge(
        items_in(members_of(g, "gauge"), "dataPoints").map(|p: Json|
          number_point_of_json(p, depth_left)),
      ),
    (_, Some(s), _) -> {
      let sum_members = members_of(s, "sum");
      Sum(
        items_in(sum_members, "dataPoints").map(|p: Json| number_point_of_json(p, depth_left)),
        temporality_of(enum_in(sum_members, "aggregationTemporality"), -1),
        bool_in(sum_members, "isMonotonic"),
      )
    },
    (_, _, Some(h)) -> {
      let histogram_members = members_of(h, "histogram");
      Histogram(
        items_in(histogram_members, "dataPoints").map(|p: Json|
          histogram_point_of_json(p, depth_left)),
        temporality_of(enum_in(histogram_members, "aggregationTemporality"), -1),
      )
    },
    _ -> if o.contains("exponentialHistogram") {
      fail_field(Unsupported("exponential_histogram"), "exponentialHistogram")
    } else if o.contains("summary") { fail_field(Unsupported("summary"), "summary") }
    else { fail_field(Missing("data"), "data") },
  }

fn metrics_of_json(j: Json, depth_left: Int) -> Metrics / {otlp.fail, abort.raise} =
  {
    resource_metrics: items_in(members_of(j, ""), "resourceMetrics").map(
      |r: Json| -> ResourceMetrics {
        let o = members_of(r, "resourceMetrics");
        {
          resource: resource_of_json(members_in(o, "resource"), depth_left),
          scope_metrics: items_in(o, "scopeMetrics").map(|s: Json| -> ScopeMetrics {
            let scope_members = members_of(s, "scopeMetrics");
            {
              scope: scope_of_json(members_in(scope_members, "scope"), depth_left),
              metrics: items_in(scope_members, "metrics").map(|x: Json| -> Metric {
                let m = members_of(x, "metrics");
                {
                  name: text_in(m, "name"),
                  description: text_in(m, "description"),
                  unit: text_in(m, "unit"),
                  data: data_of_json(m, depth_left),
                }
              }),
              schema_url: text_in(scope_members, "schemaUrl"),
            }
          }),
          schema_url: text_in(o, "schemaUrl"),
        }
      },
    ),
  }

fn response_of_json(signal: Signal, j: Json) -> ExportResponse / {otlp.fail, abort.raise} = {
  let partial = members_in(members_of(j, ""), "partialSuccess");
  { rejected: int_in(partial, rejected_name(signal)), message: text_in(partial, "errorMessage") }
}

/// What an exporter has done so far.
pub type Stats = new {
  /// Spans a collector accepted.
  exported: Int,
  /// Spans that ended while the queue was full.
  dropped: Int,
  /// Spans in requests that were abandoned: rejected outright, or failed `attempts` times.
  failed: Int,
  /// Spans a collector reported it had rejected.
  rejected: Int,
  /// Spans that ended in a trace that is not recorded.
  unsampled: Int,
  /// Requests, of spans or of metrics, that a collector reported as successful.
  requests: Int,
  /// Requests sent again after a failure that may be temporary.
  retries: Int,
  /// Label sets rejected because their metric already had `max_series`.
  series_dropped: Int,
  /// `trace.exit` of a span that was not open.
  unmatched_exits: Int,
  /// Spans waiting to be sent, including those of a request waiting to be sent again.
  queued: Int,
}

/// How an exporter sends telemetry.
pub type Config = new {
  /// The collector's host, as `net.connect` takes one.
  host: String,
  port: Int,
  /// Whether to connect over TLS.
  tls: Bool,
  /// What comes before `/v1/traces` in the collector's paths. Empty when it serves from the root.
  prefix: String,
  /// Header fields every request carries, such as `Authorization`.
  headers: http::Headers,
  encoding: Encoding,
  /// Whether a request's body is gzipped.
  gzip: Bool,
  resource: Resource,
  /// How a trace that starts in this process is sampled; a span under a parent takes its
  /// parent's decision.
  sampler: Sampler,
  /// The most finished spans that may wait. A span that ends when the queue is full is dropped
  /// and counted.
  queue: Int,
  /// The most spans one request carries. Once this many spans are queued, a request is sent.
  batch: Int,
  /// How long, in milliseconds, a span waits before a request is due whatever the count.
  max_age_ms: Int,
  /// How often, in milliseconds, the metrics are sent.
  metrics_every_ms: Int,
  /// The most label sets one metric tracks. A new one past that is dropped and counted.
  max_series: Int,
  /// How many times one request is sent before the exporter gives up on it.
  attempts: Int,
  /// The wait before a first retry, in milliseconds; it doubles with each one.
  backoff_ms: Int,
  /// The longest wait before a retry.
  max_backoff_ms: Int,
  /// How long, in milliseconds, a flush may take. Anything still waiting after it stays queued.
  flush_ms: Int,
  /// The upper bounds, in seconds, of the histogram buckets that durations are counted in.
  bounds: List<Float>,
  /// The deadlines of one request, and the most bytes of a reply.
  limits: http::Limits,
}

/// Returns a configuration for the service `service` that exports to the collector at `host` and
/// `port` over plain HTTP using protobuf. The other fields get OpenTelemetry's SDK defaults: every
/// trace is recorded, the queue holds 2048 spans, a request carries up to 512 spans and is sent
/// after at most five seconds, and metrics are sent every minute. A request is tried up to five
/// times, waiting between one and thirty seconds before each retry. Requests time out after ten
/// seconds and a flush after thirty.
pub fn config(service: String, host: String, port: Int) -> Config = {
  let base: http::Limits = http::default_limits();
  {
    host: host,
    port: port,
    tls: false,
    prefix: "",
    headers: http::empty_headers(),
    encoding: Protobuf,
    gzip: false,
    resource: {
      attributes: [
        attribute(telemetry::service_name(), StringValue(service)),
        attribute(telemetry::telemetry_sdk_name(), StringValue("ply")),
        attribute(telemetry::telemetry_sdk_language(), StringValue("ply")),
      ],
      dropped_attributes: 0u32,
    },
    sampler: telemetry::AlwaysOn,
    queue: 2048,
    batch: 512,
    max_age_ms: 5000,
    metrics_every_ms: 60000,
    max_series: 2000,
    attempts: 5,
    backoff_ms: 1000,
    max_backoff_ms: 30000,
    flush_ms: 30000,
    bounds: telemetry::duration_bounds(),
    limits: {
      ..base,
      connect_timeout_ms: 10000,
      header_timeout_ms: 10000,
      body_timeout_ms: 10000,
      write_timeout_ms: 10000,
    },
  }
}

type OpenSpan = {
  id: Int,
  channel: String,
  name: String,
  who: telemetry::Identity,
  start: U64,
  fields: Fields,
}

type EndedSpan = { channel: String, span: Span }

type Outbound = { signal: Signal, body: Bytes, items: Int, attempts: Int, not_before: Int }

type Tally = | Count(Int, Bool) | Level(Float) | Timing(List<Int>, Float, Float, Float)

type Series = { channel: String, name: String, fields: Fields, value: Tally }

type State = {
  open: List<OpenSpan>,
  next: Int,
  queue: List<EndedSpan>,
  queued_at: Int,
  pending: Option<Outbound>,
  busy: Bool,
  series: Map<String, Series>,
  widths: Map<String, Int>,
  dirty: Bool,
  metrics_at: Int,
  started: U64,
  stats: Stats,
}

fn initial_state(started: U64, now_ms: Int) -> State =
  {
    open: [],
    next: 1,
    queue: [],
    queued_at: now_ms,
    pending: None,
    busy: false,
    series: Map::new(),
    widths: Map::new(),
    dirty: false,
    metrics_at: now_ms,
    started: started,
    stats: {
      exported: 0,
      dropped: 0,
      failed: 0,
      rejected: 0,
      unsampled: 0,
      requests: 0,
      retries: 0,
      series_dropped: 0,
      unmatched_exits: 0,
      queued: 0,
    },
  }

fn stats_of(s: State) -> Stats =
  {
    ..s.stats,
    queued: s.queue.len()
      + (match s.pending {
        Some(waiting) -> match waiting.signal { TraceSignal -> waiting.items, MetricSignal -> 0 },
        None -> 0,
      }),
  }

fn nanos_now(wall_ms: Int, mono_us: Int, now_us: Int) -> U64 =
  match try[abort.raise] { U64::of_int(max(wall_ms * 1000 + (now_us - mono_us), 0) * 1000) } {
    Ok(n) -> n,
    Err(_) -> 0u64,
  }

fn opened(
  s: State,
  channel: String,
  name: String,
  who: telemetry::Identity,
  fields: Fields,
  at: U64,
) -> State =
  {
    ..s,
    next: s.next + 1,
    open: [
      { id: s.next, channel: channel, name: name, who: who, start: at, fields: fields },
    ].concat(
      s.open,
    ),
  }

fn value_of_field(f: trace::Field) -> AnyValue / {abort.raise} =
  match f {
    trace::IntField(n) -> IntValue(n),
    trace::BoolField(b) -> BoolValue(b),
    trace::StringField(s) -> StringValue(s),
    trace::FloatField(x) -> DoubleValue(x),
    trace::DecimalField(d) -> DoubleValue(Float::of_decimal(d)),
    trace::BytesField(b) -> BytesValue(b),
    trace::JsonField(j) -> StringValue(json::to_string(j)),
  }

fn attributes_of(fields: Fields) -> List<KeyValue> / {abort.raise} =
  fields.entries().map(|e: { key: String, value: trace::Field }| -> KeyValue {
    { key: e.key, value: value_of_field(e.value) }
  })

fn kind_from(kind: telemetry::Kind) -> SpanKind =
  match kind {
    telemetry::Internal -> Internal,
    telemetry::Server -> Server,
    telemetry::Client -> Client,
    telemetry::Producer -> Producer,
    telemetry::Consumer -> Consumer,
  }

fn status_for(outcome: trace::Outcome) -> Status =
  match outcome {
    trace::Ok -> unset(),
    trace::Failed(reason) -> { code: StatusError, message: reason },
    trace::Abandoned -> { code: StatusError, message: "abandoned" },
  }

fn finished(o: OpenSpan, outcome: trace::Outcome, at: U64) -> EndedSpan / {abort.raise} = {
  let context = o.who.context;
  {
    channel: o.channel,
    span: {
      trace_id: context.parent.trace_id,
      span_id: context.parent.parent_id,
      trace_state: traceparent::render_state(context.state),
      parent: o.who.parent,
      flags: U32::of_int(context.parent.flags & 0xFF),
      name: o.name,
      kind: kind_from(o.who.kind),
      start: o.start,
      end: at,
      attributes: attributes_of(o.fields),
      dropped_attributes: 0u32,
      events: [],
      dropped_events: 0u32,
      links: [],
      dropped_links: 0u32,
      status: status_for(outcome),
    },
  }
}

fn is_sampled(o: OpenSpan) -> Bool = traceparent::sampled(o.who.context.parent)

fn queued(s: State, config: Config, done: EndedSpan, now_ms: Int) -> State =
  if s.queue.len() >= max(config.queue, 1) {
    { ..s, stats: { ..s.stats, dropped: s.stats.dropped + 1 } }
  } else {
    {
      ..s,
      queue: s.queue.push(done),
      queued_at: if s.queue.len() == 0 { now_ms } else { s.queued_at },
    }
  }

type ClosingSpans = { closing: List<SpanId>, still_open: List<OpenSpan>, state: State }

fn closed(
  s: State,
  config: Config,
  span: trace::Span,
  outcome: trace::Outcome,
  at: U64,
  now_ms: Int,
) -> State / {abort.raise} =
  match s.open.find(|o: OpenSpan| o.id == span.id && o.channel == span.channel) {
    None -> { ..s, stats: { ..s.stats, unmatched_exits: s.stats.unmatched_exits + 1 } },
    Some(target) -> {
      let start: ClosingSpans = {
        closing: [target.who.context.parent.parent_id],
        still_open: [],
        state: s,
      };
      let swept = s.open.reverse().fold(
        start,
        |accumulator: ClosingSpans, o: OpenSpan| -> ClosingSpans {
          let under = match o.who.parent {
            Some(p) -> accumulator.closing.contains(p),
            None -> false,
          };
          if o.id == target.id {
            { ..accumulator, state: ended(accumulator.state, config, o, outcome, at, now_ms) }
          } else if under {
            {
              closing: accumulator.closing.push(o.who.context.parent.parent_id),
              still_open: accumulator.still_open,
              state: ended(accumulator.state, config, o, trace::Abandoned, at, now_ms),
            }
          } else { { ..accumulator, still_open: accumulator.still_open.push(o) } }
        },
      );
      { ..swept.state, open: swept.still_open.reverse() }
    },
  }

fn ended(
  s: State,
  config: Config,
  o: OpenSpan,
  outcome: trace::Outcome,
  at: U64,
  now_ms: Int,
) -> State / {abort.raise} =
  if is_sampled(o) { queued(s, config, finished(o, outcome, at), now_ms) }
  else { { ..s, stats: { ..s.stats, unsampled: s.stats.unsampled + 1 } } }

fn annotated(s: State, span: SpanId, fields: Fields) -> State =
  {
    ..s,
    open: s.open.map(|o: OpenSpan|
      if o.who.context.parent.parent_id == span { { ..o, fields: o.fields.merge(fields) } }
      else { o }),
  }

fn update_series(
  s: State,
  config: Config,
  channel: String,
  kind: String,
  name: String,
  fields: Fields,
  step: (Option<Tally>) -> Tally,
) -> State = {
  let metric = channel ++ "\u{0}" ++ kind ++ "\u{0}" ++ name;
  let key = metric ++ "\u{0}" ++ show(fields);
  match s.series.get(key) {
    Some(existing_series) ->
      {
        ..s,
        dirty: true,
        series: s.series.insert(key, {
          ..existing_series,
          value: step(Some(existing_series.value)),
        }),
      },
    None -> {
      let width = match s.widths.get(metric) { Some(n) -> n, None -> 0 };
      if width >= max(config.max_series, 1) {
        { ..s, stats: { ..s.stats, series_dropped: s.stats.series_dropped + 1 } }
      } else {
        {
          ..s,
          dirty: true,
          widths: s.widths.insert(metric, width + 1),
          series: s.series.insert(key, {
            channel: channel,
            name: name,
            fields: fields,
            value: step(None),
          }),
        }
      }
    },
  }
}

fn add_count(previous_tally: Option<Tally>, delta: Int) -> Tally =
  match previous_tally {
    Some(Count(total, rising)) -> Count(total + delta, rising && delta >= 0),
    _ -> Count(delta, delta >= 0),
  }

fn add_timing(previous_tally: Option<Tally>, bounds: List<Float>, seconds: Float) -> Tally =
  match previous_tally {
    Some(Timing(counts, sum, least, greatest)) ->
      Timing(
        telemetry::add_to_buckets(bounds, counts, seconds),
        sum + seconds,
        if seconds < least { seconds } else { least },
        if seconds > greatest { seconds } else { greatest },
      ),
    _ -> Timing(telemetry::add_to_buckets(bounds, [], seconds), seconds, seconds, seconds),
  }

fn u64_of_int(n: Int) -> U64 =
  match try[abort.raise] { U64::of_int(max(n, 0)) } { Ok(w) -> w, Err(_) -> 0u64 }

fn metric_of_series(
  config: Config,
  series: Series,
  started: U64,
  at: U64,
) -> Metric / {abort.raise} = {
  let attributes = attributes_of(series.fields);
  match series.value {
    Count(total, rising) ->
      {
        name: series.name,
        description: "",
        unit: "",
        data: Sum(
          [{ attributes: attributes, start: started, time: at, value: AsInt(total) }],
          Cumulative,
          rising,
        ),
      },
    Level(level) ->
      {
        name: series.name,
        description: "",
        unit: "",
        data: Gauge([{ attributes: attributes, start: 0u64, time: at, value: AsDouble(level) }]),
      },
    Timing(counts, sum, least, greatest) ->
      {
        name: series.name,
        description: "",
        unit: "s",
        data: Histogram(
          [
            {
              attributes: attributes,
              start: started,
              time: at,
              count: u64_of_int(counts.fold(0, |n: Int, c: Int| n + c)),
              sum: Some(sum),
              bucket_counts: counts.map(u64_of_int),
              explicit_bounds: config.bounds,
              min: Some(least),
              max: Some(greatest),
            },
          ],
          Cumulative,
        ),
      },
  }
}

fn joined_data(a: Data, b: Data) -> Option<Data> =
  match ((a, b)) {
    (Gauge(xs), Gauge(ys)) -> Some(Gauge(xs.concat(ys))),
    (Sum(xs, t, rising), Sum(ys, _, also)) -> Some(Sum(xs.concat(ys), t, rising && also)),
    (Histogram(xs, t), Histogram(ys, _)) -> Some(Histogram(xs.concat(ys), t)),
    _ -> None,
  }

fn with_metric(metrics: List<Metric>, m: Metric) -> List<Metric> =
  match metrics.last() {
    Some(before) -> match ((before.name == m.name, joined_data(before.data, m.data))) {
      (true, Some(data)) -> metrics.take(metrics.len() - 1).push({ ..before, data: data }),
      _ -> metrics.push(m),
    },
    None -> [m],
  }

fn with_scoped(scopes: List<ScopeMetrics>, channel: String, m: Metric) -> List<ScopeMetrics> =
  match scopes.last() {
    Some(before) -> if before.scope.name == channel {
      scopes.take(scopes.len() - 1).push({ ..before, metrics: with_metric(before.metrics, m) })
    } else { scopes.push({ scope: scope(channel), metrics: [m], schema_url: "" }) },
    None -> [{ scope: scope(channel), metrics: [m], schema_url: "" }],
  }

fn metrics_request(config: Config, s: State, at: U64) -> Metrics / {abort.raise} =
  {
    resource_metrics: [
      {
        resource: config.resource,
        scope_metrics: s.series.values().fold([], |scopes: List<ScopeMetrics>, series: Series|
          with_scoped(scopes, series.channel, metric_of_series(config, series, s.started, at))),
        schema_url: "",
      },
    ],
  }

fn traces_request(config: Config, batch: List<EndedSpan>) -> Traces =
  {
    resource_spans: [
      {
        resource: config.resource,
        scope_spans: batch.fold(
          [],
          |scopes: List<ScopeSpans>, done: EndedSpan| -> List<ScopeSpans> {
            if scopes.any(|scope_spans: ScopeSpans| scope_spans.scope.name == done.channel) {
              scopes.map(|scope_spans: ScopeSpans|
                if scope_spans.scope.name == done.channel {
                  { ..scope_spans, spans: scope_spans.spans.push(done.span) }
                } else { scope_spans })
            } else {
              scopes.push({ scope: scope(done.channel), spans: [done.span], schema_url: "" })
            }
          },
        ),
        schema_url: "",
      },
    ],
  }

fn compressed(config: Config, body: Bytes) -> Bytes / {abort.raise} =
  if config.gzip { gzip::gzip(body) } else { body }

type Plan = { state: State, send: Option<Outbound>, wait_ms: Int }

fn planned(s: State, config: Config, now_ms: Int, at: U64, force: Bool) -> Plan / {abort.raise} =
  if s.busy { { state: s, send: None, wait_ms: 0 } } else {
    match s.pending {
      Some(waiting) -> if force || now_ms >= waiting.not_before {
        {
          state: { ..s, pending: None, busy: true },
          send: Some(waiting),
          wait_ms: max(waiting.not_before - now_ms, 0),
        }
      } else { { state: s, send: None, wait_ms: 0 } },
      None -> {
        let size = max(config.batch, 1);
        let waiting = s.queue.len();
        if waiting >= size
            || (waiting > 0 && (force || now_ms - s.queued_at >= config.max_age_ms)) {
          let batch = s.queue.take(size);
          {
            state: { ..s, queue: s.queue.drop(size), queued_at: now_ms, busy: true },
            send: Some({
              signal: TraceSignal,
              body: compressed(
                config,
                encode_traces(config.encoding, traces_request(config, batch)),
              ),
              items: batch.len(),
              attempts: 0,
              not_before: now_ms,
            }),
            wait_ms: 0,
          }
        } else if s.dirty && (force || now_ms - s.metrics_at >= config.metrics_every_ms) {
          {
            state: { ..s, dirty: false, metrics_at: now_ms, busy: true },
            send: Some({
              signal: MetricSignal,
              body: compressed(
                config,
                encode_metrics(config.encoding, metrics_request(config, s, at)),
              ),
              items: 0,
              attempts: 0,
              not_before: now_ms,
            }),
            wait_ms: 0,
          }
        } else { { state: s, send: None, wait_ms: 0 } }
      },
    }
  }

type SendOutcome = | Accepted(ExportResponse) | Retryable(Option<Int>) | Rejected

/// Returns how many milliseconds to wait before retry number `attempt` (the first retry is 1). The
/// wait starts at `config.backoff_ms`, doubles for each earlier retry, and is limited to
/// `config.max_backoff_ms`. It is then reduced by a random amount: `draw` (0 to 999) picks a point
/// between half of that wait and all of it. If `retry_after_ms` is longer, it is returned instead.
pub fn retry_wait(config: Config, attempt: Int, retry_after_ms: Option<Int>, draw: Int) -> Int = {
  let doubled = range(1, min(max(attempt, 1), 32)).fold(
    max(config.backoff_ms, 0),
    |wait: Int, _: Int| min(wait * 2, max(config.max_backoff_ms, 0)),
  );
  let capped = min(doubled, max(config.max_backoff_ms, 0));
  let jittered = capped / 2 + capped / 2 * min(max(draw, 0), 999) / 1000;
  match retry_after_ms { Some(retry_after) -> max(retry_after, jittered), None -> jittered }
}

fn record_outcome(
  s: State,
  config: Config,
  out: Outbound,
  how: SendOutcome,
  now_ms: Int,
  draw: Int,
) -> State = {
  let free = { ..s, busy: false };
  let lost = |state: State| -> State {
    match out.signal {
      TraceSignal -> { ..state, stats: { ..state.stats, failed: state.stats.failed + out.items } },
      MetricSignal -> { ..state, dirty: true },
    }
  };
  match how {
    Accepted(receipt) ->
      {
        ..free,
        stats: {
          ..free.stats,
          requests: free.stats.requests + 1,
          exported: free.stats.exported + max(out.items - max(receipt.rejected, 0), 0),
          rejected: free.stats.rejected + min(max(receipt.rejected, 0), out.items),
        },
      },
    Rejected -> lost(free),
    Retryable(retry_after) -> if out.attempts + 1 >= max(config.attempts, 1) { lost(free) } else {
      {
        ..free,
        pending: Some({
          ..out,
          attempts: out.attempts + 1,
          not_before: now_ms + retry_wait(config, out.attempts + 1, retry_after, draw),
        }),
        stats: { ..free.stats, retries: free.stats.retries + 1 },
      }
    },
  }
}

fn retry_after(headers: http::Headers) -> Option<Int> =
  match http::header(headers, "retry-after") {
    Some(string_if_set) -> match try[abort.raise] {
        Bytes::of_string(string_if_set.ascii_trim()).int_of_ascii()
      } {
      Ok(Some(seconds)) -> if seconds > 86400 { Some(86400000) } else { Some(seconds * 1000) },
      _ -> None,
    },
    None -> None,
  }

fn outcome_of(
  config: Config,
  signal: Signal,
  response: http::Response<| {}>,
) -> SendOutcome / {abort.raise} =
  if response.status >= 200 && response.status < 300 {
    Accepted(
      match decode_response(
          config.encoding,
          signal,
          http::whole_bytes(response.body),
          default_limits(),
        ) {
        Ok(receipt) -> receipt,
        Err(_) -> { rejected: 0, message: "" },
      },
    )
  } else if response.status == 429 || response.status == 502 || response.status == 503
      || response.status == 504 { Retryable(retry_after(response.headers)) }
  else { Rejected }

fn request_of(config: Config, out: Outbound) -> http::Request / {abort.raise} = {
  let path = config.prefix
    ++ (match out.signal { TraceSignal -> traces_path(), MetricSignal -> metrics_path() });
  let request = http::request_to(
    http::Post,
    config.host ++ ":" ++ config.port.to_string(),
    path,
    out.body,
  );
  let typed = http::set_header(config.headers, "content-type", content_type(config.encoding));
  {
    ..request,
    headers: if config.gzip { http::set_header(typed, "content-encoding", "gzip") } else { typed },
  }
}

fn request_collector<[l]>(
  config: Config,
  out: Outbound,
) -> Result<http::Response<| {}>, http::ClientError> / {net.connect[l], net.connect_tls[l], net.send[l], net.recv[l], net.close[l], abort.raise} =
  if config.tls {
    match http::dial_tls[l](config.host, config.port, config.limits) {
      Err(e) -> Err(e),
      Ok(connection) ->
        bracket(|| connection, |c: http::Connection| http::close[l](c), |c: http::Connection|
          http::round_trip_last[l](c, request_of(config, out), config.limits)),
    }
  } else { http::request[l](config.host, config.port, request_of(config, out), config.limits) }

fn send_request<[l]>(
  config: Config,
  out: Outbound,
) -> SendOutcome / {net.connect[l], net.connect_tls[l], net.send[l], net.recv[l], net.close[l]} =
  match try[abort.raise] {
      match request_collector[l](config, out) {
        Ok(response) -> outcome_of(config, out.signal, response),
        Err(_) -> Retryable(None),
      }
    } {
    Ok(how) -> how,
    Err(_) -> Rejected,
  }

/// The effects an exporter performs besides `net`: reading the clocks, sleeping, and drawing random
/// numbers for ids and jitter.
pub effect set Exporting = {time.now_ms, time.elapsed_ms, time.elapsed_us, time.sleep_ms, entropy.next, entropy.below}

/// Runs `body` and sends its spans, counters, gauges and timings to the collector that `config`
/// describes. `exporting[collector](config, ..)` performs `net` only on the effect label
/// `collector`, so the caller chooses where telemetry goes by what it binds to that label.
///
/// It handles every `trace.enter`, `trace.exit`, `trace.count`, `trace.gauge` and `trace.time` that
/// `body` performs, on any channel, and `std.telemetry`'s `tracing`. `trace.event` is passed on to
/// whatever handles it outside. A span's channel is its instrumentation scope. A span opened by
/// `std.telemetry` carries its own parent. Any other span becomes a child of the most recently
/// opened span that is still open. That is one stack for the whole program, not one per task, so
/// tasks that open spans concurrently should use `in_span`.
///
/// An event never waits on the collector. A span that ends while `config.queue` spans are already
/// waiting is dropped and counted. When an event makes a request due, by item count or by age, the
/// task that raised the event sends the request itself, within the deadlines of `config.limits`;
/// other events are only queued or counted meanwhile. A request that fails in a way that may be
/// temporary (no reply, or a 429, 502, 503 or 504) is sent again by a later event once its backoff
/// has passed, up to `config.attempts` times in all. A collector failure never raises. There is no
/// timer: age and backoff are checked only when the program next traces something. A `Retry-After`
/// header is honoured as a number of seconds; a date is not parsed.
///
/// `flush` sends everything waiting, sleeping through backoffs when needed, for at most
/// `config.flush_ms`. `exporting` does the same when `body` ends, whether it returns or fails.
pub fn exporting<a, [l] | e>(
  config: Config,
  body: () -> a / {trace.enter[*], trace.exit[*], trace.count[*], trace.gauge[*], trace.time[*], Tracing, otlp.flush, otlp.stats | e},
) -> a / {net.connect[l], net.connect_tls[l], net.send[l], net.recv[l], net.close[l], Exporting, abort.raise | e} = {
  let wall_ms = time.now_ms();
  let mono_us = time.elapsed_us();
  handle {
    let pump = |force: Bool, patience: Int| {
      let before = exporter_state.get();
      let plan = planned(
        before,
        config,
        time.elapsed_ms(),
        nanos_now(wall_ms, mono_us, time.elapsed_us()),
        force,
      );
      match plan.send {
        None -> false,
        Some(out) -> if plan.wait_ms > patience { false } else {
          exporter_state.put(plan.state);
          if plan.wait_ms > 0 { time.sleep_ms(plan.wait_ms) } else { () };
          let how = send_request[l](config, out);
          let draw = entropy.below(1000);
          exporter_state.put(
            record_outcome(exporter_state.get(), config, out, how, time.elapsed_ms(), draw),
          );
          true
        },
      }
    };
    let flushed = || {
      let state = exporter_state.get();
      let began = time.elapsed_ms();
      let rounds = (state.queue.len() / max(config.batch, 1) + 3) * (max(config.attempts, 1) + 1);
      range(0, rounds).fold(true, |more: Bool, _: Int| {
        let left = config.flush_ms - (time.elapsed_ms() - began);
        if more && left > 0 { pump(true, left) } else { false }
      });
      stats_of(exporter_state.get())
    };
    bracket(
      || (),
      |_: Unit| {
        flushed();
        ()
      },
      |_: Unit|
        handle {
          body()
        } with {
          trace.enter[*c](name, fields) -> {
            let state = exporter_state.get();
            let who = match telemetry::identity(fields) {
              Some(named) -> named,
              None -> {
                let above = match state.open { [inner, ..] -> Some(inner.who.context), [] -> None };
                let made: telemetry::Identity = {
                  context: telemetry::begin(above, config.sampler),
                  parent: match above { Some(up) -> Some(up.parent.parent_id), None -> None },
                  kind: telemetry::Internal,
                };
                made
              },
            };
            exporter_state.put(
              opened(
                state,
                c,
                name,
                who,
                telemetry::attributes(fields),
                nanos_now(wall_ms, mono_us, time.elapsed_us()),
              ),
            );
            { id: state.next, channel: c }
          },
          trace.exit[*c](span, outcome) -> {
            exporter_state.put(
              closed(
                exporter_state.get(),
                config,
                span,
                outcome,
                nanos_now(wall_ms, mono_us, time.elapsed_us()),
                time.elapsed_ms(),
              ),
            );
            pump(false, 0);
            ()
          },
          trace.count[*c](name, delta, fields) -> {
            exporter_state.put(
              update_series(
                exporter_state.get(),
                config,
                c,
                "sum",
                name,
                fields,
                |previous_tally: Option<Tally>| add_count(previous_tally, delta),
              ),
            );
            pump(false, 0);
            ()
          },
          trace.gauge[*c](name, value, fields) -> {
            exporter_state.put(
              update_series(
                exporter_state.get(),
                config,
                c,
                "gauge",
                name,
                fields,
                |_: Option<Tally>| Level(Float::of_decimal(value)),
              ),
            );
            pump(false, 0);
            ()
          },
          trace.time[*c](name, micros, fields) -> {
            exporter_state.put(
              update_series(
                exporter_state.get(),
                config,
                c,
                "histogram",
                name,
                fields,
                |previous_tally: Option<Tally>|
                  add_timing(previous_tally, config.bounds, Float::of_int(micros) / 1000000.0),
              ),
            );
            pump(false, 0);
            ()
          },
          tracing.current() -> None,
          tracing.sampler() -> config.sampler,
          tracing.annotate(span, fields) ->
            exporter_state.put(annotated(exporter_state.get(), span, fields)),
          otlp.flush() -> flushed(),
          otlp.stats() -> stats_of(exporter_state.get()),
        },
    )
  } with {
    var st = initial_state(nanos_now(wall_ms, mono_us, mono_us), time.elapsed_ms()),
    exporter_state.get() -> st,
    exporter_state.put(next) -> {
      st = next;
    },
  }
}

effect exporter_state {
  read get() -> State
  write put(next: State) -> Unit
}

/// Sends everything the enclosing `exporting` has queued, waiting through any request's backoff,
/// and returns its statistics. A program calls this before it exits.
pub fn flush() -> Stats / {otlp.flush} = otlp.flush()

/// What the exporter around the caller has done so far.
pub fn stats() -> Stats / {otlp.stats} = otlp.stats()

fn trace_of(hex: String) -> TraceId / {abort.raise} =
  match traceparent::trace_id_of_hex(hex) { Some(id) -> id, None -> panic("a trace id") }

fn span_named(hex: String) -> SpanId / {abort.raise} =
  match traceparent::span_id_of_hex(hex) { Some(id) -> id, None -> panic("a span id") }

fn sample_span() -> Span / {abort.raise} =
  {
    trace_id: trace_of("5b8efff798038103d269b633813fc60c"),
    span_id: span_named("eee19b7ec3c1b174"),
    trace_state: "rojo=1",
    parent: Some(span_named("eee19b7ec3c1b173")),
    flags: 1u32,
    name: "GET",
    kind: Server,
    start: 1544712660000000000u64,
    end: 1544712661000000000u64,
    attributes: [
      attribute("http.response.status_code", IntValue(200)),
      attribute("ratio", DoubleValue(0.5)),
      attribute("raw", BytesValue(b"\x00\xff")),
      attribute("ok", BoolValue(true)),
      attribute("tags", ArrayValue([StringValue("a"), NoValue])),
      attribute("peer", KvlistValue([attribute("port", IntValue(-1))])),
    ],
    dropped_attributes: 2u32,
    events: [
      {
        time: 1544712660500000000u64,
        name: "retry",
        attributes: [attribute("attempt", IntValue(2))],
        dropped_attributes: 0u32,
      },
    ],
    dropped_events: 0u32,
    links: [
      {
        trace_id: trace_of("0af7651916cd43dd8448eb211c80319c"),
        span_id: span_named("b7ad6b7169203331"),
        trace_state: "",
        attributes: [],
        dropped_attributes: 0u32,
        flags: 0u32,
      },
    ],
    dropped_links: 0u32,
    status: { code: StatusError, message: "boom" },
  }

fn sample_traces() -> Traces / {abort.raise} =
  {
    resource_spans: [
      {
        resource: {
          attributes: [attribute("service.name", StringValue("shop"))],
          dropped_attributes: 0u32,
        },
        scope_spans: [
          {
            scope: { name: "http", version: "1.0", attributes: [], dropped_attributes: 0u32 },
            spans: [sample_span()],
            schema_url: "",
          },
        ],
        schema_url: "https://opentelemetry.io/schemas/1.37.0",
      },
    ],
  }

fn sample_traces_json() -> String =
  \\{"resourceSpans":[{"resource":{"attributes":[{"key":"service.name","value":{"stringValue":"shop"}}]},
  \\"scopeSpans":[{"scope":{"name":"http","version":"1.0"},"spans":[{
  \\"traceId":"5b8efff798038103d269b633813fc60c","spanId":"eee19b7ec3c1b174","traceState":"rojo=1",
  \\"parentSpanId":"eee19b7ec3c1b173","flags":1,"name":"GET","kind":2,
  \\"startTimeUnixNano":"1544712660000000000","endTimeUnixNano":"1544712661000000000",
  \\"attributes":[{"key":"http.response.status_code","value":{"intValue":"200"}},
  \\{"key":"ratio","value":{"doubleValue":0.5}},{"key":"raw","value":{"bytesValue":"AP8="}},
  \\{"key":"ok","value":{"boolValue":true}},
  \\{"key":"tags","value":{"arrayValue":{"values":[{"stringValue":"a"},{}]}}},
  \\{"key":"peer","value":{"kvlistValue":{"values":[{"key":"port","value":{"intValue":"-1"}}]}}}],
  \\"droppedAttributesCount":2,
  \\"events":[{"timeUnixNano":"1544712660500000000","name":"retry",
  \\"attributes":[{"key":"attempt","value":{"intValue":"2"}}]}],
  \\"links":[{"traceId":"0af7651916cd43dd8448eb211c80319c","spanId":"b7ad6b7169203331"}],
  \\"status":{"message":"boom","code":2}}]}],
  \\"schemaUrl":"https://opentelemetry.io/schemas/1.37.0"}]}

fn sample_metrics() -> Metrics =
  {
    resource_metrics: [
      {
        resource: {
          attributes: [attribute("service.name", StringValue("shop"))],
          dropped_attributes: 0u32,
        },
        scope_metrics: [
          {
            scope: scope("orders"),
            metrics: [
              {
                name: "orders.placed",
                description: "orders taken",
                unit: "{order}",
                data: Sum(
                  [
                    {
                      attributes: [attribute("sku", StringValue("BOLT-1"))],
                      start: 1544712660000000000u64,
                      time: 1544712661000000000u64,
                      value: AsInt(7),
                    },
                  ],
                  Cumulative,
                  true,
                ),
              },
              {
                name: "shelf.level",
                description: "",
                unit: "",
                data: Gauge([
                  {
                    attributes: [],
                    start: 0u64,
                    time: 1544712661000000000u64,
                    value: AsDouble(41.75),
                  },
                ]),
              },
              {
                name: "request.duration",
                description: "",
                unit: "s",
                data: Histogram(
                  [
                    {
                      attributes: [],
                      start: 1544712660000000000u64,
                      time: 1544712661000000000u64,
                      count: 3u64,
                      sum: Some(0.75),
                      bucket_counts: [1u64, 2u64, 0u64],
                      explicit_bounds: [0.1, 1.0],
                      min: Some(0.05),
                      max: Some(0.5),
                    },
                  ],
                  Delta,
                ),
              },
            ],
            schema_url: "",
          },
        ],
        schema_url: "",
      },
    ],
  }

fn sample_metrics_json() -> String =
  \\{"resourceMetrics":[{"resource":{"attributes":[{"key":"service.name","value":{"stringValue":"shop"}}]},
  \\"scopeMetrics":[{"scope":{"name":"orders"},"metrics":[
  \\{"name":"orders.placed","description":"orders taken","unit":"{order}","sum":{"dataPoints":[
  \\{"attributes":[{"key":"sku","value":{"stringValue":"BOLT-1"}}],
  \\"startTimeUnixNano":"1544712660000000000","timeUnixNano":"1544712661000000000","asInt":"7"}],
  \\"aggregationTemporality":2,"isMonotonic":true}},
  \\{"name":"shelf.level","gauge":{"dataPoints":[{"timeUnixNano":"1544712661000000000","asDouble":41.75}]}},
  \\{"name":"request.duration","unit":"s","histogram":{"dataPoints":[
  \\{"startTimeUnixNano":"1544712660000000000","timeUnixNano":"1544712661000000000","count":"3",
  \\"sum":0.75,"bucketCounts":["1","2","0"],"explicitBounds":[0.1,1],"min":0.05,"max":0.5}],
  \\"aggregationTemporality":1}}]}]}]}

fn joined(string_if_set: String) -> Bytes =
  Bytes::concat_all(Bytes::of_string(string_if_set).split(b"\n"))

test "traces follow OTLP's JSON mapping: hex ids, 64-bit numbers as strings, enums as numbers" {
  assert_eq(
    json::parse(encode_traces(Json, sample_traces())),
    json::parse(joined(sample_traces_json())),
  );
  assert_eq(
    decode_traces(Json, joined(sample_traces_json()), default_limits()),
    Ok(sample_traces()),
  )
}

test "metrics follow OTLP's JSON mapping" {
  assert_eq(
    json::parse(encode_metrics(Json, sample_metrics())),
    json::parse(joined(sample_metrics_json())),
  );
  assert_eq(
    decode_metrics(Json, joined(sample_metrics_json()), default_limits()),
    Ok(sample_metrics()),
  )
}

test "`decode_traces` and `decode_metrics` return the original sample from its protobuf encoding, and JSON metrics decode to the same value as protobuf metrics" {
  let wire = encode_traces(Protobuf, sample_traces());
  assert_eq(decode_traces(Protobuf, wire, default_limits()), Ok(sample_traces()));
  let metrics = encode_metrics(Protobuf, sample_metrics());
  assert_eq(decode_metrics(Protobuf, metrics, default_limits()), Ok(sample_metrics()));
  assert_eq(
    decode_metrics(Json, encode_metrics(Json, sample_metrics()), default_limits()),
    decode_metrics(Protobuf, metrics, default_limits()),
  )
}

fn traces_drawn() -> gen::Gen<Traces> =
  gen::map(gen::list_of(resource_spans_drawn(), 2), |resource_spans: List<ResourceSpans>|
    { resource_spans: resource_spans })

fn resource_spans_drawn() -> gen::Gen<ResourceSpans> =
  gen::map3(
    resources(),
    gen::list_of(scope_spans_drawn(), 2),
    gen::text(),
    |resource: Resource, scope_spans: List<ScopeSpans>, schema_url: String|
      { resource: resource, scope_spans: scope_spans, schema_url: schema_url },
  )

fn resources() -> gen::Gen<Resource> =
  gen::map2(
    gen::list_of(key_values(), 2),
    gen::u32(),
    |attributes: List<KeyValue>, dropped_attributes: U32|
      { attributes: attributes, dropped_attributes: dropped_attributes },
  )

fn key_values() -> gen::Gen<KeyValue> =
  gen::map2(gen::text(), any_values(), |key: String, value: AnyValue| { key: key, value: value })

fn scope_spans_drawn() -> gen::Gen<ScopeSpans> =
  gen::map3(
    scopes(),
    gen::list_of(spans(), 2),
    gen::text(),
    |scope: Scope, spans: List<Span>, schema_url: String|
      { scope: scope, spans: spans, schema_url: schema_url },
  )

fn scopes() -> gen::Gen<Scope> =
  gen::map4(
    gen::text(),
    gen::text(),
    gen::list_of(key_values(), 2),
    gen::u32(),
    |name: String, version: String, attributes: List<KeyValue>, dropped_attributes: U32|
      {
        name: name,
        version: version,
        attributes: attributes,
        dropped_attributes: dropped_attributes,
      },
  )

fn spans() -> gen::Gen<Span> =
  gen::and_then(traceparent::trace_ids(), |trace_id: TraceId|
    gen::and_then(traceparent::span_ids(), |span_id: SpanId|
      gen::and_then(gen::text(), |trace_state: String|
        gen::and_then(gen::option_of(traceparent::span_ids()), |parent: Option<SpanId>|
          gen::and_then(gen::u32(), |flags: U32|
            gen::and_then(gen::text(), |name: String|
              gen::and_then(span_kinds(), |kind: SpanKind|
                gen::and_then(gen::u64(), |start: U64|
                  gen::and_then(gen::u64(), |end: U64|
                    gen::and_then(
                      gen::list_of(key_values(), 2),
                      |attributes: List<KeyValue>|
                        gen::and_then(gen::u32(), |dropped_attributes: U32|
                          gen::and_then(gen::list_of(events(), 2), |events: List<Event>|
                            gen::map4(
                              gen::u32(),
                              gen::list_of(links(), 2),
                              gen::u32(),
                              status_drawn(),
                              |dropped_events: U32, links: List<Link>, dropped_links: U32, status: Status|
                                {
                                  trace_id: trace_id,
                                  span_id: span_id,
                                  trace_state: trace_state,
                                  parent: parent,
                                  flags: flags,
                                  name: name,
                                  kind: kind,
                                  start: start,
                                  end: end,
                                  attributes: attributes,
                                  dropped_attributes: dropped_attributes,
                                  events: events,
                                  dropped_events: dropped_events,
                                  links: links,
                                  dropped_links: dropped_links,
                                  status: status,
                                },
                            ))),
                    ))))))))))

fn span_kinds() -> gen::Gen<SpanKind> =
  gen::elements([Unspecified, Internal, Server, Client, Producer, Consumer])

fn events() -> gen::Gen<Event> =
  gen::map4(
    gen::u64(),
    gen::text(),
    gen::list_of(key_values(), 2),
    gen::u32(),
    |time: U64, name: String, attributes: List<KeyValue>, dropped_attributes: U32|
      { time: time, name: name, attributes: attributes, dropped_attributes: dropped_attributes },
  )

fn links() -> gen::Gen<Link> =
  gen::and_then(traceparent::trace_ids(), |trace_id: TraceId|
    gen::and_then(traceparent::span_ids(), |span_id: SpanId|
      gen::map4(
        gen::text(),
        gen::list_of(key_values(), 2),
        gen::u32(),
        gen::u32(),
        |trace_state: String, attributes: List<KeyValue>, dropped_attributes: U32, flags: U32|
          {
            trace_id: trace_id,
            span_id: span_id,
            trace_state: trace_state,
            attributes: attributes,
            dropped_attributes: dropped_attributes,
            flags: flags,
          },
      )))

fn status_drawn() -> gen::Gen<Status> =
  gen::map2(status_codes(), gen::text(), |code: StatusCode, message: String|
    { code: code, message: message })

fn status_codes() -> gen::Gen<StatusCode> = gen::elements([StatusUnset, StatusOk, StatusError])

fn metrics_drawn() -> gen::Gen<Metrics> =
  gen::map(gen::list_of(resource_metrics_drawn(), 2), |resource_metrics: List<ResourceMetrics>|
    { resource_metrics: resource_metrics })

fn resource_metrics_drawn() -> gen::Gen<ResourceMetrics> =
  gen::map3(
    resources(),
    gen::list_of(scope_metrics_drawn(), 2),
    gen::text(),
    |resource: Resource, scope_metrics: List<ScopeMetrics>, schema_url: String|
      { resource: resource, scope_metrics: scope_metrics, schema_url: schema_url },
  )

fn scope_metrics_drawn() -> gen::Gen<ScopeMetrics> =
  gen::map3(
    scopes(),
    gen::list_of(metrics(), 2),
    gen::text(),
    |scope: Scope, metrics: List<Metric>, schema_url: String|
      { scope: scope, metrics: metrics, schema_url: schema_url },
  )

fn metrics() -> gen::Gen<Metric> =
  gen::map4(
    gen::text(),
    gen::text(),
    gen::text(),
    datas(),
    |name: String, description: String, unit: String, data: Data|
      { name: name, description: description, unit: unit, data: data },
  )

fn datas() -> gen::Gen<Data> =
  gen::one_of([
    gen::map(gen::list_of(number_points(), 2), |f0: List<NumberPoint>| Gauge(f0)),
    gen::map3(
      gen::list_of(number_points(), 2),
      temporalities(),
      gen::bool(),
      |f0: List<NumberPoint>, f1: Temporality, f2: Bool| Sum(f0, f1, f2),
    ),
    gen::map2(
      gen::list_of(histogram_points(), 2),
      temporalities(),
      |f0: List<HistogramPoint>, f1: Temporality| Histogram(f0, f1),
    ),
  ])

fn number_points() -> gen::Gen<NumberPoint> =
  gen::map4(
    gen::list_of(key_values(), 2),
    gen::u64(),
    gen::u64(),
    numbers(),
    |attributes: List<KeyValue>, start: U64, time: U64, value: Number|
      { attributes: attributes, start: start, time: time, value: value },
  )

fn temporalities() -> gen::Gen<Temporality> = gen::elements([Delta, Cumulative])

test "`decode_traces` returns the original traces from their JSON encoding, for any traces" {
  gen::check(traces_drawn(), |t: Traces| {
    decode_traces(Json, encode_traces(Json, t), default_limits()) == Ok(t)
  })
}

test "`decode_metrics` returns the original metrics from their JSON encoding, for any metrics" {
  gen::check(metrics_drawn(), |m: Metrics| {
    decode_metrics(Json, encode_metrics(Json, m), default_limits()) == Ok(m)
  })
}

test "`decode_response` returns the original export response from either protobuf or JSON encoding" {
  gen::check2(gen::any_int(), gen::text(), |rejected: Int, message: String| {
    let receipt: ExportResponse = { rejected: rejected, message: message };
    decode_response(
        Protobuf,
        TraceSignal,
        encode_response(Protobuf, TraceSignal, receipt),
        default_limits(),
      )
      == Ok(receipt)
      && decode_response(
        Json,
        MetricSignal,
        encode_response(Json, MetricSignal, receipt),
        default_limits(),
      )
      == Ok(receipt)
  })
}

test "a double that JSON has no number for is written as a string a reader accepts" {
  let doubles = [Float::nan(), Float::infinity(), Float::neg_infinity(), 1e300, 5e-324, 0.1];
  let written = doubles.map(|f: Float| json::to_string(float_json(f)));
  assert_eq(written, [
    "\"NaN\"",
    "\"Infinity\"",
    "\"-Infinity\"",
    "\"1e300\"",
    "\"5e-324\"",
    "0.1",
  ]);
  let back = try { doubles.map(|f: Float| double_of_json(float_json(f), "asDouble")) };
  match back {
    Ok([first, ..rest]) -> {
      assert(first != first);
      assert_eq(rest, [Float::infinity(), Float::neg_infinity(), 1e300, 5e-324, 0.1])
    },
    _ -> panic("refused"),
  }
}

type RejectedCase = {
  name: String,
  encoding: Encoding,
  body: Bytes,
  reason: ErrorKind,
  field: String,
}

fn span_json_with(members: String) -> Bytes =
  Bytes::of_string("{\"resourceSpans\":[{\"scopeSpans\":[{\"spans\":[{" ++ members ++ "}]}]}]}")

fn good_ids() -> String =
  "\"traceId\":\"5b8efff798038103d269b633813fc60c\",\"spanId\":\"eee19b7ec3c1b174\""

fn metric_json_with(members: String) -> Bytes =
  Bytes::of_string(
    "{\"resourceMetrics\":[{\"scopeMetrics\":[{\"metrics\":[{\"name\":\"m\"" ++ members
      ++ "}]}]}]}",
  )

fn rejected_traces() -> List<RejectedCase> / {abort.raise} =
  [
    {
      name: "text that is not JSON",
      encoding: Json,
      body: b"{\"resourceSpans\":",
      reason: NotJson("the input ended where a value was expected"),
      field: "",
    },
    {
      name: "an id in base64",
      encoding: Json,
      body: span_json_with(
        "\"traceId\":\"W47/95gDgQPSabYzgT/GDA==\",\"spanId\":\"eee19b7ec3c1b174\"",
      ),
      reason: BadText,
      field: "traceId",
    },
    {
      name: "a trace id of eight bytes",
      encoding: Json,
      body: span_json_with("\"traceId\":\"eee19b7ec3c1b174\",\"spanId\":\"eee19b7ec3c1b174\""),
      reason: BadId,
      field: "traceId",
    },
    {
      name: "a span with no span id",
      encoding: Json,
      body: span_json_with("\"traceId\":\"5b8efff798038103d269b633813fc60c\""),
      reason: BadId,
      field: "spanId",
    },
    {
      name: "an enum by its name",
      encoding: Json,
      body: span_json_with(good_ids() ++ ",\"kind\":\"SPAN_KIND_SERVER\""),
      reason: WrongKind("an enum's number"),
      field: "kind",
    },
    {
      name: "an enum that names nothing",
      encoding: Json,
      body: span_json_with(good_ids() ++ ",\"kind\":9"),
      reason: BadEnum(9),
      field: "kind",
    },
    {
      name: "a time that is not whole",
      encoding: Json,
      body: span_json_with(good_ids() ++ ",\"startTimeUnixNano\":\"1.5\""),
      reason: BadNumber,
      field: "startTimeUnixNano",
    },
    {
      name: "a time past 64 bits",
      encoding: Json,
      body: span_json_with(good_ids() ++ ",\"startTimeUnixNano\":\"18446744073709551616\""),
      reason: BadNumber,
      field: "startTimeUnixNano",
    },
    {
      name: "a name that is a number",
      encoding: Json,
      body: span_json_with(good_ids() ++ ",\"name\":7"),
      reason: WrongKind("a string"),
      field: "name",
    },
    {
      name: "spans that are no array",
      encoding: Json,
      body: b"{\"resourceSpans\":{}}",
      reason: WrongKind("an array"),
      field: "resourceSpans",
    },
    {
      name: "bytes that are no message",
      encoding: Protobuf,
      body: b"\x0b",
      reason: NotProtobuf(protobuf::Group),
      field: "",
    },
    {
      name: "a trace id of the wrong length, in protobuf",
      encoding: Protobuf,
      body: protobuf::message_field(
        1,
        protobuf::message_field(
          2,
          protobuf::message_field(2, protobuf::bytes_field(1, b"\x01\x02")),
        ),
      ),
      reason: BadId,
      field: "traceId",
    },
  ]

test "`decode_traces` rejects the invalid request {c.name} with the expected reason and field" for c: RejectedCase in rejected_traces(
  ) {
  match decode_traces(c.encoding, c.body, default_limits()) {
    Ok(_) -> panic("accepted"),
    Err(refusal) -> {
      assert_eq(refusal.reason, c.reason);
      assert_eq(refusal.field, c.field)
    },
  }
}

fn rejected_metrics() -> List<RejectedCase> / {abort.raise} =
  [
    {
      name: "a metric with no data",
      encoding: Json,
      body: metric_json_with(""),
      reason: Missing("data"),
      field: "data",
    },
    {
      name: "an exponential histogram",
      encoding: Json,
      body: metric_json_with(",\"exponentialHistogram\":{}"),
      reason: Unsupported("exponential_histogram"),
      field: "exponentialHistogram",
    },
    {
      name: "a summary",
      encoding: Json,
      body: metric_json_with(",\"summary\":{}"),
      reason: Unsupported("summary"),
      field: "summary",
    },
    {
      name: "a sum that does not say how it adds up",
      encoding: Json,
      body: metric_json_with(",\"sum\":{\"dataPoints\":[]}"),
      reason: Missing("aggregationTemporality"),
      field: "aggregationTemporality",
    },
    {
      name: "a point with no value",
      encoding: Json,
      body: metric_json_with(",\"gauge\":{\"dataPoints\":[{}]}"),
      reason: Missing("value"),
      field: "asDouble",
    },
    {
      name: "a summary, in protobuf",
      encoding: Protobuf,
      body: protobuf::message_field(
        1,
        protobuf::message_field(2, protobuf::message_field(2, protobuf::message_field(11, b""))),
      ),
      reason: Unsupported("summary"),
      field: "summary",
    },
    {
      name: "a metric with no data, in protobuf",
      encoding: Protobuf,
      body: protobuf::message_field(
        1,
        protobuf::message_field(2, protobuf::message_field(2, protobuf::string_field(1, "m"))),
      ),
      reason: Missing("data"),
      field: "data",
    },
  ]

test "`decode_metrics` rejects the invalid request {c.name} with the expected reason and field" for c: RejectedCase in rejected_metrics(
  ) {
  match decode_metrics(c.encoding, c.body, default_limits()) {
    Ok(_) -> panic("accepted"),
    Err(refusal) -> {
      assert_eq(refusal.reason, c.reason);
      assert_eq(refusal.field, c.field)
    },
  }
}

test "a field a reader does not know is skipped, in either encoding" {
  let known = span_json_with(good_ids() ++ ",\"name\":\"GET\"");
  let more = span_json_with(
    good_ids() ++ ",\"name\":\"GET\",\"later\":{\"a\":[1,2]},\"trace_id\":\"x\"",
  );
  assert_eq(
    decode_traces(Json, more, default_limits()),
    decode_traces(Json, known, default_limits()),
  );
  let wire = encode_traces(Protobuf, sample_traces());
  let extended = wire.concat(protobuf::string_field(900, "from a later version"));
  assert_eq(decode_traces(Protobuf, extended, default_limits()), Ok(sample_traces()));
  let loose = span_json_with(
    "\"traceId\":\"5B8EFFF798038103D269B633813FC60C\",\"spanId\":\"EEE19B7EC3C1B174\",\"startTimeUnixNano\":12,\"parentSpanId\":\"\"",
  );
  match decode_traces(Json, loose, default_limits()) {
    Ok({ resource_spans: [{ scope_spans: [{ spans: [span], .. }], .. }] }) -> {
      assert_eq(span.start, 12u64);
      assert_eq(span.parent, None);
      assert_eq(traceparent::span_id_hex(span.span_id), "eee19b7ec3c1b174")
    },
    _ -> panic("refused"),
  }
}

test "a request past its limits is rejected" {
  let tight: Limits = { length: 16, depth: 64 };
  match decode_traces(Json, encode_traces(Json, sample_traces()), tight) {
    Err(refusal) -> assert_eq(refusal.reason, TooLong),
    Ok(_) -> panic("accepted"),
  };
  match decode_traces(Protobuf, encode_traces(Protobuf, sample_traces()), tight) {
    Err(refusal) -> assert_eq(refusal.reason, NotProtobuf(protobuf::TooLong)),
    Ok(_) -> panic("accepted"),
  };
  let shallow: Limits = { length: 4194304, depth: 5 };
  match decode_traces(Protobuf, encode_traces(Protobuf, sample_traces()), shallow) {
    Err(refusal) -> assert_eq(refusal.reason, NotProtobuf(protobuf::TooDeep)),
    Ok(_) -> panic("accepted"),
  };
  match decode_traces(Json, encode_traces(Json, sample_traces()), { length: 4194304, depth: 1 }) {
    Err(refusal) -> assert_eq(refusal.reason, TooDeep),
    Ok(_) -> panic("accepted"),
  }
}

test "an export response with nothing rejected encodes as empty, and one with rejected items encodes the count and message" {
  let none: ExportResponse = { rejected: 0, message: "" };
  assert_eq(encode_response(Protobuf, TraceSignal, none), b"");
  assert_eq(encode_response(Json, TraceSignal, none), b"{}");
  let some: ExportResponse = { rejected: 3, message: "too old" };
  assert_eq(
    String::of_bytes(encode_response(Json, TraceSignal, some)),
    "{\"partialSuccess\":{\"errorMessage\":\"too old\",\"rejectedSpans\":\"3\"}}",
  );
  assert_eq(
    String::of_bytes(encode_response(Json, MetricSignal, some)),
    "{\"partialSuccess\":{\"errorMessage\":\"too old\",\"rejectedDataPoints\":\"3\"}}",
  )
}

type Reply = | Down | Take | Partial(Int) | Busy(Int, Option<Int>) | Bad

type Collector = {
  traces: List<Traces>,
  metrics: List<Metrics>,
  arrivals: List<Int>,
  types: List<String>,
  gzipped: Int,
}

type CollectorConnection = { written: Bytes, result: Bytes, served: Bool }

effect collector {
  write rejects() -> Bool
  write next(content_type: String, gzipped: Bool) -> Reply
  write took_traces(t: Traces) -> Unit
  write took_metrics(m: Metrics) -> Unit
}

fn export_http_response<| r>(
  e: Encoding,
  signal: Signal,
  rejected: Int,
) -> http::Response<| r> / {abort.raise} = {
  let receipt: ExportResponse = {
    rejected: rejected,
    message: if rejected == 0 { "" } else { "turned away" },
  };
  {
    status: 200,
    headers: http::set_header(http::empty_headers(), "content-type", content_type(e)),
    body: http::Whole(encode_response(e, signal, receipt)),
  }
}

fn accept_export<| r>(
  e: Encoding,
  path: String,
  raw: Bytes,
  rejected: Int,
) -> http::Response<| r> / {collector.took_traces, collector.took_metrics, abort.raise} =
  if path == traces_path() {
    match decode_traces(e, raw, default_limits()) {
      Ok(t) -> {
        collector.took_traces(t);
        export_http_response(e, TraceSignal, rejected)
      },
      Err(_) -> http::text_response(400, "not traces"),
    }
  } else if path == metrics_path() {
    match decode_metrics(e, raw, default_limits()) {
      Ok(m) -> {
        collector.took_metrics(m);
        export_http_response(e, MetricSignal, rejected)
      },
      Err(_) -> http::text_response(400, "not metrics"),
    }
  } else { http::text_response(404, "no such signal") }

fn receive<| r>(
  request: http::Request,
) -> http::Response<| r> / {collector.next, collector.took_traces, collector.took_metrics, http::Reading} = {
  let kind = match http::header(request.headers, "content-type") { Some(k) -> k, None -> "" };
  let packed = http::header(request.headers, "content-encoding") == Some("gzip");
  let sent = http::request_body(request, 4194304);
  let raw = if packed { gzip::try_gunzip(sent, 4194304) } else { Ok(sent) };
  let encoding = if kind == content_type(Json) { Some(Json) }
  else if kind == content_type(Protobuf) { Some(Protobuf) }
  else { None };
  match ((request.method, encoding, raw)) {
    (http::Post, Some(e), Ok(body)) -> match collector.next(kind, packed) {
      Take | Down -> accept_export(e, request.path, body, 0),
      Partial(n) -> accept_export(e, request.path, body, n),
      Busy(status, after) -> {
        let response = http::text_response(status, "later");
        match after {
          Some(seconds) ->
            {
              ..response,
              headers: http::set_header(response.headers, "retry-after", seconds.to_string()),
            },
          None -> response,
        }
      },
      Bad -> http::text_response(400, "no"),
    },
    (http::Post, None, _) -> http::text_response(415, "neither JSON nor protobuf"),
    (http::Post, _, Err(_)) -> http::text_response(400, "not gzip"),
    _ -> http::method_not_allowed([http::Post]),
  }
}

fn serve_bytes(
  written: Bytes,
) -> Bytes / {collector.next, collector.took_traces, collector.took_metrics, abort.raise} = {
  let client = ip::socket_at(ip::loopback_v4(), 49152);
  let ran = net::on_mem(net::mem_calling(net::mem_empty(), client, [Sends(written)]), || {
    let connection = net.accept[listener](net.listen[listener](0));
    http::serve_connection[inner](connection, http::default_limits(), receive);
    connection
  });
  net::mem_sent(ran.net, ran.value)
}

type CollectorRun<a> = { value: a, seen: Collector }

fn collector_host() -> String = "collector.test"

fn collected<a | e>(
  script: List<Reply>,
  body: () -> a / {net.connect[collector], net.connect_tls[collector], net.send[collector], net.recv[collector], net.close[collector] | e},
) -> CollectorRun<a> / {clock.now, abort.raise | e} = {
  handle {
    handle {
      body()
    } with {
      var conns: Map<Int, CollectorConnection> = Map::new(),
      var next = 1,
      net.connect[collector](host, port, t) -> if collector.rejects() || host != collector_host()
          || port != 4318 { None } else {
        let connection: CollectorConnection = { written: b"", result: b"", served: false };
        conns = conns.insert(next, connection);
        next = next + 1;
        Some(next - 1)
      },
      net.connect_tls[collector](host, port, t) -> None,
      net.send[collector](connection_id, payload, t) -> match conns.get(connection_id) {
        Some(c) -> {
          conns = conns.insert(connection_id, { ..c, written: c.written.concat(payload) });
          Some(payload.len())
        },
        None -> None,
      },
      net.recv[collector](connection_id, most, t) -> match conns.get(connection_id) {
        None -> Some(b""),
        Some(c) -> {
          let ready = if c.served { c } else {
            let out: CollectorConnection = {
              written: c.written,
              result: serve_bytes(c.written),
              served: true,
            };
            out
          };
          let n = min(most, ready.result.len());
          conns = conns.insert(connection_id, {
            ..ready,
            result: ready.result.slice(n, ready.result.len()),
          });
          Some(ready.result.slice(0, n))
        },
      },
      net.close[collector](connection_id) -> {
        conns = conns.remove(connection_id);
      },
    }
  } with {
    var left = script,
    var seen: Collector = { traces: [], metrics: [], arrivals: [], types: [], gzipped: 0 },
    collector.rejects() -> match left {
      [Down, ..rest] -> {
        left = rest;
        true
      },
      _ -> false,
    },
    collector.next(kind, packed) -> {
      seen = {
        ..seen,
        arrivals: seen.arrivals.push(match clock.now() { Instant(n) -> n / 1000000 }),
        types: seen.types.push(kind),
        gzipped: seen.gzipped + (if packed { 1 } else { 0 }),
      };
      match left {
        [first, ..rest] -> {
          left = rest;
          first
        },
        [] -> Take,
      }
    },
    collector.took_traces(t) -> {
      seen = { ..seen, traces: seen.traces.push(t) };
    },
    collector.took_metrics(m) -> {
      seen = { ..seen, metrics: seen.metrics.push(m) };
    },
    return value -> { value: value, seen: seen },
  }
}

fn epoch_ms() -> Int = 1700000000000

fn on_clock<a | e>(
  body: () -> a / {time.now_ms, time.elapsed_ms, time.elapsed_us, time.sleep_ms | e},
) -> a / {clock.now, clock.sleep | e} =
  handle {
    body()
  } with {
    time.now_ms() -> epoch_ms() + (match clock.now() { Instant(n) -> n / 1000000 }),
    time.elapsed_ms() -> match clock.now() { Instant(n) -> n / 1000000 },
    time.elapsed_us() -> match clock.now() { Instant(n) -> n / 1000 },
    time.sleep_ms(ms) -> clock.sleep(Duration(ms * 1000000)),
  }

fn test_config() -> Config = {
  let base: Config = config("shop", collector_host(), 4318);
  { ..base, backoff_ms: 100, max_backoff_ms: 1000 }
}

fn emit_sample_telemetry() -> Unit / {trace.enter[shop], trace.exit[shop], trace.count[shop], trace.gauge[shop], trace.time[shop], Tracing, entropy.next, time.sleep_ms, abort.raise} =
  telemetry::in_span[shop](
    "checkout",
    telemetry::Server,
    #{"sku": trace::StringField("BOLT-1")},
    || {
      time.sleep_ms(5);
      let inner = trace.enter[shop]("reserve", #{"qty": trace::IntField(2)});
      time.sleep_ms(2);
      trace.exit[shop](inner, trace::Failed("out of stock"));
      telemetry::annotate(#{"http.response.status_code": trace::IntField(409)});
      trace.count[shop]("orders placed", 1, #{"sku": trace::StringField("BOLT-1")});
      trace.gauge[shop]("shelf", 41.75m, Map::new());
      trace.time[shop]("checkout", 7000, Map::new())
    },
  )

fn shipping(
  config: Config,
) -> Stats / {net.connect[collector], net.connect_tls[collector], net.send[collector], net.recv[collector], net.close[collector], Exporting, abort.raise} =
  exporting[collector](config, || {
    emit_sample_telemetry();
    flush()
  })

fn nanos_at(ms: Int) -> U64 / {abort.raise} = U64::of_int((epoch_ms() + ms) * 1000000)

fn expected_traces(config: Config, seed: Int) -> Traces / {abort.raise} = {
  let trace_drawn = traceparent::rand_trace_id(rand(seed));
  let root = traceparent::rand_span_id(trace_drawn.rand);
  let child = traceparent::rand_span_id(root.rand);
  let reserve: Span = {
    trace_id: trace_drawn.value,
    span_id: child.value,
    trace_state: "",
    parent: Some(root.value),
    flags: 3u32,
    name: "reserve",
    kind: Internal,
    start: nanos_at(5),
    end: nanos_at(7),
    attributes: [attribute("qty", IntValue(2))],
    dropped_attributes: 0u32,
    events: [],
    dropped_events: 0u32,
    links: [],
    dropped_links: 0u32,
    status: { code: StatusError, message: "out of stock" },
  };
  let whole: Span = {
    ..reserve,
    span_id: root.value,
    parent: None,
    name: "checkout",
    kind: Server,
    start: nanos_at(0),
    attributes: [
      attribute("http.response.status_code", IntValue(409)),
      attribute("sku", StringValue("BOLT-1")),
    ],
    status: unset(),
  };
  {
    resource_spans: [
      {
        resource: config.resource,
        scope_spans: [{ scope: scope("shop"), spans: [reserve, whole], schema_url: "" }],
        schema_url: "",
      },
    ],
  }
}

fn expected_metrics(config: Config) -> Metrics / {abort.raise} = {
  let seconds = Float::of_int(7000) / 1000000.0;
  {
    resource_metrics: [
      {
        resource: config.resource,
        scope_metrics: [
          {
            scope: scope("shop"),
            metrics: [
              {
                name: "shelf",
                description: "",
                unit: "",
                data: Gauge([
                  { attributes: [], start: 0u64, time: nanos_at(7), value: AsDouble(41.75) },
                ]),
              },
              {
                name: "checkout",
                description: "",
                unit: "s",
                data: Histogram(
                  [
                    {
                      attributes: [],
                      start: nanos_at(0),
                      time: nanos_at(7),
                      count: 1u64,
                      sum: Some(seconds),
                      bucket_counts: [
                        0u64,
                        1u64,
                        0u64,
                        0u64,
                        0u64,
                        0u64,
                        0u64,
                        0u64,
                        0u64,
                        0u64,
                        0u64,
                        0u64,
                        0u64,
                        0u64,
                        0u64,
                      ],
                      explicit_bounds: telemetry::duration_bounds(),
                      min: Some(seconds),
                      max: Some(seconds),
                    },
                  ],
                  Cumulative,
                ),
              },
              {
                name: "orders placed",
                description: "",
                unit: "",
                data: Sum(
                  [
                    {
                      attributes: [attribute("sku", StringValue("BOLT-1"))],
                      start: nanos_at(0),
                      time: nanos_at(7),
                      value: AsInt(1),
                    },
                  ],
                  Cumulative,
                  true,
                ),
              },
            ],
            schema_url: "",
          },
        ],
        schema_url: "",
      },
    ],
  }
}

type Shipment = { name: String, encoding: Encoding, gzip: Bool }

fn shipments() -> List<Shipment> =
  [
    { name: "protobuf", encoding: Protobuf, gzip: false },
    { name: "JSON", encoding: Json, gzip: false },
    { name: "gzipped protobuf", encoding: Protobuf, gzip: true },
    { name: "gzipped JSON", encoding: Json, gzip: true },
  ]

test "a collector receives and decodes the exported traces and metrics when they are sent as {c.name}" for c: Shipment in shipments(
  ) {
  let base: Config = test_config();
  let config: Config = { ..base, encoding: c.encoding, gzip: c.gzip };
  let ran = with_rand(rand(41), ||
    simulate { on_clock(|| collected([], || shipping(config))) }).value;
  assert_eq(ran.seen.traces, [expected_traces(config, 41)]);
  assert_eq(ran.seen.metrics, [expected_metrics(config)]);
  assert_eq(ran.seen.types, [content_type(c.encoding), content_type(c.encoding)]);
  assert_eq(ran.seen.gzipped, if c.gzip { 2 } else { 0 });
  assert_eq(ran.value.exported, 2);
  assert_eq(ran.value.requests, 2);
  assert_eq(ran.value.queued + ran.value.dropped + ran.value.failed + ran.value.retries, 0)
}

fn step<[c]>(name: String) -> Unit / {trace.enter[c], trace.exit[c]} = {
  let span = trace.enter[c](name, Map::new());
  trace.exit[c](span, trace::Ok)
}

fn span_names(t: Traces) -> List<String> =
  t.resource_spans.fold([], |accumulator: List<String>, r: ResourceSpans|
    r.scope_spans.fold(accumulator, |inner: List<String>, s: ScopeSpans|
      s.spans.fold(inner, |names: List<String>, x: Span| names.push(x.name))))

test "a request the collector cannot accept yet is sent again after Retry-After and the backoff" {
  let config: Config = test_config();
  let ran = with_rand(rand(7), ||
    simulate {
      on_clock(||
        collected([Busy(503, Some(2)), Busy(429, None), Take], ||
          exporting[collector](config, || {
            step[shop]("only");
            flush()
          })))
    }).value;
  assert_eq(ran.seen.traces.map(span_names), [["only"]]);
  assert_eq(ran.value.exported, 1);
  assert_eq(ran.value.retries, 2);
  assert_eq(ran.value.failed, 0);
  match ran.seen.arrivals {
    [first, second, third] -> {
      assert_eq(first, 0);
      assert_eq(second, 2000);
      assert(third >= 2100 && third < 2200)
    },
    _ -> panic("expected three requests"),
  }
}

test "after a request fails, spans only queue until one ends after the retry delay, and that span's end resends the failed request" {
  let base: Config = test_config();
  let config: Config = { ..base, batch: 1 };
  let ran = with_rand(rand(8), ||
    simulate {
      on_clock(||
        collected([Busy(503, None), Take], ||
          exporting[collector](config, || {
            step[shop]("a");
            step[shop]("b");
            let waiting = stats();
            time.sleep_ms(150);
            step[shop]("c");
            let resent = stats();
            { waiting: waiting, resent: resent, done: flush() }
          })))
    }).value;
  assert_eq(ran.value.waiting.retries, 1);
  assert_eq(ran.value.waiting.queued, 2);
  assert_eq(ran.value.waiting.exported, 0);
  assert_eq(ran.value.resent.exported, 1);
  assert_eq(ran.value.resent.queued, 2);
  assert_eq(ran.seen.traces.map(span_names), [["a"], ["b"], ["c"]]);
  assert_eq(ran.seen.arrivals, [0, 150, 150, 150]);
  assert_eq(ran.value.done.exported, 3)
}

test "a full queue drops and counts, and what was queued is sent once the collector is back" {
  let base: Config = test_config();
  let config: Config = { ..base, queue: 3, batch: 2, attempts: 3 };
  let ran = with_rand(rand(9), ||
    simulate {
      on_clock(||
        collected([Down, Down], ||
          exporting[collector](config, || {
            ["s1", "s2", "s3", "s4", "s5", "s6", "s7"].fold((), |_: Unit, name: String|
              step[shop](name));
            let full = stats();
            { full: full, done: flush() }
          })))
    }).value;
  assert_eq(ran.value.full.dropped, 2);
  assert_eq(ran.value.full.queued, 5);
  assert_eq(ran.value.full.retries, 1);
  assert_eq(ran.seen.traces.map(span_names), [["s1", "s2"], ["s3", "s4"], ["s5"]]);
  assert_eq(ran.value.done.exported, 5);
  assert_eq(ran.value.done.dropped, 2);
  assert_eq(ran.value.done.retries, 2);
  assert_eq(ran.value.done.failed, 0)
}

test "a request is abandoned when the collector rejects it or it fails every attempt" {
  let base: Config = test_config();
  let config: Config = { ..base, attempts: 2 };
  let spurned = with_rand(rand(10), ||
    simulate {
      on_clock(||
        collected([Bad], ||
          exporting[collector](config, || {
            step[shop]("a");
            flush()
          })))
    }).value;
  assert_eq(spurned.value.failed, 1);
  assert_eq(spurned.value.retries, 0);
  assert_eq(spurned.seen.arrivals.len(), 1);
  let tired = with_rand(rand(10), ||
    simulate {
      on_clock(||
        collected([Busy(502, None), Busy(504, None), Take], ||
          exporting[collector](config, || {
            step[shop]("a");
            flush()
          })))
    }).value;
  assert_eq(tired.value.failed, 1);
  assert_eq(tired.value.retries, 1);
  assert_eq(tired.value.exported, 0);
  assert_eq(tired.seen.arrivals.len(), 2);
  assert_eq(tired.seen.traces, [])
}

test "spans are sent when the batch size is reached or the oldest span exceeds the maximum age, and metrics at their interval" {
  let base: Config = test_config();
  let config: Config = { ..base, batch: 3, max_age_ms: 5000, metrics_every_ms: 60000 };
  let ran = with_rand(rand(11), ||
    simulate {
      on_clock(||
        collected([], ||
          exporting[collector](config, || {
            step[shop]("a");
            step[shop]("b");
            let two = stats();
            step[shop]("c");
            step[shop]("d");
            time.sleep_ms(6000);
            step[shop]("e");
            trace.count[shop]("ticks", 1, Map::new());
            time.sleep_ms(61000);
            trace.count[shop]("ticks", 2, Map::new());
            { two: two, later: stats() }
          })))
    }).value;
  assert_eq(ran.value.two.queued, 2);
  assert_eq(ran.value.two.requests, 0);
  assert_eq(ran.seen.traces.map(span_names), [["a", "b", "c"], ["d", "e"]]);
  assert_eq(ran.seen.arrivals, [0, 6000, 67000]);
  assert_eq(ran.value.later.requests, 3);
  match ran.seen.metrics {
    [{ resource_metrics: [{ scope_metrics: [{ metrics: [ticks], .. }], .. }] }] ->
      assert_eq(
        ticks.data,
        Sum(
          [{ attributes: [], start: nanos_at(0), time: nanos_at(67000), value: AsInt(3) }],
          Cumulative,
          true,
        ),
      ),
    _ -> panic("expected one request of one metric"),
  }
}

fn remote(sampled: Bool) -> http::Request / {abort.raise} = {
  let request = http::request_to(http::Get, "shop.example", "/orders", b"");
  {
    ..request,
    headers: http::set_header(
      request.headers,
      "traceparent",
      "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-0" ++ (if sampled { "1" } else { "0" }),
    ),
  }
}

test "with the sampler set to always off, no spans are exported, except spans inside a request whose incoming trace is marked as sampled" {
  let base: Config = test_config();
  let config: Config = { ..base, sampler: telemetry::AlwaysOff };
  let ran = with_rand(rand(12), ||
    simulate {
      on_clock(||
        collected([], ||
          exporting[collector](config, || {
            step[shop]("unrecorded");
            telemetry::in_span[shop]("also unrecorded", telemetry::Internal, Map::new(), ||
              step[shop]("nor this"));
            telemetry::serve_traced[web](remote(true), |r: http::Request| {
              step[shop]("inside a recorded request");
              http::response(204, b"")
            });
            telemetry::serve_traced[web](remote(false), |r: http::Request|
              http::response(204, b""));
            flush()
          })))
    }).value;
  assert_eq(ran.value.unsampled, 4);
  assert_eq(ran.value.exported, 2);
  match ran.seen.traces {
    [{ resource_spans: [{ scope_spans: [shop, web], .. }] }] -> {
      assert_eq(shop.scope.name, "shop");
      assert_eq(web.scope.name, "web");
      match ((shop.spans, web.spans)) {
        ([inner], [request]) -> {
          assert_eq(
            traceparent::trace_id_hex(request.trace_id),
            "4bf92f3577b34da6a3ce929d0e0e4736",
          );
          assert_eq(request.parent, traceparent::span_id_of_hex("00f067aa0ba902b7"));
          assert_eq(request.kind, Server);
          assert_eq(request.flags, 1u32);
          assert_eq(inner.parent, Some(request.span_id));
          assert_eq(inner.trace_id, request.trace_id);
          assert_eq(request.attributes, [
            attribute("http.request.method", StringValue("GET")),
            attribute("http.response.status_code", IntValue(204)),
            attribute("network.protocol.version", StringValue("1.1")),
            attribute("server.address", StringValue("shop.example")),
            attribute("url.path", StringValue("/orders")),
          ])
        },
        _ -> panic("expected one span on each channel"),
      }
    },
    _ -> panic("expected one request of two scopes"),
  }
}

test "a ratio sampler records the traces whose ids it selects, and no others" {
  let base: Config = test_config();
  let config: Config = { ..base, sampler: telemetry::Ratio(1, 2) };
  let ran = with_rand(rand(13), ||
    simulate {
      on_clock(||
        collected([], ||
          exporting[collector](config, || {
            range(0, 24).fold((), |_: Unit, i: Int| step[shop]("s" ++ i.to_string()));
            flush()
          })))
    }).value;
  assert_eq(ran.value.exported + ran.value.unsampled, 24);
  assert(ran.value.exported > 4 && ran.value.unsampled > 4);
  let all_sampled = ran.seen.traces.fold(true, |all_kept: Bool, t: Traces|
    t.resource_spans.fold(all_kept, |a: Bool, r: ResourceSpans|
      r.scope_spans.fold(a, |b: Bool, s: ScopeSpans|
        s.spans.fold(b, |c: Bool, x: Span|
          c && telemetry::should_sample(telemetry::Ratio(1, 2), x.trace_id)))));
  assert(all_sampled)
}

test "a partially accepted export counts as exported, and a metric tracks at most `max_series` series" {
  let base: Config = test_config();
  let config: Config = { ..base, max_series: 2 };
  let ran = with_rand(rand(14), ||
    simulate {
      on_clock(||
        collected([Partial(1)], ||
          exporting[collector](config, || {
            step[shop]("a");
            step[shop]("b");
            ["x", "y", "z", "x"].fold((), |_: Unit, sku: String|
              trace.count[shop]("orders", 1, #{"sku": trace::StringField(sku)}));
            flush()
          })))
    }).value;
  assert_eq(ran.value.exported, 1);
  assert_eq(ran.value.rejected, 1);
  assert_eq(ran.value.series_dropped, 1);
  match ran.seen.metrics {
    [{ resource_metrics: [{ scope_metrics: [{ metrics: [orders], .. }], .. }] }] -> match orders.data {
      Sum(points, _, _) -> assert_eq(points.map(|p: NumberPoint| p.value), [AsInt(2), AsInt(1)]),
      _ -> panic("expected a sum"),
    },
    _ -> panic("expected one metric"),
  }
}

test "closing a span ends its still-open child spans as abandoned, and exiting a span that is not open increments `unmatched_exits`" {
  let config: Config = test_config();
  let ran = with_rand(rand(15), ||
    simulate {
      on_clock(||
        collected([], ||
          exporting[collector](config, || {
            let outer = trace.enter[shop]("outer", Map::new());
            let inner = trace.enter[shop]("inner", Map::new());
            trace.exit[shop](outer, trace::Ok);
            trace.exit[shop](inner, trace::Ok);
            flush()
          })))
    }).value;
  assert_eq(ran.value.unmatched_exits, 1);
  match ran.seen.traces {
    [{ resource_spans: [{ scope_spans: [{ spans: [outer, inner], .. }], .. }] }] -> {
      assert_eq(inner.name, "inner");
      assert_eq(inner.status, { code: StatusError, message: "abandoned" });
      assert_eq(inner.parent, Some(outer.span_id));
      assert_eq(outer.status, unset())
    },
    _ -> panic("expected two spans"),
  }
}

test "a flush waits no longer than it is given, and what it could not send stays queued" {
  let base: Config = test_config();
  let config: Config = { ..base, flush_ms: 3000 };
  let ran = with_rand(rand(16), ||
    simulate {
      on_clock(||
        collected([Busy(503, Some(60)), Take], ||
          exporting[collector](config, || {
            step[shop]("a");
            let first = flush();
            time.sleep_ms(60000);
            { first: first, second: flush() }
          })))
    }).value;
  assert_eq(ran.value.first.retries, 1);
  assert_eq(ran.value.first.exported, 0);
  assert_eq(ran.value.first.queued, 1);
  assert_eq(ran.value.second.exported, 1);
  assert_eq(ran.value.second.queued, 0);
  assert_eq(ran.seen.arrivals, [0, 60000])
}

test "`retry_wait` doubles with each attempt up to a maximum, picks a random wait in the upper half of that range, and is never below Retry-After" {
  let config: Config = test_config();
  assert_eq(retry_wait(config, 1, None, 0), 50);
  assert_eq(retry_wait(config, 1, None, 999), 99);
  assert_eq(retry_wait(config, 2, None, 0), 100);
  assert_eq(retry_wait(config, 4, None, 500), 600);
  assert_eq(retry_wait(config, 5, None, 0), 500);
  assert_eq(retry_wait(config, 30, None, 0), 500);
  assert_eq(retry_wait(config, 1, Some(3000), 999), 3000);
  assert_eq(retry_wait(config, 5, Some(10), 0), 500)
}
