//! Base64 as RFC 4648 defines it: the standard alphabet with padding, and the URL-safe alphabet
//! without.
//!
//! `base64_encode` and `base64_decode` follow RFC 4648 §4: `A-Za-z0-9+/`, padded to a multiple of
//! four characters. `base64url_encode` and `base64url_decode` follow RFC 4648 §5: `A-Za-z0-9-_`,
//! unpadded, the form JWTs and URLs use. Both directions are pure and total. A decoder returns
//! `None` rather than raising. It rejects any text the RFC calls non-canonical: a padding character
//! anywhere but the end, a wrong length, or nonzero leftover bits in the last group. So decoding an
//! encoding always returns the original bytes.
//!
//! These functions are `std.radix` with two of its alphabets. For padded URL-safe text, or unpadded
//! standard text, use that module's `padded` and `unpadded`.

import std.bytes
import std.laws (round_trip)
import std.radix
import std.gen

/// Encodes bytes as text in the standard base64 alphabet, with `=` padding.
pub fn base64_encode(data: Bytes) -> String / {abort.raise} = radix::encode(radix::base64(), data)

/// Encodes bytes as text in the URL-safe base64 alphabet, without padding.
pub fn base64url_encode(data: Bytes) -> String / {abort.raise} =
  radix::encode(radix::base64url(), data)

/// Decodes standard padded base64 text into bytes. Returns `None` unless the text is exactly what
/// `base64_encode` would produce for some bytes.
pub fn base64_decode(text: String) -> Option<Bytes> / {abort.raise} =
  radix::decode(radix::base64(), text)

/// Decodes a secret text as `base64_decode` does, and returns the bytes as a secret. The runtime
/// decodes without revealing the text, in steps that depend only on its length. Returns `None`
/// unless the text is canonical (what `base64_encode` would produce), and that is all the result
/// reveals about the text.
pub fn base64_decode_secret(text: Secret<String>) -> Option<Secret<Bytes>> / {abort.raise} =
  Secret::decode("base64", text)

/// Decodes a secret text as `base64url_decode` does, and returns the bytes as a secret, in the same
/// way as `base64_decode_secret`.
pub fn base64url_decode_secret(text: Secret<String>) -> Option<Secret<Bytes>> / {abort.raise} =
  Secret::decode("base64url", text)

/// Decodes URL-safe unpadded base64 text into bytes. Returns `None` unless the text is exactly what
/// `base64url_encode` would produce for some bytes.
pub fn base64url_decode(text: String) -> Option<Bytes> / {abort.raise} =
  radix::decode(radix::base64url(), text)

/// Checks a `base64"..."` literal. Returns the bytes a padded text in the standard alphabet
/// encodes, or an error with the offset where the text stops being canonical.
pub fn literal(text: String) -> Result<Bytes, { message: String, offset: Int }> / {abort.raise} =
  match radix::parse(radix::base64(), text) {
    Ok(data) -> Ok(data),
    Err(r) ->
      Err({
        message: match r.reason {
          radix::InvalidSymbol -> "not a base64 letter",
          radix::BadPaddedLength -> "padded base64 is a multiple of four characters",
          radix::TrailingSymbol ->
            "the last letter is extra: the bytes are already complete without it",
          radix::NonzeroTrailingBits ->
            "the last letter sets bits that do not belong to any byte, so they must be zero",
        },
        offset: r.at,
      }),
  }

test "decoding an encoding returns the original bytes" {
  gen::check(gen::bytes(), |x: Bytes| round_trip(base64_encode, base64_decode, x))
}

type TestVector = { bytes: Bytes, text: String }

fn rfc_4648() -> List<TestVector> =
  [
    { bytes: b"", text: "" },
    { bytes: b"f", text: "Zg==" },
    { bytes: b"fo", text: "Zm8=" },
    { bytes: b"foo", text: "Zm9v" },
    { bytes: b"foob", text: "Zm9vYg==" },
    { bytes: b"fooba", text: "Zm9vYmE=" },
    { bytes: b"foobar", text: "Zm9vYmFy" },
  ]

test "the RFC 4648 vector of {v.bytes} encodes and decodes" for v: TestVector in rfc_4648() {
  assert_eq(base64_encode(v.bytes), v.text);
  assert_eq(base64_decode(v.text), Some(v.bytes))
}

test "the URL-safe form has no padding and uses `-` and `_` in place of `+` and `/`" {
  assert_eq(base64url_encode(b"\xff\xff\xfe"), "___-");
  assert_eq(base64url_decode("___-"), Some(b"\xff\xff\xfe"));
  assert_eq(base64url_encode(b"foob"), "Zm9vYg");
  assert_eq(base64url_decode("Zm9vYg"), Some(b"foob"));
  assert_eq(base64url_encode(b"f"), "Zg");
  assert_eq(base64url_decode("Zg"), Some(b"f"))
}

test "a decoder rejects any text not in canonical form" {
  assert_eq(base64_decode("Zg"), None);
  assert_eq(base64_decode("Zg="), None);
  assert_eq(base64_decode("Z==="), None);
  assert_eq(base64_decode("Zm9vYg"), None);
  assert_eq(base64_decode("Zm9!"), None);
  assert_eq(base64_decode("Zm9="), None);
  assert_eq(base64url_decode("+/+/"), None);
  assert_eq(base64url_decode("Zg=="), None)
}

test "a secret text decodes and fails exactly as a plain one does" {
  let read = |text: String| base64_decode_secret(Secret::of_string(text));
  let url = |text: String| base64url_decode_secret(Secret::of_string(text));
  assert_eq(read("Zm9vYg=="), Some(Secret::of_bytes(b"foob")));
  assert_eq(read("Zm9vYmE="), Some(Secret::of_bytes(b"fooba")));
  assert_eq(read("+/+/"), Some(Secret::of_bytes(b"\xfb\xff\xbf")));
  assert_eq(read(""), Some(Secret::of_bytes(b"")));
  assert_eq(read("Zg"), None);
  assert_eq(read("Zg="), None);
  assert_eq(read("Z==="), None);
  assert_eq(read("===="), None);
  assert_eq(read("Zm9vYg"), None);
  assert_eq(read("Zm9!"), None);
  assert_eq(read("Zm9="), None);
  assert_eq(read("Zg=a"), None);
  assert_eq(read("___-"), None);
  assert_eq(url("___-"), Some(Secret::of_bytes(b"\xff\xff\xfe")));
  assert_eq(url("Zm9vYg"), Some(Secret::of_bytes(b"foob")));
  assert_eq(url("Zg"), Some(Secret::of_bytes(b"f")));
  assert_eq(url("+/+/"), None);
  assert_eq(url("Zg=="), None);
  assert_eq(url("Z"), None);
  assert_eq(url("Zh"), None)
}

test "`literal` returns the bytes of valid base64 text, or the offset of the first character that is not canonical" {
  assert_eq(literal("Zm9vYg=="), Ok(b"foob"));
  assert_eq(literal(""), Ok(b""));
  assert_eq(literal("Zm9!"), Err({ message: "not a base64 letter", offset: 3 }));
  assert_eq(literal("Zg=a"), Err({ message: "not a base64 letter", offset: 2 }));
  assert_eq(
    literal("Zm9vYg"),
    Err({ message: "padded base64 is a multiple of four characters", offset: 6 }),
  );
  assert_eq(
    literal("Zm9="),
    Err({
      message: "the last letter sets bits that do not belong to any byte, so they must be zero",
      offset: 2,
    }),
  );
  assert_eq(
    literal("Z==="),
    Err({
      message: "the last letter is extra: the bytes are already complete without it",
      offset: 0,
    }),
  )
}
