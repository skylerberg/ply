// A Monte Carlo tree search, in Ply, written the way it would be written to go fast rather than the
// way it would be written to read nicely.

pub type Node = {
  parent: Int,
  action: Int,
  state: Int,
  visits: Int,
  wins: Int,
  children: List<Int>,
  untried: Int,
}

pub type Tree = { nodes: Map<Int, Node>, size: Int, seed: Int }

// ---------------------------------------------------------------- position --

pub fn heap(s: Int, h: Int) -> Int =
  if h == 0 { s % 16 } else if h == 1 { (s / 16) % 16 } else { (s / 256) % 16 }

pub fn turn(s: Int) -> Int = (s / 4096) % 2

pub fn pack(a: Int, b: Int, c: Int, t: Int) -> Int = a + b * 16 + c * 256 + t * 4096

pub fn objects(s: Int) -> Int = heap(s, 0) + heap(s, 1) + heap(s, 2)

pub fn terminal(s: Int) -> Bool = objects(s) == 0

// Normal play: the player who takes the last object wins, so whoever is to move in a terminal
// position has already lost.
pub fn winner(s: Int) -> Int = 1 - turn(s)

// One legal move per object: take between one and all of a heap.
pub fn move_count(s: Int) -> Int = objects(s)

pub fn nth_move(s: Int, i: Int) -> Int = {
  let a = heap(s, 0);
  let b = heap(s, 1);
  if i < a { i + 1 }
  else if i < a + b { 16 + (i - a) + 1 }
  else { 32 + (i - a - b) + 1 }
}

pub fn apply_move(s: Int, m: Int) -> Int = {
  let h = m / 16;
  let n = m % 16;
  let removed = if h == 0 { n } else if h == 1 { n * 16 } else { n * 256 };
  if turn(s) == 0 { s - removed + 4096 } else { s - removed - 4096 }
}

// ------------------------------------------------------------------- oracle --

// Ply has no `^`, so the nim-sum is assembled a bit at a time.
pub fn bit_xor(a: Int, b: Int) -> Int =
  if a == 0 && b == 0 { 0 }
  else { (a % 2 + b % 2) % 2 + 2 * bit_xor(a / 2, b / 2) }

pub fn nim_sum(s: Int) -> Int = bit_xor(bit_xor(heap(s, 0), heap(s, 1)), heap(s, 2))

// ---------------------------------------------------------------- randomness --

// A 31-bit linear congruential generator, threaded rather than performed.
pub fn next_seed(seed: Int) -> Int = (seed * 1103515245 + 12345) % 2147483648

pub fn below(seed: Int, n: Int) -> Int = (seed / 65536) % n

// ---------------------------------------------------------------- arithmetic --

pub fn ilog2(n: Int) -> Int = if n < 2 { 0 } else { 1 + ilog2(n / 2) }

fn isqrt_step(n: Int, x: Int) -> Int = {
  let y = (x + n / x) / 2;
  if y >= x { x } else { isqrt_step(n, y) }
}

// Newton's method from `n / 2`.
pub fn isqrt(n: Int) -> Int = if n < 2 { n } else { isqrt_step(n, n / 2) }

// UCB1 in 1024ths.
pub fn ucb(wins: Int, visits: Int, parent_visits: Int) -> Int =
  if visits == 0 { 1073741823 }
  else {
    let exploit = (wins * 1024) / visits;
    let ln = ilog2(parent_visits) * 710;
    let explore = isqrt((ln * 1048576) / visits) / 32;
    exploit + (explore * 1414) / 1000
  }

// ------------------------------------------------------------------ rollout --

// Bounded: `fuel` caps the playout, and a playout that runs out is scored from the position it
// stopped in rather than abandoned.
pub fn rollout(s: Int, seed: Int, fuel: Int) -> Int =
  if terminal(s) { winner(s) }
  else if fuel <= 0 { winner(s) }
  else {
    let r = next_seed(seed);
    let m = nth_move(s, below(r, move_count(s)));
    rollout(apply_move(s, m), r, fuel - 1)
  }

// --------------------------------------------------------------------- tree --

pub fn empty_node() -> Node =
  { parent: -1, action: -1, state: 0, visits: 0, wins: 0, children: [], untried: 0 }

pub fn node_at(t: Tree, id: Int) -> Node =
  match map_get(t.nodes, id) {
    Some(n) -> n,
    None -> empty_node(),
  }

pub fn fresh(parent: Int, action: Int, state: Int) -> Node =
  { parent: parent, action: action, state: state, visits: 0, wins: 0,
    children: [], untried: move_count(state) }

pub fn root(state: Int, seed: Int) -> Tree =
  { nodes: map_insert(map_new(), 0, fresh(-1, -1, state)), size: 1, seed: seed }

fn put(t: Tree, id: Int, n: Node) -> Tree =
  { nodes: map_insert(t.nodes, id, n), size: t.size, seed: t.seed }

pub fn best_child(t: Tree, cs: List<Int>, pv: Int, best: Int, top: Int) -> Int =
  match cs {
    [c, ..rest] -> {
      let n = node_at(t, c);
      let s = ucb(n.wins, n.visits, pv);
      if best < 0 || s > top { best_child(t, rest, pv, c, s) }
      else { best_child(t, rest, pv, best, top) }
    },
    _ -> best,
  }

// Descend by UCB until a node with an untried move or no move at all.
pub fn select(t: Tree, id: Int) -> Int = {
  let n = node_at(t, id);
  if n.untried > 0 || len(n.children) == 0 { id }
  else { select(t, best_child(t, n.children, n.visits, -1, 0)) }
}

pub fn expand(t: Tree, id: Int) -> Tree = {
  let p = node_at(t, id);
  let k = move_count(p.state) - p.untried;
  let m = nth_move(p.state, k);
  let cid = t.size;
  let child = fresh(id, m, apply_move(p.state, m));
  let grown = { nodes: map_insert(t.nodes, cid, child), size: t.size + 1, seed: t.seed };
  put(grown, id,
      { parent: p.parent, action: p.action, state: p.state, visits: p.visits,
        wins: p.wins, children: push(p.children, cid), untried: p.untried - 1 })
}

// A node's `wins` counts playouts won by the player who moved into it.
fn backprop(t: Tree, id: Int, w: Int) -> Tree =
  if id < 0 { t }
  else {
    let n = node_at(t, id);
    let hit = if w == 1 - turn(n.state) { 1 } else { 0 };
    let t2 = put(t, id,
      { parent: n.parent, action: n.action, state: n.state, visits: n.visits + 1,
        wins: n.wins + hit, children: n.children, untried: n.untried });
    backprop(t2, n.parent, w)
  }

pub fn iterate(t: Tree) -> Tree = {
  let leaf = select(t, 0);
  let n = node_at(t, leaf);
  let grown = if n.untried > 0 { expand(t, leaf) } else { t };
  let target = if n.untried > 0 { grown.size - 1 } else { leaf };
  let seed = next_seed(t.seed);
  let w = rollout(node_at(grown, target).state, seed, 64);
  backprop({ nodes: grown.nodes, size: grown.size, seed: seed }, target, w)
}

pub fn search(t: Tree, n: Int) -> Tree =
  if n <= 0 { t } else { search(iterate(t), n - 1) }

fn most_visited(t: Tree, cs: List<Int>, best: Int, top: Int) -> Int =
  match cs {
    [c, ..rest] -> {
      let n = node_at(t, c);
      if best < 0 || n.visits > top { most_visited(t, rest, c, n.visits) }
      else { most_visited(t, rest, best, top) }
    },
    _ -> best,
  }

pub fn best_action(t: Tree) -> Int = {
  let r = node_at(t, 0);
  let c = most_visited(t, r.children, -1, 0);
  if c < 0 { -1 } else { node_at(t, c).action }
}

// The whole kernel behind one name.
pub fn plan(state: Int, seed: Int, n: Int) -> Int =
  best_action(search(root(state, seed), n))

// The two entry points the measurement times, so that neither is a name only the harness knows.
pub fn plan_753(n: Int) -> Int = plan(pack(7, 5, 3, 0), 20260821, n)

pub fn playouts(s: Int, seed: Int, n: Int) -> Int =
  if n <= 0 { 0 }
  else { rollout(s, seed, 64) + playouts(s, next_seed(seed), n - 1) }

// --------------------------------------------------------------------- tests --

test "a position round-trips through its packing" {
  let s = pack(7, 5, 3, 0);
  assert_eq(heap(s, 0), 7);
  assert_eq(heap(s, 1), 5);
  assert_eq(heap(s, 2), 3);
  assert_eq(turn(s), 0);
  assert_eq(objects(s), 15);
  assert_eq(turn(pack(1, 2, 3, 1)), 1)
}

test "every legal move takes at least one object and passes the turn" {
  let s = pack(7, 5, 3, 0);
  assert_eq(move_count(s), 15);
  assert_eq(nth_move(s, 0), 1);
  assert_eq(objects(apply_move(s, nth_move(s, 0))), 14);
  assert_eq(turn(apply_move(s, nth_move(s, 0))), 1);
  assert_eq(nth_move(s, 7), 17);
  assert_eq(heap(apply_move(s, 17), 1), 4);
  assert_eq(nth_move(s, 12), 33);
  assert_eq(heap(apply_move(s, 33), 2), 2)
}

test "the nim-sum agrees with the positions Nim theory calls lost" {
  assert_eq(nim_sum(pack(1, 1, 0, 0)), 0);
  assert_eq(nim_sum(pack(7, 5, 3, 0)), 1);
  assert_eq(nim_sum(pack(6, 5, 3, 0)), 0);
  assert_eq(bit_xor(12, 10), 6)
}

test "the arithmetic the exploration term is built from" {
  assert_eq(ilog2(1), 0);
  assert_eq(ilog2(1024), 10);
  assert_eq(isqrt(0), 0);
  assert_eq(isqrt(1), 1);
  assert_eq(isqrt(2), 1);
  assert_eq(isqrt(144), 12);
  assert_eq(isqrt(145), 12);
  assert_eq(isqrt(1000000), 1000);
  assert(ucb(0, 0, 10) > ucb(1, 1, 10));
  assert(ucb(5, 10, 100) > ucb(1, 10, 100))
}

test "a rollout is a function of its seed and always names a winner" {
  let s = pack(7, 5, 3, 0);
  assert_eq(rollout(s, 1, 64), rollout(s, 1, 64));
  assert(rollout(s, 1, 64) == 0 || rollout(s, 1, 64) == 1);
  assert_eq(rollout(pack(0, 0, 0, 0), 1, 64), 1);
  assert_eq(rollout(pack(0, 0, 0, 1), 1, 64), 0);
  assert_eq(rollout(pack(1, 0, 0, 0), 1, 64), 0)
}

test "the search is deterministic in its seed" {
  assert_eq(plan(pack(3, 2, 0, 0), 7, 80), plan(pack(3, 2, 0, 0), 7, 80))
}

test "the search finds the move Nim theory calls winning" {
  let s = pack(2, 1, 0, 0);
  let m = plan(s, 7, 120);
  assert_eq(nim_sum(apply_move(s, m)), 0)
}
