// ADR 0035's two kernels, the Ply side. `run.sh` writes `input.ply` beside this file with the
// K1 input as a byte literal and the digest the Rust bar printed, so the two arms hash identical
// bytes and a transliteration that drifts fails the test rather than the comparison.

import std.hash (blake3)
import input (k1_input, k1_digest)

test "kernel: k1 blake3" { assert_eq(blake3(k1_input()), k1_digest()) }

type State = { count: Int, total: Int, seen: List<Int>, names: Map<Bytes, Int>, last: Bytes }

fn key_of(x: Int) -> Bytes = bytes_concat_all([b"k", byte_of_int(65 + (x % 26))])

fn step(s: State, x: Int) -> State = {
  let k = key_of(x);
  let seen = if x % 3 == 0 { push(s.seen, x) } else { s.seen };
  let names = map_insert(s.names, k, match map_get(s.names, k) { Some(n) -> n + 1, None -> 1 });
  {..s, count: s.count + 1, total: s.total + x, seen: seen, names: names, last: k}
}

fn run(n: Int) -> State =
  fold(range(0, n), {count: 0, total: 0, seen: [], names: map_new(), last: b""}, step)

fn k2_steps() -> Int = 200000

test "kernel: k2 state" {
  let s = run(k2_steps());
  assert_eq(s.count, k2_steps());
  assert_eq(len(s.seen), (k2_steps() + 2) / 3);
  assert_eq(map_len(s.names), 26)
}
