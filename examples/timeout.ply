//! Deadlines and backoff against a virtual clock.

import std.time (nanos, millis, seconds, plus, scaled)

effect job {
  read state[r]() -> Outcome
  write finish[r](result: Outcome) -> Unit
}

type Outcome = | Pending | Done(Int) | TimedOut

/// First writer wins, which is what makes "the work finished" and "the deadline passed" a race
/// rather than a last-one-clobbers.
fn claim(result: Outcome) -> Unit / {job.read[status], job.write[status]} =
  match job.state[status]() { Pending -> job.finish[status](result), _ -> () }

fn work(
  latency: Duration,
  result: Int,
) -> Unit / {job.read[status], job.write[status], clock.write} = {
  clock.sleep(latency);
  claim(Done(result))
}

fn deadline(budget: Duration) -> Unit / {job.read[status], job.write[status], clock.write} = {
  clock.sleep(budget);
  claim(TimedOut)
}

/// Work that never sleeps.
fn grind(rounds: Int) -> Int / {task.write} =
  if rounds <= 0 { 0 } else {
    task.yield();
    1 + grind(rounds - 1)
  }

fn busy(rounds: Int) -> Unit / {job.read[status], job.write[status], task.write} = {
  let done = grind(rounds);
  claim(Done(done))
}

fn backoff(attempts: Int, wait: Duration) -> Duration / {clock.write} =
  if attempts <= 0 { nanos(0) } else {
    clock.sleep(wait);
    plus(wait, backoff(attempts - 1, scaled(wait, 2)))
  }

test "work that fits inside the budget finishes, and the deadline finds it done" {
  with_cell[status](Pending) { s -> {
    handle {
      simulate {
        let w = task.spawn(|| work(millis(40), 7));
        let d = task.spawn(|| deadline(millis(100)));
        task.join(w);
        task.join(d);
        assert_eq(cell_get(s), Done(7));
        assert_eq(clock.now(), Instant(100_000_000))
      }
    } with {
      job.state[status]() -> cell_get(s),
      job.finish[status](result) -> cell_set(s, result),
    }
  } }
}

test "work that overruns the budget loses to the deadline" {
  with_cell[status](Pending) { s -> {
    handle {
      simulate {
        let w = task.spawn(|| work(millis(250), 7));
        let d = task.spawn(|| deadline(millis(100)));
        task.join(w);
        task.join(d);
        assert_eq(cell_get(s), TimedOut);
        assert_eq(clock.now(), Instant(250_000_000))
      }
    } with {
      job.state[status]() -> cell_get(s),
      job.finish[status](result) -> cell_set(s, result),
    }
  } }
}

// The property a wall-clock timeout cannot have.
test "a deadline cannot fire while the worker can still run" {
  with_cell[status](Pending) { s -> {
    handle {
      simulate {
        let w = task.spawn(|| busy(4));
        let d = task.spawn(|| deadline(nanos(1)));
        task.join(w);
        task.join(d);
        assert_eq(cell_get(s), Done(4));
        assert_eq(clock.now(), Instant(1))
      }
    } with {
      job.state[status]() -> cell_get(s),
      job.finish[status](result) -> cell_set(s, result),
    }
  } }
}

test "four exponential backoffs are a second and a half, and cost no wall clock" {
  simulate {
    let t = task.spawn(|| backoff(4, millis(100)));
    assert_eq(task.join(t), millis(1500));
    assert_eq(clock.now(), Instant(1_500_000_000))
  }
}

test "thirty seconds of virtual time is a jump, not a wait" {
  simulate {
    let t = task.spawn(|| {
      clock.sleep(seconds(30));
      clock.now()
    });
    assert_eq(task.join(t), Instant(30_000_000_000));
    assert_eq(clock.now(), Instant(30_000_000_000))
  }
}

test "virtual time stands still while anything at all can run" {
  simulate {
    let a = task.spawn(|| grind(3));
    let b = task.spawn(|| grind(3));
    assert_eq(task.join(a) + task.join(b), 6);
    assert_eq(clock.now(), Instant(0))
  }
}

test "an outcome is claimed once and the loser leaves it alone" {
  with_cell[status](Pending) { s -> {
    handle {
      claim(Done(1));
      claim(TimedOut);
      assert_eq(cell_get(s), Done(1))
    } with {
      job.state[status]() -> cell_get(s),
      job.finish[status](result) -> cell_set(s, result),
    }
  } }
}

/// A deadline over any work: the timer cancels the worker, or the worker answers first and the timer
/// is cancelled instead. Whichever loses performs nothing more.
fn within<a>(d: Duration, work: () -> a / {clock.write}) -> Option<a> / {task.write, clock.write} = {
  let worker = task.spawn(work);
  let timer = task.spawn(|| {
    clock.sleep(d);
    task.cancel(worker);
    ()
  });
  let answer = task.await(worker);
  task.cancel(timer);
  answer
}

fn nap(d: Duration) -> Int / {clock.write} = {
  clock.sleep(d);
  7
}

test "a deadline answers work that finishes inside it and stops work that does not" {
  simulate {
    assert_eq(within(millis(100), || nap(millis(40))), Some(7));
    assert_eq(within(millis(100), || nap(millis(250))), None);
    assert_eq(clock.now(), Instant(140_000_000))
  }
}
