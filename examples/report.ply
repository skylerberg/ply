// A second module's view of the ledger. Nothing here re-derives a figure:
// `report` imports what `ledger` exports and presents it. That is the point —
// the import is the only reason `ledger`'s definitions are reachable here, and
// it changes none of their hashes. Move `presented` into this file and every
// hash in the project stays exactly where it is.

import ledger

type Line = { code: String, amount: Int }

fn figure(chart: List<ledger::Account>, book: List<ledger::Entry>, code: String) -> Int =
  match ledger::presented(chart, book, code) {
    ledger::Some(amount) -> amount,
    ledger::None -> 0,
  }

fn line(chart: List<ledger::Account>, book: List<ledger::Entry>, code: String) -> Line =
  {code: code, amount: figure(chart, book, code)}

fn statement(chart: List<ledger::Account>, book: List<ledger::Entry>, codes: List<String>) -> List<Line> =
  map(codes, |code: String| line(chart, book, code))

fn total(lines: List<Line>) -> Int =
  fold(lines, 0, |acc, l: Line| acc + l.amount)

fn subtotal(chart: List<ledger::Account>, book: List<ledger::Entry>, codes: List<String>) -> Int =
  total(statement(chart, book, codes))

fn assets() -> List<String> = ["cash", "receivable"]

fn revenues() -> List<String> = ["sales"]

fn expenses() -> List<String> = ["rent"]

fn contributed() -> List<String> = ["capital"]

// `ledger` presents credit-normal accounts positive already, so this is a
// difference rather than a sum.
fn net_income(chart: List<ledger::Account>, book: List<ledger::Entry>) -> Int =
  subtotal(chart, book, revenues()) - subtotal(chart, book, expenses())

fn closing_equity(chart: List<ledger::Account>, book: List<ledger::Entry>) -> Int =
  subtotal(chart, book, contributed()) + net_income(chart, book)

// Exactly one module under `examples/` declares `main`, which is what lets a
// directory have an entry point at all: with two, `ply run` reports both rather
// than picking by load order.
fn main() -> Int = closing_equity(ledger::chart(), ledger::journal())

test "a statement has one line per code, in the order asked for" {
  let lines = statement(ledger::chart(), ledger::journal(), ["rent", "cash"]);
  assert_eq(map(lines, |l: Line| l.code), ["rent", "cash"]);
  assert_eq(map(lines, |l: Line| l.amount), [120000, 470000])
}

test "an account the chart does not name presents as zero" {
  assert_eq(figure(ledger::chart(), ledger::journal(), "goodwill"), 0);
  assert_eq(subtotal(ledger::chart(), ledger::journal(), ["goodwill"]), 0);
  assert_eq(total(statement(ledger::chart(), [], assets())), 0)
}

test "the books close: assets equal contributed capital plus retained earnings" {
  let chart = ledger::chart();
  let book = ledger::journal();
  assert_eq(subtotal(chart, book, assets()), 470000);
  assert_eq(net_income(chart, book), -30000);
  assert_eq(closing_equity(chart, book), 470000);
  assert_eq(subtotal(chart, book, assets()), closing_equity(chart, book))
}

// A module binder lives in its own namespace, reachable only through `::`, so
// this shadows nothing.
test "a local named `ledger` does not hide the module binder `ledger`" {
  let ledger = ledger::journal();
  assert_eq(len(ledger), 4);
  assert_eq(figure(ledger::chart(), ledger, "cash"), 470000)
}
