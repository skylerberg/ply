import ledger

type Line = { code: String, amount: Int }

fn reported_balance(chart: List<ledger::Account>, book: List<ledger::Entry>, code: String) -> Int =
  match ledger::reported_balance(chart, book, code) { Some(amount) -> amount, None -> 0 }

fn line(chart: List<ledger::Account>, book: List<ledger::Entry>, code: String) -> Line =
  { code: code, amount: reported_balance(chart, book, code) }

fn statement(
  chart: List<ledger::Account>,
  book: List<ledger::Entry>,
  codes: List<String>,
) -> List<Line> = codes.map(|code: String| line(chart, book, code))

fn total(lines: List<Line>) -> Int = lines.fold(0, |accumulator, l: Line| accumulator + l.amount)

fn subtotal(chart: List<ledger::Account>, book: List<ledger::Entry>, codes: List<String>) -> Int =
  total(statement(chart, book, codes))

fn assets() -> List<String> = ["cash", "receivable"]

fn revenues() -> List<String> = ["sales"]

fn expenses() -> List<String> = ["rent"]

fn contributed() -> List<String> = ["capital"]

fn net_income(chart: List<ledger::Account>, book: List<ledger::Entry>) -> Int =
  subtotal(chart, book, revenues()) - subtotal(chart, book, expenses())

fn closing_equity(chart: List<ledger::Account>, book: List<ledger::Entry>) -> Int =
  subtotal(chart, book, contributed()) + net_income(chart, book)

fn debited(book: List<ledger::Entry>) -> Int =
  book.fold(0, |accumulator, e: ledger::Entry|
    e.postings.fold(accumulator, |sum, p: ledger::Posting|
      if p.amount > 0 { sum + p.amount } else { sum }))

test "`statement` has one line for each requested account code, in the requested order" {
  let lines = statement(ledger::chart_of_accounts(), ledger::journal(), ["rent", "cash"]);
  assert_eq(lines.map(|l: Line| l.code), ["rent", "cash"]);
  assert_eq(lines.map(|l: Line| l.amount), [120000, 470000])
}

test "`debited` sums the debit amounts of all postings in a journal, and is zero for an empty journal" {
  assert_eq(debited(ledger::journal()), 800000);
  assert_eq(debited([]), 0)
}

test "an account missing from the chart of accounts has a reported balance of zero and adds nothing to subtotals or statements" {
  assert_eq(reported_balance(ledger::chart_of_accounts(), ledger::journal(), "goodwill"), 0);
  assert_eq(subtotal(ledger::chart_of_accounts(), ledger::journal(), ["goodwill"]), 0);
  assert_eq(total(statement(ledger::chart_of_accounts(), [], assets())), 0)
}

test "the books close: assets equal contributed capital plus retained earnings" {
  let chart = ledger::chart_of_accounts();
  let book = ledger::journal();
  assert_eq(subtotal(chart, book, assets()), 470000);
  assert_eq(net_income(chart, book), -30000);
  assert_eq(closing_equity(chart, book), 470000);
  assert_eq(subtotal(chart, book, assets()), closing_equity(chart, book))
}

test "a local variable named `ledger` does not shadow the module `ledger`, so `ledger::journal()` still resolves" {
  let ledger = ledger::journal();
  assert_eq(ledger.len(), 4);
  assert_eq(reported_balance(ledger::chart_of_accounts(), ledger, "cash"), 470000)
}
