import std.db
import std.sql
import std.db (db)

pub fn fixture() -> sql::Schema = { tables: [part(), bin()] }

fn part() -> sql::Table =
  {
    name: "part",
    columns: [
      sql::column("sku", sql::TText, false),
      sql::column("price", sql::TNumeric(10, 4), false),
      sql::column("tag", sql::TText, true),
      sql::column("n", sql::IntColumn, true),
    ],
    primary_key: ["sku"],
    unique: [{ name: "part_tag_key", columns: ["tag"] }],
    foreign_keys: [],
    checks: [{ name: "part_price_check", expression: "price >= 0" }],
  }

fn bin() -> sql::Table =
  {
    name: "bin",
    columns: [
      sql::column_default("id", sql::IntColumn, false, sql::SequenceDefault("bin_id_seq")),
      sql::column("sku", sql::TText, true),
      sql::column("qty", sql::IntColumn, true),
    ],
    primary_key: ["id"],
    unique: [],
    foreign_keys: [
      { name: "bin_sku_fkey", columns: ["sku"], references: "part", refers_to: ["sku"] },
    ],
    checks: [{ name: "bin_qty_check", expression: "qty >= 0" }],
  }

type Step = { sql: String, ps: List<sql::Param> }

type Run = { db: db::MemDb, out: List<sql::QueryResult> }

fn replay(steps: List<Step>) -> List<sql::QueryResult> / {abort.raise} =
  steps.fold({ db: db::open(fixture()), out: [] }, |accumulator: Run, s: Step| {
    let r = db::step(accumulator.db, sql::statement_of(s.sql), s.ps);
    { db: r.db, out: accumulator.out.push(r.out) }
  }).out

fn last_result(steps: List<Step>) -> sql::QueryResult / {abort.raise} = last_of(replay(steps))

fn last_of(xs: List<sql::QueryResult>) -> sql::QueryResult =
  match xs {
    [] -> sql::Failed(sql::db_error("", "", "nothing ran")),
    [x] -> x,
    [_, ..t] -> last_of(t),
  }

fn sql_step(sql: String) -> Step = { sql: sql, ps: [] }

fn insert_part(sku: String, n: sql::Param) -> Step =
  {
    sql: "insert into part (sku, price, tag, n) values ($1, $2, $3, $4)",
    ps: [sql::TextParameter(sku), sql::NumericParameter(1m), sql::NullParameter, n],
  }

fn shape(a: sql::QueryResult) -> String =
  match a {
    sql::Failed(e) -> "Failed " ++ e.code,
    sql::Count(n) -> "Count " ++ n.to_string(),
    sql::Rows(rs) -> "Rows " ++ rs.len().to_string(),
  }

fn skus(a: sql::QueryResult) -> List<String> =
  match a {
    sql::Rows(rs) ->
      rs.map(|r: sql::Row| match r.get("sku") { Some(sql::TextDatum(s)) -> s, _ -> "?" }),
    _ -> [],
  }

test "an ORDER BY over a column with ties returns an order SQL does not promise" {
  let twelve = range(0, 12).fold([], |accumulator: List<Step>, i: Int|
    accumulator.push(insert_part(letter(i), sql::IntParameter(1))));
  let result = last_result(twelve.push(sql_step("select sku from part order by n limit 3")));
  assert_eq(skus(result), ["a", "b", "c"]);
  assert(skus(result) != ["b", "c", "a"]);

  let keyed = last_result(twelve.push(sql_step("select sku from part order by n, sku limit 3")));
  assert_eq(skus(keyed), ["a", "b", "c"])
}

fn letter(i: Int) -> String / {abort.raise} = "abcdefghijkl".slice(i, i + 1)

test "an UPDATE moves a row in postgres and leaves it in place in the fake" {
  let operations = [
    insert_part("a", sql::IntParameter(5)),
    insert_part("b", sql::IntParameter(5)),
    insert_part("c", sql::IntParameter(5)),
    {
      sql: "update part set n = $1 where sku = $2",
      ps: [sql::IntParameter(5), sql::TextParameter("a")],
    },
  ];
  let loose = last_result(operations.push(sql_step("select sku from part order by n limit 10")));
  assert_eq(skus(loose), ["a", "b", "c"]);
  assert(skus(loose) != ["b", "c", "a"]);

  let keyed = last_result(
    operations.push(sql_step("select sku from part order by n, sku limit 10")),
  );
  assert_eq(skus(keyed), ["a", "b", "c"])
}

test "a WHERE naming a column that does not exist is rejected on an empty table" {
  assert_eq(
    shape(last_result([sql_step("select sku from part where nosuch = 1")])),
    "Failed 42703",
  );
  assert_eq(
    shape(last_result([{ sql: "delete from part where nosuch = $1", ps: [sql::IntParameter(1)] }])),
    "Failed 42703",
  );
  assert_eq(
    shape(
      last_result([
        {
          sql: "update part set n = $1 where nosuch = $2",
          ps: [sql::IntParameter(1), sql::IntParameter(1)],
        },
      ]),
    ),
    "Failed 42703",
  );
  assert_eq(shape(last_result([sql_step("select nosuch from part")])), "Failed 42703")
}

test "a literal that will not parse at the column's type is rejected when the statement is planned" {
  let with_null = last_result([
    insert_part("a", sql::NullParameter),
    sql_step("select sku from part where n = 'abc'"),
  ]);
  let with_value = last_result([
    insert_part("a", sql::IntParameter(3)),
    sql_step("select sku from part where n = 'abc'"),
  ]);
  let empty = last_result([sql_step("select sku from part where n = 'abc'")]);
  assert_eq(shape(with_null), "Failed 22P02");
  assert_eq(shape(with_value), "Failed 22P02");
  assert_eq(shape(empty), "Failed 22P02");

  assert_eq(
    shape(
      last_result([
        insert_part("a", sql::IntParameter(3)),
        sql_step("select sku from part where n = '3'"),
      ]),
    ),
    "Rows 1",
  )
}

test "a numeric is assignment-cast into a bigint column, rounding half away from zero" {
  assert_eq(
    shape(last_result([sql_step("insert into part (sku, price, n) values ('x', 1, 2.6)")])),
    "Count 1",
  );
  assert_eq(
    n_column_values(
      last_result([
        sql_step("insert into part (sku, price, n) values ('a', 1, 2.5)"),
        sql_step("insert into part (sku, price, n) values ('b', 1, 3.5)"),
        sql_step("insert into part (sku, price, n) values ('c', 1, -2.5)"),
        sql_step("select sku, n from part order by sku"),
      ]),
    ),
    [3, 4, -3],
  );
  assert_eq(
    shape(
      last_result([
        insert_part("z", sql::IntParameter(2)),
        sql_step("update part set n = 3.4 where sku = 'z'"),
      ]),
    ),
    "Count 1",
  )
}

fn n_column_values(a: sql::QueryResult) -> List<Int> =
  match a {
    sql::Rows(rs) ->
      rs.map(|r: sql::Row| match r.get("n") { Some(sql::IntDatum(n)) -> n, _ -> -999 }),
    _ -> [],
  }

test "a string literal is coerced to the column's type, and only an unparseable one fails with SQLSTATE 22P02" {
  assert_eq(
    shape(last_result([sql_step("insert into part (sku, price, n) values ('y', '1', '2')")])),
    "Count 1",
  );
  assert_eq(
    shape(
      last_result([
        insert_part("z", sql::IntParameter(2)),
        sql_step("update part set n = '9' where sku = 'z'"),
      ]),
    ),
    "Count 1",
  );
  assert_eq(
    shape(last_result([sql_step("insert into part (sku, price) values ('y', 'abc')")])),
    "Failed 22P02",
  );
  assert_eq(
    shape(last_result([sql_step("insert into part (sku, price, n) values ('y', 1, '2.6')")])),
    "Failed 22P02",
  );
  assert_eq(
    shape(
      last_result([
        {
          sql: "insert into part (sku, price, n) values ($1, 1, $2)",
          ps: [sql::TextParameter("y"), sql::TextParameter("2")],
        },
      ]),
    ),
    "Failed 42804",
  )
}

test "an UPDATE can assign an integer column to a numeric column and a numeric column to an integer column" {
  assert_eq(
    shape(
      last_result([insert_part("a", sql::IntParameter(2)), sql_step("update part set n = price")]),
    ),
    "Count 1",
  );
  assert_eq(
    shape(
      last_result([insert_part("a", sql::IntParameter(2)), sql_step("update part set price = n")]),
    ),
    "Count 1",
  )
}

test "comments and aliases are accepted, but ORDER BY with a column number fails with SQLSTATE 0A000" {
  assert_eq(shape(last_result([sql_step("select sku from part -- trailing comment")])), "Rows 0");
  assert_eq(shape(last_result([sql_step("select /* leading */ sku from part")])), "Rows 0");
  assert_eq(shape(last_result([sql_step("select count(*) as c from part")])), "Rows 1");
  assert_eq(shape(last_result([sql_step("select sku from part order by 1")])), "Failed 0A000")
}

test "a select with a duplicate result column fails with SQLSTATE 0A000 before returning any row" {
  assert_eq(shape(last_result([sql_step("select sku, sku from part")])), "Failed 0A000");
  assert_eq(
    shape(
      last_result([insert_part("a", sql::NullParameter), sql_step("select sku, sku from part")]),
    ),
    "Failed 0A000",
  );
  assert_eq(shape(last_result([sql_step("select sku as x, tag as x from part")])), "Failed 0A000")
}

test "a commit or abort with no transaction open fails with SQLSTATE 25P01 in both the in-memory database and the Postgres driver" {
  let d = db::open(fixture());
  assert_eq(shape(db::commit_step(d).out), "Failed 25P01");
  assert_eq(shape(db::abort_step(d).out), "Failed 25P01");
  assert_eq(
    shape(
      db::step(
        db::commit_step(d).db,
        sql::statement_of("insert into part (sku, price) values ($1, $2)"),
        [sql::TextParameter("a"), sql::NumericParameter(1m)],
      ).out,
    ),
    "Count 1",
  )
}

test "a nested begin that widens the access mode from read-only to read-write fails with SQLSTATE 25001 in both the in-memory database and the Postgres driver" {
  let d = db::open(fixture());
  let outer = db::begin_step(d, db::ReadCommitted, db::ReadOnly);
  let inner = db::begin_step(outer.db, db::ReadCommitted, db::ReadWrite);
  assert_eq(shape(outer.out), "Count 0");
  assert_eq(shape(inner.out), "Failed 25001");
  assert_eq(
    shape(
      db::begin_step(
        db::begin_step(d, db::ReadCommitted, db::ReadWrite).db,
        db::ReadCommitted,
        db::ReadOnly,
      ).out,
    ),
    "Count 0",
  )
}

test "NULL handling in WHERE and ORDER BY gives the same results as postgres" {
  let operations = [
    insert_part("a", sql::IntParameter(1)),
    insert_part("b", sql::NullParameter),
    insert_part("c", sql::IntParameter(3)),
    sql_step("select sku from part where n in (1, null) order by sku"),
    sql_step("select sku from part where n not in (1, null) order by sku"),
    sql_step("select sku from part where n not in (3) order by sku"),
    sql_step("select sku from part where not (n = 1) order by sku"),
    sql_step("select sku from part where n between 1 and 3 order by sku"),
  ];
  let out = replay(operations);
  assert_eq(drop_first(out, 3).map(|a: sql::QueryResult| skus(a)), [
    ["a"],
    [],
    ["a"],
    ["c"],
    ["a", "c"],
  ]);

  let nulls = replay([
    insert_part("a", sql::IntParameter(1)),
    insert_part("b", sql::NullParameter),
    insert_part("c", sql::IntParameter(3)),
    sql_step("select sku from part order by n"),
    sql_step("select sku from part order by n desc"),
    sql_step("select sku from part order by n asc nulls first"),
    sql_step("select sku from part order by n desc nulls last"),
  ]);
  assert_eq(drop_first(nulls, 3).map(|a: sql::QueryResult| skus(a)), [
    ["a", "c", "b"],
    ["b", "c", "a"],
    ["b", "a", "c"],
    ["c", "a", "b"],
  ]);

  let money = replay([
    sql_step("insert into part (sku, price) values ('a', 1.00005)"),
    sql_step("insert into part (sku, price) values ('b', 1.00004)"),
    sql_step("insert into part (sku, price) values ('c', 999999.99995)"),
    sql_step("select sku, price from part order by sku"),
  ]);
  assert_eq(money.map(|a: sql::QueryResult| shape(a)), [
    "Count 1",
    "Count 1",
    "Failed 22003",
    "Rows 2",
  ]);

  assert_eq(
    shape(
      last_result([insert_part("a", sql::NullParameter), insert_part("b", sql::NullParameter)]),
    ),
    "Count 1",
  );

  let aborted = replay([
    { sql: "insert into part (sku, price) values ('a', 1)", ps: [] },
    { sql: "insert into bin (sku, qty) values ('a', 1) returning id", ps: [] },
    { sql: "insert into bin (sku, qty) values ('zz', 1)", ps: [] },
    { sql: "insert into bin (sku, qty) values ('a', 2) returning id", ps: [] },
  ]);
  assert_eq(aborted.map(|a: sql::QueryResult| shape(a)), [
    "Count 1",
    "Rows 1",
    "Failed 23503",
    "Rows 1",
  ])
}

fn drop_first<a>(xs: List<a>, n: Int) -> List<a> =
  if n <= 0 { xs } else { match xs { [] -> [], [_, ..t] -> drop_first(t, n - 1) } }
