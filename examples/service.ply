//! A multi-route HTTP service that sells parts, over postgres or an in-memory fake of it, whose
//! types are its documentation — and which can be started, watched, and stopped without losing a
//! request. How it runs is configuration (`config` below):
//!
//!   ply run examples/service.ply --config-schema service.config \
//!     --set SERVICE_API_KEY=… --set SERVICE_STORE=memory --set SERVICE_ACCEPT=task-per-connection
//!
//! and over TLS it is given a credential and told its name: `--tls service=CERT,KEY --set
//! SERVICE_TLS=service`.

import std.net (net, send_all)
import std.net
import std.ip
// Twice, and both are needed: the selective import binds the effect name, so that a row and a
// perform can both say `db.query[items]`, and the plain import binds the module, so that a type
// can say `sql::Answer` and a call can say `db::transaction`.
import std.db
import std.sql
import std.db (db, with_server)
import std.random (entropy)
import std.json
import std.gen
import std.gen (Gen)
import std.http
import std.seq
import std.seq (Seq)
import std.router
// Tracing, configuration and the stop signal, each twice for the reason above.
import std.trace
import std.trace (trace)
import std.config
import std.config (config)
import std.signal
import std.signal (signal)
import std.process (process)

// --- The store ----------------------------------------------------------------

/// The service used to declare `effect log { write note(line: String) -> Unit }`, a singleton
/// effect for the one audit trail it had.
effect set Store = {db.query[items], db.execute[items], db.query[orders], db.execute[orders], db.returning[orders], db.begin, db.commit, db.abort, db.rollback}

/// Placing an order and cancelling one both read the shelf, write the shelf, read the order book,
/// write the order book, open a transaction, record on the order book's channel and record on the
/// shelf's.
effect set Service = {Store, trace.enter[orders], trace.exit[orders], trace.event[orders], trace.count[orders], trace.event[items]}

/// What the *serving* layer performs, which is strictly more: the request span on the `http`
/// channel, the credential the API-key check reads, and the stop flag the readiness route consults.
effect set Serving = {Service, trace.enter[http], trace.exit[http], trace.event[http], config.secret[credentials], signal.stopping}

/// What the *entry point* performs, which is `Serving` without the database: a run reads where to
/// reach its database and serves every `db` operation from there, so no row names `db` and a host
/// needs no database of its own.
effect set Running = {trace.enter[orders], trace.exit[orders], trace.event[orders], trace.count[orders], trace.event[items], trace.enter[http], trace.exit[http], trace.event[http], config.get[server], config.secret[credentials], signal.stopping, net.listen[listener], net.listen_tls[listener], net.local_port[listener], net.accept[listener], net.close[listener], net.recv[conn], net.send[conn], net.close[conn], net.connect[link], net.start_tls[link], net.peer_certificate[link], net.send_secret[link], net.send[link], net.recv[link], net.close[link], entropy.next, task.write, clock.read, process.out[proc]}  // The driver reaches its server over connections of its own, which is what `with_server` performs.
// A task per connection, when the settings ask for one.
// The line that says which port the service landed on.

// --- What the service sells --------------------------------------------------------

pub type Item = { sku: String, name: String, price: Decimal, on_hand: Int }

pub type Line = { sku: String, qty: Int }

pub type State = | Open | Cancelled

pub type Order = { id: Int, customer: String, lines: List<Line>, total: Decimal, state: State }

/// What a client posts to `/orders`.
pub type Placement = { customer: String, lines: List<Line> }

/// One shape for every refusal, so a client parses one document whatever went wrong.
pub type Problem = { error: String, detail: String }

pub type Health = { service: String, routes: Int }

/// What a readiness probe answers, and it is deliberately not `Health`.
pub type Readiness = { service: String, store: String, stopping: Bool }

// The whole wire format, and nobody wrote it.
derive json for Item
derive json for Line
derive json for State
derive json for Order
derive json for Placement
derive json for Problem
derive json for Health
derive json for Readiness

// The storage format, which nobody wrote either: a column per field, and a field that is not a
// scalar is a `jsonb` document read through its own JSON codec, so what the service stores and what
// it sends are one text.
derive sql for Item
derive sql for Order

// --- The schema, which is a value ------------------------------------------------

/// A `const fn` of `std.sql.Schema`, so the check holds every statement the service runs to it: a
/// column misspelled in one is an error before anything runs.
pub const fn schema() -> sql::Schema =
  {
    tables: [
      {
        name: "items",
        columns: [
          { name: "sku", ty: sql::TText, nullable: false, default: sql::DNone },
          { name: "name", ty: sql::TText, nullable: false, default: sql::DNone },
          { name: "price", ty: sql::TNumeric(12, 2), nullable: false, default: sql::DNone },
          { name: "on_hand", ty: sql::IntColumn, nullable: false, default: sql::DNone },
        ],
        primary_key: ["sku"],
        unique: [],
        foreign_keys: [],
        checks: [{ name: "items_on_hand_is_not_negative", expression: "on_hand >= 0" }],
      },
      {
        name: "orders",
        columns: [
          {
            name: "id",
            ty: sql::IntColumn,
            nullable: false,
            default: sql::SequenceDefault("orders_id_seq"),
          },
          { name: "customer", ty: sql::TText, nullable: false, default: sql::DNone },
          { name: "lines", ty: sql::JsonColumn, nullable: false, default: sql::DNone },
          { name: "total", ty: sql::TNumeric(12, 2), nullable: false, default: sql::DNone },
          { name: "state", ty: sql::JsonColumn, nullable: false, default: sql::DNone },
        ],
        primary_key: ["id"],
        unique: [],
        foreign_keys: [],
        checks: [],
      },
    ],
  }

// --- The configuration, which is also a value -----------------------------------------

pub fn port_key() -> String = "SERVICE_PORT"

pub fn connections_key() -> String = "SERVICE_CONNECTIONS"

pub fn api_key() -> String = "SERVICE_API_KEY"

/// Where the service's database is. Optional because the fake has no database: a service over
/// postgres refuses to start without it, which is what `configured_url` below is for.
pub fn database_key() -> String = "SERVICE_DATABASE"

/// Which store answers the routes: `postgres`, or `memory` for the fake.
pub fn store_key() -> String = "SERVICE_STORE"

/// The credential to listen with, as `--tls NAME=CERT,KEY` named it; plaintext when unset.
pub fn tls_key() -> String = "SERVICE_TLS"

/// Which loop answers connections: `sequential`, or `task-per-connection`.
pub fn accept_key() -> String = "SERVICE_ACCEPT"

pub fn config() -> config::ConfigSpec =
  config::spec([
    // A default, so a developer runs `ply run --config-schema service.config` and gets a service
    // on 8137 without a word of configuration.
    config::with_default(port_key(), config::SInt, "8137"),
    config::with_default(connections_key(), config::SInt, "64"),
    // A secret is readable only through `config.secret`, and never printed where it came from.
    config::required(api_key(), config::SSecret),
    config::optional(database_key(), config::SText),
    config::with_default(store_key(), config::SText, "postgres"),
    config::optional(tls_key(), config::SText),
    config::with_default(accept_key(), config::SText, "sequential"),
  ])

/// The port a run was told to listen on, or the refusal to start. Port 0 asks for any free one, and
/// the service says which it got once it listens.
pub fn port_of(configured: Option<String>) -> Result<Int, String> / {abort.raise} =
  match configured {
    None ->
      Err(
        port_key() ++ " is unset; pass `--config-schema service.config` so the run "
          ++ "refuses at start-up, or `--set "
          ++ port_key()
          ++ "=8137`",
      ),
    Some(text) -> match router::int_of_text(text) {
      None -> Err(port_key() ++ " is `" ++ text ++ "`, which is not a port number"),
      Some(port) -> if port < 0 || port > 65535 {
        Err(port_key() ++ " is " ++ port.to_string() ++ ", and a port is 0..65535")
      } else { Ok(port) },
    },
  }

/// The same shape for the connection budget.
pub fn connections_of(configured: Option<String>) -> Result<Int, String> / {abort.raise} =
  match configured {
    None -> Ok(64),
    Some(text) -> match router::int_of_text(text) {
      None -> Err(connections_key() ++ " is `" ++ text ++ "`, which is not a number"),
      Some(n) -> if n <= 0 { Err(connections_key() ++ " is not above zero") } else { Ok(n) },
    },
  }

pub type Storage = | Postgres | Memory

/// One connection answered at a time, a task for each, or a pool of workers that sheds load past a
/// bounded queue and drains at a stop.
pub type Accept = | Sequential | TaskPerConnection | Pooled(http::Shedding)

/// How a run serves the service, read once at start-up.
pub type Settings = {
  port: Int,
  connections: Int,
  store: Storage,
  tls: Option<String>,
  accept: Accept,
}

/// Every setting a run was given, or the first refusal to start; an unset one takes its default.
pub fn settings_of(
  port: Option<String> = None,
  connections: Option<String> = None,
  store: Option<String> = None,
  tls: Option<String> = None,
  accept: Option<String> = None,
) -> Result<Settings, String> / {abort.raise} = {
  let p = port_of(port)?;
  let n = connections_of(connections)?;
  let s = store_of(store)?;
  let t = tls_of(tls)?;
  let a = accept_of(accept)?;
  Ok({ port: p, connections: n, store: s, tls: t, accept: a })
}

fn store_of(configured: Option<String>) -> Result<Storage, String> =
  match configured {
    None -> Ok(Postgres),
    Some("postgres") -> Ok(Postgres),
    Some("memory") -> Ok(Memory),
    Some(other) ->
      Err(store_key() ++ " is `" ++ other ++ "`; the stores are `postgres` and `memory`"),
  }

fn tls_of(configured: Option<String>) -> Result<Option<String>, String> =
  match configured {
    Some("") -> Err(tls_key() ++ " is empty; name a credential `--tls NAME=CERT,KEY` gave"),
    other -> Ok(other),
  }

fn accept_of(configured: Option<String>) -> Result<Accept, String> =
  match configured {
    None -> Ok(Sequential),
    Some("sequential") -> Ok(Sequential),
    Some("task-per-connection") -> Ok(TaskPerConnection),
    Some("pooled") -> Ok(Pooled(http::default_shedding())),
    Some(other) ->
      Err(
        accept_key() ++ " is `" ++ other ++ "`; the loops are `sequential`, "
          ++ "`task-per-connection` and `pooled`",
      ),
  }

// --- The statements ---------------------------------------------------------------

fn items_all() -> sql::Statement =
  sql::stmt("select sku, name, price, on_hand from items order by sku")

/// The readiness probe, and the cheapest statement in the file: one aggregate over one table, no
/// rows on the wire, no parameters to bind.
fn store_reachable() -> sql::Statement = sql::stmt("select count(*) from items")

fn items_in_stock() -> sql::Statement =
  sql::stmt("select sku, name, price, on_hand from items where on_hand > $1 order by sku")

fn item_by_sku() -> sql::Statement =
  sql::stmt("select sku, name, price, on_hand from items where sku = $1")

fn item_insert() -> sql::Statement =
  sql::stmt("insert into items (sku, name, price, on_hand) values ($1, $2, $3, $4)")

/// The reservation, and the only interesting statement in the file.
fn item_reserve() -> sql::Statement =
  sql::stmt("update items set on_hand = $1 where sku = $2 and on_hand = $3")

fn orders_all() -> sql::Statement =
  sql::stmt("select id, customer, lines, total, state from orders order by id")

fn order_by_id() -> sql::Statement =
  sql::stmt("select id, customer, lines, total, state from orders where id = $1")

/// The id is the database's.
fn order_insert() -> sql::Statement =
  sql::stmt(
    "insert into orders (customer, lines, total, state) values ($1, $2, $3, $4)"
      ++ " returning id, customer, lines, total, state",
  )

/// No compare-and-set on `state`, and the reason is worth writing down because it is a design
/// decision the fake forced rather than a shortcut.
fn order_cancel() -> sql::Statement = sql::stmt("update orders set state = $1 where id = $2")

// --- Reading a result set ----------------------------------------------------------

/// The rows a fetch read, or the problem a client is told of in their place.
fn listed<a>(
  read: Result<List<a>, sql::FetchError>,
) -> Result<List<a>, http::Response<| {}>> / {abort.raise} =
  match read {
    Ok(xs) -> Ok(xs),
    Err(sql::Refused(e)) -> Err(unavailable(e)),
    Err(sql::UnexpectedCount(_)) ->
      Err(problem(500, "unreadable answer", "a query answered a count")),
    Err(sql::InvalidRow(e)) ->
      Err(
        problem(
          500,
          "unreadable row",
          e.column ++ ": expected " ++ e.expected ++ ", found " ++ e.found,
        ),
      ),
  }

fn head_of<a>(xs: List<a>) -> Option<a> = match xs { [x, ..] -> Some(x), _ -> None }

/// A SQLSTATE the service has no answer for.
fn unavailable(e: sql::DbError) -> http::Response<| {}> / {abort.raise} =
  problem(503, "the store is unavailable", e.code)

fn shelf() -> Result<List<Item>, http::Response<| {}>> / {db.query[items], abort.raise} =
  listed(db::fetch[items](items_all(), item_row(), []))

fn book() -> Result<List<Order>, http::Response<| {}>> / {db.query[orders], abort.raise} =
  listed(db::fetch[orders](orders_all(), order_row(), []))

fn order_row_of(
  id: Int,
) -> Result<Option<Order>, http::Response<| {}>> / {db.query[orders], abort.raise} = {
  let os = listed(db::fetch[orders](order_by_id(), order_row(), [sql::IntParameter(id)]))?;
  Ok(head_of(os))
}

/// `lines` and `state` are `jsonb`, so a parameter for either is a `Json` value built by the codec
/// this file already derived.
fn lines_param(lines: List<Line>) -> sql::Param / {abort.raise} = {
  let c = json::list_json(line_json());
  sql::JsonParameter((c.encode)(lines))
}

fn state_param(s: State) -> sql::Param / {abort.raise} = {
  let c = state_json();
  sql::JsonParameter((c.encode)(s))
}

// --- The business, which touches nothing ----------------------------------------

pub fn item_named(shelf: List<Item>, sku: String) -> Option<Item> =
  shelf.fold(None, |found: Option<Item>, i: Item| if i.sku == sku { Some(i) } else { found })

pub fn price_of(shelf: List<Item>, sku: String) -> Decimal =
  match item_named(shelf, sku) { Some(i) -> i.price, None -> 0m }

/// `Decimal`, because money is exact and not binary.
pub fn total_of(shelf: List<Item>, lines: List<Line>) -> Decimal =
  lines.fold(0m, |acc: Decimal, l: Line| acc + Decimal::of_int(l.qty) * price_of(shelf, l.sku))

pub fn unknown_skus(shelf: List<Item>, lines: List<Line>) -> List<String> =
  lines.filter(|l: Line| item_named(shelf, l.sku) == None).map(|l: Line| l.sku)

/// Summed per sku rather than checked per line, and walked over the shelf rather than over the
/// order, so a sku named twice is one draw on the shelf and is reported once.
pub fn short_skus(shelf: List<Item>, lines: List<Line>) -> List<String> =
  shelf.filter(|i: Item| i.on_hand < taken(lines, i.sku)).map(|i: Item| i.sku)

/// A quantity that is not positive is refused rather than clamped.
pub fn bad_qty(lines: List<Line>) -> Bool =
  lines.fold(false, |seen: Bool, l: Line| seen || l.qty <= 0)

fn taken(lines: List<Line>, sku: String) -> Int =
  lines.fold(0, |n: Int, l: Line| if l.sku == sku { n + l.qty } else { n })

fn moved(shelf: List<Item>, lines: List<Line>, sign: Int) -> List<Item> =
  shelf.map(|i: Item|
    { sku: i.sku, name: i.name, price: i.price, on_hand: i.on_hand - sign * taken(lines, i.sku) })

pub fn draw_down(shelf: List<Item>, lines: List<Line>) -> List<Item> = moved(shelf, lines, 1)

pub fn put_back(shelf: List<Item>, lines: List<Line>) -> List<Item> = moved(shelf, lines, -1)

/// There is no `next_id` here any more, and its absence is the point.
pub fn order_by(orders: List<Order>, id: Int) -> Option<Order> =
  orders.fold(None, |found: Option<Order>, o: Order| if o.id == id { Some(o) } else { found })

pub fn cancelled(o: Order) -> Order =
  { id: o.id, customer: o.customer, lines: o.lines, total: o.total, state: Cancelled }

// --- The route table, which is data ---------------------------------------------

pub type Endpoint =
  | Health
  | Ready
  | Docs
  | ListItems
  | Featured
  | GetItem
  | ListOrders
  | PlaceOrder
  | GetOrder
  | CancelOrder
  | Receipt

fn route(
  method: http::Method,
  pattern: String,
  e: Endpoint,
) -> router::Route<Endpoint> / {abort.raise} =
  { method: method, path: router::pattern_of_string(pattern), endpoint: e }

fn get(pattern: String, e: Endpoint) -> router::Route<Endpoint> / {abort.raise} =
  route(http::Get, pattern, e)

/// `/items/featured` and `/items/{sku}` both match `/items/featured`, and the literal wins —
/// decided segment by segment, left to right, by the matcher and not by the order of this list.
pub fn table() -> List<router::Route<Endpoint>> / {abort.raise} =
  [
    get("/health", Health),
    get("/ready", Ready),
    get("/docs/{..page}", Docs),
    get("/items", ListItems),
    get("/items/featured", Featured),
    get("/items/{sku}", GetItem),
    get("/orders", ListOrders),
    route(http::Post, "/orders", PlaceOrder),
    get("/orders/{id:Int}", GetOrder),
    route(http::Delete, "/orders/{id:Int}", CancelOrder),
    get("/orders/{id:Int}/receipt", Receipt),
  ]

/// Pure, and that is the first thing `ply check --types` prints about this service.
pub fn route_of(
  method: http::Method,
  path: String,
) -> router::RouteResult<Endpoint> / {abort.raise} = router::route(table(), method, path)

// --- Responses ------------------------------------------------------------------

fn field(name: String, value: String) -> { key: String, value: List<String> } =
  { key: name, value: [value] }

/// One entry of a `Fields` map.
fn text_field(name: String, value: String) -> { key: String, value: trace::Field } =
  { key: name, value: trace::StringField(value) }

fn int_field(name: String, value: Int) -> { key: String, value: trace::Field } =
  { key: name, value: trace::IntField(value) }

fn json_headers() -> http::Headers = Map::of_entries([field("content-type", "application/json")])

/// The dictionary is an argument.
fn json_body<a>(
  status: Int,
  x: a,
  codec: json::JsonCodec<a>,
) -> http::Response<| {}> / {abort.raise} =
  { status: status, headers: json_headers(), body: http::Whole(json::encode_bytes(x, codec)) }

fn problem(status: Int, error: String, detail: String) -> http::Response<| {}> / {abort.raise} =
  json_body(status, { error: error, detail: detail }, problem_json())

fn text(status: Int, body: Bytes) -> http::Response<| {}> =
  {
    status: status,
    headers: Map::of_entries([field("content-type", "text/plain; charset=utf-8")]),
    body: http::Whole(body),
  }

fn join(xs: List<String>) -> String =
  xs.fold("", |acc: String, x: String| if acc == "" { x } else { acc ++ ", " ++ x })

// --- The endpoints ---------------------------------------------------------------

// --- Liveness and readiness, which are two different questions --------------------

pub fn health() -> http::Response<| {}> / {abort.raise} =
  json_body(200, { service: "parts", routes: table().len() }, health_json())

/// 503 while draining, 503 while the store is unreachable, 200 otherwise.
pub fn ready() -> http::Response<| {}> / {db.query[items], signal.stopping, abort.raise} =
  if signal.stopping() { unready("draining", true) } else {
    match db.query[items](store_reachable(), []) {
      sql::Rows(_) ->
        json_body(200, { service: "parts", store: "reachable", stopping: false }, readiness_json()),
      // The SQLSTATE is the detail rather than the error, exactly as `unavailable` does it: a
      // client's action is the same whichever code the server sent, and an operator's is not.
      sql::Failed(e) -> unready(e.code, false),
      sql::Count(_) -> unready("unreadable answer", false),
    }
  }

fn unready(store: String, stopping: Bool) -> http::Response<| {}> / {abort.raise} =
  json_body(503, { service: "parts", store: store, stopping: stopping }, readiness_json())

/// Also pure: the pages are definitions, not rows, so serving one touches nothing.
fn pages() -> Map<String, String> =
  Map::of_entries([
    { key: "index", value: "GET /items, GET /orders, POST /orders, DELETE /orders/{id}" },
    { key: "orders/placing", value: "POST /orders with {\"customer\":..,\"lines\":[..]}" },
    { key: "orders/cancelling", value: "DELETE /orders/{id} puts the lines back on the shelf" },
  ])

pub fn docs(params: Map<String, String>) -> http::Response<| {}> / {abort.raise} =
  match params.get("page") {
    None -> problem(404, "no such page", "the pages are: " ++ join(pages().keys())),
    Some(p) -> match pages().get(p) {
      Some(body) -> text(200, Bytes::of_string(body ++ "\n")),
      None -> problem(404, "no such page", "the pages are: " ++ join(pages().keys())),
    },
  }

pub fn list_items() -> http::Response<| {}> / {db.query[items], abort.raise} =
  match shelf() { Err(r) -> r, Ok(rows) -> json_body(200, rows, json::list_json(item_json())) }

/// Everything the shelf is short of.
pub fn featured() -> http::Response<| {}> / {db.query[items], abort.raise} =
  match listed(db::fetch[items](items_in_stock(), item_row(), [sql::IntParameter(0)])) {
    Err(r) -> r,
    Ok(rows) -> json_body(200, rows, json::list_json(item_json())),
  }

pub fn get_item(
  params: Map<String, String>,
) -> http::Response<| {}> / {db.query[items], abort.raise} =
  match params.get("sku") {
    None -> problem(400, "bad request", "no sku was captured"),
    Some(sku) -> match listed(
        db::fetch[items](item_by_sku(), item_row(), [sql::TextParameter(sku)]),
      ) {
      Err(r) -> r,
      Ok(rows) -> match head_of(rows) {
        Some(i) -> json_body(200, i, item_json()),
        None -> problem(404, "no such item", sku),
      },
    },
  }

pub fn list_orders() -> http::Response<| {}> / {db.query[orders], abort.raise} =
  match book() { Err(r) -> r, Ok(rows) -> json_body(200, rows, json::list_json(order_json())) }

pub fn get_order(
  params: Map<String, String>,
) -> http::Response<| {}> / {db.query[orders], abort.raise} =
  match order_wanted(params) {
    Err(r) -> r,
    Ok(id) -> match order_row_of(id) {
      Err(r) -> r,
      Ok(found) -> match found {
        Some(o) -> json_body(200, o, order_json()),
        None -> problem(404, "no such order", id.to_string()),
      },
    },
  }

/// `Some` for every route whose pattern declared `{id:Int}`, because nothing else could have
/// matched.
fn order_wanted(params: Map<String, String>) -> Result<Int, http::Response<| {}>> / {abort.raise} =
  match router::int_param(params, "id") {
    Some(id) -> Ok(id),
    None -> Err(problem(400, "bad order id", "an order id is one or more digits")),
  }

// --- The two that are transactions --------------------------------------------------

pub fn place_order(body: Bytes) -> http::Response<| {}> / {Service, abort.raise} =
  match json::decode_bytes(body, placement_json()) {
    Err(e) -> problem(400, "malformed body", json::error_to_string(e)),
    Ok(p) -> placed(p),
  }

/// The two refusals that need no database are answered before one is opened, so a malformed order
/// costs no connection and no `BEGIN`.
fn placed(p: Placement) -> http::Response<| {}> / {Service, abort.raise} =
  if p.lines.len() == 0 { problem(422, "empty order", "an order needs at least one line") }
  else if bad_qty(p.lines) {
    problem(422, "bad quantity", "every line needs a quantity above zero")
  } else {
    resolved(db::transaction(db::ReadCommitted, db::ReadWrite, || placing(p)), "out of stock")
  }

/// The span that shows where a placement's time went, and the one place in this file where a span
/// is *not* closed by the program.
fn placing(p: Placement) -> http::Response<| {}> / {Service, abort.raise} = {
  let span = trace.enter[orders](
    "reserving",
    Map::of_entries([text_field("customer", p.customer), int_field("lines", p.lines.len())]),
  );
  let out = match shelf() {
    Err(r) -> r,
    Ok(stock) -> if unknown_skus(stock, p.lines).len() > 0 {
      problem(404, "no such item", join(unknown_skus(stock, p.lines)))
    } else { recorded(p, stock, total_of(stock, p.lines)) },
  };
  trace.exit[orders](span, trace::Ok);
  out
}

fn recorded(
  p: Placement,
  stock: List<Item>,
  total: Decimal,
) -> http::Response<| {}> / {Service, abort.raise} =
  match listed(
      db::fetch_returning[orders](order_insert(), order_row(), [
        sql::TextParameter(p.customer),
        lines_param(p.lines),
        sql::NumericParameter(total),
        state_param(Open),
      ]),
    ) {
    Err(r) -> r,
    Ok(rows) -> match head_of(rows) {
      None -> problem(500, "unreadable answer", "an insert returned no row"),
      Some(o) -> {
        // The order exists in the transaction's view from here on.
        move_stock(stock, p.lines, 1);
        // Two records rather than one, and they answer different questions.
        trace.event[orders](
          trace::Info,
          "placed",
          Map::of_entries([
            int_field("order", o.id),
            text_field("customer", p.customer),
            { key: "total", value: trace::DecimalField(o.total) },
            int_field("lines", p.lines.len()),
          ]),
        );
        trace.count[orders]("orders placed", 1, Map::new());
        json_body(201, o, order_json())
      },
    },
  }

/// One `UPDATE` per sku the order draws on, walked over the shelf rather than over the order, so a
/// sku named on two lines is one reservation of their sum — which is how a service avoids selling
/// the same three widgets twice inside one order.
fn move_stock(
  stock: List<Item>,
  lines: List<Line>,
  sign: Int,
) -> Unit / {db.execute[items], db.rollback, trace.event[items]} = {
  let drawn = stock.filter(|i: Item| taken(lines, i.sku) > 0);
  moving(drawn, lines, sign);
  // After the reservations and not before, so the record is a claim that the shelf moved rather
  // than that something tried to move it.
  trace.event[items](
    trace::Info,
    "shelf moved",
    Map::of_entries([int_field("skus", drawn.len()), int_field("sign", sign)]),
  )
}

fn moving(
  stock: List<Item>,
  lines: List<Line>,
  sign: Int,
) -> Unit / {db.execute[items], db.rollback} =
  match stock {
    [i, ..rest] -> {
      reserved(i, i.on_hand - sign * taken(lines, i.sku));
      moving(rest, lines, sign)
    },
    _ -> (),
  }

/// Three answers, and each one is a different thing to have happened.
fn reserved(i: Item, to: Int) -> Unit / {db.execute[items], db.rollback} =
  match db.execute[items](item_reserve(), [
      sql::IntParameter(to),
      sql::TextParameter(i.sku),
      sql::IntParameter(i.on_hand),
    ]) {
    sql::Count(n) -> if n == 1 { () } else { db.rollback(i.sku) },
    sql::Failed(_) -> db.rollback(i.sku),
    _ -> db.rollback(i.sku),
  }

/// What `db::transaction` hands back, turned into a response.
fn resolved(
  out: Result<http::Response<| {}>, db::Rollback>,
  error: String,
) -> http::Response<| {}> / {abort.raise} =
  match out {
    Ok(r) -> r,
    Err(rb) -> match rb.error { Some(e) -> unavailable(e), None -> problem(409, error, rb.reason) },
  }

/// `Serializable`, and it is the only endpoint that asks for it.
pub fn cancel_order(params: Map<String, String>) -> http::Response<| {}> / {Service, abort.raise} =
  match order_wanted(params) {
    Err(r) -> r,
    Ok(id) ->
      resolved(
        db::transaction(db::Serializable, db::ReadWrite, || cancelling(id)),
        "the shelf moved",
      ),
  }

fn cancelling(id: Int) -> http::Response<| {}> / {Service, abort.raise} =
  match order_row_of(id) {
    Err(r) -> r,
    Ok(found) -> match found {
      None -> problem(404, "no such order", id.to_string()),
      Some(o) -> match o.state {
        Cancelled -> problem(409, "already cancelled", id.to_string()),
        Open -> cancelled_now(o),
      },
    },
  }

/// A `DELETE` that raced another one and lost affects no row here, because the order it read is
/// gone from under it; that answers 409 without a rollback — nothing had been written, so there is
/// nothing to discard and committing an empty transaction is the honest end of it.
fn cancelled_now(o: Order) -> http::Response<| {}> / {Service, abort.raise} =
  match db.execute[orders](order_cancel(), [state_param(Cancelled), sql::IntParameter(o.id)]) {
    sql::Count(n) -> if n == 1 { restocked(o) }
    else { problem(409, "already cancelled", o.id.to_string()) },
    sql::Failed(e) -> unavailable(e),
    _ -> problem(500, "unreadable answer", "an update returned rows"),
  }

fn restocked(o: Order) -> http::Response<| {}> / {Service, abort.raise} =
  match shelf() {
    Err(r) -> r,
    Ok(stock) -> {
      move_stock(stock, o.lines, -1);
      trace.event[orders](
        trace::Info,
        "cancelled",
        Map::of_entries([
          int_field("order", o.id),
          text_field("customer", o.customer),
          { key: "total", value: trace::DecimalField(o.total) },
        ]),
      );
      json_body(200, cancelled(o), order_json())
    },
  }

// --- The streamed receipt ---------------------------------------------------------

pub type Phase = | Opening | Lines | Done

pub type Cursor = { order: Order, shelf: List<Item>, pending: List<Line>, phase: Phase }

pub fn cursor_for(o: Order, shelf: List<Item>) -> Cursor =
  { order: o, shelf: shelf, pending: o.lines, phase: Opening }

fn opening_line(o: Order) -> Bytes =
  Bytes::of_string("receipt for order " ++ o.id.to_string() ++ "\ncustomer: " ++ o.customer ++ "\n")

fn item_line(shelf: List<Item>, l: Line) -> Bytes =
  Bytes::of_string(
    "  " ++ l.qty.to_string() ++ " x " ++ l.sku ++ " @ " ++ price_of(shelf, l.sku).to_string()
      ++ " = "
      ++ Decimal::to_string(Decimal::of_int(l.qty) * price_of(shelf, l.sku))
      ++ "\n",
  )

fn closing_line(o: Order) -> Bytes = Bytes::of_string("total: " ++ o.total.to_string() ++ "\n")

pub fn next_chunk(c: Cursor) -> Option<{ chunk: Bytes, next: Cursor }> =
  match c.phase {
    Opening ->
      Some({
        chunk: opening_line(c.order),
        next: { order: c.order, shelf: c.shelf, pending: c.pending, phase: Lines },
      }),
    Lines -> match c.pending {
      [l, ..rest] ->
        Some({
          chunk: item_line(c.shelf, l),
          next: { order: c.order, shelf: c.shelf, pending: rest, phase: Lines },
        }),
      _ ->
        Some({
          chunk: closing_line(c.order),
          next: { order: c.order, shelf: c.shelf, pending: [], phase: Done },
        }),
    },
    Done -> None,
  }

/// What a buffered path would have sent.
pub fn drained(c: Cursor) -> Bytes = Bytes::concat_all(chunks_of(c, []))

/// A cursor writes its opening, a line per item and its close, so the items and three more rounds
/// see it done.
fn chunks_of(c: Cursor, acc: List<Bytes>) -> List<Bytes> =
  range(0, c.pending.len() + 3).fold(
    { at: Some(c), out: acc },
    |s: { at: Option<Cursor>, out: List<Bytes> }, _round: Int|
      match s.at {
        None -> s,
        Some(now) -> match next_chunk(now) {
          None -> { at: None, out: s.out },
          Some(step) -> { at: Some(step.next), out: s.out.push(step.chunk) },
        },
      },
  ).out

// --- Dispatch ---------------------------------------------------------------------

/// A buffered answer, or a head and a cursor the connection pulls.
pub type Reply =
  | Buffered(http::Response<| {}>)
  | Stream({ head: http::Response<| {}>, cursor: Cursor })

pub fn receipt(
  params: Map<String, String>,
) -> Reply / {db.query[items], db.query[orders], abort.raise} =
  match order_wanted(params) {
    Err(r) -> Buffered(r),
    Ok(id) -> match order_row_of(id) {
      Err(r) -> Buffered(r),
      Ok(found) -> match found {
        None -> Buffered(problem(404, "no such order", id.to_string())),
        Some(o) -> streamed(o),
      },
    },
  }

/// The shelf is read before the head is written, because a cursor pulls prices out of a list rather
/// than out of the database: a receipt of ten thousand lines costs one query and holds one line at
/// a time, and a chunk producer that queried per line would put the database inside `next_chunk`'s
/// row and inside the connection's write loop.
fn streamed(o: Order) -> Reply / {db.query[items], abort.raise} =
  match shelf() {
    Err(r) -> Buffered(r),
    Ok(stock) -> Stream({ head: text(200, b""), cursor: cursor_for(o, stock) }),
  }

// --- The request span, and the credential ----------------------------------------

pub fn dispatch(
  e: Endpoint,
  req: http::Request,
  params: Map<String, String>,
) -> Reply / {Serving, abort.raise} = {
  let span = trace.enter[http](
    "dispatch",
    Map::of_entries([
      text_field("method", http::method_name(req.method)),
      text_field("path", req.path),
      text_field("endpoint", endpoint_name(e)),
    ]),
  );
  let reply = guarded(e, req, params);
  trace.exit[http](span, outcome_of(reply));
  reply
}

/// What the span records as its outcome.
fn outcome_of(r: Reply) -> trace::Outcome =
  match r {
    Buffered(response) -> if response.status < 400 { trace::Ok }
    else { trace::Failed(response.status.to_string()) },
    // A streamed body is written after this span closes, so the only thing the handler decided is
    // that it had an order to stream.
    Stream(_) -> trace::Ok,
  }

/// The API-key check, and the only place in this repository a `Secret<a>` is used end to end.
fn guarded(
  e: Endpoint,
  req: http::Request,
  params: Map<String, String>,
) -> Reply / {Serving, abort.raise} =
  match e {
    PlaceOrder -> if authorized(config.secret[credentials](api_key()), presented(req)) {
      dispatched(e, req, params)
    } else {
      trace.event[http](
        trace::Warn,
        "api key refused",
        Map::of_entries([
          text_field("path", req.path),
          { key: "presented", value: trace::BoolField(presented(req) != "") },
        ]),
      );
      Buffered(problem(401, "unauthorized", "POST /orders needs a matching `x-api-key` header"))
    },
    _ -> dispatched(e, req, params),
  }

fn presented(req: http::Request) -> String =
  match req.headers.get("x-api-key") { Some([value, ..]) -> value, _ -> "" }

/// `None` is a refusal and not a pass.
fn authorized(configured: Option<Secret<String>>, offered: String) -> Bool =
  match configured { None -> false, Some(key) -> !key.is_empty() && key.verify(offered) }

fn endpoint_name(e: Endpoint) -> String =
  match e {
    Health -> "health",
    Ready -> "ready",
    Docs -> "docs",
    ListItems -> "list_items",
    Featured -> "featured",
    GetItem -> "get_item",
    ListOrders -> "list_orders",
    PlaceOrder -> "place_order",
    GetOrder -> "get_order",
    CancelOrder -> "cancel_order",
    Receipt -> "receipt",
  }

/// Exhaustive by construction: add a variant to `Endpoint` without a route and the table is one
/// line short; add one without an arm here and it is `E0205`.
fn dispatched(
  e: Endpoint,
  req: http::Request,
  params: Map<String, String>,
) -> Reply / {Service, signal.stopping, abort.raise} =
  match e {
    Health -> Buffered(health()),
    Ready -> Buffered(ready()),
    Docs -> Buffered(docs(params)),
    ListItems -> Buffered(list_items()),
    Featured -> Buffered(featured()),
    GetItem -> Buffered(get_item(params)),
    ListOrders -> Buffered(list_orders()),
    PlaceOrder -> Buffered(place_order(http::whole_bytes(req.body))),
    GetOrder -> Buffered(get_order(params)),
    CancelOrder -> Buffered(cancel_order(params)),
    Receipt -> receipt(params),
  }

pub fn result(req: http::Request) -> Reply / {Serving, abort.raise} =
  if req.target == "*" {
    // `OPTIONS *` asks about the server rather than about a path, so it is not routed.
    Buffered(server_options())
  } else {
    match route_of(routed_method(req.method), req.path) {
      router::NotFound -> Buffered(problem(404, "no such route", req.path)),
      router::MethodNotAllowed(ms) -> Buffered(method_not_allowed(ms)),
      router::Found(m) -> dispatch(m.endpoint, req, m.params),
    }
  }

/// A `HEAD` is a `GET` whose response carries no body, and `http::encode` is what drops it —
/// computing the `Content-Length` the same request would have produced under `GET`.
fn routed_method(m: http::Method) -> http::Method = match m { http::Head -> http::Get, _ -> m }

fn server_options() -> http::Response<| {}> / {abort.raise} =
  {
    status: 204,
    headers: Map::of_entries([
      field(
        "allow",
        join(router::declared_methods(table()).map(|m: http::Method| http::method_name(m))),
      ),
    ]),
    body: http::Whole(b""),
  }

/// RFC 9110 §15.5.6 makes `Allow` a MUST on a 405, and the methods come from the matcher rather
/// than from a list written here — sorted and deduplicated by `route`, so the field cannot disagree
/// with the table it was derived from.
fn method_not_allowed(ms: List<http::Method>) -> http::Response<| {}> / {abort.raise} =
  {
    status: 405,
    headers: Map::of_entries([
      field("content-type", "application/json"),
      field("allow", join(ms.map(|m: http::Method| http::method_name(m)))),
    ]),
    body: http::Whole(
      json::encode_bytes(
        {
          error: "method not allowed",
          detail: "this path is served by " ++ join(ms.map(|m: http::Method| http::method_name(m))),
        },
        problem_json(),
      ),
    ),
  }

/// Every route, buffered — the shape a test drives and the shape `http::serve` would take as its
/// `app`.
pub fn app(req: http::Request) -> http::Response<| {}> / {Serving, abort.raise} =
  collapse(result(req))

pub fn collapse(r: Reply) -> http::Response<| {}> =
  match r {
    Buffered(response) -> response,
    Stream(s) ->
      { status: s.head.status, headers: s.head.headers, body: http::Whole(drained(s.cursor)) },
  }

// --- The connection ------------------------------------------------------------------

/// The bounds this service runs under, written down.
pub fn limits() -> http::Limits =
  {
    max_request_line: 8192,
    max_header_bytes: 16384,
    max_header_count: 64,
    // A `Placement` is small.
    max_body: 65536,
    max_chunk_size: 65536,
    max_chunk_line: 4096,
    max_trailer_bytes: 4096,
    max_keep_alive: 100,
    // The receipt route streams a handful of chunks and this is far above it.
    max_stream_chunks: 1024,
    // Equal on purpose: this loop passes one `Limits` to `read_head` for both the first read of a
    // connection and the first read of a reused one, so the two bounds are the same number rather
    // than two numbers that look the same.
    header_timeout_ms: 5000,
    idle_timeout_ms: 5000,
    body_timeout_ms: 15000,
    write_timeout_ms: 15000,
    connect_timeout_ms: 5000,
  }

pub fn serve_connection(
  c: Int,
  l: http::Limits,
) -> Unit / {Serving, net.recv[conn], net.send[conn], net.close[conn], abort.raise} = {
  // A limit that is zero or negative is a configuration nobody meant, and it is refused here rather
  // than turning into a service that answers 413 to everything.
  http::check_limits(l);
  turn(c, l, b"", l.max_keep_alive, false, || false);
  net.close[conn](c)
}

/// `serve_connection` until `stop` is closed, and drained after: the request in hand is answered
/// with `Connection: close` unless one is already read behind it, and a connection between requests
/// is closed rather than waited on.
pub fn serve_connection_until(
  c: Int,
  l: http::Limits,
  stop: Chan<Unit>,
) -> Unit / {Serving, net.recv[conn], net.send[conn], net.close[conn], task.select, abort.raise} = {
  http::check_limits(l);
  turn(c, l, b"", l.max_keep_alive, false, || http::stopped_by(stop));
  net.close[conn](c)
}

fn turn<| e>(
  c: Int,
  l: http::Limits,
  carried: Bytes,
  left: Int,
  reused: Bool,
  stopping: () -> Bool / e,
) -> Unit / {Serving, net.recv[conn], net.send[conn], abort.raise | e} =
  if left <= 0 { () }
  else if reused && carried.len() == 0 && stopping() { () } else {
    match http::read_head[conn](c, carried, l, reused) {
      // The peer went away. There is nothing to answer and nothing to say.
      http::HeadClosed(_) -> (),
      // An idle keep-alive connection is closed with no response: no request had started, so there
      // is no request to answer.
      http::HeadIdle -> (),
      http::HeadTimedOut ->
        write_out(
          c,
          l,
          http::Get,
          http::Http11,
          false,
          http::text_response(408, "the request head did not arrive\n"),
        ),
      http::HeadBytes(read) -> heard(c, l, read.buf, read.complete, left - 1, stopping),
    }
  }

/// From here on `left` is how many requests the connection may serve after this one.
fn heard<| e>(
  c: Int,
  l: http::Limits,
  buf: Bytes,
  complete: Bool,
  left: Int,
  stopping: () -> Bool / e,
) -> Unit / {Serving, net.recv[conn], net.send[conn], abort.raise | e} =
  match http::parse_head(buf, l) {
    // The head stopped mid-way with nothing more coming, or it ran past the bound without a
    // terminator.
    http::Incomplete -> if complete {
      write_out(
        c,
        l,
        http::Get,
        http::Http11,
        false,
        http::text_response(400, "the request head never ended\n"),
      )
    } else {
      write_out(
        c,
        l,
        http::Get,
        http::Http11,
        false,
        http::text_response(431, "the request head never ended within the bound\n"),
      )
    },
    // Every framing refusal closes the connection: what a refusal did not establish is exactly
    // where the next message begins, so there is nothing to resynchronise to.
    http::Rejected(reason) ->
      write_out(c, l, http::Get, http::Http11, false, http::error_response(reason)),
    http::Parsed(h) -> continued(c, l, h, buf, left, stopping),
  }

fn continued<| e>(
  c: Int,
  l: http::Limits,
  h: http::Head,
  buf: Bytes,
  left: Int,
  stopping: () -> Bool / e,
) -> Unit / {Serving, net.recv[conn], net.send[conn], abort.raise | e} = {
  // A client that waits for a `100` it never gets is a hang, and a hang is the failure shape with
  // nothing to read.
  let told = if h.expects_continue {
    send_all[conn](c, http::continue_response(), l.write_timeout_ms)
  } else { true };
  if !told { () } else {
    // The body is read whatever the route does with it.
    with_body(
      c,
      l,
      h,
      http::read_body[conn](c, h.framing, buf.slice(h.consumed, buf.len()), l),
      left,
      stopping,
    )
  }
}

fn with_body<| e>(
  c: Int,
  l: http::Limits,
  h: http::Head,
  body: http::BodyResult,
  left: Int,
  stopping: () -> Bool / e,
) -> Unit / {Serving, net.recv[conn], net.send[conn], abort.raise | e} =
  match body {
    http::BodyTimedOut ->
      write_out(
        c,
        l,
        h.request.method,
        h.request.version,
        false,
        http::text_response(408, "the request body did not arrive\n"),
      ),
    http::BodyClosed -> (),
    http::BodyRejected(reason) ->
      write_out(c, l, h.request.method, h.request.version, false, http::error_response(reason)),
    http::BodyComplete(got) -> returned(c, l, h, got, left, stopping),
  }

fn returned<| e>(
  c: Int,
  l: http::Limits,
  h: http::Head,
  got: { bytes: Bytes, rest: Bytes, trailers: http::Headers },
  left: Int,
  stopping: () -> Bool / e,
) -> Unit / {Serving, net.recv[conn], net.send[conn], abort.raise | e} = {
  let reply = result(whole(h, got.bytes, got.trailers));
  // A stop seen once the answer is ready makes it the connection's last, unless a request is
  // already read behind it.
  let keep = h.keep_alive && left > 0 && !(got.rest.len() == 0 && stopping());
  let wrote = match streamable(h.request.method, reply) {
    Buffered(r) ->
      send_all[conn](
        c,
        http::encode(h.request.method, h.request.version, keep, r),
        l.write_timeout_ms,
      ),
    // The one route that writes as it produces.
    Stream(s) ->
      http::respond[conn](c, l, h.request.method, h.request.version, keep, {
        status: s.head.status,
        headers: s.head.headers,
        body: http::chunked(cursor_chunks(s.cursor)),
      }),
  };
  if wrote && keep {
    // Pipelined requests are answered in order by construction: one connection, one task, and the
    // leftover buffer carried into the next turn.
    turn(c, l, got.rest, left, true, stopping)
  } else { () }
}

/// A `HEAD` response carries no body, so there is nothing to stream: the cursor is drained here and
/// `http::encode` writes the `Content-Length` a `GET` would have produced and no bytes after the
/// head.
fn streamable(m: http::Method, r: Reply) -> Reply =
  match m { http::Head -> Buffered(collapse(r)), _ -> r }

/// A cursor's chunks as a stream, each made as it is pulled.
fn cursor_chunks(c: Cursor) -> Seq<Bytes | {}> =
  seq::unfold(c, |at: Cursor|
    match next_chunk(at) {
      None -> None,
      Some(step) -> Some({ value: step.chunk, next: step.next }),
    })

/// The head's request with the body and the trailers it was framed with.
fn whole(h: http::Head, body: Bytes, trailers: http::Headers) -> http::Request =
  {
    method: h.request.method,
    target: h.request.target,
    path: h.request.path,
    query: h.request.query,
    authority: h.request.authority,
    version: h.request.version,
    headers: h.request.headers,
    trailers: trailers,
    body: http::Whole(body),
    peer: h.request.peer,
    client_certificate: h.request.client_certificate,
  }

fn write_out(
  c: Int,
  l: http::Limits,
  m: http::Method,
  v: http::Version,
  keep: Bool,
  r: http::Response<| {}>,
) -> Unit / {net.send[conn], abort.raise} = {
  send_all[conn](c, http::encode(m, v, keep, r), l.write_timeout_ms);
  ()
}

/// Answer up to `count` connections one at a time, and stop early once the listener is closed under
/// the loop. A tail call, so a budget is a number rather than a stack depth.
pub fn serve(
  listener: Int,
  l: http::Limits,
  count: Int,
) -> Int / {Serving, net.accept[listener], net.recv[conn], net.send[conn], net.close[conn], abort.raise} =
  one_at_a_time(listener, l, count, 0)

fn one_at_a_time(
  listener: Int,
  l: http::Limits,
  left: Int,
  served: Int,
) -> Int / {Serving, net.accept[listener], net.recv[conn], net.send[conn], net.close[conn], abort.raise} =
  if left <= 0 { served } else {
    let c = net.accept[listener](listener);
    if c == 0 { served } else {
      serve_connection(c, l);
      one_at_a_time(listener, l, left - 1, served + 1)
    }
  }

/// The same budget with a task for each connection, so a slow client holds up only itself. Every
/// task is joined before the loop answers: the fake's store lives no longer than the call that
/// opened it.
pub fn serve_each(
  listener: Int,
  l: http::Limits,
  count: Int,
) -> Int / {task.write, Serving, net.accept[listener], net.recv[conn], net.send[conn], net.close[conn], abort.raise} =
  joined(spawned(listener, l, count, []))

fn spawned(
  listener: Int,
  l: http::Limits,
  left: Int,
  running: List<Task<Unit>>,
) -> List<Task<Unit>> / {task.write, Serving, net.accept[listener], net.recv[conn], net.send[conn], net.close[conn], abort.raise} =
  if left <= 0 { running } else {
    let c = net.accept[listener](listener);
    if c == 0 { running }
    else { spawned(listener, l, left - 1, running.push(task.spawn(|| serve_connection(c, l)))) }
  }

/// The same budget answered by `shedding.workers` tasks over a bounded queue: a connection that
/// finds it full, or that waited in it too long, is answered 503 with `Retry-After`, and when the
/// listener is closed under the loop every connection already taken is answered before it returns.
pub fn serve_pooled(
  listener: Int,
  l: http::Limits,
  count: Int,
  shedding: http::Shedding,
) -> http::PoolStats / {task.write, clock.read, Serving, net.accept[listener], net.recv[conn], net.send[conn], net.close[conn], abort.raise} =
  http::serve_pooled_with[listener, conn](
    listener,
    count,
    l,
    shedding,
    |c: Int, stop: Chan<Unit>| serve_connection_until(c, l, stop),
  )

fn joined(tasks: List<Task<Unit>>) -> Int / {task.write, abort.raise} =
  tasks.fold(0, |n: Int, t: Task<Unit>| {
    task.join(t);
    n + 1
  })

pub fn listen_and_serve(
  port: Int,
  count: Int,
) -> Int / {Serving, net.listen[listener], net.accept[listener], net.close[listener], net.recv[conn], net.send[conn], net.close[conn], abort.raise} = {
  let listener = net.listen[listener](port);
  let served = serve(listener, limits(), count);
  net.close[listener](listener);
  served
}

/// The service as a run's settings describe it: over TLS when they name a credential, answered by
/// the loop they choose, and saying on stdout which port it landed on — which is how a run asked
/// for port 0 is found.
pub fn listening(
  s: Settings,
) -> Int / {task.write, clock.read, Serving, net.listen[listener], net.listen_tls[listener], net.local_port[listener], net.accept[listener], net.close[listener], net.recv[conn], net.send[conn], net.close[conn], process.out[proc], abort.raise} = {
  let listener = match s.tls {
    None -> net.listen[listener](s.port),
    Some(credential) -> net.listen_tls[listener](s.port, credential),
  };
  match net.local_port[listener](listener) {
    Some(port) -> process.out[proc]("listening on " ++ port.to_string()),
    None -> (),
  };
  let served = match s.accept {
    Sequential -> serve(listener, limits(), s.connections),
    TaskPerConnection -> serve_each(listener, limits(), s.connections),
    Pooled(shedding) -> serve_pooled(listener, limits(), s.connections, shedding).served,
  };
  net.close[listener](listener);
  served
}

// --- The service, stocked and running ----------------------------------------------------

/// The fake on a plain listener, one connection at a time.
pub fn run_memory(
  port: Int,
  api: Option<Secret<String>>,
  count: Int,
) -> Int / {net.listen[listener], net.accept[listener], net.close[listener], net.recv[conn], net.send[conn], net.close[conn], abort.raise} =
  fake(api, || listen_and_serve(port, count))

/// The API key the *tests* drive the fake with.
pub fn fake_key() -> String = "fake-key-not-a-credential"

/// The service over a database that is a value and a sink that is a value: every operation
/// `Serving` names is answered here, and the credential from `api`.
pub fn fake<a | e>(
  api: Option<Secret<String>>,
  body: () -> a / {Serving | e},
) -> a / {abort.raise | e} =
  handle {
    over_values(stocked(seed_shelf(), seed_orders()), body).out
  } with {
    // Answered from the argument, and only for the key this service declares.
    config.secret[credentials](key) -> if key == api_key() { api } else { None },
    signal.stopping() -> signal::stopping_step(signal::running()),
  }

/// What `body` answers over the database `d` and an empty sink, beside what it leaves of both:
/// every `db` and `trace` operation `Serving` names is answered here, and the rest by the caller.
fn over_values<a | e>(
  d: db::MemDb,
  body: () -> a / {Serving | e},
) -> { out: a, db: db::MemDb, sink: trace::Sink } / {abort.raise, config.secret[credentials], signal.stopping | e} =
  handle {
    body()
  } with {
    var store = d,
    var sink = trace::sink(),
    db.query[*](q, ps) -> {
      let o = db::step(store, q, ps);
      store = o.db;
      o.out
    },
    db.execute[*](q, ps) -> {
      let o = db::step(store, q, ps);
      store = o.db;
      o.out
    },
    db.returning[*](q, ps) -> {
      let o = db::step(store, q, ps);
      store = o.db;
      o.out
    },
    db.begin(level, access) -> {
      let o = db::begin_step(store, level, access);
      store = o.db;
      o.out
    },
    db.commit() -> {
      let o = db::commit_step(store);
      store = o.db;
      o.out
    },
    db.abort() -> {
      let o = db::abort_step(store);
      store = o.db;
      o.out
    },
    db.rollback(reason) -> (),
    // Four clauses that are the whole of "a log is an effect".
    trace.enter[*channel](name, fs) -> {
      let o = trace::enter_step(sink, channel, name, fs);
      sink = o.sink;
      o.span
    },
    trace.exit[*](span, outcome) -> {
      let o = trace::exit_step(sink, span, outcome);
      sink = o.sink;
      // `exit_step` answers `ok: false` where the bound driver raises `E0445`, because a fake is a
      // value and a value does not raise.
      if o.ok { () } else { panic("trace.exit named a span that is not open") }
    },
    trace.event[*channel](level, name, fs) -> {
      sink = trace::event_step(sink, channel, level, name, fs);
    },
    trace.count[*channel](name, delta, fs) -> {
      sink = trace::count_step(sink, channel, name, delta, fs);
    },
    return out -> { out: out, db: store, sink: sink },
  }

/// The entry point: the settings, read once, and the store they name. Where to reach the database
/// is a setting too, and every `db` operation is answered from here rather than by a host.
fn main() -> Int / {Running, abort.raise, diverges} = {
  let key = config.secret[credentials](api_key());
  let s = configured(
    settings_of(
      port: config.get[server](port_key()),
      connections: config.get[server](connections_key()),
      store: config.get[server](store_key()),
      tls: config.get[server](tls_key()),
      accept: config.get[server](accept_key()),
    ),
  );
  match s.store {
    Memory -> fake(key, || listening(s)),
    Postgres -> postgres(config.get[server](database_key()), s, key),
  }
}

fn postgres(
  url: Option<String>,
  s: Settings,
  key: Option<Secret<String>>,
) -> Int / {Running, abort.raise, diverges} =
  handle {
    match with_server(configured_url(url), s.connections, || listening(s)) {
      Ok(served) -> served,
      Err(reason) -> panic("the service will not start: " ++ reason),
    }
  } with {
    // Answered from the value read above, once.
    config.secret[credentials](k) -> key,
  }

fn configured_url(resolved: Option<String>) -> String / {abort.raise} =
  match resolved {
    Some(url) -> url,
    None ->
      panic(
        "the service will not start: " ++ database_key()
          ++ " is unset; pass `--config-schema service.config` so the run refuses at start-up, or `--set "
          ++ database_key()
          ++ "=postgres://user@host/service`",
      ),
  }

fn configured<a>(resolved: Result<a, String>) -> a / {abort.raise} =
  match resolved { Ok(value) -> value, Err(reason) -> panic("the service will not start: " ++ reason) }

// --- What the service is stocked with ------------------------------------------------

pub fn seed_shelf() -> List<Item> =
  [
    { sku: "bolt", name: "hex bolt", price: 0.40m, on_hand: 500 },
    { sku: "gasket", name: "copper gasket", price: 2.25m, on_hand: 12 },
    { sku: "widget", name: "left-handed widget", price: 12.50m, on_hand: 3 },
  ]

pub fn seed_orders() -> List<Order> =
  [
    { id: 1, customer: "ada", lines: [{ sku: "bolt", qty: 10 }], total: 4.00m, state: Open },
    {
      id: 2,
      customer: "grace",
      lines: [{ sku: "gasket", qty: 2 }],
      total: 4.50m,
      state: Cancelled,
    },
  ]

/// A database with those rows in it, as a value.
pub fn stocked(shelf: List<Item>, orders: List<Order>) -> db::MemDb / {abort.raise} =
  orders.fold(
    shelf.fold(db::open(schema()), |d: db::MemDb, i: Item|
      stepped(d, item_insert(), item_row().params(i))),
    |d: db::MemDb, o: Order|
      stepped(d, order_insert(), [
        sql::TextParameter(o.customer),
        lines_param(o.lines),
        sql::NumericParameter(o.total),
        state_param(o.state),
      ]),
  )

/// A step whose answer must be a success.
fn stepped(d: db::MemDb, s: sql::Statement, ps: List<sql::Param>) -> db::MemDb / {abort.raise} = {
  let out = db::step(d, s, ps);
  match out.out {
    sql::Failed(e) -> panic("the fixture would not load: " ++ e.code ++ " " ++ e.detail),
    _ -> out.db,
  }
}

/// What the fake holds, read back through the same statements an endpoint uses, so an assertion
/// about the store is an assertion about what a request would see rather than about the fake's
/// internals.
pub fn shelf_of(d: db::MemDb) -> List<Item> / {abort.raise} = read_out(d, items_all(), item_row())

pub fn book_of(d: db::MemDb) -> List<Order> / {abort.raise} = read_out(d, orders_all(), order_row())

fn read_out<a>(d: db::MemDb, s: sql::Statement, c: sql::RowCodec<a>) -> List<a> / {abort.raise} =
  match sql::decode_rows(db::step(d, s, []).out, c) {
    Ok(xs) -> xs,
    Err(sql::InvalidRow(e)) -> panic("a row would not decode: " ++ e.column),
    Err(sql::Refused(e)) -> panic("a read of the fake failed: " ++ e.code ++ " " ++ e.detail),
    Err(sql::UnexpectedCount(_)) -> panic("a query answered a count"),
  }

// --- Tests: the business, which needs no handler at all ----------------------------

test "a total is an exact sum of exact products" {
  assert_eq(total_of(seed_shelf(), [{ sku: "bolt", qty: 10 }]), 4.00m);
  assert_eq(total_of(seed_shelf(), []), 0m);
  assert_eq(total_of(seed_shelf(), [{ sku: "gasket", qty: 2 }, { sku: "widget", qty: 1 }]), 17.00m);

  // The sum a Float would have got wrong.
  assert_eq(
    total_of(
      [
        { sku: "a", name: "a", price: 0.1m, on_hand: 9 },
        { sku: "b", name: "b", price: 0.2m, on_hand: 9 },
      ],
      [{ sku: "a", qty: 1 }, { sku: "b", qty: 1 }],
    ),
    0.3m,
  )
}

test "a line naming nothing on the shelf, and one the shelf cannot cover, are named back" {
  assert_eq(unknown_skus(seed_shelf(), [{ sku: "sprocket", qty: 1 }]), ["sprocket"]);
  assert_eq(unknown_skus(seed_shelf(), [{ sku: "bolt", qty: 1 }]), []);
  assert_eq(short_skus(seed_shelf(), [{ sku: "widget", qty: 4 }]), ["widget"]);
  assert_eq(short_skus(seed_shelf(), [{ sku: "widget", qty: 3 }]), [])
}

// Two lines for one sku are one draw on the shelf.
test "two lines naming one sku are checked as one draw on the shelf" {
  let doubled = [{ sku: "widget", qty: 2 }, { sku: "widget", qty: 2 }];
  assert_eq(short_skus(seed_shelf(), doubled), ["widget"]);
  assert_eq(
    item_named(draw_down(seed_shelf(), doubled), "widget"),
    Some({ sku: "widget", name: "left-handed widget", price: 12.50m, on_hand: -1 }),
  )
}

test "a quantity that is not positive is refused rather than clamped" {
  assert(bad_qty([{ sku: "bolt", qty: 0 }]));
  assert(bad_qty([{ sku: "bolt", qty: 1 }, { sku: "gasket", qty: -5 }]));
  assert(!bad_qty([{ sku: "bolt", qty: 1 }]));
  assert(!bad_qty([]))
}

// A typed binder is the difference between a route that matches and one that does not, so these are
// claims about the table's shape rather than about a parser this file owns.
test "an order id is a segment that parses as an Int, and nothing else routes" {
  assert_eq(
    route_of(http::Get, "/orders/7"),
    router::Found({ endpoint: GetOrder, params: Map::of_entries([{ key: "id", value: "7" }]) }),
  );
  assert_eq(route_of(http::Get, "/orders/seven"), router::NotFound);
  assert_eq(route_of(http::Get, "/orders/+7"), router::NotFound);
  assert_eq(route_of(http::Get, "/orders/7.0"), router::NotFound);
  assert_eq(route_of(http::Get, "/orders/%D9%A7"), router::NotFound)
}

// --- Tests: the route table, which is a value ---------------------------------------

test "the route table is unambiguous and well formed" {
  assert_eq(router::conflicts(table()), []);
  assert_eq(router::well_formed(table()), [])
}

test "a literal beats a parameter at the position they differ" {
  assert_eq(
    route_of(http::Get, "/items/featured"),
    router::Found({ endpoint: Featured, params: Map::new() }),
  );
  assert_eq(
    route_of(http::Get, "/items/bolt"),
    router::Found({ endpoint: GetItem, params: Map::of_entries([{ key: "sku", value: "bolt" }]) }),
  )
}

test "a path no route matches is NotFound, and one under another method names the methods" {
  assert_eq(route_of(http::Get, "/nowhere"), router::NotFound);
  assert_eq(route_of(http::Put, "/orders"), router::MethodNotAllowed([http::Get, http::Post]));
  assert_eq(route_of(http::Post, "/orders/1"), router::MethodNotAllowed([http::Delete, http::Get]))
}

// A trailing empty segment is kept rather than normalized away, so `/orders/` is a two-segment path
// whose second segment is empty and matches neither route.
test "/orders and /orders/ are different paths" {
  assert_eq(
    route_of(http::Get, "/orders"),
    router::Found({ endpoint: ListOrders, params: Map::new() }),
  );
  assert_eq(route_of(http::Get, "/orders/"), router::NotFound);
  assert_eq(router::normalize_path("/orders/"), "/orders")
}

// Percent-decoding happens per segment, after splitting, so `%2F` decodes to a `/` inside one
// segment and can never introduce a boundary.
test "a percent-encoded slash stays inside the segment it was written in" {
  assert_eq(
    route_of(http::Get, "/items/a%2Fb"),
    router::Found({ endpoint: GetItem, params: Map::of_entries([{ key: "sku", value: "a/b" }]) }),
  )
}

test "a Rest segment captures every remaining segment, joined" {
  assert_eq(
    route_of(http::Get, "/docs/orders/placing"),
    router::Found({
      endpoint: Docs,
      params: Map::of_entries([{ key: "page", value: "orders/placing" }]),
    }),
  );
  assert_eq(
    route_of(http::Get, "/docs"),
    router::Found({ endpoint: Docs, params: Map::of_entries([{ key: "page", value: "" }]) }),
  )
}

// --- Tests: every route, hermetically -----------------------------------------------

pub type Ran<a> = {
  out: a,
  shelf: List<Item>,
  book: List<Order>,
  /// Every record the request produced, in `seq` order, with every span the program left open
  /// closed `Abandoned` by `drain`.
  records: List<trace::Record>,
}

/// The whole service's world, installed as values.
fn against<a | e>(
  d: db::MemDb,
  values: config::Values,
  body: () -> a / {Serving | e},
) -> Ran<a> / {abort.raise, signal.stopping | e} = {
  let ran = handle {
    over_values(d, body)
  } with {
    config.secret[credentials](key) -> config::get_secret(values, key),
    // And **not** `signal`, which the caller handles.
  };
  {
    out: ran.out,
    shelf: shelf_of(ran.db),
    book: book_of(ran.db),
    // `drain` closes every span the program left open as `Abandoned`, so a hermetic test observes
    // the same records a bound run would write.
    records: trace::drain(ran.sink),
  }
}

/// The service as `examples/service.sql` seeds it, with a key configured and nobody asking it to
/// stop.
fn under<a | e>(d: db::MemDb, body: () -> a / {Serving | e}) -> Ran<a> / {abort.raise | e} =
  handle {
    against(d, config::one_secret(api_key(), fake_key()), body)
  } with {
    signal.stopping() -> false,
  }

/// The service as `examples/service.sql` seeds it.
fn stock() -> db::MemDb / {abort.raise} = stocked(seed_shelf(), seed_orders())

fn served_by(
  m: http::Method,
  path: String,
  body: Bytes,
) -> Ran<http::Response<| {}>> / {abort.raise} = under(stock(), || app(request(m, path, body)))

/// A placement, with the key.
fn posted(body: String) -> Ran<http::Response<| {}>> / {abort.raise} =
  under(stock(), || app(authorized_request(http::Post, "/orders", Bytes::of_string(body))))

fn request(m: http::Method, path: String, body: Bytes) -> http::Request =
  {
    method: m,
    target: path,
    path: path,
    query: "",
    authority: "localhost",
    version: http::Http11,
    headers: Map::new(),
    trailers: Map::new(),
    body: http::Whole(body),
    peer: None,
    client_certificate: None,
  }

/// A request carrying the key the fake is configured with.
fn authorized_request(m: http::Method, path: String, body: Bytes) -> http::Request =
  {
    method: m,
    target: path,
    path: path,
    query: "",
    authority: "localhost",
    version: http::Http11,
    headers: Map::of_entries([field("x-api-key", fake_key())]),
    trailers: Map::new(),
    body: http::Whole(body),
    peer: None,
    client_certificate: None,
  }

/// The names of the records a run produced, in order.
fn recorded_names(rs: List<trace::Record>) -> List<String> = rs.map(|r: trace::Record| r.name)

fn outcomes_of(rs: List<trace::Record>) -> List<trace::Outcome> =
  rs.filter(|r: trace::Record| r.kind == trace::Exit).map(|r: trace::Record| r.outcome)

fn body_string(r: http::Response<| {}>) -> String / {abort.raise} =
  String::of_bytes(http::whole_bytes(r.body))

test "GET /health is pure and counts the table it is served from" {
  let r = served_by(http::Get, "/health", b"");
  assert_eq(r.out.status, 200);
  assert_eq(
    json::decode_bytes(http::whole_bytes(r.out.body), health_json()),
    Ok({ service: "parts", routes: 11 }),
  );
  // Pure means pure: the store this request was handed is the store it left.
  assert_eq(r.shelf, seed_shelf());
  assert_eq(r.book, seed_orders())
}

test "GET /docs serves a page, and names the pages when there is none" {
  let ok = served_by(http::Get, "/docs/orders/cancelling", b"");
  assert_eq(ok.out.status, 200);
  assert_eq(body_string(ok.out), "DELETE /orders/{id} puts the lines back on the shelf\n");
  assert_eq(served_by(http::Get, "/docs/nothing", b"").out.status, 404)
}

// A handler is a capability grant, and this is the one place the grant is a subset: `list_items` is
// called rather than routed, so its row is one effect and one clause discharges it.
test "list_items reaches one table, and the type is what says so" {
  handle {
    let r = list_items();
    assert_eq(r.status, 200);
    assert_eq(
      json::decode_bytes(http::whole_bytes(r.body), json::list_json(item_json())),
      Ok(seed_shelf()),
    )
  } with {
    var c = stock(),
    db.query[items](s, ps) -> {
      let o = db::step(c, s, ps);
      c = o.db;
      o.out
    },
  }
}

test "GET /items reads the shelf and answers it in sku order" {
  let r = served_by(http::Get, "/items", b"");
  assert_eq(r.out.status, 200);
  assert_eq(
    json::decode_bytes(http::whole_bytes(r.out.body), json::list_json(item_json())),
    Ok(seed_shelf()),
  )
}

// The literal route, which shares a resource with `/items/{sku}` and effects with it too: two
// reads of one resource do not conflict, so the two tests below are placed in the same concurrency
// group and run side by side.
test "GET /items/featured is the shelf minus what is out of stock" {
  let flange = { sku: "flange", name: "flange", price: 1.00m, on_hand: 0 };
  let r = under(stocked(seed_shelf().push(flange), []), ||
    app(request(http::Get, "/items/featured", b"")));
  assert_eq(r.out.status, 200);
  assert_eq(
    json::decode_bytes(http::whole_bytes(r.out.body), json::list_json(item_json())),
    Ok(seed_shelf()),
  )
}

test "GET /items/{sku} answers the item, and 404s the one nobody stocks" {
  assert_eq(served_by(http::Get, "/items/gasket", b"").out.status, 200);
  let missing = served_by(http::Get, "/items/sprocket", b"");
  assert_eq(missing.out.status, 404);
  assert_eq(
    json::decode_bytes(http::whole_bytes(missing.out.body), problem_json()),
    Ok({ error: "no such item", detail: "sprocket" }),
  )
}

// A `sku` that would end a string literal if a value ever became syntax.
test "a sku that looks like an injection is a value and nothing else" {
  let r = served_by(http::Get, "/items/'; drop table items; --", b"");
  assert_eq(r.out.status, 404);
  assert_eq(r.shelf, seed_shelf())
}

test "GET /orders reads the order book and answers it in id order" {
  let r = served_by(http::Get, "/orders", b"");
  assert_eq(r.out.status, 200);
  assert_eq(
    json::decode_bytes(http::whole_bytes(r.out.body), json::list_json(order_json())),
    Ok(seed_orders()),
  )
}

test "GET /orders/{id:Int} answers one order, and an unparseable id routes nowhere" {
  assert_eq(served_by(http::Get, "/orders/1", b"").out.status, 200);
  assert_eq(served_by(http::Get, "/orders/99", b"").out.status, 404);
  // Not a 400 from inside the endpoint: `seven` never parses, so no route matches and the answer
  // comes from the table rather than from a check the handler had to remember to write.
  let unrouted = served_by(http::Get, "/orders/seven", b"");
  assert_eq(unrouted.out.status, 404);
  assert_eq(
    json::decode_bytes(http::whole_bytes(unrouted.out.body), problem_json()),
    Ok({ error: "no such route", detail: "/orders/seven" }),
  )
}

// The id is 3 because the sequence handed out 1 and 2 to the seeds, which is the fixture going in
// through the same insert a request does rather than through a side door that would have left the
// sequence at zero.
test "POST /orders prices the lines, draws the shelf down and records a line" {
  let r = posted("{\"customer\":\"hedy\",\"lines\":[{\"sku\":\"widget\",\"qty\":2}]}");
  assert_eq(r.out.status, 201);
  assert_eq(
    json::decode_bytes(http::whole_bytes(r.out.body), order_json()),
    Ok({ id: 3, customer: "hedy", lines: [{ sku: "widget", qty: 2 }], total: 25.00m, state: Open }),
  );
  assert_eq(
    item_named(r.shelf, "widget"),
    Some({ sku: "widget", name: "left-handed widget", price: 12.50m, on_hand: 1 }),
  );
  assert_eq(r.book.len(), 3);
  // What the request recorded, in order and on the right channels: the request span opened, the
  // shelf moved, the order was placed, the counter went up, and the span closed `Ok`.
  assert_eq(recorded_names(r.records), [
    "dispatch",
    "reserving",
    "shelf moved",
    "placed",
    "orders placed",
    "reserving",
    "dispatch",
  ]);
  assert_eq(trace::on_channel(r.records, "items").len(), 1);
  assert_eq(trace::on_channel(r.records, "http").len(), 2);
  assert_eq(trace::counter_total(r.records, "orders placed"), 1);
  // Both spans closed, both `Ok`, innermost first — which is the nesting an operator reads as "the
  // request spent its time reserving".
  assert_eq(outcomes_of(r.records), [trace::Ok, trace::Ok])
}

// The rollback, driven by a route rather than by a unit test.
test "an order the shelf cannot cover writes nothing and says which sku" {
  let r = posted("{\"customer\":\"ada\",\"lines\":[{\"sku\":\"widget\",\"qty\":9}]}");
  assert_eq(r.out.status, 409);
  assert_eq(
    json::decode_bytes(http::whole_bytes(r.out.body), problem_json()),
    Ok({ error: "out of stock", detail: "widget" }),
  );
  assert_eq(r.shelf, seed_shelf());
  assert_eq(r.book, seed_orders());
  // Nothing was placed, so nothing was recorded about a placement: both the event and the counter
  // are in the continuation the rollback discarded, and so is the `shelf moved` record — which is
  // why it says the shelf moved rather than that something tried to.
  assert_eq(recorded_names(r.records), ["dispatch", "reserving", "reserving", "dispatch"]);
  // The span the rollback discarded is closed `Abandoned` by the enclosing `exit`, and the request
  // span closes `Failed` carrying the status.
  assert_eq(outcomes_of(r.records), [trace::Abandoned, trace::Failed("409")])
}

// The one thing a rollback does not undo, pinned so that nobody has to discover it.
test "a rolled-back placement consumes the order number it was given" {
  let r = under(stock(), || {
    assert_eq(
      app(
        authorized_request(
          http::Post,
          "/orders",
          Bytes::of_string("{\"customer\":\"ada\",\"lines\":[{\"sku\":\"widget\",\"qty\":9}]}"),
        ),
      ).status,
      409,
    );
    app(
      authorized_request(
        http::Post,
        "/orders",
        Bytes::of_string("{\"customer\":\"hedy\",\"lines\":[{\"sku\":\"widget\",\"qty\":2}]}"),
      ),
    )
  });
  assert_eq(r.out.status, 201);
  assert_eq(
    json::decode_bytes(http::whole_bytes(r.out.body), order_json()),
    Ok({ id: 4, customer: "hedy", lines: [{ sku: "widget", qty: 2 }], total: 25.00m, state: Open }),
  );
  assert_eq(r.book.len(), 3)
}

// The same refusal when the quantity is spread over two lines, which is the version a per-line
// check would have sold.
test "two lines for one sku are one reservation, and are refused as one" {
  let r = posted(
    "{\"customer\":\"ada\",\"lines\":[{\"sku\":\"widget\",\"qty\":2},"
      ++ "{\"sku\":\"widget\",\"qty\":2}]}",
  );
  assert_eq(r.out.status, 409);
  assert_eq(r.shelf, seed_shelf());
  assert_eq(r.book, seed_orders())
}

test "an order naming nothing on the shelf is refused before anything is written" {
  let r = posted("{\"customer\":\"ada\",\"lines\":[{\"sku\":\"sprocket\",\"qty\":1}]}");
  assert_eq(r.out.status, 404);
  assert_eq(
    json::decode_bytes(http::whole_bytes(r.out.body), problem_json()),
    Ok({ error: "no such item", detail: "sprocket" }),
  );
  assert_eq(r.book, seed_orders())
}

test "a body that does not fit the type is refused by field and reason" {
  let r = posted("{\"customer\":\"ada\",\"lines\":[{\"sku\":\"bolt\",\"qty\":\"two\"}]}");
  assert_eq(r.out.status, 400);
  assert_eq(
    json::decode_bytes(http::whole_bytes(r.out.body), problem_json()),
    Ok({ error: "malformed body", detail: "$.lines[0].qty: expected a number, found a string" }),
  );
  // A body that never parsed opened no transaction, so there is nothing to roll back and nothing
  // was.
  assert_eq(r.book, seed_orders())
}

test "an empty order and a line with no quantity are refused without a transaction" {
  let empty = posted("{\"customer\":\"ada\",\"lines\":[]}");
  assert_eq(empty.out.status, 422);
  let zero = posted("{\"customer\":\"ada\",\"lines\":[{\"sku\":\"bolt\",\"qty\":0}]}");
  assert_eq(zero.out.status, 422);
  assert_eq(zero.shelf, seed_shelf())
}

test "DELETE /orders/{id} puts the lines back and cancels once" {
  let r = under(stock(), || {
    assert_eq(app(request(http::Delete, "/orders/1", b"")).status, 200);
    assert_eq(app(request(http::Delete, "/orders/1", b"")).status, 409);
    assert_eq(app(request(http::Delete, "/orders/99", b"")).status, 404)
  });
  assert_eq(
    item_named(r.shelf, "bolt"),
    Some({ sku: "bolt", name: "hex bolt", price: 0.40m, on_hand: 510 }),
  );
  // Three requests, three spans, and exactly one cancellation recorded — the two that were refused
  // are `Failed` spans with nothing under them.
  assert_eq(trace::named(r.records, "cancelled") != [], true);
  assert_eq(trace::named(r.records, "cancelled").len(), 1);
  assert_eq(outcomes_of(r.records), [trace::Ok, trace::Failed("409"), trace::Failed("404")])
}

test "a route nobody serves is 404 and a method nobody serves is 405 with Allow" {
  let missing = served_by(http::Get, "/nowhere", b"");
  assert_eq(missing.out.status, 404);
  let wrong = served_by(http::Put, "/orders", b"");
  assert_eq(wrong.out.status, 405);
  assert_eq(wrong.out.headers.get("allow"), Some(["GET, POST"]))
}

// --- Tests: liveness, readiness, and the difference -----------------------------------

test "GET /health is 200 with no store, no clock and no stop flag in reach" {
  // Called rather than routed, and handled by nothing at all — which is only possible because
  // `health`'s row is empty.
  let r = health();
  assert_eq(r.status, 200);
  assert_eq(
    json::decode_bytes(http::whole_bytes(r.body), health_json()),
    Ok({ service: "parts", routes: 11 }),
  )
}

test "GET /ready is 200 when the store answers and nobody has asked it to stop" {
  let r = served_by(http::Get, "/ready", b"");
  assert_eq(r.out.status, 200);
  assert_eq(
    json::decode_bytes(http::whole_bytes(r.out.body), readiness_json()),
    Ok({ service: "parts", store: "reachable", stopping: false }),
  );
  // A readiness poll is one aggregate and leaves nothing behind.
  assert_eq(r.shelf, seed_shelf());
  assert_eq(r.book, seed_orders())
}

// The case an operator most needs and most services get wrong: the database is gone, and the two
// probes must answer differently.
test "GET /ready is 503 when the store is unreachable and /health is still 200" {
  handle {
    let r = ready();
    assert_eq(r.status, 503);
    assert_eq(
      json::decode_bytes(http::whole_bytes(r.body), readiness_json()),
      Ok({ service: "parts", store: "57P01", stopping: false }),
    );
    // The same process, the same moment, the same outage.
    assert_eq(health().status, 200)
  } with {
    // Two clauses, because `ready`'s row is two effects.
    db.query[items](q, ps) ->
      sql::Failed({ code: "57P01", constraint: "", detail: "terminating connection" }),
    signal.stopping() -> false,
  }
}

test "a draining service answers 503 before it stops accepting, and asks no database" {
  handle {
    let r = ready();
    assert_eq(r.status, 503);
    assert_eq(
      json::decode_bytes(http::whole_bytes(r.body), readiness_json()),
      Ok({ service: "parts", store: "draining", stopping: true }),
    );
    assert_eq(health().status, 200)
  } with {
    signal.stopping() -> true,
    // The stop flag is read first, so a draining instance answers without spending a connection.
    db.query[items](q, ps) -> panic("a draining service must not ask the database"),
  }
}

// --- Tests: the credential, which the type system keeps out of everything -------------

// The unit that says a missing key is a refusal.
test "an unset credential refuses, an empty one refuses, and a wrong one refuses" {
  assert(!authorized(None, "anything"));
  assert(!authorized(Some(Secret::of_string("")), ""));
  assert(!authorized(Some(Secret::of_string("key")), ""));
  assert(!authorized(Some(Secret::of_string("key")), "keys"));
  assert(!authorized(Some(Secret::of_string("key")), "Key"));
  assert(authorized(Some(Secret::of_string("key")), "key"))
}

test "POST /orders takes the configured key and refuses every other request" {
  let body = "{\"customer\":\"ada\",\"lines\":[{\"sku\":\"bolt\",\"qty\":1}]}";

  let accepted = posted(body);
  assert_eq(accepted.out.status, 201);

  let guessed = under(stock(), ||
    app({
      method: http::Post,
      target: "/orders",
      path: "/orders",
      query: "",
      authority: "localhost",
      version: http::Http11,
      headers: Map::of_entries([field("x-api-key", "guess")]),
      trailers: Map::new(),
      body: http::Whole(Bytes::of_string(body)),
      peer: None,
      client_certificate: None,
    }));
  assert_eq(guessed.out.status, 401);
  assert_eq(guessed.book, seed_orders());
  // The refusal is recorded as a fact — that a key was presented and did not match — and never as a
  // value.
  assert_eq(recorded_names(guessed.records), ["dispatch", "api key refused", "dispatch"]);
  assert_eq(outcomes_of(guessed.records), [trace::Failed("401")]);

  let bare = under(stock(), || app(request(http::Post, "/orders", Bytes::of_string(body))));
  assert_eq(bare.out.status, 401);
  assert_eq(bare.book, seed_orders())
}

// The failure mode that matters more than a wrong key: no key at all.
test "a service with no credential configured refuses POST /orders rather than accepting it" {
  let r = handle {
    against(stock(), config::no_values(), ||
      app(
        authorized_request(
          http::Post,
          "/orders",
          Bytes::of_string("{\"customer\":\"ada\",\"lines\":[{\"sku\":\"bolt\",\"qty\":1}]}"),
        ),
      ))
  } with {
    signal.stopping() -> false,
  };
  assert_eq(r.out.status, 401);
  assert_eq(r.book, seed_orders());
  assert_eq(r.shelf, seed_shelf())
}

// The credential's bytes, hunted for in everything a request produced.
test "the configured credential appears in no response, no field and no record" {
  let r = posted("{\"customer\":\"ada\",\"lines\":[{\"sku\":\"bolt\",\"qty\":1}]}");
  assert_eq(r.out.status, 201);
  let key = Bytes::of_string(fake_key());
  assert_eq(http::whole_bytes(r.out.body).index_of(key), None);
  assert_eq(Bytes::of_string(join(recorded_names(r.records))).index_of(key), None);
  assert_eq(Bytes::of_string(rendered_fields(r.records)).index_of(key), None)
}

/// Every field of every record, rendered.
fn rendered_fields(rs: List<trace::Record>) -> String =
  rs.fold("", |acc: String, r: trace::Record|
    r.fields.keys().fold(acc, |inner: String, k: String|
      inner ++ k ++ "=" ++ shown_field(r.fields.get(k)) ++ ";"))

fn shown_field(f: Option<trace::Field>) -> String =
  match f {
    Some(trace::StringField(t)) -> t,
    Some(trace::IntField(n)) -> n.to_string(),
    Some(trace::BoolField(b)) -> if b { "true" } else { "false" },
    Some(trace::DecimalField(d)) -> d.to_string(),
    _ -> "",
  }

// --- Tests: the configuration a run refuses to start without ---------------------------

test "the schema declares the keys the service cannot start without, and defaults the rest" {
  let keys = config().keys;
  assert_eq(keys.len(), 7);
  // The credential is `SSecret` and required.
  assert_eq(
    key_named(keys, api_key()),
    Some({ name: "SERVICE_API_KEY", shape: config::SSecret, required: true, default: None }),
  );
  // Where to reach the database is optional in the schema and required by a service over postgres:
  // the fake has no database, so a run of it supplies no URL.
  assert_eq(
    key_named(keys, database_key()),
    Some({ name: "SERVICE_DATABASE", shape: config::SText, required: false, default: None }),
  );
  // The port has a default, so `ply run --config-schema service.config` starts a service with no
  // configuration written anywhere.
  assert_eq(
    key_named(keys, port_key()),
    Some({ name: "SERVICE_PORT", shape: config::SInt, required: false, default: Some("8137") }),
  );
  // Unset, a service serves postgres in plaintext, one connection at a time.
  assert_eq(
    key_named(keys, store_key()),
    Some({
      name: "SERVICE_STORE",
      shape: config::SText,
      required: false,
      default: Some("postgres"),
    }),
  );
  assert_eq(
    key_named(keys, tls_key()),
    Some({ name: "SERVICE_TLS", shape: config::SText, required: false, default: None }),
  );
  assert_eq(
    key_named(keys, accept_key()),
    Some({
      name: "SERVICE_ACCEPT",
      shape: config::SText,
      required: false,
      default: Some("sequential"),
    }),
  )
}

fn key_named(keys: List<config::Key>, name: String) -> Option<config::Key> =
  keys.fold(None, |found: Option<config::Key>, k: config::Key|
    if k.name == name { Some(k) } else { found })

// What a run that forgot `--config-schema` gets: a refusal that names the flag, rather than a
// service listening on a port nobody chose.
test "a service told nothing about its port refuses to start and says which flag to pass" {
  match port_of(None) {
    Ok(port) -> panic("an unset port must not resolve to " ++ port.to_string()),
    Err(reason) -> {
      assert(mentions(reason, b"SERVICE_PORT"));
      assert(mentions(reason, b"--config-schema"))
    },
  };
  assert_eq(port_of(Some("8137")), Ok(8137));
  match port_of(Some("eight")) {
    Ok(_) -> panic("`eight` is not a port"),
    Err(reason) -> assert(mentions(reason, b"eight")),
  };
  // A port past 65535 is a configuration nobody meant, and it is refused here rather than turning
  // into a listener that never binds; port 0 is any free one.
  assert(port_of(Some("70000")) != Ok(70000));
  assert_eq(port_of(Some("0")), Ok(0))
}

test "a connection budget that is absent defaults and one that is zero refuses" {
  assert_eq(connections_of(None), Ok(64));
  assert_eq(connections_of(Some("8")), Ok(8));
  match connections_of(Some("0")) {
    Ok(_) -> panic("a service that serves zero connections would look healthy"),
    Err(reason) -> assert(mentions(reason, b"SERVICE_CONNECTIONS")),
  }
}

test "a service given only its port serves postgres in plaintext, one connection at a time" {
  assert_eq(
    settings_of(port: Some("8137")),
    Ok({ port: 8137, connections: 64, store: Postgres, tls: None, accept: Sequential }),
  )
}

test "each way of running the service is a setting, and a value it does not know refuses to start" {
  assert_eq(
    settings_of(
      port: Some("0"),
      connections: Some("9"),
      store: Some("memory"),
      tls: Some("service"),
      accept: Some("task-per-connection"),
    ),
    Ok({ port: 0, connections: 9, store: Memory, tls: Some("service"), accept: TaskPerConnection }),
  );
  assert_eq(
    settings_of(port: Some("0"), accept: Some("pooled")),
    Ok({
      port: 0,
      connections: 64,
      store: Postgres,
      tls: None,
      accept: Pooled(http::default_shedding()),
    }),
  );
  match settings_of(port: Some("8137"), store: Some("sqlite")) {
    Ok(_) -> panic("`sqlite` is not a store the service has"),
    Err(reason) -> assert(mentions(reason, b"SERVICE_STORE")),
  };
  match settings_of(port: Some("8137"), accept: Some("threads")) {
    Ok(_) -> panic("`threads` is not an accept loop the service has"),
    Err(reason) -> assert(mentions(reason, b"SERVICE_ACCEPT")),
  };
  // An empty credential name would listen over TLS with nothing to present.
  match settings_of(port: Some("8137"), tls: Some("")) {
    Ok(_) -> panic("an empty credential name is not a credential"),
    Err(reason) -> assert(mentions(reason, b"SERVICE_TLS")),
  }
}

fn mentions(text: String, needle: Bytes) -> Bool = Bytes::of_string(text).index_of(needle) != None

// --- Tests: the drain ------------------------------------------------------------------

// the drain's exit criterion, and it is a claim about what is *absent*: not one line of
// `serve`, `serve_connection` or the framing changed to make a signal drain this service.
test "a signal drains the accept loop with no source change" {
  let r = under(stock(), ||
    handle {
      // Asked for eight connections and given one, because a stop arrived.
      listen_and_serve(8137, 8)
    } with {
      var stop = signal::running(),
      var queue = [get_line("/health")],
      var sent = [],
      var shut = 0,
      net.listen[listener](port) -> 1,
      // Phase 2 of the shutdown sequence, as this service sees it: the listening socket is closed,
      // so `accept` answers `0`.
      net.accept[listener](l) -> if signal::stopping_step(stop) { 0 } else { 7 },
      net.close[listener](l) -> {
        shut = shut + 1;
      },
      net.recv[conn](c, max, timeout_ms) -> {
        let queued = queue;
        queue = rest_of(queued);
        Some(first_of(queued))
      },
      net.send[conn](c, payload, timeout_ms) -> {
        sent = sent.push(payload);
        Some(payload.len())
      },
      // The signal, arriving.
      net.close[conn](c) -> {
        stop = signal::draining(30000);
      },
      // The clause that reads the flag, beside the one that sets it.
      signal.stopping() -> signal::stopping_step(stop),
      return served -> { served: served, sent: sent, shut: shut },
    });
  // One connection served, completely: the request in flight was answered rather than cut off.
  assert_eq(r.out.served, 1);
  let wrote = Bytes::concat_all(r.out.sent);
  assert_eq(status_of(wrote), 200);
  assert(wrote.index_of(b"\"service\":\"parts\"") != None);
  // And the listener was closed on the way out, which is what `serve` returning means.
  assert_eq(r.out.shut, 1);
  // The drain left nothing open: every span the run produced is closed, so a reader of the
  // records sees a complete request rather than a dangling one.
  assert_eq(outcomes_of(r.records), [trace::Ok])
}

/// What `count` clients each asking for `path` once were answered by a pooled service of one worker
/// and a queue of one, and how the pool counted them.
fn pooled_run(
  count: Int,
  path: String,
) -> net::RunResult<http::PoolStats> / {sim.read, abort.raise} = {
  let asked = Bytes::of_string(
    "GET " ++ path ++ " HTTP/1.1\r\nHost: service.example\r\nConnection: close\r\n\r\n",
  );
  let callers = range(0, count).fold(net::mem_empty(), |m: net::MemNet, i: Int|
    net::mem_calling(m, ip::socket_at(ip::loopback_v4(), 4000 + i), [net::Sends(asked)]));
  fake(Some(Secret::of_string(fake_key())), ||
    net::on_mem(callers, ||
      simulate {
        let listener = net.listen[listener](0);
        serve_pooled(listener, limits(), 10, { ..http::default_shedding(), workers: 1, queue: 1 })
      }))
}

test "a pooled service sheds what its queue cannot hold, and answers every connection it took" {
  let ran = pooled_run(2, "/health");
  let p = ran.value;
  // Whether the one worker was free as each arrived is the schedule's to say, in every one of them.
  assert_eq(p.served + p.shed_full + p.shed_late, 2);
  assert(p.served >= 1);
  let wrote = range(2, 4).map(|c: Int| net::mem_sent(ran.net, c));
  assert_eq(wrote.filter(|w: Bytes| status_of(w) == 200).len(), p.served);
  assert_eq(
    wrote.filter(|w: Bytes| status_of(w) == 503 && w.index_of(b"retry-after: 1\r\n") != None).len(),
    p.shed_full,
  );
  // Each connection taken was answered once and closed: the stop drained it.
  assert_eq(ran.net.closed.len(), 2)
}

test "a kept-alive service connection under a stop is answered as its last, and not waited on" {
  let ran = fake(Some(Secret::of_string(fake_key())), ||
    net::on_mem(
      net::mem_calling(net::mem_empty(), ip::socket_at(ip::loopback_v4(), 4000), [
        net::Sends(get_line("/health")),
        net::Silent,
      ]),
      ||
        simulate {
          let stop: Chan<Unit> = task.channel(0);
          task.close(stop);
          let listener = net.listen[listener](0);
          serve_connection_until(net.accept[listener](listener), limits(), stop)
        },
    ));
  let wrote = net::mem_sent(ran.net, 2);
  assert_eq(status_of(wrote), 200);
  assert(wrote.index_of(b"Connection: close\r\n") != None);
  assert_eq(net::mem_deadlines(ran.net, 2).len(), 1);
  assert_eq(ran.net.closed, [2])
}

// The other half of the drain, from the client's side: while a stop is pending but the listener is
// still accepting — the `--drain-lead-ms` window — the service answers `/ready` with 503 and keeps
// answering everything else.
test "during the drain lead a service is unready and still serving" {
  let r = handle {
    against(stock(), config::one_secret(api_key(), fake_key()), || {
      let ready = app(request(http::Get, "/ready", b""));
      let items = app(request(http::Get, "/items", b""));
      { ready: ready.status, items: items.status }
    })
  } with {
    signal.stopping() -> true,
  };
  // A load balancer polling `/ready` removes this instance…
  assert_eq(r.out.ready, 503);
  // …while the requests already in flight are still answered properly.
  assert_eq(r.out.items, 200)
}

// --- Tests: the streamed receipt ------------------------------------------------------

fn ada_order() -> Order =
  { id: 1, customer: "ada", lines: [{ sku: "bolt", qty: 10 }], total: 4.00m, state: Open }

test "a receipt is produced one line at a time and ends" {
  let c = cursor_for(ada_order(), seed_shelf());
  assert_eq(
    drained(c),
    Bytes::of_string(
      "receipt for order 1\ncustomer: ada\n  10 x bolt @ 0.40 = 4.00\ntotal: 4.00\n",
    ),
  );
  assert_eq(chunks_of(c, []).len(), 3)
}

// Two clauses, and they are the two effects `receipt`'s row names.
test "GET /orders/{id}/receipt streams, and a missing order does not" {
  handle {
    match receipt(Map::of_entries([{ key: "id", value: "1" }])) {
      Stream(s) -> {
        assert_eq(s.head.status, 200);
        assert_eq(http::whole_bytes(s.head.body), b"")
      },
      Buffered(_) -> panic("an order that exists is streamed"),
    };
    match receipt(Map::of_entries([{ key: "id", value: "99" }])) {
      Buffered(r) -> assert_eq(r.status, 404),
      Stream(_) -> panic("an order that does not exist has nothing to stream"),
    }
  } with {
    var c = stock(),
    db.query[orders](s, ps) -> {
      let o = db::step(c, s, ps);
      c = o.db;
      o.out
    },
    db.query[items](s, ps) -> {
      let o = db::step(c, s, ps);
      c = o.db;
      o.out
    },
  }
}

// --- The whole service, over a simulated socket ---------------------------------------

type Exchange = { wrote: Bytes, sent: Int, closes: Int, shelf: List<Item>, book: List<Order> }

fn first_of(queued: List<Bytes>) -> Bytes = match queued { [first, ..] -> first, _ -> b"" }

fn rest_of(queued: List<Bytes>) -> List<Bytes> = match queued { [_, ..rest] -> rest, _ -> [] }

fn exchange(inbox: List<Bytes>, shelf: List<Item>, book: List<Order>) -> Exchange / {abort.raise} = {
  let ran = under(stocked(shelf, book), ||
    handle {
      serve_connection(7, limits())
    } with {
      var queue = inbox,
      var sent = [],
      var closes = 0,
      net.recv[conn](c, max, timeout_ms) -> {
        let queued = queue;
        queue = rest_of(queued);
        Some(first_of(queued))
      },
      net.send[conn](c, payload, timeout_ms) -> {
        sent = sent.push(payload);
        Some(payload.len())
      },
      net.close[conn](c) -> {
        closes = closes + 1;
      },
      return u -> { sent: sent, closes: closes },
    });
  {
    wrote: Bytes::concat_all(ran.out.sent),
    // How many *responses* were written, counted as the writes that begin with a status line:
    // `send_all` writes a buffered response in one, and `http::respond` writes a stream's head
    // and then chunks that begin with a hex size.
    sent: ran.out.sent.filter(|p: Bytes| p.starts_with(b"HTTP/1.1 ")).len(),
    closes: ran.out.closes,
    shelf: ran.shelf,
    book: ran.book,
  }
}

fn served(raw: Bytes) -> Exchange / {abort.raise} = exchange([raw], seed_shelf(), seed_orders())

/// The status of the first response written, or 0 when nothing was.
fn status_of(raw: Bytes) -> Int / {abort.raise} =
  match raw.index_of(b" ") {
    None -> 0,
    Some(sp) -> match router::int_of_text(
        String::of_bytes_lossy(
          raw.slice(sp + 1, if sp + 4 > raw.len() { raw.len() } else { sp + 4 }),
        ),
      ) {
      Some(n) -> n,
      None -> 0,
    },
  }

fn head_end(raw: Bytes) -> Int =
  match raw.index_of(b"\r\n\r\n") { Some(at) -> at + 4, None -> raw.len() }

fn get_line(path: String) -> Bytes =
  Bytes::of_string("GET " ++ path ++ " HTTP/1.1\r\nHost: service.example\r\n\r\n")

test "a request over the simulated socket is answered and the connection closed" {
  let e = served(get_line("/health"));
  assert_eq(status_of(e.wrote), 200);
  assert_eq(e.closes, 1);
  assert_eq(e.sent, 1)
}

// Pipelining is answered in order by construction: one connection, one task, and the leftover
// buffer carried into the next turn.
test "two pipelined requests are answered in order on one connection" {
  let e = served(get_line("/health").concat(get_line("/items")));
  assert_eq(e.sent, 2);
  assert_eq(e.closes, 1);
  assert(e.wrote.index_of(b"\"service\":\"parts\"") != None);
  assert(e.wrote.index_of(b"\"sku\":\"gasket\"") != None)
}

// A head split across three reads, one of the cuts falling inside the terminator.
test "a head whose terminator is split across two reads is still found" {
  let whole = get_line("/health");
  let cut = whole.len() - 2;
  let e = exchange(
    [whole.slice(0, 12), whole.slice(12, cut), whole.slice(cut, whole.len())],
    seed_shelf(),
    seed_orders(),
  );
  assert_eq(status_of(e.wrote), 200);
  assert_eq(e.sent, 1)
}

test "a posted order travels the whole connection and moves the store" {
  let body = "{\"customer\":\"hedy\",\"lines\":[{\"sku\":\"gasket\",\"qty\":2}]}";
  let e = served(
    Bytes::of_string(
      "POST /orders HTTP/1.1\r\nHost: service.example\r\nContent-Type: application/json\r\n"
        ++ "x-api-key: "
        ++ fake_key()
        ++ "\r\n"
        ++ "Content-Length: "
        ++ Bytes::of_string(body).len().to_string()
        ++ "\r\n\r\n"
        ++ body,
    ),
  );
  assert_eq(status_of(e.wrote), 201);
  assert_eq(
    item_named(e.shelf, "gasket"),
    Some({ sku: "gasket", name: "copper gasket", price: 2.25m, on_hand: 10 }),
  );
  assert_eq(e.book.len(), 3)
}

// The streamed route over the socket: the response is chunked, and the bytes between the chunk
// sizes are exactly what the buffered path would have sent.
test "a receipt is written as chunks and ends with the terminating chunk" {
  let e = served(get_line("/orders/1/receipt"));
  assert_eq(status_of(e.wrote), 200);
  assert(e.wrote.index_of(b"Transfer-Encoding: chunked\r\n") != None);
  assert(e.wrote.index_of(b"Content-Length") == None);
  assert(e.wrote.ends_with(b"0\r\n\r\n"));
  // The chunk sizes are the only thing between the streamed bytes and the buffered ones, which is
  // what the test at the foot of the file says.
  assert(e.wrote.index_of(b"receipt for order 1\ncustomer: ada\n") != None);
  assert(e.wrote.index_of(b"total: 4.00\n") != None)
}

// A HEAD is routed as the GET it mirrors, and `encode` is what drops the body: the `Content-Length`
// is the one a GET would have produced, and not a byte of body follows the head.
test "HEAD is answered like GET with the length it would have had and no body" {
  let head = served(Bytes::of_string("HEAD /items HTTP/1.1\r\nHost: d\r\n\r\n"));
  let get = served(get_line("/items"));
  // Byte for byte the GET's head — the same status, the same fields and the same `Content-Length` —
  // and then nothing at all.
  assert_eq(head.wrote, get.wrote.slice(0, head_end(get.wrote)));
  assert_eq(status_of(head.wrote), 200);
  assert(
    head.wrote.index_of(
        Bytes::of_string(
          "Content-Length: " ++ Int::to_string(get.wrote.len() - head_end(get.wrote)),
        ),
      )
      != None,
  );

  let receipt = served(Bytes::of_string("HEAD /orders/1/receipt HTTP/1.1\r\nHost: d\r\n\r\n"));
  assert_eq(status_of(receipt.wrote), 200);
  assert(receipt.wrote.index_of(b"Transfer-Encoding") == None);
  assert(receipt.wrote.ends_with(b"\r\n\r\n"))
}

// `OPTIONS *` asks about the server rather than about a path, so it is not routed at all — and its
// `Allow` is read off the table, so a route added below changes this answer without anybody editing
// it.
test "OPTIONS * answers the methods the table declares anywhere" {
  let e = served(b"OPTIONS * HTTP/1.1\r\nHost: d\r\n\r\n");
  assert_eq(status_of(e.wrote), 204);
  assert(e.wrote.index_of(b"allow: DELETE, GET, POST\r\n") != None)
}

test "a peer that opens a connection and says nothing is closed without a response" {
  let e = exchange([], seed_shelf(), seed_orders());
  assert_eq(e.wrote, b"");
  assert_eq(e.closes, 1)
}

// --- The service as its settings describe it ----------------------------------------------

/// One connection's worth of the service `listening` runs, over sockets that are values: what it
/// wrote, how many responses that was, and what it said on stdout.
fn over_socket(
  inbox: List<Bytes>,
  s: Settings,
) -> { wrote: Bytes, sent: Int, said: List<String> } / {sim.read, abort.raise} = {
  let ran = under(stock(), ||
    handle {
      // A task per connection needs a scheduler; the sequential loop spawns nothing under it.
      simulate { assert_eq(listening(s), 1) }
    } with {
      var queue = inbox,
      var sent = [],
      var said = [],
      net.listen[listener](port) -> 1,
      net.listen_tls[listener](port, credential) -> {
        assert_eq(credential, "service");
        1
      },
      net.local_port[listener](l) -> Some(40123),
      net.accept[listener](l) -> 7,
      net.close[listener](l) -> (),
      net.recv[conn](c, max, timeout_ms) -> {
        let queued = queue;
        queue = rest_of(queued);
        Some(first_of(queued))
      },
      net.send[conn](c, payload, timeout_ms) -> {
        sent = sent.push(payload);
        Some(payload.len())
      },
      net.close[conn](c) -> (),
      process.out[proc](line) -> {
        said = said.push(line);
      },
      return u -> { sent: sent, said: said },
    });
  {
    wrote: Bytes::concat_all(ran.out.sent),
    sent: ran.out.sent.filter(|p: Bytes| p.starts_with(b"HTTP/1.1 ")).len(),
    said: ran.out.said,
  }
}

/// One connection, on whatever port is free.
fn one_connection(tls: Option<String>, accept: Accept) -> Settings =
  { port: 0, connections: 1, store: Memory, tls: tls, accept: accept }

test "the service answers the same bytes over a TLS listener as over a plain one" {
  let encrypted = over_socket([get_line("/items")], one_connection(Some("service"), Sequential));
  assert_eq(encrypted, over_socket([get_line("/items")], one_connection(None, Sequential)));
  assert_eq(status_of(encrypted.wrote), 200);
  assert(encrypted.wrote.index_of(b"\"sku\":\"gasket\"") != None)
}

test "a listener serves exactly the connections it was asked for" {
  let e = over_socket(
    [get_line("/health").concat(get_line("/orders"))],
    one_connection(None, Sequential),
  );
  assert_eq(status_of(e.wrote), 200);
  assert_eq(e.sent, 2)
}

// The line a harness reads to find a service it asked for port 0.
test "a service says on stdout which port it landed on" {
  assert_eq(over_socket([get_line("/health")], one_connection(None, Sequential)).said, [
    "listening on 40123",
  ])
}

test "a task per connection writes the bytes one connection at a time writes" {
  let spawned = over_socket(
    [get_line("/items").concat(get_line("/orders/1/receipt"))],
    one_connection(None, TaskPerConnection),
  );
  assert_eq(
    spawned,
    over_socket(
      [get_line("/items").concat(get_line("/orders/1/receipt"))],
      one_connection(None, Sequential),
    ),
  );
  assert_eq(spawned.sent, 2)
}

// The fake as `main` runs it when the settings name it: nothing granted but sockets and stdout.
test "the fake serves the service over TLS with a task per connection" {
  let sent = handle {
    fake(Some(Secret::of_string(fake_key())), ||
      simulate { assert_eq(listening(one_connection(Some("service"), TaskPerConnection)), 1) })
  } with {
    var queue = [get_line("/items")],
    var sent = [],
    net.listen[listener](port) -> panic("a service told a credential listens over TLS"),
    net.listen_tls[listener](port, credential) -> 1,
    net.local_port[listener](l) -> Some(40123),
    net.accept[listener](l) -> 7,
    net.close[listener](l) -> (),
    net.recv[conn](c, max, timeout_ms) -> {
      let queued = queue;
      queue = rest_of(queued);
      Some(first_of(queued))
    },
    net.send[conn](c, payload, timeout_ms) -> {
      sent = sent.push(payload);
      Some(payload.len())
    },
    net.close[conn](c) -> (),
    process.out[proc](line) -> (),
    return u -> sent,
  };
  assert_eq(status_of(Bytes::concat_all(sent)), 200);
  assert(Bytes::concat_all(sent).index_of(b"\"sku\":\"gasket\"") != None)
}

// The fake entry point, driven end to end with nothing granted but sockets.
test "run_memory serves the service with no database bound and no host at all" {
  let sent = handle {
    assert_eq(run_memory(8137, Some(Secret::of_string(fake_key())), 1), 1)
  } with {
    var queue = [get_line("/items").concat(get_line("/orders"))],
    var sent = [],
    net.listen[listener](port) -> 1,
    net.accept[listener](l) -> 7,
    net.close[listener](l) -> (),
    net.recv[conn](c, max, timeout_ms) -> {
      let queued = queue;
      queue = rest_of(queued);
      Some(first_of(queued))
    },
    net.send[conn](c, payload, timeout_ms) -> {
      sent = sent.push(payload);
      Some(payload.len())
    },
    net.close[conn](c) -> (),
    return u -> sent,
  };
  let wrote = Bytes::concat_all(sent);
  assert_eq(sent.filter(|p: Bytes| p.starts_with(b"HTTP/1.1 ")).len(), 2);
  assert(wrote.index_of(b"\"sku\":\"gasket\"") != None);
  assert(wrote.index_of(b"\"customer\":\"ada\"") != None)
}

// --- One case per protocol refusal ---------------------------------------------------

/// The status the peer was given — and, for every case below rather than for the ones a test author
/// remembered, three properties that make a refusal a refusal: exactly one response was written,
/// the connection was closed, and neither the shelf nor the order book moved.
fn rejected(raw: Bytes) -> Int / {abort.raise} = {
  let e = served(raw);
  assert_eq(e.sent, 1);
  assert_eq(e.closes, 1);
  assert_eq(e.shelf, seed_shelf());
  assert_eq(e.book, seed_orders());
  status_of(e.wrote)
}

test "Content-Length and Transfer-Encoding together are refused and nothing is read" {
  let e = served(
    b"POST /orders HTTP/1.1\r\nHost: d\r\nContent-Length: 5\r\nTransfer-Encoding: chunked\r\n\r\nhello",
  );
  assert_eq(status_of(e.wrote), 400);
  assert_eq(e.closes, 1);
  assert_eq(e.sent, 1);
  assert_eq(e.book, seed_orders())
}

test "two Content-Length lines are refused even when they agree" {
  assert_eq(
    rejected(
      b"POST /orders HTTP/1.1\r\nHost: d\r\nContent-Length: 5\r\nContent-Length: 5\r\n\r\nhello",
    ),
    400,
  );
  assert_eq(rejected(b"POST /orders HTTP/1.1\r\nHost: d\r\nContent-Length: 5, 5\r\n\r\nhello"), 400)
}

test "a Content-Length that is not one or more ASCII digits is refused" {
  assert_eq(rejected(b"POST /orders HTTP/1.1\r\nHost: d\r\nContent-Length: +5\r\n\r\nhello"), 400);
  assert_eq(rejected(b"POST /orders HTTP/1.1\r\nHost: d\r\nContent-Length:  5x\r\n\r\nhello"), 400);
  assert_eq(rejected(b"POST /orders HTTP/1.1\r\nHost: d\r\nContent-Length: 0x5\r\n\r\nhello"), 400)
}

test "a Content-Length past this service's max_body is refused before a body byte" {
  assert_eq(rejected(b"POST /orders HTTP/1.1\r\nHost: d\r\nContent-Length: 99999999\r\n\r\n"), 413)
}

test "a transfer coding that is not chunked, and one that is not last, are refused" {
  assert_eq(rejected(b"POST /orders HTTP/1.1\r\nHost: d\r\nTransfer-Encoding: gzip\r\n\r\n"), 501);
  assert_eq(
    rejected(b"POST /orders HTTP/1.1\r\nHost: d\r\nTransfer-Encoding: chunked, gzip\r\n\r\n"),
    400,
  )
}

test "a bare LF terminator, an obs-fold and a space before a colon are each refused" {
  assert_eq(rejected(b"GET /health HTTP/1.1\nHost: d\r\n\r\n"), 400);
  assert_eq(rejected(b"GET /health HTTP/1.1\r\nHost: d\r\n obsolete\r\n\r\n"), 400);
  assert_eq(rejected(b"GET /health HTTP/1.1\r\nHost : d\r\n\r\n"), 400)
}

test "HTTP/1.1 with no Host, and with two, are each refused" {
  assert_eq(rejected(b"GET /health HTTP/1.1\r\n\r\n"), 400);
  assert_eq(rejected(b"GET /health HTTP/1.1\r\nHost: a\r\nHost: b\r\n\r\n"), 400)
}

test "a version that is not 1.0 or 1.1 is 505, and no version at all is 400" {
  assert_eq(rejected(b"GET /health HTTP/2.0\r\nHost: d\r\n\r\n"), 505);
  assert_eq(rejected(b"GET /health\r\nHost: d\r\n\r\n"), 400)
}

test "an authority-form target and a lone asterisk under GET are each refused" {
  assert_eq(rejected(b"GET service.example:80 HTTP/1.1\r\nHost: d\r\n\r\n"), 400);
  assert_eq(rejected(b"GET * HTTP/1.1\r\nHost: d\r\n\r\n"), 400)
}

test "a chunk size that is empty, not hex, or unterminated is refused" {
  assert_eq(
    rejected(
      b"POST /orders HTTP/1.1\r\nHost: d\r\nTransfer-Encoding: chunked\r\n\r\n".concat(
        b"\r\nhello\r\n0\r\n\r\n",
      ),
    ),
    400,
  );
  assert_eq(
    rejected(
      b"POST /orders HTTP/1.1\r\nHost: d\r\nTransfer-Encoding: chunked\r\n\r\n".concat(
        b"zz\r\nhello\r\n0\r\n\r\n",
      ),
    ),
    400,
  );
  assert_eq(
    rejected(
      b"POST /orders HTTP/1.1\r\nHost: d\r\nTransfer-Encoding: chunked\r\n\r\n".concat(
        b"5\r\nhelloXX0\r\n\r\n",
      ),
    ),
    400,
  )
}

// A trailer named `content-length` changes no framing decision and a trailer named `authorization`
// never appears among the headers.
test "trailers arrive in their own field and are never merged into the headers" {
  let e = served(
    Bytes::of_string(
      "POST /orders HTTP/1.1\r\nHost: d\r\nx-api-key: " ++ fake_key()
        ++ "\r\nTransfer-Encoding: chunked\r\n\r\n",
    ).concat(
      b"2\r\n{}\r\n0\r\nContent-Length: 0\r\nAuthorization: root\r\n\r\n",
    ),
  );
  // The body was framed by the chunks and not by the trailer, so the service saw `{}` and refused
  // it as a `Placement` rather than as a framing error.
  assert_eq(status_of(e.wrote), 400);
  assert_eq(e.closes, 1)
}

test "a request line longer than this service will hold is 414" {
  assert_eq(rejected(b"GET /".concat(filler(9000)).concat(b" HTTP/1.1\r\nHost: d\r\n\r\n")), 414)
}

test "more header bytes than this service will hold is 431" {
  assert_eq(
    rejected(b"GET /health HTTP/1.1\r\nHost: d\r\nX: ".concat(filler(20000)).concat(b"\r\n\r\n")),
    431,
  )
}

fn filler(n: Int) -> Bytes =
  Bytes::concat_all(range(0, (n + 31) / 32).map(|_i: Int| b"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"))

// --- Laws the route table being data makes possible -------------------------------------

/// A route the matcher cannot reach is a line of documentation for something the service does not
/// do.
fn sample_segment(s: router::Segment) -> String =
  match s {
    router::Literal(text) -> text,
    router::Param(name) -> ":" ++ name,
    router::Rest(name) -> ":" ++ name,
    // A typed binder only matches a segment that parses, so the sample has to parse; no literal in
    // the table is one of these three words.
    router::Typed(binding) -> sample_of_kind(binding.kind),
  }

fn sample_of_kind(kind: router::ParamType) -> String =
  match kind { router::IntParam -> "7", router::DecimalParam -> "7.5", router::BoolParam -> "true" }

fn sample_path(path: List<router::Segment>) -> String =
  path.fold("", |acc: String, s: router::Segment| acc ++ "/" ++ sample_segment(s))

fn sample_params(path: List<router::Segment>) -> Map<String, String> =
  path.fold(Map::new(), |acc: Map<String, String>, s: router::Segment|
    match s {
      router::Literal(_) -> acc,
      router::Param(name) -> acc.insert(name, ":" ++ name),
      router::Rest(name) -> acc.insert(name, ":" ++ name),
      router::Typed(binding) -> acc.insert(binding.name, sample_of_kind(binding.kind)),
    })

fn route_for(t: List<router::Route<Endpoint>>, e: Endpoint) -> Option<router::Route<Endpoint>> =
  t.fold(None, |found: Option<router::Route<Endpoint>>, r: router::Route<Endpoint>|
    if r.endpoint == e { Some(r) } else { found })

pub fn reachable(e: Endpoint) -> Bool / {abort.raise} =
  match route_for(table(), e) {
    None -> false,
    Some(r) ->
      router::route(table(), r.method, sample_path(r.path))
        == router::Found({ endpoint: e, params: sample_params(r.path) }),
  }

law "every endpoint the service can dispatch is reachable through the table"
  forall (e: Endpoint) {
    reachable(e)
  }

// The property a framework enforces with a macro is here a value a law asserts.
law "no two routes overlap ambiguously, and every pattern is well formed" {
  conflicts_and_internal_errors() == 0
}

pub fn conflicts_and_internal_errors() -> Int / {abort.raise} =
  router::conflicts(table()).len() + router::well_formed(table()).len()

fn drawn_lines() -> Gen<List<Line>> =
  gen::list_of(
    gen::map2(
      gen::elements(["bolt", "gasket", "widget", "sprocket"]),
      gen::int_between(-5, 60),
      |sku: String, qty: Int| { sku: sku, qty: qty },
    ),
    5,
  )

fn drawn_orders() -> Gen<Order> =
  gen::map2(
    gen::map4(
      gen::any_int(),
      gen::text(),
      drawn_lines(),
      gen::decimal(),
      |id: Int, customer: String, lines: List<Line>, total: Decimal|
        { id: id, customer: customer, lines: lines, total: total, state: Open },
    ),
    gen::elements([Open, Cancelled]),
    |o: Order, state: State| { ..o, state: state },
  )

// What a streaming encoder has to earn and almost never states: the bytes pulled out of the cursor
// are the bytes a buffered body would have held.
test "a streamed receipt is byte-for-byte what a buffered one would have been" {
  gen::check(drawn_orders(), |o: Order| drained(cursor_for(o, seed_shelf())) == buffered_receipt(o))
}

pub fn buffered_receipt(o: Order) -> Bytes =
  Bytes::concat_all(
    [opening_line(o)].push(
      Bytes::concat_all(o.lines.map(|l: Line| item_line(seed_shelf(), l))),
    ).push(
      closing_line(o),
    ),
  )

// Drawing a shelf down and putting the same lines back is the identity, which is what makes a
// cancellation safe to answer twice — the second one is refused by `state`, and this says the first
// one moved exactly what it should have.
test "a drawdown is undone exactly by putting the same lines back" {
  gen::check(drawn_lines(), |lines: List<Line>|
    put_back(draw_down(seed_shelf(), lines), lines) == seed_shelf())
}

// --- What the store being a value makes checkable ----------------------------------------

pub type Pick = | Bolt | Gasket | Widget

pub type Amount = | One | Couple | Handful | Crate

pub type Want = { pick: Pick, amount: Amount }

fn sku_of(p: Pick) -> String = match p { Bolt -> "bolt", Gasket -> "gasket", Widget -> "widget" }

/// `Crate` is 40, which the gasket shelf cannot cover and the bolt shelf can, so a drawn order
/// lands on both sides of the refusal rather than on one.
fn qty_of(a: Amount) -> Int = match a { One -> 1, Couple -> 2, Handful -> 5, Crate -> 40 }

pub fn lines_of(ws: List<Want>) -> List<Line> =
  ws.map(|w: Want| { sku: sku_of(w.pick), qty: qty_of(w.amount) })

fn wants() -> Gen<List<Want>> =
  gen::and_then(gen::int_between(1, 4), |n: Int|
    gen::list_of_length(
      gen::map2(
        gen::elements([Bolt, Gasket, Widget]),
        gen::elements([One, Couple, Handful, Crate]),
        |pick: Pick, amount: Amount| { pick: pick, amount: amount },
      ),
      n,
    ))

fn covered(ws: List<Want>) -> Bool = short_skus(seed_shelf(), lines_of(ws)).len() == 0

/// Through the whole route — the key check, the decode and the span — so the tests cover what a
/// client actually reaches rather than starting after it.
pub fn placed_over(ws: List<Want>) -> Ran<http::Response<| {}>> / {abort.raise} =
  under(stocked(seed_shelf(), []), ||
    app(
      authorized_request(
        http::Post,
        "/orders",
        json::encode_bytes({ customer: "ada", lines: lines_of(ws) }, placement_json()),
      ),
    ))

/// The claim a rollback is for.
pub fn rejected_without_trace(ws: List<Want>) -> Bool / {abort.raise} = {
  let r = placed_over(ws);
  r.out.status == 409 && r.shelf == seed_shelf() && r.book == []
    && trace::named(r.records, "placed") == []
    && trace::counter_total(r.records, "orders placed") == 0
}

test "a placement the shelf cannot cover leaves no row behind" {
  gen::check(wants(), |ws: List<Want>| covered(ws) || rejected_without_trace(ws))
}

/// And the other half, without which the first is satisfied by a service that refuses everything:
/// what a placement that succeeds does to the shelf is exactly `draw_down`, the pure function the
/// tests above check on its own.
pub fn committed_as_specified(ws: List<Want>) -> Bool / {abort.raise} = {
  let r = placed_over(ws);
  r.out.status == 201 && r.shelf == draw_down(seed_shelf(), lines_of(ws)) && r.book.len() == 1
}

test "a placement the shelf can cover moves the shelf by exactly the drawdown" {
  gen::check(wants(), |ws: List<Want>| !covered(ws) || committed_as_specified(ws))
}

/// The statement and the predicate it replaced, over every id.
pub fn one_order_agrees(id: Int) -> Bool / {abort.raise} = {
  let r = under(stock(), || app(request(http::Get, "/orders/" ++ id.to_string(), b"")));
  match order_by(seed_orders(), id) {
    Some(o) ->
      r.out.status == 200
        && json::decode_bytes(http::whole_bytes(r.out.body), order_json()) == Ok(o),
    None -> r.out.status == 404,
  }
}

test "the route that finds one order finds what `order_by` names" {
  gen::check(gen::one_of([gen::elements([1, 2]), gen::any_int()]), one_order_agrees)
}
