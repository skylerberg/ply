import std.cli
import std.cli (Arg, Bash, Codec, Fish, Flag, Outcome, Parsed, Positive, Failed, Rejected, Run,
                Shell, Spec, Text, Zsh)
import std.list
import std.process (process, FakeProcess, args_step, captured, err_step, exit_step, out_step)
import std.string
import std.unicode

type Voice = | Plain | Upper | Lower

type ShoutRequest = {
  words: List<String>,
  times: Int,
  voice: Voice,
  separator: String,
  marks: List<String>,
}

type Command = | Say(ShoutRequest) | Completions(Shell) | Manual(List<String>)

fn times() -> Arg<Int> =
  cli::arg(
    cli::with_setting(
      cli::with_short(
        cli::with_default(cli::valued("times", "N", Positive, "How many lines to say."), "1"),
        "n",
      ),
      "SHOUT_TIMES",
    ),
    cli::int(),
  )

fn between() -> Arg<String> =
  cli::arg(cli::valued("between", "TEXT", Text, "The text to put between two words."), cli::text())

fn mark() -> Arg<String> =
  cli::arg(
    cli::with_short(
      cli::repeated(cli::valued("mark", "TEXT", Text, "A mark to end each line with. Repeatable.")),
      "m",
    ),
    cli::text(),
  )

fn upper_flag() -> Flag = cli::with_short(cli::switch("upper", "Say it in capitals."), "u")

fn lower() -> Flag =
  cli::conflicting(cli::with_short(cli::switch("lower", "Say it in small letters."), "l"), [
    "upper",
  ])

fn shells() -> Codec<Shell> =
  cli::one_of([
    { name: "bash", value: Bash },
    { name: "zsh", value: Zsh },
    { name: "fish", value: Fish },
  ])

fn line() -> Spec = {
  let say = cli::with_positionals(
    cli::command("say", "Print the words on a line.", [
      times().flag,
      between().flag,
      mark().flag,
      upper_flag(),
      lower(),
    ]),
    [cli::many(cli::positional("WORDS", "What to say."))],
  );
  let completions = cli::with_positionals(
    cli::command("completions", "Print a script that completes this line in a shell.", []),
    [cli::positional("SHELL", "`bash`, `zsh` or `fish`.")],
  );
  let manual = cli::with_positionals(
    cli::command("manual", "Print a command's manual page.", []),
    [cli::many(cli::defaulted("COMMAND", "The command's words; none is the program's page.", ""))],
  );
  {
    bin: "shout",
    version: "0.1.0",
    root: cli::with_subs(cli::command("", "Say words, loudly or not.", []), [
      say,
      completions,
      manual,
    ]),
  }
}

fn command_from_parsed(p: Parsed) -> Result<Command, String> / {abort.raise} =
  match p.path.at_or(0, "") {
    "say" -> say_command_of(p),
    "completions" -> match shells().decode(p.positionals.at_or(0, "")) {
      Ok(shell) -> Ok(Completions(shell)),
      Err(reason) -> Err("`" ++ p.positionals.at_or(0, "") ++ "` is no shell: " ++ reason),
    },
    _ -> Ok(Manual(p.positionals)),
  }

fn say_command_of(p: Parsed) -> Result<Command, String> / {abort.raise} = {
  let times = cli::required(p, times())?;
  Ok(
    Say({
      words: p.positionals,
      times: times,
      voice: if cli::has(p, "upper") { Upper }
      else if cli::has(p, "lower") { Lower }
      else { Plain },
      separator: cli::get_or(p, between(), " "),
      marks: cli::all(p, mark()),
    }),
  )
}

fn parse_command(
  argv: List<String>,
  settings: List<{ key: String, value: String }>,
) -> Outcome<Command> / {abort.raise} = cli::parse_with(line(), argv, command_from_parsed, settings)

fn spoken(s: ShoutRequest) -> List<String> = {
  let joined_words = String::join(s.words, s.separator) ++ String::join(s.marks, "");
  let voiced = match s.voice {
    Plain -> joined_words,
    Upper -> unicode::uppercase(joined_words),
    Lower -> unicode::lowercase(joined_words),
  };
  range(0, s.times).map(|_: Int| voiced)
}

fn result(a: Command) -> List<String> / {abort.raise} =
  match a {
    Say(s) -> spoken(s),
    Completions(shell) -> [cli::completion(line(), shell)],
    Manual(path) -> [cli::man_page(line(), path)],
  }

fn main() -> Unit / {process.args[proc], process.out[proc], process.err[proc], process.exit[proc], abort.raise} =
  match cli::reply(line(), parse_command(process.args[proc](), []), Some(80)) {
    Ok(a) -> {
      result(a).fold((), |_: Unit, output_line: String| process.out[proc](output_line));
      process.exit[proc](0)
    },
    Err(reply) -> {
      if reply.code == 0 { process.out[proc](reply.text) } else { process.err[proc](reply.text) };
      process.exit[proc](reply.code)
    },
  }

fn plainly(words: List<String>) -> ShoutRequest =
  { words: words, times: 1, voice: Plain, separator: " ", marks: [] }

type Line = { argv: List<String>, command: Command }

fn lines() -> List<Line> =
  [
    { argv: ["say", "hello", "world"], command: Say(plainly(["hello", "world"])) },
    {
      argv: ["say", "-un3", "hello", "--between=, ", "-m!", "--mark", "?"],
      command: Say({
        words: ["hello"],
        times: 3,
        voice: Upper,
        separator: ", ",
        marks: ["!", "?"],
      }),
    },
    {
      argv: ["say", "--lower", "--", "-HELLO-"],
      command: Say({ ..plainly(["-HELLO-"]), voice: Lower }),
    },
    { argv: ["completions", "fish"], command: Completions(Fish) },
    { argv: ["manual"], command: Manual([]) },
    { argv: ["manual", "say"], command: Manual(["say"]) },
  ]

test "shout {String::join(c.argv, " ")} asks for what it writes" for c: Line in lines() {
  assert_eq(parse_command(c.argv, []), Run(c.command))
}

test "`cli::faults` reports no errors in the command-line declaration" {
  assert_eq(cli::faults(line()), [])
}

test "a command line that breaks a rule fails with an error that names that rule" {
  assert_eq(
    parse_command(["say", "-ul", "hello"], []),
    Failed({ path: ["say"], reason: cli::Conflict("lower", "upper") }),
  );
  assert_eq(
    parse_command(["say", "--times", "0", "hello"], []),
    Failed({
      path: ["say"],
      reason: cli::InvalidValue("times", "0", "a number of 1 or more is required"),
    }),
  );
  assert_eq(
    parse_command(["say"], []),
    Failed({ path: ["say"], reason: cli::MissingPositionals(["WORDS"]) }),
  );
  assert_eq(
    parse_command(["completions", "tcsh"], []),
    Failed({
      path: ["completions"],
      reason: Rejected("`tcsh` is no shell: not one of bash, zsh, fish"),
    }),
  )
}

test "a flag omitted from the command line takes its value from the settings, and a given flag overrides it" {
  let settings = [{ key: "SHOUT_TIMES", value: "2" }];
  assert_eq(parse_command(["say", "hi"], settings), Run(Say({ ..plainly(["hi"]), times: 2 })));
  assert_eq(
    parse_command(["say", "hi", "-n4"], settings),
    Run(Say({ ..plainly(["hi"]), times: 4 })),
  )
}

test "`spoken` joins the words with the separator, appends the punctuation marks, converts the case for the voice and repeats that text `times` times" {
  assert_eq(spoken(plainly(["hello", "world"])), ["hello world"]);
  assert_eq(
    spoken({ words: ["a", "b"], times: 2, voice: Upper, separator: "-", marks: ["!", "?"] }),
    ["A-B!?", "A-B!?"],
  )
}

fn ran(argv: List<String>) -> FakeProcess / {abort.raise} =
  handle {
    main()
  } with {
    var io = captured(argv),
    process.args[proc]() -> args_step(io),
    process.out[proc](text) -> {
      io = out_step(io, text);
    },
    process.err[proc](text) -> {
      io = err_step(io, text);
    },
    process.exit[proc](code) resume k -> exit_step(io, code),
    return u -> io,
  }

test "the program prints the words to standard output, prints nothing to standard error and exits with code 0" {
  let run = ran(["say", "-n2", "hello", "world", "-m", "!"]);
  assert_eq(run.out, ["hello world!", "hello world!"]);
  assert_eq(run.err, []);
  assert_eq(run.code, Some(0))
}

test "help goes to the output stream and a rejection to the error stream, with exit 2" {
  let helped = ran(["say", "--help"]);
  assert_eq(helped.code, Some(0));
  assert_eq(helped.err, []);
  assert(helped.out.at_or(0, "").starts_with("Print the words on a line\n\nUsage: shout say"));
  let rejected = ran(["say", "--tmies", "2", "hi"]);
  assert_eq(rejected.code, Some(2));
  assert_eq(rejected.out, []);
  assert_eq(rejected.err, [
    "error: unexpected argument '--tmies' found\n\n  tip: a similar argument exists: '--times'\n\nUsage: shout say [OPTIONS] <WORDS>...\n\nFor more information, try '--help'.",
  ])
}

test "the program writes its own completion script and manual page" {
  let script = ran(["completions", "bash"]).out.at_or(0, "");
  assert(script.contains("complete -o default -F _shout shout"));
  let page = ran(["manual", "say"]).out.at_or(0, "");
  assert(page.starts_with(".TH \"SHOUT\\-SAY\" 1"))
}
