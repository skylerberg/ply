//! The agreement claim: for any generated operation sequence, `std.db`'s in-memory twin and postgres
//! produce the same answers.
import std.db
import std.sql
import std.db (db)

// --- The fixture ------------------------------------------------------------

pub fn fixture() -> sql::Schema = { tables: [part(), bin()] }

pub fn part() -> sql::Table =
  {
    name: "part",
    columns: [
      sql::column("sku", sql::TText, false),
      sql::column("price", sql::TNumeric(10, 4), false),
      sql::column("tag", sql::TText, true),
      sql::column("n", sql::TInt, true),
    ],
    primary_key: ["sku"],
    unique: [{ name: "part_tag_key", columns: ["tag"] }],
    foreign_keys: [],
    checks: [{ name: "part_price_check", expr: "price >= 0" }],
  }

/// `id` is supplied by the operation rather than defaulted from a sequence, and that is a decision
/// about the *claim* rather than about the schema.
pub fn bin() -> sql::Table =
  {
    name: "bin",
    columns: [
      sql::column("id", sql::TInt, false),
      sql::column("sku", sql::TText, true),
      sql::column("qty", sql::TInt, true),
    ],
    primary_key: ["id"],
    unique: [],
    foreign_keys: [
      { name: "bin_sku_fkey", columns: ["sku"], references: "part", refers_to: ["sku"] },
    ],
    checks: [{ name: "bin_qty_check", expr: "qty >= 0" }],
  }

// --- What is generated ------------------------------------------------------

pub type Op =
  | Insert(Values)
  | Update(UpdateOp)
  | Delete(DeleteOp)
  | Select(SelectOp)
  | Count(Which)
  | Begin(db::Isolation)
  | Commit
  | Abort

/// The fixture's two tables and every column of either, as constructors rather than as strings.
pub type Which = | Part | Bin

pub type Col = | CSku | CPrice | CTag | CN | CId | CQty

/// The four parameter shapes the fixture's columns take.
pub type Val = | VText(String) | VNum(Decimal) | VInt(Int) | VNull

/// A whole row of either table, in column order.
pub type Values =
  | PartVals(String, Decimal, Option<String>, Option<Int>)
  | BinVals(Int, Option<String>, Option<Int>)

pub type UpdateOp = { table: Which, column: Col, to: Val, where_col: Col, eq: Val }
pub type DeleteOp = { table: Which, where_col: Col, eq: Val }
pub type SelectOp = { table: Which, order_by: Col, limit: Int }

pub fn table_name(w: Which) -> String = match w { Part -> "part", Bin -> "bin" }

pub fn col_name(c: Col) -> String =
  match c { CSku -> "sku", CPrice -> "price", CTag -> "tag", CN -> "n", CId -> "id", CQty -> "qty" }

pub fn val_param(v: Val) -> sql::Param =
  match v {
    VText(s) -> sql::PText(s),
    VNum(d) -> sql::PNumeric(d),
    VInt(n) -> sql::PInt(n),
    VNull -> sql::PNull,
  }

fn opt_text(o: Option<String>) -> sql::Param =
  match o { None -> sql::PNull, Some(s) -> sql::PText(s) }

fn opt_int(o: Option<Int>) -> sql::Param = match o { None -> sql::PNull, Some(n) -> sql::PInt(n) }

pub fn values_table(v: Values) -> Which =
  match v { PartVals(_, _, _, _) -> Part, BinVals(_, _, _) -> Bin }

pub fn values_params(v: Values) -> List<sql::Param> =
  match v {
    PartVals(sku, price, tag, n) ->
      [sql::PText(sku), sql::PNumeric(price), opt_text(tag), opt_int(n)],
    BinVals(id, sku, qty) -> [sql::PInt(id), opt_text(sku), opt_int(qty)],
  }

pub fn op_table(op: Op) -> Which =
  match op {
    Insert(v) -> values_table(v),
    Update(o) -> o.table,
    Delete(o) -> o.table,
    Select(o) -> o.table,
    Count(w) -> w,
    Begin(_) -> Part,
    Commit -> Part,
    Abort -> Part,
  }

pub type Rendered = { stmt: sql::Stmt, params: List<sql::Param> }

/// One text, called once per op, handed to **both** sides unchanged.
pub fn render(fx: sql::Schema, op: Op) -> Rendered =
  match op {
    Insert(v) -> {
      let table = table_name(values_table(v));
      let params = values_params(v);
      {
        stmt: sql::stmt(
          "insert into " ++ table ++ " (" ++ commas(column_names(fx, table)) ++ ") values ("
            ++ commas(placeholders(len(params), 1))
            ++ ")",
        ),
        params: params,
      }
    },
    Update(o) ->
      {
        stmt: sql::stmt(
          "update " ++ table_name(o.table) ++ " set " ++ col_name(o.column) ++ " = $1 where "
            ++ col_name(o.where_col)
            ++ " = $2",
        ),
        params: [val_param(o.to), val_param(o.eq)],
      },
    Delete(o) ->
      {
        stmt: sql::stmt(
          "delete from " ++ table_name(o.table) ++ " where " ++ col_name(o.where_col) ++ " = $1",
        ),
        params: [val_param(o.eq)],
      },
    Select(o) ->
      {
        stmt: sql::stmt(
          "select " ++ commas(column_names(fx, table_name(o.table))) ++ " from "
            ++ table_name(o.table)
            ++ " order by "
            ++ order_clause(fx, o)
            ++ " limit "
            ++ int_to_string(o.limit),
        ),
        params: [],
      },
    Count(w) -> { stmt: sql::stmt("select count(*) from " ++ table_name(w)), params: [] },
    Begin(_) -> { stmt: sql::stmt(""), params: [] },
    Commit -> { stmt: sql::stmt(""), params: [] },
    Abort -> { stmt: sql::stmt(""), params: [] },
  }

/// The generated key, and the primary key after it.
fn order_clause(fx: sql::Schema, o: SelectOp) -> String =
  commas(concat_keys([col_name(o.order_by)], primary_key(fx, table_name(o.table))))

fn primary_key(fx: sql::Schema, name: String) -> List<String> =
  match find_table(fx.tables, name) { None -> [], Some(t) -> t.primary_key }

fn concat_keys(a: List<String>, b: List<String>) -> List<String> =
  fold(b, a, |acc: List<String>, x: String| push(acc, x))

fn column_names(fx: sql::Schema, name: String) -> List<String> =
  match find_table(fx.tables, name) {
    None -> [],
    Some(t) -> map(t.columns, |c: sql::Column| c.name),
  }

fn find_table(ts: List<sql::Table>, name: String) -> Option<sql::Table> =
  match ts { [] -> None, [h, ..t] -> if h.name == name { Some(h) } else { find_table(t, name) } }

fn placeholders(n: Int, from: Int) -> List<String> =
  if n <= 0 { [] } else { push(placeholders(n - 1, from), "$" ++ int_to_string(from + n - 1)) }

type Joined = { started: Bool, out: String }

fn commas(xs: List<String>) -> String =
  fold(xs, { started: false, out: "" }, |acc: Joined, x: String|
    if acc.started { { started: true, out: acc.out ++ ", " ++ x } }
    else { { started: true, out: x } }).out

// --- The domain -------------------------------------------------------------

pub fn well_formed(fx: sql::Schema, ops: List<Op>) -> Bool =
  balanced(ops, 0) && fold(ops, true, |acc: Bool, o: Op| acc && typed(fx, o))

fn balanced(ops: List<Op>, depth: Int) -> Bool =
  match ops {
    [] -> depth == 0,
    [h, ..t] -> match h {
      Begin(_) -> depth < db::max_savepoints() && balanced(t, depth + 1),
      Commit -> depth > 0 && balanced(t, depth - 1),
      Abort -> depth > 0 && balanced(t, depth - 1),
      _ -> balanced(t, depth),
    },
  }

/// What the *type* cannot say: that a column belongs to the table the same operation names, and that
/// a value fits the column it is compared or assigned to.
fn typed(fx: sql::Schema, op: Op) -> Bool =
  match op {
    Insert(_) -> true,
    Update(o) ->
      fits_column(fx, o.table, o.column, o.to) && fits_column(fx, o.table, o.where_col, o.eq),
    Delete(o) -> fits_column(fx, o.table, o.where_col, o.eq),
    // A generated `ORDER BY` may name any column of the table, because `render` appends the primary
    // key.
    Select(o) ->
      has_column(fx, o.table, o.order_by) && o.limit >= 0
        && len(primary_key(fx, table_name(o.table))) > 0,
    Count(_) -> true,
    Begin(_) -> true,
    Commit -> true,
    Abort -> true,
  }

fn fits_column(fx: sql::Schema, table: Which, column: Col, v: Val) -> Bool =
  match find_table(fx.tables, table_name(table)) {
    None -> false,
    Some(t) -> match find_column(t.columns, col_name(column)) {
      None -> false,
      Some(c) -> param_fits(c, val_param(v)),
    },
  }

fn has_column(fx: sql::Schema, table: Which, column: Col) -> Bool =
  match find_table(fx.tables, table_name(table)) {
    None -> false,
    Some(t) -> match find_column(t.columns, col_name(column)) { None -> false, Some(_) -> true },
  }

fn find_column(cs: List<sql::Column>, n: String) -> Option<sql::Column> =
  match cs { [] -> None, [h, ..t] -> if h.name == n { Some(h) } else { find_column(t, n) } }

/// A `NULL` fits any column: whether it is refused is the not-null constraint's business and the
/// claim very much does have an opinion about that.
fn param_fits(c: sql::Column, v: sql::Param) -> Bool =
  match v {
    sql::PNull -> true,
    sql::PInt(_) -> match c.ty { sql::TInt -> true, sql::TNumeric(_, _) -> true, _ -> false },
    sql::PNumeric(_) -> match c.ty { sql::TNumeric(_, _) -> true, _ -> false },
    sql::PText(_) -> match c.ty { sql::TText -> true, _ -> false },
    sql::PBool(_) -> match c.ty { sql::TBool -> true, _ -> false },
    sql::PFloat(_) -> match c.ty { sql::TFloat -> true, _ -> false },
    sql::PBytes(_) -> match c.ty { sql::TBytes -> true, _ -> false },
    sql::PJson(_) -> match c.ty { sql::TJson -> true, _ -> false },
    sql::PArray(_) -> match c.ty { sql::TArray(_) -> true, _ -> false },
  }

// --- The two sides ----------------------------------------------------------

type Replay = { db: db::MemDb, out: List<sql::Answer> }

pub fn replay_memory(fx: sql::Schema, ops: List<Op>) -> List<sql::Answer> / {abort.raise} =
  fold(ops, { db: db::open(fx), out: [] }, |acc: Replay, o: Op| memory_step(fx, acc, o)).out

fn memory_step(fx: sql::Schema, acc: Replay, op: Op) -> Replay / {abort.raise} =
  match op {
    Begin(level) -> {
      let r = db::begin_step(acc.db, level, db::ReadWrite);
      { db: r.db, out: push(acc.out, r.out) }
    },
    Commit -> {
      let r = db::commit_step(acc.db);
      { db: r.db, out: push(acc.out, r.out) }
    },
    Abort -> {
      let r = db::abort_step(acc.db);
      { db: r.db, out: push(acc.out, r.out) }
    },
    _ -> {
      let rendered = render(fx, op);
      let r = db::step(acc.db, rendered.stmt, rendered.params);
      { db: r.db, out: push(acc.out, r.out) }
    },
  }

/// The other side of the claim.
pub fn replay_live(
  ops: List<Op>,
) -> List<sql::Answer> / {db.write, db.read[part], db.write[part], db.read[bin], db.write[bin]} = {
  reset_live();
  fold(ops, [], |acc: List<sql::Answer>, o: Op| push(acc, live_step(o)))
}

/// The live side starts where `db::open(fixture())` starts, and it has to be said out loud because
/// the database design does not say it: `replay_memory` builds a fresh `MemDb` per case and postgres does
/// not forget between them, so without this the law is refuted at the second case by rows the first
/// one committed — a divergence that is an artefact of the harness rather than a defect in either
/// side.
fn reset_live() -> Unit / {db.write[part], db.write[bin]} = {
  db.execute[bin](sql::stmt("delete from bin"), []);
  db.execute[part](sql::stmt("delete from part"), []);
  ()
}

fn live_step(
  op: Op,
) -> sql::Answer / {db.write, db.read[part], db.write[part], db.read[bin], db.write[bin]} =
  match op {
    Begin(level) -> db.begin(level, db::ReadWrite),
    Commit -> db.commit(),
    Abort -> db.abort(),
    Insert(v) -> live_write(values_table(v), render(fixture(), op)),
    Update(o) -> live_write(o.table, render(fixture(), op)),
    Delete(o) -> live_write(o.table, render(fixture(), op)),
    Select(o) -> live_read(o.table, render(fixture(), op)),
    Count(w) -> live_read(w, render(fixture(), op)),
  }

fn live_write(table: Which, r: Rendered) -> sql::Answer / {db.write[part], db.write[bin]} =
  match table {
    Part -> db.execute[part](r.stmt, r.params),
    Bin -> db.execute[bin](r.stmt, r.params),
  }

fn live_read(table: Which, r: Rendered) -> sql::Answer / {db.read[part], db.read[bin]} =
  match table { Part -> db.query[part](r.stmt, r.params), Bin -> db.query[bin](r.stmt, r.params) }

// --- The comparison ---------------------------------------------------------

pub fn agree(memory: List<sql::Answer>, live: List<sql::Answer>) -> Bool =
  match first_difference(memory, live, 0) { None -> true, Some(_) -> false }

/// The index of the first difference, because a divergence at op 3 makes ops 4..n meaningless and a
/// counterexample that reported all of them would bury the one that matters.
pub fn first_difference(
  memory: List<sql::Answer>,
  live: List<sql::Answer>,
  at: Int,
) -> Option<Int> =
  match memory {
    [] -> match live { [] -> None, _ -> Some(at) },
    [m, ..mt] -> match live {
      [] -> Some(at),
      [l, ..lt] -> if answers_agree(m, l) { first_difference(mt, lt, at + 1) } else { Some(at) },
    },
  }

pub fn answers_agree(a: sql::Answer, b: sql::Answer) -> Bool =
  match a {
    sql::Count(x) -> match b { sql::Count(y) -> x == y, _ -> false },
    sql::Failed(x) -> match b {
      sql::Failed(y) -> x.code == y.code && x.constraint == y.constraint,
      _ -> false,
    },
    sql::Rows(xs) -> match b { sql::Rows(ys) -> rows_agree(xs, ys), _ -> false },
  }

fn rows_agree(xs: List<sql::Row>, ys: List<sql::Row>) -> Bool =
  match xs {
    [] -> match ys { [] -> true, _ -> false },
    [x, ..xt] -> match ys { [] -> false, [y, ..yt] -> row_agrees(x, y) && rows_agree(xt, yt) },
  }

type Entry = { key: String, value: sql::Datum }

fn row_agrees(x: sql::Row, y: sql::Row) -> Bool =
  map_len(x) == map_len(y)
    && fold(map_entries(x), true, |acc: Bool, e: Entry|
      acc && (match map_get(y, e.key) { None -> false, Some(v) -> datum_agrees(e.value, v) }))

fn datum_agrees(a: sql::Datum, b: sql::Datum) -> Bool =
  match a {
    sql::CNumeric(x) -> match b {
      sql::CNumeric(y) -> decimal_to_string(x) == decimal_to_string(y),
      _ -> false,
    },
    _ -> a == b,
  }

// --- The claim --------------------------------------------------------------
law/host "the memory engine agrees with postgres"
  forall (ops: List<Op>) where well_formed(fixture(), ops) {
    agree(replay_memory(fixture(), ops), replay_live(ops))
  }

// --- What the hermetic run can claim ----------------------------------------

law "a replay answers exactly once per operation"
  forall (ops: List<Op>) where well_formed(fixture(), ops) {
    len(replay_memory(fixture(), ops)) == len(ops)
  }

law "a replay is a function of its operations"
  forall (ops: List<Op>) where well_formed(fixture(), ops) {
    agree(replay_memory(fixture(), ops), replay_memory(fixture(), ops))
  }

law "agreement is reflexive, which is the weakest thing that must hold"
  forall (ops: List<Op>) where well_formed(fixture(), ops) {
    match first_difference(replay_memory(fixture(), ops), replay_memory(fixture(), ops), 0) {
      None -> true,
      Some(_) -> false,
    }
  }

// --- Recorded transcripts ---------------------------------------------------

pub fn collation_ops() -> List<Op> =
  [
    Insert(PartVals("B", 1m, None, None)),
    Insert(PartVals("a", 1m, None, None)),
    Select({ table: Part, order_by: CSku, limit: 10 }),
  ]

pub fn aborted_ops() -> List<Op> =
  [
    Begin(db::ReadCommitted),
    Insert(PartVals("a", 1m, None, None)),
    Insert(PartVals("a", 2m, None, None)),
    Count(Part),
    Commit,
    Count(Part),
  ]

fn row4(sku: String, price: Decimal) -> sql::Row =
  map_of_entries([
    { key: "sku", value: sql::CText(sku) },
    { key: "price", value: sql::CNumeric(price) },
    { key: "tag", value: sql::CNull },
    { key: "n", value: sql::CNull },
  ])

fn counted(n: Int) -> sql::Answer =
  sql::Rows([map_of_entries([{ key: "count", value: sql::CInt(n) }])])

/// Under `C` collation `"B"` sorts before `"a"`, because `B` is 0x42 and `a` is 0x61.
pub fn collation_transcript() -> List<sql::Answer> =
  [sql::Count(1), sql::Count(1), sql::Rows([row4("B", 1.0000m), row4("a", 1.0000m)])]

pub fn aborted_transcript() -> List<sql::Answer> =
  [
    sql::Count(0),
    sql::Count(1),
    sql::Failed({ code: "23505", constraint: "part_pkey", detail: "" }),
    sql::Failed({ code: "25P02", constraint: "", detail: "" }),
    // The `COMMIT`.
    sql::Failed({ code: "25P02", constraint: "", detail: "" }),
    counted(0),
  ]

// --- Tests ------------------------------------------------------------------

test "render puts one statement and its parameters on both sides" {
  let r = render(fixture(), Insert(PartVals("a", 1m, None, None)));
  assert_eq(r.stmt.sql, "insert into part (sku, price, tag, n) values ($1, $2, $3, $4)");
  assert_eq(len(r.params), 4);
  assert_eq(
    render(fixture(), Select({ table: Part, order_by: CSku, limit: 3 })).stmt.sql,
    "select sku, price, tag, n from part order by sku, sku limit 3",
  );
  assert_eq(render(fixture(), Count(Bin)).stmt.sql, "select count(*) from bin");
  assert_eq(
    render(
      fixture(),
      Update({ table: Part, column: CN, to: VInt(1), where_col: CSku, eq: VText("a") }),
    ).stmt.sql,
    "update part set n = $1 where sku = $2",
  );
  assert_eq(
    render(fixture(), Delete({ table: Part, where_col: CSku, eq: VText("a") })).stmt.sql,
    "delete from part where sku = $1",
  )
}

// The property the positional comparison rests on: every generated `ORDER BY` ends with the table's
// primary key, so no generated order has a tie and neither side is free to choose between equal
// rows.
test "every generated select orders by a key with no ties" {
  assert_eq(
    render(fixture(), Select({ table: Part, order_by: CN, limit: 1 })).stmt.sql,
    "select sku, price, tag, n from part order by n, sku limit 1",
  );
  assert_eq(
    render(fixture(), Select({ table: Bin, order_by: CQty, limit: 4 })).stmt.sql,
    "select id, sku, qty from bin order by qty, id limit 4",
  );
  // And a `Select` over a table with no primary key is outside the domain rather than compared on
  // an order neither side promises.
  assert(!well_formed({ tables: [keyless()] }, [Select({ table: Part, order_by: CSku, limit: 1 })]))
}

/// The fixture's `part`, stripped of its key.
fn keyless() -> sql::Table =
  {
    name: "part",
    columns: [sql::column("sku", sql::TText, true)],
    primary_key: [],
    unique: [],
    foreign_keys: [],
    checks: [],
  }

test "well_formed rejects what the claim has no opinion about" {
  assert(well_formed(fixture(), collation_ops()));
  assert(well_formed(fixture(), aborted_ops()));
  // an unbalanced scope stack
  assert(!well_formed(fixture(), [Commit]));
  assert(!well_formed(fixture(), [Begin(db::ReadCommitted)]));
  assert(!well_formed(fixture(), [Begin(db::ReadCommitted), Commit, Abort]));
  // a nesting deeper than the driver's savepoint bound
  assert(!well_formed(fixture(), deep(db::max_savepoints() + 1)));
  // a value whose type does not match the column it is assigned to
  assert(
    !well_formed(fixture(), [
      Update({ table: Part, column: CN, to: VText("x"), where_col: CSku, eq: VText("a") }),
    ]),
  );
  // a column of the *other* table, which is the one thing the type cannot say
  assert(!well_formed(fixture(), [Select({ table: Part, order_by: CQty, limit: 1 })]));
  assert(!well_formed(fixture(), [Delete({ table: Bin, where_col: CPrice, eq: VNum(1m) })]));
  assert(!well_formed(fixture(), [Select({ table: Part, order_by: CSku, limit: -1 })]));
  // and an `Insert` is well-typed by construction, which is the point of `Values` carrying the
  // table rather than naming it.
  assert(well_formed(fixture(), [Insert(BinVals(1, Some("a"), None))]))
}

fn deep(n: Int) -> List<Op> = if n <= 0 { [] } else { balanced_pair(deep(n - 1)) }

fn balanced_pair(inner: List<Op>) -> List<Op> =
  push(fold(inner, [Begin(db::ReadCommitted)], |acc: List<Op>, o: Op| push(acc, o)), Commit)

test "the twin reproduces a transcript recorded from postgres" {
  assert(agree(replay_memory(fixture(), collation_ops()), collation_transcript()));
  assert(agree(replay_memory(fixture(), aborted_ops()), aborted_transcript()))
}

// the database design: a claim that cannot fail is decoration.
test "a non-C collation is a refutation at the select and nowhere earlier" {
  let injected = [
    sql::Count(1),
    sql::Count(1),
    sql::Rows([row4("a", 1.0000m), row4("B", 1.0000m)]),
  ];
  assert(!agree(replay_memory(fixture(), collation_ops()), injected));
  assert_eq(first_difference(replay_memory(fixture(), collation_ops()), injected, 0), Some(2))
}

// The second injection: a twin without the failed-transaction state answers the `count` after a
// failed statement instead of `25P02`, which is the omission that makes a suite pass and production
// fail.
test "a missing failed-transaction state is a refutation at the count" {
  let injected = [
    sql::Count(0),
    sql::Count(1),
    sql::Failed({ code: "23505", constraint: "part_pkey", detail: "" }),
    counted(1),
    sql::Failed({ code: "25P02", constraint: "", detail: "" }),
    counted(0),
  ];
  assert(!agree(replay_memory(fixture(), aborted_ops()), injected));
  assert_eq(first_difference(replay_memory(fixture(), aborted_ops()), injected, 0), Some(3))
}

// `detail` is postgres's prose and nothing compares it.
test "a failure compares its code and its constraint and never its message" {
  let a = sql::Failed({ code: "23505", constraint: "part_pkey", detail: "Key (sku)=(a) exists." });
  let b = sql::Failed({ code: "23505", constraint: "part_pkey", detail: "" });
  let c = sql::Failed({ code: "23505", constraint: "part_tag_key", detail: "" });
  let d = sql::Failed({ code: "23514", constraint: "part_pkey", detail: "" });
  assert(answers_agree(a, b));
  assert(!answers_agree(a, c));
  assert(!answers_agree(a, d))
}

// Ply's `==` on `Decimal` is by value, so `1.00m == 1.0000m` — and a comparison that used it would
// accept the twin keeping a literal's scale where postgres returns the column's, which is the database design
// §6.3's own worked counterexample.
test "a numeric compares by its digits, because that is what its scale means" {
  assert(1.00m == 1.0000m);
  assert(
    !answers_agree(
      sql::Rows([map_of_entries([{ key: "p", value: sql::CNumeric(1.00m) }])]),
      sql::Rows([map_of_entries([{ key: "p", value: sql::CNumeric(1.0000m) }])]),
    ),
  );
  assert(
    answers_agree(
      sql::Rows([map_of_entries([{ key: "p", value: sql::CNumeric(1.0000m) }])]),
      sql::Rows([map_of_entries([{ key: "p", value: sql::CNumeric(1.0000m) }])]),
    ),
  )
}

// The domain the law is actually quantified over, which is the number the database design's argument
// turns on: "the agreement law passes" is a statement about the generator's reach and nothing else.
test "the domain the law quantifies over contains statements" {
  assert(well_formed(fixture(), [Insert(PartVals("a", 1m, Some("t"), Some(1)))]));
  assert(well_formed(fixture(), [Insert(BinVals(1, Some("a"), Some(2)))]));
  assert(
    well_formed(fixture(), [
      Update({ table: Part, column: CPrice, to: VNum(2m), where_col: CSku, eq: VText("a") }),
    ]),
  );
  assert(well_formed(fixture(), [Delete({ table: Bin, where_col: CId, eq: VInt(1) })]));
  assert(well_formed(fixture(), [Select({ table: Bin, order_by: CQty, limit: 3 })]));
  assert(well_formed(fixture(), [Count(Bin)]));
  // And every one of them renders to a statement the driver's scanner admits, which is the other
  // half of "both sides execute the rendered SQL".
  assert(
    string_contains(render(fixture(), Insert(BinVals(1, None, None))).stmt.sql, "insert into bin"),
  );
  assert(string_contains(render(fixture(), Count(Bin)).stmt.sql, "count(*) from bin"))
}

test "a difference in length is a difference at the shorter end" {
  assert_eq(first_difference([sql::Count(1)], [], 0), Some(0));
  assert_eq(first_difference([], [sql::Count(1)], 0), Some(0));
  assert_eq(first_difference([sql::Count(1)], [sql::Count(1), sql::Count(2)], 0), Some(1))
}
