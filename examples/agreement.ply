import std.db
import std.gen
import std.sql
import std.db (db)
import std.gen (Gen)

pub fn fixture() -> sql::Schema = { tables: [part(), bin()] }

pub fn part() -> sql::Table =
  {
    name: "part",
    columns: [
      sql::column("sku", sql::TText, false),
      sql::column("price", sql::TNumeric(10, 4), false),
      sql::column("tag", sql::TText, true),
      sql::column("n", sql::IntColumn, true),
    ],
    primary_key: ["sku"],
    unique: [{ name: "part_tag_key", columns: ["tag"] }],
    foreign_keys: [],
    checks: [{ name: "part_price_check", expression: "price >= 0" }],
  }

pub fn bin() -> sql::Table =
  {
    name: "bin",
    columns: [
      sql::column("id", sql::IntColumn, false),
      sql::column("sku", sql::TText, true),
      sql::column("qty", sql::IntColumn, true),
    ],
    primary_key: ["id"],
    unique: [],
    foreign_keys: [
      { name: "bin_sku_fkey", columns: ["sku"], references: "part", refers_to: ["sku"] },
    ],
    checks: [{ name: "bin_qty_check", expression: "qty >= 0" }],
  }

pub type Operation =
  | Insert(Values)
  | Update(UpdateOperation)
  | Delete(DeleteOperation)
  | Select(SelectOperation)
  | Count(Which)
  | Begin(db::Isolation)
  | Commit
  | Abort

pub type Which = | Part | Bin

pub type Col = | CSku | CPrice | CTag | CNumber | CId | CQty

pub type Value = | VText(String) | VNum(Decimal) | VInt(Int) | VNull

pub type Values =
  | PartValues(String, Decimal, Option<String>, Option<Int>)
  | BinValues(Int, Option<String>, Option<Int>)

pub type UpdateOperation = { table: Which, column: Col, to: Value, where_col: Col, eq: Value }
pub type DeleteOperation = { table: Which, where_col: Col, eq: Value }
pub type SelectOperation = { table: Which, order_by: Col, limit: Int }

pub fn table_name(w: Which) -> String = match w { Part -> "part", Bin -> "bin" }

pub fn col_name(c: Col) -> String =
  match c {
    CSku -> "sku",
    CPrice -> "price",
    CTag -> "tag",
    CNumber -> "n",
    CId -> "id",
    CQty -> "qty",
  }

pub fn value_parameter(v: Value) -> sql::Param =
  match v {
    VText(s) -> sql::TextParameter(s),
    VNum(d) -> sql::NumericParameter(d),
    VInt(n) -> sql::IntParameter(n),
    VNull -> sql::NullParameter,
  }

fn opt_text(o: Option<String>) -> sql::Param =
  match o { None -> sql::NullParameter, Some(s) -> sql::TextParameter(s) }

fn opt_int(o: Option<Int>) -> sql::Param =
  match o { None -> sql::NullParameter, Some(n) -> sql::IntParameter(n) }

pub fn values_table(v: Values) -> Which =
  match v { PartValues(_, _, _, _) -> Part, BinValues(_, _, _) -> Bin }

pub fn values_params(v: Values) -> List<sql::Param> =
  match v {
    PartValues(sku, price, tag, n) ->
      [sql::TextParameter(sku), sql::NumericParameter(price), opt_text(tag), opt_int(n)],
    BinValues(id, sku, qty) -> [sql::IntParameter(id), opt_text(sku), opt_int(qty)],
  }

pub fn operation_table(operation: Operation) -> Which =
  match operation {
    Insert(v) -> values_table(v),
    Update(o) -> o.table,
    Delete(o) -> o.table,
    Select(o) -> o.table,
    Count(w) -> w,
    Begin(_) -> Part,
    Commit -> Part,
    Abort -> Part,
  }

pub type Rendered = { statement: sql::Statement, params: List<sql::Param> }

pub fn render(fx: sql::Schema, operation: Operation) -> Rendered =
  match operation {
    Insert(v) -> {
      let table = table_name(values_table(v));
      let params = values_params(v);
      {
        statement: sql::statement_of(
          "insert into " ++ table ++ " (" ++ commas(column_names(fx, table)) ++ ") values ("
            ++ commas(placeholders(params.len(), 1))
            ++ ")",
        ),
        params: params,
      }
    },
    Update(o) ->
      {
        statement: sql::statement_of(
          "update " ++ table_name(o.table) ++ " set " ++ col_name(o.column) ++ " = $1 where "
            ++ col_name(o.where_col)
            ++ " = $2",
        ),
        params: [value_parameter(o.to), value_parameter(o.eq)],
      },
    Delete(o) ->
      {
        statement: sql::statement_of(
          "delete from " ++ table_name(o.table) ++ " where " ++ col_name(o.where_col) ++ " = $1",
        ),
        params: [value_parameter(o.eq)],
      },
    Select(o) ->
      {
        statement: sql::statement_of(
          "select " ++ commas(column_names(fx, table_name(o.table))) ++ " from "
            ++ table_name(o.table)
            ++ " order by "
            ++ order_clause(fx, o)
            ++ " limit "
            ++ o.limit.to_string(),
        ),
        params: [],
      },
    Count(w) ->
      { statement: sql::statement_of("select count(*) from " ++ table_name(w)), params: [] },
    Begin(_) -> { statement: sql::statement_of(""), params: [] },
    Commit -> { statement: sql::statement_of(""), params: [] },
    Abort -> { statement: sql::statement_of(""), params: [] },
  }

fn order_clause(fx: sql::Schema, o: SelectOperation) -> String =
  commas(concat_keys([col_name(o.order_by)], primary_key(fx, table_name(o.table))))

fn primary_key(fx: sql::Schema, name: String) -> List<String> =
  match find_table(fx.tables, name) { None -> [], Some(t) -> t.primary_key }

fn concat_keys(a: List<String>, b: List<String>) -> List<String> =
  b.fold(a, |accumulator: List<String>, x: String| accumulator.push(x))

fn column_names(fx: sql::Schema, name: String) -> List<String> =
  match find_table(fx.tables, name) {
    None -> [],
    Some(t) -> t.columns.map(|c: sql::Column| c.name),
  }

fn find_table(ts: List<sql::Table>, name: String) -> Option<sql::Table> =
  match ts { [] -> None, [h, ..t] -> if h.name == name { Some(h) } else { find_table(t, name) } }

fn placeholders(n: Int, from: Int) -> List<String> =
  if n <= 0 { [] } else { placeholders(n - 1, from).push("$" ++ Int::to_string(from + n - 1)) }

type Joined = { started: Bool, out: String }

fn commas(xs: List<String>) -> String =
  xs.fold({ started: false, out: "" }, |accumulator: Joined, x: String|
    if accumulator.started { { started: true, out: accumulator.out ++ ", " ++ x } }
    else { { started: true, out: x } }).out

pub fn well_formed(fx: sql::Schema, operations: List<Operation>) -> Bool =
  balanced(operations, 0)
    && operations.fold(true, |accumulator: Bool, o: Operation| accumulator && typed(fx, o))

fn balanced(operations: List<Operation>, depth: Int) -> Bool =
  match operations {
    [] -> depth == 0,
    [h, ..t] -> match h {
      Begin(_) -> depth < db::max_savepoints() && balanced(t, depth + 1),
      Commit -> depth > 0 && balanced(t, depth - 1),
      Abort -> depth > 0 && balanced(t, depth - 1),
      _ -> balanced(t, depth),
    },
  }

fn typed(fx: sql::Schema, operation: Operation) -> Bool =
  match operation {
    Insert(_) -> true,
    Update(o) ->
      fits_column(fx, o.table, o.column, o.to) && fits_column(fx, o.table, o.where_col, o.eq),
    Delete(o) -> fits_column(fx, o.table, o.where_col, o.eq),
    Select(o) ->
      has_column(fx, o.table, o.order_by) && o.limit >= 0
        && primary_key(fx, table_name(o.table)).len() > 0,
    Count(_) -> true,
    Begin(_) -> true,
    Commit -> true,
    Abort -> true,
  }

fn fits_column(fx: sql::Schema, table: Which, column: Col, v: Value) -> Bool =
  match find_table(fx.tables, table_name(table)) {
    None -> false,
    Some(t) -> match find_column(t.columns, col_name(column)) {
      None -> false,
      Some(c) -> param_fits(c, value_parameter(v)),
    },
  }

fn has_column(fx: sql::Schema, table: Which, column: Col) -> Bool =
  match find_table(fx.tables, table_name(table)) {
    None -> false,
    Some(t) -> match find_column(t.columns, col_name(column)) { None -> false, Some(_) -> true },
  }

fn find_column(cs: List<sql::Column>, n: String) -> Option<sql::Column> =
  match cs { [] -> None, [h, ..t] -> if h.name == n { Some(h) } else { find_column(t, n) } }

fn param_fits(c: sql::Column, v: sql::Param) -> Bool =
  match v {
    sql::NullParameter -> true,
    sql::IntParameter(_) -> match c.ty {
      sql::IntColumn -> true,
      sql::TNumeric(_, _) -> true,
      _ -> false,
    },
    sql::NumericParameter(_) -> match c.ty { sql::TNumeric(_, _) -> true, _ -> false },
    sql::TextParameter(_) -> match c.ty { sql::TText -> true, _ -> false },
    sql::BoolParameter(_) -> match c.ty { sql::BoolColumn -> true, _ -> false },
    sql::FloatParameter(_) -> match c.ty { sql::FloatColumn -> true, _ -> false },
    sql::BytesParameter(_) -> match c.ty { sql::BytesColumn -> true, _ -> false },
    sql::JsonParameter(_) -> match c.ty { sql::JsonColumn -> true, _ -> false },
    sql::ArrayParameter(_) -> match c.ty { sql::TArray(_) -> true, _ -> false },
  }

type Replay = { db: db::MemDb, out: List<sql::QueryResult> }

pub fn replay_memory(
  fx: sql::Schema,
  operations: List<Operation>,
) -> List<sql::QueryResult> / {abort.raise} =
  operations.fold({ db: db::open(fx), out: [] }, |accumulator: Replay, o: Operation|
    memory_step(fx, accumulator, o)).out

fn memory_step(
  fx: sql::Schema,
  accumulator: Replay,
  operation: Operation,
) -> Replay / {abort.raise} =
  match operation {
    Begin(level) -> {
      let r = db::begin_step(accumulator.db, level, db::ReadWrite);
      { db: r.db, out: accumulator.out.push(r.out) }
    },
    Commit -> {
      let r = db::commit_step(accumulator.db);
      { db: r.db, out: accumulator.out.push(r.out) }
    },
    Abort -> {
      let r = db::abort_step(accumulator.db);
      { db: r.db, out: accumulator.out.push(r.out) }
    },
    _ -> {
      let rendered = render(fx, operation);
      let r = db::step(accumulator.db, rendered.statement, rendered.params);
      { db: r.db, out: accumulator.out.push(r.out) }
    },
  }

pub fn replay_live(
  operations: List<Operation>,
) -> List<sql::QueryResult> / {db.write, db.read[part], db.write[part], db.read[bin], db.write[bin]} = {
  reset_live();
  operations.fold([], |accumulator: List<sql::QueryResult>, o: Operation|
    accumulator.push(live_step(o)))
}

fn reset_live() -> Unit / {db.write[part], db.write[bin]} = {
  db.execute[bin](sql::statement_of("delete from bin"), []);
  db.execute[part](sql::statement_of("delete from part"), []);
  ()
}

fn live_step(
  operation: Operation,
) -> sql::QueryResult / {db.write, db.read[part], db.write[part], db.read[bin], db.write[bin]} =
  match operation {
    Begin(level) -> db.begin(level, db::ReadWrite),
    Commit -> db.commit(),
    Abort -> db.abort(),
    Insert(v) -> live_write(values_table(v), render(fixture(), operation)),
    Update(o) -> live_write(o.table, render(fixture(), operation)),
    Delete(o) -> live_write(o.table, render(fixture(), operation)),
    Select(o) -> live_read(o.table, render(fixture(), operation)),
    Count(w) -> live_read(w, render(fixture(), operation)),
  }

fn live_write(table: Which, r: Rendered) -> sql::QueryResult / {db.write[part], db.write[bin]} =
  match table {
    Part -> db.execute[part](r.statement, r.params),
    Bin -> db.execute[bin](r.statement, r.params),
  }

fn live_read(table: Which, r: Rendered) -> sql::QueryResult / {db.read[part], db.read[bin]} =
  match table {
    Part -> db.query[part](r.statement, r.params),
    Bin -> db.query[bin](r.statement, r.params),
  }

pub fn agree(memory: List<sql::QueryResult>, live: List<sql::QueryResult>) -> Bool =
  match first_difference(memory, live, 0) { None -> true, Some(_) -> false }

pub fn first_difference(
  memory: List<sql::QueryResult>,
  live: List<sql::QueryResult>,
  at: Int,
) -> Option<Int> =
  match memory {
    [] -> match live { [] -> None, _ -> Some(at) },
    [m, ..mt] -> match live {
      [] -> Some(at),
      [l, ..lt] -> if results_agree(m, l) { first_difference(mt, lt, at + 1) } else { Some(at) },
    },
  }

pub fn results_agree(a: sql::QueryResult, b: sql::QueryResult) -> Bool =
  match a {
    sql::Count(x) -> match b { sql::Count(y) -> x == y, _ -> false },
    sql::Failed(x) -> match b {
      sql::Failed(y) -> x.code == y.code && x.constraint == y.constraint,
      _ -> false,
    },
    sql::Rows(xs) -> match b { sql::Rows(ys) -> rows_agree(xs, ys), _ -> false },
  }

fn rows_agree(xs: List<sql::Row>, ys: List<sql::Row>) -> Bool =
  match xs {
    [] -> match ys { [] -> true, _ -> false },
    [x, ..xt] -> match ys { [] -> false, [y, ..yt] -> row_agrees(x, y) && rows_agree(xt, yt) },
  }

type Entry = { key: String, value: sql::Datum }

fn row_agrees(x: sql::Row, y: sql::Row) -> Bool =
  x.len() == y.len()
    && x.entries().fold(true, |accumulator: Bool, e: Entry|
      accumulator && (match y.get(e.key) { None -> false, Some(v) -> datum_agrees(e.value, v) }))

fn datum_agrees(a: sql::Datum, b: sql::Datum) -> Bool =
  match a {
    sql::NumericDatum(x) -> match b {
      sql::NumericDatum(y) -> x.to_string() == y.to_string(),
      _ -> false,
    },
    _ -> a == b,
  }

type ColumnValue = { table: Which, column: Col, value: Value }

fn texts() -> Gen<String> = gen::elements(["a", "B", "b", ""])

fn counts() -> Gen<Int> = gen::int_between(-2, 9)

fn prices() -> Gen<Decimal> = gen::elements([0m, 1m, 1.5m, 2.2500m, -1m])

fn column_value() -> Gen<ColumnValue> = {
  let at = |table: Which, column: Col, values: Gen<Value>|
    gen::map(gen::one_of([values, gen::constant(VNull)]), |v: Value|
      { table: table, column: column, value: v });
  let text = gen::map(texts(), |s: String| VText(s));
  let int = gen::map(counts(), |n: Int| VInt(n));
  let number = gen::map(prices(), |d: Decimal| VNum(d));
  gen::one_of([
    at(Part, CSku, text),
    at(Part, CPrice, number),
    at(Part, CTag, text),
    at(Part, CNumber, int),
    at(Bin, CId, int),
    at(Bin, CSku, text),
    at(Bin, CQty, int),
  ])
}

fn operations() -> Gen<Operation> =
  gen::one_of([
    gen::map4(
      texts(),
      prices(),
      gen::option_of(texts()),
      gen::option_of(counts()),
      |sku: String, price: Decimal, tag: Option<String>, n: Option<Int>|
        Insert(PartValues(sku, price, tag, n)),
    ),
    gen::map3(
      counts(),
      gen::option_of(texts()),
      gen::option_of(counts()),
      |id: Int, sku: Option<String>, qty: Option<Int>| Insert(BinValues(id, sku, qty)),
    ),
    gen::map2(column_value(), column_value(), |set: ColumnValue, at: ColumnValue|
      Update({
        table: set.table,
        column: set.column,
        to: set.value,
        where_col: at.column,
        eq: at.value,
      })),
    gen::map(column_value(), |at: ColumnValue|
      Delete({ table: at.table, where_col: at.column, eq: at.value })),
    gen::map2(column_value(), gen::int_between(0, 5), |by: ColumnValue, limit: Int|
      Select({ table: by.table, order_by: by.column, limit: limit })),
    gen::map(gen::elements([Part, Bin]), |w: Which| Count(w)),
    gen::map(
      gen::elements([db::ReadCommitted, db::RepeatableRead, db::Serializable]),
      |level: db::Isolation| Begin(level),
    ),
    gen::constant(Commit),
    gen::constant(Abort),
  ])

fn closed(operations: List<Operation>) -> List<Operation> = {
  let walked = operations.fold(
    { depth: 0, out: [] },
    |accumulator: { depth: Int, out: List<Operation> }, o: Operation|
      match o {
        Begin(_) -> if accumulator.depth < db::max_savepoints() {
          { depth: accumulator.depth + 1, out: accumulator.out.push(o) }
        } else { accumulator },
        Commit -> if accumulator.depth > 0 {
          { depth: accumulator.depth - 1, out: accumulator.out.push(o) }
        } else { accumulator },
        Abort -> if accumulator.depth > 0 {
          { depth: accumulator.depth - 1, out: accumulator.out.push(o) }
        } else { accumulator },
        _ -> { ..accumulator, out: accumulator.out.push(o) },
      },
  );
  range(0, walked.depth).fold(walked.out, |out: List<Operation>, _i: Int| out.push(Commit))
}

pub fn runs() -> Gen<List<Operation>> =
  gen::map(gen::list_of(operations(), 12), |drawn: List<Operation>|
    closed(drawn.filter(|o: Operation| typed(fixture(), o))))

pub fn main() -> Unit / {db.write, db.read[part], db.write[part], db.read[bin], db.write[bin], abort.raise} =
  gen::check(runs(), |operations: List<Operation>|
    agree(replay_memory(fixture(), operations), replay_live(operations)))

test "every generated sequence of operations passes the `well_formed` check" {
  gen::check(runs(), |operations: List<Operation>| well_formed(fixture(), operations))
}

test "a replay returns exactly one result per operation" {
  gen::check(runs(), |operations: List<Operation>|
    replay_memory(fixture(), operations).len() == operations.len())
}

test "`agree` is reflexive: any list of results agrees with itself and has no first difference" {
  gen::check(runs(), |operations: List<Operation>| {
    let results = replay_memory(fixture(), operations);
    agree(results, results) && first_difference(results, results, 0) == None
  })
}

pub fn collation_operations() -> List<Operation> =
  [
    Insert(PartValues("B", 1m, None, None)),
    Insert(PartValues("a", 1m, None, None)),
    Select({ table: Part, order_by: CSku, limit: 10 }),
  ]

pub fn aborted_operations() -> List<Operation> =
  [
    Begin(db::ReadCommitted),
    Insert(PartValues("a", 1m, None, None)),
    Insert(PartValues("a", 2m, None, None)),
    Count(Part),
    Commit,
    Count(Part),
  ]

fn row4(sku: String, price: Decimal) -> sql::Row =
  Map::of_entries([
    { key: "sku", value: sql::TextDatum(sku) },
    { key: "price", value: sql::NumericDatum(price) },
    { key: "tag", value: sql::NullDatum },
    { key: "n", value: sql::NullDatum },
  ])

fn counted(n: Int) -> sql::QueryResult =
  sql::Rows([Map::of_entries([{ key: "count", value: sql::IntDatum(n) }])])

pub fn collation_transcript() -> List<sql::QueryResult> =
  [sql::Count(1), sql::Count(1), sql::Rows([row4("B", 1.0000m), row4("a", 1.0000m)])]

pub fn aborted_transcript() -> List<sql::QueryResult> =
  [
    sql::Count(0),
    sql::Count(1),
    sql::Failed({ code: "23505", constraint: "part_pkey", detail: "" }),
    sql::Failed({ code: "25P02", constraint: "", detail: "" }),
    sql::Failed({ code: "25P02", constraint: "", detail: "" }),
    counted(0),
  ]

test "`render` turns each operation into one SQL statement with its parameter list" {
  let r = render(fixture(), Insert(PartValues("a", 1m, None, None)));
  assert_eq(r.statement.sql, "insert into part (sku, price, tag, n) values ($1, $2, $3, $4)");
  assert_eq(r.params.len(), 4);
  assert_eq(
    render(fixture(), Select({ table: Part, order_by: CSku, limit: 3 })).statement.sql,
    "select sku, price, tag, n from part order by sku, sku limit 3",
  );
  assert_eq(render(fixture(), Count(Bin)).statement.sql, "select count(*) from bin");
  assert_eq(
    render(
      fixture(),
      Update({ table: Part, column: CNumber, to: VInt(1), where_col: CSku, eq: VText("a") }),
    ).statement.sql,
    "update part set n = $1 where sku = $2",
  );
  assert_eq(
    render(fixture(), Delete({ table: Part, where_col: CSku, eq: VText("a") })).statement.sql,
    "delete from part where sku = $1",
  )
}

test "every generated select orders by a key with no ties" {
  assert_eq(
    render(fixture(), Select({ table: Part, order_by: CNumber, limit: 1 })).statement.sql,
    "select sku, price, tag, n from part order by n, sku limit 1",
  );
  assert_eq(
    render(fixture(), Select({ table: Bin, order_by: CQty, limit: 4 })).statement.sql,
    "select id, sku, qty from bin order by qty, id limit 4",
  );
  assert(!well_formed({ tables: [keyless()] }, [Select({ table: Part, order_by: CSku, limit: 1 })]))
}

fn keyless() -> sql::Table =
  {
    name: "part",
    columns: [sql::column("sku", sql::TText, true)],
    primary_key: [],
    unique: [],
    foreign_keys: [],
    checks: [],
  }

test "`well_formed` rejects unbalanced transactions, too-deep nesting, mistyped values and columns of the wrong table" {
  assert(well_formed(fixture(), collation_operations()));
  assert(well_formed(fixture(), aborted_operations()));
  assert(!well_formed(fixture(), [Commit]));
  assert(!well_formed(fixture(), [Begin(db::ReadCommitted)]));
  assert(!well_formed(fixture(), [Begin(db::ReadCommitted), Commit, Abort]));
  assert(!well_formed(fixture(), deep(db::max_savepoints() + 1)));
  assert(
    !well_formed(fixture(), [
      Update({ table: Part, column: CNumber, to: VText("x"), where_col: CSku, eq: VText("a") }),
    ]),
  );
  assert(!well_formed(fixture(), [Select({ table: Part, order_by: CQty, limit: 1 })]));
  assert(!well_formed(fixture(), [Delete({ table: Bin, where_col: CPrice, eq: VNum(1m) })]));
  assert(!well_formed(fixture(), [Select({ table: Part, order_by: CSku, limit: -1 })]));
  assert(well_formed(fixture(), [Insert(BinValues(1, Some("a"), None))]))
}

fn deep(n: Int) -> List<Operation> = if n <= 0 { [] } else { balanced_pair(deep(n - 1)) }

fn balanced_pair(inner: List<Operation>) -> List<Operation> =
  inner.fold([Begin(db::ReadCommitted)], |accumulator: List<Operation>, o: Operation|
    accumulator.push(o)).push(
    Commit,
  )

test "the fake reproduces a transcript recorded from postgres" {
  assert(agree(replay_memory(fixture(), collation_operations()), collation_transcript()));
  assert(agree(replay_memory(fixture(), aborted_operations()), aborted_transcript()))
}

test "replaying collation operations in memory differs from Postgres results only at the select, not before it" {
  let injected = [
    sql::Count(1),
    sql::Count(1),
    sql::Rows([row4("a", 1.0000m), row4("B", 1.0000m)]),
  ];
  assert(!agree(replay_memory(fixture(), collation_operations()), injected));
  assert_eq(
    first_difference(replay_memory(fixture(), collation_operations()), injected, 0),
    Some(2),
  )
}

test "results that lack the failed-transaction error after a duplicate key differ from the replay at the later count" {
  let injected = [
    sql::Count(0),
    sql::Count(1),
    sql::Failed({ code: "23505", constraint: "part_pkey", detail: "" }),
    counted(1),
    sql::Failed({ code: "25P02", constraint: "", detail: "" }),
    counted(0),
  ];
  assert(!agree(replay_memory(fixture(), aborted_operations()), injected));
  assert_eq(first_difference(replay_memory(fixture(), aborted_operations()), injected, 0), Some(3))
}

test "a failure compares its code and its constraint and never its message" {
  let a = sql::Failed({ code: "23505", constraint: "part_pkey", detail: "Key (sku)=(a) exists." });
  let b = sql::Failed({ code: "23505", constraint: "part_pkey", detail: "" });
  let c = sql::Failed({ code: "23505", constraint: "part_tag_key", detail: "" });
  let d = sql::Failed({ code: "23514", constraint: "part_pkey", detail: "" });
  assert(results_agree(a, b));
  assert(!results_agree(a, c));
  assert(!results_agree(a, d))
}

test "numeric results with different scales, such as 1.00 and 1.0000, are not treated as agreeing" {
  assert(1.00m == 1.0000m);
  assert(
    !results_agree(
      sql::Rows([Map::of_entries([{ key: "p", value: sql::NumericDatum(1.00m) }])]),
      sql::Rows([Map::of_entries([{ key: "p", value: sql::NumericDatum(1.0000m) }])]),
    ),
  );
  assert(
    results_agree(
      sql::Rows([Map::of_entries([{ key: "p", value: sql::NumericDatum(1.0000m) }])]),
      sql::Rows([Map::of_entries([{ key: "p", value: sql::NumericDatum(1.0000m) }])]),
    ),
  )
}

test "`well_formed` accepts operations of every kind, and each one renders to SQL" {
  assert(well_formed(fixture(), [Insert(PartValues("a", 1m, Some("t"), Some(1)))]));
  assert(well_formed(fixture(), [Insert(BinValues(1, Some("a"), Some(2)))]));
  assert(
    well_formed(fixture(), [
      Update({ table: Part, column: CPrice, to: VNum(2m), where_col: CSku, eq: VText("a") }),
    ]),
  );
  assert(well_formed(fixture(), [Delete({ table: Bin, where_col: CId, eq: VInt(1) })]));
  assert(well_formed(fixture(), [Select({ table: Bin, order_by: CQty, limit: 3 })]));
  assert(well_formed(fixture(), [Count(Bin)]));
  assert(
    render(fixture(), Insert(BinValues(1, None, None))).statement.sql.contains("insert into bin"),
  );
  assert(render(fixture(), Count(Bin)).statement.sql.contains("count(*) from bin"))
}

test "`first_difference` reports the index where the shorter list ends when the lists differ in length" {
  assert_eq(first_difference([sql::Count(1)], [], 0), Some(0));
  assert_eq(first_difference([], [sql::Count(1)], 0), Some(0));
  assert_eq(first_difference([sql::Count(1)], [sql::Count(1), sql::Count(2)], 0), Some(1))
}
