// `clock` is declared `nondet`: what it returns is not a function of the
// program state. A deterministic test whose footprint still contains a `clock`
// atom is a compile error, so there are exactly two ways to write a test that
// touches this module — handle the effect, or mark the test `test/nondet` and
// give up the cache. This file shows both.

nondet effect clock {
  read now() -> Int
}

type Session = { user: String, started: Int, ttl: Int }

fn expires_at(s: Session) -> Int = s.started + s.ttl

fn expired(s: Session) -> Bool / {clock.read} =
  clock.now() > expires_at(s)

// A session with no deadline can never go stale, so this path never asks the
// clock. The signature still permits it, and the signature is all the checker
// gets to look at.
fn stale(s: Session) -> Bool / {clock.read} =
  if s.ttl <= 0 { false } else { expired(s) }

fn session() -> Session = {user: "ada", started: 1000, ttl: 60}

test "expiry is decided against the deadline, not the wall clock" {
  assert_eq(expires_at(session()), 1060);
  handle {
    assert(!stale(session()))
  } with {
    clock.now() -> 1060,
  };
  handle {
    assert(stale(session()))
  } with {
    clock.now() -> 1061,
  }
}

// Nothing here reads the clock at run time, but `stale` is typed as if it
// might, so the atom survives into the footprint and the test has to opt out.
// Drop the `/nondet` and this is E0412 — see tests/fixtures/nondet_fail.ply.
test/nondet "a session with no deadline never goes stale" {
  assert(!stale({user: "ada", started: 1000, ttl: 0}));
  assert(!stale({user: "grace", started: 0, ttl: -1}))
}
