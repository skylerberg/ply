import std.gen
import std.net (net, send_all)
import std.json
import std.string

pub type Line = { sku: String, qty: Int, unit_price: Decimal }

pub type Order = { customer: String, lines: List<Line> }

pub type Receipt = { customer: String, items: Int, total: Decimal }

pub type Reply = | Accepted(Receipt) | Rejected(String)

derive json for Line
derive json for Order
derive json for Receipt
derive json for Reply

pub fn total(lines: List<Line>) -> Decimal =
  lines.fold(0m, |accumulator: Decimal, l: Line|
    accumulator + Decimal::of_int(l.qty) * l.unit_price)

pub fn items(lines: List<Line>) -> Int =
  lines.fold(0, |accumulator: Int, l: Line| accumulator + l.qty)

pub fn receipt(o: Order) -> Receipt =
  { customer: o.customer, items: items(o.lines), total: total(o.lines) }

pub fn reply_for(body: Bytes) -> Reply / {abort.raise} =
  match json::decode_bytes(body, order_json()) {
    Ok(o) -> accept(o),
    Err(e) -> Rejected(json::error_to_string(e)),
  }

fn accept(o: Order) -> Reply =
  if o.lines.len() == 0 { Rejected("an order needs at least one line") }
  else if bad_line(o.lines) { Rejected("every line needs a positive quantity") }
  else { Accepted(receipt(o)) }

fn bad_line(lines: List<Line>) -> Bool = lines.fold(false, |seen: Bool, l: Line| seen || l.qty <= 0)

pub type Request = { method: Bytes, target: Bytes, length: Int }

pub type Parsed = | Complete(Request) | Incomplete | Malformed(String)

pub fn max_head() -> Int = 4096

pub fn max_body() -> Int = 65536

pub fn max_chunks() -> Int = 64

pub fn deadline_ms() -> Int = 5000

pub fn head_end(buffer: Bytes) -> Int =
  match buffer.index_of(b"\r\n\r\n") { Some(at) -> at + 4, None -> -1 }

fn line_end(head: Bytes, i: Int) -> Int / {abort.raise} =
  match head.index_of_from(b"\r\n", i) { Some(at) -> at, None -> head.len() }

fn trim(b: Bytes) -> Bytes / {abort.raise} = {
  let start = b.scan(0, b" \t", b.len());
  let end = trim_end(b, b.len());
  if start >= end { b"" } else { b.slice(start, end) }
}

fn trim_end(b: Bytes, end: Int) -> Int / {abort.raise} =
  if end <= 0 { 0 }
  else if b.at(end - 1) == 32 || b.at(end - 1) == 9 { trim_end(b, end - 1) }
  else { end }

fn header(head: Bytes, lower: Bytes, i: Int) -> Option<Bytes> / {abort.raise} =
  head.slice(min(i, head.len()), head.len()).split(b"\r\n").fold(
    { found: None, open: true },
    |s: { found: Option<Bytes>, open: Bool }, line: Bytes|
      if !s.open { s }
      else if line.len() == 0 { { ..s, open: false } } else {
        match line.index_of(b":") {
          Some(colon) -> if lowercase(line.slice(0, colon)) == lower {
            { found: Some(trim(line.slice(colon + 1, line.len()))), open: false }
          } else { s },
          None -> s,
        }
      },
  ).found

fn lowercase(b: Bytes) -> Bytes = Bytes::of_string(String::of_bytes_lossy(b).ascii_lower())

pub fn content_length(head: Bytes) -> Option<Int> / {abort.raise} =
  match header(head, b"content-length", line_end(head, 0) + 2) {
    Some(v) -> digits(v, 0, 0),
    None -> None,
  }

fn digits(b: Bytes, i: Int, accumulator: Int) -> Option<Int> / {abort.raise} =
  if i >= b.len() { if i == 0 || accumulator > max_body() { None } else { Some(accumulator) } }
  else if b.at(i) < 48 || b.at(i) > 57 { None }
  else { digits(b, i + 1, accumulator * 10 + (b.at(i) - 48)) }

pub fn parse(head: Bytes) -> Parsed / {abort.raise} =
  if head_end(head) < 0 { Incomplete } else { request_line(head.slice(0, line_end(head, 0)), head) }

fn request_line(line: Bytes, head: Bytes) -> Parsed / {abort.raise} = {
  let len = line.len();
  let first_space = line.scan_until(0, b" ", len);
  if first_space >= len { Malformed("a request line is `METHOD TARGET VERSION`") } else {
    let second_space = line.scan_until(first_space + 1, b" ", len);
    if second_space >= len { Malformed("a request line is `METHOD TARGET VERSION`") } else {
      parts(
        line.slice(0, first_space),
        line.slice(first_space + 1, second_space),
        line.slice(second_space + 1, len),
        head,
      )
    }
  }
}

fn parts(method: Bytes, target: Bytes, version: Bytes, head: Bytes) -> Parsed / {abort.raise} =
  if method.len() == 0 { Malformed("a method is one or more uppercase ASCII letters") }
  else if target.len() == 0 || target.at(0) != 47 {
    Malformed("this endpoint serves origin-form targets, which begin with `/`")
  } else if version != b"HTTP/1.1" && version != b"HTTP/1.0" {
    Malformed("the version must be HTTP/1.1 or HTTP/1.0")
  } else {
    Complete({
      method: method,
      target: target,
      length: match content_length(head) { Some(n) -> n, None -> 0 },
    })
  }

pub fn respond(status: String, body: Bytes) -> Bytes =
  Bytes::of_string(
    "HTTP/1.1 " ++ status ++ "\r\n" ++ "Content-Type: application/json\r\n" ++ "Content-Length: "
      ++ body.len().to_string()
      ++ "\r\n"
      ++ "Connection: close\r\n"
      ++ "\r\n",
  ).concat(
    body,
  )

pub fn reply_response(reply: Reply) -> Bytes / {abort.raise} =
  respond(status_of(reply), json::encode_bytes(reply, reply_json()))

fn status_of(reply: Reply) -> String =
  match reply { Accepted(_) -> "200 OK", Rejected(_) -> "400 Bad Request" }

pub fn result(head: Bytes, body: Bytes) -> Bytes / {abort.raise} =
  match parse(head) {
    Incomplete -> reply_response(Rejected("the request head never ended")),
    Malformed(reason) -> reply_response(Rejected(reason)),
    Complete(r) -> route(r, body),
  }

fn route(r: Request, body: Bytes) -> Bytes / {abort.raise} =
  if r.target != b"/orders" {
    respond(
      "404 Not Found",
      json::encode_bytes(Rejected("this endpoint serves `/orders`"), reply_json()),
    )
  } else if r.method != b"POST" {
    respond(
      "405 Method Not Allowed",
      json::encode_bytes(Rejected("to create an order, send a POST request"), reply_json()),
    )
  } else if body.len() < r.length {
    reply_response(Rejected("the body was shorter than its `Content-Length`"))
  } else { reply_response(reply_for(body.slice(0, r.length))) }

pub fn read_head(c: Int, so_far: Bytes, left: Int) -> Bytes / {net.recv[conn]} =
  if left <= 0 || head_end(so_far) >= 0 || so_far.len() >= max_head() { so_far } else {
    match net.recv[conn](c, max_head(), deadline_ms()) {
      None -> so_far,
      Some(chunk) -> if chunk.len() == 0 { so_far }
      else { read_head(c, so_far.concat(chunk), left - 1) },
    }
  }

pub fn read_body(c: Int, so_far: Bytes, want: Int, left: Int) -> Bytes / {net.recv[conn]} =
  if left <= 0 || so_far.len() >= want { so_far } else {
    match net.recv[conn](c, max_body(), deadline_ms()) {
      None -> so_far,
      Some(chunk) -> if chunk.len() == 0 { so_far }
      else { read_body(c, so_far.concat(chunk), want, left - 1) },
    }
  }

pub fn serve_one(c: Int) -> Unit / {net.close[conn], net.recv[conn], net.send[conn], abort.raise} = {
  let raw = read_head(c, b"", max_chunks());
  let out = result_from(c, raw);
  send_all[conn](c, out, deadline_ms());
  net.close[conn](c)
}

fn result_from(c: Int, raw: Bytes) -> Bytes / {net.recv[conn], abort.raise} = {
  let end = head_end(raw);
  if end < 0 { reply_response(Rejected("the request head never ended")) } else {
    let head = raw.slice(0, end);
    let want = match content_length(head) { Some(n) -> n, None -> 0 };
    result(head, read_body(c, raw.slice(end, raw.len()), want, max_chunks()))
  }
}

pub fn serve(
  server: Int,
  count: Int,
) -> Int / {net.accept[listener], net.close[conn], net.recv[conn], net.send[conn], abort.raise} =
  if count <= 0 { 0 } else {
    serve_one(net.accept[listener](server));
    1 + serve(server, count - 1)
  }

pub fn listen_and_serve(
  port: Int,
  count: Int,
) -> Int / {net.close[listener], net.listen[listener], net.accept[listener], net.close[conn], net.recv[conn], net.send[conn], abort.raise} = {
  let server = net.listen[listener](port);
  let served = serve(server, count);
  net.close[listener](server);
  served
}

fn line(sku: String, qty: Int, price: Decimal) -> Line = { sku: sku, qty: qty, unit_price: price }

fn one_order() -> Order =
  { customer: "ada", lines: [line("widget", 3, 1.05m), line("gasket", 2, 0.10m)] }

test "JSON-encoding a line and an order writes each object's fields in alphabetical key order, such as `qty` before `sku`" {
  assert_eq(
    json::encode_string(line("widget", 3, 1.05m), line_json()),
    "{\"qty\":3,\"sku\":\"widget\",\"unit_price\":1.05}",
  );
  assert_eq(
    json::encode_string(one_order(), order_json()),
    "{\"customer\":\"ada\",\"lines\":[" ++ "{\"qty\":3,\"sku\":\"widget\",\"unit_price\":1.05},"
      ++ "{\"qty\":2,\"sku\":\"gasket\",\"unit_price\":0.10}]}",
  )
}

test "a derived ADT encoding carries its tag" {
  assert_eq(
    json::encode_string(Rejected("no"), reply_json()),
    "{\"tag\":\"Rejected\",\"values\":[\"no\"]}",
  );
  assert_eq(
    json::encode_string(Accepted({ customer: "ada", items: 1, total: 2.50m }), reply_json()),
    "{\"tag\":\"Accepted\",\"values\":[{\"customer\":\"ada\",\"items\":1,\"total\":2.50}]}",
  )
}

test "decoding is the inverse of encoding, for every payload in this file" {
  assert_eq(
    json::decode_string(json::encode_string(one_order(), order_json()), order_json()),
    Ok(one_order()),
  );
  assert_eq(
    json::decode_string(
      json::encode_string(Accepted(receipt(one_order())), reply_json()),
      reply_json(),
    ),
    Ok(Accepted(receipt(one_order()))),
  )
}

test "a receipt survives a round trip through its derived codec" {
  gen::check3(
    gen::text(),
    gen::any_int(),
    gen::decimal(),
    |customer: String, n: Int, sum: Decimal| {
      let r = { customer: customer, items: n, total: sum };
      json::decode_bytes(json::encode_bytes(r, receipt_json()), receipt_json()) == Ok(r)
    },
  )
}

test "an order survives a round trip through its derived codec" {
  let lines = gen::map3(gen::text(), gen::any_int(), gen::decimal(), line);
  gen::check2(gen::text(), gen::list_of(lines, 4), |customer: String, drawn: List<Line>| {
    let o = { customer: customer, lines: drawn };
    json::decode_bytes(json::encode_bytes(o, order_json()), order_json()) == Ok(o)
  })
}

test "a total is an exact sum of exact products" {
  assert_eq(total([line("widget", 3, 1.05m), line("gasket", 2, 0.10m)]), 3.35m);

  assert_eq(total([line("a", 1, 0.1m), line("b", 1, 0.2m)]), 0.3m);
  assert_eq(total([]), 0m)
}

test "a decimal price keeps its trailing zeros through decoding and encoding, so `1.50` and `1.5` encode differently" {
  assert_eq(
    json::decode_string("{\"sku\":\"a\",\"qty\":1,\"unit_price\":1.50}", line_json()),
    Ok(line("a", 1, 1.50m)),
  );
  assert_eq(
    json::encode_string(line("a", 1, 1.50m), line_json()),
    "{\"qty\":1,\"sku\":\"a\",\"unit_price\":1.50}",
  );

  assert(1.50m == 1.5m);
  assert(
    json::encode_string(line("a", 1, 1.5m), line_json())
      != json::encode_string(line("a", 1, 1.50m), line_json()),
  )
}

fn post(body: String) -> Bytes =
  Bytes::of_string(
    "POST /orders HTTP/1.1\r\nHost: localhost\r\nContent-Type: application/json\r\n"
      ++ "Content-Length: "
      ++ Bytes::of_string(body).len().to_string()
      ++ "\r\n\r\n",
  )

fn response_to_post(body: String) -> String / {abort.raise} =
  String::of_bytes(result(post(body), Bytes::of_string(body)))

fn body_of(response: String) -> String / {abort.raise} =
  match response.find("\r\n\r\n") { at -> response.slice(at + 4, response.len()) }

test "a well-formed order is accepted, and the response is a derived receipt" {
  let out = response_to_post(
    "{\"customer\":\"ada\",\"lines\":[{\"sku\":\"w\",\"qty\":3,\"unit_price\":1.05}]}",
  );
  assert(out.starts_with("HTTP/1.1 200 OK\r\n"));
  assert(out.contains("Content-Type: application/json\r\n"));
  assert_eq(
    body_of(out),
    "{\"tag\":\"Accepted\",\"values\":[{\"customer\":\"ada\",\"items\":3,\"total\":3.15}]}",
  )
}

test "a payload that does not fit the type is rejected by field and reason" {
  let out = response_to_post(
    "{\"customer\":\"ada\",\"lines\":[{\"sku\":\"w\",\"qty\":\"three\",\"unit_price\":1.05}]}",
  );
  assert(out.starts_with("HTTP/1.1 400 Bad Request\r\n"));
  assert_eq(
    body_of(out),
    "{\"tag\":\"Rejected\",\"values\":[\"$.lines[0].qty: expected a number, found a string\"]}",
  );

  assert_eq(
    body_of(response_to_post("{\"customer\":\"ada\"}")),
    "{\"tag\":\"Rejected\",\"values\":[\"$.lines: this field is missing\"]}",
  )
}

test "a body that is not JSON at all is rejected with a byte offset" {
  assert_eq(
    body_of(response_to_post("not json")),
    "{\"tag\":\"Rejected\",\"values\":[\"$: expected `null` (at byte 0)\"]}",
  );
  assert_eq(
    body_of(response_to_post("")),
    "{\"tag\":\"Rejected\",\"values\":[\"$: the input ended where a value was expected (at byte 0)\"]}",
  )
}

test "an order with no lines is rejected, and so is an order with a line whose quantity is zero" {
  assert_eq(
    body_of(response_to_post("{\"customer\":\"ada\",\"lines\":[]}")),
    "{\"tag\":\"Rejected\",\"values\":[\"an order needs at least one line\"]}",
  );
  assert_eq(
    body_of(
      response_to_post(
        "{\"customer\":\"ada\",\"lines\":[{\"sku\":\"w\",\"qty\":0,\"unit_price\":1}]}",
      ),
    ),
    "{\"tag\":\"Rejected\",\"values\":[\"every line needs a positive quantity\"]}",
  )
}

test "a header name matches whatever case the client sent it in" {
  assert_eq(content_length(b"POST / HTTP/1.1\r\nContent-Length: 12\r\n\r\n"), Some(12));
  assert_eq(content_length(b"POST / HTTP/1.1\r\ncontent-length:12\r\n\r\n"), Some(12));
  assert_eq(content_length(b"POST / HTTP/1.1\r\nCONTENT-LENGTH:  12  \r\n\r\n"), Some(12));
  assert_eq(content_length(b"POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 7\r\n\r\n"), Some(7));
  assert_eq(content_length(b"POST / HTTP/1.1\r\n\r\n"), None);
  assert_eq(content_length(b"POST / HTTP/1.1\r\nContent-Length: none\r\n\r\n"), None);

  assert_eq(content_length(b"POST / HTTP/1.1\r\nContent-Length: 99999999\r\n\r\n"), None)
}

test "`content_length` ignores text in the request line that looks like a Content-Length header" {
  assert_eq(content_length(b"GET /a:content-length:9 HTTP/1.1\r\n\r\n"), None)
}

test "a route this endpoint does not serve is a 404 in the same format" {
  let out = String::of_bytes(result(Bytes::of_string("GET / HTTP/1.1\r\n\r\n"), b""));
  assert(out.starts_with("HTTP/1.1 404 Not Found\r\n"));
  assert_eq(body_of(out), "{\"tag\":\"Rejected\",\"values\":[\"this endpoint serves `/orders`\"]}");

  let wrong = String::of_bytes(result(Bytes::of_string("GET /orders HTTP/1.1\r\n\r\n"), b""));
  assert(wrong.starts_with("HTTP/1.1 405 Method Not Allowed\r\n"));
  assert_eq(
    body_of(wrong),
    "{\"tag\":\"Rejected\",\"values\":[\"to create an order, send a POST request\"]}",
  )
}

test "a malformed request line gets a response in the same format as everything else" {
  let out = String::of_bytes(result(Bytes::of_string("GET /\r\n\r\n"), b""));
  assert(out.starts_with("HTTP/1.1 400 Bad Request\r\n"));
  assert_eq(
    body_of(out),
    "{\"tag\":\"Rejected\",\"values\":[\"a request line is `METHOD TARGET VERSION`\"]}",
  )
}

fn first_chunk(queued: List<Bytes>) -> Bytes = match queued { [first, ..] -> first, _ -> b"" }

fn later_chunks(queued: List<Bytes>) -> List<Bytes> = match queued { [_, ..rest] -> rest, _ -> [] }

fn request_bytes(body: String) -> Bytes = post(body).concat(Bytes::of_string(body))

fn ada() -> String =
  "{\"customer\":\"ada\",\"lines\":[{\"sku\":\"w\",\"qty\":3,\"unit_price\":1.05}]}"

fn accepted() -> Bytes / {abort.raise} = result(post(ada()), Bytes::of_string(ada()))

test "`listen_and_serve` with simulated network handlers reads a posted order and sends back the accepted receipt" {
  let outbox = handle {
    assert_eq(listen_and_serve(0, 1), 1)
  } with {
    var inbox = [request_bytes(ada())],
    var outbox = [],
    net.listen[listener](p) -> 1,
    net.accept[listener](l) -> 7,
    net.close[listener](l) -> (),
    net.recv[conn](c, max, timeout_ms) -> {
      let queued = inbox;
      inbox = later_chunks(queued);
      Some(first_chunk(queued))
    },
    net.send[conn](c, payload, timeout_ms) -> {
      outbox = outbox.push(payload);
      Some(payload.len())
    },
    net.close[conn](c) -> (),
    return u -> outbox,
  };
  assert_eq(outbox, [accepted()])
}

test "`serve_one` reassembles a request that arrives in three chunks and sends the accepted response" {
  let whole = request_bytes(ada());
  let cut1 = 40;
  let cut2 = whole.len() - 12;
  let got = handle {
    serve_one(3)
  } with {
    var inbox = [whole.slice(0, cut1), whole.slice(cut1, cut2), whole.slice(cut2, whole.len())],
    var outbox = [],
    net.recv[conn](c, max, timeout_ms) -> {
      let queued = inbox;
      inbox = later_chunks(queued);
      Some(first_chunk(queued))
    },
    net.send[conn](c, payload, timeout_ms) -> {
      outbox = outbox.push(payload);
      Some(payload.len())
    },
    net.close[conn](c) -> (),
    return u -> { inbox: inbox, outbox: outbox },
  };
  assert_eq(got.outbox, [accepted()]);
  assert_eq(got.inbox, [])
}

test "a request that arrives in one packet is read with exactly one `recv` call" {
  let got = handle {
    serve_one(3)
  } with {
    var reads = 0,
    var outbox = [],
    net.recv[conn](c, max, timeout_ms) -> {
      reads = reads + 1;
      if reads == 1 { Some(request_bytes(ada())) } else { Some(b"") }
    },
    net.send[conn](c, payload, timeout_ms) -> {
      outbox = outbox.push(payload);
      Some(payload.len())
    },
    net.close[conn](c) -> (),
    return u -> { reads: reads, outbox: outbox },
  };
  assert_eq(got.reads, 1);
  assert_eq(got.outbox, [accepted()])
}

test "a peer that says nothing gets a response rather than being waited on" {
  let outbox = handle {
    serve_one(3)
  } with {
    var outbox = [],
    net.recv[conn](c, max, timeout_ms) -> Some(b""),
    net.send[conn](c, payload, timeout_ms) -> {
      outbox = outbox.push(payload);
      Some(payload.len())
    },
    net.close[conn](c) -> (),
    return u -> outbox,
  };
  assert_eq(outbox, [
    respond(
      "400 Bad Request",
      json::encode_bytes(Rejected("the request head never ended"), reply_json()),
    ),
  ])
}

test "a body shorter than its Content-Length is rejected rather than decoded" {
  let outbox = handle {
    serve_one(3)
  } with {
    var reads = 0,
    var outbox = [],
    net.recv[conn](c, max, timeout_ms) -> {
      reads = reads + 1;
      if reads == 1 { Some(post(ada()).concat(Bytes::of_string("{\"customer\""))) }
      else { Some(b"") }
    },
    net.send[conn](c, payload, timeout_ms) -> {
      outbox = outbox.push(payload);
      Some(payload.len())
    },
    net.close[conn](c) -> (),
    return u -> outbox,
  };
  assert_eq(outbox, [
    respond(
      "400 Bad Request",
      json::encode_bytes(Rejected("the body was shorter than its `Content-Length`"), reply_json()),
    ),
  ])
}

test "each accepted connection gets exactly one response" {
  let outbox = handle {
    assert_eq(listen_and_serve(0, 3), 3)
  } with {
    var outbox = [],
    net.listen[listener](p) -> 1,
    net.accept[listener](l) -> 7,
    net.close[listener](l) -> (),
    net.recv[conn](c, max, timeout_ms) -> Some(request_bytes(ada())),
    net.send[conn](c, payload, timeout_ms) -> {
      outbox = outbox.push(payload);
      Some(payload.len())
    },
    net.close[conn](c) -> (),
    return u -> outbox,
  };
  assert_eq(outbox, [accepted(), accepted(), accepted()])
}
