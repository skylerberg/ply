//! Two transfers out of one account, and the oldest concurrency bug there is: a balance checked in
//! one place and spent in another.

import std.gen

effect bank {
  read balance[r](account: String) -> Int
  write credit[r](account: String, amount: Int) -> Unit
  write take[r](account: String, amount: Int) -> Bool
  write record[r](movement: Movement) -> Unit
}

type Account = { name: String, balance: Int }

type Movement = { at: Instant, from: String, to: String, amount: Int }

fn balance_of(accounts: List<Account>, name: String) -> Int =
  accounts.fold(0, |acc, a: Account| if a.name == name { a.balance } else { acc })

/// One account, moved by one amount.
fn adjusted(account: Account, amount: Int) -> Account
  requires amount > -1000000000 && amount < 1000000000
  requires account.balance > -1000000000 && account.balance < 1000000000
  ensures result.name == account.name
  ensures result.balance == account.balance + amount
= { name: account.name, balance: account.balance + amount }

fn credited(accounts: List<Account>, name: String, amount: Int) -> List<Account> =
  accounts.map(|a: Account| if a.name == name { adjusted(a, amount) } else { a })

fn total(accounts: List<Account>) -> Int = accounts.fold(0, |acc, a: Account| acc + a.balance)

fn overdrawn(accounts: List<Account>) -> Int = accounts.filter(|a: Account| a.balance < 0).len()

fn opening() -> List<Account> =
  [{ name: "alice", balance: 100 }, { name: "bob", balance: 50 }, { name: "carol", balance: 50 }]

/// The bug.
fn transfer(
  from: String,
  to: String,
  amount: Int,
) -> Bool / {bank.balance[accounts], bank.credit[accounts], bank.record[journal], clock.now}
  requires amount > 0
  requires from != to
= {
  if bank.balance[accounts](from) < amount { false } else {
    let at = clock.now();
    bank.credit[accounts](from, -amount);
    bank.credit[accounts](to, amount);
    bank.record[journal]({ at: at, from: from, to: to, amount: amount });
    true
  }
}

/// The fix.
fn settle(
  from: String,
  to: String,
  amount: Int,
) -> Bool / {bank.take[accounts], bank.credit[accounts], bank.record[journal], clock.now}
  requires amount > 0
  requires from != to
= {
  if bank.take[accounts](from, amount) {
    let at = clock.now();
    bank.credit[accounts](to, amount);
    bank.record[journal]({ at: at, from: from, to: to, amount: amount });
    true
  } else { false }
}

// Inside the decidable fragment.
law "a credit and a matching debit leave an account exactly as it was"
  forall (account: Account, amount: Int)
  where amount > -1000000000 && amount < 1000000000 && account.balance > -1000000000
    && account.balance < 1000000000 {
    adjusted(adjusted(account, amount), -amount) == account
  }

// `credited` maps over the list, and the prover has no definition for `map`, so this is a test over
// drawn banks and no claim.
test "crediting a name the bank does not hold moves nothing" {
  let held = gen::map2(
    gen::elements(["alice", "bob", "carol"]),
    gen::int_between(-1000, 1000),
    |name: String, balance: Int| { name: name, balance: balance },
  );
  gen::check2(
    gen::list_of(held, 5),
    gen::int_between(-1000, 1000),
    |accounts: List<Account>, amount: Int| credited(accounts, "dave", amount) == accounts,
  )
}

// Conservation, as a claim about values rather than about schedules. The guard holds `amount`
// between two literals, so the claim is proved by trying every amount it admits.
law "a movement between two accounts leaves the bank's total alone"
  forall (amount: Int) where amount > 0 && amount <= 100 {
    total(credited(credited(opening(), "alice", -amount), "bob", amount)) == total(opening())
  }

// The concurrency law.
law "no interleaving of two guarded settlements can overdraw the account" {
  with_cell[accounts](opening()) { ledger -> {
    with_cell[journal]([]) { log -> {
      handle {
        simulate {
          let a = task.spawn(|| settle("alice", "bob", 60));
          let b = task.spawn(|| settle("alice", "carol", 60));
          task.join(a);
          task.join(b);
          overdrawn(cell_get(ledger)) == 0 && total(cell_get(ledger)) == 200
            && balance_of(cell_get(ledger), "alice") == 40
            && cell_get(log).len() == 1
        }
      } with {
        bank.take[accounts](who, amount) -> if balance_of(cell_get(ledger), who) < amount { false }
        else {
          cell_set(ledger, credited(cell_get(ledger), who, -amount));
          true
        },
        bank.credit[accounts](who, amount) ->
          cell_set(ledger, credited(cell_get(ledger), who, amount)),
        bank.record[journal](m) -> cell_set(log, cell_get(log).push(m)),
      }
    } }
  } }
}

test "a lone transfer moves the money and stops at the balance" {
  with_cell[accounts](opening()) { ledger -> {
    with_cell[journal]([]) { log -> {
      handle {
        simulate {
          assert(settle("alice", "bob", 60));
          assert(!settle("alice", "bob", 60));
          assert_eq(balance_of(cell_get(ledger), "alice"), 40);
          assert_eq(balance_of(cell_get(ledger), "bob"), 110);
          assert_eq(total(cell_get(ledger)), 200);
          assert_eq(cell_get(log).len(), 1)
        }
      } with {
        bank.take[accounts](who, amount) -> if balance_of(cell_get(ledger), who) < amount { false }
        else {
          cell_set(ledger, credited(cell_get(ledger), who, -amount));
          true
        },
        bank.credit[accounts](who, amount) ->
          cell_set(ledger, credited(cell_get(ledger), who, amount)),
        bank.record[journal](m) -> cell_set(log, cell_get(log).push(m)),
      }
    } }
  } }
}

// The racy version, asserting only what survives every interleaving.
test "two unguarded transfers conserve the money whichever order they run in" {
  with_cell[accounts](opening()) { ledger -> {
    with_cell[journal]([]) { log -> {
      handle {
        simulate {
          let a = task.spawn(|| transfer("alice", "bob", 60));
          let b = task.spawn(|| transfer("alice", "carol", 60));
          task.join(a);
          task.join(b);
          assert_eq(total(cell_get(ledger)), 200);
          assert_eq(
            cell_get(log).fold(0, |acc, m: Movement| acc + m.amount),
            100 - balance_of(cell_get(ledger), "alice"),
          )
        }
      } with {
        bank.balance[accounts](who) -> balance_of(cell_get(ledger), who),
        bank.credit[accounts](who, amount) ->
          cell_set(ledger, credited(cell_get(ledger), who, amount)),
        bank.record[journal](m) -> cell_set(log, cell_get(log).push(m)),
      }
    } }
  } }
}

// The one the milestone exists for.
test "the guarded transfer never overdraws, under every interleaving" {
  with_cell[accounts](opening()) { ledger -> {
    with_cell[journal]([]) { log -> {
      handle {
        simulate {
          let a = task.spawn(|| settle("alice", "bob", 60));
          let b = task.spawn(|| settle("alice", "carol", 60));
          task.join(a);
          task.join(b);
          assert_eq(overdrawn(cell_get(ledger)), 0);
          assert_eq(total(cell_get(ledger)), 200);
          assert_eq(balance_of(cell_get(ledger), "alice"), 40);
          assert_eq(cell_get(log).len(), 1);
          assert_eq(cell_get(log).fold(0, |acc, m: Movement| acc + m.amount), 60)
        }
      } with {
        bank.take[accounts](who, amount) -> if balance_of(cell_get(ledger), who) < amount { false }
        else {
          cell_set(ledger, credited(cell_get(ledger), who, -amount));
          true
        },
        bank.credit[accounts](who, amount) ->
          cell_set(ledger, credited(cell_get(ledger), who, amount)),
        bank.record[journal](m) -> cell_set(log, cell_get(log).push(m)),
      }
    } }
  } }
}

// Nothing here is concurrent, so nothing here is seeded: the pure helpers keep their ordinary `det`
// test and their ordinary cache entry, keyed by hash alone.
test "the helpers add up" {
  assert_eq(total(opening()), 200);
  assert_eq(balance_of(opening(), "alice"), 100);
  assert_eq(balance_of(opening(), "nobody"), 0);
  assert_eq(overdrawn(opening()), 0);
  assert_eq(overdrawn(credited(opening(), "bob", -60)), 1);
  assert_eq(total(credited(opening(), "bob", -60)), 140)
}
