import std.net (net, send_all)
import std.config
import std.config (config)

type Request = { method: Bytes, target: Bytes, version: Bytes }

type Parsed = | Complete(Request) | Incomplete | Malformed(String)

fn max_head() -> Int = 2048

fn index_of(hay: Bytes, set: Bytes, from: Int) -> Int / {abort.raise} =
  hay.scan_until(from, set, hay.len())

fn head_end(head: Bytes) -> Int =
  match head.index_of(b"\r\n\r\n") { Some(at) -> at + 4, None -> -1 }

fn all_upper(b: Bytes) -> Bool = b.scan(0, b"ABCDEFGHIJKLMNOPQRSTUVWXYZ", b.len()) == b.len()

fn parse(head: Bytes) -> Parsed / {abort.raise} = {
  if head_end(head) < 0 { Incomplete } else {
    let lf = index_of(head, b"\n", 0);
    if lf < 1 || head.at(lf - 1) != 13 { Malformed("the request line must end with CRLF") }
    else { request_line(head.slice(0, lf - 1)) }
  }
}

fn request_line(line: Bytes) -> Parsed / {abort.raise} = {
  let len = line.len();
  let first_space = index_of(line, b" ", 0);
  if first_space >= len { Malformed("a request line is `METHOD TARGET VERSION`") } else {
    let second_space = index_of(line, b" ", first_space + 1);
    if second_space >= len { Malformed("a request line is `METHOD TARGET VERSION`") }
    else if index_of(line, b" ", second_space + 1) < len {
      Malformed("a request line must contain exactly two spaces")
    } else {
      parts(
        line.slice(0, first_space),
        line.slice(first_space + 1, second_space),
        line.slice(second_space + 1, len),
      )
    }
  }
}

fn parts(method: Bytes, target: Bytes, version: Bytes) -> Parsed =
  if method.len() == 0 || !all_upper(method) {
    Malformed("a method is one or more uppercase ASCII letters")
  } else if target.len() == 0 || target.at(0) != 47 {
    Malformed("this endpoint serves origin-form targets, which begin with `/`")
  } else if version != b"HTTP/1.1" && version != b"HTTP/1.0" {
    Malformed("the version must be HTTP/1.1 or HTTP/1.0")
  } else { Complete({ method: method, target: target, version: version }) }

fn response(status: String, body: String) -> Bytes =
  Bytes::of_string(
    "HTTP/1.1 " ++ status ++ "\r\n" ++ "Content-Type: text/plain; charset=utf-8\r\n"
      ++ "Content-Length: "
      ++ Bytes::of_string(body).len().to_string()
      ++ "\r\n"
      ++ "Connection: close\r\n"
      ++ "\r\n"
      ++ body,
  )

fn greeting() -> String = "hello from ply\n"

fn result(head: Bytes) -> Bytes / {abort.raise} =
  match parse(head) {
    Complete(_) -> response("200 OK", greeting()),
    Incomplete -> response("400 Bad Request", "the request head never ended\n"),
    Malformed(reason) -> response("400 Bad Request", reason ++ "\n"),
  }

fn max_chunks() -> Int = 16

fn deadline_ms() -> Int = 5000

fn read_head(c: Int, so_far: Bytes, chunks_left: Int) -> Bytes / {net.recv[conn]} =
  if chunks_left <= 0 || head_end(so_far) >= 0 || so_far.len() >= max_head() { so_far } else {
    match net.recv[conn](c, max_head(), deadline_ms()) {
      None -> so_far,
      Some(chunk) -> if chunk.len() == 0 { so_far }
      else { read_head(c, so_far.concat(chunk), chunks_left - 1) },
    }
  }

fn serve_one(c: Int) -> Unit / {net.close[conn], net.recv[conn], net.send[conn], abort.raise} = {
  let response = result(read_head(c, b"", max_chunks()));
  send_all[conn](c, response, deadline_ms());
  net.close[conn](c)
}

fn serve(
  server: Int,
  count: Int,
) -> Int / {net.accept[listener], net.close[conn], net.recv[conn], net.send[conn], abort.raise} =
  if count <= 0 { 0 } else {
    serve_one(net.accept[listener](server));
    1 + serve(server, count - 1)
  }

fn listen_and_serve(
  port: Int,
  count: Int,
) -> Int / {net.close[listener], net.listen[listener], net.accept[listener], net.close[conn], net.recv[conn], net.send[conn], abort.raise} = {
  let server = net.listen[listener](port);
  let served = serve(server, count);
  net.close[listener](server);
  served
}

fn port() -> Int / {config.get[server], abort.raise} = setting("HELLO_PORT", 8080)

fn connections() -> Int / {config.get[server], abort.raise} = setting("HELLO_CONNECTIONS", 64)

fn setting(key: String, unset: Int) -> Int / {config.get[server], abort.raise} =
  match config.get[server](key) {
    None -> unset,
    Some(text) -> match whole(text) {
      Some(n) -> n,
      None -> panic(key ++ " is `" ++ text ++ "`, which is not a whole number"),
    },
  }

fn whole(text: String) -> Option<Int> = {
  let b = Bytes::of_string(text);
  if b.len() == 0 || b.scan(0, b"0123456789", b.len()) < b.len() { None }
  else { match Decimal::of_string(text) { Some(d) -> Int::of_decimal(d, Down), None -> None } }
}

fn main() -> Int / {config.get[server], net.close[conn], net.recv[conn], net.send[conn], net.accept[listener], net.close[listener], net.listen[listener], abort.raise} =
  listen_and_serve(port(), connections())

fn first_chunk(queued: List<Bytes>) -> Bytes = match queued { [first, ..] -> first, _ -> b"" }

fn later_chunks(queued: List<Bytes>) -> List<Bytes> = match queued { [_, ..rest] -> rest, _ -> [] }

fn get_root() -> Bytes = b"GET / HTTP/1.1\r\nHost: localhost\r\n\r\n"

fn ok() -> Bytes = response("200 OK", greeting())

fn bad(reason: String) -> Bytes = response("400 Bad Request", reason ++ "\n")

fn reason(head: Bytes) -> String / {abort.raise} =
  match parse(head) {
    Malformed(reason) -> reason,
    Incomplete -> "incomplete",
    Complete(_) -> "complete",
  }

test "a well-formed request line is split into its three parts" {
  assert_eq(parse(get_root()), Complete({ method: b"GET", target: b"/", version: b"HTTP/1.1" }));
  assert_eq(
    parse(b"POST /orders HTTP/1.0\r\n\r\n"),
    Complete({ method: b"POST", target: b"/orders", version: b"HTTP/1.0" }),
  )
}

test "a request head is incomplete until a blank line (CRLF CRLF) arrives, however much else has arrived" {
  assert_eq(head_end(b""), -1);
  assert_eq(head_end(b"GET / HTTP/1.1\r\n"), -1);
  assert_eq(head_end(b"GET / HTTP/1.1\r\n\r"), -1);
  assert_eq(head_end(get_root()), get_root().len());
  assert_eq(parse(b"GET / HTTP/1.1\r\nHost: x\r\n"), Incomplete)
}

test "a head ends at the first blank line and not at a later one" {
  let two = b"GET / HTTP/1.1\r\n\r\nGET / HTTP/1.1\r\n\r\n";
  assert_eq(head_end(two), 18);
  assert_eq(parse(two), Complete({ method: b"GET", target: b"/", version: b"HTTP/1.1" }))
}

test "each kind of malformed request line gives its own error message" {
  assert_eq(reason(b"GET /\r\n\r\n"), "a request line is `METHOD TARGET VERSION`");
  assert_eq(
    reason(b"GET / HTTP/1.1 extra\r\n\r\n"),
    "a request line must contain exactly two spaces",
  );
  assert_eq(reason(b" / HTTP/1.1\r\n\r\n"), "a method is one or more uppercase ASCII letters");
  assert_eq(reason(b"get / HTTP/1.1\r\n\r\n"), "a method is one or more uppercase ASCII letters");
  assert_eq(
    reason(b"GET  HTTP/1.1\r\n\r\n"),
    "this endpoint serves origin-form targets, which begin with `/`",
  );
  assert_eq(
    reason(b"GET http://x/ HTTP/1.1\r\n\r\n"),
    "this endpoint serves origin-form targets, which begin with `/`",
  );
  assert_eq(reason(b"GET / HTTP/2.0\r\n\r\n"), "the version must be HTTP/1.1 or HTTP/1.0");
  assert_eq(reason(b"GET / \r\n\r\n"), "the version must be HTTP/1.1 or HTTP/1.0");
  assert_eq(reason(b"GET / HTTP/1.1\n\r\n\r\n"), "the request line must end with CRLF")
}

test "a target that is not UTF-8 is rejected rather than decoded" {
  assert_eq(
    reason(b"GET \xff\xfe HTTP/1.1\r\n\r\n"),
    "this endpoint serves origin-form targets, which begin with `/`",
  );
  assert_eq(
    parse(b"GET /\xff HTTP/1.1\r\n\r\n"),
    Complete({ method: b"GET", target: b"/\xff", version: b"HTTP/1.1" }),
  );
  assert(!b"/\xff".is_utf8())
}

test "an empty head and a head of blank lines are both rejected" {
  assert_eq(parse(b""), Incomplete);
  assert_eq(reason(b"\r\n\r\n"), "a request line is `METHOD TARGET VERSION`");
  assert_eq(reason(b"\r\n\r\n\r\n"), "a request line is `METHOD TARGET VERSION`")
}

test "a request with a body is complete once its head has arrived, and the body is not needed" {
  let posted = b"POST /orders HTTP/1.1\r\nContent-Length: 5\r\n\r\nhello";
  assert_eq(head_end(posted), 44);
  assert_eq(reason(posted), "complete")
}

test "a response declares the byte length of its body, not its character count" {
  assert_eq(
    response("200 OK", "hi"),
    Bytes::of_string(
      "HTTP/1.1 200 OK\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: 2\r\nConnection: close\r\n\r\nhi",
    ),
  );

  assert_eq(Bytes::of_string("ééé").len(), 6);
  assert_eq(response("200 OK", "ééé").len(), response("200 OK", "abcdef").len())
}

test "a valid request head gets a 200 response and each invalid request head gets a 400 response" {
  assert_eq(result(get_root()), ok());
  assert_eq(result(b"GET / HTTP/1.1\r\n"), bad("the request head never ended"));
  assert_eq(result(b"GET / HTTP/9\r\n\r\n"), bad("the version must be HTTP/1.1 or HTTP/1.0"));
  assert_eq(result(b""), bad("the request head never ended"))
}

test "the simulated socket responds to a well-formed request with the fixed 200" {
  let outbox = handle {
    assert_eq(listen_and_serve(0, 1), 1)
  } with {
    var inbox = [get_root()],
    var outbox = [],
    net.listen[listener](p) -> 1,
    net.accept[listener](l) -> 7,
    net.close[listener](l) -> (),
    net.recv[conn](c, max, timeout_ms) -> {
      let queued = inbox;
      inbox = later_chunks(queued);
      Some(first_chunk(queued))
    },
    net.send[conn](c, payload, timeout_ms) -> {
      outbox = outbox.push(payload);
      Some(payload.len())
    },
    net.close[conn](c) -> (),
    return u -> outbox,
  };
  assert_eq(outbox, [ok()])
}

test "a request split across packets is read to its terminator" {
  let got = handle {
    serve_one(3)
  } with {
    var inbox = [b"GET / HT", b"TP/1.1\r\nHost: localhost\r", b"\n\r\n"],
    var outbox = [],
    net.recv[conn](c, max, timeout_ms) -> {
      let queued = inbox;
      inbox = later_chunks(queued);
      Some(first_chunk(queued))
    },
    net.send[conn](c, payload, timeout_ms) -> {
      outbox = outbox.push(payload);
      Some(payload.len())
    },
    net.close[conn](c) -> (),
    return u -> { inbox: inbox, outbox: outbox },
  };
  assert_eq(got.outbox, [ok()]);
  assert_eq(got.inbox, [])
}

test "a malformed request gets a 400 response and the connection is closed" {
  let got = handle {
    serve_one(3)
  } with {
    var inbox = [b"GET /\r\n\r\n"],
    var outbox = [],
    var closed = 0,
    net.recv[conn](c, max, timeout_ms) -> {
      let queued = inbox;
      inbox = later_chunks(queued);
      Some(first_chunk(queued))
    },
    net.send[conn](c, payload, timeout_ms) -> {
      outbox = outbox.push(payload);
      Some(payload.len())
    },
    net.close[conn](c) -> {
      closed = closed + 1;
    },
    return u -> { inbox: inbox, outbox: outbox, closed: closed },
  };
  assert_eq(got.outbox, [bad("a request line is `METHOD TARGET VERSION`")]);
  assert_eq(got.closed, 1)
}

test "a peer that says nothing gets a 400 rather than a hung thread" {
  let outbox = handle {
    serve_one(3)
  } with {
    var inbox = [],
    var outbox = [],
    net.recv[conn](c, max, timeout_ms) -> {
      let queued = inbox;
      inbox = later_chunks(queued);
      Some(first_chunk(queued))
    },
    net.send[conn](c, payload, timeout_ms) -> {
      outbox = outbox.push(payload);
      Some(payload.len())
    },
    net.close[conn](c) -> (),
    return u -> outbox,
  };
  assert_eq(outbox, [bad("the request head never ended")])
}

test "a head that never ends stops after `max_chunks` and gets a 400 response" {
  let got = handle {
    serve_one(3)
  } with {
    var reads = 0,
    var outbox = [],
    net.recv[conn](c, max, timeout_ms) -> {
      reads = reads + 1;
      Some(b"Filler: xxxxxxxx\r\n")
    },
    net.send[conn](c, payload, timeout_ms) -> {
      outbox = outbox.push(payload);
      Some(payload.len())
    },
    net.close[conn](c) -> (),
    return u -> { reads: reads, outbox: outbox },
  };
  assert_eq(got.reads, max_chunks());
  assert_eq(got.outbox, [bad("the request head never ended")])
}

test "each accepted connection gets exactly one response" {
  let outbox = handle {
    assert_eq(listen_and_serve(0, 3), 3)
  } with {
    var outbox = [],
    net.listen[listener](p) -> 1,
    net.accept[listener](l) -> 7,
    net.close[listener](l) -> (),
    net.recv[conn](c, max, timeout_ms) -> Some(get_root()),
    net.send[conn](c, payload, timeout_ms) -> {
      outbox = outbox.push(payload);
      Some(payload.len())
    },
    net.close[conn](c) -> (),
    return u -> outbox,
  };
  assert_eq(outbox, [ok(), ok(), ok()])
}

test "serving no connections opens a listener and touches no socket" {
  handle {
    assert_eq(listen_and_serve(0, 0), 0)
  } with {
    net.listen[listener](p) -> 1,
    net.accept[listener](l) -> panic("nothing should be accepted"),
    net.close[listener](l) -> (),
    net.recv[conn](c, max, timeout_ms) -> panic("nothing should be read"),
    net.send[conn](c, payload, timeout_ms) -> panic("nothing should be sent"),
    net.close[conn](c) -> panic("nothing should be closed"),
  }
}

test "settings choose the port and the connection count, and an unset setting uses its default" {
  let given = config::values(
    [{ key: "HELLO_PORT", value: "8081" }, { key: "HELLO_CONNECTIONS", value: "1" }],
    [],
  );
  handle {
    assert_eq(port(), 8081);
    assert_eq(connections(), 1)
  } with {
    config.get[server](key) -> config::get_value(given, key),
  };
  handle {
    assert_eq(port(), 8080);
    assert_eq(connections(), 64)
  } with {
    config.get[server](key) -> config::get_value(config::no_values(), key),
  }
}

test "a setting is read as digits and nothing else" {
  assert_eq(whole("8081"), Some(8081));
  assert_eq(whole("0"), Some(0));
  assert_eq(whole(""), None);
  assert_eq(whole("-1"), None);
  assert_eq(whole("80 "), None);
  assert_eq(whole("8.5"), None);
  assert_eq(whole("eighty"), None)
}
