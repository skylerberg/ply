import std.gen
import std.gen (Gen)

type Kind = | Asset | Liability | Equity | Revenue | Expense

pub type Account = { code: String, kind: Kind }

pub opaque type Posting = new { account: String, amount: Int }

pub type Entry = { date: Int, memo: String, postings: List<Posting> }

type Balance = | Balanced | Off(Int)

type Posted = | Accepted(List<Entry>) | Rejected(Int)

fn debit(account: String, amount: Int) -> Posting
  requires amount > 0
  ensures result.account == account
  ensures result.amount == amount
= { account: account, amount: amount }

fn credit(account: String, amount: Int) -> Posting
  requires amount > 0
  ensures result.account == account
  ensures result.amount == -amount
= { account: account, amount: -amount }

fn entry(date: Int, memo: String, postings: List<Posting>) -> Entry =
  { date: date, memo: memo, postings: postings }

fn transfer(date: Int, memo: String, from: String, to: String, amount: Int) -> Entry
  requires amount > 0
  requires from != to
  ensures result.date == date
  ensures result.memo == memo
= entry(date, memo, [debit(to, amount), credit(from, amount)])

fn sum_postings(ps: List<Posting>) -> Int =
  match ps { [p, ..rest] -> p.amount + sum_postings(rest), _ -> 0 }

fn check(e: Entry) -> Balance = match sum_postings(e.postings) { 0 -> Balanced, off -> Off(off) }

fn is_balanced(e: Entry) -> Bool = match check(e) { Balanced -> true, Off(_) -> false }

fn post(ledger: List<Entry>, e: Entry) -> Posted =
  match check(e) { Balanced -> Accepted(ledger.push(e)), Off(off) -> Rejected(off) }

fn mentions(ps: List<Posting>, account: String) -> Bool =
  ps.filter(|p: Posting| p.account == account).len() > 0

fn account_total(ps: List<Posting>, account: String) -> Int =
  ps.fold(0, |accumulator, p: Posting|
    if p.account == account { accumulator + p.amount } else { accumulator })

fn balance(ledger: List<Entry>, account: String) -> Int =
  match ledger {
    [e, ..rest] -> account_total(e.postings, account) + balance(rest, account),
    _ -> 0,
  }

fn trial_balance(ledger: List<Entry>) -> Int =
  ledger.fold(0, |accumulator, e: Entry| accumulator + sum_postings(e.postings))

fn kind_of(chart_of_accounts: List<Account>, code: String) -> Option<Kind> =
  match chart_of_accounts {
    [a, ..rest] -> if a.code == code { Some(a.kind) } else { kind_of(rest, code) },
    _ -> None,
  }

fn normal_sign(kind: Kind) -> Int
  ensures result == 1 || result == -1
= match kind { Asset -> 1, Expense -> 1, Liability -> -1, Equity -> -1, Revenue -> -1 }

pub fn reported_balance(
  chart_of_accounts: List<Account>,
  ledger: List<Entry>,
  code: String,
) -> Option<Int> =
  match kind_of(chart_of_accounts, code) {
    Some(kind) -> Some(normal_sign(kind) * balance(ledger, code)),
    None -> None,
  }

fn touching(ledger: List<Entry>, account: String) -> List<Entry> =
  ledger.filter(|e: Entry| account_total(e.postings, account) != 0)

fn memos(ledger: List<Entry>) -> List<String> = ledger.map(|e: Entry| e.memo)

fn running_from(ledger: List<Entry>, account: String, opening: Int, seen: List<Int>) -> List<Int> =
  match ledger {
    [e, ..rest] -> {
      let next = opening + account_total(e.postings, account);
      running_from(rest, account, next, seen.push(next))
    },
    _ -> seen,
  }

fn running(ledger: List<Entry>, account: String) -> List<Int> = running_from(ledger, account, 0, [])

pub fn chart_of_accounts() -> List<Account> =
  [
    { code: "cash", kind: Asset },
    { code: "receivable", kind: Asset },
    { code: "loan", kind: Liability },
    { code: "capital", kind: Equity },
    { code: "sales", kind: Revenue },
    { code: "rent", kind: Expense },
  ]

pub const journal: List<Entry> =
  [
    transfer(20260104, "seed capital", "capital", "cash", 500000),
    transfer(20260111, "january rent", "cash", "rent", 120000),
    entry(20260118, "invoice #1", [debit("receivable", 90000), credit("sales", 90000)]),
    transfer(20260125, "invoice #1 paid", "receivable", "cash", 90000),
  ]

law "a debit and a credit of one amount cancel"
  forall (account: String, amount: Int) where amount > 0 {
    debit(account, amount).amount + credit(account, amount).amount == 0
  }

law "`normal_sign` returns 1 for asset and expense accounts and a different value for every other kind"
  forall (kind: Kind) {
    normal_sign(kind) == 1 == (kind == Asset || kind == Expense)
  }

law "the postings of a `transfer` sum to zero"
  forall (from: String, to: String, amount: Int) where amount > 0 && from != to {
    sum_postings(transfer(20260101, "recorded", from, to, amount).postings) == 0
  }

law "posting a balanced entry is accepted, and the journal gains exactly that entry"
  forall (from: String, to: String, amount: Int) where amount > 0 && from != to {
    let e = transfer(20260101, "recorded", from, to, amount);
    post(journal, e) == Accepted(journal.push(e))
  }

fn amounts() -> Gen<Int> = gen::int_between(1, 1000000)

fn transfers() -> Gen<Entry> =
  gen::map3(
    gen::elements(["cash", "receivable", "rent"]),
    gen::elements(["capital", "loan", "sales"]),
    amounts(),
    |from: String, to: String, amount: Int| transfer(20260101, "recorded", from, to, amount),
  )

test "`kind_of` returns a kind for a code exactly when the chart of accounts contains that code" {
  let accounts = gen::map2(
    gen::elements(["cash", "loan", "sales"]),
    gen::elements([Asset, Liability, Revenue]),
    |code: String, kind: Kind| { code: code, kind: kind },
  );
  gen::check2(
    gen::list_of(accounts, 4),
    gen::elements(["cash", "loan", "sales", "goodwill"]),
    |chart_of_accounts: List<Account>, code: String|
      kind_of(chart_of_accounts, code) == None
        == (chart_of_accounts.filter(|a: Account| a.code == code).len() == 0),
  )
}

test "`balance` is zero for an account that no entry in a generated ledger mentions" {
  gen::check2(
    gen::list_of(transfers(), 6),
    gen::elements(["cash", "loan", "goodwill"]),
    |ledger: List<Entry>, account: String|
      ledger.filter(|e: Entry| mentions(e.postings, account)).len() > 0
        || balance(ledger, account) == 0,
  )
}

test "no run of transfers can unbalance a journal" {
  gen::check(gen::list_of(transfers(), 12), |ledger: List<Entry>| trial_balance(ledger) == 0)
}

test "`post` rejects an entry that does not balance and returns the amount it is off by" {
  gen::check(amounts(), |amount: Int|
    post([], entry(20260101, "typo", [debit("cash", amount)])) == Rejected(amount))
}

test "a transfer moves one amount between two accounts" {
  let e = transfer(20260104, "seed capital", "capital", "cash", 500000);
  assert_eq(e.postings.len(), 2);
  assert_eq(account_total(e.postings, "cash"), 500000);
  assert_eq(account_total(e.postings, "capital"), -500000)
}

test "debit and credit are mirror images" {
  assert_eq(debit("cash", 250).amount, 250);
  assert_eq(credit("cash", 250).amount, -250);
  assert_eq(sum_postings([debit("cash", 250), credit("cash", 250)]), 0)
}

test "a balanced entry reports Balanced" {
  assert_eq(check(transfer(20260104, "seed", "capital", "cash", 1)), Balanced);
  assert(is_balanced(transfer(20260104, "seed", "capital", "cash", 1)))
}

test "an unbalanced entry says how far off it is" {
  let lopsided = entry(20260104, "typo", [debit("cash", 500000), credit("capital", 499000)]);
  assert_eq(check(lopsided), Off(1000));
  assert(!is_balanced(lopsided))
}

test "posting accepts a balanced entry" {
  let e = transfer(20260201, "february rent", "cash", "rent", 120000);
  match post([], e) {
    Accepted(ledger) -> assert_eq(ledger.len(), 1),
    Rejected(off) -> panic("balanced entry rejected, off by " ++ off.to_string()),
  }
}

test "posting rejects an unbalanced entry and leaves the ledger alone" {
  let e = entry(20260201, "typo", [debit("cash", 10), credit("capital", 9)]);
  match post(journal, e) {
    Accepted(_) -> panic("an unbalanced entry was posted"),
    Rejected(off) -> assert_eq(off, 1),
  }
}

test "a balance sums every posting that names the account" {
  assert_eq(balance(journal, "cash"), 470000);
  assert_eq(balance(journal, "rent"), 120000);
  assert_eq(balance(journal, "sales"), -90000);
  assert_eq(balance(journal, "receivable"), 0)
}

test "`balance` is zero for an account with no postings and for an empty ledger" {
  assert_eq(balance(journal, "goodwill"), 0);
  assert_eq(balance([], "cash"), 0)
}

test "every entry balances, so the whole journal balances" {
  assert_eq(trial_balance(journal), 0);
  assert_eq(journal.filter(|e: Entry| !is_balanced(e)).len(), 0)
}

test "`reported_balance` shows debit accounts as stored and negates credit accounts such as sales and capital" {
  assert_eq(reported_balance(chart_of_accounts(), journal, "cash"), Some(470000));
  assert_eq(reported_balance(chart_of_accounts(), journal, "sales"), Some(90000));
  assert_eq(reported_balance(chart_of_accounts(), journal, "rent"), Some(120000));
  assert_eq(reported_balance(chart_of_accounts(), journal, "capital"), Some(500000))
}

test "`reported_balance` returns `None` for an account missing from the chart of accounts, and `kind_of` finds only listed accounts" {
  assert_eq(reported_balance(chart_of_accounts(), journal, "goodwill"), None);
  assert_eq(kind_of(chart_of_accounts(), "loan"), Some(Liability));
  assert_eq(kind_of([], "cash"), None)
}

test "only the entries that move an account are selected" {
  assert_eq(touching(journal, "cash").len(), 3);
  assert_eq(touching(journal, "sales").len(), 1);
  assert_eq(touching(journal, "goodwill").len(), 0);
  assert_eq(memos(touching(journal, "sales")), ["invoice #1"])
}

test "the running balance walks the journal in order" {
  assert_eq(running(journal, "cash"), [500000, 380000, 380000, 470000]);
  assert_eq(running([], "cash"), []);
  assert_eq(running(journal, "cash").len(), journal.len())
}

test "memos come back in the order they were posted" {
  assert_eq(memos(journal), ["seed capital", "january rent", "invoice #1", "invoice #1 paid"])
}

test "posting the journal's entries one at a time gives four entries, the same cash balance as the journal, and a trial balance of 0" {
  let built = journal.fold([], |accumulator, e: Entry|
    match post(accumulator, e) { Accepted(next) -> next, Rejected(_) -> accumulator });
  assert_eq(built.len(), 4);
  assert_eq(balance(built, "cash"), balance(journal, "cash"));
  assert_eq(trial_balance(built), 0)
}
