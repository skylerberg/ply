// The smallest program that uses every operation of `std.net`, and the only
// user of `std.net`'s `drain`.
//
// `hello.ply` is the endpoint; this is the demonstration that the effect is
// importable and that a program written against it is ordinary code. It shipped
// inside the declaration file in W1, which was the wrong place: a module that
// declares a boundary should not also hold a program that crosses it.
//
// It declares no `main`. The two that do are `examples/hello.ply` and
// `examples/desk.ply`, and each is run by naming its file.

import std.net (net, drain, send_all)

fn greeting() -> Bytes = b"HTTP/1.1 200 OK\r\ncontent-length: 3\r\n\r\nply"

// Every `net` operation that can block now carries a deadline, and it is an
// argument rather than a cancellation: a deadline is one `setsockopt` inside a
// job that already owns the socket, where a cancel path would need a token
// registry and a race between the cancel and the completion. Being made to write
// the number down is the point — `timeout_ms <= 0` is a runtime error, so a
// caller that wants no deadline writes a large one where a reader can see it.
fn deadline_ms() -> Int = 5000

// Accept one connection, read until the peer stops talking, answer, and close.
// The row is inferred and checked against the annotation: this cannot touch a
// socket it did not name.
//
// `send_all` rather than `send`: one `send` is free to take fewer bytes than it
// was given, and a short write nobody looked at is a truncated response the
// client reads as a complete one. `false` is a deadline or a dead peer.
pub fn serve_once(port: Int) -> Int / {net.write[listener], net.write[conn]} = {
  let l = net.listen[listener](port);
  let c = net.accept[listener](l);
  let request = drain(c, b"", deadline_ms());
  let sent = send_all(c, greeting(), deadline_ms());
  net.close[conn](c);
  net.close[listener](l);
  if sent { bytes_len(request) + bytes_len(greeting()) } else { 0 }
}

fn first_chunk(queued: List<Bytes>) -> Bytes =
  match queued {
    [first, ..] -> first,
    _ -> b"",
  }

fn later_chunks(queued: List<Bytes>) -> List<Bytes> =
  match queued {
    [_, ..rest] -> rest,
    _ -> [],
  }

// `det` and cacheable, over an in-memory socket. The handlers discharge every
// `net` atom this code can perform, which is the only reason a test over a
// `nondet` effect compiles at all: leave one out and it is `E0412` rather than
// a flake.
test "the imported effect drives a whole connection over an in-memory socket" {
  with_cell[inbox]([b"GET /", b" HTTP/1.1\r\n\r\n"]) { inbox -> {
  with_cell[outbox]([]) { outbox -> {
    handle {
      assert_eq(serve_once(0), 18 + bytes_len(greeting()))
    } with {
      net.listen[listener](p) -> 1,
      net.accept[listener](l) -> 7,
      net.close[listener](l) -> (),
      net.recv[conn](c, max, timeout_ms) -> {
        let queued = cell_get(inbox);
        cell_set(inbox, later_chunks(queued));
        Some(first_chunk(queued))
      },
      net.send[conn](c, payload, timeout_ms) -> {
        cell_set(outbox, push(cell_get(outbox), payload));
        Some(bytes_len(payload))
      },
      net.close[conn](c) -> (),
    };
    assert_eq(cell_get(outbox), [greeting()]);
    assert_eq(cell_get(inbox), [])
  } }
  } }
}

// `drain` stops at the first empty answer, which is EOF, rather than at a
// short one: TCP preserves the byte stream and not the boundaries a peer wrote
// it in, so a short `recv` says nothing about whether more is coming.
test "drain reads to end of stream rather than to the first short chunk" {
  with_cell[inbox]([b"a", b"bc", b"", b"never read"]) { inbox -> {
    handle {
      assert_eq(drain(3, b"", deadline_ms()), b"abc")
    } with {
      net.recv[conn](c, max, timeout_ms) -> {
        let queued = cell_get(inbox);
        cell_set(inbox, later_chunks(queued));
        Some(first_chunk(queued))
      },
    };
    assert_eq(cell_get(inbox), [b"never read"])
  } }
}
