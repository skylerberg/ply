import std.net (net, drain, send_all)

const greeting: Bytes = b"HTTP/1.1 200 OK\r\ncontent-length: 3\r\n\r\nply"

const deadline_ms: Int = 5000

pub fn serve_once(
  port: Int,
) -> Int / {net.close[conn], net.recv[conn], net.send[conn], net.accept[listener], net.close[listener], net.listen[listener], abort.raise, diverges} = {
  let l = net.listen[listener](port);
  let c = net.accept[listener](l);
  let request = drain[conn](c, b"", deadline_ms);
  let sent = send_all[conn](c, greeting, deadline_ms);
  net.close[conn](c);
  net.close[listener](l);
  if sent { request.len() + greeting.len() } else { 0 }
}

fn first_chunk(queued: List<Bytes>) -> Bytes = match queued { [first, ..] -> first, _ -> b"" }

fn later_chunks(queued: List<Bytes>) -> List<Bytes> = match queued { [_, ..rest] -> rest, _ -> [] }

test "the imported effect drives a whole connection over an in-memory socket" {
  let got = handle {
    assert_eq(serve_once(0), 18 + greeting.len())
  } with {
    var inbox = [b"GET /", b" HTTP/1.1\r\n\r\n"],
    var outbox = [],
    net.listen[listener](p) -> 1,
    net.accept[listener](l) -> 7,
    net.close[listener](l) -> (),
    net.recv[conn](c, max, timeout_ms) -> {
      let queued = inbox;
      inbox = later_chunks(queued);
      Some(first_chunk(queued))
    },
    net.send[conn](c, payload, timeout_ms) -> {
      outbox = outbox.push(payload);
      Some(payload.len())
    },
    net.close[conn](c) -> (),
    return u -> { inbox: inbox, outbox: outbox },
  };
  assert_eq(got.outbox, [greeting]);
  assert_eq(got.inbox, [])
}

test "drain reads to end of stream rather than to the first short chunk" {
  let inbox = handle {
    assert_eq(drain[conn](3, b"", deadline_ms), b"abc")
  } with {
    var inbox = [b"a", b"bc", b"", b"never read"],
    net.recv[conn](c, max, timeout_ms) -> {
      let queued = inbox;
      inbox = later_chunks(queued);
      Some(first_chunk(queued))
    },
    return u -> inbox,
  };
  assert_eq(inbox, [b"never read"])
}
