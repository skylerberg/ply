effect shard {
  read take[r]() -> List<Int>
  write done[r](rows: List<Int>) -> Unit
  write add[r](rows: List<Int>) -> Unit
}

fn compact(rows: List<Int>) -> List<Int> = rows.filter(|v: Int| v != 0)

fn scale(rows: List<Int>, k: Int) -> List<Int> = rows.map(|v: Int| v * k)

fn concat(xs: List<Int>, ys: List<Int>) -> List<Int> =
  ys.fold(xs, |accumulator, v: Int| accumulator.push(v))

fn sum(rows: List<Int>) -> Int = rows.fold(0, |accumulator, v: Int| accumulator + v)

fn north_rows() -> List<Int> = [1, 0, 2]

fn south_rows() -> List<Int> = [3, 0, 4]

fn east_rows() -> List<Int> = [5, 0, 6]

fn drain_north() -> Int / {shard.take[north], shard.done[north], task.yield} = {
  let compacted = compact(shard.take[north]());
  task.yield();
  shard.done[north](scale(compacted, 2));
  compacted.len()
}

fn drain_south() -> Int / {shard.take[south], shard.done[south], task.yield} = {
  let compacted = compact(shard.take[south]());
  task.yield();
  shard.done[south](scale(compacted, 2));
  compacted.len()
}

fn drain_east() -> Int / {shard.take[east], shard.done[east], task.yield} = {
  let compacted = compact(shard.take[east]());
  task.yield();
  shard.done[east](scale(compacted, 2));
  compacted.len()
}

fn merge_north() -> Int / {shard.take[north], shard.add[merged], task.yield} = {
  let compacted = compact(shard.take[north]());
  task.yield();
  shard.add[merged](compacted);
  compacted.len()
}

fn merge_south() -> Int / {shard.take[south], shard.add[merged], task.yield} = {
  let compacted = compact(shard.take[south]());
  task.yield();
  shard.add[merged](compacted);
  compacted.len()
}

test "three tasks that each empty their own shard leave rows [2, 4], [6, 8] and [10, 12] in the shards, and their results sum to 6" {
  let got = handle {
    simulate {
      let a = task.spawn(|| drain_north());
      let b = task.spawn(|| drain_south());
      let c = task.spawn(|| drain_east());
      assert_eq(task.join(a) + task.join(b) + task.join(c), 6)
    }
  } with {
    var north = [],
    var south = [],
    var east = [],
    shard.take[north]() -> north_rows(),
    shard.done[north](rows) -> {
      north = rows;
    },
    shard.take[south]() -> south_rows(),
    shard.done[south](rows) -> {
      south = rows;
    },
    shard.take[east]() -> east_rows(),
    shard.done[east](rows) -> {
      east = rows;
    },
    return u -> { north: north, south: south, east: east },
  };
  assert_eq(got.north, [2, 4]);
  assert_eq(got.south, [6, 8]);
  assert_eq(got.east, [10, 12])
}

test "two tasks adding to one shared shard lose no rows, in whatever order the simulation runs them" {
  let merged = handle {
    simulate {
      let a = task.spawn(|| merge_north());
      let b = task.spawn(|| merge_south());
      assert_eq(task.join(a) + task.join(b), 4)
    }
  } with {
    var merged = [],
    shard.take[north]() -> north_rows(),
    shard.take[south]() -> south_rows(),
    shard.add[merged](rows) -> {
      merged = concat(merged, rows);
    },
    return u -> merged,
  };
  assert_eq(merged.len(), 4);
  assert_eq(sum(merged), 10)
}

test "`compact` removes zeros, `scale` multiplies each item, `concat` joins two lists and `sum` adds the items of a list" {
  assert_eq(compact([1, 0, 2, 0]), [1, 2]);
  assert_eq(scale([1, 2], 3), [3, 6]);
  assert_eq(concat([1], [2, 3]), [1, 2, 3]);
  assert_eq(sum([1, 2, 3]), 6);
  assert_eq(sum(concat(compact(north_rows()), compact(south_rows()))), 10)
}
