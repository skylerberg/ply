effect db {
  read all_users[table]() -> List<User>
  read all_orders[table]() -> List<Order>
  read all_items[table]() -> List<Item>
  write save_users[table](rows: List<User>) -> Unit
  write save_orders[table](rows: List<Order>) -> Unit
  write save_items[table](rows: List<Item>) -> Unit
}

type User = { id: Int, email: String, active: Bool }

type Item = { sku: String, price: Int, on_hand: Int }

type Order = { id: Int, user: Int, sku: String, qty: Int, paid: Bool }

fn line_total(price: Int, qty: Int) -> Int = price * qty

fn next_id(ids: List<Int>) -> Int =
  ids.fold(1, |accumulator, id| if id < accumulator { accumulator } else { id + 1 })

fn on_hand(shelf: List<Item>, sku: String) -> Int =
  shelf.fold(0, |accumulator, i: Item|
    if i.sku == sku { accumulator + i.on_hand } else { accumulator })

fn price_of(shelf: List<Item>, sku: String) -> Int =
  shelf.fold(0, |accumulator, i: Item| if i.sku == sku { i.price } else { accumulator })

fn shelved(i: Item, on_hand: Int) -> Item = { sku: i.sku, price: i.price, on_hand: on_hand }

fn disabled(u: User) -> User = { id: u.id, email: u.email, active: false }

fn resolved(o: Order) -> Order = { id: o.id, user: o.user, sku: o.sku, qty: o.qty, paid: true }

fn draw_down(shelf: List<Item>, sku: String, qty: Int) -> List<Item> =
  shelf.map(|i: Item| if i.sku == sku { shelved(i, i.on_hand - qty) } else { i })

fn active_users() -> List<User> / {db.all_users[users]} =
  db.all_users[users]().filter(|u: User| u.active)

fn user_count() -> Int / {db.all_users[users]} = db.all_users[users]().len()

fn open_orders() -> List<Order> / {db.all_orders[orders]} =
  db.all_orders[orders]().filter(|o: Order| !o.paid)

fn stock(sku: String) -> Int / {db.all_items[inventory]} = on_hand(db.all_items[inventory](), sku)

fn revenue() -> Int / {db.all_orders[orders], db.all_items[inventory]} =
  db.all_orders[orders]().fold(0, |accumulator, o: Order|
    if o.paid { accumulator + line_total(price_of(db.all_items[inventory](), o.sku), o.qty) }
    else { accumulator })

fn backordered() -> List<Order> / {db.all_orders[orders], db.all_items[inventory]} =
  open_orders().filter(|o: Order| stock(o.sku) < o.qty)

fn row_count(
  table: String,
) -> Int / {db.all_users[users], db.all_orders[orders], db.all_items[inventory]} =
  if table == "users" { db.all_users[users]().len() }
  else if table == "orders" { db.all_orders[orders]().len() }
  else { db.all_items[inventory]().len() }

fn add_user(email: String) -> Int / {db.all_users[users], db.save_users[users]} = {
  if email == "" { 0 } else {
    let rows = db.all_users[users]();
    let id = next_id(rows.map(|u: User| u.id));
    db.save_users[users](rows.push({ id: id, email: email, active: true }));
    id
  }
}

fn deactivate(id: Int) -> Bool / {db.all_users[users], db.save_users[users]} = {
  if id <= 0 { false } else {
    let rows = db.all_users[users]();
    if rows.filter(|u: User| u.id == id && u.active).len() == 0 { false } else {
      db.save_users[users](rows.map(|u: User| if u.id == id { disabled(u) } else { u }));
      true
    }
  }
}

fn restock(sku: String, qty: Int) -> Unit / {db.all_items[inventory], db.save_items[inventory]} = {
  if qty <= 0 { () } else {
    let shelf = db.all_items[inventory]();
    db.save_items[inventory](
      shelf.map(|i: Item| if i.sku == sku { shelved(i, i.on_hand + qty) } else { i }),
    )
  }
}

fn reserve(sku: String, qty: Int) -> Bool / {db.all_items[inventory], db.save_items[inventory]} = {
  if qty <= 0 { false }
  else if stock(sku) < qty { false } else {
    db.save_items[inventory](draw_down(db.all_items[inventory](), sku, qty));
    true
  }
}

fn mark_paid(id: Int) -> Bool / {db.all_orders[orders], db.save_orders[orders]} = {
  let rows = db.all_orders[orders]();
  if rows.filter(|o: Order| o.id == id && !o.paid).len() == 0 { false } else {
    db.save_orders[orders](rows.map(|o: Order| if o.id == id { resolved(o) } else { o }));
    true
  }
}

fn archive_paid() -> Int / {db.all_orders[orders], db.save_orders[orders]} = {
  let rows = db.all_orders[orders]();
  let keep = rows.filter(|o: Order| !o.paid);
  if keep.len() == rows.len() { 0 } else {
    db.save_orders[orders](keep);
    rows.len() - keep.len()
  }
}

fn place_order(
  user: Int,
  sku: String,
  qty: Int,
) -> Bool / {db.all_users[users], db.all_orders[orders], db.all_items[inventory], db.save_orders[orders], db.save_items[inventory]} = {
  if qty <= 0 { false }
  else if db.all_users[users]().filter(|u: User| u.id == user && u.active).len() == 0 { false }
  else if stock(sku) < qty { false } else {
    db.save_items[inventory](draw_down(db.all_items[inventory](), sku, qty));
    let rows = db.all_orders[orders]();
    let id = next_id(rows.map(|o: Order| o.id));
    db.save_orders[orders](rows.push({ id: id, user: user, sku: sku, qty: qty, paid: false }));
    true
  }
}

const seed_users: List<User> =
  [
    { id: 1, email: "ada@example.com", active: true },
    { id: 2, email: "grace@example.com", active: true },
    { id: 3, email: "alan@example.com", active: false },
  ]

const seed_orders: List<Order> =
  [
    { id: 1, user: 1, sku: "widget", qty: 2, paid: true },
    { id: 2, user: 2, sku: "widget", qty: 4, paid: false },
    { id: 3, user: 1, sku: "gasket", qty: 1, paid: false },
  ]

const seed_shelf: List<Item> =
  [{ sku: "widget", price: 250, on_hand: 10 }, { sku: "gasket", price: 90, on_hand: 0 }]

test "a line total is price times quantity" {
  assert_eq(line_total(250, 4), 1000);
  assert_eq(line_total(250, 0), 0)
}

test "the next id follows the largest one already taken" {
  assert_eq(next_id([]), 1);
  assert_eq(next_id([1, 2, 3]), 4);
  assert_eq(next_id([9, 2]), 10)
}

test "`draw_down` reduces the stock of only the item with the matching sku" {
  let after = draw_down(seed_shelf, "widget", 4);
  assert_eq(on_hand(after, "widget"), 6);
  assert_eq(on_hand(after, "gasket"), 0);
  assert_eq(after.len(), 2)
}

test "the row helpers change one field and keep the rest" {
  assert_eq(disabled({ id: 7, email: "ada@example.com", active: true }).active, false);
  assert_eq(disabled({ id: 7, email: "ada@example.com", active: true }).email, "ada@example.com");
  assert_eq(resolved({ id: 1, user: 1, sku: "widget", qty: 2, paid: false }).paid, true);
  assert_eq(shelved({ sku: "widget", price: 250, on_hand: 10 }, 3).price, 250)
}

test "active users exclude the deactivated ones" {
  handle {
    assert_eq(active_users().len(), 2);
    assert_eq(user_count(), 3)
  } with {
    db.all_users[users]() -> seed_users,
  }
}

test "open orders are the unpaid ones, oldest first" {
  handle {
    assert_eq(open_orders().map(|o: Order| o.id), [2, 3])
  } with {
    db.all_orders[orders]() -> seed_orders,
  }
}

test "`revenue` totals the paid orders at the prices in the inventory" {
  handle {
    assert_eq(revenue(), 500)
  } with {
    db.all_orders[orders]() -> seed_orders,
    db.all_items[inventory]() -> seed_shelf,
  }
}

test "a backorder is an open order whose quantity is more than the inventory's stock" {
  handle {
    assert_eq(backordered().map(|o: Order| o.sku), ["gasket"])
  } with {
    db.all_orders[orders]() -> seed_orders,
    db.all_items[inventory]() -> seed_shelf,
  }
}

test "adding a user assigns the next free id" {
  handle {
    assert_eq(add_user("hedy@example.com"), 4);
    assert_eq(user_count(), 4)
  } with {
    var table = seed_users,
    db.all_users[users]() -> table,
    db.save_users[users](rows) -> {
      table = rows;
    },
  }
}

test "`deactivate` marks a user inactive once, and a second call returns false" {
  handle {
    assert(deactivate(2));
    assert_eq(active_users().len(), 1);
    assert(!deactivate(2))
  } with {
    var table = seed_users,
    db.all_users[users]() -> table,
    db.save_users[users](rows) -> {
      table = rows;
    },
  }
}

test "`restock` adds the quantity to the named item and leaves other items unchanged" {
  handle {
    restock("gasket", 12);
    assert_eq(stock("gasket"), 12);
    assert_eq(stock("widget"), 10)
  } with {
    var shelf = seed_shelf,
    db.all_items[inventory]() -> shelf,
    db.save_items[inventory](rows) -> {
      shelf = rows;
    },
  }
}

test "`reserve` reduces an item's stock by exactly the quantity reserved" {
  handle {
    assert(reserve("widget", 4));
    assert_eq(stock("widget"), 6);
    assert(reserve("widget", 6));
    assert_eq(stock("widget"), 0)
  } with {
    var shelf = seed_shelf,
    db.all_items[inventory]() -> shelf,
    db.save_items[inventory](rows) -> {
      shelf = rows;
    },
  }
}

test "`mark_paid` changes only the named order and leaves the other orders unchanged" {
  handle {
    assert(mark_paid(2));
    assert_eq(open_orders().map(|o: Order| o.id), [3])
  } with {
    var table = seed_orders,
    db.all_orders[orders]() -> table,
    db.save_orders[orders](rows) -> {
      table = rows;
    },
  }
}

test "archiving drops exactly the paid orders" {
  handle {
    assert_eq(archive_paid(), 1);
    assert_eq(open_orders().len(), 2);
    assert_eq(archive_paid(), 0)
  } with {
    var table = seed_orders,
    db.all_orders[orders]() -> table,
    db.save_orders[orders](rows) -> {
      table = rows;
    },
  }
}

test "`place_order` saves the new order and the reduced stock together" {
  handle {
    assert(place_order(1, "widget", 3));
    assert_eq(stock("widget"), 7);
    assert_eq(open_orders().len(), 3)
  } with {
    var users = seed_users,
    var orders = seed_orders,
    var shelf = seed_shelf,
    db.all_users[users]() -> users,
    db.save_users[users](rows) -> {
      users = rows;
    },
    db.all_orders[orders]() -> orders,
    db.save_orders[orders](rows) -> {
      orders = rows;
    },
    db.all_items[inventory]() -> shelf,
    db.save_items[inventory](rows) -> {
      shelf = rows;
    },
  }
}

test "`reserve` for more than the item's stock returns false and saves nothing" {
  handle { assert(!reserve("gasket", 5)) } with { db.all_items[inventory]() -> seed_shelf }
}

test "`deactivate` for a user that does not exist returns false and saves nothing" {
  handle { assert(!deactivate(99)) } with { db.all_users[users]() -> seed_users }
}

test "marking an unknown order paid writes nothing" {
  handle {
    assert(!mark_paid(99));
    assert(!mark_paid(1))
  } with {
    db.all_orders[orders]() -> seed_orders,
  }
}

test "`archive_paid` saves nothing when no order is paid" {
  handle {
    assert_eq(archive_paid(), 0)
  } with {
    db.all_orders[orders]() -> seed_orders.filter(|o: Order| !o.paid),
  }
}

test "a non-positive quantity is rejected before any table is opened" {
  assert(!reserve("widget", 0));
  assert(!reserve("widget", -1))
}

test "`place_order` for a user that does not exist fails after looking up the user, before using any other table" {
  handle { assert(!place_order(99, "widget", 1)) } with { db.all_users[users]() -> seed_users }
}

test "`place_order` for more than the stock fails without writing to the orders table" {
  handle {
    assert(!place_order(1, "gasket", 5))
  } with {
    db.all_users[users]() -> seed_users,
    db.all_items[inventory]() -> seed_shelf,
  }
}

test "`row_count` for users uses only the users table, not the orders or inventory tables" {
  handle { assert_eq(row_count("users"), 3) } with { db.all_users[users]() -> seed_users }
}

test "`row_count` for orders uses only the orders table, not the users or inventory tables" {
  handle { assert_eq(row_count("orders"), 3) } with { db.all_orders[orders]() -> seed_orders }
}
