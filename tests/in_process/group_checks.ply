import harness (shipped_sources, Shipped)
import compiler.check.resolve.tables (Source)
import compiler.front.checking.code_edits (lowered_over_shipped)
import std.list
import std.string

type File = { name: String, bytes: Bytes }

fn sources_of(files: List<File>) -> List<Source> / {abort.raise} =
  files.filter(|f: File|
    f.name.ends_with(".ply") && !f.name.contains("/") && f.name != "ply.pkg").map(|f: File|
    { name: Bytes::of_string(f.name.slice(0, f.name.len() - 4)), source_text: f.bytes })

test "a real package lowers one unit at a time" {
  let shipped = shipped_sources().map(|s: { path: String, text: String }|
    {
      name: Bytes::of_string(s.path.slice(0, s.path.len() - 4)),
      source_text: Bytes::of_string(s.text),
    });
  assert(lowered_over_shipped(sources_of(embed_dir("../../packages/sim")), shipped).len() > 0, None)
}
