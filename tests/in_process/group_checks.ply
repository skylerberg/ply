import harness (shipped_sources, Shipped)
import compiler.check.resolve.tables (Source)
import compiler.front.checking.world (CheckQuery)
import compiler.front.checking (check_under, fresh_registry, nothing_derived, prelude_pack,
                                registry_checking_alone)
import compiler.store.memo
import compiler.store.memo (empty_memory_store, MemoryStore)
import std.bin
import std.list
import std.string

type File = { name: String, bytes: Bytes }

fn sources_of(files: List<File>) -> List<Source> / {abort.raise} =
  files.filter(|f: File|
    f.name.ends_with(".ply") && !f.name.contains("/") && f.name != "ply.pkg").map(|f: File|
    { name: Bytes::of_string(f.name.slice(0, f.name.len() - 4)), source_text: f.bytes })

fn reads_of(record: memo::FactRecord) -> List<Bytes> / {abort.raise} =
  record.reads.map(|r: memo::Dependency| bin::encode(r, memo::dependency_bin())).sort().unique()

fn facts_apart(batched: MemoryStore, alone: MemoryStore) -> List<Bytes> / {abort.raise} = {
  let there = memo::fact_records(alone);
  memo::fact_records(batched).fold(
    [],
    |found: List<Bytes>, key: Bytes, record: memo::FactRecord|
      match there.get(key) {
        Some(same) -> if same.output == record.output && reads_of(same) == reads_of(record) {
          found
        } else { found.push(record.query) },
        None -> found,
      },
  ).unique(
  )
}

fn both_ways_agree(files: List<File>) -> Unit / {Shipped, abort.raise} = {
  let sources = sources_of(files);
  let shipped = shipped_sources().map(|s: { path: String, text: String }|
    {
      name: Bytes::of_string(s.path.slice(0, s.path.len() - 4)),
      source_text: Bytes::of_string(s.text),
    });
  let checked = |qs: Map<Bytes, CheckQuery>|
    check_under(qs, empty_memory_store(), prelude_pack(), sources, shipped, nothing_derived).store;
  assert_eq(facts_apart(checked(fresh_registry()), checked(registry_checking_alone())), [])
}

test "a real package's facts are the same whether its groups are checked in a batch or alone" {
  both_ways_agree(embed_dir("../../packages/sim"))
}
