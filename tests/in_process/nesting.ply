import harness (shipped_dirs)
import std.fs (fs, Listed, Dir, File)
import std.list
import std.string
import cli.diagnostic (end_of_line)
import std.bytes (occurrences)

fn max_depth() -> Int = 32

fn without_literals(text: Bytes) -> Bytes / {abort.raise} =
  without_literals_from(text, 0, [], text.len() + 1)

fn without_literals_from(
  t: Bytes,
  i: Int,
  pieces: List<Bytes>,
  budget: Int,
) -> Bytes / {abort.raise} =
  if budget <= 0 { panic("more rounds than bytes") } else {
    let n = t.len();
    let stop = if i >= n { n } else { t.scan_until(i, b"/\\\"", n - i) };
    let so_far = pieces.push(t.slice(i, stop));
    if stop >= n { Bytes::concat_all(so_far) } else {
      let c = t.at(stop);
      let next = if stop + 1 < n { t.at(stop + 1) } else { -1 };
      if (c == 47 && next == 47) || (c == 92 && next == 92) {
        without_literals_from(t, end_of_line(t, stop), so_far, budget - 1)
      } else if c == 34 { without_literals_from(t, quote_end(t, stop + 1), so_far, budget - 1) }
      else { without_literals_from(t, stop + 1, so_far.push(t.slice(stop, stop + 1)), budget - 1) }
    }
  }

fn quote_end(t: Bytes, i: Int) -> Int / {abort.raise} =
  iterate(i, t.len() + 1, |j: Int|
    if j >= t.len() { Stop(j) }
    else if t.at(j) == 92 { Continue(j + 2) }
    else if t.at(j) == 34 { Stop(j + 1) }
    else { Continue(j + 1) })

fn depth(body: Bytes) -> Int / {abort.raise} = {
  let t = without_literals(body);
  let walked = range(0, t.len()).fold({ at: 0, most: 0 }, |s: { at: Int, most: Int }, i: Int| {
    let c = t.at(i);
    if c == 40 || c == 91 || c == 123 {
      { at: s.at + 1, most: if s.at + 1 > s.most { s.at + 1 } else { s.most } }
    } else if c == 41 || c == 93 || c == 125 { { ..s, at: if s.at > 0 { s.at - 1 } else { 0 } } }
    else { s }
  });
  walked.most + occurrences(t, b"?") + occurrences(t, b"else if")
}

fn item_heading(line: String) -> Option<String> / {abort.raise} = {
  let rest = if line.starts_with("pub ") { line.slice(4, line.len()) } else { line };
  ["fn", "type", "test"].fold(None, |found: Option<String>, word: String|
    match found {
      Some(_) -> found,
      None -> if rest.starts_with(word ++ " ") {
        Some(word ++ " " ++ item_name(rest.slice(word.len() + 1, rest.len())))
      } else { None },
    })
}

fn item_name(tail: String) -> String / {abort.raise} = {
  let b = Bytes::of_string(tail);
  let from = if b.len() > 0 && b.at(0) == 34 { 1 } else { 0 };
  let to = iterate(from, b.len() + 1, |j: Int|
    if j < b.len() && is_name_byte(b.at(j)) { Continue(j + 1) } else { Stop(j) });
  String::of_bytes(b.slice(from, to)).trim()
}

fn is_name_byte(c: Int) -> Bool =
  (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 || c == 32

type Item = { depth: Int, module: String, name: String }

fn items_of(module: String, text: String) -> List<Item> / {abort.raise} = {
  let lines = text.split("\n");
  let heads = range(0, lines.len()).filter(|i: Int|
    match lines.at(i) { Some(l) -> item_heading(l) != None, None -> false });
  range(0, heads.len()).map(|n: Int| {
    let i = match heads.at(n) { Some(x) -> x, None -> 0 };
    let end = match heads.at(n + 1) { Some(x) -> x, None -> lines.len() };
    let body = range(i, end).fold("", |accumulator: String, j: Int|
      accumulator ++ (match lines.at(j) { Some(l) -> l ++ "\n", None -> "" }));
    let name = match lines.at(i) {
      Some(l) -> match item_heading(l) { Some(n2) -> n2, None -> "" },
      None -> "",
    };
    { depth: depth(Bytes::of_string(body)), module: module, name: name }
  })
}

fn sources_below(dir: String) -> List<String> / {fs.list_dir[repo], abort.raise} =
  iterate({ work: [dir], found: [] }, 1000000, |s: { work: List<String>, found: List<String> }|
    match s.work {
      [] -> Stop(s.found),
      [d, ..rest] -> match fs.list_dir[repo](d) {
        None -> if d == dir { panic("`" ++ dir ++ "` is in the repository") }
        else { Continue({ ..s, work: rest }) },
        Some(listed) ->
          Continue(
            listed.fold(
              { ..s, work: rest },
              |accumulator: { work: List<String>, found: List<String> }, l: Listed|
                if l.name.starts_with(".") { accumulator } else {
                  let path = d ++ "/" ++ l.name;
                  match l.kind {
                    Dir -> { ..accumulator, work: accumulator.work.push(path) },
                    File -> if l.name.ends_with(".ply") {
                      { ..accumulator, found: accumulator.found.push(path) }
                    } else { accumulator },
                    _ -> accumulator,
                  }
                },
            ),
          ),
      },
    })

fn every_item() -> List<Item> / {fs.read[repo], abort.raise} =
  shipped_dirs().fold([], |accumulator: List<Item>, dir: String|
    sources_below(dir).fold(accumulator, |a: List<Item>, path: String|
      match fs.read_file[repo](path) {
        Some(text) -> a.concat(items_of(path, String::of_bytes(text))),
        None -> a,
      }))

fn item_text(item: Item) -> String =
  item.module ++ " " ++ item.name ++ " (" ++ item.depth.to_string() ++ ")"

test/nondet "no definition in the standard library or compiler is nested deeper than the code emitter can handle" {
  let all = every_item();
  assert(all.len() > 0, Some("no sources were scanned"));
  let over = all.filter(|item: Item| item.depth > max_depth());
  assert(
    over.len() == 0,
    Some(
      "these nest deeper than " ++ max_depth().to_string()
        ++ ", as deep as the emitter has ever walked; flatten them: "
        ++ String::join(over.map(item_text), ", "),
    ),
  );
  let most = all.fold(0, |m: Int, item: Item| if item.depth > m { item.depth } else { m });
  assert(
    most > max_depth() / 2,
    Some("nothing comes near " ++ max_depth().to_string() ++ " any more; lower the bound"),
  )
}
