import harness (in_memory, one_module_tree)
import support.harness (all_output)

test "a shipped module nested under another is imported by its full path, next to its parent module" {
  let r = in_memory(
    one_module_tree(
      "import std.hash (sha256)\nimport std.hash.legacy (sha1)\n\npub fn lengths() -> (Int, Int) / {abort.raise} = (sha1(b\"abc\").len(), sha256(b\"abc\").len())\n",
    ),
    ["check"],
  );
  assert(r.code == 0, Some(all_output(r)))
}
