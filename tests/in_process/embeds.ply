//! What a load takes from the binary for a program that has no file for it.

import harness (in_memory, one_module_tree)
import support.harness (all_output)

// `std.hash.legacy` is `hash/legacy.ply` below the library, beside `std.hash`'s `hash.ply`.
test "a shipped module below the library is imported by its place, beside its parent" {
  let r = in_memory(
    one_module_tree(
      "import std.hash (sha256)\nimport std.hash.legacy (sha1)\n\npub fn lengths() -> (Int, Int) / {abort.raise} = (sha1(b\"abc\").len(), sha256(b\"abc\").len())\n",
    ),
    ["check"],
  );
  assert(r.code == 0, Some(all_output(r)))
}
