import harness (in_memory, one_module_tree)
import spawning.harness (stdout, json_of, at, path, nth, items, str, int, json_text)
import std.json (Json, Array)
import std.list

const source: String = String::of_bytes_lossy(embed("../programs/surface/source.ply"))

fn names(j: Json) -> List<String> = items(j).map(|x: Json| str(at(x, "name")))

test "defs lists every definition with its place, hash, signature and references" {
  let v = json_of(in_memory(one_module_tree(source), ["definitions", "--json"]));
  assert_eq(int(at(v, "exit_code")), 0);
  let definitions = at(v, "definitions");
  assert_eq(names(definitions), ["m.one", "m.two", "m.three", "m.alone"]);
  let two = nth(definitions, 1);
  assert_eq(str(at(two, "type")), "() -> Int");
  assert_eq(at(two, "effects"), Array([]));
  assert_eq(items(at(two, "dependencies")).map(str), ["m.one"]);
  assert_eq(str(at(two, "hash")).len(), 64);
  assert(str(at(two, "location")).ends_with("m.ply:2:1"), Some(json_text(two)));
  assert_eq(int(at(two, "start")), 20);
  let filtered = stdout(in_memory(one_module_tree(source), ["definitions", "--filter", "thr"]));
  assert(filtered.contains("m.three") && !filtered.contains("m.two"), Some(filtered))
}

test "`ply callers` lists the definitions that mention a definition directly and those that depend on it indirectly" {
  let v = json_of(in_memory(one_module_tree(source), ["callers", "one", "--json"]));
  assert_eq(str(path(v, ["definition", "name"])), "m.one");
  assert_eq(names(path(v, ["direct", "definitions"])), ["m.two"]);
  assert_eq(names(path(v, ["direct", "tests"])), []);
  assert_eq(names(path(v, ["transitive", "definitions"])), ["m.three", "m.two"]);
  assert_eq(names(path(v, ["transitive", "tests"])), ["two is two"]);
  assert_eq(names(path(v, ["transitive", "laws"])), ["three is three"]);
  let alone = stdout(in_memory(one_module_tree(source), ["callers", "m.alone"]));
  assert(alone.contains("test \"alone is three\""), Some(alone));
  assert_eq(in_memory(one_module_tree(source), ["callers", "nothing"]).code, 2)
}
