import harness (in_memory, one_module_tree, Hermetic, Shipped)
import support.harness (json_of, at, items, str, json_text)
import std.json (Json)
import std.string

fn hashed(source: String) -> Json / {Hermetic, Shipped, abort.raise, diverges} =
  json_of(in_memory(one_module_tree(source), ["hash", "--json"]))

fn hash_of(report: Json, name: String) -> String / {abort.raise} =
  match items(at(report, "definitions")).filter(|d: Json| str(at(d, "name")) == "m." ++ name) {
    [d, ..] -> str(at(d, "hash")),
    [] -> panic("`" ++ name ++ "` is not in the program: " ++ json_text(report)),
  }

fn test_hash(report: Json, name: String) -> String / {abort.raise} =
  match items(at(report, "tests")).filter(|t: Json| str(at(t, "key")) == "m." ++ name) {
    [t, ..] -> str(at(t, "hash")),
    [] -> panic("no test `" ++ name ++ "`: " ++ json_text(report)),
  }

test "a generated definition's hash is the same whether `std.json` is imported plainly or with `as j`" {
  let spelled = |form: String, deriver: String|
    hashed(
      form ++ "\npub type A = { x: Int, y: String }\npub type B = Left(Int) | Right(A)\nderive "
        ++ deriver
        ++ " for A\nderive "
        ++ deriver
        ++ " for B\n",
    );
  let plain = spelled("import std.json", "json");
  let bound = spelled("import std.json as j", "j");
  assert_eq(hash_of(plain, "a_json"), hash_of(bound, "a_json"));
  assert_eq(hash_of(plain, "b_json"), hash_of(bound, "b_json"))
}

test "renaming a type parameter does not move a generated hash" {
  let with_params = |params: String, fst: String, snd: String|
    "import std.json\npub type Pair<" ++ params ++ "> = { fst: " ++ fst ++ ", snd: " ++ snd
      ++ " }\nderive json for Pair\n";
  assert_eq(
    hash_of(hashed(with_params("a, b", "a", "b")), "pair_json"),
    hash_of(hashed(with_params("d, e", "d", "e")), "pair_json"),
  )
}

fn fields_source(fields: String) -> String =
  "import std.json\npub type A = { " ++ fields ++ " }\nderive json for A\n"

test "reordering two fields moves the hash of the codec derived for them" {
  assert(
    hash_of(hashed(fields_source("x: Int, y: String")), "a_json")
      != hash_of(hashed(fields_source("y: String, x: Int")), "a_json"),
    Some("a field reorder changes the decoder's visiting order, so it has to move the hash"),
  )
}

fn status_source(ty: String, codec: String, variant: String) -> String =
  "import std.json\n\npub type Status = " ++ variant ++ " | Shipped(Int)\npub type " ++ ty
    ++ " = { id: Int, status: Status }\nderive json for Status\nderive json for "
    ++ ty
    ++ "\n\nfn wire(o: "
    ++ ty
    ++ ") -> String / {abort.raise} = String::of_bytes(json::encode_bytes(o, "
    ++ codec
    ++ "()))\n\ntest \"an order encodes\" {\n  assert_eq(wire({id: 1, status: "
    ++ variant
    ++ "}), \"{\\\"id\\\":1,\\\"status\\\":\\\""
    ++ variant
    ++ "\\\"}\")\n}\n\ntest \"an unrelated arithmetic fact\" { assert_eq(1 + 1, 2) }\n"

test "renaming the type moves no test's hash and renaming a variant moves its own alone" {
  let first = hashed(status_source("Order", "order_json", "Placed"));
  let renamed = hashed(status_source("Purchase", "purchase_json", "Placed"));
  assert_eq(test_hash(renamed, "an order encodes"), test_hash(first, "an order encodes"));
  assert_eq(
    test_hash(renamed, "an unrelated arithmetic fact"),
    test_hash(first, "an unrelated arithmetic fact"),
  );
  let tagged = hashed(status_source("Purchase", "purchase_json", "Created"));
  assert(test_hash(tagged, "an order encodes") != test_hash(renamed, "an order encodes"));
  assert_eq(
    test_hash(tagged, "an unrelated arithmetic fact"),
    test_hash(renamed, "an unrelated arithmetic fact"),
  )
}
