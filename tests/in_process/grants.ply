import harness (in_memory, in_memory_faked, one_module_tree, passing_except)
import support.harness (all_output, stderr, stdout)
import std.list
import std.string

fn asking() -> String = String::of_bytes_lossy(embed("../programs/grants/asking.ply"))

test "`--allow toolchain` fails when the program does not declare that effect, and the error names the effect" {
  let r = in_memory_faked(
    one_module_tree(asking()),
    ["run", "--allow", "toolchain", "m.ply"],
    passing_except([]),
  ).ran;
  assert(r.code != 0, Some("an undeclared grant ran"));
  let err = stderr(r);
  assert(err.contains("E0459"), Some(err));
  assert(err.contains("`--allow toolchain`") && err.contains("`toolchain`"), Some(err))
}

fn backticked(line: String) -> List<String> = {
  let parts = line.split("`");
  range(0, parts.len()).fold([], |accumulator: List<String>, i: Int|
    match parts.at(i) {
      Some(p) -> if i % 2 == 1 { accumulator.push(p) } else { accumulator },
      None -> accumulator,
    })
}

fn after(text: String, marker: String) -> String / {abort.raise} =
  text.split("\n").fold("", |found: String, l: String|
    match l.split(marker).at(1) { Some(rest) -> rest, None -> found })

test "the `run` help lists every name `--allow` accepts, and no other names" {
  let t = one_module_tree("fn main() -> Int = 0\n");
  let help = in_memory(t, ["run", ".", "--help"]);
  let named = backticked(after(stdout(help), "--allow <NAME>")).sort();
  let rejected = in_memory_faked(
    t,
    ["run", "--allow", "nonsense", "m.ply"],
    passing_except([]),
  ).ran;
  let provided = after(stderr(rejected), "it provides ").split(",").map(|f: String| f.trim()).sort(
  );
  assert(provided.len() > 1, Some(all_output(rejected)));
  assert_eq(named, provided)
}
