import harness (in_memory, in_memory_faked, passing_except, tree, Hermetic, Shipped)
import support.harness (Source, RunResult, stderr)

fn good() -> String =
  \\import std.pkg (Manifest)
  \\fn package() -> Manifest = {name: "app", version: {major: 0, minor: 1, patch: 0}, prefix: None, runtime: {major: 0, minor: 1, patch: 0}, dependencies: [], entry: None}
  \\

fn files(manifest: Option<String>) -> List<Source> = {
  let module = [{ path: "m.ply", text: "fn main() -> Int = 1\n" }];
  match manifest { Some(m) -> module.push({ path: "ply.pkg", text: m }), None -> module }
}

fn checked(manifest: Option<String>) -> RunResult / {Hermetic, Shipped, abort.raise, diverges} =
  in_memory(tree(files(manifest)), ["check"])

test "a project without a manifest is the anonymous package" {
  let r = checked(None);
  assert(r.code == 0, Some(stderr(r)))
}

test "a well-formed manifest is accepted by both `ply check` and `ply test`" {
  assert_eq(checked(Some(good())).code, 0);
  let tested = in_memory_faked(tree(files(Some(good()))), ["test", "."], passing_except([])).ran;
  assert(tested.code == 0, Some(stderr(tested)))
}

test "a manifest body that runs is not a value" {
  let r = in_memory_faked(
    tree(
      files(
        Some(
          \\import std.pkg (Manifest)
          \\fn package() -> Manifest = {name: greet("x"), version: {major: 0, minor: 0, patch: 1}, prefix: None, runtime: {major: 0, minor: 0, patch: 1}, dependencies: [], entry: None}
          \\
        ),
      ),
    ),
    ["test", "."],
    passing_except([]),
  ).ran;
  assert_eq(r.code, 2);
  assert(stderr(r).contains("E0130"), Some(stderr(r)))
}

test "a `ply.pkg` that does not define exactly one manifest function is rejected with E0129" {
  let r = checked(Some("fn package() -> Int = 1\n"));
  assert_eq(r.code, 2);
  assert(stderr(r).contains("E0129"), Some(stderr(r)));
  assert(stderr(r).contains("ply.pkg"), Some(stderr(r)))
}

test "a manifest field that fails validation is reported with E0131, naming the field" {
  let r = checked(
    Some(
      \\import std.pkg (Manifest)
      \\fn package() -> Manifest = {name: "", version: {major: 0, minor: 0, patch: 1}, prefix: None, runtime: {major: 0, minor: 0, patch: 1}, dependencies: [], entry: None}
      \\
    ),
  );
  assert_eq(r.code, 2);
  assert(stderr(r).contains("E0131"), Some(stderr(r)));
  assert(stderr(r).contains("`name` must not be empty"), Some(stderr(r)))
}

test "a manifest with a syntax error reports the syntax error and not E0129" {
  let r = checked(Some("fn package() -> Manifest = {name: \"app\"\n"));
  assert_eq(r.code, 2);
  assert(!stderr(r).contains("E0129"), Some(stderr(r)));
  assert(stderr(r).contains("E0001") || stderr(r).contains("E0002"), Some(stderr(r)))
}
