//! What an entry may return across the boundary: data, and never a handle a scheduler of the run
//! holds. A continuation or a task in an entry's result is the program's error, and a constant the
//! boundary rejects keeps nothing for the next entry. That a handle carried into another scheduler
//! fails its join is `std.internal.schedule`'s own test: a program that opens a `simulate` reaches
//! the whole search, which `load_program` emits again for every test.

import harness (Shipped, LoadedProgram, call, load_program, scratch, unload_program)
import support.harness (WorkingDirectory, write_project)
import cli.machine (default_options)
import std.machine as entering
import std.value (VInt)

effect set MachineAccess = {entering::machine.open, entering::machine.bind, entering::machine.enter, entering::machine.unbind, entering::machine.close}

/// `Saved`'s field is a function type, so the checker lets `k` reach `suspended`'s result.
fn parked() -> String = String::of_bytes_lossy(embed("../programs/scheduler_boundary/parked.ply"))

fn load_continuation_program() -> LoadedProgram / {WorkingDirectory, Shipped, MachineAccess, abort.raise} = {
  write_project([{ path: "inner.ply", text: parked() }]);
  load_program(default_options())
}

/// What `name` raised, as its code and message; a call that returned is a failure.
fn raised_error(
  l: LoadedProgram,
  name: String,
) -> { code: Bytes, message: String } / {MachineAccess, abort.raise} =
  match call(l, name, []) {
    Ok(_) -> panic("`" ++ name ++ "` returned"),
    Err(d) -> { code: d.code, message: String::of_bytes_lossy(d.message) },
  }

test "a continuation in an entry's result is the program's error, every time it is asked" {
  scratch(|| {
    let l = load_continuation_program();
    range(0, 2).fold((), |u: Unit, i: Int| {
      let d = raised_error(l, "suspended");
      assert_eq(d.code, b"E0449");
      assert(d.message.contains("`inner.suspended` returned a continuation"), Some(d.message));
      assert(d.message.contains("Resumable`'s argument 1"), Some(d.message))
    });
    // The memo caches no result that holds a continuation, so each entry resumes the one it parked.
    let resumed = range(0, 2).map(|n: Int| call(l, "add_resumed_result", [VInt(n)]));
    let _ = unload_program(l);
    assert(
      match resumed { [Ok(VInt(41)), Ok(VInt(42))] -> true, _ -> false },
      Some("an entry resumed a continuation another entry parked"),
    )
  })
}

test "a task in an entry's result is rejected as a continuation is" {
  scratch(|| {
    let l = load_continuation_program();
    let d = raised_error(l, "spawned");
    let _ = unload_program(l);
    assert_eq(d.code, b"E0449");
    assert(d.message.contains("`inner.spawned` returned a `Task`"), Some(d.message))
  })
}
