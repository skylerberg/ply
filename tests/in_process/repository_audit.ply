import harness (toolchain_parts)
import spawning.harness (Repo, PlyProcess, at, items, json_of, repo, spawned, str)
import std.json (Json)
import std.string

fn assert_checks_clean(
  dir: String,
  reject_unused_definitions: Bool,
) -> Unit / {PlyProcess, Repo, abort.raise} = {
  let v = json_of(spawned(["check", "--json", repo() ++ "/" ++ dir]));
  let found = items(at(v, "diagnostics")).fold([], |a: List<String>, d: Json| {
    let code = str(at(d, "code"));
    if (reject_unused_definitions && code == "W0611") || code == "W0614"
        || str(at(d, "severity")) == "error" { a.push(code ++ " " ++ str(at(d, "message"))) }
    else { a }
  });
  assert(
    found == [],
    Some(
      dir
        ++ " has errors, definitions nothing reaches, which are to be deleted, or effects naming an "
        ++ "effect no body on them performs, which are to be narrowed:\n  "
        ++ String::join(found, "\n  "),
    ),
  )
}

test/nondet "the standard library has no check errors, no unused definitions and no effect declared but not performed" {
  assert_checks_clean(toolchain_parts().std, true)
}

test/nondet "the standard library's tests have no check errors, no unused definitions and no effect declared but not performed" {
  assert_checks_clean(toolchain_parts().std_tests, true)
}

test/nondet "the compiler's source has no check errors, no unused definitions and no effect declared but not performed" {
  assert_checks_clean(toolchain_parts().compiler, true)
}

test/nondet "the CLI's source has no check errors and no effect declared but not performed" {
  assert_checks_clean(toolchain_parts().cli, false)
}
