import harness (RunWithTree, in_memory, in_memory_with_tree, tree, file_of, Hermetic, Shipped)
import spawning.harness (stdout, stderr, json_of, at, items, first, str, int, bool, json_text)
import compiler.syntax
import std.fs
import std.fs (MemFs, Mode)

const unformatted: String =
  \\// A leading comment.
  \\fn   add(a: Int,b: Int)->Int = a+b // trailing
  \\
  \\
  \\fn main() -> Int = { let x = 0xFF; add(x, 1_000) }
  \\

const formatted: String = String::of_bytes_lossy(embed("../programs/fmt/formatted.ply"))

fn run_with_tree(
  t: MemFs,
  argv: List<String>,
) -> RunWithTree / {Hermetic, Shipped, abort.raise, diverges} =
  in_memory_with_tree(t, argv, [], None)

fn text_at(t: MemFs, path: String) -> String / {abort.raise} =
  match file_of(t, path) { Some(x) -> x, None -> "" }

test "a file is formatted in place and a second run changes nothing" {
  let k = run_with_tree(tree([{ path: "m.ply", text: unformatted }]), ["fmt", "m.ply"]);
  assert(k.ran.code == 0, Some(stderr(k.ran)));
  assert_eq(stdout(k.ran), "formatted m.ply\n");
  assert_eq(text_at(k.tree, "m.ply"), formatted);
  assert_eq(Bytes::of_string(formatted), syntax::formatted(Bytes::of_string(unformatted)));
  let again = run_with_tree(k.tree, ["fmt", "--check", "--json"]);
  assert_eq(again.ran.code, 0);
  let v = json_of(again.ran);
  assert_eq(str(at(v, "command")), "fmt");
  assert(bool(at(v, "ok")), Some(json_text(v)));
  let file = first(items(at(v, "files")));
  assert_eq(str(at(file, "path")), "m.ply");
  assert(!bool(at(file, "changed")), Some(json_text(v)));
  assert(items(at(v, "errors")) == [], Some(json_text(v)));
  assert_eq(text_at(again.tree, "m.ply"), formatted)
}

test "check names the file that would change and writes nothing" {
  let t = tree([{ path: "m.ply", text: unformatted }]);
  let k = run_with_tree(t, ["fmt", "--check"]);
  assert_eq(k.ran.code, 1);
  assert_eq(stdout(k.ran), "would format m.ply\n");
  assert_eq(text_at(k.tree, "m.ply"), unformatted);
  let v = json_of(in_memory(t, ["fmt", "--check", "--json"]));
  assert_eq(int(at(v, "exit_code")), 1);
  assert(bool(at(first(items(at(v, "files"))), "changed")), Some(json_text(v)))
}

test "a file that does not parse exits two and is left alone" {
  let broken = "fn f( = 1\n";
  let t = tree([{ path: "m.ply", text: broken }]);
  let k = run_with_tree(t, ["fmt"]);
  assert_eq(k.ran.code, 2);
  assert(stderr(k.ran).contains("m.ply") && stderr(k.ran).contains("E0001"), Some(stderr(k.ran)));
  assert_eq(text_at(k.tree, "m.ply"), broken);
  let v = json_of(in_memory(t, ["fmt", "--check", "--json"]));
  assert_eq(int(at(v, "exit_code")), 2);
  assert_eq(str(at(first(items(at(v, "errors"))), "path")), "m.ply")
}

test "a directory outside the working directory is checked and formatted where it is" {
  let t = fs::mem_write(
    fs::mem_create_dir(tree([]), "p/sub").fs,
    "p/sub/m.ply",
    Bytes::of_string(unformatted),
  ).fs;
  let shown_as = "/p/sub/m.ply";
  let checked = run_with_tree(t, ["fmt", "--check", "/p"]);
  assert(checked.ran.code == 1, Some(stderr(checked.ran)));
  assert_eq(stdout(checked.ran), "would format " ++ shown_as ++ "\n");
  assert(fs::mem_read(checked.tree, "p/sub/m.ply") == Some(Bytes::of_string(unformatted)), None);
  let made = run_with_tree(t, ["fmt", "/p"]);
  assert(made.ran.code == 0, Some(stderr(made.ran)));
  assert_eq(stdout(made.ran), "formatted " ++ shown_as ++ "\n");
  assert(fs::mem_read(made.tree, "p/sub/m.ply") == Some(Bytes::of_string(formatted)), None);
  let after = run_with_tree(made.tree, ["fmt", "--check", "--json", "/p"]);
  assert_eq(after.ran.code, 0);
  let v = json_of(after.ran);
  assert_eq(str(at(first(items(at(v, "files"))), "path")), shown_as);
  assert(!bool(at(first(items(at(v, "files"))), "changed")), Some(json_text(v)));
  assert(items(at(v, "errors")) == [], Some(json_text(v)))
}

fn mode(text: String) -> Mode / {abort.raise} =
  match fs::mode_of_text(text) { Some(m) -> m, None -> panic("`" ++ text ++ "` is a mode") }

test "a file that cannot be read fails the check and the run" {
  let readable = tree([
    { path: "m.ply", text: formatted },
    { path: "locked.ply", text: unformatted },
  ]);
  let t = fs::mem_set_mode(readable, "w/locked.ply", mode("---------")).fs;
  assert(file_of(t, "locked.ply") == None, Some("the test needs a file nobody can read"));

  let checked = in_memory(t, ["fmt", "--check"]);
  assert(checked.code == 2, Some(stderr(checked)));
  assert(stderr(checked).contains("error: locked.ply: could not read"), Some(stderr(checked)));
  assert_eq(stdout(checked), "");

  let v = json_of(in_memory(t, ["fmt", "--check", "--json"]));
  assert_eq(int(at(v, "exit_code")), 2);
  assert(!bool(at(v, "ok")), Some(json_text(v)));
  let rejected = first(items(at(v, "errors")));
  assert_eq(str(at(rejected, "path")), "locked.ply");
  assert_eq(str(at(rejected, "error")), "could not read");

  let k = run_with_tree(t, ["fmt"]);
  assert(k.ran.code == 2, Some(stderr(k.ran)));
  assert(stderr(k.ran).contains("error: locked.ply: could not read"), Some(stderr(k.ran)));
  assert_eq(
    text_at(fs::mem_set_mode(k.tree, "w/locked.ply", mode("rw-r--r--")).fs, "locked.ply"),
    unformatted,
  )
}
