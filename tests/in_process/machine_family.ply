import harness (Shipped, LoadedProgram, enter, load_program, scratch, unload_program)
import support.harness (WorkingDirectory, write_project, write)
import cli.machine
import cli.machine (Options, default_options)
import compiler.check.resolve.tables (Diagnostic)
import cli.diagnostic (RuntimeDiagnostic)
import std.fs
import std.fs (fs)
import std.machine as entering
import std.value (Value, VInt)

effect set MachineAccess = {entering::machine.open, entering::machine.bind, entering::machine.enter, entering::machine.unbind, entering::machine.close}

type EntryResult = {
  exit: Option<Int>,
  result: Result<Value, RuntimeDiagnostic>,
  warnings: List<Diagnostic>,
  usage: entering::Usage,
}

fn entry_result(
  l: LoadedProgram,
  name: String,
  args: List<Value>,
) -> EntryResult / {entering::machine.enter, abort.raise} = {
  let o = enter(l, name, args);
  {
    exit: o.exit,
    result: machine::result_of(o, l.roots, "inner." ++ name),
    warnings: machine::warnings_of(o, l.roots),
    usage: o.usage,
  }
}

fn main_of(
  inner: String,
  options: Options,
) -> EntryResult / {WorkingDirectory, Shipped, MachineAccess, abort.raise} = {
  write_project([{ path: "inner.ply", text: inner }]);
  let l = load_program(options);
  let ended = entry_result(l, "main", []);
  let _ = unload_program(l);
  ended
}

fn traced_quietly() -> Options = { ..default_options(), trace: { sink: "off", level: "info" } }

fn leaves_a_span() -> String =
  String::of_bytes_lossy(embed("../programs/machine_family/leaves_a_span.ply"))

fn warns_of_the_open_span(warnings: List<Diagnostic>) -> Unit / {abort.raise} =
  match warnings {
    [w] -> {
      assert_eq(w.code, b"W0609");
      assert(
        w.message.index_of(b"`order` on `orders`") != None,
        Some(String::of_bytes_lossy(w.message)),
      )
    },
    _ -> panic("one warning, not " ++ warnings.len().to_string()),
  }

fn code_of(result: Result<Value, RuntimeDiagnostic>) -> Bytes =
  match result { Ok(_) -> b"", Err(r) -> r.diagnostic.code }

test "a program can load another program and run its `main`, which returns the program's value" {
  scratch(|| {
    let ended = main_of("fn main() -> Int = 40 + 2\n", default_options());
    assert_eq(ended.result, Ok(VInt(42)));
    assert_eq(ended.exit, None)
  })
}

fn exit_code_program() -> String =
  "import std.process (process)\n\nfn main() -> Unit / {process.exit[proc]} = process.exit[proc](7)\n"

test/nondet "a nested program can choose the process exit code when the caller allows it" {
  let ended = main_of(exit_code_program(), default_options());
  assert_eq(ended.exit, Some(7));
  assert_eq(code_of(ended.result), b"")
}

test "a panic in a nested program is returned as an error value with E0502 and does not stop the caller" {
  scratch(|| {
    let ended = main_of(
      "fn main() -> Int / {abort.raise} = panic(\"the inner program's own bug\")\n",
      default_options(),
    );
    assert_eq(ended.exit, None);
    match ended.result {
      Ok(_) -> panic("the raise is reported"),
      Err(r) -> {
        assert_eq(r.diagnostic.code, b"E0502");
        assert(
          r.diagnostic.message.index_of(b"the inner program's own bug") != None,
          Some(String::of_bytes_lossy(r.diagnostic.message)),
        )
      },
    }
  })
}

test/nondet "an entry point that ends with a trace span still open returns its value together with warning W0609" {
  write_project([{ path: "inner.ply", text: leaves_a_span() }]);
  let l = load_program(traced_quietly());
  let ended = entry_result(l, "main", []);
  let _ = unload_program(l);
  assert_eq(ended.result, Ok(VInt(3)));
  warns_of_the_open_span(ended.warnings)
}

test "loading an edited program runs the new code, and loading a program writes no `.ply-cache`" {
  scratch(|| {
    write_project([{ path: "inner.ply", text: "fn main() -> Int = 1\n" }]);
    let first = load_program(default_options());
    assert_eq(entry_result(first, "main", []).result, Ok(VInt(1)));
    assert(
      fs.kind[cwd](".ply-cache") == fs::Missing,
      Some("opening a unit reads the library it was handed and files nothing"),
    );
    write("inner.ply", "fn main() -> Int = 2\n");
    let again = load_program(default_options());
    assert_eq(entry_result(again, "main", []).result, Ok(VInt(2)));
    assert_eq(entry_result(first, "main", []).result, Ok(VInt(1)));
    let _ = unload_program(first);
    let _ = unload_program(again);
    ()
  })
}

test "calling a definition of a loaded program with arguments returns its result, or the error it raised" {
  scratch(|| {
    write_project([
      {
        path: "inner.ply",
        text: "fn main() -> Int = 0\n\npub fn double(x: Int) -> Int = x * 2\n\npub fn boom() -> Int / {abort.raise} = panic(\"oh no\")\n",
      },
    ]);
    let l = load_program(default_options());
    let doubled = entry_result(l, "double", [VInt(21)]);
    let raised = entry_result(l, "boom", []);
    let _ = unload_program(l);
    assert_eq(doubled.result, Ok(VInt(42)));
    match raised.result {
      Ok(_) -> panic("`boom` answered"),
      Err(r) ->
        assert(
          r.diagnostic.message.index_of(b"oh no") != None,
          Some(String::of_bytes_lossy(r.diagnostic.message)),
        ),
    }
  })
}

test "a memoized definition returns the same value on repeat calls, and calling an undefined name does not return a value" {
  scratch(|| {
    write_project([
      {
        path: "inner.ply",
        text: "fn main() -> Int = 0\n\nfn deep(n: Int) -> Int = if n <= 0 { 0 } else { 1 + deep(n - 1) }\n\npub fn constant() -> Int = deep(50)\n",
      },
    ]);
    let l = load_program(default_options());
    let result = |name: String| entry_result(l, name, []).result;
    let ran = result("constant");
    let remembered = result("constant");
    let declined = result("absent");
    let _ = unload_program(l);
    assert_eq(ran, Ok(VInt(50)));
    assert_eq(remembered, Ok(VInt(50)));
    assert(declined != Ok(VInt(0)), Some("an absent name returned"))
  })
}

fn task_spawning_program() -> String =
  String::of_bytes_lossy(embed("../programs/machine_family/churning.ply"))

fn churn_result(
  name: String,
  n: Int,
) -> EntryResult / {WorkingDirectory, Shipped, MachineAccess, abort.raise} = {
  write_project([{ path: "inner.ply", text: task_spawning_program() }]);
  let l = load_program(default_options());
  let ended = entry_result(l, name, [VInt(n)]);
  let _ = unload_program(l);
  ended
}

test/nondet "after many tasks finish, the scheduler's task list, task stacks and frame tables stay small instead of growing with each task" {
  let h = churn_result("spawn_and_join", 200);
  assert_eq(h.result, Ok(VInt(200 * 201 / 2)));
  assert(
    h.usage.scheduled <= 3,
    Some("the scheduler keeps " ++ h.usage.scheduled.to_string() ++ " tasks after 400 spawns"),
  );
  assert(
    h.usage.task_stacks <= 2,
    Some(h.usage.task_stacks.to_string() ++ " task stacks after 400 spawns"),
  );
  assert(
    h.usage.frame_tables <= 8,
    Some(h.usage.frame_tables.to_string() ++ " frame tables after 400 spawns"),
  )
}

test/nondet "after many task handles are dropped, the scheduler frees their native objects, so the count stays small" {
  let h = churn_result("fired", 10000);
  assert_eq(h.result, Ok(VInt(10000 * 9999 / 2)));
  assert(
    h.usage.native_objects <= 4,
    Some(h.usage.native_objects.to_string() ++ " native objects after 10000 dropped handles"),
  )
}
