import harness (scratch, in_memory, tree, on_disk, warm_matches_cold, Hermetic, Shipped,
                on_disk_shipping, on_disk_shipping_only, with_prelude_shipped)
import support.harness (Source, write_project, write_program, write, all_output, stdout, json_of,
                        at, items, first, str, bool, json_text, assert_ok, diagnostic_codes)
import support.projects (checkout, nested_shipped, program_calling_shipped, two_shipped)
import compiler.syntax.expressions (prelude_module)
import std.fs (MemFs)
import std.json (Json)
import std.list
import std.string

fn importer() -> String = String::of_bytes_lossy(embed("../programs/stdlib/importer.ply"))

fn app(text: String) -> MemFs / {abort.raise} = tree([{ path: "app.ply", text: text }])

fn checked(t: MemFs) -> Json / {Hermetic, Shipped, abort.raise, diverges} =
  json_of(in_memory(t, ["check", "--json"]))

fn named(list: Json, name: String) -> Option<Json> =
  match items(list).filter(|d: Json| str(at(d, "name")) == name) { [d, ..] -> Some(d), [] -> None }

fn has_named(list: Json, name: String) -> Bool = named(list, name) != None

test "a project module can import std.net and it checks" {
  let report = checked(app(importer()));
  assert(bool(at(report, "ok")), Some(json_text(report)));
  assert(
    has_named(at(report, "modules"), "std.net"),
    Some("the shipped module is not in the program"),
  );
  assert(
    items(at(report, "effects")).filter(|e: Json|
        str(at(e, "module")) == "std.net" && str(at(e, "name")) == "std.net.net").len(
      )
      == 1,
    Some(json_text(at(report, "effects"))),
  );
  assert(has_named(at(report, "definitions"), "std.net.drain"), None);
  match named(at(report, "definitions"), "app.open_and_close") {
    Some(touch) ->
      assert_eq(items(at(touch, "effects")).map(str), [
        "std.net.net.close[listener]",
        "std.net.net.listen[listener]",
      ]),
    None -> panic("`app.open_and_close` is in the program"),
  }
}

test "importing `std.bigint` checks and tests cleanly, whether or not the program uses its operators and comparisons" {
  scratch(|| {
    write_program(
      "import std.bigint\n\nfn main() -> Int = 1\n\ntest \"one\" { assert_eq(main(), 1) }\n",
    );
    let checked = on_disk(["check"]);
    assert(checked.code == 0, Some(all_output(checked)));
    write(
      "m.ply",
      "import std.bigint (BigInt)\n\nfn same(a: BigInt, b: BigInt) -> Bool = a + b == b + a\n\nfn main() -> Int = 1\n",
    );
    let used = on_disk(["check"]);
    assert(used.code == 0, Some(all_output(used)))
  })
}

test "`ply hosts` lists the standard library's handler under its qualified effect name, and not for a program's own `time` effect" {
  scratch(|| {
    write_project([
      {
        path: "app.ply",
        text: "import std.time (time)\n\nfn stamp() -> Int / {time.now_ms} = time.now_ms()\n",
      },
    ]);
    let r = on_disk(["hosts", "--json"]);
    assert(r.code == 0, Some("got:\n" ++ all_output(r)));
    let rows = items(at(json_of(r), "hosts"));
    assert(rows != [], Some("nothing bound: " ++ all_output(r)));
    assert(
      rows.filter(|row: Json| str(at(row, "effect")) != "std.time.time").len() == 0,
      Some(all_output(r)),
    );
    assert(
      rows.filter(|row: Json| str(at(row, "triple")).starts_with("std.time.time.now_ms")).len() > 0,
      Some(all_output(r)),
    );
    write_project([
      {
        path: "app.ply",
        text: "nondet effect time {\n  read now_ms() -> Int\n}\nfn f() -> Int / {time.now_ms} = time.now_ms()\n",
      },
    ]);
    let other = on_disk(["hosts"]);
    assert(
      all_output(other).contains("none handles an effect this program performs"),
      Some("a copied declaration must not bind:\n" ++ all_output(other)),
    )
  })
}

test "a program importing nothing from std lists only `std.prelude` among its modules, with a `<std>/` file like any standard library module" {
  let report = checked(app("fn f() -> Int = 1\n"));
  let modules = items(at(report, "modules"));
  assert_eq(modules.map(|m: Json| str(at(m, "name"))), ["app", prelude()]);
  assert_eq(items(at(report, "files")).map(str), modules.map(|m: Json| str(at(m, "file"))));
  assert(str(at(first(modules.drop(1)), "file")).starts_with("<std>/"), Some(json_text(report)));
  assert(
    items(at(report, "definitions")).filter(|d: Json| str(at(d, "name")).starts_with("std.")).len()
      == 0,
    Some(json_text(report)),
  );
  let mapping = checked(app("pub fn f(xs: List<Int>) -> List<Int> = xs.map(|x: Int| x + 1)\n"));
  assert(
    has_named(at(mapping, "definitions"), prelude() ++ ".List::map"),
    Some(json_text(mapping)),
  );
  let listed = items(at(json_of(in_memory(app(""), ["std", "--json"])), "modules"));
  assert(listed.any(|m: Json| str(at(m, "module")) == prelude()), None)
}

fn prelude() -> String = String::of_bytes_lossy(prelude_module())

fn modules_of(sources: List<Source>) -> List<String> / {abort.raise} =
  sources.filter(|s: Source| s.path.ends_with(".ply")).map(|s: Source|
    s.path.slice(0, s.path.len() - 4)).sort(
  )

fn implicitly_shipped(given_modules: List<Source>) -> List<String> / {abort.raise} = {
  let own = modules_of(given_modules);
  modules_of(with_prelude_shipped(given_modules)).filter(|m: String| !own.contains(m))
}

test "the cache records a standard library module under the name `<std>/kept.ply`, and `ply cache compact` does not remove it" {
  scratch(|| {
    write_program(program_calling_shipped());
    assert_ok(on_disk_shipping_only(["check"], two_shipped()));
    let recorded = ||
      items(
        at(
          json_of(
            on_disk_shipping_only(["cache", "inspect", "std.kept.one", "--json"], two_shipped()),
          ),
          "matches",
        ),
      ).map(|m: Json| str(at(m, "file")));
    assert_eq(recorded(), ["<std>/kept.ply"]);
    assert_ok(on_disk_shipping_only(["cache", "compact"], two_shipped()));
    assert(
      recorded() == ["<std>/kept.ply"],
      Some("compaction dropped a module this binary still ships"),
    )
  })
}

test "`ply check` gives the same result with a cache from an earlier run as without one, for a program importing `std`" {
  scratch(|| {
    write_project([{ path: "app.ply", text: importer() }]);
    let _ = warm_matches_cold("cold");
    let warm = warm_matches_cold("warm");
    assert(
      has_named(at(warm, "definitions"), "std.net.drain"),
      Some("the shipped module is part of the result: " ++ json_text(warm)),
    )
  })
}

test "`ply check` loads only the standard library definitions a program calls, and loads an effect's definitions separately from a same-named function's" {
  scratch(|| {
    let loaded = |text: String| {
      write_program(text);
      let v = json_of(on_disk_shipping_only(["check", "--json"], alike_shipped()));
      assert(bool(at(v, "ok")), Some(json_text(v)));
      at(v, "definitions")
    };
    let reader = loaded(
      "import std.zb (try_read)\n\npub fn opens(x: Int) -> Bool =\n  match try_read(x) { Ok(_) -> true, Err(_) -> false }\n",
    );
    assert(
      has_named(reader, "std.zb.try_read") && has_named(reader, "std.zb.read")
        && !has_named(reader, "std.zb.zb")
        && !has_named(reader, "std.zb.written"),
      Some(json_text(reader)),
    );
    let returning = loaded(
      "import std.zb\nimport std.zb (zb)\n\npub fn opens(x: Int) -> Bool =\n  match try[zb.refused] { zb::read(x) } { Ok(_) -> true, Err(_) -> false }\n",
    );
    assert(
      has_named(returning, "std.zb.read") && !has_named(returning, "std.zb.zb")
        && !has_named(returning, "std.zb.written"),
      Some(json_text(returning)),
    );
    let writer = loaded("import std.zb (zb)\n\npub fn packed(x: Int) -> Int = zb(x)\n");
    assert(
      has_named(writer, "std.zb.zb") && has_named(writer, "std.zb.written")
        && !has_named(writer, "std.zb.read"),
      Some(json_text(writer)),
    )
  })
}

fn alike_shipped() -> List<Source> =
  [
    {
      path: "std.za.ply",
      text:
        \\//! The first of two modules with a `Limits` alike.
        \\
        \\/// How far a decode may go.
        \\pub type Limits = new { output: Int, window: Int }
        \\
        \\/// The sum of the bounds.
        \\pub fn fa(l: Limits) -> Int = l.output + l.window
        \\
    },
    {
      path: "std.zb.ply",
      text:
        \\//! The second of two modules with a `Limits` alike, and an effect beside a function.
        \\
        \\/// How far a decode may go.
        \\pub type Limits = new { output: Int, window: Int }
        \\
        \\/// The product of the bounds.
        \\pub fn fb(l: Limits) -> Int = l.output * l.window
        \\
        \\/// Why a read stopped.
        \\pub effect zb {
        \\  raise refused(at: Int)
        \\}
        \\
        \\fn written(x: Int) -> Int = x * 31 + 7
        \\
        \\/// The writer.
        \\pub fn zb(x: Int) -> Int = written(x)
        \\
        \\/// The reader.
        \\pub fn read(x: Int) -> Int / {zb.refused} = if x < 0 { zb.refused(x) } else { x + 1 }
        \\
        \\/// The reader, returning `Err` where it was rejected.
        \\pub fn try_read(x: Int) -> Result<Int, Int> = try[zb.refused] { read(x) }
        \\
    },
  ]

test "`ply std` lists each standard library module and data file, `--show` prints one by path, and `--digest` changes when a data file changes" {
  scratch(|| {
    let ply_std = |argv: List<String>, shipped: List<Source>|
      on_disk_shipping_only(["std"].concat(argv), shipped);
    let digest_of = |shipped: List<Source>| stdout(ply_std(["--digest"], shipped)).trim();
    let digest = digest_of(two_shipped());
    assert(digest.starts_with("b3:") && digest.len() == 15, Some(digest));
    let listing = ply_std([], two_shipped());
    assert(listing.code == 0, Some("got:\n" ++ all_output(listing)));
    [
      "std.idle",
      "std.kept",
      "std/idle/words.txt · 4 bytes · embedded by std.idle",
      "digest: " ++ digest,
    ].fold((), |u: Unit, needle: String|
      assert(all_output(listing).contains(needle), Some("got:\n" ++ all_output(listing))));
    assert_eq(str(at(json_of(ply_std(["--json"], two_shipped())), "digest")), digest);
    let data = ply_std(["--show", "std/idle/words.txt"], two_shipped());
    assert(data.code == 0 && stdout(data) == "one\n", Some(all_output(data)));
    let sources = with_prelude_shipped(two_shipped()).fold("", |accumulator: String, s: Source|
      if s.path.ends_with(".ply") { accumulator ++ s.text } else { accumulator });
    assert_eq(stdout(ply_std(["--show"], two_shipped())), sources);
    let moved = two_shipped().map(|s: Source|
      if s.path == "std/idle/words.txt" { { ..s, text: "two\n" } } else { s });
    assert(digest_of(moved) != digest, Some("the digest covers the data a module embeds"));
    assert_eq(digest_of(two_shipped()), digest)
  })
}

test "a module beneath another ships under its place: listed in name order, and documented" {
  scratch(|| {
    let listed = items(
      at(json_of(on_disk_shipping_only(["std", "--json"], nested_shipped())), "modules"),
    );
    assert_eq(
      listed.map(|m: Json| str(at(m, "module"))),
      modules_of(with_prelude_shipped(nested_shipped())),
    );
    let given_modules = listed.filter(|m: Json|
      !implicitly_shipped(nested_shipped()).contains(str(at(m, "module"))));
    assert_eq(
      given_modules.map(|m: Json| items(at(m, "data")).map(|d: Json| str(at(d, "name")))),
      [["std/kept/list.txt"], ["std/kept/deep/words.txt"]],
    );
    write_program("import std.kept.deep (two)\n\nfn main() -> Int = two()\n");
    let doc = on_disk_shipping_only(["doc", "std.kept.deep.two"], nested_shipped());
    assert(doc.code == 0 && all_output(doc).contains("One more than"), Some(all_output(doc)))
  })
}

test "`ply doc` documents a nested standard library module such as `std.hash.legacy`, and a function that module exports" {
  let t = app("fn f() -> Int = 1\n");
  let module = in_memory(t, ["doc", "std.hash.legacy"]);
  assert(
    module.code == 0 && all_output(module).contains("MD5 and SHA-1, which are broken"),
    Some(all_output(module)),
  );
  let one = in_memory(t, ["doc", "std.hash.legacy.sha1"]);
  assert(
    one.code == 0 && all_output(one).contains("at <std>/hash/legacy.ply:"),
    Some(all_output(one)),
  )
}

test "programs that use different functions of one standard library module share the cached copy of that module" {
  scratch(|| {
    write_project([
      {
        path: "a.ply",
        text: "import std.json (Json, array)\nimport std.process (process)\n\npub fn main() -> Json = array([])\n",
      },
      {
        path: "b.ply",
        text: "import std.json (Json, int)\nimport std.fs (fs)\n\npub fn main() -> Json = int(1)\n",
      },
      {
        path: "c.ply",
        text: "import std.json (Json, array)\n\npub fn twice() -> Json = array([array([])])\n",
      },
    ]);
    ["a.ply", "b.ply", "c.ply"].fold((), |u: Unit, file: String| {
      let r = on_disk(["check", file]);
      assert(r.code == 0, Some(all_output(r)))
    })
  })
}

test "`ply check` on a project reports no standard library warnings or definitions, but on the standard library checkout it reports all of them" {
  scratch(|| {
    let shipped = two_shipped().map(|s: Source|
      if s.path == "std.kept.ply" { { ..s, text: s.text ++ "\nfn stray(n: Int) -> Int = n\n" } }
      else { s });
    write_project(
      checkout(with_prelude_shipped(shipped)).push({
        path: "app/m.ply",
        text: program_calling_shipped(),
      }),
    );
    let stray = |v: Json|
      items(at(v, "diagnostics")).filter(|d: Json|
        str(at(d, "code")) == "W0611" && str(at(d, "message")).contains("std.kept.stray")).len(
      );
    let mine = json_of(on_disk(["check", "app", "--json"]));
    let all = json_of(on_disk(["check", "lib/std", "--json"]));
    assert(
      stray(mine) == 0 && !has_named(at(mine, "definitions"), "std.idle.twice"),
      Some(json_text(mine)),
    );
    assert(
      stray(all) == 1 && has_named(at(all, "definitions"), "std.idle.twice"),
      Some(json_text(all)),
    );
    let listed = json_of(on_disk(["definitions", "app", "--json"]));
    let every = json_of(on_disk(["definitions", "lib/std", "--json"]));
    assert(
      has_named(at(listed, "definitions"), "m.held")
        && !has_named(at(listed, "definitions"), "std.kept.one"),
      Some(json_text(listed)),
    );
    assert(
      has_named(at(every, "definitions"), "std.kept.one")
        && has_named(at(every, "definitions"), "std.idle.twice"),
      Some(json_text(every)),
    )
  })
}

fn words() -> Source =
  {
    path: "std.words.ply",
    text:
      \\//! Words, one a line, for a test of a shipped table.
      \\
      \\fn parsed(text: Bytes) -> List<String> / {abort.raise} =
      \\  String::of_bytes(text).split("\n").filter(|word: String| word != "").map(|word: String|
      \\      if word.contains(" ") { panic("`" ++ word ++ "` is two words") } else { word },
      \\  )
      \\
      \\/// The words the file beside this module holds, made at the first read.
      \\pub const fn table() -> List<String> = parsed(embed("words/list.txt"))
      \\
      \\/// The same words, made where they are asked for.
      \\pub fn computed() -> List<String> / {abort.raise} = parsed(embed("words/list.txt"))
      \\
  }

fn counting() -> String =
  \\import std.words
  \\
  \\fn main() -> Int = words::table().len()
  \\
  \\test "the table returned by the `const fn` equals the table computed by running its body" {
  \\  assert_eq(words::table(), words::computed())
  \\}
  \\

test "a data file missing from the standard library is rejected as an error in the module that requests it" {
  scratch(|| {
    write_program(counting());
    let v = json_of(on_disk_shipping(["check", "--json"], [words()]));
    assert_eq(diagnostic_codes(v), ["E0146", "E0146"]);
    items(at(v, "diagnostics")).fold((), |u: Unit, d: Json| {
      assert(str(at(d, "message")).contains("words/list.txt"), Some(json_text(d)));
      assert_eq(items(at(d, "labels")).map(|l: Json| str(at(l, "file"))), ["<std>/words.ply"])
    })
  })
}

test "ply doc documents a name of a shipped module that embeds a data file" {
  let r = in_memory(app("fn f() -> Int = 1\n"), ["doc", "std.oid.name"]);
  assert(r.code == 0 && all_output(r).contains("well-known identifier"), Some(all_output(r)))
}

test "ply doc documents a name of a shipped module of the compiler" {
  let r = in_memory(app("fn f() -> Int = 1\n"), ["doc", "compiler.syntax.format"]);
  assert(
    r.code == 0 && all_output(r).contains("pub fn format(source: Bytes) -> Result<Bytes"),
    Some(all_output(r)),
  )
}
