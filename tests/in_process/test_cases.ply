//! A test over cases, `test "{c.name}" for c: T in table() { .. }`, as `ply test` runs it: a test per
//! case, each with its own label, key, pass and failure, and none of them moved by another's.

import harness (scratch, on_disk)
import spawning.harness (write_program, json_of, at, path, items, str, int, bool)
import std.json (Json, Null)
import std.string

/// Each error a report holds, as its code and the line its primary label starts on.
fn error_lines(report: Json) -> List<String> =
  items(at(report, "diagnostics")).filter(|d: Json| str(at(d, "severity")) == "error").map(
    |d: Json|
      str(at(d, "code")) ++ " "
        ++ int(
          path(
            match items(at(d, "labels")).filter(|l: Json| bool(at(l, "primary"))) {
              [l, ..] -> l,
              [] -> Null,
            },
            ["start", "line"],
          ),
        ).to_string(
        ),
  )

test "what a table may not be is rejected where it is written" {
  scratch(|| {
    write_program(
      \\effect clock { read now() -> Int }
      \\
      \\fn ticking() -> List<Int> / {clock.now} = [clock.now()]
      \\
      \\test "performs {n}" for n: Int in ticking() { assert(n > 0) }
      \\
      \\test "is no list {n}" for n: Int in 3 { assert(n > 0) }
      \\
      \\test "is of another type {n}" for n: String in [1, 2] { assert(n == "a") }
      \\
      \\test "holds a float {x}" for x: Float in [1.0] { assert(x > 0.0) }
      \\
    );
    assert_eq(error_lines(json_of(on_disk(["check", "--json"]))), [
      "E0469 5",
      "E0201 7",
      "E0201 9",
      "E0206 11",
    ])
  })
}
