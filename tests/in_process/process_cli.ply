import harness (scratch, on_disk)
import spawning.harness (write_program, all_output, json_of, at, str, items)
import std.bytes
import std.json (Json)
import std.list
import std.string

const describes_the_machine: String =
  String::of_bytes_lossy(embed("../programs/process_cli/describes_the_machine.ply"))

test "ply hosts lists every operation of std.os a program performs" {
  scratch(|| {
    write_program(describes_the_machine);
    let r = on_disk(["hosts", "--json"]);
    assert(r.code == 0, Some(all_output(r)));
    let triples = items(at(json_of(r), "hosts")).map(|row: Json| str(at(row, "triple")));
    [
      "family",
      "name",
      "arch",
      "cpus",
      "hostname",
      "user",
      "pid",
      "executable",
      "endian",
      "pointer_bits",
    ].fold((), |u: Unit, operation: String|
      assert(
        triples.contains("std.os.os." ++ operation),
        Some("`os." ++ operation ++ "` is not listed:\n" ++ all_output(r)),
      ))
  })
}

test "a `const` that calls `os.cpus` fails `check` with E0156, so no build bakes in the builder machine's values" {
  scratch(|| {
    write_program(
      "import std.os (os)\n\nconst workers: Int = os.cpus()\n\nfn main() -> Int = workers\n",
    );
    let r = on_disk(["check"]);
    assert(r.code != 0, Some(all_output(r)));
    assert(all_output(r).contains("E0156"), Some(all_output(r)))
  })
}
