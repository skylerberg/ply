//! The codecs of the JSON example, which `derive json` wrote.

import harness (in_memory, one_module_tree)
import support.harness (json_of, at, nth, str, json_text)

// `ply show` finds no `fn` written for a codec, and names the `derive` declaring it.
test "the codecs the example decodes a request and responds with are derived" {
  let example = one_module_tree(String::of_bytes(embed("../../examples/orders.ply")));
  [
    { codec: "order_json", declaration: "derive json for Order" },
    { codec: "reply_json", declaration: "derive json for Reply" },
  ].fold((), |u: Unit, c: { codec: String, declaration: String }| {
    let shown_by = json_of(in_memory(example, ["show", c.codec, "--json", "."]));
    let rejection = nth(at(shown_by, "diagnostics"), 0);
    assert(
      str(at(rejection, "code")) == "E0101"
        && str(at(nth(at(rejection, "labels"), 0), "snippet")) == c.declaration,
      Some(
        "`" ++ c.codec ++ "` should be declared by `" ++ c.declaration
          ++ "` and written by no `fn`; `ply show` returned "
          ++ json_text(shown_by),
      ),
    )
  })
}
