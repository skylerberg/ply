import harness (scratch, on_disk)
import spawning.harness (write_program, write, all_output, stderr)
import std.process (EnvironmentVariable)
import std.string
import std.list

const service: String = String::of_bytes_lossy(embed("../programs/config_cli/service.ply"))

test "a malformed config file is E0440 naming the file and line" {
  scratch(|| {
    write_program(service);
    [
      { contents: "SERVICE_REGION=eu\nno equals here\n", expected: "no `=`" },
      { contents: "SERVICE_REGION=eu\n=8137\n", expected: "empty key" },
      { contents: "SERVICE_REGION=eu\nSERVICE-PORT=8137\n", expected: "contains" },
    ].fold((), |u: Unit, c: { contents: String, expected: String }| {
      write("bad.env", c.contents);
      let r = on_disk(["hosts", "--config", "bad.env"]);
      let text = stderr(r);
      assert(r.code != 0, Some(text));
      assert(text.contains("E0440"), Some(text));
      assert(text.contains("bad.env"), Some(text));
      assert(text.contains("line 2"), Some(text));
      assert(text.contains(c.expected), Some(text))
    })
  })
}

test "an unreadable config file is E0440" {
  scratch(|| {
    write_program(service);
    let r = on_disk(["hosts", "--config", "absent.env"]);
    assert(r.code != 0, Some(all_output(r)));
    assert(stderr(r).contains("E0440"), Some(stderr(r)));
    assert(stderr(r).contains("absent.env"), Some(stderr(r)))
  })
}

test "`--config-schema` naming a nonexistent definition fails with E0440 and lists the program's definitions" {
  scratch(|| {
    write_program(service);
    let r = on_disk(["hosts", "--config-schema", "m.confg"]);
    assert(r.code != 0, Some(all_output(r)));
    assert(stderr(r).contains("E0440"), Some(stderr(r)));
    assert(stderr(r).contains("m.spec"), Some(stderr(r)))
  })
}
