//! Configuration: `--set` over `--config` files over the environment over a default, each source
//! rejected by name when it is malformed, and a secret that reaches no stream; a test reads the
//! environment as a run does.

import harness (Hermetic, RunWithTree, Shipped, in_memory_faked, one_module_tree, on_disk, returned,
                passing_except, scratch, tree)
import support.harness (RunResult, all_output, at, bool, int, items, json_of, json_text, path,
                        stderr, stdout, str, write, write_program)
import std.fs (MemFs)
import std.json (Json)
import std.machine as entering
import std.process (Var, var)
import std.string
import std.list
import std.value (Value, VBool, VCtor, VList, VRecord, VStr)

fn service() -> String = String::of_bytes_lossy(embed("../programs/config_cli/service.ply"))

fn secret_main() -> String = String::of_bytes_lossy(embed("../programs/config_cli/secret_main.ply"))

/// A key of a `ConfigSpec`, as the value of `config::required` or `config::with_default`.
fn key_value(name: String, shape: String, required: Bool, default: Option<String>) -> Value =
  VRecord([
    {
      name: "default",
      value: match default { Some(d) -> VCtor("Some", [VStr(d)]), None -> VCtor("None", []) },
    },
    { name: "name", value: VStr(name) },
    { name: "required", value: VBool(required) },
    { name: "shape", value: VCtor("std.config." ++ shape, []) },
  ])

/// What `m.spec` of `service` returns.
fn service_spec() -> List<Value> =
  [
    key_value("SERVICE_REGION", "SText", false, Some("us")),
    key_value("SERVICE_PORT", "SInt", true, None),
    key_value("SERVICE_API_KEY", "SSecret", true, None),
  ]

/// What `m.spec` of `secret_main` returns.
fn secret_spec() -> List<Value> = [key_value("SERVICE_API_KEY", "SSecret", true, None)]

/// The entries of a faked run: `m.spec` returns a `ConfigSpec` of `keys`, and everything else passes.
fn spec_of(keys: List<Value>) -> (String) -> entering::Termination =
  |name: String|
    if name == "m.spec" { returned(VRecord([{ name: "keys", value: VList(keys) }])) }
    else { passing_except([])(name) }

/// `ply` over `t` with `vars` in its environment, as `spec_of(keys)` faked.
fn over_schema(
  t: MemFs,
  keys: List<Value>,
  argv: List<String>,
  vars: List<Var>,
) -> RunResult / {Hermetic, Shipped, abort.raise, diverges} =
  in_memory_faked(t, argv, spec_of(keys), [], vars).ran

/// `ply hosts` of `t`, whose whole output is the resolved configuration, so precedence is read from it.
fn hosts(
  t: MemFs,
  keys: List<Value>,
  extra: List<String>,
  vars: List<Var>,
) -> RunResult / {Hermetic, Shipped, abort.raise, diverges} =
  over_schema(t, keys, ["hosts", ".", "--json"].concat(extra), vars)

fn key_of(report: Json, name: String) -> Json / {abort.raise} =
  match items(path(report, ["configuration", "keys"])).filter(|k: Json|
      str(at(k, "name")) == name) {
    [k, ..] -> k,
    [] -> panic("`" ++ name ++ "` is not in " ++ json_text(report)),
  }

fn service_region_key(ran: RunResult) -> Json / {abort.raise} =
  key_of(json_of(ran), "SERVICE_REGION")

test "a malformed config file is E0440 naming the file and line" {
  scratch(|| {
    write_program(service());
    [
      { contents: "SERVICE_REGION=eu\nno equals here\n", expected: "no `=`" },
      { contents: "SERVICE_REGION=eu\n=8137\n", expected: "empty key" },
      { contents: "SERVICE_REGION=eu\nSERVICE-PORT=8137\n", expected: "contains" },
    ].fold((), |u: Unit, c: { contents: String, expected: String }| {
      write("bad.env", c.contents);
      let r = on_disk(["hosts", "--config", "bad.env"]);
      let text = stderr(r);
      assert(r.code != 0, Some(text));
      assert(text.contains("E0440"), Some(text));
      assert(text.contains("bad.env"), Some(text));
      assert(text.contains("line 2"), Some(text));
      assert(text.contains(c.expected), Some(text))
    })
  })
}

test "an unreadable config file is E0440" {
  scratch(|| {
    write_program(service());
    let r = on_disk(["hosts", "--config", "absent.env"]);
    assert(r.code != 0, Some(all_output(r)));
    assert(stderr(r).contains("E0440"), Some(stderr(r)));
    assert(stderr(r).contains("absent.env"), Some(stderr(r)))
  })
}

test "a config schema naming no definition lists what the program has" {
  scratch(|| {
    write_program(service());
    let r = on_disk(["hosts", "--config-schema", "m.confg"]);
    assert(r.code != 0, Some(all_output(r)));
    assert(stderr(r).contains("E0440"), Some(stderr(r)));
    assert(stderr(r).contains("m.spec"), Some(stderr(r)))
  })
}

test "precedence is set, then file, then environment, then default" {
  let t = tree([
    { path: "m.ply", text: service() },
    { path: "deploy.env", text: "SERVICE_REGION=file\n" },
  ]);
  let schema = ["--config-schema", "m.spec", "--set", "SERVICE_PORT=8137"];
  let everything = [var("SERVICE_REGION", "environment"), var("SERVICE_API_KEY", "k")];

  let all = service_region_key(
    hosts(
      t,
      service_spec(),
      schema.concat(["--set", "SERVICE_REGION=set", "--config", "deploy.env"]),
      everything,
    ),
  );
  assert_eq(str(at(all, "value")), "set");
  assert_eq(str(at(all, "source")), "--set");

  let no_set = service_region_key(
    hosts(t, service_spec(), schema.concat(["--config", "deploy.env"]), everything),
  );
  assert_eq(str(at(no_set, "value")), "file");
  assert_eq(str(at(no_set, "source")), "deploy.env");

  let no_files = service_region_key(hosts(t, service_spec(), schema, everything));
  assert_eq(str(at(no_files, "value")), "environment");
  assert_eq(str(at(no_files, "source")), "env");

  let nothing = service_region_key(hosts(t, service_spec(), schema, [var("SERVICE_API_KEY", "k")]));
  assert_eq(str(at(nothing, "value")), "us");
  assert_eq(str(at(nothing, "source")), "default")
}

test "a required key nothing supplies is E0441 at startup" {
  let r = over_schema(
    one_module_tree(service()),
    service_spec(),
    ["run", ".", "--explain", "--config-schema", "m.spec"],
    [],
  );
  let text = stderr(r);
  assert(r.code != 0, Some(text));
  assert(text.contains("E0441"), Some(text));
  assert(text.contains("SERVICE_PORT"), Some(text));
  assert(text.contains("SERVICE_API_KEY"), Some(text));
  assert(text.contains("environment variable"), Some(text));
  assert(
    !text.contains("binding host"),
    Some("the rejection comes before anything is bound: " ++ text),
  )
}

test "a value that is not of its shape is E0442 naming the source" {
  let r = over_schema(
    one_module_tree(service()),
    service_spec(),
    ["run", ".", "--config-schema", "m.spec", "--set", "SERVICE_PORT=eight"],
    [var("SERVICE_API_KEY", "k")],
  );
  let text = stderr(r);
  assert(r.code != 0, Some(text));
  assert(text.contains("E0442"), Some(text));
  assert(text.contains("SERVICE_PORT"), Some(text));
  assert(text.contains("--set"), Some(text));
  assert(text.contains("eight"), Some("a plain value is shown: " ++ text))
}

// The one rejection that must not quote what it rejected.
test "a malformed secret is E0442 and prints no value" {
  let r = over_schema(
    one_module_tree(service()),
    service_spec(),
    [
      "run",
      ".",
      "--config-schema",
      "m.spec",
      "--set",
      "SERVICE_PORT=8137",
      "--set",
      "SERVICE_API_KEY=",
    ],
    [],
  );
  let text = stderr(r);
  assert(r.code != 0, Some(text));
  assert(text.contains("E0442"), Some(text));
  assert(text.contains("SERVICE_API_KEY"), Some(text));
  assert(text.contains("not printed"), Some(text))
}

test "an undeclared set warns and an undeclared environment key does not" {
  let r = over_schema(
    one_module_tree(service()),
    service_spec(),
    [
      "hosts",
      ".",
      "--config-schema",
      "m.spec",
      "--set",
      "SERVICE_PORT=8137",
      "--set",
      "SERVICE_PROT=8138",
    ],
    [var("SERVICE_API_KEY", "k"), var("AWS_PROFILE", "nothing to do with this program")],
  );
  assert(r.code == 0, Some(stderr(r)));
  assert(all_output(r).contains("W0607"), Some(all_output(r)));
  assert(all_output(r).contains("SERVICE_PROT"), Some(all_output(r)));
  assert(
    !all_output(r).contains("AWS_PROFILE"),
    Some("an environment name is not a typo somebody made in this run: " ++ all_output(r)),
  )
}

test "the JSON report carries a secret's key and source and not its value" {
  let r = hosts(one_module_tree(secret_main()), secret_spec(), ["--config-schema", "m.spec"], [
    var("SERVICE_API_KEY", "correct-horse"),
  ]);
  let key = key_of(json_of(r), "SERVICE_API_KEY");
  assert_eq(str(at(key, "value")), "****");
  assert_eq(str(at(key, "source")), "env");
  assert(bool(at(key, "secret")), Some(json_text(key)));
  assert(!stdout(r).contains("correct-horse"), Some(stdout(r)))
}

test "a test supplying configuration is det and cached" {
  let first = in_memory_faked(
    one_module_tree(service()),
    ["test", ".", "--json"],
    passing_except([]),
  );
  let report = json_of(first.ran);
  assert(bool(at(report, "ok")), Some(json_text(report)));
  let second = json_of(
    in_memory_faked(first.tree, ["test", ".", "--json"], passing_except([])).ran,
  );
  assert(bool(at(second, "ok")), Some(json_text(second)));
  assert(
    int(path(second, ["summary", "cached"])) == 1,
    Some("the second run is a cache hit: " ++ json_text(second)),
  );
  assert(int(path(second, ["selection", "selected"])) == 0, Some(json_text(second)));
  assert(int(path(second, ["selection", "same_code"])) == 0, Some(json_text(second)))
}

test "an unhandled config read in a det test is E0412" {
  let r = in_memory_faked(
    one_module_tree(
      \\import std.config
      \\import std.config (config)
      \\
      \\pub fn region() -> Option<String> / {config.read[server]} =
      \\  config.get[server]("SERVICE_REGION")
      \\
      \\test "reaches the environment" {
      \\  assert_eq(region(), None)
      \\}
      \\
    ),
    ["test", "."],
    passing_except([]),
  ).ran;
  assert(r.code != 0, Some(stderr(r)));
  assert(stderr(r).contains("E0412"), Some(stderr(r)))
}
