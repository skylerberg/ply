//! Tagged literals as a load resolves them: `tag"text"` is the call `tag::literal("text")`, run
//! before the program is, and a text its parser rejects is rejected where the parser says, by every
//! command that would otherwise run it. One with holes is resolved on its texts alone, by its tag's
//! `compile`, and its holes are its tag's `fill`'s when the program runs.

import harness (in_memory, in_memory_with_tree, tree)
import spawning.harness (assert_ok, diagnostic_codes, json_of)
import std.fs
import std.json (Json)
import std.string

/// A raise and what raises it, for a module that handles the raise around a literal.
fn raising() -> String =
  \\effect p { raise bad(n: Int) }
  \\
  \\fn g(n: Int) -> Int / {p.bad} = if n > 0 { n } else { p.bad(n) }
  \\
  \\

test "a `try` checked before is rejected once its module binds `Ok`, as a literal is" {
  let tried = raising() ++ "pub fn f(n: Int) -> Result<Int, Int> = try { g(n) }\n";
  let first = in_memory_with_tree(
    tree([
      { path: "lib.ply", text: tried },
      {
        path: "m.ply",
        text: "import lib\n\nfn main() -> Int = match lib::f(3) { Ok(n) -> n, Err(e) -> e }\n",
      },
    ]),
    ["check", "--explain"],
    [],
    None,
  );
  assert_ok(first.ran);
  let bound = fs::mem_write(
    first.tree,
    "w/lib.ply",
    Bytes::of_string(tried ++ "\npub type Mine = | Ok(Int) | No\n\npub fn mine() -> Mine = No\n"),
  ).fs;
  assert_eq(diagnostic_codes(json_of(in_memory(bound, ["check", "--json"]))), ["E0118"])
}
