import harness (in_memory, in_memory_with_tree, tree)
import spawning.harness (assert_ok, diagnostic_codes, json_of)
import std.fs
import std.json (Json)
import std.string

const raising: String =
  \\effect p { raise bad(n: Int) }
  \\
  \\fn g(n: Int) -> Int / {p.bad} = if n > 0 { n } else { p.bad(n) }
  \\
  \\

test "a `try` that passed `ply check` is rejected with E0118 after its module defines its own `Ok`, as a tagged literal would be" {
  let tried = raising ++ "pub fn f(n: Int) -> Result<Int, Int> = try { g(n) }\n";
  let first = in_memory_with_tree(
    tree([
      { path: "lib.ply", text: tried },
      {
        path: "m.ply",
        text: "import lib\n\nfn main() -> Int = match lib::f(3) { Ok(n) -> n, Err(e) -> e }\n",
      },
    ]),
    ["check", "--explain"],
    [],
    None,
  );
  assert_ok(first.ran);
  let bound = fs::mem_write(
    first.tree,
    "w/lib.ply",
    Bytes::of_string(tried ++ "\npub type Mine = | Ok(Int) | No\n\npub fn mine() -> Mine = No\n"),
  ).fs;
  assert_eq(diagnostic_codes(json_of(in_memory(bound, ["check", "--json"]))), ["E0118"])
}
