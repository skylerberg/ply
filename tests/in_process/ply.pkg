import std.pkg (Manifest)

// The compiler and the `ply` program as code this suite calls in its own process. Its modules answer
// here as `compiler.*` and `cli.*`, and what it shares with `tests/cli` as `spawning.*`.
fn package() -> Manifest = {
  name: "inprocesstests",
  version: { major: 0, minor: 1, patch: 0 },
  prefix: None,
  runtime: { major: 0, minor: 16, patch: 0 },
  dependencies: [
    {
      name: "cli",
      prefix: None,
      min: { major: 0, minor: 1, patch: 0 },
      source: Path("../../packages/cli"),
    },
    {
      name: "spawning",
      prefix: None,
      min: { major: 0, minor: 1, patch: 0 },
      source: Path("../spawning"),
    },
  ],
  entry: None,
}
