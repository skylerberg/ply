import harness (scratch, warm_matches_cold)
import spawning.harness (write_program, write)
import std.string

fn source(web: String) -> String =
  \\effect store {
  \\  read  all[r]() -> List<Int>
  \\  write save[r](rows: List<Int>) -> Unit
  \\}
  \\
    ++ "\n"
    ++ web
    ++ "\n\n"
    ++
    \\fn list_orders() -> Int / {Web} = store.all[orders]().len()
    \\
    \\fn health() -> Int = 200
    \\
    \\test "orders are listed" {
    \\  handle { assert_eq(list_orders(), 0) } with { store.all[orders]() -> [] }
    \\}
    \\
    \\test "health is 200" {
    \\  assert_eq(health(), 200)
    \\}
    \\

fn web_effects_source() -> String = "effect set Web = {store.read[orders], store.write[audit]}"

test "a check with a cached state gives the same result as a check from scratch after a sequence of effect set edits" {
  scratch(|| {
    write_program(source(web_effects_source()));
    let steps = [
      web_effects_source(),
      "effect set Web = {store.write[audit], store.read[orders]}",
      "effect set Inner = {store.read[orders]}\neffect set Web = {Inner, store.write[audit]}",
      "effect set Inner = {store.read[orders], store.read[inventory]}\neffect set Web = {Inner, store.write[audit]}",
      web_effects_source() ++ "\neffect set Unused = {store.read[nothing]}",
    ];
    range(0, steps.len()).fold((), |u: Unit, i: Int| {
      write("m.ply", source(match steps.at(i) { Some(w) -> w, None -> "" }));
      let _ = warm_matches_cold("step " ++ i.to_string());
      u
    })
  })
}
