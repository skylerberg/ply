import harness (scratch, in_memory, on_disk, tree, one_module_tree, Hermetic, Shipped)
import spawning.harness (Source, spawned, write_program, write_project, stdout, stderr, all_output,
                         json_of, at, path, nth, items, str, int, bool, json_text, code_of,
                         diagnostic, not_ok)
import std.json
import std.json (Json, Null, Array, Str)
import std.string

const green: String = String::of_bytes_lossy(embed("../programs/commands/green.ply"))

const broken: String = "fn f() -> Int = true\n"

const unparseable: String = "fn f(( = )\n"

fn diagnostic_with_code(v: Json, code: String) -> Json / {abort.raise} =
  match items(at(v, "diagnostics")).filter(|d: Json| str(at(d, "code")) == code) {
    [d, ..] -> d,
    [] -> panic("no " ++ code ++ ": " ++ json_text(v)),
  }

test "check accepts a good module" {
  let r = in_memory(one_module_tree(green), ["check"]);
  assert(r.code == 0, Some(all_output(r)));
  assert(stdout(r).contains("checked 2 modules, 2 definitions, 2 tests"), Some(stdout(r)))
}

test "check --types prints signatures and effects" {
  let r = in_memory(
    one_module_tree(
      "effect db {\n  read all[t]() -> List<Int>\n}\nfn rows() -> List<Int> / {db.read[users]} = db.all[users]()\n",
    ),
    ["check", "--types"],
  );
  assert(r.code == 0, Some(all_output(r)));
  assert(
    stdout(r).contains("     rows : () -> List<Int>\n            / {m.db.read[users] bounded}\n"),
    Some(stdout(r)),
  );
  assert(stdout(r).contains("effect db"), Some(stdout(r)))
}

test "`check` fails with E0302 on a function that may not terminate and lacks `diverges` in its effects" {
  let unwritten = in_memory(one_module_tree("fn spin(n: Int) -> Int = spin(n + 1)\n"), [
    "check",
    "--json",
  ]);
  assert(unwritten.code == 2, Some(all_output(unwritten)));
  assert(
    str(at(diagnostic_with_code(json_of(unwritten), "E0302"), "message"))
      == "`spin` may not return, and its effects do not say so",
    Some(all_output(unwritten)),
  );
  let src = "fn spin(n: Int) -> Int / {diverges} = spin(n + 1)\n\nfn wait(n: Int) -> Int / {diverges} = spin(n)\n\nfn down(n: Int) -> Int = if n <= 0 { 0 } else { down(n - 1) }\n";
  let r = in_memory(one_module_tree(src), ["check", "--types"]);
  assert(r.code == 0, Some(all_output(r)));
  assert(
    stdout(r).contains(
      "diverges: its recursion at m.ply:1:39 does not clearly shrink its argument, so it may never end",
    ),
    Some(stdout(r)),
  );
  assert(
    stdout(r).contains("diverges: calls `m.spin` at m.ply:3:39, which may not return"),
    Some(stdout(r)),
  );
  let v = json_of(in_memory(one_module_tree(src), ["check", "--json"]));
  let ending = |name: String|
    match items(at(v, "definitions")).filter(|d: Json| str(at(d, "name")) == name) {
      [d, ..] -> at(d, "ending"),
      [] -> Null,
    };
  assert(str(at(ending("m.down"), "kind")) == "ends", Some(json_text(v)));
  assert(str(at(ending("m.spin"), "kind")) == "diverges", Some(json_text(v)));
  assert(at(ending("m.spin"), "through") == Null, Some(json_text(v)));
  assert(str(at(ending("m.spin"), "at")) == "m.ply:1:39", Some(json_text(v)));
  assert(str(at(ending("m.wait"), "through")) == "m.spin", Some(json_text(v)));
  assert(str(at(ending("m.wait"), "at")) == "m.ply:3:39", Some(json_text(v)))
}

test/nondet "`check --types` and `check --json` report why each function with `diverges` may not terminate, and which functions do terminate" {
  let climb = "fn climb(a: Int, b: Int) -> Int decreases a + b = if a + b <= 0 { 0 } else { climb(a + 1, b - 2) }\n";
  let v = json_of(in_memory(one_module_tree(climb), ["check", "--json"]));
  assert(!not_ok(v), Some(json_text(v)));
  assert(
    items(at(v, "definitions")).filter(|d: Json|
        str(at(d, "name")) == "m.climb" && str(at(at(d, "ending"), "kind")) == "stated")
      != [],
    Some(json_text(v)),
  );
  let stall = "fn stall(n: Int) -> Int decreases n = if n <= 0 { 0 } else { stall(n) }\n";
  let r = in_memory(one_module_tree(stall), ["check", "--json"]);
  assert(r.code == 2, Some(all_output(r)));
  let d = diagnostic_with_code(json_of(r), "E0467");
  assert(
    json_text(at(d, "notes")).contains(
      "at some recursive call the termination measure is negative or does not decrease",
    ),
    Some(json_text(d)),
  );
  write_program(stall ++ "fn main() -> Int = stall(0)\n");
  assert(spawned(["run", "."]).code == 2)
}

fn lookups(handler: String) -> String =
  "effect db {\n  read query[c](sql: String) -> List<Int>\n}\n\nfn lookup(id: Int) -> List<Int> / {db.query[conn]} = db.query[conn](\"one \" ++ id.to_string())\n\nfn lookup_all(ids: List<Int>) -> List<List<Int>> / {db.query[conn]} = ids.map(lookup)\n\n"
    ++ handler

test "`check --types` marks a single database query as `bounded` and the same query mapped over a list as `scaling`" {
  let r = in_memory(one_module_tree(lookups("")), ["check", "--types"]);
  assert(r.code == 0, Some(all_output(r)));
  assert(
    stdout(r).contains(
      "lookup     : (Int) -> List<Int>\n                  / {m.db.query[conn] bounded}\n",
    ),
    Some(stdout(r)),
  );
  assert(
    stdout(r).contains(
      "lookup_all : (List<Int>) -> List<List<Int>>\n                  / {m.db.query[conn] scaling}\n",
    ),
    Some(stdout(r)),
  )
}

test "a `bounded` handler that runs one query per list element fails `check` with E0465" {
  let per_item = in_memory(
    one_module_tree(
      lookups(
        "fn respond(ids: List<Int>) -> Int / {db.query[conn] bounded} =\n  ids.fold(0, |n: Int, id: Int| n + lookup(id).len())\n",
      ),
    ),
    ["check"],
  );
  assert(per_item.code != 0, Some(all_output(per_item)));
  let rejection = all_output(per_item);
  assert(rejection.contains("E0465"), Some(rejection));
  assert(rejection.contains("`db.query[conn]` grows with the input"), Some(rejection));
  assert(rejection.contains("once for each element this iterates over"), Some(rejection));
  let batched = in_memory(
    one_module_tree(
      lookups(
        "fn respond(ids: List<Int>) -> Int / {db.query[conn] bounded} =\n  db.query[conn](\"in \" ++ ids.len().to_string()).len()\n",
      ),
    ),
    ["check"],
  );
  assert(batched.code == 0, Some(all_output(batched)))
}

test "a `bounded` handler that sends one query for the whole list passes `check`" {
  let r = in_memory(
    one_module_tree(
      \\fn grows_last(n: Int, xs: List<Int>) -> List<Int> =
      \\  if n <= 0 { xs } else { grows_last(n - 1, xs.push(n)) }
      \\fn grows_shared(xs: List<Int>, n: Int) -> List<Int> = {
      \\  let ys = xs.push(n);
      \\  if xs.len() < 0 { xs } else if n <= 0 { ys } else { grows_shared(ys, n - 1) }
      \\}
      \\
    ),
    ["check", "--costs"],
  );
  assert(r.code == 0, Some(all_output(r)));
  let text = stdout(r);
  assert(
    text.contains("m.grows_last  1 reuses"),
    Some("the last-use spelling must read `reuses`:\n" ++ text),
  );
  assert(
    text.contains("m.grows_shared  1 COPIES"),
    Some("the read-again spelling must read `COPIES`:\n" ++ text),
  );
  assert(
    text.contains("fix: make the update the last use of the variable"),
    Some("a copy must name its edit:\n" ++ text),
  );
  assert(!text.contains("copy("), Some("`copy` is never the recommended fix:\n" ++ text));
  assert(
    text.contains("2 updates: 1 reuse, 1 copy, 0 undecided"),
    Some("the whole-program tally:\n" ++ text),
  )
}

test "check --costs reports when there is nothing to cost" {
  let r = in_memory(one_module_tree(green), ["check", "--costs"]);
  assert(r.code == 0, Some(all_output(r)));
  assert(
    stdout(r).contains("no `update` functions found: there are no copy costs to report"),
    Some(stdout(r)),
  )
}

test "check exits two on a type error and prints nothing on stdout" {
  let r = in_memory(one_module_tree(broken), ["check"]);
  assert(r.code == 2, Some(all_output(r)));
  assert(stdout(r) == "", Some(stdout(r)));
  assert(stderr(r).contains("E0201"), Some("expected a type mismatch, got:\n" ++ stderr(r)))
}

test/nondet "a test whose body ends on a value is a type error" {
  let t = one_module_tree("test \"t\" { 1 }\n");
  let r = in_memory(t, ["check"]);
  assert(r.code == 2, Some(all_output(r)));
  assert(stdout(r) == "", Some(stdout(r)));
  [
    "Error[E0201]: type mismatch: the body of test `t`",
    "expected `Unit`, found `Int`",
    "= fix: end the body with `()`",
  ].fold((), |u: Unit, s: String|
    assert(stderr(r).contains(s), Some("no " ++ s ++ " in:\n" ++ stderr(r))));
  write_program("test \"t\" { 1 }\n");
  let tested = spawned(["test", ".", "--json"]);
  assert(tested.code == 2, Some(all_output(tested)));
  assert(code_of(json_of(tested)) == "E0201", Some(all_output(tested)))
}

test "check exits two on a syntax error" {
  let r = in_memory(one_module_tree(unparseable), ["check"]);
  assert(r.code == 2, Some(all_output(r)));
  assert(stderr(r).contains("E0001"), Some(stderr(r)))
}

test "check --json is a single object even when the module is broken" {
  let r = in_memory(one_module_tree(broken), ["check", "--json"]);
  assert(r.code == 2, Some(all_output(r)));
  let v = json_of(r);
  assert(str(at(v, "command")) == "check", Some(json_text(v)));
  assert(not_ok(v), Some(json_text(v)));
  assert(code_of(v) == "E0201", Some(json_text(v)));
  let label = nth(at(diagnostic(v), "labels"), 0);
  assert(str(at(label, "file")) == "m.ply", Some(json_text(v)));
  assert(int(path(label, ["start", "line"])) == 1, Some(json_text(v)))
}

test "calling a function generic over an effect label without giving the label fails with E0306" {
  let generic = "effect net {\n  write send[s](payload: Bytes) -> Unit\n}\nfn relay<[l]>(b: Bytes) -> Unit / {net.send[l]} = net.send[l](b)\n";
  [
    {
      tail: "fn go(b: Bytes) -> Unit / {net.send[conn]} = relay(b)\n",
      message: "this call has a label of `relay` unfilled",
    },
    {
      tail: "fn go(b: Bytes) -> Unit / {net.send[conn]} = relay[conn, spare](b)\n",
      message: "`relay` takes 1 label parameter, but 2 are written",
    },
    {
      tail: "fn as_value() -> (Bytes) -> Unit / {net.send[conn]} = relay\n",
      message: "`relay` must be called directly",
    },
  ].fold((), |u: Unit, c: { tail: String, message: String }| {
    let r = in_memory(one_module_tree(generic ++ c.tail), ["check", "--json"]);
    assert(r.code == 2, Some(c.tail));
    let v = json_of(r);
    assert(not_ok(v), Some(c.tail));
    let d = diagnostic_with_code(v, "E0306");
    assert(str(at(d, "message")) == c.message, Some(c.tail ++ json_text(d)));
    assert(
      items(at(d, "notes")) != [],
      Some(c.tail ++ " left the reader nothing to do: " ++ json_text(d)),
    )
  })
}

const multi_module: List<Source> =
  [
    { path: "src/a.ply", text: "pub fn a() -> Int = 1\n" },
    { path: "src/z.ply", text: "import src.a\npub fn z() -> Int = a::a() + 1\n" },
    { path: "src/t.ply", text: "import src.z (z)\ntest \"z is two\" { assert_eq(z(), 2) }\n" },
  ]

test/nondet "calling a function generic over an effect label with too many labels fails with E0306" {
  write_project(multi_module);
  let r = spawned(["test", "."]);
  assert(r.code == 0, Some(all_output(r)));
  assert(stdout(r).contains("selected 1 of 1"), Some(stdout(r)));
  let v = json_of(in_memory(tree(multi_module), ["check", "--json"]));
  assert(
    at(v, "files")
      == Array([Str("src/a.ply"), Str("src/t.ply"), Str("src/z.ply"), Str("<std>/prelude.ply")]),
    Some(json_text(v)),
  );
  assert(
    items(at(v, "modules")).map(|m: Json| str(at(m, "name")))
      == ["src.a", "src.t", "src.z", "std.prelude"],
    Some(json_text(v)),
  );
  assert(str(at(nth(at(v, "definitions"), 0), "name")) == "src.a.a", Some(json_text(v)));
  assert(str(at(nth(at(v, "tests"), 0), "key")) == "src.t.z is two", Some(json_text(v)))
}

fn failed_check_report(files: List<Source>) -> Json / {Hermetic, Shipped, abort.raise, diverges} = {
  let r = in_memory(tree(files), ["check", "--json"]);
  assert(r.code == 2, Some(all_output(r)));
  json_of(r)
}

test "using a function generic over an effect label as a value instead of calling it fails with E0306" {
  let v = failed_check_report([
    { path: "a.ply", text: "pub fn a() -> Int = 1\n" },
    { path: "b.ply", text: "fn b() -> Int = a()\n" },
  ]);
  assert(code_of(v) == "E0101", Some(json_text(v)))
}

test "calling a private function from another file fails with E0107" {
  let v = failed_check_report([
    { path: "a.ply", text: "fn secret() -> Int = 1\n" },
    { path: "b.ply", text: "import a\nfn b() -> Int = a::secret()\n" },
  ]);
  assert(code_of(v) == "E0107", Some(json_text(v)))
}

test "a module cycle is rejected with exit two" {
  let v = failed_check_report([
    { path: "a.ply", text: "import b\npub fn a() -> Int = b::b()\n" },
    { path: "b.ply", text: "import a\npub fn b() -> Int = a::a()\n" },
  ]);
  assert(code_of(v) == "E0109", Some(json_text(v)))
}

test "a file whose name is not a valid module name fails with E0111, and the error names that file" {
  let v = failed_check_report([{ path: "not-a-module.ply", text: "fn f() -> Int = 1\n" }]);
  assert(code_of(v) == "E0111", Some(json_text(v)));
  assert(
    str(at(nth(at(diagnostic(v), "labels"), 0), "file")) == "not-a-module.ply",
    Some(json_text(v)),
  )
}

test "a missing path is a diagnostic with exit two" {
  let r = in_memory(tree([]), ["check", "nowhere.ply"]);
  assert(r.code == 2, Some(all_output(r)));
  assert(stderr(r).contains("nowhere.ply"), Some(stderr(r)))
}

test "`hosts` on a program that performs no host effects exits 0 and prints why the list is empty" {
  scratch(|| {
    write_program(green);
    let r = on_disk(["hosts"]);
    assert(r.code == 0, Some(all_output(r)));
    assert(
      stdout(r).contains("none handles an effect this program performs"),
      Some(
        "an empty listing is indistinguishable from a registry that failed to load:\n" ++ stdout(r),
      ),
    );
    assert(r.out.filter(|l: String| l.ascii_trim() != "").len() >= 2, Some(stdout(r)))
  })
}

test "hosts is byte-identical across runs" {
  scratch(|| {
    write_program(green);
    let once = on_disk(["hosts"]);
    let twice = on_disk(["hosts"]);
    assert(once.code == 0, Some(all_output(once)));
    assert(stdout(once) == stdout(twice), None);
    assert(
      stdout(once).contains("full access to the host, so you must trust them"),
      Some(stdout(once)),
    );
    assert(stdout(once).contains("digest: b3:"), Some(stdout(once)))
  })
}

test "hosts --digest is one line, the digest the JSON carries" {
  scratch(|| {
    write_program(green);
    let bare = on_disk(["hosts", "--digest"]);
    assert(bare.code == 0, Some(all_output(bare)));
    assert(bare.out.len() == 1, Some(stdout(bare)));
    let digest = String::join(bare.out, "");
    assert(digest.starts_with("b3:"), Some(digest));
    let v = json_of(on_disk(["hosts", "--json"]));
    assert(str(at(v, "digest")) == digest.ascii_trim(), Some(json_text(v)))
  })
}

test "hosts --json is one object carrying every row" {
  scratch(|| {
    write_program(green);
    let v = json_of(on_disk(["hosts", "--json"]));
    assert(str(at(v, "command")) == "hosts", Some(json_text(v)));
    assert(int(at(v, "schema_version")) == 1, Some(json_text(v)));
    assert(bool(at(v, "ok")), Some(json_text(v)));
    assert(int(at(v, "exit_code")) == 0, Some(json_text(v)));
    assert(match at(v, "hosts") { Array(_) -> true, _ -> false }, Some(json_text(v)));
    assert(
      int(at(v, "operations")) == items(at(v, "hosts")).len(),
      Some("the count and the rows are one claim"),
    )
  })
}

test "hosts on a broken program is a compile error with a clean stdout" {
  scratch(|| {
    write_program(broken);
    let r = on_disk(["hosts"]);
    assert(r.code == 2, Some(all_output(r)));
    assert(stdout(r) == "", Some(stdout(r)));
    assert(stderr(r).contains("E0201"), Some(stderr(r)))
  })
}

test "hash prints a short hash per definition" {
  let r = in_memory(one_module_tree(green), ["hash"]);
  assert(r.code == 0, Some(all_output(r)));
  assert(stdout(r).contains("double"), Some(stdout(r)));
  assert(stdout(r).contains("2 definitions · 2 tests · 2 modules"), Some(stdout(r)))
}

test "hash --dependencies shows the graph" {
  let text = stdout(in_memory(one_module_tree(green), ["hash", "--dependencies"]));
  assert(text.contains("deps: m.double"), Some(text));
  assert(text.contains("closure:"), Some(text))
}

test "`hash --json` prints full 64-character hashes and each definition's dependency list" {
  let v = json_of(in_memory(one_module_tree(green), ["hash", "--json", "--dependencies"]));
  assert(str(at(v, "command")) == "hash", Some(json_text(v)));
  let definition = nth(at(v, "definitions"), 0);
  assert(str(at(definition, "hash")).len() == 64, Some(json_text(v)));
  assert(match at(definition, "closure") { Array(_) -> true, _ -> false }, Some(json_text(v)));
  assert(str(at(nth(at(v, "tests"), 0), "hash")).len() == 64, Some(json_text(v)))
}

test "hash groups by module and reports that the module is not hashed" {
  let text = stdout(in_memory(tree(multi_module), ["hash"]));
  assert(text.contains("src.a"), Some(text));
  assert(text.contains("src.z"), Some(text));
  assert(text.contains("2 definitions · 1 test · 4 modules"), Some(text));
  assert(text.contains("changes no hash"), Some(text));
  let v = json_of(in_memory(tree(multi_module), ["hash", "--json"]));
  assert(at(v, "module_is_hashed") == json::Bool(false), Some(json_text(v)));
  let definition = nth(at(v, "definitions"), 0);
  assert(str(at(definition, "module")) == "src.a", Some(json_text(v)));
  assert(str(at(definition, "name")) == "src.a.a", Some(json_text(v)));
  assert(str(at(definition, "simple_name")) == "a", Some(json_text(v)))
}

test "every subcommand responds to --help and exits zero" {
  ["check", "test", "run", "hash", "cache"].fold((), |u: Unit, sub: String| {
    let r = in_memory(tree([]), [sub, "--help"]);
    assert(r.code == 0, Some("`" ++ sub ++ " --help` failed:\n" ++ all_output(r)));
    assert(stdout(r) != "", Some("`" ++ sub ++ " --help` printed nothing"))
  })
}

test "an unknown subcommand is rejected" {
  assert(in_memory(tree([]), ["frobnicate"]).code != 0, None)
}
