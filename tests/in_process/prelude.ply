import compiler.front.published (BuiltinRow, shipped_builtin_rows)
import compiler.check.types (Effect, FunctionType)
import compiler.emit.layout (Intrinsic, intrinsics)
import compiler.unit (Unbound, shipped, shipped_runtime, unbound)
import compiler.emit.abi (Native, natives, runtime_mismatches, mismatch_line)
import compiler.check.infer.definitions (Extern, program_natives)
import harness (std_modules, compiler_modules, ShippedModule)
import std.bytes
import std.list
import std.string

fn quoted(name: Bytes) -> String / {abort.raise} = "`" ++ String::of_bytes(name) ++ "`"

fn modules_with_natives() -> List<ShippedModule> / {abort.raise} =
  std_modules().concat(
    compiler_modules().filter(|m: ShippedModule| m.source.index_of(b"extern fn ") != None),
  )

fn builtin_rows() -> List<BuiltinRow> / {abort.raise} =
  shipped_builtin_rows(
    modules_with_natives().map(|m: ShippedModule|
      { name: Bytes::of_string(m.module), source_text: m.source }),
  )

fn runtime_natives() -> Map<Bytes, Native> / {shipped.runtime, abort.raise} =
  shipped_runtime().natives.fold(Map::new(), |accumulator: Map<Bytes, Native>, n: Native|
    accumulator.insert(n.name, n))

test "every runtime function implemented in native code is declared exactly once, with the same signature, by the compiler or a shipped module" {
  let runtime_natives = shipped_runtime().natives.map(|n: Native| n.name);
  let declared = program_natives(
    modules_with_natives().map(|m: ShippedModule|
      { name: Bytes::of_string(m.module), text: m.source }),
  );
  assert_eq(
    unbound(
      shipped_runtime().natives,
      declared.filter(|d: Extern| runtime_natives.contains(d.name)),
    ).map(|u: Unbound| u.declared.name),
    [],
  );
  let names = declared.map(|d: Extern| d.name).concat(builtin_rows().map(|r: BuiltinRow| r.name));
  assert_eq(runtime_natives.filter(|n: Bytes| !names.contains(n)), [])
}

test "the runtime linked into this `ply` matches the signatures of the functions the compiler's generated C calls" {
  let runtime = shipped_runtime();
  assert_eq(runtime_mismatches(runtime).map(mismatch_line), []);
  let found = runtime_natives();
  assert_eq(natives().filter(|d: Native| found.get(d.name) != Some(d)).map(|d: Native| d.name), [])
}

test "no runtime function is also compiled inline as an intrinsic by the code generator" {
  let natives = shipped_runtime().natives.map(|n: Native| n.name);
  let runtime_natives = intrinsics().filter(|i: { name: Bytes, operation: Intrinsic }|
    natives.contains(i.name.slice(b"std.prelude.".len(), i.name.len())));
  assert_eq(runtime_natives.map(|i: { name: Bytes, operation: Intrinsic }| i.name), [])
}

test "every builtin the runtime implements is one a program can call" {
  let typed = builtin_rows().fold(Map::new(), |accumulator: Map<Bytes, Bool>, row: BuiltinRow|
    accumulator.insert(row.name, true));
  let untyped = shipped_runtime().natives.map(|n: Native| n.name).filter(|n: Bytes|
    !typed.contains(n) && !n.starts_with(b"?"));
  assert(
    untyped.len() == 0,
    Some("builtins no shipped module declares: " ++ String::of_bytes(Bytes::join(untyped, b", "))),
  )
}

fn typed_raises(row: BuiltinRow) -> Bool =
  match row.scheme.ty {
    FunctionType(f) -> f.effects.listed.filter(|a: Effect| a.effect == b"abort").len() > 0,
    _ -> false,
  }

test "every builtin can raise exactly when its declared type says it can" {
  let runtime = runtime_natives();
  builtin_rows().fold((), |_u: Unit, row: BuiltinRow|
    match runtime.get(row.name) {
      None -> (),
      Some(n) ->
        assert(
          n.raises == typed_raises(row),
          Some(
            quoted(row.name) ++ (if typed_raises(row) { " raises" } else { " cannot raise" })
              ++ " by its scheme, and the runtime says "
              ++ (if n.raises { "it raises" } else { "it cannot" }),
          ),
        ),
    })
}
