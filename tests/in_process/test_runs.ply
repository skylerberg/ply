import harness (on_disk_shipping, Shipped)
import spawning.harness (spawned, Source, write_program, stdout, path)
import compiler.unit (shipped)
import std.json
import std.string
import std.list

const green: String = String::of_bytes_lossy(embed("../programs/test_runs/green.ply"))

fn rehashed_definitions(names: List<String>, to: String) -> List<Source> / {Shipped, abort.raise} =
  [
    {
      path: "definitions",
      text: String::join(
        String::of_bytes(shipped.definitions()).split("\n").map(|line: String|
          match names.filter(|n: String| line.starts_with(n ++ " ")) {
            [n, ..] -> n ++ " " ++ to,
            [] -> line,
          }),
        "\n",
      ),
    },
  ]

test/nondet "a compiler change that leaves a test's code alone re-runs nothing" {
  write_program(green);
  assert(spawned(["test", "."]).code == 0, None);
  let deciding = stdout(
    on_disk_shipping(["test"], rehashed_definitions(["tests.run.selected"], "a")),
  );
  assert(
    deciding.contains("selected 0 of 2 (2 cached, 2 by code)"),
    Some("a pass was not found by the code its test ran:\n" ++ deciding),
  );
  let refiled = stdout(
    on_disk_shipping(
      ["test"],
      rehashed_definitions(["tests.run.selected", "tests.concluded.run_job"], "a"),
    ),
  );
  assert(refiled.contains("selected 0 of 2 (2 cached)"), Some(refiled));
  let running = stdout(
    on_disk_shipping(
      ["test"],
      rehashed_definitions(["tests.run.selected", "tests.concluded.run_job"], "b"),
    ),
  );
  assert(
    running.contains("selected 2 of 2 (0 cached)"),
    Some("a change to what runs a test re-ran nothing:\n" ++ running),
  )
}
