import harness (RunWithTree, in_memory, in_memory_with_tree, one_module_tree, tree, file_of,
                on_disk_with, Hermetic, Shipped)
import spawning.harness (spawned, Source, write_project, read, stdout, stderr, json_of, at, nth,
                         items, str, int, bool, json_text, manifest, value_of)
import std.fs (MemFs)
import std.json (Json)
import std.string

fn source() -> String =
  \\// The base.
  \\fn one() -> Int = 1
  \\
  \\// Doubles the base.
  \\pub fn two() -> Int = one() + one()  // twice
  \\
  \\fn three() -> Int = two() + 1
  \\

fn two() -> String =
  \\// Doubles the base.
  \\pub fn two() -> Int = one() + one()  // twice
  \\

fn own_hashes(
  t: MemFs,
) -> List<{ name: String, own: String }> / {Hermetic, Shipped, abort.raise, diverges} = {
  let v = json_of(in_memory(t, ["definitions", "--json"]));
  assert(int(at(v, "exit_code")) == 0, Some(json_text(v)));
  items(at(v, "definitions")).map(|d: Json| { name: str(at(d, "name")), own: str(at(d, "own")) })
}

fn run_with_stdin(
  t: MemFs,
  argv: List<String>,
  stdin: Option<String>,
) -> RunWithTree / {Hermetic, Shipped, abort.raise, diverges} =
  in_memory_with_tree(t, argv, [], stdin)

fn module_text(k: RunWithTree) -> String / {abort.raise} =
  match file_of(k.tree, "m.ply") { Some(t) -> t, None -> "" }

test "show prints the definition with the comment above it and its place" {
  let r = in_memory(one_module_tree(source()), ["show", "two"]);
  assert(r.code == 0, Some(stderr(r)));
  assert_eq(stdout(r), two());

  let v = json_of(in_memory(one_module_tree(source()), ["show", "m.two", "--json"]));
  assert_eq(str(at(v, "command")), "show");
  assert(bool(at(v, "ok")), Some(json_text(v)));
  assert_eq(str(at(v, "name")), "m.two");
  assert_eq(str(at(v, "file")), "m.ply");
  assert_eq(str(at(v, "source")), two());
  let spanned = String::of_bytes(
    Bytes::of_string(source()).slice(int(at(v, "start")), int(at(v, "end"))),
  );
  assert_eq(spanned, two());

  let missing = json_of(in_memory(one_module_tree(source()), ["show", "four", "--json"]));
  assert_eq(int(at(missing, "exit_code")), 2);
  assert_eq(str(at(nth(at(missing, "diagnostics"), 0), "code")), "E0101")
}

test "`replace` rewrites only the named definition and leaves the hash of every other definition unchanged" {
  let t = tree([
    { path: "m.ply", text: source() },
    { path: "two.txt", text: "// Doubles the base, once.\npub fn   two() -> Int = one()*2\n" },
  ]);
  let before = own_hashes(t);
  let k = run_with_stdin(t, ["replace", "two", "--with", "two.txt"], None);
  assert(k.ran.code == 0, Some(stderr(k.ran)));
  assert_eq(stdout(k.ran), "replaced m.two in m.ply\n");
  assert_eq(
    module_text(k),
    \\// The base.
    \\fn one() -> Int = 1
    \\
    \\// Doubles the base, once.
    \\pub fn two() -> Int = one() * 2
    \\
    \\fn three() -> Int = two() + 1
    \\
  );
  let after = own_hashes(k.tree);
  assert_eq(before.len(), after.len());
  range(0, before.len()).fold((), |u: Unit, i: Int|
    match ((before.at(i), after.at(i))) {
      (Some(was), Some(is)) -> if was.name == "m.two" { assert(was.own != is.own, Some(was.name)) }
      else { assert(was.own == is.own, Some(was.name)) },
      _ -> panic("the definitions are listed alike"),
    });

  let again = json_of(
    run_with_stdin(k.tree, ["replace", "two", "--with", "two.txt", "--json"], None).ran,
  );
  assert_eq(str(at(again, "command")), "replace");
  assert(bool(at(again, "ok")), Some(json_text(again)));
  assert_eq(str(at(again, "name")), "m.two");
  assert_eq(str(at(again, "file")), "m.ply");
  assert(!bool(at(again, "changed")), Some(json_text(again)))
}

test "replace pointed at a file rewrites that file" {
  let k = run_with_stdin(
    one_module_tree(source()),
    ["replace", "two", "m.ply"],
    Some("pub fn two() -> Int = one() * 2\n"),
  );
  assert(k.ran.code == 0, Some(stderr(k.ran)));
  assert_eq(stdout(k.ran), "replaced m.two in m.ply\n");
  assert_eq(module_text(k), source().replace(two(), "pub fn two() -> Int = one() * 2\n"))
}

test "a replacement that renames or breaks the program is rejected and writes nothing" {
  let renamed = run_with_stdin(
    one_module_tree(source()),
    ["replace", "two"],
    Some("pub fn twice() -> Int = one() * 2\n"),
  );
  assert_eq(renamed.ran.code, 2);
  assert(
    stderr(renamed.ran).contains("E0128") && stderr(renamed.ran).contains("`fn` `twice`"),
    Some(stderr(renamed.ran)),
  );
  assert_eq(module_text(renamed), source());

  let broken = run_with_stdin(
    one_module_tree(source()),
    ["replace", "two", "--json"],
    Some("pub fn two() -> Int = one() + \"1\"\n"),
  );
  let v = json_of(broken.ran);
  assert_eq(int(at(v, "exit_code")), 2);
  assert(!bool(at(v, "changed")), Some(json_text(v)));
  assert_eq(str(at(nth(at(v, "diagnostics"), 0), "code")), "E0128");
  assert_eq(module_text(broken), source())
}

test "check reports the file that would change and writes nothing" {
  let k = run_with_stdin(
    one_module_tree(source()),
    ["replace", "two", "--check"],
    Some("pub fn two() -> Int = one() * 2\n"),
  );
  assert(k.ran.code == 0, Some(stderr(k.ran)));
  assert_eq(stdout(k.ran), "would replace m.ply\n");
  assert_eq(module_text(k), source())
}

fn packaged() -> List<Source> =
  [
    {
      path: "app/ply.pkg",
      text: manifest(
        "app",
        "{name: \"lib\", prefix: None, min: {major: 0, minor: 0, patch: 1}, source: Path(\"../lib\")}",
      ),
    },
    {
      path: "app/main.ply",
      text: "import lib.answer\n\nfn base() -> Int = 1\n\npub fn twice() -> Int = base() + base()\n\nfn main() -> Int = twice() + answer::answer()\n",
    },
    { path: "lib/ply.pkg", text: manifest("lib", "") },
    { path: "lib/answer.ply", text: "import extra\npub fn answer() -> Int = extra::hidden()\n" },
    { path: "lib/extra.ply", text: "pub fn hidden() -> Int = 7\n" },
  ]

test/nondet "`replace` in a packaged project re-checks the program with the package's dependencies and writes into the package" {
  let unread = in_memory(tree(packaged()), ["replace", "twice", "app", "--with", "new.txt"]);
  assert(unread.code == 2, Some("a replacement nothing read is rejected: " ++ stderr(unread)));
  assert(stderr(unread).contains("new.txt"), Some(stderr(unread)));

  write_project(packaged());
  let r = on_disk_with(
    ["replace", "twice", "app"],
    [],
    Some("pub fn twice() -> Int = base() * 2\n"),
  );
  assert(r.code == 0, Some(stderr(r)));
  assert_eq(stdout(r), "replaced main.twice in app/main.ply\n");
  assert_eq(
    read("app/main.ply"),
    Some(
      "import lib.answer\n\nfn base() -> Int = 1\n\npub fn twice() -> Int = base() * 2\n\nfn main() -> Int = twice() + answer::answer()\n",
    ),
  );
  assert(read("main.ply") == None, Some("the write went beside the root, not into it"));

  assert_eq(value_of(spawned(["run", "--json", "app"])), "9")
}
