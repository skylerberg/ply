import harness (in_memory, tree, Hermetic, Shipped, std_tree, compiler_tree)
import spawning.harness (RunResult, stdout, stderr, json_of, at, str, int, items, nth)
import cli.explain (Meaning, meanings)
import compiler.front.pkg
import compiler.syntax
import compiler.syntax (Call, Law, LawSchema, Literal, Name, Node, Test)
import compiler.unit (shipped_runtime)
import std.bytes
import std.json (Json)
import std.list
import std.pkg (Dependency)

fn explain(argv: List<String>) -> RunResult / {Hermetic, Shipped, abort.raise, diverges} =
  in_memory(tree([]), ["explain"].concat(argv))

test "a code is explained in one line and as JSON" {
  let plain = explain(["e0302"]);
  assert_eq(plain.code, 0);
  assert_eq(stdout(plain), "E0302 effect that the written signature does not list\n");
  let v = json_of(explain(["W0611", "--json"]));
  assert_eq(str(at(v, "code")), "W0611");
  assert_eq(str(at(v, "severity")), "warning");
  assert_eq(
    str(at(v, "meaning")),
    "a definition that no `pub` item, `main`, test or law uses; a leading `_` in its name turns the warning off",
  );
  assert_eq(int(at(v, "exit_code")), 0)
}

test "`ply explain` describes the error code for a wrong number of effect labels like any other code" {
  let meaning = "a call that passes no labels, or the wrong number of labels, to a definition with label parameters, or a definition with label parameters used as a value";
  let plain = explain(["E0306"]);
  assert_eq(plain.code, 0);
  assert_eq(stdout(plain), "E0306 " ++ meaning ++ "\n");
  let v = json_of(explain(["e0306", "--json"]));
  assert_eq(str(at(v, "code")), "E0306");
  assert_eq(str(at(v, "severity")), "error");
  assert_eq(str(at(v, "meaning")), meaning)
}

test "`ply explain` of a code that does not exist exits two and points to `explain --all`, which lists every code" {
  let unknown = explain(["E9999"]);
  assert_eq(unknown.code, 2);
  assert(stderr(unknown).contains("explain --all"));
  let rows = items(at(json_of(explain(["--all", "--json"])), "codes"));
  assert_eq(str(at(nth(at(json_of(explain(["--all", "--json"])), "codes"), 0), "code")), "E0001");
  let lines = explain(["--all"]).out;
  assert_eq(rows.len(), lines.len());
  assert_eq(lines, rows.map(|row: Json| str(at(row, "code")) ++ " " ++ str(at(row, "meaning"))))
}

type File = { name: String, bytes: Bytes }

const packages: List<List<File>> =
  [
    embed_dir("../../packages/cli"),
    embed_dir("../../packages/testing"),
    embed_dir("../../packages/sim"),
    embed_dir("../../packages/store"),
    embed_dir("../../packages/proof"),
  ]

type Named = { name: String, needs: List<String> }

fn manifest_of(files: List<File>) -> Named / {abort.raise} =
  match files.find(|f: File| f.name == "ply.pkg") {
    None -> panic("an embedded package holds no `ply.pkg`"),
    Some(f) -> match pkg::check_manifest(f.bytes).manifest {
      None -> panic("an embedded package's `ply.pkg` is not valid"),
      Some(m) -> { name: m.name, needs: m.dependencies.map(|d: Dependency| d.name) },
    },
  }

fn code_shaped(text: Bytes) -> Bool / {abort.raise} =
  text.len() == 5 && (text.starts_with(b"E") || text.starts_with(b"W"))
    && range(1, 5).all(|i: Int| bytes::is_digit(text.at(i)))

fn quotes_a_code(text: Bytes) -> Bool / {abort.raise} = text.split(b"\"").any(code_shaped)

fn raised_at(node: Node) -> Option<String> / {abort.raise} =
  match syntax::kind(node) {
    Literal -> {
      let written = syntax::text(node);
      if written.len() == 8 && written.starts_with(b"b\"") && code_shaped(written.slice(2, 7)) {
        Some(String::of_bytes(written.slice(2, 7)))
      } else { None }
    },
    Call -> match syntax::children(node) {
      [callee, _, code, ..] -> match syntax::string_value(code) {
        Some(text) -> if names(callee, "diag_of") && code_shaped(Bytes::of_string(text)) {
          Some(text)
        } else { None },
        None -> None,
      },
      _ -> None,
    },
    _ -> None,
  }

fn names(node: Node, name: String) -> Bool / {abort.raise} =
  match ((syntax::kind(node), syntax::name(node))) {
    (Name, Some(identifier)) -> identifier.text == name,
    _ -> false,
  }

fn raised_in(files: List<File>) -> List<String> / {abort.raise} =
  files.flat_map(|f: File|
    if !f.name.ends_with(".ply") || !quotes_a_code(f.bytes) { [] } else {
      syntax::children(syntax::parse(f.bytes).tree).flat_map(|item: Node|
        match syntax::kind(item) {
          Test -> [],
          Law -> [],
          LawSchema -> [],
          _ -> if !quotes_a_code(syntax::text(item)) { [] } else {
            syntax::walk(item).flat_map(|n: Node| match raised_at(n) { Some(c) -> [c], None -> [] })
          },
        })
    })

test "the packages searched for error codes include every package that the package manifests depend on" {
  let named = packages.map(manifest_of);
  let names = named.map(|m: Named| m.name);
  assert_eq(named.flat_map(|m: Named| m.needs).filter(|n: String| !names.contains(n)), [])
}

test "the explain table lists every error code that `ply` can emit, from both its programs and its runtime, and no other code" {
  let runtime = shipped_runtime().codes.map(|c: Bytes| String::of_bytes(c));
  let program = [std_tree, compiler_tree].concat(packages).flat_map(raised_in);
  let raised = program.concat(runtime);
  let rows = meanings.map(|m: Meaning| m.code);
  assert_eq(rows.filter(|c: String| !code_shaped(Bytes::of_string(c))), []);
  assert_eq(
    range(0, runtime.len()).filter(|i: Int| runtime.drop(i + 1).contains(runtime.get(i))),
    [],
  );
  assert_eq(raised.filter(|c: String| !rows.contains(c)).unique().sort(), []);
  assert_eq(rows.filter(|c: String| !raised.contains(c)), [])
}
