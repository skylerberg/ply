import harness (in_memory, tree)
import spawning.harness (all_output)
import std.list
import std.string

test "no route lets a float become a map key" {
  let r = in_memory(
    tree([
      {
        path: "n.ply",
        text: "pub type Wrapper = W(Float)\npub type Recursive = Nil | Cons(Float, Recursive)\npub type Box<a> = { v: a }\npub type Alias = Float\n",
      },
      {
        path: "m.ply",
        text:
          \\import n
          \\fn a() -> Map<n::Wrapper, Int> = Map::new()
          \\fn b() -> Map<n::Recursive, Int> = Map::new()
          \\fn c() -> Map<n::Box<Float>, Int> = Map::new()
          \\fn d() -> Map<n::Alias, Int> = Map::new()
          \\fn e() -> Map<{x: Float}, Int> = Map::new()
          \\fn f() -> Map<Option<Float>, Int> = Map::new()
          \\fn g() -> Map<Map<n::Wrapper, Int>, Int> = Map::new()
          \\fn keyed<k>(x: k) -> Map<k, Int> = Map::new().insert(x, 1)
          \\fn h() -> Bool = { let _ = keyed(1.0); true }
          \\fn needs<a>(x: a) -> Int where derivable(ord, a) = 1
          \\fn i() -> Int = needs(1.0)
          \\
      },
    ]),
    ["check"],
  );
  assert(r.code != 0, Some(all_output(r)));
  [
    "`n.Wrapper`",
    "`n.Recursive`",
    "`{v: Float}`",
    "`{x: Float}`",
    "`Option<Float>`",
    "`Map<n.Wrapper, Int>`",
  ].fold((), |u: Unit, named: String|
    assert(
      all_output(r).contains(named),
      Some("no rejection named " ++ named ++ ":\n" ++ all_output(r)),
    ));
  assert(
    all_output(r).contains("--> m.ply:10:"),
    Some(
      "instantiating a parameter a `Map` is keyed by at `Float` must be rejected at the call site:\n"
        ++ all_output(r),
    ),
  );
  assert(
    all_output(r).contains("`Float` cannot be derived for `ord`"),
    Some(
      "instantiating a `derivable(ord, a)` parameter at `Float` must be rejected at the call site:\n"
        ++ all_output(r),
    ),
  );
  assert(all_output(r).count("E0206") >= 9, Some("one rejection per route:\n" ++ all_output(r)))
}
