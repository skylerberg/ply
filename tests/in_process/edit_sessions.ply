import compiler.front.checking (files_differing, Alone, Concurrent, Turns, Step)
import compiler.front.checking.edits (disagreements, drawn_session)
import std.time (time)

const sessions: Int = 4

fn each_session(holds: (List<Step>) -> Bool / {abort.raise}) -> Unit / {time.now_ms, abort.raise} = {
  let day = time.now_ms() / 86400000;
  range(0, sessions).fold((), |_: Unit, i: Int|
    assert(
      holds(drawn_session(day + i, i * 63 / (sessions - 1))),
      Some("the session drawn from root " ++ (day + i).to_string()),
    ))
}

test/nondet "the result through the store matches the fresh one at every step of a random session" {
  each_session(|steps: List<Step>| disagreements(steps) == [])
}

test/nondet "the store's files give the results the store in memory does, stored by one run alone" {
  each_session(|steps: List<Step>| files_differing(steps, Alone) == [])
}

test/nondet "the store's files give the results the store in memory does, a competing run of each step storing them too" {
  each_session(|steps: List<Step>| files_differing(steps, Concurrent) == [])
}

test/nondet "the store's files give the results the store in memory does, each step a `ply` of other queries" {
  each_session(|steps: List<Step>| files_differing(steps, Turns) == [])
}
