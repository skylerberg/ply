//! A nullary pure definition is a constant: its body runs once per unit, and every later read is
//! the memo's. Told by the blocks a run takes through the runtime: each body takes many, so a probe
//! that ran a body twice takes about twice what one run does.

import harness (Shipped, LoadedProgram, enter, load_program, scratch, unload_program)
import spawning.harness (WorkingDirectory, write_project)
import cli.machine
import cli.machine (default_options)
import std.machine as entering
import std.value (Value, VInt)

effect set MachineAccess = {entering::machine.open, entering::machine.bind, entering::machine.enter, entering::machine.unbind, entering::machine.close}

fn constants() -> String = String::of_bytes_lossy(embed("../programs/constant_memo/constants.ply"))

/// What a definition's body returns.
fn work() -> Int = 400

/// The program compiled, opened and bound.
fn bound() -> LoadedProgram / {WorkingDirectory, Shipped, MachineAccess, abort.raise} = {
  write_project([{ path: "inner.ply", text: constants() }]);
  load_program(default_options())
}

/// What one entry returned, as an `Int`, or the code it ended with, and the blocks it took.
fn ran(
  l: LoadedProgram,
  name: String,
  args: List<Value>,
) -> { result: Result<Int, Bytes>, blocks: Int } / {MachineAccess, abort.raise} = {
  let o = enter(l, name, args);
  let result = match machine::result_of(o, l.roots, name) {
    Ok(VInt(i)) -> Ok(i),
    Ok(_) -> Err(b"not an Int"),
    Err(r) -> Err(r.diagnostic.code),
  };
  { result: result, blocks: o.usage.runtime_blocks }
}

/// What probe `name` returned, and how many times it ran a body: its blocks over those of one run
/// of a body, which `parameterized`, no constant, runs at each entry, to the nearest whole run.
fn probe_outcome(
  name: String,
) -> { result: Result<Int, Bytes>, runs: Int } / {WorkingDirectory, Shipped, MachineAccess, abort.raise} = {
  let l = bound();
  let once = ran(l, "parameterized", [VInt(0)]);
  let probe = ran(l, name, []);
  let _ = unload_program(l);
  assert(
    once.result == Ok(work()) && once.blocks >= work(),
    Some("one run of a body takes a block for each item it makes"),
  );
  { result: probe.result, runs: (probe.blocks + once.blocks / 2) / once.blocks }
}

test "a nullary pure definition is evaluated once, however often it is read" {
  scratch(|| { assert_eq(probe_outcome("probe_constant"), { result: Ok(2 * work()), runs: 1 }) })
}

test "a definition with a parameter is no constant, however dead the parameter is" {
  scratch(|| {
    assert_eq(probe_outcome("probe_parameterized"), { result: Ok(2 * work()), runs: 2 })
  })
}

test "published effects the body never performs keep a definition out of the memo" {
  scratch(|| {
    assert_eq(probe_outcome("probe_over_declared"), { result: Ok(2 * work()), runs: 2 })
  })
}

test "a constant read a thousand times runs its body once" {
  scratch(|| { assert_eq(probe_outcome("probe_reads"), { result: Ok(1000 * work()), runs: 1 }) })
}

test "a value a constant cannot keep is worked out again at every read" {
  scratch(|| { assert_eq(probe_outcome("probe_unkept"), { result: Ok(2 * work()), runs: 2 }) })
}

test "a constant whose body fails keeps nothing, so the next entry runs the body again" {
  scratch(|| {
    let l = bound();
    let once = ran(l, "parameterized", [VInt(0)]);
    let first = ran(l, "probe_refused", []);
    let second = ran(l, "probe_refused", []);
    let _ = unload_program(l);
    assert(first.result != Ok(0), Some("a failed body returned"));
    assert_eq(second.result, first.result);
    assert(second.blocks * 2 > once.blocks, Some("the second entry read something kept"))
  })
}

// A name the unit never compiled and a compiled one offered the wrong number of arguments are each
// declined before any body runs.
test "a call of no definition, or with the wrong arguments, is declined" {
  scratch(|| {
    let l = bound();
    assert_eq(ran(l, "parameterized", [VInt(0)]).result, Ok(work()));
    let absent = ran(l, "absent", []).result;
    let short = ran(l, "parameterized", []).result;
    let _ = unload_program(l);
    assert(absent != Ok(0), Some("an absent name returned"));
    assert(short != Ok(work()), Some("the wrong number of arguments returned"))
  })
}
