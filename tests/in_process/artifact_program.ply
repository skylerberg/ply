import harness (scratch, Package, manifest_closure, program_packages, toolchain_parts,
                shipped_sources, shipped_drift, tree_digests, compiler_digests, on_disk, in_memory,
                tree)
import spawning.harness (Source, write_project, repo, all_output, stderr, json_of, at, items, first,
                         str, json_text)
import compiler.syntax.items (is_std, is_compiler)
import compiler.prelude_source
import compiler.unit (shipped)
import std.json (Json)
import std.string

fn package(prefix: String, dependencies: List<String>) -> Package =
  { prefix: prefix, dependencies: dependencies }

test/nondet "the CLI's source directories form the `cli` package, which depends on testing, sim, store and proof" {
  let cli = manifest_closure(repo() ++ "/" ++ toolchain_parts().cli);
  let packages = program_packages();
  assert(
    cli.dirs.len() == packages.len()
      && cli.dirs.filter(|d: String|
        packages.filter(|p: String| d.ends_with("/" ++ p)).len() == 1).len(
      )
      == cli.dirs.len(),
    Some(
      "the CLI is read from " ++ String::join(cli.dirs, ", ") ++ " and the harness reads "
        ++ String::join(packages, ", "),
    ),
  );
  assert(
    cli.packages
      == [
        package("cli", ["testing", "sim", "store", "proof"]),
        package("testing", []),
        package("sim", []),
        package("store", []),
        package("proof", ["sim"]),
      ],
    Some(
      "the CLI tree's ply.pkg names it the `cli` package, closed over testing, the search, the store and the proof package",
    ),
  )
}

test "the binary contains the compiler's source files exactly as they are in the checkout" {
  let drift = shipped_drift();
  assert(
    drift.len() == 0,
    Some("shipped other than the trees hold them: " ++ String::join(drift, ", ")),
  )
}

test "the binary lists each compiler file by name and digest, matching the files in the checkout" {
  assert_eq(compiler_digests(shipped.digests()), tree_digests)
}

test "the binary ships the prelude the compiler embeds" {
  assert(shipped.module("std.prelude") == Some(prelude_source::text), None)
}

test "the compiler is among the shipped modules under the `compiler` prefix, and no other module may shadow it" {
  let modules = items(at(json_of(in_memory(tree([]), ["std", "--show", "--json"])), "sources")).map(
    |m: Json| str(at(m, "module")),
  );
  assert(modules.filter(|m: String| m == "std.path").len() == 1, Some(String::join(modules, " ")));
  assert(is_compiler(b"compiler.fmt"), None);
  assert(is_std(b"std.fs"), None);
  assert(!is_compiler(b"compilers.fmt") && !is_std(b"compilers.fmt"), None);
  assert(!is_compiler(b"fmt") && !is_std(b"fmt"), None);

  let collided = json_of(
    in_memory(tree([{ path: "compiler/fmt.ply", text: "pub fn f() -> Int = 1\n" }]), [
      "check",
      "--json",
    ]),
  );
  let diagnostics = items(at(collided, "diagnostics"));
  assert(diagnostics.len() == 1, Some(json_text(collided)));
  assert(str(at(first(diagnostics), "code")) == "E0133", Some(json_text(collided)));
  assert(
    str(at(first(diagnostics), "message")).contains("compiler.fmt"),
    Some(json_text(collided)),
  );

  let ok = in_memory(tree([{ path: "compilers.ply", text: "pub fn f() -> Int = 1\n" }]), ["check"]);
  assert(ok.code == 0, Some("`compilers` is an ordinary module name: " ++ all_output(ok)))
}

fn imported(line: String) -> String / {abort.raise} = {
  let rest = Bytes::of_string(line.slice("import ".len(), line.len()));
  let class = b"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.";
  String::of_bytes(rest.slice(0, rest.scan(0, class, rest.len())))
}

test "every shipped module imports only modules that are in the shipped module list" {
  let modules = shipped_sources().map(|source: Source|
    { name: source.path.slice(0, source.path.len() - 4), text: source.text });
  let recorded = modules.map(|m: { name: String, text: String }| m.name);
  let files = |n: String| recorded.filter(|f: String| f == n).len() > 0;
  modules.fold((), |u: Unit, m: { name: String, text: String }|
    m.text.split("\n").filter(|l: String| l.starts_with("import ")).fold(
      u,
      |v: Unit, line: String| {
        let p = imported(line);
        assert(
          files(p),
          Some("`" ++ m.name ++ "` imports `" ++ p ++ "`, which no shipped module is recorded as"),
        )
      },
    ))
}

test "commands such as `definitions`, `hash` and `show` succeed and print output when given no path argument" {
  scratch(|| {
    write_project([{ path: "m.ply", text: "pub fn one() -> Int = 1\n" }]);
    [
      { args: ["definitions"], writes: true },
      { args: ["definitions", "--json"], writes: true },
      { args: ["hash"], writes: true },
      { args: ["hash", "--json"], writes: true },
      { args: ["doc", "one"], writes: true },
      { args: ["doc", "one", "--json"], writes: true },
      { args: ["show", "one"], writes: true },
      { args: ["show", "one", "--json"], writes: true },
      { args: ["callers", "one"], writes: true },
      { args: ["callers", "one", "--json"], writes: true },
      { args: ["std", "--digest"], writes: true },
      { args: ["explain", "E0001"], writes: true },
      { args: ["hosts"], writes: true },
      { args: ["hosts", "--json"], writes: true },
      { args: ["hosts", "--digest"], writes: true },
      { args: ["cache", "stats"], writes: true },
      { args: ["cache", "stats", "--json"], writes: true },
      { args: ["fmt", "--check"], writes: false },
    ].fold((), |u: Unit, c: { args: List<String>, writes: Bool }| {
      let r = on_disk(c.args);
      let shown_as = "`ply " ++ String::join(c.args, " ") ++ "`";
      assert(r.code == 0, Some(shown_as ++ " exited " ++ r.code.to_string() ++ "\n" ++ stderr(r)));
      assert(!c.writes || r.out.len() > 0, Some(shown_as ++ " wrote nothing"))
    })
  })
}
