//! Packages: path, git and registry dependencies, the judgments over a closure, `ply.lock` and what
//! it holds a build to, `ply reason`, `ply vendor`, and a library built as a package.

import harness (scratch, on_disk, on_disk_faked, passing_except, returned, CliEffects, Shipped)
import support.harness (RunResult, Source, write_project, write, read, all_output, stdout, stderr,
                        json_of, at, nth, path, str, int, bool, json_text, WorkingDirectory,
                        assert_ok, dependency, empty_working_directory, environment, exists,
                        manifest, value_of, working_directory)
import std.config (config)
import std.fs (fs)
import std.json (Array, Str)
import std.machine as entering
import std.process (process, Exited)
import std.string
import std.value (VInt)

/// app -> lib -> base, with lib using base and a sibling of its own.
fn graph() -> Unit / {WorkingDirectory, abort.raise} =
  write_project([
    { path: "app/ply.pkg", text: manifest("app", dependency("lib", "../lib")) },
    {
      path: "app/main.ply",
      text: "import lib.answer\nfn main() -> Int = answer::answer()\ntest \"answers\" { assert_eq(answer::answer(), 42) }\n",
    },
    { path: "lib/ply.pkg", text: manifest("lib", dependency("base", "../base")) },
    {
      path: "lib/answer.ply",
      text: "import base.deep\nimport extra\npub fn answer() -> Int = deep::deep() + extra::hidden()\n",
    },
    { path: "lib/extra.ply", text: "pub fn hidden() -> Int = 35\n" },
    { path: "base/ply.pkg", text: manifest("base", "") },
    { path: "base/deep.ply", text: "pub fn deep() -> Int = 7\n" },
  ])

fn assert_rejected(ran: RunResult, code: String) -> Unit / {abort.raise} = {
  assert(ran.code == 2, Some(all_output(ran)));
  assert(stderr(ran).contains(code), Some(stderr(ran)))
}

fn assert_stderr_contains(ran: RunResult, needle: String) -> Unit / {abort.raise} =
  assert(stderr(ran).contains(needle), Some(stderr(ran)))

fn lock_of(p: String) -> String / {WorkingDirectory, abort.raise} =
  match read(p) { Some(t) -> t, None -> panic("`" ++ p ++ "` was written") }

fn faked(argv: List<String>) -> RunResult / {CliEffects, Shipped, abort.raise, diverges} =
  on_disk_faked(argv, passing_except([]))

test "a transitive dependency the importer does not declare is rejected" {
  scratch(|| {
    graph();
    write("app/main.ply", "import base.deep\nfn main() -> Int = deep::deep()\n");
    let r = on_disk(["check", "app"]);
    assert_rejected(r, "E0132");
    assert_stderr_contains(r, "`base`");
    assert_stderr_contains(r, "`app`")
  })
}

test "a root module may not squat on a dependency's prefix" {
  scratch(|| {
    graph();
    write("app/lib/mine.ply", "fn mine() -> Int = 1\n");
    assert_rejected(on_disk(["check", "app"]), "E0133")
  })
}

test "a dependency cycle is rejected naming the cycle" {
  scratch(|| {
    write_project([
      { path: "app/ply.pkg", text: manifest("app", dependency("lib", "../lib")) },
      { path: "app/main.ply", text: "fn main() -> Int = 1\n" },
      { path: "lib/ply.pkg", text: manifest("lib", dependency("app", "../app")) },
      { path: "lib/x.ply", text: "pub fn x() -> Int = 1\n" },
    ]);
    assert_rejected(on_disk(["check", "app"]), "E0134")
  })
}

// A registry dependency is read from the project's cache, and only `ply resolve` fills it.
test "a registry dependency nothing fetched says what fetches it" {
  scratch(|| {
    write_project([
      {
        path: "ply.pkg",
        text: manifest(
          "app",
          "{name: \"glib\", prefix: None, min: {major: 0, minor: 0, patch: 1}, source: Registry}",
        ),
      },
      { path: "main.ply", text: "fn main() -> Int = 1\n" },
    ]);
    let r = on_disk(["check"]);
    assert_rejected(r, "E0135");
    assert_stderr_contains(r, "`glib` has not been fetched");
    assert_stderr_contains(r, "`ply resolve`");
    // Resolving needs a registry to ask, and says which variable names it.
    let resolved = on_disk(["resolve"]);
    assert_rejected(resolved, "E0141");
    assert_stderr_contains(resolved, "`PLY_REGISTRY` is not set")
  })
}

test "a dependency may not reach back into the root package" {
  scratch(|| {
    graph();
    // `onlyroot` exists only in the root package. A bare import inside a dependency names that
    // package's own modules and nothing else, so the import finds no module.
    write("app/onlyroot.ply", "fn shared() -> Int = 9\n");
    write("lib/answer.ply", "import onlyroot\npub fn answer() -> Int = onlyroot::shared()\n");
    let r = on_disk(["check", "app"]);
    assert_rejected(r, "E0106");
    assert_stderr_contains(r, "no module named `onlyroot`")
  })
}

type Version = { major: Int, minor: Int, patch: Int }

fn version_of(major: Int, minor: Int, patch: Int) -> Version =
  { major: major, minor: minor, patch: patch }

fn version_text(x: Version) -> String =
  "{major: " ++ x.major.to_string() ++ ", minor: " ++ x.minor.to_string() ++ ", patch: "
    ++ x.patch.to_string()
    ++ "}"

/// `manifest` with a version of its own and a dependency carrying a floor, for the version
/// judgments. Two manifests asking different floors of one package is legal; two places holding one
/// package is not.
fn versioned_manifest(name: String, version: Version, dependencies: String) -> String =
  "import std.pkg (Manifest)\nfn package() -> Manifest = {name: \"" ++ name ++ "\", version: "
    ++ version_text(version)
    ++ ", prefix: None, runtime: {major: 0, minor: 0, patch: 1}, dependencies: ["
    ++ dependencies
    ++ "], entry: None}\n"

fn dependency_at(name: String, floor: Version, at_path: String) -> String =
  "{name: \"" ++ name ++ "\", prefix: None, min: " ++ version_text(floor) ++ ", source: Path(\""
    ++ at_path
    ++ "\")}"

test "a dependency below the floor its importer asks for is rejected" {
  scratch(|| {
    write_project([
      {
        path: "app/ply.pkg",
        text: versioned_manifest(
          "app",
          version_of(0, 1, 0),
          dependency_at("lib", version_of(0, 2, 0), "../lib"),
        ),
      },
      { path: "app/main.ply", text: "import lib.x\nfn main() -> Int = x::x()\n" },
      { path: "lib/ply.pkg", text: versioned_manifest("lib", version_of(0, 1, 3), "") },
      { path: "lib/x.ply", text: "pub fn x() -> Int = 1\n" },
    ]);
    let r = on_disk(["check", "app"]);
    assert_rejected(r, "E0136");
    assert_stderr_contains(r, "is version 0.1.3");
    assert_stderr_contains(r, "at least 0.2.0");
    // The floor is a floor: the same tree with the dependency at or above it checks.
    write("lib/ply.pkg", versioned_manifest("lib", version_of(0, 2, 0), ""));
    assert_ok(on_disk(["check", "app"]))
  })
}

test "one package of one name at two places has no version to pick" {
  scratch(|| {
    let sides = [{ side: "left", other: "d1" }, { side: "right", other: "d2" }].fold(
      [],
      |acc: List<Source>, c: { side: String, other: String }|
        [
          {
            path: c.side ++ "/ply.pkg",
            text: versioned_manifest(
              c.side,
              version_of(0, 1, 0),
              dependency_at("shared", version_of(0, 1, 0), "../" ++ c.other),
            ),
          },
          {
            path: c.side ++ "/" ++ c.side ++ ".ply",
            text: "pub fn " ++ c.side ++ "() -> Int = 1\n",
          },
        ].fold(
          acc,
          List::push,
        ),
    );
    let shared = [
      { path: "d1/ply.pkg", text: versioned_manifest("shared", version_of(0, 1, 0), "") },
      { path: "d1/s.ply", text: "pub fn s() -> Int = 1\n" },
      { path: "d2/ply.pkg", text: versioned_manifest("shared", version_of(0, 2, 0), "") },
      { path: "d2/s.ply", text: "pub fn s() -> Int = 1\n" },
    ];
    write_project(
      shared.fold(sides, List::push).fold(
        [
          {
            path: "app/ply.pkg",
            text: versioned_manifest(
              "app",
              version_of(0, 1, 0),
              dependency_at("left", version_of(0, 1, 0), "../left") ++ ", "
                ++ dependency_at("right", version_of(0, 1, 0), "../right"),
            ),
          },
          { path: "app/main.ply", text: "fn main() -> Int = 1\n" },
        ],
        List::push,
      ),
    );
    let r = on_disk(["check", "app"]);
    assert_rejected(r, "E0137");
    assert_stderr_contains(r, "`shared` is reached at two places");
    assert_stderr_contains(r, "`left` wants");
    assert_stderr_contains(r, "`right` wants")
  })
}

// A file argument's package is its directory: resolving the file pins what that directory's
// manifest declares, in the lock beside it.
test "resolving a file writes the lock beside it" {
  scratch(|| {
    graph();
    let r = on_disk(["resolve", "app/main.ply"]);
    assert_ok(r);
    assert(stdout(r).contains("resolved 2 packages · app/ply.lock"), Some(stdout(r)));
    let lock = lock_of("app/ply.lock");
    assert(lock.contains("\"name\":\"lib\""), Some(lock));
    assert(lock.contains("\"name\":\"base\""), Some(lock));
    assert(fs.exists[cwd]("app/main.ply"), None)
  })
}

// `ply resolve` is how a lockfile is written deliberately, after a dependency changed or in a fresh
// checkout, and `ply reason` says how a package got here.
test "resolve writes the lock and why names the path to a package" {
  scratch(|| {
    graph();
    let r = on_disk(["resolve", "app"]);
    assert_ok(r);
    assert(stdout(r).contains("resolved 2 packages"), Some(stdout(r)));
    let lock = lock_of("app/ply.lock");
    assert(lock.contains("\"name\":\"lib\""), Some(lock));
    assert(lock.contains("\"name\":\"base\""), Some(lock));
    // Why: the root's own module reaches `lib`, and `lib`'s reaches `base`.
    let reason = on_disk(["why", "lib", "app"]);
    assert_ok(reason);
    assert(stdout(reason).contains("app -> lib"), Some(stdout(reason)));
    assert(stdout(reason).contains("0.0.1"), Some(stdout(reason)));
    let base = json_of(on_disk(["why", "base", "app", "--json"]));
    assert(str(at(base, "command")) == "why", Some(json_text(base)));
    assert(str(at(base, "package")) == "base", Some(json_text(base)));
    assert(at(base, "path") == Array([Str("app"), Str("lib"), Str("base")]), Some(json_text(base)));
    assert(!bool(at(base, "root")), Some(json_text(base)));
    assert(str(at(base, "digest")).starts_with("b3:"), Some(json_text(base)));
    // The root package is what reaches, so its path is itself.
    let app = json_of(on_disk(["why", "app", "app", "--json"]));
    assert(bool(at(app, "root")), Some(json_text(app)));
    assert(at(app, "path") == Array([Str("app")]), Some(json_text(app)));
    // A name nothing declares is a query that found nothing, not a build failure.
    let nope = on_disk(["why", "nope", "app"]);
    assert_rejected(nope, "E0101");
    assert_stderr_contains(nope, "is not a package in this closure")
  })
}

test "a project with no dependencies vendors nothing" {
  scratch(|| {
    write_project([{ path: "m.ply", text: "fn main() -> Int = 1\n" }]);
    let r = on_disk(["vendor"]);
    assert_ok(r);
    assert(stdout(r).contains("vendored 0 packages"), Some(stdout(r)));
    assert(lock_of("vendor/index") == "", None)
  })
}

// A project's test run tests the project: a dependency's tests are that package's own to run.
test "a test run tests the root package and never a dependency's" {
  scratch(|| {
    graph();
    write(
      "lib/extra.ply",
      "pub fn hidden() -> Int = 35\ntest \"hidden is 35\" { assert_eq(hidden(), 35) }\n",
    );
    write(
      "base/deep.ply",
      "pub fn deep() -> Int = 7\ntest \"deep is 7\" { assert_eq(deep(), 7) }\n",
    );
    let app = json_of(faked(["test", "app", "--json"]));
    assert(int(path(app, ["selection", "total"])) == 1, Some(json_text(app)));
    assert(int(path(app, ["summary", "passed"])) == 1, Some(json_text(app)));
    // Not hidden by a filter either: the dependencies' tests are no part of this run at all.
    assert(int(path(app, ["selection", "filtered_out"])) == 0, Some(json_text(app)));
    let lib = json_of(faked(["test", "lib", "--json"]));
    assert(int(path(lib, ["selection", "total"])) == 1, Some(json_text(lib)));
    assert(
      str(at(nth(path(lib, ["selection", "tests"]), 0), "key")) == "extra.hidden is 35",
      Some(json_text(lib)),
    )
  })
}

test "a dependency without a manifest is unusable where it is declared" {
  scratch(|| {
    graph();
    assert(fs.remove[cwd]("lib/ply.pkg"), None);
    let r = faked(["run", "app"]);
    assert_rejected(r, "E0135");
    assert_stderr_contains(r, "ply.pkg")
  })
}

// A build records what it resolved, and rejects what the record does not describe.
test "a build pins its dependencies and rejects what the lock pins differently" {
  scratch(|| {
    graph();
    let build = || faked(["build", "app", "-o", "app.plyx"]);
    assert_ok(build());
    let lock = lock_of("app/ply.lock");
    ["\"name\":\"lib\"", "\"name\":\"base\"", "\"version\":\"0.0.1\"", "\"digest\":\"b3:"].fold(
      (),
      |u: Unit, want: String|
        assert(lock.contains(want), Some("`" ++ want ++ "` is not in the lock: " ++ lock)),
    );
    // The closure's packages are pinned, and the project's own sources are not.
    assert(!lock.contains("\"name\":\"app\""), Some(lock));
    // The same tree builds again without moving the lock: a pin is not rewritten per run.
    assert_ok(build());
    assert(lock_of("app/ply.lock") == lock, None);
    // A dependency whose bytes moved is not the one the lock pins.
    write("lib/answer.ply", "import base.deep\npub fn answer() -> Int = deep::deep() + 1\n");
    let moved = build();
    assert_rejected(moved, "E0138");
    assert_stderr_contains(moved, "`lib` is not what `ply.lock` pins");
    assert(lock_of("app/ply.lock") == lock, None);
    // Pinning what is on disk now is a deliberate act, and the lock says so afterwards.
    assert(fs.remove[cwd]("app/ply.lock"), None);
    assert_ok(build());
    let repinned = lock_of("app/ply.lock");
    assert(repinned != lock, Some("the digest did not move with the sources"));
    let again = build();
    assert(again.code == 0, Some("the new pin is the one in force: " ++ all_output(again)))
  })
}

// A path dependency in the checkout the project is in is pinned by the commit, so its entry holds
// no digest, and two changes to it never meet in the dependent's lock.
test "an edit to a path dependency the checkout holds leaves the dependent's lock byte for byte" {
  scratch(|| {
    graph();
    write(".git/HEAD", "ref: refs/heads/main\n");
    assert_ok(faked(["resolve", "app"]));
    let lock = lock_of("app/ply.lock");
    assert(lock.contains("\"name\":\"lib\""), Some(lock));
    assert(lock.contains("\"name\":\"base\""), Some(lock));
    assert(!lock.contains("\"digest\""), Some(lock));
    write("lib/answer.ply", "import base.deep\npub fn answer() -> Int = deep::deep() + 1\n");
    write("base/deep.ply", "pub fn deep() -> Int = 8\n");
    assert_ok(faked(["build", "app", "-o", "app.plyx"]));
    assert(lock_of("app/ply.lock") == lock, Some(lock_of("app/ply.lock")));
    assert_ok(faked(["resolve", "app"]));
    assert(lock_of("app/ply.lock") == lock, Some(lock_of("app/ply.lock")));
    // A checkout of the project's own holds neither: their digests pin them, and an edit is
    // rejected.
    write("app/.git/HEAD", "ref: refs/heads/main\n");
    assert_ok(faked(["resolve", "app"]));
    let own = lock_of("app/ply.lock");
    assert(own.contains("\"digest\":\"b3:"), Some(own));
    write("base/deep.ply", "pub fn deep() -> Int = 9\n");
    assert_rejected(faked(["build", "app", "-o", "app.plyx"]), "E0138");
    assert_rejected(faked(["vendor", "app"]), "E0138");
    assert(lock_of("app/ply.lock") == own, None)
  })
}

// A build of one file is held to the lock beside it, as a build of its directory is.
test "building a file is bound by the lock beside it" {
  scratch(|| {
    graph();
    assert_ok(faked(["resolve", "app"]));
    let lock = lock_of("app/ply.lock");
    assert_ok(faked(["build", "app/main.ply", "-o", "app.plyx"]));
    assert(lock_of("app/ply.lock") == lock, None);
    write("lib/answer.ply", "import base.deep\npub fn answer() -> Int = deep::deep() + 1\n");
    let r = faked(["build", "app/main.ply", "-o", "stale.plyx"]);
    assert_rejected(r, "E0138");
    assert_stderr_contains(r, "`lib` is not what `ply.lock` pins");
    assert(!exists("stale.plyx"), Some("an artifact was written"));
    assert(lock_of("app/ply.lock") == lock, None)
  })
}

test "a lockfile nothing can read is rejected rather than ignored" {
  scratch(|| {
    graph();
    write("app/ply.lock", "{ not json");
    assert_rejected(faked(["build", "app", "-o", "app.plyx"]), "E0139");
    assert(!exists("app.plyx"), Some("an artifact was written"))
  })
}

test "a resolve re-pins a dependency whose sources moved" {
  scratch(|| {
    graph();
    assert_ok(faked(["resolve", "app"]));
    let before = lock_of("app/ply.lock");
    write("base/deep.ply", "pub fn deep() -> Int = 8\n");
    // The build rejects what the lock pins differently, and `resolve` is what accepts it.
    assert_rejected(faked(["build", "app", "-o", "app.plyx"]), "E0138");
    assert_ok(faked(["resolve", "app"]));
    assert(lock_of("app/ply.lock") != before, Some("the pin did not move with the sources"));
    assert_ok(faked(["build", "app", "-o", "app.plyx"]))
  })
}

// A library is a package, not a program: `ply build` writes the package itself, its sources, its
// manifest and a compiled unit, under a container of its own.
test "a library builds as a package and never as a program" {
  scratch(|| {
    empty_working_directory();
    assert_ok(faked(["new", "core", "--lib"]));
    let built = faked(["build", "core", "--json"]);
    assert_ok(built);
    let report = json_of(built);
    assert(str(at(report, "command")) == "build", Some(json_text(report)));
    assert(bool(at(report, "library")), Some(json_text(report)));
    assert(str(at(report, "name")) == "core", Some(json_text(report)));
    assert(str(at(report, "version")) == "0.1.0", Some(json_text(report)));
    assert(int(at(report, "definitions")) == 1, Some(json_text(report)));
    assert(str(at(report, "digest")).starts_with("b3:"), Some(json_text(report)));
    assert(bool(at(report, "unit")), Some(json_text(report)));
    let bytes = match fs.read_file[cwd]("core.plyz") {
      Some(b) -> b,
      None -> panic("the library is written"),
    };
    assert(bytes.slice(0, 8) == b"PLYLIB01", Some("a library is not a program container"));
    // A library is never entered: reading it as sources would report a container as text.
    let ran = faked(["run", "core.plyz"]);
    assert_rejected(ran, "");
    assert_stderr_contains(ran, "is a library, and nothing to run");
    assert_stderr_contains(ran, "declare it in a `ply.pkg`");
    // A program package still builds a `.plyx`, and the library's own tests still run.
    assert_ok(faked(["new", "app"]));
    let app = faked(["build", "app"]);
    assert_ok(app);
    assert(exists("main.plyx"), Some(stdout(app)));
    assert_ok(faked(["test", "core"]))
  })
}

test "a package below another is its own, and no module of the one above it" {
  scratch(|| {
    nested();
    assert_ok(faked(["check", "app"]));
    // The dependency's test is its own package's to run.
    let tested = faked(["test", "app"]);
    assert(tested.code == 0 && all_output(tested).contains("2 passed"), Some(all_output(tested)))
  })
}

test "a path a line names in a package narrows the command and leaves the root above it" {
  scratch(|| {
    nested();
    let stored = faked(["test", "app/store"]);
    assert(stored.code == 0 && all_output(stored).contains("1 passed"), Some(all_output(stored)));
    // Two modules declare `main`: a file names the one to enter, in the package it is part of.
    assert_rejected(faked(["run", "app"]), "E0112");
    assert_eq(
      value_of(
        on_disk_faked(["run", "--json", "app/store/report.ply"], main_of("store.report", 14)),
      ),
      "14",
    );
    assert_rejected(faked(["check", "app/store/missing.ply"]), "E0502")
  })
}

/// How a faked `ply run` ends: returning `n` when it enters the main of `module`, and failing when
/// it enters any other.
fn main_of(module: String, n: Int) -> (String) -> entering::Termination =
  |root: String|
    if root.ends_with(module ++ ".main") { returned(VInt(n)) } else { passing_except([root])(root) }

/// A package with a module below its root, a second `main` there, and a dependency vendored under it
/// whose module imports a sibling by its own name.
fn nested() -> Unit / {WorkingDirectory, abort.raise} =
  write_project([
    { path: "app/ply.pkg", text: manifest("app", dependency("lib", "vendor/lib")) },
    {
      path: "app/main.ply",
      text: "import store.orders\nimport lib.answer\nfn main() -> Int = orders::total() + answer::answer()\ntest \"adds up\" { assert_eq(main(), 42) }\n",
    },
    {
      path: "app/store/orders.ply",
      text: "pub fn total() -> Int = 7\ntest \"stored\" { assert_eq(total(), 7) }\n",
    },
    {
      path: "app/store/report.ply",
      text: "import store.orders\nfn main() -> Int = orders::total() * 2\n",
    },
    { path: "app/vendor/lib/ply.pkg", text: manifest("lib", "") },
    {
      path: "app/vendor/lib/answer.ply",
      text: "import extra\npub fn answer() -> Int = extra::hidden()\ntest \"vendored\" { assert_eq(answer(), 35) }\n",
    },
    { path: "app/vendor/lib/extra.ply", text: "pub fn hidden() -> Int = 35\n" },
  ])

// The ordinary diamond: two packages depend on one package, at two floors of it. One version
// serves the closure, so this is what a program over a shared dependency looks like.
test "two dependents of one package resolve to its one version" {
  scratch(|| {
    write_project([
      {
        path: "app/ply.pkg",
        text: versioned_manifest(
          "app",
          version_of(0, 1, 0),
          dependency_at("left", version_of(0, 1, 0), "../left") ++ ", "
            ++ dependency_at("right", version_of(0, 1, 0), "../right"),
        ),
      },
      {
        path: "app/main.ply",
        text: "import left.l\nimport right.r\nfn main() -> Int = l::l() + r::r()\n",
      },
      {
        path: "left/ply.pkg",
        text: versioned_manifest(
          "left",
          version_of(0, 1, 0),
          dependency_at("shared", version_of(0, 1, 0), "../shared"),
        ),
      },
      { path: "left/l.ply", text: "import shared.s\npub fn l() -> Int = s::s()\n" },
      {
        path: "right/ply.pkg",
        text: versioned_manifest(
          "right",
          version_of(0, 1, 0),
          dependency_at("shared", version_of(0, 3, 0), "../shared"),
        ),
      },
      { path: "right/r.ply", text: "import shared.s\npub fn r() -> Int = s::s()\n" },
      { path: "shared/ply.pkg", text: versioned_manifest("shared", version_of(0, 3, 0), "") },
      { path: "shared/s.ply", text: "pub fn s() -> Int = 20\n" },
    ]);
    assert_ok(on_disk(["check", "app"]))
  })
}

// A url that does not resolve is the dependency's trouble, named as such: git could not fetch it, and
// nothing was read.
test/nondet "a git dependency that cannot be fetched says so" {
  write_project([
    {
      path: "ply.pkg",
      text: manifest(
        "app",
        "{name: \"glib\", prefix: None, min: {major: 0, minor: 0, patch: 1}, source: Git(\"https://example.invalid/glib\", \"abc123\")}",
      ),
    },
    { path: "main.ply", text: "fn main() -> Int = 1\n" },
  ]);
  let r = on_disk(["check", "."]);
  assert(r.code == 2, Some(all_output(r)));
  assert(stderr(r).contains("E0135"), Some(stderr(r)));
  assert_stderr_contains(r, "glib")
}

/// `git` run in `dir`, which must succeed.
fn git(
  dir: String,
  args: List<String>,
) -> String / {config.get[env], process.spawn[git], abort.raise} = {
  let f = process.spawn[git](args, dir, environment([]));
  let out = String::of_bytes_lossy(f.out);
  match f.ended {
    Exited(0) -> out,
    _ -> panic("`git " ++ String::join(args, " ") ++ "`: " ++ String::of_bytes_lossy(f.err)),
  }
}

/// A git repository with the one more commit `HEAD` points at.
fn git_repo(
  dir: String,
  source: String,
) -> Unit / {WorkingDirectory, config.get[env], process.spawn[git], abort.raise} = {
  if !fs.exists[cwd](dir ++ "/.git") {
    let _ = git(dir, ["init", "--quiet"]);
    ()
  };
  write(dir ++ "/ply.pkg", manifest("gitlib", ""));
  write(dir ++ "/answer.ply", source);
  let _ = git(dir, ["add", "-A"]);
  let _ = git(dir, [
    "-c",
    "user.email=t@test",
    "-c",
    "user.name=test",
    "commit",
    "--quiet",
    "-m",
    "a",
  ]);
  ()
}

// A branch means what it means today, and the cache holds the tree the resolve fetched. A cleared
// cache is what asks the branch again, and then the lock is what says the sources moved, before a
// build writes anything.
test/nondet "a git dependency whose branch moved is not what the lock pins" {
  empty_working_directory();
  assert(fs.create_dir[cwd]("lib"), None);
  git_repo("lib", "pub fn answer() -> Int = 7\n");
  write(
    "app/ply.pkg",
    manifest(
      "app",
      "{name: \"gitlib\", prefix: None, min: {major: 0, minor: 0, patch: 1}, source: Git(\""
        ++ working_directory()
        ++ "/lib\", \"HEAD\")}",
    ),
  );
  write("app/main.ply", "import gitlib.answer\nfn main() -> Int = answer::answer()\n");
  assert_ok(on_disk(["resolve", "app"]));
  let before = lock_of("app/ply.lock");
  git_repo("lib", "pub fn answer() -> Int = 8\n");
  assert(fs.remove_tree[cwd]("app/.ply-cache/git"), None);
  assert_rejected(faked(["build", "app", "-o", "app.plyx"]), "E0138");
  assert(lock_of("app/ply.lock") == before, None);
  // Accepting the new tip is `ply resolve`, and then the build is green again.
  assert_ok(on_disk(["resolve", "app"]));
  assert(lock_of("app/ply.lock") != before, None);
  assert_ok(faked(["build", "app", "-o", "app.plyx"]))
}
