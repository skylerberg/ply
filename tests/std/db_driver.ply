import postgres
import postgres (Cluster, Wire, plain_url)
import std.certgen (certgen)
import std.db
import std.db (db, with_server, transaction, is_retryable, copy_into, copy_from, ReadCommitted,
               ReadWrite, Serializable, Rollback, Notice, Notified, Reconnected, ListenFailed,
               Quiet)
import std.list
import std.result
import std.seq
import std.seq (Seq, seq)
import std.sql
import std.sql (statement_of, IntParameter, TextParameter, NullParameter, BytesParameter,
                ArrayParameter, NumericParameter, IntDatum, TextDatum, QueryResult, Rows, Count,
                Failed, Row, DbError)
import std.string
import std.time (millis)

fn failure(e: DbError) -> String = e.code ++ ": " ++ e.detail

fn number(rows: List<Row>) -> String =
  match rows {
    [row, ..] -> match row.get("n") { Some(IntDatum(n)) -> n.to_string(), _ -> "not a number" },
    [] -> "no row",
  }

fn names(rows: List<Row>) -> String =
  match rows {
    [] -> "no rows",
    [row, ..] -> match row.get("name") { Some(TextDatum(t)) -> t, _ -> "the name is not text" },
  }

fn create_items_table(c: Cluster) -> Unit / {postgres::Postgres, abort.raise} = {
  let _ = postgres::psql(c, "create table if not exists items (id int4 primary key, name text)");
  ()
}

fn create_ledger_table(c: Cluster, ids: List<Int>) -> Unit / {postgres::Postgres, abort.raise} = {
  let _ = postgres::psql(c, "create table ledger (id int4 primary key, n int4 not null)");
  ids.fold((), |u: Unit, id: Int| {
    let _ = postgres::psql(c, "insert into ledger values (" ++ id.to_string() ++ ", 0)");
    ()
  })
}

fn inserted(
  url: String,
  password: Option<Secret<Bytes>>,
) -> Result<String, String> / {Wire, abort.raise, diverges} =
  Result::flatten(
    with_server(
      url,
      4,
      password: password,
      body: || {
        match db.returning[items](
            statement_of("insert into items (id, name) values ($1, $2) returning id"),
            [IntParameter(7), TextParameter("seven")],
          ) {
          Failed(e) -> Err(e.detail),
          Count(_) -> Err("a count where rows were due"),
          Rows(rows) -> match rows {
            [] -> Err("no row came back from the insert"),
            [row, ..] -> match row.get("id") {
              Some(IntDatum(n)) -> match db.query[items](
                  statement_of("select name from items where id = $1"),
                  [IntParameter(7)],
                ) {
                Failed(e) -> Err(e.detail),
                Count(_) -> Err("a count where rows were due"),
                Rows(found) -> Ok(n.to_string() ++ " " ++ names(found)),
              },
              _ -> Err("the id is not an int"),
            },
          },
        }
      },
    ),
  )

test/nondet "the db effect is served from a real server" {
  if postgres::available() {
    let c = postgres::scram("pencil");
    create_items_table(c);
    let ran = inserted(plain_url(c), None);
    postgres::stop(c);
    assert_eq(ran, Ok("7 seven"))
  }
}

test/nondet "the db effect sends a password in the clear when asked, from the url or from settings" {
  if postgres::available() {
    let c = postgres::clear_text("p@ss:w");
    create_items_table(c);
    let port = c.port.to_string();
    let in_url = "postgres://ply:p%40ss%3Aw@127.0.0.1:" ++ port ++ "/ply?sslmode=disable";
    let given = Some(Secret::of_bytes(b"p@ss:w"));
    let first = inserted(in_url, None);
    let _ = postgres::psql(c, "delete from items");
    let bare = inserted("postgres://ply@127.0.0.1:" ++ port ++ "/ply?sslmode=disable", given);
    let both = inserted(in_url, given);
    postgres::stop(c);
    assert_eq(first, Ok("7 seven"));
    assert_eq(bare, Ok("7 seven"));
    assert(match both { Err(reason) -> reason.contains("give it once"), Ok(_) -> false }, None)
  }
}

fn shown_count(row: Row) -> String =
  match row.get("n") {
    Some(TextDatum(t)) -> t,
    Some(IntDatum(n)) -> n.to_string(),
    _ -> "not a count",
  }

fn commit_one(url: String) -> Result<String, String> / {Wire, abort.raise, diverges} =
  Result::flatten(
    with_server(url, 4, || {
      match transaction(ReadCommitted, ReadWrite, || {
          db.execute[items](statement_of("insert into items (id, name) values ($1, $2)"), [
            IntParameter(8),
            TextParameter("eight"),
          ])
        }) {
        Err(roll) -> Err(roll.reason),
        Ok(_) -> match db.query[items](statement_of("select count(*) as n from items"), []) {
          Failed(e) -> Err(e.detail),
          Count(_) -> Err("a count where rows were due"),
          Rows(rows) -> match rows { [row, ..] -> Ok(shown_count(row)), [] -> Err("no row") },
        },
      }
    }),
  )

test/nondet "a transaction commits what it did" {
  if postgres::available() {
    let c = postgres::scram("pencil");
    create_items_table(c);
    let first = inserted(plain_url(c), None);
    let committed = commit_one(plain_url(c));
    postgres::stop(c);
    assert_eq(first, Ok("7 seven"));
    assert_eq(committed, Ok("2"))
  }
}

fn setting(row: Row) -> String =
  match ((row.get("name"), row.get("setting"))) {
    (Some(TextDatum(name)), Some(TextDatum(value))) -> name ++ "=" ++ value,
    _ -> "not a setting",
  }

fn timeouts(url: String) -> Result<String, String> / {Wire, abort.raise, diverges} =
  Result::flatten(
    with_server(url, 1, || {
      match db.query[pg_settings](
          statement_of(
            "select name, setting from pg_settings where name = 'statement_timeout' or name = 'idle_in_transaction_session_timeout' order by name",
          ),
          [],
        ) {
        Failed(e) -> Err(e.detail),
        Count(_) -> Err("a count where rows were due"),
        Rows(rows) ->
          Ok(rows.fold("", |accumulator: String, row: Row| accumulator ++ setting(row) ++ ";")),
      }
    }),
  )

fn overrun(url: String) -> Result<String, String> / {Wire, abort.raise, diverges} =
  Result::flatten(
    with_server(url, 1, || {
      match db.query[pg_class](
          statement_of("select count(*) as n from pg_class a, pg_class b, pg_class c, pg_class d"),
          [],
        ) {
        Failed(e) -> Ok(failure(e)),
        _ -> Err("the statement finished inside its timeout"),
      }
    }),
  )

test/nondet "a connection string's timeouts bound every statement on the server" {
  if postgres::available() {
    let c = postgres::scram("pencil");
    let bounded = plain_url(c) ++ "&statement_timeout=200&idle_in_transaction_session_timeout=1500";
    let read_back = timeouts(bounded);
    let overran = overrun(bounded);
    postgres::stop(c);
    assert_eq(read_back, Ok("idle_in_transaction_session_timeout=1500;statement_timeout=200;"));
    assert(
      match overran {
        Ok(reason) -> reason.starts_with("57014: ") && reason.contains("statement timeout"),
        Err(_) -> false,
      },
      None,
    )
  }
}

fn bump(id: Int, by: Int) -> QueryResult / {db.execute[ledger]} =
  db.execute[ledger](statement_of("update ledger set n = n + $2 where id = $1"), [
    IntParameter(id),
    IntParameter(by),
  ])

fn ended(out: Result<Unit, Rollback>) -> String =
  match out { Ok(_) -> "committed", Err(rolled) -> rolled.reason }

fn two_at_once(
  url: String,
) -> Result<String, String> / {Wire, task.spawn, task.join, abort.raise, diverges} =
  with_server(url, 2, || {
    let result_text = task.spawn(||
      ended(
        transaction(ReadCommitted, ReadWrite, || {
          bump(1, 1);
          ()
        }),
      ));
    let undone = task.spawn(||
      ended(
        transaction(ReadCommitted, ReadWrite, || {
          bump(1, 10);
          db.rollback("undone")
        }),
      ));
    task.join(result_text) ++ " " ++ task.join(undone)
  })

test/nondet "two tasks running transactions at once each use their own connection" {
  if postgres::available() {
    let c = postgres::scram("pencil");
    create_ledger_table(c, [1]);
    let both = two_at_once(plain_url(c));
    let n = postgres::psql(c, "select n from ledger where id = 1");
    postgres::stop(c);
    assert_eq(both, Ok("committed undone"));
    assert_eq(n, "1")
  }
}

fn serialized(url: String) -> Result<String, String> / {Wire, abort.raise, diverges} =
  with_server(url, 1, || contended(url, 3, ""))

fn contended(
  url: String,
  left: Int,
  seen: String,
) -> String / {db.query[ledger], db.execute[ledger], db.abort, db.begin, db.commit, Wire, abort.raise, diverges} =
  match transaction(Serializable, ReadWrite, || {
      db.query[ledger](statement_of("select n from ledger where id = $1"), [IntParameter(1)]);
      if seen == "" {
        with_server(url, 1, || transaction(Serializable, ReadWrite, || bump(1, 10)));
        ()
      };
      match bump(1, 1) {
        Failed(e) -> db.rollback(if is_retryable(e) { "retry " ++ e.code } else { e.code }),
        _ -> (),
      }
    }) {
    Ok(_) -> seen ++ "committed",
    Err(rolled) -> if rolled.reason.starts_with("retry ") && left > 1 {
      contended(url, left - 1, seen ++ rolled.reason.slice(6, rolled.reason.len()) ++ " then ")
    } else { seen ++ rolled.reason },
  }

test/nondet "a serialization failure is 40001 and the retried transaction commits" {
  if postgres::available() {
    let c = postgres::scram("pencil");
    create_ledger_table(c, [1]);
    let retried = serialized(plain_url(c));
    let n = postgres::psql(c, "select n from ledger where id = 1");
    postgres::stop(c);
    assert_eq(retried, Ok("40001 then committed"));
    assert_eq(n, "11")
  }
}

fn deadlocked(url: String) -> String / {Wire, task.spawn, task.join, abort.raise, diverges} = {
  let a = task.spawn(|| marshalling(url, 1, 2));
  let b = task.spawn(|| marshalling(url, 2, 1));
  task.join(a) ++ " " ++ task.join(b)
}

fn marshalling(url: String, first: Int, second: Int) -> String / {Wire, abort.raise, diverges} =
  match with_server(url, 1, ||
      ended(
        transaction(ReadCommitted, ReadWrite, || {
          bump(first, 1);
          both_written(400);
          match bump(second, 1) { Failed(e) -> db.rollback(e.code), _ -> () }
        }),
      )) {
    Err(reason) -> reason,
    Ok(text) -> text,
  }

fn both_written(left: Int) -> Unit / {db.query[pg_locks]} =
  if left <= 0 { () } else {
    match db.query[pg_locks](
        statement_of(
          "select count(*) as n from pg_locks where locktype = 'transactionid' and granted",
        ),
        [],
      ) {
      Rows([row, ..]) -> match row.get("n") {
        Some(IntDatum(n)) -> if n >= 2 { () } else { both_written(left - 1) },
        _ -> both_written(left - 1),
      },
      _ -> both_written(left - 1),
    }
  }

test/nondet "a deadlock fails one transaction with 40P01 and the other transaction commits" {
  if postgres::available() {
    let c = postgres::scram("pencil");
    create_ledger_table(c, [1, 2]);
    let outcomes = deadlocked(plain_url(c));
    let sum = postgres::psql(c, "select sum(n) from ledger");
    postgres::stop(c);
    assert_eq(outcomes.split(" ").sort_by(|a: String, b: String| compare(a, b) == Less), [
      "40P01",
      "committed",
    ]);
    assert_eq(sum, "2")
  }
}

fn encrypted(url: String) -> Result<String, String> / {Wire, abort.raise, diverges} =
  Result::flatten(
    with_server(url, 1, ||
      match db.query[pg_stat_ssl](
          statement_of("select count(*) as n from pg_stat_ssl where ssl"),
          [],
        ) {
        Failed(e) -> Err(failure(e)),
        Count(_) -> Err("a count where rows were due"),
        Rows(rows) -> Ok(number(rows)),
      }),
  )

fn connection_failure(r: Result<String, String>, what: String) -> Bool =
  match r { Err(reason) -> reason.starts_with("08001: ") && reason.contains(what), Ok(_) -> false }

test/nondet "a secured connection is encrypted and verified for its host" {
  if postgres::available() {
    let c = postgres::scram_with_tls("pencil", postgres::trusted());
    let modes = ["sslmode=verify-full", "sslmode=require", "sslmode=verify-ca"].map(
      |mode: String| encrypted(postgres::url(c, "localhost", mode)),
    );
    let plaintext = encrypted(postgres::url(c, "localhost", "sslmode=disable"));
    postgres::stop(c);
    assert_eq(modes, [Ok("1"), Ok("1"), Ok("1")]);
    assert_eq(plaintext, Ok("0"))
  }
}

test/nondet "a certificate not trusted, or not for the host, is rejected" {
  if postgres::available() {
    let issued = certgen.issue();
    let stranger = postgres::scram_with_tls("pencil", {
      certificate: issued.certificate,
      key: issued.key,
    });
    let untrusted = encrypted(postgres::url(stranger, "localhost", "sslmode=require"));
    postgres::stop(stranger);
    let c = postgres::scram_with_tls("pencil", postgres::trusted());
    let elsewhere = encrypted(postgres::url(c, "127.0.0.1", "sslmode=verify-full"));
    postgres::stop(c);
    assert(connection_failure(untrusted, "not trusted"), None);
    assert(connection_failure(elsewhere, "not trusted"), None)
  }
}

test/nondet "a server that will not speak TLS is not spoken to in plaintext" {
  if postgres::available() {
    let c = postgres::scram("pencil");
    let r = encrypted(postgres::url(c, "127.0.0.1", "sslmode=require"));
    postgres::stop(c);
    assert(connection_failure(r, "does not speak TLS"), None)
  }
}

test/nondet "a Postgres connection with `sslnegotiation=direct` starts TLS immediately without a plaintext request first" {
  if postgres::available() {
    let c = postgres::scram_with_tls("pencil", postgres::trusted());
    let r = encrypted(postgres::url(c, "localhost", "sslmode=verify-full&sslnegotiation=direct"));
    postgres::stop(c);
    if postgres::major_version() >= 17 { assert_eq(r, Ok("1")) }
    else { assert(connection_failure(r, ""), None) }
  }
}

fn shown(n: Notice) -> String =
  match n {
    Notified(note) -> note.channel ++ ":" ++ note.payload,
    Reconnected -> "reconnected",
    ListenFailed(e) -> "unheard " ++ e.code,
    Quiet -> "quiet",
  }

fn result_text(r: Result<String, Rollback>) -> String =
  match r { Ok(s) -> s, Err(rolled) -> rolled.reason }

fn notices(url: String) -> Result<String, String> / {Wire, abort.raise, diverges} =
  with_server(url, 2, || {
    db.listen[jobs]();
    let inside = result_text(
      transaction(ReadCommitted, ReadWrite, || {
        db.notify[jobs]("one");
        db.notify[jobs]("one");
        shown(db.next_notification(300))
      }),
    );
    let committed = shown(db.next_notification(10000));
    let once = shown(db.next_notification(300));
    let rolled = result_text(
      transaction(ReadCommitted, ReadWrite, || {
        db.notify[jobs]("two");
        db.rollback("undone");
        "not rolled back"
      }),
    );
    let none = shown(db.next_notification(300));
    db.notify[jobs]("three");
    let at_once = shown(db.next_notification(10000));
    db.listen[other]();
    db.unlisten[jobs]();
    db.notify[jobs]("four");
    let after = shown(db.next_notification(300));
    String::join([inside, committed, once, rolled, none, at_once, after], " ")
  })

test/nondet "a Postgres notification is received only when its transaction commits, never when it rolls back" {
  if postgres::available() {
    let c = postgres::scram("pencil");
    let received = notices(plain_url(c));
    postgres::stop(c);
    assert_eq(received, Ok("quiet jobs:one quiet undone quiet jobs:three quiet"))
  }
}

fn collect_notifications(
  want: Int,
  left: Int,
  accumulator: List<String>,
) -> String / {db.next_notification, db.execute[heard]} =
  if accumulator.len() >= want || left <= 0 { String::join(accumulator, ",") } else {
    match db.next_notification(1000) {
      Quiet -> collect_notifications(want, left - 1, accumulator),
      n -> {
        db.execute[heard](statement_of("insert into heard (what) values ($1)"), [
          TextParameter(shown(n)),
        ]);
        collect_notifications(want, left - 1, accumulator.push(shown(n)))
      },
    }
  }

fn reconnects(url: String) -> Result<String, String> / {Wire, abort.raise, diverges} =
  with_server(url, 1, || {
    db.listen[jobs]();
    collect_notifications(3, 30, [])
  })

fn wait_until<| e>(
  what: String,
  tries: Int,
  ready: () -> Bool / e,
) -> Unit / {clock.write, abort.raise | e} =
  if ready() { () }
  else if tries <= 0 { panic("waited for " ++ what) } else {
    clock.sleep(millis(100));
    wait_until(what, tries - 1, ready)
  }

test/nondet "a listener whose connection is terminated reconnects, listens again and reports that it did" {
  if postgres::available() {
    let c = postgres::scram("pencil");
    let _ = postgres::psql(c, "create table heard (what text)");
    let listener = task.spawn(|| reconnects(plain_url(c)));
    let listening = "select count(*) from pg_stat_activity where query = 'listen \"jobs\"'";
    let is_recorded = |what: String|
      postgres::psql(c, "select count(*) from heard where what = '" ++ what ++ "'") == "1";
    wait_until("the listener to listen", 100, || postgres::psql(c, listening) == "1");
    let _ = postgres::psql(c, "select pg_notify('jobs', 'first')");
    wait_until("the first to be heard", 100, || is_recorded("jobs:first"));
    let _ = postgres::psql(
      c,
      "select pg_terminate_backend(pid) from pg_stat_activity where query = 'listen \"jobs\"'",
    );
    wait_until("the listener to reconnect", 100, || is_recorded("reconnected"));
    let _ = postgres::psql(c, "select pg_notify('jobs', 'second')");
    let notifications = task.join(listener);
    postgres::stop(c);
    assert_eq(notifications, Ok("jobs:first,reconnected,jobs:second"))
  }
}

const sample: List<List<sql::Param>> =
  [
    [
      IntParameter(1),
      TextParameter("plain"),
      BytesParameter(b"\x00\x01\xff"),
      ArrayParameter([TextParameter("a"), TextParameter("b,c")]),
      NumericParameter(1.5m),
    ],
    [
      IntParameter(2),
      TextParameter("tab\there\nnew line\\back"),
      NullParameter,
      NullParameter,
      NullParameter,
    ],
    [
      IntParameter(3),
      TextParameter("\\N"),
      BytesParameter(b""),
      ArrayParameter([]),
      NumericParameter(0m),
    ],
  ]

fn named(id: Int, name: String) -> List<sql::Param> =
  [IntParameter(id), TextParameter(name), NullParameter, NullParameter, NullParameter]

const all: sql::Statement =
  statement_of("select id, name, data, tags, price from items order by id")

fn counted() -> String / {db.query[items]} =
  match db.query[items](statement_of("select count(*) as n from items"), []) {
    Rows(rows) -> number(rows),
    Failed(e) -> failure(e),
    Count(_) -> "a count",
  }

fn copied_in<| e>(
  rows: Seq<List<sql::Param> | e>,
  chunk: Int,
  budget: Int,
) -> String / {db.copy_in[items], db.copy_rows[items], db.copy_end[items] | e} =
  match try[seq.spent] {
      copy_into[items](["id", "name", "data", "tags", "price"], rows, chunk, budget)
    } {
    Ok(Ok(n)) -> n.to_string(),
    Ok(Err(e)) -> e.code,
    Err(spent) -> "spent " ++ spent.to_string(),
  }

fn copies(url: String) -> Result<String, String> / {Wire, abort.raise, diverges} =
  with_server(url, 2, || {
    let into = copied_in(seq::of_list(sample), 2, 100);
    let out = copy_from[items](all, 2, |rows: Seq<Row | {db.copy_take[items]}>|
      try[seq.spent] { seq::to_list(rows, 100) });
    let same = match out {
      Ok(Ok(copied)) -> match db.query[items](all, []) {
        Rows(queried) -> if copied == queried { "same" } else { "different" },
        _ -> "no rows",
      },
      Ok(Err(_)) -> "spent",
      Err(e) -> failure(e),
    };
    let twice = copied_in(seq::of_list([named(4, "new"), named(1, "again")]), 1, 100);
    let after_twice = counted();
    let spent = copied_in(seq::of_list(range(10, 15).map(|i: Int| named(i, "x"))), 2, 3);
    let after_spent = counted();
    let rolled = result_text(
      transaction(ReadCommitted, ReadWrite, || {
        let copied = copied_in(seq::of_list([named(20, "y")]), 10, 10);
        db.rollback("rolled back after " ++ copied);
        "not rolled back"
      }),
    );
    let after_rolled = counted();
    let broken = match copy_from[items](
        statement_of("select 1 / (id - 2) as x from items order by id"),
        1,
        |rows: Seq<Row | {db.copy_take[items]}>| try[seq.spent] { seq::to_list(rows, 100).len() },
      ) {
      Ok(_) -> "kept",
      Err(e) -> e.code,
    };
    String::join(
      [into, same, twice, after_twice, spent, after_spent, rolled, after_rolled, broken],
      " ",
    )
  })

test/nondet "rows are copied in and out whole or not at all" {
  if postgres::available() {
    let c = postgres::scram("pencil");
    let _ = postgres::psql(
      c,
      "create table items (id int4 primary key, name text, data bytea, tags text[], price numeric(10, 2))",
    );
    let copied = copies(plain_url(c));
    let left = postgres::psql(
      c,
      "select string_agg(id::text || '=' || coalesce(name, 'null'), ';' order by id) from items",
    );
    postgres::stop(c);
    assert_eq(copied, Ok("3 same 23505 3 spent 3 3 rolled back after 1 3 22012"));
    assert_eq(left, "1=plain;2=tab\there\nnew line\\back;3=\\N")
  }
}
