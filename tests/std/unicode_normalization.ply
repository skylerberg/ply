import std.list
import std.unicode
import std.unicode (Form, Maybe, Nfc, Nfd, Nfkc, Nfkd, No, QuickCheckResult, Yes)
import ucd_files
import ucd_files (Block, Row, Span, CodePointRange, code_points_of, rows_under, hex_code_points,
                  text, failing_code_points, uncovered_spans)

pub type Line = { source: String, nfc: String, nfd: String, nfkc: String, nfkd: String }

pub const lines: List<Line> =
  ucd_files::normalization_test.split(b"\n").fold([], |found: List<Line>, line: Bytes|
    if line.len() == 0 || line.at(0) == b'#' || line.at(0) == b'@' { found } else {
      match line.split(b";").take(5).map(|column: Bytes| text(code_points_of(column))) {
        [source, nfc, nfd, nfkc, nfkd] ->
          found.push({ source: source, nfc: nfc, nfd: nfd, nfkc: nfkc, nfkd: nfkd }),
        _ -> panic(f"`{String::of_bytes_lossy(line)}` is no line of the test"),
      }
    })

fn conforms(l: Line) -> Bool = {
  let all = [l.source, l.nfc, l.nfd, l.nfkc, l.nfkd];
  [l.source, l.nfc, l.nfd].map(unicode::nfc) == [l.nfc, l.nfc, l.nfc]
    && [l.nfkc, l.nfkd].map(unicode::nfc) == [l.nfkc, l.nfkc]
    && [l.source, l.nfc, l.nfd].map(unicode::nfd) == [l.nfd, l.nfd, l.nfd]
    && [l.nfkc, l.nfkd].map(unicode::nfd) == [l.nfkd, l.nfkd]
    && all.map(unicode::nfkc) == all.map(|_: String| l.nfkc)
    && all.map(unicode::nfkd) == all.map(|_: String| l.nfkd)
}

const blocks: List<Block<Line>> = ucd_files::blocks(lines, 256, |l: Line| hex_code_points(l.source))

test "the {b.lines.len()} lines of NormalizationTest.txt from {b.from} normalize as they say" for b: Block<Line> in blocks {
  assert_eq(b.lines.filter(|l: Line| !conforms(l)).map(|l: Line| hex_code_points(l.source)), [])
}

test "a code point not listed in NormalizationTest.txt is unchanged by NFC, NFD, NFKC and NFKD" {
  let listed = lines.fold(Map::new(), |seen: Map<Int, Unit>, c: Line|
    match c.source.chars() { [one] -> seen.insert(Int::of_char(one), ()), _ -> seen }).keys(
  ).map(|code_point: Int| { first: code_point, last: code_point, property: () });
  assert(listed.len() > 10000);
  let moved = uncovered_spans(listed, 4096).filter(|span: Span| {
    let apart = text(range(span.first, span.last + 1).flat_map(|code_point: Int| [0, code_point]));
    unicode::nfc(apart) != apart || unicode::nfd(apart) != apart || unicode::nfkc(apart) != apart
      || unicode::nfkd(apart) != apart
  });
  assert_eq(moved, [])
}

type Check = { property: String, form: Form }

const checks: List<Check> =
  [
    { property: "NFC_QC", form: Nfc },
    { property: "NFD_QC", form: Nfd },
    { property: "NFKC_QC", form: Nfkc },
    { property: "NFKD_QC", form: Nfkd },
  ]

test "`unicode::quick_check` of every one-character text matches the Unicode database's {c.property} property for that character" for c: Check in checks {
  let props = ucd_files::derived_normalization_props;
  let valued = |value: String, result: QuickCheckResult|
    rows_under(props, [c.property, value]).map(|row: Row|
      { first: row.first, last: row.last, property: result });
  let stretches = valued("M", Maybe).fold(
    valued("N", No),
    |all: List<CodePointRange<QuickCheckResult>>, s: CodePointRange<QuickCheckResult>| all.push(s),
  ).sort_by(|a: CodePointRange<QuickCheckResult>, b: CodePointRange<QuickCheckResult>|
    a.first < b.first);
  assert(stretches.len() > 0);
  let wrong = failing_code_points(stretches, |code_point: Int, result: Option<QuickCheckResult>|
    (code_point >= 0xD800 && code_point <= 0xDFFF)
      || unicode::quick_check(text([code_point]), c.form)
      == (match result { Some(quick) -> quick, None -> Yes }));
  assert_eq(wrong, [])
}
