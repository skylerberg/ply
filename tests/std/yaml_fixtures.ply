//! `std.yaml` against the YAML Test Suite, the cases YAML's implementations share: every case of
//! its `data` branch as it stood at commit `6ad3d2c62885d82fc349026c136ef560838fdf3d` of
//! `github.com/yaml/yaml-test-suite`, with its licence beside them. A case is a directory: the
//! stream (`in.yaml`), the events a parser says of it in the suite's notation (`test.event`),
//! the JSON its documents mean where JSON can say it (`in.json`), the suite's own writing of it
//! (`out.yaml`), and an `error` file where the stream is one a reader must refuse. A shipped
//! module embeds no file, so the tests that read files stand here.
//!
//! What is held to the suite: every case's events, every refusal, and the value of every case
//! with an `in.json` or an `out.yaml`. A case whose nodes carry tags the core schema does not
//! define is refused as the reader stands, which is its contract, and read with exactly those
//! tags kept to be compared. The cases in `declined` are valid YAML whose values
//! `std.yaml` refuses, each for the reason beside it.

import std.bytes
import std.json
import std.json (Json)
import std.list
import std.location
import std.string
import std.yaml
import std.yaml (Event, Kind, Limits, Options, Properties, Yaml)

type File = { name: String, bytes: Bytes }

/// A case of the suite: its directory, its stream, the events the suite says of it, and whether
/// a reader must refuse it.
type Case = { id: String, yaml: Bytes, events: String, error: Bool }

/// A case and another text beside it: the suite's JSON, or the suite's own writing of the stream.
type CaseWithFile = { id: String, yaml: Bytes, other: Bytes }

fn files() -> List<File> = embed_dir("yaml")

fn limits() -> Limits = { bytes: 65536, depth: 32, nodes: 10000, scalar: 8192, documents: 32 }

fn by_name() -> Map<String, Bytes> =
  Map::of_entries(files().map(|f: File| { key: f.name, value: f.bytes }))

fn cases() -> List<Case> / {abort.raise} = {
  let found = by_name();
  files().fold([], |acc: List<Case>, f: File|
    if f.name.ends_with("/in.yaml") {
      let id = f.name.strip_suffix("/in.yaml");
      acc.push({
        id: id,
        yaml: f.bytes,
        events: match found.get(id ++ "/test.event") {
          Some(text) -> String::of_bytes(text),
          None -> panic(f"{id} has no test.event beside it"),
        },
        error: found.contains(id ++ "/error"),
      })
    } else { acc })
}

fn valid() -> List<Case> / {abort.raise} = cases().filter(|c: Case| !c.error)

fn invalid() -> List<Case> / {abort.raise} = cases().filter(|c: Case| c.error)

/// The valid cases whose nodes carry a tag the core schema does not define.
fn tagged() -> List<Case> / {abort.raise} = valid().filter(|c: Case| foreign_tags(c.yaml).len() > 0)

/// The valid cases that have the file `other` beside them, with it.
fn cases_with_file(other: String) -> List<CaseWithFile> / {abort.raise} = {
  let found = by_name();
  valid().fold([], |acc: List<CaseWithFile>, c: Case|
    match found.get(c.id ++ "/" ++ other) {
      Some(text) -> acc.push({ id: c.id, yaml: c.yaml, other: text }),
      None -> acc,
    })
}

/// A case `std.yaml` refuses the value of though the suite calls it valid, and why.
type RejectedCase = { id: String, reason: String }

/// The suite holds a parser to the syntax alone, and these two streams are well formed. Their
/// mappings hold a key twice, which YAML 1.2.2 says no mapping does, so the events are read and
/// the value is refused.
fn rejected_cases() -> List<RejectedCase> =
  [
    { id: "2JQS", reason: "a block mapping with two empty keys" },
    { id: "X38W", reason: "a flow mapping whose alias repeats the key it stands for" },
  ]

fn is_rejected_case(id: String) -> Bool = rejected_cases().any(|d: RejectedCase| d.id == id)

// --- The suite's notation for events ----------------------------------------

fn escaped(text: String) -> String / {abort.raise} =
  String::of_bytes(
    [
      { from: b"\\", to: b"\\\\" },
      { from: b"\n", to: b"\\n" },
      { from: b"\t", to: b"\\t" },
      { from: b"\r", to: b"\\r" },
      { from: b"\x08", to: b"\\b" },
    ].fold(Bytes::of_string(text), |raw: Bytes, e: { from: Bytes, to: Bytes }|
      raw.replace(e.from, e.to)),
  )

fn properties(p: Properties) -> String =
  (match p.anchor { Some(name) -> " &" ++ name, None -> "" })
    ++ (match p.tag { Some(tag) -> " <" ++ tag ++ ">", None -> "" })

fn event_line(kind: Kind) -> Option<String> / {abort.raise} =
  match kind {
    yaml::StreamStart -> Some("+STR"),
    yaml::StreamEnd -> Some("-STR"),
    yaml::DocumentStart(explicit) -> Some(if explicit { "+DOC ---" } else { "+DOC" }),
    yaml::DocumentEnd(explicit) -> Some(if explicit { "-DOC ..." } else { "-DOC" }),
    yaml::Alias(name) -> Some("=ALI *" ++ name),
    yaml::Scalar(p, text, style) ->
      Some(
        "=VAL" ++ properties(p) ++ " "
          ++ (match style {
            yaml::Plain -> ":",
            yaml::SingleQuoted -> "'",
            yaml::DoubleQuoted -> "\"",
            yaml::Literal -> "|",
            yaml::Folded -> ">",
          })
          ++ escaped(text),
      ),
    yaml::SequenceStart(p, flow) ->
      Some("+SEQ" ++ (if flow { " []" } else { "" }) ++ properties(p)),
    yaml::SequenceEnd -> Some("-SEQ"),
    yaml::MappingStart(p, flow) -> Some("+MAP" ++ (if flow { " {}" } else { "" }) ++ properties(p)),
    yaml::MappingEnd -> Some("-MAP"),
    yaml::Comment(_) -> None,
  }

/// Events as the suite writes them, one to a line; a comment is none of the suite's.
fn notation(events: List<Event>) -> String / {abort.raise} =
  events.fold("", |written: String, e: Event|
    match event_line(e.kind) { Some(line) -> written ++ line ++ "\n", None -> written })

// --- The suite's JSON -------------------------------------------------------

type SplitState = { depth: Int, quoted: Bool, escaped: Bool, start: Int, out: List<Bytes> }

fn is_space(c: Int) -> Bool = c == b' ' || c == b'\n' || c == b'\r' || c == b'\t'

/// The JSON values written one after another in `text`, which is how the suite says what the
/// documents of a stream mean.
fn json_values(text: Bytes) -> List<Bytes> / {abort.raise} = {
  let n = text.len();
  let done = range(0, n).fold(
    { depth: 0, quoted: false, escaped: false, start: -1, out: [] },
    |s: SplitState, i: Int| {
      let c = text.at(i);
      let start = if s.start < 0 && !is_space(c) { i } else { s.start };
      if s.quoted {
        if s.escaped { { ..s, escaped: false } }
        else if c == 92 { { ..s, escaped: true } }
        else if c != 34 { s }
        else if s.depth > 0 { { ..s, quoted: false } }
        else { { ..s, quoted: false, start: -1, out: s.out.push(text.slice(start, i + 1)) } }
      } else if c == 34 { { ..s, quoted: true, start: start } }
      else if c == b'{' || c == b'[' { { ..s, depth: s.depth + 1, start: start } }
      else if c == b'}' || c == b']' {
        if s.depth > 1 { { ..s, depth: s.depth - 1 } }
        else { { ..s, depth: 0, start: -1, out: s.out.push(text.slice(start, i + 1)) } }
      } else if is_space(c) && s.depth == 0 && s.start >= 0 {
        { ..s, start: -1, out: s.out.push(text.slice(s.start, i)) }
      } else { { ..s, start: start } }
    },
  );
  if done.start >= 0 { done.out.push(text.slice(done.start, n)) } else { done.out }
}

/// Whether a value is what the suite's JSON says: a tag is looked through, since JSON has none,
/// and a number is the number, written as an integer or a float.
fn matches_json(v: Yaml, j: Json) -> Bool =
  match v {
    yaml::Tagged(_, held) -> matches_json(held, j),
    yaml::Null -> j == json::Null,
    yaml::Boolean(flag) -> j == json::Bool(flag),
    yaml::String(text) -> j == json::Str(text),
    yaml::Integer(n) -> j == json::Number(Decimal::of_int(n)),
    yaml::Float(f) -> match j { json::Number(d) -> Float::of_decimal(d) == f, _ -> false },
    yaml::Sequence(items) -> match j {
      json::Array(wanted) ->
        items.len() == wanted.len()
          && range(0, items.len()).fold(true, |same: Bool, i: Int|
            same
              && (match items.at(i) {
                Some(item) -> match wanted.at(i) {
                  Some(w) -> matches_json(item, w),
                  None -> false,
                },
                None -> false,
              })),
      _ -> false,
    },
    yaml::Mapping(entries) -> match j {
      json::Object(members) ->
        entries.len() == members.len()
          && entries.fold(true, |same: Bool, e: yaml::Entry|
            same
              && (match e.key {
                yaml::String(name) -> match members.get(name) {
                  Some(w) -> matches_json(e.value, w),
                  None -> false,
                },
                _ -> false,
              })),
      _ -> false,
    },
  }

/// Every tag the stream's nodes carry that the core schema does not define: what a reader is
/// asked to keep so that the stream's value can be read at all.
fn foreign_tags(text: Bytes) -> List<String> =
  match try { yaml::events(text, limits()) } {
    Err(_) -> [],
    Ok(events) ->
      events.fold([], |tags: List<String>, e: Event| {
        let tag = match e.kind {
          yaml::Scalar(p, _, _) -> p.tag,
          yaml::SequenceStart(p, _) -> p.tag,
          yaml::MappingStart(p, _) -> p.tag,
          _ -> None,
        };
        match tag {
          Some(named) -> if named == "!"
              || (named.starts_with("tag:yaml.org,2002:")
              && ["null", "bool", "int", "float", "str", "seq", "map"].any(|core: String|
                named == "tag:yaml.org,2002:" ++ core)) { tags }
          else { tags.push(named) },
          None -> tags,
        }
      }).unique(
      ),
  }

fn read_options(text: Bytes) -> Options = { merge_keys: false, keep_tags: foreign_tags(text) }

fn documents_or_panic(r: Result<List<Yaml>, yaml::Error>) -> List<Yaml> / {abort.raise} =
  match r { Ok(documents) -> documents, Err(e) -> panic(yaml::error_message(e)) }

// --- The tests --------------------------------------------------------------

test "the suite is the cases counted here" {
  let all = cases();
  assert_eq(
    {
      cases: all.len(),
      valid: valid().len(),
      rejected: invalid().len(),
      with_json: cases_with_file("in.json").len(),
      rewritten: cases_with_file("out.yaml").len(),
      tagged: tagged().len(),
      declined: rejected_cases().len(),
    },
    {
      cases: 402,
      valid: 308,
      rejected: 94,
      with_json: 279,
      rewritten: 242,
      tagged: 16,
      declined: 2,
    },
  )
}

test "{c.id} is refused" for c: Case in invalid() {
  assert(match yaml::parse_all(c.yaml, limits()) { Ok(_) -> false, Err(_) -> true });
  assert(match try { yaml::events(c.yaml, limits()) } { Ok(_) -> false, Err(_) -> true })
}

test "{c.id} is read as the events the suite says" for c: Case in valid() {
  assert_eq(
    match try { yaml::events(c.yaml, limits()) } {
      Ok(events) -> notation(events),
      Err(e) -> yaml::error_message(e),
    },
    c.events,
  )
}

test "{c.id} is read alike however its lines end" for c: Case in cases() {
  let ended = |ending: Bytes|
    match try { yaml::events(c.yaml.replace(b"\n", ending), limits()) } {
      Ok(events) -> notation(events),
      Err(_) -> "refused",
    };
  let wanted = if c.error { "refused" } else { c.events };
  assert_eq(ended(b"\r\n"), wanted);
  assert_eq(ended(b"\r"), wanted)
}

test "{c.id} means what the suite's JSON says" for c: CaseWithFile in cases_with_file("in.json") {
  let wanted = json_values(c.other).map(|text: Bytes|
    match json::parse(text) { Ok(j) -> j, Err(e) -> panic(json::error_to_string(e)) });
  let read = documents_or_panic(yaml::parse_all(c.yaml, limits(), read_options(c.yaml)));
  assert_eq(read.len(), wanted.len());
  assert_eq(
    range(0, read.len()).filter(|i: Int|
      match read.at(i) {
        Some(v) -> match wanted.at(i) { Some(w) -> !matches_json(v, w), None -> true },
        None -> true,
      }),
    [],
  )
}

test "{c.id} is well formed, and refused for the key it holds twice" for c: RejectedCase in rejected_cases(
  ) {
  let text = match by_name().get(c.id ++ "/in.yaml") {
    Some(found) -> found,
    None -> panic(f"{c.id} is no case of the suite"),
  };
  assert(match try { yaml::events(text, limits()) } { Ok(_) -> true, Err(_) -> false });
  assert(match yaml::parse_all(text, limits(), read_options(text)) {
    Err(e) -> match e.reason { yaml::Duplicate(_) -> true, _ -> false },
    Ok(_) -> false,
  })
}

test "{c.id} is refused for its tag until the reader keeps it" for c: Case in tagged() {
  let tags = foreign_tags(c.yaml);
  assert(match yaml::parse_all(c.yaml, limits()) {
    Err(e) -> match e.reason {
      yaml::UnknownTag(tag) -> tags.any(|t: String| t == tag),
      _ -> false,
    },
    Ok(_) -> false,
  });
  assert(match yaml::parse_all(c.yaml, limits(), read_options(c.yaml)) {
    Ok(_) -> true,
    Err(_) -> false,
  })
}

test "{c.id} means what the suite's own writing of it means" for c: CaseWithFile in cases_with_file(
    "out.yaml",
  ) {
  if !is_rejected_case(c.id) {
    assert_eq(
      yaml::parse_all(c.other, limits(), read_options(c.other)),
      yaml::parse_all(c.yaml, limits(), read_options(c.yaml)),
    )
  }
}

test "{c.id} reads back from what is written of it" for c: Case in valid() {
  if !is_rejected_case(c.id) {
    let read = documents_or_panic(yaml::parse_all(c.yaml, limits(), read_options(c.yaml)));
    assert_eq(
      yaml::parse_all(yaml::stream_to_bytes(read), limits(), read_options(c.yaml)),
      Ok(read),
    );
    assert_eq(
      read.map(|v: Yaml| yaml::parse_string(yaml::inline(v), limits(), read_options(c.yaml))),
      read.map(|v: Yaml| Ok(v)),
    )
  }
}

/// What is wrong with how the reader took `text`, if anything: a failure of its own answered as
/// a refusal, a refusal placed outside the text, or values that do not write back.
fn reader_problem(text: Bytes) -> Option<String> =
  match yaml::parse_all(text, limits(), read_options(text)) {
    Err(e) -> match e.reason {
      yaml::Defect(documents_or_panic) -> Some(documents_or_panic),
      _ -> if e.line < 1 || e.column < 1 || e.offset < 0 || e.offset > text.len() {
        Some("a refusal placed outside the text")
      } else { None },
    },
    Ok(read) -> if yaml::parse_all(yaml::stream_to_bytes(read), limits(), read_options(text))
        == Ok(read) { None }
    else { Some("values that do not read back from what is written of them") },
  }

test "{c.id} cut short is read, or refused for a reason" for c: Case in cases() {
  let n = c.yaml.len();
  // At most 96 cuts, each a parse of the document's head.
  let stride = n / 96 + 1;
  assert_eq(
    range(0, n / stride + 1).fold([], |faults: List<String>, k: Int|
      match reader_problem(c.yaml.slice(0, k * stride)) {
        Some(documents_or_panic) -> faults.push(f"cut at {k * stride}: {documents_or_panic}"),
        None -> faults,
      }),
    [],
  )
}

test "{c.id} with a byte taken out is read, or refused for a reason" for c: Case in cases() {
  let n = c.yaml.len();
  let stride = n / 96 + 1;
  assert_eq(
    range(0, (n - 1) / stride + 1).fold([], |faults: List<String>, k: Int| {
      let at = k * stride;
      if at >= n { faults } else {
        match reader_problem(c.yaml.slice(0, at).concat(c.yaml.slice(at + 1, n))) {
          Some(documents_or_panic) ->
            faults.push(f"without the byte at {at}: {documents_or_panic}"),
          None -> faults,
        }
      }
    }),
    [],
  )
}

test "{c.id} is a document that keeps its bytes, and a key set in it" for c: Case in valid() {
  let path = [location::Key("a key no case holds")];
  match yaml::parse_document(c.yaml, limits(), read_options(c.yaml)) {
    Err(_) -> (),
    Ok(d) -> {
      assert_eq(yaml::source(d), c.yaml);
      match yaml::value(d) {
        yaml::Mapping(_) -> match try { yaml::set(d, path, yaml::Integer(7)) } {
          Err(e) -> panic(yaml::error_message(e)),
          Ok(added) -> {
            assert_eq(yaml::at(yaml::value(added), path), Some(yaml::Integer(7)));
            assert_eq(try { yaml::value(yaml::remove(added, path)) }, Ok(yaml::value(d)))
          },
        },
        _ -> (),
      }
    },
  }
}
