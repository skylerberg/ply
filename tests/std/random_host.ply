import std.random (next, below, nonce)

test/nondet "a draw is the operating system's, and two of them are independent" {
  assert(next() != next(), None)
}

test/nondet "`below(4)` returns a value from 0 up to but not including 4" {
  assert(below(4) >= 0 && below(4) < 4, None)
}

test/nondet "`nonce` returns two parts separated by `-`, and the first part is not empty" {
  let text = nonce();
  let parts = text.split("-");
  assert_eq(parts.len(), 2);
  assert(match parts { [first, ..] -> first != "", [] -> false }, Some(text))
}
