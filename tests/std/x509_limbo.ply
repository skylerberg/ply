import std.date
import std.ip
import std.json
import std.json (Json)
import std.list
import std.result
import std.show (show)
import std.x509
import std.x509 (x509, Certificate)

fn member(j: Json, name: String) -> Json =
  match json::get(j, name) { Some(v) -> v, None -> json::Null }

fn text(j: Json, name: String) -> String = match member(j, name) { json::Str(s) -> s, _ -> "" }

fn texts(j: Json, name: String) -> List<String> =
  match member(j, name) {
    json::Array(xs) -> xs.map(|x: Json| match x { json::Str(s) -> s, _ -> "" }),
    _ -> [],
  }

type Case = {
  id: String,
  features: List<String>,
  client: Bool,
  trusted: List<String>,
  untrusted: List<String>,
  peer: String,
  time: String,
  purposes: List<String>,
  succeeds: Bool,
  name_kind: String,
  name: String,
  depth: Option<Int>,
}

fn case_of(j: Json) -> Case =
  {
    id: text(j, "id"),
    features: texts(j, "features"),
    client: text(j, "validation_kind") == "CLIENT",
    trusted: texts(j, "trusted_certs"),
    untrusted: texts(j, "untrusted_intermediates"),
    peer: text(j, "peer_certificate"),
    time: text(j, "validation_time"),
    purposes: texts(j, "extended_key_usage"),
    succeeds: text(j, "expected_result") == "SUCCESS",
    name_kind: text(member(j, "expected_peer_name"), "kind"),
    name: text(member(j, "expected_peer_name"), "value"),
    depth: match member(j, "max_chain_depth") {
      json::Number(n) -> Int::of_decimal(n, Down),
      _ -> None,
    },
  }

const cases: List<Case> =
  match json::parse(embed("x509/limbo.json")) {
    Ok(j) -> match member(j, "testcases") { json::Array(xs) -> xs.map(case_of), _ -> [] },
    Err(e) -> panic(json::error_to_string(e)),
  }

type SkipRule = { mark: String, rule: String }

const by_feature: List<SkipRule> =
  [
    { mark: "has-crl", rule: "revocation is not checked" },
    { mark: "has-mldsa", rule: "ML-DSA is not verified" },
    { mark: "has-policy-constraints", rule: "policies are not processed" },
    { mark: "pedantic-public-suffix-wildcard", rule: "no list of public suffixes is consulted" },
    { mark: "pedantic-webpki-eku", rule: "an extended key usage is bound by RFC 5280" },
  ]

const by_id: List<SkipRule> =
  [
    { mark: "webpki::cn::", rule: "a common name is not read" },
    {
      mark: "rfc5280::aki::cross-signed-root-missing-aki",
      rule: "a trust anchor is not bound by the profile of what it signs",
    },
    { mark: "rfc5280::ca-as-leaf", rule: "a CA is not taken as a leaf" },
    { mark: "pathlen::validation-ignores-pathlen-in-leaf", rule: "a CA is not taken as a leaf" },
    {
      mark: "rfc5280::nc::permitted-dns-match-noncritical",
      rule: "name constraints that are not critical are taken",
    },
  ]

fn skip_reason(c: Case) -> Option<String> =
  match by_feature.find_map(|r: SkipRule|
      if c.features.contains(r.mark) { Some(r.rule) } else { None }) {
    Some(rule) -> Some(rule),
    None ->
      by_id.find_map(|r: SkipRule|
        if c.id == r.mark || (r.mark.ends_with("::") && c.id.starts_with(r.mark)) { Some(r.rule) }
        else { None }),
  }

const cases_to_run: List<Case> = cases.filter(|c: Case| skip_reason(c) == None)

fn certificates(
  pems: List<String>,
  mode: x509::Strictness,
) -> List<Certificate> / {x509.fail, abort.raise} =
  pems.fold([], |all: List<Certificate>, text: String|
    x509::read_pem(text, x509::limits(), mode).fold(
      all,
      |accumulator: List<Certificate>, c: Certificate| accumulator.push(c),
    ))

fn outcome(c: Case) -> Result<Int, String> / {abort.raise} = {
  let mode = if c.features.contains("pedantic-serial-number") { x509::Strict }
  else { x509::Tolerant };
  let read = try {
    {
      leaf: certificates([c.peer], mode),
      offered: certificates(c.untrusted, mode),
      anchors: certificates(c.trusted, mode),
    }
  };
  let at = match date::parse_rfc3339(if c.time == "" { "2026-10-06T00:00:00+00:00" }
    else { c.time }) {
    Some(t) -> date::instant(t),
    None -> None,
  };
  let who = if c.name_kind == "DNS" { Some(x509::Host(c.name)) } else if c.name_kind == "IP" {
    match ip::parse(c.name) { Ok(a) -> Some(x509::IpAddress(a)), Err(_) -> None }
  } else { Some(x509::Anyone) };
  let purpose = if c.purposes.contains("clientAuth") || (c.client && c.purposes.len() == 0) {
    x509::ClientAuth
  } else { x509::ServerAuth };
  let policy = match c.depth {
    Some(most) -> { ..x509::strict, depth: most },
    None -> x509::strict,
  };
  match ((read, at, who)) {
    (Err(rejection), _, _) -> Err("unread: " ++ show(rejection)),
    (Ok(found), Some(instant), Some(identity)) -> match found.leaf.at(0) {
      None -> Err("no leaf"),
      Some(leaf) -> match x509::verify(
          leaf,
          found.offered,
          found.anchors,
          instant,
          identity,
          purpose,
          policy,
        ) {
        Ok(path) -> Ok(path.len()),
        Err(failure) -> Err(show(failure.reason)),
      },
    },
    _ -> panic(f"{c.id}: a time or a name that is not read"),
  }
}

test "X.509 Limbo test case {c.id} passes certificate verification if it should succeed, and fails it if it should fail" for c: Case in cases_to_run {
  match outcome(c) {
    Ok(_) -> assert(c.succeeds),
    Err(reason) -> assert_eq(if c.succeeds { reason } else { "" }, ""),
  }
}

test "the Limbo suite has the expected number of cases, and each reason for skipping cases skips the expected number of them" {
  let all = cases;
  let under = |prefix: String| all.count(|c: Case| c.id.starts_with(prefix));
  assert_eq(all.len(), 905);
  assert_eq(under("bettertls::nameconstraints::"), 594);
  assert_eq(under("bettertls::pathbuilding::"), 81);
  let rules = by_feature.concat(by_id).map(|r: SkipRule| r.rule).unique();
  assert_eq(
    rules.map(|rule: String|
      { rule: rule, cases: all.count(|c: Case| skip_reason(c) == Some(rule)) }),
    [
      { rule: "revocation is not checked", cases: 17 },
      { rule: "ML-DSA is not verified", cases: 6 },
      { rule: "policies are not processed", cases: 1 },
      { rule: "no list of public suffixes is consulted", cases: 3 },
      { rule: "an extended key usage is bound by RFC 5280", cases: 4 },
      { rule: "a common name is not read", cases: 9 },
      { rule: "a trust anchor is not bound by the profile of what it signs", cases: 1 },
      { rule: "a CA is not taken as a leaf", cases: 2 },
      { rule: "name constraints that are not critical are taken", cases: 1 },
    ],
  );
  let ran = cases_to_run;
  assert_eq(ran.len(), 861);
  assert_eq(ran.count(|c: Case| c.succeeds), 159);
  assert_eq(ran.count(|c: Case| c.features.contains("pedantic-serial-number")), 3);
  assert_eq(ran.count(|c: Case| c.time == ""), 156)
}

test "a negative serial number fails to parse in both strict and tolerant modes, but a zero or too-long serial number fails only in strict mode" {
  let peer = |id: String, mode: x509::Strictness|
    match cases.filter(|c: Case| c.id == id) {
      [c, ..] -> Result::err(try { certificates([c.peer], mode) }),
      [] -> panic(f"no case {id}"),
    };
  let ids = ["rfc5280::serial::zero", "rfc5280::serial::too-long", "rfc5280::serial::negative"];
  assert_eq(ids.map(|id: String| peer(id, x509::Strict)), [
    Some(x509::BadSerial),
    Some(x509::BadSerial),
    Some(x509::BadSerial),
  ]);
  assert_eq(ids.map(|id: String| peer(id, x509::Tolerant)), [None, None, Some(x509::BadSerial)])
}
