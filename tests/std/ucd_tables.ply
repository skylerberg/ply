import std.bytes
import std.fs (fs)
import std.list
import std.snapshot
import std.snapshot (Change, Same, Snapshots)
import ucd_files
import ucd_files (Row, rows_under, unicode_data)

type PropertyRuns = Map<Int, Bytes>

type RunsState = { runs: List<{ key: Int, value: Bytes }>, next: Int }

fn property_runs<| e>(
  rows: List<Row>,
  missing: Bytes,
  value: (Row) -> Bytes / e,
) -> PropertyRuns / {abort.raise | e} = {
  let laid = rows.fold({ runs: [], next: 0 }, |so_far: RunsState, row: Row|
    if row.first < so_far.next { panic("rows that do not rise") } else {
      let before = if row.first > so_far.next {
        so_far.runs.push({ key: so_far.next, value: missing })
      } else { so_far.runs };
      { runs: before.push({ key: row.first, value: value(row) }), next: row.last + 1 }
    });
  Map::of_entries(if laid.next > 0x10FFFF { laid.runs }
  else { laid.runs.push({ key: laid.next, value: missing }) })
}

fn marked_runs(file: Bytes, under: List<String>, letter: Bytes) -> PropertyRuns / {abort.raise} =
  property_runs(
    rows_under(file, under).sort_by(|a: Row, b: Row| a.first < b.first),
    b"",
    |_: Row| letter,
  )

fn value_at(of: PropertyRuns, code_point: Int) -> Bytes =
  match of.floor(code_point) { Some(run) -> run.value, None -> b"" }

fn trim_empty_fields(line: Bytes, count: Int) -> Bytes / {abort.raise} =
  range(0, count).fold(line, |trimmed: Bytes, _: Int|
    if trimmed.ends_with(b";") { trimmed.slice(0, trimmed.len() - 1) } else { trimmed })

type Run = { first: Int, value: Bytes }

fn runs(fields: List<List<PropertyRuns>>) -> List<Run> / {abort.raise} = {
  let starts = fields.flatten().fold(Map::new(), |all: PropertyRuns, one: PropertyRuns|
    all.merge(one)).keys(
  );
  starts.fold([], |found: List<Run>, start: Int| {
    let value = trim_empty_fields(
      Bytes::join(
        fields.map(|layers: List<PropertyRuns>|
          Bytes::concat_all(layers.map(|of: PropertyRuns| value_at(of, start)))),
        b";",
      ),
      fields.len(),
    );
    match found.at(found.len() - 1) {
      Some(last) -> if last.value == value { found }
      else { found.push({ first: start, value: value }) },
      None -> found.push({ first: start, value: value }),
    }
  })
}

fn code_point_hex(code_point: Int) -> Bytes =
  Bytes::concat_all(
    [20, 16, 12, 8, 4, 0].filter(|shift: Int| shift <= 12 || code_point >> shift != 0).map(
      |shift: Int|
        b"0123456789ABCDEF".slice(code_point >> shift & 15, (code_point >> shift & 15) + 1),
    ),
  )

fn table(
  published: Bytes,
  about: List<String>,
  fields: List<List<PropertyRuns>>,
  missing: Bytes,
) -> String / {abort.raise} = {
  let found = runs(fields);
  let comments = [
    [f"Unicode {ucd_files::version_of(published)}"],
    about,
    [
      f"{ucd_files::notice_of(published)} Distributed under the Unicode License v3, in LICENSE beside this file.",
    ],
  ].flatten(
  );
  let lines = range(0, found.len()).fold([], |text: List<Bytes>, i: Int| {
    let run = found.get(i);
    let last = match found.at(i + 1) { Some(next) -> next.first - 1, None -> 0x10FFFF };
    if run.value == missing { text } else {
      text.push(
        Bytes::concat_all([
          code_point_hex(run.first),
          if last == run.first { b"" } else { b"..".concat(code_point_hex(last)) },
          b";",
          run.value,
          b"\n",
        ]),
      )
    }
  });
  String::of_bytes(
    Bytes::concat_all(
      [comments.map(|line: String| Bytes::of_string(f"# {line}\n")), lines].flatten(),
    ),
  )
}

fn unicode_data_field(index: Int, missing: Bytes) -> PropertyRuns / {abort.raise} =
  property_runs(unicode_data, missing, |row: Row| row.fields.get(index))

const classes: String = {
  let core = ucd_files::derived_core_properties;
  table(
    core,
    [
      "The General_Category, six binary properties and the decimal digit value of every code point,",
      "from UnicodeData.txt, DerivedCoreProperties.txt and PropList.txt of the Unicode Character",
      "Database. A line is a run of code points that share them all:",
      "`first[..last];category[;flags[;digit]]`, the flags being A Alphabetic, L Lowercase,",
      "U Uppercase, W White_Space, S XID_Start and C XID_Continue. A code point in no line is Cn,",
      "unassigned, with no flag and no digit.",
    ],
    [
      [unicode_data_field(2, b"Cn")],
      [
        marked_runs(core, ["Alphabetic"], b"A"),
        marked_runs(core, ["Lowercase"], b"L"),
        marked_runs(core, ["Uppercase"], b"U"),
        marked_runs(ucd_files::prop_list, ["White_Space"], b"W"),
        marked_runs(core, ["XID_Start"], b"S"),
        marked_runs(core, ["XID_Continue"], b"C"),
      ],
      [unicode_data_field(6, b"")],
    ],
    b"Cn",
  )
}

fn mapping_offsets(index: Int) -> PropertyRuns / {abort.raise} =
  property_runs(unicode_data, b"0", |row: Row| {
    let mapped = row.fields.get(index);
    if mapped.len() == 0 { b"0" }
    else { Bytes::of_string(Int::to_string(ucd_files::hex(mapped) - row.first)) }
  })

const simple_case: String =
  table(
    ucd_files::derived_core_properties,
    [
      "The simple case mappings of every code point that has one, from UnicodeData.txt of the Unicode",
      "Character Database. A line is a run of code points that move alike: `first[..last];upper;lower;title`,",
      "each how far its uppercase, lowercase and titlecase mapping lies from a code point of the run,",
      "`0` for one that maps to itself. A code point in no line maps to itself all three ways.",
    ],
    [[mapping_offsets(12)], [mapping_offsets(13)], [mapping_offsets(14)]],
    b"0;0;0",
  )

fn decomposition(mapping: Bytes) -> Bytes / {abort.raise} =
  if !mapping.starts_with(b"<") { mapping } else {
    match mapping.index_of(b"> ") {
      Some(i) -> b"~".concat(mapping.slice(i + 2, mapping.len())),
      None -> panic("a tag with no mapping after it"),
    }
  }

const normalization: String = {
  let quick = ucd_files::derived_normalization_props;
  table(
    quick,
    [
      "What normalization reads of every code point, from UnicodeData.txt and",
      "DerivedNormalizationProps.txt of the Unicode Character Database:",
      "`first[..last];class;decomposition;quick`. The class is the Canonical_Combining_Class, left",
      "out where it is 0. The decomposition is one step of the Decomposition_Mapping, after `~` where",
      "it is a compatibility mapping. The quick checks are C where NFC_Quick_Check is No and c where",
      "it is Maybe, and K and k for NFKC_Quick_Check. A code point in no line has class 0, no",
      "decomposition and Yes for both; a Hangul syllable is in none, its decomposition being arithmetic.",
    ],
    [
      [
        property_runs(unicode_data, b"", |row: Row|
          if row.fields.get(3) == b"0" { b"" } else { row.fields.get(3) }),
      ],
      [property_runs(unicode_data, b"", |row: Row| decomposition(row.fields.get(5)))],
      [
        marked_runs(quick, ["NFC_QC", "N"], b"C"),
        marked_runs(quick, ["NFC_QC", "M"], b"c"),
        marked_runs(quick, ["NFKC_QC", "N"], b"K"),
        marked_runs(quick, ["NFKC_QC", "M"], b"k"),
      ],
    ],
    b"",
  )
}

fn property_runs_from_unsorted<| e>(
  rows: List<Row>,
  missing: Bytes,
  value: (Row) -> Bytes / e,
) -> PropertyRuns / {abort.raise | e} =
  property_runs(rows.sort_by(|a: Row, b: Row| a.first < b.first), missing, value)

fn full_case_mapping(column: Int, simple: Int) -> PropertyRuns / {abort.raise} = {
  let singly = unicode_data.fold(Map::new(), |known: Map<Int, Bytes>, row: Row|
    if row.fields.get(simple).len() == 0 { known }
    else { known.insert(row.first, row.fields.get(simple)) });
  property_runs_from_unsorted(
    ucd_files::rows(ucd_files::special_casing).filter(|row: Row| row.fields.len() == 4),
    b"",
    |row: Row| {
      let full = row.fields.get(column);
      let one = match singly.get(row.first) {
        Some(mapped) -> mapped,
        None -> code_point_hex(row.first),
      };
      if full == one { b"" } else { full }
    },
  )
}

const casing: String = {
  let folding = ucd_files::case_folding;
  let folds = ucd_files::rows(folding);
  let statused = |statuses: List<Bytes>|
    folds.filter(|row: Row| statuses.contains(row.fields.get(0)));
  table(
    folding,
    [
      "Case folding and the case mappings that are not one character to one, from CaseFolding.txt,",
      "SpecialCasing.txt, DerivedCoreProperties.txt and PropList.txt of the Unicode Character",
      "Database: `first[..last];fold;full fold;lower;title;upper;flags`. The fold is how far the",
      "simple case folding (statuses C and S) lies from a code point of the run, and the full fold",
      "the code points of status F. Lower, title and upper are SpecialCasing's mappings that hold",
      "under no condition, each left out where it is the simple mapping. The flags are what the",
      "conditions of the others read: c for Cased, i for Case_Ignorable, s for Soft_Dotted, a for a",
      "Canonical_Combining_Class of 230 and b for any other but 0. A code point in no line folds and",
      "maps as its simple mappings say and has no flag.",
    ],
    [
      [
        property_runs_from_unsorted(statused([b"C", b"S"]), b"", |row: Row|
          Bytes::of_string(Int::to_string(ucd_files::hex(row.fields.get(1)) - row.first))),
      ],
      [property_runs_from_unsorted(statused([b"F"]), b"", |row: Row| row.fields.get(1))],
      [full_case_mapping(0, 13)],
      [full_case_mapping(1, 14)],
      [full_case_mapping(2, 12)],
      [
        marked_runs(ucd_files::derived_core_properties, ["Cased"], b"c"),
        marked_runs(ucd_files::derived_core_properties, ["Case_Ignorable"], b"i"),
        marked_runs(ucd_files::prop_list, ["Soft_Dotted"], b"s"),
        property_runs(unicode_data, b"", |row: Row|
          if row.fields.get(3) == b"230" { b"a" }
          else if row.fields.get(3) == b"0" { b"" }
          else { b"b" }),
      ],
    ],
    b"",
  )
}

fn property(file: Bytes) -> PropertyRuns / {abort.raise} =
  property_runs_from_unsorted(ucd_files::rows(file), b"", |row: Row| row.fields.get(0))

const segmentation_table: String = {
  let graphemes = ucd_files::grapheme_break_property;
  let core = ucd_files::derived_core_properties;
  table(
    graphemes,
    [
      "What text segmentation reads of every code point, from GraphemeBreakProperty.txt,",
      "WordBreakProperty.txt, emoji-data.txt and DerivedCoreProperties.txt of the Unicode Character",
      "Database: `first[..last];grapheme;word;flags`, the Grapheme_Cluster_Break and the Word_Break",
      "under the names the database gives their values, left out where they are Other, and the",
      "flags P for Extended_Pictographic and C, E and L for an Indic_Conjunct_Break of Consonant,",
      "Extend and Linker. A code point in no line is Other in both and has no flag.",
    ],
    [
      [property(graphemes)],
      [property(ucd_files::word_break_property)],
      [
        marked_runs(ucd_files::emoji_data, ["Extended_Pictographic"], b"P"),
        marked_runs(core, ["InCB", "Consonant"], b"C"),
        marked_runs(core, ["InCB", "Extend"], b"E"),
        marked_runs(core, ["InCB", "Linker"], b"L"),
      ],
    ],
    b"",
  )
}

fn combined<| e>(layers: List<PropertyRuns>, mix: (List<Bytes>) -> Bytes / e) -> PropertyRuns / e =
  Map::of_entries(
    layers.fold(Map::new(), |all: PropertyRuns, one: PropertyRuns| all.merge(one)).keys().map(
      |start: Int| { key: start, value: mix(layers.map(|of: PropertyRuns| value_at(of, start))) },
    ),
  )

fn categorized(categories: List<Bytes>, value: Bytes) -> PropertyRuns / {abort.raise} =
  property_runs(unicode_data, b"", |row: Row|
    if categories.contains(row.fields.get(2)) { value } else { b"" })

const width: String = {
  let east = ucd_files::east_asian_width;
  let core = ucd_files::derived_core_properties;
  let graphemes = ucd_files::grapheme_break_property;
  let emoji = ucd_files::emoji_data;
  let drawn = [
    property_runs(
      [{ first: 0xAD, last: 0xAD, fields: [] }, { first: 0x115F, last: 0x115F, fields: [] }],
      b"",
      |_: Row| b"1",
    ),
    marked_runs(ucd_files::prop_list, ["Prepended_Concatenation_Mark"], b"1"),
  ];
  let unseen = [
    categorized([b"Mn", b"Me", b"Cf", b"Cc", b"Zl", b"Zp"], b"0"),
    marked_runs(core, ["Default_Ignorable_Code_Point"], b"0"),
    marked_runs(graphemes, ["V"], b"0"),
    marked_runs(graphemes, ["T"], b"0"),
  ];
  let wide = [
    marked_runs(east, ["W"], b"2"),
    marked_runs(east, ["F"], b"2"),
    marked_runs(east, ["A"], b"A"),
  ];
  table(
    east,
    [
      "How many columns a terminal gives every code point, from EastAsianWidth.txt, UnicodeData.txt,",
      "DerivedCoreProperties.txt, PropList.txt, GraphemeBreakProperty.txt and emoji-data.txt of the",
      "Unicode Character Database: `first[..last];columns;flags`. The columns are 0 for a code point",
      "that is not drawn in a column of its own: a General_Category of Mn, Me, Cf, Cc, Zl or Zp, a",
      "Default_Ignorable_Code_Point, and a conjoining Hangul vowel or trailing consonant; but not",
      "U+00AD, U+115F or a Prepended_Concatenation_Mark. Of the rest they are 2 for an",
      "East_Asian_Width of W or F, A for one of A, and left out for one column. The flags are e for",
      "Emoji, p for Emoji_Presentation and m for Emoji_Modifier. A code point in no line takes one",
      "column and has no flag.",
    ],
    [
      [
        combined([drawn, unseen, wide].flatten(), |values: List<Bytes>| {
          let joined = |some: List<Bytes>| Bytes::concat_all(some);
          if joined(values.take(drawn.len())) == b""
              && joined(values.slice(drawn.len(), drawn.len() + unseen.len())) != b"" { b"0" }
          else { joined(values.drop(drawn.len() + unseen.len())) }
        }),
      ],
      [
        marked_runs(emoji, ["Emoji"], b"e"),
        marked_runs(emoji, ["Emoji_Presentation"], b"p"),
        marked_runs(emoji, ["Emoji_Modifier"], b"m"),
      ],
    ],
    b"",
  )
}

fn valid_in_label(statuses: PropertyRuns, of: PropertyRuns) -> PropertyRuns =
  combined([statuses, of], |values: List<Bytes>|
    match values {
      [status, value] -> if status == b"v" || status == b"d" { value } else { b"" },
      _ -> b"",
    })

const idna: String = {
  let mapping = ucd_files::idna_mapping_table;
  let rows = ucd_files::rows(mapping);
  let statuses = property_runs(rows, b"", |row: Row|
    match row.fields.get(0) {
      b"valid" -> b"v",
      b"deviation" -> b"d",
      b"ignored" -> b"i",
      b"mapped" -> b"m",
      b"disallowed" -> b"",
      _ -> panic("a status UTS #46 does not have"),
    });
  let joining = ucd_files::derived_joining_type;
  table(
    ucd_files::derived_joining_type,
    [
      "What UTS #46 reads of every code point, from idna/IdnaMappingTable.txt, UnicodeData.txt and",
      "extracted/DerivedJoiningType.txt of the Unicode Character Database:",
      "`first[..last];status;mapping;bidi;joining`. The status is v for valid, d for deviation, i for",
      "ignored and m for mapped, and left out for disallowed. The mapping of a mapped code point is",
      "the code points it maps to, or, where that is one code point, how far it lies from a code",
      "point of the run, with its sign. A valid or deviation code point has its Bidi_Class, and its",
      "Joining_Type where that is D, L, R or T, with v after it for a Canonical_Combining_Class of 9.",
      "A code point in no line is disallowed.",
    ],
    [
      [statuses],
      [
        property_runs(rows, b"", |row: Row|
          if row.fields.get(0) != b"mapped" { b"" } else {
            match ucd_files::code_points_of(row.fields.get(1)) {
              [one] -> if row.first != row.last { row.fields.get(1) } else {
                let far = one - row.first;
                Bytes::of_string((if far >= 0 { "+" } else { "" }) ++ far.to_string())
              },
              _ -> row.fields.get(1),
            }
          }),
      ],
      [valid_in_label(statuses, unicode_data_field(4, b""))],
      [
        valid_in_label(statuses, marked_runs(joining, ["D"], b"D")),
        valid_in_label(statuses, marked_runs(joining, ["L"], b"L")),
        valid_in_label(statuses, marked_runs(joining, ["R"], b"R")),
        valid_in_label(statuses, marked_runs(joining, ["T"], b"T")),
        valid_in_label(
          statuses,
          property_runs(unicode_data, b"", |row: Row|
            if row.fields.get(3) == b"9" { b"v" } else { b"" }),
        ),
      ],
    ],
    b"",
  )
}

const case_orbits: String = {
  let folding = ucd_files::case_folding;
  let simple = ucd_files::rows(folding).fold(Map::new(), |to: Map<Int, Int>, row: Row|
    if row.fields.get(0) == b"C" || row.fields.get(0) == b"S" {
      to.insert(row.first, ucd_files::hex(row.fields.get(1)))
    } else { to });
  let orbits = simple.entries().fold(
    Map::new(),
    |orbits: Map<Int, List<Int>>, e: { key: Int, value: Int }| {
      let so_far = match orbits.get(e.value) { Some(members) -> members, None -> [e.value] };
      orbits.insert(e.value, so_far.push(e.key))
    },
  );
  let members = orbits.values().map(|orbit: List<Int>|
    orbit.map(|code_point: Int| {
      let others = orbit.filter(|other: Int| other != code_point).sort_by(|a: Int, b: Int| a < b);
      {
        first: code_point,
        last: code_point,
        fields: [
          Bytes::join(
            others.map(|other: Int| Bytes::of_string(Int::to_string(other - code_point))),
            b",",
          ),
        ],
      }
    })).flatten(
  );
  table(
    folding,
    [
      "The case orbits of simple case folding, from CaseFolding.txt of the Unicode Character",
      "Database: the code points whose simple folding (its statuses C and S) is one code point are",
      "one orbit. A line is a run of code points that lie alike from the rest of their orbits:",
      "`first[..last];distances`, how far each other member lies from a code point of the run, with",
      "`,` between them. A code point in no line is alone in its orbit.",
    ],
    [
      [
        property_runs(members.sort_by(|a: Row, b: Row| a.first < b.first), b"", |row: Row|
          row.fields.get(0)),
      ],
    ],
    b"",
  )
}

const scripts: String = {
  let published = ucd_files::scripts;
  table(
    published,
    [
      "The Script of every code point, from Scripts.txt of the Unicode Character Database. A line is",
      "a run of code points of one script: `first[..last];script`, the script by its name there. A",
      "code point in no line is of the script Unknown.",
    ],
    [
      [
        property_runs(
          ucd_files::rows(published).sort_by(|a: Row, b: Row| a.first < b.first),
          b"",
          |row: Row| row.fields.get(0),
        ),
      ],
    ],
    b"",
  )
}

const names: List<String> =
  [
    "LICENSE",
    "breaks.txt",
    "casing.txt",
    "classes.txt",
    "fold.txt",
    "idna.txt",
    "normalization.txt",
    "scripts.txt",
    "simple_case.txt",
    "width.txt",
  ]

fn derive(name: String) -> String / {abort.raise} =
  match name {
    "LICENSE" -> String::of_bytes(ucd_files::license),
    "breaks.txt" -> segmentation_table,
    "casing.txt" -> casing,
    "classes.txt" -> classes,
    "fold.txt" -> case_orbits,
    "idna.txt" -> idna,
    "normalization.txt" -> normalization,
    "scripts.txt" -> scripts,
    "simple_case.txt" -> simple_case,
    "width.txt" -> width,
    _ -> panic(f"nothing derives `{name}`"),
  }

const shipped: Snapshots =
  { dir: "../../packages/std/ucd", files: embed_dir("../../packages/std/ucd") }

test "the shipped Unicode table {name} is byte for byte the table generated from the published Unicode data files" for name: String in names {
  let now = snapshot::compare(shipped, name, derive(name));
  let patch = match now {
    snapshot::Absent(diff) -> diff,
    snapshot::Changed(diff) -> diff,
    Same -> "",
  };
  assert(
    now == Same,
    Some(
      f"`packages/std/ucd/{name}` is not what the published files in `tests/std/ucd/` derive; `{update_command}` writes what they do, as this diff does:\n{patch}",
    ),
  )
}

const update_command: String = "ply run tests/std --fs ucd=packages/std/ucd"

test "the standard library ships no file under `ucd/` that is not generated from the test's Unicode data files" {
  assert_eq(snapshot::unused(shipped, names), [])
}

fn main() -> List<{ name: String, change: Change }> / {fs.read_file[ucd], fs.create_dir[ucd], fs.write_file[ucd], snapshot::snapshot.write_failed, abort.raise} =
  names.map(|name: String| { name: name, change: snapshot::accept[ucd]("", name, derive(name)) })
