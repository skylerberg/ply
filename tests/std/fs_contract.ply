import scratch
import std.fs
import std.fs (fs, files, Entry, ScanEntry)
import std.io
import std.io (io, Sink)
import std.random (entropy)
import std.tar
import std.tar (tar)
import std.time (millis, nanos_at, time)

fn bool_text(b: Bool) -> String = if b { "true" } else { "false" }

fn optional_int_text(n: Option<Int>) -> String =
  match n { Some(v) -> v.to_string(), None -> "none" }

fn optional_bytes_text(b: Option<Bytes>) -> String =
  match b { Some(v) -> "\"" ++ String::of_bytes_lossy(v) ++ "\"", None -> "none" }

fn optional_string_text(s: Option<String>) -> String = match s { Some(v) -> v, None -> "none" }

fn names_text(names: Option<List<String>>) -> String =
  match names {
    Some(ns) ->
      "["
        ++ ns.fold("", |accumulator: String, n: String|
          if accumulator == "" { n } else { accumulator ++ " " ++ n })
        ++ "]",
    None -> "none",
  }

fn kind_text(k: fs::Kind) -> String =
  match k {
    fs::File -> "file",
    fs::Dir -> "dir",
    fs::Symlink -> "symlink",
    fs::Missing -> "missing",
  }

fn entries_text(es: Option<List<Entry>>) -> String =
  match es {
    Some(xs) ->
      xs.fold("", |accumulator: String, e: Entry|
        accumulator ++ (if accumulator == "" { "" } else { " " }) ++ e.path ++ ":"
          ++ kind_text(e.kind)),
    None -> "none",
  }

fn shown_listed(listing: Option<List<fs::Listed>>) -> String =
  match listing {
    Some(xs) ->
      "["
        ++ xs.fold("", |accumulator: String, l: fs::Listed|
          accumulator ++ (if accumulator == "" { "" } else { " " }) ++ l.name ++ ":"
            ++ kind_text(l.kind))
        ++ "]",
    None -> "none",
  }

fn optional_mode_text(m: Option<fs::Mode>) -> String =
  match m { Some(v) -> fs::mode_text(v), None -> "none" }

fn temp_dir_text(made: Option<String>, dir: String, prefix: String) -> String / {fs.kind[scratch]} =
  match made {
    Some(p) ->
      "starts " ++ bool_text(p.starts_with(dir ++ "/" ++ prefix)) ++ ", "
        ++ kind_text(fs.kind[scratch](p)),
    None -> "none",
  }

fn canonical_text(p: Option<String>, tail: String) -> String =
  match p { Some(v) -> "ends " ++ bool_text(v.ends_with(tail)), None -> "none" }

fn owner_only() -> fs::Mode =
  {
    owner: { read: true, write: true, execute: false },
    group: { read: false, write: false, execute: false },
    other: { read: false, write: false, execute: false },
  }

fn script() -> List<String> / {fs.read[scratch], fs.write[scratch]} = {
  let made = fs.create_dir[scratch]("c/a/b");
  let again = fs.create_dir[scratch]("c/a/b");
  let wrote = fs.write_file[scratch]("c/a/b/f.txt", b"hello");
  let first = fs.append[scratch]("c/log", b"ab");
  let second = fs.append[scratch]("c/log", b"cd");
  let copied = fs.copy[scratch]("c/log", "c/log2");
  let copied_dir = fs.copy[scratch]("c/a", "c/a2");
  let moved = fs.rename[scratch]("c/log2", "c/a/moved");
  let _x = fs.write_file[scratch]("c/x", b"one");
  let _y = fs.write_file[scratch]("c/y", b"two");
  let over = fs.rename[scratch]("c/x", "c/y");
  let linked = fs.symlink[scratch]("c/link", "a/b/f.txt");
  let moded = fs.set_mode[scratch]("c/a/b/f.txt", owner_only());
  let stamped = fs.set_modified[scratch]("c/a/b/f.txt", 1700000000000);
  let locked = fs.lock[scratch]("c/held.lock");
  let contended = fs.lock[scratch]("c/held.lock");
  let released = fs.unlock[scratch]("c/held.lock");
  let unheld = fs.unlock[scratch]("c/held.lock");
  let temp = fs.temp_dir[scratch]("c", "t-");
  [
    "create_dir c/a/b -> " ++ bool_text(made),
    "create_dir c/a/b again -> " ++ bool_text(again),
    "write_file c/a/b/f.txt -> " ++ bool_text(wrote),
    "read_file c/a/b/f.txt -> " ++ optional_bytes_text(fs.read_file[scratch]("c/a/b/f.txt")),
    "read_file c/nope -> " ++ optional_bytes_text(fs.read_file[scratch]("c/nope")),
    "file_size c/a/b/f.txt -> " ++ optional_int_text(fs.file_size[scratch]("c/a/b/f.txt")),
    "exists c/a/b/f.txt -> " ++ bool_text(fs.exists[scratch]("c/a/b/f.txt")),
    "exists c/nope -> " ++ bool_text(fs.exists[scratch]("c/nope")),
    "kind c/a -> " ++ kind_text(fs.kind[scratch]("c/a")),
    "kind c/a/b/f.txt -> " ++ kind_text(fs.kind[scratch]("c/a/b/f.txt")),
    "kind c/nope -> " ++ kind_text(fs.kind[scratch]("c/nope")),
    "append c/log ab -> " ++ optional_int_text(first),
    "append c/log cd -> " ++ optional_int_text(second),
    "read_at c/log 1 2 -> " ++ optional_bytes_text(fs.read_at[scratch]("c/log", 1, 2)),
    "read_at c/log 3 5 -> " ++ optional_bytes_text(fs.read_at[scratch]("c/log", 3, 5)),
    "read_at c/log 9 2 -> " ++ optional_bytes_text(fs.read_at[scratch]("c/log", 9, 2)),
    "copy c/log c/log2 -> " ++ bool_text(copied),
    "copy c/a c/a2 -> " ++ bool_text(copied_dir),
    "rename c/log2 c/a/moved -> " ++ bool_text(moved),
    "exists c/log2 -> " ++ bool_text(fs.exists[scratch]("c/log2")),
    "read_file c/a/moved -> " ++ optional_bytes_text(fs.read_file[scratch]("c/a/moved")),
    "rename c/x over c/y -> " ++ bool_text(over),
    "read_file c/y -> " ++ optional_bytes_text(fs.read_file[scratch]("c/y")),
    "symlink c/link a/b/f.txt -> " ++ bool_text(linked),
    "kind c/link -> " ++ kind_text(fs.kind[scratch]("c/link")),
    "resolved c/link -> " ++ kind_text(fs.resolved_kind[scratch]("c/link")),
    "read_link c/link -> " ++ optional_string_text(fs.read_link[scratch]("c/link")),
    "read_link c/log -> " ++ optional_string_text(fs.read_link[scratch]("c/log")),
    "read_file c/link -> " ++ optional_bytes_text(fs.read_file[scratch]("c/link")),
    "set_mode c/a/b/f.txt rw------- -> " ++ bool_text(moded),
    "mode c/a/b/f.txt -> " ++ optional_mode_text(fs.mode[scratch]("c/a/b/f.txt")),
    "set_modified c/a/b/f.txt -> " ++ bool_text(stamped),
    "modified_ms c/a/b/f.txt -> " ++ optional_int_text(fs.modified_ms[scratch]("c/a/b/f.txt")),
    "lock c/held.lock -> " ++ bool_text(locked),
    "lock c/held.lock held -> " ++ bool_text(contended),
    "unlock c/held.lock -> " ++ bool_text(released),
    "unlock c/held.lock again -> " ++ bool_text(unheld),
    "temp_dir c t- -> " ++ temp_dir_text(temp, "c", "t-"),
    "remove_tree the temp dir -> "
      ++ bool_text(match temp { Some(p) -> fs.remove_tree[scratch](p), None -> false }),
    "canonical c/a -> " ++ canonical_text(fs.canonical[scratch]("c/a"), "/c/a"),
    "canonical c/nope -> " ++ canonical_text(fs.canonical[scratch]("c/nope"), "/c/nope"),
    "sync c/log -> " ++ bool_text(fs.sync[scratch]("c/log")),
    "sync c/nope -> " ++ bool_text(fs.sync[scratch]("c/nope")),
    "list_dir c -> " ++ shown_listed(fs.list_dir[scratch]("c")),
    "list_dir c/log -> " ++ shown_listed(fs.list_dir[scratch]("c/log")),
    "list_dir c/nope -> " ++ shown_listed(fs.list_dir[scratch]("c/nope")),
    "walk c/a -> " ++ entries_text(fs.walk[scratch]("c/a")),
    "walk c/log -> " ++ entries_text(fs.walk[scratch]("c/log")),
    "remove c/y -> " ++ bool_text(fs.remove[scratch]("c/y")),
    "remove c/a -> " ++ bool_text(fs.remove[scratch]("c/a")),
    "remove c/nope -> " ++ bool_text(fs.remove[scratch]("c/nope")),
    "remove_tree c -> " ++ bool_text(fs.remove_tree[scratch]("c")),
    "exists c -> " ++ bool_text(fs.exists[scratch]("c")),
  ]
}

pub fn first_difference(disk: List<String>, fake: List<String>) -> Option<String> =
  range(0, max(disk.len(), fake.len())).fold(None, |found: Option<String>, i: Int|
    match found {
      Some(_) -> found,
      None -> {
        let d = match disk.at(i) { Some(l) -> l, None -> "(nothing)" };
        let t = match fake.at(i) { Some(l) -> l, None -> "(nothing)" };
        if d == t { None } else { Some("the disk returned\n  " ++ d ++ "\nand the fake\n  " ++ t) }
      },
    })

test/nondet "the filesystem's fake handles every operation as the disk does" {
  scratch::fresh();
  let disk = script();
  let fake = fs::on_mem(fs::mem_empty(), || script()).value;
  match first_difference(disk, fake) { Some(reason) -> panic(reason), None -> () }
}

fn file_error_text(reason: fs::FileError) -> String =
  match reason {
    fs::NotFound -> "not found",
    fs::Denied -> "denied",
    fs::NotAFile -> "not a file",
    fs::NotADirectory -> "not a directory",
    fs::Exists -> "exists",
    fs::NoSpace -> "no space",
    fs::CrossesRoot -> "crosses root",
    fs::LimitExceeded -> "too much",
    fs::Other(code, text) -> if code == 0 { "failed " ++ text } else { "the host's own" },
  }

fn opened_text(o: Result<Int, fs::FileError>) -> String =
  match o { Ok(_) -> "open", Err(reason) -> file_error_text(reason) }

fn with_descriptor<| e>(o: Result<Int, fs::FileError>, f: (Int) -> String / e) -> String / e =
  match o { Ok(file) -> f(file), Err(_) -> "no descriptor" }

fn streamed() -> List<String> / {fs.read[scratch], fs.write[scratch]} = {
  let made = fs.create_dir[scratch]("s");
  let out = fs.open[scratch]("s/f", fs::ToWrite);
  let wrote = with_descriptor(out, |d: Int|
    bool_text(fs.write_chunk[scratch](d, b"hello ") && fs.write_chunk[scratch](d, b"world")));
  let unread = with_descriptor(out, |d: Int| optional_bytes_text(fs.read_chunk[scratch](d, 4)));
  let closed = with_descriptor(out, |d: Int| bool_text(fs.close[scratch](d)));
  let again = with_descriptor(out, |d: Int| bool_text(fs.close[scratch](d)));
  let late = with_descriptor(out, |d: Int| bool_text(fs.write_chunk[scratch](d, b"!")));
  let more = fs.open[scratch]("s/f", fs::ToAppend);
  let appended = with_descriptor(more, |d: Int|
    bool_text(fs.write_chunk[scratch](d, b"!") && fs.close[scratch](d)));
  let source = fs.open[scratch]("s/f", fs::ToRead);
  let chunks = with_descriptor(source, |d: Int|
    optional_bytes_text(fs.read_chunk[scratch](d, 5)) ++ " "
      ++ optional_bytes_text(fs.read_chunk[scratch](d, 100))
      ++ " "
      ++ optional_bytes_text(fs.read_chunk[scratch](d, 100))
      ++ " "
      ++ optional_bytes_text(fs.read_chunk[scratch](d, 0)));
  let unwritten = with_descriptor(source, |d: Int| bool_text(fs.write_chunk[scratch](d, b"x")));
  let shut = with_descriptor(source, |d: Int| bool_text(fs.close[scratch](d)));
  let after = with_descriptor(source, |d: Int| optional_bytes_text(fs.read_chunk[scratch](d, 1)));
  [
    "create_dir s -> " ++ bool_text(made),
    "open s/f to write -> " ++ opened_text(out),
    "write_chunk twice -> " ++ wrote,
    "read_chunk of a file open to write -> " ++ unread,
    "close -> " ++ closed,
    "close again -> " ++ again,
    "write_chunk after close -> " ++ late,
    "open s/f to append -> " ++ opened_text(more),
    "write_chunk and close -> " ++ appended,
    "open s/f to read -> " ++ opened_text(source),
    "read_chunk 5, 100, 100, 0 -> " ++ chunks,
    "write_chunk of a file open to read -> " ++ unwritten,
    "close -> " ++ shut,
    "read_chunk after close -> " ++ after,
    "open s/nope to read -> " ++ opened_text(fs.open[scratch]("s/nope", fs::ToRead)),
    "open s to read -> " ++ opened_text(fs.open[scratch]("s", fs::ToRead)),
    "open s to write -> " ++ opened_text(fs.open[scratch]("s", fs::ToWrite)),
    "open s/no/f to write -> " ++ opened_text(fs.open[scratch]("s/no/f", fs::ToWrite)),
    "read_file s/f -> " ++ optional_bytes_text(fs.read_file[scratch]("s/f")),
    "remove_tree s -> " ++ bool_text(fs.remove_tree[scratch]("s")),
  ]
}

test/nondet "the fake handles every operation on an open file as the disk does" {
  scratch::fresh();
  let disk = streamed();
  let fake = fs::on_mem(fs::mem_empty(), || streamed()).value;
  match first_difference(disk, fake) { Some(reason) -> panic(reason), None -> () }
}

fn mebibyte() -> Int = 1048576

fn over_the_bound() -> List<String> / {fs.read[scratch], fs.write[scratch], abort.raise} = {
  let block = range(0, 16).fold(b"0123456789abcdef", |b: Bytes, i: Int| b.concat(b));
  let blocks = 65;
  let out = fs.open[scratch]("large", fs::ToWrite);
  let wrote = with_descriptor(out, |d: Int|
    bool_text(
      range(0, blocks).fold(true, |ok: Bool, i: Int| ok && fs.write_chunk[scratch](d, block))
        && fs.close[scratch](d),
    ));
  let size = fs.file_size[scratch]("large");
  let source = fs.open[scratch]("large", fs::ToRead);
  let read = with_descriptor(source, |d: Int| {
    let total = iterate({ bytes: 0, chunks: 0 }, blocks + 2, |s: { bytes: Int, chunks: Int }|
      match fs.read_chunk[scratch](d, 8 * mebibyte()) {
        Some(chunk) -> if chunk.len() == 0 { Stop(s) }
        else { Continue({ bytes: s.bytes + chunk.len(), chunks: s.chunks + 1 }) },
        None -> Stop(s),
      });
    let closed = fs.close[scratch](d);
    total.bytes.to_string() ++ " bytes in " ++ total.chunks.to_string() ++ " chunks, closed "
      ++ bool_text(closed)
  });
  assert(size == Some(blocks * mebibyte()) && blocks * mebibyte() > 64 * mebibyte());
  [
    "write 65 MiB -> " ++ wrote,
    "file_size large -> " ++ optional_int_text(size),
    "read in 8 MiB chunks -> " ++ read,
    "remove large -> " ++ bool_text(fs.remove[scratch]("large")),
  ]
}

test/nondet "a file over the bound of one read is read in chunks, on the disk and over the fake" {
  scratch::fresh();
  let disk = over_the_bound();
  let fake = fs::on_mem(fs::mem_empty(), || over_the_bound()).value;
  assert_eq(disk.at(2), Some("read in 8 MiB chunks -> 68157440 bytes in 9 chunks, closed true"));
  match first_difference(disk, fake) { Some(reason) -> panic(reason), None -> () }
}

fn stat_text(found: Option<fs::Stat>) -> String =
  match found {
    Some(s) -> kind_text(s.kind) ++ "," ++ s.size.to_string() ++ ",x" ++ s.links.to_string(),
    None -> "none",
  }

fn scan_text(seen: Option<List<ScanEntry>>) -> String =
  match seen {
    Some(entries) ->
      entries.fold("", |accumulator: String, s: ScanEntry|
        accumulator ++ (if accumulator == "" { "" } else { " " }) ++ s.path ++ "="
          ++ stat_text(Some(s.stat))),
    None -> "none",
  }

fn linked_text(made: Result<Unit, fs::FileError>) -> String =
  match made { Ok(_) -> "linked", Err(reason) -> file_error_text(reason) }

fn same_file_text(a: String, b: String) -> String / {fs.stat[scratch]} =
  match fs.stat[scratch](a) {
    Some(x) -> match fs.stat[scratch](b) {
      Some(y) -> bool_text(x.device == y.device && x.id == y.id),
      None -> "none",
    },
    None -> "none",
  }

fn nanos_text(found: Option<fs::Stat>) -> String =
  match found { Some(s) -> nanos_at(s.modified).to_string(), None -> "none" }

fn space_text(room: Option<fs::Space>) -> String =
  match room {
    Some(r) -> bool_text(r.total > 0 && r.available <= r.free && r.free <= r.total),
    None -> "none",
  }

fn named() -> List<String> / {fs.read[scratch], fs.write[scratch]} = {
  let made = fs.create_dir[scratch]("n/d");
  let wrote = fs.write_file[scratch]("n/d/a.txt", b"one");
  let pointed = fs.symlink[scratch]("n/l", "d/a.txt");
  let fake = fs.link[scratch]("n/twin", "n/d/a.txt");
  let both = fs.write_file[scratch]("n/twin", b"both");
  let closed = fs.set_mode[scratch]("n/d/a.txt", owner_only());
  let stamped = fs.set_modified[scratch]("n/twin", 1700000000123);
  let created = fs.open[scratch]("n/new", fs::ToCreate);
  let filled = with_descriptor(created, |d: Int|
    bool_text(fs.write_chunk[scratch](d, b"mine") && fs.close[scratch](d)));
  [
    "create_dir n/d -> " ++ bool_text(made),
    "write_file n/d/a.txt -> " ++ bool_text(wrote),
    "symlink n/l -> " ++ bool_text(pointed),
    "link n/twin n/d/a.txt -> " ++ linked_text(fake),
    "write_file n/twin -> " ++ bool_text(both),
    "read_file n/d/a.txt -> " ++ optional_bytes_text(fs.read_file[scratch]("n/d/a.txt")),
    "set_mode n/d/a.txt -> " ++ bool_text(closed),
    "mode n/twin -> " ++ optional_mode_text(fs.mode[scratch]("n/twin")),
    "set_modified n/twin -> " ++ bool_text(stamped),
    "modified_ms n/d/a.txt -> " ++ optional_int_text(fs.modified_ms[scratch]("n/d/a.txt")),
    "stat n/d/a.txt -> " ++ stat_text(fs.stat[scratch]("n/d/a.txt")),
    "stat n/d/a.txt modified -> " ++ nanos_text(fs.stat[scratch]("n/d/a.txt")),
    "stat n/twin -> " ++ stat_text(fs.stat[scratch]("n/twin")),
    "stat n/d -> " ++ stat_text(fs.stat[scratch]("n/d")),
    "stat n/l -> " ++ stat_text(fs.stat[scratch]("n/l")),
    "stat n/l mode -> "
      ++ optional_mode_text(match fs.stat[scratch]("n/l") {
        Some(s) -> Some(s.mode),
        None -> None,
      }),
    "stat n/absent -> " ++ stat_text(fs.stat[scratch]("n/absent")),
    "stat n/d/a.txt/under -> " ++ stat_text(fs.stat[scratch]("n/d/a.txt/under")),
    "one file n/twin n/d/a.txt -> " ++ same_file_text("n/twin", "n/d/a.txt"),
    "one file n/l n/d/a.txt -> " ++ same_file_text("n/l", "n/d/a.txt"),
    "link n/x n/absent -> " ++ linked_text(fs.link[scratch]("n/x", "n/absent")),
    "link n/x n/d -> " ++ linked_text(fs.link[scratch]("n/x", "n/d")),
    "link n/x n/l -> " ++ linked_text(fs.link[scratch]("n/x", "n/l")),
    "link n/l n/d/a.txt -> " ++ linked_text(fs.link[scratch]("n/l", "n/d/a.txt")),
    "link n/twin n/d/a.txt -> " ++ linked_text(fs.link[scratch]("n/twin", "n/d/a.txt")),
    "link n/no/x n/d/a.txt -> " ++ linked_text(fs.link[scratch]("n/no/x", "n/d/a.txt")),
    "link n/d/a.txt/x n/d/a.txt -> " ++ linked_text(fs.link[scratch]("n/d/a.txt/x", "n/d/a.txt")),
    "exists n/x -> " ++ bool_text(fs.exists[scratch]("n/x")),
    "copy n/twin onto n/d/a.txt -> " ++ bool_text(fs.copy[scratch]("n/twin", "n/d/a.txt")),
    "copy n/d/a.txt onto itself -> " ++ bool_text(fs.copy[scratch]("n/d/a.txt", "n/d/a.txt")),
    "read_file n/d/a.txt -> " ++ optional_bytes_text(fs.read_file[scratch]("n/d/a.txt")),
    "rename n/twin onto n/d/a.txt -> " ++ bool_text(fs.rename[scratch]("n/twin", "n/d/a.txt")),
    "exists n/twin -> " ++ bool_text(fs.exists[scratch]("n/twin")),
    "rename n/twin n/moved -> " ++ bool_text(fs.rename[scratch]("n/twin", "n/moved")),
    "modified_ms n/moved -> " ++ optional_int_text(fs.modified_ms[scratch]("n/moved")),
    "remove n/d/a.txt -> " ++ bool_text(fs.remove[scratch]("n/d/a.txt")),
    "stat n/moved -> " ++ stat_text(fs.stat[scratch]("n/moved")),
    "read_file n/moved -> " ++ optional_bytes_text(fs.read_file[scratch]("n/moved")),
    "open n/new to create -> " ++ opened_text(created),
    "write_chunk and close -> " ++ filled,
    "mode n/new -> " ++ optional_mode_text(fs.mode[scratch]("n/new")),
    "open n/new to create again -> " ++ opened_text(fs.open[scratch]("n/new", fs::ToCreate)),
    "open n/d to create -> " ++ opened_text(fs.open[scratch]("n/d", fs::ToCreate)),
    "open n/l to create -> " ++ opened_text(fs.open[scratch]("n/l", fs::ToCreate)),
    "exists n/d/a.txt -> " ++ bool_text(fs.exists[scratch]("n/d/a.txt")),
    "open n/no/new to create -> " ++ opened_text(fs.open[scratch]("n/no/new", fs::ToCreate)),
    "open n/moved/new to create -> " ++ opened_text(fs.open[scratch]("n/moved/new", fs::ToCreate)),
    "open n/moved/new to write -> " ++ opened_text(fs.open[scratch]("n/moved/new", fs::ToWrite)),
    "scan n deep -> " ++ scan_text(fs.scan[scratch]("n", true)),
    "scan n -> " ++ scan_text(fs.scan[scratch]("./n/", false)),
    "scan n/moved -> " ++ scan_text(fs.scan[scratch]("n/moved", true)),
    "scan n/absent -> " ++ scan_text(fs.scan[scratch]("n/absent", false)),
    "space n -> " ++ space_text(fs.space[scratch]("n")),
    "space n/moved -> " ++ space_text(fs.space[scratch]("n/moved")),
    "space n/absent -> " ++ space_text(fs.space[scratch]("n/absent")),
    "remove_tree n -> " ++ bool_text(fs.remove_tree[scratch]("n")),
  ]
}

test/nondet "the in-memory filesystem matches the real disk on `stat`, on hard links and on exclusive file creation" {
  scratch::fresh();
  let disk = named();
  let fake = fs::on_mem(fs::mem_empty(), || named()).value;
  assert_eq(disk.at(10), Some("stat n/d/a.txt -> file,4,x2"));
  assert_eq(disk.at(11), Some("stat n/d/a.txt modified -> 1700000000123000000"));
  assert_eq(disk.at(30), Some("read_file n/d/a.txt -> \"both\""));
  assert_eq(disk.at(34), Some("modified_ms n/moved -> 1700000000123"));
  match first_difference(disk, fake) { Some(reason) -> panic(reason), None -> () }
}

fn bits(n: Int) -> fs::Mode = fs::mode_of_bits(n)

fn atomically(
  path: String,
  body: Bytes,
  durability: fs::Durability,
  mode: Option<fs::Mode>,
) -> String / {fs.read[scratch], fs.write[scratch], entropy.next, abort.raise} = {
  let wrote: Result<Unit, (String, fs::FileError)> = try[files.fail] {
    fs::write_atomic[scratch](path, body, durability, mode)
  };
  match wrote {
    Ok(_) -> "written",
    Err((at, reason)) ->
      (if at.contains(".tmp-") { "beside " ++ path } else { "at " ++ at }) ++ ": "
        ++ file_error_text(reason),
  }
}

fn replaced(
  path: String,
  fail: Bool,
) -> String / {fs.read[scratch], fs.write[scratch], files.fail, entropy.next, abort.raise} = {
  let wrote: Result<Unit, Int> = try[io.too_long] {
    io::replacing[scratch](path, fs::Durable, None, |sink: Sink<| {fs.write_chunk[scratch]}>| {
      let first = (sink.push)(b"str");
      if fail { io.too_long(3) } else { () };
      if first && (sink.push)(b"eamed") { () } else { panic("the sink took nothing") }
    })
  };
  match wrote { Ok(_) -> "replaced", Err(n) -> "raised after " ++ n.to_string() }
}

fn atomic() -> List<String> / {fs.read[scratch], fs.write[scratch], files.fail, entropy.next, abort.raise} = {
  let made = fs.create_dir[scratch]("w/dir");
  let old = fs.write_file[scratch]("w/cfg", b"old") && fs.set_mode[scratch]("w/cfg", bits(416));
  let pointed = fs.symlink[scratch]("w/link", "cfg");
  [
    "create_dir w/dir -> " ++ bool_text(made),
    "write_file and set_mode w/cfg rw-r----- -> " ++ bool_text(old),
    "symlink w/link cfg -> " ++ bool_text(pointed),
    "write_atomic w/cfg durable -> " ++ atomically("w/cfg", b"new", fs::Durable, None),
    "read_file w/cfg -> " ++ optional_bytes_text(fs.read_file[scratch]("w/cfg")),
    "mode w/cfg -> " ++ optional_mode_text(fs.mode[scratch]("w/cfg")),
    "write_atomic w/fresh fast -> " ++ atomically("w/fresh", b"f", fs::Fast, None),
    "mode w/fresh -> " ++ optional_mode_text(fs.mode[scratch]("w/fresh")),
    "write_atomic w/tool rwx------ -> " ++ atomically("w/tool", b"t", fs::Fast, Some(bits(448))),
    "mode w/tool -> " ++ optional_mode_text(fs.mode[scratch]("w/tool")),
    "write_atomic w/link -> " ++ atomically("w/link", b"direct", fs::Durable, None),
    "kind w/link -> " ++ kind_text(fs.kind[scratch]("w/link")),
    "read_file w/link -> " ++ optional_bytes_text(fs.read_file[scratch]("w/link")),
    "read_file w/cfg -> " ++ optional_bytes_text(fs.read_file[scratch]("w/cfg")),
    "write_atomic w/no/cfg -> " ++ atomically("w/no/cfg", b"x", fs::Durable, None),
    "write_atomic w/cfg/under -> " ++ atomically("w/cfg/under", b"x", fs::Durable, None),
    "write_atomic w/dir -> " ++ atomically("w/dir", b"x", fs::Durable, None),
    "kind w/dir -> " ++ kind_text(fs.kind[scratch]("w/dir")),
    "replacing w/cfg -> " ++ replaced("w/cfg", false),
    "read_file w/cfg -> " ++ optional_bytes_text(fs.read_file[scratch]("w/cfg")),
    "mode w/cfg -> " ++ optional_mode_text(fs.mode[scratch]("w/cfg")),
    "replacing w/cfg, raising -> " ++ replaced("w/cfg", true),
    "read_file w/cfg -> " ++ optional_bytes_text(fs.read_file[scratch]("w/cfg")),
    "list_dir w -> " ++ shown_listed(fs.list_dir[scratch]("w")),
    "remove_tree w -> " ++ bool_text(fs.remove_tree[scratch]("w")),
  ]
}

test/nondet "the in-memory filesystem writes a file completely or not at all, like the disk, and leaves no temporary file" {
  scratch::fresh();
  let disk = atomic();
  let fake = fs::on_mem(fs::mem_empty(), || atomic()).value;
  assert_eq(disk.at(23), Some("list_dir w -> [cfg:file dir:dir fresh:file link:file tool:file]"));
  match first_difference(disk, fake) { Some(reason) -> panic(reason), None -> () }
}

fn tree_text(dir: String) -> String / {fs.read[scratch]} =
  match fs.scan[scratch](dir, true) {
    None -> "none",
    Some(entries) ->
      entries.fold("", |accumulator: String, s: ScanEntry|
        accumulator ++ "\n    " ++ s.path ++ "=" ++ stat_text(Some(s.stat))
          ++ (match s.stat.kind {
            fs::Symlink -> " to " ++ optional_string_text(fs.read_link[scratch](s.path)),
            fs::File ->
              " " ++ optional_bytes_text(fs.read_file[scratch](s.path)) ++ " "
                ++ fs::mode_text(s.stat.mode)
                ++ " at "
                ++ Int::to_string(nanos_at(s.stat.modified) / 1000000),
            _ ->
              " " ++ fs::mode_text(s.stat.mode) ++ " at "
                ++ Int::to_string(nanos_at(s.stat.modified) / 1000000),
          })),
  }

fn planted(top: String) -> Bool / {fs.write[scratch]} = {
  let at = |rest: String| top ++ "/" ++ rest;
  let made = fs.create_dir[scratch](at("sub")) && fs.create_dir[scratch](at("empty"))
    && fs.write_file[scratch](at("a.txt"), b"alpha")
    && fs.write_file[scratch](at("sub/b.sh"), b"#!/bin/sh\n")
    && fs.symlink[scratch](at("l"), "sub/b.sh");
  let fake = fs.link[scratch](at("sub/twin.txt"), at("a.txt"));
  let moded = fs.set_mode[scratch](at("a.txt"), bits(416))
    && fs.set_mode[scratch](at("sub/b.sh"), bits(488))
    && fs.set_mode[scratch](at("sub"), bits(493))
    && fs.set_mode[scratch](at("empty"), bits(448))
    && fs.set_mode[scratch](top, bits(493));
  let dated = fs.set_modified[scratch](at("a.txt"), 1600000000000)
    && fs.set_modified[scratch](at("sub/b.sh"), 1600000001000)
    && fs.set_modified[scratch](at("sub"), 1600000002000)
    && fs.set_modified[scratch](at("empty"), 1600000003000)
    && fs.set_modified[scratch](top, 1600000004000);
  made && fake == Ok(()) && moded && dated
}

fn copy_options(existing: fs::Existing, outside: fs::OutsideLink) -> fs::CopyOptions =
  { existing: existing, outside_link: outside, entries: 100, bytes: 100000 }

fn copied_text(copied: Result<fs::CopyResult<Int>, (String, fs::FileError)>) -> String =
  match copied {
    Ok(c) ->
      c.entries.to_string() ++ " entries, " ++ c.bytes.to_string() ++ " bytes, told "
        ++ c.value.to_string()
        ++ ", skipped "
        ++ names_text(Some(c.skipped))
        ++ (if c.stopped { ", stopped" } else { "" }),
    Err((at, reason)) -> "at " ++ at ++ ": " ++ file_error_text(reason),
  }

fn copy_within(
  from: String,
  to: String,
  how: fs::CopyOptions,
) -> String / {fs.read[scratch], fs.write[scratch], abort.raise} = {
  let copied: Result<fs::CopyResult<Int>, (String, fs::FileError)> = try[files.fail] {
    fs::copy_tree[scratch](from, to, how, 0, |n: Int, _told: fs::Progress| Continue(n + 1))
  };
  copied_text(copied)
}

fn copy_across(
  from: String,
  to: String,
  how: fs::CopyOptions,
) -> String / {fs.read[scratch], fs.write[scratch], abort.raise} = {
  let copied: Result<fs::CopyResult<Int>, (String, fs::FileError)> = try[files.fail] {
    fs::copy_tree_across[scratch, scratch](from, to, how, 0, |n: Int, progress: fs::Progress|
      if progress.path == to ++ "/l" { Stop(n + 1) } else { Continue(n + 1) })
  };
  copied_text(copied)
}

fn copied() -> List<String> / {fs.read[scratch], fs.write[scratch], abort.raise} = {
  let grown = planted("t/src");
  let stood = fs.create_dir[scratch]("t/merged/sub")
    && fs.write_file[scratch]("t/merged/a.txt", b"old")
    && fs.write_file[scratch]("t/merged/kept.txt", b"kept")
    && fs.set_mode[scratch]("t/merged/kept.txt", bits(420))
    && fs.set_modified[scratch]("t/merged/kept.txt", 1500000000000)
    && fs.symlink[scratch]("t/merged/empty", "kept.txt");
  let tight = copy_options(fs::Reject, fs::RejectLink);
  let climbing = fs.create_dir[scratch]("t/up") && fs.write_file[scratch]("t/up/f", b"f")
    && fs.symlink[scratch]("t/up/out", "../../t");
  [
    "a tree is planted -> " ++ bool_text(grown),
    "the tree -> " ++ tree_text("t/src"),
    "copy_tree t/src t/out -> "
      ++ copy_within("t/src", "t/out", copy_options(fs::Reject, fs::RejectLink)),
    "the copy -> " ++ tree_text("t/out"),
    "one file t/out/a.txt t/out/sub/twin.txt -> "
      ++ same_file_text("t/out/a.txt", "t/out/sub/twin.txt"),
    "one file t/out/a.txt t/src/a.txt -> " ++ same_file_text("t/out/a.txt", "t/src/a.txt"),
    "mode t/out -> " ++ optional_mode_text(fs.mode[scratch]("t/out")),
    "modified_ms t/out -> " ++ optional_int_text(fs.modified_ms[scratch]("t/out")),
    "copy_tree again, refusing -> "
      ++ copy_within("t/src", "t/out", copy_options(fs::Reject, fs::RejectLink)),
    "something stands at t/merged -> " ++ bool_text(stood),
    "copy_tree, merging -> "
      ++ copy_within("t/src", "t/merged", copy_options(fs::Merge, fs::RejectLink)),
    "the merged -> " ++ tree_text("t/merged"),
    "copy_tree, replacing -> "
      ++ copy_within("t/src", "t/merged", copy_options(fs::Replace, fs::RejectLink)),
    "list_dir t/merged -> " ++ shown_listed(fs.list_dir[scratch]("t/merged")),
    "copy_tree a file over a directory, merging -> "
      ++ copy_within("t/src/a.txt", "t/merged/sub", copy_options(fs::Merge, fs::RejectLink)),
    "copy_tree of nothing -> "
      ++ copy_within("t/absent", "t/nowhere", copy_options(fs::Reject, fs::RejectLink)),
    "copy_tree past its bound -> " ++ copy_within("t/src", "t/nowhere", { ..tight, bytes: 19 }),
    "exists t/nowhere -> " ++ bool_text(fs.exists[scratch]("t/nowhere")),
    "a link climbs -> " ++ bool_text(climbing),
    "copy_tree t/up to the root, refusing the link -> "
      ++ copy_within("t/up", "", copy_options(fs::Merge, fs::RejectLink)),
    "copy_tree t/up to the root, skipping the link -> "
      ++ copy_within("t/up", "", copy_options(fs::Merge, fs::SkipLink)),
    "read_file f -> " ++ optional_bytes_text(fs.read_file[scratch]("f")),
    "exists out -> " ++ bool_text(fs.exists[scratch]("out")),
    "remove f -> " ++ bool_text(fs.remove[scratch]("f")),
    "copy_tree_across, stopping at the link -> "
      ++ copy_across("t/src", "t/over", copy_options(fs::Reject, fs::RejectLink)),
    "the copy across -> " ++ tree_text("t/over"),
    "remove_tree t -> " ++ bool_text(fs.remove_tree[scratch]("t")),
  ]
}

test/nondet "the fake copies a tree, its modes, times and links, as the disk does" {
  scratch::fresh();
  let disk = copied();
  let fake = fs::on_mem(fs::mem_empty(), || copied()).value;
  assert_eq(disk.at(2), Some("copy_tree t/src t/out -> 7 entries, 20 bytes, told 7, skipped []"));
  match first_difference(disk, fake) { Some(reason) -> panic(reason), None -> () }
}

fn changes_text(changes: List<fs::Change>) -> String =
  "["
    ++ changes.fold("", |accumulator: String, c: fs::Change|
      accumulator ++ (if accumulator == "" { "" } else { ", " })
        ++ (match c {
          fs::Created(p) -> "created " ++ p,
          fs::Modified(p) -> "modified " ++ p,
          fs::Removed(p) -> "removed " ++ p,
          fs::Renamed(from, to) -> "renamed " ++ from ++ " to " ++ to,
          fs::Rescan -> "rescan",
        }))
    ++ "]"

fn watched() -> List<String> / {fs.read[scratch], fs.write[scratch], time.sleep_ms, abort.raise} = {
  let made = fs.create_dir[scratch]("v/d") && fs.write_file[scratch]("v/d/a.txt", b"a")
    && fs.set_modified[scratch]("v/d/a.txt", 1600000000000);
  let begun = fs::watch[scratch]("v/d", true, 10);
  let quiet = fs::poll[scratch](begun);
  let wrote = fs.write_file[scratch]("v/d/n.txt", b"n")
    && fs.write_file[scratch]("v/elsewhere", b"e");
  let first = fs::poll[scratch](quiet.watch);
  let grew = fs.write_file[scratch]("v/d/a.txt", b"aa");
  let second = fs::poll[scratch](first.watch);
  let stamped = fs.set_modified[scratch]("v/d/a.txt", 1600000001000);
  let third = fs::poll[scratch](second.watch);
  let renamed = fs.rename[scratch]("v/d/n.txt", "v/d/m.txt");
  let fourth = fs::poll[scratch](third.watch);
  let nested = fs.create_dir[scratch]("v/d/sub") && fs.write_file[scratch]("v/d/sub/x", b"x");
  let fifth = fs::poll[scratch](fourth.watch);
  let moved = fs.rename[scratch]("v/d/sub", "v/d/bus");
  let sixth = fs::poll[scratch](fifth.watch);
  let saved = fs.write_file[scratch]("v/d/m.tmp", b"saved")
    && fs.rename[scratch]("v/d/m.tmp", "v/d/m.txt");
  let seventh = fs::poll[scratch](sixth.watch);
  let closed = fs.set_mode[scratch]("v/d/bus", bits(457)) && fs.remove[scratch]("v/d/a.txt");
  let eighth = fs::poll[scratch](seventh.watch);
  let still = fs::await_changes[scratch](eighth.watch, millis(2), 3);
  let narrow = fs::watch[scratch]("v/d", false, 1);
  let flooded = fs.write_file[scratch]("v/d/one", b"1") && fs.write_file[scratch]("v/d/two", b"2");
  let ninth = fs::poll[scratch](narrow);
  let gone = fs.remove_tree[scratch]("v/d");
  let tenth = fs::poll[scratch](ninth.watch);
  let eleventh = fs::poll[scratch](tenth.watch);
  let back = fs.create_dir[scratch]("v/d");
  let twelfth = fs::poll[scratch](eleventh.watch);
  [
    "a directory to watch -> " ++ bool_text(made),
    "poll, nothing changed -> " ++ changes_text(quiet.changes),
    "a file is made, and one elsewhere -> " ++ bool_text(wrote),
    "poll -> " ++ changes_text(first.changes),
    "a file grows -> " ++ bool_text(grew),
    "poll -> " ++ changes_text(second.changes),
    "a file is stamped -> " ++ bool_text(stamped),
    "poll -> " ++ changes_text(third.changes),
    "a file is renamed -> " ++ bool_text(renamed),
    "poll -> " ++ changes_text(fourth.changes),
    "a directory is made with a file in it -> " ++ bool_text(nested),
    "poll -> " ++ changes_text(fifth.changes),
    "the directory is renamed -> " ++ bool_text(moved),
    "poll -> " ++ changes_text(sixth.changes),
    "a file is saved by renaming another over it -> " ++ bool_text(saved),
    "poll -> " ++ changes_text(seventh.changes),
    "a directory's mode is set and a file removed -> " ++ bool_text(closed),
    "poll -> " ++ changes_text(eighth.changes),
    "await_changes, nothing changing -> " ++ changes_text(still.changes),
    "two files are made under a watch that lists one change -> " ++ bool_text(flooded),
    "poll -> " ++ changes_text(ninth.changes),
    "the directory is removed -> " ++ bool_text(gone),
    "poll -> " ++ changes_text(tenth.changes),
    "poll again -> " ++ changes_text(eleventh.changes),
    "the directory is made again -> " ++ bool_text(back),
    "poll -> " ++ changes_text(twelfth.changes),
    "remove_tree v -> " ++ bool_text(fs.remove_tree[scratch]("v")),
  ]
}

test/nondet "watching the in-memory filesystem reports the same changes as watching the real disk" {
  scratch::fresh();
  let disk = watched();
  let fake = fs::on_mem(fs::mem_empty(), || watched()).value;
  assert_eq(disk.at(13), Some("poll -> [renamed v/d/sub to v/d/bus]"));
  assert_eq(disk.at(15), Some("poll -> [modified v/d/m.txt]"));
  match first_difference(disk, fake) { Some(reason) -> panic(reason), None -> () }
}

fn limits() -> tar::Limits = { entries: 1000, total: 1000000, size: 1000000, path: 4096 }

fn outcome_text(o: tar::OperationOutcome) -> String =
  match o {
    tar::Extracted -> "extracted",
    tar::Barred(tar::ThroughLink) -> "barred through a link",
    tar::Barred(tar::Replaces) -> "barred from replacing",
    tar::Barred(tar::LinkMissing) -> "barred, no file to name",
    tar::Barred(_) -> "barred",
    tar::Failed(reason) -> file_error_text(reason),
  }

fn carried_text(carried: List<tar::ExtractionResult>) -> String =
  carried.fold("", |accumulator: String, c: tar::ExtractionResult|
    accumulator ++ (if accumulator == "" { "" } else { ", " }) ++ c.path ++ " "
      ++ outcome_text(c.outcome))

fn packed(
  dir: String,
  to: String,
  how: tar::PackOptions,
) -> String / {fs.read[scratch], fs.write[scratch], io.closed, io.write_failed, files.fail, tar.unwritable, abort.raise} = {
  let rejected: Result<tar::PackResult, (String, fs::FileError)> = try[io.fail] {
    with_scope[out](
      io::writing[scratch](to),
      io::close_sink,
    ) { sink -> tar::pack[scratch](dir, [""], sink, how) }
  };
  match rejected {
    Ok(p) -> p.entries.to_string() ++ " entries in " ++ p.bytes.to_string() ++ " bytes",
    Err((at, reason)) -> "at " ++ at ++ ": " ++ file_error_text(reason),
  }
}

fn unpacked(
  from: String,
  into: String,
) -> String / {fs.read[scratch], fs.write[scratch], io.fail, io.closed, abort.raise} = {
  let made = fs.create_dir[scratch](into);
  let rejected: Result<Result<List<tar::ExtractionResult>, tar::UnsafeEntry>, tar::Error> = try[tar.fail] {
    let unsafe: Result<List<tar::ExtractionResult>, tar::UnsafeEntry> = try[tar.unsafe] {
      tar::unpack[scratch, scratch](from, into, limits(), 4096)
    };
    unsafe
  };
  if !made { "no directory to unpack into" } else {
    match rejected {
      Ok(Ok(carried)) -> carried_text(carried),
      Ok(Err(e)) -> "entry " ++ e.index.to_string() ++ " (" ++ e.path ++ ") may not be extracted",
      Err(e) -> "no archive at byte " ++ e.at.to_string(),
    }
  }
}

fn archive_of(entries: List<tar::Entry>) -> Bytes / {abort.raise} =
  match tar::encode(entries) { Ok(bytes) -> bytes, Err(_) -> panic("the entries have headers") }

fn archived() -> List<String> / {fs.read[scratch], fs.write[scratch], io.fail, io.closed, io.write_failed, files.fail, tar.unwritable, abort.raise} = {
  let grown = planted("x/src");
  let absent: Result<String, (String, fs::FileError)> = try[io.fail] {
    unpacked("x/absent.tar", "x/nowhere")
  };
  let plain: tar::PackOptions = {
    times: false,
    modes: false,
    entries: 100,
    bytes: 100000,
    chunk: 7,
  };
  let with_metadata: tar::PackOptions = {
    times: true,
    modes: true,
    entries: 100,
    bytes: 100000,
    chunk: 4096,
  };
  let climbs = fs.write_file[scratch](
    "x/climbs.tar",
    archive_of([tar::file("ok", b"1"), tar::file("../escaped", b"x")]),
  );
  let with_descriptor = fs.write_file[scratch](
    "x/through.tar",
    archive_of([tar::file("ok", b"1"), tar::symlink("l", "../../outside"), tar::file("l/f", b"x")]),
  );
  let cut = fs.write_file[scratch](
    "x/cut.tar",
    archive_of([tar::file("ok", b"1"), tar::file("late", b"22")]).slice(0, 1100),
  );
  let swapped = fs.create_dir[scratch]("x/swapped") && fs.create_dir[scratch]("x/elsewhere")
    && fs.symlink[scratch]("x/swapped/sub", "../elsewhere")
    && fs.symlink[scratch]("x/swapped/aimed", "../elsewhere/secret")
    && fs.write_file[scratch]("x/elsewhere/secret", b"kept");
  let steps = match tar::plan([
      tar::file("sub/f", b"x"),
      tar::file("aimed", b"y"),
      tar::file("fine", b"z"),
    ]) {
    Ok(planned) -> planned,
    Err(_) -> panic("planning failed for entries that the test expects to be safe to extract"),
  };
  [
    "a tree is planted -> " ++ bool_text(grown),
    "pack x/src, without times and modes -> " ++ packed("x/src", "x/plain.tar", plain),
    "file_size x/plain.tar -> " ++ optional_int_text(fs.file_size[scratch]("x/plain.tar")),
    "unpack x/plain.tar -> " ++ unpacked("x/plain.tar", "x/plain"),
    "the unpacked -> " ++ tree_text("x/plain"),
    "one file x/plain/a.txt x/plain/sub/twin.txt -> "
      ++ same_file_text("x/plain/a.txt", "x/plain/sub/twin.txt"),
    "pack x/src, with them -> " ++ packed("x/src", "x/kept.tar", with_metadata),
    "unpack x/kept.tar -> " ++ unpacked("x/kept.tar", "x/kept"),
    "the unpacked -> " ++ tree_text("x/kept"),
    "the tree -> " ++ tree_text("x/src"),
    "an archive that climbs out -> " ++ bool_text(climbs),
    "unpack it -> " ++ unpacked("x/climbs.tar", "x/out"),
    "list_dir x/out -> " ++ shown_listed(fs.list_dir[scratch]("x/out")),
    "exists x/escaped -> " ++ bool_text(fs.exists[scratch]("x/escaped")),
    "an archive that writes through its own link -> " ++ bool_text(with_descriptor),
    "unpack it -> " ++ unpacked("x/through.tar", "x/out"),
    "list_dir x/out -> " ++ shown_listed(fs.list_dir[scratch]("x/out")),
    "an archive cut short -> " ++ bool_text(cut),
    "unpack it -> " ++ unpacked("x/cut.tar", "x/out"),
    "list_dir x/out -> " ++ shown_listed(fs.list_dir[scratch]("x/out")),
    "unpack what is not there -> "
      ++ (match absent {
        Ok(message) -> message,
        Err((at, reason)) -> "at " ++ at ++ ": " ++ file_error_text(reason),
      }),
    "a directory whose entries are links out of it -> " ++ bool_text(swapped),
    "extract a plan into it -> "
      ++ tar::extract[scratch](steps, "x/swapped").fold(
        "",
        |accumulator: String, o: tar::OperationOutcome|
          accumulator ++ (if accumulator == "" { "" } else { ", " }) ++ outcome_text(o),
      ),
    "list_dir x/elsewhere -> " ++ shown_listed(fs.list_dir[scratch]("x/elsewhere")),
    "read_file x/elsewhere/secret -> "
      ++ optional_bytes_text(fs.read_file[scratch]("x/elsewhere/secret")),
    "read_file x/swapped/fine -> " ++ optional_bytes_text(fs.read_file[scratch]("x/swapped/fine")),
    "remove_tree x -> " ++ bool_text(fs.remove_tree[scratch]("x")),
  ]
}

test/nondet "archives pack and extract the same on the in-memory filesystem as on the disk, and never extract an entry outside the target directory" {
  scratch::fresh();
  let disk = archived();
  let fake = fs::on_mem(fs::mem_empty(), || archived()).value;
  assert_eq(disk.at(11), Some("unpack it -> entry 1 (../escaped) may not be extracted"));
  assert_eq(disk.at(12), Some("list_dir x/out -> []"));
  assert_eq(disk.at(13), Some("exists x/escaped -> false"));
  assert_eq(disk.at(15), Some("unpack it -> entry 1 (l) may not be extracted"));
  assert_eq(disk.at(16), Some("list_dir x/out -> []"));
  assert_eq(
    disk.at(22),
    Some(
      "extract a plan into it -> barred from replacing, barred through a link, barred from replacing, extracted",
    ),
  );
  assert_eq(disk.at(23), Some("list_dir x/elsewhere -> [secret:file]"));
  match first_difference(disk, fake) { Some(reason) -> panic(reason), None -> () }
}
