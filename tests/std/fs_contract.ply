//! `std.fs`'s twin, `MemFs`, against the disk under the root `scratch`: each script runs on both and
//! must return the same lines, so a program tested over the twin is tested for the disk.

import scratch
import std.fs
import std.fs (fs, files, Entry, Seen)
import std.io
import std.io (io, Sink)
import std.random (entropy)
import std.tar
import std.tar (tar)
import std.time (millis, nanos_at, time)

fn shown_bool(b: Bool) -> String = if b { "true" } else { "false" }

fn shown_opt_int(n: Option<Int>) -> String = match n { Some(v) -> v.to_string(), None -> "none" }

fn shown_opt_text(b: Option<Bytes>) -> String =
  match b { Some(v) -> "\"" ++ String::of_bytes_lossy(v) ++ "\"", None -> "none" }

fn shown_opt_string(s: Option<String>) -> String = match s { Some(v) -> v, None -> "none" }

fn shown_names(names: Option<List<String>>) -> String =
  match names {
    Some(ns) ->
      "[" ++ ns.fold("", |acc: String, n: String| if acc == "" { n } else { acc ++ " " ++ n })
        ++ "]",
    None -> "none",
  }

fn shown_kind(k: fs::Kind) -> String =
  match k {
    fs::File -> "file",
    fs::Dir -> "dir",
    fs::Symlink -> "symlink",
    fs::Missing -> "missing",
  }

fn shown_entries(es: Option<List<Entry>>) -> String =
  match es {
    Some(xs) ->
      xs.fold("", |acc: String, e: Entry|
        acc ++ (if acc == "" { "" } else { " " }) ++ e.path ++ ":" ++ shown_kind(e.kind)),
    None -> "none",
  }

fn shown_mode(m: Option<fs::Mode>) -> String =
  match m { Some(v) -> fs::mode_text(v), None -> "none" }

/// A temp name is the run's own, so only its shape is compared.
fn shown_temp(made: Option<String>, dir: String, prefix: String) -> String / {fs.kind[scratch]} =
  match made {
    Some(p) ->
      "starts " ++ shown_bool(p.starts_with(dir ++ "/" ++ prefix)) ++ ", "
        ++ shown_kind(fs.kind[scratch](p)),
    None -> "none",
  }

/// The disk's root is the scratch directory and the twin's is `/mem`, so only a path's end is
/// compared.
fn shown_canonical(p: Option<String>, tail: String) -> String =
  match p { Some(v) -> "ends " ++ shown_bool(v.ends_with(tail)), None -> "none" }

fn owner_only() -> fs::Mode =
  {
    owner: { read: true, write: true, execute: false },
    group: { read: false, write: false, execute: false },
    other: { read: false, write: false, execute: false },
  }

/// Under `c/`, so the scratch marker is never touched.
fn script() -> List<String> / {fs.read[scratch], fs.write[scratch]} = {
  let made = fs.create_dir[scratch]("c/a/b");
  let again = fs.create_dir[scratch]("c/a/b");
  let wrote = fs.write_file[scratch]("c/a/b/f.txt", b"hello");
  let first = fs.append[scratch]("c/log", b"ab");
  let second = fs.append[scratch]("c/log", b"cd");
  let copied = fs.copy[scratch]("c/log", "c/log2");
  let copied_dir = fs.copy[scratch]("c/a", "c/a2");
  let moved = fs.rename[scratch]("c/log2", "c/a/moved");
  let _x = fs.write_file[scratch]("c/x", b"one");
  let _y = fs.write_file[scratch]("c/y", b"two");
  let over = fs.rename[scratch]("c/x", "c/y");
  let linked = fs.symlink[scratch]("c/link", "a/b/f.txt");
  let moded = fs.set_mode[scratch]("c/a/b/f.txt", owner_only());
  let stamped = fs.set_modified[scratch]("c/a/b/f.txt", 1700000000000);
  let locked = fs.lock[scratch]("c/held.lock");
  let contended = fs.lock[scratch]("c/held.lock");
  let released = fs.unlock[scratch]("c/held.lock");
  let unheld = fs.unlock[scratch]("c/held.lock");
  let temp = fs.temp_dir[scratch]("c", "t-");
  [
    "create_dir c/a/b -> " ++ shown_bool(made),
    "create_dir c/a/b again -> " ++ shown_bool(again),
    "write_file c/a/b/f.txt -> " ++ shown_bool(wrote),
    "read_file c/a/b/f.txt -> " ++ shown_opt_text(fs.read_file[scratch]("c/a/b/f.txt")),
    "read_file c/nope -> " ++ shown_opt_text(fs.read_file[scratch]("c/nope")),
    "file_size c/a/b/f.txt -> " ++ shown_opt_int(fs.file_size[scratch]("c/a/b/f.txt")),
    "exists c/a/b/f.txt -> " ++ shown_bool(fs.exists[scratch]("c/a/b/f.txt")),
    "exists c/nope -> " ++ shown_bool(fs.exists[scratch]("c/nope")),
    "kind c/a -> " ++ shown_kind(fs.kind[scratch]("c/a")),
    "kind c/a/b/f.txt -> " ++ shown_kind(fs.kind[scratch]("c/a/b/f.txt")),
    "kind c/nope -> " ++ shown_kind(fs.kind[scratch]("c/nope")),
    "append c/log ab -> " ++ shown_opt_int(first),
    "append c/log cd -> " ++ shown_opt_int(second),
    "read_at c/log 1 2 -> " ++ shown_opt_text(fs.read_at[scratch]("c/log", 1, 2)),
    "read_at c/log 3 5 -> " ++ shown_opt_text(fs.read_at[scratch]("c/log", 3, 5)),
    "read_at c/log 9 2 -> " ++ shown_opt_text(fs.read_at[scratch]("c/log", 9, 2)),
    "copy c/log c/log2 -> " ++ shown_bool(copied),
    "copy c/a c/a2 -> " ++ shown_bool(copied_dir),
    "rename c/log2 c/a/moved -> " ++ shown_bool(moved),
    "exists c/log2 -> " ++ shown_bool(fs.exists[scratch]("c/log2")),
    "read_file c/a/moved -> " ++ shown_opt_text(fs.read_file[scratch]("c/a/moved")),
    "rename c/x over c/y -> " ++ shown_bool(over),
    "read_file c/y -> " ++ shown_opt_text(fs.read_file[scratch]("c/y")),
    "symlink c/link a/b/f.txt -> " ++ shown_bool(linked),
    "kind c/link -> " ++ shown_kind(fs.kind[scratch]("c/link")),
    "resolved c/link -> " ++ shown_kind(fs.resolved[scratch]("c/link")),
    "read_link c/link -> " ++ shown_opt_string(fs.read_link[scratch]("c/link")),
    "read_link c/log -> " ++ shown_opt_string(fs.read_link[scratch]("c/log")),
    "read_file c/link -> " ++ shown_opt_text(fs.read_file[scratch]("c/link")),
    "set_mode c/a/b/f.txt rw------- -> " ++ shown_bool(moded),
    "mode c/a/b/f.txt -> " ++ shown_mode(fs.mode[scratch]("c/a/b/f.txt")),
    "set_modified c/a/b/f.txt -> " ++ shown_bool(stamped),
    "modified_ms c/a/b/f.txt -> " ++ shown_opt_int(fs.modified_ms[scratch]("c/a/b/f.txt")),
    "lock c/held.lock -> " ++ shown_bool(locked),
    "lock c/held.lock held -> " ++ shown_bool(contended),
    "unlock c/held.lock -> " ++ shown_bool(released),
    "unlock c/held.lock again -> " ++ shown_bool(unheld),
    "temp_dir c t- -> " ++ shown_temp(temp, "c", "t-"),
    // Removed before any listing: its name is the run's own.
    "remove_tree the temp dir -> "
      ++ shown_bool(match temp { Some(p) -> fs.remove_tree[scratch](p), None -> false }),
    "canonical c/a -> " ++ shown_canonical(fs.canonical[scratch]("c/a"), "/c/a"),
    "canonical c/nope -> " ++ shown_canonical(fs.canonical[scratch]("c/nope"), "/c/nope"),
    "sync c/log -> " ++ shown_bool(fs.sync[scratch]("c/log")),
    "sync c/nope -> " ++ shown_bool(fs.sync[scratch]("c/nope")),
    "list_dir c -> " ++ shown_names(fs.list_dir[scratch]("c")),
    "list_dir c/log -> " ++ shown_names(fs.list_dir[scratch]("c/log")),
    "list_dir c/nope -> " ++ shown_names(fs.list_dir[scratch]("c/nope")),
    "walk c/a -> " ++ shown_entries(fs.walk[scratch]("c/a")),
    "walk c/log -> " ++ shown_entries(fs.walk[scratch]("c/log")),
    "remove c/y -> " ++ shown_bool(fs.remove[scratch]("c/y")),
    "remove c/a -> " ++ shown_bool(fs.remove[scratch]("c/a")),
    "remove c/nope -> " ++ shown_bool(fs.remove[scratch]("c/nope")),
    "remove_tree c -> " ++ shown_bool(fs.remove_tree[scratch]("c")),
    "exists c -> " ++ shown_bool(fs.exists[scratch]("c")),
  ]
}

/// The first line where a script's lines on the disk and over the twin differ, shown both ways, or
/// `None` where they are the same.
pub fn first_difference(disk: List<String>, twin: List<String>) -> Option<String> =
  range(0, max(disk.len(), twin.len())).fold(None, |found: Option<String>, i: Int|
    match found {
      Some(_) -> found,
      None -> {
        let d = match disk.at(i) { Some(l) -> l, None -> "(nothing)" };
        let t = match twin.at(i) { Some(l) -> l, None -> "(nothing)" };
        if d == t { None } else { Some("the disk answered\n  " ++ d ++ "\nand the twin\n  " ++ t) }
      },
    })

test/nondet "the filesystem's twin answers every operation as the disk does" {
  scratch::fresh();
  let disk = script();
  let twin = fs::on_mem(fs::mem_empty(), || script()).value;
  match first_difference(disk, twin) { Some(why) -> panic(why), None -> () }
}

/// The host's own error number is the platform's, so only that there is one is compared.
fn shown_refused(why: fs::Refused) -> String =
  match why {
    fs::NotFound -> "not found",
    fs::Denied -> "denied",
    fs::NotAFile -> "not a file",
    fs::NotADirectory -> "not a directory",
    fs::Exists -> "exists",
    fs::NoSpace -> "no space",
    fs::CrossesRoot -> "crosses root",
    fs::TooMuch -> "too much",
    fs::Other(code, text) -> if code == 0 { "failed " ++ text } else { "the host's own" },
  }

/// A descriptor is the run's own number, so only whether there is one is compared.
fn shown_opened(o: Result<Int, fs::Refused>) -> String =
  match o { Ok(_) -> "open", Err(why) -> shown_refused(why) }

fn through<| e>(o: Result<Int, fs::Refused>, f: (Int) -> String / e) -> String / e =
  match o { Ok(file) -> f(file), Err(_) -> "no descriptor" }

/// The operations on an open file, under `s/`.
fn streamed() -> List<String> / {fs.read[scratch], fs.write[scratch]} = {
  let made = fs.create_dir[scratch]("s");
  let out = fs.open[scratch]("s/f", fs::ToWrite);
  let wrote = through(out, |d: Int|
    shown_bool(fs.write_chunk[scratch](d, b"hello ") && fs.write_chunk[scratch](d, b"world")));
  let unread = through(out, |d: Int| shown_opt_text(fs.read_chunk[scratch](d, 4)));
  let closed = through(out, |d: Int| shown_bool(fs.close[scratch](d)));
  let again = through(out, |d: Int| shown_bool(fs.close[scratch](d)));
  let late = through(out, |d: Int| shown_bool(fs.write_chunk[scratch](d, b"!")));
  let more = fs.open[scratch]("s/f", fs::ToAppend);
  let appended = through(more, |d: Int|
    shown_bool(fs.write_chunk[scratch](d, b"!") && fs.close[scratch](d)));
  let source = fs.open[scratch]("s/f", fs::ToRead);
  let chunks = through(source, |d: Int|
    shown_opt_text(fs.read_chunk[scratch](d, 5)) ++ " "
      ++ shown_opt_text(fs.read_chunk[scratch](d, 100))
      ++ " "
      ++ shown_opt_text(fs.read_chunk[scratch](d, 100))
      ++ " "
      ++ shown_opt_text(fs.read_chunk[scratch](d, 0)));
  let unwritten = through(source, |d: Int| shown_bool(fs.write_chunk[scratch](d, b"x")));
  let shut = through(source, |d: Int| shown_bool(fs.close[scratch](d)));
  let after = through(source, |d: Int| shown_opt_text(fs.read_chunk[scratch](d, 1)));
  [
    "create_dir s -> " ++ shown_bool(made),
    "open s/f to write -> " ++ shown_opened(out),
    "write_chunk twice -> " ++ wrote,
    "read_chunk of a file open to write -> " ++ unread,
    "close -> " ++ closed,
    "close again -> " ++ again,
    "write_chunk after close -> " ++ late,
    "open s/f to append -> " ++ shown_opened(more),
    "write_chunk and close -> " ++ appended,
    "open s/f to read -> " ++ shown_opened(source),
    "read_chunk 5, 100, 100, 0 -> " ++ chunks,
    "write_chunk of a file open to read -> " ++ unwritten,
    "close -> " ++ shut,
    "read_chunk after close -> " ++ after,
    "open s/nope to read -> " ++ shown_opened(fs.open[scratch]("s/nope", fs::ToRead)),
    "open s to read -> " ++ shown_opened(fs.open[scratch]("s", fs::ToRead)),
    "open s to write -> " ++ shown_opened(fs.open[scratch]("s", fs::ToWrite)),
    "open s/no/f to write -> " ++ shown_opened(fs.open[scratch]("s/no/f", fs::ToWrite)),
    "read_file s/f -> " ++ shown_opt_text(fs.read_file[scratch]("s/f")),
    "remove_tree s -> " ++ shown_bool(fs.remove_tree[scratch]("s")),
  ]
}

test/nondet "the twin answers every operation on an open file as the disk does" {
  scratch::fresh();
  let disk = streamed();
  let twin = fs::on_mem(fs::mem_empty(), || streamed()).value;
  match first_difference(disk, twin) { Some(why) -> panic(why), None -> () }
}

fn mebibyte() -> Int = 1048576

/// One read answers at most 64 MiB (`E0453`), so this file is a mebibyte past what `read_file`
/// would answer: written and read back through a descriptor, a chunk at a time.
fn over_the_bound() -> List<String> / {fs.read[scratch], fs.write[scratch], abort.raise} = {
  let block = range(0, 16).fold(b"0123456789abcdef", |b: Bytes, i: Int| b.concat(b));
  let blocks = 65;
  let out = fs.open[scratch]("large", fs::ToWrite);
  let wrote = through(out, |d: Int|
    shown_bool(
      range(0, blocks).fold(true, |ok: Bool, i: Int| ok && fs.write_chunk[scratch](d, block))
        && fs.close[scratch](d),
    ));
  let size = fs.file_size[scratch]("large");
  let source = fs.open[scratch]("large", fs::ToRead);
  let read = through(source, |d: Int| {
    let total = iterate({ bytes: 0, chunks: 0 }, blocks + 2, |s: { bytes: Int, chunks: Int }|
      match fs.read_chunk[scratch](d, 8 * mebibyte()) {
        Some(chunk) -> if chunk.len() == 0 { Stop(s) }
        else { Continue({ bytes: s.bytes + chunk.len(), chunks: s.chunks + 1 }) },
        None -> Stop(s),
      });
    let closed = fs.close[scratch](d);
    total.bytes.to_string() ++ " bytes in " ++ total.chunks.to_string() ++ " chunks, closed "
      ++ shown_bool(closed)
  });
  assert(size == Some(blocks * mebibyte()) && blocks * mebibyte() > 64 * mebibyte());
  [
    "write 65 MiB -> " ++ wrote,
    "file_size large -> " ++ shown_opt_int(size),
    "read in 8 MiB chunks -> " ++ read,
    "remove large -> " ++ shown_bool(fs.remove[scratch]("large")),
  ]
}

test/nondet "a file over the bound of one read is read in chunks, on the disk and over the twin" {
  scratch::fresh();
  let disk = over_the_bound();
  let twin = fs::on_mem(fs::mem_empty(), || over_the_bound()).value;
  assert_eq(disk.at(2), Some("read in 8 MiB chunks -> 68157440 bytes in 9 chunks, closed true"));
  match first_difference(disk, twin) { Some(why) -> panic(why), None -> () }
}

// --- Looks, second names, exclusive creates and room --------------------------------

/// A fresh mode is the umask's on a disk, so a mode is compared only where a script set it.
fn shown_stat(found: Option<fs::Stat>) -> String =
  match found {
    Some(s) -> shown_kind(s.kind) ++ "," ++ s.size.to_string() ++ ",x" ++ s.links.to_string(),
    None -> "none",
  }

fn shown_seen(seen: Option<List<Seen>>) -> String =
  match seen {
    Some(entries) ->
      entries.fold("", |acc: String, s: Seen|
        acc ++ (if acc == "" { "" } else { " " }) ++ s.path ++ "=" ++ shown_stat(Some(s.stat))),
    None -> "none",
  }

fn shown_linked(made: Result<Unit, fs::Refused>) -> String =
  match made { Ok(_) -> "linked", Err(why) -> shown_refused(why) }

/// A file's id is its file system's own number, so only whether two paths share one is compared.
fn one_file(a: String, b: String) -> String / {fs.stat[scratch]} =
  match fs.stat[scratch](a) {
    Some(x) -> match fs.stat[scratch](b) {
      Some(y) -> shown_bool(x.device == y.device && x.id == y.id),
      None -> "none",
    },
    None -> "none",
  }

fn shown_nanos(found: Option<fs::Stat>) -> String =
  match found { Some(s) -> nanos_at(s.modified).to_string(), None -> "none" }

/// Only that a file system has room is the same on a disk and in a twin.
fn shown_space(room: Option<fs::Space>) -> String =
  match room {
    Some(r) -> shown_bool(r.total > 0 && r.available <= r.free && r.free <= r.total),
    None -> "none",
  }

/// Under `n/`.
fn named() -> List<String> / {fs.read[scratch], fs.write[scratch]} = {
  let made = fs.create_dir[scratch]("n/d");
  let wrote = fs.write_file[scratch]("n/d/a.txt", b"one");
  let pointed = fs.symlink[scratch]("n/l", "d/a.txt");
  let twin = fs.link[scratch]("n/twin", "n/d/a.txt");
  let both = fs.write_file[scratch]("n/twin", b"both");
  let closed = fs.set_mode[scratch]("n/d/a.txt", owner_only());
  let stamped = fs.set_modified[scratch]("n/twin", 1700000000123);
  let created = fs.open[scratch]("n/new", fs::ToCreate);
  let filled = through(created, |d: Int|
    shown_bool(fs.write_chunk[scratch](d, b"mine") && fs.close[scratch](d)));
  [
    "create_dir n/d -> " ++ shown_bool(made),
    "write_file n/d/a.txt -> " ++ shown_bool(wrote),
    "symlink n/l -> " ++ shown_bool(pointed),
    "link n/twin n/d/a.txt -> " ++ shown_linked(twin),
    "write_file n/twin -> " ++ shown_bool(both),
    "read_file n/d/a.txt -> " ++ shown_opt_text(fs.read_file[scratch]("n/d/a.txt")),
    "set_mode n/d/a.txt -> " ++ shown_bool(closed),
    "mode n/twin -> " ++ shown_mode(fs.mode[scratch]("n/twin")),
    "set_modified n/twin -> " ++ shown_bool(stamped),
    "modified_ms n/d/a.txt -> " ++ shown_opt_int(fs.modified_ms[scratch]("n/d/a.txt")),
    "stat n/d/a.txt -> " ++ shown_stat(fs.stat[scratch]("n/d/a.txt")),
    "stat n/d/a.txt modified -> " ++ shown_nanos(fs.stat[scratch]("n/d/a.txt")),
    "stat n/twin -> " ++ shown_stat(fs.stat[scratch]("n/twin")),
    "stat n/d -> " ++ shown_stat(fs.stat[scratch]("n/d")),
    "stat n/l -> " ++ shown_stat(fs.stat[scratch]("n/l")),
    "stat n/l mode -> "
      ++ shown_mode(match fs.stat[scratch]("n/l") { Some(s) -> Some(s.mode), None -> None }),
    "stat n/absent -> " ++ shown_stat(fs.stat[scratch]("n/absent")),
    "stat n/d/a.txt/under -> " ++ shown_stat(fs.stat[scratch]("n/d/a.txt/under")),
    "one file n/twin n/d/a.txt -> " ++ one_file("n/twin", "n/d/a.txt"),
    "one file n/l n/d/a.txt -> " ++ one_file("n/l", "n/d/a.txt"),
    "link n/x n/absent -> " ++ shown_linked(fs.link[scratch]("n/x", "n/absent")),
    "link n/x n/d -> " ++ shown_linked(fs.link[scratch]("n/x", "n/d")),
    "link n/x n/l -> " ++ shown_linked(fs.link[scratch]("n/x", "n/l")),
    "link n/l n/d/a.txt -> " ++ shown_linked(fs.link[scratch]("n/l", "n/d/a.txt")),
    "link n/twin n/d/a.txt -> " ++ shown_linked(fs.link[scratch]("n/twin", "n/d/a.txt")),
    "link n/no/x n/d/a.txt -> " ++ shown_linked(fs.link[scratch]("n/no/x", "n/d/a.txt")),
    "link n/d/a.txt/x n/d/a.txt -> " ++ shown_linked(fs.link[scratch]("n/d/a.txt/x", "n/d/a.txt")),
    "exists n/x -> " ++ shown_bool(fs.exists[scratch]("n/x")),
    "copy n/twin onto n/d/a.txt -> " ++ shown_bool(fs.copy[scratch]("n/twin", "n/d/a.txt")),
    "copy n/d/a.txt onto itself -> " ++ shown_bool(fs.copy[scratch]("n/d/a.txt", "n/d/a.txt")),
    "read_file n/d/a.txt -> " ++ shown_opt_text(fs.read_file[scratch]("n/d/a.txt")),
    "rename n/twin onto n/d/a.txt -> " ++ shown_bool(fs.rename[scratch]("n/twin", "n/d/a.txt")),
    "exists n/twin -> " ++ shown_bool(fs.exists[scratch]("n/twin")),
    "rename n/twin n/moved -> " ++ shown_bool(fs.rename[scratch]("n/twin", "n/moved")),
    "modified_ms n/moved -> " ++ shown_opt_int(fs.modified_ms[scratch]("n/moved")),
    "remove n/d/a.txt -> " ++ shown_bool(fs.remove[scratch]("n/d/a.txt")),
    "stat n/moved -> " ++ shown_stat(fs.stat[scratch]("n/moved")),
    "read_file n/moved -> " ++ shown_opt_text(fs.read_file[scratch]("n/moved")),
    "open n/new to create -> " ++ shown_opened(created),
    "write_chunk and close -> " ++ filled,
    "mode n/new -> " ++ shown_mode(fs.mode[scratch]("n/new")),
    "open n/new to create again -> " ++ shown_opened(fs.open[scratch]("n/new", fs::ToCreate)),
    "open n/d to create -> " ++ shown_opened(fs.open[scratch]("n/d", fs::ToCreate)),
    "open n/l to create -> " ++ shown_opened(fs.open[scratch]("n/l", fs::ToCreate)),
    "exists n/d/a.txt -> " ++ shown_bool(fs.exists[scratch]("n/d/a.txt")),
    "open n/no/new to create -> " ++ shown_opened(fs.open[scratch]("n/no/new", fs::ToCreate)),
    "open n/moved/new to create -> " ++ shown_opened(fs.open[scratch]("n/moved/new", fs::ToCreate)),
    "open n/moved/new to write -> " ++ shown_opened(fs.open[scratch]("n/moved/new", fs::ToWrite)),
    "scan n deep -> " ++ shown_seen(fs.scan[scratch]("n", true)),
    "scan n -> " ++ shown_seen(fs.scan[scratch]("./n/", false)),
    "scan n/moved -> " ++ shown_seen(fs.scan[scratch]("n/moved", true)),
    "scan n/absent -> " ++ shown_seen(fs.scan[scratch]("n/absent", false)),
    "space n -> " ++ shown_space(fs.space[scratch]("n")),
    "space n/moved -> " ++ shown_space(fs.space[scratch]("n/moved")),
    "space n/absent -> " ++ shown_space(fs.space[scratch]("n/absent")),
    "remove_tree n -> " ++ shown_bool(fs.remove_tree[scratch]("n")),
  ]
}

test/nondet "the twin looks at a path, names a file twice and makes one exclusively as the disk does" {
  scratch::fresh();
  let disk = named();
  let twin = fs::on_mem(fs::mem_empty(), || named()).value;
  assert_eq(disk.at(10), Some("stat n/d/a.txt -> file,4,x2"));
  assert_eq(disk.at(11), Some("stat n/d/a.txt modified -> 1700000000123000000"));
  assert_eq(disk.at(30), Some("read_file n/d/a.txt -> \"both\""));
  assert_eq(disk.at(34), Some("modified_ms n/moved -> 1700000000123"));
  match first_difference(disk, twin) { Some(why) -> panic(why), None -> () }
}

// --- Atomic writes ---------------------------------------------------------------

fn bits(n: Int) -> fs::Mode = fs::mode_of_bits(n)

/// What an atomic write of `path` came to: `written`, or where it stopped and why. A temporary
/// file's name is the run's own, so a refusal there is told by its directory.
fn atomically(
  path: String,
  body: Bytes,
  durability: fs::Durability,
  mode: Option<fs::Mode>,
) -> String / {fs.read[scratch], fs.write[scratch], entropy.next, abort.raise} = {
  let wrote: Result<Unit, (String, fs::Refused)> = try[files.refused] {
    fs::write_atomic[scratch](path, body, durability, mode)
  };
  match wrote {
    Ok(_) -> "written",
    Err((at, why)) ->
      (if at.contains(".tmp-") { "beside " ++ path } else { "at " ++ at }) ++ ": "
        ++ shown_refused(why),
  }
}

/// A file replaced through a sink in two chunks, where `fail` raises between them.
fn replaced(
  path: String,
  fail: Bool,
) -> String / {fs.read[scratch], fs.write[scratch], files.refused, entropy.next, abort.raise} = {
  let wrote: Result<Unit, Int> = try[io.too_long] {
    io::replacing[scratch](path, fs::Durable, None, |sink: Sink<| {fs.write_chunk[scratch]}>| {
      let first = (sink.push)(b"str");
      if fail { io.too_long(3) } else { () };
      if first && (sink.push)(b"eamed") { () } else { panic("the sink took nothing") }
    })
  };
  match wrote { Ok(_) -> "replaced", Err(n) -> "raised after " ++ n.to_string() }
}

/// Under `w/`.
fn atomic() -> List<String> / {fs.read[scratch], fs.write[scratch], files.refused, entropy.next, abort.raise} = {
  let made = fs.create_dir[scratch]("w/dir");
  let old = fs.write_file[scratch]("w/cfg", b"old") && fs.set_mode[scratch]("w/cfg", bits(416));
  let pointed = fs.symlink[scratch]("w/link", "cfg");
  [
    "create_dir w/dir -> " ++ shown_bool(made),
    "write_file and set_mode w/cfg rw-r----- -> " ++ shown_bool(old),
    "symlink w/link cfg -> " ++ shown_bool(pointed),
    "write_atomic w/cfg durable -> " ++ atomically("w/cfg", b"new", fs::Durable, None),
    "read_file w/cfg -> " ++ shown_opt_text(fs.read_file[scratch]("w/cfg")),
    "mode w/cfg -> " ++ shown_mode(fs.mode[scratch]("w/cfg")),
    "write_atomic w/fresh fast -> " ++ atomically("w/fresh", b"f", fs::Fast, None),
    "mode w/fresh -> " ++ shown_mode(fs.mode[scratch]("w/fresh")),
    "write_atomic w/tool rwx------ -> " ++ atomically("w/tool", b"t", fs::Fast, Some(bits(448))),
    "mode w/tool -> " ++ shown_mode(fs.mode[scratch]("w/tool")),
    "write_atomic w/link -> " ++ atomically("w/link", b"direct", fs::Durable, None),
    "kind w/link -> " ++ shown_kind(fs.kind[scratch]("w/link")),
    "read_file w/link -> " ++ shown_opt_text(fs.read_file[scratch]("w/link")),
    "read_file w/cfg -> " ++ shown_opt_text(fs.read_file[scratch]("w/cfg")),
    "write_atomic w/no/cfg -> " ++ atomically("w/no/cfg", b"x", fs::Durable, None),
    "write_atomic w/cfg/under -> " ++ atomically("w/cfg/under", b"x", fs::Durable, None),
    "write_atomic w/dir -> " ++ atomically("w/dir", b"x", fs::Durable, None),
    "kind w/dir -> " ++ shown_kind(fs.kind[scratch]("w/dir")),
    "replacing w/cfg -> " ++ replaced("w/cfg", false),
    "read_file w/cfg -> " ++ shown_opt_text(fs.read_file[scratch]("w/cfg")),
    "mode w/cfg -> " ++ shown_mode(fs.mode[scratch]("w/cfg")),
    "replacing w/cfg, raising -> " ++ replaced("w/cfg", true),
    "read_file w/cfg -> " ++ shown_opt_text(fs.read_file[scratch]("w/cfg")),
    "list_dir w -> " ++ shown_names(fs.list_dir[scratch]("w")),
    "remove_tree w -> " ++ shown_bool(fs.remove_tree[scratch]("w")),
  ]
}

test/nondet "the twin writes a file whole or not at all as the disk does, and neither leaves a temporary" {
  scratch::fresh();
  let disk = atomic();
  let twin = fs::on_mem(fs::mem_empty(), || atomic()).value;
  assert_eq(disk.at(23), Some("list_dir w -> [cfg dir fresh link tool]"));
  match first_difference(disk, twin) { Some(why) -> panic(why), None -> () }
}

// --- Copies of trees ---------------------------------------------------------------

/// Every entry under `dir` a line apart: what a look reads of it, a link's target, a file's bytes,
/// and the mode and the milliseconds a script set on a file or a directory.
fn shown_tree(dir: String) -> String / {fs.read[scratch]} =
  match fs.scan[scratch](dir, true) {
    None -> "none",
    Some(entries) ->
      entries.fold("", |acc: String, s: Seen|
        acc ++ "\n    " ++ s.path ++ "=" ++ shown_stat(Some(s.stat))
          ++ (match s.stat.kind {
            fs::Symlink -> " to " ++ shown_opt_string(fs.read_link[scratch](s.path)),
            fs::File ->
              " " ++ shown_opt_text(fs.read_file[scratch](s.path)) ++ " "
                ++ fs::mode_text(s.stat.mode)
                ++ " at "
                ++ Int::to_string(nanos_at(s.stat.modified) / 1000000),
            _ ->
              " " ++ fs::mode_text(s.stat.mode) ++ " at "
                ++ Int::to_string(nanos_at(s.stat.modified) / 1000000),
          })),
  }

/// A tree at `top` with a mode and a time set on every file and directory in it: a file of each
/// mode, a directory in a directory and an empty one, a link, and a file with two names.
fn planted(top: String) -> Bool / {fs.write[scratch]} = {
  let at = |rest: String| top ++ "/" ++ rest;
  let made = fs.create_dir[scratch](at("sub")) && fs.create_dir[scratch](at("empty"))
    && fs.write_file[scratch](at("a.txt"), b"alpha")
    && fs.write_file[scratch](at("sub/b.sh"), b"#!/bin/sh\n")
    && fs.symlink[scratch](at("l"), "sub/b.sh");
  let twin = fs.link[scratch](at("sub/twin.txt"), at("a.txt"));
  let moded = fs.set_mode[scratch](at("a.txt"), bits(416))
    && fs.set_mode[scratch](at("sub/b.sh"), bits(488))
    && fs.set_mode[scratch](at("sub"), bits(493))
    && fs.set_mode[scratch](at("empty"), bits(448))
    && fs.set_mode[scratch](top, bits(493));
  let dated = fs.set_modified[scratch](at("a.txt"), 1600000000000)
    && fs.set_modified[scratch](at("sub/b.sh"), 1600000001000)
    && fs.set_modified[scratch](at("sub"), 1600000002000)
    && fs.set_modified[scratch](at("empty"), 1600000003000)
    && fs.set_modified[scratch](top, 1600000004000);
  made && twin == Ok(()) && moded && dated
}

fn copying(existing: fs::Existing, outside: fs::Outside) -> fs::Copying =
  { existing: existing, outside: outside, entries: 100, bytes: 100000 }

fn shown_copied(copied: Result<fs::Copied<Int>, (String, fs::Refused)>) -> String =
  match copied {
    Ok(c) ->
      c.entries.to_string() ++ " entries, " ++ c.bytes.to_string() ++ " bytes, told "
        ++ c.value.to_string()
        ++ ", skipped "
        ++ shown_names(Some(c.skipped))
        ++ (if c.stopped { ", stopped" } else { "" }),
    Err((at, why)) -> "at " ++ at ++ ": " ++ shown_refused(why),
  }

fn copy_within(
  from: String,
  to: String,
  how: fs::Copying,
) -> String / {fs.read[scratch], fs.write[scratch], abort.raise} = {
  let copied: Result<fs::Copied<Int>, (String, fs::Refused)> = try[files.refused] {
    fs::copy_tree[scratch](from, to, how, 0, |n: Int, _told: fs::Progress| Continue(n + 1))
  };
  shown_copied(copied)
}

fn copy_across(
  from: String,
  to: String,
  how: fs::Copying,
) -> String / {fs.read[scratch], fs.write[scratch], abort.raise} = {
  let copied: Result<fs::Copied<Int>, (String, fs::Refused)> = try[files.refused] {
    fs::copy_tree_across[scratch, scratch](from, to, how, 0, |n: Int, told: fs::Progress|
      if told.path == to ++ "/l" { Stop(n + 1) } else { Continue(n + 1) })
  };
  shown_copied(copied)
}

/// Under `t/`.
fn copied() -> List<String> / {fs.read[scratch], fs.write[scratch], abort.raise} = {
  let grown = planted("t/src");
  let stood = fs.create_dir[scratch]("t/merged/sub")
    && fs.write_file[scratch]("t/merged/a.txt", b"old")
    && fs.write_file[scratch]("t/merged/kept.txt", b"kept")
    && fs.set_mode[scratch]("t/merged/kept.txt", bits(420))
    && fs.set_modified[scratch]("t/merged/kept.txt", 1500000000000)
    && fs.symlink[scratch]("t/merged/empty", "kept.txt");
  let tight = copying(fs::Refuse, fs::RefuseLink);
  let climbing = fs.create_dir[scratch]("t/up") && fs.write_file[scratch]("t/up/f", b"f")
    && fs.symlink[scratch]("t/up/out", "../../t");
  [
    "a tree is planted -> " ++ shown_bool(grown),
    "the tree -> " ++ shown_tree("t/src"),
    "copy_tree t/src t/out -> "
      ++ copy_within("t/src", "t/out", copying(fs::Refuse, fs::RefuseLink)),
    "the copy -> " ++ shown_tree("t/out"),
    "one file t/out/a.txt t/out/sub/twin.txt -> " ++ one_file("t/out/a.txt", "t/out/sub/twin.txt"),
    "one file t/out/a.txt t/src/a.txt -> " ++ one_file("t/out/a.txt", "t/src/a.txt"),
    "mode t/out -> " ++ shown_mode(fs.mode[scratch]("t/out")),
    "modified_ms t/out -> " ++ shown_opt_int(fs.modified_ms[scratch]("t/out")),
    "copy_tree again, refusing -> "
      ++ copy_within("t/src", "t/out", copying(fs::Refuse, fs::RefuseLink)),
    "something stands at t/merged -> " ++ shown_bool(stood),
    "copy_tree, merging -> "
      ++ copy_within("t/src", "t/merged", copying(fs::Merge, fs::RefuseLink)),
    "the merged -> " ++ shown_tree("t/merged"),
    "copy_tree, replacing -> "
      ++ copy_within("t/src", "t/merged", copying(fs::Replace, fs::RefuseLink)),
    "list_dir t/merged -> " ++ shown_names(fs.list_dir[scratch]("t/merged")),
    "copy_tree a file over a directory, merging -> "
      ++ copy_within("t/src/a.txt", "t/merged/sub", copying(fs::Merge, fs::RefuseLink)),
    "copy_tree of nothing -> "
      ++ copy_within("t/absent", "t/nowhere", copying(fs::Refuse, fs::RefuseLink)),
    "copy_tree past its bound -> " ++ copy_within("t/src", "t/nowhere", { ..tight, bytes: 19 }),
    "exists t/nowhere -> " ++ shown_bool(fs.exists[scratch]("t/nowhere")),
    "a link climbs -> " ++ shown_bool(climbing),
    "copy_tree t/up to the root, refusing the link -> "
      ++ copy_within("t/up", "", copying(fs::Merge, fs::RefuseLink)),
    "copy_tree t/up to the root, skipping the link -> "
      ++ copy_within("t/up", "", copying(fs::Merge, fs::SkipLink)),
    "read_file f -> " ++ shown_opt_text(fs.read_file[scratch]("f")),
    "exists out -> " ++ shown_bool(fs.exists[scratch]("out")),
    "remove f -> " ++ shown_bool(fs.remove[scratch]("f")),
    "copy_tree_across, stopping at the link -> "
      ++ copy_across("t/src", "t/over", copying(fs::Refuse, fs::RefuseLink)),
    "the copy across -> " ++ shown_tree("t/over"),
    "remove_tree t -> " ++ shown_bool(fs.remove_tree[scratch]("t")),
  ]
}

test/nondet "the twin copies a tree, its modes, times and links, as the disk does" {
  scratch::fresh();
  let disk = copied();
  let twin = fs::on_mem(fs::mem_empty(), || copied()).value;
  assert_eq(disk.at(2), Some("copy_tree t/src t/out -> 7 entries, 20 bytes, told 7, skipped []"));
  match first_difference(disk, twin) { Some(why) -> panic(why), None -> () }
}

// --- Watches ---------------------------------------------------------------------

fn shown_changes(changes: List<fs::Change>) -> String =
  "["
    ++ changes.fold("", |acc: String, c: fs::Change|
      acc ++ (if acc == "" { "" } else { ", " })
        ++ (match c {
          fs::Created(p) -> "created " ++ p,
          fs::Modified(p) -> "modified " ++ p,
          fs::Removed(p) -> "removed " ++ p,
          fs::Renamed(from, to) -> "renamed " ++ from ++ " to " ++ to,
          fs::Rescan -> "rescan",
        }))
    ++ "]"

/// Under `v/`. Each change either moves a file's size or stamps a time on it, so a disk whose
/// clock is coarse tells it as a twin does.
fn watched() -> List<String> / {fs.read[scratch], fs.write[scratch], time.sleep_ms, abort.raise} = {
  let made = fs.create_dir[scratch]("v/d") && fs.write_file[scratch]("v/d/a.txt", b"a")
    && fs.set_modified[scratch]("v/d/a.txt", 1600000000000);
  let begun = fs::watch[scratch]("v/d", true, 10);
  let quiet = fs::poll[scratch](begun);
  let wrote = fs.write_file[scratch]("v/d/n.txt", b"n")
    && fs.write_file[scratch]("v/elsewhere", b"e");
  let first = fs::poll[scratch](quiet.watch);
  let grew = fs.write_file[scratch]("v/d/a.txt", b"aa");
  let second = fs::poll[scratch](first.watch);
  let stamped = fs.set_modified[scratch]("v/d/a.txt", 1600000001000);
  let third = fs::poll[scratch](second.watch);
  let renamed = fs.rename[scratch]("v/d/n.txt", "v/d/m.txt");
  let fourth = fs::poll[scratch](third.watch);
  let nested = fs.create_dir[scratch]("v/d/sub") && fs.write_file[scratch]("v/d/sub/x", b"x");
  let fifth = fs::poll[scratch](fourth.watch);
  let moved = fs.rename[scratch]("v/d/sub", "v/d/bus");
  let sixth = fs::poll[scratch](fifth.watch);
  let saved = fs.write_file[scratch]("v/d/m.tmp", b"saved")
    && fs.rename[scratch]("v/d/m.tmp", "v/d/m.txt");
  let seventh = fs::poll[scratch](sixth.watch);
  let closed = fs.set_mode[scratch]("v/d/bus", bits(457)) && fs.remove[scratch]("v/d/a.txt");
  let eighth = fs::poll[scratch](seventh.watch);
  let still = fs::await_changes[scratch](eighth.watch, millis(2), 3);
  let narrow = fs::watch[scratch]("v/d", false, 1);
  let flooded = fs.write_file[scratch]("v/d/one", b"1") && fs.write_file[scratch]("v/d/two", b"2");
  let ninth = fs::poll[scratch](narrow);
  let gone = fs.remove_tree[scratch]("v/d");
  let tenth = fs::poll[scratch](ninth.watch);
  let eleventh = fs::poll[scratch](tenth.watch);
  let back = fs.create_dir[scratch]("v/d");
  let twelfth = fs::poll[scratch](eleventh.watch);
  [
    "a directory to watch -> " ++ shown_bool(made),
    "poll, nothing changed -> " ++ shown_changes(quiet.changes),
    "a file is made, and one elsewhere -> " ++ shown_bool(wrote),
    "poll -> " ++ shown_changes(first.changes),
    "a file grows -> " ++ shown_bool(grew),
    "poll -> " ++ shown_changes(second.changes),
    "a file is stamped -> " ++ shown_bool(stamped),
    "poll -> " ++ shown_changes(third.changes),
    "a file is renamed -> " ++ shown_bool(renamed),
    "poll -> " ++ shown_changes(fourth.changes),
    "a directory is made with a file in it -> " ++ shown_bool(nested),
    "poll -> " ++ shown_changes(fifth.changes),
    "the directory is renamed -> " ++ shown_bool(moved),
    "poll -> " ++ shown_changes(sixth.changes),
    "a file is saved by renaming another over it -> " ++ shown_bool(saved),
    "poll -> " ++ shown_changes(seventh.changes),
    "a directory's mode is set and a file removed -> " ++ shown_bool(closed),
    "poll -> " ++ shown_changes(eighth.changes),
    "await_changes, nothing changing -> " ++ shown_changes(still.changes),
    "two files are made under a watch that lists one change -> " ++ shown_bool(flooded),
    "poll -> " ++ shown_changes(ninth.changes),
    "the directory is removed -> " ++ shown_bool(gone),
    "poll -> " ++ shown_changes(tenth.changes),
    "poll again -> " ++ shown_changes(eleventh.changes),
    "the directory is made again -> " ++ shown_bool(back),
    "poll -> " ++ shown_changes(twelfth.changes),
    "remove_tree v -> " ++ shown_bool(fs.remove_tree[scratch]("v")),
  ]
}

test/nondet "a watch over the twin tells what a watch over the disk tells" {
  scratch::fresh();
  let disk = watched();
  let twin = fs::on_mem(fs::mem_empty(), || watched()).value;
  assert_eq(disk.at(13), Some("poll -> [renamed v/d/sub to v/d/bus]"));
  assert_eq(disk.at(15), Some("poll -> [modified v/d/m.txt]"));
  match first_difference(disk, twin) { Some(why) -> panic(why), None -> () }
}

// --- Archives ---------------------------------------------------------------------

fn limits() -> tar::Limits = { entries: 1000, total: 1000000, size: 1000000, path: 4096 }

fn shown_outcome(o: tar::Outcome) -> String =
  match o {
    tar::Extracted -> "extracted",
    tar::Barred(tar::ThroughLink) -> "barred through a link",
    tar::Barred(tar::Replaces) -> "barred from replacing",
    tar::Barred(tar::LinkMissing) -> "barred, no file to name",
    tar::Barred(_) -> "barred",
    tar::Failed(why) -> shown_refused(why),
  }

fn shown_carried(carried: List<tar::Carried>) -> String =
  carried.fold("", |acc: String, c: tar::Carried|
    acc ++ (if acc == "" { "" } else { ", " }) ++ c.path ++ " " ++ shown_outcome(c.outcome))

fn packed(
  dir: String,
  to: String,
  how: tar::Packing,
) -> String / {fs.read[scratch], fs.write[scratch], io.closed, io.unwritten, files.refused, tar.unwritable, abort.raise} = {
  let refused: Result<tar::Packed, (String, fs::Refused)> = try[io.refused] {
    with_hold[out](
      io::writing[scratch](to),
      io::shut_sink,
    ) { sink -> tar::pack[scratch](dir, [""], sink, how) }
  };
  match refused {
    Ok(p) -> p.entries.to_string() ++ " entries in " ++ p.bytes.to_string() ++ " bytes",
    Err((at, why)) -> "at " ++ at ++ ": " ++ shown_refused(why),
  }
}

/// What unpacking the archive at `from` into `into`, which it makes first, came to.
fn unpacked(
  from: String,
  into: String,
) -> String / {fs.read[scratch], fs.write[scratch], io.refused, io.closed, abort.raise} = {
  let made = fs.create_dir[scratch](into);
  let refused: Result<Result<List<tar::Carried>, tar::Unsafe>, tar::Refusal> = try[tar.refused] {
    let unsafe: Result<List<tar::Carried>, tar::Unsafe> = try[tar.unsafe] {
      tar::unpack[scratch, scratch](from, into, limits(), 4096)
    };
    unsafe
  };
  if !made { "no directory to unpack into" } else {
    match refused {
      Ok(Ok(carried)) -> shown_carried(carried),
      Ok(Err(e)) -> "entry " ++ e.index.to_string() ++ " (" ++ e.path ++ ") may not be extracted",
      Err(e) -> "no archive at byte " ++ e.at.to_string(),
    }
  }
}

fn archive_of(entries: List<tar::Entry>) -> Bytes / {abort.raise} =
  match tar::encode(entries) { Ok(bytes) -> bytes, Err(_) -> panic("the entries have headers") }

/// Under `x/`.
fn archived() -> List<String> / {fs.read[scratch], fs.write[scratch], io.refused, io.closed, io.unwritten, files.refused, tar.unwritable, abort.raise} = {
  let grown = planted("x/src");
  let absent: Result<String, (String, fs::Refused)> = try[io.refused] {
    unpacked("x/absent.tar", "x/nowhere")
  };
  let plain: tar::Packing = { times: false, modes: false, entries: 100, bytes: 100000, chunk: 7 };
  let kept: tar::Packing = { times: true, modes: true, entries: 100, bytes: 100000, chunk: 4096 };
  let climbs = fs.write_file[scratch](
    "x/climbs.tar",
    archive_of([tar::file("ok", b"1"), tar::file("../escaped", b"x")]),
  );
  let through = fs.write_file[scratch](
    "x/through.tar",
    archive_of([tar::file("ok", b"1"), tar::symlink("l", "../../outside"), tar::file("l/f", b"x")]),
  );
  let cut = fs.write_file[scratch](
    "x/cut.tar",
    archive_of([tar::file("ok", b"1"), tar::file("late", b"22")]).slice(0, 1100),
  );
  let swapped = fs.create_dir[scratch]("x/swapped") && fs.create_dir[scratch]("x/elsewhere")
    && fs.symlink[scratch]("x/swapped/sub", "../elsewhere")
    && fs.symlink[scratch]("x/swapped/aimed", "../elsewhere/secret")
    && fs.write_file[scratch]("x/elsewhere/secret", b"kept");
  let steps = match tar::plan([
      tar::file("sub/f", b"x"),
      tar::file("aimed", b"y"),
      tar::file("fine", b"z"),
    ]) {
    Ok(planned) -> planned,
    Err(_) -> panic("the entries are safe to extract"),
  };
  [
    "a tree is planted -> " ++ shown_bool(grown),
    "pack x/src, without times and modes -> " ++ packed("x/src", "x/plain.tar", plain),
    "file_size x/plain.tar -> " ++ shown_opt_int(fs.file_size[scratch]("x/plain.tar")),
    "unpack x/plain.tar -> " ++ unpacked("x/plain.tar", "x/plain"),
    "the unpacked -> " ++ shown_tree("x/plain"),
    "one file x/plain/a.txt x/plain/sub/twin.txt -> "
      ++ one_file("x/plain/a.txt", "x/plain/sub/twin.txt"),
    "pack x/src, with them -> " ++ packed("x/src", "x/kept.tar", kept),
    "unpack x/kept.tar -> " ++ unpacked("x/kept.tar", "x/kept"),
    "the unpacked -> " ++ shown_tree("x/kept"),
    "the tree -> " ++ shown_tree("x/src"),
    "an archive that climbs out -> " ++ shown_bool(climbs),
    "unpack it -> " ++ unpacked("x/climbs.tar", "x/out"),
    "list_dir x/out -> " ++ shown_names(fs.list_dir[scratch]("x/out")),
    "exists x/escaped -> " ++ shown_bool(fs.exists[scratch]("x/escaped")),
    "an archive that writes through its own link -> " ++ shown_bool(through),
    "unpack it -> " ++ unpacked("x/through.tar", "x/out"),
    "list_dir x/out -> " ++ shown_names(fs.list_dir[scratch]("x/out")),
    "an archive cut short -> " ++ shown_bool(cut),
    "unpack it -> " ++ unpacked("x/cut.tar", "x/out"),
    "list_dir x/out -> " ++ shown_names(fs.list_dir[scratch]("x/out")),
    "unpack what is not there -> "
      ++ (match absent {
        Ok(said) -> said,
        Err((at, why)) -> "at " ++ at ++ ": " ++ shown_refused(why),
      }),
    "a directory whose entries are links out of it -> " ++ shown_bool(swapped),
    "extract a plan into it -> "
      ++ tar::extract[scratch](steps, "x/swapped").fold("", |acc: String, o: tar::Outcome|
        acc ++ (if acc == "" { "" } else { ", " }) ++ shown_outcome(o)),
    "list_dir x/elsewhere -> " ++ shown_names(fs.list_dir[scratch]("x/elsewhere")),
    "read_file x/elsewhere/secret -> "
      ++ shown_opt_text(fs.read_file[scratch]("x/elsewhere/secret")),
    "read_file x/swapped/fine -> " ++ shown_opt_text(fs.read_file[scratch]("x/swapped/fine")),
    "remove_tree x -> " ++ shown_bool(fs.remove_tree[scratch]("x")),
  ]
}

test/nondet "an archive is packed from and extracted onto the twin as onto the disk, and one that leaves its directory extracts nothing" {
  scratch::fresh();
  let disk = archived();
  let twin = fs::on_mem(fs::mem_empty(), || archived()).value;
  assert_eq(disk.at(11), Some("unpack it -> entry 1 (../escaped) may not be extracted"));
  assert_eq(disk.at(12), Some("list_dir x/out -> []"));
  assert_eq(disk.at(13), Some("exists x/escaped -> false"));
  assert_eq(disk.at(15), Some("unpack it -> entry 1 (l) may not be extracted"));
  assert_eq(disk.at(16), Some("list_dir x/out -> []"));
  assert_eq(
    disk.at(22),
    Some(
      "extract a plan into it -> barred from replacing, barred through a link, barred from replacing, extracted",
    ),
  );
  assert_eq(disk.at(23), Some("list_dir x/elsewhere -> [secret]"));
  match first_difference(disk, twin) { Some(why) -> panic(why), None -> () }
}
