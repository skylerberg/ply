import std.regex
import std.regex (Captures, Options, Regex)
import std.bytes
import std.list (enumerate)
import std.list as lists
import std.string as strings

type File = { name: String, bytes: Bytes }

const files: List<File> = embed_dir("regex")

fn file(name: String) -> Bytes / {abort.raise} =
  match files.find(|f: File| f.name == name) {
    Some(f) -> f.bytes,
    None -> panic(f"no file {name} is vendored"),
  }

type LogCase = { file: String, line: Int, pattern: String, text: String, results: String }

type LogParseState = {
  strings: List<String>,
  listing: Bool,
  pattern: String,
  next: Int,
  cases: List<LogCase>,
}

fn log_cases(name: String) -> List<LogCase> / {abort.raise} =
  enumerate(file(name).split(b"\n")).fold(
    { strings: [], listing: false, pattern: "", next: 0, cases: [] },
    |r: LogParseState, l: { index: Int, value: Bytes }| {
      let first = if l.value.len() == 0 { 0 } else { l.value.at(0) };
      if l.value == b"strings" { { ..r, strings: [], listing: true } }
      else if l.value == b"regexps" { { ..r, listing: false } } else if first == 34 {
        let text = String::of_bytes(unquoted(l.value, 1, l.value.len() - 1));
        if r.listing { { ..r, strings: r.strings.push(text) } }
        else { { ..r, pattern: text, next: 0 } }
      } else if first == b'-' || (first >= b'0' && first <= b'9') {
        {
          ..r,
          next: r.next + 1,
          cases: r.cases.push({
            file: name,
            line: l.index + 1,
            pattern: r.pattern,
            text: r.strings.at_or(r.next, ""),
            results: String::of_bytes(l.value),
          }),
        }
      } else { r }
    },
  ).cases

fn unquoted(b: Bytes, from: Int, to: Int) -> Bytes / {abort.raise} =
  Bytes::concat_all(unescaped(b, from, to, [], to - from + 1))

fn unescaped(
  b: Bytes,
  at: Int,
  end: Int,
  parts: List<Bytes>,
  left: Int,
) -> List<Bytes> / {abort.raise} =
  if at >= end || left <= 0 { parts } else {
    let stop = b.scan_until(at, b"\\", end - at);
    let plain = parts.push(b.slice(at, stop));
    if stop >= end { plain } else {
      match b.at(stop + 1) {
        b'n' -> unescaped(b, stop + 2, end, plain.push(b"\n"), left - 1),
        b'\\' -> unescaped(b, stop + 2, end, plain.push(b"\\"), left - 1),
        34 -> unescaped(b, stop + 2, end, plain.push(b"\""), left - 1),
        b'x' ->
          unescaped(
            b,
            stop + 4,
            end,
            plain.push(byte_of_int(hex(b.at(stop + 2)) * 16 + hex(b.at(stop + 3)))),
            left - 1,
          ),
        _ -> panic("an escape these files do not use"),
      }
    }
  }

fn hex(c: Int) -> Int = if c <= b'9' { c - 48 } else { (c | 32) - 87 }

fn bytes_before(text: String, at: Int) -> Int / {abort.raise} =
  Bytes::of_string(text.slice(0, at)).len()

fn match_text(re: Regex, text: String) -> String / {abort.raise} =
  match regex::captures(re, text) {
    None -> "-",
    Some(c) ->
      String::join(
        range(0, regex::group_count(re)).map(|g: Int|
          match regex::group(c, g) {
            None -> "-",
            Some(s) -> f"{bytes_before(text, s.start)}-{bytes_before(text, s.end)}",
          }),
        " ",
      ),
  }

fn one_way(pattern: String, text: String, o: Options) -> String / {abort.raise} =
  match regex::compile_with(pattern, o) {
    Err(e) -> f"refused at {e.at}: {regex::reason(e.reason)}",
    Ok(re) -> {
      let all = match_text(re, text);
      let first = match regex::find(re, text) {
        None -> "-",
        Some(s) -> f"{bytes_before(text, s.start)}-{bytes_before(text, s.end)}",
      };
      if regex::is_match(re, text) != (all != "-") { "is_match and captures disagree" }
      else if all.split(" ").at_or(0, "") != first { "find and captures disagree" }
      else { all }
    },
  }

fn match_results(c: LogCase, o: Options) -> String / {abort.raise} = {
  let whole = "\\A(?:" ++ c.pattern ++ ")\\z";
  String::join(
    [
      one_way(whole, c.text, o),
      one_way(c.pattern, c.text, o),
      one_way(whole, c.text, { ..o, longest: true }),
      one_way(c.pattern, c.text, { ..o, longest: true }),
    ],
    ";",
  )
}

type SkipReason = | SingleBytes | Octal | BetweenBytes

fn skip_reason(c: LogCase) -> Option<SkipReason> / {abort.raise} =
  match regex::compile(c.pattern) {
    Err({ reason: regex::HalfCharacter, .. }) -> Some(SingleBytes),
    Err({ reason: regex::Backreference, .. }) -> Some(Octal),
    _ -> if c.pattern.contains("\\B") && Bytes::of_string(c.text).len() != c.text.len() {
      Some(BetweenBytes)
    } else { None },
  }

fn cases_to_run(name: String) -> List<LogCase> / {abort.raise} =
  log_cases(name).filter(|c: LogCase| skip_reason(c) == None)

type Tally = { cases: Int, run: Int, single_bytes: Int, octal: Int, between_bytes: Int }

fn tally(name: String) -> Tally / {abort.raise} =
  log_cases(name).fold(
    { cases: 0, run: 0, single_bytes: 0, octal: 0, between_bytes: 0 },
    |t: Tally, c: LogCase| {
      let counted = { ..t, cases: t.cases + 1 };
      match skip_reason(c) {
        None -> { ..counted, run: t.run + 1 },
        Some(SingleBytes) -> { ..counted, single_bytes: t.single_bytes + 1 },
        Some(Octal) -> { ..counted, octal: t.octal + 1 },
        Some(BetweenBytes) -> { ..counted, between_bytes: t.between_bytes + 1 },
      }
    },
  )

const search_log: List<LogCase> = cases_to_run("re2-search.txt")

const exhaustive_part: List<LogCase> = cases_to_run("re2-exhaustive-sample.txt")

const one_state_options: Options = { ..regex::options, short: -1 }

const small_state_limit_options: Options = { ..regex::options, short: -1, state_limit: 3 }

test "every case in RE2's search test file runs, except those skipped for byte-level patterns, octal escapes and matches between bytes of a character" {
  assert_eq(tally("re2-search.txt"), {
    cases: 1888,
    run: 1788,
    single_bytes: 80,
    octal: 16,
    between_bytes: 4,
  })
}

test "every case in the sample of RE2's exhaustive test file runs, except those skipped for patterns that match single bytes" {
  assert_eq(tally("re2-exhaustive-sample.txt"), {
    cases: 1297,
    run: 1175,
    single_bytes: 122,
    octal: 0,
    between_bytes: 0,
  })
}

test "{c.file}:{c.line} is matched as RE2 matches it" for c: LogCase in search_log.concat(
    exhaustive_part,
  ) {
  assert_eq(match_results(c, regex::options), c.results);
  assert_eq(match_results(c, one_state_options), c.results);
  assert_eq(match_results(c, small_state_limit_options), c.results)
}

type Posix = {
  file: String,
  line: Int,
  pattern: Bytes,
  text: Bytes,
  want: String,
  fold: Bool,
  literal: Bool,
}

type PosixParseState = { last: Bytes, cases: List<Posix> }

fn posix_file(name: String) -> List<Posix> / {abort.raise} =
  enumerate(file(name).split(b"\n")).fold(
    { last: b"", cases: [] },
    |f: PosixParseState, l: { index: Int, value: Bytes }| {
      let fields = l.value.split(b"\t").filter(|x: Bytes| x.len() > 0).map(|x: Bytes|
        if x == b"NULL" { b"" } else { x });
      let flags = flags_of(fields.at_or(0, b""));
      if fields.len() < 4 || flags.len() == 0 || fields.contains(b"NIL") { f } else {
        let escaped = flags.contains(b"$");
        let match_text = fields.at_or(1, b"");
        let pattern = if match_text == b"SAME" { f.last }
        else if escaped { unquoted(match_text, 0, match_text.len()) }
        else { match_text };
        let subject = fields.at_or(2, b"");
        let one = {
          file: name,
          line: l.index + 1,
          pattern: pattern,
          text: if escaped { unquoted(subject, 0, subject.len()) } else { subject },
          want: String::of_bytes(fields.at_or(3, b"")),
          fold: flags.contains(b"i"),
          literal: false,
        };
        {
          last: pattern,
          cases: f.cases.concat(if flags.contains(b"E") { [one] } else { [] }).concat(
            if flags.contains(b"L") { [{ ..one, literal: true }] } else { [] },
          ),
        }
      }
    },
  ).cases

fn flags_of(field: Bytes) -> Bytes / {abort.raise} =
  if field.len() == 0 { b"" } else {
    let first = field.at(0);
    if b"?&|;{}".contains(field.slice(0, 1)) { field.slice(1, field.len()) } else if first == b':' {
      match field.index_of_from(b":", 1) {
        Some(close) -> field.slice(close + 1, field.len()),
        None -> b"",
      }
    } else if first == b'#' || b"CNT0123456789".contains(field.slice(0, 1)) { b"" }
    else { field }
  }

fn posix_pattern(c: Posix) -> String / {abort.raise} = {
  let pattern = String::of_bytes(c.pattern);
  (if c.fold { "(?i)" } else { "" }) ++ (if c.literal { regex::escape(pattern) } else { pattern })
}

const posix_all: List<Posix> =
  posix_file("basic.dat").concat(posix_file("nullsubexpr.dat")).concat(posix_file("repetition.dat"))

const posix_cases: List<Posix> =
  posix_all.filter(|c: Posix| c.text.is_utf8() && c.pattern.is_utf8())

fn posix_match_text(re: Regex, text: String, pairs: Int) -> String / {abort.raise} =
  match regex::captures(re, text) {
    None -> "NOMATCH",
    Some(c) ->
      String::join(
        range(0, min(pairs, regex::group_count(re))).map(|g: Int|
          match regex::group(c, g) {
            None -> "(?,?)",
            Some(s) -> f"({bytes_before(text, s.start)},{bytes_before(text, s.end)})",
          }),
        "",
      ),
  }

test "AT&T's POSIX data runs every case except the one whose subject is not UTF-8" {
  assert_eq(posix_all.len(), 347);
  assert_eq(posix_cases.len(), 346)
}

test "POSIX test case {c.file}:{c.line} gives the expected match under leftmost-longest matching, with submatches as RE2 reports them" for c: Posix in posix_cases {
  let first = if c.want.len() == 0 { 0 } else { Bytes::of_string(c.want).at(0) };
  let rejecting = first >= b'A' && first <= b'Z' && c.want != "NOMATCH";
  let text = String::of_bytes(c.text);
  let ways = [regex::options, one_state_options, small_state_limit_options];
  assert_eq(
    ways.map(|o: Options|
      match regex::compile_with(posix_pattern(c), { ..o, longest: true }) {
        Err(e) -> if rejecting { c.want } else { f"refused at {e.at}: {regex::reason(e.reason)}" },
        Ok(re) -> if rejecting { "compiled" }
        else if regex::is_match(re, text) != (c.want != "NOMATCH") {
          "is_match and captures disagree"
        } else { posix_match_text(re, text, c.want.split("(").len() - 1) },
      }),
    [c.want, c.want, c.want],
  )
}

type Finding = { line: Int, pattern: String, text: Bytes, most: Int, matches: String }

const findings_all: List<Finding> =
  enumerate(file("go-find.txt").split(b"\n")).fold(
    [],
    |accumulator: List<Finding>, l: { index: Int, value: Bytes }|
      match l.value.split(b"\t") {
        [pattern, text, most, matches] ->
          accumulator.push({
            line: l.index + 1,
            pattern: String::of_bytes(unquoted(pattern, 1, pattern.len() - 1)),
            text: unquoted(text, 1, text.len() - 1),
            most: match String::of_bytes(most).int_of_string() {
              Some(n) -> n,
              None -> panic("a count"),
            },
            matches: String::of_bytes(matches),
          }),
        _ -> accumulator,
      },
  )

const findings: List<Finding> = findings_all.filter(|c: Finding| c.text.is_utf8())

test "Go's table of match results runs every case except the six whose text is not UTF-8" {
  assert_eq(findings_all.len(), 94);
  assert_eq(findings.len(), 88)
}

fn find_matches_text(c: Finding, o: Options) -> String / {abort.raise} =
  match regex::compile_with(c.pattern, o) {
    Err(e) -> f"refused at {e.at}: {regex::reason(e.reason)}",
    Ok(re) -> {
      let text = String::of_bytes(c.text);
      let all = regex::captures_all(re, text);
      let taken = if c.most < 0 { all } else { all.take(c.most) };
      if all.map(|m: Captures| regex::group(m, 0))
          != regex::find_all(re, text).map(|s: regex::Span| Some(s)) {
        "find_all and captures_all disagree"
      } else if regex::split(re, text).len() != all.len() + 1 { "split and captures_all disagree" }
      else if taken.len() == 0 { "none" } else {
        String::join(
          taken.map(|m: Captures|
            String::join(
              range(0, regex::group_count(re)).map(|g: Int|
                match regex::group(m, g) {
                  None -> "-",
                  Some(s) -> f"{bytes_before(text, s.start)}-{bytes_before(text, s.end)}",
                }),
              " ",
            )),
          ";",
        )
      }
    },
  }

test "go-find.txt:{c.line} finds the matches Go finds" for c: Finding in findings {
  assert_eq(find_matches_text(c, regex::options), c.matches);
  assert_eq(find_matches_text(c, one_state_options), c.matches);
  assert_eq(find_matches_text(c, small_state_limit_options), c.matches)
}
