import std.bytes
import std.char
import std.list
import std.ucd
import ucd_files
import ucd_files (Row, CodePointRange, hex, rows_under, unicode_data, failing_code_points)

type CharacterData = { category: String, digit: Option<Int>, upper: Int, lower: Int, title: Int }

fn mapping_offset(field: Bytes, code_point: Int) -> Int / {abort.raise} =
  if field.len() == 0 { 0 } else { hex(field) - code_point }

fn character_data(row: Row) -> CodePointRange<CharacterData> / {abort.raise} =
  {
    first: row.first,
    last: row.last,
    property: {
      category: String::of_bytes(row.fields.get(2)),
      digit: row.fields.get(6).int_of_ascii(),
      upper: mapping_offset(row.fields.get(12), row.last),
      lower: mapping_offset(row.fields.get(13), row.last),
      title: mapping_offset(row.fields.get(14), row.last),
    },
  }

fn unassigned() -> CharacterData = { category: "Cn", digit: None, upper: 0, lower: 0, title: 0 }

fn char_agrees(code_point: Int, character_data: CharacterData) -> Bool =
  match Char::of_code_point(code_point) {
    None -> character_data.category == "Cs",
    Some(c) ->
      char::abbreviation(c.general_category()) == character_data.category
        && c.decimal_value() == character_data.digit
        && c.to_uppercase().code_point() == code_point + character_data.upper
        && c.to_lowercase().code_point() == code_point + character_data.lower
        && c.to_titlecase().code_point() == code_point + character_data.title,
  }

test "every code point has the category, decimal digit and case mappings UnicodeData.txt gives it" {
  let wrong = failing_code_points(
    unicode_data().map(character_data),
    |code_point: Int, listed: Option<CharacterData>|
      char_agrees(code_point, match listed { Some(s) -> s, None -> unassigned() }),
  );
  assert_eq(wrong, [])
}

type Property = { file: Bytes, contains: (Char) -> Bool }

fn property(name: String) -> Property / {abort.raise} = {
  let core = ucd_files::derived_core_properties();
  match name {
    "Alphabetic" -> { file: core, contains: Char::is_alphabetic },
    "Lowercase" -> { file: core, contains: Char::is_lowercase },
    "Uppercase" -> { file: core, contains: Char::is_uppercase },
    "XID_Start" -> { file: core, contains: Char::is_xid_start },
    "XID_Continue" -> { file: core, contains: Char::is_xid_continue },
    "White_Space" -> { file: ucd_files::prop_list(), contains: Char::is_whitespace },
    _ -> panic(f"no predicate is {name}"),
  }
}

test "the {name} property is true for exactly the code points the database lists for it" for name: String in [
    "Alphabetic",
    "Lowercase",
    "Uppercase",
    "White_Space",
    "XID_Start",
    "XID_Continue",
  ] {
  let p = property(name);
  let rows = rows_under(p.file, [name]).map(|row: Row|
    { first: row.first, last: row.last, property: () });
  assert(rows.len() > 0);
  let wrong = failing_code_points(rows, |code_point: Int, listed: Option<Unit>|
    match Char::of_code_point(code_point) {
      Some(c) -> (p.contains)(c) == (listed != None),
      None -> true,
    });
  assert_eq(wrong, [])
}

test "the Unicode data files are from the version that `std.ucd` names" {
  let v = ucd::version();
  let version = f"{v.major}.{v.minor}.{v.update}";
  assert_eq(ucd_files::version_of(ucd_files::derived_core_properties()), version);
  assert_eq(ucd_files::version_of(ucd_files::prop_list()), version)
}
