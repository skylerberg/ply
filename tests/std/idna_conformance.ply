//! `std.idna` against `IdnaTestV2.txt`, the conformance test of UTS #46: every line of it, a
//! hundred or so to a case, converted both ways under every check. The test asks that a
//! conversion fail exactly where a line lists a status, and that what it makes of the name be
//! the line's; `X4_2`, which the file keeps for an empty label where `to_unicode` measures none,
//! is no failure of `to_unicode`'s. Transitional processing is not offered, and its columns are
//! not read.

import std.idna
import std.list
import std.utf16
import ucd_files
import ucd_files (Block, hex_code_points, trimmed)

/// A line of the test: a name, what `to_unicode` and `to_ascii` make of it, and the statuses
/// each is listed with.
type Line = {
  source: String,
  unicode: String,
  unicode_status: List<String>,
  ascii: String,
  ascii_status: List<String>,
}

/// The sixteen-bit units read so far, and how many characters of an escape are still to pass.
type UnescapeState = { units: List<Int>, passing: Int }

/// A column's text, its `\uXXXX` escapes read as the units they name: `None` where they pair off
/// into no text, as a test of a lone surrogate's does.
fn unescaped(column: String) -> Option<String> / {abort.raise} = {
  let chars = Array::of_list(column.chars());
  let read = range(0, chars.len()).fold(
    { units: [], passing: 0 },
    |so_far: UnescapeState, i: Int|
      if so_far.passing > 0 { { units: so_far.units, passing: so_far.passing - 1 } }
      else if chars.at(i) == Some('\\') && chars.at(i + 1) == Some('u') {
        {
          units: so_far.units.push(ucd_files::hex(Bytes::of_string(column.slice(i + 2, i + 6)))),
          passing: 5,
        }
      } else {
        {
          units: utf16::units(column.slice(i, i + 1)).fold(
            so_far.units,
            |all: List<Int>, unit: Int| all.push(unit),
          ),
          passing: 0,
        }
      },
  );
  match try { utf16::of_units(read.units) } { Ok(text) -> Some(text), Err(_) -> None }
}

/// The statuses a column lists between its brackets; none for a blank column or an empty pair.
fn statuses(column: String) -> List<String> =
  if column.len() < 2 { [] } else {
    column.slice(1, column.len() - 1).split(",").map(String::trim).filter(|status: String|
      status != "")
  }

/// A column of text as the file writes one: `""` for the empty text, and blank for `otherwise`.
fn column(written: String, otherwise: Option<String>) -> Option<String> / {abort.raise} =
  if written == "" { otherwise } else if written == "\"\"" { Some("") } else { unescaped(written) }

/// Every line of the test whose texts are texts.
fn lines() -> List<Line> / {abort.raise} =
  ucd_files::idna_test().split(b"\n").fold([], |found: List<Line>, line: Bytes| {
    let data = match line.index_of_byte(b'#') { Some(i) -> line.slice(0, i), None -> line };
    let columns = data.split(b";").map(|part: Bytes| String::of_bytes(trimmed(part)));
    if columns.len() < 6 { found } else {
      let source = column(columns.get(0), Some(""));
      let unicode = column(columns.get(1), source);
      let ascii = column(columns.get(3), unicode);
      match ((source, unicode, ascii)) {
        (Some(s), Some(u), Some(a)) ->
          found.push({
            source: s,
            unicode: u,
            unicode_status: statuses(columns.get(2)),
            ascii: a,
            ascii_status: if columns.get(4) == "" { statuses(columns.get(2)) }
            else { statuses(columns.get(4)) },
          }),
        _ -> found,
      }
    }
  })

fn blocks() -> List<Block<Line>> / {abort.raise} =
  ucd_files::blocks(lines(), 128, |l: Line| hex_code_points(l.source))

/// Whether both conversions of a line's name are what the line says.
fn conforms(l: Line) -> Bool / {abort.raise} = {
  let shown = idna::to_unicode(l.source, idna::strict());
  let fails = l.unicode_status.filter(|status: String| status != "X4_2").len() > 0;
  shown.name == l.unicode && shown.problems.len() > 0 == fails
    && (match idna::to_ascii(l.source, idna::strict()) {
      Ok(name) -> l.ascii_status.len() == 0 && name == l.ascii,
      Err(_) -> l.ascii_status.len() > 0,
    })
}

test "the {b.lines.len()} lines of IdnaTestV2.txt from {b.from} convert as they say" for b: Block<Line> in blocks(
  ) {
  assert_eq(
    b.lines.filter(|l: Line| !conforms(l)).take(8).map(|l: Line| hex_code_points(l.source)),
    [],
  )
}

test "a name the test converts with no status converts to itself again, and is shown as itself" {
  let strict = idna::strict();
  let wrong = lines().filter(|l: Line|
    l.unicode_status.len() == 0 && l.ascii_status.len() == 0
      && !(idna::to_ascii(l.ascii, strict) == Ok(l.ascii)
        && idna::to_unicode(l.ascii, strict) == { name: l.unicode, problems: [] }
        && idna::to_unicode(l.unicode, strict) == { name: l.unicode, problems: [] }
        && idna::to_ascii(l.unicode, strict) == Ok(l.ascii)));
  assert_eq(wrong.take(8).map(|l: Line| hex_code_points(l.source)), [])
}
