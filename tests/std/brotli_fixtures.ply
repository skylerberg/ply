import packed_samples (names, sample)
import std.brotli
import std.brotli (brotli, Limits, Error)
import std.bytes
import std.seq
import std.seq (seq)
import std.value (reflect)

type File = { name: String, bytes: Bytes }

fn files() -> List<File> = embed_dir("brotli")

fn file(name: String) -> Bytes / {abort.raise} =
  match files().filter(|f: File| f.name == name) {
    [found, ..] -> found.bytes,
    [] -> panic(f"no file {name}"),
  }

fn uncompressed_of(name: String) -> Bytes / {abort.raise} =
  match name.split(".") { [stem, ..] -> sample(stem), [] -> panic("no name") }

fn streams() -> List<File> = files().filter(|f: File| f.name.ends_with(".br"))

fn short_streams() -> List<File> = streams().filter(|f: File| f.bytes.len() < 1200)

fn large_limits() -> Limits = { output: 1000000, window: 16777200 }

fn outcome(got: Result<Bytes, Error>, want: Bytes) -> String =
  match got {
    Ok(b) -> if b == want { "same" } else { f"differs: {b.len()} bytes for {want.len()}" },
    Err(r) -> f"rejected at {r.at}: {reflect(r.reason)}",
  }

test "{f.name} decompresses to the original uncompressed file" for f: File in streams() {
  assert_eq(
    outcome(brotli::try_decompress(f.bytes, large_limits()), uncompressed_of(f.name)),
    "same",
  )
}

fn decompress_in_chunks(
  packed: Bytes,
  size: Int,
  limits: Limits,
) -> Bytes / {brotli.fail, seq.spent, abort.raise} =
  Bytes::concat_all(
    seq::to_list(brotli::decompress_stream(seq::slices(packed, size), limits), 10000000),
  )

test "{f.name} decompresses to the same bytes when given in chunks of any size" for f: File in streams(
  ) {
  let whole = uncompressed_of(f.name);
  assert(decompress_in_chunks(f.bytes, 100000, large_limits()) == whole);
  assert(decompress_in_chunks(f.bytes, 4099, large_limits()) == whole);
  assert(f.bytes.len() > 3000 || decompress_in_chunks(f.bytes, 1, large_limits()) == whole)
}

test "{name} compressed at each level, or as a stream of chunks, decompresses to the original" for name: String in names(
  ) {
  let plain = sample(name);
  let fast = brotli::compress(plain, brotli::Fast);
  assert_eq(outcome(brotli::try_decompress(fast, large_limits()), plain), "same");
  assert_eq(
    outcome(brotli::try_decompress(brotli::compress(plain, brotli::Stored), large_limits()), plain),
    "same",
  );
  let chunked = Bytes::concat_all(
    seq::to_list(brotli::compress_stream(seq::slices(plain, 50000), brotli::Fast), 100000),
  );
  assert_eq(outcome(brotli::try_decompress(chunked, large_limits()), plain), "same");
  assert(fast.len() <= plain.len() + 16)
}

test "{f.name} truncated at any length fails with `Truncated` at that length" for f: File in short_streams(
  ) {
  assert_eq(
    range(0, f.bytes.len()).filter(|n: Int|
      brotli::try_decompress(f.bytes.slice(0, n), large_limits())
        != Err({ at: n, reason: brotli::Truncated })),
    [],
  )
}

fn chunked_matches_whole(packed: Bytes) -> Bool = {
  let limits: Limits = { output: 300000, window: 16777200 };
  let whole: Result<Result<Bytes, Error>, String> = try[abort.raise] {
    brotli::try_decompress(packed, limits)
  };
  let cut: Result<Result<Result<Bytes, Error>, Int>, String> = try[abort.raise] {
    try[seq.spent] { try[brotli.fail] { decompress_in_chunks(packed, 5, limits) } }
  };
  match whole { Ok(result) -> cut == Ok(Ok(result)), Err(_) -> false }
}

test "after flipping one bit of any byte of {f.name}, decompressing it whole or in small chunks gives the same result, success or error" for f: File in short_streams(
  ) {
  assert_eq(
    range(0, f.bytes.len()).filter(|i: Int|
      !chunked_matches_whole(f.bytes.with_byte(i, f.bytes.at(i) ^ 0x10))),
    [],
  )
}

test "`try_decompress` fails with `Window` when a stream declares a window over the limit, and with `LargeWindow` for a large-window stream" {
  let wide = file("brief.w24.br");
  assert_eq(
    brotli::try_decompress(wide, { output: 1000000, window: 8388592 }),
    Err({ at: 0, reason: brotli::Window }),
  );
  assert_eq(
    brotli::try_decompress(wide.slice(0, 1), { output: 1000000, window: 8388592 }),
    Err({ at: 0, reason: brotli::Window }),
  );
  assert_eq(brotli::try_decompress(wide, large_limits()), Ok(sample("brief")));
  let narrow = file("prose.w10.br");
  assert_eq(
    brotli::try_decompress(narrow, { output: 1000000, window: 1007 }),
    Err({ at: 0, reason: brotli::Window }),
  );
  assert_eq(brotli::try_decompress(narrow, { output: 1000000, window: 1008 }), Ok(sample("prose")));
  assert_eq(
    brotli::try_decompress(file("brief.large.refused"), large_limits()),
    Err({ at: 0, reason: brotli::LargeWindow }),
  );
  assert(match brotli::try_decompress(file("long.q5.br"), { output: 149999, window: 16777200 }) {
    Err(r) -> r.reason == brotli::OverLimit,
    Ok(_) -> false,
  })
}

test "bytes after a stream fail with `Trailing`, and `decompress_first` returns the first stream and how many bytes it used" {
  let a = file("brief.q5.br");
  assert_eq(
    brotli::try_decompress(a.concat(file("one.q0.br")), large_limits()),
    Err({ at: a.len(), reason: brotli::Trailing }),
  );
  let first = brotli::decompress_first(a.concat(b"junk"), large_limits());
  assert_eq(first.plain, sample("brief"));
  assert_eq(first.used, a.len())
}
