import fs_contract (first_difference)
import scratch
import std.sql (stmt, IntParameter, TextParameter, Row, Rows, Count, Failed)
import std.list
import std.sqlite
import std.sqlite (sqlite, sql, Create, ReadOnly, ReadWrite, Limits, Options, Connection)

fn large_limits() -> Limits =
  { sql_bytes: 10000, params: 100, rows: 10000, bytes: 1000000, steps: 100000 }

fn plain_options() -> Options = { strict: true, busy_ms: 20, statements: 8 }

fn outcome_text<| e>(go: () -> String / {sql.fail | e}) -> String / e =
  match try[sql.fail] { go() } { Ok(line) -> line, Err(reason) -> f"{reason}" }

fn names<[d], [r]>(
  conn: Scoped<Connection<[d]>, [r]>,
) -> String / {scoped.read[r], sqlite.query[d], sql.fail, abort.raise} = {
  let rows = sqlite::query(conn, sqlite"select name from person order by id", large_limits());
  f"{rows.map(|row: Row| sqlite::text(row, "name"))}"
}

fn added<[d], [r]>(
  conn: Scoped<Connection<[d]>, [r]>,
  name: String,
) -> String / {scoped.read[r], sqlite.execute[d], sql.fail} = {
  let made = sqlite::execute(
    conn,
    sqlite"insert into person (name) values ({TextParameter(name)})",
    large_limits(),
  );
  f"{made.rows} row, id {made.last_row_id}"
}

fn counted<[d], [r]>(
  conn: Scoped<Connection<[d]>, [r]>,
  q: sqlite::Bound,
  limits: Limits,
) -> String / {scoped.read[r], sqlite.query[d], sql.fail, abort.raise} =
  sqlite::query(conn, q, limits).len().to_string() ++ " rows"

fn script<[d]>() -> List<String> / {sqlite.read[d], sqlite.write[d], sql.fail, abort.raise} = {
  let missing = outcome_text(||
    with_scope[missing](sqlite::opening[d]("none.db", ReadWrite, plain_options()), |c|
      sqlite::close(c)) { conn -> "opened" });
  let first = with_scope[first](
    sqlite::opening[d]("app.db", Create, plain_options()),
    |c| sqlite::close(c),
  ) { conn ->
    [
      "create -> "
        ++ outcome_text(|| {
          let made = sqlite::execute(
            conn,
            sqlite"create table person (id integer primary key, name text not null unique, age integer check (age >= 0)) strict",
            large_limits(),
          );
          f"{made.rows} rows, id {made.last_row_id}"
        }),
      "insert Ada -> " ++ outcome_text(|| added(conn, "Ada")),
      "insert Grace -> " ++ outcome_text(|| added(conn, "Grace")),
      "insert Ada again -> " ++ outcome_text(|| added(conn, "Ada")),
      "insert a negative age -> "
        ++ outcome_text(|| {
          sqlite::execute(
            conn,
            sqlite"insert into person (name, age) values ('Alan', {IntParameter(-1)})",
            large_limits(),
          );
          "inserted"
        }),
      "insert text for an age -> "
        ++ outcome_text(|| {
          sqlite::execute(
            conn,
            sqlite"insert into person (name, age) values ('Alan', 'old')",
            large_limits(),
          );
          "inserted"
        }),
      "names -> " ++ outcome_text(|| names(conn)),
      "returning -> "
        ++ outcome_text(|| {
          let rows = sqlite::returning(
            conn,
            sqlite"update person set age = 36 where name = 'Ada' returning id, age",
            large_limits(),
          );
          f"{rows.map(|row: Row| sqlite::int(row, "id") * 100 + sqlite::int(row, "age"))}"
        }),
      "an age and a null -> "
        ++ outcome_text(|| {
          let rows = sqlite::query(
            conn,
            sqlite"select age from person order by id",
            large_limits(),
          );
          f"{rows.map(|row: Row| sqlite::optional(row, "age", sqlite::int))}"
        }),
      "a null read as an integer -> "
        ++ outcome_text(|| {
          let rows = sqlite::query(
            conn,
            sqlite"select age from person order by id",
            large_limits(),
          );
          f"{rows.map(|row: Row| sqlite::int(row, "age"))}"
        }),
      "run a query -> "
        ++ (match sqlite::run(conn, sqlite"select count(*) as n from person", large_limits()) {
          Rows(rows) -> f"{rows.len()} row",
          Count(n) -> f"count {n}",
          Failed(e) -> e.code,
        }),
      "run a write -> "
        ++ (match sqlite::run(
            conn,
            sqlite"update person set age = 85 where name = 'Grace'",
            large_limits(),
          ) {
          Rows(rows) -> f"{rows.len()} row",
          Count(n) -> f"count {n}",
          Failed(e) -> e.code,
        }),
      "run a failure -> "
        ++ (match sqlite::run(
            conn,
            sqlite"insert into person (name) values ('Ada')",
            large_limits(),
          ) {
          Rows(rows) -> f"{rows.len()} row",
          Count(n) -> f"count {n}",
          Failed(e) -> e.code ++ " " ++ e.constraint,
        }),
      "a transaction that commits -> "
        ++ outcome_text(||
          sqlite::transaction(conn, || added(conn, "Edsger")) ++ ", then " ++ names(conn)),
      "a transaction that raises -> "
        ++ outcome_text(||
          sqlite::transaction(conn, || added(conn, "Barbara") ++ added(conn, "Ada")))
        ++ ", then "
        ++ outcome_text(|| names(conn)),
      "a savepoint that raises -> "
        ++ outcome_text(||
          sqlite::transaction(conn, ||
            added(conn, "Barbara") ++ ", inner "
              ++ outcome_text(||
                sqlite::transaction(conn, || added(conn, "Tony") ++ added(conn, "Ada")))))
        ++ ", then "
        ++ outcome_text(|| names(conn)),
      "a commit with none open -> "
        ++ outcome_text(|| {
          sqlite::execute(conn, sqlite::bound(stmt("commit"), []), large_limits());
          "committed"
        }),
      "over the rows -> "
        ++ outcome_text(||
          counted(conn, sqlite"select name from person", { ..large_limits(), rows: 2 })),
      "over the bytes -> "
        ++ outcome_text(||
          counted(conn, sqlite"select name from person", { ..large_limits(), bytes: 4 })),
      "over the steps -> "
        ++ outcome_text(||
          counted(
            conn,
            sqlite"with recursive c(i) as (select 1 union all select i + 1 from c where i < 500000) select count(*) as n from c",
            { ..large_limits(), steps: 5 },
          )),
      "a fold -> "
        ++ outcome_text(||
          sqlite::fold_rows(
            conn,
            sqlite"select name from person order by id",
            large_limits(),
            2,
            "",
            |acc: String, row: Row| acc ++ sqlite::text(row, "name").slice(0, 1),
          )),
      "a statement inside a fold -> "
        ++ outcome_text(||
          sqlite::fold_rows(
            conn,
            sqlite"select name from person order by id",
            large_limits(),
            2,
            "",
            |_: String, _: Row| outcome_text(|| names(conn)),
          )),
      "a fold past its rows -> "
        ++ outcome_text(||
          sqlite::fold_rows(
            conn,
            sqlite"select name from person",
            { ..large_limits(), rows: 3 },
            2,
            "",
            |acc: String, _: Row| acc ++ ".",
          )),
      "a function the engine refuses -> "
        ++ outcome_text(||
          counted(conn, sqlite::bound(stmt("select changes() as n"), []), large_limits())),
      "a clock read through a parameter -> "
        ++ outcome_text(||
          counted(conn, sqlite"select datetime({TextParameter("now")}) as at", large_limits())),
      "a date that reads no clock -> "
        ++ outcome_text(|| {
          let rows = sqlite::query(
            conn,
            sqlite"select date('2024-02-28', '+2 days') as d",
            large_limits(),
          );
          f"{rows.map(|row: Row| sqlite::text(row, "d"))}"
        }),
      "a pragma that is set -> "
        ++ outcome_text(|| {
          sqlite::execute(conn, sqlite"pragma user_version = 3", large_limits());
          let rows = sqlite::query(conn, sqlite"pragma user_version", large_limits());
          f"{rows.map(|row: Row| sqlite::int(row, "user_version"))}"
        }),
      "a pragma that is refused -> "
        ++ outcome_text(|| {
          sqlite::execute(conn, sqlite"pragma journal_mode = delete", large_limits());
          "set"
        }),
      "a table that is not strict -> "
        ++ outcome_text(|| {
          sqlite::execute(conn, sqlite"create table loose (a)", large_limits());
          "made"
        }),
      "a backup -> "
        ++ outcome_text(|| {
          sqlite::backup(conn, "copy.db");
          "copied"
        }),
      "a backup over one -> "
        ++ outcome_text(|| {
          sqlite::backup(conn, "copy.db");
          "copied"
        }),
      "a backup inside a transaction -> "
        ++ outcome_text(||
          sqlite::transaction(conn, || {
            sqlite::backup(conn, "other.db");
            "copied"
          })),
    ]
  };
  let together = with_scope[one](
    sqlite::opening[d]("app.db", ReadWrite, plain_options()),
    |c| sqlite::close(c),
  ) { one ->
    with_scope[two](sqlite::opening[d]("app.db", ReadWrite, plain_options()), |c|
      sqlite::close(c)) { two ->
      [
        "a writer's transaction, read from beside it -> "
          ++ outcome_text(||
            sqlite::transaction(one, ||
              added(one, "Margaret") ++ ", beside it " ++ names(two) ++ ", a second writer "
                ++ outcome_text(|| added(two, "Frances"))
                ++ ", a second transaction "
                ++ outcome_text(|| sqlite::transaction(two, || "begun")))),
        "after its commit -> " ++ outcome_text(|| names(two)),
        "a snapshot, written beside -> "
          ++ outcome_text(||
            sqlite::snapshot(one, ||
              names(one) ++ ", beside it " ++ outcome_text(|| added(two, "Frances")) ++ ", still "
                ++ names(one)
                ++ ", its own write "
                ++ outcome_text(|| added(one, "Jean")))),
      ]
    }
  };
  let reading = with_scope[reading](
    sqlite::opening[d]("app.db", ReadOnly, plain_options()),
    |c| sqlite::close(c),
  ) { conn ->
    [
      "read back -> " ++ outcome_text(|| names(conn)),
      "a write where only reads were asked for -> " ++ outcome_text(|| added(conn, "Kathleen")),
      "a transaction where only reads were asked for -> "
        ++ outcome_text(|| sqlite::transaction(conn, || "begun")),
      "a snapshot where only reads were asked for -> "
        ++ outcome_text(|| sqlite::snapshot(conn, || names(conn))),
    ]
  };
  let copied = outcome_text(||
    with_scope[copied](sqlite::opening[d]("copy.db", ReadOnly, plain_options()), |c|
      sqlite::close(c)) { conn -> names(conn) });
  let closed = outcome_text(|| {
    let kept = with_scope[leaving](
      sqlite::opening[d]("app.db", ReadOnly, plain_options()),
      |c| sqlite::close(c),
    ) { conn -> conn.get() };
    with_scope[left](kept, |_: Connection<[d]>| ()) { conn -> names(conn) }
  });
  [first, together, reading, ["the copy -> " ++ copied, "a closed connection -> " ++ closed]].fold(
    ["open what is not there -> " ++ missing],
    |all: List<String>, lines: List<String>|
      lines.fold(all, |acc: List<String>, line: String| acc.push(line)),
  )
}

test/nondet "the database's fake handles every operation as a file does" {
  scratch::fresh();
  let disk = script[scratch]();
  let fake = sqlite::in_memory[scratch](|| script[scratch]());
  match first_difference(disk, fake) { Some(reason) -> panic(reason), None -> () };
  let everyone = "[\"Ada\", \"Grace\", \"Edsger\", \"Barbara\", \"Margaret\"]";
  [
    "open what is not there -> Unopened(\"unable to open database file\")",
    "insert Grace -> 1 row, id 2",
    "insert Ada again -> Constraint(Unique, \"person.name\")",
    "insert a negative age -> Constraint(Check, \"age >= 0\")",
    "insert text for an age -> Constraint(Datatype, \"person.age\")",
    "an age and a null -> [Some(36), None]",
    "a null read as an integer -> Mistyped(\"age\", \"an integer\")",
    "run a failure -> unique person.name",
    "a transaction that raises -> Constraint(Unique, \"person.name\"), then [\"Ada\", \"Grace\", \"Edsger\"]",
    "over the steps -> LimitExceeded(\"steps\")",
    "a fold -> AGEB",
    "a fold past its rows -> LimitExceeded(\"rows\")",
    "a date that reads no clock -> [\"2024-03-01\"]",
    "a pragma that is set -> [3]",
    "a backup inside a transaction -> Malformed(\"cannot VACUUM from within a transaction\")",
    "a writer's transaction, read from beside it -> 1 row, id 5, beside it [\"Ada\", \"Grace\", \"Edsger\", \"Barbara\"], a second writer Busy, a second transaction Busy",
    "after its commit -> " ++ everyone,
    "a snapshot, written beside -> " ++ everyone ++ ", beside it 1 row, id 6, still " ++ everyone
      ++ ", its own write Busy",
    "a transaction where only reads were asked for -> begun",
    "the copy -> [\"Ada\", \"Grace\", \"Edsger\", \"Barbara\"]",
  ].map(|line: String| assert(fake.contains(line), Some("neither returned: " ++ line)));
  ()
}

test "running the SQL test script twice on the fake database returns the same output lines both times" {
  let twice = [0, 1].map(|_: Int| sqlite::in_memory[scratch](|| script[scratch]()));
  assert_eq(twice.at(0), twice.at(1))
}
