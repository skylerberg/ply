import std.fs (fs, listed_names)

pub const marker: String = ".ply-scratch"

pub fn fresh() -> Unit / {fs.list_dir[scratch], fs.remove_tree[scratch], abort.raise} =
  match listed_names(fs.list_dir[scratch](".")) {
    None -> panic("the scratch root cannot be listed"),
    Some(names) -> if !names.contains(marker) {
      panic(
        "the scratch root holds no `" ++ marker
          ++ "`, so it is not emptied: grant `--fs scratch=DIR` for a DIR that holds one",
      )
    } else {
      names.fold((), |u: Unit, name: String|
        if name == marker || fs.remove_tree[scratch](name) { u }
        else { panic("could not empty the scratch root of `" ++ name ++ "`") })
    },
  }
