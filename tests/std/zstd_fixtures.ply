import packed_samples (names, sample)
import std.seq
import std.seq (seq)
import std.zstd
import std.zstd (zstd, Limits, Error)
import std.value (reflect)

type File = { name: String, bytes: Bytes }

const files: List<File> = embed_dir("zstd")

fn file(name: String) -> Bytes / {abort.raise} =
  match files.filter(|f: File| f.name == name) {
    [found, ..] -> found.bytes,
    [] -> panic(f"no file {name}"),
  }

fn uncompressed_of(name: String) -> Bytes / {abort.raise} =
  match name.split(".") { [stem, ..] -> sample(stem), [] -> panic("no name") }

const frames: List<File> =
  files.filter(|f: File|
    f.name.ends_with(".zst") && !f.name.contains("dict") && !f.name.contains("declares30"))

const large_limits: Limits = { output: 1000000, window: 8388608 }

fn outcome(got: Result<Bytes, Error>, want: Bytes) -> String =
  match got {
    Ok(b) -> if b == want { "same" } else { f"differs: {b.len()} bytes for {want.len()}" },
    Err(r) -> f"rejected at {r.at}: {reflect(r.reason)}",
  }

test "{f.name} unpacks to its sample" for f: File in frames {
  assert_eq(outcome(zstd::try_decompress(f.bytes, large_limits), uncompressed_of(f.name)), "same")
}

fn decompress_in_chunks(
  packed: Bytes,
  size: Int,
  limits: Limits,
) -> Bytes / {zstd.fail, seq.spent, abort.raise} =
  Bytes::concat_all(seq::to_list(zstd::decoded(seq::slices(packed, size), limits), 10000000))

test "{f.name} unpacks the same a chunk at a time, whatever the chunk" for f: File in frames {
  let whole = uncompressed_of(f.name);
  assert(decompress_in_chunks(f.bytes, 100000, large_limits) == whole);
  assert(decompress_in_chunks(f.bytes, 4099, large_limits) == whole);
  assert(f.bytes.len() > 3000 || decompress_in_chunks(f.bytes, 1, large_limits) == whole)
}

test "{name} compressed by `zstd::compress` decompresses back to the original, whole and in chunks" for name: String in names {
  let plain = sample(name);
  let fast = zstd::compress(plain, zstd::Fast);
  assert_eq(outcome(zstd::try_decompress(fast, large_limits), plain), "same");
  assert_eq(
    outcome(zstd::try_decompress(zstd::compress(plain, zstd::Stored), large_limits), plain),
    "same",
  );
  let chunked = Bytes::concat_all(
    seq::to_list(zstd::encoded(seq::slices(plain, 50000), zstd::Fast), 100000),
  );
  assert_eq(outcome(zstd::try_decompress(chunked, large_limits), plain), "same");
  assert(fast.len() <= plain.len() + 16)
}

test "concatenated zstd frames decompress as one stream, and skippable frames between them are ignored" {
  let both = sample("brief").concat(sample("one"));
  let skip = b"\x50\x2A\x4D\x18\x04\x00\x00\x00skip";
  let none = b"\x5F\x2A\x4D\x18\x00\x00\x00\x00";
  let a = file("brief.l3.zst");
  let b = file("one.l3.zst");
  assert_eq(outcome(zstd::try_decompress(a.concat(b), large_limits), both), "same");
  let mixed = Bytes::concat_all([skip, a, none, skip, b, none]);
  assert_eq(outcome(zstd::try_decompress(mixed, large_limits), both), "same");
  assert(decompress_in_chunks(mixed, 5, large_limits) == both);
  let first = zstd::first(mixed, large_limits);
  assert_eq(first.plain, sample("brief"));
  assert_eq(first.used, skip.len() + a.len());
  assert_eq(
    zstd::try_decompress(a.concat(b"junk"), large_limits),
    Err({ at: a.len(), reason: zstd::Trailing }),
  )
}

test "a frame compressed with a dictionary decompresses with that dictionary, and is rejected without it or with a different one" {
  let trained = zstd::dictionary(file("prose.dict"));
  let raw = zstd::dictionary(sample("prose").slice(0, 5000));
  let brief = file("brief.dict.zst");
  assert(zstd::decompress_with(brief, trained, large_limits) == sample("brief"));
  assert(zstd::decompress_with(file("prose.dict.zst"), trained, large_limits) == sample("prose"));
  assert(zstd::decompress_with(file("brief.rawdict.zst"), raw, large_limits) == sample("brief"));
  let rejected = |got: Result<Bytes, Error>|
    match got { Err(r) -> r.reason == zstd::Dictionary, Ok(_) -> false };
  assert(rejected(zstd::try_decompress(brief, large_limits)));
  assert(rejected(try { zstd::decompress_with(brief, raw, large_limits) }));
  let chunks = zstd::decoded_with(seq::slices(file("prose.dict.zst"), 777), trained, large_limits);
  assert(Bytes::concat_all(seq::to_list(chunks, 1000000)) == sample("prose"));
  let twice = brief.concat(brief);
  assert(
    zstd::decompress_with(twice, trained, large_limits) == sample("brief").concat(sample("brief")),
  )
}

test "a frame that declares a window past the limit is rejected before a block is read" {
  let far = file("brief.declares30.zst");
  assert_eq(zstd::try_decompress(far, large_limits), Err({ at: 0, reason: zstd::Window }));
  assert_eq(
    zstd::try_decompress(far.slice(0, 6), large_limits),
    Err({ at: 0, reason: zstd::Window }),
  );
  assert_eq(
    zstd::try_decompress(far, { output: 1000000, window: 1073741824 }),
    Ok(sample("brief")),
  );
  assert_eq(
    zstd::try_decompress(file("long.wlog10.zst"), { output: 1000000, window: 1023 }),
    Err({ at: 0, reason: zstd::Window }),
  );
  assert(match zstd::try_decompress(file("long.l1.zst"), { output: 149999, window: 8388608 }) {
    Err(r) -> r.reason == zstd::OverLimit && r.at == 0,
    Ok(_) -> false,
  })
}
