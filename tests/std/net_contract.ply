import scratch
import std.dns
import std.dns (dns)
import std.fs (fs)
import std.ip
import std.ip (SocketAddress, ip)
import std.list
import std.net
import std.net (net, Error)
import std.show (show)
import std.task
import std.time (seconds)
import std.udp
import std.udp (udp, Datagram)

effect set Sockets = {net.read[listener], net.write[listener], net.read[conn], net.write[conn], net.read[client], net.write[client]}

fn error_text(reason: Error) -> String =
  match reason {
    net::Rejected -> "refused",
    net::Unreachable -> "unreachable",
    net::TimedOut -> "timed out",
    net::Reset -> "reset",
    net::NameNotFound -> "no such name",
    net::AddressInUse -> "address in use",
    net::PermissionDenied -> "permission denied",
    net::Injected -> "injected",
    net::Untrusted -> "untrusted",
    net::Handshake(_) -> "handshake",
    net::Other(_, _) -> "other",
  }

fn opened_text(r: Result<Int, Error>) -> String =
  match r { Ok(_) -> "open", Err(reason) -> error_text(reason) }

fn set_text(r: Result<Unit, Error>) -> String =
  match r { Ok(_) -> "ok", Err(reason) -> error_text(reason) }

fn read_text(read: Option<Bytes>) -> String =
  match read { Some(b) -> "\"" ++ String::of_bytes_lossy(b) ++ "\"", None -> "a deadline" }

fn sent_text(sent: Option<Int>) -> String =
  match sent { Some(n) -> n.to_string(), None -> "a deadline" }

fn ip_text(end: Option<SocketAddress>) -> String =
  match end { Some(a) -> ip::render(ip::socket_ip(a)), None -> "none" }

fn first_difference(host: List<String>, fake: List<String>) -> Option<String> =
  range(0, max(host.len(), fake.len())).fold(None, |found: Option<String>, i: Int|
    match found {
      Some(_) -> found,
      None -> {
        let h = match host.at(i) { Some(l) -> l, None -> "(nothing)" };
        let t = match fake.at(i) { Some(l) -> l, None -> "(nothing)" };
        if h == t { None } else { Some("the host returned\n  " ++ h ++ "\nand the fake\n  " ++ t) }
      },
    })

fn assert_agree(host: List<String>, fake: List<String>) -> Unit / {abort.raise} =
  match first_difference(host, fake) { Some(reason) -> panic(reason), None -> () }

fn listen_at(
  text: String,
) -> { socket: Int, here: SocketAddress } / {Sockets, ip.fail, abort.raise} = {
  let socket = match net.listen_on[listener](ip::read_socket(text), []) {
    Ok(l) -> l,
    Err(reason) -> panic("no listener at " ++ text ++ ": " ++ error_text(reason)),
  };
  match net.local_address[listener](socket) {
    Some(here) -> { socket: socket, here: here },
    None -> panic("a listener has an address"),
  }
}

fn conversation() -> List<String> / {Sockets, ip.fail, abort.raise} = {
  let l = listen_at("127.0.0.1:0");
  let c = match net.connect_to[client](l.here, [], 5000) {
    Ok(c) -> c,
    Err(reason) -> panic("the listener rejected: " ++ error_text(reason)),
  };
  let s = net.accept[listener](l.socket);
  let sent = net.send[client](c, b"ping", 5000);
  let received = net.recv[conn](s, 64, 5000);
  net.close_write[client](c);
  let ended = net.recv[conn](s, 64, 5000);
  let after = net.send[client](c, b"more", 5000);
  let returned = net.send[conn](s, b"pong", 5000);
  let reply = net.recv[client](c, 64, 5000);
  let opened = net.options[client](c);
  let set = net.set_option[client](c, net::NoDelay(false));
  let lines = [
    "the listener is at " ++ ip_text(Some(l.here)),
    "its port is its address's: "
      ++ show(net.local_port[listener](l.socket) == Some(ip::socket_port(l.here))),
    "a client is seen from " ++ ip_text(net.peer_address[conn](s)),
    "the server sees the client's own end: "
      ++ show(net.peer_address[conn](s) == net.local_address[client](c)),
    "the client sees the listener's address: " ++ show(net.peer_address[client](c) == Some(l.here)),
    "an accepted connection is at the listener's address: "
      ++ show(net.local_address[conn](s) == Some(l.here)),
    "a listener's far end is " ++ ip_text(net.peer_address[listener](l.socket)),
    "no one owns the far end of a TCP connection: " ++ show(net.peer_credentials[conn](s) == None),
    "the client sent " ++ sent_text(sent) ++ " and the server read " ++ read_text(received),
    "after the client ends its sending the server reads " ++ read_text(ended),
    "and the client sends " ++ sent_text(after),
    "the server still sends " ++ sent_text(returned) ++ ", read as " ++ read_text(reply),
    "a connection opens sending small writes at once: "
      ++ show(opened.contains(net::NoDelay(true))),
    "setting an option returns " ++ set_text(set),
    "and it reads back: " ++ show(net.options[client](c).contains(net::NoDelay(false))),
    "a plaintext connection has a handshake to complete: "
      ++ show(net.handshake[client](c) != None),
    "a second listener at the address is " ++ opened_text(net.listen_on[listener](l.here, [])),
    "a listener beyond loopback is "
      ++ opened_text(net.listen_on[listener](ip::read_socket("192.0.2.1:8080"), [])),
  ];
  net.close[client](c);
  net.close[conn](s);
  net.close[listener](l.socket);
  lines.push(
    "once its listener is closed a connection there is "
      ++ opened_text(net.connect_to[client](l.here, [], 5000)),
  )
}

test/nondet "the network's fake handles a connection over loopback as the sockets do" {
  let host = conversation();
  assert_agree(host, net::on_mem(net::mem_empty(), || conversation()).value);
  assert_eq(host.at(2), Some("a client is seen from 127.0.0.1"));
  assert_eq(host.at(3), Some("the server sees the client's own end: true"))
}

test/nondet "over IPv6 loopback a connection's far end is `::1`, where the machine has IPv6" {
  match net.listen_on[listener](ip::read_socket("[::1]:0"), []) {
    Err(_) -> (),
    Ok(socket) -> {
      let here = match net.local_address[listener](socket) {
        Some(here) -> here,
        None -> panic("a listener has an address"),
      };
      let c = match net.connect_to[client](here, [], 5000) {
        Ok(c) -> c,
        Err(reason) -> panic("the listener rejected: " ++ error_text(reason)),
      };
      let s = net.accept[listener](socket);
      let seen = net.peer_address[conn](s);
      let own = net.local_address[client](c);
      net.close[client](c);
      net.close[conn](s);
      net.close[listener](socket);
      assert_eq(ip_text(seen), "::1");
      assert_eq(seen, own)
    },
  }
}

fn by_name() -> List<String> / {Sockets, dns.lookup, task.write, clock.read, clock.write, task::deadline.at, ip.fail, abort.raise} = {
  let l = listen_at("127.0.0.1:0");
  let found = dns::resolve("localhost", seconds(5));
  let dialled: Result<Int, Error> = try {
    net::dial[client]("localhost", ip::socket_port(l.here), [], 5000)
  };
  let foreign: Result<Int, Error> = try {
    net::dial[client]("b\u{fc}cher.example", ip::socket_port(l.here), [], 5000)
  };
  let lines = [
    "localhost resolves to loopback and nothing else: "
      ++ (match found {
        Ok(addresses) ->
          show(
            addresses.len() > 0
              && addresses.all(|f: dns::ResolvedAddress|
                ip::is_loopback(f.address) && f.ttl == None),
          ),
        Err(_) -> "no result",
      }),
    "an address written as text returns itself: "
      ++ show(dns.lookup("192.0.2.7") == Ok([{ address: ip::read("192.0.2.7"), ttl: None }])),
    "a name that is not ASCII is rejected and not looked up: "
      ++ show(dns.lookup("b\u{fc}cher.example") == Err(dns::not_ascii)),
    "the name dials the address that listens: "
      ++ (match dialled {
        Ok(c) -> ip_text(net.peer_address[client](c)),
        Err(reason) -> error_text(reason),
      }),
    "a name that is not ASCII dials nothing: " ++ opened_text(foreign),
  ];
  match dialled { Ok(c) -> net.close[client](c), Err(_) -> () };
  net.close[listener](l.socket);
  lines
}

test/nondet "looking up a name and connecting to it on the in-memory network behaves like the system resolver" {
  let host = task::unbounded(|| by_name());
  let names = dns::with_name(dns::table, "localhost", [ip::read("::1"), ip::read("127.0.0.1")]);
  assert_agree(
    host,
    net::on_mem(net::mem_resolving(net::mem_empty(), names), ||
      task::unbounded(|| by_name())).value,
  );
  assert_eq(host.at(2), Some("a name that is not ASCII is rejected and not looked up: true"));
  assert_eq(host.at(3), Some("the name dials the address that listens: 127.0.0.1"));
  assert_eq(host.at(4), Some("a name that is not ASCII dials nothing: other"))
}

const too_long: String = "the path is longer than a socket's address holds"

fn over_a_path() -> List<String> / {Sockets, abort.raise} =
  match net.listen_unix[listener]("scratch", "n/a.sock") {
    Err(net::Other(_, _)) -> [too_long],
    Err(reason) -> panic("no listener at the path: " ++ error_text(reason)),
    Ok(l) -> {
      let twice = net.listen_unix[listener]("scratch", "n/a.sock");
      let c = match net.connect_unix[client]("scratch", "n/a.sock", 5000) {
        Ok(c) -> c,
        Err(reason) -> panic("the listener rejected: " ++ error_text(reason)),
      };
      let s = net.accept[listener](l);
      let sent = net.send[client](c, b"over a path", 5000);
      let received = net.recv[conn](s, 64, 5000);
      let lines = [
        "a second listener at the path is " ++ opened_text(twice),
        "the client sent " ++ sent_text(sent) ++ " and the server read " ++ read_text(received),
        "neither end has an address: " ++ ip_text(net.peer_address[conn](s)) ++ " and "
          ++ ip_text(net.local_address[client](c)),
        "the listener has no port: " ++ show(net.local_port[listener](l) == None),
      ];
      net.close[client](c);
      net.close[conn](s);
      net.close[listener](l);
      let nobody = net.connect_unix[client]("scratch", "n/a.sock", 5000);
      let again = net.listen_unix[listener]("scratch", "n/a.sock");
      match again { Ok(second) -> net.close[listener](second), Err(_) -> () };
      lines.concat([
        "with its listener closed the path is " ++ opened_text(nobody),
        "and free to be listened at again: " ++ opened_text(again),
      ])
    },
  }

test/nondet "the in-memory network handles a Unix socket at a path under a scratch directory like the real filesystem" {
  scratch::fresh();
  assert(fs.create_dir[scratch]("n"));
  let host = over_a_path();
  if host == [too_long] { () }
  else { assert_agree(host, net::on_mem(net::mem_empty(), || over_a_path()).value) };
  assert(!fs.exists[scratch]("n/a.sock"), Some("a closed listener leaves no socket behind"))
}

test/nondet "the far end of a Unix socket has an owner" {
  scratch::fresh();
  assert(fs.create_dir[scratch]("n"));
  match net.listen_unix[listener]("scratch", "n/o.sock") {
    Err(net::Other(_, _)) -> (),
    Err(reason) -> panic("no listener at the path: " ++ error_text(reason)),
    Ok(l) -> {
      let c = match net.connect_unix[client]("scratch", "n/o.sock", 5000) {
        Ok(c) -> c,
        Err(reason) -> panic("the listener rejected: " ++ error_text(reason)),
      };
      let s = net.accept[listener](l);
      let owner = net.peer_credentials[conn](s);
      net.close[client](c);
      net.close[conn](s);
      net.close[listener](l);
      assert(owner != None, Some("the client is this process, which has a user"))
    },
  }
}

fn datagram_text(received: Result<Datagram, Error>, sender: Option<SocketAddress>) -> String =
  match received {
    Ok(d) ->
      "\"" ++ String::of_bytes_lossy(d.payload) ++ "\""
        ++ (if Some(d.from) == sender { " from its sender" } else { " from elsewhere" })
        ++ (if d.truncated { ", cut" } else { ", whole" }),
    Err(reason) -> error_text(reason),
  }

fn count_text(sent: Result<Int, Error>) -> String =
  match sent { Ok(n) -> n.to_string(), Err(reason) -> error_text(reason) }

fn datagram_socket<[l]>(text: String) -> Int / {udp.bind[l], ip.fail, abort.raise} =
  match udp.bind[l](ip::read_socket(text), []) {
    Ok(socket) -> socket,
    Err(reason) -> panic("no socket at " ++ text ++ ": " ++ error_text(reason)),
  }

fn datagrams() -> List<String> / {udp.read[near], udp.write[near], udp.read[far], udp.write[far], ip.fail, abort.raise} = {
  let near = datagram_socket[near]("127.0.0.1:0");
  let far = datagram_socket[far]("127.0.0.1:0");
  let from = udp.local_address[near](near);
  let to = match udp.local_address[far](far) {
    Some(to) -> to,
    None -> panic("a bound socket has an address"),
  };
  let long = udp.send_to[near](near, to, b"0123456789", 5000);
  let cut = udp.recv_from[far](far, 4, 5000);
  let short = udp.send_to[near](near, to, b"abcd", 5000);
  let whole = udp.recv_from[far](far, 4, 5000);
  let quiet = udp.recv_from[far](far, 64, 50);
  let fixed = udp.connect[near](near, to);
  let direct = udp.send[near](near, b"hello", 5000);
  let received = udp.recv_from[far](far, 64, 5000);
  let allowed = udp.set_option[near](near, net::Broadcast(true));
  let lines = [
    "both sockets are at " ++ ip_text(from) ++ " and " ++ ip_text(Some(to)),
    "sent " ++ count_text(long) ++ " and received " ++ datagram_text(cut, from),
    "sent " ++ count_text(short) ++ " and received " ++ datagram_text(whole, from),
    "nothing more arrives: " ++ datagram_text(quiet, from),
    "a socket's far end is fixed: " ++ set_text(fixed),
    "and it sends there, " ++ count_text(direct) ++ ", received as "
      ++ datagram_text(received, from),
    "broadcast is set: " ++ set_text(allowed) ++ ", and reads back: "
      ++ show(udp.options[near](near).contains(net::Broadcast(true))),
    "a second socket at the address is " ++ opened_text(udp.bind[far](to, [])),
    "a socket at every address and a port is "
      ++ opened_text(udp.bind[far](ip::read_socket("0.0.0.0:5353"), [])),
  ];
  udp.close[near](near);
  udp.close[far](far);
  lines
}

test/nondet "the datagram fake behaves as loopback does" {
  let host = datagrams();
  assert_agree(host, udp::on_mem(udp::mem_empty(), || datagrams()).value);
  assert_eq(host.at(1), Some("sent 10 and received \"0123\" from its sender, cut"))
}
