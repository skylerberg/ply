import std.bytes
import std.list
import std.xml
import std.xml (CommentOrInstruction, Attribute, BadAttribute, BadMarkup, BadName, BadReference,
                BadTag, Binding, CDataEnd, Characters, Comment, Compact, Doctype, DoubleHyphen,
                DuplicateAttribute, Encoding, EndElement, Event, IllegalChar, IllegalReference,
                Instruction, LessThanInValue, Mismatched, Name, NotUtf8, OutsideRoot, Start,
                StartElement, Truncated, UnknownEntity, ErrorKind, XmlDeclaration, xml)

type Case = { name: String, bytes: Bytes }

type WellFormedCase = { name: String, bytes: Bytes, canonical: Option<Bytes> }

type HandWrittenCase = { name: String, text: Bytes, reason: ErrorKind }

const not_wf_plain: List<Case> = embed_dir("xml/not_wf/plain")

const not_wf_cut: List<Case> = embed_dir("xml/not_wf/cut")

const not_wf_declared: List<Case> = embed_dir("xml/not_wf/declared")

const wf_plain: List<WellFormedCase> = with_canonical(embed_dir("xml/wf/plain"))

const wf_cut: List<WellFormedCase> = with_canonical(embed_dir("xml/wf/cut"))

const wf_declared: List<Case> = embed_dir("xml/wf/declared")

const wf_encoded: List<Case> = embed_dir("xml/wf/encoded")

const wf_unnamespaced: List<Case> = embed_dir("xml/wf/unnamespaced")

const canonical_forms: Map<String, Bytes> = {
  let forms: List<Case> = embed_dir("xml/canonical");
  Map::of_entries(forms.map(|c: Case| { key: c.name, value: c.bytes }))
}

fn with_canonical(cases: List<Case>) -> List<WellFormedCase> = {
  let forms = canonical_forms;
  cases.map(|c: Case| { name: c.name, bytes: c.bytes, canonical: forms.get(c.name) })
}

const own_cases: List<HandWrittenCase> =
  [
    { name: "an attribute with no value", text: b"<a b></a>", reason: BadAttribute },
    {
      name: "an attribute with an equals sign and no value",
      text: b"<a b=></a>",
      reason: BadAttribute,
    },
    { name: "a value with no quotes", text: b"<a b=c></a>", reason: BadAttribute },
    { name: "a less-than sign before a space in text", text: b"<a>1 < 2</a>", reason: BadMarkup },
    {
      name: "a quoted value with no name before it",
      text: b"<a b=\"1\" \"2\"></a>",
      reason: BadName,
    },
    { name: "an instruction with no target", text: b"<a><? ?></a>", reason: BadName },
    {
      name: "a question mark where an attribute's name stands",
      text: b"<a ?></a>",
      reason: BadName,
    },
    { name: "an attribute named from a digit", text: b"<a 1b=\"c\"/>", reason: BadName },
    {
      name: "an ampersand and a name with no semicolon, in a value",
      text: b"<a b=\"c&d\"/>",
      reason: BadReference,
    },
    {
      name: "a numbered reference ended by a colon",
      text: b"<a b=\"&#65:\"/>",
      reason: BadReference,
    },
    { name: "an entity named from a full stop", text: b"<a>&.b;</a>", reason: BadReference },
    {
      name: "an entity reference with a space for its semicolon",
      text: b"<a>&amp b</a>",
      reason: BadReference,
    },
    { name: "an ampersand alone in text", text: b"<a>b & c</a>", reason: BadReference },
    { name: "an ampersand alone in a value", text: b"<a b=\"c & d\"/>", reason: BadReference },
    {
      name: "an empty-element tag cut short by another tag",
      text: b"<a><b/</b></a>",
      reason: BadTag,
    },
    { name: "an empty-element tag cut short by a line end", text: b"<a><b/\n</a>", reason: BadTag },
    { name: "attributes with no space between", text: b"<a b=\"1\"c=\"2\"/>", reason: BadTag },
    {
      name: "a space inside the end of an empty-element tag",
      text: b"<a><b / ></a>",
      reason: BadTag,
    },
    {
      name: "a CDATA end as the whole of an element's text",
      text: b"<a>]]></a>",
      reason: CDataEnd,
    },
    {
      name: "three brackets and a greater-than sign in text",
      text: b"<a>b]]]>c</a>",
      reason: CDataEnd,
    },
    { name: "two hyphens inside a comment", text: b"<a><!-- b -- c --></a>", reason: DoubleHyphen },
    { name: "a comment ended by three hyphens", text: b"<!-- b ---><a/>", reason: DoubleHyphen },
    {
      name: "an attribute written twice with another between",
      text: b"<a b=\"1\" c=\"2\" b=\"3\"/>",
      reason: DuplicateAttribute("b"),
    },
    {
      name: "U+FFFF in a comment",
      text: b"<!-- \xef\xbf\xbf --><a/>",
      reason: IllegalChar(0xFFFF),
    },
    { name: "U+FFFF in a value", text: b"<a b=\"\xef\xbf\xbf\"/>", reason: IllegalChar(0xFFFF) },
    { name: "U+FFFF in text", text: b"<a>b\xef\xbf\xbf</a>", reason: IllegalChar(0xFFFF) },
    {
      name: "U+FFFF in a CDATA section",
      text: b"<a><![CDATA[\xef\xbf\xbf]]></a>",
      reason: IllegalChar(0xFFFF),
    },
    {
      name: "U+FFFF in an instruction",
      text: b"<?b \xef\xbf\xbf?><a/>",
      reason: IllegalChar(0xFFFF),
    },
    { name: "a form feed in text", text: b"<a>b\x0cc</a>", reason: IllegalChar(12) },
    { name: "a form feed in an instruction", text: b"<?b c\x0cd?><a/>", reason: IllegalChar(12) },
    { name: "a form feed in a comment", text: b"<!--b\x0cc--><a/>", reason: IllegalChar(12) },
    {
      name: "a form feed for the space in a tag",
      text: b"<a\x0cb=\"c\"/>",
      reason: IllegalChar(12),
    },
    { name: "an escape character in text", text: b"<a>b\x1bc</a>", reason: IllegalChar(27) },
    {
      name: "a reference to a surrogate",
      text: b"<a>&#xD800;</a>",
      reason: IllegalReference(0xD800),
    },
    { name: "a value closed by the other quote", text: b"<a b=\"c'></a>", reason: LessThanInValue },
    {
      name: "a value closed by a reference to its quote",
      text: b"<a b=\"&#34;></a>",
      reason: LessThanInValue,
    },
    { name: "a tag in a value", text: b"<a b=\"<c>\"/>", reason: LessThanInValue },
    {
      name: "an end tag for an element never opened, after an empty CDATA section",
      text: b"<a><![CDATA[]]></b></a>",
      reason: Mismatched("a"),
    },
    {
      name: "four bytes that encode past U+10FFFF",
      text: b"<a>\xf7\x80\x80\x80</a>",
      reason: NotUtf8,
    },
    { name: "an end tag after an empty-element root", text: b"<a/></a>", reason: OutsideRoot },
    { name: "a CDATA section never closed", text: b"<a><![CDATA[b</a>", reason: Truncated },
    {
      name: "an instruction ended by a greater-than sign alone",
      text: b"<a><?b c></a>",
      reason: Truncated,
    },
    {
      name: "an instruction ended by a question mark alone",
      text: b"<a><?b c?</a>",
      reason: Truncated,
    },
    {
      name: "an entity nothing declares, in text",
      text: b"<a>&b;</a>",
      reason: UnknownEntity("b"),
    },
    {
      name: "an entity nothing declares, in a value",
      text: b"<a c=\"&b;\"/>",
      reason: UnknownEntity("b"),
    },
  ]

const limits: xml::Limits = xml::default_limits

fn error_kind(data: Bytes) -> Option<ErrorKind> / {abort.raise} =
  match xml::parse(data, limits) { Ok(_) -> None, Err(rejection) -> Some(rejection.reason) }

fn is_rejected(data: Bytes) -> Bool / {abort.raise} = error_kind(data) != None

fn without_doctype(data: Bytes) -> Bytes / {abort.raise} =
  match data.index_of(b"<!DOCTYPE") {
    None -> data,
    Some(i) -> {
      let n = data.len();
      let opening = match data.index_of_from(b"[", i) { Some(at) -> at, None -> n };
      let closing = match data.index_of_from(b">", i) { Some(at) -> at, None -> n };
      let end = if opening < closing {
        match data.index_of_from(b"]", opening) {
          Some(at) -> data.skip(at + 1, b" \t\n\r") + 1,
          None -> n,
        }
      } else { closing + 1 };
      data.slice(0, i).concat(data.slice(min(end, n), n))
    },
  }

fn canonical_escape(text: String) -> Bytes =
  [
    { raw: b"&", written: b"&amp;" },
    { raw: b"<", written: b"&lt;" },
    { raw: b">", written: b"&gt;" },
    { raw: b"\"", written: b"&quot;" },
    { raw: b"\t", written: b"&#9;" },
    { raw: b"\n", written: b"&#10;" },
    { raw: b"\r", written: b"&#13;" },
  ].fold(Bytes::of_string(text), |b: Bytes, e: { raw: Bytes, written: Bytes }|
    b.replace(e.raw, e.written))

fn qualified_name(n: Name) -> String =
  if xml::spelling_value(n.prefix) == "" { n.local }
  else { xml::spelling_value(n.prefix) ++ ":" ++ n.local }

fn start_tag(s: Start) -> Bytes = {
  let declared = s.declared.map(|b: Binding|
    (if b.prefix == "" { "xmlns" } else { "xmlns:" ++ b.prefix }, b.namespace));
  let attributes = s.attributes.map(|a: Attribute| (qualified_name(a.name), a.value));
  Bytes::concat_all([
    b"<",
    Bytes::of_string(qualified_name(s.name)),
    Bytes::concat_all(
      attributes.fold(declared, |all: List<(String, String)>, a: (String, String)|
        all.push(a)).sort(
      ).map(|a: (String, String)|
        Bytes::concat_all([b" ", Bytes::of_string(a._0), b"=\"", canonical_escape(a._1), b"\""])),
    ),
    b">",
  ])
}

fn canonical(data: Bytes) -> Bytes / {xml.fail, abort.raise} =
  Bytes::concat_all(
    xml::events(data, limits).map(|e: Event|
      match e {
        XmlDeclaration(_) -> b"",
        StartElement(s) -> start_tag(s),
        EndElement(n) -> Bytes::concat_all([b"</", Bytes::of_string(qualified_name(n)), b">"]),
        Characters(text) -> canonical_escape(text),
        CommentOrInstruction(Comment(_)) -> b"",
        CommentOrInstruction(Instruction(target, text)) ->
          Bytes::concat_all([b"<?", Bytes::of_string(target), b" ", Bytes::of_string(text), b"?>"]),
      }),
  )

fn round_trips(data: Bytes) -> Bool / {abort.raise} =
  match xml::parse(data, limits) {
    Err(_) -> false,
    Ok(d) -> match xml::encode(d, Compact) {
      Err(_) -> false,
      Ok(written) -> match xml::parse(written, limits) {
        Err(_) -> false,
        Ok(again) -> again == d && xml::encode(again, Compact) == Ok(written),
      },
    },
  }

fn check_canonical(data: Bytes, expected: Option<Bytes>) -> Unit / {abort.raise} =
  match expected { Some(form) -> assert_eq(try { canonical(data) }, Ok(form)), None -> () }

test "rejects {c.name}" for c: Case in not_wf_plain { assert(is_rejected(c.bytes)) }

test "rejects {c.name} when it has a document type declaration" for c: Case in not_wf_declared {
  assert(is_rejected(c.bytes))
}

test "rejects {c.name} both with its document type declaration and with the declaration removed" for c: Case in not_wf_cut {
  assert(is_rejected(c.bytes));
  assert(is_rejected(without_doctype(c.bytes)))
}

test "rejects the hand-written malformed document {c.name} with the expected error" for c: HandWrittenCase in own_cases {
  assert_eq(error_kind(c.text), Some(c.reason))
}

test "parses {c.name} like the reference parser, and encoding the result and parsing it again gives the same document" for c: WellFormedCase in wf_plain {
  assert_eq(error_kind(c.bytes), None);
  assert(round_trips(c.bytes));
  check_canonical(c.bytes, c.canonical)
}

test "rejects the declaration of {c.name}" for c: Case in wf_declared {
  assert_eq(error_kind(c.bytes), Some(Doctype))
}

test "rejects {c.name} because of its document type declaration, and parses it like the reference parser once that declaration is removed" for c: WellFormedCase in wf_cut {
  assert_eq(error_kind(c.bytes), Some(Doctype));
  assert_eq(error_kind(without_doctype(c.bytes)), None);
  assert(round_trips(without_doctype(c.bytes)));
  check_canonical(without_doctype(c.bytes), c.canonical)
}

test "rejects the encoding of {c.name}" for c: Case in wf_encoded {
  assert(match error_kind(c.bytes) { Some(Encoding(_)) -> true, _ -> false })
}

test "rejects {c.name}, which is not valid once XML namespaces are applied" for c: Case in wf_unnamespaced {
  assert(is_rejected(c.bytes))
}
