import std.coding
import std.fs
import std.fs (fs)
import std.gzip
import std.http
import std.http (Request, Response)
import std.ip
import std.ip (ip)
import std.list
import std.net
import std.net (Sends, net)
import std.random (entropy, rand, with_rand)
import std.date
import std.static

fn text(n: Int) -> Bytes / {abort.raise} =
  Bytes::concat_all(
    range(0, n / 24 + 1).map(|i: Int|
      Bytes::of_string("line " ++ Int::to_string(i * 7919) ++ " of the file\n")),
  ).slice(
    0,
    n,
  )

fn client_address() -> ip::SocketAddress / {ip.fail, abort.raise} =
  ip::read_socket("198.51.100.4:5000")

const fixed_time: date::OffsetDateTime =
  match date::of_unix_seconds(1700000100) { Some(o) -> o, None -> panic("a date") }

fn serve_requests(
  requests: List<Bytes>,
  app: http::Handler<| {fs.read_chunk[site], fs.read_at[site], fs.close[site], fs.kind[site], fs.stat[site], fs.open[site], entropy.next}>,
  tree: fs::MemFs,
) -> { out: Bytes, unread: Int } / {ip.fail, abort.raise} = {
  let ran = net::on_mem(
    net::mem_calling(net::mem_empty(), client_address(), requests.map(|b: Bytes| Sends(b))),
    ||
      with_rand(rand(7), ||
        fs::on_mem[site](tree, || {
          let listener = net.listen[listener](0);
          http::serve_connection[conn](net.accept[listener](listener), http::default_limits, app)
        }).value).value,
  );
  { out: net::mem_sent(ran.net, 2), unread: net::mem_remaining_script(ran.net, 2).len() }
}

test "a file served gzip-coded is a stream of chunks that decodes to the file" {
  let file = text(3000000);
  let tree = fs::mem_of([{ path: "data.txt", body: file }]);
  let back = serve_requests(
    [b"GET /data.txt HTTP/1.1\r\nHost: x\r\nAccept-Encoding: gzip\r\nConnection: close\r\n\r\n"],
    |request: Request|
      coding::serving(request, 1048576, |plain: Request|
        static::serve[site](
          plain,
          plain.path,
          { ..static::default_options, chunk: 65536 },
          fixed_time,
        )),
    tree,
  );
  let head = match http::parse_response_head(back.out, http::Get, http::default_limits) {
    http::ResponseParsed(h) -> h,
    _ -> panic("an answer"),
  };
  assert_eq(head.status, 200);
  assert_eq(head.framing, http::Chunked);
  assert_eq(http::header(head.headers, "content-encoding"), Some("gzip"));
  assert_eq(http::header(head.headers, "content-length"), None);
  let body = back.out.slice(head.consumed, back.out.len());
  let limits = { ..http::default_limits, max_body: 4000000, max_chunk_size: 4000000 };
  let coded = iterate(
    { state: http::body_start(http::Chunked, limits), at: 0, out: [] },
    100000,
    |s: { state: http::BodyState, at: Int, out: List<Bytes> }|
      match http::body_step(s.state, body.slice(s.at, body.len())) {
        http::Complete(done) -> Stop(Bytes::concat_all(s.out.push(done.out))),
        http::Await(step) ->
          Continue({ state: step.state, at: s.at + step.consumed, out: s.out.push(step.out) }),
        http::Rejected(r) -> panic(r.reason),
      },
  );
  assert(coded.len() < file.len() / 2);
  assert(gzip::gunzip(coded, file.len()) == file)
}

test "a gzip request body that would decode past its size limit is rejected at the limit without reading the rest of the compressed body" {
  let four_k = Bytes::of_string(
    range(0, 1024).fold("", |accumulator: String, _i: Int| accumulator ++ "0000"),
  );
  let coded = gzip::gzip(Bytes::concat_all(range(0, 1024).map(|_i: Int| four_k)));
  let pieces = range(0, coded.len() / 512 + 1).map(|i: Int|
    http::encode_chunk(coded.slice(min(i * 512, coded.len()), min((i + 1) * 512, coded.len()))));
  let back = serve_requests(
    [
      b"POST /upload HTTP/1.1\r\nHost: x\r\nContent-Encoding: gzip\r\nTransfer-Encoding: chunked\r\n\r\n",
    ].concat(
      pieces.concat([http::last_chunk]),
    ),
    |request: Request|
      coding::serving(request, 65536, |plain: Request| {
        let body = http::request_body(plain, 16777216);
        http::text_response(200, body.len().to_string() ++ " bytes\n")
      }),
    fs::mem_empty(),
  );
  assert(String::of_bytes_lossy(back.out).starts_with("HTTP/1.1 413 Content Too Large\r\n"));
  assert(String::of_bytes_lossy(back.out).ends_with("the body decodes to more than 65536 bytes\n"));
  assert(
    back.unread > pieces.len() / 2,
    Some(back.unread.to_string() ++ " of " ++ pieces.len().to_string()),
  )
}
