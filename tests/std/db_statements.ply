//! Statements `ply check` cannot read, because their text is a parameter of the function that
//! performs them, refused by `std.db`'s driver before it takes a connection: a write performed as a
//! read, and a statement whose tables do not include its call's label.

import std.db
import std.db (db)
import std.net
import std.sql (stmt, IntParameter, TextParameter)
import std.string

/// Why the driver would not serve `body`, over a network where nothing listens.
fn error_message<a>(body: () -> a / {db.read[*], db.write[*]}) -> String / {abort.raise, diverges} = {
  let server = db::server("127.0.0.1", 5432, "ply", "ply", None);
  let served = try[abort.raise] {
    net::on_mem(net::mem_empty(), || db::serve(server, 4, "t", body)).value
  };
  match served { Ok(_) -> panic("the driver served the statement"), Err(reason) -> reason }
}

fn read_from_items(text: String) -> String / {abort.raise, diverges} =
  error_message(|| db.query[items](stmt(text), [IntParameter(1), TextParameter("x")]))

fn read_from_orders(text: String) -> String / {abort.raise, diverges} =
  error_message(|| db.query[orders](stmt(text), [IntParameter(7)]))

test "a write performed as a read is refused" {
  let reason = read_from_items("insert into items (id, name) values ($1, $2)");
  assert(reason.contains("writes") && reason.contains("db.query"), Some(reason))
}

test "a label the statement does not touch is refused" {
  let reason = read_from_orders("select name from items where id = $1");
  assert(reason.contains("names `orders`") && reason.contains("items"), Some(reason))
}
