//! `std.xz` against files the reference tool wrote. `xz/` holds what `xz` 5.8.2 made of the
//! samples `packed_samples` makes, each named for its sample and how it was packed: at presets 0,
//! 2, 6 and 9 extreme, with each check the format defines a sum for (`--check=none`, `crc32`,
//! `sha256`, and CRC-64 where none is named), in blocks of 40000 bytes (`--block-size`) and by
//! two threads, with a dictionary of 4 KiB and with every literal and position setting LZMA has
//! (`lc`, `lp`, `pb`), with the longest match (`nice=273`), and, as files a reader names and
//! rejects, through the x86, ARM64 and delta filters. A shipped module embeds no file, so the
//! tests that read files stand here.

import packed_samples (sample)
import std.seq
import std.seq (seq)
import std.xz
import std.xz (xz, Limits, Error)
import std.value (reflect)

type File = { name: String, bytes: Bytes }

fn files() -> List<File> = embed_dir("xz")

fn file(name: String) -> Bytes / {abort.raise} =
  match files().filter(|f: File| f.name == name) {
    [found, ..] -> found.bytes,
    [] -> panic(f"no file {name}"),
  }

/// The sample a packed file was made of, which its name opens with.
fn uncompressed_of(name: String) -> Bytes / {abort.raise} =
  match name.split(".") { [stem, ..] -> sample(stem), [] -> panic("no name") }

fn compressed_files() -> List<File> = files().filter(|f: File| f.name.ends_with(".xz"))

/// Room for the 64 MiB dictionary the ninth preset asks for.
fn large_limits() -> Limits = { output: 1000000, window: 67108864 }

fn outcome(got: Result<Bytes, Error>, want: Bytes) -> String =
  match got {
    Ok(b) -> if b == want { "same" } else { f"differs: {b.len()} bytes for {want.len()}" },
    Err(r) -> f"rejected at {r.at}: {reflect(r.reason)}",
  }

test "{f.name} unpacks to its sample" for f: File in compressed_files() {
  assert_eq(outcome(xz::try_decompress(f.bytes, large_limits()), uncompressed_of(f.name)), "same")
}

/// What `compressed_files` unpacks to, read `size` bytes at a time.
fn decompress_in_chunks(
  compressed_files: Bytes,
  size: Int,
  limits: Limits,
) -> Bytes / {xz.fail, seq.spent, abort.raise} =
  Bytes::concat_all(
    seq::to_list(xz::decompress_stream(seq::slices(compressed_files, size), limits), 10000000),
  )

test "{f.name} unpacks the same a chunk at a time, whatever the chunk" for f: File in compressed_files(
  ) {
  let whole = uncompressed_of(f.name);
  assert(decompress_in_chunks(f.bytes, 100000, large_limits()) == whole);
  assert(decompress_in_chunks(f.bytes, 4099, large_limits()) == whole);
  assert(f.bytes.len() > 3000 || decompress_in_chunks(f.bytes, 1, large_limits()) == whole)
}

test "streams one after another are one file, with zeros in fours between and after them" {
  let both = sample("brief").concat(sample("one"));
  let a = file("brief.l6.xz");
  let b = file("one.l6.xz");
  let n = a.len();
  assert_eq(outcome(xz::try_decompress(a.concat(b), large_limits()), both), "same");
  let padded = Bytes::concat_all([a, b"\x00\x00\x00\x00", b, b"\x00\x00\x00\x00\x00\x00\x00\x00"]);
  assert_eq(outcome(xz::try_decompress(padded, large_limits()), both), "same");
  assert(decompress_in_chunks(padded, 3, large_limits()) == both);
  assert_eq(
    xz::try_decompress(Bytes::concat_all([a, b"\x00\x00\x00", b]), large_limits()),
    Err({ at: n, reason: xz::Trailing }),
  );
  let first = xz::decompress_first(a.concat(b"more"), large_limits());
  assert_eq(first.plain, sample("brief"));
  assert_eq(first.used, n)
}

test "{c.name} is rejected by its filter's number" for c: { name: String, reason: xz::ErrorKind } in [
    { name: "records.x86.refused", reason: xz::Filter(4) },
    { name: "records.delta.refused", reason: xz::Filter(3) },
    { name: "records.arm64.refused", reason: xz::Filter(10) },
  ] {
  assert_eq(xz::try_decompress(file(c.name), large_limits()), Err({ at: 12, reason: c.reason }))
}

test "a dictionary past the window is rejected before a chunk is read, and an output past the limit where it would be passed" {
  let asks = file("prose.l9sha.xz");
  let narrow: Limits = { output: 1000000, window: 67108863 };
  assert_eq(xz::try_decompress(asks, narrow), Err({ at: 12, reason: xz::Window }));
  // The stream header and the first block's header alone, which the byte at 12 sizes, are rejected
  // alike.
  assert_eq(
    xz::try_decompress(asks.slice(0, 12 + (asks.at(12) + 1) * 4), narrow),
    Err({ at: 12, reason: xz::Window }),
  );
  assert(match xz::try_decompress(file("long.blocks.xz"), { output: 149999, window: 67108864 }) {
    Err(r) -> r.reason == xz::OverLimit,
    Ok(_) -> false,
  })
}
