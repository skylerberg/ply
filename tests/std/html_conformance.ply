import std.html
import std.html (Attribute, Lexeme, Start, Token)
import std.json
import std.json (Json)
import std.list
import std.utf16

type File = { name: String, bytes: Bytes }

fn files() -> List<File> = embed_dir("html5lib/tokenizer")

type Run = {
  file: String,
  description: String,
  input: String,
  state: String,
  last: Option<String>,
  output: Json,
  errors: List<String>,
}

type SkippedTest = { file: String, description: String, reason: String }

type TestSet = { runs: List<Run>, skipped: List<SkippedTest> }

fn text_of(j: Json, name: String) -> Option<String> =
  match json::get(j, name) { Some(json::Str(s)) -> Some(s), _ -> None }

fn hex_digit(c: Char) -> Int = {
  let n = Int::of_char(c);
  if n >= 48 && n <= 57 { n - 48 }
  else if n >= 97 && n <= 102 { n - 87 }
  else if n >= 65 && n <= 70 { n - 55 }
  else { -1 }
}

type UnescapeState = { units: List<Int>, skip: Int }

fn double_unescaped(s: String) -> Option<String> = {
  let chars = Array::of_list(s.chars());
  let read = range(0, chars.len()).fold({ units: [], skip: 0 }, |u: UnescapeState, i: Int|
    if u.skip > 0 { { ..u, skip: u.skip - 1 } }
    else if chars.at(i) == Some('\\') && chars.at(i + 1) == Some('u') && i + 5 < chars.len() {
      let digits = range(i + 2, i + 6).map(|k: Int|
        match chars.at(k) { Some(c) -> hex_digit(c), None -> -1 });
      if digits.fold(true, |ok: Bool, d: Int| ok && d >= 0) {
        { units: u.units.push(digits.fold(0, |n: Int, d: Int| n * 16 + d)), skip: 5 }
      } else { { ..u, units: concat_units(u.units, chars, i) } }
    } else { { ..u, units: concat_units(u.units, chars, i) } });
  match try { utf16::of_units(read.units) } { Ok(text) -> Some(text), Err(_) -> None }
}

fn concat_units(units: List<Int>, chars: Array<Char>, i: Int) -> List<Int> =
  match chars.at(i) {
    Some(c) ->
      utf16::units(String::of_chars([c])).fold(units, |all: List<Int>, unit: Int| all.push(unit)),
    None -> units,
  }

fn unescaped_json(j: Json) -> Option<Json> / {abort.raise} =
  match j {
    json::Str(s) -> match double_unescaped(s) { Some(t) -> Some(json::Str(t)), None -> None },
    json::Array(items) -> {
      let each = items.map(unescaped_json);
      if each.fold(true, |ok: Bool, x: Option<Json>| ok && x != None) {
        Some(json::Array(each.map(|x: Option<Json>| match x { Some(v) -> v, None -> json::Null })))
      } else { None }
    },
    json::Object(members) -> {
      let pairs = members.entries().map(|m: { key: String, value: Json }|
        match ((double_unescaped(m.key), unescaped_json(m.value))) {
          (Some(k), Some(v)) -> Some({ key: k, value: v }),
          _ -> None,
        });
      if pairs.fold(true, |ok: Bool, x: Option<{ key: String, value: Json }>| ok && x != None) {
        Some(
          json::Object(
            Map::of_entries(
              pairs.map(|x: Option<{ key: String, value: Json }>|
                match x { Some(p) -> p, None -> { key: "", value: json::Null } }),
            ),
          ),
        )
      } else { None }
    },
    _ -> Some(j),
  }

fn current_code(code: String) -> String =
  if code == "unexpected-question-mark-instead-of-tag-name" {
    "invalid-first-character-of-processing-instruction-target"
  } else { code }

fn codes(listed: Json) -> List<String> =
  match json::get(listed, "errors") {
    Some(json::Array(errors)) ->
      errors.map(|e: Json|
        match text_of(e, "code") { Some(c) -> current_code(c), None -> "" }).sort(
      ),
    _ -> [],
  }

fn states(listed: Json) -> List<String> =
  match json::get(listed, "initialStates") {
    Some(json::Array(names)) -> names.map(|n: Json| match n { json::Str(s) -> s, _ -> "" }),
    _ -> ["Data state"],
  }

fn test_runs(file: String, listed: Json) -> TestSet / {abort.raise} = {
  let description = match text_of(listed, "description") { Some(d) -> d, None -> "" };
  let doubled = json::get(listed, "doubleEscaped") == Some(json::Bool(true));
  let input = match text_of(listed, "input") {
    Some(s) -> if doubled { double_unescaped(s) } else { Some(s) },
    None -> None,
  };
  let output = match json::get(listed, "output") {
    Some(o) -> if doubled { unescaped_json(o) } else { Some(o) },
    None -> None,
  };
  match ((input, output)) {
    (Some(text), Some(expected)) ->
      {
        runs: states(listed).map(|state: String|
          {
            file: file,
            description: description,
            input: text,
            state: state,
            last: text_of(listed, "lastStartTag"),
            output: expected,
            errors: codes(listed),
          }),
        skipped: [],
      },
    _ ->
      { runs: [], skipped: [{ file: file, description: description, reason: "a lone surrogate" }] },
  }
}

fn read_file(f: File) -> TestSet / {abort.raise} =
  match json::parse(f.bytes) {
    Ok(json::Object(top)) -> match top.get("tests") {
      Some(json::Array(tests)) ->
        tests.fold({ runs: [], skipped: [] }, |r: TestSet, t: Json| {
          let more = test_runs(f.name, t);
          { runs: r.runs.concat(more.runs), skipped: r.skipped.concat(more.skipped) }
        }),
      _ -> match top.get("xmlViolationTests") {
        Some(json::Array(tests)) ->
          {
            runs: [],
            skipped: tests.map(|t: Json|
              {
                file: f.name,
                description: match text_of(t, "description") { Some(d) -> d, None -> "" },
                reason: "the infoset coercion",
              }),
          },
        _ -> panic(f.name ++ " holds no tests"),
      },
    },
    _ -> panic(f.name ++ " is no JSON object"),
  }

fn suite() -> TestSet / {abort.raise} =
  files().fold({ runs: [], skipped: [] }, |r: TestSet, f: File| {
    let more = read_file(f);
    { runs: r.runs.concat(more.runs), skipped: r.skipped.concat(more.skipped) }
  })

type Block = { file: String, from: Int, runs: List<Run> }

fn blocks() -> List<Block> / {abort.raise} =
  files().fold([], |found: List<Block>, f: File| {
    let pieces = read_file(f).runs.chunks(50);
    range(0, pieces.len()).fold(found, |b: List<Block>, i: Int|
      b.push({ file: f.name, from: i * 50, runs: pieces.at_or(i, []) }))
  })

fn state_of(name: String) -> html::State =
  if name == "PLAINTEXT state" { html::Plaintext }
  else if name == "RCDATA state" { html::Rcdata }
  else if name == "RAWTEXT state" { html::Rawtext }
  else if name == "Script data state" { html::ScriptData }
  else if name == "CDATA section state" { html::CdataSection }
  else { html::Data }

fn string_or_null(s: Option<String>) -> Json =
  match s { Some(t) -> json::Str(t), None -> json::Null }

fn token_json(t: Token) -> Option<Json> =
  match t {
    html::Doctype(d) ->
      Some(
        json::Array([
          json::Str("DOCTYPE"),
          string_or_null(d.name),
          string_or_null(d.public_id),
          string_or_null(d.system_id),
          json::Bool(!d.force_quirks),
        ]),
      ),
    html::StartTag(tag) -> {
      let attributes = json::Object(
        Map::of_entries(
          tag.attributes.map(|a: Attribute| { key: a.name, value: json::Str(a.value) }),
        ),
      );
      let head = [json::Str("StartTag"), json::Str(tag.name), attributes];
      Some(json::Array(if tag.self_closing { head.push(json::Bool(true)) } else { head }))
    },
    html::EndTag(tag) -> Some(json::Array([json::Str("EndTag"), json::Str(tag.name)])),
    html::Comment(data) -> Some(json::Array([json::Str("Comment"), json::Str(data)])),
    html::Text(data) -> Some(json::Array([json::Str("Character"), json::Str(data)])),
    html::Instruction(target, data) ->
      Some(json::Array([json::Str("ProcessingInstruction"), json::Str(target), json::Str(data)])),
    html::EndOfFile -> None,
  }

type TokenizerOutput = { output: Json, errors: List<String> }

fn tokenize_run(r: Run) -> TokenizerOutput = {
  let start: Start = { state: state_of(r.state), last_start_tag: r.last, foreign: false };
  match html::tokenize(html::cursor(Bytes::of_string(r.input), start, html::default_limits())) {
    Ok(lexemes) ->
      {
        output: json::Array(
          lexemes.fold([], |all: List<Json>, l: Lexeme|
            match token_json(l.token) { Some(j) -> all.push(j), None -> all }),
        ),
        errors: lexemes.fold([], |all: List<String>, l: Lexeme|
          l.problems.fold(all, |codes: List<String>, p: html::Problem|
            codes.push(html::code(p.error)))).sort(
        ),
      },
    Err(_) -> { output: json::Str("refused"), errors: [] },
  }
}

fn mismatch_text(r: Run, g: TokenizerOutput) -> String / {abort.raise} =
  r.file ++ " `" ++ r.description ++ "` (" ++ r.state ++ "): " ++ json::to_string(g.output) ++ " "
    ++ json::to_string(json::strings(g.errors))
    ++ ", not "
    ++ json::to_string(r.output)
    ++ " "
    ++ json::to_string(json::strings(r.errors))

test "HTML tokenizer test file {b.file} (from {b.from}): each test gives the expected tokens and errors" for b: Block in blocks(
  ) {
  let wrong = b.runs.fold([], |found: List<String>, r: Run| {
    let g = tokenize_run(r);
    if g.output == r.output && g.errors == r.errors { found }
    else { found.push(mismatch_text(r, g)) }
  });
  assert_eq(wrong, [])
}

test "the HTML tokenizer test data has the expected number of tests, and skips only tests with lone surrogates or XML infoset coercion" {
  let s = suite();
  assert_eq(s.runs.len(), 7045);
  assert_eq(s.skipped.map(|u: SkippedTest| u.file ++ ": " ++ u.reason), [
    "unicodeCharsProblematic.test: a lone surrogate",
    "unicodeCharsProblematic.test: a lone surrogate",
    "unicodeCharsProblematic.test: a lone surrogate",
    "unicodeCharsProblematic.test: a lone surrogate",
    "xmlViolation.test: the infoset coercion",
    "xmlViolation.test: the infoset coercion",
    "xmlViolation.test: the infoset coercion",
    "xmlViolation.test: the infoset coercion",
  ])
}
