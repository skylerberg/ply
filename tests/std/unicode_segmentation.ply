import std.list
import std.segment
import std.width
import ucd_files
import ucd_files (Block, hex, hex_code_points, text, trimmed)

type Line = { text: String, boundaries: List<Int> }

type ParseState = { code_points: List<Int>, at: List<Int> }

fn lines(file: Bytes) -> List<Line> / {abort.raise} =
  file.split(b"\n").fold([], |found: List<Line>, line: Bytes| {
    let data = trimmed(match line.index_of_byte(b'#') {
      Some(i) -> line.slice(0, i),
      None -> line,
    });
    if data.len() == 0 { found } else {
      let marked = data.split(b" ").fold(
        { code_points: [], at: [] },
        |m: ParseState, token: Bytes|
          if token == b"\xc3\xb7" {
            { code_points: m.code_points, at: m.at.push(m.code_points.len()) }
          } else if token == b"\xc3\x97" || token.len() == 0 { m }
          else { { code_points: m.code_points.push(hex(token)), at: m.at } },
      );
      found.push({ text: text(marked.code_points), boundaries: marked.at })
    }
  })

fn blocks(file: Bytes) -> List<Block<Line>> / {abort.raise} =
  ucd_files::blocks(lines(file), 128, |l: Line| hex_code_points(l.text))

test "the {b.lines.len()} lines of GraphemeBreakTest.txt from {b.from} are cut into clusters where they say" for b: Block<Line> in blocks(
    ucd_files::grapheme_break_test,
  ) {
  let wrong = b.lines.filter(|l: Line| segment::grapheme_boundaries(l.text) != l.boundaries);
  assert_eq(wrong.map(|l: Line| hex_code_points(l.text)), [])
}

test "the {b.lines.len()} lines of WordBreakTest.txt from {b.from} are cut into words where they say" for b: Block<Line> in blocks(
    ucd_files::word_break_test,
  ) {
  let wrong = b.lines.filter(|l: Line| segment::word_boundaries(l.text) != l.boundaries);
  assert_eq(wrong.map(|l: Line| hex_code_points(l.text)), [])
}

test "in the Unicode grapheme and word break test texts, segments join back to the text, each grapheme cluster counts as one, and `width::columns` equals the sum of the cluster widths" {
  let joined = |segments: List<String>| segments.fold("", |all: String, s: String| all ++ s);
  let wrong = lines(ucd_files::grapheme_break_test).concat(
    lines(ucd_files::word_break_test),
  ).filter(|l: Line| {
    let clusters = segment::graphemes(l.text);
    joined(clusters) != l.text || joined(segment::split_words(l.text)) != l.text
      || clusters.filter(|cluster: String| segment::grapheme_count(cluster) != 1).len() > 0
      || width::columns(l.text)
      != clusters.fold(0, |sum: Int, cluster: String| sum + width::cluster_columns(cluster))
  });
  assert_eq(wrong.map(|l: Line| hex_code_points(l.text)), [])
}
