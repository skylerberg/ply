import std.list
import std.result
import std.string
import std.tar
import std.tar (tar, Cursor, Entry, Limits, Member, Operation, MakeDirectory, MakeHardLink,
                MakeSymlink, WriteFile)

type Fixture = { name: String, bytes: Bytes }

const archives: List<Fixture> = embed_dir("tar").filter(|f: Fixture| f.name.ends_with(".tar"))

fn archive(name: String) -> Bytes / {abort.raise} =
  match archives.filter(|f: Fixture| f.name == name) {
    [found, ..] -> found.bytes,
    [] -> panic(f"no archive {name}"),
  }

const large_limits: Limits = { entries: 100, total: 1000000, size: 1000000, path: 4096 }

fn line(m: Member) -> String = {
  let h = m.header;
  let seconds = match h.modified { Instant(nanos) -> nanos / 1000000000 };
  f"{h.kind} {h.mode} {h.uid}:{h.gid} {h.uname}:{h.gname} {m.size} {seconds} {h.path} {h.link}"
}

fn lines(name: String) -> List<String> / {tar.fail, abort.raise} =
  tar::members(archive(name), large_limits).map(line)

fn read_incrementally(
  whole: Bytes,
  chunk: Int,
  seen: Int,
  at: Cursor,
  found: List<String>,
  budget: Int,
) -> List<String> / {tar.fail, abort.raise} =
  if budget <= 0 { found } else {
    match tar::step(whole.slice(0, seen), at, large_limits) {
      tar::End -> found,
      tar::NeedMore(_) -> if seen >= whole.len() { found } else {
        read_incrementally(whole, chunk, min(seen + chunk, whole.len()), at, found, budget - 1)
      },
      tar::Next(m) ->
        read_incrementally(whole, chunk, seen, m.next, found.push(m.header.path), budget - 1),
    }
  }

test "tar archive file {f.name} decodes to entries, and `tar::write` then `tar::decode` returns the same entries" for f: Fixture in archives {
  let entries = tar::read(f.bytes, large_limits);
  assert(entries.len() > 0);
  assert_eq(tar::decode(tar::write(entries), large_limits), Ok(entries))
}

test "tar archive file {f.name} gives the same member paths when its bytes are fed in 300-byte chunks as when read whole" for f: Fixture in archives {
  assert_eq(
    read_incrementally(f.bytes, 300, 0, tar::start(), [], 1000),
    tar::members(f.bytes, large_limits).map(|m: Member| m.header.path),
  )
}

fn tree(owner: String) -> List<String> =
  [
    f"Directory 493 1000:1000 {owner} 0 1704193445 docs ",
    f"File 420 1000:1000 {owner} 11 1704193445 docs/hard ",
    f"Directory 488 1000:1000 {owner} 0 1704193445 docs/deep ",
    f"Symlink 493 1000:1000 {owner} 0 1704193445 docs/link hello.txt",
    f"HardLink 420 1000:1000 {owner} 0 1704193445 docs/hello.txt docs/hard",
    f"File 420 1000:1000 {owner} 7 1704193445 docs/deep/note.txt ",
    f"File 420 1000:1000 {owner} 0 1704193445 empty ",
  ]

test "the same directory tree is read from bsdtar's ustar, GNU and v7 archives, and v7 records no owner names" {
  assert_eq(lines("ustar.tar"), tree("ply:staff"));
  assert_eq(lines("gnutar.tar"), tree("ply:staff"));
  assert_eq(lines("v7.tar"), tree(":"));
  assert_eq(tar::read(archive("v7.tar"), large_limits).map(|e: Entry| e.data), [
    b"",
    b"hello, tar\n",
    b"",
    b"",
    b"",
    b"deeper\n",
    b"",
  ])
}

test "`tar::plan` lists the steps to create an archive's directories, files and links in archive order" {
  assert_eq(
    tar::plan(tar::read(archive("ustar.tar"), large_limits)),
    Ok([
      MakeDirectory("docs", 493),
      WriteFile("docs/hard", 420, b"hello, tar\n"),
      MakeDirectory("docs/deep", 488),
      MakeSymlink("docs/link", "hello.txt"),
      MakeHardLink("docs/hello.txt", "docs/hard"),
      WriteFile("docs/deep/note.txt", 420, b"deeper\n"),
      WriteFile("empty", 420, b""),
    ]),
  )
}

const long_directory: String = "d".repeat(60) ++ "/" ++ "e".repeat(60)

const long_file: String = long_directory ++ "/" ++ "f".repeat(120) ++ ".txt"

test "a pax archive's records carry long and non-ASCII paths and times finer than a second" {
  let read = tar::read(archive("pax.tar"), large_limits);
  assert_eq(read.map(|e: Entry| (e.header.path, e.header.kind, e.header.modified)), [
    ("d".repeat(60), tar::Directory, Instant(1704164645000000000)),
    (long_directory, tar::Directory, Instant(1704164645000000000)),
    (long_file, tar::File, Instant(1704164645123456789)),
    ("caf\u{e9}-\u{6c34}.txt", tar::File, Instant(1704164645500000000)),
    ("far", tar::Symlink, Instant(1704164645000000000)),
  ]);
  assert_eq(read.drop(4).map(|e: Entry| e.header.link), [long_file]);
  assert_eq(read.take(4).drop(2).map(|e: Entry| e.data), [b"long\n", b"caf\xc3\xa9\n"]);
  assert_eq(
    read.map(|e: Entry| e.header.extended.map(|r: tar::Record| r.keyword)),
    read.map(|_: Entry| ["atime", "ctime"]),
  )
}

test "a GNU long-name or long-link entry gives its path or link target to the member that follows it" {
  assert_eq(
    tar::members(archive("gnu_long.tar"), large_limits).map(|m: Member|
      (m.header.path, m.header.link, m.size)),
    [("d".repeat(60), "", 0), (long_directory, "", 0), (long_file, "", 5), ("far", long_file, 0)],
  )
}

test "decoding fails with `TooLong` when a long path exceeds the path limit, in both GNU and pax archives" {
  let decode_with_path_limit = |name: String, path: Int|
    tar::decode(archive(name), { entries: 100, total: 1000000, size: 1000000, path: path });
  assert_eq(decode_with_path_limit("gnu_long.tar", 246).is_ok(), true);
  assert_eq(
    decode_with_path_limit("gnu_long.tar", 245).err(),
    Some({ at: 3072, reason: tar::TooLong }),
  );
  assert_eq(decode_with_path_limit("pax.tar", 246).is_ok(), true);
  assert_eq(decode_with_path_limit("pax.tar", 245).err(), Some({ at: 4096, reason: tar::TooLong }))
}

test "GNU base-256 numbers, which Python's tarfile writes for values too large for octal, are read correctly" {
  assert_eq(lines("gnu_python.tar"), [
    "File 384 3000000000:4000000000 big:bigger 9 1704164645 wide-owner.txt ",
    "File 384 0:0 : 4 -86400 before-the-epoch.txt ",
    "File 384 0:0 : 5 1704164645 " ++ "n".repeat(180) ++ ".txt ",
    "Symlink 511 0:0 : 0 1704164645 points-far " ++ "t".repeat(150),
  ])
}

test "a FIFO and a device are read as their headers describe, but `tar::plan` fails with `Special` for them" {
  let read = tar::read(archive("special.tar"), large_limits);
  assert_eq(
    read.map(|e: Entry| (e.header.path, e.header.kind, e.header.major, e.header.minor, e.data)),
    [("pipe", tar::Fifo, 0, 0, b""), ("null", tar::CharDevice, 3, 2, b"")],
  );
  assert_eq(tar::plan(read), Err({ index: 0, path: "pipe", reason: tar::Special }));
  assert_eq(tar::plan(read.drop(1)), Err({ index: 0, path: "null", reason: tar::Special }))
}

test "an archive with a path that climbs out of the root can be read, but `tar::plan` fails with `Escapes`" {
  let read = tar::read(archive("traversal.tar"), large_limits);
  assert_eq(read.map(|e: Entry| (e.header.path, e.data)), [
    ("inside.txt", b"fine\n"),
    ("../outside.txt", b"gotcha\n"),
  ]);
  assert_eq(tar::plan(read), Err({ index: 1, path: "../outside.txt", reason: tar::Escapes }));
  assert_eq(tar::plan(read.take(1)), Ok([WriteFile("inside.txt", 420, b"fine\n")]))
}

test "an archive that creates a symlink and then writes a file under it can be read, but `tar::plan` fails with `ThroughLink`" {
  let read = tar::read(archive("through_link.tar"), large_limits);
  assert_eq(read.map(|e: Entry| (e.header.path, e.header.kind, e.header.link)), [
    ("way", tar::Symlink, "elsewhere"),
    ("way/planted.txt", tar::File, ""),
  ]);
  assert_eq(tar::plan(read), Err({ index: 1, path: "way/planted.txt", reason: tar::ThroughLink }))
}

const written_entries: List<Entry> = {
  let script = tar::file("project/bin/run", b"#!/bin/sh\nexec true\n", mode: 493);
  let owned = tar::file(
    "project/owned.txt",
    b"whose\n",
    mode: 384,
    modified: Instant(1704164645000000000),
  );
  [
    tar::directory("project"),
    tar::file("project/README.md", b"# project\n"),
    tar::directory("project/bin", mode: 448),
    script,
    tar::symlink("project/latest", "bin/run"),
    tar::hard_link("project/bin/again", "project/bin/run"),
    { ..owned, header: { ..owned.header, uid: 1000, gid: 100, uname: "ply", gname: "staff" } },
    tar::file("project/" ++ "d".repeat(120) ++ "/" ++ "f".repeat(90) ++ ".txt", b"split\n"),
    tar::file("project/" ++ "p".repeat(200) ++ "/" ++ "q".repeat(110) ++ ".txt", b"carried\n"),
    tar::file(
      "project/stra\u{df}e-\u{6c34}.txt",
      b"stra\xc3\x9fe\n",
      modified: Instant(1704164645123456789),
    ),
    tar::symlink("project/far", "t".repeat(150)),
  ]
}

const written_listing: Bytes = embed("tar/written.listing")

fn listing_columns(m: Member) -> List<String> = {
  let h = m.header;
  let letter = match h.kind {
    tar::Directory -> "d",
    tar::Symlink -> "l",
    tar::HardLink -> "h",
    _ -> "-",
  };
  let bits = String::join(
    range(0, 9).map(|i: Int|
      if h.mode >> 8 - i & 1 == 0 { "-" } else { "rwxrwxrwx".slice(i, i + 1) }),
    "",
  );
  let day = if h.modified == Instant(0) { ["Jan", "1", "1970"] } else { ["Jan", "2", "2024"] };
  let after = match h.kind {
    tar::Directory -> [h.path ++ "/"],
    tar::Symlink -> [h.path, "->", h.link],
    tar::HardLink -> [h.path, "link", "to", h.link],
    _ -> [h.path],
  };
  [
    [letter ++ bits, "0"],
    [if h.uname == "" { h.uid.to_string() } else { h.uname }],
    [if h.gname == "" { h.gid.to_string() } else { h.gname }],
    [m.size.to_string()],
    day,
    after,
  ].fold([], |columns: List<String>, more: List<String>|
    more.fold(columns, |so_far: List<String>, column: String| so_far.push(column)))
}

test "`tar::write` produces the same archive bytes as bsdtar, and its members list with the same columns as bsdtar's listing" {
  let whole = tar::write(written_entries);
  assert_eq(whole, archive("written.tar"));
  assert_eq(
    tar::members(whole, large_limits).map(listing_columns),
    String::of_bytes(written_listing).split("\n").filter(|row: String| row != "").map(
      |row: String| row.split(" ").filter(|column: String| column != ""),
    ),
  )
}
