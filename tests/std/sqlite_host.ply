//! `std.sqlite`'s real handler over files under the root `scratch`, which CI's runs of the library's
//! suites grant (`.github/ci-ply.sh`): what a connection writes, what a second connection sees and
//! is refused while the first holds a transaction, and a fold read a page at a time.

import std.fs (fs, listed_names)
import std.list
import std.sql (stmt, IntParameter, TextParameter, Row)
import std.sqlite
import std.sqlite (sqlite, sql, Busy, Refused, Unopened, Create, ReadOnly, ReadWrite, Limits,
                   Options)
import std.string

fn roomy() -> Limits =
  { sql_bytes: 10000, params: 100, rows: 100000, bytes: 10000000, steps: 1000000 }

fn plain() -> Options = { strict: true, busy_ms: 50, statements: 8 }

fn s(text: String) -> sqlite::Bound / {sql.fail, abort.raise} = sqlite::bound(stmt(text), [])

fn refusal<a | e>(go: () -> a / {sql.fail | e}) -> String / e =
  match try[sql.fail] { go() } {
    Ok(_) -> "ran",
    Err(Busy) -> "busy",
    Err(Refused(_)) -> "refused",
    Err(Unopened(_)) -> "unopened",
    Err(_) -> "other",
  }

/// `file` with nothing an earlier run left of it under the root: the database, its write-ahead log,
/// the log's index and a rollback journal.
fn fresh(file: String) -> String / {fs.remove[scratch]} = {
  ["", "-wal", "-shm", "-journal"].fold((), |u: Unit, suffix: String| {
    let _ = fs.remove[scratch](file ++ suffix);
    ()
  });
  file
}

/// The files under the root whose names start with `file`, in order.
fn beside(file: String) -> List<String> / {fs.list_dir[scratch]} =
  match listed_names(fs.list_dir[scratch](".")) {
    Some(names) -> names.filter(|n: String| n.starts_with(file)).sort(),
    None -> [],
  }

fn names<[d], [r]>(
  conn: Hold<sqlite::Connection<[d]>, [r]>,
) -> List<String> / {hold.read[r], sqlite.query[d], sql.fail, abort.raise} =
  sqlite::query(conn, s("select name from person order by id"), roomy()).map(|row: Row|
    sqlite::text(row, "name"))

fn insert<[d], [r]>(
  conn: Hold<sqlite::Connection<[d]>, [r]>,
  name: String,
) -> Int / {hold.read[r], sqlite.execute[d], sql.fail, abort.raise} =
  sqlite::execute(
    conn,
    sqlite::bound(stmt("insert into person (name) values (?1)"), [TextParameter(name)]),
    roomy(),
  ).rows

/// Two people written in a transaction and closed, then read back by a connection that only reads.
fn round_trip(
  file: String,
) -> List<String> / {sqlite.read[scratch], sqlite.write[scratch], sql.fail, abort.raise} = {
  with_hold[first](sqlite::opening[scratch](file, Create, plain()), |c| sqlite::close(c)) { conn -> {
    sqlite::execute(
      conn,
      s("create table person (id integer primary key, name text not null) strict"),
      roomy(),
    );
    sqlite::transaction(conn, || {
      insert(conn, "Ada");
      insert(conn, "Grace")
    })
  } };
  with_hold[second](sqlite::opening[scratch](file, ReadOnly, plain()), |c|
    sqlite::close(c)) { conn -> names(conn) }
}

/// One connection writing in a transaction, another reading and then trying to write: the reader's
/// rows inside the writer's transaction, the second writer's statement and transaction, the
/// writer's own rows, then the reader's rows and its write after the commit.
fn together(
  file: String,
) -> List<String> / {sqlite.read[scratch], sqlite.write[scratch], sql.fail, abort.raise} =
  with_hold[one](sqlite::opening[scratch](file, ReadWrite, plain()), |c| sqlite::close(c)) { one ->
    with_hold[two](sqlite::opening[scratch](file, ReadWrite, plain()), |c|
      sqlite::close(c)) { two -> {
      let during = sqlite::transaction(one, || {
        insert(one, "Edsger");
        [
          names(two).len().to_string(),
          refusal(|| insert(two, "Barbara")),
          refusal(|| sqlite::transaction(two, || 0)),
          names(one).len().to_string(),
        ]
      });
      during.push(names(two).len().to_string()).push(refusal(|| insert(two, "Barbara")))
    } }
  }

/// The sum of `1..rows` read from a table through a statement the connection keeps open between
/// pages of 64 rows.
fn folded(
  file: String,
  rows: Int,
) -> Int / {sqlite.read[scratch], sqlite.write[scratch], sql.fail, abort.raise} =
  with_hold[folding](sqlite::opening[scratch](file, Create, plain()), |c|
    sqlite::close(c)) { conn -> {
    sqlite::execute(
      conn,
      s("create table if not exists n (i integer primary key) strict"),
      roomy(),
    );
    sqlite::execute(conn, s("delete from n"), roomy());
    sqlite::execute(
      conn,
      sqlite::bound(
        stmt(
          "with recursive c(i) as (select 1 union all select i + 1 from c where i < ?1) insert into n select i from c",
        ),
        [IntParameter(rows)],
      ),
      roomy(),
    );
    sqlite::fold_rows(conn, s("select i from n order by i"), roomy(), 64, 0, |acc: Int, row: Row|
      acc + sqlite::int(row, "i"))
  } }

test/nondet "a database written and closed is read back from its file" {
  let file = fresh("round_trip.db");
  assert_eq(round_trip(file), ["Ada", "Grace"]);
  let bytes = match fs.read_file[scratch](file) { Some(b) -> b, None -> b"" };
  assert_eq(bytes.slice(0, 16), b"SQLite format 3\x00");
  // Bytes 18 and 19 are the file format's write and read versions: 2 is write-ahead logging.
  assert_eq((bytes.at(18), bytes.at(19)), (2, 2));
  // The log stays beside a database whose last connection only read.
  assert_eq(beside(file), [file, file ++ "-shm", file ++ "-wal"])
}

test/nondet "a reader sees what was committed and a second writer is busy" {
  let file = fresh("together.db");
  assert_eq(round_trip(file), ["Ada", "Grace"]);
  assert_eq(together(file), ["2", "busy", "busy", "3", "3", "ran"])
}

test/nondet "a fold reads a statement the connection keeps open between pages" {
  let file = fresh("folded.db");
  assert_eq([1000, 64, 1].map(|rows: Int| folded(file, rows)), [500500, 2080, 1])
}
