//! `std.sqlite`'s host handler over files under the root `scratch`, which CI's runs of the library's
//! suites grant (`.github/ci-ply.sh`): what a connection writes, what a second connection sees and
//! is denied while the first holds a transaction, a fold read a page at a time, the statements the
//! engine rejects because they reach another file, and the links it never opens or writes through.

import scratch
import std.fs (fs, listed_names)
import std.list
import std.sql (stmt, IntParameter, TextParameter, Row)
import std.sqlite
import std.sqlite (sqlite, sql, Busy, Rejected, Unopened, Create, ReadOnly, ReadWrite, Limits,
                   Options)
import std.string

fn roomy() -> Limits =
  { sql_bytes: 10000, params: 100, rows: 100000, bytes: 10000000, steps: 1000000 }

fn plain() -> Options = { strict: true, busy_ms: 50, statements: 8 }

fn s(text: String) -> sqlite::Bound / {sql.fail, abort.raise} = sqlite::bound(stmt(text), [])

fn rejection<a | e>(go: () -> a / {sql.fail | e}) -> String / e =
  match try[sql.fail] { go() } {
    Ok(_) -> "ran",
    Err(Busy) -> "busy",
    Err(Rejected(_)) -> "refused",
    Err(Unopened(_)) -> "unopened",
    Err(_) -> "other",
  }

/// The names in `dir` under the root, in order.
fn listed(dir: String) -> List<String> / {fs.list_dir[scratch]} =
  match listed_names(fs.list_dir[scratch](dir)) { Some(names) -> names.sort(), None -> [] }

/// The files under the root whose names start with `file`, in order.
fn beside(file: String) -> List<String> / {fs.list_dir[scratch]} =
  listed(".").filter(|n: String| n.starts_with(file))

fn names<[d], [r]>(
  conn: Scoped<sqlite::Connection<[d]>, [r]>,
) -> List<String> / {scoped.read[r], sqlite.query[d], sql.fail, abort.raise} =
  sqlite::query(conn, s("select name from person order by id"), roomy()).map(|row: Row|
    sqlite::text(row, "name"))

fn insert<[d], [r]>(
  conn: Scoped<sqlite::Connection<[d]>, [r]>,
  name: String,
) -> Int / {scoped.read[r], sqlite.execute[d], sql.fail, abort.raise} =
  sqlite::execute(
    conn,
    sqlite::bound(stmt("insert into person (name) values (?1)"), [TextParameter(name)]),
    roomy(),
  ).rows

/// Two people written in a transaction and closed, then read back by a connection that only reads.
fn round_trip(
  file: String,
) -> List<String> / {sqlite.read[scratch], sqlite.write[scratch], sql.fail, abort.raise} = {
  with_scope[first](sqlite::opening[scratch](file, Create, plain()), |c|
    sqlite::close(c)) { conn -> {
    sqlite::execute(
      conn,
      s("create table person (id integer primary key, name text not null) strict"),
      roomy(),
    );
    sqlite::transaction(conn, || {
      insert(conn, "Ada");
      insert(conn, "Grace")
    })
  } };
  with_scope[second](sqlite::opening[scratch](file, ReadOnly, plain()), |c|
    sqlite::close(c)) { conn -> names(conn) }
}

/// One connection writing in a transaction, another reading and then trying to write: the reader's
/// rows inside the writer's transaction, the second writer's statement and transaction, the
/// writer's own rows, then the reader's rows and its write after the commit.
fn together(
  file: String,
) -> List<String> / {sqlite.read[scratch], sqlite.write[scratch], sql.fail, abort.raise} =
  with_scope[one](sqlite::opening[scratch](file, ReadWrite, plain()), |c|
    sqlite::close(c)) { one ->
    with_scope[two](sqlite::opening[scratch](file, ReadWrite, plain()), |c|
      sqlite::close(c)) { two -> {
      let during = sqlite::transaction(one, || {
        insert(one, "Edsger");
        [
          names(two).len().to_string(),
          rejection(|| insert(two, "Barbara")),
          rejection(|| sqlite::transaction(two, || 0)),
          names(one).len().to_string(),
        ]
      });
      during.push(names(two).len().to_string()).push(rejection(|| insert(two, "Barbara")))
    } }
  }

/// The sum of `1..rows` read from a table through a statement the connection keeps open between
/// pages of 64 rows.
fn folded(file: String, rows: Int) -> Int / {sqlite.write[scratch], sql.fail, abort.raise} =
  with_scope[folding](sqlite::opening[scratch](file, Create, plain()), |c|
    sqlite::close(c)) { conn -> {
    sqlite::execute(
      conn,
      s("create table if not exists n (i integer primary key) strict"),
      roomy(),
    );
    sqlite::execute(conn, s("delete from n"), roomy());
    sqlite::execute(
      conn,
      sqlite::bound(
        stmt(
          "with recursive c(i) as (select 1 union all select i + 1 from c where i < ?1) insert into n select i from c",
        ),
        [IntParameter(rows)],
      ),
      roomy(),
    );
    sqlite::fold_rows(conn, s("select i from n order by i"), roomy(), 64, 0, |acc: Int, row: Row|
      acc + sqlite::int(row, "i"))
  } }

test/nondet "a database written and closed is read back from its file" {
  scratch::fresh();
  let file = "round_trip.db";
  assert_eq(round_trip(file), ["Ada", "Grace"]);
  let bytes = match fs.read_file[scratch](file) { Some(b) -> b, None -> b"" };
  assert_eq(bytes.slice(0, 16), b"SQLite format 3\x00");
  // Bytes 18 and 19 are the file format's write and read versions: 2 is write-ahead logging.
  assert_eq((bytes.at(18), bytes.at(19)), (2, 2));
  // The log stays beside a database whose last connection only read.
  assert_eq(beside(file), [file, file ++ "-shm", file ++ "-wal"])
}

test/nondet "a reader sees what was committed and a second writer is busy" {
  scratch::fresh();
  let file = "together.db";
  assert_eq(round_trip(file), ["Ada", "Grace"]);
  assert_eq(together(file), ["2", "busy", "busy", "3", "3", "ran"])
}

test/nondet "a fold reads a statement the connection keeps open between pages" {
  scratch::fresh();
  assert_eq([1000, 64, 1].map(|rows: Int| folded("folded.db", rows)), [500500, 2080, 1])
}

/// What the engine itself says of `text` on a connection to `escape.db`, with no reader before it
/// to reject the statement first: the kind of its failure, or `ran`.
fn engine_said(text: String) -> String / {sqlite.write[scratch]} =
  match sqlite.open[scratch]("escape.db", Create, plain()) {
    Err(f) -> f.kind,
    Ok(conn) -> {
      let said = match sqlite.execute[scratch](conn, text, [], roomy()).failure {
        Some(f) -> f.kind,
        None -> "ran",
      };
      sqlite.close[scratch](conn);
      said
    },
  }

test/nondet "the engine rejects every statement that reaches a file other than its database" {
  scratch::fresh();
  assert(fs.create_dir[scratch]("other"));
  assert(fs.write_file[scratch]("other/secret.txt", b"secret"));
  let other = match fs.canonical[scratch]("other") {
    Some(path) -> path,
    None -> panic("a directory under the root has a path"),
  };
  assert_eq(
    [
      "attach database '" ++ other ++ "/attached.db' as other",
      "attach database 'file:" ++ other ++ "/uri.db?mode=rwc' as other",
      "vacuum into '" ++ other ++ "/vacuumed.db'",
      "select readfile('" ++ other ++ "/secret.txt')",
      "select writefile('" ++ other ++ "/written.txt', 'x')",
      "pragma temp_store_directory = '" ++ other ++ "'",
      "select load_extension('" ++ other ++ "/evil')",
    ].map(|text: String| engine_said(text)),
    ["refused", "refused", "refused", "statement", "statement", "refused", "statement"],
  );
  assert_eq(listed("other"), ["secret.txt"]);
  assert_eq(listed("."), [scratch::marker(), "escape.db", "other"].sort())
}

/// What opening `path`, making it where nothing is, and making a table in it returns.
fn opens(path: String) -> String / {sqlite.write[scratch], abort.raise} =
  rejection(||
    with_scope[opened_at](sqlite::opening[scratch](path, Create, plain()), |c|
      sqlite::close(c)) { conn ->
      sqlite::execute(conn, s("create table if not exists t (n integer) strict"), roomy())
    })

/// What backing `file` up into `path` returns.
fn backs_up(file: String, path: String) -> String / {sqlite.write[scratch]} =
  rejection(||
    with_scope[source](sqlite::opening[scratch](file, ReadWrite, plain()), |c|
      sqlite::close(c)) { conn -> sqlite::backup(conn, path) })

/// A link at `link` to `target`, which is read from the root.
fn linked(link: String, target: String) -> Unit / {fs.symlink[scratch], abort.raise} =
  assert(fs.symlink[scratch](link, target), Some("a link is made"))

test/nondet "a database is never opened through a symbolic link, and a backup never writes through one" {
  scratch::fresh();
  assert(fs.create_dir[scratch]("dir"));
  assert(fs.create_dir[scratch]("other"));
  // A link to a database, a directory that is a link, and the journal, the write-ahead log and its
  // index the engine would open beside a database, each a link to a file elsewhere.
  linked("link.db", "real.db");
  linked("linked", "dir");
  let sides = [("_wal", "-wal"), ("_journal", "-journal"), ("_shm", "-shm")];
  sides.fold((), |u: Unit, side: (String, String)|
    match side {
      (stem, suffix) -> linked("side" ++ stem ++ ".db" ++ suffix, "other/target" ++ suffix),
    });
  assert_eq(
    ["real.db", "link.db", "linked/new.db"].concat(
      sides.map(|side: (String, String)| match side { (stem, _) -> "side" ++ stem ++ ".db" }),
    ).map(|path: String| opens(path)),
    ["ran", "unopened", "unopened", "unopened", "unopened", "unopened"],
  );
  sides.fold((), |u: Unit, side: (String, String)|
    match side {
      (stem, suffix) -> {
        let target = "other/target" ++ suffix;
        assert(!fs.exists[scratch](target), Some(target ++ " was written through the link"));
        assert(!fs.exists[scratch]("side" ++ stem ++ ".db"), Some("side" ++ stem ++ ".db was made"))
      },
    });
  assert_eq((listed("dir"), listed("other")), ([], []));
  // A backup is written to a new file, never through a link already there.
  linked("copy.db", "missing.db");
  assert_eq(round_trip("data.db"), ["Ada", "Grace"]);
  assert_eq(backs_up("data.db", "copy.db"), "refused");
  assert(!fs.exists[scratch]("missing.db"), Some("the backup went through the link"));
  assert_eq(backs_up("data.db", "kept.db"), "ran");
  let kept = match fs.read_file[scratch]("kept.db") { Some(b) -> b, None -> b"" };
  assert_eq(kept.slice(0, 16), b"SQLite format 3\x00")
}
