import std.html
import std.html (Hostile, Html, html, hostile_text, text)
import std.template
import std.template (Template)
import std.xml
import std.xml (Element)
import std.gen
import std.value (reflect)

const page: Template =
  match template::parse_html(
      "<div class=\"{{ a }}\" title='{{ b }}'><p id={{ c }}>{{ a }}</p><a href=\"/x/{{ b }}?q={{ c }}\">{{ b }}<br/></a><textarea>{{ c }}</textarea>{{ for x in xs }}<i lang=\"{{ x }}\">{{ x }}</i>{{ end }}</div>",
    ) {
    Ok(t) -> t,
    Err(r) -> panic(template::explain(r.reason)),
  }

fn xml_safe_text(h: Hostile) -> String =
  String::of_chars(hostile_text(h).chars().filter(|c: Char| Int::of_char(c) >= 32))

fn url_part(at: html::UrlPart, value: String) -> String / {abort.raise} =
  match html::url_value(at, value, false) {
    Ok(url) -> url,
    Err(scheme) -> panic("a value past a URL's start named the scheme " ++ scheme),
  }

fn expected_page(a: String, b: String, c: String) -> Element / {abort.raise} = {
  let named = |name: String, value: String| xml::attribute(xml::name(name), value);
  let item = |x: String|
    xml::Element(xml::element(xml::name("i"), [named("lang", x)], xml::chars(x)));
  xml::element(xml::name("div"), [named("class", a), named("title", b)], [
    xml::Element(xml::element(xml::name("p"), [named("id", c)], xml::chars(a))),
    xml::Element(
      xml::element(
        xml::name("a"),
        [named("href", "/x/" ++ url_part(html::Path, b) ++ "?q=" ++ url_part(html::Query, c))],
        xml::chars(b).push(xml::Element(xml::element(xml::name("br"), [], []))),
      ),
    ),
    xml::Element(xml::element(xml::name("textarea"), [], xml::chars(c))),
    item(a),
    item(b),
  ])
}

fn render_page(a: String, b: String, c: String) -> Result<String, template::Failure> =
  template::render(
    page,
    reflect({ a: a, b: b, c: c, xs: [a, b] }),
    Map::new(),
    template::default_limits,
  )

test "for any inserted values, a rendered page parses as XML with the template's elements and attributes and each value intact" {
  gen::check3(
    html::hostile(),
    html::hostile(),
    html::hostile(),
    |a: Hostile, b: Hostile, c: Hostile| {
      match render_page(xml_safe_text(a), xml_safe_text(b), xml_safe_text(c)) {
        Err(_) -> false,
        Ok(document) -> match xml::parse(Bytes::of_string(document), xml::default_limits) {
          Err(_) -> false,
          Ok(read) ->
            read.root == expected_page(xml_safe_text(a), xml_safe_text(b), xml_safe_text(c)),
        },
      }
    },
  )
}

test "a value containing HTML tags is inserted as plain text, creating no new elements or attributes" {
  let attack = "\"'></p></div><script>alert(1)</script><p onmouseover=\"x";
  assert_eq(
    match render_page(attack, "' onclick='go()", "x y=z") {
      Ok(document) -> xml::parse(Bytes::of_string(document), xml::default_limits),
      Err(f) -> panic(template::explain(f.reason)),
    },
    Ok(xml::document(expected_page(attack, "' onclick='go()", "x y=z"))),
  )
}

fn row(name: String) -> Html / {abort.raise} =
  match template::parse_html("<li>{{ name }}</li>") {
    Err(r) -> panic(template::explain(r.reason)),
    Ok(t) -> match template::render_html(
        t,
        reflect({ name: name }),
        Map::new(),
        template::default_limits,
      ) {
      Ok(markup) -> markup,
      Err(f) -> panic(template::explain(f.reason)),
    },
  }

fn list(kind: String, names: List<String>) -> Html / {html.unsafe_url, abort.raise} =
  html"<ul class={text(kind)}>{html::fragment(names.map(row))}</ul>"

test "template values are escaped when inserted into HTML, and HTML that `html::render` produces is escaped again when inserted as a string" {
  let names = list("k\"", ["a<b", "c"]);
  assert_eq(html::render(names), "<ul class=\"k&quot;\"><li>a&lt;b</li><li>c</li></ul>");
  let around = match template::parse_html("<main title=\"{{ title }}\">{{ body }}</main>") {
    Ok(t) -> t,
    Err(r) -> panic(template::explain(r.reason)),
  };
  assert_eq(
    template::render(
      around,
      reflect({ title: "<ul>", body: names }),
      Map::new(),
      template::default_limits,
    ),
    Ok("<main title=\"&lt;ul&gt;\"><ul class=\"k&quot;\"><li>a&lt;b</li><li>c</li></ul></main>"),
  );
  assert_eq(
    template::render(
      around,
      reflect({ title: "t", body: html::render(names) }),
      Map::new(),
      template::default_limits,
    ),
    Ok(
      "<main title=\"t\">&lt;ul class=&quot;k&amp;quot;&quot;&gt;&lt;li&gt;a&amp;lt;b&lt;/li&gt;&lt;li&gt;c&lt;/li&gt;&lt;/ul&gt;</main>",
    ),
  )
}
