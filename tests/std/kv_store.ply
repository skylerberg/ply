//! `std.kv` over the disk under the root `scratch`: a directory's lock is a file there, so one store
//! has it at a time, and a second open that asks again takes it once the first has closed.

import scratch
import std.fs (fs, Durable)
import std.kv
import std.kv (kv, Limits, Manual, Store, Why, Locked)
import std.random (entropy)
import std.time (millis)

fn limits() -> Limits = { key: 64, value: 8192, batch: 65536, file: 65536 }

/// The store in `db`, its lock asked for `tries` times, or why it was refused.
fn opened(
  tries: Int,
) -> Result<Store, Why> / {fs.read[scratch], fs.write[scratch], entropy.next, abort.raise} =
  try[kv.refused] { kv::open[scratch]("db", limits(), Manual, kv::raw(), tries) }

fn refusal(r: Result<Store, Why>) -> Option<Why> = match r { Ok(_) -> None, Err(why) -> Some(why) }

/// `s` after a batch that puts `value` under `key`.
fn committed(
  s: Store,
  key: Bytes,
  value: Bytes,
) -> Store / {fs.read[scratch], fs.write[scratch], entropy.next, abort.raise} =
  match try[kv.refused] { kv::put[scratch](s, key, value, Durable) } {
    Ok(next) -> next,
    Err(_) -> panic("the holder's commit was refused"),
  }

/// What a store opened once the lock is free holds under `first` and `second`.
fn read_once_free() -> Result<List<Option<Bytes>>, Why> / {fs.read[scratch], fs.write[scratch], entropy.next, abort.raise} =
  try[kv.refused] {
    let s = kv::open[scratch]("db", limits(), Manual, kv::raw(), 60);
    let held = [b"first", b"second"].map(|key: Bytes| kv::read[scratch](kv::snapshot(s), key));
    kv::close[scratch](s);
    held
  }

test/nondet "a directory has one store at a time: a second is refused it, or waits until the first has closed" {
  scratch::fresh();
  let holder = match opened(1) {
    Ok(s) -> committed(s, b"first", b"1"),
    Err(_) -> panic("the first store was refused"),
  };
  assert_eq(refusal(opened(1)), Some(Locked));
  let waiter = task.spawn(|| read_once_free());
  clock.sleep(millis(2500));
  kv::close[scratch](committed(holder, b"second", b"2"));
  assert_eq(task.join(waiter), Ok([Some(b"1"), Some(b"2")]))
}
