import std.bytes
import std.date
import std.date (Date, DateTime, Time)
import std.list
import std.option
import std.result
import std.string
import std.tar (Absolute, Backslash, UnsafeReason, Drive, Escapes, LinkEscapes, MakeDirectory,
                MakeSymlink, Special, ThroughLink, WriteFile)
import std.zip
import std.zip (zip, Declared, Directory, Entry, Found, Limits, DirectoryEntry, Member, NeedMore,
                NameEncoding, Utf8IfValid, ErrorKind)

type Fixture = { name: String, bytes: Bytes }

const archives: List<Fixture> =
  embed_dir("zip").filter(|f: Fixture| f.name.ends_with(".zip") && !f.name.starts_with("rejected/"))

fn archive(name: String) -> Bytes / {abort.raise} =
  match embed_dir("zip").filter(|f: Fixture| f.name == name) {
    [found, ..] -> found.bytes,
    [] -> panic(f"no archive {name}"),
  }

const large_limits: Limits =
  { entries: 100, total: 2000000, size: 2000000, ratio: 100, path: 4096, comment: 64, slack: 0 }

test "{f.name} reads, and is written and read back the same" for f: Fixture in archives {
  let entries = zip::read(f.bytes, large_limits);
  assert(entries.len() > 0);
  assert_eq(zip::decode(zip::write(entries), large_limits), Ok(entries))
}

fn find_directory(
  whole: Bytes,
  requested: Int,
  budget: Int,
) -> Directory / {zip.fail, abort.raise} = {
  let length = whole.len();
  match zip::locate(whole.slice(length - requested, length), length, large_limits) {
    Found(d) -> d,
    NeedMore(more) -> if budget <= 0 || more <= requested {
      panic("a reader asks for more only so often")
    } else { find_directory(whole, more, budget - 1) },
  }
}

fn open_member(
  whole: Bytes,
  l: DirectoryEntry,
  requested: Int,
  budget: Int,
) -> Member / {zip.fail, abort.raise} =
  match zip::open(l, whole.slice(l.at, l.at + requested), large_limits) {
    Found(m) -> m,
    NeedMore(more) -> if budget <= 0 || more <= requested {
      panic("a reader asks for more only so often")
    } else { open_member(whole, l, more, budget - 1) },
  }

fn read_incrementally(whole: Bytes) -> List<Entry> / {zip.fail, abort.raise} = {
  let d = find_directory(whole, 0, 3);
  zip::listing(whole.slice(d.at, d.at + d.size), d, large_limits).map(
    |l: DirectoryEntry| -> Entry {
      let m = open_member(whole, l, 0, 3);
      { header: m.header, data: zip::unpack(m, whole.slice(m.data, m.data + m.stored)) }
    },
  )
}

test "{f.name} read incrementally, requesting only the bytes each step needs, gives the same entries as reading it whole" for f: Fixture in archives {
  assert_eq(read_incrementally(f.bytes), zip::read(f.bytes, large_limits))
}

fn line(m: Member) -> String = {
  let h = m.header;
  f"{h.kind} {h.mode} {m.size} {h.path}"
}

fn lines(
  name: String,
  root: String,
  names: NameEncoding = Utf8IfValid,
) -> List<String> / {zip.fail, abort.raise} =
  zip::members(archive(name), large_limits, names).filter(|m: Member|
    m.header.path.starts_with(root)).map(|m: Member|
    line({ ..m, header: { ..m.header, path: strip(m.header.path, root) } })).sort(
  )

fn strip(path: String, root: String) -> String / {abort.raise} = path.slice(root.len(), path.len())

fn tree(accented_name: String) -> List<String> =
  [
    f"File 420 6 {accented_name}",
    "Directory 493 0 docs",
    "Directory 488 0 docs/deep",
    "File 420 7 docs/deep/note.txt",
    "File 420 11 docs/hello.txt",
    "Symlink 493 9 docs/link",
    "File 420 0 empty",
    "File 420 1240 repeated.txt",
    "File 493 20 run.sh",
  ].sort(
  )

const accented: String = "caf\u{e9}-\u{6c34}.txt"

const misread: String = "caf\u{251c}\u{2310}-\u{b5}\u{2591}\u{2524}.txt"

test "the same file tree reads identically from archives written by zip, Finder and bsdtar, including names whose UTF-8 flag is not set" {
  assert_eq(lines("infozip.zip", ""), tree(accented));
  assert_eq(lines("finder.zip", "tree/"), tree(accented));
  assert_eq(lines("bsdtar.zip", "tree/"), tree(accented));
  assert_eq(lines("infozip.zip", "", names: Declared), tree(misread));
  assert_eq(lines("finder.zip", "tree/", names: Declared), tree(misread));
  assert_eq(lines("bsdtar.zip", "tree/", names: Declared), tree(accented));
  let data = |name: String, path: String|
    zip::read(archive(name), large_limits).filter(|e: Entry| e.header.path == path).map(
      |e: Entry| e.data,
    );
  assert_eq(data("infozip.zip", "docs/hello.txt"), [b"hello, zip\n"]);
  assert_eq(data("finder.zip", "tree/docs/hello.txt"), [b"hello, zip\n"]);
  assert_eq(data("bsdtar.zip", "tree/docs/link"), [b"hello.txt"]);
  assert_eq(data("finder.zip", "tree/repeated.txt"), [
    b"the same line, again and again\n".repeat(40),
  ])
}

test "a UTF-8 name without the UTF-8 flag is read as UTF-8 or as code page 437 depending on the name encoding setting, and the raw bytes stay available" {
  let accented_name = |name: String, names: NameEncoding|
    zip::members(archive(name), large_limits, names).filter(|m: Member|
      m.name.ends_with(Bytes::of_string(accented))).map(|m: Member|
      (m.flags & 0x800, m.header.path));
  assert_eq(accented_name("infozip.zip", Utf8IfValid), [(0, accented)]);
  assert_eq(accented_name("infozip.zip", Declared), [(0, misread)]);
  assert_eq(accented_name("finder.zip", Utf8IfValid), [
    (0, "tree/" ++ accented),
    (0, "__MACOSX/tree/._" ++ accented),
  ]);
  assert_eq(accented_name("finder.zip", Declared), [
    (0, "tree/" ++ misread),
    (0, "__MACOSX/tree/._" ++ misread),
  ]);
  assert_eq(accented_name("bsdtar.zip", Declared), [(0x800, "tree/" ++ accented)]);
  let dos = |names: NameEncoding|
    zip::read(archive("python_cp437.zip"), large_limits, names).map(|e: Entry|
      (e.header.path, e.header.comment));
  assert_eq(dos(Utf8IfValid), [("caf\u{e9}/\u{fc}ber \u{2592}.txt", "na\u{ef}ve")]);
  assert_eq(dos(Declared), dos(Utf8IfValid));
  assert_eq(
    zip::members(archive("python_streamed.zip"), large_limits).filter(|m: Member|
      m.flags & 0x800 != 0).map(|m: Member| m.header.path),
    ["stra\u{df}e.txt"],
  )
}

test "the zip archive made by macOS Finder contains a metadata file under __MACOSX/ for each member, and all 23 entries still extract" {
  let beside = lines("finder.zip", "__MACOSX/");
  assert_eq(zip::members(archive("finder.zip"), large_limits).len(), 23);
  assert_eq(beside.len(), 12);
  assert_eq(beside.filter(|row: String| row.ends_with("._hello.txt")), [
    "File 420 211 tree/docs/._hello.txt",
  ]);
  assert_eq(
    match zip::plan(zip::read(archive("finder.zip"), large_limits)) {
      Ok(steps) -> steps.len(),
      Err(_) -> -1,
    },
    23,
  )
}

test "an archive with no file modes reads files as 0644 and directories as 0755, for jar archives and for MS-DOS archives" {
  assert_eq(
    lines("jar.zip", ""),
    [
      "Directory 493 0 META-INF",
      "File 420 65 META-INF/MANIFEST.MF",
      "Directory 493 0 docs",
      "Directory 493 0 docs/deep",
      "File 420 7 docs/deep/note.txt",
      "File 420 11 docs/hello.txt",
      "File 420 11 docs/link",
      "File 420 0 empty",
      "File 420 1240 repeated.txt",
      "File 420 20 run.sh",
    ].sort(
    ),
  );
  assert_eq(
    zip::read(archive("fields.zip"), large_limits).map(|e: Entry|
      (e.header.path, e.header.kind, e.header.mode)),
    [
      ("caf\u{e9}.txt", zip::File, 420),
      ("stale.txt", zip::File, 420),
      ("timed.txt", zip::File, 420),
      ("dos.txt", zip::File, 292),
      ("dosdir", zip::Directory, 493),
    ],
  )
}

test "a member's modified time is the writer's local clock time, and an exact instant when an extra field provides one" {
  let times = |name: String, path: String|
    zip::read(archive(name), large_limits).filter(|e: Entry| e.header.path == path).map(
      |e: Entry| (e.header.modified, e.header.times, e.header.extra.map(|f: zip::Field| f.id)),
    );
  let unstamped: zip::MemberTimes = { modified: None, accessed: None, created: None };
  let seven: zip::MemberTimes = { ..unstamped, modified: Some(Instant(1704222246000000000)) };
  assert_eq(times("infozip.zip", "empty"), [
    (date::date_time(2024, 1, 2, 19, 4, 6), seven, [0x7875]),
  ]);
  assert_eq(times("bsdtar.zip", "tree/empty"), [
    (date::date_time(2024, 1, 2, 19, 4, 6), seven, [0x7875]),
  ]);
  assert_eq(times("finder.zip", "tree/empty"), [
    (date::date_time(2024, 1, 2, 19, 4, 6), unstamped, [0x5855]),
  ]);
  assert_eq(times("jar.zip", "empty"), [(date::date_time(2024, 1, 2, 11, 4, 6), unstamped, [])]);
  assert_eq(times("fields.zip", "timed.txt"), [
    (
      date::date_time(2024, 1, 2, 11, 4, 6),
      {
        modified: Some(Instant(1704164645123456700)),
        accessed: Some(Instant(1704164646000000000)),
        created: Some(Instant(1704164640500000000)),
      },
      [],
    ),
  ])
}

test "zip64 numbers are read from a member's header, the directory and the end record alike" {
  let read = |name: String|
    zip::read(archive(name), large_limits).map(|e: Entry| (e.header.path, e.data));
  assert_eq(read("zip64_small.zip"), [("wide.txt", b"wide\n"), ("narrow.txt", b"narrow\n")]);
  assert_eq(read("python_zip64.zip").map(|e: (String, Bytes)| (e._0, e._1.len())), [
    ("repeated.txt", 1240),
    ("word.txt", 5),
  ]);
  assert_eq(read("python_streamed_zip64.zip"), read("python_zip64.zip"))
}

test "a data descriptor is read whether or not it starts with a signature, and whether its sizes take four bytes or eight" {
  assert_eq(
    zip::members(archive("descriptors.zip"), large_limits).map(|m: Member|
      (m.header.path, m.flags, m.data, m.stored)),
    [("bare.txt", 8, 38, 10), ("long.txt", 8, 118, 10)],
  );
  assert_eq(zip::read(archive("descriptors.zip"), large_limits).map(|e: Entry| e.data), [
    b"described\n",
    b"described\n",
  ]);
  assert_eq(
    zip::members(archive("python_streamed.zip"), large_limits).map(|m: Member|
      (m.header.path, m.flags & 8, m.method)),
    [
      ("repeated.txt", 8, zip::Deflated),
      ("stra\u{df}e.txt", 8, zip::Deflated),
      ("empty", 8, zip::Stored),
    ],
  )
}

test "an archive comment and a member comment are read when within the comment length limit, and rejected when longer" {
  let whole = archive("python_stored.zip");
  let comment = |limits: Limits|
    match try { zip::locate(whole, whole.len(), limits) } {
      Ok(Found(d)) -> Ok(d.comment),
      Ok(NeedMore(_)) -> Ok(b""),
      Err(rejected) -> Err(rejected.reason),
    };
  assert_eq(comment(large_limits), Ok(b"stored by Python"));
  assert_eq(comment({ ..large_limits, comment: 16 }), Ok(b"stored by Python"));
  assert_eq(comment({ ..large_limits, comment: 15 }), Err(zip::NoEndRecord));
  assert_eq(zip::read(whole, large_limits).map(|e: Entry| e.header.comment), [
    "",
    "a greeting",
    "",
    "",
  ]);
  assert_eq(zip::decode(whole, { ..large_limits, comment: 16 }).err(), None);
  assert_eq(
    zip::decode(archive("python_cp437.zip"), { ..large_limits, comment: 4 }).err(),
    Some({ at: 49, reason: zip::TooLong }),
  )
}

type Case = { name: String, at: Int, reason: ErrorKind }

const rejected_archives: List<Case> =
  [
    { name: "appended.zip", at: 211, reason: zip::NoEndRecord },
    { name: "bomb.zip", at: 1068, reason: zip::TooDense },
    { name: "bzip2.zip", at: 127, reason: zip::Method(12) },
    { name: "duplicate.zip", at: 141, reason: zip::Duplicate },
    { name: "encrypted.zip", at: 83, reason: zip::Encrypted },
    { name: "fake_end.zip", at: 101, reason: zip::ManyEndRecords },
    { name: "local_name.zip", at: 0, reason: zip::Disagrees },
    { name: "local_size.zip", at: 0, reason: zip::Disagrees },
    { name: "lying_bomb.zip", at: 35, reason: zip::BadData },
    { name: "overflow.zip", at: 44, reason: zip::BadNumber },
    { name: "overlap.zip", at: 0, reason: zip::Overlaps },
    { name: "prepended.zip", at: 205, reason: zip::BadDirectory },
    { name: "second_disk.zip", at: 41, reason: zip::Split },
    { name: "stub.zip", at: 0, reason: zip::Unclaimed },
    { name: "truncated.zip", at: 180, reason: zip::NoEndRecord },
    { name: "truncated_directory.zip", at: 135, reason: zip::Truncated },
  ]

test "{c.name} is rejected with the expected error at the expected offset" for c: Case in rejected_archives {
  assert_eq(
    zip::decode(archive("rejected/" ++ c.name), large_limits),
    Err({ at: c.at, reason: c.reason }),
  )
}

test "every malformed archive in the rejected fixtures directory has a test case" {
  assert_eq(
    embed_dir("zip").filter(|f: Fixture| f.name.starts_with("rejected/")).map(|f: Fixture| f.name),
    rejected_archives.map(|c: Case| "rejected/" ++ c.name),
  )
}

test "a megabyte of zeros in a kilobyte is rejected by its ratio and its size, none of it unpacked" {
  let bomb = archive("rejected/bomb.zip");
  let rejected = |limits: Limits| zip::decode(bomb, limits).err().map(|r: zip::Error| r.reason);
  assert_eq(rejected(large_limits), Some(zip::TooDense));
  assert_eq(rejected({ ..large_limits, ratio: 1015 }), Some(zip::TooDense));
  assert_eq(rejected({ ..large_limits, ratio: 1016, size: 1048575 }), Some(zip::TooLarge));
  assert_eq(rejected({ ..large_limits, ratio: 1016, total: 1048575 }), Some(zip::TooMuch));
  assert_eq(
    zip::members(bomb, { ..large_limits, ratio: 1016 }).map(|m: Member| (m.stored, m.size)),
    [(1033, 1048576)],
  )
}

test "an archive with a script stub before it is rejected by default, and read when the allowed stub size covers the stub's bytes" {
  let stubbed = archive("rejected/stub.zip");
  assert_eq(stubbed.slice(0, 17), b"#!/bin/sh\nexit 0\n");
  assert_eq(
    zip::decode(stubbed, { ..large_limits, slack: 16 }).err(),
    Some({ at: 0, reason: zip::Unclaimed }),
  );
  assert_eq(
    zip::members(stubbed, { ..large_limits, slack: 17 }).map(|m: Member| (m.header.path, m.data)),
    [("docs/hello.txt", 61), ("empty", 107)],
  )
}

test "`zip::plan` returns steps that create an archive's directories, files and links in the central directory's order" {
  assert_eq(
    zip::plan(zip::read(archive("python_stored.zip"), large_limits)),
    Ok([
      MakeDirectory("docs", 493),
      WriteFile("docs/hello.txt", 420, b"hello, zip\n"),
      MakeSymlink("docs/link", "hello.txt"),
      WriteFile("empty", 420, b""),
    ]),
  )
}

type Trap = { name: String, index: Int, path: String, reason: UnsafeReason }

const traps: List<Trap> =
  [
    { name: "traversal.zip", index: 1, path: "../outside.txt", reason: Escapes },
    { name: "absolute.zip", index: 0, path: "/etc/planted", reason: Absolute },
    { name: "backslash.zip", index: 1, path: "..\\outside.txt", reason: Backslash },
    { name: "drive.zip", index: 0, path: "C:/planted.txt", reason: Drive },
    { name: "link_escape.zip", index: 0, path: "way", reason: LinkEscapes },
    { name: "through_link.zip", index: 1, path: "way/planted.txt", reason: ThroughLink },
    { name: "fifo.zip", index: 0, path: "pipe", reason: Special },
  ]

test "{t.name} reads successfully, but `zip::plan` rejects it with the expected error" for t: Trap in traps {
  let read = zip::read(archive(t.name), large_limits);
  assert_eq(zip::plan(read), Err({ index: t.index, path: t.path, reason: t.reason }))
}

const written_entries: List<Entry> = {
  let at = DateTime(Date(19724), Time(39846000000000));
  let script = zip::file("project/bin/run", b"#!/bin/sh\nexec true\n", mode: 493, modified: at);
  let noted = zip::file("project/notes.txt", b"the same line, again and again\n".repeat(40));
  let timed = zip::file("project/timed.txt", b"when\n", mode: 384, modified: at);
  let fine = zip::file("project/fine.txt", b"finer\n", modified: at);
  [
    zip::directory("project"),
    zip::file("project/README.md", b"# project\n"),
    zip::directory("project/bin", mode: 448, modified: at),
    script,
    zip::symlink("project/latest", "bin/run"),
    { ..noted, header: { ..noted.header, comment: "said twice over" } },
    zip::file("project/stra\u{df}e-\u{6c34}.txt", b"stra\xc3\x9fe\n", modified: at),
    {
      ..timed,
      header: {
        ..timed.header,
        times: { modified: Some(Instant(1704164645000000000)), accessed: None, created: None },
        extra: [{ id: 0x7875, data: b"\x01\x04\xe8\x03\x00\x00\x04\x64\x00\x00\x00" }],
      },
    },
    {
      ..fine,
      header: {
        ..fine.header,
        times: {
          modified: Some(Instant(1704164645123456700)),
          accessed: Some(Instant(1704164646000000000)),
          created: Some(Instant(1704164640500000000)),
        },
      },
    },
    zip::file("project/empty", b""),
  ]
}

const written_listing: Bytes = embed("zip/written.listing")

fn owner(e: Entry) -> List<String> =
  match e.header.extra.filter(|f: zip::Field| f.id == 0x7875) {
    [f, ..] ->
      [f.data.u32_at(2), f.data.u32_at(7)].map(|id: Option<Int>| id.unwrap_or(0).to_string()),
    [] -> ["0", "0"],
  }

fn listing_columns(e: Entry) -> List<String> / {abort.raise} = {
  let h = e.header;
  let letter = match h.kind { zip::Directory -> "d", zip::Symlink -> "l", _ -> "-" };
  let bits = String::join(
    range(0, 9).map(|i: Int|
      if h.mode >> 8 - i & 1 == 0 { "-" } else { "rwxrwxrwx".slice(i, i + 1) }),
    "",
  );
  let day = match h.modified {
    Some(clock) -> {
      let on = date::date_of(clock);
      [
        date::month_abbreviation(date::month(on)),
        date::day(on).to_string(),
        date::year(on).to_string(),
      ]
    },
    None -> [],
  };
  let after = match h.kind {
    zip::Directory -> [h.path ++ "/"],
    zip::Symlink -> [h.path, "->", String::of_bytes(e.data)],
    _ -> [h.path],
  };
  let size = if h.kind == zip::Symlink { 0 } else { e.data.len() };
  [[letter ++ bits, "0"], owner(e), [size.to_string()], day, after].fold(
    [],
    |columns: List<String>, more: List<String>|
      more.fold(columns, |so_far: List<String>, column: String| so_far.push(column)),
  )
}

test "`zip::write` output equals the archive that bsdtar listed, and its entries list the same as bsdtar's listing" {
  let whole = zip::finish(written_entries.fold(zip::begin, zip::add), comment: b"made by std.zip");
  assert_eq(whole, archive("written.zip"));
  assert_eq(zip::read(whole, large_limits), written_entries);
  assert_eq(
    written_entries.map(listing_columns),
    String::of_bytes(written_listing).split("\n").filter(|row: String| row != "").map(
      |row: String| row.split(" ").filter(|column: String| column != ""),
    ),
  )
}
