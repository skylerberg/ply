import compiler.front (shipped_data_wanted)
import compiler.front.rows (module_of)
import compiler.syntax.items (parse, Item, FunctionItem, TypeItem, EffectItem, EffectSetItem,
                              SchemaItem, ImportDeclaration, OperationDefinition, is_pub, is_std)
import compiler.syntax.lexer (lex, Identifier, Punctuation, Keyword, EndOfInput)
import compiler.syntax.parsing (Doc, Identifier)
import std.list

type File = { name: String, bytes: Bytes }

fn tree() -> List<File> = embed_dir("../../packages/std")

type StdModule = { module: String, source: Bytes }

fn modules() -> List<StdModule> / {abort.raise} =
  tree().filter(|f: File| f.name.ends_with(".ply")).map(|f: File|
    match module_of(f.name) {
      Ok(name) -> { module: "std." ++ name, source: f.bytes },
      Err(reason) -> panic("`" ++ f.name ++ "` cannot be a module: " ++ reason),
    })

test "every non-Ply data file in the standard library directory is embedded by some library module" {
  let embedded = modules().flat_map(|m: StdModule|
    shipped_data_wanted({ name: Bytes::of_string(m.module), source_text: m.source }).map(
      String::of_bytes,
    ));
  let data_files = tree().filter(|f: File| !f.name.ends_with(".ply")).map(|f: File|
    "std/" ++ f.name);
  assert_eq(data_files.filter(|name: String| !embedded.contains(name)), [])
}

fn imported(source: Bytes) -> List<String> / {abort.raise} =
  parse(source).node.imports.map(|d: ImportDeclaration|
    String::of_bytes(Bytes::join(d.path.map(|part: Identifier| part.name), b".")))

test "{m.module} imports only library modules" for m: StdModule in modules() {
  assert_eq(imported(m.source).filter(|name: String| !is_std(Bytes::of_string(name))), [])
}

fn undocumented(module: String, source: Bytes) -> List<String> / {abort.raise} =
  parse(source).node.items.fold([], |accumulator: List<String>, it: Item| {
    let named = |name: Bytes| module ++ "." ++ String::of_bytes(name);
    match it {
      FunctionItem(d) -> if is_pub(d.visibility) && has_no_doc(d.doc) {
        accumulator.push(named(d.name.name))
      } else { accumulator },
      TypeItem(d) -> if is_pub(d.visibility) && has_no_doc(d.doc) {
        accumulator.push(named(d.name.name))
      } else { accumulator },
      SchemaItem(d) -> if is_pub(d.visibility) && has_no_doc(d.doc) {
        accumulator.push(named(d.name.name))
      } else { accumulator },
      EffectSetItem(d) -> if is_pub(d.visibility) && has_no_doc(d.doc) {
        accumulator.push(named(d.name.name))
      } else { accumulator },
      EffectItem(d) -> if !is_pub(d.visibility) { accumulator } else {
        let own = if has_no_doc(d.doc) { accumulator.push(named(d.name.name)) }
        else { accumulator };
        d.operations.fold(own, |a: List<String>, operation: OperationDefinition|
          if has_no_doc(operation.doc) {
            a.push(named(d.name.name) ++ "." ++ String::of_bytes(operation.name.name))
          } else { a })
      },
      _ -> accumulator,
    }
  })

fn has_no_doc(doc: Option<Doc>) -> Bool = match doc { None -> true, Some(_) -> false }

fn public_modules() -> List<StdModule> / {abort.raise} =
  modules().filter(|m: StdModule| !m.module.starts_with("std.internal."))

test "every name {m.module} publishes is documented" for m: StdModule in public_modules() {
  let missing = undocumented(m.module, m.source);
  assert(
    missing.len() == 0,
    Some("these are published without a `///` doc:\n" ++ String::join(missing, "\n")),
  )
}

fn unicode_readers() -> List<{ module: String, reason: String }> =
  [
    { module: "std.cli", reason: "a manual page's title is the program's name in capitals" },
    { module: "std.ini", reason: "`any_case` matches a key as Python's `configparser` folds one" },
    { module: "std.semver", reason: "`coerce` reads a version out of text a person typed" },
    { module: "std.string", reason: "the ASCII trim is stated against the prelude's" },
    {
      module: "std.tar",
      reason: "paths are compared as a file system that folds case compares them",
    },
    { module: "std.text", reason: "a shell line is rejected at white space of any script" },
  ]

fn reads_unicode(source: Bytes) -> Bool / {abort.raise} = {
  let tokens = lex(source).tokens;
  let kind = |i: Int| match tokens.at(i) { Some(t) -> t.kind, None -> EndOfInput };
  range(1, tokens.len()).fold(false, |found: Bool, i: Int|
    found
      || (match kind(i) {
        Identifier(name) ->
          (name == b"lowercase" || name == b"uppercase" || name == b"trim")
            && (kind(i - 1) == Punctuation(b"dot") || kind(i - 1) == Punctuation(b"coloncolon"))
            && kind(i + 1) == Punctuation(b"lparen")
            && kind(i - 3) != Keyword(b"fn"),
        _ -> false,
      }))
}

test "a library module that lowercases, uppercases or trims text must be listed in `unicode_readers`, which names the modules that handle human-language text" {
  let reading = modules().filter(|m: StdModule| reads_unicode(m.source));
  let found = reading.map(|m: StdModule| m.module).sort();
  let listed = unicode_readers().map(|r: { module: String, reason: String }| r.module);
  assert(
    found == listed,
    Some(
      "the modules that call `std.unicode`'s `lowercase` or `uppercase`, or `String::trim`:\n  "
        ++ String::join(found, " ")
        ++ "\nthe ones listed as reading a person's text:\n  "
        ++ String::join(listed, " ")
        ++ "\na name or a token takes `std.string`'s `ascii_lower`, `ascii_upper` or `ascii_trim`",
    ),
  )
}
