import std.bytes
import std.password
import std.password (kdf, Invalid, Valid, ValidNeedsRehash, Verdict)
import std.string

type Argon2Vector = { variant: String, tag: String }

const rfc_9106: List<Argon2Vector> =
  [
    { variant: "argon2d", tag: "512b391b6f1162975371d30919734294f868e3be3984f3c1a13a4db9fabe4acb" },
    { variant: "argon2i", tag: "c814d9d1dc7f37aa13f0d77f2494bda1c8de6b016dd388d29952a4c4672b6ce8" },
    {
      variant: "argon2id",
      tag: "0d640df58d78766c08c037a34a8b53c9d01ef0452d75b65eb52520e96b01e659",
    },
  ]

test "{c.variant} returns the tag RFC 9106 gives" for c: Argon2Vector in rfc_9106 {
  let tag = kdf.argon2(
    c.variant,
    Secret::of_bytes(byte_of_int(1).repeat(32)),
    byte_of_int(2).repeat(16),
    Secret::of_bytes(byte_of_int(3).repeat(8)),
    byte_of_int(4).repeat(12),
    32,
    3,
    4,
    32,
  );
  assert_eq(tag.hex_of(), c.tag)
}

type ScryptVector = { password: String, salt: String, log_n: Int, r: Int, p: Int, tag: String }

const rfc_7914: List<ScryptVector> =
  [
    {
      password: "",
      salt: "",
      log_n: 4,
      r: 1,
      p: 1,
      tag: "77d6576238657b203b19ca42c18a0497f16b4844e3074ae8dfdffa3fede21442fcd0069ded0948f8326a753a0fc81f17e8d3e0fb2e0d3628cf35e20c38d18906",
    },
    {
      password: "password",
      salt: "NaCl",
      log_n: 10,
      r: 8,
      p: 16,
      tag: "fdbabe1c9d3472007856e7190d01e9fe7c6ad7cbc8237830e77376634b3731622eaf30d92e22a3886ff109279d9830dac727afb94a83ee6d8360cbdfa2cc0640",
    },
    {
      password: "pleaseletmein",
      salt: "SodiumChloride",
      log_n: 14,
      r: 8,
      p: 1,
      tag: "7023bdcb3afd7348461c06cd81fd38ebfda8fbba904f8e3ea9b543f6545da1f2d5432955613f0fcf62d49705242a9af9e61e85dc0d651e40dfcf017b45575887",
    },
  ]

test "scrypt under `{c.salt}` returns the tag RFC 7914 gives" for c: ScryptVector in rfc_7914 {
  let tag = kdf.scrypt(
    Secret::of_string(c.password).bytes(),
    Bytes::of_string(c.salt),
    c.log_n,
    c.r,
    c.p,
    64,
  );
  assert_eq(tag.hex_of(), c.tag)
}

test "bcrypt and PBKDF2 return their published vectors" {
  assert_eq(
    kdf.bcrypt(
      Secret::of_bytes(b"a"),
      b"\xa3\x61\x2d\x8c\x9a\x37\xda\xc2\xf9\x9d\x94\xda\x03\xbd\x45\x21",
      6,
    ).hex_of(
    ),
    "e6d53831f82060dc08a2e8489ce850ce48fbf976978738",
  );
  assert_eq(
    kdf.pbkdf2("SHA-1", Secret::of_bytes(b"password"), b"salt", 2, 20).hex_of(),
    "ea6c014dc72d6f8ccd1ed92ace1d41f0d8de8957",
  );
  assert_eq(
    kdf.pbkdf2("SHA-256", Secret::of_bytes(b"passwd"), b"salt", 1, 64).hex_of(),
    "55ac046e56e3089fec1691c22544b605f94185216dde0465e68b9d57c20dacbc49ca9cccf179b645991664b39d77ef317c71b845b1e30bd509112041d3a19783",
  )
}

type ForeignHash = { made_by: String, password: String, text: String, verdict: Verdict }

const staple: String = "correct horse battery staple"

const foreign: List<ForeignHash> =
  [
    {
      made_by: "libargon2 through argon2-cffi 25.1.0, and OpenSSL 3.6 through cryptography 50.0.2",
      password: staple,
      text: "$argon2id$v=19$m=19456,t=2,p=1$AAECAwQFBgcICQoLDA0ODw$gYJZtjEAJqjg26xdLmknq8/bB7MiWPrE9hsYuA+SkIU",
      verdict: Valid,
    },
    {
      made_by: "libargon2's Argon2i",
      password: staple,
      text: "$argon2i$v=19$m=19456,t=2,p=1$AAECAwQFBgcICQoLDA0ODw$dYFSDMHe7r6j8bNX+Py4zNJ4v3iefrxU8sJcdB2oaAY",
      verdict: ValidNeedsRehash,
    },
    {
      made_by: "libargon2's Argon2d",
      password: staple,
      text: "$argon2d$v=19$m=19456,t=2,p=1$AAECAwQFBgcICQoLDA0ODw$TCaBtCxbgZYiqIhxXq+PsUVzIRAYPAlRckuiWVqaH94",
      verdict: ValidNeedsRehash,
    },
    {
      made_by: "libargon2 at RFC 9106's low-memory option, four lanes",
      password: staple,
      text: "$argon2id$v=19$m=65536,t=3,p=4$AAECAwQFBgcICQoLDA0ODw$hTsnKkTbFCHAKWJmmlXrCZTzyrOF7RxMeSU+7hm6tJ4",
      verdict: ValidNeedsRehash,
    },
    {
      made_by: "libargon2 under eight bytes of salt, with sixteen of tag",
      password: staple,
      text: "$argon2id$v=19$m=64,t=1,p=2$c29tZXNhbHQ$JOf2h4fID94lhr843SM7qQ",
      verdict: ValidNeedsRehash,
    },
    {
      made_by: "libargon2 of a password that is not ASCII",
      password: "pässwörd ☃",
      text: "$argon2id$v=19$m=19456,t=2,p=1$AAECAwQFBgcICQoLDA0ODw$HwYQHBoIqEYiD6HrqHlPAz1UUrb9iqeQEPI+isZaAOs",
      verdict: Valid,
    },
    {
      made_by: "libargon2 of the empty password",
      password: "",
      text: "$argon2id$v=19$m=19456,t=2,p=1$AAECAwQFBgcICQoLDA0ODw$MVSMP3rBIzE7F86FWHKNemRnE6hkgY2O2buZdxt7Gkw",
      verdict: Valid,
    },
    {
      made_by: "OpenSSL's scrypt through hashlib, and passlib 1.7.4",
      password: staple,
      text: "$scrypt$ln=14,r=8,p=1$AAECAwQFBgcICQoLDA0ODw$11kKyiyYAc8G7rp3KmncMc44YlkdllIqxOa7pq0fMaU",
      verdict: ValidNeedsRehash,
    },
    {
      made_by: "OpenSSL's scrypt mixed sixteen times",
      password: staple,
      text: "$scrypt$ln=10,r=8,p=16$AAECAwQFBgcICQoLDA0ODw$OojrDPu8KuoV5S4lhF+x5PSEGYD7+JBque7DK4lPa84",
      verdict: ValidNeedsRehash,
    },
    {
      made_by: "OpenSSL's scrypt at one of OWASP's costs",
      password: staple,
      text: "$scrypt$ln=15,r=8,p=3$AAECAwQFBgcICQoLDA0ODw$ZwXboEbK+6uo3pibyojgA4zgNULQwM2WqPlWpy+G7mc",
      verdict: ValidNeedsRehash,
    },
    {
      made_by: "pyca's bcrypt 5.0.0 as `$2b$`",
      password: staple,
      text: "$2b$05$CCCCCCCCCCCCCCCCCCCCC.poIKaw08HWUz4zkVKLs8VPIydUmXBPC",
      verdict: ValidNeedsRehash,
    },
    {
      made_by: "pyca's bcrypt as `$2a$`",
      password: staple,
      text: "$2a$06$CCCCCCCCCCCCCCCCCCCCC.uGN1ufVX4zerW2S91Qo7fWPFIKWSmsC",
      verdict: ValidNeedsRehash,
    },
    {
      made_by: "pyca's bcrypt of a password that is not ASCII",
      password: "pässwörd ☃",
      text: "$2b$05$CCCCCCCCCCCCCCCCCCCCC./W/TLMHl.yAn.BG2BGPS.olYZ3mhcN6",
      verdict: ValidNeedsRehash,
    },
    {
      made_by: "Apache's htpasswd as `$2y$`",
      password: staple,
      text: "$2y$05$uIDUI3FR2NCeusfJl/ZERexoQy/h86KuwGHAiy.srfI1lAK/.Ryna",
      verdict: ValidNeedsRehash,
    },
    {
      made_by: "passlib's PBKDF2 under SHA-256",
      password: staple,
      text: "$pbkdf2-sha256$29000$AAECAwQFBgcICQoLDA0ODw$m/kLywdyNwK9GV2kWntRGvZzmeiVsuqehNWlLst2eWY",
      verdict: ValidNeedsRehash,
    },
    {
      made_by: "passlib's PBKDF2 under SHA-512",
      password: staple,
      text: "$pbkdf2-sha512$25000$AAECAwQFBgcICQoLDA0ODw$SD45rjg2efG3ODIHQeklcrq1rgpKrbMw16UwshxvBWLgNENeDWMvNiO.Lj6BUMRx4V/sPJndUTpKWVbG79Akig",
      verdict: ValidNeedsRehash,
    },
    {
      made_by: "passlib's PBKDF2 under SHA-1",
      password: staple,
      text: "$pbkdf2$131000$AAECAwQFBgcICQoLDA0ODw$NxAwx22dqUmlCPsB1ivyDvbzOTI",
      verdict: ValidNeedsRehash,
    },
    {
      made_by: "OpenSSL's PBKDF2 at OWASP's count, in the PHC form",
      password: staple,
      text: "$pbkdf2-sha256$i=600000,l=32$AAECAwQFBgcICQoLDA0ODw$7xdxRO7JQgy8EJPSqLNEqSvFBtDU7JwCjdGfgyTYweY",
      verdict: ValidNeedsRehash,
    },
  ]

test "a hash by {c.made_by} verifies its password and no other" for c: ForeignHash in foreign {
  let now = password::owasp_argon2id;
  assert_eq(password::verify(c.text, Secret::of_string(c.password), now), c.verdict);
  assert_eq(password::verify(c.text, Secret::of_string(c.password ++ "!"), now), Invalid)
}

test "`hash_with_salt` returns the exact string libargon2 writes for argon2id and the exact string passlib writes for scrypt" {
  let secret = Secret::of_string(staple);
  let salt = Bytes::concat_all(range(0, 16).map(|i: Int| byte_of_int(i)));
  assert_eq(
    try { password::hash_with_salt(secret, password::owasp_argon2id, salt) },
    Ok(
      "$argon2id$v=19$m=19456,t=2,p=1$AAECAwQFBgcICQoLDA0ODw$gYJZtjEAJqjg26xdLmknq8/bB7MiWPrE9hsYuA+SkIU",
    ),
  );
  assert_eq(
    try { password::hash_with_salt(secret, password::scrypt(14, 8, 1), salt) },
    Ok("$scrypt$ln=14,r=8,p=1$AAECAwQFBgcICQoLDA0ODw$11kKyiyYAc8G7rp3KmncMc44YlkdllIqxOa7pq0fMaU"),
  )
}

test "bcrypt checks the first seventy-two bytes of a password and nothing after them" {
  let stored = "$2b$05$CCCCCCCCCCCCCCCCCCCCC.XxrQqgBi/5Sxuq9soXzDtjIZ7w5pMfK";
  let eighty = "0123456789".repeat(8);
  let checked = |supplied: String|
    password::verify(stored, Secret::of_string(supplied), password::owasp_argon2id);
  assert_eq(checked(eighty), ValidNeedsRehash);
  assert_eq(checked(eighty.slice(0, 72)), ValidNeedsRehash);
  assert_eq(checked(eighty.slice(0, 72) ++ "anything at all"), ValidNeedsRehash);
  assert_eq(checked(eighty.slice(0, 71)), Invalid);
  assert_eq(checked(eighty.slice(0, 71) ++ "x"), Invalid)
}

test/nondet "a hash made on the machine verifies on it" {
  let verified = [try { password::argon2id(64, 1, 1) }, try { password::scrypt(4, 1, 1) }].map(
    |made: Result<password::Params, password::Error>|
      match made {
        Err(_) -> false,
        Ok(params) -> {
          let secret = Secret::of_string("correct horse");
          let stored = password::hash(secret, params);
          password::verify(stored, secret, params) == Valid
            && password::verify(stored, Secret::of_string("correct horsf"), params) == Invalid
            && password::hash(secret, params) != stored
        },
      },
  );
  assert_eq(verified, [true, true])
}
