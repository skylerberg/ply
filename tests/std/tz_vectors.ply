import std.bytes
import std.date
import std.date (DateTime)
import std.list
import std.tz
import std.tz (Gap, Offset, Overlap, Resolution, Unique, Zone)

type Vector = { zone: String, probes: List<Bytes> }

fn vectors() -> List<Vector> / {abort.raise} =
  Bytes::split(embed("tz/zoneinfo.txt"), b"\n").fold([], |found: List<Vector>, line: Bytes|
    match line.split(b"\t") {
      [name, ..probes] -> if name.len() == 0 { found }
      else { found.push({ zone: String::of_bytes(name), probes: probes }) },
      [] -> found,
    })

fn number(parts: List<Bytes>, i: Int) -> Int / {abort.raise} =
  match parts.at_or(i, b"").int_of_ascii() {
    Some(n) -> n,
    None -> panic("a probe's field " ++ i.to_string() ++ " is no number"),
  }

fn instant(parts: List<Bytes>, i: Int) -> Instant / {abort.raise} =
  Instant(number(parts, i) * 1000000000)

fn reading(parts: List<Bytes>) -> DateTime / {abort.raise} =
  match date::of_unix_seconds(number(parts, 1)) {
    Some(read) -> date::local(read),
    None -> panic("a probe's reading is outside the calendar"),
  }

fn check_probe(z: Zone, probe: Bytes) -> Unit / {abort.raise} = {
  let parts = probe.split(b" ");
  let kind = parts.at_or(0, b"");
  if kind == b"@" {
    let expected_offset: Offset = {
      seconds: number(parts, 2),
      abbreviation: String::of_bytes(parts.at_or(3, b"")),
      daylight: parts.at_or(4, b"") == b"1",
    };
    assert_eq(tz::offset_at(z, instant(parts, 1)), expected_offset)
  } else {
    let names: Resolution = if kind == b"U" { Unique(instant(parts, 2)) }
    else if kind == b"G" { Gap({ before: instant(parts, 2), after: instant(parts, 3) }) }
    else { Overlap({ earlier: instant(parts, 2), later: instant(parts, 3) }) };
    assert_eq(tz::resolve(z, reading(parts)), Some(names))
  }
}

test "the test vectors include every zone name and every alias name that `tz` lists" {
  assert_eq(vectors().len(), tz::names().len() + tz::links().len());
  assert_eq(vectors().fold(0, |n: Int, v: Vector| n + v.probes.len()), 2482)
}

test "`tz::parse` of time zone {c.zone} gives the same offsets as Python's `zoneinfo` reading the file `zic` compiled from the time zone database" for c: Vector in vectors(
  ) {
  match tz::parse(c.zone) {
    Ok(z) -> c.probes.fold((), |_: Unit, probe: Bytes| check_probe(z, probe)),
    Err(rejected) -> panic(tz::error_message(rejected)),
  }
}

fn paris() -> Zone = tz"Europe/Paris"

test "a `tz` literal in source parses to the zone its name or offset text refers to" {
  assert_eq(Ok(paris()), tz::parse("Europe/Paris"));
  assert_eq(tz::name(tz"US/Pacific"), "America/Los_Angeles");
  assert_eq(Some(tz"+05:30"), tz::fixed(19800));
  assert_eq(tz"Etc/UTC", tz::utc());
  assert_eq(f"{tz"Asia/Kolkata"} and {tz"-03:30"}", "Asia/Kolkata and -03:30");
  assert_eq(tz::offset_at(paris(), Instant(1791158400000000000)).abbreviation, "CEST")
}
