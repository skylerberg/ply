import std.bytes
import std.crypto
import std.crypto (Sha256, Sha384, Sha512)
import std.date
import std.ip
import std.list
import std.oid
import std.result
import std.show (show)
import std.string
import std.time (nanos_at)
import std.x509
import std.x509 (x509, Certificate, Fault)

type File = { name: String, bytes: Bytes }

fn chain_files() -> List<File> = embed_dir("x509/chains")

fn root_files() -> List<File> = embed_dir("x509/roots")

fn capture_time() -> Instant / {abort.raise} =
  match date::parse_rfc3339("2026-10-06T14:54:16+00:00") {
    Some(t) -> match date::instant(t) { Some(i) -> i, None -> panic("an instant") },
    None -> panic("a time"),
  }

fn read_all(
  file: File,
  mode: x509::Strictness,
) -> Result<List<Certificate>, x509::Error> / {abort.raise} =
  try { x509::read_pem(String::of_bytes(file.bytes), x509::limits(), mode) }

fn certificates(file: File) -> List<Certificate> / {abort.raise} =
  match read_all(file, x509::Tolerant) {
    Ok(found) -> found,
    Err(rejection) -> panic(f"{file.name}: {show(rejection)}"),
  }

fn root_name(c: Certificate) -> String / {abort.raise} = x509::fingerprint(c).slice(0, 8).hex_of()

fn roots() -> List<Certificate> / {abort.raise} = root_files().flat_map(certificates)

type Chain = { leaf: Certificate, rest: List<Certificate> }

fn chain_from_file(file: String) -> Chain / {abort.raise} =
  match chain_files().filter(|f: File| f.name == file).flat_map(certificates) {
    [leaf, ..rest] -> { leaf: leaf, rest: rest },
    [] -> panic(f"no chain {file}"),
  }

fn identity(who: String) -> x509::Identity / {abort.raise} =
  match ip::parse(who) { Ok(address) -> x509::IpAddress(address), Err(_) -> x509::Host(who) }

fn digest_text(d: crypto::Digest) -> String =
  match d { Sha256 -> "SHA-256", Sha384 -> "SHA-384", Sha512 -> "SHA-512" }

fn key_and_signature(c: Certificate) -> String = {
  let key = match x509::info(c).key {
    x509::RsaKey(public) -> match crypto::rsa_modulus_bits(public) {
      Some(bits) -> f"RSA {bits}",
      None -> "RSA",
    },
    x509::EcKey(_, point) -> if point.len() == 65 { "P-256" }
    else if point.len() == 97 { "P-384" }
    else { "a curve" },
    x509::Ed25519Key(_) -> "Ed25519",
    x509::OtherKey(id, _) -> oid::to_string(id),
  };
  let signed = match x509::info(c).algorithm {
    x509::RsaPkcs1(d) -> "RSA " ++ digest_text(d),
    x509::RsaPss(d) -> "RSA-PSS " ++ digest_text(d),
    x509::Ecdsa(d) -> "ECDSA " ++ digest_text(d),
    x509::Ed25519 -> "Ed25519",
    x509::OtherAlgorithm(id) -> oid::to_string(id),
  };
  f"{key}, {signed}"
}

