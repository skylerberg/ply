fn verify_chain(
  leaf: Certificate,
  offered: List<Certificate>,
  anchors: List<Certificate>,
  at: Instant,
  who: String,
) -> Result<List<Certificate>, { leaf: Bool, reason: Fault }> / {abort.raise} =
  match x509::verify(leaf, offered, anchors, at, identity(who), x509::ServerAuth, x509::strict()) {
    Ok(path) -> Ok(path),
    Err(failure) -> Err({ leaf: failure.certificate == leaf, reason: failure.reason }),
  }

test "certificate chain file {w.file} verifies for host {w.who} against only the root {w.root}, at the time the chain was recorded" for w: ExpectedPath in expected_paths(
  ) {
  let s = chain_from_file(w.file);
  let anchor = roots().filter(|r: Certificate| root_name(r) == w.root);
  assert_eq(anchor.len(), 1);
  match verify_chain(s.leaf, s.rest, anchor, capture_time(), w.who) {
    Ok(path) -> {
      assert_eq(path.map(key_and_signature), w.path);
      assert_eq(path.at(0), Some(s.leaf));
      assert_eq(path.last(), anchor.at(0))
    },
    Err(rejected) -> panic(show(rejected.reason)),
  }
}

fn forger() -> crypto::SigningKey / {abort.raise} =
  match crypto::ed25519_signing(Secret::of_bytes(b"\x07".repeat(32))) {
    Some(key) -> key,
    None -> panic("an Ed25519 signing key can be made from any 32 bytes, so this cannot fail"),
  }

fn named_subject(name: String) -> List<x509::Attribute> = [{ id: oid::common_name(), value: name }]

fn forged(leaf: Certificate) -> Certificate / {abort.raise} = {
  let request = {
    ..x509::draft(),
    subject: named_subject("bank.example"),
    alt_names: [x509::Dns("bank.example")],
    usages: [x509::DigitalSignature],
    purposes: [x509::server_auth()],
  };
  let made = try {
    x509::certificate(
      request,
      crypto::verifying_key(forger()),
      b"\x01",
      x509::info(leaf).not_before,
      x509::info(leaf).not_after,
      Some(leaf),
      forger(),
    )
  };
  match made { Ok(c) -> c, Err(rejection) -> panic(show(rejection)) }
}

test "`verify_chain` accepts {s.file} for {s.host} and fails once it expires, for {s.wrong_host}, without the issuer, or when the leaf is a CA" for s: Site in sites(
  ) {
  let c = chain_from_file(s.file);
  let anchors = roots();
  assert_eq(verify_chain(c.leaf, c.rest, anchors, capture_time(), s.host).err(), None);
  let after = match date::instant(x509::info(c.leaf).not_after) {
    Some(end) -> Instant(nanos_at(end) + 1000000000),
    None -> panic("an instant"),
  };
  assert_eq(
    verify_chain(c.leaf, c.rest, anchors, after, s.host).err(),
    Some({ leaf: true, reason: x509::Expired }),
  );
  assert_eq(
    verify_chain(c.leaf, c.rest, anchors, capture_time(), s.wrong_host).err(),
    Some({ leaf: true, reason: x509::NameMismatch }),
  );
  let orphaned = c.rest.filter(|above: Certificate|
    x509::info(above).subject != x509::info(c.leaf).issuer);
  assert(orphaned.len() < c.rest.len());
  assert_eq(
    verify_chain(c.leaf, orphaned, anchors, capture_time(), s.host).err(),
    Some({ leaf: true, reason: x509::Unissued }),
  );
  let bank = forged(c.leaf);
  match x509::verify(
      bank,
      [c.leaf].concat(c.rest),
      anchors,
      capture_time(),
      x509::Host("bank.example"),
      x509::ServerAuth,
      x509::strict(),
    ) {
    Ok(_) -> panic("a leaf signed as a CA"),
    Err(failure) -> {
      assert(failure.certificate == c.leaf);
      assert_eq(failure.reason, x509::NotACa)
    },
  }
}

test "a certificate that names an IP address matches that address, but never matches the same text given as a hostname" {
  let cloudflare = chain_from_file("ip-cloudflare-dns.pem");
  let google = chain_from_file("ip-google-dns.pem");
  let anchors = roots();
  let named = |c: Chain, who: x509::Identity| x509::matches_identity(c.leaf, who);
  assert(named(cloudflare, identity("1.0.0.1")) && named(cloudflare, identity("1.1.1.1")));
  assert(named(google, identity("8.8.4.4")) && named(google, identity("2001:4860:4860::8888")));
  assert(!named(cloudflare, x509::Host("1.1.1.1")) && !named(google, x509::Host("8.8.8.8")));
  assert(!named(cloudflare, identity("8.8.8.8")) && !named(google, identity("1.1.1.1")));
  assert_eq(
    verify_chain(google.leaf, google.rest, anchors, capture_time(), "dns.google.example").err(),
    Some({ leaf: true, reason: x509::NameMismatch }),
  )
}

test "a certificate matches a hostname with non-ASCII characters through its punycode name, and a wildcard covers exactly one label of that name" {
  let muenchen = chain_from_file("idn-muenchen.pem").leaf;
  let buecher = chain_from_file("idn-buecher.pem").leaf;
  assert_eq(x509::alt_names(muenchen), [
    x509::Dns("www.xn--mnchen-3ya.de"),
    x509::Dns("xn--mnchen-3ya.de"),
  ]);
  assert_eq(x509::alt_names(buecher), [
    x509::Dns("*.xn--bcher-kva.de"),
    x509::Dns("xn--bcher-kva.de"),
  ]);
  let named = |c: Certificate, host: String| x509::matches_identity(c, x509::Host(host));
  assert(named(muenchen, "münchen.de") && named(muenchen, "WWW.MÜNCHEN.DE"));
  assert(named(muenchen, "xn--mnchen-3ya.de") && !named(muenchen, "mail.münchen.de"));
  assert(named(buecher, "bücher.de") && named(buecher, "shop.bücher.de"));
  assert(!named(buecher, "a.shop.bücher.de") && !named(buecher, "bucher.de"))
}

type ReadFailure = { name: String, reason: x509::Error }

fn read_failures(files: List<File>) -> List<ReadFailure> / {abort.raise} =
  files.flat_map(|f: File|
    match read_all(f, x509::Strict) {
      Ok(_) -> [],
      Err(reason) -> [{ name: f.name, reason: reason }],
    })

test "every served certificate and every root parses under strict RFC 5280 rules, except the root with serial number zero, which fails" {
  assert_eq(read_failures(chain_files()), []);
  assert_eq(read_failures(root_files()), [
    { name: "568d6905a2c88708.pem", reason: x509::BadSerial },
  ]);
  assert_eq(
    root_files().filter(|f: File| f.name == "568d6905a2c88708.pem").flat_map(certificates).map(
      |c: Certificate| x509::info(c).serial,
    ),
    [b"\x00"],
  )
}

test "each chain file matches exactly one test site, and each root file is the root that some expected chain ends in" {
  assert_eq(chain_files().map(|f: File| f.name), sites().map(|s: Site| s.file).sort());
  assert_eq(
    expected_paths().map(|w: ExpectedPath| w.file).sort().unique(),
    sites().map(|s: Site| s.file).sort(),
  );
  assert_eq(
    root_files().map(|f: File| f.name),
    expected_paths().map(|w: ExpectedPath| w.root ++ ".pem").sort().unique(),
  );
  assert_eq(roots().map(root_name), root_files().map(|f: File| f.name.strip_suffix(".pem")))
}
