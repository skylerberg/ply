//! `std.text`'s shell quoting as a real `sh` reads it. The module's own tests hold its quoting to
//! its own reader, `shell_split`; only a shell can say a shell reads it the same way.

import std.process (process, Exited)
import std.text (shell_join)

/// Words a shell reads into, or takes for its own where a command's name stands.
fn hostile_words() -> List<String> =
  [
    "",
    "plain",
    "a b",
    "it's",
    "'",
    "\"",
    "$HOME",
    "$(echo hi)",
    "`echo hi`",
    "a\\b",
    "\\",
    "a\nb",
    "a\tb",
    "x\ry",
    "*",
    "?",
    "[a-z]",
    "{a,b}",
    "~",
    "~root",
    "#x",
    "!x",
    "a;b",
    "a|b",
    "a&b",
    "a>b",
    "<",
    "(x)",
    "CC=gcc",
    "=ls",
    "--jobs=4",
    "-",
    "--",
    "if",
    "time",
    "{",
    "%1",
    "caf\u{e9}",
    "a\u{3000}b",
    "a'b\"c$d`e\\f",
  ]

/// The line `shell_join` writes of `words`, none of which holds the zero character.
fn line(words: List<String>) -> String / {abort.raise} =
  match shell_join(words) {
    Some(l) -> l,
    None -> panic("`shell_join` wrote no line of " ++ String::join(words, " ")),
  }

test/nondet "`sh` receives each hostile word quoted by `std.text` unchanged, and does not treat quoted keywords as shell syntax" {
  let read = process.spawn[sh](["-c", "printf '%s\\001' " ++ line(hostile_words())], "", []);
  assert_eq(
    read.out,
    Bytes::of_string(String::join(hostile_words().map(|word: String| word ++ "\u{1}"), "")),
  );
  ["if", "then", "do", "done", "for", "while", "case", "{", "}", "!", "CC=gcc"].fold(
    (),
    |_: Unit, word: String| {
      let named = process.spawn[sh](["-c", line([word, "true"])], "", []);
      assert(named.ended == Exited(127), Some(word ++ " was read as the shell's own"))
    },
  )
}
