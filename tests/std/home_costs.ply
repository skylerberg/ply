//! What the functions of the home modules and of the modules beneath them cost, read through
//! `std.pace`, which those modules cannot import to test themselves: `std.pace` reads the home
//! modules with no import, so an import of it from one of them would have it read itself.

import std.map (Included, Unbounded)
import std.pace (meter, spent)
import std.radix
import std.radix (Alphabet)
import std.ucd

// --- std.list ---------------------------------------------------------------

test "a slice far past the list walks the list and not the range" {
  assert(spent(|| [1, 2, 3].slice(0, 9223372036854775807)).steps < 100)
}

/// A list of `n` whose first element is `1` and every other `0`: a search for a `1`, or a check
/// that all are `0`, is decided at its front.
fn decided_first(n: Int) -> List<Int> = range(0, n).map(|i: Int| if i == 0 { 1 } else { 0 })

test "any decided at the front takes the same steps however long the rest" {
  let short = decided_first(4);
  let long = decided_first(4000);
  assert_eq(spent(|| long.any(|x: Int| x == 1)).steps, spent(|| short.any(|x: Int| x == 1)).steps)
}

test "all decided at the front takes the same steps however long the rest" {
  let short = decided_first(4);
  let long = decided_first(4000);
  assert_eq(spent(|| long.all(|x: Int| x == 0)).steps, spent(|| short.all(|x: Int| x == 0)).steps)
}

test "find decided at the front takes the same steps however long the rest" {
  let short = decided_first(4);
  let long = decided_first(4000);
  assert_eq(spent(|| long.find(|x: Int| x == 1)).steps, spent(|| short.find(|x: Int| x == 1)).steps)
}

test "find_map decided at the front takes the same steps however long the rest" {
  let short = decided_first(4);
  let long = decided_first(4000);
  let ones = |x: Int| if x == 1 { Some(x) } else { None };
  assert_eq(spent(|| long.find_map(ones)).steps, spent(|| short.find_map(ones)).steps)
}

test "find_index decided at the front takes the same steps however long the rest" {
  let short = decided_first(4);
  let long = decided_first(4000);
  assert_eq(
    spent(|| long.find_index(|x: Int| x == 1)).steps,
    spent(|| short.find_index(|x: Int| x == 1)).steps,
  )
}

// --- std.char ---------------------------------------------------------------

// A table a build did not keep is made where it is read, and `spent` charges that to each read:
// an ASCII character's count is the same either way only because it reads none.
test "an ASCII character is classified and mapped in a few calls, whatever it is" {
  let idle = spent(|| true).steps;
  let calls = |f: (Char) -> Bool|
    ['a', 'Z', '7', ' ', '\0'].map(|c: Char| spent(|| f(c)).steps - idle);
  assert_eq(calls(Char::is_whitespace), [3, 3, 3, 3, 3]);
  assert_eq(calls(Char::is_uppercase), [3, 3, 3, 3, 3]);
  assert_eq(calls(Char::is_numeric), [5, 5, 5, 5, 5]);
  assert_eq(spent(|| 'a'.is_alphabetic()).steps - idle, 5);
  assert_eq(spent(|| 'a'.general_category()).steps - idle, 3);
  assert_eq(spent(|| 'a'.to_uppercase()).steps - idle, 4);
  assert_eq(spent(|| '7'.decimal_value()).steps - idle, 3)
}

// Each count is held to another that reads the same table once, so it holds whether or not a build
// kept the table.
test "a character past ASCII takes a few calls and one read of a table, wherever it lies" {
  let alphabetic = |c: Char| spent(|| c.is_alphabetic()).steps;
  let read = alphabetic('\u{E9}');
  assert_eq(['\u{4E2D}', '\u{1F600}', '\u{10FFFF}'].map(alphabetic), [read, read, read]);
  assert_eq(
    [
      spent(|| '\u{E9}'.general_category()).steps,
      spent(|| '\u{663}'.decimal_value()).steps,
      spent(|| '\u{BD}'.is_numeric()).steps,
    ].map(|steps: Int| steps - read),
    [-1, -2, 1],
  )
}

// --- std.bytes --------------------------------------------------------------

test "a pattern cycles in steps that do not grow with its length" {
  assert(spent(|| b"x".cycle(1000000)).steps < 32)
}

test "hex takes at most a step a byte either way, and allocates only as its answer grows" {
  let within = |got: Int, most: Int|
    assert(got <= most, Some(got.to_string() ++ " is past " ++ most.to_string()));
  let written = |b: Bytes| spent(|| b.hex_of());
  let read = |b: Bytes| {
    let text = b.hex_of();
    spent(|| Bytes::of_hex(text))
  };
  let short = b"\x5a\xc3".repeat(32);
  let long = b"\x5a\xc3".repeat(544);
  within(written(long).steps - written(short).steps, 1024);
  within(read(long).steps - read(short).steps, 1024);
  within(written(long).allocations - written(short).allocations, 8);
  within(read(long).allocations - read(short).allocations, 8);
  // A digest is what most calls are handed.
  let digest = b"\x5a".repeat(32);
  within(written(digest).steps, 48);
  within(read(digest).steps, 52);
  within(written(digest).allocations, 10);
  within(read(digest).allocations, 12)
}

// --- std.option -------------------------------------------------------------

test "a traverse and a fold that answer none first take the same steps whatever follows" {
  let short = [0 - 1, 2, 4, 6];
  let long = range(0, 4000).fold([0 - 1], |acc: List<Int>, i: Int| acc.push(i));
  let kept = |x: Int| if x < 0 { None } else { Some(x) };
  let stepped = |sum: Int, x: Int| if x < 0 { None } else { Some(sum + x) };
  assert_eq(
    spent(|| Option::traverse(long, kept)).steps,
    spent(|| Option::traverse(short, kept)).steps,
  );
  assert_eq(
    spent(|| Option::try_fold(long, 0, stepped)).steps,
    spent(|| Option::try_fold(short, 0, stepped)).steps,
  )
}

fn missing_first(n: Int) -> List<Option<Int>> =
  range(0, n).map(|i: Int| if i == 0 { None } else { Some(i) })

test "a missing value at the front ends the walk in the same steps whatever follows it" {
  let short = missing_first(4);
  let long = missing_first(4000);
  assert_eq(spent(|| Option::all(long)).steps, spent(|| Option::all(short)).steps)
}

// --- std.result -------------------------------------------------------------

fn halved(x: Int) -> Result<Int, String> =
  if x % 2 == 0 { Ok(x / 2) } else { Err(x.to_string() ++ " is odd") }

fn failed_first(n: Int) -> List<Result<Int, Int>> =
  range(0, n).map(|i: Int| if i == 0 { Err(i) } else { Ok(i) })

test "a failure at the front ends the walk in the same steps whatever follows it" {
  let short = failed_first(4);
  let long = failed_first(4000);
  assert_eq(spent(|| Result::all(long)).steps, spent(|| Result::all(short)).steps)
}

test "a traverse and a fold whose step fails first take the same steps whatever follows" {
  let short = [1, 2, 4, 6];
  let long = [1].concat(range(0, 4000));
  let stepped = |sum: Int, x: Int| if x % 2 == 1 { Err(x) } else { Ok(sum + x) };
  assert_eq(
    spent(|| Result::traverse(long, halved)).steps,
    spent(|| Result::traverse(short, halved)).steps,
  );
  assert_eq(
    spent(|| Result::try_fold(long, 0, stepped)).steps,
    spent(|| Result::try_fold(short, 0, stepped)).steps,
  )
}

// --- std.map ----------------------------------------------------------------

fn counted(i: Int, n: Int, acc: Map<Int, Int>) -> Map<Int, Int> =
  if i >= n { acc } else { counted(i + 1, n, acc.insert(i, i * 10)) }

/// `i` under `10 * i` for every `i` from zero to below `n`.
fn numbered(n: Int) -> Map<Int, Int> = counted(0, n, Map::new())

test "an ordered query makes the same on a map of a hundred entries and of a hundred thousand, and walks only down the tree" {
  let cost = |n: Int| {
    let m = numbered(n);
    let made = spent(||
      {
        first: m.first(),
        last: m.last(),
        floor: m.floor(n / 2),
        ceiling: m.ceiling(n / 2),
        below: m.below(n / 2),
        above: m.above(n / 2),
        page: m.entries_between_take(Included(n / 3), Unbounded, 10),
      });
    { steps: made.steps, allocations: made.allocations }
  };
  let small = cost(100);
  let large = cost(100000);
  assert_eq(large.allocations, small.allocations);
  assert(small.allocations <= 40, Some(small.allocations.to_string()));
  // A thousand times the entries is two levels more of the tree, each a walk of a branch at most.
  assert(large.steps <= 4 * small.steps, Some(large.steps.to_string()))
}

/// The keys popped from the front of `m`, each read once, in a loop that holds the map alone.
fn drained(m: Map<Int, Int>, left: Int, sum: Int) -> Int =
  if left <= 0 { sum } else {
    match m.pop_first() {
      None -> sum,
      Some(popped) -> drained(popped.rest, left - 1, sum + popped.key),
    }
  }

test "a pop of a map nothing else holds copies none of it" {
  let cost = |n: Int| {
    let built = spent(|| numbered(n).size()).allocations;
    spent(|| drained(numbered(n), n, 0)).allocations - built
  };
  // Each pop makes at most its answer, a record and its `Some`, so four times the pops cost four
  // times as much; a copy of the map would cost more the more it holds.
  assert(cost(1000) <= 2 * 1000, Some(cost(1000).to_string()));
  assert_eq(cost(4000), 4 * cost(1000))
}

test "a split of a map nothing else holds makes a node for each level it cuts" {
  let cost = |n: Int| {
    let built = spent(|| numbered(n).size()).allocations;
    spent(|| numbered(n).split(n / 2).below.size()).allocations - built
  };
  assert(cost(100) <= 8, Some(cost(100).to_string()));
  assert(cost(100000) <= 12, Some(cost(100000).to_string()))
}

test "merge_with takes the steps of the smaller map, whichever side it is on" {
  let small = numbered(8);
  let steps = |n: Int| {
    let large = numbered(n);
    spent(|| large.merge_with(small, |x: Int, y: Int| x + y).size()).steps
      + spent(|| small.merge_with(large, |x: Int, y: Int| x + y).size()).steps
  };
  // Five times the entries, in a tree two levels of branches deep either way.
  assert_eq(steps(1000), steps(5000))
}

// --- std.radix --------------------------------------------------------------

/// The alphabet of `symbols`, unpadded.
fn of_symbols(symbols: Bytes) -> Alphabet / {abort.raise} =
  match radix::alphabet(symbols, false) {
    Some(a) -> a,
    None -> panic("these symbols are no alphabet"),
  }

/// Every alphabet `std.radix` names, and one of each width it names none of, each padded and
/// unpadded.
fn every() -> List<Alphabet> / {abort.raise} =
  [
    radix::base16(),
    radix::hex(),
    radix::base32(),
    radix::base32hex(),
    radix::crockford(),
    radix::base64(),
    radix::base64url(),
    of_symbols(b"01"),
    of_symbols(b"ACGT"),
    of_symbols(b"01234567"),
  ].fold([], |all: List<Alphabet>, a: Alphabet| all.push(radix::padded(a)).push(radix::unpadded(a)))

/// `data` repeated, with a zero, a full and a mixed byte after it, cut to `n` counted round 64.
fn stretched(data: Bytes, n: Int) -> Bytes / {abort.raise} = {
  let want = (n % 64 + 64) % 64;
  let seed = data.concat(b"\x00\xff\x5a");
  Bytes::concat_all(range(0, want / seed.len() + 1).map(|_: Int| seed)).slice(0, want)
}

test "two inputs of one length cost the same steps, whatever they hold" {
  let zeros = stretched(b"\x00", 23);
  let mixed = stretched(b"\xff\x10\x80\x7f\x01\xaa\x55", 23);
  every().fold((), |_: Unit, a: Alphabet| {
    assert_eq(spent(|| radix::encode(a, zeros)).steps, spent(|| radix::encode(a, mixed)).steps);
    let quiet = radix::encode(a, zeros);
    let loud = radix::encode(a, mixed);
    assert_eq(spent(|| radix::decode(a, quiet)).steps, spent(|| radix::decode(a, loud)).steps)
  })
}

/// What `f` costs over `long` beyond what it costs over `short`.
fn growth<a, b | e>(
  f: (a) -> b / e,
  short: a,
  long: a,
) -> { steps: Int, allocations: Int } / {meter.read | e} = {
  let less = spent(|| f(short));
  let more = spent(|| f(long));
  { steps: more.steps - less.steps, allocations: more.allocations - less.allocations }
}

test "a whole quantum is at most a step either way, and none allocates but to grow the answer" {
  let within = |got: Int, most: Int|
    assert(got <= most, Some(got.to_string() ++ " is past " ++ most.to_string()));
  // The bytes a whole quantum of each alphabet's symbols carries.
  [
    { a: radix::hex(), span: 1 },
    { a: radix::base16(), span: 1 },
    { a: radix::base32(), span: 5 },
    { a: radix::base32hex(), span: 5 },
    { a: radix::crockford(), span: 5 },
    { a: radix::base64(), span: 3 },
    { a: radix::base64url(), span: 3 },
  ].fold((), |_: Unit, q: { a: Alphabet, span: Int }| {
    let short = stretched(b"\x5a\xc3", 60);
    let long = Bytes::concat_all(range(0, 1024 * q.span / 60 + 1).map(|_: Int| short));
    let written = growth(|d: Bytes| radix::encode(q.a, d), short, long);
    let read = growth(
      |t: String| radix::decode(q.a, t),
      radix::encode(q.a, short),
      radix::encode(q.a, long),
    );
    within(written.steps, 1024);
    within(read.steps, 1024);
    within(written.allocations, 8);
    within(read.allocations, 8)
  })
}

// --- std.ucd ----------------------------------------------------------------

test "a lookup takes the same steps wherever the code point lies" {
  let held = ucd::table_of(
    [
      { first: 0x41, last: 0x5A, value: 1 },
      { first: 0x61, last: 0x61, value: 2 },
      { first: 0x10FFFE, last: 0x10FFFF, value: 3 },
    ],
    0,
  );
  let steps = [0x41, 0x61, 0x10FFFF, 0x110000].map(|cp: Int| spent(|| ucd::lookup(held, cp)).steps);
  assert_eq(steps.map(|s: Int| s - steps.get(0)), [0, 0, 0, 0])
}
