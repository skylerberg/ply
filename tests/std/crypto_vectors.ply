import std.bytes
import std.crypto
import std.crypto (Aes256Gcm, ChaCha20Poly1305, Der, NistP256, NistP384, NistP521, Raw, Secp256k1,
                   Sha256, Sha384, Sha512, SmallOrder)
import std.ed25519
import std.hash (OutputLength, hkdf, hmac_sha256, sha256_hash, tags_match)
import std.json
import std.json (Json)
import std.list
import std.pem

fn member(j: Json, name: String) -> Json =
  match json::get(j, name) { Some(v) -> v, None -> json::Null }

fn text(j: Json, name: String) -> String = match member(j, name) { json::Str(s) -> s, _ -> "" }

fn integer(j: Json, name: String) -> Int =
  match member(j, name) {
    json::Number(n) -> match Int::of_decimal(n, Down) { Some(i) -> i, None -> 0 },
    _ -> 0,
  }

fn items(j: Json, name: String) -> List<Json> =
  match member(j, name) { json::Array(xs) -> xs, _ -> [] }

fn hex_bytes(j: Json, name: String) -> Bytes / {abort.raise} = Bytes::of_hex(text(j, name))

fn flags(j: Json) -> List<String> =
  items(j, "flags").map(|f: Json| match f { json::Str(s) -> s, _ -> "" })

fn read(file: Bytes) -> Json / {abort.raise} =
  match json::parse(file) { Ok(j) -> j, Err(e) -> panic(json::error_to_string(e)) }

fn cases<a>(file: Bytes, of: (Json, Json) -> a / {abort.raise}) -> List<a> / {abort.raise} =
  items(read(file), "testGroups").fold([], |all: List<a>, group: Json|
    items(group, "tests").fold(all, |accumulator: List<a>, t: Json| accumulator.push(of(group, t))))

fn tally(results: List<String>) -> { valid: Int, acceptable: Int, invalid: Int } =
  results.fold(
    { valid: 0, acceptable: 0, invalid: 0 },
    |n: { valid: Int, acceptable: Int, invalid: Int }, r: String|
      match r {
        "valid" -> { ..n, valid: n.valid + 1 },
        "acceptable" -> { ..n, acceptable: n.acceptable + 1 },
        _ -> { ..n, invalid: n.invalid + 1 },
      },
  )

type Aead = {
  id: Int,
  comment: String,
  result: String,
  key_bits: Int,
  nonce_bits: Int,
  key: Bytes,
  nonce: Bytes,
  associated: Bytes,
  plaintext: Bytes,
  ciphertext: Bytes,
  tag: Bytes,
}

fn aead(file: Bytes) -> List<Aead> / {abort.raise} =
  cases(file, |group: Json, t: Json|
    {
      id: integer(t, "tcId"),
      comment: text(t, "comment"),
      result: text(t, "result"),
      key_bits: integer(group, "keySize"),
      nonce_bits: integer(group, "ivSize"),
      key: hex_bytes(t, "key"),
      nonce: hex_bytes(t, "iv"),
      associated: hex_bytes(t, "aad"),
      plaintext: hex_bytes(t, "msg"),
      ciphertext: hex_bytes(t, "ct"),
      tag: hex_bytes(t, "tag"),
    })

fn aes_gcm_all() -> List<Aead> / {abort.raise} = aead(embed("crypto/aes_gcm_test.json"))

fn aes_gcm() -> List<Aead> / {abort.raise} =
  aes_gcm_all().filter(|c: Aead| c.key_bits == 256 && c.nonce_bits == 96)

fn chacha20() -> List<Aead> / {abort.raise} = aead(embed("crypto/chacha20_poly1305_test.json"))

fn xchacha20() -> List<Aead> / {abort.raise} = aead(embed("crypto/xchacha20_poly1305_test.json"))

fn check_aead(cipher: crypto::Cipher, c: Aead) -> Unit / {abort.raise} = {
  let key = match crypto::counted_key(cipher, Secret::of_bytes(c.key)) {
    Some(k) -> k,
    None -> panic("a key"),
  };
  let text = c.ciphertext.concat(c.tag);
  if c.result == "valid" {
    assert_eq(
      crypto::without_nonce_check(|| crypto::seal_at(key, c.nonce, c.plaintext, c.associated)),
      text,
    );
    assert_eq(crypto::open_at(key, c.nonce, text, c.associated), Some(c.plaintext))
  } else { assert_eq(crypto::open_at(key, c.nonce, text, c.associated), None) }
}

test "Wycheproof AES-256-GCM {c.id}: {c.comment}" for c: Aead in aes_gcm() {
  check_aead(Aes256Gcm, c)
}

test "Wycheproof ChaCha20-Poly1305 {c.id}: {c.comment}" for c: Aead in chacha20() {
  check_aead(ChaCha20Poly1305, c)
}

test "Wycheproof XChaCha20-Poly1305 {c.id}: {c.comment}" for c: Aead in xchacha20() {
  let key = match crypto::seal_key(Secret::of_bytes(c.key)) {
    Some(k) -> k,
    None -> panic("a key"),
  };
  let text = Bytes::concat_all([c.nonce, c.ciphertext, c.tag]);
  if c.result == "valid" {
    assert_eq(crypto::seal_with_nonce(key, c.nonce, c.plaintext, c.associated), text);
    assert_eq(crypto::open(key, text, c.associated), Some(c.plaintext))
  } else { assert_eq(crypto::open(key, text, c.associated), None) }
}

test "the AEAD vector files have the expected case counts, including the AES-GCM cases with other key sizes and nonce sizes that the other tests skip" {
  let gcm = aes_gcm_all();
  assert_eq(gcm.len(), 316);
  assert_eq(gcm.filter(|c: Aead| c.key_bits != 256).len(), 211);
  assert_eq(gcm.filter(|c: Aead| c.key_bits == 256 && c.nonce_bits != 96).len(), 39);
  assert_eq(tally(aes_gcm().map(|c: Aead| c.result)), { valid: 39, acceptable: 0, invalid: 27 });
  assert_eq(tally(chacha20().map(|c: Aead| c.result)), { valid: 256, acceptable: 0, invalid: 69 });
  assert_eq(tally(xchacha20().map(|c: Aead| c.result)), { valid: 246, acceptable: 0, invalid: 69 })
}

type SignatureVector = {
  id: Int,
  comment: String,
  result: String,
  flags: List<String>,
  public: Bytes,
  message: Bytes,
  signature: Bytes,
}

fn signature_vectors(
  file: Bytes,
  public: (Json) -> Bytes / {abort.raise},
) -> List<SignatureVector> / {abort.raise} =
  cases(file, |group: Json, t: Json|
    {
      id: integer(t, "tcId"),
      comment: text(t, "comment"),
      result: text(t, "result"),
      flags: flags(t),
      public: public(group),
      message: hex_bytes(t, "msg"),
      signature: hex_bytes(t, "sig"),
    })

fn eddsa() -> List<SignatureVector> / {abort.raise} =
  signature_vectors(embed("crypto/ed25519_test.json"), |group: Json|
    hex_bytes(member(group, "publicKey"), "pk"))

fn point(group: Json) -> Bytes / {abort.raise} =
  hex_bytes(member(group, "publicKey"), "uncompressed")

fn ecdsa_raw() -> List<SignatureVector> / {abort.raise} =
  signature_vectors(embed("crypto/ecdsa_secp256r1_sha256_p1363_test.json"), point)

fn ecdsa_der() -> List<SignatureVector> / {abort.raise} =
  signature_vectors(embed("crypto/ecdsa_secp256r1_sha256_test.json"), point)

fn p384_der() -> List<SignatureVector> / {abort.raise} =
  signature_vectors(embed("crypto/ecdsa_secp384r1_sha384_test.json"), point)

fn p384_raw() -> List<SignatureVector> / {abort.raise} =
  signature_vectors(embed("crypto/ecdsa_secp384r1_sha384_p1363_test.json"), point)

fn p384_sha256() -> List<SignatureVector> / {abort.raise} =
  signature_vectors(embed("crypto/ecdsa_secp384r1_sha256_test.json"), point)

fn p521_raw() -> List<SignatureVector> / {abort.raise} =
  signature_vectors(embed("crypto/ecdsa_secp521r1_sha512_p1363_test.json"), point)

fn k256_raw() -> List<SignatureVector> / {abort.raise} =
  signature_vectors(embed("crypto/ecdsa_secp256k1_sha256_p1363_test.json"), point)

fn rsa_pkcs1() -> List<SignatureVector> / {abort.raise} =
  signature_vectors(embed("crypto/rsa_signature_2048_sha256_test.json"), |group: Json|
    hex_bytes(group, "publicKeyAsn"))

fn rsa_pss() -> List<SignatureVector> / {abort.raise} =
  signature_vectors(embed("crypto/rsa_pss_2048_sha256_mgf1_32_test.json"), |group: Json|
    hex_bytes(group, "publicKeyAsn"))

fn check_signature(key: Option<crypto::VerifyingKey>, c: SignatureVector) -> Unit / {abort.raise} =
  match key {
    None -> panic("a vector's key is a key"),
    Some(k) -> assert_eq(crypto::verify(k, c.message, c.signature), c.result == "valid"),
  }

test "Wycheproof Ed25519 {c.id}: {c.comment}" for c: SignatureVector in eddsa() {
  check_signature(crypto::ed25519_verifying(c.public), c);
  assert_eq(ed25519::verify(c.public, c.message, c.signature), c.result == "valid")
}

test "Wycheproof ECDSA P-256, r and s: {c.id}: {c.comment}" for c: SignatureVector in ecdsa_raw() {
  check_signature(crypto::ecdsa_verifying(NistP256, Sha256, c.public, Raw), c)
}

test "Wycheproof ECDSA P-256, DER: {c.id}: {c.comment}" for c: SignatureVector in ecdsa_der() {
  check_signature(crypto::ecdsa_verifying(NistP256, Sha256, c.public, Der), c)
}

test "Wycheproof ECDSA P-384, DER: {c.id}: {c.comment}" for c: SignatureVector in p384_der() {
  check_signature(crypto::ecdsa_verifying(NistP384, Sha384, c.public, Der), c)
}

test "Wycheproof ECDSA P-384, r and s: {c.id}: {c.comment}" for c: SignatureVector in p384_raw() {
  check_signature(crypto::ecdsa_verifying(NistP384, Sha384, c.public, Raw), c)
}

test "Wycheproof ECDSA P-384 over SHA-256, DER: {c.id}: {c.comment}" for c: SignatureVector in p384_sha256(
  ) { check_signature(crypto::ecdsa_verifying(NistP384, Sha256, c.public, Der), c) }

test "Wycheproof ECDSA P-521, r and s: {c.id}: {c.comment}" for c: SignatureVector in p521_raw() {
  check_signature(crypto::ecdsa_verifying(NistP521, Sha512, c.public, Raw), c)
}

test "Wycheproof ECDSA secp256k1, r and s: {c.id}: {c.comment}" for c: SignatureVector in k256_raw(
  ) { check_signature(crypto::ecdsa_verifying(Secp256k1, Sha256, c.public, Raw), c) }

test "Wycheproof RSA PKCS #1 v1.5 {c.id}: {c.comment}" for c: SignatureVector in rsa_pkcs1() {
  check_signature(crypto::rsa_pkcs1_verifying(c.public, Sha256), c)
}

test "Wycheproof RSA PSS {c.id}: {c.comment}" for c: SignatureVector in rsa_pss() {
  check_signature(crypto::rsa_pss_verifying(c.public, Sha256), c)
}

test "each signature test vector file has the expected number of valid and invalid vectors, and none has the result acceptable" {
  assert_eq(tally(eddsa().map(|c: SignatureVector| c.result)), {
    valid: 88,
    acceptable: 0,
    invalid: 63,
  });
  assert_eq(tally(ecdsa_raw().map(|c: SignatureVector| c.result)), {
    valid: 173,
    acceptable: 0,
    invalid: 89,
  });
  assert_eq(tally(ecdsa_der().map(|c: SignatureVector| c.result)), {
    valid: 174,
    acceptable: 0,
    invalid: 310,
  });
  assert_eq(tally(p384_der().map(|c: SignatureVector| c.result)), {
    valid: 194,
    acceptable: 0,
    invalid: 310,
  });
  assert_eq(tally(p384_raw().map(|c: SignatureVector| c.result)), {
    valid: 193,
    acceptable: 0,
    invalid: 87,
  });
  assert_eq(tally(p384_sha256().map(|c: SignatureVector| c.result)), {
    valid: 162,
    acceptable: 0,
    invalid: 310,
  });
  assert_eq(tally(p521_raw().map(|c: SignatureVector| c.result)), {
    valid: 231,
    acceptable: 0,
    invalid: 87,
  });
  assert_eq(tally(k256_raw().map(|c: SignatureVector| c.result)), {
    valid: 167,
    acceptable: 0,
    invalid: 85,
  });
  assert_eq(tally(rsa_pkcs1().map(|c: SignatureVector| c.result)), {
    valid: 9,
    acceptable: 1,
    invalid: 249,
  });
  assert_eq(
    rsa_pkcs1().filter(|c: SignatureVector| c.result == "acceptable").map(|c: SignatureVector|
      c.flags),
    [["MissingNull"]],
  );
  assert_eq(tally(rsa_pss().map(|c: SignatureVector| c.result)), {
    valid: 63,
    acceptable: 0,
    invalid: 45,
  })
}

type AgreementVector = {
  id: Int,
  comment: String,
  result: String,
  flags: List<String>,
  private: Bytes,
  public: Bytes,
  shared: Bytes,
}

fn agreement_vectors(file: Bytes) -> List<AgreementVector> / {abort.raise} =
  cases(file, |_group: Json, t: Json|
    {
      id: integer(t, "tcId"),
      comment: text(t, "comment"),
      result: text(t, "result"),
      flags: flags(t),
      private: hex_bytes(t, "private"),
      public: hex_bytes(t, "public"),
      shared: hex_bytes(t, "shared"),
    })

fn xdh() -> List<AgreementVector> / {abort.raise} =
  agreement_vectors(embed("crypto/x25519_test.json"))

fn ecdh() -> List<AgreementVector> / {abort.raise} =
  agreement_vectors(embed("crypto/ecdh_secp256r1_ecpoint_test.json"))

fn rejected_peer_flags() -> List<String> = ["LowOrderPublic", "SmallPublicKey", "ZeroSharedSecret"]

fn is_rejected(c: AgreementVector) -> Bool =
  c.flags.fold(false, |any: Bool, f: String| any || rejected_peer_flags().contains(f))

test "Wycheproof X25519 {c.id}: {c.comment}" for c: AgreementVector in xdh() {
  let key = match crypto::x25519_key(Secret::of_bytes(c.private)) {
    Some(k) -> k,
    None -> panic("a key"),
  };
  let peer = match crypto::x25519_peer(c.public) { Some(p) -> p, None -> panic("a peer") };
  assert_eq(is_rejected(c), c.shared == b"\x00".repeat(32));
  if is_rejected(c) { assert_eq(crypto::agree(key, peer), Err(SmallOrder)) }
  else { assert_eq(crypto::agree(key, peer), Ok(Secret::of_bytes(c.shared))) }
}

fn scalar(number: Bytes) -> Bytes / {abort.raise} = {
  let digits = number.strip_leading_zeros();
  b"\x00".repeat(32 - digits.len()).concat(digits)
}

test "Wycheproof ECDH P-256 {c.id}: {c.comment}" for c: AgreementVector in ecdh() {
  let key = match crypto::p256_key(Secret::of_bytes(scalar(c.private))) {
    Some(k) -> k,
    None -> panic("a key"),
  };
  match crypto::p256_peer(c.public) {
    Some(peer) -> {
      assert_eq(c.result, "valid");
      assert_eq(crypto::agree(key, peer), Ok(Secret::of_bytes(c.shared)))
    },
    None -> assert(c.result != "valid"),
  }
}

test "each key agreement vector file has the expected result counts, and an acceptable vector is rejected exactly when its flags mark it as rejected" {
  let x = xdh();
  assert_eq(tally(x.map(|c: AgreementVector| c.result)), {
    valid: 264,
    acceptable: 254,
    invalid: 0,
  });
  assert_eq(x.filter(is_rejected).len(), 31);
  assert_eq(x.filter(|c: AgreementVector| c.result == "acceptable" && !is_rejected(c)).len(), 223);
  assert_eq(x.filter(|c: AgreementVector| c.result == "valid" && is_rejected(c)).len(), 0);
  let p = ecdh();
  assert_eq(tally(p.map(|c: AgreementVector| c.result)), {
    valid: 330,
    acceptable: 1,
    invalid: 24,
  });
  assert_eq(
    p.filter(|c: AgreementVector| c.result == "acceptable").map(|c: AgreementVector| c.flags),
    [["CompressedPublic", "CompressedPoint"]],
  )
}

type Mac = { id: Int, comment: String, result: String, key: Bytes, message: Bytes, tag: Bytes }

fn macs() -> List<Mac> / {abort.raise} =
  cases(embed("crypto/hmac_sha256_test.json"), |_group: Json, t: Json|
    {
      id: integer(t, "tcId"),
      comment: text(t, "comment"),
      result: text(t, "result"),
      key: hex_bytes(t, "key"),
      message: hex_bytes(t, "msg"),
      tag: hex_bytes(t, "tag"),
    })

test "Wycheproof HMAC-SHA-256 {c.id}: {c.comment}" for c: Mac in macs() {
  let whole = hmac_sha256(Secret::of_bytes(c.key), c.message);
  assert_eq(tags_match(whole.slice(0, c.tag.len()), c.tag), c.result == "valid")
}

type HkdfVector = {
  id: Int,
  comment: String,
  result: String,
  key: Bytes,
  salt: Bytes,
  info: Bytes,
  size: Int,
  output: Bytes,
}

fn derivations() -> List<HkdfVector> / {abort.raise} =
  cases(embed("crypto/hkdf_sha256_test.json"), |_group: Json, t: Json|
    {
      id: integer(t, "tcId"),
      comment: text(t, "comment"),
      result: text(t, "result"),
      key: hex_bytes(t, "ikm"),
      salt: hex_bytes(t, "salt"),
      info: hex_bytes(t, "info"),
      size: integer(t, "size"),
      output: hex_bytes(t, "okm"),
    })

test "Wycheproof HKDF-SHA-256 {c.id}: {c.comment}" for c: HkdfVector in derivations() {
  let made = try { hkdf(sha256_hash(), c.salt, Secret::of_bytes(c.key), c.info, c.size) };
  if c.result == "valid" { assert_eq(made, Ok(Secret::of_bytes(c.output))) }
  else { assert_eq(made, Err(OutputLength(c.size))) }
}

test "the HMAC and HKDF vector files have the expected counts of valid and invalid cases" {
  assert_eq(tally(macs().map(|c: Mac| c.result)), { valid: 66, acceptable: 0, invalid: 108 });
  assert_eq(tally(derivations().map(|c: HkdfVector| c.result)), {
    valid: 83,
    acceptable: 0,
    invalid: 3,
  })
}

fn rsa_document() -> Bytes = embed("asn1/rsa_key.der")

fn ec_document() -> Bytes = embed("asn1/ec_key.der")

fn message() -> Bytes = b"what was built"

type RsaSignature = { digest: crypto::Digest, name: String, signature: String }

fn rsa_signatures() -> List<RsaSignature> =
  [
    {
      digest: Sha256,
      name: "SHA-256",
      signature: "",
    },
    {
      digest: Sha384,
      name: "SHA-384",
      signature: "",
    },
    {
      digest: Sha512,
      name: "SHA-512",
      signature: "",
    },
  ]

test "the suite's RSA key signs PKCS #1 v1.5 over {c.name} as openssl does" for c: RsaSignature in rsa_signatures(
  ) {
  let key = match crypto::rsa_pkcs1_signing(Secret::of_bytes(rsa_document()), c.digest) {
    Some(k) -> k,
    None -> panic("an RSA key"),
  };
  let signature = crypto::sign(key, message());
  assert_eq(signature, Bytes::of_hex(c.signature));
  assert(crypto::verify(crypto::verifying_key(key), message(), signature));
  assert(!crypto::verify(crypto::verifying_key(key), b"what was not", signature));
  assert_eq(
    Some(crypto::verifying_key(key)),
    crypto::rsa_pkcs1_verifying(crypto::verifying_bytes(crypto::verifying_key(key)), c.digest),
  )
}

test "`private_key_of_der` decodes DER private keys into typed keys that stay inside a `Secret`, and rejects malformed DER" {
  assert(
    crypto::private_key_of_der(Secret::of_bytes(rsa_document()))
      == Some(crypto::RsaPrivate(Secret::of_bytes(rsa_document()))),
  );
  let scalar = ec_document().slice(36, 68);
  assert(
    crypto::private_key_of_der(Secret::of_bytes(ec_document()))
      == Some(crypto::EcPrivate(NistP256, Secret::of_bytes(scalar))),
  );
  let seed = Bytes::of_hex("d4ee72dbf913584ad5b6d8f1f769f8ad3afe7c28cbf1d4fbe097a88f44755842");
  let ed = Bytes::of_hex("302e020100300506032b657004220420").concat(seed);
  assert(
    crypto::private_key_of_der(Secret::of_bytes(ed))
      == Some(crypto::Ed25519Private(Secret::of_bytes(seed))),
  );
  let x = Bytes::of_hex("302e020100300506032b656e04220420").concat(seed);
  assert(
    crypto::private_key_of_der(Secret::of_bytes(x))
      == Some(crypto::X25519Private(Secret::of_bytes(seed))),
  );
  assert(crypto::private_key_of_der(Secret::of_bytes(b"")) == None);
  assert(crypto::private_key_of_der(Secret::of_bytes(ed.slice(0, 47))) == None);
  assert(crypto::private_key_of_der(Secret::of_bytes(ed.concat(b"\x00"))) == None)
}

test "signing with the test P-256 key gives the signature openssl produces under RFC 6979, and the public key from the same DER file verifies it" {
  let scalar = match crypto::private_key_of_der(Secret::of_bytes(ec_document())) {
    Some(crypto::EcPrivate(NistP256, s)) -> s,
    _ -> panic("a P-256 key"),
  };
  let key = match crypto::ecdsa_signing(NistP256, scalar, Der) {
    Some(k) -> k,
    None -> panic("a key"),
  };
  let signature = Bytes::of_hex(
    "3044022023f774b41482f28d905375ddc0ba396eae186775a7696ac4c39574f33b50daea02202fbf60c0a422d528bc83da32db56a742227b96b3d5df36356c82259573059ec1",
  );
  assert_eq(crypto::sign(key, message()), signature);
  let spki = Bytes::of_hex(
    "3059301306072a8648ce3d020106082a8648ce3d03010703420004c5cba56fc8f39f5e9e8f2b3bef4ffcaf1823b22ca88604f93fe3b37e44e30c954e79edb1bc8a0c0f54e6251339eedadb37478139c4a56e19b29f7adbfe637a98",
  );
  match crypto::spki_decode(spki) {
    Some(crypto::P256Public(found)) -> {
      assert_eq(
        Some(crypto::verifying_key(key)),
        crypto::ecdsa_verifying(NistP256, Sha256, found, Der),
      );
      assert_eq(crypto::spki_encode(crypto::P256Public(found)), spki)
    },
    _ -> panic("a P-256 public key"),
  };
  assert(crypto::verify(crypto::verifying_key(key), message(), signature))
}

test "an ECDSA P-256 signature over SHA-384 verifies only with a SHA-384 verifying key, not with a SHA-256 one" {
  let scalar = match crypto::private_key_of_der(Secret::of_bytes(ec_document())) {
    Some(crypto::EcPrivate(NistP256, s)) -> s,
    _ -> panic("a P-256 key"),
  };
  let signer = match crypto::ecdsa_signing(NistP256, scalar, Der) {
    Some(k) -> k,
    None -> panic("a key"),
  };
  let point = crypto::verifying_bytes(crypto::verifying_key(signer));
  let signature = Bytes::of_hex(
    "30450220384b341fb40e438a3de9bd070948c3fb0cfe8b222d9fa9833f5fa161308198bf022100e85d33646cd5c6d8045f0306883824a136f6a010014e7756ecd50e74e67194f2",
  );
  match crypto::ecdsa_verifying(NistP256, Sha384, point, Der) {
    Some(key) -> {
      assert(crypto::verify(key, message(), signature));
      assert(!crypto::verify(key, b"what was not", signature));
      assert_eq(crypto::signature_algorithm(key), crypto::EcdsaSignature(NistP256, Sha384, Der));
      assert_eq(crypto::verifying_bytes(key), point)
    },
    None -> panic("a P-256 point"),
  };
  assert(!crypto::verify(crypto::verifying_key(signer), message(), signature));
  assert_eq(crypto::ecdsa_verifying(NistP256, Sha512, point, Der), None);
  assert_eq(crypto::ecdsa_verifying(NistP256, Sha384, point.slice(0, 64), Der), None);
  assert_eq(crypto::ecdsa_verifying(NistP384, Sha384, point, Der), None);
  assert_eq(crypto::ecdsa_verifying(NistP256, Sha384, point.concat(point), Der), None)
}

fn pss_signatures() -> List<RsaSignature> =
  [
    {
      digest: Sha256,
      name: "SHA-256",
      signature: "",
    },
    {
      digest: Sha384,
      name: "SHA-384",
      signature: "",
    },
    {
      digest: Sha512,
      name: "SHA-512",
      signature: "",
    },
  ]

test "signing a message with the test RSA key using PSS and {c.name} gives the signature openssl produced, and `verify` accepts that signature" for c: RsaSignature in pss_signatures(
  ) {
  let key = match crypto::rsa_pss_signing(Secret::of_bytes(rsa_document()), c.digest) {
    Some(k) -> k,
    None -> panic("an RSA key"),
  };
  let signature = crypto::sign(key, message());
  assert_eq(signature, Bytes::of_hex(c.signature));
  assert(crypto::verify(crypto::verifying_key(key), message(), signature));
  assert(!crypto::verify(crypto::verifying_key(key), b"what was not", signature));
  assert_eq(
    Some(crypto::verifying_key(key)),
    crypto::rsa_pss_verifying(crypto::verifying_bytes(crypto::verifying_key(key)), c.digest),
  )
}

test "a private key read from PEM signs while its bytes stay inside a `Secret`" {
  let text = "-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEINTuctv5E1hK1bbY8fdp+K06/nwoy/HU++CXqI9EdVhC\n-----END PRIVATE KEY-----\n";
  let public = Bytes::of_hex("19bf44096984cdfe8541bac167dc3b96c85086aa30b6b6cb0c5c38ad703166e1");
  match pem::decode(text, 4096) {
    Ok([pem::Sealed(key)]) -> match crypto::private_key_of_der(key.cache_key) {
      Some(crypto::Ed25519Private(seed)) -> {
        assert_eq(ed25519::public_key(seed), public);
        assert(ed25519::verify(public, message(), ed25519::sign(seed, message())));
        match crypto::ed25519_signing(seed) {
          Some(signer) -> {
            assert_eq(crypto::verifying_bytes(crypto::verifying_key(signer)), public);
            assert_eq(crypto::sign(signer, message()), ed25519::sign(seed, message()))
          },
          None -> panic("a seed is a signing key"),
        }
      },
      _ -> panic("an Ed25519 key"),
    },
    _ -> panic("one sealed key"),
  }
}
