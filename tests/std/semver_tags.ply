import std.semver
import std.semver (Range, Version, satisfies)
import std.semver_range

fn candidate() -> Version = semver"1.2.3-rc.1+build"

fn wanted() -> Range = semver_range">=1.2 <2"

test "a `semver` literal in source parses to the same version as its text, so it renders, compares and increments correctly" {
  assert_eq(semver::render(candidate()), "1.2.3-rc.1+build");
  assert_eq(compare(semver"1.0.0-alpha", semver"1.0.0"), Less);
  assert(semver"1.0.0+a" == semver"1.0.0+b");
  assert_eq(semver::render(semver::increment(candidate(), semver::Patch)), "1.2.3")
}

test "a `semver_range` literal in source parses to the same range as its text, so it renders and matches versions correctly" {
  assert_eq(semver::render_range(wanted()), ">=1.2, <2");
  assert_eq(semver::parse_range(">=1.2, <2"), Ok(wanted()));
  assert(satisfies(semver"1.4.0", wanted()));
  assert(!satisfies(semver"2.0.0-rc.1", wanted()));
  assert(satisfies(candidate(), semver_range">=1.2.3-rc.0, <2"));
  assert_eq(semver_range"*", Range([]))
}
