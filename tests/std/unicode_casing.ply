//! `std.unicode`'s case mappings and foldings against `SpecialCasing.txt`, `CaseFolding.txt` and
//! `UnicodeData.txt`, over every code point; the texts of the normalization test, which hold marks,
//! ligatures and Greek in every arrangement, are held to what folding and caseless matching promise
//! of any text. A code point the files give a mapping is asked alone; the rest, which
//! map to themselves whatever stands beside them, are asked a few thousand to a text.

import std.list
import std.unicode
import std.utf16
import std.utf16 (BigEndian, LittleEndian)
import ucd_files
import ucd_files (Row, Span, CodePointRange, code_points_of, failing_listed_code_points, rows, text,
                  text_of, unicode_data, uncovered_spans)
import unicode_normalization (Line, lines)

/// The mappings of a code point: `None` for one that is the code point itself.
type CaseMappings = { lower: Option<List<Int>>, title: Option<List<Int>>, upper: Option<List<Int>> }

fn mapping_of(field: Bytes) -> Option<List<Int>> / {abort.raise} =
  if field.len() == 0 { None } else { Some(code_points_of(field)) }

/// What each code point with a mapping maps to in full: `SpecialCasing.txt`'s rows that hold
/// under no condition, and for the rest the simple mappings of `UnicodeData.txt`.
fn full_mappings() -> List<CodePointRange<CaseMappings>> / {abort.raise} = {
  let special = rows(ucd_files::special_casing()).fold(
    Map::new(),
    |known: Map<Int, CaseMappings>, row: Row|
      if row.fields.len() != 4 { known } else {
        known.insert(row.first, {
          lower: mapping_of(row.fields.get(0)),
          title: mapping_of(row.fields.get(1)),
          upper: mapping_of(row.fields.get(2)),
        })
      },
  );
  unicode_data().fold([], |found: List<CodePointRange<CaseMappings>>, row: Row| {
    let simple = {
      lower: mapping_of(row.fields.get(13)),
      title: mapping_of(row.fields.get(14)),
      upper: mapping_of(row.fields.get(12)),
    };
    match special.get(row.first) {
      Some(mapped) -> found.push({ first: row.first, last: row.last, said: mapped }),
      None -> if simple.lower == None && simple.title == None && simple.upper == None { found }
      else { found.push({ first: row.first, last: row.last, said: simple }) },
    }
  })
}

test "every code point alone maps to each case in full as SpecialCasing.txt and UnicodeData.txt say" {
  let mappings = full_mappings();
  let wrong = failing_listed_code_points(mappings, |cp: Int, mapped: CaseMappings| {
    let alone = text([cp]);
    let to = |mapping: Option<List<Int>>|
      match mapping { Some(points) -> text(points), None -> alone };
    unicode::lowercase(alone) == to(mapped.lower) && unicode::titlecase(alone) == to(mapped.title)
      && unicode::uppercase(alone) == to(mapped.upper)
  });
  let moved = uncovered_spans(mappings, 4096).filter(|span: Span| {
    let whole = text_of(span);
    unicode::lowercase(whole) != whole || unicode::uppercase(whole) != whole
      || unicode::titlecase(whole) != whole
  });
  assert_eq({ wrong: wrong, moved: moved }, { wrong: [], moved: [] })
}

/// What a code point folds to, by each status of `CaseFolding.txt` that lists it.
type CaseFoldings = {
  common: Option<List<Int>>,
  full: Option<List<Int>>,
  simple: Option<List<Int>>,
  turkic: Option<List<Int>>,
}

fn foldings() -> List<CodePointRange<CaseFoldings>> / {abort.raise} = {
  let none = { common: None, full: None, simple: None, turkic: None };
  let known = rows(ucd_files::case_folding()).fold(
    Map::new(),
    |all: Map<Int, CaseFoldings>, row: Row| {
      let so_far = match all.get(row.first) { Some(f) -> f, None -> none };
      let to = Some(code_points_of(row.fields.get(1)));
      all.insert(row.first, match row.fields.get(0) {
        b"C" -> { ..so_far, common: to },
        b"F" -> { ..so_far, full: to },
        b"S" -> { ..so_far, simple: to },
        b"T" -> { ..so_far, turkic: to },
        _ -> panic("a folding's status is C, F, S or T"),
      })
    },
  );
  known.entries().map(|e: { key: Int, value: CaseFoldings }|
    { first: e.key, last: e.key, said: e.value })
}

test "every code point alone folds as CaseFolding.txt says, in full, simply and for Turkic" {
  let listed = foldings();
  let wrong = failing_listed_code_points(listed, |cp: Int, f: CaseFoldings| {
    let alone = text([cp]);
    let to = |choices: List<Option<List<Int>>>|
      match choices.fold(None, |found: Option<List<Int>>, choice: Option<List<Int>>|
          match found { Some(_) -> found, None -> choice }) {
        Some(points) -> text(points),
        None -> alone,
      };
    unicode::case_fold(alone) == to([f.common, f.full])
      && unicode::simple_case_fold(alone) == to([f.common, f.simple])
      && unicode::case_fold(alone, turkic: true) == to([f.turkic, f.common, f.full])
      && unicode::simple_case_fold(alone, turkic: true) == to([f.turkic, f.common, f.simple])
  });
  let moved = uncovered_spans(listed, 4096).filter(|span: Span| {
    let whole = text_of(span);
    unicode::case_fold(whole) != whole || unicode::simple_case_fold(whole) != whole
      || unicode::case_fold(whole, turkic: true) != whole
      || unicode::simple_case_fold(whole, turkic: true) != whole
  });
  assert_eq({ wrong: wrong, moved: moved }, { wrong: [], moved: [] })
}

test "the caseless key of every code point, a few thousand to a text, is folded and decomposed" {
  let every: List<CodePointRange<Unit>> = [];
  let unresolved = uncovered_spans(every, 4096).filter(|span: Span| {
    let key = unicode::caseless_key(text_of(span));
    unicode::case_fold(key) != key || unicode::nfd(key) != key
  });
  assert_eq(unresolved, [])
}

test "the normalization test's texts fold once, match their canonical forms whatever their case, and read back from UTF-16" {
  let wrong = lines().filter(|l: Line| {
    let folded = unicode::case_fold(l.nfd);
    unicode::case_fold(folded) != folded || !unicode::caseless(l.source, l.nfc)
      || !unicode::caseless(l.source, folded)
      || !unicode::caseless(l.nfd, l.nfc, turkic: true)
      || utf16::decode(
        utf16::encode(l.source, LittleEndian, with_byte_order_mark: true),
        BigEndian,
        with_byte_order_mark: true,
      )
      != Ok(l.source)
  });
  assert_eq(wrong.map(|l: Line| ucd_files::hex_code_points(l.source)), [])
}
