import std.bytes
import std.ip
import std.json
import std.json (Json)
import std.list
import std.string
import std.url
import std.url (Name, Url, V4, V6, url_host, url_normalized, url_parse, url_render)

type Case = { text: String, host: Option<String> }

fn items(file: Bytes) -> List<Json> / {abort.raise} =
  match json::parse(file) {
    Ok(json::Array(all)) -> all,
    _ -> panic("the file is an array of cases"),
  }

fn text_of(j: Json, name: String) -> Option<String> =
  match json::get(j, name) { Some(json::Str(text)) -> Some(text), _ -> None }

const to_ascii_cases: List<Case> =
  items(embed("wpt_url/toascii.json")).fold([], |found: List<Case>, j: Json|
    match text_of(j, "input") {
      Some(input) -> found.push({ text: "https://" ++ input ++ "/x", host: text_of(j, "output") }),
      None -> found,
    })

fn internationalized(input: String) -> Bool / {abort.raise} = {
  let b = Bytes::of_string(input);
  let from = if b.starts_with(b"http://") { 7 } else if b.starts_with(b"https://") { 8 } else { 0 };
  let pieces = b.slice(from, b.skip_until(from, b"/?#")).split(b"@");
  let host = pieces.at_or(pieces.len() - 1, b"");
  from > 0
    && range(0, host.len()).fold(false, |found: Bool, i: Int|
      found || host.at(i) == b'%' || host.at(i) >= 128)
}

const url_cases: List<Case> =
  items(embed("wpt_url/urltestdata.json")).fold([], |found: List<Case>, j: Json|
    match text_of(j, "input") {
      Some(input) -> if !internationalized(input) { found } else {
        found.push({
          text: input,
          host: if json::get(j, "failure") == Some(json::Bool(true)) { None }
          else { text_of(j, "hostname") },
        })
      },
      None -> found,
    })

fn host_text(u: Url) -> String =
  match url_host(u) {
    Some(Name(name)) -> name,
    Some(V4(four)) -> ip::render_v4(four),
    Some(V6(six)) -> "[" ++ ip::render_v6(six) ++ "]",
    None -> "",
  }

fn error_kind_name(reason: url::ErrorKind) -> String =
  match reason {
    url::NotAscii -> "NotAscii",
    url::Forbidden -> "Forbidden",
    url::BadEscape -> "BadEscape",
    url::EncodedHost -> "EncodedHost",
    url::NumericHost -> "NumericHost",
    url::Idna(_) -> "Idna",
    url::UnexpectedCharacter -> "Stray",
    _ -> "other",
  }

type Tally = {
  read: Int,
  rejected: Int,
  extra_rejections: Map<String, Int>,
  disagreements: List<String>,
}

fn tallied(cases: List<Case>) -> Tally / {abort.raise} =
  cases.fold(
    { read: 0, rejected: 0, extra_rejections: Map::new(), disagreements: [] },
    |t: Tally, c: Case|
      match ((url_parse(c.text), c.host)) {
        (Err(_), None) -> { ..t, rejected: t.rejected + 1 },
        (Err(no), Some(_)) -> {
          let reason = error_kind_name(no.reason);
          let so_far = match t.extra_rejections.get(reason) { Some(n) -> n, None -> 0 };
          { ..t, extra_rejections: t.extra_rejections.insert(reason, so_far + 1) }
        },
        (Ok(u), Some(host)) -> if host_text(u) == host && host_text(url_normalized(u)) == host {
          { ..t, read: t.read + 1 }
        } else {
          {
            ..t,
            disagreements: t.disagreements.push(
              c.text ++ " is " ++ host_text(u) ++ ", not " ++ host,
            ),
          }
        },
        (Ok(u), None) ->
          { ..t, disagreements: t.disagreements.push(c.text ++ " is read as " ++ host_text(u)) },
      },
  )

test "every host in toascii.json is accepted or rejected as the URL Standard says, with no disagreements" {
  let t = tallied(to_ascii_cases);
  assert_eq(t.disagreements, []);
  assert_eq(
    { read: t.read, rejected: t.rejected, extra_rejections: t.extra_rejections.entries() },
    { read: 64, rejected: 19, extra_rejections: [{ key: "Forbidden", value: 4 }] },
  )
}

test "every internationalized host in urltestdata.json is accepted or rejected as the URL Standard says, with no disagreements" {
  let t = tallied(url_cases);
  assert_eq(t.disagreements, []);
  assert_eq(
    { read: t.read, rejected: t.rejected, extra_rejections: t.extra_rejections.entries() },
    {
      read: 7,
      rejected: 70,
      extra_rejections: [
        { key: "EncodedHost", value: 2 },
        { key: "NotAscii", value: 1 },
        { key: "NumericHost", value: 1 },
      ],
    },
  )
}

test "every URL text in the web platform URL tests and the ASCII conversion cases serializes back to the same text, and to ASCII after `url_normalized`" {
  let all = url_cases.fold(to_ascii_cases, |cases: List<Case>, c: Case| cases.push(c));
  let moved = all.filter(|c: Case|
    match url_parse(c.text) {
      Ok(u) -> url_render(u) != c.text || !url_render(url_normalized(u)).is_ascii(),
      Err(_) -> false,
    });
  assert_eq(moved.map(|c: Case| c.text), [])
}
