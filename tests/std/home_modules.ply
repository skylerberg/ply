import compiler.syntax.expressions
import compiler.syntax.items
import compiler.syntax.items (ImportDeclaration)
import compiler.syntax.parsing
import compiler.syntax.parsing (Identifier)
import std.list

type File = { name: String, bytes: Bytes }

fn imported(bytes: Bytes) -> List<Bytes> / {abort.raise} =
  items::parse(bytes).node.imports.map(|d: ImportDeclaration|
    Bytes::join(d.path.map(|part: Identifier| part.name), b"."))

fn imports_of(files: List<File>, module: Bytes) -> List<Bytes> / {abort.raise} = {
  let path = String::of_bytes(module.slice(4, module.len())).replace(".", "/") ++ ".ply";
  match files.filter(|f: File| f.name == path) { [f, ..] -> imported(f.bytes), [] -> [] }
}

fn reachable_from(files: List<File>, from: List<Bytes>) -> List<Bytes> / {abort.raise} = {
  let traversal = range(0, files.len()).fold(
    { seen: Map::new(), next: from },
    |accumulator: { seen: Map<Bytes, Bool>, next: List<Bytes> }, _round: Int| {
      let fresh = accumulator.next.filter(|m: Bytes| !accumulator.seen.contains(m));
      {
        seen: fresh.fold(accumulator.seen, |seen: Map<Bytes, Bool>, m: Bytes| seen.insert(m, true)),
        next: fresh.flat_map(|m: Bytes| imports_of(files, m)).filter(|m: Bytes|
          m.starts_with(b"std.")),
      }
    },
  );
  traversal.seen.keys()
}

test "the dependencies of the `home_modules` are the prelude, the `home_modules` and every module they import" {
  let files: List<File> = embed_dir("../../packages/std");
  assert_eq(
    reachable_from(files, expressions::home_modules().push(b"std.prelude")),
    expressions::home_module_dependencies().sort(),
  )
}

test "the dependencies of the scheduler module are the scheduler and every module it imports" {
  let files: List<File> = embed_dir("../../packages/std");
  assert_eq(
    reachable_from(files, [expressions::scheduler_module()]),
    expressions::scheduler_dependencies().sort(),
  )
}

type Module = { name: Bytes, bytes: Bytes }

test "no standard library module imports itself, directly or through other modules, and this includes the scheduler's dependencies" {
  let files: List<File> = embed_dir("../../packages/std");
  let modules = files.filter(|f: File| f.name.ends_with(".ply")).map(|f: File| {
    let dotted = Bytes::of_string("std." ++ f.name.replace("/", "."));
    { name: dotted.slice(0, dotted.len() - 4), bytes: f.bytes }
  });
  let texts = modules.fold(Map::new(), |accumulator: Map<Bytes, Bytes>, m: Module|
    accumulator.insert(m.name, m.bytes));
  let declared = items::homes_declaring(|h: Bytes| texts.get(h));
  let sight = modules.fold(Map::new(), |accumulator: Map<Bytes, List<Bytes>>, m: Module|
    accumulator.insert(
      m.name,
      imported(m.bytes).concat(
        items::read_without_import(m.name, parsing::start(m.bytes).input, || declared),
      ).filter(|d: Bytes| d != m.name && texts.contains(d)),
    ));
  let left = iterate(sight.keys(), modules.len() + 2, |names: List<Bytes>| {
    let here = names.fold(Map::new(), |accumulator: Map<Bytes, Bool>, n: Bytes|
      accumulator.insert(n, true));
    let next = names.filter(|n: Bytes|
      (match sight.get(n) { Some(ds) -> ds, None -> [] }).any(|d: Bytes| here.contains(d)));
    if next.len() == names.len() { Stop(next) } else { Continue(next) }
  });
  assert_eq(left, [])
}
