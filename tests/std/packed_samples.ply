import std.bytes (u32_le)

fn scramble(i: Int) -> Int = (i * 2654435761 >>> 13 ^ i * 40503 >>> 5 ^ i) & 0xFFFF_FFFF

pub fn noise(n: Int) -> Bytes / {abort.raise} =
  Bytes::concat_all(range(0, n / 4 + 1).map(|i: Int| u32_le(scramble(i + 1)))).slice(0, n)

const syllables: List<Bytes> =
  [
    b"ta",
    b"ri",
    b"mon",
    b"el",
    b"qua",
    b"ser",
    b"vo",
    b"lin",
    b"dra",
    b"pes",
    b"ku",
    b"zor",
    b"hem",
    b"bi",
    b"fal",
    b"nys",
  ]

fn syllable(k: Int) -> Bytes = match syllables.at(k & 15) { Some(s) -> s, None -> b"" }

fn word(i: Int) -> Bytes = {
  let k = scramble(i);
  let stem = syllable(k).concat(syllable(k >>> 4));
  let long = if k >>> 8 & 3 == 0 { stem.concat(syllable(k >>> 10)) } else { stem };
  let after = k >>> 14 & 31;
  if after == 0 { long.concat(b".\n") }
  else if after == 1 { long.concat(b", ") } else if after == 2 {
    Bytes::concat_all([long, b" ", Bytes::of_string(Int::to_string(k >>> 19 & 1023)), b" "])
  } else if after < 6 { long.concat(b". ") }
  else { long.concat(b" ") }
}

pub fn prose(n: Int) -> Bytes / {abort.raise} =
  Bytes::concat_all(range(0, n / 4 + 8).map(word)).slice(0, n)

pub fn records(n: Int) -> Bytes / {abort.raise} =
  Bytes::concat_all(
    range(0, n / 16 + 1).map(|i: Int|
      Bytes::concat_all([
        u32_le(i),
        u32_le(i / 37 * 7919 & 0xFFFF),
        u32_le(scramble(i) & 0xFF00_FF1F),
        b"\xFF\xFE\x80",
        byte_of_int(i & 255),
      ])),
  ).slice(
    0,
    n,
  )

pub const runs: Bytes =
  Bytes::concat_all([
    b"abc".repeat(30000),
    Bytes::concat_all(range(0, 256).map(byte_of_int)).repeat(300),
    b"x".repeat(70000),
  ])

pub const far_repeat: Bytes = {
  let once = noise(70000);
  Bytes::concat_all([once, once, b"tail", once.slice(0, 35000)])
}

const english: Bytes =
  Bytes::of_string(
    "The quick brown fox jumps over the lazy dog. This is a short piece of English about nothing in particular, which a dictionary of common words should know most of. There are many other things that could be said here, but the important information is that every sentence in this paragraph was written for the first time, and that none of them is repeated anywhere else in the document.\n",
  )

const html: Bytes =
  Bytes::of_string(
    "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<title>A page</title>\n<link rel=\"stylesheet\" href=\"style.css\">\n<script type=\"text/javascript\" src=\"main.js\"></script>\n</head>\n<body>\n<div class=\"container\"><p>Hello, world. Welcome to the home page of the Internet.</p><a href=\"https://www.example.com/index.html\">Click here for more information</a></div>\n</body>\n</html>\n",
  )

pub fn sample(name: String) -> Bytes / {abort.raise} =
  if name == "prose" { prose(40000) }
  else if name == "english" { english }
  else if name == "html" { html }
  else if name == "long" { prose(150000) }
  else if name == "brief" { prose(2000) }
  else if name == "records" { records(40000) }
  else if name == "noise" { noise(10000) }
  else if name == "zeros" { b"\x00".repeat(100000) }
  else if name == "runs" { runs }
  else if name == "far" { far_repeat }
  else if name == "one" { b"a" }
  else if name == "empty" { b"" }
  else { panic(f"no sample named {name}") }

pub const names: List<String> =
  [
    "prose",
    "long",
    "brief",
    "records",
    "noise",
    "zeros",
    "runs",
    "far",
    "one",
    "empty",
    "english",
    "html",
  ]

test "each compression sample has its expected length, prose samples start the same, and the random sample repeats no 8-byte sequence" {
  assert_eq(names.map(|name: String| sample(name).len()), [
    40000,
    150000,
    2000,
    40000,
    10000,
    100000,
    236800,
    175004,
    1,
    0,
    384,
    384,
  ]);
  assert_eq(prose(40).slice(0, 6), prose(2000).slice(0, 6));
  assert(noise(10000).index_of(noise(10000).slice(100, 108)) == Some(100))
}
