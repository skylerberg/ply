//! A response the host gives later, here a child process's exit: waited for outside a scheduler, and
//! by a task of the run's scheduler while the others run.

import std.process (process, exit_code)

/// Starts a shell that exits `code` and returns its exit code.
fn child(code: Int) -> Int / {process.spawn[sh]} =
  match exit_code(process.spawn[sh](["-c", "exit " ++ code.to_string()], "", [])) {
    Some(c) -> c,
    None -> 0,
  }

// Outside any scheduler nothing else could run meanwhile, so the run blocks on the response.
test/nondet "a response the host gives later is waited for outside a scheduler" {
  assert_eq(child(7), 7)
}

// A test performing `task` runs under the run's scheduler, where a task waiting on the host waits
// and the others run.
test/nondet "tasks waiting on the host park in a production scheduler and each join returns its own" {
  let tasks = range(0, 4).map(|i: Int| task.spawn(|| child(7) + i));
  assert_eq(tasks.map(|t: Task<Int>| task.join(t)), [7, 8, 9, 10])
}

// Each task opens its scope and parks on a child; each still reads its own scoped value once it
// wakes, whichever scope closed first.
test/nondet "tasks parked on the host keep their scoped values when the other's scope closes first" {
  let first = task.spawn(||
    with_scope[a](10, |x: Int| ()) { c -> {
      let got = child(5);
      c.get() + got
    } });
  let second = task.spawn(||
    with_scope[b](20, |x: Int| ()) { c -> {
      let got = child(5);
      c.get() + got
    } });
  assert_eq(task.join(first) + task.join(second), 40)
}
