import scratch
import std.config (config)
import std.fs (fs)
import std.list
import std.net (net)
import std.process (process, CompletedProcess, EnvironmentVariable, exit_code, Discard, Interrupt,
                    Keep)
import std.random (entropy)
import std.string
import std.time (millis)

pub effect set Postgres = {process.read[initdb], process.write[initdb], process.read[postgres], process.write[postgres], process.read[psql], process.write[psql], config.get[env], clock.read, clock.write}

pub effect set Launch = {Postgres, fs.read[scratch], fs.write[scratch], net.read[ports], net.write[ports]}

pub effect set Wire = {net.read[link], net.write[link], entropy.next}

pub type Cluster = { port: Int, server: Int, password: String }

pub type Credential = { certificate: String, key: String }

pub fn available() -> Bool / {Postgres, abort.raise} = {
  let found = process.bound[initdb]() && process.bound[postgres]() && process.bound[psql]();
  if !found && config.get[env]("CI") != None {
    panic("CI runs the postgres-backed tests, and this run bound no initdb, postgres and psql")
  };
  found
}

pub fn trusted() -> Credential / {fs.read[certificate], abort.raise} =
  { certificate: given("localhost.pem"), key: given("localhost.key") }

fn given(path: String) -> String / {fs.read[certificate], abort.raise} =
  match fs.read_file[certificate](path) {
    Some(bytes) -> String::of_bytes(bytes),
    None -> panic("the root `certificate` holds no `" ++ path ++ "`"),
  }

pub fn scram(password: String) -> Cluster / {Launch, abort.raise, diverges} =
  launch("scram-sha-256", password, None)

pub fn clear_text(password: String) -> Cluster / {Launch, abort.raise, diverges} =
  launch("password", password, None)

pub fn scram_with_tls(
  password: String,
  credential: Credential,
) -> Cluster / {Launch, abort.raise, diverges} = launch("scram-sha-256", password, Some(credential))

const c_locale: List<EnvironmentVariable> = [{ name: "LC_ALL", value: "C" }]

fn output_or_fail(f: CompletedProcess) -> String / {abort.raise} =
  if exit_code(f) == Some(0) { String::of_bytes_lossy(f.out) }
  else { panic(String::of_bytes_lossy(f.err)) }

fn written(path: String, text: String) -> Unit / {fs.write[scratch], abort.raise} =
  if !fs.write_file[scratch](path, Bytes::of_string(text)) {
    panic("could not write `" ++ path ++ "` under the root `scratch`")
  }

fn launch(
  auth: String,
  password: String,
  tls: Option<Credential>,
) -> Cluster / {Launch, abort.raise, diverges} = {
  scratch::fresh();
  let root = match fs.canonical[scratch](".") {
    Some(p) -> p,
    None -> panic("the root `scratch` has no path"),
  };
  let data = root ++ "/data";
  written("password", password);
  let _ = output_or_fail(
    process.spawn[initdb](
      [
        "-D",
        data,
        "-U",
        "ply",
        "--no-sync",
        "-E",
        "UTF8",
        "--locale=C",
        "--auth-local=" ++ auth,
        "--auth-host=" ++ auth,
        "--pwfile=" ++ root ++ "/password",
      ],
      "",
      c_locale,
    ),
  );
  let scram_with_tls = match tls {
    None -> [],
    Some(credential) -> {
      written("data/server.crt", credential.certificate);
      written("data/server.key", credential.key);
      let none = { read: false, write: false, execute: false };
      if !fs.set_mode[scratch]("data/server.key", {
          owner: { read: true, write: true, execute: false },
          group: none,
          other: none,
        }) { panic("could not keep the server's key to its owner") };
      ["-c", "ssl=on", "-c", "ssl_cert_file=server.crt", "-c", "ssl_key_file=server.key"]
    },
  };
  let port = reserve();
  let server = match process.start[postgres](
      [
        "-D",
        data,
        "-p",
        port.to_string(),
        "-c",
        "listen_addresses=localhost",
        "-c",
        "unix_socket_directories=",
        "-c",
        "fsync=off",
        "-c",
        "full_page_writes=off",
        "-c",
        "synchronous_commit=off",
      ].concat(
        scram_with_tls,
      ),
      "",
      c_locale,
      { input: false, out: Discard, err: Keep },
    ) {
    Ok(child) -> child,
    Err(reason) -> panic("postgres did not start: " ++ reason),
  };
  let cluster = { port: port, server: server, password: password };
  match wait_until_ready(cluster, 300, "") {
    None -> (),
    Some(reason) -> {
      let _ = process.signal[postgres](server, Interrupt);
      let error_output = match process.wait[postgres](server, 10000) {
        Some(f) -> String::of_bytes_lossy(f.err),
        None -> "",
      };
      panic(
        "postgres did not become ready within thirty seconds: " ++ reason ++ "\n" ++ error_output,
      )
    },
  };
  let _ = run_psql(cluster, "postgres", "create database ply");
  cluster
}

fn reserve() -> Int / {net.read[ports], net.write[ports], abort.raise} = {
  let l = net.listen[ports](0);
  let port = match net.local_port[ports](l) {
    Some(p) -> p,
    None -> panic("a listener asked for port 0 was given none"),
  };
  net.close[ports](l);
  port
}

fn wait_until_ready(c: Cluster, tries: Int, last: String) -> Option<String> / {Postgres, diverges} =
  if tries <= 0 { Some(last) } else {
    let f = spawned_psql(c, "postgres", "select 1");
    if exit_code(f) == Some(0) { None } else {
      clock.sleep(millis(100));
      wait_until_ready(c, tries - 1, String::of_bytes_lossy(f.err))
    }
  }

fn spawned_psql(c: Cluster, database: String, sql: String) -> CompletedProcess / {Postgres} =
  process.spawn[psql](
    [
      "-X",
      "-h",
      "127.0.0.1",
      "-p",
      c.port.to_string(),
      "-U",
      "ply",
      "-d",
      database,
      "-v",
      "ON_ERROR_STOP=1",
      "-t",
      "-A",
      "-c",
      sql,
    ],
    "",
    [{ name: "PGPASSWORD", value: c.password }],
  )

fn run_psql(c: Cluster, database: String, sql: String) -> String / {Postgres, abort.raise} =
  output_or_fail(spawned_psql(c, database, sql)).trim()

pub fn psql(c: Cluster, sql: String) -> String / {Postgres, abort.raise} = run_psql(c, "ply", sql)

pub fn stop(c: Cluster) -> Unit / {Postgres} = {
  let _ = process.signal[postgres](c.server, Interrupt);
  let _ = process.wait[postgres](c.server, 10000);
  ()
}

pub fn major_version() -> Int / {Postgres, abort.raise} = {
  let version_output = String::of_bytes_lossy(process.spawn[postgres](["--version"], "", []).out);
  version_output.split(" ").fold(0, |found: Int, word: String|
    if found > 0 { found } else {
      match String::int_of_string(match word.split(".") { [major, ..] -> major, [] -> "" }) {
        Some(n) -> n,
        None -> 0,
      }
    })
}

pub fn url(c: Cluster, host: String, query: String) -> String =
  "postgres://ply:" ++ c.password ++ "@" ++ host ++ ":" ++ c.port.to_string() ++ "/ply?" ++ query

pub fn plain_url(c: Cluster) -> String = url(c, "127.0.0.1", "sslmode=disable")
