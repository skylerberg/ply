//! Every test drives `ply` from this module, and no other names it. `spawned` starts the binary
//! `--exec ply` names in the scratch directory the run was started in, and `start_server` leaves
//! a `ply` running for a test to talk to.

import std.env (env)
import std.bytes
import std.config (config)
import std.fs
import std.fs (fs, Entry, File)
import std.json
import std.json (Json, Null, Number, Str, Array, Object)
import std.list
import std.net
import std.net (net)
import std.os
import std.os (os)
import std.process (process, Var, CompletedProcess, Exited, Signalled, Keep, Lines, Discard,
                    LineWritten, Signal, Kill, Terminate)
import std.time (time)
import std.path (segments)
import std.string
import std.text (shell_join)

/// The lines a run wrote to each stream, and the code it ended with: a signal's as a shell reports
/// it, 128 and the signal's number.
pub type RunResult = { out: List<String>, err: List<String>, code: Int }

pub fn stdout(ran: RunResult) -> String = String::unlines(ran.out)

pub fn stderr(ran: RunResult) -> String = String::unlines(ran.err)

/// Both streams, the output first: what a test searches when it does not care which said it.
pub fn all_output(ran: RunResult) -> String = stdout(ran) ++ stderr(ran)

/// A run that exited 0, or the test fails with what it said.
pub fn assert_ok(ran: RunResult) -> Unit / {abort.raise} =
  assert(ran.code == 0, Some(all_output(ran)))

/// The one document `--json` writes on the output stream.
pub fn json_of(ran: RunResult) -> Json / {abort.raise} =
  match json::parse_string(stdout(ran)) {
    Ok(j) -> j,
    Err(e) ->
      panic(
        "`--json` wrote no one document: " ++ json::error_to_string(e) ++ "\n" ++ all_output(ran),
      ),
  }

/// What `main` returned, as the document `ply run --json` wrote renders it. The test fails with
/// what the run said when `main` returned nothing.
pub fn value_of(ran: RunResult) -> String / {abort.raise} =
  match json::get(json_of(ran), "value") {
    Some(Str(v)) -> v,
    _ -> panic("`main` returned no value: " ++ all_output(ran)),
  }

/// A member, or `Null` when there is none, as a reader of a report wants.
pub fn at(j: Json, name: String) -> Json = match json::get(j, name) { Some(v) -> v, None -> Null }

pub fn path(j: Json, names: List<String>) -> Json = names.fold(j, at)

pub fn nth(j: Json, i: Int) -> Json =
  match j { Array(xs) -> match xs.at(i) { Some(v) -> v, None -> Null }, _ -> Null }

pub fn items(j: Json) -> List<Json> = match j { Array(xs) -> xs, _ -> [] }

/// The first of a list, or `Null` for an empty one.
pub fn first(xs: List<Json>) -> Json = match xs.at(0) { Some(x) -> x, None -> Null }

pub fn str(j: Json) -> String = match j { Str(s) -> s, _ -> "" }

/// `-1` for anything but a whole number, which no count or code a report carries is.
pub fn int(j: Json) -> Int =
  match j { Number(d) -> match Int::of_decimal(d, Down) { Some(n) -> n, None -> -1 }, _ -> -1 }

pub fn bool(j: Json) -> Bool = match j { json::Bool(b) -> b, _ -> false }

pub fn json_text(j: Json) -> String / {abort.raise} = json::to_string(j)

/// What a scratch directory holds to say it may be emptied.
pub fn scratch_marker() -> String = ".ply-scratch"

/// The stage every run of a test stores what it reuses in, a `ply` it starts included: beside the
/// test's files, hidden as a cache is. `empty_working_directory` keeps it, since the shipped modules a `ply` lays out
/// there are the binary's alone, and empties what it reuses.
fn stage() -> String = ".ply-stage"

/// Where `ply run` and `ply check` file what they reuse, in the stage.
pub fn reused_dir() -> String = stage() ++ "/reused"

/// Where a run caches emitter output: beside the test's files, so a fresh directory holds none
/// an earlier test cached.
pub fn bodies_dir() -> String = ".ply-bodies"

/// A file of a project: its path from the project's directory, and its text.
pub type Source = { path: String, text: String }

/// The working directory emptied for one test, its marker and its stage kept, and nothing reused in
/// the stage. One without the marker is never emptied: a run started anywhere else deletes nothing.
pub fn empty_working_directory() -> Unit / {WorkingDirectory, abort.raise} =
  match fs::listed_names(fs.list_dir[cwd](".")) {
    None -> panic("the working directory cannot be listed"),
    Some(names) -> if !names.contains(scratch_marker()) {
      panic(
        "`on_disk` empties the working directory, and this one holds no `" ++ scratch_marker()
          ++ "`: start `ply test` in a scratch directory that holds one",
      )
    } else {
      names.fold((), |u: Unit, name: String|
        if name == scratch_marker() || name == stage() || fs.remove_tree[cwd](name) { u }
        else { panic("could not empty the working directory of `" ++ name ++ "`") });
      if fs.exists[cwd](reused_dir()) && !fs.remove_tree[cwd](reused_dir()) {
        panic("could not empty `" ++ reused_dir() ++ "`")
      }
    },
  }

/// `text` at `path` under the working directory, every directory above it made.
pub fn write(path: String, text: String) -> Unit / {WorkingDirectory, abort.raise} = {
  let dir = parent(path);
  if dir != "" && !fs.create_dir[cwd](dir) { panic("could not make `" ++ dir ++ "`") };
  if !fs.write_file[cwd](path, Bytes::of_string(text)) { panic("could not write `" ++ path ++ "`") }
}

/// A fresh working directory holding `files`.
pub fn write_project(files: List<Source>) -> Unit / {WorkingDirectory, abort.raise} = {
  empty_working_directory();
  files.fold((), |u: Unit, source: Source| write(source.path, source.text))
}

/// A fresh working directory holding one module, `m.ply`.
pub fn write_program(text: String) -> Unit / {WorkingDirectory, abort.raise} =
  write_project([{ path: "m.ply", text: text }])

/// What a file under the working directory holds, as text.
pub fn read(path: String) -> Option<String> / {WorkingDirectory, abort.raise} =
  match fs.read_file[cwd](path) { Some(b) -> Some(String::of_bytes(b)), None -> None }

/// The working directory's absolute path, which is the run's own.
pub fn working_directory() -> String / {fs.read[cwd], abort.raise} =
  match fs.canonical[cwd](".") { Some(p) -> p, None -> panic("the working directory has no path") }

/// The repository's absolute path, which a test hands `ply` to reach a tree it ships.
pub fn repo() -> String / {Repo, abort.raise} =
  match fs.canonical[repo](".") {
    Some(p) -> p,
    None -> panic("`--fs repo=PATH` names the repository"),
  }

/// A file the repository holds, as text.
pub fn repo_file(path: String) -> String / {Repo, abort.raise} =
  match fs.read_file[repo](path) {
    Some(b) -> String::of_bytes(b),
    None -> panic("the repository holds no `" ++ path ++ "`"),
  }

/// What `embed_dir` read, as sources under `dir`.
pub fn embedded_sources(
  files: List<{ name: String, bytes: Bytes }>,
  dir: String,
) -> List<Source> / {abort.raise} =
  files.map(|f: { name: String, bytes: Bytes }|
    { path: joined(dir, f.name), text: String::of_bytes(f.bytes) })

/// A hidden segment is a cache's or a tool's, never a source.
fn is_hidden(rest: String) -> Bool =
  rest.split("/").fold(false, |hit: Bool, s: String| hit || s.starts_with("."))

/// Every source under the working directory, and nothing a cache or the scratch marker holds.
pub fn sources_here() -> List<Source> / {WorkingDirectory, abort.raise} =
  match fs.walk[cwd](".") {
    Some(entries) ->
      entries.fold([], |acc: List<Source>, e: Entry|
        if e.kind != File || is_hidden(e.path) { acc } else {
          match read(e.path) { Some(t) -> acc.push({ path: e.path, text: t }), None -> acc }
        }),
    None -> panic("the working directory walks"),
  }

/// The cache's own diagnostics, which two checks of one program may differ by.
pub fn cache_warning_codes() -> List<String> = ["W0601", "W0602", "W0603"]

fn without(j: Json, keys: List<String>) -> Json =
  match j {
    Object(m) -> Object(keys.fold(m, |acc: Map<String, Json>, k: String| acc.remove(k))),
    other -> other,
  }

/// What `ply check --explain --json` printed, less what two runs of one program may differ by:
/// where the project is, what each phase cost and where its result came from, what the cost pass
/// walked, and the cache's warnings.
pub fn stable_report(v: Json) -> Json =
  match without(v, ["root", "files", "front_end", "cost_pass"]) {
    Object(m) ->
      Object(
        m.insert(
          "modules",
          Array(items(at(v, "modules")).map(|x: Json| without(x, ["file"]))),
        ).insert(
          "diagnostics",
          Array(
            items(at(v, "diagnostics")).filter(|d: Json|
              !cache_warning_codes().contains(str(at(d, "code")))),
          ),
        ),
      ),
    other -> other,
  }

/// The line `warm_check_report` and `cold_check_report` check with.
pub fn checking() -> List<String> = ["check", ".", "--explain", "--json"]

/// Where `spawned_from_scratch` lays the sources out: hidden, as a cache is, so no walk of them reads it.
fn cold_dir() -> String = ".cold"

/// `ply ARGV` over the sources here from nothing: laid out alone in a directory of their own, with a
/// stage of its own, so it takes nothing an earlier run stored but the emitter's output.
pub fn spawned_from_scratch(
  argv: List<String>,
) -> RunResult / {PlyProcess, WorkingDirectory, abort.raise} = {
  let sources = sources_here();
  if fs.exists[cwd](cold_dir()) && !fs.remove_tree[cwd](cold_dir()) {
    panic("could not empty `" ++ cold_dir() ++ "`")
  };
  sources.fold((), |u: Unit, source: Source| write(joined(cold_dir(), source.path), source.text));
  let own = {
    name: "PLY_C_STAGE",
    value: working_directory() ++ "/" ++ cold_dir() ++ "/" ++ stage(),
  };
  spawned_in(cold_dir(), argv, [own])
}

/// `warm_matches_cold` with each check a `ply` of its own, for a program whose check compiles and enters
/// part of what it reaches.
pub fn spawned_warm_agrees(what: String) -> Json / {PlyProcess, WorkingDirectory, abort.raise} = {
  let warm = stable_report(json_of(spawned(checking())));
  let cold = stable_report(json_of(spawned_from_scratch(checking())));
  agreeing(what, warm, cold)
}

/// `warm` where it is `cold`, the result from nothing; otherwise the test fails showing both.
pub fn agreeing(what: String, warm: Json, cold: Json) -> Json / {abort.raise} = {
  assert(
    warm == cold,
    Some(
      what
        ++ ": a check through the memo store returned differently from one that started cold\nwarm: "
        ++ json_text(warm)
        ++ "\ncold: "
        ++ json_text(cold),
    ),
  );
  warm
}

/// The names of the modules a report lists that do not ship with the toolchain, in its order.
pub fn own_modules(report: Json) -> List<String> =
  items(at(report, "modules")).map(|m: Json| str(at(m, "name"))).filter(|name: String|
    !["std", "compiler"].any(|root: String| name == root || name.starts_with(root ++ ".")))

/// The test's working directory, the checkout the tests run from, `ply` run as a process with the
/// environment it inherits, the connections a test makes to a server it started, and the wall clock
/// it waits on them by.
pub effect set WorkingDirectory = {fs.read[cwd], fs.write[cwd]}

pub effect set Repo = {fs.read[repo]}

pub effect set PlyProcess = {config.get[env], process.read[ply], process.write[ply], fs.read[cwd]}

pub effect set Network = {net.read[client], net.write[client], net.read[ports], net.write[ports]}

pub effect set Clock = {time.read, time.write}

/// What a `ply` child inherits of this run's environment: where the toolchain is found, where caches
/// default to and the C cache this run was told to keep, so a child takes the emitter output the
/// run already holds, and nothing else, so no variable in the shell that started the run decides
/// what a test asserts.
fn inherited_variables() -> List<String> = ["PATH", "HOME", "TMPDIR", "TEMP", "TMP", "PLY_C_CACHE"]

/// `vars`, then each inherited variable they do not name.
pub fn environment(vars: List<Var>) -> List<Var> / {config.get[env]} =
  inherited_variables().fold(vars, |acc: List<Var>, name: String|
    if vars.any(|v: Var| v.name == name) { acc } else {
      match config.get[env](name) { Some(v) -> acc.push({ name: name, value: v }), None -> acc }
    })

/// What a `ply` child is started with: `environment(vars)`, and the working directory's stage
/// unless `vars` name one.
fn ply_environment(vars: List<Var>) -> List<Var> / {config.get[env], fs.read[cwd], abort.raise} =
  if vars.any(|v: Var| v.name == "PLY_C_STAGE") { environment(vars) } else {
    environment(vars).push({ name: "PLY_C_STAGE", value: working_directory() ++ "/" ++ stage() })
  }

/// The words the binary is started with: `--color never` ahead of the line, so one that spells
/// `--color` itself wins.
fn launch_arguments(argv: List<String>) -> List<String> = ["--color", "never"].concat(argv)

/// The binary `--exec ply` names, started in the working directory with `--color never` ahead of
/// `argv`, so one that spells `--color` itself wins.
pub fn spawned(argv: List<String>, vars: List<Var> = []) -> RunResult / {PlyProcess, abort.raise} =
  spawned_in("", argv, vars)

/// As `spawned`, started in `dir` under the working directory.
pub fn spawned_in(
  dir: String,
  argv: List<String>,
  vars: List<Var>,
) -> RunResult / {PlyProcess, abort.raise} =
  completed_result(process.spawn[ply](launch_arguments(argv), dir, ply_environment(vars)))

/// Each of `argvs` run as `spawned` runs one, all started at once and returned in order.
pub fn spawned_together(argvs: List<List<String>>) -> List<RunResult> / {PlyProcess, abort.raise} = {
  let children = argvs.map(|argv: List<String>|
    match process.start[ply](launch_arguments(argv), "", ply_environment([]), {
        input: false,
        out: Keep,
        err: Keep,
      }) {
      Ok(child) -> child,
      Err(reason) -> panic("`ply` did not start: " ++ reason),
    });
  children.map(|child: Int|
    match process.wait[ply](child, -1) {
      Some(f) -> completed_result(f),
      None -> panic("a wait with no timeout came back with nothing"),
    })
}

pub fn completed_result(f: CompletedProcess) -> RunResult =
  {
    out: lines_of(f.out),
    err: lines_of(f.err),
    code: match f.ended { Exited(c) -> c, Signalled(s) -> 128 + s },
  }

/// A `ply` left running in the working directory, and the port it was told to take.
pub type Server = { process_id: Int, port: Int }

/// A port nothing listened on a moment ago, for a server to be told to take. Every test that takes
/// one writes `ports`, so no two run at once and none is handed a port another holds.
pub fn reserve_port() -> Int / {Network, abort.raise} = {
  let l = net.listen[ports](0);
  let port = match net.local_port[ports](l) {
    Some(p) -> p,
    None -> panic("a listener asked for port 0 was given none"),
  };
  net.close[ports](l);
  port
}

/// The binary started as `spawned` starts it and left running, its streams kept for `ended`.
pub fn start_server(
  argv: List<String>,
  vars: List<Var>,
  port: Int,
) -> Server / {PlyProcess, abort.raise} =
  match process.start[ply](launch_arguments(argv), "", ply_environment(vars), {
      input: false,
      out: Keep,
      err: Keep,
    }) {
    Ok(child) -> { process_id: child, port: port },
    Err(reason) -> panic("`ply` did not start: " ++ reason),
  }

/// The binary started as `spawned` starts it and left running, its output handed over a line at a
/// time through `next_line` and its error stream dropped.
pub fn start_streaming(argv: List<String>, vars: List<Var>) -> Server / {PlyProcess, abort.raise} =
  start_line_output(argv, vars, false)

/// As `start_streaming`, with the binary's input left open: written with `process.input[ply]` and ended
/// with `process.end_input[ply]`.
pub fn start_interactive(
  argv: List<String>,
  vars: List<Var>,
) -> Server / {PlyProcess, abort.raise} = start_line_output(argv, vars, true)

fn start_line_output(
  argv: List<String>,
  vars: List<Var>,
  input: Bool,
) -> Server / {PlyProcess, abort.raise} =
  match process.start[ply](launch_arguments(argv), "", ply_environment(vars), {
      input: input,
      out: Lines,
      err: Discard,
    }) {
    Ok(child) -> { process_id: child, port: 0 },
    Err(reason) -> panic("`ply` did not start: " ++ reason),
  }

/// The next line the server wrote, or `None` when it wrote none within `ms` or ended.
pub fn next_line(server: Server, ms: Int) -> Option<String> / {PlyProcess} =
  match process.output_line[ply](server.process_id, ms) {
    LineWritten(line) -> Some(line),
    _ -> None,
  }

/// The binary run as `spawned` runs it, reading `input` and then the end of its input.
pub fn spawned_reading(
  argv: List<String>,
  vars: List<Var>,
  input: String,
) -> RunResult / {PlyProcess, abort.raise} =
  completed_result(spawned_fed(argv, vars, Bytes::of_string(input)))

/// As `spawned_reading`, for input and output that are not text: how the run ended, and each
/// stream byte for byte.
pub fn spawned_fed(
  argv: List<String>,
  vars: List<Var>,
  input: Bytes,
) -> CompletedProcess / {PlyProcess, abort.raise} =
  match process.start[ply](launch_arguments(argv), "", ply_environment(vars), {
      input: true,
      out: Keep,
      err: Keep,
    }) {
    Err(reason) -> panic("`ply` did not start: " ++ reason),
    Ok(child) -> {
      let _ = process.input[ply](child, input);
      process.end_input[ply](child);
      match process.wait[ply](child, -1) {
        Some(f) -> f,
        None -> panic("a wait with no timeout came back with nothing"),
      }
    },
  }

/// What a run of `ply` needs that only a shell gives it: a pipe whose reader leaves, and a
/// terminal. The shell is the one `--exec sh` names, and the `ply` it starts is the one this run
/// is, which a run of the suite also names `--exec ply`.
pub effect set Shell = {config.get[env], process.read[sh], process.write[sh], os.read, fs.read[cwd]}

/// The path of the `ply` this run is.
pub fn this_ply() -> String / {os.executable, abort.raise} =
  match os.executable() { Some(path) -> path, None -> panic("this `ply` has no path") }

/// The words a shell starts `ply` with, as `spawned` starts it: `--color never` ahead of `argv`.
/// `$PLY` is the binary, which `shell_environment` sets.
fn shell_ply(argv: List<String>) -> String / {abort.raise} =
  match shell_join(launch_arguments(argv)) {
    Some(words) -> "\"$PLY\" " ++ words,
    None -> panic("an argument no shell word spells"),
  }

fn shell_environment() -> List<Var> / {config.get[env], fs.read[cwd], os.executable, abort.raise} =
  ply_environment([]).push({ name: "PLY", value: this_ply() })

/// `ply` run with its output piped into `reader`, a shell command: what the reader wrote, and on
/// stderr what the run wrote there and then `status` and the code it exited with.
pub fn spawned_into(argv: List<String>, reader: String) -> CompletedProcess / {Shell, abort.raise} =
  process.spawn[sh](
    ["-c", "{ " ++ shell_ply(argv) ++ "; echo \"status $?\" >&2; } | " ++ reader],
    "",
    shell_environment(),
  )

/// `ply` started at a terminal of its own, 80 columns by 24 rows, echoing and a line at a time:
/// the pseudo-terminal `script` makes. What is written to the terminal comes a line at a time
/// from the child this returns, what the test writes to the child's input is typed at it, and
/// once `ply` has ended a line that starts `after:` holds what `stty -a` says of the terminal as
/// it was left, its line ends, tabs and semicolons made blanks. `None` where the system has no
/// `script` to make a terminal with, when a test has nothing to assert.
pub fn at_terminal(argv: List<String>) -> Option<Int> / {Shell, abort.raise} =
  if process.spawn[sh](["-c", "command -v script >/dev/null 2>&1"], "", environment([])).ended
      != Exited(0) { None } else {
    let inside = "stty rows 24 columns 80 echo icanon; " ++ shell_ply(argv)
      ++ "; echo \"after: $(stty -a | tr '\\n\\t;' '   ') \"";
    // util-linux's `script` takes the command as one word after `-c`, and the BSDs' as the
    // words after the file it writes its record to.
    let made = match os.family() {
      os::Linux -> "script -qec \"$INSIDE\" /dev/null",
      _ -> "script -q /dev/null sh -c \"$INSIDE\"",
    };
    match process.start[sh](
        ["-c", made],
        "",
        shell_environment().push({ name: "INSIDE", value: inside }),
        { input: true, out: Lines, err: Discard },
      ) {
      Ok(child) -> Some(child),
      Err(reason) -> panic("`script` did not start: " ++ reason),
    }
  }

/// How long a server may take to listen. A server builds its program before it listens, cold where
/// the compiler changed, so this bounds a server that never listens, not how fast one starts.
fn listen_timeout_ms() -> Int = 300000

/// A connection to the server's port that `ready` accepts, or why none came: the server exited, or
/// nothing it responded with was accepted within `listen_timeout_ms`.
pub fn connected<| e>(
  server: Server,
  ready: (Int) -> Bool / e,
) -> Result<Int, String> / {diverges, PlyProcess, Network, Clock | e} =
  connect_when_ready(server, time.elapsed_ms() + listen_timeout_ms(), listen_timeout_ms(), ready)

fn connect_when_ready<| e>(
  server: Server,
  until: Int,
  ms: Int,
  ready: (Int) -> Bool / e,
) -> Result<Int, String> / {PlyProcess, Network, Clock, diverges | e} =
  match process.wait[ply](server.process_id, 0) {
    Some(f) -> Err("`ply run` exited before listening:\n" ++ all_output(completed_result(f))),
    None -> {
      let probe = match net.connect[client]("127.0.0.1", server.port, 250) {
        Some(c) -> if ready(c) { Some(c) } else {
          net.close[client](c);
          None
        },
        None -> None,
      };
      match probe {
        Some(c) -> Ok(c),
        None -> if time.elapsed_ms() >= until {
          Err(
            "nothing listening on 127.0.0.1:" ++ server.port.to_string() ++ " after "
              ++ ms.to_string()
              ++ "ms",
          )
        } else {
          time.sleep_ms(25);
          connect_when_ready(server, until, ms, ready)
        },
      }
    },
  }

/// The first connection the server takes, or the test fails saying why there was none.
pub fn connection(server: Server) -> Int / {PlyProcess, Network, Clock, abort.raise, diverges} =
  match connected(server, |_c: Int| true) {
    Ok(c) -> c,
    Err(reason) -> {
      stop(server);
      panic(reason)
    },
  }

pub fn dial(port: Int, ms: Int) -> Option<Int> / {Network} =
  net.connect[client]("127.0.0.1", port, ms)

pub fn send(c: Int, bytes: Bytes) -> Unit / {Network, abort.raise} =
  if !net::send_all[client](c, bytes, 10000) { panic("the other end stopped taking what was sent") }

/// Everything the other end says until it closes, or falls silent for `ms`; `c` is then closed.
pub fn read_until_closed(c: Int, ms: Int) -> String / {Network, diverges} = {
  let response = net::drain[client](c, b"", ms);
  net.close[client](c);
  String::of_bytes_lossy(response)
}

/// `request` written, and everything said back before the other end closed.
pub fn exchange(c: Int, request: Bytes) -> String / {Network, abort.raise, diverges} = {
  send(c, request);
  read_until_closed(c, 10000)
}

pub fn hang_up(c: Int) -> Unit / {Network} = net.close[client](c)

pub fn signal_to(server: Server, sig: Signal) -> Unit / {PlyProcess, abort.raise} =
  if !process.signal[ply](server.process_id, sig) { panic("the server had already ended") }

/// How the server ended and what it wrote, once it has; one still running after `ms` is killed,
/// and the test fails with `reason`.
pub fn wait_for_exit(
  server: Server,
  ms: Int,
  reason: String,
) -> CompletedProcess / {PlyProcess, abort.raise} =
  match process.wait[ply](server.process_id, ms) {
    Some(f) -> f,
    None -> {
      let _ = process.signal[ply](server.process_id, Kill);
      match process.wait[ply](server.process_id, -1) {
        Some(f) -> panic(reason ++ "\n" ++ all_output(completed_result(f))),
        None -> panic(reason),
      }
    },
  }

/// A server asked for a fixed number of connections and given them returns on its own, cleanly.
pub fn assert_returned_cleanly(server: Server) -> Unit / {PlyProcess, abort.raise} = {
  let f = wait_for_exit(
    server,
    30000,
    "the server was still running 30s after every connection it was asked for; `serve` should have returned",
  );
  match f.ended {
    Exited(c) -> if c != 0 {
      panic(
        "the server exited " ++ c.to_string() ++ " after returning:\n"
          ++ all_output(completed_result(f)),
      )
    },
    Signalled(n) ->
      panic(
        "the server was killed by signal " ++ n.to_string() ++ ":\n"
          ++ all_output(completed_result(f)),
      ),
  }
}

/// The server stopped, for a test that is done with it whatever state it is in: asked to end, so it
/// reports what it read, and killed if it is still running a few seconds on.
pub fn stop(server: Server) -> Unit / {PlyProcess} = {
  let _ = process.signal[ply](server.process_id, Terminate);
  match process.wait[ply](server.process_id, 5000) {
    Some(_) -> (),
    None -> {
      let _ = process.signal[ply](server.process_id, Kill);
      let _ = process.wait[ply](server.process_id, -1);
      ()
    },
  }
}

/// A stream's lines, the newline that ends the last one not making another.
pub fn lines_of(b: Bytes) -> List<String> = {
  let all = String::of_bytes_lossy(b).split("\n");
  let n = all.len();
  match all.at(n - 1) {
    Some("") ->
      range(0, n - 1).fold([], |acc: List<String>, i: Int|
        match all.at(i) { Some(l) -> acc.push(l), None -> acc }),
    _ -> all,
  }
}

pub fn var_of(vars: List<Var>, name: String) -> Option<String> =
  vars.fold(None, |found: Option<String>, v: Var|
    match found { Some(_) -> found, None -> if v.name == name { Some(v.value) } else { None } })

/// `dir` and `name` as one path, a `.` or empty directory adding nothing.
pub fn joined(dir: String, name: String) -> String = {
  let d = segments(dir);
  let n = segments(name);
  d.concat(n).fold("", |acc: String, s: String| if acc == "" { s } else { acc ++ "/" ++ s })
}

/// The directory a path sits in, and `""` for one with a single segment.
pub fn parent(p: String) -> String = {
  let segs = segments(p);
  range(0, segs.len() - 1).fold("", |acc: String, i: Int|
    match segs.at(i) { Some(s) -> if acc == "" { s } else { acc ++ "/" ++ s }, None -> acc })
}

pub fn manifest(name: String, dependencies: String) -> String =
  "import std.pkg (Manifest)\nfn package() -> Manifest = {name: \"" ++ name
    ++ "\", version: {major: 0, minor: 0, patch: 1}, prefix: None, runtime: {major: 0, minor: 0, patch: 1}, dependencies: ["
    ++ dependencies
    ++ "], entry: None}\n"

pub fn not_ok(report: Json) -> Bool = at(report, "ok") == json::Bool(false)

pub fn diagnostic_codes(v: Json) -> List<String> =
  items(at(v, "diagnostics")).map(|d: Json| str(at(d, "code")))

pub fn diagnostic(report: Json) -> Json = nth(at(report, "diagnostics"), 0)

/// The code of each failure a `ply test --json` report holds, in its order.
pub fn failure_codes(report: Json) -> List<String> =
  items(at(report, "failures")).map(|f: Json| str(path(f, ["diagnostic", "code"])))

pub fn code_of(report: Json) -> String = str(at(diagnostic(report), "code"))

pub fn test_report(flags: List<String>) -> Json / {PlyProcess, abort.raise} =
  json_of(spawned(["test", ".", "--json"].concat(flags)))

/// The tests a `ply test --json` report ran rather than took from a pass, by name.
pub fn selected(report: Json) -> List<String> =
  items(path(report, ["selection", "tests"])).filter(|t: Json| bool(at(t, "selected"))).map(
    |t: Json| str(at(t, "name")),
  )

/// The tests a `ply test --json` report failed, by name.
pub fn failed(report: Json) -> List<String> =
  items(at(report, "results")).filter(|r: Json| str(at(r, "status")) == "failed").map(|r: Json|
    str(at(r, "name")))

pub fn is_number(j: Json) -> Bool = match j { Number(_) -> true, _ -> false }

pub fn succeeded(ran: RunResult) -> RunResult / {abort.raise} = {
  assert(ran.code == 0, Some(all_output(ran)));
  ran
}

pub fn dependency(name: String, at_path: String) -> String =
  "{name: \"" ++ name ++ "\", prefix: None, min: {major: 0, minor: 0, patch: 1}, source: Path(\""
    ++ at_path
    ++ "\")}"

pub fn exists(p: String) -> Bool / {fs.exists[cwd]} = fs.exists[cwd](p)

pub fn proved_here(flags: List<String>) -> Json / {PlyProcess, abort.raise} =
  json_of(spawned(["prove", ".", "--no-cache", "--json"].concat(flags)))

pub fn proved(source: String) -> Json / {PlyProcess, WorkingDirectory, abort.raise} = {
  write_program(source);
  proved_here([])
}

pub fn outcome_of(o: Json) -> String = str(at(o, "outcome"))

/// The fields of every rule of `o`'s certificate tagged `tag`: `Null` for a rule with none.
pub fn rules_of(o: Json, tag: String) -> List<Json> =
  items(path(o, ["certificate", "rules"])).fold([], |acc: List<Json>, rule: Json|
    match rule {
      Str(named) -> if named == tag { acc.push(Null) } else { acc },
      Object(fields) -> match fields.get(tag) { Some(f) -> acc.push(f), None -> acc },
      _ -> acc,
    })

test "a path's parent is all of it but its last segment" {
  assert_eq(parent("a/b/c.ply"), "a/b");
  assert_eq(parent("c.ply"), "")
}

test "a directory and a name join, a `.` adding nothing" {
  assert_eq(joined("a/b", "c.ply"), "a/b/c.ply");
  assert_eq(joined(".", "c.ply"), "c.ply")
}

test "a stream's lines hold no empty line after the newline that ends the last" {
  assert_eq(lines_of(b"one\ntwo\n"), ["one", "two"])
}
