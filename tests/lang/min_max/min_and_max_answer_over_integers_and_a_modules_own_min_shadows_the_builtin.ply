fn clamp(n: Int, lo: Int, hi: Int) -> Int = max(lo, min(n, hi))

test "min and max" {
  assert_eq(min(3, 5), 3);
  assert_eq(max(3, 5), 5);
  assert_eq(min(-7, -7), -7);
  assert_eq(max(-7, 2), 2);
  assert_eq(clamp(12, 0, 10), 10);
  assert_eq(clamp(-3, 0, 10), 0);
  assert_eq(clamp(4, 0, 10), 4)
}
