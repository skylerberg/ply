//! A `const fn` is evaluated as any definition is: a scanner written in byte literals and range
//! patterns, and arithmetic that wraps, saturates and rotates, are kept as what they compute.

type Sums = { wrapped: U8, capped: U8, mixed: U32 }

/// A hex digit's value, and nothing for any other byte.
fn digit(b: Int) -> Option<Int> =
  match b {
    b'0'..=b'9' -> Some(b - b'0'),
    b'a'..=b'f' -> Some(b - b'a' + 10),
    b'_' | b' ' -> None,
    _ -> None,
  }

fn digits(text: Bytes) -> List<Int> / {abort.raise} =
  fold(range(0, bytes_len(text)), [], |acc: List<Int>, i: Int|
    match digit(bytes_at(text, i)) { Some(d) -> push(acc, d), None -> acc })

/// A sum that wraps at eight bits, one that stops at them, and a mix that rotates at thirty-two.
fn summed(ds: List<Int>) -> Sums / {abort.raise} =
  fold(ds, { wrapped: 0u8, capped: 0u8, mixed: 0x9E37_79B9u32 }, |acc: Sums, d: Int| {
    let byte = u8_of_int(d * 17);
    {
      wrapped: acc.wrapped +% byte,
      capped: acc.capped +| byte,
      mixed: rotl(acc.mixed *% 31u32, 5) ^ u32_of_int(d),
    }
  })

fn computed() -> Sums / {abort.raise} = summed(digits(b"dead_beef 0042"))

const fn kept() -> Sums = summed(digits(b"dead_beef 0042"))

/// Each of the builtins the operators are written in, and the conversion beside them.
const fn reached() -> { ints: List<Option<Int>>, ends: List<U8>, turned: U8 } =
  {
    ints: [to_int(kept().wrapped), to_int(18446744073709551615u64), to_int(i8_of_int(0 - 1))],
    ends: [
      wrap_add(250u8, 10u8),
      wrap_sub(3u8, 10u8),
      wrap_mul(16u8, 17u8),
      saturating_add(250u8, 10u8),
      saturating_sub(3u8, 10u8),
      saturating_mul(16u8, 17u8),
    ],
    turned: rotr(rotl(129u8, 3), 3),
  }

test "a `const fn` written in byte literals, range patterns and wrapping operators keeps what it computes" {
  assert_eq(digits(b"dead_beef 0042"), [13, 14, 10, 13, 11, 14, 14, 15, 0, 0, 4, 2]);
  assert_eq(kept(), computed());
  assert_eq(kept().wrapped, 78u8);
  assert_eq(kept().capped, 255u8)
}

test "a `const fn` that reaches the builtins the operators are written in keeps their answers" {
  assert_eq(reached().ints, [Some(78), None, Some(0 - 1)]);
  assert_eq(reached().ends, [4u8, 249u8, 16u8, 255u8, 0u8, 255u8]);
  assert_eq(reached().turned, 129u8)
}

test "what a build kept of them is read at no cost" {
  let read = metered(|| (kept(), reached()));
  let nothing = metered(|| (0, 0));
  assert_eq(read.steps, nothing.steps)
}

law "what a build kept of wrapping arithmetic is what a run computes" { kept() == computed() }
