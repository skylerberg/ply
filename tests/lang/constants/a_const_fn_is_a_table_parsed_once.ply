//! A `const fn` is evaluated at its first read, and every later read returns that value: the file
//! it was made from is parsed once. The table here is the HTTP status codes the IANA registry
//! assigns, in code order, so a code is found by halving.

import std.string

type Status = { code: Int, reason: String }

fn row(line: String) -> Status / {abort.raise} =
  match line.split_once(",") {
    None -> panic("no description in `" ++ line ++ "`"),
    Some(cut) -> match cut.head.int_of_string() {
      Some(code) -> { code: code, reason: cut.tail },
      None -> panic("no value in `" ++ line ++ "`"),
    },
  }

/// The registry's rows below its heading.
fn parsed(text: Bytes) -> Array<Status> / {abort.raise} =
  match String::of_bytes(text).split("\n").filter(|line: String| line != "") {
    [_, ..rows] -> Array::of_list(rows.map(row)),
    [] -> panic("the registry has a heading"),
  }

const fn statuses() -> Array<Status> = parsed(embed("status_codes.csv"))

fn computed() -> Array<Status> / {abort.raise} = parsed(embed("status_codes.csv"))

/// A table of 2^62 rows is found in 62 halvings.
fn reason_in(table: Array<Status>, code: Int) -> Option<String> / {abort.raise} =
  iterate({ lo: 0, hi: table.len() }, 64, |s: { lo: Int, hi: Int }|
    if s.lo >= s.hi { Stop(None) } else {
      let mid = s.lo + (s.hi - s.lo) / 2;
      let at = table.get(mid);
      if at.code == code { Stop(Some(at.reason)) }
      else if at.code < code { Continue({ lo: mid + 1, hi: s.hi }) }
      else { Continue({ lo: s.lo, hi: mid }) }
    })

fn reason(code: Int) -> Option<String> / {abort.raise} = reason_in(statuses(), code)

test "a code is found in the table by halving" {
  assert_eq(reason(200), Some("OK"));
  assert_eq(reason(100), Some("Continue"));
  assert_eq(reason(511), Some("Network Authentication Required"));
  assert_eq(reason(418), None);
  assert_eq(reason(99), None);
  assert_eq(reason(600), None);
  assert_eq(statuses().len(), 60)
}

test "every code the table holds is found in it" {
  statuses().to_list().fold((), |_: Unit, s: Status| assert_eq(reason(s.code), Some(s.reason)))
}

law "the table read is the table its body makes" { statuses() == computed() }
