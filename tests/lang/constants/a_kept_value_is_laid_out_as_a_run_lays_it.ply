//! A kept value is laid out when the program is built as a run lays out a value of its type: a long
//! list's trie, a large map's tree, an array's and a `Columns`' elements in place, a record's fields
//! and a sum's case. Each reads, and is written to, as a value a run made does, and a read of it
//! costs nothing.

import std.pace (spent)

type Point = { x: Int, y: Float }

type Shape = | Dot | Line(Point, Point)

type Tables = {
  short: List<Int>,
  long: List<String>,
  wide: Map<Int, String>,
  points: Array<Point>,
  either: Result<String, String>,
  maybe: Option<String>,
  shapes: List<Shape>,
}

fn made() -> Tables / {abort.raise} =
  {
    short: range(0, 40).map(|i: Int| i * 3),
    long: range(0, 1100).map(|i: Int| i.to_string()),
    wide: Map::of_entries(range(0, 1100).map(|i: Int| { key: i * 7, value: i.to_string() })),
    points: Array::of_list([{ x: 1, y: 0.5 }, { x: 2, y: 1.5 }]),
    either: Err("no"),
    maybe: Some("yes"),
    shapes: [Dot, Line({ x: 0, y: 0.0 }, { x: 1, y: 1.0 })],
  }

const fn kept() -> Tables = made()

const fn point() -> Point = { x: 3, y: 2.5 }

const fn columns() -> Columns<Point> = Columns::of_list([{ x: 1, y: 0.5 }, { x: 2, y: 1.5 }])

const fn failed() -> Result<String, String> = Err("no")

test "a kept value is the value its body makes" {
  assert_eq(kept(), made());
  assert_eq(point(), { x: 3, y: 2.5 });
  assert_eq(columns().to_list(), [{ x: 1, y: 0.5 }, { x: 2, y: 1.5 }]);
  assert_eq(failed(), Err("no"))
}

test "a kept list's trie and a kept map's tree read as a run's do" {
  assert_eq(kept().long.at(0), Some("0"));
  assert_eq(kept().long.at(1099), Some("1099"));
  assert_eq(kept().long.at(1100), None);
  assert_eq(kept().wide.get(7 * 1099), Some("1099"));
  assert_eq(kept().wide.get(8), None);
  assert_eq(kept().wide.keys(), made().wide.keys());
  assert_eq(kept().points.get(1), { x: 2, y: 1.5 });
  assert_eq(columns().get(0), { x: 1, y: 0.5 })
}

test "a kept value is written to as a run's is, and is left as it was" {
  assert_eq(kept().short.push(1).len(), 41);
  assert_eq(kept().long.push("x").at(1100), Some("x"));
  assert_eq(kept().long.set(5, "five").at(5), Some("five"));
  assert_eq(kept().long.at(5), Some("5"));
  let grown = range(0, 40).fold(kept().long, |acc: List<String>, i: Int| acc.push(i.to_string()));
  assert_eq(grown.len(), 1140);
  assert_eq(kept().wide.insert(1, "one").get(1), Some("one"));
  assert_eq(kept().wide.insert(7, "seven").get(7), Some("seven"));
  assert_eq(kept().wide.len(), 1100);
  assert_eq(kept().points.set(0, { x: 9, y: 9.0 }).get(0), { x: 9, y: 9.0 });
  assert_eq(kept().points.get(0), { x: 1, y: 0.5 });
  assert_eq(columns().set(1, { x: 5, y: 5.0 }).get(1), { x: 5, y: 5.0 });
  assert_eq(columns().get(1), { x: 2, y: 1.5 })
}

test "a kept value of any shape is read with no step and no allocation" {
  let nothing = spent(|| 0);
  let read = spent(|| {
    let t = kept();
    point().x + t.short.len() + columns().len() + (match failed() { Ok(_) -> 0, Err(_) -> 1 })
  });
  assert_eq(read.steps, nothing.steps);
  assert_eq(read.allocations, nothing.allocations)
}
