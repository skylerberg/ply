//! What a build keeps of a `const fn` reads back as the value the body makes, at every type a
//! value is data at: the same words, a map in the order its keys decide, and what the value
//! shares shared.

import std.set
import std.set (Set)
import std.string

type Shade = | Dark | Light(Int) | Mixed(Shade, Shade)

type Point = new { x: Int, y: Int }

type Name = | Name(String)

fn folded(n: Name) -> String = match n { Name(s) -> s.ascii_lower() }

key for Name by folded

type Kept = {
  ints: Array<Int>,
  wide: List<Int>,
  edges: List<Int>,
  small: U8,
  signed: I16,
  big: U64,
  huge: I128,
  ratio: Float,
  price: Decimal,
  letter: Char,
  text: String,
  raw: Bytes,
  flag: Bool,
  nothing: Unit,
  shades: List<Shade>,
  points: Map<String, Point>,
  people: Map<Name, Int>,
  maybe: List<Option<Result<Int, String>>>,
  pair: (Int, String),
  set: Set<Int>,
  nested: Array<List<Bytes>>,
  empty: { list: List<Int>, map: Map<Int, Int>, array: Array<String>, bytes: Bytes },
}

fn made() -> Kept / {abort.raise} = {
  let shared = [b"one", b"", b"three"];
  {
    ints: Array::of_list(range(0, 5000).map(|i: Int| i * i - 7)),
    wide: range(0, 100).map(|i: Int| 0 - i),
    edges: [9223372036854775807, 0 - 9223372036854775807 - 1, 4611686018427387904, 0],
    small: 255u8,
    signed: -3i16,
    big: 18446744073709551615u64,
    huge: -170141183460469231731687303715884105727i128,
    ratio: 1.5e-3,
    price: 1.50m,
    letter: '\u{1F600}',
    text: "na\u{EF}ve",
    raw: b"\x00\xff@@\"?",
    flag: true,
    nothing: (),
    shades: [Dark, Light(3), Mixed(Dark, Mixed(Light(0 - 1), Dark)), Dark],
    points: #{"origin": { x: 0, y: 0 }, "east": { x: 1, y: 0 }},
    people: #{Name("bob"): 1, Name("Alice"): 2, Name("carol"): 3},
    maybe: [None, Some(Ok(1)), Some(Err("no"))],
    pair: (7, "seven"),
    set: #[3, 1, 2],
    nested: Array::of_list([shared, shared, []]),
    empty: { list: [], map: Map::new(), array: Array::of_list([]), bytes: b"" },
  }
}

const fn kept() -> Kept = made()

const fn second() -> Int = match kept().ints.at(3) { Some(n) -> n + 1, None -> 0 }

test "a kept value is the value its body makes, at every type" {
  assert_eq(kept(), made());
  assert_eq(kept().edges, made().edges);
  assert_eq(kept().ratio, 1.5e-3);
  assert_eq(kept().price.to_string(), "1.50")
}

test "a kept map is in the order its keys decide, and is found through them" {
  assert_eq(kept().people.keys(), made().people.keys());
  assert_eq(kept().people.get(Name("ALICE")), Some(2));
  assert_eq(kept().people.get(Name("dave")), None);
  assert_eq(kept().set.elements(), [1, 2, 3]);
  assert(kept().set.contains(2))
}

test "a kept value is written to as any value is, and is left as it was" {
  let grown = kept().wide.push(1);
  assert_eq(grown.len(), 101);
  assert_eq(kept().wide.len(), 100);
  let set = kept().ints.set(0, 42);
  assert_eq(set.get(0), 42);
  assert_eq(kept().ints.get(0), 0 - 7);
  assert_eq(kept().points.insert("west", { x: 0 - 1, y: 0 }).len(), 3);
  assert_eq(kept().points.len(), 2)
}

test "a `const fn` reads another, and each is read at no cost" {
  assert_eq(second(), 3);
  let read = metered(|| second() + kept().ints.len());
  let nothing = metered(|| 0 + 0);
  assert_eq(read.steps, nothing.steps);
  assert_eq(read.allocations, nothing.allocations)
}
