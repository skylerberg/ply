//! What a build keeps of a `const fn` reads back as the value the body makes, at every type a
//! value is data at: the same words, a map in the order its keys decide, and what the value
//! shares shared.

import std.set
import std.set (Set)

type Shade = | Dark | Light(Int) | Mixed(Shade, Shade)

type Point = new { x: Int, y: Int }

type Name = | Name(String)

fn folded(n: Name) -> String = match n { Name(s) -> string_lower(s) }

key for Name by folded

type Kept = {
  ints: Array<Int>,
  wide: List<Int>,
  edges: List<Int>,
  small: U8,
  signed: I16,
  big: U64,
  huge: I128,
  ratio: Float,
  price: Decimal,
  letter: Char,
  text: String,
  raw: Bytes,
  flag: Bool,
  nothing: Unit,
  shades: List<Shade>,
  points: Map<String, Point>,
  people: Map<Name, Int>,
  maybe: List<Option<Result<Int, String>>>,
  pair: (Int, String),
  set: Set<Int>,
  nested: Array<List<Bytes>>,
  empty: { list: List<Int>, map: Map<Int, Int>, array: Array<String>, bytes: Bytes },
}

fn made() -> Kept / {abort.raise} = {
  let shared = [b"one", b"", b"three"];
  {
    ints: array_of_list(map(range(0, 5000), |i: Int| i * i - 7)),
    wide: map(range(0, 100), |i: Int| 0 - i),
    edges: [9223372036854775807, 0 - 9223372036854775807 - 1, 4611686018427387904, 0],
    small: 255u8,
    signed: -3i16,
    big: 18446744073709551615u64,
    huge: -170141183460469231731687303715884105727i128,
    ratio: 1.5e-3,
    price: 1.50m,
    letter: '\u{1F600}',
    text: "na\u{EF}ve",
    raw: b"\x00\xff@@\"?",
    flag: true,
    nothing: (),
    shades: [Dark, Light(3), Mixed(Dark, Mixed(Light(0 - 1), Dark)), Dark],
    points: #{"origin": { x: 0, y: 0 }, "east": { x: 1, y: 0 }},
    people: #{Name("bob"): 1, Name("Alice"): 2, Name("carol"): 3},
    maybe: [None, Some(Ok(1)), Some(Err("no"))],
    pair: (7, "seven"),
    set: #[3, 1, 2],
    nested: array_of_list([shared, shared, []]),
    empty: { list: [], map: map_new(), array: array_of_list([]), bytes: b"" },
  }
}

const fn kept() -> Kept = made()

const fn second() -> Int = match array_at(kept().ints, 3) { Some(n) -> n + 1, None -> 0 }

test "a kept value is the value its body makes, at every type" {
  assert_eq(kept(), made());
  assert_eq(kept().edges, made().edges);
  assert_eq(kept().ratio, 1.5e-3);
  assert_eq(decimal_to_string(kept().price), "1.50")
}

test "a kept map is in the order its keys decide, and is found through them" {
  assert_eq(map_keys(kept().people), map_keys(made().people));
  assert_eq(map_get(kept().people, Name("ALICE")), Some(2));
  assert_eq(map_get(kept().people, Name("dave")), None);
  assert_eq(set::elements(kept().set), [1, 2, 3]);
  assert(set::contains(kept().set, 2))
}

test "a kept value is written to as any value is, and is left as it was" {
  let grown = push(kept().wide, 1);
  assert_eq(len(grown), 101);
  assert_eq(len(kept().wide), 100);
  let set = array_set(kept().ints, 0, 42);
  assert_eq(array_get(set, 0), 42);
  assert_eq(array_get(kept().ints, 0), 0 - 7);
  assert_eq(map_len(map_insert(kept().points, "west", { x: 0 - 1, y: 0 })), 3);
  assert_eq(map_len(kept().points), 2)
}

test "a `const fn` reads another, and each is read at no cost" {
  assert_eq(second(), 3);
  let read = metered(|| second() + array_len(kept().ints));
  let nothing = metered(|| 0 + 0);
  assert_eq(read.steps, nothing.steps)
}
