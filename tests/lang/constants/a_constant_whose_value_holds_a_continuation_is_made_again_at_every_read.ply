effect amb {
  read flip[coin]() -> Bool
}

type Saved = | Done(Int) | Parked(once (Bool) -> Saved)

fn parked() -> Saved =
  handle {
    let b = amb.flip[coin]();
    Done(if b { 41 } else { 0 })
  } with {
    amb.flip[coin]() resume k -> Parked(k),
  }

fn resumed(s: keep Saved) -> Int =
  match s { Parked(k) -> match k(true) { Done(n) -> n, Parked(again) -> 0 }, Done(n) -> n }

test "each read of a constant holding a continuation resumes a continuation of its own" {
  assert_eq(resumed(parked()), 41);
  assert_eq(resumed(parked()), 41)
}
