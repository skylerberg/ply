import constants.limits
import constants.limits (Limits, max_hops, doubled, names, defaults, hops)

const local_limit: Int = doubled + 2

const greeting: String = "hello"

fn shadowed(max_hops: Int) -> Int = max_hops + 1

test "a constant reads as its value, by name or through its module" {
  assert_eq(max_hops, 40);
  assert_eq(limits::max_hops, 40);
  assert_eq(doubled, 80);
  assert_eq(local_limit, 82)
}

test "a method or a field of a constant reads its value" {
  assert_eq(names.len(), 2);
  assert_eq(limits::names.len(), 2);
  assert_eq(greeting.len(), 5);
  assert_eq(defaults.hops, 40);
  assert_eq(defaults.name, "plain")
}

test "a parameter or a local of a constant's name hides it" {
  assert_eq(shadowed(1), 2);
  let max_hops = 3;
  assert_eq(max_hops, 3)
}

test "a parameter's default may be a constant" {
  assert_eq(hops(), 40);
  assert_eq(hops(1), 1)
}

test "a constant is passed and stored as any value is" {
  let held: Limits = { ..defaults, hops: max_hops + 1 };
  assert_eq(held.hops, 41);
  assert_eq([max_hops, doubled].len(), 2)
}
