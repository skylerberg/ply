//! A map a build keeps reads back with its keys where `compare` places them, for every kind of key:
//! each key is found, and the keys ascend by `compare`.

type Shape = | Square(Int) | Circle(Int) | Dot

type Keyed = {
  ints: Map<Int, Unit>,
  texts: Map<String, Unit>,
  bytes: Map<Bytes, Unit>,
  chars: Map<Char, Unit>,
  flags: Map<Bool, Unit>,
  units: Map<Unit, Unit>,
  shapes: Map<Shape, Unit>,
  records: Map<{ name: String, n: Int }, Unit>,
  pairs: Map<(Int, String), Unit>,
  options: Map<Option<Int>, Unit>,
  results: Map<Result<Int, String>, Unit>,
  lists: Map<List<Int>, Unit>,
  decimals: Map<Decimal, Unit>,
  many: Map<Int, Unit>,
}

fn ints() -> List<Int> = [3, 0 - 1, 4000000000000000000, 0, 0 - 7, 9]

fn texts() -> List<String> = ["b", "", "ab", "é", "a", "Z", "aa"]

fn bytes() -> List<Bytes> = [b"\x01", b"", b"\xff", b"a\x00", b"a"]

fn chars() -> List<Char> = ['z', 'a', 'é', '0']

fn shapes() -> List<Shape> = [Square(2), Circle(1), Dot, Square(1), Circle(5)]

fn records() -> List<{ name: String, n: Int }> =
  [{ name: "b", n: 1 }, { name: "a", n: 2 }, { name: "a", n: 1 }]

fn pairs() -> List<(Int, String)> = [(2, "a"), (1, "b"), (1, "a")]

fn options() -> List<Option<Int>> = [Some(3), None, Some(0 - 1)]

fn results() -> List<Result<Int, String>> = [Ok(1), Err("e"), Ok(0 - 2), Err("a")]

fn lists() -> List<List<Int>> = [[2, 1], [1], [], [1, 2]]

fn decimals() -> List<Decimal> = [2.5m, 1.0m, 0.0m - 3.25m, 0.001m]

fn many() -> List<Int> = range(0, 1100).map(|i: Int| i * 7919 % 1100)

fn of<k>(keys: List<k>) -> Map<k, Unit>
  where derivable(ord, k)
= Map::of_entries(keys.map(|x: k| { key: x, value: () }))

fn made() -> Keyed =
  {
    ints: of(ints()),
    texts: of(texts()),
    bytes: of(bytes()),
    chars: of(chars()),
    flags: of([true, false]),
    units: of([()]),
    shapes: of(shapes()),
    records: of(records()),
    pairs: of(pairs()),
    options: of(options()),
    results: of(results()),
    lists: of(lists()),
    decimals: of(decimals()),
    many: of(many()),
  }

const fn kept() -> Keyed = made()

fn ascends<k>(keys: List<k>) -> Bool
  where derivable(ord, k)
=
  keys.fold({ ok: true, last: None }, |s: { ok: Bool, last: Option<k> }, x: k|
    {
      ok: s.ok && (match s.last { Some(p) -> compare(p, x) == Less, None -> true }),
      last: Some(x),
    }).ok

/// Whether `m` holds each of `keys`, which are distinct, in `compare`'s order.
fn placed<k>(m: Map<k, Unit>, keys: List<k>) -> Bool
  where derivable(ord, k)
=
  m.len() == keys.len() && ascends(m.keys())
    && keys.fold(true, |ok: Bool, x: k| ok && m.contains(x))

test "a kept map of each kind of key finds every key where compare places it" {
  let k = kept();
  assert(placed(k.ints, ints()), None);
  assert(placed(k.texts, texts()), None);
  assert(placed(k.bytes, bytes()), None);
  assert(placed(k.chars, chars()), None);
  assert(placed(k.flags, [true, false]), None);
  assert(placed(k.units, [()]), None);
  assert(placed(k.shapes, shapes()), None);
  assert(placed(k.records, records()), None);
  assert(placed(k.pairs, pairs()), None);
  assert(placed(k.options, options()), None);
  assert(placed(k.results, results()), None);
  assert(placed(k.lists, lists()), None);
  assert(placed(k.decimals, decimals()), None);
  assert(placed(k.many, many()), None);
  assert_eq(k, made())
}
