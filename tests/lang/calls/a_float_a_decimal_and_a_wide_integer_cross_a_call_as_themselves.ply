//! A `Float`, a `Decimal`, an `I64` or a `U64` crosses a call between functions as itself, never
//! boxed into an object, whether a function declares it or takes it as a type argument; a call
//! that fails inside one fails the caller, and calls nested thousands deep answer what they mean.

fn add(acc: Float, x: Float) -> Float = acc + x

fn halved(x: Float) -> Float = x / 2.0

fn summed(xs: List<Float>) -> Float = xs.fold(0.0, add)

fn either<a>(c: Bool, x: a, y: a) -> a = if c { x } else { y }

fn evens(xs: List<Float>, i: Int, acc: Float) -> Float =
  match xs.at(i) { Some(x) -> evens(xs, i + 1, acc + either(i % 2 == 0, x, 0.0)), None -> acc }

fn halves(xs: List<Float>, i: Int, acc: Float) -> Float =
  match xs.at(i) { Some(x) -> halves(xs, i + 1, acc + halved(x)), None -> acc }

fn priced(d: Decimal, n: Int) -> Decimal = d * 2m + Decimal::of_int(n)

fn total(n: Int, i: Int, acc: Decimal) -> Decimal =
  if i >= n { acc } else { total(n, i + 1, priced(acc, i) - acc) }

fn mixed(a: U64, b: I64) -> U64 / {abort.raise} = a + U64::of_int(Int::of_i64(b) % 7)

fn wide(n: Int, i: Int, acc: U64) -> U64 / {abort.raise} =
  if i >= n { acc } else { wide(n, i + 1, mixed(acc, I64::of_int(i))) }

fn ratio(x: Float, y: Float) -> Float / {abort.raise} =
  if y == 0.0 { abort.raise("no ratio") } else { x / y }

fn ratios(x: Float) -> Float / {abort.raise} = ratio(x, x - 1.0) + 1.0

/// A non-tail call nine thousand deep, each frame holding a `Float` and answering one.
fn depth(x: Float, n: Int) -> Float = if n <= 0 { x } else { depth(x + 1.0, n - 1) + 0.5 }

test "functions of floats, decimals and wide integers return what they mean" {
  assert_eq(summed([1.5, 2.5, 3.0]), 7.0);
  assert_eq(halves([2.0, 4.0], 0, 0.0), 3.0);
  assert_eq(total(3, 0, 1.5m), 4.5m);
  assert_eq(wide(3, 0, 1u64), 4u64);
  assert_eq(ratios(3.0), 2.5);
  assert_eq(evens([1.0, 2.0, 4.0], 0, 0.0), 5.0)
}

test "a failure inside a function returning a float fails its caller" {
  assert_eq(try[abort.raise] { ratios(1.0) }, Err("no ratio"))
}

test "a float carried through calls nested thousands deep returns what it means" {
  assert_eq(depth(0.0, 9000), 13500.0)
}
