// A cache keyed on a body's content alone would serve one body for both.
fn one(b: Bytes, i: Int) -> Int / {abort.raise} = bytes_at(b, i) + 1

fn two(b: Bytes, i: Int) -> Int / {abort.raise} = bytes_at(b, i) + 1

test "two definitions that say the same thing each answer" {
  assert_eq(one(b"ab", 0), 98);
  assert_eq(two(b"ab", 1), 99)
}
