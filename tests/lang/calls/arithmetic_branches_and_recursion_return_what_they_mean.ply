fn double(x: Int) -> Int = x * 2

fn even(x: Int) -> Bool = x % 2 == 0

fn clamp(x: Int, lo: Int, hi: Int) -> Int = if x < lo { lo } else { if x > hi { hi } else { x } }

fn collatz(n: Int) -> Int / {diverges} =
  if n <= 1 { 0 } else { if even(n) { 1 + collatz(n / 2) } else { 1 + collatz(3 * n + 1) } }

fn sign(n: Int) -> Int = match n { 0 -> 0, _ -> if n < 0 { 0 - 1 } else { 1 } }

fn busy(n: Int) -> Int = {
  let a = double(n);
  let b = clamp(a, 0, 100);
  b + sign(a)
}

fn ladder(n: Int) -> Int = if n <= 0 { 0 } else { 1 + ladder(n - 1) }

fn limit() -> Int = 7

fn odd(n: Int) -> Bool = n % 2 == 1

fn capped(n: Int) -> Int = if odd(n) && n > limit() { limit() } else { n }

fn shaped(x: Int) -> List<Int> = [x, x]

test "arithmetic, branches and recursion return the expected values" {
  assert_eq(double(21), 42);
  assert_eq(even(4), true);
  assert_eq(even(7), false);
  assert_eq(clamp(150, 0, 100), 100);
  assert_eq(collatz(27), 111);
  assert_eq(sign(0 - 9), 0 - 1);
  assert_eq(sign(0), 0);
  assert_eq(busy(9), 19);
  assert_eq(capped(9), 7);
  assert_eq(capped(8), 8);
  assert_eq(capped(3), 3);
  assert_eq(shaped(1), [1, 1]);
  assert_eq(ladder(100), 100)
}
