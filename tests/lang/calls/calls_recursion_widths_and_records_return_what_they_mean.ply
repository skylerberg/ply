fn double(x: Int) -> Int = x * 2

fn even(x: Int) -> Bool = x % 2 == 0

fn clamp(x: Int, lo: Int, hi: Int) -> Int = if x < lo { lo } else { if x > hi { hi } else { x } }

fn collatz(n: Int) -> Int / {diverges} =
  if n <= 1 { 0 } else { if even(n) { 1 + collatz(n / 2) } else { 1 + collatz(3 * n + 1) } }

fn width(a: Int, b: Int) -> Int / {abort.raise} =
  Int::of_u32(wrap_add(U32::of_int(a), U32::of_int(b)) ^ rotr(U32::of_int(b), 8))

fn shaped(n: Int) -> Int = {
  let r = { x: n, y: n + 1 };
  r.x * 10 + r.y
}

test "calls, recursion, wide integers and records return the expected values" {
  assert_eq(double(21), 42);
  assert_eq(clamp(150, 0, 100), 100);
  assert_eq(collatz(27), 111);
  assert_eq(width(7, 9), 16 ^ 150994944);
  assert_eq(shaped(4), 45)
}

type Quad = { a: U32, b: U32, c: U32, d: U32 }

fn g(q: Quad, mx: U32) -> Quad = {
  let a1 = wrap_add(wrap_add(q.a, q.b), mx);
  let d1 = rotr(q.d ^ a1, 16);
  let c1 = wrap_add(q.c, d1);
  let b1 = rotr(q.b ^ c1, 12);
  { a: a1, b: b1, c: c1, d: d1 }
}

fn mixed(n: Int) -> Int / {abort.raise} = {
  let w = U32::of_int(n);
  let q = g({ a: w, b: 1u32, c: 0x3C6E_F372u32, d: 0xA54F_F53Au32 }, w);
  Int::of_u32(q.a ^ q.b ^ q.c ^ q.d)
}

fn counted(n: Int) -> Int / {abort.raise} =
  iterate({ i: 0, accumulator: 0 }, n + 1, |s: { i: Int, accumulator: Int }|
    if s.i >= n { Stop(s.accumulator) }
    else { Continue({ i: s.i + 1, accumulator: s.accumulator + s.i * s.i }) })

fn bytes_sum(b: Bytes) -> Int / {abort.raise} =
  iterate({ i: 0, accumulator: 0 }, b.len() + 1, |s: { i: Int, accumulator: Int }|
    if s.i >= b.len() { Stop(s.accumulator) }
    else { Continue({ i: s.i + 1, accumulator: s.accumulator + b.at(s.i) }) })

fn shifted(a: Int, n: Int) -> Int = (a << n) + (a >> n) + (a >>> n)

fn matched(n: Int) -> Int = match n { 0 -> 100, 1 -> 200, _ -> n * 3 }

fn looped(n: Int) -> Int / {abort.raise} =
  iterate({ i: 0, q: { a: 1u32, b: 2u32, c: 3u32, d: 4u32 } }, n + 1, |s: { i: Int, q: Quad }|
    if s.i >= n { Stop(Int::of_u32(s.q.a ^ s.q.b ^ s.q.c ^ s.q.d)) }
    else { Continue({ i: s.i + 1, q: g(s.q, U32::of_int(s.i)) }) })

test "fixed-width integers, loops over records and shifts return the expected values" {
  assert_eq(mixed(0xDEAD_BEEF), 0x4896_3B0D);
  assert_eq(mixed(0), 0x4892_2726);
  assert_eq(counted(40), 20540);
  assert_eq(looped(1), 0x0010_0070);
  assert_eq(looped(7), 0x627E_6B17);
  assert_eq(bytes_sum(b"the quick brown fox"), 1843);
  assert_eq(shifted(-9, 3), 2305843009213693876);
  assert_eq(matched(0), 100);
  assert_eq(matched(1), 200);
  assert_eq(matched(7), 21)
}

fn wide(n: Int) -> Int / {abort.raise} = {
  let a = U64::of_int(n);
  let b = wrap_mul(wrap_add(a, a), 0x9E37_79B9_7F4A_7C15u64);
  Int::of_u64(rotr(b, 7) & 0xFFFFu64)
}

fn narrow(n: Int) -> Int / {abort.raise} =
  Int::of_u32(rotr(wrap_mul(U32::of_int(n), 2654435761u32), 7))

test "wide and narrow fixed-width integer functions return correct results, and a value outside the width raises" {
  assert_eq(wide(0), 0);
  assert_eq(wide(1), 10736);
  assert_eq(wide(12345), 26178);
  assert_eq(wide(1 << 40), 0);
  assert_eq(narrow(0), 0);
  assert_eq(narrow(1), 1664904947);
  assert_eq(narrow(12345), 3544340112);
  assert(raises(|| wide(-7)));
  assert(raises(|| narrow(1 << 40)));
  assert(raises(|| narrow(-7)))
}

fn raises(f: () -> Int / {abort.raise}) -> Bool =
  match try[abort.raise] { f() } { Err(_) -> true, Ok(_) -> false }
