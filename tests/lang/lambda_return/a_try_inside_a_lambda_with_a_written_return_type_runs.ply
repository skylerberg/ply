fn parse_all(xs: List<Result<Int, String>>) -> Result<Int, String> = {
  let bump = |r: Result<Int, String>| -> Result<Int, String> { Ok(r? + 1) };
  xs.fold(
    Ok(0),
    |accumulator: Result<Int, String>, r: Result<Int, String>| -> Result<Int, String> {
      Ok(accumulator? + bump(r)?)
    },
  )
}

test "`parse_all` returns `Ok` with the combined value when every element is `Ok`" {
  assert_eq(parse_all([Ok(1), Ok(2)]), Ok(5))
}

test "`parse_all` returns the first `Err` and skips the rest of the list" {
  assert_eq(parse_all([Ok(1), Err("no"), Ok(3)]), Err("no"))
}
