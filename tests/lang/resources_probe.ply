effect log {
  write note(s: String) -> Unit
}

opaque type Connection = | Connection(String)

release for Connection by close

fn close(c: keep Connection) -> Unit / {log.write} =
  match c { Connection(name) -> log.note("close " ++ name) }

fn open(name: String) -> Connection / {log.write} = {
  log.note("open " ++ name);
  Connection(name)
}

fn send(c: Connection, m: String) -> Int / {log.write} =
  match c {
    Connection(name) -> {
      log.note(name ++ " " ++ m);
      m.len()
    },
  }

fn note_and_return(c: keep Connection, n: Int) -> Int / {log.write} =
  match c {
    Connection(name) -> {
      log.note("took " ++ name);
      n
    },
  }

fn collect_log<a | e>(body: () -> a / {log.write | e}) -> List<String> / e =
  handle {
    body()
  } with {
    var seen = [],
    log.note(s) -> {
      seen = seen.push(s);
    },
    return u -> seen,
  }

opaque type Fragile = | Fragile(String)

release for Fragile by shut

fn shut(x: keep Fragile) -> Unit / {log.write, abort.raise} =
  match x {
    Fragile(name) -> {
      log.note("shut " ++ name);
      if name == "b" { abort.raise("shut failed") }
    },
  }

fn fragile(name: String) -> Fragile / {log.write} = {
  log.note("open " ++ name);
  Fragile(name)
}

type Either = | L(Connection) | R(Connection)

fn either(left: Bool) -> Either / {log.write} = if left { L(open("l")) } else { R(open("r")) }

test "a raise closes the resources opened in its block, in reverse order of opening" {
  let seen = collect_log(|| {
    let returned = handle {
      let a = open("a");
      let b = open("b");
      abort.raise("gone");
      send(a, "x") + send(b, "y")
    } with {
      abort.raise(m) -> 0,
    };
    log.note("answered")
  });
  assert_eq(seen, ["open a", "open b", "close b", "close a", "answered"])
}

test "when a release fails, the remaining resources are still closed in reverse order of opening" {
  let seen = collect_log(|| {
    handle {
      let a = fragile("a");
      let c = fragile("c");
      let b = fragile("b");
      log.note("last")
    } with {
      abort.raise(m) -> log.note("caught " ++ m),
    }
  });
  assert_eq(seen, [
    "open a",
    "open c",
    "open b",
    "shut b",
    "shut c",
    "shut a",
    "caught shut failed",
  ])
}

test "a `let ... else` whose pattern does not match closes the value that failed to match" {
  let run = |left: Bool|
    collect_log(|| {
      let n = {
        let L(c) = either(left) else { 0 };
        send(c, "x")
      };
      log.note("end")
    });
  assert_eq(run(true), ["open l", "l x", "close l", "end"]);
  assert_eq(run(false), ["open r", "close r", "end"])
}

fn updated(fail: Bool) -> Int / {log.write, abort.raise} = {
  let h = { conn: open("a"), n: 1 };
  let r = { ..h, n: if fail { abort.raise("no") } else { 2 } };
  send(r.conn, "hi") + r.n
}

test "a record update whose new field value fails closes the record being updated" {
  let caught = |body: () -> Int / {log.write, abort.raise}|
    collect_log(|| {
      let n = handle { body() } with { abort.raise(m) -> 0 };
      log.note("answered")
    });
  assert_eq(caught(|| updated(true)), ["open a", "close a", "answered"]);
  assert_eq(caught(|| updated(false)), ["open a", "a hi", "close a", "answered"])
}

test "a raise handled by a `handle` in one argument does not close a resource already passed in another argument" {
  let seen = collect_log(|| {
    let n = note_and_return(open("x"), handle {
      abort.raise("no");
      1
    } with {
      abort.raise(m) -> 2,
    });
    assert_eq(n, 2)
  });
  assert_eq(seen, ["open x", "took x"])
}

test "a binding shadowed by a later binding is closed before a last expression that uses only the later binding" {
  let seen = collect_log(|| {
    let n = {
      let c = open("a");
      let c = open("b");
      send(c, "x")
    };
    log.note("end")
  });
  assert_eq(seen, ["open a", "open b", "close a", "b x", "close b", "end"])
}
