//! A record is the same value wherever it is held: handed to and answered by a call, narrow or wider
//! than a call's registers, held in place in another record or in a sum's case, stored in a list or a
//! map and read back, captured by a closure, joined by a branch, updated, compared, handed to a
//! generic definition, and holding fields of no words. Each run lets go of all it made.

type Point = { x: Float, y: Float }

type Segment = { from: Point, label: String, to: Point }

type Wide = { a: Int, b: Int, c: Int, d: Int, e: Int, f: String }

type Noted = { at: Int, note: Option<String>, unit: Unit, tag: Shade }

type Shade = | Light | Dark

type Shape = | Dot(Point) | Line(Segment) | Empty

fn mid(p: Point, q: Point) -> Point = { x: (p.x + q.x) / 2.0, y: (p.y + q.y) / 2.0 }

fn length_x(s: Segment) -> Float = s.to.x - s.from.x

fn relabelled(s: Segment, label: String) -> Segment = { ..s, label: label }

fn widened(w: Wide, by: Int) -> Wide = { ..w, a: w.a + by, e: w.e + by }

fn total(w: Wide) -> Int = w.a + w.b + w.c + w.d + w.e + w.f.len()

fn kept<a>(x: a) -> List<a> = [x, x]

fn picked(c: Bool, s: Segment, t: Segment) -> Segment = if c { s } else { t }

fn start_of(sh: Shape) -> Float = match sh { Dot(p) -> p.x, Line(s) -> s.from.x, Empty -> 0.0 }

test "a record crosses calls as its fields, a record it holds in place among them" {
  let m = metered(|| {
    let s = { from: { x: 1.0, y: 2.0 }, label: "a" ++ Int::to_string(1), to: { x: 5.0, y: 6.0 } };
    let r = relabelled(s, "b" ++ Int::to_string(2));
    let c = mid(r.from, r.to);
    if length_x(r) == 4.0 && c.x == 3.0 && c.y == 4.0 && r.label == "b2" { 1 } else { 0 }
  });
  assert_eq(m.value, 1);
  assert_eq(m.live, 0)
}

test "a record wider than a call's registers crosses by reference and comes back whole" {
  let m = metered(|| {
    let w = { a: 1, b: 2, c: 3, d: 4, e: 5, f: "six" ++ Int::to_string(6) };
    let v = widened(widened(w, 10), 100);
    if total(v) == 1 + 2 + 3 + 4 + 5 + 220 + 4 && v.f == "six6" { 1 } else { 0 }
  });
  assert_eq(m.value, 1);
  assert_eq(m.live, 0)
}

test "a record stored in a list or a map is read back as it was stored" {
  let m = metered(|| {
    let s = { from: { x: 1.0, y: 2.0 }, label: "l" ++ Int::to_string(3), to: { x: 3.0, y: 4.0 } };
    let xs = kept(s).push(relabelled(s, "m"));
    let byname = Map::new().insert("s", s).insert("t", relabelled(s, "t"));
    let first = match xs.at(0) { Some(x) -> x.label, None -> "" };
    let last = match xs.at(2) { Some(x) -> x.label, None -> "" };
    let t = match byname.get("t") { Some(x) -> x.to.y, None -> 0.0 };
    if first == "l3" && last == "m" && t == 4.0 && xs.len() == 3 { 1 } else { 0 }
  });
  assert_eq(m.value, 1);
  assert_eq(m.live, 0)
}

test "a record captured by a closure, joined by a branch, and compared field by field" {
  let m = metered(|| {
    let s = { from: { x: 0.0, y: 0.0 }, label: "s" ++ Int::to_string(1), to: { x: 2.0, y: 0.0 } };
    let t = relabelled(s, "t");
    let longer = |by: Float| length_x(s) + by;
    let j = picked(longer(1.0) > 2.0, s, t);
    if j == s && j != t && longer(0.5) == 2.5 { 1 } else { 0 }
  });
  assert_eq(m.value, 1);
  assert_eq(m.live, 0)
}

test "a record holding a sum, a unit and an enum keeps each field where it lies" {
  let m = metered(|| {
    let n = { at: 7, note: Some("n" ++ Int::to_string(7)), unit: (), tag: Dark };
    let cleared = { ..n, note: None, tag: Light };
    let noted = match n.note { Some(s) -> s.len(), None -> 0 };
    let none = match cleared.note { Some(_) -> 1, None -> 0 };
    if noted == 2 && none == 0 && n.tag == Dark && cleared.tag == Light && cleared.at == 7 { 1 }
    else { 0 }
  });
  assert_eq(m.value, 1);
  assert_eq(m.live, 0)
}

test "a record a sum's case holds is read where the case lays it" {
  let m = metered(|| {
    let s = { from: { x: 9.0, y: 1.0 }, label: "q" ++ Int::to_string(2), to: { x: 1.0, y: 1.0 } };
    let shapes = [Dot({ x: 4.0, y: 2.0 }), Line(s), Empty];
    let starts = shapes.map(start_of);
    if starts == [4.0, 9.0, 0.0] { 1 } else { 0 }
  });
  assert_eq(m.value, 1);
  assert_eq(m.live, 0)
}
