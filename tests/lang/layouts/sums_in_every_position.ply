type Color = | Red | Green | Blue

type Token = | Token

type Many =
  | M0(String)
  | M1(String)
  | M2(String)
  | M3(String)
  | M4(String)
  | M5(String)
  | M6(String)
  | M7(String)
  | M8(String)
  | M9(String)

type Tree = | Leaf | Node(Tree, Int, Tree)

type Wide = | Narrow(Int) | Broad(Int, Int, Int, Int, String)

type Holder = { o: Option<Int>, r: Result<String, Int>, c: Color, t: Token }

fn label(m: Many) -> String =
  match m {
    M0(s) -> s,
    M1(s) -> s,
    M2(s) -> s,
    M3(s) -> s,
    M4(s) -> s,
    M5(s) -> s,
    M6(s) -> s,
    M7(s) -> s,
    M8(s) -> s ++ "!",
    M9(s) -> s ++ "?",
  }

fn inserted(t: Tree, n: Int) -> Tree =
  match t {
    Leaf -> Node(Leaf, n, Leaf),
    Node(l, v, r) -> if n < v { Node(inserted(l, n), v, r) } else { Node(l, v, inserted(r, n)) },
  }

fn in_order(t: Tree) -> List<Int> =
  match t { Leaf -> [], Node(l, v, r) -> in_order(l).push(v).concat(in_order(r)) }

fn sized(w: Wide) -> Int =
  match w { Narrow(n) -> n, Broad(a, b, c, d, s) -> a + b + c + d + s.len() }

fn grown(w: Wide) -> Wide =
  match w { Narrow(n) -> Broad(n, n, n, n, "w"), Broad(a, b, c, d, s) -> Broad(a + 1, b, c, d, s) }

fn twice<a>(x: a) -> List<a> = [x, x]

fn failed() -> Result<Int, String> = Err("bad")

fn record_of_sums(s: String) -> Holder = { o: Some(3), r: Ok(s), c: Blue, t: Token }

fn checked(n: Int) -> Result<Unit, String> =
  if n > 0 { Ok(()) } else { Err("neg" ++ Int::to_string(n)) }

fn both(a: Int, b: Int) -> Result<Unit, String> = {
  checked(a)?;
  checked(b)
}

fn first_or<a>(o: Option<a>, d: a) -> a = match o { Some(x) -> x, None -> d }

test "an `Option` of a pointer, a scalar, a record or another `Option` can be passed to calls and matched" {
  let m = {
    let s = Some("s" ++ Int::to_string(1));
    let n = Some(42);
    let r = Some({ x: 1.5, name: "r" ++ Int::to_string(2) });
    let o = Some(Some("o" ++ Int::to_string(3)));
    let inner = match o { Some(Some(x)) -> x, Some(None) -> "", None -> "" };
    let named = match r { Some(x) -> x.name, None -> "" };
    if first_or(s, "") == "s1" && first_or(n, 0) == 42 && named == "r2" && inner == "o3"
        && first_or(None, 7) == 7 { 1 }
    else { 0 }
  };
  assert_eq(m, 1)
}

test "a `Result`, an enum and a one-case sum type stored as record fields can be updated, merged where two branches meet, and compared" {
  let m = {
    let h = record_of_sums("ok" ++ Int::to_string(1));
    let e = { ..h, r: Err(9), c: Red };
    let c = if h.c == Blue { Green } else { Red };
    let error_code = match e.r { Ok(_) -> 0, Err(n) -> n };
    if h != e && c == Green && error_code == 9 && h.t == Token && e.o == Some(3) { 1 } else { 0 }
  };
  assert_eq(m, 1)
}

test "a sum of more than eight cases with data distinguishes each case" {
  let m = {
    let ms = [M0("a"), M3("d"), M7("h"), M8("i"), M9("j")];
    let labels = ms.map(label);
    if labels == ["a", "d", "h", "i!", "j?"] && M8("x") != M9("x") { 1 } else { 0 }
  };
  assert_eq(m, 1)
}

test "a recursive sum's cases are boxed and walked" {
  let m = {
    let t = [5, 2, 8, 1, 9, 3].fold(Leaf, |accumulator: Tree, n: Int| inserted(accumulator, n));
    if in_order(t) == [1, 2, 3, 5, 8, 9] { 1 } else { 0 }
  };
  assert_eq(m, 1)
}

test "a sum too wide for a call's registers is passed by reference, stored in a list and a map, and read back intact" {
  let m = {
    let w = grown(grown(Narrow(2)));
    let ws = twice(w).push(Narrow(1));
    let byname = Map::new().insert("w", w);
    let back = match byname.get("w") { Some(x) -> sized(x), None -> 0 };
    if sized(w) == 3 + 2 + 2 + 2 + 1 && back == sized(w) && ws.map(sized) == [10, 10, 1] { 1 }
    else { 0 }
  };
  assert_eq(m, 1)
}

test "a closure that captures a sum reads its value correctly when the closure is called" {
  let m = {
    let o = Some("c" ++ Int::to_string(5));
    let r = failed();
    let read = |d: String| first_or(o, d).len() + (match r { Ok(n) -> n, Err(s) -> s.len() });
    if read("") == 5 { 1 } else { 0 }
  };
  assert_eq(m, 1)
}

test "`Ok(())` and a unit `Result` propagated with `?` stay `Ok` or `Err` as they were" {
  let m = {
    let fine = match both(1, 2) { Ok(()) -> 1, Err(_) -> 0 };
    let bad = match both(1, 0 - 3) { Ok(_) -> "", Err(s) -> s };
    if fine == 1 && bad == "neg-3" { 1 } else { 0 }
  };
  assert_eq(m, 1)
}
