fn even(n: Int) -> Bool = if n <= 0 { true } else { odd(n - 1) }

fn odd(n: Int) -> Bool = if n <= 0 { false } else { even(n - 1) }

fn parity(n: Int) -> Bool = even(n)

// Ten million steps: a tail call between members of a group is a jump.
test "a tail call between members of a recursive group is a jump" {
  assert_eq(even(10000000), true);
  assert_eq(even(10000001), false);
  assert_eq(odd(10000001), true);
  assert_eq(parity(7), false)
}

fn countdown(n: Int, k: Int) -> Int = if k <= 0 { n } else { countdown(n, k - 1) }

fn flip(b: Bool, k: Int) -> Bool = if k <= 0 { b } else { flip(b, k - 1) }

fn narrow(w: U32, k: Int) -> U32 = if k <= 0 { w } else { narrow(w, k - 1) }

// 2^62 is the first `Int` no immediate holds: a boxed parameter released on every restart would be
// read after it was freed.
test "a self tail call keeps a parameter it converted on entry, however often it restarts" {
  assert_eq(countdown(4611686018427387904, 1), 4611686018427387904);
  assert_eq(countdown(4611686018427387904, 1000), 4611686018427387904);
  assert_eq(flip(true, 1000), true);
  assert_eq(narrow(7u32, 1000), 7u32)
}

fn a(n: Int) -> Int / {clock.now, diverges} =
  if n == 0 { 0 }
  else if n == 1 { handle { b(0) } with { clock.now() -> Instant(7) } }
  else { b(n - 1) }

fn b(n: Int) -> Int / {clock.now, diverges} =
  if n == 0 { match clock.now() { Instant(t) -> t } } else { a(n - 1) }

// The outer clock is never read: the handle on the way answers the one `b(0)` reaches.
test "a recursive pair whose member holds a handle answers through it" {
  handle { assert_eq(a(5), 7) } with { clock.now() -> Instant(0) }
}
