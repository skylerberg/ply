fn ladder(n: Int) -> Int = if n <= 0 { 0 } else { 1 + ladder(n - 1) }

fn ping(n: Int) -> Int = if n <= 0 { 0 } else { 1 + pong(n - 1) }

fn pong(n: Int) -> Int = if n <= 0 { 0 } else { 1 + ping(n - 1) }

test "a call nests two hundred thousand deep" { assert_eq(ladder(200000), 200000) }

test "calls between two definitions nest two hundred thousand deep" {
  assert_eq(ping(200000), 200000)
}
