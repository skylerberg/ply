// A call of the enclosing function in tail position does not nest, so a million steps fit.

fn sum_to(n: Int, acc: Int) -> Int = if n <= 0 { acc } else { sum_to(n - 1, acc + n) }

fn last(xs: List<Int>, i: Int, seen: Option<Int>) -> Option<Int> =
  match list_at(xs, i) {
    None -> seen,
    Some(x) -> last(xs, i + 1, Some(x)),
  }

fn all_below(xs: List<Int>, bound: Int, i: Int) -> Bool =
  i >= len(xs) || (match list_at(xs, i) { Some(x) -> x < bound, None -> true } && all_below(xs, bound, i + 1))

fn any_at_least(xs: List<Int>, bound: Int, i: Int) -> Bool =
  i < len(xs) && (match list_at(xs, i) { Some(x) -> x >= bound, None -> false } || any_at_least(xs, bound, i + 1))

fn collect(n: Int, acc: List<Int>) -> List<Int> = {
  let next = push(acc, n);
  if n <= 0 { next } else { collect(n - 1, next) }
}

fn digit(o: Option<Int>) -> Result<Int, String> =
  match o { Some(d) -> if d >= 0 && d <= 9 { Ok(d) } else { Err("not a digit") }, None -> Err("past the end") }

fn digit_sum(xs: List<Int>, i: Int, acc: Int) -> Result<Int, String> =
  if i >= len(xs) { Ok(acc) } else {
    let d = digit(list_at(xs, i))?;
    digit_sum(xs, i + 1, acc + d)
  }

fn countdown(pair: {left: Int, seen: Int}) -> Int =
  match pair {
    {left, seen} if left <= 0 -> seen,
    {left, seen} -> countdown({left: left - 1, seen: seen + 1}),
  }

test "a million steps through an if" { assert_eq(sum_to(1000000, 0), 500000500000) }

test "through match arms" { assert_eq(last(range(0, 50000), 0, None), Some(49999)) }

test "through the right of && and ||" {
  assert(all_below(range(0, 50000), 50000, 0));
  assert(!all_below(range(0, 50000), 49999, 0));
  assert(any_at_least(range(0, 50000), 49999, 0));
  assert(!any_at_least(range(0, 50000), 50000, 0))
}

test "after a let in a block" { assert_eq(len(collect(100000, [])), 100001) }

test "through ?" {
  assert_eq(digit_sum(map(range(0, 30000), |i: Int| i % 10), 0, 0), Ok(135000));
  assert_eq(digit_sum([1, 2, 12, 3], 0, 0), Err("not a digit"))
}

test "through a guarded record pattern" { assert_eq(countdown({left: 200000, seen: 0}), 200000) }
