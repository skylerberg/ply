fn sum_to(n: Int, accumulator: Int) -> Int =
  if n <= 0 { accumulator } else { sum_to(n - 1, accumulator + n) }

fn last(xs: List<Int>, i: Int, seen: Option<Int>) -> Option<Int> =
  match xs.at(i) { None -> seen, Some(x) -> last(xs, i + 1, Some(x)) }

fn all_below(xs: List<Int>, bound: Int, i: Int) -> Bool =
  i >= xs.len()
    || ((match xs.at(i) { Some(x) -> x < bound, None -> true }) && all_below(xs, bound, i + 1))

fn any_at_least(xs: List<Int>, bound: Int, i: Int) -> Bool =
  i < xs.len()
    && ((match xs.at(i) { Some(x) -> x >= bound, None -> false }) || any_at_least(xs, bound, i + 1))

fn collect(n: Int, accumulator: List<Int>) -> List<Int> = {
  let next = accumulator.push(n);
  if n <= 0 { next } else { collect(n - 1, next) }
}

fn digit(o: Option<Int>) -> Result<Int, String> =
  match o {
    Some(d) -> if d >= 0 && d <= 9 { Ok(d) } else { Err("not a digit") },
    None -> Err("past the end"),
  }

fn digit_sum(xs: List<Int>, i: Int, accumulator: Int) -> Result<Int, String> =
  if i >= xs.len() { Ok(accumulator) } else {
    let d = digit(xs.at(i))?;
    digit_sum(xs, i + 1, accumulator + d)
  }

fn countdown(pair: { left: Int, seen: Int }) -> Int =
  match pair {
    { left, seen } if left <= 0 -> seen,
    { left, seen } -> countdown({ left: left - 1, seen: seen + 1 }),
  }

test "a self call in tail position inside an `if` runs a million steps" {
  assert_eq(sum_to(1000000, 0), 500000500000)
}

test "a self call in tail position inside `match` arms runs fifty thousand steps" {
  assert_eq(last(range(0, 50000), 0, None), Some(49999))
}

test "a self call as the right operand of `&&` and `||` runs fifty thousand steps" {
  assert(all_below(range(0, 50000), 50000, 0));
  assert(!all_below(range(0, 50000), 49999, 0));
  assert(any_at_least(range(0, 50000), 49999, 0));
  assert(!any_at_least(range(0, 50000), 50000, 0))
}

test "a self call after a `let` in a block runs a hundred thousand steps" {
  assert_eq(collect(100000, []).len(), 100001)
}

test "a self call whose result goes through the `?` operator runs thirty thousand steps" {
  assert_eq(digit_sum(range(0, 30000).map(|i: Int| i % 10), 0, 0), Ok(135000));
  assert_eq(digit_sum([1, 2, 12, 3], 0, 0), Err("not a digit"))
}

test "a self call inside a guarded record pattern runs two hundred thousand steps" {
  assert_eq(countdown({ left: 200000, seen: 0 }), 200000)
}
