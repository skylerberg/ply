//! A value built by iteration is as deep as no recursion that built it stood, and comparing it
//! nests a call a level: it compares all the same.

type Chain = | Nil | Link(Chain)

fn stack(n: Int) -> Chain = range(0, n).fold(Nil, |acc, x| Link(acc))

test "two chains a hundred thousand deep compare equal" { assert_eq(stack(100000), stack(100000)) }

test "and one link apart they differ" { assert(stack(100000) != stack(100001)) }
