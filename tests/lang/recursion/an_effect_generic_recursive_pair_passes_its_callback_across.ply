fn ping<| e>(n: Int, f: (Int) -> Int / e, acc: Int) -> Int / e =
  if n <= 0 { acc } else { pong(n - 1, f, f(acc)) }

fn pong<| t>(n: Int, f: (Int) -> Int / t, acc: Int) -> Int / t =
  if n <= 0 { acc } else { ping(n - 1, f, acc + 1) }

fn doubled_ping(n: Int) -> Int = ping(n, |x: Int| x * 2, 1)

test "an effect-generic recursive pair passes its callback across the cycle" {
  assert_eq(doubled_ping(4), 7);
  assert_eq(doubled_ping(0), 1)
}
