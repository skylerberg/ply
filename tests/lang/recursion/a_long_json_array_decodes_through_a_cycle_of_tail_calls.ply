import std.json (parse, Array)

fn long_array(n: Int) -> Bytes =
  Bytes::concat_all([b"[", Bytes::concat_all(range(0, n).map(|_i: Int| b"7,")), b"7]"])

test "an array of a hundred thousand items decodes" {
  assert_eq(match parse(long_array(100_000)) { Ok(Array(items)) -> items.len(), _ -> -1 }, 100_001)
}
