//! Generic definitions calling each other in tail position jump at every type they are called at,
//! so a million steps fit however the calls hand their type parameters round.

fn even_at<a>(x: a, n: Int) -> a = if n <= 0 { x } else { odd_at(x, n - 1) }

fn odd_at<a>(x: a, n: Int) -> a = if n <= 0 { x } else { even_at(x, n - 1) }

fn first_of<a, b>(x: a, y: b, n: Int) -> b = if n <= 0 { y } else { second_of(y, x, n - 1) }

fn second_of<a, b>(x: a, y: b, n: Int) -> a = if n <= 0 { x } else { first_of(y, x, n - 1) }

fn turns<a, b>(x: a, y: b, n: Int, k: Int) -> Int =
  if n <= 0 { k } else { turns(y, x, n - 1, k + 1) }

test "a generic pair runs a million steps at each type it is called at" {
  assert_eq(even_at(1.5, 1000000), 1.5);
  assert_eq(odd_at("s", 1000001), "s")
}

test "a pair that hands its type parameters round swapped runs a million steps" {
  assert_eq(first_of(1.5, "s", 1000000), "s");
  assert_eq(second_of(7, true, 1000001), 7)
}

test "a definition calling itself with its type parameters swapped runs a million steps" {
  assert_eq(turns(1.5, "s", 1000000, 0), 1000000)
}
