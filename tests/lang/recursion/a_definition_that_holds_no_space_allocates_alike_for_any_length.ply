//! A definition whose `space` bound is `0` runs in place: handed values nothing else holds, it
//! allocates as much for a long input as for a short one, past what made the input.

type Chain = | Link(Int, Chain) | End

/// `n` links, counting down to the end.
fn chain(n: Int) -> Chain = fold(range(0, n), End, |c: Chain, i: Int| Link(i, c))

fn first(xs: Chain) -> Int = match xs { Link(x, _) -> x, End -> -1 }

fn reversed(xs: Chain, onto: Chain) -> Chain
  space 0
= match xs { End -> onto, Link(x, rest) -> reversed(rest, Link(x, onto)) }

fn filled(a: Array<Int>, i: Int, n: Int) -> Array<Int> / {abort.raise}
  space 0
= if i >= n { a } else { filled(array_set(a, i, i), i + 1, n) }

/// What reversing a chain of `n` links allocates past making it.
fn reversing(n: Int) -> Int =
  metered(|| first(reversed(chain(n), End))).allocations - metered(|| first(chain(n))).allocations

/// What filling an array of `n` cells allocates past making it.
fn filling(n: Int) -> Int / {abort.raise} =
  metered(|| array_get(filled(array_new(n, 0), 0, n), n - 1)).allocations
    - metered(|| array_get(array_new(n, 0), n - 1)).allocations

test "reversing a chain nothing else holds allocates alike for ten links and a thousand" {
  assert_eq(first(reversed(chain(3), End)), 0);
  assert_eq(reversing(1000), reversing(10))
}

test "filling an array nothing else holds allocates alike for ten cells and a thousand" {
  assert_eq(array_get(filled(array_new(4, 0), 0, 4), 3), 3);
  assert_eq(filling(1000), filling(10))
}
