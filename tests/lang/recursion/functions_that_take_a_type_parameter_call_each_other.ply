fn even_len<a>(xs: List<a>) -> Bool = match xs { [] -> true, [_, ..rest] -> odd_len(rest) }

fn odd_len<a>(xs: List<a>) -> Bool = match xs { [] -> false, [_, ..rest] -> even_len(rest) }

fn first_after<a, b>(x: a, y: b, n: Int) -> a = if n <= 0 { x } else { second_after(y, x, n - 1) }

fn second_after<a, b>(x: a, y: b, n: Int) -> b = if n <= 0 { y } else { first_after(y, x, n - 1) }

fn counted<a>(xs: List<a>, n: Int) -> Int = if n <= 0 { xs.len() } else { recount(xs, n, n - 1) }

fn recount<a, b>(xs: List<a>, y: b, n: Int) -> Int = counted(xs, n)

fn ping<a>(x: a, n: Int) -> Int = if n <= 0 { 0 } else { pong(n - 1) }

fn pong(n: Int) -> Int = 1 + ping(n, n)

fn doubled<a>(x: a, n: Int) -> a
  where numeric(a)
= if n <= 0 { x } else { stepped(x + x, n - 1) }

fn stepped<a>(x: a, n: Int) -> a
  where numeric(a)
= if n <= 0 { x } else { doubled(x + numeric_of_int(1), n - 1) }

fn turned<a, b>(x: a, y: b, n: Int) -> (a, b) =
  if n <= 0 { (x, y) } else { match turned(y, x, n - 1) { (q, p) -> (p, q) } }

fn lands_on_seven<a, b>(x: a, y: b, n: Int) -> Bool
  where numeric(a), numeric(b)
= if n <= 0 { x == numeric_of_int(7) } else { lands_on_seven(y, x, n - 1) }

test "two functions over one element type call each other" {
  assert(even_len([1, 2, 3, 4]));
  assert(odd_len(["a", "b", "c"]));
  assert(!even_len([true]))
}

test "a call inside a group of generic functions passes the caller's type parameters to the callee in a different order" {
  assert_eq(first_after("x", 7, 0), "x");
  assert_eq(first_after("x", 7, 1), "x");
  assert_eq(first_after("x", 7, 2), "x");
  assert_eq(second_after("x", 7, 1), 7);
  assert_eq(second_after("x", 7, 2), 7)
}

test "members of a group take different numbers of type parameters, and one member is called with a type that has none" {
  assert_eq(counted(["a", "b"], 3), 2);
  assert_eq(ping("a", 3), 3)
}

test "a definition calls itself with its parameters the other way round" {
  assert_eq(turned(1.5, 7, 3), (1.5, 7));
  assert_eq(turned("s", 2.5, 2), ("s", 2.5));
  assert(lands_on_seven(1.5, 7, 1));
  assert(!lands_on_seven(1.5, 7, 2));
  assert(lands_on_seven(7, 1.5, 4))
}

test "a constraint's hidden argument is passed round the cycle" {
  assert_eq(doubled(1, 2), 3);
  assert_eq(doubled(1.5, 2), 4.0);
  assert_eq(stepped(2u8, 1), 3u8)
}
