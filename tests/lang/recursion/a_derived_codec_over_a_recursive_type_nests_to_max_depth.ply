import std.bin
import std.json

type Tree = | Leaf | Node(Tree, Int, Tree)
type Expression = | Number(Int) | Block(List<Statement>)
type Statement = | Bare(Expression) | Let({ name: String, value: Expression })
type Rose<a> = | Tip | Branch(Rose<a>, a, List<Rose<a>>)
type Pair<a> = { left: a, right: a }
type Twig = | Bud | Fork(Pair<Twig>)
type Vine<a> = | End | Split(Pair<Vine<a>>, a)
type Shrub<a> = | Bald | Stem(a, Hedge<a>)
type Hedge<a> = | Reason | Row(Shrub<a>, Hedge<a>)
type Keyed<k, v> = | Empty | Entry(k, v, Flipped<k, v>)
type Flipped<k, v> = | Turn(Keyed<v, k>) | Stop

derive json for Tree
derive bin for Tree
derive json for Expression
derive json for Statement
derive bin for Expression
derive bin for Statement
derive json for Rose
derive bin for Rose
derive json for Pair
derive bin for Pair
derive json for Twig
derive bin for Twig
derive json for Vine
derive bin for Vine
derive json for Shrub
derive json for Hedge
derive bin for Shrub
derive bin for Hedge
derive json for Keyed
derive json for Flipped
derive bin for Keyed
derive bin for Flipped

fn nested_node_json(n: Int, accumulator: json::Json) -> json::Json / {abort.raise} =
  if n <= 0 { accumulator } else {
    nested_node_json(
      n - 1,
      json::variant("Node", [accumulator, json::int_json().encode(n), json::variant("Leaf", [])]),
    )
  }

fn rejection(j: json::Json) -> String / {abort.raise} =
  match tree_json().decode(j) { Ok(_) -> "", Err(e) -> e.message }

test "a recursive type and two types that refer to each other round-trip through both codecs" {
  let t = Node(Node(Leaf, 1, Leaf), 2, Node(Leaf, 3, Leaf));
  assert_eq(json::decode_string(json::encode_string(t, tree_json()), tree_json()), Ok(t));
  assert_eq(bin::decode(bin::encode(t, tree_bin()), tree_bin()), Ok(t));
  let e = Block([Bare(Number(1)), Let({ name: "x", value: Block([]) })]);
  assert_eq(
    json::decode_string(json::encode_string(e, expression_json()), expression_json()),
    Ok(e),
  );
  assert_eq(bin::decode(bin::encode(e, expression_bin()), expression_bin()), Ok(e))
}

test "a recursive type that takes a parameter round-trips, and its bytes are its fields in order" {
  let r = Branch(Branch(Tip, "a", []), "b", [Branch(Tip, "c", [Tip]), Tip]);
  let j = rose_json(json::string_json());
  assert_eq(json::decode_string(json::encode_string(r, j), j), Ok(r));
  let b = rose_bin(bin::string_bin());
  assert_eq(bin::encode(r, b), b"\x01\x01\x00\x01a\x00\x01b\x02\x01\x00\x01c\x01\x00\x00");
  assert_eq(bin::decode(bin::encode(r, b), b), Ok(r))
}

test "a type that contains itself inside a record field round-trips through JSON and binary codecs, with and without a type parameter" {
  let t = Fork({ left: Fork({ left: Bud, right: Bud }), right: Bud });
  assert_eq(json::decode_string(json::encode_string(t, twig_json()), twig_json()), Ok(t));
  assert_eq(bin::encode(t, twig_bin()), b"\x01\x01\x00\x00\x00");
  assert_eq(bin::decode(bin::encode(t, twig_bin()), twig_bin()), Ok(t));
  let v = Split({ left: Split({ left: End, right: End }, "a"), right: End }, "b");
  let j = vine_json(json::string_json());
  assert_eq(json::decode_string(json::encode_string(v, j), j), Ok(v));
  let b = vine_bin(bin::string_bin());
  assert_eq(bin::encode(v, b), b"\x01\x01\x00\x00\x01a\x00\x01b");
  assert_eq(bin::decode(bin::encode(v, b), b), Ok(v))
}

test "two types that take a parameter and recur through each other round-trip through both codecs" {
  let s = Stem("a", Row(Stem("b", Reason), Row(Bald, Reason)));
  let j = shrub_json(json::string_json());
  assert_eq(json::decode_string(json::encode_string(s, j), j), Ok(s));
  let b = shrub_bin(bin::string_bin());
  assert_eq(bin::encode(s, b), b"\x01\x01a\x01\x01\x01b\x00\x01\x00\x00");
  assert_eq(bin::decode(bin::encode(s, b), b), Ok(s))
}

test "a cycle of types that pass their type parameters to each other in a different order round-trips through both codecs" {
  let k = Entry("a", 1, Turn(Entry(2, "b", Stop)));
  let j = keyed_json(json::string_json(), json::int_json());
  assert_eq(json::decode_string(json::encode_string(k, j), j), Ok(k));
  let b = keyed_bin(bin::string_bin(), bin::int_bin());
  assert_eq(bin::encode(k, b), b"\x01\x01a\x02\x00\x01\x04\x01b\x01");
  assert_eq(bin::decode(bin::encode(k, b), b), Ok(k))
}

test "a JSON value nested past max_depth levels of the type decodes to an error" {
  let leaf = json::variant("Leaf", []);
  assert_eq(rejection(nested_node_json(json::max_depth() - 1, leaf)), "");
  assert_eq(rejection(nested_node_json(json::max_depth(), leaf)), "nested deeper than 128 levels")
}
