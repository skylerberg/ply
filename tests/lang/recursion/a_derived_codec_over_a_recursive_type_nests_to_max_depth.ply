//! A derived codec over a recursive type nests at most its runtime's `max_depth` levels of it.

import std.bin
import std.json

type Tree = | Leaf | Node(Tree, Int, Tree)
type Expr = | Num(Int) | Block(List<Stmt>)
type Stmt = | Bare(Expr) | Let({ name: String, value: Expr })
type Rose<a> = | Tip | Branch(Rose<a>, a, List<Rose<a>>)
type Pair<a> = { left: a, right: a }
type Twig = | Bud | Fork(Pair<Twig>)
type Vine<a> = | End | Split(Pair<Vine<a>>, a)

derive json for Tree
derive bin for Tree
derive json for Expr
derive json for Stmt
derive bin for Expr
derive bin for Stmt
derive json for Rose
derive bin for Rose
derive json for Pair
derive bin for Pair
derive json for Twig
derive bin for Twig
derive json for Vine
derive bin for Vine

fn leaning(n: Int, acc: json::Json) -> json::Json / {abort.raise} =
  if n <= 0 { acc } else {
    leaning(
      n - 1,
      json::variant("Node", [acc, json::int_json().encode(n), json::variant("Leaf", [])]),
    )
  }

fn refusal(j: json::Json) -> String / {abort.raise} =
  match tree_json().decode(j) { Ok(_) -> "", Err(e) -> e.message }

test "a recursive type and two that recur through each other round-trip through both codecs" {
  let t = Node(Node(Leaf, 1, Leaf), 2, Node(Leaf, 3, Leaf));
  assert_eq(json::decode_string(json::encode_string(t, tree_json()), tree_json()), Ok(t));
  assert_eq(bin::decode(bin::encode(t, tree_bin()), tree_bin()), Ok(t));
  let e = Block([Bare(Num(1)), Let({ name: "x", value: Block([]) })]);
  assert_eq(json::decode_string(json::encode_string(e, expr_json()), expr_json()), Ok(e));
  assert_eq(bin::decode(bin::encode(e, expr_bin()), expr_bin()), Ok(e))
}

test "a recursive type that takes a parameter round-trips, and its bytes are its fields in order" {
  let r = Branch(Branch(Tip, "a", []), "b", [Branch(Tip, "c", [Tip]), Tip]);
  let j = rose_json(json::string_json());
  assert_eq(json::decode_string(json::encode_string(r, j), j), Ok(r));
  let b = rose_bin(bin::string_bin());
  assert_eq(bin::encode(r, b), b"\x01\x01\x00\x01a\x00\x01b\x02\x01\x00\x01c\x01\x00\x00");
  assert_eq(bin::decode(bin::encode(r, b), b), Ok(r))
}

test "a type that recurs through another type's codec round-trips, with a parameter and without" {
  let t = Fork({ left: Fork({ left: Bud, right: Bud }), right: Bud });
  assert_eq(json::decode_string(json::encode_string(t, twig_json()), twig_json()), Ok(t));
  assert_eq(bin::encode(t, twig_bin()), b"\x01\x01\x00\x00\x00");
  assert_eq(bin::decode(bin::encode(t, twig_bin()), twig_bin()), Ok(t));
  let v = Split({ left: Split({ left: End, right: End }, "a"), right: End }, "b");
  let j = vine_json(json::string_json());
  assert_eq(json::decode_string(json::encode_string(v, j), j), Ok(v));
  let b = vine_bin(bin::string_bin());
  assert_eq(bin::encode(v, b), b"\x01\x01\x00\x00\x01a\x00\x01b");
  assert_eq(bin::decode(bin::encode(v, b), b), Ok(v))
}

test "a JSON value nested past max_depth levels of the type decodes to an error" {
  let leaf = json::variant("Leaf", []);
  assert_eq(refusal(leaning(json::max_depth() - 1, leaf)), "");
  assert_eq(refusal(leaning(json::max_depth(), leaf)), "nested deeper than 128 levels")
}
