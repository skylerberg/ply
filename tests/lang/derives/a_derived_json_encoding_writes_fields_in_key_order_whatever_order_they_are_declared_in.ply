import std.json

type Declared = { x: Int, y: String }
type Reordered = { y: String, x: Int }

derive json for Declared
derive json for Reordered

test "two orders of the same fields encode a value alike" {
  assert_eq(json::encode_string({ x: 1, y: "hi" }, declared_json()), "{\"x\":1,\"y\":\"hi\"}");
  assert_eq(json::encode_string({ x: 1, y: "hi" }, reordered_json()), "{\"x\":1,\"y\":\"hi\"}")
}
