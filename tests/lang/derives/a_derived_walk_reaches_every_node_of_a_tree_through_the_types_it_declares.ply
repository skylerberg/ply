//! `derive children for T` from `std.derive.children`: the walks of a tree of `T`s, through the
//! records, lists, options and map values the module's own types hold.

import std.derive.children

type Expression<t> = { node: Node<t>, at: t }
type Node<t> =
  | Number(Int)
  | Add(Expression<t>, Expression<t>)
  | Call({ callee: Expression<t>, args: List<Expression<t>> })
  | Maybe(Option<Expression<t>>)
  | Block(List<Statement<t>>)
  | Named(Map<String, Expression<t>>)
type Statement<t> = | Let(String, Expression<t>) | Skip

derive children for Expression

fn leaf(n: Int) -> Expression<Int> = { node: Number(n), at: n }

fn branch(node: Node<Int>) -> Expression<Int> = { node: node, at: 0 }

fn sample() -> Expression<Int> =
  branch(
    Call({
      callee: leaf(1),
      args: [
        branch(Add(leaf(2), leaf(3))),
        branch(Maybe(Some(leaf(4)))),
        branch(Block([Let("x", leaf(5)), Skip])),
        branch(Named(#{"a": leaf(6)})),
      ],
    }),
  )

fn number(e: Expression<Int>) -> Int = match e.node { Number(n) -> n, _ -> 0 }

test "the children are the nodes directly inside, in the order the value holds them" {
  assert_eq(expression_children(sample()).map(number), [1, 0, 0, 0, 0]);
  assert_eq(expression_children(leaf(7)), [])
}

test "the nodes are every node, each before the nodes inside it, which a fold meets in turn" {
  assert_eq(expression_nodes(sample()).map(number), [0, 1, 0, 2, 3, 0, 4, 0, 5, 0, 6]);
  assert_eq(
    expression_nodes_folded(sample(), [], |acc: List<Int>, e: Expression<Int>| acc.push(number(e))),
    expression_nodes(sample()).map(number),
  )
}

test "a mapped walk rebuilds the nodes inside a node before the node, and keeps the rest" {
  let doubled = expression_nodes_mapped(sample(), |e: Expression<Int>|
    match e.node { Number(n) -> leaf(n * 2), _ -> e });
  assert_eq(expression_nodes(doubled).map(number), [0, 2, 0, 4, 6, 0, 8, 0, 10, 0, 12]);
  let once = expression_children_mapped(sample(), |e: Expression<Int>| leaf(number(e) + 100));
  assert_eq(expression_nodes(once).map(number), [0, 101, 100, 100, 100, 100])
}
