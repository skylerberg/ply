//! `derive children for T` from `std.derive.children`: the walks of a tree of `T`s, through the
//! records, lists, options and map values the module's own types hold.

import std.derive.children

type Expr<t> = { node: Node<t>, at: t }
type Node<t> =
  | Num(Int)
  | Add(Expr<t>, Expr<t>)
  | Call({ callee: Expr<t>, args: List<Expr<t>> })
  | Maybe(Option<Expr<t>>)
  | Block(List<Stmt<t>>)
  | Named(Map<String, Expr<t>>)
type Stmt<t> = | Let(String, Expr<t>) | Skip

derive children for Expr

fn leaf(n: Int) -> Expr<Int> = { node: Num(n), at: n }

fn branch(node: Node<Int>) -> Expr<Int> = { node: node, at: 0 }

fn sample() -> Expr<Int> =
  branch(
    Call({
      callee: leaf(1),
      args: [
        branch(Add(leaf(2), leaf(3))),
        branch(Maybe(Some(leaf(4)))),
        branch(Block([Let("x", leaf(5)), Skip])),
        branch(Named(#{"a": leaf(6)})),
      ],
    }),
  )

fn number(e: Expr<Int>) -> Int = match e.node { Num(n) -> n, _ -> 0 }

test "the children are the nodes directly inside, in the order the value holds them" {
  assert_eq(expr_children(sample()).map(number), [1, 0, 0, 0, 0]);
  assert_eq(expr_children(leaf(7)), [])
}

test "the nodes are every node, each before the nodes inside it, which a fold meets in turn" {
  assert_eq(expr_nodes(sample()).map(number), [0, 1, 0, 2, 3, 0, 4, 0, 5, 0, 6]);
  assert_eq(
    expr_nodes_folded(sample(), [], |acc: List<Int>, e: Expr<Int>| acc.push(number(e))),
    expr_nodes(sample()).map(number),
  )
}

test "a mapped walk rebuilds the nodes inside a node before the node, and keeps the rest" {
  let doubled = expr_nodes_mapped(sample(), |e: Expr<Int>|
    match e.node { Num(n) -> leaf(n * 2), _ -> e });
  assert_eq(expr_nodes(doubled).map(number), [0, 2, 0, 4, 6, 0, 8, 0, 10, 0, 12]);
  let once = expr_children_mapped(sample(), |e: Expr<Int>| leaf(number(e) + 100));
  assert_eq(expr_nodes(once).map(number), [0, 101, 100, 100, 100, 100])
}
