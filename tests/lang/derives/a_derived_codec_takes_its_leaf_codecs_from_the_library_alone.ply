import std.json
import std.json (Json, JsonCodec, Str, decode_error, to_string)

type Order = { id: Int, note: String }

derive json for Order

fn string_json() -> JsonCodec<String> =
  { encode: |s: String| Str("HIJACKED"), decode: |j: Json| Err(decode_error("no")) }

fn int_json() -> JsonCodec<Int> =
  { encode: |i: Int| Str("ALSO HIJACKED"), decode: |j: Json| Err(decode_error("no")) }

test "a derived codec writes the library's encoding of each field, whatever the module declares" {
  assert_eq(to_string(order_json().encode({ id: 1, note: "hi" })), "{\"id\":1,\"note\":\"hi\"}")
}
