import std.json

type Doc = { m: Map<String, Int>, n: Map<Int, List<String>> }
type Catalogue = { prices: Map<Decimal, String> }

derive json for Doc
derive json for Catalogue

fn build(ks: List<String>) -> Map<String, Int> =
  ks.fold(Map::new(), |accumulator: Map<String, Int>, k: String| accumulator.insert(k, k.len()))

fn nums(ks: List<Int>) -> Map<Int, List<String>> =
  ks.fold(Map::new(), |accumulator: Map<Int, List<String>>, k: Int|
    accumulator.insert(k, ["a", "b"]))

fn wire(ss: List<String>, ns: List<Int>) -> String / {abort.raise} =
  json::encode_string({ m: build(ss), n: nums(ns) }, doc_json())

test "a map encodes alike in whatever order its keys went in" {
  assert_eq(
    wire(["a", "bb", "ccc", "dddd"], [1, 2, 3]),
    wire(["dddd", "ccc", "bb", "a"], [3, 2, 1]),
  );
  assert_eq(
    wire(["a", "bb", "ccc", "dddd"], [1, 2, 3]),
    wire(["ccc", "a", "dddd", "bb"], [2, 3, 1]),
  );
  assert_eq(
    wire(["ccc", "a", "dddd", "bb"], [3, 1, 2]),
    "{\"m\":{\"a\":1,\"bb\":2,\"ccc\":3,\"dddd\":4},\"n\":[{\"key\":1,\"value\":[\"a\",\"b\"]},{\"key\":2,\"value\":[\"a\",\"b\"]},{\"key\":3,\"value\":[\"a\",\"b\"]}]}",
  )
}

fn from_catalogue() -> Catalogue = { prices: Map::new().insert(1.50m, "bolt").insert(2.00m, "nut") }

fn after_promotion() -> Catalogue = { prices: from_catalogue().prices.insert(1.5m, "bolt") }

fn from_shelf() -> Catalogue =
  { prices: Map::new().insert(1.5m, "bolt").insert(2m, "nut").insert(1.50m, "bolt") }

fn body(c: Catalogue) -> String / {abort.raise} = json::encode_string(c, catalogue_json())

test "a decimal key encodes as it was first written, whichever spelling came later" {
  assert_eq(from_catalogue(), after_promotion());
  assert_eq(body(from_catalogue()), body(after_promotion()));
  assert_eq(
    body(after_promotion()),
    "{\"prices\":[{\"key\":1.50,\"value\":\"bolt\"},{\"key\":2.00,\"value\":\"nut\"}]}",
  );
  assert_eq(from_shelf(), from_catalogue());
  assert_eq(
    body(from_shelf()),
    "{\"prices\":[{\"key\":1.5,\"value\":\"bolt\"},{\"key\":2,\"value\":\"nut\"}]}",
  )
}
