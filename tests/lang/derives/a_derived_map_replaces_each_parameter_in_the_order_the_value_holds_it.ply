//! `derive map` from `std.derive.map`, a deriver the library declares: `T::map` rebuilds a value with
//! each type parameter's values replaced, through lists, options, maps, records and aliases, across
//! types that recur through each other and hand their parameters on in another order.

import std.derive.map

type Named<r, l> = | Local(l) | Defined(r) | Free(String)
type Value<r, l> = { named: Named<r, l>, written: List<r> }
type Expression<r, l> =
  | Var(Value<r, l>)
  | Call(Expression<r, l>, List<Expression<r, l>>)
  | Maybe(Option<Expression<r, l>>)
  | Pair({ left: l, count: Int })
  | Table(Map<String, r>)
  | Nothing
type Keyed<k, v> = | Empty | Entry(k, v, Flipped<k, v>)
type Flipped<k, v> = | Turn(Keyed<v, k>) | Stop
type Box<a> = new { inner: List<a>, label: String }

derive map for Named
derive map for Expression
derive map for Keyed
derive map for Flipped
derive map for Box

effect counted {
  write next() -> Int
}

fn sample() -> Expression<String, Int> =
  Call(Var({ named: Defined("f"), written: ["g", "h"] }), [
    Pair({ left: 3, count: 7 }),
    Maybe(Some(Var({ named: Local(1), written: [] }))),
    Table(#{"k": "v"}),
    Nothing,
  ])

test "each parameter's values are replaced by what its function answers, and the rest is kept" {
  assert_eq(
    sample().map(r: |s: String| s ++ "!", l: |n: Int| n * 10),
    Call(Var({ named: Defined("f!"), written: ["g!", "h!"] }), [
      Pair({ left: 30, count: 7 }),
      Maybe(Some(Var({ named: Local(10), written: [] }))),
      Table(#{"k": "v!"}),
      Nothing,
    ]),
  );
  let b: Box<Int> = { inner: [1, 2], label: "x" };
  assert_eq(b.map(|n: Int| n + 1), { inner: [2, 3], label: "x" })
}

test "the functions run in the order the value holds what they read" {
  let numbered = handle {
    sample().map(|s: String| counted.next(), |n: Int| counted.next())
  } with {
    var n: Int = 0,
    counted.next() -> {
      n = n + 1;
      n
    },
  };
  assert_eq(
    numbered,
    Call(Var({ named: Defined(1), written: [2, 3] }), [
      Pair({ left: 4, count: 7 }),
      Maybe(Some(Var({ named: Local(5), written: [] }))),
      Table(#{"k": 6}),
      Nothing,
    ]),
  )
}

test "a type that hands its parameters on in another order maps each by its own function" {
  let k: Keyed<String, Int> = Entry("a", 1, Turn(Entry(2, "b", Stop)));
  assert_eq(
    k.map(|s: String| s.len(), |n: Int| n.to_string()),
    Entry(1, "1", Turn(Entry("2", 1, Stop))),
  )
}
