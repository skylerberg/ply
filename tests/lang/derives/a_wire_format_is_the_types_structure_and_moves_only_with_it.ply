import derives.reordered
import derives.wire
import std.bin
import std.json

type Forward = { x: Int, y: String }

type Backward = { y: String, x: Int }

type Choice = | LeftC(Int) | RightC(String)

derive json for Forward
derive json for Backward
derive json for Choice

fn forward_wire(f: Forward) -> String / {abort.raise} =
  String::of_bytes(json::encode_bytes(f, forward_json()))

test "two record types of one shape write one document, and each reads the other's" {
  assert_eq(forward_wire({ x: 1, y: "hi" }), "{\"x\":1,\"y\":\"hi\"}");
  assert_eq(
    String::of_bytes(json::encode_bytes({ y: "hi", x: 1 }, backward_json())),
    forward_wire({ x: 1, y: "hi" }),
  );
  match json::decode_bytes(Bytes::of_string(forward_wire({ x: 1, y: "hi" })), backward_json()) {
    Ok(b) -> assert_eq(b.x, 1),
    Err(e) -> assert_eq(json::error_to_string(e), "it should have decoded"),
  }
}

test "a sum is distinguished only by its variant names, so another module's sum with the same names reads it" {
  let doc = String::of_bytes(json::encode_bytes(LeftC(3), choice_json()));
  assert_eq(doc, "{\"tag\":\"LeftC\",\"values\":[3]}");
  assert_eq(json::decode_bytes(Bytes::of_string(doc), wire::choice_json()), Ok(wire::LeftC(3)))
}

type Key = String

type Direct = { m: Map<String, Int> }

type Aliased = { m: Map<Key, Int> }

type ById = { m: Map<Int, Int> }

derive json for Key
derive json for Direct
derive json for Aliased
derive json for ById

test "a map key written through an alias gets the wire format its type does" {
  let entry: Map<String, Int> = Map::new().insert("k", 1);
  assert_eq(String::of_bytes(json::encode_bytes({ m: entry }, direct_json())), "{\"m\":{\"k\":1}}");
  assert_eq(
    String::of_bytes(json::encode_bytes({ m: entry }, aliased_json())),
    "{\"m\":{\"k\":1}}",
  );
  match json::decode_bytes(Bytes::of_string("{\"m\":{\"k\":1}}"), aliased_json()) {
    Ok(a) -> assert_eq(a.m.len(), 1),
    Err(e) -> assert_eq(json::error_to_string(e), "it should have decoded"),
  };
  assert_eq(
    String::of_bytes(json::encode_bytes({ m: Map::new().insert(1, 2) }, by_id_json())),
    "{\"m\":[{\"key\":1,\"value\":2}]}",
  )
}

type Sum = | A(Int) | B(String)

type Point = { x: Int }

type Renamed = { y: Int }

type Box<a> = { item: a }

derive bin for Sum
derive bin for Point
derive bin for Renamed
derive bin for Box

test "one structure under one name has one shape, in any module" {
  assert_eq(bin::shape_digest(sum_bin()), bin::shape_digest(wire::sum_bin()));
  assert_eq(bin::shape_digest(point_bin()), bin::shape_digest(wire::point_bin()))
}

test "an order, a field name or a type argument changes a shape" {
  assert(bin::shape_digest(sum_bin()) != bin::shape_digest(reordered::sum_bin()));
  assert(bin::shape_digest(point_bin()) != bin::shape_digest(renamed_bin()));
  assert(
    bin::shape_digest(box_bin(bin::int_bin())) != bin::shape_digest(box_bin(bin::string_bin())),
  )
}
