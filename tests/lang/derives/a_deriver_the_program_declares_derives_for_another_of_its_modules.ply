//! A module of the program that declares `pub fn derive` is a deriver its other modules run, as they
//! run the library's.

import derives.naming

type Order = | Order(Int)

type Refund = new { id: Int }

derive naming for Order
derive naming for Refund

test "each derived function returns its own type's name" {
  assert_eq(Order::named(), "Order");
  assert_eq(Refund::named(), "Refund")
}
