type Point = { x: Int, label: String }

type Shape = | Dot(Point) | Line(Point, Point) | Empty

test "a record and a sum a task returns come back from its join as they were made" {
  simulate {
    let p = task.spawn(|| { x: 3, label: "three" });
    let s = task.spawn(|| Line({ x: 1, label: "a" }, { x: 2, label: "b" }));
    assert_eq(task.join(p), { x: 3, label: "three" });
    assert_eq(task.join(s), Line({ x: 1, label: "a" }, { x: 2, label: "b" }))
  }
}

test "a channel delivers each sum type value sent to it, in the order sent" {
  simulate {
    let c = task.channel(3);
    assert(task.send(c, Dot({ x: 1, label: "one" })));
    assert(task.send(c, Empty));
    assert(task.send(c, Line({ x: 2, label: "two" }, { x: 3, label: "three" })));
    task.close(c);
    assert_eq(task.recv(c), Some(Dot({ x: 1, label: "one" })));
    assert_eq(task.recv(c), Some(Empty));
    assert_eq(task.recv(c), Some(Line({ x: 2, label: "two" }, { x: 3, label: "three" })));
    assert_eq(task.recv(c), None)
  }
}

test "a list sent between tasks is received whole" {
  simulate {
    let c = task.channel(0);
    let sender = task.spawn(|| task.send(c, [[1, 2], [], [3]]));
    assert_eq(task.recv(c), Some([[1, 2], [], [3]]));
    assert(task.join(sender))
  }
}

test "a closure sent over a channel runs after it is received and still uses the variable it captured" {
  simulate {
    let c = task.channel(1);
    let k = 5;
    assert(task.send(c, |n: Int| n + k));
    match task.recv(c) { Some(f) -> assert_eq(f(2), 7), None -> assert(false) }
  }
}

test "a select sends a record and receives it back" {
  simulate {
    let a = task.channel(1);
    let b: Chan<Point> = task.channel(1);
    let p = { x: 4, label: "four" };
    assert_eq(task.select([(a, Some(p))], false), Some((0, Some(p))));
    assert_eq(task.select([(b, None), (a, None)], true), Some((1, Some(p))))
  }
}

test "values left unreceived in a channel are released without error when the simulation ends" {
  simulate {
    let c = task.channel(2);
    assert(task.send(c, { x: 1, label: "kept" }));
    assert(task.send(c, { x: 2, label: "kept too" }))
  }
}
