//! A line string is the text its lines spell, verbatim, so it compares equal to the escaped string
//! that spells the same text.

fn program() -> String =
  \\fn main() -> Int = {
  \\  let s = "a \"quoted\" \\ word";
  \\  42
  \\}
  \\

fn bare() -> String =
  \\no newline at the end

test "every line ends with a newline but the last, which ends the value" {
  assert_eq(
    program(),
    "fn main() -> Int = {\n  let s = \"a \\\"quoted\\\" \\\\ word\";\n  42\n}\n",
  );
  assert_eq(bare(), "no newline at the end")
}

test "a line holding only its backslashes is an empty line" {
  let blank =
    \\
    \\
  ;
  assert_eq(blank, "\n")
}

test "backslashes and quotes after the first two are text" {
  let nested =
    \\  \\inner "x"
  ;
  assert_eq(nested, "  \\\\inner \"x\"");
  assert_eq(string_len(nested), 13)
}
