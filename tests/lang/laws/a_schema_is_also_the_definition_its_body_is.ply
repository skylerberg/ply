import laws.stated
import laws.stated (settles)

fn word(b: Bool) -> String = if b { "yes" } else { "no" }

fn truth(s: String) -> Option<Bool> =
  if s == "yes" { Some(true) } else if s == "no" { Some(false) } else { None }

fn part(n: Int) -> Int / {abort.raise} = 100 / n

law "parsing the printed word of a `Bool`, such as `true`, returns the same value" =
  stated::reads_back(word, truth)

law "applying a function that returns `b || true` a second time gives the same result as applying it once" =
  settles(|b: Bool| b || true)

test "a schema's body is a function that takes the schema's parameters, then its quantified variables" {
  assert(stated::reads_back(word, truth, true));
  assert(!stated::reads_back(word, |_s: String| Some(false), true));
  assert(stated::reads_back_where(word, truth, false));
  assert(settles(|n: Int| min(n, 10), 12))
}

test "a function passed to a schema can make it fail, just as a statement in its body can" {
  assert(settles(part, 10));
  assert(!settles(part, 5))
}
