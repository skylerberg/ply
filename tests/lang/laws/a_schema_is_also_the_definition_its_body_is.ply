// A `law schema` declares the definition its body is, over its parameters and then its binders, and
// its guard as `<name>_where`; a law instantiates it, in its module or another.

import laws.stated
import laws.stated (settles)

fn word(b: Bool) -> String = if b { "yes" } else { "no" }

fn truth(s: String) -> Option<Bool> =
  if s == "yes" { Some(true) } else if s == "no" { Some(false) } else { None }

fn part(n: Int) -> Int / {abort.raise} = 100 / n

law "a bool reads back" = stated::reads_back(word, truth)

law "capping settles" = settles(|n: Int| min(n, 10))

test "a schema's body is a definition over its parameters and then its binders" {
  assert(stated::reads_back(word, truth, true));
  assert(!stated::reads_back(word, |_s: String| Some(false), true));
  assert(stated::reads_back_where(word, truth, false));
  assert(settles(|n: Int| min(n, 10), 12))
}

test "what a schema is given may raise, as its body may" {
  assert(settles(part, 10));
  assert(!settles(part, 5))
}
