// Schemas another module instantiates. Each also declares the definition its body is.

pub law schema reads_back<a>(shown: (a) -> String, read: (String) -> Option<a>)
  forall (x: a) where shown(x) != "" {
    read(shown(x)) == Some(x)
  }

pub law schema settles<a>(f: (a) -> a / {abort.raise}) forall (x: a) { f(f(x)) == f(x) }
