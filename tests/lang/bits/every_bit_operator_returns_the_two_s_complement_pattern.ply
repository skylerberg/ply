test "and, or and xor at small values" {
  assert_eq(12 & 10, 8);
  assert_eq(12 | 10, 14);
  assert_eq(12 ^ 10, 6);
  assert_eq(0 & 255, 0);
  assert_eq(0 | 255, 255)
}

effect asks {
  write one() -> Unit
  read so_far() -> Int
}

fn counted<a | e>(body: () -> a / {asks.one, asks.so_far | e}) -> a / e =
  handle {
    body()
  } with {
    var n = 0,
    asks.one() -> {
      n = n + 1;
    },
    asks.so_far() -> n,
  }

test "not is every bit flipped, so ~x is -x - 1" {
  assert_eq(~0, 0 - 1);
  assert_eq(~5, 0 - 6);
  assert_eq(~(0 - 1), 0);
  assert_eq(~(~7), 7)
}

test "de morgan over the whole word" {
  assert_eq(~(12 & 10), ~12 | ~10);
  assert_eq(~(12 | 10), ~12 & ~10);
  assert_eq(12 ^ 10, (12 | 10) & ~(12 & 10))
}

test "the sign bit is an ordinary bit" {
  assert_eq(0 - 1 & 255, 255);
  assert(0 - 1 | 0 < 0);
  assert_eq(0 - 1 ^ 0 - 1, 0)
}

test "`&` evaluates both operands, unlike the short-circuiting `&&`" {
  counted(|| {
    let r = 0
      & {
        asks.one();
        5
      };
    assert_eq(r, 0);
    assert_eq(asks.so_far(), 1)
  })
}
