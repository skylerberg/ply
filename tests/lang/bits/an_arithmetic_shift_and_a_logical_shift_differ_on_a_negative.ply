test "arithmetic propagates the sign" {
  assert_eq(-8 >> 1, 0 - 4);
  assert_eq(-8 >> 3, 0 - 1);
  assert_eq(-1 >> 63, 0 - 1);
  assert_eq(8 >> 1, 4)
}

test "`>>>` shifts in zero bits from the left, treating the number as 64 unsigned bits" {
  assert_eq(-8 >>> 1, 9223372036854775804);
  assert(-8 >>> 1 > 0);
  assert_eq(-1 >>> 63, 1);
  assert_eq(-1 >>> 1, 9223372036854775807);
  assert_eq(8 >>> 1, 4)
}

test "`>>` and `>>>` return the same result when the sign bit is clear and different results for a negative number" {
  assert_eq(range(0, 20).map(|x| x >> 2), range(0, 20).map(|x| x >>> 2));
  assert(-4 >> 2 != -4 >>> 2)
}
