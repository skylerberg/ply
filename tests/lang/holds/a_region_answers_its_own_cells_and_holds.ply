//! A region answers what reads its own cell or hold, wherever the read is written, and nothing
//! that reads another region's.

effect log {
  write say[l](n: Int) -> Unit
}

fn twice<| e>(f: () -> Int / e) -> Int / e = f() + f()

fn through_a_row(n: Int) -> Int = with_cell[t](n) { c -> twice(|| cell_get(c)) }

fn of_the_same_name<| e>(f: () -> Int / e) -> Int / e = with_cell[t](1) { d -> cell_get(d) + f() }

fn under_one_name(n: Int) -> Int = with_cell[t](n) { c -> of_the_same_name(|| cell_get(c)) }

fn shut(_: Int) -> Unit = ()

fn peek<[r]>(h: Hold<Int, [r]>) -> Int / {hold.read[r]} = h.get()

fn outer_hold_past_inner(n: Int) -> Int =
  with_hold[outer](
    n,
    shut,
  ) { h -> {
    let k = with_hold[inner](
      2,
      shut,
    ) { g -> {
      let m = peek(g);
      || peek(h) + m
    } };
    k()
  } }

fn outer_cell_past_inner(n: Int) -> Int =
  with_cell[outer](n) { a -> {
    let k = with_cell[inner](2) { b -> {
      let m = cell_get(b);
      || cell_get(a) + m
    } };
    cell_set(a, cell_get(a) + 1);
    k()
  } }

fn noted<[l], [r]>(h: Hold<Int, [r]>) -> Unit / {log.write[l], hold.read[r]} = log.say[l](h.get())

fn beside_a_written_label(n: Int) -> Int =
  with_cell[said](0) { c -> {
    handle {
      with_hold[file](n, shut) { h -> noted[audit](h) }
    } with {
      log.say[audit](x) -> cell_set(c, x),
    };
    cell_get(c)
  } }

test "a closure over a cell is handed to a row parameter, and its own region answers it" {
  assert_eq(through_a_row(21), 42);
  assert_eq(under_one_name(41), 42)
}

test "what reads an outer region leaves an inner one and is answered by its own" {
  assert_eq(outer_hold_past_inner(40), 42);
  assert_eq(outer_cell_past_inner(39), 42)
}

test "a call writes the label of a resource and the hold it passes fills its region's" {
  assert_eq(beside_a_written_label(42), 42)
}
