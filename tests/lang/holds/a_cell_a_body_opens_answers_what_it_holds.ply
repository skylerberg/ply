fn tally(n: Int) -> Int =
  with_cell[t](0) { c -> {
    cell_set(c, n * 2);
    cell_set(c, cell_get(c) + 1);
    cell_get(c)
  } }

fn once(n: Int) -> Int = with_cell[t](n) { c -> cell_get(c) + 1 }

fn nested(n: Int) -> Int =
  with_cell[outer](n) { a -> {
    let inner = with_cell[inner](cell_get(a)) { b -> cell_get(b) * 2 };
    cell_get(a) + inner
  } }

fn unread(n: Int) -> Int = with_cell[t](n) { _c -> n + 1 }

test "a cell a body opens answers what was last set in it" {
  assert_eq(tally(20), 41);
  assert_eq(once(7), 8);
  assert_eq(nested(5), 15);
  assert_eq(unread(5), 6)
}
