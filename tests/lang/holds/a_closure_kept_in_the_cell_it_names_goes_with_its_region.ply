// A closure names its cell without counting it, so keeping it there makes no cycle to leak.
fn countdown(n: Int) -> Int =
  with_cell[r](n) { base -> {
    with_cell[r](|k: Int| k + cell_get(base)) { c -> {
      cell_set(c, |k: Int| if k == 0 { cell_get(base) } else { cell_get(c)(k - 1) });
      cell_get(c)(3)
    } }
  } }

test "a closure kept in the cell it names is let go with the cell's region" {
  let m = metered(|| countdown(5));
  assert_eq(m.value, 5);
  assert_eq(m.live, 0)
}
