//! A region answers what reads its own hold, wherever the read is written, and nothing that reads
//! another region's.

effect log {
  write say[l](n: Int) -> Unit
}

fn twice<| e>(f: () -> Int / e) -> Int / e = f() + f()

fn shut(_: Int) -> Unit = ()

fn through_a_row(n: Int) -> Int = with_scope[t](n, shut) { c -> twice(|| c.get()) }

fn of_the_same_name<| e>(f: () -> Int / e) -> Int / e = with_scope[t](1, shut) { d -> d.get() + f() }

fn under_one_name(n: Int) -> Int = with_scope[t](n, shut) { c -> of_the_same_name(|| c.get()) }

fn peek<[r]>(h: Scoped<Int, [r]>) -> Int / {scoped.read[r]} = h.get()

fn outer_hold_past_inner(n: Int) -> Int =
  with_scope[outer](
    n,
    shut,
  ) { h -> {
    let k = with_scope[inner](
      2,
      shut,
    ) { g -> {
      let m = peek(g);
      || peek(h) + m
    } };
    k()
  } }

fn noted<[l], [r]>(h: Scoped<Int, [r]>) -> Unit / {log.write[l], scoped.read[r]} = log.say[l](h.get())

fn beside_a_written_label(n: Int) -> Int =
  handle {
    with_scope[file](n, shut) { h -> noted[audit](h) }
  } with {
    var said = 0,
    log.say[audit](x) -> {
      said = x;
    },
    return u -> said,
  }

fn boxed() -> Int = with_scope[log](41, shut) { h -> h.get() }

// `boxed` is nullary with an empty row, so it is a constant: the memo keeps what its hold held.
test "a constant whose body opens a region answers what its hold held, every time" {
  assert_eq(boxed(), 41);
  assert_eq(boxed(), 41)
}

test "a closure over a hold is handed to a row parameter, and its own region answers it" {
  assert_eq(through_a_row(21), 42);
  assert_eq(under_one_name(41), 42)
}

test "what reads an outer region leaves an inner one and is answered by its own" {
  assert_eq(outer_hold_past_inner(40), 42)
}

test "a call writes the label of a resource and the hold it passes fills its region's" {
  assert_eq(beside_a_written_label(42), 42)
}
