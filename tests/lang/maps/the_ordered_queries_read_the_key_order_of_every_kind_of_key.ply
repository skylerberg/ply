// The ordered queries over keys that are ordered five ways: as the words stand (`Int`, `String`),
// field by field (a tuple), by value (a `Decimal`, where `1.5m` and `1.50m` are one key), and
// through a `key` a type states (a length in two units, a `BigInt`). The last two are ordered
// against their constructors: `Metres(1)` is above `Millimetres(5)`, and a negative `BigInt` below
// zero though its constructor holds `true` where zero's holds `false`.

import std.bigint as bigint
import std.bigint (BigInt)

pub type Length = | Metres(Int) | Millimetres(Int)

key for Length by millimetres

fn millimetres(l: Length) -> Int = match l { Metres(n) -> n * 1000, Millimetres(n) -> n }

fn lengths() -> Map<Length, String> =
  #{
    Metres(2): "two metres",
    Millimetres(5): "five millimetres",
    Metres(1): "a metre",
    Millimetres(1500): "a metre and a half",
  }

fn value_of(entry: { key: Length, value: String }) -> String = entry.value

fn told(found: Option<{ key: Length, value: String }>) -> String =
  match found { Some(entry) -> entry.value, None -> "none" }

fn numbered(n: Int) -> Map<Int, Int> =
  fold(range(0, n), map_new(), |m: Map<Int, Int>, i: Int| map_insert(m, i, i * 10))

test "a keyed type's entries are found by its key, in whichever unit the probe is written" {
  let m = lengths();
  assert_eq(told(map_first(m)), "five millimetres");
  assert_eq(told(map_last(m)), "two metres");
  assert_eq(told(map_floor(m, Millimetres(1000))), "a metre");
  assert_eq(told(map_floor(m, Millimetres(999))), "five millimetres");
  assert_eq(told(map_floor(m, Millimetres(4))), "none");
  assert_eq(told(map_ceiling(m, Millimetres(1000))), "a metre");
  assert_eq(told(map_ceiling(m, Millimetres(1001))), "a metre and a half");
  assert_eq(told(map_ceiling(m, Metres(3))), "none");
  assert_eq(told(map_below(m, Metres(1))), "five millimetres");
  assert_eq(told(map_below(m, Millimetres(5))), "none");
  assert_eq(told(map_above(m, Millimetres(1000))), "a metre and a half");
  assert_eq(told(map_above(m, Millimetres(2000))), "none")
}

test "a keyed type's range, split and pops follow its key" {
  let m = lengths();
  assert_eq(
    map(map_range(m, Some(Millimetres(1000)), true, Some(Metres(2)), false, 9), value_of),
    ["a metre", "a metre and a half"],
  );
  let parts = map_split(m, Millimetres(1000));
  assert_eq(map_values(parts.below), ["five millimetres"]);
  assert_eq(parts.at, Some("a metre"));
  assert_eq(map_values(parts.above), ["a metre and a half", "two metres"]);
  match map_pop_first(m) {
    Some(popped) -> {
      assert_eq(popped.value, "five millimetres");
      assert_eq(map_len(popped.rest), 3)
    },
    None -> assert(false),
  };
  match map_pop_last(m) {
    Some(popped) -> {
      assert_eq(popped.key, Millimetres(2000));
      assert_eq(map_values(popped.rest), ["five millimetres", "a metre", "a metre and a half"])
    },
    None -> assert(false),
  }
}

test "a BigInt key orders by its value, the negatives first" {
  let big = bigint::mul(bigint::of_int(4611686018427387904), bigint::of_int(4611686018427387904));
  let m: Map<BigInt, String> = #{
    bigint::zero(): "zero",
    bigint::of_int(-5): "minus five",
    big: "two to the hundred and twenty-fourth",
    bigint::of_int(3): "three",
  };
  let named = |found: Option<{ key: BigInt, value: String }>|
    match found { Some(entry) -> entry.value, None -> "none" };
  assert_eq(named(map_first(m)), "minus five");
  assert_eq(named(map_last(m)), "two to the hundred and twenty-fourth");
  assert_eq(named(map_floor(m, bigint::of_int(-1))), "minus five");
  assert_eq(named(map_ceiling(m, bigint::of_int(-1))), "zero");
  assert_eq(named(map_above(m, bigint::of_int(3))), "two to the hundred and twenty-fourth");
  assert_eq(named(map_below(m, bigint::of_int(-5))), "none");
  assert_eq(map_values(map_split(m, bigint::of_int(1)).below), ["minus five", "zero"]);
  assert_eq(len(map_range(m, Some(bigint::of_int(-5)), false, Some(big), false, 9)), 2)
}

test "a Decimal key is one key however many zeros it is written with" {
  let m = #{1.5m: "a", 2.5m: "b", 3.5m: "c"};
  assert_eq(map_floor(m, 2.50m), Some({ key: 2.5m, value: "b" }));
  assert_eq(map_ceiling(m, 2.500m), Some({ key: 2.5m, value: "b" }));
  assert_eq(map_below(m, 2.50m), Some({ key: 1.5m, value: "a" }));
  assert_eq(map_above(m, 2.50m), Some({ key: 3.5m, value: "c" }));
  assert_eq(map_floor(m, 2.49m), Some({ key: 1.5m, value: "a" }));
  let parts = map_split(m, 2.50m);
  assert_eq(map_keys(parts.below), [1.5m]);
  assert_eq(parts.at, Some("b"));
  assert_eq(map_keys(parts.above), [3.5m]);
  assert_eq(map_range(m, Some(1.50m), false, Some(3.50m), true, 9), [
    { key: 2.5m, value: "b" },
    { key: 3.5m, value: "c" },
  ]);
  assert_eq(map_first(m), Some({ key: 1.5m, value: "a" }));
  match map_pop_last(m) {
    Some(popped) -> assert_eq(map_keys(popped.rest), [1.5m, 2.5m]),
    None -> assert(false),
  }
}

test "a tuple key orders by its first field and then its second, as a queue by priority does" {
  let queue: Map<(Int, Int), String> = #{
    (2, 0): "later",
    (1, 1): "second",
    (1, 0): "first",
    (3, 0): "last",
  };
  assert_eq(map_first(queue), Some({ key: (1, 0), value: "first" }));
  assert_eq(map_ceiling(queue, (2, -1)), Some({ key: (2, 0), value: "later" }));
  assert_eq(map_floor(queue, (2, -1)), Some({ key: (1, 1), value: "second" }));
  assert_eq(map_values(map_split(queue, (2, 0)).above), ["last"]);
  assert_eq(served(queue), ["first", "second", "later", "last"])
}

/// The values of a queue in the order it gives them up. The loop binds what it keeps of its state
/// before it pops, so the pop is the last reader of the record that holds the map.
fn served(queue: Map<(Int, Int), String>) -> List<String> / {abort.raise} =
  iterate(
    { rest: queue, out: [] },
    map_len(queue) + 1,
    |s: { rest: Map<(Int, Int), String>, out: List<String> }| {
      let out = s.out;
      match map_pop_first(s.rest) {
        Some(popped) -> Continue({ rest: popped.rest, out: push(out, popped.value) }),
        None -> Stop(out),
      }
    },
  )

fn queued(n: Int) -> Map<(Int, Int), String> =
  fold(range(0, n), map_new(), |m: Map<(Int, Int), String>, i: Int|
    map_insert(m, (i % 7, i), "job"))

/// How many entries a queue gives up before it is empty, in a loop written as `served` is.
fn drawn(queue: Map<(Int, Int), String>) -> Int / {abort.raise} =
  iterate(
    { rest: queue, count: 0 },
    map_len(queue) + 1,
    |s: { rest: Map<(Int, Int), String>, count: Int }| {
      let count = s.count;
      match map_pop_first(s.rest) {
        Some(popped) -> Continue({ rest: popped.rest, count: count + 1 }),
        None -> Stop(count),
      }
    },
  )

test "a loop that pops a queue it alone holds copies none of the queue" {
  let built = metered(|| map_len(queued(3000))).allocations;
  let spent = metered(|| drawn(queued(3000)));
  assert_eq(spent.value, 3000);
  // Each turn builds the pop's answer; a copied path would be a node or more beside it.
  assert(spent.allocations - built <= 2 * 3000 + 8, Some(int_to_string(spent.allocations - built)))
}

test "a String key orders by its bytes" {
  let m = #{"pear": 1, "Zebra": 2, "apple": 3, "": 4};
  assert_eq(map_first(m), Some({ key: "", value: 4 }));
  assert_eq(map_above(m, ""), Some({ key: "Zebra", value: 2 }));
  assert_eq(map_floor(m, "b"), Some({ key: "apple", value: 3 }));
  assert_eq(map_range(m, Some("a"), true, Some("q"), true, 9), [
    { key: "apple", value: 3 },
    { key: "pear", value: 1 },
  ]);
  assert_eq(map_keys(map_split(m, "apple").below), ["", "Zebra"])
}

test "bounds that cross, a limit below one and an empty map answer nothing" {
  let m = numbered(10);
  assert_eq(map_range(m, Some(7), true, Some(3), true, 9), []);
  assert_eq(map_range(m, Some(3), false, Some(3), true, 9), []);
  assert_eq(map_range(m, Some(3), true, Some(3), true, 9), [{ key: 3, value: 30 }]);
  assert_eq(map_range(m, None, true, None, true, 0), []);
  assert_eq(map_range(m, None, true, None, true, -1), []);
  assert_eq(len(map_range(m, None, false, None, false, 100)), 10);
  let none: Map<Int, Int> = map_new();
  assert_eq(map_first(none), None);
  assert_eq(map_last(none), None);
  assert_eq(map_floor(none, 1), None);
  assert_eq(map_ceiling(none, 1), None);
  assert_eq(map_pop_first(none), None);
  assert_eq(map_pop_last(none), None);
  assert_eq(map_range(none, None, true, None, true, 9), []);
  let parts = map_split(none, 1);
  assert_eq(map_len(parts.below) + map_len(parts.above), 0);
  assert_eq(parts.at, None)
}

test "a query builds its answer and nothing else, whatever the map holds" {
  let spent = |n: Int| {
    let m = numbered(n);
    [
      metered(|| map_first(m)).allocations,
      metered(|| map_last(m)).allocations,
      metered(|| map_floor(m, n / 2)).allocations,
      metered(|| map_above(m, n / 2)).allocations,
      metered(|| map_range(m, Some(n / 3), true, None, true, 10)).allocations,
    ]
  };
  assert_eq(spent(100), spent(100000));
  // An entry and its `Some`; ten entries and the list that holds them.
  assert_eq(spent(100), [2, 2, 2, 2, 12])
}

fn drained(m: Map<Int, Int>, left: Int, sum: Int) -> Int =
  if left <= 0 { sum } else {
    match map_pop_first(m) {
      None -> sum,
      Some(popped) -> drained(popped.rest, left - 1, sum + popped.key),
    }
  }

fn emptied(m: Map<Length, Int>, left: Int, sum: Int) -> Int =
  if left <= 0 { sum } else {
    match map_pop_last(m) {
      None -> sum,
      Some(popped) -> emptied(popped.rest, left - 1, sum + popped.value),
    }
  }

fn measured(n: Int) -> Map<Length, Int> =
  fold(range(0, n), map_new(), |m: Map<Length, Int>, i: Int|
    map_insert(m, if i % 2 == 0 { Millimetres(i) } else { Metres(i) }, i))

test "a pop of a map held once writes where the map stands: each builds its answer alone" {
  let built = metered(|| map_len(numbered(4000))).allocations;
  let popped = metered(|| drained(numbered(4000), 4000, 0));
  assert_eq(popped.value, 7998000);
  assert_eq(popped.allocations - built, 2 * 4000);
  let built = metered(|| map_len(measured(600))).allocations;
  let popped = metered(|| emptied(measured(600), 600, 0));
  assert_eq(popped.value, 179700);
  assert_eq(popped.allocations - built, 2 * 600)
}

test "a pop of a map something else holds leaves that holder's map whole" {
  let m = numbered(2000);
  match map_pop_first(m) {
    Some(popped) -> {
      assert_eq(map_len(popped.rest), 1999);
      assert_eq(map_first(popped.rest), Some({ key: 1, value: 10 }))
    },
    None -> assert(false),
  };
  assert_eq(map_len(m), 2000);
  assert_eq(map_first(m), Some({ key: 0, value: 0 }));
  let parts = map_split(m, 1000);
  assert_eq([map_len(parts.below), map_len(parts.above)], [1000, 999]);
  assert_eq(map_len(m), 2000);
  assert_eq(map_get(m, 1000), Some(10000))
}

test "a split of a map held once makes a node for each level, not a copy of either half" {
  let spent = |n: Int| {
    let built = metered(|| map_len(numbered(n))).allocations;
    metered(|| map_len(map_split(numbered(n), n / 2).above)).allocations - built
  };
  assert(spent(100) <= 8, Some(int_to_string(spent(100))));
  assert(spent(100000) <= 12, Some(int_to_string(spent(100000))))
}

test "a merge walks the smaller map into the larger, whichever side it is on" {
  let small = #{-2: 0, -1: 0, 1: 0, 2: 0};
  let spent = |n: Int| {
    let built = metered(|| map_len(numbered(n))).allocations;
    [
      metered(|| map_len(map_merge(small, numbered(n)))).allocations - built,
      metered(|| map_len(map_merge(numbered(n), small))).allocations - built,
    ]
  };
  assert_eq(spent(1000), spent(50000));
  assert_eq(
    map_get(map_merge(#{1: "ours", 2: "ours"}, #{2: "theirs", 3: "theirs", 4: "theirs"}), 2),
    Some("theirs"),
  );
  assert_eq(
    map_get(map_merge(#{2: "ours", 3: "ours", 4: "ours"}, #{1: "theirs", 2: "theirs"}), 2),
    Some("theirs"),
  )
}

test "entries already in key order build a map of full leaves" {
  let entries = map_entries(numbered(3200));
  let sorted = metered(|| map_len(map_of_entries(entries)));
  assert_eq(sorted.value, 3200);
  // A hundred leaves of thirty-two, four branches over them, a root and the map.
  assert(sorted.allocations <= 110, Some(int_to_string(sorted.allocations)));
  assert_eq(map_of_entries(entries), numbered(3200))
}
