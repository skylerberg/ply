// The ordered queries over keys that are ordered five ways: as the words stand (`Int`, `String`),
// field by field (a tuple), by value (a `Decimal`, where `1.5m` and `1.50m` are one key), and
// through a `key` a type states (a length in two units, a `BigInt`). The last two are ordered
// against their constructors: `Metres(1)` is above `Millimetres(5)`, and a negative `BigInt` below
// zero though its constructor holds `true` where zero's holds `false`.

import std.bigint as bigint
import std.bigint (BigInt)

pub type Length = | Metres(Int) | Millimetres(Int)

key for Length by millimetres

fn millimetres(l: Length) -> Int = match l { Metres(n) -> n * 1000, Millimetres(n) -> n }

fn lengths() -> Map<Length, String> =
  #{
    Metres(2): "two metres",
    Millimetres(5): "five millimetres",
    Metres(1): "a metre",
    Millimetres(1500): "a metre and a half",
  }

fn value_of(entry: { key: Length, value: String }) -> String = entry.value

fn value_or_none(found: Option<{ key: Length, value: String }>) -> String =
  match found { Some(entry) -> entry.value, None -> "none" }

fn numbered(n: Int) -> Map<Int, Int> =
  range(0, n).fold(Map::new(), |m: Map<Int, Int>, i: Int| m.insert(i, i * 10))

test "a keyed type's entries are found by its key, in whichever unit the probe is written" {
  let m = lengths();
  assert_eq(value_or_none(m.first()), "five millimetres");
  assert_eq(value_or_none(m.last()), "two metres");
  assert_eq(value_or_none(m.floor(Millimetres(1000))), "a metre");
  assert_eq(value_or_none(m.floor(Millimetres(999))), "five millimetres");
  assert_eq(value_or_none(m.floor(Millimetres(4))), "none");
  assert_eq(value_or_none(m.ceiling(Millimetres(1000))), "a metre");
  assert_eq(value_or_none(m.ceiling(Millimetres(1001))), "a metre and a half");
  assert_eq(value_or_none(m.ceiling(Metres(3))), "none");
  assert_eq(value_or_none(m.below(Metres(1))), "five millimetres");
  assert_eq(value_or_none(m.below(Millimetres(5))), "none");
  assert_eq(value_or_none(m.above(Millimetres(1000))), "a metre and a half");
  assert_eq(value_or_none(m.above(Millimetres(2000))), "none")
}

test "a keyed type's range, split and pops follow its key" {
  let m = lengths();
  assert_eq(m.range(Some(Millimetres(1000)), true, Some(Metres(2)), false, 9).map(value_of), [
    "a metre",
    "a metre and a half",
  ]);
  let parts = m.split(Millimetres(1000));
  assert_eq(parts.below.values(), ["five millimetres"]);
  assert_eq(parts.at, Some("a metre"));
  assert_eq(parts.above.values(), ["a metre and a half", "two metres"]);
  match m.pop_first() {
    Some(popped) -> {
      assert_eq(popped.value, "five millimetres");
      assert_eq(popped.rest.len(), 3)
    },
    None -> assert(false),
  };
  match m.pop_last() {
    Some(popped) -> {
      assert_eq(popped.key, Millimetres(2000));
      assert_eq(popped.rest.values(), ["five millimetres", "a metre", "a metre and a half"])
    },
    None -> assert(false),
  }
}

test "a BigInt key orders by its value, the negatives first" {
  let big = bigint::mul(bigint::of_int(4611686018427387904), bigint::of_int(4611686018427387904));
  let m: Map<BigInt, String> = #{
    bigint::zero(): "zero",
    bigint::of_int(-5): "minus five",
    big: "two to the hundred and twenty-fourth",
    bigint::of_int(3): "three",
  };
  let named = |found: Option<{ key: BigInt, value: String }>|
    match found { Some(entry) -> entry.value, None -> "none" };
  assert_eq(named(m.first()), "minus five");
  assert_eq(named(m.last()), "two to the hundred and twenty-fourth");
  assert_eq(named(m.floor(bigint::of_int(-1))), "minus five");
  assert_eq(named(m.ceiling(bigint::of_int(-1))), "zero");
  assert_eq(named(m.above(bigint::of_int(3))), "two to the hundred and twenty-fourth");
  assert_eq(named(m.below(bigint::of_int(-5))), "none");
  assert_eq(m.split(bigint::of_int(1)).below.values(), ["minus five", "zero"]);
  assert_eq(m.range(Some(bigint::of_int(-5)), false, Some(big), false, 9).len(), 2)
}

test "a Decimal key is one key however many zeros it is written with" {
  let m = #{1.5m: "a", 2.5m: "b", 3.5m: "c"};
  assert_eq(m.floor(2.50m), Some({ key: 2.5m, value: "b" }));
  assert_eq(m.ceiling(2.500m), Some({ key: 2.5m, value: "b" }));
  assert_eq(m.below(2.50m), Some({ key: 1.5m, value: "a" }));
  assert_eq(m.above(2.50m), Some({ key: 3.5m, value: "c" }));
  assert_eq(m.floor(2.49m), Some({ key: 1.5m, value: "a" }));
  let parts = m.split(2.50m);
  assert_eq(parts.below.keys(), [1.5m]);
  assert_eq(parts.at, Some("b"));
  assert_eq(parts.above.keys(), [3.5m]);
  assert_eq(m.range(Some(1.50m), false, Some(3.50m), true, 9), [
    { key: 2.5m, value: "b" },
    { key: 3.5m, value: "c" },
  ]);
  assert_eq(m.first(), Some({ key: 1.5m, value: "a" }));
  match m.pop_last() {
    Some(popped) -> assert_eq(popped.rest.keys(), [1.5m, 2.5m]),
    None -> assert(false),
  }
}

test "a tuple key orders by its first field and then its second, as a queue by priority does" {
  let queue: Map<(Int, Int), String> = #{
    (2, 0): "later",
    (1, 1): "second",
    (1, 0): "first",
    (3, 0): "last",
  };
  assert_eq(queue.first(), Some({ key: (1, 0), value: "first" }));
  assert_eq(queue.ceiling((2, -1)), Some({ key: (2, 0), value: "later" }));
  assert_eq(queue.floor((2, -1)), Some({ key: (1, 1), value: "second" }));
  assert_eq(queue.split((2, 0)).above.values(), ["last"]);
  assert_eq(queue_values(queue), ["first", "second", "later", "last"])
}

/// The values of a queue in the order it gives them up. The loop binds what it keeps of its state
/// before it pops, so the pop is the last reader of the record that holds the map.
fn queue_values(queue: Map<(Int, Int), String>) -> List<String> / {abort.raise} =
  iterate(
    { rest: queue, out: [] },
    queue.len() + 1,
    |s: { rest: Map<(Int, Int), String>, out: List<String> }| {
      let out = s.out;
      match s.rest.pop_first() {
        Some(popped) -> Continue({ rest: popped.rest, out: out.push(popped.value) }),
        None -> Stop(out),
      }
    },
  )

fn queued(n: Int) -> Map<(Int, Int), String> =
  range(0, n).fold(Map::new(), |m: Map<(Int, Int), String>, i: Int| m.insert((i % 7, i), "job"))

/// How many entries a queue gives up before it is empty, in a loop written as `queue_values` is.
fn drawn(queue: Map<(Int, Int), String>) -> Int / {abort.raise} =
  iterate(
    { rest: queue, count: 0 },
    queue.len() + 1,
    |s: { rest: Map<(Int, Int), String>, count: Int }| {
      let count = s.count;
      match s.rest.pop_first() {
        Some(popped) -> Continue({ rest: popped.rest, count: count + 1 }),
        None -> Stop(count),
      }
    },
  )

test "a loop that pops a queue it alone holds gives up every entry" {
  assert_eq(drawn(queued(3000)), 3000)
}

test "a String key orders by its bytes" {
  let m = #{"pear": 1, "Zebra": 2, "apple": 3, "": 4};
  assert_eq(m.first(), Some({ key: "", value: 4 }));
  assert_eq(m.above(""), Some({ key: "Zebra", value: 2 }));
  assert_eq(m.floor("b"), Some({ key: "apple", value: 3 }));
  assert_eq(m.range(Some("a"), true, Some("q"), true, 9), [
    { key: "apple", value: 3 },
    { key: "pear", value: 1 },
  ]);
  assert_eq(m.split("apple").below.keys(), ["", "Zebra"])
}

test "bounds that cross, a limit below one and an empty map answer nothing" {
  let m = numbered(10);
  assert_eq(m.range(Some(7), true, Some(3), true, 9), []);
  assert_eq(m.range(Some(3), false, Some(3), true, 9), []);
  assert_eq(m.range(Some(3), true, Some(3), true, 9), [{ key: 3, value: 30 }]);
  assert_eq(m.range(None, true, None, true, 0), []);
  assert_eq(m.range(None, true, None, true, -1), []);
  assert_eq(m.range(None, false, None, false, 100).len(), 10);
  let none: Map<Int, Int> = Map::new();
  assert_eq(none.first(), None);
  assert_eq(none.last(), None);
  assert_eq(none.floor(1), None);
  assert_eq(none.ceiling(1), None);
  assert_eq(none.pop_first(), None);
  assert_eq(none.pop_last(), None);
  assert_eq(none.range(None, true, None, true, 9), []);
  let parts = none.split(1);
  assert_eq(parts.below.len() + parts.above.len(), 0);
  assert_eq(parts.at, None)
}

fn drained(m: Map<Int, Int>, left: Int, sum: Int) -> Int =
  if left <= 0 { sum } else {
    match m.pop_first() {
      None -> sum,
      Some(popped) -> drained(popped.rest, left - 1, sum + popped.key),
    }
  }

fn emptied(m: Map<Length, Int>, left: Int, sum: Int) -> Int =
  if left <= 0 { sum } else {
    match m.pop_last() {
      None -> sum,
      Some(popped) -> emptied(popped.rest, left - 1, sum + popped.value),
    }
  }

fn measured(n: Int) -> Map<Length, Int> =
  range(0, n).fold(Map::new(), |m: Map<Length, Int>, i: Int|
    m.insert(if i % 2 == 0 { Millimetres(i) } else { Metres(i) }, i))

test "pops of a map held once give up every entry, from either end" {
  assert_eq(drained(numbered(4000), 4000, 0), 7998000);
  assert_eq(emptied(measured(600), 600, 0), 179700)
}

test "a pop of a map something else holds leaves that holder's map whole" {
  let m = numbered(2000);
  match m.pop_first() {
    Some(popped) -> {
      assert_eq(popped.rest.len(), 1999);
      assert_eq(popped.rest.first(), Some({ key: 1, value: 10 }))
    },
    None -> assert(false),
  };
  assert_eq(m.len(), 2000);
  assert_eq(m.first(), Some({ key: 0, value: 0 }));
  let parts = m.split(1000);
  assert_eq([parts.below.len(), parts.above.len()], [1000, 999]);
  assert_eq(m.len(), 2000);
  assert_eq(m.get(1000), Some(10000))
}

test "a merge takes the other map's value for a key both hold, whichever map is larger" {
  assert_eq(
    #{1: "ours", 2: "ours"}.merge(#{2: "theirs", 3: "theirs", 4: "theirs"}).get(2),
    Some("theirs"),
  );
  assert_eq(
    #{2: "ours", 3: "ours", 4: "ours"}.merge(#{1: "theirs", 2: "theirs"}).get(2),
    Some("theirs"),
  )
}

test "entries already in key order build the map they are the entries of" {
  let entries = numbered(3200).entries();
  assert_eq(Map::of_entries(entries).len(), 3200);
  assert_eq(Map::of_entries(entries), numbered(3200))
}
