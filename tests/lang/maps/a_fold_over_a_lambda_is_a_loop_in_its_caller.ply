fn squares(n: Int) -> Map<Int, Int> = range(0, n).fold(Map::new(), |m, i| m.insert(i, i * i))

fn weighed(m: Map<Int, Int>) -> Int =
  m.fold(0, |accumulator: Int, k: Int, v: Int| accumulator + k * v)

fn weigh(accumulator: Int, k: Int, v: Int) -> Int = accumulator + k * v

fn weighers() -> List<(Int, Int, Int) -> Int> = [weigh]

test "folding a map with a lambda returns the same result as folding it with a function value" {
  let value = weighers().get(0);
  let by_value = |m: Map<Int, Int>| m.fold(0, value);
  assert_eq(weighed(squares(0)), 0);
  assert_eq(weighed(squares(4)), 36);
  assert_eq(
    handle {
      squares(3).fold(0, |accumulator: Int, k: Int, v: Int| accumulator + v / k)
    } with {
      abort.raise(_) -> -1,
    },
    -1,
  );
  [0, 10, 1000].fold((), |_: Unit, n: Int| assert_eq(weighed(squares(n)), by_value(squares(n))))
}
