//! A `Map::fold` over a literal lambda is a loop in its caller, the lambda's body run in it: it
//! answers what the prelude's fold answers over a function value, takes as many steps and allocates
//! as much, and allocates nothing per entry.

import std.pace (meter, spent)

fn squares(n: Int) -> Map<Int, Int> = range(0, n).fold(Map::new(), |m, i| m.insert(i, i * i))

fn weighed(m: Map<Int, Int>) -> Int = m.fold(0, |acc: Int, k: Int, v: Int| acc + k * v)

fn weigh(acc: Int, k: Int, v: Int) -> Int = acc + k * v

/// A function value nothing knows the lambda of, which the prelude's fold calls.
fn weighers() -> List<(Int, Int, Int) -> Int> = [weigh]

/// What `f` spends over a map of `n` entries, past making it.
fn spent_on(n: Int, f: (Map<Int, Int>) -> Int) -> { steps: Int, allocations: Int } / {meter.read} = {
  let m = squares(n);
  let s = spent(|| f(m));
  { steps: s.steps, allocations: s.allocations }
}

test "a fold over a lambda answers and spends what one over a function value does" {
  let value = weighers().get(0);
  let by_value = |m: Map<Int, Int>| m.fold(0, value);
  assert_eq(weighed(squares(0)), 0);
  assert_eq(weighed(squares(4)), 36);
  assert_eq(
    handle {
      squares(3).fold(0, |acc: Int, k: Int, v: Int| acc + v / k)
    } with {
      abort.raise(_) -> -1,
    },
    -1,
  );
  // Past a leaf's worth of entries, so the walk finds leaves down the tree.
  [0, 10, 1000].fold((), |_: Unit, n: Int| {
    assert_eq(weighed(squares(n)), by_value(squares(n)));
    assert_eq(spent_on(n, weighed), spent_on(n, by_value))
  });
  assert_eq(spent_on(1000, weighed).allocations, spent_on(10, weighed).allocations)
}
