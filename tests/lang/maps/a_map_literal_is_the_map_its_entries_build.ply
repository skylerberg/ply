// `#{k: v}` is the map `map_of_entries` builds from those entries, and `#[a]` the set whose values
// are `()`. Keys are expressions, and a later entry for a key replaces an earlier one.

fn key() -> String = "b"

test "a map literal holds its entries, in key order" {
  let m = #{"b": 2, "a": 1, key(): 3};
  assert_eq(map_entries(m), [{ key: "a", value: 1 }, { key: "b", value: 3 }]);
  let none: Map<Int, Int> = #{};
  assert_eq(map_len(none), 0)
}

test "a set literal keeps each element once, in order" {
  let s = #[3, 1, 3];
  assert_eq(map_keys(s), [1, 3]);
  assert_eq(map_values(s), [(), ()])
}

test "literals nest and compare as the maps they are" {
  let m = #{1: #[2, 3], 4: #[]};
  assert_eq(map_get(m, 1), Some(#[3, 2]));
  assert_eq(m, map_of_entries([{ key: 4, value: map_new() }, { key: 1, value: #[2, 3] }]))
}
