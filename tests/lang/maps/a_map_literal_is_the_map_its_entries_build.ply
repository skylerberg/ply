import std.set

fn key() -> String = "b"

test "a map literal contains its entries in key order, and a later duplicate key replaces the earlier value" {
  let m = #{"b": 2, "a": 1, key(): 3};
  assert_eq(m.entries(), [{ key: "a", value: 1 }, { key: "b", value: 3 }]);
  let none: Map<Int, Int> = #{};
  assert_eq(none.len(), 0)
}

test "a set literal contains each element once, in order" {
  let s = #[3, 1, 3];
  assert_eq(s.elements(), [1, 3]);
  assert_eq(s, Set::of_list([1, 3]))
}

test "map and set literals can be nested, and equal literals compare equal" {
  let m = #{1: #[2, 3], 4: #[]};
  assert_eq(m.get(1), Some(#[3, 2]));
  assert_eq(m, Map::of_entries([{ key: 4, value: Set::empty() }, { key: 1, value: #[2, 3] }]))
}
