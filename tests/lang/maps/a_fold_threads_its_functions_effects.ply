effect log {
  write note[out](line: String) -> Unit
}

fn shout(m: Map<String, Int>) -> Int / {log.write[out]} =
  m.fold(0, |accumulator, k, v| {
    log.note[out](k);
    accumulator + v
  })

test "folding a map with a function that logs performs the log effect" {
  handle {
    assert_eq(shout(Map::new().insert("a", 1).insert("b", 2)), 3)
  } with {
    log.note[out](line) -> (),
  }
}
