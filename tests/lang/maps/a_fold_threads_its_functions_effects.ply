effect log {
  write note[out](line: String) -> Unit
}

fn shout(m: Map<String, Int>) -> Int / {log.write[out]} =
  m.fold(0, |acc, k, v| {
    log.note[out](k);
    acc + v
  })

test "the effect the folded function performs is among the effects" {
  handle {
    assert_eq(shout(Map::new().insert("a", 1).insert("b", 2)), 3)
  } with {
    log.note[out](line) -> (),
  }
}
