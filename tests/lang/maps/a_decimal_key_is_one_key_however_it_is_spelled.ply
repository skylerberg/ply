fn string_of_keys(m: Map<Decimal, Int>) -> String =
  m.keys().map(Decimal::to_string).fold("", String::concat)

test "two spellings of one decimal are one map key, and the map keeps the spelling it received first" {
  let last = Map::new().insert(1.50m, 1).insert(1.5m, 2);
  let first = Map::new().insert(1.5m, 1).insert(1.50m, 2);
  assert_eq(last, first);
  assert_eq([last.len(), first.len()], [1, 1]);
  assert_eq([last.get(1.500m), first.get(1.5m)], [Some(2), Some(2)]);
  assert_eq(string_of_keys(last), "1.50");
  assert_eq(string_of_keys(first), "1.5");
  assert_eq(string_of_keys(#{2.00m: 1, 2m: 2}), "2.00");
  assert_eq(digest(last), digest(first))
}

type Line = { sku: String, price: Decimal }

fn prices(m: Map<Line, Int>) -> String =
  m.keys().map(|l: Line| l.price.to_string()).fold("", String::concat)

test "a record key containing a decimal is one key under any spelling, and the map keeps the first spelling" {
  let rounded = Map::new().insert({ sku: "bolt", price: 1.50m }, 1).insert(
    { sku: "bolt", price: 1.5m },
    2,
  );
  let exact = Map::new().insert({ sku: "bolt", price: 1.5m }, 1).insert(
    { sku: "bolt", price: 1.50m },
    2,
  );
  assert_eq(rounded.len(), 1);
  assert_eq(prices(rounded), "1.50");
  assert_eq(prices(exact), "1.5");
  assert_eq(rounded.get({ sku: "bolt", price: 1.5m }), Some(2))
}

const spelled: Map<Decimal, String> = #{1.50m: "a", 2.000m: "b", 3m: "c"}

test "a decimal key of a constant map reads back as it was spelled" {
  assert_eq(spelled.keys().map(Decimal::to_string), ["1.50", "2.000", "3"]);
  assert_eq(spelled.insert(2m, "d").keys().map(Decimal::to_string), ["1.50", "2.000", "3"])
}
