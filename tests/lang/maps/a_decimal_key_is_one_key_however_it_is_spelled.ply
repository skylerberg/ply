fn string_of_keys(m: Map<Decimal, Int>) -> String =
  m.keys().map(Decimal::to_string).fold("", String::concat)

test "two spellings of one decimal are one key, read back in one spelling" {
  let last = Map::new().insert(1.50m, 1).insert(1.5m, 2);
  let first = Map::new().insert(1.5m, 1).insert(1.50m, 2);
  assert_eq(last, first);
  assert_eq(string_of_keys(last), "1.5");
  assert_eq(string_of_keys(first), "1.5")
}

type Line = { sku: String, price: Decimal }

fn prices(m: Map<Line, Int>) -> String =
  m.keys().map(|l: Line| l.price.to_string()).fold("", String::concat)

test "a record key holding a decimal is one key, read back in one spelling" {
  let rounded = Map::new().insert({ sku: "bolt", price: 1.50m }, 1).insert(
    { sku: "bolt", price: 1.5m },
    2,
  );
  let exact = Map::new().insert({ sku: "bolt", price: 1.5m }, 1).insert(
    { sku: "bolt", price: 1.50m },
    2,
  );
  assert_eq(rounded.len(), 1);
  assert_eq(prices(rounded), "1.5");
  assert_eq(prices(exact), "1.5")
}
