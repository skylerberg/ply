//! An insert into a map held once writes the map where it lies: it makes a node only where one
//! splits, so what it allocates grows with the tree's height and not with its entries, where an
//! insert into a map held twice copies the path it walks down and no more.

import std.pace (meter, spent)

fn squares(n: Int) -> Map<Int, Int> =
  range(0, n).fold(Map::new(), |m: Map<Int, Int>, i: Int| m.insert(i * 7919 % n, i))

/// What an insert of a key past every other into `squares(n)` allocates, held once or twice.
fn inserted(n: Int, shared: Bool) -> Int / {meter.read} = {
  let made = spent(|| squares(n).len()).allocations;
  let both = if shared {
    spent(|| {
      let m = squares(n);
      m.insert(n, 0).len() + m.len()
    })
  } else { spent(|| squares(n).insert(n, 0).len()) };
  both.allocations - made
}

test "an insert into a map held once allocates what its splits make, and into a shared one its path" {
  // The larger map's tree is two levels deeper, and holds 320 times the entries.
  let small = inserted(200, false);
  let large = inserted(64000, false);
  assert(large <= small + 4, Some(f"{small} objects at 200 entries, {large} at 64,000"));
  let path = inserted(64000, true);
  assert(path <= 12, Some(f"{path} objects to copy the path down a tree of 64,000 entries"))
}
