fn base() -> Map<String, Int> = Map::new().insert("b", 2).insert("a", 1).insert("c", 3)

test "construction, insert and size" {
  assert_eq(Map::new().len(), 0);
  assert_eq(base().len(), 3);
  assert_eq(base().insert("a", 99).len(), 3)
}

test "keys, values and entries all iterate ascending" {
  assert_eq(base().keys(), ["a", "b", "c"]);
  assert_eq(base().values(), [1, 2, 3]);
  assert_eq(base().entries(), [
    { key: "a", value: 1 },
    { key: "b", value: 2 },
    { key: "c", value: 3 },
  ])
}

test "entries round-trip through a map" { assert_eq(Map::of_entries(base().entries()), base()) }

test "a later entry wins, matching a fold of `Map::insert`" {
  assert_eq(
    Map::of_entries([{ key: "a", value: 1 }, { key: "a", value: 9 }]),
    Map::new().insert("a", 9),
  )
}

test "lookup returns an Option" {
  assert_eq(base().get("a"), Some(1));
  assert_eq(base().get("z"), None);
  assert(base().contains("b"));
  assert(!base().contains("z"))
}

test "removing an absent key is a no-op" {
  assert_eq(base().remove("z"), base());
  assert_eq(base().remove("a").len(), 2);
  assert_eq(base().remove("b").keys(), ["a", "c"])
}

test "the right side wins a shared key in a merge" {
  let left = Map::new().insert("a", 1).insert("b", 2);
  let right = Map::new().insert("b", 20).insert("c", 30);
  assert_eq(left.merge(right).keys(), ["a", "b", "c"]);
  assert_eq(left.merge(right).values(), [1, 20, 30]);
  assert_eq(right.merge(left).values(), [1, 2, 30])
}

test "fold visits entries in ascending key order" {
  assert_eq(base().fold("", |accumulator, k, v| accumulator ++ k ++ v.to_string()), "a1b2c3");
  assert_eq(base().fold(0, |accumulator, k, v| accumulator + v), 6)
}

test "insertion order does not change the value" {
  let forward = Map::new().insert("x", 1).insert("y", 2);
  let backward = Map::new().insert("y", 2).insert("x", 1);
  assert_eq(forward, backward)
}

test "a map nests, as a key and as a value" {
  let inner = Map::new().insert(1, 1);
  let outer = Map::new().insert(inner, "in");
  assert_eq(outer.get(Map::new().insert(1, 1)), Some("in"))
}
