pub type Length = | Metres(Int) | Millimetres(Int)

key for Length by millimetres

fn millimetres(l: Length) -> Int = match l { Metres(n) -> n * 1000, Millimetres(n) -> n }

fn written(l: Length) -> String =
  match l { Metres(n) -> n.to_string() ++ " m", Millimetres(n) -> n.to_string() ++ " mm" }

fn key_texts<v>(m: Map<Length, v>) -> List<String> = m.keys().map(written)

test "inserting an equal key into a map retains the existing key and replaces the value" {
  let m = Map::new().insert(Metres(1), "first").insert(Millimetres(1000), "second");
  assert_eq(m.len(), 1);
  assert_eq(key_texts(m), ["1 m"]);
  assert_eq(m.values(), ["second"]);
  assert_eq(m.get(Millimetres(1000)), Some("second"));
  let other = Map::new().insert(Millimetres(1000), "first").insert(Metres(1), "second");
  assert_eq(key_texts(other), ["1000 mm"]);
  assert_eq(m, other)
}

test "a map literal and `merge` retain the first of two equal keys, and `update` retains the existing key" {
  let literal = #{Metres(2): "a", Millimetres(2000): "b"};
  assert_eq([key_texts(literal), literal.values()], [["2 m"], ["b"]]);
  let merged = #{Millimetres(3000): "x", Metres(4): "w"}.merge(#{Metres(3): "y"});
  assert_eq([key_texts(merged), merged.values()], [["3000 mm", "4 m"], ["y", "w"]]);
  let updated = #{Metres(4): "p"}.update(Millimetres(4000), |v: String| v ++ "!");
  assert_eq([key_texts(updated), updated.values()], [["4 m"], ["p!"]])
}

test "inserting equal keys into a map with two thousand entries retains the existing keys" {
  let m = range(1, 2001).fold(Map::new(), |accumulator: Map<Length, Int>, i: Int|
    accumulator.insert(Metres(i), i));
  let again = range(1, 2001).fold(m, |accumulator: Map<Length, Int>, i: Int|
    accumulator.insert(Millimetres(i * 1000), 0 - i));
  assert_eq(again.len(), 2000);
  assert_eq(key_texts(again), range(1, 2001).map(|i: Int| i.to_string() ++ " m"));
  assert_eq(again.values(), range(1, 2001).map(|i: Int| 0 - i));
  assert_eq(key_texts(m), key_texts(again));
  assert_eq(m.values(), range(1, 2001))
}
