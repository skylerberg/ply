import std.set
import std.set (Set)
import std.show (show)

fn evens(n: Int) -> Set<Int> = Set::of_list(range(0, n)).filter(|x: Int| x % 2 == 0)

fn least<a>(s: Set<a>) -> Option<a> = s.min()

test "a set literal is a `Set`, and shows as it is written" {
  let s: Set<Int> = #[2, 1];
  assert_eq(show(s), "#[1, 2]");
  assert_eq(show(#["b", "a"]), "#[\"a\", \"b\"]");
  assert_eq(show(#[#[1], #[]]), "#[#[], #[1]]");
  assert_eq(f"{#[3]} holds {#[1, 1].size()}", "#[3] holds 1");
  assert_eq(evens(5), #[0, 2, 4]);
  assert_eq(least(#["pear", "fig"]), Some("fig"))
}
