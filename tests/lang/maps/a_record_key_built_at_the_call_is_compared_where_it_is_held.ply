//! A record key the caller builds at the call is compared field by field where it is held: a
//! lookup makes no object of it at any depth of the tree, and an insert makes it once, as the map
//! takes it.

fn pairs(n: Int) -> Map<(Int, Int), Int> =
  range(0, n).fold(Map::new(), |m: Map<(Int, Int), Int>, i: Int| m.insert((i % 97, i), i))

test "a lookup by a record key built at the call makes nothing, however deep the tree" {
  let looked = |n: Int| {
    let m = pairs(n);
    metered(|| match m.get(((n - 1) % 97, n - 1)) { Some(v) -> v, None -> 0 }).allocations
  };
  assert_eq([looked(10), looked(1000), looked(40000)], [0, 0, 0])
}

test "an insert of a record key built at the call makes the key, and what its splits make" {
  let made = |n: Int| metered(|| pairs(n).len()).allocations;
  // A key each, and a leaf for every sixteen or so entries with a branch over every sixteen leaves.
  assert(made(3000) <= 3000 + 3000 / 8, Some(f"{made(3000)} objects for 3,000 entries"));
  assert(made(30000) <= 30000 + 30000 / 8, Some(f"{made(30000)} objects for 30,000 entries"))
}
