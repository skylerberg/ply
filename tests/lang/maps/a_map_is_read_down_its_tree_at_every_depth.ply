type Record = { name: String, n: Int }

fn squares(n: Int) -> Map<Int, Int> =
  range(0, n).fold(Map::new(), |m: Map<Int, Int>, i: Int| m.insert(i * 7 % n, i * i))

fn total(m: Map<Int, Int>) -> Int = m.fold(0, |s: Int, k: Int, v: Int| s + k)

test "every key is found at every depth, and no other" {
  [0, 1, 31, 32, 33, 64, 1100, 40000].fold((), |u: Unit, n: Int| {
    let m = squares(n);
    assert_eq(m.len(), n);
    assert_eq(total(m), n * (n - 1) / 2);
    assert_eq(range(0, n).fold(true, |ok: Bool, k: Int| ok && m.contains(k)), true);
    assert_eq([m.get(0 - 1), m.get(n)], [None, None])
  })
}

test "a walk reads the keys in their order" {
  let m = squares(1100);
  let keys = m.keys();
  assert_eq(keys, range(0, 1100));
  assert_eq(m.values().len(), 1100);
  assert_eq(m.entries().fold(0, |s: Int, e: { key: Int, value: Int }| s + e.key), 1100 * 1099 / 2)
}

test "a map returns the right entries for keys and values of any type, such as strings, records, options and decimals" {
  let words = range(0, 100).fold(Map::new(), |m: Map<String, Record>, i: Int|
    m.insert(i.to_string(), { name: "r", n: i }));
  assert_eq(match words.get("42") { Some(r) -> r.n, None -> 0 - 1 }, 42);
  assert_eq(words.contains("100"), false);
  let maybes = range(0, 40).fold(Map::new(), |m: Map<Int, Option<Int>>, i: Int|
    m.insert(i, if i % 2 == 0 { Some(i) } else { None }));
  assert_eq([maybes.get(38), maybes.get(39), maybes.get(40)], [Some(Some(38)), Some(None), None]);
  let decimals = Map::new().insert(1.50m, "a").insert(2.0m, "b");
  assert_eq([decimals.get(1.5m), decimals.get(2m)], [Some("a"), Some("b")]);
  let keyed = range(0, 100).fold(Map::new(), |m: Map<{ a: Int, b: String }, Int>, i: Int|
    m.insert({ a: i % 7, b: i.to_string() }, i));
  let odd = range(0, 100).fold(keyed, |m: Map<{ a: Int, b: String }, Int>, i: Int|
    if i % 2 == 0 { m.remove({ a: i % 7, b: i.to_string() }) } else { m });
  assert_eq(odd.len(), 50);
  assert_eq(match odd.pop_first() { Some(p) -> [p.key.b, p.value.to_string()], None -> [] }, [
    "21",
    "21",
  ])
}

test "inserts, removes and updates keep every depth's keys in order" {
  [33, 1100, 40000].fold((), |u: Unit, n: Int| {
    let m = squares(n);
    let halved = range(0, n).fold(m, |accumulator: Map<Int, Int>, k: Int|
      if k % 2 == 0 { accumulator.remove(k) } else { accumulator });
    assert_eq(halved.len(), n / 2);
    assert_eq([halved.contains(0), halved.contains(1), halved.get(3) != None], [false, true, true]);
    let bumped = range(0, n).fold(halved, |accumulator: Map<Int, Int>, k: Int|
      accumulator.update(k, |v: Int| v + 1));
    assert_eq(bumped.len(), n / 2);
    assert_eq(total(bumped), total(halved));
    assert_eq(bumped.get(3), match halved.get(3) { Some(v) -> Some(v + 1), None -> None });
    let emptied = range(0, n).fold(bumped, |accumulator: Map<Int, Int>, k: Int|
      accumulator.remove(k));
    assert_eq([emptied.len(), emptied.keys().len()], [0, 0]);
    assert_eq(emptied.insert(5, 6).get(5), Some(6))
  })
}

test "removing or replacing an entry returns a new map and leaves the original map unchanged" {
  let m = squares(1100);
  let fewer = m.remove(700);
  let other = m.insert(700, 0 - 1);
  let bumped = m.update(700, |v: Int| v + 1);
  let was = m.get(700);
  assert(was != None, None);
  assert_eq([fewer.get(700), other.get(700), m.get(700)], [None, Some(0 - 1), was]);
  assert_eq(bumped.get(700), match was { Some(v) -> Some(v + 1), None -> None });
  assert_eq([m.len(), fewer.len(), other.len(), bumped.len()], [1100, 1099, 1100, 1100])
}

test "`first`, `last`, `floor`, `ceiling`, `below`, `above`, `range`, `pop_first` and `pop_last` work on a map with many entries" {
  let m = range(0, 2000).fold(Map::new(), |accumulator: Map<Int, Int>, i: Int|
    accumulator.insert(i * 2, i));
  let key = |e: Option<{ key: Int, value: Int }>| match e { Some(x) -> x.key, None -> 0 - 1 };
  assert_eq([key(m.first()), key(m.last())], [0, 3998]);
  assert_eq(
    [key(m.floor(1001)), key(m.floor(1000)), key(m.ceiling(1001)), key(m.ceiling(1000))],
    [1000, 1000, 1002, 1000],
  );
  assert_eq([key(m.below(1000)), key(m.above(1000)), key(m.below(0)), key(m.above(3998))], [
    998,
    1002,
    0 - 1,
    0 - 1,
  ]);
  let r = m.range(Some(60), false, Some(130), true, 100);
  assert_eq([r.len(), match r.at(0) { Some(e) -> e.key, None -> 0 }], [35, 62]);
  assert_eq(m.range(None, true, Some(10), false, 3).map(|e: { key: Int, value: Int }| e.key), [
    0,
    2,
    4,
  ]);
  assert_eq(m.range(Some(1000), true, None, true, 2000).len(), 1500);
  assert_eq(m.range(Some(100), true, Some(50), true, 10), []);
  let popped = match m.pop_first() { Some(p) -> [p.key, p.rest.len()], None -> [] };
  let dropped = match m.pop_last() { Some(p) -> [p.key, p.rest.len()], None -> [] };
  assert_eq([popped, dropped], [[0, 1999], [3998, 1999]])
}

test "a map with many entries has the right sum of its values and the right length after `remove`, `insert`, `update`, `pop_first`, `pop_last` and `split`" {
  assert_eq(total(squares(1100)), 1100 * 1099 / 2);
  let edited = || {
    let m = squares(1100);
    let fewer = range(0, 1100).fold(m, |accumulator: Map<Int, Int>, k: Int|
      if k % 3 == 0 { accumulator.remove(k) } else { accumulator });
    total(fewer) + total(m) + total(m.insert(5, 0).update(6, |v: Int| v + 1))
  };
  assert_eq(edited(), 3 * (1100 * 1099 / 2) - 3 * (366 * 367 / 2));
  assert_eq(match squares(1100).pop_first() { Some(p) -> p.rest.len(), None -> 0 }, 1099);
  assert_eq(squares(1100).split(500).above.len(), 599);
  let keyed = || {
    let m = range(0, 300).fold(
      Map::new(),
      |accumulator: Map<{ a: Int, b: String }, String>, i: Int|
        accumulator.insert({ a: i % 7, b: i.to_string() }, i.to_string()),
    );
    let fewer = range(0, 300).fold(m, |accumulator: Map<{ a: Int, b: String }, String>, i: Int|
      if i % 3 == 0 { accumulator.remove({ a: i % 7, b: i.to_string() }) } else { accumulator });
    match fewer.pop_last() { Some(p) -> p.key.b.len() + p.value.len() + p.rest.len(), None -> 0 }
  };
  assert(keyed() > 199, None)
}

test "`split` returns the keys below and above the given key at every depth, and leaves the original map unchanged" {
  let m = squares(2000);
  [0, 1, 31, 32, 33, 700, 1999].fold((), |u: Unit, k: Int| {
    let parts = m.split(k);
    assert_eq([parts.below.len(), parts.above.len()], [k, 1999 - k]);
    assert_eq(parts.at, m.get(k));
    assert_eq(parts.below.keys(), range(0, k));
    assert_eq(parts.above.keys(), range(k + 1, 2000));
    assert_eq([parts.below.insert(5000, 1).len(), parts.above.remove(1999).len()], [
      k + 1,
      if k == 1999 { 0 } else { 1998 - k },
    ])
  });
  assert_eq([m.len(), total(m)], [2000, 2000 * 1999 / 2]);
  let past = m.split(5000);
  assert_eq([past.below.len(), past.above.len()], [2000, 0])
}
