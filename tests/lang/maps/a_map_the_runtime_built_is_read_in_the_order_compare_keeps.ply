//! A map handed to the runtime and back, as `observe` hands it, is built again there in the
//! runtime's order of its keys, while `std.prelude` finds a key by `compare` at the key's type. The
//! two orders agree on every kind of key, so each key is found where the runtime placed it and the
//! keys ascend by `compare`.

type Shape = | Square(Int) | Circle(Int) | Dot

fn ascends<k>(keys: List<k>) -> Bool
  where derivable(ord, k)
=
  keys.fold({ ok: true, last: None }, |s: { ok: Bool, last: Option<k> }, x: k|
    {
      ok: s.ok && (match s.last { Some(p) -> compare(p, x) == Less, None -> true }),
      last: Some(x),
    }).ok

/// Whether a map of `keys`, each distinct, that the runtime built again holds each where its reads
/// look for it.
fn placed<k>(keys: List<k>) -> Bool
  where derivable(ord, k)
= {
  let m = observe(Map::of_entries(keys.map(|x: k| { key: x, value: () })));
  m.len() == keys.len() && ascends(m.keys())
    && keys.fold(true, |ok: Bool, x: k| ok && m.contains(x))
}

test "a map of each kind of key finds every key where the runtime placed it" {
  assert(placed([3, 0 - 1, 4000000000000000000, 0, 0 - 7, 9]), None);
  assert(placed(["b", "", "ab", "é", "a", "Z", "aa"]), None);
  assert(placed([b"\x01", b"", b"\xff", b"a\x00", b"a"]), None);
  assert(placed(['z', 'a', 'é', '0']), None);
  assert(placed([true, false]), None);
  assert(placed([()]), None);
  assert(placed([Square(2), Circle(1), Dot, Square(1), Circle(5)]), None);
  assert(placed([{ name: "b", n: 1 }, { name: "a", n: 2 }, { name: "a", n: 1 }]), None);
  assert(placed([(2, "a"), (1, "b"), (1, "a")]), None);
  assert(placed([Some(3), None, Some(0 - 1)]), None);
  assert(placed([Ok(1), Err("e"), Ok(0 - 2), Err("a")]), None);
  assert(placed([[2, 1], [1], [], [1, 2]]), None);
  assert(placed([2.5m, 1.0m, 0.0m - 3.25m, 0.001m]), None);
  assert(placed(range(0, 1100).map(|i: Int| i * 7919 % 1100)), None)
}
