type Point = { x: Int, y: Int }

type Shape = | Dot | Line(Int) | Rect({ w: Int, h: Float })

fn column(n: Int) -> Map<Point, Decimal> =
  range(0, n).fold(Map::new(), |m: Map<Point, Decimal>, i: Int|
    m.insert({ x: 0, y: i }, Decimal::of_int(i) * 0.5m))

fn shapes(n: Int) -> Map<Int, Shape> =
  range(0, n).fold(Map::new(), |m: Map<Int, Shape>, i: Int|
    m.insert(i, if i % 2 == 0 { Line(i) } else { Rect({ w: i, h: 0.5 }) }))

fn wides(n: Int) -> Map<I128, Point> =
  range(0, n).fold(Map::new(), |m: Map<I128, Point>, i: Int|
    m.insert(I128::of_int(i) * 1000000000000i128, { x: i, y: 0 - i }))

fn corners() -> Map<Point, Decimal> =
  Map::new().insert({ x: 0, y: 0 }, 1.5m).insert({ x: 1, y: 1 }, 2.25m)

test "a map with record keys and Decimal values stores and returns both correctly at every tree depth" {
  let m = column(1100);
  assert_eq(m.len(), 1100);
  assert_eq([m.get({ x: 0, y: 33 }), m.get({ x: 0, y: 1099 }), m.get({ x: 1, y: 33 })], [
    Some(16.5m),
    Some(549.5m),
    None,
  ]);
  assert_eq(m.remove({ x: 0, y: 33 }).get({ x: 0, y: 33 }), None);
  assert_eq(m.remove({ x: 0, y: 33 }).len(), 1099);
  assert_eq(m.insert({ x: 0, y: 33 }, 1m).get({ x: 0, y: 33 }), Some(1m));
  assert_eq(m.get({ x: 0, y: 33 }), Some(16.5m));
  assert_eq(m.first(), Some({ key: { x: 0, y: 0 }, value: 0.0m }));
  assert_eq(column(40), column(40))
}

test "a map with sum type values or 128-bit integer keys stores and returns each correctly" {
  let s = shapes(200);
  assert_eq([s.get(150), s.get(151), s.get(200)], [
    Some(Line(150)),
    Some(Rect({ w: 151, h: 0.5 })),
    None,
  ]);
  assert_eq(s.remove(150).len(), 199);
  let w = wides(70);
  assert_eq(w.get(69000000000000i128), Some({ x: 69, y: -69 }));
  assert_eq(w.get(1i128), None)
}

test "a constant map of record keys and Decimal values is laid out as the code reads it" {
  assert_eq(corners().get({ x: 1, y: 1 }), Some(2.25m));
  assert_eq(corners().insert({ x: 2, y: 2 }, 3m).len(), 3)
}

test "`len` stays correct as entries are removed or replaced in maps with record, Decimal or sum type values" {
  assert_eq(column(300).remove({ x: 0, y: 7 }).len(), 299);
  assert_eq(shapes(300).insert(5, Dot).len(), 300)
}
