// A task of the run's scheduler performs against the handles around its `task.spawn`, as they stood
// at the spawn, though the spawner has left them by the time the task asks.

effect ask {
  read get() -> Int
}

fn now() -> Int / {clock.read} = match clock.now() { Instant(at) -> at }

// The scheduler runs a spawned task first, so the task yields to the spawner, which reads the clock
// once its `handle` has ended and joins; the task reads the clock after that, and is still
// handled by the clause around its spawn.
test/nondet "a task is handled by the handle around its spawn after that handle ended" {
  let t = handle {
    task.spawn(|| {
      task.yield();
      (now(), ask.get())
    })
  } with {
    ask.get() -> 7,
  };
  let ended = now();
  let returned = task.join(t);
  assert(ended <= returned._0, None);
  assert_eq(returned._1, 7)
}
