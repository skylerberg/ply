pub type Choice = | Equal | Less | Greater | Some(Int) | None | Ok | Err

pub type Count = | Count(Int)

pub type Width = | Width(U8)

pub type Real = | Real(Float)

pub type Exact = | Exact(Decimal)

pub type Letter = | Letter(Char)

pub type Truth = | Truth(Bool)

pub type Name = | Name(Bytes)

pub type Text = | Text(String)

pub fn order_names(a: Name, b: Name) -> Ordering = compare(a, b)

pub fn order_maybe(a: Option<Name>, b: Option<Name>) -> Ordering = compare(a, b)

pub fn order_either(a: Result<Name, Int>, b: Result<Name, Int>) -> Ordering = compare(a, b)

pub fn same_either(a: Result<Name, Int>, b: Result<Name, Int>) -> Bool = a == b

pub fn order_listed(a: List<Name>, b: List<Name>) -> Ordering = compare(a, b)
