//! Definitions under the names the prelude has, which a module that imports them uses instead.

pub fn range(lo: Int, hi: Int) -> List<Int> = [lo]

pub fn compare(a: Int, b: Int) -> Int = 7

pub fn min(a: Int, b: Int) -> Int = 0 - 1

/// `Equal` is the prelude's `Ordering`'s name too.
pub type Verdict = | Apart | Equal

pub fn verdict(a: Int, b: Int) -> Verdict = if a == b { Equal } else { Apart }

pub fn agreed(v: Verdict) -> Bool = match v { Equal -> true, Apart -> false }
