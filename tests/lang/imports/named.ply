pub fn range(lo: Int, hi: Int) -> List<Int> = [lo]

pub fn compare(a: Int, b: Int) -> Int = 7

pub fn min(a: Int, b: Int) -> Int = 0 - 1

pub type Verdict = | Different | Equal

pub fn verdict(a: Int, b: Int) -> Verdict = if a == b { Equal } else { Different }

pub fn agreed(v: Verdict) -> Bool = match v { Equal -> true, Different -> false }
