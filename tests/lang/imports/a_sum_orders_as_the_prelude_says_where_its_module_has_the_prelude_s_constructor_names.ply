//! A sum whose module declares constructors under the names the prelude's `Ordering`, `Option` and
//! `Result` have is compared, ordered and kept as a map's or a set's key as the prelude's say: a
//! value against itself, as a key a map hands back is, among them.

import std.set
import std.set (Set)
import imports.shadowing (Count, Width, Real, Exact, Letter, Truth, Name, Text, order_names,
                          order_maybe, order_either, same_either, order_listed)

/// A fresh object of `b`'s bytes.
fn made(b: Bytes) -> Bytes = b.concat(b"")

/// `x` against itself, against an equal copy and against the one after it, and that one against `x`.
fn ordered<a>(x: a, copy: a, after: a) -> List<Ordering>
  where derivable(ord, a)
= [compare(x, x), compare(x, copy), compare(x, after), compare(after, x)]

/// Whether a map of `xs` finds each key it hands back, and holds as many once each is put again.
fn keyed<a>(xs: List<a>) -> Bool
  where derivable(ord, a)
= {
  let m = xs.fold(Map::new(), |acc: Map<a, Int>, x: a| acc.insert(x, 1));
  m.keys().all(|k: a| m.contains(k))
    && m.fold(m, |acc: Map<a, Int>, k: a, _: Int| acc.insert(k, 2)).len() == xs.len()
}

/// Whether a set of `xs` holds each element it lists, and each of `xs` once.
fn held<a>(xs: List<a>) -> Bool
  where derivable(ord, a)
= {
  let s = Set::of_list(xs);
  s.elements().all(|x: a| s.contains(x)) && s.size() == xs.len()
}

test "a sum of one case over a scalar or bytes orders as the prelude's `Ordering` says" {
  let order = [Equal, Equal, Less, Greater];
  assert_eq(ordered(Count(1), Count(1), Count(2)), order);
  assert_eq(ordered(Width(1u8), Width(1u8), Width(2u8)), order);
  assert_eq(ordered(Exact(1.5m), Exact(1.5m), Exact(2.5m)), order);
  assert_eq(ordered(Letter('a'), Letter('a'), Letter('b')), order);
  assert_eq(ordered(Truth(false), Truth(false), Truth(true)), order);
  assert_eq(ordered(Name(made(b"a")), Name(made(b"a")), Name(made(b"b"))), order);
  assert_eq(ordered(Text("a"), Text("a" ++ ""), Text("b")), order);
  let half = 0.5;
  assert(Real(half) == Real(half) && Real(half * 2.0) == Real(1.0) && Real(half) != Real(1.0))
}

test "a sum of one case keys a map and a set, each key it hands back found again" {
  assert(keyed([Count(2), Count(1)]) && held([Count(2), Count(1)]));
  assert(keyed([Width(2u8), Width(1u8)]) && held([Width(2u8), Width(1u8)]));
  assert(keyed([Exact(2.5m), Exact(1.5m)]) && held([Exact(2.5m), Exact(1.5m)]));
  assert(keyed([Letter('b'), Letter('a')]) && held([Letter('b'), Letter('a')]));
  assert(keyed([Truth(true), Truth(false)]) && held([Truth(true), Truth(false)]));
  assert(keyed([Name(made(b"b")), Name(made(b"a"))]) && held([Name(made(b"b")), Name(made(b"a"))]));
  assert(keyed([Text("b"), Text("a")]) && held([Text("b"), Text("a")]));
  let name = Name(made(b"a"));
  assert(keyed([Some(name), None]) && held([Some(name), None]));
  assert(keyed([Ok(name), Err(1)]) && held([Ok(name), Err(1)]))
}

test "a sum of one case sorts as the prelude orders it" {
  assert_eq([Count(3), Count(1), Count(2)].sort(), [Count(1), Count(2), Count(3)]);
  assert_eq([Letter('c'), Letter('a'), Letter('b')].sort(), [
    Letter('a'),
    Letter('b'),
    Letter('c'),
  ]);
  assert_eq([Name(made(b"b")), Name(made(b"a")), Name(made(b"b"))].sort(), [
    Name(b"a"),
    Name(b"b"),
    Name(b"b"),
  ])
}

test "an Option, a Result and a list of one order as the prelude's say in its module" {
  let a = Name(made(b"a"));
  let b = Name(made(b"b"));
  assert_eq(order_names(a, a), Equal);
  assert_eq(
    [order_maybe(Some(a), Some(a)), order_maybe(None, Some(a)), order_maybe(Some(b), Some(a))],
    [Equal, Less, Greater],
  );
  assert_eq(
    [order_either(Ok(a), Ok(a)), order_either(Err(1), Ok(a)), order_either(Ok(a), Err(1))],
    [Equal, Less, Greater],
  );
  assert(same_either(Ok(a), Ok(a)) && !same_either(Ok(a), Err(1)));
  assert_eq([order_listed([a, b], [a, b]), order_listed([a], [a, b]), order_listed([b], [a, b])], [
    Equal,
    Less,
    Greater,
  ])
}
