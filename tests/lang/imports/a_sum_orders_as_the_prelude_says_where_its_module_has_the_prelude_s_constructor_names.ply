import std.set
import std.set (Set)
import imports.shadowing (Count, Width, Real, Exact, Letter, Truth, Name, Text, order_names,
                          order_maybe, order_either, same_either, order_listed)

fn fresh_copy(b: Bytes) -> Bytes = b.concat(b"")

fn ordered<a>(x: a, copy: a, after: a) -> List<Ordering>
  where derivable(ord, a)
= [compare(x, x), compare(x, copy), compare(x, after), compare(after, x)]

fn map_roundtrip<a>(xs: List<a>) -> Bool
  where derivable(ord, a)
= {
  let m = xs.fold(Map::new(), |accumulator: Map<a, Int>, x: a| accumulator.insert(x, 1));
  m.keys().all(|k: a| m.contains(k))
    && m.fold(m, |accumulator: Map<a, Int>, k: a, _: Int| accumulator.insert(k, 2)).len()
    == xs.len()
}

fn set_roundtrip<a>(xs: List<a>) -> Bool
  where derivable(ord, a)
= {
  let s = Set::of_list(xs);
  s.elements().all(|x: a| s.contains(x)) && s.size() == xs.len()
}

test "a sum of one case over a scalar or bytes orders as the prelude's `Ordering` says" {
  let order = [Equal, Equal, Less, Greater];
  assert_eq(ordered(Count(1), Count(1), Count(2)), order);
  assert_eq(ordered(Width(1u8), Width(1u8), Width(2u8)), order);
  assert_eq(ordered(Exact(1.5m), Exact(1.5m), Exact(2.5m)), order);
  assert_eq(ordered(Letter('a'), Letter('a'), Letter('b')), order);
  assert_eq(ordered(Truth(false), Truth(false), Truth(true)), order);
  assert_eq(ordered(Name(fresh_copy(b"a")), Name(fresh_copy(b"a")), Name(fresh_copy(b"b"))), order);
  assert_eq(ordered(Text("a"), Text("a" ++ ""), Text("b")), order);
  let half = 0.5;
  assert(Real(half) == Real(half) && Real(half * 2.0) == Real(1.0) && Real(half) != Real(1.0))
}

test "a sum with one case can be a key in a map and a set, and each key is found again when read back" {
  assert(map_roundtrip([Count(2), Count(1)]) && set_roundtrip([Count(2), Count(1)]));
  assert(map_roundtrip([Width(2u8), Width(1u8)]) && set_roundtrip([Width(2u8), Width(1u8)]));
  assert(map_roundtrip([Exact(2.5m), Exact(1.5m)]) && set_roundtrip([Exact(2.5m), Exact(1.5m)]));
  assert(map_roundtrip([Letter('b'), Letter('a')]) && set_roundtrip([Letter('b'), Letter('a')]));
  assert(map_roundtrip([Truth(true), Truth(false)]) && set_roundtrip([Truth(true), Truth(false)]));
  assert(
    map_roundtrip([Name(fresh_copy(b"b")), Name(fresh_copy(b"a"))])
      && set_roundtrip([Name(fresh_copy(b"b")), Name(fresh_copy(b"a"))]),
  );
  assert(map_roundtrip([Text("b"), Text("a")]) && set_roundtrip([Text("b"), Text("a")]));
  let name = Name(fresh_copy(b"a"));
  assert(map_roundtrip([Some(name), None]) && set_roundtrip([Some(name), None]));
  assert(map_roundtrip([Ok(name), Err(1)]) && set_roundtrip([Ok(name), Err(1)]))
}

test "a sum of one case sorts as the prelude orders it" {
  assert_eq([Count(3), Count(1), Count(2)].sort(), [Count(1), Count(2), Count(3)]);
  assert_eq([Letter('c'), Letter('a'), Letter('b')].sort(), [
    Letter('a'),
    Letter('b'),
    Letter('c'),
  ]);
  assert_eq([Name(fresh_copy(b"b")), Name(fresh_copy(b"a")), Name(fresh_copy(b"b"))].sort(), [
    Name(b"a"),
    Name(b"b"),
    Name(b"b"),
  ])
}

test "comparing `Option`, `Result` and list values in a module that reuses the prelude's constructor names gives `Equal`, `Less` or `Greater` as the prelude does" {
  let a = Name(fresh_copy(b"a"));
  let b = Name(fresh_copy(b"b"));
  assert_eq(order_names(a, a), Equal);
  assert_eq(
    [order_maybe(Some(a), Some(a)), order_maybe(None, Some(a)), order_maybe(Some(b), Some(a))],
    [Equal, Less, Greater],
  );
  assert_eq(
    [order_either(Ok(a), Ok(a)), order_either(Err(1), Ok(a)), order_either(Ok(a), Err(1))],
    [Equal, Less, Greater],
  );
  assert(same_either(Ok(a), Ok(a)) && !same_either(Ok(a), Err(1)));
  assert_eq([order_listed([a, b], [a, b]), order_listed([a], [a, b]), order_listed([b], [a, b])], [
    Equal,
    Less,
    Greater,
  ])
}
