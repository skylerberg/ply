//! A constructor is the one its own import names, even where a module imported before it declares
//! a constructor of the same name.

import imports.skips (Panicked, skipped_code)
import imports.colours (Nondet, Other, code)

test "the imported constructor is the one that was imported" {
  assert_eq(code(Nondet), 11);
  assert_eq(code(Other), 12);
  assert_eq(skipped_code(Panicked), 22)
}
