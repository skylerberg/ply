//! A constructor imported by name is the imported one wherever the importing module builds or
//! matches it, though the prelude has a constructor of that name too.

import imports.named (Verdict, Apart, Equal, verdict, agreed)

fn told(v: Verdict) -> String = match v { Equal -> "equal", Apart -> "apart" }

test "a constructor built here is the one its module matches" {
  assert(agreed(Equal));
  assert(!agreed(Apart));
  assert_eq([Apart, Equal].map(agreed), [false, true])
}

test "a constructor its module built is the one matched here" {
  assert_eq(told(verdict(2, 2)), "equal");
  assert_eq(told(verdict(2, 3)), "apart");
  assert_eq(told(Equal), "equal")
}

test "a constructor built here equals the one its module built" {
  assert_eq(verdict(2, 2), Equal);
  assert(verdict(2, 3) != Equal)
}
