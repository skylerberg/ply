type Shape = | Circle(Int) | Square(Int, String) | Dot

fn same<a>(x: a, y: a) -> Bool = x == y

fn differ<a>(x: a, y: a) -> Bool = x != y

fn order<a>(x: a, y: a) -> Ordering
  where derivable(ord, a)
= compare(x, y)

fn counted<a>(xs: List<a>, x: a) -> Int = xs.fold(0, |n: Int, y: a| if y == x { n + 1 } else { n })

fn least<a>(xs: List<a>, first: a) -> a
  where derivable(ord, a)
= xs.fold(first, |m: a, y: a| if compare(y, m) == Less { y } else { m })

fn same_lists<a>(xs: List<a>, ys: List<a>) -> Bool = same(xs, ys)

test "a generic definition compares sums, strings, records and lists with the equality of their actual types" {
  assert(same(Circle(1), Circle(1)), None);
  assert(!same(Circle(1), Circle(2)), None);
  assert(differ(Square(1, "a"), Square(1, "b")), None);
  assert(same(Dot, Dot), None);
  assert(same("abc", "ab" ++ "c"), None);
  assert(!same("abc", "abd"), None);
  assert(same({ x: 1, label: "p" }, { x: 1, label: "p" }), None);
  assert(differ({ x: 1, label: "p" }, { x: 1, label: "q" }), None);
  assert(same_lists([Dot, Circle(2)], [Dot, Circle(2)]), None);
  assert(!same_lists([Dot], [Circle(2)]), None);
  assert_eq(counted([Dot, Circle(2), Dot], Dot), 2);
  assert_eq(counted(["a", "b", "a"], "a"), 2)
}

test "a generic definition orders sums, strings and records with the ordering of their actual types" {
  assert_eq(order(Circle(1), Square(0, "")), Less);
  assert_eq(order(Square(2, "a"), Square(1, "z")), Greater);
  assert_eq(order("b", "ab"), Greater);
  assert_eq(order({ x: 1, label: "b" }, { x: 1, label: "a" }), Greater);
  assert_eq(least([Square(1, "a"), Dot, Circle(9)], Dot), Circle(9));
  assert_eq(least(["pear", "apple", "fig"], "zz"), "apple")
}
