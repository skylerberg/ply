// A declared type takes a row parameter, so a type that holds a function leaves that function's
// row to whoever uses it. Here a sequence of a file's chunks carries the read it performs from the
// step that performs it to the `handle` that answers it.

import std.fs (fs)
import type_parameters.seq (Seq, empty, mapped, of_list, take)

// Each step reads the next `size` bytes of `path` under the root `l`. Where the file ends is the
// file's to say, so nothing bounds the steps: `diverges` is in the row with the read.
fn chunks<[l]>(
  path: String,
  from: Int,
  size: Int,
) -> Seq<Bytes | {fs.read_at[l], diverges}> / {diverges} =
  Seq(||
    match fs.read_at[l](path, from, size) {
      None -> None,
      Some(chunk) -> if bytes_len(chunk) == 0 { None }
      else { Some({ value: chunk, next: chunks[l](path, from + bytes_len(chunk), size) }) },
    })

fn lengths<| e>(s: Seq<Bytes | e>) -> Seq<Int | {diverges | e}> / {diverges} =
  mapped(s, |b: Bytes| bytes_len(b))

// The file a test serves in place of the disk.
fn served(body: Bytes, offset: Int, len: Int) -> Option<Bytes> / {abort.raise} =
  if offset >= bytes_len(body) { Some(b"") }
  else { Some(bytes_slice(body, offset, min(offset + len, bytes_len(body)))) }

test "a sequence over a list performs nothing, and needs no handler" {
  let s: Seq<Int | {}> = of_list([1, 2, 3]);
  assert_eq(take(s, 2), [1, 2]);
  assert_eq(take(s, 5), [1, 2, 3]);
  let none: Seq<Int | {}> = empty();
  assert_eq(take(none, 1), [])
}

test "a sequence of a file's chunks performs its reads where it is stepped" {
  let body = b"a lazy sequence";
  let got = with_cell[reads](0) { count -> {
    let chunked = handle {
      take(chunks[src]("notes.txt", 0, 4), 3)
    } with {
      fs.read_at[src](_path, offset, len) -> {
        cell_set(count, cell_get(count) + 1);
        served(body, offset, len)
      },
    };
    { chunks: chunked, reads: cell_get(count) }
  } };
  assert_eq(got.chunks, [b"a la", b"zy s", b"eque"]);
  assert_eq(got.reads, 3)
}

test "a sequence built from another keeps the row it was given" {
  let body = b"a lazy sequence";
  let sizes = handle {
    take(lengths(chunks[src]("notes.txt", 0, 6)), 9)
  } with {
    fs.read_at[src](_path, offset, len) -> served(body, offset, len),
  };
  assert_eq(sizes, [6, 6, 3])
}
