import type_parameters.seq (Seq, Step, mapped, take)

type SyntaxError = { line: Int, reason: String }

effect toml {
  raise syntax(e: SyntaxError)
  raise eof()
}

fn digit(b: Int, line: Int) -> Int / {toml.syntax} =
  if b >= 48 && b <= 57 { b - 48 } else { toml.syntax({ line: line, reason: "not a digit" }) }

fn digits(bs: List<Int>, line: Int) -> Seq<Int | {toml.syntax}> = {
  let step: Step<Int | {toml.syntax}> = ||
    match bs {
      [] -> None,
      [b, ..rest] -> Some({ value: digit(b, line), next: digits(rest, line + 1) }),
    };
  Seq(step)
}

fn read(bs: List<Int>) -> Result<List<Int>, SyntaxError> = try { take(digits(bs, 1), 9) }

test "a sequence whose effects name a raise is handled by the try around its steps" {
  assert_eq(read([49, 50, 51]), Ok([1, 2, 3]));
  assert_eq(read([49, 7, 51]), Err({ line: 2, reason: "not a digit" }))
}

test "building the sequence raises nothing, and each step raises where it is taken" {
  let s = digits([49, 7], 1);
  assert_eq(try { take(s, 1) }, Ok([1]));
  assert_eq(try { take(s, 2) }, Err({ line: 2, reason: "not a digit" }))
}

fn some_digits(bs: List<Int>) -> Seq<Int | {toml.syntax, toml.eof}> = {
  let step: Step<Int | {toml.syntax, toml.eof}> = ||
    match bs {
      [] -> toml.eof(),
      [b, ..rest] -> Some({ value: digit(b, 1), next: some_digits(rest) }),
    };
  Seq(step)
}

test "`try[toml.eof]` handles only `toml.eof` raises, even when a sequence's effects list also contains `toml.syntax`" {
  let ended = try[toml.eof] { try[toml.syntax] { take(some_digits([49]), 9) } };
  assert_eq(ended, Err(()));
  let rejected = try[toml.eof] { try[toml.syntax] { take(some_digits([7]), 9) } };
  assert_eq(rejected, Ok(Err({ line: 1, reason: "not a digit" })))
}

type Parser<a> = () -> a / {toml.syntax}

fn twice(p: Parser<Int>) -> Int / {toml.syntax} = p() + p()

test "an alias whose expansion names a raise is a function that raises it" {
  assert_eq(try { twice(|| digit(50, 1)) }, Ok(4));
  assert_eq(try { twice(|| digit(1, 3)) }, Err({ line: 3, reason: "not a digit" }))
}

test "a raise from a sequence's source passes through `mapped` to the enclosing `try`, because the effects are a type parameter" {
  let doubled = mapped(digits([49, 7], 1), |n: Int| n * 2);
  assert_eq(try { take(doubled, 1) }, Ok([2]));
  assert_eq(try { take(doubled, 2) }, Err({ line: 2, reason: "not a digit" }))
}
