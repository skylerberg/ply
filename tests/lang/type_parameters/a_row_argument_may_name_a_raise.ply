//! A raise is an atom as any operation is, so a type's row argument may name one. A sequence whose
//! steps parse as they go carries the raise from the step that performs it to the `try` around
//! whoever takes that step.

import type_parameters.seq (Seq, Step, mapped, take)

type SyntaxError = { line: Int, why: String }

effect toml {
  raise syntax(e: SyntaxError)
  raise eof()
}

fn digit(b: Int, line: Int) -> Int / {toml.syntax} =
  if b >= 48 && b <= 57 { b - 48 } else { toml.syntax({ line: line, why: "not a digit" }) }

/// Each step parses one byte, so the sequence's row is the parser's.
fn digits(bs: List<Int>, line: Int) -> Seq<Int | {toml.syntax}> = {
  let step: Step<Int | {toml.syntax}> = ||
    match bs {
      [] -> None,
      [b, ..rest] -> Some({ value: digit(b, line), next: digits(rest, line + 1) }),
    };
  Seq(step)
}

fn read(bs: List<Int>) -> Result<List<Int>, SyntaxError> = try { take(digits(bs, 1), 9) }

test "a sequence whose row names a raise is answered by the try around its steps" {
  assert_eq(read([49, 50, 51]), Ok([1, 2, 3]));
  assert_eq(read([49, 7, 51]), Err({ line: 2, why: "not a digit" }))
}

test "building the sequence raises nothing, and each step raises where it is taken" {
  let s = digits([49, 7], 1);
  assert_eq(try { take(s, 1) }, Ok([1]));
  assert_eq(try { take(s, 2) }, Err({ line: 2, why: "not a digit" }))
}

/// Two raises in one row argument: a sequence that must hold a digit raises `eof` for an empty one.
fn some_digits(bs: List<Int>) -> Seq<Int | {toml.syntax, toml.eof}> = {
  let step: Step<Int | {toml.syntax, toml.eof}> = ||
    match bs {
      [] -> toml.eof(),
      [b, ..rest] -> Some({ value: digit(b, 1), next: some_digits(rest) }),
    };
  Seq(step)
}

test "a try names the raise it answers among those a row argument holds" {
  let ended = try[toml.eof] { try[toml.syntax] { take(some_digits([49]), 9) } };
  assert_eq(ended, Err(()));
  let refused = try[toml.eof] { try[toml.syntax] { take(some_digits([7]), 9) } };
  assert_eq(refused, Ok(Err({ line: 1, why: "not a digit" })))
}

type Parsed<a> = () -> a / {toml.syntax}

fn twice(p: Parsed<Int>) -> Int / {toml.syntax} = p() + p()

test "an alias whose expansion names a raise is a function that raises it" {
  assert_eq(try { twice(|| digit(50, 1)) }, Ok(4));
  assert_eq(try { twice(|| digit(1, 3)) }, Err({ line: 3, why: "not a digit" }))
}

test "a row variable carries a raise through the type that holds it" {
  let doubled = mapped(digits([49, 7], 1), |n: Int| n * 2);
  assert_eq(try { take(doubled, 1) }, Ok([2]));
  assert_eq(try { take(doubled, 2) }, Err({ line: 2, why: "not a digit" }))
}
