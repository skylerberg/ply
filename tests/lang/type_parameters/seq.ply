// A lazy sequence. Each step is a function that answers the next element and the rest, or the
// end, and the sequence takes its steps' row as a parameter: one declaration serves a list held in
// memory and a file read a chunk at a time.

pub type Step<a | e> = () -> Option<{ value: a, next: Seq<a | e> }> / e

pub type Seq<a | e> = | Seq(Step<a | e>)

pub fn next<a | e>(s: Seq<a | e>) -> Option<{ value: a, next: Seq<a | e> }> / e =
  match s { Seq(step) -> step() }

// `Step` is an alias, so the annotation is where a step that performs nothing meets the row the
// sequence is given. `Seq` is a sum, whose row is exact: `Seq(|| None)` is a `Seq<a | {}>`.
pub fn empty<a | e>() -> Seq<a | e> = {
  let step: Step<a | e> = || None;
  Seq(step)
}

pub fn of_list<a | e>(xs: List<a>) -> Seq<a | e> = {
  let step: Step<a | e> = ||
    match xs { [] -> None, [x, ..rest] -> Some({ value: x, next: of_list(rest) }) };
  Seq(step)
}

// The first `n` elements, which performs whatever the steps it takes do.
pub fn take<a | e>(s: Seq<a | e>, n: Int) -> List<a> / e = taken(s, n, [])

fn taken<a | e>(s: Seq<a | e>, n: Int, got: List<a>) -> List<a> / e =
  if n <= 0 { got }
  else { match next(s) { None -> got, Some(x) -> taken(x.next, n - 1, push(got, x.value)) } }

// A step of the answer calls back into `mapped`, which nothing bounds: the sequence may be
// endless, and its row says so beside the row it was given.
pub fn mapped<a, b | e>(s: Seq<a | e>, f: (a) -> b / e) -> Seq<b | {diverges | e}> / {diverges} =
  Seq(||
    match next(s) { None -> None, Some(x) -> Some({ value: f(x.value), next: mapped(x.next, f) }) })
