// A use writes its row arguments after a `|` inside the type's own `<..>`, so the bar is never
// the one that parts a sum's variants, an or-pattern's alternatives or a lambda's parameters, and
// the row ends at the `>` that closes its type however many close with it.

type Seq<a | e> = | Seq(() -> Option<a> / e) | Two(Seq<a | e>, Seq<a | e>) | End

type Holder =
  | One(Seq<Int | {}>)
  | Many(List<Seq<Int | {}>>)
  | Keyed(Map<Int, List<Seq<Int | {}>>>)

fn count(h: Holder) -> Int = match h { One(_) | Many(_) -> 1, Keyed(m) -> map_len(m) }

fn first(s: Seq<Int | {}>) -> Int =
  match s { Seq(f) -> match f() { Some(n) -> n, None -> 0 }, Two(a, _) -> first(a), End -> 0 }

test "a row argument sits among a sum's bars, nested closers, an or-pattern and a lambda's bars" {
  let pick = |s: Seq<Int | {}>, n: Int| first(s) + n;
  let one: Seq<Int | {}> = Seq(|| Some(4));
  assert_eq(pick(Two(one, End), 1), 5);
  assert_eq(count(One(one)), 1);
  assert_eq(count(Many([one])), 1);
  assert_eq(count(Keyed(map_insert(map_new(), 1, [one]))), 1);
  let both: List<Seq<Int | {}>> = [one, End];
  assert_eq(len(both), 2)
}
