import std.fs (fs)
import type_parameters.seq (Seq, empty, mapped, of_list, take)

fn chunks<[l]>(
  path: String,
  from: Int,
  size: Int,
) -> Seq<Bytes | {fs.read_at[l], diverges}> / {diverges} =
  Seq(||
    match fs.read_at[l](path, from, size) {
      None -> None,
      Some(chunk) -> if chunk.len() == 0 { None }
      else { Some({ value: chunk, next: chunks[l](path, from + chunk.len(), size) }) },
    })

fn lengths<| e>(s: Seq<Bytes | e>) -> Seq<Int | {diverges | e}> / {diverges} =
  mapped(s, |b: Bytes| b.len())

fn file_slice(body: Bytes, offset: Int, len: Int) -> Option<Bytes> / {abort.raise} =
  if offset >= body.len() { Some(b"") }
  else { Some(body.slice(offset, min(offset + len, body.len()))) }

effect asks {
  write one() -> Unit
  read so_far() -> Int
}

fn counted<a | e>(body: () -> a / {asks.one, asks.so_far | e}) -> a / e =
  handle {
    body()
  } with {
    var n = 0,
    asks.one() -> {
      n = n + 1;
    },
    asks.so_far() -> n,
  }

test "a sequence over a list performs nothing, and needs no handler" {
  let s: Seq<Int | {}> = of_list([1, 2, 3]);
  assert_eq(take(s, 2), [1, 2]);
  assert_eq(take(s, 5), [1, 2, 3]);
  let none: Seq<Int | {}> = empty();
  assert_eq(take(none, 1), [])
}

test "a sequence of a file's chunks performs its reads where it is stepped" {
  let body = b"a lazy sequence";
  let got = counted(|| {
    let chunked = handle {
      take(chunks[src]("notes.txt", 0, 4), 3)
    } with {
      fs.read_at[src](_path, offset, len) -> {
        asks.one();
        file_slice(body, offset, len)
      },
    };
    { chunks: chunked, reads: asks.so_far() }
  });
  assert_eq(got.chunks, [b"a la", b"zy s", b"eque"]);
  assert_eq(got.reads, 3)
}

test "a sequence built from another sequence has the same effects as the original, so a handler around it still sees the file reads" {
  let body = b"a lazy sequence";
  let sizes = handle {
    take(lengths(chunks[src]("notes.txt", 0, 6)), 9)
  } with {
    fs.read_at[src](_path, offset, len) -> file_slice(body, offset, len),
  };
  assert_eq(sizes, [6, 6, 3])
}
