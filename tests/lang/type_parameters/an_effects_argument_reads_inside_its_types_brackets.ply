type Seq<a | e> = | Seq(() -> Option<a> / e) | Two(Seq<a | e>, Seq<a | e>) | End

type Holder =
  | One(Seq<Int | {}>)
  | Many(List<Seq<Int | {}>>)
  | Keyed(Map<Int, List<Seq<Int | {}>>>)

fn count(h: Holder) -> Int = match h { One(_) | Many(_) -> 1, Keyed(m) -> m.len() }

fn first(s: Seq<Int | {}>) -> Int =
  match s { Seq(f) -> match f() { Some(n) -> n, None -> 0 }, Two(a, _) -> first(a), End -> 0 }

test "a type such as `Seq<Int | {}>` parses correctly inside sum types, nested brackets, or-patterns and lambda parameters" {
  let pick = |s: Seq<Int | {}>, n: Int| first(s) + n;
  let one: Seq<Int | {}> = Seq(|| Some(4));
  assert_eq(pick(Two(one, End), 1), 5);
  assert_eq(count(One(one)), 1);
  assert_eq(count(Many([one])), 1);
  assert_eq(count(Keyed(Map::new().insert(1, [one]))), 1);
  let both: List<Seq<Int | {}>> = [one, End];
  assert_eq(both.len(), 2)
}
