pub effect stop {
  raise refused(code: Int)
}

fn reject<a>() -> a / {stop.refused} = stop.refused(3)

fn needed<a>(found: Option<a>) -> a / {stop.refused} =
  match found { Some(x) -> x, None -> reject() }

test "a generic definition that only raises stands in for whatever type its caller wants" {
  assert_eq(handle { needed(Some(4)) } with { stop.refused(c) -> 0 - c }, 4);
  assert_eq(handle { needed(None) } with { stop.refused(c) -> 0 - c }, -3);
  assert_eq(handle { needed(Some("x")) } with { stop.refused(c) -> "refused" }, "x");
  assert_eq(handle { reject() } with { stop.refused(c) -> "refused" }, "refused")
}
