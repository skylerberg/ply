type Point = { x: Float, y: Float }

type Particle = { position: Point, id: Int, name: String }

fn moved(ps: Array<Particle>, i: Int, dx: Float) -> Array<Particle> / {abort.raise} = {
  let p = ps.get(i);
  ps.set(i, { ..p, position: { ..p.position, x: p.position.x + dx } })
}

fn first_of<a>(xs: Array<a>) -> Option<a> = xs.at(0)

test "an array of records reads, sets and lists its elements by value" {
  let ps = Array::of_list([
    { position: { x: 0.0, y: 1.0 }, id: 1, name: "a" },
    { position: { x: 2.0, y: 3.0 }, id: 2, name: "b" },
  ]);
  let qs = moved(ps, 1, 0.5);
  assert_eq(qs.get(1).position.x, 2.5);
  assert_eq(ps.get(1).position.x, 2.0);
  assert_eq(qs.len(), 2);
  assert_eq(qs.to_list(), [qs.get(0), qs.get(1)]);
  assert_eq(qs.at(5), None)
}

test "an array of floats returns the exact values stored, and `set` leaves the original array unchanged" {
  let xs = Array::new(4, 0.25);
  let ys = xs.set(2, 1.5);
  assert_eq(
    range(0, ys.len()).fold(0.0, |accumulator: Float, i: Int| accumulator + ys.get(i)),
    2.25,
  );
  assert_eq(xs.get(2), 0.25)
}

test "generic code reads an array as its elements lay it out" {
  assert_eq(first_of(Array::new(2, { x: 1.0, y: 2.0 })), Some({ x: 1.0, y: 2.0 }));
  assert_eq(first_of(Array::new(1, 0.5)), Some(0.5))
}
