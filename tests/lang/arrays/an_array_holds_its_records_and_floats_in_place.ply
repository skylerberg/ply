//! An array of records holds them in place and an array of `Float`s holds their bits, however the
//! array is made: an element read, set or listed is the value that went in, and a set leaves any
//! other holder's array as it was.

type Point = { x: Float, y: Float }

type Particle = { pos: Point, id: Int, name: String }

fn moved(ps: Array<Particle>, i: Int, dx: Float) -> Array<Particle> / {abort.raise} = {
  let p = array_get(ps, i);
  array_set(ps, i, { ..p, pos: { ..p.pos, x: p.pos.x + dx } })
}

fn first_of<a>(xs: Array<a>) -> Option<a> = array_at(xs, 0)

test "an array of records reads, sets and lists its elements by value" {
  let ps = array_of_list([
    { pos: { x: 0.0, y: 1.0 }, id: 1, name: "a" },
    { pos: { x: 2.0, y: 3.0 }, id: 2, name: "b" },
  ]);
  let qs = moved(ps, 1, 0.5);
  assert_eq(array_get(qs, 1).pos.x, 2.5);
  assert_eq(array_get(ps, 1).pos.x, 2.0);
  assert_eq(array_len(qs), 2);
  assert_eq(array_to_list(qs), [array_get(qs, 0), array_get(qs, 1)]);
  assert_eq(array_at(qs, 5), None)
}

test "an array of floats holds their bits" {
  let xs = array_new(4, 0.25);
  let ys = array_set(xs, 2, 1.5);
  assert_eq(fold(range(0, array_len(ys)), 0.0, |acc: Float, i: Int| acc + array_get(ys, i)), 2.25);
  assert_eq(array_get(xs, 2), 0.25)
}

test "generic code reads an array as its elements lay it out" {
  assert_eq(first_of(array_new(2, { x: 1.0, y: 2.0 })), Some({ x: 1.0, y: 2.0 }));
  assert_eq(first_of(array_new(1, 0.5)), Some(0.5))
}
