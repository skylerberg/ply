//! Two arrays are equal when their elements are, order element by element, and derive as a list.

type Grid = { cells: Array<Int>, width: Int }

derive eq for Grid
derive ord for Grid

test "arrays compare by their elements" {
  assert(array_of_list([1, 2]) == array_of_list([1, 2]));
  assert(array_of_list([1, 2]) != array_of_list([1, 3]));
  assert(array_of_list([1, 2]) != array_of_list([1, 2, 3]));
  assert(array_set(array_new(2, 0), 1, 5) == array_of_list([0, 5]))
}

test "arrays order element by element, a prefix first" {
  assert_eq(compare(array_of_list([1, 2]), array_of_list([1, 3])), Less);
  assert_eq(compare(array_of_list([2]), array_of_list([1, 9])), Greater);
  assert_eq(compare(array_of_list([1]), array_of_list([1, 0])), Less);
  assert_eq(compare(array_new(0, 0), array_new(0, 0)), Equal)
}

test "an array is a map key" {
  let m = map_insert(map_insert(map_new(), array_of_list([2]), "b"), array_of_list([1]), "a");
  assert_eq(map_values(m), ["a", "b"]);
  assert_eq(map_get(m, array_of_list([2])), Some("b"))
}

fn grid(cells: List<Int>) -> Grid = { cells: array_of_list(cells), width: 2 }

test "a type holding an array derives equality and order" {
  assert(grid_eq().eq(grid([0, 0]), grid([0, 0])));
  assert(!grid_eq().eq(grid([0, 0]), grid([0, 1])));
  assert_eq(grid_ord().compare(grid([0, 0]), grid([1, 0])), Less);
  assert_eq(grid_ord().compare(grid([0, 1]), grid([0, 1])), Equal)
}
