//! `array_set` answers the array with one element replaced. The array it was given is unchanged:
//! a write is in place only when nothing else holds the array.

fn xs() -> Array<Int> = Array::of_list([10, 20, 30])

test "the element at the index is replaced and the others kept" {
  assert_eq(xs().set(0, 99).to_list(), [99, 20, 30]);
  assert_eq(xs().set(1, 99).to_list(), [10, 99, 30]);
  assert_eq(xs().set(2, 99).to_list(), [10, 20, 99])
}

test "the array given is unchanged" {
  let a = xs();
  let b = a.set(1, 99);
  assert_eq(a.to_list(), [10, 20, 30]);
  assert_eq(b.to_list(), [10, 99, 30])
}

fn fill(a: Array<Int>, i: Int) -> Array<Int> / {abort.raise} =
  if i >= a.len() { a } else { fill(a.set(i, i * 2), i + 1) }

test "an array handed down a recursion is written through" {
  assert_eq(fill(Array::new(5, 0), 0).to_list(), [0, 2, 4, 6, 8]);
  assert_eq(fill(Array::new(1000, 0), 0).get(999), 1998)
}

test "a fold's accumulator is written through" {
  let a = range(0, 50).fold(Array::new(50, 0), |acc: Array<Int>, i: Int| acc.set(49 - i, i));
  assert_eq(a.get(0), 49);
  assert_eq(a.get(49), 0)
}

test "a closure that captured the array keeps what it captured" {
  let a = xs();
  let first = || a.get(0);
  let b = a.set(0, 1);
  assert_eq(first(), 10);
  assert_eq(b.get(0), 1)
}
