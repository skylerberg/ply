//! `array_set` answers the array with one element replaced. The array it was given is unchanged:
//! a write is in place only when nothing else holds the array.

fn xs() -> Array<Int> = array_of_list([10, 20, 30])

test "the element at the index is replaced and the others kept" {
  assert_eq(array_to_list(array_set(xs(), 0, 99)), [99, 20, 30]);
  assert_eq(array_to_list(array_set(xs(), 1, 99)), [10, 99, 30]);
  assert_eq(array_to_list(array_set(xs(), 2, 99)), [10, 20, 99])
}

test "the array given is unchanged" {
  let a = xs();
  let b = array_set(a, 1, 99);
  assert_eq(array_to_list(a), [10, 20, 30]);
  assert_eq(array_to_list(b), [10, 99, 30])
}

fn fill(a: Array<Int>, i: Int) -> Array<Int> / {abort.raise} =
  if i >= array_len(a) { a } else { fill(array_set(a, i, i * 2), i + 1) }

test "an array handed down a recursion is written through" {
  assert_eq(array_to_list(fill(array_new(5, 0), 0)), [0, 2, 4, 6, 8]);
  assert_eq(array_get(fill(array_new(1000, 0), 0), 999), 1998)
}

test "a fold's accumulator is written through" {
  let a = fold(range(0, 50), array_new(50, 0), |acc: Array<Int>, i: Int| array_set(acc, 49 - i, i));
  assert_eq(array_get(a, 0), 49);
  assert_eq(array_get(a, 49), 0)
}

test "a closure that captured the array keeps what it captured" {
  let a = xs();
  let first = || array_get(a, 0);
  let b = array_set(a, 0, 1);
  assert_eq(first(), 10);
  assert_eq(array_get(b, 0), 1)
}
