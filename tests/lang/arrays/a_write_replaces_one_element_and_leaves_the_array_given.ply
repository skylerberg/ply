fn xs() -> Array<Int> = Array::of_list([10, 20, 30])

test "`set` replaces the element at the index and leaves the other elements unchanged" {
  assert_eq(xs().set(0, 99).to_list(), [99, 20, 30]);
  assert_eq(xs().set(1, 99).to_list(), [10, 99, 30]);
  assert_eq(xs().set(2, 99).to_list(), [10, 20, 99])
}

test "the array given is unchanged" {
  let a = xs();
  let b = a.set(1, 99);
  assert_eq(a.to_list(), [10, 20, 30]);
  assert_eq(b.to_list(), [10, 99, 30])
}

fn fill(a: Array<Int>, i: Int) -> Array<Int> / {abort.raise} =
  if i >= a.len() { a } else { fill(a.set(i, i * 2), i + 1) }

test "a recursive function can fill an array by calling `set` at each level" {
  assert_eq(fill(Array::new(5, 0), 0).to_list(), [0, 2, 4, 6, 8]);
  assert_eq(fill(Array::new(1000, 0), 0).get(999), 1998)
}

test "a fold can fill an array by calling `set` on its accumulator" {
  let a = range(0, 50).fold(Array::new(50, 0), |accumulator: Array<Int>, i: Int|
    accumulator.set(49 - i, i));
  assert_eq(a.get(0), 49);
  assert_eq(a.get(49), 0)
}

test "a closure that captured an array still sees the original contents after `set`" {
  let a = xs();
  let first = || a.get(0);
  let b = a.set(0, 1);
  assert_eq(first(), 10);
  assert_eq(b.get(0), 1)
}
