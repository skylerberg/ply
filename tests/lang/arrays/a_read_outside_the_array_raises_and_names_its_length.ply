fn got(a: Array<Int>, i: Int) -> Int / {abort.raise} = a.get(i)

fn caught<a>(f: () -> a / {abort.raise}) -> Result<a, String> =
  handle { f() } with { abort.raise(m) -> Err(m), return v -> Ok(v) }

fn named_length(r: Result<Int, String>) -> Bool =
  match r { Err(m) -> m.contains("outside a value of 3 elements"), Ok(_) -> false }

test "a read inside the array answers, and one outside raises naming its length" {
  assert_eq(got(Array::new(3, 7), 2), 7);
  assert(named_length(caught(|| got(Array::new(3, 7), 3))));
  assert(named_length(caught(|| got(Array::new(3, 7), 0 - 1))))
}

test "a filled array sums back, and one through a list reads in order" {
  [3, 40].fold((), |u: Unit, n: Int| {
    let a = range(0, n).fold(Array::new(n, 0), |acc: Array<Int>, i: Int| acc.set(i, i * i));
    assert_eq(
      range(0, n).fold(0, |s: Int, i: Int| s + a.get(i)),
      range(0, n).fold(0, |s: Int, i: Int| s + i * i),
    );
    assert_eq(
      Array::of_list(range(0, n)).to_list().fold(0, |s: Int, x: Int| s + x),
      n * (n - 1) / 2,
    )
  })
}
