fn got(a: Array<Int>, i: Int) -> Int / {abort.raise} = array_get(a, i)

fn caught<a>(f: () -> a / {abort.raise}) -> Result<a, String> =
  handle { f() } with { abort.raise(m) -> Err(m), return v -> Ok(v) }

fn named_length(r: Result<Int, String>) -> Bool =
  match r { Err(m) -> string_contains(m, "outside a value of 3 elements"), Ok(_) -> false }

test "a read inside the array answers, and one outside raises naming its length" {
  assert_eq(got(array_new(3, 7), 2), 7);
  assert(named_length(caught(|| got(array_new(3, 7), 3))));
  assert(named_length(caught(|| got(array_new(3, 7), 0 - 1))))
}

test "a filled array sums back, and one through a list reads in order" {
  fold([3, 40], (), |u: Unit, n: Int| {
    let a = fold(range(0, n), array_new(n, 0), |acc: Array<Int>, i: Int| array_set(acc, i, i * i));
    assert_eq(
      fold(range(0, n), 0, |s: Int, i: Int| s + array_get(a, i)),
      fold(range(0, n), 0, |s: Int, i: Int| s + i * i),
    );
    assert_eq(
      fold(array_to_list(array_of_list(range(0, n))), 0, |s: Int, x: Int| s + x),
      n * (n - 1) / 2,
    )
  })
}
