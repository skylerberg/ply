fn squares(n: Int) -> Array<Int> = Array::of_list(range(0, n).map(|i: Int| i * i))

test "an array is made from a length and a value, or from a list" {
  assert_eq(Array::new(3, 'x').to_list(), ['x', 'x', 'x']);
  assert_eq(Array::of_list([1, 2, 3]).to_list(), [1, 2, 3]);
  assert_eq(Array::new(0, 1).len(), 0);
  assert_eq(squares(40).len(), 40)
}

test "an element is read by its index" {
  let a = squares(40);
  assert_eq(a.get(0), 0);
  assert_eq(a.get(7), 49);
  assert_eq(a.get(39), 1521);
  assert_eq(a.at(39), Some(1521))
}

test "an array element can be any value, including an option or a nested array" {
  let a = Array::of_list([Some("a"), None]);
  assert_eq(a.get(0), Some("a"));
  assert_eq(a.at(1), Some(None));
  let nested = Array::new(2, Array::of_list([1, 2]));
  assert_eq(nested.get(1).get(1), 2)
}

fn total(a: Array<Int>) -> Int / {abort.raise} =
  range(0, a.len()).fold(0, |s: Int, i: Int| s + a.get(i))

test "an array parameter is read in place" {
  assert_eq(total(squares(10)), 285);
  assert_eq(total(Array::new(0, 0)), 0)
}
