//! An `Array` is a fixed number of elements, each read by its index.

fn squares(n: Int) -> Array<Int> = array_of_list(map(range(0, n), |i: Int| i * i))

test "an array is made from a length and a value, or from a list" {
  assert_eq(array_to_list(array_new(3, 'x')), ['x', 'x', 'x']);
  assert_eq(array_to_list(array_of_list([1, 2, 3])), [1, 2, 3]);
  assert_eq(array_len(array_new(0, 1)), 0);
  assert_eq(array_len(squares(40)), 40)
}

test "an element is read by its index" {
  let a = squares(40);
  assert_eq(array_get(a, 0), 0);
  assert_eq(array_get(a, 7), 49);
  assert_eq(array_get(a, 39), 1521);
  assert_eq(array_at(a, 39), Some(1521))
}

test "an element is whatever the array holds" {
  let a = array_of_list([Some("a"), None]);
  assert_eq(array_get(a, 0), Some("a"));
  assert_eq(array_at(a, 1), Some(None));
  let nested = array_new(2, array_of_list([1, 2]));
  assert_eq(array_get(array_get(nested, 1), 1), 2)
}

fn total(a: Array<Int>) -> Int / {abort.raise} =
  fold(range(0, array_len(a)), 0, |s: Int, i: Int| s + array_get(a, i))

test "an array parameter is read in place" {
  assert_eq(total(squares(10)), 285);
  assert_eq(total(array_new(0, 0)), 0)
}
