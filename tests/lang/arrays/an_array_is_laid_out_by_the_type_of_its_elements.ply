type Inner = { label: String, tag: Option<String> }

type Record = { inner: Inner, n: Int, d: Decimal }

type Shape = | Dot | Circle(Int)

fn record(n: Int) -> Record =
  {
    inner: { label: "r" ++ n.to_string(), tag: if n > 1 { Some("big") } else { None } },
    n: n,
    d: 1.50m,
  }

fn filled<a>(n: Int, x: a, y: a) -> Array<a> / {abort.raise} = Array::new(n, x).set(n - 1, y)

test "each kind of element reads back as it went in" {
  let big = 4611686018427387904;
  assert_eq(Array::of_list([1, big, 0 - big]).to_list(), [1, big, 0 - big]);
  assert_eq(Array::new(3, 200u8).set(1, 7u8).to_list(), [200u8, 7u8, 200u8]);
  assert_eq(Array::of_list([1.50m, 2.25m]).get(0), 1.5m);
  assert_eq(Array::new(2, true).set(1, false).to_list(), [true, false]);
  let opts = Array::of_list([Some(record(1)), None, Some(record(2))]);
  assert_eq(opts.get(1), None);
  assert_eq(opts.get(2), Some(record(2)));
  assert_eq(Array::new(2, Dot).set(1, Circle(3)).to_list(), [Dot, Circle(3)]);
  let recs = Array::of_list([record(1), record(2), record(3)]);
  assert_eq(recs.get(2).inner.tag, Some("big"));
  assert_eq(recs.to_list(), [record(1), record(2), record(3)]);
  let nested = Array::new(2, recs).set(1, Array::new(1, record(9)));
  assert_eq(nested.get(0).get(1), record(2));
  assert_eq(nested.get(1).get(0).inner.label, "r9")
}

test "`set` on an array of records leaves the original array and earlier results unchanged" {
  let recs = Array::new(3, record(1));
  let changed = recs.set(0, record(5));
  assert_eq(recs.get(0), record(1));
  assert_eq(changed.get(0), record(5));
  let again = changed.set(0, record(6)).set(2, record(7));
  assert_eq(again.to_list(), [record(6), record(1), record(7)]);
  assert_eq(Array::new(0, record(1)).len(), 0)
}

test "a generic definition lays an array out as the type it is called at" {
  assert_eq(filled(3, 1, 2).to_list(), [1, 1, 2]);
  assert_eq(filled(2, record(1), record(2)).to_list(), [record(1), record(2)]);
  assert_eq(filled(2, "a", "b").to_list(), ["a", "b"])
}

test "an array laid out by its type compares and hashes as its elements do" {
  assert_eq(Array::of_list([record(1), record(2)]), Array::new(2, record(1)).set(1, record(2)));
  assert_eq(digest(Array::of_list([1.5m])), digest(Array::new(1, 1.50m)))
}

fn caught<a>(f: () -> a / {abort.raise}) -> Result<a, String> =
  handle { f() } with { abort.raise(m) -> Err(m), return v -> Ok(v) }

test "`Array::new` rejects a length below zero or above the maximum array size" {
  let rejected = |n: Int|
    match caught(|| Array::new(n, record(1)).len()) {
      Err(m) -> m.contains("outside `0` to"),
      Ok(_) -> false,
    };
  assert(rejected(0 - 1));
  assert(rejected(67108865));
  assert_eq(caught(|| Array::new(0, 1.5).len()), Ok(0))
}

fn second<a>(xs: Array<a>) -> Option<a> = xs.at(1)

test "`at` returns `Some` of the element for a valid index, and `None` for an index outside the array" {
  let recs = Array::of_list([record(1), record(2)]);
  assert_eq(recs.at(1), Some(record(2)));
  assert_eq(recs.at(2), None);
  assert_eq(recs.at(0 - 1), None);
  assert_eq(Array::new(2, 1.5).at(0), Some(1.5));
  assert_eq(Array::new(3, 200u8).set(2, 9u8).at(2), Some(9u8));
  assert_eq(Array::new(1, Circle(4)).at(0), Some(Circle(4)));
  assert_eq(Array::new(0, "x").at(0), None);
  assert_eq(second(Array::of_list(["a", "b"])), Some("b"));
  assert_eq(second(Array::of_list([record(3)])), None)
}
