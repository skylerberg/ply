// A field of type `Array<a>` encodes as a list does, in JSON and in `std.bin`.

import std.bin
import std.json

type Grid = { cells: Array<Int>, width: Int }

derive json for Grid
derive bin for Grid

test "a type holding an array round-trips through both codecs" {
  let g = { cells: array_of_list([0, 1, 1, 0]), width: 2 };
  assert_eq(json::encode_string(g, grid_json()), "{\"cells\":[0,1,1,0],\"width\":2}");
  assert_eq(json::decode_string("{\"cells\":[0,1,1,0],\"width\":2}", grid_json()), Ok(g));
  assert_eq(bin::decode(bin::encode(g, grid_bin()), grid_bin()), Ok(g))
}
