type Named = { name: String, tags: List<String> }

fn names(n: Int) -> List<String> = range(0, n).map(|i: Int| "n".concat(i.to_string()))

fn named(n: Int) -> List<Named> =
  range(0, n).map(|i: Int| { name: i.to_string(), tags: [i.to_string(), "t"] })

test "an array of strings lists its strings in order" {
  let xs = names(40);
  let a = Array::of_list(xs);
  assert_eq(a.to_list(), xs);
  assert_eq(a.set(3, "three").to_list(), xs.set(3, "three"));
  assert_eq(a.to_list(), xs);
  assert_eq(Array::new(3, "s").to_list(), ["s", "s", "s"]);
  assert_eq(Array::of_list(names(0)).to_list(), [])
}

test "`Array` and `Columns` built from records with string fields return those records in order from `to_list`" {
  let rs = named(35);
  assert_eq(Array::of_list(rs).to_list(), rs);
  let c = Columns::of_list(rs);
  assert_eq(c.to_list(), rs);
  let one = { name: "one", tags: ["a", "b"] };
  assert_eq(c.set(34, one).to_list(), rs.set(34, one));
  assert_eq(c.to_list(), rs);
  assert_eq(Columns::new(2, one).to_list(), [one, one])
}
