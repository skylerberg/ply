type Grid = { cells: Array<Int>, width: Int }

test "arrays compare by their elements" {
  assert(Array::of_list([1, 2]) == Array::of_list([1, 2]));
  assert(Array::of_list([1, 2]) != Array::of_list([1, 3]));
  assert(Array::of_list([1, 2]) != Array::of_list([1, 2, 3]));
  assert(Array::new(2, 0).set(1, 5) == Array::of_list([0, 5]))
}

test "arrays order element by element, a prefix first" {
  assert_eq(compare(Array::of_list([1, 2]), Array::of_list([1, 3])), Less);
  assert_eq(compare(Array::of_list([2]), Array::of_list([1, 9])), Greater);
  assert_eq(compare(Array::of_list([1]), Array::of_list([1, 0])), Less);
  assert_eq(compare(Array::new(0, 0), Array::new(0, 0)), Equal)
}

test "an array is a map key" {
  let m = Map::new().insert(Array::of_list([2]), "b").insert(Array::of_list([1]), "a");
  assert_eq(m.values(), ["a", "b"]);
  assert_eq(m.get(Array::of_list([2])), Some("b"))
}

fn grid(cells: List<Int>) -> Grid = { cells: Array::of_list(cells), width: 2 }

test "a type with an array field compares and orders by that array" {
  assert(grid([0, 0]) == grid([0, 0]));
  assert(grid([0, 0]) != grid([0, 1]));
  assert_eq(compare(grid([0, 0]), grid([1, 0])), Less);
  assert_eq(compare(grid([0, 1]), grid([0, 1])), Equal)
}
