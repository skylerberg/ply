//! A `Columns` holds each field of its records apart: a field read of one record is that field's
//! column read, and the records read, set, list, compare and show as the array of them.

import std.bin
import std.json
import std.show (show)

type Point = { x: Float, y: Float }

type Particle = { pos: Point, id: Int, name: String }

type Batch = { points: Columns<Point>, label: String }

derive bin for Point

derive json for Point

derive bin for Batch

derive json for Batch

fn particles(n: Int) -> Columns<Particle> =
  Columns::of_list(
    range(0, n).map(|i: Int| { pos: { x: Float::of_int(i), y: 0.5 }, id: i, name: i.to_string() }),
  )

fn sum_x(ps: Columns<Particle>) -> Float / {abort.raise} =
  range(0, ps.len()).fold(0.0, |acc: Float, i: Int| acc + ps.get(i).pos.x)

fn ids(ps: Columns<Particle>) -> List<Int> / {abort.raise} =
  range(0, ps.len()).map(|i: Int| ps.get(i).id)

test "a field of a record reads from its column" {
  let ps = particles(4);
  assert_eq(ps.len(), 4);
  assert_eq(sum_x(ps), 6.0);
  assert_eq(ids(ps), [0, 1, 2, 3]);
  assert_eq(ps.get(2).name, "2");
  assert_eq(ps.get(3), { pos: { x: 3.0, y: 0.5 }, id: 3, name: "3" });
  assert_eq(ps.at(9), None)
}

test "a set writes each field of one record and leaves another holder's columns as they were" {
  let ps = particles(3);
  let moved = ps.set(1, { pos: { x: 10.0, y: 1.0 }, id: 7, name: "seven" });
  assert_eq(sum_x(moved), 12.0);
  assert_eq(moved.get(1).name, "seven");
  assert_eq(ps.get(1).id, 1);
  assert_eq(Columns::new(2, { x: 1.0, y: 2.0 }).to_list(), [{ x: 1.0, y: 2.0 }, { x: 1.0, y: 2.0 }])
}

test "columns compare and show as the array of their records" {
  let ps = particles(2);
  assert(ps == Columns::of_list(ps.to_list()));
  assert(ps != particles(3));
  assert_eq(
    show(Columns::of_list([{ x: 1.0, y: 2.0 }])),
    show(Array::of_list([{ x: 1.0, y: 2.0 }])),
  )
}

test "a derived codec writes columns as the list of their records and reads them back" {
  let b = { points: Columns::of_list([{ x: 1.0, y: 2.0 }, { x: 3.0, y: 4.0 }]), label: "b" };
  assert_eq(bin::decode(bin::encode(b, batch_bin()), batch_bin()), Ok(b));
  assert_eq(json::decode_bytes(json::encode_bytes(b, batch_json()), batch_json()), Ok(b))
}
