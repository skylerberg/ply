//! `array_at` answers `None` outside the array, where `array_get` and `array_set` raise.

fn xs() -> Array<Int> = array_of_list([10, 20, 30])

test "at the end and past it" {
  assert_eq(array_at(xs(), 3), None);
  assert_eq(array_at(xs(), 4), None)
}

test "a negative index is absent, not the last element" {
  assert_eq(array_at(xs(), -1), None);
  assert_eq(array_at(xs(), -3), None)
}

test "the extremes of Int" {
  assert_eq(array_at(xs(), 9223372036854775807), None);
  assert_eq(array_at(xs(), 0 - 9223372036854775807 - 1), None)
}

fn found(a: Array<Int>, i: Int) -> Int = match array_at(a, i) { Some(x) -> x, None -> 0 - 1 }

test "a match on the answer reads the element or nothing" {
  assert_eq(found(xs(), 1), 20);
  assert_eq(found(xs(), 3), 0 - 1);
  assert_eq(found(array_new(0, 0), 0), 0 - 1)
}
