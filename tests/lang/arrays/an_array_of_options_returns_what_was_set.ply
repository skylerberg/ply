type Span = { start: Int, end: Int }

fn put<a>(xs: Array<a>, i: Int, x: a) -> Array<a> / {abort.raise} = xs.set(i, x)

test "options of an integer, a string and a record read back as they were set" {
  let ints: Array<Option<Int>> = Array::new(3, None).set(1, Some(7)).set(2, Some(0));
  assert_eq(ints.get(0), None);
  assert_eq(ints.get(1), Some(7));
  assert_eq(ints.at(2), Some(Some(0)));
  assert_eq(ints.to_list(), [None, Some(7), Some(0)]);
  let words = Array::new(2, Some("a")).set(1, Some("b" ++ "c"));
  assert_eq(words.get(0), Some("a"));
  assert_eq(words.to_list(), [Some("a"), Some("bc")]);
  let spans: Array<Option<Span>> = Array::new(2, None).set(0, Some({ start: 1, end: 2 }));
  assert_eq(spans.get(0), Some({ start: 1, end: 2 }));
  assert_eq(spans.to_list(), [Some({ start: 1, end: 2 }), None])
}

test "setting an option element again reads back the last value set, for arrays from `Array::new` or `Array::of_list`" {
  let cleared = Array::new(2, Some("a")).set(0, None);
  assert_eq(cleared.to_list(), [None, Some("a")]);
  let listed = Array::of_list([Some(1), None]).set(1, Some(2)).set(0, None);
  assert_eq(listed.to_list(), [None, Some(2)]);
  assert_eq(put(Array::new(2, None), 1, Some("x")).to_list(), [None, Some("x")])
}
