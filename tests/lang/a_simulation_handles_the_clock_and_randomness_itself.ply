fn work() -> Int / {clock.read, clock.write, random.write} = {
  let started = match clock.now() { Instant(n) -> n };
  clock.sleep(Duration(40));
  started + random.next() + random.below(6)
}

fn stub() -> Int =
  handle work() with {
    clock.now() -> Instant(0),
    clock.sleep(nanos) -> (),
    random.next() -> 7,
    random.below(bound) -> 0,
  }

test "a function that handles every clock and random operation itself can be called without those effects" {
  assert_eq(stub(), 7)
}

test "a simulation handles every clock and random operation itself" {
  let got = simulate {
    let started = match clock.now() { Instant(n) -> n };
    clock.sleep(Duration(40));
    let ended = match clock.now() { Instant(n) -> n };
    let _ = random.next();
    { slept: ended - started, below: random.below(6) }
  };
  assert(got.slept >= 40, Some("the simulation's clock did not move past the sleep"));
  assert(got.below >= 0 && got.below < 6, Some("`below` returned past its bound"))
}
