type Shape = | Dot | Line(Int)

test "assert_eq compares both sides as they are, and raises where they differ" {
  assert_eq(try[abort.raise] { assert_eq([Line(1)], [Line(1)]) }, Ok(()));
  assert_eq(
    match try[abort.raise] { assert_eq({ a: Dot }, { a: Line(2) }) } {
      Ok(_) -> false,
      Err(_) -> true,
    },
    true,
  )
}
