fn slept_ms() -> Int / {clock.read, clock.write} = {
  let before = match clock.now() { Instant(at) -> at };
  clock.sleep(Duration(20000000));
  let after = match clock.now() { Instant(at) -> at };
  (after - before) / 1000000
}

test/nondet "a 20ms sleep takes 20ms of the host's clock" {
  let waited = slept_ms();
  assert(waited >= 20 && waited < 10000, Some("it took " ++ waited.to_string()))
}
