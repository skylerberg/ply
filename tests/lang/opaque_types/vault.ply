//! Types only this module builds: a sum whose constructors it keeps, a `new` record whose fields
//! any module reads, and a sum that states its key, its text and its arithmetic.

import std.json
import std.show (show)

pub opaque type Token = | Token(String)

pub opaque type Date = new { year: Int, month: Int, day: Int }

pub opaque type Money = | Money(Int)

key for Money by cents

show for Money by written

numeric for Money by { add: plus, sub: minus, mul: times, neg: negated, of_int: of_cents }

derive json for Date

pub fn cents(m: Money) -> Int = match m { Money(c) -> c }

fn written(m: Money) -> String = "$" ++ int_to_string(cents(m))

fn plus(a: Money, b: Money) -> Money = Money(cents(a) + cents(b))

fn minus(a: Money, b: Money) -> Money = Money(cents(a) - cents(b))

fn times(a: Money, b: Money) -> Money = Money(cents(a) * cents(b))

fn negated(a: Money) -> Money = Money(0 - cents(a))

pub fn of_cents(n: Int) -> Money = Money(n)

/// No token is empty.
pub fn mint(s: String) -> Option<Token> = if s == "" { None } else { Some(Token(s)) }

pub fn text_of(t: Token) -> String = match t { Token(s) -> s }

pub fn epoch() -> Date = { year: 1970, month: 1, day: 1 }

/// No date has a month past twelve or a day past thirty-one.
pub fn of_ymd(year: Int, month: Int, day: Int) -> Option<Date> =
  if month < 1 || month > 12 || day < 1 || day > 31 { None }
  else { Some({ year: year, month: month, day: day }) }

pub fn next_year(d: Date) -> Date = { ..d, year: d.year + 1 }

fn from(d: Date = { year: 2000, month: 1, day: 1 }) -> Int = d.year

law "a year on keeps the month and the day"
  forall (d: Date) where d.year < 10000 {
    next_year(d).month == d.month && next_year(d).day == d.day
  }

law "a token's text mints it again"
  forall (t: Token) where text_of(t) != "" {
    mint(text_of(t)) == Some(t)
  }

test "inside its module an opaque type is built, matched, updated and defaulted as any other" {
  assert_eq(text_of(Token("a")), "a");
  assert_eq(next_year(epoch()), { year: 1971, month: 1, day: 1 });
  assert_eq(show(of_cents(5) + of_cents(7)), "$12");
  assert_eq(from(), 2000);
  let { year, .. } = epoch();
  assert_eq(year, 1970)
}
