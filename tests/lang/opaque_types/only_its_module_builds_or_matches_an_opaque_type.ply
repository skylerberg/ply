import compiler.check.infer (check_dump, check_dumps)
import compiler.syntax.items (parse)
import compiler.syntax.parsing (ParseDiagnostic)
import std.string

fn vault() -> String =
  \\pub opaque type Token = | Token(String) | Blank
  \\pub opaque type Date = new { year: Int, month: Int, day: Int }
  \\pub fn mint(s: String) -> Token = if s == "" { Blank } else { Token(s) }
  \\pub fn text_of(t: Token) -> String = match t { Token(s) -> s, Blank -> "" }
  \\pub fn epoch() -> Date = { year: 1970, month: 1, day: 1 }
  \\pub fn next_year(d: Date) -> Date = { ..d, year: d.year + 1 }
  \\

fn importing() -> Bytes =
  b"import vault\nimport vault (Token, Date, mint, text_of, epoch, next_year)\n"

fn checked(body: Bytes) -> String / {abort.raise} =
  check_dump([
    { name: b"vault", source_text: Bytes::of_string(vault()) },
    { name: b"app", source_text: importing().concat(body) },
  ])

fn codes(dump: String) -> List<String> / {abort.raise} =
  dump.split("!").fold([], |accumulator: List<String>, part: String|
    if part.starts_with("E") || part.starts_with("W") {
      match part.split_once(":") { Some(cut) -> accumulator.push(cut.head), None -> accumulator }
    } else { accumulator })

fn rejected(body: Bytes) -> List<String> / {abort.raise} = codes(checked(body))

test "another module can name the opaque type, call its module's functions and use the values they return" {
  assert_eq(rejected(b"fn a() -> Token = mint(\"a\")"), []);
  assert_eq(rejected(b"fn a(t: vault::Token) -> String = text_of(t)"), []);
  assert_eq(rejected(b"fn a() -> List<Date> = [epoch(), next_year(epoch())]"), []);
  assert_eq(rejected(b"fn a(t: Token) -> Int = match t { _ -> 1 }"), [])
}

test "a constructor of an opaque sum is not called, named or passed outside its module" {
  assert_eq(rejected(b"fn a() -> Token = Token(\"a\")"), ["E0107"]);
  assert_eq(rejected(b"fn a() -> Token = vault::Token(\"a\")"), ["E0107"]);
  assert_eq(rejected(b"fn a() -> Token = Blank"), ["E0107"]);
  assert_eq(rejected(b"fn a() -> List<Token> = [\"a\"].map(Token)"), ["E0107"])
}

test "matching an opaque sum's constructor outside its module is rejected with only error E0107" {
  assert_eq(rejected(b"fn a(t: Token) -> String = match t { Token(s) -> s, _ -> \"\" }"), [
    "E0107",
  ]);
  assert_eq(rejected(b"fn a(t: Token) -> String = match t { vault::Token(s) -> s }"), ["E0107"]);
  assert_eq(rejected(b"fn a(t: Token) -> Bool = match t { Blank -> true, _ -> false }"), ["E0107"]);
  assert_eq(rejected(b"fn a(ts: List<Token>) -> Int = match ts { [Token(_), ..] -> 1, _ -> 0 }"), [
    "E0107",
  ])
}

test "importing only an opaque sum's constructor is rejected with the same error E0107 as using it" {
  let named = check_dump([
    { name: b"vault", source_text: Bytes::of_string(vault()) },
    { name: b"app", source_text: b"import vault (Blank)\nfn a() -> Int = 1" },
  ]);
  assert_eq(codes(named), ["E0107"])
}

test "a record literal is rejected with E0220 wherever an opaque record type is expected" {
  let literal = b"{ year: 1, month: 2, day: 3 }";
  let building = |before: Bytes, after: Bytes|
    rejected(Bytes::concat_all([before, literal, after]));
  assert_eq(building(b"fn a() -> Date = ", b""), ["E0220"]);
  assert_eq(building(b"fn a() -> Date = next_year(", b")"), ["E0220"]);
  assert_eq(building(b"fn a() -> List<Date> = [epoch(), ", b"]"), ["E0220"]);
  assert_eq(building(b"fn a() -> Option<Date> = Some(", b")"), ["E0220"]);
  assert_eq(building(b"fn a() -> Date = {\n  let d: Date = ", b";\n  d\n}"), ["E0220"]);
  assert_eq(building(b"fn a(d: Date = ", b") -> Date = d"), ["E0220"]);
  assert_eq(rejected(b"fn a() -> Date = { year: 1, hour: 2 }"), ["E0220"]);
  assert_eq(rejected(b"fn a() -> Date = { year: missing, month: 2, day: 3 }"), ["E0220", "E0101"])
}

test "a record literal with an opaque type's field names is rejected outside that type's module" {
  let source = b"fn a() -> Date = {\n  let r = { year: 1, month: 2, day: 3 };\n  r\n}";
  assert_eq(rejected(source), ["E0201"])
}

test "updating an opaque record with `..` is rejected outside its module, whether the type is known directly or inferred later" {
  assert_eq(rejected(b"fn a(d: Date) -> Date = { ..d, day: 9 }"), ["E0220"]);
  assert_eq(rejected(b"fn a() -> Date = { ..epoch(), day: 9 }"), ["E0220"]);
  assert_eq(rejected(b"fn a(d: Date) -> Date = { ..d, hour: 9 }"), ["E0220"]);
  assert_eq(
    rejected(b"fn a() -> Date = {\n  let moved = |d| { ..d, day: 9 };\n  moved(epoch())\n}"),
    ["E0220"],
  )
}

test "an opaque record's fields are read and matched outside its module" {
  assert_eq(rejected(b"fn a(d: Date) -> Int = d.year + d.month"), []);
  assert_eq(rejected(b"fn a(d: Date) -> Int = match d { { day, .. } -> day }"), []);
  assert_eq(
    rejected(b"fn a(d: Date) -> Int = {\n  let { year, month, day } = d;\n  year + month + day\n}"),
    [],
  )
}

test "a `law` outside the module of an opaque type can declare variables of that type, including inside `List` or a record" {
  assert_eq(rejected(b"law \"l\" forall (d: Date) { d.month > 0 }"), []);
  assert_eq(rejected(b"law \"l\" forall (ts: List<Token>) { ts.len() >= 0 }"), []);
  assert_eq(
    rejected(b"type Stay = { from: Date }\nlaw \"l\" forall (s: Stay) { s.from.day > 0 }"),
    [],
  );
  let schema = b"law schema back<a, b>(f: (a) -> b, g: (b) -> a) forall (x: a) { g(f(x)) == x }\n";
  assert_eq(rejected(schema.concat(b"law \"l\" = back(text_of, mint)")), []);
  assert_eq(rejected(b"law \"l\" forall (s: String) { text_of(mint(s)) == s }"), [])
}

fn alone(source: Bytes) -> List<String> / {abort.raise} =
  codes(check_dump([{ name: b"m", source_text: source }]))

test "a private `fn` default may build an opaque value in its own module, but a `pub fn` parameter default that builds one is rejected with E0122" {
  let date = b"pub opaque type Date = new { day: Int }\n";
  let token = b"pub opaque type Token = | Token(Int)\n";
  assert_eq(alone(date.concat(b"fn a(d: Date = { day: 1 }) -> Date = { ..d, day: 2 }")), []);
  assert_eq(alone(date.concat(b"pub fn a(d: Date = { day: 1 }) -> Date = d")), ["E0122"]);
  assert_eq(alone(date.concat(b"pub fn a(d: Option<Date> = Some({ day: 1 })) -> Int = 1")), [
    "E0122",
  ]);
  assert_eq(alone(date.concat(b"pub fn a(d: Option<Date> = None) -> Int = 1")), []);
  assert_eq(alone(token.concat(b"fn a(t: Token = Token(1)) -> Token = t")), []);
  assert_eq(alone(token.concat(b"pub fn a(t: Token = Token(1)) -> Token = t")), ["E0122"]);
  assert_eq(alone(token.concat(b"law \"l\" forall (t: Token) { t == t }")), [])
}

test "a `const fn` outside an opaque type's module can build the type only by calling that module's functions" {
  assert_eq(rejected(b"const fn a() -> Date = { year: 1, month: 2, day: 3 }"), ["E0220"]);
  assert_eq(rejected(b"const fn a() -> Date = { ..epoch(), day: 2 }"), ["E0220"]);
  assert_eq(rejected(b"const fn a() -> Token = Token(\"a\")"), ["E0107"]);
  assert_eq(rejected(b"const fn a() -> Date = next_year(epoch())"), []);
  assert_eq(rejected(b"pub const fn a() -> List<Token> = [mint(\"a\"), mint(\"\")]"), []);
  let date = b"pub opaque type Date = new { day: Int }\n";
  assert_eq(alone(date.concat(b"pub const fn a() -> Date = { day: 1 }")), []);
  let token = b"pub opaque type Token = | Token(Int)\n";
  assert_eq(alone(token.concat(b"pub const fn a() -> Token = Token(1)")), [])
}

test "outside the module, a range or byte pattern inside a private constructor is rejected with a single E0107 error naming the constructor" {
  let lib = b"pub opaque type Code = | Digit(Int) | Byte(Int)\npub fn zero() -> Code = Digit(0)\npub fn digit(c: Code) -> Bool = match c { Digit(0..=9) -> true, Byte(b'0'..=b'9') -> true, _ -> false }\n";
  let naming = |body: Bytes|
    codes(
      check_dump([
        { name: b"lib", source_text: lib },
        { name: b"app", source_text: b"import lib\nimport lib (Code)\n".concat(body) },
      ]),
    );
  assert_eq(naming(b"fn a(c: Code) -> Bool = lib::digit(c)"), []);
  assert_eq(naming(b"fn a(c: Code) -> Int = match c { Digit(0..=9) -> 1, _ -> 0 }"), ["E0107"]);
  assert_eq(naming(b"fn a(c: Code) -> Int = match c { lib::Byte(b'a'..=b'z') -> 1, _ -> 0 }"), [
    "E0107",
  ]);
  assert_eq(naming(b"fn a(c: Code) -> Int = match c { Byte(b'0') -> 1, _ -> 0 }"), ["E0107"]);
  assert_eq(naming(b"fn a() -> Code = Byte(b'0')"), ["E0107"])
}

test "a type need not be `pub` to be opaque, and an alias is never one" {
  let diagnosed = |source: Bytes|
    parse(source).parser.diagnostics.map(|d: ParseDiagnostic| String::of_bytes(d.code));
  assert_eq(diagnosed(b"opaque type Date = new { day: Int }\n"), []);
  assert_eq(diagnosed(b"pub opaque type Token = | Token(Int)\n"), []);
  assert_eq(diagnosed(b"pub opaque type Id = Int\n"), ["E0221"]);
  assert_eq(diagnosed(b"opaque type Pair = { a: Int, b: Int }\n"), ["E0221"]);
  assert_eq(diagnosed(b"fn opaque(opaque: Int) -> Int = opaque\n"), []);
  assert_eq(diagnosed(b"type T = { opaque: Bool }\n"), []);
  let dump = check_dump([
    {
      name: b"lib",
      source_text: b"opaque type Date = new { day: Int }\npub fn day(d: Date) -> Int = d.day\n",
    },
    { name: b"app", source_text: b"import lib (day)\nfn a() -> Int = day({ day: 1 })" },
  ]);
  assert_eq(codes(dump), ["E0220"])
}

test "checking a program of opaque types gives the same result whether its dependency's saved public declarations are reused or recomputed" {
  let program = [
    { name: b"vault", source_text: Bytes::of_string(vault()) },
    {
      name: b"app",
      source_text: importing().concat(
        b"pub fn later(d: Date) -> Int = next_year(d).year + text_of(mint(\"a\")).len()",
      ),
    },
  ];
  let dumps = check_dumps(program);
  assert_eq(dumps.seeded, dumps.uncached)
}
