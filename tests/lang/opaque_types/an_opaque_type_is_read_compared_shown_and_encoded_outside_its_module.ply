import std.json
import std.show (show)
import opaque_types.vault
import opaque_types.vault (Token, Date, Money, mint, text_of, epoch, of_ymd, next_year, of_cents,
                           cents, date_json)

type Booking = { on: Date, by: Option<Token>, paid: Money }

fn year(d: Date) -> Int = d.year

fn day(d: Date) -> Int = match d { { day, .. } -> day }

fn booked() -> Booking =
  { on: next_year(epoch()), by: mint("ada"), paid: of_cents(5) + of_cents(7) }

fn label(t: Token) -> String = match t { _ -> text_of(t) }

fn dates() -> List<Date> = [epoch(), next_year(epoch())]

const year_after: Date = next_year(vault::leap_day)

test "outside its module, an opaque record's fields can be read and matched, and its module's functions create it" {
  let b = booked();
  assert_eq(year(b.on) + day(b.on), 1972);
  assert_eq(of_ymd(2000, 13, 1), None);
  assert_eq(match of_ymd(2000, 12, 31) { Some({ month, .. }) -> month, None -> 0 }, 12)
}

test "outside its module, a value of an opaque sum type can be stored, passed and matched, and the module's functions read its contents" {
  let b = booked();
  assert_eq(match b.by { Some(t) -> label(t), None -> "" }, "ada");
  assert_eq(mint(""), None);
  assert_eq(cents(b.paid), 12);
  assert_eq(cents(vault::of_cents(3) * of_cents(4) - of_cents(2)), 10)
}

test "outside its module, an opaque value supports `==`, ordering, `digest`, `show` and use as a `Map` key" {
  let b = booked();
  assert(b.on == next_year(epoch()));
  assert(compare(epoch(), b.on) == Less);
  assert(digest(epoch()) != digest(b.on));
  assert_eq(#{epoch(): 1, b.on: 2, next_year(epoch()): 3}.len(), 2);
  assert_eq(show(epoch()), "{day: 1, month: 1, year: 1970}");
  assert_eq(show(mint("a")), "Some(Token(\"a\"))");
  assert(b.paid == of_cents(12));
  assert_eq(show(b.paid), "$12")
}

test "a JSON codec defined in an opaque type's module encodes and decodes the type outside that module" {
  let text = json::encode_string(epoch(), date_json());
  assert_eq(json::decode_string(text, date_json()), Ok(epoch()))
}

test "a constant of an opaque type can be used in any module, including a constant computed by calling the type's own functions" {
  assert_eq(vault::leap_day.day, 29);
  assert_eq(text_of(vault::root), "root");
  assert_eq(year_after.year, 2025);
  assert(year_after == next_year(vault::leap_day))
}

test "every opaque `Date` in `dates()` has month 1, including the case with year {c.year}" for c: Date in dates(
  ) { assert(c.month == 1) }
