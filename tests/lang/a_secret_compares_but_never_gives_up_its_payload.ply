test "two secrets are equal exactly when their payloads are" {
  let a = Secret::of_string("hunter2");
  let b = Secret::of_string("hunter2");
  let c = Secret::of_string("hunter3");
  assert(a == b);
  assert(a != c);
  assert_eq({ k: a }, { k: b })
}

test "`verify` returns whether a string matches the payload, and `is_empty` returns whether the secret has no content" {
  let s = Secret::of_string("hunter2");
  assert(s.verify("hunter2"));
  assert(!s.verify("hunter3"));
  assert(!s.verify(""));
  assert(!s.is_empty());
  assert(Secret::of_string("").is_empty())
}

test "a secret of bytes is made, joined, measured and compared, and never read" {
  let a = Secret::of_bytes(b"hunter2");
  assert(a == Secret::of_bytes(b"hunter2"));
  assert(a != Secret::of_bytes(b"hunter3"));
  assert(a != Secret::of_bytes(b"hunter"));
  assert(a != Secret::of_bytes(b"hunter22"));
  assert(a == Secret::of_string("hunter2").bytes());
  assert_eq(a.len(), 7);
  assert(Secret::of_bytes(b"hun").concat(Secret::of_bytes(b"ter2")) == a);
  assert(Secret::decode("hex", Secret::of_string("68756e74657232")) == Some(a));
  assert(Secret::decode("hex", Secret::of_string("68756e7465723")) == None);
  assert(!a.is_empty());
  assert(Secret::of_bytes(b"").is_empty());
  assert_eq({ k: a }, { k: Secret::of_bytes(b"hunter2") });
  let s = Secret::of_string("hunter2");
  assert_eq(s.bytes().concat(a).len(), 14)
}

test "building a secret from a string does not use up the string, which can still be used afterward" {
  let plain = "hunter2";
  let s = Secret::of_string(plain);
  assert(s.verify(plain));
  assert_eq(plain.len(), 7)
}
