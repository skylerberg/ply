type Pair = { n: Int, s: String }

type Shape = | Dot | Line(Int) | Rect({ w: Int, h: Float })

fn pairs(n: Int) -> List<Pair> =
  range(0, n).map(|i: Int| { n: i, s: if i % 2 == 0 { "even" } else { "odd" } })

fn amounts(n: Int) -> List<Decimal> = range(0, n).map(|i: Int| Decimal::of_int(i) * 0.25m)

fn wides(n: Int) -> List<I128> = range(0, n).map(|i: Int| I128::of_int(i) * 1000000000000i128)

fn shapes(n: Int) -> List<Shape> =
  range(0, n).map(|i: Int|
    if i % 3 == 0 { Dot } else if i % 3 == 1 { Line(i) } else { Rect({ w: i, h: 0.5 }) })

fn past_two<a>(xs: List<a>) -> List<a> = match xs { [_, _, ..rest] -> rest, _ -> [] }

test "a list of small records supports reading, setting, folding and filtering, for short and long lists" {
  let xs = pairs(1100);
  assert_eq(xs.len(), 1100);
  assert_eq([xs.at(0), xs.at(33), xs.at(1099)], [
    Some({ n: 0, s: "even" }),
    Some({ n: 33, s: "odd" }),
    Some({ n: 1099, s: "odd" }),
  ]);
  assert_eq(xs.set(500, { n: -1, s: "set" }).at(500), Some({ n: -1, s: "set" }));
  assert_eq(xs.at(500), Some({ n: 500, s: "even" }));
  assert_eq(past_two(xs).at(0), Some({ n: 2, s: "even" }));
  assert_eq(xs.fold(0, |t: Int, p: Pair| t + p.n), 1100 * 1099 / 2);
  assert_eq(xs.filter(|p: Pair| p.s == "odd").len(), 550);
  assert_eq(pairs(40), pairs(40));
  assert(pairs(40) != pairs(40).set(39, { n: 0, s: "" }))
}

test "a list of Decimals, 128-bit integers or sum values supports reading, setting and pattern matching" {
  assert_eq(amounts(70).at(69), Some(17.25m));
  assert_eq(amounts(3).set(1, 9.99m), [0.00m, 9.99m, 0.50m]);
  assert_eq(wides(40).at(39), Some(39000000000000i128));
  assert_eq(shapes(50).at(49), Some(Line(49)));
  assert_eq(shapes(6), [
    Dot,
    Line(1),
    Rect({ w: 2, h: 0.5 }),
    Dot,
    Line(4),
    Rect({ w: 5, h: 0.5 }),
  ]);
  assert_eq(match shapes(5) { [_, Line(n), ..rest] -> n + rest.len(), _ -> 0 }, 4)
}

test "pushing onto an empty list of records or sum values works" {
  let none: List<Pair> = [];
  assert_eq(none.push({ n: 1, s: "a" }).push({ n: 2, s: "b" }).at(1), Some({ n: 2, s: "b" }));
  let wide: List<Shape> = [];
  assert_eq(
    range(0, 40).fold(wide, |xs: List<Shape>, i: Int| xs.push(Line(i))).at(39),
    Some(Line(39)),
  )
}

test "a list literal of constant records or Decimals can be read, folded and converted to an array" {
  let ps = [{ n: 1, s: "a" }, { n: 2, s: "b" }];
  let ds = [1.5m, 2.25m, 3m];
  assert_eq(ps.at(1), Some({ n: 2, s: "b" }));
  assert_eq(ds.fold(0m, |t: Decimal, d: Decimal| t + d), 6.75m);
  assert_eq(Array::of_list(ps).get(0), { n: 1, s: "a" })
}

test "lengths are correct after cutting, setting and filtering lists of small records or sum values" {
  assert_eq(past_two(pairs(70)).len(), 68);
  assert_eq(pairs(1100).set(3, { n: 0, s: "x" }).len(), 1100);
  assert_eq(shapes(200).filter(|s: Shape| s != Dot).len(), 133)
}
