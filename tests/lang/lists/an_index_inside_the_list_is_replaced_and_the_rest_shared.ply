fn xs() -> List<Int> = [10, 20, 30]

fn long() -> List<Int> = range(0, 100)

test "the element at the index is replaced and the others kept" {
  assert_eq(list_set(xs(), 0, 99), [99, 20, 30]);
  assert_eq(list_set(xs(), 1, 99), [10, 99, 30]);
  assert_eq(list_set(xs(), 2, 99), [10, 20, 99])
}

test "the list given is unchanged" {
  let a = xs();
  let b = list_set(a, 1, 99);
  assert_eq(a, [10, 20, 30]);
  assert_eq(b, [10, 99, 30])
}

test "a write below the tail replaces that element alone" {
  let a = long();
  let b = list_set(a, 40, 0 - 1);
  assert_eq(list_at(b, 40), Some(0 - 1));
  assert_eq(list_at(b, 39), Some(39));
  assert_eq(list_at(b, 41), Some(41));
  assert_eq(list_at(a, 40), Some(40));
  assert_eq(len(b), 100)
}

test "a write in the tail of a long list" {
  let b = list_set(long(), 99, 0 - 1);
  assert_eq(list_at(b, 99), Some(0 - 1));
  assert_eq(list_at(b, 98), Some(98));
  assert_eq(len(b), 100)
}
