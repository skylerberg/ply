fn xs() -> List<Int> = [10, 20, 30]

fn long() -> List<Int> = range(0, 100)

test "`set` replaces the element at the index and leaves the other elements unchanged" {
  assert_eq(xs().set(0, 99), [99, 20, 30]);
  assert_eq(xs().set(1, 99), [10, 99, 30]);
  assert_eq(xs().set(2, 99), [10, 20, 99])
}

test "the list given is unchanged" {
  let a = xs();
  let b = a.set(1, 99);
  assert_eq(a, [10, 20, 30]);
  assert_eq(b, [10, 99, 30])
}

test "`set` at an index inside the trie of a long list replaces only that element" {
  let a = long();
  let b = a.set(40, 0 - 1);
  assert_eq(b.at(40), Some(0 - 1));
  assert_eq(b.at(39), Some(39));
  assert_eq(b.at(41), Some(41));
  assert_eq(a.at(40), Some(40));
  assert_eq(b.len(), 100)
}

test "a write in the tail of a long list" {
  let b = long().set(99, 0 - 1);
  assert_eq(b.at(99), Some(0 - 1));
  assert_eq(b.at(98), Some(98));
  assert_eq(b.len(), 100)
}
