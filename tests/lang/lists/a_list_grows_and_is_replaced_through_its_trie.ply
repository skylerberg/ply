//! `List::push` adds past the tail, a full tail moving into the trie, and `List::set` replaces an
//! item in the tail or down the trie: each in place where the list is held once, and in a copy
//! that leaves the list it was given whole where it is shared.

import std.pace (spent)

type Rec = { name: String, n: Int }

fn upto(n: Int) -> List<Int> = range(0, n).fold([], |xs: List<Int>, i: Int| xs.push(i))

fn total(xs: List<Int>) -> Int = xs.fold(0, |s: Int, x: Int| s + x)

fn item(xs: List<Int>, i: Int) -> Int = match xs.at(i) { Some(v) -> v, None -> -1 }

/// `xs` past its first `k` items, by `rest`.
fn dropped(xs: List<Int>, k: Int) -> List<Int> =
  if k <= 0 { xs } else { match xs { [_, ..r] -> dropped(r, k - 1), [] -> [] } }

/// `xs` with `i` up to `n` pushed, each push on the list the last one answered.
fn pushed(xs: List<Int>, i: Int, n: Int) -> List<Int> =
  if i >= n { xs } else { pushed(xs.push(i), i + 1, n) }

// The pushes of items 1025 and 32769 move a full tail into the last room the trie has, and those of
// 65, 1057 and 32801 into a trie with none left, which a new root raises.
test "a list grows through every depth of its trie" {
  let sizes = [1, 32, 33, 64, 65, 1024, 1025, 1056, 1057, 32768, 32769, 32800, 32801, 40000];
  sizes.fold((), |u: Unit, n: Int| {
    let xs = upto(n);
    assert_eq([xs.len(), item(xs, 0), item(xs, n - 1)], [n, 0, n - 1]);
    assert_eq(total(xs), n * (n - 1) / 2)
  })
}

// `assert_eq` and a list pattern read a list as the runtime walks it, by the shape it lays out.
test "a list Ply grew is the list the runtime makes of the same items" {
  [31, 32, 33, 65, 1025, 1057, 32769, 32801].fold((), |u: Unit, n: Int|
    assert_eq(upto(n), range(0, n)));
  assert_eq(range(0, 1100).fold([], List::push), range(0, 1100));
  match upto(40000) {
    [a, b, ..rest] -> assert_eq([a, b, rest.len(), item(rest, 39997)], [0, 1, 39998, 39999]),
    _ -> assert(false, Some("forty thousand items match two and a rest")),
  }
}

test "a list held once grows a leaf at a time, never by a copy" {
  let grown = |n: Int| spent(|| pushed([], 0, n).len()).allocations;
  let more = grown(640) - grown(320);
  assert_eq(grown(960) - grown(640), more);
  assert(more < 320, Some(f"{more} allocations for 320 pushes"));
  // A fold that pushes onto what it accumulates holds it once too.
  let gathered = |xs: List<Int>|
    spent(|| xs.fold([], |acc: List<Int>, x: Int| acc.push(x)).len()).allocations;
  assert_eq(gathered(range(0, 640)) - gathered(range(0, 320)), more)
}

test "a shared list is left whole by a push or a set" {
  let xs = upto(40);
  let ys = xs.push(99);
  let zs = xs.set(3, -1);
  assert_eq([xs.len(), ys.len(), zs.len()], [40, 41, 40]);
  assert_eq([item(xs, 3), item(zs, 3), item(ys, 40)], [3, -1, 99]);
  let big = upto(1100);
  let changed = big.set(5, 7).set(1050, 8);
  assert_eq([item(big, 5), item(big, 1050), item(changed, 5), item(changed, 1050)], [5, 1050, 7, 8])
}

test "a set on a list held once replaces in place, and on a shared one copies the path to it" {
  let made = spent(|| upto(1100).len()).allocations;
  assert_eq(spent(|| upto(1100).set(5, 7).len()).allocations, made);
  assert_eq(spent(|| upto(1100).set(1090, 7).len()).allocations, made);
  // Both lists are two levels deep, so the path down to item 5 is as long in either.
  let copied = |n: Int|
    spent(|| {
        let xs = upto(n);
        xs.set(5, 7).len() + xs.len()
      }).allocations
      - spent(|| upto(n).len()).allocations;
  assert(copied(1100) > 0, None);
  assert_eq(copied(2000), copied(1100))
}

test "a push or a set in the tail of a list held once allocates nothing, and in a shared one copies the tail alone" {
  let made = spent(|| upto(40).len()).allocations;
  assert_eq(
    [
      spent(|| upto(40).push(99).len()).allocations,
      spent(|| upto(40).set(35, -1).len()).allocations,
      spent(|| upto(40).set(39, -1).len()).allocations,
    ],
    [made, made, made],
  );
  assert_eq(
    spent(|| {
      let ys = upto(40);
      ys.set(35, -1).len() + ys.len()
    }).allocations,
    made + 1,
  )
}

test "a set down the trie of a list held once allocates nothing, and in a shared one copies the path to it" {
  let made = spent(|| upto(100).len()).allocations;
  assert_eq(spent(|| upto(100).set(37, -1).len()).allocations, made);
  assert_eq(
    spent(|| {
      let zs = upto(100);
      zs.set(37, -1).len() + zs.len()
    }).allocations,
    made + 3,
  )
}

test "every item down the trie is replaced where it lies" {
  let n = 2000;
  let xs = range(0, n).fold(upto(n), |acc: List<Int>, i: Int| acc.set(i, i * 2));
  assert_eq(total(xs), n * (n - 1));
  assert_eq([item(xs, 0), item(xs, 1999)], [0, 3998])
}

test "a list `rest` cut grows and is replaced past what it dropped" {
  let xs = match upto(70) { [_, _, ..r] -> r, _ -> [] };
  let ys = xs.push(70);
  assert_eq([ys.len(), item(ys, 0), item(ys, 67), item(ys, 68)], [69, 2, 69, 70]);
  assert_eq(item(ys.set(0, 5), 0), 5);
  let deep = dropped(upto(2000), 1500);
  let grown = deep.push(2000).set(0, -1);
  assert_eq([grown.len(), item(grown, 0), item(grown, 1), item(grown, 500)], [501, -1, 1501, 2000]);
  assert_eq(item(deep, 0), 1500)
}

test "a shared list is copied where a push fills its tail into the trie" {
  [64, 1056].fold((), |u: Unit, n: Int| {
    let a = upto(n);
    let b = a.push(1);
    let c = a.push(2);
    assert_eq([a.len(), b.len(), c.len()], [n, n + 1, n + 1]);
    assert_eq([item(b, n), item(c, n), item(a, n - 1)], [1, 2, n - 1]);
    assert_eq([total(a), total(b), total(c)], [
      n * (n - 1) / 2,
      n * (n - 1) / 2 + 1,
      n * (n - 1) / 2 + 2,
    ])
  })
}

test "map, filter and fold read a list `rest` cut inside its trie from where it starts" {
  let xs = dropped(upto(2000), 1500);
  assert_eq(xs.fold(0, |s: Int, x: Int| s + x), range(1500, 2000).fold(0, |s: Int, x: Int| s + x));
  assert_eq(xs.map(|x: Int| x - 1500), range(0, 500));
  assert_eq(xs.filter(|x: Int| x % 100 == 0), [1500, 1600, 1700, 1800, 1900])
}

test "a list Ply built is read by the runtime as the list it is" {
  let entries = range(0, 100).fold([], |xs: List<{ key: Int, value: Int }>, i: Int|
    xs.push({ key: i, value: i * i }));
  let m = Map::of_entries(entries);
  assert_eq([m.len(), match m.get(99) { Some(v) -> v, None -> 0 }], [100, 9801])
}

test "items of any type are pushed and replaced, and their counts given back" {
  let words = range(0, 40).fold([], |xs: List<String>, i: Int| xs.push(i.to_string()));
  assert_eq([words.at(3), words.set(3, "x").at(3), words.at(3)], [Some("3"), Some("x"), Some("3")]);
  assert_eq(words.set(35, "x").at(35), Some("x"));
  let recs = range(0, 40).fold([], |xs: List<Rec>, i: Int| xs.push({ name: i.to_string(), n: i }));
  assert_eq(match recs.set(5, { name: "s", n: 0 }).at(5) { Some(r) -> r.name, None -> "" }, "s");
  assert_eq(match recs.at(5) { Some(r) -> r.name, None -> "" }, "5");
  let opts = range(0, 40).fold([], |xs: List<Option<Int>>, i: Int|
    xs.push(if i % 2 == 0 { Some(i) } else { None }));
  assert_eq([opts.at(38), opts.at(39), opts.set(38, None).at(38)], [
    Some(Some(38)),
    Some(None),
    Some(None),
  ]);
  let floats = range(0, 40).fold([], |xs: List<Float>, i: Int| xs.push(Float::of_int(i)));
  assert_eq([floats.at(3), floats.set(3, 0.5).at(3)], [Some(3.0), Some(0.5)]);
  let nested = range(0, 34).fold([], |xs: List<List<Int>>, i: Int| xs.push([i]));
  assert_eq(nested.at(33), Some([33]));
  assert_eq(words.set(35, "x").push("y").len(), 41);
  assert_eq(range(0, 100).fold([], |xs: List<String>, i: Int| xs.push(i.to_string())).len(), 100)
}
