type Record = { name: String, n: Int }

fn upto(n: Int) -> List<Int> = range(0, n).fold([], |xs: List<Int>, i: Int| xs.push(i))

fn dropped(xs: List<Int>, k: Int) -> List<Int> =
  if k <= 0 { xs } else { match xs { [_, ..r] -> dropped(r, k - 1), [] -> [] } }

fn second<a>(xs: List<a>) -> Option<a> = xs.at(1)

test "`at` on a short list returns its items and returns None for indexes that are too large or negative" {
  let xs = [1, 2, 3];
  assert_eq([xs.at(0), xs.at(2), xs.at(3), xs.at(-1)], [Some(1), Some(3), None, None]);
  assert_eq(List::at([], 0), None)
}

test "past 32 items the front is read down the trie, at every depth" {
  let xs = upto(33);
  assert_eq([xs.at(0), xs.at(31), xs.at(32), xs.at(33)], [Some(0), Some(31), Some(32), None]);
  let ys = upto(1100);
  assert_eq([ys.at(500), ys.at(1023), ys.at(1024), ys.at(1099), ys.at(1100)], [
    Some(500),
    Some(1023),
    Some(1024),
    Some(1099),
    None,
  ]);
  let zs = upto(40000);
  assert_eq([zs.at(1), zs.at(32767), zs.at(32768), zs.at(39999)], [
    Some(1),
    Some(32767),
    Some(32768),
    Some(39999),
  ])
}

test "`at` reads every index of a list made by the runtime's `range`, including trie boundaries" {
  let xs = range(0, 2000);
  assert_eq([xs.at(0), xs.at(1023), xs.at(1024), xs.at(1999)], [
    Some(0),
    Some(1023),
    Some(1024),
    Some(1999),
  ])
}

test "`at` on a list cut with `rest` counts from its first remaining item and returns None past its end" {
  let xs = dropped(upto(100), 40);
  assert_eq([xs.at(0), xs.at(59), xs.at(60)], [Some(40), Some(99), None]);
  let ys = dropped(upto(2000), 1500);
  assert_eq([ys.at(0), ys.at(499), ys.at(500)], [Some(1500), Some(1999), None])
}

test "`at` returns an item of any type with that type's value" {
  assert_eq(["a", "b"].at(1), Some("b"));
  assert_eq([Some(1), None].at(1), Some(None));
  assert_eq([Some(1), None].at(0), Some(Some(1)));
  let recs: List<Record> = [{ name: "x", n: 1 }, { name: "y", n: 2 }];
  assert_eq(match recs.at(1) { Some(r) -> r.name, None -> "" }, "y");
  assert_eq([1.5, 2.5].at(0), Some(1.5));
  assert_eq([[1], [2, 3]].at(1), Some([2, 3]));
  let oks: List<Result<Int, String>> = [Ok(1), Err("no")];
  assert_eq(oks.at(1), Some(Err("no")));
  assert_eq(second([true, false]), Some(false));
  assert_eq(second(["p", "q"]), Some("q"))
}

test "reading strings from a long list returns each string with its correct length" {
  let words = range(0, 1100).map(|i: Int| i.to_string());
  assert_eq(match words.at(700) { Some(w) -> w.len(), None -> 0 }, 3);
  assert_eq(match words.at(1099) { Some(w) -> w.len(), None -> 0 }, 4)
}
