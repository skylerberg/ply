import std.show (show)

fn upto(n: Int) -> List<Int> = range(0, n)

fn halves(n: Int) -> List<Float> = range(0, n).map(|i: Int| Float::of_int(i) / 2.0)

fn bytes(n: Int) -> List<U8> = range(0, n).map(|i: Int| U8::of_int(i % 256))

fn odd(n: Int) -> List<Bool> = range(0, n).map(|i: Int| i % 2 == 1)

fn drop_one<a>(xs: List<a>) -> List<a> = match xs { [_, ..rest] -> rest, [] -> [] }

fn squares(n: Int) -> Map<Int, Float> =
  range(0, n).fold(Map::new(), |m: Map<Int, Float>, i: Int| m.insert(i, Float::of_int(i * i)))

fn odd_words() -> List<Int> =
  [8, 16, 4096, 4097, 0 - 8, 9223372036854775807, 0 - 9223372036854775807 - 1]

test "a list of Ints supports reading, setting, mapping, folding, filtering and concatenating, for short and long lists" {
  let xs = upto(100);
  assert_eq([xs.at(0), xs.at(31), xs.at(32), xs.at(99)], [Some(0), Some(31), Some(32), Some(99)]);
  assert_eq(xs.set(50, -1).at(50), Some(-1));
  assert_eq(xs.at(50), Some(50));
  assert_eq(drop_one(drop_one(xs)).len(), 98);
  assert_eq(odd_words().map(|n: Int| n), odd_words());
  assert_eq(odd_words().push(1).at(7), Some(1));
  assert_eq(odd_words().fold(0, |s: Int, n: Int| s +% n), 4097 + 4096 + 16 + 8 - 8 - 1);
  assert_eq([1, 2].concat([3]), [1, 2, 3]);
  assert_eq(xs.filter(|n: Int| n % 10 == 0).len(), 10);
  assert_eq(Array::of_list(odd_words()).get(2), 4096)
}

test "a list of Floats, fixed-width integers or Bools supports reading, setting and mapping" {
  assert_eq(halves(40).at(39), Some(19.5));
  assert_eq(halves(3).set(1, -0.25), [0.0, -0.25, 1.0]);
  assert_eq(bytes(300).at(257), Some(1u8));
  assert_eq([255u8, 0u8].map(|b: U8| wrap_add(b, 1u8)), [0u8, 1u8]);
  assert_eq(odd(35).at(33), Some(true));
  assert_eq(odd(4), [false, true, false, true]);
  assert_eq([18446744073709551615u64, 1u64].at(0), Some(18446744073709551615u64));
  assert_eq([-1i64].at(0), Some(-1i64))
}

test "a list of Ints, Floats or Bools compares, orders, shows, hashes and sorts by its items" {
  assert_eq(upto(40), upto(40));
  assert(upto(40) != upto(40).set(39, 0));
  assert_eq(compare([1, 2], [1, 3]), Less);
  assert_eq(show([1.5, -2.0]), "[1.5, -2.0]");
  assert_eq(show([true, false]), "[true, false]");
  assert_eq(digest(upto(40)), digest(range(0, 40)));
  assert_eq([3, 1, 2].sort(), [1, 2, 3])
}

test "a map with Int keys and Float values supports `get`, `insert`, `remove` and `first` with many entries" {
  let m = squares(100);
  assert_eq([m.get(0), m.get(33), m.get(99), m.get(100)], [
    Some(0.0),
    Some(1089.0),
    Some(9801.0),
    None,
  ]);
  assert_eq(m.len(), 100);
  assert_eq(m.remove(33).get(33), None);
  assert_eq(m.insert(33, -1.0).get(33), Some(-1.0));
  assert_eq(m.first(), Some({ key: 0, value: 0.0 }));
  assert_eq(squares(40), squares(40))
}

test "a list or map literal of constant Ints, Floats or Bools can be read" {
  let ints = [1, 2, 3];
  let floats = [0.5, 1.5];
  let flags = [true, false, true];
  assert_eq([ints.at(2), Some(floats.len()), Some(flags.len())], [Some(3), Some(2), Some(3)]);
  assert_eq(floats.at(1), Some(1.5));
  assert_eq(flags.at(1), Some(false));
  let m = Map::new().insert(1, 2.5).insert(2, 3.5);
  assert_eq(m.get(2), Some(3.5))
}

test "lengths are correct after `set`, dropping items and `remove` on lists and maps of Ints, Floats or Bools" {
  assert_eq(upto(200).set(100, 0).len(), 200);
  assert_eq(drop_one(halves(70)).len(), 69);
  assert_eq(squares(70).remove(5).len(), 69);
  assert_eq([odd(40), odd(3)].len(), 2)
}
