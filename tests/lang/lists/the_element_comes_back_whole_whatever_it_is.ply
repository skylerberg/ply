type Row = { id: Int, name: String }
type Shape = | Circle(Int) | Rect(Int, Int) | Point

fn rows() -> List<Row> = [{ id: 1, name: "a" }, { id: 2, name: "b" }]
fn shapes() -> List<Shape> = [Circle(3), Rect(2, 5), Point]
fn nested() -> List<List<Int>> = [[1, 2], [], [3]]

fn unwrap_int(o: Option<Int>) -> Int = match o { Some(v) -> v, None -> 0 - 1 }

test "`List::at` returns a record element unchanged" {
  assert_eq(rows().at(1), Some({ id: 2, name: "b" }))
}

test "`List::at` returns a sum type element intact, whether the variant has fields or has none" {
  assert_eq(shapes().at(0), Some(Circle(3)));
  assert_eq(shapes().at(1), Some(Rect(2, 5)));
  assert_eq(shapes().at(2), Some(Point))
}

test "`List::at` returns a list element unchanged, so the result can be indexed again" {
  assert_eq(nested().at(0), Some([1, 2]));
  assert_eq(nested().at(1), Some([]));
  assert_eq(unwrap_int(match nested().at(0) { Some(inner) -> inner.at(1), None -> None }), 2)
}
