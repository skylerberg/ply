fn replaced(n: Int) -> Int / {abort.raise} = {
  let xs = map(range(0, n), |x: Int| x + 1);
  match list_at(list_set(xs, 2, 100), 2) { Some(v) -> v, None -> 0 - 1 }
}

fn replaced_beside(n: Int) -> Int / {abort.raise} = {
  let xs = map(range(0, n), |x: Int| x + 1);
  let ys = list_set(xs, 2, 100);
  fold(ys, 0, |acc: Int, x: Int| acc + x)
    + (match list_at(xs, 2) { Some(v) -> v * 1000, None -> 0 - 1 })
}

fn replaced_at(n: Int, i: Int) -> Int / {abort.raise} =
  len(list_set(map(range(0, n), |x: Int| x + 1), i, 0))

fn caught<a>(f: () -> a / {abort.raise}) -> Result<a, String> =
  handle { f() } with { abort.raise(m) -> Err(m), return v -> Ok(v) }

// Five elements sit in one leaf and forty cross several.
test "list_set answers the replaced list, leaves the one it was given whole and raises outside it" {
  fold([5, 40], (), |u: Unit, n: Int| {
    assert_eq(replaced(n), 100);
    assert_eq(replaced_beside(n), n * (n + 1) / 2 - 3 + 100 + 3000)
  });
  assert_eq(replaced_at(3, 2), 3);
  assert(caught(|| replaced_at(3, 3)) != Ok(3));
  assert(caught(|| replaced_at(3, 0 - 1)) != Ok(3))
}
