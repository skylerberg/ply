fn replaced(n: Int) -> Int / {abort.raise} = {
  let xs = range(0, n).map(|x: Int| x + 1);
  match xs.set(2, 100).at(2) { Some(v) -> v, None -> 0 - 1 }
}

fn replaced_beside(n: Int) -> Int / {abort.raise} = {
  let xs = range(0, n).map(|x: Int| x + 1);
  let ys = xs.set(2, 100);
  ys.fold(0, |accumulator: Int, x: Int| accumulator + x)
    + (match xs.at(2) { Some(v) -> v * 1000, None -> 0 - 1 })
}

fn replaced_at(n: Int, i: Int) -> Int / {abort.raise} =
  range(0, n).map(|x: Int| x + 1).set(i, 0).len()

fn caught<a>(f: () -> a / {abort.raise}) -> Result<a, String> =
  handle { f() } with { abort.raise(m) -> Err(m), return v -> Ok(v) }

test "`List::set` returns the changed list, leaves the original list unchanged and raises for an index out of range" {
  [5, 40].fold((), |u: Unit, n: Int| {
    assert_eq(replaced(n), 100);
    assert_eq(replaced_beside(n), n * (n + 1) / 2 - 3 + 100 + 3000)
  });
  assert_eq(replaced_at(3, 2), 3);
  assert(caught(|| replaced_at(3, 3)) != Ok(3));
  assert(caught(|| replaced_at(3, 0 - 1)) != Ok(3))
}
