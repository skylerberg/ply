effect log {
  write note[out](line: String) -> Unit
}

fn pure_first(xs: List<Int>) -> Option<Int> = xs.at(0)

fn loud(xs: List<Int>) -> Option<Int> / {log.write[out]} =
  xs.at({
    log.note[out]("asked");
    0
  })

test "`at` on a list runs no effects, and a function that logs before indexing still returns the element" {
  handle {
    assert_eq(pure_first([10, 20]), Some(10));
    assert_eq(loud([10, 20]), Some(10))
  } with {
    log.note[out](line) -> (),
  }
}
