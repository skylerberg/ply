fn xs() -> List<Int> = [10, 20, 30]

fn head(ys: List<Int>) -> Option<Int> = ys.at(0)
fn last(ys: List<Int>) -> Option<Int> = ys.at(ys.len() - 1)

test "every position of a three-element list" {
  assert_eq(xs().at(0), Some(10));
  assert_eq(xs().at(1), Some(20));
  assert_eq(xs().at(2), Some(30))
}

test "`head` and `last` return the first and last elements, or None for an empty list" {
  assert_eq(head(xs()), Some(10));
  assert_eq(last(xs()), Some(30));
  assert_eq(head([]), None);
  assert_eq(last([]), None)
}
