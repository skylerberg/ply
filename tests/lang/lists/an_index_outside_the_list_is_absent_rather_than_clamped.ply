fn xs() -> List<Int> = [10, 20, 30]

test "at the end and past it" {
  assert_eq(xs().at(3), None);
  assert_eq(xs().at(4), None)
}

test "a negative index is absent, not the last element" {
  assert_eq(xs().at(-1), None);
  assert_eq(xs().at(-3), None)
}

test "the extremes of Int" {
  assert_eq(xs().at(9223372036854775807), None);
  assert_eq(xs().at(0 - 9223372036854775807 - 1), None)
}

test "the empty list has no element anywhere" {
  assert_eq([].at(0), None);
  assert_eq([].at(1), None);
  assert_eq([].at(-1), None)
}
