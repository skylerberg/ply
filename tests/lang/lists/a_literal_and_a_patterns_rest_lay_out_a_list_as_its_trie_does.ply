type Record = { name: String, n: Int }

fn upto(n: Int) -> List<Int> = range(0, n).fold([], |xs: List<Int>, i: Int| xs.push(i))

fn words(n: Int) -> List<String> = range(0, n).map(|i: Int| i.to_string())

fn recs(n: Int) -> List<Record> = range(0, n).map(|i: Int| { name: i.to_string(), n: i })

fn maybes(n: Int) -> List<Option<Int>> =
  range(0, n).map(|i: Int| if i % 3 == 0 { None } else { Some(i) })

fn drop_two<a>(xs: List<a>) -> List<a> = match xs { [_, _, ..rest] -> rest, _ -> [] }

fn second(xs: List<Int>) -> Int = match xs { [_, b, ..] -> b, _ -> -1 }

fn by_rests(xs: List<Int>, accumulator: List<Int>) -> List<Int> =
  match xs { [] -> accumulator, [x, ..rest] -> by_rests(rest, accumulator.push(x)) }

test "a list literal of non-constant items has the right items when it has 3 items and when it has dozens" {
  let n = 7;
  assert_eq([n, n + 1, n + 2], range(7, 10));
  let full = [
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
  ];
  assert_eq([full.len(), full.push(1).len()], [32, 33]);
  let long = [
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n,
    n + 1,
    n + 2,
    n + 3,
  ];
  assert_eq(long.len(), 67);
  assert_eq([long.at(0), long.at(40), long.at(64), long.at(66)], [
    Some(7),
    Some(7),
    Some(8),
    Some(10),
  ]);
  assert_eq(long.push(0).set(65, 0).at(65), Some(0));
  assert_eq(drop_two(long).len(), 65);
  let s = "x";
  assert_eq([s, s, s].len(), 3)
}

test "a pattern reads an item from the tail or down the trie, and its rest shares the trie" {
  let xs = upto(2000);
  assert_eq(second(xs), 1);
  let cut = drop_two(drop_two(xs));
  assert_eq([cut.len(), second(cut)], [1996, 5]);
  assert_eq(cut.at(1990), Some(1994));
  assert_eq(cut.push(7).at(1996), Some(7));
  assert_eq(by_rests(upto(70), []), upto(70));
  assert_eq(drop_two(words(34)), range(2, 34).map(|i: Int| i.to_string()));
  assert_eq(drop_two(maybes(4)), [Some(2), None]);
  assert_eq(drop_two([1, 2]), []);
  assert_eq(drop_two(words(70)).len(), 68);
  assert_eq(drop_two(recs(40)).len() + drop_two(recs(3)).len(), 39)
}
