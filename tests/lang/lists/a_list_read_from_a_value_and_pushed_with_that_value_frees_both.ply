type Tree = | Node({ name: Bytes, children: List<Tree> }) | Leaf

fn pushed(t: Tree, y: Tree) -> List<Tree> = match t { Node(c) -> c.children.push(y), Leaf -> [] }

fn concatenated(t: Tree, ys: List<Tree>) -> List<Tree> =
  match t { Node(c) -> c.children.concat(ys), Leaf -> [] }

fn children(t: Tree) -> Int = match t { Node(c) -> c.children.len(), Leaf -> 0 }

test "a list read out of a value and pushed with that same value leaves the value whole and frees both" {
  let t = Node({ name: b"root", children: [] });
  assert_eq(pushed(t, t).len(), 1);
  assert_eq(concatenated(t, [t, Leaf, t]).len(), 3);
  assert_eq(children(t), 0)
}
