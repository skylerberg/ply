type Record = { name: String, tags: List<Int> }

type Shape = | Dot | Line(List<Int>)

type Tree<a> = | Leaf(a) | Node(List<Tree<a>>)

type Nest<a> = | Flat(a) | Deep(Nest<a>, List<a>)

type Rise<a> = | Base(a) | Rise(Fall<a>, List<a>)

type Fall<a> = | Fall(Rise<a>)

type Wrap<a> = | Wrapped(a) | Nested(Nest<Int>)

fn record(name: String, tags: List<Int>) -> Record = { name: name, tags: tags }

fn same<a>(x: a, y: a) -> Bool = x == y

fn order<a>(x: a, y: a) -> Ordering
  where derivable(ord, a)
= compare(x, y)

test "two lists are equal where each item is equal to the other's at its place" {
  assert([1, 2, 3] == [1, 2, 3]);
  assert([1, 2, 3] != [1, 2]);
  assert([1, 2] != [1, 3]);
  let none: List<Int> = [];
  assert(none == []);
  assert([1.50m, 2.0m] == [1.5m, 2m]);
  assert([0.0] == [-0.0]);
  assert([0.0 / 0.0] != [0.0 / 0.0]);
  assert([[1], [2, 3]] == [[1], [2, 3]]);
  assert([[1], [2, 3]] != [[1], [3, 2]]);
  assert(["a", "bc"] == ["a", "bc"]);
  assert([Some([1]), None] == [Some([1]), None]);
  assert([Some([1]), None] != [Some([2]), None]);
  assert([Line([1]), Dot] == [Line([1]), Dot]);
  assert([Line([1]), Dot] != [Line([2]), Dot])
}

test "`==` on records, options and constructors that contain lists compares the lists item by item" {
  assert(record("r", [1, 2]) == record("r", [1, 2]));
  assert(record("r", [1, 2]) != record("r", [2, 1]));
  let nested: { shape: Shape, inner: { tree: Tree<Int>, ok: Result<Int, String> } } = {
    shape: Line([1]),
    inner: { tree: Node([Leaf(1)]), ok: Err("e") },
  };
  assert(nested == { shape: Line([1]), inner: { tree: Node([Leaf(1)]), ok: Err("e") } });
  assert(nested != { shape: Line([1]), inner: { tree: Node([Leaf(2)]), ok: Err("e") } });
  assert(nested != { shape: Dot, inner: { tree: Node([Leaf(1)]), ok: Err("e") } });
  assert([record("r", [1])] != [record("s", [1])]);
  let a: Option<List<String>> = Some(["x"]);
  assert(a == Some(["x"]));
  assert(a != Some(["y"]));
  let big = 4611686018427387904;
  let n: Option<Int> = Some(big);
  assert(n == Some(big));
  assert(n != Some(1));
  let s: Option<String> = Some("x");
  assert(s == Some("x"));
  assert(s != Some("y"));
  let t: Option<Bool> = Some(true);
  assert(t != Some(false));
  assert(a != None);
  assert(None != a);
  let entries = Map::new().insert(1, ["x"]);
  assert(entries.get(1) != None);
  assert(entries.get(2) == None);
  assert(Line([4, 5]) == Line([4, 5]));
  assert(Line([4, 5]) != Line([4]))
}

test "an array and a map compare as their items and entries do" {
  assert(Array::of_list([1, 2]) == Array::of_list([1, 2]));
  assert(Array::of_list([1, 2]) != Array::of_list([2, 1]));
  let m = Map::new().insert("a", [1]).insert("b", [2, 3]);
  assert(m == Map::new().insert("b", [2, 3]).insert("a", [1]));
  assert(m != Map::new().insert("a", [1]).insert("b", [2]));
  assert(m != Map::new().insert("a", [1]))
}

test "a generic sum type compares and orders by its arguments, using the argument types" {
  assert(Node([Leaf([1]), Leaf([])]) == Node([Leaf([1]), Leaf([])]));
  assert(Node([Leaf([1])]) != Node([Leaf([2])]));
  assert(Leaf(1.50m) == Leaf(1.5m));
  assert_eq(compare(Leaf([1, 2]), Leaf([1, 3])), Less);
  assert_eq(compare(Node([Leaf("b")]), Leaf("a")), Greater);
  assert(same(Node([Leaf(1)]), Node([Leaf(1)])));
  assert(Deep(Flat([1]), [[1]]) == Deep(Flat([1]), [[1]]));
  assert(Deep(Deep(Flat([1]), []), [[1]]) != Deep(Deep(Flat([2]), []), [[1]]));
  assert(Deep(Flat([1]), [[1]]) != Deep(Flat([1]), [[1], []]));
  assert_eq(compare(Deep(Flat(1), [1]), Flat(5)), Less);
  assert(Rise(Fall(Base([1])), []) == Rise(Fall(Base([1])), []));
  assert(Rise(Fall(Base([1])), []) != Rise(Fall(Base([2])), []));
  assert_eq(compare(Rise(Fall(Base([1])), []), Base([5])), Greater);
  assert(Nested(Deep(Flat(1), [1])) == Nested(Deep(Flat(1), [1])));
  assert(Nested(Deep(Flat(1), [1])) != Nested(Flat(1)));
  assert_eq(compare(Wrapped([2]), Nested(Flat(0))), Greater)
}

test "a generic definition compares a container as the type it is called at" {
  assert(same([1, 2], [1, 2]));
  assert(!same([[1]], [[2]]));
  assert(same(Map::new().insert(1, ["a"]), Map::new().insert(1, ["a"])));
  assert(!same([1.0], [1.5]))
}

test "lists order by their first differing items, and a list is less than a longer list that starts with it" {
  assert_eq(compare([1, 2], [1, 3]), Less);
  assert_eq(compare([2], [1, 9]), Greater);
  assert_eq(compare([1, 2], [1, 2, 0]), Less);
  let none: List<Int> = [];
  assert_eq(compare(none, []), Equal);
  assert_eq(compare([[1, 2]], [[1], [5]]), Greater);
  assert_eq(compare(["b"], ["ab"]), Greater);
  assert_eq(order([1, 2], [1, 2]), Equal);
  assert_eq(compare(Array::of_list([3]), Array::of_list([3, 1])), Less);
  assert_eq(compare(Map::new().insert(1, "a"), Map::new().insert(1, "b")), Less);
  assert_eq(compare(Map::new().insert(2, "a"), Map::new().insert(1, "z")), Greater);
  assert_eq(compare(record("r", [1, 2]), record("r", [1, 3])), Less);
  let missing: Option<List<Int>> = None;
  assert_eq(compare(missing, Some([1])), Less);
  assert_eq(compare(Some([2]), Some([1, 9])), Greater);
  assert_eq(compare(Some([1]), missing), Greater);
  assert_eq(compare(missing, missing), Equal);
  assert_eq(compare(Map::new().insert(1, [2]), Map::new().insert(1, [1, 5])), Greater)
}
