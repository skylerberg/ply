fn at_or_zero(xs: List<Int>, i: Int) -> Int = match xs.at(i) { Some(v) -> v, None -> 0 }

fn sum_by_index(xs: List<Int>) -> Int =
  range(0, xs.len()).fold(0, |accumulator, i| accumulator + at_or_zero(xs, i))

test "reading each of ten thousand list elements by index in a loop returns the correct sum" {
  assert_eq(sum_by_index(range(0, 10000)), 49995000)
}
