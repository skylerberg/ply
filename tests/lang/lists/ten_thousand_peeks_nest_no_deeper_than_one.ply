fn at_or_zero(xs: List<Int>, i: Int) -> Int = match xs.at(i) { Some(v) -> v, None -> 0 }

fn sum_by_index(xs: List<Int>) -> Int = range(0, xs.len()).fold(0, |acc, i| acc + at_or_zero(xs, i))

test "a peek per element over ten thousand elements" {
  assert_eq(sum_by_index(range(0, 10000)), 49995000)
}
