import std.list

type Inner = { label: String, tag: Option<String> }

type Record = { inner: Inner, n: Int }

type Tree = | Leaf(Int) | Node(List<Tree>)

effect note {
  write said(n: Int) -> Unit
}

fn record(n: Int) -> Record =
  { inner: { label: "r" ++ n.to_string(), tag: if n > 1 { Some("big") } else { None } }, n: n }

fn twice(n: Int) -> Int = n * 2

fn summed(t: Tree) -> Int =
  match t {
    Leaf(n) -> n,
    Node(ts) -> ts.fold(0, |accumulator: Int, s: Tree| accumulator + summed(s)),
  }

fn labels<a>(xs: List<a>, f: (a) -> String) -> List<String> = xs.map(f)

fn noted(xs: List<Int>) -> List<Int> / {note.said} =
  xs.map(|n: Int| {
    note.said(n);
    n + 1
  })

type Transcript = { value: List<Int>, emitted: List<Int> }

type ByParity = { evens: List<Int>, odds: List<Int> }

type FoldState = { sorted: ByParity, seen: List<Int> }

type Tally = { total: Int, count: Int }

fn transcript(f: () -> List<Int> / {note.said}) -> Transcript =
  handle {
    f()
  } with {
    note.said(n) resume k -> {
      let rest: Transcript = k(());
      { ..rest, emitted: [n].concat(rest.emitted) }
    },
    return v -> { value: v, emitted: [] },
  }

fn summed_with(r: Record, xs: List<Int>) -> Int =
  xs.fold(0, |accumulator: Int, x: Int| accumulator + x + r.n + r.inner.label.len())

fn labelled_with(r: Record, xs: List<Int>) -> List<String> =
  xs.map(|x: Int| r.inner.label ++ x.to_string())

fn caught<a>(f: () -> a / {abort.raise}) -> Result<a, String> =
  handle { f() } with { abort.raise(m) -> Err(m), return v -> Ok(v) }

test "`map`, `filter` and `fold` give correct results for Ints, U8s, Decimals, strings, records, options and lists" {
  let big = 4611686018427387904;
  assert_eq([1, big, 0 - big].map(|n: Int| n / 2), [0, big / 2, 0 - big / 2]);
  assert_eq([200u8, 7u8].map(|b: U8| b / 2u8), [100u8, 3u8]);
  assert_eq([1.50m, 2.25m].fold(0.0m, |a: Decimal, d: Decimal| a + d), 3.75m);
  assert_eq(["a", "bb", ""].filter(|s: String| s.len() > 0), ["a", "bb"]);
  assert_eq([record(1), record(2), record(3)].filter(|r: Record| r.inner.tag != None), [
    record(2),
    record(3),
  ]);
  assert_eq([Some(record(1)), None].map(|o: Option<Record>| o != None), [true, false]);
  assert_eq([[1, 2], [], [3]].map(|xs: List<Int>| xs.len()), [2, 0, 1]);
  assert_eq([1, 2, 3].map(|n: Int| record(n).inner.label), ["r1", "r2", "r3"]);
  assert_eq([].map(|n: Int| n + 1), []);
  assert_eq([].filter(|s: String| s == ""), []);
  assert_eq([].fold(7, |a: Int, n: Int| a + n), 7)
}

test "a named function, a captured value and a function parameter each run once per element" {
  let k = 10;
  assert_eq([1, 2].map(twice), [2, 4]);
  assert_eq([200u8, 100u8].fold(0u8, wrap_add), 44u8);
  assert_eq([1, 2].map(|n: Int| n + k), [11, 12]);
  assert_eq(labels([record(1), record(2)], |r: Record| r.inner.label), ["r1", "r2"]);
  assert_eq(labels([3, 4], |n: Int| n.to_string()), ["3", "4"]);
  assert_eq([[1, 2], [3]].map(|xs: List<Int>| xs.map(|n: Int| n * k)), [[10, 20], [30]]);
  assert_eq(
    [1, 2, 3, 4].fold([], |accumulator: List<Int>, n: Int|
      if n % 2 == 0 { accumulator.push(n) } else { accumulator }),
    [2, 4],
  )
}

test "effects performed by the function passed to `map` reach the effect handler in list order" {
  assert_eq(transcript(|| noted([1, 2, 3])), { value: [2, 3, 4], emitted: [1, 2, 3] })
}

test "an error raised partway through `map` or `fold` stops it, and the caught result is that error" {
  assert_eq(
    caught(||
      [record(1), record(2), record(3)].map(|r: Record|
        if r.n == 2 { abort.raise("two") } else { r.inner })),
    Err("two"),
  );
  assert_eq(
    caught(||
      [1, 2, 3].fold(0, |a: Int, x: Int| if x == 3 { abort.raise("three") } else { a + x })),
    Err("three"),
  )
}

test "a lambda that captures a record reads all of the record's fields on every call" {
  assert_eq(summed_with(record(2), [1, 2, 3]), 18);
  assert_eq(labelled_with(record(2), [1, 2]), ["r21", "r22"])
}

test "a fold over a record containing a record returns the right result whichever match arm returns the accumulator" {
  let walked: FoldState = [Some(1), None, Some(4), Some(5), None].fold(
    { sorted: { evens: [], odds: [] }, seen: [] },
    |accumulator: FoldState, o: Option<Int>|
      match o {
        None -> { ..accumulator, seen: accumulator.seen.push(0) },
        Some(n) -> if n % 2 == 0 {
          {
            sorted: { ..accumulator.sorted, evens: accumulator.sorted.evens.push(n) },
            seen: accumulator.seen.push(n),
          }
        } else {
          {
            sorted: { ..accumulator.sorted, odds: accumulator.sorted.odds.push(n) },
            seen: accumulator.seen.push(n),
          }
        },
      },
  );
  assert_eq(walked, { sorted: { evens: [4], odds: [1, 5] }, seen: [1, 0, 4, 5, 0] });
  assert_eq(walked.sorted.odds.push(7), [1, 5, 7])
}

test "a fold walks a tree through its own recursion" {
  assert_eq(summed(Node([Leaf(1), Node([Leaf(2), Leaf(3)]), Node([])])), 6)
}

test "a lambda that handles an effect can be passed to `map` as a closure and still runs once per element" {
  let doubled = [1, 2, 3].map(|n: Int|
    handle {
      note.said(n);
      n * 2
    } with {
      note.said(m) resume k -> k(()),
      return v -> v,
    });
  assert_eq(doubled, [2, 4, 6]);
  let lengths = [[1], [2, 3]].map(|xs: List<Int>|
    handle {
      note.said(0);
      xs.map(|x: Int| x + 1).len()
    } with {
      note.said(m) resume k -> k(()),
      return v -> v,
    });
  assert_eq(lengths, [1, 2])
}

test "a fold arm that returns its accumulator unchanged leaves the accumulator intact" {
  let t: Tally = [Some(2), None, Some(5)].fold(
    { total: 0, count: 0 },
    |accumulator: Tally, o: Option<Int>|
      match o {
        None -> accumulator,
        Some(n) -> { total: accumulator.total + n, count: accumulator.count + 1 },
      },
  );
  assert_eq(t, { total: 7, count: 2 })
}

test "a `parallel` block works inside a lambda passed to `List::map`" {
  assert_eq([1, 2].map(|m: Int| parallel { m + 1, m * 10 }), [(2, 10), (3, 20)])
}
