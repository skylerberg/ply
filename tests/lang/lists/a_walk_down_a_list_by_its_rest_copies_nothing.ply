//! A definition that walks down a list by handing its rest back to itself reads the list it was
//! handed from further on at each step rather than copying what is left: the walk allocates
//! nothing, whatever the list's length. A rest asked for as a list in any other way is one.

fn has(xs: List<Int>, x: Int) -> Bool =
  match xs { [] -> false, [y, ..rest] -> if y == x { true } else { has(rest, x) } }

fn first_over(xs: List<Int>, n: Int) -> Option<Int> =
  match xs { [] -> None, [y, ..rest] -> if y > n { Some(y) } else { first_over(rest, n) } }

/// Two elements a step, with an accumulator beside the list.
fn pair_sums(xs: List<Int>, acc: Int) -> Int =
  match xs { [a, b, ..rest] -> pair_sums(rest, acc + a * b), [a] -> acc + a, [] -> acc }

/// The rest read whole, as a length and as a value, on the way down.
fn lengths(xs: List<Int>, acc: List<Int>) -> List<Int> =
  match xs { [] -> acc, [_, ..rest] -> lengths(rest, acc.push(rest.len())) }

/// A walk that starts again on another list, `again` times, each time it reaches the end.
fn counted(xs: List<Int>, again: Int, acc: Int) -> Int =
  match xs {
    [] -> if again > 0 { counted([7, 8], again - 1, acc) } else { acc },
    [_, ..rest] -> counted(rest, again, acc + 1),
  }

/// The whole list bound by an arm of the walk.
fn tail_of(xs: List<Int>, n: Int) -> List<Int> =
  match xs { [] -> [], [y, ..rest] -> if y == n { rest } else { tail_of(rest, n) } }

fn captured(xs: List<Int>, n: Int) -> List<Int> =
  match xs {
    [] -> [],
    [y, ..rest] -> if y == n { [0].map(|_: Int| rest.len()) } else { captured(rest, n) },
  }

test "a walk down a list by its rest answers what copying the rest would" {
  let xs = range(0, 50);
  assert(has(xs, 49));
  assert(!has(xs, 50));
  assert_eq(first_over(xs, 40), Some(41));
  assert_eq(first_over(xs, 60), None);
  assert_eq(pair_sums([1, 2, 3, 4, 5], 0), 19);
  assert_eq(lengths([5, 6, 7], []), [2, 1, 0]);
  assert_eq(counted([1, 2, 3], 1, 0), 5);
  assert_eq(tail_of([1, 2, 3, 4], 2), [3, 4]);
  assert_eq(tail_of(range(0, 40), 35), [36, 37, 38, 39]);
  assert_eq(captured([1, 2, 3], 1), [2])
}

test "a walk down a list by its rest allocates nothing at any length" {
  let small = range(0, 10);
  let large = range(0, 1000);
  assert_eq(metered(|| has(small, 0 - 1)).allocations, 0);
  assert_eq(metered(|| has(large, 0 - 1)).allocations, 0);
  assert_eq(metered(|| pair_sums(large, 0)).allocations, 0)
}

test "a walk down a list by its rest gives back every count it took" {
  let xs = range(0, 100);
  assert_eq(metered(|| if has(xs, 99) { 1 } else { 0 }).live, 0);
  assert_eq(metered(|| lengths(xs, []).len()).live, 0);
  assert_eq(metered(|| tail_of(xs, 50).len()).live, 0);
  assert_eq(metered(|| captured(xs, 50).len()).live, 0);
  assert_eq(metered(|| counted([1, 2, 3], 1, 0)).live, 0)
}
