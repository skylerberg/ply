fn has(xs: List<Int>, x: Int) -> Bool =
  match xs { [] -> false, [y, ..rest] -> if y == x { true } else { has(rest, x) } }

fn first_over(xs: List<Int>, n: Int) -> Option<Int> =
  match xs { [] -> None, [y, ..rest] -> if y > n { Some(y) } else { first_over(rest, n) } }

fn pair_sums(xs: List<Int>, accumulator: Int) -> Int =
  match xs {
    [a, b, ..rest] -> pair_sums(rest, accumulator + a * b),
    [a] -> accumulator + a,
    [] -> accumulator,
  }

fn lengths(xs: List<Int>, accumulator: List<Int>) -> List<Int> =
  match xs { [] -> accumulator, [_, ..rest] -> lengths(rest, accumulator.push(rest.len())) }

fn counted(xs: List<Int>, again: Int, accumulator: Int) -> Int =
  match xs {
    [] -> if again > 0 { counted([7, 8], again - 1, accumulator) } else { accumulator },
    [_, ..rest] -> counted(rest, again, accumulator + 1),
  }

fn tail_of(xs: List<Int>, n: Int) -> List<Int> =
  match xs { [] -> [], [y, ..rest] -> if y == n { rest } else { tail_of(rest, n) } }

fn captured(xs: List<Int>, n: Int) -> List<Int> =
  match xs {
    [] -> [],
    [y, ..rest] -> if y == n { [0].map(|_: Int| rest.len()) } else { captured(rest, n) },
  }

test "a recursive walk down a list by its `rest` returns the same results as copying the rest at each step" {
  let xs = range(0, 50);
  assert(has(xs, 49));
  assert(!has(xs, 50));
  assert_eq(first_over(xs, 40), Some(41));
  assert_eq(first_over(xs, 60), None);
  assert_eq(pair_sums([1, 2, 3, 4, 5], 0), 19);
  assert_eq(lengths([5, 6, 7], []), [2, 1, 0]);
  assert_eq(counted([1, 2, 3], 1, 0), 5);
  assert_eq(tail_of([1, 2, 3, 4], 2), [3, 4]);
  assert_eq(tail_of(range(0, 40), 35), [36, 37, 38, 39]);
  assert_eq(captured([1, 2, 3], 1), [2])
}

test "a recursive walk down a long list by its `rest` returns results of the correct lengths" {
  let xs = range(0, 100);
  assert(has(xs, 99));
  assert_eq(
    [
      lengths(xs, []).len(),
      tail_of(xs, 50).len(),
      captured(xs, 50).len(),
      counted([1, 2, 3], 1, 0),
    ],
    [100, 49, 1, 5],
  )
}
