type Point = { x: Int, y: Int }

type Segment = { from: Point, label: String, to: Point }

type Layered = { at: { pos: Point, layer: Int }, name: String }

fn segment(from: Point, to: Point, label: String) -> Segment = { from: from, label: label, to: to }

fn span(s: Segment) -> Int = s.to.x - s.from.x + (s.to.y - s.from.y)

fn start(s: Segment) -> Point = s.from

fn relabelled(s: Segment, label: String) -> Segment = { ..s, label: label }

fn retargeted(s: Segment, to: Point) -> Segment = { ..s, to: to }

fn wrapped<a>(value: a) -> { inner: a } = { inner: value }

fn shifted_end(s: Segment, steps: Int) -> Segment =
  if steps <= 0 { s } else { shifted_end(retargeted(s, { x: s.to.x + 1, y: s.to.y }), steps - 1) }

test "a record with record-typed fields returns those fields and its other fields correctly" {
  let s = segment({ x: 1, y: 2 }, { x: 4, y: 6 }, "s");
  assert_eq(span(s), 7);
  assert_eq(start(s), { x: 1, y: 2 });
  assert_eq(s.label, "s")
}

test "an update changes a record that has no other references and copies one that is shared, leaving the original unchanged" {
  let s = segment({ x: 0, y: 0 }, { x: 1, y: 1 }, "a");
  let relabel = relabelled(s, "b");
  let retarget = retargeted(s, { x: 5, y: 5 });
  assert_eq(s, { from: { x: 0, y: 0 }, label: "a", to: { x: 1, y: 1 } });
  assert_eq(relabel.label, "b");
  assert_eq(relabel.to, { x: 1, y: 1 });
  assert_eq(retarget.to, { x: 5, y: 5 });
  assert_eq(shifted_end(retarget, 100).to.x, 105)
}

test "generic code and a map's entries store records with record-typed fields unchanged" {
  let twice = wrapped(wrapped({ x: 3, y: 4 }));
  assert_eq(twice.inner.inner.y, 4);
  let keyed = Map::new().insert({ x: 2, y: 0 }, "two").insert({ x: 1, y: 9 }, "one");
  assert_eq(keyed.first(), Some({ key: { x: 1, y: 9 }, value: "one" }));
  let layered: Map<String, Layered> = Map::new().insert("p", {
    at: { pos: { x: 7, y: 8 }, layer: 2 },
    name: "p",
  });
  assert_eq(
    layered.entries().fold(0, |accumulator: Int, e: { key: String, value: Layered }|
      accumulator + e.value.at.pos.y),
    8,
  )
}

test "records with record-typed fields compare, order and work as map keys by their fields" {
  let a = segment({ x: 0, y: 0 }, { x: 1, y: 1 }, "a");
  let b = segment({ x: 0, y: 0 }, { x: 1, y: 2 }, "a");
  assert(a != b);
  assert_eq(compare(a, b), Less);
  assert_eq(Map::new().insert(b, 1).get(segment({ x: 0, y: 0 }, { x: 1, y: 2 }, "a")), Some(1))
}

test "a parallel block returns records with correct fields" {
  let both = parallel { { x: 1, y: 2 }, { x: 3, y: 4 } };
  assert_eq(both._0.x + both._1.y, 5)
}
