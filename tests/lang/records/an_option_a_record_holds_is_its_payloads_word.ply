import std.bin

type Entry = { name: String, note: Option<String>, rank: Option<Int> }

type Tagged = | Tag(Option<String>, Int) | Untagged

derive bin for Entry

fn noted(e: Entry) -> String = match e.note { Some(n) -> n, None -> "-" }

fn tag_of(t: Tagged) -> String =
  match t { Tag(Some(s), _) -> s, Tag(None, n) -> n.to_string(), Untagged -> "" }

fn first_of<a>(p: { first: a, n: Int }) -> a = p.first

fn paired<a>(x: a) -> { first: a, n: Int } = { first: x, n: 1 }

test "an option field of a record is read, compared, used as a map key and encoded like a standalone option" {
  let set = { name: "a", note: Some("x"), rank: Some(1) };
  let unset = { name: "a", note: None, rank: None };
  assert_eq(noted(set), "x");
  assert_eq(noted(unset), "-");
  assert_eq(set.rank, Some(1));
  assert(set != unset && unset == { name: "a", note: None, rank: None }, None);
  assert_eq({ ..set, note: None }, { name: "a", note: None, rank: Some(1) });
  assert_eq({ ..unset, note: Some("y") }.note, Some("y"));
  let m = Map::new().insert(set, 1).insert(unset, 2);
  assert_eq([m.get(set), m.get(unset)], [Some(1), Some(2)]);
  assert_eq([tag_of(Tag(Some("s"), 1)), tag_of(Tag(None, 2)), tag_of(Untagged)], ["s", "2", ""]);
  assert_eq(Tag(None, 2), Tag(None, 2));
  let xs = Array::of_list([Some("a"), None, Some("c")]);
  assert_eq([xs.at(0), xs.at(1), xs.at(3)], [Some(Some("a")), Some(None), None]);
  assert_eq(bin::decode(bin::encode(set, entry_bin()), entry_bin()), Ok(set));
  assert_eq(bin::decode(bin::encode(unset, entry_bin()), entry_bin()), Ok(unset))
}

test "a generic function reads and builds a record's option field correctly" {
  assert_eq(first_of({ first: Some("x"), n: 1 }), Some("x"));
  assert_eq(paired(None).first, None);
  assert_eq(first_of(paired(Some(2))), Some(2))
}
