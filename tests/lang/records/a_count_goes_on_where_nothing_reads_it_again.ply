type State = { out: Bytes, n: Int }

type Step = | More(Bytes, () -> Step) | Over

fn stepping(s: State) -> () -> Step =
  ||
    if s.n <= 0 { Over } else {
      let next = { out: s.out ++ b"x", n: s.n - 1 };
      More(next.out, stepping(next))
    }

fn last_buffer(k: keep () -> Step, fuel: Int) -> Bytes =
  match k() {
    Over -> b"",
    More(b, rest) -> if fuel <= 1 { b } else { last_buffer(rest, fuel - 1) },
  }

fn whole(s: State) -> Int = s.n

fn beside_whole(s: State, fuel: Int) -> Bytes =
  if fuel <= 0 { s.out } else {
    let out = s.out;
    if s.n < 0 { beside_whole({ ..s, n: whole(s) }, fuel - 1) }
    else { beside_whole({ ..s, out: out ++ b"y" }, fuel - 1) }
  }

fn beside_read(s: State, fuel: Int) -> Bytes =
  if fuel <= 0 { s.out } else {
    let out = s.out;
    if s.n < 0 { beside_read(s, fuel - 1) }
    else { beside_read({ out: out ++ b"v", n: 0 }, fuel - 1) }
  }

fn with_length(buffer: Bytes, length: Int) -> Bytes = if length < 0 { b"" } else { buffer ++ b"z" }

fn passed(buffer: Bytes, fuel: Int) -> Bytes =
  if fuel <= 0 { buffer } else { passed(with_length(buffer, buffer.len()), fuel - 1) }

fn increment_counts(c: Array<Int>, i: Int, n: Int) -> Array<Int> / {abort.raise} =
  if i >= n { c } else { increment_counts(c.set(i % 64, c.get(i % 64) + 1), i + 1, n) }

type Pair = | Pair(Bytes, Int)

fn both(p: Pair, h: State, fuel: Int) -> Bytes =
  match p {
    Pair(b, n) -> if fuel <= 0 { b }
    else if n < 0 { both(Pair(b, n + 1), { ..h, n: h.n + 1 }, fuel - 1) }
    else { both(Pair(b ++ b"q", n), { out: b"", n: fuel }, fuel - 1) },
  }

fn shapes() -> List<String> =
  [
    "a step its caller holds alone",
    "a branch beside one that reads the record whole",
    "a branch beside one that reads the variable",
    "a call with an argument after it that reads it",
    "an arm that lets its subject and a sibling's record go into one token",
  ]

fn grown(name: String, n: Int) -> Bytes =
  if name == "a step its caller holds alone" { last_buffer(stepping({ out: b"", n: n }), n) }
  else if name == "a branch beside one that reads the record whole" {
    beside_whole({ out: b"", n: 0 }, n)
  } else if name == "a branch beside one that reads the variable" {
    beside_read({ out: b"", n: 0 }, n)
  } else if name == "a call with an argument after it that reads it" { passed(b"", n) }
  else { both(Pair(b"", 0), { out: b"h", n: 0 }, n) }

test "for a record with one field named {s}, appending 2000 times returns a buffer of length 2000" for s: String in shapes(
  ) { assert_eq(grown(s, 2000).len(), 2000) }

test "an array passed as an argument before another argument that reads the array still contains all 2000 increments made to its elements" {
  assert_eq(increment_counts(Array::new(64, 0), 0, 2000).get(0), 32)
}

test "calling the same step function twice on the same record returns the same buffer both times" {
  let k = stepping({ out: b"ab", n: 3 });
  assert_eq(last_buffer(k, 3), b"abxxx");
  assert_eq(last_buffer(k, 3), b"abxxx");
  assert_eq(last_buffer(k, 1), b"abx")
}

test "a variable or field that is read again later keeps its original value after a call changes a copy" {
  let s: State = { out: b"cd", n: -1 };
  assert_eq(beside_whole(s, 2), b"cd");
  assert_eq(beside_read(s, 2), b"cd");
  assert_eq(beside_whole({ out: b"cd", n: 1 }, 2), b"cdyy");
  assert_eq(s.out, b"cd");
  let buffer = b"pq";
  assert_eq(passed(buffer, 2), b"pqzz");
  assert_eq(buffer, b"pq");
  let h: State = { out: b"h", n: 5 };
  assert_eq(both(Pair(b"a", -2), h, 4), b"aqq");
  assert_eq(h, { out: b"h", n: 5 })
}
