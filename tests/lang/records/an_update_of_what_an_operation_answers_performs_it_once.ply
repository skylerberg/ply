//! The base of a record update may be an operation, which is performed once however many fields
//! the update copies from it.

type Window = { low: Int, high: Int, step: Int }

effect stock {
  read window() -> Window
}

fn widened() -> { value: Window, asked: Int } =
  handle {
    { ..stock.window(), high: 9 }
  } with {
    var asked = 0,
    stock.window() -> {
      asked = asked + 1;
      { low: 1, high: 2, step: 4 }
    },
    return value -> { value: value, asked: asked },
  }

test "an operation the base of an update is performed once" {
  assert_eq(widened(), { value: { low: 1, high: 9, step: 4 }, asked: 1 })
}
