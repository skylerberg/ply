//! A `match` whose arms answer a small record joins their values and the record's word in locals
//! of its own, as an `if` does: an arm answering a record that already is an object hands on that
//! object, and every count comes back.

type Lookup = { table: List<Int>, key: Int }

type Tree = | Leaf(Int) | Pair(Tree, Tree)

fn lookup(table: List<Int>, t: Tree) -> Lookup = {
  let made = match t {
    Leaf(n) -> { table: table, key: n },
    Pair(a, b) -> {
      let x = lookup(table, a);
      let y = lookup(x.table, b);
      { table: y.table.push(x.key), key: x.key + y.key }
    },
  };
  { table: made.table, key: made.key + 1 }
}

fn tree(n: Int) -> Tree = if n <= 0 { Leaf(1) } else { Pair(tree(n - 1), Leaf(n)) }

/// One arm answers a record it was handed, one a literal and one an update.
fn chosen(c: Int, h: Lookup) -> Lookup =
  match c { 0 -> h, 1 -> { table: [], key: 0 }, _ -> { ..h, key: c } }

/// The records kept, so each arm's answer is asked for as a word.
fn kept(c: Int, h: Lookup) -> List<Lookup> = [chosen(c, h), chosen(c + 1, h)]

test "a match answering a record answers what each arm built" {
  assert_eq(lookup([], Leaf(3)), { table: [], key: 4 });
  assert_eq(lookup([], Pair(Leaf(1), Leaf(2))).key, 6);
  assert_eq(lookup([], tree(5)).table.len(), 5);
  let h = { table: [1, 2], key: 9 };
  assert_eq(chosen(0, h), h);
  assert_eq(chosen(1, h), { table: [], key: 0 });
  assert_eq(chosen(7, h), { table: [1, 2], key: 7 });
  assert_eq(kept(0, h), [h, { table: [], key: 0 }])
}

test "a match answering a record gives back every count it took" {
  let h = { table: [1, 2], key: 9 };
  let t = tree(20);
  assert(lookup([], t).key > 0, None);
  assert_eq(chosen(0, h).key + chosen(1, h).key + chosen(5, h).key, 14);
  assert_eq(kept(0, h).len(), 2)
}
