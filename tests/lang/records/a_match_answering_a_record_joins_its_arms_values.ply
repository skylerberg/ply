//! A `match` whose arms answer a small record joins their values and the record's word in locals
//! of its own, as an `if` does: no arm's record is made to be joined, an arm answering a record
//! that already is an object hands on that object, and every count comes back.

type Held = { table: List<Int>, key: Int }

type T = | Leaf(Int) | Pair(T, T)

fn held(table: List<Int>, t: T) -> Held = {
  let made = match t {
    Leaf(n) -> { table: table, key: n },
    Pair(a, b) -> {
      let x = held(table, a);
      let y = held(x.table, b);
      { table: push(y.table, x.key), key: x.key + y.key }
    },
  };
  { table: made.table, key: made.key + 1 }
}

fn tree(n: Int) -> T = if n <= 0 { Leaf(1) } else { Pair(tree(n - 1), Leaf(n)) }

/// As many pushes as `held` makes over `tree(n)`.
fn pushes(n: Int) -> Int = len(fold(range(0, n), [], |acc: List<Int>, i: Int| push(acc, i)))

/// One arm answers a record it was handed, one a literal and one an update.
fn chosen(c: Int, h: Held) -> Held =
  match c { 0 -> h, 1 -> { table: [], key: 0 }, _ -> { ..h, key: c } }

/// The records kept, so each arm's answer is asked for as a word.
fn kept(c: Int, h: Held) -> List<Held> = [chosen(c, h), chosen(c + 1, h)]

test "a match answering a record answers what each arm built" {
  assert_eq(held([], Leaf(3)), { table: [], key: 4 });
  assert_eq(held([], Pair(Leaf(1), Leaf(2))).key, 6);
  assert_eq(len(held([], tree(5)).table), 5);
  let h = { table: [1, 2], key: 9 };
  assert_eq(chosen(0, h), h);
  assert_eq(chosen(1, h), { table: [], key: 0 });
  assert_eq(chosen(7, h), { table: [1, 2], key: 7 });
  assert_eq(kept(0, h), [h, { table: [], key: 0 }])
}

test "a match answering a record makes no record to join its arms" {
  let t10 = tree(10);
  let t100 = tree(100);
  let cost = |t: T| metered(|| held([], t).key).allocations;
  let grown = |n: Int| metered(|| pushes(n)).allocations;
  // Ninety more levels cost no more than the list they push to grows by.
  assert(
    cost(t100) - cost(t10) <= grown(100) - grown(10),
    Some(f"{cost(t10)} then {cost(t100)} objects"),
  )
}

test "a match answering a record gives back every count it took" {
  let h = { table: [1, 2], key: 9 };
  let t = tree(20);
  assert_eq(metered(|| held([], t).key).live, 0);
  assert_eq(metered(|| chosen(0, h).key + chosen(1, h).key + chosen(5, h).key).live, 0);
  assert_eq(metered(|| len(kept(0, h))).live, 0)
}
