type P = { pos: Int, depth: Int, diags: List<Int> }

fn with_depth(p: P, d: Int) -> P = { pos: p.pos, depth: d, diags: p.diags }

fn noted(p: P, x: Int) -> P = { pos: p.pos, depth: p.depth, diags: p.diags.push(x) }

test "a record holding a list answers its fields however it was built" {
  let n = 4;
  assert_eq({ pos: 0, depth: n, diags: [n] }, { pos: 0, depth: 4, diags: [4] });
  assert_eq(with_depth({ pos: 0, depth: n, diags: [n] }, 9), { pos: 0, depth: 9, diags: [4] });
  assert_eq(noted({ pos: 0, depth: n, diags: [n] }, 7), { pos: 0, depth: 4, diags: [4, 7] });
  let p = { pos: 0, depth: n, diags: [n] };
  assert_eq(with_depth(p, p.depth + 1), { pos: 0, depth: 5, diags: [4] });
  assert_eq(Some({ pos: 0, depth: n, diags: [n] }), Some({ pos: 0, depth: 4, diags: [4] }))
}
