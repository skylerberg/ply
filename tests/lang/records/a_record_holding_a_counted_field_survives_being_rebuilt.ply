type ParserState = { pos: Int, depth: Int, diagnostics: List<Int> }

fn with_depth(p: ParserState, d: Int) -> ParserState =
  { pos: p.pos, depth: d, diagnostics: p.diagnostics }

fn noted(p: ParserState, x: Int) -> ParserState =
  { pos: p.pos, depth: p.depth, diagnostics: p.diagnostics.push(x) }

test "a record holding a list answers its fields however it was built" {
  let n = 4;
  assert_eq({ pos: 0, depth: n, diagnostics: [n] }, { pos: 0, depth: 4, diagnostics: [4] });
  assert_eq(with_depth({ pos: 0, depth: n, diagnostics: [n] }, 9), {
    pos: 0,
    depth: 9,
    diagnostics: [4],
  });
  assert_eq(noted({ pos: 0, depth: n, diagnostics: [n] }, 7), {
    pos: 0,
    depth: 4,
    diagnostics: [4, 7],
  });
  let p = { pos: 0, depth: n, diagnostics: [n] };
  assert_eq(with_depth(p, p.depth + 1), { pos: 0, depth: 5, diagnostics: [4] });
  assert_eq(
    Some({ pos: 0, depth: n, diagnostics: [n] }),
    Some({ pos: 0, depth: 4, diagnostics: [4] }),
  )
}
