type ParserState = { position: Int, depth: Int, diagnostics: List<Int> }

fn with_depth(p: ParserState, d: Int) -> ParserState =
  { position: p.position, depth: d, diagnostics: p.diagnostics }

fn noted(p: ParserState, x: Int) -> ParserState =
  { position: p.position, depth: p.depth, diagnostics: p.diagnostics.push(x) }

test "a record containing a list has the same fields however it is built, updated or passed to functions" {
  let n = 4;
  assert_eq({ position: 0, depth: n, diagnostics: [n] }, {
    position: 0,
    depth: 4,
    diagnostics: [4],
  });
  assert_eq(with_depth({ position: 0, depth: n, diagnostics: [n] }, 9), {
    position: 0,
    depth: 9,
    diagnostics: [4],
  });
  assert_eq(noted({ position: 0, depth: n, diagnostics: [n] }, 7), {
    position: 0,
    depth: 4,
    diagnostics: [4, 7],
  });
  let p = { position: 0, depth: n, diagnostics: [n] };
  assert_eq(with_depth(p, p.depth + 1), { position: 0, depth: 5, diagnostics: [4] });
  assert_eq(
    Some({ position: 0, depth: n, diagnostics: [n] }),
    Some({ position: 0, depth: 4, diagnostics: [4] }),
  )
}
