type T = | Con({ name: String, args: List<T> }) | Leaf

fn chain(n: Int) -> T = if n <= 0 { Leaf } else { Con({ name: "n", args: [chain(n - 1)] }) }

fn rebuilt(t: T) -> T =
  match t { Con(c) -> Con({ name: c.name, args: c.args.map(|a: T| rebuilt(a)) }), Leaf -> Leaf }

fn renamed(t: T, to: String) -> T =
  match t { Con(c) -> Con({ name: to, args: c.args.map(|a: T| renamed(a, to)) }), Leaf -> Leaf }

fn depth(t: T) -> Int =
  match t { Con(c) -> 1 + c.args.fold(0, |deepest: Int, a: T| max(deepest, depth(a))), Leaf -> 0 }

test "rebuilding a value from its own fields gives a value equal to the original" {
  let t = chain(5);
  assert_eq(rebuilt(t), t);
  assert_eq(depth(rebuilt(t)), 5);
  assert_eq(renamed(chain(2), "m"), Con({ name: "m", args: [Con({ name: "m", args: [Leaf] })] }))
}
