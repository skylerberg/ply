//! A record built of another's fields, where a constructor holds it in place, is written into the
//! constructor: rebuilding a value makes one object for each constructor and none for its record.

type T = | Con({ name: String, args: List<T> }) | Leaf

fn chain(n: Int) -> T = if n <= 0 { Leaf } else { Con({ name: "n", args: [chain(n - 1)] }) }

fn rebuilt(t: T) -> T =
  match t { Con(c) -> Con({ name: c.name, args: map(c.args, |a: T| rebuilt(a)) }), Leaf -> Leaf }

fn renamed(t: T, to: String) -> T =
  match t { Con(c) -> Con({ name: to, args: map(c.args, |a: T| renamed(a, to)) }), Leaf -> Leaf }

fn depth(t: T) -> Int =
  match t { Con(c) -> 1 + fold(c.args, 0, |deepest: Int, a: T| max(deepest, depth(a))), Leaf -> 0 }

test "a rebuilt value is the value it was built of" {
  let t = chain(5);
  assert_eq(rebuilt(t), t);
  assert_eq(depth(rebuilt(t)), 5);
  assert_eq(renamed(chain(2), "m"), Con({ name: "m", args: [Con({ name: "m", args: [Leaf] })] }))
}

test "rebuilding a value another still holds makes its constructors and their lists alone" {
  let short = chain(100);
  let long = chain(200);
  // A constructor and the list of its arguments for each one more.
  assert_eq(
    metered(|| depth(rebuilt(long))).allocations - metered(|| depth(rebuilt(short))).allocations,
    200,
  );
  assert_eq(metered(|| depth(rebuilt(long))).live, 0);
  assert_eq(metered(|| depth(renamed(long, "m"))).live, 0)
}
