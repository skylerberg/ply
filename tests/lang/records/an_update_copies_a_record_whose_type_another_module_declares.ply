import records.shapes

fn widened(n: Int) -> shapes::Limits = {
  let base = shapes::default_limits();
  { ..base, max_body: n }
}

fn added_limits(ns: List<Int>) -> shapes::Limits =
  ns.fold(shapes::default_limits(), |accumulator: shapes::Limits, n: Int|
    { ..accumulator, max_headers: accumulator.max_headers + n })

fn nested_limits(n: Int) -> { limits: shapes::Limits, name: Bytes } = {
  let outer = { limits: shapes::default_limits(), name: b"one" };
  { ..outer, limits: { ..outer.limits, max_headers: n } }
}

test "an update replaces one field of another module's record and copies the rest" {
  assert_eq(widened(7).max_body, 7);
  assert_eq(widened(7).max_headers, 64)
}

test "an update in a fold carries the accumulator through" {
  assert_eq(added_limits([1, 2, 3]).max_headers, 70);
  assert_eq(added_limits([]).max_body, 1024)
}

test "a record update whose replaced field holds a record copies that inner record's other fields" {
  assert_eq(nested_limits(9).limits.max_headers, 9);
  assert_eq(nested_limits(9).limits.max_body, 1024);
  assert_eq(nested_limits(9).name, b"one")
}
