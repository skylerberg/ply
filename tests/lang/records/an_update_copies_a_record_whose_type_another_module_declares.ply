// The shape an update copies is the type the checker infers for the base, so neither the binder
// nor the record has to be written in this file.

import records.shapes

fn widened(n: Int) -> shapes::Limits = {
  let base = shapes::default_limits();
  {..base, max_body: n}
}

fn counted(ns: List<Int>) -> shapes::Limits =
  fold(ns, shapes::default_limits(), |acc: shapes::Limits, n: Int| {..acc, max_headers: acc.max_headers + n})

fn deepened(n: Int) -> { limits: shapes::Limits, name: Bytes } = {
  let outer = { limits: shapes::default_limits(), name: b"one" };
  {..outer, limits: {..outer.limits, max_headers: n}}
}

test "an update replaces one field of another module's record and copies the rest" {
  assert_eq(widened(7).max_body, 7);
  assert_eq(widened(7).max_headers, 64)
}

test "an update in a fold carries the accumulator through" {
  assert_eq(counted([1, 2, 3]).max_headers, 70);
  assert_eq(counted([]).max_body, 1024)
}

test "an update nested inside a written field reads the inner record's own shape" {
  assert_eq(deepened(9).limits.max_headers, 9);
  assert_eq(deepened(9).limits.max_body, 1024);
  assert_eq(deepened(9).name, b"one")
}
