//! A record literal a constructor or a record holds in place is written there as it is built, and
//! it reads, compares and matches as it did.

type Named = | Named({ name: String, args: List<Int> }) | Bare(Int)

type Counter = { next: Int, last: Int }

fn named(n: String, xs: List<Int>) -> Named = Named({ name: n, args: xs })

fn step(at: Int) -> { counter: Counter, at: Int } = { counter: { next: at + 1, last: at }, at: at }

fn name_of(x: Named) -> String = match x { Named(r) -> r.name, Bare(_) -> "" }

test "a literal held in place reads, compares and matches as the record it is" {
  let x = named("f", [1, 2]);
  assert_eq(name_of(x), "f");
  assert_eq(x, Named({ name: "f", args: [1, 2] }));
  assert(x != Named({ name: "g", args: [1, 2] }), None);
  assert_eq(step(3).counter, { next: 4, last: 3 });
  assert_eq(step(3), { counter: { next: 4, last: 3 }, at: 3 })
}

type Span = { start: Int, end: Int }

type Identifier = { name: String, span: Span }

type Operation = { op: Identifier, by: Identifier }

fn ident(n: String, at: Int) -> Identifier = { name: n, span: { start: at, end: at + 1 } }

fn parsed(at: Int, a: Identifier, b: Identifier) -> { at: Int, node: Operation } =
  { at: at, node: { op: a, by: b } }

fn moved(p: { at: Int, node: Operation }) -> { node: Operation, count: Int } =
  { node: p.node, count: 1 }

test "a record held in place inside a literal counts its holder wherever the literal is copied" {
  let made = range(0, 50).map(|i: Int| moved(parsed(i, ident("a", i), ident("b", i))));
  assert_eq(
    made.map(|m: { node: Operation, count: Int }| m.node.by.name),
    range(0, 50).map(|i: Int| "b"),
  );
  assert_eq(match made.at(3) { Some(m) -> m.node.op.span, None -> { start: 0, end: 0 } }, {
    start: 3,
    end: 4,
  })
}
