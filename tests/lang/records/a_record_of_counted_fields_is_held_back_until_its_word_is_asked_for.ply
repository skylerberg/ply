//! A record whose fields hold counts (a `String`, a `List`, an `Option`, a `Result`) is held back
//! as its values until its word is asked for: read field by field it is never made, a field read
//! last hands its value on alone, and however it is used every count it took is given back.

type Entry = { name: String, note: Option<String>, parsed: Result<Int, { why: String }>, at: Int }

fn entry(name: String, at: Int) -> Entry =
  {
    name: name,
    note: if at > 0 { Some(f"{name}!") } else { None },
    parsed: if at % 2 == 0 { Ok(at) } else { Err({ why: name }) },
    at: at,
  }

fn described(e: Entry) -> String = {
  let note = match e.note { Some(n) -> n, None -> "-" };
  let parsed = match e.parsed { Ok(n) -> f"{n}", Err(x) -> x.why };
  f"{e.name} {note} {parsed} {e.at}"
}

/// The record's fields read and its word never asked for.
fn width(name: String, at: Int) -> Int = {
  let e = { name: name, tags: [name, name], at: at };
  string_len(e.name) + len(e.tags) + e.at
}

/// A list read out of a record at its last read, then appended to.
fn appended(xs: List<Int>, i: Int, n: Int) -> List<Int> =
  if i >= n { xs } else {
    let r = { items: xs, at: i };
    appended(push(r.items, r.at), i + 1, n)
  }

/// One record under two names, each read after the other's last read.
fn twice(name: String) -> Int = {
  let s = { name: name, tags: [name] };
  let t = s;
  len(t.tags) + len(s.tags) + string_len(t.name ++ s.name)
}

/// A record answered by either arm of an `if`, each holding a count of its own.
fn chosen(a: String, b: String, first: Bool) -> String = {
  let r = if first { { name: a, n: 1 } } else { { name: b, n: 2 } };
  f"{r.name}{r.n}"
}

type Tagged = { tag: String, n: Int }

type Placed = { tagged: Tagged, at: Int }

/// A record held back, then held in place by another.
fn placed(tag: String) -> Placed = {
  let t = { tag: tag, n: 1 };
  { tagged: t, at: 2 }
}

/// A record held back, then taken apart by a pattern.
fn parted(name: String) -> String = {
  let { name, tags } = { name: name, tags: [name] };
  f"{name}{len(tags)}"
}

test "a record of counted fields reads and answers what it was built from" {
  assert_eq(described(entry("a", 2)), "a a! 2 2");
  assert_eq(described(entry("b", 0)), "b - 0 0");
  assert_eq(described(entry("c", 3)), "c c! c 3");
  assert_eq(width("abc", 4), 9);
  assert_eq(appended([], 0, 4), [0, 1, 2, 3]);
  assert_eq(twice("ab"), 6);
  assert_eq(chosen("x", "y", true), "x1");
  assert_eq(chosen("x", "y", false), "y2");
  assert_eq(placed("p").tagged.tag, "p");
  assert_eq(parted("q"), "q1")
}

test "a list read out of a record held back at its last read grows in place" {
  let small = metered(|| len(appended([], 0, 2000)));
  let large = metered(|| len(appended([], 0, 8000)));
  assert(
    large.bytes < 6 * small.bytes,
    Some(f"{small.bytes} bytes for 2000 appends, {large.bytes} for 8000"),
  )
}

test "a record of counted fields gives back every count it took" {
  assert_eq(metered(|| string_len(described(entry("a", 2)))).live, 0);
  assert_eq(metered(|| string_len(described(entry("c", 3)))).live, 0);
  assert_eq(metered(|| width("abc", 4)).live, 0);
  assert_eq(metered(|| len(appended([], 0, 10))).live, 0);
  assert_eq(metered(|| twice("ab")).live, 0);
  assert_eq(metered(|| string_len(chosen("x", "y", false))).live, 0);
  assert_eq(metered(|| string_len(placed("p").tagged.tag)).live, 0);
  assert_eq(metered(|| string_len(parted("q"))).live, 0)
}
