type Entry = {
  name: String,
  note: Option<String>,
  parsed: Result<Int, { reason: String }>,
  at: Int,
}

fn entry(name: String, at: Int) -> Entry =
  {
    name: name,
    note: if at > 0 { Some(f"{name}!") } else { None },
    parsed: if at % 2 == 0 { Ok(at) } else { Err({ reason: name }) },
    at: at,
  }

fn described(e: Entry) -> String = {
  let note = match e.note { Some(n) -> n, None -> "-" };
  let parsed = match e.parsed { Ok(n) -> f"{n}", Err(x) -> x.reason };
  f"{e.name} {note} {parsed} {e.at}"
}

fn width(name: String, at: Int) -> Int = {
  let e = { name: name, tags: [name, name], at: at };
  e.name.len() + e.tags.len() + e.at
}

fn appended(xs: List<Int>, i: Int, n: Int) -> List<Int> =
  if i >= n { xs } else {
    let r = { items: xs, at: i };
    appended(r.items.push(r.at), i + 1, n)
  }

fn twice(name: String) -> Int = {
  let s = { name: name, tags: [name] };
  let t = s;
  t.tags.len() + s.tags.len() + String::len(t.name ++ s.name)
}

fn chosen(a: String, b: String, first: Bool) -> String = {
  let r = if first { { name: a, n: 1 } } else { { name: b, n: 2 } };
  f"{r.name}{r.n}"
}

type Tagged = { tag: String, n: Int }

type Placement = { tagged: Tagged, at: Int }

fn placement(tag: String) -> Placement = {
  let t = { tag: tag, n: 1 };
  { tagged: t, at: 2 }
}

fn destructured(name: String) -> String = {
  let { name, tags } = { name: name, tags: [name] };
  f"{name}{tags.len()}"
}

fn rebuilt_from_fields(t: Tagged) -> Int = {
  let r = { tag: t.tag ++ "!", n: t.n + 1 };
  r.n - 9000000000000000000 + r.tag.len()
}

fn retagged(t: Tagged) -> Int = {
  let r = { ..t, tag: t.tag ++ "?" };
  r.n - 9000000000000000000 + r.tag.len()
}

test "a record with a string or list field reads and returns the values it was built from" {
  assert_eq(described(entry("a", 2)), "a a! 2 2");
  assert_eq(described(entry("b", 0)), "b - 0 0");
  assert_eq(described(entry("c", 3)), "c c! c 3");
  assert_eq(width("abc", 4), 9);
  assert_eq(appended([], 0, 4), [0, 1, 2, 3]);
  assert_eq(twice("ab"), 6);
  assert_eq(chosen("x", "y", true), "x1");
  assert_eq(chosen("x", "y", false), "y2");
  assert_eq(placement("p").tagged.tag, "p");
  assert_eq(destructured("q"), "q1");
  assert_eq(rebuilt_from_fields({ tag: "a", n: 9000000000000000000 }), 3);
  assert_eq(retagged({ tag: "a", n: 9000000000000000000 }), 2)
}

test "a record with a string field releases every reference count it takes, so none is leaked" {
  let wide = { tag: "a", n: 9000000000000000000 };
  assert_eq(rebuilt_from_fields(wide) + retagged(wide), 5)
}
