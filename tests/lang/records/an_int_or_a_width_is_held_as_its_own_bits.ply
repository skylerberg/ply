type Point = { x: Int, y: Int, label: String }

type Shape = | Circle(Int, String) | Dot

fn far(n: Int) -> Point = { x: n, y: 0 - n, label: "p" }

fn radius(s: Shape) -> Int = match s { Circle(r, _) -> r, Dot -> 0 }

fn biggest() -> Int = 9223372036854775807

fn least() -> Int = 0 - 9223372036854775807 - 1

test "an `Int` stored in a record, constructor or array is read back unchanged" {
  let big = biggest();
  let small = least();
  assert_eq(far(big).x, big);
  assert_eq(far(big).y, 0 - big);
  assert_eq(far(4611686018427387904), {
    x: 4611686018427387904,
    y: 0 - 4611686018427387904,
    label: "p",
  });
  assert_eq({ ..far(1), x: small }.x, small);
  assert_eq(radius(Circle(big, "c")), big);
  assert_eq(radius(Dot), 0);
  let xs = Array::of_list([1, big, small, 0 - 1]);
  assert_eq(xs.get(1), big);
  assert_eq(xs.set(2, 7).get(2), 7);
  assert_eq(xs.to_list(), [1, big, small, 0 - 1]);
  assert(far(big) == far(big));
  assert(far(big) != far(big - 1));
  assert_eq([far(3), far(big)].map(|p: Point| p.x), [3, big])
}

type Tagged = { n: U32, small: I8, label: String }

type Holder = { inner: Tagged, items: List<Tagged>, count: Int }

fn tagged(n: U32) -> Tagged = { n: n, small: -3i8, label: "t" }

test "fixed-width integers in a record or array keep their values through `simulate` and a task channel send" {
  let h: Holder = { inner: tagged(4000000000u32), items: [tagged(7u32)], count: 2 };
  assert_eq(simulate { h }, h);
  assert_eq((simulate { task.join(task.spawn(|| h)) }).inner.n, 4000000000u32);
  let sent = simulate {
    let c = task.channel(1);
    let p = task.spawn(|| task.send(c, h));
    let got = task.recv(c);
    task.join(p);
    got
  };
  match sent {
    Some(x) -> assert_eq(x.items.map(|t: Tagged| t.small), [-3i8]),
    None -> assert(false, None),
  };
  let bytes = Array::of_list([1u8, 255u8, 0u8]);
  assert_eq(bytes.get(1), 255u8);
  assert_eq(bytes.set(2, 9u8).to_list(), [1u8, 255u8, 9u8])
}
