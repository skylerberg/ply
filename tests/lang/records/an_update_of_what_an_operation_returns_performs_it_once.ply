type Window = { low: Int, high: Int, step: Int }

effect stock {
  read window() -> Window
}

fn widened() -> { value: Window, requested: Int } =
  handle {
    { ..stock.window(), high: 9 }
  } with {
    var window_calls = 0,
    stock.window() -> {
      window_calls = window_calls + 1;
      { low: 1, high: 2, step: 4 }
    },
    return value -> { value: value, requested: window_calls },
  }

test "an update whose base is an operation call performs the operation once" {
  assert_eq(widened(), { value: { low: 1, high: 9, step: 4 }, requested: 1 })
}
