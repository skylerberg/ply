type Point = { x: Float, y: Float }

fn mid(a: Point, b: Point) -> Point = { x: (a.x + b.x) / 2.0, y: (a.y + b.y) / 2.0 }

fn length2(p: Point) -> Float = p.x * p.x + p.y * p.y

fn walk(p: Point, n: Int) -> Point =
  if n <= 0 { p } else { walk({ x: p.x + 1.0, y: p.y * 2.0 }, n - 1) }

fn toward(p: Point, xs: List<Float>, i: Int) -> Point =
  match xs.at(i) { Some(x) -> toward(mid(p, { x: x, y: 0.0 }), xs, i + 1), None -> p }

fn even_steps(p: Point, n: Int) -> Point =
  if n <= 0 { p } else { odd_steps({ ..p, x: p.x + 1.0 }, n - 1) }

fn odd_steps(p: Point, n: Int) -> Point =
  if n <= 0 { p } else { even_steps({ ..p, y: p.y + 1.0 }, n - 1) }

type Price = { amount: Decimal, taxed: Bool }

fn taxed(p: Price) -> Price = if p.taxed { p } else { { amount: p.amount * 1.10m, taxed: true } }

test "a small record passed to and returned from a function has the correct field values" {
  assert_eq(mid({ x: 0.0, y: 2.0 }, { x: 4.0, y: 4.0 }), { x: 2.0, y: 3.0 });
  assert_eq(length2({ x: 3.0, y: 4.0 }), 25.0);
  assert_eq(walk({ x: 0.0, y: 1.0 }, 3), { x: 3.0, y: 8.0 });
  assert_eq(toward({ x: 8.0, y: 8.0 }, [0.0, 0.0], 0), { x: 2.0, y: 2.0 });
  assert_eq(even_steps({ x: 0.0, y: 0.0 }, 5), { x: 3.0, y: 2.0 });
  assert_eq(taxed({ amount: 10m, taxed: false }), { amount: 11.000m, taxed: true });
  assert_eq([{ x: 1.0, y: 1.0 }].map(|p: Point| mid(p, p)), [{ x: 1.0, y: 1.0 }]);
  assert_eq([{ x: 2.0, y: 0.0 }].map(length2), [4.0])
}
