type State = { k: Int, out: List<Int> }

test "two updates of one base leave the base as it was" {
  let s: State = { k: 1, out: [1] };
  let t = { ..s, k: 2 };
  let u = { ..s, out: s.out.push(2) };
  assert_eq(s.k, 1);
  assert_eq(s.out, [1]);
  assert_eq(t.k, 2);
  assert_eq(t.out, [1]);
  assert_eq(u.k, 1);
  assert_eq(u.out, [1, 2])
}

type B = { a: Int, c: Int, d: Int }

test "a record literal copying some fields of another record has only those fields and leaves the original unchanged" {
  let b: B = { a: 1, c: 2, d: 3 };
  let x = { a: b.a, c: 5 };
  assert_eq(x, { a: 1, c: 5 });
  assert_eq(b, { a: 1, c: 2, d: 3 })
}
