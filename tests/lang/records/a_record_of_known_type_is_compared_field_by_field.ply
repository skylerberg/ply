type Reading = { at: Int, value: Float, price: Decimal, name: String, note: Option<String> }

type CheckedReading = { reading: Reading, ok: Bool }

fn reading(at: Int, value: Float) -> Reading =
  { at: at, value: value, price: 1.50m, name: "r", note: Some("n") }

fn same(a: Reading, b: Reading) -> Bool = a == b

fn differ(a: Reading, b: Reading) -> Bool = a != b

fn same_checked_reading(a: CheckedReading, b: CheckedReading) -> Bool = a == b

fn same_found(a: Option<Reading>, b: Option<Reading>) -> Bool = a == b

fn counted(xs: List<Reading>, r: Reading) -> Int =
  xs.fold(0, |n: Int, x: Reading| if x == r { n + 1 } else { n })

test "records of a known type are equal as their fields are" {
  let a = reading(1, 0.5);
  assert(same(a, reading(1, 0.5)));
  assert(!same(a, reading(2, 0.5)));
  assert(differ(a, reading(1, 0.25)));
  assert(same({ ..a, price: 1.5m }, a));
  assert(!same({ ..a, name: "s" }, a));
  assert(!same({ ..a, note: None }, a));
  assert(same({ ..a, note: None }, { ..a, note: None }));
  assert(!same({ ..a, note: Some("m") }, a));
  assert(same({ ..a, value: 0.0 }, { ..a, value: -0.0 }));
  let nan = 0.0 / 0.0;
  assert(!same({ ..a, value: nan }, { ..a, value: nan }));
  assert(same_checked_reading({ reading: a, ok: true }, { reading: reading(1, 0.5), ok: true }));
  assert(!same_checked_reading({ reading: a, ok: true }, { reading: a, ok: false }));
  assert(same_found(Some(a), Some(reading(1, 0.5))));
  assert(!same_found(Some(a), Some(reading(1, 0.25))));
  assert(!same_found(Some(a), None));
  assert(same_found(None, None))
}

type Token = | Punct(String) | Number(Int, Float) | Eof

fn is_punct(t: Token, p: String) -> Bool = t == Punct(p)

fn not_number(t: Token, n: Int) -> Bool = t != Number(n, 0.5)

fn at_end(t: Token) -> Bool = t == Eof

type Rounded = | Rounded(Int)

key for Rounded by rounded

fn rounded(r: Rounded) -> Int = match r { Rounded(n) -> n / 10 }

fn same_rounded(r: Rounded, n: Int) -> Bool = r == Rounded(n)

test "a value compared with a constructor of its sum is equal as their tags and arguments are" {
  assert(is_punct(Punct("("), "("));
  assert(!is_punct(Punct("("), ")"));
  assert(!is_punct(Eof, "("));
  assert(!is_punct(Number(1, 0.5), "("));
  assert(!not_number(Number(3, 0.5), 3));
  assert(not_number(Number(3, 0.25), 3));
  assert(not_number(Number(4, 0.5), 3));
  assert(not_number(Eof, 3));
  assert(at_end(Eof));
  assert(!at_end(Punct("")));
  assert(same_rounded(Rounded(12), 15));
  assert(!same_rounded(Rounded(12), 25))
}

fn same_text(a: String, b: String) -> Bool = a == b

fn other_bytes(a: Bytes, b: Bytes) -> Bool = a != b

test "strings and byte strings are equal as their bytes are" {
  assert(same_text("abc", "ab" ++ "c"));
  assert(!same_text("abc", "abd"));
  assert(!same_text("abc", "ab"));
  assert(same_text("", ""));
  assert(same_text("xabcx".slice(1, 4), "abc"));
  assert(!other_bytes(b"\x00\x01", b"\x00".concat(b"\x01")));
  assert(other_bytes(b"\x00", b"\x01"));
  assert(!other_bytes(b"abcd".slice(1, 3), b"bc"))
}

type Tree = | Leaf(Int) | Node(Tree, String, Tree) | Blank

fn same_tree(a: Tree, b: Tree) -> Bool = a == b

fn same_token(a: Token, b: Token) -> Bool = a == b

fn same_keyed(a: Rounded, b: Rounded) -> Bool = a == b

test "two values of a declared sum are equal when their constructors and arguments are equal" {
  let t = Node(Leaf(1), "x", Node(Blank, "y", Leaf(2)));
  assert(same_tree(t, Node(Leaf(1), "x", Node(Blank, "y", Leaf(2)))));
  assert(!same_tree(t, Node(Leaf(1), "x", Node(Blank, "z", Leaf(2)))));
  assert(!same_tree(t, Node(Leaf(1), "x", Node(Blank, "y", Leaf(3)))));
  assert(!same_tree(t, Blank));
  assert(same_tree(Blank, Blank));
  assert(same_token(Number(1, 0.5), Number(1, 0.5)));
  assert(!same_token(Number(1, 0.5), Number(1, 0.25)));
  let nan = 0.0 / 0.0;
  assert(!same_token(Number(1, nan), Number(1, nan)));
  assert(same_token(Punct("a"), Punct("a")));
  assert(!same_token(Punct("a"), Eof));
  assert(same_keyed(Rounded(12), Rounded(15)));
  assert(!same_keyed(Rounded(12), Rounded(25)))
}

type Light = | Red | Amber | Green

fn same_light(a: Light, b: Light) -> Bool = a == b

fn same_order(a: Int, b: Int, c: Int, d: Int) -> Bool = compare(a, b) == compare(c, d)

type Named = | Named({ name: String, args: List<Int> }) | Bare(Int)

fn is_named(x: Named, n: String) -> Bool = x == Named({ name: n, args: [1, 2] })

fn same_named(a: Named, b: Named) -> Bool = a == b

test "sums whose constructors take no arguments are equal when they are the same constructor" {
  assert(same_light(Red, Red));
  assert(!same_light(Red, Green));
  assert(same_order(1, 2, 3, 4));
  assert(!same_order(1, 2, 4, 3));
  assert(same_order(5, 5, 0, 0))
}

test "a constructor that contains a record is equal to another when the two records are equal" {
  assert(is_named(Named({ name: "f", args: [1, 2] }), "f"));
  assert(!is_named(Named({ name: "f", args: [1, 2] }), "g"));
  assert(!is_named(Bare(1), "f"));
  assert(same_named(Named({ name: "f", args: [1] }), Named({ name: "f", args: [1] })));
  assert(!same_named(Named({ name: "f", args: [1] }), Named({ name: "f", args: [2] })));
  assert(!same_named(Bare(1), Named({ name: "f", args: [1] })))
}
