//! A record held back as its values and then named again is the same value under each name: the two
//! make no more than a record made for each would, and both are released.

import std.pace (spent)

type Span = { start: Int, end: Int }

fn both(a: Int) -> List<Span> = {
  let s = { start: a, end: a + 1 };
  let t = s;
  [t, s]
}

fn made(a: Int) -> List<Span> = [{ start: a, end: a + 1 }, { start: a, end: a + 1 }]

fn kept<a>(x: a) -> List<a> = [x]

/// `t` moves into a list, and `s` is read again by a generic call that only reads it.
fn shared(a: Int) -> Int = {
  let s = { start: a, end: a + 1 };
  let t = s;
  [t].len() + kept(s).len() + s.end
}

test "a record named twice is the same value under either name" {
  assert_eq(both(3), [{ start: 3, end: 4 }, { start: 3, end: 4 }])
}

test "a record named twice makes no more than one made for each, and lets go of all it made" {
  let named = spent(|| both(3)).allocations;
  let fresh = spent(|| made(3)).allocations;
  assert(
    named <= fresh,
    Some(f"{named} objects made for a record named twice, {fresh} for two made"),
  );
  assert_eq(shared(3), 6)
}
