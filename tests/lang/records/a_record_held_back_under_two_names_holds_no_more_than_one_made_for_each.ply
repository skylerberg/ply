//! A record held back as its values and then named again is the same value under each name, and
//! both are released.

type Span = { start: Int, end: Int }

fn both(a: Int) -> List<Span> = {
  let s = { start: a, end: a + 1 };
  let t = s;
  [t, s]
}

fn singleton<a>(x: a) -> List<a> = [x]

/// `t` moves into a list, and `s` is read again by a generic call that only reads it.
fn shared(a: Int) -> Int = {
  let s = { start: a, end: a + 1 };
  let t = s;
  [t].len() + singleton(s).len() + s.end
}

test "a record named twice is the same value under either name" {
  assert_eq(both(3), [{ start: 3, end: 4 }, { start: 3, end: 4 }])
}

test "a record bound to two names, passed along under one name and read under the other, releases every reference count, so none is leaked" {
  assert_eq(shared(3), 6)
}
