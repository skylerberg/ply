type Point = { x: Float, y: Float }

type Weighed = { label: String, weight: Float }

fn point(x: Float, y: Float) -> Point = { x: x, y: y }

fn moved(p: Point, by: Float) -> Point = { ..p, x: p.x + by }

fn wrapped<a>(value: a) -> { inner: a } = { inner: value }

fn total(xs: List<Weighed>) -> Float =
  xs.fold(0.0, |accumulator: Float, w: Weighed| accumulator + w.weight)

test "float fields read back correctly from a record literal and from a record update" {
  let p = point(1.5, -2.25);
  assert_eq(p.x + p.y, -0.75);
  let q = moved(p, 0.5);
  assert_eq(q.x, 2.0);
  assert_eq(p.x, 1.5);
  assert_eq(q, { x: 2.0, y: -2.25 })
}

test "generic code stores a float or a record with a float field in a record and reads it back unchanged" {
  let w = wrapped(0.125);
  assert_eq(w.inner * 8.0, 1.0);
  let weighed = wrapped({ label: "a", weight: 2.5 });
  assert_eq(weighed.inner.weight, 2.5);
  assert_eq(total([{ label: "a", weight: 1.5 }, weighed.inner]), 4.0)
}

test "a map's entries return the float values inserted into the map" {
  let m = Map::new().insert("a", 1.25).insert("b", 2.5);
  assert_eq(
    m.entries().fold(0.0, |accumulator: Float, e: { key: String, value: Float }|
      accumulator + e.value),
    3.75,
  );
  assert_eq(m.first(), Some({ key: "a", value: 1.25 }))
}
