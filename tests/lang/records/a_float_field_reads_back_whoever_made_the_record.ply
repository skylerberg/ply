//! A record holds a `Float` field as the double's bits, laid out by its type wherever it is made: a
//! literal, an update, generic code and a map's entries all make records that read back the floats
//! they were given.

type Point = { x: Float, y: Float }

type Weighed = { label: String, weight: Float }

fn point(x: Float, y: Float) -> Point = { x: x, y: y }

fn moved(p: Point, by: Float) -> Point = { ..p, x: p.x + by }

fn wrapped<a>(value: a) -> { inner: a } = { inner: value }

fn total(xs: List<Weighed>) -> Float = fold(xs, 0.0, |acc: Float, w: Weighed| acc + w.weight)

test "a literal and an update hold their floats" {
  let p = point(1.5, -2.25);
  assert_eq(p.x + p.y, -0.75);
  let q = moved(p, 0.5);
  assert_eq(q.x, 2.0);
  assert_eq(p.x, 1.5);
  assert_eq(q, { x: 2.0, y: -2.25 })
}

test "generic code lays out the record its type would have" {
  let w = wrapped(0.125);
  assert_eq(w.inner * 8.0, 1.0);
  let weighed = wrapped({ label: "a", weight: 2.5 });
  assert_eq(weighed.inner.weight, 2.5);
  assert_eq(total([{ label: "a", weight: 1.5 }, weighed.inner]), 4.0)
}

test "a map's entries hold the floats the map holds" {
  let m = map_insert(map_insert(map_new(), "a", 1.25), "b", 2.5);
  assert_eq(
    fold(map_entries(m), 0.0, |acc: Float, e: { key: String, value: Float }| acc + e.value),
    3.75,
  );
  assert_eq(map_first(m), Some({ key: "a", value: 1.25 }))
}
