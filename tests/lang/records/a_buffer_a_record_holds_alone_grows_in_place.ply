type State = { out: Bytes, n: Int }

type T = | T(Bytes, Int)

fn pattern(s: State, fuel: Int) -> Bytes = {
  let { out, n } = s;
  if n <= 0 || fuel <= 0 { out } else { pattern({ out: out ++ b"x", n: n - 1 }, fuel - 1) }
}

fn constructor(t: T, fuel: Int) -> Bytes =
  match t {
    T(out, n) -> if n <= 0 || fuel <= 0 { out }
    else { constructor(T(out ++ b"x", n - 1), fuel - 1) },
  }

fn update(s: State, fuel: Int) -> Bytes =
  if s.n <= 0 || fuel <= 0 { s.out }
  else { update({ ..s, out: s.out ++ b"x", n: s.n - 1 }, fuel - 1) }

fn iterated(n: Int) -> Bytes / {abort.raise} =
  iterate({ out: b"", n: n }, n + 1, |s: State|
    if s.n <= 0 { Stop(s.out) } else { Continue({ out: s.out ++ b"x", n: s.n - 1 }) })

fn folded(n: Int) -> Bytes =
  range(0, n).fold({ out: b"", n: 0 }, |s: State, _: Int| { out: s.out ++ b"x", n: s.n + 1 }).out

fn shapes() -> List<String> =
  [
    "a `let` record pattern",
    "a `match` on a constructor",
    "an update that reads the field it sets",
    "an `iterate` state",
    "a `List::fold` accumulator",
  ]

fn grown(name: String, n: Int) -> Bytes / {abort.raise} =
  if name == "a `let` record pattern" { pattern({ out: b"", n: n }, n + 1) }
  else if name == "a `match` on a constructor" { constructor(T(b"", n), n + 1) }
  else if name == "an update that reads the field it sets" { update({ out: b"", n: n }, n + 1) }
  else if name == "an `iterate` state" { iterated(n) }
  else { folded(n) }

test "for a record with one field named {s}, appending 2000 times to its buffer field leaves every appended byte in the buffer" for s: String in shapes(
  ) { assert_eq(grown(s, 2000), b"x".repeat(2000)) }

test "a record also bound to another name is not changed by an update, and each name reads its own original fields" {
  let s: State = { out: b"abc", n: 1 };
  let original = s;
  let grown = { ..s, out: s.out ++ b"d" };
  assert_eq(grown.out, b"abcd");
  assert_eq(original.out, b"abc");
  let t = T(b"xy", 2);
  let other = t;
  let pieces = match t { T(out, n) -> out ++ Bytes::of_string(n.to_string()) };
  assert_eq(pieces, b"xy2");
  assert_eq(other, T(b"xy", 2))
}

test "reading a field twice, or the whole record after reading one field, gives the unchanged values" {
  let s: State = { out: b"ab", n: 2 };
  let twice = { out: s.out ++ s.out, n: s.n };
  assert_eq(twice.out, b"abab");
  let r: State = { out: b"cd", n: 3 };
  let first = r.out ++ b"!";
  assert_eq(first, b"cd!");
  assert_eq(r, { out: b"cd", n: 3 })
}

test "a closure called again reads the record it captured whole each time" {
  let s: State = { out: b"abc", n: 1 };
  let total = range(0, 3).fold(0, |accumulator: Int, _: Int|
    accumulator + Bytes::len(s.out ++ b"z") + s.n);
  assert_eq(total, 15)
}
