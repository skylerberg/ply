type Step = { value: Int, next: Int }

fn step(n: Int) -> Step = { value: n, next: n + 1 }

fn taken(n: Int) -> Int = match step(n) { { value, next } -> value + next }

fn ignored(n: Int) -> Int = match step(n) { { value, .. } -> value }

fn wrapped(n: Int) -> Result<Step, Int> = if n < 0 { Err(0 - n) } else { Ok(step(n)) }

fn nested(n: Int) -> Int = match wrapped(n) { Ok({ value, next }) -> value + next, Err(e) -> e }

fn listed(n: Int) -> Int = match [Ok(n), Err(2)] { [Ok(a), Err(b)] -> a + b, _ -> 0 }

fn joined(n: Int) -> Int = if "ab" ++ "cd" == "abcd" { n } else { 0 - n }

// `++` on Bytes is the join `Bytes::concat` names.
fn byte_joined(n: Int) -> Int =
  if b"ab" ++ b"cd" == b"ab".concat(b"cd") { n + Bytes::len(b"" ++ b"xyz") } else { 0 - n }

fn let_taken(n: Int) -> Int = {
  let { value, next } = step(n);
  value + next
}

fn let_rest(n: Int) -> Int = {
  let { value: v, .. } = step(n);
  v
}

fn let_tuple(n: Int) -> Int = {
  let (a, b) = (n, n + 1);
  a * b
}

fn let_nested(n: Int) -> Int = {
  let { left: { value, .. }, right: (r, _) } = { left: step(n), right: (n, n) };
  value + r
}

// A written field's own block projects a record it binds; that record is not the literal's update base.
fn projected(n: Int) -> Int = {
  let r = {
    v: {
      let s = step(n);
      s.value + 1
    },
    w: n,
  };
  match r { { v, w } -> v + w }
}

// A branch answering a local must not alias it at one count, or the update writes the original.
fn aliased(n: Int) -> Int = {
  let s = step(n);
  let t: Step = if n > 0 { s } else { step(0) };
  let u = { ..t, value: 99 };
  s.value + u.value
}

type Pair = { x: Int, y: Int }

fn spin(p: Pair) -> Pair = {
  let a = p.x;
  let b = p.y;
  { x: b + 1, y: a }
}

fn spun(n: Int) -> Int / {abort.raise} = {
  let p = iterate({ x: n, y: 0 }, 100, |q: Pair|
    if q.x > 40 { Stop(q) } else { Continue(spin(q)) });
  p.x * 100 + p.y
}

fn shared(n: Int) -> Int = {
  let p = { x: n, y: 1 };
  let q = spin(p);
  p.x * 1000 + q.x * 10 + q.y
}

fn swapped(n: Int) -> Int = {
  let p = { x: n, y: 7 };
  let q = { x: p.y, y: p.x };
  let r = { x: q.y, y: q.x };
  p.x + q.x * 10 + r.y * 100
}

fn leftover(p: Pair, b: Bool) -> Int = {
  let s = p.x + p.y;
  if b {
    let q = { x: s, y: 0 };
    q.x
  } else { s }
}

fn boxed_field(n: Int) -> Int = {
  let h = { left: step(n), right: n };
  let v = h.left.value;
  let k = { left: step(v), right: h.right };
  k.left.value + k.right
}

test "record and constructor patterns, joins and lets answer what they mean" {
  assert_eq(taken(4), 9);
  assert_eq(ignored(7), 7);
  assert_eq(nested(4), 9);
  assert_eq(nested(0 - 3), 3);
  assert_eq(let_taken(4), 9);
  assert_eq(let_rest(7), 7);
  assert_eq(let_tuple(4), 20);
  assert_eq(let_nested(4), 8);
  assert_eq(projected(4), 9);
  assert_eq(aliased(4), 103);
  assert_eq(listed(5), 7);
  assert_eq(joined(11), 11);
  assert_eq(byte_joined(11), 14)
}

// Rebuilt from a dying record of its width reuses its memory; a held, differently shaped or
// later-read base is built as written.
test "a record rebuilt from one that dies, one still held and one read later each answer as written" {
  assert_eq(spun(1), 4140);
  assert_eq(shared(3), 3023);
  assert_eq(swapped(2), 772);
  assert_eq(leftover({ x: 4, y: 5 }, true), 9);
  assert_eq(leftover({ x: 4, y: 5 }, false), 9);
  assert_eq(boxed_field(4), 8)
}

fn counted(n: Int) -> Map<Int, Int> =
  range(0, n).fold(Map::new(), |m: Map<Int, Int>, i: Int| m.insert(i % 3, i))

// A `match` over `Map::get` whose arms only ask whether the key was found builds no constructor.
fn looked_up(n: Int) -> Int = match counted(n).get(1) { Some(v) -> v * 10, None -> 0 - 1 }

fn looked_up_any(n: Int) -> Int = match counted(n).get(1) { None -> 0 - 1, _ -> 7 }

fn looked_up_nested(n: Int) -> Int =
  match counted(n).get(2) { Some(5) -> 55, Some(v) -> v, None -> 0 - 1 }

fn looked_up_twice(n: Int) -> Int = {
  let m = counted(n);
  match m.get(0) { Some(a) -> match m.get(1) { Some(b) -> a + b, None -> a }, None -> 0 }
}

fn looked_up_by_list(n: Int) -> Int = {
  let m = Map::new().insert([n, n + 1], n);
  match m.get([n, n + 1]) { Some(v) -> v, None -> 0 - 1 }
}

fn indexed(n: Int) -> Int = {
  let xs = range(0, n).map(|x: Int| x + 1);
  match xs.at(2) { Some(v) -> v * 10, None -> 0 - 1 }
}

fn indexed_past(n: Int) -> Int =
  match range(0, n).map(|x: Int| x + 1).at(n + 5) { Some(_) -> 1, None -> 0 - 1 }

fn ordered(a: Int, b: Int) -> Int = match compare(a, b) { Less -> 0 - 1, Equal -> 0, Greater -> 1 }

// The empty list and map are made once and grown apart.
fn grown_apart(n: Int) -> Int = {
  let a = [].push(n);
  let b = [].push(n + 1);
  let c = [].push(n + 2).push(n + 3);
  a.len() * 100 + b.len() * 10 + c.len() + a.fold(0, |acc: Int, x: Int| acc + x)
    + b.fold(0, |acc: Int, x: Int| acc + x)
}

fn maps_apart(n: Int) -> Int = {
  let a = Map::new().insert(n, 1);
  let b = Map::new().insert(n + 1, 2);
  let e = Map::new();
  a.len() * 100 + b.len() * 10 + e.len() + (match a.get(n + 1) { Some(_) -> 1000, None -> 0 })
}

test "lookups that only ask whether a key is there, an index past the end and fresh empties answer" {
  assert_eq(looked_up(6), 40);
  assert_eq(looked_up(1), 0 - 1);
  assert_eq(looked_up_any(2), 7);
  assert_eq(looked_up_any(1), 0 - 1);
  assert_eq(looked_up_nested(6), 55);
  assert_eq(looked_up_nested(3), 2);
  assert_eq(looked_up_nested(2), 0 - 1);
  assert_eq(looked_up_twice(6), 7);
  assert_eq(looked_up_by_list(4), 4);
  assert_eq(indexed(5), 30);
  assert_eq(indexed(2), 0 - 1);
  assert_eq(indexed_past(3), 0 - 1);
  assert_eq(ordered(1, 2), 0 - 1);
  assert_eq(ordered(2, 2), 0);
  assert_eq(ordered(3, 2), 1);
  assert_eq(grown_apart(4), 121);
  assert_eq(maps_apart(7), 110)
}

fn turned(x: Int, n: Int) -> Int = rotr32(x, n)

fn wrapping(a: Int, b: Int) -> Int = wrap_add(a, b) + wrap_sub(a, b) + wrap_mul(a, b)

fn turned_by_name(x: Int) -> Int = {
  let n = 4;
  let k = 32 - n;
  rotr32(x, n) + (x << k)
}

test "a rotate and wrapping arithmetic at their edges" {
  assert_eq(turned(1, 1), 0x8000_0000);
  assert_eq(turned(0x1_0000_0001, 1), 0x8000_0000);
  assert_eq(turned(0 - 1, 7), 0xFFFF_FFFF);
  assert_eq(turned(2, 0 - 1), 4);
  // The least `Int`, then the greatest less one, then the greatest.
  assert_eq(wrapping(9223372036854775807, 1), 9223372036854775805);
  assert_eq(wrapping(6, 7), 13 - 1 + 42);
  assert_eq(turned_by_name(1), 0x1000_0000 + (1 << 28))
}

fn width_of(p: Pair) -> Int = p.x * 10 + p.y

fn takes(p: Pair) -> Int = match p { { x, y } -> x - y }

fn summed(a: Int, b: Int) -> Int = a + b

fn lent_then_read(n: Int) -> Int = {
  let p = { x: n, y: 1 };
  width_of(p) + p.x
}

fn lent_beside_a_move(n: Int) -> Int = {
  let p = { x: n, y: 2 };
  width_of(p) + takes(p)
}

fn lent_and_moved_in_order(n: Int) -> Int = {
  let p = { x: n, y: 3 };
  summed(width_of(p), takes(p))
}

fn lent_per_step(n: Int) -> Int =
  range(0, n).fold(0, |acc: Int, i: Int| acc + width_of({ x: i, y: i }))

fn read_by_step(acc: Pair, i: Int) -> Int = acc.x + i

fn lent_to_a_step(n: Int) -> Int = {
  let p = { x: n, y: 0 };
  range(0, 3).fold(0, |acc: Int, i: Int| acc + read_by_step(p, i)) + p.y
}

test "a record lent to a callee that only reads it is still whole beside a later read, a move and a step" {
  assert_eq(lent_then_read(4), 41 + 4);
  assert_eq(lent_beside_a_move(5), 52 + 3);
  assert_eq(lent_and_moved_in_order(6), 63 + 3);
  assert_eq(lent_per_step(3), 11 + 22);
  assert_eq(lent_to_a_step(7), 7 * 3 + 3)
}
