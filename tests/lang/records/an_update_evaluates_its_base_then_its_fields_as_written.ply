type Trio = { a: Int, b: Int, c: Int }

effect tally {
  write next() -> Int
}

fn made() -> Trio / {tally.next} = { a: tally.next(), b: 0, c: 0 }

fn counted<a>(body: () -> a / {tally.next}) -> a =
  handle {
    body()
  } with {
    var n = 0,
    tally.next() -> {
      n = n + 1;
      n
    },
  }

test "the base is evaluated before the field the update writes" {
  assert_eq(counted(|| { ..made(), b: tally.next() }), { a: 1, b: 2, c: 0 })
}

test "the fields are evaluated as written, after the base" {
  assert_eq(counted(|| { ..made(), c: tally.next(), b: tally.next() }), { a: 1, b: 3, c: 2 });
  assert_eq(counted(|| { ..made(), b: tally.next(), c: tally.next() }), { a: 1, b: 2, c: 3 })
}

test "a base that is a handler's variable is read before a field assigns it" {
  let out = handle {
    tally.next()
  } with {
    var t = { a: 1, b: 0, c: 0 },
    tally.next() -> {
      let u = {
        ..t,
        b: {
          t = { a: 5, b: 5, c: 5 };
          2
        },
      };
      u.a * 100 + u.b * 10 + u.c
    },
  };
  assert_eq(out, 120)
}
