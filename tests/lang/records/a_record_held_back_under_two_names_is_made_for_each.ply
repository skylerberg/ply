//! A record held back as its values and then named again is held back under each name: each is
//! made where its own word is asked for, and both are released.

type Span = { start: Int, end: Int }

fn both(a: Int) -> List<Span> = {
  let s = { start: a, end: a + 1 };
  let t = s;
  [t, s]
}

fn made(a: Int) -> List<Span> = [{ start: a, end: a + 1 }, { start: a, end: a + 1 }]

fn kept<a>(x: a) -> List<a> = [x]

/// `t` moves into a list, and `s` is made again for a generic call that only reads it.
fn shared(a: Int) -> Int = {
  let s = { start: a, end: a + 1 };
  let t = s;
  [t].len() + kept(s).len() + s.end
}

test "a record named twice is the same value under either name" {
  assert_eq(both(3), [{ start: 3, end: 4 }, { start: 3, end: 4 }])
}

test "a record named twice and made under each name leaves only what it answers live" {
  assert_eq(metered(|| both(3)).live, metered(|| made(3)).live);
  assert_eq(metered(|| shared(3)).live, 0)
}
