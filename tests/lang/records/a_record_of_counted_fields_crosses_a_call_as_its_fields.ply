//! A small record whose fields hold counts crosses a call as its fields, each counted one handed on
//! with a count of its own, and with its word where it was made: threaded through calls it is never
//! made, one made once is never made again, a field read last in the callee is updated in place,
//! and every count is given back.

type Cursor = { items: List<Int>, at: Int }

fn advanced(c: Cursor) -> Cursor = { items: c.items, at: c.at + 1 }

/// `n` calls deep, the cursor handed down and answered back up.
fn walked(c: Cursor, n: Int) -> Cursor =
  if n <= 0 { c } else { advanced(walked(advanced(c), n - 1)) }

/// The list read out of the cursor a call was handed, appended to and handed on.
fn pushed(c: Cursor, n: Int) -> Cursor =
  if n <= 0 { c } else { pushed({ items: c.items.push(n), at: c.at + 1 }, n - 1) }

/// The list read out of the cursor a call answered, appended to and answered.
fn built(n: Int) -> Cursor =
  if n <= 0 { { items: [], at: 0 } } else {
    let c = built(n - 1);
    { items: c.items.push(n), at: c.at + 1 }
  }

fn twice(c: Cursor) -> List<Cursor> = [c, c]

fn four(c: Cursor) -> List<Cursor> = [c, c, c, c]

fn same<a>(x: a) -> a = x

fn later(c: Cursor) -> () -> Int = || c.items.len() + c.at

/// The bytes are read before the index, whose read of `b` is its last and moves the field out.
fn last_clear(b: { unused: Int, bytes: Bytes }) -> Bool / {abort.raise} =
  b.unused == 0 || b.bytes.at(b.bytes.len() - 1) == 0

fn tail_of(c: Cursor) -> List<Int> = c.items

/// Each reads the list out of `c` before handing `c` on at its last read.
fn doubled(c: Cursor) -> List<Int> = c.items.push(tail_of(c).len())

fn listed(c: Cursor) -> List<List<Int>> = [c.items, tail_of(c)]

fn paired(c: Cursor) -> { a: List<Int>, b: List<Int> } = { a: c.items, b: tail_of(c) }

fn looked(c: Cursor, a: Int) -> Int = c.items.len() + c.at + a

/// `c` handed down `n` calls, a closure at each capturing it.
fn captured(c: Cursor, n: Int) -> Int =
  if n <= 0 { 0 } else { [n].map(|a: Int| looked(c, a)).len() + captured(c, n - 1) }

/// As `captured`, capturing an `Int` in its place.
fn captured_int(k: Int, n: Int) -> Int =
  if n <= 0 { 0 } else { [n].map(|a: Int| a + k).len() + captured_int(k, n - 1) }

type Scan = { at: Int, seen: List<Int>, out: List<Int> }

/// The state of `scanned`'s loop updated through a call, as a lexer's is.
fn stepped(s: Scan) -> Scan = { at: s.at + 1, seen: s.seen, out: s.out.push(s.at) }

fn scanned(n: Int) -> Int / {abort.raise} =
  iterate({ at: 0, seen: [], out: [] }, n + 1, |s: Scan|
    if s.at >= n { Stop(s.out) } else { Continue(stepped(s)) }).len(
  )

/// As `scanned`, the update written in the loop.
fn scanned_inline(n: Int) -> Int / {abort.raise} =
  iterate({ at: 0, seen: [], out: [] }, n + 1, |s: Scan|
    if s.at >= n { Stop(s.out) }
    else { Continue({ at: s.at + 1, seen: s.seen, out: s.out.push(s.at) }) }).len(
  )

type Named = { name: String, note: Option<String> }

fn renamed(n: Named, to: String) -> Named = { ..n, name: to }

fn noted(n: Named) -> String = match n.note { Some(x) -> f"{n.name}:{x}", None -> n.name }

test "a record of counted fields crosses and answers what it was built from" {
  assert_eq(walked({ items: [1, 2], at: 0 }, 3), { items: [1, 2], at: 6 });
  assert_eq(pushed({ items: [], at: 0 }, 3), { items: [3, 2, 1], at: 3 });
  assert_eq(built(3), { items: [1, 2, 3], at: 3 });
  assert_eq(twice({ items: [1], at: 2 }), [{ items: [1], at: 2 }, { items: [1], at: 2 }]);
  assert_eq(same({ items: [4], at: 5 }).at, 5);
  assert_eq(later({ items: [1, 2], at: 3 })(), 5);
  assert_eq(noted(renamed({ name: "a", note: Some("b") }, "c")), "c:b");
  assert_eq(noted(renamed({ name: "a", note: None }, "d")), "d");
  assert(last_clear({ unused: 1, bytes: b"\x01\x00" }));
  assert(!last_clear({ unused: 1, bytes: b"\x01" }));
  assert_eq(doubled({ items: [1], at: 0 }), [1, 1]);
  assert_eq(listed({ items: [1], at: 0 }), [[1], [1]]);
  assert_eq(paired({ items: [1], at: 0 }), { a: [1], b: [1] })
}

test "a record of counted fields handed down a thousand calls makes no record" {
  let cost = |n: Int| metered(|| walked({ items: [1, 2], at: 0 }, n).at).allocations;
  assert_eq(cost(1000), cost(10))
}

test "a list read last out of a record a call was handed or answered grows in place" {
  let handed = |n: Int| metered(|| pushed({ items: [], at: 0 }, n).items.len()).bytes;
  let answered = |n: Int| metered(|| built(n).items.len()).bytes;
  assert(handed(8000) < 6 * handed(2000), Some(f"{handed(2000)} then {handed(8000)} bytes"));
  assert(answered(800) < 6 * answered(200), Some(f"{answered(200)} then {answered(800)} bytes"))
}

test "a record made once and handed down calls that capture it is never made again" {
  let c = { items: [1, 2], at: 0 };
  let kept = [c];
  assert_eq(captured(c, 3), 3);
  assert_eq(metered(|| captured(c, 100)).allocations, metered(|| captured_int(1, 100)).allocations);
  assert_eq(kept.len(), 1)
}

test "a loop's state updated through a call takes the cells of the state it replaced" {
  assert_eq(scanned(5), 5);
  // A thousand more steps grow the list as the same update written in the loop does, and make no
  // state.
  let called = |n: Int| metered(|| scanned(n)).allocations;
  let inline = |n: Int| metered(|| scanned_inline(n)).allocations;
  assert_eq(called(2000) - called(1000), inline(2000) - inline(1000))
}

test "a record a call was handed and holds twice is made once" {
  let cost = |f: (Cursor) -> List<Cursor>| metered(|| f({ items: [1], at: 0 }).len()).allocations;
  assert_eq(cost(four), cost(twice))
}

test "a record of counted fields crossing calls gives back every count it took" {
  assert_eq(metered(|| walked({ items: [1, 2], at: 0 }, 10).at).live, 0);
  assert_eq(metered(|| pushed({ items: [], at: 0 }, 10).items.len()).live, 0);
  assert_eq(metered(|| built(10).items.len()).live, 0);
  assert_eq(metered(|| twice({ items: [1], at: 2 }).len()).live, 0);
  assert_eq(metered(|| same({ items: [4], at: 5 }).at).live, 0);
  assert_eq(metered(|| later({ items: [1, 2], at: 3 })()).live, 0);
  assert_eq(metered(|| noted(renamed({ name: "a", note: Some("b") }, "c")).len()).live, 0);
  assert_eq(metered(|| if last_clear({ unused: 1, bytes: b"\x01\x00" }) { 1 } else { 0 }).live, 0);
  assert_eq(metered(|| doubled({ items: [1], at: 0 }).len()).live, 0);
  assert_eq(metered(|| listed({ items: [1], at: 0 }).len()).live, 0);
  assert_eq(metered(|| paired({ items: [1], at: 0 }).a.len()).live, 0)
}
