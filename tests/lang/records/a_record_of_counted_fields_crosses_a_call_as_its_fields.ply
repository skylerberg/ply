type Cursor = { items: List<Int>, at: Int }

fn advanced(c: Cursor) -> Cursor = { items: c.items, at: c.at + 1 }

fn advanced_through_calls(c: Cursor, n: Int) -> Cursor =
  if n <= 0 { c } else { advanced(advanced_through_calls(advanced(c), n - 1)) }

fn pushed(c: Cursor, n: Int) -> Cursor =
  if n <= 0 { c } else { pushed({ items: c.items.push(n), at: c.at + 1 }, n - 1) }

fn built(n: Int) -> Cursor =
  if n <= 0 { { items: [], at: 0 } } else {
    let c = built(n - 1);
    { items: c.items.push(n), at: c.at + 1 }
  }

fn twice(c: Cursor) -> List<Cursor> = [c, c]

fn same<a>(x: a) -> a = x

fn later(c: Cursor) -> () -> Int = || c.items.len() + c.at

fn last_clear(b: { unused: Int, bytes: Bytes }) -> Bool / {abort.raise} =
  b.unused == 0 || b.bytes.at(b.bytes.len() - 1) == 0

fn tail_of(c: Cursor) -> List<Int> = c.items

fn doubled(c: Cursor) -> List<Int> = c.items.push(tail_of(c).len())

fn items_twice(c: Cursor) -> List<List<Int>> = [c.items, tail_of(c)]

fn paired(c: Cursor) -> { a: List<Int>, b: List<Int> } = { a: c.items, b: tail_of(c) }

fn looked(c: Cursor, a: Int) -> Int = c.items.len() + c.at + a

fn captured(c: Cursor, n: Int) -> Int =
  if n <= 0 { 0 } else { [n].map(|a: Int| looked(c, a)).len() + captured(c, n - 1) }

type Scan = { at: Int, seen: List<Int>, out: List<Int> }

fn stepped(s: Scan) -> Scan = { at: s.at + 1, seen: s.seen, out: s.out.push(s.at) }

fn scanned(n: Int) -> Int / {abort.raise} =
  iterate({ at: 0, seen: [], out: [] }, n + 1, |s: Scan|
    if s.at >= n { Stop(s.out) } else { Continue(stepped(s)) }).len(
  )

type Named = { name: String, note: Option<String> }

fn renamed(n: Named, to: String) -> Named = { ..n, name: to }

fn noted(n: Named) -> String = match n.note { Some(x) -> f"{n.name}:{x}", None -> n.name }

test "a record with a list or string field is passed through calls and returned with its original fields" {
  assert_eq(advanced_through_calls({ items: [1, 2], at: 0 }, 3), { items: [1, 2], at: 6 });
  assert_eq(pushed({ items: [], at: 0 }, 3), { items: [3, 2, 1], at: 3 });
  assert_eq(built(3), { items: [1, 2, 3], at: 3 });
  assert_eq(twice({ items: [1], at: 2 }), [{ items: [1], at: 2 }, { items: [1], at: 2 }]);
  assert_eq(same({ items: [4], at: 5 }).at, 5);
  assert_eq(later({ items: [1, 2], at: 3 })(), 5);
  assert_eq(noted(renamed({ name: "a", note: Some("b") }, "c")), "c:b");
  assert_eq(noted(renamed({ name: "a", note: None }, "d")), "d");
  assert(last_clear({ unused: 1, bytes: b"\x01\x00" }));
  assert(!last_clear({ unused: 1, bytes: b"\x01" }));
  assert_eq(doubled({ items: [1], at: 0 }), [1, 1]);
  assert_eq(items_twice({ items: [1], at: 0 }), [[1], [1]]);
  assert_eq(paired({ items: [1], at: 0 }), { a: [1], b: [1] })
}

test "a record passed to functions that each capture it in a closure still returns its original contents" {
  let c = { items: [1, 2], at: 0 };
  let records = [c];
  assert_eq(captured(c, 3), 3);
  assert_eq(records.len(), 1)
}

test "a loop's state updated through a call returns what the loop built" {
  assert_eq(scanned(5), 5)
}
