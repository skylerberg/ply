//! A record holding a small record in place is held back as its own fields and the inner record's,
//! and crosses a call as them and each record's word: a walk that answers a record and where it
//! stands makes no object at any step, however the record was built, and it reads, compares and
//! matches as it did.

type Range = { lo: Int, hi: Int }

type Grown = { r: Range, n: Int }

fn grown(r: Range, x: Int) -> Grown =
  if x < r.lo { { r: { lo: x, hi: r.hi }, n: 1 } }
  else if x > r.hi { { r: { ..r, hi: x }, n: 1 } }
  else { { r: r, n: 0 } }

fn point(i: Int) -> Int = i * 7919 % 1000 - 500

fn spread(k: Int, i: Int, r: Range, n: Int) -> Grown / {diverges} =
  if i >= k { { r: r, n: n } } else {
    let g = grown(r, point(i));
    spread(k, i + 1, g.r, n + g.n)
  }

/// A walk whose state is the record itself, handed back in at each step.
fn widened(k: Int, i: Int, g: Grown) -> Grown / {diverges} =
  if i >= k { g } else {
    let next = grown(g.r, point(i));
    widened(k, i + 1, { ..next, n: g.n + next.n })
  }

type Named = { name: String, uses: Int }

type Seen = { named: Named, fresh: Bool }

fn seen(m: Named, name: String) -> Seen =
  if m.name == name { { named: { ..m, uses: m.uses + 1 }, fresh: false } }
  else { { named: { name: name, uses: 1 }, fresh: true } }

fn counted(
  names: List<String>,
  i: Int,
  m: Named,
  fresh: Int,
) -> { m: Named, fresh: Int } / {diverges} =
  if i >= names.len() { { m: m, fresh: fresh } } else {
    let s = seen(m, match names.at(i) { Some(x) -> x, None -> "" });
    counted(names, i + 1, s.named, fresh + (if s.fresh { 1 } else { 0 }))
  }

/// A decoder's answer: where it stopped and the record it read there.
type Taken = { at: Int, value: Range }

fn taken(s: Bytes, at: Int) -> Taken / {abort.raise} =
  { at: at + 2, value: { lo: s.at(at) - 48, hi: s.at(at + 1) - 48 } }

fn widest(s: Bytes, at: Int, best: Int) -> Int / {abort.raise, diverges} =
  if at + 2 > s.len() { best } else {
    let t = taken(s, at);
    widest(s, t.at, if t.value.hi - t.value.lo > best { t.value.hi - t.value.lo } else { best })
  }

type Reader = { read: (Bytes, Int) -> Taken / {abort.raise} }

fn reader() -> Reader = { read: |s: Bytes, at: Int| taken(s, at) }

fn widest_by(r: Reader, s: Bytes, at: Int, best: Int) -> Int / {abort.raise, diverges} =
  if at + 2 > s.len() { best } else {
    let t = (r.read)(s, at);
    widest_by(r, s, t.at, if t.value.hi - t.value.lo > best { t.value.hi - t.value.lo }
    else { best })
  }

fn found(s: Bytes, at: Int) -> Option<Taken> / {abort.raise} =
  if at + 2 > s.len() { None } else { Some(taken(s, at)) }

fn pairs(s: Bytes, at: Int, n: Int) -> Int / {abort.raise, diverges} =
  match found(s, at) { None -> n, Some(t) -> pairs(s, t.at, n + 1) }

type Wide = { a: Int, b: Int, c: Int, d: Int, e: Int, s: String }

type Marked = { wide: Wide, mark: Option<String> }

/// A record a branch joins holding a wide record in place and an `Option`, which a closure and a
/// fold read and a `match` reads last.
fn marked(flag: Bool, wide: Wide, xs: List<Int>) -> Int = {
  let m: Marked = if flag { { wide: wide, mark: Some("x") } } else { { wide: wide, mark: None } };
  let at = |x: Int| x + m.wide.c;
  let n = xs.fold(at(m.wide.b), |acc: Int, x: Int|
    acc + x + (match m.mark { Some(_) -> 1, None -> 0 }));
  match m.mark { Some(s) -> s.len() + n, None -> n }
}

type Level = { at: Int, name: String, items: List<Int> }

type Stack = { below: List<Level>, top: Level }

fn pushed(s: Stack, n: Int) -> Stack = { ..s, top: { ..s.top, items: s.top.items.push(n) } }

/// The record a record holds in place, bound to a name of its own, which one arm lets go of while
/// it hands the whole record on and another builds from it.
fn acted(s: Stack, action: Int) -> Stack = {
  let top = s.top;
  let renamed = |name: String| { ..s, top: { ..top, name: name, items: [] } };
  match action { 0 -> pushed(s, 1), _ -> renamed("x") }
}

fn pairs_text(n: Int) -> Bytes / {abort.raise} =
  Bytes::concat_all(
    range(0, n).map(|i: Int| byte_of_int(48 + i % 5).concat(byte_of_int(53 + i % 5))),
  )

test "a record holding a record in place answers what it always did" {
  assert_eq(grown({ lo: 0, hi: 0 }, 5), { r: { lo: 0, hi: 5 }, n: 1 });
  assert_eq(grown({ lo: 0, hi: 9 }, 5), { r: { lo: 0, hi: 9 }, n: 0 });
  assert_eq(spread(3, 0, { lo: 0, hi: 0 }, 0), { r: { lo: 0 - 500, hi: 419 }, n: 2 });
  assert_eq(widened(3, 0, { r: { lo: 0, hi: 0 }, n: 0 }), spread(3, 0, { lo: 0, hi: 0 }, 0));
  assert(spread(4, 0, { lo: 0, hi: 0 }, 0) == widened(4, 0, { r: { lo: 0, hi: 0 }, n: 0 }), None);
  assert_eq(
    match grown({ lo: 0, hi: 0 }, 0 - 3) { { r: { lo: l, hi: _ }, n: n } -> l * 10 + n },
    0 - 29,
  );
  assert_eq(counted(["a", "a", "b", "b", "b"], 0, { name: "", uses: 0 }, 0), {
    m: { name: "b", uses: 3 },
    fresh: 2,
  });
  assert_eq(taken(b"19", 0), { at: 2, value: { lo: 1, hi: 9 } });
  assert_eq(widest(b"152839", 0, 0), 6);
  assert_eq(widest_by(reader(), b"152839", 0, 0), 6);
  assert_eq(found(b"1", 0), None);
  assert_eq(found(b"12", 0), Some({ at: 2, value: { lo: 1, hi: 2 } }));
  assert_eq(pairs(pairs_text(4), 0, 0), 4);
  let wide = { a: 1, b: 2, c: 3, d: 4, e: 5, s: "w" };
  assert_eq(marked(true, wide, [10]), 17);
  assert_eq(marked(false, wide, [10]), 15);
  let stack = { below: [], top: { at: 3, name: "t", items: [2] } };
  assert_eq(acted(stack, 0).top.items, [2, 1]);
  assert_eq(acted(stack, 5).top, { at: 3, name: "x", items: [] });
  assert_eq(stack.top.items, [2])
}

test "a record holding a record in place makes no object at a step" {
  let r = { lo: 0, hi: 0 };
  assert_eq(
    metered(|| spread(1000, 0, r, 0)).allocations,
    metered(|| spread(10, 0, r, 0)).allocations,
  );
  let g = { r: r, n: 0 };
  assert_eq(metered(|| widened(1000, 0, g)).allocations, metered(|| widened(10, 0, g)).allocations);
  let short = pairs_text(10);
  let long = pairs_text(1000);
  assert_eq(
    metered(|| widest(long, 0, 0)).allocations,
    metered(|| widest(short, 0, 0)).allocations,
  );
  let rd = reader();
  assert_eq(
    metered(|| widest_by(rd, long, 0, 0)).allocations,
    metered(|| widest_by(rd, short, 0, 0)).allocations,
  );
  assert_eq(metered(|| pairs(long, 0, 0)).allocations, metered(|| pairs(short, 0, 0)).allocations)
}

test "a record holding a record in place gives back every count it took" {
  let names = range(0, 40).map(|i: Int|
    if i % 3 == 0 { "x" } else { "y" ++ Int::to_string(i % 2) });
  assert_eq(metered(|| counted(names, 0, { name: "", uses: 0 }, 0).m.uses).live, 0);
  assert_eq(metered(|| seen({ name: "a", uses: 1 }, "a").named.uses).live, 0);
  assert_eq(metered(|| seen({ name: "a", uses: 1 }, "b").named.name).live, 0);
  assert_eq(metered(|| spread(30, 0, { lo: 0, hi: 0 }, 0).r.hi).live, 0);
  assert_eq(metered(|| pairs(pairs_text(20), 0, 0)).live, 0);
  let stack = { below: [], top: { at: 3, name: "t" ++ "", items: [2] } };
  assert_eq(metered(|| acted(stack, 0).top.items.len()).live, 0);
  assert_eq(metered(|| acted(stack, 5).top.at).live, 0)
}
