type Log = { count: Int, out: List<Int> }

type Nested = { label: Int, log: Log }

fn appended(s: Log, x: Int) -> Log = { ..s, out: s.out.push(x) }

fn counted(s: Log, x: Int) -> Log = { ..s, count: s.count + 1, out: s.out.push(x) }

fn counted_from_copy(s: Log) -> Log = { ..s, out: s.out.push(s.count), count: s.count + 1 }

fn nested(t: Nested, x: Int) -> Nested = { ..t, log: { ..t.log, out: t.log.out.push(x) } }

test "a record's list grows by every push through an update that copies its other fields" {
  let appended_log = range(0, 2000).fold({ count: 7, out: [] }, appended);
  assert_eq(appended_log, { count: 7, out: range(0, 2000) });
  let counted_log = range(0, 2000).fold({ count: 0, out: [] }, counted);
  assert_eq(counted_log, { count: 2000, out: range(0, 2000) });
  let nested_log = range(0, 2000).fold({ label: 3, log: { count: 5, out: [] } }, nested);
  assert_eq(nested_log, { label: 3, log: { count: 5, out: range(0, 2000) } })
}

test "a set field that reads a copied field reads the base's value" {
  let s = range(0, 2000).fold({ count: 0, out: [] }, |s: Log, _: Int| counted_from_copy(s));
  assert_eq(s, { count: 2000, out: range(0, 2000) });
  let base: Log = { count: 4, out: [1] };
  let copied = { ..base, out: [base.count] };
  assert_eq(copied, { count: 4, out: [4] });
  assert_eq(base, { count: 4, out: [1] })
}
