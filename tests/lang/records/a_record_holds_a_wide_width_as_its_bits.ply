//! A record holds a 64-bit width as its bits wherever it is made: a literal, an update, generic code
//! and a map's entries read back its whole range, a `U64` past 2^63 and an `I64` below zero.

type Tally = { count: U64, label: String, offset: I64 }

fn tally(count: U64, offset: I64) -> Tally = { count: count, label: "t", offset: offset }

fn bumped(t: Tally, by: U64) -> Tally = { ..t, count: t.count + by }

fn wrapped<a>(value: a) -> { inner: a } = { inner: value }

test "a literal and an update hold the whole range" {
  let t = tally(0xFFFF_FFFF_FFFF_FFF0u64, -5i64);
  assert_eq(bumped(t, 15u64).count, 0xFFFF_FFFF_FFFF_FFFFu64);
  assert_eq(t.offset, -5i64);
  assert(t.count > 0x8000_0000_0000_0000u64)
}

test "generic code and a map's entries hold a width as its type does" {
  let w = wrapped(0x8000_0000_0000_0001u64);
  assert_eq(w.inner, 0x8000_0000_0000_0001u64);
  let m = map_insert(map_insert(map_new(), "a", 0xFFFF_FFFF_FFFF_FFFFu64), "b", 1u64);
  assert_eq(map_first(m), Some({ key: "a", value: 0xFFFF_FFFF_FFFF_FFFFu64 }))
}
