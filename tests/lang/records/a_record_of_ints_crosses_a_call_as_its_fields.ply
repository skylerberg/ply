//! A record of `Int`s and scalars crosses a call as its fields and is made only where its word is
//! asked for: threaded through calls it allocates nothing, and an `Int` past the word's range
//! survives the trip.

type Span = { start: Int, end: Int }

fn widened(s: Span, by: Int) -> Span = { start: s.start - by, end: s.end + by }

fn walked(s: Span, i: Int, n: Int) -> Span =
  if i >= n { s } else { walked(widened(s, 1), i + 1, n) }

fn width(s: Span) -> Int = s.end - s.start

fn far() -> Int = 4611686018427387904

/// `s` is read again after a widened copy of it is made, so the copy cannot take its cells.
fn spread(s: Span) -> Int = width(widened(s, 1)) + width(s)

fn spreads(s: Span, i: Int, n: Int, acc: Int) -> Int =
  if i >= n { acc } else { spreads(s, i + 1, n, acc + spread(s)) }

test "a record of ints answers and crosses as its fields" {
  assert_eq(walked({ start: 0, end: 0 }, 0, 5), { start: -5, end: 5 });
  assert_eq(width(widened({ start: far(), end: far() + 10 }, 1)), 12);
  assert_eq(widened({ start: far(), end: far() }, 1).end, far() + 1);
  assert_eq([widened({ start: 1, end: 2 }, 1)], [{ start: 0, end: 3 }])
}

test "a record of ints made and handed to calls allocates alike for ten and a thousand" {
  let cost = |n: Int| metered(|| spreads({ start: 0, end: 4 }, 0, n, 0)).allocations;
  assert_eq(cost(1000), cost(10))
}
