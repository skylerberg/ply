//! A derived `bin` decoder reads a constructor's record argument field by field and builds it in
//! place, so a value decodes into as many objects as one holding the same fields as arguments.

import std.bin

type Named = | Named({ name: String, at: Int }) | Nameless

type Pair = | Pair(String, Int) | Unpaired

derive bin for Named

derive bin for Pair

fn decoded_named(n: Int) -> Int / {abort.raise} = {
  let bytes = bin::encode(
    map(range(0, n), |i: Int| Named({ name: "x", at: i })),
    bin::list_bin(named_bin()),
  );
  metered(||
    match bin::decode(bytes, bin::list_bin(named_bin())) {
      Ok(xs) -> len(xs),
      Err(_) -> 0,
    }).allocations
}

fn decoded_pair(n: Int) -> Int / {abort.raise} = {
  let bytes = bin::encode(map(range(0, n), |i: Int| Pair("x", i)), bin::list_bin(pair_bin()));
  metered(||
    match bin::decode(bytes, bin::list_bin(pair_bin())) {
      Ok(xs) -> len(xs),
      Err(_) -> 0,
    }).allocations
}

test "a constructor's record argument decodes as its fields would" {
  let x = Named({ name: "n", at: 3 });
  assert_eq(bin::decode(bin::encode(x, named_bin()), named_bin()), Ok(x));
  assert_eq(decoded_named(100), decoded_pair(100))
}
