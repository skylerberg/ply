//! A value handed to the runtime is written as the one encoding the runtime reads, and one handed
//! back is read from it as compiled code makes a value of its type: `observe` sends a value out
//! and back, and `assert_eq` hands the runtime both of its sides, to compare and to show where
//! they differ.

type Shape = | Dot | Line(Int) | Box({ w: Int, h: Float })

type Tree = | Leaf(String) | Node(Tree, Tree)

fn returned<a>(x: a) -> a = observe(x)

test "every kind of scalar comes back from the runtime as it went" {
  assert_eq(observe(7), 7);
  assert_eq(observe(0 - 9223372036854775807 - 1), 0 - 9223372036854775807 - 1);
  assert_eq(observe(true), true);
  assert_eq(observe(()), ());
  assert_eq(observe(2.5), 2.5);
  let negative_zero = Float::of_bits(0 - 9223372036854775807 - 1);
  assert_eq(bits_of_float(observe(negative_zero)), bits_of_float(negative_zero));
  assert_eq(observe(1.50m), 1.50m);
  assert_eq(Decimal::scale(observe(1.50m)), 2);
  assert_eq(observe('\u{e9}'), '\u{e9}');
  assert_eq(observe("h\u{e9}llo"), "h\u{e9}llo");
  assert_eq(observe(b"\x00\xff"), b"\x00\xff");
  assert_eq(observe(255u8), 255u8);
  assert_eq(observe(-1i8), -1i8);
  assert_eq(observe(18446744073709551615u64), 18446744073709551615u64);
  assert_eq(observe(-1i128), -1i128);
  assert_eq(
    observe(340282366920938463463374607431768211455u128),
    340282366920938463463374607431768211455u128,
  )
}

test "records, sums, lists, arrays and maps come back from the runtime as they went" {
  let none: Option<Int> = None;
  let failed: Result<Int, String> = Err("no");
  assert_eq(observe({ a: 1, b: "x" }), { a: 1, b: "x" });
  assert_eq(observe([Dot, Line(4), Box({ w: 1, h: 0.5 })]), [Dot, Line(4), Box({ w: 1, h: 0.5 })]);
  let tree = Node(Leaf("a"), Node(Leaf("b"), Leaf("c")));
  assert_eq(observe(tree), tree);
  assert_eq(observe(Some("x")), Some("x"));
  assert_eq(observe(none), none);
  assert_eq(observe(failed), failed);
  let m = Map::new().insert(2, ["b"]).insert(1, ["a", "aa"]);
  assert_eq(observe(m), m);
  let xs = Array::of_list([Some(1), None, Some(3)]);
  assert_eq(observe(xs), xs);
  assert_eq(returned(range(0, 300)), range(0, 300))
}

test "a value sent to the runtime and back holds nothing once it is let go" {
  let tree = Node(Leaf("a"), Node(Leaf("b"), Leaf("c")));
  let m = Map::new().insert("k", [tree, tree]);
  assert_eq(metered(|| { observe(m).len() }).live, 0)
}

test "assert_eq hands the runtime both sides, and raises where they differ" {
  assert_eq(try[abort.raise] { assert_eq([Line(1)], [Line(1)]) }, Ok(()));
  assert_eq(
    match try[abort.raise] { assert_eq({ a: Dot }, { a: Line(2) }) } {
      Ok(_) -> false,
      Err(_) -> true,
    },
    true,
  )
}
