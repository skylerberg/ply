effect note {
  read say() -> Int
}

fn work() -> Int / {note.read} = note.say()

test "inside `simulate`, a spawned task uses the handler installed around its `task.spawn` call" {
  let r = simulate {
    handle {
      let t = task.spawn(|| work());
      task.join(t)
    } with {
      note.say() -> 41,
    }
  };
  assert_eq(r, 41)
}

test "a spawned task still uses the handlers around its `task.spawn` call after that call has returned" {
  let r = simulate {
    let t = handle { task.spawn(|| work()) } with { note.say() -> 7 };
    task.join(t)
  };
  assert_eq(r, 7)
}

test "a spawned task can use a handler clause that ends by calling `k` to resume" {
  let r = simulate {
    handle {
      let t = task.spawn(|| work() + work());
      task.join(t)
    } with {
      note.say() resume k -> k(20),
    }
  };
  assert_eq(r, 40)
}
