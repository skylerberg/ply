// A task performs against the handlers that enclosed its spawn, as they stood at the spawn.

effect note {
  read say() -> Int
}

fn work() -> Int / {note.read} = note.say()

test "a task reaches a handler installed around its spawn inside the region" {
  let r = simulate {
    handle {
      let t = task.spawn(|| work());
      task.join(t)
    } with {
      note.say() -> 41,
    }
  };
  assert_eq(r, 41)
}

test "a task keeps the handlers of its spawn after the spawner has left them" {
  let r = simulate {
    let t = handle {
      task.spawn(|| work())
    } with {
      note.say() -> 7,
    };
    task.join(t)
  };
  assert_eq(r, 7)
}
