// A type that holds only some of what its fields could says how its values are drawn, and a
// sampled claim over it sees no others. `gen for T by f` is also a definition, `_sample_T`: what
// `f`'s generator draws from a stream a root and a key name, or from a record of draws. A record
// replayed makes the value again, and a shorter or lower one a smaller value the generator makes,
// which is how a counterexample shrinks without leaving the type.

import std.gen
import std.gen (Gen)

pub type Even = new { n: Int }

gen for Even by evens

fn evens() -> Gen<Even> = gen::map(gen::int_between(0, 50), |k: Int| { n: 2 * k })

// A type's parameter is drawn by whoever draws the type: its generator chooses among values
// handed in.
pub type Pair<a> = | Pair(a, a)

gen for Pair by pairs

fn pairs<a>(g: Gen<a>) -> Gen<Pair<a>> = gen::map2(g, g, |x: a, y: a| Pair(x, y))

// A generator is no key and no show: the type compares as its fields do.
pub type Coin = | Heads | Tails

gen for Coin by coins

fn coins() -> Gen<Coin> = gen::such_that(gen::elements([Heads, Tails]), |c: Coin| c == Tails, 20)

test "a sampler draws what its type's generator makes, at any root" {
  assert(
    fold(range(0, 40), true, |ok: Bool, root: Int|
      ok
        && (match _sample_Even(root, b"k", 9, None).value {
          Some(e) -> e.n % 2 == 0 && e.n <= 100,
          None -> false,
        })),
  );
  assert_eq(_sample_Even(3, b"k", 9, None), _sample_Even(3, b"k", 9, None))
}

test "a record of draws replayed makes the value again, and a lower one a smaller value" {
  let first = _sample_Even(7, b"k", 9, None);
  assert_eq(_sample_Even(0, b"", 9, Some(first.record)).value, first.value);
  assert_eq(_sample_Even(0, b"", 9, Some([21])).value, Some({ n: 42 }));
  assert_eq(_sample_Even(0, b"", 9, Some([])).value, Some({ n: 0 }));
  // A draw past its bound is clamped, so every record makes a value of the type.
  assert_eq(_sample_Even(0, b"", 9, Some([900])), {
    value: Some({ n: 100 }),
    record: [50],
    discards: 0,
  })
}

test "a parameter's values are chosen among those the sampler is handed" {
  assert_eq(_sample_Pair(["a", "b", "c"], 0, b"", 9, Some([2, 1])).value, Some(Pair("c", "b")));
  let evens = [{ n: 2 }, { n: 4 }];
  assert_eq(_sample_Pair(evens, 0, b"", 9, Some([1])).value, Some(Pair({ n: 4 }, { n: 2 })));
  let none: List<Int> = [];
  assert_eq(_sample_Pair(none, 0, b"", 9, None).value, None)
}

test "what a generator turned away is counted, and its type still compares as its fields do" {
  let drawn = _sample_Coin(0, b"", 9, Some([0, 0, 1]));
  assert_eq(drawn, { value: Some(Tails), record: [0, 0, 1], discards: 2 });
  assert(Heads != Tails && compare(Heads, Tails) == Less)
}
