// An alias may name a `Map` keyed by one of its parameters. The key's order is promised where the
// alias is used, by the same `where derivable(ord, a)` a signature naming the `Map` would carry.

pub type Set<a> = Map<a, Unit>

fn none<a>() -> Set<a>
  where derivable(ord, a)
= map_new()

fn adding<a>(s: Set<a>, x: a) -> Set<a>
  where derivable(ord, a)
= map_insert(s, x, ())

fn members<a>(s: Set<a>) -> List<a>
  where derivable(ord, a)
= map_keys(s)

test "a set alias keeps each element once, in order" {
  assert_eq(members(adding(adding(adding(none(), 3), 1), 3)), [1, 3]);
  assert_eq(members(adding(adding(none(), "b"), "a")), ["a", "b"])
}
