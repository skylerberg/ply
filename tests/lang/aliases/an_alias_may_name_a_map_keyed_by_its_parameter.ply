//! An alias may name a `Map` keyed by one of its parameters. A signature naming the alias at a
//! parameter of its own is held to the key's order, as one naming the `Map` is, without writing it.

pub type Set<a> = Map<a, Unit>

fn none<a>() -> Set<a> = Map::new()

fn adding<a>(s: Set<a>, x: a) -> Set<a> = s.insert(x, ())

fn members<a>(s: Set<a>) -> List<a> = s.keys()

test "a set alias stores each element once, in sorted order" {
  assert_eq(members(adding(adding(adding(none(), 3), 1), 3)), [1, 3]);
  assert_eq(members(adding(adding(none(), "b"), "a")), ["a", "b"])
}
