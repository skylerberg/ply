//! `task.cancel` stops a task where it stands: whatever it waits on is let go, an answer it has not
//! yet run on goes with it, and it performs nothing more. `task.await` answers `None` for a
//! cancelled task, where `task.join` would have nothing to answer. A deadline is the two together.

effect log {
  write note[l](n: Int) -> Unit
}

fn chatty(n: Int) -> Int / {log.write[l], clock.write} = {
  log.note[l](n);
  clock.sleep(Duration(10));
  log.note[l](n + 1);
  n
}

test "a cancelled task performs nothing after the cancel, in every interleaving" {
  with_cell[seen]([]) { c ->
    handle {
      simulate {
        let t = task.spawn(|| chatty(1));
        let stopped = task.cancel(t);
        log.note[l](0);
        assert(stopped);
        assert_eq(task.await(t), None)
      };
      let heard = cell_get(c);
      assert(heard == [0] || heard == [1, 0])
    } with {
      log.note[l](n) -> cell_set(c, push(cell_get(c), n)),
    }
  }
}

test "cancelling a task that already ended answers false and leaves its answer" {
  simulate {
    let t = task.spawn(|| 7);
    assert_eq(task.join(t), 7);
    assert(!task.cancel(t));
    assert_eq(task.await(t), Some(7))
  }
}

test "a second cancel of a task answers false" {
  simulate {
    let t = task.spawn(|| slow(10));
    assert(task.cancel(t));
    assert(!task.cancel(t));
    assert_eq(task.await(t), None)
  }
}

// The receiver ran to its end, was stopped before it ran, or was answered and then stopped: the
// value is its answer, still in the channel, or gone with the cancelled task.
test "a value a cancelled receiver was answered goes with it, and the search tries each order" {
  with_cell[seen]([]) { c ->
    handle {
      simulate {
        let ch = task.channel(1);
        assert(task.send(ch, 7));
        let t = task.spawn(|| {
          let got = task.recv(ch);
          log.note[l](1);
          got
        });
        let stopped = task.cancel(t);
        let answered = task.await(t);
        task.close(ch);
        let left = task.recv(ch);
        let ran = cell_get(c) == [1];
        assert(
          (answered == Some(Some(7)) && left == None && ran)
            || (answered == None && left == Some(7) && !ran && stopped)
            || (answered == None && left == None && !ran && stopped),
        )
      }
    } with {
      log.note[l](n) -> cell_set(c, push(cell_get(c), n)),
    }
  }
}

fn slow(n: Int) -> Int / {clock.write} = {
  clock.sleep(Duration(n));
  n
}

/// The work answers before the deadline, or the deadline stops it; either way the loser goes.
fn within<a>(d: Duration, work: () -> a / {clock.write}) -> Option<a> / {task.write, clock.write} = {
  let worker = task.spawn(work);
  let timer = task.spawn(|| {
    clock.sleep(d);
    task.cancel(worker);
    ()
  });
  let answer = task.await(worker);
  task.cancel(timer);
  answer
}

test "work inside its deadline answers, and work past it is stopped there" {
  simulate {
    assert_eq(within(Duration(100), || slow(10)), Some(10));
    assert_eq(within(Duration(5), || slow(10)), None);
    assert_eq(clock.now(), Instant(15))
  }
}

fn joined_or<a>(t: Task<a>, otherwise: a) -> a / {task.write} =
  handle { task.join(t) } with { abort.raise(m) -> otherwise }

test "a join of a cancelled task raises in the task that joins, whichever came first" {
  simulate {
    let t = task.spawn(|| slow(10));
    let waiting = task.spawn(|| joined_or(t, 0 - 1));
    assert(task.cancel(t));
    assert_eq(task.join(waiting), 0 - 1);
    assert_eq(joined_or(t, 0 - 2), 0 - 2)
  }
}
