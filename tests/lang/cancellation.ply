effect log {
  write note[l](n: Int) -> Unit
  read heard[l]() -> List<Int>
}

fn chatty(n: Int) -> Int / {log.write[l], clock.write} = {
  log.note[l](n);
  clock.sleep(Duration(10));
  log.note[l](n + 1);
  n
}

test "a cancelled task performs nothing after the cancel, in every interleaving" {
  let recorded = handle {
    simulate {
      let t = task.spawn(|| chatty(1));
      let stopped = task.cancel(t);
      log.note[l](0);
      assert(stopped);
      assert_eq(task.await(t), None)
    }
  } with {
    var seen = [],
    log.note[l](n) -> {
      seen = seen.push(n);
    },
    return u -> seen,
  };
  assert(recorded == [0] || recorded == [1, 0])
}

test "cancelling a task that already ended returns false and leaves its result" {
  simulate {
    let t = task.spawn(|| 7);
    assert_eq(task.join(t), 7);
    assert(!task.cancel(t));
    assert_eq(task.await(t), Some(7))
  }
}

test "a second cancel of a task returns false" {
  simulate {
    let t = task.spawn(|| slow(10));
    assert(task.cancel(t));
    assert(!task.cancel(t));
    assert_eq(task.await(t), None)
  }
}

test "cancelling a task blocked on `task.recv` either lets the receive finish or leaves the value in the channel, in each search order" {
  handle {
    simulate {
      let ch = task.channel(1);
      assert(task.send(ch, 7));
      let t = task.spawn(|| {
        let got = task.recv(ch);
        log.note[l](1);
        got
      });
      let stopped = task.cancel(t);
      let returned = task.await(t);
      task.close(ch);
      let left = task.recv(ch);
      let ran = log.heard[l]() == [1];
      assert(
        (returned == Some(Some(7)) && left == None && ran)
          || (returned == None && left == Some(7) && !ran && stopped)
          || (returned == None && left == None && !ran && stopped),
      )
    }
  } with {
    var seen = [],
    log.note[l](n) -> {
      seen = seen.push(n);
    },
    log.heard[l]() -> seen,
  }
}

fn slow(n: Int) -> Int / {clock.write} = {
  clock.sleep(Duration(n));
  n
}

fn within<a>(
  d: Duration,
  work: keep () -> a / {clock.write},
) -> Option<a> / {task.write, clock.write} = {
  let worker = task.spawn(work);
  let timer = task.spawn(|| {
    clock.sleep(d);
    task.cancel(worker);
    ()
  });
  let result = task.await(worker);
  task.cancel(timer);
  result
}

test "work inside its deadline returns, and work past it is stopped there" {
  simulate {
    assert_eq(within(Duration(100), || slow(10)), Some(10));
    assert_eq(within(Duration(5), || slow(10)), None);
    assert_eq(clock.now(), Instant(15))
  }
}

fn joined_or<a>(t: Task<a>, otherwise: a) -> a / {task.write} =
  handle { task.join(t) } with { abort.raise(m) -> otherwise }

test "joining a cancelled task raises in the joining task, whether the join started before or after the cancel" {
  simulate {
    let t = task.spawn(|| slow(10));
    let waiting = task.spawn(|| joined_or(t, 0 - 1));
    assert(task.cancel(t));
    assert_eq(task.join(waiting), 0 - 1);
    assert_eq(joined_or(t, 0 - 2), 0 - 2)
  }
}
