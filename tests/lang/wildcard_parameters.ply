// `_` anywhere a parameter is named: it binds like any other name and is unreachable only
// because `_` never lexes as an identifier in expression position.

fn drop_second(_: Int, y: Int) -> Int = y

fn drop_two(_: Int, _: Int, z: Int) -> Int = z

effect ping {
  read pong(_: Int, y: Int) -> Int
}

fn call_it() -> Int / {ping.pong} = ping.pong(1, 2)

test "a fn parameter may be written `_`, more than once" {
  assert_eq(drop_second(1, 2), 2);
  assert_eq(drop_two(1, 2, 3), 3)
}

test "a lambda parameter may be written `_`" {
  assert_eq(fold([1, 2, 3], 0, |acc: Int, _: Int| acc + 1), 3)
}

test "an effect signature and a handler clause may each be written `_`" {
  let answer = handle { call_it() } with { ping.pong(_, y) -> y + 1 };
  assert_eq(answer, 3)
}

fn main() -> Int = 0
