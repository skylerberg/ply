import modules.guarded (keyed, Unkeyed, Short, guard)

test "a raise of an effect imported by name lands at its try" {
  assert_eq(try { keyed("SHA1", b"key") }, Err(Unkeyed("SHA1")))
}

test "a raise of an effect imported by name lands at a clause for it" {
  let n = handle {
    keyed("SHA1", b"key").len()
  } with {
    guard.refused(e) -> match e { Unkeyed(name) -> name.len(), Short(n) -> n },
  };
  assert_eq(n, 4)
}
