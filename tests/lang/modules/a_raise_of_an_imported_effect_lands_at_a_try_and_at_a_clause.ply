import modules.guarded (keyed, Unkeyed, Short, guard)

test "`try` returns `Err` for a raise of an effect imported by name" {
  assert_eq(try { keyed("SHA1", b"key") }, Err(Unkeyed("SHA1")))
}

test "a `handle` clause for an effect imported by name handles a raise of that effect" {
  let n = handle {
    keyed("SHA1", b"key").len()
  } with {
    guard.rejected(e) -> match e { Unkeyed(name) -> name.len(), Short(n) -> n },
  };
  assert_eq(n, 4)
}
