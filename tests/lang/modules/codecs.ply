import std.bin
import std.json
import std.json (JsonCodec)

pub type Part = { sku: String, qty: Int }
pub type Tree = | Leaf | Node(Tree, Part, List<Twig>)
pub type Twig = | Bud | Sprout(Tree)

derive json for Part
derive bin for Part
derive bin for Tree
derive bin for Twig

pub fn part_codec() -> JsonCodec<Part> = part_json()

pub fn grown() -> Tree = Node(Leaf, { sku: "nut", qty: 1 }, [Sprout(Leaf), Bud])
