import modules.alpha
import modules.beta
import modules.store
import modules.store (db)

fn fixture() -> Int = 100

test "a handler discharges an effect another module declares" {
  handle {
    assert_eq(store::total([1, 2, 3]), 21)
  } with {
    db.get[users](k) -> 7,
    db.all[users]() -> 0,
  }
}

// The clause's body sees this module's `fixture`, not the one beside the effect.
test "a clause's body resolves where the handler was written" {
  handle {
    assert_eq(store::reading(), 101)
  } with {
    db.get[users](k) -> 0,
    db.all[users]() -> fixture(),
  }
}

test "definitions of one name in two modules do not collide" {
  assert_eq(alpha::wrapped(), 1);
  assert_eq(beta::wrapped(), 2)
}

test "constructors of one name in two modules are distinct values" {
  assert_eq(beta::theirs(), 1);
  assert_eq(beta::unwrap_local_wrapped(), 2);
  assert_eq(match alpha::make() { alpha::Wrapped(n) -> n }, 1)
}

test "a handler's variable stands in for the database" {
  handle {
    assert_eq(store::total([1, 2]), 14)
  } with {
    var held = 7,
    db.get[users](k) -> held,
    db.all[users]() -> held,
  }
}
