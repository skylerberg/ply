//! An effect whose raise another module catches, and a function raising it.

pub type Refusal = | Unkeyed(String) | Short(Int)

pub effect guard {
  raise refused(e: Refusal)
}

pub fn keyed(name: String, key: Bytes) -> Bytes / {guard.refused} =
  if key.len() > 100 { key } else { guard.refused(Unkeyed(name)) }
