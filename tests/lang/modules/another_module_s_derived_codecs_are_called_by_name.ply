import modules.codecs
import std.bin
import std.json

test "a derived codec of another module round-trips a value" {
  let p = { sku: "bolt", qty: 3 };
  let j = codecs::part_json();
  assert_eq(json::decode_string(json::encode_string(p, j), j), Ok(p));
  assert_eq(json::encode_string(p, codecs::part_codec()), json::encode_string(p, j));
  assert_eq(bin::decode(bin::encode(p, codecs::part_bin()), codecs::part_bin()), Ok(p))
}

test "a codec over two mutually recursive types round-trips a value when called from another module" {
  let t = codecs::grown();
  assert_eq(bin::decode(bin::encode(t, codecs::tree_bin()), codecs::tree_bin()), Ok(t))
}
