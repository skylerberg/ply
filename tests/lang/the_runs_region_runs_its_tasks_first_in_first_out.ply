// A body that performs `task` outside any `simulate` runs under the run's region, which runs the
// tasks that are ready in the order they became so.

test/nondet "tasks outside a simulation run in the order they became ready" {
  let c = task.channel(4);
  let a = task.spawn(|| task.send(c, 1));
  let b = task.spawn(|| task.send(c, 2));
  task.join(a);
  task.join(b);
  assert_eq([task.recv(c), task.recv(c)], [Some(1), Some(2)])
}

// The run's region keeps no task that has ended: what is asked of one after is read off its handle.
test/nondet "a task of the run's scheduler cancelled as it waits is known cancelled once it is gone" {
  let c: Chan<Int> = task.channel(0);
  let waiting = task.spawn(|| task.recv(c));
  task.yield();
  assert(task.cancel(waiting));
  assert_eq(task.await(waiting), None);
  assert_eq(task.await(waiting), None);
  assert(!task.cancel(waiting))
}

test/nondet "a simulate inside a task of the run's scheduler returns what one outside it does" {
  let t = task.spawn(||
    simulate {
      let u = task.spawn(|| 20);
      task.join(u) + 1
    });
  assert_eq(task.join(t), 21)
}
