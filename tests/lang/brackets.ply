//! `bracket(acquire, release, body)` runs `body` on what `acquire` returned, then `release` on it,
//! however `body` ends: by returning, by a raise or a clause that does not resume unwinding through
//! it, or by a cancel. `release` runs where the bracket stands, with the handlers around it. A
//! cancel takes no result from `acquire` and no wait from `release`: it lands when that one
//! returns.

effect log {
  write note[l](s: String) -> Unit
}

effect stop {
  write now() -> Unit
}

fn open_logged(name: String) -> String / {log.write[l]} = {
  log.note[l]("open " ++ name);
  name
}

fn close_logged(name: String) -> Unit / {log.write[l]} = log.note[l]("close " ++ name)

/// What `body` noted, in order.
fn noted<a | e>(body: () -> a / {log.write[l] | e}) -> List<String> / e =
  handle {
    body()
  } with {
    var seen = [],
    log.note[l](s) -> {
      seen = seen.push(s);
    },
    return u -> seen,
  }

test "release runs after a body that returns, and the body's result is the bracket's" {
  let seen = noted(|| {
    let n = bracket(|| open_logged("a"), close_logged, |h: String| {
      log.note[l]("use " ++ h);
      h.len()
    });
    assert_eq(n, 1)
  });
  assert_eq(seen, ["open a", "use a", "close a"])
}

test "release runs when a clause that does not resume unwinds through the body" {
  let seen = noted(|| {
    let returned = handle {
      bracket(|| open_logged("a"), close_logged, |h: String| {
        stop.now();
        log.note[l]("never");
        1
      })
    } with {
      stop.now() resume k -> 0,
    };
    assert_eq(returned, 0)
  });
  assert_eq(seen, ["open a", "close a"])
}

test "release runs with the handlers around the bracket, not those inside the body" {
  let seen = noted(|| {
    bracket(|| open_logged("a"), close_logged, |h: String|
      handle { log.note[l]("muted") } with { log.note[l](s) -> () })
  });
  assert_eq(seen, ["open a", "close a"])
}

test "release runs when a raise unwinds through the body, and the raise goes on to its clause" {
  let seen = noted(|| {
    let returned = handle {
      bracket(|| open_logged("a"), close_logged, |h: String| {
        abort.raise("gone");
        log.note[l]("never");
        1
      })
    } with {
      abort.raise(m) -> m.len(),
    };
    assert_eq(returned, 4)
  });
  assert_eq(seen, ["open a", "close a"])
}

test "brackets nest, and the inner one releases first" {
  let seen = noted(|| {
    handle {
      bracket(|| open_logged("outer"), close_logged, |o: String|
        bracket(|| open_logged("inner"), close_logged, |i: String| {
          stop.now();
          ()
        }))
    } with {
      stop.now() resume k -> (),
    }
  });
  assert_eq(seen, ["open outer", "open inner", "close inner", "close outer"])
}

test "a cancelled task releases what it holds, in every interleaving" {
  let seen = noted(|| {
    simulate {
      let t = task.spawn(||
        bracket(|| open_logged("a"), close_logged, |h: String| {
          clock.sleep(Duration(10));
          log.note[l]("done");
          h
        }));
      clock.sleep(Duration(5));
      assert(task.cancel(t));
      assert_eq(task.await(t), None)
    }
  });
  assert_eq(seen, ["open a", "close a"])
}

fn with_token(tokens: Chan<Unit>) -> Unit / {task.write} =
  bracket(
    || task.recv(tokens),
    |held: Option<Unit>| {
      task.send(tokens, ());
      ()
    },
    |held: Option<Unit>| task.yield(),
  )

test "a cancel takes no result from an acquire, so the token it took goes back, in every interleaving" {
  simulate {
    let tokens = task.channel(1);
    assert(task.send(tokens, ()));
    let holder = task.spawn(|| with_token(tokens));
    task.cancel(holder);
    task.await(holder);
    assert_eq(task.recv(tokens), Some(()))
  }
}

test "a cancel lets go of a wait an acquire stands in, and nothing is released" {
  let seen = noted(|| {
    simulate {
      let never: Chan<String> = task.channel(0);
      let t = task.spawn(||
        bracket(
          || task.recv(never),
          |held: Option<String>| close_logged("a"),
          |held: Option<String>| (),
        ));
      clock.sleep(Duration(1));
      assert(task.cancel(t));
      assert_eq(task.await(t), None)
    }
  });
  assert_eq(seen, [])
}

fn late(name: String) -> Unit / {clock.write, log.write[l]} = {
  clock.sleep(Duration(10));
  log.note[l](name)
}

fn stopped(kids: List<Task<Unit>>) -> Unit / {task.write} = {
  kids.fold((), |u: Unit, kid: Task<Unit>| {
    task.cancel(kid);
    ()
  });
  kids.fold((), |u: Unit, kid: Task<Unit>| {
    task.await(kid);
    ()
  })
}

test "an acquire that spawns is cancelled whole: every task it spawned is there to stop" {
  let seen = noted(|| {
    simulate {
      let parent = task.spawn(||
        bracket(
          || [task.spawn(|| late("a")), task.spawn(|| late("b"))],
          stopped,
          |kids: List<Task<Unit>>| clock.sleep(Duration(100)),
        ));
      task.cancel(parent);
      task.await(parent);
      clock.sleep(Duration(20))
    }
  });
  assert_eq(seen, [])
}

test "a cancel does not stop a release: it lands when the release returns" {
  let seen = noted(|| {
    simulate {
      let gate = task.channel(0);
      let t = task.spawn(||
        bracket(
          || (),
          |u: Unit| {
            task.recv(gate);
            log.note[l]("released")
          },
          |u: Unit| (),
        ));
      clock.sleep(Duration(1));
      assert(task.cancel(t));
      assert(!task.cancel(t));
      log.note[l]("cancelled");
      assert(task.send(gate, 1));
      assert_eq(task.await(t), None)
    }
  });
  assert_eq(seen, ["cancelled", "released"])
}

test "a raise that leaves a task stops every other first, which releases what it holds, then lands at the simulation" {
  let seen = noted(|| {
    let returned = handle {
      simulate {
        task.spawn(||
          bracket(|| open_logged("a"), close_logged, |h: String| {
            clock.sleep(Duration(10));
            log.note[l]("done");
            h
          }));
        task.spawn(|| {
          clock.sleep(Duration(5));
          abort.raise("gone");
          ()
        });
        clock.sleep(Duration(100));
        0
      }
    } with {
      abort.raise(m) -> m.len(),
    };
    assert_eq(returned, 4)
  });
  assert_eq(seen, ["open a", "close a"])
}
