effect gen {
  write give(n: Int) -> Unit
}

type Step = | Done | More(Int, once (Unit) -> Step)

fn steps() -> Step =
  handle {
    gen.give(1);
    gen.give(2);
    Done
  } with {
    gen.give(n) resume k -> More(n, k),
  }

fn second(s: keep Step) -> Int =
  match s { More(_, rest) -> match rest(()) { More(n, later) -> n, Done -> 0 }, Done -> 0 }

test "a once-callable stream value passed as a function parameter can be matched, and the function for the rest of the stream is then called once" {
  assert_eq(second(steps()), 2)
}

test "a once-callable stream value matched where `steps()` returns it can be matched, and the function for the rest of the stream is then called once" {
  let n = match steps() {
    More(_, rest) -> match rest(()) { More(n, later) -> n, Done -> 0 },
    Done -> 0,
  };
  assert_eq(n, 2)
}
