//! A type whose constructor holds a `once` function is a resource, in a module where no type states
//! a `release`: a `match` takes it apart, so the arm owns the function and may call it.

effect gen {
  write give(n: Int) -> Unit
}

type Step = | Done | More(Int, once (Unit) -> Step)

fn steps() -> Step =
  handle {
    gen.give(1);
    gen.give(2);
    Done
  } with {
    gen.give(n) resume k -> More(n, k),
  }

fn second(s: keep Step) -> Int =
  match s { More(_, rest) -> match rest(()) { More(n, later) -> n, Done -> 0 }, Done -> 0 }

test "a step a parameter takes is taken apart, its rest owned by the arm" {
  assert_eq(second(steps()), 2)
}

test "a step matched where it is made is taken apart, its rest owned by the arm" {
  let n = match steps() {
    More(_, rest) -> match rest(()) { More(n, later) -> n, Done -> 0 },
    Done -> 0,
  };
  assert_eq(n, 2)
}
