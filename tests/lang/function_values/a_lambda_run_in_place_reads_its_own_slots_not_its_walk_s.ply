type Definition = { name: Bytes, guard: Option<Int> }

type Item = | ISchema(Definition) | IOther

fn items(n: Int) -> List<Item> =
  range(0, n).map(|i: Int|
    if i % 2 == 0 { IOther }
    else { ISchema({ name: b"s", guard: if i % 4 == 1 { Some(i) } else { None } }) })

fn walk(
  xs: List<Item>,
  f: (List<Bytes>, Item) -> List<Bytes>,
  i: Int,
  accumulator: List<Bytes>,
  n: Option<Int>,
) -> List<Bytes> =
  match xs.at(i) { Some(x) -> walk(xs, f, i + 1, f(accumulator, x), n), None -> accumulator }

fn prefixed_names(prefix: Bytes, xs: List<Item>) -> List<Bytes> =
  walk(
    xs,
    |accumulator: List<Bytes>, item: Item|
      match item {
        ISchema(d) -> {
          let names = accumulator.push(prefix.concat(d.name));
          match d.guard { Some(_) -> names.push(prefix), None -> names }
        },
        _ -> accumulator,
      },
    0,
    [],
    None,
  )

test "a capturing lambda that collects matching names returns the collected names, or none for an empty list" {
  assert_eq(prefixed_names(b"m.", items(4)), [b"m.s", b"m.", b"m.s"]);
  assert_eq(prefixed_names(b"m.", items(40)).len(), 30);
  assert_eq(prefixed_names(b"m.", items(0)), [])
}
