//! A lambda run in place in a program's own walk reads only its own slots: the walk's parameters,
//! an `Option` among them, are numbered from zero as the lambda's are, and none of them decides what
//! one of the lambda's results is held as.

type Definition = { name: Bytes, guard: Option<Int> }

type Item = | ISchema(Definition) | IOther

fn items(n: Int) -> List<Item> =
  range(0, n).map(|i: Int|
    if i % 2 == 0 { IOther }
    else { ISchema({ name: b"s", guard: if i % 4 == 1 { Some(i) } else { None } }) })

/// `n` is the walk's fifth parameter, as the lambda's `kept` is its fifth slot.
fn walk(
  xs: List<Item>,
  f: (List<Bytes>, Item) -> List<Bytes>,
  i: Int,
  acc: List<Bytes>,
  n: Option<Int>,
) -> List<Bytes> = match xs.at(i) { Some(x) -> walk(xs, f, i + 1, f(acc, x), n), None -> acc }

/// Each schema's name under `prefix`, and the prefix again after one with a guard.
fn prefixed_names(prefix: Bytes, xs: List<Item>) -> List<Bytes> =
  walk(
    xs,
    |acc: List<Bytes>, item: Item|
      match item {
        ISchema(d) -> {
          let kept = acc.push(prefix.concat(d.name));
          match d.guard { Some(_) -> kept.push(prefix), None -> kept }
        },
        _ -> acc,
      },
    0,
    [],
    None,
  )

test "a capturing lambda that joins a match returns what it gathered" {
  assert_eq(prefixed_names(b"m.", items(4)), [b"m.s", b"m.", b"m.s"]);
  assert_eq(prefixed_names(b"m.", items(40)).len(), 30);
  assert_eq(prefixed_names(b"m.", items(0)), [])
}
