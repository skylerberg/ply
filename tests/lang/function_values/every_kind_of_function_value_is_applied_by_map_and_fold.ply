type Money = | Cents(Int)
type Chain = | End | Link(Chain, Int)

fn increment(x: Int) -> Int = x + 1

fn add(accumulator: Int, x: Int) -> Int = accumulator + x

fn doubled(n: Int) -> List<Int> = range(0, n).map(|x: Int| x * 2)
fn incremented(n: Int) -> List<Int> = range(0, n).map(increment)
fn rendered(n: Int) -> List<String> = range(0, n).map(Int::to_string)
fn wrapped(n: Int) -> List<Option<Int>> = range(0, n).map(Some)
fn priced(n: Int) -> List<Money> = range(0, n).map(Cents)

fn summed(n: Int) -> Int = range(0, n).fold(0, |accumulator: Int, x: Int| accumulator + x)
fn added(n: Int) -> Int = range(0, n).fold(0, add)
fn largest(n: Int) -> Int = range(0, n).fold(-1, max)
fn linked(n: Int) -> Chain = range(0, n).fold(End, Link)

test "map applies a lambda, a definition, a builtin and a constructor" {
  assert_eq(doubled(3), [0, 2, 4]);
  assert_eq(incremented(3), [1, 2, 3]);
  assert_eq(rendered(3), ["0", "1", "2"]);
  assert_eq(wrapped(3), [Some(0), Some(1), Some(2)]);
  assert_eq(priced(2), [Cents(0), Cents(1)])
}

test "fold steps with a lambda, a definition, a builtin and a constructor" {
  assert_eq(summed(4), 6);
  assert_eq(added(4), 6);
  assert_eq(largest(4), 3);
  assert_eq(linked(3), Link(Link(Link(End, 0), 1), 2))
}

test "a nullary constructor named as a value is the variant itself" {
  assert_eq(linked(0), End);
  assert_eq(match linked(0) { End -> 1, Link(_, _) -> 2 }, 1)
}
