fn total(lo: Int, hi: Int) -> Int = range(lo, hi).fold(0, |s: Int, i: Int| s + i)

fn squares(n: Int) -> List<Int> = range(0, n).map(|i: Int| i * i)

fn odds(lo: Int, hi: Int) -> List<Int> = range(lo, hi).filter(|i: Int| i % 2 != 0)

test "a loop over a range returns the same result as a fold over the list of the range's numbers" {
  assert_eq(total(0, 5), 10);
  assert_eq(total(3, 3), 0);
  assert_eq(total(5, 2), 0);
  assert_eq(total(0 - 2, 2), 0 - 2);
  assert_eq(squares(4), [0, 1, 4, 9]);
  assert_eq(squares(40), range(0, 40).fold([], |out: List<Int>, i: Int| out.push(i * i)));
  assert_eq(odds(2, 9), [3, 5, 7]);
  assert_eq(odds(0 - 3, 1), [0 - 3, 0 - 1])
}
