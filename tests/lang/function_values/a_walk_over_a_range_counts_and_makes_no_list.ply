//! A fold, map or filter over `range(lo, hi)` and a literal lambda counts from `lo` to `hi` in its
//! caller's loop, making no list of the range: a fold allocates nothing however long the range, and
//! a map or a filter only the list it answers.

import std.pace (meter, spent)

fn total(lo: Int, hi: Int) -> Int = range(lo, hi).fold(0, |s: Int, i: Int| s + i)

fn squares(n: Int) -> List<Int> = range(0, n).map(|i: Int| i * i)

fn odds(lo: Int, hi: Int) -> List<Int> = range(lo, hi).filter(|i: Int| i % 2 != 0)

test "a walk over a range answers what one over the range's list does" {
  assert_eq(total(0, 5), 10);
  assert_eq(total(3, 3), 0);
  assert_eq(total(5, 2), 0);
  assert_eq(total(0 - 2, 2), 0 - 2);
  assert_eq(squares(4), [0, 1, 4, 9]);
  assert_eq(squares(40), range(0, 40).fold([], |out: List<Int>, i: Int| out.push(i * i)));
  assert_eq(odds(2, 9), [3, 5, 7]);
  assert_eq(odds(0 - 3, 1), [0 - 3, 0 - 1])
}

test "a fold over a range allocates nothing, and a map only its answer, however long the range" {
  assert_eq(spent(|| total(0, 1000)).allocations, 0);
  // As a map over a list already made allocates its answer and nothing else.
  let xs = range(0, 1000);
  assert_eq(
    spent(|| squares(1000).len()).allocations,
    spent(|| xs.map(|i: Int| i * i).len()).allocations,
  )
}
