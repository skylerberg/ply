effect store {
  read get[table](key: String) -> Int
}

type Accumulator = { total: Int, keys: List<String> }

fn summed<[l]>(keys: List<String>) -> Accumulator / {store.get[l]} =
  keys.fold({ total: 0, keys: [] }, |a: Accumulator, k: String| {
    let read = || store.get[l](k);
    { total: a.total + read(), keys: a.keys.push(k) }
  })

fn bracketed<[l]>(keys: List<String>) -> Accumulator / {store.get[l], abort.raise} =
  keys.fold({ total: 0, keys: [] }, |a: Accumulator, k: String|
    bracket(|| store.get[l](k), |n: Int| (), |n: Int| { total: a.total + n, keys: a.keys.push(k) }))

test "a closure made by a lambda run in place calls the `store.get[users]` handler that was active when the closure was made" {
  let lengths = |go: () -> Accumulator / {store.get[users], abort.raise}|
    handle { go() } with { store.get[*](key) -> key.len() };
  assert_eq(lengths(|| summed[users](["ab", "c"])), { total: 3, keys: ["ab", "c"] });
  assert_eq(lengths(|| bracketed[users](["ab", "c"])), { total: 3, keys: ["ab", "c"] })
}
