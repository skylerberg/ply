fn add(a: Int, x: Int) -> Int = a + x

fn twice(xs: List<Int>) -> Int = xs.fold(0, add) + xs.fold(0, add)

fn and_len(xs: List<Int>) -> Int = xs.fold(0, add) + xs.len()

fn through_a_value(xs: List<Int>, k: Int) -> Int = xs.fold(0, |a: Int, x: Int| a + x * k)

fn mapped(xs: List<Int>, k: Int) -> List<Int> = xs.map(|x: Int| x * k)

fn by_name(xs: List<Int>) -> Int = xs.map(|x: Int| x + 1).fold(0, add)

fn adder(n: Int) -> (Int) -> Int = |x: Int| x + n

fn used_twice(n: Int, x: Int) -> Int = {
  let f = adder(n);
  f(x) + f(x)
}

test "a list survives a fold over it, and a closure survives being called" {
  assert_eq(twice([1, 2, 3]), 12);
  assert_eq(and_len([1, 2, 3]), 9);
  assert_eq(through_a_value([1, 2, 3], 10), 60);
  assert_eq(mapped([1, 2, 3], 3), [3, 6, 9]);
  assert_eq(by_name([1, 2, 3, 4]), 14);
  assert_eq(used_twice(5, 2), 14)
}
