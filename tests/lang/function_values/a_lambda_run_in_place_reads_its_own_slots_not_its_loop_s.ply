//! A lambda run in place in a loop of `std.prelude` reads only its own slots: the loop's own
//! parameters, an `Option` among them, are numbered from zero as the lambda's are, and none of them
//! decides what one of the lambda's answers is held as. A fold over more items than a list's tail
//! holds runs the lambda in its walk of the leaves.

type Definition = { name: Bytes, guard: Option<Int> }

type Item = | IFn(Int) | ISchema(Definition) | IType(Bytes) | IOther

fn items(n: Int) -> List<Item> =
  range(0, n).map(|i: Int|
    if i % 4 == 0 { IFn(i) }
    else if i % 4 == 1 { IType(b"t") }
    else if i % 4 == 2 { IOther }
    else { ISchema({ name: b"s", guard: if i % 8 == 3 { Some(i) } else { None } }) })

fn plain(n: Int) -> List<Item> =
  items(n).filter(|i: Item| match i { ISchema(_) -> false, _ -> true })

/// Each schema's name under `prefix`, and its guard's beside it.
fn named(prefix: Bytes, xs: List<Item>) -> List<Bytes> =
  xs.fold([], |acc: List<Bytes>, item: Item|
    match item {
      ISchema(d) -> {
        let kept = acc.push(prefix.concat(d.name));
        match d.guard { Some(_) -> kept.push(prefix.concat(b"?")), None -> kept }
      },
      _ -> acc,
    })

test "a capturing lambda that joins a match answers its accumulator where nothing matched" {
  let none: List<Bytes> = [];
  assert_eq([10, 32, 33, 300, 2000].map(|n: Int| named(b"m.", plain(n))), [
    none,
    none,
    none,
    none,
    none,
  ])
}

/// Each item's guard past `base`, where it is a schema's that has one: an `Option` the lambda's
/// joins answer, which the walk of a map's leaves holds as one beside its own.
fn guards(base: Int, xs: List<Item>) -> List<Option<Int>> =
  xs.map(|item: Item|
    match item {
      ISchema(d) -> {
        let g = d.guard;
        match g { Some(n) -> Some(n + base), None -> None }
      },
      _ -> None,
    })

test "a capturing lambda that joins options answers them, in the tail and down the trie" {
  let at = |n: Int, base: Int| guards(base, items(n)).filter(|o: Option<Int>| o != None);
  assert_eq(at(8, 100), [Some(103)]);
  assert_eq(at(300, 1000).len(), 38);
  assert_eq(at(300, 1000).at(37), Some(Some(1299)))
}

test "a capturing lambda that joins a match answers what it gathered, in the tail and down the trie" {
  assert_eq(named(b"m.", items(8)), [b"m.s", b"m.?", b"m.s"]);
  assert_eq(named(b"m.", items(300)).len(), 75 + 38);
  assert_eq(named(b"m.", items(300)).filter(|b: Bytes| b == b"m.?").len(), 38)
}
