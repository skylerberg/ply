type Definition = { name: Bytes, guard: Option<Int> }

type Item = | IFn(Int) | ISchema(Definition) | IType(Bytes) | IOther

fn items(n: Int) -> List<Item> =
  range(0, n).map(|i: Int|
    if i % 4 == 0 { IFn(i) }
    else if i % 4 == 1 { IType(b"t") }
    else if i % 4 == 2 { IOther }
    else { ISchema({ name: b"s", guard: if i % 8 == 3 { Some(i) } else { None } }) })

fn plain(n: Int) -> List<Item> =
  items(n).filter(|i: Item| match i { ISchema(_) -> false, _ -> true })

fn named(prefix: Bytes, xs: List<Item>) -> List<Bytes> =
  xs.fold([], |accumulator: List<Bytes>, item: Item|
    match item {
      ISchema(d) -> {
        let names = accumulator.push(prefix.concat(d.name));
        match d.guard { Some(_) -> names.push(prefix.concat(b"?")), None -> names }
      },
      _ -> accumulator,
    })

test "a capturing lambda that collects matches returns an empty list when nothing matches" {
  let none: List<Bytes> = [];
  assert_eq([10, 32, 33, 300, 2000].map(|n: Int| named(b"m.", plain(n))), [
    none,
    none,
    none,
    none,
    none,
  ])
}

fn guards(base: Int, xs: List<Item>) -> List<Option<Int>> =
  xs.map(|item: Item|
    match item {
      ISchema(d) -> {
        let g = d.guard;
        match g { Some(n) -> Some(n + base), None -> None }
      },
      _ -> None,
    })

test "a capturing lambda that collects options returns the `Some` values for short and long lists" {
  let at = |n: Int, base: Int| guards(base, items(n)).filter(|o: Option<Int>| o != None);
  assert_eq(at(8, 100), [Some(103)]);
  assert_eq(at(300, 1000).len(), 38);
  assert_eq(at(300, 1000).at(37), Some(Some(1299)))
}

test "a capturing lambda that collects matching names returns them for short and long lists" {
  assert_eq(named(b"m.", items(8)), [b"m.s", b"m.?", b"m.s"]);
  assert_eq(named(b"m.", items(300)).len(), 75 + 38);
  assert_eq(named(b"m.", items(300)).filter(|b: Bytes| b == b"m.?").len(), 38)
}
