//! A lambda written where a call lends it, at a parameter of a function type not written `keep`,
//! lies on the caller's stack with its entry: no closure is allocated, and it runs wherever the
//! callee calls it, in place, by its type, or from a native.

import std.pace (spent)

/// Hands the function it is lent on to a native's lent parameter.
fn bumped(m: Map<Int, String>, k: Int, f: (String) -> String) -> Map<Int, String> = m.update(k, f)

/// A tail group of two, which no specialisation runs a lambda in.
fn evens(xs: List<Int>, f: (Int) -> Int, i: Int, acc: Int) -> Int =
  match xs.at(i) { Some(x) -> odds(xs, f, i + 1, acc + f(x)), None -> acc }

fn odds(xs: List<Int>, f: (Int) -> Int, i: Int, acc: Int) -> Int =
  match xs.at(i) { Some(x) -> evens(xs, f, i + 1, acc - f(x)), None -> acc }

fn summed(xs: List<Int>, f: (Int) -> Int, i: Int, acc: Int) -> Int =
  match xs.at(i) { Some(x) -> summed(xs, f, i + 1, acc + f(x)), None -> acc }

fn summed_kept(xs: List<Int>, f: keep (Int) -> Int) -> Int = summed(xs, f, 0, 0)

fn raised(m: Map<Int, String>, s: String) -> Map<Int, String> = bumped(m, 1, |v: String| v ++ s)

fn alternating(xs: List<Int>, k: Int) -> Int = evens(xs, |x: Int| x * k, 0, 0)

fn labelled(xs: List<Int>, tag: String) -> List<String> = xs.map(|x: Int| tag ++ x.to_string())

fn lent_sum(xs: List<Int>, k: Int) -> Int = summed(xs, |x: Int| x * k, 0, 0)

fn kept_sum(xs: List<Int>, k: Int) -> Int = summed_kept(xs, |x: Int| x * k)

test "a lent lambda answers what calling it answers, wherever it is called" {
  assert_eq(raised(Map::new().insert(1, "a"), "b").get(1), Some("ab"));
  assert_eq(alternating([1, 2, 3, 4], 3), 0 - 6);
  assert_eq(labelled([1, 2], "n"), ["n1", "n2"]);
  assert_eq(lent_sum([1, 2, 3], 2), kept_sum([1, 2, 3], 2))
}

test "a lent lambda allocates no closure, where a kept one does" {
  let xs = range(0, 100);
  assert_eq(spent(|| lent_sum(xs, 3)).allocations + 1, spent(|| kept_sum(xs, 3)).allocations)
}

test "a lent lambda's captures are given back once the call is done" {
  let m = Map::new().insert(1, "a");
  let tag = "t";
  assert_eq([raised(m, tag).len(), alternating([1, 2, 3], 2), labelled([1, 2], tag).len()], [
    1,
    4,
    2,
  ])
}
