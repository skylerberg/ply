//! A function value a `let` binds to a lambda is known wherever it is read. A call of it runs the
//! lambda's body in place, and a definition it is handed to runs it as it would a literal one. A
//! definition handed on by its name is called directly by the definition it is handed to.

fn apply_repeatedly(n: Int, x: Float, f: (Float) -> Float) -> Float =
  if n <= 0 { x } else { apply_repeatedly(n - 1, f(x), f) }

/// `f` is called where it is bound, and again inside the lambda a `fold` runs.
fn called(n: Int, k: Float) -> Float = {
  let f = |x: Float| x * k + 1.0;
  range(0, n).fold(f(0.5), |acc: Float, _: Int| f(acc))
}

/// `called` with `f`'s body written where `f` is called.
fn fold_inline_lambda(n: Int, k: Float) -> Float =
  range(0, n).fold(0.5 * k + 1.0, |acc: Float, _: Int| acc * k + 1.0)

/// `f` is handed on, under its own name and under another.
fn walked_twice(n: Int, k: Float) -> Float = {
  let f = |x: Float| x * k + 1.0;
  let g = f;
  apply_repeatedly(n, 1.0, f) + apply_repeatedly(n, 1.0, g)
}

/// One lambda calls another it captures.
fn nested(n: Int, k: Float) -> Float = {
  let scale = |x: Float| x * k;
  let step = |x: Float| scale(x) + 1.0;
  apply_repeatedly(n, 1.0, step)
}

/// A later binder of the same name is another lambda, which calls the first.
fn shadowed(x: Float) -> Float = {
  let f = |y: Float| y + 1.0;
  let f = |y: Float| f(y) * 2.0;
  f(x)
}

/// Stored, a lambda is the closure it always was.
fn stored(k: Float) -> List<(Float) -> Float> = {
  let f = |x: Float| x * k;
  [f, f]
}

fn marked(xs: List<String>, suffix: String) -> List<String> = {
  let mark = |s: String| s ++ suffix;
  xs.map(mark).push(mark("end"))
}

/// A lambda that handles what it performs stays a closure.
fn guarded(x: Int) -> Int = {
  let safe = |n: Int|
    handle {
      if n > 2 { abort.raise("big") } else { n }
    } with {
      abort.raise(_) -> 0 - 1,
      return v -> v,
    };
  safe(x) + safe(x + 2)
}

/// What a lambda run in place performs is handled by the handler around its caller.
fn checked(x: Int) -> Int / {abort.raise} = {
  let check = |n: Int| if n > 2 { abort.raise("big") } else { n };
  check(x) + check(x + 2)
}

fn caught(x: Int) -> Result<Int, String> =
  handle { checked(x) } with { abort.raise(m) -> Err(m), return v -> Ok(v) }

/// A call of a lambda is the argument of another call of it: the inner call is the binder's last
/// read, and the outer one reads what the lambda captured after it.
fn wrapped(s: String, mark: String) -> String = {
  let around = |x: String| mark ++ x ++ mark;
  around(around(s))
}

/// The same of a lambda that calls one it captures.
fn wrapped_twice(s: String, mark: String) -> String = {
  let edge = |n: Int| if n > 1 { mark ++ mark } else { mark };
  let around = |x: String| edge(x.len()) ++ x;
  around(around(s))
}

/// The same of a lambda a definition was handed.
fn twice(f: (String) -> String, s: String) -> String = f(f(s))

fn quoted(s: String, mark: String) -> String = twice(|x: String| mark ++ x ++ mark, s)

fn half(x: Float) -> Float = x * 0.5

fn same<a>(x: a) -> a = x

/// A definition handed on by its name is called where the function it is handed to calls it.
fn halved(n: Int) -> Float = apply_repeatedly(n, 1024.0, half)

fn unmoved(n: Int) -> Float = apply_repeatedly(n, 1.5, same)

test "a lambda bound by a let returns what calling its closure returns" {
  assert_eq(called(3, 0.5), 1.90625);
  assert_eq(walked_twice(2, 0.5), 3.5);
  assert_eq(nested(2, 0.5), 1.75);
  assert_eq(shadowed(1.0), 4.0);
  assert_eq(stored(2.0).map(|g: (Float) -> Float| g(1.5)), [3.0, 3.0]);
  assert_eq(marked(["a", "b"], "!"), ["a!", "b!", "end!"]);
  assert_eq(guarded(1), 0);
  assert_eq(guarded(3), 0 - 2);
  assert_eq(caught(0), Ok(2));
  assert_eq(caught(1), Err("big"));
  assert_eq(wrapped("a", "|"), "||a||");
  assert_eq(wrapped_twice("a", "-"), "---a");
  assert_eq(quoted("a", "'"), "''a''");
  assert_eq(halved(3), 128.0);
  assert_eq(unmoved(3), 1.5)
}

test "a lambda run in place returns what its body written out returns" {
  assert_eq(fold_inline_lambda(3, 0.5), called(3, 0.5))
}
