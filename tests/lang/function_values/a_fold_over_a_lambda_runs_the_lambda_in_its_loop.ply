//! A `List::fold` over a literal lambda is a loop in its caller, the lambda's body run in it: a
//! `Float` total is never boxed, and a record the step makes from the accumulator it holds alone
//! takes its cell.

type Tally = { n: Int, total: Float }

fn floats(n: Int) -> List<Float> = range(0, n).map(|i: Int| Float::of_int(i) / 2.0)

fn sum(xs: List<Float>) -> Float = xs.fold(0.0, |acc: Float, x: Float| acc + x)

fn scaled(xs: List<Float>, k: Float) -> Float = xs.fold(0.0, |acc: Float, x: Float| acc + k * x)

fn tally(xs: List<Float>) -> Tally =
  xs.fold({ n: 0, total: 0.0 }, |t: Tally, x: Float| { ..t, n: t.n + 1, total: t.total + x })

fn rebuilt(xs: List<Float>) -> Tally =
  xs.fold({ n: 0, total: 0.0 }, |t: Tally, x: Float| { n: t.n + 1, total: t.total + x })

test "a fold over a lambda answers what the lambda called once per element answers" {
  assert_eq(sum(floats(5)), 5.0);
  assert_eq(scaled(floats(5), 2.0), 10.0);
  assert_eq(tally(floats(5)), { n: 5, total: 5.0 });
  assert_eq(rebuilt(floats(4)), { n: 4, total: 3.0 });
  assert_eq(
    [1, 2, 3, 4].fold([], |kept: List<Int>, x: Int| if x % 2 == 0 { kept.push(x) } else { kept }),
    [2, 4],
  );
  assert_eq(["a", "b"].fold("", |s: String, x: String| s ++ x), "ab");
  assert_eq([].fold(7, |acc: Int, x: Int| acc + x), 7);
  assert_eq(
    handle { [1, 2, 3].fold(0, |acc: Int, x: Int| acc + x) } with { abort.raise(_) -> 0 },
    6,
  )
}
