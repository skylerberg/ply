//! A `List::fold` over a literal lambda is a loop in its caller, the lambda's body run in it: a
//! `Float` total is never boxed, and a record the step makes from the accumulator it holds alone
//! takes its cell, so neither allocates per element. It takes the steps the prelude's fold takes
//! over a function value, the lambda's counted as a call of it would be.

import std.pace (meter, spent)

type Tally = { n: Int, total: Float }

fn floats(n: Int) -> List<Float> = range(0, n).map(|i: Int| Float::of_int(i) / 2.0)

fn sum(xs: List<Float>) -> Float = xs.fold(0.0, |acc: Float, x: Float| acc + x)

fn scaled(xs: List<Float>, k: Float) -> Float = xs.fold(0.0, |acc: Float, x: Float| acc + k * x)

fn tally(xs: List<Float>) -> Tally =
  xs.fold({ n: 0, total: 0.0 }, |t: Tally, x: Float| { ..t, n: t.n + 1, total: t.total + x })

fn rebuilt(xs: List<Float>) -> Tally =
  xs.fold({ n: 0, total: 0.0 }, |t: Tally, x: Float| { n: t.n + 1, total: t.total + x })

/// What `f` allocates over `n` floats, past making them.
fn allocated<a>(n: Int, f: (List<Float>) -> a) -> Int / {meter.read} = {
  let xs = floats(n);
  spent(|| f(xs)).allocations
}

/// The steps `f` takes over `n` floats, past making them.
fn stepped<a>(n: Int, f: (List<Float>) -> a) -> Int / {meter.read} = {
  let xs = floats(n);
  spent(|| f(xs)).steps
}

test "a fold over a lambda answers what the lambda called once per element answers" {
  assert_eq(sum(floats(5)), 5.0);
  assert_eq(scaled(floats(5), 2.0), 10.0);
  assert_eq(tally(floats(5)), { n: 5, total: 5.0 });
  assert_eq(rebuilt(floats(4)), { n: 4, total: 3.0 });
  assert_eq(
    [1, 2, 3, 4].fold([], |kept: List<Int>, x: Int| if x % 2 == 0 { kept.push(x) } else { kept }),
    [2, 4],
  );
  assert_eq(["a", "b"].fold("", |s: String, x: String| s ++ x), "ab");
  assert_eq([].fold(7, |acc: Int, x: Int| acc + x), 7);
  assert_eq(
    handle { [1, 2, 3].fold(0, |acc: Int, x: Int| acc + x) } with { abort.raise(_) -> 0 },
    6,
  )
}

test "a fold over a lambda allocates alike for ten elements and a thousand" {
  assert_eq(allocated(1000, sum), allocated(10, sum));
  assert_eq(
    allocated(1000, |xs: List<Float>| scaled(xs, 3.0)),
    allocated(10, |xs: List<Float>| scaled(xs, 3.0)),
  );
  assert_eq(allocated(1000, tally), allocated(10, tally));
  assert_eq(allocated(1000, rebuilt), allocated(10, rebuilt))
}

fn added(acc: Float, x: Float) -> Float = acc + x

/// Asserts ten more floats cost `f` as many steps from twenty to thirty as from ten to twenty, and
/// some.
fn evenly<a>(f: (List<Float>) -> a) -> Unit / {meter.read, abort.raise} = {
  let first = stepped(20, f) - stepped(10, f);
  assert(first > 0);
  assert_eq(stepped(30, f) - stepped(20, f), first)
}

/// A function value nothing knows the lambda of, which the prelude's fold calls.
fn adders() -> List<(Float, Float) -> Float> = [added]

// How many steps an element takes is how `std.prelude` writes the walk; that every element takes
// as many is the walk's.
test "a fold over a lambda takes as many steps for each element, the lambda's as a call's" {
  evenly(sum);
  evenly(tally);
  assert_eq(stepped(20, sum), stepped(20, |xs: List<Float>| xs.fold(0.0, added)));
  let value = adders().get(0);
  let by_value = |xs: List<Float>| xs.fold(0.0, value);
  [10, 1000].fold((), |_: Unit, n: Int| {
    assert_eq(stepped(n, sum), stepped(n, by_value));
    assert_eq(allocated(n, sum), allocated(n, by_value))
  })
}

test "a fold over a lambda allocates nothing over a list already made, down its trie or in its tail" {
  let xs = floats(1000);
  assert_eq(spent(|| if sum(xs) > 0.0 { 1 } else { 0 }).allocations, 0);
  assert_eq(spent(|| tally(xs).n).allocations, 0);
  assert_eq(spent(|| rebuilt(xs).n).allocations, 0)
}
