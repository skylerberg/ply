import std.bin
import std.option

fn floats(n: Int) -> List<Float> = range(0, n).map(|i: Int| Float::of_int(i) / 2.0)

fn summed(xs: List<Float>, f: (Float) -> Float, i: Int, accumulator: Float) -> Float =
  match xs.at(i) { Some(x) -> summed(xs, f, i + 1, accumulator + f(x)), None -> accumulator }

fn sum_by(xs: List<Float>, f: (Float) -> Float) -> Float = summed(xs, f, 0, 0.0)

fn sum_twice(xs: List<Float>, f: (Float) -> Float) -> Float = sum_by(xs, f) + sum_by(xs, f)

fn twice(f: (Int) -> Int, x: Int) -> Int = f(f(x))

fn applied(f: (Int) -> String, n: Int) -> String = f(n)

fn map_each(xs: List<String>, f: (String) -> String, i: Int, out: List<String>) -> List<String> =
  match xs.at(i) { Some(x) -> map_each(xs, f, i + 1, out.push(f(x))), None -> out }

fn total_of<| e>(xs: List<Int>, f: (Int) -> Int / e, i: Int, accumulator: Int) -> Int / e =
  match xs.at(i) { Some(x) -> total_of(xs, f, i + 1, accumulator + f(x)), None -> accumulator }

type Item = { name: String, n: Int }

type Basket = { items: List<Item>, tags: List<String>, counts: List<Int> }

derive bin for Item
derive bin for Basket

fn doubled_sum(xs: List<Float>) -> Float = sum_by(xs, |x: Float| x * 2.0)

fn scaled_sum(xs: List<Float>, k: Float) -> Float = sum_by(xs, |x: Float| x * k)

fn first_set(xs: List<Int>) -> List<Int> / {abort.raise} = xs.set(0, -1)

fn each_set<| e>(n: Int, xs: List<Int>, f: (List<Int>) -> List<Int> / e) -> List<Int> / e =
  if n <= 0 { xs } else { each_set(n - 1, f(xs), f) }

fn counted_sum(xs: List<Float>, names: List<String>) -> Float =
  sum_by(xs, |x: Float| x + Float::of_int(names.len()))

fn shifted_twice(xs: List<Float>, k: Float) -> Float = sum_twice(xs, |x: Float| x + k)

fn tripled_plus(x: Int) -> Int = twice(|y: Int| y * 3 + 1, x)

fn captured(s: String) -> String = applied(|_n: Int| s, 1)

fn with_suffix(xs: List<String>, s: String) -> List<String> =
  map_each(xs, |x: String| x ++ s, 0, [])

fn exclaimed(xs: List<String>) -> List<String> = map_each(xs, |x: String| x ++ "!", 0, [])

fn doubled_all(xs: List<Int>) -> Option<List<Int>> =
  Option::traverse(xs, |x: Int| if x > 0 { Some(x * 2) } else { None })

fn raised(xs: List<Int>) -> Result<Int, String> =
  handle {
    total_of(xs, |x: Int| if x == 2 { abort.raise("two") } else { x * 10 }, 0, 0)
  } with {
    abort.raise(m) -> Err(m),
    return v -> Ok(v),
  }

fn apply_repeatedly<a>(n: Int, x: a, f: (a) -> a) -> a =
  if n <= 0 { x } else { apply_repeatedly(n - 1, f(x), f) }

fn stepped<a>(n: Int, x: a, by: a) -> a
  where numeric(a)
= apply_repeatedly(n, x, |y: a| y + by)

test "a lambda passed to a higher-order function returns the expected result when that function calls it, with or without captured variables" {
  let names = ["a", "b"];
  assert_eq(doubled_sum(floats(5)), 10.0);
  assert_eq(scaled_sum(floats(5), 3.0), 15.0);
  assert_eq(counted_sum(floats(2), names), 4.5);
  assert_eq(shifted_twice(floats(5), 3.0), 40.0);
  assert_eq(tripled_plus(2), 22);
  assert_eq(captured("kept"), "kept");
  assert_eq(exclaimed(names), ["a!", "b!"]);
  assert_eq(with_suffix(names, "kept"), ["akept", "bkept"]);
  assert_eq(names, ["a", "b"]);
  assert_eq(doubled_all([1, 2]), Some([2, 4]));
  assert_eq(doubled_all([1, 0]), None)
}

test "a binary codec built from several lambdas in one expression decodes what it encodes" {
  let b = { items: [{ name: "a", n: 1 }, { name: "b", n: 2 }], tags: ["x", "y"], counts: [3] };
  assert_eq(bin::decode(bin::encode(b, basket_bin()), basket_bin()), Ok(b))
}

test "effects a lambda performs inside a higher-order function are handled by the handler around the call" {
  assert_eq(raised([1, 3]), Ok(40));
  assert_eq(raised([1, 2, 3]), Err("two"))
}

test "a lambda inside a generic function works at each type the function is called with" {
  assert_eq(stepped(4, 1.0, 0.5), 3.0);
  assert_eq(stepped(3, 1, 2), 7)
}

test "a function passed by name passes its arguments on to the function it calls" {
  assert_eq(each_set(2, [1, 2], first_set), [-1, 2])
}
