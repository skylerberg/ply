type Seen = { x: String, previous: String }

type Tally = { seen: List<Seen>, last: String }

fn tallied(xs: List<String>) -> Tally =
  xs.fold({ seen: [], last: "" }, |t: Tally, x: String|
    { last: x, seen: t.seen.push({ x: x, previous: t.last }) })

fn longs(xs: List<String>, start: Tally) -> Tally =
  xs.fold(start, |t: Tally, x: String|
    if x.len() > 1 { { ..t, seen: t.seen.push({ x: x, previous: "" }) } } else { t })

fn added(t: Tally, x: String) -> Tally = { seen: t.seen, last: t.last ++ x }

fn joined(xs: List<String>) -> Tally =
  xs.fold({ seen: [], last: "" }, |t: Tally, x: String| added(t, x))

fn named(xs: List<String>) -> Tally = xs.fold({ seen: [], last: "" }, added)

fn fold_seen(xs: List<String>) -> Tally =
  xs.fold({ seen: [], last: "" }, |t: Tally, x: String|
    { seen: t.seen.push({ x: x, previous: f"{[t, t].len()}" }), last: x })

type Walk = { at: Int, out: List<Seen> }

fn iterate_seen(xs: List<String>, from: Int) -> List<Seen> / {abort.raise} =
  iterate({ at: from, out: [] }, xs.len() - from + 2, |w: Walk|
    match xs.at(w.at) {
      Some(x) -> if x.len() > 0 {
        Continue({ at: w.at + 1, out: w.out.push({ x: x, previous: "" }) })
      } else { Stop(w.out) },
      None -> Stop(w.out),
    })

test "a fold over a small record returns what each step built" {
  assert_eq(tallied(["a", "b", "c"]), {
    seen: [{ x: "a", previous: "" }, { x: "b", previous: "a" }, { x: "c", previous: "b" }],
    last: "c",
  });
  assert_eq(tallied([]), { seen: [], last: "" });
  let start = { seen: [{ x: "s", previous: "" }], last: "z" };
  assert_eq(longs(["a", "bb", "c", "dd"], start), {
    seen: [{ x: "s", previous: "" }, { x: "bb", previous: "" }, { x: "dd", previous: "" }],
    last: "z",
  });
  assert_eq(longs(["a"], start), start);
  assert_eq(joined(["a", "b"]), { seen: [], last: "ab" });
  assert_eq(named(["a", "b"]), { seen: [], last: "ab" });
  assert_eq(fold_seen(["p", "q"]), {
    seen: [{ x: "p", previous: "2" }, { x: "q", previous: "2" }],
    last: "q",
  });
  assert_eq(iterate_seen(["a", "b", "", "c"], 0), [
    { x: "a", previous: "" },
    { x: "b", previous: "" },
  ]);
  assert_eq(iterate_seen(["a", "b"], 1), [{ x: "b", previous: "" }]);
  assert_eq(iterate_seen(["a"], 1), [])
}
