//! A `fold` over a lambda, or an `iterate` whose every round answers `Stop` or `Continue` itself,
//! whose state is a record that crosses a call as its fields carries the state round its loop as
//! its fields and its word: neither the seed nor any round's answer is made, a state that already
//! is an object is handed on as that object, and every count comes back.

type Seen = { x: String, before: String }

type Tally = { seen: List<Seen>, last: String }

fn tallied(xs: List<String>) -> Tally =
  fold(xs, { seen: [], last: "" }, |t: Tally, x: String|
    { last: x, seen: push(t.seen, { x: x, before: t.last }) })

/// A step answering the state it was handed for a short element, an update for a long one.
fn longs(xs: List<String>, start: Tally) -> Tally =
  fold(xs, start, |t: Tally, x: String|
    if string_len(x) > 1 { { ..t, seen: push(t.seen, { x: x, before: "" }) } } else { t })

fn added(t: Tally, x: String) -> Tally = { seen: t.seen, last: t.last ++ x }

/// A step answering what a call answers, and a named step.
fn joined(xs: List<String>) -> Tally =
  fold(xs, { seen: [], last: "" }, |t: Tally, x: String| added(t, x))

fn named(xs: List<String>) -> Tally = fold(xs, { seen: [], last: "" }, added)

/// A step asking for the state's word.
fn kept(xs: List<String>) -> Tally =
  fold(xs, { seen: [], last: "" }, |t: Tally, x: String|
    { seen: push(t.seen, { x: x, before: f"{len([t, t])}" }), last: x })

fn texts(n: Int) -> List<String> = map(range(0, n), |i: Int| f"{i}")

type Walk = { at: Int, out: List<Seen> }

/// The elements from `from` on up to the first empty one, a round each.
fn walked(xs: List<String>, from: Int) -> List<Seen> / {abort.raise} =
  iterate({ at: from, out: [] }, len(xs) - from + 2, |w: Walk|
    match list_at(xs, w.at) {
      Some(x) -> if string_len(x) > 0 {
        Continue({ at: w.at + 1, out: push(w.out, { x: x, before: "" }) })
      } else { Stop(w.out) },
      None -> Stop(w.out),
    })

/// A walk of no rounds from the end of `xs`, `n` times over.
fn walks(xs: List<String>, n: Int) -> Int / {abort.raise} =
  fold(range(0, n), 0, |acc: Int, _: Int| acc + len(walked(xs, len(xs))))

/// A fold over the empty `xs`, `n` times over.
fn tallies(xs: List<String>, n: Int) -> Int =
  fold(range(0, n), 0, |acc: Int, _: Int| acc + len(tallied(xs).seen))

/// What a loop of no rounds answers, `n` times over.
fn empties(n: Int) -> Int = fold(range(0, n), 0, |acc: Int, i: Int| acc + len(empty_at(i)))

fn empty_at(i: Int) -> List<Seen> = if i < 0 { [{ x: "", before: "" }] } else { [] }

test "a fold over a small record answers what each step built" {
  assert_eq(tallied(["a", "b", "c"]), {
    seen: [{ x: "a", before: "" }, { x: "b", before: "a" }, { x: "c", before: "b" }],
    last: "c",
  });
  assert_eq(tallied([]), { seen: [], last: "" });
  let start = { seen: [{ x: "s", before: "" }], last: "z" };
  assert_eq(longs(["a", "bb", "c", "dd"], start), {
    seen: [{ x: "s", before: "" }, { x: "bb", before: "" }, { x: "dd", before: "" }],
    last: "z",
  });
  assert_eq(longs(["a"], start), start);
  assert_eq(joined(["a", "b"]), { seen: [], last: "ab" });
  assert_eq(named(["a", "b"]), { seen: [], last: "ab" });
  assert_eq(kept(["p", "q"]), {
    seen: [{ x: "p", before: "2" }, { x: "q", before: "2" }],
    last: "q",
  });
  assert_eq(walked(["a", "b", "", "c"], 0), [{ x: "a", before: "" }, { x: "b", before: "" }]);
  assert_eq(walked(["a", "b"], 1), [{ x: "b", before: "" }]);
  assert_eq(walked(["a"], 1), [])
}

test "a loop over a small record never makes its seed" {
  let xs = texts(3);
  let alone = |n: Int| metered(|| empties(n)).allocations;
  let walking = |n: Int| metered(|| walks(xs, n)).allocations;
  let none = [];
  let folding = |n: Int| metered(|| tallies(none, n)).allocations;
  assert(
    walking(100) - walking(10) <= alone(100) - alone(10),
    Some(
      f"iterate: {walking(10)} then {walking(100)} objects, {alone(10)} then {alone(100)} past the seeds",
    ),
  );
  assert(
    folding(100) - folding(10) <= alone(100) - alone(10),
    Some(
      f"fold: {folding(10)} then {folding(100)} objects, {alone(10)} then {alone(100)} past the seeds",
    ),
  )
}

test "a loop over a small record gives back every count it took" {
  let xs = texts(20);
  let start = { seen: [{ x: "s", before: "" }], last: "z" };
  assert_eq(metered(|| len(tallied(xs).seen)).live, 0);
  assert_eq(metered(|| len(longs(xs, start).seen)).live, 0);
  assert_eq(metered(|| string_len(joined(xs).last)).live, 0);
  assert_eq(metered(|| string_len(named(xs).last)).live, 0);
  assert_eq(metered(|| len(kept(xs).seen)).live, 0);
  assert_eq(metered(|| len(walked(xs, 0))).live, 0);
  assert_eq(metered(|| walks(xs, 5)).live, 0)
}
