//! A function value whose type is known where it is called is called by that type: a `Float`, an
//! `Int` too wide for a word and an `Option` cross the call as themselves. A closure made where its
//! type was not known is called as it always was, and answers the same.

type Ops = {
  step: (Float) -> Float,
  pick: (Int) -> Option<Int>,
  wide: (Int) -> Int,
  label: (Int, String) -> String,
}

fn ops(k: Float, suffix: String) -> Ops =
  {
    step: |x: Float| x * k + 1.0,
    pick: |n: Int| if n % 2 == 0 { Some(n) } else { None },
    wide: |n: Int| n + 1,
    label: |n: Int, s: String| f"{s}{n}{suffix}",
  }

fn stepped(o: Ops, n: Int, x: Float) -> Float =
  if n <= 0 { x } else { stepped(o, n - 1, (o.step)(x)) }

fn picked(o: Ops, n: Int, acc: Int) -> Int =
  if n <= 0 { acc } else { picked(o, n - 1, acc + (match (o.pick)(n) { Some(v) -> v, None -> 0 })) }

fn widened(o: Ops, n: Int, x: Int) -> Int = if n <= 0 { x } else { widened(o, n - 1, (o.wide)(x)) }

fn wide() -> Int = 9000000000000000000

/// A closure made where `a` is not known, called where it is.
fn doubling<a>(f: keep (a) -> a) -> (a) -> a = |x: a| f(f(x))

fn doubled(x: Float) -> Float = doubling(|y: Float| y + 0.5)(x)

fn doubled_int(x: Int) -> Int = doubling(|y: Int| y * 3)(x)

/// A closure holding a `String`, called twice by the one closure that holds it.
fn suffixed_twice(x: String, suffix: String) -> String = doubling(|y: String| y ++ suffix)(x)

/// A function a definition answers, called where it is answered.
fn adder(by: Float) -> (Float) -> Float = |x: Float| x + by

fn added(n: Int, x: Float) -> Float = if n <= 0 { x } else { added(n - 1, adder(0.5)(x)) }

/// What the runtime makes is called as it always was: a clause's continuation, a builtin's value.
effect choice {
  read flip() -> Bool
}

fn off_tail() -> Int =
  handle {
    if choice.flip() { 1 } else { 10 }
  } with {
    choice.flip() resume k -> {
      let v = k(true);
      v + 10
    },
  }

fn measured(f: (String) -> Int, s: String) -> Int = f(s)

test "a function value called by its type answers what it always did" {
  let o = ops(0.5, "!");
  assert_eq(stepped(o, 3, 1.0), 1.875);
  assert_eq(picked(o, 4, 0), 6);
  assert_eq(widened(o, 3, wide()), wide() + 3);
  assert_eq((o.label)(7, "n"), "n7!");
  assert_eq(doubled(1.0), 2.0);
  assert_eq(doubled_int(2), 18);
  assert_eq(added(4, 1.0), 3.0);
  assert_eq(off_tail(), 11);
  assert_eq(measured(String::len, "four"), 4)
}

test "a function value called by its type gives back every count it took" {
  let o = ops(0.5, "!");
  let name = "n";
  assert_eq(picked(o, 10, 0) + String::len((o.label)(7, name)), 33);
  assert(doubled(1.0) > 0.0 && added(10, 1.0) > 0.0)
}

test "a closure held alone and called again has what it captured at each call" {
  let suffix = "!?";
  assert_eq(suffixed_twice("a", suffix), "a!?!?")
}
