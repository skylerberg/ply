fn add(a: Int, b: Int) -> Int = a + b

fn increment(x: Int) -> Int = x + 1

fn sum_to(n: Int) -> Int = range(0, n).fold(0, |accumulator, x| accumulator + x)

fn keyed_sum(n: Int) -> Int =
  range(0, n).fold(Map::new(), |m, i| m.insert(n - i, i)).fold(0, |accumulator, k, v|
    accumulator * 10 + k + v)

fn scaled_sum(n: Int, k: Int) -> Int = range(0, n).map(|x| x * k).fold(0, |a, b| a + b)

fn even_count(n: Int) -> Int = range(0, n).filter(|x| x % 2 == 0).len()

fn countdown(n: Int) -> Int / {abort.raise} =
  iterate(n, 1000, |s| if s <= 0 { Stop(s) } else { Continue(s - 1) })

fn stopped(n: Int) -> Int / {abort.raise} = iterate(n, 3, |s| Continue(s + 1))

fn twice(f: (Int) -> Int, x: Int) -> Int = f(f(x))

fn plus_two(x: Int) -> Int = twice(increment, x)

fn tripled(x: Int) -> Int = {
  let g = |y| y * 3;
  g(x)
}

fn nested(k: Int, n: Int) -> Int =
  range(0, n).fold(0, |accumulator, x| accumulator + [x, k].fold(0, |a, b| a + b))

fn bits(n: Int) -> Int = (n << 2 | n >> 1) ^ n & 3

fn bad_shift(n: Int) -> Int = 1 << n

fn flipped(n: Int) -> Int = ~n

fn wrapped_count(n: Int) -> Int = range(0, n).map(Some).len()

fn named_count(n: Int) -> Int = range(0, n).map(Int::to_string).len()

fn adder(k: Int) -> (Int) -> Int = |x| x + k

fn added(k: Int, x: Int) -> Int = adder(k)(x)

fn stepped(n: Int) -> Int = range(0, n).fold(0, add)

type Accumulator = { total: Int, count: Int }

fn bump(a: Accumulator, x: Int) -> Accumulator = { ..a, total: a.total + x, count: a.count + 1 }

fn totals(n: Int) -> Int = {
  let a = range(0, n).fold({ total: 0, count: 0 }, bump);
  a.total + a.count
}

fn iterated_total(n: Int, k: Int) -> Int / {abort.raise} =
  iterate({ total: 0, count: 0 }, n + 1, |a: Accumulator|
    if a.count >= n { Stop(a.total) }
    else { Continue({ ..a, total: a.total + k, count: a.count + 1 }) })

fn listed_sum(n: Int) -> Int = range(0, n).map(increment).fold(0, add)

fn odd_count(n: Int) -> Int = range(0, n).map(increment).filter(|x: Int| x % 2 == 1).len()

fn longer(n: Int) -> Int =
  range(0, n).map(increment).fold(0, |accumulator: Int, x: Int| accumulator + x * 2)

test "functions that use closures, callbacks and loops return the expected totals and counts, such as `sum_to(10)` returning 45" {
  assert_eq(sum_to(10), 45);
  assert_eq(scaled_sum(4, 3), 18);
  assert_eq(even_count(7), 4);
  assert_eq(keyed_sum(3), 333);
  assert_eq(countdown(5), 0);
  assert_eq(plus_two(5), 7);
  assert_eq(tripled(4), 12);
  assert_eq(nested(10, 3), 33);
  assert_eq(bits(5), 23);
  assert_eq(flipped(5), 0 - 6);
  assert_eq(wrapped_count(3), 3);
  assert_eq(named_count(3), 3);
  assert_eq(added(10, 5), 15);
  assert_eq(stepped(10), 45);
  assert_eq(totals(4), 10);
  assert_eq(listed_sum(10), 55);
  assert_eq(odd_count(5), 3);
  assert_eq(longer(100), 10100);
  assert_eq(iterated_total(5, 3), 15)
}

fn caught<a>(f: () -> a / {abort.raise}) -> Result<a, String> =
  handle { f() } with { abort.raise(m) -> Err(m), return v -> Ok(v) }

fn error_contains(r: Result<Int, String>, what: String) -> Bool =
  match r { Err(m) -> m.contains(what), Ok(_) -> false }

test "a loop that runs past its limit of 3 iterations raises an error, and `bad_shift(3)` returns 8" {
  assert(error_contains(caught(|| stopped(0)), "did not stop within its budget of 3"));
  assert_eq(bad_shift(3), 8)
}
