fn bumped(m: Map<Int, String>, k: Int, f: (String) -> String) -> Map<Int, String> = m.update(k, f)

fn evens(xs: List<Int>, f: (Int) -> Int, i: Int, accumulator: Int) -> Int =
  match xs.at(i) { Some(x) -> odds(xs, f, i + 1, accumulator + f(x)), None -> accumulator }

fn odds(xs: List<Int>, f: (Int) -> Int, i: Int, accumulator: Int) -> Int =
  match xs.at(i) { Some(x) -> evens(xs, f, i + 1, accumulator - f(x)), None -> accumulator }

fn summed(xs: List<Int>, f: (Int) -> Int, i: Int, accumulator: Int) -> Int =
  match xs.at(i) { Some(x) -> summed(xs, f, i + 1, accumulator + f(x)), None -> accumulator }

fn summed_keep_parameter(xs: List<Int>, f: keep (Int) -> Int) -> Int = summed(xs, f, 0, 0)

fn raised(m: Map<Int, String>, s: String) -> Map<Int, String> = bumped(m, 1, |v: String| v ++ s)

fn alternating(xs: List<Int>, k: Int) -> Int = evens(xs, |x: Int| x * k, 0, 0)

fn labelled(xs: List<Int>, tag: String) -> List<String> = xs.map(|x: Int| tag ++ x.to_string())

fn borrowed_sum(xs: List<Int>, k: Int) -> Int = summed(xs, |x: Int| x * k, 0, 0)

fn scaled_sum(xs: List<Int>, k: Int) -> Int = summed_keep_parameter(xs, |x: Int| x * k)

test "a lambda that a function borrows from its caller returns the right result at every call site" {
  assert_eq(raised(Map::new().insert(1, "a"), "b").get(1), Some("ab"));
  assert_eq(alternating([1, 2, 3, 4], 3), 0 - 6);
  assert_eq(labelled([1, 2], "n"), ["n1", "n2"]);
  assert_eq(borrowed_sum([1, 2, 3], 2), scaled_sum([1, 2, 3], 2))
}

test "a borrowed lambda's captures are given back once the call is done" {
  let m = Map::new().insert(1, "a");
  let tag = "t";
  assert_eq([raised(m, tag).len(), alternating([1, 2, 3], 2), labelled([1, 2], tag).len()], [
    1,
    4,
    2,
  ])
}
