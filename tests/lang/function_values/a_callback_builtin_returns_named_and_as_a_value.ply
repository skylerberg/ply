fn add(a: Int, b: Int) -> Int = a + b

fn increment(x: Int) -> Int = x + 1

fn space(c: Int) -> Bool = c == 32

fn updated(n: Int) -> Int = {
  let m = Map::new().insert(1, n);
  let twice = m.update(1, |v: Int| v + 10).update(1, |v: Int| v * 2);
  let absent = twice.update(2, |v: Int| v + 1000);
  match absent.get(1) { Some(v) -> v * 10 + absent.len(), None -> 0 - 1 }
}

fn updated_beside(n: Int) -> Int = {
  let m = Map::new().insert(1, n);
  let u = m.update(1, |v: Int| v + 1);
  match m.get(1) {
    Some(a) -> match u.get(1) { Some(b) -> a * 100 + b, None -> 0 - 2 },
    None -> 0 - 1,
  }
}

fn updated_by_decimal(n: Int) -> Int = {
  let k = Decimal::of_int(1);
  let m = Map::new().insert(k, n).update(k, |v: Int| v + 10);
  match m.get(k) { Some(v) -> v, None -> 0 - 1 }
}

fn space_from(b: Bytes, from: Int) -> Int / {abort.raise} =
  match b.position(from, space) { Some(i) -> i, None -> 0 - 1 }

fn position_by(
  f: (Bytes, Int, (Int) -> Bool) -> Option<Int> / {abort.raise},
  b: Bytes,
) -> Int / {abort.raise} = match f(b, 0, space) { Some(i) -> i, None -> 0 - 1 }

fn first_space(b: Bytes) -> Int / {abort.raise} = position_by(Bytes::position, b)

fn mapped(n: Int) -> Int = {
  let by = |f: (List<Int>, (Int) -> Int) -> List<Int>| f(range(0, n), increment);
  by(List::map).fold(0, add)
}

fn even_count(n: Int) -> Int = {
  let by = |f: (List<Int>, (Int) -> Bool) -> List<Int>| f(range(0, n), |x: Int| x % 2 == 0);
  by(List::filter).len()
}

fn folded(n: Int) -> Int = {
  let by = |f: (List<Int>, Int, (Int, Int) -> Int) -> Int| f(range(0, n), 0, add);
  by(List::fold)
}

fn iterated(n: Int) -> Int / {abort.raise} = {
  let by = |f: (Int, Int, (Int) -> Iter<Int, Int>) -> Int / {abort.raise}|
    f(n, 1000, |s: Int| if s <= 0 { Stop(s - 100) } else { Continue(s - 1) });
  by(iterate)
}

fn map_folded(n: Int) -> Int = {
  let by = |f: (Map<Int, Int>, Int, (Int, Int, Int) -> Int) -> Int|
    f(Map::new().insert(2, n).insert(1, 3), 0, |accumulator: Int, k: Int, v: Int|
      accumulator * 10 + k + v);
  by(Map::fold)
}

fn updated_by(n: Int) -> Int = {
  let by = |f: (Map<Int, Int>, Int, (Int) -> Int) -> Map<Int, Int>|
    f(Map::new().insert(1, n), 1, increment);
  match by(Map::update).get(1) { Some(v) -> v, None -> 0 - 1 }
}

fn caught<a>(f: () -> a / {abort.raise}) -> Result<a, String> =
  handle { f() } with { abort.raise(m) -> Err(m), return v -> Ok(v) }

test "a builtin that calls back into the program returns whether it is named or passed as a value" {
  assert_eq(updated(5), 301);
  assert_eq(updated_beside(5), 506);
  assert_eq(updated_by_decimal(5), 15);
  assert_eq(space_from(b"ab cd ef", 0), 2);
  assert_eq(space_from(b"ab cd ef", 3), 5);
  assert_eq(space_from(b"ab cd ef", 6), 0 - 1);
  assert_eq(space_from(b"ab cd ef", 8), 0 - 1);
  assert_eq(first_space(b"ab cd ef"), 2);
  assert_eq(first_space(b"abcd"), 0 - 1);
  assert_eq(mapped(4), 10);
  assert_eq(even_count(7), 4);
  assert_eq(folded(10), 45);
  assert_eq(iterated(5), 0 - 100);
  assert_eq(map_folded(4), 46);
  assert_eq(updated_by(5), 6);
  assert_eq(
    caught(|| space_from(b"ab cd ef", 9)),
    Err("`Bytes::position` start 9 is outside a value of 8 bytes"),
  )
}
