//! A `List::map` or `List::filter` over a literal lambda of one parameter runs the lambda's body in its loop,
//! building its answer on a list it holds alone, made with room for what it may hold: no closure is
//! made, a capture is read where it stands, and each pass takes as many steps as the last, the
//! lambda's counted as a call of it would be.

type Point = { x: Float, y: Float }

fn halves(n: Int) -> List<Float> = range(0, n).map(|i: Int| Float::of_int(i) / 2.0)

fn shifted(ps: List<Point>, dx: Float) -> List<Point> = ps.map(|p: Point| { ..p, x: p.x + dx })

fn named(xs: List<Int>, tag: String) -> List<String> = xs.map(|x: Int| f"{tag}{x}")

fn evens(xs: List<Int>) -> List<Int> = xs.filter(|x: Int| x % 2 == 0)

fn longer(xs: List<String>, n: Int) -> List<String> = xs.filter(|s: String| s.len() > n)

fn some_of(xs: List<Option<Int>>) -> List<Option<Int>> = xs.filter(|o: Option<Int>| o != None)

/// A `List::filter` whose body hands its element on at its last use.
fn kept(xs: List<String>) -> List<String> = xs.filter(|s: String| String::len(s ++ "!") > 2)

fn nested(xss: List<List<Int>>) -> List<List<Int>> =
  xss.map(|xs: List<Int>| xs.map(|x: Int| x * 10))

/// The steps `f` takes over `n` integers, past making them.
fn stepped<a>(n: Int, f: (List<Int>) -> a) -> Int = {
  let xs = range(0, n);
  metered(|| f(xs)).steps
}

test "a map or filter over a lambda answers what the lambda called once per element answers" {
  assert_eq(halves(4), [0.0, 0.5, 1.0, 1.5]);
  assert_eq(shifted([{ x: 1.0, y: 2.0 }], 0.5), [{ x: 1.5, y: 2.0 }]);
  assert_eq(named([1, 2], "n"), ["n1", "n2"]);
  assert_eq(evens([1, 2, 3, 4]), [2, 4]);
  assert_eq(longer(["a", "bcd", "ef"], 1), ["bcd", "ef"]);
  assert_eq(some_of([Some(1), None, Some(3)]), [Some(1), Some(3)]);
  assert_eq(kept(["a", "bc", "def"]), ["bc", "def"]);
  assert_eq(nested([[1], [2, 3]]), [[10], [20, 30]]);
  assert_eq([].map(|x: Int| x + 1), []);
  assert_eq([].filter(|x: Int| x > 1), []);
  assert_eq(handle { [1, 2, 0].map(|x: Int| 6 / x) } with { abort.raise(_) -> [] }, [])
}

test "a map or filter over a lambda makes its answer list and nothing else" {
  let k = 3;
  let short = range(0, 10);
  let long = range(0, 20);
  // Twice the items cost no more, nor does a lambda that captures, so nothing is made per item.
  let mapped = |xs: List<Int>| metered(|| xs.map(|x: Int| x + k).len()).allocations;
  let kept = |xs: List<Int>| metered(|| xs.filter(|x: Int| x > k).len()).allocations;
  assert_eq(mapped(long), mapped(short));
  assert_eq(mapped(short), metered(|| short.map(|x: Int| x + 3).len()).allocations);
  assert_eq(kept(long), kept(short));
  assert_eq(kept(short), metered(|| short.filter(|x: Int| x > 3).len()).allocations)
}

fn plus_one(x: Int) -> Int = x + 1

fn even(x: Int) -> Bool = x % 2 == 0

/// Asserts ten more integers cost `f` as many steps from twenty to thirty as from ten to twenty,
/// and some.
fn evenly<a>(f: (List<Int>) -> a) -> Unit / {abort.raise} = {
  let first = stepped(20, f) - stepped(10, f);
  assert(first > 0);
  assert_eq(stepped(30, f) - stepped(20, f), first)
}

// How many steps an element takes is how `std.prelude` writes the walk; that every element takes
// as many is the walk's.
test "a map or filter over a lambda takes as many steps for each element, the lambda's as a call's" {
  evenly(|xs: List<Int>| xs.map(|x: Int| x + 1));
  // Five of each ten more are even, and pushed.
  evenly(evens);
  assert_eq(
    stepped(20, |xs: List<Int>| xs.map(|x: Int| x + 1)),
    stepped(20, |xs: List<Int>| xs.map(plus_one)),
  );
  assert_eq(stepped(20, evens), stepped(20, |xs: List<Int>| xs.filter(even)))
}

test "a map or filter over a lambda gives back every count it took" {
  assert_eq(metered(|| named([1, 2, 3], "n").len()).live, 0);
  assert_eq(metered(|| longer(["a", "bcd"], 1).len()).live, 0);
  assert_eq(metered(|| kept(["a", "bc", "def"]).len()).live, 0);
  assert_eq(metered(|| nested([[1], [2, 3]]).len()).live, 0);
  assert_eq(metered(|| some_of([Some(1), None]).len()).live, 0)
}
