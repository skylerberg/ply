//! A test's own lambda, handed to a generic definition, runs in place where the definition calls
//! it, as a definition's lambda does: in a test, in a case of one, and in a lambda the test writes.

fn twice<a>(x: a, f: (a) -> a) -> a = f(f(x))

fn count_where<a>(xs: List<a>, keep: (a) -> Bool) -> Int =
  xs.fold(0, |n: Int, x: a| if keep(x) { n + 1 } else { n })

test "a test's lambda runs in place" {
  let n = 3;
  assert_eq(twice(1, |x: Int| x + n), 7);
  assert_eq(count_where([1, 5, 2, 8], |x: Int| x > n), 2);
  assert_eq((|| twice(1, |x: Int| x + n))(), 7)
}

test "a case's lambda runs in place at {k}" for k: Int in [2, 4] {
  assert_eq(twice(k, |x: Int| x * k), k * k * k);
  assert_eq(count_where([1, 2, 3, 4, 5], |x: Int| x > k), 5 - k)
}
