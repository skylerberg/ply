effect noted {
  write note(n: Int) -> Unit
}

fn noting(n: Int) -> Int / {noted.note} = {
  noted.note(n);
  n * 2
}

fn spread<| e>(xs: List<Int>, ys: List<Int>, f: (Int) -> Int / e) -> List<Int> / e = {
  let a = xs.map(f);
  let b = ys.fold(a, |accumulator: List<Int>, y: Int| accumulator.push(f(y)));
  b.push(f(0))
}

fn notes_of(run: () -> List<Int> / {noted.note}) -> { notes: List<Int>, result: List<Int> } =
  handle {
    run()
  } with {
    var notes = [],
    noted.note(n) -> {
      notes = notes.push(n);
    },
    return result -> { notes: notes, result: result },
  }

test "a function passed by name and called at several places performs its effects in the handler of the code that passed it" {
  assert_eq(notes_of(|| spread([1, 2], [3], noting)), { notes: [1, 2, 3, 0], result: [2, 4, 6, 0] })
}

test "a lambda called at several places performs its effects in the handler of the code that passed it" {
  assert_eq(
    notes_of(||
      spread([1], [2, 3], |n: Int| {
        noted.note(n + 10);
        n
      })),
    { notes: [11, 12, 13, 10], result: [1, 2, 3, 0] },
  )
}
