type Point = { x: Int, y: Float }

type Named = { name: String, at: Int }

type Moves = { step: (Point) -> Point, tag: (Named, Int) -> Named }

fn moves(dx: Int, dy: Float, suffix: String) -> Moves =
  {
    step: |p: Point| { x: p.x + dx, y: p.y + dy },
    tag: |n: Named, by: Int| { name: n.name ++ suffix, at: n.at + by },
  }

fn walked(m: Moves, n: Int, p: Point) -> Point =
  if n <= 0 { p } else {
    let q = (m.step)(p);
    if q.x > p.x { walked(m, n - 1, q) } else { p }
  }

fn tagged(m: Moves, n: Int, t: Named) -> Named =
  if n <= 0 { t } else { tagged(m, n - 1, (m.tag)(t, 2)) }

fn twice<a>(f: keep (a) -> a) -> (a) -> a = |x: a| f(f(x))

fn doubled(p: Point) -> Point = twice(|q: Point| { x: q.x * 2, y: q.y * 2.0 })(p)

fn sum(p: Point) -> Int = if p.y > 0.0 { p.x } else { 0 - p.x }

test "a record passed to and returned from a function value has the expected field values" {
  let m = moves(2, 0.5, "!");
  assert_eq(walked(m, 3, { x: 1, y: 1.0 }), { x: 7, y: 2.5 });
  assert_eq(tagged(m, 2, { name: "n", at: 0 }), { name: "n!!", at: 4 });
  assert_eq(doubled({ x: 3, y: 1.5 }), { x: 12, y: 6.0 })
}

test "records passed to and returned from function values keep their field values, so `tagged`, `doubled` and `walked` give 6, 12 and 11" {
  let m = moves(2, 0.5, "!");
  let t = { name: "n", at: 0 };
  assert_eq(
    [tagged(m, 3, t).at, sum(doubled({ x: 3, y: 1.5 })), sum(walked(m, 5, { x: 1, y: 1.0 }))],
    [6, 12, 11],
  )
}
