//! A small record crosses a call of a function value whose type is known as its fields, as it
//! crosses a call of a definition: an argument is never made an object to be handed over, and an
//! answer comes back as the fields it was built of. A closure made where its type was not known
//! takes and answers words, and a call by type falls back to it unchanged.

type Point = { x: Int, y: Float }

type Named = { name: String, at: Int }

type Moves = { step: (Point) -> Point, tag: (Named, Int) -> Named }

fn moves(dx: Int, dy: Float, suffix: String) -> Moves =
  {
    step: |p: Point| { x: p.x + dx, y: p.y + dy },
    tag: |n: Named, by: Int| { name: n.name ++ suffix, at: n.at + by },
  }

/// `p` is read after the call, so its cells are never the step's to reuse.
fn walked(m: Moves, n: Int, p: Point) -> Point =
  if n <= 0 { p } else {
    let q = (m.step)(p);
    if q.x > p.x { walked(m, n - 1, q) } else { p }
  }

fn tagged(m: Moves, n: Int, t: Named) -> Named =
  if n <= 0 { t } else { tagged(m, n - 1, (m.tag)(t, 2)) }

/// A closure made where `a` is not known, called where it is.
fn twice<a>(f: keep (a) -> a) -> (a) -> a = |x: a| f(f(x))

fn doubled(p: Point) -> Point = twice(|q: Point| { x: q.x * 2, y: q.y * 2.0 })(p)

fn sum(p: Point) -> Int = if p.y > 0.0 { p.x } else { 0 - p.x }

test "a record crossing a function value's call answers what it always did" {
  let m = moves(2, 0.5, "!");
  assert_eq(walked(m, 3, { x: 1, y: 1.0 }), { x: 7, y: 2.5 });
  assert_eq(tagged(m, 2, { name: "n", at: 0 }), { name: "n!!", at: 4 });
  assert_eq(doubled({ x: 3, y: 1.5 }), { x: 12, y: 6.0 })
}

test "a record crossing a function value's call is never made an object" {
  let m = moves(2, 0.5, "!");
  let start = { x: 1, y: 1.0 };
  assert_eq(
    metered(|| sum(walked(m, 1000, start))).allocations,
    metered(|| sum(walked(m, 10, start))).allocations,
  )
}

test "a record crossing a function value's call gives back every count it took" {
  let m = moves(2, 0.5, "!");
  let t = { name: "n", at: 0 };
  assert_eq(metered(|| tagged(m, 3, t).at).live, 0);
  assert_eq(metered(|| sum(doubled({ x: 3, y: 1.5 }))).live, 0);
  assert_eq(metered(|| sum(walked(m, 5, { x: 1, y: 1.0 }))).live, 0)
}
