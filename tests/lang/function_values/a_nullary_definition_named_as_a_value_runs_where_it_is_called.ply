//! Naming a definition with no parameters names the function rather than calling it: its body runs
//! each time the receiver calls it, under the handlers around that call.

effect tally {
  write bump[r]() -> Int
}

fn counted() -> Int / {tally.bump[ticks]} = tally.bump[ticks]()

fn seven() -> Int = 7

fn twice(f: () -> Int) -> Int = f() + f()

fn under_count(f: () -> Int / {tally.bump[ticks]}) -> Int =
  with_cell[calls](0) { n ->
    handle {
      f() + f()
    } with {
      tally.bump[ticks]() -> {
        cell_set(n, cell_get(n) + 1);
        cell_get(n)
      },
    }
  }

test "a pure nullary definition named as a value is a function its receiver calls" {
  assert_eq(twice(seven), 14)
}

test "an effectful one performs under the handlers where it is called, once a call" {
  assert_eq(under_count(counted), 3)
}
