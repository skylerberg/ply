// A body that performs `task` outside any `simulate` runs under the run's scheduler. A task there
// retires as it finishes unheld and its id is never reused, so no join lands on another task's
// return; a handle kept can be joined again and again; and a handle inside a finished task's return
// keeps its task joinable.

fn churn(n: Int) -> Int / {task.write, abort.raise} =
  range(0, n).fold(0, |sum: Int, i: Int| {
    task.spawn(|| i);
    let t = task.spawn(|| i * 2);
    task.yield();
    sum + task.join(t)
  })

fn kept(n: Int) -> Int / {task.write, abort.raise} = {
  let held = range(0, n).fold([], |tasks: List<Task<Int>>, i: Int| tasks.push(task.spawn(|| i)));
  task.yield();
  held.fold(0, |sum: Int, t: Task<Int>| sum + task.join(t) + task.join(t))
}

fn relayed() -> Int / {task.write, abort.raise} = {
  let outer = task.spawn(|| task.spawn(|| 21));
  task.yield();
  task.yield();
  let inner = task.join(outer);
  task.yield();
  task.join(inner) * 2
}

test/nondet "a join returns its own task among hundreds that retired around it" {
  assert_eq(churn(300), 89700)
}

test/nondet "a kept handle can be joined again and again" { assert_eq(kept(40), 1560) }

test/nondet "a handle a finished task returned keeps its own task joinable" {
  assert_eq(relayed(), 42)
}
