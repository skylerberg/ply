fn churn(n: Int) -> Int / {task.write, abort.raise} =
  range(0, n).fold(0, |sum: Int, i: Int| {
    task.spawn(|| i);
    let t = task.spawn(|| i * 2);
    task.yield();
    sum + task.join(t)
  })

fn retained(n: Int) -> Int / {task.write, abort.raise} = {
  let held = range(0, n).fold([], |tasks: List<Task<Int>>, i: Int| tasks.push(task.spawn(|| i)));
  task.yield();
  held.fold(0, |sum: Int, t: Task<Int>| sum + task.join(t) + task.join(t))
}

fn relayed() -> Int / {task.write, abort.raise} = {
  let outer = task.spawn(|| task.spawn(|| 21));
  task.yield();
  task.yield();
  let inner = task.join(outer);
  task.yield();
  task.join(inner) * 2
}

test/nondet "a join returns its own task among hundreds that retired around it" {
  assert_eq(churn(300), 89700)
}

test/nondet "a stored handle can be joined repeatedly" { assert_eq(retained(40), 1560) }

test/nondet "a handle returned by a finished task can still be joined" { assert_eq(relayed(), 42) }
