fn yielded(n: Int) -> Unit / {task.write} =
  if n <= 0 { () } else {
    task.yield();
    yielded(n - 1)
  }

test "a simulation whose task yields leaves no program objects still allocated" {
  simulate { yielded(10) }
}

test/nondet "the memory a scheduler allocates inside a channel is not reported as a leaked object of the program after the test run" {
  let c: Chan<Int> = task.channel(4);
  assert(task.send(c, 1))
}
