//! Arithmetic every other module here calls into, which puts a compiled body underneath a cell, a
//! handler and a `simulate` region.

pub fn step(n: Int) -> Int = (n * 3 + 1) % 1000

pub fn mix(a: Int, b: Int) -> Int = (a * 31 + b * 17) % 100003

pub fn share(a: Int, b: Int) -> Int / {abort.raise} = a / b

pub fn seeded() -> Int = 7 * 11 + 3

// A bare nullary constructor in a pattern is a test of the constructor, not a binder.
pub fn or_else(o: Option<Int>, d: Int) -> Int = match o { None -> d, Some(v) -> v }

pub fn tagged(n: Int) -> Int = or_else(map_get(map_insert(map_new(), 1, 7), n), 99)
