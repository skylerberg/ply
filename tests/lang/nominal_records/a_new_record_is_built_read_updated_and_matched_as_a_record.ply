//! `type T = new { .. }` declares a record of its own: it is read, updated and matched as any
//! record is, and a record literal is one wherever the place it is written in expects one.

import nominal_records.calendar
import nominal_records.calendar (Date, Pair, Stay, epoch)
import std.bin
import std.json
import std.show (show)
import std.value (render)

fn new_year(year: Int) -> Date = { year, month: 1, day: 1 }

fn later(d: Date, years: Int) -> Date = { ..d, year: d.year + years }

fn swapped<a>(p: Pair<a>) -> Pair<a> = { first: p.second, second: p.first }

fn found(year: Int) -> Option<Date> = if year > 0 { Some({ year, month: 1, day: 1 }) } else { None }

fn read(text: String) -> Result<Date, String> =
  match text {
    "epoch" -> Ok(epoch()),
    "millennium" -> Ok({ year: 2000, month: 1, day: 1 }),
    _ -> Err(text),
  }

fn stay() -> Stay =
  {
    from: epoch(),
    to: { year: 1970, month: 1, day: 8 },
    stops: [{ year: 1970, month: 1, day: 3 }, epoch()],
  }

fn since(d: Date = { year: 1970, month: 1, day: 1 }) -> Int = d.year

test "a literal is the record where a function answers one, a `let` writes one or a call takes one" {
  assert_eq(new_year(1999).year, 1999);
  let leap: Date = { year: 2024, month: 2, day: 29 };
  assert_eq(leap.day, 29);
  assert_eq(later({ year: 1, month: 2, day: 3 }, 4).year, 5);
  assert_eq(since(), 1970)
}

test "a literal is the record inside a constructor, a list, a branch and a record that is expected" {
  assert_eq(found(7), Some(new_year(7)));
  assert_eq(found(0), None);
  assert_eq(read("millennium"), Ok(new_year(2000)));
  assert_eq(stay().to.day, 8);
  assert_eq(len(stay().stops), 2);
  let days: List<Date> = [{ year: 1, month: 1, day: 1 }, { year: 2, month: 1, day: 1 }];
  assert_eq(map(days, |d: Date| d.year), [1, 2]);
  let pick = |early: Bool| -> Date {
    if early { { year: 1, month: 1, day: 1 } } else { { year: 9, month: 1, day: 1 } }
  };
  assert_eq(pick(false).year, 9)
}

test "a literal after a value of the record takes its type: an argument, an element, a side of `==`" {
  assert_eq(epoch(), { year: 1970, month: 1, day: 1 });
  assert_eq(found(3), Some({ year: 3, month: 1, day: 1 }));
  assert(epoch() == { year: 1970, month: 1, day: 1 });
  assert_eq(len([epoch(), { year: 1, month: 1, day: 1 }]), 2);
  assert_eq(push([epoch()], { year: 2, month: 1, day: 1 }), [epoch(), new_year(2)]);
  let chosen = if true { epoch() } else { { year: 0, month: 0, day: 0 } };
  assert_eq(chosen, epoch())
}

test "an update keeps the record's type, and a field it writes is expected at its declared type" {
  assert_eq(later(epoch(), 30), new_year(2000));
  let moved: Stay = { ..stay(), from: { year: 1969, month: 12, day: 31 } };
  assert_eq(moved.from.year, 1969);
  assert_eq(moved.to, stay().to)
}

test "a pattern names its fields or ends with `..`, and a `match` reads them" {
  let { year, month, day } = new_year(1984);
  assert_eq(year + month + day, 1986);
  let { day: d, .. } = epoch();
  assert_eq(d, 1);
  let season = |date: Date|
    match date {
      { month: 12, .. } | { month: 1, .. } | { month: 2, .. } -> "winter",
      { month, .. } if month < 6 -> "spring",
      _ -> "later",
    };
  assert_eq(map([epoch(), { year: 1, month: 4, day: 1 }, { year: 1, month: 9, day: 1 }], season), [
    "winter",
    "spring",
    "later",
  ])
}

test "a parameterized record is built and read at each type it is used at" {
  assert_eq(swapped({ first: 1, second: 2 }).first, 2);
  let words: Pair<String> = { first: "a", second: "b" };
  assert_eq(swapped(words).second, "a");
  let nested: Pair<Date> = { first: epoch(), second: { year: 1, month: 1, day: 1 } };
  assert_eq(nested.second.year, 1);
  let index = calendar::noted(calendar::noted(calendar::none(), "b"), "a");
  assert_eq(map_keys(index.entries), ["a", "b"])
}

test "it is compared, ordered, shown, reflected and digested as the record it is written as" {
  assert(epoch() == new_year(1970));
  assert(epoch() != new_year(1971));
  assert_eq(compare(epoch(), new_year(1971)), Less);
  assert_eq(max(epoch(), new_year(1971)), new_year(1971));
  assert_eq(show(epoch()), "{day: 1, month: 1, year: 1970}");
  assert_eq(f"on {epoch()}", "on {day: 1, month: 1, year: 1970}");
  assert_eq(render(reflect(epoch())), "{day: 1, month: 1, year: 1970}");
  assert_eq(digest(epoch()), digest({ year: 1970, month: 1, day: 1 }))
}

test "the derivers write a record's codecs and dictionaries for it" {
  let d = epoch();
  let text = json::encode_string(d, calendar::date_json());
  assert_eq(text, "{\"day\":1,\"month\":1,\"year\":1970}");
  assert_eq(json::decode_string(text, calendar::date_json()), Ok(d));
  assert_eq(bin::decode(bin::encode(d, calendar::date_bin()), calendar::date_bin()), Ok(d));
  assert(calendar::date_eq().eq(d, new_year(1970)));
  assert_eq(calendar::date_ord().compare(d, new_year(1971)), Less);
  assert_eq(calendar::date_show().show(d), show(d));
  assert_eq(calendar::date_hash().hash(d), digest(d));
  let pairs = calendar::pair_json(json::int_json());
  let pair: Pair<Int> = { first: 1, second: 2 };
  assert_eq(json::decode_string(json::encode_string(pair, pairs), pairs), Ok(pair));
  let stays = calendar::stay_json();
  assert_eq(json::decode_string(json::encode_string(stay(), stays), stays), Ok(stay()))
}

law "a date written as JSON reads back as itself"
  forall (d: Date) {
    json::decode_string(json::encode_string(d, calendar::date_json()), calendar::date_json())
      == Ok(d)
  }
