//! A record literal is a `new` record where a raise carries one, where a `try` or a `handle`
//! answers one, and where a clause answers for the operation or for the whole `handle`.

import nominal_records.calendar (Date, epoch)

effect dates {
  raise past(last: Date)
  raise unknown(asked: Date, why: String)
  read today() -> Date
}

fn within(d: Date) -> Date / {dates.past} =
  if d.month > 12 { dates.past({ year: d.year, month: 12, day: 31 }) } else { d }

fn tried(month: Int) -> Result<Date, Date> = try { within({ year: 1, month: month, day: 1 }) }

/// The body's value is a literal in either branch, and the raise's payload is one.
fn made(month: Int) -> Result<Date, Date> =
  try {
    if month > 12 { dates.past({ year: 0, month: 12, day: 31 }) }
    else { { year: 1, month: month, day: 1 } }
  }

fn named(month: Int) -> Result<Date, (Date, String)> =
  try {
    if month > 12 { dates.unknown({ year: 0, month: month, day: 0 }, "no such month") }
    else { { year: 1, month: month, day: 1 } }
  }

fn or_epoch(month: Int) -> Date =
  handle {
    within({ year: 1, month: month, day: 1 })
  } with {
    dates.past(last) -> { year: 1970, month: 1, day: 1 },
  }

fn tomorrow() -> Date / {dates.today} = {
  let today = dates.today();
  { ..today, day: today.day + 1 }
}

test "a raise carries a literal as the record its operation declares" {
  assert_eq(tried(3), Ok({ year: 1, month: 3, day: 1 }));
  assert_eq(tried(13), Err({ year: 1, month: 12, day: 31 }))
}

test "a `try` body's value is the record where a `Result` of one is expected" {
  assert_eq(made(2), Ok({ year: 1, month: 2, day: 1 }));
  assert_eq(made(13), Err({ year: 0, month: 12, day: 31 }));
  assert_eq(named(13), Err(({ year: 0, month: 13, day: 0 }, "no such month")));
  let inline: Result<Date, Date> = try { within({ year: 2, month: 2, day: 2 }) };
  assert_eq(inline, Ok({ year: 2, month: 2, day: 2 }))
}

test "a clause answers a raise with a literal for the whole `handle`, and an operation with its result" {
  assert_eq(or_epoch(13), epoch());
  assert_eq(or_epoch(3).month, 3);
  let next = handle { tomorrow() } with { dates.today() -> { year: 1999, month: 12, day: 30 } };
  assert_eq(next.day, 31);
  let fallen = handle {
    within({ year: 5, month: 40, day: 1 })
  } with {
    dates.past(last) -> { ..last, day: 1 },
  };
  assert_eq(fallen, { year: 5, month: 12, day: 1 })
}
