//! What a `new` record rejects: any other type where it is expected, itself where any other is, a
//! literal that is not all of its fields, and a declaration that reaches itself.

import compiler.check.infer (check_dump, check_dumps)
import compiler.syntax.items (parse)

fn calendar() -> String =
  \\pub type Date = new { year: Int, month: Int, day: Int }
  \\pub type Day = new { year: Int, month: Int, day: Int }
  \\pub type Plain = { year: Int, month: Int, day: Int }
  \\pub fn epoch() -> Date = { year: 1970, month: 1, day: 1 }
  \\pub fn year_of(d: Date) -> Int = d.year
  \\

/// What the checker says of `calendar` with `body` after it.
fn checked(body: Bytes) -> String / {abort.raise} =
  check_dump([{ name: b"m", src: Bytes::of_string(calendar()).concat(body) }])

/// A rejection is `X;` and its diagnostics after the count of modules.
fn rejected(body: Bytes, code: String) -> Bool / {abort.raise} =
  !accepted(body) && checked(body).contains(code)

fn accepted(body: Bytes) -> Bool / {abort.raise} = !checked(body).starts_with("K;1;X;")

test "the declarations and a literal where a `Date` is expected check" {
  assert(accepted(b""));
  assert(accepted(b"fn a() -> Int = year_of({ year: 1, month: 2, day: 3 })"))
}

test "a record with a `new` record's fields is not one unless it is written where one is expected" {
  let held = b"fn a() -> Int = {\n  let r = { year: 1, month: 2, day: 3 };\n  year_of(r)\n}";
  assert(rejected(held, "E0201"));
  assert(rejected(b"fn a(p: Plain) -> Int = year_of(p)", "E0201"));
  assert(rejected(b"fn a(p: Plain) -> Date = p", "E0201"))
}

test "a `new` record is no other record, of the same fields or of another declaration" {
  assert(rejected(b"fn a() -> Plain = epoch()", "E0201"));
  assert(rejected(b"fn a() -> { year: Int, month: Int, day: Int } = epoch()", "E0201"));
  assert(rejected(b"fn a(d: Day) -> Date = d", "E0201"));
  assert(rejected(b"fn a(d: Day) -> Bool = d == epoch()", "E0201"))
}

test "a literal names every field of the record it is expected to be, and no other" {
  assert(rejected(b"fn a() -> Date = { year: 1, month: 2 }", "E0201"));
  assert(rejected(b"fn a() -> Date = { year: 1, month: 2, day: 3, hour: 4 }", "E0101"));
  assert(rejected(b"fn a() -> Date = { year: 1, month: 2, day: \"three\" }", "E0201"))
}

test "an update writes only the record's fields, each at its declared type" {
  assert(accepted(b"fn a(d: Date) -> Date = { ..d, day: 1 }"));
  assert(rejected(b"fn a(d: Date) -> Date = { ..d, hour: 1 }", "E0117"));
  assert(rejected(b"fn a(d: Date) -> Date = { ..d, day: \"one\" }", "E0201"));
  assert(rejected(b"fn a(d: Date) -> Day = { ..d, day: 1 }", "E0201"))
}

test "a field it lacks is not read, and a pattern names every field or ends with `..`" {
  assert(rejected(b"fn a(d: Date) -> Int = d.hour", "E0101"));
  assert(
    rejected(b"fn a(d: Date) -> Int = {\n  let { year, month } = d;\n  year + month\n}", "E0201"),
  );
  assert(accepted(b"fn a(d: Date) -> Int = {\n  let { year, month, .. } = d;\n  year + month\n}"))
}

test "a `new` record whose fields reach it is rejected, and one that reaches it through a sum is not" {
  assert(rejected(b"type Tree = new { kids: List<Tree> }", "E0214"));
  assert(
    rejected(b"type Ping = new { pong: Pong }\ntype Pong = new { ping: Option<Ping> }", "E0214"),
  );
  assert(rejected(b"type Wrap = { inner: Loop }\ntype Loop = new { wrap: Option<Wrap> }", "E0214"));
  assert(accepted(b"type Tree = new { root: Node }\ntype Node = | Leaf | Fork(Tree, Tree)"))
}

test "its declaration is closed: no scoped value, no effect variable, no unordered `Map` key" {
  assert(rejected(b"type Held<[r]> = new { held: Scoped<Int, [r]> }", "E0446"));
  assert(rejected(b"type Open = new { run: (Int) -> Int / e }", "E0301"));
  assert(rejected(b"type Keyed = new { by: Map<Float, Int> }", "E0206"));
  let index = b"type Index<k> = new { by: Map<k, Int> }\n";
  // The type carries its key's order into each signature naming it, so the signature need not
  // write it, and a caller that cannot meet it is rejected.
  assert(accepted(index.concat(b"fn none<k>() -> Index<k> = { by: Map::new() }")));
  assert(
    rejected(
      index.concat(
        b"fn none<k>() -> Index<k> = { by: Map::new() }\nfn floats() -> Index<Float> = none()",
      ),
      "E0206",
    ),
  );
  assert(
    accepted(
      index.concat(b"fn none<k>() -> Index<k>\n  where derivable(ord, k)\n= { by: Map::new() }"),
    ),
  );
  assert(accepted(index.concat(b"fn kept<k>(i: Index<k>) -> Index<k> = i")));
  // A type that does not key a `Map` by its parameter carries nothing for it.
  assert(
    rejected(
      b"type Boxed<k> = new { held: k }\nfn same<k>(b: Boxed<k>) -> Ordering = compare(b.held, b.held)",
      "E0206",
    ),
  )
}

fn stepper_source() -> Bytes =
  b"type Stepper<a | e> = new { step: () -> Option<a> / e }\nfn raising() -> Stepper<Int | {abort.raise}> = { step: || panic(\"spent\") }\n"

fn stepping(body: Bytes) -> Bytes = stepper_source().concat(body)

test "the effects a `new` record is given are part of which type it is, as a sum's are" {
  assert(accepted(stepper_source()));
  let pure = b"fn pure(s: Stepper<Int | {}>) -> Option<Int> = (s.step)()\n";
  assert(rejected(stepping(pure.concat(b"fn a() -> Option<Int> = pure(raising())")), "E0302"));
  assert(
    rejected(stepping(b"fn a() -> Stepper<Int | {}> = { step: || panic(\"spent\") }"), "E0302"),
  );
  assert(accepted(stepping(b"fn a() -> Stepper<Int | {abort.raise}> = { step: || Some(1) }")))
}

test "a use fills every parameter a `new` record binds, and its declaration names only its own" {
  assert(rejected(stepping(b"fn a(s: Stepper<Int>) -> Int = 1"), "E0202"));
  let sender = b"effect net { write send[r](Bytes) -> Unit }\ntype Sender<[l]> = new { send: (Bytes) -> Unit / {net.send[l]} }\n";
  assert(accepted(sender));
  assert(rejected(sender.concat(b"fn a(s: Sender) -> Int = 1"), "E0202"));
  assert(rejected(sender.concat(b"fn a(s: Sender<[conn]>) -> Sender<[peer]> = s"), "E0201"));
  assert(rejected(b"type Free = new { run: () -> Int / e }", "E0301"))
}

test "the effects a field is given are seen leaving a scope, as a plain record's are" {
  let reader = b"type Reader<| e> = new { read: () -> Int / e }\nfn reader<| e>(read: keep () -> Int / e) -> Reader<| e> = { read: read }\n";
  let inside = b"fn a() -> Int = with_scope[counter](1, |x: Int| ()) { c -> (reader(|| c.get()).read)() }";
  assert(accepted(reader.concat(inside)));
  let escaping = b"fn a() -> Int = { let r = with_scope[counter](0, |x: Int| ()) { c -> reader(|| c.get()) }; 0 }";
  assert(rejected(reader.concat(escaping), "E0446"));
  // Effects a declaration writes name no scope, so a closure over a scoped value is none it holds.
  let written = b"type Reader = new { read: () -> Int / {scoped.read[counter]} }\n";
  let held = b"fn a() -> Int = with_scope[counter](1, |x: Int| ()) { c -> { let r: Reader = { read: || c.get() }; 0 } }";
  assert(rejected(written.concat(held), "E0302"));
  // A sum hides its fields, so it is denied the record where it is declared.
  assert(rejected(written.concat(b"type Kept = | Kept(Reader)"), "E0446"))
}

test "a tuple where a `new` record is expected is another type, not a record misnamed" {
  let dump = checked(b"fn a() -> Date = (1, 2, 3)");
  assert(dump.contains("E0201"));
  assert(!dump.contains("E0101"))
}

test "a program of `new` records checked again from what it published gives the same result" {
  let program = [
    {
      name: b"m",
      src: Bytes::of_string(calendar()).concat(
        b"pub fn later(d: Date) -> Date = { ..d, year: year_of({ ..d, day: 1 }) + 1 }",
      ),
    },
  ];
  let dumps = check_dumps(program);
  assert_eq(dumps.seeded, dumps.uncached)
}

test "`new` is followed by a record type that names a field" {
  let diagnosed = |src: Bytes| parse(src).parser.diagnostics.len();
  assert_eq(diagnosed(b"type Date = new { year: Int }\n"), 0);
  assert_eq(diagnosed(b"type Date = new {}\n"), 1);
  assert_eq(diagnosed(b"type Date = new (Int, Int)\n"), 1);
  assert_eq(diagnosed(b"type Year = new Int\n"), 1)
}
