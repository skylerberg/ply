import std.json
import std.bin

pub type Date = new { year: Int, month: Int, day: Int }

derive json for Date

derive bin for Date

derive eq for Date

derive ord for Date

derive show for Date

derive hash for Date

pub type Pair<a> = new { first: a, second: a }

derive json for Pair

pub type Stay = new { from: Date, to: Date, stops: List<Date> }

derive json for Stay

pub type Index<k> = new { entries: Map<k, Int> }

pub fn epoch() -> Date = { year: 1970, month: 1, day: 1 }

pub fn none<k>() -> Index<k>
  where derivable(ord, k)
= { entries: map_new() }

pub fn noted<k>(index: Index<k>, key: k) -> Index<k>
  where derivable(ord, k)
= { ..index, entries: map_insert(index.entries, key, map_len(index.entries)) }
