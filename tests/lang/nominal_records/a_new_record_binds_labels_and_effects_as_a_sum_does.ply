effect net {
  write send[r](Bytes) -> Unit
}

effect count {
  read next() -> Int
}

pub type Stepper<a | e> = new { step: () -> Option<a> / e, taken: Int }

pub type Sender<[l]> = new { send: (Bytes) -> Unit / {net.send[l]} }

pub type Feed<a, [l] | e> = new { read: () -> a / e, send: (a) -> Unit / {net.send[l] | e} }

fn always(n: Int) -> Stepper<Int | {}> = { step: || Some(n), taken: 0 }

fn counting() -> Stepper<Int | {count.next}> = { step: || Some(count.next()), taken: 0 }

fn stepper_allowing_raise(n: Int) -> Stepper<Int | {abort.raise}> = { step: || Some(n), taken: 0 }

fn stepped<a | e>(s: Stepper<a | e>) -> Option<a> / e = (s.step)()

fn taken<a | e>(s: Stepper<a | e>) -> Stepper<a | e> = { ..s, taken: s.taken + 1 }

fn replaced<a | e>(s: Stepper<a | e>, step: keep () -> Option<a> / e) -> Stepper<a | e> =
  { ..s, step: step }

fn to<[l]>() -> Sender<[l]> = { send: |b: Bytes| net.send[l](b) }

fn feed<[l]>(n: Int) -> Feed<Int, [l] | {count.next}> =
  { read: || n + count.next(), send: |v: Int| net.send[l](Bytes::of_string(v.to_string())) }

fn pumped<a, [l] | e>(f: Feed<a, [l] | e>) -> Unit / {net.send[l] | e} = (f.send)((f.read)())

test "a record with an effect parameter is built, read and updated at the effects it is given" {
  assert_eq(stepped(always(3)), Some(3));
  assert_eq(taken(taken(always(3))).taken, 2);
  assert_eq(stepped(replaced(always(3), || Some(9))), Some(9));
  assert_eq(stepped(stepper_allowing_raise(4)), Some(4))
}

test "the effects a record is given are what calling its function performs" {
  let drawn = handle { stepped(taken(counting())) } with { count.next() -> 7 };
  assert_eq(drawn, Some(7))
}

test "a record type's label parameter is set by a label in a type annotation or by the label of a called function's return type" {
  let sent = handle {
    to[conn]().send(b"one");
    let s: Sender<[peer]> = { send: |b: Bytes| net.send[peer](b) };
    (s.send)(b"two");
    0
  } with {
    net.send[conn](b) resume k -> k(()) + b.len(),
    net.send[peer](b) resume k -> k(()) + 10 * b.len(),
  };
  assert_eq(sent, 33)
}

test "a call infers a record's type, label and effect parameters all from the record passed as its argument" {
  let wrote = handle {
    pumped(feed[conn](40));
    0
  } with {
    count.next() -> 2,
    net.send[conn](b) resume k -> k(()) + b.len(),
  };
  assert_eq(wrote, 2)
}
