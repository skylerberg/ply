import members.shapes
import members.shapes (Shape, made)

test "`value.shapes::doubled()` passes the value as the first argument to `shapes::doubled`" {
  assert_eq(made().area().shapes::doubled(), 24);
  let n = made().area();
  assert_eq(n.shapes::doubled().shapes::doubled(), 48)
}

test "`value.Shape::grown(1)` passes the value as the first argument to the type's function `Shape::grown`" {
  assert_eq(made().Shape::grown(1).Shape::area(), 27)
}
