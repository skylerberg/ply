//! `value.m::f(..)` is `m::f(value, ..)`: a function that is no function of the value's type takes
//! its place in a chain of calls.

import members.shapes
import members.shapes (Shape, made)

test "a value is the first argument of the function named after the dot" {
  assert_eq(made().area().shapes::doubled(), 24);
  let n = made().area();
  assert_eq(n.shapes::doubled().shapes::doubled(), 48)
}

test "a function of a type is named so too" {
  assert_eq(made().Shape::grown(1).Shape::area(), 27)
}
