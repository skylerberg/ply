fn sorted_total(xs: List<Int>) -> Int = xs.sort().sum()

fn lengths(words: List<String>) -> List<Int> = words.map(|w| w.len())

fn distinct(xs: List<Int>) -> Set<Int> = Set::of_list(xs)

test "the language's types' functions need no import" {
  assert_eq(sorted_total([3, 1, 2]), 6);
  assert_eq(List::sort([2, 1]), [1, 2]);
  assert_eq(lengths(["ab", "c"]), [2, 1]);
  assert_eq(Some(2).map(|x| x * 2).unwrap_or(0), 4);
  assert_eq(["a", "b", "a"].frequencies().len(), 2);
  assert_eq([1, 2, 2].group_by(|n| n).len(), 2)
}

test "the builtin functions `distinct` and `abs` can be called without an import" {
  assert_eq(distinct([1, 1, 2]).size(), 2);
  assert_eq(abs(0 - 3), 3)
}
