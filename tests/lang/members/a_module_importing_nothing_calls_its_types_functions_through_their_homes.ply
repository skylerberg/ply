fn second(xs: List<Int>) -> Int / {abort.raise} = xs.get(1)

fn counted(m: Map<Bytes, Int>, key: Bytes) -> Int = m.get_or(key, 0)

fn doubled(b: Bytes) -> Bytes = b.repeat(2)

test "a list's, a map's and a byte string's functions are called with nothing imported" {
  assert_eq(second([4, 5, 6]), 5);
  assert_eq(counted(Map::new().insert(b"a", 1), b"a"), 1);
  assert_eq(counted(Map::new(), b"b"), 0);
  assert_eq(doubled(b"ab"), b"abab")
}
