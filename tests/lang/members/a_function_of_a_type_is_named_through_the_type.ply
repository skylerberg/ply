//! Where a type is in scope, `T::name` names its function: one that takes no value of the type,
//! and one handed on as a value.

import members.shapes (Shape, made)

test "a function of an imported type is named through the type" {
  assert_eq(Shape::unit().area(), 1);
  assert_eq(Shape::area(made()), 12)
}

test "a function of a type is a value like any other" {
  assert_eq([made(), Shape::unit()].map(Shape::area), [12, 1])
}
