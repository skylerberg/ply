test "a list's builtins are called on the list" {
  let xs = [3, 1, 2];
  assert_eq(xs.len(), 3);
  assert_eq(xs.push(4).len(), 4);
  assert_eq(xs.map(|x| x * 2).fold(0, |accumulator, x| accumulator + x), 12)
}

test "a builtin function named for a type is called on a value of that type" {
  let m = Map::new().insert("a", 1);
  assert_eq(m.get("a"), Some(1));
  assert_eq(m.insert("b", 2).len(), 2);
  assert_eq(b"hello".len(), 5);
  assert_eq("  hi ".trim().len(), 2)
}

test "an `if` on a byte string's length makes slicing that byte string safe" {
  let b = b"abc";
  let first = if b.len() >= 1 { b.slice(0, 1) } else { b"" };
  assert_eq(first, b"a")
}

test "a local variable named like a builtin function does not shadow the builtin method call" {
  let push = 7;
  let len = 100;
  assert_eq([1].push(push).len() + len, 102)
}

test "a method call inside an interpolated string works the same as one outside it" {
  let xs = [3, 1, 2];
  assert_eq(f"{xs.len()} held, {xs.map(|x| x * 2).len()} doubled", "3 held, 3 doubled")
}

type Queue = { items: List<Int>, taken: Int }

fn len(q: Queue) -> Int = q.items.len() - q.taken

fn list_len(q: Queue) -> Int = List::len(q.items)

fn queue_at(q: Queue, i: Int) -> Option<Int> = q.items.at(q.taken + i)

test "a module function with the same name as a type's function is a separate function" {
  let q = { items: [1, 2, 3], taken: 1 };
  assert_eq(len(q), 2);
  assert_eq(list_len(q), 3);
  assert_eq(q.items.len(), 3);
  assert_eq(queue_at(q, 0), Some(2));
  assert_eq(Map::new().insert("a", 1).get("a"), Some(1))
}
