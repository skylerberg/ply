//! A builtin the prelude declares under a type is that type's function: it is called on a value
//! of the type, or through the type, as any function of a type is, and no module's own function
//! takes its place.

test "a list's builtins are called on the list" {
  let xs = [3, 1, 2];
  assert_eq(xs.len(), 3);
  assert_eq(xs.push(4).len(), 4);
  assert_eq(xs.map(|x| x * 2).fold(0, |acc, x| acc + x), 12)
}

test "a builtin named for a type is that type's" {
  let m = Map::new().insert("a", 1);
  assert_eq(m.get("a"), Some(1));
  assert_eq(m.insert("b", 2).len(), 2);
  assert_eq(b"hello".len(), 5);
  assert_eq("  hi ".trim().len(), 2)
}

test "a guard on a value's own length lets a part of it be read" {
  let b = b"abc";
  let first = if b.len() >= 1 { b.slice(0, 1) } else { b"" };
  assert_eq(first, b"a")
}

test "a binding of a builtin's name does not take the builtin's place" {
  let push = 7;
  let len = 100;
  assert_eq([1].push(push).len() + len, 102)
}

test "a call on a value stands in an interpolated string as it does anywhere" {
  let xs = [3, 1, 2];
  assert_eq(f"{xs.len()} held, {xs.map(|x| x * 2).len()} doubled", "3 held, 3 doubled")
}

type Queue = { items: List<Int>, taken: Int }

fn len(q: Queue) -> Int = q.items.len() - q.taken

fn list_len(q: Queue) -> Int = List::len(q.items)

fn map_get(q: Queue, i: Int) -> Option<Int> = q.items.at(q.taken + i)

test "a function of the module's own under a name a type's function has is another function" {
  let q = { items: [1, 2, 3], taken: 1 };
  assert_eq(len(q), 2);
  assert_eq(list_len(q), 3);
  assert_eq(q.items.len(), 3);
  assert_eq(map_get(q, 0), Some(2));
  assert_eq(Map::new().insert("a", 1).get("a"), Some(1))
}
