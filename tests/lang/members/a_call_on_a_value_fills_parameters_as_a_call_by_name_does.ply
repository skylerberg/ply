import members.shapes (made, Plus)

test "a parameter a call on a value leaves out takes its default" {
  assert_eq(made().scaled().area(), 48);
  assert_eq(made().scaled(3).area(), 108)
}

test "a call on a value names an argument, in whatever order" {
  assert_eq(made().scaled(measure: Plus).area(), 48);
  assert_eq(made().scaled(measure: Plus, by: 1).area(), 27);
  let s = made();
  assert_eq(s.scaled(by: 5).area(), 300)
}
