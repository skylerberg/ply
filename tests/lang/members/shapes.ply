//! A type with functions of its own, for the modules beside it to call.

pub type Shape = | Square(Int) | Circle(Int)

pub fn Shape::area(s: Shape) -> Int = match s { Square(n) -> n * n, Circle(r) -> 3 * r * r }

pub fn Shape::unit() -> Shape = Square(1)

pub fn Shape::grown(s: Shape, by: Int) -> Shape =
  match s { Square(n) -> Square(n + by), Circle(r) -> Circle(r + by) }

pub fn made() -> Shape = Circle(2)
