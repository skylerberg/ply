//! A function of a type is found by the type of the value it is called on: a module that holds a
//! value of a type calls the type's functions without importing the type or its module's names.

import members.shapes (made)

fn doubled() -> Int = made().grown(1).area() * 2

test "a value of a type declared in another module can call that type's functions" {
  assert_eq(made().area(), 12);
  assert_eq(doubled(), 54)
}

test "`map` over a list of values of an imported type can call the type's function on each element" {
  assert_eq([made(), made().grown(1)].map(|s| s.area()), [12, 27])
}
