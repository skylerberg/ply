effect log {
  write say[l](n: Int) -> Unit
}

type Stack = | Stack(List<Int>)

fn Stack::empty() -> Stack = Stack([])

fn Stack::push(s: Stack, n: Int) -> Stack = match s { Stack(xs) -> Stack(xs.push(n)) }

fn Stack::size(s: Stack) -> Int = match s { Stack(xs) -> xs.len() }

fn Stack::top(s: Stack) -> Option<Int> = match s { Stack(xs) -> xs.at(xs.len() - 1) }

fn Stack::each<| e>(s: Stack, f: (Int) -> Unit / e) -> Unit / e =
  match s { Stack(xs) -> xs.fold((), |u: Unit, x: Int| f(x)) }

fn Stack::note<[l]>(s: Stack) -> Unit / {log.say[l]} = log.say[l](s.size())

type Chain = | End | Link(Int, Chain)

fn Chain::sum(c: Chain) -> Int = match c { End -> 0, Link(n, rest) -> n + rest.sum() }

type Date = new { year: Int, day: Int }

fn Date::next(d: Date) -> Date = { year: d.year, day: d.day + 1 }

fn audited_values(s: Stack) -> List<Int> =
  handle {
    s.note[audit]();
    s.each(|n: Int| log.say[audit](n))
  } with {
    var seen = [],
    log.say[audit](n) -> {
      seen = seen.push(n);
    },
    return u -> seen,
  }

test "a call on a value is the call of its type's function with the value first" {
  let s = Stack::empty().push(1).push(2);
  assert_eq(s.size(), 2);
  assert_eq(s.top(), Some(2));
  assert_eq(Stack::size(s), 2);
  assert_eq(Stack::empty().top(), None)
}

test "a function of a type recurses through calls on its values" {
  assert_eq(Link(1, Link(2, End)).sum(), 3)
}

test "a `new` record has functions beside its fields" {
  let d: Date = { year: 2026, day: 1 };
  assert_eq(d.next().next().day, 3)
}

test "a record field containing a function can be called as a method on the record" {
  let codec = { double: |n: Int| n * 2 };
  assert_eq(codec.double(21), 42)
}

test "a method call on a value can take an effect and a callback argument, as a plain function call can" {
  assert_eq(audited_values(Stack::empty().push(7).push(8)), [2, 7, 8])
}

type Steps = | Landing | Step(Steps)

fn Steps::climbed(s: Steps, counted: Int) -> Int =
  match s { Landing -> counted, Step(below) -> below.climbed(counted + 1) }

test "a function of a type that calls itself last on a value runs as a loop" {
  let flight = range(0, 20000).fold(Landing, |s: Steps, _: Int| Step(s));
  assert_eq(flight.climbed(0), 20000)
}
