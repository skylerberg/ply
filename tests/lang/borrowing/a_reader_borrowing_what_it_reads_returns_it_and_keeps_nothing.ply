fn longest(xs: List<String>) -> Int =
  xs.fold(0, |n: Int, s: String| if s.len() > n { s.len() } else { n })

test "a fold over a list it borrows reads every item" {
  let xs = range(0, 200).map(|i: Int| i.to_string());
  assert_eq(longest(xs) + longest(xs), 6)
}

fn found(m: Map<Int, String>, k: Int, n: Int, accumulator: Int) -> Int =
  if k >= n { accumulator }
  else { found(m, k + 1, n, accumulator + (match m.get(k) { Some(s) -> s.len(), None -> 0 })) }

test "a loop of lookups into a map it borrows finds each key" {
  let words = range(0, 100).fold(Map::new(), |accumulator: Map<Int, String>, i: Int|
    accumulator.insert(i, i.to_string()));
  assert_eq(found(words, 0, 120, 0), 190)
}

test "an entry read from a map is unchanged by a later insert, and the new map contains the updated entry" {
  let words = range(0, 50).fold(Map::new(), |accumulator: Map<Int, String>, i: Int|
    accumulator.insert(i, i.to_string()));
  let y = match words.get(3) { Some(s) -> s, None -> "" };
  let more = words.insert(3, "three");
  assert(y == "3" && more.get(3) == Some("three") && more.len() == 50)
}

fn first_or<a>(xs: List<a>, otherwise: a) -> a = match xs.at(0) { Some(x) -> x, None -> otherwise }

type Named = { name: String, n: Int }

test "a generic function returning the first item works for `Int`, `String` and record lists and leaves no allocations behind" {
  let ints = [4, 5];
  let names = ["a" ++ Int::to_string(1), "b"];
  let records = [{ name: "r" ++ Int::to_string(2), n: 2 }];
  let i = first_or(ints, 0);
  let s = first_or(names, "");
  let r = first_or(records, { name: "", n: 0 });
  let none = first_or([], "none");
  assert(i == 4 && s == "a1" && r.name == "r2" && none == "none" && r.n == 2)
}

type Twenty = {
  a: Int,
  b: Int,
  c: Int,
  d: Int,
  e: Int,
  f: Int,
  g: Int,
  h: Int,
  i: Int,
  j: Int,
  k: Int,
  l: Int,
  m: Int,
  n: Int,
  o: Int,
  p: Int,
  q: Int,
  r: Int,
  s: Int,
  name: String,
}

fn ends(w: Twenty) -> Int = w.a + w.s

fn middle(w: Twenty) -> Int = w.j + w.name.len()

test "a record with twenty fields read by five calls in a row returns the right value each time" {
  let w = {
    a: 1,
    b: 2,
    c: 3,
    d: 4,
    e: 5,
    f: 6,
    g: 7,
    h: 8,
    i: 9,
    j: 10,
    k: 11,
    l: 12,
    m: 13,
    n: 14,
    o: 15,
    p: 16,
    q: 17,
    r: 18,
    s: 19,
    name: "twenty" ++ Int::to_string(20),
  };
  assert_eq(ends(w) + middle(w) + ends(w) + middle(w) + ends(w), 3 * 20 + 2 * 18)
}

fn second(xs: List<String>) -> String = match xs.at(1) { Some(s) -> s, None -> "" }

fn name_of(r: Named) -> String = r.name

test "a value a function returns from a temporary argument stays valid after that argument is released" {
  let s = second(range(0, 10).map(|i: Int| "item" ++ i.to_string()));
  let n = name_of({ name: "n" ++ Int::to_string(3), n: 3 });
  assert(s == "item1" && n == "n3")
}
