fn sum_of(xs: List<Int>, i: Int, accumulator: Int) -> Int =
  match xs.at(i) { Some(x) -> sum_of(xs, i + 1, accumulator + x), None -> accumulator }

fn summed(n: Int) -> Int = sum_of([n, n + 1, n + 2], 0, 0)

fn first(xs: List<String>) -> String = match xs.at(0) { Some(x) -> x, None -> "" }

fn picked(s: String) -> String = first([s ++ "?", s])

fn lengths(s: String) -> Int = [s, s ++ "!", s].fold(0, |n: Int, t: String| n + t.len())

fn listed_twice(n: Int) -> List<Int> = [n, n]

test "a function that borrows a list literal reads all its items" { assert_eq(summed(4), 15) }

test "an item read from a list literal stays valid after the list is released, and each item is released once" {
  assert_eq(picked("x"), "x?");
  assert_eq(lengths("hi"), 7)
}

test "a list literal returned from a function is still valid after the function returns" {
  assert_eq(listed_twice(3), [3, 3])
}

test "`Bytes::concat_all` of a list literal returns the concatenated bytes" {
  let a = b"ab";
  assert_eq(Bytes::concat_all([a, b"c", a]), b"abcab")
}
