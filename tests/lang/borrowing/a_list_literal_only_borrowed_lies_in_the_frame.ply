//! A list literal that is only read or borrowed lies in its caller's frame, and its items stay its
//! caller's. One something is read out of and kept is a block of its own.

fn sum_of(xs: List<Int>, i: Int, acc: Int) -> Int =
  match xs.at(i) { Some(x) -> sum_of(xs, i + 1, acc + x), None -> acc }

fn summed(n: Int) -> Int = sum_of([n, n + 1, n + 2], 0, 0)

fn first(xs: List<String>) -> String = match xs.at(0) { Some(x) -> x, None -> "" }

fn picked(s: String) -> String = first([s ++ "?", s])

fn lengths(s: String) -> Int = [s, s ++ "!", s].fold(0, |n: Int, t: String| n + t.len())

fn listed_twice(n: Int) -> List<Int> = [n, n]

test "a list literal a reader borrows is read as the list it is" { assert_eq(summed(4), 15) }

test "an item read out of a list literal outlives the list, and its items are let go once" {
  assert_eq(picked("x"), "x?");
  assert_eq(lengths("hi"), 7)
}

test "a list returned is a block of its own" { assert_eq(listed_twice(3), [3, 3]) }

test "bytes joined from a list literal return the same result as before" {
  let a = b"ab";
  assert_eq(Bytes::concat_all([a, b"c", a]), b"abcab")
}
