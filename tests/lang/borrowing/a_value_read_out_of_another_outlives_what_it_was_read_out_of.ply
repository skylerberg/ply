type Named = { name: String, n: Int }

fn singleton(r: Named) -> List<Named> = [r]

test "a field read from a record stays valid after a call stores that record in a list" {
  let r = { name: "x" ++ Int::to_string(7), n: 1 };
  let name = r.name;
  let listed = singleton(r);
  assert(name == "x7" && listed.len() == 1)
}

test "an item read from a list is unchanged by a later `set`, and the updated list contains the new item" {
  let xs = range(0, 50).map(|i: Int| Int::to_string(i));
  let y = match xs.at(3) { Some(s) -> s, None -> "" };
  let ys = xs.set(3, "three");
  assert(y == "3" && ys.at(3) == Some("three") && ys.len() == 50)
}

fn first_word(o: Option<String>) -> String = match o { Some(s) -> s, None -> "" }

test "a payload read from an option stays valid after the option is released" {
  let o = Some("y" ++ Int::to_string(9));
  let w = first_word(o);
  assert_eq(w, "y9")
}
