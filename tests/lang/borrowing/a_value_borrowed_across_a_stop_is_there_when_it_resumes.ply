effect choice {
  read flip() -> Bool
}

fn words(n: Int) -> List<String> = range(0, n).map(|i: Int| "w" ++ i.to_string())

fn first_of(xs: List<String>) -> String = match xs.at(0) { Some(s) -> s, None -> "" }

fn chosen(xs: List<String>) -> String / {abort.raise, choice.flip} = {
  let head = first_of(xs);
  if choice.flip() { head ++ "/" ++ first_of(xs.set(0, "changed")) }
  else { head ++ "/" ++ first_of(xs) }
}

fn resumed_with(n: Int, b: Bool) -> List<String> / {abort.raise} =
  handle {
    [chosen(words(n))]
  } with {
    choice.flip() resume k -> {
      let result: List<String> = k(b);
      result
    },
  }

test "an item read from a borrowed list is still valid when an effect handler resumes the call, whether the list is then updated or only read" {
  assert_eq(resumed_with(5, true), ["w0/changed"]);
  assert_eq(resumed_with(5, false), ["w0/w0"])
}

fn peeked(xs: List<String>) -> String / {choice.flip} = {
  let head = first_of(xs);
  if choice.flip() { head } else { head ++ "!" }
}

fn updated_after(n: Int) -> List<String> / {abort.raise} =
  handle {
    let xs = words(n);
    let p = peeked(xs);
    [p ++ "/" ++ first_of(xs.set(0, "changed")) ++ "/" ++ xs.len().to_string()]
  } with {
    choice.flip() resume k -> {
      let result: List<String> = k(true);
      result
    },
  }

test "a list borrowed by a call that an effect handler suspends is intact when the body updates it after the call resumes" {
  assert_eq(updated_after(5), ["w0/changed/5"])
}

fn total(xs: List<String>) -> Int = xs.fold(0, |n: Int, s: String| n + s.len())

type Suspension = | Done(Int) | Suspended(once (Bool) -> Suspension)

fn parked(xs: List<String>) -> Suspension =
  handle {
    let count = || total(xs);
    Done(if choice.flip() { count() } else { count() + 1000 })
  } with {
    choice.flip() resume k -> Suspended(k),
  }

fn resume_false(s: keep Suspension) -> Int =
  match s { Suspended(k) -> match k(false) { Done(n) -> n, Suspended(again) -> 0 }, Done(n) -> n }

test "a closure capturing a list passes the borrowed list on to `resume` when called after its `handle` block has returned" {
  assert_eq(resume_false(parked(words(12))), 1026)
}

fn item_as_list(xs: List<String>, i: Int) -> List<String> =
  match xs.at(i) { Some(s) -> [s], None -> [] }

fn parallel_read(n: Int) -> Int = {
  let xs = words(n);
  let p = parallel { item_as_list(xs, 3), total(xs) };
  if p._0 == ["w3"] { p._1 } else { 0 }
}

test "two parallel branches read a borrowed list, and one of them stores an item from the list" {
  range(0, 8).fold((), |u: Unit, i: Int| assert_eq(parallel_read(100), 290))
}
