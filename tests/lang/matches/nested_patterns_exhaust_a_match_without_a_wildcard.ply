type Tone = | Warm | Cool

fn tone(t: Option<Tone>) -> Int = match t { Some(Warm) -> 1, Some(Cool) -> 2, None -> 3 }

fn settled(r: Result<Option<Bool>, Tone>) -> Int =
  match r {
    Ok(Some(true)) -> 1,
    Ok(Some(false)) -> 2,
    Ok(None) -> 3,
    Err(Warm) -> 4,
    Err(Cool) -> 5,
  }

fn both(a: Bool, b: Bool) -> Int =
  match ((a, b)) { (true, true) -> 1, (true, false) -> 2, (false, _) -> 3 }

fn shape(xs: List<Option<Int>>) -> Int =
  match xs { [] -> 0, [None, ..] -> 1, [Some(n)] -> n, [Some(_), _, ..rest] -> 10 + len(rest) }

fn lamp(p: { tone: Tone, on: Bool }) -> Int =
  match p { { tone: Warm, on: true } -> 1, { tone: Warm, on: false } -> 2, { tone: Cool, .. } -> 3 }

test "nested constructors, tuples, lists and records reach the arm that names them" {
  assert_eq(tone(Some(Cool)), 2);
  assert_eq(tone(None), 3);
  assert_eq(settled(Ok(Some(false))), 2);
  assert_eq(settled(Ok(None)), 3);
  assert_eq(both(true, false), 2);
  assert_eq(both(false, true), 3);
  assert_eq(shape([]), 0);
  assert_eq(shape([None, Some(4)]), 1);
  assert_eq(shape([Some(7)]), 7);
  assert_eq(shape([Some(1), None, None, None]), 12);
  assert_eq(lamp({ tone: Warm, on: false }), 2);
  assert_eq(lamp({ tone: Cool, on: true }), 3)
}
