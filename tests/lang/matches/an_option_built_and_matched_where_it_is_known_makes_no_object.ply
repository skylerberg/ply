//! An `Option` built, looked up, handed across a call, returned, joined by a `match`, carried by a
//! `fold` or compared is its payload's word, `None` zero. Where it leaves the code that knows it,
//! stored or handed to generic code, it is the object it always was.

fn names(n: Int) -> List<String> =
  range(0, n).map(|i: Int| if i % 3 == 0 { "long name" } else { "x" })

/// Called once per element, so no cell it frees is there for the next call to take.
fn counted_here(s: String, n: Int) -> Int =
  match if s == "" { None } else { Some(s) } { Some(t) -> n + t.len(), None -> n }

/// A result the caller matches at once crosses the call as its payload's word.
fn present(s: String) -> Option<String> = if s == "" { None } else { Some(s) }

fn total(xs: List<String>, i: Int, n: Int) -> Int =
  match xs.at(i) {
    Some(s) ->
      total(xs, i + 1, counted_here(s, match present(s) { Some(t) -> n + t.len(), None -> n })),
    None -> n,
  }

fn wrapped(s: String) -> Option<Option<String>> = if s == "" { Some(None) } else { Some(Some(s)) }

fn depth(o: Option<Option<String>>) -> Int =
  match o { Some(Some(_)) -> 2, Some(None) -> 1, None -> 0 }

fn counted(m: Map<String, Int>, k: String) -> Int =
  match m.get(k) { Some(n) if n > 1 -> n, Some(_) -> 1, None -> 0 }

fn last_b(xs: List<String>) -> Option<String> =
  xs.fold(None, |acc: Option<String>, x: String| if x == "b" { Some(x) } else { acc })

fn either(c: Bool, s: String, o: Option<String>) -> Option<String> = if c { Some(s) } else { o }

/// The first element past `n`, found by a fold that carries what it found on.
fn first_over(xs: List<Int>, n: Int) -> Option<Int> =
  xs.fold(None, |acc: Option<Int>, x: Int|
    match acc { Some(_) -> acc, None -> if x > n { Some(x) } else { None } })

fn even(i: Int) -> Option<Int> = if i % 2 == 0 { Some(i) } else { None }

/// How many of `xs` are even, each compared with `None`.
fn count_evens(xs: List<Int>) -> Int =
  xs.fold(0, |acc: Int, i: Int| if even(i) != None && even(i) == Some(i) { acc + 1 } else { acc })

/// An `Option` a `match` returns to a `let` rather than to the caller.
fn chosen(a: Option<Int>, b: Option<Int>) -> Int = {
  let o = match a { Some(_) -> a, None -> b };
  match o { Some(n) -> n, None -> 0 }
}

/// An `Option` a list held, which is an object, joined by an `if` with one built here.
fn stored_or(held: List<Option<Int>>, d: Int) -> Int =
  held.fold(0, |acc: Int, o: Option<Int>| {
    let either = if d > 0 { Some(d) } else { o };
    acc + (match either { Some(n) -> n, None -> 0 })
  })

fn chosen_sum(xs: List<Int>) -> Int = xs.fold(0, |acc: Int, i: Int| acc + chosen(even(i), Some(1)))

test "an `Option` built with a known type can be returned, matched, compared and used as a map key or value" {
  assert_eq(wrapped(""), Some(None));
  assert(wrapped("") != None, None);
  assert_eq(wrapped("a"), Some(Some("a")));
  assert_eq(depth(wrapped("")), 1);
  assert_eq(depth(wrapped("a")), 2);
  assert_eq(depth(None), 0);
  assert_eq([Some("a"), None], [Some("a"), None]);
  assert(Some("a") == Some("a") && Some("a") != Some("b") && Some("a") != None, None);
  let m = Map::new().insert("a", 3).insert("b", 1);
  assert_eq([counted(m, "a"), counted(m, "b"), counted(m, "c")], [3, 1, 0]);
  assert_eq(Map::new().insert(Some("k"), 1).get(Some("k")), Some(1));
  assert_eq(last_b(["a", "b", "c"]), Some("b"));
  assert_eq(last_b(["a"]), None);
  assert_eq(either(true, "s", None), Some("s"));
  assert_eq(either(false, "s", Some("o")), Some("o"));
  assert_eq(total(names(7), 0, 0), 2 * (3 * 9 + 4))
}

test "functions that build, match, compare and sum `Option` values in loops and lists return the right values" {
  assert_eq(first_over([1, 7, 9], 5), Some(7));
  assert_eq(first_over([1, 2], 5), None);
  assert_eq(count_evens(range(0, 5)), 3);
  assert_eq(chosen(Some(4), Some(1)), 4);
  assert_eq(chosen(None, Some(1)), 1);
  assert_eq(chosen(None, None), 0);
  assert_eq(chosen_sum(range(0, 4)), 0 + 1 + 2 + 1);
  assert_eq(stored_or([Some(1), None], 3), 6);
  assert_eq(stored_or([Some(1), None, Some(5)], 0), 6);
  assert_eq(stored_or(range(0, 1000).map(even), 0), 249500)
}
