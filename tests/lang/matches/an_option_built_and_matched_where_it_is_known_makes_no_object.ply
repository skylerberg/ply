//! An `Option` built, looked up, handed across a call or answered and then matched is its payload's
//! word, `None` zero, so no object is made for it. Where it leaves the code that knows it, stored,
//! compared or folded over, it is the object it always was.

fn names(n: Int) -> List<String> =
  map(range(0, n), |i: Int| if i % 3 == 0 { "long name" } else { "x" })

/// Called once per element, so no cell it frees is there for the next call to take.
fn counted_here(s: String, n: Int) -> Int =
  match if s == "" { None } else { Some(s) } { Some(t) -> n + string_len(t), None -> n }

/// An answer the caller matches at once crosses the call as its payload's word.
fn present(s: String) -> Option<String> = if s == "" { None } else { Some(s) }

fn total(xs: List<String>, i: Int, n: Int) -> Int =
  match list_at(xs, i) {
    Some(s) ->
      total(
        xs,
        i + 1,
        counted_here(s, match present(s) { Some(t) -> n + string_len(t), None -> n }),
      ),
    None -> n,
  }

fn wrapped(s: String) -> Option<Option<String>> = if s == "" { Some(None) } else { Some(Some(s)) }

fn depth(o: Option<Option<String>>) -> Int =
  match o { Some(Some(_)) -> 2, Some(None) -> 1, None -> 0 }

fn counted(m: Map<String, Int>, k: String) -> Int =
  match map_get(m, k) { Some(n) if n > 1 -> n, Some(_) -> 1, None -> 0 }

fn last_b(xs: List<String>) -> Option<String> =
  fold(xs, None, |acc: Option<String>, x: String| if x == "b" { Some(x) } else { acc })

fn either(c: Bool, s: String, o: Option<String>) -> Option<String> = if c { Some(s) } else { o }

fn grown(o: Option<List<Int>>, i: Int) -> Option<List<Int>> =
  match o { Some(xs) -> Some(push(xs, i)), None -> None }

fn pushed_through(o: Option<List<Int>>, i: Int, n: Int) -> Int =
  if i >= n { match o { Some(xs) -> len(xs), None -> 0 } }
  else { pushed_through(grown(o, i), i + 1, n) }

fn pushed(xs: List<Int>, i: Int, n: Int) -> Int =
  if i >= n { len(xs) } else { pushed(push(xs, i), i + 1, n) }

test "an option made where it is known answers as the object it was" {
  assert_eq(wrapped(""), Some(None));
  assert(wrapped("") != None, None);
  assert_eq(wrapped("a"), Some(Some("a")));
  assert_eq(depth(wrapped("")), 1);
  assert_eq(depth(wrapped("a")), 2);
  assert_eq(depth(None), 0);
  assert_eq([Some("a"), None], [Some("a"), None]);
  assert(Some("a") == Some("a") && Some("a") != Some("b") && Some("a") != None, None);
  let m = map_insert(map_insert(map_new(), "a", 3), "b", 1);
  assert_eq([counted(m, "a"), counted(m, "b"), counted(m, "c")], [3, 1, 0]);
  assert_eq(map_get(map_insert(map_new(), Some("k"), 1), Some("k")), Some(1));
  assert_eq(last_b(["a", "b", "c"]), Some("b"));
  assert_eq(last_b(["a"]), None);
  assert_eq(either(true, "s", None), Some("s"));
  assert_eq(either(false, "s", Some("o")), Some("o"));
  assert_eq(total(names(7), 0, 0), 2 * (3 * 9 + 4))
}

test "an option built and matched where it is known allocates alike for ten elements and a thousand" {
  let walked = |n: Int| {
    let xs = names(n);
    metered(|| total(xs, 0, 0)).allocations
  };
  assert_eq(walked(1000), walked(10))
}

test "an option a fold carries is made once, not at each step" {
  let folded = |n: Int| {
    let xs = map(range(0, n), |i: Int| if i == 3 { "b" } else { "a" });
    metered(|| last_b(xs)).allocations
  };
  assert_eq(folded(1000), folded(10))
}

test "a list an option alone holds is matched out and pushed to in place" {
  let through = |n: Int| metered(|| pushed_through(Some([]), 0, n)).allocations;
  let bare = |n: Int| metered(|| pushed([], 0, n)).allocations;
  assert_eq(through(1000) - through(10), bare(1000) - bare(10))
}
