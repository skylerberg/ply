type Sky = | Sunny | Rainy

fn heat(t: Option<Sky>, n: Int) -> Int =
  match t {
    Some(Sunny) if n > 0 -> 0,
    Some(Sunny) -> 1,
    Some(Rainy) -> 2,
    _ -> 3,
  }

fn classify(n: Int) -> Int =
  match n {
    x if x < 0 -> -1,
    0 -> 0,
    x if x > 100 -> 2,
    _ -> 1,
  }

fn descent(xs: List<Int>) -> Int =
  match xs {
    [x, y, ..rest] if x > y -> x + len(rest),
    [x, ..] -> x,
    [] -> 0,
  }

fn label(s: String) -> String =
  match s {
    t if t == "a" -> "first",
    "b" -> "second",
    t -> t ++ "!",
  }

fn sized(s: String) -> Int =
  match s {
    _ if string_len(s) > 3 -> 1,
    "ab" -> 2,
    _ -> 3,
  }

fn greeting(o: Option<String>) -> String =
  match o {
    Some(s) if s == "" -> "nobody",
    Some(s) -> "hello " ++ s,
    None -> "none",
  }

fn long_name(o: Option<String>) -> Int =
  match o {
    Some(s) if string_len(s) > 3 -> 1,
    Some(_) -> 2,
    None -> 0,
  }

fn pick(o: Option<Int>, xs: List<Int>) -> Int =
  match o {
    Some(n) if len(xs) > n -> n,
    Some(_) -> len(xs),
    None -> 0 - len(xs),
  }

fn count_down(n: Int) -> Int =
  iterate(n, 100, |k: Int| match k {
    m if m <= 0 -> Stop(m),
    m -> Continue(m - 1),
  })

test "a guard that fails goes on to a later arm with the same pattern" {
  assert_eq(heat(Some(Sunny), 1), 0);
  assert_eq(heat(Some(Sunny), 0), 1);
  assert_eq(heat(Some(Rainy), 1), 2);
  assert_eq(heat(None, 1), 3)
}

test "a guard reads what its pattern bound" {
  assert_eq(classify(-5), -1);
  assert_eq(classify(0), 0);
  assert_eq(classify(500), 2);
  assert_eq(classify(7), 1)
}

test "a guard on a list pattern" {
  assert_eq(descent([5, 3, 1, 1]), 7);
  assert_eq(descent([1, 3]), 1);
  assert_eq(descent([]), 0)
}

// Built with `++`, so each subject is a counted string rather than a constant that is never freed.
test "the subject a failing guard's arm bound is whole for the next arm" {
  assert_eq(label("a" ++ ""), "first");
  assert_eq(label("b" ++ ""), "second");
  assert_eq(label("c" ++ ""), "c!");
  assert_eq(sized("ab" ++ "cd"), 1);
  assert_eq(sized("a" ++ "b"), 2);
  assert_eq(sized("x" ++ ""), 3);
  assert_eq(greeting(Some("" ++ "")), "nobody");
  assert_eq(greeting(Some("an" ++ "n")), "hello ann");
  assert_eq(greeting(None), "none");
  assert_eq(long_name(Some("ab" ++ "cd")), 1);
  assert_eq(long_name(Some("a" ++ "b")), 2);
  assert_eq(long_name(None), 0)
}

test "a guard leaves what a later arm reads" {
  assert_eq(pick(Some(1), [1, 2, 3]), 1);
  assert_eq(pick(Some(5), [1, 2]), 2);
  assert_eq(pick(None, [1]), -1)
}

test "a guard in a loop's step" {
  assert_eq(count_down(3), 0);
  assert_eq(count_down(-4), -4)
}
