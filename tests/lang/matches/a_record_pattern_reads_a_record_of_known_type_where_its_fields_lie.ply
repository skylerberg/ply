type Point = { x: Int, y: Int }

type Named = { name: String, weight: Float, at: Point }

type Shape = | Dot(Point) | Line(Point, Point) | Empty

fn at_origin(o: Option<Point>) -> Bool = match o { Some({ x: 0, y: 0 }) -> true, _ -> false }

fn from_origin(s: Shape) -> Int =
  match s {
    Line({ x: 0, y: 0 }, { x, y }) -> x + y,
    Dot({ x: 0, y }) -> y,
    Line(_, _) -> 0 - 1,
    Dot(_) -> 0 - 2,
    Empty -> 0 - 3,
  }

fn first_on_axis(ps: List<Point>) -> Int = match ps { [{ x, y: 0 }, ..] -> x, _ -> 0 - 1 }

fn seventh(r: Result<Point, String>) -> Int =
  match r { Ok({ x: 7, y }) -> y, Ok(_) -> 0, Err(e) -> 0 - e.len() }

fn larger_sum(p: Point, q: Point) -> Int = {
  let { x, y } = max(p, q);
  x + y
}

fn larger_on_axis(p: Point, q: Point) -> Bool = match max(p, q) { { y: 0, .. } -> true, _ -> false }

fn heavy(n: Named) -> String =
  match n {
    { name: "none", .. } -> "",
    { weight: 0.0, name, .. } -> name ++ " is weightless",
    { at: { x: 0, y: 0 }, name, .. } -> name ++ " is at the origin",
    { name, at: { x, .. }, .. } -> f"{name} at {x}",
  }

type ParseResult = { rest: String, node: Point }

fn parsed(s: String) -> Result<ParseResult, Named> =
  if s.len() > 0 { Ok({ rest: s, node: { x: s.len(), y: 0 } }) }
  else { Err({ name: "empty", weight: 0.0, at: { x: 0, y: 0 } }) }

fn parsed_x(s: String) -> Result<Int, Named> = {
  let { rest, node: { x, .. } } = parsed(s)?;
  Ok(x + rest.len())
}

fn describe(r: Result<ParseResult, Named>) -> String =
  match r {
    Ok({ node: { x: 1, .. }, rest }) -> rest,
    Ok({ rest, .. }) -> rest ++ "!",
    Err({ name, at: { x: 0, .. }, .. }) -> name,
    Err({ name, .. }) -> name ++ "?",
  }

fn always_fails<a>(x: Int) -> Result<a, Named> =
  Err({ name: "lost", weight: 1.0, at: { x: x, y: 0 } })

fn deep(o: Option<Result<Point, Named>>) -> Int =
  match o { Some(Ok({ x, y })) -> x + y, Some(Err({ at: { x, .. }, .. })) -> 0 - x, None -> 0 }

fn listed(rs: List<Result<Point, Named>>) -> Int =
  match rs.at(0) {
    Some(Ok({ x: 0, y })) -> y,
    Some(Ok({ x, .. })) -> x,
    Some(Err({ weight: 0.0, .. })) -> 0 - 1,
    Some(Err(_)) -> 0 - 2,
    None -> 0 - 3,
  }

test "a record pattern over a known record matches as its fields' patterns do" {
  assert(at_origin(Some({ x: 0, y: 0 })));
  assert(!at_origin(Some({ x: 0, y: 1 })));
  assert(!at_origin(None));
  assert_eq(from_origin(Line({ x: 0, y: 0 }, { x: 3, y: 4 })), 7);
  assert_eq(from_origin(Line({ x: 1, y: 0 }, { x: 3, y: 4 })), 0 - 1);
  assert_eq(from_origin(Dot({ x: 0, y: 9 })), 9);
  assert_eq(from_origin(Dot({ x: 2, y: 9 })), 0 - 2);
  assert_eq(from_origin(Empty), 0 - 3);
  assert_eq(first_on_axis([{ x: 5, y: 0 }, { x: 6, y: 0 }]), 5);
  assert_eq(first_on_axis([{ x: 5, y: 1 }]), 0 - 1);
  assert_eq(first_on_axis([]), 0 - 1);
  assert_eq(seventh(Ok({ x: 7, y: 2 })), 2);
  assert_eq(seventh(Ok({ x: 8, y: 2 })), 0);
  assert_eq(seventh(Err("no")), 0 - 2);
  assert_eq(larger_sum({ x: 1, y: 2 }, { x: 3, y: 4 }), 7);
  assert(larger_on_axis({ x: 1, y: 2 }, { x: 3, y: 0 }));
  assert(!larger_on_axis({ x: 9, y: 2 }, { x: 3, y: 0 }));
  let named = |name: String, weight: Float, x: Int|
    { name: name, weight: weight, at: { x: x, y: 0 } };
  assert_eq(heavy(named("none", 1.0, 1)), "");
  assert_eq(heavy(named("air", 0.0, 1)), "air is weightless");
  assert_eq(heavy(named("pin", 1.5, 0)), "pin is at the origin");
  assert_eq(heavy(named("rock", 2.5, 4)), "rock at 4")
}

test "a record pattern inside a constructor pattern reads the fields of the subject's record type" {
  assert_eq(parsed_x("abc"), Ok(6));
  assert_eq(parsed_x(""), Err({ name: "empty", weight: 0.0, at: { x: 0, y: 0 } }));
  assert_eq(describe(parsed("a")), "a");
  assert_eq(describe(parsed("ab")), "ab!");
  assert_eq(describe(parsed("")), "empty");
  assert_eq(describe(always_fails(2)), "lost?");
  assert_eq(deep(Some(Ok({ x: 3, y: 4 }))), 7);
  assert_eq(deep(Some(always_fails(5))), 0 - 5);
  assert_eq(deep(None), 0);
  assert_eq(listed([Ok({ x: 0, y: 8 })]), 8);
  assert_eq(listed([Ok({ x: 2, y: 8 })]), 2);
  assert_eq(listed([Err({ name: "air", weight: 0.0, at: { x: 0, y: 0 } })]), 0 - 1);
  assert_eq(listed([always_fails(1)]), 0 - 2);
  assert_eq(listed([]), 0 - 3)
}
