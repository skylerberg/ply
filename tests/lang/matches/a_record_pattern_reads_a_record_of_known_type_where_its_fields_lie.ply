//! A record pattern over a value whose type is known reads each field where the record holds it
//! and tests only the fields' own patterns. Under a pattern that did not match (another
//! constructor, `None`, an `Err`, a list too short) it reads nothing.

type P = { x: Int, y: Int }

type Named = { name: String, weight: Float, at: P }

type Shape = | Dot(P) | Line(P, P) | Empty

fn at_origin(o: Option<P>) -> Bool = match o { Some({ x: 0, y: 0 }) -> true, _ -> false }

fn from_origin(s: Shape) -> Int =
  match s {
    Line({ x: 0, y: 0 }, { x, y }) -> x + y,
    Dot({ x: 0, y }) -> y,
    Line(_, _) -> 0 - 1,
    Dot(_) -> 0 - 2,
    Empty -> 0 - 3,
  }

fn first_on_axis(ps: List<P>) -> Int = match ps { [{ x, y: 0 }, ..] -> x, _ -> 0 - 1 }

fn seventh(r: Result<P, String>) -> Int =
  match r { Ok({ x: 7, y }) -> y, Ok(_) -> 0, Err(e) -> 0 - string_len(e) }

/// A record a generic builtin answers, taken apart by a `let` and by a `match`.
fn larger_sum(p: P, q: P) -> Int = {
  let { x, y } = max(p, q);
  x + y
}

fn larger_on_axis(p: P, q: P) -> Bool = match max(p, q) { { y: 0, .. } -> true, _ -> false }

/// A counted field, a `Float` and a record held in place, each tested or bound.
fn heavy(n: Named) -> String =
  match n {
    { name: "none", .. } -> "",
    { weight: 0.0, name, .. } -> name ++ " is weightless",
    { at: { x: 0, y: 0 }, name, .. } -> name ++ " is at the origin",
    { name, at: { x, .. }, .. } -> f"{name} at {x}",
  }

test "a record pattern over a known record matches as its fields' patterns do" {
  assert(at_origin(Some({ x: 0, y: 0 })));
  assert(!at_origin(Some({ x: 0, y: 1 })));
  assert(!at_origin(None));
  assert_eq(from_origin(Line({ x: 0, y: 0 }, { x: 3, y: 4 })), 7);
  assert_eq(from_origin(Line({ x: 1, y: 0 }, { x: 3, y: 4 })), 0 - 1);
  assert_eq(from_origin(Dot({ x: 0, y: 9 })), 9);
  assert_eq(from_origin(Dot({ x: 2, y: 9 })), 0 - 2);
  assert_eq(from_origin(Empty), 0 - 3);
  assert_eq(first_on_axis([{ x: 5, y: 0 }, { x: 6, y: 0 }]), 5);
  assert_eq(first_on_axis([{ x: 5, y: 1 }]), 0 - 1);
  assert_eq(first_on_axis([]), 0 - 1);
  assert_eq(seventh(Ok({ x: 7, y: 2 })), 2);
  assert_eq(seventh(Ok({ x: 8, y: 2 })), 0);
  assert_eq(seventh(Err("no")), 0 - 2);
  assert_eq(larger_sum({ x: 1, y: 2 }, { x: 3, y: 4 }), 7);
  assert(larger_on_axis({ x: 1, y: 2 }, { x: 3, y: 0 }));
  assert(!larger_on_axis({ x: 9, y: 2 }, { x: 3, y: 0 }));
  let named = |name: String, weight: Float, x: Int|
    { name: name, weight: weight, at: { x: x, y: 0 } };
  assert_eq(heavy(named("none", 1.0, 1)), "");
  assert_eq(heavy(named("air", 0.0, 1)), "air is weightless");
  assert_eq(heavy(named("pin", 1.5, 0)), "pin is at the origin");
  assert_eq(heavy(named("rock", 2.5, 4)), "rock at 4")
}

test "a record pattern over a known record gives back every count it took" {
  let named = { name: "rock", weight: 2.5, at: { x: 4, y: 0 } };
  assert_eq(metered(|| string_len(heavy(named))).live, 0);
  assert_eq(metered(|| larger_sum({ x: 1, y: 2 }, { x: 3, y: 4 })).live, 0);
  assert_eq(metered(|| seventh(Ok({ x: 7, y: 2 })) + seventh(Err("no"))).live, 0);
  assert_eq(metered(|| from_origin(Line({ x: 0, y: 0 }, { x: 3, y: 4 }))).live, 0);
  assert_eq(metered(|| first_on_axis([{ x: 5, y: 0 }])).live, 0)
}
