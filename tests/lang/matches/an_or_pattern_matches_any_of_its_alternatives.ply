type Coin = | Penny | Nickel | Dime | Quarter

type Shape = | Circle(Int) | Square(Int) | Rect(Int, Int)

fn small(c: Coin) -> Bool = match c { Penny | Nickel -> true, Dime | Quarter -> false }

fn side(s: Shape) -> Int = match s { Circle(n) | Square(n) -> n, Rect(w, _) -> w }

/// Each alternative binds `x` from a different place.
fn other(p: (Int, Int)) -> Int = match p { (x, 0) | (0, x) -> x, _ -> -1 }

fn digit(n: Int) -> String = match n { 0 | 1 | 2 -> "low", 3 | 4 | 5 | 6 -> "mid", _ -> "high" }

fn some_small(o: Option<Coin>) -> Bool = match o { Some(Penny | Nickel) -> true, _ -> false }

fn pair(p: (Coin, Coin)) -> Int =
  match p { (Penny | Nickel, Dime | Quarter) -> 1, (Dime | Quarter, _) -> 2, _ -> 3 }

/// The guard is tried again for the second alternative after the first matched and failed it.
fn guarded(p: (Int, Int)) -> Int = match p { (x, 1) | (1, x) if x > 5 -> x, _ -> 0 }

fn head_or_tail(xs: List<Int>) -> Int = match xs { [x] | [_, x] -> x, _ -> 0 }

fn same(r: Result<Int, Int>) -> Int = {
  let Ok(v) | Err(v) = r;
  v
}

test "an or-pattern matches any of its alternatives" {
  assert(small(Penny));
  assert(small(Nickel));
  assert(!small(Dime));
  assert(!small(Quarter));
  assert_eq(digit(2), "low");
  assert_eq(digit(5), "mid");
  assert_eq(digit(9), "high")
}

test "every alternative binds the same name, each from its own place" {
  assert_eq(side(Circle(3)), 3);
  assert_eq(side(Square(4)), 4);
  assert_eq(side(Rect(5, 6)), 5);
  assert_eq(other((7, 0)), 7);
  assert_eq(other((0, 8)), 8);
  assert_eq(other((0, 0)), 0);
  assert_eq(other((2, 3)), -1);
  assert_eq(head_or_tail([4]), 4);
  assert_eq(head_or_tail([4, 9]), 9);
  assert_eq(head_or_tail([]), 0)
}

test "an or-pattern nests inside a constructor and a tuple" {
  assert(some_small(Some(Nickel)));
  assert(!some_small(Some(Dime)));
  assert(!some_small(None));
  assert_eq(pair((Penny, Quarter)), 1);
  assert_eq(pair((Dime, Penny)), 2);
  assert_eq(pair((Nickel, Penny)), 3)
}

test "a guard is tried for each alternative that matches, in order" {
  assert_eq(guarded((9, 1)), 9);
  assert_eq(guarded((1, 9)), 9);
  assert_eq(guarded((1, 2)), 0);
  assert_eq(guarded((3, 4)), 0)
}

test "a `let` whose or-pattern covers its type binds from whichever alternative matched" {
  assert_eq(same(Ok(3)), 3);
  assert_eq(same(Err(4)), 4)
}
