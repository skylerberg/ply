type Reading = | Level(Int) | Estimate(Int) | Offline | Broken(String)

fn level(r: Reading) -> Int = {
  let Level(n) = r else { -1 };
  n * 2
}

// Each `let ... else` exits the block it is written in, and a later one sees the earlier's names.
fn sum_both(a: Option<Int>, b: Option<Int>) -> Int = {
  let Some(x) = a else { 0 };
  let Some(y) = b else { x };
  x + y
}

fn head_plus(xs: List<Int>) -> Int = {
  let [first, ..rest] = xs else { 0 };
  first + len(rest)
}

// An or-pattern in a `let ... else` binds from whichever alternative matched.
fn value(r: Reading) -> Int = {
  let Level(n) | Estimate(n) = r else { 0 };
  n
}

// The `else` is the block's value, and the block may be nested.
fn describe(r: Reading) -> String = {
  let word = {
    let Broken(why) = r else { "fine" };
    "broken: " ++ why
  };
  word ++ "."
}

fn parsed(o: Option<Int>) -> Result<Int, String> = {
  let Some(n) = o else { Err("missing") };
  Ok(n + 1)
}

fn doubled(o: Option<Int>) -> Result<Int, String> = {
  let n = parsed(o)?;
  let true = n > 10 else { Ok(0) };
  Ok(n * 2)
}

// The `else` block is a return position, so `?` there exits the function.
fn scaled(o: Option<Int>, d: Option<Int>) -> Option<Int> = {
  let Some(n) = o else { Some(d? * 10) };
  Some(n)
}

// A `?` in the initializer exits before the pattern is tried.
fn found(r: Result<Option<Int>, String>) -> Result<Int, String> = {
  let Some(n) = r? else { Ok(-1) };
  Ok(n)
}

test "`?` in a `let ... else` exits from its initializer and from its `else`" {
  assert_eq(scaled(Some(1), None), Some(1));
  assert_eq(scaled(None, Some(2)), Some(20));
  assert_eq(scaled(None, None), None);
  assert_eq(found(Ok(Some(4))), Ok(4));
  assert_eq(found(Ok(None)), Ok(-1));
  assert_eq(found(Err("e")), Err("e"))
}

test "a `let ... else` binds on a match and answers its `else` on a miss" {
  assert_eq(level(Level(4)), 8);
  assert_eq(level(Offline), -1);
  assert_eq(level(Broken("fan")), -1)
}

test "an or-pattern in a `let ... else` binds from the alternative that matched" {
  assert_eq(value(Level(3)), 3);
  assert_eq(value(Estimate(4)), 4);
  assert_eq(value(Offline), 0)
}

test "the statements after a `let ... else` see its names and run only on a match" {
  assert_eq(sum_both(Some(2), Some(3)), 5);
  assert_eq(sum_both(Some(2), None), 2);
  assert_eq(sum_both(None, Some(3)), 0);
  assert_eq(head_plus([5, 1, 1]), 7);
  assert_eq(head_plus([]), 0)
}

test "the `else` is the value of the block the statement is in, not of the function" {
  assert_eq(describe(Broken("fan")), "broken: fan.");
  assert_eq(describe(Offline), "fine.")
}

test "`?` before a `let ... else` still exits the function" {
  assert_eq(parsed(Some(1)), Ok(2));
  assert_eq(parsed(None), Err("missing"));
  assert_eq(doubled(Some(20)), Ok(42));
  assert_eq(doubled(Some(1)), Ok(0));
  assert_eq(doubled(None), Err("missing"))
}
