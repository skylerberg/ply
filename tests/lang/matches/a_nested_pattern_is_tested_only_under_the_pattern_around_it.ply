type Tone = | Warm | Cool

fn settled(r: Result<Option<Bool>, Tone>) -> Int =
  match r { Ok(Some(true)) -> 1, Ok(Some(false)) -> 2, Ok(None) -> 3, Err(Warm) -> 4, Err(Cool) -> 5, _ -> 0 }

fn first_true(r: Result<Option<Bool>, Tone>) -> Int =
  match r { Ok(Some(true)) -> 1, _ -> 0 }

fn leads_with_one(xs: List<Option<Int>>) -> Int =
  match xs { [Some(1), ..] -> 1, _ -> 0 }

fn inner(o: Option<{a: Option<Int>}>) -> Int =
  match o { Some({a: Some(n)}) -> n, _ -> 0 }

fn paired(p: (Option<Int>, Bool)) -> Int =
  match p { (Some(1), true) -> 1, _ -> 0 }

test "an inner constructor is read only once the outer one matched" {
  assert_eq(settled(Ok(Some(true))), 1);
  assert_eq(settled(Ok(Some(false))), 2);
  assert_eq(settled(Ok(None)), 3);
  assert_eq(settled(Err(Warm)), 4);
  assert_eq(settled(Err(Cool)), 5)
}

test "a wildcard after a nested arm takes what the outer constructor refused" {
  assert_eq(first_true(Ok(Some(true))), 1);
  assert_eq(first_true(Ok(Some(false))), 0);
  assert_eq(first_true(Ok(None)), 0);
  assert_eq(first_true(Err(Cool)), 0)
}

test "an element is tested only once the list is long enough" {
  assert_eq(leads_with_one([Some(1), None]), 1);
  assert_eq(leads_with_one([Some(2)]), 0);
  assert_eq(leads_with_one([None]), 0);
  assert_eq(leads_with_one([]), 0)
}

test "a field is tested only once its record was reached" {
  assert_eq(inner(Some({a: Some(4)})), 4);
  assert_eq(inner(Some({a: None})), 0);
  assert_eq(inner(None), 0);
  assert_eq(paired((Some(1), true)), 1);
  assert_eq(paired((None, true)), 0);
  assert_eq(paired((Some(1), false)), 0)
}
