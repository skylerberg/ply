type Token = | TEof | TNumber(Int) | TName(Bytes)

fn code(t: Token) -> Int = match t { TEof -> 0, TNumber(n) -> n, TName(b) -> b.len() }

test "a constructor declared in a program is built and matched like a constructor from the standard prelude" {
  assert_eq(code(TNumber(7)), 7);
  assert_eq(code(TEof), 0);
  assert_eq(code(TName(b"abcd")), 4)
}
