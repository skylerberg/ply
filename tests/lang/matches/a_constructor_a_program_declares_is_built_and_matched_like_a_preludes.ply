type Tok = | TEof | TNumber(Int) | TName(Bytes)

fn code(t: Tok) -> Int = match t { TEof -> 0, TNumber(n) -> n, TName(b) -> b.len() }

test "a constructor a program declares is built and matched like a prelude's" {
  assert_eq(code(TNumber(7)), 7);
  assert_eq(code(TEof), 0);
  assert_eq(code(TName(b"abcd")), 4)
}
