fn word(s: String) -> Int = match s { "one" -> 1, "two" -> 2, "" -> 3, _ -> 0 }

fn tag(b: Bytes) -> Int = match b { b"ab" -> 1, b"\x00" -> 2, b"" -> 3, _ -> 0 }

fn half(f: Float) -> Int = match f { 0.5 -> 1, -1.5 -> 2, _ -> 0 }

fn price(d: Decimal) -> Int = match d { 1.50m -> 1, -0.25m -> 2, _ -> 0 }

fn flag(b: Bool) -> Int = match b { true -> 1, false -> 0 }

fn only_unit(u: Unit) -> Int = match u { () -> 1 }

fn small(n: U8) -> Int = match n { 255u8 -> 1, 0u8 -> 2, _ -> 0 }

fn signed(n: I8) -> Int = match n { -1i8 -> 1, 127i8 -> 2, _ -> 0 }

fn wide(n: U64) -> Int = match n { 0xFFFF_FFFF_FFFF_FFFFu64 -> 1, 7u64 -> 2, _ -> 0 }

fn wide_signed(n: I64) -> Int = match n { 9223372036854775807i64 -> 1, -5i64 -> 2, _ -> 0 }

fn big(n: Int) -> Int =
  match n {
    4611686018427387904 -> 1,
    -4611686018427387905 -> 2,
    9223372036854775807 -> 3,
    4 -> 4,
    _ -> 0,
  }

fn nested(p: (Option<String>, Unit)) -> Int =
  match p { (Some("x"), ()) -> 1, (None, ()) -> 2, _ -> 0 }

test "text literals" {
  assert_eq(word("one"), 1);
  assert_eq(word("two"), 2);
  assert_eq(word(""), 3);
  assert_eq(word("three"), 0);
  assert_eq(tag(b"ab"), 1);
  assert_eq(tag(b"\x00"), 2);
  assert_eq(tag(b""), 3);
  assert_eq(tag(b"a"), 0)
}

test "float and decimal literals compare as `==` does" {
  assert_eq(half(0.5), 1);
  assert_eq(half(-1.5), 2);
  assert_eq(half(1.5), 0);
  assert_eq(price(1.5m), 1);
  assert_eq(price(-0.25m), 2);
  assert_eq(price(0.25m), 0)
}

test "bool and unit literals" {
  assert_eq(flag(true), 1);
  assert_eq(flag(false), 0);
  assert_eq(only_unit(()), 1)
}

test "fixed-width literals at every width" {
  assert_eq(small(255u8), 1);
  assert_eq(small(0u8), 2);
  assert_eq(small(9u8), 0);
  assert_eq(signed(-1i8), 1);
  assert_eq(signed(127i8), 2);
  assert_eq(signed(0i8), 0);
  assert_eq(wide(0xFFFF_FFFF_FFFF_FFFFu64), 1);
  assert_eq(wide(7u64), 2);
  assert_eq(wide(8u64), 0);
  assert_eq(wide_signed(9223372036854775807i64), 1);
  assert_eq(wide_signed(-5i64), 2);
  assert_eq(wide_signed(5i64), 0)
}

test "an Int literal too wide for an immediate" {
  assert_eq(big(4611686018427387904), 1);
  assert_eq(big(-4611686018427387905), 2);
  assert_eq(big(9223372036854775807), 3);
  assert_eq(big(4), 4);
  assert_eq(big(4611686018427387903), 0)
}

test "literals inside a tuple" {
  assert_eq(nested((Some("x"), ())), 1);
  assert_eq(nested((None, ())), 2);
  assert_eq(nested((Some("y"), ())), 0)
}
