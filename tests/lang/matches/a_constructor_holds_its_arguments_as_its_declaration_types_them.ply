import std.show (show)

type Point = { x: Float, y: Float }

type Shape = | Circle(Point, Float) | Labelled(String, Point) | Tally(U64, I64) | Dot(Float) | Blank

type Stamp = | At({ day: Int, hour: Int }, U64)

fn circle(at: Point, r: Float) -> Shape = Circle(at, r)

fn area(s: Shape) -> Float =
  match s {
    Circle(_, r) -> 3.0 * r * r,
    Labelled(_, p) -> p.x * p.y,
    Tally(_, _) -> 0.0,
    Dot(_) -> 0.0,
    Blank -> 0.0,
  }

fn centre(s: Shape) -> Option<Point> =
  match s { Circle(p, _) -> Some(p), Labelled(_, p) -> Some(p), _ -> None }

fn unit(s: Shape) -> Bool = match s { Circle(_, 1.0) -> true, _ -> false }

fn grown(s: Shape, by: Float) -> Shape =
  match s { Circle(p, r) -> Circle({ ..p, x: p.x + by }, r + by), other -> other }

fn first<a>(xs: List<a>) -> Option<a> = match xs { [x, ..] -> Some(x), [] -> None }

test "a constructor's arguments read back as they went in" {
  let c = circle({ x: 1.0, y: 2.0 }, 0.5);
  assert_eq(area(c), 0.75);
  assert_eq(centre(c), Some({ x: 1.0, y: 2.0 }));
  assert_eq(area(Labelled("l", { x: 2.0, y: 3.0 })), 6.0);
  assert_eq(centre(Blank), None);
  match Tally(0xFFFF_FFFF_FFFF_FFFFu64, -5i64) {
    Tally(n, m) -> {
      assert_eq(n, 0xFFFF_FFFF_FFFF_FFFFu64);
      assert_eq(m, -5i64)
    },
    _ -> panic("a tally"),
  }
}

test "a literal pattern matches a `Float` constructor argument by its value" {
  assert(unit(circle({ x: 0.0, y: 0.0 }, 1.0)));
  assert(!unit(circle({ x: 0.0, y: 0.0 }, 1.5)))
}

test "building a new constructor value from another's arguments does not change the original value" {
  let c = circle({ x: 1.0, y: 1.0 }, 1.0);
  let g = grown(c, 2.0);
  assert_eq(g, Circle({ x: 3.0, y: 1.0 }, 3.0));
  assert_eq(c, Circle({ x: 1.0, y: 1.0 }, 1.0));
  assert_eq(grown(Blank, 1.0), Blank)
}

test "a constructor passed as a function, or used in generic code, builds the same value as a direct call" {
  let dots = [0.5, 1.5].map(Dot);
  assert_eq(first(dots), Some(Dot(0.5)));
  assert_eq(dots, [Dot(0.5), Dot(1.5)]);
  let tallies = [1u64, 2u64].map(|n: U64| Tally(n, -1i64));
  assert_eq(first(tallies), Some(Tally(1u64, -1i64)))
}

test "a constructor with record and `u64` arguments can be compared, used as a map key and shown as text" {
  let early = At({ day: 1, hour: 9 }, 7u64);
  let late = At({ day: 1, hour: 9 }, 0xFFFF_FFFF_FFFF_FFFFu64);
  assert_eq(compare(early, late), Less);
  assert(early == At({ day: 1, hour: 9 }, 7u64));
  let by_stamp = Map::new().insert(late, "late").insert(early, "early");
  assert_eq(by_stamp.first(), Some({ key: early, value: "early" }));
  assert_eq(by_stamp.get(At({ day: 1, hour: 9 }, 0xFFFF_FFFF_FFFF_FFFFu64)), Some("late"));
  assert_eq(show(circle({ x: 0.5, y: 1.0 }, 2.0)), show(Circle({ x: 0.5, y: 1.0 }, 2.0)));
  assert_eq(show(early), "At({day: 1, hour: 9}, 7)")
}
