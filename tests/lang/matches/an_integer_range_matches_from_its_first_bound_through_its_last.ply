fn digit(c: Int) -> Int = match c { b'0'..=b'9' -> c - b'0', _ -> -1 }

fn class(c: Int) -> String =
  match c {
    b'"' -> "quote",
    b'-' | b'0'..=b'9' -> "number",
    b'a'..=b'z' | b'A'..=b'Z' | b'_' -> "name",
    b' ' | b'\t' | b'\n' | b'\r' -> "space",
    _ -> "other",
  }

fn sign(n: Int) -> Int = match n { -9223372036854775807..=-1 -> -1, 0 -> 0, _ -> 1 }

fn far(n: Int) -> Int =
  match n { 4611686018427387904..=9223372036854775807 -> 1, -5..=5 -> 2, _ -> 0 }

fn half(b: U8) -> Int = match b { 0u8..=127u8 -> 0, 128u8..=255u8 -> 1 }

fn cold(t: I8) -> Bool = match t { -127i8..=-1i8 -> true, 0i8..=127i8 -> false, _ -> true }

fn port(p: U16) -> String =
  match p {
    0u16 -> "none",
    1u16..=1023u16 -> "system",
    1024u16..=49151u16 -> "user",
    _ -> "dynamic",
  }

fn high(n: U64) -> Int =
  match n { 0u64..=9u64 -> 1, 0x8000_0000_0000_0000u64..=0xFFFF_FFFF_FFFF_FFFFu64 -> 2, _ -> 0 }

fn low(n: I64) -> Int = match n { -10i64..=-1i64 -> 1, 0i64..=10i64 -> 2, _ -> 0 }

fn huge(n: U128) -> Int = match n { 1u128..=18446744073709551616u128 -> 1, _ -> 0 }

fn first(xs: List<Int>) -> Int = match xs { [0..=9, ..] -> 1, [_, 10..=19] -> 2, _ -> 0 }

fn held(o: Option<Int>) -> Int = match o { Some(1..=3) -> 1, Some(_) -> 2, None -> 3 }

fn guarded(n: Int, even: Bool) -> Int = match n { 0..=9 if even -> 1, 0..=99 -> 2, _ -> 0 }

fn small(n: Int) -> Int = {
  let 0..=9 = n else { -1 };
  n
}

test "a range holds both its bounds and everything between" {
  assert_eq(digit(b'0'), 0);
  assert_eq(digit(b'9'), 9);
  assert_eq(digit(b'5'), 5);
  assert_eq(digit(b'0' - 1), -1);
  assert_eq(digit(b'9' + 1), -1)
}

test "a range stands among the alternatives of an or-pattern" {
  assert_eq(class(b'"'), "quote");
  assert_eq(class(b'-'), "number");
  assert_eq(class(b'7'), "number");
  assert_eq(class(b'q'), "name");
  assert_eq(class(b'Q'), "name");
  assert_eq(class(b'_'), "name");
  assert_eq(class(b' '), "space");
  assert_eq(class(b'\n'), "space");
  assert_eq(class(b'{'), "other")
}

test "an Int range reaches past the immediate words on either side" {
  assert_eq(sign(-9223372036854775807), -1);
  assert_eq(sign(-1), -1);
  assert_eq(sign(0), 0);
  assert_eq(sign(9223372036854775807), 1);
  assert_eq(far(9223372036854775807), 1);
  assert_eq(far(4611686018427387904), 1);
  assert_eq(far(4611686018427387903), 0);
  assert_eq(far(-5), 2);
  assert_eq(far(6), 0)
}

test "ranges that cover a width exhaust it without a wildcard" {
  assert_eq(half(0u8), 0);
  assert_eq(half(127u8), 0);
  assert_eq(half(128u8), 1);
  assert_eq(half(255u8), 1);
  assert(cold(-127i8));
  assert(cold(i8_of_int(-128)));
  assert(!cold(0i8));
  assert(!cold(127i8));
  assert_eq(port(0u16), "none");
  assert_eq(port(443u16), "system");
  assert_eq(port(8080u16), "user");
  assert_eq(port(65535u16), "dynamic")
}

test "a range over a width past 32 bits is ordered as the width is" {
  assert_eq(high(9u64), 1);
  assert_eq(high(10u64), 0);
  assert_eq(high(0x7FFF_FFFF_FFFF_FFFFu64), 0);
  assert_eq(high(0x8000_0000_0000_0000u64), 2);
  assert_eq(high(0xFFFF_FFFF_FFFF_FFFFu64), 2);
  assert_eq(low(-10i64), 1);
  assert_eq(low(10i64), 2);
  assert_eq(low(11i64), 0);
  assert_eq(huge(0u128), 0);
  assert_eq(huge(18446744073709551616u128), 1);
  assert_eq(huge(18446744073709551617u128), 0)
}

test "a range nests where any pattern does, and takes a guard" {
  assert_eq(first([3]), 1);
  assert_eq(first([30, 12]), 2);
  assert_eq(first([30, 22]), 0);
  assert_eq(held(Some(3)), 1);
  assert_eq(held(Some(4)), 2);
  assert_eq(held(None), 3);
  assert_eq(guarded(4, true), 1);
  assert_eq(guarded(4, false), 2);
  assert_eq(guarded(100, true), 0);
  assert_eq(small(7), 7);
  assert_eq(small(10), -1)
}
