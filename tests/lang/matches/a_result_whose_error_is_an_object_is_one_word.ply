//! A `Result` whose error is always an object is one word in the code that knows it: its `Ok`'s
//! argument's word, or its `Err`'s object's address with the low bits `100`. Built, returned,
//! handed on by `?` and matched it is that word; stored, compared or handed to generic code it is
//! the object it stands for.

type ParseError = { reason: String, at: Int }

fn half(n: Int) -> Result<Int, ParseError> =
  if n % 2 == 0 { Ok(n / 2) } else { Err({ reason: "odd", at: n }) }

fn halved(n: Int, times: Int) -> Result<Int, ParseError> =
  if times <= 0 { Ok(n) } else {
    let h = half(n)?;
    halved(h, times - 1)
  }

fn describe(r: Result<Int, ParseError>) -> String =
  match r { Ok(n) -> n.to_string(), Err(b) -> b.reason }

fn identity<a>(x: a) -> a = x

fn plain(n: Int) -> Result<Int, Int> = if n > 0 { Ok(n) } else { Err(n) }

test "a result held as one word returns, matches and leaves as the object it stands for" {
  assert_eq(halved(8, 3), Ok(1));
  assert_eq(halved(12, 3), Err({ reason: "odd", at: 3 }));
  assert_eq(describe(halved(12, 3)), "odd");
  assert_eq(describe(half(4)), "2");
  assert_eq(identity(half(3)), Err({ reason: "odd", at: 3 }));
  assert_eq([half(2), half(3)], [Ok(1), Err({ reason: "odd", at: 3 })]);
  assert(half(2) != half(4), None);
  assert_eq(plain(-1), Err(-1));
  assert_eq(match try[abort.raise] { halved(8, 3) } { Ok(r) -> r, Err(_) -> Ok(0) }, Ok(1))
}

test "a lambda builds and matches a result as its own code does" {
  let bump = |r: Result<Int, ParseError>| match r { Ok(n) -> Ok(n + 1), Err(b) -> Err(b) };
  assert_eq(bump(half(4)), Ok(3));
  assert_eq(bump(half(3)), Err({ reason: "odd", at: 3 }));
  assert(bump(half(2)) == Ok(2), None)
}
