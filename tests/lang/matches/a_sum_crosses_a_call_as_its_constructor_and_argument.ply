//! An `Option` or a `Result` one of whose arguments is a small record crosses a call, and a call
//! of a function value of known type, as its constructor and that record's fields, however the
//! callee's arms join, and a closure made where its type was not known answers the same through
//! the runtime.

type Taken = { value: Int, at: Int }

type Failed = { at: Int, why: String }

fn digit(s: Bytes, at: Int) -> Result<Taken, Failed> / {abort.raise} =
  if at >= s.len() { Err({ at: at, why: "the end" }) } else {
    let b = s.at(at);
    if b >= 48 && b <= 57 { Ok({ value: b - 48, at: at + 1 }) }
    else { Err({ at: at, why: "not a digit" }) }
  }

/// A number read a digit at a time, each digit's sum matched where it comes back.
fn number(s: Bytes, at: Int, acc: Int) -> Result<Taken, Failed> / {abort.raise, diverges} =
  match digit(s, at) {
    Err(e) -> if e.at > 0 && e.at == at { Ok({ value: acc, at: at }) } else { Err(e) },
    Ok(t) -> number(s, t.at, acc * 10 + t.value),
  }

fn counted(s: Bytes, at: Int, n: Int) -> Int / {abort.raise, diverges} =
  match digit(s, at) { Err(_) -> n, Ok(t) -> counted(s, t.at, n + 1) }

/// The first `x` at or past `at`, and where it stands.
fn found(xs: List<Int>, x: Int, at: Int) -> Option<Taken> / {diverges} =
  if at >= xs.len() { None }
  else if xs.at(at) == Some(x) { Some({ value: x, at: at }) }
  else { found(xs, x, at + 1) }

fn sevens(xs: List<Int>, at: Int, n: Int) -> Int / {diverges} =
  match found(xs, 7, at) { None -> n, Some(t) -> sevens(xs, t.at + 1, n + 1) }

/// A sum a `let` binds is made where it comes back, and read after another call.
fn later(s: Bytes) -> Int / {abort.raise} = {
  let first = digit(s, 0);
  let second = digit(s, 1);
  match first {
    Ok(t) -> t.value * 10 + (match second { Ok(u) -> u.value, Err(_) -> 0 }),
    Err(e) -> 0 - e.at,
  }
}

/// A generic definition's `Result`, whose `Ok` crosses as a word, answered where the caller's crosses
/// as its record's fields.
fn failing<a>(at: Int) -> Result<a, Failed> = Err({ at: at, why: "short" })

fn guarded(s: Bytes, at: Int) -> Result<Taken, Failed> / {abort.raise} =
  if at >= s.len() { failing(at) } else { digit(s, at) }

/// Such a sum met on each pass of a loop, tested and matched.
fn looped(xs: List<Int>, n: Int) -> Int / {diverges} =
  range(0, n).fold(0, |acc: Int, i: Int|
    if found(xs, 7, i) == None { acc }
    else { match found(xs, 7, i) { Some(t) -> acc + t.at, None -> acc } })

/// A generic definition handed such a sum as its type argument's value, whatever crosses it.
fn kept<a>(x: a, n: Int) -> a / {diverges} = if n <= 0 { x } else { kept(x, n - 1) }

type Reader = { read: (Bytes, Int) -> Result<Taken, Failed> / {abort.raise} }

fn reader() -> Reader = { read: |s: Bytes, at: Int| digit(s, at) }

fn counted_by(r: Reader, s: Bytes, at: Int, n: Int) -> Int / {abort.raise, diverges} =
  match (r.read)(s, at) { Err(_) -> n, Ok(t) -> counted_by(r, s, t.at, n + 1) }

/// A closure made where `a` is not known, called where it is.
fn passed<a>(f: keep (Bytes, Int) -> a / {abort.raise}) -> (Bytes, Int) -> a / {abort.raise} =
  |s: Bytes, at: Int| f(s, at)

fn generic() -> Reader = { read: passed(|s: Bytes, at: Int| digit(s, at)) }

type Noted = { name: String, held: Option<Taken> }

type Side = | Left(Noted) | Right(Noted)

/// A parameter's sum each arm makes a word of, on its own path.
fn noted(side: Side, held: Option<Taken>) -> Side =
  match side { Left(n) -> Left({ ..n, held: held }), Right(n) -> Right({ ..n, held: held }) }

fn chosen(first: Bool, held: Option<Taken>) -> List<Option<Taken>> =
  if first { [held] } else { [None, held] }

fn spaced(n: Int) -> List<Int> = range(0, n).map(|i: Int| if i % 3 == 0 { 7 } else { 1 })

test "a sum crossing a call answers what it always did" {
  assert_eq(number(b"1234x", 0, 0), Ok({ value: 1234, at: 4 }));
  assert_eq(number(b"x", 0, 0), Err({ at: 0, why: "not a digit" }));
  assert_eq(digit(b"", 0), Err({ at: 0, why: "the end" }));
  assert_eq(counted(b"12345", 0, 0), 5);
  assert_eq(later(b"42"), 42);
  assert_eq(later(b"4"), 40);
  assert_eq(later(b"x"), 0);
  assert_eq(kept(found([7], 7, 0), 3), Some({ value: 7, at: 0 }));
  assert_eq(looped([7, 1, 7], 3), 4);
  assert_eq(guarded(b"", 0), Err({ at: 0, why: "short" }));
  assert_eq(guarded(b"4", 0), Ok({ value: 4, at: 1 }));
  assert_eq(match guarded(b"", 2) { Err(e) -> e.at, Ok(t) -> t.value }, 2);
  assert_eq(kept(digit(b"5", 0), 3), Ok({ value: 5, at: 1 }));
  assert_eq(found([1, 7, 3], 7, 0), Some({ value: 7, at: 1 }));
  assert_eq(found([1, 2], 7, 0), None);
  assert_eq(sevens(spaced(10), 0, 0), 4);
  assert_eq(counted_by(reader(), b"123", 0, 0), 3);
  assert_eq(counted_by(generic(), b"123", 0, 0), 3);
  assert_eq(generic().read(b"9", 0), Ok({ value: 9, at: 1 }));
  let t = Some({ value: 3, at: 4 });
  assert_eq(noted(Left({ name: "l", held: None }), t), Left({ name: "l", held: t }));
  assert_eq(noted(Right({ name: "r", held: None }), t), Right({ name: "r", held: t }));
  assert_eq(chosen(true, t), [t]);
  assert_eq(chosen(false, t), [None, t])
}
