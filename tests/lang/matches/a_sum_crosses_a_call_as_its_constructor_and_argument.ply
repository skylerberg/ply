type ParseResult = { value: Int, at: Int }

type ParseError = { at: Int, reason: String }

fn digit(s: Bytes, at: Int) -> Result<ParseResult, ParseError> / {abort.raise} =
  if at >= s.len() { Err({ at: at, reason: "the end" }) } else {
    let b = s.at(at);
    if b >= 48 && b <= 57 { Ok({ value: b - 48, at: at + 1 }) }
    else { Err({ at: at, reason: "not a digit" }) }
  }

fn number(
  s: Bytes,
  at: Int,
  accumulator: Int,
) -> Result<ParseResult, ParseError> / {abort.raise, diverges} =
  match digit(s, at) {
    Err(e) -> if e.at > 0 && e.at == at { Ok({ value: accumulator, at: at }) } else { Err(e) },
    Ok(t) -> number(s, t.at, accumulator * 10 + t.value),
  }

fn counted(s: Bytes, at: Int, n: Int) -> Int / {abort.raise, diverges} =
  match digit(s, at) { Err(_) -> n, Ok(t) -> counted(s, t.at, n + 1) }

fn found(xs: List<Int>, x: Int, at: Int) -> Option<ParseResult> / {diverges} =
  if at >= xs.len() { None }
  else if xs.at(at) == Some(x) { Some({ value: x, at: at }) }
  else { found(xs, x, at + 1) }

fn sevens(xs: List<Int>, at: Int, n: Int) -> Int / {diverges} =
  match found(xs, 7, at) { None -> n, Some(t) -> sevens(xs, t.at + 1, n + 1) }

fn later(s: Bytes) -> Int / {abort.raise} = {
  let first = digit(s, 0);
  let second = digit(s, 1);
  match first {
    Ok(t) -> t.value * 10 + (match second { Ok(u) -> u.value, Err(_) -> 0 }),
    Err(e) -> 0 - e.at,
  }
}

fn failing<a>(at: Int) -> Result<a, ParseError> = Err({ at: at, reason: "short" })

fn guarded(s: Bytes, at: Int) -> Result<ParseResult, ParseError> / {abort.raise} =
  if at >= s.len() { failing(at) } else { digit(s, at) }

fn looped(xs: List<Int>, n: Int) -> Int / {diverges} =
  range(0, n).fold(0, |accumulator: Int, i: Int|
    if found(xs, 7, i) == None { accumulator }
    else { match found(xs, 7, i) { Some(t) -> accumulator + t.at, None -> accumulator } })

fn repeat_identity<a>(x: a, n: Int) -> a / {diverges} =
  if n <= 0 { x } else { repeat_identity(x, n - 1) }

type Reader = { read: (Bytes, Int) -> Result<ParseResult, ParseError> / {abort.raise} }

fn reader() -> Reader = { read: |s: Bytes, at: Int| digit(s, at) }

fn counted_by(r: Reader, s: Bytes, at: Int, n: Int) -> Int / {abort.raise, diverges} =
  match (r.read)(s, at) { Err(_) -> n, Ok(t) -> counted_by(r, s, t.at, n + 1) }

fn wrapped<a>(f: keep (Bytes, Int) -> a / {abort.raise}) -> (Bytes, Int) -> a / {abort.raise} =
  |s: Bytes, at: Int| f(s, at)

fn generic() -> Reader = { read: wrapped(|s: Bytes, at: Int| digit(s, at)) }

type Noted = { name: String, parsed: Option<ParseResult> }

type Side = | Left(Noted) | Right(Noted)

fn with_result(side: Side, parsed: Option<ParseResult>) -> Side =
  match side {
    Left(n) -> Left({ ..n, parsed: parsed }),
    Right(n) -> Right({ ..n, parsed: parsed }),
  }

fn chosen(first: Bool, parsed: Option<ParseResult>) -> List<Option<ParseResult>> =
  if first { [parsed] } else { [None, parsed] }

fn spaced(n: Int) -> List<Int> = range(0, n).map(|i: Int| if i % 3 == 0 { 7 } else { 1 })

test "a sum type passed through function calls and loops still returns the correct values" {
  assert_eq(number(b"1234x", 0, 0), Ok({ value: 1234, at: 4 }));
  assert_eq(number(b"x", 0, 0), Err({ at: 0, reason: "not a digit" }));
  assert_eq(digit(b"", 0), Err({ at: 0, reason: "the end" }));
  assert_eq(counted(b"12345", 0, 0), 5);
  assert_eq(later(b"42"), 42);
  assert_eq(later(b"4"), 40);
  assert_eq(later(b"x"), 0);
  assert_eq(repeat_identity(found([7], 7, 0), 3), Some({ value: 7, at: 0 }));
  assert_eq(looped([7, 1, 7], 3), 4);
  assert_eq(guarded(b"", 0), Err({ at: 0, reason: "short" }));
  assert_eq(guarded(b"4", 0), Ok({ value: 4, at: 1 }));
  assert_eq(match guarded(b"", 2) { Err(e) -> e.at, Ok(t) -> t.value }, 2);
  assert_eq(repeat_identity(digit(b"5", 0), 3), Ok({ value: 5, at: 1 }));
  assert_eq(found([1, 7, 3], 7, 0), Some({ value: 7, at: 1 }));
  assert_eq(found([1, 2], 7, 0), None);
  assert_eq(sevens(spaced(10), 0, 0), 4);
  assert_eq(counted_by(reader(), b"123", 0, 0), 3);
  assert_eq(counted_by(generic(), b"123", 0, 0), 3);
  assert_eq(generic().read(b"9", 0), Ok({ value: 9, at: 1 }));
  let t = Some({ value: 3, at: 4 });
  assert_eq(with_result(Left({ name: "l", parsed: None }), t), Left({ name: "l", parsed: t }));
  assert_eq(with_result(Right({ name: "r", parsed: None }), t), Right({ name: "r", parsed: t }));
  assert_eq(chosen(true, t), [t]);
  assert_eq(chosen(false, t), [None, t])
}
