fn divmod(a: Int, b: Int) -> (Int, Int) / {abort.raise} = (a / b, a % b)

fn swap(p: (Int, Bool)) -> (Bool, Int) = match p { (n, flag) -> (flag, n) }

test "a tuple can be built, destructured, read by field such as `_1`, and equals a record with fields `_0` and `_1`" {
  let (q, r) = divmod(17, 5);
  assert_eq(q, 3);
  assert_eq(r, 2);
  assert_eq(swap((1, true)), (true, 1));
  assert_eq(divmod(9, 2)._1, 1);
  assert_eq(divmod(9, 2), { _0: 4, _1: 1 })
}

test "a list of tuples can be built and its length converted to a string" {
  assert_eq([(1, 2), (3, 4)].len().to_string(), "2")
}
