type Shape = | Dot | Line(Int)

fn returned<a>(x: a) -> a = observe(x)

test "`observe` returns a value equal to the one passed in, for every kind of value" {
  assert_eq(observe(7), 7);
  assert_eq(observe(-1i8), -1i8);
  assert_eq(
    observe(340282366920938463463374607431768211455u128),
    340282366920938463463374607431768211455u128,
  );
  assert_eq(Decimal::scale(observe(1.50m)), 2);
  assert_eq(observe(2.5), 2.5);
  assert_eq(observe(()), ());
  assert_eq(observe({ a: 1, b: "x" }), { a: 1, b: "x" });
  assert_eq(returned([Dot, Line(2)]), [Dot, Line(2)]);
  assert_eq(observe(|n: Int| n + 1)(2), 3)
}

test "`observe` on a list of 100 `Line` values returns a list that still has 100 elements" {
  assert_eq(observe(range(0, 100).map(Line)).len(), 100)
}
