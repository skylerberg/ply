type Reading = { at: Int, ok: Bool }

type Point = new { x: Int, y: Int }

type Tagged = { at: Point, tag: Option<String> }

fn point(x: Int, y: Int) -> Point = { x: x, y: y }

fn order<a>(x: a, y: a) -> Ordering
  where derivable(ord, a)
= compare(x, y)

test "`compare` orders `false` before `true` and returns `Equal` for equal bools and for unit" {
  assert_eq(compare(false, true), Less);
  assert_eq(compare(true, true), Equal);
  assert_eq(compare((), ()), Equal)
}

test "a record of bools orders field by field" {
  let a: Reading = { at: 1, ok: true };
  let b: Reading = { at: 1, ok: false };
  assert_eq(compare(a, b), Greater);
  assert_eq(compare(b, { at: 2, ok: false }), Less)
}

test "`compare` on a record orders its option, result and nested record fields by those types' own order" {
  let ok: Result<Int, String> = Ok(1);
  let err: Result<Int, String> = Err("x");
  let tagged: Tagged = { at: point(0, 0), tag: None };
  assert_eq(compare({ a: Some(1), b: 2 }, { a: None, b: 3 }), Greater);
  assert_eq(compare({ a: Some(1), b: 2 }, { a: Some(1), b: 3 }), Less);
  assert_eq(compare({ a: Some("b"), b: 0 }, { a: Some("a"), b: 9 }), Greater);
  assert_eq(compare({ r: ok }, { r: err }), Greater);
  assert_eq(compare({ r: err, s: 1 }, { r: err, s: 0 }), Greater);
  assert_eq(compare({ p: { x: 1, y: 2 }, q: 0 }, { p: { x: 1, y: 3 }, q: -5 }), Less);
  assert_eq(compare({ n: point(2, 0) }, { n: point(1, 9) }), Greater);
  assert_eq(compare([{ p: { x: 1 } }], [{ p: { x: 0 } }]), Greater);
  assert_eq(compare({ t: tagged }, { t: { ..tagged, tag: Some("") } }), Less);
  assert_eq(compare({ xs: [Some(1)], o: Some([2]) }, { xs: [Some(1)], o: Some([1, 5]) }), Greater);
  assert_eq(order({ a: Some(1), r: { k: "z" } }, { a: Some(1), r: { k: "y" } }), Greater);
  assert_eq(
    compare({ deep: { deeper: { v: Some(Ok(3)) } } }, { deep: { deeper: { v: Some(Ok(4)) } } }),
    Less,
  )
}

test "`compare` orders `Err` before `Ok` and compares the contained values within each" {
  let good: Result<List<Int>, String> = Ok([1, 2]);
  let bad: Result<List<Int>, String> = Err("no");
  assert_eq(compare(bad, good), Less);
  assert_eq(compare(good, Ok([1, 3])), Less);
  assert_eq(compare(Err("a"), bad), Less);
  assert(good == Ok([1, 2]));
  assert(good != Ok([2]));
  assert(bad == Err("no"));
  assert(bad != good)
}
