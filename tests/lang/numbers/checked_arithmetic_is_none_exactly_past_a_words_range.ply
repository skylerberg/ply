fn int_row(a: Int, b: Int) -> List<Option<Int>> =
  [checked_add(a, b), checked_sub(a, b), checked_mul(a, b), checked_neg(a)]

fn u64_row(a: U64, b: U64) -> List<Option<U64>> =
  [checked_add(a, b), checked_sub(a, b), checked_mul(a, b), checked_neg(a)]

fn i64_row(a: I64, b: I64) -> List<Option<I64>> =
  [checked_add(a, b), checked_sub(a, b), checked_mul(a, b), checked_neg(a)]

test "an Int's checked arithmetic is None exactly past its range" {
  let max = 9223372036854775807;
  let min = -9223372036854775807 - 1;
  assert_eq(int_row(max, 1), [None, Some(max - 1), Some(max), Some(-max)]);
  assert_eq(int_row(min, -1), [None, Some(min + 1), None, None]);
  assert_eq(int_row(3037000500, 3037000500), [Some(6074001000), Some(0), None, Some(-3037000500)]);
  assert_eq(int_row(3037000499, 3037000499), [
    Some(6074000998),
    Some(0),
    Some(9223372030926249001),
    Some(-3037000499),
  ])
}

test "an unsigned 64-bit width's checked arithmetic is None exactly past its range" {
  let top = 18446744073709551615u64;
  assert_eq(u64_row(top, 1u64), [None, Some(18446744073709551614u64), Some(top), None]);
  assert_eq(u64_row(0u64, 1u64), [Some(1u64), None, Some(0u64), Some(0u64)]);
  assert_eq(u64_row(4294967296u64, 4294967296u64), [Some(8589934592u64), Some(0u64), None, None]);
  assert_eq(u64_row(4294967296u64, 4294967295u64), [
    Some(8589934591u64),
    Some(1u64),
    Some(18446744069414584320u64),
    None,
  ])
}

test "a signed 64-bit width's checked arithmetic is None exactly past its range" {
  let max = 9223372036854775807i64;
  let min = -9223372036854775807i64 - 1i64;
  assert_eq(i64_row(max, 1i64), [None, Some(max - 1i64), Some(max), Some(-max)]);
  assert_eq(i64_row(min, 1i64), [Some(min + 1i64), None, Some(min), None]);
  assert_eq(i64_row(min, -1i64), [None, Some(min + 1i64), None, None])
}
