fn mode(pick: Int) -> Rounding =
  match pick { 0 -> HalfEven, 1 -> HalfUp, 2 -> Down, 3 -> Up, 4 -> Ceiling, _ -> Floor }

fn quotient(a: String, b: String, places: Int, pick: Int) -> String / {abort.raise} =
  match ((Decimal::of_string(a), Decimal::of_string(b))) {
    (Some(x), Some(y)) -> x.div(y, places, mode(pick)).to_string(),
    _ -> "",
  }

fn rounded(d: String, places: Int, pick: Int) -> String / {abort.raise} =
  match Decimal::of_string(d) { Some(x) -> x.round(places, mode(pick)).to_string(), None -> "" }

fn caught<a>(f: () -> a / {abort.raise}) -> Result<a, String> =
  handle { f() } with { abort.raise(m) -> Err(m), return v -> Ok(v) }

fn largest_decimal_text() -> String = "79228162514264337593543950335"

test "a quotient has the scale asked for, rounded once by the mode given" {
  assert_eq(caught(|| quotient("3", "2", 3, 0)), Ok("1.500"));
  assert_eq(caught(|| quotient("100", "100", 2, 2)), Ok("1.00"));
  assert_eq(caught(|| quotient("-1", "3", 2, 5)), Ok("-0.34"));
  assert_eq(caught(|| quotient("2", "3", 28, 2)), Ok("0.6666666666666666666666666666"));
  assert_eq(caught(|| quotient("2", "3", 28, 0)), Ok("0.6666666666666666666666666667"));
  assert_eq(caught(|| quotient("4.9999999999999999999999999995", "10", 0, 1)), Ok("0"));
  assert_eq(
    caught(|| quotient(largest_decimal_text(), "1", 1, 2)),
    Err("`Decimal` overflow in division"),
  );
  assert_eq(caught(|| quotient("1", "0.1", 28, 2)), Err("`Decimal` overflow in division"))
}

test "a quotient's sign and the rounding mode decide which way it rounds at the last decimal place" {
  assert_eq(
    [
      ("1", "3", 3, 0),
      ("3.00", "2", 0, 0),
      ("0", "7", 2, 3),
      ("-1", "3", 2, 4),
      ("1", "-3", 2, 3),
      ("-1", "-3", 2, 2),
      ("-1", "300", 2, 0),
      ("1", "3", 28, 3),
      (largest_decimal_text(), "3", 0, 2),
      (largest_decimal_text(), "1", 0, 3),
      ("55459713759985036315480765235", "7", 1, 2),
    ].map(|c: (String, String, Int, Int)| caught(|| quotient(c._0, c._1, c._2, c._3))),
    [
      Ok("0.333"),
      Ok("2"),
      Ok("0.00"),
      Ok("-0.33"),
      Ok("-0.34"),
      Ok("0.33"),
      Ok("0.00"),
      Ok("0.3333333333333333333333333334"),
      Ok("26409387504754779197847983445"),
      Ok(largest_decimal_text()),
      Ok("7922816251426433759354395033.5"),
    ],
  );
  assert_eq(
    [(largest_decimal_text(), "0.5", 0, 2), ("55459713759985036315480765235", "7", 1, 3)].map(
      |c: (String, String, Int, Int)| caught(|| quotient(c._0, c._1, c._2, c._3)),
    ),
    [Err("`Decimal` overflow in division"), Err("`Decimal` overflow in division")],
  )
}

test "rounding gives the requested scale, and fails with an overflow error when the result does not fit in a decimal" {
  assert_eq(caught(|| rounded("1.5", 3, 0)), Ok("1.500"));
  assert_eq(caught(|| rounded("1.50", 1, 0)), Ok("1.5"));
  assert_eq(caught(|| rounded("2.5", 0, 0)), Ok("2"));
  assert_eq(caught(|| rounded("2.5", 0, 1)), Ok("3"));
  assert_eq(caught(|| rounded("-0.001", 2, 5)), Ok("-0.01"));
  assert_eq(caught(|| rounded("7", 28, 2)), Ok("7.0000000000000000000000000000"));
  assert_eq(caught(|| rounded("8", 28, 2)), Err("`Decimal` overflow in rounding"));
  assert_eq(caught(|| rounded(largest_decimal_text(), 1, 2)), Err("`Decimal` overflow in rounding"))
}

test "rounding `-2.5` to a whole number gives `-2` or `-3` depending on the rounding mode" {
  assert_eq(range(0, 6).map(|pick: Int| caught(|| rounded("-2.5", 0, pick))), [
    Ok("-2"),
    Ok("-3"),
    Ok("-2"),
    Ok("-3"),
    Ok("-2"),
    Ok("-3"),
  ]);
  assert_eq(
    [("0.5", 0, 0), ("1.5", 0, 0), ("2.5001", 0, 0), ("-0.001", 2, 0), ("-8", 28, 2)].map(
      |c: (String, Int, Int)| caught(|| rounded(c._0, c._1, c._2)),
    ),
    [Ok("0"), Ok("2"), Ok("3"), Ok("0.00"), Err("`Decimal` overflow in rounding")],
  )
}
