fn decimal(s: String) -> Decimal =
  match Decimal::of_string(s) { Some(d) -> d, None -> Decimal::of_int(0) }

test "`Decimal::bits` returns two integers: flags (scale and sign) plus the low 32 mantissa bits, then the higher mantissa bits" {
  assert_eq(Decimal::bits(decimal("1.5")), (15 * 4294967296 + 65536, 0));
  assert_eq(Decimal::bits(decimal("-1.5")), (15 * 4294967296 + 65536 + 2147483648, 0));
  assert_eq(Decimal::bits(decimal("4294967296")), (0, 1))
}

test "`Decimal::of_bits` rebuilds a decimal from its `Decimal::bits` with the same value, scale and sign" {
  let samples = ["0", "1.5", "-1.5", "0.0001", "79228162514264337593543950335", "-12345.678900"];
  assert_eq(
    samples.map(|s: String| {
      let d = decimal(s);
      let w = Decimal::bits(d);
      match Decimal::of_bits(w._0, w._1) {
        Some(e) ->
          e == d && Decimal::scale(e) == Decimal::scale(d) && e.to_string() == d.to_string(),
        None -> false,
      }
    }),
    samples.map(|_: String| true),
  )
}

test "`Decimal::of_bits` returns `None` for bit patterns that are not a valid decimal" {
  assert_eq(Decimal::of_bits(29 * 65536, 0), None);
  assert_eq(Decimal::of_bits(1, 0), None);
  assert_eq(Decimal::of_bits(16777216, 0), None);
  assert_eq(Decimal::of_bits(28 * 65536, 0), Some(Decimal::of_int(0)))
}
