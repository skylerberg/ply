type Pair = | Pair(I32, I32)

fn listed(xs: List<U8>, op: Int) -> Int =
  match xs {
    [a, b, ..] -> if op == 0 { int_of_u8(wrap_add(a, b)) }
    else if op == 1 { int_of_u8(wrap_sub(a, b)) }
    else { int_of_u8(wrap_mul(a, b)) },
    _ -> 0,
  }

fn tupled(p: (I8, I8), op: Int) -> Int =
  match p {
    (a, b) -> if op == 0 { int_of_i8(wrap_add(a, b)) }
    else if op == 1 { int_of_i8(wrap_sub(a, b)) }
    else { int_of_i8(wrap_mul(a, b)) },
  }

fn fielded(r: { left: U32, right: U32 }, op: Int) -> Int =
  match r {
    { left: a, right: b } -> if op == 0 { int_of_u32(wrap_add(a, b)) }
    else if op == 1 { int_of_u32(wrap_sub(a, b)) }
    else { int_of_u32(wrap_mul(a, b)) },
  }

fn constructed(p: Pair, op: Int) -> Int =
  match p {
    Pair(a, b) -> if op == 0 { int_of_i32(wrap_add(a, b)) }
    else if op == 1 { int_of_i32(wrap_sub(a, b)) }
    else { int_of_i32(wrap_mul(a, b)) },
  }

fn answered(f: (Int) -> U8, op: Int) -> Int = {
  let a = f(0);
  let b = f(1);
  if op == 0 { int_of_u8(wrap_add(a, b)) }
  else if op == 1 { int_of_u8(wrap_sub(a, b)) }
  else { int_of_u8(wrap_mul(a, b)) }
}

fn captured(a: I8, b: I8, op: Int) -> Int = {
  let f = |k: Int|
    if k == 0 { int_of_i8(wrap_add(a, b)) }
    else if k == 1 { int_of_i8(wrap_sub(a, b)) }
    else { int_of_i8(wrap_mul(a, b)) };
  f(op)
}

fn nth<t>(xs: List<t>, i: Int, d: t) -> t = match list_at(xs, i) { Some(v) -> v, None -> d }

fn chosen(xs: List<U32>, op: Int) -> Int = {
  let a = nth(xs, 0, 0u32);
  let b = nth(xs, 1, 0u32);
  if op == 0 { int_of_u32(wrap_add(a, b)) }
  else if op == 1 { int_of_u32(wrap_sub(a, b)) }
  else { int_of_u32(wrap_mul(a, b)) }
}

fn valued(m: Map<Int, I32>, op: Int) -> Int =
  match map_get(m, 0) {
    Some(a) -> match map_get(m, 1) {
      Some(b) -> if op == 0 { int_of_i32(wrap_add(a, b)) }
      else if op == 1 { int_of_i32(wrap_sub(a, b)) }
      else { int_of_i32(wrap_mul(a, b)) },
      None -> 0,
    },
    None -> 0,
  }

fn pairs(a: I32, b: I32) -> Map<Int, I32> = map_insert(map_insert(map_new(), 0, a), 1, b)

fn ordered(xs: List<I8>) -> List<Bool> =
  match xs { [a, b] -> [a < b, a <= b, a > b, a >= b, a == b, a != b], _ -> [] }

fn bits(xs: List<U8>) -> List<Int> =
  match xs {
    [a, b] ->
      [
        int_of_u8(a << 1),
        int_of_u8(a >> 1),
        int_of_u8(~a),
        int_of_u8(a & b | a ^ b),
        int_of_u8(rotr(a, 1)),
      ],
    _ -> [],
  }

fn signed_bits(xs: List<I8>) -> List<Int> =
  match xs { [a] -> [int_of_i8(a >> 1), int_of_i8(a >>> 1), int_of_i8(~a), int_of_i8(-a)], _ -> [] }

fn wide(xs: List<U64>) -> List<U64> =
  match xs { [a, b] -> [a << 1, a >>> 1, ~a, a & b, a ^ b, wrap_add(a, b)], _ -> [] }

fn wide_signed(xs: List<I64>) -> List<I64> = match xs { [a] -> [a >>> 60, ~a, -a], _ -> [] }

fn widest(xs: List<U128>) -> List<U128> =
  match xs { [a, b] -> [a << 1, a >>> 1, ~a, a ^ b], _ -> [] }

fn widest_signed(xs: List<I128>) -> List<I128> = match xs { [a] -> [a >>> 120, ~a, -a], _ -> [] }

fn checked_bytes(xs: List<U8>) -> List<Option<U8>> =
  match xs {
    [a, b] -> [checked_add(a, b), checked_sub(a, b), checked_mul(a, b), checked_neg(a)],
    _ -> [],
  }

test "each binder wraps at the width of its values" {
  assert_eq(map([0, 1, 2], |op: Int| listed([100u8, 200u8], op)), [44, 156, 32]);
  assert_eq(map([0, 1, 2], |op: Int| tupled((100i8, 100i8), op)), [-56, 0, 16]);
  assert_eq(
    map([0, 1, 2], |op: Int| fielded({ left: 4000000000u32, right: 1000000000u32 }, op)),
    [705032704, 3000000000, 2643460096],
  );
  assert_eq(map([0, 1, 2], |op: Int| constructed(Pair(2000000000i32, -2000000000i32), op)), [
    0,
    -294967296,
    1651507200,
  ]);
  assert_eq(map([0, 1, 2], |op: Int| answered(|i: Int| if i == 0 { 100u8 } else { 200u8 }, op)), [
    44,
    156,
    32,
  ]);
  assert_eq(map([0, 1, 2], |op: Int| captured(-100i8, 100i8, op)), [0, 56, -16]);
  assert_eq(map([0, 1, 2], |op: Int| chosen([1u32, 2u32], op)), [3, 4294967295, 2]);
  assert_eq(map([0, 1, 2], |op: Int| valued(pairs(100000i32, 100000i32), op)), [
    200000,
    0,
    1410065408,
  ])
}

test "every other operator reads a bound width at its type" {
  assert_eq(ordered([-1i8, 1i8]), [true, true, false, false, false, true]);
  assert_eq(bits([200u8, 10u8]), [144, 100, 55, 202, 100]);
  assert_eq(signed_bits([-2i8]), [-1, 127, 1, 2])
}

test "sixty-four bits are the runtime's own words, and read at their type" {
  assert_eq(wide([0x8000_0000_0000_0001u64, 3u64]), [
    2u64,
    0x4000_0000_0000_0000u64,
    0x7FFF_FFFF_FFFF_FFFEu64,
    1u64,
    0x8000_0000_0000_0002u64,
    0x8000_0000_0000_0004u64,
  ]);
  assert_eq(wide_signed([-1i64]), [15i64, 0i64, 1i64])
}

test "128 bits are the runtime's own words, and read at their type" {
  assert_eq(widest([0x8000_0000_0000_0000_0000_0000_0000_0001u128, 3u128]), [
    2u128,
    0x4000_0000_0000_0000_0000_0000_0000_0000u128,
    0x7FFF_FFFF_FFFF_FFFF_FFFF_FFFF_FFFF_FFFEu128,
    0x8000_0000_0000_0000_0000_0000_0000_0002u128,
  ]);
  assert_eq(widest_signed([-1i128]), [255i128, 0i128, 1i128])
}

test "the checked family reads a bound width at its type, called or passed" {
  assert_eq(checked_bytes([200u8, 100u8]), [None, Some(100u8), None, None]);
  assert_eq(map([200u8, 0u8], checked_neg), [None, Some(0u8)])
}

test "a width builtin passed as a value wraps and converts at its type" {
  assert_eq(fold([200u8, 100u8], 0u8, wrap_add), 44u8);
  assert_eq(fold([10u8, 20u8], 7u8, wrap_mul), 120u8);
  assert_eq(map(map([7, 255], u8_of_int), int_of_u8), [7, 255]);
  assert_eq(fold([9223372036854775807, 1], 0, wrap_add), -9223372036854775807 - 1)
}
