test "the largest `U64` is greater than 0, and `wrap_add` of 1 to it returns 0" {
  let top = 0xFFFF_FFFF_FFFF_FFFFu64;
  assert_eq(wrap_add(top, 0u64), top);
  assert_eq(wrap_add(top, 1u64), 0u64);
  assert(top > 0u64)
}

test "`I64` arithmetic and comparison work like `Int`'s" {
  assert_eq(-1i64 + 1i64, 0i64);
  assert(-1i64 < 0i64)
}
