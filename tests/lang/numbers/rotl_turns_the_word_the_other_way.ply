fn swapped(x: U32) -> U32 = rotl(x, 16)

test "a rotation left at each width" {
  assert_eq(rotl(128u8, 1), 1u8);
  assert_eq(rotl(1u8, 7), 128u8);
  assert_eq(rotl(2147483648u32, 1), 1u32);
  assert_eq(rotl(1u32, 4), 16u32);
  assert_eq(rotl(0xABu8, 8), 0xABu8);
  assert_eq(rotl(0x8000_0000_0000_0001u64, 1), 3u64);
  assert_eq(rotl(1u128, 127), 170141183460469231731687303715884105728u128);
  assert_eq(rotl(i8_of_int(-128), 1), 1i8);
  assert_eq(swapped(0xDEAD_BEEFu32), 0xBEEF_DEADu32)
}

test "at Int a rotation turns sixty-four bits" {
  assert_eq(rotl(1, 63), -9223372036854775807 - 1);
  assert_eq(rotl(-9223372036854775807 - 1, 1), 1);
  assert_eq(rotl(3, 64), 3)
}

test "a rotation left undoes the same rotation right, whatever the count" {
  assert_eq(rotl(rotr(0xDEAD_BEEFu32, 12), 12), 0xDEAD_BEEFu32);
  assert_eq(rotl(0xDEAD_BEEFu32, 12), rotr(0xDEAD_BEEFu32, 20));
  assert_eq(rotl(0xDEAD_BEEFu32, -12), rotr(0xDEAD_BEEFu32, 12));
  assert_eq(rotl(0xDEAD_BEEFu32, 44), rotl(0xDEAD_BEEFu32, 12));
  assert_eq(rotl(0x1234u16, 0), 0x1234u16);
  assert_eq(rotl(0xDEAD_BEEF_0BAD_F00Du64, 20), rotr(0xDEAD_BEEF_0BAD_F00Du64, 44));
  assert_eq(rotl(77, -3), rotr(77, 3))
}
