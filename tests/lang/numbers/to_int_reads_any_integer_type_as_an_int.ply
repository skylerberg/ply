fn widened<a>(x: a) -> Int
  where integer(a)
= match to_int(x) { Some(n) -> n, None -> -1 }

fn narrowed(x: U32) -> Option<U8> / {abort.raise} =
  match to_int(x) {
    Some(n) -> if n <= 255 { Some(u8_of_int(n & 255)) } else { None },
    None -> None,
  }

fn between<a, b>(x: a) -> b / {abort.raise}
  where integer(a), numeric(b)
= match to_int(x) { Some(n) -> numeric_of_int(n), None -> numeric_of_int(0) }

test "every width an Int holds answers its value" {
  assert_eq(to_int(255u8), Some(255));
  assert_eq(to_int(65535u16), Some(65535));
  assert_eq(to_int(4294967295u32), Some(4294967295));
  assert_eq(to_int(-1i8), Some(-1));
  assert_eq(to_int(i16_of_int(-32768)), Some(-32768));
  assert_eq(to_int(-5i32), Some(-5));
  assert_eq(to_int(-5i64), Some(-5));
  assert_eq(to_int(9223372036854775807u64), Some(9223372036854775807));
  assert_eq(to_int(7u128), Some(7));
  assert_eq(to_int(-7i128), Some(-7));
  assert_eq(to_int(42), Some(42))
}

test "a value past Int's range answers None" {
  assert_eq(to_int(9223372036854775808u64), None);
  assert_eq(to_int(0xFFFF_FFFF_FFFF_FFFFu64), None);
  assert_eq(to_int(9223372036854775808u128), None);
  assert_eq(to_int(-9223372036854775809i128), None);
  assert_eq(to_int(9223372036854775807i128), Some(9223372036854775807))
}

test "under an integer constraint it reads whatever type the call fills in" {
  assert_eq(widened(200u8), 200);
  assert_eq(widened(-3i16), -3);
  assert_eq(widened(0xFFFF_FFFF_FFFF_FFFFu64), -1);
  assert_eq(widened(12), 12);
  assert_eq(narrowed(200u32), Some(200u8));
  assert_eq(narrowed(256u32), None)
}

test "with numeric_of_int it converts between any two integer types" {
  let wide: U64 = between(200u8);
  let small: I16 = between(77u32);
  assert_eq(wide, 200u64);
  assert_eq(small, 77i16)
}
