fn bigger(bits: Int) -> Bool = Float::of_bits(bits) > 1.5

fn half(bits: Int) -> Int = bits_of_float(Float::of_bits(bits) * 0.5)

fn times_tenth(n: Int) -> String = Decimal::to_string(Decimal::of_int(n) * 0.10m)

fn is_2_5(bits: Int) -> Bool = Float::of_bits(bits) == 2.5e0

fn negated(bits: Int) -> Int = bits_of_float(-Float::of_bits(bits))

fn product(a: Int, b: Int) -> String = Decimal::to_string(Decimal::of_int(a) * Decimal::of_int(b))

fn ordered(a: Int, b: Int) -> Bool = Decimal::of_int(a) < Decimal::of_int(b)

test "a float or decimal literal has the value it spells, and decimal arithmetic on literals is exact" {
  assert_eq(bigger(bits_of_float(2.0)), true);
  assert_eq(bigger(bits_of_float(1.0)), false);
  assert_eq(half(bits_of_float(3.0)), bits_of_float(1.5));
  assert_eq(times_tenth(7), "0.70");
  assert_eq(is_2_5(bits_of_float(2.5)), true);
  assert_eq(negated(bits_of_float(2.0)), bits_of_float(-2.0));
  assert_eq(product(6, 7), "42");
  assert_eq(ordered(6, 7), true)
}
