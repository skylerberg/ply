test "`<` and `>` compare `I8` and `U8` by value, so -128 is below 0 and 255 is above 0" {
  assert(I8::of_int(-128) < 0i8);
  assert(255u8 > 0u8);
  assert_eq(compare(1u32, 2u32), Less)
}

test "a map keyed by a fixed width finds what it inserted" {
  let m = Map::new().insert(7u32, "seven");
  assert_eq(m.get(7u32), Some("seven"));
  assert_eq(m.get(8u32), None)
}
