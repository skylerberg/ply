fn halves(n: Int) -> Int = n / 2

fn sevenths(n: Int) -> Int = n % 7

fn negative_thirds(n: Int) -> Int = n / -3

fn negative_fifths(n: Int) -> Int = n % -5

fn quotient(n: Int, d: Int) -> Int / {abort.raise} = n / d

fn remainder(n: Int, d: Int) -> Int / {abort.raise} = n % d

test "dividing an `Int` by a literal gives the same quotient and remainder as dividing by the same number in a variable" {
  let least = 0 - 9223372036854775807 - 1;
  [0, 1, 0 - 1, 7, 0 - 7, 9, 0 - 9, 9223372036854775807, least].fold((), |u: Unit, n: Int| {
    assert_eq(halves(n), quotient(n, 2));
    assert_eq(sevenths(n), remainder(n, 7));
    assert_eq(negative_thirds(n), quotient(n, 0 - 3));
    assert_eq(negative_fifths(n), remainder(n, 0 - 5))
  });
  assert_eq([halves(0 - 7), sevenths(0 - 9), negative_thirds(7), negative_fifths(0 - 7)], [
    0 - 3,
    0 - 2,
    0 - 2,
    0 - 2,
  ])
}
