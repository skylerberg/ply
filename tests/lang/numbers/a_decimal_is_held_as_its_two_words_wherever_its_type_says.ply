//! A `Decimal` is held as its own two words in a register, a record, an array and a constructor
//! its type says holds one: it reads back, computes, compares and keys a map as the number it is,
//! however it was made.

import std.show (show)

type Line = { price: Decimal, qty: Int, sku: String }

type Charge = | Fee(Decimal) | Discount(Line, Decimal)

fn line(price: Decimal, qty: Int) -> Line = { price: price, qty: qty, sku: "s" }

fn cost(l: Line) -> Decimal = l.price * Decimal::of_int(l.qty)

fn raised(l: Line, by: Decimal) -> Line = { ..l, price: l.price + by }

fn twice<a>(x: a) -> a
  where numeric(a)
= x + x

fn nudged(up: Bool, d: Decimal) -> Decimal = if up { d + 0.01m } else { d - 0.01m }

fn settled(c: Charge) -> Decimal = match c { Fee(d) -> d, Discount(l, _) -> l.price }

fn charged(c: Charge) -> Decimal = match c { Fee(d) -> d, Discount(l, off) -> cost(l) - off }

/// A self tail call answering a decimal: the loop restarts where the call would have answered.
fn compounded(d: Decimal, n: Int) -> Decimal = if n <= 0 { d } else { compounded(d * 2m, n - 1) }

test "a record holding a decimal reads, computes and updates it as the number it is" {
  let l = line(19.99m, 3);
  assert_eq(cost(l), 59.97m);
  let r = raised(l, 0.01m);
  assert_eq(r.price, 20.00m);
  assert_eq(l.price, 19.99m);
  assert_eq(r.sku, "s");
  assert_eq(-r.price, -20m)
}

test "decimals compare as numbers at any scale, and key a map so" {
  assert(1.0m == 1.00m);
  assert(line(1.50m, 1) == line(1.5m, 1));
  assert(0.1m + 0.2m == 0.3m);
  assert(2.5m > 2.49m);
  assert_eq(twice(1.25m), 2.50m);
  assert_eq(nudged(true, 1m), 1.01m);
  assert_eq(nudged(false, 1m), 0.99m);
  assert_eq(settled(Discount(line(3m, 1), 1m)), 3m);
  assert_eq([{ price: 2.0m }, { price: 2.00m }].at(1), Some({ price: 2.00m }));
  assert_eq(twice(line(0.5m, 1).price), 1m);
  let by_price = Map::new().insert(2.50m, "b").insert(1.25m, "a");
  assert_eq(by_price.first(), Some({ key: 1.25m, value: "a" }));
  assert_eq(by_price.get(2.5m), Some("b"))
}

test "an array and a constructor hold decimals in place" {
  let prices = Array::of_list([1.5m, -2.25m, 0.001m]);
  assert_eq(prices.get(1), -2.25m);
  assert_eq(prices.set(0, 9m).to_list(), [9m, -2.25m, 0.001m]);
  assert_eq(prices.get(0), 1.5m);
  assert_eq(charged(Fee(4.20m)), 4.2m);
  assert_eq(charged(Discount(line(10m, 2), 1.5m)), 18.5m);
  assert_eq([Fee(1m), Fee(2m)].map(charged), [1m, 2m]);
  assert_eq(compounded(1.5m, 3), 12m)
}

test "a record holding a decimal shows it at its own scale" {
  assert_eq(show(line(19.990m, 1)), "{price: 19.990, qty: 1, sku: \"s\"}");
  assert_eq(show(Discount(line(1m, 1), 0.50m)), "Discount({price: 1, qty: 1, sku: \"s\"}, 0.50)")
}
