fn shown(s: String) -> String =
  match Decimal::of_string(s) { Some(d) -> d.to_string(), None -> "none" }

test "a sign, separators and a point are read, and a zero has no sign" {
  assert_eq(["+1.5", "-1.5", ".5", "5.", "1_000.000_1", "1__0", "-0", "-0.00", "007"].map(shown), [
    "1.5",
    "-1.5",
    "0.5",
    "5",
    "1000.0001",
    "10",
    "0",
    "0.00",
    "7",
  ])
}

test "text that spells no decimal is rejected" {
  assert_eq(
    ["", ".", "-", "_1", "._5", "1.2.3", "1,5", " 1", "1 ", "1e", "e5", "1ee5"].map(shown),
    [
      "none",
      "none",
      "none",
      "none",
      "none",
      "none",
      "none",
      "none",
      "none",
      "none",
      "none",
      "none",
    ],
  )
}

test "text with more than 28 decimal places or a value over 96 bits is rejected, but extra digits in a number with an exponent are rounded" {
  assert_eq(shown("0.0000000000000000000000000001"), "0.0000000000000000000000000001");
  assert_eq(shown("0.00000000000000000000000000001"), "none");
  assert_eq(shown("79228162514264337593543950335"), "79228162514264337593543950335");
  assert_eq(shown("79228162514264337593543950336"), "none");
  assert_eq(shown("1.00000000000000000000000000005e0"), "1.0000000000000000000000000001")
}

test "an exponent moves the point, or grows the mantissa and drops the point" {
  assert_eq(
    ["1.5e3", "1.50e1", "1.2E10", "1e-5", "1e+5", "1e-+5", "1e28", "1e29", "1e-29"].map(shown),
    [
      "1500",
      "15.0",
      "12000000000",
      "0.00001",
      "100000",
      "0.00001",
      "10000000000000000000000000000",
      "none",
      "none",
    ],
  )
}

test "`Float::of_decimal` returns the nearest float, picks the even neighbor on a tie, and gives `-0.0` for a negative zero decimal" {
  assert_eq(Float::of_decimal(9007199254740993m), 9007199254740992.0);
  assert_eq(Float::of_decimal(9007199254740995m), 9007199254740996.0);
  assert_eq(Float::of_decimal(-0.000000000000000000000000001m), -1e-27);
  assert_eq(Float::of_decimal(79228162514264337593543950335m), 79228162514264337593543950336.0);
  assert_eq(
    match Decimal::of_bits(2147483648, 0) {
      Some(d) -> bits_of_float(Float::of_decimal(d)),
      None -> 0,
    },
    bits_of_float(-0.0),
  )
}

test "`Decimal::of_float` returns the decimal with the float's shortest round-trip digits, or `None` when the float is too small or large for a decimal" {
  assert_eq(
    [0.1, 1.0, -0.0, 1e21, 0.30000000000000004, 1e-28, 1e-29, 1e29].map(|f: Float|
      match Decimal::of_float(f) { Some(d) -> d.to_string(), None -> "none" }),
    [
      "0.1",
      "1",
      "0",
      "1000000000000000000000",
      "0.30000000000000004",
      "0.0000000000000000000000000001",
      "none",
      "none",
    ],
  )
}
