test "a rotation at each width" {
  assert_eq(rotr(1u8, 1), 128u8);
  assert_eq(rotr(1u32, 1), 2147483648u32);
  assert_eq(rotr(16u32, 4), 1u32);
  assert_eq(rotr(0xABu8, 8), 0xABu8)
}

test "a rotation is its own inverse over the width" {
  assert_eq(rotr(rotr(0xDEAD_BEEFu32, 12), 20), 0xDEAD_BEEFu32)
}

test "rotr32 turns an Int's low thirty-two bits by any count and answers them unsigned" {
  assert_eq(
    [
      (1, 1),
      (0x8000_0000, 31),
      (0x1234_5678, 0),
      (0x1234_5678, 32),
      (0x1234_5678, 4),
      (0x1_0000_0001, 1),
      (0 - 1, 7),
      (2, 0 - 1),
    ].map(|c: (Int, Int)| rotr32(c._0, c._1)),
    [0x8000_0000, 1, 0x1234_5678, 0x1234_5678, 0x8123_4567, 0x8000_0000, 0xFFFF_FFFF, 4],
  )
}
