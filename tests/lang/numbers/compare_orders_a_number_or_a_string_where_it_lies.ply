//! `compare` at a number, a character or a string orders the values where they lie, as the
//! evaluator orders them: a `Decimal` by its value at any scale, a string or byte string by its
//! bytes from the first, a shorter one before one it begins.

fn ints(a: Int, b: Int) -> Ordering = compare(a, b)

fn decimals(a: Decimal, b: Decimal) -> Ordering = compare(a, b)

fn chars(a: Char, b: Char) -> Ordering = compare(a, b)

fn texts(a: String, b: String) -> Ordering = compare_values(a, b)

fn bytes(a: Bytes, b: Bytes) -> Ordering = compare(a, b)

fn small(a: U8, b: U8) -> Ordering = compare(a, b)

fn before(a: Bytes, b: Bytes) -> Bool = compare(a, b) == Less

test "compare orders numbers, characters and strings as the evaluator does" {
  assert_eq(ints(1, 2), Less);
  assert_eq(ints(0 - 5, 0 - 5), Equal);
  assert_eq(ints(3, 0 - 3), Greater);
  assert_eq(decimals(1.50m, 1.5m), Equal);
  assert_eq(decimals(1.5m, 1.51m), Less);
  assert_eq(chars('a', 'b'), Less);
  assert_eq(chars('é', 'z'), Greater);
  assert_eq(texts("abc", "abd"), Less);
  assert_eq(texts("ab", "abc"), Less);
  assert_eq(texts("abc", "ab"), Greater);
  assert_eq(texts("", ""), Equal);
  assert_eq(texts("Z", "a"), Less);
  assert_eq(texts("xabcx".slice(1, 4), "abc"), Equal);
  assert_eq(bytes(b"\x01", b"\xff"), Less);
  assert_eq(bytes(b"ab", b"a"), Greater);
  assert_eq(small(U8::of_int(200), U8::of_int(7)), Greater);
  assert(before(b"apple", b"apples"));
  assert(!before(b"pear", b"apple"))
}

test "compare at a number or a string makes no object" {
  let a = b"apple";
  let b = b"apples";
  assert_eq(metered(|| before(a, b)).allocations, 0);
  assert_eq(metered(|| ints(1, 2)).allocations, 0)
}

type Shape = | Square(Int) | Circle(Int, String) | Dot

fn shapes(a: Shape, b: Shape) -> Ordering = compare(a, b)

type Tree = | Leaf(Int) | Node(Tree, Tree)

fn trees(a: Tree, b: Tree) -> Ordering = compare(a, b)

test "compare orders a declared sum's values by their constructors' names, then their arguments" {
  assert_eq(shapes(Circle(5, "a"), Square(1)), Less);
  assert_eq(shapes(Dot, Circle(1, "a")), Greater);
  assert_eq(shapes(Square(2), Square(3)), Less);
  assert_eq(shapes(Circle(1, "b"), Circle(1, "a")), Greater);
  assert_eq(shapes(Circle(1, "a"), Circle(2, "a")), Less);
  assert_eq(shapes(Dot, Dot), Equal);
  assert_eq(shapes(Circle(1, "a"), Circle(1, "a")), Equal);
  assert_eq(trees(Leaf(9), Node(Leaf(1), Leaf(1))), Less);
  assert_eq(trees(Node(Leaf(1), Leaf(2)), Node(Leaf(1), Leaf(3))), Less);
  assert_eq(trees(Node(Node(Leaf(1), Leaf(1)), Leaf(0)), Node(Leaf(5), Leaf(0))), Greater);
  assert_eq(trees(Node(Leaf(1), Leaf(2)), Node(Leaf(1), Leaf(2))), Equal)
}

type Version = { major: Int, minor: Int, tag: String }

fn versions(a: Version, b: Version) -> Ordering = compare(a, b)

test "compare orders a record field by field in the order its names sort" {
  assert_eq(versions({ major: 1, minor: 2, tag: "a" }, { major: 1, minor: 3, tag: "a" }), Less);
  assert_eq(versions({ major: 2, minor: 0, tag: "a" }, { major: 1, minor: 9, tag: "z" }), Greater);
  assert_eq(versions({ major: 1, minor: 2, tag: "b" }, { major: 1, minor: 2, tag: "a" }), Greater);
  assert_eq(versions({ major: 1, minor: 2, tag: "a" }, { major: 1, minor: 2, tag: "a" }), Equal)
}
