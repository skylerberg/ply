//! An `Int`'s and a 64-bit width's arithmetic at the ends of the range: wrapping and saturating
//! answer what the guide says, a product or quotient that fits is exact, and a conversion back from
//! a `U64` keeps every value an `Int` holds.

import std.list

fn greatest() -> Int = 9223372036854775807
fn least() -> Int = 0 - 9223372036854775807 - 1
fn times(a: Int, b: Int) -> Int = a * b
fn over(a: Int, b: Int) -> Int / {abort.raise} = a / b
fn rest(a: Int, b: Int) -> Int / {abort.raise} = a % b

test "an Int wraps at its 64 bits" {
  assert_eq(greatest() +% 1, least());
  assert_eq(least() -% 1, greatest());
  assert_eq(greatest() *% 2, -2);
  assert_eq(rotr(1, 1), least())
}

test "an Int saturates at its least and greatest values" {
  assert_eq(greatest() +| 1, greatest());
  assert_eq(least() +| -1, least());
  assert_eq(least() -| 1, least());
  assert_eq(greatest() -| -1, greatest());
  assert_eq(least() *| 2, least());
  assert_eq(greatest() *| -2, least());
  assert_eq(-3 *| (0 - greatest()), greatest());
  assert_eq(40 +| 2, 42)
}

test "a 64-bit width saturates at its ends" {
  assert_eq(18446744073709551615u64 +| 1u64, 18446744073709551615u64);
  assert_eq(0u64 -| 1u64, 0u64);
  assert_eq(4294967296u64 *| 4294967296u64, 18446744073709551615u64);
  assert_eq(6u64 *| 7u64, 42u64);
  assert_eq(I64::of_int(greatest()) +| 1i64, I64::of_int(greatest()));
  assert_eq(I64::of_int(least()) -| 1i64, I64::of_int(least()))
}

test "a product or a quotient that fits is exact, and truncates toward zero" {
  assert_eq(times(3037000499, 3037000499), 9223372030926249001);
  assert_eq(times(least(), 1), least());
  assert_eq(times(-1, greatest()), 0 - greatest());
  assert_eq(over(-7, 2), -3);
  assert_eq(rest(-7, 2), -1);
  assert_eq(over(least(), 1), least());
  assert_eq(rest(least(), 2), 0)
}

test "a sum starts at the zero of the type it adds" {
  assert_eq([1, 2, 3].sum(), 6);
  assert_eq([1.5, 2.5].sum(), 4.0);
  assert_eq([200u8, 50u8].sum(), 250u8)
}

test "a U64 an Int holds converts back whole" {
  assert_eq(Int::of_u64(9223372036854775807u64), greatest());
  assert_eq(Int::of_u64(0u64), 0)
}
