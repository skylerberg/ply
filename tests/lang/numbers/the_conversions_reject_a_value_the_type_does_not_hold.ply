fn caught<a>(f: () -> a / {abort.raise}) -> Result<a, String> =
  handle { f() } with { abort.raise(m) -> Err(m), return v -> Ok(v) }

test "converting `U8`, `I8` and `U32` values to `Int` returns the same number" {
  assert_eq(Int::of_u8(255u8), 255);
  assert_eq(Int::of_i8(I8::of_int(-128)), -128);
  assert_eq(Int::of_u32(4294967295u32), 4294967295)
}

test "`U8::of_int` returns 0x34 for 0x1234 once the value is masked with `& 0xFF`" {
  assert_eq(U8::of_int(0x1234 & 0xFF), 0x34u8)
}

test "a value the type does not hold raises and names what was given" {
  assert_eq(caught(|| U8::of_int(256)), Err("`U8::of_int` was given 256: `U8` holds 0 to 255"));
  assert_eq(caught(|| U8::of_int(-1)), Err("`U8::of_int` was given -1: `U8` holds 0 to 255"));
  assert_eq(
    caught(|| Int::of_u64(0xFFFF_FFFF_FFFF_FFFFu64)),
    Err("`Int::of_u64` was given 18446744073709551615"),
  )
}

test "a division or a remainder by zero raises at a fixed width" {
  assert_eq(caught(|| 1u32 / 0u32), Err("division by zero"));
  assert_eq(caught(|| 7u16 % U16::of_int([].len())), Err("remainder by zero"))
}
