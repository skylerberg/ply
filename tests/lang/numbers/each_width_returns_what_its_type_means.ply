fn add_u8(a: Int, b: Int) -> Int / {abort.raise} = Int::of_u8(U8::of_int(a) + U8::of_int(b))

fn wrap_u8(a: Int, b: Int) -> Int / {abort.raise} =
  Int::of_u8(wrap_add(U8::of_int(a), U8::of_int(b)))

fn wrap_u32(a: Int, b: Int) -> Int / {abort.raise} =
  Int::of_u32(wrap_add(U32::of_int(a), U32::of_int(b)))

fn mul_u16(a: Int, b: Int) -> Int / {abort.raise} = Int::of_u16(U16::of_int(a) * U16::of_int(b))

fn div_i8(a: Int, b: Int) -> Int / {abort.raise} = Int::of_i8(I8::of_int(a) / I8::of_int(b))

fn rem_u32(a: Int, b: Int) -> Int / {abort.raise} = Int::of_u32(U32::of_int(a) % U32::of_int(b))

fn neg_i16(a: Int) -> Int / {abort.raise} = Int::of_i16(-I16::of_int(a))

fn xor_u32(a: Int, b: Int) -> Int / {abort.raise} = Int::of_u32(U32::of_int(a) ^ U32::of_int(b))

fn not_u8(a: Int) -> Int / {abort.raise} = Int::of_u8(~U8::of_int(a))

fn shl_u8(a: Int, n: Int) -> Int / {abort.raise} = Int::of_u8(U8::of_int(a) << n)

fn shr_i8(a: Int, n: Int) -> Int / {abort.raise} = Int::of_i8(I8::of_int(a) >> n)

fn ushr_i8(a: Int, n: Int) -> Int / {abort.raise} = Int::of_i8(I8::of_int(a) >>> n)

fn rotr_u32(a: Int, n: Int) -> Int / {abort.raise} = Int::of_u32(rotr(U32::of_int(a), n))

fn rotr_u8(a: Int, n: Int) -> Int / {abort.raise} = Int::of_u8(rotr(U8::of_int(a), n))

fn lt_u8(a: Int, b: Int) -> Bool / {abort.raise} = U8::of_int(a) < U8::of_int(b)

fn lt_i8(a: Int, b: Int) -> Bool / {abort.raise} = I8::of_int(a) < I8::of_int(b)

fn eq_u32(a: Int, b: Int) -> Bool / {abort.raise} = U32::of_int(a) == U32::of_int(b)

fn from_literal() -> Int = Int::of_u32(0x6A09_E667u32)

fn literal_arithmetic(a: Int) -> Int / {abort.raise} = Int::of_u8(wrap_add(U8::of_int(a), 200u8))

fn first_word(x: Bytes) -> Int / {abort.raise} =
  match [x] { [b, ..] -> Int::of_u32(b.u32_le(0)), [] -> 0 }

type Quad = { a: U32, b: U32, c: U32, d: U32 }

fn quarter(q: Quad, mx: U32) -> Quad = {
  let a1 = wrap_add(wrap_add(q.a, q.b), mx);
  let d1 = rotr(q.d ^ a1, 16);
  let c1 = wrap_add(q.c, d1);
  let b1 = rotr(q.b ^ c1, 12);
  { a: a1, b: b1, c: c1, d: d1 }
}

fn round_trip(seed: Int) -> Int / {abort.raise} = {
  let w = U32::of_int(seed);
  let q = quarter({ a: w, b: wrap_add(w, 1u32), c: 0x3C6E_F372u32, d: 0xA54F_F53Au32 }, w);
  Int::of_u32(q.a ^ q.b ^ q.c ^ q.d)
}

fn hash_flags(i: Int, last: Bool, is_root: Bool) -> Int =
  Int::of_u32(
    (if i == 0 { 1u32 } else { 0u32 }) | (if last { 2u32 } else { 0u32 })
      | (if last && is_root { 8u32 } else { 0u32 }),
  )

fn mixed(n: Int) -> Int / {abort.raise} =
  Int::of_u32(
    range(0, n).fold(0u32, |accumulator: U32, i: Int| rotr(accumulator ^ U32::of_int(i), 7)),
  )

test "each fixed-width operation computes at its own width even when the function's signature uses `Int`" {
  assert_eq(add_u8(200, 55), 255);
  assert_eq(wrap_u8(255, 1), 0);
  assert_eq(wrap_u32(4294967295, 2), 1);
  assert_eq(first_word(b"\x01\x02\x03\x04"), 0x0403_0201);
  assert_eq(mul_u16(256, 255), 65280);
  assert_eq(div_i8(0 - 128, 2), 0 - 64);
  assert_eq(rem_u32(300, 256), 44);
  assert_eq(neg_i16(1), 0 - 1);
  assert_eq(not_u8(0), 255);
  assert_eq(xor_u32(0xF0F0_F0F0, 0x0F0F_0F0F), 0xFFFF_FFFF);
  assert_eq(shl_u8(1, 7), 128);
  assert_eq(shl_u8(128, 1), 0);
  assert_eq(shr_i8(0 - 2, 1), 0 - 1);
  assert_eq(ushr_i8(0 - 2, 1), 127);
  assert_eq(rotr_u32(1, 1), 2147483648);
  assert_eq(rotr_u8(1, 1), 128);
  assert_eq(rotr_u8(0xAB, 8), 0xAB);
  assert_eq(lt_u8(255, 0), false);
  assert_eq(lt_i8(0 - 128, 0), true);
  assert_eq(eq_u32(7, 7), true);
  assert_eq(from_literal(), 0x6A09_E667);
  assert_eq(hash_flags(0, true, true), 11);
  assert_eq(hash_flags(3, false, false), 0);
  assert_eq(literal_arithmetic(100), 44);
  assert_eq(round_trip(0xDEAD_BEEF), 0x7713_A5D9);
  assert_eq(round_trip(0), 0x4892_2726);
  assert_eq(mixed(16), 0xE414_A0AF);
  assert_eq(mixed(0), 0)
}

fn lt_i8_bound(x: Int, y: Int) -> Bool / {abort.raise} =
  match [I8::of_int(x), I8::of_int(y)] { [a, b] -> a < b, _ -> false }

fn ge_u32(x: Int, y: Int) -> Bool / {abort.raise} =
  match [U32::of_int(x), U32::of_int(y)] { [a, b] -> a >= b, _ -> false }

fn shl_u8_bound(x: Int, n: Int) -> Int / {abort.raise} =
  match [U8::of_int(x)] { [a] -> Int::of_u8(a << n), _ -> 0 }

fn ushr_i8_bound(x: Int, n: Int) -> Int / {abort.raise} =
  match [I8::of_int(x)] { [a] -> Int::of_i8(a >>> n), _ -> 0 }

fn not_u8_bound(x: Int) -> Int / {abort.raise} =
  match [U8::of_int(x)] { [a] -> Int::of_u8(~a), _ -> 0 }

fn neg_i8(x: Int) -> Int / {abort.raise} = match [I8::of_int(x)] { [a] -> Int::of_i8(-a), _ -> 0 }

fn div_i8_bound(x: Int, y: Int) -> Int / {abort.raise} =
  match [I8::of_int(x), I8::of_int(y)] { [a, b] -> Int::of_i8(a / b), _ -> 0 }

fn rotr_u8_bound(x: Int, n: Int) -> Int / {abort.raise} =
  match [U8::of_int(x)] { [a] -> Int::of_u8(rotr(a, n)), _ -> 0 }

fn shl_u64(x: Int, n: Int) -> Int / {abort.raise} =
  match [U64::of_int(x)] { [a] -> Int::of_u64(a << n), _ -> 0 }

fn ushr_i64(x: Int, n: Int) -> Int / {abort.raise} =
  match [I64::of_int(x)] { [a] -> Int::of_i64(a >>> n), _ -> 0 }

fn not_i64(x: Int) -> Int / {abort.raise} =
  match [I64::of_int(x)] { [a] -> Int::of_i64(~a), _ -> 0 }

fn shifted(w: U64, n: Int) -> U64 = w << n

fn shl_u64_param(x: Int, n: Int) -> Int / {abort.raise} = Int::of_u64(shifted(U64::of_int(x), n))

fn folded_u8(x: Int, y: Int) -> Int / {abort.raise} =
  Int::of_u8([U8::of_int(x), U8::of_int(y)].fold(0u8, wrap_add))

fn narrowed(x: Int) -> Int / {abort.raise} =
  [x].map(U8::of_int).map(Int::of_u8).fold(0, |accumulator: Int, v: Int| accumulator + v)

fn folded_int(x: Int, y: Int) -> Int = [x, y].fold(0, wrap_add)

test "operators on a fixed-width value bound by a pattern use that value's own width" {
  assert_eq(lt_i8_bound(0 - 1, 1), true);
  assert_eq(ge_u32(4294967295, 1), true);
  assert_eq(shl_u8_bound(200, 1), 144);
  assert_eq(ushr_i8_bound(0 - 2, 1), 127);
  assert_eq(not_u8_bound(200), 55);
  assert_eq(neg_i8(0 - 127), 127);
  assert_eq(div_i8_bound(0 - 128, 2), 0 - 64);
  assert_eq(rotr_u8_bound(1, 1), 128);
  assert_eq(shl_u64(3, 1), 6);
  assert_eq(ushr_i64(0 - 1, 60), 15);
  assert_eq(not_i64(5), 0 - 6);
  assert_eq(shl_u64_param(1, 4), 16);
  assert_eq(folded_u8(200, 100), 44);
  assert_eq(narrowed(200), 200);
  assert_eq(folded_int(9223372036854775807, 1), 0 - 9223372036854775807 - 1)
}
