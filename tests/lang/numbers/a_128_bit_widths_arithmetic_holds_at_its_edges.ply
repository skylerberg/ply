fn umax() -> U128 = 340282366920938463463374607431768211455u128

fn imax() -> I128 = 170141183460469231731687303715884105727i128

fn imin() -> I128 = 0i128 - imax() - 1i128

fn caught(f: () -> U128 / {abort.raise}) -> Option<U128> =
  handle { Some(f()) } with { abort.raise(_) -> None }

fn int_of(f: () -> Int / {abort.raise}) -> Option<Int> =
  handle { Some(f()) } with { abort.raise(_) -> None }

test "128-bit addition, subtraction, multiplication, division and remainder are correct across the 64-bit boundary" {
  assert_eq(umax() - 1u128 + 1u128, umax());
  assert_eq((0i128 - 1i128).to_string(), "-1");
  assert_eq((0i128 - 3i128) * 7i128, 0i128 - 21i128);
  assert_eq(18446744073709551615u128 + 1u128, 18446744073709551616u128);
  assert_eq(
    18446744073709551616u128 * 18446744073709551615u128,
    340282366920938463444927863358058659840u128,
  );
  assert_eq(100u128 / 7u128, 14u128);
  assert_eq(100u128 % 7u128, 2u128);
  assert_eq(umax() / 18446744073709551617u128, 18446744073709551615u128);
  assert_eq((0i128 - 100i128) / 7i128, 0i128 - 14i128);
  assert_eq((0i128 - 100i128) % 7i128, 0i128 - 2i128);
  assert_eq(caught(|| 100u128 / (umax() - umax())), None)
}

test "128-bit shifts and rotations move bits across the 64-bit boundary" {
  assert_eq(1u128 << 100, 1267650600228229401496703205376u128);
  assert_eq(0i128 - 256i128 >> 4, 0i128 - 16i128);
  assert_eq(0i128 - 1i128 >>> 120, 255i128);
  assert_eq(rotl(170141183460469231731687303715884105728u128, 1), 1u128);
  assert_eq(rotr(1u128, 1), 170141183460469231731687303715884105728u128);
  assert_eq(rotr(1u128, 0 - 1), 2u128)
}

test "the wrapping, saturating and checked forms return correct results at the width's ends" {
  assert_eq(wrap_add(umax(), 2u128), 1u128);
  assert_eq(wrap_mul(imax(), 2i128), 0i128 - 2i128);
  assert_eq(saturating_add(umax(), 5u128), umax());
  assert_eq(saturating_sub(3u128, 5u128), 0u128);
  assert_eq(saturating_mul(imin(), 2i128), imin());
  assert_eq(checked_add(umax(), 1u128), None);
  assert_eq(checked_sub(5u128, 3u128), Some(2u128));
  assert_eq(checked_mul(1180591620717411303424i128, 1152921504606846976i128), None);
  assert_eq(checked_neg(9i128), Some(0i128 - 9i128));
  assert_eq(checked_neg(9u128), None);
  assert_eq(checked_neg(imin()), None)
}

test "`Int::of_i128` and `Int::of_u128` convert a value that fits in an `Int` and fail on one that does not" {
  assert_eq(int_of(|| Int::of_i128(0i128 - 7i128)), Some(0 - 7));
  assert_eq(int_of(|| Int::of_u128(18446744073709551616u128)), None);
  assert_eq(to_int(imin()), None)
}
