fn caught(f: () -> U64 / {abort.raise}) -> Option<U64> =
  handle { Some(f()) } with { abort.raise(_) -> None }

test "an unsigned product, quotient and remainder use the whole 64 bits" {
  assert_eq(4294967296u64 * 4294967295u64, 18446744069414584320u64);
  assert_eq(18446744073709551615u64 / 7u64, 2635249153387078802u64);
  assert_eq(18446744073709551615u64 % 7u64, 1u64);
  assert_eq(18446744073709551615u64 / 9223372036854775808u64, 1u64);
  assert_eq(caught(|| 5u64 / (3u64 - 3u64)), None);
  assert_eq(caught(|| 5u64 % (3u64 - 3u64)), None)
}

test "a signed quotient goes toward zero and its remainder takes the dividend's sign" {
  assert_eq((0i64 - 100i64) / 7i64, 0i64 - 14i64);
  assert_eq((0i64 - 100i64) % 7i64, 0i64 - 2i64);
  assert_eq(100i64 / (0i64 - 7i64), 0i64 - 14i64);
  assert_eq((0i64 - 3037000499i64) * 3037000499i64, 0i64 - 9223372030926249001i64)
}
