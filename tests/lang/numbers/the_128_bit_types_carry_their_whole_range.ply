test "the top of U128" {
  let top = 340282366920938463463374607431768211455u128;
  assert_eq(top, 0xFFFF_FFFF_FFFF_FFFF_FFFF_FFFF_FFFF_FFFFu128);
  assert_eq(wrap_add(top, 1u128), 0u128);
  assert(top > 18446744073709551616u128);
  assert_eq(u128_to_string(top), "340282366920938463463374607431768211455")
}

test "I128 reaches past Int both ways" {
  let big = i128_of_int(9223372036854775807) * 4i128;
  assert_eq(i128_to_string(big), "36893488147419103228");
  assert_eq(i128_to_string(-big), "-36893488147419103228");
  assert_eq(big / 4i128, i128_of_int(9223372036854775807));
  assert_eq(int_of_i128(-4i128 * 2i128), -8);
  assert(-big < 0i128)
}

test "the bit operators act at 128 bits" {
  assert_eq(1u128 << 127, 170141183460469231731687303715884105728u128);
  assert_eq(~0u128, 340282366920938463463374607431768211455u128);
  assert_eq(1u128 << 127 >> 127, 1u128);
  assert_eq(-1i128 >> 100, -1i128);
  assert_eq(-1i128 >>> 127, 1i128);
  assert_eq(0xF0u128 << 64 | 0xFu128, 0xF0_0000_0000_0000_000Fu128)
}

test "a checked operation is None exactly where the type ends" {
  let root = 18446744073709551616u128;
  assert_eq(checked_mul(root, root), None);
  assert_eq(
    checked_mul(root, 18446744073709551615u128),
    Some(340282366920938463444927863358058659840u128),
  );
  assert_eq(checked_add(340282366920938463463374607431768211455u128, 1u128), None);
  assert_eq(checked_sub(0u128, 1u128), None);
  assert_eq(checked_neg(1u128), None);
  assert_eq(checked_neg(1i128), Some(-1i128));
  assert_eq(checked_add(9223372036854775807, 1), None);
  assert_eq(checked_sub(-3, 4), Some(-7));
  assert_eq(checked_mul(200u8, 2u8), None)
}

test "a string reads back to its value, and nothing else does" {
  assert_eq(
    u128_of_string("340282366920938463463374607431768211455"),
    Some(340282366920938463463374607431768211455u128),
  );
  assert_eq(u128_of_string("340282366920938463463374607431768211456"), None);
  assert_eq(
    i128_of_string("-170141183460469231731687303715884105728"),
    Some(-170141183460469231731687303715884105727i128 - 1i128),
  );
  assert_eq(i128_of_string("1e3"), None);
  assert_eq(u128_of_string("-1"), None);
  assert_eq(u128_of_string(""), None)
}

fn sign(n: I128) -> Int =
  match n { -1i128 -> -1, 0i128 -> 0, 18446744073709551616i128 -> 64, _ -> 1 }

test "a 128-bit literal pattern matches by value" {
  assert_eq(sign(-1i128), -1);
  assert_eq(sign(0i128), 0);
  assert_eq(sign(i128_of_int(4294967296) * i128_of_int(4294967296)), 64);
  assert_eq(sign(2i128), 1)
}

pub fn past_int() -> Int / {abort.raise} = int_of_u128(18446744073709551616u128)
pub fn over_u128() -> U128 = 340282366920938463463374607431768211455u128 + 1u128
pub fn negative_u128() -> U128 / {abort.raise} = u128_of_int(-1)
