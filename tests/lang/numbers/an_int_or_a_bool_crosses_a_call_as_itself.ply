//! An `Int` or a `Bool` crosses a call as itself: one too wide for a word to hold unboxed is not
//! boxed to be handed over or answered, through a generic definition or a loop's own calls.

fn wide() -> Int = 9000000000000000000

fn bumped(n: Int, by: Int) -> Int = n + by

fn above(n: Int, bound: Int) -> Bool = n > bound

fn same<a>(x: a) -> a = x

/// A call a round, each handed and answering an `Int` no word holds unboxed.
fn walked(n: Int, steps: Int) -> Int = if steps <= 0 { n } else { walked(bumped(n, 1), steps - 1) }

fn through(n: Int, steps: Int) -> Int = if steps <= 0 { n } else { through(same(n), steps - 1) }

fn risen(n: Int, steps: Int) -> Int =
  if steps <= 0 { 0 }
  else { (if above(bumped(n, steps), n) { 1 } else { 0 }) + risen(n, steps - 1) }

test "an int or a bool handed across a call is the value it was" {
  assert_eq(walked(wide(), 3), 9000000000000000003);
  assert_eq(walked(0 - wide(), 2), 2 - wide());
  assert_eq(through(wide(), 3), wide());
  assert_eq(risen(wide(), 5), 5);
  assert(above(wide(), 1));
  assert(!above(1, wide()));
  assert_eq(same(true), true)
}

test "an int too wide for a word is not boxed to cross a call" {
  let w = wide();
  assert_eq(metered(|| walked(w, 1000) - w).allocations, metered(|| walked(w, 10) - w).allocations);
  assert_eq(
    metered(|| through(w, 1000) - w).allocations,
    metered(|| through(w, 10) - w).allocations,
  );
  assert_eq(metered(|| risen(w, 1000)).allocations, metered(|| risen(w, 10)).allocations);
  assert_eq(metered(|| walked(w, 100) - w).live, 0)
}
