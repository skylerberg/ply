fn top() -> Int = 9223372036854775807

fn bottom() -> Int = -9223372036854775807 - 1

fn mix(h: U32, w: U32) -> U32 = (h ^ w) *% 0x0100_0193u32 +% rotl(h, 5)

fn sum(xs: List<U64>) -> U64 = fold(xs, 0u64, |acc: U64, x: U64| acc +% x)

fn clamped(xs: List<U8>) -> U8 = fold(xs, 0u8, |acc: U8, x: U8| acc +| x)

fn level(x: I8, by: I8) -> I8 = x -| by

test "a wrapping operator wraps where the type ends" {
  assert_eq(255u8 +% 1u8, 0u8);
  assert_eq(0u8 -% 1u8, 255u8);
  assert_eq(16u8 *% 16u8, 0u8);
  assert_eq(4294967295u32 +% 2u32, 1u32);
  assert_eq(0u32 -% 1u32, 4294967295u32);
  assert_eq(65536u32 *% 65536u32, 0u32);
  assert_eq(127i8 +% 1i8, i8_of_int(-128));
  assert_eq(i8_of_int(-128) -% 1i8, 127i8);
  assert_eq(0xFFFF_FFFF_FFFF_FFFFu64 +% 1u64, 0u64);
  assert_eq(0u64 -% 1u64, 0xFFFF_FFFF_FFFF_FFFFu64);
  assert_eq(340282366920938463463374607431768211455u128 +% 1u128, 0u128)
}

test "at Int a wrapping operator wraps at sixty-four bits" {
  assert_eq(top() +% 1, bottom());
  assert_eq(bottom() -% 1, top());
  assert_eq(top() *% 2, -2);
  assert_eq(1 +% 2, 3)
}

test "a saturating operator stops at the type's nearest value" {
  assert_eq(250u8 +| 10u8, 255u8);
  assert_eq(250u8 +| 5u8, 255u8);
  assert_eq(250u8 +| 4u8, 254u8);
  assert_eq(3u8 -| 10u8, 0u8);
  assert_eq(16u8 *| 16u8, 255u8);
  assert_eq(15u8 *| 17u8, 255u8);
  assert_eq(100i8 +| 100i8, 127i8);
  assert_eq(-100i8 +| -100i8, i8_of_int(-128));
  assert_eq(-100i8 -| 100i8, i8_of_int(-128));
  assert_eq(100i8 -| -100i8, 127i8);
  assert_eq(100i8 *| -2i8, i8_of_int(-128));
  assert_eq(-100i8 *| -2i8, 127i8);
  assert_eq(4294967295u32 *| 4294967295u32, 4294967295u32);
  assert_eq(-2147483647i32 *| 2i32, i32_of_int(-2147483648));
  assert_eq(0xFFFF_FFFF_FFFF_FFFFu64 +| 1u64, 0xFFFF_FFFF_FFFF_FFFFu64);
  assert_eq(0u64 -| 1u64, 0u64);
  assert_eq(0xFFFF_FFFF_FFFF_FFFFu64 *| 2u64, 0xFFFF_FFFF_FFFF_FFFFu64);
  assert_eq(9223372036854775807i64 +| 1i64, 9223372036854775807i64);
  assert_eq(-9223372036854775807i64 -| 2i64, i64_of_int(bottom()));
  assert_eq(-9223372036854775807i64 +| -2i64, i64_of_int(bottom()));
  assert_eq(9223372036854775807i64 -| -2i64, 9223372036854775807i64);
  assert_eq(9223372036854775807i64 *| -2i64, i64_of_int(bottom()));
  assert_eq(-9223372036854775807i64 *| -2i64, 9223372036854775807i64);
  assert_eq(5i64 *| -2i64, -10i64);
  assert_eq(
    340282366920938463463374607431768211455u128 +| 1u128,
    340282366920938463463374607431768211455u128,
  );
  assert_eq(0u128 -| 1u128, 0u128)
}

test "at Int a saturating operator stops at Int's ends" {
  assert_eq(top() +| 1, top());
  assert_eq(bottom() -| 1, bottom());
  assert_eq(bottom() +| -1, bottom());
  assert_eq(top() *| 2, top());
  assert_eq(top() *| -2, bottom());
  assert_eq(bottom() *| -1, top());
  assert_eq(2 +| 3, 5);
  assert_eq(2 -| 3, -1);
  assert_eq(2 *| 3, 6)
}

test "the operators bind as the arithmetic ones beside them, left to right" {
  assert_eq(250u8 +% 3u8 *% 2u8, 0u8);
  assert_eq(250u8 -% 255u8 +% 1u8, 252u8);
  assert_eq(250u8 -| 255u8 +| 1u8, 1u8);
  assert_eq(1u8 +| 2u8 *| 200u8, 255u8);
  assert_eq(2 + 3 *% 4 - 1, 13);
  assert_eq(1u8 +% 1u8 << 1, 4u8)
}

test "an operator is the call of its builtin, in a fold as anywhere" {
  assert_eq(255u8 +% 1u8, wrap_add(255u8, 1u8));
  assert_eq(250u8 +| 10u8, saturating_add(250u8, 10u8));
  assert_eq(3u8 -| 10u8, saturating_sub(3u8, 10u8));
  assert_eq(16u8 *| 16u8, saturating_mul(16u8, 16u8));
  assert_eq(fold([200u8, 100u8], 0u8, saturating_add), 255u8);
  assert_eq(fold([200, 100], 0, saturating_add), 300);
  assert_eq(sum([0xFFFF_FFFF_FFFF_FFFFu64, 2u64]), 1u64);
  assert_eq(clamped([200u8, 50u8, 50u8]), 255u8);
  assert_eq(level(-100i8, 100i8), i8_of_int(-128));
  assert_eq(
    mix(0x811C_9DC5u32, 0x61u32),
    rotl(0x811C_9DC5u32, 5) +% (0x811C_9DC5u32 ^ 0x61u32) *% 0x0100_0193u32,
  )
}
