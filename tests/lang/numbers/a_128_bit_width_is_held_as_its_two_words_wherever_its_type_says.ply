import std.show (show)

type Account = { balance: I128, id: Int, owner: String }

type Entry = | Credit(U128) | Transfer(Account, I128)

fn account(balance: I128) -> Account = { balance: balance, id: 7, owner: "o" }

fn credited(a: Account, by: I128) -> Account = { ..a, balance: a.balance + by }

fn twice<a>(x: a) -> a
  where numeric(a)
= x + x

fn boxed<a>(x: a) -> { v: a } = { v: x }

fn amount(e: Entry) -> I128 / {abort.raise} =
  match e { Credit(u) -> I128::of_int(Int::of_u128(u)), Transfer(a, by) -> a.balance - by }

fn doubled(x: U128, n: Int) -> U128 = if n <= 0 { x } else { doubled(x * 2u128, n - 1) }

fn edge() -> U128 = 18446744073709551615u128

test "a record with a 128-bit integer field reads, adds to and updates that field as a number" {
  let a = account(-5i128);
  let c = credited(a, 18446744073709551616i128);
  assert_eq(c.balance, 18446744073709551611i128);
  assert_eq(a.balance, -5i128);
  assert_eq(c.owner, "o");
  assert_eq(-c.balance, -18446744073709551611i128);
  assert_eq(boxed(edge() + 1u128).v, 18446744073709551616u128);
  assert_eq(boxed(account(1i128)).v.balance, 1i128)
}

test "128-bit arithmetic carries across both 64-bit words, and wrapping, saturating and checked operations give the expected results" {
  assert_eq(edge() + 1u128, 18446744073709551616u128);
  assert_eq(18446744073709551616u128 - 1u128, edge());
  assert_eq(edge() * edge(), 340282366920938463426481119284349108225u128);
  assert_eq(340282366920938463426481119284349108225u128 / edge(), edge());
  assert_eq(-7i128 % 3i128, -1i128);
  assert_eq(wrap_add(340282366920938463463374607431768211455u128, 2u128), 1u128);
  assert_eq(wrap_sub(0u128, 1u128), 340282366920938463463374607431768211455u128);
  assert_eq(wrap_mul(18446744073709551616u128, 18446744073709551616u128), 0u128);
  assert_eq(
    saturating_add(340282366920938463463374607431768211455u128, 9u128),
    340282366920938463463374607431768211455u128,
  );
  assert_eq(
    saturating_sub(-3i128, 170141183460469231731687303715884105727i128),
    -170141183460469231731687303715884105727i128 - 1i128,
  );
  assert_eq(
    saturating_mul(-18446744073709551616i128, 18446744073709551616i128 * 4i128),
    -170141183460469231731687303715884105727i128 - 1i128,
  );
  assert_eq(rotl(1u128, 127), 170141183460469231731687303715884105728u128);
  assert_eq(rotr(1u128, 1), 170141183460469231731687303715884105728u128);
  assert_eq(rotl(3u128 << 126, 2), 3u128);
  assert_eq((edge() & 0xFFu128 | 1u128 << 100) ^ 1u128, 0x10_0000_0000_0000_0000_0000_00FEu128);
  assert_eq(~edge(), 340282366920938463444927863358058659840u128);
  assert_eq(checked_mul(edge(), edge()), Some(340282366920938463426481119284349108225u128));
  assert_eq(checked_neg(-170141183460469231731687303715884105727i128 - 1i128), None);
  assert_eq(twice(edge()), 36893488147419103230u128);
  assert_eq(doubled(1u128, 100), 1u128 << 100)
}

test "a 128-bit width converts to and from an Int and text by value" {
  assert_eq(U128::of_int(9223372036854775807), 9223372036854775807u128);
  assert_eq(I128::of_int(-1), -1i128);
  assert_eq(Int::of_i128(-9223372036854775807i128 - 1i128), -9223372036854775807 - 1);
  assert_eq(Int::of_u128(edge() >> 1), 9223372036854775807);
  assert_eq(to_int(edge()), None);
  assert_eq(to_int(-9i128), Some(-9));
  assert_eq(numeric_of_int(100) + 0i128, 100i128);
  assert_eq(
    I128::of_string(I128::to_string(-18446744073709551617i128)),
    Some(-18446744073709551617i128),
  );
  assert_eq(U128::to_string(edge() * 2u128), "36893488147419103230")
}

test "128-bit integers compare as numbers and work as ordered map keys" {
  assert(edge() < edge() + 1u128);
  assert(-18446744073709551616i128 < -1i128);
  assert(1i128 > -18446744073709551616i128);
  assert(account(2i128) == account(2i128));
  assert(account(2i128) != account(18446744073709551618i128));
  assert_eq(compare(edge() + 1u128, edge()), Greater);
  assert_eq(min(-1i128, 18446744073709551616i128), -1i128);
  assert_eq(max(edge(), 1u128), edge());
  let by_size = Map::new().insert(edge() + 1u128, "b").insert(edge(), "a");
  assert_eq(by_size.first(), Some({ key: edge(), value: "a" }));
  assert_eq(by_size.get(18446744073709551616u128), Some("b"));
  assert_eq(digest(edge() + 1u128), digest(18446744073709551616u128))
}

test "arrays, lists and constructors store 128-bit integers and return them unchanged" {
  let xs = Array::of_list([1u128, edge(), edge() + 1u128]);
  assert_eq(xs.get(2), 18446744073709551616u128);
  assert_eq(xs.set(0, 9u128).to_list(), [9u128, edge(), 18446744073709551616u128]);
  assert_eq(xs.get(0), 1u128);
  assert_eq([edge(), 2u128].map(|x: U128| x + 1u128), [18446744073709551616u128, 3u128]);
  assert_eq([-1i128, 2i128].fold(0i128, |s: I128, x: I128| s + x), 1i128);
  assert_eq(amount(Credit(5u128)), 5i128);
  assert_eq(amount(Transfer(account(18446744073709551616i128), 16i128)), 18446744073709551600i128);
  assert_eq([Credit(1u128), Credit(2u128)].map(amount), [1i128, 2i128]);
  assert_eq(Some(edge()).map(|x: U128| x + 1u128), Some(18446744073709551616u128))
}

test "`show` prints a 128-bit integer as its decimal digits, alone and inside a record or constructor" {
  assert_eq(show(-18446744073709551616i128), "-18446744073709551616");
  assert_eq(show(account(-1i128)), "{balance: -1, id: 7, owner: \"o\"}");
  assert_eq(show(Credit(edge() + 1u128)), "Credit(18446744073709551616)")
}
