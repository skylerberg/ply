effect counter {
  read get[r]() -> Int
  write put[r](v: Int) -> Unit
  write note[r](v: Int) -> Unit
  read noted[r]() -> Int
}

fn bump() -> Unit / {counter.get[n], counter.put[n], clock.now} = {
  let seen = counter.get[n]();
  clock.now();
  counter.put[n](seen + 1)
}

fn noting() -> Unit / {counter.get[n], counter.note[m], clock.now} = {
  let seen = counter.get[n]();
  clock.now();
  counter.note[m](seen)
}

test "a scheduler spawns as many tasks as an earlier scheduler's race left, in every interleaving" {
  handle {
    simulate {
      let a = task.spawn(|| bump());
      let b = task.spawn(|| bump());
      task.join(a);
      task.join(b)
    };
    simulate {
      if counter.get[n]() == 2 {
        let a = task.spawn(|| noting());
        let b = task.spawn(|| noting());
        task.join(a);
        task.join(b)
      } else {
        let a = task.spawn(|| noting());
        task.join(a)
      }
    };
    assert_eq(counter.noted[m](), counter.get[n]())
  } with {
    var c = 0,
    var d = 0,
    counter.get[n]() -> c,
    counter.put[n](v) -> {
      c = v;
    },
    counter.note[m](v) -> {
      d = v;
    },
    counter.noted[m]() -> d,
  }
}
