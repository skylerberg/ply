//! A `String` is Unicode scalar values over UTF-8 bytes: its length and its slices count scalar
//! values, and bytes that are not UTF-8 are no `String` until a lossy reading replaces them.

test "a string is measured and cut by scalar value, and its bytes by byte" {
  let text = "héllo — ✓";
  assert_eq(String::of_bytes(Bytes::of_string(text)), text);
  assert_eq(text.len(), 9);
  assert_eq(Bytes::of_string(text).len(), 14);
  assert_eq(text.slice(0, 2), "hé")
}

test "a cut character is not UTF-8, and a lossy reading puts one replacement in its place" {
  let cut = Bytes::of_string("é").slice(0, 1);
  assert(!cut.is_utf8());
  assert_eq(String::of_bytes_lossy(cut), "\u{fffd}");
  assert_eq(String::of_bytes_lossy(cut).len(), 1)
}
