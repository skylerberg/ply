//! A string and its bytes share one block: the string read again after `Bytes::of_string` took its
//! bytes is as it was.

fn kept(s: String) -> Int = Bytes::of_string(s).len() + s.len()

test "a string read after its bytes are taken is as it was" {
  let s = "h\u{e9}llo" ++ "!";
  assert_eq(kept(s), 13);
  assert_eq(Bytes::of_string(s), b"h\xc3\xa9llo!")
}
