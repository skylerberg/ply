//! A string and its bytes share one block: `Bytes::of_string` copies nothing, and the string read
//! again afterwards is as it was.

fn joined(s: String) -> Int = Bytes::of_string(s).len()

fn kept(s: String) -> Int = Bytes::of_string(s).len() + s.len()

test "a string's bytes are its block" {
  let s = "hello" ++ "!";
  let m = metered(|| joined(s));
  assert_eq(m.value, 6);
  assert_eq(m.allocations, 0);
  assert_eq(m.live, 0)
}

test "a string read after its bytes are taken is as it was" {
  let s = "h\u{e9}llo" ++ "!";
  let m = metered(|| kept(s));
  assert_eq(m.value, 13);
  assert_eq(m.allocations, 0);
  assert_eq(Bytes::of_string(s), b"h\xc3\xa9llo!")
}
