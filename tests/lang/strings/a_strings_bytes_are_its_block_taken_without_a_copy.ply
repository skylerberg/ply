fn total_length(s: String) -> Int = Bytes::of_string(s).len() + s.len()

test "`Bytes::of_string` returns a string's bytes without copying, and the string still has its length and contents" {
  let s = "h\u{e9}llo" ++ "!";
  assert_eq(total_length(s), 13);
  assert_eq(Bytes::of_string(s), b"h\xc3\xa9llo!")
}
