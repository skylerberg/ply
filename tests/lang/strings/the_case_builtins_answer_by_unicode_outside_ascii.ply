// Longer than the text, a final sigma, an ASCII letter from a character that is not one.
test "`String::lower` and `String::upper` answer by Unicode's mappings outside ASCII" {
  let cases = [
    ("AbC1 é", "abc1 é", "ABC1 É"),
    ("straße", "straße", "STRASSE"),
    ("İ", "i\u{307}", "İ"),
    ("ΟΔΟΣ", "οδος", "ΟΔΟΣ"),
    ("Σ", "σ", "Σ"),
    ("\u{212A}", "k", "\u{212A}"),
    ("ſ", "ſ", "S"),
    ("ŉ", "ŉ", "\u{2BC}N"),
    ("ﬁ", "ﬁ", "FI"),
    ("ǆ", "ǆ", "Ǆ"),
    ("", "", ""),
  ];
  cases.fold((), |u: Unit, c: (String, String, String)|
    match c {
      (text, lower, upper) -> {
        assert_eq(text.lower(), lower);
        assert_eq(text.upper(), upper)
      },
    })
}
