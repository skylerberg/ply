//! A list a body is lent, and an item it read out of that list, held across a stop a clause resumes
//! more than once, are there for each resumption, whether one resumption updates the list and the
//! other only reads it, or a closure capturing the list is called after its handle returned. Two
//! branches of a parallel block read a list they are lent, one keeping an item of it.

effect amb {
  multi read flip() -> Bool
}

fn words(n: Int) -> List<String> = range(0, n).map(|i: Int| "w" ++ i.to_string())

fn first_of(xs: List<String>) -> String = match xs.at(0) { Some(s) -> s, None -> "" }

/// The first item read out of `xs`, then a stop; on `true` the list is updated, on `false` only read.
fn chosen(xs: List<String>) -> String / {abort.raise, amb.flip} = {
  let head = first_of(xs);
  if amb.flip() { head ++ "/" ++ first_of(xs.set(0, "changed")) }
  else { head ++ "/" ++ first_of(xs) }
}

fn updated_first(n: Int) -> List<String> / {abort.raise} =
  handle {
    [chosen(words(n))]
  } with {
    amb.flip() resume k -> {
      let first: List<String> = k(true);
      first.concat(k(false))
    },
  }

fn read_first(n: Int) -> List<String> / {abort.raise} =
  handle {
    [chosen(words(n))]
  } with {
    amb.flip() resume k -> {
      let first: List<String> = k(false);
      first.concat(k(true))
    },
  }

test "an item read out of a list, held across a stop with the list, is there for each resumption whichever updates the list" {
  assert_eq(updated_first(5), ["w0/changed", "w0/w0"]);
  assert_eq(read_first(5), ["w0/w0", "w0/changed"])
}

/// A stop under a call lent `xs`, whose answer is read out of it.
fn peeked(xs: List<String>) -> String / {amb.flip} = {
  let head = first_of(xs);
  if amb.flip() { head } else { head ++ "!" }
}

fn updated_after(n: Int) -> List<String> / {abort.raise} =
  handle {
    let xs = words(n);
    let p = peeked(xs);
    [p ++ "/" ++ first_of(xs.set(0, "changed")) ++ "/" ++ xs.len().to_string()]
  } with {
    amb.flip() resume k -> {
      let first: List<String> = k(true);
      first.concat(k(false))
    },
  }

test "a list lent to a call that stops, updated after it in each resumption, is as it was for the next" {
  assert_eq(updated_after(5), ["w0/changed/5", "w0!/changed/5"])
}

fn total(xs: List<String>) -> Int = xs.fold(0, |n: Int, s: String| n + s.len())

type Saved = | Done(Int) | Parked((Bool) -> Saved)

fn parked(xs: List<String>) -> Saved =
  handle {
    let count = || total(xs);
    Done(if amb.flip() { count() } else { count() + 1000 })
  } with {
    amb.flip() resume k -> Parked(k),
  }

fn again(s: Saved) -> List<Int> =
  match s {
    Parked(k) -> [k(true), k(false)].map(|d: Saved| match d { Done(n) -> n, Parked(_) -> 0 }),
    Done(n) -> [n],
  }

test "a closure capturing a list, called after its handle returned, lends the list to each resumption" {
  assert_eq(again(parked(words(12))), [26, 1026])
}

fn kept_one(xs: List<String>, i: Int) -> List<String> =
  match xs.at(i) { Some(s) -> [s], None -> [] }

fn read_and_kept(n: Int) -> Int = {
  let xs = words(n);
  let p = parallel { kept_one(xs, 3), total(xs) };
  if p._0 == ["w3"] { p._1 } else { 0 }
}

test "two branches read a list they are lent, one keeping an item of it" {
  range(0, 8).fold((), |u: Unit, i: Int| assert_eq(read_and_kept(100), 290))
}
