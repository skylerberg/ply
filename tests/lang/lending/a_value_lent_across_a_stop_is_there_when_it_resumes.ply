//! A list a body is lent, and an item it read out of that list, held across a stop a clause resumes
//! off its tail, are there when it resumes, whether the body then updates the list or only reads
//! it, or a closure capturing the list is called after its handle returned. Two branches of a
//! parallel block read a list they are lent, one keeping an item of it.

effect amb {
  read flip() -> Bool
}

fn words(n: Int) -> List<String> = range(0, n).map(|i: Int| "w" ++ i.to_string())

fn first_of(xs: List<String>) -> String = match xs.at(0) { Some(s) -> s, None -> "" }

/// The first item read out of `xs`, then a stop; on `true` the list is updated, on `false` only read.
fn chosen(xs: List<String>) -> String / {abort.raise, amb.flip} = {
  let head = first_of(xs);
  if amb.flip() { head ++ "/" ++ first_of(xs.set(0, "changed")) }
  else { head ++ "/" ++ first_of(xs) }
}

/// What `chosen` answers of `n` words, its stop resumed with `b` off the clause's tail.
fn resumed_with(n: Int, b: Bool) -> List<String> / {abort.raise} =
  handle {
    [chosen(words(n))]
  } with {
    amb.flip() resume k -> {
      let answer: List<String> = k(b);
      answer
    },
  }

test "an item read out of a list, held across a stop with the list, is there when it resumes, whether the list is then updated or only read" {
  assert_eq(resumed_with(5, true), ["w0/changed"]);
  assert_eq(resumed_with(5, false), ["w0/w0"])
}

/// A stop under a call lent `xs`, whose answer is read out of it.
fn peeked(xs: List<String>) -> String / {amb.flip} = {
  let head = first_of(xs);
  if amb.flip() { head } else { head ++ "!" }
}

fn updated_after(n: Int) -> List<String> / {abort.raise} =
  handle {
    let xs = words(n);
    let p = peeked(xs);
    [p ++ "/" ++ first_of(xs.set(0, "changed")) ++ "/" ++ xs.len().to_string()]
  } with {
    amb.flip() resume k -> {
      let answer: List<String> = k(true);
      answer
    },
  }

test "a list lent to a call that stops is whole when the body updates it after the resumption" {
  assert_eq(updated_after(5), ["w0/changed/5"])
}

fn total(xs: List<String>) -> Int = xs.fold(0, |n: Int, s: String| n + s.len())

type Saved = | Done(Int) | Parked(once (Bool) -> Saved)

fn parked(xs: List<String>) -> Saved =
  handle {
    let count = || total(xs);
    Done(if amb.flip() { count() } else { count() + 1000 })
  } with {
    amb.flip() resume k -> Parked(k),
  }

fn later(s: keep Saved) -> Int =
  match s { Parked(k) -> match k(false) { Done(n) -> n, Parked(again) -> 0 }, Done(n) -> n }

test "a closure capturing a list, called after its handle returned, lends the list to the resumption" {
  assert_eq(later(parked(words(12))), 1026)
}

fn kept_one(xs: List<String>, i: Int) -> List<String> =
  match xs.at(i) { Some(s) -> [s], None -> [] }

fn read_and_kept(n: Int) -> Int = {
  let xs = words(n);
  let p = parallel { kept_one(xs, 3), total(xs) };
  if p._0 == ["w3"] { p._1 } else { 0 }
}

test "two branches read a list they are lent, one keeping an item of it" {
  range(0, 8).fold((), |u: Unit, i: Int| assert_eq(read_and_kept(100), 290))
}
