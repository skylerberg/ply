//! A walk that only reads what it is handed allocates nothing and leaves nothing live: a tree
//! walked down both sides, and a wide record read by several calls in a row.

import std.pace (spent)

type Tree = | Leaf | Node(Tree, Int, Tree)

fn built(depth: Int, at: Int) -> Tree =
  if depth <= 0 { Leaf } else { Node(built(depth - 1, 2 * at), at, built(depth - 1, 2 * at + 1)) }

fn total(t: Tree) -> Int = match t { Leaf -> 0, Node(l, x, r) -> total(l) + x + total(r) }

test "a tree walked down both sides allocates nothing" {
  let t = built(8, 1);
  let m = spent(|| total(t));
  assert_eq(m.value, 32640);
  assert_eq(m.allocations, 0)
}

type Wide = { a: Int, b: Int, c: Int, d: Int, e: Int, f: Int, g: Int, h: Int, name: String }

fn sum_of(w: Wide) -> Int = w.a + w.b + w.c + w.d + w.e + w.f + w.g + w.h

fn named(w: Wide, wanted: String) -> Bool = w.name == wanted

test "a wide record read by five calls in a row answers each read and leaves nothing live" {
  let w = { a: 1, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 8, name: "wide" };
  let wanted = "wide";
  let sums = sum_of(w) + sum_of(w) + sum_of(w) + sum_of(w);
  assert_eq(if named(w, wanted) { sums } else { 0 }, 144)
}
