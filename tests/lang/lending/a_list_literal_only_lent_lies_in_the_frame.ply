//! A list literal that is only read or lent lies in its caller's frame: it allocates nothing and its
//! items stay its caller's. One something is read out of and kept is a block of its own.

fn sum_of(xs: List<Int>) -> Int = xs.fold(0, |s: Int, x: Int| s + x)

fn summed(n: Int) -> Int = sum_of([n, n + 1, n + 2])

fn first(xs: List<String>) -> String = match xs.at(0) { Some(x) -> x, None -> "" }

fn picked(s: String) -> String = first([s ++ "?", s])

fn lengths(s: String) -> Int = [s, s ++ "!", s].fold(0, |n: Int, t: String| n + t.len())

fn kept(n: Int) -> List<Int> = [n, n]

fn looped(i: Int, acc: Int) -> Int =
  if i <= 0 { acc } else { looped(i - 1, acc + sum_of([i, acc % 7])) }

test "a list literal lent to a reader allocates nothing" {
  let m = metered(|| summed(4));
  assert_eq(m.value, 15);
  assert_eq(m.allocations, 0);
  assert_eq(m.live, 0)
}

test "an item read out of a list literal outlives the list, and its items are let go once" {
  let m = metered(|| picked("x"));
  assert_eq(m.value, "x?");
  assert_eq(m.live, 1);
  let n = metered(|| lengths("hi"));
  assert_eq(n.value, 7);
  assert_eq(n.live, 0)
}

test "a list answered is a block of its own" {
  assert_eq(kept(3), [3, 3]);
  assert_eq(metered(|| kept(3).len()).live, 0)
}

test "bytes joined from a list literal answer as before" {
  let a = b"ab";
  let m = metered(|| Bytes::concat_all([a, b"c", a]));
  assert_eq(m.value, b"abcab");
  assert_eq(m.live, 1)
}

test "a temporary list made in each of a thousand iterations allocates nothing" {
  let m = metered(|| looped(1000, 0));
  assert_eq(m.allocations, 0);
  assert_eq(m.live, 0)
}
