//! A value read out of another stays what it was after the other is handed on, updated or let go
//! of: a field read out of a record a call then keeps, an item read out of a list then updated, and
//! a payload read out of an `Option` then dropped. Each run lets go of all it made.

type Named = { name: String, n: Int }

fn kept(r: Named) -> List<Named> = [r]

test "a field read out of a record a call then keeps is still that field" {
  let m = metered(|| {
    let r = { name: "x" ++ Int::to_string(7), n: 1 };
    let name = r.name;
    let held = kept(r);
    if name == "x7" && held.len() == 1 { 1 } else { 0 }
  });
  assert_eq(m.value, 1);
  assert_eq(m.live, 0)
}

test "an item read out of a list then updated keeps its value, and the list its update" {
  let m = metered(|| {
    let xs = range(0, 50).map(|i: Int| Int::to_string(i));
    let y = match xs.at(3) { Some(s) -> s, None -> "" };
    let ys = xs.set(3, "three");
    if y == "3" && ys.at(3) == Some("three") && ys.len() == 50 { 1 } else { 0 }
  });
  assert_eq(m.value, 1);
  assert_eq(m.live, 0)
}

fn first_word(o: Option<String>) -> String = match o { Some(s) -> s, None -> "" }

test "a payload read out of an option is its own once the option is let go of" {
  let m = metered(|| {
    let o = Some("y" ++ Int::to_string(9));
    let w = first_word(o);
    if w == "y9" { 1 } else { 0 }
  });
  assert_eq(m.value, 1);
  assert_eq(m.live, 0)
}
