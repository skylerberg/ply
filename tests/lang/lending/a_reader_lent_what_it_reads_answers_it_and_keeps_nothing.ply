//! A function lent what it reads answers what it read and keeps nothing: a fold over a list, a loop of
//! lookups into a map, a generic reader at three types and a record of twenty words read by five calls
//! in a row allocate nothing. What a reader answers out of a value it was lent outlives that value,
//! whether the value is updated afterwards or was made only for the call.

fn longest(xs: List<String>) -> Int =
  xs.fold(0, |n: Int, s: String| if s.len() > n { s.len() } else { n })

test "a fold over a list it is lent reads every item and allocates nothing" {
  let xs = range(0, 200).map(|i: Int| i.to_string());
  let m = metered(|| longest(xs) + longest(xs));
  assert_eq(m.value, 6);
  assert_eq(m.allocations, 0);
  assert_eq(m.live, 0)
}

fn found(m: Map<Int, String>, k: Int, n: Int, acc: Int) -> Int =
  if k >= n { acc }
  else { found(m, k + 1, n, acc + (match m.get(k) { Some(s) -> s.len(), None -> 0 })) }

test "a loop of lookups into a map it is lent finds each key and allocates nothing" {
  let words = range(0, 100).fold(Map::new(), |acc: Map<Int, String>, i: Int|
    acc.insert(i, i.to_string()));
  let m = metered(|| found(words, 0, 120, 0));
  assert_eq(m.value, 190);
  assert_eq(m.allocations, 0);
  assert_eq(m.live, 0)
}

test "an entry read out of a map then updated keeps its value, and the map its update" {
  let m = metered(|| {
    let words = range(0, 50).fold(Map::new(), |acc: Map<Int, String>, i: Int|
      acc.insert(i, i.to_string()));
    let y = match words.get(3) { Some(s) -> s, None -> "" };
    let more = words.insert(3, "three");
    if y == "3" && more.get(3) == Some("three") && more.len() == 50 { 1 } else { 0 }
  });
  assert_eq(m.value, 1);
  assert_eq(m.live, 0)
}

fn first_or<a>(xs: List<a>, otherwise: a) -> a = match xs.at(0) { Some(x) -> x, None -> otherwise }

type Named = { name: String, n: Int }

test "a generic reader answers at an Int, a String and a record, and leaves nothing live" {
  let ints = [4, 5];
  let names = ["a" ++ Int::to_string(1), "b"];
  let records = [{ name: "r" ++ Int::to_string(2), n: 2 }];
  let m = metered(|| {
    let i = first_or(ints, 0);
    let s = first_or(names, "");
    let r = first_or(records, { name: "", n: 0 });
    let none = first_or([], "none");
    if i == 4 && s == "a1" && r.name == "r2" && none == "none" { r.n } else { 0 }
  });
  assert_eq(m.value, 2);
  assert_eq(m.live, 0)
}

type Twenty = {
  a: Int,
  b: Int,
  c: Int,
  d: Int,
  e: Int,
  f: Int,
  g: Int,
  h: Int,
  i: Int,
  j: Int,
  k: Int,
  l: Int,
  m: Int,
  n: Int,
  o: Int,
  p: Int,
  q: Int,
  r: Int,
  s: Int,
  name: String,
}

fn ends(w: Twenty) -> Int = w.a + w.s

fn middle(w: Twenty) -> Int = w.j + w.name.len()

test "a record of twenty words read by five calls in a row allocates nothing" {
  let w = {
    a: 1,
    b: 2,
    c: 3,
    d: 4,
    e: 5,
    f: 6,
    g: 7,
    h: 8,
    i: 9,
    j: 10,
    k: 11,
    l: 12,
    m: 13,
    n: 14,
    o: 15,
    p: 16,
    q: 17,
    r: 18,
    s: 19,
    name: "twenty" ++ Int::to_string(20),
  };
  let m = metered(|| ends(w) + middle(w) + ends(w) + middle(w) + ends(w));
  assert_eq(m.value, 3 * 20 + 2 * 18);
  assert_eq(m.allocations, 0);
  assert_eq(m.live, 0)
}

fn second(xs: List<String>) -> String = match xs.at(1) { Some(s) -> s, None -> "" }

fn name_of(r: Named) -> String = r.name

test "what a reader answers out of a value made only for the call outlives the value" {
  let m = metered(|| {
    let s = second(range(0, 10).map(|i: Int| "item" ++ i.to_string()));
    let n = name_of({ name: "n" ++ Int::to_string(3), n: 3 });
    if s == "item1" && n == "n3" { 1 } else { 0 }
  });
  assert_eq(m.value, 1);
  assert_eq(m.live, 0)
}
