//! `b.at(f(b))` reads `b` twice in one call, and the second read is the last: a backend
//! that moves a binding out at its last read must not have handed the first read the emptied slot.
//! The buffer is a named parameter, a lambda's capture, a lambda returns the final byte of its own `Bytes` parameter, and a field of
//! a captured record.

fn last(b: Bytes) -> Int / {abort.raise} = b.at(b.len() - 1)

fn trailing_zeros(b: Bytes) -> Int / {abort.raise} =
  range(0, b.len()).fold(0, |acc: Int, i: Int|
    if b.at(b.len() - 1 - i) == 48 && acc == i { acc + 1 } else { acc })

fn last_of(b: Bytes) -> Int / {abort.raise} =
  [b].fold(0, |acc: Int, x: Bytes| acc + x.at(x.len() - 1))

fn tail_sum(r: { xs: Bytes, n: Int }) -> Int / {abort.raise} =
  range(0, r.n).fold(0, |acc: Int, i: Int| acc + r.xs.at(r.xs.len() - 1 - i))

test "a parameter" { assert_eq(last(b"xyz"), 122) }

test "trailing zeros" { assert_eq(trailing_zeros(b"1.500"), 2) }

test "a lambda returns the final byte of its own `Bytes` parameter" { assert_eq(last_of(b"xyz"), 122) }

test "a lambda reads the `Bytes` field of a record it captured" { assert_eq(tail_sum({ xs: b"abc", n: 3 }), 294) }
