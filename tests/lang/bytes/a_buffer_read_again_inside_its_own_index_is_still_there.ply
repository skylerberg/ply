fn last(b: Bytes) -> Int / {abort.raise} = b.at(b.len() - 1)

fn trailing_zeros(b: Bytes) -> Int / {abort.raise} =
  range(0, b.len()).fold(0, |accumulator: Int, i: Int|
    if b.at(b.len() - 1 - i) == 48 && accumulator == i { accumulator + 1 } else { accumulator })

fn last_of(b: Bytes) -> Int / {abort.raise} =
  [b].fold(0, |accumulator: Int, x: Bytes| accumulator + x.at(x.len() - 1))

fn tail_sum(r: { xs: Bytes, n: Int }) -> Int / {abort.raise} =
  range(0, r.n).fold(0, |accumulator: Int, i: Int| accumulator + r.xs.at(r.xs.len() - 1 - i))

test "a parameter" { assert_eq(last(b"xyz"), 122) }

test "trailing zeros" { assert_eq(trailing_zeros(b"1.500"), 2) }

test "a lambda returns the final byte of its own `Bytes` parameter" {
  assert_eq(last_of(b"xyz"), 122)
}

test "a lambda reads the `Bytes` field of a record it captured" {
  assert_eq(tail_sum({ xs: b"abc", n: 3 }), 294)
}
