// `bytes_at(b, f(b))` reads `b` twice in one call, and the second read is the last: a tier that
// moves a binding out at its last read must not have handed the first read the emptied slot.
// The buffer is a named parameter, a lambda's capture, a lambda's own parameter, and a field of
// a captured record.

fn last(b: Bytes) -> Int = bytes_at(b, bytes_len(b) - 1)

fn trailing_zeros(b: Bytes) -> Int =
  fold(range(0, bytes_len(b)), 0, |acc: Int, i: Int|
    if bytes_at(b, bytes_len(b) - 1 - i) == 48 && acc == i { acc + 1 } else { acc })

fn last_of(b: Bytes) -> Int = fold([b], 0, |acc: Int, x: Bytes| acc + bytes_at(x, bytes_len(x) - 1))

fn ends(r: { xs: Bytes, n: Int }) -> Int =
  fold(range(0, r.n), 0, |acc: Int, i: Int| acc + bytes_at(r.xs, bytes_len(r.xs) - 1 - i))

test "a parameter" { assert_eq(last(b"xyz"), 122) }

test "trailing zeros" { assert_eq(trailing_zeros(b"1.500"), 2) }

test "a lambda's own parameter" { assert_eq(last_of(b"xyz"), 122) }

test "a captured record's field" { assert_eq(ends({ xs: b"abc", n: 3 }), 294) }
