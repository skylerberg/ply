fn caught<a>(f: () -> a / {abort.raise}) -> Result<a, String> =
  handle { f() } with { abort.raise(m) -> Err(m), return v -> Ok(v) }

test "a start past the end and a negative budget raise" {
  assert_eq(
    caught(|| b"abc".scan(9, b"a", 1)),
    Err("`Bytes::scan` start 9 is outside a value of 3 bytes"),
  );
  assert_eq(
    caught(|| b"abc".scan(0, b"a", -1)),
    Err("`Bytes::scan` was given a negative budget of -1"),
  )
}

test "what is no byte and an empty separator raise" {
  assert_eq(
    caught(|| b"abc".index_of_byte(256)),
    Err("`Bytes::index_of_byte` was given 256, which is not a byte"),
  );
  assert_eq(
    caught(|| b"abc".split(b"")),
    Err("`Bytes::split` needs a separator, and this one is empty"),
  )
}
