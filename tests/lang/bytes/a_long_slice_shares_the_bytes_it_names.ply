//! A long slice of a bytes value is a view of its bytes rather than a copy, and reads, compares,
//! keys a map and grows as the bytes it names: what it views is left as it was.

fn text(n: Int) -> Bytes =
  fold(range(0, n), b"", |acc: Bytes, i: Int| bytes_concat(acc, byte_of_int(i % 256)))

fn grown(b: Bytes) -> Bytes = bytes_concat(b, b"!")

test "a slice reads back the bytes it names, and a slice of it the ones it names" {
  let all = text(300);
  let middle = bytes_slice(all, 100, 250);
  assert_eq(bytes_len(middle), 150);
  assert_eq(bytes_at(middle, 0), 100);
  assert_eq(bytes_u32_le(middle, 1), bytes_u32_le(all, 101));
  let inner = bytes_slice(middle, 10, 90);
  assert_eq(inner, bytes_slice(all, 110, 190));
  assert_eq(bytes_slice(middle, 0, 150), middle);
  assert_eq(bytes_slice(inner, 2, 4), bytes_concat(byte_of_int(112), byte_of_int(113)))
}

test "growing a slice copies it and leaves what it views as it was" {
  let all = text(300);
  let middle = bytes_slice(all, 0, 200);
  let more = grown(middle);
  assert_eq(bytes_len(more), 201);
  assert_eq(bytes_len(all), 300);
  assert_eq(bytes_at(all, 200), 200);
  assert_eq(bytes_slice(more, 0, 200), middle)
}

test "a slice compares and keys a map as its bytes do" {
  let all = text(300);
  let a = bytes_slice(all, 0, 100);
  let b = bytes_slice(bytes_concat(text(100), b"tail"), 0, 100);
  assert(a == b);
  let keyed = map_insert(map_insert(map_new(), a, 1), b, 2);
  assert_eq(map_len(keyed), 1);
  assert_eq(map_get(keyed, text(100)), Some(2))
}
