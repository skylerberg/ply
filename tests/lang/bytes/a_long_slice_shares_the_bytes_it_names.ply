fn text(n: Int) -> Bytes =
  range(0, n).fold(b"", |accumulator: Bytes, i: Int| accumulator.concat(byte_of_int(i % 256)))

fn grown(b: Bytes) -> Bytes = b.concat(b"!")

test "`slice` returns the bytes in the given range, and slicing a slice returns the matching bytes of the original" {
  let all = text(300);
  let middle = all.slice(100, 250);
  assert_eq(middle.len(), 150);
  assert_eq(middle.at(0), 100);
  assert_eq(middle.u32_le(1), all.u32_le(101));
  let inner = middle.slice(10, 90);
  assert_eq(inner, all.slice(110, 190));
  assert_eq(middle.slice(0, 150), middle);
  assert_eq(inner.slice(2, 4), byte_of_int(112).concat(byte_of_int(113)))
}

test "growing a slice copies it and leaves the original bytes unchanged" {
  let all = text(300);
  let middle = all.slice(0, 200);
  let more = grown(middle);
  assert_eq(more.len(), 201);
  assert_eq(all.len(), 300);
  assert_eq(all.at(200), 200);
  assert_eq(more.slice(0, 200), middle)
}

test "a slice compares and keys a map as its bytes do" {
  let all = text(300);
  let a = all.slice(0, 100);
  let b = text(100).concat(b"tail").slice(0, 100);
  assert(a == b);
  let keyed = Map::new().insert(a, 1).insert(b, 2);
  assert_eq(keyed.len(), 1);
  assert_eq(keyed.get(text(100)), Some(2))
}
