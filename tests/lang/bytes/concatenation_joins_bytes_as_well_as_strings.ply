// `++` answers the type both sides share, and on `Bytes` that is the join `bytes_concat` names.

fn joined(a: Bytes, b: Bytes) -> Bytes = a ++ b

fn rolled(parts: List<Bytes>) -> Bytes = fold(parts, b"", |acc: Bytes, p: Bytes| acc ++ p)

test "`++` on Bytes answers what `bytes_concat` answers" {
  assert_eq(joined(b"ab", b"cd"), bytes_concat(b"ab", b"cd"));
  assert_eq(joined(b"", b"x"), b"x");
  assert_eq(joined(b"x", b""), b"x");
  assert_eq(joined(b"\x00\xff", b"\x01"), b"\x00\xff\x01");
  assert_eq(bytes_len(joined(b"\x00\xff", b"\x01")), 3)
}

// The accumulator is the only holder of its buffer, which is the path that appends in place.
test "a fold over `++` joins every piece in order" {
  assert_eq(rolled([b"a", b"b", b"c"]), bytes_concat_all([b"a", b"b", b"c"]));
  assert_eq(rolled([]), b"");
  assert_eq(rolled([b"12", b"345"]), b"12345")
}

test "`++` still joins Strings" {
  assert_eq("ab" ++ "cd", string_concat("ab", "cd"))
}
