fn joined(a: Bytes, b: Bytes) -> Bytes = a ++ b

fn fold_concat(parts: List<Bytes>) -> Bytes =
  parts.fold(b"", |accumulator: Bytes, p: Bytes| accumulator ++ p)

test "`++` on Bytes returns what `Bytes::concat` returns" {
  assert_eq(joined(b"ab", b"cd"), b"ab".concat(b"cd"));
  assert_eq(joined(b"", b"x"), b"x");
  assert_eq(joined(b"x", b""), b"x");
  assert_eq(joined(b"\x00\xff", b"\x01"), b"\x00\xff\x01");
  assert_eq(joined(b"\x00\xff", b"\x01").len(), 3)
}

test "a fold over `++` joins every piece in order" {
  assert_eq(fold_concat([b"a", b"b", b"c"]), Bytes::concat_all([b"a", b"b", b"c"]));
  assert_eq(fold_concat([]), b"");
  assert_eq(fold_concat([b"12", b"345"]), b"12345")
}

test "`++` still joins Strings" { assert_eq("ab" ++ "cd", "ab".concat("cd")) }
