fn opens(b: Bytes) -> Bool / {abort.raise} = bytes_len(b) > 0 && bytes_at(b, 0) == b'{'

fn written() -> List<Int> = [b'a', b'Z', b'0', b' ', b'~', b'"', b'{', b'}', b'(', b')']

fn escaped() -> List<Int> =
  [b'\n', b'\t', b'\r', b'\0', b'\\', b'\'', b'\"', b'\x00', b'\x7f', b'\xFF']

test "a byte literal is what bytes_at answers for that byte" {
  assert_eq(b'{', 123);
  assert_eq(b'{', bytes_at(b"{", 0));
  assert_eq(written(), map(range(0, 10), |i: Int| bytes_at(b"aZ0 ~\"{}()", i)));
  assert(opens(b"{}"));
  assert(!opens(b"[]"))
}

test "a byte literal takes a byte string's escapes, and a quote of either kind" {
  assert_eq(escaped(), [10, 9, 13, 0, 92, 39, 34, 0, 127, 255]);
  assert_eq(escaped(), map(range(0, 10), |i: Int| bytes_at(b"\n\t\r\0\\'\"\x00\x7f\xff", i)))
}

test "a byte literal is an Int wherever one stands" {
  assert_eq(b'a' + 1, b'b');
  assert_eq(b'z' - b'a', 25);
  assert_eq(byte_of_int(b'A' | 32), b"a");
  assert_eq(match b'x' { b'x' -> 1, _ -> 0 }, 1)
}
