fn starts_with_brace(b: Bytes) -> Bool / {abort.raise} = b.len() > 0 && b.at(0) == b'{'

fn written() -> List<Int> = [b'a', b'Z', b'0', b' ', b'~', b'"', b'{', b'}', b'(', b')']

fn escaped() -> List<Int> =
  [b'\n', b'\t', b'\r', b'\0', b'\\', b'\'', b'\"', b'\x00', b'\x7f', b'\xFF']

test "a byte literal is what `Bytes::at` returns for that byte" {
  assert_eq(b'{', 123);
  assert_eq(b'{', b"{".at(0));
  assert_eq(written(), range(0, 10).map(|i: Int| b"aZ0 ~\"{}()".at(i)));
  assert(starts_with_brace(b"{}"));
  assert(!starts_with_brace(b"[]"))
}

test "a byte literal takes a byte string's escapes, and a quote of either kind" {
  assert_eq(escaped(), [10, 9, 13, 0, 92, 39, 34, 0, 127, 255]);
  assert_eq(escaped(), range(0, 10).map(|i: Int| b"\n\t\r\0\\'\"\x00\x7f\xff".at(i)))
}

test "a byte literal can be used anywhere an `Int` is expected, including arithmetic and match patterns" {
  assert_eq(b'a' + 1, b'b');
  assert_eq(b'z' - b'a', 25);
  assert_eq(byte_of_int(b'A' | 32), b"a");
  assert_eq(match b'x' { b'x' -> 1, _ -> 0 }, 1)
}
