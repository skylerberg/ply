fn fold_index_of(hay: Bytes, byte: Int, from: Int) -> Int / {abort.raise} =
  range(from, hay.len()).fold(-1, |found, i|
    if found >= 0 { found } else if hay.at(i) == byte { i } else { found })

fn fold_head_end(head: Bytes) -> Int / {abort.raise} =
  range(0, head.len() - 3).fold(-1, |found, i|
    if found >= 0 { found }
    else if head.at(i) == 13 && head.at(i + 1) == 10 && head.at(i + 2) == 13
        && head.at(i + 3) == 10 { i + 4 }
    else { found })

fn fold_all_upper(b: Bytes) -> Bool / {abort.raise} =
  range(0, b.len()).fold(true, |ok, i| ok && b.at(i) >= 65 && b.at(i) <= 90)

fn native_index_of(hay: Bytes, set: Bytes, from: Int) -> Int / {abort.raise} =
  if from > hay.len() { -1 } else {
    let at = hay.scan_until(from, set, hay.len());
    if at >= hay.len() { -1 } else { at }
  }

fn native_head_end(head: Bytes) -> Int =
  match head.index_of(b"\r\n\r\n") { Some(at) -> at + 4, None -> -1 }

fn native_all_upper(b: Bytes) -> Bool / {abort.raise} =
  b.scan(0, b"ABCDEFGHIJKLMNOPQRSTUVWXYZ", b.len()) == b.len()

fn heads() -> List<Bytes> =
  [
    b"",
    b"\r\n\r\n",
    b"GET / HTTP/1.1\r\nHost: localhost\r\n\r\n",
    b"POST /orders HTTP/1.1\r\nContent-Length: 5\r\n\r\nhello",
    b"GET / HTTP/1.1\r\nHost: x\r\n",
    b"GET / HTTP/1.1\r\n\r\nGET / HTTP/1.1\r\n\r\n",
    b"\r\n",
    b"\r",
    b"GET /\xff\xfe HTTP/1.1\r\n\r\n",
  ]

fn methods() -> List<Bytes> = [b"", b"GET", b"get", b"GEt", b"P0ST", b"OPTIONS"]

test "the native searches return what the folds returned" {
  assert_eq(heads().map(|h| native_head_end(h)), heads().map(|h| fold_head_end(h)));
  assert_eq(
    heads().map(|h| native_index_of(h, b"\n", 0)),
    heads().map(|h| fold_index_of(h, 10, 0)),
  );
  assert_eq(heads().map(|h| native_index_of(h, b" ", 4)), heads().map(|h| fold_index_of(h, 32, 4)));
  assert_eq(methods().map(|m| native_all_upper(m)), methods().map(|m| fold_all_upper(m)))
}
