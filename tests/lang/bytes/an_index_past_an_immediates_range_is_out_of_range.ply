fn min_int() -> Int = 0 - 9223372036854775807 - 1

fn byte_at(b: Bytes, i: Int) -> Int / {abort.raise} = b.at(i)

fn space_from(b: Bytes, from: Int) -> Int / {abort.raise} =
  match b.position(from, |c: Int| c == 32) { Some(i) -> i, None -> -1 }

fn raised(f: () -> Int / {abort.raise}) -> Bool =
  match try[abort.raise] { f() } { Ok(_) -> false, Err(_) -> true }

test "`Bytes::at` raises for an index outside the runtime's small-integer range" {
  assert(raised(|| byte_at(b"ab c", min_int())), None);
  assert(raised(|| byte_at(b"ab c", 9223372036854775807)), None);
  assert(raised(|| byte_at(b"ab c", 4611686018427387904)), None)
}

test "`Bytes::position` raises for a start index outside the runtime's small-integer range" {
  assert(raised(|| space_from(b"ab c", min_int())), None);
  assert_eq(space_from(b"ab c", 0), 2)
}

test "a lambda calling `Bytes::at` raises for an out-of-range index, like a named function" {
  let at = |b: Bytes, i: Int| b.at(i);
  assert(
    match try[abort.raise] { at(b"ab c", min_int()) } { Ok(_) -> false, Err(_) -> true },
    None,
  );
  assert_eq(at(b"ab c", 1), 98)
}
