//! An index too large or too small for an `Int` held in the word is out of range of any buffer, and
//! raises as one; it is never wrapped into another index that may be in range.

fn least() -> Int = 0 - 9223372036854775807 - 1

fn byte_at(b: Bytes, i: Int) -> Int / {abort.raise} = b.at(i)

fn space_from(b: Bytes, from: Int) -> Int / {abort.raise} =
  match b.position(from, |c: Int| c == 32) { Some(i) -> i, None -> -1 }

fn raised(f: () -> Int / {abort.raise}) -> Bool =
  match try[abort.raise] { f() } { Ok(_) -> false, Err(_) -> true }

test "bytes_at raises at an index past what the word holds" {
  assert(raised(|| byte_at(b"ab c", least())), None);
  assert(raised(|| byte_at(b"ab c", 9223372036854775807)), None);
  assert(raised(|| byte_at(b"ab c", 4611686018427387904)), None)
}

test "bytes_position raises at a start past what the word holds" {
  assert(raised(|| space_from(b"ab c", least())), None);
  assert_eq(space_from(b"ab c", 0), 2)
}

test "a lambda over bytes raises there as a function does" {
  let at = |b: Bytes, i: Int| b.at(i);
  assert(match try[abort.raise] { at(b"ab c", least()) } { Ok(_) -> false, Err(_) -> true }, None);
  assert_eq(at(b"ab c", 1), 98)
}
