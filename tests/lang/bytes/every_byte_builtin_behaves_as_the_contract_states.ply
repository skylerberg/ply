fn head() -> Bytes = b"GET /orders?id=7 HTTP/1.1\r\nHost: x\r\n\r\nbody"

/// How many times a test's callbacks were asked.
effect asks {
  write one() -> Unit
  read so_far() -> Int
}

/// `body` with a count of what it asks, from none.
fn counted<a | e>(body: () -> a / {asks.one, asks.so_far | e}) -> a / e =
  handle {
    body()
  } with {
    var n = 0,
    asks.one() -> {
      n = n + 1;
    },
    asks.so_far() -> n,
  }

test "index_of finds the first occurrence and says so with an Option" {
  assert_eq(head().index_of(b"\r\n\r\n"), Some(34));
  assert_eq(head().index_of(b"nowhere"), None);
  assert_eq(head().index_of(b""), Some(0));
  assert_eq(b"".index_of(b""), Some(0));
  assert_eq(b"".index_of(b"a"), None)
}

test "index_of_from resumes a search and returns an absolute index" {
  assert_eq(head().index_of_from(b"\r\n", 0), Some(25));
  assert_eq(head().index_of_from(b"\r\n", 26), Some(34));
  assert_eq(head().index_of_from(b"\r\n", 38), None);
  assert_eq(head().index_of_from(b"", head().len()), Some(42))
}

test "index_of_byte takes a byte and finds it" {
  assert_eq(head().index_of_byte(63), Some(11));
  assert_eq(head().index_of_byte(255), None)
}

test "starts_with and ends_with exit at the first mismatch" {
  assert(head().starts_with(b"GET "));
  assert(head().starts_with(b""));
  assert(!head().starts_with(b"POST"));
  assert(head().ends_with(b"body"));
  assert(!head().ends_with(b"HEAD"))
}

test "split keeps the empty pieces a join needs" {
  assert_eq(b"a,b,c".split(b","), [b"a", b"b", b"c"]);
  assert_eq(b"".split(b","), [b""]);
  assert_eq(b",a,".split(b","), [b"", b"a", b""]);
  assert_eq(b"abc".split(b","), [b"abc"])
}

test "a scan stops off its class and scan_until stops on it" {
  assert_eq(head().scan_until(0, b" ", 25), 3);
  assert_eq(head().scan(4, b"/ordes?=i", 25), 15);
  assert_eq(head().scan(15, b"0123456789", 25), 16)
}

// The budget is the whole reason `max` is an argument: a caller tells a class
// ending from a bound running out by comparing against `from + max`, and
// neither result is a sentinel that a careless program hands to `Bytes::slice`.
test "a scan that spends its budget returns the budget" {
  assert_eq(head().scan_until(0, b"y", 4), 4);
  assert_eq(head().scan_until(0, b"y", 100), 41);
  assert_eq(head().scan_until(0, b"z", 100), head().len())
}

test "position is the escape hatch and stops at the first byte it accepts" {
  assert_eq(head().position(0, |b| b == 63), Some(11));
  assert_eq(head().position(12, |b| b == 63), None);
  assert_eq(b"".position(0, |b| true), None)
}

fn first_of(wanted: List<Int>, b: Bytes) -> Option<Int> / {abort.raise} =
  b.position(0, |x: Int| wanted.contains(x))

test "a predicate that captures is the same function at every byte a position reads" {
  assert_eq(first_of([63, 32], head()), Some(3));
  assert_eq(first_of([126], head()), None)
}

// A predicate that performs is why this is a frame rather than host recursion,
// and the counter proves the search stopped rather than ran to the end.
test "a position predicate may perform, and the search still exits early" {
  counted(|| {
    let at = handle {
      head().position(0, |b| {
        asks.one();
        b == 32
      })
    } with {
      return x -> x,
    };
    assert_eq(at, Some(3));
    assert_eq(asks.so_far(), 4)
  })
}
