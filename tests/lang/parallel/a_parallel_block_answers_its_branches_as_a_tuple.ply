fn fib(n: Int) -> Int = if n < 2 { n } else { fib(n - 1) + fib(n - 2) }

fn pair(n: Int) -> (Int, Int) = parallel { fib(n), fib(n + 1) }

// Each split halves the span, so 64 splits reach any `Int` span's leaves.
fn summed(lo: Int, hi: Int, depth: Int) -> Int =
  if hi - lo <= 64 || depth <= 0 { range(lo, hi).fold(0, |acc: Int, i: Int| acc + i) } else {
    let mid = (lo + hi) / 2;
    let p = parallel { summed(lo, mid, depth - 1), summed(mid, hi, depth - 1) };
    p._0 + p._1
  }

fn lengths(n: Int) -> Int = {
  let words = range(0, n).map(|i: Int| "w" ++ i.to_string());
  let p = parallel {
    words.filter(|w: String| w.len() > 2).len(),
    words.fold(0, |acc: Int, w: String| acc + w.len()),
  };
  p._0 + p._1 + words.len()
}

fn failing(n: Int) -> Int / {abort.raise} = {
  let p = parallel {
    if fib(n) > 0 { panic("the left branch") } else { 0 },
    panic("the right branch"),
  };
  p._0 + p._1
}

fn scalars(n: Int) -> (Int, Float, Bool, U64) =
  parallel { n * 4096, Float::of_int(n) / 2.0, n > 0, 18446744073709551615u64 }

fn caught<a>(f: () -> a / {abort.raise}) -> Result<a, String> =
  handle { f() } with { abort.raise(m) -> Err(m), return v -> Ok(v) }

// Blocks nest: each level's branches run at once, inside a branch of the level above.
test "a block returns its branches as a tuple, nested or not" {
  assert_eq(pair(20), (6765, 10946));
  assert_eq(summed(0, 100000, 64), 4999950000)
}

// A scalar's answer is its own bits, which may read as an object's address.
test "a block hands back each branch's result as it was, and keeps none of them" {
  assert_eq(scalars(3), (12288, 1.5, true, 18446744073709551615u64));
  let least = 0 - 9223372036854775807 - 1;
  let p = parallel { 1.50m, "s", [4096, 8], { a: least, b: 2.5 } };
  assert_eq(p, (1.50m, "s", [4096, 8], { a: least, b: 2.5 }));
  let q = parallel { "x" ++ "y", 4096 };
  assert_eq(q._0.len() + q._1, 4098)
}

// What a branch allocates outlives it, and what the branches read is shared among them.
test "what branches build and share survives them" {
  range(0, 8).fold((), |u: Unit, i: Int| assert_eq(lengths(2000), 1990 + 8890 + 2000))
}

// The branch to the right fails first in time; evaluating them in turn never reaches it.
test "the leftmost failure is the block's, whichever failed first" {
  range(0, 4).fold((), |u: Unit, i: Int| assert_eq(caught(|| failing(25)), Err("the left branch")))
}
