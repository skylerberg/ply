//! A `parallel` block under a `handle` returns as its branches evaluated left to right, whichever way
//! the runtime runs them: a `handle` that handles what a branch performs is reached from the branch,
//! and one that handles nothing the block performs changes nothing of it.

effect meter {
  read level() -> Int
}

effect gate {
  read width() -> Int
  raise shut(at: Int)
}

fn fib(n: Int) -> Int = if n < 2 { n } else { fib(n - 1) + fib(n - 2) }

fn fib_pair(n: Int) -> (Int, Int) = parallel { fib(n), fib(n + 1) }

fn levelled(n: Int) -> (Int, Int) / {meter.level} =
  parallel { fib(n) + meter.level(), meter.level() }

fn shutting(n: Int) -> (Int, Int) / {gate.shut} =
  parallel { if fib(n) > 0 { gate.shut(1) } else { 0 }, gate.shut(2) }

fn through(f: () -> (Int, Int) / {meter.level}) -> (Int, Int) / {meter.level} = f()

test "a handle that handles nothing a block performs leaves its result as it was" {
  let r = handle { fib_pair(20) } with { meter.level() -> 3 };
  assert_eq(r, (6765, 10946))
}

test "a handle a block reaches handles its branches, past one it does not reach" {
  let r = handle { handle { levelled(20) } with { gate.width() -> 9 } } with { meter.level() -> 3 };
  assert_eq(r, (6768, 3))
}

test "a clause holding what its handle's body sees handles each branch as one that holds nothing" {
  let n = 4;
  let held = handle { levelled(10) } with { meter.level() -> n };
  let bare = handle { levelled(10) } with { meter.level() -> 4 };
  assert_eq(held, (59, 4));
  assert_eq(bare, held)
}

test "a branch's raise is handled around the block, the leftmost first" {
  let r = handle { shutting(20) } with { gate.shut(at) -> (at, at) };
  assert_eq(r, (1, 1))
}

// What a lambda's block performs is in no definition's effects but the one that calls it.
test "a block in a lambda is handled by the handle around its call" {
  let r = handle {
    through(|| parallel { meter.level(), meter.level() + 1 })
  } with {
    meter.level() -> 5,
  };
  assert_eq(r, (5, 6))
}

test "a block in a handle's body is handled by that handle" {
  let r = handle {
    parallel { meter.level(), fib(10) + meter.level() }
  } with {
    meter.level() -> 2,
  };
  assert_eq(r, (2, 57))
}
