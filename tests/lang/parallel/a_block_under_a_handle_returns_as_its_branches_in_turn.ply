effect meter {
  read level() -> Int
}

effect gate {
  read width() -> Int
  raise shut(at: Int)
}

fn fib(n: Int) -> Int = if n < 2 { n } else { fib(n - 1) + fib(n - 2) }

fn fib_pair(n: Int) -> (Int, Int) = parallel { fib(n), fib(n + 1) }

fn levelled(n: Int) -> (Int, Int) / {meter.level} =
  parallel { fib(n) + meter.level(), meter.level() }

fn shutting(n: Int) -> (Int, Int) / {gate.shut} =
  parallel { if fib(n) > 0 { gate.shut(1) } else { 0 }, gate.shut(2) }

fn through(f: () -> (Int, Int) / {meter.level}) -> (Int, Int) / {meter.level} = f()

test "a handler for an effect the parallel block never uses leaves the block's result unchanged" {
  let r = handle { fib_pair(20) } with { meter.level() -> 3 };
  assert_eq(r, (6765, 10946))
}

test "a handler handles the effects of every parallel branch, and a nested handler for a different effect does not change that" {
  let r = handle { handle { levelled(20) } with { gate.width() -> 9 } } with { meter.level() -> 3 };
  assert_eq(r, (6768, 3))
}

test "a handler clause that returns a local variable handles each parallel branch the same as a clause that returns the literal value" {
  let n = 4;
  let result = handle { levelled(10) } with { meter.level() -> n };
  let bare = handle { levelled(10) } with { meter.level() -> 4 };
  assert_eq(result, (59, 4));
  assert_eq(bare, result)
}

test "when branches raise an effect, the handler around the block handles the leftmost branch's raise first" {
  let r = handle { shutting(20) } with { gate.shut(at) -> (at, at) };
  assert_eq(r, (1, 1))
}

test "a block in a lambda is handled by the handle around its call" {
  let r = handle {
    through(|| parallel { meter.level(), meter.level() + 1 })
  } with {
    meter.level() -> 5,
  };
  assert_eq(r, (5, 6))
}

test "a block in a handle's body is handled by that handle" {
  let r = handle {
    parallel { meter.level(), fib(10) + meter.level() }
  } with {
    meter.level() -> 2,
  };
  assert_eq(r, (2, 57))
}
