effect log {
  write note(s: String) -> Unit
}

effect stop {
  write now() -> Unit
}

opaque type Connection = | Connection(String)

release for Connection by close

fn close(c: keep Connection) -> Unit / {log.write} =
  match c { Connection(name) -> log.note("close " ++ name) }

fn open(name: String) -> Connection / {log.write} = {
  log.note("open " ++ name);
  Connection(name)
}

fn send(c: Connection, m: String) -> Int / {log.write} =
  match c {
    Connection(name) -> {
      log.note(name ++ " " ++ m);
      m.len()
    },
  }

fn take(c: keep Connection) -> Unit / {log.write} =
  match c { Connection(name) -> log.note("took " ++ name) }

fn noted<a | e>(body: () -> a / {log.write | e}) -> List<String> / e =
  handle {
    body()
  } with {
    var seen = [],
    log.note(s) -> {
      seen = seen.push(s);
    },
    return u -> seen,
  }

fn attempt(fail: Bool) -> Result<Int, String> / {log.write} = {
  let c = open("a");
  let n = (if fail { Err("no") } else { Ok(1) })?;
  Ok(send(c, "hi") + n)
}

test "a resource is closed at the end of its block, after the last expression that uses it" {
  let seen = noted(|| {
    let n = {
      let c = open("a");
      send(c, "hi")
    };
    assert_eq(n, 2)
  });
  assert_eq(seen, ["open a", "a hi", "close a"])
}

test "resources the last expression does not use are closed before it, in reverse order of opening" {
  let seen = noted(|| {
    let a = open("a");
    let b = open("b");
    log.note("last")
  });
  assert_eq(seen, ["open a", "open b", "close b", "close a", "last"])
}

test "a resource passed to a function is closed only by that function" {
  let seen = noted(|| {
    let c = open("a");
    take(c)
  });
  assert_eq(seen, ["open a", "took a"])
}

test "a branch that does not pass a resource to a function closes the resource when the branch starts" {
  let run = |b: Bool|
    noted(|| {
      let c = open("a");
      if b { take(c) } else { log.note("kept") }
    });
  assert_eq(run(true), ["open a", "took a"]);
  assert_eq(run(false), ["open a", "close a", "kept"])
}

test "a raise unwinding through a resource's block closes the resource before the handler clause runs" {
  let seen = noted(|| {
    let returned = handle {
      let c = open("a");
      abort.raise("gone");
      send(c, "never")
    } with {
      abort.raise(m) -> {
        log.note("caught");
        m.len()
      },
    };
    assert_eq(returned, 4)
  });
  assert_eq(seen, ["open a", "close a", "caught"])
}

test "a handler clause that does not resume closes the resources the handled body opened" {
  let seen = noted(|| {
    let returned = handle {
      let c = open("a");
      stop.now();
      send(c, "never")
    } with {
      stop.now() resume k -> 0,
    };
    assert_eq(returned, 0)
  });
  assert_eq(seen, ["open a", "close a"])
}

test "a `?` that returns early from a resource's block closes the resource" {
  assert_eq(noted(|| attempt(true)), ["open a", "close a"]);
  assert_eq(noted(|| attempt(false)), ["open a", "a hi", "close a"])
}

test "a tuple, an option or a list that contains resources closes each of them" {
  let seen = noted(|| {
    let pair = (open("a"), open("b"));
    let maybe = Some(open("c"));
    let many = [open("d"), open("e")];
    log.note("end")
  });
  assert_eq(seen, [
    "open a",
    "open b",
    "open c",
    "open d",
    "open e",
    "close d",
    "close e",
    "close c",
    "close a",
    "close b",
    "end",
  ])
}

test "a closure that uses a resource closes the resource at the end of the enclosing block if the closure is never called" {
  let seen = noted(|| {
    let c = open("a");
    let later = || take(c);
    log.note("end")
  });
  assert_eq(seen, ["open a", "close a", "end"]);
  let called = noted(|| {
    let c = open("a");
    let later = || take(c);
    later()
  });
  assert_eq(called, ["open a", "took a"])
}

test "a closure that only calls another closure using a resource still closes the resource at block end if neither closure is called" {
  let seen = noted(|| {
    let c = open("a");
    let g = || take(c);
    let h = || g();
    log.note("end")
  });
  assert_eq(seen, ["open a", "close a", "end"])
}

fn moved(fail: Bool) -> Int / {log.write, abort.raise} = {
  let h = { conn: open("a"), n: 1 };
  let r = { conn: h.conn, n: if fail { abort.raise("no") } else { 2 } };
  send(r.conn, "hi") + r.n
}

test "a resource moved into a record is closed when a later field of the record fails to build" {
  let caught = |body: () -> Int / {log.write, abort.raise}|
    noted(|| {
      let n = handle { body() } with { abort.raise(m) -> 0 };
      log.note("answered")
    });
  assert_eq(caught(|| moved(true)), ["open a", "close a", "answered"]);
  assert_eq(caught(|| moved(false)), ["open a", "a hi", "close a", "answered"])
}

type Inner = {
  connection: Connection,
  a: Int,
  b: Int,
  c: Int,
  d: Int,
  e: Int,
  f: Int,
  g: Int,
  h: Int,
}

type Outer = { inner: Inner, z: Int }

fn built(fail: Bool) -> Outer / {log.write, abort.raise} =
  {
    inner: { connection: open("a"), a: 1, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 8 },
    z: if fail { abort.raise("no") } else { 0 },
  }

test "a record with many fields, built inside another record, closes its resource whether or not a later field raises an error" {
  let run = |fail: Bool|
    noted(|| {
      let n = handle {
        let o = built(fail);
        o.z
      } with {
        abort.raise(m) -> 9,
      };
      log.note("answered")
    });
  assert_eq(run(true), ["open a", "close a", "answered"]);
  assert_eq(run(false), ["open a", "close a", "answered"])
}

fn stepped(fail: Bool) -> Int / {log.write, abort.raise} = {
  let c = open("c");
  let t = iterate(0, 10, |i: Int| {
    let d = open("d");
    let k = send(d, "x");
    if fail && i == 1 { abort.raise("no") };
    if i > 2 { Stop(i) } else { Continue(i + 1) }
  });
  send(c, "after") + t
}

test "a failure in a loop step closes the resources opened by that step and by the code calling it" {
  let run = |fail: Bool|
    noted(|| {
      let n = handle { stepped(fail) } with { abort.raise(m) -> 0 };
      log.note("answered")
    });
  assert_eq(run(true), [
    "open c",
    "open d",
    "d x",
    "close d",
    "open d",
    "d x",
    "close d",
    "close c",
    "answered",
  ])
}

opaque type Fragile = | Fragile(String)

release for Fragile by shut

fn shut(x: keep Fragile) -> Unit / {log.write, abort.raise} =
  match x {
    Fragile(name) -> {
      log.note("shut " ++ name);
      if name == "b" { abort.raise("shut failed") }
    },
  }

fn fragile(name: String) -> Fragile / {log.write} = {
  log.note("open " ++ name);
  Fragile(name)
}

test "when a release fails, the remaining resources are still closed before the failure propagates" {
  let seen = noted(|| {
    handle {
      let a = fragile("a");
      let b = fragile("b");
      log.note("last")
    } with {
      abort.raise(m) -> log.note("caught " ++ m),
    }
  });
  assert_eq(seen, ["open a", "open b", "shut b", "shut a", "caught shut failed"])
}

fn none_int() -> Option<Int> = None

test "a `let` whose pattern does not match closes the resources opened earlier in its block" {
  let seen = noted(|| {
    let n = handle {
      let c = open("a");
      let Some(m) = none_int();
      send(c, "x") + m
    } with {
      abort.raise(reason) -> 0,
    };
    log.note("answered")
  });
  assert_eq(seen, ["open a", "close a", "answered"])
}
