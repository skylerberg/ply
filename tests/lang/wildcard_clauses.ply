//! A handler clause written `[*]` answers its operation on every label, which is what lets a
//! library serve an effect whose atoms are per-resource: a database driver over tables, a trace
//! sink over channels, a cache over its key space.
//!
//! A clause is still matched by the operation's effect, operation and mode; `[*]` only widens the
//! label. A clause that names a label answers that label alone.

effect store {
  read get[table](key: String) -> Int
  write put[table](key: String, value: Int) -> Unit
}

fn both() -> Int / {store.get[users], store.get[orders], store.put[orders]} = {
  store.put[orders]("a", 1);
  store.get[users]("a") + store.get[orders]("a")
}

test "one clause answers every label of the operation" {
  let out = handle {
    both()
  } with {
    var seen = [],
    store.get[*](key) -> {
      seen = seen.push("get " ++ key);
      1
    },
    store.put[*](key, _value) -> {
      seen = seen.push("put " ++ key);
    },
    return answer -> { result: answer, seen: seen },
  };
  assert_eq(out.result, 2);
  assert_eq(out.seen, ["put a", "get a", "get a"])
}

test "a clause that names a label is not widened by a wildcard clause elsewhere" {
  let out = handle {
    both()
  } with {
    var seen = [],
    store.get[users](key) -> {
      seen = seen.push("users " ++ key);
      10
    },
    store.get[orders](key) -> {
      seen = seen.push("orders " ++ key);
      20
    },
    store.put[*](key, _value) -> {
      seen = seen.push("put " ++ key);
    },
    return answer -> { result: answer, seen: seen },
  };
  assert_eq(out.result, 30);
  assert_eq(out.seen, ["put a", "users a", "orders a"])
}

/// The mode atom of a handled effect: a body written with `store.write` rather than with `put`
/// is discharged by a wildcard clause for the operation the mode stands for.
fn write_only() -> Unit / {store.write[orders]} = store.put[orders]("b", 2)

test "a wildcard clause discharges a mode atom" {
  let seen = handle {
    write_only()
  } with {
    var seen = [],
    store.put[*](key, _value) -> {
      seen = seen.push(key);
    },
    return u -> seen,
  };
  assert_eq(seen, ["b"])
}

/// A label parameter is a label like any other: `fn relay<[l]>` performs `store.get[l]`, and a
/// wildcard clause answers it.
fn relay<[l]>(key: String) -> Int / {store.get[l]} = store.get[l](key)

test "a wildcard clause answers a label parameter too" {
  let out = handle {
    relay[users]("k") + relay[orders]("k")
  } with {
    store.get[*](key) -> key.len(),
  };
  assert_eq(out, 2)
}

fn main() -> Int = 0
