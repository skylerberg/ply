//! A raise the runtime makes for what fails on a value goes to the innermost `handle` around it that
//! handles `abort.raise`, whichever way the `handle`s further out handle it.

/// Its `handle` returns through objects.
fn fifth(b: Bytes) -> Result<Int, String> =
  handle { b.at(5) } with { abort.raise(m) -> Err(m), return v -> Ok(v) }

/// Around `fifth`, a `handle` the runtime's frames hold, since the function may spawn a task.
fn spawning(b: Bytes) -> Result<Result<Int, String>, String> / {task.write, abort.raise} = {
  let t = task.spawn(|| 1);
  let r = handle {
    if b.at(0) == 0 { Ok(0) } else { fifth(b) }
  } with {
    abort.raise(m) -> Err(m),
    return v -> Ok(v),
  };
  let _ = task.join(t);
  r
}

effect ask {
  read get() -> Int
}

/// Around `fifth`, a `handle` the runtime's frames hold, since a clause resumes off its tail.
fn resuming(b: Bytes) -> Result<Int, String> =
  handle {
    let n = ask.get() + b.at(0);
    if n < 0 { Ok(n) } else { fifth(b) }
  } with {
    ask.get() resume k -> {
      let r = k(1);
      r
    },
    abort.raise(m) -> Ok(0 - 1),
  }

test "the handle nearest a rejected index handles it, under a handle that may spawn" {
  let r = simulate { spawning(b"ab") };
  assert(match r { Ok(Err(_)) -> true, _ -> false }, Some("the outer handle took the raise"));
  assert_eq(simulate { spawning(b"abcdef") }, Ok(Ok(102)))
}

test "the handle nearest a rejected index handles it, under a handle that resumes off its tail" {
  assert(
    match resuming(b"ab") { Err(_) -> true, Ok(_) -> false },
    Some("the outer handle took the raise"),
  );
  assert_eq(resuming(b"abcdef"), Ok(102))
}
