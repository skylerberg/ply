//! A parser reading a byte at a time through a handler whose clause answers and returns runs as the
//! loop it is written as, as one reading the buffer itself does, and a byte more costs it no
//! allocation and no more than two calls more than it costs the direct one.

import std.pace (spent)

effect input {
  read peek(i: Int) -> Int
}

fn counted(left: Int, i: Int, n: Int) -> Int / {input.peek} =
  if left <= 0 { n } else if input.peek(i) == 49 { counted(left - 1, i + 1, n + 1) } else { n }

fn handled(b: Bytes) -> Int =
  handle {
    counted(b.len(), 0, 0)
  } with {
    input.peek(i) -> if i < 0 || i >= b.len() { 0 - 1 } else { b.at(i) },
  }

fn direct(b: Bytes, left: Int, i: Int, n: Int) -> Int =
  if left <= 0 || i < 0 || i >= b.len() { n }
  else if b.at(i) == 49 { direct(b, left - 1, i + 1, n + 1) }
  else { n }

fn ones(n: Int) -> Bytes = range(0, n).fold(b"", |acc: Bytes, i: Int| acc ++ b"1")

test "a parser under a handler reads every byte in a loop, as the direct one does" {
  let b = ones(50000);
  assert_eq(handled(b), 50000);
  assert_eq(direct(b, b.len(), 0, 0), 50000)
}

test "a byte more costs the handled parser no allocation, and at most two calls more than the direct one" {
  let through = |n: Int| {
    let b = ones(n);
    spent(|| handled(b))
  };
  let itself = |n: Int| {
    let b = ones(n);
    spent(|| direct(b, b.len(), 0, 0))
  };
  let h1 = through(1000);
  let h2 = through(2000);
  let d1 = itself(1000);
  let d2 = itself(2000);
  assert_eq(h2.allocations, h1.allocations);
  assert_eq(d2.allocations, d1.allocations);
  assert(h2.steps - h1.steps <= d2.steps - d1.steps + 2 * 1000, None)
}
