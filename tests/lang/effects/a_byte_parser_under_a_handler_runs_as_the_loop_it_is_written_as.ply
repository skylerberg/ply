//! A parser reading a byte at a time through a handler whose clause answers and returns runs as the
//! loop it is written as, as one reading the buffer itself does.

effect input {
  read peek(i: Int) -> Int
}

fn counted(left: Int, i: Int, n: Int) -> Int / {input.peek} =
  if left <= 0 { n } else if input.peek(i) == 49 { counted(left - 1, i + 1, n + 1) } else { n }

fn handled(b: Bytes) -> Int =
  handle {
    counted(b.len(), 0, 0)
  } with {
    input.peek(i) -> if i < 0 || i >= b.len() { 0 - 1 } else { b.at(i) },
  }

fn direct(b: Bytes, left: Int, i: Int, n: Int) -> Int =
  if left <= 0 || i < 0 || i >= b.len() { n }
  else if b.at(i) == 49 { direct(b, left - 1, i + 1, n + 1) }
  else { n }

fn ones(n: Int) -> Bytes = range(0, n).fold(b"", |acc: Bytes, i: Int| acc ++ b"1")

test "a parser under a handler reads every byte in a loop, as the direct one does" {
  let b = ones(50000);
  assert_eq(handled(b), 50000);
  assert_eq(direct(b, b.len(), 0, 0), 50000)
}
