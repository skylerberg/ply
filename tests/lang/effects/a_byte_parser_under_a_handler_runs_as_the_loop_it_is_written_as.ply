effect input {
  read peek(i: Int) -> Int
}

fn counted(left: Int, i: Int, n: Int) -> Int / {input.peek} =
  if left <= 0 { n } else if input.peek(i) == 49 { counted(left - 1, i + 1, n + 1) } else { n }

fn handled(b: Bytes) -> Int =
  handle {
    counted(b.len(), 0, 0)
  } with {
    input.peek(i) -> if i < 0 || i >= b.len() { 0 - 1 } else { b.at(i) },
  }

fn direct(b: Bytes, left: Int, i: Int, n: Int) -> Int =
  if left <= 0 || i < 0 || i >= b.len() { n }
  else if b.at(i) == 49 { direct(b, left - 1, i + 1, n + 1) }
  else { n }

fn ones(n: Int) -> Bytes = range(0, n).fold(b"", |accumulator: Bytes, i: Int| accumulator ++ b"1")

test "a byte parser under a handler reads every byte in a loop, and returns the same result as the parser without a handler" {
  let b = ones(50000);
  assert_eq(handled(b), 50000);
  assert_eq(direct(b, b.len(), 0, 0), 50000)
}
