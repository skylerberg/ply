effect gauge {
  read level() -> Float
  read count() -> Int
  read ready() -> Bool
  read name() -> String
}

fn wide() -> Int = 4611686018427387904

fn doubled(i: Int) -> Float =
  handle { gauge.level() * 2.0 } with { gauge.level() resume k -> k(Float::of_int(i) + 0.5) }

fn resumed_extra(i: Int) -> Int =
  handle { gauge.count() - wide() } with { gauge.count() resume k -> k(wide() + i) }

fn name_length(i: Int) -> Int =
  handle { gauge.name().len() } with { gauge.name() resume k -> k("ab" ++ i.to_string()) }

fn levels(n: Int) -> Float =
  range(0, n).fold(0.0, |accumulator: Float, i: Int| accumulator + doubled(i))

fn counts(n: Int) -> Int =
  range(0, n).fold(0, |accumulator: Int, i: Int| accumulator + resumed_extra(i))

test "a float or a wide integer passed to the resume function as the clause's last action is returned to the handled code unchanged" {
  assert_eq(levels(100), 10000.0);
  assert_eq(counts(100), 4950);
  assert_eq(handle { gauge.count() } with { gauge.count() resume k -> k(0 - wide()) }, 0 - wide())
}

test "a float or a bool passed to the resume function as the clause's last action is received by the handled code with its own type" {
  assert_eq(
    handle { if gauge.level() > 1.0 { 1 } else { 2 } } with { gauge.level() resume k -> k(1.5) },
    1,
  );
  assert_eq(
    handle { if gauge.ready() { 1 } else { 2 } } with { gauge.ready() resume k -> k(true) },
    1,
  );
  assert_eq(
    range(0, 100).fold(0, |accumulator: Int, i: Int| accumulator + name_length(i)),
    10 * 3 + 90 * 4,
  )
}
