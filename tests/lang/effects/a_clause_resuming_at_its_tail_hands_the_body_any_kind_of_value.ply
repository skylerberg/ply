//! A clause that resumes its continuation at its tail hands the body what it resumed with,
//! whatever the `handle` returns: a float, an integer too wide to be held in a word, or a value of
//! another type than the handle's, and the body owns it as any result of an operation.

effect gauge {
  read level() -> Float
  read count() -> Int
  read ready() -> Bool
  read name() -> String
}

fn wide() -> Int = 4611686018427387904

/// Twice the level the clause resumes with, `i + 0.5`.
fn doubled(i: Int) -> Float =
  handle { gauge.level() * 2.0 } with { gauge.level() resume k -> k(Float::of_int(i) + 0.5) }

/// The count the clause resumes with, `wide() + i`, less `wide()`.
fn beyond(i: Int) -> Int =
  handle { gauge.count() - wide() } with { gauge.count() resume k -> k(wide() + i) }

/// The length of the name the clause resumes with, `"ab"` and `i`.
fn name_length(i: Int) -> Int =
  handle { gauge.name().len() } with { gauge.name() resume k -> k("ab" ++ i.to_string()) }

fn levels(n: Int) -> Float = range(0, n).fold(0.0, |acc: Float, i: Int| acc + doubled(i))

fn counts(n: Int) -> Int = range(0, n).fold(0, |acc: Int, i: Int| acc + beyond(i))

test "a float or a wide integer resumed at the tail is the one the body reads" {
  assert_eq(levels(100), 10000.0);
  assert_eq(counts(100), 4950);
  assert_eq(handle { gauge.count() } with { gauge.count() resume k -> k(0 - wide()) }, 0 - wide())
}

test "a value of another type than the handle's resumed at the tail is the one the body reads" {
  assert_eq(
    handle { if gauge.level() > 1.0 { 1 } else { 2 } } with { gauge.level() resume k -> k(1.5) },
    1,
  );
  assert_eq(
    handle { if gauge.ready() { 1 } else { 2 } } with { gauge.ready() resume k -> k(true) },
    1,
  );
  assert_eq(range(0, 100).fold(0, |acc: Int, i: Int| acc + name_length(i)), 10 * 3 + 90 * 4)
}
