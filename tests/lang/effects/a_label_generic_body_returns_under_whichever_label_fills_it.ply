effect net {
  write send[s](payload: Int) -> Int
}

fn relay<[l]>(payload: Int) -> Int / {net.send[l]} = net.send[l](payload)

fn driver(x: Int) -> Int = handle { relay[conn](x) } with { net.send[conn](p) -> p + 1 }

test "a function generic over labels can be called from another function and returns its result" {
  assert_eq(driver(1), 2)
}

fn ping<[l]>(n: Int) -> Int / {net.send[l]} = if n <= 0 { net.send[l](0) } else { pong[l](n - 1) }

fn pong<[k]>(n: Int) -> Int / {net.send[k]} = if n <= 0 { net.send[k](1) } else { ping[k](n - 1) }

fn near(n: Int) -> Int = handle { ping[conn](n) } with { net.send[conn](p) -> p + 10 }

fn handled_upstream(n: Int) -> Int =
  handle { ping[upstream](n) } with { net.send[upstream](p) -> p + 20 }

test "label-generic functions that call each other pass their label along, and these tail calls do not grow the stack" {
  assert_eq(near(0), 10);
  assert_eq(near(1), 11);
  assert_eq(handled_upstream(0), 20);
  assert_eq(handled_upstream(1), 21);
  assert_eq(near(100000), 10);
  assert_eq(handled_upstream(100001), 21)
}

fn hop<[l], [k]>(n: Int, sum: Int) -> Int / {net.send[l], net.send[k]} =
  if n <= 0 { sum } else { hop[k, l](n - 1, sum + net.send[l](n)) }

fn left<[l], [k]>(n: Int, sum: Int) -> Int / {net.send[l], net.send[k]} =
  if n <= 0 { sum } else { right[k, l](n - 1, sum + net.send[l](n)) }

fn right<[l], [k]>(n: Int, sum: Int) -> Int / {net.send[l], net.send[k]} =
  if n <= 0 { sum } else { left[l, k](n - 1, sum + net.send[l](n)) }

fn send_weight<| e>(walk: () -> Int / {net.send[conn], net.send[upstream] | e}) -> Int / e =
  handle { walk() } with { net.send[conn](_) -> 1, net.send[upstream](_) -> 100 }

test "a call inside a recursive group may pass other labels than it was given" {
  assert_eq(send_weight(|| hop[conn, upstream](4, 0)), 202);
  assert_eq(send_weight(|| left[conn, upstream](4, 0)), 202);
  assert_eq(send_weight(|| hop[conn, upstream](100001, 0)), 5050001)
}
