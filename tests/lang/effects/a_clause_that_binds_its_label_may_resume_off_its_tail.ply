effect choice {
  read flip[coin]() -> Bool
}

fn tossed() -> Int / {choice.flip[left], choice.flip[right]} =
  (if choice.flip[left]() { 1 } else { 0 }) + (if choice.flip[right]() { 10 } else { 0 })

test "a clause binding its label works on what the rest of the body returns" {
  assert_eq(handle { tossed() } with { choice.flip[*t]() resume k -> k(true) * 2 }, 44);
  let named = handle {
    tossed()
  } with {
    choice.flip[left]() resume k -> k(true) * 2,
    choice.flip[right]() resume k -> k(false) * 2,
  };
  assert_eq(handle { tossed() } with { choice.flip[*t]() resume k -> k(t == "left") * 2 }, named)
}

type Suspension = | Done(Int) | Suspended(once (Bool) -> Suspension)

fn parked() -> Suspension =
  handle {
    Done(if choice.flip[left]() { 41 } else { 0 })
  } with {
    choice.flip[*t]() resume k -> Suspended(k),
  }

fn done(s: keep Suspension) -> Int = match s { Done(n) -> n, Suspended(later) -> 0 - 1 }

test "a clause that binds its label can still resume its continuation after the function that created its `handle` has returned" {
  assert_eq(match parked() { Suspended(k) -> done(k(true)), Done(_) -> 0 - 1 }, 41)
}
