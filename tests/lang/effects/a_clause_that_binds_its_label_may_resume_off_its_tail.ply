//! A clause that binds the label it answers, `[*t]`, resumes its continuation anywhere a clause
//! naming its label may: off its tail, more than once, or not until after its `handle` has
//! answered. Each resumption runs the rest of the body and answers what that body answered, whether
//! or not the clause reads its label.

effect amb {
  multi read flip[coin]() -> Bool
}

fn tossed() -> Int / {amb.flip[left], amb.flip[right]} =
  (if amb.flip[left]() { 1 } else { 0 }) + (if amb.flip[right]() { 10 } else { 0 })

test "a clause binding its label works on what the rest of the body answers" {
  assert_eq(handle { tossed() } with { amb.flip[*t]() resume k -> k(true) * 2 }, 44);
  let named = handle {
    tossed()
  } with {
    amb.flip[left]() resume k -> k(true) * 2,
    amb.flip[right]() resume k -> k(false) * 2,
  };
  assert_eq(handle { tossed() } with { amb.flip[*t]() resume k -> k(t == "left") * 2 }, named)
}

test "a clause binding its label resumes more than once, each from where the body stopped" {
  let named = handle {
    tossed()
  } with {
    amb.flip[left]() resume k -> k(true) + k(false),
    amb.flip[right]() resume k -> k(true) + k(false),
  };
  assert_eq(named, 22);
  assert_eq(handle { tossed() } with { amb.flip[*t]() resume k -> k(true) + k(false) }, named)
}

type Saved = | Done(Int) | Parked((Bool) -> Saved)

fn parked() -> Saved =
  handle {
    Done(if amb.flip[left]() { 41 } else { 0 })
  } with {
    amb.flip[*t]() resume k -> Parked(k),
  }

fn done(s: Saved) -> Int = match s { Done(n) -> n, Parked(_) -> 0 - 1 }

test "a clause binding its label keeps its continuation past its handle's answer" {
  assert_eq(
    match parked() { Parked(k) -> done(k(true)) * 100 + done(k(false)), Done(_) -> 0 - 1 },
    4100,
  )
}
