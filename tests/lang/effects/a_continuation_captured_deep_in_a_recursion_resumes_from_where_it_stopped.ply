effect amb {
  read flip() -> Bool
}

fn level(xs: List<Int>) -> Int / {amb.flip} =
  match xs {
    [] -> if amb.flip() { 1 } else { 2 },
    [x, ..rest] ->
      bracket(|| x.to_string(), |s: String| (), |s: String| level(rest) + s.len() - s.len() + 1),
  }

fn deep(depth: Int) -> Int / {amb.flip} = level(range(0, depth))

fn resumed(depth: Int, b: Bool) -> Int =
  handle {
    deep(depth)
  } with {
    amb.flip() resume k -> {
      let n = k(b);
      n * 10
    },
  }

type Saved = | Done(Int) | Parked(once (Bool) -> Saved)

fn parked(depth: Int) -> Saved =
  handle { Done(deep(depth)) } with { amb.flip() resume k -> Parked(k) }

fn resume_parked(s: keep Saved) -> Int =
  match s { Parked(k) -> match k(false) { Done(n) -> n, Parked(again) -> 0 }, Done(n) -> n }

test "a continuation captured 8,000 calls deep resumes from where it stopped" {
  assert_eq(resumed(4000, true), 40010)
}

test "a continuation captured deep in a recursion can still be resumed after the `handle` that captured it has returned" {
  assert_eq(resume_parked(parked(4000)), 4002)
}

test "a continuation resumes correctly when captured at each of many recursion depths" {
  assert(
    range(0, 40).fold(true, |ok: Bool, i: Int|
      ok && resumed(i * 100, i % 2 == 0) == (i * 100 + (if i % 2 == 0 { 1 } else { 2 })) * 10),
  )
}
