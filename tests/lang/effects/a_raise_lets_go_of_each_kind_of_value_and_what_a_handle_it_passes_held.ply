//! A raise lets go of what each frame it unwinds held, however the frame holds it: a record as its
//! fields, a closure, an `Option` as its payload. A `handle` that does not answer it lets go at its
//! landing of what it held across its body, once the body has let go of its own.

effect ask {
  read get() -> Int
}

fn caught<a>(f: () -> a / {abort.raise}) -> Result<a, String> =
  handle { f() } with { abort.raise(m) -> Err(m), return v -> Ok(v) }

/// What `f` answers, or -1 where it raised.
fn answered(f: () -> Int / {abort.raise}) -> Int = match caught(f) { Ok(n) -> n, Err(_) -> 0 - 1 }

fn adder(xs: List<Int>) -> (Int) -> Int = |k: Int| k + xs.len()

/// Each of the three holds a value of its own kind across the call of the next, raising where
/// `left` reaches `stop`.
fn by_record(left: Int, stop: Int) -> Int / {abort.raise} = {
  let pair = { items: range(0, left), more: range(0, left + 1) };
  if left == stop { panic("stopped") }
  else if left <= 0 { 0 }
  else { by_closure(left - 1, stop) + pair.items.len() + pair.more.len() }
}

fn by_closure(left: Int, stop: Int) -> Int / {abort.raise} = {
  let f = adder(range(0, left));
  if left == stop { panic("stopped") } else if left <= 0 { 0 } else { f(by_option(left - 1, stop)) }
}

fn by_option(left: Int, stop: Int) -> Int / {abort.raise} = {
  let o = if left % 2 == 0 { Some(range(0, left)) } else { None };
  if left == stop { panic("stopped") }
  else if left <= 0 { 0 }
  else { by_record(left - 1, stop) + (match o { Some(xs) -> xs.len(), None -> 0 }) }
}

/// Answers `ask` for the calls below it, holding a list across its `handle` that it reads after and
/// one inside the body across the call down; until `left` is near `stop`, the call down is another.
fn asking(left: Int, stop: Int) -> Int / {abort.raise} = {
  let kept = range(0, left);
  let inner = handle {
    let local = range(0, left + 1);
    let below = if left > stop + 5 { asking(left - 1, stop) } else { by_record(left - 1, stop) };
    below + local.len() + ask.get()
  } with {
    ask.get() -> 1,
  };
  inner + kept.len()
}

/// Holds a list across a `handle` that does not answer a raise, whose body holds one of its own
/// across a division by `d`.
fn divided(n: Int, d: Int) -> Int / {abort.raise} = {
  let kept = range(0, n);
  let inner = handle {
    let local = range(0, n + 1);
    let q = n / d;
    q + local.len() + ask.get()
  } with {
    ask.get() -> 1,
  };
  inner + kept.len()
}

test "each answers what it adds up where it does not raise" {
  assert_eq(answered(|| by_record(6, 0 - 1)), 31);
  assert_eq(answered(|| divided(10, 2)), 27);
  assert(answered(|| asking(12, 0 - 1)) > 0)
}

test "a raise down calls that each hold a record, a closure or an option leaves none of them live" {
  // Started at each kind, the raise comes from each kind too.
  range(0, 3).fold((), |_: Unit, first: Int|
    assert_eq(
      answered(||
        if first == 0 { by_record(30, 10) }
        else if first == 1 { by_closure(30, 10) }
        else { by_option(30, 10) }),
      0 - 1,
    ))
}

test "a raise through handles that do not answer it leaves nothing their bodies or they held live" {
  assert_eq(answered(|| asking(20, 5)), 0 - 1);
  assert_eq(answered(|| divided(10, 0)), 0 - 1)
}

test "fifty raises through handles answered in a loop leave nothing live" {
  assert_eq(range(0, 50).fold(0, |n: Int, i: Int| n + answered(|| asking(20, i % 15))), 0 - 50)
}
