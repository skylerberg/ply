effect ask {
  read get() -> Int
}

fn caught<a>(f: () -> a / {abort.raise}) -> Result<a, String> =
  handle { f() } with { abort.raise(m) -> Err(m), return v -> Ok(v) }

fn returned(f: () -> Int / {abort.raise}) -> Int = match caught(f) { Ok(n) -> n, Err(_) -> 0 - 1 }

fn adder(xs: List<Int>) -> (Int) -> Int = |k: Int| k + xs.len()

fn with_record(left: Int, stop: Int) -> Int / {abort.raise} = {
  let pair = { items: range(0, left), more: range(0, left + 1) };
  if left == stop { panic("stopped") }
  else if left <= 0 { 0 }
  else { by_closure(left - 1, stop) + pair.items.len() + pair.more.len() }
}

fn by_closure(left: Int, stop: Int) -> Int / {abort.raise} = {
  let f = adder(range(0, left));
  if left == stop { panic("stopped") }
  else if left <= 0 { 0 }
  else { f(with_option(left - 1, stop)) }
}

fn with_option(left: Int, stop: Int) -> Int / {abort.raise} = {
  let o = if left % 2 == 0 { Some(range(0, left)) } else { None };
  if left == stop { panic("stopped") }
  else if left <= 0 { 0 }
  else { with_record(left - 1, stop) + (match o { Some(xs) -> xs.len(), None -> 0 }) }
}

fn ask_across_calls(left: Int, stop: Int) -> Int / {abort.raise} = {
  let outer_range = range(0, left);
  let inner = handle {
    let local = range(0, left + 1);
    let below = if left > stop + 5 { ask_across_calls(left - 1, stop) }
    else { with_record(left - 1, stop) };
    below + local.len() + ask.get()
  } with {
    ask.get() -> 1,
  };
  inner + outer_range.len()
}

fn divided(n: Int, d: Int) -> Int / {abort.raise} = {
  let outer_range = range(0, n);
  let inner = handle {
    let local = range(0, n + 1);
    let q = n / d;
    q + local.len() + ask.get()
  } with {
    ask.get() -> 1,
  };
  inner + outer_range.len()
}

test "when nothing raises, each function returns its computed total" {
  assert_eq(returned(|| with_record(6, 0 - 1)), 31);
  assert_eq(returned(|| divided(10, 2)), 27);
  assert(returned(|| ask_across_calls(12, 0 - 1)) > 0)
}

test "a raise through calls that each store a record, a closure or an option frees all of those values" {
  range(0, 3).fold((), |_: Unit, first: Int|
    assert_eq(
      returned(||
        if first == 0 { with_record(30, 10) }
        else if first == 1 { by_closure(30, 10) }
        else { with_option(30, 10) }),
      0 - 1,
    ))
}

test "a raise through `handle` blocks with no clause for it frees every value their bodies and clauses allocated" {
  assert_eq(returned(|| ask_across_calls(20, 5)), 0 - 1);
  assert_eq(returned(|| divided(10, 0)), 0 - 1)
}

test "fifty raises, each caught by its own `handle` block inside a loop, leave no allocated values live" {
  assert_eq(
    range(0, 50).fold(0, |n: Int, i: Int| n + returned(|| ask_across_calls(20, i % 15))),
    0 - 50,
  )
}
