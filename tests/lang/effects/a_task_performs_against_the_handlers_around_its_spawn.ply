effect ask {
  read get() -> Int
}

effect halt {
  write stop(code: Int) -> Int
}

effect tagged {
  read name[t]() -> String
}

fn returning<a | e>(n: Int, body: () -> a / {ask.get | e}) -> a / e =
  handle { body() } with { ask.get() -> n }

fn nested<a | e>(body: () -> a / {ask.get | e}) -> a / {ask.get | e} = {
  let n = ask.get();
  handle { body() } with { ask.get() -> n + 1 }
}

fn timed_out(n: Int) -> Int / {sim.read, abort.raise} =
  handle {
    simulate {
      let t = handle { task.spawn(|| ask.get()) } with { ask.get() -> n };
      halt.stop(n) + task.join(t)
    }
  } with {
    halt.stop(code) resume k -> code,
  }

test "a spawned task still uses its `handle` clause after the `handle` around the `task.spawn` call has finished" {
  let total = simulate {
    let t = handle { task.spawn(|| ask.get()) } with { ask.get() -> 7 };
    task.join(t)
  };
  assert(total == 7)
}

test "a handle is installed after the spawn" {
  let total = simulate {
    let t = handle { task.spawn(|| ask.get()) } with { ask.get() -> 7 };
    handle {
      task.yield();
      task.join(t)
    } with {
      ask.get() -> 100,
    }
  };
  assert(total == 7)
}

test "the simulation unwinds before the task starts" { assert(timed_out(7) == 7) }

test "a `handle` enclosing `simulate` inside a called function handles the operations of every spawned task" {
  let total = returning(5, ||
    simulate {
      let a = task.spawn(|| {
        let x = ask.get();
        task.yield();
        x + ask.get()
      });
      let b = task.spawn(|| ask.get() * 100);
      task.join(a) + task.join(b)
    });
  assert(total == 510)
}

test "a task spawned inside a nested `handle` within `simulate` calls operations handled by that nested `handle`" {
  let seen = returning(10, ||
    simulate {
      nested(|| {
        let t = task.spawn(|| {
          task.yield();
          ask.get()
        });
        task.join(t)
      })
    });
  assert(seen == 11)
}

test "a wildcard clause for `tagged.name[*l]` outside `simulate` handles the call a spawned task makes as `tagged.name[web]`" {
  let total = handle {
    returning(1, ||
      simulate {
        let t = task.spawn(|| tagged.name[web]().len() + ask.get());
        task.join(t)
      })
  } with {
    tagged.name[*l]() -> l,
  };
  assert(total == 4)
}
