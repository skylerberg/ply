// A task performs against the handlers around its `task.spawn` as they stood at the spawn, whatever
// its spawner does before the task first runs: a run searches every order of each region.

effect ask {
  read get() -> Int
}

effect halt {
  write stop(code: Int) -> Int
}

effect tagged {
  read name[t]() -> String
}

fn returning<a | e>(n: Int, body: () -> a / {ask.get | e}) -> a / e =
  handle { body() } with { ask.get() -> n }

fn nested<a | e>(body: () -> a / {ask.get | e}) -> a / {ask.get | e} = {
  let n = ask.get();
  handle { body() } with { ask.get() -> n + 1 }
}

fn timed_out(n: Int) -> Int / {sim.read, abort.raise} =
  handle {
    simulate {
      let t = handle { task.spawn(|| ask.get()) } with { ask.get() -> n };
      halt.stop(n) + task.join(t)
    }
  } with {
    halt.stop(code) resume k -> code,
  }

test "the handle around the spawn has ended" {
  let total = simulate {
    let t = handle { task.spawn(|| ask.get()) } with { ask.get() -> 7 };
    task.join(t)
  };
  assert(total == 7)
}

test "a handle is installed after the spawn" {
  let total = simulate {
    let t = handle { task.spawn(|| ask.get()) } with { ask.get() -> 7 };
    handle {
      task.yield();
      task.join(t)
    } with {
      ask.get() -> 100,
    }
  };
  assert(total == 7)
}

test "the region unwinds before the task starts" { assert(timed_out(7) == 7) }

test "a handle around the region, in a function the region runs under, answers each task" {
  let total = returning(5, ||
    simulate {
      let a = task.spawn(|| {
        let x = ask.get();
        task.yield();
        x + ask.get()
      });
      let b = task.spawn(|| ask.get() * 100);
      task.join(a) + task.join(b)
    });
  assert(total == 510)
}

test "a task spawned under a handle inside the region performs against that handle" {
  let seen = returning(10, ||
    simulate {
      nested(|| {
        let t = task.spawn(|| {
          task.yield();
          ask.get()
        });
        task.join(t)
      })
    });
  assert(seen == 11)
}

test "a clause on every label around the region answers the label each task performs at" {
  let total = handle {
    returning(1, ||
      simulate {
        let t = task.spawn(|| tagged.name[web]().len() + ask.get());
        task.join(t)
      })
  } with {
    tagged.name[*l]() -> l,
  };
  assert(total == 4)
}
