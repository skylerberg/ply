effect ledger {
  write record(amount: Int) -> Unit
  write audit(amount: Int) -> Unit
  read entries() -> Int
}

type Tally = { count: Int, sum: Int }

type Books = {
  all: Tally,
  audited: Tally,
  history: List<Int>,
  largest: Int,
  smallest: Int,
  last: Int,
}

fn opened() -> Books =
  {
    all: { count: 0, sum: 0 },
    audited: { count: 0, sum: 0 },
    history: [],
    largest: 0,
    smallest: 0,
    last: 0,
  }

fn tallied(t: Tally, amount: Int) -> Tally = { count: t.count + 1, sum: t.sum + amount }

fn recorded(books: Books, amount: Int) -> Books =
  {
    ..books,
    all: tallied(books.all, amount),
    history: books.history.push(amount),
    largest: if amount > books.largest { amount } else { books.largest },
    smallest: if amount < books.smallest { amount } else { books.smallest },
    last: amount,
  }

fn expected(amounts: List<Int>) -> Books =
  amounts.fold(opened(), |books: Books, amount: Int| {
    let after = recorded(books, amount);
    if after.all.count % 10 == 0 { { ..after, audited: tallied(after.audited, amount % 3) } }
    else { after }
  })

fn accounted(amounts: List<Int>) -> Books =
  handle {
    amounts.fold((), |u: Unit, amount: Int| {
      ledger.record(amount);
      if ledger.entries() % 10 == 0 {
        ledger.audit(amount);
      };
    })
  } with {
    var books: Books = opened(),
    ledger.record(amount) -> {
      books = {
        ..books,
        all: tallied(books.all, amount),
        history: books.history.push(amount),
        largest: if amount > books.largest { amount } else { books.largest },
        smallest: if amount < books.smallest { amount } else { books.smallest },
        last: amount,
      };
    },
    ledger.audit(amount) -> {
      books = { ..books, audited: tallied(books.audited, amount % 3) };
    },
    ledger.entries() -> books.all.count,
    return u -> books,
  }

test "a clause that updates its handler's record many times, in place or shared, keeps every update" {
  let amounts = range(0, 500).map(|i: Int| i * 37 % 101 - 50);
  assert_eq(accounted(amounts), expected(amounts));
  assert_eq(accounted([]), opened())
}
