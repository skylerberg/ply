effect pair {
  read first() -> Int
  read second() -> Int
}

fn second_returned<r | e>(work: () -> r / {pair.second | e}) -> r / e =
  handle { work() } with { pair.second() -> 2 }

test "an operation the inner handle does not handle is passed on to the outer handle" {
  let n = handle {
    second_returned(|| pair.first() * 10 + pair.second())
  } with {
    pair.first() -> 1,
  };
  assert_eq(n, 12)
}
