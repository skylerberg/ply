effect cell {
  read get[r]() -> Int
}

fn read_cell(left: Int, n: Int) -> Int / {cell.get[a]} =
  if left <= 0 { n } else { read_cell(left - 1, n + cell.get[a]()) }

fn through_label(n: Int) -> Int =
  handle { read_cell(n, 0) } with { cell.get[*name]() -> name.len() }

test "a clause on every label receives the label that the operation was performed at" {
  assert_eq(through_label(3), 3)
}
