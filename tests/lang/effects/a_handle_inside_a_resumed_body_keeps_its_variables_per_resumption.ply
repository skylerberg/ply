//! A `handle` inside a body that a clause resumes more than once holds its variables as they stood
//! at the stop on each resumption, whatever an earlier resumption did to them, and gives each back
//! once.

effect amb {
  read flip() -> Bool
}

effect tally {
  write add(n: Int) -> Unit
}

/// Strings made and let go, so a block one resumption freed is made again before the next reads it.
fn churned() -> Int =
  range(0, 16).map(|i: Int| i.to_string().concat(" churned")).fold(0, |n: Int, s: String|
    n + s.len())

/// What the inner handle's variable holds at the end of each world the flip makes.
fn worlds() -> List<List<Int>> =
  handle {
    handle {
      tally.add(1);
      tally.add(2);
      let b = amb.flip();
      tally.add(if b { 3 } else { 4 });
    } with {
      var seen: List<Int> = [],
      tally.add(n) -> {
        seen = seen.push(n);
      },
      return done -> [seen],
    }
  } with {
    amb.flip() resume k -> {
      let first: List<List<Int>> = k(true);
      if churned() < 0 { first } else { first.concat(k(false)) }
    },
  }

test "each resumption starts from the inner handle's variable as it stood at the stop" {
  assert_eq(worlds(), [[1, 2, 3], [1, 2, 4]]);
  assert_eq(metered(|| worlds().len()).live, 0)
}
