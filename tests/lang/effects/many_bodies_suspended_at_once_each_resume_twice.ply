effect amb {
  read flip() -> Bool
}

type Saved = | Done(Int) | Parked((Bool) -> Saved)

fn parked(i: Int) -> Saved =
  handle { Done(if amb.flip() { i } else { 0 - i }) } with { amb.flip() resume k -> Parked(k) }

fn both(s: Saved) -> Int =
  match s {
    Parked(k) -> match ((k(true), k(false))) { (Done(a), Done(b)) -> a + b + 1, _ -> 0 },
    Done(_) -> 0,
  }

test "two thousand bodies suspended at once each resume twice" {
  let held = range(0, 2000).map(parked);
  assert_eq(held.fold(0, |acc: Int, s: Saved| acc + both(s)), 2000)
}
