effect parse {
  raise missing(key: String, line: Int)
  raise eof()
  write note(s: String) -> Unit
}

fn end() -> Int / {parse.eof} = parse.eof()

fn missed() -> Int / {parse.missing} = parse.missing("k", 7)

fn past(n: Int) -> Int / {parse.eof} = end() + n

test "a `try` handles an operation that is raised directly, both with no arguments and with several arguments" {
  let r: Result<Int, Unit> = try { end() };
  assert_eq(r, Err(()));
  assert_eq(try { missed() }, Err(("k", 7)))
}

test "a `handle` clause handles an operation raised in a function that the `handle` body calls" {
  assert_eq(handle { past(1) } with { parse.eof() -> 0 - 1 }, 0 - 1);
  assert_eq(handle { missed() } with { parse.missing(k, l) -> l }, 7)
}

test "a `handle` further up the call stack handles an operation raised directly, and its result is the clause's value" {
  let r = handle {
    end()
  } with {
    parse.eof() -> 0 - 1,
    parse.note(s) resume k -> {
      let v = k(());
      v
    },
  };
  assert_eq(r, 0 - 1)
}

fn either(n: Int) -> Int / {parse.eof, parse.missing} = if n > 0 { missed() } else { end() }

test "a constant's raise passes a handle that does not handle it" {
  let inner = |n: Int| handle { either(n) } with { parse.missing(k, l) -> l };
  assert_eq(handle { inner(0) } with { parse.eof() -> 5 }, 5);
  assert_eq(handle { inner(1) } with { parse.eof() -> 5 }, 7)
}
