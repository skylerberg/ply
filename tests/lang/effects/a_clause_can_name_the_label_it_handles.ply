effect store {
  read get[table](key: String) -> Int
  write put[table](key: String, value: Int) -> Unit
}

fn both() -> Int / {store.get[users], store.get[orders], store.put[orders]} = {
  store.put[orders]("a", 1);
  store.get[users]("a") + store.get[orders]("a")
}

test "the clause reads the label its call site named" {
  let out = handle {
    both()
  } with {
    var seen = [],
    store.get[*t](key) -> {
      seen = seen.push(t ++ " " ++ key);
      1
    },
    store.put[*t](key, _value) -> {
      seen = seen.push(t ++ " " ++ key);
    },
    return result -> { result: result, seen: seen },
  };
  assert_eq(out.result, 2);
  assert_eq(out.seen, ["orders a", "users a", "orders a"])
}

test "the label is a value the body decides on" {
  let out = handle {
    both()
  } with {
    store.get[*t](_key) -> if t == "users" { 10 } else { 20 },
    store.put[*t](_key, _value) -> (),
  };
  assert_eq(out, 30)
}

fn relay<[l]>(key: String) -> Int / {store.get[l]} = store.get[l](key)

test "a clause that binds the effect label as `*t` receives the label written at each call, such as `users` or `orders`, not the name of a function parameter" {
  let out = handle {
    relay[users]("k") + relay[orders]("k")
  } with {
    store.get[*t](key) -> if t == "users" { key.len() } else { 100 },
  };
  assert_eq(out, 101)
}

test "a clause that binds no label with `[*]` handles operations the same way as a clause without a label" {
  let out = handle { both() } with { store.get[*](_key) -> 1, store.put[*](_key, _value) -> () };
  assert_eq(out, 2)
}

test "a clause that binds any label with `*t` and a clause for the specific label `orders` on the same operation are reported as duplicates" {
  let out = handle {
    both()
  } with {
    store.get[*t](_key) -> 1,
    store.put[orders](_key, _value) -> (),
    store.put[*t](_key, _value) -> (),
  };
  assert_eq(out, 2)
}

fn main() -> Int = 0
