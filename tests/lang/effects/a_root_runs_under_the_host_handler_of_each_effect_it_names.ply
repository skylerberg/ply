import std.os
import std.os (os)

fn workers() -> Int / {os.cpus} = os.cpus()

fn twice() -> Int / {os.pid} = os.pid() + os.pid()

test/nondet "an operation called from a callee is handled by the runtime's built-in handler for its effect" {
  assert(workers() >= 1);
  assert(twice() == 2 * os.pid())
}

test "a handler of the program's own handles an operation before the host handler would" {
  assert_eq(os::with_machine({ ..os::machine(), cpus: 3 }, workers), 3)
}
