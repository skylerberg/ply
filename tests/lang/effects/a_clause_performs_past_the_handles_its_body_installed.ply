//! A clause runs where its `handle` stands: what it performs reaches the handles around that
//! `handle`, never one the `handle`'s body installed below it, whichever way either is handled.

effect note {
  write say(s: String) -> Unit
}

effect choice {
  read flip() -> Bool
}

/// What each `note.say` is heard as: the `choice` clause's say goes to the outer handle, past the one
/// the body installed around the flip, though that one is nearer on the stack.
fn heard() -> List<String> =
  handle {
    handle {
      handle {
        let _ = choice.flip();
        []
      } with {
        note.say(s) resume k -> {
          let rest: List<String> = k(());
          rest.push(s.concat("-inner"))
        },
      }
    } with {
      choice.flip() -> {
        note.say("clause");
        true
      },
    }
  } with {
    note.say(s) resume k -> {
      let rest: List<String> = k(());
      rest.push(s.concat("-outer"))
    },
  }

test "an effect performed in a clause goes to the handler around its own `handle`, skipping a handler created inside its body" {
  assert_eq(heard(), ["clause-outer"])
}
