effect note {
  write say(s: String) -> Unit
}

effect choice {
  read flip() -> Bool
}

fn messages() -> List<String> =
  handle {
    handle {
      handle {
        let _ = choice.flip();
        []
      } with {
        note.say(s) resume k -> {
          let rest: List<String> = k(());
          rest.push(s.concat("-inner"))
        },
      }
    } with {
      choice.flip() -> {
        note.say("clause");
        true
      },
    }
  } with {
    note.say(s) resume k -> {
      let rest: List<String> = k(());
      rest.push(s.concat("-outer"))
    },
  }

test "an effect performed in a clause goes to the handler around its own `handle`, skipping a handler created inside its body" {
  assert_eq(messages(), ["clause-outer"])
}
