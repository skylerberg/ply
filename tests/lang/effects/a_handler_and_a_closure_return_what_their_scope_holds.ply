effect log {
  write note[tape](n: Int) -> Int
}

test "a clause that resumes as its last action updates variables that the `return` clause then reads" {
  let got = handle {
    log.note[tape](1) + log.note[tape](2)
  } with {
    var accumulated = 0,
    log.note[tape](n) -> {
      accumulated = accumulated * 10 + n;
      n
    },
    return total -> total + accumulated * 1000,
  };
  assert_eq(got, 12003)
}

fn twice_over() -> Int = {
  let xs = [1, 2, 3];
  let g = || xs.push(4).len();
  g() + g() + xs.len()
}

test "a captured binding is the same list at every call of the closure" {
  assert_eq(twice_over(), 4 + 4 + 3)
}

type Storage = { store: Bytes, index: Bytes }

effect step {
  write once() -> Unit
}

fn read_at(packed: Option<Storage>, n: Int) -> Int =
  match packed { Some(w) -> w.store.len() + n, None -> n }

fn read_after_step(read: (Int) -> Int) -> Int / {step.once} = {
  step.once();
  read(1)
}

fn read_through_step(packed: Option<Storage>) -> Int =
  handle { read_after_step(|n: Int| read_at(packed, n)) } with { step.once() -> () }

test "a closure in a handle's body can capture an optional record that was passed to the enclosing function" {
  let w: Storage = { store: b"ab", index: b"c" };
  assert_eq(read_through_step(Some(w)), 3);
  assert_eq(read_through_step(Some(w)), 3);
  assert_eq(read_through_step(None), 1);
  assert_eq(w.store, b"ab")
}
