//! A label parameter and a value never share a name: a binder named as the label in scope leaves
//! `[l]` naming the label, in the body and in a lambda the label is captured into alike.

effect store {
  read get[table](key: String) -> Int
}

type Row = { key: String }

fn fetch<[l]>(row: Row) -> Int / {store.get[l]} = store.get[l](row.key)

fn first<[l]>(rows: List<Row>) -> Int / {store.get[l]} =
  match rows { [] -> 0, [l, ..] -> fetch[l](l) }

fn every<[l]>(rows: List<Row>) -> List<Int> / {store.get[l]} = map(rows, |l: Row| fetch[l](l))

test "a value named as the label in scope leaves the label the label" {
  let out = handle {
    first[users]([{ key: "ab" }])
      + fold(every[users]([{ key: "a" }, { key: "abc" }]), 0, |n: Int, x: Int| n + x)
  } with {
    store.get[*t](key) -> if t == "users" { string_len(key) } else { 100 },
  };
  assert_eq(out, 6)
}

fn main() -> Int = 0
