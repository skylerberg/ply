effect store {
  read get[table](key: String) -> Int
}

type Row = { key: String }

fn fetch<[l]>(row: Row) -> Int / {store.get[l]} = store.get[l](row.key)

fn first<[l]>(rows: List<Row>) -> Int / {store.get[l]} =
  match rows { [] -> 0, [l, ..] -> fetch[l](l) }

fn fetch_all<[l]>(rows: List<Row>) -> List<Int> / {store.get[l]} = rows.map(|l: Row| fetch[l](l))

test "a value with the same name as the label in scope does not replace that label" {
  let out = handle {
    first[users]([{ key: "ab" }])
      + fetch_all[users]([{ key: "a" }, { key: "abc" }]).fold(0, |n: Int, x: Int| n + x)
  } with {
    store.get[*t](key) -> if t == "users" { key.len() } else { 100 },
  };
  assert_eq(out, 6)
}

fn main() -> Int = 0
