type ParseError = { at: Int, reason: String }

effect parse {
  raise bad(e: ParseError)
  raise missing(key: String, line: Int)
  raise eof()
  read peek() -> Int
}

fn digit(b: Int) -> Int / {parse.bad} =
  if b >= 48 && b <= 57 { b - 48 } else { parse.bad({ at: b, reason: "not a digit" }) }

fn checked(b: Int) -> Result<Int, ParseError> / {} =
  handle { digit(b) } with { parse.bad(e) -> Err(e), return v -> Ok(v) }

test "a raise becomes an `Err` holding its values, and a body that does not raise becomes an `Ok`" {
  assert_eq(checked(53), Ok(5));
  assert_eq(checked(1), Err({ at: 1, reason: "not a digit" }))
}

test "calling a raising operation type-checks as an `Int` or as a `String`, whichever the surrounding code needs" {
  let n: Int = handle { parse.eof() } with { parse.eof() -> 1 };
  let s: String = handle { parse.eof() } with { parse.eof() -> "end" };
  assert_eq((n, s), (1, "end"))
}

test "a `handle` clause receives every value passed to the raise" {
  let r = handle { parse.missing("port", 3) } with { parse.missing(key, line) -> (key, line) };
  assert_eq(r, ("port", 3))
}

test "the innermost handle handles it" {
  let r = handle { handle { digit(1) } with { parse.bad(e) -> 10 } } with { parse.bad(e) -> 20 };
  assert_eq(r, 10)
}

test "a raise in a clause goes past the handles inside the one whose clause raised" {
  let r = handle {
    handle { handle { parse.peek() } with { parse.bad(e) -> 1 } } with { parse.peek() -> digit(0) }
  } with {
    parse.bad(e) -> 2,
  };
  assert_eq(r, 2)
}

fn peeked() -> Int / {parse.peek, parse.bad} = digit(parse.peek())

test "an inner clause for `parse.peek` or `parse.eof` passes other `parse` raises to an outer `handle`" {
  let r = handle {
    handle { peeked() } with { parse.peek() -> 7 }
  } with {
    parse.bad(e) -> 0 - e.at,
  };
  assert_eq(r, 0 - 7);
  let s = handle {
    handle { if digit(1) > 0 { parse.eof() } else { 0 } } with { parse.eof() -> 1 }
  } with {
    parse.bad(e) -> 2,
  };
  assert_eq(s, 2)
}

test "a raise closes the scopes its body opened" {
  let r = handle {
    with_scope[inner](1, |x: Int| ()) { c -> digit(c.get()) }
  } with {
    parse.bad(e) -> 9,
  };
  assert_eq(r, 9)
}

effect tally {
  write add(n: Int) -> Unit
}

test "a raise unwinding through `bracket` still runs the release function on the acquired value" {
  let out = handle {
    handle {
      bracket(|| 1, |h: Int| tally.add(h), |h: Int| digit(h))
    } with {
      parse.bad(e) -> 0 - 1,
    }
  } with {
    var released = 0,
    tally.add(n) -> {
      released = released + n;
    },
    return r -> (r, released),
  };
  assert_eq(out, (0 - 1, 1))
}

test "a raise in a parallel branch is handled around the block" {
  let r = handle {
    let (a, b) = parallel { 1, digit(2) };
    a + b
  } with {
    parse.bad(e) -> e.at,
  };
  assert_eq(r, 2)
}

test "a task may raise, and its raise is handled around its simulation" {
  let r = handle {
    simulate {
      let t = task.spawn(|| digit(3));
      task.join(t)
    }
  } with {
    parse.bad(e) -> 0 - e.at,
  };
  assert_eq(r, 0 - 3)
}

test "a task handles its own raise" {
  let r = simulate {
    let t = task.spawn(|| checked(4));
    task.join(t)
  };
  assert_eq(r, Err({ at: 4, reason: "not a digit" }))
}

effect choice {
  read flip() -> Bool
}

fn risky() -> Int / {choice.flip, parse.bad} = if choice.flip() { digit(6) } else { 3 }

test "a raise in a body that resumes off the tail is handled by its own handle" {
  let r = handle {
    risky()
  } with {
    choice.flip() resume k -> {
      let v = k(true);
      v + 30
    },
    parse.bad(e) -> 1000,
    return v -> v * 10,
  };
  assert_eq(r, 1030)
}

fn deep(n: Int) -> Int / {parse.bad} = if n <= 0 { digit(0) } else { 1 + deep(n - 1) }

fn each(bs: List<Int>) -> List<Int> / {parse.bad} = bs.map(digit)

test "a raise unwinds every call between it and its handle, a builtin's among them" {
  assert_eq(handle { deep(5000) } with { parse.bad(e) -> 0 - 1 }, 0 - 1);
  assert_eq(handle { each([48, 49]) } with { parse.bad(e) -> [] }, [0, 1]);
  assert_eq(handle { each([48, 1, 2]) } with { parse.bad(e) -> [e.at] }, [1])
}
