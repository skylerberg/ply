fn parse(s: String) -> Int / {abort.raise} =
  if s == "1" { 1 } else { abort.raise("not one: " ++ s) }

fn safe(s: String) -> Result<Int, String> / {} =
  handle { parse(s) } with { abort.raise(m) -> Err(m), return v -> Ok(v) }

test "a `handle` clause turns a raise into a result, and a body that does not raise returns its own value" {
  assert_eq(safe("1"), Ok(1));
  assert_eq(safe("2"), Err("not one: 2"))
}

test "the innermost handle handles it" {
  let r = handle {
    handle { parse("x") } with { abort.raise(m) -> 10 }
  } with {
    abort.raise(m) -> 20,
  };
  assert_eq(r, 10)
}

effect ask {
  read get() -> Int
}

test "a raise in a clause goes past the handles inside the one whose clause raised" {
  let r = handle {
    handle {
      handle { ask.get() } with { abort.raise(m) -> 1 }
    } with {
      ask.get() -> abort.raise("from the clause"),
    }
  } with {
    abort.raise(m) -> 2,
  };
  assert_eq(r, 2)
}

test "a raise closes the scopes its body opened" {
  let r = handle {
    with_scope[inner](1, |x: Int| ()) { c -> abort.raise("out" ++ c.get().to_string()) }
  } with {
    abort.raise(m) -> 9,
  };
  assert_eq(r, 9)
}

test "a raise in a parallel branch is handled around the block" {
  let r = handle {
    let (a, b) = parallel { 1, abort.raise("left") };
    a + b
  } with {
    abort.raise(m) -> 7,
  };
  assert_eq(r, 7)
}

test "a raise in a task is handled around its simulation" {
  let r = handle {
    simulate {
      let t = task.spawn(|| parse("y"));
      task.join(t)
    }
  } with {
    abort.raise(m) -> 0 - 1,
  };
  assert_eq(r, 0 - 1)
}

effect choice {
  read flip() -> Bool
}

fn risky() -> Int / {choice.flip, abort.raise} = if choice.flip() { abort.raise("boom") } else { 3 }

test "a raise in a body that resumes off the tail is handled by its own handle" {
  let r = handle {
    risky()
  } with {
    choice.flip() resume k -> {
      let v = k(true);
      v + 30
    },
    abort.raise(m) -> 1000,
    return v -> v * 10,
  };
  assert_eq(r, 1030)
}
