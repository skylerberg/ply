//! A builtin states where it cannot raise, and a call the conditions on the way to it hold there
//! adds no `abort.raise`. Each function here writes no row, so it checks only because its guards
//! cover its builtin's `requires`; and each builtin raises just past what it states, and not at it.

fn caught<a>(f: () -> a / {abort.raise}) -> Result<a, String> =
  handle { f() } with { abort.raise(m) -> Err(m), return v -> Ok(v) }

fn raised<a>(f: () -> a / {abort.raise}) -> Bool =
  handle { f() } with { abort.raise(_m) -> true, return _v -> false }

fn peek(b: Bytes, i: Int) -> Int = if i < 0 || i >= bytes_len(b) { -1 } else { bytes_at(b, i) }

fn word_at(b: Bytes, at: Int) -> Option<Int> =
  if at < 0 || at > bytes_len(b) - 4 { None } else {
    Some(
      bytes_at(b, at) << 24 | bytes_at(b, at + 1) << 16 | bytes_at(b, at + 2) << 8
        | bytes_at(b, at + 3),
    )
  }

fn slice_at(b: Bytes, at: Int, n: Int) -> Option<Bytes> =
  if at < 0 || n < 0 || at > bytes_len(b) || n > bytes_len(b) - at { None }
  else { Some(bytes_slice(b, at, at + n)) }

fn hex(b: Bytes) -> String =
  fold(range(0, bytes_len(b)), "", |acc: String, i: Int| {
    let n = bytes_at(b, i);
    acc ++ string_slice("0123456789abcdef", n / 16, n / 16 + 1)
      ++ string_slice("0123456789abcdef", n % 16, n % 16 + 1)
  })

fn big_endian(n: Int) -> Bytes =
  bytes_concat_all([
    byte_of_int(n >>> 24 & 0xFF),
    byte_of_int(n >>> 16 & 0xFF),
    byte_of_int(n >>> 8 & 0xFF),
    byte_of_int(n & 0xFF),
  ])

fn xored(a: Bytes, b: Bytes) -> Bytes =
  bytes_concat_all(
    map(range(0, min(bytes_len(a), bytes_len(b))), |i: Int|
      byte_of_int(bytes_at(a, i) ^ bytes_at(b, i))),
  )

fn last_char(s: String) -> String = {
  let n = string_len(s);
  if n == 0 { "" } else { string_slice(s, n - 1, n) }
}

fn wrapped(xs: List<Int>, i: Int) -> List<Int> =
  if i < 0 || len(xs) == 0 { xs } else { list_set(xs, i % len(xs), 0) }

fn replaced(xs: List<Int>, i: Int) -> List<Int> =
  match list_at(xs, i) { Some(x) -> list_set(xs, i, x + 1), None -> xs }

fn slot(xs: Array<Int>, i: Int) -> Int =
  if 0 <= i && i < array_len(xs) { array_get(xs, i) } else { 0 }

fn ratio(a: Int, b: Int) -> Int = match b { 0 -> 0, _ -> a / b }

fn mean(xs: List<Int>) -> Int =
  if len(xs) > 0 { fold(xs, 0, |s: Int, x: Int| s + x) / len(xs) } else { 0 }

fn trimmed(b: Bytes, from: Int) -> Bytes =
  if from < 0 || from > bytes_len(b) { b"" }
  else { bytes_slice(b, bytes_scan(b, from, b" ", bytes_len(b)), bytes_len(b)) }

test "a guarded read answers inside its bounds and takes its other branch outside them" {
  assert_eq(map([-1, 0, 2, 3], |i: Int| peek(b"abc", i)), [-1, 97, 99, -1]);
  assert_eq(word_at(b"\x01\x02\x03\x04", 0), Some(0x0102_0304));
  assert_eq(map([-1, 1], |at: Int| word_at(b"\x01\x02\x03\x04", at)), [None, None]);
  assert_eq(slice_at(b"abcdef", 2, 4), Some(b"cdef"));
  assert_eq(
    map([[2, 5], [7, 0], [-1, 1], [1, -1]], |x: List<Int>|
      match x { [at, n] -> slice_at(b"abcdef", at, n), _ -> None }),
    [None, None, None, None],
  );
  assert_eq(slot(array_of_list([7, 8]), 1), 8);
  assert_eq(map([-1, 2], |i: Int| slot(array_of_list([7, 8]), i)), [0, 0]);
  assert_eq(trimmed(b"  ab", 0), b"ab");
  assert_eq(map([-1, 4, 5], |from: Int| trimmed(b"  ab", from)), [b"", b"", b""])
}

test "a loop over a range reads every index of it" {
  assert_eq(hex(b"\x00\x0f\xa5\xff"), "000fa5ff");
  assert_eq(hex(b""), "");
  assert_eq(xored(b"\x00\xff\x0f", b"\xff\xff"), b"\xff\x00");
  assert_eq(big_endian(0x0102_03FF), b"\x01\x02\x03\xff");
  assert_eq(big_endian(-1), b"\xff\xff\xff\xff")
}

test "a length, a pattern and a divisor held off zero are conditions too" {
  assert_eq(map(["", "a", "abc"], last_char), ["", "a", "c"]);
  assert_eq(wrapped([1, 2, 3], 7), [1, 0, 3]);
  assert_eq(wrapped([], 7), []);
  assert_eq(wrapped([1], -1), [1]);
  assert_eq(replaced([1, 2], 1), [1, 3]);
  assert_eq(replaced([1, 2], 2), [1, 2]);
  assert_eq(map([0, 2, -2], |b: Int| ratio(7, b)), [0, 3, -3]);
  assert_eq(map([[], [4, 8]], mean), [0, 6])
}

/// A zero-length value the checker cannot see into, so a call on it is judged where it runs.
fn none() -> List<Int> = filter([1], |x: Int| x > 1)

test "an index or a slice raises just past the value, and not at its last place" {
  let b = bytes_concat(b"ab", b"cd");
  let n = bytes_len(b) + len(none());
  assert_eq(caught(|| bytes_at(b, n - 1)), Ok(100));
  assert(raised(|| bytes_at(b, n)) && raised(|| bytes_at(b, -1 - len(none()))));
  assert_eq(caught(|| bytes_slice(b, n, n)), Ok(b""));
  assert(raised(|| bytes_slice(b, n, n + 1)) && raised(|| bytes_slice(b, 1 - len(none()), 0)));
  assert_eq(caught(|| int_of_u32(bytes_u32_le(b, n - 4))), Ok(0x6463_6261));
  assert(raised(|| bytes_u32_le(b, n - 3)) && raised(|| bytes_u32_le(b, -1 - len(none()))));
  let s = string_concat("ab", "cd");
  assert_eq(caught(|| string_slice(s, n, n)), Ok(""));
  assert(
    raised(|| string_slice(s, n - 1, n + 1)) && raised(|| string_slice(s, 2, 1 + len(none()))),
  );
  let xs = push([1, 2], 3);
  assert_eq(caught(|| list_set(xs, n - 2, 9)), Ok([1, 2, 9]));
  assert(raised(|| list_set(xs, n - 1, 9)) && raised(|| list_set(xs, -1 - len(none()), 9)));
  let a = array_of_list(xs);
  assert_eq(caught(|| array_get(a, n - 2)), Ok(3));
  assert(raised(|| array_get(a, n - 1)) && raised(|| array_set(a, n - 1, 0)));
  assert_eq(caught(|| array_len(array_new(n - 4, 0))), Ok(0));
  assert(raised(|| array_new(n - 5, 0)))
}

test "a narrowing raises just past what its type holds" {
  let z = len(none());
  assert_eq(caught(|| byte_of_int(255 + z)), Ok(b"\xff"));
  assert(raised(|| byte_of_int(256 + z)) && raised(|| byte_of_int(-1 - z)));
  assert_eq(caught(|| int_of_u8(u8_of_int(255 + z))), Ok(255));
  assert(raised(|| u8_of_int(256 + z)) && raised(|| u8_of_int(-1 - z)));
  assert_eq(caught(|| int_of_u16(u16_of_int(65535 + z))), Ok(65535));
  assert(raised(|| u16_of_int(65536 + z)));
  assert_eq(caught(|| int_of_u32(u32_of_int(4294967295 + z))), Ok(4294967295));
  assert(raised(|| u32_of_int(4294967296 + z)) && raised(|| u64_of_int(-1 - z)));
  assert_eq(caught(|| int_of_i8(i8_of_int(-128 - z))), Ok(-128));
  assert(raised(|| i8_of_int(-129 - z)) && raised(|| i8_of_int(128 + z)));
  assert_eq(caught(|| int_of_i16(i16_of_int(32767 + z))), Ok(32767));
  assert(raised(|| i16_of_int(32768 + z)) && raised(|| i16_of_int(-32769 - z)));
  assert_eq(caught(|| int_of_i32(i32_of_int(-2147483648 - z))), Ok(-2147483648));
  assert(raised(|| i32_of_int(2147483648 + z)) && raised(|| u128_of_int(-1 - z)));
  assert_eq(int_of_i64(i64_of_int(-9223372036854775807 - 1 - z)), -9223372036854775807 - 1)
}

test "a scan, a search and a split raise just outside what each states" {
  let b = bytes_concat(b"a b", b"");
  let n = bytes_len(b) + len(none());
  assert_eq(caught(|| bytes_scan(b, n, b" ", 0)), Ok(3));
  assert(raised(|| bytes_scan(b, n + 1, b" ", 0)) && raised(|| bytes_scan(b, 0, b" ", n - 4)));
  assert_eq(caught(|| bytes_scan_until(b, 0, b" ", n)), Ok(1));
  assert(raised(|| bytes_scan_until(b, n - 4, b" ", n)));
  assert_eq(caught(|| bytes_index_of_from(b, b"b", n)), Ok(None));
  assert(raised(|| bytes_index_of_from(b, b"b", n + 1)));
  assert_eq(caught(|| bytes_index_of_byte(b, 252 + n)), Ok(None));
  assert(raised(|| bytes_index_of_byte(b, 253 + n)) && raised(|| bytes_index_of_byte(b, n - 4)));
  assert_eq(caught(|| bytes_position(b, n, |c: Int| c == 32)), Ok(None));
  assert(raised(|| bytes_position(b, n + 1, |c: Int| c == 32)));
  assert_eq(caught(|| len(bytes_split(b, bytes_slice(b, 1, 2)))), Ok(2));
  assert(raised(|| bytes_split(b, bytes_slice(b, 1, 1))));
  assert(raised(|| string_split("a b", string_slice("a b", 1, 1))));
  assert(!raised(|| decimal_round(1.25m, 28 + len(none()), HalfEven)));
  assert(raised(|| decimal_round(1.25m, 29 + len(none()), HalfEven)))
}
