fn caught<a>(f: () -> a / {abort.raise}) -> Result<a, String> =
  handle { f() } with { abort.raise(m) -> Err(m), return v -> Ok(v) }

fn raised<a>(f: () -> a / {abort.raise}) -> Bool =
  handle { f() } with { abort.raise(_m) -> true, return _v -> false }

fn peek(b: Bytes, i: Int) -> Int = if i < 0 || i >= b.len() { -1 } else { b.at(i) }

fn word_at(b: Bytes, at: Int) -> Option<Int> =
  if at < 0 || at > b.len() - 4 { None }
  else { Some(b.at(at) << 24 | b.at(at + 1) << 16 | b.at(at + 2) << 8 | b.at(at + 3)) }

fn slice_at(b: Bytes, at: Int, n: Int) -> Option<Bytes> =
  if at < 0 || n < 0 || at > b.len() || n > b.len() - at { None } else { Some(b.slice(at, at + n)) }

fn hex(b: Bytes) -> String =
  range(0, b.len()).fold("", |accumulator: String, i: Int| {
    let n = b.at(i);
    accumulator ++ "0123456789abcdef".slice(n / 16, n / 16 + 1)
      ++ "0123456789abcdef".slice(n % 16, n % 16 + 1)
  })

fn big_endian(n: Int) -> Bytes =
  Bytes::concat_all([
    byte_of_int(n >>> 24 & 0xFF),
    byte_of_int(n >>> 16 & 0xFF),
    byte_of_int(n >>> 8 & 0xFF),
    byte_of_int(n & 0xFF),
  ])

fn xored(a: Bytes, b: Bytes) -> Bytes =
  Bytes::concat_all(range(0, min(a.len(), b.len())).map(|i: Int| byte_of_int(a.at(i) ^ b.at(i))))

fn last_char(s: String) -> String = {
  let n = s.len();
  if n == 0 { "" } else { s.slice(n - 1, n) }
}

fn wrapped(xs: List<Int>, i: Int) -> List<Int> =
  if i < 0 || xs.len() == 0 { xs } else { xs.set(i % xs.len(), 0) }

fn replaced(xs: List<Int>, i: Int) -> List<Int> =
  match xs.at(i) { Some(x) -> xs.set(i, x + 1), None -> xs }

fn slot(xs: Array<Int>, i: Int) -> Int = if 0 <= i && i < xs.len() { xs.get(i) } else { 0 }

fn ratio(a: Int, b: Int) -> Int = match b { 0 -> 0, _ -> a / b }

fn mean(xs: List<Int>) -> Int =
  if xs.len() > 0 { xs.fold(0, |s: Int, x: Int| s + x) / xs.len() } else { 0 }

fn trimmed(b: Bytes, from: Int) -> Bytes =
  if from < 0 || from > b.len() { b"" } else { b.slice(b.scan(from, b" ", b.len()), b.len()) }

fn upper(c: Int) -> Bytes = match c { b'a'..=b'z' -> byte_of_int(c - 32), _ -> b"" }

fn digit_text(c: Int) -> String =
  match c { b'0'..=b'9' -> "0123456789".slice(c - b'0', c - b'0' + 1), _ -> "" }

fn hex_text(c: Int) -> String =
  match c {
    b'0'..=b'9' | b'a'..=b'f' ->
      "0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdef".slice(c - 48, c - 47),
    _ -> "",
  }

fn head_byte(xs: Array<Int>, b: Bytes) -> Int =
  if xs.len() == 0 { -1 } else {
    let i = xs.get(0);
    if 0 <= i && i < b.len() { b.at(i) } else { -1 }
  }

fn scoped_byte<[r]>(h: Scoped<Int, [r]>, b: Bytes) -> Int / {scoped.read[r]} = {
  let i = h.get();
  if 0 <= i && i < b.len() { b.at(i) } else { -1 }
}

fn scoped_bytes_at<[r]>(h: Scoped<Bytes, [r]>, i: Int) -> Int / {scoped.read[r]} =
  if 0 <= i && i < h.get().len() { h.get().at(i) } else { -1 }

fn whole(d: Decimal) -> Decimal = d.round(0, Down)

fn cents(d: Decimal) -> Decimal = if d.scale() < 2 { d } else { d.round(2, HalfEven) }

test "a range pattern checks both of its bounds, so a value just outside either bound does not match" {
  assert_eq([b'`', b'a', b'z', b'{'].map(upper), [b"", b"A", b"Z", b""]);
  assert_eq([b'/', b'0', b'9', b':'].map(digit_text), ["", "0", "9", ""]);
  assert_eq([b'/', b'0', b'9', b'a', b'f', b'g'].map(hex_text), ["", "0", "9", "a", "f", ""])
}

test "a guarded read returns inside its bounds and takes its other branch outside them" {
  assert_eq([-1, 0, 2, 3].map(|i: Int| peek(b"abc", i)), [-1, 97, 99, -1]);
  assert_eq(word_at(b"\x01\x02\x03\x04", 0), Some(0x0102_0304));
  assert_eq([-1, 1].map(|at: Int| word_at(b"\x01\x02\x03\x04", at)), [None, None]);
  assert_eq(slice_at(b"abcdef", 2, 4), Some(b"cdef"));
  assert_eq(
    [[2, 5], [7, 0], [-1, 1], [1, -1]].map(|x: List<Int>|
      match x { [at, n] -> slice_at(b"abcdef", at, n), _ -> None }),
    [None, None, None, None],
  );
  assert_eq(slot(Array::of_list([7, 8]), 1), 8);
  assert_eq([-1, 2].map(|i: Int| slot(Array::of_list([7, 8]), i)), [0, 0]);
  assert_eq(trimmed(b"  ab", 0), b"ab");
  assert_eq([-1, 4, 5].map(|from: Int| trimmed(b"  ab", from)), [b"", b"", b""])
}

test "a loop over a range reads every index of it" {
  assert_eq(hex(b"\x00\x0f\xa5\xff"), "000fa5ff");
  assert_eq(hex(b""), "");
  assert_eq(xored(b"\x00\xff\x0f", b"\xff\xff"), b"\xff\x00");
  assert_eq(big_endian(0x0102_03FF), b"\x01\x02\x03\xff");
  assert_eq(big_endian(-1), b"\xff\xff\xff\xff")
}

test "the checker accepts code as unable to raise when a list's length, an index or a divisor is first checked to be nonzero" {
  assert_eq(["", "a", "abc"].map(last_char), ["", "a", "c"]);
  assert_eq(wrapped([1, 2, 3], 7), [1, 0, 3]);
  assert_eq(wrapped([], 7), []);
  assert_eq(wrapped([1], -1), [1]);
  assert_eq(replaced([1, 2], 1), [1, 3]);
  assert_eq(replaced([1, 2], 2), [1, 2]);
  assert_eq([0, 2, -2].map(|b: Int| ratio(7, b)), [0, 3, -3]);
  assert_eq([[], [4, 8]].map(mean), [0, 6])
}

fn empty_list() -> List<Int> = [1].filter(|x: Int| x > 1)

fn read_word(b: Bytes, i: Int) -> Int / {abort.raise} = Int::of_u32(b.u32_le(i))

fn read_byte(b: Bytes, i: Int) -> Int / {abort.raise} = b.at(i)

test "an index or a slice raises one position past the end of the bytes, but not at the last position" {
  let b = b"ab".concat(b"cd");
  let n = b.len() + empty_list().len();
  assert_eq(caught(|| b.at(n - 1)), Ok(100));
  assert(raised(|| b.at(n)) && raised(|| b.at(-1 - empty_list().len())));
  assert_eq(caught(|| b.slice(n, n)), Ok(b""));
  assert(raised(|| b.slice(n, n + 1)) && raised(|| b.slice(1 - empty_list().len(), 0)));
  assert_eq(caught(|| Int::of_u32(b.u32_le(n - 4))), Ok(0x6463_6261));
  assert(raised(|| b.u32_le(n - 3)) && raised(|| b.u32_le(-1 - empty_list().len())));
  assert_eq(caught(|| read_word(b, n - 4)), Ok(0x6463_6261));
  assert(raised(|| read_word(b, n - 3)) && raised(|| read_word(b, -1 - empty_list().len())));
  assert(
    raised(|| read_word(b.slice(0, 2), 0)) && raised(|| read_word(b"", 0 - empty_list().len())),
  );
  assert_eq(caught(|| read_byte(b, n - 1)), Ok(100));
  assert(raised(|| read_byte(b, n)) && raised(|| read_byte(b, -1 - empty_list().len())));
  let s = "ab".concat("cd");
  assert_eq(caught(|| s.slice(n, n)), Ok(""));
  assert(raised(|| s.slice(n - 1, n + 1)) && raised(|| s.slice(2, 1 + empty_list().len())));
  let xs = [1, 2].push(3);
  assert_eq(caught(|| xs.set(n - 2, 9)), Ok([1, 2, 9]));
  assert(raised(|| xs.set(n - 1, 9)) && raised(|| xs.set(-1 - empty_list().len(), 9)));
  let a = Array::of_list(xs);
  assert_eq(caught(|| a.get(n - 2)), Ok(3));
  assert(raised(|| a.get(n - 1)) && raised(|| a.set(n - 1, 0)));
  assert_eq(caught(|| Array::new(n - 4, 0).len()), Ok(0));
  assert(raised(|| Array::new(n - 5, 0)))
}

test "a narrowing conversion raises for the first integer outside the range of the target type" {
  let z = empty_list().len();
  assert_eq(caught(|| byte_of_int(255 + z)), Ok(b"\xff"));
  assert(raised(|| byte_of_int(256 + z)) && raised(|| byte_of_int(-1 - z)));
  assert_eq(caught(|| Int::of_u8(U8::of_int(255 + z))), Ok(255));
  assert(raised(|| U8::of_int(256 + z)) && raised(|| U8::of_int(-1 - z)));
  assert_eq(caught(|| Int::of_u16(U16::of_int(65535 + z))), Ok(65535));
  assert(raised(|| U16::of_int(65536 + z)));
  assert_eq(caught(|| Int::of_u32(U32::of_int(4294967295 + z))), Ok(4294967295));
  assert(raised(|| U32::of_int(4294967296 + z)) && raised(|| U64::of_int(-1 - z)));
  assert_eq(caught(|| Int::of_i8(I8::of_int(-128 - z))), Ok(-128));
  assert(raised(|| I8::of_int(-129 - z)) && raised(|| I8::of_int(128 + z)));
  assert_eq(caught(|| Int::of_i16(I16::of_int(32767 + z))), Ok(32767));
  assert(raised(|| I16::of_int(32768 + z)) && raised(|| I16::of_int(-32769 - z)));
  assert_eq(caught(|| Int::of_i32(I32::of_int(-2147483648 - z))), Ok(-2147483648));
  assert(raised(|| I32::of_int(2147483648 + z)) && raised(|| U128::of_int(-1 - z)));
  assert_eq(Int::of_i64(I64::of_int(-9223372036854775807 - 1 - z)), -9223372036854775807 - 1)
}

test "a scan, a search and a split raise for a start position, byte or separator outside their valid range" {
  let b = b"a b".concat(b"");
  let n = b.len() + empty_list().len();
  assert_eq(caught(|| b.scan(n, b" ", 0)), Ok(3));
  assert(raised(|| b.scan(n + 1, b" ", 0)) && raised(|| b.scan(0, b" ", n - 4)));
  assert_eq(caught(|| b.scan_until(0, b" ", n)), Ok(1));
  assert(raised(|| b.scan_until(n - 4, b" ", n)));
  assert_eq(caught(|| b.index_of_from(b"b", n)), Ok(None));
  assert(raised(|| b.index_of_from(b"b", n + 1)));
  assert_eq(caught(|| b.index_of_byte(252 + n)), Ok(None));
  assert(raised(|| b.index_of_byte(253 + n)) && raised(|| b.index_of_byte(n - 4)));
  assert_eq(caught(|| b.position(n, |c: Int| c == 32)), Ok(None));
  assert(raised(|| b.position(n + 1, |c: Int| c == 32)));
  assert_eq(caught(|| b.split(b.slice(1, 2)).len()), Ok(2));
  assert(raised(|| b.split(b.slice(1, 1))));
  assert(raised(|| "a b".split("a b".slice(1, 1))))
}

test "a `let` binding of a value read from an array or a scoped value is checked like any integer, and reading a scoped value still counts as an effect" {
  assert_eq([[], [1], [5], [-1]].map(|xs: List<Int>| head_byte(Array::of_list(xs), b"abc")), [
    -1,
    98,
    -1,
    -1,
  ]);
  assert_eq(
    [1, 3, -1].map(|i: Int|
      with_scope[slot](i, |scoped_value: Int| ()) { h -> scoped_byte(h, b"abc") }),
    [98, -1, -1],
  );
  assert_eq(
    [0, 2, 3].map(|i: Int|
      with_scope[slot](b"abc", |scoped_value: Bytes| ()) { h -> scoped_bytes_at(h, i) }),
    [97, 99, -1],
  )
}

test "`Decimal` rounding to no more digits than the decimal has cannot raise, but rounding to more digits than a decimal can store raises" {
  let z = empty_list().len();
  let most = match Decimal::of_string("79228162514264337593543950335") { Some(d) -> d, None -> 0m };
  assert_eq(whole(most).to_string(), "79228162514264337593543950335");
  assert_eq([1.005m, 2.5m, -0.125m].map(|d: Decimal| cents(d).to_string()), [
    "1.00",
    "2.5",
    "-0.12",
  ]);
  assert_eq(caught(|| most.round(z, Up).to_string()), Ok(most.to_string()));
  assert_eq(
    caught(|| Decimal::round(7m, 28 + z, Down).to_string()),
    Ok("7.0000000000000000000000000000"),
  );
  assert(raised(|| most.round(1 + z, Down)) && raised(|| Decimal::round(8m, 28 + z, Down)));
  assert(
    raised(|| Decimal::round(1.25m, 29 + z, Down))
      && raised(|| Decimal::round(1.25m, -1 - z, Down)),
  )
}
