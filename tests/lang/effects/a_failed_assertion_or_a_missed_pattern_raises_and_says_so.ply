type Shape = | Circle(Int) | Tri(Int)

fn caught<a>(f: () -> a / {abort.raise}) -> Result<a, String> =
  handle { f() } with { abort.raise(m) -> Err(m), return v -> Ok(v) }

fn radius(s: Shape) -> Int / {abort.raise} = {
  let Circle(r) = s;
  r
}

fn false_condition() -> Result<Unit, String> = Err("assertion failed: condition is false")

test "an assertion that fails raises, whichever way its message is given" {
  assert_eq(caught(|| assert(false)), false_condition());
  assert_eq(caught(|| assert(false, Some("the balance must be positive"))), false_condition());
  assert_eq(caught(|| assert(false, message: Some("by name"))), false_condition());
  assert_eq(caught(|| assert(true, Some("never read"))), Ok(()))
}

test "two values that differ raise from `assert_eq`" {
  assert_eq(caught(|| assert_eq(1, 2)), Err("assertion failed: expected an `Int`, found an `Int`"));
  assert_eq(caught(|| assert_eq(2, 2)), Ok(()))
}

test "a `let` whose pattern misses raises" {
  assert_eq(caught(|| radius(Tri(2))), Err("`let` pattern did not match the bound value"));
  assert_eq(caught(|| radius(Circle(2))), Ok(2))
}
