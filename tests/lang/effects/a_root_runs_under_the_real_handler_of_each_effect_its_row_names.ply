// A root runs under the host handler of each effect its row names (`host for`), so what no handler
// of the program answers the machine does, whichever callee performs it; a handler the program
// writes answers first.

import std.os
import std.os (os)

fn workers() -> Int / {os.cpus} = os.cpus()

fn twice() -> Int / {os.pid} = os.pid() + os.pid()

test/nondet "a callee's operation reaches the host handler of its effect" {
  assert(workers() >= 1);
  assert(twice() == 2 * os.pid())
}

test "a handler of the program's own answers before the host handler would" {
  assert_eq(os::on({ ..os::machine(), cpus: 3 }, workers), 3)
}
