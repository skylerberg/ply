//! A handler may answer a function its clauses build: a `return` clause whose body is a `handle`
//! answers the function that `handle` answers.

effect tick {
  read now() -> Int
}

fn offset(n: Int) -> (Int) -> Int =
  handle {
    n
  } with {
    tick.now() -> 0,
    return v -> handle { |x: Int| x + v } with { tick.now() -> 0 },
  }

test "a return clause whose body is a handle returns the function that handle returns" {
  assert_eq(offset(5)(2), 7);
  assert_eq([1, 2].map(offset(10)), [11, 12])
}
