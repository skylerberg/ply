//! A handler may answer a function its clauses build: a resuming clause and a `return` clause that
//! answer lambdas thread a state through the body, and a `return` clause whose body is a `handle`
//! answers the function that `handle` answers.

effect state {
  read get() -> Int
}

effect tick {
  read now() -> Int
}

/// `body` with each `get` answered by the state the handler threads through the functions its
/// clauses answer, starting at `start`.
fn threaded(start: Int, body: () -> Int / {state.get}) -> Int = {
  let run = handle {
    body()
  } with {
    state.get() resume k -> |s: Int| k(s)(s + 1),
    return x -> |s: Int| x * 100 + s,
  };
  run(start)
}

fn counted() -> Int / {state.get} = state.get() + state.get() * 10

fn offset(n: Int) -> (Int) -> Int =
  handle {
    n
  } with {
    tick.now() -> 0,
    return v -> handle { |x: Int| x + v } with { tick.now() -> 0 },
  }

test "a handler threads its state through the functions its resuming and return clauses answer" {
  assert_eq(threaded(1, counted), 2103);
  assert_eq(threaded(5, || 7), 705)
}

test "a return clause whose body is a handle answers the function that handle answers" {
  assert_eq(offset(5)(2), 7);
  assert_eq([1, 2].map(offset(10)), [11, 12])
}
