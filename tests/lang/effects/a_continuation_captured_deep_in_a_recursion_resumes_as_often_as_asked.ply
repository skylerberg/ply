effect amb {
  multi read flip() -> Bool
}

/// One level of two nested calls, this one and the bracket's body, holding a `String` across the
/// call down.
fn level(xs: List<Int>) -> Int / {amb.flip} =
  match xs {
    [] -> if amb.flip() { 1 } else { 2 },
    [x, ..rest] ->
      bracket(|| x.to_string(), |s: String| (), |s: String| level(rest) + s.len() - s.len() + 1),
  }

fn deep(depth: Int) -> Int / {amb.flip} = level(range(0, depth))

fn both(depth: Int) -> Int =
  handle { deep(depth) } with { amb.flip() resume k -> k(true) * 100000 + k(false) }

fn thrice(depth: Int) -> Int =
  handle { deep(depth) } with { amb.flip() resume k -> k(true) + k(false) + k(true) }

type Saved = | Done(Int) | Parked((Bool) -> Saved)

fn parked(depth: Int) -> Saved =
  handle { Done(deep(depth)) } with { amb.flip() resume k -> Parked(k) }

fn again(s: Saved) -> Int =
  match s {
    Parked(k) -> match ((k(true), k(false))) { (Done(a), Done(b)) -> a * 100000 + b, _ -> 0 },
    Done(n) -> n,
  }

// 4,000 levels are 8,000 nested calls, near the bound on nesting whatever the frames weigh.
test "a continuation captured 8,000 calls deep resumes twice, each from where it stopped" {
  assert_eq(both(4000), 4001 * 100000 + 4002)
}

test "three times, and after its handle has returned" {
  assert_eq(thrice(4000), 4001 + 4002 + 4001);
  assert_eq(again(parked(4000)), 4001 * 100000 + 4002)
}

test "at every depth on the way down" {
  assert(
    range(0, 40).fold(true, |ok: Bool, i: Int|
      ok && both(i * 100) == (i * 100 + 1) * 100000 + i * 100 + 2),
  )
}
