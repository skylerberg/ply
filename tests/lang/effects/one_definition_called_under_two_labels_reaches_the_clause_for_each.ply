effect net {
  write send[s](payload: Bytes) -> Int
}

fn relay<[l]>(payload: Bytes) -> Int / {net.send[l]} = net.send[l](payload)

fn both(payload: Bytes) -> Int =
  handle {
    relay[conn](payload) + relay[upstream](payload)
  } with {
    var seen = 0,
    net.send[conn](p) -> {
      seen = seen + 1;
      p.len()
    },
    net.send[upstream](p) -> {
      seen = seen + 10;
      p.len()
    },
    return sent -> sent + seen,
  }

test "a call matching each label runs the clause written for that label" {
  assert_eq(both(b"ping"), 19)
}
