//! What a program pays for effects is the work its clauses do: a perform a clause answers, a raise a
//! `try` catches or a clause answers, a `try` that answers, a callback that performs and a function
//! value called at a wider row allocate nothing, so a run of a thousand allocates what a run of ten
//! does, and each allocates what the same work written without effects does.

import std.pace (meter, spent)

effect tally {
  write add(n: Int) -> Unit
}

effect bad {
  raise fail(at: Int)
}

fn adds(n: Int) -> Unit / {tally.add} =
  if n <= 0 { () } else {
    tally.add(1);
    adds(n - 1)
  }

/// `n` performs, each answered by a clause that resumes with nothing.
fn tallied(n: Int) -> Int =
  handle {
    adds(n)
  } with {
    var total = 0,
    tally.add(k) -> {
      total = total + k;
    },
    return done -> total,
  }

/// `n` plain calls, the reference a perform's cost is read against.
fn plain(n: Int) -> Int = if n <= 0 { 0 } else { 1 + plain(n - 1) }

fn failing(at: Int, depth: Int) -> Int / {bad.fail} =
  if depth <= 0 { bad.fail(at) } else { 1 + failing(at, depth - 1) }

/// `n` raises from five calls down, each caught by a `try`.
fn caught(n: Int) -> Int =
  if n <= 0 { 0 } else {
    let one = match try { failing(n, 5) } { Ok(v) -> v, Err(_) -> 1 };
    one + caught(n - 1)
  }

/// `n` `Err`s made and matched, the reference a caught raise's cost is read against.
fn made(n: Int) -> Int =
  if n <= 0 { 0 } else {
    let r: Result<Int, Int> = if plain(5) > 0 { Err(n) } else { Ok(n) };
    let one = match r { Ok(v) -> v, Err(_) -> 1 };
    one + made(n - 1)
  }

fn kept(n: Int) -> Int / {bad.fail} = if n < 0 { bad.fail(n) } else { n }

/// `n` `try`s whose bodies answer.
fn tried(n: Int) -> Int =
  if n <= 0 { 0 } else {
    let one = match try { kept(1) } { Ok(v) -> v, Err(_) -> 0 };
    one + tried(n - 1)
  }

/// `n` raises from five calls down, each answered by a handle's clause.
fn answered(n: Int) -> Int =
  if n <= 0 { 0 } else {
    let one = handle { failing(n, 5) } with { bad.fail(at) -> 1 };
    one + answered(n - 1)
  }

fn noting(xs: List<Int>) -> Int / {tally.add} = {
  let doubled = xs.map(|x: Int| {
    tally.add(x);
    x * 2
  });
  doubled.len()
}

/// What mapping `xs` with a callback that performs costs past mapping it with one that does not.
fn noted_past_pure(xs: List<Int>) -> Int / {meter.read} = {
  let noted = spent(|| handle { noting(xs) } with { tally.add(k) -> () });
  let pure = spent(|| xs.map(|x: Int| x * 2).len());
  noted.allocations - pure.allocations
}

fn summed(f: (Int) -> Int / {tally.add}, n: Int) -> Int / {tally.add} =
  if n <= 0 { 0 } else { f(n) + summed(f, n - 1) }

/// `n` calls of a function value that performs nothing, at a row that names `tally.add`.
fn widened(n: Int) -> Int = handle { summed(|x: Int| x + 1, n) } with { tally.add(k) -> () }

fn summed_exactly(f: (Int) -> Int, n: Int) -> Int =
  if n <= 0 { 0 } else { f(n) + summed_exactly(f, n - 1) }

/// `n` calls of a function value at its own row, the reference a wider row's cost is read against.
fn exact(n: Int) -> Int = summed_exactly(|x: Int| x + 1, n)

fn allocated(f: () -> Int) -> Int / {meter.read} = spent(f).allocations

test "a perform a clause answers allocates alike for ten performs and a thousand, as plain calls do" {
  assert_eq(tallied(10), 10);
  assert_eq(allocated(|| tallied(1000)), allocated(|| tallied(10)));
  assert_eq(allocated(|| tallied(10)), allocated(|| plain(10)))
}

test "a raise a try catches allocates alike for ten raises and a thousand, as an Err made and matched does" {
  assert_eq(caught(10), 10);
  assert_eq(allocated(|| caught(1000)), allocated(|| caught(10)));
  assert_eq(allocated(|| caught(10)), allocated(|| made(10)))
}

test "a try whose body answers allocates alike for ten and a thousand, as plain calls do" {
  assert_eq(tried(10), 10);
  assert_eq(allocated(|| tried(1000)), allocated(|| tried(10)));
  assert_eq(allocated(|| tried(10)), allocated(|| plain(10)))
}

test "a raise a handle's clause answers allocates alike for ten raises and a thousand, as plain calls do" {
  assert_eq(answered(10), 10);
  assert_eq(allocated(|| answered(1000)), allocated(|| answered(10)));
  assert_eq(allocated(|| answered(10)), allocated(|| plain(10)))
}

test "a callback that performs costs a map what a pure one costs, for ten items and a thousand" {
  assert_eq(noted_past_pure(range(0, 1000)), noted_past_pure(range(0, 10)));
  assert_eq(noted_past_pure(range(0, 10)), 0)
}

test "a function value called at a wider row allocates alike for ten calls and a thousand, as one at its own row does" {
  assert_eq(widened(3), 9);
  assert_eq(allocated(|| widened(1000)), allocated(|| widened(10)));
  assert_eq(allocated(|| widened(10)), allocated(|| exact(10)))
}
