effect db {
  read all[t]() -> List<Int>
}

fn rows() -> List<Int> / {db.all[users]} = db.all[users]()

fn counted(length: () -> Int / {abort.raise}) -> Result<Int, String> =
  handle {
    handle {
      rows().len()
    } with {
      db.all[users]() -> range(0, length()),
      abort.raise(m) -> panic("the handle a clause belongs to took its raise"),
    }
  } with {
    abort.raise(m) -> Err(m),
    return v -> Ok(v),
  }

test "what a clause body raises goes past its own handle" {
  assert_eq(counted(|| panic("seeded wrong")), Err("seeded wrong"));
  assert_eq(counted(|| 4 / [].len()), Err("division by zero"));
  assert_eq(counted(|| 2), Ok(2))
}
