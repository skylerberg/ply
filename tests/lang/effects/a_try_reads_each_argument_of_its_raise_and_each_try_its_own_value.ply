//! A `try` is written out as a `handle` whose binders the compiler makes: one for each argument of
//! the raise it answers, and one for the value its body returns. Each is read where its own `try`
//! binds it.

effect parse {
  raise failed(line: Int, column: Int)
}

fn position(line: Int, column: Int) -> Int / {parse.failed} =
  if line > 0 { parse.failed(line, column) } else { column }

fn both(a: Int, b: Int) -> (Result<Int, (Int, Int)>, Result<Int, (Int, Int)>) =
  (try { position(a, 7) }, try { position(b, 9) })

test "a try hands on each argument of the raise it handles, in order" {
  assert_eq(try { position(3, 4) }, Err((3, 4)))
}

test "two tries in one function each handle their own body" {
  assert_eq(both(0, 2), (Ok(7), Err((2, 9))));
  assert_eq(both(5, 0), (Err((5, 7)), Ok(9)))
}
