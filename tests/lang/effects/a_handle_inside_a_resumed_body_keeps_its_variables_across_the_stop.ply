//! A `handle` inside a body that a clause resumes off its tail holds its variables as they stood at
//! the stop when the body resumes, whatever the heap did while it waited, and gives each back once.

effect amb {
  read flip() -> Bool
}

effect tally {
  write add(n: Int) -> Unit
}

/// Strings made and let go, so a block the body held would be made again were it freed.
fn churned() -> Int =
  range(0, 16).map(|i: Int| i.to_string().concat(" churned")).fold(0, |n: Int, s: String|
    n + s.len())

/// What the inner handle's variable holds at the end of the world the flip makes.
fn worlds() -> List<List<Int>> =
  handle {
    handle {
      tally.add(1);
      tally.add(2);
      let b = amb.flip();
      tally.add(if b { 3 } else { 4 });
    } with {
      var seen: List<Int> = [],
      tally.add(n) -> {
        seen = seen.push(n);
      },
      return done -> [seen],
    }
  } with {
    amb.flip() resume k -> {
      let resumed: List<List<Int>> = k(churned() > 0);
      resumed
    },
  }

test "the resumption starts from the inner handle's variable as it stood at the stop" {
  assert_eq(worlds(), [[1, 2, 3]])
}
