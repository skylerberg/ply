effect amb {
  read flip() -> Bool
}

effect tally {
  write add(n: Int) -> Unit
}

fn churned() -> Int =
  range(0, 16).map(|i: Int| i.to_string().concat(" churned")).fold(0, |n: Int, s: String|
    n + s.len())

fn worlds() -> List<List<Int>> =
  handle {
    handle {
      tally.add(1);
      tally.add(2);
      let b = amb.flip();
      tally.add(if b { 3 } else { 4 });
    } with {
      var seen: List<Int> = [],
      tally.add(n) -> {
        seen = seen.push(n);
      },
      return done -> [seen],
    }
  } with {
    amb.flip() resume k -> {
      let resumed: List<List<Int>> = k(churned() > 0);
      resumed
    },
  }

test "after a resumption, the inner handle's variable has the value it had when the body was suspended" {
  assert_eq(worlds(), [[1, 2, 3]])
}
