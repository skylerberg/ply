//! `metered` counts each perform its body makes, those a `handle` inside the body answers among
//! them, whether the clause answers, resumes in its tail, or answers without resuming.

effect tally {
  write bump(n: Int) -> Unit
  read peek() -> Int
}

fn bumped(times: Int) -> Unit / {tally.bump} =
  range(0, times).fold((), |_: Unit, i: Int| tally.bump(i))

/// How many performs `metered` counts of `times` bumps and a peek.
fn counted(times: Int, run: (Int) -> Int) -> Int =
  metered(|| run(times)).performs.fold(0, |n: Int, p: { atom: String, count: Int }| n + p.count)

fn answered(times: Int) -> Int =
  handle {
    bumped(times);
    tally.peek()
  } with {
    tally.bump(n) -> (),
    tally.peek() -> 7,
  }

fn resumed(times: Int) -> Int =
  handle {
    bumped(times);
    tally.peek()
  } with {
    tally.bump(n) resume k -> k(()),
    tally.peek() resume k -> k(7),
  }

fn stopped(times: Int) -> Int =
  handle {
    bumped(times);
    tally.peek()
  } with {
    tally.bump(n) resume k -> if n == 2 { 0 } else { k(()) },
    tally.peek() -> 7,
  }

test "each perform an answering clause takes is counted once" {
  assert_eq(counted(9, answered) - counted(4, answered), 5);
  assert_eq(counted(0, answered), 1)
}

test "each perform a clause resuming in its tail takes is counted once" {
  assert_eq(counted(9, resumed) - counted(4, resumed), 5);
  assert_eq(counted(0, resumed), 1)
}

test "a perform whose clause answers without resuming is counted, and none after it" {
  assert_eq(counted(9, stopped), counted(5, stopped));
  assert_eq(counted(1, stopped), 2)
}
