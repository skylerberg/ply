//! A clause resuming off its tail runs the rest of the body from where it stopped, the operation's
//! arguments still its own afterwards, and a continuation parked in a value resumes in a later
//! entry.

effect amb {
  read flip[coin]() -> Bool
}

effect scale {
  read by(factor: Int, label: String) -> Int
}

fn scaled(seed: Int) -> Int =
  handle {
    scale.by(seed, "x") + 1
  } with {
    scale.by(factor, label) resume k -> {
      let resumed = k(factor);
      resumed + factor * label.len() * 10
    },
  }

test "an operation's arguments outlive the resumption of the continuation it stopped" {
  assert_eq(scaled(3), 4 + 30)
}

fn joined(s: String) -> String =
  handle {
    s.concat(if amb.flip[coin]() { "b" } else { "c" }).concat("d")
  } with {
    amb.flip[coin]() resume k -> String::concat(k(false), "!"),
    return x -> x,
  }

test "a clause resuming off its tail runs the rest of the body from where it stopped" {
  assert_eq(joined("a"), "acd!")
}

type Saved = | Done(Int) | Parked(once (Bool) -> Saved)

fn parked() -> Saved =
  handle {
    Done(if amb.flip[coin]() { 41 } else { 0 })
  } with {
    amb.flip[coin]() resume k -> Parked(k),
  }

fn resume_it(s: keep Saved) -> Int =
  match s { Parked(k) -> match k(true) { Done(n) -> n, Parked(later) -> 0 }, Done(n) -> n }

// `parked` is pure and nullary, so the memo is offered its answer; a `k` it kept would name a body
// only the first entry held, and this one would resume nothing.
test "a later entry resumes the continuation it parked itself" {
  assert_eq(resume_it(parked()), 41);
  assert_eq(resume_it(parked()), 41)
}
