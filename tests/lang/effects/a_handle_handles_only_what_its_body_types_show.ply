effect log {
  write note(line: String) -> Unit
}

effect net {
  write send[s](payload: Int) -> Int
}

fn quiet<| e>(f: () -> Int / e) -> Int / e = handle { f() } with { log.note(_line) -> () }

test "a callback's operation goes past a handle its generic caller opened" {
  let returned = handle {
    quiet(|| {
      log.note("x");
      1
    })
  } with {
    log.note(_line) resume k -> 100 + k(()),
  };
  assert_eq(returned, 101)
}

fn guarded<[l]>(x: Int) -> Int / {net.send[l]} =
  handle { net.send[l](x) } with { net.send[conn](_payload) -> 0 }

test "an operation on a label parameter is passed over a clause for a specific label and handled by the outer handle" {
  assert_eq(handle { guarded[conn](5) } with { net.send[conn](p) -> p + 1 }, 6)
}

fn main() -> Int = 0
