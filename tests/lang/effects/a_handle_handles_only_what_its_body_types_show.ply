//! A `handle` handles what its body's effects name. One that reaches the body only through a
//! effect variable or a label parameter of the enclosing definition is the caller's to handle, as
//! the enclosing signature says, whatever it turns out to be at run time.

effect log {
  write note(line: String) -> Unit
}

effect net {
  write send[s](payload: Int) -> Int
}

/// Generic over its callback's effects, so it cannot see or handle what they hold.
fn quiet<| e>(f: () -> Int / e) -> Int / e = handle { f() } with { log.note(_line) -> () }

test "a callback's operation goes past a handle its generic caller opened" {
  let returned = handle {
    quiet(|| {
      log.note("x");
      1
    })
  } with {
    log.note(_line) resume k -> 100 + k(()),
  };
  assert_eq(returned, 101)
}

/// Generic over its label, so a clause on a named label cannot handle what the label stands for.
fn guarded<[l]>(x: Int) -> Int / {net.send[l]} =
  handle { net.send[l](x) } with { net.send[conn](_payload) -> 0 }

test "an operation on a label parameter goes past a clause on a named label" {
  assert_eq(handle { guarded[conn](5) } with { net.send[conn](p) -> p + 1 }, 6)
}

fn main() -> Int = 0
