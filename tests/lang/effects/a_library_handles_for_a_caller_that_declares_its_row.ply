//! A library function can handle an effect for a body it is handed, and a caller that declares its
//! own row can still call it: the parameter's row says which atoms the handler consumes, with
//! `op[*]` standing for that operation on every label.

effect log {
  write note[chan](line: String) -> Unit
}

effect wire {
  write put[c](line: String) -> Unit
}

/// The library: it answers `log` for whatever body it is given, and performs `wire` itself.
fn sink<a | e>(body: () -> a / {log.note[*] | e}) -> a / {wire.put[c] | e} =
  handle { body() } with { log.note[*](line) -> wire.put[c](line) }

fn shout() -> Unit / {log.note[out], log.note[err]} = {
  log.note[out]("a");
  log.note[err]("b")
}

/// A caller that declares its row, which is what every entry point does.
fn relay() -> Unit / {wire.put[c]} = sink(|| shout())

test "the library's clause answers the body, so the caller handles only its own effect" {
  with_cell[seen]([]) { c -> {
    handle { relay() } with { wire.put[c](line) -> cell_set(c, push(cell_get(c), line)) };
    assert_eq(cell_get(c), ["a", "b"])
  } }
}

// A body that performs nothing satisfies a row that permits every label: a licence asks for
// nothing.
test "an empty body is permitted by a row that names every label" {
  handle { sink(|| ()) } with { wire.put[c](_line) -> () }
}

fn main() -> Int = 0
