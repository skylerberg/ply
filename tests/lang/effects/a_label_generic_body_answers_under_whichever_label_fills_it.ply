effect net {
  write send[s](payload: Int) -> Int
}

fn relay<[l]>(payload: Int) -> Int / {net.send[l]} = net.send[l](payload)

fn driver(x: Int) -> Int = handle { relay[conn](x) } with { net.send[conn](p) -> p + 1 }

test "a label-generic body called from another definition answers" { assert_eq(driver(1), 2) }

fn ping<[l]>(n: Int) -> Int / {net.send[l]} = if n <= 0 { net.send[l](0) } else { pong(n - 1) }

fn pong<[k]>(n: Int) -> Int / {net.send[k]} = if n <= 0 { net.send[k](1) } else { ping(n - 1) }

fn near(n: Int) -> Int = handle { ping[conn](n) } with { net.send[conn](p) -> p + 10 }

fn far(n: Int) -> Int = handle { ping[upstream](n) } with { net.send[upstream](p) -> p + 20 }

// One recursive group is checked with one label binder, so a sibling call passes the caller's label
// along, and stays the jump a self call is: a hundred thousand of them nest no deeper than one.
test "a sibling call carries the group's label through its jump" {
  assert_eq(near(0), 10);
  assert_eq(near(1), 11);
  assert_eq(far(0), 20);
  assert_eq(far(1), 21);
  assert_eq(near(100000), 10);
  assert_eq(far(100001), 21)
}
