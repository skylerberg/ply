//! A closure holding a value laid in several words and a label its effects name, called through a
//! function generic over effects, reads its own words by that label.

effect files {
  read kind[t](p: Int) -> Int
}

type Prepared = { a: Int, b: String, c: Int }

fn read_at<[r]>(p: Prepared, k: Int) -> Int / {files.kind[r]} = files.kind[r](k + p.a)

fn looked<| e>(reader: (Int) -> Int / {abort.raise | e}, k: Int) -> Int / {abort.raise | e} =
  reader(k)

fn afresh<[s]>(p: Prepared) -> Int / {files.kind[s], abort.raise} =
  looked(|k: Int| read_at[s](p, k) + p.c, 1)

test "the closure's label is read from where its captures end, however many words they take" {
  let n = handle { afresh[t]({ a: 2, b: "wide", c: 4 }) } with { files.kind[t](k) -> k * 10 };
  assert_eq(n, 34)
}
