effect files {
  read kind[t](p: Int) -> Int
}

type Prepared = { a: Int, b: String, c: Int }

fn read_at<[r]>(p: Prepared, k: Int) -> Int / {files.kind[r]} = files.kind[r](k + p.a)

fn apply_reader<| e>(reader: (Int) -> Int / {abort.raise | e}, k: Int) -> Int / {abort.raise | e} =
  reader(k)

fn read_prepared<[s]>(p: Prepared) -> Int / {files.kind[s], abort.raise} =
  apply_reader(|k: Int| read_at[s](p, k) + p.c, 1)

test "a closure reads its effect label correctly after captured values, even when the captured values take many machine words" {
  let n = handle {
    read_prepared[t]({ a: 2, b: "wide", c: 4 })
  } with {
    files.kind[t](k) -> k * 10,
  };
  assert_eq(n, 34)
}
