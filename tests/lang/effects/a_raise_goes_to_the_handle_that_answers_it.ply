//! `abort.raise` does not come back: the innermost `handle` with a clause for it answers in place of
//! the whole body, from outside, after the body is abandoned.

fn parse(s: String) -> Int / {abort.raise} =
  if s == "1" { 1 } else { abort.raise("not one: " ++ s) }

fn safe(s: String) -> Result<Int, String> / {} =
  handle { parse(s) } with { abort.raise(m) -> Err(m), return v -> Ok(v) }

test "a raise is answered by its clause, and a value by return" {
  assert_eq(safe("1"), Ok(1));
  assert_eq(safe("2"), Err("not one: 2"))
}

test "the innermost handle answers" {
  let r = handle {
    handle { parse("x") } with { abort.raise(m) -> 10 }
  } with {
    abort.raise(m) -> 20,
  };
  assert_eq(r, 10)
}

effect ask {
  read get() -> Int
}

test "a raise in a clause goes past the handles inside the one whose clause raised" {
  let r = handle {
    handle {
      handle { ask.get() } with { abort.raise(m) -> 1 }
    } with {
      ask.get() -> abort.raise("from the clause"),
    }
  } with {
    abort.raise(m) -> 2,
  };
  assert_eq(r, 2)
}

test "a raise closes the regions its body opened" {
  let r = handle {
    with_cell[inner](1) { c -> {
      cell_set(c, 2);
      abort.raise("out")
    } }
  } with {
    abort.raise(m) -> 9,
  };
  assert_eq(r, 9)
}

test "a cell keeps its contents across an update a raise abandoned" {
  with_cell[r](5) { c -> {
    handle {
      cell_update(c, |x: Int| if x > 0 { abort.raise("no") } else { x })
    } with {
      abort.raise(m) -> (),
    };
    assert_eq(cell_get(c), 5)
  } }
}

test "a raise in a parallel branch is answered around the block" {
  let r = handle {
    let (a, b) = parallel { 1, abort.raise("left") };
    a + b
  } with {
    abort.raise(m) -> 7,
  };
  assert_eq(r, 7)
}

test "a raise in a task is answered around its simulate region" {
  let r = handle {
    simulate {
      let t = task.spawn(|| parse("y"));
      task.join(t)
    }
  } with {
    abort.raise(m) -> 0 - 1,
  };
  assert_eq(r, 0 - 1)
}

effect amb {
  read flip() -> Bool
}

fn risky() -> Int / {amb.flip, abort.raise} = if amb.flip() { abort.raise("boom") } else { 3 }

test "a raise in a body that resumes off the tail is answered by its own handle" {
  let r = handle {
    risky()
  } with {
    amb.flip() resume k -> k(true) + k(false),
    abort.raise(m) -> 1000,
    return v -> v * 10,
  };
  assert_eq(r, 1030)
}
