effect stop {
  write now() -> Unit
}

effect fault {
  raise bad(n: Int)
}

test "a clause around the spawn that resumes on its tail handles the task" {
  let n = simulate {
    handle {
      let t = task.spawn(|| {
        stop.now();
        1
      });
      task.join(t)
    } with {
      stop.now() resume k -> k(()),
    }
  };
  assert_eq(n, 1)
}

test "a raise from a task is handled around the simulation" {
  let n = handle {
    simulate {
      let t = task.spawn(|| {
        fault.bad(3);
        1
      });
      task.join(t)
    }
  } with {
    fault.bad(n) -> n * 10,
  };
  assert_eq(n, 30)
}
