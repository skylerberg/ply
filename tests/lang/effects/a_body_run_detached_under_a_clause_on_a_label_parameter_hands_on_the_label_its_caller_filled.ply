effect store {
  read query[t](id: Int) -> Int
  read batch[t](ids: List<Int>) -> List<Int>
}

type Step = | Done(Int) | Asking({ id: Int, next: once (Int) -> Step })

fn ten_of(id: Int) -> Int / {store.query[items]} = store.query[items](id)

fn stepped<[t]>(go: keep () -> Int / {store.query[t]}) -> Step =
  handle { Done(go()) } with { store.query[t](id) resume k -> Asking({ id: id, next: k }) }

fn with_store<a>(
  body: () -> a / {store.query[items], store.batch[items], abort.raise},
) -> a / {abort.raise} =
  handle {
    body()
  } with {
    store.query[items](id) -> id * 10,
    store.batch[items](ids) -> ids.map(|id: Int| id * 10),
  }

test "a handler clause for an effect label passed as a type argument handles the body's operation, and resuming the body with a value lets it finish" {
  let request_id = with_store(||
    match stepped[items](|| ten_of(3) + 1) { Done(_) -> 0 - 1, Asking(a) -> a.id });
  assert_eq(request_id, 3);
  let ended = with_store(||
    match stepped[items](|| ten_of(4) + 1) {
      Done(n) -> n,
      Asking({ next, .. }) -> match next(40) { Done(n) -> n, Asking(later) -> 0 - 1 },
    });
  assert_eq(ended, 41)
}
