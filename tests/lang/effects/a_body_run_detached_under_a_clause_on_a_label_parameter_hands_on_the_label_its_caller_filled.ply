//! A `handle` whose clause answers a label parameter and resumes off its tail runs its body
//! detached; what the body calls is handed the label the caller filled, so the clause answers the
//! body's operations at that label, however many other labels and effects the program names.

effect store {
  read query[t](id: Int) -> Int
  read batch[t](ids: List<Int>) -> List<Int>
}

type Step = | Done(Int) | Asking({ id: Int, next: once (Int) -> Step })

fn ten_of(id: Int) -> Int / {store.query[items]} = store.query[items](id)

/// `go` run up to its first query at `t`, which it hands back with the rest of the run.
fn stepped<[t]>(go: keep () -> Int / {store.query[t]}) -> Step =
  handle { Done(go()) } with { store.query[t](id) resume k -> Asking({ id: id, next: k }) }

/// `body` with both operations at `items` answered, and the raise its row names left to its caller.
fn host_handler<a>(
  body: () -> a / {store.query[items], store.batch[items], abort.raise},
) -> a / {abort.raise} =
  handle {
    body()
  } with {
    store.query[items](id) -> id * 10,
    store.batch[items](ids) -> ids.map(|id: Int| id * 10),
  }

test "the clause on the label answers the body's query, and the body resumed with an answer ends" {
  let asked = host_handler(||
    match stepped[items](|| ten_of(3) + 1) { Done(_) -> 0 - 1, Asking(a) -> a.id });
  assert_eq(asked, 3);
  let ended = host_handler(||
    match stepped[items](|| ten_of(4) + 1) {
      Done(n) -> n,
      Asking({ next, .. }) -> match next(40) { Done(n) -> n, Asking(later) -> 0 - 1 },
    });
  assert_eq(ended, 41)
}
