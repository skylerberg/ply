effect log {
  write note[chan](line: String) -> Unit
}

effect wire {
  write put[c](line: String) -> Unit
}

fn sink<a | e>(body: () -> a / {log.note[*] | e}) -> a / {wire.put[c] | e} =
  handle { body() } with { log.note[*](line) -> wire.put[c](line) }

fn shout() -> Unit / {log.note[out], log.note[err]} = {
  log.note[out]("a");
  log.note[err]("b")
}

fn relay() -> Unit / {wire.put[c]} = sink(|| shout())

test "the library's clause handles the body, so the caller handles only its own effect" {
  let seen = handle {
    relay()
  } with {
    var seen = [],
    wire.put[c](line) -> {
      seen = seen.push(line);
    },
    return u -> seen,
  };
  assert_eq(seen, ["a", "b"])
}

test "an empty body is permitted by effects that name every label" {
  handle { sink(|| ()) } with { wire.put[c](_line) -> () }
}

fn main() -> Int = 0
