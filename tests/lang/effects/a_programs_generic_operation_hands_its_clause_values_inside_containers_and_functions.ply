effect deck {
  write take<elem>(xs: List<elem>) -> elem
  write first<a>(xs: List<a>) -> Option<a>
  write tallied<a>(xs: List<a>) -> Map<a, Int>
  write swapped<a>(p: { x: a, y: a }) -> { x: a, y: a }
  write flipped<a>(p: Pair<a>) -> Pair<a>
  write identity<a>(xs: Array<a>) -> Array<a>
  write twice<a>(f: (a) -> a, x: a) -> a
  write later<a>(x: a) -> () -> a
}

type Pair<a> = | Both(a, a) | One(a)

fn tally<a>(xs: List<a>) -> Map<a, Int> =
  xs.fold(Map::new(), |m: Map<a, Int>, x: a|
    m.insert(x, match m.get(x) { Some(n) -> n + 1, None -> 1 }))

fn with_deck<r | e>(body: () -> r / {deck.write | e}) -> r / {abort.raise | e} =
  handle {
    body()
  } with {
    deck.take(xs) -> match xs { [x, ..] -> x, [] -> panic("an empty deck") },
    deck.first(xs) -> xs.at(0),
    deck.tallied(xs) -> tally(xs),
    deck.swapped(p) -> { x: p.y, y: p.x },
    deck.flipped(p) -> match p { Both(x, y) -> Both(y, x), One(x) -> One(x) },
    deck.identity(xs) -> xs,
    deck.twice(f, x) -> f(f(x)),
    deck.later(x) -> || x,
  }

test "a clause takes an element out of a list that an operation call passes it, for each element type the call uses" {
  assert_eq(
    with_deck(|| { n: deck.take([4, 5]), s: deck.take(["four"]), r: deck.take([{ n: 4 }]) }),
    { n: 4, s: "four", r: { n: 4 } },
  );
  assert_eq(with_deck(|| (deck.first([[1, 2], [3]]), deck.first([0].drop(1)))), (
    Some([1, 2]),
    None,
  ))
}

test "a clause can build a map keyed by values of the operation's own type parameter, and the map's entries are sorted by key" {
  assert_eq(with_deck(|| deck.tallied(["b", "a", "b"])).entries(), [
    { key: "a", value: 1 },
    { key: "b", value: 2 },
  ]);
  assert_eq(with_deck(|| deck.tallied([3, 1, 3, 3])).entries(), [
    { key: 1, value: 1 },
    { key: 3, value: 3 },
  ])
}

test "a clause can destructure and rebuild a record, a sum and an array whose types the operation call chooses" {
  assert_eq(with_deck(|| deck.swapped({ x: "x", y: "y" })), { x: "y", y: "x" });
  assert_eq(with_deck(|| deck.flipped(Both([1], [2]))), Both([2], [1]));
  assert_eq(with_deck(|| deck.flipped(One(7))), One(7));
  assert_eq(with_deck(|| deck.identity(Array::of_list(["a", "b"]))).to_list(), ["a", "b"])
}

test "a clause can call a function passed by the operation, and return a function, at the types the operation call chooses" {
  assert_eq(with_deck(|| deck.twice(|n: Int| n + 1, 4)), 6);
  assert_eq(with_deck(|| deck.twice(|s: String| s ++ "!", "hi")), "hi!!");
  assert_eq(with_deck(|| deck.later({ n: 5 }))(), { n: 5 })
}
