fn caught<a>(f: () -> a / {abort.raise}) -> Result<a, String> =
  handle { f() } with { abort.raise(m) -> Err(m), return v -> Ok(v) }

test "panic raises its message" {
  assert_eq(caught(|| panic("no such thing")), Err("no such thing"))
}

test "a builtin called with an argument outside its valid range raises, such as `at`, `slice`, `U8::of_int` and `set`" {
  assert(caught(|| b"ab".at(5)) != Ok(0));
  assert(caught(|| "abc".slice(2, 9)) != Ok(""));
  assert(caught(|| b"abc".slice(0, 4)) != Ok(b""));
  assert(caught(|| U8::of_int(300)) != Ok(0u8));
  assert(caught(|| String::of_bytes(b"\xff")) != Ok(""));
  assert(caught(|| [1, 2].set(9, 0)) != Ok([]));
  assert_eq(caught(|| b"ab".at(1)), Ok(98))
}

test "dividing by zero raises, and dividing by any other number does not" {
  let zero = [].len();
  assert_eq(caught(|| 7 / zero), Err("division by zero"));
  assert_eq(caught(|| 7 % zero), Err("remainder by zero"));
  assert_eq(caught(|| 7 / 2), Ok(3))
}

fn empty_list() -> List<Int> = []

test "a `let` whose pattern does not match the value raises" {
  let r = caught(|| {
    let [x, ..] = empty_list();
    x
  });
  assert(r != Ok(0))
}

test "a failed assertion raises" {
  assert(caught(|| assert_eq(1, 2)) != Ok(()));
  assert(caught(|| assert(false)) != Ok(()))
}

test "`iterate` raises when its loop does not stop within the step limit it was given" {
  let r = caught(|| iterate(0, 3, |n: Int| if n > 10 { Stop(n) } else { Continue(n + 1) }));
  assert_eq(r, Err("`iterate` did not stop within its budget of 3"))
}

fn simulated<a>(f: () -> a / {abort.raise, sim.read}) -> Result<a, String> / {sim.read} =
  handle { f() } with { abort.raise(m) -> Err(m), return v -> Ok(v) }

test "a channel with a negative capacity raises, and so does `random.below` with a bound below one" {
  let none = [].len();
  assert_eq(
    simulated(||
      simulate {
        let _ = task.channel(none - 1);
        0
      }),
    Err("a channel cannot hold -1 values"),
  );
  assert_eq(
    simulated(|| simulate { random.below(none) }),
    Err("`random.below` needs a bound above zero, but got 0"),
  );
  assert_eq(simulated(|| simulate { random.below(1) }), Ok(0))
}

fn halved<a>(x: a, y: a) -> a / {abort.raise}
  where integer(a)
= x / y

fn widened<a>(n: Int, at: a) -> a / {abort.raise}
  where numeric(a)
= numeric_of_int(n) + at - at

test "an operator or a constant in a function generic over a numeric type raises the same errors as the function does with the concrete type" {
  assert_eq(caught(|| halved(7, [].len())), Err("division by zero"));
  assert_eq(caught(|| halved(7u8, 0u8)), Err("division by zero"));
  assert_eq(caught(|| halved(7u8, 2u8)), Ok(3u8));
  assert(caught(|| widened(300, 0u8)) != Ok(0u8));
  assert_eq(caught(|| widened(3, 0u8)), Ok(3u8))
}

fn narrowed(n: Int) -> Int = handle { Int::of_u8(U8::of_int(n)) } with { abort.raise(m) -> 0 - 1 }

fn bound(v: Option<Int>) -> Int =
  handle {
    let Some(x) = v;
    x
  } with {
    abort.raise(m) -> 0 - 1,
  }

fn read(b: Bytes, i: Int) -> Int = handle { b.at(i) } with { abort.raise(m) -> 0 - 1 }

fn doubled(n: Int) -> Int = n * 2

fn read_within(i: Int) -> Int = handle { b"ab".at(i) + i } with { abort.raise(m) -> 0 - 1 }

fn read_and_passed(i: Int) -> Int = handle { doubled(b"ab".at(i)) } with { abort.raise(m) -> 0 - 1 }

fn read_wide(b: Bytes, i: Int) -> Int =
  handle { Int::of_u32(b.u32_le(i)) + i } with { abort.raise(m) -> 0 - 1 }

fn fetched(xs: Array<Int>, i: Int) -> Int = handle { xs.get(i) } with { abort.raise(m) -> 0 - 1 }

fn stepped(budget: Int) -> Int =
  handle {
    iterate(0, budget, |n: Int| if n >= 5 { Stop(n) } else { Continue(n + 1) })
  } with {
    abort.raise(m) -> 0 - 1,
  }

test "a `handle` catches a failure raised directly in its body and a failure raised in a function the body calls" {
  assert_eq([200, 300].map(narrowed), [200, 0 - 1]);
  assert_eq([Some(7), None].map(bound), [7, 0 - 1]);
  assert_eq([1, 9].map(|i: Int| read(b"ab", i)), [98, 0 - 1]);
  assert_eq([1, 9].map(read_within), [99, 0 - 1]);
  assert_eq([1, 9].map(read_and_passed), [196, 0 - 1]);
  assert_eq([0, 9].map(|i: Int| read_wide(b"\x01\x00\x00\x00", i)), [1, 0 - 1]);
  assert_eq([1, 9].map(|i: Int| fetched(Array::of_list([4, 5]), i)), [5, 0 - 1]);
  assert_eq([9, 3].map(stepped), [5, 0 - 1])
}
