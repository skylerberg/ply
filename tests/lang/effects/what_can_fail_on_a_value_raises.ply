// A failure the program could have avoided by the values it passed raises `abort.raise`, so a
// `handle` answers it like any other raise; what only the machine's limits stop is no raise.

fn caught<a>(f: () -> a / {abort.raise}) -> Result<a, String> =
  handle { f() } with { abort.raise(m) -> Err(m), return v -> Ok(v) }

test "panic raises its message" {
  assert_eq(caught(|| panic("no such thing")), Err("no such thing"))
}

test "a builtin outside what it is defined for raises" {
  assert(caught(|| bytes_at(b"ab", 5)) != Ok(0));
  assert(caught(|| string_slice("abc", 2, 9)) != Ok(""));
  assert(caught(|| u8_of_int(300)) != Ok(0u8));
  assert(caught(|| string_of_bytes(b"\xff")) != Ok(""));
  assert(caught(|| list_set([1, 2], 9, 0)) != Ok([]));
  assert_eq(caught(|| bytes_at(b"ab", 1)), Ok(98))
}

test "a division by zero raises, and one by anything else does not" {
  let zero = len([]);
  assert_eq(caught(|| 7 / zero), Err("division by zero"));
  assert_eq(caught(|| 7 % zero), Err("remainder by zero"));
  assert_eq(caught(|| 7 / 2), Ok(3))
}

fn nothing() -> List<Int> = []

test "a let whose pattern misses raises" {
  let r = caught(|| {
    let [x, ..] = nothing();
    x
  });
  assert(r != Ok(0))
}

test "a failed assertion raises" {
  assert(caught(|| assert_eq(1, 2)) != Ok(()));
  assert(caught(|| assert(false)) != Ok(()))
}

test "an iterate past its budget raises" {
  let r = caught(|| iterate(0, 3, |n: Int| if n > 10 { Stop(n) } else { Continue(n + 1) }));
  assert_eq(r, Err("`iterate` did not stop within its budget of 3"))
}

fn simulated<a>(f: () -> a / {abort.raise, sim.read}) -> Result<a, String> / {sim.read} =
  handle { f() } with { abort.raise(m) -> Err(m), return v -> Ok(v) }

test "a channel of a negative capacity, and a draw below one, raise" {
  let none = len([]);
  assert_eq(
    simulated(||
      simulate {
        let _ = task.channel(none - 1);
        0
      }),
    Err("a channel cannot hold -1 values"),
  );
  assert_eq(
    simulated(|| simulate { random.below(none) }),
    Err("`random.below` needs a bound above zero, but got 0"),
  );
  assert_eq(simulated(|| simulate { random.below(1) }), Ok(0))
}

fn halved<a>(x: a, y: a) -> a / {abort.raise}
  where integer(a)
= x / y

fn widened<a>(n: Int, at: a) -> a / {abort.raise}
  where numeric(a)
= numeric_of_int(n) + at - at

test "an operator or a constant over a numeric parameter raises where it would at the type" {
  assert_eq(caught(|| halved(7, len([]))), Err("division by zero"));
  assert_eq(caught(|| halved(7u8, 0u8)), Err("division by zero"));
  assert_eq(caught(|| halved(7u8, 2u8)), Ok(3u8));
  assert(caught(|| widened(300, 0u8)) != Ok(0u8));
  assert_eq(caught(|| widened(3, 0u8)), Ok(3u8))
}
