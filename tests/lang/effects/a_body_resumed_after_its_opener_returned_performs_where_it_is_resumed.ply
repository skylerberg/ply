//! A body whose `handle` resumes it off the tail, resumed after the function that opened the
//! `handle` returned, performs what is around its `handle` to the handlers around the call that
//! resumes it: nothing the opener held is reached once the opener is gone.

effect gen {
  write yield(n: Int) -> Unit
}

effect tell {
  write say(s: String) -> Unit
}

type Parked = | Done | Next(Int, once (Unit) -> Parked / {tell.say})

/// A body parked at its first yield, the handle around it, which says nothing, gone once this
/// returns.
fn first_yield() -> Parked =
  handle {
    handle {
      tell.say("a");
      gen.yield(1);
      tell.say("b");
      Done
    } with {
      gen.yield(n) resume k -> Next(n, k),
    }
  } with {
    tell.say(_s) -> (),
  }

/// What the parked body says once resumed here.
fn heard() -> List<String> =
  handle {
    match first_yield() {
      Next(_, rest) -> match rest(()) { Done -> (), Next(_, _) -> () },
      Done -> (),
    }
  } with {
    var said: List<String> = [],
    tell.say(s) -> {
      said = said.push(s);
    },
    return done -> said,
  }

test "a body resumed after the function that created its `handle` has returned performs effects to the handlers around the resuming call" {
  assert_eq(heard(), ["b"])
}
