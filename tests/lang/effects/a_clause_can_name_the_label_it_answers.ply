//! A clause written `[*]` answers its operation on every label, but its body cannot tell which one
//! it answered — and a handler that has to *check* the label rather than only answer it (a database
//! driver's tables, a trace sink's channels, a cache's key space) cannot be written without knowing
//! it. `[*t]` is the same coverage with the label bound: the clause answers every label and reads
//! the one its call site named.

effect store {
  read get[table](key: String) -> Int
  write put[table](key: String, value: Int) -> Unit
}

fn both() -> Int / {store.get[users], store.get[orders], store.put[orders]} = {
  store.put[orders]("a", 1);
  store.get[users]("a") + store.get[orders]("a")
}

test "the clause reads the label its call site named" {
  with_cell[seen]([]) { c -> {
    let out = handle {
      both()
    } with {
      store.get[*t](key) -> {
        cell_set(c, push(cell_get(c), t ++ " " ++ key));
        1
      },
      store.put[*t](key, _value) -> cell_set(c, push(cell_get(c), t ++ " " ++ key)),
    };
    assert_eq(out, 2);
    assert_eq(cell_get(c), ["orders a", "users a", "orders a"])
  } }
}

// The binder is a `String`, so it is a value the body can compare and answer with.
test "the label is a value the body decides on" {
  let out = handle {
    both()
  } with {
    store.get[*t](_key) -> if t == "users" { 10 } else { 20 },
    store.put[*t](_key, _value) -> (),
  };
  assert_eq(out, 30)
}

/// A label parameter is a label like any other: `relay<[l]>` performs `store.get[l]`, and the clause
/// that answers it sees the label the caller instantiated it at, not the parameter's name.
fn relay<[l]>(key: String) -> Int / {store.get[l]} = store.get[l](key)

test "the label bound is the one the call site used, not a parameter's name" {
  let out = handle {
    relay[users]("k") + relay[orders]("k")
  } with {
    store.get[*t](key) -> if t == "users" { string_len(key) } else { 100 },
  };
  assert_eq(out, 101)
}

// `[*]` and `[*t]` answer the same set of labels; the binder only adds a name for them.
test "a clause without a binder is answered exactly as before" {
  let out = handle { both() } with { store.get[*](_key) -> 1, store.put[*](_key, _value) -> () };
  assert_eq(out, 2)
}

// A clause that binds the label still cannot name one: `[*t]` covers every label, so a second
// clause for the same operation is unreachable and is reported as the duplicate it is.
test "a binding clause and a named clause for one operation are a duplicate" {
  let out = handle {
    both()
  } with {
    store.get[*t](_key) -> 1,
    store.put[orders](_key, _value) -> (),
    store.put[*t](_key, _value) -> (),
  };
  assert_eq(out, 2)
}

fn main() -> Int = 0
