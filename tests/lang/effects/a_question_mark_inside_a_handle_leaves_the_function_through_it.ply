effect ask {
  read get() -> Int
}

effect note {
  write say(s: String) -> Unit
}

effect stop {
  raise halt(n: Int)
}

fn parsed(b: Int) -> Result<Int, String> = if b < 0 { Err("negative") } else { Ok(b * 2) }

fn found(b: Int) -> Option<Int> = if b < 0 { None } else { Some(b + 1) }

fn with_ask(b: Int) -> Result<Int, String> = {
  let n = handle { parsed(b)? + ask.get() } with { ask.get() -> 10 };
  Ok(n + 1)
}

test "a `?` in a `handle`'s body leaves the function with what it unwrapped" {
  assert_eq(with_ask(1), Ok(13));
  assert_eq(with_ask(0 - 1), Err("negative"))
}

fn optional(b: Int) -> Option<Int> = handle { Some(found(b)? + ask.get()) } with { ask.get() -> 10 }

test "a `?` on an `Option` leaves with `None`" {
  assert_eq(optional(1), Some(12));
  assert_eq(optional(0 - 1), None)
}

fn in_clause(b: Int) -> Result<Int, String> =
  handle { Ok(ask.get()) } with { ask.get() -> parsed(b)? }

fn in_return(b: Int) -> Result<Int, String> =
  handle { ask.get() } with { ask.get() -> 3, return v -> Ok(parsed(b + v)? + 1) }

test "a `?` in a clause or a `return` clause leaves the function too" {
  assert_eq(in_clause(2), Ok(4));
  assert_eq(in_clause(0 - 1), Err("negative"));
  assert_eq(in_return(1), Ok(9));
  assert_eq(in_return(0 - 9), Err("negative"))
}

fn passing(b: Int) -> Result<List<String>, String> = {
  let messages = handle {
    note.say("before");
    let n = handle { parsed(b)? + ask.get() } with { ask.get() -> 0 };
    note.say("after");
    n
  } with {
    var collected: List<String> = [],
    note.say(s) -> {
      collected = collected.push(s);
    },
    return n -> collected,
  };
  Ok(messages)
}

test "a `?` exits every enclosing `handle`, and their `return` clauses do not run" {
  assert_eq(passing(1), Ok(["before", "after"]));
  assert_eq(passing(0 - 1), Err("negative"))
}

fn halting(b: Int) -> Int / {stop.halt} = if b > 5 { stop.halt(b) } else { b }

fn tried(b: Int) -> Result<Result<Int, Int>, String> = {
  let r = try { parsed(b)? + halting(b) };
  Ok(r)
}

test "a `?` inside a `try` exits the function, and the `try` still handles an error raised in its body" {
  assert_eq(tried(1), Ok(Ok(3)));
  assert_eq(tried(6), Ok(Err(6)));
  assert_eq(tried(0 - 1), Err("negative"))
}

fn lambda_exits(b: Int) -> Result<Int, String> = {
  let inner = |x: Int| -> Option<Int> {
    handle { Some(found(x)? + ask.get()) } with { ask.get() -> 100 }
  };
  let n = handle { parsed(b)? + ask.get() } with { ask.get() -> 0 };
  match inner(n - 4) { Some(v) -> Ok(v), None -> Err("none") }
}

test "a `?` in a typed lambda inside a `handle` exits only the lambda, and a `?` outside the lambda exits the function" {
  assert_eq(lambda_exits(3), Ok(103));
  assert_eq(lambda_exits(1), Err("none"));
  assert_eq(lambda_exits(0 - 1), Err("negative"))
}

fn summed(n: Int, accumulator: Int) -> Result<Int, String> =
  if n <= 0 { Ok(accumulator) } else {
    let v = handle { parsed(n)? + ask.get() } with { ask.get() -> 0 };
    summed(n - 1, accumulator + v)
  }

test "a function whose `handle` contains a `?` still loops through tail calls without growing the stack" {
  assert_eq(summed(100000, 0), Ok(10000100000))
}

fn question_after_resume(b: Int) -> Result<Int, String> = {
  let n = handle {
    parsed(b)? + ask.get()
  } with {
    ask.get() resume k -> {
      let n = k(1);
      n + 2
    },
  };
  Ok(n)
}

test "a `?` leaves a body that runs on a stack of its own" {
  assert_eq(question_after_resume(1), Ok(5));
  assert_eq(question_after_resume(0 - 1), Err("negative"))
}

fn spawning(b: Int) -> Result<Int, String> / {task.spawn, task.join, abort.raise} = {
  let n = handle { parsed(b)? + ask.get() } with { ask.get() -> 10 };
  let t = task.spawn(|| n + 1);
  Ok(task.join(t))
}

test "a `?` leaves a `handle` of a function that spawns" {
  simulate {
    assert_eq(spawning(1), Ok(13));
    assert_eq(spawning(0 - 1), Err("negative"))
  }
}
