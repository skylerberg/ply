effect box {
  write put<a>(x: a) -> Unit
  write swap<a>(x: a) -> a
  write same<a>(x: a, y: a) -> Bool
}

fn boxed() -> Int / {box.put} = {
  box.put(3);
  box.put("one");
  box.put({ n: 4, s: "four" });
  box.put([1, 2, 3]);
  5
}

test "an operation generic in its own type parameters is handled by a single clause at every type the operation is called with" {
  let returned = handle {
    boxed()
  } with {
    var put = 0,
    box.put(x) -> {
      put = put + 1;
    },
    return n -> n * 10 + put,
  };
  assert_eq(returned, 54)
}

test "a clause that stores the arguments of a generic operation frees each one as its own type requires" {
  let returned = handle {
    boxed()
  } with {
    var stored_count = 0,
    box.put(x) -> {
      let twice = [x, x];
      stored_count = stored_count + twice.len();
    },
    return n -> n * 10 + stored_count,
  };
  assert_eq(returned, 58)
}

fn swapped() -> { n: Int, s: String, r: { n: Int, s: String }, xs: List<Int> } / {box.swap} =
  {
    n: box.swap(4) + 1,
    s: box.swap("four") ++ "!",
    r: box.swap({ n: 4, s: "four" }),
    xs: box.swap([1, 2, 3]).push(4),
  }

test "a clause returns the argument of a generic operation at the type the operation call chooses" {
  assert_eq(handle { swapped() } with { box.swap(x) -> x }, {
    n: 5,
    s: "four!",
    r: { n: 4, s: "four" },
    xs: [1, 2, 3, 4],
  })
}

fn equal<a>(x: a, y: a) -> Bool = x == y

test "a clause compares the arguments of a generic operation using the equality of their own type" {
  let compared = handle {
    [
      box.same(4, 4),
      box.same(4, 5),
      box.same("four", "four"),
      box.same("four", "five"),
      box.same({ n: 4, s: "four" }, { n: 4, s: "four" }),
      box.same({ n: 4, s: "four" }, { n: 4, s: "five" }),
      box.same([1, 2, 3], [1, 2, 3]),
      box.same([1, 2, 3], [3, 2, 1]),
    ]
  } with {
    box.same(x, y) -> x == y && equal(y, x),
  };
  assert_eq(compared, [true, false, true, false, true, false, true, false])
}
