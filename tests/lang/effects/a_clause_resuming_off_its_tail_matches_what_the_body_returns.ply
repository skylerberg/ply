effect ask {
  read get() -> Int
}

fn parsed(b: Bytes) -> Result<Int, String> = if b.len() > 2 { Ok(b.len()) } else { Err("short") }

fn resuming(b: Bytes) -> Result<Int, String> =
  handle {
    let n = ask.get();
    match parsed(b) { Ok(v) -> Ok(v + n), Err(m) -> Err(m) }
  } with {
    ask.get() resume k -> match k(1) { Ok(v) -> Ok(v + 1), Err(m) -> Err(m) },
  }

fn found(b: Bytes) -> Option<String> =
  handle {
    let n = ask.get();
    if b.len() > n { Some("long") } else { None }
  } with {
    ask.get() resume k -> match k(2) { Some(s) -> Some(s.concat("er")), None -> None },
  }

type Pair = { left: Int, right: String }

fn paired(n: Int) -> Pair =
  handle {
    let y = ask.get();
    { left: y + n, right: "r" }
  } with {
    ask.get() resume k -> {
      let p = k(1);
      { left: p.left * 10, right: p.right.concat("s") }
    },
  }

test "a clause matches each case of a result its continuation returns" {
  assert_eq(resuming(b"abc"), Ok(5));
  assert_eq(resuming(b"a"), Err("short"))
}

test "a clause matches each case of an option its continuation returns" {
  assert_eq(found(b"abc"), Some("longer"));
  assert_eq(found(b"a"), None)
}

test "a clause reads the fields of a record its continuation returns" {
  assert_eq(paired(4), { left: 50, right: "rs" })
}
