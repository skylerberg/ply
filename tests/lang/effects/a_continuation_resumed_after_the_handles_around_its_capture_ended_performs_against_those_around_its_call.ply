//! A continuation is a function value: resumed after every `handle` around the place it was
//! captured has ended, what the rest of its body performs goes to the handles around the call that
//! resumes it.

effect gen {
  write give(n: Int) -> Unit
}

effect log {
  write note(n: Int) -> Unit
}

/// The body run up to its next `give`: what it gave and the rest of it, or nothing once it ended.
type Step = | Done | More(Int, once (Unit) -> Step / {log.note})

fn steps(body: keep () -> Unit / {gen.give, log.note}) -> Step / {log.note} =
  handle {
    body();
    Done
  } with {
    gen.give(n) resume k -> More(n, k),
  }

fn noisy() -> Unit / {gen.give, log.note} = {
  log.note(1);
  gen.give(10);
  log.note(2);
  gen.give(20)
}

/// The first step, its log handled by a handle that is over before the rest runs.
fn begun() -> Step = handle { steps(noisy) } with { log.note(n) -> () }

/// What the step after `rest` gave, and what the rest noted on the way.
fn resumed(rest: keep once (Unit) -> Step / {log.note}) -> (Int, Int) =
  handle {
    rest(())
  } with {
    var noted = 0,
    log.note(n) -> {
      noted = noted + n;
    },
    return s -> (match s { More(n, _) -> n, Done -> 0 }, noted),
  }

test "the rest of a body runs under the handles around the call that resumes it" {
  match begun() {
    Done -> assert(false, Some("the body gave nothing")),
    More(first, rest) -> {
      assert_eq(first, 10);
      assert_eq(resumed(rest), (20, 2))
    },
  }
}
