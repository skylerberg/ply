effect gen {
  write give(n: Int) -> Unit
}

effect log {
  write note(n: Int) -> Unit
}

type Step = | Done | More(Int, once (Unit) -> Step / {log.note})

fn steps(body: keep () -> Unit / {gen.give, log.note}) -> Step / {log.note} =
  handle {
    body();
    Done
  } with {
    gen.give(n) resume k -> More(n, k),
  }

fn noisy() -> Unit / {gen.give, log.note} = {
  log.note(1);
  gen.give(10);
  log.note(2);
  gen.give(20)
}

fn begun() -> Step = handle { steps(noisy) } with { log.note(n) -> () }

fn resumed(rest: keep once (Unit) -> Step / {log.note}) -> (Int, Int) =
  handle {
    rest(())
  } with {
    var noted = 0,
    log.note(n) -> {
      noted = noted + n;
    },
    return s -> (match s { More(n, _) -> n, Done -> 0 }, noted),
  }

test "the rest of a body runs under the handlers around the call that resumes its continuation" {
  match begun() {
    Done -> assert(false, Some("the body gave nothing")),
    More(first, rest) -> {
      assert_eq(first, 10);
      assert_eq(resumed(rest), (20, 2))
    },
  }
}
