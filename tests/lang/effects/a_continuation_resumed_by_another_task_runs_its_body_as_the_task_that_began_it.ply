effect choice {
  read flip() -> Bool
}

effect fault {
  raise bad(n: Int)
}

effect halt {
  write stop(code: Int) -> Int
}

type Suspension = | Done(Int) | Suspended(once (Bool) -> Suspension)

type Raising = | Finished(Int) | Waiting(once (Bool) -> Raising / {fault.bad})

fn done(s: keep Suspension) -> Int = match s { Done(n) -> n, Suspended(later) -> 0 - 1 }

fn ended(r: keep Raising) -> Int = match r { Finished(n) -> n, Waiting(later) -> 0 - 1 }

fn parked() -> Suspension =
  handle {
    handle { if choice.flip() { fault.bad(5) } else { 2 } } with { fault.bad(n) -> n * 10 }
  } with {
    choice.flip() resume k -> Suspended(k),
    return v -> Done(v),
  }

fn parked_twice() -> Suspension =
  handle {
    let a = choice.flip();
    let b = choice.flip();
    if a && b { 1 } else { 2 }
  } with {
    choice.flip() resume k -> Suspended(k),
    return v -> Done(v),
  }

fn halted() -> Suspension =
  handle {
    handle {
      if choice.flip() { halt.stop(7) + 1 } else { 2 }
    } with {
      halt.stop(code) resume k -> code,
    }
  } with {
    choice.flip() resume k -> Suspended(k),
    return v -> Done(v),
  }

fn waiting() -> Raising / {fault.bad} =
  handle {
    if choice.flip() { fault.bad(3) } else { 2 }
  } with {
    choice.flip() resume k -> Waiting(k),
    return v -> Finished(v),
  }

test "a continuation captured in one task and resumed in the `simulate` block sends its effects to the `handle` inside the resumed code" {
  let got = simulate {
    let t = task.spawn(|| parked());
    match task.join(t) { Suspended(k) -> done(k(true)), Done(n) -> n }
  };
  assert_eq(got, 50)
}

test "resuming a suspended task's continuation from the simulation body suspends again at the task's own handle" {
  let got = simulate {
    let t = task.spawn(|| parked_twice());
    match task.join(t) {
      Suspended(k) -> match k(true) { Suspended(k2) -> done(k2(true)), Done(n) -> n },
      Done(n) -> n,
    }
  };
  assert_eq(got, 1)
}

test "resuming a suspended task's continuation inside `simulate` runs the task's own `handle` clause, whose value is returned" {
  let got = simulate {
    let t = task.spawn(|| halted());
    match task.join(t) { Suspended(k) -> done(k(true)), Done(n) -> n }
  };
  assert_eq(got, 7)
}

test "an operation raised by a task's continuation is handled by the handle around the simulation body's call to the continuation" {
  let got = simulate {
    let t = task.spawn(|| handle { waiting() } with { fault.bad(n) -> Finished(n) });
    match task.join(t) {
      Waiting(k) -> ended(handle { k(true) } with { fault.bad(n) -> Finished(n * 10) }),
      Finished(n) -> n,
    }
  };
  assert_eq(got, 30)
}
