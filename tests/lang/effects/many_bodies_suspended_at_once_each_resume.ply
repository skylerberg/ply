effect amb {
  read flip() -> Bool
}

type Saved = | Done(Int) | Parked(once (Bool) -> Saved)

/// Bodies suspended at once, the last parked first.
type Held = | Empty | Holding(Saved, Held)

fn parked(i: Int) -> Saved =
  handle { Done(if amb.flip() { i } else { 0 - i }) } with { amb.flip() resume k -> Parked(k) }

/// `held` with the bodies from `i` up to `n` parked on it.
fn parked_from(i: Int, n: Int, held: keep Held) -> Held
  decreases n - i
= if i >= n { held } else { parked_from(i + 1, n, Holding(parked(i), held)) }

/// `sum` with each body of `held` resumed and its answer, plus one, added.
fn resumed(held: keep Held, sum: Int) -> Int =
  match held {
    Empty -> sum,
    Holding(s, rest) -> match s {
      Parked(k) -> match k(true) {
        Done(a) -> resumed(rest, sum + a + 1),
        Parked(again) -> resumed(rest, sum),
      },
      Done(_) -> resumed(rest, sum),
    },
  }

test "two thousand bodies suspended at once each resume" {
  assert_eq(resumed(parked_from(0, 2000, Empty), 0), 1999000 + 2000)
}
