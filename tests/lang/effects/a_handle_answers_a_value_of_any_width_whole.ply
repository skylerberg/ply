//! What a `handle` answers reaches its caller whole however its type is held, a value wider than a
//! call's registers or a `Decimal`: from a clause, one that answers in place of resuming among them,
//! from a `return` clause and from the body; and what a raise carries reaches its clause whole.

type Wide = { a: Int, b: Int, c: Int, d: Int, e: Int, f: Int, g: Int, h: Int }

effect fault {
  raise wide(w: Option<Wide>)
  raise money(d: Decimal)
}

effect probe {
  read get() -> Int
}

fn wide_of(n: Int) -> Wide =
  { a: n, b: n + 1, c: n + 2, d: n + 3, e: n + 4, f: n + 5, g: n + 6, h: n + 7 }

fn raising_wide(n: Int) -> Option<Wide> / {fault.wide} =
  if n > 0 { fault.wide(Some(wide_of(n))) } else { Some(wide_of(0 - n)) }

fn raising_money(n: Int) -> Decimal / {fault.money} =
  if n > 0 { fault.money(Decimal::of_int(n) * 2m) } else { 1m }

test "a clause answers a value wider than a call's registers whole, made of the one its raise carried" {
  let got = handle {
    raising_wide(3)
  } with {
    fault.wide(w) -> match w { Some(x) -> Some({ ..x, a: x.a * 10 }), None -> None },
  };
  assert_eq(got, Some({ ..wide_of(3), a: 30 }))
}

test "a return clause takes the body's wide value whole and answers one" {
  let got = handle {
    raising_wide(0 - 2)
  } with {
    fault.wide(w) -> w,
    return v -> match v { Some(x) -> Some({ ..x, h: x.h + x.a }), None -> None },
  };
  assert_eq(got, Some({ ..wide_of(2), h: 11 }))
}

/// A clause that resumes at its tail where `answering` is false, and answers the handle itself where
/// it is true.
fn probed(answering: Bool) -> Option<Wide> =
  handle {
    Some(wide_of(probe.get()))
  } with {
    probe.get() resume k -> if answering { Some(wide_of(9)) } else { k(1) },
  }

test "a clause that may resume at its tail but answers instead hands its handle a wide value whole" {
  assert_eq((probed(true), probed(false)), (Some(wide_of(9)), Some(wide_of(1))))
}

test "a clause and a return clause answer a Decimal whole" {
  let raised = handle { raising_money(3) } with { fault.money(d) -> d + 0.5m };
  let returned = handle { raising_money(0) } with { fault.money(d) -> d, return v -> v * 3m };
  assert_eq((raised, returned), (6.5m, 3m))
}

test "a try answers a wide value, or the wide value its raise carried" {
  assert_eq(try { raising_wide(0 - 1) }, Ok(Some(wide_of(1))));
  assert_eq(try { raising_wide(1) }, Err(Some(wide_of(1))))
}
