//! A clause that binds `resume` and never calls it answers for the `handle` it belongs to, so
//! `return`, which maps the body's own value, is not applied to it, whether or not another clause
//! resumes off the tail.

effect amb {
  read flip() -> Bool
  read fail() -> Int
}

fn pick() -> Int / {amb.flip, amb.fail} = if amb.flip() { 1 } else { amb.fail() }

test "beside a clause that resumes off the tail" {
  let r = handle {
    pick()
  } with {
    amb.flip() resume k -> k(true) + k(false),
    amb.fail() resume k -> 100,
    return v -> v * 10,
  };
  assert_eq(r, 110)
}

test "beside clauses that resume in tail position" {
  let r = handle {
    pick()
  } with {
    amb.flip() resume k -> k(false),
    amb.fail() resume k -> 100,
    return v -> v * 10,
  };
  assert_eq(r, 100)
}
