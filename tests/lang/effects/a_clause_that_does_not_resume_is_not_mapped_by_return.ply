effect choice {
  read flip() -> Bool
  read fail() -> Int
}

fn pick() -> Int / {choice.flip, choice.fail} = if choice.flip() { 1 } else { choice.fail() }

test "a clause that never resumes skips the `return` clause, even when another clause resumes and then uses the result" {
  let r = handle {
    pick()
  } with {
    choice.flip() resume k -> {
      let v = k(false);
      v + 1
    },
    choice.fail() resume k -> 100,
    return v -> v * 10,
  };
  assert_eq(r, 101)
}

test "a clause that does not resume skips the `return` clause when the other clauses resume in tail position" {
  let r = handle {
    pick()
  } with {
    choice.flip() resume k -> k(false),
    choice.fail() resume k -> 100,
    return v -> v * 10,
  };
  assert_eq(r, 100)
}
