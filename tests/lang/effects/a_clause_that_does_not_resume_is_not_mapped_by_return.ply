//! A clause that binds `resume` and never calls it returns for the `handle` it belongs to, so
//! `return`, which maps the body's own value, is not applied to it, whether or not another clause
//! resumes off the tail.

effect choice {
  read flip() -> Bool
  read fail() -> Int
}

fn pick() -> Int / {choice.flip, choice.fail} = if choice.flip() { 1 } else { choice.fail() }

test "beside a clause that resumes off the tail" {
  let r = handle {
    pick()
  } with {
    choice.flip() resume k -> {
      let v = k(false);
      v + 1
    },
    choice.fail() resume k -> 100,
    return v -> v * 10,
  };
  assert_eq(r, 101)
}

test "beside clauses that resume in tail position" {
  let r = handle {
    pick()
  } with {
    choice.flip() resume k -> k(false),
    choice.fail() resume k -> 100,
    return v -> v * 10,
  };
  assert_eq(r, 100)
}
