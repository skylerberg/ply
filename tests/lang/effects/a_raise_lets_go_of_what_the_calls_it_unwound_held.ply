//! A raise lets go of every value the calls it unwound held, so a program that answers raises in a
//! loop holds no more once each is answered than it did before.

fn caught<a>(f: () -> a / {abort.raise}) -> Result<a, String> =
  handle { f() } with { abort.raise(m) -> Err(m), return v -> Ok(v) }

/// How many items `f` built, or -1 where it raised.
fn built<a>(f: () -> List<a> / {abort.raise}) -> Int =
  match caught(f) { Ok(xs) -> xs.len(), Err(_) -> 0 - 1 }

/// A list built down `left` calls, each holding a list of its own across the next, raising where
/// `left` reaches `stop`.
fn nested(left: Int, stop: Int) -> List<List<Int>> / {abort.raise} = {
  let here = range(0, left);
  if left == stop { panic("stopped") }
  else if left <= 0 { [] }
  else { nested(left - 1, stop).push(here) }
}

fn folded(n: Int, stop: Int) -> List<List<Int>> / {abort.raise} =
  range(0, n).fold([], |acc: List<List<Int>>, i: Int|
    if i == stop { panic("stopped") } else { acc.push(range(0, i + 1)) })

fn mapped(n: Int, stop: Int) -> List<List<Int>> / {abort.raise} =
  range(0, n).map(|i: Int| if i == stop { panic("stopped") } else { range(0, i + 1) })

test "each loop returns what it built where it does not raise" {
  assert_eq(built(|| nested(40, 50)), 40);
  assert_eq(built(|| folded(40, 50)), 40);
  assert_eq(built(|| mapped(40, 50)), 40)
}

test "a raise midway through a loop leaves nothing the loop built live" {
  assert_eq([built(|| nested(40, 20)), built(|| folded(40, 20)), built(|| mapped(40, 20))], [
    0 - 1,
    0 - 1,
    0 - 1,
  ])
}

test "a hundred raises handled in a loop leave nothing live" {
  assert_eq(range(0, 100).fold(0, |n: Int, i: Int| n + built(|| folded(40, i % 40))), 0 - 100)
}
