fn caught<a>(f: () -> a / {abort.raise}) -> Result<a, String> =
  handle { f() } with { abort.raise(m) -> Err(m), return v -> Ok(v) }

fn count_built<a>(f: () -> List<a> / {abort.raise}) -> Int =
  match caught(f) { Ok(xs) -> xs.len(), Err(_) -> 0 - 1 }

fn nested(left: Int, stop: Int) -> List<List<Int>> / {abort.raise} = {
  let here = range(0, left);
  if left == stop { panic("stopped") }
  else if left <= 0 { [] }
  else { nested(left - 1, stop).push(here) }
}

fn folded(n: Int, stop: Int) -> List<List<Int>> / {abort.raise} =
  range(0, n).fold([], |accumulator: List<List<Int>>, i: Int|
    if i == stop { panic("stopped") } else { accumulator.push(range(0, i + 1)) })

fn mapped(n: Int, stop: Int) -> List<List<Int>> / {abort.raise} =
  range(0, n).map(|i: Int| if i == stop { panic("stopped") } else { range(0, i + 1) })

test "when nothing raises, each kind of loop completes and returns normally" {
  assert_eq(count_built(|| nested(40, 50)), 40);
  assert_eq(count_built(|| folded(40, 50)), 40);
  assert_eq(count_built(|| mapped(40, 50)), 40)
}

test "a raise partway through a loop frees every value the loop had built" {
  assert_eq(
    [
      count_built(|| nested(40, 20)),
      count_built(|| folded(40, 20)),
      count_built(|| mapped(40, 20)),
    ],
    [0 - 1, 0 - 1, 0 - 1],
  )
}

test "a hundred raises caught inside a loop free every value that was built" {
  assert_eq(range(0, 100).fold(0, |n: Int, i: Int| n + count_built(|| folded(40, i % 40))), 0 - 100)
}
