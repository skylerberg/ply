effect log {
  write note[tape](n: Int) -> Int
}

// The clause resumes in tail position, so what it assigned is what `return` reads.
test "a tail-resumptive clause's assignments are what its `return` reads" {
  let got = handle {
    log.note[tape](1) + log.note[tape](2)
  } with {
    var heard = 0,
    log.note[tape](n) -> {
      heard = heard * 10 + n;
      n
    },
    return total -> total + heard * 1000,
  };
  assert_eq(got, 12003)
}

fn twice_over() -> Int = {
  let xs = [1, 2, 3];
  let g = || xs.push(4).len();
  g() + g() + xs.len()
}

// A binding a closure captured is shared with the scope, never moved out from under a second call.
test "a captured binding is the same list at every call of the closure" {
  assert_eq(twice_over(), 4 + 4 + 3)
}

type Written = { store: Bytes, index: Bytes }

effect step {
  write once() -> Unit
}

fn read_at(packed: Option<Written>, n: Int) -> Int =
  match packed { Some(w) -> w.store.len() + n, None -> n }

fn over(read: (Int) -> Int) -> Int / {step.once} = {
  step.once();
  read(1)
}

fn asked(packed: Option<Written>) -> Int =
  handle { over(|n: Int| read_at(packed, n)) } with { step.once() -> () }

test "a closure in a handle's body captures an option of a record its function was given" {
  let w: Written = { store: b"ab", index: b"c" };
  assert_eq(asked(Some(w)), 3);
  assert_eq(asked(Some(w)), 3);
  assert_eq(asked(None), 1);
  assert_eq(w.store, b"ab")
}
