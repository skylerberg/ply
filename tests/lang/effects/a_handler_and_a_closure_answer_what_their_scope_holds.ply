effect log {
  write note[tape](n: Int) -> Int
}

// The clause resumes in tail position from inside the cell's region, so what it set is what the
// body reads after the handle.
test "a tail-resumptive handler inside a cell region answers honestly" {
  let got = with_cell[tape](0) { c -> {
    let total = handle { log.note[tape](1) + log.note[tape](2) } with {
      log.note[tape](n) -> {
        cell_set(c, cell_get(c) * 10 + n);
        n
      },
    };
    total + cell_get(c) * 1000
  } };
  assert_eq(got, 12003)
}

fn twice_over() -> Int = {
  let xs = [1, 2, 3];
  let g = || len(push(xs, 4));
  g() + g() + len(xs)
}

// A binding a closure captured is shared with the scope, never moved out from under a second call.
test "a captured binding is the same list at every call of the closure" {
  assert_eq(twice_over(), 4 + 4 + 3)
}
