// `try { body }` is `Ok` of what the body answers, or `Err` of what the one raise its row names
// carried; `try[effect.op] { body }` says which where the row names several. Either is the `handle`
// with a clause for that raise and a `return`.

type Bad = { at: Int, why: String }

effect parse {
  raise bad(e: Bad)
  raise missing(key: String, line: Int)
  raise eof()
}

fn digit(b: Int) -> Int / {parse.bad} =
  if b >= 48 && b <= 57 { b - 48 } else { parse.bad({ at: b, why: "not a digit" }) }

fn checked(b: Int) -> Result<Int, Bad> = try { digit(b) }

fn named(b: Int) -> Result<Int, Bad> = try[parse.bad] { digit(b) }

fn by_hand(b: Int) -> Result<Int, Bad> =
  handle { digit(b) } with { parse.bad(e) -> Err(e), return v -> Ok(v) }

test "a try answers what its handle would" {
  assert_eq(map([53, 1], checked), map([53, 1], by_hand));
  assert_eq(map([53, 1], named), map([53, 1], by_hand));
  assert_eq(checked(1), Err({ at: 1, why: "not a digit" }))
}

fn lookup(key: String) -> Int / {parse.missing} = if key == "a" { 1 } else { parse.missing(key, 7) }

fn end() -> Int / {parse.eof} = parse.eof()

test "a raise of several values is answered as their tuple, and a raise of none as unit" {
  assert_eq(try { lookup("a") }, Ok(1));
  assert_eq(try { lookup("b") }, Err(("b", 7)));
  let r: Result<Int, Unit> = try { end() };
  assert_eq(r, Err(()))
}

fn both(key: String, b: Int) -> Int / {parse.missing, parse.bad} = lookup(key) + digit(b)

test "a try that names one raise lets the others pass" {
  let inner = try[parse.missing] { try[parse.bad] { both("a", 1) } };
  assert_eq(inner, Ok(Err({ at: 1, why: "not a digit" })));
  let outer = try[parse.missing] { try[parse.bad] { both("z", 1) } };
  assert_eq(outer, Err(("z", 7)))
}

test "what can fail on a value is answered only by name" {
  let zero = len(filter([1], |x: Int| x > 1));
  let r = try[abort.raise] { try { digit(48) / zero } };
  assert(match r { Err(_) -> true, Ok(_) -> false });
  let s = try[abort.raise] { try { digit(1) / zero } };
  assert_eq(s, Ok(Err({ at: 1, why: "not a digit" })))
}

test "a scrutinee may be a try, and so may a lambda's body" {
  let n = match try { digit(1) } { Ok(v) -> v, Err(e) -> 0 - e.at };
  assert_eq(n, 0 - 1);
  assert_eq(map([49, 2], |b: Int| try { digit(b) }), [Ok(1), Err({ at: 2, why: "not a digit" })])
}

fn raised(r: Result<Int, Bad>) -> Int / {parse.bad} = match r { Ok(v) -> v, Err(e) -> parse.bad(e) }

test "an Err is turned back into its raise by a function" {
  assert_eq(try { raised(checked(49)) + raised(checked(2)) }, Err({ at: 2, why: "not a digit" }));
  assert_eq(try { raised(checked(49)) + raised(checked(50)) }, Ok(3))
}

fn each(bs: List<Int>) -> List<Int> / {parse.bad} = map(bs, digit)

fn through<a | e>(f: () -> a / e) -> a / e = f()

test "a raise passes through a row variable to the try around the call" {
  assert_eq(try { each([48, 49]) }, Ok([0, 1]));
  assert_eq(try { through(|| each([48, 1, 2])) }, Err({ at: 1, why: "not a digit" }))
}

test "a task may raise into its own try, and into one around its simulate region" {
  let own = simulate {
    let t = task.spawn(|| try { digit(4) });
    task.join(t)
  };
  assert_eq(own, Err({ at: 4, why: "not a digit" }));
  let around = try {
    simulate {
      let t = task.spawn(|| digit(3));
      task.join(t)
    }
  };
  assert_eq(around, Err({ at: 3, why: "not a digit" }))
}

test "a try keeps what a bracket releases and what a cell held" {
  with_cell[held](5) { c -> {
    let r = try { bracket(|| 1, |h: Int| cell_set(c, cell_get(c) + h), |h: Int| digit(h)) };
    assert_eq(r, Err({ at: 1, why: "not a digit" }));
    assert_eq(cell_get(c), 6);
    let u = try { cell_update(c, |x: Int| x + digit(2)) };
    assert_eq(u, Err({ at: 2, why: "not a digit" }));
    assert_eq(cell_get(c), 6)
  } }
}
