//! A raise leaves the calls between it and what answers it without returning from them, and the run
//! has every one of them back, so a program that answers its bad inputs can meet any number of them.
//! A clause that never resumes leaves the same way. The calls come back as depth and never as work:
//! what a raise unwound was still done.

effect parse {
  raise refused(at: Int)
}

effect stop {
  write now() -> Unit
}

fn refuse(n: Int, depth: Int) -> Int / {parse.refused} =
  if depth <= 0 { parse.refused(n) } else { 1 + refuse(n, depth - 1) }

fn panics(depth: Int) -> Int / {abort.raise} =
  if depth <= 0 { panic("deep") } else { 1 + panics(depth - 1) }

fn stops(depth: Int) -> Int / {stop.write} =
  if depth <= 0 {
    stop.now();
    0
  } else { 1 + stops(depth - 1) }

fn refused(r: Result<Int, Int>) -> Int = match r { Ok(_) -> 0, Err(_) -> 1 }

/// How many of `n` rounds `once` answered 1 for.
fn rounds<| e>(n: Int, once: (Int) -> Int / e) -> Int / e =
  fold(range(0, n), 0, |acc: Int, i: Int| acc + once(i))

fn many() -> Int = 1000000

test "a million raises from twenty calls down are each answered by a try" {
  assert_eq(rounds(many(), |i: Int| refused(try { refuse(i, 20) })), many())
}

test "a million panics from twenty calls down are each answered by a handle" {
  assert_eq(rounds(many(), |i: Int| handle { panics(20) } with { abort.raise(m) -> 1 }), many())
}

test "a million bodies are each left twenty calls down by a clause that never resumes" {
  assert_eq(rounds(many(), |i: Int| handle { stops(20) } with { stop.now() resume k -> 1 }), many())
}

test "a million raises each unwind through a bracket, whose release runs every time" {
  with_cell[released](0) { c -> {
    let answered = rounds(many(), |i: Int|
      refused(try {
        bracket(|| i, |held: Int| cell_set(c, cell_get(c) + 1), |held: Int| refuse(held, 20))
      }));
    assert_eq(answered, many());
    assert_eq(cell_get(c), many())
  } }
}

test "a task answers a million raises of its own" {
  simulate {
    let t = task.spawn(|| rounds(many(), |i: Int| refused(try { refuse(i, 20) })));
    assert_eq(task.join(t), many())
  }
}

fn nothing(n: Int) -> List<Int> = filter([n], |v: Int| v < 0)

/// How many ways `fails` has.
fn ways() -> Int = 7

/// What a builtin raises where it stands, by which: a value a narrowing does not hold, a read past
/// a buffer's end and past an array's, a zero divisor, an `iterate` out of budget, a `let` that
/// misses, and a split by no separator.
fn fails(which: Int, n: Int) -> Int / {abort.raise} =
  if which == 0 { int_of_u8(u8_of_int(256 + n)) }
  else if which == 1 { bytes_at(b"ab", 2 + n) }
  else if which == 2 { array_get(array_new(2, 0), 2 + n) }
  else if which == 3 { n / (n - n) }
  else if which == 4 { iterate(n, 3, |i: Int| if i < 0 { Stop(i) } else { Continue(i + 1) }) }
  else if which == 5 {
    let [x, ..] = nothing(n);
    x
  } else { len(string_split("a b", string_slice("a b", 1, 1 + n - n))) }

fn falls(which: Int, n: Int, depth: Int) -> Int / {abort.raise} =
  if depth <= 0 { fails(which, n) } else { 1 + falls(which, n, depth - 1) }

/// Each of those made in a `handle`'s own body, which is what answers it.
fn answered_here(which: Int, n: Int) -> Int =
  if which == 0 { handle { int_of_u8(u8_of_int(256 + n)) } with { abort.raise(m) -> 1 } }
  else if which == 1 { handle { bytes_at(b"ab", 2 + n) } with { abort.raise(m) -> 1 } }
  else if which == 2 { handle { array_get(array_new(2, 0), 2 + n) } with { abort.raise(m) -> 1 } }
  else if which == 3 { handle { n / (n - n) } with { abort.raise(m) -> 1 } } else if which == 4 {
    handle {
      iterate(n, 3, |i: Int| if i < 0 { Stop(i) } else { Continue(i + 1) })
    } with {
      abort.raise(m) -> 1,
    }
  } else if which == 5 {
    handle {
      let [x, ..] = nothing(n);
      x
    } with {
      abort.raise(m) -> 1,
    }
  } else {
    handle {
      len(string_split("a b", string_slice("a b", 1, 1 + n - n)))
    } with {
      abort.raise(m) -> 1,
    }
  }

fn several() -> Int = 100000

test "what each builtin raises twenty calls down is answered, many more times than calls nest" {
  fold(range(0, ways()), (), |u: Unit, which: Int|
    assert_eq(
      rounds(several(), |i: Int| handle { falls(which, i, 20) } with { abort.raise(m) -> 1 }),
      several(),
    ))
}

test "what each builtin raises in a `handle`'s own body is answered by it, as many times" {
  fold(range(0, ways()), (), |u: Unit, which: Int|
    assert_eq(rounds(several(), |i: Int| answered_here(which, i)), several()))
}

test "what each builtin raises unwinds through a hold's region as many times, which lets the hold go each time" {
  with_cell[released](0) { c -> {
    fold(range(0, ways()), (), |u: Unit, which: Int|
      assert_eq(
        rounds(several(), |i: Int|
          handle {
            with_hold[slot](i, |held: Int| cell_set(c, cell_get(c) + 1)) { h ->
              falls(which, hold_get(h), 20)
            }
          } with {
            abort.raise(m) -> 1,
          }),
        several(),
      ));
    assert_eq(cell_get(c), ways() * several())
  } }
}

fn climbs(depth: Int) -> Int = if depth <= 0 { 0 } else { 1 + climbs(depth - 1) }

test "the calls a raise unwound are still counted as work done" {
  let raised = metered(|| refused(try { refuse(0, 20) }));
  let returned = metered(|| climbs(20));
  assert(raised.steps >= returned.steps)
}
