//! A raise leaves the calls between it and what answers it without returning from them, and the run
//! has every one of them back, so a program that answers its bad inputs can meet any number of them.
//! A clause that never resumes leaves the same way. The calls come back as depth and never as work:
//! what a raise unwound was still done.

effect parse {
  raise refused(at: Int)
}

effect stop {
  write now() -> Unit
}

fn refuse(n: Int, depth: Int) -> Int / {parse.refused} =
  if depth <= 0 { parse.refused(n) } else { 1 + refuse(n, depth - 1) }

fn panics(depth: Int) -> Int / {abort.raise} =
  if depth <= 0 { panic("deep") } else { 1 + panics(depth - 1) }

fn stops(depth: Int) -> Int / {stop.write} =
  if depth <= 0 {
    stop.now();
    0
  } else { 1 + stops(depth - 1) }

fn refused(r: Result<Int, Int>) -> Int = match r { Ok(_) -> 0, Err(_) -> 1 }

/// How many of `n` rounds `once` answered 1 for.
fn rounds<| e>(n: Int, once: (Int) -> Int / e) -> Int / e =
  fold(range(0, n), 0, |acc: Int, i: Int| acc + once(i))

fn many() -> Int = 1000000

test "a million raises from twenty calls down are each answered by a try" {
  assert_eq(rounds(many(), |i: Int| refused(try { refuse(i, 20) })), many())
}

test "a million panics from twenty calls down are each answered by a handle" {
  assert_eq(rounds(many(), |i: Int| handle { panics(20) } with { abort.raise(m) -> 1 }), many())
}

test "a million bodies are each left twenty calls down by a clause that never resumes" {
  assert_eq(rounds(many(), |i: Int| handle { stops(20) } with { stop.now() resume k -> 1 }), many())
}

test "a million raises each unwind through a bracket, whose release runs every time" {
  with_cell[released](0) { c -> {
    let answered = rounds(many(), |i: Int|
      refused(try {
        bracket(|| i, |held: Int| cell_set(c, cell_get(c) + 1), |held: Int| refuse(held, 20))
      }));
    assert_eq(answered, many());
    assert_eq(cell_get(c), many())
  } }
}

test "a task answers a million raises of its own" {
  simulate {
    let t = task.spawn(|| rounds(many(), |i: Int| refused(try { refuse(i, 20) })));
    assert_eq(task.join(t), many())
  }
}

fn climbs(depth: Int) -> Int = if depth <= 0 { 0 } else { 1 + climbs(depth - 1) }

test "the calls a raise unwound are still counted as work done" {
  let raised = metered(|| refused(try { refuse(0, 20) }));
  let returned = metered(|| climbs(20));
  assert(raised.steps >= returned.steps)
}
