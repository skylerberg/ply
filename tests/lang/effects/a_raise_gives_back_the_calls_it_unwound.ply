//! A raise leaves the calls between it and what handles it without returning from them, and the run
//! has every one of them back, so a program that handles its bad inputs can meet any number of them.
//! A clause that never resumes leaves the same way.

effect parse {
  raise failed(at: Int)
}

effect stop {
  write now() -> Unit
}

fn reject(n: Int, depth: Int) -> Int / {parse.failed} =
  if depth <= 0 { parse.failed(n) } else { 1 + reject(n, depth - 1) }

fn panics(depth: Int) -> Int / {abort.raise} =
  if depth <= 0 { panic("deep") } else { 1 + panics(depth - 1) }

fn stops(depth: Int) -> Int / {stop.write} =
  if depth <= 0 {
    stop.now();
    0
  } else { 1 + stops(depth - 1) }

fn rejected(r: Result<Int, Int>) -> Int = match r { Ok(_) -> 0, Err(_) -> 1 }

/// How many of `n` rounds `once` returned 1 for.
fn rounds<| e>(n: Int, once: (Int) -> Int / e) -> Int / e =
  range(0, n).fold(0, |acc: Int, i: Int| acc + once(i))

fn million() -> Int = 1000000

/// How many times a test's callbacks were asked.
effect asks {
  write one() -> Unit
  read so_far() -> Int
}

/// `body` with a count of what it asks, from none.
fn counted<a | e>(body: () -> a / {asks.one, asks.so_far | e}) -> a / e =
  handle {
    body()
  } with {
    var n = 0,
    asks.one() -> {
      n = n + 1;
    },
    asks.so_far() -> n,
  }

test "a million raises from twenty calls down are each handled by a try" {
  assert_eq(rounds(million(), |i: Int| rejected(try { reject(i, 20) })), million())
}

test "a million panics from twenty calls down are each handled by a handle" {
  assert_eq(rounds(million(), |i: Int| handle { panics(20) } with { abort.raise(m) -> 1 }), million())
}

test "a million bodies are each left twenty calls down by a clause that never resumes" {
  assert_eq(rounds(million(), |i: Int| handle { stops(20) } with { stop.now() resume k -> 1 }), million())
}

test "a million raises each unwind through a bracket, whose release runs every time" {
  counted(|| {
    let returned = rounds(million(), |i: Int|
      rejected(try { bracket(|| i, |held: Int| asks.one(), |held: Int| reject(held, 20)) }));
    assert_eq(returned, million());
    assert_eq(asks.so_far(), million())
  })
}

test "a task handles a million raises of its own" {
  simulate {
    let t = task.spawn(|| rounds(million(), |i: Int| rejected(try { reject(i, 20) })));
    assert_eq(task.join(t), million())
  }
}

fn empty_list(n: Int) -> List<Int> = [n].filter(|v: Int| v < 0)

/// How many ways `fails` has.
fn ways() -> Int = 7

/// What a builtin raises where it stands, by which: a value a narrowing does not hold, a read past
/// a buffer's end and past an array's, a zero divisor, an `iterate` out of budget, a `let` that
/// misses, and a split by no separator.
fn fails(which: Int, n: Int) -> Int / {abort.raise} =
  if which == 0 { Int::of_u8(U8::of_int(256 + n)) }
  else if which == 1 { b"ab".at(2 + n) }
  else if which == 2 { Array::new(2, 0).get(2 + n) }
  else if which == 3 { n / (n - n) }
  else if which == 4 { iterate(n, 3, |i: Int| if i < 0 { Stop(i) } else { Continue(i + 1) }) }
  else if which == 5 {
    let [x, ..] = empty_list(n);
    x
  } else { "a b".split("a b".slice(1, 1 + n - n)).len() }

fn falls(which: Int, n: Int, depth: Int) -> Int / {abort.raise} =
  if depth <= 0 { fails(which, n) } else { 1 + falls(which, n, depth - 1) }

/// Each of those made in a `handle`'s own body, which is what handles it.
fn returned_here(which: Int, n: Int) -> Int =
  if which == 0 { handle { Int::of_u8(U8::of_int(256 + n)) } with { abort.raise(m) -> 1 } }
  else if which == 1 { handle { b"ab".at(2 + n) } with { abort.raise(m) -> 1 } }
  else if which == 2 { handle { Array::new(2, 0).get(2 + n) } with { abort.raise(m) -> 1 } }
  else if which == 3 { handle { n / (n - n) } with { abort.raise(m) -> 1 } } else if which == 4 {
    handle {
      iterate(n, 3, |i: Int| if i < 0 { Stop(i) } else { Continue(i + 1) })
    } with {
      abort.raise(m) -> 1,
    }
  } else if which == 5 {
    handle {
      let [x, ..] = empty_list(n);
      x
    } with {
      abort.raise(m) -> 1,
    }
  } else { handle { "a b".split("a b".slice(1, 1 + n - n)).len() } with { abort.raise(m) -> 1 } }

fn several() -> Int = 100000

test "what each builtin raises twenty calls down is handled, many more times than calls nest" {
  range(0, ways()).fold((), |u: Unit, which: Int|
    assert_eq(
      rounds(several(), |i: Int| handle { falls(which, i, 20) } with { abort.raise(m) -> 1 }),
      several(),
    ))
}

test "what each builtin raises in a `handle`'s own body is handled by it, as many times" {
  range(0, ways()).fold((), |u: Unit, which: Int|
    assert_eq(rounds(several(), |i: Int| returned_here(which, i)), several()))
}

test "what each builtin raises unwinds through a scoped value's scope as many times, which lets the scoped value go each time" {
  counted(|| {
    range(0, ways()).fold((), |u: Unit, which: Int|
      assert_eq(
        rounds(several(), |i: Int|
          handle {
            with_scope[slot](i, |held: Int| asks.one()) { h -> falls(which, h.get(), 20) }
          } with {
            abort.raise(m) -> 1,
          }),
        several(),
      ));
    assert_eq(asks.so_far(), ways() * several())
  })
}
