effect parse {
  raise failed(at: Int)
}

effect stop {
  write now() -> Unit
}

fn reject(n: Int, depth: Int) -> Int / {parse.failed} =
  if depth <= 0 { parse.failed(n) } else { 1 + reject(n, depth - 1) }

fn panics(depth: Int) -> Int / {abort.raise} =
  if depth <= 0 { panic("deep") } else { 1 + panics(depth - 1) }

fn stops(depth: Int) -> Int / {stop.write} =
  if depth <= 0 {
    stop.now();
    0
  } else { 1 + stops(depth - 1) }

fn rejected(r: Result<Int, Int>) -> Int = match r { Ok(_) -> 0, Err(_) -> 1 }

fn rounds<| e>(n: Int, once: (Int) -> Int / e) -> Int / e =
  range(0, n).fold(0, |accumulator: Int, i: Int| accumulator + once(i))

fn million() -> Int = 1000000

effect asks {
  write one() -> Unit
  read so_far() -> Int
}

fn counted<a | e>(body: () -> a / {asks.one, asks.so_far | e}) -> a / e =
  handle {
    body()
  } with {
    var n = 0,
    asks.one() -> {
      n = n + 1;
    },
    asks.so_far() -> n,
  }

test "a million raises made twenty calls deep are each handled by a `try`" {
  assert_eq(rounds(million(), |i: Int| rejected(try { reject(i, 20) })), million())
}

test "a `handle` block catches a million raises thrown from code nested twenty function calls deep" {
  assert_eq(
    rounds(million(), |i: Int| handle { panics(20) } with { abort.raise(m) -> 1 }),
    million(),
  )
}

test "a `handle` clause that never resumes the body can stop a body twenty calls deep, a million times in a row" {
  assert_eq(
    rounds(million(), |i: Int| handle { stops(20) } with { stop.now() resume k -> 1 }),
    million(),
  )
}

test "a million raises each unwind through a bracket, whose release runs every time" {
  counted(|| {
    let returned = rounds(million(), |i: Int|
      rejected(try {
        bracket(|| i, |acquired: Int| asks.one(), |acquired: Int| reject(acquired, 20))
      }));
    assert_eq(returned, million());
    assert_eq(asks.so_far(), million())
  })
}

test "a task handles a million raises of its own" {
  simulate {
    let t = task.spawn(|| rounds(million(), |i: Int| rejected(try { reject(i, 20) })));
    assert_eq(task.join(t), million())
  }
}

fn empty_list(n: Int) -> List<Int> = [n].filter(|v: Int| v < 0)

fn ways() -> Int = 7

fn fails(which: Int, n: Int) -> Int / {abort.raise} =
  if which == 0 { Int::of_u8(U8::of_int(256 + n)) }
  else if which == 1 { b"ab".at(2 + n) }
  else if which == 2 { Array::new(2, 0).get(2 + n) }
  else if which == 3 { n / (n - n) }
  else if which == 4 { iterate(n, 3, |i: Int| if i < 0 { Stop(i) } else { Continue(i + 1) }) }
  else if which == 5 {
    let [x, ..] = empty_list(n);
    x
  } else { "a b".split("a b".slice(1, 1 + n - n)).len() }

fn falls(which: Int, n: Int, depth: Int) -> Int / {abort.raise} =
  if depth <= 0 { fails(which, n) } else { 1 + falls(which, n, depth - 1) }

fn returned_here(which: Int, n: Int) -> Int =
  if which == 0 { handle { Int::of_u8(U8::of_int(256 + n)) } with { abort.raise(m) -> 1 } }
  else if which == 1 { handle { b"ab".at(2 + n) } with { abort.raise(m) -> 1 } }
  else if which == 2 { handle { Array::new(2, 0).get(2 + n) } with { abort.raise(m) -> 1 } }
  else if which == 3 { handle { n / (n - n) } with { abort.raise(m) -> 1 } } else if which == 4 {
    handle {
      iterate(n, 3, |i: Int| if i < 0 { Stop(i) } else { Continue(i + 1) })
    } with {
      abort.raise(m) -> 1,
    }
  } else if which == 5 {
    handle {
      let [x, ..] = empty_list(n);
      x
    } with {
      abort.raise(m) -> 1,
    }
  } else { handle { "a b".split("a b".slice(1, 1 + n - n)).len() } with { abort.raise(m) -> 1 } }

fn several() -> Int = 100000

test "a `handle` block catches the raise of each builtin made twenty calls deep, in many repeated rounds" {
  range(0, ways()).fold((), |u: Unit, which: Int|
    assert_eq(
      rounds(several(), |i: Int| handle { falls(which, i, 20) } with { abort.raise(m) -> 1 }),
      several(),
    ))
}

test "a `handle` block catches each builtin's raise made directly in its own body, repeated several times" {
  range(0, ways()).fold((), |u: Unit, which: Int|
    assert_eq(rounds(several(), |i: Int| returned_here(which, i)), several()))
}

test "each builtin's raise unwinds through a `with_scope` block, and the scope's value is released every time" {
  counted(|| {
    range(0, ways()).fold((), |u: Unit, which: Int|
      assert_eq(
        rounds(several(), |i: Int|
          handle {
            with_scope[slot](i, |scoped_value: Int| asks.one()) { h -> falls(which, h.get(), 20) }
          } with {
            abort.raise(m) -> 1,
          }),
        several(),
      ));
    assert_eq(asks.so_far(), ways() * several())
  })
}
