//! A perform through a clause that answers every label alike, handed the label it is performed at,
//! takes the steps one through a clause on no label takes: its slot enters the clause, reading no
//! table on the way, as a real handler's perform does.

effect cell {
  read get[r]() -> Int
}

effect plain {
  read get() -> Int
}

fn read_cell(left: Int, n: Int) -> Int / {cell.get[a]} =
  if left <= 0 { n } else { read_cell(left - 1, n + cell.get[a]()) }

fn read_plain(left: Int, n: Int) -> Int / {plain.get} =
  if left <= 0 { n } else { read_plain(left - 1, n + plain.get()) }

fn through_label(n: Int) -> Int = handle { read_cell(n, 0) } with { cell.get[*name]() -> name.len() }

fn through_none(n: Int) -> Int = handle { read_plain(n, 0) } with { plain.get() -> "a".len() }

test "a perform through a clause on every label is handed the label it was performed at" {
  assert_eq(through_label(3), 3)
}

test "a perform through a clause on every label takes the steps one through a clause on none takes" {
  assert_eq(metered(|| through_label(1000)).steps, metered(|| through_none(1000)).steps)
}
