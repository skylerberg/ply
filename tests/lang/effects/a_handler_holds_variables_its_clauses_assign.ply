//! A handler holds variables its clauses read and assign, and its `return` reads.

effect tally {
  write add(n: Int) -> Unit
  read total() -> Int
}

effect again {
  multi write add(n: Int) -> Unit
  read total() -> Int
}

effect amb {
  multi read flip[coin]() -> Bool
}

fn summed(xs: List<Int>) -> Int / {tally.add, tally.total} = {
  xs.fold((), |u: Unit, x: Int| tally.add(x));
  tally.total()
}

fn counted(xs: List<Int>) -> { sum: Int, positive: Int, negative: Int } =
  handle {
    summed(xs)
  } with {
    var sum = 0,
    var positive = 0,
    var negative: Int = 0,
    tally.add(n) -> {
      sum = sum + n;
      if n > 0 {
        positive = positive + 1;
      } else if n < 0 {
        negative = negative + 1;
      };
    },
    tally.total() -> sum,
    return s -> { sum: s, positive: positive, negative: negative },
  }

test "a clause assigns its handler's variables, in its branches too, and `return` reads them" {
  assert_eq(counted([3, 0 - 2, 5, 0]), { sum: 6, positive: 2, negative: 1 });
  assert_eq(counted([]), { sum: 0, positive: 0, negative: 0 })
}

fn kept(xs: List<Int>) -> List<Int> =
  handle {
    summed(xs);
    []
  } with {
    var seen: List<Int> = [],
    tally.add(n) -> match n {
      0 -> (),
      _ -> {
        seen = seen.push(n);
      },
    },
    tally.total() -> seen.len(),
    return u -> seen,
  }

test "a variable holds any value, and grows as its clauses give it new ones" {
  assert_eq(kept([1, 0, 2, 0, 3]), [1, 2, 3]);
  assert_eq(kept(range(0, 200)).len(), 199)
}

effect peek {
  read later() -> () -> Int
}

fn captured() -> Int =
  handle {
    tally.add(1);
    let f = peek.later();
    tally.add(10);
    f() * 100 + tally.total()
  } with {
    var n = 0,
    tally.add(k) -> {
      n = n + k;
    },
    tally.total() -> n,
    peek.later() -> || n,
  }

test "a lambda a clause makes reads the value a variable had where it was made" {
  assert_eq(captured(), 111)
}

fn backtracked() -> Int =
  handle {
    handle {
      tally.add(if amb.flip[coin]() { 1 } else { 10 });
      tally.add(if amb.flip[coin]() { 100 } else { 1000 });
      tally.total()
    } with {
      var n = 0,
      tally.add(k) -> {
        n = n + k;
      },
      tally.total() -> n,
    }
  } with {
    amb.flip[coin]() resume k -> k(true) + k(false),
  }

fn threaded() -> Int =
  handle {
    handle {
      tally.add(if amb.flip[coin]() { 1 } else { 10 });
      tally.add(if amb.flip[coin]() { 100 } else { 1000 });
      tally.total()
    } with {
      amb.flip[coin]() resume k -> k(true) + k(false),
    }
  } with {
    var n = 0,
    tally.add(k) -> {
      n = n + k;
    },
    tally.total() -> n,
  }

test "a handler inside a continuation resumed twice starts each resumption over, and one outside it is shared" {
  // Each path is one sum: 101 + 1001 + 110 + 1010.
  assert_eq(backtracked(), 2222);
  // Every path adds to one sum, which each `total` reads as it then stands.
  assert_eq(threaded(), 101 + 1101 + 1211 + 2211)
}

fn resumed() -> List<Int> =
  handle {
    again.add(1);
    [again.total()]
  } with {
    var n = 0,
    again.add(k) resume r -> {
      n = n + k;
      let first = r(());
      n = n + 100;
      List::concat(first, r(()))
    },
    again.total() -> n,
  }

test "a resumption continues with the values the clause holds where it resumes" {
  assert_eq(resumed(), [1, 101])
}

fn nested() -> Int =
  handle {
    tally.add(2);
    handle {
      tally.add(3);
      tally.total()
    } with {
      var n = 1000,
      tally.add(k) -> {
        n = n + k;
      },
      tally.total() -> n,
    }
  } with {
    var n = 0,
    tally.add(k) -> {
      n = n + k;
    },
    tally.total() -> n,
    return x -> x + n,
  }

test "each handler holds its own variables, whatever their names" { assert_eq(nested(), 1003 + 2) }

fn spawned() -> Int / {abort.raise, sim.read} =
  simulate {
    handle {
      let a = task.spawn(|| tally.add(1));
      let b = task.spawn(|| tally.add(2));
      task.join(a);
      task.join(b);
      tally.total()
    } with {
      var n = 0,
      tally.add(k) -> {
        n = n + k;
      },
      tally.total() -> n,
    }
  }

test "the tasks spawned under a handler share its variables" { assert_eq(spawned(), 3) }

effect gauge {
  write reading(x: Float) -> Unit
}

type Extent = { low: Float, high: Float, seen: Int }

fn spread(xs: List<Float>) -> { mean: Float, span: Extent } =
  handle {
    xs.fold((), |u: Unit, x: Float| gauge.reading(x))
  } with {
    var total = 0.0,
    var span: Extent = { low: 0.0, high: 0.0, seen: 0 },
    gauge.reading(x) -> {
      total = total + x;
      span = if span.seen == 0 { { low: x, high: x, seen: 1 } } else {
        {
          low: if x < span.low { x } else { span.low },
          high: if x > span.high { x } else { span.high },
          seen: span.seen + 1,
        }
      };
    },
    return u ->
      { mean: if span.seen == 0 { 0.0 } else { total / Float::of_int(span.seen) }, span: span },
  }

test "a variable holds a float or a record as well as an integer" {
  assert_eq(spread([2.0, 0.5, 3.5]), { mean: 2.0, span: { low: 0.5, high: 3.5, seen: 3 } });
  assert_eq(spread([]), { mean: 0.0, span: { low: 0.0, high: 0.0, seen: 0 } })
}

fn started(n: Int) -> Int =
  handle {
    tally.add(1);
    tally.total()
  } with {
    var n = n * 10,
    var m = n + 1,
    tally.add(k) -> {
      m = m + k;
    },
    tally.total() -> m + n,
  }

test "a variable's first value sees the variables above it" { assert_eq(started(2), 21 + 1 + 20) }

fn made(x: Int) -> Extent = { low: Float::of_int(x), high: Float::of_int(x), seen: x }

fn rescaled(xs: List<Int>) -> { seen: Int, said: String } =
  handle {
    summed(xs)
  } with {
    var scale: (Int) -> Extent = |x: Int| made(x),
    var said = "",
    tally.add(k) -> {
      scale = |x: Int| made(x * k);
      said = f"{said}+{k}";
    },
    tally.total() -> {
      let g = scale;
      g(5).seen
    },
    return n -> { seen: n, said: f"{said}={n}" },
  }

test "a variable holds a function, and an f-string reads a variable as any read does" {
  assert_eq(rescaled([2, 3]), { seen: 15, said: "+2+3=15" });
  assert_eq(rescaled([]), { seen: 5, said: "=5" })
}

test "a handler's variables leave nothing live behind it" {
  let m = metered(|| kept(range(0, 50)).len());
  assert_eq((m.value, m.live), (49, 0))
}
