type ParseError = { at: Int, reason: String }

effect parse {
  raise bad(e: ParseError)
  raise missing(key: String, line: Int)
  raise eof()
}

fn digit(b: Int) -> Int / {parse.bad} =
  if b >= 48 && b <= 57 { b - 48 } else { parse.bad({ at: b, reason: "not a digit" }) }

fn checked(b: Int) -> Result<Int, ParseError> = try { digit(b) }

fn named(b: Int) -> Result<Int, ParseError> = try[parse.bad] { digit(b) }

fn by_hand(b: Int) -> Result<Int, ParseError> =
  handle { digit(b) } with { parse.bad(e) -> Err(e), return v -> Ok(v) }

test "`try` returns the same `Result` as the equivalent hand-written `handle`" {
  assert_eq([53, 1].map(checked), [53, 1].map(by_hand));
  assert_eq([53, 1].map(named), [53, 1].map(by_hand));
  assert_eq(checked(1), Err({ at: 1, reason: "not a digit" }))
}

fn lookup(key: String) -> Int / {parse.missing} = if key == "a" { 1 } else { parse.missing(key, 7) }

fn end() -> Int / {parse.eof} = parse.eof()

test "a raise of several values is returned as their tuple, and a raise of none as unit" {
  assert_eq(try { lookup("a") }, Ok(1));
  assert_eq(try { lookup("b") }, Err(("b", 7)));
  let r: Result<Int, Unit> = try { end() };
  assert_eq(r, Err(()))
}

fn both(key: String, b: Int) -> Int / {parse.missing, parse.bad} = lookup(key) + digit(b)

test "a `try` that names one raise lets other raises pass through to an outer `try`" {
  let inner = try[parse.missing] { try[parse.bad] { both("a", 1) } };
  assert_eq(inner, Ok(Err({ at: 1, reason: "not a digit" })));
  let outer = try[parse.missing] { try[parse.bad] { both("z", 1) } };
  assert_eq(outer, Err(("z", 7)))
}

test "a plain `try` does not catch a failing operation such as division by zero, but `try[abort.raise]` does" {
  let zero = [1].filter(|x: Int| x > 1).len();
  let r = try[abort.raise] { try { digit(48) / zero } };
  assert(match r { Err(_) -> true, Ok(_) -> false });
  let s = try[abort.raise] { try { digit(1) / zero } };
  assert_eq(s, Ok(Err({ at: 1, reason: "not a digit" })))
}

test "`try` works as the value a `match` inspects and as the body of a lambda" {
  let n = match try { digit(1) } { Ok(v) -> v, Err(e) -> 0 - e.at };
  assert_eq(n, 0 - 1);
  assert_eq([49, 2].map(|b: Int| try { digit(b) }), [Ok(1), Err({ at: 2, reason: "not a digit" })])
}

fn raised(r: Result<Int, ParseError>) -> Int / {parse.bad} =
  match r { Ok(v) -> v, Err(e) -> parse.bad(e) }

test "a function can turn an `Err` back into a raise" {
  assert_eq(
    try { raised(checked(49)) + raised(checked(2)) },
    Err({ at: 2, reason: "not a digit" }),
  );
  assert_eq(try { raised(checked(49)) + raised(checked(50)) }, Ok(3))
}

fn each(bs: List<Int>) -> List<Int> / {parse.bad} = bs.map(digit)

fn through<a | e>(f: () -> a / e) -> a / e = f()

test "a raise passes through an effect variable to the try around the call" {
  assert_eq(try { each([48, 49]) }, Ok([0, 1]));
  assert_eq(try { through(|| each([48, 1, 2])) }, Err({ at: 1, reason: "not a digit" }))
}

test "a raise in a task is caught by a `try` inside the task or by a `try` around `simulate`" {
  let own = simulate {
    let t = task.spawn(|| try { digit(4) });
    task.join(t)
  };
  assert_eq(own, Err({ at: 4, reason: "not a digit" }));
  let around = try {
    simulate {
      let t = task.spawn(|| digit(3));
      task.join(t)
    }
  };
  assert_eq(around, Err({ at: 3, reason: "not a digit" }))
}

effect tally {
  write add(n: Int) -> Unit
}

test "a `try` around `bracket` still runs the release function, and the result is an `Err`" {
  let out = handle {
    try { bracket(|| 1, |h: Int| tally.add(h), |h: Int| digit(h)) }
  } with {
    var released = 5,
    tally.add(n) -> {
      released = released + n;
    },
    return r -> (r, released),
  };
  assert_eq(out, (Err({ at: 1, reason: "not a digit" }), 6))
}
