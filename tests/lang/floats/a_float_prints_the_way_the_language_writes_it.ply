test "`Float::to_string` returns the shortest text that reads back as the same `Float`" {
  assert_eq(Float::to_string(1.0), "1.0");
  assert_eq(Float::to_string(-0.5), "-0.5");
  assert_eq(Float::to_string(0.1), "0.1");
  assert_eq(Float::to_string(1.0 / 3.0), "0.3333333333333333");
  assert_eq(Float::to_string(2.5e10), "2.5e10")
}

test "a very large or very small value is exponential rather than a wall of digits" {
  assert_eq(Float::to_string(1.0e300), "1e300");
  assert_eq(Float::to_string(1.0e-10), "1e-10")
}

test "`Float::to_string` prints the infinities as `Infinity` and `-Infinity` and NaN as `NaN`" {
  assert_eq(Float::to_string(1.0e400), "Infinity");
  assert_eq(Float::to_string(-1.0e400), "-Infinity");
  assert_eq(Float::to_string(0.0 / 0.0), "NaN")
}

test "`Float::of_string` returns the original `Float` from the text `Float::to_string` produced" {
  assert_eq(Float::of_string(Float::to_string(0.1)), Some(0.1));
  assert_eq(Float::of_string(Float::to_string(1.0e300)), Some(1.0e300))
}

fn main() -> Int = 0
