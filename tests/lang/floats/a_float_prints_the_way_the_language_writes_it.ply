// The float spelling the language uses everywhere it names one: shortest round-trip, and
// `Infinity`/`NaN` rather than Rust's `inf`/`NaN`. `float_of_string` reads it back.

test "the shortest spelling that round-trips" {
  assert_eq(float_to_string(1.0), "1.0");
  assert_eq(float_to_string(-0.5), "-0.5");
  assert_eq(float_to_string(0.1), "0.1");
  assert_eq(float_to_string(1.0 / 3.0), "0.3333333333333333");
  assert_eq(float_to_string(2.5e10), "2.5e10")
}

test "a very large or very small value is exponential rather than a wall of digits" {
  assert_eq(float_to_string(1.0e300), "1e300");
  assert_eq(float_to_string(1.0e-10), "1e-10")
}

test "the two values that are not numbers read as postgres and SQL want them" {
  assert_eq(float_to_string(1.0e400), "Infinity");
  assert_eq(float_to_string(-1.0e400), "-Infinity");
  assert_eq(float_to_string(0.0 / 0.0), "NaN")
}

test "what is written reads back" {
  assert_eq(float_of_string(float_to_string(0.1)), Some(0.1));
  assert_eq(float_of_string(float_to_string(1.0e300)), Some(1.0e300))
}

fn main() -> Int = 0
