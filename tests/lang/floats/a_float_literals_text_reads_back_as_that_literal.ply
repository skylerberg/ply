// `float_of_string` is the lexer's own parse, over text: what a program holding a literal's
// digits needs to reach the value that literal denotes. The two extremes are the point —
// `1.0e-30` and `1.0e300` are ordinary `Float`s with no `Decimal` between them and their text.

fn read(text: String) -> Float =
  match float_of_string(text) {
    Some(f) -> f,
    None -> panic("a float this file spelled wrong"),
  }

test "the text of a literal reads back as that literal" {
  assert_eq(bits_of_float(read("1.5")), bits_of_float(1.5));
  assert_eq(bits_of_float(read("0.1")), bits_of_float(0.1));
  assert_eq(bits_of_float(read("1e9")), bits_of_float(1e9));
  assert_eq(bits_of_float(read("2.5e-1")), bits_of_float(2.5e-1));
  assert_eq(bits_of_float(read("1_000.5")), bits_of_float(1_000.5))
}

test "the two literals no Decimal holds read back too" {
  assert_eq(bits_of_float(read("1.0e-30")), bits_of_float(1.0e-30));
  assert_eq(bits_of_float(read("1.0e300")), bits_of_float(1.0e300));
  assert_eq(decimal_of_float(1.0e-30), None);
  assert_eq(decimal_of_float(1.0e300), None)
}

test "the pattern the hasher writes round-trips through float_of_bits" {
  assert_eq(float_of_bits(bits_of_float(read("1.0e-30"))), 1.0e-30);
  assert_eq(float_of_bits(bits_of_float(read("1.0e300"))), 1.0e300)
}

test "a text no literal spells is absent rather than guessed" {
  assert_eq(float_of_string(""), None);
  assert_eq(float_of_string("abc"), None);
  assert_eq(float_of_string("inf"), None);
  assert_eq(float_of_string("NaN"), None);
  assert_eq(float_of_string("1.2.3"), None);
  assert_eq(float_of_string("1."), None)
}
