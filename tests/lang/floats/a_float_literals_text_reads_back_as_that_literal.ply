fn read(text: String) -> Float / {abort.raise} =
  match Float::of_string(text) { Some(f) -> f, None -> panic("a float this file spelled wrong") }

test "the text of a literal reads back as that literal" {
  assert_eq(bits_of_float(read("1.5")), bits_of_float(1.5));
  assert_eq(bits_of_float(read("0.1")), bits_of_float(0.1));
  assert_eq(bits_of_float(read("1e9")), bits_of_float(1e9));
  assert_eq(bits_of_float(read("2.5e-1")), bits_of_float(2.5e-1));
  assert_eq(bits_of_float(read("1_000.5")), bits_of_float(1_000.5))
}

test "the literals `1.0e-30` and `1.0e300`, which `Decimal` cannot represent, also read back as the same `Float`" {
  assert_eq(bits_of_float(read("1.0e-30")), bits_of_float(1.0e-30));
  assert_eq(bits_of_float(read("1.0e300")), bits_of_float(1.0e300));
  assert_eq(Decimal::of_float(1.0e-30), None);
  assert_eq(Decimal::of_float(1.0e300), None)
}

test "`Float::of_bits` returns the original `Float` when given the bits of the literals `1.0e-30` and `1.0e300`" {
  assert_eq(Float::of_bits(bits_of_float(read("1.0e-30"))), 1.0e-30);
  assert_eq(Float::of_bits(bits_of_float(read("1.0e300"))), 1.0e300)
}

test "`Float::of_string` returns `None` for text that is not a float literal, such as `inf`, `NaN` and `1.`" {
  assert_eq(Float::of_string(""), None);
  assert_eq(Float::of_string("abc"), None);
  assert_eq(Float::of_string("inf"), None);
  assert_eq(Float::of_string("NaN"), None);
  assert_eq(Float::of_string("1.2.3"), None);
  assert_eq(Float::of_string("1."), None)
}
