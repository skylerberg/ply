test "a conversion returns what IEEE-754 says" {
  assert_eq(Float::of_int(9007199254740993), 9007199254740992.0);
  assert_eq(Float::of_int(-3), -3.0);
  assert_eq(Float::of_bits(bits_of_float(1.5)), 1.5);
  assert_eq(bits_of_float(Float::of_bits(-1)), 9221120237041090560);
  assert_eq(bits_of_float(Float::of_bits(9221120237041090561)), 9221120237041090560)
}
