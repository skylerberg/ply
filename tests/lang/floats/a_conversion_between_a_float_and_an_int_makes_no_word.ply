//! A conversion between a `Float` and an `Int`'s value or bits is done where it stands, making no
//! word: it answers as IEEE-754 does, an `Int` past 2^53 rounded to the nearest even, and every
//! NaN's bits the one NaN's.

fn summed(n: Int, i: Int, acc: Float) -> Float =
  if i >= n { acc } else { summed(n, i + 1, acc + Float::of_int(i)) }

test "a conversion answers as IEEE-754 says" {
  assert_eq(Float::of_int(9007199254740993), 9007199254740992.0);
  assert_eq(Float::of_int(-3), -3.0);
  assert_eq(Float::of_bits(bits_of_float(1.5)), 1.5);
  assert_eq(bits_of_float(Float::of_bits(-1)), 9221120237041090560);
  assert_eq(bits_of_float(Float::of_bits(9221120237041090561)), 9221120237041090560)
}

test "summing converted ints allocates alike for ten and a thousand" {
  assert_eq(
    metered(|| summed(1000, 0, 0.0)).allocations,
    metered(|| summed(10, 0, 0.0)).allocations,
  )
}
