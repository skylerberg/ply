fn half(c: Bool, o: Option<Float>) -> Float / {abort.raise} =
  if c { match o { Some(x) -> x / 2.0, None -> 0.0 } } else { panic("no") }

fn quarter(c: Bool, x: Float) -> Float / {abort.raise} = if c { x / 4.0 } else { panic("no") }

fn item(xs: List<Float>, i: Int) -> Float / {abort.raise} =
  if i < 0 { panic("negative") } else { match xs.at(i) { Some(x) -> x, None -> 0.0 } }

test "functions that take a `Float` from an `Option`, a conditional or a list index return the right value, including the default when none exists" {
  assert_eq([half(true, Some(3.0)), half(true, None), quarter(true, 2.0)], [1.5, 0.0, 0.5]);
  let xs = range(0, 100).map(|i: Int| Float::of_int(i));
  assert_eq([item(xs, 3), item(xs, 99), item(xs, 100)], [3.0, 99.0, 0.0])
}

test "functions that take a `Float` from an `Option`, a conditional or a list index release every reference count they acquire" {
  assert(half(true, Some(3.0)) > 1.0);
  assert(quarter(true, 8.0) > 1.0);
  let xs = range(0, 100).map(|i: Int| Float::of_int(i));
  assert(item(xs, 40) > 1.0)
}
