import std.bytes
import std.float
import std.list
import std.string

fn digest(xs: List<Float>) -> String / {abort.raise} =
  Bytes::of_string(String::join(xs.map(|x: Float| bits_of_float(x).to_string()), ",")).blake3(
  ).hex_of(
  )

fn inf() -> Float = Float::of_bits(0x7FF0_0000_0000_0000)

fn specials() -> List<Float> =
  [
    0.0,
    -0.0,
    Float::of_bits(1),
    Float::of_bits(0x800F_FFFF_FFFF_FFFF),
    Float::pow2(0 - 1022),
    1.0,
    -1.0,
    0.1,
    1.0 / 3.0,
    -2.5e-300,
    7.5,
    1e308,
    Float::of_bits(0x7FEF_FFFF_FFFF_FFFF),
    inf(),
    0.0 - inf(),
    Float::of_bits(0x7FF8_0000_0000_0000),
    Float::of_bits(0xFFF8_0000_0000_0001),
  ]

fn arithmetic() -> List<Float> =
  specials().flat_map(|a: Float|
    [0.0 - a].concat(specials().flat_map(|b: Float| [a + b, a - b, a * b, a / b, a % b])))

fn products_and_sums() -> List<Float> =
  range(1, 53).flat_map(|i: Int| {
    let t = Float::pow2(0 - i);
    let a = 1.0 + t;
    let b = 1.0 - t;
    let x = Float::of_int(i) * 0.37;
    [
      a * b - 1.0,
      a * a - 2.0 * a,
      b * b + a * b,
      ((0.5 * x + 0.25) * x - 1.5) * x + 0.125,
      x * x - (x + t) * (x - t),
      dot(range(0, i).map(|k: Int| Float::of_int(k) * t + 0.1)),
    ]
  })

fn dot(xs: List<Float>) -> Float =
  xs.fold(0.0, |accumulator: Float, x: Float| accumulator + x * (x + 0.3))

fn sums() -> List<Float> = {
  let xs = range(0, 300).map(|i: Int|
    Float::of_int(i % 7 - 3) * Float::pow2(i % 60 - 30) + 1.0 / Float::of_int(i + 1));
  [
    left_sum(xs),
    left_sum(xs.reverse()),
    compensated(xs),
    compensated(xs.reverse()),
    1e16 + 1.0 - 1e16,
    1e16 + (1.0 - 1e16),
    left_sum([1e16, 1.0, -1e16, 1.0, 1e-16, 3.0]),
  ]
}

fn left_sum(xs: List<Float>) -> Float = xs.fold(0.0, |accumulator: Float, x: Float| accumulator + x)

fn compensated(xs: List<Float>) -> Float =
  xs.fold({ sum: 0.0, widths: 0.0 }, |s: { sum: Float, widths: Float }, x: Float| {
    let y = x - s.widths;
    let t = s.sum + y;
    { sum: t, widths: t - s.sum - y }
  }).sum

fn subnormals() -> List<Float> =
  range(0, 60).flat_map(|i: Int| {
    let tiny = Float::pow2(i - 1074);
    [
      tiny * 0.5,
      tiny * 0.75,
      tiny / 3.0,
      tiny + tiny,
      Float::pow2(0 - 1022) - tiny,
      tiny * Float::pow2(1000),
      tiny.sqrt(),
      Float::pow2(0 - 1000) * Float::pow2(0 - 60 - i),
      Float::pow2(0 - 1022) / Float::of_int(i + 2),
    ]
  })

fn grid() -> List<Float> = range(0 - 40, 41).map(|i: Int| Float::of_int(i) * 0.37)

fn functions() -> List<Float> =
  grid().flat_map(|x: Float|
    [
      x.sqrt(),
      x.exp(),
      x.ln(),
      x.log2(),
      x.log10(),
      x.sin(),
      x.cos(),
      x.tan(),
      Float::asin(x / 15.0),
      Float::acos(x / 15.0),
      x.atan(),
      x.pow(1.7),
      Float::pow(1.0 + x / 100.0, x * 7.0),
      x.atan2(0.3),
      x.hypot(1e200),
    ]).concat([
    Float::sin(1e22),
    Float::pow2(1000).cos(),
    Float::tan(1e300),
    Float::exp(709.78),
    Float::exp(-745.13),
    Float::pow(-2.0, 3.0),
    Float::pow(0.0, -1.0),
    Float::pow(-0.0, -3.0),
    Float::atan2(-0.0, -1.0),
    inf().hypot(Float::of_bits(0x7FF8_0000_0000_0000)),
  ])

fn read(text: String) -> Float = match Float::of_string(text) { Some(x) -> x, None -> 0.0 }

fn conversions() -> List<Float> =
  range(0, 64).map(|i: Int| Float::of_int((1 << i) + 1)).concat([
    Float::of_decimal(0.1m),
    Float::of_decimal(1234567890.123456789m),
    Float::of_decimal(0.0000000000000000000000000001m),
    read("2.2250738585072011e-308"),
    read("4.9e-324"),
    read("1.7976931348623157e308"),
    read("0.30000000000000004"),
    Float::round(2.5, HalfEven),
    Float::round(0.0 - 2.5, HalfUp),
    Float::floor(-0.0),
    Float::ceil(-0.5),
  ])

fn texts() -> String / {abort.raise} =
  Bytes::of_string(String::join(specials().concat(grid()).map(Float::to_string), " ")).blake3(
  ).hex_of(
  )

fn nans() -> List<Float> = {
  let zero = 0.0;
  [
    zero / zero,
    inf() - inf(),
    inf() * zero,
    Float::sqrt(-1.0),
    0.0 - zero / zero,
    Float::of_bits(0x7FF0_0000_0000_0001),
    Float::of_bits(0xFFFF_FFFF_FFFF_FFFF),
    Float::ln(-1.0),
    Float::asin(2.0),
    Float::pow(-2.0, 0.5),
    inf() % 1.0,
  ]
}

fn digests() -> List<String> / {abort.raise} =
  [
    digest(arithmetic()),
    digest(products_and_sums()),
    digest(sums()),
    digest(subnormals()),
    digest(functions()),
    digest(conversions()),
    texts(),
  ]

const fn stored() -> List<String> = digests()

test "every arithmetic operator over edge-case values, such as zeros, infinities and NaN, matches the reference digest" {
  assert_eq(
    digest(arithmetic()),
    "71b1c3a499ce01889cc54e77e2d4a406b80a5b7ecb450b92174564ccf22d298f",
  )
}

test "a multiplication followed by an addition rounds after each operation instead of combining them into one fused multiply-add, and matches the reference digest" {
  assert_eq(
    digest(products_and_sums()),
    "10de197631b6824e82da1c07eb3cc57be0aeb9311e52f9a966e06c5ee7c4ce6c",
  )
}

test "sums in the order they are written" {
  assert_eq(digest(sums()), "7da2380795a47901ec7726f6fa5e891703b631910dee2ba832d2f4ab5e9d0ea8")
}

test "subnormal results stay subnormal instead of becoming zero, and match the reference digest" {
  assert_eq(
    digest(subnormals()),
    "13795c61350005a6d88e59f8fcdd1b55049cc8cd8bac91f2e1d2e9e39b658e82",
  )
}

test "the float functions, correctly rounded" {
  assert_eq(digest(functions()), "bcdd35509e2a512ee2dc5d17ba088658f9b86237c6aecfaa0e9bb80810acafe0")
}

test "conversions to and from a Float" {
  assert_eq(
    digest(conversions()),
    "b05b37363a8a8de8c5278f7f06429102ae987f21117e2700375b9b4eddf57fd2",
  )
}

test "the text a Float prints as" {
  assert_eq(texts(), "59244d479fa14ec432efd92cfad2904feda069bc5cf9fb55c24e4f485f6ea795")
}

test "every NaN a program makes has the same bit pattern, `0x7FF8000000000000`" {
  assert(nans().all(|x: Float| bits_of_float(x) == 0x7FF8_0000_0000_0000))
}

test "the digests computed at build time equal the digests computed when the program runs" {
  assert_eq(stored(), digests())
}
