//! Float programs, each held to one digest of the bits of every `Float` it computes: every machine,
//! target and profile answers these, and a `const fn` the build evaluated answers what the run does.

import std.bytes (hex_of)
import std.float (pow2)
import std.list (all, concat, flat_map, reverse)
import std.string (join)

fn digest(xs: List<Float>) -> String / {abort.raise} =
  hex_of(
    bytes_blake3(bytes_of_string(join(map(xs, |x: Float| int_to_string(bits_of_float(x))), ","))),
  )

fn inf() -> Float = float_of_bits(0x7FF0_0000_0000_0000)

/// The values an implementation treats apart: zeros, subnormals, the ends of the normal range, inexact
/// fractions, the infinities and NaNs.
fn specials() -> List<Float> =
  [
    0.0,
    -0.0,
    float_of_bits(1),
    float_of_bits(0x800F_FFFF_FFFF_FFFF),
    pow2(0 - 1022),
    1.0,
    -1.0,
    0.1,
    1.0 / 3.0,
    -2.5e-300,
    7.5,
    1e308,
    float_of_bits(0x7FEF_FFFF_FFFF_FFFF),
    inf(),
    0.0 - inf(),
    float_of_bits(0x7FF8_0000_0000_0000),
    float_of_bits(0xFFF8_0000_0000_0001),
  ]

fn arithmetic() -> List<Float> =
  flat_map(specials(), |a: Float|
    concat([0.0 - a], flat_map(specials(), |b: Float| [a + b, a - b, a * b, a / b, a % b])))

/// Products added to sums, where a fused multiply-add answers otherwise than the product rounded
/// first: `(1 + t) * (1 - t) - 1` is zero rounded and `-t * t` fused.
fn products_and_sums() -> List<Float> =
  flat_map(range(1, 53), |i: Int| {
    let t = pow2(0 - i);
    let a = 1.0 + t;
    let b = 1.0 - t;
    let x = float_of_int(i) * 0.37;
    [
      a * b - 1.0,
      a * a - 2.0 * a,
      b * b + a * b,
      ((0.5 * x + 0.25) * x - 1.5) * x + 0.125,
      x * x - (x + t) * (x - t),
      dot(map(range(0, i), |k: Int| float_of_int(k) * t + 0.1)),
    ]
  })

fn dot(xs: List<Float>) -> Float = fold(xs, 0.0, |acc: Float, x: Float| acc + x * (x + 0.3))

/// Sums whose order decides their answer, and a compensated sum whose correction reordering cancels.
fn sums() -> List<Float> = {
  let xs = map(range(0, 300), |i: Int|
    float_of_int(i % 7 - 3) * pow2(i % 60 - 30) + 1.0 / float_of_int(i + 1));
  [
    left_sum(xs),
    left_sum(reverse(xs)),
    compensated(xs),
    compensated(reverse(xs)),
    1e16 + 1.0 - 1e16,
    1e16 + (1.0 - 1e16),
    left_sum([1e16, 1.0, -1e16, 1.0, 1e-16, 3.0]),
  ]
}

fn left_sum(xs: List<Float>) -> Float = fold(xs, 0.0, |acc: Float, x: Float| acc + x)

fn compensated(xs: List<Float>) -> Float =
  fold(xs, { sum: 0.0, carry: 0.0 }, |s: { sum: Float, carry: Float }, x: Float| {
    let y = x - s.carry;
    let t = s.sum + y;
    { sum: t, carry: t - s.sum - y }
  }).sum

/// Results below the normal range, which a machine that flushes them to zero answers otherwise.
fn subnormals() -> List<Float> =
  flat_map(range(0, 60), |i: Int| {
    let tiny = pow2(i - 1074);
    [
      tiny * 0.5,
      tiny * 0.75,
      tiny / 3.0,
      tiny + tiny,
      pow2(0 - 1022) - tiny,
      tiny * pow2(1000),
      sqrt(tiny),
      pow2(0 - 1000) * pow2(0 - 60 - i),
      pow2(0 - 1022) / float_of_int(i + 2),
    ]
  })

fn grid() -> List<Float> = map(range(0 - 40, 41), |i: Int| float_of_int(i) * 0.37)

fn functions() -> List<Float> =
  concat(
    flat_map(grid(), |x: Float|
      [
        sqrt(x),
        exp(x),
        ln(x),
        log2(x),
        log10(x),
        sin(x),
        cos(x),
        tan(x),
        asin(x / 15.0),
        acos(x / 15.0),
        atan(x),
        pow(x, 1.7),
        pow(1.0 + x / 100.0, x * 7.0),
        atan2(x, 0.3),
        hypot(x, 1e200),
      ]),
    [
      sin(1e22),
      cos(pow2(1000)),
      tan(1e300),
      exp(709.78),
      exp(-745.13),
      pow(-2.0, 3.0),
      pow(0.0, -1.0),
      pow(-0.0, -3.0),
      atan2(-0.0, -1.0),
      hypot(inf(), float_of_bits(0x7FF8_0000_0000_0000)),
    ],
  )

fn read(text: String) -> Float = match float_of_string(text) { Some(x) -> x, None -> 0.0 }

fn conversions() -> List<Float> =
  concat(map(range(0, 64), |i: Int| float_of_int((1 << i) + 1)), [
    float_of_decimal(0.1m),
    float_of_decimal(1234567890.123456789m),
    float_of_decimal(0.0000000000000000000000000001m),
    read("2.2250738585072011e-308"),
    read("4.9e-324"),
    read("1.7976931348623157e308"),
    read("0.30000000000000004"),
    round(2.5, HalfEven),
    round(0.0 - 2.5, HalfUp),
    floor(-0.0),
    ceil(-0.5),
  ])

fn texts() -> String / {abort.raise} =
  hex_of(bytes_blake3(bytes_of_string(join(map(concat(specials(), grid()), float_to_string), " "))))

fn nans() -> List<Float> = {
  let zero = 0.0;
  [
    zero / zero,
    inf() - inf(),
    inf() * zero,
    sqrt(-1.0),
    0.0 - zero / zero,
    float_of_bits(0x7FF0_0000_0000_0001),
    float_of_bits(0xFFFF_FFFF_FFFF_FFFF),
    ln(-1.0),
    asin(2.0),
    pow(-2.0, 0.5),
    inf() % 1.0,
  ]
}

fn digests() -> List<String> / {abort.raise} =
  [
    digest(arithmetic()),
    digest(products_and_sums()),
    digest(sums()),
    digest(subnormals()),
    digest(functions()),
    digest(conversions()),
    texts(),
  ]

const fn kept() -> List<String> = digests()

test "every operator over the values an implementation treats apart" {
  assert_eq(
    digest(arithmetic()),
    "71b1c3a499ce01889cc54e77e2d4a406b80a5b7ecb450b92174564ccf22d298f",
  )
}

test "products added to sums, each operation rounded once" {
  assert_eq(
    digest(products_and_sums()),
    "10de197631b6824e82da1c07eb3cc57be0aeb9311e52f9a966e06c5ee7c4ce6c",
  )
}

test "sums in the order they are written" {
  assert_eq(digest(sums()), "7da2380795a47901ec7726f6fa5e891703b631910dee2ba832d2f4ab5e9d0ea8")
}

test "subnormal results kept, never flushed to zero" {
  assert_eq(
    digest(subnormals()),
    "13795c61350005a6d88e59f8fcdd1b55049cc8cd8bac91f2e1d2e9e39b658e82",
  )
}

test "the float functions, correctly rounded" {
  assert_eq(digest(functions()), "bcdd35509e2a512ee2dc5d17ba088658f9b86237c6aecfaa0e9bb80810acafe0")
}

test "conversions to and from a Float" {
  assert_eq(
    digest(conversions()),
    "b05b37363a8a8de8c5278f7f06429102ae987f21117e2700375b9b4eddf57fd2",
  )
}

test "the text a Float prints as" {
  assert_eq(texts(), "59244d479fa14ec432efd92cfad2904feda069bc5cf9fb55c24e4f485f6ea795")
}

test "every NaN a program makes reads as the one NaN" {
  assert(all(nans(), |x: Float| bits_of_float(x) == 0x7FF8_0000_0000_0000))
}

test "a build's evaluation answers what a run's does" { assert_eq(kept(), digests()) }
