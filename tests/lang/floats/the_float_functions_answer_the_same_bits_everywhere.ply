//! The float functions are computed by Ply rather than asked of the platform, so each answers the
//! same bits on every machine; the bits below are what they answer, the last place included.

fn bits(f: Float) -> Int = bits_of_float(f)

fn nan() -> Float = float_of_bits(0x7FF8_0000_0000_0000)

fn inf() -> Float = float_of_bits(0x7FF0_0000_0000_0000)

test "an Int becomes the nearest Float, exactly up to 2^53" {
  assert_eq(float_of_int(0), 0.0);
  assert_eq(float_of_int(0 - 3), 0.0 - 3.0);
  assert_eq(float_of_int(9_007_199_254_740_993), 9_007_199_254_740_992.0);
  assert_eq(float_of_int(min_int_value()), 0.0 - 9_223_372_036_854_775_808.0)
}

fn min_int_value() -> Int = 0 - 9_223_372_036_854_775_807 - 1

test "a Float becomes an Int by the rounding asked for, and only when one holds it" {
  assert_eq(
    map([HalfEven, HalfUp, Down, Up, Ceiling, Floor], |m: Rounding| int_of_float(2.5, m)),
    [Some(2), Some(3), Some(2), Some(3), Some(3), Some(2)],
  );
  assert_eq(
    map([HalfEven, HalfUp, Down, Up, Ceiling, Floor], |m: Rounding| int_of_float(0.0 - 2.5, m)),
    [Some(0 - 2), Some(0 - 3), Some(0 - 2), Some(0 - 3), Some(0 - 2), Some(0 - 3)],
  );
  assert_eq(int_of_float(nan(), Floor), None);
  assert_eq(int_of_float(inf(), Floor), None);
  assert_eq(int_of_float(9_223_372_036_854_775_808.0, Floor), None);
  assert_eq(int_of_float(0.0 - 9_223_372_036_854_775_808.0, Floor), Some(min_int_value()))
}

test "floor, ceil and round keep a zero's sign and leave a NaN or an infinity alone" {
  assert_eq(floor(-0.5), -1.0);
  assert_eq(bits(ceil(-0.5)), bits(-0.0));
  assert_eq(round(0.5, HalfEven), 0.0);
  assert_eq(round(1.5, HalfEven), 2.0);
  assert_eq(round(0.0 - 0.5, HalfUp), 0.0 - 1.0);
  assert_eq(round(0.25, Up), 1.0);
  assert_eq(bits(round(nan(), Floor)), bits(nan()));
  assert_eq(round(inf(), Down), inf())
}

test "the exact functions answer exactly" {
  assert_eq(sqrt(4.0), 2.0);
  assert_eq(bits(sqrt(-0.0)), bits(-0.0));
  assert_eq(pow(2.0, 10.0), 1024.0);
  assert_eq(pow(0.0, 0.0), 1.0);
  assert_eq(exp(0.0), 1.0);
  assert_eq(ln(1.0), 0.0);
  assert_eq(ln(0.0), 0.0 - inf());
  assert_eq(log2(8.0), 3.0);
  assert_eq(log10(1000.0), 3.0);
  assert_eq(hypot(3.0, 4.0), 5.0);
  assert_eq(sin(0.0), 0.0);
  assert_eq(cos(0.0), 1.0)
}

test "every NaN a function answers is the one NaN" {
  assert_eq(bits(sqrt(0.0 - 1.0)), bits(nan()));
  assert_eq(bits(ln(0.0 - 1.0)), bits(nan()));
  assert_eq(bits(asin(2.0)), bits(nan()));
  assert_eq(bits(sin(inf())), bits(nan()));
  assert_eq(bits(pow(nan(), 2.0)), bits(nan()));
  // A negative NaN with a payload, as some machines' arithmetic produces, answers the one NaN too.
  assert_eq(bits(sqrt(float_of_bits(0xFFF8_0000_0000_0001))), bits(nan()));
  assert_eq(bits(floor(float_of_bits(0xFFF8_0000_0000_0001))), bits(nan()))
}

test "the rest answer these bits, the last place included" {
  assert_eq(bits(sin(1.0)), 0x3FEA_ED54_8F09_0CEE);
  assert_eq(bits(cos(1.0)), 0x3FE1_4A28_0FB5_068C);
  assert_eq(bits(tan(1.0)), 0x3FF8_EB24_5CBE_E3A6);
  assert_eq(bits(exp(1.0)), 0x4005_BF0A_8B14_576A);
  assert_eq(bits(ln(2.0)), 0x3FE6_2E42_FEFA_39EF);
  assert_eq(bits(pow(2.0, 0.5)), 0x3FF6_A09E_667F_3BCD);
  assert_eq(bits(atan2(1.0, 2.0)), 0x3FDD_AC67_0561_BB4F);
  assert_eq(bits(asin(0.5)), 0x3FE0_C152_382D_7366);
  assert_eq(bits(log10(2.0)), 0x3FD3_4413_509F_79FF);
  assert_eq(bits(log2(10.0)), 0x400A_934F_0979_A371)
}
