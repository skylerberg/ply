type EffectDefinition = { effect: Bytes, nondet: Bool, type: Int }

fn declare(e: Bytes) -> EffectDefinition = { effect: e, nondet: false, type: 1 }

fn mark(d: EffectDefinition) -> EffectDefinition = { ..d, nondet: true }

fn describe(d: EffectDefinition) -> Int =
  match d {
    { nondet: true, type: t, .. } -> t + 100,
    { effect: e, .. } -> if e == b"io" { 2 } else { 0 },
  }

test "a record can have fields named after keywords, such as `effect` and `type`, and they read and update normally" {
  let d = declare(b"io");
  assert_eq(d.effect, b"io");
  assert_eq(d.type, 1);
  assert_eq(describe(d), 2);
  assert_eq(describe(mark(d)), 101);
  assert_eq(mark(d), { effect: b"io", nondet: true, type: 1 })
}
