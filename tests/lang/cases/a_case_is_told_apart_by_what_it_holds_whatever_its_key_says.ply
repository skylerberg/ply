import std.cases

type Length = | Metres(Int) | Millimetres(Int)

key for Length by millimetres

fn millimetres(l: Length) -> Int = match l { Metres(n) -> n * 1000, Millimetres(n) -> n }

type Cut = { name: String, length: Length }

fn identities<a>(table: List<a>) -> List<Bytes> / {abort.raise}
  where derivable(hash, a)
= cases::listed(table, |_: a| "").map(|c: cases::Case| c.identity)

test "a key leaves two values two cases" {
  assert(Metres(2) == Millimetres(2000));
  match identities([Metres(2), Millimetres(2000)]) {
    [metres, millimetres] -> assert(metres != millimetres),
    _ -> assert(false),
  }
}

test "a key leaves two records two cases" {
  let cuts: List<Cut> = [
    { name: "a", length: Metres(1) },
    { name: "a", length: Millimetres(1000) },
  ];
  match identities(cuts) {
    [metres, millimetres] -> assert(metres != millimetres),
    _ -> assert(false),
  }
}
