type Shape = | Circle(Int) | Rect(Int, Int)

type Sized = { shape: Shape, area: Int }

fn area(s: Shape) -> Int = match s { Circle(r) -> 3 * r * r, Rect(w, h) -> w * h }

fn sized() -> List<Sized> =
  [
    { shape: Circle(1), area: 3 },
    { shape: Circle(2), area: 12 },
    { shape: Rect(2, 3), area: 6 },
    { shape: Rect(0, 9), area: 0 },
  ]

test "the area of {c.shape} is {c.area}" for c: Sized in sized() {
  assert_eq(area(c.shape), c.area)
}

test "{n} squared is at least {n}" for n: Int in [0, 1, 2, 12] { assert(n * n >= n) }

fn pairs() -> List<{ left: String, right: String }> =
  [{ left: "a", right: "b" }, { left: "b", right: "a" }]

test "the halves {p.left} and {p.right} differ" for p: { left: String, right: String } in pairs() {
  assert(p.left != p.right)
}

test "{{{xs.len()}}} counts {xs}" for xs: List<Int> in [[], [1], [1, 2]] {
  assert_eq(xs.len(), xs.fold(0, |n: Int, _: Int| n + 1))
}

fn halves() -> List<Int> / {abort.raise} = [2, 4, 8].map(|n: Int| n / 2)

test "{n} is a half" for n: Int in halves() { assert(n * 2 % 2 == 0) }

fn none() -> List<Int> = []

test "a test over an empty case list never runs its body, so nothing runs for {n}" for n: Int in none(
  ) { assert(false) }

nondet effect clock {
  read now() -> Int
}

test/nondet "a handled `clock.now` returns a value greater than the case value {floor}" for floor: Int in [
    0,
    1,
  ] { handle { assert(clock.now() > floor) } with { clock.now() -> floor + 1 } }

test "for the case value {n}, `task.join` returns {n + 1} from a spawned task that computes it" for n: Int in [
    1,
    2,
  ] {
  simulate {
    let t = task.spawn(|| n + 1);
    assert_eq(task.join(t), n + 1)
  }
}

type Date = new { year: Int, month: Int, day: Int }

fn epoch() -> Date = { year: 1970, month: 1, day: 1 }

test "the date with year {d.year} differs from year 0 and has the same `digest` as a date rebuilt from its fields" for d: Date in [
    { year: 2026, month: 1, day: 1 },
    epoch(),
  ] {
  assert(d != { year: 0, month: 1, day: 1 });
  assert_eq(digest(d), digest({ year: d.year, month: 1, day: 1 }))
}

effect vectors {
  raise missing(name: String)
}

fn found(n: Int) -> Int / {vectors.missing} = if n > 0 { n } else { vectors.missing("none") }

test "the case value {found(n)} computed by `found` is greater than zero" for n: Int in [
    found(1),
    found(2),
  ] { assert(n > 0) }

test "{r} is tried" for r: Result<Int, String> in [try { found(1) }, try { found(0) }] {
  assert(r == Ok(1) || r == Err("none"))
}

test "a case variable named `at` can be used in the test body, here with the value {at}" for at: Int in [
    5,
  ] {
  let identity = at + 1;
  assert_eq(identity, 6)
}
