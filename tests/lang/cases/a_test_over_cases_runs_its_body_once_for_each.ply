//! `test "label {c.x}" for c: T in table { .. }` is a test for each element of the table: the body
//! runs with the case bound, and the label's holes read it as an interpolated string's do.

type Shape = | Circle(Int) | Rect(Int, Int)

type Sized = { shape: Shape, area: Int }

fn area(s: Shape) -> Int = match s { Circle(r) -> 3 * r * r, Rect(w, h) -> w * h }

fn sized() -> List<Sized> =
  [
    { shape: Circle(1), area: 3 },
    { shape: Circle(2), area: 12 },
    { shape: Rect(2, 3), area: 6 },
    { shape: Rect(0, 9), area: 0 },
  ]

test "the area of {c.shape} is {c.area}" for c: Sized in sized() {
  assert_eq(area(c.shape), c.area)
}

// The table is any expression that lists the cases: here a literal, and the case a number.
test "{n} squared is at least {n}" for n: Int in [0, 1, 2, 12] { assert(n * n >= n) }

fn pairs() -> List<{ left: String, right: String }> =
  [{ left: "a", right: "b" }, { left: "b", right: "a" }]

// A label with no hole names every case alike, and each is still a test.
test "a pair's halves differ" for p: { left: String, right: String } in pairs() {
  assert(p.left != p.right)
}

// A doubled brace is a brace of the label, and a hole holds any expression.
test "{{{len(xs)}}} counts {xs}" for xs: List<Int> in [[], [1], [1, 2]] {
  assert_eq(len(xs), fold(xs, 0, |n: Int, _: Int| n + 1))
}

// A table may raise: one that does not is listed, and one that does fails its test.
fn halves() -> List<Int> / {abort.raise} = map([2, 4, 8], |n: Int| n / 2)

test "{n} is a half" for n: Int in halves() { assert(n * 2 % 2 == 0) }

// A table with no case is no test.
fn none() -> List<Int> = []

test "never run for {n}" for n: Int in none() { assert(false) }

nondet effect clock {
  read now() -> Int
}

// `test/nondet` ranges over cases as a test does, and so does a body that searches interleavings.
test/nondet "the clock is read past {floor}" for floor: Int in [0, 1] {
  handle { assert(clock.now() > floor) } with { clock.now() -> floor + 1 }
}

test "{n} joins as {n + 1}" for n: Int in [1, 2] {
  simulate {
    let t = task.spawn(|| n + 1);
    assert_eq(task.join(t), n + 1)
  }
}

type Date = new { year: Int, month: Int, day: Int }

fn epoch() -> Date = { year: 1970, month: 1, day: 1 }

// A case may be a `new` record: a literal in the table is one, the label and the body read it as
// one, and its digest is its record's.
test "{d.year} is a date" for d: Date in [{ year: 2026, month: 1, day: 1 }, epoch()] {
  assert(d != { year: 0, month: 1, day: 1 });
  assert_eq(digest(d), digest({ year: d.year, month: 1, day: 1 }))
}

effect vectors {
  raise missing(name: String)
}

fn found(n: Int) -> Int / {vectors.missing} = if n > 0 { n } else { vectors.missing("none") }

// A table and a label may raise by any `raise` operation, and a `try` there answers one.
test "{found(n)} is found" for n: Int in [found(1), found(2)] { assert(n > 0) }

test "{r} is tried" for r: Result<Int, String> in [try { found(1) }, try { found(0) }] {
  assert(r == Ok(1) || r == Err("none"))
}

// The names a test over cases is entered by are no source's to write, so the body's own are free.
test "{at} is the case's own name" for at: Int in [5] {
  let digest = at + 1;
  assert_eq(digest, 6)
}
