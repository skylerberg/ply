pub type Mode = | Fast | Slow

pub fn greet(name: Bytes = b"world", times: Int = 1) -> Bytes =
  name.concat(Bytes::of_string(times.to_string()))

pub fn run(m: Mode = Fast, n: Int = 0) -> Int = match m { Fast -> n + 1, Slow -> n }

pub fn scale(v: Int, by: Int = 2) -> Int = v * by

pub fn twice(x: Int) -> Int = x * 2

pub fn applied(x: Int, f: (Int) -> Int = twice) -> Int = f(x)

type Shape = | Circle(Int) | Square(Int)

fn area(s: Shape = Square(3)) -> Int = match s { Circle(r) -> 3 * r * r, Square(w) -> w * w }

pub fn default_area() -> Int = area()
