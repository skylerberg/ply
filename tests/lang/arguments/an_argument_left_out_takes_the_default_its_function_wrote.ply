import arguments.defaults (applied, default_area, greet, run, scale)

test "an argument left out takes the default its function wrote" {
  assert_eq(greet(), b"world1");
  assert_eq(greet(b"x"), b"x1");
  assert_eq(scale(3), 6);
  assert_eq(run(), 1);
  assert_eq(applied(4), 8);
  assert_eq(default_area(), 9)
}

test "named arguments fill their parameters in any order, and the defaults the rest" {
  assert_eq(greet(times: 2), b"world2");
  assert_eq(greet(b"x", times: 2), b"x2");
  assert_eq(greet(times: 2, name: b"y"), b"y2");
  assert_eq(scale(3, by: 4), 12);
  assert_eq(run(n: 4), 5)
}

test "a local shadows a function of its name, and never a default the call leaves out" {
  let greet = |x: Int| x + 1;
  let twice = 0;
  assert_eq(greet(1), 2);
  assert_eq(applied(5) + twice, 10)
}
