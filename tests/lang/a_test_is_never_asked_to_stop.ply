//! A stop requested once would end every test after it, a coupling the effects graph cannot see, so
//! a test's run listens for none.

import std.signal (signal)

pub fn shedding() -> Bool / {signal.read} = signal.stopping()

test/nondet "no stop reaches the program" {
  assert(!shedding());
  assert_eq(signal.deadline_ms(), -1)
}
