import std.set

pub type Deque<a> = | Deque(List<a>, List<a>)

key for Deque by to_list

pub fn empty<a>() -> Deque<a> = Deque([], [])

pub fn push_back<a>(d: Deque<a>, x: a) -> Deque<a> =
  match d { Deque(front, back) -> Deque(front, back.push(x)) }

pub fn push_front<a>(d: Deque<a>, x: a) -> Deque<a> =
  match d { Deque(front, back) -> Deque(front.push(x), back) }

fn reversed<a>(xs: List<a>) -> List<a> =
  range(0, xs.len()).fold([], |accumulator: List<a>, i: Int|
    match xs.at(xs.len() - 1 - i) { Some(x) -> accumulator.push(x), None -> accumulator })

pub fn to_list<a>(d: Deque<a>) -> List<a> =
  match d {
    Deque(front, back) ->
      back.fold(reversed(front), |accumulator: List<a>, x: a| accumulator.push(x)),
  }

fn pushed_back() -> Deque<Int> = push_back(push_back(push_back(empty(), 1), 2), 3)

fn pushed_front() -> Deque<Int> = push_front(push_front(push_front(empty(), 3), 2), 1)

fn split(d: Deque<Int>) -> (List<Int>, List<Int>) = match d { Deque(front, back) -> (front, back) }

test "deques built by pushing at the back and at the front store their elements in different front and back lists but convert to the same list" {
  assert(split(pushed_back()) != split(pushed_front()));
  assert_eq(to_list(pushed_back()), to_list(pushed_front()))
}

test "they are equal" {
  assert(pushed_back() == pushed_front());
  assert(!(pushed_back() != pushed_front()));
  assert_eq(pushed_back(), pushed_front());
  assert(pushed_back() != push_back(pushed_back(), 4));
  assert(empty() == push_back(empty(), 1) == false)
}

test "two deques built by pushing at opposite ends have the same digest" {
  assert_eq(digest(pushed_back()), digest(pushed_front()));
  assert(digest(pushed_back()) != digest(push_front(pushed_back(), 0)))
}

test "two deques with equal elements are one map key and one set member" {
  let m = Map::new().insert(pushed_back(), "back").insert(pushed_front(), "front");
  assert_eq(m.len(), 1);
  assert_eq(m.get(pushed_back()), Some("front"));
  assert(m.contains(pushed_front()));
  assert_eq(#[pushed_back(), pushed_front(), empty()].size(), 2);
  assert_eq(m.remove(pushed_back()).len(), 0)
}

test "deques compare, `min` and `max` in the same order as their elements" {
  assert_eq(compare(pushed_back(), pushed_front()), Equal);
  assert_eq(compare(pushed_back(), push_back(pushed_front(), 0)), Less);
  assert_eq(compare(push_front(empty(), 2), pushed_front()), Greater);
  assert_eq(to_list(min(push_front(empty(), 2), pushed_back())), [1, 2, 3]);
  assert_eq(to_list(max(push_front(empty(), 2), pushed_back())), [2])
}

test "a deque of deques compares, digests and works as a map key by the elements of both levels" {
  let outer = push_back(push_back(empty(), pushed_back()), empty());
  let other = push_front(push_front(empty(), empty()), pushed_front());
  assert(outer == other);
  assert_eq(digest(outer), digest(other));
  assert_eq(#{outer: 1, other: 2}.len(), 1)
}
