import std.set

pub type Length = | Metres(Int) | Millimetres(Int)

key for Length by millimetres

fn millimetres(l: Length) -> Int = match l { Metres(n) -> n * 1000, Millimetres(n) -> n }

type Tagged = | Tagged(String, Length)

key for Tagged by untagged

fn untagged(t: Tagged) -> Length = match t { Tagged(_, l) -> l }

type Span = | Between(Length, Length) | Open

fn same<a>(x: a, y: a) -> Bool = x == y

fn least<a>(x: a, y: a) -> a
  where derivable(ord, a)
= min(x, y)

fn hashed<a>(x: a) -> Bytes
  where derivable(hash, a)
= digest(x)

test "two constructors of one type are equal, ordered and digested by their keys, not their fields" {
  assert(Metres(2) == Millimetres(2000));
  assert(Metres(2) != Millimetres(2001));
  assert_eq(Metres(2), Millimetres(2000));
  assert_eq(compare(Metres(1), Millimetres(999)), Greater);
  assert_eq(compare(Millimetres(1), Metres(1)), Less);
  assert_eq(compare(Millimetres(3000), Metres(3)), Equal);
  assert_eq(millimetres(min(Metres(1), Millimetres(5))), 5);
  assert_eq(millimetres(max(Metres(1), Millimetres(5))), 1000);
  assert_eq(digest(Metres(2)), digest(Millimetres(2000)));
  assert(digest(Metres(2)) != digest(Millimetres(2)))
}

test "generic functions over a type parameter still compare keyed values by their keys" {
  assert(same(Metres(3), Millimetres(3000)));
  assert(!same(Metres(3), Millimetres(3)));
  assert_eq(millimetres(least(Metres(3), Millimetres(2999))), 2999);
  assert_eq(hashed(Metres(3)), hashed(Millimetres(3000)));
  assert(same([Metres(1)], [Millimetres(1000)]))
}

test "keyed values compare by their keys when nested in a list, record, tuple, option or sum" {
  assert_eq([Metres(1), Millimetres(2)], [Millimetres(1000), Millimetres(2)]);
  assert([Metres(1)] != [Millimetres(1)]);
  assert_eq({ width: Metres(1), name: "a" }, { name: "a", width: Millimetres(1000) });
  assert_eq((Metres(1), 2), (Millimetres(1000), 2));
  assert_eq(Some(Metres(1)), Some(Millimetres(1000)));
  assert_eq(Between(Metres(1), Millimetres(5)), Between(Millimetres(1000), Millimetres(5)));
  assert(Between(Metres(1), Metres(2)) != Open);
  assert_eq(Array::of_list([Metres(1)]), Array::of_list([Millimetres(1000)]));
  assert_eq(compare([Metres(1), Metres(1)], [Millimetres(1000), Millimetres(1001)]), Less);
  assert_eq(compare(Some(Metres(2)), Some(Millimetres(1999))), Greater);
  assert_eq(digest([Some(Metres(1))]), digest([Some(Millimetres(1000))]));
  assert_eq(digest({ w: Metres(1) }), digest({ w: Millimetres(1000) }))
}

test "a map and a set order keyed values by key and store one entry per key" {
  let m = #{Metres(2): "two", Millimetres(5): "five", Millimetres(2000): "again", Metres(1): "one"};
  assert_eq(m.len(), 3);
  assert_eq(m.values(), ["five", "one", "again"]);
  assert_eq(m.keys().map(millimetres), [5, 1000, 2000]);
  assert_eq(m.get(Millimetres(1000)), Some("one"));
  assert_eq(m.get(Metres(5)), None);
  assert(m.contains(Metres(2)));
  assert_eq(m.remove(Millimetres(2000)).len(), 2);
  assert_eq(#[Metres(1), Millimetres(1000), Millimetres(1)].size(), 2);
  assert_eq(m, #{Millimetres(1000): "one", Metres(2): "again", Millimetres(5): "five"});
  assert_eq(
    digest(m),
    digest(#{Millimetres(1000): "one", Metres(2): "again", Millimetres(5): "five"}),
  );
  assert_eq(m.fold(0, |total: Int, k: Length, _: String| total + millimetres(k)), 3005);
  assert_eq(m.merge(#{Millimetres(1000): "uno", Metres(9): "nine"}).len(), 4);
  assert_eq(m.update(Millimetres(5), |v: String| v ++ "!").get(Millimetres(5)), Some("five!"))
}

test "keyed values inside a map's keys and values compare by their keys, and strings in the same map compare as usual" {
  let by_pair = #{(Metres(1), 1.50m): "a", (Millimetres(1000), 1.5m): "b", (Metres(1), 2m): "c"};
  assert_eq(by_pair.len(), 2);
  assert_eq(by_pair.get((Millimetres(1000), 1.500m)), Some("b"));
  let by_list = Map::of_entries([
    { key: [Metres(1), Metres(2)], value: 1 },
    { key: [Millimetres(1000), Millimetres(2000)], value: 2 },
  ]);
  assert_eq(by_list.entries(), [{ key: [Millimetres(1000), Millimetres(2000)], value: 2 }]);
  assert_eq(#{"w": Metres(1)}, #{"w": Millimetres(1000)});
  assert(#{"w": Metres(1)} != #{"w": Millimetres(1)})
}

test "a type whose key function returns a keyed type compares by both keys" {
  assert(Tagged("a", Metres(1)) == Tagged("b", Millimetres(1000)));
  assert(Tagged("a", Metres(1)) != Tagged("a", Millimetres(1)));
  assert_eq(compare([Tagged("z", Metres(1))], [Tagged("a", Millimetres(1001))]), Less);
  assert_eq(digest(Tagged("a", Metres(1))), digest(Tagged("b", Millimetres(1000))));
  assert_eq(#{Tagged("a", Metres(1)): 1, Tagged("b", Millimetres(1000)): 2}.len(), 1)
}

test "a failed `assert_eq` reports a difference in the unkeyed parts, never in a key" {
  let failure = handle {
    assert_eq((Metres(1), [1, 2]), (Millimetres(1000), [1, 3]));
    "passed"
  } with {
    abort.raise(message) -> message,
  };
  assert(failure != "passed")
}
