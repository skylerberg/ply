// A key's function takes the value at the type's own parameters, and an effect variable is one of
// them. A hook holds a function, which nothing compares, so its key reads the name beside it, at
// whatever effects the hook was given.

import std.show (show)

effect log {
  write note[l](line: String) -> Unit
}

type Hook<a | e> = | Hook(String, (a) -> Unit / e) | Unhooked

key for Hook by named
show for Hook by titled

fn named<a | e>(h: Hook<a | e>) -> Option<String> =
  match h { Hook(name, _) -> Some(name), Unhooked -> None }

fn titled<a | e>(h: Hook<a | e>) -> String =
  match h { Hook(name, _) -> "hook " ++ name, Unhooked -> "no hook" }

fn run<a | e>(h: Hook<a | e>, x: a) -> Unit / e = match h { Hook(_, f) -> f(x), Unhooked -> () }

fn same<a>(x: a, y: a) -> Bool
  where derivable(eq, a)
= x == y

fn noting(name: String) -> Hook<String | {log.note[app]}> =
  Hook(name, |line: String| log.note[app](line))

test "a sum generic over effects is compared through its key at effects that perform nothing" {
  let quiet: Hook<Int | {}> = Hook("save", |_n: Int| ());
  let other: Hook<Int | {}> = Hook("save", |n: Int| {
    let _twice = n + n;
    ()
  });
  assert(quiet == other);
  assert(quiet != Hook("load", |_n: Int| ()));
  assert(quiet != Unhooked);
  assert_eq(compare(Unhooked, quiet), compare(None, Some("save")));
  assert_eq(digest(quiet), digest(other));
  assert(same(quiet, other))
}

test "and at effects that perform, where the function it holds still runs" {
  let first = noting("audit");
  let again = Hook("audit", |line: String| log.note[app]("again " ++ line));
  assert(first == again);
  assert_eq(digest(first), digest(again));
  assert_eq(#{first: 1, again: 2, noting("trace"): 3}.len(), 2);
  assert_eq(max(first, noting("trace")), noting("trace"));
  let heard = handle {
    run(first, "kept");
    run(again, "said")
  } with {
    var lines = [],
    log.note[app](line) -> {
      lines = lines.push(line);
    },
    return u -> lines,
  };
  assert_eq(heard, ["kept", "again said"])
}

test "a show is found the same way" {
  let quiet: Hook<Int | {}> = Hook("save", |_n: Int| ());
  let none: Hook<Int | {}> = Unhooked;
  assert_eq(show([quiet, none]), "[hook save, no hook]");
  assert_eq(f"{noting("audit")}", "hook audit")
}
