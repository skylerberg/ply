// A date is three numbers, and a reader wants `2026-10-04`. `show` says what is written wherever
// one is shown: by `show`, by `display`, in an interpolated string's hole and by `derive show`, at
// whatever depth it sits. It says nothing of how two are compared.

import std.show (show, display)
import std.value (VCtor, VInt)

pub type Date = | Date(Int, Int, Int)

show for Date by written

derive show for Date

fn two(n: Int) -> String = if n < 10 { "0" ++ int_to_string(n) } else { int_to_string(n) }

fn written(d: Date) -> String =
  match d { Date(y, m, day) -> int_to_string(y) ++ "-" ++ two(m) ++ "-" ++ two(day) }

// Both: equal by its key, and shown by a function that reads more than the key does.
type Stamped = | Stamped(Date, String)

key for Stamped by day
show for Stamped by noted

fn day(s: Stamped) -> (Int, Int, Int) = match s { Stamped(Date(y, m, d), _) -> (y, m, d) }

fn noted(s: Stamped) -> String = match s { Stamped(d, note) -> f"{d} ({note})" }

// A type that holds a function is shown once it says how.
type Step = | Step(String, (Int) -> Int)

show for Step by named

fn named(s: Step) -> String = match s { Step(name, _) -> "step " ++ name }

fn told<a>(x: a) -> String
  where derivable(show, a)
= show(x)

test "show, display and a hole write what the type's function writes" {
  let d = Date(2026, 10, 4);
  assert_eq(show(d), "2026-10-04");
  assert_eq(display(d), "2026-10-04");
  assert_eq(f"on {d}.", "on 2026-10-04.");
  assert_eq(date_show().show(d), "2026-10-04");
  assert_eq(told(d), "2026-10-04")
}

test "at any depth" {
  let d = Date(2026, 10, 4);
  assert_eq(show([d, Date(2027, 1, 2)]), "[2026-10-04, 2027-01-02]");
  assert_eq(show({ when: d, n: 1 }), "{n: 1, when: 2026-10-04}");
  assert_eq(show((d, "x")), "(2026-10-04, \"x\")");
  assert_eq(show(Some(d)), "Some(2026-10-04)");
  assert_eq(show(#{d: [d]}), "{2026-10-04: [2026-10-04]}");
  assert_eq(show(array_of_list([d])), "array_of_list([2026-10-04])");
  assert_eq(f"{[Some(d)]}", "[Some(2026-10-04)]")
}

test "a type that states only a show is compared as it is built" {
  assert(Date(2026, 10, 4) == Date(2026, 10, 4));
  assert(Date(2026, 10, 4) != Date(2026, 10, 5));
  assert_eq(compare(Date(2026, 1, 1), Date(2026, 1, 2)), Less)
}

test "a key and a show are read apart" {
  let first = Stamped(Date(2026, 10, 4), "sent");
  let second = Stamped(Date(2026, 10, 4), "received");
  assert(first == second);
  assert_eq(show(first), "2026-10-04 (sent)");
  assert_eq(show(second), "2026-10-04 (received)");
  assert_eq(show([first]), "[2026-10-04 (sent)]")
}

test "a type its fields would refuse is shown by its function" {
  assert_eq(show(Step("double", |n: Int| n * 2)), "step double");
  assert_eq(f"{[Step("inc", |n: Int| n + 1)]}", "[step inc]")
}

test "reflect reads the value as it is built, whatever it shows as" {
  assert_eq(match reflect(Date(2026, 10, 4)) { VCtor(_, fields) -> fields, _ -> [] }, [
    VInt(2026),
    VInt(10),
    VInt(4),
  ])
}
