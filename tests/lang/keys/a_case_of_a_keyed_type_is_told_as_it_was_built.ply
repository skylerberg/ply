// A test over cases tells a case by what it holds and not by its key: three splits of one sequence
// are one value to `==`, `digest` and a `Map`, and three cases, each with a pass of its own.

import std.cases (Listed, listed)

pub type Deque<a> = | Deque(List<a>, List<a>)

key for Deque by to_list

fn reversed<a>(xs: List<a>) -> List<a> =
  fold(range(0, len(xs)), [], |acc: List<a>, i: Int|
    match list_at(xs, len(xs) - 1 - i) { Some(x) -> push(acc, x), None -> acc })

pub fn to_list<a>(d: Deque<a>) -> List<a> =
  match d { Deque(front, back) -> fold(back, reversed(front), |acc: List<a>, x: a| push(acc, x)) }

fn in_front(d: Deque<Int>) -> Int = match d { Deque(front, _) -> len(front) }

fn splits() -> List<Deque<Int>> = [Deque([], [1, 2, 3]), Deque([1], [2, 3]), Deque([3, 2, 1], [])]

test "a split with {in_front(d)} in front lists one to three" for d: Deque<Int> in splits() {
  assert_eq(to_list(d), [1, 2, 3]);
  assert_eq(d, Deque([2, 1], [3]));
  assert_eq(digest(d), digest(Deque([], [1, 2, 3])))
}

test "the splits are one value, and three cases" {
  assert_eq(map_len(map_of_entries(map(splits(), |d: Deque<Int>| { key: d, value: 0 }))), 1);
  let cases = listed(splits(), |d: Deque<Int>| int_to_string(in_front(d)));
  assert_eq(map(cases, |c: Listed| c.label), ["0", "1", "3"]);
  assert_eq(map_len(map_of_entries(map(cases, |c: Listed| { key: c.identity, value: 0 }))), 3)
}
