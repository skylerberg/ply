import std.cases (Case, listed)

pub type Deque<a> = | Deque(List<a>, List<a>)

key for Deque by to_list

fn reversed<a>(xs: List<a>) -> List<a> =
  range(0, xs.len()).fold([], |accumulator: List<a>, i: Int|
    match xs.at(xs.len() - 1 - i) { Some(x) -> accumulator.push(x), None -> accumulator })

pub fn to_list<a>(d: Deque<a>) -> List<a> =
  match d {
    Deque(front, back) ->
      back.fold(reversed(front), |accumulator: List<a>, x: a| accumulator.push(x)),
  }

fn in_front(d: Deque<Int>) -> Int = match d { Deque(front, _) -> front.len() }

fn splits() -> List<Deque<Int>> = [Deque([], [1, 2, 3]), Deque([1], [2, 3]), Deque([3, 2, 1], [])]

test "a deque holding 1, 2, 3 with {in_front(d)} items in its front list converts to [1, 2, 3], equals `Deque([2, 1], [3])` and has the same digest as `Deque([], [1, 2, 3])`" for d: Deque<Int> in splits(
  ) {
  assert_eq(to_list(d), [1, 2, 3]);
  assert_eq(d, Deque([2, 1], [3]));
  assert_eq(digest(d), digest(Deque([], [1, 2, 3])))
}

test "deques with the same elements but different front and back lists are one map key, yet make three separate test cases" {
  assert_eq(Map::of_entries(splits().map(|d: Deque<Int>| { key: d, value: 0 })).len(), 1);
  let cases = listed(splits(), |d: Deque<Int>| in_front(d).to_string());
  assert_eq(cases.map(|c: Case| c.label), ["0", "1", "3"]);
  assert_eq(Map::of_entries(cases.map(|c: Case| { key: c.identity, value: 0 })).len(), 3)
}
