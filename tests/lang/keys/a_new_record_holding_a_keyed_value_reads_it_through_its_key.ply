// A `new` record runs as its plain record, compared, ordered, digested and shown field by field. A
// field whose type states a `key` or a `show` is read through it there as anywhere: by the
// builtins, and by what `derive` writes for the record.

import std.show (show)

type Length = | Metres(Int) | Millimetres(Int)

key for Length by millimetres

show for Length by written

derive eq for Length
derive ord for Length
derive hash for Length
derive show for Length

fn millimetres(l: Length) -> Int = match l { Metres(n) -> n * 1000, Millimetres(n) -> n }

fn written(l: Length) -> String = int_to_string(millimetres(l)) ++ "mm"

type Plank = new { length: Length, grade: String }

derive eq for Plank
derive ord for Plank
derive hash for Plank
derive show for Plank

fn plank(length: Length, grade: String) -> Plank = { length: length, grade: grade }

test "a new record holding a keyed value is equal, ordered and digested as the key says" {
  let a = plank(Metres(2), "a");
  let b = plank(Millimetres(2000), "a");
  assert(a == b);
  assert_eq(a, b);
  assert_eq(compare(a, b), Equal);
  assert_eq(digest(a), digest(b));
  assert_eq(map_len(#{a: 1, b: 2}), 1);
  assert_eq(compare(plank(Millimetres(1999), "a"), a), Less);
  assert_eq(max(plank(Millimetres(2001), "a"), a), longer(b));
  assert(a != plank(Metres(2), "b"))
}

fn longer(p: Plank) -> Plank = { ..p, length: Millimetres(millimetres(p.length) + 1) }

test "what derive writes for the record goes through the key too" {
  let a = plank(Metres(2), "a");
  let b = plank(Millimetres(2000), "a");
  assert(plank_eq().eq(a, b));
  assert_eq(plank_ord().compare(a, b), Equal);
  assert_eq(plank_ord().compare(plank(Millimetres(1), "a"), a), Less);
  assert_eq(plank_hash().hash(a), plank_hash().hash(b));
  assert_eq(plank_hash().hash(a), digest(b));
  assert_eq(plank_show().show(a), "{grade: \"a\", length: 2000mm}");
  assert_eq(show(b), plank_show().show(a))
}
