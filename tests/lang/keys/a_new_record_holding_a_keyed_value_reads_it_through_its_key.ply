// A `new` record runs as its plain record, compared, ordered, digested and shown field by field. A
// field whose type states a `key` or a `show` is read through it there as anywhere.

import std.show (show)

type Length = | Metres(Int) | Millimetres(Int)

key for Length by millimetres

show for Length by length_text

fn millimetres(l: Length) -> Int = match l { Metres(n) -> n * 1000, Millimetres(n) -> n }

fn length_text(l: Length) -> String = millimetres(l).to_string() ++ "mm"

type Plank = new { length: Length, grade: String }

fn plank(length: Length, grade: String) -> Plank = { length: length, grade: grade }

test "a new record holding a keyed value is equal, ordered and digested as the key says" {
  let a = plank(Metres(2), "a");
  let b = plank(Millimetres(2000), "a");
  assert(a == b);
  assert_eq(a, b);
  assert_eq(compare(a, b), Equal);
  assert_eq(digest(a), digest(b));
  assert_eq(#{a: 1, b: 2}.len(), 1);
  assert_eq(compare(plank(Millimetres(1999), "a"), a), Less);
  assert_eq(max(plank(Millimetres(2001), "a"), a), longer(b));
  assert(a != plank(Metres(2), "b"))
}

fn longer(p: Plank) -> Plank = { ..p, length: Millimetres(millimetres(p.length) + 1) }

test "a new record holding a value whose type states a show is shown through it" {
  let a = plank(Metres(2), "a");
  assert_eq(show(a), "{grade: \"a\", length: 2000mm}");
  assert_eq(show(plank(Millimetres(2000), "a")), show(a))
}
