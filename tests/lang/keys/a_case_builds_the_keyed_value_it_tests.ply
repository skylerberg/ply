// A test over cases tells a case by its value's digest, and a keyed value's digest is its key's:
// two splits of one sequence would be one case to a run, though a body can tell them apart. So a
// case holds what a keyed value is built from, and its body builds the value.

pub type Deque<a> = | Deque(List<a>, List<a>)

key for Deque by to_list

fn reversed<a>(xs: List<a>) -> List<a> =
  fold(range(0, len(xs)), [], |acc: List<a>, i: Int|
    match list_at(xs, len(xs) - 1 - i) { Some(x) -> push(acc, x), None -> acc })

pub fn to_list<a>(d: Deque<a>) -> List<a> =
  match d { Deque(front, back) -> fold(back, reversed(front), |acc: List<a>, x: a| push(acc, x)) }

type Split = { front: List<Int>, back: List<Int> }

fn splits() -> List<Split> =
  [{ front: [], back: [1, 2, 3] }, { front: [1], back: [2, 3] }, { front: [3, 2, 1], back: [] }]

test "a split with {len(s.front)} in front lists one to three" for s: Split in splits() {
  let d = Deque(s.front, s.back);
  assert_eq(to_list(d), [1, 2, 3]);
  assert_eq(d, Deque([2, 1], [3]));
  assert_eq(digest(d), digest(Deque([], [1, 2, 3])))
}

test "the splits are three cases, and one value once built" {
  assert_eq(len(splits()), 3);
  assert_eq(map_len(map_of_entries(map(splits(), |s: Split| { key: s, value: 0 }))), 3);
  assert_eq(
    map_len(map_of_entries(map(splits(), |s: Split| { key: Deque(s.front, s.back), value: 0 }))),
    1,
  )
}
