effect log {
  write say[l](n: Int) -> Unit
}

fn twice<| e>(f: () -> Int / e) -> Int / e = f() + f()

fn shut(_: Int) -> Unit = ()

fn through_a_row(n: Int) -> Int = with_scope[t](n, shut) { c -> twice(|| c.get()) }

fn of_the_same_name<| e>(f: () -> Int / e) -> Int / e =
  with_scope[t](1, shut) { d -> d.get() + f() }

fn under_one_name(n: Int) -> Int = with_scope[t](n, shut) { c -> of_the_same_name(|| c.get()) }

fn peek<[r]>(h: Scoped<Int, [r]>) -> Int / {scoped.read[r]} = h.get()

fn outer_after_inner(n: Int) -> Int =
  with_scope[outer](
    n,
    shut,
  ) { h -> {
    let k = with_scope[inner](
      2,
      shut,
    ) { g -> {
      let m = peek(g);
      || peek(h) + m
    } };
    k()
  } }

fn noted<[l], [r]>(h: Scoped<Int, [r]>) -> Unit / {log.write[l], scoped.read[r]} =
  log.say[l](h.get())

fn beside_a_written_label(n: Int) -> Int =
  handle {
    with_scope[file](n, shut) { h -> noted[audit](h) }
  } with {
    var logged = 0,
    log.say[audit](x) -> {
      logged = x;
    },
    return u -> logged,
  }

fn boxed() -> Int = with_scope[log](41, shut) { h -> h.get() }

test "a constant whose body opens a scope returns the same value every time it is read" {
  assert_eq(boxed(), 41);
  assert_eq(boxed(), 41)
}

test "a closure over a scoped value can be passed to a function whose effects are a type variable, and the scope that created the value still handles it" {
  assert_eq(through_a_row(21), 42);
  assert_eq(under_one_name(41), 42)
}

test "a read of an outer scope's value inside an inner scope is handled by the outer scope" {
  assert_eq(outer_after_inner(40), 42)
}

test "a call that spells out a resource label in a type annotation still accepts a scoped value that carries that label" {
  assert_eq(beside_a_written_label(42), 42)
}
