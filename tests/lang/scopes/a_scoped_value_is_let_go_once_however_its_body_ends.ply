import std.value (VInt, reflect)

effect log {
  write note(s: String) -> Unit
}

effect stop {
  write now() -> Unit
}

effect door {
  raise shut(reason: String)
}

fn opened(name: String) -> String / {log.note} = {
  log.note("open " ++ name);
  name
}

fn closed(name: String) -> Unit / {log.note} = log.note("close " ++ name)

fn noted<| e>(go: () -> Unit / {log.note | e}) -> List<String> / e =
  handle {
    go()
  } with {
    var seen = [],
    log.note(s) -> {
      seen = seen.push(s);
    },
    return u -> seen,
  }

test "release runs after a body that returns, and the scope returns the body's result" {
  let seen = noted(|| {
    let n = with_scope[file](
      opened("a"),
      closed,
    ) { h -> {
      log.note("use " ++ h.get());
      h.get().len()
    } };
    assert_eq(n, 1)
  });
  assert_eq(seen, ["open a", "use a", "close a"])
}

test "release runs when a handler clause that does not resume unwinds through the body" {
  let seen = noted(|| {
    let returned = handle {
      with_scope[file](
        opened("a"),
        closed,
      ) { h -> {
        stop.now();
        log.note("never");
        1
      } }
    } with {
      stop.now() resume k -> 0,
    };
    assert_eq(returned, 0)
  });
  assert_eq(seen, ["open a", "close a"])
}

test "release runs when a raise unwinds through the body, before the clause that handles it" {
  let seen = noted(|| {
    let returned = handle {
      with_scope[file](
        opened("a"),
        closed,
      ) { h -> {
        door.shut("gone");
        log.note("never");
        1
      } }
    } with {
      door.shut(reason) -> {
        log.note("caught " ++ reason);
        reason.len()
      },
    };
    assert_eq(returned, 4)
  });
  assert_eq(seen, ["open a", "close a", "caught gone"])
}

test "nothing is released when the acquire raised" {
  let seen = noted(|| {
    let returned: Result<Int, String> = try {
      with_scope[file](door.shut("no such file"), closed) { h -> h.get().len() }
    };
    assert_eq(returned, Err("no such file"))
  });
  assert_eq(seen, [])
}

test "nested scopes release in reverse order, so the inner scoped value is released first" {
  let seen = noted(||
    handle {
      with_scope[outer](
        opened("outer"),
        closed,
      ) { o ->
        with_scope[inner](
          opened("inner"),
          closed,
        ) { i -> {
          log.note("use " ++ o.get() ++ " and " ++ i.get());
          stop.now()
        } }
      }
    } with {
      stop.now() resume k -> (),
    });
  assert_eq(seen, ["open outer", "open inner", "use outer and inner", "close inner", "close outer"])
}

test "release runs with the handlers around the scope, not those inside its body" {
  let seen = noted(||
    with_scope[file](
      opened("a"),
      closed,
    ) { h -> handle { log.note("muted") } with { log.note(s) -> () } });
  assert_eq(seen, ["open a", "close a"])
}

test "a release that raises replaces the raise already unwinding through the body" {
  let returned: Result<Int, String> = try {
    with_scope[file](1, |n: Int| door.shut("release")) { h -> {
      door.shut("body");
      h.get()
    } }
  };
  assert_eq(returned, Err("release"))
}

test "a cancelled task releases its scoped value, in every scheduling order" {
  let seen = noted(||
    simulate {
      let t = task.spawn(||
        with_scope[file](
          opened("a"),
          closed,
        ) { h -> {
          clock.sleep(Duration(10));
          log.note("done");
          h.get()
        } });
      clock.sleep(Duration(5));
      assert(task.cancel(t));
      assert_eq(task.await(t), None)
    });
  assert_eq(seen, ["open a", "close a"])
}

fn with_token(tokens: Chan<Unit>) -> Unit / {task.write} =
  with_scope[token](task.recv(tokens), |acquired: Option<Unit>| {
    task.send(tokens, ());
    ()
  }) { h -> task.yield() }

test "a cancel during a scoped value's acquire puts back the token the acquire took from a channel, in every scheduling order" {
  simulate {
    let tokens = task.channel(1);
    assert(task.send(tokens, ()));
    let holder = task.spawn(|| with_token(tokens));
    task.cancel(holder);
    task.await(holder);
    assert_eq(task.recv(tokens), Some(()))
  }
}

test "a cancel during a scoped value's acquire abandons the acquire's wait on a channel, and nothing is released" {
  let seen = noted(||
    simulate {
      let never: Chan<String> = task.channel(0);
      let t = task.spawn(||
        with_scope[file](task.recv(never), |acquired: Option<String>| closed("a")) { h -> () });
      clock.sleep(Duration(1));
      assert(task.cancel(t));
      assert_eq(task.await(t), None)
    });
  assert_eq(seen, [])
}

test "a cancel does not interrupt a scoped value's release, and takes effect after the release finishes" {
  let seen = noted(||
    simulate {
      let gate = task.channel(0);
      let t = task.spawn(||
        with_scope[file]((), |u: Unit| {
          task.recv(gate);
          log.note("released")
        }) { h -> () });
      clock.sleep(Duration(1));
      assert(task.cancel(t));
      assert(!task.cancel(t));
      log.note("cancelled");
      assert(task.send(gate, 1));
      assert_eq(task.await(t), None)
    });
  assert_eq(seen, ["cancelled", "released"])
}

fn doubled<[r]>(h: Scoped<Int, [r]>) -> Int / {scoped.read[r]} = h.get() * 2

test "a scoped value can be read by the functions and closures that its scope passes it to" {
  let total = with_scope[n](21, |x: Int| ()) { h ->
    [1, 2, 3].fold(doubled(h), |accumulator: Int, i: Int| accumulator + i * h.get())
  };
  assert_eq(total, 42 + 6 * 21)
}

test "a simulation inside a scoped value's scope shares the scoped value" {
  let both = with_scope[n](20, |x: Int| ()) { h ->
    simulate {
      let a = task.spawn(|| h.get() + 1);
      let b = task.spawn(|| doubled(h));
      task.join(a) + task.join(b)
    }
  };
  assert_eq(both, 61)
}

test "the release code sits outside the scoped value's binding, so a variable there with the binding's name refers to the outer variable" {
  let h = "outer";
  let seen = noted(||
    with_scope[file](opened("a"), |name: String|
      log.note("close " ++ name ++ " beside " ++ h)) { h -> log.note("use " ++ h.get()) });
  assert_eq(seen, ["open a", "use a", "close a beside outer"])
}

test "`reflect` on a scoped value returns `VHold`, never the reflection of the value inside it" {
  let seen = with_scope[n](42, |x: Int| ()) { h ->
    match reflect(h) { VInt(_) -> "what it holds", _ -> "the hold" }
  };
  assert_eq(seen, "the hold")
}

effect released {
  write one() -> Unit
}

fn fail_at_depth(depth: Int) -> Int / {door.shut} =
  if depth <= 0 { door.shut("deep") } else { 1 + fail_at_depth(depth - 1) }

test "a scoped value is released every time a raise from deep in its body is caught, repeated many times in one loop" {
  let turns = 300000;
  let let_go = handle {
    iterate(0, turns + 1, |turn: Int|
      if turn >= turns { Stop(()) } else {
        let caught: Result<Int, String> = try {
          with_scope[file](turn, |x: Int| released.one()) { h -> fail_at_depth(50) + h.get() }
        };
        if caught == Err("deep") { Continue(turn + 1) } else { panic("the raise was not caught") }
      })
  } with {
    var n = 0,
    released.one() -> {
      n = n + 1;
    },
    return u -> n,
  };
  assert_eq(let_go, turns)
}
