//! A one-word sum crosses into what the runtime holds as a word it never takes for an object: a
//! case holding a raw scalar crosses as an `Int` does, whatever its value, and a nullary case's word
//! lies below every object. A scoped value, a channel and a task each give it back as it was.

type Id = | Id(Int)

type Mode = | Read | Write | Both | Named(String)

fn back(x: Id) -> Id = with_scope[h](x, |_: Id| ()) { held -> held.get() }

fn mode_round_trip(m: Mode) -> Mode = with_scope[h](m, |_: Mode| ()) { held -> held.get() }

fn number(x: Id) -> Int = match x { Id(n) -> n }

/// Raw words that read as an object's address, or as a word with its low bit clear.
fn ids() -> List<Int> = [8, 16, 4096, 4104, 0 - 8, 9223372036854775807, 0 - 9223372036854775807 - 1]

test "a scoped value returns a one-case sum wrapping a raw integer unchanged, whatever the integer is" {
  assert_eq(ids().map(|n: Int| number(back(Id(n)))), ids())
}

test "a scoped value returns each case of a sum with fieldless cases unchanged" {
  assert_eq([Read, Write, Both, Named("n")].map(mode_round_trip), [Read, Write, Both, Named("n")])
}

test "sending a scoped one-word sum through a channel, or returning it from a spawned task, gives back the same value" {
  simulate {
    let c = task.channel(8);
    ids().fold((), |_: Unit, n: Int| assert(task.send(c, Id(n))));
    task.close(c);
    let got = ids().map(|_: Int| match task.recv(c) { Some(x) -> number(x), None -> 1 });
    assert_eq(got, ids());
    let t = task.spawn(|| [Write, Both]);
    assert_eq(task.join(t), [Write, Both])
  }
}
