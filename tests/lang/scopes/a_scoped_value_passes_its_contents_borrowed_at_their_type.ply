type Point = { x: Int, label: String }

type Shape = | Dot | Line(Point, Point) | Named(String)

fn read_twice<a>(x: a) -> List<a> = with_scope[h](x, |_: a| ()) { held -> [held.get(), held.get()] }

fn nested(s: String) -> String =
  with_scope[h](s, |_: String| ()) { outer ->
    with_scope[i](outer.get() ++ "!", |_: String| ()) { inner -> inner.get() ++ outer.get() }
  }

test "reading a scoped value returns a borrowed copy of its contents with the contents' own type, for integers, strings, decimals, records, variants and lists" {
  assert_eq(read_twice(7), [7, 7]);
  assert_eq(read_twice(9223372036854775807), [9223372036854775807, 9223372036854775807]);
  assert_eq(read_twice("held"), ["held", "held"]);
  assert_eq(read_twice(2.5m), [2.5m, 2.5m]);
  let p = { x: 1, label: "p" };
  assert_eq(read_twice(p), [p, p]);
  assert_eq(read_twice(Line(p, p)), [Line(p, p), Line(p, p)]);
  assert_eq(read_twice(Some([1, 2])), [Some([1, 2]), Some([1, 2])]);
  assert_eq(nested("a"), "a!a")
}

test "reading and releasing a scoped value leaves no reference counts outstanding" {
  let p = { x: 1, label: "p".concat("q") };
  assert_eq(read_twice(p).len(), 2);
  assert_eq(read_twice(Named("n".concat("m"))).len(), 2);
  assert_eq(read_twice(["a".concat("b")]).len(), 2);
  assert_eq(nested("x".concat("y")).len(), 5)
}
