type Point = { x: Int, y: Int }

type Shape = | Circle(Int) | Dot

test "an interpolation `{...}` in an f-string inserts the string form of its value" {
  let n = 3;
  assert_eq(f"n = {n}", "n = 3");
  assert_eq(f"{n}{n}", "33");
  assert_eq(f"{n + 1} and {n * 2}", "4 and 6");
  assert_eq(f"{1.5} {2.50m} {true} {()}", "1.5 2.50 true ()")
}

test "a string or a character goes in as itself, and inside a structure as its literal" {
  let name = "ada";
  assert_eq(f"hi {name}", "hi ada");
  assert_eq(f"{'x'}{"y"}", "xy");
  assert_eq(f"{[name]}", "[\"ada\"]");
  assert_eq(f"{Some('c')}", "Some('c')")
}

test "records, constructors and collections show as their literals" {
  assert_eq(f"{{ x: 1, y: 2 }}", "{ x: 1, y: 2 }");
  let p: Point = { x: 1, y: 2 };
  assert_eq(f"at {p}", "at {x: 1, y: 2}");
  assert_eq(f"{Circle(2)} {Dot}", "Circle(2) Dot");
  assert_eq(f"{#{1: "a"}}", "{1: \"a\"}");
  assert_eq(
    f"{range(0, 40)}",
    "[" ++ range(1, 40).fold("0", |s: String, i: Int| s ++ ", " ++ i.to_string()) ++ "]",
  )
}

test "doubled braces in an f-string give literal braces, and escape sequences work as in a plain string" {
  assert_eq(f"{{}}", "{}");
  assert_eq(f"a\tb{1}\n", "a\tb1\n");
  assert_eq(f"plain", "plain")
}

fn label(n: Int) -> String = f"{n} {if n == 1 { "item" } else { "items" }}"

test "an interpolation `{...}` can contain any expression, including calls and nested f-strings" {
  assert_eq(label(1), "1 item");
  assert_eq(label(2), "2 items");
  assert_eq(f"{f"[{label(1)}]"}!", "[1 item]!")
}

fn shown_kinds(b: Bytes, c: Char, s: String) -> String = f"{b} {c} {[s]} {[c]}"

test "a function that interpolates a value of any kind needs no effects" {
  assert_eq(shown_kinds(b"a\x00", 'q', "x\"y"), "b\"a\\x00\" q [\"x\\\"y\"] ['q']")
}

test "an f-string equals the `++` concatenation of its text and the string forms of its values" {
  let x = 7;
  assert_eq(f"a {x} b", "a " ++ x.to_string() ++ " b")
}
