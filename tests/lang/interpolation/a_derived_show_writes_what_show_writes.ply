//! `derive show` gives a type a `{show: (T) -> String}` dictionary over `std.show.show`.

type Line = { sku: String, qty: Int, tags: List<String> }

type Box<a> = { label: String, inner: a }

type Tree = | Leaf | Node(Tree, Int, Tree)

derive show for Line
derive show for Box
derive show for Tree

fn describe<a>(x: a, d: { show: (a) -> String }) -> String = "<" ++ (d.show)(x) ++ ">"

test "a derived dictionary shows the value as show and interpolation do" {
  let l = { sku: "a-1", qty: 2, tags: ["x"] };
  assert_eq(line_show().show(l), "{qty: 2, sku: \"a-1\", tags: [\"x\"]}");
  assert_eq(line_show().show(l), f"{l}");
  assert_eq(describe(Node(Leaf, 1, Leaf), tree_show()), "<Node(Leaf, 1, Leaf)>")
}

test "a parameterized type's dictionary takes one for its parameter" {
  let b = { label: "n", inner: 5 };
  assert_eq(box_show({ show: |n: Int| int_to_string(n) }).show(b), "{inner: 5, label: \"n\"}")
}
