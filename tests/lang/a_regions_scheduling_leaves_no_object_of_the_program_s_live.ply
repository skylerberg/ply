// What a region's scheduler holds to answer a task's operations is no object of the program's, in
// `simulate` and in the run's region.

fn yielded(n: Int) -> Unit / {task.write} =
  if n <= 0 { () } else {
    task.yield();
    yielded(n - 1)
  }

test "the steps a simulation records leave no object of the program's live" {
  simulate { yielded(10) }
}

test/nondet "what a channel of the run's scheduler contains of its own is no object of the program's" {
  let c: Chan<Int> = task.channel(4);
  assert(task.send(c, 1))
}
