fn work(n: Int) -> Int / {clock.read, clock.write} = {
  clock.sleep(Duration(n));
  let t = match clock.now() { Instant(at) -> at };
  t + n
}

// Both tasks sleep from the simulation's start, so each wakes at its own span in any run order.
fn ordered(seed: Int) -> Int / {sim.read, abort.raise} =
  simulate {
    let a = task.spawn(|| work(seed));
    let b = task.spawn(|| work(seed * 2));
    task.join(a) * 1000 + task.join(b)
  }

fn timed(n: Int) -> Int / {sim.read} =
  simulate {
    clock.sleep(Duration(n));
    match clock.now() { Instant(at) -> at }
  }

fn drawn(bound: Int) -> Int / {sim.read, abort.raise} =
  simulate { random.below(bound) * 7 + random.below(bound) }

effect tally {
  read value() -> Int
  write set(v: Int) -> Unit
}

fn racing(n: Int) -> Int / {sim.read, abort.raise} =
  handle {
    simulate {
      let t = task.spawn(|| {
        tally.set(tally.value() + 1);
        task.yield();
        tally.set(tally.value() * 10);
        0
      });
      tally.set(tally.value() + n);
      task.yield();
      task.join(t);
      tally.value()
    }
  } with {
    var c = 0,
    tally.value() -> c,
    tally.set(v) -> {
      c = v;
    },
  }

test "a simulation's tasks sleep on its clock, draw from its seed and interleave only where they yield" {
  assert_eq(ordered(3), 6012);
  assert_eq(timed(1500), 1500);
  let d = drawn(100);
  assert(d >= 0 && d <= 99 * 7 + 99, None);
  // Steps between yields are whole, so the simulation's write lands before or after both the task's.
  let r = racing(5);
  assert(r == 60 || r == 15, None)
}
