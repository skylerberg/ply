// A `Char` is one Unicode scalar value: written as a literal, converted to and from its number, and
// taken out of and put back into a string.

test "a character literal is its scalar value" {
  assert_eq(int_of_char('a'), 97);
  assert_eq(int_of_char('\n'), 10);
  assert_eq(int_of_char('\''), 39);
  assert_eq(int_of_char('"'), 34);
  assert_eq(int_of_char('é'), 233);
  assert_eq(int_of_char('\u{1F600}'), 128512)
}

test "only a scalar value is a character" {
  assert_eq(char_of_int(97), Some('a'));
  assert_eq(char_of_int(1114111), Some('\u{10FFFF}'));
  assert_eq(char_of_int(55296), None);
  assert_eq(char_of_int(1114112), None);
  assert_eq(char_of_int(-1), None)
}

test "a string is its characters, in order" {
  let s = "h\u{e9}llo \u{1F600}";
  assert_eq(string_chars(s), ['h', 'é', 'l', 'l', 'o', ' ', '\u{1F600}']);
  assert_eq(string_of_chars(string_chars(s)), s);
  assert_eq(len(string_chars(s)), string_len(s));
  assert_eq(string_chars(""), [])
}

test "characters compare and order by scalar value" {
  assert('a' < 'b');
  assert('z' > 'a');
  assert('a' <= 'a');
  assert('a' >= 'a');
  assert('\u{1F600}' > 'z');
  assert_eq(compare('b', 'a'), Greater);
  assert('a' == 'a');
  assert('a' != 'b')
}

fn kind(c: Char) -> String =
  match c {
    'a' -> "first",
    '\n' -> "newline",
    _ -> if c >= '0' && c <= '9' { "digit" } else { "other" },
  }

test "a character literal is a pattern" {
  assert_eq(kind('a'), "first");
  assert_eq(kind('\n'), "newline");
  assert_eq(kind('7'), "digit");
  assert_eq(kind('x'), "other")
}

test "a character is a map key, in scalar-value order" {
  let m = map_insert(map_insert(map_insert(map_new(), 'c', 3), 'a', 1), 'b', 2);
  assert_eq(map_keys(m), ['a', 'b', 'c']);
  assert_eq(map_get(m, 'b'), Some(2))
}

test "a string escape names a character by its scalar value" {
  assert_eq("\u{48}\u{49}", "HI");
  assert_eq(bytes_of_string("\u{e9}"), b"\xc3\xa9");
  assert_eq("it\'s", "it's")
}
