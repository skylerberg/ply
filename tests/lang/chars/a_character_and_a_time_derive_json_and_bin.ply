import std.json
import std.bin

type Stamp = { mark: Char, at: Instant, took: Duration, marks: List<Char> }

derive json for Stamp
derive bin for Stamp

fn stamp() -> Stamp =
  {
    mark: '\u{1F600}',
    at: Instant(1_700_000_000_000_000_000),
    took: Duration(-3),
    marks: ['a', 'é'],
  }

test "a record with a `Char`, an `Instant` and a `Duration` encodes to JSON and decodes back unchanged" {
  let text = json::encode_string(stamp(), stamp_json());
  assert_eq(json::decode_string(text, stamp_json()), Ok(stamp()));
  assert(text.contains("1700000000000000000"))
}

test "a record with a `Char`, an `Instant` and a `Duration` encodes to `bin` and decodes back unchanged" {
  assert_eq(bin::decode(bin::encode(stamp(), stamp_bin()), stamp_bin()), Ok(stamp()))
}
