//! A character compares and orders as the runtime reads it, by scalar value, in a record as alone.

pub type Glyph = { c: Char, name: String }

test "a record holding a character orders by the character's scalar value" {
  assert_eq(compare({ c: 'a', name: "z" }, { c: 'b', name: "a" }), Less);
  assert_eq(compare({ c: '\u{1F600}', name: "a" }, { c: 'z', name: "a" }), Greater)
}

test "a record holding a character is equal by the character's scalar value" {
  let a: Glyph = { c: 'a', name: "x" };
  assert(a == { c: 'a', name: "x" });
  assert(a != { c: 'b', name: "x" })
}
