pub type Glyph = { c: Char, name: String }

test "a record with a character field orders by the character's scalar value" {
  assert_eq(compare({ c: 'a', name: "z" }, { c: 'b', name: "a" }), Less);
  assert_eq(compare({ c: '\u{1F600}', name: "a" }, { c: 'z', name: "a" }), Greater)
}

test "a record with a character field is equal to another only when the characters' scalar values are equal" {
  let a: Glyph = { c: 'a', name: "x" };
  assert(a == { c: 'a', name: "x" });
  assert(a != { c: 'b', name: "x" })
}
