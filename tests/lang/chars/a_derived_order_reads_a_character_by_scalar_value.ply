//! A character is a leaf for `eq` and `ord`, which read it as the runtime does: by scalar value.

pub type Glyph = { c: Char, name: String }
derive eq for Glyph
derive ord for Glyph

test "a derived order compares a character by its scalar value" {
  assert_eq(glyph_ord().compare({ c: 'a', name: "z" }, { c: 'b', name: "a" }), Less);
  assert_eq(glyph_ord().compare({ c: '\u{1F600}', name: "a" }, { c: 'z', name: "a" }), Greater)
}

test "a derived equality compares a character by its scalar value" {
  assert(glyph_eq().eq({ c: 'a', name: "x" }, { c: 'a', name: "x" }));
  assert(!glyph_eq().eq({ c: 'a', name: "x" }, { c: 'b', name: "x" }))
}
