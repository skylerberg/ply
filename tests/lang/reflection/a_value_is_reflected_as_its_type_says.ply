//! `reflect` reads a value as its type says: a scalar as its constructor, a width as its bits, a
//! record field by field in its names' order, and a sum as its constructor's name and arguments,
//! however deep each sits. `shown` is the same, but a type that states `show` is what it writes.

import std.value (Value, VBool, VBytes, VChar, VFixed, VInt, VRecord, VStr, VUnit, render)

type Shape = | Circle(Int) | Rect({ w: Int, h: U8 }) | Group(List<Shape>) | Nothing

type Tree<a> = | Leaf(a) | Node(Tree<a>, Tree<a>)

type Stamp = | Stamp(Int)

show for Stamp by stamped

fn stamped(s: Stamp) -> String = match s { Stamp(n) -> "at " ++ n.to_string() }

type Point = new { x: Int, y: U8 }

fn reflected<a>(x: a) -> Value = reflect(x)

test "a scalar and a width are their constructors, a record its fields in name order" {
  assert_eq(reflect(3), VInt(3));
  assert_eq(reflect(true), VBool(true));
  assert_eq(reflect("s"), VStr("s"));
  assert_eq(reflect(b"b"), VBytes(b"b"));
  assert_eq(reflect('c'), VChar('c'));
  assert_eq(reflect(()), VUnit);
  assert_eq(reflect(200u8), VFixed("U8", 200u128));
  assert_eq(reflect(-3i8), VFixed("I8", 253u128));
  assert_eq(
    reflect({ b: "x", a: 1 }),
    VRecord([{ name: "a", value: VInt(1) }, { name: "b", value: VStr("x") }]),
  );
  let p: Point = { x: 1, y: 2u8 };
  assert_eq(
    reflect(p),
    VRecord([{ name: "x", value: VInt(1) }, { name: "y", value: VFixed("U8", 2u128) }]),
  )
}

test "a sum is its constructor's name and arguments, each at its own type" {
  assert_eq(render(reflect(Circle(2))), "Circle(2)");
  assert_eq(render(reflect(Rect({ w: 3, h: 4u8 }))), "Rect({h: 4, w: 3})");
  assert_eq(render(reflect(Group([Circle(1), Nothing]))), "Group([Circle(1), Nothing])");
  assert_eq(render(reflect(Node(Leaf("a"), Leaf("b")))), "Node(Leaf(\"a\"), Leaf(\"b\"))");
  assert_eq(render(reflect(Some(Circle(5)))), "Some(Circle(5))");
  let failed: Result<Int, Shape> = Err(Nothing);
  assert_eq(render(reflect(failed)), "Err(Nothing)");
  assert_eq(reflect({ s: Circle(1) }), reflect({ s: Circle(1) }))
}

test "a generic definition reflects its parameter as the type it is called at" {
  assert_eq(reflected(4u8), VFixed("U8", 4u128));
  assert_eq(reflected(Circle(2)), reflect(Circle(2)));
  assert_eq(render(reflected(Node(Leaf(1), Leaf(2)))), "Node(Leaf(1), Leaf(2))");
  assert_eq(render(reflected({ t: Leaf(Nothing) })), "{t: Leaf(Nothing)}")
}

test "shown writes a type that states show as it says, at any depth" {
  assert_eq(render(shown(Stamp(3))), "at 3");
  assert_eq(render(shown({ when: Stamp(4), what: "x" })), "{what: \"x\", when: at 4}");
  assert_eq(render(shown(Leaf(Stamp(5)))), "Leaf(at 5)");
  assert_eq(render(shown([Stamp(1), Stamp(2)])), "[at 1, at 2]");
  assert_eq(render(reflect(Stamp(3))), "Stamp(3)")
}
