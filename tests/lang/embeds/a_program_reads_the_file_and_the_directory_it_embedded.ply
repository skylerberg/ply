fn greeting() -> Bytes = embed("greeting.txt")

fn files() -> List<{ name: String, bytes: Bytes }> = embed_dir("files")

test "a program reads the file and the directory it embedded" {
  assert_eq(greeting(), b"hi");
  assert_eq(files().map(|f: { name: String, bytes: Bytes }| f.name), [
    "a.txt",
    "b.txt",
    "deeper/c.txt",
  ]);
  assert_eq(files().map(|f: { name: String, bytes: Bytes }| f.bytes), [b"A", b"B", b"C"])
}
