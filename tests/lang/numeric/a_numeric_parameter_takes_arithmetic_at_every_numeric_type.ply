//! `where numeric(a)` lets a type parameter take arithmetic; a call fills it with a numeric type,
//! and the operators mean what they mean at that type.

fn total<a>(xs: List<a>) -> a
  where numeric(a)
= fold(xs, numeric_of_int(0), |s: a, x: a| s + x)

fn twice<a>(x: a) -> a
  where numeric(a)
= x + x

/// A constrained parameter passes its own type on.
fn doubled_total<a>(xs: List<a>) -> a
  where numeric(a)
= twice(total(xs))

fn largest<a>(xs: List<a>, start: a) -> a
  where numeric(a)
= fold(xs, start, |m: a, x: a| if x > m { x } else { m })

fn negated<a>(x: a) -> a
  where numeric(a)
= numeric_of_int(0) - x

test "a numeric parameter adds at every numeric type" {
  assert_eq(total([1, 2, 3]), 6);
  assert_eq(total([1u32, 2u32, 3u32]), 6u32);
  assert_eq(total([i8_of_int(0 - 3), 2i8]), i8_of_int(0 - 1));
  assert_eq(total([0xFFFF_FFFF_FFFFu64, 1u64]), 0x1_0000_0000_0000u64);
  assert_eq(total([0.5, 0.25]), 0.75);
  assert_eq(total([1.50m, 2.25m]), 3.75m)
}

test "a parameter passes its type to the definitions it calls" {
  assert_eq(doubled_total([1u8, 2u8]), 6u8);
  assert_eq(doubled_total([1.5m]), 3.0m)
}

test "comparisons and negation read the type the call filled" {
  assert_eq(largest([3u16, 9u16, 4u16], 0u16), 9u16);
  assert_eq(largest([0.0 - 2.5, 0.0 - 1.5], 0.0 - 10.0), 0.0 - 1.5);
  assert_eq(negated(5), 0 - 5);
  assert_eq(negated(2.5m), 0m - 2.5m)
}

test "a constant is written at the parameter's type" {
  assert_eq(total([]), 0);
  assert_eq(total([]), 0u8);
  assert_eq(total([]), 0.0)
}
