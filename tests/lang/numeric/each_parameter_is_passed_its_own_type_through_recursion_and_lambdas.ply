// Each `numeric` parameter is passed the type its call fixes, whatever order the constraints are
// written in, and a recursive call or a lambda inside the definition reads that same type.

fn mixed<a, b>(x: a, y: b, xs: List<b>) -> a
  where numeric(b), numeric(a)
= if fold(xs, y, |s: b, v: b| s + v) > y { x + x } else { x }

fn deepened<a>(x: a, n: Int) -> a
  where numeric(a)
= if n == 0 { x } else { deepened(x, n - 1) + numeric_of_int(1) }

fn scaled<a>(xs: List<a>, k: a) -> List<a>
  where numeric(a)
= map(xs, |x: a| x * k)

test "each parameter is passed its own type, in any order the constraints are written" {
  assert_eq(mixed(2u8, 1.5, [0.5]), 4u8);
  assert_eq(mixed(2.5m, 1u16, []), 2.5m)
}

test "a recursive call and a lambda read the type their caller passed" {
  assert_eq(deepened(250u8, 5), 255u8);
  assert_eq(deepened(0.5, 2), 2.5);
  assert_eq(deepened(0, 5000), 5000);
  assert_eq(scaled([1u32, 2u32], 3u32), [3u32, 6u32]);
  assert_eq(scaled([1.5m], 2m), [3.0m])
}
