//! `min` and `max` are over any ordered type, in `compare`'s order.

test "min and max order numbers, strings and structures" {
  assert_eq(min(3, 7), 3);
  assert_eq(max(3, 7), 7);
  assert_eq(min(200u8, 100u8), 100u8);
  assert_eq(max("pear", "apple"), "pear");
  assert_eq(min([1, 2], [1]), [1]);
  assert_eq(max(Some(1), None), Some(1))
}
