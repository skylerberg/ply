import std.math
import std.list

type Length = | Metres(Int) | Millimetres(Int)

key for Length by millimetres

numeric for Length by { add: plus, sub: minus, mul: times, neg: negated, of_int: metres }

fn millimetres(l: Length) -> Int = match l { Metres(n) -> n * 1000, Millimetres(n) -> n }

fn plus(a: Length, b: Length) -> Length = Millimetres(millimetres(a) + millimetres(b))

fn minus(a: Length, b: Length) -> Length = Millimetres(millimetres(a) - millimetres(b))

fn times(a: Length, b: Length) -> Length = Millimetres(millimetres(a) * millimetres(b) / 1000)

fn negated(a: Length) -> Length = Millimetres(0 - millimetres(a))

fn metres(n: Int) -> Length = Metres(n)

type Gaussian = | Gaussian(Int, Int)

numeric for Gaussian by { add: sum, sub: difference, mul: product, neg: opposite, of_int: gaussian_of_int }

fn sum(a: Gaussian, b: Gaussian) -> Gaussian =
  match ((a, b)) { (Gaussian(x, y), Gaussian(u, v)) -> Gaussian(x + u, y + v) }

fn difference(a: Gaussian, b: Gaussian) -> Gaussian =
  match ((a, b)) { (Gaussian(x, y), Gaussian(u, v)) -> Gaussian(x - u, y - v) }

fn product(a: Gaussian, b: Gaussian) -> Gaussian =
  match ((a, b)) { (Gaussian(x, y), Gaussian(u, v)) -> Gaussian(x * u - y * v, x * v + y * u) }

fn opposite(a: Gaussian) -> Gaussian = match a { Gaussian(x, y) -> Gaussian(0 - x, 0 - y) }

fn gaussian_of_int(n: Int) -> Gaussian = Gaussian(n, 0)

fn total<a>(xs: List<a>) -> a
  where numeric(a)
= xs.fold(numeric_of_int(0), |s: a, x: a| s + x)

fn scaled<a>(x: a, by: Int) -> a / {abort.raise}
  where numeric(a)
= x * numeric_of_int(by)

fn span(from: Length, to: Length) -> Length = to - from

test "the arithmetic operators call the functions that the type defines for them" {
  assert_eq(Metres(1) + Millimetres(5), Millimetres(1005));
  assert_eq(span(Millimetres(250), Metres(1)), Millimetres(750));
  assert_eq(Metres(2) * Metres(3), Metres(6));
  assert_eq(-Metres(2), Millimetres(0 - 2000));
  assert_eq(Gaussian(0, 1) * Gaussian(0, 1), Gaussian(0 - 1, 0));
  assert_eq(Gaussian(1, 2) + Gaussian(3, 4) - -Gaussian(1, 1), Gaussian(5, 7))
}

test "values in different units compare, order and digest by the quantity they represent" {
  assert(Metres(1) + Metres(1) == Millimetres(2000));
  assert_eq(digest(Metres(1) + Metres(1)), digest(Metres(2)));
  assert(Millimetres(999) < Metres(1) && Metres(1) <= Millimetres(1000));
  assert(Metres(1) > Millimetres(999) && Millimetres(1000) >= Metres(1));
  assert_eq(compare(Metres(1) - Metres(2), Metres(0)), Less)
}

test "a function over any numeric type accepts a user-defined numeric type and creates constants of it" {
  let none: List<Length> = [];
  assert_eq(total([Metres(1), Millimetres(500), Metres(2)]), Millimetres(3500));
  assert_eq(total(none), Metres(0));
  assert_eq(scaled(Millimetres(1500), 3), Millimetres(4500));
  assert_eq(List::sum([Metres(1), Metres(2)]), Metres(3));
  assert_eq(math::abs(Metres(1) - Metres(3)), Metres(2));
  assert_eq(math::sign(-Metres(1)), 0 - 1);
  assert_eq(math::clamp(Metres(5), Metres(0), Millimetres(1500)), Millimetres(1500))
}

test "a user-defined numeric type supports arithmetic inside lambdas, record fields and folds" {
  let lengths = [1, 2, 3].map(|n: Int| Metres(n) + Millimetres(n));
  assert_eq(lengths, [Millimetres(1001), Millimetres(2002), Millimetres(3003)]);
  let cut = { name: "a", length: Metres(2) };
  assert_eq({ ..cut, length: cut.length - Millimetres(1) }.length, Millimetres(1999));
  assert_eq(
    lengths.fold(Gaussian(0, 0), |g: Gaussian, l: Length| g + Gaussian(millimetres(l), 1)),
    Gaussian(6006, 3),
  )
}
