fn halves<a>(x: a) -> a / {abort.raise}
  where integer(a)
= x / numeric_of_int(2)

fn low_bits<a>(x: a, mask: a) -> a
  where integer(a)
= x & mask | x ^ x

fn remainder_by_two<a>(x: a) -> a / {abort.raise}
  where integer(a)
= x % numeric_of_int(2)

fn summed<a>(xs: List<a>) -> a
  where numeric(a)
= xs.fold(numeric_of_int(0), |s: a, x: a| s + x)

fn halved_sum<a>(xs: List<a>) -> a / {abort.raise}
  where integer(a)
= halves(summed(xs))

test "an integer parameter divides as its type does" {
  assert_eq(halves(7), 3);
  assert_eq(halves(255u8), 127u8);
  assert_eq(halves(I16::of_int(0 - 9)), I16::of_int(0 - 4));
  assert_eq(remainder_by_two(9u32), 1u32)
}

test "bit operators in an integer function use the type of its caller's argument" {
  assert_eq(low_bits(0xF5u8, 0x0Fu8), 0x05u8);
  assert_eq(low_bits(0x1234, 0xFF), 0x34)
}

test "an integer-constrained parameter can be passed to a function that requires a numeric type" {
  assert_eq(halved_sum([3u64, 5u64]), 4u64);
  assert_eq(halved_sum([1, 2, 3]), 3)
}
