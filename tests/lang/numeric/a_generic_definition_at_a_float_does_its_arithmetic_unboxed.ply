//! A generic definition called at a type its code does arithmetic on is compiled for that type: a
//! `Float` running total stays a `double`, and a record whose field holds the variable is read
//! where its layout puts it.

/// The total of `xs` after `acc`, one element at a time.
fn total<a>(xs: List<a>, acc: a, i: Int) -> a
  where numeric(a)
= match xs.at(i) { Some(x) -> total(xs, acc + x, i + 1), None -> acc }

fn floats(n: Int) -> List<Float> = range(0, n).map(|i: Int| Float::of_int(i) / 4.0)

test "summing floats or ints through a generic definition answers the total" {
  assert_eq(total(floats(4), 0.0, 0), 1.5);
  assert_eq(total([1, 2, 3], 0, 0), 6)
}

/// The left of a pair, whatever the pair holds.
fn left<a, b>(p: { l: a, r: b }) -> a = p.l

test "a field of a record whose type holds a variable reads the same at every type" {
  assert_eq(left({ l: { x: 1.5, y: 2.5 }, r: 3 }).x, 1.5);
  assert_eq(left({ l: "a", r: Some(1) }), "a");
  assert_eq(left({ l: 7, r: [1.0] }), 7)
}
