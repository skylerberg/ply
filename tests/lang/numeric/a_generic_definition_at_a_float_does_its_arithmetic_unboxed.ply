fn total<a>(xs: List<a>, accumulator: a, i: Int) -> a
  where numeric(a)
= match xs.at(i) { Some(x) -> total(xs, accumulator + x, i + 1), None -> accumulator }

fn floats(n: Int) -> List<Float> = range(0, n).map(|i: Int| Float::of_int(i) / 4.0)

test "summing floats or ints through a generic definition returns the total" {
  assert_eq(total(floats(4), 0.0, 0), 1.5);
  assert_eq(total([1, 2, 3], 0, 0), 6)
}

fn left<a, b>(p: { l: a, r: b }) -> a = p.l

test "reading a field whose type is a type variable returns that field's value whether it is a record of `Float`, a string or an `Int`" {
  assert_eq(left({ l: { x: 1.5, y: 2.5 }, r: 3 }).x, 1.5);
  assert_eq(left({ l: "a", r: Some(1) }), "a");
  assert_eq(left({ l: 7, r: [1.0] }), 7)
}
