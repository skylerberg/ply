type Length = | Metres(Int) | Millimetres(Int)

key for Length by millimetres

numeric for Length by { add: plus, sub: minus, mul: times, neg: negated, of_int: metres }

fn millimetres(l: Length) -> Int = match l { Metres(n) -> n * 1000, Millimetres(n) -> n }

fn plus(a: Length, b: Length) -> Length = Millimetres(millimetres(a) + millimetres(b))

fn minus(a: Length, b: Length) -> Length = Millimetres(millimetres(a) - millimetres(b))

fn times(a: Length, b: Length) -> Length = Millimetres(millimetres(a) * millimetres(b))

fn negated(a: Length) -> Length = Millimetres(0 - millimetres(a))

fn metres(n: Int) -> Length = Metres(n)

fn sums<a>(p: { x: a, y: a }) -> List<a>
  where numeric(a)
= [p.x + p.y, p.x - p.y, p.x * p.y]

fn opposite<a>(p: { x: a, y: a }) -> a
  where numeric(a)
= -p.x

fn orders<a>(p: { x: a, y: a }) -> List<Bool>
  where numeric(a)
= [p.x < p.y, p.x <= p.y, p.x > p.y, p.x >= p.y]

fn bits<a>(p: { x: a, y: a }) -> List<a> / {abort.raise}
  where integer(a)
= [p.x / p.y, p.x % p.y, p.x & p.y, p.x | p.y, p.x ^ p.y, p.x << 1, p.x >> 1, p.x >>> 1, ~p.x]

fn made<a>(p: { n: Int, zero: a }) -> a / {abort.raise}
  where numeric(a)
= numeric_of_int(p.n) + p.zero

test "arithmetic on record fields uses the type of the argument the caller passes" {
  assert_eq(sums({ x: 7, y: 2 }), [9, 5, 14]);
  assert_eq(sums({ x: 17u8, y: 15u8 }), [32u8, 2u8, 255u8]);
  assert_eq(sums({ x: -12i8, y: 10i8 }), [-2i8, -22i8, -120i8]);
  assert_eq(sums({ x: 4294967296u64, y: 4294967295u64 }), [
    8589934591u64,
    1u64,
    18446744069414584320u64,
  ]);
  assert_eq(sums({ x: 18446744073709551616u128, y: 3u128 }), [
    18446744073709551619u128,
    18446744073709551613u128,
    55340232221128654848u128,
  ]);
  assert_eq(sums({ x: 1.5, y: 0.25 }), [1.75, 1.25, 0.375]);
  assert_eq(sums({ x: 1.50m, y: 0.25m }), [1.75m, 1.25m, 0.375m]);
  assert_eq(sums({ x: Metres(1), y: Millimetres(5) }), [
    Millimetres(1005),
    Millimetres(995),
    Millimetres(5000),
  ]);
  assert_eq([opposite({ x: 127i8, y: 0i8 })], [-127i8]);
  assert_eq([opposite({ x: 1.5, y: 0.0 })], [-1.5]);
  assert_eq([opposite({ x: 2.5m, y: 0m })], [-2.5m]);
  assert_eq([opposite({ x: Metres(1), y: Metres(0) })], [Millimetres(-1000)])
}

test "comparison operators on record fields use the type of the argument the caller passes" {
  assert_eq(orders({ x: 3, y: 5 }), [true, true, false, false]);
  assert_eq(orders({ x: 200u8, y: 7u8 }), [false, false, true, true]);
  assert_eq(orders({ x: -1i128, y: 1i128 }), [true, true, false, false]);
  assert_eq(orders({ x: 1.50m, y: 1.5m }), [false, true, false, true]);
  assert_eq(orders({ x: Metres(1), y: Millimetres(1000) }), [false, true, false, true])
}

test "integer operators on record fields use the caller's integer width, and dividing by zero aborts" {
  assert_eq(bits({ x: 200u8, y: 7u8 }), [28u8, 4u8, 0u8, 207u8, 207u8, 144u8, 100u8, 100u8, 55u8]);
  assert_eq(bits({ x: -100i8, y: 7i8 }), [
    -14i8,
    -2i8,
    4i8,
    -97i8,
    -101i8,
    56i8,
    -50i8,
    78i8,
    99i8,
  ]);
  assert_eq(bits({ x: -6, y: 4 }), [-1, -2, 0, -2, -2, -12, -3, 9223372036854775805, 5]);
  assert_eq(bits({ x: 6u128, y: 4u128 }), [
    1u128,
    2u128,
    4u128,
    6u128,
    2u128,
    12u128,
    3u128,
    3u128,
    340282366920938463463374607431768211449u128,
  ]);
  assert(match try[abort.raise] { bits({ x: 1u16, y: 0u16 }) } { Ok(_) -> false, Err(_) -> true })
}

test "`numeric_of_int` creates a value of the caller's type and aborts when the number is outside its range" {
  assert_eq(made({ n: 5, zero: 0m }), 5m);
  assert_eq(made({ n: 5, zero: 0.0 }), 5.0);
  assert_eq(made({ n: -128, zero: 0i8 }), I8::of_int(-128));
  assert_eq(made({ n: 3, zero: Metres(0) }), Metres(3));
  assert(match try[abort.raise] { made({ n: 300, zero: 0u8 }) } { Ok(_) -> false, Err(_) -> true });
  assert(match try[abort.raise] { made({ n: -1, zero: 0u64 }) } { Ok(_) -> false, Err(_) -> true })
}
