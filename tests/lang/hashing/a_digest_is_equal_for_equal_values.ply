type Shape = | Circle(Int) | Dot

test "equal values have equal digests, however they were built" {
  assert_eq(digest(1.50m), digest(1.5m));
  assert_eq(digest(#{"a": 1, "b": 2}), digest(#{"b": 2}.insert("a", 1)));
  assert_eq(digest({ a: 1, b: "x" }), digest({ b: "x", a: 1 }));
  assert_eq(digest([Some(1), None]), digest([Some(1), None]));
  assert_eq(digest(()).len(), 32)
}

test "different values have different digests" {
  assert(digest(1) != digest(2));
  assert(digest("a") != digest(b"a"));
  assert(digest([1, 2]) != digest([2, 1]));
  assert(digest([1, 2]) != digest(Array::of_list([1, 2])));
  assert(digest(Circle(1)) != digest(Dot));
  assert(digest(Some(0)) != digest(None))
}
