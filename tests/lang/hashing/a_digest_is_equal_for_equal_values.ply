// `digest` is BLAKE3 over a canonical encoding of a value, so two values `==` calls equal have one
// digest, and `derive hash` makes a dictionary of it.

type Order = { id: Int, total: Decimal, tags: Map<String, Int> }

type Shape = | Circle(Int) | Dot

derive hash for Order
derive hash for Shape

test "equal values have equal digests, however they were built" {
  assert_eq(digest(1.50m), digest(1.5m));
  assert_eq(digest(#{"a": 1, "b": 2}), digest(map_insert(#{"b": 2}, "a", 1)));
  assert_eq(digest({ a: 1, b: "x" }), digest({ b: "x", a: 1 }));
  assert_eq(digest([Some(1), None]), digest([Some(1), None]));
  assert_eq(bytes_len(digest(())), 32)
}

test "different values have different digests" {
  assert(digest(1) != digest(2));
  assert(digest("a") != digest(b"a"));
  assert(digest([1, 2]) != digest([2, 1]));
  assert(digest([1, 2]) != digest(array_of_list([1, 2])));
  assert(digest(Circle(1)) != digest(Dot));
  assert(digest(Some(0)) != digest(None))
}

test "a derived dictionary hashes as digest does" {
  let o = { id: 7, total: 2.50m, tags: #{"x": 1} };
  assert_eq(order_hash().hash(o), digest(o));
  assert_eq(order_hash().hash(o), order_hash().hash({ ..o, total: 2.5m }));
  assert(shape_hash().hash(Circle(1)) != shape_hash().hash(Circle(2)))
}
