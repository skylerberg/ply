//! `digest` of a record or a sum is code written for its type, which hashes the bytes the runtime
//! hashed when it read the value by its shape: a record's fields in their names' order, a
//! constructor by the name its module declares and each argument at its own type, and a type that
//! states `key` by its key.

import std.radix

type Shape = | Circle(Int) | Rect({ w: Int, h: U8 }) | Group(List<Shape>) | Nothing

type Tree<a> = | Leaf(a) | Node(Tree<a>, Tree<a>)

type Money = | Money(Int, String)

key for Money by cents

fn cents(m: Money) -> Int = match m { Money(c, _) -> c }

type Point = new { x: Int, y: U8 }

fn hex(b: Bytes) -> String / {abort.raise} = radix::encode(radix::hex(), b)

fn hashed<a>(x: a) -> Bytes
  where derivable(hash, a)
= digest(x)

test "a record and a sum hash the bytes they always did" {
  let failed: Result<Int, Shape> = Err(Nothing);
  let p: Point = { x: 1, y: 2u8 };
  assert_eq(
    [
      hex(digest(Circle(2))),
      hex(digest(Rect({ w: 3, h: 4u8 }))),
      hex(digest(Group([Circle(1), Nothing]))),
      hex(digest(Node(Leaf("a"), Leaf("b")))),
      hex(digest(Some(Circle(5)))),
      hex(digest(failed)),
      hex(digest({ b: "x", a: 1 })),
      hex(digest(p)),
      hex(digest(Money(100, "usd"))),
      hex(digest({ m: Money(5, "a"), n: Nothing })),
    ],
    [
      "cc5b5e9a17b0f4ca5be9375a9b17dd82ef6f9cf27b42200223b536c1b09fe74d",
      "abc0ce290e0864bc7769b3676e1533657b253d1130f821493b0069cd07b02102",
      "03b61adae686c3f5da2d45e141f67ae72251c0b72944511580d2a7c09af576d2",
      "02aa3f12636964f31149e28fc3c6b79882bba0e56adadf39307e2fc7a52d9a55",
      "18a71cb3a1732677b285b2f90f718edb0f6ead230c26a0ef1cc49f71764187be",
      "7973b8efa31c9858b8881f7fab1feeaafb1612867616ac2fd80a36874acf9320",
      "8c27d42ea062eef52832a1e09dd3c5334c098cb6a4fa7f95bdbdb43d07ef0d35",
      "1041fcc29f3c4f5a57fd7ae10d737995eda3b2660575982a23f4289deff6b607",
      "ef73b45845f8f0336d91c315d4bf4d455af6c967a6d95661463594e548736b88",
      "67ed553af496d9285a78c1f6341077204c40f2f3c3e7366a61874c5c2566b0ef",
    ],
  )
}

test "values equal by their key hash alike, at any depth" {
  assert_eq(digest(Money(100, "usd")), digest(Money(100, "eur")));
  assert_eq(digest({ m: Money(5, "a") }), digest({ m: Money(5, "b") }));
  assert(digest(Money(1, "a")) != digest(Money(2, "a")))
}

test "a generic definition hashes its parameter as the type it is called at" {
  assert_eq(hashed(Circle(2)), digest(Circle(2)));
  assert_eq(hashed({ t: Leaf(Nothing) }), digest({ t: Leaf(Nothing) }));
  assert_eq(hashed(Money(1, "x")), hashed(Money(1, "y")))
}
