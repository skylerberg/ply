//! BLAKE3 over an input of sixty-four chunks, long enough that every loop of the hash comes round with
//! a record its compiled code may have held back, returns one digest each time it is asked.

import std.hash (blake3)

/// Every byte value in turn, `n` of them.
fn long(n: Int) -> Bytes / {abort.raise} =
  Bytes::concat_all(range(0, n).map(|i: Int| byte_of_int(i % 251)))

test "a long input hashes to a stable digest" {
  let input = long(65536);
  assert_eq(blake3(input), blake3(long(65536)));
  assert(blake3(input) != blake3(long(65535)))
}
