import std.hash (blake3)

fn long(n: Int) -> Bytes / {abort.raise} =
  Bytes::concat_all(range(0, n).map(|i: Int| byte_of_int(i % 251)))

test "a long input hashes to a stable digest" {
  let input = long(65536);
  assert_eq(blake3(input), blake3(long(65536)));
  assert(blake3(input) != blake3(long(65535)))
}
