import std.base64
import std.bigint
import std.duration
import std.time (minutes, plus, hours)
import std.uuid
import std.uuid (Uuid, uuid_render)
import tagged_literals.hexes as hex
import tagged_literals.hexes (Hex)

effect scale {
  raise beyond(nibbles: Int)
}

fn dns_namespace() -> Uuid = uuid"6ba7b810-9dad-11d1-80b4-00c04fd430c8"

fn beef() -> Hex / {} = hex"beef"

fn byte(h: Hex) -> Int / {scale.beyond} =
  match h.nibbles { [high, low] -> high * 16 + low, more -> scale.beyond(more.len()) }

test "a literal is the value its tag's parser returns" {
  assert_eq(uuid_render(dns_namespace()), "6ba7b810-9dad-11d1-80b4-00c04fd430c8");
  assert_eq(base64"aGVsbG8=", b"hello");
  assert_eq(
    bigint::to_string(bigint"340282366920938463463374607431768211456"),
    "340282366920938463463374607431768211456",
  );
  assert_eq(duration"1h30m", plus(hours(1), minutes(30)));
  assert_eq(beef().nibbles, [11, 14, 14, 15])
}

test "a tagged literal's value is the value inside the `Ok` that the tag's `literal` function returns" {
  assert_eq(uuid::literal("6ba7b810-9dad-11d1-80b4-00c04fd430c8"), Ok(dns_namespace()));
  assert_eq(hex::literal("00ff"), Ok(hex"00ff"))
}

test "a tagged literal's text has its string escapes decoded before the tag's parser receives it" {
  assert_eq(hex"\u{62}eef", beef());
  assert_eq(hex"", { nibbles: [] })
}

test "a literal stands wherever an expression does" {
  assert_eq(hex"0a".nibbles, [0, 10]);
  assert_eq([hex"1", hex"22"].map(|h: Hex| h.nibbles.len()), [1, 2]);
  let pick = |high: Bool| if high { hex"f" } else { hex"0" };
  assert_eq(pick(true).nibbles, [15]);
  assert_eq(uuid"00000000-0000-0000-0000-000000000000".octets.len(), 16)
}

test "a literal stands in a `try` body and in the clause that handles a raise" {
  assert_eq(try { byte(hex"ff") }, Ok(255));
  assert_eq(try { byte(hex"beef") }, Err(4));
  assert_eq(handle { byte(hex"beef") } with { scale.beyond(n) -> n + hex"0a".nibbles.len() }, 6)
}
