//! `tag"text"` is the call `tag::literal("text")`, which the check runs: the literal is the value
//! the call answers `Ok` of, and it performs nothing, since nothing is left for it to raise.

import std.base64
import std.bigint
import std.duration
import std.time (minutes, plus, hours)
import std.uuid
import std.uuid (Uuid, uuid_render)
import tagged_literals.hexes as hex
import tagged_literals.hexes (Hex)

effect scale {
  raise beyond(nibbles: Int)
}

fn dns() -> Uuid = uuid"6ba7b810-9dad-11d1-80b4-00c04fd430c8"

fn beef() -> Hex / {} = hex"beef"

fn byte(h: Hex) -> Int / {scale.beyond} =
  match h.nibbles { [high, low] -> high * 16 + low, more -> scale.beyond(len(more)) }

test "a literal is the value its tag's parser answers" {
  assert_eq(uuid_render(dns()), "6ba7b810-9dad-11d1-80b4-00c04fd430c8");
  assert_eq(base64"aGVsbG8=", b"hello");
  assert_eq(
    bigint::to_string(bigint"340282366920938463463374607431768211456"),
    "340282366920938463463374607431768211456",
  );
  assert_eq(duration"1h30m", plus(hours(1), minutes(30)));
  assert_eq(beef().nibbles, [11, 14, 14, 15])
}

test "a literal is the call it stands for, read through `Ok`" {
  assert_eq(uuid::literal("6ba7b810-9dad-11d1-80b4-00c04fd430c8"), Ok(dns()));
  assert_eq(hex::literal("00ff"), Ok(hex"00ff"))
}

test "a literal's text is a string's, its escapes read before its parser sees it" {
  assert_eq(hex"\u{62}eef", beef());
  assert_eq(hex"", { nibbles: [] })
}

test "a literal stands wherever an expression does" {
  assert_eq(hex"0a".nibbles, [0, 10]);
  assert_eq(map([hex"1", hex"22"], |h: Hex| len(h.nibbles)), [1, 2]);
  let pick = |high: Bool| if high { hex"f" } else { hex"0" };
  assert_eq(pick(true).nibbles, [15]);
  assert_eq(bytes_len(uuid"00000000-0000-0000-0000-000000000000".octets), 16)
}

test "a literal stands in a `try` body and in the clause that answers a raise" {
  assert_eq(try { byte(hex"ff") }, Ok(255));
  assert_eq(try { byte(hex"beef") }, Err(4));
  assert_eq(handle { byte(hex"beef") } with { scale.beyond(n) -> n + len(hex"0a".nibbles) }, 6)
}
