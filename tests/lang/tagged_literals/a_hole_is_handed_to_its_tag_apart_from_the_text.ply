import std.html
import std.html (Html, html, text, render, fragment)
import std.sh
import std.string
import tagged_literals.marks
import tagged_literals.marks (Mark)

effect prompts {
  read name() -> String
  raise missing_name(reason: String)
}

fn listing(dir: String) -> List<String> = sh"-l {dir}"

fn greeting() -> List<String> / {prompts.name} = sh"hello {prompts.name()}"

fn named(name: String) -> String / {prompts.missing_name} =
  if name == "" { prompts.missing_name("no name") } else { name }

fn first(names: List<String>) -> Option<List<String>> = Some(sh"-n {names.at(0)?}")

fn row(name: String, kind: String) -> Html / {html.unsafe_url, abort.raise} =
  html"<li class={text(kind)}>{text(name)}</li>"

fn page(title: String, names: List<String>) -> Html / {html.unsafe_url, abort.raise} =
  html"<title>{text(title)}</title><ul id='{text(title)}-list'>{fragment(names.map(|n: String| row(n, "name")))}</ul>"

test "a value interpolated into an `sh` literal is always one word, even with spaces or shell characters, and only the literal's own text is split into words" {
  assert_eq(listing("src"), ["-l", "src"]);
  assert_eq(listing("my dir; rm -rf /"), ["-l", "my dir; rm -rf /"]);
  assert_eq(listing(""), ["-l", ""]);
  assert_eq(sh"--to={"a b"}/{"*"} x", ["--to=a b/*", "x"])
}

test "an `html` literal escapes interpolated strings in text and in attributes, and leaves the literal's own markup unescaped" {
  assert_eq(
    render(row("<script>alert(1)</script>", "a\" onclick=\"x")),
    "<li class=\"a&quot; onclick=&quot;x\">&lt;script&gt;alert(1)&lt;/script&gt;</li>",
  );
  assert_eq(
    render(page("a & b", ["x", "<y>"])),
    "<title>a &amp; b</title><ul id='a &amp; b-list'><li class=\"name\">x</li><li class=\"name\">&lt;y&gt;</li></ul>",
  );
  assert_eq(render(html"<br>"), "<br>")
}

test "an `sh` literal with interpolated values gives the same words as calling `sh::compile` and then `sh::fill`" {
  let compiled: Result<sh::Words, sh::Error> = sh::compile(["-l ", ""]);
  assert_eq(match compiled { Ok(w) -> sh::fill(w, ["src"]), Err(_) -> [] }, listing("src"))
}

test "doubled braces in a tagged literal's text give single literal braces, and an interpolated value can be any expression" {
  assert_eq(sh"-e {{}} {{{"x"}}}", ["-e", "{}", "{x}"]);
  let n = 2;
  assert_eq(
    sh"{if n > 1 { "many" } else { "one" }} {f"n={n}"} {String::join(sh"a {"b"}", "+")}",
    ["many", "n=2", "a+b"],
  );
  assert_eq(sh"-n { { let m = n + 1; m.to_string() } }", ["-n", "3"])
}

test "an effect raised by an expression inside an `sh` literal is handled by the surrounding handler, and `?` there returns early from the function" {
  assert_eq(handle { greeting() } with { prompts.name() resume k -> k("you; rm") }, [
    "hello",
    "you; rm",
  ]);
  assert_eq(first(["a", "b"]), Some(["-n", "a"]));
  assert_eq(first([]), None)
}

test "a literal with holes stands in a `try` body and in the clause that handles a raise" {
  assert_eq(try { sh"-u {named("ann")}" }, Ok(["-u", "ann"]));
  assert_eq(try { sh"-u {named("")}" }, Err("no name"));
  assert_eq(
    handle { sh"-u {named("")}" } with { prompts.missing_name(reason) -> sh"-m {reason}" },
    ["-m", "no name"],
  )
}

test "a hole of a type its tag declares takes a record literal as that type" {
  let plain: Mark = { text: "b" };
  assert_eq(marks"a { { text: "x" } } {plain}", "a [x] [b]");
  assert_eq(marks"{plain}{plain}", "[b][b]")
}

test "word {String::join(sh"w {w}", "-")}" for w: String in sh"x {"y z"}" {
  assert(w == "x" || w == "y z")
}

fn flag(quiet: Bool) -> String = if quiet { "-q" } else { "-v" }

law schema held(word: String)
  forall (quiet: Bool) {
    sh"-n {word} {flag(quiet)}" == ["-n", word, flag(quiet)]
  }

law "a hole in a schema and in what instantiates one is filled as any other" =
  held(String::join(sh"a {"b c"}", "/"))
