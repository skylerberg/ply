//! `tag"text {hole} text"` is the call of `tag::fill` on what `tag::compile` answered the check for
//! the texts, and on the holes: the tag is handed each value apart from the text, so nothing a
//! hole holds is read as text.

import std.html
import std.html (Html, text, render, fragment)
import std.sh
import std.string (join)
import tagged_literals.marks
import tagged_literals.marks (Mark)

effect asked {
  read name() -> String
  raise nobody(why: String)
}

fn listing(dir: String) -> List<String> = sh"-l {dir}"

fn greeting() -> List<String> / {asked.name} = sh"hello {asked.name()}"

fn named(name: String) -> String / {asked.nobody} =
  if name == "" { asked.nobody("no name") } else { name }

fn first(names: List<String>) -> Option<List<String>> = Some(sh"-n {list_at(names, 0)?}")

fn row(name: String, kind: String) -> Html = html"<li class={text(kind)}>{text(name)}</li>"

fn page(title: String, names: List<String>) -> Html =
  html"<title>{text(title)}</title><ul id='{text(title)}-list'>{fragment(map(names, |n: String| row(n, "name")))}</ul>"

test "a hole is one word whatever it holds, and the text around it is the tag's to read" {
  assert_eq(listing("src"), ["-l", "src"]);
  assert_eq(listing("my dir; rm -rf /"), ["-l", "my dir; rm -rf /"]);
  assert_eq(listing(""), ["-l", ""]);
  assert_eq(sh"--to={"a b"}/{"*"} x", ["--to=a b/*", "x"])
}

test "a string in a hole of markup is characters wherever it stands, and markup is written once" {
  assert_eq(
    render(row("<script>alert(1)</script>", "a\" onclick=\"x")),
    "<li class=\"a&quot; onclick=&quot;x\">&lt;script&gt;alert(1)&lt;/script&gt;</li>",
  );
  assert_eq(
    render(page("a & b", ["x", "<y>"])),
    "<title>a &amp; b</title><ul id='a &amp; b-list'><li class=\"name\">x</li><li class=\"name\">&lt;y&gt;</li></ul>",
  );
  assert_eq(render(html"<br>"), "<br>")
}

test "a literal with holes is the call it stands for" {
  let compiled: Result<sh::Words, sh::Refusal> = sh::compile(["-l ", ""]);
  assert_eq(match compiled { Ok(w) -> sh::fill(w, ["src"]), Err(_) -> [] }, listing("src"))
}

test "a brace of the text is written twice, and a hole is any expression" {
  assert_eq(sh"-e {{}} {{{"x"}}}", ["-e", "{}", "{x}"]);
  let n = 2;
  assert_eq(sh"{if n > 1 { "many" } else { "one" }} {f"n={n}"} {join(sh"a {"b"}", "+")}", [
    "many",
    "n=2",
    "a+b",
  ]);
  assert_eq(sh"-n { { let m = n + 1; int_to_string(m) } }", ["-n", "3"])
}

test "a literal performs what its holes perform, and a `?` in one leaves the function" {
  assert_eq(handle { greeting() } with { asked.name() resume k -> k("you; rm") }, [
    "hello",
    "you; rm",
  ]);
  assert_eq(first(["a", "b"]), Some(["-n", "a"]));
  assert_eq(first([]), None)
}

test "a literal with holes stands in a `try` body and in the clause that answers a raise" {
  assert_eq(try { sh"-u {named("ann")}" }, Ok(["-u", "ann"]));
  assert_eq(try { sh"-u {named("")}" }, Err("no name"));
  assert_eq(handle { sh"-u {named("")}" } with { asked.nobody(why) -> sh"-m {why}" }, [
    "-m",
    "no name",
  ])
}

test "a hole of a type its tag declares takes a record literal as that type" {
  let plain: Mark = { text: "b" };
  assert_eq(marks"a { { text: "x" } } {plain}", "a [x] [b]");
  assert_eq(marks"{plain}{plain}", "[b][b]")
}

test "word {join(sh"w {w}", "-")}" for w: String in sh"x {"y z"}" { assert(w == "x" || w == "y z") }

law schema held(word: String)
  forall (n: Int) where n >= 0 {
    sh"-n {word} {int_to_string(n)}" == ["-n", word, int_to_string(n)]
  }

law "a hole in a schema and in what instantiates one is filled as any other" =
  held(join(sh"a {"b c"}", "/"))
