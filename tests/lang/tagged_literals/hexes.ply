//! A tag this package declares: bound as `hex`, the module is what `hex"..."` is checked by. Its
//! value is a record of its own, which the parser builds where one is expected.

pub type Hex = new { nibbles: List<Int> }

pub type Rejection = { message: String, offset: Int }

pub fn literal(text: String) -> Result<Hex, Rejection> / {abort.raise} =
  range(0, text.len()).fold(Ok({ nibbles: [] }), |read: Result<Hex, Rejection>, i: Int|
    match read {
      Err(_) -> read,
      Ok(hex) -> {
        let digit = text.slice(i, i + 1);
        if digits().contains(digit) { Ok({ nibbles: hex.nibbles.push(digits().find(digit)) }) }
        else { Err({ message: "not a hex digit", offset: i }) }
      },
    })

fn digits() -> String = "0123456789abcdef"

test "the parser returns the nibbles, or the first character that is not one" {
  assert_eq(literal("0f"), Ok({ nibbles: [0, 15] }));
  assert_eq(literal("0g"), Err({ message: "not a hex digit", offset: 1 }))
}
