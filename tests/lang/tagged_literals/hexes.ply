//! A tag this corpus declares: bound as `hex`, the module is what `hex"..."` is checked by. Its
//! value is a record of its own, which the parser builds where one is expected.

pub type Hex = new { nibbles: List<Int> }

pub type Refusal = { message: String, offset: Int }

pub fn literal(text: String) -> Result<Hex, Refusal> / {abort.raise} =
  fold(range(0, string_len(text)), Ok({ nibbles: [] }), |read: Result<Hex, Refusal>, i: Int|
    match read {
      Err(_) -> read,
      Ok(hex) -> {
        let digit = string_slice(text, i, i + 1);
        if string_contains(digits(), digit) {
          Ok({ nibbles: push(hex.nibbles, string_find(digits(), digit)) })
        } else { Err({ message: "not a hex digit", offset: i }) }
      },
    })

fn digits() -> String = "0123456789abcdef"

test "the parser answers the nibbles, or the first character that is not one" {
  assert_eq(literal("0f"), Ok({ nibbles: [0, 15] }));
  assert_eq(literal("0g"), Err({ message: "not a hex digit", offset: 1 }))
}
