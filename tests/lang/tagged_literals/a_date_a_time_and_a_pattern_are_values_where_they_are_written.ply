//! `std.date`'s five tags, one for each of its types that has a text: a date, a time of day, a
//! date-time, an instant at an offset and a `strftime` pattern are each the value their text names.

import std.date
import std.date (Date, OffsetDateTime, Sunday)
import std.datetime
import std.strftime
import std.timeofday
import std.timestamp

fn launch() -> OffsetDateTime = timestamp"2026-10-04T14:30:00+02:00"

fn due() -> Date = date"2026-10-04"

test "each tag's literal is the value its module's functions make" {
  assert_eq(Some(due()), date::of(2026, 10, 4));
  assert_eq(Some(timeofday"12:30:00.5"), date::time(12, 30, 0, 500000000));
  assert_eq(Some(datetime"2026-10-04T12:30:00"), date::date_time(2026, 10, 4, 12, 30, 0));
  assert_eq(date::unix_seconds(launch()), 1791117000);
  assert_eq(date::offset_minutes(launch()), 120)
}

test "a literal stands wherever an expression does, and is shown as it was written" {
  assert_eq(date::weekday(date"2026-10-04"), Sunday);
  assert_eq(date::days_between(date"2026-01-01", due()), 276);
  assert_eq(f"{due()} at {timeofday"09:00:00"}", "2026-10-04 at 09:00:00");
  assert_eq(f"{launch()}", "2026-10-04T14:30:00+02:00");
  assert_eq(compare(timestamp"2026-10-04T12:29:59Z", launch()), Less)
}

test "a pattern literal is one the formatters and the reader go by" {
  assert_eq(
    date::format(strftime"%A, %-d %B %Y at %H:%M %:z", launch()),
    "Sunday, 4 October 2026 at 14:30 +02:00",
  );
  assert_eq(date::format_date(strftime"%d/%m/%y", due()), Some("04/10/26"));
  assert_eq(
    date::parse_with(strftime"%d/%m/%Y", "04/10/2026"),
    Some({ date: Some(due()), time: None, offset: None }),
  )
}
