//! `std.mime`'s tag: a media type written in the source is the value its text names, checked with
//! the program.

import std.mime
import std.mime (MediaType)

fn page() -> MediaType = mime"text/html; charset=utf-8"

test "the literal is the media type its module's functions read" {
  assert_eq(Ok(page()), mime::parse("Text/HTML;Charset=\"utf-8\""));
  assert_eq(mime::essence(page()), "text/html");
  assert_eq(mime::charset(page()), Some("utf-8"));
  assert_eq(mime::extension(mime"image/jpeg"), Some("jpg"))
}

test "a literal stands wherever an expression does, a range among them, and is shown as written" {
  assert(mime::matches(mime"text/*", page()));
  assert(!mime::matches(mime"image/*", page()));
  assert_eq(mime::quality(mime"text/*;q=0.5"), Some(500));
  assert_eq(
    f"{mime"multipart/form-data; boundary=\"a b\""}",
    "multipart/form-data; boundary=\"a b\"",
  );
  assert_eq(mime::of_path("index.html"), Some(mime"text/html"))
}
