import std.bigint
import std.bigint (BigInt)
import std.sh

fn counted(a: BigInt, b: BigInt) -> List<String> / {abort.raise} =
  sh"-n {bigint::to_string(a + b)} --twice={bigint::to_string((a + b) * bigint"2")}"

test "an operator inside an interpolated expression uses the arithmetic of its operands' type, such as `bigint`" {
  let big = bigint"18446744073709551616";
  assert_eq(counted(big, bigint"1"), [
    "-n",
    "18446744073709551617",
    "--twice=36893488147419103234",
  ]);
  assert_eq(sh"{bigint::to_string(-big - big)}", ["-36893488147419103232"]);
  assert_eq(sh"is {if big * big > big { "more" } else { "less" }}", ["is", "more"])
}
