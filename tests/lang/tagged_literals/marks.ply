//! A tag whose holes are a type of its own: bound as `marks`, a literal is its text with each hole
//! in brackets, and a hole is a `Mark`, which a record literal written in one is read as.

import std.list

pub type Mark = new { text: String }

pub type Rejection = { message: String, offset: Int, part: Int }

pub fn compile(parts: List<String>) -> Result<List<String>, Rejection> = Ok(parts)

pub fn fill(parts: List<String>, holes: List<Mark>) -> String =
  range(0, parts.len()).fold("", |out: String, i: Int|
    out ++ parts.at_or(i, "")
      ++ (match holes.at(i) { Some(mark) -> "[" ++ mark.text ++ "]", None -> "" }))

test "each hole is written in brackets where it stood" {
  assert_eq(fill(["a ", " b"], [{ text: "x" }]), "a [x] b");
  assert_eq(compile(["a ", " b"]), Ok(["a ", " b"]))
}
