import std.fs (fs)

// No run of this suite binds the root `cwd`, so the host could not serve the read.
test "a clause around a host operation handles it" {
  let read = handle {
    fs.read_file[cwd]("absent")
  } with {
    fs.read_file[cwd](p) -> Some(b"double"),
  };
  assert_eq(read, Some(b"double"))
}
