import spawning.harness (write_program, spawned, start_streaming, next_line, signal_to,
                         wait_for_exit, all_output, stdout, RunResult, Server, PlyProcess)
import std.fs (fs)
import std.list
import std.process (Kill)
import std.string

const source: String =
  \\import std.key_value
  \\import std.key_value (key_value, Limits, Manual, Operation, Put, Store, Error, Locked)
  \\import std.bytes
  \\import std.fs (fs, Durable, Fast)
  \\import std.process (process)
  \\import std.random (entropy)
  \\
  \\fn limits() -> Limits = { key: 64, value: 8192, batch: 65536, file: 65536 }
  \\
  \\fn name(i: Int, side: String) -> Bytes = Bytes::of_string("batch-" ++ i.to_string() ++ "-" ++ side)
  \\
  \\fn body(i: Int) -> Bytes / {abort.raise} = byte_of_int(97 + i % 26).repeat(4096)
  \\
  \\fn pair_of(i: Int) -> List<Operation> / {abort.raise} =
  \\  [Put(name(i, "a"), body(i)), Put(name(i, "b"), body(i))]
  \\
  \\fn whole(s: Store) -> Bool / {fs.read[data], key_value.fail, abort.raise} = {
  \\  let snap = key_value::snapshot(s);
  \\  let batches = key_value::stats(s).sequence;
  \\  key_value::count(snap) == 2 * batches
  \\    && range(1, batches + 1).fold(true, |so_far: Bool, i: Int|
  \\      so_far && key_value::read[data](snap, name(i, "a")) == Some(body(i))
  \\        && key_value::read[data](snap, name(i, "b")) == Some(body(i)))
  \\}
  \\
  \\fn run(mode: String) -> Unit / {fs.read[data], fs.write[data], process.write[proc], entropy.next, key_value.fail, abort.raise} =
  \\  with_scope[store](
  \\    key_value::open[data]("db", limits(), Manual, key_value::raw(), 1),
  \\    |s: Store| key_value::close[data](s),
  \\  ) { opened -> {
  \\    let s = opened.get();
  \\    let from = key_value::stats(s).sequence;
  \\    if mode == "write" {
  \\      iterate({ store: s, i: from + 1 }, 1000000, |at: { store: Store, i: Int }| {
  \\        let next = key_value::batch[data](at.store, pair_of(at.i), if at.i % 2 == 0 { Durable } else { Fast });
  \\        process.out[proc]("committed " ++ at.i.to_string());
  \\        if at.i >= 999999 { Stop(()) } else { Continue({ store: next, i: at.i + 1 }) }
  \\      })
  \\    } else {
  \\      process.out[proc]("opened " ++ from.to_string() ++ (if whole(s) { " whole" } else { " torn" }))
  \\    }
  \\  } }
  \\
  \\fn main() -> Unit / {fs.read[data], fs.write[data], process.read[proc], process.write[proc], entropy.next, abort.raise} = {
  \\  let mode = match process.args[proc]().at(0) { Some(m) -> m, None -> "ask" };
  \\  let ran: Result<Unit, Error> = try[key_value.fail] { run(mode) };
  \\  match ran {
  \\    Ok(_) -> process.out[proc]("closed"),
  \\    Err(Locked) -> process.out[proc]("rejected: locked"),
  \\    Err(_) -> process.out[proc]("refused"),
  \\  }
  \\}
  \\

fn run(args: List<String>) -> List<String> = ["run", "m.ply", "--fs", "data=.", "--"].concat(args)

fn next_line_with_prefix(
  server: Server,
  prefix: String,
) -> String / {PlyProcess, abort.raise, diverges} =
  match next_line(server, 300000) {
    Some(line) -> if line.starts_with(prefix) { line.slice(prefix.len(), line.len()) }
    else { next_line_with_prefix(server, prefix) },
    None ->
      panic(
        "the process ended, or wrote nothing in five minutes, before a line beginning `" ++ prefix
          ++ "`",
      ),
  }

fn ask_once() -> RunResult / {PlyProcess, abort.raise} = spawned(run(["ask"]), [])

fn opened(ran: RunResult) -> Option<{ batches: Int, whole: Bool }> / {abort.raise} =
  ran.out.fold(None, |found: Option<{ batches: Int, whole: Bool }>, line: String|
    match line.trim().split(" ") {
      ["opened", count, state] -> match count.int_of_string() {
        Some(batches) -> Some({ batches: batches, whole: state == "whole" }),
        None -> found,
      },
      _ -> found,
    })

fn last_committed(writer: Server, so_far: Int) -> Int / {PlyProcess, abort.raise, diverges} =
  match next_line(writer, 2000) {
    None -> so_far,
    Some(line) ->
      last_committed(writer, if line.starts_with("committed ") {
        match line.slice(10, line.len()).int_of_string() { Some(i) -> i, None -> so_far }
      } else { so_far }),
  }

test/nondet "after a killed writer's lock file is made old, the store opens with every batch the writer printed as committed, and no partial batch" {
  write_program(source);
  let writer = start_streaming(run(["write"]), []);
  assert_eq(next_line_with_prefix(writer, "committed 40"), "");
  signal_to(writer, Kill);
  let said_last = last_committed(writer, 40);
  let _ = wait_for_exit(writer, 60000, "the writer was still running a minute after it was killed");
  let early = ask_once();
  assert(stdout(early).contains("rejected: locked"), Some(all_output(early)));
  assert(fs.set_modified[cwd]("db/lock", 0), Some("the dead writer left no lock to age"));
  let after = ask_once();
  let found = match opened(after) {
    Some(opened_store) -> opened_store,
    None -> panic(all_output(after)),
  };
  assert(found.whole, Some(all_output(after)));
  assert(
    found.batches >= said_last && found.batches <= said_last + 1,
    Some(
      "the writer said it had committed " ++ said_last.to_string() ++ " and the store opened to "
        ++ found.batches.to_string(),
    ),
  );
  assert_eq(opened(ask_once()), Some(found))
}
