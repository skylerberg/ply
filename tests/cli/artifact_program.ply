import spawning.harness (write_project, spawned, json_of, json_text)
import std.string

test/nondet "a program may import the formatter from the shipped modules" {
  write_project([
    {
      path: "app.ply",
      text: String::of_bytes_lossy(embed("../programs/artifact_program/formatter_import.ply")),
    },
  ]);
  let r = spawned(["check", ".", "--json"]);
  assert(r.code == 0, Some(json_text(json_of(r))))
}
