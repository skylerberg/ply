// What a test performed is counted, so a measurement can price the operations a suite makes.
test/nondet "each result counts the operations its test performed" {
  write_program(String::of_bytes_lossy(embed("../programs/test_runs/operation_counts.ply")));
  let v = test_report(["--no-cache"]);
  let performs = |name: String|
    match at(result_of(v, name), "performs") {
      Number(d) -> match Int::of_decimal(d, Down) { Some(n) -> n, None -> -1 },
      _ -> panic("`" ++ name ++ "` carries no count: " ++ json_text(v)),
    };
  assert(performs("pure") == 0, Some(json_text(v)));
  assert(performs("ticks") == 2, Some(json_text(v)))
}

// Nine bumps and a peek, each counted once whatever its clause does, and none past a clause that
// stops the body at the third bump.
test/nondet "a result counts each perform a handle handles once, whether its clause returns, resumes or stops" {
  write_program(String::of_bytes_lossy(embed("../programs/test_runs/handled_perform_counts.ply")));
  let v = test_report(["--no-cache"]);
  let performs = |name: String|
    match at(result_of(v, name), "performs") {
      Number(d) -> match Int::of_decimal(d, Down) { Some(n) -> n, None -> -1 },
      _ -> panic("`" ++ name ++ "` carries no count: " ++ json_text(v)),
    };
  assert(
    [performs("handled"), performs("resumed"), performs("stopped")] == [10, 10, 3],
    Some(json_text(v)),
  )
}

test/nondet "filter narrows both the run and the denominator" {
