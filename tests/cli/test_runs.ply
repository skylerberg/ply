  assert(text.contains("--filter hid 1 test"), Some(text));
  assert(text.contains("double of zero is zero"), Some(text));
  assert(!text.contains("double doubles"), Some("the filtered-out test still ran:\n" ++ text))
}

test/nondet "a filter matching nothing says so rather than claiming success quietly" {
  write_program(green());
  let r = spawned(["test", ".", "--filter", "nonexistent"]);
  assert(r.code == 0, Some(all_output(r)));
  assert(stdout(r).contains("selected 0 of 0"), Some(stdout(r)));
  assert(stdout(r).contains("no test key contains a `--filter` substring"), Some(stdout(r)))
}

test/nondet "jobs is honoured and reported" {
  write_program(green());
  let r = spawned(["test", ".", "--jobs", "1"]);
  assert(r.code == 0, Some(all_output(r)));
  assert(stdout(r).contains("1 worker"), Some(stdout(r)));
  write_program(green());
  let v = test_report(["-j", "3"]);
  assert(int(at(v, "workers")) == 3, Some(json_text(v)))
}

test/nondet "isolated tests run at the same time, and each runs its own parallel blocks in order" {
  write_program(String::of_bytes_lossy(embed("../programs/test_runs/spinning.ply")));
  let v = test_report(["--no-cache"]);
  let summed = items(at(v, "results")).fold(0, |n: Int, r: Json| n + int(at(r, "duration_ms")));
  assert(summed > 3 * int(path(v, ["phases", "tests"])) / 2, Some(json_text(v)))
}

test/nondet "each phase prints as it starts, and each test prints as it finishes" {
  write_program(String::of_bytes_lossy(embed("../programs/test_runs/finishing_order.ply")));
  let text = stderr(spawned(["test", ".", "--json", "--no-cache", "--jobs", "2"]));
  let position = |s: String|
    match Bytes::of_string(text).index_of(Bytes::of_string(s)) {
      Some(at) -> at,
      None -> panic("the run did not print `" ++ s ++ "`:\n" ++ text),
    };
  assert(position("checking the program") < position("building the tests"), Some(text));
  assert(position("building the tests") < position("compiling the tests"), Some(text));
  assert(position("compiling the tests") < position("a quick test"), Some(text));
  assert(position("a quick test") < position("a slow test"), Some(text))
}

test/nondet "explain reports a reason per test and effects per group" {
  write_program(green());
  assert(spawned(["test", "."]).code == 0, None);
  let text = stdout(spawned(["test", ".", "--explain"]));
  assert(text.contains("skip"), Some("cached tests must be shown as skipped:\n" ++ text));
  assert(text.contains("cached"), Some(text));
  assert(text.contains("this exact hash already passed"), Some(text));
  assert(text.contains("concurrency groups") || text.contains("selected 0 of 2"), Some(text));
  write_program(green());
  let cold = stdout(spawned(["test", ".", "--explain"]));
  assert(cold.contains("run "), Some(cold));
  assert(cold.contains("concurrency groups"), Some(cold));
  assert(cold.contains("group 0 ·"), Some(cold));
  assert(cold.contains("· {}"), Some("the group's defining effects are missing:\n" ++ cold));
  assert(cold.contains("isolation: isolated"), Some(cold));
  assert(cold.contains("isolated and free"), Some(cold))
}

test/nondet "a run reports how many tests cannot disturb another" {
  write_program(green());
  let text = stdout(spawned(["test", "."]));
  assert(text.contains("isolated 2 of 2"), Some(text));
  // Neither writing test can pass, but the schedule is still about them, which is what is
  // asserted: only a `nondet` effect names what another test could reach.
  write_program(
    \\nondet effect db {
    \\  write put[t](v: Int) -> Unit
    \\}
    \\effect memo {
    \\  write keep[t](v: Int) -> Unit
    \\}
    \\fn store(v: Int) -> Int / {db.write[users]} = { db.put[users](v); v }
    \\fn kept(v: Int) -> Int / {memo.write[users]} = { memo.keep[users](v); v }
    \\test/nondet "writes" { assert_eq(store(1), 1) }
    \\test "keeps" { assert_eq(kept(1), 1) }
    \\test "pure" { assert_eq(1, 1) }
    \\
  );
  let v = test_report([]);
  assert(int(path(v, ["selection", "isolated"])) == 2, Some(json_text(v)));
  assert(int(path(v, ["selection", "parallelism", "total"])) == 3, Some(json_text(v)));
  assert(int(path(v, ["selection", "parallelism", "shared"])) == 1, Some(json_text(v)));
  let writes = selected_test(v, "writes");
  assert(str(at(writes, "isolation")) == "shared", Some(json_text(writes)));
  assert(str(nth(at(writes, "shared_effects"), 0)) == "m.db.write[users]", Some(json_text(writes)));
  ["keeps", "pure"].fold((), |u: Unit, name: String| {
    let free = selected_test(v, name);
    assert(str(at(free, "isolation")) == "isolated", Some(json_text(free)));
    assert(items(at(free, "shared_effects")) == [], Some(json_text(free)))
  })
}

/// Whether the isolated, shared and host buckets of a run's selection partition its tests.
fn selection_adds_up(v: Json) -> Bool = {
  let s = at(v, "selection");
  int(at(s, "isolated")) + int(at(s, "shared")) + int(at(s, "host")) == int(at(s, "total"))
}

test/nondet "a suite no test of which reaches the host prints no binding and reports one it reached nothing of" {
  write_program(green());
  let v = test_report([]);
  assert(int(path(v, ["hosts", "operations"])) == 0, Some(json_text(v)));
  assert(str(path(v, ["hosts", "digest"])).starts_with("b3:"), Some(json_text(v)));
  assert(int(path(v, ["selection", "host"])) == 0, Some(json_text(v)));
  assert(selection_adds_up(v), Some(json_text(v)));
  items(path(v, ["selection", "tests"])).fold((), |u: Unit, t: Json| {
    assert(at(t, "host") == json::Bool(false), Some(json_text(t)));
    assert(str(at(t, "isolation")) != "host", Some(json_text(t)))
  });
  let text = stdout(spawned(["test", ".", "--no-cache"]));
  assert(!text.contains("binding host"), Some(text))
}

test/nondet "a suite whose tests reach the host says so in the summary a person reads" {
  write_program(
    \\import std.fs (fs)
    \\
    \\test/nondet "reads its data" { assert(fs.read_file[cwd]("data.txt") != None) }
    \\
    \\test "adds" { assert_eq(1 + 1, 2) }
    \\
  );
  write("data.txt", "one");
  let v = test_report(["--no-cache", "--fs", "cwd=."]);
  assert(bool(at(v, "ok")), Some(json_text(v)));
  assert(int(path(v, ["selection", "host"])) == 1, Some(json_text(v)));
  assert(selection_adds_up(v), Some(json_text(v)));
  let bound = spawned(["test", ".", "--no-cache", "--fs", "cwd=."]);
  assert(bound.code == 0, Some(all_output(bound)));
  assert(stdout(bound).contains("host 1 of 2"), Some(stdout(bound)));
  assert(stdout(bound).contains("cached by what each read"), Some(stdout(bound)));
  assert(stdout(bound).contains("binding host"), Some(stdout(bound)))
}

// If a binding moved a hash, the effects or an E0412 verdict, every cache would split on a flag.
test/nondet "a binding changes nothing the front end computes" {
  write_program(green());
  assert(
    stdout(spawned(["hash", ".", "--json"])) == stdout(spawned(["hash", ".", "--json"])),
    None,
  );
  let bare = test_report(["--no-cache"]);
  let bound = test_report(["--no-cache", "--exec", "echo=/bin/echo", "--fs", "cwd=."]);
  let hashes = |v: Json| items(path(v, ["selection", "tests"])).map(|t: Json| at(t, "hash"));
  assert(hashes(bare) == hashes(bound), None);
  assert(path(bare, ["selection", "total"]) == path(bound, ["selection", "total"]), None)
}

// A test is no process: it may start and drive the programs `--exec` names, and nothing else of
// `process`.
test/nondet "a test run binds what --exec names and withholds the rest of process" {
  write_program(
    \\import std.process (process, Discard, Keep)
    \\
    \\fn echoed() -> Bytes / {process.spawn[echo]} = process.spawn[echo](["hi"], "", []).out
    \\
    \\fn started() -> Option<Bytes> / {process.start[echo], process.wait[echo]} =
    \\  match process.start[echo](["hi"], "", [], { input: false, out: Keep, err: Discard }) {
    \\    Err(_) -> None,
    \\    Ok(child) -> match process.wait[echo](child, 0 - 1) { Some(f) -> Some(f.out), None -> None },
    \\  }
    \\
    \\fn said() -> Unit / {process.out[proc]} = process.out[proc]("hi")
    \\
    \\test/nondet "spawns echo" { assert_eq(echoed(), b"hi\n") }
    \\
    \\test/nondet "starts echo and waits for it" { assert_eq(started(), Some(b"hi\n")) }
    \\
    \\test/nondet "writes a line" { said() }
    \\
  );
  let v = test_report(["--exec", "echo=/bin/echo"]);
  assert(status_of(v, "spawns echo") == "passed", Some(json_text(v)));
  assert(status_of(v, "starts echo and waits for it") == "passed", Some(json_text(v)));
  assert(status_of(v, "writes a line") == "failed", Some(json_text(v)));
  assert(
    str(path(nth(at(v, "failures"), 0), ["diagnostic", "code"])) == "E0424",
    Some(json_text(v)),
  );
  // Without `--exec`, the label is unbound, and the error says how to bind it.
  let bare = stdout(spawned(["test", ".", "--filter", "spawns"]));
  assert(bare.contains("no executable is bound to it"), Some(bare));
  assert(bare.contains("--exec echo="), Some(bare))
}

// A test asks which labels its run bound, and an unbound one is reported rather than withheld.
test/nondet "a test asks which labels its run bound" {
  write_program(
    \\import std.process (process)
    \\
    \\fn echo_bound() -> Bool / {process.bound[echo]} = process.bound[echo]()
    \\
    \\fn cc_bound() -> Bool / {process.bound[cc]} = process.bound[cc]()
    \\
    \\test/nondet "echo is bound" { assert(echo_bound()) }
    \\
    \\test/nondet "cc is not bound" { assert(!cc_bound()) }
    \\
  );
  let granted = test_report(["--exec", "echo=/bin/echo"]);
  assert(status_of(granted, "echo is bound") == "passed", Some(json_text(granted)));
  assert(status_of(granted, "cc is not bound") == "passed", Some(json_text(granted)));
  let bare = test_report(["--no-cache"]);
  assert(status_of(bare, "echo is bound") == "failed", Some(json_text(bare)));
  assert(status_of(bare, "cc is not bound") == "passed", Some(json_text(bare)));
  assert(
    str(path(nth(at(bare, "failures"), 0), ["diagnostic", "code"])) != "E0424",
    Some(json_text(bare)),
  )
}

test/nondet "a family the program does not declare is rejected to a test run" {
  write_program(green());
  let r = spawned(["test", ".", "--json", "--allow", "machine"]);
  assert(r.code == 2, Some(all_output(r)));
  assert(code_of(json_of(r)) == "E0459", Some(all_output(r)))
}

// Ten simulated minutes cost a run no wall clock worth the name: a wait would take them all.
test/nondet "a simulated sleep is a jump rather than a wait" {
  write_program(String::of_bytes_lossy(embed("../programs/test_runs/simulated_sleep.ply")));
  let started = time.elapsed_ms();
  let r = spawned(["test", ".", "--no-cache"]);
  let took = time.elapsed_ms() - started;
  assert(r.code == 0, Some(all_output(r)));
  assert(
    took < 120000,
    Some("ten simulated minutes took " ++ took.to_string() ++ "ms of wall clock"),
  )
}

test/nondet "the search plan is published so two runs can be compared" {
  write_program(green());
  let sim = path(test_report([]), ["options", "sim"]);
  assert(str(at(sim, "mode")) == "dpor", Some(json_text(sim)));
  assert(int(at(sim, "seeds")) == 1, Some(json_text(sim)));
  assert(at(sim, "seed") == Null, Some(json_text(sim)));
  assert(at(sim, "measure_reduction") == json::Bool(false), Some(json_text(sim)));
  assert(is_number(at(sim, "budget")), Some(json_text(sim)));
  assert(is_number(at(sim, "steps")), Some(json_text(sim)));
  let random = path(test_report(["--sim", "random", "--seeds", "8"]), ["options", "sim"]);
  assert(str(at(random, "mode")) == "random", Some(json_text(random)));
  assert(int(at(random, "seeds")) == 8, Some(json_text(random)));
  assert(int(at(random, "budget")) == 1, Some(json_text(random)))
}

/// The parent reads what each task wrote only after joining it: the join orders each read after its
/// write, and only the steps' clocks tell the search so.
fn joined() -> String = String::of_bytes_lossy(embed("../programs/test_runs/joined.ply"))

test/nondet "a measured reduction reports a clock-blind search that ran no fewer than the pruned one" {
  write_program(joined());
  let v = test_report(["--no-cache", "--measure-reduction"]);
  assert(int(path(v, ["summary", "passed"])) == 1, Some(json_text(v)));
  let search = at(nth(at(v, "results"), 0), "simulation");
  let pruned = int(at(search, "explored"));
  assert(pruned >= 0, Some("a pruned count: " ++ json_text(v)));
  assert(path(search, ["blind", "bounded"]) == json::Bool(false), Some(json_text(v)));
  let blind = int(path(search, ["blind", "explored"]));
  assert(
    blind >= pruned,
    Some(
      blind.to_string() ++ " interleavings without the clocks against " ++ pruned.to_string()
        ++ " with them: "
        ++ json_text(v),
    ),
  );
  assert(int(path(search, ["naive", "explored"])) >= 0, Some(json_text(v)));
  let text = stdout(spawned(["test", ".", "--no-cache", "--measure-reduction"]));
  assert(text.contains(" · blind " ++ blind.to_string() ++ " · naive "), Some(text));
  let unmeasured = at(nth(at(test_report(["--no-cache"]), "results"), 0), "simulation");
  assert(
    at(unmeasured, "blind") == Null && at(unmeasured, "naive") == Null,
    Some(json_text(unmeasured)),
  )
}

/// A `random` search files a pass under each root it ran as well as under the whole plan, so a
/// narrower plan whose every root already passed on its own is resolved without searching again.
fn sleeping_task_program() -> String =
  \\test "a sleeper costs no wall clock" {
  \\  simulate {
  \\    let t = task.spawn(|| { clock.sleep(Duration(30000000000)); clock.now() });
  \\    assert_eq(task.join(t), Instant(30000000000))
  \\  }
  \\}
  \\

test/nondet "a seeded test whose every root passed alone is cached under a narrower plan" {
  write_program(sleeping_task_program());
  let wide = test_report(["--sim", "random", "--seeds", "8"]);
  assert(int(path(wide, ["summary", "passed"])) == 1, Some(json_text(wide)));
  assert(
    int(path(wide, ["simulation", "simulated"])) == 1,
    Some("the test searched: " ++ json_text(wide)),
  );
  let narrow = test_report(["--sim", "random", "--seeds", "4"]);
  assert(int(path(narrow, ["selection", "selected"])) == 0, Some(json_text(narrow)));
  assert(
    str(at(nth(path(narrow, ["selection", "tests"]), 0), "reason")) == "cached",
    Some(json_text(narrow)),
  );
  assert(
    int(path(narrow, ["simulation", "simulated"])) == 0,
    Some("no root was searched again: " ++ json_text(narrow)),
  )
}

// A measurement asks for one root's trial by naming it: the roots searched are the ones named, and
// each passes on its own, so a narrower range inside it is resolved without searching again.
test/nondet "a root range searches exactly those seeds" {
  write_program(sleeping_task_program());
  let v = test_report(["--sim", "random", "--seed-range", "5..7"]);
  assert(int(path(v, ["summary", "passed"])) == 1, Some(json_text(v)));
  assert(items(path(v, ["options", "sim", "roots"])).map(int) == [5, 6], Some(json_text(v)));
  assert(int(path(v, ["options", "sim", "seeds"])) == 2, Some(json_text(v)));
  let one = test_report(["--sim", "random", "--seed-range", "6..7"]);
  assert(
    str(at(nth(path(one, ["selection", "tests"]), 0), "reason")) == "cached",
    Some(json_text(one)),
  );
  assert(int(path(one, ["simulation", "simulated"])) == 0, Some(json_text(one)));
  assert(spawned(["test", ".", "--seed-range", "7..5"]).code == 2, None)
}

test/nondet "a replay names one interleaving and says so" {
  write_program(green());
  let r = spawned(["test", ".", "--json", "--seed", "7:3.0.2"]);
  assert(r.code == 0, Some(all_output(r)));
  let sim = path(json_of(r), ["options", "sim"]);
  assert(str(at(sim, "mode")) == "once", Some(json_text(sim)));
  assert(str(at(sim, "seed")) == "7:3.0.2", Some(json_text(sim)));
  assert(int(at(sim, "seeds")) == 1, Some(json_text(sim)))
}

// A seed that parses loosely replays something other than what failed.
test/nondet "a seed that is not a seed is rejected before anything runs" {
  write_program(green());
  ["7:", "seven", "7.3", "0x", "1_000"].fold((), |u: Unit, bad: String| {
    let r = spawned(["test", ".", "--seed", bad]);
    assert(r.code == 2, Some("`" ++ bad ++ "` should not parse"));
    assert(stderr(r).contains("is not a seed"), Some(stderr(r)))
  })
}

test/nondet "a flag with nothing to mean is rejected" {
  write_program(green());
  // `--seed` names one interleaving, so nothing may widen the search beside it.
  [["--sim", "dpor"], ["--seeds", "4"], ["--sim-budget", "4"]].fold(
    (),
    |u: Unit, widening: List<String>| {
      let argv = ["test", ".", "--seed", "7"].concat(widening);
      assert(spawned(argv).code == 2, Some(String::join(argv, " ") ++ " should conflict"))
    },
  );
  // `random` is one interleaving per seed, so it has no budget to spend.
  let r = spawned(["test", ".", "--sim", "random", "--sim-budget", "4"]);
  assert(r.code == 2, Some(all_output(r)));
  assert(stderr(r).contains("--sim-budget"), Some(stderr(r)))
}

// Every field of the plan is in a seeded test's cache key, so changing one has to be visible.
test/nondet "widening the search does not disturb a program that never simulates" {
  write_program(green());
  assert(int(path(test_report([]), ["summary", "passed"])) == 2, None);
  let v = test_report(["--sim-budget", "1024"]);
  assert(
    int(path(v, ["selection", "selected"])) == 0,
    Some("nothing here reads a seed: " ++ json_text(v)),
  );
  assert(int(path(v, ["options", "sim", "budget"])) == 1024, Some(json_text(v)));
  assert(int(path(v, ["simulation", "simulated"])) == 0, Some(json_text(v)));
  assert(int(path(v, ["simulation", "interleavings"])) == 0, Some(json_text(v)))
}
