  assert(r.code == 1, Some(said(r)));
  let text = stdout(r);
  assert(text.contains("balance never goes negative"), Some(text));
  assert(text.contains("assertion failed"), Some(text));
  assert(text.contains("suspects: m.balance"), Some(text));
  assert(
    !text.contains("changed since"),
    Some("nothing was compared, so no change may be shown:\n" ++ text),
  )
}

test/nondet "two runs over one failure emit the same artifact" {
  program(red());
  assert(shown(at(tested([]), "failures")) == shown(at(tested([]), "failures")), None)
}

test/nondet "a module with no tests is a clean run that says so" {
  program("fn f() -> Int = 1\n");
  let r = spawned(["test"]);
  assert(r.code == 0, Some(said(r)));
  assert(stdout(r).contains("selected 0 of 0 (0 cached)"), Some(stdout(r)));
  assert(stdout(r).contains("no `test` items"), Some(stdout(r)))
}

test/nondet "a nondet test in a det test is a compile error" {
  program(
    "nondet effect wall {\n  read now() -> Int\n}\ntest \"reads the clock\" { assert(wall.now() > 0) }\n",
  );
