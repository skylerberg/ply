}

// What a test performed is counted, so a measurement can price the operations a suite makes.
test/nondet "each result counts the operations its test performed" {
  program(
    \\effect counter {
    \\  read tick[c]() -> Int
    \\}
    \\
    \\fn twice() -> Int / {counter.read[c]} = counter.tick[c]() + counter.tick[c]()
    \\
    \\test "ticks" { assert_eq(handle { twice() } with { counter.tick[c]() -> 1 }, 2) }
    \\
    \\test "pure" { assert_eq(1 + 1, 2) }
    \\
  );
  let v = tested(["--no-cache"]);
  let performs = |name: String|
    match at(result_of(v, name), "performs") {
      Number(d) -> match Int::of_decimal(d, Down) { Some(n) -> n, None -> -1 },
      _ -> panic("`" ++ name ++ "` carries no count: " ++ shown(v)),
    };
  assert(performs("pure") == 0, Some(shown(v)));
  assert(performs("ticks") == 2, Some(shown(v)))
}

// Nine bumps and a peek, each counted once whatever its clause does, and none past a clause that
// stops the body at the third bump.
test/nondet "a result counts each perform a handle answers once, whether its clause answers, resumes or stops" {
  program(
    \\effect tally {
    \\  write bump(n: Int) -> Unit
    \\  read peek() -> Int
    \\}
    \\
    \\fn bumped(times: Int) -> Unit / {tally.bump} =
    \\  range(0, times).fold((), |_: Unit, i: Int| tally.bump(i))
    \\
    \\test "answered" {
    \\  let got = handle {
    \\    bumped(9);
    \\    tally.peek()
    \\  } with {
    \\    tally.bump(n) -> (),
    \\    tally.peek() -> 7,
    \\  };
    \\  assert_eq(got, 7)
    \\}
    \\
    \\test "resumed" {
    \\  let got = handle {
    \\    bumped(9);
    \\    tally.peek()
    \\  } with {
    \\    tally.bump(n) resume k -> k(()),
    \\    tally.peek() resume k -> k(7),
    \\  };
    \\  assert_eq(got, 7)
    \\}
    \\
    \\test "stopped" {
    \\  let got = handle {
    \\    bumped(9);
    \\    tally.peek()
    \\  } with {
    \\    tally.bump(n) resume k -> if n == 2 { 0 } else { k(()) },
    \\    tally.peek() -> 7,
    \\  };
    \\  assert_eq(got, 0)
    \\}
    \\
  );
  let v = tested(["--no-cache"]);
  let performs = |name: String|
    match at(result_of(v, name), "performs") {
      Number(d) -> match Int::of_decimal(d, Down) { Some(n) -> n, None -> -1 },
      _ -> panic("`" ++ name ++ "` carries no count: " ++ shown(v)),
    };
  assert(
    [performs("answered"), performs("resumed"), performs("stopped")] == [10, 10, 3],
    Some(shown(v)),
  )
}

// --- Filters and workers ------------------------------------------------------

test/nondet "filter narrows both the run and the denominator" {
  program(green());
  let r = spawned(["test", "--filter", "zero"]);
  assert(r.code == 0, Some(said(r)));
  let text = stdout(r);
  assert(text.contains("selected 1 of 1 (0 cached)"), Some(text));
  assert(text.contains("--filter hid 1 test"), Some(text));
  assert(text.contains("double of zero is zero"), Some(text));
  assert(!text.contains("double doubles"), Some("the filtered-out test still ran:\n" ++ text))
}

test/nondet "a filter matching nothing says so rather than claiming success quietly" {
  program(green());
  let r = spawned(["test", "--filter", "nonexistent"]);
  assert(r.code == 0, Some(said(r)));
  assert(stdout(r).contains("selected 0 of 0"), Some(stdout(r)));
  assert(stdout(r).contains("no test key contains a `--filter` substring"), Some(stdout(r)))
}

test/nondet "jobs is honoured and reported" {
  program(green());
  let r = spawned(["test", "--jobs", "1"]);
  assert(r.code == 0, Some(said(r)));
  assert(stdout(r).contains("1 worker"), Some(stdout(r)));
