//! `ply test` as a person runs it: what it selects and why, what it remembers between runs, what it
//! reports in text and in JSON, how it schedules, the binding it runs under, and the search it
//! publishes.

import harness (spawned, Ran, Server, Source, on_disk, on_disk_shipping, speaking, next_line, stop,
                one, program, project, write, stdout, stderr, said, json_of, at, path, nth, items,
                str, int, truth, shown, Here, Shipped, Spawned, is_number, refused, tested)
import compiler.unit (shipped)
import std.fs (fs)
import std.json
import std.json (Json, Null, Number, Array, Str)
import std.process (Var, var)
import std.string
import std.time (time)
import std.list

fn green() -> String =
  \\fn double(x: Int) -> Int = x * 2
  \\
  \\fn main() -> Int = double(21)
  \\
  \\test "double doubles" { assert_eq(double(4), 8) }
  \\
  \\test "double of zero is zero" { assert_eq(double(0), 0) }
  \\

fn red() -> String =
  \\fn balance() -> Int = 0 - 5
  \\
  \\fn main() -> Int = balance()
  \\
  \\test "balance never goes negative" { assert_eq(balance(), 0) }
  \\
  \\test "this one is fine" { assert_eq(1 + 1, 2) }
  \\

/// The first line a run printed, without the indent a report gives it.
fn first_line(ran: Ran) -> String / {abort.raise} =
  match ran.out { [l, ..] -> l.ascii_trim(), [] -> "" }

fn code_of(v: Json) -> String = str(at(nth(at(v, "diagnostics"), 0), "code"))

fn number(j: Json) -> Float = match j { Number(d) -> Float::of_decimal(d), _ -> -1.0 }

fn result_of(v: Json, name: String) -> Json =
  match items(at(v, "results")).filter(|r: Json| str(at(r, "name")) == name) {
    [r, ..] -> r,
    [] -> Null,
  }

fn status_of(v: Json, name: String) -> String = str(at(result_of(v, name), "status"))

fn selected_test(v: Json, name: String) -> Json / {abort.raise} =
  match items(path(v, ["selection", "tests"])).filter(|t: Json| str(at(t, "name")) == name) {
    [t, ..] -> t,
    [] -> panic("no selected test `" ++ name ++ "`: " ++ shown(v)),
  }

fn escape() -> String / {abort.raise} = String::of_bytes(b"\x1b")

// --- Selection and the cache --------------------------------------------------

test/nondet "test leads with the selection line" {
  program(green());
  let r = spawned(["test"]);
  assert(r.code == 0, Some(said(r)));
  assert(first_line(r) == "selected 2 of 2 (0 cached)", Some(stdout(r)));
  // The worker count is the machine's, which a deterministic run does not know.
  assert(stdout(r).contains(" worker"), Some(stdout(r)));
  assert(stdout(r).contains("0 failed, 2 passed, 0 cached"), Some(stdout(r)))
}

test/nondet "a second run selects nothing because the cache is exact" {
  program(green());
  assert(spawned(["test"]).code == 0, None);
  let again = spawned(["test"]);
  assert(again.code == 0, Some(said(again)));
  assert(stdout(again).contains("selected 0 of 2 (2 cached)"), Some(stdout(again)));
  assert(stdout(again).contains("0 failed, 0 passed, 2 cached"), Some(stdout(again)))
}

/// The next report a watching run wrote, one document a line.
fn report(server: Server, what: String) -> Json / {Spawned, abort.raise} =
  match next_line(server, 60000) {
    None -> {
      stop(server);
      panic("`--watch` " ++ what)
    },
    Some(line) -> match json::parse_string(line) {
      Ok(v) -> v,
      Err(_) -> {
        stop(server);
        panic("`--watch` wrote a line that is no report: " ++ line)
      },
    },
  }

/// `text` written over `file` until its modification time moves off `before`, which is the whole
/// signal an unchanged save leaves: a filesystem that stamps coarsely would otherwise hand the
/// watcher two equal walks.
fn saved(
  file: String,
  text: String,
  before: Option<Int>,
) -> Option<Int> / {Here, time.elapsed_ms, time.sleep_ms, abort.raise} = {
  let deadline = time.elapsed_ms() + 60000;
  iterate((), 60000, |u: Unit| {
    write(file, text);
    let after = fs.modified_ms[cwd](file);
    if after != before { Stop(after) } else if time.elapsed_ms() > deadline {
      panic("a save never moved the modification time of `" ++ file ++ "`")
    } else {
      time.sleep_ms(10);
      Continue(u)
    }
  })
}

test/nondet "watch reruns on a save and keeps the front end it already had" {
  program(green());
  let s = speaking(["test", "--watch", "--json"], []);
  let first = report(s, "reported no first iteration");
  // Saved byte for byte as it is: the common case, and the one that must not cost a front end.
  let stamped = saved("m.ply", green(), fs.modified_ms[cwd]("m.ply"));
  let second = report(s, "did not run again when the tree moved");
  // An edit, which the next report has to be about rather than the program the watch began with.
  let _ = saved("m.ply", red(), stamped);
  let edited = report(s, "did not report the edit");
  stop(s);
  assert(
    refused(edited),
    Some("the report after an edit tested the program the watch began with: " ++ shown(edited)),
  );
  assert(truth(at(first, "ok")), Some(shown(first)));
  assert(truth(at(second, "ok")), Some(shown(second)));
  // The save changed no byte, so the second iteration re-derived no front end.
  assert(
    number(path(second, ["front_end", "phases", "total"])) == 0.0,
    Some(
      "a warm iteration over an unchanged tree paid a front end anyway: "
        ++ shown(at(second, "front_end")),
    ),
  );
  assert(
    number(path(first, ["front_end", "phases", "total"])) > 0.0,
    Some(
      "the first iteration paid no front end either, so the assertion above proves nothing: "
        ++ shown(at(first, "front_end")),
    ),
  )
}

fn reused(v: Json) -> Bool / {abort.raise} = truth(path(v, ["front_end", "reused"]))

test/nondet "a green run answers the next one over the same files without loading" {
  program(green());
  let ran = tested([]);
  let kept = tested([]);
  assert(!reused(ran) && int(path(ran, ["summary", "passed"])) == 2, Some(shown(ran)));
  assert(reused(kept), Some(shown(kept)));
  assert(int(path(kept, ["summary", "cached"])) == 2, Some(shown(kept)));
  assert(int(path(kept, ["summary", "passed"])) == 0, Some(shown(kept)));
  // Another command line is another answer, and so is an edit to a file the walk reads.
  assert(!reused(tested(["--filter", "double"])), None);
  write("m.ply", green() ++ "\nfn later() -> Int = 3\n");
  assert(!reused(tested([])), None)
}

test/nondet "an embed that moves loads again, and only the tests that reach it run" {
  program(
    "fn data() -> Bytes = embed(\"data.txt\")\n\npub fn other() -> Bytes = embed(\"other.txt\")\n\ntest \"data reads\" { assert(data().len() > 0) }\n",
  );
  write("data.txt", "one");
  write("other.txt", "one");
  let _ = tested([]);
  write("other.txt", "two");
  let unreached = tested([]);
  assert(!reused(unreached), Some(shown(unreached)));
  assert(int(path(unreached, ["selection", "selected"])) == 0, Some(shown(unreached)));
  assert(reused(tested([])), None);
  write("data.txt", "two");
  let reached = tested([]);
  assert(!reused(reached), Some(shown(reached)));
  assert(int(path(reached, ["selection", "selected"])) == 1, Some(shown(reached)))
}

test/nondet "a kept answer prints what the run it was kept from printed" {
  program(green());
  let _ = spawned(["test"]);
  let cached = spawned(["test"]);
  let kept = spawned(["test"]);
  assert(kept.code == 0, Some(said(kept)));
  assert(stdout(kept) == stdout(cached), Some(said(kept)))
}

test/nondet "a kept answer is not taken once a pass it took no longer stands" {
  program(
    "import std.fs (fs)\n\ntest/nondet \"reads its data\" {\n  assert(fs.read_file[cwd](\"data.txt\") != None)\n}\n",
  );
  write("data.txt", "one");
  let flags = ["--fs", "cwd=."];
  let _ = tested(flags);
  let _ = tested(flags);
  assert(reused(tested(flags)), None);
  write("data.txt", "two");
  let moved = tested(flags);
  assert(!reused(moved), Some(shown(moved)));
  assert(int(path(moved, ["selection", "selected"])) == 1, Some(shown(moved)))
}

// A read is recorded by the handler that answers it, so one a test answers itself is no part of
// its pass.
test/nondet "a read a test handles itself is not recorded, and a pass stands until a file it read moves" {
  program(
    \\import std.fs (fs)
    \\
    \\test/nondet "reads one file and answers the other itself" {
    \\  let canned = handle { fs.read_file[cwd]("handled.txt") } with {
    \\    fs.read_file[cwd](p) -> Some(b"canned"),
    \\  };
    \\  assert_eq(canned, Some(b"canned"));
    \\  assert(fs.read_file[cwd]("data.txt") != None)
    \\}
    \\
  );
  write("data.txt", "one");
  write("handled.txt", "one");
  let flags = ["--fs", "cwd=."];
  let _ = tested(flags);
  let _ = tested(flags);
  write("handled.txt", "two");
  assert(reused(tested(flags)), Some("a file only the test's own handler named moved its pass"));
  write("data.txt", "two");
  let moved = tested(flags);
  assert(!reused(moved), Some(shown(moved)));
  assert(int(path(moved, ["selection", "selected"])) == 1, Some(shown(moved)))
}

test/nondet "renaming a definition re-runs nothing" {
  program("fn width() -> Int = 3\ntest \"width is three\" { assert_eq(width(), 3) }\n");
  assert(spawned(["test"]).code == 0, None);
  write("m.ply", "fn breadth() -> Int = 3\ntest \"width is three\" { assert_eq(breadth(), 3) }\n");
  let text = stdout(spawned(["test"]));
  assert(text.contains("selected 0 of 1 (1 cached)"), Some("a rename rebuilt something:\n" ++ text))
}

test/nondet "attaching a spec to a definition re-runs nothing" {
  let halves = "test \"four halves to two\" { assert_eq(half(4), 2) }\n";
  program("fn half(n: Int) -> Int = n / 2\n" ++ halves);
  assert(spawned(["test"]).code == 0, None);
  write(
    "m.ply",
    "fn half(n: Int) -> Int\n  requires n >= 0\n  ensures result <= n\n= n / 2\n" ++ halves,
  );
  let text = stdout(spawned(["test"]));
  assert(text.contains("selected 0 of 1 (1 cached)"), Some("a spec moved a hash:\n" ++ text))
}

test/nondet "editing a body re-runs exactly the tests that reach it" {
  let tests = "test \"a is one\" { assert_eq(a(), 1) }\ntest \"b is two\" { assert_eq(b(), 2) }\n";
  program("fn a() -> Int = 1\nfn b() -> Int = 2\n" ++ tests);
  assert(spawned(["test"]).code == 0, None);
  write("m.ply", "fn a() -> Int = [1].len()\nfn b() -> Int = 2\n" ++ tests);
  let v = tested([]);
  assert(int(path(v, ["selection", "selected"])) == 1, Some(shown(v)));
  assert(int(path(v, ["selection", "cached"])) == 1, Some(shown(v)));
  assert(items(at(v, "results")).map(|r: Json| str(at(r, "name"))) == ["a is one"], Some(shown(v)))
}

/// A type whose `stated` functions a test reaches only through `total` or `same`, which name
/// neither, beside a test that reaches no value of the type.
fn stating(plus: String, millimetres: String) -> String =
  \\type Length = | Metres(Int) | Millimetres(Int)
  \\
  \\key for Length by millimetres
  \\
  \\numeric for Length by { add: plus, sub: plus, mul: plus, neg: back, of_int: metres }
  \\
    ++ "\nfn millimetres(l: Length) -> Int = "
    ++ millimetres
    ++ "\n\nfn plus(a: Length, b: Length) -> Length = "
    ++ plus
    ++
    \\
    \\
    \\fn back(a: Length) -> Length = a
    \\
    \\fn metres(n: Int) -> Length = Metres(n)
    \\
    \\fn lengths() -> List<Length> = [Metres(1), Millimetres(500)]
    \\
    \\fn total<a>(xs: List<a>) -> a
    \\  where numeric(a)
    \\= xs.fold(numeric_of_int(0), |s: a, x: a| s + x)
    \\
    \\fn same<a>(x: a, y: a) -> Bool
    \\  where derivable(eq, a)
    \\= x == y
    \\
    \\fn double(n: Int) -> Int = n + n
    \\
    \\test "the lengths have a total" { assert(same(total(lengths()), total(lengths()))) }
    \\
    \\test "a length is itself" { assert(same(lengths(), lengths())) }
    \\
    \\test "double doubles" { assert_eq(double(2), 4) }
    \\

fn stated() -> String =
  stating(
    "Millimetres(millimetres(a) + millimetres(b))",
    "match l { Metres(n) -> n * 1000, Millimetres(n) -> n }",
  )

fn ran(v: Json) -> List<String> = items(at(v, "results")).map(|r: Json| str(at(r, "name"))).sort()

test/nondet "editing a function a numeric names re-runs a test that reaches it only through `+` in a generic helper" {
  program(stated());
  assert(spawned(["test"]).code == 0, None);
  write(
    "m.ply",
    stating(
      "Millimetres(millimetres(b) + millimetres(a))",
      "match l { Metres(n) -> n * 1000, Millimetres(n) -> n }",
    ),
  );
  let v = tested([]);
  // The other test holding a `Length` adds none: its hash moved, the code it compiles to did not.
  assert_eq(ran(v), ["the lengths have a total"]);
  assert(int(path(v, ["selection", "by_code"])) == 1, Some(shown(v)))
}

test/nondet "editing a function a key names re-runs a test that reaches it only through `==` in a generic helper" {
  program(stated());
  assert(spawned(["test"]).code == 0, None);
  write(
    "m.ply",
    stating(
      "Millimetres(millimetres(a) + millimetres(b))",
      "match l { Metres(n) -> n * 500 * 2, Millimetres(n) -> n }",
    ),
  );
  let v = tested([]);
  assert_eq(ran(v), ["a length is itself", "the lengths have a total"]);
  assert(int(path(v, ["selection", "cached"])) == 1, Some(shown(v)))
}

test/nondet "an edit the compiler makes the same code of re-runs nothing" {
  let tests = "test \"a is one\" { assert_eq(a(), 1) }\n";
  program("fn a() -> Int = 1\n" ++ tests);
  assert(spawned(["test"]).code == 0, None);
  // Two literals under `+` are folded, so this body is emitted as the one it replaced.
  write("m.ply", "fn a() -> Int = 0 + 1\n" ++ tests);
  let v = tested([]);
  assert(int(path(v, ["selection", "selected"])) == 0, Some(shown(v)));
  assert(int(path(v, ["selection", "by_code"])) == 1, Some(shown(v)));
  assert(str(at(selected_test(v, "a is one"), "reason")) == "same_code", Some(shown(v)))
}

// `ply test` loads twice: once to select, and once more to parse the modules a selected test needs a
// body from.
test/nondet "a nondet test elsewhere does not cost an edited module its body" {
  let counted = |n: String|
    "fn size() -> Int = " ++ n ++ "\ntest \"size is known\" { assert_eq(size(), " ++ n ++ ") }\n";
  project([
    {
      path: "clock.ply",
      text:
        \\nondet effect wall { read now() -> Int }
        \\fn tick() -> Int / {wall.read} = wall.now()
        \\test/nondet "the clock ticks" { assert_eq(handle tick() with { wall.now() -> 1, }, 1) }
        \\
    },
    { path: "shape.ply", text: counted("3") },
  ]);
  assert(spawned(["test"]).code == 0, None);
  write("shape.ply", counted("4"));
  let r = spawned(["test"]);
  assert(r.code == 0, Some(said(r)));
  assert(
    stdout(r).contains("size is known"),
    Some("the edited module's test did not run:\n" ++ stdout(r)),
  );
  assert(!stdout(r).contains("cache clear"), Some("a body went missing:\n" ++ stdout(r)))
}

test/nondet "a red test re-runs until it goes green" {
  program(red());
  assert(spawned(["test"]).code == 1, None);
  let r = spawned(["test"]);
  assert(r.code == 1, Some(said(r)));
  assert(
    stdout(r).contains("selected 1 of 2 (1 cached)"),
    Some("a failure was cached:\n" ++ stdout(r)),
  )
}

test/nondet "--no-cache runs everything and records nothing" {
  program(green());
  assert(spawned(["test"]).code == 0, None);
  let text = stdout(spawned(["test", "--no-cache"]));
  assert(text.contains("selected 2 of 2 (0 cached)"), Some(text));
  assert(text.contains("neither read nor recorded"), Some(text));
  let after = stdout(spawned(["test"]));
  assert(
    after.contains("selected 0 of 2 (2 cached)"),
    Some("--no-cache disturbed the real cache:\n" ++ after),
  )
}

test/nondet "moving a definition between modules re-runs nothing" {
  project([
    {
      path: "app.ply",
      text: "fn one() -> Int = 1\nfn two() -> Int = one() + one()\ntest \"two is two\" { assert_eq(two(), 2) }\n",
    },
  ]);
  assert(spawned(["test"]).code == 0, None);
  write("lib.ply", "pub fn one() -> Int = 1\n");
  write(
    "app.ply",
    "import lib\nfn two() -> Int = lib::one() + lib::one()\ntest \"two is two\" { assert_eq(two(), 2) }\n",
  );
  let text = stdout(spawned(["test"]));
  assert(
    text.contains("selected 0 of 1 (1 cached)"),
    Some("moving a definition rebuilt something:\n" ++ text),
  )
}

/// The shipped modules as a `ply` whose `names` changed would ship them: each under the hash `to`.
fn moving(names: List<String>, to: String) -> List<Source> / {Shipped, abort.raise} =
  [
    {
      path: "definitions",
      text: String::join(
        String::of_bytes(shipped.definitions()).split("\n").map(|line: String|
          match names.filter(|n: String| line.starts_with(n ++ " ")) {
            [n, ..] -> n ++ " " ++ to,
            [] -> line,
          }),
        "\n",
      ),
    },
  ]

test/nondet "a compiler change that leaves a test's code alone re-runs nothing" {
  program(green());
  assert(spawned(["test"]).code == 0, None);
  let deciding = stdout(on_disk_shipping(["test"], moving(["tests.run.selected"], "a")));
  assert(
    deciding.contains("selected 0 of 2 (2 cached, 2 by code)"),
    Some("a pass was not found by the code its test ran:\n" ++ deciding),
  );
  // Found by its code, a pass is filed again by its test: a run that loses the code passes keeps it.
  let refiled = stdout(
    on_disk_shipping(["test"], moving(["tests.run.selected", "tests.concluded.ran_job"], "a")),
  );
  assert(refiled.contains("selected 0 of 2 (2 cached)"), Some(refiled));
  let running = stdout(
    on_disk_shipping(["test"], moving(["tests.run.selected", "tests.concluded.ran_job"], "b")),
  );
  assert(
    running.contains("selected 2 of 2 (0 cached)"),
    Some("a change to what runs a test re-ran nothing:\n" ++ running),
  )
}

// Modules load in path order but check in dependency order, and test indices are shared between the
// two.
test/nondet "an edit re-runs the test that reaches it when load order is not dependency order" {
  let importer = |body: String|
    "import b\nfn one() -> Int = " ++ body ++ "\ntest \"a one\" { assert_eq(one(), 1) }\n";
  project([
    { path: "a.ply", text: importer("b::zero() + 1") },
    { path: "b.ply", text: "pub fn zero() -> Int = 0\ntest \"b zero\" { assert_eq(zero(), 0) }\n" },
  ]);
  let v = tested([]);
  assert(int(path(v, ["summary", "passed"])) == 2, Some(shown(v)));
  write("a.ply", importer("1 + b::zero()"));
  let again = tested([]);
  assert(int(path(again, ["selection", "selected"])) == 1, Some(shown(again)));
  assert(
    items(at(again, "results")).map(|r: Json| str(at(r, "key"))) == ["a.a one"],
    Some("the wrong test was re-run: " ++ shown(again)),
  )
}

test/nondet "one edited test is the only one selected" {
  project(
    [
      { path: "leaf.ply", text: "pub fn one() -> Int = 1\n" },
      {
        path: "used.ply",
        text: "import leaf\npub fn two() -> Int = leaf::one() + 1\ntest \"two is two\" { assert_eq(two(), 2) }\n",
      },
    ].concat(
      range(0, 4).map(|i: Int| {
        let n = i.to_string();
        {
          path: "far" ++ n ++ ".ply",
          text: "fn f" ++ n ++ "() -> Int = " ++ n ++ "\ntest \"far " ++ n ++ "\" { assert_eq(f"
            ++ n
            ++ "(), "
            ++ n
            ++ ") }\n",
        }
      }),
    ),
  );
  assert(spawned(["test"]).code == 0, None);
  write(
    "used.ply",
    "import leaf\npub fn two() -> Int = leaf::one() + 1 + 0\ntest \"two is two\" { assert_eq(two(), 2) }\n",
  );
  let r = spawned(["test", "--explain"]);
  assert(r.code == 0, Some(said(r)));
  assert(stdout(r).contains("selected 1 of 5"), Some("one test must be selected:\n" ++ stdout(r)))
}

test/nondet "the front end reports where its time went" {
  program("fn f() -> Int = 1\ntest \"f is one\" { assert_eq(f(), 1) }\n");
  assert(spawned(["test"]).code == 0, None);
  let phases = path(tested([]), ["front_end", "phases"]);
  let parts = ["read", "front", "write_back"];
  parts.concat(["total"]).fold((), |u: Unit, name: String|
    assert(
      is_number(at(phases, name)),
      Some("`" ++ name ++ "` is missing from " ++ shown(phases)),
    ));
  let gap = number(at(phases, "total"))
    - parts.fold(0.0, |sum: Float, name: String| sum + number(at(phases, name)));
  assert(gap < 0.5 && gap > -0.5, Some("the total must account for the parts: " ++ shown(phases)));
  assert(
    stdout(on_disk(["check", "--explain"])).contains("front-end time"),
    Some("--explain must show the breakdown"),
  )
}

// --- What a run reports -------------------------------------------------------

test/nondet "test exits one on a failure and names the suspects" {
  program(red());
  let r = spawned(["test"]);
  assert(r.code == 1, Some(said(r)));
  let text = stdout(r);
  assert(text.contains("1 failed, 1 passed"), Some(text));
  assert(text.contains("balance never goes negative"), Some(text));
  assert(text.contains("assertion failed: expected 0, found -5"), Some(text));
  assert(text.contains("at m.ply:"), Some(text));
  assert(text.contains("suspects: m.balance"), Some(text))
}

test/nondet "test exits two on a compile error" {
  program("fn f() -> Int = true\n");
  let r = spawned(["test"]);
  assert(r.code == 2, Some(said(r)));
  assert(stdout(r) == "", Some(stdout(r)))
}

test/nondet "test --json is exactly one object on stdout, and each result on stderr as it finishes" {
  program(red());
  let r = spawned(["test", "--json"]);
  assert(r.code == 1, Some(said(r)));
  let progress = stderr(r);
  assert(progress.contains("selected 2 of 2"), Some(progress));
  assert(progress.contains("FAIL    balance never goes negative"), Some(progress));
  assert(progress.contains("assertion failed: expected 0, found -5"), Some(progress));
  assert(!progress.contains("suspects:"), Some("the diagnosis is the document's: " ++ progress));
  let v = json_of(r);
  assert(str(at(v, "command")) == "test", Some(shown(v)));
  assert(refused(v), Some(shown(v)));
  assert(int(at(v, "exit_code")) == 1, Some(shown(v)));
  assert(int(path(v, ["summary", "failed"])) == 1, Some(shown(v)));
  assert(int(path(v, ["summary", "passed"])) == 1, Some(shown(v)));
  let failure = nth(at(v, "failures"), 0);
  assert(str(at(failure, "name")).contains("balance never goes negative"), Some(shown(failure)));
  assert(str(path(failure, ["diagnostic", "code"])) == "E0501", Some(shown(failure)));
  let label = nth(path(failure, ["diagnostic", "labels"]), 0);
  assert(str(at(label, "file")) == "m.ply", Some(shown(failure)));
  assert(is_number(path(label, ["start", "line"])), Some(shown(failure)));
  // Ranked, so a consumer reading only `suspects[0]` gets the best guess rather than the
  // alphabetically first.
  assert(str(at(nth(at(failure, "suspects"), 0), "name")) == "m.balance", Some(shown(failure)));
  assert(items(at(failure, "suspects")).len() == 1, Some(shown(failure)));
  assert(
    items(path(v, ["selection", "tests"])).map(|t: Json| at(t, "selected"))
      == [json::Bool(true), json::Bool(true)],
    Some(shown(v)),
  );
  assert(
    match at(nth(path(v, ["selection", "groups"]), 0), "footprint") { Str(_) -> true, _ -> false },
    Some(shown(v)),
  )
}

test/nondet "json output carries no ansi escapes" {
  program(red());
  let r = spawned(["test", "--json", "--color", "always"]);
  assert(
    !stdout(r).contains(escape()),
    Some("--json must stay machine-readable under --color always"),
  );
  let _ = json_of(r);
  ()
}

test/nondet "a pipe gets ascii marks and a terminal would get glyphs" {
  program(green());
  let piped = spawned(["test"]);
  assert(
    piped.out.filter(|l: String|
        l.ascii_trim().starts_with("ok ") && l.contains("double doubles")).len(
      )
      > 0,
    Some(stdout(piped)),
  );
  assert(!stdout(piped).contains("✓"), Some(stdout(piped)));
  assert(!stdout(piped).contains(escape()), Some(stdout(piped)));
  program(green());
  let forced = stdout(spawned(["test", "--color", "always"]));
  assert(forced.contains("✓"), Some(forced));
  assert(forced.contains(escape()), Some(forced))
}

test/nondet "test --json carries schema version eight and a ranked suspect object" {
  program(red());
  let r = spawned(["test", "--json"]);
  assert(r.code == 1, Some(said(r)));
  let v = json_of(r);
  assert(int(at(v, "schema_version")) == 8, Some(shown(v)));
  let f = nth(at(v, "failures"), 0);
  assert(str(at(f, "key")) == "m.balance never goes negative", Some(shown(f)));
  assert(str(at(f, "name")) == "balance never goes negative", Some(shown(f)));
  assert(str(at(f, "module")) == "m", Some(shown(f)));
  assert(str(at(f, "status")) == "failed", Some(shown(f)));
  assert(at(f, "nondet") == json::Bool(false), Some(shown(f)));
  assert(str(at(f, "test_hash")).len() == 64, Some(shown(f)));
  assert(str(path(f, ["location", "file"])) == "m.ply", Some(shown(f)));
  assert(int(path(f, ["location", "line"])) == 5, Some(shown(f)));
  assert(is_number(path(f, ["location", "end_column"])), Some(shown(f)));
  assert(str(path(f, ["diagnostic", "code"])) == "E0501", Some(shown(f)));
  let suspect = nth(at(f, "suspects"), 0);
  assert(str(at(suspect, "name")) == "m.balance", Some(shown(f)));
  assert(at(suspect, "test") == json::Bool(false), Some(shown(f)));
  assert(str(at(suspect, "hash")).len() == 64, Some(shown(f)));
  assert(at(suspect, "change") == Null, Some("nothing compared the two eras: " ++ shown(f)));
  assert(at(v, "diffs") == Array([]), Some(shown(v)));
  assert(path(f, ["footprint", "declared"]) == Array([]), Some(shown(f)));
  assert(at(f, "defect") == json::Bool(false), Some(shown(f)));
  // The run searched nothing, so there is no interleaving to replay and no race to name.
  assert(at(f, "replay") == Null, Some(shown(f)));
  assert(at(f, "race") == Null, Some(shown(f)))
}

test/nondet "a test that has never passed names its suspects and shows no change" {
  program(red());
