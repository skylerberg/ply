  write_program("fn f() -> Int = 1\n");
  let r = spawned(["test", "."]);
  assert(r.code == 0, Some(all_output(r)));
  assert(stdout(r).contains("selected 0 of 0 (0 cached)"), Some(stdout(r)));
  assert(stdout(r).contains("no `test` items"), Some(stdout(r)))
}

