//! The `db` effect served by Ply itself, against a real server. `std.pg` speaks the protocol;
//! this proves the effect can be served in Ply: the pool, the transaction scope and the text of
//! every value are `std.db`'s, and the host sees only the network and entropy.

import harness (WorkingDirectory, PlyProcess, Network, all_output, spawned, stderr, write)
import postgres
import postgres (Cluster, Postgres, call_with_url, stop)
import std.list
import std.string

fn serving() -> String =
  \\import std.net (net)
  \\import std.process (process)
  \\import std.random (entropy)
  \\import std.db
  \\import std.db (db, with_server, transaction, is_retryable, ReadCommitted, ReadWrite, Serializable, Rollback)
  \\import std.sql (stmt, IntParameter, TextParameter, IntDatum, TextDatum, QueryResult, Rows, Count, Failed, Row)
  \\
  \\pub fn run(url: String) -> Result<String, String>
  \\  / {net.connect[link], net.start_tls[link], net.peer_certificate[link], net.send_secret[link], net.send[link], net.recv[link], net.close[link], entropy.next, abort.raise, diverges} =
  \\  run_with(url, None)
  \\
  \\// `run`, its password given beside the connection string, as `config.secret` answers one.
  \\pub fn run_given_password(url: String) -> Result<String, String>
  \\  / {net.connect[link], net.start_tls[link], net.peer_certificate[link], net.send_secret[link], net.send[link], net.recv[link], net.close[link], entropy.next, abort.raise, diverges} =
  \\  run_with(url, Some(Secret::of_bytes(b"p@ss:w")))
  \\
  \\fn run_with(url: String, password: Option<Secret<Bytes>>) -> Result<String, String>
  \\  / {net.connect[link], net.start_tls[link], net.peer_certificate[link], net.send_secret[link], net.send[link], net.recv[link], net.close[link], entropy.next, abort.raise, diverges} =
  \\  match with_server(url, 4, password: password, body: || {
  \\    match db.returning[items](
  \\      stmt("insert into items (id, name) values ($1, $2) returning id"),
  \\      [IntParameter(7), TextParameter("seven")],
  \\    ) {
  \\      Failed(e) -> Err(e.detail),
  \\      Count(_) -> Err("a count where rows were due"),
  \\      Rows(rows) -> match rows {
  \\        [] -> Err("no row came back from the insert"),
  \\        [row, ..rest] -> match row.get("id") {
  \\          Some(IntDatum(n)) -> match db.query[items](
  \\            stmt("select name from items where id = $1"),
  \\            [IntParameter(7)],
  \\          ) {
  \\            Failed(e) -> Err(e.detail),
  \\            Count(_) -> Err("a count where rows were due"),
  \\            Rows(found) -> Ok(n.to_string() ++ " " ++ names(found)),
  \\          },
  \\          _ -> Err("the id is not an int"),
  \\        },
  \\      },
  \\    }
  \\  }) {
  \\    Err(why) -> Err(why),
  \\    Ok(answered) -> answered,
  \\  }
  \\
  \\fn names(rows: List<Row>) -> String =
  \\  match rows {
  \\    [] -> "no rows",
  \\    [row, ..rest] -> match row.get("name") {
  \\      Some(TextDatum(t)) -> t,
  \\      _ -> "the name is not text",
  \\    },
  \\  }
  \\
  \\// A statement that writes, performed as `db.query`: the scheduler would treat two of these as
  \\// readers, so the driver refuses it before it reaches the server. Its text is the run's input,
  \\// which no check reads.
  \\pub fn sneaky(url: String, text: String) -> Result<String, String>
  \\  / {net.connect[link], net.start_tls[link], net.peer_certificate[link], net.send_secret[link], net.send[link], net.recv[link], net.close[link], entropy.next, abort.raise, diverges} =
  \\  match with_server(url, 4, || {
  \\    match db.query[items](stmt(text), [IntParameter(1), TextParameter("x")]) {
  \\      _ -> Ok("the write went through as a read"),
  \\    }
  \\  }) {
  \\    Err(why) -> Err(why),
  \\    Ok(answered) -> answered,
  \\  }
  \\
  \\// A call site's label is the atom the scheduler records, so a statement that reaches a table the
  \\// label never named would be scheduled against the wrong table.
  \\pub fn mislabelled(url: String, text: String) -> Result<String, String>
  \\  / {net.connect[link], net.start_tls[link], net.peer_certificate[link], net.send_secret[link], net.send[link], net.recv[link], net.close[link], entropy.next, abort.raise, diverges} =
  \\  match with_server(url, 4, || {
  \\    match db.query[orders](stmt(text), [IntParameter(7)]) {
  \\      _ -> Ok("the statement ran under a label it does not touch"),
  \\    }
  \\  }) {
  \\    Err(why) -> Err(why),
  \\    Ok(answered) -> answered,
  \\  }
  \\
  \\// A transaction commits what it did, through `begin` and `commit` on the same connection.
  \\pub fn commit_one(url: String) -> Result<String, String>
  \\  / {net.connect[link], net.start_tls[link], net.peer_certificate[link], net.send_secret[link], net.send[link], net.recv[link], net.close[link], entropy.next, abort.raise, diverges} =
  \\  match with_server(url, 4, || {
  \\    match transaction(ReadCommitted, ReadWrite, || {
  \\      db.execute[items](stmt("insert into items (id, name) values ($1, $2)"), [IntParameter(8), TextParameter("eight")])
  \\    }) {
  \\      Err(roll) -> Err(roll.reason),
  \\      Ok(_) -> match db.query[items](stmt("select count(*) as n from items"), []) {
  \\        Failed(e) -> Err(e.detail),
  \\        Count(_) -> Err("a count where rows were due"),
  \\        Rows(rows) -> match rows {
  \\          [row, ..rest] -> Ok(shown(row)),
  \\          [] -> Err("no row"),
  \\        },
  \\      },
  \\    }
  \\  }) {
  \\    Err(why) -> Err(why),
  \\    Ok(answered) -> answered,
  \\  }
  \\
  \\fn shown(row: Row) -> String =
  \\  match row.get("n") {
  \\    Some(TextDatum(t)) -> t,
  \\    Some(IntDatum(n)) -> n.to_string(),
  \\    _ -> "not a count",
  \\  }
  \\
  \\// The two timeouts as the server holds them for this session, which the connection string set.
  \\pub fn timeouts(url: String) -> Result<String, String>
  \\  / {net.connect[link], net.start_tls[link], net.peer_certificate[link], net.send_secret[link], net.send[link], net.recv[link], net.close[link], entropy.next, abort.raise, diverges} =
  \\  match with_server(url, 1, || {
  \\    match db.query[pg_settings](
  \\      stmt("select name, setting from pg_settings where name = 'statement_timeout' or name = 'idle_in_transaction_session_timeout' order by name"),
  \\      [],
  \\    ) {
  \\      Failed(e) -> Err(e.detail),
  \\      Count(_) -> Err("a count where rows were due"),
  \\      Rows(rows) -> Ok(rows.fold("", |acc: String, row: Row| acc ++ setting(row) ++ ";")),
  \\    }
  \\  }) {
  \\    Err(why) -> Err(why),
  \\    Ok(answered) -> answered,
  \\  }
  \\
  \\fn setting(row: Row) -> String =
  \\  match (row.get("name"), row.get("setting")) {
  \\    (Some(TextDatum(name)), Some(TextDatum(value))) -> name ++ "=" ++ value,
  \\    _ -> "not a setting",
  \\  }
  \\
  \\// A statement that runs far past the timeout the connection string set, and what ended it.
  \\pub fn overrun(url: String) -> Result<String, String>
  \\  / {net.connect[link], net.start_tls[link], net.peer_certificate[link], net.send_secret[link], net.send[link], net.recv[link], net.close[link], entropy.next, abort.raise, diverges} =
  \\  match with_server(url, 1, || {
  \\    match db.query[pg_class](
  \\      stmt("select count(*) as n from pg_class a, pg_class b, pg_class c, pg_class d"),
  \\      [],
  \\    ) {
  \\      Failed(e) -> Ok(e.code ++ ": " ++ e.detail),
  \\      _ -> Err("the statement finished inside its timeout"),
  \\    }
  \\  }) {
  \\    Err(why) -> Err(why),
  \\    Ok(answered) -> answered,
  \\  }
  \\
  \\fn bump(id: Int, by: Int) -> QueryResult / {db.execute[ledger]} =
  \\  db.execute[ledger](stmt("update ledger set n = n + $2 where id = $1"), [IntParameter(id), IntParameter(by)])
  \\
  \\fn ended(out: Result<Unit, Rollback>) -> String =
  \\  match out { Ok(_) -> "committed", Err(rolled) -> rolled.reason }
  \\
  \\// Two tasks in transactions at once on one pool, over one row: each holds a connection of its own,
  \\// so the one that rolls back undoes only its own write, whichever takes the row first.
  \\pub fn two_at_once(url: String) -> Result<String, String>
  \\  / {net.connect[link], net.start_tls[link], net.peer_certificate[link], net.send_secret[link], net.send[link], net.recv[link], net.close[link], entropy.next, task.spawn, task.join, abort.raise, diverges} =
  \\  with_server(url, 2, || {
  \\    let kept = task.spawn(|| ended(transaction(ReadCommitted, ReadWrite, || {
  \\      bump(1, 1);
  \\      ()
  \\    })));
  \\    let undone = task.spawn(|| ended(transaction(ReadCommitted, ReadWrite, || {
  \\      bump(1, 10);
  \\      db.rollback("undone")
  \\    })));
  \\    task.join(kept) ++ " " ++ task.join(undone)
  \\  })
  \\
  \\// Two serializable transactions writing one row: the one that writes second is refused with 40001,
  \\// and run again from its `begin` it goes through. The other runs on a pool of its own, inside the
  \\// first attempt.
  \\pub fn serialized(url: String) -> Result<String, String>
  \\  / {net.connect[link], net.start_tls[link], net.peer_certificate[link], net.send_secret[link], net.send[link], net.recv[link], net.close[link], entropy.next, abort.raise, diverges} =
  \\  with_server(url, 1, || contended(url, 3, ""))
  \\
  \\fn contended(url: String, left: Int, seen: String) -> String / {db.query[ledger], db.execute[ledger], db.abort, db.begin, db.commit, net.close[link], net.connect[link], net.start_tls[link], net.peer_certificate[link], net.send_secret[link], net.recv[link], net.send[link], entropy.next, abort.raise, diverges} =
  \\  match transaction(Serializable, ReadWrite, || {
  \\      db.query[ledger](stmt("select n from ledger where id = $1"), [IntParameter(1)]);
  \\      if seen == "" {
  \\        with_server(url, 1, || transaction(Serializable, ReadWrite, || bump(1, 10)));
  \\        ()
  \\      };
  \\      match bump(1, 1) {
  \\        Failed(e) -> db.rollback(if is_retryable(e) { "retry " ++ e.code } else { e.code }),
  \\        _ -> (),
  \\      }
  \\    }) {
  \\    Ok(_) -> seen ++ "committed",
  \\    Err(rolled) -> if rolled.reason.starts_with("retry ") && left > 1 {
  \\      contended(url, left - 1, seen ++ rolled.reason.slice(6, rolled.reason.len()) ++ " then ")
  \\    } else { seen ++ rolled.reason },
  \\  }
  \\
  \\// Two tasks, each on a pool of its own, taking two rows in opposite orders: the server breaks the
  \\// deadlock by refusing one with 40P01, and the other commits once that one has rolled back.
  \\pub fn deadlocked(url: String) -> Result<String, String>
  \\  / {net.connect[link], net.start_tls[link], net.peer_certificate[link], net.send_secret[link], net.send[link], net.recv[link], net.close[link], entropy.next, task.spawn, task.join, abort.raise, diverges} = {
  \\  let a = task.spawn(|| crossing(url, 1, 2));
  \\  let b = task.spawn(|| crossing(url, 2, 1));
  \\  Ok(task.join(a) ++ " " ++ task.join(b))
  \\}
  \\
  \\fn crossing(url: String, first: Int, second: Int) -> String / {net.close[link], net.connect[link], net.start_tls[link], net.peer_certificate[link], net.send_secret[link], net.recv[link], net.send[link], entropy.next, abort.raise, diverges} =
  \\  match with_server(url, 1, || ended(transaction(ReadCommitted, ReadWrite, || {
  \\      bump(first, 1);
  \\      both_written(400);
  \\      match bump(second, 1) { Failed(e) -> db.rollback(e.code), _ -> () }
  \\    }))) {
  \\    Err(why) -> why,
  \\    Ok(text) -> text,
  \\  }
  \\
  \\// Until both transactions have written, when each holds a transaction id of its own.
  \\fn both_written(left: Int) -> Unit / {db.query[pg_locks]} =
  \\  if left <= 0 { () } else {
  \\    match db.query[pg_locks](
  \\        stmt("select count(*) as n from pg_locks where locktype = 'transactionid' and granted"),
  \\        [],
  \\      ) {
  \\      Rows([row, ..]) -> match row.get("n") {
  \\        Some(IntDatum(n)) -> if n >= 2 { () } else { both_written(left - 1) },
  \\        _ -> both_written(left - 1),
  \\      },
  \\      _ -> both_written(left - 1),
  \\    }
  \\  }
  \\
  \\fn main() -> Unit
  \\  / {net.connect[link], net.start_tls[link], net.peer_certificate[link], net.send_secret[link], net.send[link], net.recv[link], net.close[link], entropy.next, task.spawn, task.join, process.read[proc], process.write[proc], abort.raise, diverges} =
  \\  match process.args[proc]() {
  \\    [entry, url, ..given] -> match answer(entry, url, String::join(given, " ")) {
  \\      Ok(text) -> process.out[proc]("heard " ++ text),
  \\      Err(why) -> process.out[proc]("refused " ++ why),
  \\    },
  \\    _ -> process.out[proc]("refused an entry and a connection string, please"),
  \\  }
  \\
  \\// `text` is the statement of the entries the driver refuses.
  \\fn answer(entry: String, url: String, text: String) -> Result<String, String>
  \\  / {net.connect[link], net.start_tls[link], net.peer_certificate[link], net.send_secret[link], net.send[link], net.recv[link], net.close[link], entropy.next, task.spawn, task.join, abort.raise, diverges} =
  \\  match entry {
  \\    "run" -> run(url),
  \\    "run_given_password" -> run_given_password(url),
  \\    "sneaky" -> sneaky(url, text),
  \\    "mislabelled" -> mislabelled(url, text),
  \\    "commit_one" -> commit_one(url),
  \\    "timeouts" -> timeouts(url),
  \\    "overrun" -> overrun(url),
  \\    "two_at_once" -> two_at_once(url),
  \\    "serialized" -> serialized(url),
  \\    "deadlocked" -> deadlocked(url),
  \\    _ -> Err("no entry is named " ++ entry),
  \\  }
  \\

/// Why `entry` would not run `statement` over `url`, for the refusals that are the driver's, not the
/// server's or the check's: what the run that raised said.
fn error_message(
  entry: String,
  url: String,
  statement: String,
) -> String / {PlyProcess, abort.raise} = {
  let r = spawned(["run", "inner.ply", "--", entry, url, statement]);
  assert(r.code != 0, Some("`" ++ entry ++ "` answered rather than refusing:\n" ++ all_output(r)));
  assert(
    !stderr(r).contains("compilation failed"),
    Some("the check refused `" ++ entry ++ "` before the driver could:\n" ++ all_output(r)),
  );
  stderr(r)
}

/// A cluster that asks for a password, so the connection is SCRAM rather than trust, with the
/// program written beside it.
fn scram() -> Cluster / {WorkingDirectory, Network, Postgres, abort.raise, diverges} = {
  let c = postgres::scram("ply", "pencil");
  write("inner.ply", serving());
  c
}

fn plain_url(c: Cluster) -> String = postgres::url(c, "127.0.0.1", "ply", "sslmode=disable")

fn create_items_table(c: Cluster) -> Unit / {Postgres, abort.raise} = {
  let _ = postgres::psql(
    c,
    "ply",
    "create table if not exists items (id int4 primary key, name text)",
  );
  ()
}

/// A table of counters, one row per id, each starting at zero.
fn create_ledger_table(c: Cluster, ids: List<Int>) -> Unit / {Postgres, abort.raise} = {
  let _ = postgres::psql(c, "ply", "create table ledger (id int4 primary key, n int4 not null)");
  ids.fold((), |u: Unit, id: Int| {
    let _ = postgres::psql(c, "ply", "insert into ledger values (" ++ id.to_string() ++ ", 0)");
    ()
  })
}

// `db.execute` carries statements, not a schema, so the table is made before the program starts.
test/nondet "the db effect is served from a real server" {
  if postgres::available() {
    let c = scram();
    create_items_table(c);
    let ran = call_with_url("run", plain_url(c));
    stop(c);
    assert_eq(ran, Ok("7 seven"))
  }
}

// The password, sealed where it is read (the connection string, or settings beside it), sent in
// the clear-text message a `password` cluster asks for.
test/nondet "the db effect sends a password in the clear when asked, from the url or from settings" {
  if postgres::available() {
    let c = postgres::clear_text("ply", "p@ss:w");
    write("inner.ply", serving());
    create_items_table(c);
    let port = c.port.to_string();
    let in_url = "postgres://ply:p%40ss%3Aw@127.0.0.1:" ++ port ++ "/ply?sslmode=disable";
    let first = call_with_url("run", in_url);
    let _ = postgres::psql(c, "ply", "delete from items");
    let bare = call_with_url(
      "run_given_password",
      "postgres://ply@127.0.0.1:" ++ port ++ "/ply?sslmode=disable",
    );
    let both = call_with_url("run_given_password", in_url);
    stop(c);
    assert_eq(first, Ok("7 seven"));
    assert_eq(bare, Ok("7 seven"));
    assert(match both { Err(why) -> why.contains("give it once"), Ok(_) -> false }, None)
  }
}

test/nondet "a write performed as a read is refused" {
  if postgres::available() {
    let c = scram();
    let why = error_message("sneaky", plain_url(c), "insert into items (id, name) values ($1, $2)");
    stop(c);
    assert(why.contains("writes") && why.contains("db.query"), Some(why))
  }
}

test/nondet "a label the statement does not touch is refused" {
  if postgres::available() {
    let c = scram();
    let why = error_message("mislabelled", plain_url(c), "select name from items where id = $1");
    stop(c);
    assert(why.contains("names `orders`") && why.contains("items"), Some(why))
  }
}

test/nondet "a transaction commits what it did" {
  if postgres::available() {
    let c = scram();
    create_items_table(c);
    let first = call_with_url("run", plain_url(c));
    let committed = call_with_url("commit_one", plain_url(c));
    stop(c);
    assert_eq(first, Ok("7 seven"));
    assert_eq(committed, Ok("2"))
  }
}

test/nondet "a connection string's timeouts bound every statement on the server" {
  if postgres::available() {
    let c = scram();
    let bounded = plain_url(c) ++ "&statement_timeout=200&idle_in_transaction_session_timeout=1500";
    let read_back = call_with_url("timeouts", bounded);
    let overrun = call_with_url("overrun", bounded);
    stop(c);
    assert_eq(read_back, Ok("idle_in_transaction_session_timeout=1500;statement_timeout=200;"));
    assert(
      match overrun {
        Ok(why) -> why.starts_with("57014: ") && why.contains("statement timeout"),
        Err(_) -> false,
      },
      None,
    )
  }
}

test/nondet "two tasks in transactions at once each hold a connection of their own" {
  if postgres::available() {
    let c = scram();
    create_ledger_table(c, [1]);
    let both = call_with_url("two_at_once", plain_url(c));
    let n = postgres::psql(c, "ply", "select n from ledger where id = 1");
    stop(c);
    assert_eq(both, Ok("committed undone"));
    assert_eq(n, "1")
  }
}

test/nondet "a serialization failure is 40001 and the retried transaction commits" {
  if postgres::available() {
    let c = scram();
    create_ledger_table(c, [1]);
    let retried = call_with_url("serialized", plain_url(c));
    let n = postgres::psql(c, "ply", "select n from ledger where id = 1");
    stop(c);
    assert_eq(retried, Ok("40001 then committed"));
    assert_eq(n, "11")
  }
}

test/nondet "a deadlock is 40P01 and the transaction left standing commits" {
  if postgres::available() {
    let c = scram();
    create_ledger_table(c, [1, 2]);
    let ended = call_with_url("deadlocked", plain_url(c));
    let sum = postgres::psql(c, "ply", "select sum(n) from ledger");
    stop(c);
    match ended {
      Ok(text) ->
        assert_eq(text.split(" ").sort_by(|a: String, b: String| compare(a, b) == Less), [
          "40P01",
          "committed",
        ]),
      Err(why) -> panic(why),
    };
    assert_eq(sum, "2")
  }
}
