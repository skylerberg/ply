import spawning.harness (write_program, spawned, all_output)

test/nondet "`below(0)` fails with an error saying the bound must be above zero" {
  write_program(
    "import std.random (entropy, below)\n\nfn main() -> Int / {entropy.below} = below(0)\n",
  );
  let r = spawned(["run", "m.ply"], []);
  assert(r.code != 0 && all_output(r).contains("above zero"), Some(all_output(r)))
}
