//! `ply run` of a program that asks `std.random`'s `entropy` for a draw below a bound the host
//! cannot honour: the host rejects it, and the run ends.

import harness (write_program, spawned, all_output)

// Rejected rather than folded into range, which ends the run that asked.
test/nondet "a bound the host cannot honour is rejected" {
  write_program(
    "import std.random (entropy, below)\n\nfn main() -> Int / {entropy.below} = below(0)\n",
  );
  let r = spawned(["run", "m.ply"], []);
  assert(r.code != 0 && all_output(r).contains("above zero"), Some(all_output(r)))
}
