//! What the host registers a handler for is what this tree declares: a registration for an
//! operation no declaration holds, a typo or one side of a rename, binds nothing anywhere and fails
//! no other test, so every one is held here to the language's effects and to each the standard
//! library declares. A declaration is read from its module's parse: nothing here is checked.

import harness (StdModule, std_modules)
import std.machine as entering
import std.machine (Registration)
import compiler.check.infer.checker (EffectInfo, OpInfo, prelude_effects)
import compiler.syntax.items
import compiler.syntax.items (IEffect, Item, OpDef)
import std.list

/// An effect as it is declared: under its program-wide name and the one its module gave it.
type Declared = { name: Bytes, simple_name: Bytes, nondet: Bool, ops: List<Bytes> }

fn language() -> List<Declared> =
  prelude_effects().map(|e: EffectInfo|
    {
      name: e.name,
      simple_name: e.simple_name,
      nondet: e.nondet,
      ops: e.ops.map(|o: OpInfo| o.name),
    })

/// A module that spells no `effect` declares none, and is not parsed to learn it.
fn declared_in(m: StdModule) -> List<Declared> / {abort.raise} =
  if m.src.index_of(b"effect ") == None { [] } else {
    items::parse(m.src).node.items.fold([], |acc: List<Declared>, item: Item|
      match item {
        IEffect(d) ->
          acc.push({
            name: Bytes::concat_all([Bytes::of_string(m.module), b".", d.name.name]),
            simple_name: d.name.name,
            nondet: d.is_nondet,
            ops: d.ops.map(|o: OpDef| o.name.name),
          }),
        _ -> acc,
      })
  }

/// Whether a registration for `registered` is for `e`: the language's and a shipped module's by
/// program-wide name, any other by the name its module declared it under.
fn names(registered: String, e: Declared) -> Bool / {abort.raise} = {
  let name = Bytes::of_string(registered);
  if registered.starts_with("std.")
      || prelude_effects().find(|l: EffectInfo| l.name == name) != None { e.name == name }
  else { e.simple_name == name }
}

/// What is wrong with `r` against `declared`, if anything.
fn misregistered(declared: List<Declared>, r: Registration) -> Option<String> / {abort.raise} =
  match declared.find(|e: Declared| names(r.effect, e)) {
    None ->
      Some(r.effect ++ "." ++ r.op ++ " (" ++ r.handler ++ "): no declaration holds the effect"),
    Some(e) -> if e.ops.find(|o: Bytes| o == Bytes::of_string(r.op)) == None {
      Some(
        r.effect ++ "." ++ r.op ++ " (" ++ r.handler ++ "): the effect declares no such operation",
      )
    } else if !r.deterministic && !e.nondet {
      Some(
        r.effect ++ "." ++ r.op ++ " (" ++ r.handler
          ++ "): a nondeterministic handler on an effect not declared `nondet`",
      )
    } else { None },
  }

/// Every family lent, the host bound: what a run could register at most.
fn every_family() -> entering::Grants =
  { ..entering::no_grants(), hermetic: false, allow: ["machine", "shipped", "toolchain"] }

test/nondet "every operation the host registers is one the prelude or a shipped module declares, as it declares it" {
  let declared = language().concat(std_modules().map(declared_in).flatten());
  let registered = entering::machine.hosting(every_family()).registrations;
  assert(registered.len() > 0, Some("the host registers nothing"));
  let wrong = registered.fold([], |acc: List<String>, r: Registration|
    match misregistered(declared, r) { Some(why) -> acc.push(why), None -> acc });
  assert_eq(wrong, [])
}
