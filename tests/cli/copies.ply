import harness (spawned, spawned_together, PlyProcess)
import support.harness (at, items, json_of, repo, str, Repo)
import std.json (Json)
import std.list
import std.map
import std.string

type PackageListing = { pkg: String, line: List<String> }

fn packages() -> List<PackageListing> / {PlyProcess, Repo, abort.raise} = {
  let work = at(json_of(spawned(["work", "--json", repo()])), "workspace");
  let listing = |pkg: String, dir: String|
    { pkg: pkg, line: ["definitions", "--json", repo() ++ "/" ++ dir] };
  let part = |name: String| str(at(at(work, "toolchain"), name));
  [
    listing("std", part("std")),
    listing("compiler", part("compiler")),
    listing("cli", part("cli")),
    listing("clitests", part("cli_tests")),
  ].concat(
    items(at(work, "packages")).map(|dir: Json| {
      let place = str(dir);
      listing(place.split("/").at_or(1, place), place)
    }),
  )
}

fn allowed_copies() -> List<{ members: List<String>, reason: String }> =
  [
    {
      members: ["cli/signing.a_seed", "std/signed.a_seed"],
      reason: "the seed two packages' key tests each need, where no test helper reaches both",
    },
    {
      members: ["proof/discharge.dpor_plan", "sim/model.dpor"],
      reason: "the search plan two packages' tests each run under a budget, where no test helper reaches both",
    },
    {
      members: ["sim/plan.seed_text", "std/internal.trail.seed_text"],
      reason: "a seed's text, which `sim` prints and `std.internal` may not offer a package",
    },
    {
      members: ["sim/plan.u64_text", "std/internal.trail.u64_text"],
      reason: "the text of a seed's number, which `seed_text` needs on both sides of that line",
    },
    {
      members: ["sim/search.task_text", "std/internal.schedule.task_name"],
      reason: "how a trace names a task, on both sides of the line `std.internal` draws",
    },
    {
      members: ["std/idna.status_of", "std/list.below_eight"],
      reason: "a three-bit mask that is a status in one module and a count its laws draw in the other",
    },
  ]

type Member = { name: String, module: String }

fn takes_parameters(ty: String) -> Bool / {abort.raise} = {
  let params = if ty.starts_with("<") { ty.slice(generics_end(ty), ty.len()) } else { ty };
  params.starts_with("(") && !params.starts_with("()")
}

fn generics_end(ty: String) -> Int =
  range(0, ty.len()).fold({ depth: 0, end: 0 }, |s: { depth: Int, end: Int }, i: Int|
    if s.end > 0 { s } else {
      let c = ty.slice(i, i + 1);
      let depth = if c == "<" { s.depth + 1 } else if c == ">" { s.depth - 1 } else { s.depth };
      { depth: depth, end: if depth == 0 { i + 1 } else { 0 } }
    }).end

fn in_package(file: String) -> Bool = !file.starts_with("/") && !file.starts_with("../")

fn own_module(pkg: String, d: Json) -> Option<String> / {abort.raise} = {
  let module = str(at(d, "module"));
  if !in_package(str(at(d, "file"))) { None }
  else if module.starts_with(pkg ++ ".") { Some(module.slice(pkg.len() + 1, module.len())) }
  else { Some(module) }
}

fn by_hash() -> Map<String, List<Member>> / {PlyProcess, Repo, abort.raise} = {
  let every = packages();
  let listed = spawned_together(every.map(|l: PackageListing| l.line));
  range(0, every.len()).fold(Map::new(), |accumulator: Map<String, List<Member>>, i: Int| {
    let pkg = every.get(i).pkg;
    let v = json_of(listed.at_or(i, { out: [], err: [], code: 1 }));
    items(at(v, "definitions")).fold(accumulator, |m: Map<String, List<Member>>, d: Json| {
      match own_module(pkg, d) {
        Some(module) -> if !takes_parameters(str(at(d, "type"))) { m } else {
          let hash = str(at(d, "hash"));
          let simple = str(at(d, "simple_name"));
          m.insert(
            hash,
            m.get_or(hash, []).push({
              name: pkg ++ "/" ++ module ++ "." ++ simple,
              module: pkg ++ "/" ++ module,
            }),
          )
        },
        None -> m,
      }
    })
  })
}

test/nondet "no two modules define the same function" {
  let copies = by_hash().values().fold([], |accumulator: List<List<String>>, ms: List<Member>|
    if ms.fold([], |seen: List<String>, x: Member| seen.push_unique(x.module)).len() < 2 {
      accumulator
    } else { accumulator.push(ms.map(|x: Member| x.name).sort()) });
  let allowed = allowed_copies().map(|k: { members: List<String>, reason: String }| k.members);
  let unexplained = copies.filter(|c: List<String>| !allowed.contains(c));
  let stale = allowed.filter(|k: List<String>| !copies.contains(k));
  let lines = |groups: List<List<String>>|
    String::join(groups.map(|g: List<String>| String::join(g, " ")), "\n  ");
  assert(
    unexplained == [] && stale == [],
    Some(
      "functions more than one module defines; keep the copy every caller reaches:\n  "
        ++ lines(unexplained)
        ++ "\ncopies `kept` names that no longer hash alike:\n  "
        ++ lines(stale),
    ),
  )
}

test "`takes_parameters` is true for a function type with parameters, even a generic one, and false for a type with none" {
  assert(takes_parameters("(Int) -> Int"));
  assert(takes_parameters("<a>(List<a>, Int) -> Option<a>"));
  assert(!takes_parameters("() -> Int"));
  assert(!takes_parameters("<a>() -> List<a>"))
}

test "`in_package` is true for a module in the package's own directory and false for a dependency's file" {
  assert(in_package("hash/legacy.ply"));
  assert(in_package("hash.ply"));
  assert(!in_package("/repo/packages/proof/engine.ply"));
  assert(!in_package("../proof/engine.ply"))
}
