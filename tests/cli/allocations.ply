import harness (PlyProcess, spawned)
import support.harness (WorkingDirectory, write_program, json_of, at, int)

fn blocks(program: String) -> Int / {PlyProcess, WorkingDirectory, abort.raise} = {
  write_program(program);
  int(at(json_of(spawned(["run", "--json", "m.ply"])), "runtime_blocks"))
}

fn list_writes_of(n: Int) -> String =
  \\fn fill(xs: List<Int>, i: Int) -> List<Int> / {abort.raise} =
  \\  if i >= xs.len() { xs } else { fill(xs.set(i, i), i + 1) }
  \\fn main() -> Int / {abort.raise} = fill(range(0,
    ++ n.to_string()
    ++ "), 0).len()\n"

fn shared_list_writes_of(n: Int) -> String =
  \\fn fill(xs: List<Int>, i: Int) -> List<Int> / {abort.raise} =
  \\  if i >= xs.len() { xs } else {
  \\    let written = xs.set(i, i);
  \\    if xs.len() < 0 { xs } else { fill(written, i + 1) }
  \\  }
  \\fn main() -> Int / {abort.raise} = fill(range(0,
    ++ n.to_string()
    ++ "), 0).len()\n"

fn array_writes_of(n: Int) -> String =
  \\fn fill(xs: Array<Int>, i: Int) -> Array<Int> / {abort.raise} =
  \\  if i >= xs.len() { xs } else { fill(xs.set(i, i), i + 1) }
  \\fn main() -> Int / {abort.raise} = fill(Array::new(
    ++ n.to_string()
    ++ ", 0), 0).len()\n"

fn held_queue_of(n: Int) -> String =
  \\fn turned(s: {work: List<Int>, n: Int}, left: Int) -> Int =
  \\  if left <= 0 { s.n } else {
  \\    match s.work {
  \\      [x, ..rest] -> turned({work: rest.push(x), n: s.n + 1}, left - 1),
  \\      [] -> 0,
  \\    }
  \\  }
  \\fn main() -> Int = turned({work: range(0, 500), n: 0},
    ++ n.to_string()
    ++ ")\n"

fn few_blocks() -> Int = 40

test/nondet "a list handed down to its last holder is written in place at every step" {
  let small = blocks(list_writes_of(100));
  let large = blocks(list_writes_of(1000));
  assert(large - small < few_blocks(), Some(small.to_string() ++ " and " ++ large.to_string()))
}

test/nondet "an array handed down to its last holder is written in place at every step" {
  let small = blocks(array_writes_of(100));
  let large = blocks(array_writes_of(1000));
  assert(large - small < few_blocks(), Some(small.to_string() ++ " and " ++ large.to_string()))
}

test/nondet "a queue something else holds takes the next slot at every step, copying only to grow" {
  let small = blocks(held_queue_of(100));
  let large = blocks(held_queue_of(1000));
  assert(large - small < few_blocks(), Some(small.to_string() ++ " and " ++ large.to_string()))
}

test/nondet "a list something else still holds copies at every step, and the count shows it" {
  let small = blocks(shared_list_writes_of(100));
  let large = blocks(shared_list_writes_of(1000));
  assert(large - small >= 900, Some(small.to_string() ++ " and " ++ large.to_string()))
}
