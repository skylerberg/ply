import harness (spawned, RunResult, write_project, write_program, repo_file, reserve_port,
                start_server, connection, send, read_until_closed, wait_for_exit, completed_result,
                stderr, json_of, at, path, items, str, int, bool, json_text)
import std.json (Json)
import std.string

fn report_of(ran: RunResult) -> Json / {abort.raise} = json_of(ran)

fn assert_green(report: Json, what: String) -> Unit / {abort.raise} = {
  let failures = String::join(
    items(at(report, "failures")).map(|f: Json|
      str(at(f, "name")) ++ ": " ++ str(path(f, ["diagnostic", "code"])) ++ " "
        ++ str(path(f, ["diagnostic", "message"]))),
    "\n",
  );
  let reason = if failures == "" { json_text(at(report, "summary")) } else { failures };
  assert(bool(at(report, "ok")), Some(what ++ " is red:\n" ++ reason));
  assert(int(path(report, ["summary", "failed"])) == 0, Some(what ++ " is red:\n" ++ reason))
}

fn assert_entered(report: Json, what: String) -> Unit / {abort.raise} =
  assert(
    int(path(report, ["backend", "entered"])) > 0,
    Some(
      what ++ " entered nothing, so the run is green over a seam no call reached: "
        ++ json_text(at(report, "backend")),
    ),
  )

test/nondet "the C backend parses a JSON array of 100,000 elements without nesting, and its tests pass" {
  write_program(String::of_bytes_lossy(embed("../programs/backend_programs/long_array.ply")));
  let report = report_of(spawned(["test", ".", "--no-cache", "--json"]));
  assert_green(report, "a long array on the C backend");
  assert_entered(report, "the C backend")
}

test/nondet "the `hello` example responds to one HTTP connection with its greeting and then exits" {
  let port = reserve_port();
  write_project([{ path: "hello.ply", text: repo_file("examples/hello.ply") }]);
  let server = start_server(
    ["run", "--set", "HELLO_PORT=" ++ port.to_string(), "--set", "HELLO_CONNECTIONS=1"],
    [],
    port,
  );
  let c = connection(server);
  send(c, b"GET / HTTP/1.1\r\nHost: x\r\n\r\n");
  let result = read_until_closed(c, 30000);
  let out = completed_result(
    wait_for_exit(server, 30000, "the server did not return after its one connection"),
  );
  assert(
    result.contains("hello from ply"),
    Some("the server did not respond to the request:\n" ++ result ++ "\n" ++ stderr(out)),
  );
  assert(out.code == 0, Some("the run exited " ++ out.code.to_string() ++ ":\n" ++ stderr(out)))
}

fn literal_of(n: Int) -> String / {abort.raise} =
  "b\""
    ++ String::join(
      range(0, n).map(|i: Int| {
        let b = i % 251;
        if b < 32 || b > 126 || b == 34 || b == 92 { "\\x" ++ hex_byte(b) }
        else { String::of_bytes(byte_of_int(b)) }
      }),
      "",
    )
    ++ "\""

fn hex_byte(b: Int) -> String / {abort.raise} = {
  let digits = "0123456789abcdef";
  digits.slice(b / 16, b / 16 + 1) ++ digits.slice(b % 16, b % 16 + 1)
}

test/nondet "the C backend hashes a long input consistently" {
  write_project([
    { path: "input.ply", text: "pub fn long() -> Bytes = " ++ literal_of(65536) ++ "\n" },
    {
      path: "h.ply",
      text:
        \\import std.hash (blake3)
        \\import input (long)
        \\test "a long input hashes to a stable digest" {
        \\  assert_eq(blake3(long()), blake3(long()))
        \\}
        \\pub fn digest() -> Bytes = blake3(long())
        \\
    },
  ]);
  assert_green(
    report_of(spawned(["test", ".", "--no-cache", "--json"])),
    "the C backend over a long input",
  )
}
