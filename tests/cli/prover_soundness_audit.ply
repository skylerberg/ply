import spawning.harness (spawned, write_program, all_output, stderr, at, path, items, str, int,
                         bool, json_text, outcome_of, proved, proved_here, rules_of)
import std.json (Json, Null, Str, Object, Array)
import std.string
import std.list

const unfold_depth: Int = 3

fn obligation(report: Json, needle: String) -> Json / {abort.raise} =
  match items(at(report, "obligations")).filter(|o: Json| str(at(o, "label")).contains(needle)) {
    [o, ..] -> o,
    [] -> panic("no obligation labelled `" ++ needle ++ "` in " ++ json_text(report)),
  }

fn reason(o: Json) -> String = str(at(o, "reason"))

fn laws_in(source: String) -> Int =
  source.split("\n").filter(|line: String| line.starts_with("law \"")).len()

fn never_proved(report: Json, needle: String) -> Json / {abort.raise} = {
  let o = obligation(report, needle);
  assert(outcome_of(o) != "proved", Some("`" ++ needle ++ "` came back proved: " ++ json_text(o)));
  o
}

test/nondet "no false claim is ever proved" {
  let report = proved(
    \\type Color = Red | Green | Blue
    \\type Wrap = W(Color)
    \\
    \\fn score(c: Color) -> Int = match c { Red -> 1, Green -> 2, Blue -> 3 }
    \\fn unwrapped(w: Wrap) -> Int = match w { W(Red) -> 1, _ -> 2 }
    \\fn is_red(c: Color) -> Bool = match c { Red -> true, _ -> false }
    \\
    \\// Division is uninterpreted: nothing follows from it, not even with a literal divisor.
    \\law "halving" forall (x: Int) { x / 2 * 2 == x }
    \\law "by one" forall (x: Int) { x / 1 == x }
    \\law "modulo" forall (x: Int) { x % 1 == 0 }
    \\// `x * y` with both factors symbolic is not linear arithmetic.
    \\law "square" forall (x: Int) { x * x >= x }
    \\// Two distinct uninterpreted symbols are neither provably equal nor provably distinct.
    \\law "two functions" forall (f: (Int) -> Int, g: (Int) -> Int, x: Int) { f(x) == g(x) }
    \\// A case analysis over every constructor still evaluates each arm, and one of them is 3.
    \\law "under three" forall (c: Color) { score(c) < 3 }
    \\// A nested constructor pattern is not split, so the `match` stays uninterpreted.
    \\law "always two" forall (w: Wrap) { unwrapped(w) == 2 }
    \\// `++` is uninterpreted, and congruence over the runtime description is empty about whether it commutes.
    \\law "concat commutes" forall (s: String, t: String) { s ++ t == t ++ s }
    \\// List literals are injective in their elements, which is why this is false rather than unknown.
    \\law "one element" forall (x: Int, y: Int) { [x] == [y] }
    \\// A record is its fields, so two records agreeing on one field is not extensionality.
    \\law "half a record" forall (x: Int, y: Int) { { a: x, b: 0 } == { a: x, b: y } }
    \\// The wildcard arm is reached for two of three constructors.
    \\law "always red" forall (c: Color) { is_red(c) }
    \\
  );
  [
    "\"halving\"",
    "\"by one\"",
    "\"modulo\"",
    "\"square\"",
    "\"two functions\"",
    "\"under three\"",
    "\"always two\"",
    "\"concat commutes\"",
    "\"one element\"",
    "\"half a record\"",
    "\"always red\"",
  ].fold((), |u: Unit, needle: String| {
    let o = never_proved(report, needle);
    assert(
      outcome_of(o) == "refuted" || outcome_of(o) == "unproved",
      Some("`" ++ needle ++ "` came back " ++ json_text(o)),
    )
  })
}

test/nondet "an effectful call is not a function of its arguments" {
  let o = never_proved(
    proved(
      \\effect db {
      \\  read get[r](k: Int) -> Int
      \\}
      \\
      \\fn fetch(k: Int) -> Int / {db.read[main]} = db.get[main](k)
      \\
      \\fn difference(k: Int) -> Int / {db.read[main]}
      \\  ensures result == 0
      \\= fetch(k) - fetch(k)
      \\
    ),
    "m.difference",
  );
  assert(outcome_of(o) == "unproved", Some(json_text(o)));
  assert(
    reason(o).contains("no handler"),
    Some("an ensures on an effectful definition says what stopped it: " ++ json_text(o)),
  )
}

test/nondet "a spec clause that performs an effect is rejected before the prover runs" {
  write_program(
    \\effect db {
    \\  read get[r](k: Int) -> Int
    \\}
    \\
    \\fn fetch(k: Int) -> Int / {db.read[main]} = db.get[main](k)
    \\
    \\fn echo(k: Int) -> Int / {db.read[main]}
    \\  ensures result == fetch(k)
    \\= fetch(k)
    \\
  );
  let r = spawned(["prove", "."]);
  assert(r.code == 2, Some("a spec may not perform an effect: " ++ all_output(r)));
  assert(stderr(r).contains("E0417"), Some(stderr(r)))
}

test/nondet "an unsatisfiable guard is vacuous and never proved" {
  let report = proved(
    \\law "impossible" forall (x: Int) where x > 0 && x < 0 { x == 5 }
    \\law "impossible by parity" forall (x: Int) where x % 2 == 0 && x % 2 == 1 { x == 5 }
    \\
  );
  ["\"impossible\"", "\"impossible by parity\""].fold((), |u: Unit, needle: String| {
    let o = never_proved(report, needle);
    assert(outcome_of(o) == "vacuous", Some(json_text(o)));
    assert(str(at(o, "vacuity")) == "no value satisfies the law's condition", Some(json_text(o)))
  });
  assert(int(at(report, "exit_code")) == 1, Some(json_text(report)))
}

test/nondet "a law quantifying over a type with no values is never proved" {
  let o = never_proved(
    proved("type Bad = Wrap(Bad)\n\nlaw \"a claim about nothing\" forall (b: Bad) { b == b }\n"),
    "a claim about nothing",
  );
  assert(outcome_of(o) == "unproved", Some(json_text(o)));
  assert(str(at(o, "reason_kind")) == "unwitnessed", Some(json_text(o)))
}

test/nondet "recursion stops the unfolding and the bound is named" {
  let report = proved(
    \\fn sum_to(n: Int) -> Int = if n <= 0 { 0 } else { n + sum_to(n - 1) }
    \\
    \\fn twice(x: Int) -> Int = x + x
    \\
    \\law "the sum is triangular" forall (n: Int) where n > 0
    \\  { sum_to(n) * 2 == n * n + n }
    \\law "twice is doubling" forall (x: Int) where x > -1000 && x < 1000
    \\  { twice(x) == 2 * x }
    \\
  );
  let _ = never_proved(report, "the sum is triangular");
  let twice = obligation(report, "twice is doubling");
  assert(outcome_of(twice) == "proved", Some(json_text(twice)));
  let depths = rules_of(twice, "unfold").map(|fields: Json| int(at(fields, "depth")));
  assert(
    depths != [] && depths.filter(|d: Int| d < 0 || d > unfold_depth).len() == 0,
    Some(json_text(twice)),
  )
}

type ConcurrentLaw = { label: String, header: String, first_worker_argument: String }

fn concurrency_laws(laws: List<ConcurrentLaw>) -> String =
  laws.fold(
    \\effect chan {
    \\  write put[q](v: Int) -> Unit
    \\}
    \\
    \\fn worker(v: Int) -> Unit / {chan.write[q], clock.read} = {
    \\  let t = clock.now();
    \\  chan.put[q](v)
    \\}
    \\
    ,
    |source: String, l: ConcurrentLaw|
      source ++ "\nlaw \"" ++ l.label ++ "\"" ++ l.header
        ++ " {\n  handle {\n    simulate {\n      let a = task.spawn(|| worker("
        ++ l.first_worker_argument
        ++ "));\n      let b = task.spawn(|| worker(2));\n      task.join(a);\n      task.join(b)\n    }\n  } with {\n    var got = [],\n    chan.put[q](v) -> {\n      got = got.push(v);\n    },\n    return u -> got.len() == 2,\n  }\n}\n",
  )

fn assert_interleaving_proof(o: Json) -> Unit / {abort.raise} = {
  assert(outcome_of(o) == "proved", Some(json_text(o)));
  assert(bool(path(o, ["certificate", "guard_satisfiable"])), Some(json_text(o)));
  assert(path(o, ["certificate", "sorts"]) == Array([]), Some(json_text(o)));
  let searched = rules_of(o, "exhaustive_interleaving");
  assert(
    searched.len() == 1
      && int(at(match searched.at(0) { Some(s) -> s, None -> Null }, "interleavings")) > 0,
    Some(json_text(o)),
  )
}

fn points_of(o: Json) -> List<Int> =
  rules_of(o, "exhaustive_enumeration").map(|e: Json| int(at(e, "points")))

test/nondet "a concurrency law is proved only when both domains were covered" {
  let report = proved(
    concurrency_laws([
      { label: "two writers land twice", header: "", first_worker_argument: "1" },
      {
        label: "two writers over a flip",
        header: " forall (flip: Bool)",
        first_worker_argument: "if flip { 1 } else { 3 }",
      },
      { label: "two writers over a unit", header: " forall (u: Unit)", first_worker_argument: "1" },
    ]),
  );
  let ground = obligation(report, "two writers land twice");
  assert_interleaving_proof(ground);
  assert(
    rules_of(ground, "exhaustive_enumeration") == [],
    Some(
      "a ground law has no value domain, so it names only the interleaving search: "
        ++ json_text(ground),
    ),
  );
  let flipped = obligation(report, "two writers over a flip");
  assert_interleaving_proof(flipped);
  assert(
    points_of(flipped) == [2],
    Some("both coverage claims have to be named: " ++ json_text(flipped)),
  );
  let unit = obligation(report, "two writers over a unit");
  assert_interleaving_proof(unit);
  assert(points_of(unit) == [1], Some(json_text(unit)))
}

test/nondet "a concurrency law over an `Int` is proved only when its guard bounds that `Int` to a finite range" {
  let report = proved(
    concurrency_laws([
      {
        label: "two writers over any",
        header: " forall (n: Int) where n > 0",
        first_worker_argument: "n",
      },
      {
        label: "two writers over three",
        header: " forall (n: Int) where n > 0 && n <= 3",
        first_worker_argument: "n",
      },
    ]),
  );
  let open = never_proved(report, "two writers over any");
  assert(str(at(open, "reason_kind")) == "endless", Some(json_text(open)));
  let proved_obligation = obligation(report, "two writers over three");
  assert_interleaving_proof(proved_obligation);
  assert(points_of(proved_obligation) == [3], Some(json_text(proved_obligation)))
}

test/nondet "a schedule search that is not exhaustive never proves" {
  write_program(
    concurrency_laws([{ label: "two writers land twice", header: "", first_worker_argument: "1" }]),
  );
  [["--sim", "random", "--seeds", "4"], ["--seed", "7"]].fold((), |u: Unit, flags: List<String>| {
    let _ = never_proved(proved_here(flags), "two writers land twice");
    ()
  })
}

test/nondet "a law is never proved when the prover's search does not reach the concurrent simulation inside it" {
  let report = proved(
    \\effect chan {
    \\  write put[q](v: Int) -> Unit
    \\}
    \\
    \\fn worker(v: Int) -> Unit / {chan.write[q], clock.read} = {
    \\  let t = clock.now();
    \\  chan.put[q](v)
    \\}
    \\
    \\law "sometimes concurrent" forall (flip: Bool) {
    \\  if flip {
    \\    handle {
    \\      simulate {
    \\        let a = task.spawn(|| worker(1));
    \\        let b = task.spawn(|| worker(2));
    \\        task.join(a);
    \\        task.join(b)
    \\      }
    \\    } with {
    \\      var got = [],
    \\      chan.put[q](v) -> {
    \\        got = got.push(v);
    \\      },
    \\      return u -> got.len() == 2,
    \\    }
    \\  } else {
    \\    true
    \\  }
    \\}
    \\
  );
  let _ = never_proved(report, "sometimes concurrent");
  ()
}

test/nondet "a law about a function that never returns is not proved for a program that calls it" {
  write_program(
    \\fn spin(x: Int) -> Int / {diverges} = spin(x)
    \\
    \\fn go(x: Int) -> Int / {diverges}
    \\  ensures result == spin(x)
    \\= spin(x)
    \\
    \\law "spin is a function" forall (x: Int) { spin(x) == spin(x) }
    \\
    \\law "a divisor is a function" forall (a: Int, b: Int) { a / b == a / b }
    \\
  );
  let report = proved_here(["--timeout", "300"]);
  [
    { needle: "m.go", raised: "timed out" },
    { needle: "spin is a function", raised: "timed out" },
    { needle: "a divisor is a function", raised: "division by zero" },
  ].fold((), |u: Unit, c: { needle: String, raised: String }| {
    let o = never_proved(report, c.needle);
    assert(
      outcome_of(o) == "unproved",
      Some(
        "`" ++ c.needle ++ "` is a theorem about a total symbol and not about this program: "
          ++ json_text(o),
      ),
    );
    assert(
      reason(o).starts_with("raised: ") && reason(o).contains(c.raised),
      Some(
        "`" ++ c.needle ++ "` is unproved because the program ran and raised or ran out of time: "
          ++ json_text(o),
      ),
    )
  });
  assert(int(path(report, ["coverage", "covered"])) == 0, Some(json_text(report)))
}

test/nondet "a law restricted by `where` to a narrow range far from zero is proved" {
  let o = obligation(
    proved("law \"a narrow window\" forall (x: Int) where x > 1000000 && x < 1000010 { x > 0 }\n"),
    "a narrow window",
  );
  assert(
    outcome_of(o) == "proved",
    Some("the guard admits nine values and the body is decided over all of them: " ++ json_text(o)),
  )
}

test/nondet "the prover does not prove `x == x` for any type that contains a Float, even through aliases and type declarations" {
  let source =
    \\type Rate = Float
    \\type Box<a> = B(a)
    \\type Money = Cents(Float)
    \\type Row = R({rate: Float})
    \\
    \\law "visible binder" forall (x: Float) { x == x }
    \\law "visible container" forall (xs: List<Float>) { xs == xs }
    \\law "visible map" forall (m: Map<String, Float>) { m == m }
    \\law "visible alias" forall (r: Rate) { r == r }
    \\law "visible parameter" forall (b: Box<Float>) { b == b }
    \\// These reach a `Float` through a declaration rather than the binder's written type.
    \\law "a `Wrapped` value equals itself, with `Length` inside a variant" forall (m: Money) { m == m }
    \\law "hidden in a record type" forall (r: Row) { r == r }
    \\law "hidden behind a list" forall (xs: List<Money>) { xs == xs }
    \\law "an `Option<Wrapped>` equals itself, with `Length` inside an `Option`" forall (o: Option<Money>) { o == o }
    \\
  ;
  let report = proved(source);
  let over_claimed = items(at(report, "obligations")).filter(|o: Json|
    outcome_of(o) == "proved").map(|o: Json| str(at(o, "label")));
  assert(
    over_claimed == [],
    Some(
      "these obligations mention a `Float` and came back proved: "
        ++ String::join(over_claimed, ", "),
    ),
  );
  assert(int(path(report, ["summary", "obligations"])) == laws_in(source), Some(json_text(report)))
}

test/nondet "a claim over floats is proved when it is true for every float and refuted when it is false for some" {
  let report = proved(
    "law \"a literal\" forall (n: Int) { 1.5 == 1.5 }\nlaw \"the zeros\" forall (n: Int) { -0.0 == 0.0 }\nlaw \"itself or NaN\" forall (x: Float) { x == x || x != x }\nfn clamped(x: Float) -> Float = if x >= 0.0 { if x <= 1.0 { x } else { 1.0 } } else { 0.0 }\nlaw \"a clamp\" forall (x: Float) { clamped(x) >= 0.0 && clamped(x) <= 1.0 }\nlaw \"from bits\" forall (n: Int) { Float::of_bits(n) == Float::of_bits(n) }\nlaw \"a field beside it\" forall (r: Float) { { n: 1, rate: r }.n == 1 }\n",
  );
  [
    "\"a literal\"",
    "\"the zeros\"",
    "\"itself or NaN\"",
    "\"a clamp\"",
    "\"a field beside it\"",
  ].fold((), |u: Unit, needle: String| {
    let o = obligation(report, needle);
    assert(outcome_of(o) == "proved", Some(json_text(o)))
  });
  let bits = obligation(report, "\"from bits\"");
  assert(outcome_of(bits) == "refuted", Some(json_text(bits)))
}

test/nondet "the prover refutes that equal decimals always give the same `Decimal::to_string` text" {
  let report = proved(
    "law \"print alike\" forall (x: Decimal, y: Decimal) { !(x == y) || Decimal::to_string(x) == Decimal::to_string(y) }\n",
  );
  let o = obligation(report, "\"print alike\"");
  assert(outcome_of(o) == "refuted", Some(json_text(o)))
}

test/nondet "the prover does not prove `x == x` for an unconstrained type variable, since it may be a Float" {
  let report = proved(
    "law \"any value\" forall (x: a) { x == x }\nfn same<a>(x: a) -> Bool = x == x\nlaw \"through a call\" forall (n: Int) { same(Float::of_bits(n)) }\n",
  );
  let _ = never_proved(report, "\"any value\"");
  let _ = never_proved(report, "\"through a call\"");
  ()
}

test/nondet "the prover assumes an opaque type's invariant only for values built by proved functions, so `below` is not proved" {
  let report = proved(
    \\pub opaque type Count = | Count(Int)
    \\invariant for Count by counted
    \\fn counted(c: Count) -> Bool = match c { Count(n) -> n >= 0 }
    \\pub fn zero() -> Count = Count(0)
    \\pub fn below(c: Count) -> Count = match c { Count(n) -> Count(n - 1) }
    \\pub fn size(c: Count) -> Int = match c { Count(n) -> n }
    \\law "a count is never negative" forall (c: Count) { size(c) >= 0 }
  );
  let zero = obligation(report, "zero builds");
  assert(outcome_of(zero) == "proved", Some(json_text(zero)));
  let _ = never_proved(report, "below builds");
  let law = obligation(report, "\"a count is never negative\"");
  assert(outcome_of(law) == "proved", Some(json_text(law)));
  assert(
    !items(at(report, "obligations")).any(|o: Json| str(at(o, "label")).contains("size builds")),
  )
}

test/nondet "the prover proves no law that compares values of a type with a `key` function" {
  let source = String::of_bytes_lossy(
    embed("../programs/prover_soundness_audit/keyed_value_obligation.ply"),
  );
  let report = proved(source);
  let over_claimed = items(at(report, "obligations")).filter(|o: Json|
    outcome_of(o) == "proved"
      && !str(at(o, "label")).contains(
        "equal `Plain` values give the same `number`, for a type with no key declared",
      )).map(|o: Json| str(at(o, "label")));
  assert(
    over_claimed == [],
    Some(
      "these obligations contain a value compared by a `key` and came back proved: "
        ++ String::join(over_claimed, ", "),
    ),
  );
  let plain = obligation(
    report,
    "equal `Plain` values give the same `number`, for a type with no key declared",
  );
  assert(outcome_of(plain) == "proved", Some(json_text(plain)));
  let written = obligation(report, "written out");
  let made = obligation(report, "instantiated");
  assert(
    reason(made) == reason(written) && outcome_of(made) == outcome_of(written),
    Some(json_text(made)),
  );
  assert(int(path(report, ["summary", "obligations"])) == laws_in(source), Some(json_text(report)))
}

test/nondet "the prover proves no law that uses `+` or `-` on a type with a custom `numeric` definition" {
  let source =
    \\type Wrapped = | Wrapped(Int)
    \\numeric for Wrapped by { add: plus, sub: plus, mul: plus, neg: same, of_int: of }
    \\fn held(w: Wrapped) -> Int = match w { Wrapped(n) -> n }
    \\fn plus(a: Wrapped, b: Wrapped) -> Wrapped = Wrapped((held(a) + held(b)) % 7)
    \\fn same(a: Wrapped) -> Wrapped = a
    \\fn of(n: Int) -> Wrapped = Wrapped(n % 7)
    \\
    \\law "adding is the integers'" forall (n: Int) where n > 3 && n < 9 {
    \\  held(Wrapped(n) + Wrapped(n)) == n + n
    \\}
    \\law "subtracting undoes adding" forall (a: Wrapped, b: Wrapped) { a + b - b == a }
    \\law "an operator over a binder" forall (a: Wrapped) { held(a + a) == held(a + a) }
    \\law "the integers still add" forall (n: Int) where n > 0 && n < 9 { n + n == 2 * n }
    \\
  ;
  let report = proved(source);
  let over_claimed = items(at(report, "obligations")).filter(|o: Json|
    outcome_of(o) == "proved" && !str(at(o, "label")).contains("the integers still add")).map(
    |o: Json| str(at(o, "label")),
  );
  assert(
    over_claimed == [],
    Some(
      "these obligations compute at a type that states its own arithmetic and came back proved: "
        ++ String::join(over_claimed, ", "),
    ),
  );
  let plain = obligation(report, "the integers still add");
  assert(outcome_of(plain) == "proved", Some(json_text(plain)));
  assert(int(path(report, ["summary", "obligations"])) == laws_in(source), Some(json_text(report)))
}

test/nondet "the prover proves no `ensures` or law about a public type whose variant contains a Float" {
  let report = proved(
    "pub type Money = Cents(Float)\npub fn keep(m: Money) -> Money\n  ensures result == m\n= m\nlaw \"destructured\" forall (m: Money) { match m { Cents(x) -> x == x } }\n",
  );
  let _ = never_proved(report, "m.keep");
  let _ = never_proved(report, "destructured");
  ()
}

test/nondet "the prover proves equalities of `Decimal` values but not their addition, commutativity or ordering" {
  let report = proved(
    "fn scaled(d: Decimal) -> Decimal = d\nlaw \"congruence\" forall (x: Decimal) { scaled(x) == scaled(x) }\nlaw \"additive\" forall (x: Decimal) { x + 0m == x }\nlaw \"commutes\" forall (x: Decimal, y: Decimal) { x + y == y + x }\nlaw \"ordered\" forall (x: Decimal) { x >= x }\nlaw \"scale is value\" forall (n: Int) { 1.5m == 1.50m }\n",
  );
  ["\"congruence\"", "\"scale is value\""].fold((), |u: Unit, needle: String| {
    let o = obligation(report, needle);
    assert(outcome_of(o) == "proved", Some(json_text(o)))
  });
  ["\"additive\"", "\"commutes\"", "\"ordered\""].fold((), |u: Unit, needle: String| {
    let _ = never_proved(report, needle);
    ()
  })
}

test/nondet "the prover treats a map as an opaque value and proves no law about its contents" {
  let report = proved(
    "law \"reflexive\" forall (m: Map<String, Int>) { m == m }\nlaw \"get after insert\" forall (m: Map<String, Int>, k: String, v: Int) { m.insert(k, v).get(k) == Some(v) }\nlaw \"insert grows\" forall (m: Map<String, Int>, k: String, v: Int) { m.insert(k, v).len() == m.len() + 1 }\nlaw \"keys match len\" forall (m: Map<String, Int>) { m.keys().len() == m.len() }\n",
  );
  assert(outcome_of(obligation(report, "\"reflexive\"")) == "proved", Some(json_text(report)));
  ["get after insert", "insert grows", "keys match len"].fold((), |u: Unit, needle: String| {
    let _ = never_proved(report, needle);
    ()
  })
}

test/nondet "the prover treats the `Bytes` builtins as unknown functions and proves no law about their results" {
  let report = proved(
    "law \"index of self\" forall (b: Bytes) { b.index_of(b) == Some(0) }\nlaw \"empty needle\" forall (b: Bytes) { b.index_of(b\"\") == Some(0) }\nlaw \"starts with itself\" forall (b: Bytes) { b.starts_with(b) }\nlaw \"scan is bounded\" forall (b: Bytes, f: Int, s: Bytes, m: Int) { b.scan(f, s, m) <= f + m }\nlaw \"split rejoins\" forall (b: Bytes) { b.split(b\",\").len() >= 1 }\nlaw \"two literals\" forall (n: Int) { b\"ab\" == b\"ab\" }\n",
  );
  [
    "index of self",
    "empty needle",
    "starts with itself",
    "scan is bounded",
    "split rejoins",
    "two literals",
  ].fold((), |u: Unit, needle: String| {
    let _ = never_proved(report, needle);
    ()
  })
}

test/nondet "a law that calls a function stored in a record is proved only if the stored function makes it true" {
  let report = proved(
    "pub type Point = P(Int)\nfn point_eq() -> {eq: (Point, Point) -> Bool} = {eq: |a: Point, b: Point| a == b}\nlaw \"eq is reflexive\" forall (p: Point) { (point_eq().eq)(p, p) }\nlaw \"eq is never true\" forall (p: Point) { !(point_eq().eq)(p, p) }\n",
  );
  let reflexive = obligation(report, "\"eq is reflexive\"");
  assert(outcome_of(reflexive) == "proved", Some(json_text(reflexive)));
  let _ = never_proved(report, "\"eq is never true\"");
  ()
}
