//! `ply new`: the first thirty seconds of a package. The scaffold is only as good as what it makes,
//! so every test here goes on to build over the tree a run created.

import harness (spawned, scratch, on_disk, write_project, write, read, stdout, stderr, all_output,
                json_of, at, items, str, int, bool, json_text, own_modules, value_of)
import std.fs (fs)
import std.json (Json)

fn written(path: String) -> String / {fs.read[cwd], fs.write[cwd], abort.raise} =
  match read(path) { Some(t) -> t, None -> panic("`" ++ path ++ "` was not written") }

test/nondet "a new package checks, tests and formats as it stands" {
  write_project([]);
  let made = on_disk(["new", "demo"]);
  assert(made.code == 0, Some(stderr(made)));
  assert_eq(stdout(made), "   created demo · ply.pkg, main.ply\n   next: cd demo && ply run .\n");
  let manifest = written("demo/ply.pkg");
  assert(manifest.contains("name: \"demo\""), Some(manifest));
  assert(manifest.contains("runtime: { major: 0,"), Some(manifest));
  let module = written("demo/main.ply");
  assert(module.contains("fn main() -> Unit"), Some(module));
  assert(module.contains("test \"the first test\""), Some(module));
  // The scaffold is what the language already accepts: a check, a green test, and `fmt`-clean.
  let checked = json_of(on_disk(["check", "demo", "--json"]));
  assert_eq(own_modules(checked), ["main"]);
  let loaded = items(at(checked, "modules")).len();
  [
    { argv: ["check", "demo"], want: "checked " ++ loaded.to_string() ++ " modules" },
    { argv: ["test", "demo"], want: "1 passed" },
    { argv: ["fmt", "--check", "demo"], want: "" },
  ].fold((), |u: Unit, step: { argv: List<String>, want: String }| {
    let r = spawned(step.argv);
    assert(r.code == 0 && all_output(r).contains(step.want), Some(all_output(r)))
  })
}

test/nondet "a library has no main and one public definition" {
  write_project([]);
  assert_eq(on_disk(["new", "core", "--lib"]).code, 0);
  let module = written("core/lib.ply");
  assert(module.contains("pub fn double"), Some(module));
  assert(!module.contains("fn main"), Some(module));
  assert_eq(spawned(["test", "core"]).code, 0);
  // Nothing to run, and the run says so rather than picking the library's first definition.
  let ran = spawned(["run", "core"]);
  assert_eq(ran.code, 2);
  assert(stderr(ran).contains("no `main` to run"), Some(stderr(ran)))
}

test "the JSON output names the package, the directory and the files" {
  scratch(|| {
    write_project([]);
    let v = json_of(on_disk(["new", "store/orders", "--json"]));
    assert_eq(str(at(v, "command")), "new");
    assert(bool(at(v, "ok")), Some(json_text(v)));
    assert_eq(int(at(v, "exit_code")), 0);
    assert_eq(str(at(v, "name")), "orders");
    assert_eq(str(at(v, "path")), "store/orders");
    assert(!bool(at(v, "lib")), Some(json_text(v)));
    assert_eq(items(at(v, "files")).map(str), ["ply.pkg", "main.ply"]);
    assert(fs.exists[cwd]("store/orders/ply.pkg"), Some("the manifest is there"))
  })
}

test "a name the package shape does not allow is rejected before anything is written" {
  scratch(|| {
    write_project([]);
    ["Bad", "my-app", "9lives", "a..b"].fold((), |u: Unit, bad: String| {
      let r = on_disk(["new", bad]);
      assert(r.code == 2, Some(bad));
      assert(stderr(r).contains("is not a package name"), Some(bad ++ ": " ++ stderr(r)));
      assert(stderr(r).contains("E0502"), Some(bad ++ ": " ++ stderr(r)));
      assert(!fs.exists[cwd](bad), Some("`" ++ bad ++ "` was made anyway"))
    });
    // The name can be given instead of derived, which is how a directory that is not a package name
    // becomes one.
    assert_eq(on_disk(["new", "lib-src", "--name", "core"]).code, 0);
    assert(written("lib-src/ply.pkg").contains("name: \"core\""), Some("the given name"))
  })
}

test "a directory that is already there is never written into" {
  scratch(|| {
    write_project([
      { path: "demo.ply", text: "fn main() -> Int = 1\n" },
      { path: "demo/keep", text: "mine\n" },
    ]);
    let r = on_disk(["new", "demo"]);
    assert_eq(r.code, 2);
    assert(stderr(r).contains("is already there"), Some(stderr(r)));
    assert_eq(written("demo/keep"), "mine\n");
    assert(!fs.exists[cwd]("demo/ply.pkg"), Some("the manifest was written into it"))
  })
}

test/nondet "a scaffolded project is a package a dependency can be added to" {
  write_project([]);
  assert_eq(on_disk(["new", "core", "--lib"]).code, 0);
  assert_eq(on_disk(["new", "app"]).code, 0);
  // The generated manifest is a manifest: adding a dependency to it is an edit a reader can make,
  // and the root over it then reaches the library's own module.
  write(
    "app/ply.pkg",
    \\import std.pkg (Manifest)
    \\fn package() -> Manifest = {name: "app", version: {major: 0, minor: 1, patch: 0}, prefix: None, runtime: {major: 0, minor: 1, patch: 0}, dependencies: [{name: "core", prefix: None, min: {major: 0, minor: 1, patch: 0}, source: Path("../core")}], entry: None}
    \\
  );
  write("app/main.ply", "import core.lib\n\nfn main() -> Int = lib::double(21)\n");
  assert_eq(value_of(spawned(["run", "--json", "app"])), "42")
}
