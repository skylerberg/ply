import spawning.harness (WorkingDirectory, PlyProcess, spawned, write_program, write_project,
                         embedded_sources, json_of, at, path, items, str, int, json_text, Source,
                         outcome_of, proved, proved_here, rules_of)
import examples (example_files)
import std.json
import std.json (Json, Null, Str, Object, Array)
import std.string
import std.list

fn audit_sources() -> List<Source> / {abort.raise} =
  embedded_sources(example_files(), "examples").concat([
    fixture("refuted_law", embed("../fixtures/refuted_law.ply")),
    fixture("vacuous_law", embed("../fixtures/vacuous_law.ply")),
    fixture("obligation_not_discharged", embed("../fixtures/obligation_not_discharged.ply")),
  ])

fn fixture(name: String, text: Bytes) -> Source / {abort.raise} =
  { path: "tests/fixtures/" ++ name ++ ".ply", text: String::of_bytes(text) }

fn prove_report(
  relative: String,
  flags: List<String>,
) -> Json / {PlyProcess, WorkingDirectory, abort.raise} = {
  write_project(audit_sources());
  json_of(spawned(["prove", relative, "--no-cache", "--json"].concat(flags)))
}

fn obligations(report: Json) -> List<Json> = items(at(report, "obligations"))

fn obligation(report: Json, needle: String) -> Json / {abort.raise} =
  match obligations(report).filter(|o: Json| str(at(o, "label")).contains(needle)) {
    [o, ..] -> o,
    [] -> panic("no obligation labelled `" ++ needle ++ "` in " ++ json_text(report)),
  }

fn without_costs(report: Json) -> Json =
  match report {
    Object(m) -> Object(m.insert("duration_ms", Null).insert("front_end", Null)),
    other -> other,
  }

test/nondet "two runs over one program agree" {
  ["examples/bank.ply", "examples/ledger.ply", "tests/fixtures/refuted_law.ply"].fold(
    (),
    |u: Unit, relative: String|
      assert(
        without_costs(prove_report(relative, ["--jobs", "1"]))
          == without_costs(prove_report(relative, ["--jobs", "4"])),
        Some("in " ++ relative),
      ),
  )
}

test/nondet "a refutation names the point it fails at" {
  let o = obligation(
    prove_report("tests/fixtures/refuted_law.ply", []),
    "`settled` returns a list as long as the payments it is given",
  );
  assert(outcome_of(o) == "refuted", Some("the fixture exists to be refuted: " ++ json_text(o)));
  assert(items(path(o, ["counterexample", "bindings"])) != [], Some(json_text(o)))
}

test/nondet "a finite domain is proved by covering it" {
  let o = obligation(
    proved("law \"excluded middle\" forall (b: Bool) { b || !b }\n"),
    "excluded middle",
  );
  assert(outcome_of(o) == "proved", Some(json_text(o)));
  assert(
    rules_of(o, "exhaustive_enumeration").filter(|e: Json| int(at(e, "points")) == 2).len() > 0
      || rules_of(o, "propositional") != [],
    Some(json_text(o)),
  )
}

test/nondet "a ground law is proved by evaluating it, not just checked on example values" {
  let o = obligation(
    proved(
      \\fn stock() -> String = "abc"
      \\
      \\law "the stock is three deep" {
      \\  stock().len() == 3
      \\}
      \\
    ),
    "the stock is three deep",
  );
  assert(outcome_of(o) == "proved", Some(json_text(o)));
  assert(rules_of(o, "ground_evaluation") != [], Some(json_text(o)))
}

test/nondet "a recursive definition is never unfolded" {
  let report = proved(
    \\fn rev_onto(xs: List<Int>, acc: List<Int>) -> List<Int> =
    \\  match xs {
    \\    [x, ..rest] -> rev_onto(rest, acc.push(x)),
    \\    _ -> acc,
    \\  }
    \\
    \\fn rev(xs: List<Int>) -> List<Int> = rev_onto(xs, [])
    \\
    \\law "reverse is an involution"
    \\  forall (xs: List<Int>) {
    \\    rev(rev(xs)) == xs
    \\  }
    \\
  );
  assert(
    outcome_of(obligation(report, "reverse is an involution")) == "unproved",
    Some("a claim over unbounded data cannot be decided without induction"),
  )
}

test/nondet "a law can use an earlier law as a lemma, and the proof names both the induction and the lemma" {
  let report = proved(
    \\fn reverse(xs: List<Int>) -> List<Int> =
    \\  match xs { [] -> [], [x, ..rest] -> reverse(rest).push(x) }
    \\
    \\law "a push reversed leads" forall (ys: List<Int>, x: Int) {
    \\  match reverse(ys.push(x)) { [h, ..t] -> h == x && t == reverse(ys), [] -> false }
    \\}
    \\
    \\law "reverse twice is identity" forall (xs: List<Int>) { reverse(reverse(xs)) == xs }
    \\
  );
  let twice = obligation(report, "reverse twice is identity");
  assert_eq(outcome_of(twice), "proved");
  assert_eq(rules_of(twice, "induction").map(|r: Json| str(at(r, "over"))), ["list"]);
  assert_eq(rules_of(twice, "lemma").map(|r: Json| str(at(r, "label"))), ["a push reversed leads"]);
  assert(
    str(at(at(twice, "certificate"), "summary")).contains("structural induction on xs"),
    Some(json_text(twice)),
  )
}

test/nondet "a law using an operation the prover cannot reason about, such as integer division, is never proved" {
  let o = obligation(
    proved("law \"halving and doubling cancel\"\n  forall (x: Int) {\n    x / 2 * 2 == x\n  }\n"),
    "halving and doubling cancel",
  );
  assert(
    outcome_of(o) == "refuted",
    Some("an uninterpreted `/` must not be reasoned about: " ++ json_text(o)),
  )
}

test/nondet "an uninterpreted function closes under congruence" {
  let o = obligation(
    proved(
      "law \"a pure function is a function\"\n  forall (f: (Int) -> Int, x: Int) {\n    f(x) == f(x)\n  }\n",
    ),
    "a pure function is a function",
  );
  assert(outcome_of(o) == "proved", Some(json_text(o)));
  assert(rules_of(o, "congruence") != [], Some(json_text(o)))
}

test/nondet "a law over arbitrary function arguments is unproved, not refuted, and has no counterexample" {
  let o = obligation(
    proved(
      "law \"two functions agree\"\n  forall (f: (Int) -> Int, g: (Int) -> Int, x: Int) {\n    f(x) == g(x)\n  }\n",
    ),
    "two functions agree",
  );
  assert(outcome_of(o) == "unproved", Some(json_text(o)));
  assert(at(o, "counterexample") == Null, Some(json_text(o)))
}

test/nondet "a proved polymorphic law records its type variables in the proof" {
  let o = obligation(
    proved(
      "fn pair<a>(x: a) -> a = x\n\nlaw \"identity is identity\"\n  forall (x: a) where identity(a) {\n    pair(x) == x\n  }\n",
    ),
    "identity is identity",
  );
  assert(outcome_of(o) == "proved", Some(json_text(o)));
  assert(
    path(o, ["certificate", "sorts"]) == Array([Str("a")]),
    Some(
      "a proof over a type variable names the sort it left uninterpreted as the binder prints it: "
        ++ json_text(o),
    ),
  )
}

test/nondet "a spent budget leaves the claim unproved and says so" {
  let label = "below, equal to, or above";
  write_program(
    "law \"one is below, equal to, or above the other\"\n  forall (x: Int, y: Int) {\n    (x < y) || (x == y) || (x > y)\n  }\n",
  );
  let decided = obligation(proved_here([]), label);
  assert(
    outcome_of(decided) == "proved",
    Some(
      "case analysis over the comparisons decides this when the budget allows: "
        ++ json_text(decided),
    ),
  );
  assert(
    int(path(decided, ["certificate", "steps"])) > 1,
    Some(
      "a law a budget of one already resolves cannot test what a spent one does: "
        ++ json_text(decided),
    ),
  );
  let starved = obligation(proved_here(["--prove-budget", "1"]), label);
  assert(
    outcome_of(starved) == "unproved",
    Some("a spent budget is inconclusive, and inconclusive is no proof: " ++ json_text(starved)),
  );
  assert(str(at(starved, "reason")).contains("budget"), Some(json_text(starved)))
}

test/nondet "an unsatisfiable guard is vacuous rather than proved" {
  let report = prove_report("tests/fixtures/vacuous_law.ply", []);
  assert(obligations(report) != [], Some(json_text(report)));
  obligations(report).fold((), |u: Unit, o: Json| {
    assert(outcome_of(o) == "vacuous", Some(json_text(o)));
    assert(at(o, "certificate") == Null, Some(json_text(o)))
  })
}

test/nondet "a claim nothing proves says what stopped it" {
  let report = prove_report("tests/fixtures/obligation_not_discharged.ply", []);
  let recorded = obligation(report, "recorded");
  assert(outcome_of(recorded) == "unproved", Some(json_text(recorded)));
  assert(str(at(recorded, "reason")).contains("no handler"), Some(json_text(recorded)));
  let share = obligation(report, "share");
  assert(outcome_of(share) == "unproved", Some(json_text(share)));
  assert(
    str(at(share, "reason")).starts_with("raised: ")
      && str(at(share, "reason")).contains("division by zero"),
    Some(json_text(share)),
  );
  assert(
    at(recorded, "certificate") == Null && at(share, "certificate") == Null,
    Some(json_text(report)),
  );
  assert(int(at(report, "exit_code")) == 1, Some(json_text(report)))
}

test/nondet "a ground concurrency law whose search is exhaustive is proved" {
  let label = "two concurrent 60-unit transfers from alice's 100-unit account never overdraw it";
  let o = obligation(prove_report("examples/bank.ply", ["--filter", label]), label);
  assert(outcome_of(o) == "proved", Some(json_text(o)));
  assert(
    rules_of(o, "exhaustive_interleaving") != [],
    Some("an execution-derived proof names the rule that says so: " ++ json_text(o)),
  );
  let once = obligation(
    prove_report("examples/bank.ply", ["--filter", label, "--seed", "7"]),
    label,
  );
  assert(outcome_of(once) == "unproved", Some(json_text(once)));
  assert(str(at(once, "reason_kind")) == "unsearched", Some(json_text(once)))
}

test/nondet "a precondition alone is not an obligation" {
  let report = proved(
    "fn withdraw(balance: Int, amount: Int) -> Int\n  requires amount > 0\n= balance - amount\n",
  );
  assert(
    obligations(report) == [],
    Some("a `requires` is a filter on a domain, not a claim to discharge: " ++ json_text(report)),
  )
}

test/nondet "each postcondition is an obligation of its own" {
  let report = prove_report("examples/ledger.ply", []);
  let outcomes = obligations(report).filter(|o: Json|
    str(at(o, "owner")).ends_with("ledger.transfer") && str(at(o, "kind")) == "ensures").map(
    outcome_of,
  );
  assert(
    outcomes == ["proved", "proved"],
    Some("one clause per obligation: " ++ String::join(outcomes, ", ")),
  )
}

test/nondet "a law over `List::at` indexing is proved, but a law over `Bytes::at`, which can raise, is not" {
  let report = proved(
    \\fn peek(xs: List<Int>, i: Int) -> Int =
    \\  match xs.at(i) { Some(v) -> v, None -> 0 }
    \\
    \\fn bpeek(b: Bytes, i: Int) -> Int / {abort.raise} = b.at(i)
    \\
    \\law "a total index peeks at every index"
    \\  forall (xs: List<Int>, i: Int) {
    \\    peek(xs, i) == peek(xs, i)
    \\  }
    \\
    \\law "a raising index does not"
    \\  forall (b: Bytes, i: Int) {
    \\    bpeek(b, i) == bpeek(b, i)
    \\  }
    \\
  );
  assert(
    outcome_of(obligation(report, "a total index peeks at every index")) == "proved",
    Some("an unguarded `List::at` peek is a value, so the claim is a case split over its answer"),
  );
  let raising = obligation(report, "a raising index does not");
  assert(
    outcome_of(raising) == "unproved",
    Some(
      "the control must raise, or the arm above is compared with nothing: " ++ json_text(raising),
    ),
  );
  assert(
    str(at(raising, "reason")).starts_with("raised: `Bytes::at` index"),
    Some("the control raises at its index: " ++ json_text(raising)),
  )
}
