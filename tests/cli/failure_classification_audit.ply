//! Every runtime failure the language defines is the program's, reported as a red test with the
//! edits under it; only what the clock stopped is left unjudged.

import harness (Spawned, spawned, Ran, program, write, on_disk, stdout, json_of, at, path, nth,
                items, first, str, int, shown, assert_ok)
import std.fs (fs)
import std.json
import std.json (Json, Null)
import std.string
import std.list

fn tested(flags: List<String>) -> Ran / {Spawned, abort.raise} =
  spawned(["test", "--json"].concat(flags))

/// The one failure of a run with one red test, with the status its result was given.
type Sole = { failure: Json, status: String }

fn sole_failure() -> Sole / {Spawned, abort.raise} = {
  let r = tested([]);
  let v = json_of(r);
  assert(r.code == 1, Some("a run with one red test exits 1: " ++ shown(v)));
  let failures = items(at(v, "failures"));
  assert(failures.len() == 1, Some("exactly one failure: " ++ shown(v)));
  { failure: first(failures), status: str(at(nth(at(v, "results"), 0), "status")) }
}

fn assert_program_error(s: Sole, what: String) -> Unit / {abort.raise} = {
  let f = shown(s.failure);
  assert(
    at(s.failure, "defect") == json_false(),
    Some(what ++ " is the program's behaviour, not a defect in Ply: " ++ f),
  );
  assert(
    str(path(s.failure, ["diagnostic", "code"])) != "E0505",
    Some(what ++ " must not carry the internal-error code: " ++ f),
  );
  assert(s.status == "failed", Some(what ++ " is a red test, not a panic: " ++ f))
}

fn json_false() -> Json = json::Bool(false)

fn message_of(s: Sole) -> String = str(path(s.failure, ["diagnostic", "message"]))

type Case = { what: String, source: String, needle: String }

fn cases() -> List<Case> =
  [
    {
      what: "a runaway recursion",
      source: "fn spin(n: Int) -> Int / {diverges} = 1 + spin(n + 1)\ntest \"spins\" { assert_eq(spin(0), 0) }\n",
      needle: "what the native stack holds",
    },
    {
      what: "a runaway mutual recursion",
      source: "fn spin(n: Int) -> Int / {diverges} = 1 + spun(n + 1)\nfn spun(n: Int) -> Int / {diverges} = 1 + spin(n + 1)\ntest \"spins across two definitions\" { assert_eq(spin(0), 0) }\n",
      needle: "what the native stack holds",
    },
    {
      what: "an integer overflow",
      source: "fn grow(n: Int) -> Int = n * 4611686018427387904\ntest \"grows\" { assert_eq(grow(21), 42) }\n",
      needle: "integer overflow",
    },
    {
      what: "a division by zero",
      source: "fn div(a: Int, b: Int) -> Int / {abort.raise} = a / b\ntest \"divides\" { assert_eq(div(1, 0), 0) }\n",
      needle: "division by zero",
    },
    {
      what: "a remainder by zero",
      source: "fn rem(a: Int, b: Int) -> Int / {abort.raise} = a % b\ntest \"remainders\" { assert_eq(rem(1, 0), 0) }\n",
      needle: "by zero",
    },
    {
      what: "an explicit panic",
      source: "fn boom(n: Int) -> Int / {abort.raise} = if n > 0 { panic(\"no\") } else { 0 }\ntest \"booms\" { assert_eq(boom(1), 0) }\n",
      needle: "panic: no",
    },
    {
      what: "a runaway range",
      source: "fn big() -> List<Int> = range(0, 99999999)\ntest \"ranges\" { assert_eq(big().len(), 1) }\n",
      needle: "exceeds the limit",
    },
    {
      what: "a refutable `let` that did not match",
      source: "type Shape = Circle(Int) | Tri(Int)\nfn radius(s: Shape) -> Int / {abort.raise} = { let Circle(r) = s; r }\ntest \"unwraps\" { assert_eq(radius(Tri(2)), 2) }\n",
      needle: "did not match",
    },
    {
      what: "a failing assert_eq",
      source: "fn one() -> Int = 1\ntest \"equals\" { assert_eq(one(), 2) }\n",
      needle: "assertion failed",
    },
    // One argument written, two passed: resolution splices in `message`'s `None`.
    {
      what: "a failing assert",
      source: "fn no() -> Bool = false\ntest \"holds\" { assert(no()) }\n",
      needle: "assertion failed",
    },
    {
      what: "a failing assert carrying its message",
      source: "fn no() -> Bool = false\ntest \"holds\" { assert(no(), Some(\"the balance must be positive\")) }\n",
      needle: "assertion failed",
    },
    {
      what: "a failing assert whose message was given by name",
      source: "fn no() -> Bool = false\ntest \"holds\" { assert(no(), message: Some(\"by name\")) }\n",
      needle: "assertion failed",
    },
  ]

test/nondet "{c.what} is a program error" for c: Case in cases() {
  program(c.source);
  let s = sole_failure();
  assert_program_error(s, c.what);
  assert(
    message_of(s).contains(c.needle),
    Some("expected a message containing `" ++ c.needle ++ "`, got " ++ message_of(s)),
  )
}

test/nondet "a failure inside a handler clause body is still the program's" {
  [
    { needle: "panic: seeded wrong", clause: "panic(\"seeded wrong\")" },
    { needle: "division by zero", clause: "range(0, 4 / 0).len()" },
    { needle: "what the native stack holds", clause: "spin(1)" },
    { needle: "integer overflow", clause: "4611686018427387904 * 4" },
  ].fold((), |u: Unit, c: { needle: String, clause: String }| {
    program(
      "effect db { read all[t]() -> List<Int> }\nfn spin(n: Int) -> Int / {diverges} = 1 + spin(n + 1)\nfn rows() -> List<Int> / {db.all[users]} = db.all[users]()\ntest \"counts\" {\n  handle { assert_eq(rows().len(), 2) } with {\n    db.all[users]() -> range(0, "
        ++ c.clause
        ++ "),\n  }\n}\n",
    );
    let s = sole_failure();
    assert_program_error(s, c.needle);
    assert(
      message_of(s).contains(c.needle),
      Some("expected `" ++ c.needle ++ "` from the clause body, got " ++ message_of(s)),
    )
  })
}

fn spin() -> String =
  "fn spin(n: Int) -> Int / {diverges} = spin(n + 1)\ntest \"spins\" { assert_eq(spin(0), 0) }\n"

// The clock describes the machine, so what it stops is no verdict: it is not a failure, it is
// recorded nowhere, and the run that could not finish it does not pass.
test/nondet "a run the clock stopped is abandoned rather than judged" {
  program(spin());
  let r = tested(["--timeout", "300"]);
  let v = json_of(r);
  assert(r.code == 1, Some("an unfinished run is not ok: " ++ shown(v)));
  assert(items(at(v, "failures")) == [], Some(shown(v)));
  assert(int(path(v, ["summary", "abandoned"])) == 1, Some(shown(v)));
  assert(int(path(v, ["summary", "failed"])) == 0, Some(shown(v)));
  assert(int(path(v, ["summary", "passed"])) == 0, Some(shown(v)));
  let result = nth(at(v, "results"), 0);
  assert(str(at(result, "status")) == "abandoned", Some(shown(v)));
  assert(at(result, "cached") == Null, Some(shown(v)));
  assert(str(path(result, ["diagnostic", "code"])) == "W0612", Some(shown(v)));
  // Nothing was recorded, so the next run starts the test again rather than believing it.
  let again = json_of(tested(["--timeout", "300"]));
  assert(int(path(again, ["summary", "cached"])) == 0, Some(shown(again)));
  assert(int(path(again, ["summary", "abandoned"])) == 1, Some(shown(again)))
}

test/nondet "running out of stack is a program error, reported at the call that nested too deep" {
  program(
    "fn spin(n: Int) -> Int / {diverges} = 1 + spin(n + 1)\ntest \"spins\" { assert_eq(spin(0), 0) }\n",
  );
  let failure = nth(at(json_of(tested([])), "failures"), 0);
  let d = at(failure, "diagnostic");
  assert(at(failure, "defect") == json_false(), Some(shown(failure)));
  assert(str(at(d, "code")) == "E0502", Some(shown(failure)));
  assert(str(at(d, "message")).contains("what the native stack holds"), Some(shown(failure)));
  assert(str(at(nth(at(d, "labels"), 0), "snippet")).contains("spin("), Some(shown(failure)))
}

test/nondet "a task that runs out of stack is reported at its call, with the seed that replays it" {
  program(
    "fn spin(n: Int) -> Int / {diverges} = 1 + spin(n + 1)\ntest \"spins\" { assert_eq(simulate { task.join(task.spawn(|| spin(0))) }, 0) }\n",
  );
  let failure = nth(at(json_of(tested([])), "failures"), 0);
  let d = at(failure, "diagnostic");
  assert(str(at(d, "message")).contains("what the native stack holds"), Some(shown(failure)));
  assert(str(at(nth(at(d, "labels"), 0), "snippet")).contains("spin("), Some(shown(failure)));
  assert(shown(at(d, "notes")).contains("replay with seed"), Some(shown(failure)))
}

/// The `name` of each entry the document `v` lists at `of`, in order.
fn names_in(v: Json, of: List<String>) -> List<String> / {abort.raise} =
  items(path(v, of)).map(|x: Json| str(at(x, "name")))

/// Two edits, one benign: the failure is the program's, and both edits are its suspects, each with
/// the diff that shows what it changed.
fn assert_suspected(edits: List<String>) -> Unit / {Spawned, abort.raise} = {
  let v = json_of(tested([]));
  let failure = nth(at(v, "failures"), 0);
  assert(at(failure, "defect") == json_false(), Some(shown(failure)));
  assert(names_in(failure, ["suspects"]).take(edits.len()) == edits, Some(shown(failure)));
  assert(names_in(v, ["diffs"]) == edits, Some(shown(v)));
  assert(items(at(v, "diffs")).all(|d: Json| at(d, "diff") != Null), Some(shown(v)))
}

/// `step`'s row says it may not return, so an edit that makes it run away still checks, and fails
/// once its stack runs out, since its call nests.
fn recursion() -> String =
  \\fn step(n: Int) -> Int / {diverges} = if n <= 0 { 0 } else { step(n - 1) + 0 }
  \\
  \\fn scale(a: Int, b: Int) -> Int = (a * b) + 0
  \\
  \\fn total(a: Int, b: Int) -> Int / {diverges} = scale(a, b) + step(3)
  \\
  \\test "total is scaled" { assert_eq(total(2, 3), 6) }
  \\

fn edited(text: String, edits: List<{ from: String, to: String }>) -> String / {abort.raise} =
  edits.fold(text, |t: String, e: { from: String, to: String }| {
    assert(t.contains(e.from), Some("the fixture no longer holds `" ++ e.from ++ "`"));
    t.replace(e.from, e.to)
  })

test/nondet "runaway recursion introduced by an edit names the edits under it" {
  program(recursion());
  assert_ok(spawned(["test"]));
  write(
    "m.ply",
    edited(recursion(), [
      { from: "step(n - 1)", to: "step(n + 1)" },
      { from: "(a * b) + 0", to: "0 + (a * b)" },
    ]),
  );
  assert_suspected(["m.scale", "m.step"])
}

fn overflow() -> String =
  \\fn grow(n: Int) -> Int = n * 2
  \\
  \\fn shift(n: Int) -> Int = (n + 0) * 1
  \\
  \\fn total(n: Int) -> Int = shift(grow(n))
  \\
  \\test "total doubles" { assert_eq(total(21), 42) }
  \\

test/nondet "an overflow introduced by an edit names the edits under it" {
  program(overflow());
  assert_ok(spawned(["test"]));
  write(
    "m.ply",
    edited(overflow(), [
      { from: "n * 2", to: "n * 4611686018427387904" },
      { from: "(n + 0) * 1", to: "1 * (n + 0)" },
    ]),
  );
  assert_suspected(["m.grow", "m.shift"])
}

fn matching() -> String =
  \\type Shape = Circle(Int) | Square(Int) | Tri(Int)
  \\
  \\fn area(s: Shape) -> Int / {abort.raise} = { let Circle(r) = s; r * 3 }
  \\
  \\fn pick(n: Int) -> Shape = if n <= 0 { Circle(1) } else { Tri(n) }
  \\
  \\fn shift(n: Int) -> Int = n + 0
  \\
  \\fn report(n: Int) -> Int / {abort.raise} = area(pick(shift(n)))
  \\
  \\test "the picked shape has an area" { assert_eq(report(0), 3) }
  \\

test/nondet "a pattern that stops matching names the edits under it" {
  program(matching());
  assert_ok(spawned(["test"]));
  write(
    "m.ply",
    edited(matching(), [
      { from: "if n <= 0 { Circle(1) }", to: "if n < 0 { Circle(1) }" },
      { from: "fn shift(n: Int) -> Int = n + 0", to: "fn shift(n: Int) -> Int = 0 + n" },
    ]),
  );
  assert_suspected(["m.pick", "m.shift"])
}

test/nondet "a match that stops being exhaustive never reaches the runner" {
  let exhaustive =
    \\type Shape = Circle(Int) | Square(Int) | Tri(Int)
    \\
    \\fn area(s: Shape) -> Int = match s { Circle(r) -> r * 3, Square(a) -> a * a, Tri(b) -> b }
    \\
    \\fn pick(n: Int) -> Shape = if n <= 0 { Circle(1) } else { Tri(n) }
    \\
    \\test "the picked shape has an area" { assert_eq(area(pick(1)), 1) }
    \\
  ;
  program(exhaustive);
  assert_ok(spawned(["test"]));
  write("m.ply", edited(exhaustive, [{ from: ", Tri(b) -> b", to: "" }]));
  let r = tested([]);
  let v = json_of(r);
  assert(r.code == 2, Some(shown(v)));
  assert(str(at(nth(at(v, "diagnostics"), 0), "code")) == "E0205", Some(shown(v)));
  assert(
    at(v, "failures") == Null,
    Some("nothing ran, so there is nothing to classify: " ++ shown(v)),
  )
}

test/nondet "a runaway recursion costs a sibling failure nothing" {
  let both = recursion() ++ "\ntest \"step bottoms out\" { assert_eq(step(3), 0) }\n";
  program(both);
  assert_ok(spawned(["test"]));
  write(
    "m.ply",
    edited(both, [
      { from: "step(n - 1)", to: "step(n + 1)" },
      { from: "(a * b) + 0", to: "0 + (a * b)" },
    ]),
  );
  let v = json_of(tested([]));
  let failures = items(at(v, "failures"));
  assert(failures.len() == 2, Some(shown(v)));
  failures.fold((), |u: Unit, failure: Json| {
    assert(at(failure, "defect") == json_false(), Some(shown(failure)));
    assert(names_in(failure, ["suspects"]).contains("m.step"), Some(shown(failure)))
  });
  // Each change is shown once, however many failures it is under.
  assert(names_in(v, ["diffs"]) == ["m.scale", "m.step"], Some(shown(v)))
}

test/nondet "a runtime limit in a nondet test is a program error" {
  program(
    "fn spin(n: Int) -> Int / {diverges} = 1 + spin(n + 1)\ntest/nondet \"spins\" { assert_eq(spin(0), 0) }\n",
  );
  assert_program_error(sole_failure(), "a runaway recursion in a nondet test")
}

test/nondet "a first-ever runtime limit has no earlier text to compare" {
  program(
    "fn spin(n: Int) -> Int / {diverges} = 1 + spin(n + 1)\ntest \"spins\" { assert_eq(spin(0), 0) }\n",
  );
  let v = json_of(tested([]));
  assert(items(at(v, "diffs")) == [], Some(shown(v)));
  assert(
    items(path(nth(at(v, "failures"), 0), ["suspects"])).all(|x: Json| at(x, "change") == Null),
    Some("nothing was compared, so no change may be named: " ++ shown(v)),
  )
}

// Built by iteration, so as deep as no recursion that built it stood: comparing it nests a call a
// level.
test/nondet "a deep value is compared rather than aborting the run" {
  program(
    "type Chain = Nil | Link(Chain)\n\nfn stack(n: Int) -> Chain = range(0, n).fold(Nil, |acc, x| Link(acc))\n\ntest \"deep values compare\" { assert_eq(stack(100000), stack(100000)) }\ntest \"a sibling still reports\" { assert_eq(1, 1) }\n",
  );
  let r = tested([]);
  let v = json_of(r);
  assert(r.code == 0, Some(shown(v)));
  assert(int(path(v, ["summary", "failed"])) == 0, Some(shown(v)));
  assert(int(path(v, ["summary", "passed"])) == 2, Some(shown(v)))
}

// No recursion in the program: a chain of `+` whose tree the front end and the emitter each walk
// once per term. Nothing in the compiler bounds how deep a definition may be; a walk that would
// cross the floor of the stack it is on is given another.
test/nondet "a deeply nested expression runs rather than aborting the run" {
  program(
    "fn deep() -> Int = 1" ++ " + 1".repeat(3000)
      ++ "\ntest \"deep\" { assert_eq(deep(), 3001) }\n",
  );
  let checked = on_disk(["check"]);
  assert(checked.code == 0, Some("the front end handles this depth: " ++ stdout(checked)));
  let r = tested(["--no-cache"]);
  let v = json_of(r);
  assert(r.code == 0, Some(shown(v)));
  assert(int(path(v, ["summary", "passed"])) == 1, Some(shown(v)))
}
