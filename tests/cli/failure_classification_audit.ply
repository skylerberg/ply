//! How a run reports a failure, for the failures a handler cannot catch and one of each that it
//! can: each is the program's, a red test with the edits under it, and only what the clock stopped
//! is left unjudged. What a failure does in a program is `tests/lang`'s.

import harness (PlyProcess, spawned)
import support.harness (RunResult, write_program, write, stdout, json_of, at, path, nth, items, str,
                        int, json_text, assert_ok)
import std.json
import std.json (Json, Null)
import std.string
import std.list

fn test_run(flags: List<String>) -> RunResult / {PlyProcess, abort.raise} =
  spawned(["test", ".", "--json"].concat(flags))

fn json_false() -> Json = json::Bool(false)

/// The entry for the test `name` in the list `list`.
fn named(list: Json, name: String) -> Json / {abort.raise} =
  match items(list).filter(|entry: Json| str(at(entry, "name")) == name) {
    [entry, ..] -> entry,
    [] -> panic("no entry for `" ++ name ++ "` in " ++ json_text(list)),
  }

type Case = { name: String, needle: String }

/// What the run of `runtime_failures.ply` fails, each with what its message holds.
fn cases() -> List<Case> =
  [
    { name: "a runaway recursion", needle: "what the native stack holds" },
    { name: "a runaway mutual recursion", needle: "what the native stack holds" },
    { name: "an integer overflow", needle: "integer overflow" },
    { name: "a division by zero", needle: "division by zero" },
    { name: "a runaway range", needle: "exceeds the limit" },
    { name: "a failing assertion", needle: "assertion failed" },
    { name: "a runaway recursion in a nondet test", needle: "what the native stack holds" },
    { name: "a task that runs out of stack", needle: "what the native stack holds" },
    { name: "a runaway recursion in a clause body", needle: "what the native stack holds" },
    { name: "an overflow in a clause body", needle: "integer overflow" },
  ]

// The first run of a program, so it compares no earlier text.
test/nondet "every runtime failure is the program's, a red test at the call that failed" {
  write_program(String::of_bytes_lossy(embed("../fixtures/lang/runtime_failures.ply")));
  let r = test_run([]);
  let v = json_of(r);
  let failures = at(v, "failures");
  assert(r.code == 1, Some("a run with a red test exits 1: " ++ json_text(v)));
  assert(items(failures).len() == cases().len(), Some(json_text(v)));
  cases().fold((), |u: Unit, c: Case| {
    let failure = named(failures, c.name);
    let d = at(failure, "diagnostic");
    let f = json_text(failure);
    assert(at(failure, "internal_error") == json_false(), Some(f));
    assert(str(at(d, "code")) != "E0505", Some(f));
    assert(str(at(named(at(v, "results"), c.name), "status")) == "failed", Some(f));
    assert(str(at(d, "message")).contains(c.needle), Some(f))
  });
  assert(
    str(path(named(failures, "a runaway recursion"), ["diagnostic", "code"])) == "E0502",
    Some(json_text(failures)),
  );
  ["a runaway recursion", "a task that runs out of stack"].fold((), |u: Unit, name: String|
    assert(
      str(at(nth(path(named(failures, name), ["diagnostic", "labels"]), 0), "snippet")).contains(
        "spin(",
      ),
      Some(json_text(failures)),
    ));
  assert(
    json_text(
      path(named(failures, "a task that runs out of stack"), ["diagnostic", "notes"]),
    ).contains(
      "replay with seed",
    ),
    Some(json_text(failures)),
  );
  assert(items(at(v, "diffs")) == [], Some(json_text(v)));
  assert(
    items(failures).all(|failure: Json|
      items(at(failure, "changes")).all(|x: Json| at(x, "change") == Null)),
    Some("nothing was compared, so no change may be named: " ++ json_text(v)),
  )
}

// The clock describes the machine, so what it stops is no verdict: it is not a failure, it is
// recorded nowhere, and the run that could not finish it does not pass.
test/nondet "a run the clock stopped is abandoned rather than judged" {
  write_program(
    "fn spin(n: Int) -> Int / {diverges} = spin(n + 1)\ntest \"spins\" { assert_eq(spin(0), 0) }\n",
  );
  let r = test_run(["--timeout", "300"]);
  let v = json_of(r);
  assert(r.code == 1, Some("an unfinished run is not ok: " ++ json_text(v)));
  assert(items(at(v, "failures")) == [], Some(json_text(v)));
  assert(int(path(v, ["summary", "timed_out"])) == 1, Some(json_text(v)));
  assert(int(path(v, ["summary", "failed"])) == 0, Some(json_text(v)));
  assert(int(path(v, ["summary", "passed"])) == 0, Some(json_text(v)));
  let result = nth(at(v, "results"), 0);
  assert(str(at(result, "status")) == "timed_out", Some(json_text(v)));
  assert(at(result, "cached") == Null, Some(json_text(v)));
  assert(str(path(result, ["diagnostic", "code"])) == "W0612", Some(json_text(v)));
  // Nothing was recorded, so the next run starts the test again rather than believing it.
  let again = json_of(test_run(["--timeout", "300"]));
  assert(int(path(again, ["summary", "cached"])) == 0, Some(json_text(again)));
  assert(int(path(again, ["summary", "timed_out"])) == 1, Some(json_text(again)))
}

/// The `name` of each entry the document `v` lists at `of`, in order.
fn names_in(v: Json, of: List<String>) -> List<String> =
  items(path(v, of)).map(|x: Json| str(at(x, "name")))

fn edited(text: String, edits: List<{ from: String, to: String }>) -> String / {abort.raise} =
  edits.fold(text, |t: String, e: { from: String, to: String }| {
    assert(t.contains(e.from), Some("the fixture no longer holds `" ++ e.from ++ "`"));
    t.replace(e.from, e.to)
  })

/// Each test the edit breaks, and the two edits under it, one of them benign.
fn broken() -> List<{ test: String, edits: List<String> }> =
  [
    { test: "total is scaled", edits: ["m.scale", "m.step"] },
    { test: "raised doubles", edits: ["m.grow", "m.level"] },
    { test: "the picked shape has an area", edits: ["m.pick", "m.shift"] },
  ]

// Edits that make a recursion run away, a product overflow and a pattern miss, each beside a benign
// one, and a second test under the recursion.
test/nondet "a failure an edit brings names the edits under it, and a sibling failure loses nothing" {
  let program = String::of_bytes_lossy(
    embed("../programs/failure_classification_audit/edited.ply"),
  );
  write_program(program);
  assert_ok(spawned(["test", "."]));
  write(
    "m.ply",
    edited(program, [
      { from: "step(n - 1)", to: "step(n + 1)" },
      { from: "a * b + 0", to: "0 + a * b" },
      { from: "n * 2", to: "n * 4611686018427387904" },
      { from: "(n + 0) * 1", to: "1 * (n + 0)" },
      { from: "if n <= 0 { Circle(1) }", to: "if n < 0 { Circle(1) }" },
      { from: "fn shift(n: Int) -> Int = n + 0", to: "fn shift(n: Int) -> Int = 0 + n" },
    ]),
  );
  let v = json_of(test_run([]));
  let failures = at(v, "failures");
  assert(items(failures).len() == 4, Some(json_text(v)));
  assert(
    items(failures).all(|failure: Json| at(failure, "internal_error") == json_false()),
    Some(json_text(v)),
  );
  broken().fold((), |u: Unit, b: { test: String, edits: List<String> }|
    assert(
      names_in(named(failures, b.test), ["changes"]).take(b.edits.len()) == b.edits,
      Some(json_text(v)),
    ));
  assert(
    names_in(named(failures, "step bottoms out"), ["changes"]).contains("m.step"),
    Some(json_text(v)),
  );
  // Each change is shown once, however many failures it is under.
  assert(
    names_in(v, ["diffs"]).sort()
      == ["m.grow", "m.level", "m.pick", "m.scale", "m.shift", "m.step"],
    Some(json_text(v)),
  );
  assert(items(at(v, "diffs")).all(|d: Json| at(d, "diff") != Null), Some(json_text(v)))
}

test/nondet "a match that is not exhaustive never reaches the runner" {
  write_program(
    \\type Shape = Circle(Int) | Square(Int) | Tri(Int)
    \\
    \\fn area(s: Shape) -> Int = match s { Circle(r) -> r * 3, Square(a) -> a * a }
    \\
    \\test "a shape has an area" { assert_eq(area(Circle(1)), 3) }
    \\
  );
  let r = test_run([]);
  let v = json_of(r);
  assert(r.code == 2, Some(json_text(v)));
  assert(str(at(nth(at(v, "diagnostics"), 0), "code")) == "E0205", Some(json_text(v)));
  assert(
    at(v, "failures") == Null,
    Some("nothing ran, so there is nothing to classify: " ++ json_text(v)),
  )
}

// No recursion in the program: a chain of `+` whose tree the front end and the emitter each walk
// once per term. Nothing in the compiler bounds how deep a definition may be; a walk that would
// cross the floor of the stack it is on is given another.
test/nondet "a deeply nested expression runs rather than aborting the run" {
  write_program(
    "fn deep() -> Int = 1" ++ " + 1".repeat(3000)
      ++ "\ntest \"deep\" { assert_eq(deep(), 3001) }\n",
  );
  let checked = spawned(["check", "."]);
  assert(checked.code == 0, Some("the front end handles this depth: " ++ stdout(checked)));
  let r = test_run(["--no-cache"]);
  let v = json_of(r);
  assert(r.code == 0, Some(json_text(v)));
  assert(int(path(v, ["summary", "passed"])) == 1, Some(json_text(v)))
}
