import spawning.harness (spawned, write_program, write_project, manifest, dependency, json_of, at,
                         items, str, int, json_text)
import std.json (Json)

fn names(group: Json) -> List<String> = items(group).map(|w: Json| str(at(w, "name")))

test/nondet "a program's unused definitions and those only tests use are listed, warm as cold" {
  write_program(String::of_bytes_lossy(embed("../programs/unused/program.ply")));
  let cold = json_of(spawned(["unused", ".", "--json"]));
  let warm = json_of(spawned(["unused", ".", "--json"]));
  assert_eq(int(at(cold, "exit_code")), 0);
  assert_eq(names(at(cold, "never_used")), ["m.gone"]);
  assert_eq(names(at(cold, "only_tests")), ["m.tested", "m.table"]);
  assert(cold == warm, Some(json_text(warm)))
}

const workspace_text: String =
  "import std.pkg (Workspace)\n\nfn workspace() -> Workspace = { packages: [\"lib\", \"app\"], suites: [], fixtures: [], toolchain: None }\n"

test/nondet "`--workspace` counts a library's `pub` definition as used only where a package uses it" {
  write_project([
    { path: "ply.work", text: workspace_text },
    { path: "lib/ply.pkg", text: manifest("lib", "") },
    { path: "lib/shapes.ply", text: "pub fn kept() -> Int = 1\npub fn gone() -> Int = 2\n" },
    { path: "app/ply.pkg", text: manifest("app", dependency("lib", "../lib")) },
    { path: "app/app.ply", text: "import lib.shapes\npub fn main() -> Int = shapes::kept()\n" },
  ]);
  let alone = json_of(spawned(["unused", "--json", "lib"]));
  assert(int(at(alone, "exit_code")) == 0, Some(json_text(alone)));
  assert_eq(names(at(alone, "never_used")), []);
  let cold = json_of(spawned(["unused", ".", "--workspace", "--json"]));
  assert(int(at(cold, "exit_code")) == 0, Some(json_text(cold)));
  assert_eq(names(at(cold, "never_used")), ["lib.shapes.gone"]);
  assert(cold == json_of(spawned(["unused", ".", "--workspace", "--json"])), Some(json_text(cold)))
}
