import spawning.harness (spawned, write_program, stdout)
import std.string

test/nondet "`ply prove --explain` names the effects that a definition declares but its body never performs" {
  write_program(
    \\effect store {
    \\  read  all[table]() -> List<Int>
    \\  write save[table](rows: List<Int>) -> Unit
    \\}
    \\
    \\effect set Web = { store.read[orders], store.read[users], store.write[orders] }
    \\
    \\pub fn count() -> Int / {Web}
    \\  ensures result >= 0
    \\  = store.all[orders]().len()
    \\
  );
  let text = stdout(spawned(["prove", ".", "--explain"]));
  assert(
    text.contains("the claim allows effects that the body never uses:"),
    Some("an `ensures` under wider effects must say what it gave up:\n" ++ text),
  );
  assert(text.contains("m.store.read[users]"), Some(text));
  assert(!text.contains("Web"), Some("the alias name is provenance, never the claim:\n" ++ text));
  write_program("pub fn double(x: Int) -> Int\n  ensures result >= x\n  = x + x\n");
  let tight = stdout(spawned(["prove", ".", "--explain"]));
  assert(!tight.contains("frame covers"), Some(tight))
}
