import spawning.harness (spawned, write_program, json_of, at, items, str, json_text)
import std.json (Json, Str, Array)
import std.list

const source: String = String::of_bytes_lossy(embed("../programs/surface/source.ply"))

test/nondet "test runs every test any of its filters matches" {
  write_program(source ++ "test \"one is one\" { assert_eq(one(), 1) }\n");
  let v = json_of(
    spawned(["test", ".", "--json", "--no-cache", "--filter", "two", "--filter", "alone"]),
  );
  let ran = items(at(v, "results")).map(|r: Json| str(at(r, "key"))).sort();
  assert(ran == ["m.alone is three", "m.two is two"], Some(json_text(v)));
  assert(at(v, "filters") == Array([Str("two"), Str("alone")]), Some(json_text(v)))
}
