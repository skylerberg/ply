import std.fs (fs, listed_names)
import std.list
import std.string

fn suite() -> String = "tests/cli"

fn allowed_imports() -> List<String> =
  ["compiler.syntax", "compiler.expand.embed", "compiler.store.plyx"]

fn modules() -> List<{ name: String, text: String }> / {fs.read[repo], abort.raise} =
  match listed_names(fs.list_dir[repo](suite())) {
    None -> panic("the suite is there"),
    Some(names) ->
      names.filter(|name: String| name.ends_with(".ply")).fold([], |accumulator, name: String|
        match fs.read_file[repo](suite() ++ "/" ++ name) {
          Some(text) -> accumulator.push({ name: name, text: String::of_bytes(text) }),
          None -> accumulator,
        }),
  }

test/nondet "the harness is the only module that starts the `ply` binary" {
  let offenders = modules().filter(|m: { name: String, text: String }|
    m.name != "harness.ply" && m.name != "suite_boundary.ply"
      && (m.text.contains("process.spawn[ply]") || m.text.contains("process.start[ply]")));
  assert_eq(offenders.map(|m: { name: String, text: String }| m.name), [])
}

test/nondet "no module imports the CLI, or more of the compiler than a test edits a source with" {
  let lines = modules().map(|m: { name: String, text: String }| m.text.split("\n")).flatten();
  let imported = lines.filter(|line: String|
    line.starts_with("import cli.")
      || (line.starts_with("import compiler.")
      && !allowed_imports().any(|allowed: String| line.starts_with("import " ++ allowed))));
  assert_eq(imported, [])
}
