import harness (toolchain_parts)
import std.fs (fs, listed_names)
import std.list
import std.string

test/nondet "the harness is the only module that starts the `ply` binary" {
  let suite = toolchain_parts().cli_tests;
  let names = match listed_names(fs.list_dir[repo](suite)) {
    Some(ns) -> ns,
    None -> panic("the suite is there"),
  };
  let offenders = names.filter(|name: String|
    name.ends_with(".ply") && name != "harness.ply" && name != "suite_boundary.ply"
      && (match fs.read_file[repo](suite ++ "/" ++ name) {
        Some(text) -> {
          let t = String::of_bytes(text);
          t.contains("process.spawn[ply]") || t.contains("process.start[ply]")
        },
        None -> false,
      }));
  assert_eq(offenders, [])
}
