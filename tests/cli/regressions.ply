//! Bugs found once, each pinned where it was found: in the warm check, the result cache, handler
//! clauses, the run's spans, constructor resolution and the C backend.

import harness (WorkingDirectory, PlyProcess, spawned, scratch, write_project, write, in_memory,
                one_module_tree, tree, warm_agrees, all_output, json_of, at, path, nth, items, str,
                int, json_text, Hermetic, Shipped, diagnostic_codes)
import std.fs (fs, listed_names)
import std.json (Json, Str)

// A module is read for the names an import selects, so the note on one it does not declare had
// only those to list, and said a module with others exported nothing.
test "a name a module does not declare is refused with every name it exports" {
  let tree = tree([
    {
      path: "lib.ply",
      text: "pub fn one() -> Int = 1\nfn hidden() -> Int = 2\npub fn two() -> Int = 3\n",
    },
    {
      path: "app.ply",
      text: "import lib (sum)\nimport std.list (no_such_name)\nfn go() -> Int = 0\n",
    },
  ]);
  let r = in_memory(tree, ["check"]);
  assert(r.code != 0, Some(all_output(r)));
  let said_lib = all_output(r).contains("`lib` exports: ") && all_output(r).contains("`one`")
    && all_output(r).contains("`two`")
    && !all_output(r).contains("`hidden`");
  assert(said_lib, Some(all_output(r)));
  assert(!all_output(r).contains("exports nothing"), Some(all_output(r)));
  assert(
    all_output(r).contains("`std.list` exports: ") && all_output(r).contains("`List::find`"),
    Some(all_output(r)),
  )
}

// An imported but unused name is in no `deps` entry, so deleting it leaves every hash the importer
// names untouched.
test "deleting an unused selectively imported name is reported, not skipped past" {
  scratch(|| {
    write_project([
      { path: "lib.ply", text: "pub fn used() -> Int = 1\npub fn spare() -> Int = 2\n" },
      { path: "app.ply", text: "import lib (used, spare)\nfn go() -> Int = used()\n" },
    ]);
    let _ = warm_agrees("cold");
    let _ = warm_agrees("warm");
    write("lib.ply", "pub fn used() -> Int = 1\n");
    let answer = warm_agrees("the imported name deleted");
    assert(
      int(at(answer, "exit_code")) == 2,
      Some(
        "an import of a deleted name must be an error, not a skipped file: " ++ json_text(answer),
      ),
    );
    assert(
      diagnostic_codes(answer).filter(|c: String| c == "E0101").len() > 0,
      Some(json_text(answer)),
    )
  })
}

// Inference walks modules dependency-first, so check order depends on what the cache held.
test "the published order is the same warm as cold" {
  scratch(|| {
    write_project([
      {
        path: "app.ply",
        text:
          \\import lib
          \\pub effect audit { write note[log](m: Int) -> Unit }
          \\pub type Wrapped = | Wrap(Int) | Empty
          \\fn second() -> Int = lib::base()
          \\fn first() -> Int = second()
          \\
      },
      {
        path: "lib.ply",
        text:
          \\pub effect db { read get[t](k: Int) -> Int }
          \\pub type Row = | Cell(Int)
          \\pub fn base() -> Int = 1
          \\
      },
    ]);
    // A warm check publishes in the order a cold one does.
    let _ = warm_agrees("cold");
    let warm = warm_agrees("warm");
    // The run's own order: files sorted, then each file's items as written.
    assert(
      items(at(warm, "definitions")).map(|d: Json| str(at(d, "name")))
        == ["app.second", "app.first", "lib.base"],
      Some(json_text(at(warm, "definitions"))),
    )
  })
}

test/nondet "an unwritable store never fails a run and says what failed" {
  write_project([
    { path: "m.ply", text: "pub fn f() -> Int = 1\n\ntest \"one\" {\n  assert_eq(f(), 1)\n}\n" },
  ]);
  assert(spawned(["test"]).code == 0, None);
  let manifest = match List::filter(
      match listed_names(fs.list_dir[cwd](".ply-cache")) { Some(names) -> names, None -> [] },
      |name: String| name.starts_with("manifest-"),
    ) {
    [name, ..] -> ".ply-cache/" ++ name,
    [] -> panic("the run filed no store"),
  };
  // `rename` cannot replace a directory, so only the manifest's atomic write fails.
  if !(fs.remove[cwd](manifest) && fs.create_dir[cwd](manifest)) {
    panic("the blocking directory is made")
  };
  let r = spawned(["test", "--json"]);
  assert(r.code == 0, Some("an unwritable cache never fails a run: " ++ all_output(r)));
  let warnings = items(at(json_of(r), "warnings")).filter(|d: Json|
    str(at(d, "code")) == "W0601").map(|d: Json| str(at(d, "message")));
  assert(
    warnings.filter(|m: String| m.contains("the store's manifest could not be written")).len() > 0,
    Some("the failing write has to be named: " ++ all_output(r)),
  )
}

fn checked(source: String) -> Json / {Hermetic, Shipped, abort.raise, diverges} =
  json_of(in_memory(one_module_tree(source), ["check", "--json"]))

test "three operations sharing one atom are three reachable clauses" {
  let answer = checked(
    \\import std.net (net)
    \\pub fn touch(c: Int) -> Int / {net.recv[conn]} = {
    \\  let _ = net.recv[conn](c, 16, 1000);
    \\  0
    \\}
    \\pub fn boom() -> Int = nope(1)
    \\test "three operations, one atom" {
    \\  handle { assert_eq(touch(3), 0) } with {
    \\    net.recv[conn](c, m, t) -> Some(b""),
    \\    net.send[conn](c, p, t) -> Some(p.len()),
    \\    net.close[conn](c) -> (),
    \\  }
    \\}
    \\
  );
  assert(
    diagnostic_codes(answer).filter(|c: String| c == "E0105").len() == 0,
    Some("no clause here is unreachable: " ++ json_text(answer)),
  );
  assert(
    items(at(answer, "diagnostics")).filter(|d: Json| str(at(d, "severity")) == "error").len() == 1,
    Some("only `nope` is an error: " ++ json_text(answer)),
  )
}

// The warning names the operation, not the atom: the atom is not what the second clause lost to.
test "the same operation handled twice is still reported" {
  let answer = checked(
    \\import std.net (net)
    \\pub fn touch(c: Int) -> Int / {net.recv[conn]} = {
    \\  let _ = net.recv[conn](c, 16, 1000);
    \\  0
    \\}
    \\pub fn boom() -> Int = nope(1)
    \\test "one operation, twice" {
    \\  handle { assert_eq(touch(3), 0) } with {
    \\    net.recv[conn](c, m, t) -> Some(b""),
    \\    net.recv[conn](c, m, t) -> Some(b"x"),
    \\  }
    \\}
    \\
  );
  match items(at(answer, "diagnostics")).filter(|d: Json| str(at(d, "code")) == "E0105") {
    [d, ..] ->
      assert(
        str(at(d, "message")).contains("net.recv[conn]"),
        Some("the operation is what was duplicated: " ++ json_text(d)),
      ),
    [] -> panic("the second clause is unreachable: " ++ json_text(answer)),
  }
}

fn failed_line(text: String) -> Int / {PlyProcess, WorkingDirectory, abort.raise} = {
  write("m.ply", text);
  let report = json_of(spawned(["run", "m.ply", "--json"]));
  int(path(nth(at(nth(at(report, "diagnostics"), 0), "labels"), 0), ["start", "line"]))
}

test/nondet "a failure is placed in the text that ran after its definition moved" {
  write_project([]);
  // The hash of `main` is the same in both texts; only where it sits moved.
  assert_eq(failed_line("\n\n\nfn main() -> Int / {abort.raise} = 1 / 0\n"), 4);
  assert_eq(failed_line("fn main() -> Int / {abort.raise} = 1 / 0\n"), 1)
}

// A constructor is the one its own module declares, even when another imported module declares a
// constructor of the same name and is imported first.
test/nondet "a constructor name is the module it was imported from and not any module that declares it" {
  write_project([
    {
      path: "first.ply",
      text:
        \\pub type Colour = | Nondet | Other
        \\
        \\pub fn code(c: Colour) -> Int =
        \\  match c {
        \\    Nondet -> 11,
        \\    Other -> 12,
        \\  }
        \\
    },
    {
      path: "second.ply",
      text:
        \\pub type Skipped = | Nondet | Panicked
        \\
        \\pub fn skipped_code(s: Skipped) -> Int =
        \\  match s {
        \\    Nondet -> 21,
        \\    Panicked -> 22,
        \\  }
        \\
    },
    {
      path: "use.ply",
      text:
        \\// `second` comes first and declares a `Nondet` of its own.
        \\import second (Panicked, Skipped, skipped_code)
        \\import first (Colour, Nondet, Other, code)
        \\
        \\test "the imported constructor is the one that was imported" {
        \\  assert_eq(code(Nondet), 11);
        \\  assert_eq(code(Other), 12)
        \\}
        \\
    },
  ]);
  let r = spawned(["test", "-j", "1"]);
  assert(r.code == 0, Some(all_output(r)));
  assert(all_output(r).contains("1 passed"), Some(all_output(r)))
}

// An `Int` at or beyond `2^62` does not fit an immediate and is boxed; a self tail call once
// released that boxed word on every restart. The whole pipeline is the point, so it is a `ply run`.
test/nondet "a boxed Int passes through a self tail call" {
  write_project([
    {
      path: "m.ply",
      text:
        \\fn countdown(n: Int, k: Int) -> Int = if k <= 0 { n } else { countdown(n, k - 1) }
        \\pub fn main() -> Unit / {abort.raise} = {
        \\  assert_eq(countdown(4611686018427387904, 1), 4611686018427387904);
        \\  assert_eq(countdown(4611686018427387904, 1000), 4611686018427387904);
        \\  assert_eq(countdown(0 - 4611686018427387905, 1), 0 - 4611686018427387905)
        \\}
        \\
    },
  ]);
  let r = spawned(["run", "--color", "never"]);
  assert(r.code == 0, Some(all_output(r)))
}
