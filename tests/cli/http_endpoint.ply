import spawning.harness (Server, write_project, reserve_port, start_server, connection, exchange,
                         send, read_until_closed, assert_returned_cleanly, spawned, all_output,
                         value_of, WorkingDirectory, PlyProcess)
import std.time (time)

fn hello_project() -> Unit / {WorkingDirectory, abort.raise} =
  write_project([{ path: "hello.ply", text: String::of_bytes(embed("../../examples/hello.ply")) }])

fn start_hello(port: Int, connections: Int) -> Server / {PlyProcess, abort.raise} =
  start_server(
    [
      "run",
      ".",
      "--set",
      "HELLO_PORT=" ++ port.to_string(),
      "--set",
      "HELLO_CONNECTIONS=" ++ connections.to_string(),
    ],
    [],
    port,
  )

test/nondet "a request over a real socket is handled by a Ply program" {
  let port = reserve_port();
  hello_project();
  let server = start_hello(port, 1);
  let response = exchange(
    connection(server),
    b"GET /hello HTTP/1.1\r\nHost: 127.0.0.1\r\nUser-Agent: ply-test\r\n\r\n",
  );
  assert(response.starts_with("HTTP/1.1 200 OK\r\n"), Some("got:\n" ++ response));
  assert(response.contains("Content-Length: 15\r\n"), Some("got:\n" ++ response));
  assert(response.contains("Connection: close\r\n"), Some("got:\n" ++ response));
  assert(response.ends_with("\r\n\r\nhello from ply\n"), Some("got:\n" ++ response));
  assert_returned_cleanly(server)
}

test/nondet "a malformed request gets a 400 response and the server survives it" {
  let port = reserve_port();
  hello_project();
  let server = start_hello(port, 2);
  let response = exchange(connection(server), b"GET /\r\n\r\n");
  assert(response.starts_with("HTTP/1.1 400 Bad Request\r\n"), Some("got:\n" ++ response));
  assert(
    response.ends_with("a request line is `METHOD TARGET VERSION`\n"),
    Some("got:\n" ++ response),
  );
  let second = exchange(connection(server), b"GET / HTTP/1.1\r\nHost: 127.0.0.1\r\n\r\n");
  assert(second.starts_with("HTTP/1.1 200 OK\r\n"), Some("got:\n" ++ second));
  assert_returned_cleanly(server)
}

test/nondet "a request split across writes is read to its terminator" {
  let port = reserve_port();
  hello_project();
  let server = start_hello(port, 1);
  let c = connection(server);
  [b"GET / HT", b"TP/1.1\r\nHost: 127.0.0", b".1\r\n\r", b"\n"].fold((), |u: Unit, piece: Bytes| {
    send(c, piece);
    time.sleep_ms(20)
  });
  let response = read_until_closed(c, 10000);
  assert(response.starts_with("HTTP/1.1 200 OK\r\n"), Some("got:\n" ++ response));
  assert_returned_cleanly(server)
}

test/nondet "the same program's tests handle every operation themselves" {
  hello_project();
  let r = spawned(["test", "."]);
  assert(r.code == 0, Some("got:\n" ++ all_output(r)));
  assert(
    !all_output(r).contains("E0424"),
    Some(
      "the tests handle every `net` and `config` operation themselves, so none reaches the boundary:\n"
        ++ all_output(r),
    ),
  )
}

fn write_listen_test(port: Int) -> Unit / {WorkingDirectory, abort.raise} =
  write_project([
    {
      path: "touch.ply",
      text: "import std.net (net)\n\nfn touch() -> Int / {net.write[listener]} = {\n  let l = net.listen[listener]("
        ++ port.to_string()
        ++ ");\n  net.close[listener](l);\n  l\n}\n\ntest/nondet \"reaches the host\" { assert(touch() > 0) }\n",
    },
  ])

test/nondet "`ply test` caches a passing network test for the same `--exec` bindings, and runs it again under a different binding" {
  write_listen_test(reserve_port());
  let first = spawned(["test", "."], []);
  assert(first.code == 0, Some("got:\n" ++ all_output(first)));
  assert(all_output(first).contains("1 used the host"), Some("got:\n" ++ all_output(first)));
  assert(!all_output(first).contains(", 1 cached"), Some("got:\n" ++ all_output(first)));
  let again = spawned(["test", "."], []);
  assert(again.code == 0, Some("got:\n" ++ all_output(again)));
  assert(
    all_output(again).contains(", 1 cached"),
    Some("nothing the pass read moved, yet it ran again:\n" ++ all_output(again)),
  );
  let r = spawned(["test", ".", "--exec", "echo=/bin/echo"], []);
  assert(r.code == 0, Some("got:\n" ++ all_output(r)));
  assert(all_output(r).contains("1 used the host"), Some("got:\n" ++ all_output(r)));
  assert(
    !all_output(r).contains(", 1 cached"),
    Some("a pass earned under another binding stood for this one:\n" ++ all_output(r)),
  )
}

test/nondet "task spawn under ply run runs on the production scheduler" {
  write_project([
    {
      path: "tasks.ply",
      text: String::of_bytes_lossy(embed("../programs/http_endpoint/spawn_under_run.ply")),
    },
  ]);
  assert_eq(value_of(spawned(["run", ".", "--json"], [])), "3")
}
