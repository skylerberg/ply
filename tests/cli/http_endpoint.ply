//! The example HTTP endpoint over a real socket, and the same program's tests answered in memory.

import harness (scratch, Server, Source, project, reserve, serving, connection, exchange, sent,
                heard, returned, on_disk, spawned, said, Here, Spawned)
import std.time (time)

/// The example, verbatim: the port and the connection count a test chooses are the run's settings.
fn hello() -> Unit / {Here, abort.raise} =
  project([{ path: "hello.ply", text: String::of_bytes(embed("../../examples/hello.ply")) }])

/// Listens on `port` and answers `connections` connections before it returns.
fn started(port: Int, connections: Int) -> Server / {Spawned, abort.raise} =
  serving(
    [
      "run",
      "--host",
      "--set",
      "HELLO_PORT=" ++ port.to_string(),
      "--set",
      "HELLO_CONNECTIONS=" ++ connections.to_string(),
    ],
    [],
    port,
  )

test/nondet "a request over a real socket is answered by a Ply program" {
  let port = reserve();
  hello();
  let server = started(port, 1);
  let response = exchange(
    connection(server),
    b"GET /hello HTTP/1.1\r\nHost: 127.0.0.1\r\nUser-Agent: ply-test\r\n\r\n",
  );
  assert(response.starts_with("HTTP/1.1 200 OK\r\n"), Some("got:\n" ++ response));
  assert(response.contains("Content-Length: 15\r\n"), Some("got:\n" ++ response));
  assert(response.contains("Connection: close\r\n"), Some("got:\n" ++ response));
  assert(response.ends_with("\r\n\r\nhello from ply\n"), Some("got:\n" ++ response));
  returned(server)
}

test/nondet "a malformed request is answered 400 and the server survives it" {
  let port = reserve();
  hello();
  let server = started(port, 2);
  let response = exchange(connection(server), b"GET /\r\n\r\n");
  assert(response.starts_with("HTTP/1.1 400 Bad Request\r\n"), Some("got:\n" ++ response));
  assert(
    response.ends_with("a request line is `METHOD TARGET VERSION`\n"),
    Some("got:\n" ++ response),
  );
  // The listener is still there, which is the half of the claim a single request cannot make.
  let second = exchange(connection(server), b"GET / HTTP/1.1\r\nHost: 127.0.0.1\r\n\r\n");
  assert(second.starts_with("HTTP/1.1 200 OK\r\n"), Some("got:\n" ++ second));
  returned(server)
}

test/nondet "a request split across writes is read to its terminator" {
  let port = reserve();
  hello();
  let server = started(port, 1);
  let c = connection(server);
  [b"GET / HT", b"TP/1.1\r\nHost: 127.0.0", b".1\r\n\r", b"\n"].fold((), |u: Unit, piece: Bytes| {
    sent(c, piece);
    time.sleep_ms(20)
  });
  let response = heard(c, 10000);
  assert(response.starts_with("HTTP/1.1 200 OK\r\n"), Some("got:\n" ++ response));
  returned(server)
}

test "the same program is hermetic under ply test" {
  scratch(|| {
    hello();
    let r = on_disk(["test"]);
    assert(r.code == 0, Some("got:\n" ++ said(r)));
    assert(
      !said(r).contains("E0424"),
      Some(
        "the tests handle every `net` and `config` operation themselves, so none reaches the boundary:\n"
          ++ said(r),
      ),
    )
  })
}

fn reaching_test(port: Int) -> Unit / {Here, abort.raise} =
  project([
    {
      path: "touch.ply",
      text: "import std.net (net)\n\nfn touch() -> Int / {net.write[listener]} = {\n  let l = net.listen[listener]("
        ++ port.to_string()
        ++ ");\n  net.close[listener](l);\n  l\n}\n\ntest/nondet \"reaches the host\" { assert(touch() > 0) }\n",
    },
  ])

test/nondet "a host-backed pass stands for its binding, and not for another's" {
  reaching_test(reserve());
  let first = spawned(["test", "--host"], []);
  assert(first.code == 0, Some("got:\n" ++ said(first)));
  assert(said(first).contains("1 host-backed"), Some("got:\n" ++ said(first)));
  assert(!said(first).contains(", 1 cached"), Some("got:\n" ++ said(first)));
  let again = spawned(["test", "--host"], []);
  assert(again.code == 0, Some("got:\n" ++ said(again)));
  assert(
    said(again).contains(", 1 cached"),
    Some("nothing the pass read moved, yet it ran again:\n" ++ said(again)),
  );
  // The network is every run's, so a run without the flag reaches it too, under its own binding.
  let r = spawned(["test"], []);
  assert(r.code == 0, Some("got:\n" ++ said(r)));
  assert(said(r).contains("1 host-backed"), Some("got:\n" ++ said(r)));
  assert(
    !said(r).contains(", 1 cached"),
    Some("a pass earned under another binding stood for this one:\n" ++ said(r)),
  )
}

test/nondet "task spawn under the flag runs on the production scheduler" {
  project([
    {
      path: "tasks.ply",
      text:
        \\fn main() -> Int / {task.write, abort.raise} = {
        \\  let a = task.spawn(|| 1);
        \\  let b = task.spawn(|| 2);
        \\  task.join(a) + task.join(b)
        \\}
        \\
    },
  ]);
  let r = spawned(["run", "--host"], []);
  assert(r.code == 0, Some("got:\n" ++ said(r)));
  assert(said(r).contains("3"), Some("got:\n" ++ said(r)));
  // Hermetically, the program reaches the boundary and is told both remedies rather than getting
  // real threads.
  let hermetic = spawned(["run"], []);
  assert(hermetic.code != 0, Some("got:\n" ++ said(hermetic)));
  assert(said(hermetic).contains("E0424"), Some("got:\n" ++ said(hermetic)));
  assert(said(hermetic).contains("task.spawn"), Some("got:\n" ++ said(hermetic)))
}
