//! What a program embeds, read beside the module that asks and run as the program's own: a file, a
//! directory's files below it with what a cache or a tool hides passed over, and what a shipped
//! module embeds from beside it in the binary.

import spawning.harness (assert_ok, write_project, all_output, spawned)

// `std.oid` embeds `oid/names.txt` from beside it, which a program has no file for: the load asks
// the binary for it by name.
test/nondet "a program runs what a shipped module it imports embedded" {
  write_project([
    {
      path: "m.ply",
      text: "import std.oid\n\ntest \"named\" {\n  assert_eq(oid::name(oid::common_name()), Some(\"commonName\"));\n  assert_eq(oid::of_name(\"id-Ed25519\"), Some(oid::ed25519()))\n}\n",
    },
  ]);
  let ran = spawned(["test", ".", "--no-cache"]);
  assert_ok(ran);
  assert(all_output(ran).contains("1 passed"), Some(all_output(ran)))
}

// `std.hash.legacy` is `hash/legacy.ply` below the library, beside `std.hash`'s `hash.ply`.
test/nondet "a shipped module below the library is imported by its place, beside its parent" {
  write_project([
    {
      path: "m.ply",
      text: "import std.hash (sha256)\nimport std.hash.legacy (sha1)\nimport std.bytes\n\ntest \"both\" {\n  assert_eq(sha1(b\"abc\").hex_of(), \"a9993e364706816aba3e25717850c26c9cd0d89d\");\n  assert_eq(sha256(b\"abc\").len(), 32)\n}\n",
    },
  ]);
  let ran = spawned(["test", ".", "--no-cache"]);
  assert_ok(ran);
  assert(all_output(ran).contains("1 passed"), Some(all_output(ran)))
}
