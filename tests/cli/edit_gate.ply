//! A warm `ply` returns what a cold one does after an edit, through the real binary, its shipped
//! pack and the cache on disk. Each edit is made to a module of a project whose cache the last run
//! wrote: `ply check` and `ply test` over that cache must return what they return from nothing,
//! hashes, types, effects and test results included, and once the edit is undone, what they
//! returned before the edit. A pull request runs the fixtures no in-process test reaches, with an
//! edit for each way a cached result stops standing; `edit_matrix` runs every edit over every
//! fixture nightly.

import compiler.syntax.items (parse, Module, Item, FunctionItem, TypeItem, EffectItem, DeriveItem,
                              EffectSetItem, InstanceItem, NumericItem, FnDefinition, SumBody,
                              Public)
import compiler.syntax.expressions (expression_span)
import compiler.syntax.fmt (line_end)
import compiler.expand.embed (EmbedRequest, embed_requests)
import harness (PlyProcess, spawned, spawned_from_scratch)
import support.harness (Source, RunResult, WorkingDirectory, write_project, stable_report, json_of,
                        json_text, at, items, nth, bool)
import std.fs (fs)
import std.location (spliced)
import std.json (Json, Object, Array)
import std.list
import std.string

/// A kind of edit the gate makes to a module.
pub type Edit =
  | AddFn
  | Comment
  | WrapBody
  | RaiseBody
  | Unexport
  | RenameFn
  | RemoveFn
  | AddImport
  | RemoveImport
  | AddTest
  | AddVariant
  | AddField
  | DropStatement
  | NarrowSet
  | AddOp
  | TouchEmbed

pub fn every_edit() -> List<Edit> =
  [
    AddFn,
    Comment,
    WrapBody,
    RaiseBody,
    Unexport,
    RenameFn,
    RemoveFn,
    AddImport,
    RemoveImport,
    AddTest,
    AddVariant,
    AddField,
    DropStatement,
    NarrowSet,
    AddOp,
    TouchEmbed,
  ]

fn edit_name(e: Edit) -> String =
  match e {
    AddFn -> "a function added",
    Comment -> "a comment above the items",
    WrapBody -> "a body rewritten to mean the same",
    RaiseBody -> "a body that now raises",
    Unexport -> "a function made private",
    RenameFn -> "a public function renamed",
    RemoveFn -> "a function removed",
    AddImport -> "an import added",
    RemoveImport -> "an import removed",
    AddTest -> "a test added",
    AddVariant -> "a variant added",
    AddField -> "a field added",
    DropStatement -> "a derive, key, show, gen or numeric removed",
    NarrowSet -> "an effect set narrowed",
    AddOp -> "an operation added to an effect",
    TouchEmbed -> "a file an embed reads changed",
  }

/// A file an edit writes, whole.
type Change = { path: String, bytes: Bytes }

fn module_of(src: Bytes) -> Option<Module> / {abort.raise} = {
  let p = parse(src);
  if p.parser.diagnostics.len() > 0 { None } else { Some(p.node) }
}

fn functions_of(m: Module) -> List<FnDefinition> =
  m.items.fold([], |acc: List<FnDefinition>, item: Item|
    match item { FunctionItem(d) -> acc.push(d), _ -> acc })

/// Where a line goes above every item: past the last import, else past the module's `//!` lines.
fn header_end(text: Bytes, m: Module) -> Int / {abort.raise} =
  match m.imports.last() {
    Some(i) -> line_end(text, i.span.end),
    None -> heading_end(text, 0, text.len() + 1),
  }

fn heading_end(text: Bytes, at: Int, left: Int) -> Int / {abort.raise} =
  if left <= 0 || at >= text.len() { at }
  else if text.slice(at, text.len()).starts_with(b"//!") || text.at(at) == 10 {
    heading_end(text, line_end(text, at), left - 1)
  } else { at }

/// Where `needle` last starts in `text` before `end`.
fn last_before(text: Bytes, needle: Bytes, end: Int) -> Option<Int> / {abort.raise} =
  range(0, max(0, end - needle.len() + 1)).fold(None, |found: Option<Int>, i: Int|
    if text.slice(i, i + needle.len()) == needle { Some(i) } else { found })

/// The last `}` in `text` between `start` and `end`.
fn last_brace(text: Bytes, start: Int, end: Int) -> Option<Int> / {abort.raise} =
  range(start, end).fold(None, |found: Option<Int>, i: Int|
    if text.at(i) == 125 { Some(i) } else { found })

/// The byte before `at` that is no space, tab or newline.
fn last_non_blank_before(text: Bytes, at: Int) -> Int / {abort.raise} =
  range(0, at).fold(0 - 1, |found: Int, i: Int| {
    let b = text.at(i);
    if b == 32 || b == 9 || b == 10 { found } else { b }
  })

fn sibling_path(path: String, file: String) -> String / {abort.raise} = {
  let b = Bytes::of_string(path);
  let slash = range(0, b.len()).fold(0 - 1, |found: Int, i: Int|
    if b.at(i) == 47 { i } else { found });
  if slash < 0 { file } else { String::of_bytes(b.slice(0, slash)) ++ "/" ++ file }
}

/// `xs` each once, in the order each first appears.
fn distinct(xs: List<String>) -> List<String> =
  xs.fold(
    { seen: Map::new(), out: [] },
    |acc: { seen: Map<String, Bool>, out: List<String> }, x: String|
      if acc.seen.contains(x) { acc }
      else { { seen: acc.seen.insert(x, true), out: acc.out.push(x) } },
  ).out

/// What `e` makes of the module at `path`, whose text is `src`, as the files it writes; none where
/// the module holds nothing it edits.
fn edited(
  e: Edit,
  path: String,
  src: Bytes,
) -> Option<List<Change>> / {WorkingDirectory, abort.raise} =
  match e {
    TouchEmbed -> match module_of(src) {
      None -> None,
      Some(m) -> match embed_requests(m).filter(|w: EmbedRequest| !w.dir).first() {
        None -> None,
        Some(w) -> {
          let file = sibling_path(path, String::of_bytes(w.path));
          match fs.read_file[cwd](file) {
            None -> None,
            Some(bytes) -> Some([{ path: file, bytes: bytes.concat(b"\n") }]),
          }
        },
      },
    },
    _ -> match edited_text(e, src) { Some(b) -> Some([{ path: path, bytes: b }]), None -> None },
  }

/// What `e` makes of a module's text, for every edit but one to a file it embeds.
fn edited_text(e: Edit, src: Bytes) -> Option<Bytes> / {abort.raise} =
  match module_of(src) {
    None -> None,
    Some(m) -> {
      let one = |bytes: Bytes| Some(bytes);
      match e {
        AddFn -> one(src.concat(b"\n/// What the gate added.\npub fn gate_added() -> Int = 7\n")),
        Comment -> {
          let at = header_end(src, m);
          one(spliced(src, at, at, b"// the gate's note\n"))
        },
        WrapBody -> match functions_of(m).first() {
          None -> None,
          Some(d) -> {
            let s = expression_span(d.body);
            one(
              spliced(
                src,
                s.start,
                s.end,
                Bytes::concat_all([b"{ ", src.slice(s.start, s.end), b" }"]),
              ),
            )
          },
        },
        RaiseBody -> match functions_of(m).first() {
          None -> None,
          Some(d) -> {
            let s = expression_span(d.body);
            one(spliced(src, s.start, s.end, b"panic(\"the gate\")"))
          },
        },
        Unexport -> match functions_of(m).filter(|d: FnDefinition| d.visibility == Public).first() {
          None -> None,
          Some(d) -> match last_before(src, b"pub ", d.name.span.start) {
            Some(i) -> one(spliced(src, i, i + 4, b"")),
            None -> None,
          },
        },
        RenameFn -> match functions_of(m).filter(|d: FnDefinition| d.visibility == Public).first() {
          None -> None,
          Some(d) ->
            one(spliced(src, d.name.span.start, d.name.span.end, d.name.name.concat(b"_moved"))),
        },
        RemoveFn -> match functions_of(m).last() {
          None -> None,
          Some(d) -> one(spliced(src, d.span.start, d.span.end, b"")),
        },
        AddImport -> {
          let at = header_end(src, m);
          one(spliced(src, at, at, b"import std.option\n"))
        },
        RemoveImport -> match m.imports.first() {
          None -> None,
          Some(i) -> one(spliced(src, i.span.start, line_end(src, i.span.end), b"")),
        },
        AddTest -> one(src.concat(b"\ntest \"the gate's test\" {\n  assert(true)\n}\n")),
        AddVariant -> {
          let sums = m.items.fold([], |acc: List<Int>, item: Item|
            match item {
              TypeItem(d) -> match d.body { SumBody(_) -> acc.push(d.span.end), _ -> acc },
              _ -> acc,
            });
          match sums.first() {
            None -> None,
            Some(end) -> one(spliced(src, end, end, b" | GateVariant")),
          }
        },
        AddField -> {
          let records = m.items.fold([], |acc: List<Int>, item: Item|
            match item {
              TypeItem(d) -> match d.body {
                SumBody(_) -> acc,
                _ -> match last_brace(src, d.span.start, d.span.end) {
                  Some(i) -> acc.push(i),
                  None -> acc,
                },
              },
              _ -> acc,
            });
          match records.first() {
            None -> None,
            Some(i) -> {
              let before = last_non_blank_before(src, i);
              one(
                spliced(src, i, i, if before == 44 || before == 123 { b" gate_field: Int " }
                else { b", gate_field: Int " }),
              )
            },
          }
        },
        DropStatement -> {
          let spans = m.items.fold([], |acc: List<{ start: Int, end: Int }>, item: Item|
            match item {
              DeriveItem(d) -> acc.push({ start: d.span.start, end: d.span.end }),
              InstanceItem(d) -> acc.push({ start: d.span.start, end: d.span.end }),
              NumericItem(d) -> acc.push({ start: d.span.start, end: d.span.end }),
              _ -> acc,
            });
          match spans.first() { None -> None, Some(s) -> one(spliced(src, s.start, s.end, b"")) }
        },
        NarrowSet -> {
          let cuts = m.items.fold([], |acc: List<{ start: Int, end: Int }>, item: Item|
            match item {
              EffectSetItem(d) -> {
                let n = d.listed.len();
                if n < 2 { acc } else {
                  match ((d.listed.at(n - 2), d.listed.at(n - 1))) {
                    (Some(a), Some(b)) -> acc.push({ start: a.span.end, end: b.span.end }),
                    _ -> acc,
                  }
                }
              },
              _ -> acc,
            });
          match cuts.first() { None -> None, Some(s) -> one(spliced(src, s.start, s.end, b"")) }
        },
        AddOp -> {
          let ends = m.items.fold([], |acc: List<Int>, item: Item|
            match item {
              EffectItem(d) -> match last_brace(src, d.span.start, d.span.end) {
                Some(i) -> acc.push(i),
                None -> acc,
              },
              _ -> acc,
            });
          match ends.first() {
            None -> None,
            Some(i) -> one(spliced(src, i, i, b"\n  read gate_peek() -> Int\n")),
          }
        },
        TouchEmbed -> None,
      }
    },
  }

// --- Sessions ---------------------------------------------------------------------------------

fn write_change(c: Change) -> Unit / {WorkingDirectory, abort.raise} =
  assert(fs.write_file[cwd](c.path, c.bytes), Some("`" ++ c.path ++ "` is written"))

fn read_bytes(path: String) -> Bytes / {WorkingDirectory, abort.raise} =
  match fs.read_file[cwd](path) { Some(b) -> b, None -> panic("`" ++ path ++ "` reads") }

/// Where `a` and `b` first differ, as a path into them and what each holds there.
fn difference(a: Json, b: Json, at: String) -> String / {abort.raise} =
  match ((a, b)) {
    (Object(x), Object(y)) -> {
      let keys = distinct(x.keys().concat(y.keys()));
      match keys.filter(|k: String| x.get(k) != y.get(k)).first() {
        None -> at ++ ": alike",
        Some(k) -> match ((x.get(k), y.get(k))) {
          (Some(u), Some(v)) -> difference(u, v, at ++ "." ++ k),
          (Some(_), None) -> at ++ "." ++ k ++ " is only in the first",
          _ -> at ++ "." ++ k ++ " is only in the second",
        },
      }
    },
    (Array(xs), Array(ys)) -> if xs.len() != ys.len() {
      at ++ " holds " ++ xs.len().to_string() ++ " against " ++ ys.len().to_string()
        ++ "; first apart at "
        ++ first_list_difference(xs, ys, at)
    } else { first_list_difference(xs, ys, at) },
    _ -> at ++ ": " ++ clipped(json_text(a)) ++ " against " ++ clipped(json_text(b)),
  }

fn first_list_difference(xs: List<Json>, ys: List<Json>, at: String) -> String / {abort.raise} =
  match range(0, max(xs.len(), ys.len())).filter(|i: Int| xs.at(i) != ys.at(i)).first() {
    None -> at ++ ": alike",
    Some(i) -> match ((xs.at(i), ys.at(i))) {
      (Some(u), Some(v)) -> difference(u, v, at ++ "[" ++ i.to_string() ++ "]"),
      (Some(u), None) ->
        at ++ "[" ++ i.to_string() ++ "] is only in the first: " ++ clipped(json_text(u)),
      (None, Some(v)) ->
        at ++ "[" ++ i.to_string() ++ "] is only in the second: " ++ clipped(json_text(v)),
      _ -> at ++ ": alike",
    },
  }

fn clipped(s: String) -> String = if s.len() <= 300 { s } else { s.slice(0, 300) ++ "…" }

/// What a session of edits found: the steps where the warm result was not the cold one, or where an
/// undone edit did not land on the result it began from, and how many edits it made.
type Session = { mismatches: List<String>, made: Int }

/// What a run of the tests returned that a cache could decide: how it exited, and each test that
/// failed with the code it failed with.
fn outcome(report: Json) -> Json =
  Object(
    Map::new().insert("exit_code", at(report, "exit_code")).insert(
      "failures",
      Array(
        items(at(report, "failures")).map(|f: Json|
          Array([at(f, "key"), at(at(f, "diagnostic"), "code")])),
      ),
    ),
  )

/// What a session compares after each step: the project checked, and with `runs` how its tests
/// ended too, which cached emitter results and passes decide, as the check does not.
fn observed_state<| e>(
  runs: Bool,
  run: (List<String>) -> RunResult / {abort.raise | e},
) -> Json / {abort.raise | e} = {
  let check = stable_report(json_of(run(["check", ".", "--explain", "--json"])));
  if !runs { check } else { Array([check, outcome(json_of(run(["test", ".", "--json"])))]) }
}

/// The project as it stands, checked through its memo store.
fn warm_of(runs: Bool) -> Json / {PlyProcess, abort.raise} =
  observed_state(runs, |argv: List<String>| spawned(argv))

/// The same from nothing.
fn cold_of(runs: Bool) -> Json / {PlyProcess, WorkingDirectory, abort.raise} =
  observed_state(runs, spawned_from_scratch)

/// What a session makes of its project: the edits, and whether a run of the tests follows the check
/// once an edit is undone, which only a pass that wrongly outlived the undo could fail.
pub type Plan = { edits: List<Edit>, tests_after_undo: Bool }

/// One step of a session, its edit made: what the warm result and the cold one say, and, once
/// `undo` undid it, what the warm one says against `start`.
fn record_step(
  start: Json,
  plan: Plan,
  out: Session,
  step: String,
  undo: () -> Unit / {WorkingDirectory, abort.raise},
) -> Session / {PlyProcess, WorkingDirectory, abort.raise} = {
  let warm = warm_of(true);
  let fresh = cold_of(true);
  let seen = if warm == fresh { out.mismatches }
  else { out.mismatches.push(step ++ ": " ++ difference(warm, fresh, "answer")) };
  undo();
  let back = warm_of(plan.tests_after_undo);
  let wanted = if plan.tests_after_undo { start } else { nth(start, 0) };
  {
    mismatches: if back == wanted { seen }
    else { seen.push(step ++ ", undone: " ++ difference(back, wanted, "answer")) },
    made: out.made + 1,
  }
}

/// Each edit `plan` names made to each module at `paths` under the working directory, one at a time
/// and undone after, the project checked and its tests run after each.
fn disagreements(
  paths: List<String>,
  plan: Plan,
) -> Session / {PlyProcess, WorkingDirectory, abort.raise} = {
  let start = warm_of(true);
  let cold = cold_of(true);
  let before_any = if start == cold { [] }
  else { ["before any edit: " ++ difference(start, cold, "answer")] };
  paths.fold({ mismatches: before_any, made: 0 }, |acc: Session, path: String|
    plan.edits.fold(acc, |out: Session, e: Edit|
      match edited(e, path, read_bytes(path)) {
        None -> out,
        Some(changes) -> {
          let before = changes.map(|c: Change| { path: c.path, bytes: read_bytes(c.path) });
          changes.fold((), |_: Unit, c: Change| write_change(c));
          record_step(start, plan, out, path ++ ", " ++ edit_name(e), ||
            before.fold((), |_: Unit, c: Change| write_change(c)))
        },
      }))
}

fn agrees(paths: List<String>, plan: Plan) -> Unit / {PlyProcess, WorkingDirectory, abort.raise} = {
  let opening = cold_of(false);
  assert(
    bool(at(opening, "ok")) && items(at(opening, "diagnostics")).len() == 0,
    Some(
      "the project checks cold with nothing to warn of: "
        ++ clipped(json_text(at(opening, "diagnostics"))),
    ),
  );
  let session = disagreements(paths, plan);
  assert(session.made > 0, Some("a session makes an edit"));
  assert(
    session.mismatches.len() == 0,
    Some(
      "a result through the memo store was not the one from nothing:\n"
        ++ String::join(session.mismatches, "\n"),
    ),
  )
}

// --- A fixture for each kind of item ----------------------------------------------------------

/// A project of two modules: `lib`, which holds the kind of item the fixture is named for, and
/// `app`, which reads it the way an importer does.
type Fixture = { name: String, files: List<Source> }

fn lib_app(name: String, lib: String, app: String) -> Fixture =
  { name: name, files: [{ path: "lib.ply", text: lib }, { path: "app.ply", text: app }] }

fn catalogue() -> List<Fixture> =
  [
    lib_app(
      "fn",
      "/// Twice its argument.\npub fn twice(x: Int) -> Int = x * 2\n\npub fn thrice(x: Int) -> Int = {\n  let doubled = twice(x);\n  doubled + x\n}\n",
      "import lib\n\npub fn four() -> Int = lib::twice(2)\n\ntest \"four and three\" {\n  assert_eq(four() + lib::thrice(1), 7)\n}\n",
    ),
    lib_app(
      "sum type",
      "pub type Shape =\n  | Dot\n  | Line(Int)\n\npub fn length(s: Shape) -> Int =\n  match s {\n    Dot -> 0,\n    Line(n) -> n,\n  }\n",
      "import lib\nimport lib (Dot, Line)\n\npub fn kind(s: lib::Shape) -> Int =\n  match s {\n    Dot -> 0,\n    Line(_) -> 1,\n  }\n\npub fn total(shapes: List<lib::Shape>) -> Int =\n  shapes.fold(0, |acc: Int, s: lib::Shape| acc + lib::length(s))\n\ntest \"a line is longer than a dot\" {\n  assert_eq(total([Line(2), Dot]), 2)\n}\n",
    ),
    lib_app(
      "type alias",
      "pub type Point = { x: Int, y: Int }\n\npub type Money = Int\n\npub fn origin() -> Point = { x: 0, y: 0 }\n",
      "import lib\n\npub fn moved(p: lib::Point) -> lib::Point = { x: p.x + 1, y: p.y }\n\npub fn cost() -> lib::Money = 3\n\ntest \"one step right\" {\n  assert_eq(moved(lib::origin()).x, 1)\n}\n",
    ),
    lib_app(
      "new type",
      "pub type Celsius = new { degrees: Int }\n\npub fn freezing() -> Celsius = { degrees: 0 }\n\npub fn degrees(c: Celsius) -> Int = c.degrees\n",
      "import lib\n\npub fn warmer() -> Int = lib::degrees(lib::freezing()) + 1\n\ntest \"warmer than freezing\" {\n  assert_eq(warmer(), 1)\n}\n",
    ),
    lib_app(
      "opaque type",
      "pub opaque type Count = new { n: Int }\n\npub fn zero() -> Count = { n: 0 }\n\npub fn next(c: Count) -> Count = { n: c.n + 1 }\n\npub fn value(c: Count) -> Int = c.n\n",
      "import lib\n\npub fn two() -> Int = lib::value(lib::next(lib::next(lib::zero())))\n\ntest \"two steps\" {\n  assert_eq(two(), 2)\n}\n",
    ),
    lib_app(
      "effect",
      "pub effect log {\n  write emit(Bytes) -> Unit\n  read peek() -> Int\n}\n\npub fn say(b: Bytes) -> Unit / {log.write} = log.emit(b)\n",
      "import lib\n\npub fn said() -> Int =\n  handle {\n    lib::say(b\"a\");\n    2\n  } with {\n    lib::log.emit(_) -> (),\n  }\n\ntest \"said\" {\n  assert_eq(said(), 2)\n}\n",
    ),
    lib_app(
      "effect set",
      "pub effect log {\n  write emit(Bytes) -> Unit\n  read peek() -> Int\n}\n\npub effect set Logging = {log.write, log.read}\n\npub fn noted() -> Int / {Logging} = {\n  log.emit(b\"x\");\n  log.peek()\n}\n",
      "import lib\n\npub fn twice_noted() -> Int / {lib::Logging} = lib::noted() + lib::noted()\n",
    ),
    lib_app(
      "derive",
      "import std.json\n\npub type Box =\n  | Box(Int)\n\nderive json for Box\n\npub fn boxed(n: Int) -> Box = Box(n)\n",
      "import lib\n\npub fn same(a: lib::Box, b: lib::Box) -> Bool = a == b\n\ntest \"a box is itself\" {\n  assert(same(lib::boxed(1), lib::boxed(1)))\n}\n",
    ),
    lib_app(
      "key",
      "pub type Tag =\n  | Tag(Int)\n\npub fn tag_key(t: Tag) -> Int =\n  match t {\n    Tag(n) -> n,\n  }\n\nkey for Tag by tag_key\n\npub fn tagged(n: Int) -> Tag = Tag(n)\n",
      "import lib\n\npub fn same(a: lib::Tag, b: lib::Tag) -> Bool = a == b\n\ntest \"a tag is itself\" {\n  assert(same(lib::tagged(1), lib::tagged(1)))\n}\n",
    ),
    lib_app(
      "show",
      "pub type Mark =\n  | Mark(Int)\n\npub fn shown(m: Mark) -> String = \"mark\"\n\nshow for Mark by shown\n\npub fn marked() -> Mark = Mark(1)\n",
      "import lib\n\npub fn label() -> String = \"{lib::marked()}\"\n",
    ),
    lib_app(
      "numeric",
      "pub type Small =\n  | Small(Int)\n\npub fn of(s: Small) -> Int =\n  match s {\n    Small(n) -> n,\n  }\n\npub fn add(a: Small, b: Small) -> Small = Small(of(a) + of(b))\npub fn sub(a: Small, b: Small) -> Small = Small(of(a) - of(b))\npub fn mul(a: Small, b: Small) -> Small = Small(of(a) * of(b))\npub fn neg(a: Small) -> Small = Small(0 - of(a))\npub fn of_int(n: Int) -> Small = Small(n)\n\nnumeric for Small by { add: add, sub: sub, mul: mul, neg: neg, of_int: of_int }\n",
      "import lib\n\npub fn summed(a: lib::Small, b: lib::Small) -> lib::Small = a + b\n\ntest \"one and two\" {\n  assert(summed(lib::of_int(1), lib::of_int(2)) == lib::of_int(3))\n}\n",
    ),
    lib_app(
      "law",
      "pub fn twice(x: Int) -> Int = x + x\n\nlaw \"twice doubles\" forall (x: Int) {\n  twice(x) == 2 * x\n}\n",
      "import lib\n\npub fn four() -> Int = lib::twice(2)\n",
    ),
    lib_app(
      "law schema",
      "pub law schema round_trip<a, b | e>(encode: (a) -> b / e, decode: (b) -> Option<a> / e)\n  forall (x: a) { decode(encode(x)) == Some(x) }\n\npub fn wrap(n: Int) -> List<Int> = [n]\n\npub fn unwrap(xs: List<Int>) -> Option<Int> = xs.at(0)\n",
      "import lib\n\nlaw \"a wrap unwraps\" = lib::round_trip(lib::wrap, lib::unwrap)\n",
    ),
    lib_app(
      "test",
      "pub fn one() -> Int = 1\n\ntest \"one is one\" {\n  assert_eq(one(), 1)\n}\n",
      "import lib\n\ntest \"one and one\" {\n  assert_eq(lib::one() + lib::one(), 2)\n}\n",
    ),
    lib_app(
      "test over cases",
      "pub fn table() -> List<Int> = [1, 2]\n\npub fn held(n: Int) -> Bool = n > 0\n\ntest \"{n} holds\" for n: Int in table() {\n  assert(held(n))\n}\n",
      "import lib\n\ntest \"{n} holds here too\" for n: Int in lib::table() {\n  assert(lib::held(n))\n}\n",
    ),
    lib_app(
      "const fn",
      "pub const fn table() -> List<Int> = [1, 2, 3]\n\npub fn summed() -> Int = table().fold(0, |acc: Int, n: Int| acc + n)\n",
      "import lib\n\npub fn six() -> Int = lib::summed()\n\ntest \"six\" {\n  assert_eq(six(), 6)\n}\n",
    ),
    lib_app(
      "transparent fn",
      "pub transparent fn same(x: Int) -> Int = x\n",
      "import lib\n\npub fn kept(x: Int) -> Int ensures result == x = lib::same(x)\n",
    ),
    {
      name: "embed",
      files: [
        {
          path: "lib.ply",
          text: "pub fn data() -> Bytes = embed(\"data.txt\")\n\npub fn size() -> Int = data().len()\n",
        },
        { path: "data.txt", text: "four" },
        {
          path: "app.ply",
          text: "import lib\n\npub fn twice() -> Int = lib::size() * 2\n\ntest \"eight\" {\n  assert(twice() >= 8)\n}\n",
        },
      ],
    },
    lib_app(
      "tagged literal",
      "pub fn literal(text: String) -> Result<Int, { message: String, offset: Int }> =\n  if text.len() > 0 { Ok(text.len()) }\n  else { Err({ message: \"empty\", offset: 0 }) }\n",
      "import lib\n\npub fn three() -> Int = lib\"abc\"\n\ntest \"three\" {\n  assert_eq(three(), 3)\n}\n",
    ),
  ]

fn fixture(name: String) -> Fixture / {abort.raise} =
  match catalogue().filter(|f: Fixture| f.name == name).first() {
    Some(f) -> f,
    None -> panic("no fixture is named `" ++ name ++ "`"),
  }

pub fn fixture_names() -> List<String> = catalogue().map(|f: Fixture| f.name)

/// `plan` made over the project the fixture named `name` holds.
pub fn session_agrees(
  name: String,
  plan: Plan,
) -> Unit / {PlyProcess, WorkingDirectory, abort.raise} = {
  let f = fixture(name);
  write_project(f.files);
  agrees(f.files.filter(|s: Source| s.path.ends_with(".ply")).map(|s: Source| s.path), plan)
}

/// The fixtures whose checks compile and enter code, or that depend on how a `test` over cases is
/// cached, which no in-process test reaches, with `fn` to show that the gate itself works.
fn pull_request_fixtures() -> List<String> =
  ["fn", "derive", "const fn", "tagged literal", "test over cases"]

/// An edit for each way a cached result stops standing: a body, a name, an import and a new test.
fn pull_request_edits() -> List<Edit> = [WrapBody, RenameFn, AddImport, AddTest]

test/nondet "{name} agrees warm and cold through an edit of each way a result stops standing" for name: String in pull_request_fixtures(
  ) { session_agrees(name, { edits: pull_request_edits(), tests_after_undo: false }) }

test/nondet "a file an embed reads agrees warm and cold when it changes" {
  session_agrees("embed", { edits: [TouchEmbed], tests_after_undo: false })
}

test "an edit is made where its kind of item is, and nowhere it is not" {
  let src = b"import std.option\n\npub type Shape =\n  | Dot\n\npub fn one() -> Int = 1\n";
  let made = [AddVariant, Unexport, RenameFn, WrapBody, RemoveImport, NarrowSet, AddOp].map(
    |e: Edit| match edited_text(e, src) { Some(b) -> b, None -> b"-" },
  );
  assert_eq(made, [
    b"import std.option\n\npub type Shape =\n  | Dot | GateVariant\n\npub fn one() -> Int = 1\n",
    b"import std.option\n\npub type Shape =\n  | Dot\n\nfn one() -> Int = 1\n",
    b"import std.option\n\npub type Shape =\n  | Dot\n\npub fn one_moved() -> Int = 1\n",
    b"import std.option\n\npub type Shape =\n  | Dot\n\npub fn one() -> Int = { 1 }\n",
    b"\npub type Shape =\n  | Dot\n\npub fn one() -> Int = 1\n",
    b"-",
    b"-",
  ])
}
