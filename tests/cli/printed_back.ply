//! Stored bodies printed back to source, as the commands that print them meet it: `ply build` prints
//! an entry point's closure into its artifact and checks it again, and a bisection prints every
//! mixture it runs. Each program here is written in forms whose stored body takes care to print
//! as a program that checks: alternatives, a `let else`, a promised row, an opaque type, a hold,
//! a library's own extern.

import harness (Here, Spawned, spawned, Source, program, project, write, on_disk, said,
                stdout, json_of, at, path, truth, shown, assert_ok, manifest, dep)
import std.json (Str)
import std.string

/// The program at `dir` run and built: its source answers `answer`, and so does its artifact.
fn built_answers(dir: String, answer: String) -> Unit / {Spawned, abort.raise} = {
  let from_source = json_of(spawned(["run", dir, "--json"]));
  assert(truth(at(from_source, "ok")), Some(shown(from_source)));
  assert(at(from_source, "value") == Str(answer), Some(shown(from_source)));
  assert_ok(spawned(["build", dir, "-o", "built.plyx"]));
  let from_artifact = json_of(spawned(["run", "built.plyx", "--json"]));
  assert(at(from_artifact, "value") == Str(answer), Some(shown(from_artifact)))
}

test/nondet "an artifact of a program with or-patterns answers what its source does" {
  program(
    \\type T = | A(Int, Int) | B(Int, Int) | C
    \\
    \\fn small(n: Int) -> Int = match n { 1 | 2 | 3 -> 10, 4 | (5 | 6) -> 20, _ -> 0 }
    \\
    \\fn swapped(t: T) -> Int = match t { A(x, y) | B(y, x) -> x * 10 + y, C -> 0 }
    \\
    \\fn guarded(t: T) -> Int = match t { A(x, y) | B(y, x) if x > y -> x, _ -> 0 - 1 }
    \\
    \\fn nested(ts: List<T>) -> Int =
    \\  match ts {
    \\    [(A(x, _) | B(_, x)), ..rest] | [C, A(x, _), ..rest] -> x + rest.len(),
    \\    _ -> 0,
    \\  }
    \\
    \\fn fields(p: { a: Int, b: Int }) -> Int =
    \\  match p { { a: 0, b: v } | { a: v, b: 0 } -> v, _ -> 0 - 1 }
    \\
    \\fn left(t: T) -> Int = {
    \\  let A(n, _) | B(_, n) = t else { 0 - 5 };
    \\  n
    \\}
    \\
    \\fn both(r: Result<Int, Int>) -> Int = {
    \\  let Ok(v) | Err(v) = r;
    \\  v
    \\}
    \\
    \\fn main() -> Int =
    \\  small(2) + small(5) + small(9) + swapped(A(1, 2)) + swapped(B(1, 2)) + guarded(A(5, 1))
    \\    + guarded(B(5, 1))
    \\    + nested([B(0, 7), C])
    \\    + nested([C, A(3, 0), C, C])
    \\    + fields({ a: 0, b: 4 })
    \\    + fields({ a: 6, b: 0 })
    \\    + left(B(0, 9))
    \\    + left(C)
    \\    + both(Ok(1))
    \\    + both(Err(2))
    \\
  );
  built_answers(".", "97")
}

test/nondet "an artifact of a program with a `let else`, a `returns` clause and a `bounded` row answers what its source does" {
  program(
    \\effect log { write emit(n: Int) -> Unit }
    \\
    \\fn first(xs: List<Int>) -> Int = {
    \\  let [x, ..] = xs else { 0 - 1 };
    \\  x
    \\}
    \\
    \\fn kept(n: Int, xs: List<Int>) -> List<Int>
    \\  returns xs
    \\= if n > 0 { xs } else { [] }
    \\
    \\fn made(n: Int) -> List<Int>
    \\  returns fresh
    \\= [n, n]
    \\
    \\fn noted<| e>(n: Int, f: (Int) -> Int / e) -> Int / {log.write bounded | e bounded} = {
    \\  log.emit(n);
    \\  f(n)
    \\}
    \\
    \\fn digit(b: Int) -> Int = match b { b'0'..=b'9' -> b - b'0', _ -> 0 - 1 }
    \\
    \\fn main() -> Int =
    \\  first(made(7)) + first([]) + kept(1, [1, 2]).len() + digit(b'4') * 10
    \\    + handle { noted(3, |n: Int| n * 100) } with { log.emit(n) -> () }
    \\
  );
  built_answers(".", "348")
}

test/nondet "an artifact of a program that opens holds, one inside another and one a raise unwinds, answers what its source does" {
  program(
    \\import std.list
    \\
    \\effect note { write left(n: Int) -> Unit }
    \\
    \\fn weighed<[r]>(h: Hold<Int, [r]>, by: Int) -> Int / {hold.read[r]} = h.get() * by
    \\
    \\fn kept(n: Int) -> Int / {note.write} =
    \\  with_hold[slot](n + 1, |held: Int| note.left(held)) { h -> weighed(h, 2) }
    \\
    \\fn nested(n: Int) -> Int / {note.write} =
    \\  with_hold[outer](n, |held: Int| note.left(held)) { a ->
    \\    with_hold[inner]([a.get(), 2].reverse(), |held: List<Int>| note.left(held.len())) { b ->
    \\      b.get().map(|x: Int| x + a.get()).len() + a.get()
    \\    }
    \\  }
    \\
    \\fn refused(n: Int) -> Int / {note.write} =
    \\  handle {
    \\    with_hold[slot](n, |held: Int| note.left(held)) { h -> b"ab".at(2 + h.get()) }
    \\  } with { abort.raise(m) -> 0 - 1 }
    \\
    \\fn main() -> Int =
    \\  handle { kept(2) + nested(5) + refused(3) } with {
    \\    var seen = 0,
    \\    note.left(held) -> {
    \\      seen = seen * 10 + held;
    \\    },
    \\    return answer -> answer * 100000 + seen,
    \\  }
    \\
  );
  built_answers(".", "1203253")
}

/// A package `lib` whose module holds or-patterns, one of them in a body another package reads, and
/// an `app` that calls it.
fn depending() -> List<Source> =
  [
    { path: "app/ply.pkg", text: manifest("app", dep("lib", "../lib")) },
    {
      path: "app/main.ply",
      text:
        \\import lib.shapes
        \\import lib.shapes (A, B, C)
        \\
        \\fn main() -> Int =
        \\  shapes::pick(A(1, 2)) + shapes::pick(B(1, 2)) + shapes::pick(C)
        \\    + (if shapes::small(2) { 100 } else { 0 })
        \\    + shapes::first([5])
        \\
    },
    { path: "lib/ply.pkg", text: manifest("lib", "") },
    {
      path: "lib/shapes.ply",
      text:
        \\pub type T = | A(Int, Int) | B(Int, Int) | C
        \\
        \\pub fn pick(t: T) -> Int = match t { A(x, y) | B(y, x) -> x * 10 + y, C -> 0 }
        \\
        \\pub transparent fn small(n: Int) -> Bool = match n { 1 | 2 | 3 -> true, _ -> false }
        \\
        \\pub fn first(xs: List<Int>) -> Int = {
        \\  let [x, ..] | [_, x, ..] = xs else { 0 - 1 };
        \\  x
        \\}
        \\
    },
  ]

test/nondet "a path dependency that holds or-patterns checks warm, and its artifact answers what its source does" {
  project(depending());
  assert_ok(on_disk(["check", "app"]));
  let warm = json_of(on_disk(["check", "app", "--json", "--explain"]));
  assert(truth(at(warm, "ok")), Some(shown(warm)));
  built_answers("app", "138")
}

fn ledger() -> String =
  \\import std.option
  \\
  \\type T = | A(Int, Int) | B(Int, Int) | C
  \\
  \\fn normal_sign(t: T) -> Int =
  \\  match t { A(n, _) | B(_, n) -> if n < 0 { 0 - 1 } else { 1 }, C -> 1 }
  \\
  \\fn balance(a: Int, b: Int, c: Int) -> Int = (a + b) + c
  \\
  \\fn first(xs: List<Int>) -> Int = {
  \\  let [x, ..] = xs else { 0 };
  \\  x
  \\}
  \\
  \\fn presented(a: Int, b: Int, c: Int) -> Int =
  \\  balance(first([a]), Some(b).unwrap_or_else(|| 0), c) * normal_sign(B(0, a))
  \\
  \\test "balance never goes negative" { assert_eq(presented(1, 2, 3), 6) }
  \\

/// `source` tested green and then as `edited`, whose failure names `culprit`.
fn blamed(source: String, edited: String, culprit: String) -> Unit / {Spawned, Here, abort.raise} = {
  program(source);
  assert_ok(spawned(["test"]));
  assert(edited != source, Some("the edits did not apply"));
  write("m.ply", edited);
  let r = spawned(["test"]);
  assert(r.code == 1, Some(said(r)));
  assert(stdout(r).contains("culprit: " ++ culprit), Some(said(r)))
}

// A mixture reads the library's definitions from the library: here one whose row is promised
// `bounded`, called on a value.
test/nondet "a bisection names its culprit among definitions written with an or-pattern, a `let else` and a call on a value" {
  blamed(
    ledger(),
    ledger().replace("else { 1 }, C", "else { 0 - 1 }, C").replace("(a + b) + c", "a + (b + c)"),
    "m.normal_sign",
  )
}

fn vault() -> String =
  \\pub opaque type Money = | Money(Int)
  \\
  \\pub fn cents(m: Money) -> Int = match m { Money(c) -> c }
  \\
  \\fn doubled(m: Money) -> Money = Money(cents(m) * 2)
  \\
  \\fn sign(n: Int) -> Int = if n < 0 { 0 - 1 } else { 1 }
  \\
  \\test "money built here is read here" {
  \\  assert_eq(match doubled(Money(2)) { Money(c) -> c * sign(c) }, 4)
  \\}
  \\

// A mixture sets each body in a module of its own, where only an open type could be built.
test/nondet "a bisection names its culprit among definitions that build and match an opaque type" {
  blamed(
    vault(),
    vault().replace("else { 1 }", "else { 0 - 1 }").replace("cents(m) * 2", "2 * cents(m)"),
    "m.sign",
  )
}

fn keeper() -> String =
  \\effect note { write left(n: Int) -> Unit }
  \\
  \\fn sign(n: Int) -> Int = if n < 0 { 0 - 1 } else { 1 }
  \\
  \\fn weighed<[r]>(h: Hold<Int, [r]>, by: Int) -> Int / {hold.read[r]} = h.get() * by
  \\
  \\fn kept(n: Int) -> Int / {note.write} =
  \\  with_hold[slot](n + 1, |held: Int| note.left(held)) { h -> weighed(h, 2) * sign(h.get()) }
  \\
  \\fn tallied(n: Int) -> Int =
  \\  handle { kept(n) } with {
  \\    var seen = 0,
  \\    note.left(held) -> {
  \\      seen = seen + held;
  \\    },
  \\    return answer -> answer + seen,
  \\  }
  \\
  \\test "what is held is read while it is held, and let go once" { assert_eq(tallied(2), 9) }
  \\

// A hold's region, its type and the row of a function handed one are written the same in any module.
test/nondet "a bisection names its culprit among definitions that open a hold and read one handed to them" {
  blamed(
    keeper(),
    keeper().replace("else { 1 }", "else { 0 - 1 }").replace("h.get() * by", "by * h.get()"),
    "m.sign",
  )
}

fn catalogued() -> String =
  \\import std.sqlite
  \\
  \\fn sign(n: Int) -> Int = if n < 0 { 0 - 1 } else { 1 }
  \\
  \\fn weighed(n: Int) -> Int / {abort.raise} = n * 2 + sqlite::functions().len() * 0
  \\
  \\fn kept(n: Int) -> Int / {abort.raise} = weighed(n + 1) * sign(n)
  \\
  \\test "what is weighed keeps its sign" { assert_eq(kept(2), 6) }
  \\

// `sqlite::functions` calls an extern only std.sqlite may name.
test/nondet "a bisection names its culprit among definitions that reach a library's private extern" {
  blamed(
    catalogued(),
    catalogued().replace("else { 1 }", "else { 0 - 1 }").replace("n * 2", "2 * n"),
    "m.sign",
  )
}
