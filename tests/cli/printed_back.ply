import spawning.harness (PlyProcess, spawned, Source, write_program, write_project, json_of, at,
                         bool, json_text, assert_ok, manifest, dependency)
import std.json (Str)
import std.string

fn assert_built_returns(dir: String, result: String) -> Unit / {PlyProcess, abort.raise} = {
  let from_source = json_of(spawned(["run", dir, "--json"]));
  assert(bool(at(from_source, "ok")), Some(json_text(from_source)));
  assert(at(from_source, "value") == Str(result), Some(json_text(from_source)));
  assert_ok(spawned(["build", dir, "-o", "built.plyx"]));
  let from_artifact = json_of(spawned(["run", "built.plyx", "--json"]));
  assert(at(from_artifact, "value") == Str(result), Some(json_text(from_artifact)))
}

test/nondet "a built program that uses or-patterns returns the same value as running its source" {
  write_program(String::of_bytes_lossy(embed("../programs/printed_back/or_patterns.ply")));
  assert_built_returns(".", "97")
}

test/nondet "a built program that uses `let else`, a `returns` clause and `bounded` effects returns the same value as running its source" {
  write_program(String::of_bytes_lossy(embed("../programs/printed_back/let_else.ply")));
  assert_built_returns(".", "348")
}

test/nondet "a built program with nested scopes, one of them exited by a raised error, returns the same value as running its source" {
  write_program(String::of_bytes_lossy(embed("../programs/printed_back/nested_scopes.ply")));
  assert_built_returns(".", "1203253")
}

fn depending() -> List<Source> =
  [
    { path: "app/ply.pkg", text: manifest("app", dependency("lib", "../lib")) },
    {
      path: "app/main.ply",
      text:
        \\import lib.shapes
        \\import lib.shapes (A, B, C)
        \\
        \\fn main() -> Int =
        \\  shapes::pick(A(1, 2)) + shapes::pick(B(1, 2)) + shapes::pick(C)
        \\    + (if shapes::small(2) { 100 } else { 0 })
        \\    + shapes::first([5])
        \\
    },
    { path: "lib/ply.pkg", text: manifest("lib", "") },
    {
      path: "lib/shapes.ply",
      text:
        \\pub type T = | A(Int, Int) | B(Int, Int) | C
        \\
        \\pub fn pick(t: T) -> Int = match t { A(x, y) | B(y, x) -> x * 10 + y, C -> 0 }
        \\
        \\pub transparent fn small(n: Int) -> Bool = match n { 1 | 2 | 3 -> true, _ -> false }
        \\
        \\pub fn first(xs: List<Int>) -> Int = {
        \\  let [x, ..] | [_, x, ..] = xs else { 0 - 1 };
        \\  x
        \\}
        \\
    },
  ]

test/nondet "a program that depends on a package using or-patterns checks again from the cache, and when built returns the same value as running its source" {
  write_project(depending());
  assert_ok(spawned(["check", "app"]));
  let warm = json_of(spawned(["check", "app", "--json", "--explain"]));
  assert(bool(at(warm, "ok")), Some(json_text(warm)));
  assert_built_returns("app", "138")
}
