//! Stored bodies printed back to source, as `ply build` meets it: it prints an entry point's
//! closure into its artifact and checks it again. Each program here is written in forms whose
//! stored body takes care to print as a program that checks: alternatives, a `let else`, a
//! promised row, a hold.

import harness (PlyProcess, spawned, Source, write_program, write_project, on_disk, json_of, at,
                bool, json_text, assert_ok, manifest, dep)
import std.json (Str)
import std.string

/// The program at `dir` run and built: its source answers `answer`, and so does its artifact.
fn assert_built_returns(dir: String, answer: String) -> Unit / {PlyProcess, abort.raise} = {
  let from_source = json_of(spawned(["run", dir, "--json"]));
  assert(bool(at(from_source, "ok")), Some(json_text(from_source)));
  assert(at(from_source, "value") == Str(answer), Some(json_text(from_source)));
  assert_ok(spawned(["build", dir, "-o", "built.plyx"]));
  let from_artifact = json_of(spawned(["run", "built.plyx", "--json"]));
  assert(at(from_artifact, "value") == Str(answer), Some(json_text(from_artifact)))
}

test/nondet "an artifact of a program with or-patterns answers what its source does" {
  write_program(
    \\type T = | A(Int, Int) | B(Int, Int) | C
    \\
    \\fn small(n: Int) -> Int = match n { 1 | 2 | 3 -> 10, 4 | (5 | 6) -> 20, _ -> 0 }
    \\
    \\fn swapped(t: T) -> Int = match t { A(x, y) | B(y, x) -> x * 10 + y, C -> 0 }
    \\
    \\fn guarded(t: T) -> Int = match t { A(x, y) | B(y, x) if x > y -> x, _ -> 0 - 1 }
    \\
    \\fn nested(ts: List<T>) -> Int =
    \\  match ts {
    \\    [(A(x, _) | B(_, x)), ..rest] | [C, A(x, _), ..rest] -> x + rest.len(),
    \\    _ -> 0,
    \\  }
    \\
    \\fn fields(p: { a: Int, b: Int }) -> Int =
    \\  match p { { a: 0, b: v } | { a: v, b: 0 } -> v, _ -> 0 - 1 }
    \\
    \\fn left(t: T) -> Int = {
    \\  let A(n, _) | B(_, n) = t else { 0 - 5 };
    \\  n
    \\}
    \\
    \\fn both(r: Result<Int, Int>) -> Int = {
    \\  let Ok(v) | Err(v) = r;
    \\  v
    \\}
    \\
    \\fn main() -> Int =
    \\  small(2) + small(5) + small(9) + swapped(A(1, 2)) + swapped(B(1, 2)) + guarded(A(5, 1))
    \\    + guarded(B(5, 1))
    \\    + nested([B(0, 7), C])
    \\    + nested([C, A(3, 0), C, C])
    \\    + fields({ a: 0, b: 4 })
    \\    + fields({ a: 6, b: 0 })
    \\    + left(B(0, 9))
    \\    + left(C)
    \\    + both(Ok(1))
    \\    + both(Err(2))
    \\
  );
  assert_built_returns(".", "97")
}

test/nondet "an artifact of a program with a `let else`, a `returns` clause and a `bounded` row answers what its source does" {
  write_program(
    \\effect log { write emit(n: Int) -> Unit }
    \\
    \\fn first(xs: List<Int>) -> Int = {
    \\  let [x, ..] = xs else { 0 - 1 };
    \\  x
    \\}
    \\
    \\fn kept(n: Int, xs: List<Int>) -> List<Int>
    \\  returns xs
    \\= if n > 0 { xs } else { [] }
    \\
    \\fn made(n: Int) -> List<Int>
    \\  returns fresh
    \\= [n, n]
    \\
    \\fn noted<| e>(n: Int, f: (Int) -> Int / e) -> Int / {log.write bounded | e bounded} = {
    \\  log.emit(n);
    \\  f(n)
    \\}
    \\
    \\fn digit(b: Int) -> Int = match b { b'0'..=b'9' -> b - b'0', _ -> 0 - 1 }
    \\
    \\fn main() -> Int =
    \\  first(made(7)) + first([]) + kept(1, [1, 2]).len() + digit(b'4') * 10
    \\    + handle { noted(3, |n: Int| n * 100) } with { log.emit(n) -> () }
    \\
  );
  assert_built_returns(".", "348")
}

test/nondet "an artifact of a program that opens holds, one inside another and one a raise unwinds, answers what its source does" {
  write_program(
    \\import std.list
    \\
    \\effect note { write left(n: Int) -> Unit }
    \\
    \\fn weighed<[r]>(h: Hold<Int, [r]>, by: Int) -> Int / {hold.read[r]} = h.get() * by
    \\
    \\fn kept(n: Int) -> Int / {note.write} =
    \\  with_hold[slot](n + 1, |held: Int| note.left(held)) { h -> weighed(h, 2) }
    \\
    \\fn nested(n: Int) -> Int / {note.write} =
    \\  with_hold[outer](n, |held: Int| note.left(held)) { a ->
    \\    with_hold[inner]([a.get(), 2].reverse(), |held: List<Int>| note.left(held.len())) { b ->
    \\      b.get().map(|x: Int| x + a.get()).len() + a.get()
    \\    }
    \\  }
    \\
    \\fn refused(n: Int) -> Int / {note.write} =
    \\  handle {
    \\    with_hold[slot](n, |held: Int| note.left(held)) { h -> b"ab".at(2 + h.get()) }
    \\  } with { abort.raise(m) -> 0 - 1 }
    \\
    \\fn main() -> Int =
    \\  handle { kept(2) + nested(5) + refused(3) } with {
    \\    var seen = 0,
    \\    note.left(held) -> {
    \\      seen = seen * 10 + held;
    \\    },
    \\    return answer -> answer * 100000 + seen,
    \\  }
    \\
  );
  assert_built_returns(".", "1203253")
}

/// A package `lib` whose module holds or-patterns, one of them in a body another package reads, and
/// an `app` that calls it.
fn depending() -> List<Source> =
  [
    { path: "app/ply.pkg", text: manifest("app", dep("lib", "../lib")) },
    {
      path: "app/main.ply",
      text:
        \\import lib.shapes
        \\import lib.shapes (A, B, C)
        \\
        \\fn main() -> Int =
        \\  shapes::pick(A(1, 2)) + shapes::pick(B(1, 2)) + shapes::pick(C)
        \\    + (if shapes::small(2) { 100 } else { 0 })
        \\    + shapes::first([5])
        \\
    },
    { path: "lib/ply.pkg", text: manifest("lib", "") },
    {
      path: "lib/shapes.ply",
      text:
        \\pub type T = | A(Int, Int) | B(Int, Int) | C
        \\
        \\pub fn pick(t: T) -> Int = match t { A(x, y) | B(y, x) -> x * 10 + y, C -> 0 }
        \\
        \\pub transparent fn small(n: Int) -> Bool = match n { 1 | 2 | 3 -> true, _ -> false }
        \\
        \\pub fn first(xs: List<Int>) -> Int = {
        \\  let [x, ..] | [_, x, ..] = xs else { 0 - 1 };
        \\  x
        \\}
        \\
    },
  ]

test/nondet "a path dependency that holds or-patterns checks warm, and its artifact answers what its source does" {
  write_project(depending());
  assert_ok(on_disk(["check", "app"]));
  let warm = json_of(on_disk(["check", "app", "--json", "--explain"]));
  assert(bool(at(warm, "ok")), Some(json_text(warm)));
  assert_built_returns("app", "138")
}
