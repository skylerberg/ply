import spawning.harness (PlyProcess, RunResult, assert_ok, spawned, write_program, json_of, at,
                         path, int, str, bool, json_text, stderr)
import std.json (Json, Str, Array)
import std.process (environment_variable)
import std.string

fn every_kind() -> String =
  \\effect tally {
  \\  read  base[log]() -> Int
  \\  write note[log](what: Int) -> Unit
  \\}
  \\
  \\fn double(x: Int) -> Int = x * 2
  \\
  \\fn even(x: Int) -> Bool = x % 2 == 0
  \\
  \\fn triple(x: Int) -> Int = x * 3
  \\
  \\fn pair(x: Int) -> List<Int> = [x, x]
  \\
  \\fn label(x: Int) -> String = "n"
  \\
  \\fn grade(x: Int) -> Float = 1.5
  \\
  \\fn refused(x: Int) -> Int = if 1.5 > 0.5 { x + 1 } else { x }
  \\
  \\fn measured(n: Int) -> Int / {tally.read[log], tally.write[log]} = {
  \\  let b = tally.base[log]();
  \\  tally.note[log](n + 1);
  \\  b + n
  \\}
  \\
  \\pub fn handled(n: Int) -> Int =
  \\  handle {
  \\    measured(n)
  \\  } with {
  \\    var noted = 0,
  \\    tally.base[log]() -> 7,
  \\    tally.note[log](what) -> {
  \\      noted = noted + what;
  \\    },
  \\    return out -> out + noted,
  \\  }
  \\
  \\test "double doubles" { assert_eq(double(4), 8) }
  \\test "even is even" { assert(even(4)) }
  \\test "triple triples" { assert_eq(triple(5), 15) }
  \\test "a pair has two" { assert_eq(pair(7).len(), 2) }
  \\test "a pair holds its number" { assert_eq(pair(7), [7, 7]) }
  \\test "a rejected body adds one" { assert_eq(refused(2), 3) }
  \\test "a label is a word" { assert_eq(label(7), "n") }
  \\test "a grade is a float" { assert(grade(7) == 1.5) }
  \\test "a self handled effect still returns" { assert_eq(handled(1), 10) }
  \\

fn cased() -> String =
  \\test "a pair of {n} has two" for n: Int in [1, 2] { assert_eq(pair(n).len(), 2) }
  \\

fn test_report() -> Json / {PlyProcess, abort.raise} =
  json_of(spawned(["test", ".", "-j", "1", "--json"]))

fn backend_count(report: Json, field: String) -> Int = int(path(report, ["backend", field]))

test/nondet "the C code generator passes tests over every kind of value, and the report shows it compiled code" {
  write_program(every_kind() ++ cased());
  let report = test_report();
  let b = json_text(at(report, "backend"));
  assert(bool(at(report, "ok")), Some(json_text(report)));
  assert(int(path(report, ["summary", "failed"])) == 0, Some(json_text(report)));
  assert(str(path(report, ["backend", "name"])) == "c", Some(json_text(report)));
  assert(
    backend_count(report, "entered") > 0,
    Some("the code generator entered nothing, so the seam was never reached: " ++ b),
  );
  assert(backend_count(report, "fragment") > 0, Some(b));
  assert(
    backend_count(report, "units") > 0,
    Some("no unit was compiled, so `c` installed something that is not a code generator: " ++ b),
  )
}

test/nondet "run attaches a backend to main" {
  write_program(
    "fn double(x: Int) -> Int = x * 2\nfn main() -> Int = range(0, 10).fold(0, |acc: Int, i: Int| acc + double(i))\n",
  );
  let r = spawned(["run", ".", "--json"]);
  let report = json_of(r);
  assert(at(report, "value") == Str("90"), Some(json_text(report)));
  assert(r.code == 0, Some(json_text(report)))
}

test/nondet "a test run compiles only the functions its tests call, not other functions in the program" {
  let fragment = |extra: String| {
    write_program(
      "fn used() -> Int = 1\n" ++ extra ++ "test \"used is one\" {\n  assert_eq(used(), 1)\n}\n",
    );
    backend_count(json_of(spawned(["test", ".", "--no-cache", "--json"])), "fragment")
  };
  let alone = fragment("");
  assert(alone > 0, Some("the run's unit is entered at nothing"));
  assert_eq(fragment("fn spare() -> Int = 2\nfn other(x: Int) -> Int = x + spare()\n"), alone)
}

test/nondet "a test run whose filter matches no tests compiles nothing and reports no diagnostics" {
  write_program(every_kind());
  assert(
    backend_count(test_report(), "fragment") > 0,
    Some("the control did not compile a fragment, so the next assertion proves nothing"),
  );
  let report = json_of(spawned(["test", ".", "--filter", "nothing-matches-this", "--json"]));
  assert(bool(at(report, "ok")), Some(json_text(report)));
  assert(
    backend_count(report, "fragment") == 0,
    Some(
      "a run that selected no test compiled a fragment anyway: "
        ++ json_text(at(report, "backend")),
    ),
  );
  assert(
    at(report, "diagnostics") == Array([]),
    Some(
      "a run that built no backend reported a disagreement about which engine it was: "
        ++ json_text(report),
    ),
  )
}

fn two_labels() -> String = String::of_bytes_lossy(embed("../programs/backend/two_labels.ply"))

test/nondet "a function generic over an effect label, such as `net.send[l]`, runs correctly on the C backend" {
  write_program(two_labels());
  let r = spawned(["run", ".", "--json"]);
  let ran = json_of(r);
  assert(at(ran, "value") == Str("19"), Some(json_text(ran)));
  assert(r.code == 0, Some(json_text(ran)));
  let report = test_report();
  assert(bool(at(report, "ok")), Some(json_text(report)));
  assert(
    backend_count(report, "entered") > 0,
    Some("the label-generic body never reached the seam: " ++ json_text(at(report, "backend"))),
  )
}

fn emitted_results(ran: RunResult) -> Int / {abort.raise} =
  match ran.err.filter(|line: String| line.starts_with("phases: emitter ")) {
    [line] -> match line.split(", ") {
      [_, retained, requested, ..] -> leading_number(retained) + leading_number(requested),
      _ -> panic("the emitter's line reads otherwise: " ++ line),
    },
    _ -> panic("one emission is reported: " ++ stderr(ran)),
  }

fn leading_number(words: String) -> Int / {abort.raise} =
  match words.split(" ").at_or(0, "").int_of_string() {
    Some(n) -> n,
    None -> panic("no count opens `" ++ words ++ "`"),
  }

test/nondet "a run emits what its entry reaches, however much else the program defines" {
  let results = |program: String| {
    write_program(program);
    let ran = spawned(["run", "."], [environment_variable("PLY_C_PHASES", "1")]);
    assert_ok(ran);
    emitted_results(ran)
  };
  let reached = String::of_bytes_lossy(embed("../programs/backend/reached.ply"));
  assert_eq(
    results(
      reached ++ "\nfn unreached(x: Int) -> Int = x * 2\n\npub fn wider() -> Int = unreached(2)\n",
    ),
    results(reached),
  )
}

test/nondet "the C backend runs every test body, and a failing test still fails" {
  write_program(
    \\fn double(x: Int) -> Int = x * 2
    \\
    \\test "doubles" { assert_eq(double(21), 42) }
    \\
    \\test "wrong" { assert_eq(double(21), 41) }
    \\
  );
  let report = test_report();
  assert(int(path(report, ["summary", "failed"])) == 1, Some(json_text(report)));
  assert(
    backend_count(report, "entered") == 2,
    Some(
      "both bodies are entered, and the failing one raises: " ++ json_text(at(report, "backend")),
    ),
  )
}
