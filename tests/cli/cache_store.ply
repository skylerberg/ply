//! `ply cache`, and a store a run could not read: what the commands report and change, and that a
//! damaged file costs a run what it held and never the run.

import harness (Here, Spawned, spawned, scratch, program, project, write, read, on_disk, said,
                stdout, stderr, json_of, at, path, nth, items, str, int, truth, shown, Reached,
                Shipped, is_number)
import std.bytes
import std.fs (fs, listed_names, File)
import std.json
import std.json (Json, Null, Number)
import std.string
import std.list

fn green() -> String =
  \\fn double(x: Int) -> Int = x * 2
  \\
  \\fn main() -> Int = double(21)
  \\
  \\test "double doubles" { assert_eq(double(4), 8) }
  \\
  \\test "double of zero is zero" { assert_eq(double(0), 0) }
  \\

fn stats() -> Json / {Reached, Shipped, abort.raise, diverges} =
  json_of(on_disk(["cache", "stats", "--json"]))

fn inspected(what: String) -> Json / {Reached, Shipped, abort.raise, diverges} =
  json_of(on_disk(["cache", "inspect", what, "--json"]))

fn codes_of(warnings: Json) -> List<String> = items(warnings).map(|w: Json| str(at(w, "code")))

/// `green` tested once, so the store holds what a run files.
fn tested_once() -> Unit / {Spawned, Here, abort.raise} = {
  program(green());
  let r = spawned(["test"]);
  assert(r.code == 0, Some(said(r)))
}

test/nondet "cache stats counts what a run recorded" {
  program(green());
  let empty = stdout(on_disk(["cache", "stats"]));
  assert(empty.contains("0 cached results"), Some(empty));
  assert(spawned(["test"]).code == 0, None);
  let v = stats();
  assert(str(at(v, "command")) == "cache", Some(shown(v)));
  assert(str(at(v, "action")) == "stats", Some(shown(v)));
  // Two tests plus the definition each vouched for.
  assert(int(at(v, "entries")) >= 2, Some(shown(v)));
  assert(is_number(at(v, "format")), Some(shown(v)))
}

test/nondet "cache clear makes the next run re-prove everything" {
  tested_once();
  assert(stdout(spawned(["test"])).contains("selected 0 of 2"), None);
  let r = on_disk(["cache", "clear"]);
  assert(r.code == 0, Some(said(r)));
  assert(stdout(r).contains("cleared"), Some(stdout(r)));
  let text = stdout(spawned(["test"]));
  assert(text.contains("selected 2 of 2 (0 cached)"), Some(text))
}

/// The files of the store here whose names start with `prefix`: its manifest, or its segments.
fn store_files(prefix: String) -> List<String> / {fs.read[cwd], abort.raise} =
  List::filter(
    match listed_names(fs.list_dir[cwd](".ply-cache")) { Some(names) -> names, None -> [] },
    |name: String| name.starts_with(prefix),
  ).map(|name: String| ".ply-cache/" ++ name)

/// The store's manifest here written over with `text`.
fn manifest_as(text: String) -> Unit / {fs.read[cwd], fs.write[cwd], abort.raise} =
  match store_files("manifest-") {
    [file, ..] -> write(file, text),
    [] -> panic("the run filed no store"),
  }

test/nondet "a corrupt cache degrades to an empty one rather than crashing" {
  tested_once();
  manifest_as("{ truncated");
  let r = spawned(["test"]);
  assert(r.code == 0, Some(said(r)));
  assert(stdout(r).contains("selected 2 of 2 (0 cached)"), Some(stdout(r)));
  assert(stdout(r).contains("warning"), Some("the degradation must be reported:\n" ++ stdout(r)))
}

/// Every segment of the store mangled past its header: what a disk that lost a write leaves.
fn mangle_the_store() -> Unit / {fs.read[cwd], fs.write[cwd], abort.raise} = {
  let segments = store_files("seg-");
  if segments.len() == 0 { panic("the run filed no store") };
  segments.fold((), |_: Unit, file: String|
    match fs.read_file[cwd](file) {
      None -> panic("a segment of the store does not read"),
      Some(b) -> if b.len() > 64 {
        let mangled = b.slice(0, 64).concat(b.slice(64, b.len()).xor_byte(0x5a));
        if !fs.write_file[cwd](file, mangled) { panic("could not mangle the store") }
      },
    })
}

// Damage is said in the text and in the document, and the run goes on as if nothing was kept.
test/nondet "a damaged store is reported and the run goes on" {
  tested_once();
  mangle_the_store();
  write("m.ply", green().replace("x * 2", "x * 3"));
  let r = spawned(["test"]);
  assert(r.code == 1, Some("the edit has to fail a test: " ++ said(r)));
  assert(stdout(r).contains("corrupt"), Some("the damage must be named:\n" ++ stdout(r)));
  mangle_the_store();
  let v = json_of(spawned(["test", "--json"]));
  assert(
    codes_of(at(v, "warnings")).contains("W0602"),
    Some("the machine artifact carries the same warning: " ++ shown(at(v, "warnings"))),
  )
}

test/nondet "cache stats reports open time, the store's files and the memo store" {
  tested_once();
  let text = stdout(on_disk(["cache", "stats"]));
  assert(text.contains("opened in"), Some("the open cost is the claim:\n" ++ text));
  assert(text.contains("segment"), Some("the store's files must be sized:\n" ++ text));
  assert(text.contains("memo"), Some(text));
  assert(text.contains("reclaimable"), Some(text));
  let v = stats();
  assert(is_number(at(v, "open_ms")), Some(shown(v)));
  assert(int(path(v, ["store", "segments"])) > 0, Some(shown(v)));
  assert(is_number(path(v, ["store", "data_bytes"])), Some(shown(v)));
  assert(int(path(v, ["memo", "records"])) >= 1, Some(shown(v)));
  assert(int(path(v, ["memo", "segments"])) >= 1, Some(shown(v)));
  assert(int(path(v, ["memo", "bytes"])) > 0, Some(shown(v)));
  assert(is_number(path(v, ["memo", "answers"])), Some(shown(v)));
  // A passing run files the text of each definition it reached.
  assert(int(path(v, ["history", "texts"])) > 0, Some(shown(v)));
  assert(path(v, ["store", "compact_suggested"]) == json::Bool(false), Some(shown(v)))
}

test/nondet "cache compact keeps every result and every record the queries of this `ply` read" {
  project([{ path: "m.ply", text: green() }, { path: "gone.ply", text: "fn gone() -> Int = 9\n" }]);
  assert(spawned(["test"]).code == 0, None);
  let records = int(path(stats(), ["memo", "records"]));
  assert(fs.remove[cwd]("gone.ply"), None);
  let r = on_disk(["cache", "compact"]);
  assert(r.code == 0, Some(said(r)));
  assert(stdout(r).contains("compacted"), Some(stdout(r)));
  let v = stats();
  assert(int(path(v, ["memo", "records"])) == records, Some(shown(v)));
  assert(int(at(v, "entries")) >= 2, Some(shown(v)));
  let text = stdout(spawned(["test"]));
  assert(
    text.contains("selected 0 of 2 (2 cached)"),
    Some("compaction must not cost a test:\n" ++ text),
  )
}

test/nondet "cache compact leaves the memo store one segment, and nothing of a layout no run reads" {
  tested_once();
  assert(fs.create_dir[cwd](".ply-cache/memo/records"), None);
  assert(fs.write_file[cwd](".ply-cache/memo/records/stray", b"a record as a file"), None);
  let r = on_disk(["cache", "compact"]);
  assert(r.code == 0, Some(said(r)));
  let names = match listed_names(fs.list_dir[cwd](".ply-cache/memo")) {
    Some(names) -> names,
    None -> [],
  };
  assert_eq(names.filter(|name: String| name.starts_with("seg-")).len(), 1);
  assert(!names.contains("records"), Some("records as files are no part of the store"));
  let v = stats();
  assert(int(path(v, ["memo", "segments"])) == 1, Some(shown(v)));
  let text = stdout(spawned(["test"]));
  assert(
    text.contains("selected 0 of 2 (2 cached)"),
    Some("compaction must not cost a test:\n" ++ text),
  )
}

test/nondet "cache compact --json is one object" {
  tested_once();
  let v = json_of(on_disk(["cache", "compact", "--json"]));
  assert(str(at(v, "command")) == "cache", Some(shown(v)));
  assert(str(at(v, "action")) == "compact", Some(shown(v)));
  assert(truth(at(v, "ok")), Some(shown(v)));
  assert(int(at(v, "exit_code")) == 0, Some(shown(v)));
  assert(is_number(path(v, ["dropped", "texts"])), Some(shown(v)));
  assert(is_number(path(v, ["dropped", "records"])), Some(shown(v)));
  assert(is_number(at(v, "bytes_before")), Some(shown(v)));
  assert(is_number(at(v, "reclaimed_bytes")), Some(shown(v)))
}

test "cache inspect prints a resolved type rather than a serialization" {
  scratch(|| {
    program(
      "effect db {\n  read all[t]() -> List<Int>\n}\nfn active(n: Int) -> List<Int> / {db.read[users]} = db.all[users]()\n",
    );
    assert(on_disk(["check"]).code == 0, None);
    let r = on_disk(["cache", "inspect", "active"]);
    assert(r.code == 0, Some(said(r)));
    let text = stdout(r);
    assert(text.contains("m.active"), Some(text));
    assert(
      text.contains("(Int) -> List<Int> / {m.db.read[users]}"),
      Some("the type must read as a signature, not as JSON:\n" ++ text),
    );
    assert(text.contains("footprint  {m.db.read[users]}"), Some(text));
    assert(text.contains("m.ply:4:"), Some("the declaring position must be shown:\n" ++ text));
    assert(text.contains("effects"), Some(text));
    assert(text.contains("body"), Some(text));
    assert(text.contains("result"), Some(text))
  })
}

test "cache inspect accepts a hash prefix and emits json" {
  scratch(|| {
    program(green());
    assert(on_disk(["check"]).code == 0, None);
    let v = inspected("double");
    assert(str(at(v, "command")) == "cache", Some(shown(v)));
    assert(str(at(v, "action")) == "inspect", Some(shown(v)));
    assert(items(at(v, "matches")).len() == 1, Some(shown(v)));
    let found = nth(at(v, "matches"), 0);
    assert(str(at(found, "name")) == "m.double", Some(shown(found)));
    assert(str(at(found, "kind")) == "fn", Some(shown(found)));
    assert(str(at(found, "file")) == "m.ply", Some(shown(found)));
    assert(str(path(found, ["interface", "type"])) == "(Int) -> Int", Some(shown(found)));
    let by_prefix = inspected(str(at(found, "hash")).slice(0, 6));
    assert(str(at(nth(at(by_prefix, "matches"), 0), "name")) == "m.double", Some(shown(by_prefix)));
    // What a load answers is of the text as it stands: an edit's hash, at its place.
    write("m.ply", green().replace("x * 2", "x + 2"));
    let edited = nth(at(inspected("double"), "matches"), 0);
    assert(str(at(edited, "hash")) != str(at(found, "hash")), Some(shown(edited)));
    assert(str(at(edited, "location")).starts_with("m.ply:1:"), Some(shown(edited)))
  })
}

test "cache inspect of an unknown name is E0101 and exits two" {
  scratch(|| {
    program(green());
    assert(on_disk(["check"]).code == 0, None);
    let r = on_disk(["cache", "inspect", "no_such_thing"]);
    assert(r.code == 2, Some(said(r)));
    assert(stderr(r).contains("E0101"), Some(stderr(r)));
    let j = on_disk(["cache", "inspect", "no_such_thing", "--json"]);
    assert(j.code == 2, Some(said(j)));
    let v = json_of(j);
    assert(at(v, "ok") == json::Bool(false), Some(shown(v)));
    assert(str(at(nth(at(v, "diagnostics"), 0), "code")) == "E0101", Some(shown(v)))
  })
}

test/nondet "cache inspect reports a test and whether it is proven" {
  program(green());
  assert(on_disk(["check"]).code == 0, None);
  let before = nth(at(inspected("double doubles"), "matches"), 0);
  assert(str(at(before, "kind")) == "test", Some(shown(before)));
  assert(str(at(before, "result")).contains("not proven"), Some(shown(before)));
  assert(spawned(["test"]).code == 0, None);
  let after = nth(at(inspected("double doubles"), "matches"), 0);
  assert(str(at(after, "result")).contains("passed"), Some(shown(after)));
  assert(path(after, ["interface", "nondet"]) == json::Bool(false), Some(shown(after)))
}

test/nondet "cache stats reports a discarded store too" {
  tested_once();
  manifest_as("PLYSEGS1 not really a manifest");
  let v = stats();
  assert(codes_of(at(v, "warnings")).contains("W0602"), Some(shown(at(v, "warnings"))))
}

// One unreadable file is found by more than one read: a lazy consult and a flush that re-reads to
// merge.
test/nondet "an unreadable cache file is reported once, not once per read" {
  tested_once();
  let names = match listed_names(fs.list_dir[cwd](".ply-cache")) {
    Some(ns) -> ns,
    None -> panic("the run left no cache"),
  };
  names.fold((), |u: Unit, name: String| {
    let file = ".ply-cache/" ++ name;
    if fs.kind[cwd](file) == File { write(file, "garbage") }
  });
  let r = spawned(["test", "--json"]);
  let messages = items(at(json_of(r), "warnings")).map(|w: Json| str(at(w, "message")));
  let listed = String::join(messages, "\n");
  assert(
    messages.filter(|m: String| m.contains("the store is unreadable")).len() == 1,
    Some(listed),
  );
  assert(
    messages.filter(|m: String| messages.filter(|n: String| n == m).len() > 1).len() == 0,
    Some("a warning was repeated:\n" ++ listed),
  );
  assert(r.code == 0, Some(said(r)))
}
