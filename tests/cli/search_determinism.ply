import spawning.harness (write_program, spawned, json_of, at, path, items, first, str, int,
                         json_text, PlyProcess)
import std.json
import std.json (Json, Object, Array, Str)
import std.string
import std.list

fn mixed_program() -> String =
  \\effect counter {
  \\  read  get[r]() -> Int
  \\  write put[r](v: Int) -> Unit
  \\}
  \\
  \\fn bump() -> Unit / {counter.read[n], counter.write[n], clock.read} = {
  \\  let seen = counter.get[n]();
  \\  clock.now();
  \\  counter.put[n](seen + 1)
  \\}
  \\
  \\test "two increments race" {
  \\  handle {
  \\    simulate {
  \\      let a = task.spawn(|| bump());
  \\      let b = task.spawn(|| bump());
  \\      task.join(a);
  \\      task.join(b);
  \\      assert_eq(counter.get[n](), 2)
  \\    }
  \\  } with {
  \\    var c = 0,
  \\    counter.get[n]() -> c,
  \\    counter.put[n](v) -> {
  \\      c = v;
  \\    },
  \\  }
  \\}
  \\
  \\test "two increments land in some order" {
  \\  handle {
  \\    simulate {
  \\      let a = task.spawn(|| bump());
  \\      let b = task.spawn(|| bump());
  \\      task.join(a);
  \\      task.join(b);
  \\      assert(counter.get[n]() >= 1)
  \\    }
  \\  } with {
  \\    var c = 0,
  \\    counter.get[n]() -> c,
  \\    counter.put[n](v) -> {
  \\      c = v;
  \\    },
  \\  }
  \\}
  \\
  \\test "a sleeper costs no wall clock" {
  \\  simulate {
  \\    let t = task.spawn(|| { clock.sleep(Duration(30000000000)); clock.now() });
  \\    assert_eq(task.join(t), Instant(30000000000))
  \\  }
  \\}
  \\
  \\test "the arithmetic is not concurrent" { assert_eq(1 + 1, 2) }
  \\

fn scrub(value: Json) -> Json =
  match value {
    Object(fields) ->
      Object(
        fields.fold(Map::new(), |accumulator: Map<String, Json>, k: String, v: Json|
          if k.contains("duration") || k.ends_with("_ms") || k.ends_with("_nanos")
              || k == "front_end"
              || k == "phases"
              || k == "workers"
              || k == "units"
              || k == "elapsed" { accumulator }
          else { accumulator.insert(k, scrub(v)) }),
      ),
    Array(xs) -> Array(xs.map(scrub)),
    other -> other,
  }

fn without_positions(value: Json) -> Json =
  match value {
    Object(fields) ->
      Object(
        fields.fold(Map::new(), |accumulator: Map<String, Json>, k: String, v: Json|
          if ["start", "end", "line", "end_line", "column", "end_column"].contains(k) {
            accumulator
          } else { accumulator.insert(k, without_positions(v)) }),
      ),
    Array(xs) -> Array(xs.map(without_positions)),
    other -> other,
  }

fn difference(a: Json, b: Json, at_path: String) -> Option<String> / {abort.raise} =
  if a == b { None } else {
    let plainly = Some(at_path ++ ": " ++ json_text(a) ++ " against " ++ json_text(b));
    match a {
      Object(x) -> match b {
        Object(y) -> {
          let inner = x.fold(None, |found: Option<String>, k: String, v: Json|
            match found {
              Some(_) -> found,
              None ->
                difference(
                  v,
                  match y.get(k) { Some(w) -> w, None -> json::Null },
                  at_path ++ "." ++ k,
                ),
            });
          match inner { Some(d) -> Some(d), None -> Some(at_path ++ ": a key only the second has") }
        },
        _ -> plainly,
      },
      Array(xs) -> match b {
        Array(ys) -> if xs.len() != ys.len() { plainly } else {
          xs.fold({ i: 0, found: None }, |s: { i: Int, found: Option<String> }, v: Json|
            {
              i: s.i + 1,
              found: match s.found {
                Some(_) -> s.found,
                None ->
                  difference(
                    v,
                    match ys.at(s.i) { Some(w) -> w, None -> json::Null },
                    at_path ++ "[" ++ s.i.to_string() ++ "]",
                  ),
              },
            }).found
        },
        _ -> plainly,
      },
      _ -> plainly,
    }
  }

fn agree(a: Json, b: Json, what: String) -> Unit / {abort.raise} =
  match difference(a, b, "") { None -> (), Some(d) -> panic(what ++ ": " ++ d) }

fn argv_of(args: List<String>) -> List<String> = ["test", ".", "--json", "--no-cache"].concat(args)

fn scrubbed_report(args: List<String>) -> Json / {PlyProcess, abort.raise} =
  scrub(json_of(spawned(argv_of(args))))

fn result_for(a: Json, key: String) -> Json / {abort.raise} =
  match items(at(a, "results")).filter(|r: Json| str(at(r, "key")).ends_with(key)) {
    [r, ..] -> r,
    [] -> panic("no result for `" ++ key ++ "` in " ++ json_text(a)),
  }

fn is_text(j: Json) -> Bool = match j { Str(_) -> true, _ -> false }

test/nondet "the same `--seed` produces an identical report in separate processes" {
  write_program(mixed_program());
  let once = scrubbed_report(["--seed", "0"]);
  range(1, 8).fold((), |u: Unit, run: Int|
    agree(
      scrubbed_report(["--seed", "0"]),
      once,
      "process " ++ run.to_string() ++ " produced a different artifact for one seed",
    ))
}

test/nondet "a full search with no seed produces an identical report in separate processes" {
  write_program(mixed_program());
  let once = scrubbed_report([]);
  range(1, 6).fold((), |u: Unit, run: Int|
    agree(scrubbed_report([]), once, "process " ++ run.to_string() ++ " searched differently"));
  assert(
    items(at(once, "failures")).filter(|f: Json|
        is_text(at(f, "seed")) && str(path(f, ["diagnostic", "code"])) == "E0501").len(
      )
      > 0,
    Some(
      "the program must produce a seeded failure, or these comparisons prove nothing: "
        ++ json_text(once),
    ),
  )
}

test/nondet "the number of `--jobs` does not change which interleavings the search chooses" {
  write_program(mixed_program());
  let one = scrubbed_report(["--jobs", "1"]);
  ["2", "3", "8", "17"].fold((), |u: Unit, jobs: String|
    agree(
      scrubbed_report(["--jobs", jobs]),
      one,
      "`--jobs " ++ jobs ++ "` disagreed with `--jobs 1`",
    ))
}

test/nondet "a test run alone with `--filter` reports the same result as in a full run" {
  write_program(mixed_program());
  let whole = scrubbed_report([]);
  [
    "two increments race",
    "two increments land in some order",
    "a sleeper costs no wall clock",
  ].fold((), |u: Unit, name: String|
    assert(
      result_for(scrubbed_report(["--filter", name]), name) == result_for(whole, name),
      Some("`" ++ name ++ "` reported differently when run alone"),
    ))
}

test/nondet "a warm front-end cache does not change an interleaving" {
  write_program(mixed_program());
  let cold = scrubbed_report([]);
  let _ = spawned(["test", ".", "--json"], []);
  agree(scrubbed_report([]), cold, "a warm front-end cache changed what the search did")
}

test/nondet "an edit that changes no hash changes no interleaving" {
  write_program(mixed_program());
  let plain = scrubbed_report([]);
  let edited = [
    { from: "let seen =", to: "// a comment nobody reads\n  let observed =" },
    { from: "seen + 1", to: "observed + 1" },
    { from: "let a = task.spawn", to: "let first  =  task.spawn" },
    { from: "let b = task.spawn", to: "let second = task.spawn" },
    { from: "task.join(a)", to: "task.join(first)" },
    { from: "task.join(b)", to: "task.join(second)" },
  ].fold(mixed_program(), |text: String, e: { from: String, to: String }|
    text.replace(e.from, e.to));
  assert(
    edited != mixed_program(),
    Some("the edit moved nothing, so this compares a program with itself"),
  );
  write_program(edited);
  agree(
    without_positions(scrubbed_report([])),
    without_positions(plain),
    "renaming locals and adding a comment moved the search",
  )
}

test/nondet "the seed a failure prints replays that failure" {
  write_program(mixed_program());
  let searched = scrubbed_report([]);
  let failure = match items(at(searched, "failures")).filter(|f: Json| is_text(at(f, "seed"))) {
    [f, ..] -> f,
    [] -> panic("the racy test must fail with a seed: " ++ json_text(searched)),
  };
  assert(
    str(path(failure, ["diagnostic", "code"])) == "E0501",
    Some("the race's own assertion is what the seed names: " ++ json_text(failure)),
  );
  let seed = str(at(failure, "seed"));
  let replayed = scrubbed_report(["--seed", seed]);
  let again = match items(at(replayed, "failures")).filter(|f: Json| str(at(f, "seed")) == seed) {
    [f, ..] -> f,
    [] -> panic("seed " ++ seed ++ " did not reproduce the failure: " ++ json_text(replayed)),
  };
  assert(
    path(again, ["diagnostic", "message"]) == path(failure, ["diagnostic", "message"]),
    Some("seed " ++ seed ++ " reproduced a different failure"),
  );
  range(0, 2).fold((), |u: Unit, i: Int|
    agree(scrubbed_report(["--seed", seed]), replayed, "a replay"))
}

test/nondet "a seed actually decides which interleaving runs" {
  write_program(mixed_program());
  let verdicts = range(0, 24).fold([], |accumulator: List<String>, root: Int| {
    let status = str(
      at(
        result_for(scrubbed_report(["--seed", root.to_string()]), "two increments race"),
        "status",
      ),
    );
    if accumulator.filter(|v: String| v == status).len() > 0 { accumulator }
    else { accumulator.push(status) }
  });
  assert(
    verdicts.len() > 1,
    Some(
      "24 seeds gave one verdict on a racy test, so the seed decides nothing: "
        ++ String::join(verdicts, ", "),
    ),
  )
}

fn variable_race(name: String) -> String =
  "test \"" ++ name
    ++ "\" {\n  handle {\n    simulate {\n      let a = task.spawn(|| bump());\n      let b = task.spawn(|| bump());\n      task.join(a);\n      task.join(b);\n      assert_eq(counter.get[n](), 2)\n    }\n  } with {\n    var c = 0,\n    counter.get[n]() -> c,\n    counter.put[n](v) -> {\n      c = v;\n    },\n  }\n}\n"

test/nondet "with one thread, three identical data races on a variable each report the same variable name and accesses" {
  write_program(
    counter_effect()
      ++ String::join(
        range(0, 3).map(|i: Int| variable_race("a lost update on a variable " ++ i.to_string())),
        "",
      ),
  );
  let run = scrubbed_report(["--jobs", "1"]);
  let races = items(at(run, "failures")).map(|f: Json| at(f, "race"));
  assert(races.len() == 3, Some("each copy reaches the lost update: " ++ json_text(run)));
  let named = |r: Json|
    [
      at(r, "at"),
      path(r, ["left", "task"]),
      path(r, ["left", "access"]),
      path(r, ["right", "task"]),
      path(r, ["right", "access"]),
    ];
  races.fold((), |u: Unit, race: Json| {
    ["left", "right"].fold(u, |v: Unit, side: String| {
      let access = str(path(race, [side, "access"]));
      assert(
        access.contains(".counter.") && access.ends_with("[n]"),
        Some("the counter the two tasks race on: " ++ json_text(race)),
      )
    });
    assert(
      named(race) == named(first(races)),
      Some("a later search on the thread named the race differently"),
    )
  })
}

fn counter_effect() -> String =
  \\effect counter {
  \\  read  get[r]() -> Int
  \\  write put[r](v: Int) -> Unit
  \\}
  \\
  \\fn bump() -> Unit / {counter.read[n], counter.write[n], clock.read} = {
  \\  let seen = counter.get[n]();
  \\  clock.now();
  \\  counter.put[n](seen + 1)
  \\}
  \\

fn two_simulations() -> String =
  counter_effect()
    ++
    \\
    \\test "a race in the first simulation and a quiet second one" {
    \\  handle {
    \\    {
    \\      simulate {
    \\        let a = task.spawn(|| bump());
    \\        let b = task.spawn(|| bump());
    \\        task.join(a);
    \\        task.join(b)
    \\      };
    \\      simulate {
    \\        clock.now();
    \\        ()
    \\      };
    \\      assert_eq(counter.get[n](), 2)
    \\    }
    \\  } with {
    \\    var c = 0,
    \\    counter.get[n]() -> c,
    \\    counter.put[n](v) -> {
    \\      c = v;
    \\    },
    \\  }
    \\}
    \\

fn simulation_in_a_helper() -> String =
  counter_effect()
    ++
    \\
    \\fn race() -> Unit / {counter.read[n], counter.write[n], sim.read, abort.raise} = simulate {
    \\  let a = task.spawn(|| bump());
    \\  let b = task.spawn(|| bump());
    \\  task.join(a);
    \\  task.join(b)
    \\}
    \\
    \\test "the same simulation twice through a call" {
    \\  handle {
    \\    {
    \\      race();
    \\      race();
    \\      assert_eq(counter.get[n](), 4)
    \\    }
    \\  } with {
    \\    var c = 0,
    \\    counter.get[n]() -> c,
    \\    counter.put[n](v) -> {
    \\      c = v;
    \\    },
    \\  }
    \\}
    \\

fn assert_lost_update(run: Json, total: Int, what: String) -> Unit / {abort.raise} = {
  let failure = match items(at(run, "failures")) {
    [f, ..] -> f,
    [] -> panic(what ++ ": no interleaving failed: " ++ json_text(run)),
  };
  assert(
    str(path(failure, ["diagnostic", "code"])) == "E0501",
    Some(what ++ ": " ++ json_text(failure)),
  );
  let message = str(path(failure, ["diagnostic", "message"]));
  let lost = "assertion failed: expected " ++ total.to_string() ++ ", found ";
  assert(
    message.starts_with(lost) && message != lost ++ total.to_string(),
    Some(what ++ ": " ++ message),
  );
  assert(
    is_text(at(failure, "seed")),
    Some(what ++ ": a lost update names its seed: " ++ json_text(failure)),
  )
}

test/nondet "a second simulation does not hide the first simulation's race" {
  [
    { source: two_simulations(), name: "two simulations written out", total: 2 },
    {
      source: simulation_in_a_helper(),
      name: "one simulation reached twice through a call",
      total: 4,
    },
  ].fold((), |u: Unit, c: { source: String, name: String, total: Int }| {
    write_program(c.source);
    assert_lost_update(
      scrubbed_report(["--sim", "random", "--seeds", "64"]),
      c.total,
      "`" ++ c.name ++ "`: the fixture must contain a reachable lost update, or it proves nothing",
    );
    assert_lost_update(
      scrubbed_report(["--sim-budget", "1024"]),
      c.total,
      "`" ++ c.name ++ "`: the search",
    )
  })
}

fn racy_counter_program() -> String =
  \\effect counter {
  \\  read  get[r]() -> Int
  \\  write put[r](v: Int) -> Unit
  \\  write note[r](v: Int) -> Unit
  \\  read  noted[r]() -> Int
  \\}
  \\
  \\fn bump() -> Unit / {counter.get[n], counter.put[n], clock.now} = {
  \\  let seen = counter.get[n]();
  \\  clock.now();
  \\  counter.put[n](seen + 1)
  \\}
  \\
  \\fn noise() -> Unit / {counter.get[n], counter.note[m], clock.now} = {
  \\  let seen = counter.get[n]();
  \\  clock.now();
  \\  counter.note[m](seen)
  \\}
  \\
  \\test "the second simulation's shape depends on what the first raced to" {
  \\  handle {
  \\    {
  \\        simulate {
  \\          let a = task.spawn(|| bump());
  \\          let b = task.spawn(|| bump());
  \\          task.join(a);
  \\          task.join(b)
  \\        };
  \\        simulate {
  \\          if counter.get[n]() == 2 {
  \\            let a = task.spawn(|| noise());
  \\            let b = task.spawn(|| noise());
  \\            task.join(a);
  \\            task.join(b)
  \\          } else {
  \\            let a = task.spawn(|| noise());
  \\            task.join(a)
  \\          }
  \\        };
  \\        assert(counter.noted[m]() >= 0)
  \\      }
  \\  } with {
  \\    var c = 0,
  \\    var d = 0,
  \\    counter.get[n]() -> c,
  \\    counter.put[n](v) -> {
  \\      c = v;
  \\    },
  \\    counter.note[m](v) -> {
  \\      d = v;
  \\    },
  \\    counter.noted[m]() -> d,
  \\  }
  \\}
  \\

test/nondet "a legal program is never reported as a simulation divergence" {
  write_program(racy_counter_program());
  let run = scrubbed_report([]);
  match items(at(run, "failures")) {
    [failure, ..] -> {
      assert(
        str(path(failure, ["diagnostic", "code"])) != "E0415",
        Some("a legal program was blamed on Ply's simulation: " ++ json_text(failure)),
      );
      panic("its assertion holds in every interleaving, and a run failed: " ++ json_text(failure))
    },
    [] -> (),
  };
  assert(
    int(path(first(items(at(run, "results"))), ["simulation", "explored"])) > 1,
    Some(json_text(run)),
  )
}
