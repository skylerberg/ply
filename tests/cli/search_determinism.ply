import harness (spawned, PlyProcess)
import support.harness (write_program, json_of, at, path, items, first, str, json_text)
import std.json
import std.json (Json, Object, Array, Str)
import std.string
import std.list

fn mixed_program() -> String =
  \\effect counter {
  \\  read  get[r]() -> Int
  \\  write put[r](v: Int) -> Unit
  \\}
  \\
  \\fn bump() -> Unit / {counter.read[n], counter.write[n], clock.read} = {
  \\  let seen = counter.get[n]();
  \\  clock.now();
  \\  counter.put[n](seen + 1)
  \\}
  \\
  \\test "two increments race" {
  \\  handle {
  \\    simulate {
  \\      let a = task.spawn(|| bump());
  \\      let b = task.spawn(|| bump());
  \\      task.join(a);
  \\      task.join(b);
  \\      assert_eq(counter.get[n](), 2)
  \\    }
  \\  } with {
  \\    var c = 0,
  \\    counter.get[n]() -> c,
  \\    counter.put[n](v) -> {
  \\      c = v;
  \\    },
  \\  }
  \\}
  \\
  \\test "two increments land in some order" {
  \\  handle {
  \\    simulate {
  \\      let a = task.spawn(|| bump());
  \\      let b = task.spawn(|| bump());
  \\      task.join(a);
  \\      task.join(b);
  \\      assert(counter.get[n]() >= 1)
  \\    }
  \\  } with {
  \\    var c = 0,
  \\    counter.get[n]() -> c,
  \\    counter.put[n](v) -> {
  \\      c = v;
  \\    },
  \\  }
  \\}
  \\
  \\test "a sleeper costs no wall clock" {
  \\  simulate {
  \\    let t = task.spawn(|| { clock.sleep(Duration(30000000000)); clock.now() });
  \\    assert_eq(task.join(t), Instant(30000000000))
  \\  }
  \\}
  \\
  \\test "the arithmetic is not concurrent" { assert_eq(1 + 1, 2) }
  \\

fn scrub(value: Json) -> Json =
  match value {
    Object(fields) ->
      Object(
        fields.fold(Map::new(), |accumulator: Map<String, Json>, k: String, v: Json|
          if k.contains("duration") || k.ends_with("_ms") || k.ends_with("_nanos")
              || k == "front_end"
              || k == "phases"
              || k == "workers"
              || k == "units"
              || k == "elapsed" { accumulator }
          else { accumulator.insert(k, scrub(v)) }),
      ),
    Array(xs) -> Array(xs.map(scrub)),
    other -> other,
  }

fn without_positions(value: Json) -> Json =
  match value {
    Object(fields) ->
      Object(
        fields.fold(Map::new(), |accumulator: Map<String, Json>, k: String, v: Json|
          if ["start", "end", "line", "end_line", "column", "end_column"].contains(k) {
            accumulator
          } else { accumulator.insert(k, without_positions(v)) }),
      ),
    Array(xs) -> Array(xs.map(without_positions)),
    other -> other,
  }

fn difference(a: Json, b: Json, at_path: String) -> Option<String> / {abort.raise} =
  if a == b { None } else {
    let plainly = Some(at_path ++ ": " ++ json_text(a) ++ " against " ++ json_text(b));
    match a {
      Object(x) -> match b {
        Object(y) -> {
          let inner = x.fold(None, |found: Option<String>, k: String, v: Json|
            match found {
              Some(_) -> found,
              None ->
                difference(
                  v,
                  match y.get(k) { Some(w) -> w, None -> json::Null },
                  at_path ++ "." ++ k,
                ),
            });
          match inner { Some(d) -> Some(d), None -> Some(at_path ++ ": a key only the second has") }
        },
        _ -> plainly,
      },
      Array(xs) -> match b {
        Array(ys) -> if xs.len() != ys.len() { plainly } else {
          xs.fold({ i: 0, found: None }, |s: { i: Int, found: Option<String> }, v: Json|
            {
              i: s.i + 1,
              found: match s.found {
                Some(_) -> s.found,
                None ->
                  difference(
                    v,
                    match ys.at(s.i) { Some(w) -> w, None -> json::Null },
                    at_path ++ "[" ++ s.i.to_string() ++ "]",
                  ),
              },
            }).found
        },
        _ -> plainly,
      },
      _ -> plainly,
    }
  }

fn agree(a: Json, b: Json, what: String) -> Unit / {abort.raise} =
  match difference(a, b, "") { None -> (), Some(d) -> panic(what ++ ": " ++ d) }

fn argv_of(args: List<String>) -> List<String> = ["test", ".", "--json", "--no-cache"].concat(args)

fn scrubbed_report(args: List<String>) -> Json / {PlyProcess, abort.raise} =
  scrub(json_of(spawned(argv_of(args))))

fn result_for(a: Json, key: String) -> Json / {abort.raise} =
  match items(at(a, "results")).filter(|r: Json| str(at(r, "key")).ends_with(key)) {
    [r, ..] -> r,
    [] -> panic("no result for `" ++ key ++ "` in " ++ json_text(a)),
  }

fn is_text(j: Json) -> Bool = match j { Str(_) -> true, _ -> false }

test/nondet "a search is a function of its seed and its program, in every process" {
  write_program(mixed_program());
  let seeded = scrubbed_report(["--seed", "0"]);
  range(1, 3).fold((), |u: Unit, run: Int|
    agree(
      scrubbed_report(["--seed", "0"]),
      seeded,
      "process " ++ run.to_string() ++ " produced a different artifact for one seed",
    ));
  let searched = scrubbed_report([]);
  assert(
    items(at(searched, "failures")).filter(|f: Json|
        is_text(at(f, "seed")) && str(path(f, ["diagnostic", "code"])) == "E0501").len(
      )
      > 0,
    Some(
      "the program must produce a seeded failure, or these comparisons prove nothing: "
        ++ json_text(searched),
    ),
  );
  agree(scrubbed_report([]), searched, "a second process searched differently");
  ["1", "8"].fold((), |u: Unit, jobs: String|
    agree(
      scrubbed_report(["--jobs", jobs]),
      searched,
      "`--jobs " ++ jobs ++ "` disagreed with the default",
    ));
  [
    "two increments race",
    "two increments land in some order",
    "a sleeper costs no wall clock",
  ].fold((), |u: Unit, name: String|
    assert(
      result_for(scrubbed_report(["--filter", name]), name) == result_for(searched, name),
      Some("`" ++ name ++ "` reported differently when run alone"),
    ));
  let _ = spawned(["test", ".", "--json"], []);
  agree(scrubbed_report([]), searched, "a warm front-end cache changed what the search did");
  let edited = [
    { from: "let seen =", to: "// a comment nobody reads\n  let observed =" },
    { from: "seen + 1", to: "observed + 1" },
    { from: "let a = task.spawn", to: "let first  =  task.spawn" },
    { from: "let b = task.spawn", to: "let second = task.spawn" },
    { from: "task.join(a)", to: "task.join(first)" },
    { from: "task.join(b)", to: "task.join(second)" },
  ].fold(mixed_program(), |text: String, e: { from: String, to: String }|
    text.replace(e.from, e.to));
  assert(
    edited != mixed_program(),
    Some("the edit moved nothing, so this compares a program with itself"),
  );
  write_program(edited);
  agree(
    without_positions(scrubbed_report([])),
    without_positions(searched),
    "renaming locals and adding a comment moved the search",
  )
}

fn variable_race(name: String) -> String =
  "test \"" ++ name
    ++ "\" {\n  handle {\n    simulate {\n      let a = task.spawn(|| bump());\n      let b = task.spawn(|| bump());\n      task.join(a);\n      task.join(b);\n      assert_eq(counter.get[n](), 2)\n    }\n  } with {\n    var c = 0,\n    counter.get[n]() -> c,\n    counter.put[n](v) -> {\n      c = v;\n    },\n  }\n}\n"

test/nondet "with one thread, three identical data races on a variable each report the same variable name and accesses" {
  write_program(
    counter_effect()
      ++ String::join(
        range(0, 3).map(|i: Int| variable_race("a lost update on a variable " ++ i.to_string())),
        "",
      ),
  );
  let run = scrubbed_report(["--jobs", "1"]);
  let races = items(at(run, "failures")).map(|f: Json| at(f, "race"));
  assert(races.len() == 3, Some("each copy reaches the lost update: " ++ json_text(run)));
  let named = |r: Json|
    [
      at(r, "at"),
      path(r, ["left", "task"]),
      path(r, ["left", "access"]),
      path(r, ["right", "task"]),
      path(r, ["right", "access"]),
    ];
  races.fold((), |u: Unit, race: Json| {
    ["left", "right"].fold(u, |v: Unit, side: String| {
      let access = str(path(race, [side, "access"]));
      assert(
        access.contains(".counter.") && access.ends_with("[n]"),
        Some("the counter the two tasks race on: " ++ json_text(race)),
      )
    });
    assert(
      named(race) == named(first(races)),
      Some("a later search on the thread named the race differently"),
    )
  })
}

fn counter_effect() -> String =
  \\effect counter {
  \\  read  get[r]() -> Int
  \\  write put[r](v: Int) -> Unit
  \\}
  \\
  \\fn bump() -> Unit / {counter.read[n], counter.write[n], clock.read} = {
  \\  let seen = counter.get[n]();
  \\  clock.now();
  \\  counter.put[n](seen + 1)
  \\}
  \\
