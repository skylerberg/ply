//! A simulated search is a function of its seed and its program: not of the process, the worker
//! count, the company a test keeps, a warm cache, or what ran on the thread before it.

import harness (program, spawned, json_of, at, path, items, first, str, int, shown, Spawned)
import std.json
import std.json (Json, Object, Array, Str)
import std.string
import std.list

/// Failures, exhaustive searches and ordinary cached tests at once, so a difference in any of them
/// shows.
fn mixed_program() -> String =
  \\effect counter {
  \\  read  get[r]() -> Int
  \\  write put[r](v: Int) -> Unit
  \\}
  \\
  \\fn bump() -> Unit / {counter.read[n], counter.write[n], clock.read} = {
  \\  let seen = counter.get[n]();
  \\  clock.now();
  \\  counter.put[n](seen + 1)
  \\}
  \\
  \\test "two increments race" {
  \\  handle {
  \\    simulate {
  \\      let a = task.spawn(|| bump());
  \\      let b = task.spawn(|| bump());
  \\      task.join(a);
  \\      task.join(b);
  \\      assert_eq(counter.get[n](), 2)
  \\    }
  \\  } with {
  \\    var c = 0,
  \\    counter.get[n]() -> c,
  \\    counter.put[n](v) -> {
  \\      c = v;
  \\    },
  \\  }
  \\}
  \\
  \\test "two increments land in some order" {
  \\  handle {
  \\    simulate {
  \\      let a = task.spawn(|| bump());
  \\      let b = task.spawn(|| bump());
  \\      task.join(a);
  \\      task.join(b);
  \\      assert(counter.get[n]() >= 1)
  \\    }
  \\  } with {
  \\    var c = 0,
  \\    counter.get[n]() -> c,
  \\    counter.put[n](v) -> {
  \\      c = v;
  \\    },
  \\  }
  \\}
  \\
  \\test "a sleeper costs no wall clock" {
  \\  simulate {
  \\    let t = task.spawn(|| { clock.sleep(Duration(30000000000)); clock.now() });
  \\    assert_eq(task.join(t), Instant(30000000000))
  \\  }
  \\}
  \\
  \\test "the arithmetic is not concurrent" { assert_eq(1 + 1, 2) }
  \\

/// Everything a run is allowed to differ in, and nothing else: its clocks, its front end, its pool,
/// and the units the C backend builds a worker each.
fn scrub(value: Json) -> Json =
  match value {
    Object(fields) ->
      Object(
        fields.fold(Map::new(), |acc: Map<String, Json>, k: String, v: Json|
          if k.contains("duration") || k.ends_with("_ms") || k.ends_with("_nanos")
              || k == "front_end"
              || k == "phases"
              || k == "workers"
              || k == "units"
              || k == "elapsed" { acc }
          else { acc.insert(k, scrub(v)) }),
      ),
    Array(xs) -> Array(xs.map(scrub)),
    other -> other,
  }

/// `value` without where anything stands in the text, which an edit that changes no hash may move.
fn placeless(value: Json) -> Json =
  match value {
    Object(fields) ->
      Object(
        fields.fold(Map::new(), |acc: Map<String, Json>, k: String, v: Json|
          if ["start", "end", "line", "end_line", "column", "end_column"].contains(k) { acc }
          else { acc.insert(k, placeless(v)) }),
      ),
    Array(xs) -> Array(xs.map(placeless)),
    other -> other,
  }

/// Where two artifacts first differ, as a path into them.
fn difference(a: Json, b: Json, at_path: String) -> Option<String> / {abort.raise} =
  if a == b { None } else {
    let plainly = Some(at_path ++ ": " ++ shown(a) ++ " against " ++ shown(b));
    match a {
      Object(x) -> match b {
        Object(y) -> {
          let inner = x.fold(None, |found: Option<String>, k: String, v: Json|
            match found {
              Some(_) -> found,
              None ->
                difference(
                  v,
                  match y.get(k) { Some(w) -> w, None -> json::Null },
                  at_path ++ "." ++ k,
                ),
            });
          match inner { Some(d) -> Some(d), None -> Some(at_path ++ ": a key only the second has") }
        },
        _ -> plainly,
      },
      Array(xs) -> match b {
        Array(ys) -> if xs.len() != ys.len() { plainly } else {
          xs.fold({ i: 0, found: None }, |s: { i: Int, found: Option<String> }, v: Json|
            {
              i: s.i + 1,
              found: match s.found {
                Some(_) -> s.found,
                None ->
                  difference(
                    v,
                    match ys.at(s.i) { Some(w) -> w, None -> json::Null },
                    at_path ++ "[" ++ s.i.to_string() ++ "]",
                  ),
              },
            }).found
        },
        _ -> plainly,
      },
      _ -> plainly,
    }
  }

/// The same artifact, or the test fails saying where the two part.
fn agree(a: Json, b: Json, what: String) -> Unit / {abort.raise} =
  match difference(a, b, "") { None -> (), Some(d) -> panic(what ++ ": " ++ d) }

fn argv_of(args: List<String>) -> List<String> = ["test", "--json", "--no-cache"].concat(args)

/// What a `ply` of its own reported.
fn artifact(args: List<String>) -> Json / {Spawned, abort.raise} =
  scrub(json_of(spawned(argv_of(args))))

fn result_for(a: Json, key: String) -> Json / {abort.raise} =
  match items(at(a, "results")).filter(|r: Json| str(at(r, "key")).ends_with(key)) {
    [r, ..] -> r,
    [] -> panic("no result for `" ++ key ++ "` in " ++ shown(a)),
  }

fn is_text(j: Json) -> Bool = match j { Str(_) -> true, _ -> false }

test/nondet "one seed is one artifact across separate processes" {
  program(mixed_program());
  let once = artifact(["--seed", "0"]);
  range(1, 8).fold((), |u: Unit, run: Int|
    agree(
      artifact(["--seed", "0"]),
      once,
      "process " ++ run.to_string() ++ " produced a different artifact for one seed",
    ))
}

test/nondet "a whole search is one artifact across separate processes" {
  program(mixed_program());
  let once = artifact([]);
  range(1, 6).fold((), |u: Unit, run: Int|
    agree(artifact([]), once, "process " ++ run.to_string() ++ " searched differently"));
  // The artifact must carry the race's own failure with a seed, or this test would pass on an empty
  // run, or on one the C backend declined.
  assert(
    items(at(once, "failures")).filter(|f: Json|
        is_text(at(f, "seed")) && str(path(f, ["diagnostic", "code"])) == "E0501").len(
      )
      > 0,
    Some(
      "the program must produce a seeded failure, or these comparisons prove nothing: "
        ++ shown(once),
    ),
  )
}

test/nondet "the worker count does not reach a scheduling decision" {
  program(mixed_program());
  let one = artifact(["--jobs", "1"]);
  ["2", "3", "8", "17"].fold((), |u: Unit, jobs: String|
    agree(artifact(["--jobs", jobs]), one, "`--jobs " ++ jobs ++ "` disagreed with `--jobs 1`"))
}

test/nondet "running a test alone reports what it reports in company" {
  program(mixed_program());
  let whole = artifact([]);
  [
    "two increments race",
    "two increments land in some order",
    "a sleeper costs no wall clock",
  ].fold((), |u: Unit, name: String|
    assert(
      result_for(artifact(["--filter", name]), name) == result_for(whole, name),
      Some("`" ++ name ++ "` reported differently when run alone"),
    ))
}

test/nondet "a warm front-end cache does not change an interleaving" {
  program(mixed_program());
  let cold = artifact([]);
  // Populate the front-end cache, then run against it.
  let _ = spawned(["test", "--json"], []);
  agree(artifact([]), cold, "a warm front-end cache changed what the search did")
}

// A search is a function of the program, which a hash covers, so renaming locals and adding a
// comment moves no interleaving; the comment moves only where a failure stands.
test/nondet "an edit that changes no hash changes no interleaving" {
  program(mixed_program());
  let plain = artifact([]);
  let edited = [
    { from: "let seen =", to: "// a comment nobody reads\n  let observed =" },
    { from: "seen + 1", to: "observed + 1" },
    { from: "let a = task.spawn", to: "let first  =  task.spawn" },
    { from: "let b = task.spawn", to: "let second = task.spawn" },
    { from: "task.join(a)", to: "task.join(first)" },
    { from: "task.join(b)", to: "task.join(second)" },
  ].fold(mixed_program(), |text: String, e: { from: String, to: String }|
    text.replace(e.from, e.to));
  assert(
    edited != mixed_program(),
    Some("the edit moved nothing, so this compares a program with itself"),
  );
  program(edited);
  agree(
    placeless(artifact([])),
    placeless(plain),
    "renaming locals and adding a comment moved the search",
  )
}

test/nondet "the seed a failure prints replays that failure" {
  program(mixed_program());
  let searched = artifact([]);
  let failure = match items(at(searched, "failures")).filter(|f: Json| is_text(at(f, "seed"))) {
    [f, ..] -> f,
    [] -> panic("the racy test must fail with a seed: " ++ shown(searched)),
  };
  assert(
    str(path(failure, ["diagnostic", "code"])) == "E0501",
    Some("the race's own assertion is what the seed names: " ++ shown(failure)),
  );
  let seed = str(at(failure, "seed"));
  let replayed = artifact(["--seed", seed]);
  let again = match items(at(replayed, "failures")).filter(|f: Json| str(at(f, "seed")) == seed) {
    [f, ..] -> f,
    [] -> panic("seed " ++ seed ++ " did not reproduce the failure: " ++ shown(replayed)),
  };
  assert(
    path(again, ["diagnostic", "message"]) == path(failure, ["diagnostic", "message"]),
    Some("seed " ++ seed ++ " reproduced a different failure"),
  );
  // Twice more, in two more processes, because a repro that works once is not a repro.
  range(0, 2).fold((), |u: Unit, i: Int| agree(artifact(["--seed", seed]), replayed, "a replay"))
}

test/nondet "a seed actually decides which interleaving runs" {
  program(mixed_program());
  let verdicts = range(0, 24).fold([], |acc: List<String>, root: Int| {
    let status = str(
      at(result_for(artifact(["--seed", root.to_string()]), "two increments race"), "status"),
    );
    if acc.filter(|v: String| v == status).len() > 0 { acc } else { acc.push(status) }
  });
  assert(
    verdicts.len() > 1,
    Some(
      "24 seeds gave one verdict on a racy test, so the seed decides nothing: "
        ++ String::join(verdicts, ", "),
    ),
  )
}

/// The tasks reach one handler's variable through the counter's operations, which is what the race
/// names.
fn var_race(name: String) -> String =
  "test \"" ++ name
    ++ "\" {\n  handle {\n    simulate {\n      let a = task.spawn(|| bump());\n      let b = task.spawn(|| bump());\n      task.join(a);\n      task.join(b);\n      assert_eq(counter.get[n](), 2)\n    }\n  } with {\n    var c = 0,\n    counter.get[n]() -> c,\n    counter.put[n](v) -> {\n      c = v;\n    },\n  }\n}\n"

// Each interleaving is an entry on the backend the test runs on, as is every search before it on that
// thread, so a race names the variable as a fresh backend does or the report depends on what ran
// first.
test/nondet "every search on one thread names a race's variable alike" {
  program(
    counter_effect()
      ++ String::join(
        range(0, 3).map(|i: Int| var_race("a lost update on a variable " ++ i.to_string())),
        "",
      ),
  );
  let run = artifact(["--jobs", "1"]);
  let races = items(at(run, "failures")).map(|f: Json| at(f, "race"));
  assert(races.len() == 3, Some("each copy reaches the lost update: " ++ shown(run)));
  // Each copy has spans and a name of its own; what it names of the variable is the same.
  let named = |r: Json|
    [
      at(r, "at"),
      path(r, ["left", "task"]),
      path(r, ["left", "access"]),
      path(r, ["right", "task"]),
      path(r, ["right", "access"]),
    ];
  races.fold((), |u: Unit, race: Json| {
    ["left", "right"].fold(u, |v: Unit, side: String| {
      let access = str(path(race, [side, "access"]));
      assert(
        access.contains(".counter.") && access.ends_with("[n]"),
        Some("the counter the two tasks race on: " ++ shown(race)),
      )
    });
    assert(
      named(race) == named(first(races)),
      Some("a later search on the thread named the race differently"),
    )
  })
}

fn counter_effect() -> String =
  \\effect counter {
  \\  read  get[r]() -> Int
  \\  write put[r](v: Int) -> Unit
  \\}
  \\
  \\fn bump() -> Unit / {counter.read[n], counter.write[n], clock.read} = {
  \\  let seen = counter.get[n]();
  \\  clock.now();
  \\  counter.put[n](seen + 1)
  \\}
  \\

fn two_regions() -> String =
  counter_effect()
    ++
    \\
    \\test "a race in the first region and a quiet second one" {
    \\  handle {
    \\    {
    \\      simulate {
    \\        let a = task.spawn(|| bump());
    \\        let b = task.spawn(|| bump());
    \\        task.join(a);
    \\        task.join(b)
    \\      };
    \\      simulate {
    \\        clock.now();
    \\        ()
    \\      };
    \\      assert_eq(counter.get[n](), 2)
    \\    }
    \\  } with {
    \\    var c = 0,
    \\    counter.get[n]() -> c,
    \\    counter.put[n](v) -> {
    \\      c = v;
    \\    },
    \\  }
    \\}
    \\

fn region_in_a_helper() -> String =
  counter_effect()
    ++
    \\
    \\fn race() -> Unit / {counter.read[n], counter.write[n], sim.read, abort.raise} = simulate {
    \\  let a = task.spawn(|| bump());
    \\  let b = task.spawn(|| bump());
    \\  task.join(a);
    \\  task.join(b)
    \\}
    \\
    \\test "the same region twice through a call" {
    \\  handle {
    \\    {
    \\      race();
    \\      race();
    \\      assert_eq(counter.get[n](), 4)
    \\    }
    \\  } with {
    \\    var c = 0,
    \\    counter.get[n]() -> c,
    \\    counter.put[n](v) -> {
    \\      c = v;
    \\    },
    \\  }
    \\}
    \\

/// The fixture's assertion seeing an update lost: a failed test whose diagnostic says so.
fn assert_lost_update(run: Json, total: Int, what: String) -> Unit / {abort.raise} = {
  let failure = match items(at(run, "failures")) {
    [f, ..] -> f,
    [] -> panic(what ++ ": no interleaving failed: " ++ shown(run)),
  };
  assert(
    str(path(failure, ["diagnostic", "code"])) == "E0501",
    Some(what ++ ": " ++ shown(failure)),
  );
  let message = str(path(failure, ["diagnostic", "message"]));
  let lost = "assertion failed: expected " ++ total.to_string() ++ ", found ";
  assert(
    message.starts_with(lost) && message != lost ++ total.to_string(),
    Some(what ++ ": " ++ message),
  );
  assert(
    is_text(at(failure, "seed")),
    Some(what ++ ": a lost update names its seed: " ++ shown(failure)),
  )
}

test/nondet "a second simulate region does not hide the first region's race" {
  [
    { source: two_regions(), name: "two regions written out", total: 2 },
    { source: region_in_a_helper(), name: "one region reached twice through a call", total: 4 },
  ].fold((), |u: Unit, c: { source: String, name: String, total: Int }| {
    program(c.source);
    assert_lost_update(
      artifact(["--sim", "random", "--seeds", "64"]),
      c.total,
      "`" ++ c.name ++ "`: the fixture must contain a reachable lost update, or it proves nothing",
    );
    assert_lost_update(
      artifact(["--sim-budget", "1024"]),
      c.total,
      "`" ++ c.name ++ "`: the search",
    )
  })
}

/// The second region's shape depends on what the first raced to, so replaying a branch rebuilds a
/// region whose enabled sets differ from the recording's only if the replay strayed.
fn shape_follows_a_race() -> String =
  \\effect counter {
  \\  read  get[r]() -> Int
  \\  write put[r](v: Int) -> Unit
  \\  write note[r](v: Int) -> Unit
  \\  read  noted[r]() -> Int
  \\}
  \\
  \\fn bump() -> Unit / {counter.get[n], counter.put[n], clock.now} = {
  \\  let seen = counter.get[n]();
  \\  clock.now();
  \\  counter.put[n](seen + 1)
  \\}
  \\
  \\fn noise() -> Unit / {counter.get[n], counter.note[m], clock.now} = {
  \\  let seen = counter.get[n]();
  \\  clock.now();
  \\  counter.note[m](seen)
  \\}
  \\
  \\test "the second region's shape depends on what the first raced to" {
  \\  handle {
  \\    {
  \\        simulate {
  \\          let a = task.spawn(|| bump());
  \\          let b = task.spawn(|| bump());
  \\          task.join(a);
  \\          task.join(b)
  \\        };
  \\        simulate {
  \\          if counter.get[n]() == 2 {
  \\            let a = task.spawn(|| noise());
  \\            let b = task.spawn(|| noise());
  \\            task.join(a);
  \\            task.join(b)
  \\          } else {
  \\            let a = task.spawn(|| noise());
  \\            task.join(a)
  \\          }
  \\        };
  \\        assert(counter.noted[m]() >= 0)
  \\      }
  \\  } with {
  \\    var c = 0,
  \\    var d = 0,
  \\    counter.get[n]() -> c,
  \\    counter.put[n](v) -> {
  \\      c = v;
  \\    },
  \\    counter.note[m](v) -> {
  \\      d = v;
  \\    },
  \\    counter.noted[m]() -> d,
  \\  }
  \\}
  \\

test/nondet "a legal program is never reported as a simulation divergence" {
  program(shape_follows_a_race());
  let run = artifact([]);
  match items(at(run, "failures")) {
    [failure, ..] -> {
      assert(
        str(path(failure, ["diagnostic", "code"])) != "E0415",
        Some("a legal program was blamed on Ply's simulation: " ++ shown(failure)),
      );
      panic("its assertion holds in every interleaving, and a run failed: " ++ shown(failure))
    },
    [] -> (),
  };
  // Replay is checked on a branch, so a search that took none compared nothing.
  assert(
    int(path(first(items(at(run, "results"))), ["simulation", "explored"])) > 1,
    Some(shown(run)),
  )
}
