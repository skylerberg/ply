import harness (spawned, PlyProcess)
import support.harness (RunResult, write_program, all_output, stderr, json_of, path, int, value_of)
import std.process (EnvironmentVariable, environment_variable)
import std.string
import std.list

fn service() -> String = String::of_bytes_lossy(embed("../programs/config_cli/service.ply"))

fn secret_main() -> String = String::of_bytes_lossy(embed("../programs/config_cli/secret_main.ply"))

test/nondet "get cannot read a key the schema declares secret" {
  write_program(
    service().replace(
      "config.get[server](\"SERVICE_REGION\")",
      "config.get[server](\"SERVICE_API_KEY\")",
    ),
  );
  let r = spawned(
    [
      "run",
      ".",
      "--json",
      "--config-schema",
      "m.spec",
      "--set",
      "SERVICE_PORT=8137",
      "--set",
      "SERVICE_API_KEY=correct-horse",
    ],
    [],
  );
  assert(value_of(r) == "None", Some("`config.get` returned a credential: " ++ all_output(r)));
  assert(
    !all_output(r).contains("correct-horse"),
    Some("the credential reached the run's output: " ++ all_output(r)),
  )
}

test/nondet "a secret config value is usable by the program but never printed in `run --json` or `--explain` output" {
  write_program(secret_main());
  let ran = |form: String|
    spawned(
      ["run", ".", form, "--config-schema", "m.spec", "--set", "SERVICE_API_KEY=correct-horse"],
      [],
    );
  let reported = ran("--json");
  assert(value_of(reported) == "true", Some("the key verified: " ++ all_output(reported)));
  let explained = ran("--explain");
  assert(explained.code == 0, Some(stderr(explained)));
  [reported, explained].fold((), |u: Unit, r: RunResult|
    assert(
      !all_output(r).contains("correct-horse"),
      Some("the credential reached a stream: " ++ all_output(r)),
    ))
}

fn cached_with(environment: List<EnvironmentVariable>) -> Int / {PlyProcess, abort.raise} = {
  let ran = spawned(["test", ".", "--json"], environment);
  assert(ran.code == 0, Some(all_output(ran)));
  int(path(json_of(ran), ["summary", "cached"]))
}

test/nondet "a test that reads configuration is cached until the value of a key it read changes" {
  write_program(service() ++ "\ntest/nondet \"reads the region\" { assert(region() != None) }\n");
  let eu = [environment_variable("SERVICE_REGION", "eu")];
  assert_eq(cached_with(eu), 0);
  assert_eq(cached_with(eu), 2);
  let us = [environment_variable("SERVICE_REGION", "us")];
  assert_eq(cached_with(us), 1);
  assert_eq(cached_with(us.push(environment_variable("SERVICE_UNREAD", "any"))), 2)
}

test/nondet "`run` and `test` read configuration from the environment, and `--set` overrides the environment" {
  write_program(
    service()
      ++ "\ntest/nondet \"reads the environment\" { assert_eq(region(), Some(\"environment\")) }\n",
  );
  let environment = [environment_variable("SERVICE_REGION", "environment")];
  let ran = spawned(["run", ".", "--json"], environment);
  assert(value_of(ran).contains("environment"), Some(all_output(ran)));
  let tested = spawned(["test", ".", "--no-cache"], environment);
  assert(tested.code == 0, Some(all_output(tested)));
  let set = spawned(["test", ".", "--no-cache", "--set", "SERVICE_REGION=eu"], environment);
  assert(set.code == 1, Some("a test is given what `--set` supplies: " ++ all_output(set)))
}
