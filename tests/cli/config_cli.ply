import spawning.harness (RunResult, write_program, write, spawned, all_output, stdout, stderr,
                         json_of, at, path, items, str, int, bool, json_text, value_of, PlyProcess)
import std.json (Json)
import std.process (EnvironmentVariable, environment_variable)
import std.string
import std.list

fn service() -> String = String::of_bytes_lossy(embed("../programs/config_cli/service.ply"))

fn secret_main() -> String = String::of_bytes_lossy(embed("../programs/config_cli/secret_main.ply"))

fn hosts(
  extra: List<String>,
  environment: List<EnvironmentVariable>,
) -> RunResult / {PlyProcess, abort.raise} =
  spawned(["hosts", ".", "--json"].concat(extra), environment)

fn key_of(report: Json, name: String) -> Json / {abort.raise} =
  match items(path(report, ["configuration", "keys"])).filter(|k: Json|
      str(at(k, "name")) == name) {
    [k, ..] -> k,
    [] -> panic("`" ++ name ++ "` is not in " ++ json_text(report)),
  }

fn service_region_key(ran: RunResult) -> Json / {abort.raise} =
  key_of(json_of(ran), "SERVICE_REGION")

test/nondet "precedence is set, then file, then environment, then default" {
  write_program(service());
  write("deploy.env", "SERVICE_REGION=file\n");
  let schema = ["--config-schema", "m.spec", "--set", "SERVICE_PORT=8137"];
  let everything = [
    environment_variable("SERVICE_REGION", "environment"),
    environment_variable("SERVICE_API_KEY", "k"),
  ];

  let all = service_region_key(
    hosts(schema.concat(["--set", "SERVICE_REGION=set", "--config", "deploy.env"]), everything),
  );
  assert_eq(str(at(all, "value")), "set");
  assert_eq(str(at(all, "source")), "--set");

  let no_set = service_region_key(hosts(schema.concat(["--config", "deploy.env"]), everything));
  assert_eq(str(at(no_set, "value")), "file");
  assert_eq(str(at(no_set, "source")), "deploy.env");

  let no_files = service_region_key(hosts(schema, everything));
  assert_eq(str(at(no_files, "value")), "environment");
  assert_eq(str(at(no_files, "source")), "env");

  let nothing = service_region_key(hosts(schema, [environment_variable("SERVICE_API_KEY", "k")]));
  assert_eq(str(at(nothing, "value")), "us");
  assert_eq(str(at(nothing, "source")), "default")
}

test/nondet "a required key nothing supplies is E0441 at startup" {
  write_program(service());
  let r = spawned(["run", ".", "--explain", "--config-schema", "m.spec"], []);
  let text = stderr(r);
  assert(r.code != 0, Some(text));
  assert(text.contains("E0441"), Some(text));
  assert(text.contains("SERVICE_PORT"), Some(text));
  assert(text.contains("SERVICE_API_KEY"), Some(text));
  assert(text.contains("environment variable"), Some(text));
  assert(!text.contains("host: "), Some("the rejection comes before anything is bound: " ++ text))
}

test/nondet "a value that is not of its shape is E0442 naming the source" {
  write_program(service());
  let r = spawned(["run", ".", "--config-schema", "m.spec", "--set", "SERVICE_PORT=eight"], [
    environment_variable("SERVICE_API_KEY", "k"),
  ]);
  let text = stderr(r);
  assert(r.code != 0, Some(text));
  assert(text.contains("E0442"), Some(text));
  assert(text.contains("SERVICE_PORT"), Some(text));
  assert(text.contains("--set"), Some(text));
  assert(text.contains("eight"), Some("a plain value is shown: " ++ text))
}

test/nondet "a malformed secret is E0442 and prints no value" {
  write_program(service());
  let r = spawned(
    [
      "run",
      ".",
      "--config-schema",
      "m.spec",
      "--set",
      "SERVICE_PORT=8137",
      "--set",
      "SERVICE_API_KEY=",
    ],
    [],
  );
  let text = stderr(r);
  assert(r.code != 0, Some(text));
  assert(text.contains("E0442"), Some(text));
  assert(text.contains("SERVICE_API_KEY"), Some(text));
  assert(text.contains("not printed"), Some(text))
}

test/nondet "`--set` of a key the config schema does not declare warns, but an unrelated environment variable does not" {
  write_program(service());
  let r = spawned(
    [
      "hosts",
      ".",
      "--config-schema",
      "m.spec",
      "--set",
      "SERVICE_PORT=8137",
      "--set",
      "SERVICE_PROT=8138",
    ],
    [
      environment_variable("SERVICE_API_KEY", "k"),
      environment_variable("AWS_PROFILE", "nothing to do with this program"),
    ],
  );
  assert(r.code == 0, Some(stderr(r)));
  assert(all_output(r).contains("W0607"), Some(all_output(r)));
  assert(all_output(r).contains("SERVICE_PROT"), Some(all_output(r)));
  assert(
    !all_output(r).contains("AWS_PROFILE"),
    Some("an environment name is not a typo somebody made in this run: " ++ all_output(r)),
  )
}

test/nondet "get cannot read a key the schema declares secret" {
  write_program(
    service().replace(
      "config.get[server](\"SERVICE_REGION\")",
      "config.get[server](\"SERVICE_API_KEY\")",
    ),
  );
  let r = spawned(
    [
      "run",
      ".",
      "--json",
      "--config-schema",
      "m.spec",
      "--set",
      "SERVICE_PORT=8137",
      "--set",
      "SERVICE_API_KEY=correct-horse",
    ],
    [],
  );
  assert(value_of(r) == "None", Some("`config.get` returned a credential: " ++ all_output(r)));
  assert(
    !all_output(r).contains("correct-horse"),
    Some("the credential reached the run's output: " ++ all_output(r)),
  )
}

test/nondet "a secret config value is usable by the program but never printed in `run --json` or `--explain` output" {
  write_program(secret_main());
  let ran = |form: String|
    spawned(
      ["run", ".", form, "--config-schema", "m.spec", "--set", "SERVICE_API_KEY=correct-horse"],
      [],
    );
  let reported = ran("--json");
  assert(value_of(reported) == "true", Some("the key verified: " ++ all_output(reported)));
  let explained = ran("--explain");
  assert(explained.code == 0, Some(stderr(explained)));
  [reported, explained].fold((), |u: Unit, r: RunResult|
    assert(
      !all_output(r).contains("correct-horse"),
      Some("the credential reached a stream: " ++ all_output(r)),
    ))
}

test/nondet "the JSON report carries a secret's key and source and not its value" {
  write_program(secret_main());
  let r = hosts(["--config-schema", "m.spec"], [
    environment_variable("SERVICE_API_KEY", "correct-horse"),
  ]);
  let key = key_of(json_of(r), "SERVICE_API_KEY");
  assert_eq(str(at(key, "value")), "****");
  assert_eq(str(at(key, "source")), "env");
  assert(bool(at(key, "secret")), Some(json_text(key)));
  assert(!stdout(r).contains("correct-horse"), Some(stdout(r)))
}

test/nondet "a deterministic test that is given configuration passes, and its second run is a cache hit" {
  write_program(service());
  let report = json_of(spawned(["test", ".", "--json"]));
  assert(bool(at(report, "ok")), Some(json_text(report)));
  let second = json_of(spawned(["test", ".", "--json"]));
  assert(bool(at(second, "ok")), Some(json_text(second)));
  assert(
    int(path(second, ["summary", "cached"])) == 1,
    Some("the second run is a cache hit: " ++ json_text(second)),
  );
  assert(int(path(second, ["selection", "selected"])) == 0, Some(json_text(second)));
  assert(int(path(second, ["selection", "same_code"])) == 0, Some(json_text(second)))
}

fn cached_with(environment: List<EnvironmentVariable>) -> Int / {PlyProcess, abort.raise} = {
  let ran = spawned(["test", ".", "--json"], environment);
  assert(ran.code == 0, Some(all_output(ran)));
  int(path(json_of(ran), ["summary", "cached"]))
}

test/nondet "a test that reads configuration is cached until the value of a key it read changes" {
  write_program(service() ++ "\ntest/nondet \"reads the region\" { assert(region() != None) }\n");
  let eu = [environment_variable("SERVICE_REGION", "eu")];
  assert_eq(cached_with(eu), 0);
  assert_eq(cached_with(eu), 2);
  let us = [environment_variable("SERVICE_REGION", "us")];
  assert_eq(cached_with(us), 1);
  assert_eq(cached_with(us.push(environment_variable("SERVICE_UNREAD", "any"))), 2)
}

test/nondet "a deterministic test that reads configuration without a handler fails with E0412" {
  write_program(
    \\import std.config
    \\import std.config (config)
    \\
    \\pub fn region() -> Option<String> / {config.read[server]} =
    \\  config.get[server]("SERVICE_REGION")
    \\
    \\test "reaches the environment" {
    \\  assert_eq(region(), None)
    \\}
    \\
  );
  let r = spawned(["test", "."]);
  assert(r.code != 0, Some(stderr(r)));
  assert(stderr(r).contains("E0412"), Some(stderr(r)))
}

test/nondet "`run` and `test` read configuration from the environment, and `--set` overrides the environment" {
  write_program(
    service()
      ++ "\ntest/nondet \"reads the environment\" { assert_eq(region(), Some(\"environment\")) }\n",
  );
  let environment = [environment_variable("SERVICE_REGION", "environment")];
  let ran = spawned(["run", ".", "--json"], environment);
  assert(value_of(ran).contains("environment"), Some(all_output(ran)));
  let tested = spawned(["test", ".", "--no-cache"], environment);
  assert(tested.code == 0, Some(all_output(tested)));
  let set = spawned(["test", ".", "--no-cache", "--set", "SERVICE_REGION=eu"], environment);
  assert(set.code == 1, Some("a test is given what `--set` supplies: " ++ all_output(set)))
}
