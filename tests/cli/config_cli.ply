//! Configuration: `--set` over `--config` files over the environment over a default, each source
//! refused by name when it is malformed, and a secret that reaches no stream; a test reads the
//! environment as a run does.

import harness (scratch, Ran, program, write, on_disk, on_disk_with, spawned, said, stdout, stderr,
                json_of, at, path, items, str, int, truth, shown, Reached, Shipped, Spawned)
import std.json (Json)
import std.process (Var, var)
import std.string
import std.list

fn service() -> String =
  \\import std.config
  \\import std.config (config)
  \\
  \\pub fn spec() -> config::ConfigSpec =
  \\  config::spec([
  \\    config::with_default("SERVICE_REGION", config::SText, "us"),
  \\    config::required("SERVICE_PORT", config::SInt),
  \\    config::required("SERVICE_API_KEY", config::SSecret),
  \\  ])
  \\
  \\pub fn region() -> Option<String> / {config.get[server]} =
  \\  config.get[server]("SERVICE_REGION")
  \\
  \\fn main() -> Option<String> / {config.get[server]} = region()
  \\
  \\// A `det` test supplies its own values: the row after the handle is empty, so
  \\// this runs, caches and passes.
  \\test "a handled read reaches no host" {
  \\  let fixture = config::one_value("SERVICE_REGION", "twin");
  \\  handle {
  \\    assert_eq(region(), Some("twin"))
  \\  } with {
  \\    config.get[server](k) -> config::get_step(fixture, k),
  \\  }
  \\}
  \\

fn secret_main() -> String =
  \\import std.config
  \\import std.config (config)
  \\
  \\pub fn spec() -> config::ConfigSpec =
  \\  config::spec([config::required("SERVICE_API_KEY", config::SSecret)])
  \\
  \\fn main() -> Bool / {config.read[credentials]} =
  \\  match config.secret[credentials]("SERVICE_API_KEY") {
  \\    None -> false,
  \\    Some(key) -> key.verify("correct-horse"),
  \\  }
  \\

/// Its whole output is the resolved configuration, so precedence is read from it.
fn hosts(extra: List<String>, vars: List<Var>) -> Ran / {Reached, Shipped, abort.raise, diverges} =
  on_disk_with(["hosts", "--json"].concat(extra), vars, None)

fn key_of(report: Json, name: String) -> Json / {abort.raise} =
  match items(path(report, ["configuration", "keys"])).filter(|k: Json|
      str(at(k, "name")) == name) {
    [k, ..] -> k,
    [] -> panic("`" ++ name ++ "` is not in " ++ shown(report)),
  }

fn region_of(ran: Ran) -> Json / {abort.raise} = key_of(json_of(ran), "SERVICE_REGION")

test "precedence is set, then file, then environment, then default" {
  scratch(|| {
    program(service());
    write("deploy.env", "SERVICE_REGION=file\n");
    let schema = ["--config-schema", "m.spec", "--set", "SERVICE_PORT=8137"];
    let everything = [var("SERVICE_REGION", "environment"), var("SERVICE_API_KEY", "k")];

    let all = region_of(
      hosts(schema.concat(["--set", "SERVICE_REGION=set", "--config", "deploy.env"]), everything),
    );
    assert_eq(str(at(all, "value")), "set");
    assert_eq(str(at(all, "source")), "--set");

    let no_set = region_of(hosts(schema.concat(["--config", "deploy.env"]), everything));
    assert_eq(str(at(no_set, "value")), "file");
    assert_eq(str(at(no_set, "source")), "deploy.env");

    let no_files = region_of(hosts(schema, everything));
    assert_eq(str(at(no_files, "value")), "environment");
    assert_eq(str(at(no_files, "source")), "env");

    let nothing = region_of(hosts(schema, [var("SERVICE_API_KEY", "k")]));
    assert_eq(str(at(nothing, "value")), "us");
    assert_eq(str(at(nothing, "source")), "default")
  })
}

test "a malformed config file is E0440 naming the file and line" {
  scratch(|| {
    program(service());
    [
      { contents: "SERVICE_REGION=eu\nno equals here\n", expected: "no `=`" },
      { contents: "SERVICE_REGION=eu\n=8137\n", expected: "empty key" },
      { contents: "SERVICE_REGION=eu\nSERVICE-PORT=8137\n", expected: "contains" },
    ].fold((), |u: Unit, c: { contents: String, expected: String }| {
      write("bad.env", c.contents);
      let r = on_disk(["hosts", "--config", "bad.env"]);
      let text = stderr(r);
      assert(r.code != 0, Some(text));
      assert(text.contains("E0440"), Some(text));
      assert(text.contains("bad.env"), Some(text));
      assert(text.contains("line 2"), Some(text));
      assert(text.contains(c.expected), Some(text))
    })
  })
}

test "an unreadable config file is E0440" {
  scratch(|| {
    program(service());
    let r = on_disk(["hosts", "--config", "absent.env"]);
    assert(r.code != 0, Some(said(r)));
    assert(stderr(r).contains("E0440"), Some(stderr(r)));
    assert(stderr(r).contains("absent.env"), Some(stderr(r)))
  })
}

test/nondet "a required key nothing supplies is E0441 at startup" {
  program(service());
  let r = spawned(["run", "--config-schema", "m.spec"], []);
  let text = stderr(r);
  assert(r.code != 0, Some(text));
  assert(text.contains("E0441"), Some(text));
  assert(text.contains("SERVICE_PORT"), Some(text));
  assert(text.contains("SERVICE_API_KEY"), Some(text));
  assert(text.contains("environment variable"), Some(text));
  assert(
    !text.contains("binding host"),
    Some("the refusal comes before anything is bound: " ++ text),
  )
}

test/nondet "a value that is not of its shape is E0442 naming the source" {
  program(service());
  let r = spawned(["run", "--config-schema", "m.spec", "--set", "SERVICE_PORT=eight"], [
    var("SERVICE_API_KEY", "k"),
  ]);
  let text = stderr(r);
  assert(r.code != 0, Some(text));
  assert(text.contains("E0442"), Some(text));
  assert(text.contains("SERVICE_PORT"), Some(text));
  assert(text.contains("--set"), Some(text));
  assert(text.contains("eight"), Some("a plain value is shown: " ++ text))
}

// The one refusal that must not quote what it refused.
test/nondet "a malformed secret is E0442 and prints no value" {
  program(service());
  let r = spawned(
    ["run", "--config-schema", "m.spec", "--set", "SERVICE_PORT=8137", "--set", "SERVICE_API_KEY="],
    [],
  );
  let text = stderr(r);
  assert(r.code != 0, Some(text));
  assert(text.contains("E0442"), Some(text));
  assert(text.contains("SERVICE_API_KEY"), Some(text));
  assert(text.contains("not printed"), Some(text))
}

test "an undeclared set warns and an undeclared environment key does not" {
  scratch(|| {
    program(service());
    let r = on_disk_with(
      [
        "hosts",
        "--config-schema",
        "m.spec",
        "--set",
        "SERVICE_PORT=8137",
        "--set",
        "SERVICE_PROT=8138",
      ],
      [var("SERVICE_API_KEY", "k"), var("AWS_PROFILE", "nothing to do with this program")],
      None,
    );
    assert(r.code == 0, Some(stderr(r)));
    assert(said(r).contains("W0607"), Some(said(r)));
    assert(said(r).contains("SERVICE_PROT"), Some(said(r)));
    assert(
      !said(r).contains("AWS_PROFILE"),
      Some("an environment name is not a typo somebody made in this run: " ++ said(r)),
    )
  })
}

test "a config schema naming no definition lists what the program has" {
  scratch(|| {
    program(service());
    let r = on_disk(["hosts", "--config-schema", "m.confg"]);
    assert(r.code != 0, Some(said(r)));
    assert(stderr(r).contains("E0440"), Some(stderr(r)));
    assert(stderr(r).contains("m.spec"), Some(stderr(r)))
  })
}

test/nondet "get cannot read a key the schema declares secret" {
  program(
    service().replace(
      "config.get[server](\"SERVICE_REGION\")",
      "config.get[server](\"SERVICE_API_KEY\")",
    ),
  );
  let r = spawned(
    [
      "run",
      "--config-schema",
      "m.spec",
      "--set",
      "SERVICE_PORT=8137",
      "--set",
      "SERVICE_API_KEY=correct-horse",
    ],
    [],
  );
  assert(said(r).contains("None"), Some("`config.get` answered a credential: " ++ said(r)));
  assert(
    !said(r).contains("correct-horse"),
    Some("the credential reached the run's output: " ++ said(r)),
  )
}

test/nondet "a secret arrives as a secret and appears in no stream" {
  program(secret_main());
  let r = spawned(
    ["run", "--config-schema", "m.spec", "--set", "SERVICE_API_KEY=correct-horse"],
    [],
  );
  assert(r.code == 0, Some(stderr(r)));
  assert(stdout(r).contains("true"), Some("the key verified: " ++ stdout(r)));
  [stdout(r), stderr(r)].fold((), |u: Unit, stream: String|
    assert(!stream.contains("correct-horse"), Some("the credential reached a stream: " ++ stream)))
}

test "the JSON report carries a secret's key and source and not its value" {
  scratch(|| {
    program(secret_main());
    let r = hosts(["--config-schema", "m.spec"], [var("SERVICE_API_KEY", "correct-horse")]);
    let key = key_of(json_of(r), "SERVICE_API_KEY");
    assert_eq(str(at(key, "value")), "****");
    assert_eq(str(at(key, "source")), "env");
    assert(truth(at(key, "secret")), Some(shown(key)));
    assert(!stdout(r).contains("correct-horse"), Some(stdout(r)))
  })
}

test/nondet "a test supplying configuration is det and cached" {
  program(service());
  let report = json_of(spawned(["test", "--json"]));
  assert(truth(at(report, "ok")), Some(shown(report)));
  let second = json_of(spawned(["test", "--json"]));
  assert(truth(at(second, "ok")), Some(shown(second)));
  assert(
    int(path(second, ["summary", "cached"])) == 1,
    Some("the second run is a cache hit: " ++ shown(second)),
  );
  assert(int(path(second, ["selection", "selected"])) == 0, Some(shown(second)));
  assert(int(path(second, ["selection", "by_code"])) == 0, Some(shown(second)))
}

/// Of a `ply test --json` with `vars`, how many tests the cache answered.
fn cached_with(vars: List<Var>) -> Int / {Spawned, abort.raise} = {
  let ran = spawned(["test", "--json"], vars);
  assert(ran.code == 0, Some(said(ran)));
  int(path(json_of(ran), ["summary", "cached"]))
}

test/nondet "a test that reads configuration is cached while each key it read answers as it did" {
  program(service() ++ "\ntest/nondet \"reads the region\" { assert(region() != None) }\n");
  let eu = [var("SERVICE_REGION", "eu")];
  assert_eq(cached_with(eu), 0);
  assert_eq(cached_with(eu), 2);
  // The handled read reaches no host and stays answered; the one that read the region runs again.
  let us = [var("SERVICE_REGION", "us")];
  assert_eq(cached_with(us), 1);
  // A key the test never read moves nothing.
  assert_eq(cached_with(us.push(var("SERVICE_UNREAD", "any"))), 2)
}

test/nondet "an unhandled config read in a det test is E0412" {
  program(
    \\import std.config
    \\import std.config (config)
    \\
    \\pub fn region() -> Option<String> / {config.read[server]} =
    \\  config.get[server]("SERVICE_REGION")
    \\
    \\test "reaches the environment" {
    \\  assert_eq(region(), None)
    \\}
    \\
  );
  let r = spawned(["test"]);
  assert(r.code != 0, Some(stderr(r)));
  assert(stderr(r).contains("E0412"), Some(stderr(r)))
}

test/nondet "a run and a test read configuration from the environment, `--set` over it" {
  program(
    service()
      ++ "\ntest/nondet \"reads the environment\" { assert_eq(region(), Some(\"environment\")) }\n",
  );
  let environment = [var("SERVICE_REGION", "environment")];
  let ran = spawned(["run"], environment);
  assert(ran.code == 0, Some(said(ran)));
  assert(stdout(ran).contains("environment"), Some(said(ran)));
  let tested = spawned(["test", "--no-cache"], environment);
  assert(tested.code == 0, Some(said(tested)));
  let set = spawned(["test", "--no-cache", "--set", "SERVICE_REGION=eu"], environment);
  assert(set.code == 1, Some("a test is answered what `--set` supplies: " ++ said(set)))
}
