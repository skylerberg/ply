import spawning.harness (RunResult, write_program, spawned, all_output, json_of, at, items, str,
                         json_text, WorkingDirectory, PlyProcess)
import std.json (Json, Str)
import std.string

const fixtures: List<{ name: String, bytes: Bytes }> = embed_dir("../fixtures/lang")

fn fixture(name: String) -> String / {abort.raise} =
  match fixtures.filter(|f: { name: String, bytes: Bytes }| f.name == name ++ ".ply") {
    [f, ..] -> String::of_bytes(f.bytes),
    [] -> panic("`tests/fixtures/lang` holds no `" ++ name ++ ".ply`"),
  }

type Annotation = { test: String, text: String }

fn annotations(source: String, word: String) -> List<Annotation> / {abort.raise} =
  source.split("\n").fold([], |accumulator: List<Annotation>, line: String| {
    let lead = "// " ++ word ++ " ";
    if !line.starts_with(lead) { accumulator } else {
      let rest = line.slice(lead.len(), line.len());
      match rest.split_once(" :: ") {
        Some(p) -> accumulator.push({ test: p.head.trim(), text: p.tail.trim() }),
        None -> panic("`" ++ word ++ " <name> :: <text>`: " ++ line),
      }
    }
  })

fn diagnostic_text(d: Json) -> String = {
  let texts = |key: String|
    String::join(
      items(at(d, key)).map(|x: Json| match x { Str(s) -> s, _ -> str(at(x, "message")) }),
      " ",
    );
  str(at(d, "message")) ++ " " ++ texts("labels") ++ " " ++ texts("notes")
}

fn tested_alone(source: String) -> RunResult / {PlyProcess, WorkingDirectory, abort.raise} = {
  write_program(source);
  spawned(["test", ".", "--json", "--no-cache"])
}

fn assert_fixture_raises(name: String) -> Unit / {PlyProcess, WorkingDirectory, abort.raise} =
  assert_fixture_failures(name, "raises", "E0502")

fn assert_fixture_failures(
  name: String,
  word: String,
  code: String,
) -> Unit / {PlyProcess, WorkingDirectory, abort.raise} = {
  let source = fixture(name);
  let expected = annotations(source, word);
  assert(expected.len() > 0, Some(name ++ " states no " ++ word));
  assert_report_failures(name, code, expected, tested_alone(source))
}

fn assert_report_failures(
  name: String,
  code: String,
  expected: List<Annotation>,
  ran: RunResult,
) -> Unit / {abort.raise} = {
  let failed = items(at(json_of(ran), "failures"));
  expected.fold((), |u: Unit, e: Annotation| {
    let failure = match failed.filter(|f: Json| str(at(f, "name")) == e.test) {
      [f, ..] -> f,
      [] -> panic(name ++ ": `" ++ e.test ++ "` did not fail: " ++ all_output(ran)),
    };
    let d = at(failure, "diagnostic");
    assert(str(at(d, "code")) == code, Some(name ++ ": `" ++ e.test ++ "`: " ++ json_text(d)));
    assert(
      diagnostic_text(d).contains(e.text),
      Some(name ++ ": `" ++ e.test ++ "` raised without `" ++ e.text ++ "`: " ++ json_text(d)),
    )
  });
  assert(
    failed.len() == expected.len(),
    Some(name ++ ": every failure must be one the fixture states: " ++ all_output(ran)),
  )
}

test/nondet "numeric operations such as overflow and division by zero raise errors, and the fixture program's `raise` checks pass" {
  assert_fixture_raises("numbers_raise")
}

test/nondet "shift and overflow operations on integers raise errors, and the fixture program's `raise` checks pass" {
  assert_fixture_raises("bits_raise")
}

test/nondet "a value too wide for its integer type fails with E0502, however the value is bound" {
  assert_fixture_raises("widths_raise")
}

test/nondet "byte builtins given invalid arguments, such as an out-of-range index, raise errors, and the fixture program's `raise` checks pass" {
  assert_fixture_raises("bytes_raise")
}

test/nondet "list updates with invalid arguments, such as an out-of-range index, raise errors, and the fixture program's `raise` checks pass" {
  assert_fixture_raises("lists_raise")
}

test/nondet "a `raise` with no matching handler clause fails its test with E0502, naming the operation and its arguments" {
  assert_fixture_raises("unhandled_raise")
}

test/nondet "in a spawned task, a handler clause that exits a handle it did not open is rejected, and an unhandled `raise` ends the task" {
  assert_fixture_raises("task_handles")
}

test/nondet "an operation that no handler handles ends the run with E0424 and names the operation" {
  assert_fixture_failures("unserved", "refused", "E0424")
}
