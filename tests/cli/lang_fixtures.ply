//! A fixture under `tests/fixtures/lang/` states in `// raises <test> :: <text>` lines which of its
//! tests fail with `E0502` carrying `<text>`, in `// refused <test> :: <text>` lines which fail with
//! `E0424` carrying it, and in `// effects <definition> :: <row>` lines what the checker infers.

import harness (RunResult, in_memory, one_module_tree, write_program, spawned, all_output, json_of,
                at, items, str, int, json_text, WorkingDirectory, PlyProcess)
import std.json (Json, Str)
import std.string

/// Embedded, so a test that reads one is cached until a fixture changes.
fn fixtures() -> List<{ name: String, bytes: Bytes }> = embed_dir("../fixtures/lang")

fn fixture(name: String) -> String / {abort.raise} =
  match fixtures().filter(|f: { name: String, bytes: Bytes }| f.name == name ++ ".ply") {
    [f, ..] -> String::of_bytes(f.bytes),
    [] -> panic("`tests/fixtures/lang` holds no `" ++ name ++ ".ply`"),
  }

type Annotation = { test: String, text: String }

/// Every `// <word> <first> :: <second>` line of a fixture.
fn annotations(source: String, word: String) -> List<Annotation> / {abort.raise} =
  source.split("\n").fold([], |acc: List<Annotation>, line: String| {
    let lead = "// " ++ word ++ " ";
    if !line.starts_with(lead) { acc } else {
      let rest = line.slice(lead.len(), line.len());
      match rest.split_once(" :: ") {
        Some(p) -> acc.push({ test: p.head.trim(), text: p.tail.trim() }),
        None -> panic("`" ++ word ++ " <name> :: <text>`: " ++ line),
      }
    }
  })

/// The message, labels and notes of a diagnostic as one text: the machine labels a span, and
/// compiled code, which has none, says the same in a note.
fn diagnostic_text(d: Json) -> String = {
  let texts = |key: String|
    String::join(
      items(at(d, key)).map(|x: Json| match x { Str(s) -> s, _ -> str(at(x, "message")) }),
      " ",
    );
  str(at(d, "message")) ++ " " ++ texts("labels") ++ " " ++ texts("notes")
}

/// `source` alone, its tests run as `ply test` runs them.
fn tested_alone(source: String) -> RunResult / {PlyProcess, WorkingDirectory, abort.raise} = {
  write_program(source);
  spawned(["test", "--json", "--no-cache"])
}

/// The fixture alone, its raises judged on the C backend.
fn assert_fixture_raises(name: String) -> Unit / {PlyProcess, WorkingDirectory, abort.raise} =
  assert_fixture_failures(name, "raises", "E0502")

/// The fixture alone, each failure its `word` lines state judged on the C backend to be `code`.
fn assert_fixture_failures(
  name: String,
  word: String,
  code: String,
) -> Unit / {PlyProcess, WorkingDirectory, abort.raise} = {
  let source = fixture(name);
  let expected = annotations(source, word);
  assert(expected.len() > 0, Some(name ++ " states no " ++ word));
  assert_report_failures(name, code, expected, tested_alone(source))
}

fn assert_report_failures(
  name: String,
  code: String,
  expected: List<Annotation>,
  ran: RunResult,
) -> Unit / {abort.raise} = {
  let failed = items(at(json_of(ran), "failures"));
  expected.fold((), |u: Unit, e: Annotation| {
    let failure = match failed.filter(|f: Json| str(at(f, "name")) == e.test) {
      [f, ..] -> f,
      [] -> panic(name ++ ": `" ++ e.test ++ "` did not fail: " ++ all_output(ran)),
    };
    let d = at(failure, "diagnostic");
    assert(str(at(d, "code")) == code, Some(name ++ ": `" ++ e.test ++ "`: " ++ json_text(d)));
    assert(
      diagnostic_text(d).contains(e.text),
      Some(name ++ ": `" ++ e.test ++ "` raised without `" ++ e.text ++ "`: " ++ json_text(d)),
    )
  });
  assert(
    failed.len() == expected.len(),
    Some(name ++ ": every failure must be one the fixture states: " ++ all_output(ran)),
  )
}

test "the effects the checker infers are the ones stated" {
  let source = fixture("effects");
  let expected = annotations(source, "effects");
  assert(expected.len() > 0, Some("the fixture states effects"));
  let definitions = items(
    at(json_of(in_memory(one_module_tree(source), ["check", "--json"])), "definitions"),
  );
  expected.fold((), |u: Unit, e: Annotation| {
    let name = "m." ++ e.test;
    match definitions.filter(|d: Json| str(at(d, "name")) == name) {
      [d, ..] ->
        assert(
          "{" ++ String::join(items(at(d, "effects")).map(str), ", ") ++ "}" == e.text,
          Some("`" ++ name ++ "`: " ++ json_text(d)),
        ),
      [] -> panic("`" ++ name ++ "` is not reported"),
    }
  })
}

test/nondet "numeric operations such as overflow and division by zero raise errors, and the fixture program's `raise` checks pass" { assert_fixture_raises("numbers_raise") }

test/nondet "shift and overflow operations on integers raise errors, and the fixture program's `raise` checks pass" { assert_fixture_raises("bits_raise") }

test/nondet "a value too wide for its integer type fails with E0502, however the value is bound" {
  assert_fixture_raises("widths_raise")
}

test/nondet "byte builtins given invalid arguments, such as an out-of-range index, raise errors, and the fixture program's `raise` checks pass" { assert_fixture_raises("bytes_raise") }

test/nondet "list updates with invalid arguments, such as an out-of-range index, raise errors, and the fixture program's `raise` checks pass" { assert_fixture_raises("lists_raise") }

test/nondet "a `raise` with no matching handler clause fails its test with E0502, naming the operation and its arguments" {
  assert_fixture_raises("unhandled_raise")
}

test/nondet "in a spawned task, a handler clause that exits a handle it did not open is rejected, and an unhandled `raise` ends the task" {
  assert_fixture_raises("task_handles")
}

test/nondet "an operation that no handler handles ends the run with E0424 and names the operation" {
  assert_fixture_failures("unserved", "refused", "E0424")
}

test "a `?` inside a `with_scope` block is rejected, because it would return from the function out of the scope" {
  let source =
    \\fn free(x: Int) -> Unit = ()
    \\
    \\fn positive(n: Int) -> Option<Int> = if n > 0 { Some(n) } else { None }
    \\
    \\pub fn held(n: Int) -> Option<Int> =
    \\  with_scope[r](1, free) { h -> Some(positive(n)? + h.get()) }
    \\
  ;
  let report = json_of(in_memory(one_module_tree(source), ["check", "--json"]));
  assert_eq(items(at(report, "diagnostics")).map(|d: Json| str(at(d, "code"))), ["E0118"])
}
