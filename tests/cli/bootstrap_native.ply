//! `ply bootstrap`: a native `ply` is built only from a checkout whose `ply.work` places its parts,
//! and only against a runtime's library that links; a bootstrap that cannot do either writes nothing.
//! `--identity` names how this `ply` bootstraps, and builds nothing.

import harness (fresh, spawned, working, stderr, write, Here)
import std.fs (fs)

/// The line of a bootstrap of the working directory against no runtime's library.
fn line() -> List<String> / {Here, abort.raise} =
  [
    "bootstrap",
    working(),
    "--runtime",
    working() ++ "/no-such-runtime.a",
    "--out",
    working() ++ "/ply",
  ]

test/nondet "a checkout with no `ply.work` is refused before anything is built" {
  fresh();
  let r = spawned(line());
  assert(r.code != 0, Some("a `ply` was built from a checkout that places nothing"));
  assert(stderr(r).contains("no `ply.work`"), Some(stderr(r)));
  assert(fs.read_file[cwd]("ply") == None, Some("a refused bootstrap wrote a `ply`"))
}

test/nondet "a bootstrap against a runtime's library that does not link refuses, and writes nothing" {
  fresh();
  write(
    "ply.work",
    "import std.pkg (Workspace)\n\nfn workspace() -> Workspace = {\n  packages: [],\n  suites: [],\n  fixtures: [],\n  toolchain: Some({\n    std: \"std\",\n    std_tests: \"std-tests\",\n    compiler: \"compiler\",\n    cli: \"cli\",\n    entry: \"ply.main\",\n    cli_tests: \"cli-tests\",\n    runtime: \"ply-runtime\",\n  }),\n}\n",
  );
  let r = spawned(line());
  assert(r.code != 0, Some("a `ply` was built against no runtime"));
  assert(stderr(r).contains("does not link"), Some(stderr(r)));
  assert(fs.read_file[cwd]("ply") == None, Some("a refused bootstrap wrote a `ply`"))
}

test/nondet "`--identity` prints one line, the same each time, and builds nothing" {
  fresh();
  let before = fs.list_dir[cwd](".");
  let first = spawned(["bootstrap", "--identity"]);
  assert_eq(first.code, 0);
  assert_eq(first.out.len(), 1);
  assert_eq(spawned(["bootstrap", "--identity"]).out, first.out);
  assert_eq(fs.list_dir[cwd]("."), before)
}
