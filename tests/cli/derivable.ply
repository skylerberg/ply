//! `where derivable(..)`: a constraint nothing can satisfy is refused at the boundary, one that can
//! be is assumed inside the body, an inferred map key is checked like a written one, the constraint
//! is in the hash and its spelling is not, a type's own `where` holds wherever the type is written
//! or built, and a derivation cannot be hijacked by the deriving module.

import harness (scratch, in_memory, on_disk, one, program, said, stdout, json_of, at, items, str,
                int, nth, path, shown, Hermetic, Reached, Shipped)
import std.json (Json)
import std.string

/// What a check that refused the source said, and nothing for one that took it.
fn codes_of(source: String) -> List<String> / {Hermetic, Shipped, abort.raise, diverges} = {
  let answer = json_of(in_memory(one(source), ["check", "--json"]));
  if int(at(answer, "exit_code")) == 0 { [] }
  else { items(at(answer, "diagnostics")).map(|d: Json| str(at(d, "code"))) }
}

fn refuses_with(source: String, code: String) -> Bool / {Hermetic, Shipped, abort.raise, diverges} =
  codes_of(source).filter(|c: String| c == code).len() > 0

fn hashes(source: String) -> List<String> / {Hermetic, Shipped, abort.raise, diverges} =
  items(at(json_of(in_memory(one(source), ["hash", "--json"])), "definitions")).map(|d: Json|
    str(at(d, "hash")))

fn run_main(source: String) -> String / {Reached, Shipped, abort.raise, diverges} = {
  program(source);
  let r = on_disk(["run"]);
  assert(r.code == 0, Some("the fixture did not run:\n" ++ said(r)));
  said(r).trim()
}

// Each must be `E0206` statically, at the call site or the signature, never something that checks
// and fails deeper.
test "no unsatisfiable constraint is accepted at a boundary" {
  let needs = "fn needs<a>(x: a) -> Int where derivable(ord, a) = 1\n";
  let attempts = [
    // Directly.
    needs ++ "fn go() -> Int = needs(1.5)",
    // Under a container the signature writes.
    "fn needs<a>(xs: List<a>) -> Int where derivable(ord, a) = 1\nfn go() -> Int = needs([1.5])",
    // Through a first-class use, where the constraint could be lost with the function's name.
    needs
      ++ "fn apply(f: (Float) -> Int, x: Float) -> Int = f(x)\nfn go() -> Int = apply(needs, 1.5)",
    // Through a lambda, same question with a different binder.
    needs ++ "fn go() -> Int = { let f = |x: Float| needs(x); f(1.5) }",
    // A body assuming one constraint that calls something needing another.
    needs ++ "fn caller<a>(x: a) -> Int where derivable(eq, a) = needs(x)",
    // A `Float` behind a nominal declaration.
    "type Money = Cents(Float)\n" ++ needs ++ "fn go() -> Int = needs(Cents(1.5))",
    // Behind a recursive declaration.
    "type Chain = Nil | Link(Float, Chain)\n" ++ needs ++ "fn go() -> Int = needs(Nil)",
    // Behind a type parameter of a declaration.
    "type Box<a> = B(a)\n" ++ needs ++ "fn go() -> Int = needs(B(1.5))",
    // Two constrained hops, so the failure has to travel.
    "type Money = Cents(Float)\nfn inner<a>(x: a) -> Int where derivable(ord, a) = 1\n"
      ++ "fn outer<a>(x: a) -> Int where derivable(ord, a) = inner(x)\n"
      ++ "fn go() -> Int = outer(Cents(1.5))",
  ];
  attempts.fold((), |u: Unit, source: String|
    assert(
      refuses_with(source, "E0206"),
      Some(
        "accepted a constraint it cannot satisfy (codes: " ++ String::join(codes_of(source), ", ")
          ++ ") in:\n"
          ++ source,
      ),
    ))
}

// A credential has no text, whatever it holds, so interpolating one is refused where it is written.
test "a secret of bytes or of a string is not interpolated" {
  ["Secret<Bytes>", "Secret<String>"].fold((), |u: Unit, t: String| {
    let source = "fn f(s: " ++ t ++ ") -> String = f\"{s}\"";
    assert(
      refuses_with(source, "E0206"),
      Some("interpolated `" ++ t ++ "` (codes: " ++ String::join(codes_of(source), ", ") ++ ")"),
    )
  })
}

test "a satisfiable constraint is assumed inside the body" {
  let sources = [
    "fn needs<a>(x: a) -> Int where derivable(ord, a) = 1\nfn go() -> Int = needs(1)",
    "fn keyed<k>(x: k) -> Map<k, Int> where derivable(ord, k) = Map::new().insert(x, 1)\n"
      ++ "fn go() -> Int = keyed(\"a\").len()",
    "fn inner<a>(x: a) -> Int where derivable(ord, a) = 1\n"
      ++ "fn outer<a>(x: a) -> Int where derivable(ord, a) = inner(x)\nfn go() -> Int = outer(1)",
    "type Money = Cents(Decimal)\nfn needs<a>(x: a) -> Int where derivable(ord, a) = 1\n"
      ++ "fn go() -> Int = needs(Cents(1.5m))",
  ];
  sources.fold((), |u: Unit, source: String|
    assert(codes_of(source) == [], Some("a satisfiable constraint was refused in:\n" ++ source)))
}

// Checked wherever the key type is inferred, where a check on the surface syntax would miss it.
test "an inferred map key is checked like a written one" {
  let sources = [
    "fn go() -> Int = Map::new().insert(1.5, 1).len()",
    "type Money = Cents(Float)\nfn go() -> Int = Map::new().insert(Cents(1.5), 1).len()",
    "fn go() -> Int = Map::of_entries([{key: 1.5, value: 1}]).len()",
    "fn go() -> Int = Map::new().insert({rate: 1.5}, 1).len()",
    "fn go() -> Int = Map::new().insert([1.5], 1).len()",
  ];
  sources.fold((), |u: Unit, source: String|
    assert(refuses_with(source, "E0206"), Some("a `Float` reached a map key in:\n" ++ source)));
  // The control: a `Float` *value* is fine, because only the key is ordered.
  assert(
    codes_of("fn go() -> Int = Map::new().insert(\"k\", 1.5).len()") == [],
    Some("a `Float` value was refused"),
  )
}

// An alias may name a `Map` keyed by its own parameter: a signature naming it at a parameter of its
// own is held to the key's order, and one naming it at a key with no order is refused where it named
// the alias, not at the alias.
test "an alias keyed by its parameter is refused where a use names an unordered key" {
  let alias = "pub type Set<a> = Map<a, Unit>\n";
  assert(
    codes_of(alias ++ "pub fn size<a>(s: Set<a>) -> Int = s.len()") == [],
    Some("a use implying the constraint was refused"),
  );
  let answer = json_of(
    in_memory(one(alias ++ "pub fn size(s: Set<Float>) -> Int = s.len()"), ["check", "--json"]),
  );
  let d = nth(at(answer, "diagnostics"), 0);
  assert(str(at(d, "code")) == "E0206", Some(shown(answer)));
  assert(int(path(nth(at(d, "labels"), 0), ["start", "line"])) == 2, Some(shown(answer)))
}

// A declared type that keys a `Map` by its parameter carries the parameter's order, as `std.set`'s
// does: a signature naming it writes no `where`, and a caller that cannot meet it is refused.
test "a set literal is std.set's set, whose type carries its elements' order" {
  assert(
    codes_of(
        "import std.set\nimport std.set (Set)\npub fn least<a>(s: Set<a>) -> Option<a> = s.min()\npub fn two() -> Set<Int> = #[2, 1]",
      )
      == [],
    Some("a signature naming a set was held to write its order"),
  );
  assert(
    refuses_with(
      "import std.set\nimport std.set (Set)\npub fn floats() -> Set<Float> = Set::empty()",
      "E0206",
    ),
    Some("a set of floats was accepted"),
  );
  assert(
    refuses_with("pub fn m() -> Map<Int, Unit> = #[1]", "E0201"),
    Some("a set literal was taken for a map"),
  )
}

// A `where` clause narrows what a signature admits; if the hash ignored it, a caller would never be
// rechecked.
test "a constraint is in the hash and its spelling is not" {
  let bare = hashes("fn f<a>(x: a) -> Int = 1\n");
  let constrained = hashes("fn f<a>(x: a) -> Int where derivable(ord, a) = 1\n");
  assert(bare != constrained, Some("adding a `where` moved no hash"));
  assert(
    hashes("fn f<a>(x: a) -> Int where derivable(ord, a), derivable(eq, a) = 1\n")
      == hashes("fn f<a>(x: a) -> Int where derivable(eq, a), derivable(ord, a) = 1\n"),
    Some("reordering two `where` clauses moved a hash"),
  );
  assert(
    constrained == hashes("fn f<t>(x: t) -> Int where derivable(ord, t) = 1\n"),
    Some("renaming the constrained type parameter moved a hash"),
  )
}

// A control, so the two failures below are about hijacking rather than broken derivation.
test "a derivation composed through the module binder is canonical" {
  scratch(|| {
    let printed = run_main(
      \\import std.json
      \\pub type Order = { id: Int, note: String }
      \\derive json for Order
      \\pub fn main() -> String / {abort.raise} = json::to_string((order_json().encode)({id: 1, note: "hi"}))
      \\
    );
    assert(
      printed.contains("\\\"id\\\":1") && printed.contains("\\\"note\\\":\\\"hi\\\""),
      Some("the canonical encoding is not what came out: " ++ printed),
    )
  })
}

test "a derived JSON codec cannot be supplied by the deriving module" {
  scratch(|| {
    let printed = run_main(
      \\import std.json
      \\import std.json (Json, JsonCodec, Str, object, field, decode_error, to_string)
      \\pub type Order = { id: Int, note: String }
      \\derive json for Order
      \\fn string_json() -> JsonCodec<String> = {
      \\  encode: |s: String| Str("HIJACKED"),
      \\  decode: |j: Json| Err(decode_error("no")),
      \\}
      \\fn int_json() -> JsonCodec<Int> = {
      \\  encode: |i: Int| Str("ALSO HIJACKED"),
      \\  decode: |j: Json| Err(decode_error("no")),
      \\}
      \\pub fn main() -> String / {abort.raise} = to_string((order_json().encode)({id: 1, note: "hi"}))
      \\
    );
    assert(
      !printed.contains("HIJACKED"),
      Some("the deriving module supplied the leaf codecs its own derivation used: " ++ printed),
    )
  })
}

// --- A type's `where` ---------------------------------------------------------------------------

// A type states a constraint on a parameter: a signature that names the type at a parameter of its
// own writes no `where`, its body assumes the constraint, and its callers meet it.
test "a type's where is assumed by a signature that names the type" {
  let game = "pub type Game<a> where derivable(eq, a) = { same: (a, a) -> Bool }\n";
  assert(
    codes_of(game ++ "pub fn same<a>(g: Game<a>, x: a, y: a) -> Bool = x == y") == [],
    Some(
      "a signature naming the type was held to write its constraint (codes: "
        ++ String::join(
          codes_of(game ++ "pub fn same<a>(g: Game<a>, x: a, y: a) -> Bool = x == y"),
          ", ",
        )
        ++ ")",
    ),
  );
  // The constraint is viral no further than the type: a caller at a type that cannot meet it is
  // refused where it calls, though the game's own module never named that type.
  let answer = json_of(
    in_memory(
      one(
        game ++ "pub fn same<a>(g: Game<a>, x: a, y: a) -> Bool = x == y\n"
          ++ "fn go() -> Bool = same({ same: |f: (Int) -> Int, g: (Int) -> Int| true }, |a: Int| a, |b: Int| b)",
      ),
      ["check", "--json"],
    ),
  );
  let d = nth(at(answer, "diagnostics"), 0);
  assert(str(at(d, "code")) == "E0206", Some(shown(answer)));
  assert(
    str(path(nth(at(d, "labels"), 0), ["message"])).contains("requires `derivable(eq, ·)`"),
    Some(shown(answer)),
  );
  // A signature may still write what the type implies; it adds nothing and is no error.
  assert(
    codes_of(
        game ++ "pub fn same<a>(g: Game<a>, x: a, y: a) -> Bool where derivable(eq, a) = x == y",
      )
      == [],
    Some("a written constraint the type implies was refused"),
  );
  // The constraint is in the hash of what names the type, and its spelling is not: a use rechecks
  // when it moves.
  let uses = "pub fn make<a>(s: keep (a, a) -> Bool) -> Game<a> = { same: s }\n";
  assert(
    hashes(game ++ uses) != hashes("pub type Game<a> = { same: (a, a) -> Bool }\n" ++ uses),
    Some("adding a type's `where` moved no hash"),
  );
  assert(
    hashes(game ++ uses)
      == hashes(
        "pub type Game<b> where derivable(eq, b) = { same: (b, b) -> Bool }\n"
          ++ "pub fn make<b>(s: keep (b, b) -> Bool) -> Game<b> = { same: s }\n",
      ),
    Some("renaming the constrained type parameter moved a hash"),
  )
}

// The monte carlo case: a game built at a choice type with no equality fails where it is built,
// not where the search runs.
test "a constrained alias is met wherever it is named" {
  let sources = [
    // Written in a signature at a concrete argument.
    "pub type Game<a> where derivable(eq, a) = { same: (a, a) -> Bool }\n"
      ++ "fn bad(g: Game<(Int) -> Int>) -> Int = 1",
    // Carried into a caller through the return type alone.
    "pub type Game<a> where derivable(eq, a) = { same: (a, a) -> Bool }\n"
      ++ "pub fn perfect<a>(same: keep (a, a) -> Bool) -> Game<a> = { same: same }\n"
      ++ "fn go() -> Game<(Int) -> Int> = perfect(|x: Int, y: Int| x == y)",
  ];
  sources.fold((), |u: Unit, source: String|
    assert(
      refuses_with(source, "E0206"),
      Some("a constraint nothing can satisfy was accepted in:\n" ++ source),
    ))
}

// A sum or a `new` record whose fields mention a constrained type at a parameter of its own
// carries the constraint, as it carries a `Map` key's order: a signature naming it assumes the
// constraint, and a build at a type that cannot meet it is refused.
test "a declaration carries a field's stated constraint" {
  let node = "pub type Game<a> where derivable(eq, a) = { same: (a, a) -> Bool }\n"
    ++ "pub opaque type Node<a> = | Node(Game<a>, List<Node<a>>)\n";
  assert(
    codes_of(node ++ "pub fn find<a>(n: Node<a>, x: a, y: a) -> Bool = x == y") == [],
    Some("a signature naming the carrying type was held to write the constraint"),
  );
  assert(
    refuses_with(
      node ++ "pub fn find<a>(n: Node<a>, x: a, y: a) -> Bool = x == y\n"
        ++ "fn go() -> Bool = find(Node({ same: |f: (Int) -> Int, g: (Int) -> Int| true }, []), |a: Int| a, |b: Int| b)",
      "E0206",
    ),
    Some("a node built at a function was accepted"),
  );
  // Through a `new` record the same way.
  let boxed = "pub type Game<a> where derivable(eq, a) = { same: (a, a) -> Bool }\n"
    ++ "pub type Boxed<a> = new { game: Game<a> }\n";
  assert(
    codes_of(boxed ++ "pub fn find<a>(b: Boxed<a>, x: a, y: a) -> Bool = x == y") == [],
    Some("a signature naming the `new` record was held to write the constraint"),
  );
  // And a declaration that states the constraint itself reads its own fields with it assumed.
  assert(
    codes_of(
        "pub opaque type Node<a> where derivable(eq, a) = | Node(List<Node<a>>, a)\n"
          ++ "pub fn has<a>(n: Node<a>, x: a) -> Bool = match n { Node(_, here) -> here == x }",
      )
      == [],
    Some("a recursive declaration's own constraint was not assumed"),
  )
}

// A `key` function is called with the value alone, so it may need no more than the type carries:
// what the type's `where` states is met wherever two are compared.
test "a key function may need what the type states" {
  let node = "pub opaque type Node<a> where derivable(eq, a) = | Node(a, List<Node<a>>)\n"
    ++ "pub fn head<a>(n: Node<a>) -> a = match n { Node(x, _) -> x }\n";
  assert(
    codes_of(node ++ "key for Node by head\n") == [],
    Some("a key needing what the type states was refused"),
  );
  assert(
    refuses_with(
      "pub opaque type Node<a> where derivable(eq, a) = | Node(a, List<Node<a>>)\n"
        ++ "pub fn head<a>(n: Node<a>) -> a where derivable(ord, a) = match n { Node(x, _) -> x }\n"
        ++ "key for Node by head\n",
      "E0218",
    ),
    Some("a key needing an order the type does not state was accepted"),
  )
}

// What a type's `where` writes is checked like a signature's: the parameter must be one of the
// type's own, and no predicate can state of a type.
test "a type's where names its own parameters and no predicate" {
  assert(
    refuses_with("type X<a> where derivable(eq, b) = a", "E0102"),
    Some("a constraint on a name the type does not bind was accepted"),
  );
  assert(
    refuses_with("type X<a> where numeric(a) = a", "E0102"),
    Some("a predicate on a type was accepted"),
  )
}
