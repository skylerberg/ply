import spawning.harness (WorkingDirectory, PlyProcess, spawned, write_program, value_of)
import std.string

fn run_main(source: String) -> String / {PlyProcess, WorkingDirectory, abort.raise} = {
  write_program(source);
  value_of(spawned(["run", ".", "--json"]))
}

test/nondet "`derive json` encodes a record correctly when `std.json` is imported by its module name" {
  let encoded = run_main(
    \\import std.json
    \\pub type Order = { id: Int, note: String }
    \\derive json for Order
    \\pub fn main() -> String / {abort.raise} = json::to_string((order_json().encode)({id: 1, note: "hi"}))
    \\
  );
  assert(
    encoded.contains("\\\"id\\\":1") && encoded.contains("\\\"note\\\":\\\"hi\\\""),
    Some("the canonical encoding is not what came out: " ++ encoded),
  )
}

test/nondet "a derived JSON codec cannot be supplied by the deriving module" {
  let encoded = run_main(
    \\import std.json
    \\import std.json (Json, JsonCodec, Str, object, field, decode_error, to_string)
    \\pub type Order = { id: Int, note: String }
    \\derive json for Order
    \\fn string_json() -> JsonCodec<String> = {
    \\  encode: |s: String| Str("HIJACKED"),
    \\  decode: |j: Json| Err(decode_error("no")),
    \\}
    \\fn int_json() -> JsonCodec<Int> = {
    \\  encode: |i: Int| Str("ALSO HIJACKED"),
    \\  decode: |j: Json| Err(decode_error("no")),
    \\}
    \\pub fn main() -> String / {abort.raise} = to_string((order_json().encode)({id: 1, note: "hi"}))
    \\
  );
  assert(
    !encoded.contains("HIJACKED"),
    Some("the deriving module supplied the leaf codecs its own derivation used: " ++ encoded),
  )
}
