//! A service stopped by a signal: it drains what is in flight within `--drain-ms`, says what it
//! abandoned when it cannot, and a second signal ends it at once.

import harness (spawned, Server, write_project, repo_file, reserve_port, start_server, connected,
                connection, dial, send, read_until_closed, hang_up, signal_to, wait_for_exit, stop,
                completed_result, all_output, stdout, stderr, at, path, items, str, int, json_text,
                WorkingDirectory, Repo, PlyProcess, Network, Clock)
import std.json
import std.json (Json)
import std.net
import std.net (net)
import std.process (Exited, Signalled, Terminate)
import std.string
import std.time (time)
import std.list

/// The status line and headers both programs respond with, as Ply source. The `HEAD` token in the
/// sources below is replaced with it, so an edit cannot leave the two responses disagreeing.
fn response_head() -> String =
  \\b"HTTP/1.1 200 OK\r\nConnection: close\r\nX-Test-Nonce: NONCE\r\nContent-Length: "

fn server_source() -> String =
  \\import std.net
  \\import std.net (net)
  \\import std.signal (signal)
  \\
  \\// What a readiness probe reads. Its effects say exactly what it consults, and a
  \\// route with no effects is a route that checks nothing.
  \\pub fn body() -> Bytes / {signal.read} =
  \\  if signal.stopping() { b"draining" } else { b"ok" }
  \\
  \\fn answer(c: Int) -> Unit / {net.write[conn], signal.read, abort.raise} = {
  \\  let _ = net.recv[conn](c, 4096, 20000);
  \\  let payload = body();
  \\  let head = Bytes::concat(
  \\    HEAD,
  \\    Bytes::of_string(payload.len().to_string()).concat(b"\r\n\r\n"));
  \\  let _ = net::send_all[conn](c, head.concat(payload), 20000);
  \\  net.close[conn](c)
  \\}
  \\
  \\fn serve(l: Int, served: Int) -> Int / {net.write[listener], net.write[conn], signal.read, abort.raise, diverges} = {
  \\  let c = net.accept[listener](l);
  \\  if c == 0 {
  \\    served
  \\  } else {
  \\    answer(c);
  \\    serve(l, served + 1)
  \\  }
  \\}
  \\
  \\fn main() -> Int / {net.write[listener], net.write[conn], signal.read, abort.raise, diverges} = {
  \\  let l = net.listen[listener](PORT);
  \\  let served = serve(l, 0);
  \\  net.close[listener](l);
  \\  served
  \\}
  \\

fn port_attempts() -> Int = 3

/// A token this test's server echoes in its response, so a probe cannot read another run's server
/// on the same port as this one.
fn nonce(port: Int) -> String / {time.elapsed_us} =
  port.to_string() ++ "-" ++ time.elapsed_us().to_string()

fn the_request() -> Bytes = b"GET / HTTP/1.1\r\nHost: x\r\n\r\n"

/// A whole request and everything said back, `c` then closed.
fn request(c: Int) -> String / {Network, abort.raise, diverges} = {
  send(c, the_request());
  read_until_closed(c, 20000)
}

fn start(
  flags: List<String>,
) -> Server / {Network, PlyProcess, WorkingDirectory, Clock, abort.raise, diverges} =
  start_with(server_source(), flags)

/// Retries on a fresh port if this one was taken before `ply run` could claim it.
fn start_with(
  source: String,
  flags: List<String>,
) -> Server / {Network, PlyProcess, WorkingDirectory, Clock, abort.raise, diverges} =
  attempt(source, flags, [])

fn attempt(
  source: String,
  flags: List<String>,
  rejected: List<String>,
) -> Server / {Network, PlyProcess, WorkingDirectory, Clock, abort.raise, diverges} =
  if rejected.len() == port_attempts() {
    panic(
      "`ply run` never responded to a probe, on " ++ port_attempts().to_string() ++ " ports:\n\n"
        ++ String::join(rejected, "\n\n"),
    )
  } else {
    let port = reserve_port();
    let token = nonce(port);
    let text = source.replace("HEAD", response_head()).replace("PORT", port.to_string()).replace(
      "NONCE",
      token,
    );
    write_project([{ path: "main.ply", text: text }]);
    let server = start_server(["run"].concat(flags), [], port);
    // The probe is a whole request and response, and the response has to carry this test's token.
    let probed = connected(server, |c: Int| {
      send(c, the_request());
      String::of_bytes_lossy(net::drain[client](c, b"", 20000)).contains(token)
    });
    match probed {
      Ok(c) -> {
        hang_up(c);
        server
      },
      Err(reason) -> {
        stop(server);
        attempt(source, flags, rejected.push(reason))
      },
    }
  }

/// What `fixture` hands back: the server, and the connection that found it listening.
type ServerConnection = { server: Server, first_connection: Int }

/// `tests/fixtures/<name>.ply` as committed, told its port by the setting `port_key`. It cannot echo
/// a token, so the connection that found it listening is handed back as the test's own.
fn fixture(
  name: String,
  port_key: String,
  flags: List<String>,
) -> ServerConnection / {Network, PlyProcess, WorkingDirectory, Repo, Clock, abort.raise, diverges} = {
  let port = reserve_port();
  let file = name ++ ".ply";
  write_project([{ path: file, text: repo_file("tests/fixtures/" ++ file) }]);
  let server = start_server(
    ["run"].concat(flags).concat(["--set", port_key ++ "=" ++ port.to_string()]),
    [],
    port,
  );
  { server: server, first_connection: connection(server) }
}

/// A connection of the test's own to the running server.
fn connect(server: Server) -> Int / {Network, PlyProcess, abort.raise} =
  match dial(server.port, 5000) {
    Some(c) -> c,
    None -> {
      stop(server);
      panic("the server is not listening on " ++ server.port.to_string())
    },
  }

/// How the run ended, and everything it wrote, where `W0608` and, under `--explain`, the shutdown
/// banner land.
type RunOutput = { code: Int, out: String, err: String }

fn output(d: RunOutput) -> String = d.out ++ d.err

/// A signal's death is `-1`: a killed run did not drain.
fn finish(server: Server) -> RunOutput / {PlyProcess, abort.raise} = {
  let f = wait_for_exit(
    server,
    60000,
    "the run never exited, so the drain hung rather than being bounded",
  );
  let r = completed_result(f);
  { code: match f.ended { Exited(c) -> c, Signalled(_) -> -1 }, out: stdout(r), err: stderr(r) }
}

// Two runs can be handed the same port, and the loser of the bind responds to the winner's probe
// with what looks like readiness. The token in the response is what tells them apart, so this holds
// `ready` to it rather than to the status line.
test/nondet "a 200 OK from another server is not readiness" {
  let decoy = net.listen[decoy](0);
  let port = match net.local_port[decoy](decoy) { Some(p) -> p, None -> panic("a decoy port") };
  let probe = match dial(port, 5000) { Some(c) -> c, None -> panic("the decoy listens") };
  send(probe, the_request());
  let c = net.accept[decoy](decoy);
  let _ = net.recv[decoy](c, 4096, 5000);
  let _ = net::send_all[decoy](c, b"HTTP/1.1 200 OK\r\nConnection: close\r\n\r\nok", 5000);
  net.close[decoy](c);
  net.close[decoy](decoy);
  let result = read_until_closed(probe, 5000);
  assert(
    result.contains("200 OK"),
    Some("the decoy did not respond to the probe, so this test proves nothing: " ++ result),
  );
  assert(
    !result.contains("the-token-this-test-asked-for"),
    Some("a server that is not this test's read as ready:\n\n" ++ result),
  )
}

test/nondet "a request in flight at the signal gets its response and the run exits zero" {
  let server = start(["--drain-ms", "30000", "--explain"]);
  let held = connect(server);
  // The server is inside `net.recv` with a 20s deadline, so the signal lands with a request in
  // flight.
  time.sleep_ms(200);
  signal_to(server, Terminate);
  time.sleep_ms(200);
  let result = request(held);
  assert(
    result.contains("200 OK"),
    Some("the in-flight request was dropped by the drain: " ++ result),
  );
  assert(
    result.ends_with("draining"),
    Some(
      "the route read the stop flag and responded `" ++ result
        ++ "`, so `signal.stopping()` did not reach the handler",
    ),
  );
  let done = finish(server);
  assert(done.code == 0, Some("a clean drain exits 0\n\n" ++ output(done)));
  assert(
    !output(done).contains("W0608"),
    Some("a drain that finished reported the deadline expiring\n\n" ++ output(done)),
  );
  assert(
    output(done).contains("stopping"),
    Some("under `--explain` a stopping service prints what it is doing\n\n" ++ output(done)),
  );
  assert(
    output(done).contains("1 listener(s) closed"),
    Some("the banner reports the listener the run actually closed\n\n" ++ output(done)),
  );
  assert(
    output(done).contains("1 connection(s) in flight"),
    Some("the banner reports the connection that was actually open\n\n" ++ output(done)),
  )
}

test/nondet "a connection opened after the stop gets no response" {
  let server = start(["--drain-ms", "30000"]);
  assert(request(connect(server)).contains("200 OK"), None);
  signal_to(server, Terminate);
  // The stop dials the parked `accept` awake and it returns `0`, so this connection is refused or
  // accepted and closed.
  time.sleep_ms(400);
  match dial(server.port, 500) {
    Some(late) -> {
      let _ = net::send_all[client](late, the_request(), 3000);
      let result = read_until_closed(late, 3000);
      assert(
        result == "",
        Some("a connection opened after the run stopped accepting got a response " ++ result),
      )
    },
    None -> (),
  };
  let done = finish(server);
  assert(done.code == 0, Some(output(done)))
}

// There is no cancellation, so the task is not unwound and is not handed a `503`.
test/nondet "a drain that expires reports W0608 and exits three" {
  let server = start(["--drain-ms", "300"]);
  let held = connect(server);
  // Held open and silent inside a 20s `net.recv`, so this request cannot finish inside a 300ms
  // drain.
  time.sleep_ms(200);
  signal_to(server, Terminate);
  let result = read_until_closed(held, 30000);
  assert(
    result == "",
    Some(
      "Ply has no cancellation, so a request live at the deadline gets nothing rather than a partial response; this client read "
        ++ result,
    ),
  );
  let done = finish(server);
  assert(
    done.code == 3,
    Some("a drain that dropped requests must not report success\n\n" ++ output(done)),
  );
  assert(
    output(done).contains("W0608"),
    Some("the run exited 3 and never said why\n\n" ++ output(done)),
  );
  assert(
    output(done).contains("drain-ms"),
    Some("`W0608` has to say what to do about it\n\n" ++ output(done)),
  )
}

// `tests/fixtures/drain_incomplete.ply`: a head announcing a body that never comes keeps its
// request reading for up to the program's `body_timeout_ms`, and a 300ms drain cannot wait that
// out.
test/nondet "the drain fixture abandons a request still reading its body" {
  let f = fixture("drain_incomplete", "DRAIN_PORT", ["--json", "--drain-ms", "300"]);
  send(f.first_connection, b"POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n\r\n");
  time.sleep_ms(200);
  signal_to(f.server, Terminate);
  let result = read_until_closed(f.first_connection, 30000);
  assert(
    result == "",
    Some("a request live at the deadline is closed with no response; this client read " ++ result),
  );
  let done = finish(f.server);
  let report = match json::parse_string(done.out) {
    Ok(j) -> j,
    Err(e) ->
      panic(
        "`--json` writes one document on stdout: " ++ json::error_to_string(e) ++ "\n"
          ++ output(done),
      ),
  };
  assert(done.code == 3, Some(json_text(report)));
  assert(int(at(report, "exit_code")) == 3, Some(json_text(report)));
  assert(str(path(report, ["shutdown", "signal"])) == "TERM", Some(json_text(report)));
  assert(int(path(report, ["shutdown", "drain_ms"])) == 300, Some(json_text(report)));
  let diagnostics = items(at(report, "diagnostics"));
  assert(
    diagnostics.filter(|d: Json| str(at(d, "severity")) == "error").len() == 0,
    Some("the expired drain is the run's only failure: " ++ json_text(report)),
  );
  let drained = match diagnostics.filter(|d: Json| str(at(d, "code")) == "W0608") {
    [d, ..] -> d,
    [] -> panic("the run exited 3 and never said why: " ++ json_text(report)),
  };
  assert(str(at(drained, "severity")) == "warning", Some(json_text(drained)));
  assert(str(at(drained, "message")) == "the drain deadline expired", Some(json_text(drained)));
  let notes = items(at(drained, "notes")).map(str);
  [
    "1 connection(s) abandoned with no response written",
    "raise `--drain-ms` above the program's own body_timeout_ms + write_timeout_ms",
  ].fold((), |u: Unit, note: String|
    assert(
      notes.filter(|n: String| n == note).len() > 0,
      Some("`W0608` lacks `" ++ note ++ "`: " ++ json_text(drained)),
    ))
}

test/nondet "a second signal exits immediately and says what it abandoned" {
  let server = start(["--drain-ms", "60000"]);
  let held = connect(server);
  time.sleep_ms(200);
  signal_to(server, Terminate);
  time.sleep_ms(300);
  signal_to(server, Terminate);
  let done = finish(server);
  assert(
    done.code == 143,
    Some(
      "a second SIGTERM exits 128+15, which is the number a supervisor would have read from a process that never caught it\n\n"
        ++ output(done),
    ),
  );
  assert(
    output(done).contains("abandoned"),
    Some("a second signal prints what it cost before it goes\n\n" ++ output(done)),
  );
  hang_up(held)
}

test/nondet "during the lead the run still accepts and already says it is stopping" {
  let server = start(["--drain-ms", "30000", "--drain-lead-ms", "2000", "--explain"]);
  assert(request(connect(server)).ends_with("ok"), Some("not stopping yet"));
  signal_to(server, Terminate);
  time.sleep_ms(300);
  // Inside the lead a new connection is still accepted, and the route reads the flag and sheds.
  let result = request(connect(server));
  assert(
    result.contains("200 OK") && result.ends_with("draining"),
    Some("the lead phase stopped accepting, or the flag had not reached the program: " ++ result),
  );
  let done = finish(server);
  assert(done.code == 0, Some(output(done)));
  assert(
    output(done).contains("lead 2000ms"),
    Some(
      "under `--explain` the run says what it will do on a signal before it does it, so the number can be compared by eye against the program's own body_timeout_ms + write_timeout_ms\n\n"
        ++ output(done),
    ),
  );
  assert(output(done).contains("signals INT TERM"), Some(output(done)))
}

// A stop requested once would end every test after it, a coupling the effects graph cannot see,
// so a test's run listens for none.
test/nondet "a test is never asked to stop" {
  write_project([
    {
      path: "main.ply",
      text: String::of_bytes_lossy(embed("../programs/shutdown/test_not_stopped.ply")),
    },
  ]);
  let r = spawned(["test"]);
  assert(r.code == 0, Some(all_output(r)))
}

/// A task per connection: the shape the drain's unfinished-request case is about.
fn concurrent() -> String =
  \\import std.net
  \\import std.net (net)
  \\import std.signal (signal)
  \\
  \\fn answer(c: Int) -> Int / {net.write[conn], signal.read, abort.raise} = {
  \\  let _ = net.recv[conn](c, 4096, 20000);
  \\  let payload = if signal.stopping() { b"draining" } else { b"ok" };
  \\  let head = Bytes::concat(
  \\    HEAD,
  \\    Bytes::of_string(payload.len().to_string()).concat(b"\r\n\r\n"));
  \\  let _ = net::send_all[conn](c, head.concat(payload), 20000);
  \\  net.close[conn](c);
  \\  1
  \\}
  \\
  \\fn joined(ts: List<Task<Int>>) -> Int / {task.write, abort.raise} =
  \\  match ts { [] -> 0, [t, ..rest] -> task.join(t) + joined(rest) }
  \\
  \\fn serve(l: Int, running: List<Task<Int>>) -> Int
  \\  / {net.write[listener], net.write[conn], signal.read, task.write, abort.raise, diverges} = {
  \\  let c = net.accept[listener](l);
  \\  if c == 0 {
  \\    joined(running)
  \\  } else {
  \\    serve(l, running.push(task.spawn(|| answer(c))))
  \\  }
  \\}
  \\
  \\fn main() -> Int / {net.write[listener], net.write[conn], signal.read, task.write, abort.raise, diverges} = {
  \\  let l = net.listen[listener](PORT);
  \\  let served = serve(l, []);
  \\  net.close[listener](l);
  \\  served
  \\}
  \\

test/nondet "a spawned task still serving at the signal finishes and the run exits zero" {
  let server = start_with(concurrent(), ["--drain-ms", "30000"]);
  let held = connect(server);
  time.sleep_ms(200);
  signal_to(server, Terminate);
  time.sleep_ms(300);
  let result = request(held);
  assert(result.contains("200 OK"), Some("a task in flight at the signal was dropped: " ++ result));
  let done = finish(server);
  assert(done.code == 0, Some("a clean drain exits 0\n\n" ++ output(done)));
  assert(!output(done).contains("W0608"), Some(output(done)))
}

test/nondet "a task blocked on a host handler does not outlast the drain" {
  let server = start_with(concurrent(), ["--drain-ms", "400"]);
  let held = connect(server);
  // Connected and silent: the spawned task is inside `net.recv` and will be for twenty seconds.
  time.sleep_ms(200);
  let signalled = time.elapsed_ms();
  signal_to(server, Terminate);
  let result = read_until_closed(held, 30000);
  assert(
    result == "",
    Some("Ply has no cancellation, so the blocked task is not handed a 503: " ++ result),
  );
  let done = finish(server);
  let waited = time.elapsed_ms() - signalled;
  assert(
    done.code == 3,
    Some("a drain that abandoned a request must not report success\n\n" ++ output(done)),
  );
  assert(
    output(done).contains("W0608"),
    Some("the run exited 3 and never said why\n\n" ++ output(done)),
  );
  // `--drain-ms 400` plus the teardown's floor, plus slack.
  assert(
    waited < 5000,
    Some(
      "the drain waited " ++ waited.to_string()
        ++ "ms, so it was hostage to the host operation rather than bounded by `--drain-ms` plus the teardown's floor\n\n"
        ++ output(done),
    ),
  )
}
