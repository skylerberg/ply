//! `ply test --coverage` and `--mutate`: what no test reaches, and what the tests would let through.

import harness (spawned, write_program, json_of, at, path, nth, items, str, int, json_text, first)
import std.fs (fs, listed_names)
import std.json (Json)

fn source() -> String =
  \\fn add(a: Int, b: Int) -> Int = a + b
  \\fn clamp(n: Int) -> Int = if n < 0 { 0 } else { n }
  \\fn unused(n: Int) -> Int = n * 2 + 0
  \\test "add adds" { assert_eq(add(2, 3), 5); assert_eq(add(0, 1), 1) }
  \\test "clamp keeps a positive" { assert_eq(clamp(5), 5); assert_eq(clamp(-3), 0) }
  \\

fn texts(j: Json) -> List<String> = items(j).map(str)

test/nondet "`ply test --coverage` lists the definitions that no test executes" {
  write_program(source());
  let v = json_of(spawned(["test", "--coverage", "--json"]));
  assert(int(at(v, "exit_code")) == 0, Some(json_text(v)));
  assert_eq(texts(path(v, ["coverage", "unreached"])), ["m.unused"]);
  let add = items(path(v, ["coverage", "definitions"])).filter(|d: Json|
    str(at(d, "name")) == "m.add");
  assert_eq(texts(at(first(add), "reached_by")), ["m.add adds"])
}

test/nondet "a mutant the tests let through survives and fails the run" {
  write_program(source());
  let r = spawned(["test", "--mutate", "clamp", "--json"]);
  let v = json_of(r);
  let m = at(v, "mutants");
  assert(int(at(m, "definitions")) == 1, Some(json_text(m)));
  assert(int(at(m, "killed")) >= 1, Some(json_text(m)));
  assert(int(at(m, "survived")) >= 1, Some(json_text(m)));
  let survivor = nth(at(m, "survivors"), 0);
  assert_eq(str(at(survivor, "definition")), "m.clamp");
  assert_eq(texts(at(survivor, "tests")), ["m.clamp keeps a positive"]);
  assert(int(path(survivor, ["location", "line"])) >= 2, Some(json_text(survivor)));
  assert(int(at(v, "exit_code")) == 1, Some("a survivor fails the run: " ++ json_text(v)));
  assert_eq(r.code, 1)
}

test/nondet "every mutant of a well-tested definition is killed and the cache is untouched" {
  write_program(source());
  assert_eq(spawned(["test"]).code, 0);
  let stored = ||
    List::filter(
      match listed_names(fs.list_dir[cwd](".ply-cache")) { Some(names) -> names, None -> [] },
      |name: String| name.starts_with("manifest-") || name.starts_with("seg-"),
    ).map(|name: String| { name: name, holds: fs.read_file[cwd](".ply-cache/" ++ name) });
  let before = stored();
  let v = json_of(spawned(["test", "--mutate", "m.add", "--json"]));
  let m = at(v, "mutants");
  assert(int(at(m, "survived")) == 0, Some(json_text(m)));
  assert(int(at(m, "killed")) >= 1, Some(json_text(m)));
  assert(int(at(v, "exit_code")) == 0, Some(json_text(v)));
  assert(stored() == before, Some("a mutant left something in the cache"))
}

test/nondet "`ply test --mutate` lists a definition that no test executes instead of mutating it" {
  write_program(source());
  let m = at(json_of(spawned(["test", "--mutate", "--json"])), "mutants");
  assert_eq(texts(at(m, "unreached")), ["m.unused"]);
  assert_eq(int(at(m, "definitions")), 3);
  assert_eq(spawned(["test", "--mutate", "nothing"]).code, 2)
}
