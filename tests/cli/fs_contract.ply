//! Every deterministic test of this suite runs over `MemFs`, so it must answer as the disk does.

import harness (empty_working_directory, in_memory, one_module_tree, json_of, diagnostic_codes,
                write, spawned, items, at, str, json_text)
import std.fs
import std.fs (fs, files, Entry, ScanEntry)
import std.json (Json, Null)
import std.io
import std.io (io, Sink)
import std.random (entropy)
import std.tar
import std.tar (tar)
import std.time (millis, nanos_at, time)

fn bool_text(b: Bool) -> String = if b { "true" } else { "false" }

fn optional_int_text(n: Option<Int>) -> String =
  match n { Some(v) -> v.to_string(), None -> "none" }

fn optional_bytes_text(b: Option<Bytes>) -> String =
  match b { Some(v) -> "\"" ++ String::of_bytes_lossy(v) ++ "\"", None -> "none" }

fn optional_string_text(s: Option<String>) -> String = match s { Some(v) -> v, None -> "none" }

fn names_text(names: Option<List<String>>) -> String =
  match names {
    Some(ns) ->
      "[" ++ ns.fold("", |acc: String, n: String| if acc == "" { n } else { acc ++ " " ++ n })
        ++ "]",
    None -> "none",
  }

fn kind_text(k: fs::Kind) -> String =
  match k {
    fs::File -> "file",
    fs::Dir -> "dir",
    fs::Symlink -> "symlink",
    fs::Missing -> "missing",
  }

fn entries_text(es: Option<List<Entry>>) -> String =
  match es {
    Some(xs) ->
      xs.fold("", |acc: String, e: Entry|
        acc ++ (if acc == "" { "" } else { " " }) ++ e.path ++ ":" ++ kind_text(e.kind)),
    None -> "none",
  }

fn shown_listed(listing: Option<List<fs::Listed>>) -> String =
  match listing {
    Some(xs) ->
      "["
        ++ xs.fold("", |acc: String, l: fs::Listed|
          acc ++ (if acc == "" { "" } else { " " }) ++ l.name ++ ":" ++ kind_text(l.kind))
        ++ "]",
    None -> "none",
  }

fn optional_mode_text(m: Option<fs::Mode>) -> String =
  match m { Some(v) -> fs::mode_text(v), None -> "none" }

/// A temp name is the run's own, so only its shape is compared.
fn temp_dir_text(made: Option<String>, dir: String, prefix: String) -> String / {fs.kind[cwd]} =
  match made {
    Some(p) ->
      "starts " ++ bool_text(p.starts_with(dir ++ "/" ++ prefix)) ++ ", "
        ++ kind_text(fs.kind[cwd](p)),
    None -> "none",
  }

/// The disk's root is wherever the suite started, the twin's `/w`.
fn canonical_text(p: Option<String>, tail: String) -> String =
  match p { Some(v) -> "ends " ++ bool_text(v.ends_with(tail)), None -> "none" }

fn owner_only() -> fs::Mode =
  {
    owner: { read: true, write: true, execute: false },
    group: { read: false, write: false, execute: false },
    other: { read: false, write: false, execute: false },
  }

/// Under `c/`, so the scratch marker is never touched.
fn script() -> List<String> / {fs.read[cwd], fs.write[cwd]} = {
  let made = fs.create_dir[cwd]("c/a/b");
  let again = fs.create_dir[cwd]("c/a/b");
  let wrote = fs.write_file[cwd]("c/a/b/f.txt", b"hello");
  let first = fs.append[cwd]("c/log", b"ab");
  let second = fs.append[cwd]("c/log", b"cd");
  let copied = fs.copy[cwd]("c/log", "c/log2");
  let copied_dir = fs.copy[cwd]("c/a", "c/a2");
  let moved = fs.rename[cwd]("c/log2", "c/a/moved");
  let _x = fs.write_file[cwd]("c/x", b"one");
  let _y = fs.write_file[cwd]("c/y", b"two");
  let over = fs.rename[cwd]("c/x", "c/y");
  let linked = fs.symlink[cwd]("c/link", "a/b/f.txt");
  let moded = fs.set_mode[cwd]("c/a/b/f.txt", owner_only());
  let stamped = fs.set_modified[cwd]("c/a/b/f.txt", 1700000000000);
  let locked = fs.lock[cwd]("c/held.lock");
  let contended = fs.lock[cwd]("c/held.lock");
  let released = fs.unlock[cwd]("c/held.lock");
  let unheld = fs.unlock[cwd]("c/held.lock");
  let temp = fs.temp_dir[cwd]("c", "t-");
  [
    "create_dir c/a/b -> " ++ bool_text(made),
    "create_dir c/a/b again -> " ++ bool_text(again),
    "write_file c/a/b/f.txt -> " ++ bool_text(wrote),
    "read_file c/a/b/f.txt -> " ++ optional_bytes_text(fs.read_file[cwd]("c/a/b/f.txt")),
    "read_file c/nope -> " ++ optional_bytes_text(fs.read_file[cwd]("c/nope")),
    "file_size c/a/b/f.txt -> " ++ optional_int_text(fs.file_size[cwd]("c/a/b/f.txt")),
    "exists c/a/b/f.txt -> " ++ bool_text(fs.exists[cwd]("c/a/b/f.txt")),
    "exists c/nope -> " ++ bool_text(fs.exists[cwd]("c/nope")),
    "kind c/a -> " ++ kind_text(fs.kind[cwd]("c/a")),
    "kind c/a/b/f.txt -> " ++ kind_text(fs.kind[cwd]("c/a/b/f.txt")),
    "kind c/nope -> " ++ kind_text(fs.kind[cwd]("c/nope")),
    "append c/log ab -> " ++ optional_int_text(first),
    "append c/log cd -> " ++ optional_int_text(second),
    "read_at c/log 1 2 -> " ++ optional_bytes_text(fs.read_at[cwd]("c/log", 1, 2)),
    "read_at c/log 3 5 -> " ++ optional_bytes_text(fs.read_at[cwd]("c/log", 3, 5)),
    "read_at c/log 9 2 -> " ++ optional_bytes_text(fs.read_at[cwd]("c/log", 9, 2)),
    "copy c/log c/log2 -> " ++ bool_text(copied),
    "copy c/a c/a2 -> " ++ bool_text(copied_dir),
    "rename c/log2 c/a/moved -> " ++ bool_text(moved),
    "exists c/log2 -> " ++ bool_text(fs.exists[cwd]("c/log2")),
    "read_file c/a/moved -> " ++ optional_bytes_text(fs.read_file[cwd]("c/a/moved")),
    "rename c/x over c/y -> " ++ bool_text(over),
    "read_file c/y -> " ++ optional_bytes_text(fs.read_file[cwd]("c/y")),
    "symlink c/link a/b/f.txt -> " ++ bool_text(linked),
    "kind c/link -> " ++ kind_text(fs.kind[cwd]("c/link")),
    "resolved c/link -> " ++ kind_text(fs.resolved_kind[cwd]("c/link")),
    "read_link c/link -> " ++ optional_string_text(fs.read_link[cwd]("c/link")),
    "read_link c/log -> " ++ optional_string_text(fs.read_link[cwd]("c/log")),
    "read_file c/link -> " ++ optional_bytes_text(fs.read_file[cwd]("c/link")),
    "set_mode c/a/b/f.txt rw------- -> " ++ bool_text(moded),
    "mode c/a/b/f.txt -> " ++ optional_mode_text(fs.mode[cwd]("c/a/b/f.txt")),
    "set_modified c/a/b/f.txt -> " ++ bool_text(stamped),
    "modified_ms c/a/b/f.txt -> " ++ optional_int_text(fs.modified_ms[cwd]("c/a/b/f.txt")),
    "lock c/held.lock -> " ++ bool_text(locked),
    "lock c/held.lock held -> " ++ bool_text(contended),
    "unlock c/held.lock -> " ++ bool_text(released),
    "unlock c/held.lock again -> " ++ bool_text(unheld),
    "temp_dir c t- -> " ++ temp_dir_text(temp, "c", "t-"),
    // Removed before any listing: its name is the run's own.
    "remove_tree the temp dir -> "
      ++ bool_text(match temp { Some(p) -> fs.remove_tree[cwd](p), None -> false }),
    "canonical c/a -> " ++ canonical_text(fs.canonical[cwd]("c/a"), "/c/a"),
    "canonical c/nope -> " ++ canonical_text(fs.canonical[cwd]("c/nope"), "/c/nope"),
    "sync c/log -> " ++ bool_text(fs.sync[cwd]("c/log")),
    "sync c/nope -> " ++ bool_text(fs.sync[cwd]("c/nope")),
    "list_dir c -> " ++ shown_listed(fs.list_dir[cwd]("c")),
    "list_dir c/log -> " ++ shown_listed(fs.list_dir[cwd]("c/log")),
    "list_dir c/nope -> " ++ shown_listed(fs.list_dir[cwd]("c/nope")),
    "walk c/a -> " ++ entries_text(fs.walk[cwd]("c/a")),
    "walk c/log -> " ++ entries_text(fs.walk[cwd]("c/log")),
    "remove c/y -> " ++ bool_text(fs.remove[cwd]("c/y")),
    "remove c/a -> " ++ bool_text(fs.remove[cwd]("c/a")),
    "remove c/nope -> " ++ bool_text(fs.remove[cwd]("c/nope")),
    "remove_tree c -> " ++ bool_text(fs.remove_tree[cwd]("c")),
    "exists c -> " ++ bool_text(fs.exists[cwd]("c")),
  ]
}

/// The first line a script answered otherwise on the disk than over a twin, with both.
pub fn first_difference(disk: List<String>, twin: List<String>) -> Option<String> =
  range(0, max(disk.len(), twin.len())).fold(None, |found: Option<String>, i: Int|
    match found {
      Some(_) -> found,
      None -> {
        let d = match disk.at(i) { Some(l) -> l, None -> "(nothing)" };
        let t = match twin.at(i) { Some(l) -> l, None -> "(nothing)" };
        if d == t { None } else { Some("the disk answered\n  " ++ d ++ "\nand the twin\n  " ++ t) }
      },
    })

test/nondet "the filesystem's twin answers every operation as the disk does" {
  empty_working_directory();
  let disk = script();
  let twin = fs::on_mem(fs::mem_empty(), || script()).value;
  match first_difference(disk, twin) { Some(why) -> panic(why), None -> () }
}

/// The host's own error number is the platform's, so only that there is one is compared.
fn file_error_text(why: fs::FileError) -> String =
  match why {
    fs::NotFound -> "not found",
    fs::Denied -> "denied",
    fs::NotAFile -> "not a file",
    fs::NotADirectory -> "not a directory",
    fs::Exists -> "exists",
    fs::NoSpace -> "no space",
    fs::CrossesRoot -> "crosses root",
    fs::LimitExceeded -> "too much",
    fs::Other(code, text) -> if code == 0 { "failed " ++ text } else { "the host's own" },
  }

/// A descriptor is the run's own number, so only whether there is one is compared.
fn opened_text(o: Result<Int, fs::FileError>) -> String =
  match o { Ok(_) -> "open", Err(why) -> file_error_text(why) }

fn with_descriptor<| e>(o: Result<Int, fs::FileError>, f: (Int) -> String / e) -> String / e =
  match o { Ok(file) -> f(file), Err(_) -> "no descriptor" }

/// The operations on an open file, under `s/`.
fn streamed() -> List<String> / {fs.read[cwd], fs.write[cwd]} = {
  let made = fs.create_dir[cwd]("s");
  let out = fs.open[cwd]("s/f", fs::ToWrite);
  let wrote = with_descriptor(out, |d: Int|
    bool_text(fs.write_chunk[cwd](d, b"hello ") && fs.write_chunk[cwd](d, b"world")));
  let unread = with_descriptor(out, |d: Int| optional_bytes_text(fs.read_chunk[cwd](d, 4)));
  let closed = with_descriptor(out, |d: Int| bool_text(fs.close[cwd](d)));
  let again = with_descriptor(out, |d: Int| bool_text(fs.close[cwd](d)));
  let late = with_descriptor(out, |d: Int| bool_text(fs.write_chunk[cwd](d, b"!")));
  let more = fs.open[cwd]("s/f", fs::ToAppend);
  let appended = with_descriptor(more, |d: Int|
    bool_text(fs.write_chunk[cwd](d, b"!") && fs.close[cwd](d)));
  let source = fs.open[cwd]("s/f", fs::ToRead);
  let chunks = with_descriptor(source, |d: Int|
    optional_bytes_text(fs.read_chunk[cwd](d, 5)) ++ " "
      ++ optional_bytes_text(fs.read_chunk[cwd](d, 100))
      ++ " "
      ++ optional_bytes_text(fs.read_chunk[cwd](d, 100))
      ++ " "
      ++ optional_bytes_text(fs.read_chunk[cwd](d, 0)));
  let unwritten = with_descriptor(source, |d: Int| bool_text(fs.write_chunk[cwd](d, b"x")));
  let shut = with_descriptor(source, |d: Int| bool_text(fs.close[cwd](d)));
  let after = with_descriptor(source, |d: Int| optional_bytes_text(fs.read_chunk[cwd](d, 1)));
  [
    "create_dir s -> " ++ bool_text(made),
    "open s/f to write -> " ++ opened_text(out),
    "write_chunk twice -> " ++ wrote,
    "read_chunk of a file open to write -> " ++ unread,
    "close -> " ++ closed,
    "close again -> " ++ again,
    "write_chunk after close -> " ++ late,
    "open s/f to append -> " ++ opened_text(more),
    "write_chunk and close -> " ++ appended,
    "open s/f to read -> " ++ opened_text(source),
    "read_chunk 5, 100, 100, 0 -> " ++ chunks,
    "write_chunk of a file open to read -> " ++ unwritten,
    "close -> " ++ shut,
    "read_chunk after close -> " ++ after,
    "open s/nope to read -> " ++ opened_text(fs.open[cwd]("s/nope", fs::ToRead)),
    "open s to read -> " ++ opened_text(fs.open[cwd]("s", fs::ToRead)),
    "open s to write -> " ++ opened_text(fs.open[cwd]("s", fs::ToWrite)),
    "open s/no/f to write -> " ++ opened_text(fs.open[cwd]("s/no/f", fs::ToWrite)),
    "read_file s/f -> " ++ optional_bytes_text(fs.read_file[cwd]("s/f")),
    "remove_tree s -> " ++ bool_text(fs.remove_tree[cwd]("s")),
  ]
}

test/nondet "the twin answers every operation on an open file as the disk does" {
  empty_working_directory();
  let disk = streamed();
  let twin = fs::on_mem(fs::mem_empty(), || streamed()).value;
  match first_difference(disk, twin) { Some(why) -> panic(why), None -> () }
}

fn mebibyte() -> Int = 1048576

/// One read answers at most 64 MiB (`E0453`), so this file is a mebibyte past what `read_file`
/// would answer: written and read back through a descriptor, a chunk at a time.
fn over_the_bound() -> List<String> / {fs.read[cwd], fs.write[cwd], abort.raise} = {
  let block = range(0, 16).fold(b"0123456789abcdef", |b: Bytes, i: Int| b.concat(b));
  let blocks = 65;
  let out = fs.open[cwd]("large", fs::ToWrite);
  let wrote = with_descriptor(out, |d: Int|
    bool_text(
      range(0, blocks).fold(true, |ok: Bool, i: Int| ok && fs.write_chunk[cwd](d, block))
        && fs.close[cwd](d),
    ));
  let size = fs.file_size[cwd]("large");
  let source = fs.open[cwd]("large", fs::ToRead);
  let read = with_descriptor(source, |d: Int| {
    let total = iterate({ bytes: 0, chunks: 0 }, blocks + 2, |s: { bytes: Int, chunks: Int }|
      match fs.read_chunk[cwd](d, 8 * mebibyte()) {
        Some(chunk) -> if chunk.len() == 0 { Stop(s) }
        else { Continue({ bytes: s.bytes + chunk.len(), chunks: s.chunks + 1 }) },
        None -> Stop(s),
      });
    let closed = fs.close[cwd](d);
    total.bytes.to_string() ++ " bytes in " ++ total.chunks.to_string() ++ " chunks, closed "
      ++ bool_text(closed)
  });
  assert(size == Some(blocks * mebibyte()) && blocks * mebibyte() > 64 * mebibyte());
  [
    "write 65 MiB -> " ++ wrote,
    "file_size large -> " ++ optional_int_text(size),
    "read in 8 MiB chunks -> " ++ read,
    "remove large -> " ++ bool_text(fs.remove[cwd]("large")),
  ]
}

test/nondet "a file over the bound of one read is read in chunks, on the disk and over the twin" {
  empty_working_directory();
  let disk = over_the_bound();
  let twin = fs::on_mem(fs::mem_empty(), || over_the_bound()).value;
  assert_eq(disk.at(2), Some("read in 8 MiB chunks -> 68157440 bytes in 9 chunks, closed true"));
  match first_difference(disk, twin) { Some(why) -> panic(why), None -> () }
}

// A descriptor has a place in its file that every read moves, so reading through one is a write
// of its root: two under one root may not run at once, and two under two roots may.
test "two open files under one root contend, and under two roots do not" {
  let read_write_row = |row: String, other: String|
    "import std.fs (fs)\n\npub fn both(a: Int, b: Int) -> (Option<Bytes>, Option<Bytes>) / {" ++ row
      ++ "} =\n  parallel { fs.read_chunk[left](a, 1), fs.read_chunk["
      ++ other
      ++ "](b, 1) }\n";
  let checked = |source: String|
    diagnostic_codes(json_of(in_memory(one_module_tree(source), ["check", "--json"])));
  assert_eq(checked(read_write_row("fs.read_chunk[left]", "left")), ["E0309"]);
  assert_eq(checked(read_write_row("fs.read_chunk[left], fs.read_chunk[right]", "right")), [])
}

// --- Looks, second names, exclusive creates and room --------------------------------

/// A fresh mode is the umask's on a disk, so a mode is compared only where a script set it.
fn stat_text(found: Option<fs::Stat>) -> String =
  match found {
    Some(s) -> kind_text(s.kind) ++ "," ++ s.size.to_string() ++ ",x" ++ s.links.to_string(),
    None -> "none",
  }

fn scan_text(seen: Option<List<ScanEntry>>) -> String =
  match seen {
    Some(entries) ->
      entries.fold("", |acc: String, s: ScanEntry|
        acc ++ (if acc == "" { "" } else { " " }) ++ s.path ++ "=" ++ stat_text(Some(s.stat))),
    None -> "none",
  }

fn linked_text(made: Result<Unit, fs::FileError>) -> String =
  match made { Ok(_) -> "linked", Err(why) -> file_error_text(why) }

/// A file's id is its file system's own number, so only whether two paths share one is compared.
fn same_file_text(a: String, b: String) -> String / {fs.stat[cwd]} =
  match fs.stat[cwd](a) {
    Some(x) -> match fs.stat[cwd](b) {
      Some(y) -> bool_text(x.device == y.device && x.id == y.id),
      None -> "none",
    },
    None -> "none",
  }

fn nanos_text(found: Option<fs::Stat>) -> String =
  match found { Some(s) -> nanos_at(s.modified).to_string(), None -> "none" }

/// Only that a file system has room is the same on a disk and in a twin.
fn space_text(room: Option<fs::Space>) -> String =
  match room {
    Some(r) -> bool_text(r.total > 0 && r.available <= r.free && r.free <= r.total),
    None -> "none",
  }

/// Under `n/`.
fn named() -> List<String> / {fs.read[cwd], fs.write[cwd]} = {
  let made = fs.create_dir[cwd]("n/d");
  let wrote = fs.write_file[cwd]("n/d/a.txt", b"one");
  let pointed = fs.symlink[cwd]("n/l", "d/a.txt");
  let twin = fs.link[cwd]("n/twin", "n/d/a.txt");
  let read_write_row = fs.write_file[cwd]("n/twin", b"both");
  let closed = fs.set_mode[cwd]("n/d/a.txt", owner_only());
  let stamped = fs.set_modified[cwd]("n/twin", 1700000000123);
  let created = fs.open[cwd]("n/new", fs::ToCreate);
  let filled = with_descriptor(created, |d: Int|
    bool_text(fs.write_chunk[cwd](d, b"mine") && fs.close[cwd](d)));
  [
    "create_dir n/d -> " ++ bool_text(made),
    "write_file n/d/a.txt -> " ++ bool_text(wrote),
    "symlink n/l -> " ++ bool_text(pointed),
    "link n/twin n/d/a.txt -> " ++ linked_text(twin),
    "write_file n/twin -> " ++ bool_text(read_write_row),
    "read_file n/d/a.txt -> " ++ optional_bytes_text(fs.read_file[cwd]("n/d/a.txt")),
    "set_mode n/d/a.txt -> " ++ bool_text(closed),
    "mode n/twin -> " ++ optional_mode_text(fs.mode[cwd]("n/twin")),
    "set_modified n/twin -> " ++ bool_text(stamped),
    "modified_ms n/d/a.txt -> " ++ optional_int_text(fs.modified_ms[cwd]("n/d/a.txt")),
    "stat n/d/a.txt -> " ++ stat_text(fs.stat[cwd]("n/d/a.txt")),
    "stat n/d/a.txt modified -> " ++ nanos_text(fs.stat[cwd]("n/d/a.txt")),
    "stat n/twin -> " ++ stat_text(fs.stat[cwd]("n/twin")),
    "stat n/d -> " ++ stat_text(fs.stat[cwd]("n/d")),
    "stat n/l -> " ++ stat_text(fs.stat[cwd]("n/l")),
    "stat n/l mode -> "
      ++ optional_mode_text(match fs.stat[cwd]("n/l") { Some(s) -> Some(s.mode), None -> None }),
    "stat n/absent -> " ++ stat_text(fs.stat[cwd]("n/absent")),
    "stat n/d/a.txt/under -> " ++ stat_text(fs.stat[cwd]("n/d/a.txt/under")),
    "one file n/twin n/d/a.txt -> " ++ same_file_text("n/twin", "n/d/a.txt"),
    "one file n/l n/d/a.txt -> " ++ same_file_text("n/l", "n/d/a.txt"),
    "link n/x n/absent -> " ++ linked_text(fs.link[cwd]("n/x", "n/absent")),
    "link n/x n/d -> " ++ linked_text(fs.link[cwd]("n/x", "n/d")),
    "link n/x n/l -> " ++ linked_text(fs.link[cwd]("n/x", "n/l")),
    "link n/l n/d/a.txt -> " ++ linked_text(fs.link[cwd]("n/l", "n/d/a.txt")),
    "link n/twin n/d/a.txt -> " ++ linked_text(fs.link[cwd]("n/twin", "n/d/a.txt")),
    "link n/no/x n/d/a.txt -> " ++ linked_text(fs.link[cwd]("n/no/x", "n/d/a.txt")),
    "link n/d/a.txt/x n/d/a.txt -> " ++ linked_text(fs.link[cwd]("n/d/a.txt/x", "n/d/a.txt")),
    "exists n/x -> " ++ bool_text(fs.exists[cwd]("n/x")),
    "copy n/twin onto n/d/a.txt -> " ++ bool_text(fs.copy[cwd]("n/twin", "n/d/a.txt")),
    "copy n/d/a.txt onto itself -> " ++ bool_text(fs.copy[cwd]("n/d/a.txt", "n/d/a.txt")),
    "read_file n/d/a.txt -> " ++ optional_bytes_text(fs.read_file[cwd]("n/d/a.txt")),
    "rename n/twin onto n/d/a.txt -> " ++ bool_text(fs.rename[cwd]("n/twin", "n/d/a.txt")),
    "exists n/twin -> " ++ bool_text(fs.exists[cwd]("n/twin")),
    "rename n/twin n/moved -> " ++ bool_text(fs.rename[cwd]("n/twin", "n/moved")),
    "modified_ms n/moved -> " ++ optional_int_text(fs.modified_ms[cwd]("n/moved")),
    "remove n/d/a.txt -> " ++ bool_text(fs.remove[cwd]("n/d/a.txt")),
    "stat n/moved -> " ++ stat_text(fs.stat[cwd]("n/moved")),
    "read_file n/moved -> " ++ optional_bytes_text(fs.read_file[cwd]("n/moved")),
    "open n/new to create -> " ++ opened_text(created),
    "write_chunk and close -> " ++ filled,
    "mode n/new -> " ++ optional_mode_text(fs.mode[cwd]("n/new")),
    "open n/new to create again -> " ++ opened_text(fs.open[cwd]("n/new", fs::ToCreate)),
    "open n/d to create -> " ++ opened_text(fs.open[cwd]("n/d", fs::ToCreate)),
    "open n/l to create -> " ++ opened_text(fs.open[cwd]("n/l", fs::ToCreate)),
    "exists n/d/a.txt -> " ++ bool_text(fs.exists[cwd]("n/d/a.txt")),
    "open n/no/new to create -> " ++ opened_text(fs.open[cwd]("n/no/new", fs::ToCreate)),
    "open n/moved/new to create -> " ++ opened_text(fs.open[cwd]("n/moved/new", fs::ToCreate)),
    "open n/moved/new to write -> " ++ opened_text(fs.open[cwd]("n/moved/new", fs::ToWrite)),
    "scan n deep -> " ++ scan_text(fs.scan[cwd]("n", true)),
    "scan n -> " ++ scan_text(fs.scan[cwd]("./n/", false)),
    "scan n/moved -> " ++ scan_text(fs.scan[cwd]("n/moved", true)),
    "scan n/absent -> " ++ scan_text(fs.scan[cwd]("n/absent", false)),
    "space n -> " ++ space_text(fs.space[cwd]("n")),
    "space n/moved -> " ++ space_text(fs.space[cwd]("n/moved")),
    "space n/absent -> " ++ space_text(fs.space[cwd]("n/absent")),
    "remove_tree n -> " ++ bool_text(fs.remove_tree[cwd]("n")),
  ]
}

test/nondet "the twin looks at a path, names a file twice and makes one exclusively as the disk does" {
  empty_working_directory();
  let disk = named();
  let twin = fs::on_mem(fs::mem_empty(), || named()).value;
  assert_eq(disk.at(10), Some("stat n/d/a.txt -> file,4,x2"));
  assert_eq(disk.at(11), Some("stat n/d/a.txt modified -> 1700000000123000000"));
  assert_eq(disk.at(30), Some("read_file n/d/a.txt -> \"both\""));
  assert_eq(disk.at(34), Some("modified_ms n/moved -> 1700000000123"));
  match first_difference(disk, twin) { Some(why) -> panic(why), None -> () }
}

// --- Atomic writes ---------------------------------------------------------------

fn bits(n: Int) -> fs::Mode = fs::mode_of_bits(n)

/// What an atomic write of `path` came to: `written`, or where it stopped and why. A temporary
/// file's name is the run's own, so a refusal there is told by its directory.
fn atomically(
  path: String,
  body: Bytes,
  durability: fs::Durability,
  mode: Option<fs::Mode>,
) -> String / {fs.read[cwd], fs.write[cwd], entropy.next, abort.raise} = {
  let wrote: Result<Unit, (String, fs::FileError)> = try[files.refused] {
    fs::write_atomic[cwd](path, body, durability, mode)
  };
  match wrote {
    Ok(_) -> "written",
    Err((at, why)) ->
      (if at.contains(".tmp-") { "beside " ++ path } else { "at " ++ at }) ++ ": "
        ++ file_error_text(why),
  }
}

/// A file replaced through a sink in two chunks, where `fail` raises between them.
fn replaced(
  path: String,
  fail: Bool,
) -> String / {fs.read[cwd], fs.write[cwd], files.refused, entropy.next, abort.raise} = {
  let wrote: Result<Unit, Int> = try[io.too_long] {
    io::replacing[cwd](path, fs::Durable, None, |sink: Sink<| {fs.write_chunk[cwd]}>| {
      let first = (sink.push)(b"str");
      if fail { io.too_long(3) } else { () };
      if first && (sink.push)(b"eamed") { () } else { panic("the sink took nothing") }
    })
  };
  match wrote { Ok(_) -> "replaced", Err(n) -> "raised after " ++ n.to_string() }
}

/// Under `w/`.
fn atomic() -> List<String> / {fs.read[cwd], fs.write[cwd], files.refused, entropy.next, abort.raise} = {
  let made = fs.create_dir[cwd]("w/dir");
  let old = fs.write_file[cwd]("w/cfg", b"old") && fs.set_mode[cwd]("w/cfg", bits(416));
  let pointed = fs.symlink[cwd]("w/link", "cfg");
  [
    "create_dir w/dir -> " ++ bool_text(made),
    "write_file and set_mode w/cfg rw-r----- -> " ++ bool_text(old),
    "symlink w/link cfg -> " ++ bool_text(pointed),
    "write_atomic w/cfg durable -> " ++ atomically("w/cfg", b"new", fs::Durable, None),
    "read_file w/cfg -> " ++ optional_bytes_text(fs.read_file[cwd]("w/cfg")),
    "mode w/cfg -> " ++ optional_mode_text(fs.mode[cwd]("w/cfg")),
    "write_atomic w/fresh fast -> " ++ atomically("w/fresh", b"f", fs::Fast, None),
    "mode w/fresh -> " ++ optional_mode_text(fs.mode[cwd]("w/fresh")),
    "write_atomic w/tool rwx------ -> " ++ atomically("w/tool", b"t", fs::Fast, Some(bits(448))),
    "mode w/tool -> " ++ optional_mode_text(fs.mode[cwd]("w/tool")),
    "write_atomic w/link -> " ++ atomically("w/link", b"direct", fs::Durable, None),
    "kind w/link -> " ++ kind_text(fs.kind[cwd]("w/link")),
    "read_file w/link -> " ++ optional_bytes_text(fs.read_file[cwd]("w/link")),
    "read_file w/cfg -> " ++ optional_bytes_text(fs.read_file[cwd]("w/cfg")),
    "write_atomic w/no/cfg -> " ++ atomically("w/no/cfg", b"x", fs::Durable, None),
    "write_atomic w/cfg/under -> " ++ atomically("w/cfg/under", b"x", fs::Durable, None),
    "write_atomic w/dir -> " ++ atomically("w/dir", b"x", fs::Durable, None),
    "kind w/dir -> " ++ kind_text(fs.kind[cwd]("w/dir")),
    "replacing w/cfg -> " ++ replaced("w/cfg", false),
    "read_file w/cfg -> " ++ optional_bytes_text(fs.read_file[cwd]("w/cfg")),
    "mode w/cfg -> " ++ optional_mode_text(fs.mode[cwd]("w/cfg")),
    "replacing w/cfg, raising -> " ++ replaced("w/cfg", true),
    "read_file w/cfg -> " ++ optional_bytes_text(fs.read_file[cwd]("w/cfg")),
    "list_dir w -> " ++ shown_listed(fs.list_dir[cwd]("w")),
    "remove_tree w -> " ++ bool_text(fs.remove_tree[cwd]("w")),
  ]
}

test/nondet "the twin writes a file whole or not at all as the disk does, and neither leaves a temporary" {
  empty_working_directory();
  let disk = atomic();
  let twin = fs::on_mem(fs::mem_empty(), || atomic()).value;
  assert_eq(disk.at(23), Some("list_dir w -> [cfg:file dir:dir fresh:file link:file tool:file]"));
  match first_difference(disk, twin) { Some(why) -> panic(why), None -> () }
}

// --- Copies of trees ---------------------------------------------------------------

/// Every entry under `dir` a line apart: what a look reads of it, a link's target, a file's bytes,
/// and the mode and the milliseconds a script set on a file or a directory.
fn tree_text(dir: String) -> String / {fs.read[cwd]} =
  match fs.scan[cwd](dir, true) {
    None -> "none",
    Some(entries) ->
      entries.fold("", |acc: String, s: ScanEntry|
        acc ++ "\n    " ++ s.path ++ "=" ++ stat_text(Some(s.stat))
          ++ (match s.stat.kind {
            fs::Symlink -> " to " ++ optional_string_text(fs.read_link[cwd](s.path)),
            fs::File ->
              " " ++ optional_bytes_text(fs.read_file[cwd](s.path)) ++ " "
                ++ fs::mode_text(s.stat.mode)
                ++ " at "
                ++ Int::to_string(nanos_at(s.stat.modified) / 1000000),
            _ ->
              " " ++ fs::mode_text(s.stat.mode) ++ " at "
                ++ Int::to_string(nanos_at(s.stat.modified) / 1000000),
          })),
  }

/// A tree at `top` with a mode and a time set on every file and directory in it: a file of each
/// mode, a directory in a directory and an empty one, a link, and a file with two names.
fn planted(top: String) -> Bool / {fs.write[cwd]} = {
  let at = |rest: String| top ++ "/" ++ rest;
  let made = fs.create_dir[cwd](at("sub")) && fs.create_dir[cwd](at("empty"))
    && fs.write_file[cwd](at("a.txt"), b"alpha")
    && fs.write_file[cwd](at("sub/b.sh"), b"#!/bin/sh\n")
    && fs.symlink[cwd](at("l"), "sub/b.sh");
  let twin = fs.link[cwd](at("sub/twin.txt"), at("a.txt"));
  let moded = fs.set_mode[cwd](at("a.txt"), bits(416))
    && fs.set_mode[cwd](at("sub/b.sh"), bits(488))
    && fs.set_mode[cwd](at("sub"), bits(493))
    && fs.set_mode[cwd](at("empty"), bits(448))
    && fs.set_mode[cwd](top, bits(493));
  let dated = fs.set_modified[cwd](at("a.txt"), 1600000000000)
    && fs.set_modified[cwd](at("sub/b.sh"), 1600000001000)
    && fs.set_modified[cwd](at("sub"), 1600000002000)
    && fs.set_modified[cwd](at("empty"), 1600000003000)
    && fs.set_modified[cwd](top, 1600000004000);
  made && twin == Ok(()) && moded && dated
}

fn copy_options(existing: fs::Existing, outside: fs::OutsideLink) -> fs::CopyOptions =
  { existing: existing, outside: outside, entries: 100, bytes: 100000 }

fn copied_text(copied: Result<fs::CopyResult<Int>, (String, fs::FileError)>) -> String =
  match copied {
    Ok(c) ->
      c.entries.to_string() ++ " entries, " ++ c.bytes.to_string() ++ " bytes, told "
        ++ c.value.to_string()
        ++ ", skipped "
        ++ names_text(Some(c.skipped))
        ++ (if c.stopped { ", stopped" } else { "" }),
    Err((at, why)) -> "at " ++ at ++ ": " ++ file_error_text(why),
  }

fn copy_within(
  from: String,
  to: String,
  how: fs::CopyOptions,
) -> String / {fs.read[cwd], fs.write[cwd], abort.raise} = {
  let copied: Result<fs::CopyResult<Int>, (String, fs::FileError)> = try[files.refused] {
    fs::copy_tree[cwd](from, to, how, 0, |n: Int, _told: fs::Progress| Continue(n + 1))
  };
  copied_text(copied)
}

fn copy_across(
  from: String,
  to: String,
  how: fs::CopyOptions,
) -> String / {fs.read[cwd], fs.write[cwd], abort.raise} = {
  let copied: Result<fs::CopyResult<Int>, (String, fs::FileError)> = try[files.refused] {
    fs::copy_tree_across[cwd, cwd](from, to, how, 0, |n: Int, told: fs::Progress|
      if told.path == to ++ "/l" { Stop(n + 1) } else { Continue(n + 1) })
  };
  copied_text(copied)
}

/// Under `t/`.
fn copied() -> List<String> / {fs.read[cwd], fs.write[cwd], abort.raise} = {
  let grown = planted("t/src");
  let stood = fs.create_dir[cwd]("t/merged/sub") && fs.write_file[cwd]("t/merged/a.txt", b"old")
    && fs.write_file[cwd]("t/merged/kept.txt", b"kept")
    && fs.set_mode[cwd]("t/merged/kept.txt", bits(420))
    && fs.set_modified[cwd]("t/merged/kept.txt", 1500000000000)
    && fs.symlink[cwd]("t/merged/empty", "kept.txt");
  let tight = copy_options(fs::Refuse, fs::RefuseLink);
  let climbing = fs.create_dir[cwd]("t/up") && fs.write_file[cwd]("t/up/f", b"f")
    && fs.symlink[cwd]("t/up/out", "../../t");
  [
    "a tree is planted -> " ++ bool_text(grown),
    "the tree -> " ++ tree_text("t/src"),
    "copy_tree t/src t/out -> "
      ++ copy_within("t/src", "t/out", copy_options(fs::Refuse, fs::RefuseLink)),
    "the copy -> " ++ tree_text("t/out"),
    "one file t/out/a.txt t/out/sub/twin.txt -> "
      ++ same_file_text("t/out/a.txt", "t/out/sub/twin.txt"),
    "one file t/out/a.txt t/src/a.txt -> " ++ same_file_text("t/out/a.txt", "t/src/a.txt"),
    "mode t/out -> " ++ optional_mode_text(fs.mode[cwd]("t/out")),
    "modified_ms t/out -> " ++ optional_int_text(fs.modified_ms[cwd]("t/out")),
    "copy_tree again, refusing -> "
      ++ copy_within("t/src", "t/out", copy_options(fs::Refuse, fs::RefuseLink)),
    "something stands at t/merged -> " ++ bool_text(stood),
    "copy_tree, merging -> "
      ++ copy_within("t/src", "t/merged", copy_options(fs::Merge, fs::RefuseLink)),
    "the merged -> " ++ tree_text("t/merged"),
    "copy_tree, replacing -> "
      ++ copy_within("t/src", "t/merged", copy_options(fs::Replace, fs::RefuseLink)),
    "list_dir t/merged -> " ++ shown_listed(fs.list_dir[cwd]("t/merged")),
    "copy_tree a file over a directory, merging -> "
      ++ copy_within("t/src/a.txt", "t/merged/sub", copy_options(fs::Merge, fs::RefuseLink)),
    "copy_tree of nothing -> "
      ++ copy_within("t/absent", "t/nowhere", copy_options(fs::Refuse, fs::RefuseLink)),
    "copy_tree past its bound -> " ++ copy_within("t/src", "t/nowhere", { ..tight, bytes: 19 }),
    "exists t/nowhere -> " ++ bool_text(fs.exists[cwd]("t/nowhere")),
    "a link climbs -> " ++ bool_text(climbing),
    "copy_tree t/up to the root, refusing the link -> "
      ++ copy_within("t/up", "", copy_options(fs::Merge, fs::RefuseLink)),
    "copy_tree t/up to the root, skipping the link -> "
      ++ copy_within("t/up", "", copy_options(fs::Merge, fs::SkipLink)),
    "read_file f -> " ++ optional_bytes_text(fs.read_file[cwd]("f")),
    "exists out -> " ++ bool_text(fs.exists[cwd]("out")),
    "remove f -> " ++ bool_text(fs.remove[cwd]("f")),
    "copy_tree_across, stopping at the link -> "
      ++ copy_across("t/src", "t/over", copy_options(fs::Refuse, fs::RefuseLink)),
    "the copy across -> " ++ tree_text("t/over"),
    "remove_tree t -> " ++ bool_text(fs.remove_tree[cwd]("t")),
  ]
}

test/nondet "the twin copies a tree, its modes, times and links, as the disk does" {
  empty_working_directory();
  let disk = copied();
  let twin = fs::on_mem(fs::mem_empty(), || copied()).value;
  assert_eq(disk.at(2), Some("copy_tree t/src t/out -> 7 entries, 20 bytes, told 7, skipped []"));
  match first_difference(disk, twin) { Some(why) -> panic(why), None -> () }
}

// --- Watches ---------------------------------------------------------------------

fn changes_text(changes: List<fs::Change>) -> String =
  "["
    ++ changes.fold("", |acc: String, c: fs::Change|
      acc ++ (if acc == "" { "" } else { ", " })
        ++ (match c {
          fs::Created(p) -> "created " ++ p,
          fs::Modified(p) -> "modified " ++ p,
          fs::Removed(p) -> "removed " ++ p,
          fs::Renamed(from, to) -> "renamed " ++ from ++ " to " ++ to,
          fs::Rescan -> "rescan",
        }))
    ++ "]"

/// Under `v/`. Each change either moves a file's size or stamps a time on it, so a disk whose
/// clock is coarse tells it as a twin does.
fn watched() -> List<String> / {fs.read[cwd], fs.write[cwd], time.sleep_ms, abort.raise} = {
  let made = fs.create_dir[cwd]("v/d") && fs.write_file[cwd]("v/d/a.txt", b"a")
    && fs.set_modified[cwd]("v/d/a.txt", 1600000000000);
  let begun = fs::watch[cwd]("v/d", true, 10);
  let quiet = fs::poll[cwd](begun);
  let wrote = fs.write_file[cwd]("v/d/n.txt", b"n") && fs.write_file[cwd]("v/elsewhere", b"e");
  let first = fs::poll[cwd](quiet.watch);
  let grew = fs.write_file[cwd]("v/d/a.txt", b"aa");
  let second = fs::poll[cwd](first.watch);
  let stamped = fs.set_modified[cwd]("v/d/a.txt", 1600000001000);
  let third = fs::poll[cwd](second.watch);
  let renamed = fs.rename[cwd]("v/d/n.txt", "v/d/m.txt");
  let fourth = fs::poll[cwd](third.watch);
  let nested = fs.create_dir[cwd]("v/d/sub") && fs.write_file[cwd]("v/d/sub/x", b"x");
  let fifth = fs::poll[cwd](fourth.watch);
  let moved = fs.rename[cwd]("v/d/sub", "v/d/bus");
  let sixth = fs::poll[cwd](fifth.watch);
  let saved = fs.write_file[cwd]("v/d/m.tmp", b"saved") && fs.rename[cwd]("v/d/m.tmp", "v/d/m.txt");
  let seventh = fs::poll[cwd](sixth.watch);
  let closed = fs.set_mode[cwd]("v/d/bus", bits(457)) && fs.remove[cwd]("v/d/a.txt");
  let eighth = fs::poll[cwd](seventh.watch);
  let still = fs::await_changes[cwd](eighth.watch, millis(2), 3);
  let narrow = fs::watch[cwd]("v/d", false, 1);
  let flooded = fs.write_file[cwd]("v/d/one", b"1") && fs.write_file[cwd]("v/d/two", b"2");
  let ninth = fs::poll[cwd](narrow);
  let gone = fs.remove_tree[cwd]("v/d");
  let tenth = fs::poll[cwd](ninth.watch);
  let eleventh = fs::poll[cwd](tenth.watch);
  let back = fs.create_dir[cwd]("v/d");
  let twelfth = fs::poll[cwd](eleventh.watch);
  [
    "a directory to watch -> " ++ bool_text(made),
    "poll, nothing changed -> " ++ changes_text(quiet.changes),
    "a file is made, and one elsewhere -> " ++ bool_text(wrote),
    "poll -> " ++ changes_text(first.changes),
    "a file grows -> " ++ bool_text(grew),
    "poll -> " ++ changes_text(second.changes),
    "a file is stamped -> " ++ bool_text(stamped),
    "poll -> " ++ changes_text(third.changes),
    "a file is renamed -> " ++ bool_text(renamed),
    "poll -> " ++ changes_text(fourth.changes),
    "a directory is made with a file in it -> " ++ bool_text(nested),
    "poll -> " ++ changes_text(fifth.changes),
    "the directory is renamed -> " ++ bool_text(moved),
    "poll -> " ++ changes_text(sixth.changes),
    "a file is saved by renaming another over it -> " ++ bool_text(saved),
    "poll -> " ++ changes_text(seventh.changes),
    "a directory's mode is set and a file removed -> " ++ bool_text(closed),
    "poll -> " ++ changes_text(eighth.changes),
    "await_changes, nothing changing -> " ++ changes_text(still.changes),
    "two files are made under a watch that lists one change -> " ++ bool_text(flooded),
    "poll -> " ++ changes_text(ninth.changes),
    "the directory is removed -> " ++ bool_text(gone),
    "poll -> " ++ changes_text(tenth.changes),
    "poll again -> " ++ changes_text(eleventh.changes),
    "the directory is made again -> " ++ bool_text(back),
    "poll -> " ++ changes_text(twelfth.changes),
    "remove_tree v -> " ++ bool_text(fs.remove_tree[cwd]("v")),
  ]
}

test/nondet "a watch over the twin tells what a watch over the disk tells" {
  empty_working_directory();
  let disk = watched();
  let twin = fs::on_mem(fs::mem_empty(), || watched()).value;
  assert_eq(disk.at(13), Some("poll -> [renamed v/d/sub to v/d/bus]"));
  assert_eq(disk.at(15), Some("poll -> [modified v/d/m.txt]"));
  match first_difference(disk, twin) { Some(why) -> panic(why), None -> () }
}

// --- Archives ---------------------------------------------------------------------

fn limits() -> tar::Limits = { entries: 1000, total: 1000000, size: 1000000, path: 4096 }

fn outcome_text(o: tar::Outcome) -> String =
  match o {
    tar::Extracted -> "extracted",
    tar::Barred(tar::ThroughLink) -> "barred through a link",
    tar::Barred(tar::Replaces) -> "barred from replacing",
    tar::Barred(tar::LinkMissing) -> "barred, no file to name",
    tar::Barred(_) -> "barred",
    tar::Failed(why) -> file_error_text(why),
  }

fn carried_text(carried: List<tar::ExtractionResult>) -> String =
  carried.fold("", |acc: String, c: tar::ExtractionResult|
    acc ++ (if acc == "" { "" } else { ", " }) ++ c.path ++ " " ++ outcome_text(c.outcome))

fn packed(
  dir: String,
  to: String,
  how: tar::PackOptions,
) -> String / {fs.read[cwd], fs.write[cwd], io.closed, io.write_failed, files.refused, tar.unwritable, abort.raise} = {
  let refused: Result<tar::PackResult, (String, fs::FileError)> = try[io.fail] {
    with_hold[out](
      io::writing[cwd](to),
      io::close_sink,
    ) { sink -> tar::pack[cwd](dir, [""], sink, how) }
  };
  match refused {
    Ok(p) -> p.entries.to_string() ++ " entries in " ++ p.bytes.to_string() ++ " bytes",
    Err((at, why)) -> "at " ++ at ++ ": " ++ file_error_text(why),
  }
}

/// What unpacking the archive at `from` into `into`, which it makes first, came to.
fn unpacked(
  from: String,
  into: String,
) -> String / {fs.read[cwd], fs.write[cwd], io.fail, io.closed, abort.raise} = {
  let made = fs.create_dir[cwd](into);
  let refused: Result<Result<List<tar::ExtractionResult>, tar::UnsafeEntry>, tar::Error> = try[tar.fail] {
    let unsafe: Result<List<tar::ExtractionResult>, tar::UnsafeEntry> = try[tar.unsafe] {
      tar::unpack[cwd, cwd](from, into, limits(), 4096)
    };
    unsafe
  };
  if !made { "no directory to unpack into" } else {
    match refused {
      Ok(Ok(carried)) -> carried_text(carried),
      Ok(Err(e)) -> "entry " ++ e.index.to_string() ++ " (" ++ e.path ++ ") may not be extracted",
      Err(e) -> "no archive at byte " ++ e.at.to_string(),
    }
  }
}

fn archive_of(entries: List<tar::Entry>) -> Bytes / {abort.raise} =
  match tar::encode(entries) { Ok(bytes) -> bytes, Err(_) -> panic("the entries have headers") }

/// Under `x/`.
fn archived() -> List<String> / {fs.read[cwd], fs.write[cwd], io.fail, io.closed, io.write_failed, files.refused, tar.unwritable, abort.raise} = {
  let grown = planted("x/src");
  let absent: Result<String, (String, fs::FileError)> = try[io.fail] {
    unpacked("x/absent.tar", "x/nowhere")
  };
  let plain: tar::PackOptions = {
    times: false,
    modes: false,
    entries: 100,
    bytes: 100000,
    chunk: 7,
  };
  let kept: tar::PackOptions = {
    times: true,
    modes: true,
    entries: 100,
    bytes: 100000,
    chunk: 4096,
  };
  let climbs = fs.write_file[cwd](
    "x/climbs.tar",
    archive_of([tar::file("ok", b"1"), tar::file("../escaped", b"x")]),
  );
  let with_descriptor = fs.write_file[cwd](
    "x/through.tar",
    archive_of([tar::file("ok", b"1"), tar::symlink("l", "../../outside"), tar::file("l/f", b"x")]),
  );
  let cut = fs.write_file[cwd](
    "x/cut.tar",
    archive_of([tar::file("ok", b"1"), tar::file("late", b"22")]).slice(0, 1100),
  );
  let swapped = fs.create_dir[cwd]("x/swapped") && fs.create_dir[cwd]("x/elsewhere")
    && fs.symlink[cwd]("x/swapped/sub", "../elsewhere")
    && fs.symlink[cwd]("x/swapped/aimed", "../elsewhere/secret")
    && fs.write_file[cwd]("x/elsewhere/secret", b"kept");
  let steps = match tar::plan([
      tar::file("sub/f", b"x"),
      tar::file("aimed", b"y"),
      tar::file("fine", b"z"),
    ]) {
    Ok(planned) -> planned,
    Err(_) -> panic("the entries are safe to extract"),
  };
  [
    "a tree is planted -> " ++ bool_text(grown),
    "pack x/src, without times and modes -> " ++ packed("x/src", "x/plain.tar", plain),
    "file_size x/plain.tar -> " ++ optional_int_text(fs.file_size[cwd]("x/plain.tar")),
    "unpack x/plain.tar -> " ++ unpacked("x/plain.tar", "x/plain"),
    "the unpacked -> " ++ tree_text("x/plain"),
    "one file x/plain/a.txt x/plain/sub/twin.txt -> "
      ++ same_file_text("x/plain/a.txt", "x/plain/sub/twin.txt"),
    "pack x/src, with them -> " ++ packed("x/src", "x/kept.tar", kept),
    "unpack x/kept.tar -> " ++ unpacked("x/kept.tar", "x/kept"),
    "the unpacked -> " ++ tree_text("x/kept"),
    "the tree -> " ++ tree_text("x/src"),
    "an archive that climbs out -> " ++ bool_text(climbs),
    "unpack it -> " ++ unpacked("x/climbs.tar", "x/out"),
    "list_dir x/out -> " ++ shown_listed(fs.list_dir[cwd]("x/out")),
    "exists x/escaped -> " ++ bool_text(fs.exists[cwd]("x/escaped")),
    "an archive that writes through its own link -> " ++ bool_text(with_descriptor),
    "unpack it -> " ++ unpacked("x/through.tar", "x/out"),
    "list_dir x/out -> " ++ shown_listed(fs.list_dir[cwd]("x/out")),
    "an archive cut short -> " ++ bool_text(cut),
    "unpack it -> " ++ unpacked("x/cut.tar", "x/out"),
    "list_dir x/out -> " ++ shown_listed(fs.list_dir[cwd]("x/out")),
    "unpack what is not there -> "
      ++ (match absent {
        Ok(said) -> said,
        Err((at, why)) -> "at " ++ at ++ ": " ++ file_error_text(why),
      }),
    "a directory whose entries are links out of it -> " ++ bool_text(swapped),
    "extract a plan into it -> "
      ++ tar::extract[cwd](steps, "x/swapped").fold("", |acc: String, o: tar::Outcome|
        acc ++ (if acc == "" { "" } else { ", " }) ++ outcome_text(o)),
    "list_dir x/elsewhere -> " ++ shown_listed(fs.list_dir[cwd]("x/elsewhere")),
    "read_file x/elsewhere/secret -> "
      ++ optional_bytes_text(fs.read_file[cwd]("x/elsewhere/secret")),
    "read_file x/swapped/fine -> " ++ optional_bytes_text(fs.read_file[cwd]("x/swapped/fine")),
    "remove_tree x -> " ++ bool_text(fs.remove_tree[cwd]("x")),
  ]
}

test/nondet "an archive is packed from and extracted onto the twin as onto the disk, and one that leaves its directory extracts nothing" {
  empty_working_directory();
  let disk = archived();
  let twin = fs::on_mem(fs::mem_empty(), || archived()).value;
  assert_eq(disk.at(11), Some("unpack it -> entry 1 (../escaped) may not be extracted"));
  assert_eq(disk.at(12), Some("list_dir x/out -> []"));
  assert_eq(disk.at(13), Some("exists x/escaped -> false"));
  assert_eq(disk.at(15), Some("unpack it -> entry 1 (l) may not be extracted"));
  assert_eq(disk.at(16), Some("list_dir x/out -> []"));
  assert_eq(
    disk.at(22),
    Some(
      "extract a plan into it -> barred from replacing, barred through a link, barred from replacing, extracted",
    ),
  );
  assert_eq(disk.at(23), Some("list_dir x/elsewhere -> [secret:file]"));
  match first_difference(disk, twin) { Some(why) -> panic(why), None -> () }
}

// --- Links that lead out of the root ---------------------------------------------

/// What an attempt through a link that leads out of its root comes to.
type ExpectedOutcome =
  /// It is refused, and the path below the attempt's own directory is what is said to leave.
  | Escapes(String)
  /// It is refused, and this text is what is said to leave.
  | EscapesAs(String)
  /// It acts on the link itself, reaches nothing through it, and answers this.
  | Returns(String)

/// One attempt: its name, the row its call performs under, the call, and what it comes to.
type Attempt = { name: String, row: String, call: String, held: ExpectedOutcome }

fn read_row() -> String = "fs.read[l]"

fn write_row() -> String = "fs.write[l]"

fn read_write_row() -> String = "fs.read[l], fs.write[l]"

/// Each under a directory `c` of its own that `planted` fills: `g(c)` is a link to a path outside
/// the root where nothing is, `f(c)` a link to a file outside it, `o(c)` a link to a directory
/// outside it, `p(c)` a file, and `c/a/b/up` a link to `c`.
fn attempts() -> List<Attempt> =
  [
    {
      name: "write_file",
      row: write_row(),
      call: "yes(fs.write_file[l](g(c), b\"x\"))",
      held: Escapes("gone"),
    },
    {
      name: "append",
      row: write_row(),
      call: "yes(fs.append[l](g(c), b\"x\") != None)",
      held: Escapes("gone"),
    },
    {
      name: "open to write",
      row: write_row(),
      call: "opened(fs.open[l](g(c), fs::ToWrite))",
      held: Escapes("gone"),
    },
    {
      name: "open to append",
      row: write_row(),
      call: "opened(fs.open[l](g(c), fs::ToAppend))",
      held: Escapes("gone"),
    },
    {
      name: "open to create",
      row: write_row(),
      call: "opened(fs.open[l](g(c), fs::ToCreate))",
      held: Returns("exists"),
    },
    {
      name: "create_dir",
      row: write_row(),
      call: "yes(fs.create_dir[l](g(c)))",
      held: Escapes("gone"),
    },
    {
      name: "copy onto it",
      row: write_row(),
      call: "yes(fs.copy[l](p(c), g(c)))",
      held: Escapes("gone"),
    },
    {
      name: "set_mode",
      row: write_row(),
      call: "yes(fs.set_mode[l](g(c), fs::mode_of_bits(384)))",
      held: Escapes("gone"),
    },
    {
      name: "set_modified",
      row: write_row(),
      call: "yes(fs.set_modified[l](g(c), 1000))",
      held: Escapes("gone"),
    },
    { name: "sync", row: write_row(), call: "yes(fs.sync[l](g(c)))", held: Escapes("gone") },
    {
      name: "temp_dir",
      row: write_row(),
      call: "yes(fs.temp_dir[l](g(c), \"t-\") != None)",
      held: Escapes("gone"),
    },
    { name: "lock", row: write_row(), call: "yes(fs.lock[l](g(c)))", held: Returns("false") },
    {
      name: "symlink",
      row: write_row(),
      call: "yes(fs.symlink[l](g(c), \"plain\"))",
      held: Returns("false"),
    },
    {
      name: "link as the new name",
      row: write_row(),
      call: "linked(fs.link[l](g(c), p(c)))",
      held: Returns("exists"),
    },
    {
      name: "link as the file named",
      row: write_row(),
      call: "linked(fs.link[l](c ++ \"/named\", g(c)))",
      held: Returns("not a file"),
    },
    {
      name: "rename onto it",
      row: read_write_row(),
      call: "yes(fs.rename[l](p(c), g(c))) ++ \" \" ++ kind(fs.kind[l](g(c)))",
      held: Returns("true file"),
    },
    {
      name: "rename",
      row: read_write_row(),
      call: "yes(fs.rename[l](g(c), c ++ \"/moved\")) ++ \" \" ++ kind(fs.kind[l](c ++ \"/moved\"))",
      held: Returns("true symlink"),
    },
    {
      name: "remove",
      row: read_write_row(),
      call: "yes(fs.remove[l](g(c))) ++ \" \" ++ kind(fs.kind[l](g(c)))",
      held: Returns("true missing"),
    },
    {
      name: "remove_tree",
      row: read_write_row(),
      call: "yes(fs.remove_tree[l](g(c))) ++ \" \" ++ kind(fs.kind[l](g(c)))",
      held: Returns("true missing"),
    },
    {
      name: "write_atomic",
      row: read_write_row() ++ ", entropy.next, abort.raise",
      call: "atomic[l](g(c)) ++ \" \" ++ kind(fs.kind[l](g(c)))",
      held: Returns("written file"),
    },
    {
      name: "copy_tree onto it",
      row: read_write_row() ++ ", abort.raise",
      call: "copied[l](c ++ \"/src\", g(c)) ++ \" \" ++ kind(fs.kind[l](g(c)))",
      held: Returns("copied dir"),
    },
    {
      name: "read_file",
      row: read_row(),
      call: "text(fs.read_file[l](f(c)))",
      held: Escapes("file"),
    },
    {
      name: "read_at",
      row: read_row(),
      call: "text(fs.read_at[l](f(c), 0, 4))",
      held: Escapes("file"),
    },
    {
      name: "open to read",
      row: write_row(),
      call: "opened(fs.open[l](f(c), fs::ToRead))",
      held: Escapes("file"),
    },
    {
      name: "resolved",
      row: read_row(),
      call: "kind(fs.resolved[l](f(c)))",
      held: Escapes("file"),
    },
    {
      name: "file_size",
      row: read_row(),
      call: "yes(fs.file_size[l](f(c)) != None)",
      held: Escapes("file"),
    },
    {
      name: "canonical",
      row: read_row(),
      call: "yes(fs.canonical[l](f(c)) != None)",
      held: Escapes("file"),
    },
    {
      name: "write_file over a file outside",
      row: write_row(),
      call: "yes(fs.write_file[l](f(c), b\"x\"))",
      held: Escapes("file"),
    },
    { name: "kind", row: read_row(), call: "kind(fs.kind[l](f(c)))", held: Returns("symlink") },
    {
      name: "read_link",
      row: read_row(),
      call: "match fs.read_link[l](f(c)) { Some(to) -> to, None -> \"none\" }",
      held: Returns("../../out/secret"),
    },
    {
      name: "stat",
      row: read_row(),
      call: "match fs.stat[l](f(c)) { Some(found) -> kind(found.kind), None -> \"none\" }",
      held: Returns("symlink"),
    },
    { name: "exists", row: read_row(), call: "yes(fs.exists[l](f(c)))", held: Returns("true") },
    {
      name: "write_file below",
      row: write_row(),
      call: "yes(fs.write_file[l](o(c) ++ \"/new\", b\"x\"))",
      held: Escapes("out/new"),
    },
    {
      name: "create_dir below",
      row: write_row(),
      call: "yes(fs.create_dir[l](o(c) ++ \"/new\"))",
      held: Escapes("out/new"),
    },
    {
      name: "list_dir",
      row: read_row(),
      call: "yes(fs.list_dir[l](o(c)) != None)",
      held: Escapes("out"),
    },
    { name: "walk", row: read_row(), call: "yes(fs.walk[l](o(c)) != None)", held: Escapes("out") },
    {
      name: "scan",
      row: read_row(),
      call: "yes(fs.scan[l](o(c), true) != None)",
      held: Escapes("out"),
    },
    {
      name: "kind below",
      row: read_row(),
      call: "kind(fs.kind[l](o(c) ++ \"/secret\"))",
      held: Escapes("out/secret"),
    },
    {
      name: "remove below",
      row: write_row(),
      call: "yes(fs.remove[l](o(c) ++ \"/secret\"))",
      held: Escapes("out/secret"),
    },
    {
      name: "rename from below",
      row: write_row(),
      call: "yes(fs.rename[l](o(c) ++ \"/secret\", c ++ \"/taken\"))",
      held: Escapes("out/secret"),
    },
    {
      name: "rename to below",
      row: write_row(),
      call: "yes(fs.rename[l](p(c), o(c) ++ \"/put\"))",
      held: Escapes("out/put"),
    },
    {
      name: "link below",
      row: write_row(),
      call: "linked(fs.link[l](o(c) ++ \"/named\", p(c)))",
      held: Escapes("out/named"),
    },
    {
      name: "link to below",
      row: write_row(),
      call: "linked(fs.link[l](c ++ \"/named\", o(c) ++ \"/secret\"))",
      held: Escapes("out/secret"),
    },
    {
      name: "symlink below",
      row: write_row(),
      call: "yes(fs.symlink[l](o(c) ++ \"/l\", \"x\"))",
      held: Escapes("out/l"),
    },
    {
      name: "lock below",
      row: write_row(),
      call: "yes(fs.lock[l](o(c) ++ \"/held.lock\"))",
      held: Escapes("out/held.lock"),
    },
    {
      name: "temp_dir in it",
      row: write_row(),
      call: "yes(fs.temp_dir[l](o(c), \"t-\") != None)",
      held: Escapes("out"),
    },
    {
      name: "copy_tree below",
      row: read_write_row() ++ ", abort.raise",
      call: "copied[l](c ++ \"/src\", o(c) ++ \"/copy\")",
      held: Escapes("out/copy"),
    },
    {
      name: "write_file after a link and a step back",
      row: write_row(),
      call: "yes(fs.write_file[l](c ++ \"/a/b/up/../plain\", b\"x\"))",
      held: Escapes("a/b/up/../plain"),
    },
    {
      name: "a link made to lead out",
      row: write_row(),
      call: "yes(fs.symlink[l](c ++ \"/esc\", \"../../elsewhere\"))",
      held: EscapesAs("../../elsewhere"),
    },
    {
      name: "a link made to lead out, below a link that leads up",
      row: write_row(),
      call: "yes(fs.symlink[l](c ++ \"/a/b/up/esc\", \"../../x\"))",
      held: EscapesAs("../../x"),
    },
  ]

/// What the program a nested run tests begins with: how an answer is said, and the links every
/// attempt goes through, each made where it stays inside the root and moved to where it leads out.
fn escaping() -> String =
  \\import std.fs
  \\import std.fs (fs, files)
  \\import std.random (entropy)
  \\
  \\fn yes(b: Bool) -> String = if b { "true" } else { "false" }
  \\
  \\fn kind(k: fs::Kind) -> String =
  \\  match k { fs::File -> "file", fs::Dir -> "dir", fs::Symlink -> "symlink", fs::Missing -> "missing" }
  \\
  \\fn why(r: fs::Refused) -> String =
  \\  match r { fs::NotFound -> "not found", fs::Exists -> "exists", fs::NotAFile -> "not a file", _ -> "refused" }
  \\
  \\fn opened(o: Result<Int, fs::Refused>) -> String = match o { Ok(_) -> "open", Err(r) -> why(r) }
  \\
  \\fn linked(o: Result<Unit, fs::Refused>) -> String = match o { Ok(_) -> "linked", Err(r) -> why(r) }
  \\
  \\fn text(b: Option<Bytes>) -> String = match b { Some(v) -> String::of_bytes_lossy(v), None -> "none" }
  \\
  \\fn g(c: String) -> String = c ++ "/gone"
  \\
  \\fn f(c: String) -> String = c ++ "/file"
  \\
  \\fn o(c: String) -> String = c ++ "/out"
  \\
  \\fn p(c: String) -> String = c ++ "/plain"
  \\
  \\fn atomic<[l]>(path: String) -> String / {fs.read[l], fs.write[l], entropy.next, abort.raise} = {
  \\  let wrote: Result<Unit, (String, fs::Refused)> = try[files.refused] {
  \\    fs::write_atomic[l](path, b"new", fs::Fast, None)
  \\  };
  \\  match wrote { Ok(_) -> "written", Err(_) -> "refused" }
  \\}
  \\
  \\fn copied<[l]>(from: String, to: String) -> String / {fs.read[l], fs.write[l], abort.raise} = {
  \\  let done: Result<fs::Copied<Int>, (String, fs::Refused)> = try[files.refused] {
  \\    fs::copy_tree[l](
  \\      from,
  \\      to,
  \\      { existing: fs::Merge, outside: fs::RefuseLink, entries: 100, bytes: 100000 },
  \\      0,
  \\      |n: Int, _told: fs::Progress| Continue(n + 1),
  \\    )
  \\  };
  \\  match done { Ok(_) -> "copied", Err(_) -> "refused" }
  \\}
  \\
  \\fn planted<[l]>(c: String) -> Unit / {fs.write[l], abort.raise} = {
  \\  let made = fs.create_dir[l](c ++ "/a/b") && fs.create_dir[l](c ++ "/src")
  \\    && fs.write_file[l](p(c), b"p")
  \\    && fs.write_file[l](c ++ "/src/one", b"1")
  \\    && fs.symlink[l](c ++ "/a/b/gone", "../../out/gone")
  \\    && fs.symlink[l](c ++ "/a/b/file", "../../out/secret")
  \\    && fs.symlink[l](c ++ "/a/b/out", "../../out")
  \\    && fs.symlink[l](c ++ "/a/b/up", "../..")
  \\    && fs.rename[l](c ++ "/a/b/gone", g(c))
  \\    && fs.rename[l](c ++ "/a/b/file", f(c))
  \\    && fs.rename[l](c ++ "/a/b/out", o(c));
  \\  assert(made, Some("the links under `" ++ c ++ "` were not made"))
  \\}
  \\

/// The attempt as two tests of one call: against the root `data`, and over the twin.
fn tests_of(i: Int, a: Attempt) -> String = {
  let n = i.to_string();
  let dir = "\"k" ++ n ++ "\"";
  let wanted = match a.held { Returns(said) -> said, _ -> "(refused)" };
  "fn tried_" ++ n ++ "<[l]>(c: String) -> String / {" ++ a.row ++ "} =\n  " ++ a.call ++ "\n\n"
    ++ "test/nondet \"disk "
    ++ n
    ++ ": "
    ++ a.name
    ++ "\" {\n  planted[data]("
    ++ dir
    ++ ");\n  assert_eq(tried_"
    ++ n
    ++ "[data]("
    ++ dir
    ++ "), \""
    ++ wanted
    ++ "\")\n}\n\n"
    ++ "test/nondet \"twin "
    ++ n
    ++ ": "
    ++ a.name
    ++ "\" {\n  let over = fs::on_mem(fs::mem_empty(), || {\n    planted[data]("
    ++ dir
    ++ ");\n    tried_"
    ++ n
    ++ "[data]("
    ++ dir
    ++ ")\n  });\n  assert_eq(over.value, \""
    ++ wanted
    ++ "\")\n}\n\n"
}

/// The entry of a test report's list for the test whose name holds `name`.
fn reported(list: Json, name: String) -> Json =
  match items(list).filter(|r: Json| str(at(r, "name")).contains(name)) { [r, ..] -> r, [] -> Null }

/// What is wrong with how one side of an attempt ended, if anything is.
fn misjudged(report: Json, side: String, i: Int, a: Attempt) -> Option<String> / {abort.raise} = {
  let n = i.to_string();
  let name = side ++ " " ++ n ++ ": " ++ a.name;
  let status = str(at(reported(at(report, "results"), name), "status"));
  let failure = reported(at(report, "failures"), name);
  let code = str(at(at(failure, "diagnostic"), "code"));
  let said = name ++ ": " ++ status ++ " " ++ code ++ " "
    ++ str(at(at(failure, "diagnostic"), "message"));
  let refused = |what: String|
    status == "failed" && (side != "disk" || code == "E0452")
      && json_text(failure).contains("`" ++ what ++ "` leaves the root it was given");
  let right = match a.held {
    Returns(_) -> status == "passed",
    Escapes(below) -> refused("k" ++ n ++ "/" ++ below),
    EscapesAs(what) -> refused(what),
  };
  if right { None } else { Some(said) }
}

test/nondet "no operation reaches through a link that leads out of its root, on the disk or over the twin" {
  empty_working_directory();
  let tried = attempts();
  let each = range(0, tried.len());
  write(
    "m.ply",
    each.fold(escaping(), |text: String, i: Int|
      match tried.at(i) { Some(a) -> text ++ tests_of(i, a), None -> text }),
  );
  write("out/secret", "s");
  assert(fs.create_dir[cwd]("in"), None);
  let report = json_of(spawned(["test", "--json", "--fs", "data=in"], []));
  assert(items(at(report, "results")).len() == 2 * tried.len(), Some(json_text(report)));
  let wrong = each.fold([], |acc: List<String>, i: Int|
    match tried.at(i) {
      Some(a) ->
        ["disk", "twin"].fold(acc, |found: List<String>, side: String|
          match misjudged(report, side, i, a) { Some(why) -> found.push(why), None -> found }),
      None -> acc,
    });
  assert(wrong.len() == 0, Some(wrong.fold("", |all: String, why: String| all ++ why ++ "\n")));
  assert_eq(fs.list_dir[cwd]("out"), Some([{ name: "secret", kind: fs::File }]));
  assert_eq(fs.read_file[cwd]("out/secret"), Some(b"s"))
}
