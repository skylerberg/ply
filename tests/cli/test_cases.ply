import spawning.harness (spawned, Source, write_program, write_project, write, read, test_report,
                         selected, failed, json_of, at, path, items, str, int, bool, json_text)
import std.json (Json, Null)
import std.string

fn vector_test_program(rows: String, double: String) -> String =
  \\type Vector = { name: String, input: Int, want: Int }
  \\
    ++ "\nfn vectors() -> List<Vector> = ["
    ++ rows
    ++ "]\n\nfn double(n: Int) -> Int = "
    ++ double
    ++ "\n\n"
    ++
    \\test "doubles {v.name}" for v: Vector in vectors() {
    \\  assert_eq(double(v.input), v.want)
    \\}
    \\
    \\test "double of nothing is nothing" { assert_eq(double(0), 0) }
    \\

fn row(name: String, input: Int, want: Int) -> String =
  "{ name: \"" ++ name ++ "\", input: " ++ input.to_string() ++ ", want: " ++ want.to_string()
    ++ " }"

fn two_rows() -> String = row("one", 1, 2) ++ ", " ++ row("two", 2, 4)

fn listed(report: Json) -> List<String> =
  items(path(report, ["selection", "tests"])).map(|t: Json| str(at(t, "name")))

fn entry(report: Json, name: String) -> Json =
  match items(path(report, ["selection", "tests"])).filter(|t: Json| str(at(t, "name")) == name) {
    [t, ..] -> t,
    [] -> Null,
  }

fn error_lines(report: Json) -> List<String> =
  items(at(report, "diagnostics")).filter(|d: Json| str(at(d, "severity")) == "error").map(
    |d: Json|
      str(at(d, "code")) ++ " "
        ++ int(
          path(
            match items(at(d, "labels")).filter(|l: Json| bool(at(l, "primary"))) {
              [l, ..] -> l,
              [] -> Null,
            },
            ["start", "line"],
          ),
        ).to_string(
        ),
  )

test/nondet "each case of a table is its own test named by its label, and records the label template of its table" {
  write_program(vector_test_program(two_rows(), "n + n"));
  let report = test_report([]);
  assert_eq(listed(report), ["doubles one", "doubles two", "double of nothing is nothing"]);
  assert_eq(int(path(report, ["summary", "passed"])), 3);
  let one = entry(report, "doubles one");
  let other = entry(report, "doubles two");
  assert_eq(str(at(one, "key")), "m.doubles one");
  assert_eq(str(path(one, ["case", "of"])), "m.doubles {v.name}");
  assert_eq(int(path(one, ["case", "at"])), 0);
  assert_eq(int(path(other, ["case", "at"])), 1);
  assert(str(at(one, "hash")) != str(at(other, "hash")), Some(json_text(report)));
  assert(str(path(one, ["case", "identity"])) != str(path(other, ["case", "identity"])), None);
  assert_eq(at(entry(report, "double of nothing is nothing"), "case"), Null)
}

test/nondet "adding a case anywhere in a table runs only the new case, and the existing cases reuse their cached passes" {
  write_program(vector_test_program(two_rows(), "n + n"));
  let _ = test_report([]);
  write(
    "m.ply",
    vector_test_program(
      row("zero", 0, 0) ++ ", " ++ two_rows() ++ ", " ++ row("three", 3, 6),
      "n + n",
    ),
  );
  let report = test_report([]);
  assert_eq(selected(report), ["doubles zero", "doubles three"]);
  assert_eq(int(path(report, ["summary", "cached"])), 3);
  assert_eq(str(at(entry(report, "doubles one"), "reason")), "cached");
  assert_eq(int(path(entry(report, "doubles one"), ["case", "at"])), 1)
}

test/nondet "rewriting a label or reordering a table does not change any case's cache key, but editing the test body changes every case's key" {
  write_program(vector_test_program(two_rows(), "n + n"));
  let _ = test_report([]);
  let relabelled = vector_test_program(
    row("two", 2, 4) ++ ", " ++ row("one", 1, 2),
    "n + n",
  ).replace(
    "\"doubles {v.name}\"",
    "\"{v.input} doubled is {v.want}\"",
  );
  write("m.ply", relabelled);
  let report = test_report([]);
  assert_eq(selected(report), []);
  assert_eq(listed(report), ["2 doubled is 4", "1 doubled is 2", "double of nothing is nothing"]);
  write(
    "m.ply",
    relabelled.replace("assert_eq(double(v.input), v.want)", "assert_eq(v.want, double(v.input))"),
  );
  assert_eq(selected(test_report([])), ["2 doubled is 4", "1 doubled is 2"])
}

test/nondet "every failing case is reported, each with its own failure, and the passing ones are recorded" {
  write_program(
    vector_test_program(
      two_rows() ++ ", " ++ row("three", 3, 6),
      "if n > 1 { n + n + 1 } else { n + n }",
    ),
  );
  let ran = spawned(["test", ".", "--json"]);
  assert_eq(ran.code, 1);
  let report = json_of(ran);
  assert_eq(failed(report), ["doubles two", "doubles three"]);
  assert_eq(items(at(report, "failures")).map(|f: Json| str(at(f, "name"))), [
    "doubles two",
    "doubles three",
  ]);
  assert_eq(selected(test_report([])), ["doubles two", "doubles three"])
}

test/nondet "`--filter` reads a case's label" {
  write_program(vector_test_program(two_rows() ++ ", " ++ row("three", 3, 6), "n + n"));
  let report = test_report(["--filter", "doubles t"]);
  assert_eq(listed(report), ["doubles two", "doubles three"]);
  assert_eq(int(path(report, ["selection", "filtered_out"])), 2)
}

test/nondet "a table that raises an error makes the whole test fail, under the label it was written with" {
  write_program(
    \\fn table() -> List<Int> / {abort.raise} = [1, 2 / range(0, 0).len()]
    \\
    \\test "holds {n}" for n: Int in table() { assert(n > 0) }
    \\
    \\test "a plain test beside it" { assert(true) }
    \\
  );
  let ran = spawned(["test", ".", "--json"]);
  assert_eq(ran.code, 1);
  let report = json_of(ran);
  assert_eq(failed(report), ["holds {n}"]);
  assert_eq(int(path(report, ["summary", "passed"])), 1);
  assert(
    json_text(at(report, "failures")).contains("division by zero"),
    Some(json_text(at(report, "failures"))),
  )
}

test/nondet "a table is accepted when it uses a `raise` operation, and a table that does raise fails its whole test" {
  write_program(
    \\effect vectors {
    \\  raise missing(name: String)
    \\}
    \\
    \\fn found(n: Int) -> Int / {vectors.missing} =
    \\  if n > 0 { n } else { vectors.missing("none") }
    \\
    \\test "found {n}" for n: Int in [found(1), found(2)] { assert(n > 0) }
    \\
    \\test "missing {n}" for n: Int in [found(1), found(0)] { assert(n > 0) }
    \\
  );
  let ran = spawned(["test", ".", "--json"]);
  assert_eq(ran.code, 1);
  let report = json_of(ran);
  assert_eq(listed(report), ["found 1", "found 2", "missing {n}"]);
  assert_eq(failed(report), ["missing {n}"]);
  assert(
    json_text(at(report, "failures")).contains("m.vectors.missing"),
    Some(json_text(at(report, "failures"))),
  )
}

fn hex() -> Source =
  {
    path: "hex.ply",
    text:
      \\pub type Refusal = { message: String, offset: Int }
      \\
      \\pub fn literal(text: String) -> Result<Int, Refusal> / {abort.raise} =
      \\  range(0, text.len()).fold(Ok(0), |read: Result<Int, Refusal>, i: Int|
      \\    match read {
      \\      Err(_) -> read,
      \\      Ok(n) -> {
      \\        let digit = text.slice(i, i + 1);
      \\        if digits().contains(digit) { Ok(n * 16 + digits().find(digit)) }
      \\        else { Err({ message: "not a hex digit", offset: i }) }
      \\      },
      \\    })
      \\
      \\fn digits() -> String = "0123456789abcdef"
      \\
  }

test/nondet "a tagged literal in a table, a label interpolation or a case body is parsed and checked like a tagged literal anywhere else" {
  write_project([
    hex(),
    {
      path: "m.ply",
      text:
        \\import hex
        \\
        \\test "hex {hex"ff"} holds {n}" for n: Int in [hex"0a", hex"0b"] {
        \\  assert(n + hex"01" > 10)
        \\}
        \\
    },
  ]);
  let report = test_report([]);
  assert_eq(listed(report), ["hex 255 holds 10", "hex 255 holds 11"]);
  assert_eq(int(path(report, ["summary", "passed"])), 2);
  write(
    "m.ply",
    \\import hex
    \\
    \\test "in a table {n}" for n: Int in [hex"0a", hex"zz"] { assert(n > 0) }
    \\
    \\test "in a label {hex"q1"} {n}" for n: Int in [1] { assert(n > 0) }
    \\
    \\test "in a body {n}" for n: Int in [1] { assert(n + hex"x" > 0) }
    \\
  );
  let rejected = spawned(["test", ".", "--json"]);
  assert_eq(rejected.code, 2);
  assert_eq(error_lines(json_of(rejected)), ["E0153 3", "E0153 5", "E0153 7"])
}

fn rows(label: String) -> String =
  \\type Row = { name: String, n: Int }
  \\
  \\fn none() -> List<Int> = []
  \\
  \\test "nothing {n}" for n: Int in none() { assert(n > 0) }
  \\
  \\test "twice {n}" for n: Int in [7, 7] { assert_eq(n, 7) }
  \\
    ++ "\ntest \""
    ++ label
    ++ "\" for r: Row in [{ name: \"a\", n: 1 }, { name: \"a\", n: 2 }] { assert(r.n > 0) }\n"

test/nondet "an empty table produces no test, and a table whose cases have the same label fails the test and names that label" {
  write_program(rows("row {r.name}"));
  let ran = spawned(["test", ".", "--json"]);
  assert_eq(ran.code, 1);
  let report = json_of(ran);
  assert_eq(listed(report), ["twice {n}", "row {r.name}"]);
  assert_eq(failed(report), ["twice {n}", "row {r.name}"]);
  assert_eq(
    items(at(report, "failures")).map(|f: Json| str(path(f, ["diagnostic", "message"]))),
    [
      "the cases at positions 0 and 1 of the table have the same label, \"twice 7\"",
      "the cases at positions 0 and 1 of the table have the same label, \"row a\"",
    ],
  );
  write("m.ply", rows("row {r.name} of {r.n}"));
  let again = json_of(spawned(["test", ".", "--json"]));
  assert_eq(listed(again), ["twice {n}", "row a of 1", "row a of 2"]);
  assert_eq(failed(again), ["twice {n}"]);
  assert_eq(int(path(again, ["summary", "passed"])), 2)
}

fn shared(second: String) -> String =
  "test \"holds {n}\" for n: Int in [1, 2] { assert(n > 0) }\n\ntest \"holds {n}\" for n: Int in "
    ++ second
    ++ " { assert(n > 1) }\n"

test/nondet "two tests over tables can use the same label, but both tests fail if a case in each has the same label" {
  write_program(shared("[3]"));
  let report = test_report([]);
  assert_eq(listed(report), ["holds 1", "holds 2", "holds 3"]);
  assert_eq(int(path(report, ["summary", "passed"])), 3);
  assert_eq(str(path(entry(report, "holds 1"), ["case", "of"])), "m.holds {n}");
  assert_eq(str(path(entry(report, "holds 3"), ["case", "of"])), "m.holds {n} (2)");
  write("m.ply", shared("[2, 3]"));
  let clashed = json_of(spawned(["test", ".", "--json"]));
  assert_eq(failed(clashed), ["holds {n}", "holds {n} (2)"]);
  assert_eq(
    items(at(clashed, "failures")).map(|f: Json| str(path(f, ["diagnostic", "message"]))),
    [
      "the case at position 1 of the table has the label \"holds 2\", which a case of another test also has",
      "the case at position 0 of the table has the label \"holds 2\", which a case of another test also has",
    ],
  )
}

test/nondet "a case's failure lists the definitions the case depends on, and does not list the table's definitions" {
  write_program(vector_test_program(two_rows() ++ ", " ++ row("three", 3, 6), "n + n"));
  let _ = test_report([]);
  write(
    "m.ply",
    vector_test_program(
      row("zero", 0, 0) ++ ", " ++ two_rows() ++ ", " ++ row("three", 3, 6),
      "if n > 2 { n + n + 1 } else { n + n }",
    ),
  );
  let report = json_of(spawned(["test", ".", "--json"]));
  assert_eq(failed(report), ["doubles three"]);
  let failure = match items(at(report, "failures")) { [f, ..] -> f, [] -> Null };
  assert_eq(items(at(failure, "changes")).map(|s: Json| str(at(s, "name"))), ["m.double"]);
  assert_eq(items(at(report, "diffs")).map(|d: Json| str(at(d, "name"))), ["m.double"])
}

test/nondet "each seeded case is searched" {
  write_program(String::of_bytes_lossy(embed("../programs/test_cases/seeded_case.ply")));
  assert_eq(int(path(test_report([]), ["simulation", "simulated"])), 2)
}

fn lengths() -> String = String::of_bytes_lossy(embed("../programs/test_cases/lengths.ply"))

test/nondet "a case's type is inferred from the values that build it, so values of a type with a `key` declaration are distinguished by their data" {
  write_program(lengths());
  let report = test_report([]);
  assert_eq(listed(report), [
    "each `Length` case Metres(2) equals `Metres(2)`",
    "each `Length` case Millimetres(2000) equals `Metres(2)`",
    "each `Cut` case Metres(1) has a `name` field equal to `a`",
    "each `Cut` case Millimetres(1000) has a `name` field equal to `a`",
  ]);
  assert_eq(int(path(report, ["summary", "passed"])), 4);
  let identity = |name: String| str(path(entry(report, name), ["case", "identity"]));
  assert(
    identity("each `Length` case Metres(2) equals `Metres(2)`")
      != identity("each `Length` case Millimetres(2000) equals `Metres(2)`"),
    None,
  );
  assert(
    identity("each `Cut` case Metres(1) has a `name` field equal to `a`")
      != identity("each `Cut` case Millimetres(1000) has a `name` field equal to `a`"),
    None,
  );
  write(
    "m.ply",
    lengths()
      ++
      \\
      \\type Named = | Named(String, () -> Int)
      \\
      \\key for Named by name_of
      \\
      \\fn name_of(n: Named) -> String = match n { Named(name, _) -> name }
      \\
      \\fn named() -> List<Named> = [Named("a", || 1), Named("a", || 2)]
      \\
      \\fn hashed() -> Bytes = digest(named())
      \\
      \\test "named {name_of(n)}" for n: Named in named() { assert(name_of(n) == "a") }
      \\
      ,
  );
  let checked = json_of(spawned(["check", ".", "--json"]));
  assert_eq(error_lines(checked), ["E0206 30"]);
  assert(
    json_text(checked).contains(
      "does not replace the constraint on the type that declares the case",
    ),
    Some(json_text(checked)),
  )
}

test/nondet "two cases that are equal under `==` but built differently stay separate tests, and one's cached pass is not reused for the other" {
  write_program(
    \\import std.show (show)
    \\
    \\test "prints {d}" for d: Decimal in [1.5m, 1.50m] { assert_eq(show(d), "1.5") }
    \\
  );
  let first = spawned(["test", ".", "--json"]);
  assert_eq(first.code, 1);
  assert_eq(listed(json_of(first)), ["prints 1.5", "prints 1.50"]);
  assert_eq(failed(json_of(first)), ["prints 1.50"]);
  let second = spawned(["test", ".", "--json"]);
  assert_eq(second.code, 1);
  let report = json_of(second);
  assert_eq(failed(report), ["prints 1.50"]);
  assert_eq(selected(report), ["prints 1.50"]);
  assert_eq(str(at(entry(report, "prints 1.5"), "reason")), "cached");
  assert(
    path(entry(report, "prints 1.5"), ["case", "identity"])
      != path(entry(report, "prints 1.50"), ["case", "identity"]),
    Some(json_text(report)),
  )
}

test/nondet "`ply fmt` formats a test over cases and leaves its label text unchanged, because the label is the test's name" {
  write_program("test   \"n { n+1 } of {{3}}\"   for  n :Int  in  [1,2]   { assert(n > 0) }\n");
  assert_eq(spawned(["fmt", "m.ply"]).code, 0);
  assert_eq(spawned(["fmt", "--check", "m.ply"]).code, 0);
  assert_eq(
    read("m.ply"),
    Some("test \"n { n+1 } of {{3}}\" for n: Int in [1, 2] { assert(n > 0) }\n"),
  );
  assert_eq(listed(test_report([])), ["n 2 of {3}", "n 3 of {3}"])
}
