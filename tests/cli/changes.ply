//! A test that passed and now fails: the definitions that changed under it since it passed, and how
//! each one's text changed, read from what the passing run stored.

import spawning.harness (WorkingDirectory, PlyProcess, Source, write_program, write_project, write,
                         spawned, all_output, stdout, json_of, at, nth, items, str, json_text,
                         test_report, manifest, dependency)
import std.json
import std.json (Json)
import std.string
import std.list

fn ledger() -> String =
  \\fn normal_sign(n: Int) -> Int = if n < 0 { 0 - 1 } else { 1 }
  \\
  \\fn balance(a: Int, b: Int, c: Int) -> Int = (a + b) + c
  \\
  \\fn presented(a: Int, b: Int, c: Int) -> Int = balance(a, b, c) * normal_sign(a)
  \\
  \\test "balance never goes negative" { assert_eq(presented(1, 2, 3), 6) }
  \\

/// The edit that breaks the test, beside one that only regroups a sum.
fn both_edits(s: String) -> String =
  s.replace("if n < 0 { 0 - 1 } else { 1 }", "if n < 0 { 0 - 1 } else { 0 - 1 }").replace(
    "(a + b) + c",
    "a + (b + c)",
  )

/// The program tested green, then edited into `edited`.
fn passed_then(
  source: String,
  edited: String,
) -> Unit / {PlyProcess, WorkingDirectory, abort.raise} = {
  write_program(source);
  let r = spawned(["test", "."]);
  assert(r.code == 0, Some(all_output(r)));
  assert(edited != source, Some("the edit did not apply"));
  write("m.ply", edited)
}

fn names(xs: Json) -> List<String> = items(xs).map(|x: Json| str(at(x, "name")))

test/nondet "a failure after two edits names both and shows how each one's text changed" {
  passed_then(ledger(), both_edits(ledger()));
  let r = spawned(["test", "."]);
  assert(r.code == 1, Some(all_output(r)));
  let text = stdout(r);
  assert(
    text.contains("changes: m.balance (edited), m.normal_sign (edited), m.presented (derived)"),
    Some(text),
  );
  assert(text.contains("changed since the failing tests last passed:"), Some(text));
  assert(text.contains("m.normal_sign (edited)   m.ply:1:1"), Some(text));
  assert(
    text.contains("-fn normal_sign(n: Int) -> Int = if n < 0 { 0 - 1 } else { 1 }"),
    Some(text),
  );
  assert(
    text.contains("+fn normal_sign(n: Int) -> Int = if n < 0 { 0 - 1 } else { 0 - 1 }"),
    Some(text),
  );
  assert(text.contains("+fn balance(a: Int, b: Int, c: Int) -> Int = a + (b + c)"), Some(text));
  // The document carries the same changes, each diff whole.
  let v = test_report([]);
  let failure = nth(at(v, "failures"), 0);
  assert(
    names(at(failure, "changes")) == ["m.balance", "m.normal_sign", "m.presented"],
    Some(json_text(failure)),
  );
  assert(names(at(v, "diffs")) == ["m.balance", "m.normal_sign"], Some(json_text(v)));
  assert(
    str(at(nth(at(v, "diffs"), 1), "diff"))
      == "--- m.normal_sign\n+++ m.normal_sign\n@@ -1 +1 @@\n-fn normal_sign(n: Int) -> Int = if n < 0 { 0 - 1 } else { 1 }\n+fn normal_sign(n: Int) -> Int = if n < 0 { 0 - 1 } else { 0 - 1 }\n",
    Some(json_text(v)),
  )
}

test/nondet "an edited test is the first change, and its diff is shown with the rest" {
  passed_then(
    ledger(),
    ledger().replace("presented(1, 2, 3), 6", "presented(1, 2, 3), 7").replace(
      "(a + b) + c",
      "a + (b + c)",
    ),
  );
  let v = test_report([]);
  let first = nth(at(nth(at(v, "failures"), 0), "changes"), 0);
  assert(str(at(first, "name")) == "m.balance never goes negative", Some(json_text(first)));
  assert(at(first, "test") == json_true(), Some(json_text(first)));
  assert(
    names(at(v, "diffs")) == ["m.balance never goes negative", "m.balance"],
    Some(json_text(v)),
  );
  assert(
    str(at(nth(at(v, "diffs"), 0), "diff")).contains(
      "+test \"balance never goes negative\" { assert_eq(presented(1, 2, 3), 7) }",
    ),
    Some(json_text(v)),
  )
}

fn json_true() -> Json = json::Bool(true)

// The diff reads each module's text by the index the analysis gives it, which an earlier file moves.
test/nondet "an earlier file does not move a diff off its definition" {
  write_project([
    { path: "m.ply", text: ledger() },
    { path: "a.ply", text: String::of_bytes_lossy(embed("../programs/changes/earlier_file.ply")) },
  ]);
  assert(spawned(["test", "."]).code == 0, None);
  write("m.ply", both_edits(ledger()));
  let v = test_report([]);
  let diffs = items(at(v, "diffs"));
  assert(names(at(v, "diffs")) == ["m.balance", "m.normal_sign"], Some(json_text(v)));
  assert(
    diffs.all(|d: Json| {
      let name = str(at(d, "name")).replace("m.", "");
      str(at(d, "diff")).contains("-fn " ++ name ++ "(")
        && str(at(d, "diff")).contains("+fn " ++ name ++ "(")
    }),
    Some(json_text(v)),
  )
}

test/nondet "a removed definition is shown as it was, and an added one as it is" {
  let before = String::of_bytes_lossy(embed("../programs/changes/removed_and_added.ply"));
  passed_then(
    before,
    before.replace("fn spare() -> Int = 1", "fn bump() -> Int = 2").replace(
      "= spare()",
      "= bump()",
    ),
  );
  let v = test_report([]);
  assert(names(at(v, "diffs")) == ["m.bump", "m.spare", "m.total"], Some(json_text(v)));
  let diff = |i: Int| str(at(nth(at(v, "diffs"), i), "diff"));
  assert(
    diff(0).contains("\n+fn bump() -> Int = 2") && !diff(0).contains("\n-fn"),
    Some(json_text(v)),
  );
  assert(
    diff(1).contains("\n-fn spare() -> Int = 1") && !diff(1).contains("\n+fn"),
    Some(json_text(v)),
  );
  // A removed definition is nowhere now.
  assert(at(nth(at(v, "diffs"), 1), "location") == json::Null, Some(json_text(v)))
}

/// A package `lib` that `app` reaches by a path, and a test in `app` that reaches through it.
fn two_packages(factor: String) -> List<Source> =
  [
    { path: "app/ply.pkg", text: manifest("app", dependency("lib", "../lib")) },
    {
      path: "app/main.ply",
      text: "import lib.sums\n\nfn total() -> Int = sums::scaled(2)\n\ntest \"total doubles\" { assert_eq(total(), 4) }\n",
    },
    { path: "lib/ply.pkg", text: manifest("lib", "") },
    { path: "lib/sums.ply", text: "pub fn scaled(n: Int) -> Int = n * " ++ factor ++ "\n" },
  ]

// Diagnosis reads each module's text by the index the analysis gives it, and parses and resolves
// nothing again, so a tree of several packages reports like one of one.
test/nondet "a failure through a path dependency names the dependency's edit and shows its diff" {
  write_project(two_packages("2"));
  let first = spawned(["test", "app"]);
  assert(first.code == 0, Some(all_output(first)));
  write("lib/sums.ply", "pub fn scaled(n: Int) -> Int = n * 3\n");
  let r = spawned(["test", "app", "--json"]);
  assert(r.code == 1, Some(all_output(r)));
  let v = json_of(r);
  let failure = nth(at(v, "failures"), 0);
  assert(names(at(failure, "changes")).contains("lib.sums.scaled"), Some(json_text(v)));
  assert(names(at(v, "diffs")) == ["lib.sums.scaled"], Some(json_text(v)));
  assert(
    str(at(nth(at(v, "diffs"), 0), "diff")).contains(
      "-pub fn scaled(n: Int) -> Int = n * 2\n+pub fn scaled(n: Int) -> Int = n * 3\n",
    ),
    Some(json_text(v)),
  )
}
