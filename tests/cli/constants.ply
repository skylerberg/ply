//! `const fn` as a run reads it: the body runs at the first read, every later read in the process
//! returns the same value, and a raise that leaves the body ends the run.

import harness (RunResult, Source, write_project, read, spawned, json_of, at, str, int,
                diagnostic_codes, diagnostic, stdout, all_output, assert_ok, manifest, dependency,
                value_of, PlyProcess)
import std.string

/// A module that reads the numbers a text holds, one a line, as their squares.
fn squares() -> Source =
  { path: "squares.ply", text: String::of_bytes_lossy(embed("../programs/constants/squares.ply")) }

/// A program whose table is a `const fn` over `numbers.txt`: `main` answers the sum of the table,
/// and its test holds a read of the table to what its body makes.
fn table_program() -> Source =
  {
    path: "m.ply",
    text:
      \\import squares (parsed)
      \\
      \\const fn table() -> Array<Int> = parsed(embed("numbers.txt"))
      \\
      \\fn computed() -> Array<Int> / {abort.raise} = parsed(embed("numbers.txt"))
      \\
      \\fn main() -> Int / {abort.raise} =
      \\  range(0, table().len()).fold(0, |sum: Int, i: Int| sum + table().get(i))
      \\
      \\test "the table read is the table its body makes" { assert_eq(table(), computed()) }
      \\
  }

fn numbers(text: String) -> Source = { path: "numbers.txt", text: text }

fn program(text: String) -> List<Source> = [squares(), table_program(), numbers(text)]

fn passed(ran: RunResult) -> Int / {abort.raise} = int(at(at(json_of(ran), "summary"), "passed"))

/// What `main` returned in `ply run` with `args`.
fn returned(args: List<String>) -> String / {PlyProcess, abort.raise} =
  value_of(spawned(["run", "--json"].concat(args)))

test/nondet "a `const fn` runs at its first read, and the run reads its value" {
  write_project(program("1\n2\n3\n"));
  assert_ok(spawned(["check"]));
  assert_eq(returned([]), "14");
  let tested = spawned(["test", "--json", "--no-cache"]);
  assert_ok(tested);
  assert_eq(passed(tested), 1)
}

test/nondet "a `const fn` performs nothing where it is called, whatever its body could raise" {
  write_project(program("1\n"));
  let types = stdout(spawned(["check", "--types"]));
  match types.split_once("   m m.ply") {
    None -> panic("no heading for `m` in:\n" ++ types),
    // No row follows `table`'s type, where one follows `computed`'s.
    Some(cut) -> {
      assert(cut.tail.contains("table    : () -> Array<Int>\n     computed : "), Some(types));
      assert(
        cut.tail.contains("computed : () -> Array<Int>\n                / {abort.raise"),
        Some(types),
      )
    },
  }
}

// The check reads nothing of what the body returns: one that raises ends the run where it is first
// read, which the row it writes says cannot raise, so no handler there takes it.
test/nondet "a `const fn` that raises passes the check, and ends the run at its first read past any handler" {
  let source = String::of_bytes_lossy(embed("../programs/constants/raising_constant.ply"));
  write_project([{ path: "m.ply", text: source }]);
  assert_ok(spawned(["check"]));
  let ran = spawned(["run", "--json"]);
  let v = json_of(ran);
  assert_eq(ran.code, 1);
  assert(str(at(diagnostic(v), "message")).contains("division by zero"), Some(all_output(ran)));
  assert(all_output(ran).contains("`const fn` must return a value"), Some(all_output(ran)))
}

test/nondet "a `const fn` takes nothing, performs nothing and returns data, or the check says which it is not" {
  let rejected = |text: String| {
    write_project([{ path: "m.ply", text: text }]);
    diagnostic_codes(json_of(spawned(["check", "--json"])))
  };
  assert_eq(rejected("const fn f(n: Int) -> Int = n\n"), ["E0156"]);
  assert_eq(rejected("const fn f<a>() -> List<a> = []\n"), ["E0156"]);
  assert_eq(rejected("const fn f() -> Int / {abort.raise} = 1\n"), ["E0156"]);
  assert_eq(rejected("const fn f() -> Int = f()\n"), ["E0156"]);
  assert_eq(rejected("const fn f() -> (Int) -> Int = |x: Int| x\n"), ["E0156"]);
  assert_eq(
    rejected("effect ticks { read now() -> Int }\n\nconst fn f() -> Int = ticks.now()\n"),
    ["E0156"],
  );
  // `const` is a name wherever no `fn` follows it.
  assert_eq(
    rejected(
      "const fn f() -> Int = 1\n\nfn const(const: Int) -> Int = const + f()\n\nfn main() -> Int = const(2)\n",
    ),
    [],
  )
}

/// A program that answers its table's length a thousandfold and the table's sum beside it, each a
/// `const fn`.
fn measuring() -> Source =
  {
    path: "m.ply",
    text:
      \\import squares (parsed)
      \\
      \\const fn table() -> Array<Int> = parsed(embed("numbers.txt"))
      \\
      \\const fn total() -> Int = table().to_list().fold(0, |sum: Int, n: Int| sum + n)
      \\
      \\fn main() -> Int = table().len() * 1000 + total()
      \\
  }

test/nondet "a run of an artifact works out the constants it reads" {
  write_project([squares(), measuring(), numbers("1\n2\n3\n")]);
  assert_ok(spawned(["build", ".", "-o", "m.plyx"]));
  assert_eq(returned(["m.plyx"]), "3014")
}

/// A package `lib` whose table is a `const fn`, and an `app` that reads it.
fn depending(table: String) -> List<Source> =
  [
    { path: "app/ply.pkg", text: manifest("app", dependency("lib", "../lib")) },
    {
      path: "app/main.ply",
      text:
        \\import lib.table
        \\
        \\fn main() -> Int = table::squares().len() * 1000
        \\
    },
    { path: "lib/ply.pkg", text: manifest("lib", "") },
    { path: "lib/table.ply", text: table },
  ]

test/nondet "a dependency's `const fn` is read by the program that reaches it, warm as cold" {
  let table =
    \\pub const fn squares() -> Array<Int> =
    \\  Array::of_list(range(0, 100).map(|i: Int| i * i).filter(|n: Int| n < 25))
    \\
    \\pub const fn unread() -> Int = 7
    \\
  ;
  write_project(depending(table));
  assert_eq(returned(["app"]), "5000");
  assert_ok(spawned(["check", "app", "--explain"]));
  assert_ok(spawned(["check", "app", "--explain"]));
  assert_eq(returned(["app"]), "5000")
}

test/nondet "a mutant of what a `const fn` reaches is caught through the constant" {
  let source = String::of_bytes_lossy(embed("../programs/constants/constant_mutation.ply"));
  write_project([{ path: "m.ply", text: source }]);
  assert_ok(spawned(["test"]));
  let mutated = spawned(["test", "--mutate", "m.bump", "--json"]);
  let m = at(json_of(mutated), "mutants");
  assert(int(at(m, "killed")) >= 1, Some(all_output(mutated)));
  assert_eq(int(at(m, "survived")), 0)
}

test/nondet "a `const fn` is printed as it is written, and documented as one" {
  write_project([
    { path: "m.ply", text: "/// The answer.\npub   const   fn answer( ) -> Int = 42\n" },
  ]);
  assert_ok(spawned(["fmt"]));
  assert_eq(read("m.ply"), Some("/// The answer.\npub const fn answer() -> Int = 42\n"));
  let doc = stdout(spawned(["doc", "m.answer"]));
  assert(doc.contains("pub const fn answer() -> Int"), Some(doc))
}
