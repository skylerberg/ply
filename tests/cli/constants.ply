//! `const fn` as a load settles it: a build evaluates the definition before anything runs, keeps
//! its value under the hash of all the definition reaches, and every unit it emits after holds the
//! value in place of the body. One that cannot be evaluated is refused at its definition by every
//! command that would otherwise run it.

import harness (Ran, Source, project, write, read, spawned, json_of, at, nth, items, str, int,
                codes, diagnostic, stdout, said, assert_ok, manifest, dep, value_of, Here, Spawned)
import std.json (Json)
import std.string

/// A module that reads the numbers a text holds, one a line, as their squares.
fn squares() -> Source =
  {
    path: "squares.ply",
    text:
      \\import std.string
      \\
      \\pub fn parsed(text: Bytes) -> Array<Int> / {abort.raise} =
      \\  Array::of_list(
      \\    String::of_bytes(text).split("\n").filter(|line: String| line != "").map(square),
      \\  )
      \\
      \\fn square(line: String) -> Int / {abort.raise} =
      \\  match line.int_of_string() { Some(n) -> n * n, None -> panic("no number in `" ++ line ++ "`") }
      \\
  }

/// A program whose table is a `const fn` over `numbers.txt`: `main` answers the sum of the table,
/// and its test holds a read of the table to what its body makes.
fn holding() -> Source =
  {
    path: "m.ply",
    text:
      \\import squares (parsed)
      \\
      \\const fn table() -> Array<Int> = parsed(embed("numbers.txt"))
      \\
      \\fn computed() -> Array<Int> / {abort.raise} = parsed(embed("numbers.txt"))
      \\
      \\fn main() -> Int / {abort.raise} =
      \\  range(0, table().len()).fold(0, |sum: Int, i: Int| sum + table().get(i))
      \\
      \\test "the table read is the table its body makes" { assert_eq(table(), computed()) }
      \\
  }

fn numbers(text: String) -> Source = { path: "numbers.txt", text: text }

fn program(text: String) -> List<Source> = [squares(), holding(), numbers(text)]

fn put(source: Source) -> Unit / {Here, abort.raise} = write(source.path, source.text)

fn passed(ran: Ran) -> Int / {abort.raise} = int(at(at(json_of(ran), "summary"), "passed"))

/// What `main` returned in `ply run` with `args`.
fn answered(args: List<String>) -> String / {Spawned, abort.raise} =
  value_of(spawned(["run", "--json"].concat(args)))

test/nondet "a `const fn` is evaluated by the build, and a run reads its value" {
  project(program("1\n2\n3\n"));
  assert_ok(spawned(["check"]));
  assert_eq(answered([]), "14");
  let tested = spawned(["test", "--json", "--no-cache"]);
  assert_ok(tested);
  assert_eq(passed(tested), 1)
}

test/nondet "a `const fn` performs nothing where it is called, whatever its body could raise" {
  project(program("1\n"));
  let types = stdout(spawned(["check", "--types"]));
  match types.split_once("   m m.ply") {
    None -> panic("no heading for `m` in:\n" ++ types),
    // No row follows `table`'s type, where one follows `computed`'s.
    Some(cut) -> {
      assert(cut.tail.contains("table    : () -> Array<Int>\n     computed : "), Some(types));
      assert(
        cut.tail.contains("computed : () -> Array<Int>\n                / {abort.raise"),
        Some(types),
      )
    },
  }
}

test/nondet "a value is evaluated again when its body, what it reaches or a file it embeds moves" {
  project(program("1\n2\n3\n"));
  assert_eq(answered([]), "14");
  // The file it embeds.
  put(numbers("1\n2\n3\n4\n"));
  assert_eq(answered([]), "30");
  // What it reaches, in another module.
  let cubed = {
    path: "squares.ply",
    text: squares().text.replace("Some(n) -> n * n", "Some(n) -> n * n * n"),
  };
  put(cubed);
  assert_eq(answered([]), "100");
  // Its own body.
  let doubled = {
    path: "m.ply",
    text: holding().text.replace(
      "const fn table() -> Array<Int> = parsed(embed(\"numbers.txt\"))",
      "const fn table() -> Array<Int> = parsed(embed(\"numbers.txt\").concat(b\"5\\n\"))",
    ),
  };
  put(doubled);
  assert_eq(answered([]), "225");
  // Back where it was, the value kept then answers again.
  put(squares());
  put(holding());
  assert_eq(answered([]), "30")
}

/// A module whose table holds values of a type of its own, and a reading of them.
fn kinds(module: String) -> Source =
  {
    path: module ++ ".ply",
    text:
      \\pub type Kind = | Plain | Sized(Int)
      \\
      \\pub const fn table() -> List<Kind> = [Plain, Sized(3)]
      \\
      \\pub fn sizes() -> Int =
      \\  table().fold(0, |sum: Int, kind: Kind| match kind { Plain -> sum, Sized(n) -> sum + n })
      \\
  }

fn reading(modules: List<String>, sum: String) -> Source =
  {
    path: "main.ply",
    text: String::join(modules.map(|m: String| "import " ++ m ++ "\n"), "")
      ++ "\nfn main() -> Int = "
      ++ sum
      ++ "\n",
  }

// One definition under two modules' names hashes as one, and a kept value names its constructors.
test/nondet "one `const fn` text in two modules is two values, each of its own module's constructors" {
  project([
    kinds("first"),
    kinds("second"),
    reading(["first", "second"], "first::sizes() * 10 + second::sizes()"),
  ]);
  assert_eq(answered([]), "33");
  // What a build of one kept is none of the other's, read by a later build.
  project([kinds("first"), reading(["first"], "first::sizes()")]);
  assert_eq(answered([]), "3");
  put(kinds("second"));
  put(reading(["second"], "second::sizes() + 4"));
  assert_eq(answered([]), "7")
}

test/nondet "a `const fn` that raises is refused at its definition, where it raised beside it" {
  project(program("1\ntwo\n"));
  let ran = spawned(["check", "--json"]);
  assert_eq(ran.code, 2);
  let v = json_of(ran);
  assert_eq(codes(v), ["E0157"]);
  assert(
    str(at(diagnostic(v), "message")).contains("`m.table` is `const`, and raised"),
    Some(said(ran)),
  );
  assert(str(at(diagnostic(v), "message")).contains("no number in `two`"), Some(said(ran)));
  let labels = items(at(diagnostic(v), "labels"));
  assert_eq(labels.map(|l: Json| str(at(l, "file"))), ["m.ply", "squares.ply"]);
  assert_eq(int(at(at(nth(at(diagnostic(v), "labels"), 0), "start"), "line")), 3);
  assert_eq(str(at(nth(at(diagnostic(v), "labels"), 1), "message")), "raised here")
}

test/nondet "every command that would run a `const fn` refuses the one a build cannot evaluate" {
  project(program("1\ntwo\n"));
  [["run"], ["test"], ["prove"], ["build", ".", "-o", "m.plyx"]].fold(
    (),
    |_: Unit, line: List<String>| {
      let ran = spawned(line);
      assert_eq(ran.code, 2);
      assert(said(ran).contains("E0157"), Some(said(ran)))
    },
  )
}

test/nondet "a refused `const fn` is refused again by a check that reads its module's stub, and mended by its file" {
  project(program("1\ntwo\n"));
  assert_eq(spawned(["check", "--explain"]).code, 2);
  let second = spawned(["check", "--explain"]);
  assert_eq(second.code, 2);
  assert(said(second).contains("E0157"), Some(said(second)));
  put(numbers("1\n2\n"));
  assert_ok(spawned(["check", "--explain"]));
  // A warm check and a warm run answer what the cold ones did.
  assert_ok(spawned(["check", "--explain"]));
  assert_eq(answered([]), "5")
}

test/nondet "a `const fn` is what a build can evaluate and keep, or the check says which it is not" {
  let refused = |text: String| {
    project([{ path: "m.ply", text: text }]);
    codes(json_of(spawned(["check", "--json"])))
  };
  assert_eq(refused("const fn f(n: Int) -> Int = n\n"), ["E0156"]);
  assert_eq(refused("const fn f<a>() -> List<a> = []\n"), ["E0156"]);
  assert_eq(refused("const fn f() -> Int / {abort.raise} = 1\n"), ["E0156"]);
  assert_eq(refused("const fn f() -> Int = f()\n"), ["E0156"]);
  assert_eq(refused("const fn f() -> (Int) -> Int = |x: Int| x\n"), ["E0156"]);
  assert_eq(
    refused("effect ticks { read now() -> Int }\n\nconst fn f() -> Int = ticks.now()\n"),
    ["E0156"],
  );
  // `const` is a name wherever no `fn` follows it.
  assert_eq(
    refused(
      "const fn f() -> Int = 1\n\nfn const(const: Int) -> Int = const + f()\n\nfn main() -> Int = const(2)\n",
    ),
    [],
  )
}

/// A program that answers its table's length a thousandfold and the table's sum beside it, each a
/// `const fn`.
fn measuring() -> Source =
  {
    path: "m.ply",
    text:
      \\import squares (parsed)
      \\
      \\const fn table() -> Array<Int> = parsed(embed("numbers.txt"))
      \\
      \\const fn total() -> Int = table().to_list().fold(0, |sum: Int, n: Int| sum + n)
      \\
      \\fn main() -> Int = table().len() * 1000 + total()
      \\
  }

test/nondet "an artifact holds the value, and a run of it answers it" {
  project([squares(), measuring(), numbers("1\n2\n3\n")]);
  assert_ok(spawned(["build", ".", "-o", "m.plyx"]));
  assert_eq(answered(["m.plyx"]), "3014")
}

/// A `const fn` over a scanner written in a range pattern and a sum that wraps, which `main`
/// answers a thousandfold.
fn scanning() -> Source =
  {
    path: "m.ply",
    text:
      \\fn digit(b: Int) -> Option<U8> / {abort.raise} =
      \\  match b { b'0'..=b'9' -> Some(U8::of_int(b - b'0')), _ -> None }
      \\
      \\fn summed(text: Bytes) -> U8 / {abort.raise} =
      \\  range(0, text.len()).fold(250u8, |sum: U8, i: Int|
      \\    match digit(text.at(i)) { Some(d) -> sum +% rotl(d, 8), None -> sum })
      \\
      \\const fn kept() -> U8 = summed(b"4 and 9")
      \\
      \\fn main() -> Int = Int::of_u8(kept()) * 1000
      \\
  }

test/nondet "an artifact of a `const fn` written in a range pattern and a wrapping operator runs to its value" {
  project([scanning()]);
  assert_eq(answered([]), "7000");
  assert_ok(spawned(["build", ".", "-o", "m.plyx"]));
  assert_eq(answered(["m.plyx"]), "7000")
}

/// A package `lib` whose table is a `const fn`, and an `app` that reads it.
fn depending(table: String) -> List<Source> =
  [
    { path: "app/ply.pkg", text: manifest("app", dep("lib", "../lib")) },
    {
      path: "app/main.ply",
      text:
        \\import lib.table
        \\
        \\fn main() -> Int = table::squares().len() * 1000
        \\
    },
    { path: "lib/ply.pkg", text: manifest("lib", "") },
    { path: "lib/table.ply", text: table },
  ]

test/nondet "a dependency's `const fn` is evaluated for the program that reaches it, warm as cold" {
  let table =
    \\pub const fn squares() -> Array<Int> =
    \\  Array::of_list(range(0, 100).map(|i: Int| i * i).filter(|n: Int| n < 25))
    \\
    \\pub const fn unread() -> Int = 7
    \\
  ;
  project(depending(table));
  assert_eq(answered(["app"]), "5000");
  assert_ok(spawned(["check", "app", "--explain"]));
  assert_ok(spawned(["check", "app", "--explain"]));
  assert_eq(answered(["app"]), "5000")
}

test/nondet "a dependency's `const fn` that raises refuses the program that holds it, where it is written" {
  let table =
    \\pub const fn squares() -> Array<Int> = Array::of_list([1 / none()])
    \\
    \\fn none() -> Int = 0
    \\
  ;
  project(depending(table));
  let first = spawned(["check", "app", "--json"]);
  let v = json_of(first);
  assert_eq(codes(v), ["E0157"]);
  assert(
    str(at(nth(at(diagnostic(v), "labels"), 0), "file")).ends_with("lib/table.ply"),
    Some(said(first)),
  );
  // Read through its package's stub by the next check, it is refused the same.
  assert_eq(codes(json_of(spawned(["check", "app", "--json"]))), ["E0157"])
}

test/nondet "a mutant of what a `const fn` reaches runs its body, never the value kept of the original" {
  let source =
    \\fn bump(n: Int) -> Int = n + 1
    \\
    \\const fn table() -> List<Int> = range(0, 3).map(bump)
    \\
    \\test "the table holds each number bumped" { assert_eq(table(), [1, 2, 3]) }
    \\
  ;
  project([{ path: "m.ply", text: source }]);
  assert_ok(spawned(["test"]));
  let mutated = spawned(["test", "--mutate", "m.bump", "--json"]);
  let m = at(json_of(mutated), "mutants");
  assert(int(at(m, "killed")) >= 1, Some(said(mutated)));
  assert_eq(int(at(m, "survived")), 0)
}

test/nondet "a `const fn` nothing calls is evaluated with the rest, in the program's own modules" {
  let unused = {
    path: "m.ply",
    text: "const fn broken() -> Int = 1 / none()\n\nfn none() -> Int = 0\n\nfn main() -> Int = 7\n",
  };
  project([unused]);
  assert_eq(codes(json_of(spawned(["check", "--json"]))), ["E0157"])
}

test/nondet "a `const fn` is printed as it is written, and documented as one" {
  project([{ path: "m.ply", text: "/// The answer.\npub   const   fn answer( ) -> Int = 42\n" }]);
  assert_ok(spawned(["fmt"]));
  assert_eq(read("m.ply"), Some("/// The answer.\npub const fn answer() -> Int = 42\n"));
  let doc = stdout(spawned(["doc", "m.answer"]));
  assert(doc.contains("pub const fn answer() -> Int"), Some(doc))
}
