//! `ply run --json` reports what the machine reused, and the counts follow the program.

import spawning.harness (WorkingDirectory, PlyProcess, spawned, write_program, json_of, at, int,
                         json_text)
import std.json (Json, Number)

/// The growing field last, so the machine can reuse at every step and the counts are round.
fn appends(n: Int) -> String =
  \\fn build(n: Int) -> List<Int> / {abort.raise} =
  \\  iterate({i: 0, out: []}, n + 1, |s: {i: Int, out: List<Int>}|
  \\    if s.i >= n { Stop(s.out) } else { Continue({i: s.i + 1, out: s.out.push(s.i)}) })
  \\fn main() -> Int / {abort.raise} = build(
    ++ n.to_string()
    ++ ").len()\n"

fn counters(n: Int) -> Json / {PlyProcess, WorkingDirectory, abort.raise} = {
  write_program(appends(n));
  at(json_of(spawned(["run", "--json", "m.ply"])), "counters")
}

// How a push spends updates past the one that appends is the list's own layout, so the counts are
// held to the appends from below.
test/nondet "the machine reports what it reused" {
  let c = counters(200);
  assert(int(at(c, "updates")) >= 200, Some("200 appends were made: " ++ json_text(c)));
  // The C backend reads `s.out` with a count of its own rather than taking the field, so the ratio is not 1.0.
  match at(c, "in_place") {
    Number(ratio) -> assert(ratio >= 0m && ratio <= 1m, Some(json_text(c))),
    _ -> panic("the reuse ratio is reported: " ++ json_text(c)),
  }
}

test/nondet "the counts follow the program rather than being a constant" {
  let few = int(at(counters(10), "updates"));
  let many = int(at(counters(200), "updates"));
  assert(few >= 10 && many - few >= 190, Some(few.to_string() ++ " and " ++ many.to_string()))
}

fn fills(n: Int) -> String =
  \\fn fill(xs: Array<Int>, i: Int) -> Array<Int> / {abort.raise} =
  \\  if i >= xs.len() { xs } else { fill(xs.set(i, i), i + 1) }
  \\fn main() -> Int / {abort.raise} = fill(Array::new(
    ++ n.to_string()
    ++ ", 0), 0).len()\n"

test/nondet "an array handed down to its last holder is written in place at every step" {
  write_program(fills(100));
  let c = at(json_of(spawned(["run", "--json", "m.ply"])), "counters");
  assert(int(at(c, "updates")) >= 100, Some("100 writes were made: " ++ json_text(c)));
  assert(
    int(at(c, "updates_in_place")) == int(at(c, "updates")),
    Some("every write is in place: " ++ json_text(c)),
  )
}
