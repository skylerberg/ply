//! Every kind of edit to every kind of item, through the sessions `edit_gate` makes: many spawned
//! runs for each fixture, so these run nightly and in no pull request.

import edit_gate (every_edit, fixture_names, session_agrees)

test/nondet "{name} agrees warm and cold through every edit to its modules" for name: String in fixture_names(
  ) { session_agrees(name, { edits: every_edit(), tests_after_undo: true }) }
