//! The repository's own code audited, each night and in no pull request. The standard library, the
//! package of its tests, the compiler and the CLI, each checked as the project it is: a definition
//! nothing reaches is one to delete, a row naming an effect its body never performs is one to
//! narrow, and only this run checks the measures the standard library's own definitions state.

import harness (Repo, Spawned, at, items, json_of, parts, repo, spawned, str)
import std.json (Json, Array, Str, object)
import std.list
import std.string

/// Each definition a `check --types --explain --json` answer lists whose row names an effect its
/// body never performs, with those effects.
fn unperformed(answer: Json) -> List<String> / {abort.raise} =
  items(at(answer, "definitions")).fold([], |acc: List<String>, d: Json|
    match items(at(d, "declared_not_performed")) {
      [] -> acc,
      undone -> acc.push(str(at(d, "name")) ++ " declares " ++ String::join(undone.map(str), ", ")),
    })

/// What a check of `dir` finds to fix: each error, each row naming an effect its body never
/// performs, and where `reaching`, each definition nothing reaches.
fn checked(dir: String, reaching: Bool) -> Unit / {Spawned, Repo, abort.raise} = {
  let v = json_of(spawned(["check", "--json", "--types", "--explain", repo() ++ "/" ++ dir]));
  let found = items(at(v, "diagnostics")).fold([], |a: List<String>, d: Json|
    if (reaching && str(at(d, "code")) == "W0611") || str(at(d, "severity")) == "error" {
      a.push(str(at(d, "code")) ++ " " ++ str(at(d, "message")))
    } else { a }).concat(
    unperformed(v),
  );
  assert(
    found == [],
    Some(
      dir ++ " has errors, definitions nothing reaches, which are to be deleted, or rows naming an "
        ++ "effect no body on them performs, which are to be narrowed:\n  "
        ++ String::join(found, "\n  "),
    ),
  )
}

test/nondet "the standard library checks, reaches every definition and performs every row it writes" {
  checked(parts().std, true)
}

test/nondet "the standard library's tests check, reach every definition and perform every row they write" {
  checked(parts().std_tests, true)
}

test/nondet "the compiler checks, reaches every definition and performs every row it writes" {
  checked(parts().compiler, true)
}

test/nondet "the CLI checks and performs every row it writes" { checked(parts().cli, false) }

test "a definition whose row names an effect its body never performs is named with the effect" {
  let d = |name: String, undone: List<String>|
    object([
      { key: "name", value: Str(name) },
      { key: "declared_not_performed", value: Array(undone.map(|u: String| Str(u))) },
    ]);
  let answer = object([
    { key: "definitions", value: Array([d("m.kept", []), d("m.wide", ["abort.raise", "m.e.op"])]) },
  ]);
  assert_eq(unperformed(answer), ["m.wide declares abort.raise, m.e.op"])
}
