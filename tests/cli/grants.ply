//! `--allow`: which privileged families a run grants the program it drives, by name.

import spawning.harness (spawned, write_program, all_output, stdout, stderr, value_of)
import std.list

/// A program that asks `std.machine` what a trace holding no read says has moved: an operation only
/// a run granted `machine` handles, which opens no unit and binds nothing.
fn asking() -> String = String::of_bytes_lossy(embed("../programs/grants/asking.ply"))

test/nondet "a granted family is bound, and handles the operation the program performs" {
  write_program(asking());
  assert_eq(value_of(spawned(["run", "--json", "--allow", "machine", "m.ply"])), "42")
}

test/nondet "without the grant the operation is rejected" {
  write_program(asking());
  let r = spawned(["run", "m.ply"]);
  assert(r.code != 0, Some("a program performed a machine's operation with no grant"));
  let err = stderr(r);
  assert(err.contains("E0459") && err.contains("`machine`"), Some(err))
}

test/nondet "a family the program does not declare is rejected, naming the effect it grants" {
  write_program(asking());
  let r = spawned(["run", "--allow", "toolchain", "m.ply"]);
  assert(r.code != 0, Some("an undeclared grant ran"));
  let err = stderr(r);
  assert(err.contains("E0459"), Some(err));
  assert(err.contains("`--allow toolchain`") && err.contains("`toolchain`"), Some(err))
}

fn backticked(line: String) -> List<String> = {
  let parts = line.split("`");
  range(0, parts.len()).fold([], |acc: List<String>, i: Int|
    match parts.at(i) { Some(p) -> if i % 2 == 1 { acc.push(p) } else { acc }, None -> acc })
}

/// What follows `marker` on the line of `text` that holds it.
fn after(text: String, marker: String) -> String / {abort.raise} =
  text.split("\n").fold("", |found: String, l: String|
    match l.split(marker).at(1) { Some(rest) -> rest, None -> found })

test/nondet "the help names every family a run grants, and no other" {
  write_program("fn main() -> Int = 0\n");
  let help = spawned(["run", ".", "--help"]);
  let named = backticked(after(stdout(help), "--allow <NAME>")).sort();
  let rejected = spawned(["run", "--allow", "nonsense", "m.ply"]);
  let provided = after(stderr(rejected), "it provides ").split(",").map(|f: String| f.trim()).sort(
  );
  assert(provided.len() > 1, Some(all_output(rejected)));
  assert_eq(named, provided)
}
