//! `--allow`: which privileged families a run lends the program it drives, by name.

import harness (in_memory, on_disk, one, program, said, stdout, stderr)
import std.list

/// A program that asks `std.machine` what a trace holding no read says has moved: an operation only
/// a run lent `machine` answers, which opens no unit and binds nothing.
fn asking() -> String =
  \\import std.machine
  \\import std.machine (machine)
  \\
  \\fn main() -> Int / {machine.moved} =
  \\  match machine.moved(machine::no_grants(), "") { Some(_) -> 1, None -> 42 }
  \\

test/nondet "a granted family is bound, and answers the operation the program performs" {
  program(asking());
  let r = on_disk(["run", "--host", "--allow", "machine", "m.ply"]);
  assert(r.code == 0, Some(said(r)));
  assert(r.out.filter(|l: String| l.trim() == "42").len() > 0, Some(said(r)))
}

test/nondet "without the grant the operation is refused" {
  program(asking());
  let r = on_disk(["run", "--host", "m.ply"]);
  assert(r.code != 0, Some("a program performed a machine's operation with no grant"));
  let err = stderr(r);
  assert(err.contains("E0459") && err.contains("`machine`"), Some(err))
}

test/nondet "a family the program does not declare is refused, naming the effect it lends" {
  program(asking());
  let r = on_disk(["run", "--host", "--allow", "toolchain", "m.ply"]);
  assert(r.code != 0, Some("an undeclared grant ran"));
  let err = stderr(r);
  assert(err.contains("E0459"), Some(err));
  assert(err.contains("`--allow toolchain`") && err.contains("`toolchain`"), Some(err))
}

fn backticked(line: String) -> List<String> / {abort.raise} = {
  let parts = line.split("`");
  range(0, parts.len()).fold([], |acc: List<String>, i: Int|
    match parts.at(i) { Some(p) -> if i % 2 == 1 { acc.push(p) } else { acc }, None -> acc })
}

/// What follows `marker` on the line of `text` that holds it.
fn after(text: String, marker: String) -> String / {abort.raise} =
  text.split("\n").fold("", |found: String, l: String|
    match l.split(marker).at(1) { Some(rest) -> rest, None -> found })

test/nondet "the help names every family a run lends, and no other" {
  program("fn main() -> Int = 0\n");
  let help = on_disk(["run", "--help"]);
  let named = backticked(after(stdout(help), "--allow <NAME>")).sort();
  let refused = on_disk(["run", "--host", "--allow", "nonsense", "m.ply"]);
  let lent = after(stderr(refused), "it lends ").split(",").map(|f: String| f.trim()).sort();
  assert(lent.len() > 1, Some(said(refused)));
  assert_eq(named, lent)
}

test "the grant requires a host" {
  let r = in_memory(one(asking()), ["run", "--allow", "machine", "m.ply"]);
  assert(r.code == 2, Some(said(r)));
  assert(stderr(r).contains("--host"), Some(stderr(r)))
}
