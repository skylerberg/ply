//! `std.sqlite` under a root a run binds: a path that leaves the root, as it is spelled or through a
//! link, ends the run; a connection the run leaves open is closed when it ends; and a test's pass
//! over a database is cached until the database moves.

import spawning.harness (WorkingDirectory, RunResult, PlyProcess, write_project, spawned, stderr,
                         working_directory, write, json_of, path, int, json_text)
import std.fs
import std.fs (fs, Entry, Dir)
import std.json (Json)
import std.list
import std.string

fn sqlite_program() -> String =
  String::of_bytes_lossy(embed("../programs/sqlite_host/sqlite_program.ply"))

/// The program in a working directory holding the `root` a run binds as `app`, beside an `outside`
/// no label names.
fn rooted() -> Unit / {WorkingDirectory, abort.raise} = {
  write_project([{ path: "m.ply", text: sqlite_program() }]);
  let _ = fs.create_dir[cwd]("root");
  let _ = fs.create_dir[cwd]("outside");
}

/// The program run once over `scenarios`, in turn, by a `ply` whose `app` is `root`.
fn run_of(
  scenarios: List<List<String>>,
) -> RunResult / {WorkingDirectory, PlyProcess, abort.raise} =
  spawned(
    scenarios.fold(
      ["run", "m.ply", "--fs", "app=" ++ working_directory() ++ "/root", "--"],
      |argv: List<String>, scenario: List<String>|
        [argv, if argv.len() > 5 { ["+"] } else { [] }, scenario].flatten(),
    ),
    [],
  )

/// What each of `scenarios` returned, in one run of the program.
fn results(
  scenarios: List<List<String>>,
) -> List<String> / {WorkingDirectory, PlyProcess, abort.raise} = {
  let r = run_of(scenarios);
  let result_lines = r.out.fold([], |acc: List<String>, line: String|
    if line.starts_with("handle ") { acc.push(line.slice(7, line.len())) } else { acc });
  assert(r.code == 0 && result_lines.len() == scenarios.len(), Some(stderr(r)));
  result_lines
}

fn result(scenario: List<String>) -> String / {WorkingDirectory, PlyProcess, abort.raise} =
  String::join(results([scenario]), "")

/// The code of the diagnostic a run of `scenario` ended with, or none where it returned.
fn failure_code(
  scenario: List<String>,
) -> Option<String> / {WorkingDirectory, PlyProcess, abort.raise} = {
  let r = run_of([scenario]);
  if r.code == 0 { None } else {
    match stderr(r).split("Error[") {
      [_, after, ..] -> Some(after.slice(0, 5)),
      _ -> panic("the run failed and named no diagnostic:\n" ++ stderr(r)),
    }
  }
}

/// Every file below `dir`, by its path from it.
fn files(dir: String) -> List<String> / {WorkingDirectory, abort.raise} =
  match fs.walk[cwd](dir) {
    None -> [],
    Some(entries) ->
      entries.fold([], |acc: List<String>, e: Entry|
        match e.kind {
          Dir -> acc,
          _ -> acc.push(e.path.slice(dir.len() + 1, e.path.len())),
        }).sort_by(|a: String, b: String| compare(a, b) == Less),
  }

fn absolute_path(path: String) -> String / {WorkingDirectory, abort.raise} =
  working_directory() ++ "/" ++ path

/// A link absolute_path `link` in `root` to `target` in `outside`.
fn linked_out(link: String, target: String) -> Unit / {WorkingDirectory, abort.raise} =
  assert(fs.symlink[cwd]("root/" ++ link, "../outside/" ++ target), Some("a link is made"))

test/nondet "a path that leaves the root, as it is spelled or through a link, is rejected before anything opens" {
  rooted();
  let outside = absolute_path("outside/abs.db");
  ["../outside/up.db", outside, "a/../../outside/up.db"].fold((), |u: Unit, path: String|
    assert_eq(failure_code(["opens", path]), Some("E0452")));
  assert_eq(result(["round_trip"]), "Ada,Grace");
  ["../outside/copy.db", outside].fold((), |u: Unit, path: String|
    assert_eq(failure_code(["backs_up", path]), Some("E0452")));
  assert_eq(failure_code(["unbound"]), Some("E0451"));
  assert_eq(files("outside"), []);
  // A link out of the root leaves it whether or not anything is where it leads.
  let _ = fs.write_file[cwd]("outside/out.db", b"");
  linked_out("out.db", "out.db");
  linked_out("gone.db", "gone.db");
  linked_out("away.db", "copied.db");
  ["out.db", "gone.db"].fold((), |u: Unit, leaving: String|
    assert_eq(failure_code(["opens", leaving]), Some("E0452")));
  assert_eq(failure_code(["backs_up", "away.db"]), Some("E0452"));
  assert_eq(fs.read_file[cwd]("outside/out.db"), Some(b""));
  assert_eq(files("outside"), ["out.db"])
}

test/nondet "a connection a run leaves open is closed when the run ends" {
  rooted();
  assert_eq(result(["left_open"]), "1");
  // Closed, so the log was folded into the database and removed with its index.
  assert_eq(files("root"), ["left.db"]);
  assert_eq(result(["left_open"]), "1")
}

/// A test that reads the people `round_trip` wrote through a connection that only reads.
fn reads_people() -> String =
  \\import std.sql (stmt)
  \\import std.sqlite
  \\import std.sqlite (sqlite, sql, ReadOnly, Limits, Options)
  \\
  \\fn roomy() -> Limits = { sql_bytes: 10000, params: 100, rows: 100000, bytes: 10000000, steps: 1000000 }
  \\
  \\fn plain() -> Options = { strict: true, busy_ms: 50, statements: 8 }
  \\
  \\fn people() -> Int / {sqlite.read[app], sqlite.write[app], abort.raise} =
  \\  match try[sql.fail] {
  \\    with_scope[reading](sqlite::opening[app]("data.db", ReadOnly, plain()), |c| sqlite::close(c)) { conn ->
  \\      sqlite::query(conn, sqlite::bound(stmt("select name from person"), []), roomy()).len() }
  \\  } {
  \\    Ok(n) -> n,
  \\    Err(_) -> 0,
  \\  }
  \\
  \\test/nondet "the people are read from the database" { assert(people() >= 2) }
  \\

/// `ply test` over the working directory, its `app` the root.
fn tested_over_root() -> Json / {WorkingDirectory, PlyProcess, abort.raise} =
  json_of(spawned(["test", ".", "--json", "--fs", "app=" ++ working_directory() ++ "/root"], []))

fn selected(report: Json) -> Int = int(path(report, ["selection", "selected"]))

// The engine's own handler records what a connection opened, so a pass over a database is taken
// until the database moves.
test/nondet "a test's pass over a database stands until a write moves the database" {
  rooted();
  assert_eq(result(["round_trip"]), "Ada,Grace");
  write("reads.ply", reads_people());
  let first = tested_over_root();
  assert(selected(first) == 1, Some(json_text(first)));
  let again = tested_over_root();
  assert(selected(again) == 0, Some("nothing the pass read moved: " ++ json_text(again)));
  // A write: a table made in the database the pass read.
  assert_eq(result(["opens", "data.db"]), "ran");
  let moved = tested_over_root();
  assert(selected(moved) == 1, Some("the database moved under the pass: " ++ json_text(moved)))
}
