import harness (scratch, write_program, on_disk, test_report, json_of, at, path, items, first, int,
                str, bool, json_text, all_output)
import std.json (Json)

fn login() -> String = String::of_bytes_lossy(embed("../programs/password_cli/login.ply"))

fn status_of(report: Json, name: String) -> String =
  match items(at(report, "results")).filter(|r: Json| str(at(r, "name")) == name) {
    [r, ..] -> str(at(r, "status")),
    [] -> "",
  }

test/nondet "a passing test that calls a password hash is cached, including when rerun with a different `--exec` program mapping" {
  write_program(login());
  let first = test_report([]);
  assert(bool(at(first, "ok")), Some(json_text(first)));
  assert_eq(status_of(first, "a stored hash verifies"), "passed");
  assert_eq(
    status_of(
      first,
      "a login under `password::fake_kdf` succeeds without running the real key derivation",
    ),
    "passed",
  );
  [["--exec", "echo=/bin/echo"], []].fold((), |_: Unit, flags: List<String>| {
    let again = test_report(flags);
    assert(bool(at(again, "ok")), Some(json_text(again)));
    assert_eq(int(path(again, ["summary", "cached"])), 2);
    assert_eq(int(path(again, ["selection", "selected"])), 0)
  })
}

test "`ply hosts` lists the four password hash functions, each marked as deterministic, blocking and using secrets" {
  scratch(|| {
    write_program(login());
    let listed = on_disk(["hosts", "--json"]);
    assert(listed.code == 0, Some(all_output(listed)));
    let rows = items(at(json_of(listed), "hosts"));
    assert_eq(rows.map(|row: Json| str(at(row, "triple"))), [
      "std.password.kdf.argon2",
      "std.password.kdf.bcrypt",
      "std.password.kdf.pbkdf2",
      "std.password.kdf.scrypt",
    ]);
    assert_eq(
      rows.filter(|row: Json|
        bool(at(row, "deterministic")) && bool(at(row, "blocking")) && bool(at(row, "secrets"))
          && str(at(row, "linearity")) == "repeatable"
          && !bool(at(row, "declared_nondet"))).len(
      ),
      4,
    );
    assert_eq(str(at(first(rows), "handler")), "std.password.served")
  })
}
