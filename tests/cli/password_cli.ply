//! What the CLI makes of a test that has `std.password` compute a hash: `ply test` caches its pass
//! like any other test's, and `ply hosts` lists each hash operation as deterministic, blocking and
//! handed a secret.

import spawning.harness (write_program, test_report, at, path, items, first, int, str, bool,
                         json_text)
import std.json (Json)

fn login() -> String = String::of_bytes_lossy(embed("../programs/password_cli/login.ply"))

fn status_of(report: Json, name: String) -> String =
  match items(at(report, "results")).filter(|r: Json| str(at(r, "name")) == name) {
    [r, ..] -> str(at(r, "status")),
    [] -> "",
  }

// The runs it drives reach the machine, so it runs against the disk.
test/nondet "a test that reaches a hash passes, and its pass is any binding's" {
  write_program(login());
  let first = test_report([]);
  assert(bool(at(first, "ok")), Some(json_text(first)));
  assert_eq(status_of(first, "a stored hash verifies"), "passed");
  assert_eq(status_of(first, "a login under the stand-in reaches no host"), "passed");
  // A hash is a function of what it is handed, so the pass is recorded as a test's that reached no
  // host is: a second run takes it, and so does a run under another binding.
  [["--exec", "echo=/bin/echo"], []].fold((), |_: Unit, flags: List<String>| {
    let again = test_report(flags);
    assert(bool(at(again, "ok")), Some(json_text(again)));
    assert_eq(int(path(again, ["summary", "cached"])), 2);
    assert_eq(int(path(again, ["selection", "selected"])), 0)
  })
}
