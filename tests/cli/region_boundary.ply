//! What an entry may answer across the boundary: data, and never a handle a region of the run
//! holds. A continuation or a task in an entry's answer is the program's error, and a constant the
//! boundary refuses keeps nothing for the next entry.

import harness (spawned, Here, Shipped, Loaded, called, loaded, project, scratch, unloaded)
import cli.machine (default_options)
import std.machine as entering
import std.value (Value, VInt)

effect set Driving = {entering::machine.open, entering::machine.bind, entering::machine.enter, entering::machine.unbind, entering::machine.close}

/// `Saved`'s field is an ordinary function type, so the checker lets `k` reach `parked`'s answer.
fn parked() -> String =
  \\effect amb {
  \\  multi read flip[coin]() -> Bool
  \\}
  \\
  \\type Saved = Done(Int) | Parked((Bool) -> Saved)
  \\
  \\fn main() -> Int = 0
  \\
  \\pub fn parked() -> Saved / {abort.raise} =
  \\  handle {
  \\    let b = amb.flip[coin]();
  \\    Done(if b { 41 } else { 0 })
  \\  } with { amb.flip[coin]() resume k -> Parked(k) }
  \\
  \\fn resume_it(s: Saved) -> Int =
  \\  match s { Parked(k) -> match k(true) { Done(n) -> n, Parked(_) -> 0 }, Done(n) -> n }
  \\
  \\pub fn resumed(n: Int) -> Int / {abort.raise} = n + resume_it(parked())
  \\
  \\fn simulated<a | e>(on: (Task<Int>) -> a / e) -> a / {sim.read | e} =
  \\  simulate { on(task.spawn(|| 1)) }
  \\
  \\pub fn spawned() -> Option<Task<Int>> / {sim.read} = simulated(|t: Task<Int>| Some(t))
  \\
  \\fn joined<a>(x: a, wait: (a) -> Int / {task.join, abort.raise}) -> Int / {sim.read, abort.raise} =
  \\  simulate {
  \\    let mine = task.spawn(|| 2);
  \\    wait(x) + task.join(mine)
  \\  }
  \\
  \\pub fn rejoined() -> Int / {sim.read, abort.raise} = match spawned() {
  \\  Some(t) -> joined(t, |h: Task<Int>| task.join(h)),
  \\  None -> 0,
  \\}
  \\

fn parked_loaded() -> Loaded / {Here, Shipped, Driving, abort.raise} = {
  project([{ path: "inner.ply", text: parked() }]);
  loaded(default_options())
}

/// What `name` raised, as its code and message; a call that answered is a failure.
fn refused(l: Loaded, name: String) -> { code: Bytes, message: String } / {Driving, abort.raise} =
  match called(l, name, []) {
    Ok(_) -> panic("`" ++ name ++ "` answered"),
    Err(d) -> { code: d.code, message: String::of_bytes_lossy(d.message) },
  }

test "a continuation in an entry's answer is the program's error, every time it is asked" {
  scratch(|| {
    let l = parked_loaded();
    range(0, 2).fold((), |u: Unit, i: Int| {
      let d = refused(l, "parked");
      assert_eq(d.code, b"E0449");
      assert(d.message.contains("`inner.parked` answered a continuation"), Some(d.message));
      assert(d.message.contains("Parked`'s argument 1"), Some(d.message))
    });
    // The memo keeps no answer that holds a continuation, so each entry resumes the one it parked.
    let resumed = range(0, 2).map(|n: Int| called(l, "resumed", [VInt(n)]));
    let _ = unloaded(l);
    assert(
      match resumed { [Ok(VInt(41)), Ok(VInt(42))] -> true, _ -> false },
      Some("an entry resumed a continuation another entry parked"),
    )
  })
}

test "a task in an entry's answer is refused as a continuation is" {
  scratch(|| {
    let l = parked_loaded();
    let d = refused(l, "spawned");
    let _ = unloaded(l);
    assert_eq(d.code, b"E0449");
    assert(d.message.contains("`inner.spawned` answered a `Task`"), Some(d.message))
  })
}

// A type parameter hides the task `spawned` let out from the next region, which numbers a task of its
// own the same: joined there by id alone, the handle would answer that task's `2`.
test "a task carried into another region fails its join rather than answering a stranger" {
  scratch(|| {
    let l = parked_loaded();
    let d = refused(l, "rejoined");
    let _ = unloaded(l);
    assert_eq(d.code, b"E0413");
    assert(d.message.contains("another region"), Some(d.message))
  })
}
