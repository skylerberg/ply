//! Programs that hash with `std.password` under `ply run`: tasks hashing at once each get their own
//! hash, and a cost past the bounds ends the run with a refusal that holds nothing of the password.

import harness (Ran, Spawned, program, spawned, said, stdout)

/// A program that hashes at once from four tasks, or asks for a cost the runtime refuses under the
/// password it is handed.
fn hashing() -> String =
  \\import std.password
  \\import std.password (kdf, Invalid, Valid, ValidNeedsRehash)
  \\import std.process (process)
  \\import std.string
  \\
  \\fn checked(supplied: String) -> String / {kdf.argon2, kdf.scrypt, kdf.bcrypt, kdf.pbkdf2, abort.raise} =
  \\  match password::verify(
  \\    "$argon2id$v=19$m=19456,t=2,p=1$AAECAwQFBgcICQoLDA0ODw$gYJZtjEAJqjg26xdLmknq8/bB7MiWPrE9hsYuA+SkIU",
  \\    Secret::of_string(supplied),
  \\    password::owasp_argon2id(),
  \\  ) {
  \\    Valid -> "valid",
  \\    ValidNeedsRehash -> "rehash",
  \\    Invalid -> "invalid",
  \\  }
  \\
  \\// Each waits on its own ticket, and each is answered its own hash.
  \\fn together() -> List<String> / {task.spawn, task.join, kdf.argon2, kdf.scrypt, kdf.bcrypt, kdf.pbkdf2, abort.raise} = {
  \\  let a = task.spawn(|| checked("correct horse battery staple"));
  \\  let b = task.spawn(|| checked("correct horse battery stapled"));
  \\  let c = task.spawn(|| checked("correct horse battery staple"));
  \\  let d = task.spawn(|| checked(""));
  \\  [task.join(a), task.join(b), task.join(c), task.join(d)]
  \\}
  \\
  \\// Four gigabytes, asked of the operation itself.
  \\fn four_gigabytes(password: String) -> Bytes / {kdf.argon2} =
  \\  kdf.argon2(
  \\    "argon2id",
  \\    Secret::of_bytes(Bytes::of_string(password)),
  \\    b"saltsalt",
  \\    Secret::of_bytes(b""),
  \\    b"",
  \\    4194304,
  \\    1,
  \\    1,
  \\    32,
  \\  )
  \\
  \\fn cost_thirty_one(password: String) -> Bytes / {kdf.bcrypt, abort.raise} =
  \\  kdf.bcrypt(
  \\    Secret::of_bytes(Bytes::of_string(password)),
  \\    Bytes::concat_all(range(0, 16).map(|_: Int| byte_of_int(0))),
  \\    31,
  \\  )
  \\
  \\fn main() -> Unit / {process.args[proc], process.out[proc], task.spawn, task.join, kdf.argon2, kdf.scrypt, kdf.bcrypt, kdf.pbkdf2, abort.raise} =
  \\  match process.args[proc]() {
  \\    ["together"] -> process.out[proc](String::join(together(), ",")),
  \\    ["four_gigabytes", password] -> process.out[proc](four_gigabytes(password).len().to_string()),
  \\    ["cost_thirty_one", password] -> process.out[proc](cost_thirty_one(password).len().to_string()),
  \\    _ -> panic("no such scenario"),
  \\  }
  \\

fn run_of(scenario: List<String>) -> Ran / {Spawned, abort.raise} =
  spawned(["run", "m.ply", "--"].concat(scenario), [])

// A hash parks the task that asked for it and no other.
test/nondet "tasks hashing at once are each answered their own hash" {
  program(hashing());
  let r = run_of(["together"]);
  assert(r.code == 0 && stdout(r).contains("valid,invalid,valid,invalid"), Some(said(r)))
}

// The refusal is the native's, made before its job is started, and holds nothing of the password.
test/nondet "a cost past the bounds is refused where it is performed" {
  program(hashing());
  let wrong = [
    ("four_gigabytes", "4194304 KiB of memory"),
    ("cost_thirty_one", "a cost of 31"),
  ].map(|c: (String, String)|
    match c {
      (scenario, names) -> {
        let r = run_of([scenario, "correct horse"]);
        let why = said(r);
        if r.code == 0 { scenario ++ " answered" }
        else if !why.contains(names) { scenario ++ " does not say why: " ++ why }
        else if why.contains("correct") || why.contains("horse") {
          scenario ++ " holds the password"
        } else { "" }
      },
    });
  assert_eq(wrong, ["", ""])
}
