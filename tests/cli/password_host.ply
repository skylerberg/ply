//! Programs that hash with `std.password` under `ply run`: tasks hashing at once each get their own
//! hash, and a cost past the bounds ends the run with an error that holds nothing of the password.

import harness (RunResult, PlyProcess, write_program, spawned, all_output, stdout)

/// A program that hashes at once from four tasks, or asks for a cost the runtime rejects under the
/// password it is handed.
fn hashing() -> String = String::of_bytes_lossy(embed("../programs/password_host/hashing.ply"))

fn run_of(scenario: List<String>) -> RunResult / {PlyProcess, abort.raise} =
  spawned(["run", "m.ply", "--"].concat(scenario), [])

// A hash parks the task that asked for it and no other.
test/nondet "tasks hashing at once are each given their own hash" {
  write_program(hashing());
  let r = run_of(["together"]);
  assert(r.code == 0 && stdout(r).contains("valid,invalid,valid,invalid"), Some(all_output(r)))
}

// The error is the native's, made before its job is started, and holds nothing of the password.
test/nondet "a cost past the bounds is rejected where it is performed" {
  write_program(hashing());
  let wrong = [
    ("four_gigabytes", "4194304 KiB of memory"),
    ("cost_thirty_one", "a cost of 31"),
  ].map(|c: (String, String)|
    match c {
      (scenario, names) -> {
        let r = run_of([scenario, "correct horse"]);
        let reason = all_output(r);
        if r.code == 0 { scenario ++ " answered" }
        else if !reason.contains(names) { scenario ++ " does not say why: " ++ reason }
        else if reason.contains("correct") || reason.contains("horse") {
          scenario ++ " holds the password"
        } else { "" }
      },
    });
  assert_eq(wrong, ["", ""])
}
