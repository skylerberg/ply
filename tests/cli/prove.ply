//! `ply prove` and `ply review`: the coverage a reviewer reads first, one report however the work
//! was split or whatever the cache returned, the review of what changed since the last accepted
//! one, and each obligation proved or failing the run with what stopped it.

import harness (PlyProcess, spawned, scratch, write_program, write, on_disk, all_output, stdout,
                json_of, at, path, nth, items, first, str, int, bool, json_text)
import std.json
import std.json (Json, Null, Object, Array, Str)
import std.string
import std.list

fn unspecified() -> String =
  "fn double(x: Int) -> Int = x * 2\n\nfn triple(x: Int) -> Int = x * 3\n\nfn main() -> Int = double(21)\n"

fn proved_json(flags: List<String>) -> Json / {PlyProcess, abort.raise} =
  json_of(spawned(["prove", "--json"].concat(flags)))

fn null_keys(j: Json, keys: List<String>) -> Json =
  match j {
    Object(m) -> Object(keys.fold(m, |acc: Map<String, Json>, k: String| acc.insert(k, Null))),
    other -> other,
  }

test/nondet "prove leads with the review surface" {
  write_program(unspecified());
  let r = spawned(["prove"]);
  assert(r.code == 0, Some(all_output(r)));
  let first_line = match r.out.at(0) { Some(l) -> l, None -> "" };
  assert(
    first_line.contains("3 definitions") && first_line.contains("0 carry an obligation"),
    Some("the coverage line has to be first: " ++ stdout(r)),
  );
  assert(
    stdout(r).contains("3 definitions have no proved claim: m.double, m.main, m.triple"),
    Some("uncovered definitions are a list to work through, not only a number: " ++ stdout(r)),
  );
  assert(stdout(r).contains("0 obligations"), Some(stdout(r)))
}

test/nondet "prove json is one object carrying the coverage block" {
  write_program(unspecified());
  let r = spawned(["prove", "--json"]);
  assert(r.code == 0, Some(all_output(r)));
  let v = json_of(r);
  assert(int(at(v, "schema_version")) == 1, Some(json_text(v)));
  assert(str(at(v, "command")) == "prove", Some(json_text(v)));
  assert(bool(at(v, "ok")), Some(json_text(v)));
  assert(int(path(v, ["coverage", "definitions"])) == 3, Some(json_text(v)));
  assert(int(path(v, ["coverage", "covered"])) == 0, Some(json_text(v)));
  assert(int(at(v, "specified")) == 0, Some(json_text(v)));
  assert(items(path(v, ["coverage", "uncovered"])).len() == 3, Some(json_text(v)));
  assert(int(path(v, ["plan", "prove_budget"])) > 0, Some(json_text(v)));
  assert(items(at(v, "obligations")) == [], Some(json_text(v)))
}

test/nondet "prove json is byte-identical across runs and job counts" {
  write_program(unspecified());
  // The clock and what the load took of its store are what legitimately differ.
  assert(
    null_keys(proved_json(["--jobs", "1"]), ["duration_ms", "front_end"])
      == null_keys(proved_json(["--jobs", "16"]), ["duration_ms", "front_end"]),
    None,
  )
}

// Recording what an obligation exercised as seen would empty the next `ply test`'s change set.
test/nondet "proving does not touch what the next test run changes" {
  write_program(unspecified());
  let before = at(json_of(on_disk(["cache", "stats", "--json"])), "definitions_seen");
  assert(spawned(["prove"]).code == 0, None);
  assert(at(json_of(on_disk(["cache", "stats", "--json"])), "definitions_seen") == before, None)
}

/// Proofs and a refutation, so the determinism and cache checks have something to disagree about.
fn specified() -> String =
  \\fn one(x: Int) -> Int
  \\  ensures result >= 0
  \\= 1
  \\
  \\fn size_of(xs: List<Int>) -> Int
  \\  ensures result >= 0
  \\= xs.len()
  \\
  \\law "length is never negative"
  \\  forall (xs: List<Int>) {
  \\    size_of(xs) >= 0
  \\  }
  \\
  \\law "a batch never holds more than one entry"
  \\  forall (xs: List<Int>) {
  \\    xs.len() <= 1
  \\  }
  \\

/// The clock, where each result came from and what the load took of its store legitimately
/// differ between warm and cold.
fn stable_report(v: Json) -> Json = null_keys(v, ["duration_ms", "cached", "front_end"])

// A program with no obligations cannot catch an order that depends on the worker pool.
test/nondet "prove json agrees across job counts over real obligations" {
  write_program(specified());
  let one = stable_report(proved_json(["--jobs", "1", "--no-cache"]));
  let many = stable_report(proved_json(["--jobs", "16", "--no-cache"]));
  // A length is known to be non-negative, so both `ensures` and the first law are proved.
  assert(int(path(one, ["summary", "proved"])) == 3, Some(json_text(one)));
  assert(int(path(one, ["summary", "refuted"])) == 1, Some(json_text(one)));
  assert(one == many, None)
}

test/nondet "a cached run reports exactly what a fresh one does" {
  write_program(specified());
  let fresh = stable_report(proved_json(["--no-cache"]));
  // Populate, then read back.
  let _ = spawned(["prove", "--json"]);
  let warm = proved_json([]);
  assert(int(at(warm, "cached")) > 0, Some("the second run has to have read something"));
  assert(fresh == stable_report(warm), None)
}

// `--static-prover` asks the static prover about every obligation, whatever resolved it, so a claim the cache
// resolved carries what a fresh discharge's would; unasked, no claim carries one.
test/nondet "a cached run reports the same reach as a fresh one" {
  write_program(specified());
  let fresh = stable_report(proved_json(["--static-prover", "--no-cache"]));
  let unasked = proved_json([]);
  assert(
    items(at(unasked, "obligations")).filter(|o: Json| at(o, "static_prover") != Null).len() == 0,
    Some(json_text(unasked)),
  );
  let warm_raw = proved_json(["--static-prover"]);
  assert(int(at(warm_raw, "cached")) > 0, Some("the second run has to have read something"));
  let warm = stable_report(warm_raw);
  assert(fresh == warm, None);
  assert(
    items(at(warm, "obligations")).filter(|o: Json|
        str(path(o, ["static_prover", "decision"])) == "").len(
      )
      == 0,
    Some("every claim here is one the static prover sees: " ++ json_text(warm)),
  )
}

// A proof made by running every point is keyed by what it ran, and the next run reads
// it back from there rather than walking the domain again.
test/nondet "a claim proved by walking its domain is read back rather than walked again" {
  write_program(
    \\type Day = | Mon | Tue | Wed
    \\
    \\fn next(d: Day) -> Day = match d { Mon -> Tue, Tue -> Wed, Wed -> Mon }
    \\
    \\law "three days on is the same day" forall (d: Day) {
    \\  range(0, 3).fold(d, |day: Day, _i: Int| next(day)) == d
    \\}
    \\
  );
  let first_run = proved_json([]);
  let law = nth(at(first_run, "obligations"), 0);
  assert(str(at(law, "outcome")) == "proved", Some(json_text(first_run)));
  assert(bool(path(law, ["certificate", "ran"])), Some(json_text(law)));
  assert(int(at(first_run, "cached")) == 0, Some(json_text(first_run)));
  let second = proved_json([]);
  assert(int(at(second, "cached")) == 1, Some(json_text(second)));
  assert(
    at(second, "warnings") == Array([]),
    Some("and nothing was rejected: " ++ json_text(second)),
  );
  assert(stable_report(first_run) == stable_report(second), None);
  let explained = stdout(spawned(["prove", "--explain"]));
  assert(explained.contains("from: cached proof"), Some(explained));
  assert(!explained.contains("cache rejected"), Some(explained))
}

// The clock describes the machine, so what it stops proves nothing: the claim is unproved, nothing is
// cached, and the next run evaluates it again rather than believing it.
test/nondet "a claim whose evaluation the clock stopped is unproved and not cached" {
  write_program(
    "fn spin(n: Int) -> Int / {diverges} = spin(n + 1)\n\nlaw \"spins back to zero\" { spin(0) == 0 }\n",
  );
  let r = spawned(["prove", "--json", "--timeout", "300"]);
  let v = json_of(r);
  assert(r.code == 1, Some("a claim nothing proves fails the run: " ++ json_text(v)));
  assert(int(path(v, ["plan", "timeout_ms"])) == 300, Some(json_text(v)));
  assert(int(path(v, ["summary", "unproved"])) == 1, Some(json_text(v)));
  let law = nth(at(v, "obligations"), 0);
  assert(str(at(law, "outcome")) == "unproved", Some(json_text(law)));
  assert(str(at(law, "reason")).contains("timed out"), Some(json_text(law)));
  let again = proved_json(["--timeout", "300"]);
  assert(int(at(again, "cached")) == 0, Some(json_text(again)));
  assert(int(path(again, ["summary", "unproved"])) == 1, Some(json_text(again)))
}

fn obligation_owned_by(v: Json, owner: String) -> Json =
  match items(at(v, "obligations")).filter(|o: Json| str(at(o, "owner")) == owner) {
    [o, ..] -> o,
    _ -> Null,
  }

/// A bound the body shows, and one it outgrows.
fn clauses() -> String =
  \\fn total(xs: List<Int>) -> Int
  \\  cost xs.len()
  \\= xs.fold(0, |a: Int, x: Int| a + x)
  \\
  \\fn wrong(xs: List<Int>) -> Int
  \\  cost 1
  \\= xs.fold(0, |a: Int, x: Int| a + x)
  \\

// A bound is proved from the body or it is not proved: nothing measures a run to stand in for one.
test/nondet "a `cost` clause its body shows is proved, and one it outgrows is unproved where it grows" {
  write_program(clauses());
  let r = spawned(["prove", "--no-cache"]);
  assert(r.code == 1, Some(all_output(r)));
  let v = proved_json(["--no-cache"]);
  let total = obligation_owned_by(v, "m.total");
  assert(str(at(total, "kind")) == "cost", Some(json_text(total)));
  assert(str(at(total, "outcome")) == "proved", Some(json_text(total)));
  assert(!bool(path(total, ["certificate", "ran"])), Some(json_text(total)));
  assert(
    items(path(total, ["certificate", "rules"])).fold(false, |found: Bool, rule: Json|
      found || str(path(rule, ["cost_bound", "def"])) == "m.total"),
    Some(json_text(total)),
  );
  let wrong = obligation_owned_by(v, "m.wrong");
  assert(str(at(wrong, "outcome")) == "unproved", Some(json_text(wrong)));
  assert(str(at(wrong, "reason_kind")) == "open", Some(json_text(wrong)));
  assert(str(at(nth(at(wrong, "stopped_at"), 0), "kind")) == "unbounded", Some(json_text(wrong)));
  assert(
    items(at(v, "diagnostics")).filter(|d: Json| str(at(d, "code")) == "E0474").len() == 1,
    Some(json_text(v)),
  )
}

/// A definition that runs in place, and one that makes a list as long as the one it is handed.
fn spaces() -> String =
  \\type Chain = | Link(Int, Chain) | End
  \\
  \\fn reversed(xs: Chain, onto: Chain) -> Chain
  \\  space 0
  \\= match xs { End -> onto, Link(x, rest) -> reversed(rest, Link(x, onto)) }
  \\
  \\fn doubled(xs: List<Int>) -> List<Int>
  \\  space 0
  \\= xs.map(|x: Int| 2 * x)
  \\

test/nondet "a `space` clause its body shows is proved, and one it outgrows is unproved" {
  write_program(spaces());
  let v = proved_json(["--no-cache"]);
  let reversed = obligation_owned_by(v, "m.reversed");
  assert(str(at(reversed, "kind")) == "space", Some(json_text(reversed)));
  assert(str(at(reversed, "outcome")) == "proved", Some(json_text(reversed)));
  assert(
    items(path(reversed, ["certificate", "rules"])).fold(false, |found: Bool, rule: Json|
      found || str(path(rule, ["space_bound", "def"])) == "m.reversed"),
    Some(json_text(reversed)),
  );
  let doubled = obligation_owned_by(v, "m.doubled");
  assert(str(at(doubled, "outcome")) == "unproved", Some(json_text(doubled)));
  assert(
    str(at(nth(at(doubled, "stopped_at"), 0), "kind")) == "unbounded",
    Some(json_text(doubled)),
  )
}

/// A bound over what a function given costs, one call composing it, and one bound too low for it.
fn named_costs() -> String =
  \\fn total(xs: List<Int>) -> Int = xs.fold(0, |a: Int, x: Int| a + x)
  \\
  \\fn each_of<| e>(xs: List<Int>, f: (Int) -> Int / e cost k) -> Int / e
  \\  cost xs.len() * k
  \\= xs.fold(0, |a: Int, x: Int| a + f(x))
  \\
  \\fn pairs(xs: List<Int>, ys: List<Int>) -> Int
  \\  cost xs.len() * (ys.len() + 1)
  \\= each_of(xs, |_x: Int| total(ys))
  \\
  \\fn too_cheap<| e>(xs: List<Int>, f: (Int) -> Int / e cost k) -> Int / e
  \\  cost k
  \\= xs.fold(0, |a: Int, x: Int| a + f(x))
  \\

test/nondet "a cost name composes a bound with the function given, and a bound too low for it is unproved" {
  write_program(named_costs());
  let v = proved_json(["--no-cache"]);
  assert(str(at(obligation_owned_by(v, "m.each_of"), "outcome")) == "proved", Some(json_text(v)));
  assert(str(at(obligation_owned_by(v, "m.pairs"), "outcome")) == "proved", Some(json_text(v)));
  assert(
    str(at(obligation_owned_by(v, "m.too_cheap"), "outcome")) == "unproved",
    Some(json_text(v)),
  );
  assert(int(path(v, ["summary", "unproved"])) == 1, Some(json_text(v)))
}

test/nondet "review reports everything as unreviewed until something is accepted" {
  write_program(unspecified());
  let r = spawned(["review", "--changed"]);
  assert(r.code == 0, Some(all_output(r)));
  assert(stdout(r).contains("3 definitions"), Some(stdout(r)));
  assert(stdout(r).contains("never reviewed"), Some(stdout(r)))
}

test/nondet "accepting a review makes the next one quiet" {
  write_program(unspecified());
  let accepted = spawned(["review", "--accept"]);
  assert(accepted.code == 0, Some(all_output(accepted)));
  assert(stdout(accepted).contains("3 definitions accepted"), Some(stdout(accepted)));
  let r = spawned(["review", "--changed"]);
  assert(r.code == 0, Some(all_output(r)));
  assert(
    stdout(r).contains("no definition changed since the last accepted review"),
    Some(stdout(r)),
  )
}

// A definition's spec is the set of its claims, however they were gathered: a baseline read back
// from the store is the same spec it was accepted as.
test/nondet "accepting a review of claims makes the next one quiet" {
  write_program(specified());
  assert(spawned(["review", "--accept"]).code == 0, None);
  let r = spawned(["review", "--changed"]);
  assert(
    stdout(r).contains("no definition changed since the last accepted review"),
    Some(stdout(r)),
  )
}

test/nondet "an unspecified change is reported as invisible rather than as nothing" {
  write_program(unspecified());
  let _ = spawned(["review", "--accept"]);
  write("m.ply", unspecified().replace("x * 2", "x + x"));
  let r = spawned(["review", "--changed"]);
  assert(r.code == 0, Some(all_output(r)));
  let text = stdout(r);
  assert(text.contains("m.double · implementation changed · no spec"), Some(text));
  assert(text.contains("read the implementation, line by line"), Some(text));
  assert(
    text.contains(
      "carry no obligation that holds, so this run says nothing about whether their behaviour changed",
    ),
    Some("the limit has to be visible at the point of use: " ++ text),
  );
  assert(
    !text.contains("nothing changed"),
    Some("an unspecified change is still a change: " ++ text),
  )
}

test/nondet "review json names what moved and what the claim covers" {
  write_program(unspecified());
  let _ = spawned(["review", "--accept"]);
  write("m.ply", unspecified().replace("x * 3", "x + x + x"));
  let v = json_of(spawned(["review", "--changed", "--json"]));
  assert(str(at(v, "command")) == "review", Some(json_text(v)));
  assert(int(at(v, "definitions")) == 3, Some(json_text(v)));
  assert(int(at(v, "unspecified_changed")) == 1, Some(json_text(v)));
  assert(int(at(v, "specified_changed")) == 0, Some(json_text(v)));
  let changed = items(at(v, "changed"));
  assert(changed.len() == 1, Some(json_text(v)));
  assert(str(at(first(changed), "name")) == "m.triple", Some(json_text(v)));
  assert(str(at(first(changed), "implementation")) == "changed", Some(json_text(v)));
  assert(str(at(first(changed), "spec")) == "none", Some(json_text(v)));
  assert(str(at(v, "headline")).contains("carry no obligation"), Some(json_text(v)))
}

test/nondet "renaming a definition loses its baseline rather than its history" {
  write_program(unspecified());
  let _ = spawned(["review", "--accept"]);
  write("m.ply", unspecified().replace("triple", "treble"));
  let changed = items(at(json_of(spawned(["review", "--changed", "--json"])), "changed"));
  assert(changed.len() == 1, None);
  assert(str(at(first(changed), "name")) == "m.treble", None);
  assert(str(at(first(changed), "implementation")) == "never reviewed", None)
}

test/nondet "a change under an obligation nothing proves is never reported as checked" {
  let effectful =
    \\effect db {
    \\  read  get[r](key: Int) -> Int
    \\  write put[r](key: Int, value: Int) -> Int
    \\}
    \\
    \\fn stored(k: Int) -> Int / {db.read[rows]}
    \\  ensures result >= 0
    \\= db.get[rows](k)
    \\
  ;
  write_program(effectful);
  let _ = spawned(["review", "--accept"]);
  write("m.ply", effectful.replace("= db.get[rows](k)", "= db.get[rows](k) + 1"));
  let r = spawned(["review", "--changed"]);
  assert(r.code == 1, Some("a claim nothing proves fails the run: " ++ all_output(r)));
  let text = stdout(r);
  assert(text.contains("m.stored · implementation changed · spec unchanged"), Some(text));
  assert(text.contains("unproved"), Some(text));
  assert(
    text.contains("not covered by a claim that holds: m.stored"),
    Some("the definition a reader still has to read has to be named: " ++ text),
  );
  assert(
    !text.contains("no changed definition has a spec"),
    Some("nothing here established anything: " ++ text),
  );
  let v = json_of(spawned(["review", "--changed", "--json"]));
  assert(!bool(at(v, "ok")), Some(json_text(v)));
  assert(int(at(v, "undischarged")) == 1, Some(json_text(v)));
  // The count the headline discloses the blind spot with, and the sentence an agent would act on.
  assert(int(at(v, "specified_changed")) == 0, Some(json_text(v)));
  assert(int(at(v, "unspecified_changed")) == 1, Some(json_text(v)));
  let change = nth(at(v, "changed"), 0);
  assert(
    !bool(at(change, "specified")) && at(change, "specified") != Null,
    Some(json_text(change)),
  );
  assert(
    str(at(change, "advice"))
      == "no claim on this definition is proved: read the implementation, line by line",
    Some(json_text(change)),
  );
  assert(int(path(v, ["coverage", "covered"])) == 0, Some(json_text(v)));
  assert(path(v, ["coverage", "uncovered"]) == Array([Str("m.stored")]), Some(json_text(v)));
  let obligation = nth(at(change, "obligations"), 0);
  assert(str(at(obligation, "outcome")) == "unproved", Some(json_text(obligation)));
  assert(str(at(obligation, "reason_kind")) == "unhandled_effect", Some(json_text(obligation)))
}

// A frame names each write as effects name a resource: bracketed, and nothing for an effect that
// has none.
test/nondet "a frame names each write as the effects do" {
  write_program(
    \\effect db {
    \\  write put[r](key: Int, value: Int) -> Int
    \\}
    \\
    \\effect audit {
    \\  write note(n: Int) -> Unit
    \\}
    \\
    \\fn stored(k: Int) -> Int / {db.write[rows], audit.write}
    \\  ensures result >= 0
    \\= {
    \\  audit.note(k);
    \\  db.put[rows](k, 1)
    \\}
    \\
  );
  let v = proved_json(["--no-cache"]);
  assert(
    str(at(nth(at(v, "obligations"), 0), "frame")) == "writes m.audit, m.db[rows]",
    Some(json_text(v)),
  )
}

test/nondet "a guard nothing shows empty is no vacuity: its claim is unproved" {
  write_program(
    \\fn seen(xs: List<Int>, x: Int) -> Bool =
    \\  match xs {
    \\    [y, ..rest] -> if y == x { true } else { seen(rest, x) },
    \\    _ -> false,
    \\  }
    \\
    \\law "a narrow window" forall (xs: List<Int>, x: Int)
    \\  where x > 1000000 && x < 1000010 { seen(xs.push(x), x) }
    \\
  );
  let r = spawned(["prove", "--no-cache"]);
  assert(r.code == 1, Some("a claim nothing proves fails the run: " ++ all_output(r)));
  let text = stdout(r);
  assert(text.contains("unproved"), Some(text));
  assert(!text.contains("vacuous"), Some("the guard admits nine values: " ++ text));
  let v = proved_json(["--no-cache"]);
  assert(!bool(at(v, "ok")), Some(json_text(v)));
  assert(
    items(at(v, "diagnostics")).map(|d: Json| str(at(d, "code"))) == ["E0474"],
    Some(json_text(v)),
  );
  let law = nth(at(v, "obligations"), 0);
  assert(str(at(law, "outcome")) == "unproved", Some(json_text(v)));
  assert(str(at(law, "reason_kind")) == "open", Some(json_text(v)));
  assert(int(path(v, ["coverage", "covered"])) == 0, Some(json_text(v)))
}

// A guard that holds an `Int` between two literals leaves a domain a run walks whole, so a claim
// no proof decides is proved, or refuted, at every value the guard admits.
test/nondet "a claim whose guard holds its Int between two literals is judged at every value" {
  let over = |ends: String, guard: String|
    "fn ends_a_square(d: Int) -> Bool = " ++ ends
      ++ "\n\nlaw \"a square's last digit\" forall (n: Int) where "
      ++ guard
      ++ " { ends_a_square((n * n) % 10) }\n";
  let all = "d == 0 || d == 1 || d == 4 || d == 5 || d == 6 || d == 9";
  write_program(over(all, "n >= 0 && n <= 40"));
  let held = nth(at(proved_json(["--no-cache"]), "obligations"), 0);
  assert(str(at(held, "outcome")) == "proved", Some(json_text(held)));
  assert(bool(path(held, ["certificate", "ran"])), Some(json_text(held)));
  assert(
    str(path(held, ["certificate", "summary"])).contains("41 points of Int 0..=40"),
    Some(json_text(held)),
  );
  // One digit short of the claim, which the walk reaches at the first square that ends in it.
  write_program(over("d == 0 || d == 1 || d == 4 || d == 5 || d == 6", "n >= 0 && n <= 40"));
  let short = nth(at(proved_json(["--no-cache"]), "obligations"), 0);
  assert(str(at(short, "outcome")) == "refuted", Some(json_text(short)));
  assert(
    str(at(nth(path(short, ["counterexample", "bindings"]), 0), "value")) == "3",
    Some(json_text(short)),
  )
}

fn by_label(v: Json, needle: String) -> Json / {abort.raise} =
  match items(at(v, "obligations")).filter(|o: Json| str(at(o, "label")).contains(needle)) {
    [o, ..] -> o,
    [] -> panic("no obligation for `" ++ needle ++ "`: " ++ json_text(v)),
  }

test/nondet "a postcondition that raises at the boundary is not proved" {
  write_program(
    \\fn inc(x: Int) -> Int
    \\  ensures result > x
    \\= x + 1
    \\
    \\fn bounded(x: Int) -> Int
    \\  requires x < 100
    \\  ensures result > x
    \\= x + 1
    \\
  );
  let v = proved_json(["--no-cache"]);
  let inc = by_label(v, "m.inc");
  assert(
    str(at(inc, "outcome")) == "unproved",
    Some(
      "`x + 1 > x` has no answer at `i64::MAX`, so nothing proves it of every input: "
        ++ json_text(v),
    ),
  );
  assert(at(inc, "certificate") == Null, Some(json_text(inc)));
  assert(str(at(by_label(v, "m.bounded"), "outcome")) == "proved", Some(json_text(v)));
  assert(
    path(v, ["coverage", "uncovered"]) == Array([Str("m.inc")]),
    Some("a definition whose only claim is unproved is one a reviewer still has to read"),
  )
}

// A closure cannot cross out of a run, so no run decides `adder`'s proposition; `inc` is unproved
// on its own.
test/nondet "a proposition no run can decide is an internal error in Ply and not an unproved claim" {
  write_program(
    \\fn adder(n: Int) -> (Int) -> Int
    \\  ensures result(1) == n + 1
    \\= |x: Int| x + n
    \\
    \\fn inc(x: Int) -> Int
    \\  ensures result > x
    \\= x + 1
    \\
  );
  let r = spawned(["prove", "--no-cache", "--json"]);
  let v = json_of(r);
  let pending = by_label(v, "m.adder");
  assert(
    str(at(pending, "outcome")) == "internal_error",
    Some("the control must be an entry no run can decide: " ++ json_text(pending)),
  );
  assert(
    at(pending, "reason") == Null && at(pending, "reason_kind") == Null,
    Some("Ply's failure is no gap in the claim: " ++ json_text(pending)),
  );
  assert(str(path(pending, ["internal_error", "code"])) == "E0505", Some(json_text(pending)));
  assert(
    str(path(pending, ["internal_error", "message"])).contains("holds a function"),
    Some(json_text(pending)),
  );
  assert(
    str(path(pending, ["internal_error", "summary"])).contains("this is an internal error in Ply"),
    Some(json_text(pending)),
  );
  let open = by_label(v, "m.inc");
  assert(str(at(open, "outcome")) == "unproved", Some(json_text(open)));
  assert(int(path(v, ["summary", "internal_error"])) == 1, Some(json_text(v)));
  assert(int(path(v, ["summary", "unproved"])) == 1, Some(json_text(v)));
  let codes = items(at(v, "diagnostics")).map(|d: Json| str(at(d, "code")));
  assert(
    codes.filter(|c: String| c == "E0474").len() == 1,
    Some("only the program's own claim is E0474: " ++ String::join(codes, ", ")),
  );
  assert(codes.filter(|c: String| c == "E0505").len() > 0, Some(String::join(codes, ", ")));
  assert(r.code == 1, Some("a defect fails the run, as one fails `ply test`: " ++ json_text(v)));
  assert(!bool(at(v, "ok")), Some(json_text(v)))
}

// A claim over a fixed width is judged over the values it names: the seam reads each width as its
// type says, so a law over `U8` is refuted at the byte that breaks it and proved over the 256 that
// hold, and a clause no byte satisfies is vacuous rather than misread.
test/nondet "a claim over a fixed width is judged over the values it names" {
  write_program(
    \\fn narrow(n: Int) -> U8 / {abort.raise}
    \\  requires n >= 0 && n < 256
    \\  ensures Int::of_u8(result) < 256
    \\= U8::of_int(n)
    \\
    \\fn low_bit(b: U8) -> Int
    \\  requires Int::of_u8(b) > 300
    \\  ensures result < 2
    \\= Int::of_u8(b & 1u8)
    \\
    \\type Byte = | Byte(U8)
    \\
    \\law "no byte is seven" forall (b: U8) { Int::of_u8(b) != 7 }
    \\
    \\law "every byte fits" forall (b: U8) { Int::of_u8(b) < 256 }
    \\
    \\law "no Byte is seven" forall (b: Byte) { match b { Byte(x) -> Int::of_u8(x) != 7 } }
    \\
  );
  let r = spawned(["prove", "--no-cache", "--json"]);
  let v = json_of(r);
  [
    { needle: "no byte is seven", value: "7" },
    { needle: "no Byte is seven", value: "Byte(7)" },
  ].fold((), |u: Unit, c: { needle: String, value: String }| {
    let o = by_label(v, c.needle);
    assert(str(at(o, "outcome")) == "refuted", Some(json_text(o)));
    let binding = nth(path(o, ["counterexample", "bindings"]), 0);
    assert(str(at(binding, "name")) == "b", Some(json_text(o)));
    assert(str(at(binding, "value")) == c.value, Some(json_text(o)))
  });
  assert(
    str(at(nth(path(by_label(v, "no byte is seven"), ["counterexample", "bindings"]), 0), "type"))
      == "U8",
    Some(json_text(v)),
  );
  let fits = by_label(v, "every byte fits");
  assert(str(at(fits, "outcome")) == "proved", Some(json_text(fits)));
  let enumerated = items(path(fits, ["certificate", "rules"])).fold(
    [],
    |acc: List<Json>, rule: Json|
      match at(rule, "exhaustive_enumeration") { Null -> acc, e -> acc.push(e) },
  );
  assert(
    enumerated.len() == 1 && int(at(first(enumerated), "points")) == 256,
    Some("every byte was checked: " ++ json_text(fits)),
  );
  assert(str(at(by_label(v, "m.low_bit"), "outcome")) == "vacuous", Some(json_text(v)));
  assert(str(at(by_label(v, "m.narrow"), "outcome")) != "internal_error", Some(json_text(v)));
  assert(int(path(v, ["summary", "internal_error"])) == 0, Some(json_text(v)));
  assert(int(path(v, ["summary", "refuted"])) == 2, Some(json_text(v)));
  assert(r.code == 1, Some(json_text(v)))
}

fn outcomes() -> List<{ label: String, outcome: String }> / {PlyProcess, abort.raise} =
  items(at(proved_json([]), "obligations")).map(|o: Json|
    { label: str(at(o, "label")), outcome: str(at(o, "outcome")) })

// A cached proof survives every plan widening, so only a key over the whole transitive closure keeps
// it current.
test/nondet "editing what a proof rests on re-opens it" {
  // Two links between the claim and its value, so the second edit tests the transitive half.
  let good =
    \\fn leaf() -> Int = 1
    \\
    \\fn base() -> Int = leaf()
    \\
    \\fn shift(x: Int) -> Int
    \\  requires x > 0 && x < 1000
    \\  ensures result == x + 1
    \\= x + base()
    \\
    \\law "shift agrees with base" forall (x: Int) where x > 0 && x < 1000
    \\  { shift(x) == x + base() }
    \\
  ;
  [
    {
      what: "the body",
      from: "= x + base()\n",
      to: "= x + base() + 1\n",
      refuted: ["ensures", "law"],
    },
    {
      what: "the spec",
      from: "ensures result == x + 1",
      to: "ensures result == x + 3",
      refuted: ["ensures"],
    },
    {
      what: "a transitive dependency",
      from: "fn leaf() -> Int = 1",
      to: "fn leaf() -> Int = 2",
      refuted: ["ensures"],
    },
  ].fold((), |u: Unit, e: { what: String, from: String, to: String, refuted: List<String> }| {
    write_program(good);
    let first_outcomes = outcomes();
    assert(
      first_outcomes.filter(|o: { label: String, outcome: String }| o.outcome != "proved").len()
        == 0,
      Some("the baseline is two proofs"),
    );
    let broken = good.replace(e.from, e.to);
    assert(broken != good, Some("the edit to " ++ e.what ++ " matched nothing"));
    write("m.ply", broken);
    let after = outcomes();
    e.refuted.fold(u, |w: Unit, kind: String|
      match after.filter(|o: { label: String, outcome: String }| o.label.contains(kind)) {
        [found, ..] ->
          assert(
            found.outcome == "refuted",
            Some(
              "editing " ++ e.what ++ " left `" ++ found.label ++ "` cached as `" ++ found.outcome
                ++ "`, which is a proof of something no longer true",
            ),
          ),
        [] -> panic("no `" ++ kind ++ "` obligation after editing " ++ e.what),
      })
  })
}

// A finite domain is walked in a fixed order, so the point that fails is the one reported.
test/nondet "an enumerated refutation is reported at the point that fails" {
  write_program(
    \\type Day = Mon | Tue | Wed | Thu | Fri | Sat | Sun
    \\
    \\fn rank(d: Day) -> Int =
    \\  match d { Mon -> 1, Tue -> 2, Wed -> 3, Thu -> 4, Fri -> 5, Sat -> 6, Sun -> 7 }
    \\
    \\law "every day is early" forall (d: Day) { rank(d) / 1 < 7 }
    \\
  );
  let o = nth(at(proved_json(["--no-cache"]), "obligations"), 0);
  assert(str(at(o, "outcome")) == "refuted", Some(json_text(o)));
  assert(
    str(at(nth(path(o, ["counterexample", "bindings"]), 0), "value")) == "Sun",
    Some(json_text(o)),
  )
}

// A claim over a domain no run walks is tried at a few small values and at the literals it is
// written with, which is where a claim about a bound fails.
test/nondet "a claim is refuted at a literal it is written with" {
  write_program("law \"the bound holds\"\n  forall (n: Int) {\n    n < 100\n  }\n");
  let r = spawned(["prove"]);
  assert(r.code == 1, Some(all_output(r)));
  let text = stdout(r);
  assert(text.contains("refuted"), Some(text));
  assert(text.contains("→  n = 100"), Some(text))
}

fn obligation(report: Json, label: String) -> Json =
  first(items(at(report, "obligations")).filter(|o: Json| str(at(o, "label")) == label))

test/nondet "an instantiation is discharged as its schema's body written out, and names its schema" {
  let over = |laws: String|
    "fn clamp(n: Int) -> Int = if n > 10 { 10 } else { n }\n\nfn reverse(xs: List<Int>) -> List<Int> =\n  match xs { [] -> [], [x, ..rest] -> reverse(rest).push(x) }\n\n"
      ++ laws;
  write_program(
    over(
      \\law "clamp resolves" forall (x: Int) { clamp(clamp(x)) == clamp(x) }
      \\
      \\law "reverse twice" forall (x: List<Int>) { reverse(reverse(x)) == x }
      \\
      \\law "small values are fixed" forall (x: Int) where x > 0 && x < 10 { clamp(x) == x }
      \\
    ),
  );
  let written = proved_json(["--no-cache"]);
  write_program(
    over(
      \\law schema idempotent<a>(f: (a) -> a) forall (x: a) { f(f(x)) == f(x) }
      \\
      \\law schema involution<a>(f: (a) -> a) forall (x: a) { f(f(x)) == x }
      \\
      \\law schema fixed_within(f: (Int) -> Int, low: Int, high: Int)
      \\  forall (x: Int) where x > low && x < high { f(x) == x }
      \\
      \\law "clamp resolves" = idempotent(clamp)
      \\
      \\law "reverse twice" = involution(reverse)
      \\
      \\law "small values are fixed" = fixed_within(clamp, 0, 10)
      \\
    ),
  );
  let made = proved_json(["--no-cache"]);
  assert(at(made, "exit_code") == at(written, "exit_code"), Some(json_text(made)));
  // A schema's own definitions are what is claimed, not definitions to carry a claim.
  assert(at(made, "coverage") == at(written, "coverage"), Some(json_text(at(made, "coverage"))));
  let schema_of = |label: String, outcome: String| {
    let m = obligation(made, "law \"" ++ label ++ "\"");
    let w = obligation(written, "law \"" ++ label ++ "\"");
    assert(
      str(at(m, "outcome")) == outcome && str(at(w, "outcome")) == outcome,
      Some(json_text(m)),
    );
    assert(
      at(m, "certificate") == at(w, "certificate"),
      Some(json_text(m) ++ "\n" ++ json_text(w)),
    );
    assert(at(m, "reason") == at(w, "reason"), Some(json_text(m) ++ "\n" ++ json_text(w)));
    assert(at(m, "guarded") == at(w, "guarded"), Some(json_text(m)));
    assert(at(w, "schema") == Null, Some(json_text(w)));
    str(at(m, "schema"))
  };
  assert(schema_of("clamp resolves", "proved") == "m.idempotent", Some(json_text(made)));
  // An induction over a list is one the prover does not make.
  assert(schema_of("reverse twice", "unproved") == "m.involution", Some(json_text(made)));
  assert(schema_of("small values are fixed", "proved") == "m.fixed_within", Some(json_text(made)))
}

test/nondet "a refuted instantiation is refuted at the schema's binder, where it is written" {
  write_program(
    \\fn x(n: Int) -> Int = if n > 0 { 0 } else { n }
    \\
    \\law schema involution<a>(f: (a) -> a) forall (x: a) { f(f(x)) == x }
    \\
    \\law "a clamp undoes itself" = involution(x)
    \\
  );
  let r = spawned(["prove", "--no-cache"]);
  assert(r.code == 1, Some(all_output(r)));
  assert(stdout(r).contains("forall (x: Int)"), Some(stdout(r)));
  assert(stdout(r).contains("schema: m.involution"), Some(stdout(r)));
  let o = obligation(
    json_of(spawned(["prove", "--no-cache", "--json"])),
    "law \"a clamp undoes itself\"",
  );
  assert(str(at(o, "outcome")) == "refuted", Some(json_text(o)));
  assert(str(at(o, "location")) == "m.ply:5:1", Some(json_text(o)));
  assert(
    str(at(nth(path(o, ["counterexample", "bindings"]), 0), "name")) == "x",
    Some(json_text(o)),
  )
}

test/nondet "a schema takes what raises a rejection of its own, and quantifies the `new` record it is given" {
  let over = |laws: String|
    "type Sign = new { negative: Bool }\n\neffect reader {\n  raise rejected(at: Int)\n}\n\nfn shown(s: Sign) -> String = if s.negative { \"-\" } else { \"+\" }\n\nfn read(t: String) -> Option<Sign> / {reader.rejected} =\n  if t == \"-\" { Some({ negative: true }) }\n  else if t == \"+\" { Some({ negative: false }) }\n  else { reader.rejected(t.len()) }\n\nfn digit(n: Int) -> Int / {reader.rejected} = if n < 0 { reader.rejected(n) } else { n % 10 }\n\n"
      ++ laws;
  write_program(
    over(
      \\law "a sign reads back" forall (x: Sign) { read(shown(x)) == Some(x) }
      \\
      \\law "a digit resolves" forall (x: Int) { digit(digit(x)) == digit(x) }
      \\
    ),
  );
  let written = proved_json(["--no-cache"]);
  write_program(
    over(
      \\law schema reads_back<a, b | e>(shown: (a) -> b / e, read: (b) -> Option<a> / e)
      \\  forall (x: a) { read(shown(x)) == Some(x) }
      \\
      \\law schema settles<a | e>(f: (a) -> a / e) forall (x: a) { f(f(x)) == f(x) }
      \\
      \\law "a sign reads back" = reads_back(shown, read)
      \\
      \\law "a digit resolves" = settles(digit)
      \\
    ),
  );
  let made = proved_json(["--no-cache"]);
  let same = |label: String, key: String| {
    let m = obligation(made, "law \"" ++ label ++ "\"");
    let w = obligation(written, "law \"" ++ label ++ "\"");
    assert(
      at(m, key) != Null && at(m, key) == at(w, key),
      Some(json_text(m) ++ "\n" ++ json_text(w)),
    );
    assert(at(m, "outcome") == at(w, "outcome"), Some(json_text(m) ++ "\n" ++ json_text(w)));
    m
  };
  // A `new` record of two values is every value there is of it, to the schema as to the law.
  let sign = same("a sign reads back", "certificate");
  assert(
    str(path(sign, ["certificate", "summary"])).contains("2 points of m.Sign"),
    Some(json_text(sign)),
  );
  // An error of the program's own leaves the claim unproved at the point that raised it.
  let digit = same("a digit resolves", "reason");
  assert(str(at(digit, "reason_kind")) == "raised", Some(json_text(digit)));
  assert(str(at(digit, "reason")).contains("m.reader.rejected"), Some(json_text(digit)))
}

fn reads_back() -> String =
  "law schema reads_back<a, b | e>(shown: (a) -> b / e, read: (b) -> Option<a> / e)\n  forall (x: a) { read(shown(x)) == Some(x) }\n\n"

// A claim ranges over a type another module keeps opaque, and nothing outside that module builds a
// value of one: no run tries such a claim, so nothing refutes it and no point of it is shown.
test/nondet "a claim over a type another module keeps opaque is never run" {
  write_program(
    "import std.html (Html, render)\n\n" ++ reads_back()
      ++ "law \"no page is a word\" forall (xs: List<Html>) { xs.filter(|x: Html| render(x) == \"word\").len() == 0 }\n\nlaw \"a page reads back\" = reads_back(render, |s: String| -> Option<Html> { None })\n\nfn width(page: Html) -> Int / {abort.raise}\n  ensures result != 7\n= render(page).len()\n",
  );
  assert(on_disk(["check"]).code == 0, None);
  let report = proved_json(["--no-cache"]);
  [
    obligation(report, "law \"no page is a word\""),
    obligation(report, "law \"a page reads back\""),
    obligation_owned_by(report, "m.width"),
  ].fold((), |u: Unit, o: Json| {
    assert(str(at(o, "outcome")) == "unproved", Some(json_text(o)));
    assert(at(o, "counterexample") == Null && at(o, "raised_at") == Null, Some(json_text(o)))
  })
}

test "an instantiation is rejected where it is written, for what it is given and what it quantifies" {
  scratch(|| {
    let over = |law: String|
      "fn id(n: Int) -> Int = n\n\nfn held(t: Task<Int>) -> Task<Int> = t\n\nlaw schema same<a>(f: (a) -> a) forall (x: a) { f(x) == x }\n\n"
        ++ law
        ++ "\n";
    let rejected = |law: String, code: String, at_text: String| {
      write_program(over(law));
      let r = on_disk(["check"]);
      assert(r.code != 0, Some(all_output(r)));
      assert(
        all_output(r).contains("Error[" ++ code ++ "]") && all_output(r).contains(at_text),
        Some(all_output(r)),
      )
    };
    rejected("law \"l\" = id(id)", "E0472", "`id` is not a law schema");
    rejected(
      "law \"l\" = same(id, id)",
      "E0202",
      "the schema `same` takes 1 argument, but 2 were supplied",
    );
    rejected("law \"l\" = same(Int::to_string)", "E0201", "m.ply:7:16");
    rejected(
      "law \"l\" = same(held)",
      "E0418",
      "the schema `same` binds `x`, which is a `Task<Int>` here",
    )
  })
}
