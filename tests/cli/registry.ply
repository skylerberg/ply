import harness (Server, reserve_port, start_server, connected, hang_up, stop, spawned, kept_path,
                PlyProcess, Clock)
import support.harness (RunResult, write, read, empty_working_directory, working_directory, repo,
                        send, all_output, json_of, at, path, nth, str, bool, int, json_text,
                        WorkingDirectory, Repo, Network, assert_ok, exists, value_of)
import std.certgen (certgen)
import std.fs (fs)
import std.time (time)
import std.json
import std.json (Json)
import std.net
import std.process (EnvironmentVariable)
import std.string

fn token() -> String = "t0k-for-orders"

type Registry = { server: Server, url: String, trust: Option<String> }

type Tls = { certificate: String, key: String }

fn service_stage() -> List<EnvironmentVariable> / {fs.read[cwd], abort.raise} =
  [{ name: "PLY_C_STAGE", value: working_directory() ++ "/" ++ kept_path("registry") }]

fn start(
  tls: Option<Tls>,
) -> Registry / {Network, PlyProcess, Clock, WorkingDirectory, Repo, abort.raise, diverges} =
  start_with(tls, |_url: String| [])

fn start_with(
  tls: Option<Tls>,
  more: (String) -> List<String>,
) -> Registry / {Network, PlyProcess, Clock, WorkingDirectory, Repo, abort.raise, diverges} = {
  let port = reserve_port();
  if !fs.create_dir[cwd]("store") { panic("the store is made") };
  write("tokens.conf", "token.orders=" ++ token() ++ "\n");
  let here = working_directory();
  let plain = [
    "run",
    repo() ++ "/packages/registry",
    "--fs",
    "store=" ++ here ++ "/store",
    "--set",
    "port=" ++ port.to_string(),
    "--config",
    here ++ "/tokens.conf",
  ];
  let secure_url = match tls { Some(_) -> true, None -> false };
  let url_of = if secure_url { "https://localhost:" ++ port.to_string() }
  else { "http://127.0.0.1:" ++ port.to_string() };
  let argv = List::concat(
    match tls {
      None -> plain,
      Some(t) ->
        plain.concat([
          "--tls",
          "registry=" ++ here ++ "/" ++ t.certificate ++ "," ++ here ++ "/" ++ t.key,
          "--set",
          "tls=registry",
        ]),
    },
    more(url_of),
  );
  let server = start_server(argv, service_stage(), port);
  let secure = match tls { Some(_) -> true, None -> false };
  let probed = connected(server, |c: Int|
    secure
      || {
        send(c, b"GET /nobody/index.json HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n");
        String::of_bytes_lossy(net::drain[client](c, b"", 10000)).starts_with("HTTP/1.1 404")
      });
  match probed {
    Ok(c) -> hang_up(c),
    Err(reason) -> {
      stop(server);
      panic(reason)
    },
  };
  {
    server: server,
    url: if secure { "https://localhost:" ++ port.to_string() }
    else { "http://127.0.0.1:" ++ port.to_string() },
    trust: match tls { Some(t) -> Some(here ++ "/" ++ t.certificate), None -> None },
  }
}

fn index(name: String) -> Json / {WorkingDirectory, abort.raise} =
  match read("store/" ++ name ++ "/index.json") {
    Some(text) -> match json::parse_string(text) {
      Ok(j) -> j,
      Err(e) -> panic("the index is JSON: " ++ json::error_to_string(e)),
    },
    None -> panic("the registry wrote the index"),
  }

fn run_with_registry(
  r: Registry,
  with_token: Bool,
  argv: List<String>,
) -> RunResult / {PlyProcess, abort.raise} = {
  let named = [{ name: "PLY_REGISTRY", value: r.url }];
  let variables = if with_token { named.push({ name: "PLY_REGISTRY_TOKEN", value: token() }) }
  else { named };
  match r.trust {
    Some(certificate) -> spawned(argv, variables.push({ name: "PLY_TRUST", value: certificate })),
    None -> spawned(argv, variables),
  }
}

fn assert_rejected(ran: RunResult, code: String, words: String) -> Unit / {abort.raise} = {
  assert(ran.code == 2, Some(all_output(ran)));
  assert(all_output(ran).contains(code), Some(code ++ " is not in:\n" ++ all_output(ran)));
  assert(all_output(ran).contains(words), Some("`" ++ words ++ "` is not in:\n" ++ all_output(ran)))
}

fn replace_in_file(p: String, from: String, to: String) -> Unit / {WorkingDirectory, abort.raise} =
  match read(p) {
    None -> panic("`" ++ p ++ "` reads"),
    Some(text) -> match text.split_once(from) {
      Some(parts) -> write(p, parts.head ++ to ++ parts.tail),
      None -> panic("`" ++ p ++ "` the claim is now disproved `" ++ from ++ "`"),
    },
  }

fn remove_tree(p: String) -> Unit / {fs.remove_tree[cwd], abort.raise} =
  if !fs.remove_tree[cwd](p) { panic("could not remove `" ++ p ++ "`") }

fn remove_file(p: String) -> Unit / {fs.remove[cwd], abort.raise} =
  if !fs.remove[cwd](p) { panic("could not remove `" ++ p ++ "`") }

fn copy_file(from: String, to: String) -> Unit / {fs.copy[cwd], abort.raise} =
  if !fs.copy[cwd](from, to) { panic("could not copy `" ++ from ++ "` to `" ++ to ++ "`") }

fn write_app() -> Unit / {WorkingDirectory, abort.raise} = {
  write(
    "app/ply.pkg",
    "import std.pkg (Manifest)\nfn package() -> Manifest = {name: \"app\", version: {major: 0, minor: 1, patch: 0}, prefix: None, runtime: {major: 0, minor: 1, patch: 0}, dependencies: [{name: \"orders\", prefix: None, min: {major: 0, minor: 1, patch: 0}, source: Registry}], entry: None}\n",
  );
  write("app/main.ply", "import orders.lib\nfn main() -> Int = lib::double(21)\n")
}

fn lock() -> Json / {WorkingDirectory, abort.raise} =
  match read("app/ply.lock") {
    Some(text) -> match json::parse_string(text) {
      Ok(j) -> j,
      Err(e) -> panic("the lock is JSON: " ++ json::error_to_string(e)),
    },
    None -> panic("the lock was written"),
  }

fn locked_package_field(field: String) -> Json / {WorkingDirectory, abort.raise} =
  at(nth(at(lock(), "packages"), 0), field)

test/nondet "a library is published, resolved and built, and a tampered archive is rejected" {
  empty_working_directory();
  let registry = start(None);

  assert_ok(spawned(["new", "orders", "--lib"]));
  let out = run_with_registry(registry, true, ["publish", "orders", "--json"]);
  assert_ok(out);
  let v = json_of(out);
  assert_eq(str(at(v, "command")), "publish");
  assert_eq(str(at(v, "version")), "0.1.0");
  let published = str(at(v, "digest"));
  assert(published.len() == "b3:".len() + 64, Some(published));
  assert_eq(str(at(nth(at(index("orders"), "versions"), 0), "digest")), published);
  assert_eq(read("store/orders/0.1.0/package.plyz.b3"), Some(published ++ "\n"));

  let again = run_with_registry(registry, true, ["publish", "orders", "--json"]);
  assert_ok(again);
  assert(bool(at(json_of(again), "already")), Some(all_output(again)));
  replace_in_file("orders/lib.ply", "n * 2", "2 * n");
  assert_rejected(run_with_registry(registry, true, ["publish", "orders"]), "E0144", "409");
  replace_in_file("orders/lib.ply", "2 * n", "n * 2");
  assert_rejected(
    run_with_registry(registry, false, ["publish", "orders"]),
    "E0141",
    "PLY_REGISTRY_TOKEN",
  );

  write_app();
  assert_rejected(spawned(["check", "app"]), "E0135", "has not been fetched");
  write(".git/HEAD", "ref: refs/heads/main\n");
  assert_ok(run_with_registry(registry, false, ["resolve", "app"]));
  assert_eq(str(locked_package_field("name")), "orders");
  assert_eq(str(locked_package_field("version")), "0.1.0");
  assert_eq(str(locked_package_field("archive")), published);
  assert(str(locked_package_field("digest")).starts_with("b3:"), Some(json_text(lock())));
  assert(exists("app/.ply-cache/registry/orders/ply.pkg"), None);
  assert(exists("app/.ply-cache/registry/orders@0.1.0.plyz"), None);

  assert_ok(spawned(["build", "app", "-o", "app.plyx"]));
  assert_eq(value_of(spawned(["run", "--json", "app.plyx"])), "42");
  assert_ok(spawned(["vendor", "app"]));
  assert(exists("app/vendor/orders/lib.ply"), None);
  remove_tree("app/vendor");

  let moved = "`orders` is not what `ply.lock` pins";
  replace_in_file("app/.ply-cache/registry/orders/lib.ply", "n * 2", "n * 4");
  assert_rejected(spawned(["build", "app", "-o", "app.plyx"]), "E0138", moved);
  assert_rejected(spawned(["vendor", "app"]), "E0138", moved);
  replace_in_file("app/.ply-cache/registry/orders/lib.ply", "n * 4", "n * 2");
  assert_ok(spawned(["new", "shelf", "--lib"]));
  replace_in_file(
    "shelf/ply.pkg",
    "dependencies: []",
    "dependencies: [{name: \"orders\", prefix: None, min: {major: 0, minor: 1, patch: 0}, source: Registry}]",
  );
  assert_ok(run_with_registry(registry, false, ["resolve", "shelf"]));
  replace_in_file("shelf/.ply-cache/registry/orders/lib.ply", "n * 2", "n * 4");
  assert_rejected(run_with_registry(registry, true, ["publish", "shelf"]), "E0138", moved);
  remove_tree("shelf");

  replace_in_file(
    "orders/ply.pkg",
    "version: { major: 0, minor: 1, patch: 0 }",
    "version: { major: 0, minor: 2, patch: 0 }",
  );
  assert_ok(run_with_registry(registry, true, ["publish", "orders"]));
  assert_ok(run_with_registry(registry, true, ["yank", "orders", "0.1.0"]));
  let versions = at(index("orders"), "versions");
  assert(bool(at(nth(versions, 0), "yanked")), Some(json_text(versions)));
  assert_eq(str(at(nth(versions, 1), "version")), "0.2.0");
  assert_ok(run_with_registry(registry, false, ["resolve", "app"]));
  assert_eq(str(locked_package_field("version")), "0.1.0");
  remove_file("app/ply.lock");
  assert_ok(run_with_registry(registry, false, ["resolve", "app"]));
  let fresh_lock = lock();
  assert_eq(str(at(nth(at(fresh_lock, "packages"), 0), "version")), "0.2.0");

  ["ply.pkg", "lib.ply"].fold((), |u: Unit, file: String|
    match read("orders/" ++ file) {
      Some(text) -> write("evil/" ++ file, text),
      None -> panic("`orders/" ++ file ++ "` reads"),
    });
  replace_in_file("evil/lib.ply", "n * 2", "n * 3");
  assert_ok(spawned(["build", "evil", "-o", "evil.plyz"]));
  copy_file("evil.plyz", "store/orders/0.2.0/package.plyz");
  remove_tree("app/.ply-cache");
  assert_rejected(
    run_with_registry(registry, false, ["resolve", "app"]),
    "E0142",
    "`ply.lock` pins it",
  );
  assert(lock() == fresh_lock, Some("a rejected resolve wrote the lock"));
  assert(!exists("app/.ply-cache/registry/orders"), None);
  remove_file("app/ply.lock");
  assert_rejected(run_with_registry(registry, false, ["resolve", "app"]), "E0142", "index lists");
  stop(registry.server)
}

fn appeared(p: String, ms: Int) -> Bool / {fs.exists[cwd], Clock, abort.raise} = {
  let until = time.elapsed_ms() + ms;
  iterate((), ms / 100 + 1, |_u: Unit|
    if fs.exists[cwd](p) { Stop(true) }
    else if time.elapsed_ms() >= until { Stop(false) } else {
      time.sleep_ms(100);
      Continue(())
    })
}

fn public_hex() -> String / {WorkingDirectory, abort.raise} =
  match read("attester.key.pub") {
    Some(text) -> match text.trim().split_once(" ") {
      Some(parts) -> parts.tail,
      None -> panic("a public key file is one line"),
    },
    None -> panic("`ply keygen` wrote the attester's public key"),
  }

test/nondet "the registry signs each published version with its attestation key, and `check` reports whether each signature is valid" {
  empty_working_directory();
  assert_ok(spawned(["keygen", "attester.key"]));
  let here = working_directory();
  let attester = public_hex();
  let binary = repo() ++ "/target/debug/ply";
  let registry = start_with(None, |url: String|
    [
      "--exec",
      "attest=" ++ binary,
      "--set",
      "attester=" ++ attester,
      "--set",
      "attest.key=" ++ here ++ "/attester.key",
      "--set",
      "url=" ++ url,
    ]);
  assert_ok(spawned(["new", "orders", "--lib"]));
  let out = run_with_registry(registry, true, ["publish", "orders", "--json"]);
  assert_ok(out);
  let semantics = str(at(json_of(out), "semantics"));
  assert(
    appeared("store/orders/0.1.0/attestation/" ++ semantics, 240000),
    Some("the attester kept no attestation of orders 0.1.0"),
  );

  write(
    "orders/lib.ply",
    "pub fn double(n: Int) -> Int = n * 2\n\nlaw \"doubling is tripling\" forall (n: Int) where n > 0 && n < 9 { double(n) == n * 3 }\n",
  );
  replace_in_file(
    "orders/ply.pkg",
    "version: { major: 0, minor: 1, patch: 0 }",
    "version: { major: 0, minor: 2, patch: 0 }",
  );
  assert_ok(run_with_registry(registry, true, ["publish", "orders"]));
  assert(
    appeared("store/orders/0.2.0/attestation/" ++ semantics, 240000),
    Some("the attester kept no attestation of orders 0.2.0"),
  );

  write_app();
  let trusting = [
    { name: "PLY_REGISTRY", value: registry.url },
    { name: "PLY_ATTESTERS", value: here ++ "/attester.key.pub" },
  ];
  let first = spawned(["resolve", "app", "--json"], trusting);
  assert_ok(first);
  let a = at(nth(at(json_of(first), "packages"), 0), "attestation");
  assert(bool(at(a, "attested")), Some(all_output(first)));
  assert(int(path(a, ["tests", "passed"])) >= 1, Some(all_output(first)));
  let unnamed = run_with_registry(registry, false, ["resolve", "app", "--json"]);
  assert_ok(unnamed);
  let untrusted = at(nth(at(json_of(unnamed), "packages"), 0), "attestation");
  assert(
    !bool(at(untrusted, "trusted")) && !bool(at(untrusted, "attested")),
    Some(all_output(unnamed)),
  );

  replace_in_file(
    "app/ply.pkg",
    "min: {major: 0, minor: 1, patch: 0}",
    "min: {major: 0, minor: 2, patch: 0}",
  );
  let second = spawned(["resolve", "app", "--json"], trusting);
  assert_ok(second);
  let b = at(nth(at(json_of(second), "packages"), 0), "attestation");
  assert(
    !bool(at(b, "attested")) && int(path(b, ["proofs", "refuted"])) >= 1,
    Some(all_output(second)),
  );
  stop(registry.server)
}

test/nondet "a registry with a private certificate works when `PLY_TRUST` names the certificate and fails without it" {
  empty_working_directory();
  let issued = certgen.issue();
  write("registry.pem", issued.certificate);
  write("registry.key", issued.key);
  let registry = start(Some({ certificate: "registry.pem", key: "registry.key" }));

  assert_ok(spawned(["new", "orders", "--lib"]));
  assert_ok(run_with_registry(registry, true, ["publish", "orders"]));
  write_app();
  assert_ok(run_with_registry(registry, false, ["resolve", "app"]));
  assert_eq(str(locked_package_field("version")), "0.1.0");

  let out = spawned(["resolve", "app"], [{ name: "PLY_REGISTRY", value: registry.url }]);
  assert_rejected(out, "E0141", "did not complete a TLS handshake");
  assert(all_output(out).contains("PLY_TRUST"), Some(all_output(out)));

  let absent = spawned(["check", "app"], [
    { name: "PLY_TRUST", value: working_directory() ++ "/absent.pem" },
  ]);
  assert(absent.code != 0, Some(all_output(absent)));
  assert(all_output(absent).contains("E0430"), Some(all_output(absent)));
  assert(all_output(absent).contains("absent.pem"), Some(all_output(absent)));
  stop(registry.server)
}
