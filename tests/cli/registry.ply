//! The registry end to end: the service package `registry` run by `ply run` on a port of its
//! own, and the commands that talk to it (`ply publish`, `ply resolve`, `ply yank`) over a real
//! socket, with the store a directory the test reads back.

import harness (scratch, RunResult, Server, write, read, empty_working_directory, working_directory,
                repo, reserve_port, start_server, connected, send, hang_up, stop, on_disk,
                on_disk_with, spawned, all_output, json_of, at, path, nth, str, bool, int, items,
                json_text, WorkingDirectory, Repo, Shipped, PlyProcess, CliEffects, Network, Clock,
                assert_ok, exists, package_dir, value_of)
import compiler.front.rows (KnownDefinitionRow)
import compiler.front.interface (Interface, ModuleInterface, interface_bin, envelope_of, enveloped)
import compiler.front.exports (OwnerInterface)
import std.bin
import std.certgen (certgen)
import std.fs (fs)
import std.time (time)
import std.json
import std.json (Json)
import std.net

import std.string
import std.list

fn token() -> String = "t0k-for-orders"

/// The running service, the URL a client names it by, and the certificate a client names in
/// `PLY_TRUST` when it serves over TLS.
type Registry = { server: Server, url: String, trust: Option<String> }

type Tls = { certificate: String, key: String }

/// Over plain HTTP, or over `--tls` with the certificate and key files `tls` names.
fn start(
  tls: Option<Tls>,
) -> Registry / {Network, PlyProcess, Clock, WorkingDirectory, Repo, abort.raise, diverges} =
  start_with(tls, |_url: String| [])

/// As `start`, with more of the registry's command line, given the URL it will be reached at.
fn start_with(
  tls: Option<Tls>,
  more: (String) -> List<String>,
) -> Registry / {Network, PlyProcess, Clock, WorkingDirectory, Repo, abort.raise, diverges} = {
  let port = reserve_port();
  if !fs.create_dir[cwd]("store") { panic("the store is made") };
  write("tokens.conf", "token.orders=" ++ token() ++ "\n");
  let here = working_directory();
  let plain = [
    "run",
    repo() ++ "/" ++ package_dir("registry"),
    "--fs",
    "store=" ++ here ++ "/store",
    "--set",
    "port=" ++ port.to_string(),
    "--config",
    here ++ "/tokens.conf",
  ];
  let secure_url = match tls { Some(_) -> true, None -> false };
  let url_of = if secure_url { "https://localhost:" ++ port.to_string() }
  else { "http://127.0.0.1:" ++ port.to_string() };
  let argv = List::concat(
    match tls {
      None -> plain,
      Some(t) ->
        plain.concat([
          "--tls",
          "registry=" ++ here ++ "/" ++ t.certificate ++ "," ++ here ++ "/" ++ t.key,
          "--set",
          "tls=registry",
        ]),
    },
    more(url_of),
  );
  let server = start_server(argv, [], port);
  let secure = match tls { Some(_) -> true, None -> false };
  // Over plain HTTP, the registry's own answer for a package nobody published proves the port is
  // its; over TLS the reservation already made the port this registry's alone.
  let probed = connected(server, |c: Int|
    secure
      || {
        send(c, b"GET /nobody/index.json HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n");
        String::of_bytes_lossy(net::drain[client](c, b"", 10000)).starts_with("HTTP/1.1 404")
      });
  match probed {
    Ok(c) -> hang_up(c),
    Err(reason) -> {
      stop(server);
      panic(reason)
    },
  };
  {
    server: server,
    url: if secure { "https://localhost:" ++ port.to_string() }
    else { "http://127.0.0.1:" ++ port.to_string() },
    trust: match tls { Some(t) -> Some(here ++ "/" ++ t.certificate), None -> None },
  }
}

fn index(name: String) -> Json / {WorkingDirectory, abort.raise} =
  match read("store/" ++ name ++ "/index.json") {
    Some(text) -> match json::parse_string(text) {
      Ok(j) -> j,
      Err(e) -> panic("the index is JSON: " ++ json::error_to_string(e)),
    },
    None -> panic("the registry wrote the index"),
  }

/// `ply` pointed at the registry, with the publisher's token when `with_token` says so.
fn run_with_registry(
  r: Registry,
  with_token: Bool,
  argv: List<String>,
) -> RunResult / {CliEffects, Shipped, PlyProcess, abort.raise, diverges} = {
  let named = [{ name: "PLY_REGISTRY", value: r.url }];
  let vars = if with_token { named.push({ name: "PLY_REGISTRY_TOKEN", value: token() }) }
  else { named };
  match r.trust {
    // The launcher reads `PLY_TRUST`, so only a process is handed it.
    Some(certificate) -> spawned(argv, vars.push({ name: "PLY_TRUST", value: certificate })),
    None -> on_disk_with(argv, vars, None),
  }
}

fn assert_rejected(ran: RunResult, code: String, words: String) -> Unit / {abort.raise} = {
  assert(ran.code == 2, Some(all_output(ran)));
  assert(all_output(ran).contains(code), Some(code ++ " is not in:\n" ++ all_output(ran)));
  assert(all_output(ran).contains(words), Some("`" ++ words ++ "` is not in:\n" ++ all_output(ran)))
}

/// The first `from` in the file at `p` made `to`.
fn replace_in_file(p: String, from: String, to: String) -> Unit / {WorkingDirectory, abort.raise} =
  match read(p) {
    None -> panic("`" ++ p ++ "` reads"),
    Some(text) -> match text.split_once(from) {
      Some(parts) -> write(p, parts.head ++ to ++ parts.tail),
      None -> panic("`" ++ p ++ "` no longer holds `" ++ from ++ "`"),
    },
  }

fn remove_tree(p: String) -> Unit / {fs.remove_tree[cwd], abort.raise} =
  if !fs.remove_tree[cwd](p) { panic("could not remove `" ++ p ++ "`") }

fn remove_file(p: String) -> Unit / {fs.remove[cwd], abort.raise} =
  if !fs.remove[cwd](p) { panic("could not remove `" ++ p ++ "`") }

fn copy_file(from: String, to: String) -> Unit / {fs.copy[cwd], abort.raise} =
  if !fs.copy[cwd](from, to) { panic("could not copy `" ++ from ++ "` to `" ++ to ++ "`") }

/// A program depending on `orders` from the registry, at least 0.1.0.
fn an_app() -> Unit / {WorkingDirectory, abort.raise} = {
  write(
    "app/ply.pkg",
    "import std.pkg (Manifest)\nfn package() -> Manifest = {name: \"app\", version: {major: 0, minor: 1, patch: 0}, prefix: None, runtime: {major: 0, minor: 1, patch: 0}, dependencies: [{name: \"orders\", prefix: None, min: {major: 0, minor: 1, patch: 0}, source: Registry}], entry: None}\n",
  );
  write("app/main.ply", "import orders.lib\nfn main() -> Int = lib::double(21)\n")
}

fn lock() -> Json / {WorkingDirectory, abort.raise} =
  match read("app/ply.lock") {
    Some(text) -> match json::parse_string(text) {
      Ok(j) -> j,
      Err(e) -> panic("the lock is JSON: " ++ json::error_to_string(e)),
    },
    None -> panic("the lock was written"),
  }

fn pinned(field: String) -> Json / {WorkingDirectory, abort.raise} =
  at(nth(at(lock(), "packages"), 0), field)

test/nondet "a library is published, resolved, built, and its tampered archive rejected" {
  empty_working_directory();
  let registry = start(None);

  assert_ok(on_disk(["new", "orders", "--lib"]));
  let out = run_with_registry(registry, true, ["publish", "orders", "--json"]);
  assert_ok(out);
  let v = json_of(out);
  assert_eq(str(at(v, "command")), "publish");
  assert_eq(str(at(v, "version")), "0.1.0");
  let published = str(at(v, "digest"));
  assert(published.len() == "b3:".len() + 64, Some(published));
  assert_eq(str(at(nth(at(index("orders"), "versions"), 0), "digest")), published);
  assert_eq(read("store/orders/0.1.0/package.plyz.b3"), Some(published ++ "\n"));

  // A version is published once: the same bytes again are what the registry holds, and other bytes
  // under that version are refused. A publish needs a token the name maps to.
  let again = run_with_registry(registry, true, ["publish", "orders", "--json"]);
  assert_ok(again);
  assert(bool(at(json_of(again), "already")), Some(all_output(again)));
  replace_in_file("orders/lib.ply", "n * 2", "2 * n");
  assert_rejected(run_with_registry(registry, true, ["publish", "orders"]), "E0144", "409");
  replace_in_file("orders/lib.ply", "2 * n", "n * 2");
  assert_rejected(
    run_with_registry(registry, false, ["publish", "orders"]),
    "E0141",
    "PLY_REGISTRY_TOKEN",
  );

  // Nothing reads the registry but `ply resolve`: before it, the dependency is not there.
  an_app();
  assert_rejected(on_disk(["check", "app"]), "E0135", "has not been fetched");
  // In a checkout too, a registry dependency is pinned by its digest and its archive's: the commit
  // holds neither, wherever the cache keeps its tree.
  write(".git/HEAD", "ref: refs/heads/main\n");
  assert_ok(run_with_registry(registry, false, ["resolve", "app"]));
  assert_eq(str(pinned("name")), "orders");
  assert_eq(str(pinned("version")), "0.1.0");
  assert_eq(str(pinned("archive")), published);
  assert(str(pinned("digest")).starts_with("b3:"), Some(json_text(lock())));
  assert(exists("app/.ply-cache/registry/orders/ply.pkg"), None);
  assert(exists("app/.ply-cache/registry/orders@0.1.0.plyz"), None);

  // Every other command reads the cache, the machine's walk included.
  assert_ok(spawned(["build", "app", "-o", "app.plyx"]));
  assert_eq(value_of(spawned(["run", "--json", "app.plyx"])), "42");
  assert_ok(on_disk(["vendor", "app"]));
  assert(exists("app/vendor/orders/lib.ply"), None);
  remove_tree("app/vendor");

  // Sources in the cache that are not what the lock pins are refused by every reader of the lock.
  let moved = "`orders` is not what `ply.lock` pins";
  replace_in_file("app/.ply-cache/registry/orders/lib.ply", "n * 2", "n * 4");
  assert_rejected(spawned(["build", "app", "-o", "app.plyx"]), "E0138", moved);
  assert_rejected(on_disk(["vendor", "app"]), "E0138", moved);
  replace_in_file("app/.ply-cache/registry/orders/lib.ply", "n * 4", "n * 2");
  assert_ok(on_disk(["new", "shelf", "--lib"]));
  replace_in_file(
    "shelf/ply.pkg",
    "dependencies: []",
    "dependencies: [{name: \"orders\", prefix: None, min: {major: 0, minor: 1, patch: 0}, source: Registry}]",
  );
  assert_ok(run_with_registry(registry, false, ["resolve", "shelf"]));
  replace_in_file("shelf/.ply-cache/registry/orders/lib.ply", "n * 2", "n * 4");
  assert_rejected(run_with_registry(registry, true, ["publish", "shelf"]), "E0138", moved);
  remove_tree("shelf");

  // A second version, then the first yanked: a lock that pins it keeps it, and a fresh resolution
  // passes it over.
  replace_in_file(
    "orders/ply.pkg",
    "version: { major: 0, minor: 1, patch: 0 }",
    "version: { major: 0, minor: 2, patch: 0 }",
  );
  assert_ok(run_with_registry(registry, true, ["publish", "orders"]));
  assert_ok(run_with_registry(registry, true, ["yank", "orders", "0.1.0"]));
  let versions = at(index("orders"), "versions");
  assert(bool(at(nth(versions, 0), "yanked")), Some(json_text(versions)));
  assert_eq(str(at(nth(versions, 1), "version")), "0.2.0");
  assert_ok(run_with_registry(registry, false, ["resolve", "app"]));
  assert_eq(str(pinned("version")), "0.1.0");
  remove_file("app/ply.lock");
  assert_ok(run_with_registry(registry, false, ["resolve", "app"]));
  let fresh_lock = lock();
  assert_eq(str(at(nth(at(fresh_lock, "packages"), 0), "version")), "0.2.0");

  // The registry now serves other bytes for 0.2.0, sealed and all: what the lock pins decides.
  ["ply.pkg", "lib.ply"].fold((), |u: Unit, file: String|
    match read("orders/" ++ file) {
      Some(text) -> write("evil/" ++ file, text),
      None -> panic("`orders/" ++ file ++ "` reads"),
    });
  replace_in_file("evil/lib.ply", "n * 2", "n * 3");
  assert_ok(spawned(["build", "evil", "-o", "evil.plyz"]));
  copy_file("evil.plyz", "store/orders/0.2.0/package.plyz");
  remove_tree("app/.ply-cache");
  assert_rejected(
    run_with_registry(registry, false, ["resolve", "app"]),
    "E0142",
    "`ply.lock` pins it",
  );
  assert(lock() == fresh_lock, Some("a rejected resolve wrote the lock"));
  assert(!exists("app/.ply-cache/registry/orders"), None);
  // With no lock, the index's own digest is what the archive is held to.
  remove_file("app/ply.lock");
  assert_rejected(run_with_registry(registry, false, ["resolve", "app"]), "E0142", "index lists");
  stop(registry.server)
}

/// The interface at `slot` with `orders.lib.double`'s row claiming what its body never performs.
fn forge_interface(slot: String) -> Unit / {fs.read_file[cwd], fs.write_file[cwd], abort.raise} =
  match fs.read_file[cwd](slot) {
    None -> panic("`" ++ slot ++ "` reads"),
    Some(bytes) -> match envelope_of(bytes) {
      None -> panic("`" ++ slot ++ "` is framed"),
      Some(e) -> match bin::decode(e.payload, interface_bin()) {
        Err(_) -> panic("`" ++ slot ++ "` holds an interface"),
        Ok(p) -> {
          let forged_row = |r: KnownDefinitionRow|
            if r.name == b"orders.lib.double" { { ..r, performed: b"orders.lib.forged" } }
            else { r };
          let forged: Interface = {
            modules: p.modules.map(|m: ModuleInterface|
              {
                ..m,
                exports: {
                  ..m.exports,
                  entries: m.exports.entries.fold(
                    Map::new(),
                    |acc: Map<Bytes, OwnerInterface>, k: Bytes, en: OwnerInterface|
                      acc.insert(k, { ..en, rows: en.rows.map(forged_row) }),
                  ),
                },
              }),
          };
          if !fs.write_file[cwd](
              slot,
              enveloped({ ..e, payload: bin::encode(forged, interface_bin()) }),
            ) { panic("`" ++ slot ++ "` was not written") }
        },
      },
    },
  }

test/nondet "the interface a dependency's publisher sent re-derives from its source" {
  empty_working_directory();
  let registry = start(None);
  assert_ok(on_disk(["new", "orders", "--lib"]));
  let out = run_with_registry(registry, true, ["publish", "orders", "--json"]);
  assert_ok(out);
  let semantics = str(at(json_of(out), "semantics"));
  assert(exists("store/orders/0.1.0/interface/" ++ semantics), Some(all_output(out)));

  an_app();
  let resolved = run_with_registry(registry, false, ["resolve", "app", "--json"]);
  assert_ok(resolved);
  assert(
    bool(at(nth(at(json_of(resolved), "packages"), 0), "interface")),
    Some(all_output(resolved)),
  );
  let slot = "app/.ply-cache/registry/orders/.interface/" ++ semantics;
  assert(exists(slot), None);

  assert_ok(on_disk(["check", "app", "--json"]));
  assert_ok(on_disk(["check", "app", "--verify-dependencies"]));

  forge_interface(slot);
  assert_rejected(
    on_disk(["check", "app", "--verify-dependencies"]),
    "E0149",
    "`orders.lib`'s exports",
  );
  stop(registry.server)
}

fn set_version(from: String, to: String) -> Unit / {WorkingDirectory, abort.raise} =
  replace_in_file("orders/ply.pkg", "version: " ++ from, "version: " ++ to)

test/nondet "a version is bound by the bump its changes need, and `contracts` lists them" {
  empty_working_directory();
  let registry = start(None);
  assert_ok(on_disk(["new", "orders", "--lib"]));
  assert_ok(run_with_registry(registry, true, ["publish", "orders"]));

  // A new definition is a minor's to add, never a patch's.
  replace_in_file(
    "orders/lib.ply",
    "pub fn double(n: Int) -> Int = n * 2\n",
    "pub fn double(n: Int) -> Int = n * 2\n\npub fn triple(n: Int) -> Int = n * 3\n",
  );
  set_version("{ major: 0, minor: 1, patch: 0 }", "{ major: 0, minor: 1, patch: 1 }");
  assert_rejected(
    run_with_registry(registry, true, ["publish", "orders"]),
    "E0150",
    "adds `orders.lib.triple`",
  );
  set_version("{ major: 0, minor: 1, patch: 1 }", "{ major: 0, minor: 2, patch: 0 }");
  assert_ok(run_with_registry(registry, true, ["publish", "orders"]));

  // An `ensures` moves what `double` promises: a major's to make.
  replace_in_file(
    "orders/lib.ply",
    "pub fn double(n: Int) -> Int = n * 2",
    "pub fn double(n: Int) -> Int ensures result == n + n = n * 2",
  );
  set_version("{ major: 0, minor: 2, patch: 0 }", "{ major: 0, minor: 2, patch: 1 }");
  assert_rejected(
    run_with_registry(registry, true, ["publish", "orders"]),
    "E0150",
    "changes what `orders.lib.double` promises",
  );
  set_version("{ major: 0, minor: 2, patch: 1 }", "{ major: 1, minor: 0, patch: 0 }");
  assert_ok(run_with_registry(registry, true, ["publish", "orders"]));

  let listed = run_with_registry(registry, false, [
    "contracts",
    "orders",
    "0.1.0",
    "1.0.0",
    "--json",
  ]);
  assert_ok(listed);
  let j = json_of(listed);
  assert_eq(items(at(j, "changed")).map(str), ["orders.lib.double"]);
  assert_eq(items(at(j, "added")).map(str), ["orders.lib.triple"]);
  assert_eq(str(at(j, "needs")), "major");
  assert(bool(at(j, "kept")), Some(all_output(listed)));
  stop(registry.server)
}

/// Whether the file at `p` appeared before `ms` milliseconds passed.
fn appeared(p: String, ms: Int) -> Bool / {fs.exists[cwd], Clock, abort.raise} = {
  let until = time.elapsed_ms() + ms;
  iterate((), ms / 100 + 1, |_u: Unit|
    if fs.exists[cwd](p) { Stop(true) }
    else if time.elapsed_ms() >= until { Stop(false) } else {
      time.sleep_ms(100);
      Continue(())
    })
}

fn public_hex() -> String / {WorkingDirectory, abort.raise} =
  match read("attester.key.pub") {
    Some(text) -> match text.trim().split_once(" ") {
      Some(parts) -> parts.tail,
      None -> panic("a public key file is one line"),
    },
    None -> panic("`ply keygen` wrote the attester's public key"),
  }

test/nondet "a version is attested by the registry's attester, and a consumer reports what was attested" {
  empty_working_directory();
  assert_ok(on_disk(["keygen", "attester.key"]));
  let here = working_directory();
  let attester = public_hex();
  let binary = repo() ++ "/target/debug/ply";
  let registry = start_with(None, |url: String|
    [
      "--exec",
      "attest=" ++ binary,
      "--set",
      "attester=" ++ attester,
      "--set",
      "attest.key=" ++ here ++ "/attester.key",
      "--set",
      "url=" ++ url,
    ]);
  assert_ok(on_disk(["new", "orders", "--lib"]));
  let out = run_with_registry(registry, true, ["publish", "orders", "--json"]);
  assert_ok(out);
  let semantics = str(at(json_of(out), "semantics"));
  assert(
    appeared("store/orders/0.1.0/attestation/" ++ semantics, 240000),
    Some("the attester kept no attestation of orders 0.1.0"),
  );

  // A second version whose law does not hold is published, and attested as not holding.
  write(
    "orders/lib.ply",
    "pub fn double(n: Int) -> Int = n * 2\n\nlaw \"doubling is tripling\" forall (n: Int) where n > 0 && n < 9 { double(n) == n * 3 }\n",
  );
  replace_in_file(
    "orders/ply.pkg",
    "version: { major: 0, minor: 1, patch: 0 }",
    "version: { major: 0, minor: 2, patch: 0 }",
  );
  assert_ok(run_with_registry(registry, true, ["publish", "orders"]));
  assert(
    appeared("store/orders/0.2.0/attestation/" ++ semantics, 240000),
    Some("the attester kept no attestation of orders 0.2.0"),
  );

  an_app();
  let trusting = [
    { name: "PLY_REGISTRY", value: registry.url },
    { name: "PLY_ATTESTERS", value: here ++ "/attester.key.pub" },
  ];
  let first = on_disk_with(["resolve", "app", "--json"], trusting, None);
  assert_ok(first);
  let a = at(nth(at(json_of(first), "packages"), 0), "attestation");
  assert(bool(at(a, "attested")), Some(all_output(first)));
  assert(int(path(a, ["tests", "passed"])) >= 1, Some(all_output(first)));
  // Without the attester's key named, an attestation is reported and never believed.
  let unnamed = run_with_registry(registry, false, ["resolve", "app", "--json"]);
  assert_ok(unnamed);
  let untrusted = at(nth(at(json_of(unnamed), "packages"), 0), "attestation");
  assert(
    !bool(at(untrusted, "trusted")) && !bool(at(untrusted, "attested")),
    Some(all_output(unnamed)),
  );

  replace_in_file(
    "app/ply.pkg",
    "min: {major: 0, minor: 1, patch: 0}",
    "min: {major: 0, minor: 2, patch: 0}",
  );
  let second = on_disk_with(["resolve", "app", "--json"], trusting, None);
  assert_ok(second);
  let b = at(nth(at(json_of(second), "packages"), 0), "attestation");
  assert(
    !bool(at(b, "attested")) && int(path(b, ["proofs", "refuted"])) >= 1,
    Some(all_output(second)),
  );
  stop(registry.server)
}

// A registry under a certificate no public root signed, a company's own CA, here one issued for the
// test, is reached by naming that certificate in `PLY_TRUST`, and refused by name without it.
test/nondet "a registry under a private certificate is reached through PLY_TRUST" {
  empty_working_directory();
  let issued = certgen.issue();
  write("registry.pem", issued.certificate);
  write("registry.key", issued.key);
  let registry = start(Some({ certificate: "registry.pem", key: "registry.key" }));

  assert_ok(on_disk(["new", "orders", "--lib"]));
  assert_ok(run_with_registry(registry, true, ["publish", "orders"]));
  an_app();
  assert_ok(run_with_registry(registry, false, ["resolve", "app"]));
  assert_eq(str(pinned("version")), "0.1.0");

  // The same registry with nothing naming its certificate: the handshake is what fails.
  let out = spawned(["resolve", "app"], [{ name: "PLY_REGISTRY", value: registry.url }]);
  assert_rejected(out, "E0141", "did not complete a TLS handshake");
  assert(all_output(out).contains("PLY_TRUST"), Some(all_output(out)));

  // A file `PLY_TRUST` names that does not load stops the command before it runs.
  let absent = spawned(["check", "app"], [
    { name: "PLY_TRUST", value: working_directory() ++ "/absent.pem" },
  ]);
  assert(absent.code != 0, Some(all_output(absent)));
  assert(all_output(absent).contains("E0430"), Some(all_output(absent)));
  assert(all_output(absent).contains("absent.pem"), Some(all_output(absent)));
  stop(registry.server)
}

test "a program and a path dependency are not published" {
  scratch(|| {
    empty_working_directory();
    assert_ok(on_disk(["new", "app"]));
    assert_rejected(on_disk(["publish", "app"]), "E0145", "is a program");
    assert_ok(on_disk(["new", "lib", "--lib"]));
    assert_ok(on_disk(["new", "base", "--lib"]));
    replace_in_file(
      "lib/ply.pkg",
      "dependencies: [],",
      "dependencies: [{ name: \"base\", prefix: None, min: { major: 0, minor: 1, patch: 0 }, source: Path(\"../base\") }],",
    );
    assert_rejected(on_disk(["publish", "lib"]), "E0145", "the path `../base`")
  })
}
