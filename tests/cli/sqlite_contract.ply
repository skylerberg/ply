//! How `ply` runs and checks a program over `std.sqlite`'s twin: `ply run` runs it with no host, and
//! `ply check` reports a statement the engine refuses as an error at its place in the program.

import harness (project, spawned, json_of, at, nth, str, codes, diagnostic, value_of, Source)

/// A program that sums a table over the twin, `inserting` what its one write is.
fn summing(inserting: String) -> List<Source> =
  [
    {
      path: "m.ply",
      text:
        \\import std.sql (PInt, Row)
        \\import std.sqlite
        \\import std.sqlite (sql, Create)
        \\
        \\fn main() -> Int / {sql.refused, abort.raise} =
        \\  sqlite::in_memory[app](||
        \\    with_hold[db](sqlite::opening[app]("a.db", Create, { strict: true, busy_ms: 0, statements: 4 }), |c| sqlite::close(c)) { conn -> {
        \\      let limits = { sql_bytes: 1000, params: 10, rows: 10, bytes: 1000, steps: 1000 };
        \\      sqlite::execute(conn, sqlite"create table t (n integer) strict", limits);
        ++ "\n      sqlite::execute(conn, "
        ++ inserting
        ++ ", limits);\n"
        ++
        \\      sqlite::query(conn, sqlite"select n from t", limits).fold(0, |acc: Int, row: Row|
        \\        acc + sqlite::int(row, "n"))
        \\    } })
        \\
        ,
    },
  ]

test/nondet "a program runs over the twin with no host, and a refused statement is a check error in its text" {
  project(summing("sqlite\"insert into t values ({PInt(41)}), ({PInt(1)})\""));
  assert_eq(value_of(spawned(["run", "--json"])), "42");
  project(summing("sqlite\"insert into t values ({PInt(41)}), (random())\""));
  let v = json_of(spawned(["check", "--json"]));
  assert_eq(codes(v), ["E0153"]);
  let label = nth(at(diagnostic(v), "labels"), 0);
  assert(str(at(label, "message")).contains("`random` is not a function of the program's state"));
  assert_eq(str(at(label, "snippet")), "r")
}
