import spawning.harness (write_project, spawned, json_of, at, nth, str, diagnostic_codes,
                         diagnostic, value_of, Source)

fn summing(inserting: String) -> List<Source> =
  [
    {
      path: "m.ply",
      text:
        \\import std.sql (IntParameter, Row)
        \\import std.sqlite
        \\import std.sqlite (sql, Create)
        \\
        \\fn main() -> Int / {sql.fail, abort.raise} =
        \\  sqlite::in_memory[app](||
        \\    with_scope[db](sqlite::opening[app]("a.db", Create, { strict: true, busy_ms: 0, statements: 4 }), |c| sqlite::close(c)) { conn -> {
        \\      let limits = { sql_bytes: 1000, params: 10, rows: 10, bytes: 1000, steps: 1000 };
        \\      sqlite::execute(conn, sqlite"create table t (n integer) strict", limits);
        ++ "\n      sqlite::execute(conn, "
        ++ inserting
        ++ ", limits);\n"
        ++
        \\      sqlite::query(conn, sqlite"select n from t", limits).fold(0, |acc: Int, row: Row|
        \\        acc + sqlite::int(row, "n"))
        \\    } })
        \\
        ,
    },
  ]

test/nondet "a program runs against the fake SQLite with no host database, and a statement calling `random()` fails the check" {
  write_project(
    summing("sqlite\"insert into t values ({IntParameter(41)}), ({IntParameter(1)})\""),
  );
  assert_eq(value_of(spawned(["run", ".", "--json"])), "42");
  write_project(summing("sqlite\"insert into t values ({IntParameter(41)}), (random())\""));
  let v = json_of(spawned(["check", ".", "--json"]));
  assert_eq(diagnostic_codes(v), ["E0153"]);
  let label = nth(at(diagnostic(v), "labels"), 0);
  assert(
    str(at(label, "message")).contains("`random` returns a different value each time it runs"),
  );
  assert_eq(str(at(label, "snippet")), "r")
}
