//! What an effect set's spelling may not decide: renaming one, reordering or repeating its members,
//! declaring one nothing uses, or writing out its expansion moves no test's key; widening one moves
//! exactly the keys of the tests that reach it.

import harness (WorkingDirectory, PlyProcess, spawned, scratch, write_program, write, warm_agrees,
                json_of, path, int, succeeded)
import std.string

/// `store` is handled in both tests, so both are cacheable and each is cached under its own key.
fn source(web: String) -> String =
  \\effect store {
  \\  read  all[r]() -> List<Int>
  \\  write save[r](rows: List<Int>) -> Unit
  \\}
  \\
    ++ "\n"
    ++ web
    ++ "\n\n"
    ++
    \\fn list_orders() -> Int / {Web} = store.all[orders]().len()
    \\
    \\fn health() -> Int = 200
    \\
    \\test "orders are listed" {
    \\  handle { assert_eq(list_orders(), 0) } with { store.all[orders]() -> [] }
    \\}
    \\
    \\test "health is 200" {
    \\  assert_eq(health(), 200)
    \\}
    \\

fn narrow() -> String = "effect set Web = {store.read[orders], store.write[audit]}"

/// How many tests a run after `before` is edited into `after` finds no pass for under their own key:
/// the ones it runs, and the ones it reuses by the code they compile to, which a key change leaves.
fn changed_key_count(
  before: String,
  after: String,
) -> Int / {PlyProcess, WorkingDirectory, abort.raise} = {
  write_program(before);
  let _ = succeeded(spawned(["test"]));
  write("m.ply", after);
  let report = json_of(succeeded(spawned(["test", "--json"])));
  int(path(report, ["selection", "selected"])) + int(path(report, ["selection", "same_code"]))
}

test/nondet "renaming a set moves no test's key" {
  // The effects have to be renamed with it, so the edit is the rename and nothing else.
  let renamed = source("effect set Surface = {store.read[orders], store.write[audit]}").replace(
    "/ {Web}",
    "/ {Surface}",
  );
  assert(
    changed_key_count(source(narrow()), renamed) == 0,
    Some("a set's name is namespace metadata"),
  )
}

test/nondet "reordering a set's members moves no test's key" {
  assert_eq(
    changed_key_count(
      source(narrow()),
      source("effect set Web = {store.write[audit], store.read[orders]}"),
    ),
    0,
  )
}

test/nondet "writing a member twice moves no test's key" {
  assert_eq(
    changed_key_count(
      source(narrow()),
      source("effect set Web = {store.read[orders], store.write[audit], store.read[orders]}"),
    ),
    0,
  )
}

test/nondet "declaring a set nothing uses moves no test's key" {
  assert_eq(
    changed_key_count(
      source(narrow()),
      source(narrow() ++ "\neffect set Unused = {store.read[inventory]}"),
    ),
    0,
  )
}

test/nondet "replacing a set with its expansion moves no test's key" {
  // Written in the other order too: the annotation's spelling may not decide what effects mean.
  let expanded = source("").replace("/ {Web}", "/ {store.write[audit], store.read[orders]}");
  assert(changed_key_count(source(narrow()), expanded) == 0, Some("the alias was an abbreviation"))
}

test/nondet "widening a set moves exactly the keys of the tests that reach it" {
  assert_eq(
    changed_key_count(
      source(narrow()),
      source("effect set Web = {store.read[orders], store.write[audit], store.read[inventory]}"),
    ),
    1,
  )
}

// A cold cache never exercises an invalidation, and an invalidation is the only thing that can be
// wrong.
test "a warm check agrees with a cold one across a sequence of set edits" {
  scratch(|| {
    write_program(source(narrow()));
    let steps = [
      narrow(),
      "effect set Web = {store.write[audit], store.read[orders]}",
      "effect set Inner = {store.read[orders]}\neffect set Web = {Inner, store.write[audit]}",
      "effect set Inner = {store.read[orders], store.read[inventory]}\neffect set Web = {Inner, store.write[audit]}",
      narrow() ++ "\neffect set Unused = {store.read[nothing]}",
    ];
    range(0, steps.len()).fold((), |u: Unit, i: Int| {
      write("m.ply", source(match steps.at(i) { Some(w) -> w, None -> "" }));
      let _ = warm_agrees("step " ++ i.to_string());
      u
    })
  })
}
