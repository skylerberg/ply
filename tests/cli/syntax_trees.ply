//! `compiler.syntax` over the repository's own sources: each maintained module formats to itself,
//! as `ply fmt` leaves it, and a walk of its tree meets every name, binding and type the compiler's
//! own listing of the tree holds, and no other.

import harness (compiler_tree, std_tree)
import compiler.syntax
import compiler.syntax (Binding, Name, Node, TypeName, TypeVariable)
import compiler.syntax.items
import compiler.syntax.items (Item)
import compiler.syntax.lexer
import std.bytes
import std.list

type File = { name: String, bytes: Bytes }

/// One maintained source: the path it is committed at, and its text.
type Case = { path: String, text: Bytes }

fn ply_cases_under(dir: String, files: List<File>) -> List<Case> =
  files.fold([], |cases: List<Case>, f: File|
    if f.name.ends_with(".ply") { cases.push({ path: dir ++ "/" ++ f.name, text: f.bytes }) }
    else { cases })

fn sources() -> List<Case> =
  [
    ply_cases_under("packages/std", std_tree()),
    ply_cases_under("packages/compiler", compiler_tree()),
    ply_cases_under("packages/cli", embed_dir("../../packages/cli")),
    ply_cases_under("packages/proof", embed_dir("../../packages/proof")),
    ply_cases_under("packages/store", embed_dir("../../packages/store")),
    ply_cases_under("packages/testing", embed_dir("../../packages/testing")),
    ply_cases_under("packages/sim", embed_dir("../../packages/sim")),
    ply_cases_under("packages/registry", embed_dir("../../packages/registry")),
    ply_cases_under("tests/cli", embed_dir("../cli")),
    ply_cases_under("tests/lang", embed_dir("../lang")),
  ].flatten(
  )

test "{c.path} formats to itself, as `ply fmt` leaves it" for c: Case in sources() {
  assert(
    syntax::format(c.text) == Ok(c.text),
    Some(
      c.path ++ " is committed as `ply fmt` writes it, and `compiler.syntax` formats it otherwise",
    ),
  )
}

/// The places a tree's names stand at, each as `start:end`, sorted, by what the name is.
type NameSpans = {
  names: List<Bytes>,
  bindings: List<Bytes>,
  types: List<Bytes>,
  variables: List<Bytes>,
}

fn span_key(start: Int, end: Int) -> Bytes =
  Bytes::concat_all([Bytes::of_string(start.to_string()), b":", Bytes::of_string(end.to_string())])

fn unique_keys(keys: List<Bytes>) -> List<Bytes> =
  keys.fold(Map::new(), |held: Map<Bytes, Bool>, key: Bytes| held.insert(key, true)).keys()

fn deduplicated(places: NameSpans) -> NameSpans =
  {
    names: unique_keys(places.names),
    bindings: unique_keys(places.bindings),
    types: unique_keys(places.types),
    variables: unique_keys(places.variables),
  }

/// Where a walk of `tree` meets a name of each kind.
fn walk_spans(tree: Node) -> NameSpans / {abort.raise} =
  deduplicated(
    syntax::walk(tree).fold(
      { names: [], bindings: [], types: [], variables: [] },
      |found: NameSpans, node: Node|
        match syntax::name(node) {
          None -> found,
          Some(ident) -> {
            let key = span_key(ident.span.start, ident.span.end);
            match syntax::kind(node) {
              Name -> { ..found, names: found.names.push(key) },
              Binding -> { ..found, bindings: found.bindings.push(key) },
              TypeName -> { ..found, types: found.types.push(key) },
              TypeVariable -> { ..found, variables: found.variables.push(key) },
              _ -> found,
            }
          },
        },
    ),
  )

/// A unit of the compiler's dump of a tree that is a node: its span as `start:end`, and its tag.
fn node_of(unit: Bytes) -> Option<{ key: Bytes, tag: Bytes }> =
  match unit.split(b":") {
    [start, end, tag] -> Some({ key: Bytes::concat_all([start, b":", end]), tag: tag }),
    _ -> None,
  }

/// Whether the name a dump holds at `key`, as the payload `held`, is the text the source has there:
/// a name the parser wrote for itself stands at a span that reads otherwise.
fn dump_matches_source(source: Bytes, key: Bytes, held: Bytes) -> Bool / {abort.raise} =
  match key.split(b":") {
    [start, end] -> match ((start.int_of_ascii_radix(10), end.int_of_ascii_radix(10))) {
      (Some(from), Some(to)) ->
        from <= to && to <= source.len()
          && b"@".concat(Bytes::of_string(source.slice(from, to).hex_of())) == held,
      _ -> false,
    },
    _ -> false,
  }

/// The key of the identifier a qualified name's dump holds as its own, the dump's units from
/// `at` on being the name's: its node, whether it is qualified, the qualifier where it is, then the
/// identifier and its text.
fn named_at(units: List<Bytes>, at: Int) -> { key: Bytes, held: Bytes } = {
  let own = if units.at_or(at + 1, b"") == b"?1" { at + 4 } else { at + 2 };
  {
    key: match node_of(units.at_or(own, b"")) { Some(n) -> n.key, None -> b"" },
    held: units.at_or(own + 1, b""),
  }
}

/// Where the compiler's dump of `source`'s tree holds a name of each kind that the source writes.
/// A perform written on a name its item binds is a call on that value, which is a name there.
fn dump_spans(source: Bytes) -> NameSpans / {abort.raise} = {
  let read = items::parse(source).node;
  let units = items::dump_module(read).split(b";");
  let binding = read.items.map(|item: Item| {
    let s = items::item_span(item);
    {
      start: s.start,
      end: s.end,
      names: lexer::bound_names(lexer::lex(source.slice(s.start, s.end)).tokens),
    }
  });
  let bound = |key: Bytes|
    match key.split(b":") {
      [start, end] -> match ((start.int_of_ascii_radix(10), end.int_of_ascii_radix(10))) {
        (Some(from), Some(to)) ->
          binding.any(|b: { start: Int, end: Int, names: Map<Bytes, Bool> }|
            from >= b.start && to <= b.end && b.names.contains(source.slice(from, to))),
        _ -> false,
      },
      _ -> false,
    };
  deduplicated(
    range(0, units.len()).fold(
      { names: [], bindings: [], types: [], variables: [] },
      |found: NameSpans, i: Int|
        match node_of(units.at_or(i, b"")) {
          None -> if units.at_or(i, b"") != b"%idn" { found } else {
            // A law's or a schema's `where identity(a)`: a count, then each `a` and its text.
            let counted = units.at_or(i + 1, b"");
            let count = match counted.slice(1, counted.len()).int_of_ascii_radix(10) {
              Some(n) -> n,
              None -> 0,
            };
            range(0, count).fold(found, |acc: NameSpans, j: Int|
              match node_of(units.at_or(i + 2 + 2 * j, b"")) {
                Some(variable) -> { ..acc, variables: acc.variables.push(variable.key) },
                None -> acc,
              })
          },
          Some(node) -> if node.tag == b"evar" {
            let named = named_at(units, i + 1);
            if dump_matches_source(source, named.key, named.held) {
              { ..found, names: found.names.push(named.key) }
            } else { found }
          } else if node.tag == b"eprf" && units.at_or(i + 2, b"") != b"?1" {
            let named = named_at(units, i + 1);
            if bound(named.key) { { ..found, names: found.names.push(named.key) } } else { found }
          } else if node.tag == b"pvar" {
            match node_of(units.at_or(i + 1, b"")) {
              Some(ident) -> { ..found, bindings: found.bindings.push(ident.key) },
              None -> found,
            }
          } else if node.tag == b"tcon" {
            { ..found, types: found.types.push(named_at(units, i + 1).key) }
          } else if node.tag == b"tvar" { { ..found, variables: found.variables.push(node.key) } }
          else { found },
        },
    ),
  )
}

fn missing(wanted: List<Bytes>, among: List<Bytes>) -> List<Bytes> = {
  let held = among.fold(Map::new(), |acc: Map<Bytes, Bool>, key: Bytes| acc.insert(key, true));
  wanted.filter(|key: Bytes| !held.contains(key))
}

fn differing(what: String, listed_at: List<Bytes>, walked_at: List<Bytes>) -> List<String> =
  missing(listed_at, walked_at).map(|key: Bytes|
    what ++ " at " ++ String::of_bytes_lossy(key) ++ " is in the tree and not walked").concat(
    missing(walked_at, listed_at).map(|key: Bytes|
      what ++ " at " ++ String::of_bytes_lossy(key) ++ " is walked and not in the tree"),
  )

test "a walk of {c.path} meets every name, binding and type its tree holds" for c: Case in sources(
  ) {
  let read = syntax::parse(c.text);
  assert_eq(read.diagnostics, []);
  let tree = dump_spans(c.text);
  let walk = walk_spans(read.tree);
  assert_eq(
    [
      differing("a name", tree.names, walk.names),
      differing("a binding", tree.bindings, walk.bindings),
      differing("a type", tree.types, walk.types),
      differing("a type variable", tree.variables, walk.variables),
    ].flatten(
    ),
    [],
  )
}

test "the listing the walks are held to reads a name, a binding, a type and a variable where each is written" {
  let source = b"fn first<a>(xs: List<a>, spare: a) -> a = match xs { [x, ..] -> x, _ -> f\"{spare}\" }\n";
  let tree = dump_spans(source);
  assert_eq(tree.names, [b"48:50", b"64:65", b"75:80"]);
  assert_eq(tree.bindings, [b"54:55"]);
  assert_eq(tree.types, [b"16:20"]);
  assert_eq(tree.variables, [b"21:22", b"32:33", b"38:39"]);
  assert_eq(walk_spans(syntax::parse(source).tree), tree);
  let law = b"law \"l\" forall (x: a) where identity(a) { x == x }\n";
  assert_eq(dump_spans(law).variables, [b"19:20", b"37:38"]);
  assert_eq(walk_spans(syntax::parse(law).tree), dump_spans(law))
}
