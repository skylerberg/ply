import harness (spawned, spawned_reading)
import support.harness (write, write_program, write_project, stdout, stderr, all_output, json_of,
                        at, items, path, str, bool, json_text, code_of, manifest, value_of)
import std.json (Json)
import std.string

fn green() -> String = String::of_bytes_lossy(embed("../programs/commands/green.ply"))

type Wired = { accepted: List<String>, rejected: List<String> }

fn wired() -> List<Wired> =
  [
    { accepted: ["--help"], rejected: ["frobnicate"] },
    { accepted: ["check", "."], rejected: ["check", "nowhere"] },
    { accepted: ["hash", "."], rejected: ["hash", "nowhere"] },
    { accepted: ["definitions", "."], rejected: ["definitions", "nowhere"] },
    { accepted: ["hosts", "."], rejected: ["hosts", "nowhere"] },
    { accepted: ["callers", "double", "."], rejected: ["callers", "nothing", "."] },
    { accepted: ["show", "double", "."], rejected: ["show", "nothing", "."] },
    { accepted: ["doc", "double", "."], rejected: ["doc", "nothing", "."] },
    { accepted: ["unused", "."], rejected: ["unused", "nowhere"] },
    { accepted: ["fmt", "."], rejected: ["fmt", "nowhere"] },
    { accepted: ["explain", "E0001"], rejected: ["explain", "E9999"] },
    { accepted: ["std", "--digest"], rejected: ["std", "--show", "nothing"] },
    { accepted: ["new", "fresh"], rejected: ["new", "Bad"] },
    { accepted: ["resolve", "."], rejected: ["resolve", "nowhere"] },
    { accepted: ["vendor", "."], rejected: ["vendor", "nowhere"] },
    { accepted: ["cache", "stats", "."], rejected: ["cache", "inspect", "nothing", "."] },
    {
      accepted: ["replace", "double", ".", "--with", "double.txt"],
      rejected: ["replace", "double", ".", "--with", "absent.txt"],
    },
    {
      accepted: ["rename", "--map", "map.txt", "."],
      rejected: ["rename", "--map", "absent.txt", "."],
    },
  ]

test/nondet "every command exits zero on what it accepts, and two on what it rejects" {
  write_program(green());
  write("map.txt", "double twice\n");
  write("double.txt", "fn double(x: Int) -> Int = x * 2\n");
  wired().fold((), |u: Unit, w: Wired| {
    let accepted = spawned(w.accepted);
    assert(
      accepted.code == 0,
      Some(String::join(w.accepted, " ") ++ ":\n" ++ all_output(accepted)),
    );
    let rejected = spawned(w.rejected);
    assert(rejected.code == 2, Some(String::join(w.rejected, " ") ++ ":\n" ++ all_output(rejected)))
  })
}

test/nondet "run evaluates main and writes nothing of its own, and --json reports the value" {
  write_program(green());
  let r = spawned(["run", "."]);
  assert(r.code == 0, Some(all_output(r)));
  assert(r.out == [] && !all_output(r).contains("42"), Some(all_output(r)));
  let v = json_of(spawned(["run", ".", "--json"]));
  assert(str(at(v, "command")) == "run", Some(json_text(v)));
  assert(bool(at(v, "ok")), Some(json_text(v)));
  assert(str(at(v, "value")) == "42", Some(json_text(v)))
}

test/nondet "`run` exits with code 1 and prints the message when main panics" {
  write_program("fn main() -> Unit / {abort.raise} = panic(\"nope\")\n");
  let r = spawned(["run", "."]);
  assert(r.code == 1, Some(all_output(r)));
  assert(stderr(r).contains("nope"), Some(stderr(r)))
}

fn spins() -> String =
  "fn spin(n: Int) -> Int / {diverges} = spin(n + 1)\nfn main() -> Int / {diverges} = spin(0)\n"

test/nondet "`run --timeout` stops a program that never finishes after the given milliseconds and reports W0612" {
  write_program(spins());
  let r = spawned(["run", ".", "--json", "--timeout", "300"]);
  let v = json_of(r);
  assert(r.code == 1, Some(json_text(v)));
  assert(code_of(v) == "W0612", Some(json_text(v)))
}

test/nondet "a task that fails is reported rather than aborting the process" {
  write_program(String::of_bytes_lossy(embed("../programs/commands/failing_task.ply")));
  let r = spawned(["run", "."], []);
  assert(r.code == 1, Some(all_output(r)));
  assert(stderr(r).contains("E0424"), Some(stderr(r)));
  assert(!stderr(r).contains("panicked"), Some(stderr(r)))
}

test/nondet "a task reaching a clause that would take its spawner's body is rejected with a diagnostic" {
  write_program(
    \\effect ask {
    \\  read q() -> Int
    \\}
    \\
    \\fn work() -> Int / {ask.read} = ask.q()
    \\
    \\test "a clause that resumes off its tail" {
    \\  let r = simulate {
    \\    handle {
    \\      let t = task.spawn(|| work());
    \\      task.join(t)
    \\    } with {
    \\      ask.q() resume k -> 1 + k(2),
    \\    }
    \\  };
    \\  assert_eq(r, 3)
    \\}
    \\
    \\test "a clause that does not resume" {
    \\  let r = simulate {
    \\    handle {
    \\      let t = task.spawn(|| work() + 1);
    \\      task.join(t)
    \\    } with {
    \\      ask.q() resume k -> 7,
    \\    }
    \\  };
    \\  assert_eq(r, 7)
    \\}
    \\
  );
  let r = spawned(["test", ".", "--no-cache", "--json"], []);
  assert(r.code != 0, Some(all_output(r)));
  assert(!all_output(r).contains("panicked"), Some(all_output(r)));
  let failed = items(at(json_of(r), "failures"));
  assert_eq(failed.map(|f: Json| str(path(f, ["diagnostic", "code"]))), ["E0502", "E0502"]);
  let messages = json_text(at(json_of(r), "failures"));
  assert(messages.contains("resumes off the tail"), Some(messages));
  assert(messages.contains("its handler did not resume it"), Some(messages))
}

test/nondet "a definition replaced in a packaged project runs" {
  write_project([
    {
      path: "app/ply.pkg",
      text: manifest(
        "app",
        "{name: \"lib\", prefix: None, min: {major: 0, minor: 0, patch: 1}, source: Path(\"../lib\")}",
      ),
    },
    {
      path: "app/main.ply",
      text: "import lib.answer\n\nfn base() -> Int = 1\n\npub fn twice() -> Int = base() + base()\n\nfn main() -> Int = twice() + answer::answer()\n",
    },
    { path: "lib/ply.pkg", text: manifest("lib", "") },
    { path: "lib/answer.ply", text: "import extra\npub fn answer() -> Int = extra::hidden()\n" },
    { path: "lib/extra.ply", text: "pub fn hidden() -> Int = 7\n" },
  ]);
  let r = spawned_reading(["replace", "twice", "app"], [], "pub fn twice() -> Int = base() * 2\n");
  assert(r.code == 0, Some(all_output(r)));
  assert_eq(value_of(spawned(["run", "--json", "app"])), "9")
}
