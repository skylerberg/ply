//! The host boundary as a test run meets it: what a `simulate` region answers itself and what it
//! refuses, what a handler in scope keeps from the host, and an answer the host gives later, waited
//! for outside a region and by a task of the run's region while the others run.

import harness (at, failure_codes, json_of, on_disk, program, read, said, shown, str)

/// A test that reads a file inside a `simulate` region.
fn reads_in_a_region() -> String =
  \\import std.fs (fs)
  \\
  \\test/nondet "reads inside a region" {
  \\  simulate {
  \\    let read = fs.read_file[cwd]("m.ply");
  \\    assert(read != None)
  \\  }
  \\}
  \\

// A search re-runs a region whole for every schedule it explores, so whatever the host answered
// would differ between interleavings: E0425 is terminal.
test/nondet "a host operation inside a simulate region is refused" {
  program(reads_in_a_region());
  let ran = json_of(on_disk(["test", "--fs", "cwd=.", "--no-cache", "--json"]));
  assert(failure_codes(ran) == ["E0425"], Some(shown(ran)))
}

// A real handler answers from the machine through natives, which refuse inside a region as a host
// operation does.
test/nondet "a fact of the machine asked inside a simulate region is refused" {
  program(
    "import std.os (os)\n\ntest/nondet \"asks inside a region\" {\n  simulate {\n    assert(os.cpus() >= 1)\n  }\n}\n",
  );
  let ran = json_of(on_disk(["test", "--no-cache", "--json"]));
  assert(failure_codes(ran) == ["E0425"], Some(shown(ran)))
}

// What a region schedules itself never reaches the boundary, so the binding's scheduler is shadowed.
test/nondet "a region answers the task operations it schedules" {
  program(
    "test/nondet \"spawns inside a region\" {\n  let n = simulate {\n    let t = task.spawn(|| 20 + 1);\n    task.join(t)\n  };\n  assert_eq(n, 21)\n}\n",
  );
  let ran = on_disk(["test", "--no-cache"]);
  assert(ran.code == 0, Some(said(ran)))
}

// A clause around the operation answers it, so the run reaches no handler and needs no root.
test/nondet "a handler in scope shadows the host" {
  program(
    "import std.fs (fs)\n\ntest/nondet \"the double answers\" {\n  let read = handle { fs.read_file[cwd](\"absent\") } with {\n    fs.read_file[cwd](p) -> Some(b\"double\"),\n  };\n  assert_eq(read, Some(b\"double\"))\n}\n",
  );
  let ran = on_disk(["test", "--no-cache"]);
  assert(ran.code == 0, Some(said(ran)))
}

/// Starts a shell that exits 7, a child the host waits on: an answer that comes later.
fn waits_on_a_child(inside: String) -> String =
  "import std.process (process, exit_code)\n\nfn child() -> Int / {process.spawn[sh]} =\n  match exit_code(process.spawn[sh]([\"-c\", \"exit 7\"], \"\", [])) { Some(c) -> c, None -> 0 }\n\ntest/nondet \"waits\" {\n"
    ++ inside
    ++ "\n}\n"

// Outside any region nothing else could run meanwhile, so the run blocks on the answer.
test/nondet "an answer the host gives later is waited for outside a region" {
  program(waits_on_a_child("  assert_eq(child(), 7)"));
  let ran = on_disk(["test", "--exec", "sh=/bin/sh", "--no-cache"]);
  assert(ran.code == 0, Some(said(ran)))
}

// A test that performs `task` runs under the run's region, where a task waiting on the host waits
// and the others run; each join answers its own task.
test/nondet "tasks waiting on the host park in a production region and each join answers its own" {
  program(
    waits_on_a_child(
      "  let ts = range(0, 4).map(|i: Int| task.spawn(|| child() + i));\n  assert_eq(ts.map(|t: Task<Int>| task.join(t)), [7, 8, 9, 10])",
    ),
  );
  let ran = on_disk(["test", "--exec", "sh=/bin/sh", "--no-cache"]);
  assert(ran.code == 0, Some(said(ran)))
}

/// A program whose `main` answers which of two racing tasks a `simulate` region heard first, the
/// region opened as `opened` writes it around `raced()`.
fn racing(opened: String) -> String =
  "fn raced() -> Int / {sim.read, abort.raise} = simulate {\n  let c = task.channel(2);\n  let a = task.spawn(|| task.send(c, 1));\n  let b = task.spawn(|| task.send(c, 2));\n  task.join(a);\n  task.join(b);\n  match ((task.recv(c), task.recv(c))) { (Some(x), Some(y)) -> x * 10 + y, _ -> 0 }\n}\n\nfn main() -> Int / {task.write, sim.read, abort.raise} = "
    ++ opened
    ++ "\n"

// A region inside a task of the run's region runs as one outside it does: the entry's seed takes
// the same schedule.
test/nondet "a simulate inside a task of the run's region runs and takes its schedule from the seed" {
  let answered = |opened: String| {
    program(racing(opened));
    let r = on_disk(["run", "--json", "--seed", "5"]);
    assert(r.code == 0, Some(said(r)));
    str(at(json_of(r), "value"))
  };
  let outside = answered("raced()");
  assert(outside == "12" || outside == "21", Some(outside));
  assert_eq(answered("task.join(task.spawn(|| raced()))"), outside)
}

/// `ply test` over the working directory's program, its child processes started by `sh` and its
/// files below the working directory.
fn hosted() -> List<String> = ["test", "--exec", "sh=/bin/sh", "--fs", "cwd=.", "--no-cache"]

// Tasks retire as they finish unheld, and a retired id is never reused, so no join lands on
// another task's answer; a kept handle answers every join; and a handle inside a finished task's
// answer keeps its task joinable.
test/nondet "every join in a production region answers its own task" {
  program(
    "fn churn(n: Int) -> Int / {task.write, abort.raise} =\n  range(0, n).fold(0, |sum: Int, i: Int| {\n    task.spawn(|| i);\n    let t = task.spawn(|| i * 2);\n    task.yield();\n    sum + task.join(t)\n  })\n\nfn kept(n: Int) -> Int / {task.write, abort.raise} = {\n  let held = range(0, n).fold([], |tasks: List<Task<Int>>, i: Int| tasks.push(task.spawn(|| i)));\n  task.yield();\n  held.fold(0, |sum: Int, t: Task<Int>| sum + task.join(t) + task.join(t))\n}\n\nfn relayed() -> Int / {task.write, abort.raise} = {\n  let outer = task.spawn(|| task.spawn(|| 21));\n  task.yield();\n  task.yield();\n  let inner = task.join(outer);\n  task.yield();\n  task.join(inner) * 2\n}\n\ntest/nondet \"churn\" { assert_eq(churn(300), 89700) }\ntest/nondet \"kept\" { assert_eq(kept(40), 1560) }\ntest/nondet \"relayed\" { assert_eq(relayed(), 42) }\n",
  );
  let ran = on_disk(hosted());
  assert(ran.code == 0 && said(ran).contains("3 passed"), Some(said(ran)))
}

// The region runs a spawned task first, so the task yields to the spawner, which reads the clock
// once its `handle` has ended and joins; the task then reads the clock later, and still answers
// from the clause around its spawn.
test/nondet "a production task answers from the handle around its spawn after that handle ended" {
  program(
    \\effect ask {
    \\  read get() -> Int
    \\}
    \\
    \\fn now() -> Int / {clock.read} = match clock.now() { Instant(at) -> at }
    \\
    \\test/nondet "the task reads the handle around its spawn after it ended" {
    \\  let t = handle {
    \\    task.spawn(|| {
    \\      task.yield();
    \\      (now(), ask.get())
    \\    })
    \\  } with { ask.get() -> 7 };
    \\  let ended = now();
    \\  let answered = task.join(t);
    \\  assert(ended <= answered._0, None);
    \\  assert_eq(answered._1, 7)
    \\}
    \\
  );
  let ran = on_disk(hosted());
  assert(ran.code == 0, Some(said(ran)))
}

// Each task opens its region, then waits on a child the host answers later and parks; each still
// reads its own hold once it wakes, whichever region closed first.
test/nondet "tasks parked on the host keep their holds when the other's region closes first" {
  program(
    "import std.process (process, exit_code)\n\nfn child(code: Int) -> Int / {process.spawn[sh]} =\n  match exit_code(process.spawn[sh]([\"-c\", \"exit \" ++ code.to_string()], \"\", [])) { Some(c) -> c, None -> 0 }\n\ntest/nondet \"each task reads its hold after the other's region closed\" {\n  let first = task.spawn(|| with_hold[a](10, |x: Int| ()) { c -> {\n    let got = child(5);\n    c.get() + got\n  } });\n  let second = task.spawn(|| with_hold[b](20, |x: Int| ()) { c -> {\n    let got = child(5);\n    c.get() + got\n  } });\n  assert_eq(task.join(first) + task.join(second), 40)\n}\n",
  );
  let ran = on_disk(hosted());
  assert(ran.code == 0, Some(said(ran)))
}

// A region ends before the operation beside it, which the run performs once, outside any schedule.
// A test that simulates is re-run by the search, so this is a run's.
test/nondet "a host operation beside a simulate region is performed once" {
  program(
    "import std.fs (fs)\n\nfn main() -> Int / {fs.write[cwd], sim.read, abort.raise} = {\n  let inside = simulate {\n    let a = task.spawn(|| 1);\n    let b = task.spawn(|| 2);\n    task.join(a) + task.join(b)\n  };\n  match fs.append[cwd](\"sent\", Bytes::of_string(inside.to_string() ++ \"\\n\")) { Some(at) -> at, None -> 1 }\n}\n",
  );
  let ran = on_disk(["run", "--fs", "cwd=."]);
  assert(ran.code == 0, Some(said(ran)));
  assert_eq(read("sent"), Some("3\n"))
}
