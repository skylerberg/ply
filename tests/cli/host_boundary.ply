//! The host boundary as a test run meets it: what a simulation handles itself and what it
//! rejects, what a handler in scope keeps from the host, and a reply the host gives later, waited
//! for outside a scheduler and by a task of the run's scheduler while the others run.

import harness (spawned, at, failure_codes, json_of, write_program, read, all_output, json_text,
                str)

/// A test that reads a file inside a simulation.
fn reads_in_a_scope() -> String =
  \\import std.fs (fs)
  \\
  \\test/nondet "reads inside a simulation" {
  \\  simulate {
  \\    let read = fs.read_file[cwd]("m.ply");
  \\    assert(read != None)
  \\  }
  \\}
  \\

// A search re-runs a simulation whole for every schedule it explores, so whatever the host returned
// would differ between interleavings: E0425 is terminal.
test/nondet "a host operation inside a simulation is rejected" {
  write_program(reads_in_a_scope());
  let ran = json_of(spawned(["test", "--fs", "cwd=.", "--no-cache", "--json"]));
  assert(failure_codes(ran) == ["E0425"], Some(json_text(ran)))
}

// A host handler replies from the machine through natives, which fail inside a simulation as a host
// operation does.
test/nondet "a fact of the machine asked inside a simulation is rejected" {
  write_program(
    "import std.os (os)\n\ntest/nondet \"asks inside a region\" {\n  simulate {\n    assert(os.cpus() >= 1)\n  }\n}\n",
  );
  let ran = json_of(spawned(["test", "--no-cache", "--json"]));
  assert(failure_codes(ran) == ["E0425"], Some(json_text(ran)))
}

// What a simulation schedules itself never reaches the boundary, so the binding's scheduler is
// shadowed.
test/nondet "a scheduler handles the task operations it schedules" {
  write_program(
    "test/nondet \"spawns inside a region\" {\n  let n = simulate {\n    let t = task.spawn(|| 20 + 1);\n    task.join(t)\n  };\n  assert_eq(n, 21)\n}\n",
  );
  let ran = spawned(["test", "--no-cache"]);
  assert(ran.code == 0, Some(all_output(ran)))
}

// A clause around the operation handles it, so the run reaches no handler and needs no root.
test/nondet "a handler in scope shadows the host" {
  write_program(
    "import std.fs (fs)\n\ntest/nondet \"the double answers\" {\n  let read = handle { fs.read_file[cwd](\"absent\") } with {\n    fs.read_file[cwd](p) -> Some(b\"double\"),\n  };\n  assert_eq(read, Some(b\"double\"))\n}\n",
  );
  let ran = spawned(["test", "--no-cache"]);
  assert(ran.code == 0, Some(all_output(ran)))
}

/// Starts a shell that exits 7, a child the host waits on: a response that comes later.
fn waits_on_a_child(inside: String) -> String =
  "import std.process (process, exit_code)\n\nfn child() -> Int / {process.spawn[sh]} =\n  match exit_code(process.spawn[sh]([\"-c\", \"exit 7\"], \"\", [])) { Some(c) -> c, None -> 0 }\n\ntest/nondet \"waits\" {\n"
    ++ inside
    ++ "\n}\n"

// Outside any scheduler nothing else could run meanwhile, so the run blocks on the response.
test/nondet "a response the host gives later is waited for outside a scheduler" {
  write_program(waits_on_a_child("  assert_eq(child(), 7)"));
  let ran = spawned(["test", "--exec", "sh=/bin/sh", "--no-cache"]);
  assert(ran.code == 0, Some(all_output(ran)))
}

// A test performing `task` runs under the run's scheduler, where a task waiting on the host waits
// and the others run; each join returns its own task's result.
test/nondet "tasks waiting on the host park in a production scheduler and each join returns its own" {
  write_program(
    waits_on_a_child(
      "  let ts = range(0, 4).map(|i: Int| task.spawn(|| child() + i));\n  assert_eq(ts.map(|t: Task<Int>| task.join(t)), [7, 8, 9, 10])",
    ),
  );
  let ran = spawned(["test", "--exec", "sh=/bin/sh", "--no-cache"]);
  assert(ran.code == 0, Some(all_output(ran)))
}

/// A program whose `main` returns which of two racing tasks a simulation heard first, the
/// simulation opened as `opened` writes it around `raced()`.
fn racing(opened: String) -> String =
  "fn raced() -> Int / {sim.read, abort.raise} = simulate {\n  let c = task.channel(2);\n  let a = task.spawn(|| task.send(c, 1));\n  let b = task.spawn(|| task.send(c, 2));\n  task.join(a);\n  task.join(b);\n  match ((task.recv(c), task.recv(c))) { (Some(x), Some(y)) -> x * 10 + y, _ -> 0 }\n}\n\nfn main() -> Int / {task.write, sim.read, abort.raise} = "
    ++ opened
    ++ "\n"

// A simulation in a task of the run's scheduler runs as one outside it does: the entry's seed takes
// the same schedule.
test/nondet "a simulate inside a task of the run's scheduler runs and takes its schedule from the seed" {
  let returned = |opened: String| {
    write_program(racing(opened));
    let r = spawned(["run", "--json", "--seed", "5"]);
    assert(r.code == 0, Some(all_output(r)));
    str(at(json_of(r), "value"))
  };
  let outside = returned("raced()");
  assert(outside == "12" || outside == "21", Some(outside));
  assert_eq(returned("task.join(task.spawn(|| raced()))"), outside)
}

/// `ply test` over the working directory's program, its child processes started by `sh` and its
/// files below the working directory.
fn hosted() -> List<String> = ["test", "--exec", "sh=/bin/sh", "--fs", "cwd=.", "--no-cache"]

// Tasks retire as they finish unheld, and a retired id is never reused, so no join lands on
// another task's result; a kept handle serves every join; and a handle inside a finished task's
// result keeps its task joinable.
test/nondet "every join in a production scheduler returns its own task" {
  write_program(
    "fn churn(n: Int) -> Int / {task.write, abort.raise} =\n  range(0, n).fold(0, |sum: Int, i: Int| {\n    task.spawn(|| i);\n    let t = task.spawn(|| i * 2);\n    task.yield();\n    sum + task.join(t)\n  })\n\nfn kept(n: Int) -> Int / {task.write, abort.raise} = {\n  let held = range(0, n).fold([], |tasks: List<Task<Int>>, i: Int| tasks.push(task.spawn(|| i)));\n  task.yield();\n  held.fold(0, |sum: Int, t: Task<Int>| sum + task.join(t) + task.join(t))\n}\n\nfn relayed() -> Int / {task.write, abort.raise} = {\n  let outer = task.spawn(|| task.spawn(|| 21));\n  task.yield();\n  task.yield();\n  let inner = task.join(outer);\n  task.yield();\n  task.join(inner) * 2\n}\n\ntest/nondet \"churn\" { assert_eq(churn(300), 89700) }\ntest/nondet \"kept\" { assert_eq(kept(40), 1560) }\ntest/nondet \"relayed\" { assert_eq(relayed(), 42) }\n",
  );
  let ran = spawned(hosted());
  assert(ran.code == 0 && all_output(ran).contains("3 passed"), Some(all_output(ran)))
}

// The scheduler runs a spawned task first, so the task yields to the spawner, which reads the clock
// once its `handle` has ended and joins; the task then reads the clock later, and is still served
// from the clause around its spawn.
test/nondet "a production task is handled by the handle around its spawn after that handle ended" {
  write_program(String::of_bytes_lossy(embed("../programs/host_boundary/ended_handle.ply")));
  let ran = spawned(hosted());
  assert(ran.code == 0, Some(all_output(ran)))
}

// Each task opens its scope, then waits on a child the host reports later and parks; each still
// reads its own scoped value once it wakes, whichever scope closed first.
test/nondet "tasks parked on the host keep their scoped values when the other's scope closes first" {
  write_program(
    "import std.process (process, exit_code)\n\nfn child(code: Int) -> Int / {process.spawn[sh]} =\n  match exit_code(process.spawn[sh]([\"-c\", \"exit \" ++ code.to_string()], \"\", [])) { Some(c) -> c, None -> 0 }\n\ntest/nondet \"each task reads its hold after the other's region closed\" {\n  let first = task.spawn(|| with_scope[a](10, |x: Int| ()) { c -> {\n    let got = child(5);\n    c.get() + got\n  } });\n  let second = task.spawn(|| with_scope[b](20, |x: Int| ()) { c -> {\n    let got = child(5);\n    c.get() + got\n  } });\n  assert_eq(task.join(first) + task.join(second), 40)\n}\n",
  );
  let ran = spawned(hosted());
  assert(ran.code == 0, Some(all_output(ran)))
}

// A simulation ends before the operation beside it, which the run does once, outside any schedule.
// A test that simulates is re-run by the search, so this is a run's.
test/nondet "a host operation beside a simulation is performed once" {
  write_program(
    "import std.fs (fs)\n\nfn main() -> Int / {fs.write[cwd], sim.read, abort.raise} = {\n  let inside = simulate {\n    let a = task.spawn(|| 1);\n    let b = task.spawn(|| 2);\n    task.join(a) + task.join(b)\n  };\n  match fs.append[cwd](\"sent\", Bytes::of_string(inside.to_string() ++ \"\\n\")) { Some(at) -> at, None -> 1 }\n}\n",
  );
  let ran = spawned(["run", "--fs", "cwd=."]);
  assert(ran.code == 0, Some(all_output(ran)));
  assert_eq(read("sent"), Some("3\n"))
}
