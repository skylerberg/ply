//! `derive json` and `derive bin` over every shape the derivers accept: what they write reads back,
//! what they cannot write is rejected at the derivation or at the producer, and a wire format moves
//! with the type and only with it. A deriver a program declares runs as the built-in ones do.

import spawning.harness (WorkingDirectory, PlyProcess, RunResult, write_project, write_program,
                         all_output, spawned, read)
import std.fs (fs)
import std.list
import std.string

fn check_one(source: String) -> RunResult / {PlyProcess, WorkingDirectory, abort.raise} = {
  write_program(source);
  spawned(["check", "."])
}

fn assert_tests_pass(source: String) -> Unit / {PlyProcess, WorkingDirectory, abort.raise} = {
  write_program(source);
  let r = spawned(["test", "."]);
  assert(r.code == 0, Some(all_output(r)));
  assert(
    !all_output(r).contains("0 passed"),
    Some("the fixture declared no tests:\n" ++ all_output(r)),
  )
}

test/nondet "a derived definition is exempt from the written-signature rule" {
  let r = check_one(
    "import std.bin\nimport std.json\npub type Box = {label: String, n: Int}\nderive json for Box\nderive bin for Box\n",
  );
  assert(
    !all_output(r).contains("E0126"),
    Some("a derived definition must not be asked for an annotation: " ++ all_output(r)),
  );
  assert(r.code == 0, Some("the project should check: " ++ all_output(r)))
}

fn json_program() -> String =
  \\import std.gen
  \\import std.gen (Gen)
  \\import std.json
  \\
  \\pub type Colour = Red | Green | Blue
  \\pub type Shape =
  \\  | Blank
  \\  | Circle(Decimal)
  \\  | Rect(Decimal, Decimal)
  \\  | Poly(List<Decimal>)
  \\
  \\pub type Tree = Leaf | Node(Tree, Tree)
  \\
  \\pub type Leafy = {
  \\  name: String,
  \\  raw: Bytes,
  \\  weight: Decimal,
  \\  count: Int,
  \\  flag: Bool,
  \\  nothing: Unit,
  \\  tags: List<String>,
  \\  maybe: Option<Int>,
  \\}
  \\
  \\pub type Deep = {
  \\  by_name: Map<String, Shape>,
  \\  by_num: Map<Int, List<Colour>>,
  \\  by_bytes: Map<Bytes, Tree>,
  \\  leaf: Leafy,
  \\  inner: List<Leafy>,
  \\  results: List<Result<Int, String>>,
  \\  tree: Tree,
  \\}
  \\
  \\derive json for Colour
  \\derive json for Shape
  \\derive json for Tree
  \\derive json for Leafy
  \\derive json for Deep
  \\
  \\pub fn round(d: Deep) -> Bool / {abort.raise} =
  \\  match json::decode_bytes(json::encode_bytes(d, deep_json()), deep_json()) {
  \\    Ok(e) -> e == d,
  \\    Err(x) -> false,
  \\  }
  \\
  \\// The other direction, and the one that catches a non-canonical print: a
  \\// document re-printed from what it parsed to must be the same bytes.
  \\pub fn reprint(j: json::Json) -> Bool / {abort.raise} =
  \\  match json::parse(json::to_bytes(j)) {
  \\    Ok(k) -> json::to_bytes(k) == json::to_bytes(j),
  \\    Err(x) -> false,
  \\  }
  \\
  \\fn shapes() -> Gen<Shape> =
  \\  gen::one_of([
  \\    gen::constant(Blank),
  \\    gen::map(gen::decimal(), |r: Decimal| Circle(r)),
  \\    gen::map2(gen::decimal(), gen::decimal(), |w: Decimal, h: Decimal| Rect(w, h)),
  \\    gen::map(gen::list_of(gen::decimal(), 3), |ps: List<Decimal>| Poly(ps)),
  \\  ])
  \\
  \\fn trees(depth: Int) -> Gen<Tree> =
  \\  if depth <= 0 { gen::constant(Leaf) } else {
  \\    gen::one_of([
  \\      gen::constant(Leaf),
  \\      gen::map2(trees(depth - 1), trees(depth - 1), |l: Tree, r: Tree| Node(l, r)),
  \\    ])
  \\  }
  \\
  \\fn leafies() -> Gen<Leafy> =
  \\  gen::map2(
  \\    gen::map4(gen::text(), gen::bytes(), gen::decimal(), gen::any_int(),
  \\      |name: String, raw: Bytes, weight: Decimal, count: Int| (name, raw, weight, count)),
  \\    gen::map3(gen::bool(), gen::list_of(gen::text(), 3), gen::option_of(gen::any_int()),
  \\      |flag: Bool, tags: List<String>, maybe: Option<Int>| (flag, tags, maybe)),
  \\    |a: (String, Bytes, Decimal, Int), b: (Bool, List<String>, Option<Int>)| {
  \\      name: a._0, raw: a._1, weight: a._2, count: a._3,
  \\      flag: b._0, nothing: (), tags: b._1, maybe: b._2,
  \\    },
  \\  )
  \\
  \\fn deeps() -> Gen<Deep> =
  \\  gen::map2(
  \\    gen::map4(
  \\      gen::map_of(gen::text(), shapes()),
  \\      gen::map_of(gen::any_int(), gen::list_of(gen::elements([Red, Green, Blue]), 3)),
  \\      gen::map_of(gen::bytes(), trees(3)),
  \\      leafies(),
  \\      |by_name: Map<String, Shape>, by_num: Map<Int, List<Colour>>, by_bytes: Map<Bytes, Tree>, leaf: Leafy|
  \\        (by_name, by_num, by_bytes, leaf)),
  \\    gen::map3(
  \\      gen::list_of(leafies(), 2),
  \\      gen::list_of(gen::result_of(gen::any_int(), gen::text()), 3),
  \\      trees(3),
  \\      |inner: List<Leafy>, results: List<Result<Int, String>>, tree: Tree| (inner, results, tree)),
  \\    |a: (Map<String, Shape>, Map<Int, List<Colour>>, Map<Bytes, Tree>, Leafy), b: (List<Leafy>, List<Result<Int, String>>, Tree)| {
  \\      by_name: a._0, by_num: a._1, by_bytes: a._2, leaf: a._3,
  \\      inner: b._0, results: b._1, tree: b._2,
  \\    },
  \\  )
  \\
  \\test "a derived codec round-trips through the wire" { gen::check(deeps(), round) }
  \\
  \\test "printing a parsed document reproduces it" { gen::check(json::jsons(), reprint) }
  \\

test/nondet "every shape the deriver accepts round-trips over drawn values" {
  assert_tests_pass(json_program())
}

// An unguarded round trip raises at the floats JSON cannot write, which the test after this one
// pins; over the ones it can, a record with a `Float` field reads back.
test/nondet "a float field round-trips over the values it encodes" {
  assert_tests_pass(
    \\import std.gen
    \\import std.json
    \\
    \\pub type Reading = { ratio: Float }
    \\derive json for Reading
    \\
    \\pub fn encodable(f: Float) -> Bool =
    \\  match Decimal::of_float(f) { Some(d) -> true, None -> false }
    \\
    \\pub fn round(r: Reading) -> Bool / {abort.raise} =
    \\  match json::decode_bytes(json::encode_bytes(r, reading_json()), reading_json()) {
    \\    Ok(s) -> s == r,
    \\    Err(e) -> false,
    \\  }
    \\
    \\test "a derived codec round-trips over the values it encodes" {
    \\  gen::check(gen::float(), |f: Float| !encodable(f) || round({ ratio: f }))
    \\}
    \\
  )
}

test/nondet "structurally identical types share a wire format and cross-decode" {
  write_project([
    {
      path: "n.ply",
      text: "import std.json\npub type D = LeftC(Int) | RightC(String)\nderive json for D\n",
    },
    {
      path: "m.ply",
      text:
        \\import std.json
        \\import n
        \\
        \\pub type A = { x: Int, y: String }
        \\pub type B = { y: String, x: Int }
        \\derive json for A
        \\derive json for B
        \\
        \\pub type C = LeftC(Int) | RightC(String)
        \\derive json for C
        \\
        \\fn a_wire(a: A) -> String / {abort.raise} = String::of_bytes(json::encode_bytes(a, a_json()))
        \\
        \\test "two record types of one shape write one document" {
        \\  assert_eq(a_wire({x: 1, y: "hi"}), "{\"x\":1,\"y\":\"hi\"}");
        \\  assert_eq(String::of_bytes(json::encode_bytes({x: 1, y: "hi"}, b_json())), a_wire({x: 1, y: "hi"}))
        \\}
        \\
        \\test "and each decodes the other's document" {
        \\  match json::decode_bytes(Bytes::of_string(a_wire({x: 1, y: "hi"})), b_json()) {
        \\    Ok(b) -> assert_eq(b.x, 1),
        \\    Err(e) -> assert_eq(json::error_to_string(e), "it should have decoded"),
        \\  }
        \\}
        \\
        \\test "an ADT is distinguished only by its variant names" {
        \\  let doc = String::of_bytes(json::encode_bytes(LeftC(3), c_json()));
        \\  assert_eq(doc, "{\"tag\":\"LeftC\",\"values\":[3]}");
        \\  // `n::D` is declared in another module with the same variant names, and its
        \\  // codec reads this document. A tag is a string, and nothing carries a module.
        \\  match json::decode_bytes(Bytes::of_string(doc), n::d_json()) {
        \\    Ok(d) -> assert(true),
        \\    Err(e) -> assert_eq(json::error_to_string(e), "it should have decoded"),
        \\  }
        \\}
        \\
    },
  ]);
  let r = spawned(["test", "."]);
  assert(r.code == 0, Some(all_output(r)))
}

/// A record of one field, written `name: Type`, whose derived codec a test reads each of `values`
/// back through.
fn round_trip_test(field: String, values: String) -> String =
  "import std.json\n\npub type Wrap = { " ++ field
    ++ " }\nderive json for Wrap\n\npub fn round(w: Wrap) -> Bool / {abort.raise} =\n  match (wrap_json().decode)((wrap_json().encode)(w)) {\n    Ok(v) -> v == w,\n    Err(e) -> false,\n  }\n\ntest \"a derived codec round-trips\" {\n  let values: List<Wrap> = "
    ++ values
    ++ ";\n  assert(values.filter(|w: Wrap| !w.round()).len() == 0)\n}\n"

// `option_json` writes `None` as `null` and `Some(x)` as `x`, so an inner encoding that can be
// `null` collapses the two.
test/nondet "an encoding that can be null is never wrapped in an option" {
  [
    { label: "Option<Unit>", field: "u: Option<Unit>", values: "[{ u: None }, { u: Some(()) }]" },
    {
      label: "Option<Option<Int>>",
      field: "oo: Option<Option<Int>>",
      values: "[{ oo: None }, { oo: Some(None) }, { oo: Some(Some(0)) }]",
    },
  ].fold((), |u: Unit, c: { label: String, field: String, values: String }| {
    let source = round_trip_test(c.field, c.values);
    let checked = check_one(source);
    if checked.code != 0 {
      assert(
        all_output(checked).contains("E0206"),
        Some(
          "rejecting `" ++ c.label ++ "` is a fine result, but it has to be E0206:\n"
            ++ all_output(checked),
        ),
      )
    } else {
      write_program(source);
      let r = spawned(["test", "."]);
      assert(
        r.code == 0,
        Some(
          "`" ++ c.label
            ++ "` derives a codec that loses data: the derivation is accepted and a value does not read back.\n"
            ++ all_output(r),
        ),
      )
    }
  })
}

test/nondet "two map keys that encode alike do not survive the wire" {
  let source =
    \\import std.json
    \\
    \\pub type Holder = { m: Map<Option<Unit>, Int> }
    \\derive json for Holder
    \\
    \\pub fn round(h: Holder) -> Bool / {abort.raise} =
    \\  match (holder_json().decode)((holder_json().encode)(h)) {
    \\    Ok(v) -> v.m.len() == h.m.len(),
    \\    Err(e) -> false,
    \\  }
    \\
    \\test "a map survives its own codec" {
    \\  assert(round({ m: #{None: 1, Some(()): 2} }))
    \\}
    \\
  ;
  let checked = check_one(source);
  if checked.code != 0 { assert(all_output(checked).contains("E0206"), Some(all_output(checked))) }
  else {
    write_program(source);
    let r = spawned(["test", "."]);
    assert(
      r.code == 0,
      Some(
        "`Map<Option<Unit>, Int>` encodes `None` and `Some(())` to the same key, so a two-entry map decodes to one.\n"
          ++ all_output(r),
      ),
    )
  }
}

fn tree_source() -> String =
  \\import std.json
  \\
  \\pub type Tree = Leaf | Node(Tree, Tree)
  \\derive json for Tree
  \\
  \\fn deep(n: Int) -> Tree = if n <= 0 { Leaf } else { Node(deep(n - 1), Leaf) }
  \\fn depth(t: Tree) -> Int = match t { Leaf -> 0, Node(l, _) -> 1 + depth(l) }
  \\
  \\fn through_a_value(n: Int) -> String / {abort.raise} =
  \\  match (tree_json().decode)((tree_json().encode)(deep(n))) {
  \\    Ok(t) -> depth(t).to_string(),
  \\    Err(e) -> "ERR " ++ json::error_to_string(e),
  \\  }
  \\
  \\fn through_the_wire(n: Int) -> String / {abort.raise} =
  \\  match json::decode_bytes(json::encode_bytes(deep(n), tree_json()), tree_json()) {
  \\    Ok(t) -> depth(t).to_string(),
  \\    Err(e) -> "ERR " ++ json::error_to_string(e),
  \\  }
  \\
  \\test "a codec over a value terminates at depth 100" {
  \\  assert_eq(through_a_value(100), "100")
  \\}
  \\
  \\test "and the wire round-trips up to half of max_depth" {
  \\  assert_eq(through_the_wire(60), "60");
  \\  assert_eq(through_the_wire(64), "64")
  \\}
  \\

test/nondet "a recursive codec rejects to write what it cannot read" {
  assert_tests_pass(tree_source());
  // Past the bound the *encoder* fails, so nothing is written that `parse` would later reject.
  write_program(
    tree_source()
      ++ "\ntest \"past it, the encoder is the one that rejects\" { assert_eq(through_the_wire(100), \"unreachable\") }\n",
  );
  let r = spawned(["test", "."]);
  assert(r.code == 1, Some(all_output(r)));
  assert(
    all_output(r).contains(
      "a JSON value nested deeper than 128 levels has no encoding `parse` would read back",
    ),
    Some("the rejection must name the bound, at the producer:\n" ++ all_output(r)),
  )
}

test/nondet "an added optional field is still required on the wire" {
  assert_tests_pass(String::of_bytes_lossy(embed("../programs/derive/added_optional_field.ply")))
}

// The scale is the edge a value comparison cannot see: `==` ignores it and `Decimal::to_string`
// does not.
test/nondet "integers and decimals survive their own edges, scale included" {
  assert_tests_pass(
    \\import std.json
    \\
    \\pub type Edge = { i: Int, d: Decimal }
    \\derive json for Edge
    \\
    \\fn round(i: Int, d: Decimal) -> String / {abort.raise} =
    \\  match json::decode_bytes(json::encode_bytes({i: i, d: d}, edge_json()), edge_json()) {
    \\    Ok(e) -> e.i.to_string() ++ " " ++ e.d.to_string(),
    \\    Err(x) -> "ERR " ++ json::error_to_string(x),
    \\  }
    \\
    \\test "i64 at both ends" {
    \\  assert_eq(round(9223372036854775807, 0m), "9223372036854775807 0");
    \\  assert_eq(round(-9223372036854775807 - 1, 0m), "-9223372036854775808 0")
    \\}
    \\
    \\test "a decimal at its bounds, and its scale with it" {
    \\  assert_eq(round(0, 79228162514264337593543950335m), "0 79228162514264337593543950335");
    \\  assert_eq(round(0, 0.0000000000000000000000000001m),
    \\            "0 0.0000000000000000000000000001");
    \\  // `1.500m == 1.5m`, so only the rendering catches a lost scale.
    \\  assert_eq(round(0, 1.500m), "0 1.500")
    \\}
    \\
    \\test "a number the wire holds but a Decimal cannot names the byte offset" {
    \\  match json::decode_bytes(Bytes::of_string("{\"i\":1e100,\"d\":0}"), edge_json()) {
    \\    Ok(e) -> assert(false),
    \\    Err(x) -> assert_eq(json::error_to_string(x),
    \\      "$: `1e100` is outside `Decimal`'s range or needs more than 28 significant digits (at byte 5)"),
    \\  }
    \\}
    \\
    \\test "a fractional value is not silently truncated into an Int field" {
    \\  match json::decode_bytes(Bytes::of_string("{\"i\":1.5,\"d\":0}"), edge_json()) {
    \\    Ok(e) -> assert(false),
    \\    Err(x) -> assert_eq(json::error_to_string(x), "$.i: expected a whole number, found `1.5`"),
    \\  }
    \\}
    \\
  )
}

// A number needing more than 28 significant digits, or larger than `Decimal`'s maximum, has no
// `Number` to become.
test/nondet "a float field encodes partially and says which value broke it" {
  write_program(
    \\import std.json
    \\
    \\pub type F = { f: Float }
    \\derive json for F
    \\
    \\pub fn wire(f: Float) -> String / {abort.raise} = String::of_bytes(json::encode_bytes({f: f}, f_json()))
    \\
    \\pub fn round(f: Float) -> Bool / {abort.raise} =
    \\  match json::decode_bytes(json::encode_bytes({f: f}, f_json()), f_json()) {
    \\    Ok(g) -> g.f == f,
    \\    Err(e) -> false,
    \\  }
    \\
    \\test "an ordinary float round-trips" {
    \\  assert(round(0.1));
    \\  assert(round(3.141592653589793));
    \\  // `-0.0` decodes as `+0.0`. The language's `==` cannot see it, `Value::cmp`
    \\  // can, and the two are two definitions in a hash, so it is written down.
    \\  assert(round(-0.0));
    \\  assert_eq(wire(-0.0), "{\"f\":0}")
    \\}
    \\
    \\test "a finite float too small for a Decimal raises" { assert_eq(wire(1.0e-30), "unreachable") }
    \\test "a finite float too large for a Decimal raises" { assert_eq(wire(1.0e300), "unreachable") }
    \\test "NaN raises and names itself" { assert_eq(wire(0.0 / 0.0), "unreachable") }
    \\test "an infinity raises and names itself" { assert_eq(wire(1.0 / 0.0), "unreachable") }
    \\
  );
  let r = spawned(["test", "."]);
  assert(r.code == 1, Some("the four raising cases must fail:\n" ++ all_output(r)));
  assert(
    all_output(r).contains("1 passed"),
    Some("the round-tripping case must pass:\n" ++ all_output(r)),
  );
  [
    "a Float that is outside `Decimal`'s range has no JSON encoding",
    "a Float that is NaN has no JSON encoding",
    "a Float that is Infinity has no JSON encoding",
  ].fold((), |u: Unit, expected: String|
    assert(all_output(r).contains(expected), Some(expected ++ "\n" ++ all_output(r))))
}

/// `\u{0001}` is written as `CTL` and substituted in: an editor silently rewrites a literal control
/// byte. `ERROR` stands for U+1F600 the same way.
fn text_source() -> String =
  \\import std.json
  \\
  \\pub type T = { s: String, b: Bytes }
  \\derive json for T
  \\
  \\fn wire(s: String, b: Bytes) -> String / {abort.raise} = String::of_bytes(json::encode_bytes({s: s, b: b}, t_json()))
  \\
  \\fn round(s: String, b: Bytes) -> Bool / {abort.raise} =
  \\  match json::decode_bytes(json::encode_bytes({s: s, b: b}, t_json()), t_json()) {
  \\    Ok(t) -> t.s == s && t.b == b,
  \\    Err(e) -> false,
  \\  }
  \\
  \\test "the empty string and the empty byte string" {
  \\  assert(round("", b""));
  \\  assert_eq(wire("", b""), "{\"b\":\"\",\"s\":\"\"}")
  \\}
  \\
  \\test "unicode passes through unescaped and round-trips" {
  \\  assert(round("éERROR", b""));
  \\  assert_eq(wire("éERROR", b""), "{\"b\":\"\",\"s\":\"éERROR\"}")
  \\}
  \\
  \\test "controls, quotes and backslashes are escaped and read back" {
  \\  assert(round("aCTLb\n\t\"q\\", b""));
  \\  assert_eq(wire("aCTLb\n\t\"q\\", b""), "{\"b\":\"\",\"s\":\"a\\u0001b\\n\\t\\\"q\\\\\"}")
  \\}
  \\
  \\test "every byte value survives base64" {
  \\  assert(round("", b"\x00\x01\x7f\xfe\xff"));
  \\  assert_eq(wire("", b"\x00\xff\x7f"), "{\"b\":\"AP9/\",\"s\":\"\"}")
  \\}
  \\

test/nondet "text and bytes survive escaping in both directions" {
  write_program(
    text_source().replace("CTL", String::of_bytes(b"\x01")).replace(
      "ERROR",
      String::of_bytes(b"\xf0\x9f\x98\x80"),
    ),
  );
  let r = spawned(["test", "."]);
  assert(r.code == 0, Some(all_output(r)))
}

// The deriver chooses object or pairs from the key's type, through this module's aliases, not from
// its spelling.
test/nondet "a map key written through an alias gets the same wire format" {
  assert_tests_pass(
    \\import std.json
    \\
    \\pub type Key = String
    \\derive json for Key
    \\
    \\pub type Direct = { m: Map<String, Int> }
    \\pub type Aliased = { m: Map<Key, Int> }
    \\derive json for Direct
    \\derive json for Aliased
    \\
    \\pub type ById = { m: Map<Int, Int> }
    \\derive json for ById
    \\
    \\fn entry() -> Map<String, Int> = Map::new().insert("k", 1)
    \\
    \\test "one type, one protocol, whichever way the key was spelled" {
    \\  assert_eq(String::of_bytes(json::encode_bytes({m: entry()}, direct_json())), "{\"m\":{\"k\":1}}");
    \\  assert_eq(String::of_bytes(json::encode_bytes({m: entry()}, aliased_json())), "{\"m\":{\"k\":1}}")
    \\}
    \\
    \\test "so each reads the other's document" {
    \\  match json::decode_bytes(Bytes::of_string("{\"m\":{\"k\":1}}"), aliased_json()) {
    \\    Ok(a) -> assert_eq(a.m.len(), 1),
    \\    Err(e) -> assert_eq(json::error_to_string(e), "it should have decoded"),
    \\  }
    \\}
    \\
    \\// The other branch is still there: a key that is not a `String` has no object
    \\// form, because a JSON object's keys are strings.
    \\test "a key that is not a string is an array of pairs" {
    \\  assert_eq(String::of_bytes(json::encode_bytes({m: Map::new().insert(1, 2)}, by_id_json())),
    \\            "{\"m\":[{\"key\":1,\"value\":2}]}")
    \\}
    \\
  )
}

test/nondet "a derive over a field whose codec is not imported says only that, and where it is exported" {
  write_project([
    {
      path: "kinds.ply",
      text: "import std.bin\npub type Mode = | Read | Write\nderive bin for Mode\n",
    },
    {
      path: "m.ply",
      text: "import std.bin\nimport kinds (Mode)\npub type Atom = { mode: Mode, n: Int }\nderive bin for Atom\n",
    },
  ]);
  let r = spawned(["check", "."]);
  assert(
    all_output(r).count("E0206") == 1 && !all_output(r).contains("E0505"),
    Some(all_output(r)),
  );
  assert(all_output(r).contains("add `import kinds (mode_bin)`"), Some(all_output(r)))
}

test/nondet "the rejections that keep a codec total all fire" {
  [
    {
      code: "E0206",
      source: "import std.json\npub type Order = { id: Int, on_complete: (Int) -> Unit }\nderive json for Order\n",
    },
    { code: "E0208", source: "import std.json\nimport n\nderive json for Thing\n" },
    {
      code: "E0105",
      source: "import std.json\npub type Order = { id: Int }\nderive json for Order\nderive json for Order\n",
    },
  ].fold((), |u: Unit, c: { code: String, source: String }| {
    write_project([
      { path: "m.ply", text: c.source },
      { path: "n.ply", text: "pub type Thing = { id: Int }\n" },
    ]);
    let r = spawned(["check", "."]);
    assert(r.code != 0, Some(c.source ++ "\n" ++ all_output(r)));
    assert(all_output(r).contains(c.code), Some(c.source ++ "\n" ++ all_output(r)))
  })
}

fn bin_program() -> String =
  \\import std.bin
  \\import std.gen
  \\import std.gen (Gen)
  \\
  \\pub type Colour = Red | Green | Blue
  \\pub type Tree = Leaf | Node(Tree, Tree)
  \\
  \\pub type Leafy = {
  \\  name: String,
  \\  raw: Bytes,
  \\  weight: Decimal,
  \\  count: Int,
  \\  flag: Bool,
  \\  nothing: Unit,
  \\  small: U8,
  \\  wide: I64,
  \\  tags: List<String>,
  \\  maybe: Option<Option<Int>>,
  \\}
  \\
  \\pub type Deep = {
  \\  by_name: Map<String, Colour>,
  \\  by_num: Map<Int, List<Colour>>,
  \\  leaf: Leafy,
  \\  inner: List<Leafy>,
  \\  results: List<Result<Int, String>>,
  \\  tree: Tree,
  \\  pair: (Int, Option<Unit>),
  \\}
  \\
  \\derive bin for Colour
  \\derive bin for Tree
  \\derive bin for Leafy
  \\derive bin for Deep
  \\
  \\pub fn round(d: Deep) -> Bool / {abort.raise} = bin::decode(bin::encode(d, deep_bin()), deep_bin()) == Ok(d)
  \\
  \\fn colours() -> Gen<Colour> = gen::elements([Red, Green, Blue])
  \\
  \\fn trees(depth: Int) -> Gen<Tree> =
  \\  if depth <= 0 { gen::constant(Leaf) } else {
  \\    gen::one_of([
  \\      gen::constant(Leaf),
  \\      gen::map2(trees(depth - 1), trees(depth - 1), |l: Tree, r: Tree| Node(l, r)),
  \\    ])
  \\  }
  \\
  \\fn leafies() -> Gen<Leafy> =
  \\  gen::map3(
  \\    gen::map4(gen::text(), gen::bytes(), gen::decimal(), gen::any_int(),
  \\      |name: String, raw: Bytes, weight: Decimal, count: Int| (name, raw, weight, count)),
  \\    gen::map3(gen::bool(), gen::below(256), gen::any_int(),
  \\      |flag: Bool, small: Int, wide: Int| (flag, small, wide)),
  \\    gen::map2(gen::list_of(gen::text(), 3), gen::option_of(gen::option_of(gen::any_int())),
  \\      |tags: List<String>, maybe: Option<Option<Int>>| (tags, maybe)),
  \\    |a: (String, Bytes, Decimal, Int), b: (Bool, Int, Int), c: (List<String>, Option<Option<Int>>)| {
  \\      name: a._0, raw: a._1, weight: a._2, count: a._3,
  \\      flag: b._0, nothing: (), small: U8::of_int(b._1), wide: I64::of_int(b._2),
  \\      tags: c._0, maybe: c._1,
  \\    },
  \\  )
  \\
  \\fn deeps() -> Gen<Deep> =
  \\  gen::map2(
  \\    gen::map4(
  \\      gen::map_of(gen::text(), colours()),
  \\      gen::map_of(gen::any_int(), gen::list_of(colours(), 3)),
  \\      leafies(),
  \\      gen::list_of(leafies(), 2),
  \\      |by_name: Map<String, Colour>, by_num: Map<Int, List<Colour>>, leaf: Leafy, inner: List<Leafy>|
  \\        (by_name, by_num, leaf, inner)),
  \\    gen::map3(
  \\      gen::list_of(gen::result_of(gen::any_int(), gen::text()), 3),
  \\      trees(3),
  \\      gen::map2(gen::any_int(), gen::option_of(gen::constant(())), |n: Int, u: Option<Unit>| (n, u)),
  \\      |results: List<Result<Int, String>>, tree: Tree, pair: (Int, Option<Unit>)| (results, tree, pair)),
  \\    |a: (Map<String, Colour>, Map<Int, List<Colour>>, Leafy, List<Leafy>), b: (List<Result<Int, String>>, Tree, (Int, Option<Unit>))| {
  \\      by_name: a._0, by_num: a._1, leaf: a._2, inner: a._3,
  \\      results: b._0, tree: b._1, pair: b._2,
  \\    },
  \\  )
  \\
  \\test "a derived codec round-trips through the bytes" { gen::check(deeps(), round) }
  \\

test/nondet "every shape the bin deriver accepts round-trips over drawn values" {
  assert_tests_pass(bin_program())
}

test/nondet "bin reads back what json cannot and rejects what it did not write" {
  assert_tests_pass(
    \\import std.bin
    \\
    \\pub type Reading = { ratio: Float, at: U64, big: I128, tag: Ordering }
    \\derive bin for Reading
    \\
    \\pub type Tree = Leaf | Node(Tree, Int)
    \\derive bin for Tree
    \\
    \\fn deep(n: Int, t: Tree) -> Tree = if n <= 0 { t } else { deep(n - 1, Node(t, n)) }
    \\
    \\test "a NaN keeps its bits and the wide widths keep their range" {
    \\  let nan = Float::of_bits(9221120237041090561);
    \\  let least = match I128::of_string("-170141183460469231731687303715884105728") { Some(n) -> n, None -> 0i128 };
    \\  let r = {ratio: nan, at: 18446744073709551615u64, big: least, tag: Greater};
    \\  match bin::decode(bin::encode(r, reading_bin()), reading_bin()) {
    \\    Ok(s) -> {
    \\      assert_eq(bits_of_float(s.ratio), bits_of_float(nan));
    \\      assert_eq(s.at, r.at);
    \\      assert_eq(s.big, r.big);
    \\      assert_eq(s.tag, Greater)
    \\    },
    \\    Err(e) -> assert_eq(bin::error_to_string(e), "it should have decoded"),
    \\  }
    \\}
    \\
    \\test "a deep recursive value round-trips" {
    \\  let t = deep(500, Leaf);
    \\  assert_eq(bin::decode(bin::encode(t, tree_bin()), tree_bin()), Ok(t))
    \\}
    \\
    \\test "a constructor index past the type's is rejected, not guessed" {
    \\  match bin::decode(b"\x02", tree_bin()) {
    \\    Ok(t) -> assert(false),
    \\    Err(e) -> assert_eq(bin::error_to_string(e), "constructor 2 of a type with 2 (at byte 0)"),
    \\  }
    \\}
    \\
  )
}

test/nondet "a shape moves with the type and only with it" {
  write_project([
    {
      path: "n.ply",
      text: "import std.bin\npub type S = A(Int) | B(String)\nderive bin for S\npub type R = {x: Int}\nderive bin for R\n",
    },
    { path: "o.ply", text: "import std.bin\npub type S = B(String) | A(Int)\nderive bin for S\n" },
    {
      path: "m.ply",
      text:
        \\import std.bin
        \\import n
        \\import o
        \\
        \\pub type S = A(Int) | B(String)
        \\derive bin for S
        \\pub type R = {x: Int}
        \\derive bin for R
        \\pub type Renamed = {y: Int}
        \\derive bin for Renamed
        \\pub type Box<a> = {item: a}
        \\derive bin for Box
        \\
        \\test "one structure under one name has one shape, in any module" {
        \\  assert_eq(bin::shape_digest(s_bin()), bin::shape_digest(n::s_bin()));
        \\  assert_eq(bin::shape_digest(r_bin()), bin::shape_digest(n::r_bin()))
        \\}
        \\
        \\test "an order, a field name or a type argument changes it" {
        \\  assert(bin::shape_digest(s_bin()) != bin::shape_digest(o::s_bin()));
        \\  assert(bin::shape_digest(r_bin()) != bin::shape_digest(renamed_bin()));
        \\  assert(bin::shape_digest(box_bin(bin::int_bin())) != bin::shape_digest(box_bin(bin::string_bin())))
        \\}
        \\
    },
  ]);
  let r = spawned(["test", "."]);
  assert(r.code == 0, Some(all_output(r)))
}

/// A deriver of the program's own: `T::named()` returns `T`'s name, `Rejected` it rejects at its
/// variant `WorkingDirectory`, and `Raised` it panics over.
fn naming_deriver() -> String =
  \\import std.derive
  \\
  \\pub fn derive(declaration: derive::Declaration) -> Result<String, derive::Refused> / {abort.raise} =
  \\  if declaration.target == "Rejected" {
  \\    Err({ message: "a type named `Rejected` is rejected", at: Some("Here"), notes: ["rename it"] })
  \\  } else if declaration.target == "Raised" { panic("the deriver gave up") }
  \\  else {
  \\    Ok("pub fn " ++ declaration.target ++ "::named() -> String = \"" ++ declaration.target ++ "\"")
  \\  }
  \\

fn derived_by(source: String) -> RunResult / {PlyProcess, WorkingDirectory, abort.raise} = {
  write_project([{ path: "naming.ply", text: naming_deriver() }, { path: "m.ply", text: source }]);
  spawned(["test", "."])
}

test/nondet "a deriver the program declares derives for another of its modules" {
  let r = derived_by(
    \\import naming
    \\
    \\pub type Order = | Order(Int)
    \\derive naming for Order
    \\
    \\test "the derived function returns the type's name" { assert_eq(Order::named(), "Order") }
    \\
  );
  assert(r.code == 0, Some(all_output(r)));
  assert(all_output(r).contains("1 passed"), Some(all_output(r)))
}

test/nondet "a command that reads the program whole takes what the load's deriver wrote" {
  write_project([
    { path: "naming.ply", text: naming_deriver() },
    {
      path: "m.ply",
      text: "import naming\n\npub type Order = | Order(Int)\nderive naming for Order\n\npub fn name() -> String = Order::named()\n",
    },
  ]);
  let r = spawned(["check", ".", "--costs"]);
  assert(r.code == 0, Some(all_output(r)))
}

test/nondet "a rename runs the deriver the program declares, though nothing has run it yet" {
  write_project([
    { path: "naming.ply", text: naming_deriver() },
    {
      path: "m.ply",
      text: "import naming\n\npub type Order = | Order(Int)\nderive naming for Order\n\npub fn name() -> String = Order::named()\n",
    },
    { path: "map.txt", text: "m.ply name label\n" },
  ]);
  let r = spawned(["rename", "--map", "map.txt", "m.ply"], [
    { name: "PLY_C_CACHE", value: ".derivations" },
  ]);
  assert(r.code == 0, Some(all_output(r)));
  assert_eq(
    read("m.ply"),
    Some(
      "import naming\n\npub type Order = | Order(Int)\nderive naming for Order\n\npub fn label() -> String = Order::named()\n",
    ),
  )
}

test/nondet "a rename stops where a definition a deriver writes would refer to a name it removes" {
  let text = "import naming\n\npub type Order = | Order(Int)\nderive naming for Order\n\npub fn helper() -> String = \"order\"\n";
  write_project([
    {
      path: "naming.ply",
      text: "import std.derive\n\npub fn derive(declaration: derive::Declaration) -> Result<String, derive::Refused> / {abort.raise} =\n  Ok(\"pub fn \" ++ declaration.target ++ \"::named() -> String = helper()\")\n",
    },
    { path: "m.ply", text: text },
    { path: "map.txt", text: "m.ply helper assist\n" },
  ]);
  let r = spawned(["rename", "--map", "map.txt", "m.ply"]);
  assert_eq(r.code, 2);
  assert(
    all_output(r).contains(
      "error: m.ply: a definition a `derive` writes would refer to `helper`, which nothing declares after the renames",
    ),
    Some(all_output(r)),
  );
  assert_eq(read("m.ply"), Some(text))
}

// A `ply` of its own over a cache of its own, so what the cache holds is what this load cached.
test/nondet "a load compiles its deriver once, however many derivations it runs" {
  write_project([
    { path: "naming.ply", text: naming_deriver() },
    {
      path: "m.ply",
      text: "import naming\n\npub type A = | A\npub type B = | B\npub type C = | C\nderive naming for A\nderive naming for B\nderive naming for C\n",
    },
  ]);
  let r = spawned(["check", "."], [{ name: "PLY_C_CACHE", value: ".derivations" }]);
  assert(r.code == 0, Some(all_output(r)));
  let kept = |dir: String|
    match fs.list_dir[cwd](".derivations/" ++ dir) { Some(names) -> names.len(), None -> 0 };
  // The deriver's library, once; a result for each declaration.
  assert_eq(kept("derivers"), 1);
  assert_eq(kept("derived"), 3)
}

test/nondet "a deriver's rejection, a raise and a module that is no deriver each report at the derivation" {
  [
    {
      code: "E0206",
      says: "a type named `Rejected` is rejected",
      source: "import naming\npub type Rejected = | Here | There\nderive naming for Rejected\n",
    },
    {
      code: "E0155",
      says: "raised or did not finish in time",
      source: "import naming\npub type Raised = { id: Int }\nderive naming for Raised\n",
    },
    {
      code: "E0160",
      says: "is no deriver a `derive` can run",
      source: "import other\npub type T = { id: Int }\nderive other for T\n",
    },
    {
      code: "E0207",
      says: "`unbound` is not a deriver",
      source: "pub type T = { id: Int }\nderive unbound for T\n",
    },
  ].fold((), |u: Unit, c: { code: String, says: String, source: String }| {
    write_project([
      { path: "naming.ply", text: naming_deriver() },
      { path: "other.ply", text: "pub fn derive(n: Int) -> Int = n\n" },
      { path: "m.ply", text: c.source },
    ]);
    let r = spawned(["check", "."]);
    assert(r.code != 0, Some(c.source ++ "\n" ++ all_output(r)));
    assert(
      all_output(r).contains(c.code) && all_output(r).contains(c.says),
      Some(c.source ++ "\n" ++ all_output(r)),
    )
  })
}

test/nondet "a bin derivation needs its module and rejects a credential" {
  [
    {
      code: "E0207",
      source: "pub type R = {x: Int}\nderive bin for R\n",
      says: "`bin` is not a deriver",
    },
    {
      code: "E0206",
      source: "import std.bin\npub type R = {token: Secret}\nderive bin for R\n",
      says: "a derived codec would write the credential into the bytes",
    },
  ].fold((), |u: Unit, c: { code: String, source: String, says: String }| {
    let r = check_one(c.source);
    assert(r.code != 0, Some(all_output(r)));
    assert(
      all_output(r).contains(c.code) && all_output(r).contains(c.says),
      Some(c.says ++ "\n" ++ all_output(r)),
    )
  })
}
