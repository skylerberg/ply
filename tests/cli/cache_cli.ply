import spawning.harness (PlyProcess, spawned, write_project, working_directory, json_of, at, path,
                         items, json_text, WorkingDirectory)
import std.fs (fs, Entry, Dir)
import std.json (Json)
import std.list

fn core() -> String = String::of_bytes_lossy(embed("../programs/cache_cli/core.ply"))

fn shop() -> String =
  \\import core
  \\
  \\fn total(items: List<core::Item>) -> Int =
  \\  items.fold(0, |acc, i: core::Item| acc + core::price(i))
  \\
  \\fn stored(k: Int) -> Int / {core::db.read[cart]} = core::db.get[cart](k)
  \\
  \\test "a shelf adds up" {
  \\  assert_eq(total([core::Book("b", 3), core::Note("n")]), 3)
  \\}
  \\

fn shop_project() -> Unit / {WorkingDirectory, abort.raise} =
  write_project([
    { path: "core.ply", text: core() },
    { path: "shop.ply", text: shop() },
    { path: "leaf.ply", text: "pub fn one() -> Int = 1\npub fn two() -> Int = one() + one()\n" },
  ])

fn test_hashes(extra: List<String>) -> List<String> / {PlyProcess, abort.raise} = {
  let v = json_of(spawned(["test", ".", "--json"].concat(extra)));
  items(path(v, ["selection", "tests"])).map(|t: Json|
    json_text(at(t, "key")) ++ " " ++ json_text(at(t, "hash")))
}

test/nondet "the worker count does not change test hashes" {
  shop_project();
  let one = test_hashes(["--jobs", "1"]);
  assert_eq(one, test_hashes(["--jobs", "10"]));
  assert_eq(one, test_hashes(["--no-cache"]))
}

test/nondet "a relative and an absolute path share one cache" {
  shop_project();
  let _ = spawned(["test", ".", "--filter", "nonexistent"]);
  assert_eq(spawned(["test", "--filter", "nonexistent", working_directory()]).code, 0);
  let caches = match fs.walk[cwd](".") {
    Some(entries) -> entries.filter(|e: Entry| e.kind == Dir && e.path.ends_with(".ply-cache")),
    None -> panic("the working directory walks"),
  };
  assert_eq(caches.len(), 1)
}
