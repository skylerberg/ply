fn fixtures() -> List<{ name: String, bytes: Bytes }> = embed_dir("../fixtures")

fn fixture_sources(name: String) -> List<Source> / {abort.raise} = {
  let file = name ++ ".ply";
  let dir = name ++ "/";
  fixtures().fold([], |accumulator: List<Source>, f: { name: String, bytes: Bytes }|
    if f.name == file { accumulator.push({ path: file, text: String::of_bytes(f.bytes) }) }
    else if f.name.starts_with(dir) {
      accumulator.push({
        path: f.name.slice(dir.len(), f.name.len()),
        text: String::of_bytes(f.bytes),
      })
    } else { accumulator })
}

fn listing(errors: List<Json>) -> String =
  errors.fold("", |accumulator: String, d: Json| {
    let at_line = match items(at(d, "labels")).filter(|l: Json| bool(at(l, "primary"))) {
      [l, ..] -> " at " ++ str(at(l, "file")) ++ ":" ++ int(path(l, ["start", "line"])).to_string(),
      [] -> "",
    };
    accumulator ++ "  " ++ str(at(d, "code")) ++ " " ++ str(at(d, "message")) ++ at_line ++ "\n"
  })

fn entering() -> List<String> = ["drain_incomplete", "span_abandoned", "span_unbalanced"]

fn listing_mismatch(f: FixtureEntry, result: Json) -> String = {
  let errors = items(at(result, "diagnostics")).filter(|d: Json| str(at(d, "severity")) == "error");
  let found = errors.map(|d: Json| str(at(d, "code"))).sort();
  if found == f.rejected.sort() { "" } else if f.rejected == [] {
    "`tests/fixtures/" ++ f.name
      ++ "` does not compile, so nothing that runs it reaches what it is for:\n"
      ++ listing(errors)
  } else {
    "`tests/fixtures/" ++ f.name ++ "` exists to be rejected with exactly "
      ++ String::join(f.rejected, ", ")
      ++ ":\n"
      ++ listing(errors)
  }
}

test/nondet "checking fixture {f.name} in a separate `ply` process gives the diagnostics the fixture list expects" for f: FixtureEntry in fixture_entries(
  ).filter(|f: FixtureEntry| entering().contains(f.name)) {
  write_project(fixture_sources(f.name));
  let m = listing_mismatch(f, json_of(spawned(["check", ".", "--json"])));
  assert(m == "", Some(m))
}

test "every fixture is listed" {
  let present = fixtures().fold(
    [],
    |accumulator: List<String>, f: { name: String, bytes: Bytes }| {
      let n = match f.name.split_once("/") {
        Some(p) -> p.head,
        None -> if f.name.ends_with(".ply") { f.name.slice(0, f.name.len() - 4) } else { "" },
      };
      if n == "" || accumulator.filter(|m: String| m == n).len() > 0 { accumulator }
      else { accumulator.push(n) }
    },
  );
  let names = fixture_entries().map(|f: FixtureEntry| f.name);
  let unlisted = present.filter(|n: String| names.filter(|m: String| m == n).len() == 0);
  let gone = names.filter(|n: String| present.filter(|m: String| m == n).len() == 0);
  assert(
    unlisted == [],
    Some(
      "these fixtures are not listed: list each with the errors `ply check` rejects it with, or none: "
        ++ String::join(unlisted, ", "),
    ),
  );
  assert(
    gone == [],
    Some(
      "these are listed, and tests/fixtures holds no such program: " ++ String::join(gone, ", "),
    ),
  )
}

test/nondet "`ply run` warns about trace spans never closed when the entry point ends, and still exits with code zero" {
  write_project(fixture_sources("span_abandoned"));
  let run = ["run", "--trace", "json"];
  let warning = "2 spans were still open when their task or the entry point ended: `reserving` on `orders`, `order` on `orders`";
  let r = spawned(run.push("span_abandoned.ply"), []);
  assert(r.code == 0, Some(stderr(r)));
  assert(r.out == [], Some("stdout is the program's, and it wrote nothing: " ++ stdout(r)));
  assert(
    r.err.filter(|l: String| l.trim() == "warning: " ++ warning).len() > 0,
    Some("the run says nothing of the spans it closed: " ++ stderr(r)),
  );
  let closed = r.err.filter(|l: String| l.starts_with("{")).fold(
    [],
    |accumulator: List<String>, l: String|
      match json::parse_string(l) {
        Ok(record) -> if str(at(record, "outcome")) == "abandoned" {
          accumulator.push(str(at(record, "name")))
        } else { accumulator },
        Err(_) -> accumulator,
      },
  );
  assert(closed == ["reserving", "order"], Some(stderr(r)));

  let document = json_of(spawned(run.concat(["--json", "span_abandoned.ply"]), []));
  assert(int(at(document, "exit_code")) == 0, Some(json_text(document)));
  let warned = items(at(document, "diagnostics")).filter(|d: Json| str(at(d, "code")) == "W0609");
  assert(warned.len() == 1, Some(json_text(document)));
  assert(str(at(first(warned), "severity")) == "warning", Some(json_text(document)));
  assert(str(at(first(warned), "message")) == warning, Some(json_text(document)));
  assert(
    int(path(document, ["shutdown", "spans_left_open"])) == 2,
    Some("the report counts the spans the warning names: " ++ json_text(document)),
  )
}

fn test_report(flags: List<String>) -> Json / {PlyProcess, abort.raise} =
  json_of(spawned(["test", ".", "--json", "--no-cache"].concat(flags)))

fn only_failure(report: Json) -> Json / {abort.raise} =
  match items(at(report, "failures")) {
    [failure] -> failure,
    _ -> panic("expected exactly one failing test: " ++ json_text(report)),
  }

type Span = { start: Int, end: Int }

fn span_of(name: String, text: String) -> Span / {abort.raise} = {
  let source = match fixture_sources(name).filter(|f: Source| f.path == name ++ ".ply") {
    [f, ..] -> Bytes::of_string(f.text),
    [] -> panic("`tests/fixtures` holds no `" ++ name ++ ".ply`"),
  };
  let needle = Bytes::of_string(text);
  match source.index_of(needle) {
    None -> panic("`" ++ name ++ "` writes no `" ++ text ++ "`"),
    Some(at_byte) -> match source.index_of_from(needle, at_byte + 1) {
      Some(_) -> panic("`" ++ name ++ "` writes `" ++ text ++ "` more than once"),
      None -> { start: at_byte, end: at_byte + needle.len() },
    },
  }
}

test/nondet "the search finds the channel race between two senders" {
  write_project(fixture_sources("channel_race"));
  let searched = test_report([]);
  assert(int(at(searched, "exit_code")) == 1, Some(json_text(searched)));
  let failure = only_failure(searched);
  assert(
    str(path(failure, ["diagnostic", "message"]))
      == "assertion failed: expected Some(1), found Some(2)",
    Some(json_text(failure)),
  );
  let race = at(failure, "race");
  let sides = [at(race, "left"), at(race, "right")];
  assert(
    sides.map(|s: Json| str(at(s, "task"))).sort() == ["@1", "@2"],
    Some("the race is between the two senders: " ++ json_text(race)),
  );
  [{ task: "@1", perform: "task.send(c, 1)" }, { task: "@2", perform: "task.send(c, 2)" }].fold(
    (),
    |u: Unit, a: { task: String, perform: String }| {
      let side = match sides.filter(|s: Json| str(at(s, "task")) == a.task) {
        [s, ..] -> s,
        [] -> panic("no side of the race is " ++ a.task ++ ": " ++ json_text(race)),
      };
      assert(
        str(at(side, "access")) == "task.chan.write[#0]",
        Some("each side writes the channel: " ++ json_text(race)),
      );
      let span = span_of("channel_race", a.perform);
      assert(
        int(path(side, ["span", "start"])) == span.start
          && int(path(side, ["span", "end"])) == span.end,
        Some(a.task ++ "'s side is placed at `" ++ a.perform ++ "`: " ++ json_text(race)),
      )
    },
  )
}

test/nondet "`ply test` seed search fails on the cancel race, where a cancel runs after its target task finished, from each of six seeds" {
  write_project(fixture_sources("cancel_race"));
  range(0, 6).fold((), |u: Unit, root: Int| {
    let roots = root.to_string() ++ ".." ++ Int::to_string(root + 1);
    let searched = test_report(["--seed-range", roots]);
    assert(
      int(at(searched, "exit_code")) == 1,
      Some("root " ++ roots ++ ": " ++ json_text(searched)),
    );
    assert(
      str(path(only_failure(searched), ["diagnostic", "message"]))
        == "assertion failed: expected Some(7), found None",
      Some("root " ++ roots ++ ": " ++ json_text(searched)),
    )
  })
}

test/nondet "the search finds the bank race and its seed replays it" {
  write_project(fixture_sources("bank_race"));
  let searched = test_report([]);
  assert(int(at(searched, "exit_code")) == 1, Some(json_text(searched)));
  let failure = only_failure(searched);
  assert(
    str(at(failure, "key")) == "bank_race.no account is ever overdrawn",
    Some(json_text(failure)),
  );
  assert(str(path(failure, ["diagnostic", "code"])) == "E0501", Some(json_text(failure)));
  assert(
    str(path(failure, ["diagnostic", "message"])) == "assertion failed: expected 0, found 1",
    Some("alice is overdrawn: " ++ json_text(failure)),
  );

  let race = at(failure, "race");
  let sides = [at(race, "left"), at(race, "right")];
  assert(
    sides.map(|s: Json| str(at(s, "task"))).sort() == ["@1", "@2"],
    Some("the race is between the two transfers: " ++ json_text(race)),
  );
  assert(
    sides.map(|s: Json| str(at(s, "access"))).sort()
      == ["bank_race.bank.read[accounts]", "bank_race.bank.write[accounts]"],
    Some(
      "one transfer's balance check is reordered against the other's debit: " ++ json_text(race),
    ),
  );
  [
    { access: "bank_race.bank.read[accounts]", perform: "bank.balance[accounts](from)" },
    { access: "bank_race.bank.write[accounts]", perform: "bank.credit[accounts](from, -amount)" },
  ].fold((), |u: Unit, a: { access: String, perform: String }| {
    let side = match sides.filter(|s: Json| str(at(s, "access")) == a.access) {
      [s, ..] -> s,
      [] -> panic("no side of the race is `" ++ a.access ++ "`: " ++ json_text(race)),
    };
    assert(
      str(at(side, "definition")) == "bank_race.transfer",
      Some(
        "`" ++ a.access ++ "` is named in the definition that performed it: " ++ json_text(race),
      ),
    );
    let span = span_of("bank_race", a.perform);
    assert(
      int(path(side, ["span", "start"])) == span.start
        && int(path(side, ["span", "end"])) == span.end,
      Some(
        "`" ++ a.access ++ "` is placed at `" ++ a.perform
          ++ "`, where its step first touched the accounts: "
          ++ json_text(race),
      ),
    )
  });

  let seed = str(at(failure, "seed"));
  assert(seed != "", Some("a failure the search found carries its seed: " ++ json_text(failure)));
  let test_name = "no account is ever overdrawn";
  assert(
    str(at(failure, "replay")) == "ply test --seed " ++ seed ++ " --filter '" ++ test_name ++ "'",
    Some(json_text(failure)),
  );
  let replayed = test_report(["--seed", seed, "--filter", test_name]);
  assert(
    path(only_failure(replayed), ["diagnostic", "message"])
      == path(failure, ["diagnostic", "message"]),
    Some("the seed the failure printed does not replay it: " ++ json_text(replayed)),
  )
}

test/nondet "on a second `ply test` run, a failing case runs again and a passing case with an equal value is cached" {
  write_project(fixture_sources("case_of_a_keyed_type"));
  let in_metres = "`in_metres` returns true for Metres(2), a `Length` given in either metres or millimetres";
  let in_millimetres = "`in_metres` returns true for Millimetres(2000), a `Length` given in either metres or millimetres";
  let first = json_of(spawned(["test", ".", "--json"]));
  assert(failed(first) == [in_millimetres], Some(json_text(first)));
  assert(selected(first) == [in_metres, in_millimetres], Some(json_text(first)));
  assert(int(path(first, ["summary", "passed"])) == 1, Some(json_text(first)));
  let second = json_of(spawned(["test", ".", "--json"]));
  assert(failed(second) == [in_millimetres], Some(json_text(second)));
  assert(selected(second) == [in_millimetres], Some(json_text(second)));
  assert(int(path(second, ["summary", "cached"])) == 1, Some(json_text(second)))
}
