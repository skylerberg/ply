//! A width crosses an entry's boundary as the tagged `Int` compiled code holds it, and reads back
//! as the width its signature, a field or a constructor says, however deep: a root entered with
//! typed values answers typed ones.

import harness (WorkingDirectory, Shipped, call, load_program, write_project, scratch,
                unload_program)
import cli.machine (default_options)
import std.machine as entering
import std.value (Value, VBool, VCtor, VFixed, VFn, VInt, VList, VRecord, VStr, ConstantFunction)

effect set MachineAccess = {entering::machine.open, entering::machine.bind, entering::machine.enter, entering::machine.unbind, entering::machine.close}

fn crosses() -> String = String::of_bytes_lossy(embed("../programs/boundary_widths/crosses.ply"))

fn width(ty: String, bits: U128) -> Value = VFixed(ty, bits)

fn u8(n: U128) -> Value = VFixed("U8", n)

fn sample(level: U128) -> Value =
  VRecord([{ name: "label", value: VStr("s") }, { name: "level", value: width("I16", level) }])

/// What each root answered for its arguments, in order.
fn call_results(
  calls: List<{ name: String, args: List<Value> }>,
) -> List<Result<Value, Bytes>> / {WorkingDirectory, Shipped, MachineAccess, abort.raise} = {
  write_project([{ path: "inner.ply", text: crosses() }]);
  let l = load_program(default_options());
  let returned = calls.map(|c: { name: String, args: List<Value> }|
    match call(l, c.name, c.args) { Ok(v) -> Ok(v), Err(d) -> Err(d.code) });
  let _ = unload_program(l);
  returned
}

test "a signature, a field, a list or a constructor naming a width returns it typed" {
  scratch(|| {
    let got = call_results([
      { name: "narrows", args: [VInt(7)] },
      { name: "widens", args: [width("U32", 7u128)] },
      { name: "boxed", args: [VInt(7)] },
      { name: "narrows#ensures#0", args: [VInt(7), width("U32", 7u128)] },
      { name: "narrows#ensures#0", args: [VInt(7), width("U32", 8u128)] },
      { name: "widens#requires#0", args: [width("U32", 0u128)] },
      // `-5i8` is the pattern 0xFB, and `-127i8` 0x81.
      { name: "negated", args: [width("I8", 0xFBu128)] },
      { name: "negated", args: [width("I8", 127u128)] },
      { name: "doubled", args: [width("U32", 3000000000u128)] },
      // Past `2^63`, where a `U64` is the runtime's own object rather than an immediate.
      { name: "flipped", args: [width("U64", 0xFFFF_FFFF_FFFF_FFFEu128)] },
      { name: "bytes", args: [VInt(3)] },
      { name: "summed", args: [VList([u8(200u128), u8(100u128)])] },
      // `-300i16` is the pattern 0xFED4.
      { name: "sample", args: [VInt(0 - 300)] },
      { name: "level", args: [sample(0xFED4u128)] },
      { name: "wrap", args: [u8(200u128)] },
      { name: "unwrap", args: [VCtor("inner.Byte", [u8(9u128)])] },
    ]);
    assert_eq(got, [
      Ok(width("U32", 7u128)),
      Ok(VInt(7)),
      Ok(VRecord([{ name: "w", value: width("U32", 7u128) }])),
      Ok(VBool(true)),
      Ok(VBool(false)),
      Ok(VBool(false)),
      Ok(width("I8", 5u128)),
      Ok(width("I8", 0x81u128)),
      Ok(width("U32", 1705032704u128)),
      Ok(width("U64", 0xFFFF_FFFF_FFFF_FFFFu128)),
      Ok(VList([u8(0u128), u8(100u128), u8(200u128)])),
      Ok(VInt(300)),
      Ok(sample(0xFED4u128)),
      Ok(width("I16", 0xFED4u128)),
      Ok(VCtor("inner.Byte", [u8(200u128)])),
      Ok(u8(9u128)),
    ])
  })
}

// A root is entered at the types its entry was built for: a generic one with every type variable an
// `Int`. A value of another type does not cross there, and a definition over a variable a
// constraint reads, or taking a function, has no entry.
test "a type variable is entered as an Int, and one a constraint reads has no entry" {
  scratch(|| {
    let got = call_results([
      { name: "first", args: [VList([VInt(5), VInt(6)])] },
      { name: "first", args: [VList([])] },
      { name: "first", args: [VList([u8(5u128)])] },
      { name: "made", args: [VFn(ConstantFunction({ arity: 0u8, value: VInt(3) }))] },
      { name: "total", args: [VList([VInt(2), VInt(3)])] },
      { name: "halved", args: [VInt(0 - 9)] },
    ]);
    assert_eq(got, [
      Ok(VCtor("Some", [VInt(5)])),
      Ok(VCtor("None", [])),
      Err(b"E0505"),
      Err(b"E0505"),
      Err(b"E0505"),
      Err(b"E0505"),
    ])
  })
}
