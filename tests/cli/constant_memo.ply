//! A nullary pure definition is a constant: its body runs once per unit, and every later read is
//! the memo's, which costs the entry that reads it no step. Counted by the steps each entry spent
//! and bounded by its step budget, never timed.

import harness (Here, Shipped, Loaded, entered, loaded, project, scratch, unloaded)
import cli.machine
import cli.machine (default_options)
import std.machine as entering
import std.value (Value, VInt)

effect set Driving = {entering::machine.open, entering::machine.bind, entering::machine.enter, entering::machine.unbind, entering::machine.close}

fn constants() -> String =
  \\effect store {
  \\  read peek() -> Int
  \\}
  \\
  \\fn main() -> Int = 0
  \\
  \\fn deep(n: Int) -> Int = if n <= 0 { 0 } else { 1 + deep(n - 1) }
  \\
  \\pub fn constant() -> Int = deep(700)
  \\
  \\pub fn parameterized(ignored: Int) -> Int = deep(700)
  \\
  \\// Performs nothing; the row is the published claim and is what decides this.
  \\pub fn over_declared() -> Int / {store.read} = deep(700)
  \\
  \\fn nest_constant(n: Int) -> Int = if n <= 0 { constant() } else { nest_constant(n - 1) + 0 }
  \\
  \\fn nest_parameterized(n: Int) -> Int =
  \\  if n <= 0 { parameterized(0) } else { nest_parameterized(n - 1) + 0 }
  \\
  \\fn nest_over_declared(n: Int) -> Int / {store.read} =
  \\  if n <= 0 { over_declared() } else { nest_over_declared(n - 1) + 0 }
  \\
  \\pub fn probe_constant(n: Int) -> Int = constant() + nest_constant(n)
  \\
  \\pub fn probe_parameterized(n: Int) -> Int = parameterized(0) + nest_parameterized(n)
  \\
  \\pub fn probe_over_declared(n: Int) -> Int / {store.read} =
  \\  over_declared() + nest_over_declared(n)
  \\
  \\pub fn reads(n: Int, sum: Int) -> Int = if n <= 0 { sum } else { reads(n - 1, sum + constant()) }
  \\
  \\pub fn reads_literal(n: Int, sum: Int) -> Int =
  \\  if n <= 0 { sum } else { reads_literal(n - 1, sum + 700) }
  \\

/// The program compiled, opened and bound, each entry within `steps` steps; none for no bound.
fn bound_within(steps: Int) -> Loaded / {Here, Shipped, Driving, abort.raise} = {
  project([{ path: "inner.ply", text: constants() }]);
  loaded({ ..default_options(), steps: steps })
}

/// What one entry answered, as an `Int` or the code it raised, and the steps it spent.
type Spent = { answer: Result<Int, Bytes>, steps: Int }

fn answered(l: Loaded, name: String, args: List<Value>) -> Spent / {Driving, abort.raise} = {
  let o = entered(l, name, args);
  {
    answer: match machine::answer_of(o.ended, l.roots, name) {
      Ok(VInt(i)) -> Ok(i),
      Ok(_) -> Err(b"not an Int"),
      Err(r) -> Err(r.diag.code),
    },
    steps: o.usage.steps,
  }
}

/// Within a budget the deep definition fits once and not twice: a remembered constant fits, and a
/// definition run again past its first answer is the budget's own refusal.
fn probed(name: String) -> Result<Int, Bytes> / {Here, Shipped, Driving, abort.raise} = {
  let l = bound_within(1500);
  let probe = answered(l, name, [VInt(400)]).answer;
  let _ = unloaded(l);
  probe
}

test "a nullary pure definition is evaluated once, whatever depth reads it again" {
  scratch(|| { assert_eq(probed("probe_constant"), Ok(1400)) })
}

test "a definition with a parameter is no constant, however dead the parameter is" {
  scratch(|| { assert_eq(probed("probe_parameterized"), Err(b"E0503")) })
}

test "a published row the body never performs keeps a definition from the memo" {
  scratch(|| { assert_eq(probed("probe_over_declared"), Err(b"E0503")) })
}

// Counted in calls: all `reads` spends beyond `reads_literal` is `constant`'s body, once.
test "a constant read a thousand times runs its body once" {
  scratch(|| {
    let l = bound_within(0);
    let first = answered(l, "constant", []);
    assert_eq(first.answer, Ok(700));
    assert(first.steps > 0, Some("no call of `constant`'s body was counted"));
    // A memo's answer costs the entry that reads it nothing.
    assert_eq(answered(l, "constant", []), { answer: Ok(700), steps: 0 });
    let looped = answered(l, "reads_literal", [VInt(1000), VInt(0)]);
    assert_eq(looped.answer, Ok(700000));
    let _ = unloaded(l);
    let fresh = bound_within(0);
    let read = answered(fresh, "reads", [VInt(1000), VInt(0)]);
    let _ = unloaded(fresh);
    assert_eq(read, { answer: Ok(700000), steps: looped.steps + first.steps })
  })
}

// A name the unit never compiled and a compiled one offered the wrong number of arguments are each
// declined before any body runs.
test "a declined call counts no steps" {
  scratch(|| {
    let l = bound_within(0);
    assert(answered(l, "parameterized", [VInt(0)]).steps > 0, Some("the call ran no body"));
    let absent = answered(l, "absent", []);
    assert(absent.answer != Ok(0), Some("an absent name answered"));
    let short = answered(l, "parameterized", []);
    assert(short.answer != Ok(700), Some("the wrong number of arguments answered"));
    let _ = unloaded(l);
    assert_eq((absent.steps, short.steps), (0, 0))
  })
}
