//! A nullary pure definition is a constant: its body runs once per unit, and every later read is
//! the memo's. Told by the clock with a wide margin each way: one run of the body takes a small part
//! of it, and the hundreds a definition run again at each read would take are far past it.

import harness (Here, Shipped, Loaded, entered, loaded, project, scratch, unloaded)
import cli.machine
import cli.machine (default_options)
import std.machine as entering
import std.value (Value, VInt)

effect set Driving = {entering::machine.open, entering::machine.bind, entering::machine.enter, entering::machine.unbind, entering::machine.close}

fn constants() -> String =
  \\effect store {
  \\  read peek() -> Int
  \\}
  \\
  \\fn main() -> Int = 0
  \\
  \\fn spin(n: Int, counted: Int) -> Int = if n <= 0 { counted } else { spin(n - 1, counted + 1) }
  \\
  \\pub fn constant() -> Int = spin(20000000, 0)
  \\
  \\pub fn parameterized(ignored: Int) -> Int = spin(20000000, 0)
  \\
  \\// Performs nothing; the row is the published claim and is what decides this.
  \\pub fn over_declared() -> Int / {store.read} = spin(20000000, 0)
  \\
  \\fn nest_constant(n: Int) -> Int = if n <= 0 { constant() } else { nest_constant(n - 1) + constant() }
  \\
  \\fn nest_parameterized(n: Int) -> Int =
  \\  if n <= 0 { parameterized(0) } else { nest_parameterized(n - 1) + parameterized(0) }
  \\
  \\fn nest_over_declared(n: Int) -> Int / {store.read} =
  \\  if n <= 0 { over_declared() } else { nest_over_declared(n - 1) + over_declared() }
  \\
  \\pub fn probe_constant(n: Int) -> Int = nest_constant(n)
  \\
  \\pub fn probe_parameterized(n: Int) -> Int = nest_parameterized(n)
  \\
  \\pub fn probe_over_declared(n: Int) -> Int / {store.read} = nest_over_declared(n)
  \\
  \\pub fn reads(n: Int, sum: Int) -> Int = if n <= 0 { sum } else { reads(n - 1, sum + constant()) }
  \\

/// What one run of a constant's body answers.
fn work() -> Int = 20000000

/// The milliseconds each entry may take.
fn clock_ms() -> Int = 3000

/// The program compiled, opened and bound, each entry under `clock_ms`.
fn bound() -> Loaded / {Here, Shipped, Driving, abort.raise} = {
  project([{ path: "inner.ply", text: constants() }]);
  loaded({ ..default_options(), timeout: clock_ms() })
}

/// What one entry answered, as an `Int`, or the code it ended with.
fn answered(
  l: Loaded,
  name: String,
  args: List<Value>,
) -> Result<Int, Bytes> / {Driving, abort.raise} =
  match machine::answer_of(entered(l, name, args), l.roots, name) {
    Ok(VInt(i)) -> Ok(i),
    Ok(_) -> Err(b"not an Int"),
    Err(r) -> Err(r.diag.code),
  }

/// `name` read at every depth from a thousand down: within the clock only where the body runs once.
fn probed(name: String) -> Result<Int, Bytes> / {Here, Shipped, Driving, abort.raise} = {
  let l = bound();
  let probe = answered(l, name, [VInt(1000)]);
  let _ = unloaded(l);
  probe
}

test "a nullary pure definition is evaluated once, whatever depth reads it again" {
  scratch(|| { assert_eq(probed("probe_constant"), Ok(1001 * work())) })
}

test "a definition with a parameter is no constant, however dead the parameter is" {
  scratch(|| { assert_eq(probed("probe_parameterized"), Err(b"W0612")) })
}

test "a published row the body never performs keeps a definition from the memo" {
  scratch(|| { assert_eq(probed("probe_over_declared"), Err(b"W0612")) })
}

test "a constant read a thousand times runs its body once" {
  scratch(|| {
    let l = bound();
    assert_eq(answered(l, "constant", []), Ok(work()));
    assert_eq(answered(l, "reads", [VInt(1000), VInt(0)]), Ok(1000 * work()));
    let _ = unloaded(l);
    let fresh = bound();
    let read = answered(fresh, "reads", [VInt(1000), VInt(0)]);
    let _ = unloaded(fresh);
    assert_eq(read, Ok(1000 * work()))
  })
}

// A name the unit never compiled and a compiled one offered the wrong number of arguments are each
// declined before any body runs.
test "a call of no definition, or with the wrong arguments, is declined" {
  scratch(|| {
    let l = bound();
    assert_eq(answered(l, "parameterized", [VInt(0)]), Ok(work()));
    let absent = answered(l, "absent", []);
    let short = answered(l, "parameterized", []);
    let _ = unloaded(l);
    assert(absent != Ok(0), Some("an absent name answered"));
    assert(short != Ok(work()), Some("the wrong number of arguments answered"))
  })
}
