//! A nullary pure definition is a constant: its body runs once per unit, and every later read is
//! the memo's. Told by the updates a run counts: each body writes an array in place, so a probe
//! that ran a body twice counts twice the writes of one run.

import harness (WorkingDirectory, Shipped, LoadedProgram, enter, load_program, write_project,
                scratch, unload_program)
import cli.machine
import cli.machine (default_options)
import std.machine as entering
import std.value (Value, VInt)

effect set MachineAccess = {entering::machine.open, entering::machine.bind, entering::machine.enter, entering::machine.unbind, entering::machine.close}

fn constants() -> String = String::of_bytes_lossy(embed("../programs/constant_memo/constants.ply"))

/// What a definition's body returns.
fn work() -> Int = 8

/// The program compiled, opened and bound.
fn bound() -> LoadedProgram / {WorkingDirectory, Shipped, MachineAccess, abort.raise} = {
  write_project([{ path: "inner.ply", text: constants() }]);
  load_program(default_options())
}

/// What one entry returned, as an `Int`, or the code it ended with, and the updates it counted.
fn ran(
  l: LoadedProgram,
  name: String,
  args: List<Value>,
) -> { result: Result<Int, Bytes>, updates: Int } / {MachineAccess, abort.raise} = {
  let o = enter(l, name, args);
  let result = match machine::result_of(o, l.roots, name) {
    Ok(VInt(i)) -> Ok(i),
    Ok(_) -> Err(b"not an Int"),
    Err(r) -> Err(r.diagnostic.code),
  };
  { result: result, updates: o.usage.updates }
}

/// What probe `name` returned, and how many times it ran a body: its updates over those of one run
/// of a body, which `parameterized`, no constant, runs at each entry.
fn probed(
  name: String,
) -> { result: Result<Int, Bytes>, runs: Int } / {WorkingDirectory, Shipped, MachineAccess, abort.raise} = {
  let l = bound();
  let once = ran(l, "parameterized", [VInt(0)]);
  let probe = ran(l, name, []);
  let _ = unload_program(l);
  assert(
    once.result == Ok(work()) && once.updates > 0,
    Some("one run of a body counts its writes"),
  );
  assert(probe.updates % once.updates == 0, Some("a probe counts whole runs of a body"));
  { result: probe.result, runs: probe.updates / once.updates }
}

test "a nullary pure definition is evaluated once, however often it is read" {
  scratch(|| { assert_eq(probed("probe_constant"), { result: Ok(2 * work()), runs: 1 }) })
}

test "a definition with a parameter is no constant, however dead the parameter is" {
  scratch(|| { assert_eq(probed("probe_parameterized"), { result: Ok(2 * work()), runs: 2 }) })
}

test "published effects the body never performs keep a definition out of the memo" {
  scratch(|| { assert_eq(probed("probe_over_declared"), { result: Ok(2 * work()), runs: 2 }) })
}

test "a constant read a thousand times runs its body once" {
  scratch(|| { assert_eq(probed("probe_reads"), { result: Ok(1000 * work()), runs: 1 }) })
}

// A name the unit never compiled and a compiled one offered the wrong number of arguments are each
// declined before any body runs.
test "a call of no definition, or with the wrong arguments, is declined" {
  scratch(|| {
    let l = bound();
    assert_eq(ran(l, "parameterized", [VInt(0)]).result, Ok(work()));
    let absent = ran(l, "absent", []).result;
    let short = ran(l, "parameterized", []).result;
    let _ = unload_program(l);
    assert(absent != Ok(0), Some("an absent name returned"));
    assert(short != Ok(work()), Some("the wrong number of arguments returned"))
  })
}
