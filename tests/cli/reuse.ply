import harness (PlyProcess, Server, completed_result, spawned, start_server, wait_for_exit)
import support.harness (RunResult, assert_ok, reused, stderr, value_of, write_program)
import std.string
import std.list

fn run(args: List<String>) -> RunResult / {PlyProcess, abort.raise} =
  spawned(["run", "."].concat(args))

fn explained(args: List<String>) -> RunResult / {PlyProcess, abort.raise} =
  run(["--json", "--explain"].concat(args))

fn schemas() -> String = String::of_bytes_lossy(embed("../programs/reuse/schemas.ply"))

test/nondet "a run with a different config schema does not reuse the cached result of another schema" {
  write_program(schemas());
  let with_schema = |schema: String| explained(["--config-schema", schema]);
  let first = with_schema("m.spec");
  assert_ok(first);
  assert(!reused(first), None);
  let again = with_schema("m.spec");
  assert(reused(again), None);
  assert(value_of(again).contains("us"), Some(value_of(again)));
  let other = with_schema("m.other");
  assert(!reused(other), Some("another schema's result was reused"));
  assert(value_of(other).contains("eu"), Some(value_of(other)));
  let absent = run(["--config-schema", "m.absent"]);
  assert(absent.code == 2, Some(stderr(absent)));
  assert(stderr(absent).contains("E0440"), Some(stderr(absent)))
}

test/nondet "two runs of one package at once both run it" {
  write_program("fn main() -> Int = 42\n");
  let one = start_server(["run", ".", "--json"], [], 0);
  let two = start_server(["run", ".", "--json"], [], 0);
  [one, two].fold((), |u: Unit, server: Server| {
    let out = completed_result(wait_for_exit(server, 120000, "`ply run` never ended"));
    assert_eq(value_of(out), "42")
  });
  assert(reused(explained([])), None)
}
