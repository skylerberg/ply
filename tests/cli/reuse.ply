//! `ply run` over sources stores its front end's results in the memo store, as a record of what its
//! load asked, and a later run over a tree where nothing that load read moved takes it and runs no
//! front end. `--explain` is how a test sees which it was; everything else a run says is the same
//! either way.

import harness (PlyProcess, RunResult, Server, write_project, write_program, write, read, spawned,
                start_server, wait_for_exit, completed_result, all_output, stderr, json_of, at,
                path, str, bool, json_text, WorkingDirectory, assert_ok, dependency, manifest,
                value_of)
import std.fs (fs, listed_names)
import std.json (Null, Array, Str)
import std.string
import std.list

fn run(args: List<String>) -> RunResult / {PlyProcess, abort.raise} = spawned(["run"].concat(args))

/// A run whose one document says whether its load was reused, and what `main` returned.
fn explained(args: List<String>) -> RunResult / {PlyProcess, abort.raise} =
  run(["--json", "--explain"].concat(args))

/// Whether the load of a run `explained` started took a result an earlier run stored.
fn reused(ran: RunResult) -> Bool / {abort.raise} = {
  let report = json_of(ran);
  if at(report, "front_end") == Null {
    panic("`--explain` said nothing about the load:\n" ++ all_output(ran))
  } else { bool(path(report, ["front_end", "reused"])) }
}

test/nondet "a second run of an unchanged package takes the result the first recorded" {
  write_program("fn main() -> Int = 42\n");
  let first = explained([]);
  assert(!reused(first), Some("a first run has nothing to reuse"));
  let second = explained([]);
  assert(reused(second), Some(all_output(second)));
  assert_eq(value_of(first), "42");
  assert_eq(value_of(second), "42")
}

// The document a run writes without `--explain`, compared whole: the reused result is placed over
// this run's own files, so nothing it reports can tell the two apart.
test/nondet "a reused load reports exactly what a built one reported" {
  write_program("fn main() -> Int = 42\n");
  let built = run(["--json"]);
  let again = run(["--json"]);
  assert(reused(explained([])), None);
  assert_eq(built, again);
  let document = json_of(again);
  assert(
    at(document, "files") == Array([Str("m.ply"), Str("<std>/prelude.ply")]),
    Some(json_text(document)),
  );
  assert(str(at(document, "value")) == "42", Some(json_text(document)));
  assert(at(document, "front_end") == Null, Some(json_text(document)))
}

// A raise is reported where it happened in the source a reader has open, and the reused result's
// spans are into this run's own files, so they read the same.
test/nondet "a raise on a reused load is placed where a built one placed it" {
  write_program(
    "fn boom() -> Int / {abort.raise} = panic(\"boom\")\n\nfn main() -> Int / {abort.raise} = boom() + 1\n",
  );
  let built = run([]);
  let again = explained([]);
  assert(reused(again), None);
  let after = run([]);
  assert(built.code == 1, Some(stderr(built)));
  assert(stderr(built).contains("raised at m.ply:1:"), Some(stderr(built)));
  assert_eq(built, after)
}

fn append_to(p: String, text: String) -> Unit / {WorkingDirectory, abort.raise} =
  match read(p) { Some(body) -> write(p, body ++ text), None -> panic("`" ++ p ++ "` reads") }

// app -> lib -> base, each a package of its own beside the others.
test/nondet "an edit to a module or a dependency runs the front end again, and one that moves no result does not" {
  write_project([
    { path: "app/ply.pkg", text: manifest("app", dependency("lib", "../lib")) },
    { path: "app/main.ply", text: "import lib.answer\nfn main() -> Int = answer::answer()\n" },
    { path: "lib/ply.pkg", text: manifest("lib", dependency("base", "../base")) },
    {
      path: "lib/answer.ply",
      text: "import base.deep\npub fn answer() -> Int = deep::deep() + 35\n",
    },
    { path: "base/ply.pkg", text: manifest("base", "") },
    { path: "base/deep.ply", text: "pub fn deep() -> Int = 7\n" },
  ]);
  let app = |expect_reused: Bool, value_is: String| {
    let out = explained(["app"]);
    assert(reused(out) == expect_reused, Some(all_output(out)));
    assert_eq(value_of(out), value_is)
  };
  app(false, "42");
  app(true, "42");
  write("base/deep.ply", "pub fn deep() -> Int = 8\n");
  app(false, "43");
  app(true, "43");
  append_to("lib/answer.ply", "\npub fn unused() -> Int = 0\n");
  app(false, "43");
  app(true, "43");
  // A comment in a manifest moves no judgment of the packages, so no result the load asked for.
  append_to("lib/ply.pkg", "// edited\n");
  app(true, "43");
  append_to("app/ply.pkg", "// edited\n");
  app(true, "43");
  write("app/main.ply", "import lib.answer\nfn main() -> Int = answer::answer() * 2\n");
  app(false, "86");
  app(true, "86")
}

fn schemas() -> String = String::of_bytes_lossy(embed("../programs/reuse/schemas.ply"))

// `--config-schema` is resolved against the result before the machine is handed it, so it is part
// of the key: a schema is never taken as checked on another schema's result.
test/nondet "another config schema takes nothing another schema recorded" {
  write_program(schemas());
  let with_schema = |schema: String| explained(["--config-schema", schema]);
  let first = with_schema("m.spec");
  assert_ok(first);
  assert(!reused(first), None);
  let again = with_schema("m.spec");
  assert(reused(again), None);
  assert(value_of(again).contains("us"), Some(value_of(again)));
  let other = with_schema("m.other");
  assert(!reused(other), Some("another schema's result was reused"));
  assert(value_of(other).contains("eu"), Some(value_of(other)));
  let absent = run(["--config-schema", "m.absent"]);
  assert(absent.code == 2, Some(stderr(absent)));
  assert(stderr(absent).contains("E0440"), Some(stderr(absent)))
}

// What the run grants and binds is this run's own, so a reused load is denied a grant exactly as a
// load that built its result is.
test/nondet "a reused load is granted and bound anew" {
  write_program("fn main() -> Int = 42\n");
  assert_ok(run([]));
  let hit = explained(["--allow", "machine"]);
  assert(reused(hit), None);
  write_program("fn main() -> Int = 42\n");
  let miss = run(["--json", "--allow", "machine"]);
  assert(miss.code == 2, Some(all_output(miss)));
  assert_eq(hit.code, miss.code);
  let rejection = |ran: RunResult| json_text(at(json_of(ran), "diagnostics"));
  assert(rejection(miss).contains("E0459"), Some(rejection(miss)));
  assert(
    rejection(hit) == rejection(miss),
    Some(
      "the reused load was rejected otherwise:\n" ++ rejection(hit) ++ "\n---\n" ++ rejection(miss),
    ),
  )
}

test/nondet "a single file is keyed and reused as a package is" {
  write_program("fn main() -> Int = 42\n");
  let first = explained(["m.ply"]);
  assert_ok(first);
  assert(!reused(first), None);
  let second = explained(["m.ply"]);
  assert(reused(second), None);
  assert_eq(value_of(second), "42")
}

// Two processes, so each files what it built while the other may be reading.
test/nondet "two runs of one package at once both run it" {
  write_program("fn main() -> Int = 42\n");
  let one = start_server(["run", "--json"], [], 0);
  let two = start_server(["run", "--json"], [], 0);
  [one, two].fold((), |u: Unit, server: Server| {
    let out = completed_result(wait_for_exit(server, 120000, "`ply run` never ended"));
    assert_eq(value_of(out), "42")
  });
  assert(reused(explained([])), None)
}

test/nondet "a cached result that does not read is built again and written over" {
  write_program("fn main() -> Int = 42\n");
  let first = explained([]);
  assert(!reused(first), Some(all_output(first)));
  let key = str(path(json_of(first), ["front_end", "key"]));
  // Every segment of the memo store cut to its first `to` bytes, and how many there were.
  let cut = |to: Int|
    List::fold(
      match listed_names(fs.list_dir[cwd](".ply-cache/memo")) { Some(names) -> names, None -> [] },
      0,
      |n: Int, name: String|
        if !name.starts_with("seg-") { n } else {
          let entry = ".ply-cache/memo/" ++ name;
          let whole = match fs.read_file[cwd](entry) { Some(b) -> b, None -> b"" };
          if !fs.write_file[cwd](entry, whole.slice(0, min(to, whole.len()))) {
            panic("a segment is torn")
          };
          n + 1
        },
    );
  if cut(9) == 0 { panic("the run cached its result in no segment") };
  let torn = explained([]);
  assert(!reused(torn), Some(all_output(torn)));
  assert_eq(value_of(torn), "42");
  let after = explained([]);
  assert(reused(after), Some(all_output(after)));
  assert_eq(str(path(json_of(after), ["front_end", "key"])), key);
  cut(0);
  assert(!reused(explained([])), None)
}
