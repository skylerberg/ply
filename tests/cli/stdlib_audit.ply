//! What a project can do to the shipped modules, and what an upgrade of them does to a project: no
//! project names a module under `std`, a project module beside a shipped one collides loudly, the
//! library imports nothing of the compiler, and a compiler that ships other modules re-runs exactly
//! what the change reached.

import harness (scratch, Ran, Source, project, in_memory, tree, over_tree, on_disk_shipping,
                on_disk_shipping_only, selected, said, json_of, at, items, first, str, shown,
                Hermetic, Shipped, assert_ok, StdModule, std_modules)
import compiler.syntax.items (is_shipped, is_std)
import compiler.syntax.exprs (prelude_module)
import std.json (Json)
import std.list
import std.string

fn codes_of(ran: Ran) -> List<String> / {abort.raise} =
  items(at(json_of(ran), "diagnostics")).map(|d: Json| str(at(d, "code")))

fn checked(files: List<Source>) -> Ran / {Hermetic, Shipped, abort.raise, diverges} =
  in_memory(tree(files), ["check", "--json"])

/// Every definition's or declaration's hash, by its program-wide name.
fn hash_of(answer: Json, name: String) -> String / {abort.raise} =
  match items(at(answer, "definitions")).filter(|d: Json| str(at(d, "name")) == name) {
    [d, ..] -> str(at(d, "hash")),
    [] -> panic("`" ++ name ++ "` is not in the program: " ++ shown(answer)),
  }

fn test_hash(answer: Json, key: String) -> String / {abort.raise} =
  match items(at(answer, "tests")).filter(|t: Json| str(at(t, "key")) == key) {
    [t, ..] -> str(at(t, "hash")),
    [] -> panic("no test `" ++ key ++ "`: " ++ shown(answer)),
  }

fn hashed(files: List<Source>) -> Json / {Hermetic, Shipped, abort.raise, diverges} =
  json_of(in_memory(tree(files), ["hash", "--json"]))

test "nothing a project can name lands under the reserved root" {
  // Every one of these derives a module name at or under `std` or `compiler`.
  [
    { rel: "std.ply", expected: "std" },
    { rel: "std/json.ply", expected: "std.json" },
    { rel: "std/net.ply", expected: "std.net" },
    { rel: "std/http/server.ply", expected: "std.http.server" },
    { rel: "compiler/front.ply", expected: "compiler.front" },
    { rel: "compiler/items.ply", expected: "compiler.items" },
    { rel: "compiler/fmt.ply", expected: "compiler.fmt" },
  ].fold((), |u: Unit, c: { rel: String, expected: String }| {
    let codes = codes_of(checked([{ path: c.rel, text: "pub fn f() -> Int = 1\n" }]));
    assert(
      codes.filter(|x: String| x == "E0133").len() > 0,
      Some(
        "`" ++ c.rel ++ "` would be `" ++ c.expected ++ "` and was accepted: "
          ++ String::join(codes, ", "),
      ),
    )
  });
  // Near misses keep working: reserving a prefix reserves no name that merely starts with it.
  ["stdlib.ply", "mine/std_helpers.ply", "a/std_thing.ply", "compilers.ply"].fold(
    (),
    |u: Unit, rel: String| {
      let r = checked([{ path: rel, text: "pub fn f() -> Int = 1\n" }]);
      assert(r.code == 0, Some("`" ++ rel ++ "` was refused: " ++ said(r)))
    },
  )
}

test "naming a file under std directly cannot smuggle it in as a std module" {
  let answer = json_of(
    in_memory(tree([{ path: "std/json.ply", text: "pub fn parse(x: Int) -> Int = x\n" }]), [
      "check",
      "std/json.ply",
      "--json",
    ]),
  );
  let own = items(at(answer, "modules")).map(|m: Json| str(at(m, "name"))).filter(|n: String|
    !is_std(Bytes::of_string(n)));
  assert(own == ["json"], Some("a file under `std/` became a `std` module: " ++ shown(answer)));
  assert(
    items(at(answer, "definitions")).filter(|d: Json| str(at(d, "name")) == "json.parse").len()
      == 1,
    Some(shown(answer)),
  )
}

test "a project module named net beside std.net is a loud collision" {
  let net = {
    path: "net.ply",
    text: "pub nondet effect net { read recv[r](conn: Int, max: Int) -> Bytes }\npub fn drain(c: Int, acc: Bytes) -> Bytes / {net.read[conn]} = acc\n",
  };
  let codes = codes_of(
    checked([
      net,
      { path: "app.ply", text: "import net\nimport std.net\npub fn f() -> Int = 1\n" },
    ]),
  );
  assert(
    codes.filter(|c: String| c == "E0110").len() > 0,
    Some("one of the two silently won: " ++ String::join(codes, ", ")),
  );
  // `as` is the escape hatch: the two `net` effects then produce atoms under different
  // program-wide names.
  let r = checked([
    net,
    {
      path: "app.ply",
      text: "import net as mine\nimport std.net\npub fn f(c: Int) -> Bytes / {mine::net.read[conn]} = mine::drain(c, b\"\")\n",
    },
  ]);
  assert(r.code == 0, Some("`as` disambiguates: " ++ said(r)));
  let f = first(
    items(at(json_of(r), "definitions")).filter(|d: Json| str(at(d, "name")) == "app.f"),
  );
  assert(
    items(at(f, "atoms")).map(str) == ["net.net.read[conn]"],
    Some("the project's effect and the shipped one are not distinct: " ++ shown(f)),
  )
}

/// A compiler of three modules, each importing the one before it.
fn over_a_compiler() -> List<Source> =
  [
    {
      path: "compiler.items.ply",
      text: "//! The shipped parser.\n\n/// What the shipped parser makes of `src`.\npub fn parse(src: Int) -> Int = src + 100\n",
    },
    {
      path: "compiler.fmt.ply",
      text: "//! The shipped formatter.\n\nimport compiler.items (parse)\n\n/// What the shipped formatter makes of `src`.\npub fn fmt_source(src: Int) -> Int = parse(src) + 1000\n",
    },
    {
      path: "compiler.syntax.ply",
      text: "//! Source as values.\n\nimport compiler.fmt (fmt_source)\n\n/// `src`, formatted.\npub fn formatted(src: Int) -> Int = fmt_source(src)\n",
    },
  ]

/// A project of modules named as that compiler's modules are below its prefix, each declaring what
/// the compiler's module of that name declares, beside one that calls them and the compiler's.
fn namesakes() -> List<Source> =
  [
    {
      path: "fmt.ply",
      text: "import items (parse)\n\npub fn fmt_source(src: Int) -> Int = parse(src) + 10\n",
    },
    { path: "items.ply", text: "pub fn parse(src: Int) -> Int = src\n" },
    {
      path: "app.ply",
      text:
        \\import compiler.syntax
        \\import fmt (fmt_source)
        \\import items (parse)
        \\
        \\pub fn mine() -> Int = fmt_source(1) + parse(2)
        \\
        \\test "the shipped modules answer as they do anywhere, and the project's are its own" {
        \\  assert_eq(mine(), 13);
        \\  assert_eq(syntax::formatted(1), 1101)
        \\}
        \\
    },
  ]

/// The module an `import` line names: `import std.list` names `std.list`.
fn imported(line: String) -> String / {abort.raise} = {
  let rest = line.slice(7, line.len());
  match rest.split_once(" ") { Some(x) -> x.head, None -> rest }
}

// A shipped module's import resolves among the shipped modules alone: a project can name no module
// under `std` or `compiler` (above), and every shipped module imports another by its full name.
test "no cycle can be built between a project and the shipped modules" {
  scratch(|| {
    let files = namesakes();
    project(files);
    assert_ok(on_disk_shipping_only(["test"], over_a_compiler()));
    // What each shipped definition references, as the load resolved it: none of the project's.
    let own = files.map(|f: Source| f.path.slice(0, f.path.len() - 4) ++ ".");
    let answer = json_of(on_disk_shipping_only(["hash", "--json", "--deps"], over_a_compiler()));
    let shipped = items(at(answer, "definitions")).filter(|d: Json|
      is_shipped(Bytes::of_string(str(at(d, "module")))));
    assert(shipped.len() == 3, Some("the load reached each shipped definition: " ++ shown(answer)));
    shipped.fold((), |u: Unit, d: Json|
      items(at(d, "deps")).fold(u, |v: Unit, dep: Json|
        assert(
          !own.any(|prefix: String| str(dep).starts_with(prefix)),
          Some(
            "the shipped `" ++ str(at(d, "name")) ++ "` references the project's `" ++ str(dep)
              ++ "`",
          ),
        )));
    assert(
      items(at(answer, "definitions")).filter(|d: Json| str(at(d, "name")) == "items.parse").len()
        == 1,
      Some("the project's own `items` is not its own: " ++ shown(answer)),
    )
  })
}

// The compiler depends on the library, so the library importing the compiler is a cycle.
test "{m.module} imports only library modules" for m: StdModule in std_modules() {
  String::of_bytes(m.src).split("\n").filter(|l: String| l.starts_with("import ")).fold(
    (),
    |u: Unit, l: String|
      assert(
        is_std(Bytes::of_string(imported(l))),
        Some(
          "`" ++ m.module ++ "` imports `" ++ imported(l) ++ "`, which the library does not hold",
        ),
      ),
  )
}

test "a definition that does not import std is unmoved by one that does" {
  let pure = {
    path: "pure.ply",
    text: "pub fn add(a: Int, b: Int) -> Int = a + b\ntest \"add\" { assert_eq(add(1, 2), 3) }\n",
  };
  let before = hashed([pure]);
  let after = hashed([
    pure,
    {
      path: "uses.ply",
      text: "import std.json\nimport std.net\npub fn zero() -> json::Json = json::Null\n",
    },
  ]);
  assert_eq(hash_of(before, "pure.add"), hash_of(after, "pure.add"));
  assert(
    test_hash(before, "pure.add") == test_hash(after, "pure.add"),
    Some("a test re-runs because an unrelated module imported `std`"),
  )
}

/// `std.net` as the compiler before this one shipped it: `edit` of what this one ships.
/// A shipped module a project's load would refuse were it to read its test, which does not parse,
/// or its helper only the test calls, which does not check; its law imports `std.laws`.
fn counted() -> Source =
  {
    path: "std.counted.ply",
    text: "//! Counting.\n\nimport std.laws (agrees)\n\n/// One more.\npub fn more(x: Int) -> Int = bump(x)\n\nfn bump(x: Int) -> Int = x + 1\n\nfn twice(x: Int) -> Int = \"two\"\n\ntest \"more adds one\" {\n  assert_eq(more(twice(1)) 3)\n}\n\nlaw \"more is bump\" = agrees(more, bump)\n",
  }

test "a project's load reads no test or law of a shipped module, nor what only they reach" {
  scratch(|| {
    project([
      {
        path: "m.ply",
        text: "import std.counted\n\n/// Two more.\npub fn two_more(x: Int) -> Int = counted::more(counted::more(x))\n",
      },
    ]);
    let ran = on_disk_shipping(["check", "--json"], [counted()]);
    assert_ok(ran);
    // Besides the module it imports, the load reads only the one every module imports.
    let report = json_of(ran);
    let prelude = String::of_bytes_lossy(prelude_module());
    let every = items(at(report, "modules")).filter(|m: Json| str(at(m, "name")) == prelude).map(
      |m: Json| str(at(m, "file")),
    );
    assert_eq(items(at(report, "files")).map(str), ["m.ply", "<std>/counted.ply"].concat(every))
  })
}

/// What a compiler ships when its one module's `one` answers `value`, with `trailer` after it.
fn shipping_one(value: String, trailer: String) -> List<Source> =
  [
    {
      path: "std.kept.ply",
      text: "//! A module the program imports.\n\n/// A small number.\npub fn one() -> Int = "
        ++ value
        ++ "\n"
        ++ trailer,
    },
  ]

/// A project with a test that reaches the shipped `one` and a test that reaches nothing shipped.
fn keeping() -> List<Source> =
  [
    {
      path: "app.ply",
      text: "import std.kept (one)\n\npub fn two() -> Int = one() + one()\n\ntest \"two\" { assert(two() > 0) }\n",
    },
    {
      path: "elsewhere.ply",
      text: "pub fn untouched() -> Int = 41 + 1\n\ntest \"untouched\" { assert_eq(untouched(), 42) }\n",
    },
  ]

test "an upgrade that moves no definition re-runs nothing" {
  scratch(|| {
    project(keeping());
    assert_ok(
      on_disk_shipping_only(["test"], shipping_one("1", "\n// what the last compiler shipped\n")),
    );
    let r = on_disk_shipping_only(["test"], shipping_one("1", ""));
    assert(
      said(r).contains("selected 0 of 2 (2 cached)"),
      Some("an upgrade that moved no definition re-ran a test:\n" ++ said(r)),
    )
  })
}

/// Each definition a `ply hash --json` answer lists, with its hash.
fn hashes(answer: Json) -> List<String> =
  items(at(answer, "definitions")).map(|d: Json| str(at(d, "name")) ++ " " ++ str(at(d, "hash")))

test "an upgrade that moved a definition re-runs the tests that reach it, and hashes as the new compiler does" {
  let older = shipping_one("2", "");
  let newer = shipping_one("1", "");
  let cold = over_tree(tree(keeping()), ||
    json_of(on_disk_shipping_only(["hash", "--json"], newer))).value;
  scratch(|| {
    project(keeping());
    assert_ok(on_disk_shipping_only(["test"], older));
    assert_eq(selected(json_of(on_disk_shipping_only(["test", "--json"], newer))), ["two"]);
    // A store written under the older module is believed for none of what the upgrade moved.
    assert_eq(hashes(json_of(on_disk_shipping_only(["hash", "--json"], newer))), hashes(cold))
  })
}
