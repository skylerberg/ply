//! Tagged literals as a load settles them: `tag"text"` is the call `tag::literal("text")`, run
//! before the program is, and a text its parser refuses is refused where the parser says, by every
//! command that would otherwise run it. One with holes is settled on its texts alone, by its tag's
//! `compile`, and its holes are its tag's `fill`'s when the program runs.

import harness (Source, Here, Spawned, assert_ok, at, codes, diagnostic, in_memory, int, json_of,
                kept_in_memory, nth, project, said, spawned, stdout, str, tree, value_of, write)
import std.fs
import std.json (Json)
import std.string

/// A tag: the number a text of hex digits spells, or the first character that is not one.
fn parser(digits: String) -> Source =
  {
    path: "hex.ply",
    text:
      \\pub type Refusal = { message: String, offset: Int }
      \\
      \\pub fn literal(text: String) -> Result<Int, Refusal> / {abort.raise} =
      \\  range(0, text.len()).fold(Ok(0), |read: Result<Int, Refusal>, i: Int|
      \\    match read {
      \\      Err(_) -> read,
      \\      Ok(n) -> {
      \\        let digit = text.slice(i, i + 1);
      \\        if digits().contains(digit) { Ok(n * 16 + digits().find(digit)) }
      \\        else { Err({ message: "not a hex digit", offset: i }) }
      \\      },
      \\    })
      \\
      \\fn digits() -> String = "
      ++ digits
      ++ "\"\n",
  }

fn hex() -> Source = parser("0123456789abcdef")

fn holding(body: String) -> Source =
  { path: "m.ply", text: "import hex\n\nfn main() -> Int = " ++ body ++ "\n" }

fn checked(files: List<Source>) -> Json / {Spawned, Here, abort.raise} = {
  project(files);
  json_of(spawned(["check", "--json"]))
}

/// A module `tag` holding `text`, and a `main` that writes one `tag"abc"`.
fn tagged(text: String) -> List<Source> =
  [
    { path: "tag.ply", text: text },
    { path: "m.ply", text: "import tag\n\nfn main() -> Int = tag\"abc\"\n" },
  ]

fn refusal() -> String = "Result<Int, { message: String, offset: Int }>"

test/nondet "a literal its parser accepts is its value, and performs nothing" {
  project([hex(), holding("hex\"ff\" + hex\"0a\"")]);
  assert_ok(spawned(["check"]));
  assert_eq(value_of(spawned(["run", "--json"])), "265");
  let types = stdout(spawned(["check", "--types"]));
  match types.split_once("   m m.ply") {
    None -> panic("no heading for `m` in:\n" ++ types),
    Some(cut) -> {
      assert(cut.tail.contains("main : () -> Int"), Some(types));
      assert(!cut.tail.contains("abort"), Some(types))
    },
  }
}

test/nondet "a literal its parser refuses is a check error at the place in its text" {
  project([hex(), holding("hex\"1\\u{66}g0\"")]);
  let ran = spawned(["check", "--json"]);
  assert_eq(ran.code, 2);
  let v = json_of(ran);
  assert_eq(codes(v), ["E0153"]);
  let label = nth(at(diagnostic(v), "labels"), 0);
  assert_eq(str(at(label, "message")), "not a hex digit");
  assert_eq(str(at(label, "file")), "m.ply");
  assert_eq(int(at(at(label, "start"), "line")), 3);
  // Past the escape, which is one character of the text and six of the source.
  assert_eq(int(at(at(label, "start"), "col")), 31);
  assert_eq(int(at(at(label, "end"), "col")), 32)
}

test/nondet "a text that ends too soon is refused at its closing quote" {
  let tag =
    \\pub fn literal(text: String) -> Result<Int, { message: String, offset: Int }> / {abort.raise} =
    \\  if text.len() < 4 { Err({ message: "four characters", offset: text.len() }) }
    \\  else { Ok(4) }
    \\
  ;
  let v = checked(tagged(tag));
  assert_eq(codes(v), ["E0153"]);
  let label = nth(at(diagnostic(v), "labels"), 0);
  assert_eq(int(at(at(label, "start"), "col")), 27);
  assert_eq(str(at(label, "snippet")), "\"")
}

test/nondet "every command that would run a literal refuses the one a check refuses" {
  project([hex(), holding("hex\"xyz\"")]);
  [["run"], ["test"], ["prove"], ["build", ".", "-o", "m.plyx"]].fold(
    (),
    |_: Unit, line: List<String>| {
      let ran = spawned(line);
      assert_eq(ran.code, 2);
      assert(said(ran).contains("E0153"), Some(said(ran)))
    },
  )
}

test/nondet "an artifact holds a tagged literal as it is written, and runs to its value" {
  project([hex(), holding("hex\"ff\" + hex\"0a\"")]);
  assert_ok(spawned(["build", ".", "-o", "m.plyx"]));
  assert_eq(value_of(spawned(["run", "--json", "m.plyx"])), "265")
}

test/nondet "a refused literal is refused again by a check that reads its module's stub" {
  project([hex(), holding("hex\"xyz\"")]);
  assert_eq(spawned(["check", "--explain"]).code, 2);
  let second = spawned(["check", "--explain"]);
  assert_eq(second.code, 2);
  assert(said(second).contains("E0153"), Some(said(second)));
  assert_eq(spawned(["check"]).code, 2)
}

test/nondet "a literal is checked again when its parser moves, and answered as it was while it stands" {
  project([hex(), holding("hex\"ff\"")]);
  assert_ok(spawned(["check"]));
  let narrowed = parser("0123456789");
  write(narrowed.path, narrowed.text);
  assert_eq(codes(json_of(spawned(["check", "--json"]))), ["E0153"]);
  write(hex().path, hex().text);
  assert_ok(spawned(["check", "--explain"]));
  assert_ok(spawned(["check", "--explain"]))
}

test/nondet "a literal checked before is refused once its module binds `Ok` or its parser changes shape" {
  let holder = "import tag\n\nfn main() -> Int = tag\"abc\"\n";
  // Each edit is made to the project as its first check left it.
  let checked_once = || {
    project([
      { path: "tag.ply", text: "pub fn literal(text: String) -> " ++ refusal() ++ " = Ok(1)\n" },
      { path: "m.ply", text: holder },
    ]);
    assert_ok(spawned(["check", "--explain"]))
  };
  checked_once();
  write("m.ply", holder ++ "\ntype Mine = | Ok(Int) | No\n");
  assert_eq(codes(json_of(spawned(["check", "--json"]))), ["E0118"]);
  checked_once();
  write("tag.ply", "pub fn literal(text: String) -> Option<Int> = Some(1)\n");
  assert_eq(codes(json_of(spawned(["check", "--json"]))), ["E0152"])
}

/// A raise and what raises it, for a module that answers the raise around a literal.
fn raising() -> String =
  \\effect p { raise bad(n: Int) }
  \\
  \\fn g(n: Int) -> Int / {p.bad} = if n > 0 { n } else { p.bad(n) }
  \\
  \\

test "a `try` checked before is refused once its module binds `Ok`, as a literal is" {
  let tried = raising() ++ "pub fn f(n: Int) -> Result<Int, Int> = try { g(n) }\n";
  let first = kept_in_memory(
    tree([
      { path: "lib.ply", text: tried },
      {
        path: "m.ply",
        text: "import lib\n\nfn main() -> Int = match lib::f(3) { Ok(n) -> n, Err(e) -> e }\n",
      },
    ]),
    ["check", "--explain"],
    [],
    None,
  );
  assert_ok(first.ran);
  let bound = fs::mem_write(
    first.tree,
    "w/lib.ply",
    Bytes::of_string(tried ++ "\npub type Mine = | Ok(Int) | No\n\npub fn mine() -> Mine = No\n"),
  ).fs;
  assert_eq(codes(json_of(in_memory(bound, ["check", "--json"]))), ["E0118"])
}

test/nondet "a literal in a `try` body or a handler clause is settled as any other is" {
  let within = |main: String|
    [hex(), { path: "m.ply", text: "import hex\n\n" ++ raising() ++ main ++ "\n" }];
  let tried = |text: String|
    within("fn main() -> Int = match try { g(hex\"" ++ text ++ "\") } { Ok(n) -> n, Err(_) -> 0 }");
  let handled = |text: String|
    within("fn main() -> Int = handle { g(0) } with { p.bad(n) -> hex\"" ++ text ++ "\" }");
  project(tried("ff"));
  assert_eq(value_of(spawned(["run", "--json"])), "255");
  project(handled("0a"));
  assert_eq(value_of(spawned(["run", "--json"])), "10");
  assert_eq(codes(checked(tried("fg"))), ["E0153"]);
  assert_eq(codes(checked(handled("0g"))), ["E0153"])
}

test/nondet "a literal whose parser answers a `new` record is that record, and refused where it is none" {
  let holding = |text: String|
    [
      {
        path: "m.ply",
        text: "import std.uuid\nimport std.uuid (Uuid)\n\nfn id() -> Uuid = uuid\"" ++ text
          ++ "\"\n\nfn main() -> Int = id().octets.len()\n",
      },
    ];
  project(holding("6ba7b810-9dad-11d1-80b4-00c04fd430c8"));
  assert_eq(value_of(spawned(["run", "--json"])), "16");
  let v = checked(holding("6ba7b810-9dad-11d1-80b4-00c04fd430cZ"));
  assert_eq(codes(v), ["E0153"]);
  assert_eq(str(at(nth(at(diagnostic(v), "labels"), 0), "message")), "not a hex digit")
}

test/nondet "a parser that raises leaves a literal undecided" {
  let raising = checked(
    tagged("pub fn literal(text: String) -> " ++ refusal() ++ " / {abort.raise} = panic(\"no\")\n"),
  );
  assert_eq(codes(raising), ["E0154"]);
  assert(str(at(diagnostic(raising), "message")).contains("raised on this literal: panic"))
}

test/nondet "a tag whose `literal` is no parser a check can run is refused where the literal is" {
  let shaped = checked(tagged("pub fn literal(text: String) -> Option<Int> = Some(1)\n"));
  assert_eq(codes(shaped), ["E0152"]);
  assert(str(at(diagnostic(shaped), "message")).contains("(String) -> Option<Int>"));
  let performing =
    \\pub effect ticks { read now() -> Int }
    \\
    \\pub fn literal(text: String) -> Result<Int, { message: String, offset: Int }> / {ticks.now} =
    \\  Ok(ticks.now())
    \\
  ;
  let impure = checked([
    { path: "tag.ply", text: performing },
    { path: "m.ply", text: "import tag\n\nfn main() -> Int / {tag::ticks.now} = tag\"abc\"\n" },
  ]);
  assert_eq(codes(impure), ["E0152"]);
  assert(str(at(diagnostic(impure), "message")).contains("performs `{tag.ticks.now}`"));
  let generic = checked(
    tagged(
      "pub fn literal<a>(text: String) -> Result<List<a>, { message: String, offset: Int }> = Ok([])\n",
    ),
  );
  assert(str(at(diagnostic(generic), "message")).contains("parameters of its own"));
  let taking = checked(
    tagged("pub fn literal(text: String, strict: Bool = false) -> " ++ refusal() ++ " = Ok(1)\n"),
  );
  assert_eq(codes(taking), ["E0152"])
}

test/nondet "a tag is a module binder, and its `literal` a public function of that module" {
  assert_eq(codes(checked(tagged("pub fn other() -> Int = 1\n"))), ["E0101"]);
  assert_eq(codes(checked(tagged("fn literal(text: String) -> " ++ refusal() ++ " = Ok(1)\n"))), [
    "E0107",
  ]);
  assert_eq(codes(checked([{ path: "m.ply", text: "fn main() -> Int = tag\"abc\"\n" }])), ["E0106"])
}

test/nondet "a module that binds its own `Ok` holds no tagged literal" {
  let files = [
    { path: "tag.ply", text: "pub fn literal(text: String) -> " ++ refusal() ++ " = Ok(1)\n" },
    {
      path: "m.ply",
      text: "import tag\n\ntype Mine = | Ok(Int) | No\n\nfn main() -> Int = tag\"abc\"\n",
    },
  ];
  assert_eq(codes(checked(files)), ["E0118"])
}

/// A tag with holes: its texts are refused at a `!`, and a literal is how many texts and holes it
/// has, each hole of the type `hole`.
fn counting(hole: String) -> Source =
  {
    path: "count.ply",
    text:
      \\pub type Refusal = { message: String, offset: Int, part: Int }
      \\
      \\pub fn compile(parts: List<String>) -> Result<List<String>, Refusal> / {abort.raise} =
      \\  range(0, parts.len()).fold(Ok(parts), |read: Result<List<String>, Refusal>, part: Int|
      \\    match ((read, parts.at(part))) {
      \\      (Ok(_), Some(text)) -> if !text.contains("!") { read } else {
      \\        Err({ message: "no `!` in a count", offset: text.find("!"), part: part })
      \\      },
      \\      _ -> read,
      \\    })
      \\
      \\pub fn fill(parts: List<String>, holes: List<
      ++ hole
      ++ ">) -> Int = parts.len() + holes.len()\n",
  }

fn counted(body: String) -> Source =
  { path: "m.ply", text: "import count\n\nfn main() -> Int = " ++ body ++ "\n" }

test/nondet "a literal with holes is its tag's `fill` of what `compile` answered, and of its holes" {
  project([counting("Int"), counted("count\"a {1} b{2 + 3}{{}}\" + count\"{4}\"")]);
  assert_ok(spawned(["check"]));
  assert_eq(value_of(spawned(["run", "--json"])), "8")
}

test/nondet "a text its tag refuses is a check error in that text, a brace of it one character" {
  let v = checked([counting("Int"), counted("count\"ab {1} {{c!{2}\"")]);
  assert_eq(codes(v), ["E0153"]);
  assert(str(at(diagnostic(v), "message")).contains("`count::compile` refuses"));
  let label = nth(at(diagnostic(v), "labels"), 0);
  assert_eq(str(at(label, "message")), "no `!` in a count");
  assert_eq(str(at(label, "snippet")), "!");
  assert_eq(int(at(at(label, "start"), "line")), 3);
  assert_eq(int(at(at(label, "start"), "col")), 36)
}

test/nondet "a hole of another type than its tag's is refused at the hole" {
  let v = checked([counting("Int"), counted("count\"a {1} b{\"two\"}\"")]);
  assert_eq(codes(v), ["E0201"]);
  let label = nth(at(diagnostic(v), "labels"), 0);
  assert_eq(str(at(label, "snippet")), "\"two\"");
  assert_eq(int(at(at(label, "start"), "col")), 34)
}

test/nondet "a literal with holes checked before is refused once its tag takes another hole or its module binds `Ok`" {
  let holder = counted("count\"a {1}\"");
  // Each edit is made to the project as its first check left it.
  let checked_once = || {
    project([counting("Int"), holder]);
    assert_ok(spawned(["check", "--explain"]))
  };
  checked_once();
  write("count.ply", counting("String").text);
  assert_eq(codes(json_of(spawned(["check", "--json"]))), ["E0201"]);
  checked_once();
  write("m.ply", counted("count\"a! {1}\"").text);
  assert_eq(codes(json_of(spawned(["check", "--json"]))), ["E0153"]);
  assert_eq(spawned(["check"]).code, 2);
  checked_once();
  write("m.ply", holder.text ++ "\ntype Mine = | Ok(Int) | No\n");
  assert_eq(codes(json_of(spawned(["check", "--json"]))), ["E0118"])
}

test/nondet "a tag with holes declares a `compile` and a `fill` a literal can call" {
  let lone = |text: String| checked([{ path: "count.ply", text: text }, counted("count\"a {1}\"")]);
  let compiling = "pub fn compile(parts: List<String>) -> Result<Int, { message: String, offset: Int, part: Int }> = Ok(1)\n";
  assert_eq(codes(lone("pub fn literal(text: String) -> " ++ refusal() ++ " = Ok(1)\n")), [
    "E0101",
  ]);
  assert_eq(codes(lone(compiling)), ["E0101"]);
  let misfilled = lone(compiling ++ "pub fn fill(c: String, holes: List<Int>) -> Int = 1\n");
  assert_eq(codes(misfilled), ["E0152"]);
  assert(str(at(diagnostic(misfilled), "message")).contains("`count::fill` has type"));
  let unplaced = lone(
    "pub fn compile(parts: List<String>) -> " ++ refusal() ++ " = Ok(1)\n"
      ++ "pub fn fill(c: Int, holes: List<Int>) -> Int = c\n",
  );
  assert_eq(codes(unplaced), ["E0152"]);
  assert(str(at(diagnostic(unplaced), "message")).contains("`count::compile` has type"));
  let performing = lone(
    compiling ++ "pub effect ticks { read now() -> Int }\n"
      ++ "pub fn fill(c: Int, holes: List<Int>) -> Int / {ticks.now} = ticks.now()\n",
  );
  assert_eq(codes(performing), ["E0152"]);
  assert(str(at(diagnostic(performing), "message")).contains("`count::fill` performs"));
  let generic = lone(compiling ++ "pub fn fill<a>(c: Int, holes: List<a>) -> Int = c\n");
  assert(str(at(diagnostic(generic), "message")).contains("parameters of its own"))
}

test/nondet "an artifact holds a literal with holes as it is written, and every command refuses a refused one" {
  project([counting("Int"), counted("count\"a {{b}} {1}\\\"{count\"{2}\"}\"")]);
  assert_ok(spawned(["build", ".", "-o", "m.plyx"]));
  assert_eq(value_of(spawned(["run", "--json", "m.plyx"])), "5");
  project([counting("Int"), counted("count\"a! {1}\"")]);
  [["run"], ["test"], ["prove"], ["build", ".", "-o", "m.plyx"]].fold(
    (),
    |_: Unit, line: List<String>| {
      let ran = spawned(line);
      assert_eq(ran.code, 2);
      assert(said(ran).contains("E0153"), Some(said(ran)))
    },
  )
}
