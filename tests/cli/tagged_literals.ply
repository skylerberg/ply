import spawning.harness (Source, WorkingDirectory, PlyProcess, assert_ok, at, diagnostic_codes,
                         diagnostic, int, json_of, nth, write_project, all_output, spawned, stdout,
                         str, value_of, write)
import std.fs
import std.json (Json)
import std.string

fn parser(digits: String) -> Source =
  {
    path: "hex.ply",
    text:
      \\pub type Refusal = { message: String, offset: Int }
      \\
      \\pub fn literal(text: String) -> Result<Int, Refusal> / {abort.raise} =
      \\  range(0, text.len()).fold(Ok(0), |read: Result<Int, Refusal>, i: Int|
      \\    match read {
      \\      Err(_) -> read,
      \\      Ok(n) -> {
      \\        let digit = text.slice(i, i + 1);
      \\        if digits().contains(digit) { Ok(n * 16 + digits().find(digit)) }
      \\        else { Err({ message: "not a hex digit", offset: i }) }
      \\      },
      \\    })
      \\
      \\fn digits() -> String = "
      ++ digits
      ++ "\"\n",
  }

const hex: Source = parser("0123456789abcdef")

fn main_module(body: String) -> Source =
  { path: "m.ply", text: "import hex\n\nfn main() -> Int = " ++ body ++ "\n" }

fn checked(files: List<Source>) -> Json / {PlyProcess, WorkingDirectory, abort.raise} = {
  write_project(files);
  json_of(spawned(["check", ".", "--json"]))
}

fn tagged(text: String) -> List<Source> =
  [
    { path: "tag.ply", text: text },
    { path: "m.ply", text: "import tag\n\nfn main() -> Int = tag\"abc\"\n" },
  ]

const parse_result_type: String = "Result<Int, { message: String, offset: Int }>"

test/nondet "a tagged literal that its tag's parser accepts evaluates to its value without running any effect" {
  write_project([hex, main_module("hex\"ff\" + hex\"0a\"")]);
  assert_ok(spawned(["check", "."]));
  assert_eq(value_of(spawned(["run", ".", "--json"])), "265");
  let types = stdout(spawned(["check", ".", "--types"]));
  match types.split_once("   m m.ply") {
    None -> panic("no heading for `m` in:\n" ++ types),
    Some(cut) -> {
      assert(cut.tail.contains("main : () -> Int"), Some(types));
      assert(!cut.tail.contains("abort"), Some(types))
    },
  }
}

test/nondet "a tagged literal that its tag's parser rejects is a check error pointing at the position inside the literal's text" {
  write_project([hex, main_module("hex\"1\\u{66}g0\"")]);
  let ran = spawned(["check", ".", "--json"]);
  assert_eq(ran.code, 2);
  let v = json_of(ran);
  assert_eq(diagnostic_codes(v), ["E0153"]);
  let label = nth(at(diagnostic(v), "labels"), 0);
  assert_eq(str(at(label, "message")), "not a hex digit");
  assert_eq(str(at(label, "file")), "m.ply");
  assert_eq(int(at(at(label, "start"), "line")), 3);
  assert_eq(int(at(at(label, "start"), "col")), 31);
  assert_eq(int(at(at(label, "end"), "col")), 32)
}

test/nondet "a text that ends too soon is rejected at its closing quote" {
  let tag =
    \\pub fn literal(text: String) -> Result<Int, { message: String, offset: Int }> / {abort.raise} =
    \\  if text.len() < 4 { Err({ message: "four characters", offset: text.len() }) }
    \\  else { Ok(4) }
    \\
  ;
  let v = checked(tagged(tag));
  assert_eq(diagnostic_codes(v), ["E0153"]);
  let label = nth(at(diagnostic(v), "labels"), 0);
  assert_eq(int(at(at(label, "start"), "col")), 27);
  assert_eq(str(at(label, "snippet")), "\"")
}

test/nondet "`run`, `test`, `prove` and `build` all reject a tagged literal that `check` rejects" {
  write_project([hex, main_module("hex\"xyz\"")]);
  [["run", "."], ["test", "."], ["prove", "."], ["build", ".", "-o", "m.plyx"]].fold(
    (),
    |_: Unit, line: List<String>| {
      let ran = spawned(line);
      assert_eq(ran.code, 2);
      assert(all_output(ran).contains("E0153"), Some(all_output(ran)))
    },
  )
}

test/nondet "a built artifact stores a tagged literal as written in the source, and running it gives the literal's value" {
  write_project([hex, main_module("hex\"ff\" + hex\"0a\"")]);
  assert_ok(spawned(["build", ".", "-o", "m.plyx"]));
  assert_eq(value_of(spawned(["run", "--json", "m.plyx"])), "265")
}

test/nondet "a rejected literal is rejected again by a check that reads its module's stub" {
  write_project([hex, main_module("hex\"xyz\"")]);
  assert_eq(spawned(["check", ".", "--explain"]).code, 2);
  let second = spawned(["check", ".", "--explain"]);
  assert_eq(second.code, 2);
  assert(all_output(second).contains("E0153"), Some(all_output(second)));
  assert_eq(spawned(["check", "."]).code, 2)
}

test/nondet "a tagged literal is checked again when its tag's parser changes, and a cached result is reused while the parser stays the same" {
  write_project([hex, main_module("hex\"ff\"")]);
  assert_ok(spawned(["check", "."]));
  let narrowed = parser("0123456789");
  write(narrowed.path, narrowed.text);
  assert_eq(diagnostic_codes(json_of(spawned(["check", ".", "--json"]))), ["E0153"]);
  write(hex.path, hex.text);
  assert_ok(spawned(["check", ".", "--explain"]));
  assert_ok(spawned(["check", ".", "--explain"]))
}

test/nondet "a tagged literal that passed a check is rejected after its module defines its own `Ok` or its tag's parser changes its return type" {
  let holder = "import tag\n\nfn main() -> Int = tag\"abc\"\n";
  let checked_once = || {
    write_project([
      {
        path: "tag.ply",
        text: "pub fn literal(text: String) -> " ++ parse_result_type ++ " = Ok(1)\n",
      },
      { path: "m.ply", text: holder },
    ]);
    assert_ok(spawned(["check", ".", "--explain"]))
  };
  checked_once();
  write("m.ply", holder ++ "\ntype Mine = | Ok(Int) | No\n");
  assert_eq(diagnostic_codes(json_of(spawned(["check", ".", "--json"]))), ["E0118"]);
  checked_once();
  write("tag.ply", "pub fn literal(text: String) -> Option<Int> = Some(1)\n");
  assert_eq(diagnostic_codes(json_of(spawned(["check", ".", "--json"]))), ["E0152"])
}

fn raising() -> String =
  \\effect p { raise bad(n: Int) }
  \\
  \\fn g(n: Int) -> Int / {p.bad} = if n > 0 { n } else { p.bad(n) }
  \\
  \\

test/nondet "a tagged literal inside a `try` body or a handler clause is checked and evaluated like a literal anywhere else" {
  let within = |main: String|
    [hex, { path: "m.ply", text: "import hex\n\n" ++ raising() ++ main ++ "\n" }];
  let tried = |text: String|
    within("fn main() -> Int = match try { g(hex\"" ++ text ++ "\") } { Ok(n) -> n, Err(_) -> 0 }");
  let handled = |text: String|
    within("fn main() -> Int = handle { g(0) } with { p.bad(n) -> hex\"" ++ text ++ "\" }");
  write_project(tried("ff"));
  assert_eq(value_of(spawned(["run", ".", "--json"])), "255");
  write_project(handled("0a"));
  assert_eq(value_of(spawned(["run", ".", "--json"])), "10");
  assert_eq(diagnostic_codes(checked(tried("fg"))), ["E0153"]);
  assert_eq(diagnostic_codes(checked(handled("0g"))), ["E0153"])
}

test/nondet "a tagged literal whose parser returns a `new` record evaluates to that record, and is rejected when the text is invalid" {
  let main_module = |text: String|
    [
      {
        path: "m.ply",
        text: "import std.uuid\nimport std.uuid (Uuid)\n\nfn id() -> Uuid = uuid\"" ++ text
          ++ "\"\n\nfn main() -> Int = id().octets.len()\n",
      },
    ];
  write_project(main_module("6ba7b810-9dad-11d1-80b4-00c04fd430c8"));
  assert_eq(value_of(spawned(["run", ".", "--json"])), "16");
  let v = checked(main_module("6ba7b810-9dad-11d1-80b4-00c04fd430cZ"));
  assert_eq(diagnostic_codes(v), ["E0153"]);
  assert_eq(str(at(nth(at(diagnostic(v), "labels"), 0), "message")), "not a hex digit")
}

test/nondet "a tag parser that raises an error while checking leaves the literal unchecked and reports an error" {
  let raising = checked(
    tagged(
      "pub fn literal(text: String) -> " ++ parse_result_type
        ++ " / {abort.raise} = panic(\"no\")\n",
    ),
  );
  assert_eq(diagnostic_codes(raising), ["E0154"]);
  assert(str(at(diagnostic(raising), "message")).contains("raised on this literal: panic"))
}

test/nondet "a tag whose `literal` function is not a pure parser returning `Result` is rejected where the tagged literal is used" {
  let shaped = checked(tagged("pub fn literal(text: String) -> Option<Int> = Some(1)\n"));
  assert_eq(diagnostic_codes(shaped), ["E0152"]);
  assert(str(at(diagnostic(shaped), "message")).contains("(String) -> Option<Int>"));
  let performing =
    \\pub effect ticks { read now() -> Int }
    \\
    \\pub fn literal(text: String) -> Result<Int, { message: String, offset: Int }> / {ticks.now} =
    \\  Ok(ticks.now())
    \\
  ;
  let impure = checked([
    { path: "tag.ply", text: performing },
    { path: "m.ply", text: "import tag\n\nfn main() -> Int / {tag::ticks.now} = tag\"abc\"\n" },
  ]);
  assert_eq(diagnostic_codes(impure), ["E0152"]);
  assert(str(at(diagnostic(impure), "message")).contains("performs `{tag.ticks.now}`"));
  let generic = checked(
    tagged(
      "pub fn literal<a>(text: String) -> Result<List<a>, { message: String, offset: Int }> = Ok([])\n",
    ),
  );
  assert(str(at(diagnostic(generic), "message")).contains("takes type parameters"));
  let taking = checked(
    tagged(
      "pub fn literal(text: String, strict: Bool = false) -> " ++ parse_result_type ++ " = Ok(1)\n",
    ),
  );
  assert_eq(diagnostic_codes(taking), ["E0152"])
}

test/nondet "a tag must be an imported module, and that module must export a public function named `literal`" {
  assert_eq(diagnostic_codes(checked(tagged("pub fn other() -> Int = 1\n"))), ["E0101"]);
  assert_eq(
    diagnostic_codes(
      checked(tagged("fn literal(text: String) -> " ++ parse_result_type ++ " = Ok(1)\n")),
    ),
    ["E0107"],
  );
  assert_eq(
    diagnostic_codes(checked([{ path: "m.ply", text: "fn main() -> Int = tag\"abc\"\n" }])),
    ["E0106"],
  )
}

test/nondet "a tagged literal in a module that defines its own `Ok` is rejected" {
  let files = [
    {
      path: "tag.ply",
      text: "pub fn literal(text: String) -> " ++ parse_result_type ++ " = Ok(1)\n",
    },
    {
      path: "m.ply",
      text: "import tag\n\ntype Mine = | Ok(Int) | No\n\nfn main() -> Int = tag\"abc\"\n",
    },
  ];
  assert_eq(diagnostic_codes(checked(files)), ["E0118"])
}

fn counting(hole: String) -> Source =
  {
    path: "count.ply",
    text:
      \\pub type Refusal = { message: String, offset: Int, part: Int }
      \\
      \\pub fn compile(parts: List<String>) -> Result<List<String>, Refusal> / {abort.raise} =
      \\  range(0, parts.len()).fold(Ok(parts), |read: Result<List<String>, Refusal>, part: Int|
      \\    match ((read, parts.at(part))) {
      \\      (Ok(_), Some(text)) -> if !text.contains("!") { read } else {
      \\        Err({ message: "no `!` in a count", offset: text.find("!"), part: part })
      \\      },
      \\      _ -> read,
      \\    })
      \\
      \\pub fn fill(parts: List<String>, holes: List<
      ++ hole
      ++ ">) -> Int = parts.len() + holes.len()\n",
  }

fn counted(body: String) -> Source =
  { path: "m.ply", text: "import count\n\nfn main() -> Int = " ++ body ++ "\n" }

test/nondet "a tagged literal with embedded `{}` expressions evaluates to its tag's `fill` applied to the result of `compile` and those expressions' values" {
  write_project([counting("Int"), counted("count\"a {1} b{2 + 3}{{}}\" + count\"{4}\"")]);
  assert_ok(spawned(["check", "."]));
  assert_eq(value_of(spawned(["run", ".", "--json"])), "8")
}

test/nondet "a tagged literal text that its tag rejects is a check error at the offending character, where `{{` counts as one character" {
  let v = checked([counting("Int"), counted("count\"ab {1} {{c!{2}\"")]);
  assert_eq(diagnostic_codes(v), ["E0153"]);
  assert(str(at(diagnostic(v), "message")).contains("`count::compile` rejects"));
  let label = nth(at(diagnostic(v), "labels"), 0);
  assert_eq(str(at(label, "message")), "no `!` in a count");
  assert_eq(str(at(label, "snippet")), "!");
  assert_eq(int(at(at(label, "start"), "line")), 3);
  assert_eq(int(at(at(label, "start"), "col")), 36)
}

test/nondet "an embedded `{}` expression whose type differs from the type its tag expects is rejected at that expression" {
  let v = checked([counting("Int"), counted("count\"a {1} b{\"two\"}\"")]);
  assert_eq(diagnostic_codes(v), ["E0201"]);
  let label = nth(at(diagnostic(v), "labels"), 0);
  assert_eq(str(at(label, "snippet")), "\"two\"");
  assert_eq(int(at(at(label, "start"), "col")), 34)
}

test/nondet "a tagged literal with embedded expressions that passed a check is rejected after its tag expects a different expression type or its module defines its own `Ok`" {
  let holder = counted("count\"a {1}\"");
  let checked_once = || {
    write_project([counting("Int"), holder]);
    assert_ok(spawned(["check", ".", "--explain"]))
  };
  checked_once();
  write("count.ply", counting("String").text);
  assert_eq(diagnostic_codes(json_of(spawned(["check", ".", "--json"]))), ["E0201"]);
  checked_once();
  write("m.ply", counted("count\"a! {1}\"").text);
  assert_eq(diagnostic_codes(json_of(spawned(["check", ".", "--json"]))), ["E0153"]);
  assert_eq(spawned(["check", "."]).code, 2);
  checked_once();
  write("m.ply", holder.text ++ "\ntype Mine = | Ok(Int) | No\n");
  assert_eq(diagnostic_codes(json_of(spawned(["check", ".", "--json"]))), ["E0118"])
}

test/nondet "a tag used with embedded `{}` expressions must define `compile` taking `List<String>` and a non-generic, effect-free `fill` taking the compiled value and the expressions' values" {
  let lone = |text: String| checked([{ path: "count.ply", text: text }, counted("count\"a {1}\"")]);
  let compiling = "pub fn compile(parts: List<String>) -> Result<Int, { message: String, offset: Int, part: Int }> = Ok(1)\n";
  assert_eq(
    diagnostic_codes(lone("pub fn literal(text: String) -> " ++ parse_result_type ++ " = Ok(1)\n")),
    ["E0101"],
  );
  assert_eq(diagnostic_codes(lone(compiling)), ["E0101"]);
  let misfilled = lone(compiling ++ "pub fn fill(c: String, holes: List<Int>) -> Int = 1\n");
  assert_eq(diagnostic_codes(misfilled), ["E0152"]);
  assert(str(at(diagnostic(misfilled), "message")).contains("`count::fill` has type"));
  let unplaced = lone(
    "pub fn compile(parts: List<String>) -> " ++ parse_result_type ++ " = Ok(1)\n"
      ++ "pub fn fill(c: Int, holes: List<Int>) -> Int = c\n",
  );
  assert_eq(diagnostic_codes(unplaced), ["E0152"]);
  assert(str(at(diagnostic(unplaced), "message")).contains("`count::compile` has type"));
  let performing = lone(
    compiling ++ "pub effect ticks { read now() -> Int }\n"
      ++ "pub fn fill(c: Int, holes: List<Int>) -> Int / {ticks.now} = ticks.now()\n",
  );
  assert_eq(diagnostic_codes(performing), ["E0152"]);
  assert(str(at(diagnostic(performing), "message")).contains("`count::fill` performs"));
  let generic = lone(compiling ++ "pub fn fill<a>(c: Int, holes: List<a>) -> Int = c\n");
  assert(str(at(diagnostic(generic), "message")).contains("takes type parameters"))
}

test/nondet "a built artifact evaluates a tagged literal containing interpolations, and every command rejects an invalid tagged literal" {
  write_project([counting("Int"), counted("count\"a {{b}} {1}\\\"{count\"{2}\"}\"")]);
  assert_ok(spawned(["build", ".", "-o", "m.plyx"]));
  assert_eq(value_of(spawned(["run", "--json", "m.plyx"])), "5");
  write_project([counting("Int"), counted("count\"a! {1}\"")]);
  [["run", "."], ["test", "."], ["prove", "."], ["build", ".", "-o", "m.plyx"]].fold(
    (),
    |_: Unit, line: List<String>| {
      let ran = spawned(line);
      assert_eq(ran.code, 2);
      assert(all_output(ran).contains("E0153"), Some(all_output(ran)))
    },
  )
}
