import harness (PlyProcess, spawned)
import support.harness (Source, WorkingDirectory, assert_ok, diagnostic_codes, json_of,
                        write_project, all_output, value_of, write)
import std.json (Json)
import std.string

fn parser(digits: String) -> Source =
  {
    path: "hex.ply",
    text:
      \\pub type Refusal = { message: String, offset: Int }
      \\
      \\pub fn literal(text: String) -> Result<Int, Refusal> / {abort.raise} =
      \\  range(0, text.len()).fold(Ok(0), |read: Result<Int, Refusal>, i: Int|
      \\    match read {
      \\      Err(_) -> read,
      \\      Ok(n) -> {
      \\        let digit = text.slice(i, i + 1);
      \\        if digits().contains(digit) { Ok(n * 16 + digits().find(digit)) }
      \\        else { Err({ message: "not a hex digit", offset: i }) }
      \\      },
      \\    })
      \\
      \\fn digits() -> String = "
      ++ digits
      ++ "\"\n",
  }

fn hex() -> Source = parser("0123456789abcdef")

fn counting() -> Source =
  {
    path: "count.ply",
    text:
      \\pub type Refusal = { message: String, offset: Int, part: Int }
      \\
      \\pub fn compile(parts: List<String>) -> Result<List<String>, Refusal> / {abort.raise} =
      \\  range(0, parts.len()).fold(Ok(parts), |read: Result<List<String>, Refusal>, part: Int|
      \\    match ((read, parts.at(part))) {
      \\      (Ok(_), Some(text)) -> if !text.contains("!") { read } else {
      \\        Err({ message: "no `!` in a count", offset: text.find("!"), part: part })
      \\      },
      \\      _ -> read,
      \\    })
      \\
      \\pub fn fill(parts: List<String>, holes: List<Int>) -> Int = parts.len() + holes.len()
      \\
  }

fn main_of(tags: List<String>, body: String) -> Source =
  {
    path: "m.ply",
    text: String::join(tags.map(|t: String| "import " ++ t ++ "\n"), "") ++ "\nfn main() -> Int = "
      ++ body
      ++ "\n",
  }

fn both(body: String) -> Source = main_of(["count", "hex"], body)

fn hexed(body: String) -> Source = main_of(["hex"], body)

fn counted(body: String) -> Source = main_of(["count"], body)

fn checked_codes() -> List<String> / {PlyProcess, abort.raise} =
  diagnostic_codes(json_of(spawned(["check", ".", "--json"])))

test/nondet "an artifact holds its literals as they are written, and runs to their value" {
  write_project([hex(), counting(), both("hex\"ff\" + count\"a {{b}} {1}\\\"{count\"{2}\"}\"")]);
  assert_ok(spawned(["build", ".", "-o", "m.plyx"]));
  assert_eq(value_of(spawned(["run", "--json", "m.plyx"])), "260")
}

test/nondet "`run`, `test`, `prove` and `build` all reject a tagged literal that `check` rejects" {
  write_project([hex(), counting(), both("hex\"xyz\" + count\"a! {1}\"")]);
  [["run", "."], ["test", "."], ["prove", "."], ["build", ".", "-o", "m.plyx"]].fold(
    (),
    |_: Unit, line: List<String>| {
      let ran = spawned(line);
      assert_eq(ran.code, 2);
      assert(all_output(ran).contains("E0153"), Some(all_output(ran)))
    },
  )
}

test/nondet "a rejected literal is rejected again by a check that reads its module's stub" {
  write_project([hex(), hexed("hex\"xyz\"")]);
  assert_eq(spawned(["check", ".", "--explain"]).code, 2);
  let second = spawned(["check", ".", "--explain"]);
  assert_eq(second.code, 2);
  assert(all_output(second).contains("E0153"), Some(all_output(second)));
  assert_eq(spawned(["check", "."]).code, 2)
}

test/nondet "a tagged literal is checked again when its tag's parser changes, and a cached result is reused while the parser stays the same" {
  write_project([hex(), hexed("hex\"ff\"")]);
  assert_ok(spawned(["check", "."]));
  let narrowed = parser("0123456789");
  write(narrowed.path, narrowed.text);
  assert_eq(checked_codes(), ["E0153"]);
  write(hex().path, hex().text);
  assert_ok(spawned(["check", ".", "--explain"]));
  assert_ok(spawned(["check", ".", "--explain"]))
}

test/nondet "a literal with holes checked before is rejected once its text is one its tag rejects" {
  write_project([counting(), counted("count\"a {1}\"")]);
  assert_ok(spawned(["check", ".", "--explain"]));
  let rejected = counted("count\"a! {1}\"");
  write(rejected.path, rejected.text);
  assert_eq(checked_codes(), ["E0153"]);
  assert_eq(spawned(["check", "."]).code, 2)
}
