//! `Decimal` is exact, `Float` is IEEE, and neither is ever certified by a rule that does not hold of
//! it: a decimal program checks, runs and tests clean, division and overflow are refused, and a
//! float law is proved exactly where it holds at every float, `NaN` among them.

import harness (write_project, spawned, Source, in_memory, one_module_tree, write_program,
                all_output, json_of, at, path, nth, items, str, json_text, assert_ok,
                embedded_sources, value_of)
import std.json (Json)

fn billing() -> String =
  \\pub type Line = { description: String, unit: Decimal, quantity: Int }
  \\
  \\pub fn line_total(l: Line) -> Decimal = l.unit * Decimal::of_int(l.quantity)
  \\
  \\pub fn subtotal(lines: List<Line>) -> Decimal =
  \\  lines.fold(0m, |acc, l: Line| acc + line_total(l))
  \\
  \\pub fn tax(net: Decimal, rate: Decimal) -> Decimal / {abort.raise} =
  \\  Decimal::round(net * rate, 2, HalfEven)
  \\
  \\pub fn total(lines: List<Line>, rate: Decimal) -> Decimal / {abort.raise} =
  \\  subtotal(lines) + tax(subtotal(lines), rate)
  \\
  \\fn coffee() -> Line = { description: "coffee", unit: 3.75m, quantity: 4 }
  \\fn tea() -> Line = { description: "tea", unit: 2.20m, quantity: 3 }
  \\
  \\test "a subtotal is exact to the cent" {
  \\  assert_eq(subtotal([coffee(), tea()]), 21.60m)
  \\}
  \\
  \\test "a tenth plus two tenths is three tenths" {
  \\  assert_eq(0.1m + 0.2m, 0.3m)
  \\}
  \\
  \\test "binary floating point is not" {
  \\  assert(0.1 + 0.2 != 0.3)
  \\}
  \\
  \\test "a rounded tax names its mode" {
  \\  assert_eq(tax(21.60m, 0.0825m), 1.78m)
  \\}
  \\
  \\pub fn main() -> Decimal / {abort.raise} = total([coffee(), tea()], 0.0825m)
  \\

test/nondet "a decimal program checks, runs and tests clean" {
  assert_ok(in_memory(one_module_tree(billing()), ["check"]));
  write_program(billing());
  let total = value_of(spawned(["run", "--json"]));
  assert(
    total.contains("23.38"),
    Some("21.60 plus 8.25% rounded half-to-even is 23.38: " ++ total),
  );
  assert_ok(spawned(["test"]))
}

test "decimal division is E0209 and names `Decimal::div`" {
  let r = in_memory(
    one_module_tree(
      "pub fn unit(total: Decimal, count: Decimal) -> Decimal / {abort.raise} = total / count\n",
    ),
    ["check"],
  );
  assert(r.code != 0, Some(all_output(r)));
  assert(all_output(r).contains("E0209"), Some(all_output(r)));
  assert(all_output(r).contains("Decimal::div"), Some(all_output(r)));
  assert(
    all_output(r).contains("rounding nobody wrote down"),
    Some("the note is the argument, not decoration: " ++ all_output(r)),
  )
}

fn float_laws() -> String =
  \\pub fn scale(x: Float, k: Float) -> Float = x * k
  \\
  \\// False, at exactly one value.
  \\law "a float equals itself" forall (x: Float) { x == x }
  \\law "scaling by one changes nothing" forall (x: Float) { scale(x, 1.0) == x }
  \\
  \\// True at every `Float` there is, `NaN` included.
  \\law "nothing is both above and below itself" forall (x: Float) { !(x < x && x > x) }
  \\law "a float is a float" forall (x: Float, y: Float) where x < y { !(y < x) }
  \\
  \\pub fn main() -> Int = 0
  \\

fn labelled(obligations: List<Json>, label: String) -> Json / {abort.raise} =
  match obligations.filter(|o: Json| str(at(o, "label")).contains(label)) {
    [o, ..] -> o,
    [] -> panic("no obligation labelled `" ++ label ++ "`"),
  }

// Two laws false only at `NaN` and two true everywhere: the shape most likely to produce a wrong
// `proved`.
test/nondet "a float law is proved where it holds at NaN, and refuted where it does not" {
  write_program(float_laws());
  let report = json_of(spawned(["prove", "--json"]));
  let obligations = items(at(report, "obligations"));
  assert(obligations.len() == 4, Some(json_text(report)));
  ["equals itself", "scaling by one"].fold((), |u: Unit, label: String|
    assert(
      str(at(labelled(obligations, label), "outcome")) != "proved",
      Some("a Float obligation false at NaN was certified: " ++ json_text(report)),
    ));
  ["above and below itself", "a float is a float"].fold((), |u: Unit, label: String|
    assert(str(at(labelled(obligations, label), "outcome")) == "proved", Some(json_text(report))));
  // The counterexample to `x == x` is the value the type is defined by.
  let refuted = labelled(obligations, "equals itself");
  assert(str(at(refuted, "outcome")) == "refuted", Some(json_text(refuted)));
  assert(
    str(at(nth(path(refuted, ["counterexample", "bindings"]), 0), "value")) == "NaN",
    Some(json_text(refuted)),
  )
}

// `==` at `Decimal` is of the values, so congruence of the same value holds.
test/nondet "a decimal congruence is proved and decimal arithmetic is not" {
  write_program(
    \\pub fn rounded(d: Decimal) -> Decimal = d
    \\
    \\law "a decimal congruence" forall (x: Decimal) { rounded(x) == rounded(x) }
    \\law "a decimal zero is additive" forall (x: Decimal) { x + 0m == x }
    \\
    \\pub fn main() -> Int = 0
    \\
  );
  let report = json_of(spawned(["prove", "--json"]));
  let obligations = items(at(report, "obligations"));
  assert(
    str(at(labelled(obligations, "congruence"), "outcome")) == "proved",
    Some(json_text(report)),
  );
  assert(str(at(labelled(obligations, "additive"), "outcome")) != "proved", Some(json_text(report)))
}

// `-0.0` is the value most likely to make the engines disagree.
test/nondet "the two engines agree over the numeric types" {
  write_program(
    \\fn signed_zero() -> Float = 0.0 - 0.0
    \\fn inverted() -> Float = 1.0 / (0.0 - 0.0)
    \\
    \\test "float arithmetic answers what it should" {
    \\  assert(inverted() == 1.0 / signed_zero());
    \\  assert_eq(0.1m + 0.2m, 0.3m);
    \\  assert(0.1 + 0.2 != 0.3)
    \\}
    \\
    \\pub fn main() -> Int = 0
    \\
  );
  assert_ok(spawned(["test"]))
}

test/nondet "a decimal overflow is reported rather than absorbed" {
  write_program(
    \\fn ceiling() -> Decimal = 79228162514264337593543950335m
    \\
    \\test "an exact type refuses to lose a digit" {
    \\  assert_eq(ceiling() + 1m, ceiling())
    \\}
    \\
    \\pub fn main() -> Int = 0
    \\
  );
  let r = spawned(["test"]);
  assert(r.code != 0, Some(all_output(r)));
  assert(all_output(r).contains("`Decimal` overflow in addition"), Some(all_output(r)));
  assert(
    all_output(r).contains("will not round to make room"),
    Some("the note is what separates this from a wrap: " ++ all_output(r)),
  )
}

/// The language suite's float programs, which it runs under the development profile.
fn float_programs() -> List<Source> / {abort.raise} =
  embedded_sources(embed_dir("../lang/floats"), "")

test/nondet "the float programs answer their digests under the release profile too" {
  write_project(float_programs());
  assert_ok(spawned(["test", "--profile", "release", "--no-cache"]))
}
