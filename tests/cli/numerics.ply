import harness (spawned, embedded_sources)
import support.harness (write_project, Source, write_program, json_of, at, path, nth, items, str,
                        json_text, assert_ok)
import std.json (Json)

test/nondet "a float law false only at NaN is refuted there" {
  write_program(String::of_bytes_lossy(embed("../programs/numerics/float_laws.ply")));
  let report = json_of(spawned(["prove", ".", "--json"]));
  let refuted = match items(at(report, "obligations")) {
    [o] -> o,
    _ -> panic("the program states one law: " ++ json_text(report)),
  };
  assert(str(at(refuted, "outcome")) == "refuted", Some(json_text(refuted)));
  assert(
    str(at(nth(path(refuted, ["counterexample", "bindings"]), 0), "value")) == "NaN",
    Some(json_text(refuted)),
  )
}

fn float_programs() -> List<Source> / {abort.raise} =
  embedded_sources(embed_dir("../lang/floats"), "")

test/nondet "the float programs pass their tests when built with the release profile too" {
  write_project(float_programs());
  assert_ok(spawned(["test", ".", "--profile", "release", "--no-cache"]))
}
