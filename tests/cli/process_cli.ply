//! A program's own process under `ply run`: its arguments, streams, input and exit code, the
//! children it starts, and that none of them outlives the run. What a program writes goes to the
//! process's own streams, so every run here is one.

import harness (scratch, Server, write_program, on_disk, spawned, spawned_reading, spawned_fed,
                spawned_into, this_ply, start_streaming, next_line, signal_to, wait_for_exit,
                environment, all_output, stdout, stderr, json_of, at, str, int, bool, json_text,
                items, completed_result, stop, WorkingDirectory, PlyProcess, Shell)
import std.bytes
import std.config (config)
import std.json (Json, Null)
import std.list
import std.process (process, CompletedProcess, Signal, Exited, Signalled, Terminate, Hangup, User1,
                    User2, WindowChange)
import std.string
import std.time (time)

fn source() -> String = String::of_bytes_lossy(embed("../programs/process_cli/source.ply"))

fn one_line() -> String = String::of_bytes_lossy(embed("../programs/process_cli/one_line.ply"))

test/nondet "run returns the arguments, writes each stream and exits with the code" {
  write_program(source());
  let r = spawned(["run", "m.ply", "--", "a", "b"], []);
  assert(r.code == 3, Some(all_output(r)));
  assert(r.out == ["hi a b"], Some("stdout holds only what the program wrote:\n" ++ stdout(r)));
  assert(stderr(r).contains("leaving"), Some(stderr(r)));
  assert(
    !stderr(r).contains("E0455") && !stderr(r).contains("raised at"),
    Some("an exit the program asked for is not an error:\n" ++ stderr(r)),
  )
}

test/nondet "run reads a line from standard input" {
  write_program(one_line());
  let r = spawned_reading(["run", "m.ply"], [], "hello\nrest\n");
  assert(r.code == 0, Some(all_output(r)));
  assert(stdout(r).contains("read hello"), Some(stdout(r)));
  assert(
    !stdout(r).contains("rest"),
    Some("the whole input is not one call's result:\n" ++ stdout(r)),
  )
}

test/nondet "a line read past the end of input is None" {
  write_program(one_line());
  let r = spawned_reading(["run", "m.ply"], [], "");
  assert(r.code == 0, Some(all_output(r)));
  assert(stdout(r).contains("end of input"), Some(stdout(r)))
}

test/nondet "under json the object is alone on stdout and the lines go to stderr" {
  write_program(source());
  let r = spawned(["run", "m.ply", "--json", "--", "x"], []);
  assert(r.code == 3, Some(all_output(r)));
  let v = json_of(r);
  assert(str(at(v, "command")) == "run", Some(json_text(v)));
  assert(!bool(at(v, "ok")), Some(json_text(v)));
  assert(int(at(v, "exit_code")) == 3, Some(json_text(v)));
  assert(at(v, "value") == Null, Some(json_text(v)));
  assert(stderr(r).contains("hi x"), Some(stderr(r)));
  assert(stderr(r).contains("leaving"), Some(stderr(r)))
}

test/nondet "an exit code the shell could not carry is a runtime error" {
  write_program(
    "import std.process (process)\n\nfn main() -> Unit / {process.write[proc]} = process.exit[proc](300)\n",
  );
  let r = spawned(["run", "m.ply"], []);
  assert(r.code == 1, Some(all_output(r)));
  assert(stderr(r).contains("E0502"), Some(stderr(r)));
  assert(stderr(r).contains("0 to 125"), Some(stderr(r)))
}

test/nondet "ply test withholds the process" {
  write_program(
    \\import std.process (process)
    \\
    \\pub fn announce() -> Unit / {process.write[proc]} = process.out[proc]("ready")
    \\
    \\test/nondet "the announcement reaches the process" {
    \\  announce()
    \\}
    \\
  );
  let r = spawned(["test", "--json"], []);
  assert(
    all_output(r).contains("E0424"),
    Some("`process.out` was not rejected\n\n" ++ all_output(r)),
  );
  assert(
    all_output(r).contains("std.process::served"),
    Some("the rejection names the handler that would have served it\n\n" ++ all_output(r)),
  )
}

test/nondet "a run that never exits reports its value under json" {
  write_program(
    "import std.process (process)\n\nfn main() -> Int / {process.read[proc]} = process.args[proc]().len()\n",
  );
  let v = json_of(spawned(["run", "m.ply", "--json", "--", "one", "two"], []));
  assert(bool(at(v, "ok")), Some(json_text(v)));
  assert(int(at(v, "exit_code")) == 0, Some(json_text(v)));
  assert(str(at(v, "value")) == "2", Some(json_text(v)))
}

/// Says, for two labels, whether the run bound a program to each; it starts neither.
fn asks_what_is_bound() -> String =
  String::of_bytes_lossy(embed("../programs/process_cli/asks_what_is_bound.ply"))

test/nondet "bound returns from the exec table the run was given" {
  write_program(asks_what_is_bound());
  [{ exec: ["--exec", "sh=/bin/sh"], sh: "sh is bound" }, { exec: [], sh: "sh is not bound" }].fold(
    (),
    |u: Unit, c: { exec: List<String>, sh: String }| {
      let r = spawned(c.exec.fold(["run", "m.ply"], List::push), []);
      assert(r.code == 0, Some(all_output(r)));
      let lines = r.out;
      assert(lines.filter(|l: String| l == c.sh).len() > 0, Some(stdout(r)));
      assert(lines.filter(|l: String| l == "cc is not bound").len() > 0, Some(stdout(r)))
    },
  )
}

/// Starts a child that says its pid and sleeps, says that pid, then ends as `ENDING` says.
fn leaves_a_child() -> String =
  \\import std.process
  \\import std.process (process)
  \\
  \\fn main() -> Unit / {process.start[sh], process.output_line[sh], process.wait[sh], process.out[proc], process.exit[proc], abort.raise} = {
  \\  let started = process.start[sh](
  \\    ["-c", "echo $$; exec sleep 600"],
  \\    "",
  \\    [process::var("PATH", "/usr/bin:/bin")],
  \\    { input: false, out: process::Lines, err: process::Discard },
  \\  );
  \\  match started {
  \\    Err(why) -> process.out[proc]("not started: " ++ why),
  \\    Ok(child) -> {
  \\      match process.output_line[sh](child, 10000) {
  \\        process::LineWritten(pid) -> process.out[proc]("pid " ++ pid),
  \\        _ -> process.out[proc]("no pid"),
  \\      };
  \\      ENDING
  \\    },
  \\  }
  \\}
  \\

/// The same program asking whether it is stopping first, so its run drains on a stop.
fn drains_beside_a_child() -> String =
  leaves_a_child().replace(
    "import std.process (process)\n",
    "import std.process (process)\nimport std.signal (signal)\n",
  ).replace(
    "abort.raise} = {\n",
    "signal.stopping, abort.raise} = {\n  if signal.stopping() { process.exit[proc](0) } else { () };\n",
  )

fn waits_on_it() -> String = "let _ = process.wait[sh](child, -1);\n      ()"

fn leaving(ending: String) -> Unit / {WorkingDirectory, abort.raise} =
  write_program(leaves_a_child().replace("ENDING", ending))

fn pid_in(line: String) -> Option<String> / {abort.raise} =
  if line.starts_with("pid ") { Some(line.slice(4, line.len()).trim()) } else { None }

/// Whether any process has this pid, as `kill -0` asks.
fn alive(pid: String) -> Bool / {config.get[env], process.spawn[sh]} =
  match process.spawn[sh](["-c", "kill -0 " ++ pid ++ " 2>/dev/null"], "", environment([])).ended {
    Exited(c) -> c == 0,
    Signalled(_) -> false,
  }

test/nondet "a child still running when the run ends does not outlive it" {
  [
    { ending: "()", code: 0 },
    { ending: "process.exit[proc](3)", code: 3 },
    { ending: "panic(\"the program gave up\")", code: 1 },
  ].fold((), |u: Unit, c: { ending: String, code: Int }| {
    leaving(c.ending);
    let r = spawned(["run", "m.ply", "--exec", "sh=/bin/sh"], []);
    assert(r.code == c.code, Some("ended by `" ++ c.ending ++ "`\n" ++ all_output(r)));
    let pid = match r.out.fold(None, |found: Option<String>, l: String|
        match found { Some(_) -> found, None -> pid_in(l) }) {
      Some(p) -> p,
      None -> panic("the run never said the child's pid:\n" ++ stdout(r)),
    };
    assert(
      !alive(pid),
      Some("the child " ++ pid ++ " outlived a run ended by `" ++ c.ending ++ "`"),
    )
  })
}

/// The pid the run's child said, read as the run writes it.
fn printed_pid(server: Server) -> String / {PlyProcess, abort.raise, diverges} =
  match next_line(server, 300000) {
    Some(line) -> match pid_in(line) { Some(pid) -> pid, None -> printed_pid(server) },
    None -> panic("the run never said the child's pid"),
  }

/// A run of `source` waiting on its child, stopped from outside: how the run ended, and the
/// child's pid.
type StoppedRun = { code: Int, pid: String }

fn stop_run(
  source: String,
  flags: List<String>,
  signals: Int,
) -> StoppedRun / {PlyProcess, WorkingDirectory, process.spawn[sh], time.sleep_ms, abort.raise, diverges} = {
  write_program(source.replace("ENDING", waits_on_it()));
  let run = start_streaming(flags.fold(["run", "m.ply", "--exec", "sh=/bin/sh"], List::push), []);
  let pid = printed_pid(run);
  assert(alive(pid), Some("the child " ++ pid ++ " is running"));
  range(0, signals).fold((), |u: Unit, i: Int| {
    signal_to(run, Terminate);
    time.sleep_ms(300)
  });
  let f = wait_for_exit(run, 60000, "the run was still going a minute after it was stopped");
  { code: match f.ended { Exited(c) -> c, Signalled(_) -> -1 }, pid: pid }
}

// Nothing of it drains, so the stop is the end: its children go, and the code is the signal's.
test/nondet "a run that starts a child and drains nothing ends the child and exits at the first stop" {
  let s = stop_run(leaves_a_child(), [], 1);
  assert(s.code == 143, Some("a `SIGTERM` ending the run at once exits 143"));
  assert(!alive(s.pid), Some("the child " ++ s.pid ++ " outlived the run"))
}

test/nondet "a second signal ends the children before the run exits" {
  let s = stop_run(drains_beside_a_child(), [], 2);
  assert(s.code == 143, Some("a second `SIGTERM` exits 143"));
  assert(!alive(s.pid), Some("the child " ++ s.pid ++ " outlived the second signal"))
}

test/nondet "a drain that runs out of time ends the children with the run" {
  let s = stop_run(drains_beside_a_child(), ["--drain-ms", "200"], 1);
  assert(s.code == 3, Some("an expired drain exits 3"));
  assert(!alive(s.pid), Some("the child " ++ s.pid ++ " outlived the drain"))
}

// --- The streams as bytes ---------------------------------------------------

fn exit_of(f: CompletedProcess) -> Int = match f.ended { Exited(c) -> c, Signalled(n) -> 128 + n }

/// `cat`: standard input to standard output through `std.io`, then an exit.
fn cat() -> String =
  \\import std.io
  \\import std.io (io)
  \\import std.process (process, pipe)
  \\
  \\fn main() -> Unit / {process.read[proc], process.write[proc], pipe.broken, io.too_long, io.write_failed, abort.raise} = {
  \\  let copied = with_scope[input](io::stdin[proc](), io::close_source) { from ->
  \\    with_scope[output](io::stdout[proc](), io::close_sink) { to ->
  \\      io::copy(from, to, 8192, 1073741824)
  \\    }
  \\  };
  \\  process.exit[proc](if copied >= 0 { 0 } else { 1 })
  \\}
  \\

/// Every byte there is, over and over: more than standard output's buffer holds, with a NUL,
/// newlines and bytes that are no UTF-8 among them.
fn every_byte() -> Bytes / {abort.raise} =
  Bytes::concat_all(range(0, 256).map(byte_of_int)).repeat(300)

test/nondet "a Ply cat copies its input to its output byte for byte" {
  write_program(cat());
  let input = every_byte();
  let f = spawned_fed(["run", "m.ply"], [], input);
  assert(exit_of(f) == 0, Some(all_output(completed_result(f))));
  assert(
    f.out == input,
    Some(
      "standard output is the " ++ input.len().to_string() ++ " bytes of the input, and held "
        ++ f.out.len().to_string(),
    ),
  )
}

test/nondet "under json the bytes a program writes go to stderr, where its lines go" {
  write_program(cat());
  let input = every_byte();
  let f = spawned_fed(["run", "m.ply", "--json"], [], input);
  assert(exit_of(f) == 0, Some(String::of_bytes_lossy(f.out)));
  assert(
    f.err == input,
    Some(
      "stderr held " ++ f.err.len().to_string() ++ " bytes, and the input is "
        ++ input.len().to_string(),
    ),
  );
  assert(
    str(at(json_of(completed_result(f)), "command")) == "run",
    Some(String::of_bytes_lossy(f.out)),
  )
}

fn prompts() -> String = String::of_bytes_lossy(embed("../programs/process_cli/prompts.ply"))

test/nondet "a prompt and its response share a line, and bytes read after a line start where it ended" {
  write_program(prompts());
  let r = spawned_reading(["run", "m.ply"], [], "ada\r\nrest of it");
  assert(r.code == 0, Some(all_output(r)));
  assert(stdout(r).contains("name: hello ada, and 10 bytes follow"), Some(stdout(r)))
}

/// Writes part of a line and never flushes it, then ends as `ENDING` says.
fn half_a_line() -> String =
  \\import std.process
  \\import std.process (process, pipe)
  \\
  \\fn main() -> Unit / {process.write[proc], pipe.broken, abort.raise} = {
  \\  process::write_out[proc](b"half a line");
  \\  ENDING
  \\}
  \\

test/nondet "what a program wrote and never flushed is written however it ends" {
  [
    { ending: "()", code: 0 },
    { ending: "process.exit[proc](3)", code: 3 },
    { ending: "panic(\"the program gave up\")", code: 1 },
  ].fold((), |u: Unit, c: { ending: String, code: Int }| {
    write_program(half_a_line().replace("ENDING", c.ending));
    let r = spawned(["run", "m.ply"], []);
    assert(r.code == c.code, Some("ended by `" ++ c.ending ++ "`\n" ++ all_output(r)));
    assert(
      stdout(r).contains("half a line"),
      Some("ended by `" ++ c.ending ++ "`, the bytes were lost:\n" ++ stdout(r)),
    )
  })
}

/// A program that writes far more than `head -1` reads, as `WRITES` writes it.
fn writes_into_head() -> String =
  \\import std.process
  \\import std.process (process, pipe)
  \\
  \\fn lines(n: Int) -> Unit / {process.out[proc]} =
  \\  if n <= 0 { () } else {
  \\    process.out[proc]("line " ++ n.to_string());
  \\    lines(n - 1)
  \\  }
  \\
  \\fn bytes(n: Int) -> Unit / {process.out_bytes[proc], process.flush[proc], pipe.broken} =
  \\  if n <= 0 { () } else {
  \\    process::write_out[proc](b"0123456789abcdef\n");
  \\    process::flush_out[proc]();
  \\    bytes(n - 1)
  \\  }
  \\
  \\fn main() -> Unit / {process.write[proc], pipe.broken} = {
  \\  WRITES;
  \\  process.err[proc]("wrote it all")
  \\}
  \\

fn results_the_pipe() -> String =
  \\{
  \\    let wrote: Result<Unit, process::Stream> = try[pipe.broken] { bytes(200000) };
  \\    match wrote {
  \\      Ok(_) -> (),
  \\      Err(_) -> {
  \\        process.err[proc]("the reader left");
  \\        process.exit[proc](7)
  \\      },
  \\    }
  \\  }

/// What `ply run m.ply` leaves when the reader of its output takes one line and goes, as `head -1`
/// does: that line, and on stderr what the run said and then `status` and the code it exited with.
/// The reader is a shell's own `read`, which takes a line and not a byte past it.
fn into_head() -> CompletedProcess / {Shell, abort.raise} =
  spawned_into(["run", "m.ply"], "{ read a; echo \"$a\"; }")

test/nondet "a program writing into a pipe whose reader left exits quietly, as a closed pipe ends one" {
  [
    { writes: "lines(200000)", first: b"line 200000\n" },
    { writes: "bytes(200000)", first: b"0123456789abcdef\n" },
  ].fold((), |u: Unit, c: { writes: String, first: Bytes }| {
    write_program(writes_into_head().replace("WRITES", c.writes));
    let f = into_head();
    let err = String::of_bytes_lossy(f.err);
    assert(err.contains("status 141"), Some("`" ++ c.writes ++ "` into a pipe:\n" ++ err));
    assert(
      !err.contains("E0502") && !err.contains("Broken pipe") && !err.contains("wrote it all"),
      Some("a closed pipe is no failure to report, and nothing runs after it:\n" ++ err),
    );
    assert(f.out == c.first, Some(String::of_bytes_lossy(f.out)))
  })
}

test/nondet "a program that handles the closed pipe goes on, and ends as it chooses" {
  write_program(writes_into_head().replace("WRITES", results_the_pipe()));
  let err = String::of_bytes_lossy(into_head().err);
  assert(err.contains("the reader left"), Some(err));
  assert(err.contains("status 7"), Some(err))
}

// --- Signals ----------------------------------------------------------------

/// Asks about each signal once, says it is ready, then says which arrive until it is stopped.
fn listens() -> String = String::of_bytes_lossy(embed("../programs/process_cli/listens.ply"))

/// Says it is ready and waits, asking about no signal.
fn asks_nothing() -> String =
  String::of_bytes_lossy(embed("../programs/process_cli/asks_nothing.ply"))

/// The run's lines up to the one that is `wanted`, or the test fails with what came instead.
fn wait_for_line(run: Server, wanted: String, tries: Int) -> Unit / {PlyProcess, abort.raise} =
  if tries <= 0 { panic("the run never said `" ++ wanted ++ "`") } else {
    match next_line(run, 120000) {
      Some(line) -> if line == wanted { () } else { wait_for_line(run, wanted, tries - 1) },
      None -> {
        stop(run);
        panic("the run fell silent before it said `" ++ wanted ++ "`")
      },
    }
  }

test/nondet "a program that asked about a signal is told when it arrives, and goes on" {
  write_program(listens());
  let run = start_streaming(["run", "m.ply"], []);
  wait_for_line(run, "ready", 20);
  [
    { signal: Hangup, said: "got hangup" },
    { signal: User1, said: "got user1" },
    { signal: User2, said: "got user2" },
    { signal: WindowChange, said: "got resized" },
    { signal: Hangup, said: "got hangup" },
  ].fold((), |u: Unit, c: { signal: Signal, said: String }| {
    signal_to(run, c.signal);
    wait_for_line(run, c.said, 1)
  });
  signal_to(run, Terminate);
  let f = wait_for_exit(run, 60000, "the run was still going a minute after it was asked to stop");
  assert(
    f.ended == Exited(0),
    Some("a stop ends a program that polls for it: " ++ all_output(completed_result(f))),
  )
}

test/nondet "a hangup nobody asked about ends the process, as the platform has it" {
  write_program(asks_nothing());
  let run = start_streaming(["run", "m.ply"], []);
  wait_for_line(run, "ready", 20);
  signal_to(run, Hangup);
  let f = wait_for_exit(run, 60000, "the run outlived a hangup it never asked about");
  assert(f.ended == Signalled(1), Some("ended as " ++ exit_of(f).to_string()))
}

// Its root neither performs `signal` nor accepts a connection, so its run has no drain to begin.
test/nondet "a run that listens for no stop ends at once when it is stopped" {
  write_program(asks_nothing());
  let run = start_streaming(["run", "m.ply"], []);
  wait_for_line(run, "ready", 20);
  signal_to(run, Terminate);
  let f = wait_for_exit(run, 60000, "the run outlived a stop it does not listen for");
  assert(f.ended == Signalled(15), Some("ended as " ++ exit_of(f).to_string()))
}

// --- The machine ------------------------------------------------------------

fn describes_the_machine() -> String =
  String::of_bytes_lossy(embed("../programs/process_cli/describes_the_machine.ply"))

/// One line a shell command writes, without its ending.
fn shell_output(command: String) -> String / {process.spawn[sh], config.get[env]} =
  String::of_bytes_lossy(process.spawn[sh](["-c", command], "", environment([])).out).ascii_trim()

test/nondet "a program is told the machine it runs on, as the system's own tools tell it" {
  write_program(describes_the_machine());
  let r = spawned(["run", "m.ply"], []);
  assert(r.code == 0, Some(all_output(r)));
  let has = |line: String|
    assert(r.out.contains(line), Some("no line `" ++ line ++ "` in:\n" ++ stdout(r)));
  has(
    "family "
      ++ (if shell_output("uname -s") == "Darwin" { "macos" }
      else { shell_output("uname -s").ascii_lower() }),
  );
  has("name " ++ shell_output("uname -sr"));
  has(
    "arch "
      ++ (if shell_output("uname -m") == "arm64" { "aarch64" } else { shell_output("uname -m") }),
  );
  has("cpus some");
  has("host " ++ shell_output("uname -n"));
  has("user " ++ shell_output("id -u"));
  has("pid its own");
  has("executable " ++ this_ply());
  assert(r.out.contains("endian little") || r.out.contains("endian big"), Some(stdout(r)));
  has("pointer " ++ shell_output("getconf LONG_BIT"))
}

// `std.os` declares its host handler, so a program reads the machine it runs on with no grant.
test/nondet "a program reads the machine it runs on with no flag, through the host handler std.os declares" {
  write_program(
    "import std.os (os)\n\nfn main() -> Int / {os.read} = if os.cpus() >= 1 && os.pid() > 1 && os.executable() != None { 7 } else { 3 }\n",
  );
  let r = spawned(["run", "m.ply", "--json"], []);
  assert(r.code == 0, Some(all_output(r)));
  assert_eq(str(at(json_of(r), "value")), "7")
}

test "ply hosts lists every operation of std.os a program performs" {
  scratch(|| {
    write_program(describes_the_machine());
    let r = on_disk(["hosts", "--json"]);
    assert(r.code == 0, Some(all_output(r)));
    let triples = items(at(json_of(r), "hosts")).map(|row: Json| str(at(row, "triple")));
    [
      "family",
      "name",
      "arch",
      "cpus",
      "hostname",
      "user",
      "pid",
      "executable",
      "endian",
      "pointer_bits",
    ].fold((), |u: Unit, op: String|
      assert(
        triples.contains("std.os.os." ++ op),
        Some("`os." ++ op ++ "` is not listed:\n" ++ all_output(r)),
      ))
  })
}

test "a `const fn` cannot ask the machine anything, so no build keeps one machine's answer" {
  scratch(|| {
    write_program(
      "import std.os (os)\n\nconst fn workers() -> Int = os.cpus()\n\nfn main() -> Int = workers()\n",
    );
    let r = on_disk(["check"]);
    assert(r.code != 0, Some(all_output(r)));
    assert(all_output(r).contains("E0156"), Some(all_output(r)))
  })
}

test/nondet "ply test withholds the streams as bytes" {
  [
    {
      program: "import std.process (process)\n\ntest/nondet \"asks\" {\n  assert(process.out_bytes[proc](b\"x\"))\n}\n",
      operation: "process.out_bytes",
    },
    {
      program: "import std.process (process)\n\ntest/nondet \"asks\" {\n  assert(process.in_bytes[proc](1) == b\"\")\n}\n",
      operation: "process.in_bytes",
    },
  ].fold((), |u: Unit, c: { program: String, operation: String }| {
    write_program(c.program);
    let r = spawned(["test", "--json"], []);
    assert(
      all_output(r).contains("E0424"),
      Some("`" ++ c.operation ++ "` was not withheld\n\n" ++ all_output(r)),
    );
    assert(all_output(r).contains(c.operation), Some(all_output(r)));
    assert(all_output(r).contains("std.process::served"), Some(all_output(r)))
  })
}

// The console is open to a test as to any run: the streams of one spawned here are pipes, and a
// test's run listens for no stop, so it hears no signal.
test/nondet "a test asks the terminal and the signals through their host handlers" {
  write_program(
    "import std.process (Stdin, Stdout, Stderr)\nimport std.signal (signal)\nimport std.term (term, Raw)\n\ntest/nondet \"asks\" {\n  assert(term.size() == None);\n  assert(!term.is_terminal(Stdin) && !term.is_terminal(Stdout) && !term.is_terminal(Stderr));\n  assert(term.mode(Raw) == None);\n  assert(!signal.hangup())\n}\n",
  );
  let r = spawned(["test"], []);
  assert(r.code == 0, Some(all_output(r)))
}
