//! Every way a body is left without returning gives back the nested calls it spent: a failure
//! returning through frames, an unwind to a clause, a body parked or resumed elsewhere, a task
//! cancelled or failed, and a raise from a builtin. Measured as the deepest climb an entry can still
//! make once its rounds are over.

import harness (Here, Shipped, Loaded, entered, loaded, project, unloaded)
import cli.machine
import cli.machine (default_options)
import std.machine as entering
import std.value (Value, VInt)

effect set Driving = {entering::machine.open, entering::machine.bind, entering::machine.enter, entering::machine.unbind, entering::machine.close}

fn left() -> String =
  \\effect parse {
  \\  raise refused(at: Int)
  \\}
  \\
  \\effect stop {
  \\  write now() -> Unit
  \\}
  \\
  \\effect ask {
  \\  read q() -> Int
  \\}
  \\
  \\effect amb {
  \\  multi read flip() -> Bool
  \\}
  \\
  \\type Saved = Nothing | Just((Int) -> Int)
  \\
  \\effect slot {
  \\  write put(k: Saved) -> Unit
  \\  read saved() -> Saved
  \\}
  \\
  \\fn climbs(depth: Int) -> Int = if depth <= 0 { 0 } else { 1 + climbs(depth - 1) }
  \\
  \\fn refuse(n: Int, depth: Int) -> Int / {parse.refused} =
  \\  if depth <= 0 { parse.refused(n) } else { 1 + refuse(n, depth - 1) }
  \\
  \\fn panics(n: Int, depth: Int) -> Int / {abort.raise} =
  \\  if depth <= 0 { panic("deep") } else { 1 + panics(n, depth - 1) }
  \\
  \\fn stops(n: Int, depth: Int) -> Int / {stop.write} =
  \\  if depth <= 0 {
  \\    stop.now();
  \\    n
  \\  } else { 1 + stops(n, depth - 1) }
  \\
  \\fn asks(depth: Int) -> Int / {ask.read} = if depth <= 0 { ask.q() } else { 1 + asks(depth - 1) }
  \\
  \\fn or_at(r: Result<Int, Int>) -> Int = match r { Ok(v) -> v, Err(at) -> at }
  \\
  \\fn ended(sum: Int, climb: Int) -> Int = sum + climbs(climb) - climb
  \\
  \\fn refusals(n: Int) -> Int =
  \\  range(0, n).fold(0, |acc: Int, i: Int| acc + or_at(try { refuse(i, 20) }))
  \\
  \\pub fn tried(n: Int, climb: Int) -> Int = ended(refusals(n), climb)
  \\
  \\pub fn named(n: Int, climb: Int) -> Int / {abort.raise} =
  \\  ended(
  \\    range(0, n).fold(0, |acc: Int, i: Int|
  \\      acc + or_at(try[parse.refused] { if i < 0 { panics(i, 1) } else { refuse(i, 20) } })),
  \\    climb,
  \\  )
  \\
  \\pub fn answered(n: Int, climb: Int) -> Int =
  \\  ended(
  \\    range(0, n).fold(0, |acc: Int, i: Int|
  \\      acc + (handle { panics(i, 120) } with { abort.raise(m) -> climbs(120) })),
  \\    climb,
  \\  )
  \\
  \\pub fn abandoned(n: Int, climb: Int) -> Int =
  \\  ended(
  \\    range(0, n).fold(0, |acc: Int, i: Int|
  \\      acc + (handle { stops(i, 20) } with { stop.now() resume k -> i })),
  \\    climb,
  \\  )
  \\
  \\pub fn bracketed(n: Int, climb: Int) -> Int =
  \\  ended(
  \\    range(0, n).fold(0, |acc: Int, i: Int|
  \\      acc
  \\        + or_at(try {
  \\          bracket(|| i, |held: Int| {
  \\            climbs(120);
  \\            ()
  \\          }, |held: Int| refuse(held, 120))
  \\        })),
  \\    climb,
  \\  )
  \\
  \\pub fn reentered(n: Int, climb: Int) -> Int =
  \\  ended(
  \\    range(0, n).fold(0, |acc: Int, i: Int|
  \\      acc
  \\        + (handle { asks(20) } with {
  \\          ask.q() resume k -> k(or_at(try { refuse(i, 20) })),
  \\        })),
  \\    climb,
  \\  )
  \\
  \\pub fn detached(n: Int, climb: Int) -> Int =
  \\  ended(
  \\    range(0, n).fold(0, |acc: Int, i: Int|
  \\      acc
  \\        + (handle { asks(20) } with {
  \\          ask.q() resume k -> if i % 2 == 0 { 0 } else { 1 + k(i) },
  \\        })),
  \\    climb,
  \\  )
  \\
  \\pub fn resumed(n: Int, climb: Int) -> Int =
  \\  ended(
  \\    range(0, n).fold(0, |acc: Int, i: Int|
  \\      acc
  \\        + (handle { asks(20) + refuse(i, 120) } with {
  \\          ask.q() resume k -> k(i),
  \\          parse.refused(at) -> climbs(120),
  \\        })),
  \\    climb,
  \\  )
  \\
  \\fn retried(i: Int, depth: Int) -> Int / {ask.read} =
  \\  if depth <= 0 {
  \\    range(0, 3).fold(0, |acc: Int, round: Int|
  \\      acc + or_at(try { ask.q() + refuse(i, 120) }) + climbs(120))
  \\  } else { 1 + retried(i, depth - 1) }
  \\
  \\pub fn again(n: Int, climb: Int) -> Int =
  \\  ended(
  \\    range(0, n).fold(0, |acc: Int, i: Int|
  \\      acc + (handle { retried(i, 20) } with { ask.q() resume k -> k(i) })),
  \\    climb,
  \\  )
  \\
  \\pub fn again_apart(n: Int, climb: Int) -> Int =
  \\  ended(
  \\    range(0, n).fold(0, |acc: Int, i: Int|
  \\      acc + (handle { retried(i, 20) } with { ask.q() resume k -> 1 + k(i) })),
  \\    climb,
  \\  )
  \\
  \\pub fn apart(n: Int, climb: Int) -> Int =
  \\  ended(
  \\    range(0, n).fold(0, |acc: Int, i: Int|
  \\      acc
  \\        + (handle { asks(1) + refuse(i, 120) } with {
  \\          ask.q() resume k -> 1 + k(i),
  \\          parse.refused(at) -> climbs(120),
  \\        })),
  \\    climb,
  \\  )
  \\
  \\fn flips(n: Int, depth: Int) -> Int / {amb.read} =
  \\  if depth <= 0 {
  \\    or_at(try {
  \\      let heads = amb.flip();
  \\      if heads { refuse(n, 120) } else { refuse(n + 1, 110) }
  \\    })
  \\      + climbs(120)
  \\  } else { 1 + flips(n, depth - 1) }
  \\
  \\pub fn twice(n: Int, climb: Int) -> Int =
  \\  ended(
  \\    range(0, n).fold(0, |acc: Int, i: Int|
  \\      acc + (handle { flips(i, 20) } with { amb.flip() resume k -> k(true) + k(false) })),
  \\    climb,
  \\  )
  \\
  \\fn guarded(depth: Int) -> Int / {ask.read} =
  \\  if depth <= 0 {
  \\    or_at(try {
  \\      let v = ask.q();
  \\      refuse(v, 120)
  \\    })
  \\      + climbs(120)
  \\  } else { 1 + guarded(depth - 1) }
  \\
  \\fn later(s: Saved, v: Int, depth: Int) -> Int =
  \\  if depth <= 0 { match s { Just(k) -> k(v), Nothing -> 0 } } else { 1 + later(s, v, depth - 1) }
  \\
  \\pub fn elsewhere(n: Int, climb: Int) -> Int =
  \\  ended(
  \\    range(0, n).fold(0, |acc: Int, i: Int|
  \\      acc
  \\        + handle {
  \\          let first = handle { guarded(20) } with {
  \\            ask.q() resume k -> {
  \\              slot.put(Just(k));
  \\              0
  \\            },
  \\          };
  \\          first + later(slot.saved(), i, 30)
  \\        } with {
  \\          var s = Nothing,
  \\          slot.put(k) -> {
  \\            s = k;
  \\          },
  \\          slot.saved() -> s,
  \\        }),
  \\    climb,
  \\  )
  \\
  \\pub fn branched(n: Int, climb: Int) -> Int = {
  \\  let (left, right) = parallel { refusals(n), refusals(n) };
  \\  ended(left + right, climb)
  \\}
  \\
  \\fn yields(n: Int, depth: Int) -> Int / {parse.refused, task.write} =
  \\  if depth <= 0 {
  \\    task.yield();
  \\    parse.refused(n)
  \\  } else { 1 + yields(n, depth - 1) }
  \\
  \\fn worker(n: Int, climb: Int) -> Int / {task.write} =
  \\  ended(range(0, n).fold(0, |acc: Int, i: Int| acc + or_at(try { yields(i, 20) })), climb)
  \\
  \\pub fn interleaved(n: Int, climb: Int) -> Int / {abort.raise, sim.read} =
  \\  simulate {
  \\    let beside = task.spawn(|| worker(n, 0));
  \\    let mine = worker(n, 0);
  \\    let theirs = task.join(beside);
  \\    let last = task.spawn(|| worker(n, climb));
  \\    mine + theirs + task.join(last)
  \\  }
  \\
  \\pub fn served(n: Int, climb: Int) -> Int / {task.write, abort.raise} = {
  \\  let beside = task.spawn(|| worker(n, 0));
  \\  let mine = worker(n, 0);
  \\  ended(mine + task.join(beside), climb)
  \\}
  \\
  \\fn sleeps(depth: Int) -> Int / {clock.write} =
  \\  if depth <= 0 {
  \\    clock.sleep(Duration(10));
  \\    0
  \\  } else { 1 + sleeps(depth - 1) }
  \\
  \\pub fn cancelled(n: Int, climb: Int) -> Int / {sim.read} =
  \\  simulate {
  \\    let sum = range(0, n).fold(0, |acc: Int, i: Int| {
  \\      let t = task.spawn(||
  \\        bracket(|| i, |held: Int| {
  \\          climbs(120);
  \\          ()
  \\        }, |held: Int| sleeps(120)));
  \\      task.yield();
  \\      task.cancel(t);
  \\      acc + (match task.await(t) { Some(v) -> v, None -> 1 })
  \\    });
  \\    ended(sum, climb)
  \\  }
  \\
  \\fn region(i: Int, depth: Int) -> Int / {sim.read, abort.raise} =
  \\  if depth <= 0 {
  \\    simulate {
  \\      let t = task.spawn(|| panics(i, 20));
  \\      task.join(t)
  \\    }
  \\  } else { 1 + region(i, depth - 1) }
  \\
  \\pub fn outside(n: Int, climb: Int) -> Int / {sim.read} =
  \\  ended(
  \\    range(0, n).fold(0, |acc: Int, i: Int|
  \\      acc + (handle { region(i, 20) } with { abort.raise(m) -> 1 })),
  \\    climb,
  \\  )
  \\
  \\fn joins(t: Task<Int>, depth: Int) -> Int / {task.write, abort.raise} =
  \\  if depth <= 0 { task.join(t) } else { 1 + joins(t, depth - 1) }
  \\
  \\pub fn joined(n: Int, climb: Int) -> Int / {sim.read} =
  \\  simulate {
  \\    let sum = range(0, n).fold(0, |acc: Int, i: Int| {
  \\      let t = task.spawn(|| sleeps(5));
  \\      task.yield();
  \\      task.cancel(t);
  \\      acc + (handle { joins(t, 20) } with { abort.raise(m) -> 1 })
  \\    });
  \\    ended(sum, climb)
  \\  }
  \\
  \\fn nothing(n: Int) -> List<Int> = [n].filter(|v: Int| v < 0)
  \\
  \\fn fails(which: Int, n: Int) -> Int / {abort.raise} =
  \\  if which == 0 { Int::of_u8(U8::of_int(256 + n)) }
  \\  else if which == 1 { b"ab".at(2 + n) }
  \\  else if which == 2 { Array::new(2, 0).get(2 + n) }
  \\  else if which == 3 { n / (n - n) }
  \\  else if which == 4 { iterate(n, 3, |i: Int| if i < 0 { Stop(i) } else { Continue(i + 1) }) }
  \\  else if which == 5 {
  \\    let [x, ..] = nothing(n);
  \\    x
  \\  } else { "a b".split("a b".slice(1, 1 + n - n)).len() }
  \\
  \\fn falls(which: Int, n: Int, depth: Int) -> Int / {abort.raise} =
  \\  if depth <= 0 { fails(which, n) } else { 1 + falls(which, n, depth - 1) }
  \\
  \\pub fn refused(n: Int, climb: Int) -> Int =
  \\  ended(
  \\    range(0, n).fold(0, |acc: Int, i: Int|
  \\      acc + (handle { falls(i % 7, i, 120) } with { abort.raise(m) -> i })),
  \\    climb,
  \\  )
  \\
  \\fn here(which: Int, n: Int) -> Int =
  \\  if which == 0 { handle { Int::of_u8(U8::of_int(256 + n)) } with { abort.raise(m) -> n } }
  \\  else if which == 1 { handle { b"ab".at(2 + n) } with { abort.raise(m) -> n } }
  \\  else if which == 2 { handle { Array::new(2, 0).get(2 + n) } with { abort.raise(m) -> n } }
  \\  else if which == 3 { handle { n / (n - n) } with { abort.raise(m) -> n } }
  \\  else if which == 4 {
  \\    handle {
  \\      iterate(n, 3, |i: Int| if i < 0 { Stop(i) } else { Continue(i + 1) })
  \\    } with { abort.raise(m) -> n }
  \\  } else if which == 5 {
  \\    handle {
  \\      let [x, ..] = nothing(n);
  \\      x
  \\    } with { abort.raise(m) -> n }
  \\  } else {
  \\    handle {
  \\      "a b".split("a b".slice(1, 1 + n - n)).len()
  \\    } with { abort.raise(m) -> n }
  \\  }
  \\
  \\pub fn refused_here(n: Int, climb: Int) -> Int =
  \\  ended(range(0, n).fold(0, |acc: Int, i: Int| acc + here(i % 7, i)), climb)
  \\
  \\pub fn refused_held(n: Int, climb: Int) -> Int =
  \\  ended(
  \\    range(0, n).fold(0, |acc: Int, i: Int|
  \\      acc
  \\        + (handle {
  \\          with_hold[slot](i, |held: Int| ()) { h -> falls(h.get() % 7, h.get(), 100) }
  \\        } with { abort.raise(m) -> i })),
  \\    climb,
  \\  )
  \\
  \\fn main() -> Int = 0
  \\

fn rounds() -> Int = 60

fn triangle(n: Int) -> Int = n * (n - 1) / 2

/// Each way, and what its rounds sum to.
fn ways() -> List<{ name: String, sum: Int }> = {
  let n = rounds();
  [
    { name: "tried", sum: triangle(n) },
    { name: "named", sum: triangle(n) },
    { name: "answered", sum: 120 * n },
    { name: "abandoned", sum: triangle(n) },
    { name: "bracketed", sum: triangle(n) },
    { name: "reentered", sum: 20 * n + triangle(n) },
    {
      name: "detached",
      sum: range(0, n).fold(0, |acc: Int, i: Int| if i % 2 == 1 { acc + 21 + i } else { acc }),
    },
    { name: "resumed", sum: 120 * n },
    { name: "again", sum: 380 * n + 3 * triangle(n) },
    { name: "again_apart", sum: 383 * n + 3 * triangle(n) },
    { name: "apart", sum: 121 * n },
    { name: "twice", sum: 281 * n + 2 * triangle(n) },
    { name: "elsewhere", sum: 170 * n + triangle(n) },
    { name: "branched", sum: 2 * triangle(n) },
    { name: "interleaved", sum: 3 * triangle(n) },
    { name: "cancelled", sum: n },
    { name: "outside", sum: n },
    { name: "joined", sum: n },
    // What a builtin raises, by each of them in turn: far down, and in the `handle`'s own body.
    { name: "refused", sum: triangle(n) },
    { name: "refused_here", sum: triangle(n) },
    { name: "refused_held", sum: triangle(n) },
    // Tasks the host schedules, whose root is the entry's own stack.
    { name: "served", sum: 2 * triangle(n) },
  ]
}

/// What `name(rounds, climb)` answered, or what it raised.
fn called(
  l: Loaded,
  name: String,
  rounds: Int,
  climb: Int,
) -> Result<Value, String> / {Driving, abort.raise} =
  match machine::answer_of(
      entered(l, name, [VInt(rounds), VInt(climb)]),
      l.roots,
      "inner." ++ name,
    ) {
    Ok(v) -> Ok(v),
    Err(r) -> Err(String::of_bytes_lossy(r.diag.message)),
  }

/// The calls `name` can still nest once `rounds` are over: the deepest climb after them that still
/// answers, found by halving between one that answers and one past every call an entry may nest.
fn room(l: Loaded, name: String, rounds: Int) -> Result<Int, String> / {Driving, abort.raise} =
  iterate({ fits: 0, fails: machine::max_calls() + 1 }, 64, |b: { fits: Int, fails: Int }|
    if b.fails - b.fits <= 1 { Stop(Ok(b.fits)) } else {
      let mid = b.fits + (b.fails - b.fits) / 2;
      match called(l, name, rounds, mid) {
        Ok(_) -> Continue({ fits: mid, fails: b.fails }),
        Err(why) -> if why.contains("nested calls") { Continue({ fits: b.fits, fails: mid }) }
        else { Stop(Err("climbing raised " ++ why)) },
      }
    })

/// What is wrong with how `name` gives back its calls, if anything: it answers `sum`, and has as
/// many calls left once its rounds are over as it had after none.
fn miscounted(
  l: Loaded,
  way: { name: String, sum: Int },
) -> Option<String> / {Driving, abort.raise} =
  match called(l, way.name, rounds(), 0) {
    Err(why) -> Some(way.name ++ " raised " ++ why),
    Ok(v) -> if v != VInt(way.sum) { Some(way.name ++ " answered another sum") } else {
      match ((room(l, way.name, 0), room(l, way.name, rounds()))) {
        (Ok(fresh), Ok(used)) -> if fresh <= 0 { Some(way.name ++ " counted no calls left") }
        else if used != fresh {
          Some(
            way.name ++ " had " ++ used.to_string() ++ " calls left after its rounds and "
              ++ fresh.to_string()
              ++ " after none",
          )
        } else { None },
        (Err(why), _) -> Some(way.name ++ ": " ++ why),
        (_, Err(why)) -> Some(way.name ++ ": " ++ why),
      }
    },
  }

test/nondet "a body left without returning keeps none of the calls it nested" {
  project([{ path: "inner.ply", text: left() }]);
  let l = loaded(default_options());
  let wrong = ways().fold([], |acc: List<String>, w: { name: String, sum: Int }|
    match miscounted(l, w) { Some(why) -> acc.push(why), None -> acc });
  let _ = unloaded(l);
  assert_eq(wrong, [])
}
