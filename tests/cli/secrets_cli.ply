import spawning.harness (WorkingDirectory, PlyProcess, write_program, all_output, spawned)

fn printed_nowhere(
  source: String,
  payloads: List<String>,
) -> Unit / {PlyProcess, WorkingDirectory, abort.raise} = {
  write_program(source);
  let text = spawned(["test", ".", "--no-cache"]);
  let json = spawned(["test", ".", "--no-cache", "--json"]);
  assert(text.code != 0 && json.code != 0, Some(all_output(text)));
  payloads.fold((), |u: Unit, p: String|
    assert(
      !all_output(text).contains(p) && !all_output(json).contains(p),
      Some(all_output(text) ++ all_output(json)),
    ));
  assert(all_output(text).contains("Secret"), Some(all_output(text)))
}

test/nondet "a failing assertion over secrets prints no payload" {
  printed_nowhere(
    "test \"two logins differ\" {\n  assert_eq(\n    {user: \"ada\", password: Secret::of_string(\"hun\" ++ \"ter2\")},\n    {user: \"ada\", password: Secret::of_string(\"correct\" ++ \"-horse\")})\n}\n",
    ["hunter2", "correct-horse"],
  )
}

test/nondet "a failing assertion over secrets of bytes prints no payload" {
  printed_nowhere(
    "test \"two keys differ\" {\n  assert_eq(Secret::of_bytes(b\"hun\" ++ b\"ter2\"), Secret::of_bytes(b\"corr\" ++ b\"ect-\").concat(Secret::of_bytes(b\"hor\" ++ b\"se\")))\n}\n",
    ["hunter2", "horse"],
  )
}
