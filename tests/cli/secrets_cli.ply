//! A failing test over credentials, as a person and a document read it: what failed and that a
//! secret was there, and never the payload.

import harness (Here, Spawned, program, said, spawned)

// Each payload is assembled at run time, so the source line a failure quotes does not hold it.
fn printed_nowhere(source: String, payloads: List<String>) -> Unit / {Spawned, Here, abort.raise} = {
  program(source);
  let text = spawned(["test", "--no-cache"]);
  let json = spawned(["test", "--no-cache", "--json"]);
  assert(text.code != 0 && json.code != 0, Some(said(text)));
  payloads.fold((), |u: Unit, p: String|
    assert(!said(text).contains(p) && !said(json).contains(p), Some(said(text) ++ said(json))));
  assert(said(text).contains("Secret"), Some(said(text)))
}

test/nondet "a failing assertion over secrets prints no payload" {
  printed_nowhere(
    "test \"two logins differ\" {\n  assert_eq(\n    {user: \"ada\", password: Secret::of_string(\"hun\" ++ \"ter2\")},\n    {user: \"ada\", password: Secret::of_string(\"correct\" ++ \"-horse\")})\n}\n",
    ["hunter2", "correct-horse"],
  )
}

test/nondet "a failing assertion over secrets of bytes prints no payload" {
  printed_nowhere(
    "test \"two keys differ\" {\n  assert_eq(Secret::of_bytes(b\"hun\" ++ b\"ter2\"), Secret::of_bytes(b\"corr\" ++ b\"ect-\").concat(Secret::of_bytes(b\"hor\" ++ b\"se\")))\n}\n",
    ["hunter2", "horse"],
  )
}
