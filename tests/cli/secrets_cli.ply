import harness (spawned)
import support.harness (write_program, all_output)

fn failing_over_secrets() -> String =
  \\test "two logins differ" {
  \\  assert_eq(
  \\    {user: "ada", password: Secret::of_string("hun" ++ "ter2")},
  \\    {user: "ada", password: Secret::of_string("correct-ho" ++ "rse")})
  \\}
  \\
  \\test "two keys differ" {
  \\  assert_eq(
  \\    Secret::of_bytes(b"hun" ++ b"ter2"),
  \\    Secret::of_bytes(b"corr" ++ b"ect-").concat(Secret::of_bytes(b"hor" ++ b"se")))
  \\}
  \\

test/nondet "a failing assertion over secrets prints no payload" {
  write_program(failing_over_secrets());
  let text = spawned(["test", ".", "--no-cache"]);
  let json = spawned(["test", ".", "--no-cache", "--json"]);
  assert(text.code != 0 && json.code != 0, Some(all_output(text)));
  ["hunter2", "correct-horse", "horse"].fold((), |u: Unit, payload: String|
    assert(
      !all_output(text).contains(payload) && !all_output(json).contains(payload),
      Some(all_output(text) ++ all_output(json)),
    ));
  assert(all_output(text).contains("Secret"), Some(all_output(text)))
}
