//! The repository's own code audited, each night and in no pull request. The standard library, the
//! package of its tests, the compiler and the CLI, each checked as the project it is: a definition
//! nothing reaches is one to delete, a signature naming an effect its body never performs is one to
//! narrow, and only this run checks the measures the standard library's own definitions state.

import harness (PlyProcess, spawned)
import support.harness (Repo, at, items, json_of, path, repo, str)
import std.json (Json)
import std.string

/// Where the repository's `ply.work` places the part of `ply` named `part`.
fn placed(part: String) -> String / {PlyProcess, Repo, abort.raise} =
  str(path(json_of(spawned(["work", "--json", repo()])), ["workspace", "toolchain", part]))

/// What a check of `dir` finds to fix: each error, each signature naming an effect its body never
/// performs, and where `reaching`, each definition nothing reaches.
fn assert_checks_clean(dir: String, reaching: Bool) -> Unit / {PlyProcess, Repo, abort.raise} = {
  let v = json_of(spawned(["check", "--json", repo() ++ "/" ++ dir]));
  let found = items(at(v, "diagnostics")).fold([], |a: List<String>, d: Json| {
    let code = str(at(d, "code"));
    if (reaching && code == "W0611") || code == "W0614" || str(at(d, "severity")) == "error" {
      a.push(code ++ " " ++ str(at(d, "message")))
    } else { a }
  });
  assert(
    found == [],
    Some(
      dir
        ++ " has errors, definitions nothing reaches, which are to be deleted, or effects naming an "
        ++ "effect no body on them performs, which are to be narrowed:\n  "
        ++ String::join(found, "\n  "),
    ),
  )
}

test/nondet "the standard library checks, reaches every definition and performs every effect it writes" {
  assert_checks_clean(placed("std"), true)
}

test/nondet "the standard library's tests check, reach every definition and perform every effect they write" {
  assert_checks_clean(placed("std_tests"), true)
}

test/nondet "the compiler checks, reaches every definition and performs every effect it writes" {
  assert_checks_clean(placed("compiler"), true)
}

test/nondet "the CLI checks and performs every effect it writes" {
  assert_checks_clean(placed("cli"), false)
}
