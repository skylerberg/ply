import harness (Repo, PlyProcess, at, items, json_of, toolchain_parts, repo, spawned, str)
import std.json (Json, Array, Str, object)
import std.list
import std.string

fn unperformed(report: Json) -> List<String> / {abort.raise} =
  items(at(report, "definitions")).fold([], |accumulator: List<String>, d: Json|
    match items(at(d, "declared_not_performed")) {
      [] -> accumulator,
      undone ->
        accumulator.push(str(at(d, "name")) ++ " declares " ++ String::join(undone.map(str), ", ")),
    })

fn assert_checks_clean(
  dir: String,
  reject_unused_definitions: Bool,
) -> Unit / {PlyProcess, Repo, abort.raise} = {
  let v = json_of(spawned(["check", "--json", "--types", "--explain", repo() ++ "/" ++ dir]));
  let found = items(at(v, "diagnostics")).fold([], |a: List<String>, d: Json|
    if (reject_unused_definitions && str(at(d, "code")) == "W0611")
        || str(at(d, "severity")) == "error" {
      a.push(str(at(d, "code")) ++ " " ++ str(at(d, "message")))
    } else { a }).concat(
    unperformed(v),
  );
  assert(
    found == [],
    Some(
      dir
        ++ " has errors, definitions nothing reaches, which are to be deleted, or effects naming an "
        ++ "effect no body on them performs, which are to be narrowed:\n  "
        ++ String::join(found, "\n  "),
    ),
  )
}

test/nondet "the standard library has no check errors, no unused definitions and no effect declared but not performed" {
  assert_checks_clean(toolchain_parts().std, true)
}

test/nondet "the standard library's tests have no check errors, no unused definitions and no effect declared but not performed" {
  assert_checks_clean(toolchain_parts().std_tests, true)
}

test/nondet "the compiler's source has no check errors, no unused definitions and no effect declared but not performed" {
  assert_checks_clean(toolchain_parts().compiler, true)
}

test/nondet "the CLI's source has no check errors and no effect declared but not performed" {
  assert_checks_clean(toolchain_parts().cli, false)
}

test "a definition that declares an effect its body never performs is named with the effect" {
  let d = |name: String, undone: List<String>|
    object([
      { key: "name", value: Str(name) },
      { key: "declared_not_performed", value: Array(undone.map(|u: String| Str(u))) },
    ]);
  let report = object([
    { key: "definitions", value: Array([d("m.kept", []), d("m.wide", ["abort.raise", "m.e.op"])]) },
  ]);
  assert_eq(unperformed(report), ["m.wide declares abort.raise, m.e.op"])
}
