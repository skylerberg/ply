import spawning.harness (write_program, all_output, spawned, assert_ok, value_of)
import std.json (Json)
import std.list
import std.string

fn naming() -> String = String::of_bytes_lossy(embed("../programs/stdlib/naming.ply"))

test/nondet "a program runs what a shipped module embedded, from the binary and from a built artifact" {
  write_program(naming());
  assert_ok(spawned(["check", "."]));
  assert_eq(value_of(spawned(["run", ".", "--json"])), "10");
  let tested = spawned(["test", "."]);
  assert(tested.code == 0 && all_output(tested).contains("1 passed"), Some(all_output(tested)));
  assert_ok(spawned(["build", ".", "-o", "m.plyx"]));
  assert_eq(value_of(spawned(["run", "--json", "m.plyx"])), "10")
}
