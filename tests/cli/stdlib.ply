//! The shipped modules as a project meets them: imported, checked, bound, hashed, tested and proved
//! like its own, under a prefix no project may take, and never counted as the project's.

import harness (scratch, Ran, Source, project, program, write, in_memory, one, tree, on_disk,
                warm_agrees, said, stdout, json_of, at, path, nth, items, first, str, int, truth,
                shown, Hermetic, Shipped, std_tree, std_data, module_in, StdModule, std_modules,
                on_disk_shipping, on_disk_shipping_only, over_tree, spawned, assert_ok, codes,
                with_prelude_shipped)
import compiler.syntax.exprs (prelude_module)
import compiler.front (shipped_data_wanted)
import compiler.syntax.items (parse, Item, IFn, IType, IEffect, IEffectSet, ISchema, OpDef, is_pub)
import compiler.syntax.lexer (lex, Identifier, Token, Punctuation, Keyword, EndOfInput)
import compiler.syntax.parsing (Doc)
import std.fs (MemFs)
import std.json (Json)
import std.list
import std.process (process, Exited)
import std.string
import std.text (shell_join)

/// Handles every atom it can perform, so its test is `det` and cacheable.
fn importer() -> String =
  \\import std.net (net, drain)
  \\
  \\fn touch(port: Int) -> Int / {net.listen[listener], net.close[listener]} = {
  \\  let l = net.listen[listener](port);
  \\  net.close[listener](l);
  \\  l
  \\}
  \\
  \\test "the imported effect is handled in memory" {
  \\  handle {
  \\    assert_eq(touch(8080), 3)
  \\  } with {
  \\    net.listen[listener](p) -> 3,
  \\    net.close[listener](l) -> (),
  \\  }
  \\}
  \\

fn app(text: String) -> MemFs / {abort.raise} = tree([{ path: "app.ply", text: text }])

fn checked(t: MemFs) -> Json / {Hermetic, Shipped, abort.raise, diverges} =
  json_of(in_memory(t, ["check", "--json"]))

fn named(list: Json, name: String) -> Option<Json> =
  match items(list).filter(|d: Json| str(at(d, "name")) == name) { [d, ..] -> Some(d), [] -> None }

fn has_named(list: Json, name: String) -> Bool = named(list, name) != None

/// A definition's hash, as `ply hash --json` gives it.
fn hash_of(answer: Json, name: String) -> String / {abort.raise} =
  match named(at(answer, "definitions"), name) {
    Some(d) -> str(at(d, "hash")),
    None -> panic("`" ++ name ++ "` is not in the program: " ++ shown(answer)),
  }

fn hashed(t: MemFs) -> Json / {Hermetic, Shipped, abort.raise, diverges} =
  json_of(in_memory(t, ["hash", "--json"]))

fn tests_hashed(answer: Json) -> List<String> =
  items(at(answer, "tests")).map(|t: Json| str(at(t, "hash")))

test "a project module can import std.net and it checks" {
  let answer = checked(app(importer()));
  assert(truth(at(answer, "ok")), Some(shown(answer)));
  assert(
    has_named(at(answer, "modules"), "std.net"),
    Some("the shipped module is not in the program"),
  );
  // `ply_host::tcp` registers against the program-wide name, qualified by the declaring module.
  assert(
    items(at(answer, "effects")).filter(|e: Json|
        str(at(e, "module")) == "std.net" && str(at(e, "name")) == "std.net.net").len(
      )
      == 1,
    Some(shown(at(answer, "effects"))),
  );
  assert(has_named(at(answer, "definitions"), "std.net.drain"), None);
  // The row a host handler binds against, written in the qualified name.
  match named(at(answer, "definitions"), "app.touch") {
    Some(touch) ->
      assert_eq(
        str(at(touch, "footprint")),
        "{std.net.net.close[listener], std.net.net.listen[listener]}",
      ),
    None -> panic("`app.touch` is in the program"),
  }
}

test "a shipped module whose type states a key and its arithmetic loads where nothing of it is used" {
  scratch(|| {
    // The type is read whether or not the program reaches it, so the functions it states are too.
    program("import std.bigint\n\nfn main() -> Int = 1\n\ntest \"one\" { assert_eq(main(), 1) }\n");
    let checked = on_disk(["check"]);
    assert(checked.code == 0, Some(said(checked)));
    let r = on_disk(["test"]);
    assert(r.code == 0 && said(r).contains("1 passed"), Some(said(r)));
    // Used only where an operator and a comparison reach them, they are the same functions.
    write(
      "m.ply",
      "import std.bigint (BigInt)\n\nfn same(a: BigInt, b: BigInt) -> Bool = a + b == b + a\n\nfn main() -> Int = 1\n",
    );
    let used = on_disk(["check"]);
    assert(used.code == 0, Some(said(used)))
  })
}

test "ply hosts binds the shipped declaration under its qualified name" {
  scratch(|| {
    project([{ path: "app.ply", text: importer() }]);
    let r = on_disk(["hosts", "--host", "--json"]);
    assert(r.code == 0, Some("got:\n" ++ said(r)));
    let rows = items(at(json_of(r), "hosts"));
    assert(rows != [], Some("nothing bound: " ++ said(r)));
    assert(
      rows.filter(|row: Json| str(at(row, "effect")) != "std.net.net").len() == 0,
      Some(said(r)),
    );
    assert(
      rows.filter(|row: Json| str(at(row, "triple")) == "std.net.net.listen[listener]").len() > 0,
      Some(said(r)),
    );
    // A program declaring its own `net` reaches no handler: the registration names `std.net.net`
    // only.
    project([
      {
        path: "app.ply",
        text: "nondet effect net {\n  write listen[s](port: Int) -> Int\n}\nfn f() -> Int / {net.write[listener]} = net.listen[listener](1)\n",
      },
    ]);
    let other = on_disk(["hosts", "--host"]);
    assert(
      said(other).contains("none serves an atom this program performs"),
      Some("a copied declaration must not bind:\n" ++ said(other)),
    )
  })
}

test "a project file under std collides with the built-in package" {
  let answer = checked(tree([{ path: "std/json.ply", text: "pub fn parse() -> Int = 1\n" }]));
  let diagnostics = items(at(answer, "diagnostics"));
  assert(diagnostics.len() == 1, Some(shown(answer)));
  let d = first(diagnostics);
  assert(str(at(d, "code")) == "E0133", Some(shown(d)));
  assert(str(at(d, "message")).contains("std.json"), Some(shown(d)));
  assert(
    items(at(d, "labels")) != [],
    Some("E0133 must point at the file it is about: " ++ shown(d)),
  )
}

// Easy to miss when the rule is written as a prefix check.
test "a project file named std also collides" {
  let answer = checked(tree([{ path: "std.ply", text: "pub fn f() -> Int = 1\n" }]));
  assert(str(at(first(items(at(answer, "diagnostics"))), "code")) == "E0133", Some(shown(answer)));
  // And a name that merely starts with the letters is no collision.
  let ok = in_memory(tree([{ path: "stdlib.ply", text: "pub fn f() -> Int = 1\n" }]), ["check"]);
  assert(ok.code == 0, Some("`stdlib` is an ordinary module name: " ++ said(ok)))
}

test "importing a module that does not ship lists the ones that do" {
  let answer = checked(app("import std.nonesuch\nfn f() -> Int = 1\n"));
  let d = first(items(at(answer, "diagnostics")));
  assert(str(at(d, "code")) == "E0106", Some(shown(d)));
  assert(shown(d).contains("std.net"), Some(shown(d)));
  assert(
    items(at(d, "labels")) != [],
    Some("the diagnostic must point at the import: " ++ shown(d)),
  )
}

fn rendering(u: String) -> String =
  "import std.uuid (Uuid, uuid_render)\npub fn shown(b: Bytes) -> String / {abort.raise} = {\n  let u"
    ++ u
    ++ " = { octets: b };\n  uuid_render(u)\n}\n"

test "a record with a `Uuid`'s field is no `Uuid`, and only `std.uuid` builds one" {
  let closed = first(items(at(checked(app(rendering(": Uuid"))), "diagnostics")));
  assert(str(at(closed, "code")) == "E0220", Some(shown(closed)));
  assert(shown(closed).contains("uuid_of_octets"), Some(shown(closed)));
  let d = first(items(at(checked(app(rendering(""))), "diagnostics")));
  assert(str(at(d, "code")) == "E0201", Some(shown(d)));
  assert(shown(d).contains("std.uuid.Uuid"), Some(shown(d)));
  let built = "import std.uuid (uuid_of_octets, uuid_render)\npub fn shown(b: Bytes) -> Option<String> / {abort.raise} =\n  match uuid_of_octets(b) { Some(u) -> Some(uuid_render(u)), None -> None }\n";
  assert_eq(items(at(checked(app(built)), "diagnostics")), [])
}

test "a program importing nothing from std loads `std.prelude` alone, listed as any shipped module" {
  let answer = checked(app("fn f() -> Int = 1\n"));
  let modules = items(at(answer, "modules"));
  assert_eq(modules.map(|m: Json| str(at(m, "name"))), ["app", prelude()]);
  assert_eq(items(at(answer, "files")).map(str), modules.map(|m: Json| str(at(m, "file"))));
  assert(str(at(first(modules.drop(1)), "file")).starts_with("<std>/"), Some(shown(answer)));
  assert(
    items(at(answer, "definitions")).filter(|d: Json| str(at(d, "name")).starts_with("std.")).len()
      == 0,
    Some(shown(answer)),
  );
  // What a call of `map` reaches of the prelude is its function written in Ply, read as a shipped
  // module's.
  let mapping = checked(app("pub fn f(xs: List<Int>) -> List<Int> = xs.map(|x: Int| x + 1)\n"));
  assert(has_named(at(mapping, "definitions"), prelude() ++ ".List::map"), Some(shown(mapping)));
  let listed = items(at(json_of(in_memory(app(""), ["std", "--json"])), "modules"));
  assert(listed.any(|m: Json| str(at(m, "module")) == prelude()), None)
}

/// The module every module imports, as the compiler names it.
fn prelude() -> String = String::of_bytes_lossy(prelude_module())

/// The module each module of `sources` ships as, in name order.
fn modules_of(sources: List<Source>) -> List<String> / {abort.raise} =
  sources.filter(|s: Source| s.path.ends_with(".ply")).map(|s: Source|
    s.path.slice(0, s.path.len() - 4)).sort(
  )

/// The modules a compiler that ships only `handed` ships beside them: those every module imports.
fn beside(handed: List<Source>) -> List<String> / {abort.raise} = {
  let own = modules_of(handed);
  modules_of(with_prelude_shipped(handed)).filter(|m: String| !own.contains(m))
}

/// Whether `name` is a definition's, a test's or a claim's of one of `modules`.
fn in_any(name: String, modules: List<String>) -> Bool =
  modules.any(|m: String| name.starts_with(m ++ "."))

/// How many times the texts of `sources` and `more` write any of `words`.
fn written(sources: List<Source>, more: List<String>, words: List<String>) -> Int / {abort.raise} =
  sources.map(|s: Source| s.text).concat(more).fold(0, |n: Int, text: String|
    words.fold(n, |k: Int, word: String| k + text.split(word).len() - 1))

test "a shipped module's definitions hash as a project's copy of them does" {
  scratch(|| {
    let kept = match two_shipped().filter(|s: Source| s.path == "std.kept.ply") {
      [s, ..] -> s.text,
      [] -> panic("`two_shipped` ships `std.kept`"),
    };
    let caller = |module: String|
      "import " ++ module ++ " (one)\n\npub fn two() -> Int = one() + one()\n";
    let hashes = |files: List<Source>| {
      project(files);
      json_of(on_disk_shipping_only(["hash", "--json"], two_shipped()))
    };
    let shipped = hashes([{ path: "app.ply", text: caller("std.kept") }]);
    let copied = hashes([
      { path: "mine.ply", text: kept },
      { path: "app.ply", text: caller("mine") },
    ]);
    assert(
      hash_of(shipped, "std.kept.one") == hash_of(copied, "mine.one"),
      Some("a shipped definition must hash like a project one"),
    );
    // A reference contributes the referent's hash, so the importer is one definition in both
    // programs.
    assert_eq(hash_of(shipped, "app.two"), hash_of(copied, "app.two"))
  })
}

// `ply cache compact` walks the files on disk, and a shipped module has none.
test "a shipped module is filed under its pseudo-path, and compaction keeps it" {
  scratch(|| {
    program(keeping());
    assert_ok(on_disk_shipping_only(["test"], two_shipped()));
    // Filed under the name a shipped module is keyed by, which no file on disk has.
    let filed = ||
      items(
        at(
          json_of(
            on_disk_shipping_only(["cache", "inspect", "std.kept.one", "--json"], two_shipped()),
          ),
          "matches",
        ),
      ).map(|m: Json| str(at(m, "file")));
    assert_eq(filed(), ["<std>/kept.ply"]);
    assert_ok(on_disk_shipping_only(["cache", "compact"], two_shipped()));
    assert(
      filed() == ["<std>/kept.ply"],
      Some("compaction dropped a module this binary still ships"),
    )
  })
}

test "a warm check agrees with a cold one over a program that imports std" {
  scratch(|| {
    project([{ path: "app.ply", text: importer() }]);
    let _ = warm_agrees("cold");
    let warm = warm_agrees("warm");
    assert(
      has_named(at(warm, "definitions"), "std.net.drain"),
      Some("the shipped module is part of the answer: " ++ shown(warm)),
    )
  })
}

// `std.zb` of `alike_shipped` declares `effect zb` beside `fn zb`, as `std.gzip` does, and its
// readers raise through the effect.
test "a load takes of a shipped module what the program reaches, its effect apart from the function of that name" {
  scratch(|| {
    let loaded = |text: String| {
      program(text);
      let v = json_of(on_disk_shipping_only(["check", "--json"], alike_shipped()));
      assert(truth(at(v, "ok")), Some(shown(v)));
      at(v, "definitions")
    };
    let reader = loaded(
      "import std.zb (try_read)\n\npub fn opens(x: Int) -> Bool =\n  match try_read(x) { Ok(_) -> true, Err(_) -> false }\n",
    );
    assert(
      has_named(reader, "std.zb.try_read") && has_named(reader, "std.zb.read")
        && !has_named(reader, "std.zb.zb")
        && !has_named(reader, "std.zb.written"),
      Some(shown(reader)),
    );
    // The import names the effect and the function alike, and only a call reaches the function.
    let answering = loaded(
      "import std.zb\nimport std.zb (zb)\n\npub fn opens(x: Int) -> Bool =\n  match try[zb.refused] { zb::read(x) } { Ok(_) -> true, Err(_) -> false }\n",
    );
    assert(
      has_named(answering, "std.zb.read") && !has_named(answering, "std.zb.zb")
        && !has_named(answering, "std.zb.written"),
      Some(shown(answering)),
    );
    let writer = loaded("import std.zb (zb)\n\npub fn packed(x: Int) -> Int = zb(x)\n");
    assert(
      has_named(writer, "std.zb.zb") && has_named(writer, "std.zb.written")
        && !has_named(writer, "std.zb.read"),
      Some(shown(writer)),
    )
  })
}

test "renaming a project definition that calls a shipped one moves no hash" {
  let hashed_with = |text: String|
    over_tree(one(text), ||
      json_of(on_disk_shipping_only(["hash", "--json"], two_shipped()))).value;
  let before = hashed_with(keeping());
  let after = hashed_with(keeping().replace("held", "upheld"));
  assert(
    hash_of(before, "m.held") == hash_of(after, "m.upheld"),
    Some("renaming a definition changed its hash"),
  );
  assert_eq(hash_of(before, "std.kept.one"), hash_of(after, "std.kept.one"));
  assert(tests_hashed(before) == tests_hashed(after), Some("a test re-runs"))
}

/// A standard library of two modules, each stating a test and a law, and the data file one of them
/// embeds: a compiler that shipped only these runs every one of them in the time two modules take.
fn two_shipped() -> List<Source> =
  [
    {
      path: "std.idle.ply",
      text:
        \\//! A module no program here imports, and the file beside it.
        \\
        \\/// Twice `n`.
        \\pub fn twice(n: Int) -> Int requires n > -100 && n < 100 ensures result == n + n = n * 2
        \\
        \\/// What the file beside this module holds.
        \\pub fn words() -> Bytes = embed("idle/words.txt")
        \\
        \\test "twice two is four" { assert_eq(twice(2), 4) }
        \\
        \\test "the words are the file's" { assert_eq(words(), b"one\n") }
        \\
        \\law "twice is a sum" forall (n: Int) where n > 0 && n < 9 { twice(n) == n + n }
        \\
    },
    { path: "std/idle/words.txt", text: "one\n" },
    {
      path: "std.kept.ply",
      text:
        \\//! A module the program imports.
        \\
        \\/// One.
        \\pub fn one() -> Int = 1
        \\
        \\test "one is one" { assert_eq(one(), 1) }
        \\
        \\law "one is the least of them" forall (n: Int) where n > 0 && n < 9 { one() <= n }
        \\
    },
  ]

/// A program that imports `std.kept` of `two_shipped` and states a test and a claim of its own.
// `held` calls the shipped `one` and claims nothing of it: a shipped body is not a project's prover's
// to read.
fn keeping() -> String =
  \\import std.kept
  \\
  \\pub fn held(n: Int) -> Int requires n < 100 ensures result == n + 1 = {
  \\  let _ = kept::one();
  \\  n + 1
  \\}
  \\
  \\test "mine" { assert_eq(held(1), 2) }
  \\

/// A `ply.work` that places the toolchain's library below `lib/`.
fn toolchain_work() -> String =
  "import std.pkg (Workspace)\n\nfn workspace() -> Workspace = {\n  packages: [],\n  suites: [],\n  fixtures: [],\n  toolchain: Some({\n    std: \"lib/std\",\n    std_tests: \"tests/std\",\n    compiler: \"lib/compiler\",\n    cli: \"cli\",\n    entry: \"ply.main\",\n    cli_tests: \"tests/cli\",\n    runtime: \"ply-runtime\",\n  }),\n}\n"

/// Where the library keeps the file the shipped modules name `name`: a module at the place its name
/// gives it (`std/kept/deep.ply` for `std.kept.deep.ply`), a data file at its own name.
fn filed_at(name: String) -> String / {abort.raise} =
  if name.ends_with(".ply") { name.slice(0, name.len() - 4).replace(".", "/") ++ ".ply" }
  else { name }

/// A checkout of the toolchain whose standard library is `std` beside the toolchain's prelude: its
/// `ply.work`, then each module and data file below `lib/`, where a load inside the checkout reads
/// its library.
fn checkout(std: List<Source>) -> List<Source> / {abort.raise} =
  [{ path: "ply.work", text: toolchain_work() }].concat(
    with_prelude_shipped(std).map(|s: Source| { path: "lib/" ++ filed_at(s.path), text: s.text }),
  )

// A shipped module's tests are its library's: a project's run takes in none, and a run of the
// library's own directory in its checkout takes in every module's, whatever imports them.
test "a shipped module's tests are not a project's, and the library's checkout runs every one" {
  scratch(|| {
    project(checkout(two_shipped()).push({ path: "app/m.ply", text: keeping() }));
    let v = json_of(on_disk(["test", "app", "--json"]));
    assert(int(path(v, ["selection", "total"])) == 1, Some(shown(v)));
    // A shipped test was never in this project's denominator, so it is not "filtered out" either.
    assert(int(path(v, ["selection", "filtered_out"])) == 0, Some(shown(v)));
    let all = json_of(on_disk(["test", "lib/std", "--json"]));
    assert(int(at(all, "exit_code")) == 0, Some(shown(all)));
    let keys = items(path(all, ["selection", "tests"])).map(|t: Json| str(at(t, "key")));
    // Nothing imports `std.idle`: its tests are in the run, the one that reads its data file too.
    assert_eq(keys.filter(|k: String| !in_any(k, beside(two_shipped()))).sort(), [
      "std.idle.the words are the file's",
      "std.idle.twice two is four",
      "std.kept.one is one",
    ]);
    // Run once, every one of them is answered by its own pass.
    let again = json_of(on_disk(["test", "lib/std", "--json"]));
    assert(int(path(again, ["selection", "cached"])) == keys.len(), Some(shown(again)));
    assert(int(path(again, ["selection", "by_code"])) == 0, Some(shown(again)))
  })
}

/// Two shipped modules that each declare a `Limits` of one shape, as `std.zstd` and `std.xz` do,
/// and an effect beside a function of one name, as `std.gzip` has them.
fn alike_shipped() -> List<Source> =
  [
    {
      path: "std.za.ply",
      text:
        \\//! The first of two modules with a `Limits` alike.
        \\
        \\/// How far a decode may go.
        \\pub type Limits = new { output: Int, window: Int }
        \\
        \\/// The sum of the bounds.
        \\pub fn fa(l: Limits) -> Int = l.output + l.window
        \\
    },
    {
      path: "std.zb.ply",
      text:
        \\//! The second of two modules with a `Limits` alike, and an effect beside a function.
        \\
        \\/// How far a decode may go.
        \\pub type Limits = new { output: Int, window: Int }
        \\
        \\/// The product of the bounds.
        \\pub fn fb(l: Limits) -> Int = l.output * l.window
        \\
        \\/// Why a read stopped.
        \\pub effect zb {
        \\  raise refused(at: Int)
        \\}
        \\
        \\fn written(x: Int) -> Int = x * 31 + 7
        \\
        \\/// The writer.
        \\pub fn zb(x: Int) -> Int = written(x)
        \\
        \\/// The reader.
        \\pub fn read(x: Int) -> Int / {zb.refused} = if x < 0 { zb.refused(x) } else { x + 1 }
        \\
        \\/// The reader, answering where it was refused.
        \\pub fn try_read(x: Int) -> Result<Int, Int> = try[zb.refused] { read(x) }
        \\
    },
  ]

// The build prints its closure back and checks it again, so each `Limits` has to be printed under
// the name the definition that refers to it names, and the effect `zb` holds none of `fn zb`.
test "a program over shipped modules that name one record alike, and an effect beside a function, builds and runs as its source" {
  scratch(|| {
    program(
      \\import std.za
      \\import std.zb
      \\import std.zb (zb)
      \\
      \\fn roomy() -> zb::Limits = { output: 1, window: 2 }
      \\
      \\fn main() -> Int = {
      \\  let got: Result<Int, Int> = try[zb.refused] { zb::read(1) };
      \\  let read = match got { Ok(n) -> n, Err(_) -> -1 };
      \\  zb::fb(roomy()) + za::fa({ output: 3, window: 4 }) + read * 100
      \\}
      \\
    );
    assert_ok(on_disk_shipping_only(["build", ".", "-o", "app.plyx"], alike_shipped()));
    let ran = json_of(on_disk_shipping_only(["run", "app.plyx", "--json"], alike_shipped()));
    assert(str(at(ran, "value")) == "209", Some(shown(ran)))
  })
}

// A shipped `main` would make `ply run` ambiguous in a directory the user did not write.
test "entry points exclude the shipped modules" {
  scratch(|| {
    program("import std.entered\n\nfn main() -> Int = 1\n");
    let r = on_disk_shipping_only(["run"], [
      {
        path: "std.entered.ply",
        text: "//! A module with a `main` of its own.\n\n/// Not the program's entry.\npub fn main() -> Int = 7\n",
      },
    ]);
    assert(r.code == 0, Some(said(r)));
    assert_eq(last_line(r), "1")
  })
}

test "ply std lists each module and data file it ships, prints either by name, and its digest covers both" {
  scratch(|| {
    let ply_std = |argv: List<String>, shipped: List<Source>|
      on_disk_shipping_only(["std"].concat(argv), shipped);
    let digest_of = |shipped: List<Source>| stdout(ply_std(["--digest"], shipped)).trim();
    let digest = digest_of(two_shipped());
    assert(digest.starts_with("b3:") && digest.len() == 15, Some(digest));
    let listing = ply_std([], two_shipped());
    assert(listing.code == 0, Some("got:\n" ++ said(listing)));
    [
      "std.idle",
      "std.kept",
      "std/idle/words.txt · 4 bytes · embedded by std.idle",
      "digest: " ++ digest,
    ].fold((), |u: Unit, needle: String|
      assert(said(listing).contains(needle), Some("got:\n" ++ said(listing))));
    assert_eq(str(at(json_of(ply_std(["--json"], two_shipped())), "digest")), digest);
    let data = ply_std(["--show", "std/idle/words.txt"], two_shipped());
    assert(data.code == 0 && stdout(data) == "one\n", Some(said(data)));
    // Bare, it prints the modules' sources back to back and no data file.
    let sources = with_prelude_shipped(two_shipped()).fold("", |acc: String, s: Source|
      if s.path.ends_with(".ply") { acc ++ s.text } else { acc });
    assert_eq(stdout(ply_std(["--show"], two_shipped())), sources);
    let moved = two_shipped().map(|s: Source|
      if s.path == "std/idle/words.txt" { { ..s, text: "two\n" } } else { s });
    assert(digest_of(moved) != digest, Some("the digest covers the data a module embeds"));
    assert_eq(digest_of(two_shipped()), digest)
  })
}

/// A standard library whose `std.kept.deep` is `kept/deep.ply` beneath `std.kept`'s `kept.ply`, each
/// embedding a file of the directory they share, in the order a flat directory lists their files.
fn nested_shipped() -> List<Source> =
  [
    {
      path: "std.kept.deep.ply",
      text:
        \\//! A module beneath another.
        \\
        \\import std.kept (one)
        \\
        \\/// One more than the module above's one.
        \\pub fn two() -> Int = one() + 1
        \\
        \\/// What the file beneath this module holds.
        \\pub fn words() -> Bytes = embed("deep/words.txt")
        \\
        \\test "two is two" { assert_eq(two(), 2) }
        \\
    },
    { path: "std/kept/deep/words.txt", text: "deep\n" },
    {
      path: "std.kept.ply",
      text:
        \\//! A module with another beneath it.
        \\
        \\/// One.
        \\pub fn one() -> Int = 1
        \\
        \\/// What the file beside the module beneath this one holds.
        \\pub fn list() -> Bytes = embed("kept/list.txt")
        \\
    },
    { path: "std/kept/list.txt", text: "one\n" },
  ]

test "a module beneath another ships under its place: listed in name order, documented and run" {
  scratch(|| {
    program(
      \\import std.kept (list)
      \\import std.kept.deep (two, words)
      \\
      \\test "both" {
      \\  assert_eq(two(), 2);
      \\  assert_eq(list(), b"one\n");
      \\  assert_eq(words(), b"deep\n")
      \\}
      \\
    );
    let listed = items(
      at(json_of(on_disk_shipping_only(["std", "--json"], nested_shipped())), "modules"),
    );
    assert_eq(
      listed.map(|m: Json| str(at(m, "module"))),
      modules_of(with_prelude_shipped(nested_shipped())),
    );
    let handed = listed.filter(|m: Json| !beside(nested_shipped()).contains(str(at(m, "module"))));
    assert_eq(handed.map(|m: Json| items(at(m, "data")).map(|d: Json| str(at(d, "name")))), [
      ["std/kept/list.txt"],
      ["std/kept/deep/words.txt"],
    ]);
    let doc = on_disk_shipping_only(["doc", "std.kept.deep.two"], nested_shipped());
    assert(doc.code == 0 && said(doc).contains("One more than"), Some(said(doc)));
    let ran = json_of(on_disk_shipping_only(["test", "--json"], nested_shipped()));
    assert(int(at(ran, "exit_code")) == 0, Some(shown(ran)));
    // The library's checkout names each module by its place below the library, and runs its test.
    project(checkout(nested_shipped()));
    let library = json_of(on_disk(["test", "lib/std", "--json"]));
    assert(int(at(library, "exit_code")) == 0, Some(shown(library)));
    let keys = items(path(library, ["selection", "tests"])).map(|t: Json| str(at(t, "key")));
    assert_eq(keys.filter(|k: String| !in_any(k, beside(nested_shipped()))), [
      "std.kept.deep.two is two",
    ])
  })
}

test "ply doc documents a module of the standard library beneath another, and a name it publishes" {
  let t = app("fn f() -> Int = 1\n");
  let module = in_memory(t, ["doc", "std.hash.legacy"]);
  assert(
    module.code == 0 && said(module).contains("MD5 and SHA-1, which are broken"),
    Some(said(module)),
  );
  let one = in_memory(t, ["doc", "std.hash.legacy.sha1"]);
  assert(one.code == 0 && said(one).contains("at <std>/hash/legacy.ply:"), Some(said(one)))
}

test "programs that reach different functions of one shipped module share what a load keeps of it" {
  scratch(|| {
    project([
      {
        path: "a.ply",
        text: "import std.json (Json, array)\nimport std.process (process)\n\npub fn main() -> Json = array([])\n",
      },
      {
        path: "b.ply",
        text: "import std.json (Json, int)\nimport std.fs (fs)\n\npub fn main() -> Json = int(1)\n",
      },
      {
        path: "c.ply",
        text: "import std.json (Json, array)\n\npub fn twice() -> Json = array([array([])])\n",
      },
    ]);
    // `b` reads `std.json` through what `a` kept and keeps it again beside modules `a` never
    // pulled; `c` reads it through that.
    ["a.ply", "b.ply", "c.ply"].fold((), |u: Unit, file: String| {
      let r = on_disk(["check", file]);
      assert(r.code == 0, Some(said(r)))
    })
  })
}

/// Words a shell reads into, or takes for its own where a command's name stands.
fn hostile_words() -> List<String> =
  [
    "",
    "plain",
    "a b",
    "it's",
    "'",
    "\"",
    "$HOME",
    "$(echo hi)",
    "`echo hi`",
    "a\\b",
    "\\",
    "a\nb",
    "a\tb",
    "x\ry",
    "*",
    "?",
    "[a-z]",
    "{a,b}",
    "~",
    "~root",
    "#x",
    "!x",
    "a;b",
    "a|b",
    "a&b",
    "a>b",
    "<",
    "(x)",
    "CC=gcc",
    "=ls",
    "--jobs=4",
    "-",
    "--",
    "if",
    "time",
    "{",
    "%1",
    "caf\u{e9}",
    "a\u{3000}b",
    "a'b\"c$d`e\\f",
  ]

// `std.text` holds its quoting to its own reader; only a shell can say a shell reads it so.
test/nondet "sh reads back every word std.text quotes for it, and takes none for its own grammar" {
  let line = |words: List<String>| match shell_join(words) { Some(l) -> l, None -> "" };
  let read = process.spawn[sh](["-c", "printf '%s\\001' " ++ line(hostile_words())], "", []);
  assert_eq(
    read.out,
    Bytes::of_string(String::join(hostile_words().map(|word: String| word ++ "\u{1}"), "")),
  );
  ["if", "then", "do", "done", "for", "while", "case", "{", "}", "!", "CC=gcc"].fold(
    (),
    |_: Unit, word: String| {
      let named = process.spawn[sh](["-c", line([word, "true"])], "", []);
      assert(named.ended == Exited(127), Some(word ++ " was read as the shell's own"))
    },
  )
}

test "a shipped module's laws are not a project's, and the library's checkout proves every one" {
  scratch(|| {
    project(checkout(two_shipped()).push({ path: "app/m.ply", text: keeping() }));
    let mine = json_of(on_disk(["prove", "app", "--json"]));
    let all = json_of(on_disk(["prove", "lib/std", "--json"]));
    assert(int(at(mine, "exit_code")) == 0, Some(shown(mine)));
    assert(int(at(all, "exit_code")) == 0, Some(shown(all)));
    let owed = |v: Json, module: String|
      items(at(v, "obligations")).filter(|o: Json|
        str(at(o, "owner")).starts_with(module ++ ".")).len(
      );
    assert(owed(mine, "m") == 1 && owed(mine, "std") == 0, Some(shown(mine)));
    assert(owed(all, "m") == 0 && owed(all, "std.kept") == 1, Some(shown(all)));
    // Nothing imports `std.idle`, and its claim and its law are owed all the same.
    assert(owed(all, "std.idle") == 2, Some(shown(all)));
    // The coverage denominator is the project's definitions, not the stdlib's.
    assert(int(path(mine, ["coverage", "definitions"])) == 1, Some(shown(mine)));
    // The library's run counts every module's: the fixture's three, of which no claim covers
    // `words`, beside those of the modules every module imports, as a run over those alone counts.
    let coverage = at(all, "coverage");
    let uncovered = items(at(coverage, "uncovered")).map(str);
    assert_eq(uncovered.filter(|n: String| !in_any(n, beside(two_shipped()))), ["std.idle.words"]);
    project(checkout([]));
    let alone = json_of(on_disk(["prove", "lib/std", "--json"]));
    assert(
      int(at(coverage, "definitions")) == 3 + int(path(alone, ["coverage", "definitions"])),
      Some(shown(coverage) ++ "\n" ++ shown(at(alone, "coverage"))),
    )
  })
}

test "a shipped module's warnings and definitions are not a project's, and the library's checkout reports every one" {
  scratch(|| {
    // `std.kept`, which the program imports, holds a function nothing reaches.
    let shipped = two_shipped().map(|s: Source|
      if s.path == "std.kept.ply" { { ..s, text: s.text ++ "\nfn stray(n: Int) -> Int = n\n" } }
      else { s });
    project(checkout(shipped).push({ path: "app/m.ply", text: keeping() }));
    let stray = |v: Json|
      items(at(v, "diagnostics")).filter(|d: Json|
        str(at(d, "code")) == "W0611" && str(at(d, "message")).contains("std.kept.stray")).len(
      );
    let mine = json_of(on_disk(["check", "app", "--json"]));
    let all = json_of(on_disk(["check", "lib/std", "--json"]));
    assert(
      stray(mine) == 0 && !has_named(at(mine, "definitions"), "std.idle.twice"),
      Some(shown(mine)),
    );
    assert(
      stray(all) == 1 && has_named(at(all, "definitions"), "std.idle.twice"),
      Some(shown(all)),
    );
    let listed = json_of(on_disk(["defs", "app", "--json"]));
    let every = json_of(on_disk(["defs", "lib/std", "--json"]));
    assert(
      has_named(at(listed, "definitions"), "m.held")
        && !has_named(at(listed, "definitions"), "std.kept.one"),
      Some(shown(listed)),
    );
    assert(
      has_named(at(every, "definitions"), "std.kept.one")
        && has_named(at(every, "definitions"), "std.idle.twice"),
      Some(shown(every)),
    )
  })
}

/// Two shipped modules whose every claim is proved, one of them imported by nothing.
fn holding_shipped() -> List<Source> =
  [
    {
      path: "std.counted.ply",
      text:
        \\//! A module no program here imports.
        \\
        \\/// How many elements `xs` holds.
        \\pub fn count(xs: List<Int>) -> Int ensures result >= 0 = xs.len()
        \\
        \\law "nothing counts as none" { count([]) == 0 }
        \\
    },
    {
      path: "std.kept.ply",
      text:
        \\//! A module the program imports.
        \\
        \\/// One.
        \\pub fn one() -> Int = 1
        \\
        \\law "one is the least of them" forall (n: Int) where n > 0 && n < 9 { one() <= n }
        \\
    },
  ]

test "a second whole prove of the library answers every claim from the store, and a filtered one too" {
  scratch(|| {
    project(checkout(holding_shipped()));
    let first = json_of(on_disk(["prove", "lib/std", "--json"]));
    let claims = int(path(first, ["summary", "obligations"]));
    // The fixture's, and those the modules every module imports state, which the library proves too.
    let imported = items(at(first, "obligations")).filter(|o: Json|
      in_any(str(at(o, "owner")), beside(holding_shipped()))).len(
    );
    let stated = |sources: List<Source>| written(sources, [], ["ensures ", "law \""]);
    assert(
      imported > 0 && claims == stated(holding_shipped()) + imported
        && int(at(first, "cached")) == 0,
      Some(shown(first)),
    );
    assert(int(path(first, ["summary", "proved"])) == claims, Some(shown(first)));
    let again = json_of(on_disk(["prove", "lib/std", "--json"]));
    assert(int(at(again, "cached")) == claims, Some(shown(again)));
    assert(items(at(again, "warnings")).len() == 0, Some(shown(again)));
    let share = json_of(on_disk(["prove", "lib/std", "--json", "--filter", "std.counted."]));
    let shared = stated(holding_shipped().filter(|s: Source| s.path == "std.counted.ply"));
    assert(
      int(path(share, ["summary", "obligations"])) == shared && int(at(share, "cached")) == shared,
      Some(shown(share)),
    )
  })
}

/// A program whose test reaches `std.kept`'s `one` of `two_shipped` and its own `slug`.
fn slugged(prefix: String) -> String =
  "import std.kept\n\npub fn slug(s: String) -> String = String::concat(\"" ++ prefix
    ++ "\", s)\n\npub fn hits(p: String) -> Bool = p == \"/items/bolt\" && kept::one() == 1\n\ntest \"the slug is an item's\" { assert_eq(hits(slug(\"bolt\")), true) }\n"

// A shipped module's tests are never resolved in a project's run, so its definitions must not stay
// permanently "changed".
test "a shipped definition the project never touched is not a suspect" {
  scratch(|| {
    program(slugged("/items/"));
    let first_run = on_disk_shipping_only(["test"], two_shipped());
    assert(first_run.code == 0, Some(said(first_run)));
    // One edit, to one definition the project owns.
    write("m.ply", slugged("/goods/"));
    let v = json_of(on_disk_shipping_only(["test", "--json"], two_shipped()));
    let failure = nth(at(v, "failures"), 0);
    let suspects = items(at(failure, "suspects")).map(|s: Json| str(at(s, "name")));
    assert(suspects != [], Some("the edit has to be attributed to something: " ++ shown(v)));
    let shipped = suspects.filter(|n: String| n.starts_with("std."));
    assert(
      shipped == [],
      Some(
        "nothing under `std` moved, so nothing under `std` is a suspect: "
          ++ String::join(shipped, ", "),
      ),
    );
    assert(str(nth(path(failure, ["culprit", "definitions"]), 0)) == "m.slug", Some(shown(v)))
  })
}

// --- A shipped module's data --------------------------------------------------------------------

/// A program over `std.oid`, which embeds `oid/names.txt`: `named` reaches the table a build makes
/// of the file, and `plain` a constant of the module that reaches none of it.
fn naming() -> String =
  \\import std.oid
  \\
  \\pub fn named() -> Option<String> = oid::name(oid::common_name())
  \\
  \\pub fn plain() -> Int = oid::arcs(oid::common_name()).len()
  \\
  \\fn main() -> Int = match named() { Some(n) -> n.len(), None -> 0 }
  \\
  \\test "named" { assert_eq(named(), Some("commonName")) }
  \\

fn last_line(ran: Ran) -> String =
  String::trim(match ran.out.at(ran.out.len() - 1) { Some(l) -> l, None -> "" })

/// The data file `std.oid` embeds, under the name the shipped modules hold it by, as the tree has it.
fn oid_names() -> Source / {abort.raise} =
  match std_data().filter(|d: { name: String, bytes: Bytes }| d.name == "std/oid/names.txt") {
    [d, ..] -> { path: d.name, text: String::of_bytes(d.bytes) },
    [] -> panic("the standard library's tree holds no `oid/names.txt`"),
  }

test "a program runs what a shipped module embedded, from the binary and from a built artifact" {
  scratch(|| {
    program(naming());
    assert_ok(on_disk(["check"]));
    let ran = on_disk(["run"]);
    assert(ran.code == 0 && last_line(ran) == "10", Some(said(ran)));
    let tested = on_disk(["test"]);
    assert(tested.code == 0 && said(tested).contains("1 passed"), Some(said(tested)));
    assert_ok(on_disk(["build", ".", "-o", "m.plyx"]));
    let built = on_disk(["run", "m.plyx"]);
    assert(built.code == 0 && last_line(built) == "10", Some(said(built)))
  })
}

// The launcher lays the file out below the modules, and the program reads it off that directory.
test/nondet "a `ply` of its own reads the data file a shipped module embeds" {
  program(naming());
  let ran = spawned(["run"], []);
  assert(ran.code == 0 && last_line(ran) == "10", Some(said(ran)));
  let shown = spawned(["std", "--show", "std/oid/names.txt"], []);
  assert(shown.code == 0 && stdout(shown) == oid_names().text, Some(said(shown)))
}

test "a warm check agrees with a cold one over a program that reaches a shipped data file" {
  scratch(|| {
    project([{ path: "app.ply", text: naming() }]);
    let _ = warm_agrees("cold");
    let warm = warm_agrees("warm");
    assert(has_named(at(warm, "definitions"), "std.oid.registry"), Some(shown(warm)))
  })
}

test "editing a shipped data file moves exactly the definitions that reach it" {
  let renamed = {
    path: oid_names().path,
    text: oid_names().text.replace("2.5.4.3 commonName", "2.5.4.3 cn"),
  };
  assert(renamed.text != oid_names().text, Some("the edit landed"));
  let hashes = |shipped: List<Source>|
    over_tree(app(naming()), || json_of(on_disk_shipping(["hash", "--json"], shipped))).value;
  let before = hashes([]);
  let after = hashes([renamed]);
  ["std.oid.registry", "std.oid.name", "app.named", "app.main"].fold((), |u: Unit, name: String|
    assert(hash_of(before, name) != hash_of(after, name), Some(name)));
  // The module's text did not move, and what reaches nothing of the file stands.
  ["std.oid.common_name", "std.oid.arcs", "app.plain"].fold((), |u: Unit, name: String|
    assert(hash_of(before, name) == hash_of(after, name), Some(name)));
  assert(tests_hashed(before) != tests_hashed(after), Some("the test that reads a name reruns"));
  // Handed the file as the binary ships it, a load answers as one handed nothing in its place.
  assert_eq(hashes([oid_names()]), before)
}

test "copying a shipped module and its data file into a project produces identical hashes" {
  let source = match std_tree().filter(|f: { name: String, bytes: Bytes }| f.name == "oid.ply") {
    [f, ..] -> String::of_bytes(f.bytes),
    [] -> panic("the standard library's tree holds no `oid.ply`"),
  };
  let shipped = hashed(app(naming()));
  let copied = hashed(
    tree([
      { path: "mine.ply", text: source },
      { path: "oid/names.txt", text: oid_names().text },
      { path: "app.ply", text: naming().replace("import std.oid", "import mine as oid") },
    ]),
  );
  ["registry", "name", "common_name"].fold((), |u: Unit, name: String|
    assert_eq(hash_of(shipped, "std.oid." ++ name), hash_of(copied, "mine." ++ name)));
  assert_eq(hash_of(shipped, "app.named"), hash_of(copied, "app.named"))
}

test "a program that reaches nothing of a shipped module's data holds no definition the file moves" {
  let idle = "import std.oid\n\npub fn plain() -> Int = oid::arcs(oid::common_name()).len()\n";
  let answer = checked(app(idle));
  assert(truth(at(answer, "ok")), Some(shown(answer)));
  assert(has_named(at(answer, "definitions"), "std.oid.common_name"), Some(shown(answer)));
  ["std.oid.registry", "std.oid.name", "std.oid.named"].fold((), |u: Unit, name: String|
    assert(!has_named(at(answer, "definitions"), name), Some(name)));
  let hashes = |shipped: List<Source>|
    over_tree(app(idle), || json_of(on_disk_shipping(["hash", "--json"], shipped))).value;
  assert_eq(hashes([{ path: oid_names().path, text: "2.5.4.3 cn\n" }]), hashes([]))
}

/// A shipped module this binary does not ship, whose table a build makes of a data file beside it.
fn words() -> Source =
  {
    path: "std.words.ply",
    text:
      \\//! Words, one a line, for a test of a shipped table.
      \\
      \\fn parsed(text: Bytes) -> List<String> / {abort.raise} =
      \\  String::of_bytes(text).split("\n").filter(|word: String| word != "").map(|word: String|
      \\      if word.contains(" ") { panic("`" ++ word ++ "` is two words") } else { word },
      \\  )
      \\
      \\/// The words the file beside this module holds, made when a program is built.
      \\pub const fn table() -> List<String> = parsed(embed("words/list.txt"))
      \\
      \\/// The same words, made where they are asked for.
      \\pub fn computed() -> List<String> / {abort.raise} = parsed(embed("words/list.txt"))
      \\
  }

fn word_list(text: String) -> Source = { path: "std/words/list.txt", text: text }

fn counting() -> String =
  \\import std.words
  \\
  \\fn main() -> Int = words::table().len()
  \\
  \\test "the table read is the table its body makes" {
  \\  assert_eq(words::table(), words::computed())
  \\}
  \\
  \\test "a second read of the table enters nothing of its body" {
  \\  let first = words::table();
  \\  let read = metered(|| words::table());
  \\  let nothing = metered(|| 0);
  \\  assert_eq(read.steps, nothing.steps);
  \\  assert_eq(read.allocations, nothing.allocations);
  \\  assert(metered(|| words::computed()).steps > read.steps);
  \\  assert_eq(first.len(), 3)
  \\}
  \\

test "a shipped module's `const fn` over its data file is made by the build, and a run reads it at no cost" {
  let shipped = [words(), word_list("one\ntwo\nthree\n")];
  scratch(|| {
    program(counting());
    assert_ok(on_disk_shipping(["check"], shipped));
    let ran = on_disk_shipping(["run"], shipped);
    assert(ran.code == 0 && last_line(ran) == "3", Some(said(ran)));
    let tested = json_of(on_disk_shipping(["test", "--json", "--no-cache"], shipped));
    assert(int(path(tested, ["summary", "passed"])) == 2, Some(shown(tested)))
  });
  // Other bytes are another definition, so the build makes the table again.
  scratch(|| {
    program(counting());
    let longer = on_disk_shipping(["run"], [words(), word_list("one\ntwo\nthree\nfour\n")]);
    assert(longer.code == 0 && last_line(longer) == "4", Some(said(longer)))
  })
}

// The module's text stands across these checks, and each reads it through what the last one kept.
test "a check that kept a shipped module makes its table again when the data file moves" {
  scratch(|| {
    program(counting());
    let check = |list: String|
      on_disk_shipping(["check", "--explain", "--json"], [words(), word_list(list)]);
    assert_ok(check("one\ntwo\nthree\n"));
    assert_ok(check("one\ntwo\nthree\n"));
    let refused = json_of(check("one\ntwo words\n"));
    assert_eq(codes(refused), ["E0157"]);
    assert(shown(refused).contains("`two words` is two words"), Some(shown(refused)));
    assert_ok(check("one\ntwo\nthree\n"))
  })
}

test "a data file the shipped modules do not hold is refused in the module that asks for it" {
  scratch(|| {
    program(counting());
    let v = json_of(on_disk_shipping(["check", "--json"], [words()]));
    // One for each call that asks for it.
    assert_eq(codes(v), ["E0146", "E0146"]);
    items(at(v, "diagnostics")).fold((), |u: Unit, d: Json| {
      assert(str(at(d, "message")).contains("words/list.txt"), Some(shown(d)));
      assert_eq(items(at(d, "labels")).map(|l: Json| str(at(l, "file"))), ["<std>/words.ply"])
    })
  })
}

test "ply doc documents a name of a shipped module that embeds a data file" {
  let r = in_memory(app("fn f() -> Int = 1\n"), ["doc", "std.oid.name"]);
  assert(r.code == 0 && said(r).contains("well-known identifier"), Some(said(r)))
}

test "ply doc documents a name of a shipped module that imports the compiler's" {
  let r = in_memory(app("fn f() -> Int = 1\n"), ["doc", "std.syntax.format"]);
  assert(r.code == 0 && said(r).contains("What `ply fmt` writes"), Some(said(r)))
}

// A file the tree holds and no module embeds would ship in every binary and be read by nothing.
test "each data file the standard library's tree holds is one a module of it embeds" {
  let embedded = std_tree().fold([], |acc: List<String>, f: { name: String, bytes: Bytes }|
    if !f.name.ends_with(".ply") { acc } else {
      shipped_data_wanted({ name: Bytes::of_string(module_in("std.", f.name)), src: f.bytes }).fold(
        acc,
        |a: List<String>, name: Bytes| a.push(String::of_bytes(name)),
      )
    });
  assert_eq(std_data().map(|d: { name: String, bytes: Bytes }| d.name).sort(), embedded.sort())
}

/// What a module publishes that has no doc: every `pub` declaration, and each operation of a `pub`
/// effect, by name.
fn undocumented(module: String, src: Bytes) -> List<String> / {abort.raise} =
  parse(src).node.items.fold([], |acc: List<String>, it: Item| {
    let named = |name: Bytes| module ++ "." ++ String::of_bytes(name);
    match it {
      IFn(d) -> if is_pub(d.vis) && bare(d.doc) { acc.push(named(d.name.name)) } else { acc },
      IType(d) -> if is_pub(d.vis) && bare(d.doc) { acc.push(named(d.name.name)) } else { acc },
      ISchema(d) -> if is_pub(d.vis) && bare(d.doc) { acc.push(named(d.name.name)) } else { acc },
      IEffectSet(d) -> if is_pub(d.vis) && bare(d.doc) { acc.push(named(d.name.name)) }
      else { acc },
      IEffect(d) -> if !is_pub(d.vis) { acc } else {
        let own = if bare(d.doc) { acc.push(named(d.name.name)) } else { acc };
        d.ops.fold(own, |a: List<String>, op: OpDef|
          if bare(op.doc) { a.push(named(d.name.name) ++ "." ++ String::of_bytes(op.name.name)) }
          else { a })
      },
      _ -> acc,
    }
  })

fn bare(doc: Option<Doc>) -> Bool = match doc { None -> true, Some(_) -> false }

test "every name {m.module} publishes is documented" for m: StdModule in std_modules() {
  let missing = undocumented(m.module, m.src);
  assert(
    missing.len() == 0,
    Some("these are published without a `///` doc:\n" ++ String::join(missing, "\n")),
  )
}

/// The shipped modules that fold case or trim by Unicode's tables, each with the text of a
/// person's it reads that way. Every other one compares names and tokens, which take
/// `std.string`'s `ascii_lower`, `ascii_upper` and `ascii_trim`.
fn unicode_readers() -> List<{ module: String, why: String }> =
  [
    { module: "cli", why: "a manual page's title is the program's name in capitals" },
    { module: "ini", why: "`any_case` matches a key as Python's `configparser` folds one" },
    { module: "semver", why: "`coerce` reads a version out of text a person typed" },
    { module: "string", why: "the ASCII trim is stated against the prelude's" },
    { module: "tar", why: "paths are compared as a file system that folds case compares them" },
    { module: "text", why: "a shell line is refused at white space of any script" },
  ]

/// Whether a source calls `std.unicode`'s `lowercase` or `uppercase`, or `String::trim`, outside
/// its comments and its literals: a declaration of one is no call.
fn reads_unicode(src: Bytes) -> Bool / {abort.raise} = {
  let tokens = lex(src).tokens;
  let kind = |i: Int| match tokens.at(i) { Some(t) -> t.kind, None -> EndOfInput };
  range(1, tokens.len()).fold(false, |found: Bool, i: Int|
    found
      || (match kind(i) {
        Identifier(name) ->
          (name == b"lowercase" || name == b"uppercase" || name == b"trim")
            && (kind(i - 1) == Punctuation(b"dot") || kind(i - 1) == Punctuation(b"coloncolon"))
            && kind(i + 1) == Punctuation(b"lparen")
            && kind(i - 3) != Keyword(b"fn"),
        _ -> false,
      }))
}

test "a shipped module folds case and trims by ASCII, unless it is listed as reading a person's text" {
  let found = std_tree().fold([], |acc: List<String>, f: { name: String, bytes: Bytes }|
    if f.name.ends_with(".ply") && reads_unicode(f.bytes) { acc.push(module_in("", f.name)) }
    else { acc }).sort(
  );
  let listed = unicode_readers().map(|r: { module: String, why: String }| r.module);
  assert(
    found == listed,
    Some(
      "the modules that call `std.unicode`'s `lowercase` or `uppercase`, or `String::trim`:\n  "
        ++ String::join(found, " ")
        ++ "\nthe ones listed as reading a person's text:\n  "
        ++ String::join(listed, " ")
        ++ "\na name or a token takes `std.string`'s `ascii_lower`, `ascii_upper` or `ascii_trim`",
    ),
  )
}
