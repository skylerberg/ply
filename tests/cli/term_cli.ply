//! A program at a real terminal under `ply run`: the pseudo-terminal `script` makes, with
//! this test typing at it. What the terminal's settings are is what `stty` says of them, asked
//! from inside the run and again once it is over. A system with no `script` has no terminal to
//! give a test, and each test here then asserts nothing.

import harness (write_program, at_terminal, Shell)
import std.process (process, LineWritten, Kill)
import std.string

/// Reads a secret with the terminal silent, then a key with it raw, saying what `stty` reports of
/// the terminal at each step.
fn at_a_terminal() -> String =
  \\import std.process
  \\import std.process (process, pipe)
  \\import std.term
  \\import std.term (term, tty)
  \\
  \\fn settings() -> String / {process.spawn[sh]} = {
  \\  let said = process.spawn[sh](["-c", "stty -a < /dev/tty | tr '\\n\\t;' '   '"], "", [
  \\    process::var("PATH", "/usr/bin:/bin"),
  \\  ]);
  \\  let flags = " " ++ String::of_bytes_lossy(said.out) ++ " ";
  \\  let off = |name: String| flags.contains(" -" ++ name ++ " ");
  \\  (if off("echo") { "echo off" } else { "echo on" })
  \\    ++ (if off("icanon") { " icanon off" } else { " icanon on" })
  \\}
  \\
  \\fn main() -> Unit / {process.spawn[sh], process.write[proc], pipe.broken, term.read, term.write, tty.missing, abort.raise} = {
  \\  process.out[proc]("terminal " ++ (if term.is_terminal(process::Stdin) { "yes" } else { "no" }));
  \\  process.out[proc](match term.size() {
  \\    Some(s) -> "size " ++ s.columns.to_string() ++ " by " ++ s.rows.to_string(),
  \\    None -> "size unknown",
  \\  });
  \\  process.out[proc]("start: " ++ settings());
  \\  let secret = with_hold[quiet](term::enter_mode(term::Silent), term::restore_mode) { was -> {
  \\    process.out[proc]("silent: " ++ settings());
  \\    term.secret_line()
  \\  } };
  \\  process.out[proc](match secret {
  \\    Some(s) -> if s.verify("hunter2") { "secret verified" } else { "secret wrong" },
  \\    None -> "secret missing",
  \\  });
  \\  process.out[proc]("between: " ++ settings());
  \\  let key = term::raw(|| {
  \\    process::write_out[proc](Bytes::of_string("raw: " ++ settings() ++ "\r\n"));
  \\    process::flush_out[proc]();
  \\    term::next_event(term::pending(), 60000, 64).event
  \\  });
  \\  process.out[proc](match key {
  \\    Some(term::Pressed(c)) -> if c.key == term::Up { "key up" } else { "another key" },
  \\    _ -> "no key",
  \\  });
  \\  process.out[proc]("end: " ++ settings());
  \\  process.exit[proc](0)
  \\}
  \\

/// Puts the terminal in raw mode behind no bracket and gives up, leaving the host to put it back.
fn leaves_it_raw() -> String =
  \\import std.process (process)
  \\import std.term
  \\import std.term (term)
  \\
  \\fn main() -> Unit / {process.out[proc], term.mode, abort.raise} = {
  \\  let was = term.mode(term::Raw);
  \\  process.out[proc](if was == Some(term::Cooked) { "raw now\r" } else { "no terminal\r" });
  \\  panic("gave up in raw mode")
  \\}
  \\

/// `ply run m.ply` at a terminal, the program able to start the shell it asks `stty` by.
fn run_at_a_terminal() -> Option<Int> / {Shell, abort.raise} =
  at_terminal(["run", "m.ply", "--exec", "sh=/bin/sh"])

/// The terminal's lines up to the first that holds `wanted`, each as it was said; the test fails
/// with them if the terminal ends or falls silent first.
fn until_line(
  child: Int,
  wanted: String,
  seen: List<String>,
  tries: Int,
) -> List<String> / {process.output_line[sh], process.signal[sh], abort.raise} =
  if tries <= 0 { gave_up(child, wanted, seen) } else {
    match process.output_line[sh](child, 120000) {
      LineWritten(line) -> if line.contains(wanted) { seen.push(line) }
      else { until_line(child, wanted, seen.push(line), tries - 1) },
      _ -> gave_up(child, wanted, seen),
    }
  }

fn gave_up(
  child: Int,
  wanted: String,
  seen: List<String>,
) -> List<String> / {process.signal[sh], abort.raise} = {
  let _ = process.signal[sh](child, Kill);
  panic("the terminal never said `" ++ wanted ++ "`; it said:\n" ++ String::join(seen, "\n"))
}

fn type_bytes(child: Int, bytes: Bytes) -> Unit / {process.input[sh], abort.raise} =
  if !process.input[sh](child, bytes) { panic("the terminal stopped taking what was typed") }

fn ended_cleanly(
  child: Int,
) -> Unit / {process.end_input[sh], process.wait[sh], process.signal[sh], abort.raise} = {
  process.end_input[sh](child);
  match process.wait[sh](child, 60000) {
    Some(_) -> (),
    None -> {
      let _ = process.signal[sh](child, Kill);
      panic("`script` was still running a minute after its command ended")
    },
  }
}

/// Whether a line of `stty -a`, its line ends and semicolons made blanks, says echo and canonical
/// input are both on.
fn is_restored(line: String) -> Bool = !line.contains(" -echo ") && !line.contains(" -icanon ")

fn secret_then_key(child: Int) -> Unit / {Shell, abort.raise} = {
  let opening = String::join(until_line(child, "silent: ", [], 40), "\n");
  assert(opening.contains("terminal yes"), Some(opening));
  assert(opening.contains("size 80 by 24"), Some(opening));
  assert(opening.contains("start: echo on icanon on"), Some(opening));
  assert(opening.contains("silent: echo off icanon on"), Some(opening));
  type_bytes(child, b"hunter2\n");
  let output = String::join(until_line(child, "raw: ", [], 40), "\n");
  assert(!output.contains("hunter2"), Some("the secret was echoed:\n" ++ output));
  assert(output.contains("secret verified"), Some(output));
  assert(output.contains("between: echo on icanon on"), Some(output));
  assert(output.contains("raw: echo off icanon off"), Some(output));
  type_bytes(child, b"\x1b[A");
  let closing = String::join(until_line(child, "after: ", [], 40), "\n");
  assert(closing.contains("key up"), Some(closing));
  assert(closing.contains("end: echo on icanon on"), Some(closing));
  assert(is_restored(closing), Some("the terminal was not left as it was found:\n" ++ closing));
  ended_cleanly(child)
}

test/nondet "at a terminal a secret is typed unseen and a key read raw, and each mode is left as it ends" {
  write_program(at_a_terminal());
  match run_at_a_terminal() { Some(child) -> secret_then_key(child), None -> () }
}

fn left_raw(child: Int) -> Unit / {Shell, abort.raise} = {
  let output = String::join(until_line(child, "after: ", [], 40), "\n");
  assert(output.contains("raw now"), Some(output));
  assert(is_restored(output), Some("the terminal was left raw:\n" ++ output));
  ended_cleanly(child)
}

test/nondet "a run that ends with the terminal raw leaves it as it was found" {
  write_program(leaves_it_raw());
  match run_at_a_terminal() { Some(child) -> left_raw(child), None -> () }
}

/// The same, from a run lent nothing: the terminal is open to it all the same.
fn leaves_it_raw_ungranted() -> String =
  \\import std.term
  \\import std.term (term)
  \\
  \\fn main() -> Unit / {term.mode, abort.raise} =
  \\  if term.mode(term::Raw) == Some(term::Cooked) { panic("gave up in raw mode") }
  \\  else { panic("found no terminal") }
  \\

test/nondet "a run lent nothing that ends with the terminal raw leaves it as it was found" {
  write_program(leaves_it_raw_ungranted());
  match at_terminal(["run", "m.ply"]) {
    Some(child) -> {
      let output = String::join(until_line(child, "after: ", [], 40), "\n");
      assert(output.contains("gave up in raw mode"), Some(output));
      assert(is_restored(output), Some("the terminal was left raw:\n" ++ output));
      ended_cleanly(child)
    },
    None -> (),
  }
}
