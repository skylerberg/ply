//! `--tls NAME=CERT,KEY`: what `ply hosts` discloses of the TLS stack and the credentials a run is
//! given, what moves the binding's digest, how a credential that does not load is rejected, the
//! protocol two ends agree over it, and the certificate a client presents and `--mtls` requires.

import harness (scratch, RunResult, write_program, write, working_directory, on_disk,
                one_module_tree, spawned, all_output, stdout, stderr, json_of, at, path, nth, str,
                int, json_text, value_of, WorkingDirectory, PlyProcess)
import std.certgen (certgen)
import std.json (Json, Str, Array)

/// Creates a TLS listener with the credential `api`.
fn secure() -> String = String::of_bytes_lossy(embed("../programs/tls_cli/secure.ply"))

/// Opens a connection to its own listener and secures it at both ends, as a `STARTTLS` does, the
/// server's half in a task of its own since each half waits on the other. It ends by a panic
/// that says which half failed, and why: the client's where both did, since a client that
/// rejects its server is what the server then fails on.
fn upgrading() -> String = String::of_bytes_lossy(embed("../programs/tls_cli/upgrading.ply"))

/// Sends no mail: opens an SMTP session over a connection that starts in the clear to a server
/// of its own, whose leave to start TLS is `go_ahead` (the source of a byte string's contents),
/// proves a sealed password to it by `AUTH PLAIN` over TLS, and returns what the session kept of
/// its exchange, or panics with why the client failed. The server takes the password only as
/// the line it must be.
fn smtp_upgrading(go_ahead: String) -> String =
  smtp_upgrade() ++ "\nfn go_ahead() -> Bytes = b\"" ++ go_ahead ++ "\"\n"

fn smtp_upgrade() -> String =
  \\import std.ip
  \\import std.net
  \\import std.net (net)
  \\import std.random (entropy)
  \\import std.sasl
  \\import std.sasl (sasl)
  \\import std.show (show)
  \\import std.smtp
  \\import std.smtp (smtp)
  \\import std.task
  \\
  \\fn served(l: Int) -> Result<Unit, String> / {net.write[listener], net.write[conn]} = {
  \\  let s = net.accept[listener](l);
  \\  let say = |said: Bytes| net.send[conn](s, said, 5000);
  \\  let _greeted = say(b"220 localhost ESMTP\r\n");
  \\  let _hello = net.recv[conn](s, 512, 5000);
  \\  let _offered = say(b"250-localhost\r\n250 STARTTLS\r\n");
  \\  let _asked = net.recv[conn](s, 512, 5000);
  \\  let _left = say(go_ahead());
  \\  let secured = net.serve_tls[conn](s, "api", [], b"", 5000);
  \\  let answer = match secured {
  \\    Err(why) -> Err(net::error_message(why)),
  \\    Ok(_) -> {
  \\      let _again = net.recv[conn](s, 512, 5000);
  \\      let _offered_again = say(b"250-localhost\r\n250 AUTH PLAIN\r\n");
  \\      let auth = net.recv[conn](s, 512, 5000);
  \\      let proved = auth == Some(b"AUTH PLAIN AHRpbQB0YW5zdGFhZnRhbnN0YWFm\r\n");
  \\      let _verdict = say(if proved { b"235 2.7.0 Accepted\r\n" } else { b"535 5.7.8 No\r\n" });
  \\      let _quit = net.recv[conn](s, 512, 5000);
  \\      let _bye = say(b"221 bye\r\n");
  \\      if proved { Ok(()) } else { Err("the credential was not the line it must be") }
  \\    },
  \\  };
  \\  net.close[conn](s);
  \\  answer
  \\}
  \\
  \\fn main() -> Int / {net.read[listener], net.write[listener], net.write[conn], net.write[client], task.write, clock.read, entropy.next, abort.raise} = {
  \\  let l = match net.listen_on[listener](ip::socket_at(ip::loopback_v4(), 0), []) {
  \\    Ok(l) -> l,
  \\    Err(why) -> panic("no listener: " ++ net::error_message(why)),
  \\  };
  \\  let port = match net.local_port[listener](l) { Some(p) -> p, None -> panic("no port") };
  \\  let held = match try[sasl.fail] {
  \\    sasl::password("tim", Secret::of_bytes(b"tanstaaftanstaaf"))
  \\  } {
  \\    Ok(k) -> k,
  \\    Err(_) -> panic("the credential was rejected"),
  \\  };
  \\  let serving = task.spawn(|| served(l));
  \\  let kept = try[smtp.fail] {
  \\    let c = smtp::with_credential(
  \\      smtp::config("client.example", { ..smtp::default_limits(), transcript: 40 }),
  \\      held,
  \\    );
  \\    task::unbounded(||
  \\      smtp::with_session[client]("localhost", port, c, |s: smtp::Session|
  \\        smtp::transcript_text(smtp::transcript(s))))
  \\  };
  \\  let served_as = task.join(serving);
  \\  net.close[listener](l);
  \\  match kept {
  \\    Ok(text) -> if served_as == Ok(())
  \\        && text.contains("*: TLS\nC: EHLO client.example\nS: 250-localhost\nS: 250 AUTH PLAIN\nC: AUTH PLAIN ****\nS: 235 2.7.0 Accepted",
  \\        ) { 0 }
  \\    else { panic("the session was not secured and proved:\n" ++ text ++ "\n" ++ show(served_as)) },
  \\    Err(why) -> panic("the client rejected: " ++ show(why)),
  \\  }
  \\}

/// Serves two connections with `std.http`'s TLS pool on a listener of its own: one `fetch` asks
/// over `https`, offering `h2` and `http/1.1`, and one asks offering `http/1.1` alone. It ends by
/// a panic that says what was spoken where either was not what its client offered first.
fn alpn_serving() -> String = String::of_bytes_lossy(embed("../programs/tls_cli/alpn_serving.ply"))

/// Serves two `fetch`es of its own with `std.http`'s TLS pool, the first presenting the `--tls`
/// credential `caller` and the second none, and returns what each request carried: the
/// certificate's subject, DNS names and fingerprint as `std.x509` reads them, `none`, or `refused`
/// where the fetch failed.
fn client_certified() -> String =
  String::of_bytes_lossy(embed("../programs/tls_cli/client_certified.ply"))

/// Reaches the boundary without touching a socket.
fn no_socket() -> String = "fn main() -> Int = simulate { spawn { 1 }; 2 }\n"

/// Generated rather than checked in: a private key in a repository leaks.
type Credential = { cert: String, key: String }

fn credential(name: String) -> Credential / {WorkingDirectory, certgen.issue, abort.raise} = {
  let issued = certgen.issue();
  write(name ++ ".pem", issued.certificate);
  write(name ++ ".key", issued.key);
  {
    cert: working_directory() ++ "/" ++ name ++ ".pem",
    key: working_directory() ++ "/" ++ name ++ ".key",
  }
}

fn tls_flag_value(name: String, c: Credential) -> String = name ++ "=" ++ c.cert ++ "," ++ c.key

/// `ply` as a process in the working directory, which is what holds a real socket and a credential.
fn child(argv: List<String>) -> RunResult / {PlyProcess, abort.raise} = spawned(argv, [])

test/nondet "`ply hosts --tls` prints the TLS library, provider and protocol versions, and the name and fingerprint of the given credential" {
  write_program(secure());
  let r = child(["hosts", "--tls", tls_flag_value("api", credential("api"))]);
  assert(r.code == 0, Some(stderr(r)));
  let text = stdout(r);
  assert(text.contains("   transport"), Some(text));
  assert(
    text.contains("tls  rustls 0.23.43 · provider ring · TLS 1.3, TLS 1.2 · alpn http/1.1"),
    Some(text),
  );
  assert(text.contains("   credentials"), Some(text));
  assert(
    text.contains("api  sha256:") && text.contains("1 certificate"),
    Some("the credential must be named with its fingerprint:\n" ++ text),
  );
  assert(text.contains("digest: b3:"), Some(text))
}

test/nondet "a run given a TLS credential and `--trust` for its certificate completes a TLS connection, and without `--trust` the client rejects the certificate" {
  write_program(upgrading());
  let api = credential("api");
  let r = child(["run", "--tls", tls_flag_value("api", api), "--trust", api.cert]);
  assert(r.code == 0, Some(all_output(r)));
  // The same run without the certificate trusted: the client's half rejects it, typed.
  let untrusted = child(["run", "--tls", tls_flag_value("api", api)]);
  assert(untrusted.code != 0, Some(all_output(untrusted)));
  assert(
    all_output(untrusted).contains(
      "the client's half: the peer's certificate is not trusted for that name",
    ),
    Some(all_output(untrusted)),
  )
}

test/nondet "an SMTP client upgrades to TLS with STARTTLS and verifies the server's certificate, and fails if the certificate is untrusted or extra plaintext follows the STARTTLS reply" {
  write_program(smtp_upgrading("220 2.0.0 Ready to start TLS\\r\\n"));
  let api = credential("api");
  let trusted = ["run", "--tls", tls_flag_value("api", api), "--trust", api.cert];
  let r = child(trusted);
  assert(r.code == 0, Some(all_output(r)));
  // The same server without its certificate trusted: the handshake is rejected, typed.
  let untrusted = child(["run", "--tls", tls_flag_value("api", api)]);
  assert(
    untrusted.code != 0
      && all_output(untrusted).contains("the client rejected: HandshakeFailed(Untrusted)"),
    Some(all_output(untrusted)),
  );
  // CVE-2011-0411: a reply injected after the leave, which a client that kept it would read as
  // the server's response over TLS.
  write_program(smtp_upgrading("220 2.0.0 Ready to start TLS\\r\\n250 AUTH PLAIN\\r\\n"));
  let again = credential("api");
  let injected = child(["run", "--tls", tls_flag_value("api", again), "--trust", again.cert]);
  assert(
    injected.code != 0 && all_output(injected).contains("the client rejected: Injected"),
    Some(all_output(injected)),
  )
}

test/nondet "a std.http server and client agree h2 over TLS, and a client offering http/1.1 alone is served HTTP/1.1" {
  write_program(alpn_serving());
  let api = credential("api");
  let r = child(["run", "--tls", tls_flag_value("api", api), "--trust", api.cert]);
  assert(r.code == 0, Some(all_output(r)))
}

test/nondet "a request over a `--tls` listener includes the client's certificate when the client sent one, and `--mtls` rejects a request that has no client certificate" {
  write_program(client_certified());
  let api = credential("api");
  let caller = credential("caller");
  let tls = ["--tls", tls_flag_value("api", api), "--tls", tls_flag_value("caller", caller)];
  let trust = ["--trust", api.cert, "--trust", caller.cert];
  let listed = json_of(child(trust.fold(tls.fold(["hosts", "--json"], List::push), List::push)));
  let presented = nth(path(listed, ["transport", "credentials"]), 1);
  assert(str(at(presented, "name")) == "caller", Some(json_text(listed)));
  let carried = " / localhost / " ++ str(at(presented, "fingerprint"));
  let returned = value_of(child(trust.fold(tls.fold(["run", "--json"], List::push), List::push)));
  assert(
    returned.contains("presenting: CN=") && returned.contains(carried ++ " | "),
    Some(returned),
  );
  assert(returned.contains("anonymous: none"), Some(returned));
  let required = value_of(
    child(
      ["--mtls", "api"].fold(
        trust.fold(tls.fold(["run", "--json"], List::push), List::push),
        List::push,
      ),
    ),
  );
  assert(required.contains(carried ++ " | "), Some(required));
  assert(required.contains("anonymous: rejected"), Some(required))
}

test "`--mtls` with a credential name the run was not given fails with E0429" {
  scratch(|| {
    write_program(secure());
    let r = on_disk(["hosts", "--mtls", "api"]);
    assert(r.code != 0, Some(all_output(r)));
    assert(
      all_output(r).contains("E0429") && all_output(r).contains("`--mtls api`"),
      Some(all_output(r)),
    )
  })
}

test "`ply hosts` on a program that opens no sockets prints no TLS transport or credentials section" {
  scratch(|| {
    write_program(no_socket());
    let text = stdout(on_disk(["hosts"]));
    assert(!text.contains("transport"), Some(text));
    assert(!text.contains("credentials"), Some(text));
    assert(!text.contains("ply_host::tls"), Some(text))
  })
}

fn digest(args: List<String>) -> String / {PlyProcess, abort.raise} =
  stdout(child(args.fold(["hosts", "--digest"], List::push))).trim()

test/nondet "the `ply hosts` digest stays the same when a credential's certificate is replaced, and changes when a credential is added or removed" {
  write_program(secure());
  let api = credential("api");
  let one = ["--tls", tls_flag_value("api", api)];
  let before = digest(one);
  assert(before.starts_with("b3:"), Some(before));
  // The same credential name, a different certificate: an operational fact.
  assert(
    before == digest(["--tls", tls_flag_value("api", credential("rotated"))]),
    Some("a renewed certificate must not move the digest"),
  );
  // A second credential: a structural change to what the run can serve.
  assert(
    before
      != digest([
        "--tls",
        tls_flag_value("api", api),
        "--tls",
        tls_flag_value("admin", credential("admin")),
      ]),
    Some("a second credential must move it"),
  );
  assert(before != digest([]), Some("removing one must move it"))
}

test/nondet "`ply hosts --json` reports the TLS library, provider, ALPN protocols and each credential's name and full SHA-256 fingerprint" {
  write_program(secure());
  let report = json_of(
    child(["hosts", "--json", "--tls", tls_flag_value("api", credential("api"))]),
  );
  assert(str(at(report, "command")) == "hosts", Some(json_text(report)));
  assert(str(path(report, ["transport", "library"])) == "rustls", Some(json_text(report)));
  assert(str(path(report, ["transport", "provider"])) == "ring", Some(json_text(report)));
  assert(path(report, ["transport", "alpn"]) == Array([Str("http/1.1")]), Some(json_text(report)));
  let c = nth(path(report, ["transport", "credentials"]), 0);
  assert(str(at(c, "name")) == "api", Some(json_text(c)));
  assert(int(at(c, "certificates")) == 1, Some(json_text(c)));
  let fingerprint = str(at(c, "fingerprint"));
  assert(fingerprint.starts_with("sha256:"), Some(fingerprint));
  assert(
    fingerprint.len() == "sha256:".len() + 64,
    Some("the object must carry the whole digest, not the abbreviation"),
  )
}

test/nondet "a credential that does not load is E0430 naming the file" {
  write_program(secure());
  let api = credential("api");
  write("broken.pem", "-----BEGIN CERTIFICATE-----\nnope\n");
  let broken = { cert: working_directory() ++ "/broken.pem", key: api.key };
  let missing = { cert: working_directory() ++ "/absent.pem", key: api.key };
  [broken, missing].fold((), |u: Unit, bad: Credential| {
    let r = child(["run", "--tls", tls_flag_value("api", bad)]);
    assert(r.code == 2, Some(all_output(r)));
    assert(all_output(r).contains("E0430"), Some(all_output(r)))
  });
  // A key that is not the leaf's needs both files to catch, and is the one a deploy gets wrong.
  let other = credential("other");
  let r = child(["run", "--tls", tls_flag_value("api", { cert: api.cert, key: other.key })]);
  assert(all_output(r).contains("E0430"), Some(all_output(r)))
}

// A mistyped argument needs the form; a broken PEM needs the file.
test/nondet "a malformed `--tls` argument fails with a message showing the expected `NAME=CERT.pem,KEY.pem` format, not a diagnostic code" {
  write_program(secure());
  let r = spawned(["run", "--tls", "api"]);
  assert(r.code != 0, Some(all_output(r)));
  assert(stderr(r).contains("--tls NAME=CERT.pem,KEY.pem"), Some(stderr(r)));
  assert(!stderr(r).contains("E0430"), Some(stderr(r)))
}

test/nondet "a run given no TLS credential fails with E0429 naming the credential it is missing" {
  write_program(secure());
  let r = child(["run"]);
  assert(r.code != 0, Some(all_output(r)));
  assert(
    all_output(r).contains("E0429")
      && all_output(r).contains("no TLS credential named `api` was configured for this run"),
    Some(all_output(r)),
  )
}
