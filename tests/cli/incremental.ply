//! The memo store on the path every command takes: a load computes each module through its queries,
//! taking each record whose every read returns what it did. A warm check returns what a cold one
//! does; that results through a store kept across edits are the fresh ones is the compiler's own
//! property, a law of `packages/compiler/checking.ply` over every session of edits.

import spawning.harness (spawned_warm_agrees, spawned, write_project, write, read, all_output,
                         stdout, stderr, json_of, at, path, items, str, int, json_text,
                         WorkingDirectory, diagnostic_codes)
import std.bytes
import std.fs (fs, listed_names)
import std.json (Json)
import std.string
import std.map
import std.list

fn edit(name: String, from: String, to: String) -> Unit / {WorkingDirectory, abort.raise} =
  match read(name) {
    None -> panic("`" ++ name ++ "` reads"),
    Some(text) -> {
      assert(
        text.contains(from),
        Some("`" ++ from ++ "` is not in " ++ name ++ "; the fixture drifted"),
      );
      write(name, text.replace(from, to))
    },
  }

fn leaf() -> String = "pub fn one() -> Int = 1\npub fn two() -> Int = one() + one()\n"

fn query_run_count(runs: Map<String, Int>, query: String) -> Int = runs.get_or(query, 0)

/// What a report's `front_end` counts over every query its load asked: the cached results taken,
/// the bodies run, and of those the bodies of the `module` query.
fn reuse_of(front: Json) -> { taken: Int, ran: Int, modules: Int } =
  items(at(front, "queries")).fold(
    { taken: 0, ran: 0, modules: 0 },
    |acc: { taken: Int, ran: Int, modules: Int }, q: Json|
      {
        taken: acc.taken + int(at(q, "taken")),
        ran: acc.ran + int(at(q, "run")),
        modules: acc.modules
          + (if str(at(q, "query")) == "module" { int(at(q, "run")) } else { 0 }),
      },
  )

test/nondet "a report counts what its load took and ran: an unchanged project runs no body, and an edit runs only what it reached" {
  write_project([
    { path: "leaf.ply", text: leaf() ++ "\ntest \"two is two\" { assert_eq(two(), 2) }\n" },
    { path: "apart.ply", text: "pub fn three() -> Int = 3\n" },
  ]);
  let front = |args: List<String>| path(json_of(spawned(args)), ["front_end"]);
  let checked = || reuse_of(front(["check", ".", "--json", "--explain"]));
  let cold = checked();
  assert(cold.ran > 0, Some("a store nothing was kept in runs every body"));
  let warm = checked();
  assert(
    warm.ran == 0 && warm.taken > 0,
    Some("an unchanged project takes every cached result and runs no body"),
  );
  edit("leaf.ply", "one() + one()", "one() + one() + 0");
  let edited = checked();
  assert(
    edited.modules == 1 && edited.ran < cold.ran,
    Some("the edited module is checked again, and `apart` is not"),
  );
  let tested = front(["test", ".", "--json"]);
  assert_eq(reuse_of(tested).ran, 0);
  assert_eq(int(at(tested, "lost")), 0)
}

// `app` imports `lib`, whose check fails, so the load asks nothing of it; and `lib`, rejected
// whole, is asked for none of its groups.
test/nondet "a load that rejects says what it took and ran, which is nothing of a module that imports the one that rejected" {
  write_project([
    { path: "lib.ply", text: "pub fn broken() -> Int = missing()\n\npub fn fine() -> Int = 1\n" },
    { path: "app.ply", text: "import lib\n\npub fn go() -> Int = lib::fine()\n" },
  ]);
  let cold = spawned(["check", ".", "--json", "--explain"]);
  assert_eq(cold.code, 2);
  let runs = items(path(json_of(cold), ["front_end", "queries"])).fold(
    Map::new(),
    |acc: Map<String, Int>, q: Json| acc.insert(str(at(q, "query")), int(at(q, "run"))),
  );
  assert_eq(query_run_count(runs, "module"), 1);
  assert_eq(query_run_count(runs, "group"), 0);
  let shown = spawned(["check", ".", "--explain"]);
  assert_eq(shown.code, 2);
  assert(stdout(shown).contains("front-end time"), Some(all_output(shown)));
  assert(stdout(shown).contains("module"), Some(all_output(shown)));
  assert(stderr(shown).contains("unknown name `missing`"), Some(all_output(shown)));
  let front = |args: List<String>| path(json_of(spawned(args)), ["front_end"]);
  assert(items(at(front(["test", ".", "--json"]), "queries")).len() > 0);
  assert(items(at(front(["prove", ".", "--json"]), "queries")).len() > 0)
}

fn store() -> String =
  \\import std.db
  \\import std.db (db)
  \\import std.sql
  \\
  \\pub const fn schema() -> sql::Schema =
  \\  {
  \\    tables: [
  \\      {
  \\        name: "items",
  \\        columns: [sql::column("sku", sql::TText, false)],
  \\        primary_key: ["sku"],
  \\        unique: [],
  \\        foreign_keys: [],
  \\        checks: [],
  \\      },
  \\    ],
  \\  }
  \\
  \\fn listed() -> sql::Statement = sql::stmt("select skuu from items")
  \\
  \\pub fn all() -> sql::QueryResult / {db.query[items]} = db.query[items](listed(), [])
  \\

/// Runs a statement against a table `store`'s schema does not declare, which it does not import.
fn ledger() -> String = String::of_bytes_lossy(embed("../programs/incremental/ledger.ply"))

test/nondet "a warm check holds a statement to its module's schema as a cold one does" {
  write_project([
    { path: "store.ply", text: store() },
    { path: "ledger.ply", text: ledger() },
    { path: "other.ply", text: "pub fn seven() -> Int = 7\n" },
  ]);
  // `ledger` neither declares nor imports a schema, so only `store`'s statement is held to one.
  assert_eq(diagnostic_codes(spawned_warm_agrees("cold")), ["E0433"]);
  edit("other.ply", "= 7", "= 8");
  assert_eq(diagnostic_codes(spawned_warm_agrees("after an edit beside the statements")), [
    "E0433",
  ]);
  edit("store.ply", "skuu", "sku");
  assert_eq(diagnostic_codes(spawned_warm_agrees("after the column is mended")), [])
}

fn assert_cache_empty(what: String) -> Unit / {fs.list_dir[cwd], abort.raise} =
  assert(
    List::filter(
        match listed_names(fs.list_dir[cwd](".ply-cache")) { Some(names) -> names, None -> [] },
        |name: String| name.starts_with("manifest-") || name.starts_with("seg-") || name == "memo",
      ).len(
      )
      == 0,
    Some(what ++ " recorded into the cache"),
  )

fn one_test() -> Unit / {WorkingDirectory, abort.raise} =
  write_project([
    { path: "m.ply", text: "pub fn main() -> Int = 1\ntest \"one\" { assert_eq(main(), 1) }\n" },
  ])

// What turns caching off files nothing: `ply build`, `ply hosts` and `--no-cache`.
test/nondet "a command that does not cache files nothing" {
  one_test();
  let tested = spawned(["test", ".", "--no-cache"]);
  assert(tested.code == 0, Some(all_output(tested)));
  assert_cache_empty("`ply test --no-cache`");
  let hosts = spawned(["hosts", "."]);
  assert(hosts.code == 0, Some(all_output(hosts)));
  assert_cache_empty("`ply hosts`");
  let built = spawned(["build", ".", "--digest"]);
  assert(built.code == 0, Some(all_output(built)));
  assert_cache_empty("`ply build`")
}

// A warm `ply prove` resolves every obligation from the cache, across modules that import one
// another.
test/nondet "a warm prove resolves every obligation from the cache" {
  write_project([
    {
      path: "base.ply",
      text:
        \\pub fn one() -> Int = 1
        \\
        \\pub fn bump(x: Int) -> Int
        \\  requires x < 100
        \\  ensures result > x
        \\= x + one()
        \\
    },
    {
      path: "app.ply",
      text:
        \\import base
        \\
        \\fn more(x: Int) -> Int
        \\  requires x < 50
        \\  ensures result > x
        \\= base::bump(x)
        \\
    },
    {
      path: "side.ply",
      text:
        \\fn zero(x: Int) -> Int
        \\  ensures result == 0
        \\= x - x
        \\
    },
  ]);
  let first_run = spawned(["prove", "."]);
  assert(first_run.code == 0, Some(all_output(first_run)));
  let r = spawned(["prove", ".", "--json"]);
  assert(r.code == 0, Some(all_output(r)));
  let v = json_of(r);
  assert(items(at(v, "obligations")).len() == 3, Some(json_text(v)));
  assert(
    int(at(v, "cached")) == 3,
    Some("every obligation is resolved from the cache: " ++ json_text(v)),
  )
}
