//! The memo store across real processes: what one `ply` keeps, the next takes. That results through
//! a store kept across edits are the fresh ones is the compiler's own property, in
//! `compiler.front.checking.edits`.

import harness (Server, spawned_warm_agrees, spawned, start_server, wait_for_exit, completed_result)
import support.harness (write_project, all_output, json_of, path, int, json_text, diagnostic_codes)
import support.projects (edit, leaf)
import std.string
import std.list

fn store() -> String =
  \\import std.db
  \\import std.db (db)
  \\import std.sql
  \\
  \\pub const fn schema() -> sql::Schema =
  \\  {
  \\    tables: [
  \\      {
  \\        name: "items",
  \\        columns: [sql::column("sku", sql::TText, false)],
  \\        primary_key: ["sku"],
  \\        unique: [],
  \\        foreign_keys: [],
  \\        checks: [],
  \\      },
  \\    ],
  \\  }
  \\
  \\fn listed() -> sql::Statement = sql::stmt("select skuu from items")
  \\
  \\pub fn all() -> sql::QueryResult / {db.query[items]} = db.query[items](listed(), [])
  \\

/// Runs a statement against a table `store`'s schema does not declare, which it does not import.
fn ledger() -> String = String::of_bytes_lossy(embed("../programs/incremental/ledger.ply"))

// A check of a statement compiles and enters the schema it reads, so it starts a `ply`.
test/nondet "a warm check holds a statement to its module's schema as a cold one does" {
  write_project([
    { path: "store.ply", text: store() },
    { path: "ledger.ply", text: ledger() },
    { path: "other.ply", text: "pub fn seven() -> Int = 7\n" },
  ]);
  // `ledger` neither declares nor imports a schema, so only `store`'s statement is held to one.
  assert_eq(diagnostic_codes(spawned_warm_agrees("cold")), ["E0433"]);
  edit("other.ply", "= 7", "= 8");
  assert_eq(diagnostic_codes(spawned_warm_agrees("after an edit beside the statements")), [
    "E0433",
  ]);
  edit("store.ply", "skuu", "sku");
  assert_eq(diagnostic_codes(spawned_warm_agrees("after the column is mended")), [])
}

fn streaming() -> String = String::of_bytes_lossy(embed("../programs/incremental/streaming.ply"))

// The project names three of `std.io`'s functions, so its unit is built of what those reach.
test/nondet "a project that streams a file through `std.io` runs what it reaches, warm" {
  write_project([{ path: "m.ply", text: streaming() }]);
  let tested = || json_of(spawned(["test", ".", "--json"]));
  let first_run = tested();
  assert(
    int(path(first_run, ["summary", "failed"])) == 0
      && int(path(first_run, ["summary", "passed"])) == 1,
    Some(json_text(first_run)),
  );
  edit("m.ply", "65536", "4096");
  let again = tested();
  assert(
    int(path(again, ["summary", "failed"])) == 0 && int(path(again, ["summary", "passed"])) == 1,
    Some(json_text(again)),
  )
}

// Two processes, so each files what it checked while the other may be reading.
test/nondet "two overlapping runs leave a cache that still agrees" {
  write_project([
    { path: "leaf.ply", text: leaf() },
    { path: "apart.ply", text: "pub fn three() -> Int = 3\n" },
  ]);
  let one = start_server(["check", "."], [], 0);
  let two = start_server(["check", "."], [], 0);
  [one, two].fold((), |u: Unit, server: Server| {
    let r = completed_result(wait_for_exit(server, 120000, "`ply check` never ended"));
    assert(r.code == 0, Some(all_output(r)))
  });
  let _ = spawned_warm_agrees("after two overlapping runs");
  edit("leaf.ply", "pub fn one() -> Int = 1", "pub fn one() -> Int = 3");
  let _ = spawned_warm_agrees("and an edit after them");
  ()
}
