import spawning.harness (spawned_warm_agrees, spawned, write_project, write, read, all_output,
                         stdout, stderr, json_of, at, path, items, str, int, json_text,
                         WorkingDirectory, PlyProcess, diagnostic_codes)
import std.bytes
import std.fs (fs, listed_names)
import std.json (Json)
import std.string
import std.map
import std.list

fn edit(name: String, from: String, to: String) -> Unit / {WorkingDirectory, abort.raise} =
  match read(name) {
    None -> panic("`" ++ name ++ "` reads"),
    Some(text) -> {
      assert(
        text.contains(from),
        Some("`" ++ from ++ "` is not in " ++ name ++ "; the fixture drifted"),
      );
      write(name, text.replace(from, to))
    },
  }

const leaf: String = "pub fn one() -> Int = 1\npub fn two() -> Int = one() + one()\n"

fn printing(n: Int) -> String =
  "import std.process (process)\n\nfn main() -> Unit / {process.write[proc]} = process.out[proc](\""
    ++ n.to_string()
    ++ "\")\n"

test/nondet "a program runs again, and an edit or its undo runs what the source now says" {
  write_project([{ path: "m.ply", text: printing(41) }]);
  let ran = || all_output(spawned(["run", "."]));
  let first = ran();
  assert(first.contains("41"), Some(first));
  assert_eq(ran(), first);
  write("m.ply", printing(42));
  assert(ran().contains("42"), None);
  write("m.ply", printing(41));
  assert_eq(ran(), first)
}

test/nondet "an artifact is reused while it is on disk and the source is the same" {
  write_project([{ path: "m.ply", text: printing(41) }]);
  let built = || stdout(spawned(["build", "."]));
  let first = built();
  assert_eq(built(), first);
  assert(fs.remove[cwd]("m.plyx"), None);
  assert_eq(built(), first);
  assert(fs.exists[cwd]("m.plyx"), None);
  write("m.ply", printing(42));
  assert(built() != first, None)
}

test/nondet "a proof run ends the same way again, and an edit that breaks a claim fails" {
  let claimed = |result: Int|
    "pub fn id(n: Int) -> Int ensures result == n = n + " ++ result.to_string() ++ "\n";
  write_project([{ path: "m.ply", text: claimed(0) }]);
  assert_eq(spawned(["prove", "."]).code, 0);
  assert_eq(spawned(["prove", "."]).code, 0);
  write("m.ply", claimed(1));
  assert_eq(spawned(["prove", "."]).code, 1)
}

test/nondet "after an edit, a broken claim is reported in its own module" {
  let claimed = |result: Int|
    "pub fn id(n: Int) -> Int ensures result == n = n + " ++ result.to_string() ++ "\n";
  write_project([{ path: "a.ply", text: claimed(0) }, { path: "b.ply", text: claimed(0) }]);
  assert_eq(spawned(["prove", "."]).code, 0);
  write("b.ply", claimed(1));
  let broken = spawned(["prove", "."]);
  assert_eq(broken.code, 1);
  assert(all_output(broken).contains("b.ply"), Some(all_output(broken)))
}

test/nondet "a claim proves beside a body in an imported module that no claim reaches" {
  write_project([
    {
      path: "claimed.ply",
      text: "import lib (twice)\n\npub fn four(n: Int) -> Int requires n > 0 && n < 1000 ensures result == n + n + n + n = twice(twice(n))\n",
    },
    {
      path: "lib.ply",
      text: "pub fn twice(n: Int) -> Int = n + n\n\npub fn spare(n: Int) -> Int = n + 40\n",
    },
  ]);
  let proved = spawned(["prove", "."]);
  assert(proved.code == 0, Some(all_output(proved)))
}

fn sized_program(size: Int, last: Int) -> String =
  range(0, size).fold("", |text: String, i: Int|
      text ++ "fn step" ++ i.to_string() ++ "(n: Int) -> Int = n + " ++ i.to_string() ++ "\n\n")
    ++ "fn last(n: Int) -> Int = n + "
    ++ last.to_string()
    ++ "\n\npub fn main() -> Int = last(1)"
    ++ range(0, size).fold("", |text: String, i: Int| text ++ " + step" ++ i.to_string() ++ "(1)")
    ++ "\n"

test/nondet "a build after an edit writes the artifact a build from nothing writes" {
  write_project([{ path: "m.ply", text: sized_program(3, 1) }]);
  assert_eq(spawned(["build", "."]).code, 0);
  write("m.ply", sized_program(3, 2));
  let warm = spawned(["build", ".", "--json"]);
  let cold = String::join(spawned(["build", ".", "--digest"]).out, "");
  assert(all_output(warm).contains(cold), Some(all_output(warm) ++ " against " ++ cold))
}

test/nondet "an `unused` report follows an edit" {
  write_project([{ path: "m.ply", text: "pub fn main() -> Int = 1\nfn spare() -> Int = 2\n" }]);
  let listed = || stdout(spawned(["unused", "."]));
  let first = listed();
  assert(first.contains("spare"), Some(first));
  assert_eq(listed(), first);
  write("m.ply", "pub fn main() -> Int = spare()\nfn spare() -> Int = 2\n");
  assert(!listed().contains("spare"), None)
}

test/nondet "a `review` follows `--accept` and an edit" {
  write_project([{ path: "m.ply", text: "pub fn main() -> Int = 1\n" }]);
  let reviewed = || stdout(spawned(["review", "."]));
  let first = reviewed();
  assert(first.contains("never reviewed"), Some(first));
  assert_eq(reviewed(), first);
  assert_eq(spawned(["review", ".", "--accept"]).code, 0);
  let accepted = reviewed();
  assert(accepted.contains("no definition changed since the last accepted review"), Some(accepted));
  write("m.ply", "pub fn main() -> Int = 2\n");
  assert(!reviewed().contains("no definition changed"), None)
}

test/nondet "`show` finds a definition by the name index and reports the same thing as a full name" {
  write_project([
    { path: "leaf.ply", text: leaf },
    { path: "other.ply", text: "pub fn one() -> Int = 1\n" },
  ]);
  assert(spawned(["check", "."]).code == 0, None);
  assert_eq(stdout(spawned(["show", "two", "."])), stdout(spawned(["show", "leaf.two", "."])));
  assert(stdout(spawned(["show", "two", "."])).contains("one() + one()"), None);
  assert(spawned(["show", "one", "."]).code != 0, Some("two modules declare `one`"))
}

test/nondet "`callers` prints the same lines again, and an edit changes them" {
  write_project([{ path: "leaf.ply", text: leaf }]);
  let callers = || stdout(spawned(["callers", "leaf.one", "."]));
  let first = callers();
  assert(first.contains("leaf.two"), Some(first));
  assert_eq(callers(), first);
  edit("leaf.ply", "one() + one()", "2");
  assert(!callers().contains("leaf.two"), None)
}

const sim_package: List<{ path: String, text: String }> =
  [
    { path: "model.ply", text: String::of_bytes_lossy(embed("../../packages/sim/model.ply")) },
    { path: "plan.ply", text: String::of_bytes_lossy(embed("../../packages/sim/plan.ply")) },
    {
      path: "recording.ply",
      text: String::of_bytes_lossy(embed("../../packages/sim/recording.ply")),
    },
    { path: "search.ply", text: String::of_bytes_lossy(embed("../../packages/sim/search.ply")) },
  ]

fn appended(name: String, text: String) -> Unit / {WorkingDirectory, abort.raise} =
  match read(name) {
    Some(old) -> write(name, old ++ text),
    None -> panic("`" ++ name ++ "` reads"),
  }

test/nondet "after edits to a real package, a check through the store reports what a check from nothing reports" {
  let agrees = |what: String| {
    let _ = spawned_warm_agrees(what);
    ()
  };
  write_project(sim_package);
  agrees("the first check");
  appended("recording.ply", "\npub fn step_limit() -> Int = 1\n");
  write(
    "limits.ply",
    "import recording\n\npub fn doubled() -> Int = recording::step_limit() * 2\n",
  );
  agrees("a function and a module added");
  edit("recording.ply", "step_limit() -> Int = 1", "step_limit() -> Int = 2");
  agrees("a body edited");
  edit("recording.ply", "step_limit() -> Int = 2", "step_limit() -> Bool = true");
  agrees("a signature edited, which makes a type error");
  edit("recording.ply", "step_limit() -> Bool = true", "step_limit() -> Int = 1");
  agrees("the type error fixed")
}

const store: String =
  \\import std.db
  \\import std.db (db)
  \\import std.sql
  \\
  \\pub const schema: sql::Schema =
  \\  {
  \\    tables: [
  \\      {
  \\        name: "items",
  \\        columns: [sql::column("sku", sql::TText, false)],
  \\        primary_key: ["sku"],
  \\        unique: [],
  \\        foreign_keys: [],
  \\        checks: [],
  \\      },
  \\    ],
  \\  }
  \\
  \\fn listed() -> sql::Statement = sql::statement_of("select skuu from items")
  \\
  \\pub fn all() -> sql::QueryResult / {db.query[items]} = db.query[items](listed(), [])
  \\

const ledger: String = String::of_bytes_lossy(embed("../programs/incremental/ledger.ply"))

test/nondet "a warm `ply check` reports the same schema errors in a module's store statements as a cold check, including after unrelated edits" {
  write_project([
    { path: "store.ply", text: store },
    { path: "ledger.ply", text: ledger },
    { path: "other.ply", text: "pub fn seven() -> Int = 7\n" },
  ]);
  assert_eq(diagnostic_codes(spawned_warm_agrees("cold")), ["E0433"]);
  edit("other.ply", "= 7", "= 8");
  assert_eq(diagnostic_codes(spawned_warm_agrees("after an edit beside the statements")), [
    "E0433",
  ]);
  edit("store.ply", "skuu", "sku");
  assert_eq(diagnostic_codes(spawned_warm_agrees("after the column is mended")), [])
}

fn assert_cache_empty(what: String) -> Unit / {fs.list_dir[cwd], abort.raise} =
  assert(
    List::filter(
        match listed_names(fs.list_dir[cwd](".ply-cache")) { Some(names) -> names, None -> [] },
        |name: String| name.starts_with("manifest-") || name.starts_with("seg-") || name == "memo",
      ).len(
      )
      == 0,
    Some(what ++ " recorded into the cache"),
  )

fn one_test() -> Unit / {WorkingDirectory, abort.raise} =
  write_project([
    { path: "m.ply", text: "pub fn main() -> Int = 1\ntest \"one\" { assert_eq(main(), 1) }\n" },
  ])

test/nondet "`ply test --no-cache` and `ply build --digest` write nothing to the cache" {
  one_test();
  let tested = spawned(["test", ".", "--no-cache"]);
  assert(tested.code == 0, Some(all_output(tested)));
  assert_cache_empty("`ply test --no-cache`");
  let built = spawned(["build", ".", "--digest"]);
  assert(built.code == 0, Some(all_output(built)));
  assert_cache_empty("`ply build --digest`")
}

test/nondet "a warm prove resolves every obligation from the cache" {
  write_project([
    {
      path: "base.ply",
      text:
        \\pub fn one() -> Int = 1
        \\
        \\pub fn bump(x: Int) -> Int
        \\  requires x < 100
        \\  ensures result > x
        \\= x + one()
        \\
    },
    {
      path: "app.ply",
      text:
        \\import base
        \\
        \\fn more(x: Int) -> Int
        \\  requires x < 50
        \\  ensures result > x
        \\= base::bump(x)
        \\
    },
    {
      path: "side.ply",
      text:
        \\fn zero(x: Int) -> Int
        \\  ensures result == 0
        \\= x - x
        \\
    },
  ]);
  let first_run = spawned(["prove", "."]);
  assert(first_run.code == 0, Some(all_output(first_run)));
  let r = spawned(["prove", ".", "--json"]);
  assert(r.code == 0, Some(all_output(r)));
  let v = json_of(r);
  assert(items(at(v, "obligations")).len() == 3, Some(json_text(v)));
  assert(
    int(at(v, "cached")) == 3,
    Some("every obligation is resolved from the cache: " ++ json_text(v)),
  )
}
