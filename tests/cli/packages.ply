import harness (spawned)
import support.harness (write_project, write, read, empty_working_directory, working_directory,
                        environment, all_output, stdout, WorkingDirectory, assert_ok, dependency,
                        exists, manifest)
import std.config (config)
import std.fs (fs)
import std.process (process, Exited)
import std.string

fn graph() -> Unit / {WorkingDirectory, abort.raise} =
  write_project([
    { path: "app/ply.pkg", text: manifest("app", dependency("lib", "../lib")) },
    {
      path: "app/main.ply",
      text: "import lib.answer\nfn main() -> Int = answer::answer()\ntest \"answers\" { assert_eq(answer::answer(), 42) }\n",
    },
    { path: "lib/ply.pkg", text: manifest("lib", dependency("base", "../base")) },
    {
      path: "lib/answer.ply",
      text: "import base.deep\nimport extra\npub fn answer() -> Int = deep::deep() + extra::hidden()\n",
    },
    { path: "lib/extra.ply", text: "pub fn hidden() -> Int = 35\n" },
    { path: "base/ply.pkg", text: manifest("base", "") },
    { path: "base/deep.ply", text: "pub fn deep() -> Int = 7\n" },
  ])

fn lock_of(p: String) -> String / {WorkingDirectory, abort.raise} =
  match read(p) { Some(t) -> t, None -> panic("`" ++ p ++ "` was written") }

test/nondet "`ply check`, `run`, `test` and `build` all succeed on a project that depends on a package by path" {
  graph();
  [
    { args: ["check", "app"], want: "checked 5 modules" },
    { args: ["run", "app", "--json"], want: "\"value\":\"42\"" },
    { args: ["test", "app"], want: "1 passed" },
    { args: ["build", "app", "-o", "app.plyx"], want: "built main.main" },
  ].fold((), |u: Unit, c: { args: List<String>, want: String }| {
    let r = spawned(c.args);
    assert(
      r.code == 0 && all_output(r).contains(c.want),
      Some(String::join(c.args, " ") ++ ": " ++ all_output(r)),
    )
  })
}

fn git(
  dir: String,
  args: List<String>,
) -> String / {config.get[env], process.spawn[git], abort.raise} = {
  let f = process.spawn[git](args, dir, environment([]));
  let out = String::of_bytes_lossy(f.out);
  match f.ended {
    Exited(0) -> out,
    _ -> panic("`git " ++ String::join(args, " ") ++ "`: " ++ String::of_bytes_lossy(f.err)),
  }
}

fn git_repo(
  dir: String,
  source: String,
) -> String / {WorkingDirectory, config.get[env], process.spawn[git], abort.raise} = {
  if !fs.exists[cwd](dir ++ "/.git") {
    let _ = git(dir, ["init", "--quiet"]);
    ()
  };
  write(dir ++ "/ply.pkg", manifest("gitlib", ""));
  write(dir ++ "/answer.ply", source);
  let _ = git(dir, ["add", "-A"]);
  let _ = git(dir, [
    "-c",
    "user.email=t@test",
    "-c",
    "user.name=test",
    "commit",
    "--quiet",
    "-m",
    "a",
  ]);
  git(dir, ["rev-parse", "HEAD"]).trim()
}

fn git_project(lib: String, rev: String) -> Unit / {WorkingDirectory, abort.raise} = {
  write(
    "app/ply.pkg",
    manifest(
      "app",
      "{name: \"gitlib\", prefix: None, min: {major: 0, minor: 0, patch: 1}, source: Git(\"" ++ lib
        ++ "\", \""
        ++ rev
        ++ "\")}",
    ),
  );
  write(
    "app/main.ply",
    "import gitlib.answer\nfn main() -> Int = answer::answer()\ntest \"answers\" { assert_eq(answer::answer(), 7) }\n",
  )
}

fn lib_dir() -> String / {WorkingDirectory, abort.raise} = working_directory() ++ "/lib"

test/nondet "a git dependency is fetched once and then works with `check`, `run` and `test` like a path dependency" {
  empty_working_directory();
  assert(fs.create_dir[cwd]("lib"), None);
  let rev = git_repo("lib", "pub fn answer() -> Int = 7\n");
  git_project(lib_dir(), rev);
  [
    { args: ["check", "app"], want: "checked 3 modules" },
    { args: ["run", "app", "--json"], want: "\"value\":\"7\"" },
    { args: ["test", "app"], want: "1 passed" },
  ].fold((), |u: Unit, c: { args: List<String>, want: String }| {
    let r = spawned(c.args);
    assert(r.code == 0, Some(String::join(c.args, " ") ++ ": " ++ all_output(r)));
    assert(all_output(r).contains(c.want), Some(String::join(c.args, " ") ++ ": " ++ all_output(r)))
  });
  assert(exists("app/.ply-cache/git"), None);
  assert_ok(spawned(["resolve", "app"]));
  assert(lock_of("app/ply.lock").contains("\"name\":\"gitlib\""), None);
  assert(fs.remove_tree[cwd]("lib"), None);
  assert_ok(spawned(["check", "app"]))
}

test/nondet "a vendored project builds with no repository and no cache" {
  empty_working_directory();
  assert(fs.create_dir[cwd]("lib"), None);
  let _ = git_repo("lib", "pub fn answer() -> Int = 7\n");
  write("lib/data.txt", "a package ships what it ships\n");
  let rev = git_repo("lib", "pub fn answer() -> Int = 7\n");
  git_project(lib_dir(), rev);
  let r = spawned(["vendor", "app"]);
  assert_ok(r);
  assert(stdout(r).contains("vendored 1 package"), Some(stdout(r)));
  assert(stdout(r).contains("vendor/gitlib"), Some(stdout(r)));
  assert(exists("app/vendor/gitlib/ply.pkg"), None);
  assert(exists("app/vendor/gitlib/answer.ply"), None);
  assert(exists("app/vendor/gitlib/data.txt"), None);
  assert(!exists("app/vendor/gitlib/.git"), None);
  let index = lock_of("app/vendor/index");
  assert(index.starts_with("git+"), Some(index));
  assert(index.ends_with("vendor/gitlib\n"), Some(index));
  assert_ok(spawned(["vendor", "app"]));
  assert(lock_of("app/vendor/index") == index, None);
  assert(fs.remove_tree[cwd]("lib"), None);
  assert(fs.remove_tree[cwd]("app/.ply-cache"), None);
  [
    { args: ["check", "app"], want: "checked 3 modules" },
    { args: ["run", "app", "--json"], want: "\"value\":\"7\"" },
    { args: ["resolve", "app"], want: "1 package" },
  ].fold((), |u: Unit, c: { args: List<String>, want: String }| {
    let run = spawned(c.args);
    assert(run.code == 0, Some(String::join(c.args, " ") ++ ": " ++ all_output(run)));
    assert(
      all_output(run).contains(c.want),
      Some(String::join(c.args, " ") ++ ": " ++ all_output(run)),
    )
  })
}
