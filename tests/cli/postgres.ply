//! A postgres cluster of a test's own, for the tests that drive a real server: initialised in the
//! working directory, which a launch empties first, so a test writes its program after the cluster
//! starts; served on a port nothing held, reached over TCP with its superuser's password, and stopped
//! when the test is done. The run binds `initdb`, `postgres` and `psql` with `--exec`;
//! a run that binds none skips these tests, except under CI, which promises a postgres.

import harness (WorkingDirectory, PlyProcess, Network, environment, empty_working_directory,
                reserve_port, all_output, spawned, working_directory)
import std.config (config)
import std.fs (fs)
import std.list
import std.process (process, CompletedProcess, Var, exit_code, Discard, Interrupt, Keep)
import std.time (time)

pub effect set Postgres = {process.read[initdb], process.write[initdb], process.read[postgres], process.write[postgres], process.read[psql], process.write[psql], config.get[env], time.read, time.write}

/// A running cluster: its directory below the working directory, its port, and the server's child.
pub type Cluster = { dir: String, port: Int, server: Int, password: String }

/// Whether this run can start a cluster. CI promises one, so there a run without one fails rather
/// than skips.
pub fn available() -> Bool / {Postgres, abort.raise} = {
  let found = process.bound[initdb]() && process.bound[postgres]() && process.bound[psql]();
  if !found && config.get[env]("CI") != None {
    panic("CI runs the postgres-backed tests, and this run bound no initdb, postgres and psql")
  };
  found
}

/// TCP connections prove `password` by SCRAM.
pub fn scram(
  name: String,
  password: String,
) -> Cluster / {WorkingDirectory, Network, Postgres, abort.raise, diverges} =
  launch(name, "scram-sha-256", password, None)

/// TCP connections send `password` in the clear, which `password` authentication asks for.
pub fn clear_text(
  name: String,
  password: String,
) -> Cluster / {WorkingDirectory, Network, Postgres, abort.raise, diverges} =
  launch(name, "password", password, None)

/// [`scram`]'s cluster, speaking TLS with `certificate` and its `key` (PEM) as well as plaintext, so
/// a client's `sslmode` decides which.
pub fn scram_with_tls(
  name: String,
  password: String,
  certificate: String,
  key: String,
) -> Cluster / {WorkingDirectory, Network, Postgres, abort.raise, diverges} =
  launch(name, "scram-sha-256", password, Some((certificate, key)))

/// A server without a locale starts threads on macOS before it forks, and refuses to.
fn c_locale() -> List<Var> = [{ name: "LC_ALL", value: "C" }]

fn output_or_fail(f: CompletedProcess) -> String / {abort.raise} =
  if exit_code(f) == Some(0) { String::of_bytes_lossy(f.out) }
  else { panic(String::of_bytes_lossy(f.err)) }

fn launch(
  name: String,
  auth: String,
  password: String,
  tls: Option<(String, String)>,
) -> Cluster / {WorkingDirectory, Network, Postgres, abort.raise, diverges} = {
  empty_working_directory();
  let dir = match fs.temp_dir[cwd](".", "pg-" ++ name ++ "-") {
    Some(d) -> d,
    None -> panic("a directory for the cluster"),
  };
  let _ = fs.write_file[cwd](dir ++ "/password", Bytes::of_string(password));
  let root = match fs.canonical[cwd](dir) {
    Some(p) -> p,
    None -> panic("the cluster's directory has a path"),
  };
  let data = root ++ "/data";
  let _ = output_or_fail(
    process.spawn[initdb](
      [
        "-D",
        data,
        "-U",
        "ply",
        "--no-sync",
        "-E",
        "UTF8",
        "--locale=C",
        "--auth-local=" ++ auth,
        "--auth-host=" ++ auth,
        "--pwfile=" ++ root ++ "/password",
      ],
      "",
      environment(c_locale()),
    ),
  );
  let scram_with_tls = match tls {
    None -> [],
    Some((certificate, key)) -> {
      let _ = fs.write_file[cwd](dir ++ "/data/server.crt", Bytes::of_string(certificate));
      let _ = fs.write_file[cwd](dir ++ "/data/server.key", Bytes::of_string(key));
      // Postgres refuses a key that anyone but its owner can read.
      let none = { read: false, write: false, execute: false };
      let _ = fs.set_mode[cwd](dir ++ "/data/server.key", {
        owner: { read: true, write: true, execute: false },
        group: none,
        other: none,
      });
      ["-c", "ssl=on", "-c", "ssl_cert_file=server.crt", "-c", "ssl_key_file=server.key"]
    },
  };
  let port = reserve_port();
  let server = match process.start[postgres](
      [
        "-D",
        data,
        "-p",
        port.to_string(),
        "-c",
        "listen_addresses=localhost",
        "-c",
        "unix_socket_directories=",
        "-c",
        "fsync=off",
        "-c",
        "full_page_writes=off",
        "-c",
        "synchronous_commit=off",
      ].concat(
        scram_with_tls,
      ),
      "",
      environment(c_locale()),
      { input: false, out: Discard, err: Keep },
    ) {
    Ok(child) -> child,
    Err(why) -> panic("postgres did not start: " ++ why),
  };
  let cluster = { dir: dir, port: port, server: server, password: password };
  match wait_until_ready(cluster, 300, "") {
    None -> (),
    Some(why) -> {
      let _ = process.signal[postgres](server, Interrupt);
      let said = match process.wait[postgres](server, 10000) {
        Some(f) -> String::of_bytes_lossy(f.err),
        None -> "",
      };
      panic("postgres did not become ready within thirty seconds: " ++ why ++ "\n" ++ said)
    },
  };
  let _ = psql(cluster, "postgres", "create database " ++ name);
  cluster
}

/// Why the cluster did not answer within `tries` tenths of a second, if it did not.
fn wait_until_ready(c: Cluster, tries: Int, last: String) -> Option<String> / {Postgres, diverges} =
  if tries <= 0 { Some(last) } else {
    let f = run_psql(c, "postgres", "select 1");
    if exit_code(f) == Some(0) { None } else {
      time.sleep_ms(100);
      wait_until_ready(c, tries - 1, String::of_bytes_lossy(f.err))
    }
  }

fn run_psql(c: Cluster, database: String, sql: String) -> CompletedProcess / {Postgres} =
  process.spawn[psql](
    [
      "-h",
      "127.0.0.1",
      "-p",
      c.port.to_string(),
      "-U",
      "ply",
      "-d",
      database,
      "-v",
      "ON_ERROR_STOP=1",
      "-t",
      "-A",
      "-c",
      sql,
    ],
    "",
    environment([{ name: "PGPASSWORD", value: c.password }]),
  )

/// What `sql` printed in `database`, trimmed; a statement that fails fails the test.
pub fn psql(c: Cluster, database: String, sql: String) -> String / {Postgres, abort.raise} =
  output_or_fail(run_psql(c, database, sql)).trim()

/// Stops the server the fast way, which ends its sessions and frees its shared memory.
pub fn stop(c: Cluster) -> Unit / {Postgres} = {
  let _ = process.signal[postgres](c.server, Interrupt);
  let _ = process.wait[postgres](c.server, 10000);
  ()
}

/// What the program in `inner.ply` answered, run as `ply run` runs it with `flags` and its `main`
/// handed `words`: `Ok` of the line it wrote after `heard `, or `Err` of the one after `refused `.
pub fn program_answer(
  words: List<String>,
  flags: List<String> = [],
) -> Result<String, String> / {PlyProcess, abort.raise} = {
  let r = spawned(["run", "inner.ply"].concat(flags).concat(["--"]).concat(words));
  match r.out.filter(|l: String| l.starts_with("heard ") || l.starts_with("refused ")) {
    [] -> panic("the program answered nothing:\n" ++ all_output(r)),
    [line, ..] -> if line.starts_with("heard ") { Ok(line.slice(6, line.len())) }
    else { Err(line.slice(8, line.len())) },
  }
}

/// What the program's `entry` answered given a connection string `url`.
pub fn call_with_url(
  entry: String,
  url: String,
  flags: List<String> = [],
) -> Result<String, String> / {PlyProcess, abort.raise} = program_answer([entry, url], flags)

/// `postgres://ply:<password>@<host>:<port>/<database>?<query>`, the password as given.
pub fn url(c: Cluster, host: String, database: String, query: String) -> String =
  "postgres://ply:" ++ c.password ++ "@" ++ host ++ ":" ++ c.port.to_string() ++ "/" ++ database
    ++ "?"
    ++ query
