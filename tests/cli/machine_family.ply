//! The capability a program enters another program with, end to end in this process: the program
//! `compiler.load` reads and `compiler.cc` compiles is opened, bound as the options lend it, and its
//! definitions entered, with how each entry ended and what it used.

import harness (Here, Shipped, Loaded, compiled_here, entered, loaded, project, scratch, unloaded,
                write)
import cli.machine
import cli.machine (Options, default_options)
import compiler.check.resolve.tables (Diag)
import cli.diagnostic (Raised)
import std.fs
import std.fs (fs)
import std.machine as entering
import std.value (Value, VInt)

/// The capability's operations a test performs.
effect set Driving = {entering::machine.open, entering::machine.bind, entering::machine.enter, entering::machine.unbind, entering::machine.close}

/// How one entry ended: the code it chose, its answer or what it raised, what it ended with, and
/// what it used.
type Ended = {
  exit: Option<Int>,
  answer: Result<Value, Raised>,
  warnings: List<Diag>,
  usage: entering::Usage,
}

fn ended_of(
  l: Loaded,
  name: String,
  args: List<Value>,
) -> Ended / {entering::machine.enter, abort.raise} = {
  let o = entered(l, name, args);
  {
    exit: o.exit,
    answer: machine::answer_of(o.ended, l.roots, "inner." ++ name),
    warnings: machine::warnings_of(o, l.roots),
    usage: o.usage,
  }
}

/// How `inner.main` of the module `inner` ended, entered under `options`.
fn main_of(inner: String, options: Options) -> Ended / {Here, Shipped, Driving, abort.raise} = {
  project([{ path: "inner.ply", text: inner }]);
  let l = loaded(options);
  let ended = ended_of(l, "main", []);
  let _ = unloaded(l);
  ended
}

/// Bound with a trace sink that writes nothing; the trace facility closes what an entry leaves open.
fn traced_quietly() -> Options = { ..default_options(), trace: { sink: "off", level: "info" } }

fn leaves_a_span() -> String =
  \\import std.trace
  \\import std.trace (trace)
  \\
  \\fn main() -> Int / {trace.write[orders]} = {
  \\  let order = trace.enter[orders]("order", Map::new());
  \\  3
  \\}
  \\

fn warns_of_the_open_span(warnings: List<Diag>) -> Unit / {abort.raise} =
  match warnings {
    [w] -> {
      assert_eq(w.code, b"W0609");
      assert(
        w.message.index_of(b"`order` on `orders`") != None,
        Some(String::of_bytes_lossy(w.message)),
      )
    },
    _ -> panic("one warning, not " ++ warnings.len().to_string()),
  }

fn code_of(answer: Result<Value, Raised>) -> Bytes =
  match answer { Ok(_) -> b"", Err(r) -> r.diag.code }

test "a program opens, binds and enters a program, which answers its value" {
  scratch(|| {
    let ended = main_of("fn main() -> Int = 40 + 2\n", default_options());
    assert_eq(ended.answer, Ok(VInt(42)));
    assert_eq(ended.exit, None)
  })
}

fn exits() -> String =
  "import std.process (process)\n\nfn main() -> Unit / {process.exit[proc]} = process.exit[proc](7)\n"

test/nondet "a nested program may choose the exit code, where the binding lends the process" {
  let ended = main_of(exits(), default_options());
  assert_eq(ended.exit, Some(7));
  assert_eq(code_of(ended.answer), b"")
}

// A raise is a diagnostic value; the outer program does not unwind through it.
test "a nested raise is a value, not an unwind" {
  scratch(|| {
    let ended = main_of(
      "fn main() -> Int / {abort.raise} = panic(\"the inner program's own bug\")\n",
      default_options(),
    );
    assert_eq(ended.exit, None);
    match ended.answer {
      Ok(_) -> panic("the raise is reported"),
      Err(r) -> {
        assert_eq(r.diag.code, b"E0502");
        assert(
          r.diag.message.index_of(b"the inner program's own bug") != None,
          Some(String::of_bytes_lossy(r.diag.message)),
        )
      },
    }
  })
}

test/nondet "an entry that left a span open answers W0609 beside its value" {
  project([{ path: "inner.ply", text: leaves_a_span() }]);
  let l = loaded(traced_quietly());
  let ended = ended_of(l, "main", []);
  let _ = unloaded(l);
  assert_eq(ended.answer, Ok(VInt(3)));
  warns_of_the_open_span(ended.warnings)
}

test "an edited program's unit enters the new program, and opening one files nothing" {
  scratch(|| {
    project([{ path: "inner.ply", text: "fn main() -> Int = 1\n" }]);
    let first = loaded(default_options());
    assert_eq(ended_of(first, "main", []).answer, Ok(VInt(1)));
    assert(
      fs.kind[cwd](".ply-cache") == fs::Missing,
      Some("opening a unit reads the library it was handed and files nothing"),
    );
    write("inner.ply", "fn main() -> Int = 2\n");
    let again = loaded(default_options());
    assert_eq(ended_of(again, "main", []).answer, Ok(VInt(2)));
    // The first unit stays as it was opened until it is closed.
    assert_eq(ended_of(first, "main", []).answer, Ok(VInt(1)));
    let _ = unloaded(first);
    let _ = unloaded(again);
    ()
  })
}

test "a call enters a definition with its arguments, and says what it spent" {
  scratch(|| {
    project([
      {
        path: "inner.ply",
        text: "fn main() -> Int = 0\n\npub fn double(x: Int) -> Int = x * 2\n\npub fn boom() -> Int / {abort.raise} = panic(\"oh no\")\n",
      },
    ]);
    let l = loaded(default_options());
    let doubled = ended_of(l, "double", [VInt(21)]);
    let raised = ended_of(l, "boom", []);
    let _ = unloaded(l);
    assert_eq(doubled.answer, Ok(VInt(42)));
    assert(doubled.usage.steps > 0, Some("the call's steps were not counted"));
    match raised.answer {
      Ok(_) -> panic("`boom` answered"),
      Err(r) ->
        assert(
          r.diag.message.index_of(b"oh no") != None,
          Some(String::of_bytes_lossy(r.diag.message)),
        ),
    };
    assert(raised.usage.steps > 0, Some("the raising call's steps were not counted"))
  })
}

// A memo's answer and a declined call cost their entry nothing, so a constant run and then
// answered from the memo costs one run of its body, not two.
test "a memo's answer and a declined call spend no steps" {
  scratch(|| {
    project([
      {
        path: "inner.ply",
        text: "fn main() -> Int = 0\n\nfn deep(n: Int) -> Int = if n <= 0 { 0 } else { 1 + deep(n - 1) }\n\npub fn constant() -> Int = deep(50)\n\npub fn twin() -> Int = deep(50)\n",
      },
    ]);
    let l = loaded(default_options());
    let steps = |name: String| {
      let e = ended_of(l, name, []);
      { answer: e.answer, steps: e.usage.steps }
    };
    let ran = steps("constant");
    let remembered = steps("constant");
    let twin = steps("twin");
    let twin_again = steps("twin");
    // A name the program never defined is declined.
    let declined = steps("absent");
    let _ = unloaded(l);
    assert_eq(ran.answer, Ok(VInt(50)));
    assert(ran.steps > 0, Some("the first call's steps were not counted"));
    assert_eq(remembered.steps, 0);
    assert_eq(twin.steps + twin_again.steps, ran.steps);
    assert(declined.answer != Ok(VInt(0)), Some("an absent name answered"));
    assert_eq(declined.steps, 0)
  })
}

/// The calls `fib(n)` makes, itself included.
fn fib_calls(n: Int) -> Int = if n < 2 { 1 } else { 1 + fib_calls(n - 1) + fib_calls(n - 2) }

// Each branch fits the budget alone and the two do not: the block spends what evaluating them in turn
// spends, wherever they ran.
test/nondet "the branches of a parallel block spend one step budget between them" {
  let program = "fn main() -> Int = 0\n\nfn fib(n: Int) -> Int = if n < 2 { n } else { fib(n - 1) + fib(n - 2) }\n\npub fn pair(n: Int) -> Int = {\n  let p = parallel { fib(n), fib(n + 1) };\n  p._0 + p._1\n}\n";
  let alone = fib_calls(20);
  let both = alone + fib_calls(21);
  let under = |steps: Int| {
    project([{ path: "inner.ply", text: program }]);
    let l = loaded({ ..default_options(), steps: steps });
    let answer = ended_of(l, "pair", [VInt(20)]).answer;
    let _ = unloaded(l);
    match answer { Ok(v) -> Ok(v), Err(r) -> Err(r.diag.code) }
  };
  assert_eq(under(both - alone / 2), Err(b"E0503"));
  assert_eq(under(both + 16), Ok(VInt(6765 + 10946)))
}

/// Per round, a task nobody joins and one the root joins, each opening a region of its own; a task
/// per round that is let go; and a hold per round.
fn churning() -> String =
  \\fn main() -> Int = 0
  \\
  \\fn counted(i: Int) -> Int = with_hold[work](i, |x: Int| ()) { c -> c.get() + 1 }
  \\
  \\pub fn churn(n: Int) -> Int / {task.write, abort.raise} =
  \\  range(0, n).fold(0, |sum: Int, i: Int| {
  \\    task.spawn(|| counted(i));
  \\    let t = task.spawn(|| counted(i));
  \\    task.yield();
  \\    sum + task.join(t)
  \\  })
  \\
  \\pub fn fired(n: Int) -> Int / {task.write} =
  \\  range(0, n).fold(0, |sum: Int, i: Int| {
  \\    task.spawn(|| counted(i));
  \\    task.yield();
  \\    sum + i
  \\  })
  \\
  \\

/// How `name(n)` ended, and what the run held when its root returned.
fn held_by(name: String, n: Int) -> Ended / {Here, Shipped, Driving, abort.raise} = {
  project([{ path: "inner.ply", text: churning() }]);
  let l = loaded(default_options());
  let ended = ended_of(l, name, [VInt(n)]);
  let _ = unloaded(l);
  ended
}

// A server spawns per connection for as long as it runs, so its tables must follow the live tasks.
test/nondet "a production region keeps its tables to the tasks still live" {
  let h = held_by("churn", 200);
  assert_eq(h.answer, Ok(VInt(200 * 201 / 2)));
  assert(
    h.usage.scheduled <= 3,
    Some("the scheduler keeps " ++ h.usage.scheduled.to_string() ++ " tasks after 400 spawns"),
  );
  assert(
    h.usage.task_stacks <= 2,
    Some(h.usage.task_stacks.to_string() ++ " task stacks after 400 spawns"),
  );
  assert(
    h.usage.frame_tables <= 8,
    Some(h.usage.frame_tables.to_string() ++ " frame tables after 400 spawns"),
  )
}

// A spawn's handle is a bridge, which a server makes per request.
test/nondet "a production region that drops its task handles gives their bridges back" {
  let h = held_by("fired", 10000);
  assert_eq(h.answer, Ok(VInt(10000 * 9999 / 2)));
  assert(
    h.usage.bridges <= 4,
    Some(h.usage.bridges.to_string() ++ " bridges after 10000 dropped handles"),
  )
}
