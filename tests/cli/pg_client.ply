//! `std.pg`'s client against a real server, whose TCP connections demand a password: SCRAM against
//! postgres rather than against a script, and a clear-text password sent sealed.

import harness (Here, Shipped, Loaded, answered_text, loaded, write)
import postgres
import postgres (Postgres)
import cli.machine (default_options)
import std.machine as entering
import std.value (VInt, VStr)

effect set Driving = {entering::machine.open, entering::machine.bind, entering::machine.enter, entering::machine.unbind, entering::machine.close}

fn client() -> String =
  \\import std.net (net)
  \\import std.pg (connect, simple_query, finish, default_client, Answer, client_error_text, NoTls)
  \\
  \\fn main() -> Int = 0
  \\
  \\pub fn ask_with_password(host: String, port: Int, user: String, password: String, nonce: String) -> Result<String, String>
  \\  / {net.connect[link], net.start_tls[link], net.peer_certificate[link], net.send_secret[link], net.send[link], net.recv[link], net.close[link], abort.raise, diverges} =
  \\  match connect[link](host, port, NoTls, user, "ply", [], Some(Secret::of_string(password).bytes()), nonce, default_client()) {
  \\    Err(e) -> Err(client_error_text(e)),
  \\    Ok(session) -> match simple_query[link](session, "select 1", default_client()) {
  \\      Err(e) -> Err(client_error_text(e)),
  \\      Ok(reply) -> {
  \\        finish[link](reply.session, default_client());
  \\        Ok(first_text(reply.answer))
  \\      },
  \\    },
  \\  }
  \\
  \\fn first_text(answer: Answer) -> String / {abort.raise} =
  \\  match answer.rows {
  \\    [[Some(text), ..], ..] -> String::of_bytes(text),
  \\    _ -> "no value",
  \\  }
  \\

/// What the client answered over the cluster at `port` with `password`, as `Ok`'s text or `Err`'s.
fn asked(
  l: Loaded,
  port: Int,
  password: String,
) -> Result<String, String> / {Driving, abort.raise} =
  answered_text(l, "ask_with_password", [
    VStr("127.0.0.1"),
    VInt(port),
    VStr("ply"),
    VStr(password),
    VStr("a-cluster-test-nonce"),
  ])

fn hosted() -> Loaded / {Here, Shipped, Driving, abort.raise} = {
  write("inner.ply", client());
  loaded({ ..default_options(), host: true })
}

test/nondet "the client speaks SCRAM to a real server" {
  if postgres::available() {
    let c = postgres::scram("ply", "pencil");
    let l = hosted();
    let r = asked(l, c.port, "pencil");
    postgres::done(l, c);
    assert_eq(r, Ok("1"))
  }
}

// The password goes out sealed, by `net.send_secret`; a wrong one is the server's refusal.
test/nondet "the client sends a clear-text password to a real server, and a wrong one is refused" {
  if postgres::available() {
    let c = postgres::clear_text("ply", "pencil");
    let l = hosted();
    let right = asked(l, c.port, "pencil");
    let wrong = asked(l, c.port, "crayon");
    postgres::done(l, c);
    assert_eq(right, Ok("1"));
    assert(match wrong { Err(why) -> why.contains("28P01"), Ok(_) -> false }, None)
  }
}
