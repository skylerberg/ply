import harness (PlyProcess, spawned)
import support.harness (Source, write_program, write_project, write, all_output, stdout, stderr,
                        json_of, at, path, nth, items, str, int, bool, json_text, code_of,
                        diagnostic, not_ok, value_of)
import support.artifacts (NameRecord, names_of, parts_of, runnable_text, shipped_files)
import compiler.store.plyx (format_version)
import std.fs (fs)
import std.json
import std.json (Json, Null, Str)
import std.string
import std.list

fn source() -> String =
  \\effect log { write emit[c](msg: String) -> Unit }
  \\
  \\type Colour = | Red | Blue(Int)
  \\
  \\pub fn shade(c: Colour) -> Int = match c { Red -> 0, Blue(n) -> n }
  \\
  \\pub fn even(n: Int) -> Bool = if n <= 0 { true } else { odd(n - 1) }
  \\
  \\pub fn odd(n: Int) -> Bool = if n <= 0 { false } else { even(n - 1) }
  \\
  \\pub fn announce(msg: String) -> Unit / {log.write[audit]} = log.emit[audit](msg)
  \\
  \\fn unreached() -> Int = 99
  \\
  \\fn main() -> Int =
  \\  shade(Blue(20)) + shade(Blue(21)) + if even(2) { 1 } else { 0 }
  \\
  \\test "shade reads a payload" { assert_eq(shade(Blue(7)), 7) }
  \\
  \\law "even and odd disagree"
  \\  forall (n: Int) where n >= 0 && n < 4 {
  \\    even(n) != odd(n)
  \\  }
  \\

fn bytes_of(file: String) -> Bytes / {fs.read_file[cwd], abort.raise} =
  match fs.read_file[cwd](file) { Some(b) -> b, None -> panic("`" ++ file ++ "` was not written") }

fn built_to(out: String) -> Bytes / {PlyProcess, abort.raise} = {
  let r = spawned(["build", ".", "-o", out]);
  assert(r.code == 0, Some(all_output(r)));
  bytes_of(out)
}

fn built() -> Bytes / {PlyProcess, abort.raise} = built_to("m.plyx")

fn run_report(file: String) -> Json / {PlyProcess, abort.raise} =
  json_of(spawned(["run", file, "--json"]))

test/nondet "two builds of the same source in two different directories are byte-identical" {
  write_project([{ path: "cold/m.ply", text: source() }, { path: "warm/m.ply", text: source() }]);
  let warmed = spawned(["test", "warm"]);
  assert(warmed.code == 0, Some(all_output(warmed)));
  assert(fs.exists[cwd]("warm/.ply-cache"), Some("the second root's cache should be warm"));
  assert(spawned(["build", "cold", "-o", "cold.plyx"]).code == 0, None);
  assert(spawned(["build", "warm", "-o", "warm.plyx"]).code == 0, None);
  assert(bytes_of("cold.plyx") == bytes_of("warm.plyx"), None);
  let cold = spawned(["build", "cold", "--digest"]).out;
  assert(cold == spawned(["build", "warm", "--digest"]).out, None);
  let digest = String::join(cold, "");
  assert(digest.starts_with("b3:") && digest.len() == 15, Some(digest))
}

test/nondet "an artifact contains no tests, no property laws and no definitions that `main` does not use" {
  write_program(source());
  let b = built();
  let p = parts_of(b);
  let names = names_of(p).map(|n: NameRecord| n.name);
  let listed = String::join(names, ", ");
  assert(
    names.contains("m.main") && names.contains("m.shade") && names.contains("m.Colour"),
    Some(listed),
  );
  assert(names.contains("m.even") && names.contains("m.odd"), Some(listed));
  assert(
    !names.contains("m.unreached"),
    Some("a definition nothing reaches is not in the closure: " ++ listed),
  );
  assert(
    !names.contains("m.announce") && !names.contains("m.log"),
    Some("only what `main` reaches: " ++ listed),
  );
  assert(
    names.filter(|n: String| n.contains("ply_tests")).len() == 0,
    Some("no test key may appear: " ++ listed),
  );
  let shipped = [String::of_bytes_lossy(b), runnable_text(p)];
  ["unreached", "announce", "shade reads a payload", "even and odd disagree"].fold(
    (),
    |u: Unit, w: String|
      shipped.fold(u, |v: Unit, text: String|
        assert(!text.contains(w), Some("`" ++ w ++ "` shipped"))),
  )
}

test/nondet "an artifact omits the bytes of a data file that a standard library module embeds, when the program does not use that file" {
  write_program(
    "import std.brotli\nimport std.oid\n\nfn main() -> Int / {abort.raise} =\n  oid::arcs(oid::common_name()).len() + brotli::compress(b\"some bytes, some bytes\", brotli::Fast).len()\n",
  );
  let b = built();
  let p = parts_of(b);
  let names = names_of(p).map(|n: NameRecord| n.name);
  let listed = String::join(names, ", ");
  assert(names.contains("std.oid.arcs"), Some(listed));
  assert(names.contains("std.brotli.compress"), Some(listed));
  assert(
    !names.contains("std.brotli.words") && !names.contains("std.brotli.decompress")
      && !names.contains("std.brotli.commands"),
    Some("only what `compress` reaches: " ++ listed),
  );
  [String::of_bytes_lossy(b), runnable_text(p)].fold((), |u: Unit, text: String| {
    assert(!text.contains("id-kp-OCSPSigning"), Some("the file's bytes shipped"));
    assert(!text.contains("timedownlifeleftback"), Some("the dictionary's bytes shipped"))
  })
}

test/nondet "a failure in an artifact carries no line number" {
  write_program("fn main() -> Int / {abort.raise} = 1 / 0\n");
  let _ = built();
  let from_source = run_report("m.ply");
  let d = diagnostic(from_source);
  assert(int(path(nth(at(d, "labels"), 0), ["start", "line"])) == 1, Some(json_text(from_source)));
  assert(
    str(at(d, "message")) == "division by zero",
    Some("the program's own failure, not the seam's: " ++ json_text(from_source)),
  );
  let failed = run_report("m.plyx");
  assert(not_ok(failed), Some(json_text(failed)));
  assert(code_of(failed) == code_of(from_source), Some(json_text(failed)));
  assert(path(nth(at(diagnostic(failed), "labels"), 0), ["start"]) == Null, Some(json_text(failed)))
}

fn runs_as_its_source() -> Json / {PlyProcess, abort.raise} = {
  let _ = built_to("app.plyx");
  let from_source = run_report(".");
  let from_artifact = run_report("app.plyx");
  assert(bool(at(from_source, "ok")), Some(json_text(from_source)));
  assert(at(from_artifact, "value") == at(from_source, "value"), Some(json_text(from_artifact)));
  at(from_artifact, "value")
}

test/nondet "an artifact runs to the same value as its source" {
  write_program(source());
  assert_eq(value_of(spawned(["run", "--json", "m.ply"])), "42");
  let _ = built();
  assert_eq(value_of(spawned(["run", "--json", "m.plyx"])), "42")
}

test/nondet "what a closure holds of a program ships and runs as the program does" {
  write_project([
    { path: "left/util.ply", text: "pub fn one() -> Int = 1\n" },
    { path: "right/util.ply", text: "pub fn two() -> Int = 20\n" },
    {
      path: "gz.ply",
      text:
        \\pub effect gz {
        \\  raise refused(at: Int)
        \\}
        \\
        \\fn written(x: Int) -> Int = x * 31 + 7
        \\
        \\pub fn gz(x: Int) -> Int = written(x)
        \\
        \\pub fn read(x: Int) -> Int / {gz.refused} = if x < 0 { gz.refused(x) } else { x + 1 }
        \\
    },
    {
      path: "a.ply",
      text: "pub type Limits = new { output: Int, window: Int }\n\npub fn fa(l: Limits) -> Int = l.output + l.window\n",
    },
    {
      path: "b.ply",
      text: "pub type Limits = new { output: Int, window: Int }\n\npub fn fb(l: Limits) -> Int = l.output * l.window\n",
    },
    {
      path: "m.ply",
      text:
        \\import a
        \\import b
        \\import gz
        \\import gz (gz)
        \\import left.util as l
        \\import right.util as r
        \\import std.gzip
        \\import std.gzip (gzip)
        \\
        \\fn one() -> Int = 1
        \\
        \\fn uno() -> Int = 1
        \\
        \\fn roomy() -> b::Limits = { output: 1, window: 2 }
        \\
        \\fn read_gz() -> Int = {
        \\  let got: Result<Int, Int> = try[gz.refused] { gz::read(1) };
        \\  match got { Ok(n) -> n, Err(_) -> -1 }
        \\}
        \\
        \\fn inflated() -> Int / {abort.raise} = {
        \\  let read: Result<Bytes, gzip::Error> = try[gzip.fail] { gzip::inflate(b"\x03\x00", 10) };
        \\  match read { Ok(all) -> all.len(), Err(_) -> -1 }
        \\}
        \\
        \\fn main() -> Int / {abort.raise} =
        \\  l::one() + r::two() + one() + uno() * 10 + read_gz() * 100 + b::fb(roomy()) * 1000
        \\    + a::fa({ output: 3, window: 4 }) * 1000 + inflated() * 100000
        \\
    },
  ]);
  assert(runs_as_its_source() == Str("9232"), None);
  let p = parts_of(bytes_of("app.plyx"));
  let files = shipped_files(p).map(|f: Source| f.path);
  let names = names_of(p);
  let listed = String::join(names.map(|n: NameRecord| n.name), ", ");
  assert(files.contains("left/util.ply") && files.contains("right/util.ply"), Some(listed));
  let hash = |name: String|
    names.filter(|named: NameRecord| named.name == name).map(|named: NameRecord|
      named.hash.hex_of());
  assert(hash("m.one") != [], Some(listed));
  assert(hash("m.one") == hash("m.uno"), Some("one body, two names"));
  let held = names.map(|n: NameRecord| n.name);
  assert(held.contains("gz.read") && held.contains("gz.gz"), Some(listed));
  assert(!held.contains("gz.written"), Some("the function `gz` calls it: " ++ listed));
  assert_eq(held.filter(|n: String| n == "gz.gz").len(), 1);
  let printed = String::join(shipped_files(p).map(|f: Source| f.text), "\n");
  assert(!printed.contains("31"), Some(printed));
  assert(held.contains("std.gzip.inflate") && !held.contains("std.gzip.deflate"), Some(listed))
}

test/nondet "the build prints the artifact's size beside the binary's" {
  write_program(source());
  let printed = stdout(spawned(["build", ".", "-o", "m.plyx"], []));
  assert(printed.contains("artifact"), Some(printed));
  assert(printed.contains("binary"), Some(printed));
  let report = json_of(spawned(["build", ".", "-o", "m.plyx", "--json"], []));
  assert(int(at(report, "format")) == format_version(), Some(json_text(report)));
  assert(json::get(report, "sources") == None, Some(json_text(report)));
  let artifact_bytes = int(at(report, "artifact_bytes"));
  let binary_bytes = int(at(report, "binary_bytes"));
  assert(artifact_bytes == bytes_of("m.plyx").len(), Some(json_text(report)));
  assert(
    binary_bytes > artifact_bytes,
    Some(
      "the ratio the whole-artifact decision argued from: artifact " ++ artifact_bytes.to_string()
        ++ ", binary "
        ++ binary_bytes.to_string(),
    ),
  )
}

fn service() -> String = String::of_bytes_lossy(embed("../programs/artifact/service.ply"))

test/nondet "an artifact retains the names that host handlers are registered under, so its handlers still run" {
  write_program(service());
  let _ = built_to("svc.plyx");
  let from_source = json_of(spawned(["run", "m.ply", "--json"], []));
  let from_artifact = json_of(spawned(["run", "svc.plyx", "--json"], []));
  assert(bool(at(from_source, "ok")), Some(json_text(from_source)));
  assert(
    bool(at(from_artifact, "ok")),
    Some(
      "the artifact lost the name a handler is registered against: " ++ json_text(from_artifact),
    ),
  );
  assert(at(from_artifact, "value") == at(from_source, "value"), Some(json_text(from_artifact)))
}

fn ready() -> String = String::of_bytes_lossy(embed("../programs/artifact/ready.ply"))

test/nondet "an artifact run binds the signal handler a source run binds" {
  write_program(ready());
  let _ = built();
  let source = json_of(spawned(["run", "m.ply", "--trace", "off", "--json"], []));
  let shipped = json_of(spawned(["run", "m.plyx", "--trace", "off", "--json"], []));
  assert(bool(at(source, "ok")), Some(json_text(source)));
  assert(bool(at(shipped, "ok")), Some(json_text(shipped)));
  assert(at(shipped, "value") == at(source, "value"), None);
  assert(str(at(shipped, "value")) == "200", Some(json_text(shipped)));
  assert(path(shipped, ["shutdown", "requested"]) == json::Bool(false), Some(json_text(shipped)));
  assert(
    path(shipped, ["shutdown", "drain_ms"]) == path(source, ["shutdown", "drain_ms"]),
    Some(json_text(shipped)),
  );
  assert(int(path(shipped, ["shutdown", "spans_left_open"])) == 0, Some(json_text(shipped)))
}

fn with_schema() -> String =
  \\import std.config
  \\
  \\pub fn required_keys() -> List<config::Key> = [
  \\  {name: "API_KEY", shape: config::SSecret, required: true, default: None},
  \\]
  \\
  \\pub fn spec() -> config::ConfigSpec = {keys: required_keys()}
  \\
  \\fn main() -> Int = 1
  \\

test/nondet "`build --config-schema` includes the schema in the artifact, which then fails on a missing config key like the source does" {
  write_program(with_schema());
  assert(spawned(["build", ".", "-o", "bare.plyx"]).code == 0, None);
  let bare_run = json_of(spawned(["run", "bare.plyx", "--config-schema", "m.spec", "--json"], []));
  assert(not_ok(bare_run), Some(json_text(bare_run)));
  assert(code_of(bare_run) == "E0440", Some(json_text(bare_run)));
  assert(
    str(at(diagnostic(bare_run), "message")).contains("names no definition in this program"),
    Some(
      "the schema is absent from the artifact, rather than entered and declined: "
        ++ json_text(bare_run),
    ),
  );
  let build = stdout(spawned(["build", ".", "--config-schema", "m.spec", "-o", "with.plyx"]));
  assert(build.contains("startup m.spec"), Some(build));
  let missing = json_of(spawned(["run", "with.plyx", "--config-schema", "m.spec", "--json"], []));
  assert(not_ok(missing), Some(json_text(missing)));
  assert(code_of(missing) == "E0441", Some(json_text(missing)));
  let served = json_of(
    spawned(
      [
        "run",
        "with.plyx",
        "--config-schema",
        "m.spec",
        "--set",
        "API_KEY=hunter2",
        "--trace",
        "off",
        "--json",
      ],
      [],
    ),
  );
  assert(bool(at(served, "ok")), Some(json_text(served)));
  let bare = json_of(spawned(["build", ".", "--json", "-o", "b2.plyx"]));
  let schemed = json_of(
    spawned(["build", ".", "--json", "--config-schema", "m.spec", "-o", "w2.plyx"]),
  );
  assert(items(at(bare, "startup")) == [], Some(json_text(bare)));
  assert(str(nth(at(schemed, "startup"), 0)) == "m.spec", Some(json_text(schemed)));
  assert(
    int(at(schemed, "definitions")) > int(at(bare, "definitions")),
    Some(
      "the schema's closure is in the artifact: " ++ json_text(bare) ++ " vs "
        ++ json_text(schemed),
    ),
  );
  assert(
    at(bare, "digest") != at(schemed, "digest"),
    Some("an artifact that carries a schema is a different artifact"),
  );
  let names = names_of(parts_of(bytes_of("w2.plyx"))).map(|n: NameRecord| n.name);
  assert(names.filter(|n: String| n.contains("test")).len() == 0, Some(String::join(names, ", ")))
}

fn needs_cc() -> String = String::of_bytes_lossy(embed("../programs/artifact/asks_for_cc.ply"))

fn spawns_cc() -> String =
  \\import std.process (process, exit_code)
  \\
  \\fn main() -> Unit / {process.spawn[cc], process.exit[proc]} = {
  \\  let done = process.spawn[cc](["-c", "exit 7"], "", []);
  \\  match exit_code(done) {
  \\    Some(code) -> process.exit[proc](code),
  \\    None -> process.exit[proc](9),
  \\  }
  \\}
  \\

test/nondet "an artifact asks whether its caller bound a label, starts what is bound, and rejects a label nothing bound" {
  write_program(needs_cc());
  let _ = built();
  [{ exec: ["--exec", "cc=/bin/sh"], code: 7 }, { exec: [], code: 9 }].fold(
    (),
    |u: Unit, c: { exec: List<String>, code: Int }| {
      let out = spawned(["run", "m.plyx"].concat(c.exec), []);
      assert(
        out.code == c.code,
        Some("run with " ++ String::join(c.exec, " ") ++ ":\n" ++ stderr(out)),
      )
    },
  );
  write_program(spawns_cc());
  let _ = built();
  let bound = spawned(["run", "m.plyx", "--exec", "cc=/bin/sh"], []);
  assert(bound.code == 7, Some("the child's own code is what came back:\n" ++ all_output(bound)));
  let unbound = spawned(["run", "m.plyx"], []);
  assert(unbound.code != 0 && stderr(unbound).contains("E0456"), Some(all_output(unbound)))
}

fn leaves_a_span() -> String =
  String::of_bytes_lossy(embed("../programs/artifact/leaves_a_span.ply"))

test/nondet "an artifact reports a warning about a trace span its entry left unfinished, alongside its value" {
  write_program(leaves_a_span());
  let _ = built();
  let out = spawned(["run", "m.plyx", "--trace", "off", "--json"], []);
  assert_eq(value_of(out), "3");
  let warned = json_text(at(json_of(out), "diagnostics"));
  assert(
    warned.contains("span was still open") && warned.contains("`order` on `orders`"),
    Some(all_output(out)),
  )
}

test/nondet "a signed artifact runs under --require-signer, and an unsigned or wrongly signed one is E0460" {
  write_program(source());
  let made = spawned(["keygen", "release.key", "--json"]);
  assert(made.code == 0, Some(all_output(made)));
  assert(spawned(["keygen", "other.key"]).code == 0, None);
  assert(spawned(["keygen", "release.key"]).code != 0, Some("a key was written over"));
  let _ = built();
  let trusting = |keys: List<String>|
    json_of(
      spawned(
        ["run", "m.plyx", "--json"].concat(
          keys.fold([], |accumulator: List<String>, k: String|
            accumulator.concat(["--require-signer", k])),
        ),
      ),
    );
  let unsigned = trusting(["release.key.pub"]);
  assert(code_of(unsigned) == "E0460", Some(json_text(unsigned)));

  let signed = spawned(["build", ".", "-o", "m.plyx", "--sign", "release.key", "--json"]);
  assert(signed.code == 0, Some(all_output(signed)));
  assert_eq(str(at(json_of(signed), "signed_by")), str(at(json_of(made), "key")));
  let ok = trusting(["release.key.pub"]);
  assert(!not_ok(ok), Some(json_text(ok)));
  let elsewhere = trusting(["other.key.pub"]);
  assert(code_of(elsewhere) == "E0460", Some(json_text(elsewhere)));
  assert(!not_ok(trusting(["other.key.pub", "release.key.pub"])), None);
  assert_eq(code_of(trusting(["release.key"])), "E0462");

  let verified = spawned(["build", ".", "-o", "m.plyx", "--verify", "--json"]);
  assert(verified.code == 0, Some(all_output(verified)));
  assert_eq(items(at(json_of(verified), "signers")).map(str), [str(at(json_of(made), "key"))]);
  write("m.ply", source().replace("Blue(21)", "Blue(22)"));
  let moved = json_of(spawned(["build", ".", "-o", "m.plyx", "--verify", "--json"]));
  assert(
    code_of(moved) == "E0461" && json_text(moved).contains("these sources build"),
    Some(json_text(moved)),
  );
  let _ = built();
  let stale = trusting(["release.key.pub"]);
  assert(code_of(stale) == "E0460", Some(json_text(stale)));
  assert(json_text(stale).contains("vouch for"), Some(json_text(stale)))
}
