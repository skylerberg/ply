//! `ply build` and the `.plyx` it writes: the closure of one entry point and nothing else, the same
//! bytes wherever it was built, rejected when any part of it is not what was built, and run as its
//! source runs. A tampered artifact is resealed, so what rejects it is the check under test and not
//! the digest.

import spawning.harness (PlyProcess, Source, write_program, write_project, write, spawned,
                         all_output, stdout, stderr, json_of, at, path, nth, items, str, int, bool,
                         json_text, code_of, diagnostic, not_ok, value_of)
import compiler.store.plyx (Header, Section, SectionLocation, decode, encode, digest_of, domain,
                            offset_digest, format_version)
import std.bytes (u32_le)
import std.fs (fs)
import std.gzip (try_gunzip)
import std.json
import std.json (Json, Null, Array, Str)
import std.string
import std.list

fn source() -> String =
  \\effect log { write emit[c](msg: String) -> Unit }
  \\
  \\type Colour = | Red | Blue(Int)
  \\
  \\pub fn shade(c: Colour) -> Int = match c { Red -> 0, Blue(n) -> n }
  \\
  \\pub fn even(n: Int) -> Bool = if n <= 0 { true } else { odd(n - 1) }
  \\
  \\pub fn odd(n: Int) -> Bool = if n <= 0 { false } else { even(n - 1) }
  \\
  \\pub fn announce(msg: String) -> Unit / {log.write[audit]} = log.emit[audit](msg)
  \\
  \\fn unreached() -> Int = 99
  \\
  \\fn main() -> Int =
  \\  shade(Blue(20)) + shade(Blue(21)) + if even(2) { 1 } else { 0 }
  \\
  \\test "shade reads a payload" { assert_eq(shade(Blue(7)), 7) }
  \\
  \\law "even and odd disagree"
  \\  forall (n: Int) where n >= 0 && n < 4 {
  \\    even(n) != odd(n)
  \\  }
  \\

fn bytes_of(file: String) -> Bytes / {fs.read_file[cwd], abort.raise} =
  match fs.read_file[cwd](file) { Some(b) -> b, None -> panic("`" ++ file ++ "` was not written") }

fn put(file: String, b: Bytes) -> Unit / {fs.write_file[cwd], abort.raise} =
  if !fs.write_file[cwd](file, b) { panic("could not write `" ++ file ++ "`") }

/// What `ply build` wrote to `out` for the program in the working directory.
fn built_to(out: String) -> Bytes / {PlyProcess, abort.raise} = {
  let r = spawned(["build", ".", "-o", out]);
  assert(r.code == 0, Some(all_output(r)));
  bytes_of(out)
}

fn built() -> Bytes / {PlyProcess, abort.raise} = built_to("m.plyx")

fn run_report(file: String) -> Json / {PlyProcess, abort.raise} =
  json_of(spawned(["run", file, "--json"]))

/// `b` written to `file` and run.
fn write_and_run(file: String, b: Bytes) -> Json / {PlyProcess, fs.write_file[cwd], abort.raise} = {
  put(file, b);
  run_report(file)
}

// --- The artifact as the container lays it out --------------------------------

/// The header a writer supplies and each section's payload, in the order the file holds them.
type Parts = { head: Header, sections: List<Section> }

fn parts_of(b: Bytes) -> Parts / {abort.raise} =
  match decode(b) {
    Err(e) -> panic("the artifact does not open: " ++ String::of_bytes_lossy(e.message)),
    Ok(o) ->
      {
        head: { frontend: o.frontend, runtime: o.runtime, entry: o.entry },
        sections: o.sections.map(|p: SectionLocation|
          { name: p.name, count: p.count, payload: b.slice(p.at, p.at + p.len) }),
      },
  }

/// Where the container placed each section of `b`.
fn section_locations(b: Bytes) -> List<SectionLocation> / {abort.raise} =
  match decode(b) {
    Err(e) -> panic("the artifact does not open: " ++ String::of_bytes_lossy(e.message)),
    Ok(o) -> o.sections,
  }

/// Laid out and sealed as `ply build` writes one, so a reader checks it as it would a build.
fn sealed(parts: Parts) -> Bytes / {abort.raise} = {
  let encoded = encode(parts.head, parts.sections);
  match digest_of(domain(), encoded) {
    None -> panic("a container this short carries no digest"),
    Some(d) ->
      Bytes::concat_all([
        encoded.slice(0, offset_digest()),
        d,
        encoded.slice(offset_digest() + 32, encoded.len()),
      ]),
  }
}

fn section(parts: Parts, name: Bytes) -> Section / {abort.raise} =
  match parts.sections.filter(|s: Section| s.name == name) {
    [s, ..] -> s,
    [] -> panic("the artifact carries no `" ++ String::of_bytes(name) ++ "` section"),
  }

fn with_section(parts: Parts, s: Section) -> Parts =
  { ..parts, sections: parts.sections.map(|x: Section| if x.name == s.name { s } else { x }) }

fn word(b: Bytes, i: Int) -> Int / {abort.raise} =
  match b.u32_at(i) { Some(w) -> w, None -> panic("a record runs past its section") }

type Body = { hash: Bytes, body: Bytes }

/// Each record is the hash, the body's length, and the body.
fn bodies_of(parts: Parts) -> List<Body> / {abort.raise} = {
  let s = section(parts, b"bodies");
  let decoded = range(0, s.count).fold(
    { at: 0, out: [] },
    |acc: { at: Int, out: List<Body> }, _i: Int| {
      let n = word(s.payload, acc.at + 32);
      {
        at: acc.at + 36 + n,
        out: acc.out.push({
          hash: s.payload.slice(acc.at, acc.at + 32),
          body: s.payload.slice(acc.at + 36, acc.at + 36 + n),
        }),
      }
    },
  );
  decoded.out
}

fn with_bodies(parts: Parts, bodies: List<Body>) -> Parts =
  with_section(parts, {
    name: b"bodies",
    count: bodies.len(),
    payload: Bytes::concat_all(
      bodies.map(|b: Body| Bytes::concat_all([b.hash, u32_le(b.body.len()), b.body])),
    ),
  })

type NameRecord = { name: String, hash: Bytes }

/// Each record is where its name lies in the string section, the name's length, and the hash.
fn names_of(parts: Parts) -> List<NameRecord> / {abort.raise} = {
  let s = section(parts, b"names");
  let strings = section(parts, b"strings").payload;
  range(0, s.count).map(|i: Int| {
    let off = word(s.payload, i * 40);
    {
      name: String::of_bytes(strings.slice(off, off + word(s.payload, i * 40 + 4))),
      hash: s.payload.slice(i * 40 + 8, i * 40 + 40),
    }
  })
}

/// Each name's text is written once, in record order, as the writer lays the string section out.
fn with_names(parts: Parts, names: List<NameRecord>) -> Parts = {
  let encoded = names.fold(
    { strings: b"", placed: Map::new(), records: [] },
    |acc: { strings: Bytes, placed: Map<String, Int>, records: List<Bytes> }, named: NameRecord| {
      let known = acc.placed.get(named.name);
      let offset = match known { Some(o) -> o, None -> acc.strings.len() };
      let text = Bytes::of_string(named.name);
      {
        strings: match known { Some(_) -> acc.strings, None -> acc.strings.concat(text) },
        placed: acc.placed.insert(named.name, offset),
        records: acc.records.push(
          Bytes::concat_all([u32_le(offset), u32_le(text.len()), named.hash]),
        ),
      }
    },
  );
  with_section(
    with_section(parts, {
      name: b"names",
      count: names.len(),
      payload: Bytes::concat_all(encoded.records),
    }),
    { name: b"strings", count: encoded.strings.len(), payload: encoded.strings },
  )
}

/// Each record is a module's path and its text, each after its length.
fn shipped_files(parts: Parts) -> List<Source> / {abort.raise} = {
  let s = section(parts, b"closure");
  let decoded = range(0, s.count).fold(
    { at: 0, out: [] },
    |acc: { at: Int, out: List<Source> }, _i: Int| {
      let path_len = word(s.payload, acc.at);
      let text_at = acc.at + 8 + path_len;
      let text_len = word(s.payload, acc.at + 4 + path_len);
      {
        at: text_at + text_len,
        out: acc.out.push({
          path: String::of_bytes(s.payload.slice(acc.at + 4, acc.at + 4 + path_len)),
          text: String::of_bytes(s.payload.slice(text_at, text_at + text_len)),
        }),
      }
    },
  );
  decoded.out
}

fn with_files(parts: Parts, files: List<Source>) -> Parts =
  with_section(parts, {
    name: b"closure",
    count: files.len(),
    payload: Bytes::concat_all(
      files.map(|f: Source| {
        let file = Bytes::of_string(f.path);
        let text = Bytes::of_string(f.text);
        Bytes::concat_all([u32_le(file.len()), file, u32_le(text.len()), text])
      }),
    ),
  })

/// What the runnable and the unit hold: the runnable's roots and effects as its encoding spells
/// their names, and the unit's C, unpacked.
fn runnable_text(parts: Parts) -> String / {abort.raise} =
  String::of_bytes_lossy(section(parts, b"runnable").payload)
    ++ (match try_gunzip(section(parts, b"unit").payload, 67108864) {
      Ok(b) -> String::of_bytes_lossy(b),
      Err(rejection) -> panic(f"the unit section does not unpack: {rejection}"),
    })

// --- Tests --------------------------------------------------------------------

// What the tamper tests below rest on: an artifact read back and written again is the artifact.
test/nondet "an artifact read back section by section and written again is the same bytes" {
  write_program(source());
  let b = built();
  let p = parts_of(b);
  assert(sealed(p) == b, Some("resealing moved the bytes"));
  let rewritten = with_files(
    with_names(with_bodies(p, bodies_of(p)), names_of(p)),
    shipped_files(p),
  );
  assert(sealed(rewritten) == b, Some("a section read and written back moved the bytes"));
  assert(bool(at(write_and_run("again.plyx", sealed(rewritten)), "ok")), None)
}

// Where a program was built and what its cache stored are not in what was built.
test/nondet "two builds from two roots are byte-identical" {
  write_project([{ path: "cold/m.ply", text: source() }, { path: "warm/m.ply", text: source() }]);
  let warmed = spawned(["test", "warm"]);
  assert(warmed.code == 0, Some(all_output(warmed)));
  assert(fs.exists[cwd]("warm/.ply-cache"), Some("the second root's cache should be warm"));
  assert(spawned(["build", "cold", "-o", "cold.plyx"]).code == 0, None);
  assert(spawned(["build", "warm", "-o", "warm.plyx"]).code == 0, None);
  assert(bytes_of("cold.plyx") == bytes_of("warm.plyx"), None);
  let cold = spawned(["build", "cold", "--digest"]).out;
  assert(cold == spawned(["build", "warm", "--digest"]).out, None);
  let digest = String::join(cold, "");
  assert(digest.starts_with("b3:") && digest.len() == 15, Some(digest))
}

// Once in this process and once in a `ply` of its own, so neither decides the bytes.
test/nondet "ply build twice writes the same bytes" {
  write_program(source());
  let one = built_to("one.plyx");
  let two = spawned(["build", ".", "-o", "two.plyx"], []);
  assert(two.code == 0, Some(all_output(two)));
  assert(one == bytes_of("two.plyx"), None)
}

test/nondet "an artifact carries no test, no law and nothing unreached" {
  write_program(source());
  let b = built();
  let p = parts_of(b);
  let names = names_of(p).map(|n: NameRecord| n.name);
  let listed = String::join(names, ", ");
  assert(
    names.contains("m.main") && names.contains("m.shade") && names.contains("m.Colour"),
    Some(listed),
  );
  assert(names.contains("m.even") && names.contains("m.odd"), Some(listed));
  assert(
    !names.contains("m.unreached"),
    Some("a definition nothing reaches is not in the closure: " ++ listed),
  );
  assert(
    !names.contains("m.announce") && !names.contains("m.log"),
    Some("only what `main` reaches: " ++ listed),
  );
  assert(
    names.filter(|n: String| n.contains("ply_tests")).len() == 0,
    Some("no test key may appear: " ++ listed),
  );
  // A test or a law is declared by its name, so a closure that spells neither declares neither.
  let shipped = [String::of_bytes_lossy(b), runnable_text(p)];
  ["unreached", "announce", "shade reads a payload", "even and odd disagree"].fold(
    (),
    |u: Unit, w: String|
      shipped.fold(u, |v: Unit, text: String|
        assert(!text.contains(w), Some("`" ++ w ++ "` shipped"))),
  )
}

// `std.oid` embeds a table of names beside it, of which only that file spells this one.
test/nondet "an artifact carries nothing of a data file a shipped module embeds and its program does not reach" {
  write_program("import std.oid\n\nfn main() -> Int = oid::arcs(oid::common_name()).len()\n");
  let b = built();
  let p = parts_of(b);
  let names = names_of(p).map(|n: NameRecord| n.name);
  assert(names.contains("std.oid.arcs"), Some(String::join(names, ", ")));
  let shipped = [String::of_bytes_lossy(b), runnable_text(p)];
  shipped.fold((), |u: Unit, text: String|
    assert(!text.contains("id-kp-OCSPSigning"), Some("the file's bytes shipped")))
}

// `std.brotli` embeds its dictionary beside it, which its readers reach and its writers do not.
test/nondet "an artifact of a program that only writes brotli carries no reader and none of the dictionary" {
  write_program(
    "import std.brotli\n\nfn main() -> Int / {abort.raise} =\n  brotli::compress(b\"some bytes, some bytes\", brotli::Fast).len()\n",
  );
  let b = built();
  let p = parts_of(b);
  let names = names_of(p).map(|n: NameRecord| n.name);
  let listed = String::join(names, ", ");
  assert(names.contains("std.brotli.compress"), Some(listed));
  assert(
    !names.contains("std.brotli.words") && !names.contains("std.brotli.decompress")
      && !names.contains("std.brotli.commands"),
    Some("only what `compress` reaches: " ++ listed),
  );
  [String::of_bytes_lossy(b), runnable_text(p)].fold((), |u: Unit, text: String|
    assert(!text.contains("timedownlifeleftback"), Some("the dictionary's bytes shipped")))
}

test/nondet "every body is recorded under the hash the hash command prints" {
  write_program(source());
  let report = json_of(spawned(["hash", ".", "--json"]));
  let p = parts_of(built());
  let names = names_of(p);
  let bodies = bodies_of(p).map(|b: Body| b.hash.hex_of());
  let checked = items(at(report, "definitions")).fold(0, |n: Int, e: Json|
    match names.filter(|x: NameRecord| x.name == str(at(e, "name"))) {
      [recorded, ..] -> {
        assert(
          recorded.hash.hex_of() == str(at(e, "hash")),
          Some("`" ++ recorded.name ++ "` is recorded under a different hash"),
        );
        assert(
          bodies.contains(recorded.hash.hex_of()),
          Some("`" ++ recorded.name ++ "` has no body"),
        );
        n + 1
      },
      [] -> n,
    });
  assert(checked >= 4, Some("only " ++ checked.to_string() ++ " definitions were compared"))
}

test/nondet "an artifact runs to the same value as its source" {
  write_program(source());
  assert_eq(value_of(spawned(["run", "--json", "m.ply"])), "42");
  let _ = built();
  assert_eq(value_of(spawned(["run", "--json", "m.plyx"])), "42")
}

test/nondet "a failure in an artifact carries no line number" {
  write_program("fn main() -> Int / {abort.raise} = 1 / 0\n");
  let _ = built();
  let from_source = run_report("m.ply");
  let d = diagnostic(from_source);
  assert(int(path(nth(at(d, "labels"), 0), ["start", "line"])) == 1, Some(json_text(from_source)));
  assert(
    str(at(d, "message")) == "division by zero",
    Some("the program's own failure, not the seam's: " ++ json_text(from_source)),
  );
  let failed = run_report("m.plyx");
  assert(not_ok(failed), Some(json_text(failed)));
  assert(code_of(failed) == code_of(from_source), Some(json_text(failed)));
  assert(path(nth(at(diagnostic(failed), "labels"), 0), ["start"]) == Null, Some(json_text(failed)))
}

test/nondet "a closure that is not the closure is rejected" {
  write_program(source());
  let p = parts_of(built());
  let files = shipped_files(p);
  let altered = files.map(|f: Source| { ..f, text: f.text.replace("Blue(20)", "Blue(19)") });
  assert(altered != files, Some("the closure spells the literal"));
  let garbled = match files {
    [f, ..rest] -> [{ ..f, text: "fn (" }].concat(rest),
    [] -> panic("the closure is empty"),
  };
  [{ what: "altered", files: altered }, { what: "garbled", files: garbled }].fold(
    (),
    |u: Unit, c: { what: String, files: List<Source> }| {
      let report = write_and_run("t.plyx", sealed(with_files(p, c.files)));
      assert(
        code_of(report) == "E0443",
        Some(
          "a closure that is not the program must not be believed (" ++ c.what ++ "): "
            ++ json_text(report),
        ),
      )
    },
  )
}

// A runnable is held to the artifact around it: one another build wrote is not this program.
test/nondet "a runnable that is not the artifact's is rejected" {
  write_program(source());
  let p = parts_of(built());
  write_program("fn main() -> Int = 7\n");
  let other = parts_of(built_to("other.plyx"));
  let report = write_and_run("t.plyx", sealed(with_section(p, section(other, b"runnable"))));
  assert(code_of(report) == "E0443", Some(json_text(report)))
}

test/nondet "a flipped bit in a body is E0443 naming the definition" {
  write_program(source());
  let b = built();
  // The first record is where the container placed the bodies; its payload, past the 32-byte key and
  // length prefix.
  let record = match section_locations(b).filter(|s: SectionLocation| s.name == b"bodies") {
    [s, ..] -> s.at,
    [] -> panic("the artifact carries no bodies"),
  };
  let flipped = Bytes::concat_all([
    b.slice(0, record + 36),
    byte_of_int(b.at(record + 36) ^ 0x40),
    b.slice(record + 37, b.len()),
  ]);
  let report = write_and_run("bad.plyx", flipped);
  assert(not_ok(report), Some(json_text(report)));
  assert(code_of(report) == "E0443", Some(json_text(report)));
  let message = str(at(diagnostic(report), "message"));
  assert(message.contains("offset " ++ record.to_string()), Some(message));
  let first = match bodies_of(parts_of(b)) {
    [x, ..] -> x,
    [] -> panic("the artifact carries no body"),
  };
  assert(message.contains(first.hash.hex_of().slice(0, 12)), Some(message))
}

test/nondet "no prefix of an artifact is believed" {
  write_program(source());
  let b = built();
  let n = b.len();
  [0, 1, 100, 187, 188, 200, n / 2, n - 1].fold((), |u: Unit, cut: Int| {
    let report = write_and_run("t.plyx", b.slice(0, cut));
    assert(code_of(report) == "E0443", Some("at " ++ cut.to_string() ++ ": " ++ json_text(report)))
  });
  assert(bool(at(write_and_run("t.plyx", b), "ok")), None)
}

test/nondet "removing a body is E0443" {
  write_program(source());
  let p = parts_of(built());
  let victim = match names_of(p).filter(|named: NameRecord| named.name == "m.shade") {
    [named, ..] -> named.hash,
    [] -> panic("`shade` is in the closure"),
  };
  let without = sealed(
    with_names(
      with_bodies(p, bodies_of(p).filter(|b: Body| b.hash != victim)),
      names_of(p).filter(|named: NameRecord| named.hash != victim),
    ),
  );
  assert(
    match decode(without) { Ok(_) -> true, Err(_) -> false },
    Some("the container still verifies"),
  );
  let report = write_and_run("open.plyx", without);
  assert(code_of(report) == "E0443", Some(json_text(report)))
}

// Rebuild the artifact versus transfer it again: opposite responses, so two codes.
test/nondet "another compiler or runtime is E0444 and not E0443" {
  write_program(source());
  let p = parts_of(built());
  [
    { what: "compiler", head: { ..p.head, frontend: byte_of_int(7).repeat(32) } },
    { what: "runtime", head: { ..p.head, runtime: byte_of_int(7).repeat(32) } },
  ].fold((), |u: Unit, c: { what: String, head: Header }| {
    let report = write_and_run("old.plyx", sealed({ ..p, head: c.head }));
    assert(code_of(report) == "E0444", Some("another " ++ c.what ++ ": " ++ json_text(report)))
  })
}

test/nondet "a file that is not an artifact says so" {
  write_program(source());
  assert(code_of(write_and_run("junk.plyx", b"not a program at all")) == "E0443", None)
}

test/nondet "the digest is one line and agrees with the build" {
  write_program(source());
  let printed = spawned(["build", ".", "--digest"]).out;
  assert(printed.len() == 1, Some(String::join(printed, "\n")));
  let digest = String::join(printed, "").ascii_trim();
  assert(digest.starts_with("b3:") && digest.len() == 15, Some(digest));
  assert(!fs.exists[cwd]("m.plyx"), Some("`--digest` writes no file"));
  let report = json_of(spawned(["build", ".", "-o", "m.plyx", "--json"]));
  assert(str(at(report, "digest")) == digest, Some(json_text(report)))
}

test/nondet "the digest moves with the closure and with nothing else" {
  write_program(source());
  let before = built();
  [
    {
      what: "an unreached definition",
      edited: source().replace("fn unreached() -> Int = 99", "fn unreached() -> Int = 98"),
    },
    { what: "a new unreached type", edited: source() ++ "\ntype Spare = | Unused | Kept(Int)\n" },
    {
      what: "a test",
      edited: source().replace("assert_eq(shade(Blue(7)), 7)", "assert_eq(shade(Blue(8)), 8)"),
    },
    { what: "a law", edited: source().replace("n >= 0 && n < 4", "n >= 0 && n < 5") },
    { what: "a local's name", edited: source().replace("Blue(n) -> n", "Blue(k) -> k") },
  ].fold((), |u: Unit, e: { what: String, edited: String }| {
    assert(e.edited != source(), Some(e.what ++ ": the edit did not apply"));
    write("m.ply", e.edited);
    assert(built() == before, Some(e.what ++ " moved the artifact"))
  });
  write("m.ply", source().replace("Blue(21)", "Blue(22)"));
  assert(digest_of(domain(), built()) != digest_of(domain(), before), None)
}

test/nondet "diff reports added, changed, dropped and what a change is reached by" {
  write_program(source());
  let _ = built_to("old.plyx");
  write(
    "m.ply",
    source().replace("Red -> 0", "Red -> 1").replace(
      "fn unreached() -> Int = 99",
      "fn restock() -> Int = 1\nfn unreached() -> Int = 99",
    ),
  );
  let report = json_of(spawned(["build", ".", "--diff", "old.plyx", "--json"]));
  let changed = items(at(report, "changed")).map(str);
  assert(changed.contains("m.shade"), Some(json_text(report)));
  assert(
    changed.contains("m.main"),
    Some("changing a callee changes its caller: " ++ json_text(report)),
  );
  assert(items(at(report, "added")) == [], Some(json_text(report)));
  assert(items(at(report, "dropped")) == [], Some(json_text(report)));
  // The reverse closure: every definition that reaches a changed one, and a definition reaches itself.
  let reached = items(at(report, "reached")).map(str);
  changed.fold((), |u: Unit, name: String|
    assert(reached.contains(name), Some(name ++ " does not reach itself")));
  assert(reached.contains("m.main"), Some(json_text(report)));
  assert(!reached.contains("m.Colour"), Some("a type reaches no function"));
  assert(int(at(report, "artifact_bytes")) > 0, Some(json_text(report)))
}

test/nondet "diff counts an addition and a removal" {
  write_program("fn helper() -> Int = 1\nfn main() -> Int = helper()\n");
  let _ = built_to("old.plyx");
  write("m.ply", "fn other() -> Int = 2\nfn main() -> Int = other()\n");
  let report = json_of(spawned(["build", ".", "--diff", "old.plyx", "--json"]));
  assert(at(report, "added") == Array([Str("m.other")]), Some(json_text(report)));
  assert(at(report, "dropped") == Array([Str("m.helper")]), Some(json_text(report)));
  assert(at(report, "changed") == Array([Str("m.main")]), Some(json_text(report)))
}

test/nondet "a rename moves a name and no hash" {
  write_program("fn helper() -> Int = 1\nfn main() -> Int = helper()\n");
  let before = parts_of(built_to("old.plyx"));
  write("m.ply", "fn assistant() -> Int = 1\nfn main() -> Int = assistant()\n");
  let report = json_of(spawned(["build", ".", "--diff", "old.plyx", "--json"]));
  assert(at(report, "added") == Array([Str("m.assistant")]), Some(json_text(report)));
  assert(at(report, "dropped") == Array([Str("m.helper")]), Some(json_text(report)));
  assert(at(report, "changed") == Array([]), Some(json_text(report)));
  assert(
    bodies_of(before) == bodies_of(parts_of(built_to("new.plyx"))),
    Some("a rename may not move a body"),
  )
}

/// The directory built and run, and the value its artifact ran to, which its source runs to too.
fn runs_as_its_source() -> Json / {PlyProcess, abort.raise} = {
  let _ = built_to("app.plyx");
  let from_source = run_report(".");
  let from_artifact = run_report("app.plyx");
  assert(bool(at(from_source, "ok")), Some(json_text(from_source)));
  assert(at(from_artifact, "value") == at(from_source, "value"), Some(json_text(from_artifact)));
  at(from_artifact, "value")
}

test/nondet "modules sharing a last segment ship and run" {
  write_project([
    { path: "left/util.ply", text: "pub fn one() -> Int = 1\n" },
    { path: "right/util.ply", text: "pub fn two() -> Int = 20\n" },
    {
      path: "m.ply",
      text: "import left.util as l\nimport right.util as r\n\nfn main() -> Int = l::one() + r::two()\n",
    },
  ]);
  assert(runs_as_its_source() == Str("21"), None);
  let files = shipped_files(parts_of(bytes_of("app.plyx"))).map(|f: Source| f.path);
  assert(files == ["left/util.ply", "m.ply", "right/util.ply"], Some(String::join(files, ", ")))
}

test/nondet "two names for one body ship and run" {
  write_program(
    "fn one() -> Int = 1\nfn uno() -> Int = 1\nfn main() -> Int = one() + uno() * 10\n",
  );
  assert(runs_as_its_source() == Str("11"), None);
  let names = names_of(parts_of(bytes_of("app.plyx")));
  let hash = |name: String|
    names.filter(|named: NameRecord| named.name == name).map(|named: NameRecord|
      named.hash.hex_of());
  assert(hash("m.one") != [], Some(String::join(names.map(|named: NameRecord| named.name), ", ")));
  assert(hash("m.one") == hash("m.uno"), Some("one body, two names"))
}

// An effect and a function of one name are two definitions: holding the effect holds nothing the
// function calls, and the program holds no function of that name.
test/nondet "an artifact of a program that raises through an effect holds nothing the function of its name calls" {
  write_project([
    {
      path: "gz.ply",
      text:
        \\pub effect gz {
        \\  raise refused(at: Int)
        \\}
        \\
        \\fn written(x: Int) -> Int = x * 31 + 7
        \\
        \\pub fn gz(x: Int) -> Int = written(x)
        \\
        \\pub fn read(x: Int) -> Int / {gz.refused} = if x < 0 { gz.refused(x) } else { x + 1 }
        \\
    },
    {
      path: "m.ply",
      text:
        \\import gz
        \\import gz (gz)
        \\
        \\fn main() -> Int = {
        \\  let got: Result<Int, Int> = try[gz.refused] { gz::read(1) };
        \\  match got { Ok(n) -> n, Err(_) -> -1 }
        \\}
        \\
    },
  ]);
  assert(runs_as_its_source() == Str("2"), None);
  let p = parts_of(bytes_of("app.plyx"));
  let names = names_of(p).map(|n: NameRecord| n.name);
  let listed = String::join(names, ", ");
  assert(names.contains("gz.read") && names.contains("gz.gz"), Some(listed));
  assert(!names.contains("gz.written"), Some("the function `gz` calls it: " ++ listed));
  assert_eq(names.filter(|n: String| n == "gz.gz").len(), 1);
  let printed = String::join(shipped_files(p).map(|f: Source| f.text), "\n");
  assert(!printed.contains("31"), Some(printed))
}

// `std.gzip` declares `effect gzip` beside `fn gzip`, and its readers raise through the effect.
test/nondet "an artifact of a program that reads with std.gzip and handles its rejection builds and runs" {
  write_program(String::of_bytes_lossy(embed("../programs/artifact/gzip_error.ply")));
  assert(runs_as_its_source() == Str("0"), None);
  let names = names_of(parts_of(bytes_of("app.plyx"))).map(|n: NameRecord| n.name);
  assert(
    names.contains("std.gzip.inflate") && !names.contains("std.gzip.deflate"),
    Some(String::join(names, ", ")),
  )
}

// Two modules that declare a type alike file one body under two names; which one a definition
// means is what it references, and a print that did not ask named the other.
test/nondet "an artifact of a program that names one module's type and passes a literal as another's of the same shape builds and runs" {
  write_project([
    {
      path: "a.ply",
      text: "pub type Limits = new { output: Int, window: Int }\n\npub fn fa(l: Limits) -> Int = l.output + l.window\n",
    },
    {
      path: "b.ply",
      text: "pub type Limits = new { output: Int, window: Int }\n\npub fn fb(l: Limits) -> Int = l.output * l.window\n",
    },
    {
      path: "m.ply",
      text:
        \\import a
        \\import b
        \\
        \\fn roomy() -> b::Limits = { output: 1, window: 2 }
        \\
        \\fn main() -> Int = b::fb(roomy()) + a::fa({ output: 3, window: 4 })
        \\
    },
  ]);
  assert(runs_as_its_source() == Str("9"), None)
}

// Run as a process: the binary a build measures is the one that runs it.
test/nondet "the build prints the artifact's size beside the binary's" {
  write_program(source());
  let printed = stdout(spawned(["build", ".", "-o", "m.plyx"], []));
  assert(printed.contains("artifact"), Some(printed));
  assert(printed.contains("binary"), Some(printed));
  let report = json_of(spawned(["build", ".", "-o", "m.plyx", "--json"], []));
  assert(int(at(report, "format")) == format_version(), Some(json_text(report)));
  assert(json::get(report, "sources") == None, Some(json_text(report)));
  let artifact_bytes = int(at(report, "artifact_bytes"));
  let binary_bytes = int(at(report, "binary_bytes"));
  assert(artifact_bytes == bytes_of("m.plyx").len(), Some(json_text(report)));
  assert(
    binary_bytes > artifact_bytes,
    Some(
      "the ratio the whole-artifact decision argued from: artifact " ++ artifact_bytes.to_string()
        ++ ", binary "
        ++ binary_bytes.to_string(),
    ),
  )
}

test/nondet "entry names the closure and ambiguity is rejected" {
  write_project([
    { path: "a.ply", text: "fn main() -> Int = 1\n" },
    { path: "b.ply", text: "fn main() -> Int = 2\n" },
  ]);
  assert(spawned(["build", "."]).code != 0, None);
  let r = spawned(["build", ".", "--entry", "a.main", "-o", "a.plyx"]);
  assert(r.code == 0, Some(all_output(r)));
  assert(str(at(run_report("a.plyx"), "value")) == "1", None)
}

