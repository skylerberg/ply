/// A program that asks its run for its command line, which a host's handler of `std.process`
/// serves.
fn service() -> String = String::of_bytes_lossy(embed("../programs/artifact/service.ply"))

// Each run a `ply` of its own: a run inside a test is bound to no host.
test/nondet "an artifact keeps the names a host handler is registered against" {
  write_program(service());
  let _ = built_to("svc.plyx");
  let from_source = json_of(spawned(["run", "m.ply", "--json"], []));
  let from_artifact = json_of(spawned(["run", "svc.plyx", "--json"], []));
  assert(bool(at(from_source, "ok")), Some(json_text(from_source)));
  assert(
    bool(at(from_artifact, "ok")),
    Some(
      "the artifact lost the name a handler is registered against: " ++ json_text(from_artifact),
    ),
  );
  assert(at(from_artifact, "value") == at(from_source, "value"), Some(json_text(from_artifact)))
}

test/nondet "the entry point keeps its program-wide name" {
  write_program(source());
  let report = json_of(spawned(["build", ".", "-o", "m.plyx", "--json"]));
  assert(str(at(report, "entry")) == "m.main", Some(json_text(report)));
  let p = parts_of(bytes_of("m.plyx"));
  assert(
    names_of(p).filter(|named: NameRecord| named.hash == p.head.entry).map(|named: NameRecord|
        named.name)
      == ["m.main"],
    None,
  );
  assert(str(at(run_report("m.plyx"), "value")) == "42", None)
}

test/nondet "an entry point that takes an argument is rejected" {
  write_program("fn serve(port: Int) -> Int = port\nfn main() -> Int = serve(1)\n");
  let report = json_of(spawned(["build", ".", "--entry", "serve", "--json"]));
  assert(not_ok(report), Some(json_text(report)));
  assert(code_of(report) == "E0201", Some(json_text(report)));
  assert(!fs.exists[cwd]("m.plyx"), None)
}

fn ready() -> String = String::of_bytes_lossy(embed("../programs/artifact/ready.ply"))

// Spawned: a run whose root performs `signal` listens on the process it is in.
test/nondet "an artifact run binds the signal handler a source run binds" {
  write_program(ready());
  let _ = built();
  let source = json_of(spawned(["run", "m.ply", "--trace", "off", "--json"], []));
  let shipped = json_of(spawned(["run", "m.plyx", "--trace", "off", "--json"], []));
  assert(bool(at(source, "ok")), Some(json_text(source)));
  assert(bool(at(shipped, "ok")), Some(json_text(shipped)));
  assert(at(shipped, "value") == at(source, "value"), None);
  assert(str(at(shipped, "value")) == "200", Some(json_text(shipped)));
  // Reported the same way, so a deployment reads one `shutdown` shape whichever form it shipped.
  assert(path(shipped, ["shutdown", "requested"]) == json::Bool(false), Some(json_text(shipped)));
  assert(
    path(shipped, ["shutdown", "drain_ms"]) == path(source, ["shutdown", "drain_ms"]),
    Some(json_text(shipped)),
  );
  assert(int(path(shipped, ["shutdown", "spans_left_open"])) == 0, Some(json_text(shipped)))
}

/// A configuration schema, the entry point, and a definition only the schema reaches.
fn with_schema() -> String =
  \\import std.config
  \\
  \\pub fn required_keys() -> List<config::Key> = [
  \\  {name: "API_KEY", shape: config::SSecret, required: true, default: None},
  \\]
  \\
  \\pub fn spec() -> config::ConfigSpec = {keys: required_keys()}
  \\
  \\fn main() -> Int = 1
  \\

// The runs are spawned: a configuration is read from the environment of the process it starts in.
test/nondet "a config schema named at build time is in the artifact and still rejects" {
  write_program(with_schema());
  // Without the flag the schema is outside the closure, so naming it at run is rejected.
  assert(spawned(["build", ".", "-o", "bare.plyx"]).code == 0, None);
  let bare_run = json_of(spawned(["run", "bare.plyx", "--config-schema", "m.spec", "--json"], []));
  assert(not_ok(bare_run), Some(json_text(bare_run)));
  assert(code_of(bare_run) == "E0440", Some(json_text(bare_run)));
  assert(
    str(at(diagnostic(bare_run), "message")).contains("names no definition in this program"),
    Some(
      "the schema is absent from the artifact, rather than entered and declined: "
        ++ json_text(bare_run),
    ),
  );
  // Named at build time, the schema ships, and the artifact fails to start on the missing key as
  // the source does.
  let build = stdout(spawned(["build", ".", "--config-schema", "m.spec", "-o", "with.plyx"]));
  assert(build.contains("startup m.spec"), Some(build));
  let missing = json_of(spawned(["run", "with.plyx", "--config-schema", "m.spec", "--json"], []));
  assert(not_ok(missing), Some(json_text(missing)));
  assert(code_of(missing) == "E0441", Some(json_text(missing)));
  // And starts once the key is supplied: the schema is applied, not merely present.
  let served = json_of(
    spawned(
      [
        "run",
        "with.plyx",
        "--config-schema",
        "m.spec",
        "--set",
        "API_KEY=hunter2",
        "--trace",
        "off",
        "--json",
      ],
      [],
    ),
  );
  assert(bool(at(served, "ok")), Some(json_text(served)));
  // The extra definitions are the schema's closure and nothing else.
  let bare = json_of(spawned(["build", ".", "--json", "-o", "b2.plyx"]));
  let schemed = json_of(
    spawned(["build", ".", "--json", "--config-schema", "m.spec", "-o", "w2.plyx"]),
  );
  assert(items(at(bare, "startup")) == [], Some(json_text(bare)));
  assert(str(nth(at(schemed, "startup"), 0)) == "m.spec", Some(json_text(schemed)));
  assert(
    int(at(schemed, "definitions")) > int(at(bare, "definitions")),
    Some(
      "the schema's closure is in the artifact: " ++ json_text(bare) ++ " vs "
        ++ json_text(schemed),
    ),
  );
  assert(
    at(bare, "digest") != at(schemed, "digest"),
    Some("an artifact that carries a schema is a different artifact"),
  );
  // And it is still the closure of its roots: no test, no law, no fixture.
  let names = names_of(parts_of(bytes_of("w2.plyx"))).map(|n: NameRecord| n.name);
  assert(names.filter(|n: String| n.contains("test")).len() == 0, Some(String::join(names, ", ")))
}

test/nondet "a build schema that names nothing is rejected at build time" {
  write_program(with_schema());
  let out = spawned(["build", ".", "--config-schema", "m.absent", "-o", "x.plyx"]);
  assert(out.code != 0, Some(all_output(out)));
  assert(all_output(out).contains("E0440"), Some(all_output(out)));
  assert(all_output(out).contains("this program has: m.spec"), Some(all_output(out)));
  assert(!fs.exists[cwd]("x.plyx"), None)
}

/// Exits 7 when its caller bound a program to `cc` and 9 when it did not, and starts nothing.
fn asks_for_cc() -> String = String::of_bytes_lossy(embed("../programs/artifact/asks_for_cc.ply"))

// `ply run` over an artifact responds from its own `--exec`. Spawned, since the program exits.
test/nondet "an artifact asks whether its caller bound the label it would start" {
  write_program(asks_for_cc());
  let _ = built();
  [{ exec: ["--exec", "cc=/bin/sh"], code: 7 }, { exec: [], code: 9 }].fold(
    (),
    |u: Unit, c: { exec: List<String>, code: Int }| {
      let out = spawned(["run", "m.plyx"].concat(c.exec), []);
      assert(
        out.code == c.code,
        Some("run with " ++ String::join(c.exec, " ") ++ ":\n" ++ stderr(out)),
      )
    },
  )
}

/// Exits with the code of whatever `cc` names, so nothing but the caller's binding decides what ran.
fn spawns_cc() -> String =
  \\import std.process (process, exit_code)
  \\
  \\fn main() -> Unit / {process.spawn[cc], process.exit[proc]} = {
  \\  let done = process.spawn[cc](["-c", "exit 7"], "", []);
  \\  match exit_code(done) {
  \\    Some(code) -> process.exit[proc](code),
  \\    None -> process.exit[proc](9),
  \\  }
  \\}
  \\

// The label is the capability: an artifact starts what its caller bound to it, and nothing else.
test/nondet "an artifact starts what its caller bound to the label, and rejects a label nothing bound" {
  write_program(spawns_cc());
  let _ = built();
  let bound = spawned(["run", "m.plyx", "--exec", "cc=/bin/sh"], []);
  assert(bound.code == 7, Some("the child's own code is what came back:\n" ++ all_output(bound)));
  let unbound = spawned(["run", "m.plyx"], []);
  assert(unbound.code != 0 && stderr(unbound).contains("E0456"), Some(all_output(unbound)))
}

/// Opens a span and returns without closing it.
fn leaves_a_span() -> String =
  String::of_bytes_lossy(embed("../programs/artifact/leaves_a_span.ply"))

test/nondet "an artifact hands back the span its entry left open beside its value" {
  write_program(leaves_a_span());
  let _ = built();
  let out = spawned(["run", "m.plyx", "--trace", "off", "--json"], []);
  assert_eq(value_of(out), "3");
  let warned = json_text(at(json_of(out), "diagnostics"));
  assert(
    warned.contains("span was still open") && warned.contains("`order` on `orders`"),
    Some(all_output(out)),
  )
}

// --- Signing ---------------------------------------------------------------------

test/nondet "a signed artifact runs under --require-signer, and an unsigned or wrongly signed one is E0460" {
  write_program(source());
  let made = spawned(["keygen", "release.key", "--json"]);
  assert(made.code == 0, Some(all_output(made)));
  assert(spawned(["keygen", "other.key"]).code == 0, None);
  assert(spawned(["keygen", "release.key"]).code != 0, Some("a key was written over"));
  let _ = built();
  let trusting = |keys: List<String>|
    json_of(
      spawned(
        ["run", "m.plyx", "--json"].concat(
          keys.fold([], |acc: List<String>, k: String| acc.concat(["--require-signer", k])),
        ),
      ),
    );
  let unsigned = trusting(["release.key.pub"]);
  assert(code_of(unsigned) == "E0460", Some(json_text(unsigned)));

  let signed = spawned(["build", ".", "-o", "m.plyx", "--sign", "release.key", "--json"]);
  assert(signed.code == 0, Some(all_output(signed)));
  assert_eq(str(at(json_of(signed), "signed_by")), str(at(json_of(made), "key")));
  let ok = trusting(["release.key.pub"]);
  assert(!not_ok(ok), Some(json_text(ok)));
  let elsewhere = trusting(["other.key.pub"]);
  assert(code_of(elsewhere) == "E0460", Some(json_text(elsewhere)));
  assert(!not_ok(trusting(["other.key.pub", "release.key.pub"])), None);
  // A secret key is not a public one.
  assert_eq(code_of(trusting(["release.key"])), "E0462");

  // The same bytes verify; a build of other sources leaves the signature vouching for bytes it no
  // longer sits beside.
  let verified = spawned(["build", ".", "-o", "m.plyx", "--verify", "--json"]);
  assert(verified.code == 0, Some(all_output(verified)));
  assert_eq(items(at(json_of(verified), "signers")).map(str), [str(at(json_of(made), "key"))]);
  write("m.ply", source().replace("Blue(21)", "Blue(22)"));
  let moved = json_of(spawned(["build", ".", "-o", "m.plyx", "--verify", "--json"]));
  assert(
    code_of(moved) == "E0461" && json_text(moved).contains("these sources build"),
    Some(json_text(moved)),
  );
  let _ = built();
  let stale = trusting(["release.key.pub"]);
  assert(code_of(stale) == "E0460", Some(json_text(stale)));
  assert(json_text(stale).contains("vouch for"), Some(json_text(stale)))
}
