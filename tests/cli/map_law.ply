//! A law over maps is tried at maps that hold something: nothing here proves one, and a false one is
//! refuted at the least map tried that breaks it.

import harness (spawned, write_program, json_of, at, path, nth, items, str, json_text)
import std.json (Json, Null)

fn map_law_program() -> String =
  \\fn size(m: Map<String, Int>) -> Int = m.len()
  \\
  \\law "a map's key count is its length"
  \\  forall (m: Map<String, Int>) {
  \\    m.keys().len() == size(m)
  \\  }
  \\
  \\law "inserting a key you already have does not grow the map"
  \\  forall (m: Map<String, Int>, k: String, v: Int) where m.contains(k) {
  \\    m.insert(k, v).len() == m.len()
  \\  }
  \\

// There is no theory of maps, so a true law over one is not proved, and no map tried refutes it.
test/nondet "`ply prove` leaves a true law about a map unproved, with no counterexample" {
  write_program(map_law_program());
  let r = spawned(["prove", "--json"]);
  let v = json_of(r);
  assert(r.code == 1, Some(json_text(v)));
  let obligations = items(at(v, "obligations"));
  assert(obligations.len() == 2, Some(json_text(v)));
  obligations.fold((), |u: Unit, o: Json| {
    assert(str(at(o, "outcome")) == "unproved", Some(json_text(o)));
    assert(str(at(o, "reason_kind")) == "open", Some(json_text(o)));
    assert(at(o, "counterexample") == Null, Some(json_text(o)))
  })
}

test/nondet "`ply prove` reports a counterexample for a false map law, using the smallest map that breaks the law" {
  write_program(
    \\law "every map is empty"
    \\  forall (m: Map<String, Int>) {
    \\    m.len() == 0
    \\  }
    \\
  );
  let r = spawned(["prove", "--json"]);
  assert(r.code == 1, Some("a false law must fail the run"));
  let o = nth(at(json_of(r), "obligations"), 0);
  assert(str(at(o, "outcome")) == "refuted", Some(json_text(o)));
  let binding = nth(path(o, ["counterexample", "bindings"]), 0);
  assert(str(at(binding, "name")) == "m", Some(json_text(o)));
  assert(str(at(binding, "value")) == "{\"\": 0}", Some(json_text(o)))
}
