//! A law over maps is tried at maps that hold something: nothing here proves one, and a false one is
//! refuted at the least map tried that breaks it.

import harness (scratch, on_disk, program, json_of, at, path, nth, items, str, shown)
import std.json (Json, Null)

fn holds() -> String =
  \\fn size(m: Map<String, Int>) -> Int = m.len()
  \\
  \\law "a map's key count is its length"
  \\  forall (m: Map<String, Int>) {
  \\    m.keys().len() == size(m)
  \\  }
  \\
  \\law "inserting a key you already have does not grow the map"
  \\  forall (m: Map<String, Int>, k: String, v: Int) where m.contains(k) {
  \\    m.insert(k, v).len() == m.len()
  \\  }
  \\

// There is no theory of maps, so a true law over one is not proved, and no map tried refutes it.
test "a true law over a map is unproved and never refuted" {
  scratch(|| {
    program(holds());
    let r = on_disk(["prove", "--json"]);
    let v = json_of(r);
    assert(r.code == 1, Some(shown(v)));
    let obligations = items(at(v, "obligations"));
    assert(obligations.len() == 2, Some(shown(v)));
    obligations.fold((), |u: Unit, o: Json| {
      assert(str(at(o, "outcome")) == "unproved", Some(shown(o)));
      assert(str(at(o, "gap_kind")) == "open", Some(shown(o)));
      assert(at(o, "counterexample") == Null, Some(shown(o)))
    })
  })
}

test "a refuted map law names the least map tried that breaks it" {
  scratch(|| {
    program(
      \\law "every map is empty"
      \\  forall (m: Map<String, Int>) {
      \\    m.len() == 0
      \\  }
      \\
    );
    let r = on_disk(["prove", "--json"]);
    assert(r.code == 1, Some("a false law must fail the run"));
    let o = nth(at(json_of(r), "obligations"), 0);
    assert(str(at(o, "outcome")) == "refuted", Some(shown(o)));
    let binding = nth(path(o, ["counterexample", "bindings"]), 0);
    assert(str(at(binding, "name")) == "m", Some(shown(o)));
    assert(str(at(binding, "value")) == "{\"\": 0}", Some(shown(o)))
  })
}
