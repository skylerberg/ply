// E0217: a `numeric` for a type that is not a sum.
//
// An operator finds the functions a type states by the constructor its
// operands carry. An alias is the type it names, and a `new` record runs as its
// plain record, so neither has one: `Count` below is every `Int`, and a `Span`
// is a record like any other of its fields. A number type is declared as a sum.

type Count = Int

type Span = new { from: Int, to: Int }

fn more(a: Count, b: Count) -> Count = a

numeric for Count by { add: more, sub: more, mul: more, neg: more, of_int: more }

numeric for Span by { add: more, sub: more, mul: more, neg: more, of_int: more }
