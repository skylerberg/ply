// E0414: no task is enabled and no timer can fire, so the region can never
// deliver a value.
//
// `@1` reaches its peer through the cell and joins it; `@2` joins `@1`; the
// region's own body is joining `@1` as well. Every one of them is waiting on
// something that is waiting on it, which is a decidable question here only
// because spawn is structured — the set of live tasks is finite and known at
// every scheduling point, so "nothing can run" is an answer rather than a hang.
//
// The `clock.sleep` is what makes the cycle certain rather than likely: virtual
// time cannot move while the region's body is still runnable, so the slot is
// always filled before `@1` reads it, and every interleaving of this program
// deadlocks.

test "two tasks waiting on each other stop the region" {
  with_cell[slot](None) { peer ->
    simulate {
      let first = task.spawn(|| {
        clock.sleep(1);
        match cell_get(peer) { Some(other) -> task.join(other), None -> 0 }
      });
      let second = task.spawn(|| task.join(first));
      cell_set(peer, Some(second));
      task.join(first);
      ()
    }
  }
}
