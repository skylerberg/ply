// E0414: no task is enabled and no timer can fire, so the region can never
// deliver a value.
//
// `@1` asks the handler around its spawn for its peer, which the handler reads
// from the cell, and joins it; `@2` joins `@1`; the region's own body is joining
// `@1` as well. Every one of them is waiting on something that is waiting on
// it, which is a decidable question here only because spawn is structured — the
// set of live tasks is finite and known at every scheduling point, so "nothing
// can run" is an answer rather than a hang.
//
// The cell is opened inside the region, since a task stored in an older one
// would outlive its scheduler (E0446). A task the body spawns may not reach that
// cell either, through its closure or through a handler around its spawn, since
// its scheduler outlives the cell (E0446 again); that rule judges the spawns a
// body performs, so `@1` is spawned by `waiting` instead.
//
// The `clock.sleep` is what makes the cycle certain rather than likely: virtual
// time cannot move while the region's body is still runnable, so the slot is
// always filled before `@1` reads it, and every interleaving of this program
// deadlocks.

effect meet {
  read peer() -> Int
}

fn waiting() -> Task<Int> / {task.write, clock.write, meet.read} =
  task.spawn(|| {
    clock.sleep(1);
    meet.peer()
  })

test "two tasks waiting on each other stop the region" {
  simulate {
    with_cell[slot](None) { peer ->
      handle {
        let first = waiting();
        let second = task.spawn(|| task.join(first));
        cell_set(peer, Some(second));
        task.join(first);
        ()
      } with {
        meet.peer() -> match cell_get(peer) { Some(other) -> task.join(other), None -> 0 },
      }
    }
  }
}
