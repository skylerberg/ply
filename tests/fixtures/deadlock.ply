// E0414: no task is enabled and no timer can fire, so the region can never
// deliver a value.
//
// `@1` waits for its peer on a channel, gets `@2` and joins it; `@2` joins `@1`;
// the region's own body is joining `@1` as well. Every one of them is waiting on
// something that is waiting on it, which is a decidable question here only
// because spawn is structured — the set of live tasks is finite and known at
// every scheduling point, so "nothing can run" is an answer rather than a hang.
// Every interleaving deadlocks: `@1` can join nothing before the body has sent it
// `@2`.

test "two tasks waiting on each other stop the region" {
  simulate {
    let handoff = task.channel(1);
    let first = task.spawn(|| match task.recv(handoff) {
      Some(other) -> task.join(other),
      None -> 0,
    });
    let second = task.spawn(|| task.join(first));
    task.send(handoff, second);
    task.join(first);
    ()
  }
}
