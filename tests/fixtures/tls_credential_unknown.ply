// E0429: `net.listen_tls` names a credential the run does not hold.
//
// The fault is the run's configuration rather than the program's, so this
// program is correct and checks cleanly. It fails at the perform site:
//
//   $ ply run --host tests/fixtures/tls_credential_unknown.ply
//   E0429  no TLS credential named `api` was configured for this run
//
// and succeeds under `--tls api=CERT.pem,KEY.pem`. Without `--host` at all it is
// E0424 naming `ply_host::tls::listen`, exactly as every other host operation
// is: the credential question is never reached, because nothing is bound.
//
// The key is named rather than carried. Certificate bytes written here would put
// a private key into this definition's hash and into a content-addressed store
// designed never to forget; a path here would put a file read inside a `net`
// operation, where `ply hosts` discloses a socket and nothing discloses the
// file.

import std.net (net)

fn credential() -> String = "api"

fn serve(port: Int) -> Int / {net.write[listener]} = {
  let l = net.listen_tls[listener](port, credential());
  net.close[listener](l);
  l
}

fn main() -> Int / {net.write[listener]} = serve(8443)
