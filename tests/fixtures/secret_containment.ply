import std.json
import std.db
import std.sql
import std.db (db)
import std.trace
import std.trace (trace)
import std.config
import std.config (config)

pub fn spec() -> config::ConfigSpec =
  config::spec([config::required("TOKEN", config::SSecret)])

fn token() -> Secret<String> / {config.read[credentials], abort.raise} =
  match config.secret[credentials]("TOKEN") {
    Some(t) -> t,
    None -> panic("TOKEN is unset; pass `--config-schema secret_containment.spec`"),
  }

fn concatenated() -> String / {config.read[credentials], abort.raise} =
  "authorization: " ++ token()

fn traced() -> Unit / {config.read[credentials], trace.write[orders], abort.raise} =
  trace.event[orders](trace::Info, "authenticating",
    Map::new().insert("token", trace::StringField(token())))

fn parameterised() -> sql::QueryResult / {config.read[credentials], db.write[sessions], abort.raise} =
  db.execute[sessions](sql::statement_of("insert into sessions (token) values ($1)"),
                       [sql::TextParameter(token())])

fn unwrapped() -> String / {config.read[credentials], abort.raise} =
  match token() {
    Secret(plain) -> plain,
  }

law "a `Secret` is equal to itself"
  forall (s: Secret<String>) {
    s == s
  }

fn main() -> Unit / {config.read[credentials], trace.write[orders], abort.raise} = {
  traced();
  ()
}
