// The routes a credential would take out of a program, and the code that closes
// each. ADR 0015 §2.3, as a program rather than as a table.
//
//   $ ply check tests/fixtures/secret_containment.ply
//   E0201 · E0201 · E0201 · E0101 · E0101 · E0205 · E0418
//
// The derivation half of §2.3 is next door in `secret_not_derivable.ply`, and it
// is a second file for a mechanical reason worth knowing: derivation runs before
// inference, so a `derive json for` a record with a `Secret` field stops the run
// with `E0206` and nothing after it is ever typechecked. One file would report
// two codes and hide five.
//
// Every refusal below is a **compile error at the call site**, which is the
// claim the milestone is built to make: a credential cannot reach a log, a JSON
// document, a SQL parameter, an HTTP body, a panic payload or a law's
// counterexample, and none of those sentences is a review rule that somebody has
// to remember. Comment out any one line and the file compiles one refusal
// shorter — which is what makes this a fixture rather than a demonstration.
//
// Two things this file deliberately does not show, because they are not compile
// errors and pretending otherwise would be the misleading version:
//
//   - `assert_eq` over a record holding one **compiles**, and prints
//     `Secret(****)` on both sides. Containment at run time is `Value::render`,
//     not a type error, because a program has to be able to compare credentials.
//   - `E0439 SECRET_TO_HOST` has no fixture here and cannot have one in W5. It
//     fires when a host operation whose registration says `secrets: false` is
//     handed a value containing a `Secret`, and **no operation in W5 takes an
//     argument a `Secret` can inhabit** — `net.send` takes `Bytes`, `db.execute`
//     takes `List<Param>` and `Param` has no `PSecret`, `trace.event` takes
//     `Fields` and `Field` has no case for one. The check is landed with a user
//     count of zero because the moment W6 adds an outbound client with a bearer
//     token it will have one, and it is exercised by a Rust test over a fixture
//     registry rather than from Ply source.

import std.json
import std.db
import std.db (db)
import std.trace
import std.trace (trace)
import std.config
import std.config (config)

pub fn spec() -> config::ConfigSpec =
  config::spec([config::required("TOKEN", config::SSecret)])

// The one legitimate way a credential enters a program. It is not a literal, so
// it is in no definition, so it is in no hash and in no content-addressed store
// — which is the hole `secret_of_string("hunter2")` would open and this closes.
fn token() -> Secret<String> / {config.read[credentials]} =
  match config.secret[credentials]("TOKEN") {
    Some(t) -> t,
    None -> panic("TOKEN is unset; pass `--config-schema secret_containment.spec`"),
  }

// E0201: `Secret<String>` is `Con("Secret", [String])` and does not unify with
// `String`, so concatenation — the oldest way a credential reaches a log — has
// nowhere to land.
fn concatenated() -> String / {config.read[credentials]} =
  "authorization: " ++ token()

// E0201: `Field` has no constructor over `Secret<a>`. There is no `FSecret`, and
// adding one would be adding the leak this section exists to remove.
fn traced() -> Unit / {config.read[credentials], trace.write[orders]} =
  trace.event[orders](trace::Info, "authenticating",
    map_insert(map_new(), "token", trace::FText(token())))

// E0201: `Param` has no `PSecret`, and `PText` takes a `String`. A credential
// cannot become a bind parameter, so it cannot be written into a table by
// accident and it cannot appear in a statement's own text either — no function
// in `std.db` turns a value into SQL.
fn parameterised() -> db::Answer / {config.read[credentials], db.write[sessions]} =
  db.execute[sessions](db::stmt("insert into sessions (token) values ($1)"),
                       [db::PText(token())])

// E0101, twice, and E0205 behind them: `Secret` declares no constructors, so there is no pattern that binds
// the payload. This is the single most important line in the section — a
// matchable `Secret` would make the whole of the rest of this file a suggestion.
// The second `E0101` is `plain`, which nothing bound because the pattern that
// would have bound it does not exist, and the `E0205` is the `match` having no
// arm that covers anything — three diagnostics for one line, and all three say
// the same thing.
fn unwrapped() -> String / {config.read[credentials]} =
  match token() {
    Secret(plain) -> plain,
  }

// E0418: `Secret<a>` is not quantifiable, exactly as `Cell` and `Task` are not.
// A generator that minted credentials and a shrinker that printed
// counterexamples would be a leak by construction, and the code for both already
// exists.
law "a credential is its own equal"
  forall (s: Secret<String>) {
    s == s
  }

fn main() -> Unit / {config.read[credentials], trace.write[orders]} = {
  traced();
  ()
}
