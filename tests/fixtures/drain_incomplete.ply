import std.config (config)
import std.http
import std.net (net)
import std.string

pub fn limits() -> http::Limits =
  {
    max_request_line: 8192,
    max_header_bytes: 16384,
    max_header_count: 64,
    max_body: 65536,
    max_chunk_size: 65536,
    max_chunk_line: 4096,
    max_trailer_bytes: 4096,
    max_keep_alive: 100,
    max_stream_chunks: 1024,
    header_timeout_ms: 5000,
    idle_timeout_ms: 5000,
    body_timeout_ms: 15000,
    write_timeout_ms: 15000,
    connect_timeout_ms: 5000,
  }

fn respond<| e>(req: http::Request) -> http::Response<| {http::Reading | e}> / {http::Reading | e} = {
  let body = http::request_body(req, limits().max_body);
  http::text_response(200, body.len().to_string() ++ "\n")
}

fn port() -> Int / {config.get[server], abort.raise} =
  match config.get[server]("DRAIN_PORT") {
    None -> 8137,
    Some(text) -> match text.int_of_string() {
      Some(n) -> n,
      None -> panic("DRAIN_PORT is `" ++ text ++ "`, which is not a port"),
    },
  }

fn main() -> Int / {config.get[server], net.accept[listener], net.close[conn], net.close[listener], net.listen[listener], net.peer_address[conn], net.peer_certificate[conn], net.recv[conn], net.send[conn], abort.raise} =
  http::listen_and_serve[listener, conn](port(), 64, limits(), respond)
