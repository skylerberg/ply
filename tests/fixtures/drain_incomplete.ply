// W0608: the drain deadline expired with a request still in flight.
//
// The program is correct and checks cleanly. The warning is the run's configuration: a
// `--drain-ms` shorter than a request may still take. A request whose head announces a body waits
// up to `body_timeout_ms` for it, so a client that sends the head alone holds its request past a
// 300ms drain, and the run exits 3 rather than 0:
//
//   $ ply run --host --drain-ms 300 --set DRAIN_PORT=8137 drain_incomplete.ply
//   (a client sends `POST / HTTP/1.1` with `Content-Length: 5` and no body; then SIGTERM)
//   Warning[W0608]: the drain deadline expired
//     = 1 connection(s) abandoned with no response written
//
// There is no cancellation: the request is not unwound and is not handed a 503, and its client
// sees the connection close with no response. `--drain-ms` should exceed the program's own
// `body_timeout_ms + write_timeout_ms`, which the run cannot see.

import std.config (config)
import std.http
import std.net (net)
import std.string

pub fn limits() -> http::Limits =
  {
    max_request_line: 8192,
    max_header_bytes: 16384,
    max_header_count: 64,
    max_body: 65536,
    max_chunk_size: 65536,
    max_chunk_line: 4096,
    max_trailer_bytes: 4096,
    max_keep_alive: 100,
    max_stream_chunks: 1024,
    header_timeout_ms: 5000,
    idle_timeout_ms: 5000,
    body_timeout_ms: 15000,
    write_timeout_ms: 15000,
    connect_timeout_ms: 5000,
  }

fn answer(_: http::Request) -> http::Response = http::text_response(200, "ok\n")

fn port() -> Int / {config.get[server], abort.raise} =
  match config.get[server]("DRAIN_PORT") {
    None -> 8137,
    Some(text) -> match string::int_of_string(text) {
      Some(n) -> n,
      None -> panic("DRAIN_PORT is `" ++ text ++ "`, which is not a port"),
    },
  }

fn main() -> Int / {config.get[server], net.accept[listener], net.close[conn], net.close[listener], net.listen[listener], net.peer_address[conn], net.recv[conn], net.send[conn], abort.raise} =
  http::listen_and_serve[listener, conn](port(), 64, limits(), answer)
