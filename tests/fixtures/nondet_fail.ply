// E0412: the `examples/clock.ply` test without its `/nondet` opt-out. `stale`
// never reads the clock for a session with no deadline, but its signature says
// it may, so the atom survives and the test is not deterministic.
nondet effect clock {
  read now() -> Int
}

type Session = { user: String, started: Int, ttl: Int }

fn expires_at(s: Session) -> Int = s.started + s.ttl

fn expired(s: Session) -> Bool / {clock.read} =
  clock.now() > expires_at(s)

fn stale(s: Session) -> Bool / {clock.read} =
  if s.ttl <= 0 { false } else { expired(s) }

test "a session with no deadline never goes stale" {
  assert(!stale({user: "ada", started: 1000, ttl: 0}))
}
