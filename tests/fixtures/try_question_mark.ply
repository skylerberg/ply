// E0118: a `try` is a `handle`, and `?` never exits one. `?` here would have to leave the `try`
// with an `Err` of another type than the one the `try` answers.
effect parse {
  raise bad(at: Int)
}

fn digit(b: Int) -> Int / {parse.bad} = if b < 48 { parse.bad(b) } else { b - 48 }

fn half(n: Int) -> Result<Int, String> = if n % 2 == 0 { Ok(n / 2) } else { Err("odd") }

fn checked(b: Int) -> Result<Int, String> = {
  let r = try { half(digit(b))? };
  match r { Ok(v) -> Ok(v), Err(at) -> Err("not a digit") }
}
