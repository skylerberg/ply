fn inner() -> Int / {sim.read, abort.raise} =
  simulate {
    let t = task.spawn(|| 1);
    task.join(t)
  }

test "a simulation may not be written inside a simulation" {
  simulate {
    simulate {
      ()
    }
  }
}

test "a `simulate` block cannot call a function that contains another `simulate` block" {
  simulate {
    assert_eq(inner(), 1)
  }
}
