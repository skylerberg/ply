// E0416: a `simulate` block inside a `simulate` block.
//
// The test is one effect-membership question — `sim.read` in the body's effects — so it
// catches the call below as exactly as it catches the lexical nesting above it.
// Two schedulers would mean two notions of "runnable", a task in the inner
// simulation blocking the outer one, and a state space that is a product nobody has
// an account of.

fn inner() -> Int / {sim.read, abort.raise} =
  simulate {
    let t = task.spawn(|| 1);
    task.join(t)
  }

test "a simulation may not be written inside a simulation" {
  simulate {
    simulate {
      ()
    }
  }
}

test "nor reached through a call from inside one" {
  simulate {
    assert_eq(inner(), 1)
  }
}
