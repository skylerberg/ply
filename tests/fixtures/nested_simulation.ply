// E0416: a `simulate` region inside a `simulate` region.
//
// The test is one row-membership question — `sim.read` in the body's row — so it
// catches the call below as exactly as it catches the lexical nesting above it.
// Two schedulers would mean two notions of "runnable", a task in the inner
// region blocking the outer one, and a state space that is a product nobody has
// an account of.

fn inner() -> Int / {sim.read} =
  simulate {
    let t = task.spawn(|| 1);
    task.join(t)
  }

test "a region may not be written inside a region" {
  simulate {
    simulate {
      1
    }
  }
}

test "nor reached through a call from inside one" {
  simulate {
    inner()
  }
}
