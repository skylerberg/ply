// E0207: a `derive` or a `where` clause naming something that is not a deriver.
//
// The derivers are fixed — `json`, `eq`, `ord` — and there are no user-defined
// ones. So this is decided at parse time, with the whole list in the note,
// rather than left to fail later as an unknown reference inside generated code
// the user never wrote and cannot open.

type Order = { id: Int }

derive toml for Order

fn same<a>(x: a, y: a) -> Bool where derivable(hash, a) = true
