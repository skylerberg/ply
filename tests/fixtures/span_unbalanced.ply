// E0445: `trace.exit` naming a span that is not open on the performing task's
// stack.
//
//   $ ply run --host --trace json tests/fixtures/span_unbalanced.ply
//   E0445  this span is not open on this task
//
// Three ways to get here and this fixture writes the first two: closing a span
// twice, and closing one that was never opened. The third — closing a span
// another task opened — needs two tasks, and the bound driver names both.
//
// Accepting it silently is the reason it is a refusal rather than a shrug. A
// span stack is what decides which records nest under which, so an exit that
// pops something it did not push leaves the *next* request's timing filed under
// this one's span, and the resulting log is not wrong in a way anybody notices —
// it is wrong in a way that makes every later reading of it wrong too.
//
// A span the program never closes is a different thing and is not this: it is
// closed at teardown and reported `W0609 SPAN_ABANDONED`, which is a fact about
// how a request ended rather than a defect in how it was written.
//
// Under the twin this is `exit_step` answering `ok: false` — a value does not
// raise — and the handler clause decides what to do about it. `examples/desk.ply`
// panics, because an unbalanced exit is a defect in the program that performed
// it; this fixture reaches the bound driver, which is where the diagnostic is.

import std.trace
import std.trace (trace)

// Closed twice. The first `exit` pops the span; the second names an id that is
// no longer open, and nothing about the second call is distinguishable at the
// call site from the first.
fn closed_twice() -> Unit / {trace.write[orders]} = {
  let span = trace.enter[orders]("place", map_new());
  trace.exit[orders](span, trace::Ok);
  trace.exit[orders](span, trace::Ok)
}

// Never opened at all. `Span` is an ordinary record — an id is what correlates
// two lines in a log, so a program has to be able to put one in a field — and
// the cost of that decision is that a program can also write one down. This is
// the check that makes the cost bounded.
fn never_opened() -> Unit / {trace.write[orders]} =
  trace.exit[orders]({id: 99, channel: "orders"}, trace::Ok)

fn main() -> Unit / {trace.write[orders]} = {
  closed_twice();
  never_opened()
}
