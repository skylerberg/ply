// E0442: a resolved value that does not satisfy its declared shape.
//
// The fault is the run's configuration rather than the program's, so this
// program is correct and checks cleanly. It fails at start-up, naming the key
// and the source that won:
//
//   $ ply run --host tests/fixtures/config_invalid.ply \
//       --config-schema m.spec --set DESK_PORT=eight --set DESK_API_KEY=k
//   E0442  `DESK_PORT` is declared `SInt` and --set supplied a value that
//          it is not an `Int`
//          = the value is `eight`
//
// **And the one case that prints no value:**
//
//   $ ply run --host tests/fixtures/config_invalid.ply \
//       --config-schema m.spec --set DESK_PORT=8137 --set DESK_API_KEY=
//   E0442  `DESK_API_KEY` is declared `SSecret` and --set supplied a value that
//          it is empty, and an empty credential is an unset one
//          = the value is not printed, because a diagnostic's message reaches
//            stderr, `--json` and a cached failure report
//
// An empty credential is not a pedantic refusal: it is the shape an unset
// environment variable takes after a shell expands it, so accepting one is
// accepting the exact mistake this check exists to catch, one layer further in
// and with the failure moved to whichever request first authenticates.
//
// A plain value *is* printed, and that asymmetry is the point. An operator
// debugging "it used the wrong region" needs to see `eu-wesst`; one debugging a
// credential needs only to know which source won.

import std.config
import std.config (config)

pub fn spec() -> config::ConfigSpec =
  config::spec([
    config::required("DESK_PORT", config::SInt),
    config::required("DESK_API_KEY", config::SSecret),
  ])

fn main() -> Option<String> / {config.read[server]} =
  config.get[server]("DESK_PORT")
