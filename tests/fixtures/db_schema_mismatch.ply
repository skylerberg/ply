// E0435: the live database is not the one the program describes.
//
//   $ ply run --host --db postgres://localhost/desk --db-schema \
//       db_schema_mismatch.schema tests/fixtures/db_schema_mismatch.ply
//   E0435  table `parts` has no column `weight`
//
// W4 ships no migration tool — no versions, no up and down, no ordering across
// deploys, no diffing a live database into a change script. It ships this
// instead, and this is most of what a migration tool is actually bought for: the
// guarantee that the code and the database agree, checked at start-up rather
// than discovered at the first request.
//
// `--db-schema <module>.<fn>` names a nullary function returning a `Schema`. At
// bind time the driver materialises it, reads `information_schema` and
// `pg_constraint`, and reports one E0435 per difference — a missing table, a
// missing column, a type that does not match the pinned mapping, a nullability
// that disagrees, a missing constraint — before anything runs.
//
// It is optional. Without it the same mismatch surfaces at prepare time as
// E0433: later, per statement, and still loud.
//
// The run's configuration is at fault rather than the program's. The program is
// entitled to describe the database it was written for; what it cannot do is
// check that the one it was pointed at is that database, which is why this is
// the driver's job and why it happens before the first request rather than
// during it.

import std.db
import std.db (db)

pub fn schema() -> db::Schema = {
  tables: [
    {
      name: "parts",
      columns: [
        {name: "sku", ty: db::TText, nullable: false, default: db::DNone},
        {name: "weight", ty: db::TNumeric(10, 3), nullable: false, default: db::DNone},
      ],
      primary_key: ["sku"],
      unique: [],
      foreign_keys: [],
      checks: [],
    },
  ],
}

fn main() -> Int / {db.read[parts]} =
  match db.query[parts](db::stmt("select sku, weight from parts order by sku"), []) {
    db::Rows(rows) -> len(rows),
    db::Count(n) -> n,
    db::Failed(_) -> -1,
  }
