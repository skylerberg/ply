// E0201: a raise does not come back, so its clause has no continuation to bind. The clause's
// value is the `handle`'s.
effect parse {
  raise bad(at: Int)
}

fn digit(b: Int) -> Int / {parse.bad} = if b < 48 { parse.bad(b) } else { b - 48 }

fn checked(b: Int) -> Int = handle { digit(b) } with { parse.bad(at) resume k -> 0 }
