// Two cases that `==` calls equal are two where they are built differently.
//
// A run tells one case from another by what it holds, not by its key, and
// keeps a pass under that. The two lengths below are one length to `==`, and
// the body tells them apart: the first passes, the second fails, and the pass
// of the first never stands for the second.

type Length = | Metres(Int) | Millimetres(Int)

key for Length by millimetres

fn millimetres(l: Length) -> Int = match l { Metres(n) -> n * 1000, Millimetres(n) -> n }

fn in_metres(l: Length) -> Bool = match l { Metres(_) -> true, Millimetres(_) -> false }

test "{l} is in metres" for l: Length in [Metres(2), Millimetres(2000)] { assert(in_metres(l)) }
