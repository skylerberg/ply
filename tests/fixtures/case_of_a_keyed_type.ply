// E0206: a test's case holds a value of a type that states a `key`.
//
// A run tells one case from another by its value's digest, and keeps a pass
// under it. A keyed value's digest is its key's, so the two lengths below would
// be one case: the body tells them apart, and the pass of one would stand for
// the other. A table ranges over what the values are built from instead, and
// the body builds each.

type Length = | Metres(Int) | Millimetres(Int)

key for Length by millimetres

fn millimetres(l: Length) -> Int = match l { Metres(n) -> n * 1000, Millimetres(n) -> n }

fn in_metres(l: Length) -> Bool = match l { Metres(_) -> true, Millimetres(_) -> false }

test "a length of {millimetres(l)}" for l: Length in [Metres(2), Millimetres(2000)] {
  assert(in_metres(l))
}
