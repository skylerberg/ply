// E0504: a clause that binds a continuation. This typechecks and runs — on the
// machine. The tree-walker has no explicit control stack to capture, so it
// refuses the clause by name rather than approximating it as tail-resumptive.
//
// ADR 0005 §3.2, "resumes twice": the handle answers 30 and the trace cell ends
// at 2, because both resumptions run against one threaded world.
effect amb {
  read flip[coin]() -> Bool
}

test "both branches are taken and the world is threaded through them" {
  with_cell[trace](0) { c -> {
    let total = handle {
      let b = amb.flip[coin]();
      cell_set(c, cell_get(c) + 1);
      if b { 10 } else { 20 }
    } with {
      amb.flip[coin]() resume k -> k(true) + k(false),
      return x -> x
    };
    assert_eq(total, 30);
    assert_eq(cell_get(c), 2)
  } }
}
