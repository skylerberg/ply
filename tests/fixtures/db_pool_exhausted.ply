// E0437: no connection became available within `--db-acquire-ms`.
//
//   $ ply run --host --db postgres://localhost/desk --db-pool 1 \
//       --db-acquire-ms 200 tests/fixtures/db_pool_exhausted.ply
//   E0437  the pool holds 1 connection, 1 checked out; `db.begin` waited 200ms
//
// The run's configuration is at fault rather than the program's: the program
// asked for a connection and the run said how many exist.
//
// A `Failed` here was the alternative and is refused. A `Failed` is a value a
// program is invited to swallow, and a swallowed pool exhaustion is a service
// that returns wrong answers under exactly the load that produced it. W5 owns
// backpressure and is where this becomes a shed request rather than a stop.
//
// It is also what keeps the deadlock check honest. Without an acquire deadline,
// a pool smaller than the number of open scopes parks every task forever with
// nothing to report: E0437 is what turns that hang into a sentence naming the
// size, the number checked out and the operation that waited.

import std.db
import std.db (db)

fn hold(sku: String) -> Unit / {db.write, db.write[parts]} = {
  db::transaction(db::ReadCommitted, db::ReadWrite, || {
    db.execute[parts](db::stmt("insert into parts (sku) values ($1)"), [db::PText(sku)]);
    ()
  });
  ()
}

// Two transactions in flight at once. With `--db-pool 1` the second waits for a
// connection the first is holding until it opens its own scope, and there is
// none.
fn main() -> Unit / {db.write, db.write[parts], task.write} = {
  let a = task.spawn(|| hold("a"));
  let b = task.spawn(|| hold("b"));
  task.join(a);
  task.join(b)
}
