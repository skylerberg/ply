type Term = | Leaf(Int) | Sum(Term, Term)

fn normal(t: Term) -> Term = match t { Sum(Leaf(0), rest) -> rest, other -> other }

key for Term by normal

type Account = | Account(String, Int)

type Owner = | Owner(String, Account)

fn owner(a: Account) -> Owner = match a { Account(name, _) -> Owner(name, a) }

key for Account by owner
