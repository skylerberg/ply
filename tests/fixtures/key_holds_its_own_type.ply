// E0219: a `key` whose answer is compared through the type it is the key of.
//
// Two values of a keyed type are compared by comparing their keys. A key that
// is, or holds, a value of the same type is compared by asking for its key
// again, and that never ends. The checker follows what each key answers,
// through the types that hold it and the keys those state, and refuses the
// loop where it is declared.

type Term = | Leaf(Int) | Sum(Term, Term)

// A normal form is still a `Term`.
fn normal(t: Term) -> Term = match t { Sum(Leaf(0), rest) -> rest, other -> other }

key for Term by normal

type Account = | Account(String, Int)

type Owner = | Owner(String, Account)

// Through another type: an account is compared by its owner, who holds the account.
fn owner(a: Account) -> Owner = match a { Account(name, _) -> Owner(name, a) }

key for Account by owner
