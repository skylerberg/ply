// W0604: obligations the system cannot decide, and says so rather than
// labelling.
//
// A gap is not a weak tier. It does not fail the run — making it one would mean
// a spec could never be attached to an effectful definition — and it does not
// count toward coverage either, because a definition whose only obligation is
// undischargeable is a definition a reviewer still has to read line by line.
//
// One definition per reason.

effect db {
  read  all[table]() -> List<Int>
  write save[table](rows: List<Int>) -> Unit
}

// Unhandled effect. The clause itself is pure, so nothing here is E0417 — but
// checking it means *calling* `record`, and `record` performs two atoms that
// nothing supplies a handler for. There is no `test` around an obligation and no
// `handle` in scope, and inventing one would be inventing a behaviour and then
// testing against it. The static prover attempts it first, at a bounded cost,
// and a body containing a perform cannot be unfolded, so the practical answer is
// the gap.
fn record(payment: Int) -> Int / {db.read[payments], db.write[payments]} {
  let rows = db.all[payments]();
  db.save[payments](push(rows, payment));
  len(rows) + 1
}

fn recorded(payment: Int) -> Int / {db.read[payments], db.write[payments]}
  requires payment > 0
  ensures result > 0
= record(payment)

// A raised evaluation. `parts` is drawn, `0` is drawn on every run, and the
// author forgot the `requires parts > 0` that would have filtered it out. A spec
// that raises is not false, so this is neither a refutation nor a hold: the
// raising input is reported, shrunk with "still raises" as the predicate,
// because a minimal raising input is worth exactly what a minimal falsifying one
// is.
fn share(total: Int, parts: Int) -> Int
  ensures result * parts <= total
= total / parts

test "a payment lands once" {
  with_cell[payments]([7, 9]) { rows ->
    handle {
      assert_eq(recorded(11), 3);
      assert_eq(cell_get(rows), [7, 9, 11])
    } with {
      db.all[payments]() -> cell_get(rows),
      db.save[payments](next) -> cell_set(rows, next),
    }
  }
}

test "a share is what divides out" {
  assert_eq(share(100, 4), 25)
}
