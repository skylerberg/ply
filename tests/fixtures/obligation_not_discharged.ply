effect db {
  read  all[table]() -> List<Int>
  write save[table](rows: List<Int>) -> Unit
}

fn record(payment: Int) -> Int / {db.read[payments], db.write[payments]} = {
  let rows = db.all[payments]();
  db.save[payments](rows.push(payment));
  rows.len() + 1
}

fn recorded(payment: Int) -> Int / {db.read[payments], db.write[payments]}
  requires payment > 0
  ensures result > 0
= record(payment)

fn share(total: Int, parts: Int) -> Int / {abort.raise}
  ensures result * parts <= total
= total / parts

test "`recorded` adds the payment to the saved rows and returns the new row count" {
  let rows = handle {
    assert_eq(recorded(11), 3)
  } with {
    var rows = [7, 9],
    db.all[payments]() -> rows,
    db.save[payments](next) -> {
      rows = next;
    },
    return u -> rows,
  };
  assert_eq(rows, [7, 9, 11])
}

test "`share(100, 4)` returns 25 when the total divides evenly" {
  assert_eq(share(100, 4), 25)
}
