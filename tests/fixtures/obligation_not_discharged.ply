// E0474: obligations nothing proves, each reported with what stopped it.
//
// A claim that is not proved fails the run as a refuted one does: a claim a
// reader cannot rely on is not one to print beside those they can. What differs
// is the diagnostic, which says how far the attempt got.
//
// One definition per reason.

effect db {
  read  all[table]() -> List<Int>
  write save[table](rows: List<Int>) -> Unit
}

// Unhandled effect. The clause itself is pure, so nothing here is E0417 — but
// its owner performs two atoms that nothing supplies a handler for. There is no
// `test` around an obligation and no `handle` in scope, and inventing one would
// be inventing a behaviour and then proving against it. A body containing a
// perform cannot be unfolded, so no proof is found and no run is made.
fn record(payment: Int) -> Int / {db.read[payments], db.write[payments]} {
  let rows = db.all[payments]();
  db.save[payments](push(rows, payment));
  len(rows) + 1
}

fn recorded(payment: Int) -> Int / {db.read[payments], db.write[payments]}
  requires payment > 0
  ensures result > 0
= record(payment)

// A raised evaluation. No proof is found, so the claim is tried at a few small
// values, `0` among them, and the author forgot the `requires parts > 0` that
// would have kept it out. A spec that raises is not false, so this is no
// refutation: the raising input is reported as what stopped the attempt.
fn share(total: Int, parts: Int) -> Int / {abort.raise}
  ensures result * parts <= total
= total / parts

test "a payment lands once" {
  with_cell[payments]([7, 9]) { rows ->
    handle {
      assert_eq(recorded(11), 3);
      assert_eq(cell_get(rows), [7, 9, 11])
    } with {
      db.all[payments]() -> cell_get(rows),
      db.save[payments](next) -> cell_set(rows, next),
    }
  }
}

test "a share is what divides out" {
  assert_eq(share(100, 4), 25)
}
