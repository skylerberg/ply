// E0412: `task` is declared `nondet`, because concurrency without a specified
// scheduler *is* nondeterminism. A deterministic test may not contain it.
//
// Two ways out, and neither is a special case: handle it — `simulate { .. }` is
// the scheduler the language ships, and a sequential one is eight lines of
// ordinary Ply — or declare the test `test/nondet` and give up the cache.
//
// This is the first time the language's claim that a flaky test fails to compile
// has had anything to say about the largest real source of flakes.

fn double(n: Int) -> Int = n + n

test "a deterministic test may not spawn without a scheduler" {
  let t = task.spawn(|| double(21));
  assert_eq(task.join(t), 42)
}
