// E0441: a `required` key nothing supplies.
//
// The fault is the run's configuration rather than the program's, so this
// program is correct and checks cleanly. It fails at start-up, before anything
// is bound:
//
//   $ ply run --host tests/fixtures/config_missing.ply --config-schema m.spec
//   E0441  the configuration schema requires `DESK_API_KEY` and nothing supplies it
//          = the run looked in: 0 `--set` arguments, no `--config` file,
//            341 environment variables, and the schema's own default
//
// and succeeds under `--set DESK_API_KEY=…`, a `--config` file holding it, or
// an exported `DESK_API_KEY`.
//
// This is the whole reason `--config-schema` exists. Without it the missing key
// is a `None` at the call site — later, per key, and reached only by whichever
// request first needs it. A service that starts, serves two hundred requests and
// then answers wrongly because a key was unset is worse than one that refuses to
// start, and the difference between the two is this one argument.
//
// `DESK_REGION` shows the other half: a key with a default is supplied by
// definition, so it is never `E0441` however little the run was told.

import std.config
import std.config (config)

pub fn spec() -> config::ConfigSpec =
  config::spec([
    config::required("DESK_API_KEY", config::SSecret),
    config::with_default("DESK_REGION", config::SText, "eu"),
  ])

fn main() -> Bool / {config.read[credentials]} =
  match config.secret[credentials]("DESK_API_KEY") {
    None -> false,
    Some(key) -> !secret_is_empty(key),
  }
