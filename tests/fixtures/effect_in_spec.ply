// E0417: a claim that performs.
//
// A spec expression's row must be empty. The reason is not tidiness: a claim
// that can perform effects can change what it observes, so an `ensures` that
// reads the resource it is judging reports a state it helped produce. A property
// run evaluates a clause hundreds of times, so an effectful clause would perform
// hundreds of times against a world nothing set up — and its footprint would
// join the definition's row, so attaching a spec would change which *tests* may
// run concurrently.
//
// Three clauses, one per position the rule covers.

effect db {
  read  all[table]() -> List<Int>
  write save[table](rows: List<Int>) -> Unit
}

fn stored() -> Int / {db.read[quotas]} =
  len(db.all[quotas]())

fn quota(limit: Int) -> Int =
  if limit < 0 { 0 } else { limit }

// An `ensures` that reads the table it is talking about.
fn allowance(limit: Int) -> Int
  ensures result <= stored()
= quota(limit)

// A `requires` is no different: it decides the domain of the clauses beside it,
// and a domain that depends on what a resource happens to hold is a different
// domain per run.
fn charge(limit: Int, amount: Int) -> Int
  requires stored() > 0
  ensures result == quota(limit)
= quota(limit)

// A `where` guard, for the same reason. The body of a law may carry `{sim.read}`
// and nothing else; a guard may carry nothing at all.
law "an allowance never exceeds what is stored"
  forall (limit: Int) where stored() > 0 {
    allowance(limit) >= 0
  }
