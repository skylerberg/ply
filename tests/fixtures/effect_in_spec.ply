effect db {
  read  all[table]() -> List<Int>
  write save[table](rows: List<Int>) -> Unit
}

fn stored() -> Int / {db.read[quotas]} =
  db.all[quotas]().len()

fn quota(limit: Int) -> Int =
  if limit < 0 { 0 } else { limit }

fn allowance(limit: Int) -> Int
  ensures result <= stored()
= quota(limit)

fn charge(limit: Int, amount: Int) -> Int
  requires stored() > 0
  ensures result == quota(limit)
= quota(limit)

law "`allowance` returns a value of at least 0 for every limit, whenever `stored()` is greater than 0"
  forall (limit: Int) where stored() > 0 {
    allowance(limit) >= 0
  }
