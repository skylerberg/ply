// E0413: `std.task`'s `scoped` hands its body the tasks it started, and a body that answers
// them would hand them on out of the region, where nothing schedules them.
//
// Inside the region a handle from a combinator is as any other: it names a task `scoped` stops
// before it answers. The fix is to answer what the tasks answered, as `task::all` does.

import std.task

test "a task a combinator started may not leave its region" {
  let escaped = simulate { task::scoped([|| 1], |kids: List<Task<Int>>| kids) };
  ()
}
