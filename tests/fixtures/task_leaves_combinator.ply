// E0413: `std.task`'s `scoped` hands its body the tasks it started, and a body that returns
// them would hand them on out of the simulation, where nothing schedules them.
//
// Inside the simulation a handle from a combinator is as any other: it names a task `scoped` stops
// before it returns. The fix is to return what the tasks returned, as `task::all` does.

import std.task

test "a task a combinator started may not leave its simulation" {
  let escaped = simulate { task::scoped([|| 1], |kids: List<Task<Int>>| kids) };
  ()
}
