// E0202, three times: a use of a type fills as many labels and rows as the type binds, in the
// places it binds them. `Feed` binds one of each, so a use that leaves the row out, or writes two
// labels, is refused; and `List` binds neither, so it takes no row.
effect wire {
  read pull[l]() -> Option<Int>
}

type Feed<a, [l] | e> = | Feed(() -> Option<a> / {wire.pull[l] | e})

fn rowless(f: Feed<Int, [line]>) -> Int = 0

fn two_labels(f: Feed<Int, [line, spare] | {}>) -> Int = 0

fn no_such_row(xs: List<Int | {}>) -> Int = 0
