// A clause that binds a continuation and resumes it twice.
//
// the two-resumption example, "resumes twice": the handle answers 30 and the trace cell ends
// at 2, because both resumptions run against one threaded world.
effect amb {
  read flip[coin]() -> Bool
}

test "both branches are taken and the world is threaded through them" {
  with_cell[trace](0) { c -> {
    let total = handle {
      let b = amb.flip[coin]();
      cell_set(c, cell_get(c) + 1);
      if b { 10 } else { 20 }
    } with {
      amb.flip[coin]() resume k -> k(true) + k(false),
      return x -> x
    };
    assert_eq(total, 30);
    assert_eq(cell_get(c), 2)
  } }
}
