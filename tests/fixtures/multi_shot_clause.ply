// A clause that binds a continuation and resumes it twice.
//
// the two-resumption example, "resumes twice": the handle answers 30 and the trace ends at 2,
// because both resumptions step one handler's variable outside the continuation.
effect amb {
  read flip[coin]() -> Bool
}

effect trace {
  write step() -> Unit
}

test "both branches are taken and the world is threaded through them" {
  let steps = handle {
    let total = handle {
      let b = amb.flip[coin]();
      trace.step();
      if b { 10 } else { 20 }
    } with {
      amb.flip[coin]() resume k -> k(true) + k(false),
      return x -> x
    };
    assert_eq(total, 30)
  } with {
    var n = 0,
    trace.step() -> {
      n = n + 1;
    },
    return u -> n,
  };
  assert_eq(steps, 2)
}
