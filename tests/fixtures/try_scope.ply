// E0118: `?` reads which constructors to name off the enclosing function's
// *written* return type, because the parser has no types — the driver hashes
// before it infers (ADR 0002), which is why the expansion runs where it does
// (`docs/adr/0027-the-question-mark-operator.md`).
type DecodeError = { at: Int, why: String }

fn decode_one(n: Int) -> Result<Int, DecodeError> =
  if n < 0 { Err({at: n, why: "negative"}) } else { Ok(n) }

// A lambda has no written return type, so there is nothing to read a mode off.
// The lift is to name a function with a written `->` and call it.
fn decode_all(ns: List<Int>) -> Result<List<Int>, DecodeError> =
  Ok(map(ns, |n: Int| decode_one(n)?))
