pub type Invoice = { total: Decimal, count: Int }

pub fn unit_price(inv: Invoice) -> Decimal / {abort.raise} =
  inv.total / Decimal::of_int(inv.count)

pub fn split(total: Decimal, ways: Decimal) -> Decimal / {abort.raise} = total / ways

pub fn left_over(total: Decimal, ways: Decimal) -> Decimal / {abort.raise} = total % ways

pub fn with_tax(net: Decimal, rate: Decimal) -> Decimal = net + net * rate

pub fn unit_price_rounded(total: Decimal, count: Int) -> Decimal / {abort.raise} =
  total.div(Decimal::of_int(count), 2, HalfEven)

pub fn share(total: Int, ways: Int) -> Int / {abort.raise} = total / ways
pub fn ratio(a: Float, b: Float) -> Float = a / b
