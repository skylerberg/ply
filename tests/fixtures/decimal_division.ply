// E0209: `/` applied to `Decimal`.
//
// This is the one place W2 refuses something every other language allows, and
// it is deliberate. The exact quotient of two decimals is not in general a
// decimal — `1m / 3m` has no finite base-ten expansion — so the operator would
// have to round, and a silently-rounded division is the single most common
// money bug. The operator is exactly where it hides: nothing in `total / count`
// says how many places the answer keeps or which way a half goes.
//
// The fix is not to relax the rule. It is `decimal_div(total, count, 2,
// HalfEven)`, where the scale and the rounding mode are arguments the reader can
// see and the reviewer can argue with.

pub type Invoice = { total: Decimal, count: Int }

// The refusal. Both operands are `Decimal`, so `/` has nowhere honest to go.
pub fn unit_price(inv: Invoice) -> Decimal =
  inv.total / decimal_of_int(inv.count)

// A second one under an alias, so the diagnostic is about the operator's type
// rather than about a syntactic shape.
pub fn split(total: Decimal, ways: Decimal) -> Decimal = total / ways

// -- Everything below is accepted, and is here to show the boundary. ---------

// `%` is exact, and is therefore allowed where `/` is not: the *remainder* of a
// decimal division is a decimal even when the quotient is not.
pub fn left_over(total: Decimal, ways: Decimal) -> Decimal = total % ways

// `+`, `-` and `*` are exact — or `E0502` on mantissa overflow. Never a silent
// wrap and never a silent rounding: a total that quietly lost a cent is the
// failure this type exists to prevent.
pub fn with_tax(net: Decimal, rate: Decimal) -> Decimal = net + net * rate

// The replacement the diagnostic names. The `2` and the `HalfEven` are the two
// facts the operator could not carry.
pub fn unit_price_rounded(total: Decimal, count: Int) -> Decimal =
  decimal_div(total, decimal_of_int(count), 2, HalfEven)

// `/` at the other two numeric types is untouched, because neither promises an
// exact answer in the first place.
pub fn share(total: Int, ways: Int) -> Int = total / ways
pub fn ratio(a: Float, b: Float) -> Float = a / b
