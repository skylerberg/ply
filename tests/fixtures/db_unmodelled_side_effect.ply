// E0438: an object in the database reaches a table outside the atom it fires
// under.
//
//   $ psql -d desk -c 'create table audit (sku text)'
//   $ psql -d desk -c 'create trigger parts_audit after insert on parts
//                        for each row execute function log_part()'
//   $ ply run --host --db postgres://localhost/desk \
//       tests/fixtures/db_unmodelled_side_effect.ply
//   E0438  trigger `parts_audit` on `parts` reaches `audit`
//
// A trigger, a rewrite rule, or a foreign key with `ON DELETE CASCADE` /
// `ON UPDATE CASCADE` / `SET NULL` / `SET DEFAULT` makes one statement touch a
// table its text never names. No scanner can see that, because it is not in the
// statement — so the *database* is asked, at bind time: `pg_trigger`,
// `pg_rewrite` and `pg_constraint` over every table any of the program's `db`
// atoms names.
//
// This is strict, and being strict is the decision. A footprint that
// under-reports corrupts scheduling and isolation **silently**, and two
// host-backed tests over what look like disjoint tables run concurrently against
// one database on the strength of exactly this claim. There is no flag to
// suppress it, because a flag that turns a soundness check off is a flag whose
// default becomes the one nobody uses.
//
// The run's configuration is at fault rather than the program's — the schema is
// not this file's to fix, and the refusal names the object and the table it
// reaches so that it can be.
//
// The program below is correct against a schema with no such object. That is the
// point: nothing in it is wrong, and it is refused anyway, because the row it
// publishes would not have been the truth.

import std.db
import std.db (db)

fn add_part(sku: String) -> db::Answer / {db.write[parts]} =
  db.execute[parts](db::stmt("insert into parts (sku) values ($1)"), [db::PText(sku)])

fn main() -> Int / {db.write[parts]} =
  match add_part("bolt") {
    db::Count(n) -> n,
    db::Rows(rows) -> len(rows),
    db::Failed(_) -> -1,
  }
