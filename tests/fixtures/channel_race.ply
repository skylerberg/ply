// Two senders race to one channel and the receiver counts on the first one spawned being heard
// first. Run end to end it usually is; the search sends the second one first.

test "the first sender spawned is heard first" {
  simulate {
    let c = task.channel(1);
    let a = task.spawn(|| task.send(c, 1));
    let b = task.spawn(|| task.send(c, 2));
    assert_eq(task.recv(c), Some(1));
    assert_eq(task.recv(c), Some(2));
    assert(task.join(a) && task.join(b))
  }
}
