// E0216: a `numeric` for a type that takes parameters.
//
// An operator calls the type's functions with its values alone, and
// `numeric_of_int` calls one with no value at all. Nothing at either says what
// `a` is here, and arithmetic over `a` would need `numeric(a)` filled by a call
// no operator makes. A number type takes no parameter.

type Pair<a> = | Pair(a, a)

fn both<a>(x: Pair<a>, y: Pair<a>) -> Pair<a> = x

fn turned<a>(x: Pair<a>) -> Pair<a> = x

fn twice(n: Int) -> Pair<Int> = Pair(n, n)

numeric for Pair by { add: both, sub: both, mul: both, neg: turned, of_int: twice }
