import std.trace
import std.trace (trace)

fn reserving() -> Int / {trace.write[orders]} = {
  let span = trace.enter[orders]("reserving", Map::new());
  trace.event[orders](trace::Info, "reading the shelf", Map::new());
  3
}

fn main() -> Int / {trace.write[orders]} = {
  let outer = trace.enter[orders]("order", Map::new());
  reserving()
}
