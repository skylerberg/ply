// W0609: spans were still open when the entry point ended.
//
//   $ ply run --host --trace json tests/fixtures/span_abandoned.ply
//   warning[W0609]: 2 spans were open when `main` ended (innermost: `reserving`)
//
// A warning and not an error, because it is a fact about how a computation
// ended rather than a defect in how it was written. Three of the four ways a Ply
// computation leaves a span never run another line of it — a `db.rollback`
// discards the continuation, a raise propagates past, and an entry point simply
// ends — so a program that opens a span and does not close it is not doing
// anything unusual, it is failing, and what the record has to say is *where*.
//
// Each still-open span is closed `Abandoned` at teardown, innermost first, which
// is exactly what `std.trace`'s `drain` does to the twin's `Sink`. A twin that
// left them open would be a twin whose divergence from production is precisely
// in the failure path — which is the one place a test double must not diverge.
//
// The useful reading of the output is the innermost name: it says what the
// computation was doing when it stopped. Here it is `reserving`, and `orders` is
// its parent.

import std.trace
import std.trace (trace)

// Two spans deep, and neither is closed. In a service this is the shape a raise
// inside a request handler leaves behind; here the entry point simply returns,
// which is the same thing to the sink.
fn reserving() -> Int / {trace.write[orders]} = {
  let span = trace.enter[orders]("reserving", map_new());
  trace.event[orders](trace::Info, "reading the shelf", map_new());
  // The `trace.exit[orders](span, trace::Ok)` that belongs here is missing on
  // purpose, and `span` going unused is what a discarded continuation looks like
  // from the outside.
  3
}

fn main() -> Int / {trace.write[orders]} = {
  let outer = trace.enter[orders]("order", map_new());
  reserving()
}
