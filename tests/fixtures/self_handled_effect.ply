effect tally {
  read  base[log]() -> Int
  write note[log](what: Int) -> Unit
}

fn measured(n: Int) -> Int / {tally.read[log], tally.write[log]} = {
  let b = tally.base[log]();
  tally.note[log](n + 1);
  b + n
}

pub fn handled(n: Int) -> Int =
  handle {
    measured(n)
  } with {
    var noted = 0,
    tally.base[log]() -> 7,
    tally.note[log](what) -> {
      noted = noted + what;
    },
    return out -> out + noted,
  }

pub fn wrapper(n: Int) -> Int = handled(n)

pub fn doubled(n: Int) -> Int = n + n

test "a definition that handles all of its own effects can be called and returns its result" {
  assert_eq(handled(1), 10);
  assert_eq(wrapper(2), 12);
  assert_eq(doubled(21), 42)
}
