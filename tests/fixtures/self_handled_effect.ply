// Not a program meant to fail. It is here because until it was written, no
// corpus in this tree could exercise the compiled seam's effect gates at all:
// `benches/kernel` declares no effect, and every effectful name in `examples/`
// and in the rest of `tests/fixtures/` publishes a non-empty row, which the
// seam refuses one gate earlier. CONTRIBUTING.md §"Things known to be broken"
// item 13's third bullet is the entry that said so.
//
// `handled` performs two operations and discharges both under its own `handle`,
// so its published row is empty and *correct* — nothing escapes the call. It is
// still not enterable: a native body performs nothing, so entering it would
// lose the two atoms the interpreter records. `wrapper` is the half no per-body
// fact reaches — it is written with neither `perform` nor `handle` and performs
// anyway, because `handled` does.
//
// `crates/ply-eval/tests/differential_corpus.rs` is what reads this: with the
// nested-machine backend attached, `handled` and `wrapper` are exactly the two
// definitions a backend could answer and must not be offered.
//
// The test below calls `handled` AND `wrapper` on purpose. Entering `handled`
// loses both atoms and the two runs' footprint *sets* differ. Entering only
// `wrapper` leaves the sets equal — `handled` is called directly as well — and
// what differs is the atom count, 4 against 2. Measured: that is the message a
// per-body-only fact produces, and it is why `Trace` keeps a count beside the
// set.

effect tally {
  read  base[log]() -> Int
  write note[log](what: Int) -> Unit
}

fn measured(n: Int) -> Int / {tally.read[log], tally.write[log]} = {
  let b = tally.base[log]();
  tally.note[log](n + 1);
  b + n
}

// Empty row, and honestly so: both atoms are discharged here.
pub fn handled(n: Int) -> Int =
  with_cell[log](0) { c -> {
    let out = handle {
      measured(n)
    } with {
      tally.base[log]() -> 7,
      tally.note[log](what) -> cell_set(c, cell_get(c) + what),
    };
    out + cell_get(c)
  } }

// Empty row, no `perform`, no `handle`, and it performs.
pub fn wrapper(n: Int) -> Int = handled(n)

// The control: same shape, same argument kind, and genuinely pure.
pub fn doubled(n: Int) -> Int = n + n

test "a definition that discharges its own effects still answers" {
  assert_eq(handled(1), 10);
  assert_eq(wrapper(2), 12);
  assert_eq(doubled(21), 42)
}
