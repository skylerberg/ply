// `handled` performs two operations and discharges both under its own `handle`,
// so its published row is empty and correct: nothing escapes the call. `wrapper`
// is written with neither `perform` nor `handle` and performs anyway, because
// `handled` does.

effect tally {
  read  base[log]() -> Int
  write note[log](what: Int) -> Unit
}

fn measured(n: Int) -> Int / {tally.read[log], tally.write[log]} = {
  let b = tally.base[log]();
  tally.note[log](n + 1);
  b + n
}

// Empty row, and honestly so: both atoms are discharged here.
pub fn handled(n: Int) -> Int =
  with_cell[log](0) { c -> {
    let out = handle {
      measured(n)
    } with {
      tally.base[log]() -> 7,
      tally.note[log](what) -> cell_set(c, cell_get(c) + what),
    };
    out + cell_get(c)
  } }

// Empty row, no `perform`, no `handle`, and it performs.
pub fn wrapper(n: Int) -> Int = handled(n)

// The control: same shape, same argument kind, and genuinely pure.
pub fn doubled(n: Int) -> Int = n + n

test "a definition that discharges its own effects still answers" {
  assert_eq(handled(1), 10);
  assert_eq(wrapper(2), 12);
  assert_eq(doubled(21), 42)
}
