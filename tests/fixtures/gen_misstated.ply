// E0473, E0105: a `gen` its type cannot state, or whose function is no generator
// of the type.
//
// A type states how a sampled claim draws its values with `gen for T by f`: `f`
// answers a `std.gen` generator of the type, taking one for each of the type's
// parameters, and performs nothing but `abort.raise`. The type is a sum or a
// `new` record that binds no label and no row, and states one. Each statement
// below breaks one of those, and each refusal names which.

import std.gen
import std.gen (Gen)

type Id = Int

// An alias is the type it names: a generator for one would be for every `Int`.
fn ids() -> Gen<Int> = gen::int()

gen for Id by ids

type Even = new { n: Int }

// Another type's generator.
fn whole() -> Gen<Int> = gen::int()

gen for Even by whole

type Slot<a> = | Slot(a)

// One instantiation of the type, where a claim may be over any.
fn slots(g: Gen<Int>) -> Gen<Slot<Int>> = gen::map(g, |n: Int| Slot(n))

gen for Slot by slots

effect log {
  write note(line: String) -> Unit
}

type Loud = | Loud(Int)

// A row that performs: drawing a value writes nothing.
fn louds() -> Gen<Loud> / {log.write} = {
  log.note("drawn");
  gen::constant(Loud(1))
}

gen for Loud by louds

type Held<| e> = | Held(() -> Int / e) | Quiet

// A row parameter, which nothing says a drawn value is at.
fn helds() -> Gen<Int> = gen::int()

gen for Held by helds

type Coin = | Heads | Tails

fn coins() -> Gen<Coin> = gen::elements([Heads, Tails])

// A type has one.
gen for Coin by coins

gen for Coin by coins
