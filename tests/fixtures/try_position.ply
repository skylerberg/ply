// E0119: `?` lifts what it unwraps to the head of the statement it is written
// in, so nothing conditional may sit between the two and everything evaluated
// before it must be pure — `ply_syntax::ast::is_pure`, the predicate
// normalization uses to license reordering a run of `let`s. A `?` in a `match`
// arm would otherwise run its operand on a path that does not reach it, and
// neither the types nor the row would notice: a row is a set and does not see
// order (`docs/adr/0027-the-question-mark-operator.md`).
type DecodeError = { at: Int, why: String }

fn decode_one(n: Int) -> Result<Int, DecodeError> =
  if n < 0 { Err({at: n, why: "negative"}) } else { Ok(n) }

fn pick(n: Int, use_it: Bool) -> Result<Int, DecodeError> =
  Ok(match use_it { true -> decode_one(n)?, false -> 0 })
