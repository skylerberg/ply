import tokens (Token, Date, mint, of_ymd, text_of)

fn forged() -> Token = Token("")

fn opened(t: Token) -> String = match t { Token(s) -> s }

fn thirteenth() -> Date = { year: 2026, month: 13, day: 1 }

fn moved(d: Date) -> Date = { ..d, month: 13 }

fn year_of(d: Date) -> Int = d.year

test "a `test` with a `for` case of a `Date` with day 30 passes when asserting the day is at most 31, for day {c.day}" for c: Date in [{ year: 2026, month: 2, day: 30 }] {
  assert(c.day <= 31)
}

fn main() -> Int =
  match ((mint("a"), of_ymd(2026, 1, 2))) {
    (Some(t), Some(d)) -> text_of(t).len() + year_of(d),
    _ -> 0,
  }
