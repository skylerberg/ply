// E0107, E0220, E0418: an `opaque` type built, matched or drawn outside its module.
//
// `tokens` declares both types `opaque`, so every value of either was answered
// by one of its functions: no `Token` is empty and no `Date` has a thirteenth
// month. Each definition below would make or take apart a value without those
// functions, and each is refused where it is written. The fix is the function
// the note names: `mint`, `of_ymd`, `text_of`.
//
// Reading stays open: a `new` record's fields are read anywhere (`year_of`),
// and a whole value is compared, shown and encoded as any other is.

import tokens (Token, Date, mint, of_ymd, text_of)

fn forged() -> Token = Token("")

fn opened(t: Token) -> String = match t { Token(s) -> s }

fn thirteenth() -> Date = { year: 2026, month: 13, day: 1 }

fn moved(d: Date) -> Date = { ..d, month: 13 }

fn year_of(d: Date) -> Int = d.year

law "a drawn date has a month" forall (d: Date) { d.month >= 1 && d.month <= 12 }

test "a table of dates {c.day}" for c: Date in [{ year: 2026, month: 2, day: 30 }] {
  assert(c.day <= 31)
}

fn main() -> Int =
  match ((mint("a"), of_ymd(2026, 1, 2))) {
    (Some(t), Some(d)) -> string_len(text_of(t)) + year_of(d),
    _ -> 0,
  }
