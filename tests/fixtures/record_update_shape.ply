// E0116: expansion runs in the parser and reads only this file's `type` items
// and its written annotations, for the reason `effect set` expansion does —
// gate 1 skips a file whose bytes are unchanged, so a shape read across a module
// boundary would leave a stale expansion behind in a file that never moved. A
// stale expansion is a wrong record, not a stale name.
type Limits = { max_body: Int, max_headers: Int }

fn widen(l: Limits, n: Int) -> Int = {
  // `l` shadowed by an unannotated binder: the outer `Limits` is gone, and
  // guessing it would expand against a type this `l` does not have.
  let l = n;
  let bigger = {..l, max_body: 1};
  0
}
