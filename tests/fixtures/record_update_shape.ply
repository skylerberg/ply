// E0116: the shape comes from the type the checker infers for the base, so an
// update is only refused where that type is not a record, or where nothing in
// the program says what it is.
type Limits = { max_body: Int, max_headers: Int }

fn widen(l: Limits, n: Int) -> Int = {
  // `l` shadowed by a binder holding an `Int`: the outer `Limits` is gone, and
  // an `Int` has no fields to replace.
  let l = n;
  let bigger = {..l, max_body: 1};
  0
}

fn unknown() -> Int = {
  // Nothing calls `g`, so nothing says what `s` is.
  let g = |s| {..s, max_body: 1};
  0
}
