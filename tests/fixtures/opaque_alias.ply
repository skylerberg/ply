// E0221: `opaque` on an alias.
//
// An alias is the type it names: `Id` below is `Int` wherever it is written, so
// there is no value of its own for its module to keep the building of. A type
// that only its module builds is declared as one: `= new { .. }` for a record,
// or a sum.

pub opaque type Id = Int

fn first() -> Id = 1
