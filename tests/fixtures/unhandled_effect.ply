// E0303 at run time: this typechecks — the test simply keeps `db.read[users]`
// in its footprint — and then finds nobody to answer the operation.
effect db {
  read all[table]() -> List<Int>
}

fn user_count() -> Int / {db.read[users]} = len(db.all[users]())

test "there are three users" {
  assert_eq(user_count(), 3)
}
