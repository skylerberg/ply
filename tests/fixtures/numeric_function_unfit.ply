type Ticks = | Ticks(Int)

fn ticks(t: Ticks) -> Int = match t { Ticks(n) -> n }

fn sum(a: Ticks, b: Ticks) -> Ticks = Ticks(ticks(a) + ticks(b))

fn back(a: Ticks) -> Ticks = Ticks(0 - ticks(a))

fn whole(n: Int) -> Ticks = Ticks(n)

fn shared(a: Ticks, b: Ticks) -> Ticks / {abort.raise} = Ticks(ticks(a) / ticks(b))

numeric for Ticks by { add: sum, sub: sum, mul: shared, neg: back, of_int: whole }

type Beats = | Beats(Int)

fn joined(a: Beats, b: Beats) -> Beats = a

fn rest(a: Beats) -> Beats = a

fn counted(n: Int) -> Int = n

numeric for Beats by { add: joined, sub: joined, mul: joined, neg: rest, of_int: counted }

type Bars = | Bars(Int)

fn tied(a: Bars, b: Bars) -> Bars = a

fn held<a>(a: a) -> a = a

fn bars(n: Int) -> Bars = Bars(n)

numeric for Bars by { add: tied, sub: tied, mul: tied, neg: held, of_int: bars }
