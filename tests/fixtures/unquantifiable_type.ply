// E0418: a `forall` binder over something nothing can range over.
//
// A law nobody can ever prove is a claim nobody will ever read, so the binder is
// rejected where it is written rather than reported unproved at prove time. The
// three shapes are the three reasons:
//
//   a scoped value and a task are values only inside the scope that made them, and a
//   claim has no scope or scheduler to live in;
//
//   a function type with effects cannot be applied inside a law body
//   without making the body impure, so the binder would be unusable.
//
// A function type written without a `/ ..` has no effects and is perfectly
// quantifiable — `forall (f: (Int) -> Int)` is how map fusion is stated — so
// this is a rule about effects, not about higher order.

effect db {
  read all[table]() -> List<Int>
}

fn size(xs: List<Int>) -> Int =
  xs.len()

law "a `law` with a `forall` variable of type `Scoped<Int, [files]>` is rejected, because values of that type cannot be generated"
  forall (h: Scoped<Int, [files]>) {
    size([]) == 0
  }

law "a task is joined at most once"
  forall (t: Task<Int>) {
    size([]) == 0
  }

law "a `law` with a `forall` variable that is a function with a `db.read` effect is rejected, because such functions cannot be generated"
  forall (f: (Int) -> Int / {db.read[quotas]}) {
    size([]) == 0
  }
