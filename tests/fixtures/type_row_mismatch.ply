// E0302 and E0201: what a sum is given is part of which type it is. A `Feed` whose steps only pull
// is not one whose steps may also push, though a bare function that only pulls is admitted where
// one that may push is wanted; and a `Feed` on `line` is not a `Feed` on `spare`.
effect wire {
  read pull[l]() -> Option<Int>
  write push[l](n: Int) -> Unit
}

type Feed<[l] | e> = | Feed(() -> Option<Int> / {wire.pull[l] | e})

fn drained(f: Feed<[line] | {wire.push[line]}>) -> Int / {wire.pull[line], wire.push[line]} =
  match f { Feed(step) -> match step() { Some(n) -> n, None -> 0 } }

fn narrower(f: Feed<[line] | {}>) -> Int / {wire.pull[line], wire.push[line]} = drained(f)

fn other_label(f: Feed<[spare] | {wire.push[line]}>) -> Int / {wire.pull[line], wire.push[line]} =
  drained(f)
