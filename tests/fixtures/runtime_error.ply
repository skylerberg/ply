// E0502 at run time: an unreachable branch that turned out to be reachable.
type Posted =
  | Accepted(Int)
  | Rejected(Int)

fn amount(p: Posted) -> Int =
  match p {
    Accepted(n) -> n,
    Rejected(off) -> panic("entry off by " ++ int_to_string(off)),
  }

test "a rejected entry has no amount" {
  assert_eq(amount(Rejected(1000)), 0)
}
