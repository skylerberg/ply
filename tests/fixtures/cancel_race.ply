// A receiver is cancelled as soon as it is spawned, and the test counts on the cancel reaching it
// before it has run. Whichever comes first in the run the search starts from, it tries the other:
// the receiver takes the value, and a cancel that lands after takes the answer with it.

test "a receiver cancelled as it is spawned takes nothing" {
  simulate {
    let c = task.channel(1);
    assert(task.send(c, 7));
    let t = task.spawn(|| task.recv(c));
    task.cancel(t);
    task.await(t);
    task.close(c);
    assert_eq(task.recv(c), Some(7))
  }
}
