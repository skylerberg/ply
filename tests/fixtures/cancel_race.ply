test "a receiver cancelled right after it is spawned leaves the sent message in the channel" {
  simulate {
    let c = task.channel(1);
    assert(task.send(c, 7));
    let t = task.spawn(|| task.recv(c));
    task.cancel(t);
    task.await(t);
    task.close(c);
    assert_eq(task.recv(c), Some(7))
  }
}
