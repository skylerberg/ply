import std.process (process)

fn killed_parent() -> Unit / {process.spawn[sh]} = {
  let _ = process.spawn[sh](["-c", "sleep 1; kill -9 $PPID; sleep 5"], "", []);
  ()
}

fn double(x: Int) -> Int = x * 2

test/nondet "kills the process running it" { killed_parent() }

test "doubles" { assert_eq(double(2), 4) }

test "doubles wrongly" { assert_eq(double(2), 5) }
