// E0420: a guard that admits nothing.
//
// `guard ⟹ body` over an empty domain is valid and says nothing at all, so
// reporting it as a hold — at any tier — would turn a typo in a `where` into a
// proof of everything. A vacuous obligation is always a defect in the spec, so
// it is an error and `ply prove` exits 1 on it.
//
// Two laws, because there are two ways to establish vacuity and each deserves a
// fixture. Neither law is false; both are unchecked, which is worse, because a
// false law announces itself and an unchecked one looks green.

type Refund =
  | Full
  | Partial(Int)
  | Refused

fn refund(paid: Int, asked: Int) -> Refund =
  if asked <= 0 {
    Refused
  } else if asked >= paid {
    Full
  } else {
    Partial(asked)
  }

fn recorded_on(days: List<Int>, day: Int) -> Bool =
  match days {
    [d, ..rest] -> if d == day { true } else { recorded_on(rest, day) },
    _ -> false,
  }

// The prover shows the guard unsatisfiable inside its own fragment:
// `asked > paid && asked <= paid` is a contradiction in linear arithmetic. The
// author meant `asked > 0` for the first half and reached for the wrong name.
law "a refund larger than the payment is refused"
  forall (paid: Int, asked: Int) where asked > paid && asked <= paid {
    refund(paid, asked) == Refused
  }

// The same defect reached from the other side, where nothing decided the guard
// and the *search* is the evidence. `recorded_on([], day)` is `false` for every
// day there is: the author meant to filter on the days already in the book and
// passed the empty one. The body reaches a recursive definition so the prover
// shrugs, the property run draws its full budget and keeps not one case, and a
// directed search over the values the guard's own literals name finds nothing
// either. The count of generated cases is what says so.
//
// A guard a search merely *missed* is a different thing and is not this: a
// narrow numeric window is satisfiable, and reporting E0420 for one would state
// something false about the program and fail the build on it. That case is
// `W0604` and carries the value it found.
law "a refund on a day the empty book records is recorded against it"
  forall (days: List<Int>, day: Int) where recorded_on([], day) {
    recorded_on(push(days, day), day)
  }

test "a refund is capped at what was paid" {
  assert_eq(refund(100, 250), Full);
  assert_eq(refund(100, 40), Partial(40));
  assert_eq(refund(100, 0), Refused)
}
