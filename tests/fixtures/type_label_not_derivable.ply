// E0206, twice: a label is what a function's row performs under, so only a type that holds a
// function has a use for one, and that type has no derivation. `Tagged` binds a label no field of
// it can name, and `Kept` holds a `Tagged` that is given one.
type Tagged<a, [l]> = | Tagged(a)

type Kept = { tagged: Tagged<Int, [line]>, count: Int }

derive eq for Tagged
derive eq for Kept
