// W0607: a key supplied explicitly that the schema does not declare.
//
// A warning rather than an error, and the run continues:
//
//   $ ply run --host tests/fixtures/config_undeclared.ply \
//       --config-schema m.spec --set DESK_PROT=8138
//   W0607  --set supplies `DESK_PROT`, which the configuration schema does not declare
//          = the schema declares: DESK_PORT
//
// **Only `--set` and `--config`.** An environment is full of names that have
// nothing to do with this program — `PATH`, `AWS_PROFILE`, an exported bash
// function — and warning about those would make the warning something a reader
// learns to skip, which is the whole of its value gone. A `--set` is something
// somebody typed on purpose, and a typo in one is the classic silent deploy
// failure: the run comes up, the key it meant to set is at its default, and
// nothing says so.

import std.config
import std.config (config)

pub fn spec() -> config::ConfigSpec =
  config::spec([config::with_default("DESK_PORT", config::SInt, "8137")])

fn main() -> Option<String> / {config.read[server]} =
  config.get[server]("DESK_PORT")
