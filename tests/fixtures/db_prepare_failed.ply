// E0433: postgres refused to prepare the statement.
//
//   $ ply run --host --db postgres://localhost/desk \
//       tests/fixtures/db_prepare_failed.ply
//   E0433  relation "parts" does not exist
//
// A syntax error, an unknown relation, an unknown column, a result description
// with two columns of one name, or a description missing a column the codec
// requires. All of them are the program's fault, all of them are the same every
// time, and none will succeed on a retry — which is why this is a diagnostic
// rather than a `Failed` a program would be invited to loop on. A statement that
// *prepares* and then fails at execution is `Failed`, because that one depends
// on the data.
//
// `duplicated` is the one worth reading twice. A `Row` is a `Map<String,
// Datum>`, so `select a.id, b.id` has one key for two columns and would silently
// keep one of them. It is refused at prepare time instead, before a row moves.
//
// The two below are one fixture because the code is one code and the difference
// between them is which half of the check fired: postgres's own refusal, and the
// driver's check of the description postgres returned.

import std.db
import std.db (db)

fn unknown_relation() -> db::Stmt =
  db::stmt("select sku from parts order by sku")

fn duplicated() -> db::Stmt =
  db::stmt("select sku, sku from parts order by sku")

fn main() -> Int / {db.read[parts]} =
  match db.query[parts](unknown_relation(), []) {
    db::Rows(rows) -> len(rows),
    db::Count(n) -> n,
    db::Failed(_) -> -1,
  }
