// A `key` refused under the codes its mistake already has.
//
// E0105: a type states its key twice. One function decides equality, order and
// digest, so that they cannot disagree; a second leaves a choice.
//
// E0101: the function is not one this module declares.
//
// E0206: the key is not ordered and hashed. A key that could be compared for
// equality alone would make a type `==` reads and a `Map` cannot hold.

type Box = | Box(Int, Int)

fn area(b: Box) -> Int = match b { Box(w, h) -> w * h }

fn width(b: Box) -> Int = match b { Box(w, _) -> w }

key for Box by area

key for Box by width

type Point = | Point(Int, Int)

key for Point by distance

type Reading = | Reading(Float)

fn value(r: Reading) -> Float = match r { Reading(x) -> x }

key for Reading by value
