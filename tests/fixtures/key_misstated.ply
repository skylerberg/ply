type Box = | Box(Int, Int)

fn area(b: Box) -> Int = match b { Box(w, h) -> w * h }

fn width(b: Box) -> Int = match b { Box(w, _) -> w }

key for Box by area

key for Box by width

type Point = | Point(Int, Int)

key for Point by distance

type Reading = | Reading(Float)

fn value(r: Reading) -> Float = match r { Reading(x) -> x }

key for Reading by value
