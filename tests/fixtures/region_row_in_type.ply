// E0446, twice, and E0201: a sum hides the rows its fields write, so a field may not write one
// that reaches a region: a closure over the region's cell, or over a task, would leave unseen.
// `Counter` and `Waiter` are refused where they are declared. `Held` takes the row as a parameter
// instead, and the closure that leaves `tally`'s region in it is seen in the type it is given.
type Counter = | Counter(() -> Int / {cell.read[tally]})

type Waiter = | Waiter(() -> Int / {task.join})

type Held<| e> = | Held(() -> Int / e)

fn leaked() -> Held<| {cell.read[tally]}> = with_cell[tally](0) { c -> Held(|| cell_get(c)) }
