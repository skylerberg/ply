// E0446, three times: a sum hides the rows its fields write, so a field may not write one that
// reaches a region: a closure over the region's hold, or over a task, would leave unseen. `Counter`
// and `Waiter` are refused where they are declared. `Held` takes the row as a parameter instead,
// and the closure that leaves `tally`'s region in it is seen in the type it is given.
type Counter = | Counter(() -> Int / {hold.read[tally]})

type Waiter = | Waiter(() -> Int / {task.join})

type Held<| e> = | Held(() -> Int / e)

fn leaked() -> Held<| {hold.read[tally]}> = with_hold[tally](0, |x: Int| ()) { c -> Held(|| c.get()) }
