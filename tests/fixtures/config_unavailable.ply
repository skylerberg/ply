// E0440: a configuration source the run named could not be read.
//
// The fault is the run's configuration rather than the program's, so this
// program is correct and checks cleanly. Four shapes reach the same code, and
// each is refused before anything is bound:
//
//   $ ply run --host tests/fixtures/config_unavailable.ply --config absent.env
//   E0440  `--config absent.env` could not be read: No such file or directory
//
//   $ printf 'no equals here\n' > deploy.env
//   $ ply run --host tests/fixtures/config_unavailable.ply --config deploy.env
//   E0440  `deploy.env` line 1 is not `KEY=VALUE`: it has no `=`
//
//   $ ply run --host tests/fixtures/config_unavailable.ply --set DESK_PORT
//   E0440  `--set DESK_PORT` is not `KEY=VALUE`: it has no `=`
//
//   $ ply run --host tests/fixtures/config_unavailable.ply --config-schema m.no
//   E0440  `--config-schema m.no` names no definition in this program
//
// The format is `KEY=VALUE`, one per line, `#` at the start of a line to
// comment, and nothing else. TOML, YAML and JSON are refused for one reason:
// the effect returns `Option<String>`, so a nested typed format would carry
// structure this program cannot receive — and a format richer than the type it
// feeds is a format whose extra structure is silently dropped.
//
// A `#` after the `=` is part of the value. With no quoting there is no way to
// escape one, and a password truncated at a `#` is the failure this file format
// exists not to have.

import std.config
import std.config (config)

pub fn spec() -> config::ConfigSpec =
  config::spec([config::with_default("DESK_REGION", config::SText, "eu")])

fn main() -> Option<String> / {config.read[server]} =
  config.get[server]("DESK_REGION")
