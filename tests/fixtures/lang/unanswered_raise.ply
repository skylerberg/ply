// A raise no clause answers ends its run, as `abort.raise` does, naming the operation and what it
// carried. A clause for another raise of the effect, and a task's inherited copy of a `handle`, do
// not answer it.
//
// `raises <test> :: <text>`: the test fails with E0502 and the diagnostic carries the text,
// with the C backend as the only engine; `crates/ply-cli-tests/ply/lang_fixtures.ply` is the driver.
// raises carried :: `m.parse.bad` was raised with {at: 1, why: "not a digit"}, and nothing answers it
// raises empty :: `m.parse.eof` was raised, and nothing answers it
// raises several :: `m.parse.missing` was raised with "port", 3, and nothing answers it
// raises beside_another :: `m.parse.eof` was raised, and nothing answers it
// raises inherited :: `m.parse.bad` was raised with {at: 5, why: "not a digit"}, and nothing answers it

type Bad = { at: Int, why: String }

effect parse {
  raise bad(e: Bad)
  raise missing(key: String, line: Int)
  raise eof()
}

fn digit(b: Int) -> Int / {parse.bad} =
  if b >= 48 && b <= 57 { b - 48 } else { parse.bad({ at: b, why: "not a digit" }) }

fn end() -> Int / {parse.eof} = parse.eof()

fn lookup(key: String) -> Int / {parse.missing} = parse.missing(key, 3)

test "carried" { let _ = digit(1); () }
test "empty" { let _ = end(); () }
test "several" { let _ = lookup("port"); () }
test "beside_another" { let _ = try[parse.bad] { digit(48) + end() }; () }

test "inherited" {
  let _ = simulate {
    try {
      let t = task.spawn(|| digit(5));
      task.join(t)
    }
  };
  ()
}
