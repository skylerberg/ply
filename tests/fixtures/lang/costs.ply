// What `std.pace` counts, exactly: a call is a step, an object built is an allocation, and an update
// in place allocates nothing.

import std.pace (spent)

type Chain = | Link(Int, Chain) | End

// Each level is one call of `chain` and one `Link` built, and one call of `applied` and one of `f`.
// Neither calls anything `std.prelude` writes, so what they cost is the language's alone.

fn chain(n: Int) -> Chain = if n <= 0 { End } else { Link(n, chain(n - 1)) }

fn applied(n: Int, f: (Int) -> Int) -> Int = if n <= 0 { 0 } else { f(n) + applied(n - 1, f) }

fn squares(n: Int) -> List<Int> = range(0, n).map(|i: Int| i * i)

fn table() -> List<Int> = squares(50)

// Too wide to cross a call as its fields, a `Grown` crosses as its word, and a `Stepped` holds one in
// place, whose count is the `Stepped`'s.
type Grown = { buf: Bytes, a: Int, b: Int, c: Int, d: Int }

type Stepped = { len: Int, next: Grown }

fn stepped(g: Grown, chunk: Bytes) -> Stepped = {
  let buf = g.buf.concat(chunk);
  { len: buf.len(), next: { ..g, buf: buf } }
}

fn grown(g: Grown, chunk: Bytes, k: Int) -> Int =
  if k <= 0 { g.buf.len() } else { grown(stepped(g, chunk).next, chunk, k - 1) }

fn doubled(b: Bytes, k: Int) -> Bytes = if k <= 0 { b } else { doubled(b.concat(b), k - 1) }

test "a call is a step, a closure's call included, and an object built is an allocation" {
  let small = spent(|| chain(10));
  let large = spent(|| chain(20));
  assert_eq(large.steps - small.steps, 10);
  assert_eq(large.allocations - small.allocations, 10);
  let calling = |n: Int| spent(|| applied(n, |i: Int| i + 1));
  assert_eq(calling(10).value, 65);
  assert_eq(calling(20).steps - calling(10).steps, 20)
}

test "a constant costs what computing it costs, whether or not it was computed before" {
  let first = spent(|| table().len());
  let again = spent(|| table().len());
  assert_eq(first, again);
  assert(first.steps > 50)
}

test "a buffer handed on in a record held in place in another grows in place where nothing else holds it" {
  let chunk = doubled(b"0123456789abcdef", 6);
  let start: Grown = { buf: b"", a: 0, b: 0, c: 0, d: 0 };
  let ran = spent(|| grown(start, chunk, 256));
  assert_eq(ran.value, 256 * 1024);
  assert(ran.bytes < 8 * ran.value, Some(ran.bytes.to_string()))
}
