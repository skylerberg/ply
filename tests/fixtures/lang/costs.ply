// What `metered` counts, exactly: a call is a step, an object built is an allocation, and an atom
// performed is counted under its name.

effect db {
  read get[t](k: Int) -> Int
}

effect log {
  write line[t](text: String) -> Unit
}

fn total(xs: List<Int>) -> Int = xs.fold(0, |a: Int, x: Int| a + x)

fn squares(n: Int) -> List<Int> = range(0, n).map(|i: Int| i * i)

fn table() -> List<Int> = squares(50)

fn lookups(ks: List<Int>) -> Int / {db.get[users], log.line[audit]} = {
  log.line[audit]("looking up");
  ks.fold(0, |a: Int, k: Int| a + db.get[users](k))
}

// `map` and `fold` are calls written in Ply, each walking its list in a loop that takes a step on
// entry and one per pass, and `map` pushes each answer with `List::push`, itself a call.
test "a call costs one step, and each element a loop hands a closure costs two, three if pushed" {
  let small = metered(|| total(squares(10)));
  let large = metered(|| total(squares(20)));
  assert_eq(small.value, 285);
  // The closure `metered` enters, `total`'s and `squares`' calls, `fold`'s call, entry, eleven
  // passes and ten lambda calls, and `map`'s call, entry, eleven passes, ten lambda calls and ten
  // pushes.
  assert_eq(small.steps, 59);
  assert_eq(large.steps - small.steps, 50);
  assert_eq(small.allocations, large.allocations)
}

test "a constant costs what computing it costs, whether or not it was computed before" {
  let first = metered(|| table().len());
  let again = metered(|| table().len());
  assert_eq(first, again);
  assert(first.steps > 50)
}

test "each atom performed is counted under its name" {
  let q = handle {
    metered(|| lookups([1, 2, 3]))
  } with {
    db.get[users](k) -> k * 10,
    log.line[audit](t) -> (),
  };
  assert_eq(q.value, 60);
  assert_eq(q.performs.map(|p: { atom: String, count: Int }| p.count), [3, 1]);
  assert(
    String::ends_with(
      match q.performs.at(0) { Some(p) -> p.atom, None -> "" },
      "db.get[users]",
    ),
  )
}
