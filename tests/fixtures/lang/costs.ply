// What `metered` counts, exactly: a call is a step, an object built is an allocation, and an atom
// performed is counted under its name. The same counts on every engine that runs the program.

effect db {
  read get[t](k: Int) -> Int
}

effect log {
  write line[t](text: String) -> Unit
}

fn total(xs: List<Int>) -> Int = fold(xs, 0, |a: Int, x: Int| a + x)

fn squares(n: Int) -> List<Int> = map(range(0, n), |i: Int| i * i)

fn table() -> List<Int> = squares(50)

fn lookups(ks: List<Int>) -> Int / {db.get[users], log.line[audit]} = {
  log.line[audit]("looking up");
  fold(ks, 0, |a: Int, k: Int| a + db.get[users](k))
}

test "a call costs one step, and each element a closure sees costs one more" {
  let small = metered(|| total(squares(10)));
  let large = metered(|| total(squares(20)));
  assert_eq(small.value, 285);
  assert_eq(small.steps, 23);
  assert_eq(large.steps - small.steps, 20);
  assert_eq(small.allocations, large.allocations)
}

test "a constant costs what computing it costs, whether or not it was computed before" {
  let first = metered(|| len(table()));
  let again = metered(|| len(table()));
  assert_eq(first, again);
  assert(first.steps > 50)
}

test "each atom performed is counted under its name" {
  let q = handle {
    metered(|| lookups([1, 2, 3]))
  } with {
    db.get[users](k) -> k * 10,
    log.line[audit](t) -> (),
  };
  assert_eq(q.value, 60);
  assert_eq(map(q.performs, |p: { atom: String, count: Int }| p.count), [3, 1]);
  assert(
    string_ends_with(
      match list_at(q.performs, 0) { Some(p) -> p.atom, None -> "" },
      "db.get[users]",
    ),
  )
}
