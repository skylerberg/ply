// A width keeps its rule wherever compiled code holds the value as a word: a pattern's binders, a
// function value's answer, a closure's captures, a generic's answer and a map's value.
//
// `raises <test> :: <text>`: the test fails with E0502 and the diagnostic carries the text,
// on the machine and with the tier as the only engine; `crates/ply-cli-tests/tests/suite/lang_fixtures.rs`
// is the driver.
// raises list_add :: overflow in addition
// raises list_sub :: overflow in subtraction
// raises list_mul :: overflow in multiplication
// raises tuple_add :: overflow in addition
// raises tuple_sub :: overflow in subtraction
// raises tuple_mul :: overflow in multiplication
// raises field_add :: overflow in addition
// raises field_sub :: overflow in subtraction
// raises field_mul :: overflow in multiplication
// raises ctor_add :: overflow in addition
// raises ctor_sub :: overflow in subtraction
// raises ctor_mul :: overflow in multiplication
// raises answer_add :: overflow in addition
// raises answer_sub :: overflow in subtraction
// raises answer_mul :: overflow in multiplication
// raises capture_add :: overflow in addition
// raises capture_sub :: overflow in subtraction
// raises capture_mul :: overflow in multiplication
// raises generic_add :: overflow in addition
// raises generic_sub :: overflow in subtraction
// raises generic_mul :: overflow in multiplication
// raises map_add :: overflow in addition
// raises map_sub :: overflow in subtraction
// raises map_mul :: overflow in multiplication
// raises shift_past_the_width :: shift count out of range
// raises negate_unsigned :: overflow in negation
// raises negate_the_least :: overflow in negation
// raises divide_the_least :: overflow in division

type Pair = | Pair(I32, I32)

fn listed(xs: List<U8>, op: Int) -> U8 =
  match xs { [a, b, ..] -> if op == 0 { a + b } else if op == 1 { a - b } else { a * b }, _ -> 0u8 }

fn tupled(p: (I8, I8), op: Int) -> I8 =
  match p { (a, b) -> if op == 0 { a + b } else if op == 1 { a - b } else { a * b } }

fn fielded(r: { left: U32, right: U32 }, op: Int) -> U32 =
  match r { { left: a, right: b } -> if op == 0 { a + b } else if op == 1 { a - b } else { a * b } }

fn constructed(p: Pair, op: Int) -> I32 =
  match p { Pair(a, b) -> if op == 0 { a + b } else if op == 1 { a - b } else { a * b } }

fn answered(f: (Int) -> U8, op: Int) -> U8 = {
  let a = f(0);
  let b = f(1);
  if op == 0 { a + b } else if op == 1 { a - b } else { a * b }
}

fn captured(a: I8, b: I8, op: Int) -> I8 = {
  let f = |k: Int| if k == 0 { a + b } else if k == 1 { a - b } else { a * b };
  f(op)
}

fn nth<t>(xs: List<t>, i: Int, d: t) -> t = match list_at(xs, i) { Some(v) -> v, None -> d }

fn chosen(xs: List<U32>, op: Int) -> U32 = {
  let a = nth(xs, 0, 0u32);
  let b = nth(xs, 1, 0u32);
  if op == 0 { a + b } else if op == 1 { a - b } else { a * b }
}

fn valued(m: Map<Int, I32>, op: Int) -> I32 =
  match map_get(m, 0) {
    Some(a) -> match map_get(m, 1) {
      Some(b) -> if op == 0 { a + b } else if op == 1 { a - b } else { a * b },
      None -> a,
    },
    None -> 0i32,
  }

fn pairs(a: I32, b: I32) -> Map<Int, I32> = map_insert(map_insert(map_new(), 0, a), 1, b)

fn shifted(xs: List<U8>) -> U8 = match xs { [a, ..] -> a << 8, _ -> 0u8 }

fn negated(xs: List<U8>) -> U8 = match xs { [a, ..] -> -a, _ -> 0u8 }

fn negated_signed(xs: List<I8>) -> I8 = match xs { [a, ..] -> -a, _ -> 0i8 }

fn divided(xs: List<I8>) -> I8 = match xs { [a, b] -> a / b, _ -> 0i8 }

test "list_add" {
  let _ = listed([200u8, 100u8], 0);
  ()
}
test "list_sub" {
  let _ = listed([100u8, 200u8], 1);
  ()
}
test "list_mul" {
  let _ = listed([200u8, 100u8], 2);
  ()
}
test "tuple_add" {
  let _ = tupled((100i8, 100i8), 0);
  ()
}
test "tuple_sub" {
  let _ = tupled((-100i8, 100i8), 1);
  ()
}
test "tuple_mul" {
  let _ = tupled((100i8, 100i8), 2);
  ()
}
test "field_add" {
  let _ = fielded({ left: 4000000000u32, right: 1000000000u32 }, 0);
  ()
}
test "field_sub" {
  let _ = fielded({ left: 1u32, right: 2u32 }, 1);
  ()
}
test "field_mul" {
  let _ = fielded({ left: 100000u32, right: 100000u32 }, 2);
  ()
}
test "ctor_add" {
  let _ = constructed(Pair(2000000000i32, 2000000000i32), 0);
  ()
}
test "ctor_sub" {
  let _ = constructed(Pair(-2000000000i32, 2000000000i32), 1);
  ()
}
test "ctor_mul" {
  let _ = constructed(Pair(100000i32, 100000i32), 2);
  ()
}
test "answer_add" {
  let _ = answered(|i: Int| if i == 0 { 200u8 } else { 100u8 }, 0);
  ()
}
test "answer_sub" {
  let _ = answered(|i: Int| if i == 0 { 100u8 } else { 200u8 }, 1);
  ()
}
test "answer_mul" {
  let _ = answered(|i: Int| if i == 0 { 200u8 } else { 100u8 }, 2);
  ()
}
test "capture_add" {
  let _ = captured(100i8, 100i8, 0);
  ()
}
test "capture_sub" {
  let _ = captured(-100i8, 100i8, 1);
  ()
}
test "capture_mul" {
  let _ = captured(100i8, 100i8, 2);
  ()
}
test "generic_add" {
  let _ = chosen([4000000000u32, 1000000000u32], 0);
  ()
}
test "generic_sub" {
  let _ = chosen([1u32, 2u32], 1);
  ()
}
test "generic_mul" {
  let _ = chosen([100000u32, 100000u32], 2);
  ()
}
test "map_add" {
  let _ = valued(pairs(2000000000i32, 2000000000i32), 0);
  ()
}
test "map_sub" {
  let _ = valued(pairs(-2000000000i32, 2000000000i32), 1);
  ()
}
test "map_mul" {
  let _ = valued(pairs(100000i32, 100000i32), 2);
  ()
}
test "shift_past_the_width" {
  let _ = shifted([1u8]);
  ()
}
test "negate_unsigned" {
  let _ = negated([1u8]);
  ()
}
test "negate_the_least" {
  let _ = negated_signed([i8_of_int(-128)]);
  ()
}
test "divide_the_least" {
  let _ = divided([i8_of_int(-128), -1i8]);
  ()
}
