// The footprint the checker infers for a definition whose argument performs, and for one that
// folds an effectful function: an argument's row is the call's, and a fold threads its function's.
//
// `footprint <definition> :: <row>`: `ply check --json` reports the row for the definition, in
// this module `m`; `crates/ply-cli/tests/suite/lang_fixtures.rs` is the driver.
// footprint quiet :: {}
// footprint loud :: {m.log.write[out]}
// footprint shout :: {m.log.write[out]}

effect log {
  write note[out](line: String) -> Unit
}

fn quiet(xs: List<Int>) -> Option<Int> = list_at(xs, 0)

fn loud(xs: List<Int>) -> Option<Int> / {log.write[out]} =
  list_at(xs, { log.note[out]("asked"); 0 })

fn shout(m: Map<String, Int>) -> Int / {log.write[out]} =
  map_fold(m, 0, |acc, k, v| { log.note[out](k); acc + v })
