pub fn past_the_width() -> U8 = 1u8 << 8
pub fn over_u8() -> U8 = 200u8 + 56u8
pub fn under_u8() -> U8 = 0u8 - 1u8
pub fn over_i8() -> I8 = 127i8 + 1i8
pub fn negate_literal() -> U8 = -1u8
fn least() -> Int = 0 - 9223372036854775807 - 1
pub fn int_product() -> Int = least() * -1
pub fn int_quotient() -> Int / {abort.raise} = least() / (0 - 1)
pub fn int_remainder() -> Int / {abort.raise} = least() % (0 - 1)
pub fn u32_product() -> U32 = U32::of_int(4294967295) * 4294967295u32
pub fn i8_quotient() -> I8 / {abort.raise} = I8::of_int(-128) / I8::of_int(-1)

fn at_minus_one() -> Int = 1 << -1
fn at_sixty_four() -> Int = 1 << 64
fn arithmetic_at_sixty_four() -> Int = 1 >> 64
fn logical_at_minus_one() -> Int = 1 >>> -1
fn add() -> Int = 9223372036854775807 + 1
fn sub() -> Int = (0 - 9223372036854775807 - 1) - 1
fn mul() -> Int = 9223372036854775807 * 2

fn range_made() -> Int = range(0, 20000000).len()
fn range_folded() -> Int = range(0, 20000000).fold(0, |n: Int, _: Int| n + 1)

fn ceiling() -> Decimal = 79228162514264337593543950335m

type Pair = | Pair(I32, I32)

fn listed(xs: List<U8>, op: Int) -> U8 =
  match xs { [a, b, ..] -> if op == 0 { a + b } else if op == 1 { a - b } else { a * b }, _ -> 0u8 }

fn tupled(p: (I8, I8), op: Int) -> I8 =
  match p { (a, b) -> if op == 0 { a + b } else if op == 1 { a - b } else { a * b } }

fn fielded(r: { left: U32, right: U32 }, op: Int) -> U32 =
  match r { { left: a, right: b } -> if op == 0 { a + b } else if op == 1 { a - b } else { a * b } }

fn constructed(p: Pair, op: Int) -> I32 =
  match p { Pair(a, b) -> if op == 0 { a + b } else if op == 1 { a - b } else { a * b } }

fn answered(f: (Int) -> U8, op: Int) -> U8 = {
  let a = f(0);
  let b = f(1);
  if op == 0 { a + b } else if op == 1 { a - b } else { a * b }
}

fn captured(a: I8, b: I8, op: Int) -> I8 = {
  let f = |k: Int| if k == 0 { a + b } else if k == 1 { a - b } else { a * b };
  f(op)
}

fn nth<t>(xs: List<t>, i: Int, d: t) -> t = match xs.at(i) { Some(v) -> v, None -> d }

fn chosen(xs: List<U32>, op: Int) -> U32 = {
  let a = nth(xs, 0, 0u32);
  let b = nth(xs, 1, 0u32);
  if op == 0 { a + b } else if op == 1 { a - b } else { a * b }
}

fn valued(m: Map<Int, I32>, op: Int) -> I32 =
  match m.get(0) {
    Some(a) -> match m.get(1) {
      Some(b) -> if op == 0 { a + b } else if op == 1 { a - b } else { a * b },
      None -> a,
    },
    None -> 0i32,
  }

fn pairs(a: I32, b: I32) -> Map<Int, I32> = Map::new().insert(0, a).insert(1, b)

fn shifted(xs: List<U8>) -> U8 = match xs { [a, ..] -> a << 8, _ -> 0u8 }

fn negated(xs: List<U8>) -> U8 = match xs { [a, ..] -> -a, _ -> 0u8 }

fn negated_signed(xs: List<I8>) -> I8 = match xs { [a, ..] -> -a, _ -> 0i8 }

fn negated_wide(xs: List<U64>) -> U64 = match xs { [a, ..] -> -a, _ -> 0u64 }

fn divided(xs: List<I8>) -> I8 / {abort.raise} = match xs { [a, b] -> a / b, _ -> 0i8 }

fn summed(xs: List<U128>) -> U128 = match xs { [a, b] -> a + b, _ -> 0u128 }

test "over_u8" {
  let _ = over_u8();
  ()
}
test "under_u8" {
  let _ = under_u8();
