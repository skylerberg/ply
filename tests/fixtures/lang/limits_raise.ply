test "decimal_sum" { assert_eq(ceiling() + 1m, ceiling()) }
test "decimal_sum_again" { assert_eq(ceiling() + 1m, ceiling()) }
test "list_add" {
  let _ = listed([200u8, 100u8], 0);
  ()
}
test "list_sub" {
  let _ = listed([100u8, 200u8], 1);
  ()
}
test "list_mul" {
  let _ = listed([200u8, 100u8], 2);
  ()
}
test "tuple_add" {
  let _ = tupled((100i8, 100i8), 0);
  ()
}
test "tuple_sub" {
  let _ = tupled((-100i8, 100i8), 1);
  ()
}
test "tuple_mul" {
  let _ = tupled((100i8, 100i8), 2);
  ()
}
test "field_add" {
  let _ = fielded({ left: 4000000000u32, right: 1000000000u32 }, 0);
  ()
}
test "field_sub" {
  let _ = fielded({ left: 1u32, right: 2u32 }, 1);
  ()
}
test "field_mul" {
  let _ = fielded({ left: 100000u32, right: 100000u32 }, 2);
  ()
}
test "ctor_add" {
  let _ = constructed(Pair(2000000000i32, 2000000000i32), 0);
  ()
}
test "ctor_sub" {
  let _ = constructed(Pair(-2000000000i32, 2000000000i32), 1);
  ()
}
test "ctor_mul" {
  let _ = constructed(Pair(100000i32, 100000i32), 2);
  ()
}
test "answer_add" {
  let _ = answered(|i: Int| if i == 0 { 200u8 } else { 100u8 }, 0);
  ()
}
test "answer_sub" {
  let _ = answered(|i: Int| if i == 0 { 100u8 } else { 200u8 }, 1);
  ()
}
test "answer_mul" {
  let _ = answered(|i: Int| if i == 0 { 200u8 } else { 100u8 }, 2);
  ()
}
test "capture_add" {
  let _ = captured(100i8, 100i8, 0);
  ()
}
test "capture_sub" {
  let _ = captured(-100i8, 100i8, 1);
  ()
}
test "capture_mul" {
  let _ = captured(100i8, 100i8, 2);
  ()
}
test "generic_add" {
  let _ = chosen([4000000000u32, 1000000000u32], 0);
  ()
}
test "generic_sub" {
  let _ = chosen([1u32, 2u32], 1);
  ()
}
test "generic_mul" {
  let _ = chosen([100000u32, 100000u32], 2);
  ()
}
test "map_add" {
  let _ = valued(pairs(2000000000i32, 2000000000i32), 0);
  ()
}
test "map_sub" {
  let _ = valued(pairs(-2000000000i32, 2000000000i32), 1);
  ()
}
test "map_mul" {
  let _ = valued(pairs(100000i32, 100000i32), 2);
  ()
}
test "shift_past_the_width" {
  let _ = shifted([1u8]);
  ()
}
test "negate_unsigned" {
  let _ = negated([1u8]);
  ()
}
test "negate_unsigned_wide" {
  assert_eq(negated_wide([0u64]), 0u64);
  let _ = negated_wide([1u64]);
  ()
}
test "negate_the_least" {
  let _ = negated_signed([I8::of_int(-128)]);
  ()
}
test "divide_the_least" {
  let _ = divided([I8::of_int(-128), -1i8]);
  ()
}
test "widest_add" {
  let _ = summed([0xFFFF_FFFF_FFFF_FFFF_FFFF_FFFF_FFFF_FFFFu128, 1u128]);
  ()
}
