// The effects the checker infers for a definition whose argument performs, and for one that folds
// an effectful function: an argument's effects are the call's, and a fold adds its function's.
//
// `effects <definition> :: <effects>`: `ply check --json` reports these effects for the
// definition, in this module `m`; `tests/cli/lang_fixtures.ply` is the driver.
// effects quiet :: {}
// effects loud :: {m.log.write[out]}
// effects shout :: {m.log.write[out]}

effect log {
  write note[out](line: String) -> Unit
}

fn quiet(xs: List<Int>) -> Option<Int> = xs.at(0)

fn loud(xs: List<Int>) -> Option<Int> / {log.write[out]} =
  xs.at({ log.note[out]("asked"); 0 })

fn shout(m: Map<String, Int>) -> Int / {log.write[out]} =
  m.fold(0, |acc, k, v| { log.note[out](k); acc + v })
