// effects quiet :: {}
// effects loud :: {m.log.write[out]}
// effects shout :: {m.log.write[out]}

effect log {
  write note[out](line: String) -> Unit
}

fn quiet(xs: List<Int>) -> Option<Int> = xs.at(0)

fn loud(xs: List<Int>) -> Option<Int> / {log.write[out]} =
  xs.at({ log.note[out]("asked"); 0 })

fn shout(m: Map<String, Int>) -> Int / {log.write[out]} =
  m.fold(0, |acc, k, v| { log.note[out](k); acc + v })
