// Arithmetic at a fixed width keeps `Int`'s rule: exact, or it raises; a shift count outside the
// word and a conversion the type does not hold raise and name what they were given.
//
// `raises <test> :: <text>`: the test fails with E0502 and the diagnostic carries the text,
// on the machine and with the tier as the only engine; `crates/ply-cli/tests/suite/lang_fixtures.rs`
// is the driver.
// raises over_u8 :: overflow in addition
// raises under_u8 :: overflow in subtraction
// raises over_i8 :: overflow in addition
// raises negate_unsigned :: overflow in negation
// raises divide_by_zero :: division by zero
// raises past_the_width :: shift count out of range
// raises too_big :: was given 256
// raises negative :: was given -1
// raises past_int :: `int_of_u64` was given 18446744073709551615

pub fn past_the_width() -> U8 = 1u8 << 8
pub fn too_big() -> U8 = u8_of_int(256)
pub fn negative() -> U8 = u8_of_int(-1)
pub fn past_int() -> Int = int_of_u64(0xFFFF_FFFF_FFFF_FFFFu64)
pub fn over_u8() -> U8 = 200u8 + 56u8
pub fn under_u8() -> U8 = 0u8 - 1u8
pub fn over_i8() -> I8 = 127i8 + 1i8
pub fn negate_unsigned() -> U8 = -1u8
pub fn divide_by_zero() -> U32 = 1u32 / 0u32

test "over_u8" { let _ = over_u8(); () }
test "under_u8" { let _ = under_u8(); () }
test "over_i8" { let _ = over_i8(); () }
test "negate_unsigned" { let _ = negate_unsigned(); () }
test "divide_by_zero" { let _ = divide_by_zero(); () }
test "past_the_width" { let _ = past_the_width(); () }
test "too_big" { let _ = too_big(); () }
test "negative" { let _ = negative(); () }
test "past_int" { let _ = past_int(); () }
