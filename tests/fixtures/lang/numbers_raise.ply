// raises over_u8 :: overflow in addition
// raises under_u8 :: overflow in subtraction
// raises over_i8 :: overflow in addition
// raises negate_unsigned :: overflow in negation
// raises divide_by_zero :: division by zero
// raises past_the_width :: shift count out of range
// raises too_big :: was given 256
// raises negative :: was given -1
// raises past_int :: `Int::of_u64` was given 18446744073709551615
// raises int_product :: integer overflow in multiplication
// raises int_quotient :: integer overflow in division
// raises int_remainder :: integer overflow in remainder
// raises u32_product :: overflow in multiplication
// raises i8_quotient :: overflow in division
// raises u16_remainder_by_zero :: remainder by zero

pub fn past_the_width() -> U8 = 1u8 << 8
pub fn too_big() -> U8 / {abort.raise} = U8::of_int(256)
pub fn negative() -> U8 / {abort.raise} = U8::of_int(-1)
pub fn past_int() -> Int / {abort.raise} = Int::of_u64(0xFFFF_FFFF_FFFF_FFFFu64)
pub fn over_u8() -> U8 = 200u8 + 56u8
pub fn under_u8() -> U8 = 0u8 - 1u8
pub fn over_i8() -> I8 = 127i8 + 1i8
pub fn negate_unsigned() -> U8 = -1u8
pub fn divide_by_zero() -> U32 / {abort.raise} = 1u32 / 0u32
fn least() -> Int = 0 - 9223372036854775807 - 1
pub fn int_product() -> Int = least() * -1
pub fn int_quotient() -> Int / {abort.raise} = least() / (0 - 1)
pub fn int_remainder() -> Int / {abort.raise} = least() % (0 - 1)
pub fn u32_product() -> U32 = U32::of_int(4294967295) * 4294967295u32
pub fn i8_quotient() -> I8 / {abort.raise} = I8::of_int(-128) / I8::of_int(-1)
pub fn u16_remainder_by_zero() -> U16 / {abort.raise} = 7u16 % U16::of_int([].len())

test "over_u8" {
  let _ = over_u8();
  ()
}
test "under_u8" {
  let _ = under_u8();
  ()
}
test "over_i8" {
  let _ = over_i8();
  ()
}
test "negate_unsigned" {
  let _ = negate_unsigned();
  ()
}
test "divide_by_zero" {
  let _ = divide_by_zero();
  ()
}
test "past_the_width" {
  let _ = past_the_width();
  ()
}
test "too_big" {
  let _ = too_big();
  ()
}
test "negative" {
  let _ = negative();
  ()
}
test "past_int" {
  let _ = past_int();
  ()
}
test "int_product" {
  let _ = int_product();
  ()
}
test "int_quotient" {
  let _ = int_quotient();
  ()
}
test "int_remainder" {
  let _ = int_remainder();
  ()
}
test "u32_product" {
  let _ = u32_product();
  ()
}
test "i8_quotient" {
  let _ = i8_quotient();
  ()
}
test "u16_remainder_by_zero" {
  let _ = u16_remainder_by_zero();
  ()
}
