effect db {
  read all[t]() -> List<Int>
}

fn spin(n: Int) -> Int / {diverges} = 1 + spin(n + 1)

fn spin_first(n: Int) -> Int / {diverges} = 1 + spin_second(n + 1)

fn spin_second(n: Int) -> Int / {diverges} = 1 + spin_first(n + 1)

fn grow(n: Int) -> Int = n * 4611686018427387904

fn divide(a: Int, b: Int) -> Int / {abort.raise} = a / b

fn big() -> List<Int> = range(0, 99999999)

fn one() -> Int = 1

fn rows() -> List<Int> / {db.all[users]} = db.all[users]()

test "a runaway recursion" { assert_eq(spin(0), 0) }

test "a runaway mutual recursion" { assert_eq(spin_first(0), 0) }

test "an integer overflow" { assert_eq(grow(21), 42) }

test "a division by zero" { assert_eq(divide(1, 0), 0) }

test "a runaway range" { assert_eq(big().len(), 1) }

test "a failing assertion" { assert_eq(one(), 2) }

test/nondet "a runaway recursion in a nondet test" { assert_eq(spin(0), 0) }

test "a task that runs out of stack" {
  assert_eq(simulate { task.join(task.spawn(|| spin(0))) }, 0)
}

test "a runaway recursion in a clause body" {
  handle {
    assert_eq(rows().len(), 2)
  } with {
    db.all[users]() -> range(0, spin(1)),
  }
}

test "an overflow in a clause body" {
  handle {
    assert_eq(rows().len(), 2)
  } with {
    db.all[users]() -> range(0, 4611686018427387904 * 4),
  }
}
