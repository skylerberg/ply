// raises at_the_end :: outside a value of 3 elements
// raises past_the_end :: outside a value of 3 elements
// raises negative :: outside a value of 3 elements
// raises range_made :: exceeds the limit
// raises range_folded :: exceeds the limit

fn xs() -> List<Int> = [10, 20, 30]
fn at_the_end() -> List<Int> / {abort.raise} = xs().set(3, 0)
fn past_the_end() -> List<Int> / {abort.raise} = xs().set(4, 0)
fn negative() -> List<Int> / {abort.raise} = xs().set(0 - 1, 0)

test "at_the_end" { let _ = at_the_end(); () }
test "past_the_end" { let _ = past_the_end(); () }
test "negative" { let _ = negative(); () }

fn range_made() -> Int = range(0, 20000000).len()
fn range_folded() -> Int = range(0, 20000000).fold(0, |n: Int, _: Int| n + 1)

test "range_made" { let _ = range_made(); () }
test "range_folded" { let _ = range_folded(); () }
