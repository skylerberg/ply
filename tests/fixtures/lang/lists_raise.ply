// An index the list does not hold — negative, at the end or past it — is a diagnostic under both
// engines when written to, where `list_at` would answer `None`.
//
// `raises <test> :: <text>`: the test fails with E0502 and the diagnostic carries the text,
// on the machine and with the tier as the only engine; `crates/ply-cli-tests/tests/suite/lang_fixtures.rs`
// is the driver.
// raises at_the_end :: outside a value of 3 elements
// raises past_the_end :: outside a value of 3 elements
// raises negative :: outside a value of 3 elements

fn xs() -> List<Int> = [10, 20, 30]
fn at_the_end() -> List<Int> = list_set(xs(), 3, 0)
fn past_the_end() -> List<Int> = list_set(xs(), 4, 0)
fn negative() -> List<Int> = list_set(xs(), 0 - 1, 0)

test "at_the_end" { let _ = at_the_end(); () }
test "past_the_end" { let _ = past_the_end(); () }
test "negative" { let _ = negative(); () }
