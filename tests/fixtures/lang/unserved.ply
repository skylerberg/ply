// An operation no handler serves ends its run at the host boundary, naming it: an effect the
// program declares and no `handle` serves, on a label or none, beside one a `handle` serves.
//
// `refused <test> :: <text>`: the test fails with E0424 and the diagnostic carries the text,
// with the C backend as the only engine; `tests/cli/lang_fixtures.ply` is the driver.
// refused plain :: `m.ask.get` reached the host boundary, and nothing serves it
// refused labelled :: `m.store.put[logs]` reached the host boundary, and nothing serves it
// refused beside_another :: `m.ask.get` reached the host boundary, and nothing serves it

effect ask {
  read get() -> Int
}

effect store {
  write put[r](n: Int) -> Unit
}

effect note {
  read say() -> Int
}

test "plain" { let _ = ask.get(); () }
test "labelled" { store.put[logs](1) }
test "beside_another" { let _ = handle { note.say() + ask.get() } with { note.say() -> 1 }; () }
