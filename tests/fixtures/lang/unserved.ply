// refused plain :: `m.ask.get` reached the host boundary, and nothing serves it
// refused labelled :: `m.store.put[logs]` reached the host boundary, and nothing serves it
// refused beside_another :: `m.ask.get` reached the host boundary, and nothing serves it

effect ask {
  read get() -> Int
}

effect store {
  write put[r](n: Int) -> Unit
}

effect note {
  read say() -> Int
}

test "plain" { let _ = ask.get(); () }
test "labelled" { store.put[logs](1) }
test "beside_another" { let _ = handle { note.say() + ask.get() } with { note.say() -> 1 }; () }
