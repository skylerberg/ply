// A position outside the buffer, a negative budget, a byte that is not one and an empty separator
// are diagnostics under both engines.
//
// `raises <test> :: <text>`: the test fails with E0502 and the diagnostic carries the text,
// on the machine and with the tier as the only engine; `crates/ply-cli-tests/ply/lang_fixtures.ply`
// is the driver.
// raises past_the_end :: 
// raises negative_budget :: 
// raises not_a_byte :: 
// raises empty_separator :: 

fn past_the_end() -> Int / {abort.raise} = bytes_scan(b"abc", 9, b"a", 1)
fn negative_budget() -> Int / {abort.raise} = bytes_scan(b"abc", 0, b"a", -1)
fn not_a_byte() -> Option<Int> / {abort.raise} = bytes_index_of_byte(b"abc", 256)
fn empty_separator() -> List<Bytes> / {abort.raise} = bytes_split(b"abc", b"")

test "past_the_end" { let _ = past_the_end(); () }
test "negative_budget" { let _ = negative_budget(); () }
test "not_a_byte" { let _ = not_a_byte(); () }
test "empty_separator" { let _ = empty_separator(); () }
