// raises past_the_end :: 
// raises negative_budget :: 
// raises not_a_byte :: 
// raises empty_separator :: 

fn past_the_end() -> Int / {abort.raise} = b"abc".scan(9, b"a", 1)
fn negative_budget() -> Int / {abort.raise} = b"abc".scan(0, b"a", -1)
fn not_a_byte() -> Option<Int> / {abort.raise} = b"abc".index_of_byte(256)
fn empty_separator() -> List<Bytes> / {abort.raise} = b"abc".split(b"")

test "past_the_end" { let _ = past_the_end(); () }
test "negative_budget" { let _ = negative_budget(); () }
test "not_a_byte" { let _ = not_a_byte(); () }
test "empty_separator" { let _ = empty_separator(); () }
