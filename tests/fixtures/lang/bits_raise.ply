// A shift count outside the word raises and names the count; the operators raise where the
// wrapping builtins answer.
//
// `raises <test> :: <text>`: the test fails with E0502 and the diagnostic carries the text,
// on the machine and with the tier as the only engine; `crates/ply-cli/tests/suite/lang_fixtures.rs`
// is the driver.
// raises at_minus_one :: -1
// raises at_sixty_four :: 64
// raises arithmetic_at_sixty_four :: 64
// raises logical_at_minus_one :: -1
// raises add :: integer overflow
// raises sub :: integer overflow
// raises mul :: integer overflow

fn at_minus_one() -> Int = 1 << -1
fn at_sixty_four() -> Int = 1 << 64
fn arithmetic_at_sixty_four() -> Int = 1 >> 64
fn logical_at_minus_one() -> Int = 1 >>> -1
fn add() -> Int = 9223372036854775807 + 1
fn sub() -> Int = (0 - 9223372036854775807 - 1) - 1
fn mul() -> Int = 9223372036854775807 * 2

test "at_minus_one" { let _ = at_minus_one(); () }
test "at_sixty_four" { let _ = at_sixty_four(); () }
test "arithmetic_at_sixty_four" { let _ = arithmetic_at_sixty_four(); () }
test "logical_at_minus_one" { let _ = logical_at_minus_one(); () }
test "add" { let _ = add(); () }
test "sub" { let _ = sub(); () }
test "mul" { let _ = mul(); () }
