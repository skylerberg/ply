// A self call in tail position is a loop; any other call nests, and nesting is bounded.
//
// `raises <test> :: <text>`: the test fails with E0502 and the diagnostic carries the text,
// on the machine and with the tier as the only engine; `crates/ply-cli-tests/tests/suite/lang_fixtures.rs`
// is the driver.
// raises nesting :: recursion limit
// raises nesting_across_two_definitions :: recursion limit

fn ladder(n: Int) -> Int = if n <= 0 { 0 } else { 1 + ladder(n - 1) }
fn count(n: Int) -> Int = if n <= 0 { 0 } else { count(n - 1) }
fn ping(n: Int) -> Int = if n <= 0 { 0 } else { pong(n - 1) }
fn pong(n: Int) -> Int = if n <= 0 { 0 } else { ping(n - 1) }

test "nesting" { assert_eq(ladder(20000), 20000) }
test "nesting_across_two_definitions" { assert_eq(ping(20000), 0) }
test "looping" { assert_eq(count(20000), 0) }
