// raises left :: `m.stop.now` was performed in a task, and its handler did not resume it
// raises parked :: `m.stop.now` was performed in a task, and its handler resumes off the tail
// raises raised :: `m.fault.bad` was raised with 3, and nothing handles it

effect stop {
  write now() -> Unit
}

effect fault {
  raise bad(n: Int)
}

test "resumed" {
  let n = simulate {
    handle {
      let t = task.spawn(|| {
        stop.now();
        1
      });
      task.join(t)
    } with {
      stop.now() resume k -> k(()),
    }
  };
  assert_eq(n, 1)
}

test "left" {
  let n = simulate {
    handle {
      let t = task.spawn(|| {
        stop.now();
        1
      });
      task.join(t)
    } with {
      stop.now() resume k -> 0,
    }
  };
  assert_eq(n, 0)
}

test "parked" {
  let n = simulate {
    handle {
      let t = task.spawn(|| {
        stop.now();
        1
      });
      task.join(t)
    } with {
      stop.now() resume k -> k(()) + 1,
    }
  };
  assert_eq(n, 2)
}

test "handled" {
  let n = handle {
    simulate {
      let t = task.spawn(|| {
        fault.bad(3);
        1
      });
      task.join(t)
    }
  } with {
    fault.bad(n) -> n * 10,
  };
  assert_eq(n, 30)
}

test "raised" {
  let _ = simulate {
    handle {
      let t = task.spawn(|| {
        fault.bad(3);
        1
      });
      task.join(t)
    } with {
      fault.bad(n) -> n,
    }
  };
  ()
}
