// A task performs against the `handle`s around its spawn: a clause that leaves the `handle` another
// task opened is rejected, and a raise no clause of its own handles leaves the task, for the
// simulation to raise again where it is written.
//
// `raises <test> :: <text>`: the test fails with E0502 and the diagnostic carries the text;
// `tests/cli/lang_fixtures.ply` is the driver.
// raises left :: `m.stop.now` was performed in a task, and its handler did not resume it
// raises parked :: `m.stop.now` was performed in a task, and its handler resumes off the tail
// raises raised :: `m.fault.bad` was raised with 3, and nothing handles it

effect stop {
  write now() -> Unit
}

effect fault {
  raise bad(n: Int)
}

test "left" {
  let n = simulate {
    handle {
      let t = task.spawn(|| {
        stop.now();
        1
      });
      task.join(t)
    } with {
      stop.now() resume k -> 0,
    }
  };
  assert_eq(n, 0)
}

// A clause that resumes off its tail would stop a body the task did not begin.
test "parked" {
  let n = simulate {
    handle {
      let t = task.spawn(|| {
        stop.now();
        1
      });
      task.join(t)
    } with {
      stop.now() resume k -> k(()) + 1,
    }
  };
  assert_eq(n, 2)
}

// The clause around the spawn is not the task's.
test "raised" {
  let _ = simulate {
    handle {
      let t = task.spawn(|| {
        fault.bad(3);
        1
      });
      task.join(t)
    } with {
      fault.bad(n) -> n,
    }
  };
  ()
}
