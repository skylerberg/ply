// E0301, twice: a declared type is closed, so a row variable in one is a row parameter of its
// own. `Held` binds none; and `Thunk` binds none either, so the `e` in it is not the `e` that
// `run` binds where it uses the alias. Each wants `<| e>` after its name, and `run` a `Thunk<| e>`.
type Held = | Held(() -> Int / e)

type Thunk = () -> Int / e

fn run<| e>(t: Thunk) -> Int / e = t()
