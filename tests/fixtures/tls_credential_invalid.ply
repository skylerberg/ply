// E0430: a `--tls` credential that does not load.
//
// There is nothing wrong with this program, and there is nothing a program could
// write to produce this code — which is the point of the fixture. The material
// lives beside the run, so every way it can be broken is a way the *command* is
// broken, and each is refused before anything runs:
//
//   $ ply run --host --tls api=missing.pem,api.key   tls_credential_invalid.ply
//   E0430  `missing.pem` is not usable TLS material: it could not be read
//
//   $ ply run --host --tls api=garbage.pem,api.key   tls_credential_invalid.ply
//   E0430  `garbage.pem` is not usable TLS material: the PEM does not parse
//
//   $ ply run --host --tls api=api.pem,other.key     tls_credential_invalid.ply
//   E0430  the key in `other.key` does not go with the certificate in `api.pem`
//
// Bind time, and not the first handshake: a server that discovers its
// certificate is unusable while a client is connected has already told that
// client it was listening.

import std.net (net)

fn serve(port: Int) -> Int / {net.write[listener]} = {
  let l = net.listen_tls[listener](port, "api");
  net.close[listener](l);
  l
}

fn main() -> Int / {net.write[listener]} = serve(8443)
