type Paces = | Paces(Int)

fn more(a: Paces, b: Paces) -> Paces = a

fn back(a: Paces) -> Paces = a

fn paces(n: Int) -> Paces = Paces(n)

numeric for Paces by { add: more, sub: more, mul: more, neg: back }

type Yards = | Yards(Int)

fn longer(a: Yards, b: Yards) -> Yards = a

fn behind(a: Yards) -> Yards = a

fn yards(n: Int) -> Yards = Yards(n)

numeric for Yards by { add: longer, sub: longer, mul: longer, neg: behind, of_int: yards, div: longer }

type Miles = | Miles(Int)

fn further(a: Miles, b: Miles) -> Miles = a

fn home(a: Miles) -> Miles = a

fn miles(n: Int) -> Miles = Miles(n)

numeric for Miles by { add: further, add: further, sub: further, mul: further, neg: home, of_int: miles }
