// E0218: the function a `key` or a `show` names does not fit.
//
// `==`, `compare`, `digest` and `show` take a value and answer: they perform
// nothing, cannot raise and always return, and nothing at their call says more
// than the value does. So the function a type reads them through takes the
// value alone, at the type's own parameters, and has an empty row. Each
// definition below breaks one of those, and each refusal names which.

type Price = | Price(Int)

// A row that can raise: `==` cannot.
fn checked(p: Price) -> Int / {abort.raise} =
  match p { Price(n) -> if n < 0 { panic("a negative price") } else { n } }

key for Price by checked

type Weight = | Weight(Int)

// A second parameter no comparison has a value for.
fn scaled(w: Weight, by: Int) -> Int = match w { Weight(n) -> n * by }

key for Weight by scaled

type Slot<a> = | Slot(a)

// One instantiation of the type, where a key reads every one.
fn held(s: Slot<Int>) -> Int = match s { Slot(n) -> n }

key for Slot by held

type Label = | Label(String)

// A `show` writes text.
fn size(l: Label) -> Int = match l { Label(text) -> string_len(text) }

show for Label by size
