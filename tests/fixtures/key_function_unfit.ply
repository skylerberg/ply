type Price = | Price(Int)

fn checked(p: Price) -> Int / {abort.raise} =
  match p { Price(n) -> if n < 0 { panic("a negative price") } else { n } }

key for Price by checked

type Weight = | Weight(Int)

fn scaled(w: Weight, by: Int) -> Int = match w { Weight(n) -> n * by }

key for Weight by scaled

type Slot<a> = | Slot(a)

fn held(s: Slot<Int>) -> Int = match s { Slot(n) -> n }

key for Slot by held

type Label = | Label(String)

fn size(l: Label) -> Int = match l { Label(text) -> text.len() }

show for Label by size

effect log {
  write note[l](line: String) -> Unit
}

type Sink<[l]> = | Sink((String) -> Unit / {log.note[l]}) | Quiet

fn sounding<[l]>(s: Sink<[l]>) -> Bool = match s { Sink(_) -> true, Quiet -> false }

key for Sink by sounding
