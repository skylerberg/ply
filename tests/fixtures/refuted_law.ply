// E0419: a law with a counterexample.
//
// A remittance file arrives once a day, and once a quarter it arrives twice. So
// `settled` drops every payment whose amount repeats one already kept, which is
// the rule somebody wrote to stop a re-sent file being banked twice. The law
// below is what they believed while writing it: that the rule only ever fires on
// a genuine re-send, so nothing is lost.
//
// It is false the first time two customers pay the same amount. No proof is
// found, so the claim is tried at the few small values its binder offers, and a
// list of one amount twice is among them: the claim fails there, and that point
// is the counterexample the diagnostic prints. A point outside the `where` guard
// is never one: a value the law does not speak about refutes nothing.

fn seen(amounts: List<Int>, amount: Int) -> Bool =
  match amounts {
    [x, ..rest] -> if x == amount { true } else { seen(rest, amount) },
    _ -> false,
  }

fn settled_from(payments: List<Int>, kept: List<Int>) -> List<Int> =
  match payments {
    [p, ..rest] ->
      if seen(kept, p) { settled_from(rest, kept) } else { settled_from(rest, kept.push(p)) },
    _ -> kept,
  }

fn settled(payments: List<Int>) -> List<Int> =
  settled_from(payments, [])

law "settling a day's payments drops nothing"
  forall (payments: List<Int>) where payments.len() > 0 {
    settled(payments).len() == payments.len()
  }

test "a re-sent file is banked once" {
  assert_eq(settled([40, 40]), [40]);
  assert_eq(settled([40, 25, 40]), [40, 25])
}
