// E0312: this body's row names two `raise` operations, so the `try` has to say which it answers:
// `try[parse.bad] { .. }` lets `parse.eof` pass.
effect parse {
  raise bad(at: Int)
  raise eof()
}

fn digit(b: Int) -> Int / {parse.bad, parse.eof} =
  if b == 0 { parse.eof() } else if b < 48 { parse.bad(b) } else { b - 48 }

fn checked(b: Int) -> Result<Int, Int> = try { digit(b) }
