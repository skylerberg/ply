// E0217: a `key` or a `show` for a type that is not nominal.
//
// An alias is the type it names. `Id` below is `Int` wherever it is written, so
// a key for it would be a key for every `Int` in the program, stated by one
// module and read by all of them. A type that means something of its own is
// declared as one: a sum, whose values only its constructors make.

type Id = Int

fn text(i: Id) -> String = int_to_string(i)

key for Id by text
