// E0446, three times: a sum hides the effects its fields write, so a field may not write one that
// reaches a scope: a closure over a scoped value, or over a task, would leave unseen. `Counter`
// and `Waiter` are rejected where they are declared. `Held` takes effects as a parameter instead,
// and the closure that leaves `tally`'s scope in it is seen in the type it is given.
type Counter = | Counter(() -> Int / {scoped.read[tally]})

type Waiter = | Waiter(() -> Int / {task.join})

type Held<| e> = | Held(() -> Int / e)

fn leaked() -> Held<| {scoped.read[tally]}> = with_scope[tally](0, |x: Int| ()) { c -> Held(|| c.get()) }
