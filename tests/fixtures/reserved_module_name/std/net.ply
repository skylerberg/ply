// E0113 RESERVED_MODULE_NAME.
//
// This file's path derives the module name `std.net`, and `std` is reserved for
// the modules that ship with the compiler. Reserving it is what removes every
// precedence question: because no project module can ever be named `std.*`,
// what `import std.net` denotes cannot depend on where a file happens to sit,
// and adding a file cannot change the meaning of an unrelated module's imports.
//
// The fix is to rename the directory. `ply std` lists the names that are taken.

pub fn listen(port: Int) -> Int = port
