type Gaussian = | Gaussian(Int, Int)

numeric for Gaussian by { add: sum, sub: sum, mul: sum, neg: opposite, of_int: whole }

fn sum(a: Gaussian, b: Gaussian) -> Gaussian = a

fn opposite(a: Gaussian) -> Gaussian = a

fn whole(n: Int) -> Gaussian = Gaussian(n, 0)

fn total<a>(xs: List<a>) -> a
  where numeric(a)
= xs.fold(numeric_of_int(0), |s: a, x: a| s + x)

fn halved(a: Gaussian, b: Gaussian) -> Gaussian / {abort.raise} = a / b

fn left(a: Gaussian, b: Gaussian) -> Gaussian / {abort.raise} = a % b

fn below(a: Gaussian, b: Gaussian) -> Bool = a < b

fn next(a: Gaussian) -> Gaussian = a + 1

fn all(xs: List<Gaussian>) -> Gaussian = total(xs)
