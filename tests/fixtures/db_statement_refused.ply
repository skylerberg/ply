// E0432: statement text W4 refuses, naming the byte offset and the token.
//
//   $ ply run --host --db postgres://localhost/desk \
//       tests/fixtures/db_statement_refused.ply
//   E0432  more than one statement in a `Stmt`
//
// Three shapes are refused and each one is a different claim:
//
//   `stacked`     a `;` outside a string literal or a dollar-quoted body. One
//                 statement per `Stmt`, which removes the payload class that
//                 turns an injected fragment into a `DROP`.
//   `unmodelled`  a construct the scanner cannot account for. The scanner
//                 computes the statement's table set, and a construct it cannot
//                 read is a footprint it would have to guess at — so it refuses
//                 rather than under-reporting, which is the direction that
//                 corrupts scheduling silently.
//   `clocked`     `now()`, `current_timestamp` and `random()` in statement text.
//                 Ply has no time type; a timestamp is an `int8` the program
//                 supplies as a *parameter* from `clock.now()`, which puts the
//                 nondeterminism in the row where E0412 can see it instead of
//                 hiding it inside a string.
//
// The program's fault, and the same every time it runs, which is why it is a
// diagnostic and not a `Failed` value: a `Failed` is something a program is
// invited to swallow and retry, and none of these will ever succeed.
//
// The parameter below is the contrast. `'; drop table parts; --` as a *value*
// is stored as that string and changes no schema, because a value never becomes
// syntax; the same bytes in `sql` are this file's first refusal.

import std.db
import std.db (db)

fn stacked() -> db::Stmt =
  db::stmt("select sku from parts; drop table parts")

fn unmodelled() -> db::Stmt =
  db::stmt("select sku, count(*) from parts group by sku")

fn clocked() -> db::Stmt =
  db::stmt("insert into parts (sku, seen) values ($1, now())")

fn injected() -> db::Param = db::PText("'; drop table parts; --")

fn main() -> Int / {db.read[parts]} =
  match db.query[parts](stacked(), [injected()]) {
    db::Rows(rows) -> len(rows),
    db::Count(n) -> n,
    db::Failed(_) -> -1,
  }
