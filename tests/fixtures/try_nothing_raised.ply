// E0311: a `try` answers the one `raise` operation its body's row names, and this body names
// none. What can fail on a value raises `abort.raise`, which a `try` answers only by name.
effect parse {
  raise bad(at: Int)
}

fn total(xs: List<Int>) -> Result<Int, Int> = try { len(xs) }

fn mean(xs: List<Int>) -> Result<Int, String> / {abort.raise} = try { len(xs) / len(xs) }
