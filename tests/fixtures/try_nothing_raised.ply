// E0311: a `try` handles the one `raise` operation its body's effects name, and this body names
// none. What can fail on a value raises `abort.raise`, which a `try` handles only by name.
effect parse {
  raise bad(at: Int)
}

fn total(xs: List<Int>) -> Result<Int, Int> = try { xs.len() }

fn mean(xs: List<Int>) -> Result<Int, String> / {abort.raise} = try { xs.len() / xs.len() }
