type Length = | Metres(Int) | Millimetres(Int)

key for Length by millimetres

fn millimetres(l: Length) -> Int = match l { Metres(n) -> n * 1000, Millimetres(n) -> n }

type Cut = { name: String, length: Length }

fn cuts() -> List<Cut> =
  [{ name: "a", length: Metres(1) }, { name: "a", length: Millimetres(1000) }]

test "each `Length` case {l} equals `Metres(2)`" for l: Length in [Metres(2), Millimetres(2000)] {
  assert(l == Metres(2))
}

test "each `Cut` case {c.length} has a `name` field equal to `a`" for c: Cut in cuts() {
  assert(c.name == "a")
}
