fn main() -> Int = 0

fn counted(i: Int) -> Int = with_hold[work](i, |x: Int| ()) { c -> c.get() + 1 }

pub fn churn(n: Int) -> Int / {task.write, abort.raise} =
  range(0, n).fold(0, |sum: Int, i: Int| {
    task.spawn(|| counted(i));
    let t = task.spawn(|| counted(i));
    task.yield();
    sum + task.join(t)
  })

pub fn fired(n: Int) -> Int / {task.write} =
  range(0, n).fold(0, |sum: Int, i: Int| {
    task.spawn(|| counted(i));
    task.yield();
    sum + i
  })
