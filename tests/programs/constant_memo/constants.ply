fn main() -> Int = 0

fn made(n: Int, kept: List<List<Int>>) -> List<List<Int>> =
  if n <= 0 { kept } else { made(n - 1, kept.push(range(0, 20))) }

pub fn constant() -> Int = made(400, []).len()

pub fn parameterized(ignored: Int) -> Int = made(400, []).len()

pub fn reads(n: Int, sum: Int) -> Int = if n <= 0 { sum } else { reads(n - 1, sum + constant()) }

pub fn probe_constant() -> Int = constant() + constant()

pub fn probe_reads() -> Int = reads(1000, 0)
