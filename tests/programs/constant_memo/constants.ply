effect store {
  read peek() -> Int
}

fn main() -> Int = 0

fn filled(xs: Array<Int>, i: Int) -> Array<Int> =
  if i < 0 || i >= xs.len() { xs } else { filled(xs.set(i, i), i + 1) }

pub fn constant() -> Int = filled(Array::of_list([0, 0, 0, 0, 0, 0, 0, 0]), 0).len()

pub fn parameterized(ignored: Int) -> Int =
  filled(Array::of_list([0, 0, 0, 0, 0, 0, 0, 0]), 0).len()

pub fn declares_unused_effect() -> Int / {store.read} =
  filled(Array::of_list([0, 0, 0, 0, 0, 0, 0, 0]), 0).len()

pub fn reads(n: Int, sum: Int) -> Int = if n <= 0 { sum } else { reads(n - 1, sum + constant()) }

pub fn probe_constant() -> Int = constant() + constant()

pub fn probe_parameterized() -> Int = parameterized(0) + parameterized(0)

pub fn probe_over_declared() -> Int / {store.read} =
  declares_unused_effect() + declares_unused_effect()

pub fn probe_reads() -> Int = reads(1000, 0)
