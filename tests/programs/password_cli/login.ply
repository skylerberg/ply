import std.password
import std.password (kdf, ValidNeedsRehash)

pub fn admits(stored: String, supplied: Secret<String>) -> Bool / {kdf.read, abort.raise} =
  password::verify(stored, supplied, password::owasp_argon2id()) == ValidNeedsRehash

test "a stored hash verifies" {
  assert(
    admits(
      "$argon2id$v=19$m=64,t=1,p=2$c29tZXNhbHQ$JOf2h4fID94lhr843SM7qQ",
      Secret::of_string("correct horse battery staple"),
    ),
  )
}

test "a login under `password::fake_kdf` succeeds without running the real key derivation" {
  let secret = Secret::of_string("correct horse");
  let admitted = try {
    password::fake_kdf(||
      admits(password::hash_with_salt(secret, password::owasp_argon2id(), b"saltsalt"), secret))
  };
  assert_eq(admitted, Ok(true))
}
