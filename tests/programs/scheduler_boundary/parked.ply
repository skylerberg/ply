effect amb {
  read flip[coin]() -> Bool
}

type Saved = | Done(Int) | Resumable(once (Bool) -> Saved)

fn main() -> Int = 0

pub fn suspended() -> Saved / {abort.raise} =
  handle {
    let b = amb.flip[coin]();
    Done(if b { 41 } else { 0 })
  } with {
    amb.flip[coin]() resume k -> Resumable(k),
  }

fn resume_it(s: keep Saved) -> Int =
  match s { Resumable(k) -> match k(true) { Done(n) -> n, Resumable(again) -> 0 }, Done(n) -> n }

pub fn add_resumed_result(n: Int) -> Int / {abort.raise} = n + resume_it(suspended())

fn simulated<a | e>(on: (Task<Int>) -> a / e) -> a / {sim.read | e} =
  simulate { on(task.spawn(|| 1)) }

pub fn spawned() -> Option<Task<Int>> / {sim.read} = simulated(|t: Task<Int>| Some(t))

fn joined<a>(x: a, wait: (a) -> Int / {task.join, abort.raise}) -> Int / {sim.read, abort.raise} =
  simulate {
    let mine = task.spawn(|| 2);
    wait(x) + task.join(mine)
  }

pub fn join_spawned_task() -> Int / {sim.read, abort.raise} =
  match spawned() { Some(t) -> joined(t, |h: Task<Int>| task.join(h)), None -> 0 }
