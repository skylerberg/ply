import std.fs
import std.fs (fs)
import std.io (io, reading, close_source, fold_lines)

pub fn count(
  path: String,
) -> Int / {fs.open[data], fs.read_chunk[data], fs.close[data], io.fail, io.too_long, io.closed, abort.raise} =
  with_scope[file](
    reading[data](path),
    close_source,
  ) { source -> fold_lines(source, 65536, 1000000, 0, |n: Int, line: Bytes| n + 1) }

test "a file's lines are counted over the fake file system" {
  let tree = fs::mem_of([{ path: "a.txt", body: b"one\ntwo\nthree" }]);
  assert_eq(fs::on_mem[data](tree, || count("a.txt")).value, 3)
}
