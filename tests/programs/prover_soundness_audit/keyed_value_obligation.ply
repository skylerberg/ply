import std.laws (idempotent)

type Length = | Metres(Int) | Millimetres(Int)
key for Length by millimetres
fn millimetres(l: Length) -> Int = match l { Metres(n) -> n * 1000, Millimetres(n) -> n }
fn in_metres(l: Length) -> Bool = match l { Metres(_) -> true, Millimetres(_) -> false }
fn normalized(l: Length) -> Length = Millimetres(millimetres(l))
type Wrapped = | Wrapped(Length)
type Plain = | Plain(Int)
fn number(p: Plain) -> Int = match p { Plain(n) -> n }

law "constructors that differ are unequal"
  forall (n: Int) where n > -9 && n < 9 {
    Metres(n) != Millimetres(n * 1000)
  }
law "equal lengths are built alike"
  forall (a: Length, b: Length) {
    !(a == b) || in_metres(a) == in_metres(b)
  }
law "visible binder" forall (a: Length) { a == a }
law "visible container" forall (xs: List<Length>) { xs == xs }
law "hidden in a variant" forall (h: Wrapped) { h == h }
law "hidden behind an option" forall (o: Option<Wrapped>) { o == o }
law "written out" forall (x: Length) { normalized(normalized(x)) == normalized(x) }
law "instantiated" = idempotent(normalized)
law "a type that states none" forall (a: Plain, b: Plain) { !(a == b) || number(a) == number(b) }
