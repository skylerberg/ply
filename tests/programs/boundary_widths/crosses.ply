type Byte = | Byte(U8)
type Word = { w: U32 }
type Sample = { level: I16, label: String }

fn main() -> Int = 0

pub fn narrows(n: Int) -> U32 / {abort.raise}
  requires n >= 0
  ensures Int::of_u32(result) == n
= U32::of_int(n)
pub fn widens(w: U32) -> Int
  requires Int::of_u32(w) > 0
= Int::of_u32(w)
pub fn boxed(n: Int) -> Word / {abort.raise} = { w: U32::of_int(n) }
pub fn negated(b: I8) -> I8 = -b
pub fn doubled(w: U32) -> U32 = wrap_add(w, w)
pub fn flipped(w: U64) -> U64 = w ^ 1u64
pub fn bytes(n: Int) -> List<U8> / {abort.raise} =
  range(0, n).map(|i: Int| U8::of_int(i * 100 % 256))
pub fn summed(xs: List<U8>) -> Int =
  xs.fold(0, |accumulator: Int, x: U8| accumulator + Int::of_u8(x))
pub fn sample(n: Int) -> Sample / {abort.raise} = { level: I16::of_int(n), label: "s" }
pub fn level(s: Sample) -> I16 = s.level
pub fn wrap(b: U8) -> Byte = Byte(b)
pub fn unwrap(b: Byte) -> U8 = match b { Byte(x) -> x }
pub fn first<a>(xs: List<a>) -> Option<a> = match xs { [x, ..] -> Some(x), _ -> None }
pub fn made<a>(make: () -> a) -> a = make()
pub fn sum_numbers<a>(xs: List<a>) -> a
  where numeric(a)
= xs.fold(numeric_of_int(0), |s: a, x: a| s + x)
pub fn halved<a>(x: a) -> a / {abort.raise}
  where integer(a)
= x / numeric_of_int(2)
