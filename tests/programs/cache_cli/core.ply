pub type Money = Int

pub type Item = | Book(String, Money) | Note(String)

pub effect db {
  read get[r](key: Int) -> Int
  write put[r](key: Int, value: Int) -> Int
}

pub fn price(i: Item) -> Money = match i { Book(_, p) -> p, Note(_) -> 0 }

pub fn label(i: Item) -> String = match i { Book(t, _) -> t, Note(t) -> t }

test "a note is free" { assert_eq(price(Note("n")), 0) }
