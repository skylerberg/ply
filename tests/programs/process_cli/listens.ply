import std.process (process)
import std.signal (signal)

fn told(name: String, arrived: Bool) -> Unit / {process.out[proc]} =
  if arrived { process.out[proc]("got " ++ name) } else { () }

fn watch(turns: Int) -> Unit / {signal.read, signal.write, process.out[proc], clock.sleep} =
  if turns <= 0 || signal.stopping() { () } else {
    told("hangup", signal.hangup());
    told("user1", signal.user1());
    told("user2", signal.user2());
    told("resized", signal.resized());
    clock.sleep(Duration(10000000));
    watch(turns - 1)
  }

fn main() -> Unit / {signal.read, signal.write, process.out[proc], clock.sleep} = {
  let asked = [signal.hangup(), signal.user1(), signal.user2(), signal.resized()];
  process.out[proc](if asked.filter(|a: Bool| a).len() == 0 { "ready" } else { "early" });
  watch(12000)
}
