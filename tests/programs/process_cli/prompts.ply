import std.process
import std.process (process, pipe)

fn main() -> Unit / {process.read[proc], process.write[proc], pipe.broken} = {
  process::write_out[proc](b"name: ");
  let name = match process.line[proc]() { Some(line) -> line, None -> "nobody" };
  let rest = process.in_bytes[proc](100);
  process.out[proc]("hello " ++ name ++ ", and " ++ rest.len().to_string() ++ " bytes follow");
  process.exit[proc](0)
}
