import std.json

pub type Catalogue = { prices: Map<Decimal, String> }
derive json for Catalogue

fn from_catalogue() -> Catalogue = { prices: Map::new().insert(1.50m, "bolt").insert(2.00m, "nut") }

fn after_promotion() -> Catalogue = { prices: from_catalogue().prices.insert(1.5m, "bolt") }

fn from_shelf() -> Catalogue =
  { prices: Map::new().insert(1.5m, "bolt").insert(2m, "nut").insert(1.50m, "bolt") }

fn body(c: Catalogue) -> String / {abort.raise} =
  String::of_bytes(json::encode_bytes(c, catalogue_json()))

test "equal decimal-keyed maps encode to the same JSON, with keys written as 1.50 and 2.00" {
  assert_eq(from_catalogue(), after_promotion());
  assert_eq(body(from_catalogue()), body(after_promotion()));
  assert_eq(
    body(after_promotion()),
    "{\"prices\":[{\"key\":1.50,\"value\":\"bolt\"},{\"key\":2.00,\"value\":\"nut\"}]}",
  )
}

test "an equal decimal-keyed map built from differently written numbers encodes keys as 1.5 and 2" {
  assert_eq(from_shelf(), from_catalogue());
  assert_eq(
    body(from_shelf()),
    "{\"prices\":[{\"key\":1.5,\"value\":\"bolt\"},{\"key\":2,\"value\":\"nut\"}]}",
  )
}
