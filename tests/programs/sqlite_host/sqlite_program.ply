import std.process (process)
import std.sql (statement_of, TextParameter, Row)
import std.string
import std.sqlite
import std.sqlite (sqlite, sql, Busy, Rejected, Unopened, Create, ReadOnly, ReadWrite, Limits,
                   Options)

fn large_limits() -> Limits =
  { sql_bytes: 10000, params: 100, rows: 100000, bytes: 10000000, steps: 1000000 }

fn plain() -> Options = { strict: true, busy_ms: 50, statements: 8 }

fn s(text: String) -> sqlite::Bound / {sql.fail, abort.raise} =
  sqlite::bound(statement_of(text), [])

fn rejection<a | e>(go: () -> a / {sql.fail | e}) -> String / e =
  match try[sql.fail] { go() } {
    Ok(_) -> "ran",
    Err(Busy) -> "busy",
    Err(Rejected(_)) -> "refused",
    Err(Unopened(_)) -> "unopened",
    Err(_) -> "other",
  }

fn names<[d], [r]>(
  conn: Scoped<sqlite::Connection<[d]>, [r]>,
) -> List<String> / {scoped.read[r], sqlite.query[d], sql.fail, abort.raise} =
  sqlite::query(conn, s("select name from person order by id"), large_limits()).map(|row: Row|
    sqlite::text(row, "name"))

pub fn round_trip() -> List<String> / {sqlite.read[app], sqlite.write[app], sql.fail, abort.raise} = {
  with_scope[first](sqlite::opening[app]("data.db", Create, plain()), |c|
    sqlite::close(c)) { conn -> {
    sqlite::execute(
      conn,
      s("create table person (id integer primary key, name text not null) strict"),
      large_limits(),
    );
    sqlite::transaction(conn, || {
      sqlite::execute(
        conn,
        sqlite::bound(statement_of("insert into person (name) values (?1)"), [
          TextParameter("Ada"),
        ]),
        large_limits(),
      );
      sqlite::execute(
        conn,
        sqlite::bound(statement_of("insert into person (name) values (?1)"), [
          TextParameter("Grace"),
        ]),
        large_limits(),
      )
    })
  } };
  with_scope[second](sqlite::opening[app]("data.db", ReadOnly, plain()), |c|
    sqlite::close(c)) { conn -> names(conn) }
}

pub fn opens(path: String) -> String / {sqlite.read[app], sqlite.write[app], abort.raise} =
  rejection(||
    with_scope[opened_at](sqlite::opening[app](path, Create, plain()), |c|
      sqlite::close(c)) { conn ->
      sqlite::execute(conn, s("create table if not exists t (n integer) strict"), large_limits())
    })

pub fn backs_up(path: String) -> String / {sqlite.read[app], sqlite.write[app], abort.raise} =
  rejection(||
    with_scope[source](sqlite::opening[app]("data.db", ReadWrite, plain()), |c|
      sqlite::close(c)) { conn -> sqlite::backup(conn, path) })

pub fn unbound() -> String / {sqlite.read[nowhere], sqlite.write[nowhere], abort.raise} =
  rejection(||
    with_scope[nowhere_db](sqlite::opening[nowhere]("x.db", Create, plain()), |c|
      sqlite::close(c)) { conn -> 0 })

pub fn left_open() -> Int / {sqlite.read[app], sqlite.write[app], sql.fail, abort.raise} = {
  let conn = sqlite::opening[app]("left.db", Create, plain());
  with_scope[left](conn, |_: sqlite::Connection<[app]>| ()) { held -> {
    sqlite::execute(held, s("create table if not exists t (n integer) strict"), large_limits());
    sqlite::execute(held, s("insert into t values (1)"), large_limits()).rows
  } }
}

fn asked(
  scenario: List<String>,
) -> String / {sqlite.read[app], sqlite.write[app], sqlite.read[nowhere], sqlite.write[nowhere], sql.fail, abort.raise} =
  match scenario {
    ["round_trip"] -> String::join(round_trip(), ","),
    ["opens", path] -> opens(path),
    ["backs_up", path] -> backs_up(path),
    ["unbound"] -> unbound(),
    ["left_open"] -> left_open().to_string(),
    _ -> panic("no such scenario: " ++ String::join(scenario, " ")),
  }

fn scenarios(args: List<String>) -> List<List<String>> = {
  let split = args.fold(
    { done: [], open: [] },
    |s: { done: List<List<String>>, open: List<String> }, a: String|
      if a == "+" { { done: s.done.push(s.open), open: [] } }
      else { { ..s, open: s.open.push(a) } },
  );
  split.done.push(split.open)
}

fn main() -> Unit / {process.args[proc], process.out[proc], sqlite.read[app], sqlite.write[app], sqlite.read[nowhere], sqlite.write[nowhere], abort.raise} =
  scenarios(process.args[proc]()).fold((), |u: Unit, scenario: List<String>|
    process.out[proc]("handle " ++ rejection_or(|| asked(scenario))))

fn rejection_or<| e>(go: () -> String / {sql.fail | e}) -> String / e =
  match try[sql.fail] { go() } { Ok(said) -> said, Err(_) -> "the engine rejected" }
