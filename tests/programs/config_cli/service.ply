import std.config
import std.config (config)

pub fn spec() -> config::ConfigSpec =
  config::spec([
    config::with_default("SERVICE_REGION", config::SText, "us"),
    config::required("SERVICE_PORT", config::SInt),
    config::required("SERVICE_API_KEY", config::SSecret),
  ])

pub fn region() -> Option<String> / {config.get[server]} = config.get[server]("SERVICE_REGION")

fn main() -> Option<String> / {config.get[server]} = region()

// A `det` test supplies its own values: the effects after the handle are empty, so
// this runs, caches and passes.
test "a handled read reaches no host" {
  let fixture = config::one_value("SERVICE_REGION", "twin");
  handle {
    assert_eq(region(), Some("twin"))
  } with {
    config.get[server](k) -> config::get_value(fixture, k),
  }
}
