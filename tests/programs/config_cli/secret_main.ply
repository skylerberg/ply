import std.config
import std.config (config)

pub fn spec() -> config::ConfigSpec =
  config::spec([config::required("SERVICE_API_KEY", config::SSecret)])

fn main() -> Bool / {config.read[credentials]} =
  match config.secret[credentials]("SERVICE_API_KEY") {
    None -> false,
    Some(key) -> key.verify("correct-horse"),
  }
