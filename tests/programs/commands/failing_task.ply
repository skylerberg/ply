effect note {
  read say() -> Int
}
effect unhandled_effect {
  read what() -> Int
}

fn work() -> Int / {unhandled_effect.read} = unhandled_effect.what()

fn main() -> Int / {task.write, unhandled_effect.read, abort.raise} =
  handle {
    handle {
      let t = task.spawn(|| work());
      task.join(t)
    } with {
      note.say() -> 42,
    }
  } with {
    note.say() -> 41,
  }
