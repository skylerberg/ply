effect note {
  read say() -> Int
}
effect other {
  read what() -> Int
}

fn work() -> Int / {other.read} = other.what()

fn main() -> Int / {task.write, other.read, abort.raise} =
  handle {
    handle {
      let t = task.spawn(|| work());
      task.join(t)
    } with {
      note.say() -> 42,
    }
  } with {
    note.say() -> 41,
  }
