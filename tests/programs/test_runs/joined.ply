effect tally {
  write bump[r](by: Int) -> Unit
  read total[r]() -> Int
}

fn fill_left() -> Int / {tally.bump[left], task.yield} = {
  tally.bump[left](1);
  task.yield();
  tally.bump[left](2);
  3
}

fn fill_right() -> Int / {tally.bump[right], task.yield} = {
  tally.bump[right](4);
  task.yield();
  tally.bump[right](5);
  9
}

test "what the joined tasks wrote is read after the joins" {
  handle {
    simulate {
      let a = task.spawn(|| fill_left());
      let b = task.spawn(|| fill_right());
      assert_eq(task.join(a) + task.join(b), 12);
      assert_eq(tally.total[left](), 3);
      assert_eq(tally.total[right](), 9)
    }
  } with {
    var l = 0,
    var r = 0,
    tally.bump[left](n) -> {
      l = l + n;
    },
    tally.bump[right](n) -> {
      r = r + n;
    },
    tally.total[left]() -> l,
    tally.total[right]() -> r,
  }
}
