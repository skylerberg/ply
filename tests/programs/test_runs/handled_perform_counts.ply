effect counter {
  read tick[c]() -> Int
}

fn twice() -> Int / {counter.read[c]} = counter.tick[c]() + counter.tick[c]()

test "ticks" { assert_eq(handle { twice() } with { counter.tick[c]() -> 1 }, 2) }

test "pure" { assert_eq(1 + 1, 2) }

effect tally {
  write bump(n: Int) -> Unit
  read peek() -> Int
}

fn bumped(times: Int) -> Unit / {tally.bump} =
  range(0, times).fold((), |_: Unit, i: Int| tally.bump(i))

test "handled" {
  let got = handle {
    bumped(9);
    tally.peek()
  } with {
    tally.bump(n) -> (),
    tally.peek() -> 7,
  };
  assert_eq(got, 7)
}

test "resumed" {
  let got = handle {
    bumped(9);
    tally.peek()
  } with {
    tally.bump(n) resume k -> k(()),
    tally.peek() resume k -> k(7),
  };
  assert_eq(got, 7)
}

test "stopped" {
  let got = handle {
    bumped(9);
    tally.peek()
  } with {
    tally.bump(n) resume k -> if n == 2 { 0 } else { k(()) },
    tally.peek() -> 7,
  };
  assert_eq(got, 0)
}
