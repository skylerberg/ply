fn spin(n: Int) -> Int = range(0, n).fold(0, |a: Int, x: Int| (a + x * x) % 1000003)

fn work(seed: Int) -> Int = {
  let both = parallel { spin(5000000), spin(5000001) };
  (seed + both._0 + both._1) % 1000003
}

test "one" { assert(work(1) >= 0) }

test "two" { assert(work(2) >= 0) }

test "three" { assert(work(3) >= 0) }

test "four" { assert(work(4) >= 0) }

test "five" { assert(work(5) >= 0) }

test "six" { assert(work(6) >= 0) }

test "seven" { assert(work(7) >= 0) }

test "eight" { assert(work(8) >= 0) }
