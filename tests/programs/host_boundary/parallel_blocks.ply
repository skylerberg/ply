import std.process (process)
import std.time (time)

effect meter {
  read level() -> Int
}

effect counter {
  write next() -> Int
}

fn spin(n: Int) -> Int = range(0, n).fold(0, |a: Int, x: Int| (a + x * x) % 1000003)

fn work(seed: Int) -> Int = (seed + spin(9000000)) % 1000003

fn stamped(seed: Int) -> Int / {time.elapsed_ms} = {
  let at = time.elapsed_ms();
  work(seed + at % 2)
}

fn levelled() -> (Int, Int) / {meter.level} =
  parallel { work(1) * 0 + meter.level(), meter.level() }

fn counted() -> (Int, Int) =
  handle {
    handle { levelled() } with { meter.level() -> counter.next() }
  } with {
    var n = 0,
    counter.next() -> {
      n = n + 1;
      n
    },
  }

pub fn main() -> Unit / {process.out[proc], time.elapsed_ms} = {
  let began = time.elapsed_ms();
  let one = stamped(1);
  let started = time.elapsed_ms();
  let four = parallel { stamped(1), stamped(2), stamped(3), stamped(4) };
  let ended = time.elapsed_ms();
  let count = counted();
  process.out[proc](
    "alone " ++ (started - began).to_string() ++ "\ntogether " ++ (ended - started).to_string()
      ++ "\ncounted "
      ++ count._0.to_string()
      ++ " "
      ++ count._1.to_string()
      ++ "\nsum "
      ++ (one + four._0 + four._1 + four._2 + four._3).to_string()
      ++ "\n",
  )
}
