effect ask {
  read get() -> Int
}

fn now() -> Int / {clock.read} = match clock.now() { Instant(at) -> at }

test/nondet "the task reads the handle around its spawn after it ended" {
  let t = handle {
    task.spawn(|| {
      task.yield();
      (now(), ask.get())
    })
  } with {
    ask.get() -> 7,
  };
  let ended = now();
  let answered = task.join(t);
  assert(ended <= answered._0, None);
  assert_eq(answered._1, 7)
}
