//! `search` — the interleavings a plan runs. `Once` and `Random` run one seed per root; `Dpor` starts
//! each root from its own schedule and branches, at each scheduling point, to every task whose step
//! conflicts with a later one it did not already observe, so it runs one schedule per way the
//! conflicting steps can be ordered rather than one per interleaving.

import plan (Seed, Plan, Once, Random, Dpor, normalized, seeds, seed_text)
import recording (Step, Interleaving, Verdict, Passed, Failed, footprints_conflict, contention,
                  access_text, happens_before)
import std.list (concat, index_of, take)

/// Whether two steps of different tasks are ordered by what they touch, or always.
pub type Dependence = | Exact | All

/// What a search run beside the pruned one explored; `bounded` when a spent budget or a failure
/// stopped it short of its frontier, so the count is a lower bound.
pub type Cost = { explored: Int, bounded: Bool }

pub type RaceSite = {
  task: Int,
  definition: Option<String>,
  access: String,
  span: { module: Int, start: Int, end: Int },
}

/// Two steps whose reordering at scheduling point `at` turned a pass into a failure.
pub type Race = { left: RaceSite, right: RaceSite, at: Int }

/// `exhaustive` when every interleaving ran, up to reordering steps that do not conflict;
/// `exhausted` when the budget was spent; `virtual_time` the last interleaving's.
pub type Exploration = {
  explored: Int,
  exhaustive: Bool,
  exhausted: Bool,
  naive: Option<Cost>,
  blind: Option<Cost>,
  steps: Int,
  virtual_time: Int,
  failure: Option<Seed>,
  race: Option<Race>,
}

pub fn cacheable(e: Exploration) -> Bool = e.failure == None && !e.exhausted

/// Why a search stopped at a seed: the run failed; the recording names no schedule, which is Ply's
/// defect; or a replay did not take the schedule the seed names.
pub type Cause<f> =
  | RunFailed(f)
  | Unscheduled({ seed: Seed, span: { module: Int, start: Int, end: Int }, what: String })
  | Diverged({ seed: Seed, span: { module: Int, start: Int, end: Int }, what: String })

/// `notes` say why only a less pruned search reached the failure.
pub type Failure<f> = { cause: Cause<f>, notes: List<String> }

pub type Explored<f> = { exploration: Exploration, failure: Option<Failure<f>>, seeds: List<Seed> }

pub fn passed<f>(e: Explored<f>) -> Bool = e.exploration.failure == None

/// What the run a search stopped at failed with, when it was the run that failed rather than its
/// recording or its replay.
pub fn run_failure<f>(fl: Failure<f>) -> Option<f> =
  match fl.cause { RunFailed(f) -> Some(f), _ -> None }

/// Interleavings `measure_reduction` lets the searches beside the pruned one run.
pub fn naive_budget() -> Int = 4096

fn no_exploration() -> Exploration =
  {
    explored: 0,
    exhaustive: false,
    exhausted: false,
    naive: None,
    blind: None,
    steps: 0,
    virtual_time: 0,
    failure: None,
    race: None,
  }

/// One interleaving a caller ran, and what it keeps across the runs of a search.
pub type RunAnswer<f, s> = { run: Interleaving<f>, state: s }

pub type Kept<f, s> = { explored: Explored<f>, state: s }

pub fn explore<f | e>(
  plan: Plan,
  run: (Seed) -> Interleaving<f> / e,
) -> Explored<f> / {abort.raise | e} = explore_under(plan, Exact, run)

pub fn explore_under<f | e>(
  plan: Plan,
  dependence: Dependence,
  run: (Seed) -> Interleaving<f> / e,
) -> Explored<f> / {abort.raise | e} =
  explore_keeping(plan, dependence, (), |u: Unit, seed: Seed| { run: run(seed), state: u }).explored

/// `explore_under`, threading the caller's `state` through every run in the order they run.
pub fn explore_keeping<f, s | e>(
  plan: Plan,
  dependence: Dependence,
  state: s,
  run: (s, Seed) -> RunAnswer<f, s> / e,
) -> Kept<f, s> / {abort.raise | e} = {
  let n = normalized(plan);
  match n.mode { Dpor -> searched(n, dependence, state, run), _ -> sampled(n, state, run) }
}

/// The search again with every clock withheld and again with every pair dependent, filling `blind`
/// and `naive`. Each prunes less than the pruned search, so a failure only one of them reaches is
/// one the pruning skipped, and is the run's.
pub fn measure_reduction<f | e>(
  plan: Plan,
  run: (Seed) -> Interleaving<f> / e,
) -> Explored<f> / {abort.raise | e} =
  measure_keeping(plan, (), |u: Unit, seed: Seed| { run: run(seed), state: u }).explored

/// `measure_reduction`, threading the caller's `state` through the three searches in turn.
pub fn measure_keeping<f, s | e>(
  plan: Plan,
  state: s,
  run: (s, Seed) -> RunAnswer<f, s> / e,
) -> Kept<f, s> / {abort.raise | e} = {
  let first = explore_keeping(plan, Exact, state, run);
  let explored = first.explored;
  if plan.mode != Dpor || explored.exploration.failure != None { first } else {
    let measuring = { ..plan, budget: max(plan.budget, naive_budget()) };
    let blinded = explore_keeping(measuring, Exact, first.state, |st: s, seed: Seed| {
      let r = run(st, seed);
      { run: unclocked(r.run), state: r.state }
    });
    let blind = blinded.explored;
    let naived = explore_keeping(measuring, All, blinded.state, run);
    let naive = naived.explored;
    let costed = {
      ..explored.exploration,
      blind: Some(cost_of(blind)),
      naive: Some(cost_of(naive)),
    };
    let skipped = [
      {
        by: blind,
        why: "this interleaving was reached only with every step's vector clock withheld, so the pruned search skipped it: a step's recorded clock claims it observed a step it did not",
      },
      {
        by: naive,
        why: "this interleaving was reached only with the dependence relation forced to true, so the pruned search skipped it: a step's recorded footprint is missing an access it made",
      },
    ];
    let out = match filter(skipped, |k: { by: Explored<f>, why: String }| !passed(k.by)) {
      [missed, ..] ->
        {
          exploration: {
            ..costed,
            failure: missed.by.exploration.failure,
            race: missed.by.exploration.race,
            exhaustive: false,
          },
          failure: match missed.by.failure {
            Some(fl) -> Some({ ..fl, notes: push(fl.notes, missed.why) }),
            None -> None,
          },
          seeds: explored.seeds,
        },
      [] -> { ..explored, exploration: costed },
    };
    { explored: out, state: naived.state }
  }
}

fn unclocked<f>(i: Interleaving<f>) -> Interleaving<f> =
  { ..i, steps: map(i.steps, |s: Step| { ..s, stamp: [] }) }

fn cost_of<f>(m: Explored<f>) -> Cost =
  { explored: m.exploration.explored, bounded: m.exploration.exhausted || !passed(m) }

// --- One seed per root ------------------------------------------------------

type Sampling<f, s> = {
  exploration: Exploration,
  failure: Option<Failure<f>>,
  seeds: List<Seed>,
  done: Bool,
  state: s,
}

fn sampled<f, s | e>(
  plan: Plan,
  state: s,
  run: (s, Seed) -> RunAnswer<f, s> / e,
) -> Kept<f, s> / e = {
  let out = fold(
    seeds(plan),
    { exploration: no_exploration(), failure: None, seeds: [], done: false, state: state },
    |acc: Sampling<f, s>, seed: Seed|
      if acc.done { acc } else {
        let ran = run(acc.state, seed);
        let r = ran.run;
        let e = {
          ..acc.exploration,
          explored: acc.exploration.explored + 1,
          steps: acc.exploration.steps + len(r.steps),
          virtual_time: r.virtual_time,
        };
        let next = { ..acc, exploration: e, seeds: push(acc.seeds, seed), state: ran.state };
        match recording_checked(seed, r.steps) {
          Some(cause) ->
            {
              ..next,
              exploration: { ..e, failure: Some(seed) },
              failure: Some({ cause: cause, notes: [] }),
              done: true,
            },
          None -> match r.verdict {
            Failed(f) ->
              {
                ..next,
                exploration: { ..e, failure: Some(seed) },
                failure: Some({ cause: RunFailed(f), notes: [] }),
                done: true,
              },
            Passed -> next,
          },
        }
      },
  );
  {
    explored: { exploration: out.exploration, failure: out.failure, seeds: out.seeds },
    state: out.state,
  }
}

// --- The search ---------------------------------------------------------------

fn searched<f, s | e>(
  plan: Plan,
  dependence: Dependence,
  state: s,
  run: (s, Seed) -> RunAnswer<f, s> / e,
) -> Kept<f, s> / {abort.raise | e} = {
  let out = fold(
    plan.roots,
    {
      exploration: { ..no_exploration(), exhaustive: true },
      failure: None,
      seeds: [],
      done: false,
      state: state,
    },
    |acc: Sampling<f, s>, root: U64|
      if acc.done { acc } else {
        let reached = root_searched(root, plan.budget, dependence, acc.state, run);
        let report = reached.report;
        let e = {
          ..acc.exploration,
          explored: acc.exploration.explored + report.explored,
          steps: acc.exploration.steps + report.steps,
          virtual_time: report.virtual_time,
          exhausted: acc.exploration.exhausted || report.exhausted,
          exhaustive: acc.exploration.exhaustive && !report.exhausted,
        };
        let seen = {
          ..acc,
          exploration: e,
          seeds: concat(acc.seeds, report.seeds),
          state: reached.state,
        };
        match report.failure {
          None -> seen,
          Some(fl) ->
            {
              ..seen,
              exploration: { ..e, failure: Some(fl.seed), race: fl.race, exhaustive: false },
              failure: Some({ cause: fl.cause, notes: [] }),
              done: true,
            },
        }
      },
  );
  {
    explored: { exploration: out.exploration, failure: out.failure, seeds: out.seeds },
    state: out.state,
  }
}

/// The run a queued interleaving branched off, the point where it diverges, the choice it takes
/// there, and the step it meant to reorder against the one at that point.
type Branch = { trace: List<Step>, at: Int, choice: Int, against: Option<Int> }

type Work = { path: List<Int>, branch: Option<Branch> }

/// Last in, first out, as the search takes its work.
type Stack<a> = | Empty | Pushed(a, Stack<a>)

type RootFailure<f> = { seed: Seed, cause: Cause<f>, race: Option<Race> }

type Root<f> = {
  explored: Int,
  steps: Int,
  virtual_time: Int,
  exhausted: Bool,
  failure: Option<RootFailure<f>>,
  seeds: List<Seed>,
}

/// Every (prefix, choice) the search has run or queued, by the prefix's bytes.
type Claimed = Map<Bytes, Map<Int, Bool>>

type Searching<f, s> = { frontier: Stack<Work>, claimed: Claimed, report: Root<f>, state: s }

fn root_searched<f, s | e>(
  root: U64,
  budget: Int,
  dependence: Dependence,
  state: s,
  run: (s, Seed) -> RunAnswer<f, s> / e,
) -> { report: Root<f>, state: s } / {abort.raise | e} = {
  let start = {
    frontier: Pushed({ path: [], branch: None }, Empty),
    claimed: map_new(),
    report: { explored: 0, steps: 0, virtual_time: 0, exhausted: false, failure: None, seeds: [] },
    state: state,
  };
  // Each pass runs one interleaving, so the budget bounds the passes.
  iterate(start, budget + 2, |st: Searching<f, s>|
    match st.frontier {
      Empty -> Stop({ report: st.report, state: st.state }),
      Pushed(work, rest) -> if st.report.explored >= budget {
        Stop({ report: { ..st.report, exhausted: true }, state: st.state })
      } else { Continue(stepped({ ..st, frontier: rest }, root, work, dependence, run)) },
    })
}

/// One pass: the work's interleaving runs, and what it reveals is queued or ends the root.
fn stepped<f, s | e>(
  st: Searching<f, s>,
  root: U64,
  work: Work,
  dependence: Dependence,
  run: (s, Seed) -> RunAnswer<f, s> / e,
) -> Searching<f, s> / {abort.raise | e} = {
  let seed = { root: root, path: work.path };
  let ran = run(st.state, seed);
  let r = ran.run;
  let report = {
    ..st.report,
    explored: st.report.explored + 1,
    steps: st.report.steps + len(r.steps),
    virtual_time: r.virtual_time,
    seeds: push(st.report.seeds, seed),
  };
  let ended = |cause: Cause<f>, race: Option<Race>|
    {
      frontier: Empty,
      claimed: st.claimed,
      report: { ..report, failure: Some({ seed: seed, cause: cause, race: race }) },
      state: ran.state,
    };
  match recording_checked(seed, r.steps) {
    Some(cause) -> ended(cause, None),
    None -> match match work.branch { Some(b) -> replay_checked(seed, b, r.steps), None -> None } {
      Some(cause) -> ended(cause, None),
      None -> match r.verdict {
        Failed(f) -> ended(RunFailed(f), match work.branch { Some(b) -> race_of(b), None -> None }),
        Passed -> branched({ ..st, report: report, state: ran.state }, r.steps, dependence),
      },
    },
  }
}

fn choices_of(steps: List<Step>) -> List<Int> = map(steps, |s: Step| s.choice)

fn key_of(prefix: List<Int>) -> Bytes / {abort.raise} =
  bytes_concat_all(
    map(prefix, |c: Int| bytes_concat(byte_of_int(c & 255), byte_of_int(c >> 8 & 255))),
  )

/// Claims `choice` after `key`, answering whether it was unclaimed.
fn claim(claimed: Claimed, key: Bytes, choice: Int) -> { claimed: Claimed, fresh: Bool } = {
  let taken = match map_get(claimed, key) { Some(t) -> t, None -> map_new() };
  if map_contains(taken, choice) { { claimed: claimed, fresh: false } }
  else { { claimed: map_insert(claimed, key, map_insert(taken, choice, true)), fresh: true } }
}

/// Claims every choice the run took, then queues each backtrack nothing claimed yet.
fn branched<f, s>(
  st: Searching<f, s>,
  trace: List<Step>,
  dependence: Dependence,
) -> Searching<f, s> / {abort.raise} = {
  let choices = choices_of(trace);
  let prefixes = fold(
    range(0, len(trace)),
    { claimed: st.claimed, key: b"" },
    |acc: { claimed: Claimed, key: Bytes }, i: Int|
      match list_at(trace, i) {
        None -> acc,
        Some(step) -> {
          let c = claim(acc.claimed, acc.key, step.choice).claimed;
          { claimed: c, key: bytes_concat(acc.key, key_of([step.choice])) }
        },
      },
  );
  map_fold(
    backtracks(trace, dependence),
    { ..st, claimed: prefixes.claimed },
    |acc: Searching<f, s>, at: Int, tasks: Map<Int, Option<Int>>| {
      let prefix = take(choices, at);
      let key = key_of(prefix);
      let enabled = match list_at(trace, at) { Some(s) -> s.enabled, None -> [] };
      map_fold(tasks, acc, |inner: Searching<f, s>, task: Int, against: Option<Int>|
        match index_of(enabled, task) {
          None -> inner,
          Some(choice) -> {
            let c = claim(inner.claimed, key, choice);
            if !c.fresh { { ..inner, claimed: c.claimed } } else {
              {
                ..inner,
                claimed: c.claimed,
                frontier: Pushed(
                  {
                    path: push(prefix, choice),
                    branch: Some({ trace: trace, at: at, choice: choice, against: against }),
                  },
                  inner.frontier,
                ),
              }
            }
          },
        })
    },
  )
}

/// Per scheduling point, the tasks worth resuming there instead, each beside the step it reorders
/// against when it was enabled at that point.
pub fn backtracks(steps: List<Step>, dependence: Dependence) -> Map<Int, Map<Int, Option<Int>>> = {
  let n = len(steps);
  fold(range(1, n), map_new(), |out: Map<Int, Map<Int, Option<Int>>>, back: Int| {
    let i = n - back;
    match list_at(steps, i) {
      None -> out,
      Some(later) ->
        fold(range(0, i), out, |acc: Map<Int, Map<Int, Option<Int>>>, down: Int| {
          let j = i - 1 - down;
          match list_at(steps, j) {
            None -> acc,
            Some(earlier) ->              // Regions run one after another, and a task's own steps are program order.
              if earlier.region != later.region || earlier.task == later.task { acc }
              else if !dependent(dependence, earlier, later) { acc }
              else if dependence == Exact && happens_before(earlier, later) { acc } else {
                let at = match map_get(acc, j) { Some(m) -> m, None -> map_new() };
                let marked = if index_of(earlier.enabled, later.task) != None {
                  recorded(at, later.task, Some(i))
                } else {
                  fold(earlier.enabled, at, |m: Map<Int, Option<Int>>, t: Int| recorded(m, t, None))
                };
                map_insert(acc, j, marked)
              },
          }
        }),
    }
  })
}

fn dependent(d: Dependence, a: Step, b: Step) -> Bool =
  match d { Exact -> footprints_conflict(a.accesses, b.accesses), All -> true }

/// A concrete pair is never overwritten, so a conservative branch never erases a real race.
fn recorded(at: Map<Int, Option<Int>>, task: Int, against: Option<Int>) -> Map<Int, Option<Int>> =
  match map_get(at, task) { Some(Some(_)) -> at, _ -> map_insert(at, task, against) }

fn race_of(b: Branch) -> Option<Race> =
  match b.against {
    None -> None,
    Some(against) -> match ((list_at(b.trace, b.at), list_at(b.trace, against))) {
      (Some(left), Some(right)) -> match ((site(left, right), site(right, left))) {
        (Some(l), Some(r)) -> Some({ left: l, right: r, at: b.at }),
        _ -> None,
      },
      _ -> None,
    },
  }

fn site(step: Step, other: Step) -> Option<RaceSite> =
  match contention(step.accesses, other.accesses) {
    [first, ..] ->
      Some({
        task: step.task,
        definition: step.site.definition,
        access: access_text(first),
        span: step.site.span,
      }),
    [] -> None,
  }

// --- What a recording must be ---------------------------------------------------

fn task_text(t: Int) -> String = "@" ++ int_to_string(t)

fn tasks_text(ts: List<Int>) -> String =
  if len(ts) == 0 { "{}" } else {
    fold(ts, "", |acc: String, t: Int|
      if acc == "" { task_text(t) } else { acc ++ ", " ++ task_text(t) })
  }

/// A recording that is not a schedule: everything concluded from it would rest on it.
fn recording_checked<f>(seed: Seed, steps: List<Step>) -> Option<Cause<f>> =
  fold(range(0, len(steps)), None, |found: Option<Cause<f>>, i: Int|
    match found {
      Some(_) -> found,
      None -> match list_at(steps, i) {
        None -> None,
        Some(step) -> if len(step.enabled) > 65535 {
          Some(
            Unscheduled({
              seed: seed,
              span: step.site.span,
              what: "scheduling point " ++ int_to_string(i) ++ " offered "
                ++ int_to_string(len(step.enabled))
                ++ " enabled tasks, and a seed's choice sequence cannot name more than 65535",
            }),
          )
        } else if list_at(step.enabled, step.choice) == Some(step.task) { None } else {
          Some(
            Unscheduled({
              seed: seed,
              span: step.site.span,
              what: "scheduling point " ++ int_to_string(i) ++ " resumed " ++ task_text(step.task)
                ++ " as choice "
                ++ int_to_string(step.choice)
                ++ ", which its enabled set "
                ++ tasks_text(step.enabled)
                ++ " does not offer",
            }),
          )
        },
      },
    })

/// A replay of a prefix must offer the enabled set the recording did at every point it names.
fn replay_checked<f>(seed: Seed, b: Branch, steps: List<Step>) -> Option<Cause<f>> =
  fold(range(0, b.at + 1), None, |found: Option<Cause<f>>, point: Int|
    match found {
      Some(_) -> found,
      None -> match list_at(b.trace, point) {
        None -> None,
        Some(expected) -> match list_at(steps, point) {
          None ->
            Some(
              Diverged({
                seed: seed,
                span: expected.site.span,
                what: "the run stopped after " ++ int_to_string(len(steps))
                  ++ " scheduling points, and this seed names a choice at point "
                  ++ int_to_string(point),
              }),
            ),
          Some(actual) -> if actual.enabled != expected.enabled {
            Some(
              Diverged({
                seed: seed,
                span: expected.site.span,
                what: "at scheduling point " ++ int_to_string(point)
                  ++ " the recorded enabled set was "
                  ++ tasks_text(expected.enabled)
                  ++ " and the replay offered "
                  ++ tasks_text(actual.enabled),
              }),
            )
          } else {
            let wanted = if point == b.at { b.choice } else { expected.choice };
            if actual.choice == wanted { None } else {
              Some(
                Diverged({
                  seed: seed,
                  span: expected.site.span,
                  what: "at scheduling point " ++ int_to_string(point) ++ " this seed names choice "
                    ++ int_to_string(wanted)
                    ++ " and the replay took "
                    ++ int_to_string(actual.choice),
                }),
              )
            }
          },
        },
      },
    })
