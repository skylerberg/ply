// `recording` — what one interleaving did, as the runtime records it: each scheduling point, what
// the step after it touched, and how the run ended.

// An effect's atom: `write` or `read`, on a resource or a singleton, naming an operation or a mode.
pub type Atom = { effect: String, resource: Option<String>, write: Bool, op: Option<String> }

// What a step touched. A cell is named by its slot, which the order allocations run in decides, so
// two allocations always conflict.
pub type Access = | AAtom(Atom) | ACell({ index: Int, generation: Int, write: Bool }) | AAlloc

pub fn conflicts(a: Access, b: Access) -> Bool =
  match ((a, b)) {
    (AAtom(x), AAtom(y)) ->
      x.effect == y.effect && x.resource == y.resource && (x.write || y.write),
    (ACell(x), ACell(y)) ->
      x.index == y.index && x.generation == y.generation && (x.write || y.write),
    (AAlloc, AAlloc) -> true,
    _ -> false,
  }

pub fn footprints_conflict(xs: List<Access>, ys: List<Access>) -> Bool =
  fold(xs, false, |found: Bool, x: Access|
    found || fold(ys, false, |f: Bool, y: Access| f || conflicts(x, y)))

// What `xs` touched that `ys` conflicts with, in `xs`'s order.
pub fn contention(xs: List<Access>, ys: List<Access>) -> List<Access> =
  filter(xs, |x: Access| fold(ys, false, |f: Bool, y: Access| f || conflicts(x, y)))

pub fn access_text(a: Access) -> String =
  match a {
    AAtom(x) -> {
      let what = match x.op { Some(op) -> op, None -> if x.write { "write" } else { "read" } };
      x.effect ++ "." ++ what ++ (match x.resource { Some(r) -> "[" ++ r ++ "]", None -> "" })
    },
    ACell(c) ->
      "cell." ++ (if c.write { "write" } else { "read" }) ++ "[@" ++ int_to_string(c.index) ++ "."
        ++ int_to_string(c.generation)
        ++ "]",
    AAlloc -> "cell.alloc",
  }

// Where a step's own code stood when it was taken.
pub type Site = { definition: Option<String>, span: { module: Int, start: Int, end: Int } }

// One scheduling point: the region and task it resumed, every task it could have resumed in the
// scheduler's order, which of them it took, what the step touched, where, and the acting task's
// vector clock: which earlier steps of each task it had observed.
pub type Step = {
  region: Int,
  task: Int,
  enabled: List<Int>,
  choice: Int,
  accesses: List<Access>,
  site: Site,
  stamp: List<Int>,
}

// How a run ended, in the terms of whoever ran it.
pub type Verdict<f> = | Passed | Failed(f)

// `virtual_time` is the nanoseconds of virtual time the run consumed.
pub type Interleaving<f> = { steps: List<Step>, verdict: Verdict<f>, virtual_time: Int }

// `later`'s task had observed `earlier`'s step, through the spawns and joins between them.
pub fn happens_before(earlier: Step, later: Step) -> Bool =
  if len(earlier.stamp) == 0 || len(later.stamp) == 0 { false } else {
    let mine = match list_at(earlier.stamp, earlier.task) { Some(n) -> n, None -> 0 };
    let theirs = match list_at(later.stamp, earlier.task) { Some(n) -> n, None -> 0 };
    mine > 0 && theirs >= mine
  }

test "cells conflict where one writes the slot, and two allocations always" {
  let cell = |i: Int, w: Bool| ACell({ index: i, generation: 0, write: w });
  assert(conflicts(cell(1, true), cell(1, false)));
  assert(!conflicts(cell(1, false), cell(1, false)));
  assert(!conflicts(cell(1, true), cell(2, true)));
  assert(conflicts(AAlloc, AAlloc));
  let atom = |r: String, w: Bool|
    AAtom({ effect: "random", resource: Some(r), write: w, op: None });
  assert(conflicts(atom("a", true), atom("a", false)));
  assert(!conflicts(atom("a", true), atom("b", true)));
  assert_eq(contention([cell(1, true), cell(2, false)], [cell(1, false)]), [cell(1, true)]);
  assert_eq(access_text(cell(3, true)), "cell.write[@3.0]")
}

test "a step happened before another when the other's clock has seen it" {
  let step = |task: Int, stamp: List<Int>|
    {
      region: 0,
      task: task,
      enabled: [task],
      choice: 0,
      accesses: [],
      site: { definition: None, span: { module: 0, start: 0, end: 0 } },
      stamp: stamp,
    };
  assert(happens_before(step(0, [1, 0]), step(1, [1, 1])));
  assert(!happens_before(step(0, [2, 0]), step(1, [1, 1])));
  assert(!happens_before(step(0, []), step(1, [1, 1])))
}
