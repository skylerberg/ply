// The arithmetic half of the hazard fixtures: `Int` in, `Int` or `Bool` out, no
// declared effects, so this is the module the fragment compiles and the boundary
// offers. Every other module here calls into it, which is what puts a native
// body underneath a cell, a handler, a `simulate` region and a recursion the
// machine is about to bound.

pub fn step(n: Int) -> Int = (n * 3 + 1) % 1000

pub fn mix(a: Int, b: Int) -> Int = (a * 31 + b * 17) % 100003

pub fn even(n: Int) -> Bool = n % 2 == 0

// Two failures the fragment can reach, and both must arrive as the machine's own
// diagnostic rather than as `RUNTIME_ERROR` at `Span::DUMMY`: `mix` overflows on
// a large argument, `share` divides by zero.
pub fn share(a: Int, b: Int) -> Int = a / b

// Nullary, and fallible. The empty-`slots` half of the sticky-failure hazard:
// the failure block answers handle `0`, which is `slots[0]`, and reading it with
// nothing pushed is a panic that takes the host process. Its body has to contain
// an operation that emits a check, or there is no branch to take.
pub fn seeded() -> Int = 7 * 11 + 3

// Compiled recursion, deliberately not in tail position so that neither engine
// can turn it into a loop and skip the bound this exists to test.
pub fn ladder(n: Int, acc: Int) -> Int =
  if n <= 0 { acc } else { 1 + ladder(n - 1, (acc * 3 + 1) % 1000) }
