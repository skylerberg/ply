// The hazard ADR 0018 §0 states as "no `Float` path", at its real width.
//
// The fragment lowers `+ - * / %` as `Int` arithmetic and `< <= > >=` through
// `as_int` whatever the operands are, so `Float`, `Decimal` and `String` are all
// in it — and only the `Float` arithmetic half has ever been written down. Two
// shapes, because they are refused by different things:
//
//   * a non-scalar *signature*, which the registration filter refuses and the
//     value boundary refuses again;
//   * a non-scalar *literal inside an `Int` -> `Int` body*, which neither can
//     see. Nothing about `float_inside`'s type says it compares two `Float`s, so
//     if the fragment answered rather than failing on one, the answer would be
//     wrong and this boundary could not tell.
//
// The audit's third case, ordering on `String`, is **not here**: it does not
// typecheck. `E0201` refuses `a < b` on `String` before any backend sees it, so
// the run-time support in `interp.rs` is unreachable from a well-typed program.
// `tests/fixtures/string_ordering/` holds the program and the refusal.

pub fn fadd(a: Float, b: Float) -> Float = a + b

pub fn fless(a: Float, b: Float) -> Bool = a < b

pub fn dadd(a: Decimal, b: Decimal) -> Decimal = a + b

pub fn dless(a: Decimal, b: Decimal) -> Bool = a < b

pub fn float_inside(n: Int) -> Int = if 1.5 + 1.5 > 2.0 { n } else { n * 2 }

pub fn decimal_inside(n: Int) -> Int = if 1.5m + 1.5m > 2.0m { n } else { n * 2 }

pub fn float_arith_inside(n: Int) -> Int = if 0.1 + 0.2 == 0.3 { n } else { n * 2 }
