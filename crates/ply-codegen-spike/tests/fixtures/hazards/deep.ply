// Interpreted recursion with a native body at every depth.
//
// `countdown` lives here rather than in `pure` so that the compiled unit does
// not hold it: the recursion is the *machine's*, and it drops into compiled code
// once per frame — `pure::mix` is evaluated on the way *in*, so ten thousand
// entries have been taken by the time the bound fires. That is the half of the
// nested-call hazard the audit calls unobserved: before R5 a crossing went
// through `Machine::call`, which resets `stack.calls()`, so a
// compiled<->interpreted cycle was bounded by neither engine.
//
// Not in tail position, so nothing can turn the recursion into a loop.

import pure

pub fn countdown(n: Int, acc: Int) -> Int =
  if n <= 0 { acc } else { 1 + countdown(n - 1, pure::mix(acc, n)) }
