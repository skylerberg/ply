// A `simulate` region with a real race in it, and one compiled call outside it.
//
// `ply_eval::Machine::compiled_answer` turns the hook off while `sims` is
// non-empty, so every `Access` a partial-order search reads is still the
// interpreter's. This is the fixture that says so by running: the entry count
// must move by exactly the calls made *outside* the region, and the schedule,
// the answer and the footprint must be what the same machine produces with no
// backend at all.

import pure

pub fn raced(n: Int) -> Int / {sim.read} = {
  let base = pure::step(n);
  with_cell[shared](base) { c -> {
    simulate {
      let a = task.spawn(|| cell_set(c, cell_get(c) + pure::step(n)));
      let b = task.spawn(|| cell_set(c, cell_get(c) + pure::mix(n, 3)));
      task.join(a);
      task.join(b);
      cell_get(c)
    }
  } }
}
