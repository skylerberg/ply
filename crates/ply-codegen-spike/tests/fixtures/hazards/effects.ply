// A native body underneath a live handler stack.
//
// Before R5 a compiled function reaching an uncompiled one called `Machine::call`
// on a second machine, which runs `reset()`: the handler stack, the trail and the
// region generations of whatever was underneath went with it, and a `perform` in
// the callee would have fallen through to the host. There is no second machine
// now — a call leaving the unit refuses the caller — so this exists to check the
// remaining direction: the interpreter performing, handling and resuming with
// compiled bodies running inside the handled block.

import pure

effect tally {
  read  base[r]() -> Int
  write note[r](what: Int) -> Unit
}

fn measured(n: Int) -> Int / {tally.read[log], tally.write[log]} = {
  let b = tally.base[log]();
  tally.note[log](pure::step(n));
  pure::mix(b, n)
}

pub fn handled(n: Int) -> Int =
  with_cell[log](0) { c -> {
    let out = handle {
      measured(n)
    } with {
      tally.base[log]() -> 7,
      tally.note[log](what) -> cell_set(c, cell_get(c) + what),
    };
    pure::mix(out, cell_get(c))
  } }
