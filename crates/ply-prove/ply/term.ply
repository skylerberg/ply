//! `term` — the prover's term language: one hash-consed DAG per obligation.

import domain (Ty, Con, Record)
import sort (bool_ty, decimal_ty, field_ty, int_ty, is_con, string_ty, unit_ty)

/// The names the prover gives operators it does not interpret. One each for the shifts: `-1 >> 1`
/// and `-1 >>> 1` differ, and a shared name would equate them.
pub fn op_add() -> String = "(+)"
pub fn op_sub() -> String = "(-)"
pub fn op_mul() -> String = "(*)"
pub fn op_div() -> String = "(/)"
pub fn op_rem() -> String = "(%)"
pub fn op_concat() -> String = "(++)"
pub fn op_bit_and() -> String = "(&)"
pub fn op_bit_or() -> String = "(|)"
pub fn op_bit_xor() -> String = "(^)"
pub fn op_bit_not() -> String = "(~)"
pub fn op_shl() -> String = "(<<)"
pub fn op_shr() -> String = "(>>)"
pub fn op_ushr() -> String = "(>>>)"
pub fn op_lt() -> String = "(<)"
pub fn op_le() -> String = "(<=)"
pub fn op_gt() -> String = "(>)"
pub fn op_ge() -> String = "(>=)"

pub type CmpOp = | Lt | Le | Gt | Ge

pub type Mono = { term: Int, coeff: I128 }

/// `Σ coeff · term + konst`, ascending by term, with no zero coefficient and no nested `TLin`.
pub type Poly = { monomials: List<Mono>, konst: I128 }

pub type ArmTest =
  | Always
  | TestCtor(String)
  | TestLit(Int)
  /// `fixed` heads, then a rest or the end of the list.
  | TestList({ fixed: Int, rest: Bool })
  /// A nested constructor or record pattern.
  | Undecidable

/// `binds` has one term per constructor field, in field order.
pub type Arm = { test: ArmTest, binds: List<Int>, body: Int }

pub type Node =
  | TInt(Int)
  | TBool(Bool)
  | TStr(String)
  /// Compared by value, so `1.5m` and `1.50m` are one node.
  | TDecimal(Decimal)
  /// Distinct from `TInt`: `5` and `5u32` must not be congruent. The width, then its bits as the
  /// literal carries them; arithmetic over it stays opaque.
  | TFixed(String, Int, Int)
  | TUnit
  /// A `forall` binder, `result`, a constructor field a case split exposed, or an opaque stand-in.
  | TSym(Int)
  /// A top-level definition named as a value, or an uninterpreted operator.
  | TOpaque(String)
  | TLin(Poly)
  | TApp({ head: Int, args: List<Int> })
  | TCtor({ name: String, args: List<Int> })
  | TNil
  | TCons({ head: Int, tail: Int })
  /// Ascending by field name.
  | TRecord(List<{ name: String, value: Int }>)
  | TField({ base: Int, field: String })
  | TNot(Int)
  | TAnd(Int, Int)
  | TOr(Int, Int)
  /// Over `Int` only.
  | TCmp({ op: CmpOp, lhs: Int, rhs: Int })
  | TEq({ lhs: Int, rhs: Int })
  | TIf({ cond: Int, then_branch: Int, else_branch: Int })
  | TMatch({ scrutinee: Int, arms: List<Arm> })

/// `ints` marks what the type system already proved an `Int`.
/// `ctors`, `lists` and `records` are the terms of each of those heads, ascending, so a search for
/// one in a class reads only those.
pub type Terms = {
  nodes: List<Node>,
  sorts: List<Option<Ty>>,
  ints: List<Bool>,
  index: Map<Node, Int>,
  next_sym: Int,
  ctors: List<Int>,
  lists: List<Int>,
  records: List<Int>,
}

/// A term store after a change, and the term the change was about.
pub type Made = { terms: Terms, id: Int }

pub fn true_id() -> Int = 0

pub fn false_id() -> Int = 1

/// `true` and `false` first, so their ids are fixed.
pub fn new_terms() -> Terms / {abort.raise} = {
  let empty: Terms = {
    nodes: [],
    sorts: [],
    ints: [],
    index: map_new(),
    next_sym: 0,
    ctors: [],
    lists: [],
    records: [],
  };
  mk(mk(empty, TBool(true), Some(bool_ty())).terms, TBool(false), Some(bool_ty())).terms
}

pub fn size(terms: Terms) -> Int = len(terms.nodes)

pub fn node(terms: Terms, t: Int) -> Node / {abort.raise} =
  match list_at(terms.nodes, t) { Some(n) -> n, None -> panic("a term the store never made") }

pub fn sort_of(terms: Terms, t: Int) -> Option<Ty> =
  match list_at(terms.sorts, t) { Some(s) -> s, None -> None }

pub fn is_int(terms: Terms, t: Int) -> Bool =
  match list_at(terms.ints, t) { Some(b) -> b, None -> false }

pub fn force_int(terms: Terms, t: Int) -> Terms / {abort.raise} =
  { ..terms, ints: list_set(terms.ints, t, true) }

pub fn mk(terms: Terms, n: Node, sort: Option<Ty>) -> Made / {abort.raise} =
  match map_get(terms.index, n) {
    Some(existing) -> {
      let ts2 = match sort_of(terms, existing) {
        None -> { ..terms, sorts: list_set(terms.sorts, existing, sort) },
        Some(_) -> terms,
      };
      { terms: ts2, id: existing }
    },
    None -> {
      let id = len(terms.nodes);
      let int = (match sort { Some(s) -> is_con(s, "Int"), None -> false })
        || (match n { TInt(_) -> true, TLin(_) -> true, _ -> false });
      {
        terms: {
          nodes: push(terms.nodes, n),
          sorts: push(terms.sorts, sort),
          ints: push(terms.ints, int),
          index: map_insert(terms.index, n, id),
          next_sym: terms.next_sym,
          ctors: match n { TCtor(_) -> push(terms.ctors, id), _ -> terms.ctors },
          lists: match n {
            TNil -> push(terms.lists, id),
            TCons(_) -> push(terms.lists, id),
            _ -> terms.lists,
          },
          records: match n { TRecord(_) -> push(terms.records, id), _ -> terms.records },
        },
        id: id,
      }
    },
  }

pub fn int_lit(terms: Terms, k: Int) -> Made / {abort.raise} = mk(terms, TInt(k), Some(int_ty()))

pub fn boolean(terms: Terms, b: Bool) -> Made / {abort.raise} = mk(terms, TBool(b), Some(bool_ty()))

pub fn string(terms: Terms, s: String) -> Made / {abort.raise} =
  mk(terms, TStr(s), Some(string_ty()))

pub fn decimal(terms: Terms, d: Decimal) -> Made / {abort.raise} =
  mk(terms, TDecimal(d), Some(decimal_ty()))

pub fn fixed(terms: Terms, width: String, high: Int, low: Int) -> Made / {abort.raise} =
  mk(terms, TFixed(width, high, low), Some(Con(width, [])))

pub fn unit(terms: Terms) -> Made / {abort.raise} = mk(terms, TUnit, Some(unit_ty()))

pub fn nil(terms: Terms, sort: Option<Ty>) -> Made / {abort.raise} = mk(terms, TNil, sort)

pub fn cons(terms: Terms, head: Int, tail: Int, sort: Option<Ty>) -> Made / {abort.raise} =
  mk(terms, TCons({ head: head, tail: tail }), sort)

pub fn sym(terms: Terms, sort: Option<Ty>) -> Made / {abort.raise} = {
  let made = mk(terms, TSym(terms.next_sym), sort);
  { terms: { ..made.terms, next_sym: terms.next_sym + 1 }, id: made.id }
}

pub fn opaque(terms: Terms, name: String, sort: Option<Ty>) -> Made / {abort.raise} =
  mk(terms, TOpaque(name), sort)

// --- Linear terms -----------------------------------------------------------

pub fn constant(k: I128) -> Poly = { monomials: [], konst: k }

pub fn poly_of(terms: Terms, t: Int) -> Poly / {abort.raise} =
  match node(terms, t) {
    TInt(k) -> constant(i128_of_int(k)),
    TLin(p) -> p,
    _ -> { monomials: [{ term: t, coeff: 1i128 }], konst: 0i128 },
  }

pub fn scaled(p: Poly, factor: I128) -> Option<Poly> =
  match checked_mul(p.konst, factor) {
    None -> None,
    Some(k) -> match fold(p.monomials, Some([]), |acc: Option<List<Mono>>, m: Mono|
        match acc {
          None -> None,
          Some(ms) -> match checked_mul(m.coeff, factor) {
            None -> None,
            Some(c) -> if c == 0i128 { Some(ms) }
            else { Some(push(ms, { term: m.term, coeff: c })) },
          },
        }) {
      None -> None,
      Some(ms) -> Some({ monomials: ms, konst: k }),
    },
  }

/// A merge of two ascending lists, summing where they share a term and dropping a sum of zero.
pub fn plus(a: Poly, b: Poly) -> Option<Poly> =
  match checked_add(a.konst, b.konst) {
    None -> None,
    Some(k) -> match merged(a.monomials, b.monomials, 0, 0, []) {
      None -> None,
      Some(ms) -> Some({ monomials: ms, konst: k }),
    },
  }

fn merged(xs: List<Mono>, ys: List<Mono>, i: Int, j: Int, out: List<Mono>) -> Option<List<Mono>> =
  match list_at(xs, i) {
    None ->
      Some(
        fold(range(j, len(ys)), out, |acc: List<Mono>, k: Int|
          match list_at(ys, k) { Some(m) -> push(acc, m), None -> acc }),
      ),
    Some(x) -> match list_at(ys, j) {
      None ->
        Some(
          fold(range(i, len(xs)), out, |acc: List<Mono>, k: Int|
            match list_at(xs, k) { Some(m) -> push(acc, m), None -> acc }),
        ),
      Some(y) -> if x.term == y.term {
        match checked_add(x.coeff, y.coeff) {
          None -> None,
          Some(c) ->
            merged(xs, ys, i + 1, j + 1, if c == 0i128 { out }
            else { push(out, { term: x.term, coeff: c }) }),
        }
      } else if x.term < y.term { merged(xs, ys, i + 1, j, push(out, x)) }
      else { merged(xs, ys, i, j + 1, push(out, y)) },
    },
  }

/// A constant outside `Int` is no Ply value, so it has no term.
pub fn intern_poly(terms: Terms, p: Poly) -> Option<Made> / {abort.raise} =
  match p.monomials {
    [] -> match checked_int(p.konst) { Some(k) -> Some(int_lit(terms, k)), None -> None },
    [m] -> if m.coeff == 1i128 && p.konst == 0i128 { Some({ terms: terms, id: m.term }) }
    else { Some(lin(terms, p)) },
    _ -> Some(lin(terms, p)),
  }

fn lin(terms: Terms, p: Poly) -> Made / {abort.raise} = {
  let made = mk(terms, TLin(p), Some(int_ty()));
  { terms: force_int(made.terms, made.id), id: made.id }
}

fn checked_int(k: I128) -> Option<Int> / {abort.raise} =
  if k < i128_of_int(0 - 9223372036854775807 - 1) || k > i128_of_int(9223372036854775807) { None }
  else { Some(int_of_i128(k)) }

pub fn add(terms: Terms, a: Int, b: Int) -> Option<Made> / {abort.raise} =
  match plus(poly_of(terms, a), poly_of(terms, b)) {
    None -> None,
    Some(p) -> intern_poly(terms, p),
  }

pub fn sub(terms: Terms, a: Int, b: Int) -> Option<Made> / {abort.raise} =
  match scaled(poly_of(terms, b), -1i128) {
    None -> None,
    Some(negated) -> match plus(poly_of(terms, a), negated) {
      None -> None,
      Some(p) -> intern_poly(terms, p),
    },
  }

pub fn neg(terms: Terms, a: Int) -> Option<Made> / {abort.raise} =
  match scaled(poly_of(terms, a), -1i128) { None -> None, Some(p) -> intern_poly(terms, p) }

/// In the fragment only when a factor is an integer literal.
pub fn mul(terms: Terms, a: Int, b: Int) -> Option<Made> / {abort.raise} =
  match node(terms, a) {
    TInt(k) -> times(terms, poly_of(terms, b), k),
    _ -> match node(terms, b) { TInt(k) -> times(terms, poly_of(terms, a), k), _ -> None },
  }

fn times(terms: Terms, p: Poly, k: Int) -> Option<Made> / {abort.raise} =
  match scaled(p, i128_of_int(k)) { None -> None, Some(q) -> intern_poly(terms, q) }

// --- Structure --------------------------------------------------------------

/// Reduces over a record literal; the same reduction up to equality is a solver rule.
pub fn field(terms: Terms, base: Int, name: String) -> Made / {abort.raise} =
  match node(terms, base) {
    TRecord(fields) -> match fold(
        fields,
        None,
        |acc: Option<Int>, f: { name: String, value: Int }|
          match acc { Some(_) -> acc, None -> if f.name == name { Some(f.value) } else { None } },
      ) {
      Some(v) -> { terms: terms, id: v },
      None -> projected(terms, base, name),
    },
    _ -> projected(terms, base, name),
  }

fn projected(terms: Terms, base: Int, name: String) -> Made / {abort.raise} =
  mk(terms, TField({ base: base, field: name }), match sort_of(terms, base) {
    Some(s) -> field_ty(s, name),
    None -> None,
  })

pub fn not(terms: Terms, a: Int) -> Made / {abort.raise} =
  match node(terms, a) {
    TBool(b) -> boolean(terms, !b),
    TNot(inner) -> { terms: terms, id: inner },
    _ -> mk(terms, TNot(a), Some(bool_ty())),
  }

pub fn and(terms: Terms, a: Int, b: Int) -> Made / {abort.raise} =
  mk(terms, TAnd(a, b), Some(bool_ty()))

pub fn or(terms: Terms, a: Int, b: Int) -> Made / {abort.raise} =
  mk(terms, TOr(a, b), Some(bool_ty()))

pub fn cmp(terms: Terms, op: CmpOp, lhs: Int, rhs: Int) -> Made / {abort.raise} =
  mk(terms, TCmp({ op: op, lhs: lhs, rhs: rhs }), Some(bool_ty()))

pub fn eq(terms: Terms, lhs: Int, rhs: Int) -> Made / {abort.raise} = {
  let low = if lhs <= rhs { lhs } else { rhs };
  let high = if lhs <= rhs { rhs } else { lhs };
  mk(project_fields(terms, low, high), TEq({ lhs: low, rhs: high }), Some(bool_ty()))
}

/// Both sides' fields, interned, so the solver's extensionality rule has projections to compare.
fn project_fields(terms: Terms, a: Int, b: Int) -> Terms / {abort.raise} =
  match sort_of(terms, a) { Some(shape) -> projecting(terms, a, b, shape), None -> terms }

/// `shape` is `a`'s sort, carried down beside it: a field's sort is a part of its record's, so the
/// walk goes no deeper than the sort it began with.
fn projecting(terms: Terms, a: Int, b: Int, shape: Ty) -> Terms / {abort.raise} =
  match sort_of(terms, a) {
    Some(Record(left)) -> match sort_of(terms, b) {
      Some(Record(right)) -> if map(left, |f: { name: String, ty: Ty }| f.name)
          != map(right, |f: { name: String, ty: Ty }| f.name) { terms } else {
        fold(left, terms, |acc: Terms, f: { name: String, ty: Ty }| {
          let x = field(acc, a, f.name);
          let y = field(x.terms, b, f.name);
          if x.id == y.id { y.terms } else {
            match shape {
              Record(shaped) -> match fold(
                  shaped,
                  None,
                  |found: Option<Ty>, g: { name: String, ty: Ty }|
                    match found {
                      Some(_) -> found,
                      None -> if g.name == f.name { Some(g.ty) } else { None },
                    },
                ) {
                Some(inner) -> projecting(y.terms, x.id, y.id, inner),
                None -> y.terms,
              },
              _ -> y.terms,
            }
          }
        })
      },
      _ -> terms,
    },
    _ -> terms,
  }

pub fn app(terms: Terms, head: Int, args: List<Int>, sort: Option<Ty>) -> Made / {abort.raise} =
  mk(terms, TApp({ head: head, args: args }), sort)

test "equal nodes are one term, and true and false come first" {
  let terms = new_terms();
  assert_eq(node(terms, true_id()), TBool(true));
  assert_eq(node(terms, false_id()), TBool(false));
  let a = int_lit(terms, 3);
  let b = int_lit(a.terms, 3);
  assert_eq(a.id, b.id);
  assert_eq(size(b.terms), 3)
}

test "a linear term folds its constants and cancels to a literal" {
  let x = sym(new_terms(), Some(int_ty()));
  let one = int_lit(x.terms, 1);
  let up = match add(one.terms, x.id, one.id) { Some(m) -> m, None -> panic("in range") };
  let back = match sub(up.terms, up.id, one.id) { Some(m) -> m, None -> panic("in range") };
  assert_eq(back.id, x.id);
  let two = int_lit(back.terms, 2);
  let twice = match mul(two.terms, x.id, two.id) { Some(m) -> m, None -> panic("in range") };
  assert_eq(poly_of(twice.terms, twice.id), {
    monomials: [{ term: x.id, coeff: 2i128 }],
    konst: 0i128,
  })
}

test "a constant outside Int has no term" {
  let terms = new_terms();
  let big = int_lit(terms, 9223372036854775807);
  let one = int_lit(big.terms, 1);
  assert_eq(add(one.terms, big.id, one.id), None)
}

test "a linear combination is canonical" {
  let x = sym(new_terms(), Some(int_ty()));
  let zero = int_lit(x.terms, 0);
  let plus_zero = match add(zero.terms, x.id, zero.id) { Some(m) -> m, None -> panic("in range") };
  assert_eq(plus_zero.id, x.id);
  let one = int_lit(plus_zero.terms, 1);
  let a = match add(one.terms, x.id, one.id) { Some(m) -> m, None -> panic("in range") };
  let b = match add(a.terms, one.id, x.id) { Some(m) -> m, None -> panic("in range") };
  assert_eq(a.id, b.id)
}

test "a coefficient that overflows produces no term" {
  let x = sym(new_terms(), Some(int_ty()));
  let big = int_lit(x.terms, 9223372036854775807);
  let scaled = match mul(big.terms, x.id, big.id) { Some(m) -> m, None -> panic("in range") };
  let again = match mul(scaled.terms, scaled.id, big.id) {
    Some(m) -> m,
    None -> panic("in range"),
  };
  // The largest `Int` cubed leaves `I128`.
  assert_eq(mul(again.terms, again.id, big.id), None)
}

test "multiplication of two symbolics is not arithmetic" {
  let x = sym(new_terms(), Some(int_ty()));
  let y = sym(x.terms, Some(int_ty()));
  assert_eq(mul(y.terms, x.id, y.id), None)
}

test "projection reduces over a record literal" {
  let v = int_lit(new_terms(), 7);
  let record = mk(v.terms, TRecord([{ name: "balance", value: v.id }]), None);
  assert_eq(field(record.terms, record.id, "balance").id, v.id)
}

test "every fresh symbol is a distinct term" {
  let a = sym(new_terms(), None);
  let b = sym(a.terms, None);
  assert(a.id != b.id)
}
