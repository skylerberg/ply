//! `context` — the facts about a program the static prover reads, indexed once per run: each lowered
//! body and clause from `compiler.front.claims`, and the declared types and signatures of the world.

import compiler.code (Code, NLit, NVar, NUnary, NBinary, NApp, NIf, NBlock, NList, NRecord, NMatch,
                      NPerform, NLabel, NCell, NLambda, NSimulate, NParallel, NHandle, NField,
                      NUpdate, CodeStmt, CLet, CLetPat, CDo, CodeField, CodeArm, CodeClause)
import compiler.front (Claim, ClaimDef, ClaimSum, ClaimLaw, ClaimClause, Lowered)
import compiler.hash (tarjan)
import domain (Ty, Var, Fn, Record, Con, Decl, Variant)
import sort (canonical, is_pure_fn)
import world (Signature, World)

/// A definition as the prover reads it: its body (`None` when the lowering did not take it), its
/// clauses, its `decreases` measure, and every global its body names, which is what its place in the
/// call graph is made of. `ends`: the checker saw every call it makes of its own group descend;
/// `stated`: it saw that only once the measures the group states are counted.
/// `costed`: the parameters with a cost name, in the order a `cost` clause binds those after the
/// parameters.
pub type Def = {
  params: Int,
  costed: List<Int>,
  body: Option<Code>,
  spec: List<ClaimClause>,
  measure: Option<Code>,
  refs: List<String>,
  ends: Bool,
  stated: Bool,
}

/// `costs`: the definition and the `cost` clause this law measures, where the rewrite made it of one.
pub type Law = {
  guard: Option<Lowered>,
  body: Option<Code>,
  costs: Option<{ def: String, index: Int }>,
}

pub type Claims = { defs: Map<String, Def>, laws: Map<String, Law>, sums: Map<String, Int> }

/// A constructor beside the type it builds.
pub type Ctor = { decl: Decl, variant: Variant }

pub type Context = {
  claims: Claims,
  decls: Map<String, Decl>,
  ctors: Map<String, Ctor>,
  signatures: Map<String, Signature>,
  recursive: Map<String, Bool>,
  /// A component of one definition calling itself: the shape induction unrolls.
  self_recursive: Map<String, Bool>,
  /// Each recursive definition's component.
  groups: Map<String, List<String>>,
  /// Definitions whose stated measures a proof showed descend, which end as surely as `ends` says.
  measured: Map<String, Bool>,
  /// The sum types a case split may range over.
  sums: Map<String, Bool>,
  inhabited: Map<String, Bool>,
  /// Nominal types whose declaration reaches a `Float`.
  float_types: Map<String, Bool>,
  // Nominal types that state a `key`, or whose declaration reaches one that does.
  keyed_types: Map<String, Bool>,
}

pub fn claims_of(cs: List<Claim>) -> Claims =
  fold(cs, { defs: map_new(), laws: map_new(), sums: map_new() }, |acc: Claims, c: Claim|
    match c {
      ClaimDef(d) ->
        {
          ..acc,
          defs: map_insert(acc.defs, string_of_bytes_lossy(d.name), {
            params: d.params,
            costed: d.costed,
            body: d.body,
            spec: d.spec,
            measure: d.measure,
            refs: match d.body { Some(b) -> refs_of(b, []), None -> [] },
            ends: d.ends,
            stated: d.stated,
          }),
        },
      ClaimLaw(l) ->
        {
          ..acc,
          laws: map_insert(acc.laws, string_of_bytes_lossy(l.key), {
            guard: l.guard,
            body: l.body,
            costs: match l.costs {
              Some(c) -> Some({ def: string_of_bytes_lossy(c.def), index: c.index }),
              None -> None,
            },
          }),
        },
      ClaimSum(s) ->
        { ..acc, sums: map_insert(acc.sums, string_of_bytes_lossy(s.name), s.variants) },
    })

/// Every global a body names, even under an effect the prover treats as opaque.
pub fn refs_of(c: Code, acc: List<String>) -> List<String> =
  match c.node {
    NVar(v) -> match v.slot { Some(_) -> acc, None -> push(acc, string_of_bytes_lossy(v.name)) },
    NLit(_) -> acc,
    NLabel(_) -> acc,
    NUnary(u) -> refs_of(u.operand, acc),
    NBinary(b) -> refs_of(b.rhs, refs_of(b.lhs, acc)),
    NApp(a) -> fold(a.args, refs_of(a.func, acc), |s: List<String>, x: Code| refs_of(x, s)),
    NIf(i) -> refs_of(i.else_branch, refs_of(i.then_branch, refs_of(i.cond, acc))),
    NBlock(b) -> {
      let stmts = fold(b.stmts, acc, |s: List<String>, st: CodeStmt|
        match st {
          CLet(l) -> refs_of(l.value, s),
          CLetPat(l) -> refs_of(l.value, s),
          CDo(d) -> refs_of(d.code, s),
        });
      match b.tail { Some(t) -> refs_of(t, stmts), None -> stmts }
    },
    NList(l) -> fold(l.items, acc, |s: List<String>, x: Code| refs_of(x, s)),
    NRecord(r) -> fold(r.fields, acc, |s: List<String>, f: CodeField| refs_of(f.value, s)),
    NMatch(m) ->
      fold(m.arms, refs_of(m.scrutinee, acc), |s: List<String>, a: CodeArm|
        refs_of(a.body, match a.guard { Some(g) -> refs_of(g, s), None -> s })),
    NPerform(p) -> fold(p.args, acc, |s: List<String>, x: Code| refs_of(x, s)),
    NCell(cell) -> refs_of(cell.body, refs_of(cell.init, acc)),
    NLambda(l) -> refs_of(l.body, acc),
    NSimulate(s) -> refs_of(s.body, acc),
    NParallel(pr) -> fold(pr.branches, acc, |s: List<String>, x: Code| refs_of(x, s)),
    NHandle(h) -> {
      let clauses = fold(h.clauses, refs_of(h.body, acc), |s: List<String>, cl: CodeClause|
        refs_of(cl.body, s));
      match h.ret { Some(r) -> refs_of(r.body, clauses), None -> clauses }
    },
    NField(f) -> refs_of(f.base, acc),
    NUpdate(u) ->
      fold(u.sets, refs_of(u.base, acc), |s: List<String>, f: CodeField| refs_of(f.value, s)),
  }

pub fn set_of(names: List<String>) -> Map<String, Bool> =
  fold(names, map_new(), |m: Map<String, Bool>, n: String| map_insert(m, n, true))

fn canonical_decl(decl: Decl) -> Decl =
  {
    ..decl,
    variants: map(decl.variants, |variant: Variant|
      { ..variant, fields: map(variant.fields, canonical) }),
  }

pub fn context(claims: Claims, world: World) -> Context / {abort.raise} = {
  let decls = map(world.decls, canonical_decl);
  let by_name = fold(decls, map_new(), |m: Map<String, Decl>, decl: Decl|
    map_insert(m, decl.name, decl));
  let ctors = fold(decls, map_new(), |m: Map<String, Ctor>, decl: Decl|
    fold(decl.variants, m, |acc: Map<String, Ctor>, variant: Variant|
      map_insert(acc, variant.name, { decl: decl, variant: variant })));
  // A split over a partial list is unsound, so a type the lowered claims count otherwise is never
  // split on; aliases and builtins have no constructors, so they are not sums at all.
  let sums = set_of(
    map(
      filter(decls, |decl: Decl|
        len(decl.variants) > 0
          && (match map_get(claims.sums, decl.name) {
            Some(n) -> n == len(decl.variants),
            None -> true,
          })),
      |decl: Decl| decl.name,
    ),
  );
  let rec = recursive_definitions(claims.defs);
  let signatures = fold(world.signatures, map_new(), |m: Map<String, Signature>, s: Signature|
    map_insert(m, s.name, { ..s, ty: canonical(s.ty) }));
  let measures = measure_defs(claims.defs, signatures);
  {
    claims: { ..claims, defs: map_merge(claims.defs, measures.defs) },
    decls: by_name,
    ctors: ctors,
    signatures: map_merge(signatures, measures.signatures),
    recursive: rec.recursive,
    self_recursive: rec.alone,
    groups: rec.groups,
    measured: map_new(),
    sums: sums,
    inhabited: inhabited_sum_types(decls, sums),
    float_types: reaching_types(decls, map_new(), true),
    keyed_types: if len(world.keyed) == 0 { map_new() }
    else { reaching_types(decls, set_of(world.keyed), false) },
  }
}

/// Through its arguments, its fields, or its own declaration.
pub fn reaches_float(cx: Context, ty: Ty) -> Bool = reaches(ty, cx.float_types, true)

/// Whether a value of `ty` holds one of a type that states a `key` or a `numeric`, whose `==` or
/// whose operators are not what its constructors and fields say.
pub fn reaches_key(cx: Context, ty: Ty) -> Bool =
  map_len(cx.keyed_types) > 0 && reaches(ty, cx.keyed_types, false)

/// `float` counts `Float` itself as reached.
fn reaches(t: Ty, declared: Map<String, Bool>, float: Bool) -> Bool =
  match t {
    Con(name, args) ->
      (float && name == "Float" && len(args) == 0) || map_contains(declared, name)
        || fold(args, false, |f: Bool, a: Ty| f || reaches(a, declared, float)),
    Fn(params, ret, _) ->
      fold(params, false, |f: Bool, p: Ty| f || reaches(p, declared, float))
        || reaches(ret, declared, float),
    Record(fields) ->
      fold(fields, false, |f: Bool, x: { name: String, ty: Ty }|
        f || reaches(x.ty, declared, float)),
    Var(_) -> false,
  }

pub fn ctor(cx: Context, name: String) -> Option<Ctor> = map_get(cx.ctors, name)

pub fn arity(c: Ctor) -> Int = len(c.variant.fields)

/// The type over its own parameters.
pub fn decl_sort(decl: Decl) -> Ty = Con(decl.name, map(range(0, decl.params), |p: Int| Var(p)))

/// As a value: the type it builds, or a pure function to it from its fields.
pub fn ctor_sort(c: Ctor) -> Ty =
  if len(c.variant.fields) == 0 { decl_sort(c.decl) }
  else { Fn(c.variant.fields, decl_sort(c.decl), true) }

/// `None` unless every constructor is in hand: a split over a partial list is unsound.
pub fn variants(cx: Context, type_name: String) -> Option<Decl> =
  if map_contains(cx.sums, type_name) { map_get(cx.decls, type_name) } else { None }

pub fn signature(cx: Context, name: String) -> Option<Signature> = map_get(cx.signatures, name)

pub fn inhabited(cx: Context, ty: Ty) -> Bool =
  match ty {
    Var(_) -> true,
    Fn(_, ret, _) -> inhabited(cx, ret),
    Record(fields) ->
      fold(fields, true, |ok: Bool, f: { name: String, ty: Ty }| ok && inhabited(cx, f.ty)),
    Con(name, _) -> !map_contains(cx.sums, name) || map_contains(cx.inhabited, name),
  }

/// Whether equal calls must answer equally, so they may share one term.
pub fn is_pure(cx: Context, name: String) -> Bool =
  match signature(cx, name) {
    None -> false,
    Some(s) -> s.pure && (match s.ty { Fn(_, _, pure) -> pure, _ -> true }),
  }

pub fn is_recursive(cx: Context, name: String) -> Bool = map_contains(cx.recursive, name)

/// Not in a recursive component, with an empty footprint, and with a body the lowering reached.
pub fn unfoldable(cx: Context, name: String) -> Option<Def> =
  if map_contains(cx.recursive, name) { None } else { reached_pure(cx, name) }

/// Calling only itself, with an empty footprint, and with a body the lowering reached: what induction
/// may unroll once it has shown the recursion decreases.
pub fn self_recursive(cx: Context, name: String) -> Option<Def> =
  if map_contains(cx.self_recursive, name) { reached_pure(cx, name) } else { None }

fn reached_pure(cx: Context, name: String) -> Option<Def> =
  match signature(cx, name) {
    None -> None,
    Some(s) -> if !s.pure { None } else {
      match map_get(cx.claims.defs, name) {
        Some(d) -> match d.body { Some(_) -> Some(d), None -> None },
        None -> None,
      }
    },
  }

/// The types that reach `seeds`, those included, and `Float` when `float`. A least fixed point, so
/// chains of declarations and recursive ones both settle.
fn reaching_types(
  decls: List<Decl>,
  seeds: Map<String, Bool>,
  float: Bool,
) -> Map<String, Bool> / {abort.raise} =
  iterate(seeds, len(decls) + 1, |found: Map<String, Bool>| {
    let grown = fold(decls, found, |acc: Map<String, Bool>, decl: Decl|
      if map_contains(acc, decl.name) { acc }
      else if fold(decl.variants, false, |f: Bool, variant: Variant|
          f || fold(variant.fields, false, |g: Bool, ty: Ty| g || reaches(ty, found, float))) {
        map_insert(acc, decl.name, true)
      } else { acc });
    if map_len(grown) == map_len(found) { Stop(found) } else { Continue(grown) }
  })

/// Least fixed point: a type is inhabited once every field of some constructor is.
fn inhabited_sum_types(
  decls: List<Decl>,
  sums: Map<String, Bool>,
) -> Map<String, Bool> / {abort.raise} =
  iterate(map_new(), len(decls) + 1, |found: Map<String, Bool>| {
    let grown = fold(
      filter(decls, |decl: Decl| map_contains(sums, decl.name)),
      found,
      |acc: Map<String, Bool>, decl: Decl|
        if map_contains(acc, decl.name) { acc }
        else if fold(decl.variants, false, |f: Bool, variant: Variant|
            f
              || fold(variant.fields, true, |ok: Bool, ty: Ty|
                ok && field_inhabited(ty, sums, found))) { map_insert(acc, decl.name, true) }
        else { acc },
    );
    if map_len(grown) == map_len(found) { Stop(found) } else { Continue(grown) }
  })

fn field_inhabited(ty: Ty, sums: Map<String, Bool>, inhabited: Map<String, Bool>) -> Bool =
  match ty {
    Var(_) -> true,
    Fn(_, ret, _) -> field_inhabited(ret, sums, inhabited),
    Record(fields) ->
      fold(fields, true, |ok: Bool, f: { name: String, ty: Ty }|
        ok && field_inhabited(f.ty, sums, inhabited)),
    Con(name, _) -> if map_contains(sums, name) { map_contains(inhabited, name) } else { true },
  }

/// Definitions in a call-graph cycle, and among them the ones whose cycle is only themselves.
fn recursive_definitions(defs: Map<String, Def>) -> Recursion / {abort.raise} = {
  let names = map_keys(defs);
  let index = fold(range(0, len(names)), map_new(), |m: Map<String, Int>, i: Int|
    match list_at(names, i) { Some(n) -> map_insert(m, n, i), None -> m });
  let edges = map(names, |n: String|
    match map_get(defs, n) {
      Some(d) ->
        fold(d.refs, [], |acc: List<Int>, r: String|
          match map_get(index, r) {
            Some(i) -> if fold(acc, false, |f: Bool, x: Int| f || x == i) { acc }
            else { push(acc, i) },
            None -> acc,
          }),
      None -> [],
    });
  fold(
    tarjan(len(names), edges),
    { recursive: map_new(), alone: map_new(), groups: map_new() },
    |acc: Recursion, component: List<Int>| {
      let self_loop = match component {
        [v] -> match list_at(edges, v) {
          Some(es) -> fold(es, false, |f: Bool, w: Int| f || w == v),
          None -> false,
        },
        _ -> false,
      };
      let named = map(component, |v: Int| match list_at(names, v) { Some(n) -> n, None -> "" });
      let alone = if self_loop {
        fold(named, acc.alone, |m: Map<String, Bool>, n: String| map_insert(m, n, true))
      } else { acc.alone };
      let looping = len(component) > 1 || self_loop;
      let recursive = if looping {
        fold(named, acc.recursive, |m: Map<String, Bool>, n: String| map_insert(m, n, true))
      } else { acc.recursive };
      let groups = if looping {
        fold(named, acc.groups, |m: Map<String, List<String>>, n: String| map_insert(m, n, named))
      } else { acc.groups };
      { recursive: recursive, alone: alone, groups: groups }
    },
  )
}

type Recursion = {
  recursive: Map<String, Bool>,
  alone: Map<String, Bool>,
  groups: Map<String, List<String>>,
}

/// The name a definition's measure goes by as a definition of its own parameters.
pub fn measure_name(def: String) -> String = def ++ " decreases"

/// Each measure as a definition the lowering unfolds, so a measure at a call's arguments is a call.
fn measure_defs(
  defs: Map<String, Def>,
  signatures: Map<String, Signature>,
) -> { defs: Map<String, Def>, signatures: Map<String, Signature> } =
  map_fold(
    defs,
    { defs: map_new(), signatures: map_new() },
    |acc: { defs: Map<String, Def>, signatures: Map<String, Signature> }, name: String, d: Def|
      match d.measure {
        None -> acc,
        Some(m) -> match map_get(signatures, name) {
          Some(s) -> match s.ty {
            Fn(params, _, _) ->
              {
                defs: map_insert(acc.defs, measure_name(name), {
                  params: d.params,
                  costed: [],
                  body: Some(m),
                  spec: [],
                  measure: None,
                  refs: refs_of(m, []),
                  ends: true,
                  stated: false,
                }),
                signatures: map_insert(acc.signatures, measure_name(name), {
                  name: measure_name(name),
                  ty: Fn(params, Con("Int", []), true),
                  pure: true,
                }),
              },
            _ -> acc,
          },
          None -> acc,
        },
      },
  )

pub fn group_of(cx: Context, name: String) -> List<String> =
  match map_get(cx.groups, name) { Some(g) -> g, None -> [name] }

/// Whether a definition's calls are known to end: the checker saw them, or a proof showed the measures
/// it read them by descend.
pub fn ends(cx: Context, name: String) -> Bool =
  match map_get(cx.claims.defs, name) {
    Some(d) -> d.ends || (d.stated && map_contains(cx.measured, name)),
    None -> false,
  }
