// `statics` — the static prover over a run's obligations: the claims it reads, lowered from the
// modules that own something to ask about and everything they import; each obligation's goal; and
// what a decision leaves the runtime to carry out.

import compiler.diagnostics (parse_all)
import compiler.front (Analysed, Claim, ClaimClause, ClaimDef, Refused, Analysis, analyse,
                       claims_in, module_imports)
import compiler.items (SCost, SEnsures, SRequires)
import compiler.resolve (ParsedModule)
import context (Context, Claims, claims_of, context, ctor, signature, group_of)
import decide (Certified, Diagnosed, Static, Undecided, GuardRefuted, Unwitnessed, Proved, Unknown,
               decide_and_diagnose, static_of)
import goal (Goal, Binder, Limits, BudgetSpent, Open, default_limits, default_prove_budget)
import lemma (Lemma, lemma_of)
import cost (dominated, stated, steps)
import lower (Blocker, Unbounded, blocker_parts)
import measure (descent_of)
import obligation (Ensures, Law)
import rules (CostBound)
import sort (canonical)
import world (Drawn, Fitting, Measure, Obligation, World, Interleave, Hosted, measures_in,
              measures_world, unsettled, world_of)
import world
import std.list (concat)

// A proved law where it is written, which every claim below it in its module may use.
pub type Placed = { module: Int, start: Int, lemma: Lemma }

// `proved` holds the laws a claim below them may use, and `decided` what deciding each of those laws
// came to, by obligation key, which a run that asks about one reads rather than deciding it twice.
pub type Prover = {
  cx: Context,
  claims: Claims,
  limits: Limits,
  proved: List<Placed>,
  decided: Map<String, Diagnosed>,
}

// Measures are decided first: a definition whose measures a proof shows descend, across its group, is
// unrolled as one the checker saw end. Then each law a later claim may use, in the order they are
// written, each with the ones above it in hand.
pub fn prover_of(cs: List<Claim>, w: World, budget: Int) -> Prover / {abort.raise} = {
  let claims = claims_of(cs);
  let cx = context(claims, w);
  let limits = { ..default_limits(), steps: budget };
  let shown = fold(w.measures, map_new(), |m: Map<String, Bool>, x: Measure|
    match judged(cx, x, limits) { Ok([]) -> map_insert(m, x.owner, true), _ -> m });
  let measured = {
    cx: {
      ..cx,
      measured: fold(map_keys(shown), map_new(), |m: Map<String, Bool>, name: String|
        if fold(group_of(cx, name), true, |all: Bool, member: String|
            all && (map_contains(shown, member) || !states(cx, member))) {
          map_insert(m, name, true)
        } else { m }),
    },
    claims: claims,
    limits: limits,
    proved: [],
    decided: map_new(),
  };
  fold(
    in_place_order(filter(w.obligations, lemma_candidate)),
    measured,
    |p: Prover, o: Obligation|
      match lemma_at(p, o) {
        None -> p,
        Some(l) -> match goal_of(p, o) {
          None -> p,
          Some(g) -> {
            let d = decide_and_diagnose(p.cx, g, p.limits);
            let decided = { ..p, decided: map_insert(p.decided, o.key, d) };
            match d.decision {
              Proved(_) ->
                {
                  ..decided,
                  proved: push(p.proved, { module: o.at.module, start: o.at.start, lemma: l }),
                },
              _ -> decided,
            }
          },
        },
      },
  )
}

// A law with no guard that the static prover is asked about first.
fn lemma_candidate(o: Obligation) -> Bool =
  match o.kind {
    Law(_) ->
      len(o.guards) == 0 && (match unsettled(o.strategy) { Some(_) -> true, None -> false }),
    _ -> false,
  }

fn lemma_at(p: Prover, o: Obligation) -> Option<Lemma> =
  match map_get(p.claims.laws, o.owner) {
    None -> None,
    Some(l) -> match l.guard {
      Some(_) -> None,
      None ->
        lemma_of(
          o.owner,
          match o.kind { Law(Some(label)) -> label, _ -> o.owner },
          len(o.binders),
          l.body,
          |name: String| signature(p.cx, name) != None && ctor(p.cx, name) == None,
        ),
    },
  }

// By module, then where each is written.
fn in_place_order(os: List<Obligation>) -> List<Obligation> =
  fold(os, [], |acc: List<Obligation>, o: Obligation| {
    let before = filter(acc, |x: Obligation|
      x.at.module < o.at.module || (x.at.module == o.at.module && x.at.start <= o.at.start));
    let after = filter(acc, |x: Obligation|
      !(x.at.module < o.at.module || (x.at.module == o.at.module && x.at.start <= o.at.start)));
    concat(push(before, o), after)
  })

// The proved laws written above `o` in its module.
fn lemmas_for(p: Prover, o: Obligation) -> List<Lemma> =
  map(filter(p.proved, |x: Placed| x.module == o.at.module && x.start < o.at.start), |x: Placed|
    x.lemma)

// A measure no proof shows descends, what kept one from it, and whether the checker reads its
// definition as ending without it.
pub type Unshown = { measure: Measure, why: List<String>, ends: Bool }

// The measures the modules `owned` answers for state that no proof shows descend, which the checker
// refuses: a definition is read as ending on its measure only once a proof shows the measure.
pub fn unshown(analysis: Analysis, owned: (Bytes) -> Bool) -> List<Unshown> / {abort.raise} = {
  let measures = measures_in(analysis, owned);
  if len(measures) == 0 { [] } else {
    let w = measures_world(analysis, measures);
    let modules = fold(w.measures, [], |acc: List<Int>, m: Measure|
      if fold(acc, false, |seen: Bool, k: Int| seen || k == m.at.module) { acc }
      else { push(acc, m.at.module) });
    let cx = context(claims_of(claims_for(analysis, modules, owned)), w);
    let limits = { ..default_limits(), steps: default_prove_budget() };
    fold(w.measures, [], |acc: List<Unshown>, m: Measure| {
      let ends = match map_get(cx.claims.defs, m.owner) { Some(d) -> d.ends, None -> false };
      match judged(cx, m, limits) {
        Ok([]) -> acc,
        Ok(why) -> push(acc, { measure: m, why: why, ends: ends }),
        Err(why) -> push(acc, { measure: m, why: ["no proof can be stated: " ++ why], ends: ends }),
      }
    })
  }
}

// Nothing when a proof shows the measure descends; otherwise where the proof left what the prover
// decides. `Err` when no proof could be stated.
fn judged(cx: Context, m: Measure, limits: Limits) -> Result<List<String>, String> / {abort.raise} =
  match descent_of(cx, m.owner) {
    Err(why) -> Err(why),
    Ok(body) -> {
      let d = decide_and_diagnose(
        cx,
        {
          binders: map(m.binders, |b: world::Binder| { name: b.name, ty: canonical(b.ty) }),
          guards: [],
          result: None,
          body: Some(body),
          lemmas: [],
          total: group_of(cx, m.owner),
          partial: true,
        },
        limits,
      );
      match d.decision {
        Proved(_) -> Ok([]),
        Unknown(u) -> if u.reason == BudgetSpent {
          Ok(["the proof spent its " ++ int_to_string(limits.steps) ++ " steps"])
        } else if len(d.blockers) == 0 {
          Ok(["at some call the measure is negative or does not fall"])
        } else {
          Ok(
            map(d.blockers, |b: Blocker| {
              let parts = blocker_parts(b);
              "the proof stopped at " ++ parts.kind
                ++ (match parts.detail { Some(x) -> " `" ++ x ++ "`", None -> "" })
            }),
          )
        },
        _ -> Ok(["no proof was found"]),
      }
    },
  }

fn states(cx: Context, name: String) -> Bool =
  match map_get(cx.claims.defs, name) {
    Some(d) -> match d.measure { Some(_) -> true, None -> false },
    None -> false,
  }

// The claims of the modules at `wanted` and everything they import; a module not `owned` is opaque.
pub fn claims_for(
  analysis: Analysis,
  wanted: List<Int>,
  owned: (Bytes) -> Bool = |m: Bytes| true,
) -> List<Claim> / {abort.raise} = claims_in(analysis, closure(analysis.mods, wanted), owned)

// The modules the obligations are written in; a claim placed nowhere asks for every module.
pub fn modules_of(analysis: Analysis, os: List<Obligation>) -> List<Int> =
  fold(os, [], |acc: List<Int>, obligation: Obligation|
    if obligation.at.module >= len(analysis.mods) { range(0, len(analysis.mods)) }
    else if fold(acc, false, |seen: Bool, m: Int| seen || m == obligation.at.module) { acc }
    else { push(acc, obligation.at.module) })

fn name_at(mods: List<ParsedModule>, i: Int) -> Bytes =
  match list_at(mods, i) { Some(m) -> m.name, None -> b"" }

// `from` and every module it imports, transitively, ascending.
fn closure(mods: List<ParsedModule>, from: List<Int>) -> List<Int> / {abort.raise} = {
  let index = fold(range(0, len(mods)), map_new(), |acc: Map<Bytes, Int>, i: Int|
    map_insert(acc, name_at(mods, i), i));
  let seen = iterate(
    {
      seen: fold(from, map_new(), |acc: Map<Int, Bool>, i: Int| map_insert(acc, i, true)),
      stack: from,
    },
    len(mods) + len(from) + 1,
    |s: { seen: Map<Int, Bool>, stack: List<Int> }|
      match list_at(s.stack, len(s.stack) - 1) {
        None -> Stop(s.seen),
        Some(i) -> {
          let rest = fold(range(0, len(s.stack) - 1), [], |acc: List<Int>, k: Int|
            match list_at(s.stack, k) { Some(x) -> push(acc, x), None -> acc });
          let imported = match list_at(mods, i) { Some(m) -> module_imports(m), None -> [] };
          Continue(
            fold(
              imported,
              { seen: s.seen, stack: rest },
              |acc: { seen: Map<Int, Bool>, stack: List<Int> }, name: Bytes|
                match map_get(index, name) {
                  Some(j) -> if map_contains(acc.seen, j) { acc }
                  else { { seen: map_insert(acc.seen, j, true), stack: push(acc.stack, j) } },
                  None -> acc,
                },
            ),
          )
        },
      },
  );
  filter(range(0, len(mods)), |i: Int| map_contains(seen, i))
}

// The obligation's goal, or none when no claim states it. Binder `i` is slot `i` of every clause:
// the drawn binders, then `result`.
pub fn goal_of(p: Prover, obligation: Obligation) -> Option<Goal> = {
  let binders = map(
    concat(obligation.binders, match obligation.result { Some(r) -> [r], None -> [] }),
    |binder: world::Binder| { name: binder.name, ty: canonical(binder.ty) },
  );
  match obligation.kind {
    Ensures(index) -> match map_get(p.claims.defs, obligation.owner) {
      None -> None,
      Some(d) -> match list_at(filter(d.spec, |c: ClaimClause| c.kind == SEnsures), index) {
        None -> None,
        Some(clause) ->
          Some({
            binders: binders,
            guards: map(filter(d.spec, |c: ClaimClause| c.kind == SRequires), |c: ClaimClause|
              c.clause.code),
            result: match obligation.result { Some(_) -> Some(d.body), None -> None },
            body: clause.clause.code,
            lemmas: lemmas_for(p, obligation),
            total: [],
            partial: false,
          }),
      },
    },
    Law(_) -> match map_get(p.claims.laws, obligation.owner) {
      None -> None,
      Some(l) ->
        Some({
          binders: binders,
          guards: match l.guard { Some(g) -> [g.code], None -> [] },
          result: None,
          body: l.body,
          lemmas: lemmas_for(p, obligation),
          total: [],
          partial: false,
        }),
    },
  }
}

// What the static tier alone answers, and where it left the fragment: none for a claim its strategy
// never asks it about, or that no claim states.
pub fn diagnosed(p: Prover, obligation: Obligation) -> Option<Diagnosed> / {abort.raise} =
  match obligation.strategy {
    Interleave(_) -> None,
    Fitting -> match map_get(p.claims.laws, obligation.owner) {
      Some(l) -> match l.costs { Some(c) -> Some(bounded(p.cx, c.def, c.index)), None -> None },
      None -> None,
    },
    _ -> match map_get(p.decided, obligation.key) {
      Some(d) -> Some(d),
      None -> match goal_of(p, obligation) {
        Some(g) -> Some(decide_and_diagnose(p.cx, g, p.limits)),
        None -> None,
      },
    },
  }

// What the runtime is left to carry out, from what the static tier answered: only a claim whose
// strategy starts at the static prover is settled by it.
pub fn settled_by(obligation: Obligation, d: Option<Diagnosed>) -> Static =
  match obligation.strategy {
    Interleave(_) -> Undecided,
    Hosted -> Undecided,
    // A fit is measured unless a proof shows the bound.
    Fitting -> match d {
      Some(x) -> match x.decision {
        Proved(_) -> static_of(x.decision, obligation.variables),
        _ -> Undecided,
      },
      None -> Undecided,
    },
    _ -> match d { Some(x) -> static_of(x.decision, obligation.variables), None -> Undecided },
  }

pub fn settled(p: Prover, obligation: Obligation) -> Static / {abort.raise} =
  match obligation.strategy {
    Interleave(_) -> Undecided,
    Hosted -> Undecided,
    _ -> settled_by(obligation, diagnosed(p, obligation)),
  }

// Whether `def`'s steps grow no faster than its `index`th `cost` bound, read off its body.
fn bounded(cx: Context, def: String, index: Int) -> Diagnosed / {abort.raise} = {
  let open = |why: String|
    { decision: Unknown({ reason: Open, steps: 0 }), blockers: [Unbounded(why)] };
  match map_get(cx.claims.defs, def) {
    None -> open("`" ++ def ++ "` has no claim here"),
    Some(d) -> match list_at(filter(d.spec, |c: ClaimClause| c.kind == SCost), index) {
      None -> open("`" ++ def ++ "` has no such bound"),
      Some(clause) -> match clause.clause.code {
        None -> open("the bound was not lowered"),
        Some(b) -> match stated(b, d.params) {
          None ->
            open(
              "only a bound of parameters' lengths, positive literals, sums, products and `ilog2` is read",
            ),
          Some(bound) -> match steps(cx, def) {
            Err(why) -> open(why),
            Ok(steps) -> if dominated(steps, bound) {
              {
                decision: Proved({
                  rules: [CostBound({ def: def })],
                  steps: 1,
                  sorts: [],
                  guard_satisfiable: true,
                }),
                blockers: [],
              }
            } else {
              open(
                "its steps are not within a constant times the bound at every size, zero included",
              )
            },
          },
        },
      },
    },
  }
}

// --- Tests ---------------------------------------------------------------------------

fn whole_of(sources: List<{ name: Bytes, src: Bytes }>) -> Analysis / {abort.raise} =
  match analyse(parse_all(sources)) { Refused(_) -> panic("the fixture checks"), Analysed(w) -> w }

fn index_of(analysis: Analysis, name: Bytes) -> Int =
  fold(range(0, len(analysis.mods)), -1, |found: Int, i: Int|
    if name_at(analysis.mods, i) == name { i } else { found })

fn claimed(cs: List<Claim>) -> List<Bytes> =
  fold(cs, [], |acc: List<Bytes>, c: Claim| match c { ClaimDef(d) -> push(acc, d.name), _ -> acc })

fn owed(analysis: Analysis, owner: String) -> Obligation / {abort.raise} =
  match fold(
      world_of(analysis, world::every).world.obligations,
      None,
      |found: Option<Obligation>, o: Obligation| if o.owner == owner { Some(o) } else { found },
    ) {
    Some(o) -> o,
    None -> panic("an obligation of the fixture"),
  }

test "the claims asked for are a module's and everything it imports, and nothing else" {
  let sources = [
    { name: b"base", src: b"pub fn one() -> Int = 1\n" },
    {
      name: b"app",
      src: b"import base\nfn two() -> Int ensures result == 2 = base::one() + base::one()\n",
    },
    { name: b"side", src: b"fn zero(x: Int) -> Int ensures result == 0 = x - x\n" },
  ];
  let w = whole_of(sources);
  let names = claimed(claims_for(w, [index_of(w, b"app")]));
  assert(fold(names, false, |f: Bool, n: Bytes| f || n == b"base.one"));
  assert(fold(names, false, |f: Bool, n: Bytes| f || n == b"app.two"));
  assert(!fold(names, false, |f: Bool, n: Bytes| f || n == b"side.zero"))
}

test "an obligation is settled by what the prover decides, and only when its strategy asks" {
  let sources = [
    {
      name: b"m",
      src: b"fn same(x: Int) -> Int ensures result == x = x\nfn bump(x: Int) -> Int requires x < 10 ensures result > x = x + 1\nfn never(x: Int) -> Int requires x > 0 && x < 0 ensures result == 0 = x\n",
    },
  ];
  let w = whole_of(sources);
  let p = prover_of(claims_for(w, [0]), world_of(w, world::every).world, 10000);
  assert(match settled(p, owed(w, "m.same")) { Certified(_) -> true, _ -> false });
  // The guard is not valid, so only a kept case shows it admits a value.
  let bump = owed(w, "m.bump");
  assert(match settled(p, bump) { Unwitnessed(_) -> true, _ -> false });
  assert(settled(p, owed(w, "m.never")) == GuardRefuted);
  // An interleaving search never starts at the static prover, so nothing settles it.
  assert(settled(p, { ..bump, strategy: Interleave(Drawn) }) == Undecided);
  assert(diagnosed(p, { ..bump, strategy: Interleave(Drawn) }) == None);
  // Nor a cost law's fit, which is measured.
  assert(settled(p, { ..bump, strategy: Fitting }) == Undecided);
  assert(diagnosed(p, { ..bump, strategy: Fitting }) == None)
}

test "a `cost` clause its body shows settles the law it became, and one it does not is left to the fit" {
  let sources = [
    {
      name: b"m",
      src: b"fn total(xs: List<Int>) -> Int cost len(xs) = fold(xs, 0, |a: Int, x: Int| a + x)\nfn wrong(xs: List<Int>) -> Int cost 1 = fold(xs, 0, |a: Int, x: Int| a + x)\n",
    },
  ];
  let w = whole_of(sources);
  let p = prover_of(claims_for(w, [0]), world_of(w, world::every).world, 10000);
  assert(match settled(p, owed(w, "m.cost of total")) {
    Certified(s) -> s.rules == [CostBound({ def: "m.total" })],
    _ -> false,
  });
  let wrong = owed(w, "m.cost of wrong");
  assert_eq(settled(p, wrong), Undecided);
  assert(match diagnosed(p, wrong) {
    Some(d) ->
      d.blockers
        == [
          Unbounded(
            "its steps are not within a constant times the bound at every size, zero included",
          ),
        ],
    None -> false,
  })
}

test "a module the run does not own is claimed by its specifications, and a transparent definition by its body" {
  let sources = [
    {
      name: b"base",
      src: b"pub transparent fn same(x: Int) -> Int = x\npub fn kept(x: Int) -> Int = x\n",
    },
    {
      name: b"app",
      src: b"import base\nfn quad(x: Int) -> Int ensures result == x = base::same(x)\nfn also(x: Int) -> Int ensures result == x = base::kept(x)\n",
    },
  ];
  let w = whole_of(sources);
  let mine = |m: Bytes| m == b"app";
  let p = prover_of(claims_for(w, [index_of(w, b"app")], mine), world_of(w, mine).world, 10000);
  assert(match settled(p, owed(w, "app.quad")) { Certified(_) -> true, _ -> false });
  assert(match settled(p, owed(w, "app.also")) { Certified(_) -> false, _ -> true })
}
