// `evidence` — what a discharge established, as the store files it: the tier it was filed under
// beside the evidence, encoded with `bin`. An entry is believed only when the tier it was filed under
// is the one its evidence earns and a proof established its guard.

import std.bin
import obligation (Cases, Certificate, Evidence, Example, Fitted, Instantiation, Measured, Proof,
                   Property, Proved, Sampled, Tier, fit_tier, tier_word, tier_bin, evidence_bin)
import fit (Fit, sizes)
import rules (Rule, CaseSplit, Congruence, ExhaustiveEnumeration, ExhaustiveInterleaving,
              GroundEvaluation, Induction, Injectivity, LinearArithmetic, Propositional, Unfold)
import property (min_property_cases)

// How strong the evidence is: a certificate proves, enough kept cases are a property, and a fit over
// enough sizes is a trend.
pub fn evidence_tier(e: Evidence) -> Tier =
  match e {
    Proof(_) -> Proved,
    Sampled(c) -> if c.kept >= min_property_cases() { Property } else { Example },
    Measured(f) -> fit_tier(f),
  }

type Filed = { tier: Tier, evidence: Evidence }

derive bin for Filed

pub fn evidence_bytes(e: Evidence) -> Bytes / {abort.raise} =
  bin::encode({ tier: evidence_tier(e), evidence: e }, filed_bin())

// What a store entry says, when it is evidence a discharge could have filed.
pub fn evidence_of(b: Bytes) -> Result<Evidence, String> / {abort.raise} =
  match bin::decode(b, filed_bin()) {
    Err(e) -> Err(bin::error_to_string(e)),
    Ok(f) -> believed(f.tier, f.evidence),
  }

// A decode that succeeds can still hold a tier its evidence does not earn, or a proof that never
// established its guard.
fn believed(tier: Tier, e: Evidence) -> Result<Evidence, String> =
  if tier != evidence_tier(e) {
    Err(
      "an entry labelled `" ++ tier_word(tier) ++ "` whose evidence is `"
        ++ tier_word(evidence_tier(e))
        ++ "`",
    )
  } else {
    match e {
      Proof(c) -> if c.guard_satisfiable { Ok(e) }
      else { Err("a proof that did not establish its guard") },
      Sampled(_) -> Ok(e),
      Measured(_) -> Ok(e),
    }
  }

// --- Tests ------------------------------------------------------------------

fn a_certificate() -> Certificate =
  {
    rules: [
      GroundEvaluation,
      ExhaustiveEnumeration({ domain: "Bool", points: 2 }),
      CaseSplit({ ty: "m.Shape", arms: 3 }),
      Unfold({ def: "m.f", depth: 2 }),
      Induction({ binder: "n", def: "m.f" }),
      ExhaustiveInterleaving(12),
      LinearArithmetic,
      Propositional,
      Congruence,
      Injectivity,
    ],
    steps: 41,
    guard_satisfiable: true,
    sorts: ["a"],
  }

fn a_sample(kept: Int) -> Cases =
  {
    generated: 200,
    kept: kept,
    rejected: 200 - kept,
    roots: [0, 3],
    instantiations: [{ var: "a", ty: "Int" }],
  }

fn a_fit(top: Int) -> Fit =
  {
    measures: map(filter(sizes(), |n: Int| n <= top), |n: Int|
      { size: n, steps: 3 * n + 4, bound: n }),
    spent: None,
  }

test "evidence reads back as it was filed, every rule included" {
  let proof = Proof(a_certificate());
  assert_eq(evidence_of(evidence_bytes(proof)), Ok(proof));
  let sample = Sampled(a_sample(30));
  assert_eq(evidence_of(evidence_bytes(sample)), Ok(sample));
  let fit = Measured({ ..a_fit(4096), spent: Some({ size: 8192, limit: 10000000 }) });
  assert_eq(evidence_of(evidence_bytes(fit)), Ok(fit))
}

test "a fit over enough sizes is fitted, and over fewer an example" {
  assert_eq(evidence_tier(Measured(a_fit(4096))), Fitted);
  assert_eq(evidence_tier(Measured(a_fit(128))), Fitted);
  assert_eq(evidence_tier(Measured(a_fit(64))), Example);
  let relabelled = bin::encode({ tier: Fitted, evidence: Measured(a_fit(64)) }, filed_bin());
  assert_eq(evidence_of(relabelled), Err("an entry labelled `fitted` whose evidence is `example`"))
}

test "only a certificate is proved, and the kept count alone separates property from example" {
  assert_eq(evidence_tier(Proof(a_certificate())), Proved);
  assert_eq(evidence_tier(Sampled(a_sample(min_property_cases()))), Property);
  assert_eq(evidence_tier(Sampled(a_sample(min_property_cases() - 1))), Example);
  assert_eq(evidence_tier(Sampled(a_sample(0))), Example)
}

test "an entry is believed only with the tier its evidence earns and a guard a proof established" {
  let relabelled = bin::encode({ tier: Proved, evidence: Sampled(a_sample(3)) }, filed_bin());
  assert_eq(evidence_of(relabelled), Err("an entry labelled `proved` whose evidence is `example`"));
  let vacuous = evidence_bytes(Proof({ ..a_certificate(), guard_satisfiable: false }));
  assert_eq(evidence_of(vacuous), Err("a proof that did not establish its guard"));
  assert(evidence_of(b"not evidence") != Ok(Proof(a_certificate())))
}
