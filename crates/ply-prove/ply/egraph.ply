// `egraph` — union-find over terms, and the two structural rules a constructor obeys.

import term (Terms, Node, TInt, TBool, TStr, TDecimal, TCtor, TNil, TCons, TApp, TOpaque, TRecord,
             node, size)

pub type Pair = { a: Int, b: Int }

// Every term points straight at its class's least id, which is the class's representative.
pub type Classes = { parent: List<Int>, diseqs: List<Pair>, contradiction: Bool }

// The classes after a union, and whether the two were not already one.
pub type Joined = { cs: Classes, changed: Bool }

pub fn classes(n: Int) -> Classes = { parent: range(0, n), diseqs: [], contradiction: false }

// Terms made after this branch started join as their own classes.
pub fn grow(cs: Classes, n: Int) -> Classes =
  if len(cs.parent) >= n { cs } else {
    {
      ..cs,
      parent: fold(range(len(cs.parent), n), cs.parent, |acc: List<Int>, i: Int| push(acc, i)),
    }
  }

pub fn find(cs: Classes, t: Int) -> Int = match list_at(cs.parent, t) { Some(p) -> p, None -> t }

// The lower id is kept, so representatives do not depend on the order of assertion.
pub fn union(cs: Classes, a: Int, b: Int) -> Joined = {
  let ra = find(cs, a);
  let rb = find(cs, b);
  if ra == rb { { cs: cs, changed: false } } else {
    let keep = if ra < rb { ra } else { rb };
    let drop = if ra < rb { rb } else { ra };
    {
      cs: { ..cs, parent: map(cs.parent, |p: Int| if p == drop { keep } else { p }) },
      changed: true,
    }
  }
}

pub fn equal(cs: Classes, a: Int, b: Int) -> Bool = find(cs, a) == find(cs, b)

pub fn distinguish(cs: Classes, a: Int, b: Int) -> Classes =
  { ..cs, diseqs: push(cs.diseqs, { a: a, b: b }) }

pub fn has_diseq(cs: Classes, a: Int, b: Int) -> Bool =
  fold(cs.diseqs, false, |found: Bool, d: Pair| found || (d.a == a && d.b == b))

pub fn check_diseqs(cs: Classes) -> Classes =
  if fold(cs.diseqs, false, |found: Bool, d: Pair| found || equal(cs, d.a, d.b)) {
    { ..cs, contradiction: true }
  } else { cs }

// Each class's representative and members, in order of first appearance.
pub fn groups(cs: Classes, n: Int) -> List<{ rep: Int, members: List<Int> }> / {abort.raise} = {
  let placed = fold(
    range(0, n),
    { out: [], at: map_new() },
    |acc: { out: List<{ rep: Int, members: List<Int> }>, at: Map<Int, Int> }, t: Int| {
      let rep = find(cs, t);
      match map_get(acc.at, rep) {
        Some(i) -> match list_at(acc.out, i) {
          Some(g) ->
            { out: list_set(acc.out, i, { rep: g.rep, members: push(g.members, t) }), at: acc.at },
          None -> acc,
        },
        None ->
          {
            out: push(acc.out, { rep: rep, members: [t] }),
            at: map_insert(acc.at, rep, len(acc.out)),
          },
      }
    },
  );
  placed.out
}

// What a term's head says about its value, for the injectivity and disjointness rules.
pub type Shape =
  | SInt(Int)
  | SBool(Bool)
  | SStr(String)
  | SDecimal(Decimal)
  | SCtor(String)
  | SNil
  | SCons
  | SRecord(List<String>)

pub fn shape_of(ts: Terms, t: Int) -> Option<Shape> / {abort.raise} =
  match node(ts, t) {
    TInt(k) -> Some(SInt(k)),
    TBool(b) -> Some(SBool(b)),
    TStr(s) -> Some(SStr(s)),
    TDecimal(d) -> Some(SDecimal(d)),
    TCtor(c) -> Some(SCtor(c.name)),
    TNil -> Some(SNil),
    TCons(_) -> Some(SCons),
    // `push` always answers a cons, so its result is never `[]`.
    TApp(a) -> match node(ts, a.head) {
      TOpaque(name) -> if name == "push" { Some(SCons) } else { None },
      _ -> None,
    },
    TRecord(fields) -> Some(SRecord(map(fields, |f: { name: String, value: Int }| f.name))),
    _ -> None,
  }

// Whether two shapes of one kind name different values; `None` when they are not of one kind.
pub fn conflict(a: Shape, b: Shape) -> Option<Bool> =
  match a {
    SInt(x) -> match b { SInt(y) -> Some(x != y), _ -> None },
    SBool(x) -> match b { SBool(y) -> Some(x != y), _ -> None },
    SStr(x) -> match b { SStr(y) -> Some(x != y), _ -> None },
    SDecimal(x) -> match b { SDecimal(y) -> Some(x != y), _ -> None },
    SNil -> match b { SNil -> Some(false), SCons -> Some(true), _ -> None },
    SCons -> match b { SCons -> Some(false), SNil -> Some(true), _ -> None },
    SCtor(x) -> match b { SCtor(y) -> Some(x != y), _ -> None },
    SRecord(x) -> match b { SRecord(y) -> Some(x != y), _ -> None },
  }

test "a union keeps the lower id, and a union of one class changes nothing" {
  let j = union(classes(4), 3, 1);
  assert(j.changed);
  assert_eq(find(j.cs, 3), 1);
  assert(!union(j.cs, 1, 3).changed);
  assert_eq(groups(j.cs, 4), [
    { rep: 0, members: [0] },
    { rep: 1, members: [1, 3] },
    { rep: 2, members: [2] },
  ])
}

test "a disequality between one class is a contradiction" {
  let cs = distinguish(classes(3), 0, 2);
  assert(!check_diseqs(cs).contradiction);
  assert(check_diseqs(union(cs, 0, 2).cs).contradiction)
}

test "shapes of one kind conflict exactly when their values differ" {
  assert_eq(conflict(SInt(1), SInt(2)), Some(true));
  assert_eq(conflict(SDecimal(1.5m), SDecimal(1.50m)), Some(false));
  assert_eq(conflict(SNil, SCons), Some(true));
  assert_eq(conflict(SCtor("a"), SInt(1)), None)
}

test "a class representative does not depend on the union order" {
  let forward = union(union(classes(4), 0, 1).cs, 1, 2).cs;
  let backward = union(union(classes(4), 2, 1).cs, 1, 0).cs;
  assert_eq(find(forward, 2), find(backward, 0));
  assert_eq(find(forward, 2), 0)
}

test "shapes of different kinds conclude nothing" {
  assert_eq(conflict(SInt(1), SBool(true)), None);
  assert_eq(conflict(SNil, SInt(0)), None);
  assert_eq(conflict(SInt(1), SInt(1)), Some(false))
}
