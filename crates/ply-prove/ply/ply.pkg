import std.pkg (Manifest)

// The prove package: what an obligation's result is filed under, as Ply. The key an obligation is
// cached by is a function of the plan that discharged it, so a proof and a sample can never share an
// entry; the arithmetic that decides what a finite domain covers lives beside it.
fn package() -> Manifest = {
  name: "prove",
  version: { major: 0, minor: 1, patch: 0 },
  // Reached as `proof.*`, since a program with a `prove` module of its own cannot also reach a
  // package by that name.
  prefix: Some("proof"),
  runtime: { major: 0, minor: 16, patch: 0 },
  dependencies: [],
  entry: None,
}
