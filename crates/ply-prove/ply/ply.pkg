import std.pkg (Manifest)

// The prove package: the prover's decisions, as Ply. Which search discharges each obligation, what a
// finite domain covers, and the key a result is filed under — a function of the plan that
// discharged it, so a proof and a sample can never share an entry — are decided here, and the
// runtime carries them out.
fn package() -> Manifest = {
  name: "prove",
  version: { major: 0, minor: 1, patch: 0 },
  // Reached as `proof.*`, since a program with a `prove` module of its own cannot also reach a
  // package by that name.
  prefix: Some("proof"),
  runtime: { major: 0, minor: 16, patch: 0 },
  dependencies: [
    {
      name: "sim",
      prefix: None,
      min: { major: 0, minor: 1, patch: 0 },
      source: Path("../../ply-sim/ply"),
    },
  ],
  entry: None,
}
