//! The memory a call holds beyond what it is handed, read off its body as monomials over its
//! parameters' sizes, each up to a constant factor: every object it makes, though it let some go
//! before it returns, and a frame for each call back into itself that is not a tail call. A number
//! is no object. A body is read with each argument held by nothing else, all the way down, as an
//! update in place needs: an update of a value something else holds copies it, and a constructor
//! built after a `match` let go of a subject held once takes the subject's cells, as compiled code
//! does.

import compiler.code (Code, Owned, NLit, NVar, NUnary, NBinary, NApp, NKnown, NIf, NBlock, NList,
                      NRecord, NMatch, NPerform, NLabel, NLambda, NSimulate, NParallel, NHandle,
                      NField, NUpdate, CodeStmt, CLet, CLetPat, CDo, CodeField, CodeArm,
                      CodePattern, PxVar, PxCtor, PxRecord, PxList, CodePatternField, Capture)
import compiler.front (ClaimClause)
import compiler.infer (Builtin, builtins)
import compiler.items (SSpace)
import compiler.patterns (Lit, LInt, LStr, LBytes, LEmbedded)
import compiler.types (Type, TyCon, TyFn, TyRecord)
import compiler.semantics (Iterates, Handed, Threaded, Taken, Number, Mapped, Kept, Folded, Updated,
                           Unstated)
import context (Context, Def, ctor, signature, is_recursive)
import cost (Poly, Of, Same, Part, Other, Found, OnTail, OnIndex, zero, constant, size_of, plus,
             product, at_args, ceiling_of, callees, reachable, params_sized, arithmetic,
             holding_keyed, descent, descent_calls, kept, is_length, dominated, stated, cx_owning,
             found_by, takes_some, toward, assumed, possible, literal_size, calls_made,
             iterating_of)
import domain (Ty, Fn, Con, Record)
import std.list

/// Who else holds a value: `Alone`, nothing, nor anything it holds; `Top`, nothing, though what it
/// holds may be held elsewhere; `Many`, something.
type Holders = | Alone | Top | Many

/// A local as `cost` reads one, the space one call of it takes where it is a function, who else
/// holds it, and whether it is a number, which nothing holds.
type Slot = { size: Option<Poly>, of: Of, fun: Option<Poly>, holders: Holders, number: Bool }

/// Where a path stands: each local, and the constructor a `match` let go of, whose cells the next
/// one built of it takes.
type State = { slots: List<Slot>, credit: Option<Bytes> }

/// What walking an expression finds: the state after it; the space it holds on any path, and on
/// the paths that call back into the definition being read; what it is, as a local is; the local it
/// reads, where that local goes on holding it; how many calls back one path makes, and the
/// arguments of each; and whether each of those hands every parameter that is not a number a value
/// held alone.
type Walked = {
  state: State,
  space: Poly,
  looped: Poly,
  size: Option<Poly>,
  of: Of,
  fun: Option<Poly>,
  holders: Holders,
  number: Bool,
  read: Option<Int>,
  calls: Int,
  back: List<List<Of>>,
  handed: Bool,
}

/// A definition's space and who else holds what it answers, read with each argument held alone and
/// with each held anywhere.
type Known = { alone: Result<Spent, String>, anyhow: Result<Spent, String> }

type Spent = { space: Poly, holders: Holders }

/// What a builtin answers: a number, an `Option` of one, or any other value.
type Answer = | ANumber | AOptionNumber | AValue

/// `own` is the definition being read, and `numbers` which of its parameters are numbers; `known`,
/// what it calls; `answers`, what each builtin answers; `lambda`, whether the walk is inside a
/// function value, whose code is read letting no subject go; `tail`, whether nothing in the frame
/// follows the expression; `empty`, a list parameter known empty; `found`, where `List::at` answered
/// `Some` on the path; `missed`, where it answers `None`.
type Env = {
  cx: Context,
  own: String,
  numbers: List<Bool>,
  known: Map<String, Known>,
  answers: Map<String, Answer>,
  lambda: Bool,
  tail: Bool,
  empty: Option<Int>,
  found: List<Found>,
  missed: Option<Found>,
}

/// The bound a `space` clause states, read from below as a `cost` bound is, where `0` is no space
/// that grows with what a call is given.
pub fn stated_space(bound: Code, params: Int) -> Option<Poly> =
  match bound.node {
    NLit(l) -> match l {
      LInt(k) -> if k == 0 { Some(zero()) } else { stated(bound, params, []) },
      _ -> None,
    },
    _ -> stated(bound, params, []),
  }

/// The bound on the space a call of `def` holds, over its parameters' sizes, with each argument held
/// alone; what it reaches is read first, as `steps` reads it.
pub fn space(cx: Context, def: String) -> Result<Poly, String> / {abort.raise} = {
  let answers = answers_of_builtins();
  let reach = reachable(cx, def);
  let known = iterate(Map::new(), reach.len() + 1, |known: Map<String, Known>| {
    let ready = reach.filter(|n: String|
      !known.contains(n)
        && callees(cx, n).fold(true, |all: Bool, c: String| all && (c == n || known.contains(c))));
    if ready.len() == 0 { Stop(known) } else {
      Continue(
        ready.fold(known, |k: Map<String, Known>, n: String|
          k.insert(n, known_of(cx, answers, n, k))),
      )
    }
  });
  match holding_keyed(cx, reach) {
    Some(n) ->
      Err(
        "`" ++ n
          ++ "` holds a value compared by its type's `key`, which a comparison calls and no body shows",
      ),
    None -> match known.get(def) {
      Some(k) -> match spent_for(k, true) { Ok(s) -> Ok(s.space), Err(why) -> Err(why) },
      None -> Err("`" ++ def ++ "` reaches definitions that call each other"),
    },
  }
}

/// What a definition holds for arguments held alone, which what it holds for any also bounds.
fn spent_for(k: Known, once: Bool) -> Result<Spent, String> =
  if !once { k.anyhow } else {
    match k.alone {
      Ok(s) -> Ok(s),
      Err(why) -> match k.anyhow { Ok(s) -> Ok(s), Err(_) -> Err(why) },
    }
  }

fn known_of(
  cx: Context,
  answers: Map<String, Answer>,
  def: String,
  known: Map<String, Known>,
) -> Known / {abort.raise} =
  match cx.claims.defs.get(def) {
    None -> {
      let why = "`" ++ def ++ "` has no body here to read";
      { alone: Err(why), anyhow: Err(why) }
    },
    Some(d) -> match d.moved {
      None ->
        {
          alone: promised(def, d),
          anyhow: Err(
            "`" ++ def
              ++ "` is handed a value something else holds, and its `space` bound is for arguments held alone",
          ),
        },
      Some(body) ->
        {
          alone: held(cx, answers, def, d.params, body, known, true),
          anyhow: held(cx, answers, def, d.params, body, known, false),
        },
    },
  }

/// A definition read by its contract, as another package's is: its first `space` bound read from
/// above.
fn promised(def: String, d: Def) -> Result<Spent, String> =
  match d.spec.filter(|c: ClaimClause| c.kind == SSpace).fold(
      None,
      |found: Option<Poly>, c: ClaimClause|
        match found {
          Some(_) -> found,
          None -> match c.clause.code { Some(b) -> ceiling_of(b, d.params), None -> None },
        },
    ) {
    Some(p) -> Ok({ space: p, holders: Many }),
    None ->
      Err("`" ++ def ++ "` has no body here to read, and no `space` bound to read as its space"),
  }

/// The space a call of `def` holds, its parameters held alone or each held anywhere. A recursion
/// whose paths that call back hold nothing more, and call back last, holds what the path that ends
/// does, with no parameter it grows with grown on the way; any other is read as `steps` reads one.
fn held(
  cx: Context,
  answers: Map<String, Answer>,
  def: String,
  params: Int,
  body: Code,
  known: Map<String, Known>,
  alone: Bool,
) -> Result<Spent, String> / {abort.raise} = {
  let sized = params_sized(cx, def, params);
  let numbers = numbers_of(cx, def, params);
  let env = {
    cx: cx,
    own: def,
    numbers: numbers,
    known: known,
    answers: answers,
    lambda: false,
    tail: true,
    empty: None,
    found: [],
    missed: None,
  };
  let start = {
    slots: range(0, params).map(|i: Int| {
      let number = at_or(numbers, i);
      {
        size: if at_or(sized, i) { Some(size_of(i)) } else { None },
        of: Same(i),
        fun: None,
        holders: if alone || number { Alone } else { Many },
        number: number,
      }
    }),
    credit: None,
  };
  match walk(env, start, body) {
    Err(why) -> Err(why),
    Ok(w) -> if !is_recursive(cx, def) { Ok({ space: w.space, holders: w.holders }) }
    else if !cx.self_recursive.contains(def) { Err("`" ++ def ++ "` is in a group with others") }
    else if alone && !w.handed { Err("`" ++ def ++ "` hands itself a value something else holds") }
    else if w.looped == zero() {
      if kept(w.space, w.back) { Ok({ space: w.space, holders: w.holders }) }
      else { Err("`" ++ def ++ "` hands on a parameter its space grows with, changed") }
    } else {
      match descent(def, w.calls, w.back, w.space, "space grows") {
        Err(why) -> Err(why),
        Ok(None) -> Ok({ space: w.space, holders: w.holders }),
        // As `steps` reads it: a call enters with no element of that list left at most once.
        Ok(Some(d)) -> match match d {
            OnTail(p) ->
              walk(
                { ..env, empty: Some(p) },
                { ..start, slots: start.slots.set(p, { ..slot_at(start, p), size: Some(zero()) }) },
                body,
              ),
            OnIndex(f) -> walk({ ..env, missed: Some(f) }, start, body),
          } {
          Err(why) -> Err(why),
          Ok(e) -> match product(descent_calls(d), w.space) {
            Ok(chain) -> Ok({ space: plus(chain, e.space), holders: weaker(w.holders, e.holders) }),
            Err(why) -> Err(why),
          },
        },
      }
    },
  }
}

// --- Holders and states -------------------------------------------------------------------------

fn weaker(a: Holders, b: Holders) -> Holders =
  if a == Many || b == Many { Many } else if a == Top || b == Top { Top } else { Alone }

/// A value made of `parts` is held alone where each part is, and else is held once at its top.
fn made_of(parts: List<Holders>) -> Holders =
  if parts.fold(true, |all: Bool, h: Holders| all && h == Alone) { Alone } else { Top }

/// Who else holds what a walk found, a number being held by nothing.
fn part_of(w: Walked) -> Holders = if w.number { Alone } else { w.holders }

fn held_alone(w: Walked) -> Bool = part_of(w) == Alone

fn unknown_slot() -> Slot = { size: None, of: Other, fun: None, holders: Many, number: false }

fn slot_at(st: State, k: Int) -> Slot =
  match st.slots.at(k) { Some(s) -> s, None -> unknown_slot() }

fn slot_of(w: Walked) -> Slot =
  { size: w.size, of: w.of, fun: w.fun, holders: w.holders, number: w.number }

fn bind(st: State, k: Int, s: Slot) -> State / {abort.raise} = {
  let grown = if st.slots.len() <= k {
    range(st.slots.len(), k + 1).fold(st.slots, |acc: List<Slot>, _i: Int| acc.push(unknown_slot()))
  } else { st.slots };
  { ..st, slots: grown.set(k, s) }
}

/// The state once the local a value was read from goes on holding it beside whatever took it as
/// `to` says: `Many` where the value is held whole, `Top` where only parts of it are.
fn retain(st: State, read: Option<Int>, to: Holders) -> State =
  match read {
    None -> st,
    Some(k) -> match st.slots.at(k) {
      Some(s) -> if s.number { st }
      else { { ..st, slots: st.slots.set(k, { ..s, holders: weaker(s.holders, to) }) } },
      None -> st,
    },
  }

/// Where two paths meet: each local held as the weaker path holds it, and a constructor's cells left
/// over only where both left them.
fn merged(a: State, b: State) -> State =
  {
    slots: range(0, max(a.slots.len(), b.slots.len())).map(|i: Int|
      match ((a.slots.at(i), b.slots.at(i))) {
        (Some(x), Some(y)) -> { ..x, holders: weaker(x.holders, y.holders) },
        (Some(x), None) -> x,
        (None, Some(y)) -> y,
        _ -> unknown_slot(),
      }),
    credit: if a.credit == b.credit { a.credit } else { None },
  }

fn none(st: State) -> Walked =
  {
    state: st,
    space: zero(),
    looped: zero(),
    size: None,
    of: Other,
    fun: None,
    holders: Alone,
    number: false,
    read: None,
    calls: 0,
    back: [],
    handed: true,
  }

/// `w`, then an object of `p` words made.
fn made(w: Walked, p: Poly) -> Walked =
  { ..w, space: plus(w.space, p), looped: if w.calls > 0 { plus(w.looped, p) } else { w.looped } }

/// `a`, then `b`: a path that calls back through either holds what the other holds too.
fn then(a: Walked, b: Walked) -> Walked =
  {
    state: b.state,
    space: plus(a.space, b.space),
    looped: plus(if a.calls > 0 { plus(a.looped, b.space) } else { zero() }, if b.calls > 0 {
      plus(a.space, b.looped)
    } else { zero() }),
    size: b.size,
    of: b.of,
    fun: b.fun,
    holders: b.holders,
    number: b.number,
    read: b.read,
    calls: a.calls + b.calls,
    back: a.back.concat(b.back),
    handed: a.handed && b.handed,
  }

/// Either branch.
fn either(a: Walked, b: Walked) -> Walked =
  {
    state: merged(a.state, b.state),
    space: plus(a.space, b.space),
    looped: plus(a.looped, b.looped),
    size: match ((a.size, b.size)) { (Some(x), Some(y)) -> Some(plus(x, y)), _ -> None },
    of: Other,
    fun: match ((a.fun, b.fun)) { (Some(x), Some(y)) -> Some(plus(x, y)), _ -> None },
    holders: weaker(part_of(a), part_of(b)),
    number: a.number && b.number,
    read: None,
    calls: max(a.calls, b.calls),
    back: a.back.concat(b.back),
    handed: a.handed && b.handed,
  }

/// A value of `w`'s walk, with nothing of what it is beyond who holds it.
fn valued(w: Walked, holders: Holders, number: Bool) -> Walked =
  { ..w, size: None, of: Other, fun: None, holders: holders, number: number, read: None }

// --- The walk -----------------------------------------------------------------------------------

fn walk(env: Env, st: State, c: Code) -> Result<Walked, String> / {abort.raise} =
  match c.node {
    NLit(l) -> Ok(literal(st, l)),
    NVar(v) ->
      Ok(match v.slot {
        Some(k) -> {
          let s = slot_at(st, k);
          let moved = c.own == Owned || s.number;
          {
            ..none(st),
            size: s.size,
            of: s.of,
            fun: s.fun,
            number: s.number,
            holders: if moved { s.holders } else { Many },
            read: if moved { None } else { Some(k) },
          }
        },
        None -> { ..none(st), fun: fun_named(env, String::of_bytes_lossy(v.name)), holders: Many },
      }),
    NLabel(_) -> Ok(none(st)),
    NUnary(u) -> match walk({ ..env, tail: false }, st, u.operand) {
      Err(why) -> Err(why),
      Ok(w) -> Ok({ ..w, of: Other, fun: None, holders: Alone, number: true, read: None }),
    },
    NBinary(b) -> binary(env, st, b.op, b.lhs, b.rhs),
    NIf(i) -> match walk({ ..env, tail: false }, st, i.cond) {
      Err(why) -> Err(why),
      Ok(cond) -> {
        let slots = |k: Int| slot_at(st, k).of;
        let branch = |truth: Bool, c: Code| {
          let holds = assumed(slots, i.cond, truth);
          if possible(holds, env.missed) {
            Some(walk({ ..env, found: env.found.concat(holds) }, cond.state, c))
          } else { None }
        };
        match ((branch(true, i.then_branch), branch(false, i.else_branch))) {
          (Some(Err(why)), _) -> Err(why),
          (_, Some(Err(why))) -> Err(why),
          (Some(Ok(t)), Some(Ok(e))) -> Ok(then(cond, either(t, e))),
          (Some(Ok(t)), None) -> Ok(then(cond, t)),
          (None, Some(Ok(e))) -> Ok(then(cond, e)),
          (None, None) -> Ok(cond),
        }
      },
    },
    NBlock(b) -> block(env, st, b.stmts, b.tail),
    NList(l) -> match walked_all(env, st, l.items, |_i: Int| Some(Many)) {
      Err(why) -> Err(why),
      Ok(a) ->
        Ok({
          ..valued(made(a.walked, constant()), made_of(a.all.map(part_of)), false),
          size: Some(constant()),
        }),
    },
    NRecord(r) -> match walked_all(env, st, r.fields.map(|f: CodeField| f.value), |_i: Int|
        Some(Many)) {
      Err(why) -> Err(why),
      Ok(a) -> Ok(valued(made(a.walked, constant()), made_of(a.all.map(part_of)), false)),
    },
    NField(f) -> match walk({ ..env, tail: false }, st, f.base) {
      Err(why) -> Err(why),
      Ok(w) -> Ok(valued({ ..w, state: retain(w.state, w.read, Top) }, Many, false)),
    },
    // The written fields are read before the base, as compiled code reads them.
    NUpdate(u) -> match walked_all(env, st, u.sets.map(|f: CodeField| f.value), |_i: Int|
        Some(Many)) {
      Err(why) -> Err(why),
      Ok(a) -> match walk({ ..env, tail: false }, a.walked.state, u.base) {
        Err(why) -> Err(why),
        Ok(b) -> {
          let base = { ..b, state: retain(b.state, b.read, Top) };
          Ok(
            valued(
              made(then(a.walked, base), constant()),
              made_of(a.all.map(part_of).push(part_of(b))),
              false,
            ),
          )
        },
      },
    },
    NMatch(m) -> match walk({ ..env, tail: false }, st, m.scrutinee) {
      Err(why) -> Err(why),
      Ok(s) -> {
        let subject = { ..s, state: retain(s.state, s.read, Top) };
        let at = found_by(|k: Int| slot_at(st, k).of, m.scrutinee);
        match arms(env, subject, m.scrutinee, at, m.arms) {
          Err(why) -> Err(why),
          Ok(a) -> Ok(then(subject, a)),
        }
      },
    },
    NApp(a) -> application(env, st, a.func, a.args),
    NKnown(_) -> panic("only the emitter writes a read as a known lambda"),
    // A raise ends the call; any other operation runs a handler the bound does not read.
    NPerform(p) -> if p.effect != b"abort" {
      Err("an operation whose handler the bound does not read")
    } else {
      match walked_all(env, st, p.args, |_i: Int| Some(Many)) {
        Err(why) -> Err(why),
        Ok(a) -> Ok(valued(made(a.walked, constant()), Many, false)),
      }
    },
    NLambda(l) -> {
      let caught = l.captures.fold(st, |s: State, cap: Capture|
        if cap.own == Owned { s } else { retain(s, Some(cap.src), Many) });
      let fun = match lambda_walk(
          env,
          st,
          l.params,
          l.captures,
          l.body,
          range(0, l.params).map(|_i: Int| unknown_slot()),
        ) {
        Ok(w) -> if w.calls > 0 { None } else { Some(w.space) },
        Err(_) -> None,
      };
      Ok({ ..made(none(caught), constant()), fun: fun, holders: Top })
    },
    NSimulate(_) -> Err("a `simulate` region the bound does not read"),
    NParallel(_) -> Err("a `parallel` block the bound does not read"),
    NHandle(_) -> Err("a handler the bound does not read"),
  }

/// A literal is a constant, held by the program where it is text.
fn literal(st: State, l: Lit) -> Walked =
  match l {
    LInt(n) -> { ..none(st), size: Some(literal_size(n)), number: true },
    LStr(_) -> { ..none(st), size: Some(constant()), holders: Many },
    LBytes(_) -> { ..none(st), size: Some(constant()), holders: Many },
    LEmbedded(_, _) -> { ..none(st), size: Some(constant()), holders: Many },
    _ -> { ..none(st), number: true },
  }

/// Each of `cs` walked in turn, a local read and not moved held after as `keeps` says of its place:
/// once more by what takes it, or not at all.
fn walked_all(
  env: Env,
  st: State,
  cs: List<Code>,
  keeps: (Int) -> Option<Holders>,
) -> Result<{ walked: Walked, all: List<Walked> }, String> / {abort.raise} =
  range(0, cs.len()).fold(
    Ok({ walked: none(st), all: [] }),
    |acc: Result<{ walked: Walked, all: List<Walked> }, String>, i: Int|
      match acc {
        Err(_) -> acc,
        Ok(sofar) -> match cs.at(i) {
          None -> acc,
          Some(c) -> match walk({ ..env, tail: false }, sofar.walked.state, c) {
            Err(why) -> Err(why),
            Ok(w) -> {
              let after = match keeps(i) { Some(h) -> retain(w.state, w.read, h), None -> w.state };
              Ok({ walked: then(sofar.walked, { ..w, state: after }), all: sofar.all.push(w) })
            },
          },
        },
      },
  )

fn binary(
  env: Env,
  st: State,
  op: Bytes,
  lhs: Code,
  rhs: Code,
) -> Result<Walked, String> / {abort.raise} =
  match walk({ ..env, tail: false }, st, lhs) {
    Err(why) -> Err(why),
    Ok(l) -> {
      let short = op == b"and" || op == b"or";
      match walk({ ..env, tail: env.tail && short }, l.state, rhs) {
        Err(why) -> Err(why),
        Ok(r) -> if op == b"concat" { appended(l, r) } else {
          Ok({
            ..valued(then(l, r), Alone, true),
            size: arithmetic(op, l.size, r.size),
            of: toward(env.found, op, l.of, rhs, r.of, lhs),
          })
        },
      }
    },
  }

/// `a ++ b`: in place, where `a` is held once, it grows by what `b` holds; else both are copied.
fn appended(a: Walked, b: Walked) -> Result<Walked, String> =
  match if a.holders != Many { b.size }
    else { match ((a.size, b.size)) { (Some(x), Some(y)) -> Some(plus(x, y)), _ -> None } } {
    None -> Err("an append whose size is not read"),
    Some(p) ->
      Ok({
        ..valued(made(then(a, { ..b, state: retain(b.state, b.read, Top) }), p), if held_alone(a) && held_alone(b) { Alone } else { Top }, false),
        size: arithmetic(b"concat", a.size, b.size),
      }),
  }

fn block(
  env: Env,
  st: State,
  stmts: List<CodeStmt>,
  tail: Option<Code>,
) -> Result<Walked, String> / {abort.raise} =
  match stmts.fold(Ok(none(st)), |acc: Result<Walked, String>, s: CodeStmt|
      match acc {
        Err(_) -> acc,
        Ok(sofar) -> match statement({ ..env, tail: false }, sofar.state, s) {
          Err(why) -> Err(why),
          Ok(w) -> Ok(then(sofar, w)),
        },
      }) {
    Err(why) -> Err(why),
    Ok(ran) -> match tail {
      None -> Ok(valued(ran, Alone, true)),
      Some(t) -> match walk(env, ran.state, t) { Err(why) -> Err(why), Ok(w) -> Ok(then(ran, w)) },
    },
  }

fn statement(env: Env, st: State, s: CodeStmt) -> Result<Walked, String> / {abort.raise} =
  match s {
    CDo(d) -> walk(env, st, d.code),
    CLet(l) -> match walk(env, st, l.value) {
      Err(why) -> Err(why),
      Ok(w) -> Ok({ ..w, state: bind(retain(w.state, w.read, Many), l.slot, slot_of(w)) }),
    },
    CLetPat(l) -> match walk(env, st, l.value) {
      Err(why) -> Err(why),
      Ok(w) -> {
        let go = let_go(env, l.value, w);
        let before = retain(w.state, w.read, Top);
        let opened = { ..before, credit: credit_after(go, before.credit, l.pat) };
        Ok(made({ ..w, state: patterned(env, opened, l.pat, w, go) }, rests(l.pat)))
      },
    },
  }

/// Whether compiled code lets a pattern's subject go once its binders hold its fields: where it is
/// a local's last read, held once, outside a function value.
fn let_go(env: Env, subject: Code, w: Walked) -> Bool =
  !env.lambda && subject.own == Owned && !w.number && w.holders != Many
    && (match subject.node { NVar(v) -> v.slot != None, _ -> false })

/// The cells a let-go subject leaves for the next constructor of its kind to take, where no other
/// constructor's wait: a constructor with fields leaves them.
fn credit_after(go: Bool, credit: Option<Bytes>, pat: CodePattern) -> Option<Bytes> =
  if !go || credit != None { credit }
  else { match pat { PxCtor(c) -> if c.args.len() > 0 { Some(c.name) } else { None }, _ -> None } }

/// The objects a pattern makes: a list's rest is one of its own.
fn rests(pat: CodePattern) -> Poly =
  match pat {
    PxList(l) ->
      l.items.fold(if l.rest == None { zero() } else { constant() }, |acc: Poly, p: CodePattern|
        plus(acc, rests(p))),
    PxCtor(c) -> c.args.fold(zero(), |acc: Poly, p: CodePattern| plus(acc, rests(p))),
    PxRecord(r) -> r.fields.fold(zero(), |acc: Poly, f: CodePatternField| plus(acc, rests(f.pat))),
    _ -> zero(),
  }

/// The locals a pattern binds of `subject`: the subject itself where it binds it whole, and its
/// parts held alone only where the subject was, and was let go.
fn patterned(
  env: Env,
  st: State,
  pat: CodePattern,
  subject: Walked,
  go: Bool,
) -> State / {abort.raise} =
  bound(
    env,
    st,
    pat,
    { ..slot_of(subject), holders: if go || subject.number { subject.holders } else { Many } },
    if go && subject.holders == Alone { Alone } else { Many },
  )

fn bound(
  env: Env,
  st: State,
  pat: CodePattern,
  whole: Slot,
  parts: Holders,
) -> State / {abort.raise} =
  match pat {
    PxVar(v) -> match v.slot { Some(k) -> bind(st, k, whole), None -> st },
    PxList(l) -> {
      let heads = l.items.fold(st, |s: State, p: CodePattern|
        bound(env, s, p, part(parts, false), parts));
      match l.rest {
        None -> heads,
        Some(r) ->
          bound(
            env,
            heads,
            r,
            {
              ..part(parts, false),
              size: whole.size,
              of: if l.items.len() == 0 { whole.of }
              else { match whole.of { Same(i) -> Part(i), Part(i) -> Part(i), _ -> Other } },
            },
            parts,
          ),
      }
    },
    PxCtor(c) -> {
      let fields = match ctor(env.cx, String::of_bytes_lossy(c.name)) {
        Some(k) -> k.variant.fields,
        None -> [],
      };
      range(0, c.args.len()).fold(st, |s: State, i: Int|
        match c.args.at(i) {
          Some(p) ->
            bound(
              env,
              s,
              p,
              part(parts, match fields.at(i) { Some(t) -> is_number(t), None -> false }),
              parts,
            ),
          None -> s,
        })
    },
    PxRecord(r) ->
      r.fields.fold(st, |s: State, f: CodePatternField|
        bound(env, s, f.pat, part(parts, false), parts)),
    _ -> st,
  }

fn part(parts: Holders, number: Bool) -> Slot =
  { size: None, of: Other, fun: None, holders: if number { Alone } else { parts }, number: number }

/// An arm that takes a head off the list known to be empty is never taken.
fn needs_head(env: Env, subject: Walked, pat: CodePattern) -> Bool =
  match ((env.empty, subject.of, pat)) {
    (Some(p), Same(i), PxList(l)) -> p == i && l.items.len() > 0,
    _ -> false,
  }

/// The arm taken, after its guard and every guard before it. An arm with a guard keeps its subject
/// for the arms after, and one without lets it go. `at` is where the scrutinee is `List::at`: an
/// arm only `Some` matches has found an element, and is not taken where it misses.
fn arms(
  outer: Env,
  subject: Walked,
  scrutinee: Code,
  at: Option<Found>,
  xs: List<CodeArm>,
) -> Result<Walked, String> / {abort.raise} =
  match xs.fold(
      Ok({ guards: none(subject.state), taken: None }),
      |acc: Result<{ guards: Walked, taken: Option<Walked> }, String>, arm: CodeArm|
        match acc {
          Err(_) -> acc,
          Ok(sofar) -> if needs_head(outer, subject, arm.pat)
              || (at != None && at == outer.missed && takes_some(arm.pat)) { acc } else {
            let env = match at {
              Some(f) -> if takes_some(arm.pat) { { ..outer, found: outer.found.push(f) } }
              else { outer },
              None -> outer,
            };
            let go = arm.guard == None && let_go(env, scrutinee, subject);
            let here = sofar.guards.state;
            let start = patterned(
              env,
              { ..here, credit: credit_after(go, here.credit, arm.pat) },
              arm.pat,
              subject,
              go,
            );
            match match arm.guard {
                None -> Ok(made(none(start), rests(arm.pat))),
                Some(g) -> match walk({ ..env, tail: false }, start, g) {
                  Err(why) -> Err(why),
                  Ok(w) -> Ok(made(w, rests(arm.pat))),
                },
              } {
              Err(why) -> Err(why),
              Ok(g) -> match walk(env, g.state, arm.body) {
                Err(why) -> Err(why),
                Ok(b) -> {
                  let tried = then(sofar.guards, g);
                  let path = then(tried, b);
                  Ok({
                    guards: if arm.guard == None { sofar.guards } else { tried },
                    taken: Some(match sofar.taken { None -> path, Some(t) -> either(t, path) }),
                  })
                },
              },
            }
          },
        },
    ) {
    Err(why) -> Err(why),
    Ok(found) -> Ok(match found.taken { Some(w) -> w, None -> none(subject.state) }),
  }

// --- Calls --------------------------------------------------------------------------------------

fn application(
  env: Env,
  st: State,
  func: Code,
  args: List<Code>,
) -> Result<Walked, String> / {abort.raise} =
  match func.node {
    NVar(f) -> match f.slot {
      Some(k) -> match walked_all(env, st, args, |_i: Int| Some(Many)) {
        Err(why) -> Err(why),
        Ok(a) -> match slot_at(a.walked.state, k).fun {
          Some(p) -> Ok(valued(made(a.walked, p), Many, false)),
          None -> Err("a call of a function value whose space is not read"),
        },
      },
      None -> {
        let name = String::of_bytes_lossy(f.name);
        if name == env.own { called_back(env, st, args) }
        else if ctor(env.cx, name) != None { built(env, st, f.name, args) } else {
          match iterating_of(f.name) {
            Some(it) -> iterating(env, st, name, it, args),
            None -> if env.cx.claims.defs.contains(name) { called(env, st, name, args) }
            else { builtin(env, st, name, args) },
          }
        }
      },
    },
    NLambda(l) -> match walked_all(env, st, args, |_i: Int| Some(Many)) {
      Err(why) -> Err(why),
      Ok(a) -> match lambda_walk(
          env,
          a.walked.state,
          l.params,
          l.captures,
          l.body,
          a.all.map(|w: Walked| { ..slot_of(w), of: Other, holders: part_of(w) }),
        ) {
        Err(why) -> Err(why),
        Ok(w) -> if w.calls > 0 { Err("a call back inside a function value") }
        else { Ok(valued(made(a.walked, plus(constant(), w.space)), part_of(w), w.number)) },
      },
    },
    _ -> Err("a call of a computed function the bound does not read"),
  }

/// A call back into the definition being read: a frame of its own unless it is a tail call, which
/// compiled code makes a jump.
fn called_back(env: Env, st: State, args: List<Code>) -> Result<Walked, String> / {abort.raise} =
  if env.lambda { Err("a call back inside a function value") } else {
    match walked_all(env, st, args, |_i: Int| Some(Many)) {
      Err(why) -> Err(why),
      Ok(a) -> {
        let frame = if env.tail { zero() } else { constant() };
        let handed = range(0, a.all.len()).fold(true, |ok: Bool, i: Int|
          ok
            && (at_or(env.numbers, i)
            || (match a.all.at(i) { Some(w) -> held_alone(w), None -> false })));
        Ok(
          then(a.walked, {
            ..none(a.walked.state),
            space: frame,
            looped: frame,
            holders: Many,
            calls: 1,
            back: [a.all.map(|w: Walked| w.of)],
            handed: handed,
          }),
        )
      },
    }
  }

/// A constructor with fields takes the cells a `match` left of one like it, or is a new object.
fn built(
  env: Env,
  st: State,
  name: Bytes,
  args: List<Code>,
) -> Result<Walked, String> / {abort.raise} =
  match walked_all(env, st, args, |_i: Int| Some(Many)) {
    Err(why) -> Err(why),
    Ok(a) -> {
      let now = a.walked.state;
      let reused = args.len() > 0 && now.credit == Some(name);
      Ok(
        valued(
          made(
            { ..a.walked, state: if reused { { ..now, credit: None } } else { now } },
            if args.len() == 0 || reused { zero() } else { constant() },
          ),
          made_of(a.all.map(part_of)),
          false,
        ),
      )
    },
  }

/// A call of a definition holds its space at the sizes of its arguments: as read with them held
/// alone where each is, and else with them held anywhere.
fn called(
  env: Env,
  st: State,
  name: String,
  args: List<Code>,
) -> Result<Walked, String> / {abort.raise} = {
  let numbers = numbers_of(env.cx, name, args.len());
  let numeric = answers_number(env.cx, name);
  match walked_all(env, st, args, |_i: Int| if numeric { None } else { Some(Many) }) {
    Err(why) -> Err(why),
    Ok(a) -> {
      let alone_all = range(0, a.all.len()).fold(true, |ok: Bool, i: Int|
        ok
          && (at_or(numbers, i)
          || (match a.all.at(i) { Some(w) -> held_alone(w), None -> false })));
      match env.known.get(name) {
        None -> Err("`" ++ name ++ "` reaches definitions that call each other"),
        Some(k) -> match spent_for(k, alone_all) {
          Err(why) -> Err(why),
          Ok(s) -> match at_args(
              s.space,
              a.all.map(|w: Walked| w.size),
              a.all.map(|w: Walked| w.fun),
            ) {
            Err(why) -> Err(why),
            Ok(q) ->
              Ok(valued(made(a.walked, q), if numeric { Alone } else { s.holders }, numeric)),
          },
        },
      }
    },
  }
}

/// The space one call of a definition or constructor named as a value holds, handed values held
/// anywhere, where it grows with nothing it is given.
fn fun_named(env: Env, name: String) -> Option<Poly> =
  if ctor(env.cx, name) != None { Some(constant()) } else {
    match env.known.get(name) {
      Some(k) -> match k.anyhow {
        Ok(s) -> match at_args(s.space, [], []) { Ok(q) -> Some(q), Err(_) -> None },
        Err(_) -> None,
      },
      None -> None,
    }
  }

/// A function value's body, its parameters as `params` and what it captured held by it as well.
fn lambda_walk(
  env: Env,
  outer: State,
  params: Int,
  captures: List<Capture>,
  body: Code,
  slots: List<Slot>,
) -> Result<Walked, String> / {abort.raise} = {
  let start = range(0, params).fold({ slots: [], credit: None }, |s: State, i: Int|
    bind(s, i, match slots.at(i) { Some(x) -> x, None -> unknown_slot() }));
  let captured = captures.fold(start, |s: State, cap: Capture| {
    let from = slot_at(outer, cap.src);
    bind(s, cap.dst, { ..from, holders: if from.number { Alone } else { Many } })
  });
  walk({ ..env, lambda: true, tail: false, empty: None, missed: None }, captured, body)
}

// --- Builtins -----------------------------------------------------------------------------------

/// What each builtin answers, by name.
fn answers_of_builtins() -> Map<String, Answer> / {abort.raise} =
  builtins().fold(Map::new(), |m: Map<String, Answer>, b: Builtin|
    m.insert(String::of_bytes_lossy(b.name), match b.scheme.ty {
      TyFn(f) -> answer_of(f.ret),
      other -> answer_of(other),
    }))

fn answer_of(t: Type) -> Answer =
  match t {
    TyCon(c) -> if c.args.len() == 0 && is_number_name(String::of_bytes_lossy(c.name)) { ANumber }
    else if c.name == b"Option" && c.args.len() == 1 {
      match c.args.at(0) {
        Some(x) -> if answer_of(x) == ANumber { AOptionNumber } else { AValue },
        None -> AValue,
      }
    } else { AValue },
    TyRecord(fs) -> if fs.len() == 0 { ANumber } else { AValue },
    _ -> AValue,
  }

fn is_number_name(n: String) -> Bool =
  [
    "Int",
    "Bool",
    "Float",
    "Char",
    "Decimal",
    "Unit",
    "Ordering",
    "U8",
    "U16",
    "U32",
    "U64",
    "U128",
    "I8",
    "I16",
    "I32",
    "I64",
    "I128",
  ].contains(
    n,
  )

fn is_number(t: Ty) -> Bool =
  match t {
    Con(n, args) -> args.len() == 0 && is_number_name(n),
    Record(fs) -> fs.len() == 0,
    _ -> false,
  }

/// Which of `def`'s first `n` parameters are numbers, by its signature.
fn numbers_of(cx: Context, def: String, n: Int) -> List<Bool> =
  match signature(cx, def) {
    Some(s) -> match s.ty {
      Fn(ps, _, _) ->
        range(0, n).map(|i: Int| match ps.at(i) { Some(t) -> is_number(t), None -> false }),
      _ -> range(0, n).map(|_i: Int| false),
    },
    None -> range(0, n).map(|_i: Int| false),
  }

fn answers_number(cx: Context, def: String) -> Bool =
  match signature(cx, def) {
    Some(s) -> match s.ty { Fn(_, ret, _) -> is_number(ret), other -> is_number(other) },
    None -> false,
  }

fn at_or(xs: List<Bool>, i: Int) -> Bool = match xs.at(i) { Some(x) -> x, None -> false }

/// The builtins that answer their first argument updated: in place where it is held once.
fn updates(name: String) -> Bool =
  name == "List::push" || name == "List::set" || name == "Array::set" || name == "Columns::set"
    || name == "Map::insert"
    || name == "Map::remove"
    || name == "Map::pop_first"
    || name == "Map::pop_last"
    || name == "Map::split"

/// The builtins whose answer shares what their first argument holds: an element of it, or all of
/// them in another collection or in a call of a function.
fn reads_parts(name: String) -> Bool =
  name == "List::at" || name == "Array::at" || name == "Array::get" || name == "Columns::at"
    || name == "Columns::get"
    || name == "Map::get"
    || name == "Map::first"
    || name == "Map::last"
    || name == "Map::floor"
    || name == "Map::ceiling"
    || name == "Map::below"
    || name == "Map::above"
    || name == "Map::range"
    || name == "Map::keys"
    || name == "Map::values"
    || name == "Map::entries"
    || name == "Array::of_list"
    || name == "Array::to_list"
    || name == "Columns::of_list"
    || name == "Columns::to_list"

/// How an argument a builtin reads without moving is held after the call: not at all where the
/// answer holds nothing of it, by parts where the answer shares them, and else whole.
fn kept_by(name: String, answer: Answer, i: Int) -> Option<Holders> =
  if answer != AValue || name == "Bytes::concat" || name == "String::concat"
      || name == "Bytes::slice"
      || name == "String::slice" { None }
  else if i == 0 && updates(name) { None }
  else if i == 0 && reads_parts(name) { Some(Top) }
  else { Some(Many) }

fn builtin(
  env: Env,
  st: State,
  name: String,
  args: List<Code>,
) -> Result<Walked, String> / {abort.raise} =
  match env.answers.get(name) {
    None -> Err("`" ++ name ++ "` has no body here to read"),
    Some(answer) -> match walked_all(env, st, args, |i: Int| kept_by(name, answer, i)) {
      Err(why) -> Err(why),
      Ok(a) -> match contained_by(name, answer, a.walked.state, a.all) {
        Err(why) -> Err(why),
        Ok(m) -> Ok({ ..valued(made(a.walked, m.space), m.holders, m.number), size: m.size }),
      },
    },
  }

/// What a builtin's own call makes, who else holds its answer, and the answer's size.
type Made = { space: Poly, holders: Holders, number: Bool, size: Option<Poly> }

fn object(space: Poly, holders: Holders, size: Option<Poly>) -> Result<Made, String> =
  Ok({ space: space, holders: holders, number: false, size: size })

/// `s` and `extra`, where the size `s` is read.
fn over(name: String, s: Option<Poly>, extra: Poly) -> Result<Poly, String> =
  match s {
    Some(p) -> Ok(plus(p, extra)),
    None -> Err("`" ++ name ++ "` over a value whose size is not read"),
  }

/// An update of the first argument: in place, making `extra`, where it is held once; else a copy of
/// it too.
fn updated(
  name: String,
  first: Walked,
  extra: Poly,
  parts: Holders,
  size: Option<Poly>,
) -> Result<Made, String> =
  if !first.number && first.holders != Many { object(extra, made_of([first.holders, parts]), size) }
  else {
    match over(name, first.size, extra) { Ok(p) -> object(p, Top, size), Err(why) -> Err(why) }
  }

/// A new value as large as the first argument, and `extra` beside.
fn as_large(name: String, first: Walked, extra: Poly, holders: Holders) -> Result<Made, String> =
  match over(name, first.size, extra) {
    Ok(p) -> object(p, holders, first.size),
    Err(why) -> Err(why),
  }

/// Each call of the function at `position`, `times` over.
fn iterated(
  env: Env,
  st: State,
  args: List<Code>,
  times: Option<Poly>,
  position: Int,
  params: List<Slot>,
) -> Result<Poly, String> / {abort.raise} =
  match times {
    None -> Err("an iteration over a value whose size is not read"),
    Some(n) -> match callback(env, st, args, position, params) {
      Err(why) -> Err(why),
      Ok(cb) -> product(n, cb.space),
    },
  }

fn number_slot() -> Slot = { ..unknown_slot(), holders: Alone, number: true }

/// A call of a function its entry says calls the function it is handed: what the call makes once its
/// arguments are walked, that function called as many times as their sizes allow.
fn iterating(
  env: Env,
  st: State,
  name: String,
  it: Iterates,
  args: List<Code>,
) -> Result<Walked, String> / {abort.raise} = {
  let numeric = match env.answers.get(name) {
    Some(a) -> a != AValue,
    None -> answers_number(env.cx, name),
  };
  let holds = it.answer == Mapped || it.answer == Kept || it.answer == Folded;
  let keeps = |i: Int|
    if numeric || it.answer == Updated(i) { None }
    else if holds && it.over.at(0) == Some(i) { Some(Top) }
    else { Some(Many) };
  match walked_all(env, st, args, keeps) {
    Err(why) -> Err(why),
    Ok(a) -> {
      let now = a.walked.state;
      let arg = |i: Int| match a.all.at(i) { Some(w) -> w, None -> none(now) };
      let slots = it.params.map(|h: Handed|
        match h {
          Number -> number_slot(),
          Taken(k) ->
            {
              ..unknown_slot(),
              holders: if !arg(k).number && arg(k).holders == Alone { Alone } else { Many },
            },
          _ -> unknown_slot(),
        });
      let m = match it.answer {
        Folded -> folded(env, now, a.all, args, it, slots),
        answer -> match iterated(
            env,
            now,
            args,
            calls_made(it, a.all.map(|w: Walked| w.size)),
            it.callback,
            slots,
          ) {
          Err(why) -> Err(why),
          Ok(p) -> match answer {
            Updated(k) -> updated(name, arg(k), plus(constant(), p), Top, arg(k).size),
            Unstated -> if numeric { Ok({ space: p, holders: Alone, number: true, size: None }) }
            else { object(plus(constant(), p), Many, None) },
            _ -> match it.over.at(0) {
              Some(k) -> as_large(name, arg(k), p, Top),
              None -> Err("`" ++ name ++ "` walks nothing"),
            },
          },
        },
      };
      match m {
        Err(why) -> Err(why),
        Ok(x) -> Ok({ ..valued(made(a.walked, x.space), x.holders, x.number), size: x.size }),
      }
    },
  }
}

/// A builtin over a container or answering a number: what it makes and how it holds its parts.
fn contained_by(
  name: String,
  answer: Answer,
  st: State,
  all: List<Walked>,
) -> Result<Made, String> = {
  let arg = |i: Int| match all.at(i) { Some(w) -> w, None -> none(st) };
  let grown = match arg(0).size { Some(s) -> Some(plus(s, constant())), None -> None };
  if answer == ANumber {
    Ok({
      space: zero(),
      holders: Alone,
      number: true,
      size: if is_length(name) { arg(0).size } else { None },
    })
  } else if answer == AOptionNumber { object(constant(), Alone, None) }
  else if name == "List::push" { updated(name, arg(0), constant(), part_of(arg(1)), grown) }
  else if name == "Map::insert" {
    updated(name, arg(0), constant(), made_of([part_of(arg(1)), part_of(arg(2))]), grown)
  } else if name == "List::set" || name == "Array::set" || name == "Columns::set" {
    updated(name, arg(0), zero(), part_of(arg(2)), arg(0).size)
  } else if name == "Map::remove" { updated(name, arg(0), constant(), Alone, arg(0).size) }
  else if name == "Map::pop_first" || name == "Map::pop_last" {
    updated(name, arg(0), constant(), Top, None)
  } else if name == "Map::split" { as_large(name, arg(0), constant(), Top) }
  else if name == "Bytes::concat" || name == "String::concat" {
    match appended(arg(0), arg(1)) {
      Err(why) -> Err(why),
      Ok(w) -> Ok({ space: w.space, holders: w.holders, number: false, size: w.size }),
    }
  } else if name == "range" {
    match ((arg(0).size, arg(1).size)) {
      (Some(lo), Some(hi)) -> object(plus(lo, hi), Alone, Some(plus(lo, hi))),
      _ -> Err("`range` over a value whose size is not read"),
    }
  } else if name == "Map::new" { object(constant(), Alone, Some(constant())) }
  else if name == "Array::new" || name == "Columns::new" {
    as_large(name, arg(0), zero(), made_of([part_of(arg(1))]))
  } else if name == "Array::of_list" || name == "Array::to_list" || name == "Columns::of_list"
      || name == "Columns::to_list"
      || name == "Map::keys"
      || name == "Map::values"
      || name == "Map::entries"
      || name == "Map::of_entries"
      || name == "Map::range" { as_large(name, arg(0), constant(), Top) }
  else if name == "Map::merge" {
    match ((arg(0).size, arg(1).size)) {
      (Some(x), Some(y)) -> object(plus(plus(x, y), constant()), Top, Some(plus(x, y))),
      _ -> Err("`Map::merge` over a value whose size is not read"),
    }
  } else if name == "List::at" || name == "Array::at" || name == "Columns::at" || name == "Map::get"
      || name == "Map::first"
      || name == "Map::last"
      || name == "Map::floor"
      || name == "Map::ceiling"
      || name == "Map::below"
      || name == "Map::above"
      || name == "checked_add"
      || name == "checked_sub"
      || name == "checked_mul"
      || name == "checked_neg"
      || name == "Columns::get" { object(constant(), Top, None) }
  else if name == "Array::get" { object(zero(), Many, None) }
  else { valued_by(name, st, all) }
}

/// A builtin over text, bytes or numbers: what it makes and how it holds its parts.
fn valued_by(name: String, st: State, all: List<Walked>) -> Result<Made, String> = {
  let arg = |i: Int| match all.at(i) { Some(w) -> w, None -> none(st) };
  if name == "String::chars" || name == "String::of_chars" || name == "String::trim"
      || name == "String::lower"
      || name == "String::upper"
      || name == "Bytes::of_string"
      || name == "String::of_bytes"
      || name == "String::of_bytes_lossy"
      || name == "String::slice"
      || name == "Bytes::gzip"
      || name == "Bytes::zstd" { as_large(name, arg(0), constant(), Alone) }
  else if name == "String::split" || name == "Bytes::split" {
    match over(name, arg(0).size, constant()) {
      Ok(p) -> object(p, Alone, Some(p)),
      Err(why) -> Err(why),
    }
  } else if name == "Bytes::slice" {
    // A view of what it slices, or a short copy; either is copied to grow.
    object(constant(), Many, arg(0).size)
  } else if name == "Int::to_string" || name == "Float::to_string" || name == "Decimal::to_string"
      || name == "U128::to_string"
      || name == "I128::to_string"
      || name == "Bytes::blake3"
      || name == "digest" { object(constant(), Alone, Some(constant())) }
  else if name == "byte_of_int" { object(zero(), Many, Some(constant())) }
  else if name == "min" || name == "max" {
    Ok({
      space: zero(),
      holders: weaker(part_of(arg(0)), part_of(arg(1))),
      number: arg(0).number && arg(1).number,
      size: None,
    })
  } else if name == "observe" {
    Ok({ space: zero(), holders: part_of(arg(0)), number: arg(0).number, size: arg(0).size })
  } else if name == "numeric_of_int" || name == "wrap_add" || name == "wrap_sub"
      || name == "wrap_mul"
      || name == "saturating_add"
      || name == "saturating_sub"
      || name == "saturating_mul"
      || name == "rotr"
      || name == "rotl" { Ok({ space: zero(), holders: Alone, number: true, size: None }) }
  else if name == "panic" { object(constant(), Many, None) }
  else { Err("`" ++ name ++ "` holds what the bound does not read") }
}

/// A fold: its first call is handed the seed, and each after it what the one before answered, so
/// only the first copies a seed something else holds. `slots` are what its entry's function is
/// handed besides the accumulator.
fn folded(
  env: Env,
  st: State,
  all: List<Walked>,
  args: List<Code>,
  it: Iterates,
  slots: List<Slot>,
) -> Result<Made, String> / {abort.raise} = {
  let seed = match it.params.fold(None, |found: Option<Int>, h: Handed|
      match h { Threaded(k) -> Some(k), _ -> found }) {
    Some(k) -> match all.at(k) { Some(w) -> w, None -> none(st) },
    None -> none(st),
  };
  let handing = |acc: Slot|
    range(0, it.params.len()).map(|j: Int|
      match it.params.get(j) { Threaded(_) -> acc, _ -> slots.get(j) });
  let number = seed.number;
  match calls_made(it, all.map(|w: Walked| w.size)) {
    None -> Err("an iteration over a value whose size is not read"),
    Some(n) -> match callback(
        env,
        st,
        args,
        it.callback,
        handing({ ..slot_of(seed), of: Other, holders: part_of(seed) }),
      ) {
      Err(why) -> Err(why),
      Ok(first) -> match steadied(
          env,
          st,
          args,
          it.callback,
          handing,
          first.holders,
          number && first.number,
          3,
        ) {
        Err(why) -> Err(why),
        Ok(rest) -> match product(n, rest.space) {
          Err(why) -> Err(why),
          Ok(p) ->
            Ok({
              space: plus(first.space, p),
              holders: weaker(part_of(seed), rest.holders),
              number: number && first.number,
              size: None,
            }),
        },
      },
    },
  }
}

/// A fold's callback read with its accumulator held as what the callback answers is, which a more
/// widely held answer widens until they agree.
fn steadied(
  env: Env,
  st: State,
  args: List<Code>,
  position: Int,
  handing: (Slot) -> List<Slot> / {abort.raise},
  holders: Holders,
  number: Bool,
  tries: Int,
) -> Result<{ space: Poly, holders: Holders, number: Bool }, String> / {abort.raise} =
  match callback(
      env,
      st,
      args,
      position,
      handing({ ..unknown_slot(), holders: holders, number: number }),
    ) {
    Err(why) -> Err(why),
    Ok(cb) -> if weaker(holders, cb.holders) == holders || tries <= 0 {
      Ok({ ..cb, holders: weaker(holders, cb.holders) })
    } else {
      steadied(env, st, args, position, handing, weaker(holders, cb.holders), number, tries - 1)
    },
  }

/// What one call of a builtin's callback holds and answers, its parameters as `params`.
fn callback(
  env: Env,
  outer: State,
  args: List<Code>,
  position: Int,
  params: List<Slot>,
) -> Result<{ space: Poly, holders: Holders, number: Bool }, String> / {abort.raise} =
  match args.at(position) {
    None -> Err("a builtin called without its callback"),
    Some(cb) -> match cb.node {
      NLambda(l) -> match lambda_walk(env, outer, l.params, l.captures, l.body, params) {
        Err(why) -> Err(why),
        Ok(w) -> if w.calls > 0 { Err("a call back inside an iteration") }
        else { Ok({ space: w.space, holders: part_of(w), number: w.number }) },
      },
      NVar(f) -> match f.slot {
        Some(k) -> match slot_at(outer, k).fun {
          Some(p) -> Ok({ space: p, holders: Many, number: false }),
          None -> Err("a callback whose space is not read"),
        },
        None -> {
          let name = String::of_bytes_lossy(f.name);
          if ctor(env.cx, name) != None { Ok({ space: constant(), holders: Top, number: false }) }
          else if name == env.own { Err("a call back inside an iteration") } else {
            match env.known.get(name) {
              None -> Err("a callback the bound does not read"),
              Some(k) -> match k.anyhow {
                Err(why) -> Err(why),
                Ok(s) -> match at_args(
                    s.space,
                    params.map(|_p: Slot| None),
                    params.map(|_p: Slot| None),
                  ) {
                  Err(why) -> Err(why),
                  Ok(q) ->
                    Ok({ space: q, holders: s.holders, number: answers_number(env.cx, name) }),
                },
              },
            }
          }
        },
      },
      _ -> Err("a callback the bound does not read"),
    },
  }

// --- Tests ---------------------------------------------------------------------------------------

/// The space of `m.<def>` against its first `space` clause: `Ok(true)` where the clause is shown.
fn shown(src: Bytes, def: String) -> Result<Bool, String> / {abort.raise} = {
  let cx = cx_owning([{ name: b"m", src: src }], |_m: Bytes| true);
  match cx.claims.defs.get("m." ++ def) {
    None -> panic("a definition of the fixture"),
    Some(d) -> match d.spec.filter(|c: ClaimClause| c.kind == SSpace) {
      [c, ..] -> match c.clause.code {
        None -> panic("a lowered bound"),
        Some(b) -> match stated_space(b, d.params) {
          None -> Err("the bound is not read"),
          Some(bound) -> match space(cx, "m." ++ def) {
            Err(why) -> Err(why),
            Ok(p) -> Ok(dominated(p, bound)),
          },
        },
      },
      [] -> panic("a `space` clause"),
    },
  }
}

test "a fold that makes nothing holds no space, and a map holds a list as long as the one it maps" {
  assert_eq(
    shown(b"fn f(xs: List<Int>) -> Int space 0 = xs.fold(0, |a: Int, x: Int| a + x)", "f"),
    Ok(true),
  );
  assert_eq(
    shown(b"fn f(xs: List<Int>) -> List<Int> space 0 = xs.map(|x: Int| x + 1)", "f"),
    Ok(false),
  );
  assert_eq(
    shown(b"fn f(xs: List<Int>) -> List<Int> space xs.len() = xs.map(|x: Int| x + 1)", "f"),
    Ok(true),
  )
}

fn chain() -> Bytes = b"type Chain = | Link(Int, Chain) | End\n"

test "a tail call back that builds what its match let go of holds nothing more" {
  assert_eq(
    shown(
      chain().concat(
        b"fn rev(xs: Chain, acc: Chain) -> Chain space 0 = match xs { End -> acc, Link(x, rest) -> rev(rest, Link(x, acc)) }",
      ),
      "rev",
    ),
    Ok(true),
  );
  // Two links built for one let go: the second is new on every call.
  assert_eq(
    shown(
      chain().concat(
        b"fn twice(xs: Chain, acc: Chain) -> Chain space 0 = match xs { End -> acc, Link(x, rest) -> twice(rest, Link(x, Link(x, acc))) }",
      ),
      "twice",
    ),
    Err(
      "`m.twice` does not call itself on a part of one list parameter, or on an index moved toward a limit it holds it short of, every time",
    ),
  );
  // A subject read again after its match is not let go.
  assert_eq(
    shown(
      chain().concat(
        b"fn other(a: Chain, b: Chain) -> Chain = a\nfn kept(xs: Chain, acc: Chain) -> Chain space 0 = match xs { End -> acc, Link(x, rest) -> kept(rest, Link(x, other(acc, xs))) }",
      ),
      "kept",
    ),
    Err("`m.kept` hands itself a value something else holds"),
  )
}

test "an update of an array held alone is in place, and of one read after it a copy" {
  assert_eq(
    shown(
      b"fn fill(a: Array<Int>, i: Int, n: Int) -> Array<Int> / {abort.raise} space 0 = if i >= n { a } else { fill(a.set(i, 0), i + 1, n) }",
      "fill",
    ),
    Ok(true),
  );
  let copy = |bound: Bytes|
    shown(
      Bytes::concat_all([
        b"fn copy(a: Array<Int>) -> Int / {abort.raise} space ",
        bound,
        b" = { let b = a.set(0, 1); a.len() + b.len() }",
      ]),
      "copy",
    );
  assert_eq(copy(b"0"), Ok(false));
  assert_eq(copy(b"a.len()"), Ok(true))
}

test "a call back that is no tail call holds a frame for each" {
  let count = |bound: Bytes|
    shown(
      Bytes::concat_all([
        b"fn count(xs: List<Int>) -> Int space ",
        bound,
        b" = match xs { [] -> 0, [_, ..rest] -> 1 + count(rest) }",
      ]),
      "count",
    );
  assert_eq(count(b"0"), Ok(false));
  assert_eq(count(b"xs.len()"), Ok(true))
}

test "a call back past an index where `List::at` found an element holds a frame for each element" {
  let count = |bound: Bytes|
    shown(
      Bytes::concat_all([
        b"fn count(xs: List<Int>, i: Int) -> Int space ",
        bound,
        b" = match xs.at(i) { Some(_) -> 1 + count(xs, i + 1), None -> 0 }",
      ]),
      "count",
    );
  assert_eq(count(b"0"), Ok(false));
  assert_eq(count(b"xs.len()"), Ok(true))
}

test "a call back on an index moved toward a limit a guard holds it short of holds a frame for each" {
  let count = b"fn count(xs: List<Int>, i: Int) -> Int = if i >= xs.len() { 0 } else { 1 + count(xs, i + 1) }\n";
  let bound = |b: Bytes|
    shown(
      Bytes::concat_all([count, b"fn f(xs: List<Int>) -> Int space ", b, b" = count(xs, 0)"]),
      "f",
    );
  assert_eq(bound(b"0"), Ok(false));
  assert_eq(bound(b"xs.len()"), Ok(true))
}

test "a fold's first call alone copies a seed something else holds" {
  let grow = b"fn grow(xs: List<Int>, ys: List<Int>) -> List<Int> space ys.len() = ys.fold(xs, |a: List<Int>, y: Int| a.push(y))\n";
  assert_eq(shown(grow, "grow"), Ok(true));
  let shared = |bound: Bytes|
    shown(
      Bytes::concat_all([
        grow,
        b"fn shared(xs: List<Int>, ys: List<Int>) -> Int space ",
        bound,
        b" = grow(xs, ys).len() + xs.len()",
      ]),
      "shared",
    );
  assert_eq(shared(b"ys.len()"), Ok(false));
  assert_eq(shared(b"xs.len() + ys.len()"), Ok(true))
}

test "another package's definition holds what its `space` bound says, for arguments held alone" {
  let cx = cx_owning(
    [
      {
        name: b"base",
        src: b"pub fn ones(xs: List<Int>) -> List<Int> space xs.len() = xs.map(|_x: Int| 1)\n",
      },
      {
        name: b"app",
        src: b"import base\nfn f(xs: List<Int>) -> List<Int> = base::ones(xs)\nfn g(xs: List<Int>) -> Int = base::ones(xs).len() + xs.len()\n",
      },
    ],
    |m: Bytes| m == b"app",
  );
  assert_eq(space(cx, "app.f"), Ok([Map::new().insert(0, 1)]));
  assert_eq(
    space(cx, "app.g"),
    Err(
      "`base.ones` is handed a value something else holds, and its `space` bound is for arguments held alone",
    ),
  )
}
