//! `domain` — how many points a law's binders have, and whether that is a domain at all.
//!
//! A finite domain is the one thing a law can be *proved* over rather than sampled: if every binder
//! is inhabited by finitely many values and the product is small enough to walk, then visiting every
//! point is a proof and missing one is not. Everything here is therefore a rule about coverage, not
//! a search: how many values a type holds, whether a product is still walkable, and what order the
//! points are visited in so that two runs agree.
//!
//! Which points exist, how many there are, and whether asking for all of them is a proof or an
//! enumeration nobody can afford, are decided here, and so is each point's value.

import std.value (Value, VUnit, VBool, VFixed, VRecord, VCtor, Field)
import std.list (concat, contains)
import std.string (join)
import std.math (pow)

/// A type as the prover reads one: a variable, numbered by first appearance in the item it belongs
/// to; a function, with its parameters, its answer and whether its row is empty; a record; or a
/// named type with its arguments. The builtins arrive as names — `Unit`, `Bool`, `U8` — so this
/// module never needs to know which of them the compiler keeps in a table and which it spells out.
pub type Ty =
  | Var(Int)
  | Fn(List<Ty>, Ty, Bool)
  | Record(List<{ name: String, ty: Ty }>)
  | Con(String, List<Ty>)

/// One case of a declared type: its name and its fields, in declaration order.
pub type Variant = { name: String, fields: List<Ty> }

/// A declared type: how many parameters it takes and the variants its constructors belong to. Its
/// fields are written in terms of those parameters, `Var(i)` being the `i`th, so `Con(name, args)`
/// means the fields with `args` substituted for them by position — a `Pair<Bool>` is four values, and
/// the same declaration under `Pair<Int>` is not finite at all.
pub type Decl = { name: String, params: Int, variants: List<Variant> }

/// What a finite type came to, as the runtime builds its values from an index: a builtin by name, a
/// declared type's cases in declaration order, or a record's fields in the order the type lists them.
/// Every node carries how many values it holds, so decoding a point counts nothing: the sizes are
/// decided here, once.
pub type Shape =
  | Scalar(String, Int)
  | Cases(Int, List<{ name: String, size: Int, fields: List<Shape> }>)
  | Fields(Int, List<{ name: String, shape: Shape }>)

pub fn shape_size(s: Shape) -> Int =
  match s { Scalar(_, n) -> n, Cases(n, _) -> n, Fields(n, _) -> n }

/// The `index`-th point, the first binder varying slowest; `None` past the last, where decoding
/// would wrap round to a point already named.
pub fn point_at(d: Domain, index: Int) -> Option<List<Value>> / {abort.raise} =
  match point_indices(d, index) { Some(ixs) -> values_of(d.shapes, ixs), None -> None }

/// The values of a tuple of shapes at one index, the last varying fastest.
fn values_at(shapes: List<Shape>, index: Int) -> Option<List<Value>> / {abort.raise} = {
  let sizes = map(shapes, shape_size);
  if fold(sizes, false, |empty: Bool, n: Int| empty || n == 0) { None }
  else { values_of(shapes, tuple_at(sizes, len(sizes) - 1, index)) }
}

fn values_of(shapes: List<Shape>, ixs: List<Int>) -> Option<List<Value>> / {abort.raise} =
  fold(range(0, len(shapes)), Some([]), |acc: Option<List<Value>>, k: Int|
    match acc {
      None -> None,
      Some(vs) -> match ((list_at(shapes, k), list_at(ixs, k))) {
        (Some(shape), Some(ix)) -> match value_at(shape, ix) {
          Some(v) -> Some(push(vs, v)),
          None -> None,
        },
        _ -> None,
      },
    })

/// The `index`-th value of a shape: constructors in declaration order, then fields left to right with
/// the last varying fastest; a record keeps its fields by name.
fn value_at(s: Shape, index: Int) -> Option<Value> / {abort.raise} =
  match s {
    Scalar(name, _) -> if name == "Unit" { Some(VUnit) }
    else if name == "Bool" { Some(VBool(index == 1)) }
    else { fixed_at(name, index) },
    Cases(_, cases) ->
      fold(
        cases,
        { rest: index, found: None, done: false },
        |acc: { rest: Int, found: Option<Value>, done: Bool }, c: { name: String, size: Int, fields: List<Shape> }|
          if acc.done { acc } else if acc.rest < c.size {
            {
              rest: acc.rest,
              found: match values_at(c.fields, acc.rest) {
                Some(args) -> Some(VCtor(c.name, args)),
                None -> None,
              },
              done: true,
            }
          } else { { rest: acc.rest - c.size, found: None, done: false } },
      ).found,
    Fields(_, fields) -> match values_at(
        map(fields, |f: { name: String, shape: Shape }| f.shape),
        index,
      ) {
      None -> None,
      Some(values) ->
        Some(
          VRecord(
            by_name(
              map(range(0, len(fields)), |i: Int|
                {
                  name: match list_at(fields, i) { Some(f) -> f.name, None -> "" },
                  value: match list_at(values, i) { Some(v) -> v, None -> VUnit },
                }),
            ),
          ),
        ),
    },
  }

/// The places of `names` in ascending order, equal names in the order they came.
pub fn name_order(names: List<String>) -> List<Int> =
  fold(range(0, len(names)), [], |acc: List<Int>, i: Int| {
    let name = match list_at(names, i) { Some(n) -> n, None -> "" };
    let before = |j: Int|
      match list_at(names, j) { Some(m) -> compare(name, m) == Less, None -> false };
    let at = fold(range(0, len(acc)), len(acc), |found: Int, k: Int|
      if found < len(acc) { found } else {
        match list_at(acc, k) { Some(j) -> if before(j) { k } else { found }, None -> found }
      });
    if at == len(acc) { push(acc, i) } else {
      fold(range(0, len(acc)), [], |out: List<Int>, k: Int|
        match list_at(acc, k) {
          Some(j) -> if k == at { push(push(out, i), j) } else { push(out, j) },
          None -> out,
        })
    }
  })

fn by_name(fields: List<Field>) -> List<Field> =
  fold(name_order(map(fields, |f: Field| f.name)), [], |acc: List<Field>, i: Int|
    match list_at(fields, i) { Some(f) -> push(acc, f), None -> acc })

/// A width's least value plus `index`, as the pattern it is.
fn fixed_at(name: String, index: Int) -> Option<Value> / {abort.raise} = {
  let w = if name == "U8" || name == "I8" { 8 }
  else if name == "U16" || name == "I16" { 16 }
  else if name == "U32" || name == "I32" { 32 }
  else if name == "U64" || name == "I64" { 64 }
  else { 128 };
  let mask = if w == 128 { ~0u128 } else { (1u128 << w) - 1u128 };
  if string_starts_with(name, "I") {
    Some(VFixed(name, u128_of_int(index) +% (1u128 << w - 1) & mask))
  } else if string_starts_with(name, "U") { Some(VFixed(name, u128_of_int(index) & mask)) }
  else { None }
}

/// What a finite domain came to: each binder's shape, and the product of their sizes. A point is
/// named by index, and only the sizes say what an index means.
pub type Domain = { shapes: List<Shape>, points: Int }

pub fn sizes_of(domain: Domain) -> List<Int> = map(domain.shapes, shape_size)

/// The largest number of points a proof may walk. Past it the domain is not a proof anyone can pay
/// for, and sampling is the honest answer rather than a long silence.
pub fn bound() -> Int = 4096

/// What a type came to, or `None` when it is infinite, unknown, or past [`bound`].
pub fn shape_of(ty: Ty, decls: List<Decl>) -> Option<Shape> =
  shaped(ty, decls, [], [], 2 * len(decls) + 2)

/// How many values inhabit a type, or `None` when it is infinite, unknown, or past [`bound`].
pub fn size(ty: Ty, decls: List<Decl>) -> Option<Int> =
  match shape_of(ty, decls) { Some(s) -> Some(shape_size(s)), None -> None }

/// The binders' domain, when every one of them is finite and the product is within [`bound`].
pub fn finite(binders: List<Ty>, decls: List<Decl>) -> Option<Domain> =
  fold(binders, Some({ shapes: [], points: 1 }), |acc: Option<Domain>, ty: Ty|
    match acc {
      None -> None,
      Some(seen) -> match shape_of(ty, decls) {
        None -> None,
        Some(shape) -> {
          let n = shape_size(shape);
          let points = seen.points * n;
          // A domain of no points is a vacuity, not a proof.
          if n == 0 || points > bound() { None }
          else { Some({ shapes: push(seen.shapes, shape), points: points }) }
        },
      },
    })

/// What a domain is called in an artifact: the name of a product with no binders is `unit`, since a
/// ground claim still has exactly one point. The texts are the compiler's own printing of each
/// binder's type, so a domain is named as its claim's binders read.
pub fn name_of(texts: List<String>) -> String =
  if len(texts) == 0 { "unit" } else { join(texts, " × ") }

/// The point an index names, one value index per binder: the last binder varies fastest, so the
/// sequence of points is a function of the domain and nothing else.
pub fn point_indices(domain: Domain, index: Int) -> Option<List<Int>> / {abort.raise} = {
  let sizes = sizes_of(domain);
  if index < 0 || index >= domain.points { None }
  else { Some(tuple_at(sizes, len(sizes) - 1, index)) }
}

/// `sizes` right to left, each dividing what is left: the tuple an index names, left to right.
fn tuple_at(sizes: List<Int>, at: Int, rest: Int) -> List<Int> / {abort.raise} =
  if at < 0 { [] } else {
    match list_at(sizes, at) {
      None -> [],
      Some(step) -> push(tuple_at(sizes, at - 1, rest / step), rest % step),
    }
  }

/// What a type came to, with the names whose variants are already being walked: a type that mentions
/// itself has no finite size even when it has a nullary case. `room` is spent opening a declared type,
/// which a path does once for each, and reading an argument, which a path does once between two.
fn shaped(
  ty: Ty,
  decls: List<Decl>,
  open: List<String>,
  subst: List<Ty>,
  room: Int,
) -> Option<Shape> =
  if room <= 0 { None } else {
    match ty {
      // Arguments arrive already substituted into the scope that wrote them, so one read settles a
      // parameter; reading it against `subst` again would let `Var(0)` name itself forever.
      Var(index) -> match list_at(subst, index) {
        Some(argument) -> shaped(argument, decls, open, [], room - 1),
        None -> None,
      },
      Fn(_, _, _) -> None,
      Record(fields) -> match fields_of(fields, decls, open, subst, room) {
        None -> None,
        Some(fs) -> Some(Fields(fs.size, fs.fields)),
      },
      Con(name, args) -> {
        if name == "Unit" { Some(Scalar(name, 1)) }
        else if name == "Bool" { Some(Scalar(name, 2)) }
        // `Float` and `Decimal` are finite but far too large to enumerate, and a 64-bit width does not
        // fit the arithmetic here.
        else if is_unbounded(name) { None }
        else if width_of(name) != 0 { Some(Scalar(name, pow(2, width_of(name)))) }
        else if contains(open, name) { None } else {
          match find_decl(decls, name) {
            None -> None,
            Some(decl) ->
              cases_of(
                decl,
                decls,
                push(open, name),
                map(args, |a: Ty| substituted(a, subst)),
                room - 1,
              ),
          }
        }
      },
    }
  }

/// A type whose values are too many to walk, or that is not finite at all.
fn is_unbounded(name: String) -> Bool =
  name == "Int" || name == "String" || name == "Bytes" || name == "List" || name == "Array"
    || name == "Float"
    || name == "Decimal"
    || name == "Map"
    || name == "I64"
    || name == "U64"
    || name == "I128"
    || name == "U128"

/// The bit width of a fixed-width integer type, or 0 when the name is not one.
fn width_of(name: String) -> Int =
  if name == "U8" || name == "I8" { 8 }
  else if name == "U16" || name == "I16" { 16 }
  else if name == "U32" || name == "I32" { 32 }
  else { 0 }

/// Every case of one declared type, summed: a type with no variants has no values at all.
fn cases_of(
  decl: Decl,
  decls: List<Decl>,
  open: List<String>,
  args: List<Ty>,
  room: Int,
) -> Option<Shape> =
  match fold(
      decl.variants,
      Some({ total: 0, cases: [] }),
      |acc: Option<{ total: Int, cases: List<{ name: String, size: Int, fields: List<Shape> }> }>, variant: Variant|
        match acc {
          None -> None,
          Some(seen) -> match product_of(variant.fields, decls, open, args, room) {
            None -> None,
            Some(p) -> {
              let total = seen.total + p.size;
              if total > bound() { None } else {
                Some({
                  total: total,
                  cases: push(seen.cases, { name: variant.name, size: p.size, fields: p.shapes }),
                })
              }
            },
          },
        },
    ) {
    None -> None,
    Some(all) -> Some(Cases(all.total, all.cases)),
  }

/// A tuple's shapes and the product of their sizes, refused as soon as it is past the bound.
fn product_of(
  types: List<Ty>,
  decls: List<Decl>,
  open: List<String>,
  subst: List<Ty>,
  room: Int,
) -> Option<{ size: Int, shapes: List<Shape> }> =
  fold(
    types,
    Some({ size: 1, shapes: [] }),
    |acc: Option<{ size: Int, shapes: List<Shape> }>, ty: Ty|
      match acc {
        None -> None,
        Some(seen) -> match shaped(ty, decls, open, subst, room) {
          None -> None,
          Some(shape) -> {
            let next = seen.size * shape_size(shape);
            if next > bound() { None }
            else { Some({ size: next, shapes: push(seen.shapes, shape) }) }
          },
        },
      },
  )

/// A record's fields in the order the type lists them, with the product of their sizes.
fn fields_of(
  fields: List<{ name: String, ty: Ty }>,
  decls: List<Decl>,
  open: List<String>,
  subst: List<Ty>,
  room: Int,
) -> Option<{ size: Int, fields: List<{ name: String, shape: Shape }> }> =
  match product_of(map(fields, |f: { name: String, ty: Ty }| f.ty), decls, open, subst, room) {
    None -> None,
    Some(p) ->
      Some({
        size: p.size,
        fields: map(range(0, len(fields)), |i: Int|
          {
            name: match list_at(fields, i) { Some(f) -> f.name, None -> "" },
            shape: match list_at(p.shapes, i) { Some(sh) -> sh, None -> Scalar("Unit", 1) },
          }),
      }),
  }

/// A type written inside a declaration, with the arguments it was applied to in place of its
/// parameters. An argument is put in as it is, so a variable in it is never read as a parameter.
fn substituted(ty: Ty, subst: List<Ty>) -> Ty =
  match ty {
    Var(index) -> match list_at(subst, index) { Some(argument) -> argument, None -> ty },
    Fn(params, ret, pure) ->
      Fn(map(params, |p: Ty| substituted(p, subst)), substituted(ret, subst), pure),
    Record(fields) ->
      Record(
        map(fields, |f: { name: String, ty: Ty }| { name: f.name, ty: substituted(f.ty, subst) }),
      ),
    Con(name, args) -> Con(name, map(args, |a: Ty| substituted(a, subst))),
  }

/// The declaration of the type `name`, when it is a declared one.
pub fn find_decl(decls: List<Decl>, name: String) -> Option<Decl> =
  fold(decls, None, |found: Option<Decl>, decl: Decl|
    match found { Some(_) -> found, None -> if decl.name == name { Some(decl) } else { None } })

// --- Tests ------------------------------------------------------------------

fn kinds() -> List<Decl> =
  [
    {
      name: "Kind",
      params: 0,
      variants: [
        { name: "Asset", fields: [] },
        { name: "Liability", fields: [] },
        { name: "Equity", fields: [] },
      ],
    },
  ]

fn nat() -> List<Decl> =
  [
    {
      name: "Nat",
      params: 0,
      variants: [{ name: "Zero", fields: [] }, { name: "Succ", fields: [Con("Nat", [])] }],
    },
  ]

pub fn con(name: String) -> Ty = Con(name, [])

test "a nullary enum and Bool are finite and everything unbounded is not" {
  let decls = kinds();
  assert_eq(size(con("Bool"), decls), Some(2));
  assert_eq(size(con("Unit"), decls), Some(1));
  assert_eq(size(con("Kind"), decls), Some(3));
  assert_eq(size(con("Int"), decls), None);
  assert_eq(size(con("String"), decls), None);
  assert_eq(size(con("Bytes"), decls), None);
  assert_eq(size(con("Float"), decls), None);
  assert_eq(size(con("List"), decls), None);
  // A 64-bit width does not fit the arithmetic here, but a narrower one is a count like any other.
  assert_eq(size(con("U64"), decls), None);
  assert_eq(size(con("U8"), decls), Some(256));
  assert_eq(size(con("I32"), decls), Some(4294967296))
}

test "a type variable and a function are never finite" {
  assert_eq(size(Var(0), kinds()), None);
  assert_eq(size(Fn([con("Bool")], con("Bool"), true), kinds()), None)
}

test "a recursive type is infinite even with a nullary base case" {
  assert_eq(size(con("Nat"), nat()), None)
}

test "a record's size is the product of its fields'" {
  let decls = kinds();
  assert_eq(
    size(Record([{ name: "k", ty: con("Kind") }, { name: "b", ty: con("Bool") }]), decls),
    Some(6),
  );
  assert_eq(
    size(Record([{ name: "k", ty: con("Kind") }, { name: "n", ty: con("Int") }]), decls),
    None,
  )
}

test "a case with fields multiplies them into its type's size" {
  let declared = concat(kinds(), [
    {
      name: "Wrap",
      params: 0,
      variants: [
        { name: "Nothing", fields: [] },
        { name: "Held", fields: [Con("Kind", []), Con("Bool", [])] },
      ],
    },
  ]);
  assert_eq(size(con("Wrap"), declared), Some(7))
}

fn kind_cases() -> Shape =
  Cases(3, [
    { name: "Asset", size: 1, fields: [] },
    { name: "Liability", size: 1, fields: [] },
    { name: "Equity", size: 1, fields: [] },
  ])

// The runtime decodes a point through the shape alone, so every node says how many values it holds
// and a case its own share of its type's.
test "a shape carries each node's size, so decoding a point counts nothing" {
  let declared = concat(kinds(), [
    {
      name: "Wrap",
      params: 0,
      variants: [
        { name: "Nothing", fields: [] },
        { name: "Held", fields: [Con("Kind", []), Con("Bool", [])] },
      ],
    },
  ]);
  assert_eq(
    shape_of(con("Wrap"), declared),
    Some(
      Cases(7, [
        { name: "Nothing", size: 1, fields: [] },
        { name: "Held", size: 6, fields: [kind_cases(), Scalar("Bool", 2)] },
      ]),
    ),
  );
  // A record's fields in the order the type lists them, and their product.
  assert_eq(
    shape_of(Record([{ name: "k", ty: con("Kind") }, { name: "b", ty: con("Bool") }]), declared),
    Some(Fields(6, [{ name: "k", shape: kind_cases() }, { name: "b", shape: Scalar("Bool", 2) }])),
  );
  assert_eq(shape_of(con("U8"), declared), Some(Scalar("U8", 256)));
  assert_eq(shape_of(con("Unit"), declared), Some(Scalar("Unit", 1)));
  // A parameter is the argument's own shape.
  let pair = concat(kinds(), [
    { name: "Pair", params: 1, variants: [{ name: "Both", fields: [Var(0), Var(0)] }] },
  ]);
  assert_eq(
    shape_of(Con("Pair", [con("Bool")]), pair),
    Some(Cases(4, [{ name: "Both", size: 4, fields: [Scalar("Bool", 2), Scalar("Bool", 2)] }])),
  );
  // What is not finite has no shape at all.
  assert_eq(shape_of(con("Int"), declared), None)
}

test "a domain is the binders' shapes and the product of their sizes" {
  match finite([con("Bool"), con("Kind")], kinds()) {
    None -> assert_eq(false, true),
    Some(domain) -> {
      assert_eq(domain.shapes, [Scalar("Bool", 2), kind_cases()]);
      assert_eq(sizes_of(domain), [2, 3]);
      assert_eq(domain.points, 6)
    },
  }
}

test "a product beyond the bound is refused rather than walked" {
  let decls = kinds();
  assert_eq(finite(map(range(0, 16), |_i: Int| con("Kind")), decls), None);
  match finite(map(range(0, 4), |_i: Int| con("Kind")), decls) {
    None -> assert_eq(false, true),
    Some(domain) -> assert_eq(domain.points, 81),
  }
}

test "a domain with a binder no value inhabits is a vacuity, not a proof" {
  let declared = [{ name: "Empty", params: 0, variants: [] }];
  assert_eq(finite([con("Empty")], declared), None)
}

test "a domain is named by its binders, and a product of none is unit" {
  assert_eq(name_of([]), "unit");
  assert_eq(name_of(["Bool"]), "Bool");
  assert_eq(name_of(["Bool", "Kind"]), "Bool × Kind")
}

test "a ground claim has exactly one point" {
  match finite([], kinds()) {
    None -> assert_eq(false, true),
    Some(domain) -> {
      assert_eq(domain.points, 1);
      assert_eq(point_indices(domain, 0), Some([]));
    },
  }
}

test "enumeration covers the domain once each in a fixed order" {
  let decls = kinds();
  match finite([con("Bool"), con("Kind")], decls) {
    None -> assert_eq(false, true),
    Some(domain) -> {
      assert_eq(domain.points, 6);
      assert_eq(point_indices(domain, 0), Some([0, 0]));
      assert_eq(point_indices(domain, 3), Some([1, 0]));
      assert_eq(point_indices(domain, 5), Some([1, 2]));
      assert_eq(point_indices(domain, 6), None);
      // Every point is named once: a repeated tuple would be a domain walked short.
      let seen = map(range(0, domain.points), |i: Int| point_indices(domain, i));
      let tuples = fold(seen, [], |acc: List<List<Int>>, t: Option<List<Int>>|
        match t { Some(xs) -> push(acc, xs), None -> acc });
      assert_eq(len(tuples), domain.points)
    },
  }
}

test "a parameter is the argument the type was applied to" {
  let declared = concat(kinds(), [
    { name: "Pair", params: 1, variants: [{ name: "Both", fields: [Var(0), Var(0)] }] },
  ]);
  assert_eq(size(Con("Pair", [con("Bool")]), declared), Some(4));
  assert_eq(size(Con("Pair", [con("Kind")]), declared), Some(9));
  // The same declaration under a type with no finite size is not a finite type.
  assert_eq(size(Con("Pair", [con("Int")]), declared), None);
  // A type already being walked is refused whether it nests or recurses: `Pair<Pair<Bool>>` is
  // finite, and reading it as unbounded is the conservative answer the reference gives too.
  assert_eq(size(Con("Pair", [Con("Pair", [con("Bool")])]), declared), None);
  // An argument the declaration never binds is unknown rather than dropped.
  assert_eq(size(Con("Pair", []), declared), None)
}

test "a recursive type stays infinite under an argument, not only on its own" {
  let declared = [
    {
      name: "Nest",
      params: 1,
      variants: [
        { name: "Leaf", fields: [Var(0)] },
        { name: "More", fields: [Con("Nest", [Var(0)])] },
      ],
    },
  ];
  assert_eq(size(Con("Nest", [con("Bool")]), declared), None)
}

// A claim's variables and a declaration's parameters are both numbered from zero, each in its own
// item, so reading one as the other would size `Pair<a>` by itself forever.
test "a claim's own variable has no size, even where it fills a parameter numbered the same" {
  let declared = concat(kinds(), [
    { name: "Pair", params: 1, variants: [{ name: "Both", fields: [Var(0), Var(0)] }] },
  ]);
  assert_eq(size(Con("Pair", [Var(0)]), declared), None);
  assert_eq(finite([Con("Pair", [Var(0)]), con("Bool")], declared), None)
}

test "a parameter handed on to another declaration is what the outer one was applied to" {
  let declared = concat(kinds(), [
    { name: "Box", params: 1, variants: [{ name: "Boxed", fields: [Var(0)] }] },
    { name: "Two", params: 1, variants: [{ name: "Two", fields: [Con("Box", [Var(0)]), Var(0)] }] },
  ]);
  assert_eq(size(Con("Two", [con("Kind")]), declared), Some(9));
  assert_eq(size(Con("Two", [Var(0)]), declared), None)
}

test "a point is every binder's value, the last varying fastest" {
  match finite([Con("Bool", []), Con("Unit", []), Con("Bool", [])], []) {
    None -> panic("a finite domain"),
    Some(d) -> {
      assert_eq(point_at(d, 0), Some([VBool(false), VUnit, VBool(false)]));
      assert_eq(point_at(d, 1), Some([VBool(false), VUnit, VBool(true)]));
      assert_eq(point_at(d, 2), Some([VBool(true), VUnit, VBool(false)]));
      assert_eq(point_at(d, 4), None)
    },
  }
}

test "a case takes its share of its type, a width starts at its least value, and a ground claim has one point" {
  let decls = [
    {
      name: "m.Kind",
      params: 0,
      variants: [{ name: "m.Off", fields: [] }, { name: "m.On", fields: [Con("Bool", [])] }],
    },
  ];
  match finite([Con("m.Kind", [])], decls) {
    None -> panic("a finite domain"),
    Some(d) ->
      assert_eq(map(range(0, d.points), |i: Int| point_at(d, i)), [
        Some([VCtor("m.Off", [])]),
        Some([VCtor("m.On", [VBool(false)])]),
        Some([VCtor("m.On", [VBool(true)])]),
      ]),
  };
  match finite([Con("I8", [])], []) {
    None -> panic("a finite domain"),
    Some(d) -> {
      assert_eq(point_at(d, 0), Some([VFixed("I8", 128u128)]));
      assert_eq(point_at(d, 128), Some([VFixed("I8", 0u128)]))
    },
  };
  match finite([], []) {
    None -> panic("a ground domain"),
    Some(d) -> assert_eq(point_at(d, 0), Some([])),
  }
}
