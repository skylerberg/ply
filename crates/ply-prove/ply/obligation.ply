//! `obligation` — selecting, and reporting on, the proofs a program owes.
//!
//! An obligation is discharged once and read many times, so the first question is what the cache
//! already answered. A proof read off the claim alone sits under the claim's own key, and one a run
//! helped make under the key of what the claim executes, because what a run saw is a fact about the
//! definitions it ran.
//!
//! The second question is what a reader still has to read: which definitions a proof covers, and —
//! since the last time a person accepted the program's claims — which definitions moved, whether
//! their *claims* moved with them, and what became of those claims. A definition whose
//! implementation moved but whose spec did not is exactly the case where a green check is worth
//! re-reading.
//!
//! The laws are the vocabulary all of this speaks: a law names definitions, and rewriting the law
//! changes its targets' spec, so a law's text is part of the spec of everything it names.

import std.bin
import std.json (Array, Json, Null, Number, Object, Str)
import std.value (Value, filled)
import std.list (at, concat, contains, sort)
import rules (Rule, Unfold, Cited, Descent, Spine, induction_rule, rule_json, rule_bin)
import std.string (join)
import std.map (get_or)

/// What an obligation is about: one of a definition's own `ensures` clauses, one of its `cost` or
/// `space` bounds, or a whole law.
pub type Kind = | Ensures(Int) | Cost(Int) | Law(Option<String>) | Space(Int)

/// What each law speaks about, and the sentence it was written as.
pub type Laws = {
  /// Law -> the definitions it names.
  targets: Map<String, List<String>>,
  /// Law -> the hash of its text, which is part of its targets' spec.
  texts: Map<String, String>,
}

pub fn no_laws() -> Laws = { targets: map_new(), texts: map_new() }

pub fn add_law(laws: Laws, key: String, text: String, targets: List<String>) -> Laws =
  {
    targets: map_insert(laws.targets, key, concat(law_targets(laws, key), targets)),
    texts: map_insert(laws.texts, key, text),
  }

pub fn law_targets(laws: Laws, law: String) -> List<String> =
  match map_get(laws.targets, law) { Some(terms) -> terms, None -> [] }

pub fn law_text(laws: Laws, law: String) -> Option<String> = map_get(laws.texts, law)

pub fn has_laws(laws: Laws) -> Bool = map_len(laws.texts) > 0

/// A law as the program wrote it: its key, the hash of its text, and every name it mentions.
pub type Written = { key: String, text: String, mentions: List<String> }

/// What each law speaks about: a law covers the definitions it mentions, and nothing else it names.
pub fn laws_of(defs: List<String>, written: List<Written>) -> Laws = {
  let held = map_of_entries(map(defs, |name: String| { key: name, value: true }));
  fold(written, no_laws(), |laws: Laws, w: Written|
    add_law(laws, w.key, w.text, filter(w.mentions, |name: String| map_contains(held, name))))
}

/// Every law sentence naming this definition: rewriting a law changes its targets' spec.
pub fn naming(laws: Laws, name: String) -> List<String> =
  fold(map_keys(laws.targets), [], |acc: List<String>, law: String|
    if contains(law_targets(laws, law), name) {
      match law_text(laws, law) { Some(text) -> push(acc, text), None -> acc }
    } else { acc })

/// Whether something moved since the baseline a reader accepted.
pub type Moved = | Unchanged | Changed | Never

pub fn moved_word(m: Moved) -> String =
  match m { Unchanged -> "unchanged", Changed -> "changed", Never -> "never" }

/// One definition's claims as they stand now, or as they stood when they were accepted. The spec is
/// a set of claim hashes: what moved is which claims there are, not the order they were named in.
pub type Record = { def_hash: String, specs: List<String> }

/// A definition the program declares: its hash, when the front end produced one, and the spec text
/// of each of its own clauses.
pub type Def = { name: String, hash: Option<String>, specs: List<String> }

/// Every hashed definition's claims as they stand now, which is also the baseline accepting them
/// records: its hash, its own clauses, and every law naming it.
pub fn records(
  defs: List<Def>,
  laws: Laws,
) -> List<{ name: String, record: Record }> / {abort.raise} = {
  // Each definition's laws, by the definition: what `naming` answers one definition at a time.
  let named = fold(
    map_keys(laws.targets),
    map_new(),
    |acc: Map<String, List<String>>, law: String|
      match law_text(laws, law) {
        None -> acc,
        Some(text) ->
          fold(law_targets(laws, law), acc, |a: Map<String, List<String>>, name: String|
            map_insert(a, name, push(match map_get(a, name) { Some(ts) -> ts, None -> [] }, text))),
      },
  );
  fold(defs, [], |acc: List<{ name: String, record: Record }>, d: Def|
    match d.hash {
      None -> acc,
      Some(h) ->
        push(acc, {
          name: d.name,
          record: {
            def_hash: h,
            specs: spec_set(
              concat(d.specs, match map_get(named, d.name) { Some(texts) -> texts, None -> [] }),
            ),
          },
        }),
    })
}

/// Ascending, with repeats dropped: the one spelling of a set of claim hashes.
fn spec_set(specs: List<String>) -> List<String> / {abort.raise} =
  fold(sort(specs), [], |acc: List<String>, x: String|
    if len(acc) > 0 && at(acc, len(acc) - 1) == x { acc } else { push(acc, x) })

pub fn record_map(rs: List<{ name: String, record: Record }>) -> Map<String, Record> =
  fold(rs, map_new(), |m: Map<String, Record>, r: { name: String, record: Record }|
    map_insert(m, r.name, r.record))

/// Every claim about one definition: its own clause keys and every law naming it directly.
pub fn spec_hashes(
  name: String,
  spec_texts: Map<String, List<String>>,
  laws: Laws,
) -> List<String> = concat(own_specs(spec_texts, name), naming(laws, name))

fn own_specs(spec_texts: Map<String, List<String>>, name: String) -> List<String> =
  match map_get(spec_texts, name) { Some(xs) -> xs, None -> [] }

// --- What the cache answered --------------------------------------------------

pub type Reason = | Fresh | FromProof | Uncached | CacheRefused

/// Whether the cache answered, as against answered that it could not.
pub fn reason_hit(r: Reason) -> Bool = r == FromProof

pub fn reason_word(r: Reason) -> String =
  match r {
    Fresh -> "new",
    FromProof -> "cached proof",
    Uncached -> "uncached",
    CacheRefused -> "cache refused",
  }

/// One obligation's answer from the cache. `from` is the key its evidence is read back from, present
/// exactly when the cache answered: a refusal is an answer, and not evidence.
pub type Answer = { reason: Reason, from: Option<String>, warning: Option<String> }

pub fn missed(reason: Reason) -> Answer = { reason: reason, from: None, warning: None }

/// What the obligation cache holds under one key: `proof` for a proof read off the claim alone,
/// `run` for one a run helped make, or `other` for something it cannot read at all. Absent when
/// nothing is filed there.
pub type Held = Option<String>

/// A proof read off the claim alone may only sit under the bare key, and one a run helped make only
/// under the key of what the claim executes. The reason to give, where the evidence is read from,
/// and — when something was filed under the wrong key — what was wrong with it.
pub fn verdict_of(
  bare_key: String,
  run_key: String,
  bare: Held,
  ran: Held,
) -> Answer / {abort.raise} =
  match bare {
    None -> match ran {
      None -> missed(Fresh),
      Some(kind) -> if kind == "run" { { reason: FromProof, from: Some(run_key), warning: None } }
      else { refused(kind, false, bare_key) },
    },
    Some(kind) -> if kind == "proof" { { reason: FromProof, from: Some(bare_key), warning: None } }
    else { refused(kind, true, bare_key) },
  }

/// `bare` is which key was filled. A cache that silently declines looks like a slow prover, so a
/// refusal is reported.
fn refused(kind: String, bare: Bool, key: String) -> Answer / {abort.raise} = {
  let what = if kind == "run" { "a proof a run helped make" }
  else if kind == "proof" { "a proof read off the claim alone" }
  else { "something it cannot read" };
  let where = if bare { "the bare key" } else { "a run key" };
  {
    reason: CacheRefused,
    from: None,
    warning: Some(
      "the obligation cache holds " ++ what ++ " under " ++ where ++ " for `"
        ++ string_slice(key, 0, 12)
        ++ "`; it was discarded",
    ),
  }
}

/// What the cache answered for each obligation, parallel to the obligation list.
pub type Selection = {
  reasons: List<Reason>,
  /// The key each obligation's evidence is read back from, when the cache answered for it.
  from: List<Option<String>>,
  /// Indices the cache could not answer for, in order.
  to_discharge: List<Int>,
  warnings: List<String>,
}

pub fn hits(s: Selection) -> Int = len(filter(s.reasons, reason_hit))

/// `answers` is what the cache held for each obligation, which a run that reads no cache discards.
pub fn select(answers: List<Answer>, use_cache: Bool) -> Selection / {abort.raise} = {
  let decided = map(answers, |a: Answer| if use_cache { a } else { missed(Uncached) });
  {
    reasons: map(decided, |a: Answer| a.reason),
    from: map(decided, |a: Answer| a.from),
    to_discharge: filter(range(0, len(decided)), |i: Int| at(decided, i).from == None),
    warnings: fold(decided, [], |acc: List<String>, a: Answer|
      match a.warning { Some(w) -> push(acc, w), None -> acc }),
  }
}

/// Where each proof just made is filed: one read off the claim alone under the obligation's own key,
/// one a run helped make under the key of what the claim executes. `proofs` says of each outcome
/// whether a run helped make its proof, with none where nothing was proved: a refutation, a vacuity
/// and a gap re-run until they go green. Nothing is filed when the cache is off.
pub fn filings(
  keys: List<{ bare: String, ran: String }>,
  proofs: List<Option<Bool>>,
  to_discharge: List<Int>,
  use_cache: Bool,
) -> List<{ at: Int, key: String }> / {abort.raise} =
  if !use_cache { [] } else {
    fold(to_discharge, [], |acc: List<{ at: Int, key: String }>, position: Int|
      match at(proofs, position) {
        None -> acc,
        Some(ran) -> {
          let k = at(keys, position);
          push(acc, { at: position, key: if ran { k.ran } else { k.bare } })
        },
      })
  }

// --- How much of the program a reader still has to read ------------------------

pub type Coverage = { definitions: Int, covered: Int, uncovered: List<String> }

/// One obligation's result, as everything below needs it: what it is about, whether a proof
/// established it, and whether a discharge reached a verdict at all.
pub type ClaimRow = { owner: String, kind: Kind, holds: Bool, discharged: Bool }

/// The definitions each proof covers. A clause covers its owner; a law covers everything it names,
/// which is why a law is worth writing.
pub fn covered_by(claim: ClaimRow, laws: Laws) -> List<String> = owners(claim, laws)

/// How many definitions a proof covers. `uncovered` is in name order, since it is a list to work
/// through.
pub fn coverage(defs: List<String>, laws: Laws, results: List<ClaimRow>) -> Coverage = {
  let held = map_of_entries(map(defs, |name: String| { key: name, value: true }));
  let covered = fold(results, map_new(), |acc: Map<String, Bool>, r: ClaimRow|
    if !r.holds { acc } else {
      fold(covered_by(r, laws), acc, |m: Map<String, Bool>, name: String|
        if map_contains(held, name) { map_insert(m, name, true) } else { m })
    });
  {
    definitions: len(defs),
    covered: map_len(covered),
    uncovered: sort(filter(defs, |name: String| !map_contains(covered, name))),
  }
}

/// What an obligation is about, before anything became of it.
pub type Claimed = { owner: String, kind: Kind }

/// How many definitions carry at least one obligation at all, whatever became of it. A definition
/// named twice by the same law is still one definition.
pub fn specified(defs: List<String>, laws: Laws, claims: List<Claimed>) -> Int = {
  let held = map_of_entries(map(defs, |name: String| { key: name, value: true }));
  let named = fold(claims, map_new(), |acc: Map<String, Bool>, c: Claimed|
    fold(owners_of(c.owner, c.kind, laws), acc, |out: Map<String, Bool>, name: String|
      if map_contains(held, name) { map_insert(out, name, true) } else { out }));
  map_len(named)
}

// --- What moved since a reader accepted it ------------------------------------

pub type Change = {
  name: String,
  implementation: Moved,
  spec: Moved,
  /// Indices into the run's own rows, in report order.
  obligations: List<Int>,
  /// How many of them the machine actually established.
  holding: Int,
}

/// Whether anything about this definition is a claim the machine established.
pub fn is_specified(change: Change) -> Bool = change.holding > 0

pub fn claimed(change: Change) -> Bool = len(change.obligations) > 0

pub fn changed(change: Change) -> Bool =
  change.implementation != Unchanged || change.spec != Unchanged

/// The coverage and the definition count are the run's own; this is the part the review decides.
pub type Changes = {
  /// Definitions with a baseline at all.
  reviewed: Int,
  /// Only the definitions that moved, in program order.
  changed: List<Change>,
  /// Obligations attached to a changed definition that did **not** hold.
  broken: Int,
  /// How many of those were never discharged at all, rather than refuted or found vacuous.
  undischarged: Int,
}

pub fn specified_changes(c: Changes) -> Int = len(filter(c.changed, is_specified))

pub fn unspecified_changes(c: Changes) -> Int = len(c.changed) - specified_changes(c)

/// Which definitions moved, whether their claims moved with them, and what became of those claims.
/// `current` is each definition's hash and spec as they stand now, `baselines` what was accepted, and
/// `results` the run's own rows: `holds` is whether the machine established the claim, `discharged`
/// whether it reached a verdict at all.
pub fn review(
  defs: List<String>,
  laws: Laws,
  current: Map<String, Record>,
  baselines: Map<String, Record>,
  results: List<ClaimRow>,
) -> Changes / {abort.raise} = {
  let owed = fold(range(0, len(results)), map_new(), |acc: Map<String, List<Int>>, i: Int| {
    let r = at(results, i);
    fold(owners(r, laws), acc, |m: Map<String, List<Int>>, name: String|
      map_insert(m, name, push(get_or(m, name, []), i)))
  });
  let walked = fold(
    defs,
    { reviewed: 0, changed: [], broken: 0, undischarged: 0 },
    |acc: { reviewed: Int, changed: List<Change>, broken: Int, undischarged: Int }, name: String|
      match map_get(current, name) {
        None -> acc,
        Some(now) -> {
          let baseline = map_get(baselines, name);
          let checked = {
            ..acc,
            reviewed: acc.reviewed + (match baseline { Some(_) -> 1, None -> 0 }),
          };
          let entry = {
            name: name,
            implementation: match baseline {
              None -> Never,
              Some(was) -> moved(was.def_hash == now.def_hash),
            },
            spec: match baseline {
              None -> Never,
              Some(was) -> moved(spec_set(was.specs) == spec_set(now.specs)),
            },
            obligations: get_or(owed, name, []),
            holding: len(filter(get_or(owed, name, []), |i: Int| at(results, i).holds)),
          };
          if changed(entry) {
            {
              ..checked,
              changed: push(checked.changed, entry),
              broken: checked.broken
                + len(filter(entry.obligations, |i: Int| !at(results, i).holds)),
              undischarged: checked.undischarged
                + len(filter(entry.obligations, |i: Int| !at(results, i).discharged)),
            }
          } else { checked }
        },
      },
  );
  {
    reviewed: walked.reviewed,
    changed: walked.changed,
    broken: walked.broken,
    undischarged: walked.undischarged,
  }
}

/// A clause covers its owner; a law covers everything it names, which is why a law is worth writing.
fn owners(r: ClaimRow, laws: Laws) -> List<String> = owners_of(r.owner, r.kind, laws)

fn owners_of(owner: String, kind: Kind, laws: Laws) -> List<String> =
  match kind { Law(_) -> law_targets(laws, owner), _ -> [owner] }

fn moved(same: Bool) -> Moved = if same { Unchanged } else { Changed }

// --- Helpers ------------------------------------------------------------------

// --- Tests ------------------------------------------------------------------
//
// The selection is a decision table, and the coverage and review are accounting over rows, so these
// pin every branch: what the cache answered, which definitions moved, and which claims went with
// them.

fn a_row(owner: String, kind: Kind, holds: Bool, discharged: Bool) -> ClaimRow =
  { owner: owner, kind: kind, holds: holds, discharged: discharged }

fn a_clause(owner: String, holds: Bool) -> ClaimRow = a_row(owner, Ensures(0), holds, holds)

fn a_law(owner: String, holds: Bool) -> ClaimRow = a_row(owner, Law(None), holds, holds)

/// The rules are the prover's own document, placed under `rules` as it wrote them: a certificate
/// crosses once, and what a rule is called is its business rather than this report's. `ran` is
/// whether a run helped make it: every point of the claim's domain walked, or a value found that its
/// guard admits.
pub type Certificate = {
  rules: List<Rule>,
  steps: Int,
  guard_satisfiable: Bool,
  sorts: List<String>,
  ran: Bool,
}

derive bin for Certificate

/// A point a claim does not hold at, and for a law over a `simulate` region, the seed of the
/// interleaving it failed under.
pub type Counter = { bindings: List<Binding>, seed: Option<String> }

/// What the runtime answered for one point. Judging a guard alone, `JHeld` is a point it admitted.
pub type Judged =
  | JHeld
  | JFailed
  | JRejected
  /// The program raised; `message` names `values` by their slots.
  | JRaised({ message: String, values: List<Value> })
  /// Ply failed, which says nothing about the claim.
  | JFaulted({ code: String, message: String, notes: List<String>, values: List<Value> })

/// What became of a claim. Only `Proved` lets a run pass: a claim nothing proved is one the program
/// may not rest on, whether or not anything refuted it.
/// Whether a claim came back proved, the one outcome a run does not fail on.
pub fn is_proved(outcome: Outcome) -> Bool = match outcome { Proved(_) -> true, _ -> false }

pub type Outcome =
  | Proved(Certificate)
  | Refuted(Counter)
  /// A guard that admits no value, where it is written, as the CLI points at it, spelled out so
  /// this package carries no opinion about a label.
  | Vacuous({ guard: { module: Int, start: Int, end: Int } })
  | Unproved(Gap)
  /// Ply failed rather than the program: neither a verdict on the claim nor a gap in it.
  | Defect(Fault)

// --- What a discharge has to say for itself ---------------------------------

fn field(fields: Map<String, Json>, key: String) -> Json =
  match map_get(fields, key) { Some(v) -> v, None -> Null }

fn text_at(fields: Map<String, Json>, key: String) -> String =
  match field(fields, key) { Str(s) -> s, _ -> "" }

fn int_at(fields: Map<String, Json>, key: String) -> Int =
  match field(fields, key) {
    Number(d) -> match int_of_decimal(d, Down) { Some(n) -> n, None -> 0 },
    _ -> 0,
  }

/// A rule the prover named with fields carries them under its own tag, and one that needs none is
/// the tag alone.
type Tagged = { tag: String, body: Map<String, Json> }

fn no_fields() -> Map<String, Json> = map_new()

fn tagged(m: Map<String, Json>) -> Tagged =
  map_fold(m, { tag: "", body: no_fields() }, |acc: Tagged, k: String, v: Json|
    if acc.tag == "" { { tag: k, body: match v { Object(fs) -> fs, _ -> no_fields() } } }
    else { acc })

fn spaced(tag: String) -> String = join(string_split(tag, "_"), " ")

fn rule_tag(r: Json) -> String = match r { Str(tag) -> tag, Object(m) -> tagged(m).tag, _ -> "" }

fn unfolds(r: Json) -> Bool = rule_tag(r) == "unfold"

/// An unfolding is counted rather than named, so a certificate that unfolded a hundred times is
/// still one line.
fn rule_text(r: Json) -> String / {abort.raise} =
  match r {
    Str(tag) -> spaced(tag),
    Object(m) -> {
      let t: Tagged = tagged(m);
      if t.tag == "exhaustive_enumeration" {
        let points = int_at(t.body, "points");
        "exhaustive over " ++ int_to_string(points) ++ " " ++ plural(points, "point") ++ " of "
          ++ text_at(t.body, "domain")
      } else if t.tag == "case_split" {
        "case analysis over " ++ text_at(t.body, "ty") ++ " ("
          ++ int_to_string(int_at(t.body, "arms"))
          ++ " arms)"
      } else if t.tag == "induction" {
        (if text_at(t.body, "over") == "list" { "structural induction on " }
          else { "induction on " })
          ++ text_at(t.body, "binder")
          ++ ", unrolling "
          ++ text_at(t.body, "def")
      } else if t.tag == "lemma" { "lemma \"" ++ text_at(t.body, "label") ++ "\"" }
      else if t.tag == "exhaustive_interleaving" {
        let n = int_at(t.body, "interleavings");
        "exhaustive over " ++ int_to_string(n) ++ " " ++ plural(n, "interleaving")
      } else { spaced(t.tag) }
    },
    _ -> "",
  }

fn rules_of(c: Certificate) -> List<Json> = map(c.rules, rule_json)

fn named_once(parts: List<String>, part: String) -> List<String> =
  if fold(parts, false, |seen: Bool, p: String| seen || p == part) { parts }
  else { push(parts, part) }

pub fn certificate_summary(c: Certificate) -> String / {abort.raise} = {
  let rules = rules_of(c);
  let named = fold(rules, [], |acc: List<String>, r: Json|
    if unfolds(r) { acc } else { named_once(acc, rule_text(r)) });
  let unfoldings = len(filter(rules, |r: Json| unfolds(r)));
  let counted = if unfoldings > 0 {
    push(named, int_to_string(unfoldings) ++ " " ++ plural(unfoldings, "unfolding"))
  } else { named };
  let sorted = if len(c.sorts) > 0 { push(counted, "uninterpreted " ++ join(c.sorts, ", ")) }
  else { counted };
  join(push(sorted, int_to_string(c.steps) ++ " steps"), " · ")
}

/// A count of them wears its word. This is a package, so it carries the one it needs rather than
/// reaching into the CLI's report.
pub fn plural(n: Int, word: String) -> String / {abort.raise} =
  if n == 1 { word }
  else if string_ends_with(word, "y")
      && !ends_in_vowel(string_slice(word, 0, string_len(word) - 1)) {
    string_slice(word, 0, string_len(word) - 1) ++ "ies"
  } else { word ++ "s" }

pub fn ends_in_vowel(stem: String) -> Bool =
  string_ends_with(stem, "a") || string_ends_with(stem, "e") || string_ends_with(stem, "i")
    || string_ends_with(stem, "o")
    || string_ends_with(stem, "u")

test "the cache answers per obligation, and a run that reads none discharges each" {
  let answers = [
    { reason: FromProof, from: Some("k0"), warning: None },
    { reason: Fresh, from: None, warning: None },
    { reason: FromProof, from: Some("r2"), warning: None },
  ];
  let s = select(answers, true);
  assert_eq(s.reasons, [FromProof, Fresh, FromProof]);
  assert_eq(s.from, [Some("k0"), None, Some("r2")]);
  assert_eq(s.to_discharge, [1]);
  assert_eq(hits(s), 2);
  assert_eq(s.warnings, []);
  let s = select(answers, false);
  assert_eq(s.reasons, [Uncached, Uncached, Uncached]);
  assert_eq(s.from, [None, None, None]);
  assert_eq(s.to_discharge, [0, 1, 2]);
  assert_eq(hits(s), 0);
  // A refusal is an answer, and not evidence: it is reported and the obligation runs again.
  let refused = [
    {
      reason: CacheRefused,
      from: None,
      warning: Some("the obligation cache holds something else for `ab`; it was discarded"),
    },
  ];
  let s = select(refused, true);
  assert_eq(s.reasons, [CacheRefused]);
  assert_eq(s.to_discharge, [0]);
  assert_eq(s.warnings, ["the obligation cache holds something else for `ab`; it was discarded"])
}

fn bare() -> String = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

fn ran() -> String = "fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210"

fn verdict(b: Held, r: Held) -> Answer / {abort.raise} = verdict_of(bare(), ran(), b, r)

// Every combination of what the two keys can hold: nothing, a proof read off the claim, one a run
// helped make, or an entry the cache could not read.
test "a proof read off the claim sits under the bare key, and one a run helped make under the run's" {
  assert_eq(verdict(None, None), { reason: Fresh, from: None, warning: None });
  assert_eq(verdict(Some("proof"), None), { reason: FromProof, from: Some(bare()), warning: None });
  assert_eq(verdict(None, Some("run")), { reason: FromProof, from: Some(ran()), warning: None });
  // The bare key decides whatever the run's holds.
  assert_eq(verdict(Some("proof"), Some("run")).from, Some(bare()));
  assert_eq(verdict(Some("proof"), Some("proof")).from, Some(bare()));
  assert_eq(verdict(Some("run"), Some("run")).reason, CacheRefused);
  assert_eq(verdict(Some("other"), Some("run")).reason, CacheRefused)
}

test "anything under the wrong key is refused, and says which key it was under" {
  let bare_run = verdict(Some("run"), None);
  assert_eq(bare_run.reason, CacheRefused);
  assert_eq(bare_run.from, None);
  assert_eq(
    bare_run.warning,
    Some(
      "the obligation cache holds a proof a run helped make under the bare key for `0123456789ab`; it was discarded",
    ),
  );
  let run_proof = verdict(None, Some("proof"));
  assert_eq(run_proof.reason, CacheRefused);
  assert_eq(
    run_proof.warning,
    Some(
      "the obligation cache holds a proof read off the claim alone under a run key for `0123456789ab`; it was discarded",
    ),
  );
  assert_eq(
    verdict(Some("other"), None).warning,
    Some(
      "the obligation cache holds something it cannot read under the bare key for `0123456789ab`; it was discarded",
    ),
  );
  assert_eq(
    verdict(None, Some("other")).warning,
    Some(
      "the obligation cache holds something it cannot read under a run key for `0123456789ab`; it was discarded",
    ),
  );
  // A refusal is discharged again, and its warning reaches the run.
  let s = select([run_proof, verdict(None, Some("run"))], true);
  assert_eq(s.to_discharge, [0]);
  assert_eq(len(s.warnings), 1);
  assert_eq(hits(s), 1)
}

test "a proof is filed under the key its making reads, and a claim nothing proved nowhere" {
  let keys = [{ bare: "b0", ran: "r0" }, { bare: "b1", ran: "r1" }, { bare: "b2", ran: "r2" }];
  let proofs = [Some(false), Some(true), None];
  assert_eq(filings(keys, proofs, [0, 1, 2], true), [{ at: 0, key: "b0" }, { at: 1, key: "r1" }]);
  // Only what this run discharged: an answer from the cache is already filed.
  assert_eq(filings(keys, proofs, [1], true), [{ at: 1, key: "r1" }]);
  assert_eq(filings(keys, proofs, [0, 1, 2], false), [])
}

test "a law names definitions, and the sentence it was written as is part of their spec" {
  let laws = add_law(
    add_law(no_laws(), "m.sorted", "h-law", ["m.insert", "m.sort"]),
    "m.total",
    "h-other",
    ["m.sort"],
  );
  assert_eq(law_targets(laws, "m.sorted"), ["m.insert", "m.sort"]);
  assert_eq(law_targets(laws, "nothing"), []);
  assert_eq(has_laws(laws), true);
  assert_eq(has_laws(no_laws()), false);
  // Ascending by law, so the same program always reports its spec the same way.
  assert_eq(naming(laws, "m.sort"), ["h-law", "h-other"]);
  assert_eq(naming(laws, "m.insert"), ["h-law"]);
  assert_eq(naming(laws, "m.nothing"), []);
  // A law with no text on record contributes nothing, rather than an empty entry.
  let texts = map_insert(map_new(), "m.insert", ["h-clause"]);
  assert_eq(spec_hashes("m.insert", texts, laws), ["h-clause", "h-law"]);
  assert_eq(spec_hashes("m.sort", texts, laws), ["h-law", "h-other"]);
  assert_eq(spec_hashes("m.nothing", texts, laws), [])
}

test "a definition is covered by a claim about it that was proved" {
  let laws = add_law(no_laws(), "m.sorted", "h-law", ["m.sort"]);
  let defs = ["m.sort", "m.insert", "m.other"];
  let results = [
    a_clause("m.sort", false),
    { ..a_clause("m.sort", true), kind: Cost(0) },
    a_clause("m.insert", true),
    a_law("m.sorted", false),
  ];
  let c = coverage(defs, laws, results);
  assert_eq(c.definitions, 3);
  assert_eq(c.covered, 2);
  // In name order, since it is a list to work through.
  assert_eq(c.uncovered, ["m.other"]);
  // A claim nothing proved covers nothing, whatever it is about.
  let c = coverage(defs, laws, [a_row("m.sort", Ensures(0), false, true)]);
  assert_eq(c.covered, 0);
  assert_eq(c.uncovered, ["m.insert", "m.other", "m.sort"])
}

test "a law covers every definition it names, and a definition named twice is still one" {
  let laws = add_law(no_laws(), "m.sorted", "h-law", ["m.sort", "m.insert"]);
  let defs = ["m.sort", "m.insert", "m.other"];
  let claims = [{ owner: "m.sorted", kind: Law(None) }, { owner: "m.sort", kind: Ensures(0) }];
  assert_eq(specified(defs, laws, claims), 2);
  // A claim about a definition outside the program is not counted.
  assert_eq(specified(defs, laws, [{ owner: "m.gone", kind: Ensures(0) }]), 0);
  // Carrying a claim is a fact about the program, whatever became of the claim.
  assert_eq(specified(defs, laws, [{ owner: "m.sort", kind: Ensures(0) }]), 1);
  assert_eq(specified(defs, laws, []), 0)
}

test "a law covers the definitions it mentions, and nothing else it names" {
  let laws = laws_of(["m.credited", "m.debited", "m.helper"], [
    {
      key: "m.cancel",
      text: "h9",
      mentions: ["m.credited", "m.debited", "std.list.len", "m.Coin"],
    },
  ]);
  assert_eq(law_targets(laws, "m.cancel"), ["m.credited", "m.debited"]);
  assert_eq(law_text(laws, "m.cancel"), Some("h9"));
  let c = coverage(["m.credited", "m.debited", "m.helper"], laws, [a_law("m.cancel", true)]);
  assert_eq(c.covered, 2);
  assert_eq(c.uncovered, ["m.helper"]);
  // A law that does not hold covers nothing.
  let refuted = coverage(["m.credited"], laws, [a_row("m.cancel", Law(None), false, true)]);
  assert_eq(refuted.covered, 0);
  assert_eq(refuted.uncovered, ["m.credited"])
}

test "a definition with no obligation is never covered, and each covered one counts once" {
  let none = coverage(["m.f"], no_laws(), []);
  assert_eq(none.covered, 0);
  assert_eq(none.uncovered, ["m.f"]);
  // Only an obligation that holds covers its definition.
  let c = coverage(["m.f", "m.g", "m.h", "m.i"], no_laws(), [
    a_clause("m.f", true),
    a_row("m.g", Ensures(0), false, true),
    a_row("m.h", Ensures(0), false, false),
  ]);
  assert_eq(c.definitions, 4);
  assert_eq(c.covered, 1);
  assert_eq(c.uncovered, ["m.g", "m.h", "m.i"]);
  let both = coverage(["m.f", "m.g"], no_laws(), [
    a_clause("m.f", true),
    { ..a_clause("m.f", true), kind: Ensures(1) },
    a_clause("m.g", true),
  ]);
  assert_eq(both.covered, 2)
}

test "a definition's record is its hash, its own clauses and the laws naming it" {
  let laws = add_law(no_laws(), "m.cancel", "h-law", ["m.f"]);
  let rs = records(
    [
      { name: "m.f", hash: Some("h1"), specs: ["h7"] },
      { name: "m.g", hash: Some("h2"), specs: [] },
      { name: "m.unhashed", hash: None, specs: ["h8"] },
    ],
    laws,
  );
  // One baseline per hashed definition, keyed by name.
  // A spec is a set, so it has one spelling however it was gathered.
  assert_eq(rs, [
    { name: "m.f", record: { def_hash: "h1", specs: ["h-law", "h7"] } },
    { name: "m.g", record: { def_hash: "h2", specs: [] } },
  ]);
  assert_eq(map_get(record_map(rs), "m.g"), Some({ def_hash: "h2", specs: [] }))
}

fn baselines_of(
  xs: List<{ name: String, def_hash: String, specs: List<String> }>,
) -> Map<String, Record> =
  fold(
    xs,
    map_new(),
    |m: Map<String, Record>, x: { name: String, def_hash: String, specs: List<String> }|
      map_insert(m, x.name, { def_hash: x.def_hash, specs: x.specs }),
  )

test "the review names what moved, and what became of the claims that went with it" {
  let laws = no_laws();
  let defs = ["m.moved", "m.spec_moved", "m.same", "m.fresh"];
  let current = baselines_of([
    { name: "m.moved", def_hash: "h2", specs: ["s1"] },
    { name: "m.spec_moved", def_hash: "h1", specs: ["s2"] },
    { name: "m.same", def_hash: "h1", specs: ["s1"] },
    { name: "m.fresh", def_hash: "h1", specs: ["s1"] },
  ]);
  let baselines = baselines_of([
    { name: "m.moved", def_hash: "h1", specs: ["s1"] },
    { name: "m.spec_moved", def_hash: "h1", specs: ["s1"] },
    { name: "m.same", def_hash: "h1", specs: ["s1"] },
  ]);
  let results = [
    a_clause("m.moved", true),
    a_row("m.spec_moved", Ensures(0), false, true),
    a_row("m.fresh", Ensures(0), false, false),
    a_clause("m.same", true),
  ];
  let r = review(defs, laws, current, baselines, results);
  assert_eq(r.reviewed, 3);
  // In program order, and only what moved: `m.same` is unchanged in both halves.
  assert_eq(map(r.changed, |change: Change| change.name), ["m.moved", "m.spec_moved", "m.fresh"]);
  assert_eq(map(r.changed, |change: Change| moved_word(change.implementation)), [
    "changed",
    "unchanged",
    "never",
  ]);
  assert_eq(map(r.changed, |change: Change| moved_word(change.spec)), [
    "unchanged",
    "changed",
    "never",
  ]);
  // `m.moved` held; `m.spec_moved` was refuted; `m.fresh` was never tried at all.
  assert_eq(map(r.changed, |change: Change| change.holding), [1, 0, 0]);
  assert_eq(map(r.changed, |change: Change| claimed(change)), [true, true, true]);
  assert_eq(r.broken, 2);
  assert_eq(r.undischarged, 1);
  assert_eq(specified_changes(r), 1);
  assert_eq(unspecified_changes(r), 2);
  assert_eq(map(r.changed, |change: Change| change.obligations), [[0], [1], [2]])
}

test "a law that moved takes its targets' spec with it" {
  // The law is what makes `m.sort`'s spec different, with `m.sort` itself untouched.
  let laws = add_law(no_laws(), "m.sorted", "h-law-2", ["m.sort"]);
  let defs = ["m.sort"];
  let current = map_insert(map_new(), "m.sort", {
    def_hash: "h1",
    specs: spec_hashes("m.sort", map_new(), laws),
  });
  let baselines = baselines_of([{ name: "m.sort", def_hash: "h1", specs: ["h-law-1"] }]);
  let r = review(defs, laws, current, baselines, []);
  assert_eq(map(r.changed, |change: Change| change.name), ["m.sort"]);
  assert_eq(moved_word(at(r.changed, 0).implementation), "unchanged");
  assert_eq(moved_word(at(r.changed, 0).spec), "changed");
  // With no claims about it, nothing is broken by the move — but it is a list to read.
  assert_eq(r.broken, 0);
  assert_eq(r.undischarged, 0)
}

/// The review a run over `after` reads, against the baseline `--accept` recorded over `before`.
fn reviewed_after(
  defs: List<String>,
  before: List<Def>,
  laws_before: Laws,
  after: List<Def>,
  laws_after: Laws,
  results: List<ClaimRow>,
) -> Changes / {abort.raise} =
  review(
    defs,
    laws_after,
    record_map(records(after, laws_after)),
    record_map(records(before, laws_before)),
    results,
  )

fn def(name: String, hash: String, specs: List<String>) -> Def =
  { name: name, hash: Some(hash), specs: specs }

test "what a review names: the moved half, the claims that went with it, and nothing unmoved" {
  // An unchanged definition is not reported at all, though it has a baseline.
  let same = reviewed_after(
    ["m.f"],
    [def("m.f", "h1", ["h7"])],
    no_laws(),
    [def("m.f", "h1", ["h7"])],
    no_laws(),
    [a_clause("m.f", true)],
  );
  assert_eq(same.changed, []);
  assert_eq(same.reviewed, 1);
  // A definition with no baseline is unreviewed rather than unchanged.
  let fresh = reviewed_after(
    ["m.new"],
    [def("m.old", "h1", [])],
    no_laws(),
    [def("m.new", "h1", [])],
    no_laws(),
    [],
  );
  assert_eq(map(fresh.changed, |change: Change| moved_word(change.implementation)), ["never"]);
  assert_eq(fresh.reviewed, 0);
  // Two changed definitions, one covered by a claim that holds: the other is a change this run
  // says nothing about.
  let two = reviewed_after(
    ["m.f", "m.g"],
    [def("m.f", "h1", ["h7"]), def("m.g", "h3", [])],
    no_laws(),
    [def("m.f", "h2", ["h7"]), def("m.g", "h4", [])],
    no_laws(),
    [a_clause("m.f", true)],
  );
  assert_eq(len(two.changed), 2);
  assert_eq(specified_changes(two), 1);
  assert_eq(unspecified_changes(two), 1);
  assert_eq(two.broken, 0)
}

test "a refuted claim is broken, and one never discharged is broken and undischarged too" {
  let before = [def("m.f", "h1", ["h7"])];
  let after = [def("m.f", "h2", ["h7"])];
  let refuted = reviewed_after(["m.f"], before, no_laws(), after, no_laws(), [
    a_row("m.f", Ensures(0), false, true),
  ]);
  assert_eq(refuted.broken, 1);
  assert_eq(refuted.undischarged, 0);
  let gap = reviewed_after(["m.f"], before, no_laws(), after, no_laws(), [
    a_row("m.f", Ensures(0), false, false),
  ]);
  assert_eq(gap.broken, 1);
  assert_eq(gap.undischarged, 1);
  let entry = at(gap.changed, 0);
  assert_eq(moved_word(entry.implementation), "changed");
  assert_eq(moved_word(entry.spec), "unchanged");
  // An obligation nothing established is not a specification that holds, and it is still a claim.
  assert_eq(is_specified(entry), false);
  assert_eq(claimed(entry), true);
  assert_eq(specified_changes(gap), 0)
}

test "a baseline read back in another order is the same spec" {
  let laws = add_law(add_law(no_laws(), "m.b", "h-b", ["m.f"]), "m.a", "h-a", ["m.f"]);
  let now = record_map(records([def("m.f", "h1", ["h9", "h1c"])], laws));
  let stored = baselines_of([
    { name: "m.f", def_hash: "h1", specs: ["h9", "h-b", "h1c", "h-a", "h9"] },
  ]);
  let r = review(["m.f"], laws, now, stored, []);
  assert_eq(r.changed, []);
  assert_eq(r.reviewed, 1)
}

test "a law's text is its targets' spec, wherever the law is declared" {
  let f = [def("m.f", "h1", [])];
  // Moving a law between modules changes its key and not its text, so no baseline moves.
  let moved_law = reviewed_after(
    ["m.f"],
    f,
    add_law(no_laws(), "a.cancel", "h9", ["m.f"]),
    f,
    add_law(no_laws(), "b.cancel", "h9", ["m.f"]),
    [a_law("b.cancel", true)],
  );
  assert_eq(moved_law.changed, []);
  // Rewriting it, or deleting it, is a spec change on everything it named.
  let rewritten = reviewed_after(
    ["m.f"],
    f,
    add_law(no_laws(), "m.cancel", "h9", ["m.f"]),
    f,
    add_law(no_laws(), "m.cancel", "h10", ["m.f"]),
    [a_law("m.cancel", true)],
  );
  assert_eq(map(rewritten.changed, |change: Change| moved_word(change.spec)), ["changed"]);
  assert_eq(map(rewritten.changed, |change: Change| moved_word(change.implementation)), [
    "unchanged",
  ]);
  let deleted = reviewed_after(
    ["m.f"],
    f,
    add_law(no_laws(), "m.cancel", "h9", ["m.f"]),
    f,
    no_laws(),
    [],
  );
  assert_eq(map(deleted.changed, |change: Change| moved_word(change.spec)), ["changed"])
}

test "every word a report prints for a reason or a move" {
  assert_eq(reason_word(Fresh), "new");
  assert_eq(reason_word(FromProof), "cached proof");
  assert_eq(reason_word(Uncached), "uncached");
  assert_eq(reason_word(CacheRefused), "cache refused");
  assert_eq(reason_hit(FromProof), true);
  assert_eq(reason_hit(Fresh), false);
  assert_eq(moved_word(Never), "never")
}

/// A binder a discharge saw, and the value it was given.
pub type Binding = { name: String, ty: String, value: Value }

/// A place the static prover left the fragment it decides: `kind` names the construct, and
/// `about` the definition or reason it names.
pub type Stuck = { kind: String, about: Option<String> }

/// What stands between a claim and a proof of it. Nothing refuted the claim and nothing established
/// it, so the run fails on it.
pub type Gap =
  /// The static prover closed no proof, within its budget or not, and no run walks every point of
  /// the claim's domain.
  | Open({ spent: Bool, stuck: List<Stuck> })
  /// `None` when the owner's row is empty, which names nothing to hold a handler for.
  | UnhandledEffect(Option<String>)
  /// `message` names `values` by their slots.
  | Raised({ message: String, values: List<Value>, bindings: List<Binding> })
  /// Proved of every value the guard admits, with no value found that it admits.
  | NoWitness
  /// A law over a `simulate` region whose binders' domain no run walks whole.
  | Endless
  /// A law over a `simulate` region with more interleavings than the search explores: how many it
  /// ran.
  | Unsearched(Int)

pub fn gap_summary(g: Gap) -> String / {abort.raise} =
  match g {
    Open(o) -> if o.spent { "no proof within the prover's budget" } else { "no proof" },
    UnhandledEffect(row) -> match row {
      None -> "no handler for what it performs",
      Some(text) -> "performs " ++ text ++ ": no handler",
    },
    Raised(r) -> "raised: " ++ filled(r.message, r.values),
    NoWitness -> "proved of every value its guard admits, and no value found that it admits",
    Endless -> "its binders' domain is not one a run walks whole",
    Unsearched(ran) ->
      "more interleavings than the search explores, " ++ int_to_string(ran) ++ " of them run",
  }

/// A gap's kind, as a document names it for a reader that counts gaps rather than reading them.
pub fn gap_word(g: Gap) -> String =
  match g {
    Open(_) -> "open",
    UnhandledEffect(_) -> "unhandled_effect",
    Raised(_) -> "raised",
    NoWitness -> "unwitnessed",
    Endless -> "endless",
    Unsearched(_) -> "unsearched",
  }

/// Where the static prover stopped, as a line under an unproved claim reads: the construct it does
/// not decide, with the definition it names, or the reason an induction or a `cost` bound gave.
pub fn stuck_summary(s: Stuck) -> String = {
  let stopped = |what: String|
    "the prover stopped at "
      ++ (match s.about { Some(a) -> what ++ " `" ++ a ++ "`", None -> what });
  if s.kind == "recursive_call" { stopped("a call of the recursive") }
  else if s.kind == "effectful_call" { stopped("a call that performs, of") }
  else if s.kind == "unfold_limit" { stopped("calls nested deeper than it unfolds, at") }
  else if s.kind == "opaque_call" {
    stopped("a call of a builtin or of a name from outside the program,")
  } else if s.kind == "induction" || s.kind == "unbounded" {
    match s.about { Some(why) -> why, None -> stopped(s.kind) }
  } else { stopped(join(string_split(s.kind, "_"), " ")) }
}

/// Ply's own failure while discharging a claim, and the point it was judging, if one was.
/// `message` and `notes` name `values` by their slots.
pub type Fault = {
  code: String,
  message: String,
  notes: List<String>,
  values: List<Value>,
  bindings: List<Binding>,
}

pub fn fault_message(f: Fault) -> String / {abort.raise} = filled(f.message, f.values)

pub fn fault_notes(f: Fault) -> List<String> / {abort.raise} =
  map(f.notes, |n: String| filled(n, f.values))

/// What Ply's failure reads as, in the words `ply test` gives a defect: the program is not to blame.
pub fn fault_summary(f: Fault) -> String / {abort.raise} =
  "Ply failed rather than the program, so this is a defect in Ply: " ++ fault_message(f)

pub fn vacuity_summary() -> String = "the guard admits no value"

test "a gap reads as one line" {
  assert_eq(gap_summary(Open({ spent: false, stuck: [] })), "no proof");
  assert_eq(gap_summary(Open({ spent: true, stuck: [] })), "no proof within the prover's budget");
  assert_eq(
    gap_summary(NoWitness),
    "proved of every value its guard admits, and no value found that it admits",
  );
  assert_eq(gap_summary(Endless), "its binders' domain is not one a run walks whole");
  assert_eq(
    gap_summary(Unsearched(4096)),
    "more interleavings than the search explores, 4096 of them run",
  )
}

test "a place the prover stopped at names the construct, and the definition where there is one" {
  assert_eq(stuck_summary({ kind: "lambda", about: None }), "the prover stopped at lambda");
  assert_eq(
    stuck_summary({ kind: "nonlinear_multiplication", about: None }),
    "the prover stopped at nonlinear multiplication",
  );
  assert_eq(
    stuck_summary({ kind: "recursive_call", about: Some("m.f") }),
    "the prover stopped at a call of the recursive `m.f`",
  );
  // An induction that declined and a bound the reading does not show say why themselves.
  assert_eq(
    stuck_summary({ kind: "unbounded", about: Some("its steps are not within the bound") }),
    "its steps are not within the bound",
  )
}

test "the program's raise and Ply's failure each read one way, and only Ply's names Ply" {
  let raised = gap_summary(Raised({ message: "division by zero", values: [], bindings: [] }));
  assert_eq(raised, "raised: division by zero");
  let declined: Fault = {
    code: "E0505",
    message: "the C backend declined to enter `m.law`",
    notes: [],
    values: [],
    bindings: [],
  };
  assert_eq(
    fault_summary(declined),
    "Ply failed rather than the program, so this is a defect in Ply: the C backend declined to enter `m.law`",
  );
  assert(!string_contains(raised, "Ply"))
}

test "every kind of gap has a word of its own" {
  let every = [
    Open({ spent: false, stuck: [] }),
    UnhandledEffect(None),
    Raised({ message: "division by zero", values: [], bindings: [] }),
    NoWitness,
    Endless,
    Unsearched(8),
  ];
  assert_eq(map(every, gap_word), [
    "open",
    "unhandled_effect",
    "raised",
    "unwitnessed",
    "endless",
    "unsearched",
  ]);
  // Two gaps of one kind with different particulars are one word.
  assert_eq(gap_word(UnhandledEffect(Some("{db.read[rows]}"))), gap_word(UnhandledEffect(None)))
}

/// What a definition leaves alone, from its checked footprint.
pub type Frame = | Pure | Writes(List<String>)

pub fn frame_summary(f: Frame) -> String =
  match f { Pure -> "pure", Writes(named) -> "writes " ++ join(named, ", ") }

test "a frame reads as one line too" {
  assert_eq(frame_summary(Pure), "pure");
  assert_eq(frame_summary(Writes(["std.io.file", "clock"])), "writes std.io.file, clock")
}

test "a certificate reads as one line" {
  assert_eq(
    certificate_summary({
      rules: [
        induction_rule("n", Descent(1), "m.f"),
        Unfold({ def: "m.f", depth: 1 }),
        Unfold({ def: "m.g", depth: 1 }),
      ],
      steps: 3,
      guard_satisfiable: true,
      sorts: ["T"],
      ran: false,
    }),
    "induction on n, unrolling m.f · 2 unfoldings · uninterpreted T · 3 steps",
  );
  assert_eq(
    certificate_summary({
      rules: [
        induction_rule("xs", Spine(1), "m.reverse"),
        Cited({ law: "m.a push reversed leads", label: "a push reversed leads" }),
      ],
      steps: 9,
      guard_satisfiable: true,
      sorts: [],
      ran: false,
    }),
    "structural induction on xs, unrolling m.reverse · lemma \"a push reversed leads\" · 9 steps",
  )
}
