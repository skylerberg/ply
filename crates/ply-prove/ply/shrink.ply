// `shrink` — making a counterexample small enough to read.
//
// Greedy descent: at each value of the tuple in turn, the first candidate smaller than the value it
// replaces that still has the property is taken, and the walk starts again from the first value. The
// result is minimal in that no single value can be made smaller without losing the property. The
// number of re-runs is the budget, counted rather than timed, and the size measure is what makes the
// walk end.

import std.decimal (normalize, scale)
import std.decimal
import std.float (is_finite, is_nan, is_infinite, is_sign_negative, trunc)
import std.float
import std.string (code_points, of_code_points)
import std.value (Value, VUnit, VBool, VInt, VFloat, VDecimal, VFixed, VChar, VStr, VBytes, VList,
                  VArray, VRecord, VCtor, VMap, VFn, VCell, VTask, VSecret, VElided, Field, Entry,
                  FNamed, FAnonymous, FConst, FProject, FTable, map_of)
import domain (Ty, Var, Fn, Record, Con)
import gen
import gen (Types, Typed, Ungeneratable, UCell, UTask, USecret, UEffectful, UUninhabited, UTooDeep,
            by_name, fields_of, generatable, hard_depth)

// The property the original input had, which every accepted candidate must keep.
pub type Target = | Falsifies | Raises

// What the walk came to: the tuple it settled on, how many candidates were kept, and how many were
// tried.
pub type Descent = { values: List<Value>, steps: Int, evaluations: Int }

// The walk. `holds` re-runs the claim at a tuple and says whether it still has the property; the
// budget is how many re-runs it may cost.
pub fn descend<| e>(
  values: List<Value>,
  tys: List<Ty>,
  ts: Types,
  holds: (List<Value>) -> Bool / e,
  budget: Int,
) -> Descent / e = walk({ values: values, steps: 0, evaluations: 0 }, tys, ts, holds, budget)

type Pass = { values: List<Value>, hit: Bool, stopped: Bool, evaluations: Int }

fn walk<| e>(
  d: Descent,
  tys: List<Ty>,
  ts: Types,
  holds: (List<Value>) -> Bool / e,
  budget: Int,
) -> Descent / e = {
  let pass = pass_over(d.values, 0, tys, ts, holds, budget, d.evaluations);
  // A budget spent mid-pass stops the walk where it is rather than claiming minimality.
  if pass.stopped || !pass.hit {
    { values: pass.values, steps: d.steps, evaluations: pass.evaluations }
  } else {
    walk(
      { values: pass.values, steps: d.steps + 1, evaluations: pass.evaluations },
      tys,
      ts,
      holds,
      budget,
    )
  }
}

fn pass_over<| e>(
  values: List<Value>,
  i: Int,
  tys: List<Ty>,
  ts: Types,
  holds: (List<Value>) -> Bool / e,
  budget: Int,
  evaluations: Int,
) -> Pass / e =
  match ((list_at(values, i), list_at(tys, i))) {
    (Some(v), Some(t)) -> {
      let here = size(v, ts);
      let tried = try_alts(values, i, here, candidates(v, t, ts), ts, holds, budget, evaluations);
      if tried.stopped || tried.hit { tried }
      else { pass_over(values, i + 1, tys, ts, holds, budget, tried.evaluations) }
    },
    _ -> { values: values, hit: false, stopped: false, evaluations: evaluations },
  }

// The candidates at one value, in order. One no smaller than the value is skipped without being
// counted — nothing was re-run for it — and the budget is checked only for one that would be.
fn try_alts<| e>(
  values: List<Value>,
  i: Int,
  here: U128,
  alts: List<Value>,
  ts: Types,
  holds: (List<Value>) -> Bool / e,
  budget: Int,
  evaluations: Int,
) -> Pass / e =
  match alts {
    [] -> { values: values, hit: false, stopped: false, evaluations: evaluations },
    [alt, ..rest] -> if size(alt, ts) >= here {
      try_alts(values, i, here, rest, ts, holds, budget, evaluations)
    } else if evaluations >= budget {
      { values: values, hit: false, stopped: true, evaluations: evaluations }
    } else {
      let tried = list_set(values, i, alt);
      if holds(tried) { { values: tried, hit: true, stopped: false, evaluations: evaluations + 1 } }
      else { try_alts(values, i, here, rest, ts, holds, budget, evaluations + 1) }
    },
  }

// --- Size ---------------------------------------------------------------------

// Exact, because a measure that saturates calls every candidate no smaller and stalls the walk:
// every leaf stays below 2^121, so a sum saturates only past a hundred of the largest.
fn top() -> U128 = ~0u128

fn plus(a: U128, b: U128) -> U128 = match checked_add(a, b) { Some(c) -> c, None -> top() }

fn wide(n: Int) -> U128 = u128_of_int(n)

fn least_int() -> Int = 0 - 9223372036854775807 - 1

// `-5` is larger than `5`, which is what makes negating a negative a shrink.
fn int_size(n: Int) -> U128 = {
  let magnitude = if n >= 0 { wide(n) }
  else if n == least_int() { 9223372036854775808u128 }
  else { wide(0 - n) };
  magnitude * 2u128 + (if n < 0 { 1u128 } else { 0u128 })
}

fn width_of(ty: String) -> Int =
  if ty == "U8" || ty == "I8" { 8 }
  else if ty == "U16" || ty == "I16" { 16 }
  else if ty == "U32" || ty == "I32" { 32 }
  else if ty == "U64" || ty == "I64" { 64 }
  else { 128 }

fn mask_of(w: Int) -> U128 = if w == 128 { ~0u128 } else { (1u128 << w) - 1u128 }

// A width's value as its sign and magnitude, which a `U64` or a 128-bit width can take past what an
// `Int` holds.
type Signed = { negative: Bool, magnitude: U128 }

fn signed_of(ty: String, bits: U128) -> Signed = {
  let w = width_of(ty);
  let pattern = bits & mask_of(w);
  if string_starts_with(ty, "I") && pattern >> w - 1 == 1u128 {
    {
      negative: true,
      magnitude: if w == 128 { wrap_sub(0u128, pattern) } else { (1u128 << w) - pattern },
    }
  } else { { negative: false, magnitude: pattern } }
}

fn pattern_of(ty: String, v: Signed) -> U128 = {
  let w = width_of(ty);
  if v.negative && v.magnitude != 0u128 { wrap_sub(0u128, v.magnitude) & mask_of(w) }
  else { v.magnitude }
}

// `int_size` over a width's value. Past 2^118 the magnitude counts in steps of 2^10, which keeps the
// leaf below 2^121 and still makes each halving smaller.
fn fixed_size(ty: String, bits: U128) -> U128 = {
  let v = signed_of(ty, bits);
  let knee = 1u128 << 118;
  let counted = if v.magnitude < knee { v.magnitude } else { knee + (v.magnitude - knee >> 10) };
  counted * 2u128 + (if v.negative { 1u128 } else { 0u128 })
}

// Above every finite float, whose measure is below 2^64.
fn float_size(f: Float) -> U128 =
  if is_nan(f) { 1u128 << 65 }
  else if is_infinite(f) { (1u128 << 65) - 1u128 } else {
    // Measured over the bits: a saturating cast would make every large float one size and stall.
    let magnitude = wide(bits_of_float(f) & 0x7FFF_FFFF_FFFF_FFFF);
    magnitude * 2u128 + (if is_sign_negative(f) { 1u128 } else { 0u128 })
  }

fn decimal_size(d: Decimal) -> U128 = {
  let whole = decimal::trunc(decimal::abs(d));
  let magnitude = match u128_of_string(decimal_to_string(normalize(whole))) {
    Some(m) -> m,
    None -> 0u128,
  };
  let fraction = if decimal::fract(d) == 0m { 0u128 } else { 32u128 };
  let sign = if decimal::is_negative(d) { 1u128 } else { 0u128 };
  magnitude * 64u128 + fraction + wide(scale(d)) + sign
}

// Each declared constructor's place among its type's variants.
fn ctor_index(ts: Types, name: String) -> Int =
  map_fold(ts, 0 - 1, |found: Int, _t: String, typed: Typed|
    if found >= 0 { found } else {
      fold(range(0, len(typed.decl.variants)), 0 - 1, |at: Int, i: Int|
        if at >= 0 { at } else {
          match list_at(typed.decl.variants, i) {
            Some(v) -> if v.name == name { i } else { at },
            None -> at,
          }
        })
    })

fn sum<a>(xs: List<a>, f: (a) -> U128) -> U128 = fold(xs, 0u128, |acc: U128, x: a| plus(acc, f(x)))

// A structural measure, and the reason the walk ends.
pub fn size(v: Value, ts: Types) -> U128 =
  match v {
    VInt(n) -> int_size(n),
    VFixed(ty, bits) -> fixed_size(ty, bits),
    VBool(b) -> if b { 1u128 } else { 0u128 },
    VUnit -> 0u128,
    VFloat(f) -> float_size(f),
    VDecimal(d) -> decimal_size(d),
    VChar(c) -> wide(1 + int_of_char(c)),
    VStr(s) -> sum(code_points(s), |c: Int| wide(1 + c)),
    VBytes(b) -> sum(range(0, bytes_len(b)), |i: Int| wide(1 + bytes_at(b, i))),
    VList(items) -> plus(wide(len(items)), sum(items, |x: Value| size(x, ts))),
    VArray(items) -> plus(wide(len(items)), sum(items, |x: Value| size(x, ts))),
    // Keys count too, so replacing a key with a smaller one is a strict shrink.
    VMap(entries) ->
      plus(wide(len(entries)), sum(entries, |e: Entry| plus(size(e.key, ts), size(e.value, ts)))),
    VRecord(fields) -> sum(fields, |f: Field| size(f.value, ts)),
    VCtor(name, args) ->
      plus(
        plus(1u128, plus(wide(max(ctor_index(ts, name), 0)), wide(len(args)))),
        sum(args, |x: Value| size(x, ts)),
      ),
    VFn(fun) -> match fun {
      FConst(c) -> plus(2u128, size(c.value, ts)),
      FProject(_) -> 1u128,
      FTable(t) ->
        plus(
          4u128,
          plus(
            sum(t.entries, |e: Entry| plus(size(e.key, ts), size(e.value, ts))),
            size(t.default, ts),
          ),
        ),
      _ -> 1u128,
    },
    _ -> 0u128,
  }

// --- The floor ----------------------------------------------------------------

// The smallest value of a type: where the walk bottoms out.
pub fn minimal(t: Ty, ts: Types) -> Result<Value, Ungeneratable> = minimal_at(t, ts, 0)

fn minimal_at(t: Ty, ts: Types, depth: Int) -> Result<Value, Ungeneratable> =
  if depth >= hard_depth() { Err(UTooDeep) } else {
    match t {
      Var(_) -> Ok(VInt(0)),
      Record(fields) -> match all_minimal(
          map(by_name(fields), |f: { name: String, ty: Ty }| f.ty),
          ts,
          depth + 1,
        ) {
        Err(e) -> Err(e),
        Ok(vs) ->
          Ok(
            VRecord(
              map(range(0, len(vs)), |i: Int|
                {
                  name: match list_at(by_name(fields), i) { Some(f) -> f.name, None -> "" },
                  value: match list_at(vs, i) { Some(v) -> v, None -> VUnit },
                }),
            ),
          ),
      },
      Fn(params, ret, pure) -> if !pure { Err(UEffectful) } else {
        match minimal_at(ret, ts, depth + 1) {
          Err(e) -> Err(e),
          Ok(v) -> Ok(VFn(FConst({ arity: len(params), value: v }))),
        }
      },
      Con(name, args) -> if name == "Int" { Ok(VInt(0)) }
      else if (string_starts_with(name, "U") && width_name(name))
          || (string_starts_with(name, "I") && width_name(name)) { Ok(VFixed(name, 0u128)) }
      // `0.0`, not `-0.0`: the two are different values and the positive one is the floor.
      else if name == "Float" { Ok(VFloat(0.0)) }
      else if name == "Decimal" { Ok(VDecimal(0m)) }
      // The letter strings shrink their characters toward, so the two agree.
      else if name == "Char" { Ok(VChar('a')) }
      else if name == "Bool" { Ok(VBool(false)) }
      else if name == "String" { Ok(VStr("")) }
      else if name == "Bytes" { Ok(VBytes(b"")) }
      else if name == "Unit" { Ok(VUnit) }
      else if name == "List" { Ok(VList([])) }
      else if name == "Array" { Ok(VArray([])) }
      else if name == "Map" { Ok(VMap([])) }
      else if name == "Cell" { Err(UCell) }
      else if name == "Task" { Err(UTask) }
      else if name == "Secret" { Err(USecret) } else {
        match shallowest(ts, name, args) {
          None -> Err(UUninhabited(name)),
          Some(v) -> match all_minimal(v.fields, ts, depth + 1) {
            Err(e) -> Err(e),
            Ok(vs) -> Ok(VCtor(v.name, vs)),
          },
        }
      },
    }
  }

fn width_name(name: String) -> Bool =
  fold(
    ["U8", "U16", "U32", "U64", "I8", "I16", "I32", "I64", "U128", "I128"],
    false,
    |f: Bool, w: String| f || w == name,
  )

fn all_minimal(tys: List<Ty>, ts: Types, depth: Int) -> Result<List<Value>, Ungeneratable> =
  fold(tys, Ok([]), |acc: Result<List<Value>, Ungeneratable>, t: Ty|
    match acc {
      Err(_) -> acc,
      Ok(vs) -> match minimal_at(t, ts, depth) { Err(e) -> Err(e), Ok(v) -> Ok(push(vs, v)) },
    })

// The usable variant needing the fewest nested applications, the earlier declared on a tie.
fn shallowest(
  ts: Types,
  name: String,
  args: List<Ty>,
) -> Option<{ name: String, fields: List<Ty> }> =
  match map_get(ts, name) {
    None -> None,
    Some(typed) -> {
      let best = fold(
        range(0, len(typed.decl.variants)),
        None,
        |acc: Option<{ depth: Int, name: String, fields: List<Ty> }>, i: Int|
          match ((list_at(typed.decl.variants, i), list_at(typed.depths, i))) {
            (Some(v), Some(Some(d))) -> {
              let fields = fields_of(v.fields, args);
              if !fold(fields, true, |ok: Bool, f: Ty| ok && generatable(f, ts) == Ok(())) { acc }
              else {
                match acc {
                  Some(b) -> if d < b.depth { Some({ depth: d, name: v.name, fields: fields }) }
                  else { acc },
                  None -> Some({ depth: d, name: v.name, fields: fields }),
                }
              }
            },
            _ -> acc,
          },
      );
      match best { Some(b) -> Some({ name: b.name, fields: b.fields }), None -> None }
    },
  }

// --- Candidates ---------------------------------------------------------------

// Candidates for one value of type `t`, in the order two runs must agree on.
pub fn candidates(v: Value, t: Ty, ts: Types) -> List<Value> = candidates_at(v, t, ts, 0)

fn candidates_at(v: Value, t: Ty, ts: Types, depth: Int) -> List<Value> =
  if depth >= hard_depth() { [] } else {
    match v {
      VInt(n) -> map(int_candidates(n), |c: Int| VInt(c)),
      VFixed(ty, bits) -> map(fixed_candidates(ty, bits), |c: U128| VFixed(ty, c)),
      VFloat(f) -> map(float_candidates(f), |c: Float| VFloat(c)),
      VDecimal(d) -> map(decimal_candidates(d), |c: Decimal| VDecimal(c)),
      VBool(b) -> if b { [VBool(false)] } else { [] },
      VChar(c) -> char_candidates(c),
      VStr(s) -> string_candidates(s),
      VBytes(b) -> bytes_candidates(b),
      VList(items) -> list_candidates(items, list_elem(t), ts, depth, |xs: List<Value>| VList(xs)),
      VArray(items) ->
        list_candidates(items, list_elem(t), ts, depth, |xs: List<Value>| VArray(xs)),
      VMap(entries) -> {
        let kv = map_types(t);
        map_candidates(entries, kv.key, kv.value, ts, depth)
      },
      VRecord(fields) -> match t {
        Record(field_tys) ->
          fold(range(0, len(fields)), [], |out: List<Value>, i: Int|
            match list_at(fields, i) {
              None -> out,
              Some(f) -> match field_ty(field_tys, f.name) {
                None -> out,
                Some(ft) ->
                  fold(
                    candidates_at(f.value, ft, ts, depth + 1),
                    out,
                    |acc: List<Value>, c: Value|
                      push(acc, VRecord(list_set(fields, i, { name: f.name, value: c }))),
                  ),
              },
            }),
        _ -> [],
      },
      VCtor(name, args) -> match t {
        Con(ty_name, ty_args) -> ctor_candidates(name, args, ty_name, ty_args, t, ts, depth),
        _ -> [],
      },
      // The constant function is the floor, so the size test ends the walk on the next pass.
      VFn(_) -> match t {
        Fn(params, ret, _) -> match minimal(ret, ts) {
          Ok(m) -> [VFn(FConst({ arity: len(params), value: m }))],
          Err(_) -> [],
        },
        _ -> [],
      },
      _ -> [],
    }
  }

fn int_ty() -> Ty = Con("Int", [])

fn list_elem(t: Ty) -> Ty =
  match t {
    Con(name, args) -> if name == "List" || name == "Array" {
      match list_at(args, 0) { Some(a) -> a, None -> int_ty() }
    } else { int_ty() },
    _ -> int_ty(),
  }

fn map_types(t: Ty) -> { key: Ty, value: Ty } =
  match t {
    Con(name, args) -> if name == "Map" && len(args) == 2 {
      {
        key: match list_at(args, 0) { Some(a) -> a, None -> int_ty() },
        value: match list_at(args, 1) { Some(a) -> a, None -> int_ty() },
      }
    } else { { key: int_ty(), value: int_ty() } },
    _ -> { key: int_ty(), value: int_ty() },
  }

fn field_ty(fields: List<{ name: String, ty: Ty }>, name: String) -> Option<Ty> =
  fold(fields, None, |found: Option<Ty>, f: { name: String, ty: Ty }|
    match found { Some(_) -> found, None -> if f.name == name { Some(f.ty) } else { None } })

// Consecutive repeats removed, as `Vec::dedup` does.
fn deduped<a>(xs: List<a>) -> List<a> =
  fold(xs, [], |acc: List<a>, x: a|
    match list_at(acc, len(acc) - 1) {
      Some(last) -> if last == x { acc } else { push(acc, x) },
      None -> push(acc, x),
    })

fn int_candidates(n: Int) -> List<Int> =
  if n == 0 { [] } else {
    let halves = iterate({ out: [0], half: n / 2 }, 64, |s: { out: List<Int>, half: Int }|
      if s.half == 0 { Stop(s.out) }
      else { Continue({ out: push(s.out, s.half), half: s.half / 2 }) });
    let stepped = match checked_sub(n, if n > 0 { 1 } else { 0 - 1 }) {
      Some(step) -> push(halves, step),
      None -> halves,
    };
    let flipped = if n < 0 { match checked_neg(n) { Some(p) -> push(stepped, p), None -> stepped } }
    else { stepped };
    deduped(filter(flipped, |c: Int| c != n))
  }

// `int_candidates` in the width's own arithmetic, so each candidate is a value of the type: toward
// zero by halves, then by one, then by its sign where the width has the magnitude.
fn fixed_candidates(ty: String, bits: U128) -> List<U128> = {
  let v = signed_of(ty, bits);
  if v.magnitude == 0u128 { [] } else {
    let w = width_of(ty);
    let halves = iterate(
      { out: [0u128], half: v.magnitude / 2u128 },
      130,
      |st: { out: List<U128>, half: U128 }|
        if st.half == 0u128 { Stop(st.out) } else {
          Continue({
            out: push(st.out, pattern_of(ty, { negative: v.negative, magnitude: st.half })),
            half: st.half / 2u128,
          })
        },
    );
    let stepped = push(
      halves,
      pattern_of(ty, { negative: v.negative, magnitude: v.magnitude - 1u128 }),
    );
    // `-min` is no value of a signed width: the least one offers no magnitude.
    let flipped = if v.negative && v.magnitude <= (1u128 << w - 1) - 1u128 {
      push(stepped, v.magnitude)
    } else { stepped };
    let pattern = pattern_of(ty, v);
    deduped(filter(flipped, |c: U128| c != pattern))
  }
}

fn float_candidates(f: Float) -> List<Float> =
  if f == 0.0 && !is_sign_negative(f) { [] }
  else if !is_finite(f) { [0.0] } else {
    let truncated = trunc(f);
    let start = if truncated != f { [0.0, truncated] } else { [0.0] };
    let halves = iterate(
      { out: start, half: f / 2.0, left: 64 },
      66,
      |s: { out: List<Float>, half: Float, left: Int }|
        if s.left == 0 || s.half == 0.0 || !is_finite(s.half) { Stop(s.out) }
        else { Continue({ out: push(s.out, s.half), half: s.half / 2.0, left: s.left - 1 }) },
    );
    let flipped = if is_sign_negative(f) { push(halves, 0.0 - f) } else { halves };
    // `!=`, not an order: `-0.0 == 0.0`, and keeping it would cycle the walk.
    filter(flipped, |c: Float| c != f)
  }

fn decimal_candidates(d: Decimal) -> List<Decimal> =
  if d == 0m && scale(d) == 0 { [] } else {
    let normalized = normalize(d);
    let start = if scale(normalized) != scale(d) { [0m, normalized] } else { [0m] };
    let rounded = fold(range(0, scale(d)), start, |out: List<Decimal>, places: Int|
      push(out, decimal_round(d, places, Down)));
    let halves = iterate(
      { out: rounded, half: d, left: 96 },
      98,
      |s: { out: List<Decimal>, half: Decimal, left: Int }|
        if s.left == 0 { Stop(s.out) } else {
          // The exact half, rounded to even only where it has more digits than a decimal holds.
          let next = decimal_div(s.half, 2m, 28, HalfEven);
          if next != 0m && scale(next) <= scale(d) {
            Continue({ out: push(s.out, next), half: next, left: s.left - 1 })
          } else { Stop(s.out) }
        },
    );
    let flipped = if decimal::is_negative(d) { push(halves, 0m - d) } else { halves };
    let here = decimal_size(d);
    deduped(filter(flipped, |c: Decimal| decimal_size(c) < here))
  }

// Empty, then each half, then each byte dropped, then each byte lowered: a length the claim bounds
// is reached one byte at a time. Below three bytes the halves are the drops.
fn bytes_candidates(b: Bytes) -> List<Value> =
  if bytes_len(b) == 0 { [] } else {
    let n = bytes_len(b);
    let mid = n / 2;
    let start = if n >= 2 {
      [VBytes(b""), VBytes(bytes_slice(b, 0, mid)), VBytes(bytes_slice(b, mid, n))]
    } else { [VBytes(b"")] };
    let dropped = if n < 3 { start } else {
      fold(range(0, n), start, |out: List<Value>, i: Int|
        push(out, VBytes(bytes_concat(bytes_slice(b, 0, i), bytes_slice(b, i + 1, n)))))
    };
    fold(range(0, n), dropped, |out: List<Value>, i: Int| {
      let byte = bytes_at(b, i);
      fold([0, byte / 2], out, |acc: List<Value>, lowered: Int|
        if lowered == byte { acc } else {
          push(
            acc,
            VBytes(
              bytes_concat_all([
                bytes_slice(b, 0, i),
                byte_of_int(lowered),
                bytes_slice(b, i + 1, bytes_len(b)),
              ]),
            ),
          )
        })
    })
  }

// As `bytes_candidates`, a character at a time, lowered toward `a`.
// Toward `a`, as a string's characters are lowered: to it, then halfway.
fn char_candidates(c: Char) -> List<Value> = {
  let code = int_of_char(c);
  if code <= 97 { [] } else {
    fold([97, 97 + (code - 97) / 2], [], |acc: List<Value>, lowered: Int|
      if lowered == code { acc }
      else { match char_of_int(lowered) { Some(x) -> push(acc, VChar(x)), None -> acc } })
  }
}

fn string_candidates(s: String) -> List<Value> = {
  let chars = code_points(s);
  if len(chars) == 0 { [] } else {
    let text = |cs: List<Int>| match of_code_points(cs) { Some(t) -> t, None -> "" };
    let mid = len(chars) / 2;
    let start = if len(chars) >= 2 {
      [
        VStr(""),
        VStr(text(map(range(0, mid), |i: Int| at_int(chars, i)))),
        VStr(text(map(range(mid, len(chars)), |i: Int| at_int(chars, i)))),
      ]
    } else { [VStr("")] };
    let dropped = if len(chars) < 3 { start } else {
      fold(range(0, len(chars)), start, |out: List<Value>, i: Int|
        push(out, VStr(text(without(chars, i)))))
    };
    fold(range(0, len(chars)), dropped, |out: List<Value>, i: Int| {
      let code = at_int(chars, i);
      if code <= 97 { out } else {
        fold([97, 97 + (code - 97) / 2], out, |acc: List<Value>, lowered: Int|
          if lowered == code { acc } else {
            match of_code_points(list_set(chars, i, lowered)) {
              Some(t) -> push(acc, VStr(t)),
              None -> acc,
            }
          })
      }
    })
  }
}

fn at_int(xs: List<Int>, i: Int) -> Int = match list_at(xs, i) { Some(x) -> x, None -> 0 }

fn without<a>(xs: List<a>, at: Int) -> List<a> =
  fold(range(0, len(xs)), [], |out: List<a>, i: Int|
    if i == at { out } else { match list_at(xs, i) { Some(x) -> push(out, x), None -> out } })

fn slice<a>(xs: List<a>, from: Int, to: Int) -> List<a> =
  fold(range(from, to), [], |out: List<a>, i: Int|
    match list_at(xs, i) { Some(x) -> push(out, x), None -> out })

// A list's candidates, or an array's: `made` builds the one the items are.
fn list_candidates(
  items: List<Value>,
  elem: Ty,
  ts: Types,
  depth: Int,
  made: (List<Value>) -> Value,
) -> List<Value> =
  if len(items) == 0 { [] } else {
    let mid = len(items) / 2;
    let start = if len(items) >= 2 {
      [made([]), made(slice(items, 0, mid)), made(slice(items, mid, len(items)))]
    } else { [made([])] };
    let removed = fold(range(0, len(items)), start, |out: List<Value>, i: Int|
      push(out, made(without(items, i))));
    fold(range(0, len(items)), removed, |out: List<Value>, i: Int|
      match list_at(items, i) {
        None -> out,
        Some(item) ->
          fold(candidates_at(item, elem, ts, depth + 1), out, |acc: List<Value>, c: Value|
            push(acc, made(list_set(items, i, c)))),
      })
  }

fn map_candidates(entries: List<Entry>, key: Ty, val: Ty, ts: Types, depth: Int) -> List<Value> =
  if len(entries) == 0 { [] } else {
    let removed = fold(range(0, len(entries)), [VMap([])], |out: List<Value>, i: Int|
      push(out, map_of(without(entries, i))));
    let values = fold(range(0, len(entries)), removed, |out: List<Value>, i: Int|
      match list_at(entries, i) {
        None -> out,
        Some(e) ->
          fold(candidates_at(e.value, val, ts, depth + 1), out, |acc: List<Value>, c: Value|
            push(acc, map_of(list_set(entries, i, { key: e.key, value: c })))),
      });
    fold(range(0, len(entries)), values, |out: List<Value>, i: Int|
      match list_at(entries, i) {
        None -> out,
        Some(e) ->
          fold(candidates_at(e.key, key, ts, depth + 1), out, |acc: List<Value>, c: Value|
            push(acc, map_of(list_set(entries, i, { key: c, value: e.value })))),
      })
  }

fn ctor_candidates(
  name: String,
  args: List<Value>,
  ty_name: String,
  ty_args: List<Ty>,
  t: Ty,
  ts: Types,
  depth: Int,
) -> List<Value> =
  match map_get(ts, ty_name) {
    None -> [],
    Some(typed) -> {
      let at = fold(range(0, len(typed.decl.variants)), 0 - 1, |found: Int, i: Int|
        if found >= 0 { found } else {
          match list_at(typed.decl.variants, i) {
            Some(v) -> if v.name == name { i } else { found },
            None -> found,
          }
        });
      match list_at(typed.decl.variants, at) {
        None -> [],
        Some(variant) -> {
          let fields = fields_of(variant.fields, ty_args);
          if len(fields) != len(args) { [] } else {
            // A field of the value's own type is a smaller value of it.
            let own = fold(range(0, len(fields)), [], |out: List<Value>, i: Int|
              match ((list_at(fields, i), list_at(args, i))) {
                (Some(f), Some(a)) -> if f == t { push(out, a) } else { out },
                _ -> out,
              });
            // An earlier variant, built from this one's fields where their types match and the floor
            // elsewhere.
            let lower = fold(range(0, at), own, |out: List<Value>, j: Int|
              match list_at(typed.decl.variants, j) {
                None -> out,
                Some(v) -> {
                  let wanted = fields_of(v.fields, ty_args);
                  let filled = fold(
                    wanted,
                    Some({ used: map(fields, |_f: Ty| false), values: [] }),
                    |acc: Option<{ used: List<Bool>, values: List<Value> }>, want: Ty|
                      match acc {
                        None -> None,
                        Some(st) -> {
                          let found = fold(range(0, len(fields)), 0 - 1, |hit: Int, k: Int|
                            if hit >= 0 { hit } else {
                              match ((list_at(fields, k), list_at(st.used, k))) {
                                (Some(have), Some(false)) -> if have == want { k } else { hit },
                                _ -> hit,
                              }
                            });
                          if found >= 0 {
                            match list_at(args, found) {
                              Some(a) ->
                                Some({
                                  used: list_set(st.used, found, true),
                                  values: push(st.values, a),
                                }),
                              None -> None,
                            }
                          } else {
                            match minimal(want, ts) {
                              Ok(m) -> Some({ used: st.used, values: push(st.values, m) }),
                              Err(_) -> None,
                            }
                          }
                        },
                      },
                  );
                  match filled { Some(st) -> push(out, VCtor(v.name, st.values)), None -> out }
                },
              });
            fold(range(0, len(fields)), lower, |out: List<Value>, i: Int|
              match ((list_at(fields, i), list_at(args, i))) {
                (Some(f), Some(a)) ->
                  fold(candidates_at(a, f, ts, depth + 1), out, |acc: List<Value>, c: Value|
                    push(acc, VCtor(name, list_set(args, i, c)))),
                _ -> out,
              })
          }
        },
      }
    },
  }

// --- Tests --------------------------------------------------------------------

fn no_types() -> Types = map_new()

fn first_n<a>(xs: List<a>, n: Int) -> List<a> = slice(xs, 0, min(n, len(xs)))

fn ints(xs: List<Int>) -> List<Value> = map(xs, |x: Int| VInt(x))

test "an integer shrinks toward zero by halves, then by one, then by its sign" {
  assert_eq(int_candidates(10), [0, 5, 2, 1, 9]);
  assert_eq(int_candidates(0 - 6), [0, 0 - 3, 0 - 1, 0 - 5, 6]);
  assert_eq(int_candidates(0), [])
}

test "greedy descent takes the first smaller candidate that still holds, and starts again" {
  let d = descend(
    ints([10]),
    [int_ty()],
    no_types(),
    |vs: List<Value>| match vs { [VInt(n)] -> n >= 3, _ -> false },
    64,
  );
  assert_eq(d.values, ints([3]));
  assert(d.steps > 0)
}

test "a budget of re-runs is what stops the walk" {
  let d = descend(ints([1000]), [int_ty()], no_types(), |_vs: List<Value>| true, 1);
  assert_eq(d.evaluations, 1);
  assert_eq(d.values, ints([0]))
}

test "a list shrinks by halves and by dropping an item before its items shrink" {
  let cs = candidates(VList(ints([4, 2])), Con("List", [int_ty()]), no_types());
  assert_eq(cs, [
    VList([]),
    VList(ints([4])),
    VList(ints([2])),
    VList(ints([2])),
    VList(ints([4])),
    VList(ints([0, 2])),
    VList(ints([2, 2])),
    VList(ints([1, 2])),
    VList(ints([3, 2])),
    VList(ints([4, 0])),
    VList(ints([4, 1])),
  ])
}

test "an array shrinks as a list does and stays an array" {
  let cs = candidates(VArray(ints([4, 2])), Con("Array", [int_ty()]), no_types());
  assert_eq(take(cs, 3), [VArray([]), VArray(ints([4])), VArray(ints([2]))]);
  assert_eq(len(cs), 11);
  assert_eq(minimal(Con("Array", [int_ty()]), no_types()), Ok(VArray([])))
}

fn take(xs: List<Value>, n: Int) -> List<Value> = slice(xs, 0, min(n, len(xs)))

fn fixed(ty: String, n: Int) -> Value =
  VFixed(ty, if n >= 0 { u128_of_int(n) }
  else { pattern_of(ty, { negative: true, magnitude: u128_of_int(0 - n) }) })

test "a width shrinks toward zero and stays a value of its type" {
  let offered = |v: Value, t: String| candidates(v, Con(t, []), no_types());
  assert_eq(offered(fixed("U8", 9), "U8"), map([0, 4, 2, 1, 8], |n: Int| fixed("U8", n)));
  // `128` is no `I8`, so the least byte offers no magnitude.
  assert_eq(
    offered(fixed("I8", 0 - 128), "I8"),
    map([0, 0 - 64, 0 - 32, 0 - 16, 0 - 8, 0 - 4, 0 - 2, 0 - 1, 0 - 127], |n: Int| fixed("I8", n)),
  );
  assert_eq(offered(fixed("U32", 0), "U32"), []);
  // Past what an `Int` holds, the measure still orders the walk toward zero.
  let full = VFixed("U64", 18446744073709551615u128);
  let halves = offered(full, "U64");
  assert_eq(list_at(halves, 0), Some(fixed("U64", 0)));
  assert_eq(list_at(halves, 1), Some(VFixed("U64", 9223372036854775807u128)));
  assert(size(full, no_types()) > size(VFixed("U64", 9223372036854775807u128), no_types()));
  assert(size(fixed("I8", 0 - 5), no_types()) > size(fixed("I8", 5), no_types()))
}

fn shaped_types() -> Types =
  gen::types_of([
    {
      name: "m.Shape",
      params: 0,
      variants: [{ name: "m.Empty", fields: [] }, { name: "m.Circle", fields: [Con("Int", [])] }],
    },
    {
      name: "m.Tree",
      params: 0,
      variants: [
        { name: "m.Node", fields: [Con("m.Tree", []), Con("m.Tree", [])] },
        { name: "m.Leaf", fields: [] },
      ],
    },
  ])

test "a negative outweighs its own magnitude, and an empty collection a populated one" {
  assert(size(VInt(0 - 5), no_types()) > size(VInt(5), no_types()));
  assert(
    size(VInt(0 - 9223372036854775807 - 1), no_types())
      > size(VInt(9223372036854775807), no_types()),
  );
  assert(size(VList([]), no_types()) < size(VList([VInt(0)]), no_types()));
  assert(size(VMap([]), no_types()) < size(VMap([{ key: VInt(0), value: VInt(0) }]), no_types()))
}

test "a lower constructor is smaller, and each type's floor is its smallest value" {
  let ts = shaped_types();
  assert(size(VCtor("m.Empty", []), ts) < size(VCtor("m.Circle", [VInt(0)]), ts));
  assert_eq(minimal(Con("Int", []), ts), Ok(VInt(0)));
  assert_eq(minimal(Con("String", []), ts), Ok(VStr("")));
  assert_eq(minimal(Con("Float", []), ts), Ok(VFloat(0.0)));
  assert_eq(
    minimal(Record([{ name: "b", ty: Con("Bool", []) }, { name: "a", ty: Con("Unit", []) }]), ts),
    Ok(VRecord([{ name: "a", value: VUnit }, { name: "b", value: VBool(false) }])),
  );
  assert_eq(minimal(Con("m.Shape", []), ts), Ok(VCtor("m.Empty", [])));
  // The shallowest variant, though it is declared second.
  assert_eq(minimal(Con("m.Tree", []), ts), Ok(VCtor("m.Leaf", [])))
}

test "every numeric candidate is strictly smaller, and a decimal sheds its scale" {
  // The floor, then the whole part, then sixty-four halvings.
  let floats = float_candidates(2.5);
  assert_eq(first_n(floats, 3), [0.0, 2.0, 1.25]);
  assert_eq(len(floats), 66);
  assert(
    fold(decimal_candidates(12.50m), true, |ok: Bool, c: Decimal|
      ok && decimal_size(c) < decimal_size(12.50m)),
  );
  assert_eq(list_at(decimal_candidates(12.50m), 0), Some(0m));
  assert_eq(list_at(decimal_candidates(12.50m), 1), Some(12.5m))
}

test "a value its type does not describe offers nothing" {
  assert_eq(candidates(VBool(true), Con("Bool", []), no_types()), [VBool(false)]);
  assert_eq(candidates(VUnit, Con("Unit", []), no_types()), []);
  assert_eq(candidates(VCtor("m.Gone", [VInt(3)]), Con("m.Gone", []), no_types()), [])
}

test "bytes and text drop one element at a time, so a bounded length is reached exactly" {
  let bounded = |vs: List<Value>|
    match vs {
      [VBytes(b)] -> bytes_len(b) >= 3,
      [VStr(s)] -> len(code_points(s)) >= 3,
      _ -> false,
    };
  assert_eq(
    descend([VBytes(b"T\x9cF\xf1")], [Con("Bytes", [])], no_types(), bounded, 500).values,
    [VBytes(b"\x00\x00\x00")],
  );
  assert_eq(descend([VStr("dede")], [Con("String", [])], no_types(), bounded, 500).values, [
    VStr("aaa"),
  ]);
  assert_eq(first_n(bytes_candidates(b"abc"), 6), [
    VBytes(b""),
    VBytes(b"a"),
    VBytes(b"bc"),
    VBytes(b"bc"),
    VBytes(b"ac"),
    VBytes(b"ab"),
  ])
}

test "a record of the largest integers still shrinks: the measure never saturates" {
  let point = Record([
    { name: "label", ty: Con("String", []) },
    { name: "x", ty: int_ty() },
    { name: "y", ty: int_ty() },
  ]);
  let far = |vs: List<Value>|
    match vs {
      [VRecord(fs)] ->
        fold(fs, false, |hit: Bool, f: Field|
          hit || (f.name == "x" && (match f.value { VInt(n) -> n >= 100, _ -> false }))),
      _ -> false,
    };
  let largest = VRecord([
    { name: "label", value: VStr("m") },
    { name: "x", value: VInt(9223372036854775807) },
    { name: "y", value: VInt(9223372036854775807) },
  ]);
  assert_eq(descend([largest], [point], no_types(), far, 500).values, [
    VRecord([
      { name: "label", value: VStr("") },
      { name: "x", value: VInt(100) },
      { name: "y", value: VInt(0) },
    ]),
  ]);
  let wide = |m: U128| size(VFixed("U128", m), no_types());
  assert(wide(~0u128) > wide(~0u128 >> 1));
  assert(wide(~0u128) < 1u128 << 121)
}

test "a decimal halves exactly at its own scale, and to even past the digits a decimal holds" {
  let halves = |d: Decimal| filter(decimal_candidates(d), |c: Decimal| c != 0m);
  assert_eq(
    list_at(halves(79228162514264337593543950335m), 0),
    Some(39614081257132168796771975168m),
  );
  assert_eq(halves(12m), [6m, 3m]);
  assert_eq(halves(5m), [])
}
