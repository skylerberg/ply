// `shrink` — counterexample minimisation as pure logic over a re-run the caller owns.
//
// The runtime owns what a value *is*: which candidates a value has, how big each of them is, and
// what happens when one replaces it. What is decided here is the walk. Greedy descent: the first
// candidate smaller than the value it replaces is accepted, and the whole walk starts again, so the
// result is minimal in the sense that no single value can be made smaller without losing the
// property. The number of re-runs is the budget a caller set, counted, not timed.
//
// This is why a counterexample is a *witness* rather than a dump: a value that is small enough to
// read is the difference between a report someone acts on and one they scroll past.

// What the walk came to: how many candidates were kept, and how many were tried.
pub type Descent = { steps: Int, evaluations: Int }

// One candidate at one value, as the runtime offers it: the position to hand back, and how big the
// candidate is. The size is the runtime's measure, because only it knows what a value contains.
pub type Alt = { position: Int, size: Int }

// What the walk asks the runtime, and what it answers. One conversation rather than a callback per
// operation, because a row is one row: a function cannot take several closures that each perform
// different operations, and the walk needs to read a value, try a candidate and take one.
pub type Ask = | Offer(Int) | Would(Int, Int) | Take(Int, Int)

pub type Reply = | Offered(Option<Offer>) | Tries(Bool) | Taken(Unit)

// One value of a counterexample: how big it is now, and its candidates with theirs.
pub type Offer = { here: Int, candidates: List<Alt> }

// The walk. `width` is how many values the counterexample has, and `ask` is the conversation with
// whichever side holds them.
//
// The values are the runtime's: a counterexample is a tuple of values of types this program never
// named. What is decided here is the order and the stopping rule — greedy descent, where the first
// candidate smaller than the value it replaces is taken and the walk starts again — and the budget,
// counted in re-runs rather than seconds.
pub fn descend<a | e>(width: Int, ask: (Ask) -> Reply / e, budget: Int) -> Descent / e =
  walk(width, ask, budget, 0, 0)

// One pass from `i` on: the first candidate that is smaller *and* still holds is taken, and the
// caller starts again from the first value. `stopped` is the budget running out mid-pass, which ends
// the whole walk rather than the pass — the caller asked for that many re-runs and no more.
fn pass_over<a | e>(
  width: Int,
  ask: (Ask) -> Reply / e,
  budget: Int,
  i: Int,
  evaluations: Int,
) -> { hit: Bool, stopped: Bool, evaluations: Int } / e =
  if i >= width { { hit: false, stopped: false, evaluations: evaluations } } else {
    match ask(Offer(i)) {
      Offered(None) -> { hit: false, stopped: false, evaluations: evaluations },
      Offered(Some(offer)) -> {
        let tried = try_alts(offer, i, ask, budget, evaluations);
        if tried.stopped { { hit: false, stopped: true, evaluations: tried.evaluations } }
        else if tried.hit { { hit: true, stopped: false, evaluations: tried.evaluations } }
        else { pass_over(width, ask, budget, i + 1, tried.evaluations) }
      },
      // A conversation that answers the wrong thing is the runtime's bug, not a smaller candidate.
      _ -> { hit: false, stopped: true, evaluations: evaluations },
    }
  }

// The candidates at one value, in order. A candidate no smaller than the value is skipped without
// being counted — nothing was re-run for it — and the budget is checked only for one that would be.
fn try_alts<a | e>(
  offer: Offer,
  i: Int,
  ask: (Ask) -> Reply / e,
  budget: Int,
  evaluations: Int,
) -> { hit: Bool, stopped: Bool, evaluations: Int } / e =
  match offer.candidates {
    [] -> { hit: false, stopped: false, evaluations: evaluations },
    [alt, ..rest] -> if alt.size >= offer.here {
      try_alts({ ..offer, candidates: rest }, i, ask, budget, evaluations)
    } else if evaluations >= budget { { hit: false, stopped: true, evaluations: evaluations } } else {
      match ask(Would(i, alt.position)) {
        Tries(true) -> {
          ask(Take(i, alt.position));
          { hit: true, stopped: false, evaluations: evaluations + 1 }
        },
        _ -> try_alts({ ..offer, candidates: rest }, i, ask, budget, evaluations + 1),
      }
    },
  }

fn walk<a | e>(
  width: Int,
  ask: (Ask) -> Reply / e,
  budget: Int,
  steps: Int,
  evaluations: Int,
) -> Descent / e = {
  let pass = pass_over(width, ask, budget, 0, evaluations);
  if pass.stopped {
    // The budget ran out mid-pass: the walk stops where it is rather than claiming minimality.
    { steps: steps, evaluations: pass.evaluations }
  } else if pass.hit { walk(width, ask, budget, steps + 1, pass.evaluations) }
  else { { steps: steps, evaluations: pass.evaluations } }
}

// A scripted conversation with a counterexample of one value. The runtime holds the values and
// updates them when a candidate is taken; here the answer is fixed, because what these tests are
// about is what the walk *asks* and in what order, not what a value becomes.
fn asked(size: Int, offers: List<Alt>, held: Bool) -> (Ask) -> Reply =
  |q: Ask|
    match q {
      Offer(_i) -> Offered(Some({ here: size, candidates: offers })),
      Would(_i, _position) -> Tries(held),
      Take(_i, _position) -> Taken(()),
    }

test "greedy descent takes the first smaller candidate, not the smallest" {
  // One re-run allowed, so the walk stops after its first acceptance — and the count is how many
  // candidates it had to try to find one. Three would mean it looked past the first.
  let out = descend(
    1,
    asked(9, [{ position: 5, size: 5 }, { position: 3, size: 3 }, { position: 2, size: 2 }], true),
    1,
  );
  assert_eq(out.steps, 1);
  assert_eq(out.evaluations, 1)
}

test "a candidate that loses the property is not taken, and the next one is tried" {
  let out = descend(1, asked(9, [{ position: 3, size: 3 }, { position: 7, size: 7 }], false), 64);
  assert_eq(out.steps, 0);
  assert_eq(out.evaluations, 2)
}

test "a budget of re-runs is what stops the walk" {
  let out = descend(
    1,
    asked(9, [{ position: 5, size: 5 }, { position: 3, size: 3 }, { position: 2, size: 2 }], true),
    2,
  );
  // Two re-runs, and the third — which would still be within the walk's reach — is what the budget
  // refuses.
  assert_eq(out.steps, 2);
  assert_eq(out.evaluations, 2)
}

test "a candidate no smaller than the value is never tried" {
  let out = descend(
    1,
    asked(9, [{ position: 10, size: 10 }, { position: 11, size: 11 }], true),
    64,
  );
  // Nothing was re-run, so nothing was spent: the budget is counted, not timed.
  assert_eq(out.evaluations, 0)
}

test "a width of no values is a walk with nothing to do" {
  let out = descend(0, asked(0, [], true), 8);
  assert_eq(out.steps, 0);
  assert_eq(out.evaluations, 0)
}
