// `induct` — induction over an `Int` or `List` binder, for a claim about self-recursive definitions.
//
// Each recursive definition the claim reaches is first shown to terminate: some `Int` parameter is
// non-negative and strictly smaller at every self call (or some list parameter is a tail of the one
// it was entered with), under the conditions on the way to it. Such a definition is total, so its
// calls are values and its body may be unrolled with `f(x̄) == body(x̄)` in hand. The claim is then
// proved at the base case, and at the step from its own instance one down, whose recursive calls are
// left as they are so the unrolled conclusion meets them by congruence.

import compiler.code (Code)
import context (Context, signature, self_recursive)
import domain (Ty, Fn)
import goal (Goal, Binder, Limits, Proof, Assertion, Ran, run, conjunction, domain_inhabited,
             uninterpreted_sorts, int_ranges, ranges_of, set_of, with_true, appended)
import lower (Lowering, L, Blocker, RecursiveCall, Induction, lowering, bind_symbolic, lower_root,
              assume, drop_assumptions, smaller_than, requirements_since, requirements_between)
import rules (RuleLog, Rule, no_rules, rules_of, induction_rule)
import solve (Closed)
import sort (bool_ty, is_con, list_elem)
import term (Terms, TApp, Le, Gt, node, int_lit, sub, nil, cons, sym, not, and, or, cmp, eq)

type Attempted = { proof: Option<Proof>, blockers: List<Blocker> }

fn declined(blockers: List<Blocker>, why: String) -> List<Blocker> = push(blockers, Induction(why))

pub fn attempt(
  cx: Context,
  g: Goal,
  limits: Limits,
  budget: Int,
  spent: Int,
  blockers: List<Blocker>,
) -> Attempted / {abort.raise} = {
  let named = fold(blockers, map_new(), |m: Map<String, Bool>, b: Blocker|
    match b { RecursiveCall(n) -> map_insert(m, n, true), _ -> m });
  let recursive = map_keys(named);
  if len(recursive) == 0 { { proof: None, blockers: blockers } } else {
    let checked = fold(
      recursive,
      { ok: true, budget: budget, spent: spent, blockers: blockers },
      |st: { ok: Bool, budget: Int, spent: Int, blockers: List<Blocker> }, name: String|
        if !st.ok { st } else {
          match terminating(cx, name, limits, st.budget) {
            None ->
              {
                ..st,
                ok: false,
                blockers: declined(
                  st.blockers,
                  "`" ++ name ++ "` is not a pure definition calling only itself",
                ),
              },
            Some(t) -> {
              let after = { ..st, spent: st.spent + t.used, budget: st.budget - t.used };
              if t.terminates { after } else {
                {
                  ..after,
                  ok: false,
                  blockers: declined(
                    after.blockers,
                    "no `Int` argument of `" ++ name
                      ++ "` is non-negative and smaller at every self call",
                  ),
                }
              }
            },
          }
        },
    );
    if !checked.ok { { proof: None, blockers: checked.blockers } } else {
      let result_slot = match g.result { Some(_) -> len(g.binders) - 1, None -> 0 - 1 };
      let walked = fold(
        range(0, len(g.binders)),
        {
          done: false,
          proof: None,
          budget: checked.budget,
          spent: checked.spent,
          blockers: checked.blockers,
        },
        |st: { done: Bool, proof: Option<Proof>, budget: Int, spent: Int, blockers: List<Blocker> }, slot: Int|
          if st.done { st } else {
            match list_at(g.binders, slot) {
              None -> st,
              Some(binder) -> {
                let over_list = list_elem(binder.ty) != None;
                if !(is_con(binder.ty, "Int") || over_list) || slot == result_slot { st } else {
                  let r = if over_list {
                    induct_list(cx, g, limits, st.budget, map_keys(named), slot, st.blockers)
                  } else {
                    induct_on(cx, g, limits, st.budget, map_keys(named), slot, st.blockers)
                  };
                  let spent = st.spent + r.used;
                  let left = st.budget - r.used;
                  match r.proof {
                    Some(p) -> {
                      let rules = fold(recursive, p.rules, |acc: List<Rule>, def: String|
                        push(acc, induction_rule(binder.name, def)));
                      {
                        done: true,
                        proof: Some({ ..p, steps: spent, rules: rules }),
                        budget: left,
                        spent: spent,
                        blockers: r.blockers,
                      }
                    },
                    None ->
                      {
                        done: left == 0,
                        proof: None,
                        budget: left,
                        spent: spent,
                        blockers: r.blockers,
                      },
                  }
                }
              },
            }
          },
      );
      { proof: walked.proof, blockers: walked.blockers }
    }
  }
}

// Whether `name` terminates by some `Int` or list parameter decreasing at every self call, and the
// budget it took to decide; `None` when the definition is not one induction unrolls.
fn terminating(
  cx: Context,
  name: String,
  limits: Limits,
  budget: Int,
) -> Option<{ terminates: Bool, used: Int }> / {abort.raise} =
  match self_recursive(cx, name) {
    None -> None,
    Some(def) -> match signature(cx, name) {
      None -> None,
      Some(s) -> match s.ty {
        Fn(params, _, _) -> if len(params) != def.params { None } else {
          Some(
            without_done(
              fold(
                range(0, len(params)),
                { terminates: false, used: 0, done: false },
                |st: { terminates: Bool, used: Int, done: Bool }, slot: Int|
                  if st.done { st } else {
                    match list_at(params, slot) {
                      None -> st,
                      Some(ty) -> if !(is_con(ty, "Int") || list_elem(ty) != None)
                          || budget <= st.used { st } else {
                        let bound = fold(
                          params,
                          { lw: lowering(no_rules(), limits.unfold_depth), ids: [] },
                          |acc: { lw: Lowering, ids: List<Int> }, p: Ty| {
                            let r = bind_symbolic(acc.lw, p, cx);
                            { lw: r.lw, ids: push(acc.ids, r.id) }
                          },
                        );
                        let measured = {
                          ..bound.lw,
                          measure: Some({
                            def: name,
                            slot: slot,
                            bound: match list_at(bound.ids, slot) { Some(t) -> t, None -> 0 },
                          }),
                        };
                        let body = lower_root(measured, cx, def.body, bound.ids);
                        // Only the measure: whether the body raises is judged where it is unrolled.
                        if body.lw.float || len(body.lw.measures) == 0 {
                          { terminates: false, used: st.used, done: true }
                        } else {
                          let all = conjunction(body.lw.ts, body.lw.measures);
                          match all.id {
                            None -> st,
                            Some(a) -> {
                              let ranges = int_ranges(all.ts, None, map_new());
                              let r = run(
                                ranges.ts,
                                cx,
                                body.lw.rules,
                                budget - st.used,
                                limits,
                                push(ranges.out, { term: a, polarity: false }),
                              );
                              let used = st.used + (budget - st.used - r.left);
                              if r.answer == Closed { { terminates: true, used: used, done: true } }
                              else { { terminates: false, used: used, done: false } }
                            },
                          }
                        }
                      },
                    }
                  },
              ),
            ),
          )
        },
        _ -> None,
      },
    },
  }

fn without_done(
  st: { terminates: Bool, used: Int, done: Bool },
) -> { terminates: Bool, used: Int } = { terminates: st.terminates, used: st.used }

type Inducted = { proof: Option<Proof>, used: Int, blockers: List<Blocker> }

// A refutation on the shared budget; `closed` when the assertions contradict each other.
type Settled = { ts: Terms, rules: RuleLog, budget: Int, spent: Int, closed: Bool }

fn settle(
  ts: Terms,
  cx: Context,
  rules: RuleLog,
  limits: Limits,
  budget: Int,
  spent: Int,
  assertions: List<Assertion>,
) -> Settled / {abort.raise} = {
  let r = run(ts, cx, rules, budget, limits, assertions);
  {
    ts: r.ts,
    rules: r.rules,
    budget: r.left,
    spent: spent + (budget - r.left),
    closed: r.answer == Closed,
  }
}

fn ran_out(budget: Int) -> String = if budget == 0 { ", the budget spent" } else { "" }

fn bound_all(
  lw: Lowering,
  cx: Context,
  binders: List<Binder>,
) -> { lw: Lowering, ids: List<Int> } / {abort.raise} =
  fold(binders, { lw: lw, ids: [] }, |acc: { lw: Lowering, ids: List<Int> }, b: Binder| {
    let r = bind_symbolic(acc.lw, b.ty, cx);
    { lw: r.lw, ids: push(acc.ids, r.id) }
  })

fn take<a>(xs: List<a>, n: Int) -> List<a> =
  fold(range(0, n), [], |acc: List<a>, i: Int|
    match list_at(xs, i) { Some(x) -> push(acc, x), None -> acc })

fn drop_front<a>(xs: List<a>, n: Int) -> List<a> =
  fold(range(n, len(xs)), [], |acc: List<a>, i: Int|
    match list_at(xs, i) { Some(x) -> push(acc, x), None -> acc })

fn contains(xs: List<Int>, x: Int) -> Bool = fold(xs, false, |f: Bool, y: Int| f || y == x)

// `And(body, needs)` when anything is owed.
fn owing(ts: Terms, body: Int, needs: List<Int>) -> { ts: Terms, id: Int } / {abort.raise} = {
  let c = conjunction(ts, needs);
  match c.id {
    Some(n) -> {
      let m = and(c.ts, body, n);
      { ts: m.ts, id: m.id }
    },
    None -> { ts: c.ts, id: body },
  }
}

// `Or(!guard, held)` when there is a guard.
fn guarded(ts: Terms, guards: List<Int>, held: Int) -> { ts: Terms, id: Int } / {abort.raise} = {
  let c = conjunction(ts, guards);
  match c.id {
    Some(gd) -> {
      let unguarded = not(c.ts, gd);
      let m = or(unguarded.ts, unguarded.id, held);
      { ts: m.ts, id: m.id }
    },
    None -> { ts: c.ts, id: held },
  }
}

fn guard_satisfiable(
  ts: Terms,
  cx: Context,
  limits: Limits,
  budget: Int,
  spent: Int,
  binders: List<Binder>,
  guards: List<Int>,
) -> { ok: Bool, spent: Int } / {abort.raise} =
  if !domain_inhabited(cx, binders) { { ok: false, spent: spent } } else {
    let c = conjunction(ts, guards);
    match c.id {
      None -> { ok: true, spent: spent },
      Some(all) -> {
        let s = settle(c.ts, cx, no_rules(), limits, budget, spent, [
          { term: all, polarity: false },
        ]);
        { ok: s.closed, spent: s.spent }
      },
    }
  }

// The claim at `n <= 0`, then at `n > 0` from its instance at `n - 1`.
fn induct_on(
  cx: Context,
  g: Goal,
  limits: Limits,
  budget: Int,
  recursive: List<String>,
  slot: Int,
  blockers: List<Blocker>,
) -> Inducted / {abort.raise} = {
  let binder = match list_at(g.binders, slot) { Some(b) -> b.name, None -> "" };
  let no = |why: String, used: Int|
    { proof: None, used: used, blockers: declined(blockers, "on `" ++ binder ++ "`: " ++ why) };
  let recursive_set = fold(recursive, map_new(), |m: Map<String, Bool>, n: String|
    map_insert(m, n, true));
  let start = {
    ..lowering(no_rules(), limits.unfold_depth),
    total: recursive_set,
    unrolled: recursive_set,
  };
  let bound = bound_all(start, cx, g.binders);
  let guarded_lw = fold(
    g.guards,
    { lw: bound.lw, ids: [] },
    |acc: { lw: Lowering, ids: List<Int> }, guard: Option<Code>| {
      let r = lower_root(acc.lw, cx, guard, bound.ids);
      { lw: assume(r.lw, r.id), ids: push(acc.ids, r.id) }
    },
  );
  let guard_mark = len(guarded_lw.lw.requirements);
  let defined_result = match g.result {
    Some(result_body) -> if len(bound.ids) == 0 { { lw: guarded_lw.lw, def: None } } else {
      let r = lower_root(guarded_lw.lw, cx, result_body, take(bound.ids, len(bound.ids) - 1));
      {
        lw: r.lw,
        def: Some({
          symbol: match list_at(bound.ids, len(bound.ids) - 1) { Some(t) -> t, None -> 0 },
          value: r.id,
        }),
      }
    },
    None -> { lw: guarded_lw.lw, def: None },
  };
  let body = lower_root(defined_result.lw, cx, g.body, bound.ids);
  let body_mark = len(body.lw.requirements);
  let claim_calls = body.lw.calls;
  // The hypothesis: the same claim one step down, its recursive calls left unrolled.
  let down = { ..drop_assumptions(body.lw), unrolled: map_new() };
  let one = int_lit(down.ts, 1);
  match sub(one.ts, match list_at(bound.ids, slot) { Some(t) -> t, None -> 0 }, one.id) {
    None -> no("no term for the step down", 0),
    Some(previous) -> {
      let lw0 = { ..down, ts: previous.ts };
      let prior0 = list_set(bound.ids, slot, previous.id);
      let prior_guards = fold(
        g.guards,
        { lw: lw0, ids: [] },
        |acc: { lw: Lowering, ids: List<Int> }, guard: Option<Code>| {
          let r = lower_root(acc.lw, cx, guard, prior0);
          { lw: r.lw, ids: push(acc.ids, r.id) }
        },
      );
      let with_result = match g.result {
        Some(result_body) -> if len(prior0) == 0 { { lw: prior_guards.lw, prior: prior0 } } else {
          let r = lower_root(prior_guards.lw, cx, result_body, take(prior0, len(prior0) - 1));
          { lw: r.lw, prior: list_set(prior0, len(prior0) - 1, r.id) }
        },
        None -> { lw: prior_guards.lw, prior: prior0 },
      };
      let prior_body = lower_root(with_result.lw, cx, g.body, with_result.prior);
      let lw1 = prior_body.lw;
      let hypothesis_needs = requirements_since(lw1, body_mark);
      // The hypothesis makes values of the calls it reaches; a call it does not reach, and that no
      // equation defines, is one this induction cannot speak for.
      let covered = map_keys(set_of(drop_front(lw1.calls, len(claim_calls))));
      let defined = lw1.defined;
      if fold(claim_calls, false, |f: Bool, c: Int|
          f || (!contains(covered, c) && !contains(defined, c))) {
        no("a remaining call is not one the hypothesis reaches", 0)
      } else if lw1.float { no("a Float", 0) } else {
        let requirements = lw1.requirements;
        let equations = lw1.equations;
        let definition = match defined_result.def {
          Some(d) -> {
            let m = eq(lw1.ts, d.symbol, d.value);
            { ts: m.ts, eq: Some(m.id), symbol: Some(d.symbol) }
          },
          None -> { ts: lw1.ts, eq: None, symbol: None },
        };
        let in_question = set_of(appended(covered, defined));
        let ranges = int_ranges(definition.ts, definition.symbol, in_question);
        let guard_needs = take(requirements, guard_mark);
        let body_needs = take(drop_front(requirements, guard_mark), body_mark - guard_mark);
        let needed = conjunction(ranges.ts, guard_needs);
        let guard_check = match needed.id {
          None -> { ts: needed.ts, rules: lw1.rules, budget: budget, spent: 0, closed: true },
          Some(conjoined) ->
            settle(
              needed.ts,
              cx,
              lw1.rules,
              limits,
              budget,
              0,
              push(ranges.out, { term: conjoined, polarity: false }),
            ),
        };
        if !guard_check.closed { no("the guard can raise", guard_check.spent) } else {
          let claim = owing(guard_check.ts, body.id, body_needs);
          let held = owing(claim.ts, prior_body.id, hypothesis_needs);
          let hypothesis = guarded(held.ts, prior_guards.ids, held.id);
          let zero = int_lit(hypothesis.ts, 0);
          let n = match list_at(bound.ids, slot) { Some(t) -> t, None -> 0 };
          let base = cmp(zero.ts, Le, n, zero.id);
          let step = cmp(base.ts, Gt, n, zero.id);
          let common = appended(
            appended(appended(ranges.out, with_true(guarded_lw.ids)), with_true(equations)),
            match definition.eq { Some(d) -> [{ term: d, polarity: true }], None -> [] },
          );
          let base_case = settle(
            step.ts,
            cx,
            guard_check.rules,
            limits,
            guard_check.budget,
            guard_check.spent,
            appended(common, [
              { term: base.id, polarity: true },
              { term: claim.id, polarity: false },
            ]),
          );
          if !base_case.closed {
            no("the base case is open" ++ ran_out(base_case.budget), base_case.spent)
          } else {
            let covered_ranges = ranges_of(base_case.ts, covered);
            let step_case = settle(
              covered_ranges.ts,
              cx,
              base_case.rules,
              limits,
              base_case.budget,
              base_case.spent,
              push(
                appended(
                  appended(common, [
                    { term: step.id, polarity: true },
                    { term: hypothesis.id, polarity: true },
                  ]),
                  covered_ranges.out,
                ),
                { term: claim.id, polarity: false },
              ),
            );
            if !step_case.closed {
              no("the step is open" ++ ran_out(step_case.budget), step_case.spent)
            } else {
              let sat = guard_satisfiable(
                step_case.ts,
                cx,
                limits,
                step_case.budget,
                step_case.spent,
                g.binders,
                guarded_lw.ids,
              );
              {
                proof: Some({
                  rules: rules_of(step_case.rules),
                  steps: sat.spent,
                  sorts: uninterpreted_sorts(g.binders),
                  guard_satisfiable: sat.ok,
                }),
                used: sat.spent,
                blockers: blockers,
              }
            }
          }
        }
      }
    },
  }
}

// The claim lowered with the binder at `at`: its guards, what they owe, its body and what it owes.
type Instance = { guards: List<Int>, guard_needs: List<Int>, body: Int, needs: List<Int> }

fn instance(
  lw: Lowering,
  cx: Context,
  g: Goal,
  bound: List<Int>,
  slot: Int,
  at: Int,
) -> { lw: Lowering, inst: Instance } / {abort.raise} = {
  let placed = list_set(bound, slot, at);
  let start = drop_assumptions(lw);
  let before = len(start.requirements);
  let guards = fold(
    g.guards,
    { lw: start, ids: [] },
    |acc: { lw: Lowering, ids: List<Int> }, guard: Option<Code>| {
      let r = lower_root(acc.lw, cx, guard, placed);
      { lw: assume(r.lw, r.id), ids: push(acc.ids, r.id) }
    },
  );
  let guard_mark = len(guards.lw.requirements);
  let body = lower_root(guards.lw, cx, g.body, placed);
  let after = len(body.lw.requirements);
  {
    lw: body.lw,
    inst: {
      guards: guards.ids,
      guard_needs: requirements_between(body.lw, before, guard_mark),
      body: body.id,
      needs: requirements_between(body.lw, guard_mark, after),
    },
  }
}

// The claim at `[]`, then at `[h, ..t]` from its instance at `t`. Each instance is its own
// lowering, so `len` and the matches in reach reduce over the spine they are given.
fn induct_list(
  cx: Context,
  g: Goal,
  limits: Limits,
  budget: Int,
  recursive: List<String>,
  slot: Int,
  blockers: List<Blocker>,
) -> Inducted / {abort.raise} = {
  let binder = match list_at(g.binders, slot) { Some(b) -> b, None -> { name: "", ty: bool_ty() } };
  let no = |why: String, used: Int|
    {
      proof: None,
      used: used,
      blockers: declined(blockers, "on `" ++ binder.name ++ "`: " ++ why),
    };
  match g.result {
    Some(_) -> no("a clause with a `result` is not inducted over a list", 0),
    None -> {
      let recursive_set = fold(recursive, map_new(), |m: Map<String, Bool>, n: String|
        map_insert(m, n, true));
      let start = {
        ..lowering(no_rules(), limits.unfold_depth),
        total: recursive_set,
        unrolled: recursive_set,
      };
      let bound = bound_all(start, cx, g.binders);
      let sort = binder.ty;
      let elem = list_elem(sort);
      let empty = nil(bound.lw.ts, Some(sort));
      let head = sym(empty.ts, elem);
      let tail = sym(head.ts, Some(sort));
      let pair = cons(tail.ts, head.id, tail.id, Some(sort));
      let lw0 = { ..bound.lw, ts: pair.ts };
      let base = instance(lw0, cx, g, bound.ids, slot, empty.id);
      let step = instance(base.lw, cx, g, bound.ids, slot, pair.id);
      let claim_calls = step.lw.calls;
      // A remaining call over a tail the patterns took off the instance is one the hypothesis speaks for.
      let structural = filter(claim_calls, |c: Int|
        match node(step.lw.ts, c) {
          TApp(a) ->
            fold(a.args, false, |f: Bool, x: Int|
              f || smaller_than(step.lw, x, pair.id) || smaller_than(step.lw, x, empty.id)),
          _ -> false,
        });
      let hyp = instance({ ..step.lw, unrolled: map_new() }, cx, g, bound.ids, slot, tail.id);
      let lw1 = hyp.lw;
      let covered = map_keys(set_of(drop_front(lw1.calls, len(claim_calls))));
      let defined = lw1.defined;
      if fold(claim_calls, false, |f: Bool, c: Int|
          f || (!contains(covered, c) && !contains(defined, c) && !contains(structural, c))) {
        no("a remaining call is not one the hypothesis reaches", 0)
      } else if lw1.float { no("a Float", 0) } else {
        let equations = lw1.equations;
        let in_question = set_of(appended(appended(covered, defined), structural));
        let ranges = int_ranges(lw1.ts, None, in_question);
        let guards_checked = fold(
          [base.inst, step.inst],
          {
            st: { ts: ranges.ts, rules: lw1.rules, budget: budget, spent: 0, closed: true },
            failed: false,
          },
          |acc: { st: Settled, failed: Bool }, case: Instance|
            if acc.failed { acc } else {
              let c = conjunction(acc.st.ts, case.guard_needs);
              match c.id {
                None -> { st: { ..acc.st, ts: c.ts }, failed: false },
                Some(conjoined) -> {
                  let s = settle(
                    c.ts,
                    cx,
                    acc.st.rules,
                    limits,
                    acc.st.budget,
                    acc.st.spent,
                    push(ranges.out, { term: conjoined, polarity: false }),
                  );
                  { st: s, failed: !s.closed }
                },
              }
            },
        );
        if guards_checked.failed { no("the guard can raise", guards_checked.st.spent) } else {
          let gs = guards_checked.st;
          let base_claim = owing(gs.ts, base.inst.body, base.inst.needs);
          let step_claim = owing(base_claim.ts, step.inst.body, step.inst.needs);
          let held = owing(step_claim.ts, hyp.inst.body, hyp.inst.needs);
          let hypothesis = guarded(held.ts, hyp.inst.guards, held.id);
          let common = appended(ranges.out, with_true(equations));
          let base_case = settle(
            hypothesis.ts,
            cx,
            gs.rules,
            limits,
            gs.budget,
            gs.spent,
            push(appended(common, with_true(base.inst.guards)), {
              term: base_claim.id,
              polarity: false,
            }),
          );
          if !base_case.closed {
            no("the base case is open" ++ ran_out(base_case.budget), base_case.spent)
          } else {
            let covered_ranges = ranges_of(base_case.ts, covered);
            let step_case = settle(
              covered_ranges.ts,
              cx,
              base_case.rules,
              limits,
              base_case.budget,
              base_case.spent,
              push(
                appended(
                  push(appended(common, with_true(step.inst.guards)), {
                    term: hypothesis.id,
                    polarity: true,
                  }),
                  covered_ranges.out,
                ),
                { term: step_claim.id, polarity: false },
              ),
            );
            if !step_case.closed {
              no("the step is open" ++ ran_out(step_case.budget), step_case.spent)
            } else {
              let sat = guard_satisfiable(
                step_case.ts,
                cx,
                limits,
                step_case.budget,
                step_case.spent,
                g.binders,
                step.inst.guards,
              );
              {
                proof: Some({
                  rules: rules_of(step_case.rules),
                  steps: sat.spent,
                  sorts: uninterpreted_sorts(g.binders),
                  guard_satisfiable: sat.ok,
                }),
                used: sat.spent,
                blockers: blockers,
              }
            }
          }
        }
      }
    },
  }
}
