//! `induct` — the search for an induction over an `Int` or `List` binder, for a claim about
//! self-recursive definitions: each binder in turn, taken apart one step at a time, unrolling every
//! recursive definition the claim reaches. The kernel judges each proposal from the claim alone.

import context (Context, self_recursive, ends)
import goal (Goal, Limits, Proof)
import kernel (checked, declined)
import lower (Blocker, RecursiveCall)
import rules (Descent, Spine)
import sort (is_con, list_elem)

type Attempted = { proof: Option<Proof>, blockers: List<Blocker> }

pub fn attempt(
  context: Context,
  g: Goal,
  limits: Limits,
  budget: Int,
  spent: Int,
  blockers: List<Blocker>,
) -> Attempted / {abort.raise} = {
  let named = fold(blockers, map_new(), |m: Map<String, Bool>, b: Blocker|
    match b { RecursiveCall(n) -> map_insert(m, n, true), _ -> m });
  let recursive = map_keys(named);
  if len(recursive) == 0 { { proof: None, blockers: blockers } } else {
    let unrollable = fold(
      recursive,
      { ok: true, blockers: blockers },
      |st: { ok: Bool, blockers: List<Blocker> }, name: String|
        if !st.ok { st } else {
          match self_recursive(context, name) {
            None ->
              {
                ok: false,
                blockers: declined(
                  st.blockers,
                  "`" ++ name ++ "` is not a pure definition calling only itself",
                ),
              },
            Some(_) -> if ends(context, name) { st } else {
              {
                ok: false,
                blockers: declined(
                  st.blockers,
                  "the checker does not see every call `" ++ name ++ "` makes of itself descend",
                ),
              }
            },
          }
        },
    );
    if !unrollable.ok { { proof: None, blockers: unrollable.blockers } } else {
      let result_slot = match g.result { Some(_) -> len(g.binders) - 1, None -> 0 - 1 };
      let walked = fold(
        range(0, len(g.binders)),
        { done: false, proof: None, budget: budget, spent: spent, blockers: unrollable.blockers },
        |st: { done: Bool, proof: Option<Proof>, budget: Int, spent: Int, blockers: List<Blocker> }, slot: Int|
          if st.done { st } else {
            match list_at(g.binders, slot) {
              None -> st,
              Some(binder) -> {
                let over_list = list_elem(binder.ty) != None;
                if !(is_con(binder.ty, "Int") || over_list) || slot == result_slot { st } else {
                  let r = checked(
                    context,
                    g,
                    {
                      binder: binder.name,
                      slot: slot,
                      scheme: if over_list { Spine(1) } else { Descent(1) },
                      defs: recursive,
                    },
                    limits,
                    st.budget,
                    st.blockers,
                  );
                  let spent = st.spent + r.used;
                  let left = st.budget - r.used;
                  match r.proof {
                    Some(p) ->
                      {
                        done: true,
                        proof: Some({ ..p, steps: spent }),
                        budget: left,
                        spent: spent,
                        blockers: r.blockers,
                      },
                    None ->
                      {
                        done: left == 0,
                        proof: None,
                        budget: left,
                        spent: spent,
                        blockers: r.blockers,
                      },
                  }
                }
              },
            }
          },
      );
      { proof: walked.proof, blockers: walked.blockers }
    }
  }
}
