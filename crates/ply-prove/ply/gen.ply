//! `gen` — a value of every type, drawn from a claim's keyed stream. The case index sets how large a
//! value may grow, and the first few cases take each type's edge values, so the corners of a type
//! are tried before anything is sampled.

import std.decimal (of_parts)
import std.decimal
import std.float (nan, infinity, neg_infinity, pow2)
import std.float
import std.random (Rand, rand_u64)
import std.random
import std.value (Value, VUnit, VBool, VInt, VFloat, VDecimal, VFixed, VChar, VStr, VBytes, VList,
                  VArray, VRecord, VCtor, VFn, Field, Entry, FConst, FProject, FTable, map_of,
                  width_of)
import std.list (at)
import std.bytes (u64_le)
import domain (Ty, Var, Fn, Record, Con, Decl, Variant, name_order)
import drawn (Draw, Fresh, carried, draw_of)

/// Why a type has no value to draw.
pub type Ungeneratable =
  | UCell
  | UTask
  | UChan
  | USecret
  /// Its row is not empty, so applying it would make a claim impure.
  | UEffectful
  | UUninhabited(String)
  | UUnknown(String)
  | UTooDeep
  /// A function of more parameters than a generated one's `U8` arity counts.
  | UWide

/// The declared types, each with how many nested constructor applications a value of it needs, and
/// each variant with the same: `None` when nothing finite inhabits it. A type that states a
/// generator has the definition that samples it, and is drawn through it and no other way.
pub type Types = Map<String, Typed>

pub type Typed = {
  decl: Decl,
  depth: Option<Int>,
  depths: List<Option<Int>>,
  sampler: Option<String>,
}

/// A type that states a generator: its name, how many parameters it takes, and its sampler.
pub type Stated = { ty: String, params: Int, sampler: String }

/// Case indices below this draw their type's edge values rather than a sample.
pub fn edge_cases() -> Int = 5

/// Past this depth only a type's shallowest constructors are drawn, so a value is finite.
pub fn gen_depth() -> Int = 4

/// Past this depth nothing is drawn at all: the type is too deep to build.
pub fn hard_depth() -> Int = 64

fn max_len() -> Int = 16

/// How many values a stated generator is handed to choose among for each of its type's parameters.
pub fn pool_size() -> Int = 16

fn max_entries() -> Int = 8

/// Starts at `a` because the shrinker lowers characters toward it.
fn alphabet() -> Bytes = b"abcdefghijklmnop"

pub fn is_width(name: String) -> Bool =
  fold(
    ["U8", "U16", "U32", "U64", "I8", "I16", "I32", "I64", "U128", "I128"],
    false,
    |found: Bool, w: String| found || w == name,
  )

fn is_sequence(name: String) -> Bool = name == "List" || name == "Array"

fn is_scalar(name: String) -> Bool =
  name == "Int" || name == "Bool" || name == "String" || name == "Bytes" || name == "Unit"
    || name == "Float"
    || name == "Decimal"
    || name == "Char"
    || is_width(name)

// --- The declared types -------------------------------------------------------

/// Every declaration with its depths solved: a variant needs one more application than its deepest
/// field, and a type as few as its shallowest variant. Each round settles at least one type. A
/// value a generator draws is made whole, whatever its type declares.
pub fn types_of(decls: List<Decl>, stated: List<Stated> = []) -> Types / {abort.raise} = {
  let declared = fold(decls, map_new(), |acc: Types, d: Decl|
    map_insert(acc, d.name, {
      decl: d,
      depth: None,
      depths: map(d.variants, |_v: Variant| None),
      sampler: None,
    }));
  let start = fold(stated, declared, |acc: Types, g: Stated|
    map_insert(acc, g.ty, {
      decl: match map_get(acc, g.ty) {
        Some(t) -> t.decl,
        None -> { name: g.ty, params: g.params, variants: [] },
      },
      depth: Some(0),
      depths: [],
      sampler: Some(g.sampler),
    }));
  iterate(start, len(decls) + 2, |types: Types| {
    let next = map_fold(types, types, |acc: Types, name: String, t: Typed|
      if t.sampler != None { acc } else {
        let depths = map(t.decl.variants, |v: Variant| variant_depth(acc, v.fields));
        let best = fold(depths, None, |m: Option<Int>, d: Option<Int>|
          match d {
            None -> m,
            Some(x) -> match m { None -> Some(x), Some(y) -> Some(min(x, y)) },
          });
        map_insert(acc, name, { ..t, depth: best, depths: depths })
      });
    if next == types { Stop(types) } else { Continue(next) }
  })
}

fn variant_depth(types: Types, fields: List<Ty>) -> Option<Int> =
  match fold(fields, Some(0), |acc: Option<Int>, f: Ty|
      match acc {
        None -> None,
        Some(m) -> match depth(types, f) { None -> None, Some(d) -> Some(max(m, d)) },
      }) {
    Some(d) -> Some(d + 1),
    None -> None,
  }

/// Nested constructor applications a value of `ty` needs, or `None` when nothing finite inhabits it.
pub fn depth(types: Types, ty: Ty) -> Option<Int> =
  match ty {
    Var(_) -> Some(0),
    Record(fields) ->
      fold(fields, Some(0), |acc: Option<Int>, f: { name: String, ty: Ty }|
        match acc {
          None -> None,
          Some(m) -> match depth(types, f.ty) { None -> None, Some(d) -> Some(max(m, d)) },
        }),
    Fn(_, ret, pure) -> if pure { depth(types, ret) } else { None },
    Con(name, _) -> if is_scalar(name) || is_sequence(name) || name == "Map" { Some(0) }
    else if name == "Cell" || name == "Task" || name == "Chan" || name == "Secret" { None }
    else { match map_get(types, name) { Some(typed) -> typed.depth, None -> None } },
  }

/// A variant's fields with `args` in place of its type's parameters.
pub fn fields_of(fields: List<Ty>, args: List<Ty>) -> List<Ty> =
  map(fields, |f: Ty| substituted(f, args))

pub fn substituted(t: Ty, args: List<Ty>) -> Ty =
  match t {
    Var(v) -> match list_at(args, v) { Some(a) -> a, None -> t },
    Con(name, xs) -> Con(name, map(xs, |x: Ty| substituted(x, args))),
    Fn(params, ret, pure) ->
      Fn(map(params, |p: Ty| substituted(p, args)), substituted(ret, args), pure),
    Record(fields) ->
      Record(
        map(fields, |f: { name: String, ty: Ty }| { name: f.name, ty: substituted(f.ty, args) }),
      ),
  }

/// A record's fields in name order, which is the order they are drawn and stored in. Picked by
/// place, so what comes back is plainly the fields themselves.
pub fn by_name(fields: List<{ name: String, ty: Ty }>) -> List<{ name: String, ty: Ty }> =
  fold(
    name_order(map(fields, |f: { name: String, ty: Ty }| f.name)),
    [],
    |acc: List<{ name: String, ty: Ty }>, i: Int|
      match list_at(fields, i) { Some(f) -> push(acc, f), None -> acc },
  )

pub fn generatable(ty: Ty, types: Types) -> Result<Unit, Ungeneratable> =
  match ty {
    Var(_) -> Ok(()),
    Record(fields) -> all_ok(map(fields, |f: { name: String, ty: Ty }| f.ty), types),
    Fn(params, ret, pure) -> if !pure { Err(UEffectful) }
    else { match arity_of(params) { Err(e) -> Err(e), Ok(_) -> all_ok(push(params, ret), types) } },
    Con(name, args) -> if is_scalar(name) { Ok(()) }
    else if is_sequence(name) || name == "Map" { all_ok(args, types) }
    else if name == "Cell" { Err(UCell) }
    else if name == "Task" { Err(UTask) }
    else if name == "Chan" { Err(UChan) }
    else if name == "Secret" { Err(USecret) } else {
      match map_get(types, name) {
        None -> Err(UUnknown(name)),
        Some(typed) -> match typed.depth {
          None -> Err(UUninhabited(name)),
          Some(_) -> all_ok(args, types),
        },
      }
    },
  }

/// How many parameters a generated function of `params` takes, as its arity counts them.
pub fn arity_of(params: List<Ty>) -> Result<U8, Ungeneratable> =
  handle { Ok(u8_of_int(len(params))) } with { abort.raise(_) -> Err(UWide) }

fn all_ok(xs: List<Ty>, types: Types) -> Result<Unit, Ungeneratable> =
  fold(xs, Ok(()), |acc: Result<Unit, Ungeneratable>, x: Ty|
    match acc { Err(_) -> acc, Ok(_) -> generatable(x, types) })

// --- Drawing ------------------------------------------------------------------

/// What a draw is from: the declared types, how large a value may grow, and the edge point every leaf
/// takes in an edge case.
type Gen = { types: Types, size: Int, edge: Option<Int> }

/// A value, and the stream after it.
pub type Generated = { value: Value, rand: Rand }

/// One sixty-four-bit draw, as its low and high halves.
type Word = { lo: Int, hi: Int, rand: Rand }

fn word(rand: Rand) -> Word / {abort.raise} = {
  let d = rand_u64(rand);
  { lo: int_of_u64(d.value & 0xFFFF_FFFFu64), hi: int_of_u64(d.value >> 32), rand: d.rand }
}

/// The draw's sixty-four bits modulo a small positive `n`.
fn modulo(w: Word, n: Int) -> Int / {abort.raise} = (w.hi % n * (4294967296 % n) + w.lo % n) % n

/// The draw shifted right by `k`, under thirty-two.
fn shifted(w: Word, k: Int) -> Int = w.hi << 32 - k | w.lo >> k

fn wide(w: Word) -> U128 / {abort.raise} = u128_of_int(w.hi) << 32 | u128_of_int(w.lo)

pub fn generate(
  ty: Ty,
  types: Types,
  rand: Rand,
  case: Int,
) -> Result<Generated, Ungeneratable> / {abort.raise} =
  value(
    {
      types: types,
      size: min(case, 63),
      edge: if case < edge_cases() { Some(case) } else { None },
    },
    ty,
    rand,
    0,
  )

fn int_ty() -> Ty = Con("Int", [])

fn arg(args: List<Ty>, i: Int) -> Ty = match list_at(args, i) { Some(a) -> a, None -> int_ty() }

fn value(
  gen: Gen,
  ty: Ty,
  rand: Rand,
  depth: Int,
) -> Result<Generated, Ungeneratable> / {abort.raise} =
  if depth >= hard_depth() { Err(UTooDeep) } else {
    match ty {
      Var(_) -> Ok(int(gen, rand)),
      Record(fields) -> record(gen, by_name(fields), rand, depth),
      Fn(params, ret, pure) -> if !pure { Err(UEffectful) } else {
        match arity_of(params) {
          Err(e) -> Err(e),
          Ok(arity) -> function(gen, arity, params, ret, rand, depth),
        }
      },
      Con(name, args) -> if name == "Int" { Ok(int(gen, rand)) }
      else if is_width(name) { Ok(fixed(gen, name, rand)) }
      else if name == "Float" { Ok(float(gen, rand)) }
      else if name == "Decimal" { Ok(decimal(gen, rand)) }
      else if name == "Char" { Ok(character(gen, rand)) }
      else if name == "Bool" { Ok(boolean(gen, rand)) }
      else if name == "String" { Ok(text(gen, rand)) }
      else if name == "Bytes" { Ok(bytes(gen, rand)) }
      else if name == "Unit" { Ok({ value: VUnit, rand: rand }) }
      else if name == "List" { list(gen, arg(args, 0), rand, depth, |xs: List<Value>| VList(xs)) }
      else if name == "Array" { list(gen, arg(args, 0), rand, depth, |xs: List<Value>| VArray(xs)) }
      else if name == "Map" { map_value(gen, arg(args, 0), arg(args, 1), rand, depth) }
      else if name == "Cell" { Err(UCell) }
      else if name == "Task" { Err(UTask) }
      else if name == "Chan" { Err(UChan) }
      else if name == "Secret" { Err(USecret) }
      else { adt(gen, name, args, rand, depth) },
    }
  }

fn least_int() -> Int = 0 - 9223372036854775807 - 1

fn edge_ints() -> List<Int> = [0, 1, 0 - 1, least_int(), 9223372036854775807]

fn int(gen: Gen, rand: Rand) -> Generated / {abort.raise} =
  match gen.edge {
    Some(i) -> { value: VInt(at(edge_ints(), i % 5)), rand: rand },
    None -> {
      let s = word(rand);
      if s.lo % 32 < 5 { { value: VInt(at(edge_ints(), s.lo % 32)), rand: s.rand } } else {
        let x = word(s.rand);
        let magnitude = shifted(x, 1) & (1 << 8 + min(gen.size, 54)) - 1;
        { value: VInt(if x.lo % 2 == 0 { magnitude } else { 0 - magnitude }), rand: x.rand }
      }
    },
  }

pub fn mask(w: Int) -> U128 = if w == 128 { ~0u128 } else { (1u128 << w) - 1u128 }

/// Zero, one, all ones, the least, the greatest and one below it, as patterns of the width: `-1` is
/// all ones, which an unsigned width reads as its largest value.
fn fixed_edges(name: String) -> List<U128> = {
  let w = width_of(name);
  if string_starts_with(name, "I") {
    let top = 1u128 << w - 1;
    [0u128, 1u128, mask(w), top, top - 1u128, top - 2u128]
  } else { [0u128, 1u128, mask(w), 0u128, mask(w), mask(w) - 1u128] }
}

fn fixed(gen: Gen, name: String, r: Rand) -> Generated / {abort.raise} =
  match gen.edge {
    Some(i) -> { value: VFixed(name, at(fixed_edges(name), i % 6)), rand: r },
    None -> {
      let s = word(r);
      if s.lo % 32 < 6 { { value: VFixed(name, at(fixed_edges(name), s.lo % 32)), rand: s.rand } }
      else if width_of(name) == 128 {
        let high = word(s.rand);
        let low = word(high.rand);
        { value: VFixed(name, wide(high) << 64 | wide(low)), rand: low.rand }
      } else {
        let x = word(s.rand);
        { value: VFixed(name, wide(x) & mask(width_of(name))), rand: x.rand }
      }
    },
  }

/// A non-negative integer below `2^53` as the float it is exactly, built from its bits.
fn exact_float(n: Int) -> Float / {abort.raise} =
  if n == 0 { 0.0 } else {
    let top = iterate(0, 64, |e: Int| if n >> e + 1 == 0 { Stop(e) } else { Continue(e + 1) });
    float_of_bits(top + 1023 << 52 | n << 52 - top & 0xF_FFFF_FFFF_FFFF)
  }

fn edge_floats() -> List<Float> =
  [
    nan(),
    0.0,
    float_of_bits(0x8000_0000_0000_0000),
    1.0,
    0.0 - 1.0,
    infinity(),
    neg_infinity(),
    float::max_value(),
  ]

fn float(gen: Gen, rand: Rand) -> Generated / {abort.raise} =
  match gen.edge {
    Some(i) -> { value: VFloat(at(edge_floats(), i % 8)), rand: rand },
    None -> {
      let s = word(rand);
      if s.lo % 32 < 8 { { value: VFloat(at(edge_floats(), s.lo % 32)), rand: s.rand } } else {
        // Not over the bit pattern: a bounded mantissa and exponent reach ordinary scales too.
        let m = word(s.rand);
        let e = word(m.rand);
        let sign = word(e.rand);
        let magnitude = exact_float(shifted(m, 11)) * pow2(modulo(e, 1 + min(gen.size, 60)) - 30);
        {
          value: VFloat((if sign.lo % 2 == 0 { 1.0 } else { 0.0 - 1.0 }) * magnitude),
          rand: sign.rand,
        }
      }
    },
  }

fn edge_decimals() -> List<Decimal> / {abort.raise} =
  [
    0m,
    1m,
    0m - 1m,
    match of_parts(0, 2) { Some(d) -> d, None -> 0m },
    decimal::max_value(),
    decimal::min_value(),
  ]

fn decimal(gen: Gen, rand: Rand) -> Generated / {abort.raise} =
  match gen.edge {
    Some(i) -> { value: VDecimal(at(edge_decimals(), i % 6)), rand: rand },
    None -> {
      let s = word(rand);
      if s.lo % 32 < 6 { { value: VDecimal(at(edge_decimals(), s.lo % 32)), rand: s.rand } } else {
        let scale = word(s.rand);
        let x = word(scale.rand);
        let magnitude = shifted(x, 1) & (1 << 8 + min(gen.size, 54)) - 1;
        let mantissa = if x.lo % 2 == 0 { magnitude } else { 0 - magnitude };
        {
          value: VDecimal(match of_parts(mantissa, modulo(scale, 7)) { Some(d) -> d, None -> 0m }),
          rand: x.rand,
        }
      }
    },
  }

fn boolean(gen: Gen, rand: Rand) -> Generated / {abort.raise} =
  match gen.edge {
    Some(i) -> { value: VBool(i % 2 == 1), rand: rand },
    None -> {
      let s = word(rand);
      { value: VBool(s.lo % 2 == 1), rand: s.rand }
    },
  }

/// The lesser of two draws, capped by the size, so early cases are short.
fn length(gen: Gen, rand: Rand) -> { n: Int, rand: Rand } / {abort.raise} =
  match gen.edge {
    Some(i) -> { n: i % 3, rand: rand },
    None -> {
      let cap = min(max_len(), 1 + gen.size / 4);
      let a = word(rand);
      let b = word(a.rand);
      { n: min(modulo(a, cap + 1), modulo(b, cap + 1)), rand: b.rand }
    },
  }

fn text(gen: Gen, rand: Rand) -> Generated / {abort.raise} = {
  let l = length(gen, rand);
  let drawn = fold(
    range(0, l.n),
    { out: [], rand: l.rand },
    |acc: { out: List<Bytes>, rand: Rand }, _i: Int| {
      let c = word(acc.rand);
      { out: push(acc.out, bytes_slice(alphabet(), c.lo % 16, c.lo % 16 + 1)), rand: c.rand }
    },
  );
  { value: VStr(string_of_bytes(bytes_concat_all(drawn.out))), rand: drawn.rand }
}

/// Characters a reader of text trips on: the zero, a line break, a quote, one outside ASCII, one
/// outside the Basic Multilingual Plane and the last one there is.
fn edge_chars() -> List<Char> = ['a', '\0', '\n', ' ', '\'', '\u{e9}', '\u{1F600}', '\u{10FFFF}']

fn letter(i: Int) -> Char = match char_of_int(97 + i) { Some(c) -> c, None -> 'a' }

/// Mostly the alphabet strings draw from, so a character and a string's characters agree.
fn character(gen: Gen, rand: Rand) -> Generated / {abort.raise} =
  match gen.edge {
    Some(i) -> { value: VChar(at(edge_chars(), i % 8)), rand: rand },
    None -> {
      let c = word(rand);
      if c.lo % 8 == 0 { { value: VChar(at(edge_chars(), c.lo / 8 % 8)), rand: c.rand } }
      else { { value: VChar(letter(c.lo % 16)), rand: c.rand } }
    },
  }

fn bytes(gen: Gen, rand: Rand) -> Generated / {abort.raise} = {
  let l = length(gen, rand);
  let drawn = fold(
    range(0, l.n),
    { out: [], rand: l.rand },
    |acc: { out: List<Bytes>, rand: Rand }, _i: Int| {
      let c = word(acc.rand);
      { out: push(acc.out, byte_of_int(c.lo % 256)), rand: c.rand }
    },
  );
  { value: VBytes(bytes_concat_all(drawn.out)), rand: drawn.rand }
}

/// `n` values of `ty` in a row, each at `depth`.
fn several(
  gen: Gen,
  ty: Ty,
  n: Int,
  rand: Rand,
  depth: Int,
) -> Result<{ values: List<Value>, rand: Rand }, Ungeneratable> / {abort.raise} =
  fold(
    range(0, n),
    Ok({ values: [], rand: rand }),
    |acc: Result<{ values: List<Value>, rand: Rand }, Ungeneratable>, _i: Int|
      match acc {
        Err(_) -> acc,
        Ok(so_far) -> match value(gen, ty, so_far.rand, depth) {
          Err(e) -> Err(e),
          Ok(d) -> Ok({ values: push(so_far.values, d.value), rand: d.rand }),
        },
      },
  )

/// Each step down repeats `value`'s depth check, so the depth bound reads where it grows.
fn list(
  gen: Gen,
  elem: Ty,
  rand: Rand,
  depth: Int,
  made: (List<Value>) -> Value,
) -> Result<Generated, Ungeneratable> / {abort.raise} =
  if depth >= hard_depth() { Err(UTooDeep) } else {
    let l = if depth >= gen_depth() { { n: 0, rand: rand } } else { length(gen, rand) };
    match several(gen, elem, l.n, l.rand, depth + 1) {
      Err(e) -> Err(e),
      Ok(items) -> Ok({ value: made(items.values), rand: items.rand }),
    }
  }

fn map_value(
  gen: Gen,
  key: Ty,
  val: Ty,
  rand: Rand,
  depth: Int,
) -> Result<Generated, Ungeneratable> / {abort.raise} =
  if depth >= hard_depth() { Err(UTooDeep) } else {
    let l = if depth >= gen_depth() { { n: 0, rand: rand } } else { length(gen, rand) };
    let drawn = fold(
      range(0, min(l.n, max_entries())),
      Ok({ entries: [], rand: l.rand }),
      |acc: Result<{ entries: List<Entry>, rand: Rand }, Ungeneratable>, _i: Int|
        match acc {
          Err(_) -> acc,
          Ok(so_far) -> match value(gen, key, so_far.rand, depth + 1) {
            Err(e) -> Err(e),
            Ok(k) -> match value(gen, val, k.rand, depth + 1) {
              Err(e) -> Err(e),
              Ok(v) ->
                Ok({
                  entries: push(so_far.entries, { key: k.value, value: v.value }),
                  rand: v.rand,
                }),
            },
          },
        },
    );
    match drawn { Err(e) -> Err(e), Ok(d) -> Ok({ value: map_of(d.entries), rand: d.rand }) }
  }

fn record(
  gen: Gen,
  fields: List<{ name: String, ty: Ty }>,
  rand: Rand,
  depth: Int,
) -> Result<Generated, Ungeneratable> / {abort.raise} = {
  let drawn = fold(
    fields,
    Ok({ out: [], rand: rand }),
    |acc: Result<{ out: List<Field>, rand: Rand }, Ungeneratable>, f: { name: String, ty: Ty }|
      match acc {
        Err(_) -> acc,
        Ok(so_far) -> match value(gen, f.ty, so_far.rand, depth + 1) {
          Err(e) -> Err(e),
          Ok(d) -> Ok({ out: push(so_far.out, { name: f.name, value: d.value }), rand: d.rand }),
        },
      },
  );
  match drawn { Err(e) -> Err(e), Ok(d) -> Ok({ value: VRecord(d.out), rand: d.rand }) }
}

/// The variants a value of `name<args>` may be drawn as: those whose fields can be drawn, and past
/// the soft depth only the shallowest of them.
pub fn usable(
  types: Types,
  name: String,
  args: List<Ty>,
  depth: Int,
) -> Result<List<{ name: String, index: Int, fields: List<Ty> }>, Ungeneratable> / {abort.raise} =
  match map_get(types, name) {
    None -> Err(UUnknown(name)),
    Some(typed) -> {
      let all = fold(
        range(0, len(typed.decl.variants)),
        [],
        |acc: List<{ name: String, index: Int, fields: List<Ty> }>, i: Int| {
          let v = at(typed.decl.variants, i);
          let fields = fields_of(v.fields, args);
          if fold(fields, true, |ok: Bool, f: Ty| ok && generatable(f, types) == Ok(())) {
            push(acc, { name: v.name, index: i, fields: fields })
          } else { acc }
        },
      );
      let kept = if depth < gen_depth() { all } else {
        let depth_of = |u: { name: String, index: Int, fields: List<Ty> }|
          match list_at(typed.depths, u.index) { Some(d) -> d, None -> None };
        let shallowest = fold(
          all,
          None,
          |m: Option<Int>, u: { name: String, index: Int, fields: List<Ty> }|
            match depth_of(u) {
              None -> m,
              Some(d) -> match m { None -> Some(d), Some(x) -> Some(min(x, d)) },
            },
        );
        match shallowest {
          None -> [],
          Some(s) ->
            filter(all, |u: { name: String, index: Int, fields: List<Ty> }| depth_of(u) == Some(s)),
        }
      };
      if len(kept) == 0 { Err(UUninhabited(name)) } else { Ok(kept) }
    },
  }

/// Where a value of a type that states its generator goes: the values each of the type's parameters
/// is chosen among, drawn here, and a stream of its own, so what the sampler takes of it moves no
/// draw that follows.
fn through(
  gen: Gen,
  name: String,
  sampler: String,
  args: List<Ty>,
  rand: Rand,
  depth: Int,
) -> Result<Generated, Ungeneratable> / {abort.raise} = {
  // Pools are sampled, not each type's one edge value sixteen times over.
  let sampled = { ..gen, edge: None };
  let pools = fold(
    args,
    Ok({ pools: [], rand: rand }),
    |acc: Result<{ pools: List<List<Value>>, rand: Rand }, Ungeneratable>, arg: Ty|
      match acc {
        Err(_) -> acc,
        Ok(so_far) -> match several(sampled, arg, pool_size(), so_far.rand, depth + 1) {
          Err(e) -> Err(e),
          Ok(items) -> Ok({ pools: push(so_far.pools, items.values), rand: items.rand }),
        },
      },
  );
  match pools {
    Err(e) -> Err(e),
    Ok(p) ->
      Ok({
        value: carried({
          ty: name,
          sampler: sampler,
          pools: p.pools,
          size: gen.size,
          state: Fresh({
            root: p.rand.root,
            key: bytes_concat(p.rand.key, u64_le(p.rand.counter)),
          }),
        }),
        rand: { ..p.rand, counter: p.rand.counter + 1 },
      }),
  }
}

/// The definition that samples `name`, when its module states a generator for it.
pub fn sampler_of(types: Types, name: String) -> Option<String> =
  match map_get(types, name) { Some(typed) -> typed.sampler, None -> None }

fn adt(
  gen: Gen,
  name: String,
  args: List<Ty>,
  rand: Rand,
  depth: Int,
) -> Result<Generated, Ungeneratable> / {abort.raise} =
  if depth >= hard_depth() { Err(UTooDeep) } else {
    match sampler_of(gen.types, name) {
      Some(sampler) -> through(gen, name, sampler, args, rand, depth),
      None -> structural(gen, name, args, rand, depth),
    }
  }

fn structural(
  gen: Gen,
  name: String,
  args: List<Ty>,
  rand: Rand,
  depth: Int,
) -> Result<Generated, Ungeneratable> / {abort.raise} =
  if depth >= hard_depth() { Err(UTooDeep) } else {
    match usable(gen.types, name, args, depth) {
      Err(e) -> Err(e),
      Ok(variants) -> {
        let picked = match gen.edge {
          Some(i) -> { index: i % len(variants), rand: rand },
          None -> {
            let w = word(rand);
            { index: modulo(w, len(variants)), rand: w.rand }
          },
        };
        let v = at(variants, picked.index);
        match several_of(gen, v.fields, picked.rand, depth + 1) {
          Err(e) -> Err(e),
          Ok(drawn) -> Ok({ value: VCtor(v.name, drawn.values), rand: drawn.rand }),
        }
      },
    }
  }

/// One value of each type, in order.
fn several_of(
  gen: Gen,
  types: List<Ty>,
  rand: Rand,
  depth: Int,
) -> Result<{ values: List<Value>, rand: Rand }, Ungeneratable> / {abort.raise} =
  fold(
    types,
    Ok({ values: [], rand: rand }),
    |acc: Result<{ values: List<Value>, rand: Rand }, Ungeneratable>, ty: Ty|
      match acc {
        Err(_) -> acc,
        Ok(so_far) -> match value(gen, ty, so_far.rand, depth) {
          Err(e) -> Err(e),
          Ok(d) -> Ok({ values: push(so_far.values, d.value), rand: d.rand }),
        },
      },
  )

pub fn comparable(t: Ty) -> Bool =
  match t {
    Fn(_, _, _) -> false,
    Var(_) -> true,
    Record(fields) ->
      fold(fields, true, |ok: Bool, f: { name: String, ty: Ty }| ok && comparable(f.ty)),
    Con(_, args) -> fold(args, true, |ok: Bool, a: Ty| ok && comparable(a)),
  }

/// From a fixed family of pure, total, printable functions, so a counterexample reads.
fn function(
  gen: Gen,
  arity: U8,
  params: List<Ty>,
  ret: Ty,
  rand: Rand,
  depth: Int,
) -> Result<Generated, Ungeneratable> / {abort.raise} = {
  let projection = fold(range(0, len(params)), None, |found: Option<U8>, i: Int|
    match found {
      Some(_) -> found,
      None -> if at(params, i) == ret { Some(u8_of_int(i)) } else { None },
    });
  let tabulatable = match list_at(params, 0) { Some(p) -> comparable(p), None -> false };
  let chosen = match gen.edge {
    Some(_) -> { choice: 0, rand: rand },
    None -> {
      let w = word(rand);
      { choice: w.lo % 4, rand: w.rand }
    },
  };
  match projection {
    Some(index) if chosen.choice == 1 ->
      Ok({ value: VFn(FProject({ arity: arity, index: index })), rand: chosen.rand }),
    _ -> if (chosen.choice == 2 || chosen.choice == 3) && tabulatable {
      let count = word(chosen.rand);
      let drawn = fold(
        range(0, 1 + count.lo % 2),
        Ok({ entries: [], rand: count.rand }),
        |acc: Result<{ entries: List<Entry>, rand: Rand }, Ungeneratable>, _i: Int|
          match acc {
            Err(_) -> acc,
            Ok(so_far) -> match value(gen, at(params, 0), so_far.rand, depth + 1) {
              Err(e) -> Err(e),
              Ok(k) -> match value(gen, ret, k.rand, depth + 1) {
                Err(e) -> Err(e),
                Ok(v) ->
                  Ok({
                    entries: push(so_far.entries, { key: k.value, value: v.value }),
                    rand: v.rand,
                  }),
              },
            },
          },
      );
      match drawn {
        Err(e) -> Err(e),
        Ok(table) -> match value(gen, ret, table.rand, depth + 1) {
          Err(e) -> Err(e),
          Ok(fallback) ->
            Ok({
              value: VFn(FTable({ arity: arity, entries: table.entries, default: fallback.value })),
              rand: fallback.rand,
            }),
        },
      }
    } else {
      match value(gen, ret, chosen.rand, depth + 1) {
        Err(e) -> Err(e),
        Ok(v) -> Ok({ value: VFn(FConst({ arity: arity, value: v.value })), rand: v.rand }),
      }
    },
  }
}

// --- Tests --------------------------------------------------------------------

fn shapes() -> List<Decl> =
  [
    {
      name: "m.Shape",
      params: 0,
      variants: [
        { name: "m.Empty", fields: [] },
        { name: "m.Circle", fields: [Con("Int", [])] },
        { name: "m.Square", fields: [Con("Int", []), Con("Int", [])] },
      ],
    },
    {
      name: "m.Tree",
      params: 0,
      variants: [
        { name: "m.Leaf", fields: [] },
        { name: "m.Node", fields: [Con("m.Tree", []), Con("m.Tree", [])] },
      ],
    },
    { name: "m.Loop", params: 0, variants: [{ name: "m.Again", fields: [Con("m.Loop", [])] }] },
  ]

fn drawn_at(ty: Ty, root: Int, case: Int) -> Result<Value, Ungeneratable> / {abort.raise} =
  match generate(ty, types_of(shapes()), random::rand_keyed(root, b"key"), case) {
    Ok(g) -> Ok(g.value),
    Err(e) -> Err(e),
  }

fn int_t() -> Ty = Con("Int", [])

test "every type a binder may have generates, at every size" {
  let tys = [
    int_t(),
    Con("U8", []),
    Con("I128", []),
    Con("Float", []),
    Con("Decimal", []),
    Con("Bool", []),
    Con("String", []),
    Con("Bytes", []),
    Con("Unit", []),
    Con("List", [int_t()]),
    Con("Map", [int_t(), Con("String", [])]),
    Record([{ name: "x", ty: int_t() }]),
    Fn([int_t()], Con("Bool", []), true),
    Con("m.Shape", []),
    Con("m.Tree", []),
    Var(0),
  ];
  assert(
    fold(tys, true, |ok: Bool, t: Ty|
      ok
        && fold(range(0, 40), true, |o: Bool, c: Int|
          o && (match drawn_at(t, 3, c) { Ok(_) -> true, Err(_) -> false }))),
  )
}

test "a record draws its fields in name order" {
  match drawn_at(Record([{ name: "b", ty: int_t() }, { name: "a", ty: Con("Bool", []) }]), 0, 0) {
    Ok(VRecord(fields)) -> assert_eq(map(fields, |f: Field| f.name), ["a", "b"]),
    _ -> panic("a record"),
  }
}

test "the first cases are each type's edges, and a declared type draws every constructor" {
  assert_eq(
    map(range(0, 5), |c: Int| drawn_at(int_t(), 9, c)),
    map(edge_ints(), |n: Int| Ok(VInt(n))),
  );
  assert_eq(drawn_at(Con("Bool", []), 9, 1), Ok(VBool(true)));
  let names = fold(range(0, 60), [], |acc: List<String>, c: Int|
    match drawn_at(Con("m.Shape", []), 1, c) {
      Ok(VCtor(n, _)) -> if fold(acc, false, |s: Bool, x: String| s || x == n) { acc }
      else { push(acc, n) },
      _ -> acc,
    });
  assert_eq(len(names), 3)
}

test "a recursive type terminates, and one nothing finite inhabits is not generatable" {
  assert(
    fold(range(0, 64), true, |ok: Bool, c: Int|
      ok && (match drawn_at(Con("m.Tree", []), 5, c) { Ok(_) -> true, Err(_) -> false })),
  );
  let types = types_of(shapes());
  assert_eq(generatable(Con("m.Loop", []), types), Err(UUninhabited("m.Loop")));
  assert_eq(generatable(Con("Cell", [int_t()]), types), Err(UCell));
  assert_eq(generatable(Con("Chan", [int_t()]), types), Err(UChan));
  assert_eq(generatable(Fn([int_t()], int_t(), false), types), Err(UEffectful));
  assert_eq(generatable(Con("m.Nowhere", []), types), Err(UUnknown("m.Nowhere")));
  let taking = |n: Int| Fn(map(range(0, n), |_: Int| int_t()), int_t(), true);
  assert_eq(generatable(taking(255), types), Ok(()));
  assert_eq(generatable(taking(256), types), Err(UWide));
  assert_eq(match drawn_at(taking(256), 5, 0) { Ok(_) -> None, Err(e) -> Some(e) }, Some(UWide))
}

test "a draw is a function of its root, its key and its case" {
  let t = Con("List", [int_t()]);
  assert_eq(drawn_at(t, 7, 20), drawn_at(t, 7, 20));
  assert(
    fold(range(10, 20), false, |differs: Bool, c: Int|
      differs || drawn_at(t, 7, c) != drawn_at(t, 8, c)),
  )
}

fn stated_types() -> Types / {abort.raise} =
  types_of(shapes(), [
    { ty: "m.Shape", params: 0, sampler: "m._sample_Shape" },
    { ty: "m.Bag", params: 1, sampler: "m._sample_Bag" },
  ])

fn draw_at(ty: Ty, case: Int) -> Draw / {abort.raise} =
  match generate(ty, stated_types(), random::rand_keyed(4, b"key"), case) {
    Ok(g) -> match draw_of(g.value) { Some(d) -> d, None -> panic("a place for a draw") },
    Err(_) -> panic("the type draws"),
  }

test "a type that states a generator draws as a place for its sampler's value, on a stream of its own" {
  assert_eq(draw_at(Con("m.Shape", []), 9), {
    ty: "m.Shape",
    sampler: "m._sample_Shape",
    pools: [],
    size: 9,
    state: Fresh({ root: 4, key: bytes_concat(b"key", u64_le(0)) }),
  });
  // What the sampler takes of its stream moves no later draw: the claim's stream goes on by one.
  match generate(
      Con("List", [Con("m.Shape", [])]),
      stated_types(),
      random::rand_keyed(4, b"key"),
      40,
    ) {
    Ok(g) -> match g.value {
      VList(items) -> {
        let keys = fold(items, [], |acc: List<Bytes>, x: Value|
          match draw_of(x) {
            Some(d) -> match d.state { Fresh(f) -> push(acc, f.key), _ -> acc },
            None -> acc,
          });
        assert(len(items) > 1);
        assert_eq(len(keys), len(items));
        // The length took two draws, and each value one.
        assert_eq(keys, map(range(0, len(items)), |i: Int| bytes_concat(b"key", u64_le(2 + i))));
        assert_eq(g.rand.counter, 2 + len(items))
      },
      _ -> panic("a list"),
    },
    Err(_) -> panic("a list of them draws"),
  }
}

test "a stated generator is handed values to choose among for each of its type's parameters" {
  // A type no declaration describes is one too: a `new` record is known by its name alone.
  let bag = draw_at(Con("m.Bag", [int_t()]), 0);
  assert_eq(map(bag.pools, |pool: List<Value>| len(pool)), [pool_size()]);
  // They are sampled even in an edge case, where every `Int` drawn alone is the same edge.
  assert(
    fold(
      match list_at(bag.pools, 0) { Some(pool) -> pool, None -> [] },
      false,
      |any: Bool, x: Value| any || x != VInt(0),
    ),
  );
  // A parameter that states its own is drawn through its own, to be made first.
  let nested = draw_at(Con("m.Bag", [Con("m.Shape", [])]), 12);
  assert_eq(
    map(match list_at(nested.pools, 0) { Some(pool) -> pool, None -> [] }, |x: Value|
      match draw_of(x) { Some(d) -> d.sampler, None -> "" }),
    map(range(0, pool_size()), |_i: Int| "m._sample_Shape"),
  );
  let types = stated_types();
  assert_eq(generatable(Con("m.Bag", [int_t()]), types), Ok(()));
  assert_eq(generatable(Con("m.Bag", [Con("m.Loop", [])]), types), Err(UUninhabited("m.Loop")));
  assert_eq(sampler_of(types, "m.Bag"), Some("m._sample_Bag"));
  assert_eq(sampler_of(types, "m.Tree"), None)
}
