// `gen` — a value of every type, drawn from a claim's keyed stream. The case index sets how large a
// value may grow, and the first few cases take each type's edge values, so the corners of a type
// are tried before anything is sampled.

import std.decimal (of_parts)
import std.decimal
import std.float (nan, infinity, neg_infinity, pow2)
import std.float
import std.random (Rand, rand_u64)
import std.random
import std.value (Value, VUnit, VBool, VInt, VFloat, VDecimal, VFixed, VChar, VStr, VBytes, VList,
                  VArray, VRecord, VCtor, VFn, Field, Entry, FConst, FProject, FTable, map_of)
import domain (Ty, Var, Fn, Record, Con, Decl, Variant)

// Why a type has no value to draw.
pub type Ungeneratable =
  | UCell
  | UTask
  | USecret
  // Its row is not empty, so applying it would make a claim impure.
  | UEffectful
  | UUninhabited(String)
  | UUnknown(String)
  | UTooDeep

// The declared types, each with how many nested constructor applications a value of it needs, and
// each variant with the same: `None` when nothing finite inhabits it.
pub type Types = Map<String, Typed>

pub type Typed = { decl: Decl, depth: Option<Int>, depths: List<Option<Int>> }

// Case indices below this draw their type's edge values rather than a sample.
pub fn edge_cases() -> Int = 5

// Past this depth only a type's shallowest constructors are drawn, so a value is finite.
pub fn gen_depth() -> Int = 4

// Past this depth nothing is drawn at all: the type is too deep to build.
pub fn hard_depth() -> Int = 64

fn max_len() -> Int = 16

fn max_entries() -> Int = 8

// Starts at `a` because the shrinker lowers characters toward it.
fn alphabet() -> Bytes = b"abcdefghijklmnop"

fn is_width(name: String) -> Bool =
  fold(
    ["U8", "U16", "U32", "U64", "I8", "I16", "I32", "I64", "U128", "I128"],
    false,
    |found: Bool, w: String| found || w == name,
  )

fn is_sequence(name: String) -> Bool = name == "List" || name == "Array"

fn is_scalar(name: String) -> Bool =
  name == "Int" || name == "Bool" || name == "String" || name == "Bytes" || name == "Unit"
    || name == "Float"
    || name == "Decimal"
    || name == "Char"
    || is_width(name)

// --- The declared types -------------------------------------------------------

// Every declaration with its depths solved: a variant needs one more application than its deepest
// field, and a type as few as its shallowest variant. Each round settles at least one type.
pub fn types_of(decls: List<Decl>) -> Types = {
  let start = fold(decls, map_new(), |acc: Types, d: Decl|
    map_insert(acc, d.name, { decl: d, depth: None, depths: map(d.variants, |_v: Variant| None) }));
  iterate(start, len(decls) + 2, |ts: Types| {
    let next = map_fold(ts, ts, |acc: Types, name: String, t: Typed| {
      let depths = map(t.decl.variants, |v: Variant| variant_depth(acc, v.fields));
      let best = fold(depths, None, |m: Option<Int>, d: Option<Int>|
        match d { None -> m, Some(x) -> match m { None -> Some(x), Some(y) -> Some(min(x, y)) } });
      map_insert(acc, name, { ..t, depth: best, depths: depths })
    });
    if next == ts { Stop(ts) } else { Continue(next) }
  })
}

fn variant_depth(ts: Types, fields: List<Ty>) -> Option<Int> =
  match fold(fields, Some(0), |acc: Option<Int>, f: Ty|
      match acc {
        None -> None,
        Some(m) -> match depth(ts, f) { None -> None, Some(d) -> Some(max(m, d)) },
      }) {
    Some(d) -> Some(d + 1),
    None -> None,
  }

// Nested constructor applications a value of `t` needs, or `None` when nothing finite inhabits it.
pub fn depth(ts: Types, t: Ty) -> Option<Int> =
  match t {
    Var(_) -> Some(0),
    Record(fields) ->
      fold(fields, Some(0), |acc: Option<Int>, f: { name: String, ty: Ty }|
        match acc {
          None -> None,
          Some(m) -> match depth(ts, f.ty) { None -> None, Some(d) -> Some(max(m, d)) },
        }),
    Fn(_, ret, pure) -> if pure { depth(ts, ret) } else { None },
    Con(name, _) -> if is_scalar(name) || is_sequence(name) || name == "Map" { Some(0) }
    else if name == "Cell" || name == "Task" || name == "Secret" { None }
    else { match map_get(ts, name) { Some(typed) -> typed.depth, None -> None } },
  }

// A variant's fields with `args` in place of its type's parameters.
pub fn fields_of(fields: List<Ty>, args: List<Ty>) -> List<Ty> =
  map(fields, |f: Ty| substituted(f, args))

pub fn substituted(t: Ty, args: List<Ty>) -> Ty =
  match t {
    Var(v) -> match list_at(args, v) { Some(a) -> a, None -> t },
    Con(name, xs) -> Con(name, map(xs, |x: Ty| substituted(x, args))),
    Fn(params, ret, pure) ->
      Fn(map(params, |p: Ty| substituted(p, args)), substituted(ret, args), pure),
    Record(fields) ->
      Record(
        map(fields, |f: { name: String, ty: Ty }| { name: f.name, ty: substituted(f.ty, args) }),
      ),
  }

// A record's fields in name order, which is the order they are drawn and stored in.
pub fn by_name(fields: List<{ name: String, ty: Ty }>) -> List<{ name: String, ty: Ty }> =
  fold(fields, [], |acc: List<{ name: String, ty: Ty }>, f: { name: String, ty: Ty }| {
    let at = fold(range(0, len(acc)), len(acc), |found: Int, i: Int|
      if found < len(acc) { found } else {
        match list_at(acc, i) {
          Some(g) -> if compare(f.name, g.name) == Less { i } else { found },
          None -> found,
        }
      });
    if at == len(acc) { push(acc, f) } else {
      fold(range(0, len(acc)), [], |out: List<{ name: String, ty: Ty }>, i: Int|
        match list_at(acc, i) {
          Some(g) -> if i == at { push(push(out, f), g) } else { push(out, g) },
          None -> out,
        })
    }
  })

pub fn generatable(t: Ty, ts: Types) -> Result<Unit, Ungeneratable> =
  match t {
    Var(_) -> Ok(()),
    Record(fields) -> all_ok(map(fields, |f: { name: String, ty: Ty }| f.ty), ts),
    Fn(params, ret, pure) -> if !pure { Err(UEffectful) } else { all_ok(push(params, ret), ts) },
    Con(name, args) -> if is_scalar(name) { Ok(()) }
    else if is_sequence(name) || name == "Map" { all_ok(args, ts) }
    else if name == "Cell" { Err(UCell) }
    else if name == "Task" { Err(UTask) }
    else if name == "Secret" { Err(USecret) } else {
      match map_get(ts, name) {
        None -> Err(UUnknown(name)),
        Some(typed) -> match typed.depth {
          None -> Err(UUninhabited(name)),
          Some(_) -> all_ok(args, ts),
        },
      }
    },
  }

fn all_ok(xs: List<Ty>, ts: Types) -> Result<Unit, Ungeneratable> =
  fold(xs, Ok(()), |acc: Result<Unit, Ungeneratable>, x: Ty|
    match acc { Err(_) -> acc, Ok(_) -> generatable(x, ts) })

// --- Drawing ------------------------------------------------------------------

// What a draw is from: the declared types, how large a value may grow, and the edge point every leaf
// takes in an edge case.
type Gen = { ts: Types, size: Int, edge: Option<Int> }

// A value, and the stream after it.
pub type Generated = { value: Value, rand: Rand }

// One sixty-four-bit draw, as its low and high halves.
type Word = { lo: Int, hi: Int, rand: Rand }

fn word(r: Rand) -> Word = {
  let d = rand_u64(r);
  { lo: int_of_u64(d.value & 0xFFFF_FFFFu64), hi: int_of_u64(d.value >> 32), rand: d.rand }
}

// The draw's sixty-four bits modulo a small positive `n`.
fn modulo(w: Word, n: Int) -> Int = (w.hi % n * (4294967296 % n) + w.lo % n) % n

// The draw shifted right by `k`, under thirty-two.
fn shifted(w: Word, k: Int) -> Int = w.hi << 32 - k | w.lo >> k

fn wide(w: Word) -> U128 = u128_of_int(w.hi) << 32 | u128_of_int(w.lo)

fn nth<a>(xs: List<a>, i: Int) -> a =
  match list_at(xs, i) { Some(x) -> x, None -> panic("an index the list holds") }

pub fn generate(t: Ty, ts: Types, r: Rand, case: Int) -> Result<Generated, Ungeneratable> =
  value(
    { ts: ts, size: min(case, 63), edge: if case < edge_cases() { Some(case) } else { None } },
    t,
    r,
    0,
  )

fn int_ty() -> Ty = Con("Int", [])

fn arg(args: List<Ty>, i: Int) -> Ty = match list_at(args, i) { Some(a) -> a, None -> int_ty() }

fn value(g: Gen, t: Ty, r: Rand, depth: Int) -> Result<Generated, Ungeneratable> =
  if depth >= hard_depth() { Err(UTooDeep) } else {
    match t {
      Var(_) -> Ok(int(g, r)),
      Record(fields) -> record(g, by_name(fields), r, depth),
      Fn(params, ret, pure) -> if !pure { Err(UEffectful) }
      else { function(g, params, ret, r, depth) },
      Con(name, args) -> if name == "Int" { Ok(int(g, r)) }
      else if is_width(name) { Ok(fixed(g, name, r)) }
      else if name == "Float" { Ok(float(g, r)) }
      else if name == "Decimal" { Ok(decimal(g, r)) }
      else if name == "Char" { Ok(character(g, r)) }
      else if name == "Bool" { Ok(boolean(g, r)) }
      else if name == "String" { Ok(text(g, r)) }
      else if name == "Bytes" { Ok(bytes(g, r)) }
      else if name == "Unit" { Ok({ value: VUnit, rand: r }) }
      else if name == "List" { list(g, arg(args, 0), r, depth, |xs: List<Value>| VList(xs)) }
      else if name == "Array" { list(g, arg(args, 0), r, depth, |xs: List<Value>| VArray(xs)) }
      else if name == "Map" { map_value(g, arg(args, 0), arg(args, 1), r, depth) }
      else if name == "Cell" { Err(UCell) }
      else if name == "Task" { Err(UTask) }
      else if name == "Secret" { Err(USecret) }
      else { adt(g, name, args, r, depth) },
    }
  }

fn least_int() -> Int = 0 - 9223372036854775807 - 1

fn edge_ints() -> List<Int> = [0, 1, 0 - 1, least_int(), 9223372036854775807]

fn int(g: Gen, r: Rand) -> Generated =
  match g.edge {
    Some(i) -> { value: VInt(nth(edge_ints(), i % 5)), rand: r },
    None -> {
      let s = word(r);
      if s.lo % 32 < 5 { { value: VInt(nth(edge_ints(), s.lo % 32)), rand: s.rand } } else {
        let x = word(s.rand);
        let magnitude = shifted(x, 1) & (1 << 8 + min(g.size, 54)) - 1;
        { value: VInt(if x.lo % 2 == 0 { magnitude } else { 0 - magnitude }), rand: x.rand }
      }
    },
  }

fn width(name: String) -> Int =
  if name == "U8" || name == "I8" { 8 }
  else if name == "U16" || name == "I16" { 16 }
  else if name == "U32" || name == "I32" { 32 }
  else if name == "U64" || name == "I64" { 64 }
  else { 128 }

fn mask(w: Int) -> U128 = if w == 128 { ~0u128 } else { (1u128 << w) - 1u128 }

// Zero, one, all ones, the least, the greatest and one below it, as patterns of the width: `-1` is
// all ones, which an unsigned width reads as its largest value.
fn fixed_edges(name: String) -> List<U128> = {
  let w = width(name);
  if string_starts_with(name, "I") {
    let top = 1u128 << w - 1;
    [0u128, 1u128, mask(w), top, top - 1u128, top - 2u128]
  } else { [0u128, 1u128, mask(w), 0u128, mask(w), mask(w) - 1u128] }
}

fn fixed(g: Gen, name: String, r: Rand) -> Generated =
  match g.edge {
    Some(i) -> { value: VFixed(name, nth(fixed_edges(name), i % 6)), rand: r },
    None -> {
      let s = word(r);
      if s.lo % 32 < 6 { { value: VFixed(name, nth(fixed_edges(name), s.lo % 32)), rand: s.rand } }
      else if width(name) == 128 {
        let high = word(s.rand);
        let low = word(high.rand);
        { value: VFixed(name, wide(high) << 64 | wide(low)), rand: low.rand }
      } else {
        let x = word(s.rand);
        { value: VFixed(name, wide(x) & mask(width(name))), rand: x.rand }
      }
    },
  }

// A non-negative integer below `2^53` as the float it is exactly, built from its bits.
fn exact_float(n: Int) -> Float =
  if n == 0 { 0.0 } else {
    let top = iterate(0, 64, |e: Int| if n >> e + 1 == 0 { Stop(e) } else { Continue(e + 1) });
    float_of_bits(top + 1023 << 52 | n << 52 - top & 0xF_FFFF_FFFF_FFFF)
  }

fn edge_floats() -> List<Float> =
  [
    nan(),
    0.0,
    float_of_bits(0x8000_0000_0000_0000),
    1.0,
    0.0 - 1.0,
    infinity(),
    neg_infinity(),
    float::max_value(),
  ]

fn float(g: Gen, r: Rand) -> Generated =
  match g.edge {
    Some(i) -> { value: VFloat(nth(edge_floats(), i % 8)), rand: r },
    None -> {
      let s = word(r);
      if s.lo % 32 < 8 { { value: VFloat(nth(edge_floats(), s.lo % 32)), rand: s.rand } } else {
        // Not over the bit pattern: a bounded mantissa and exponent reach ordinary scales too.
        let m = word(s.rand);
        let e = word(m.rand);
        let sign = word(e.rand);
        let magnitude = exact_float(shifted(m, 11)) * pow2(modulo(e, 1 + min(g.size, 60)) - 30);
        {
          value: VFloat((if sign.lo % 2 == 0 { 1.0 } else { 0.0 - 1.0 }) * magnitude),
          rand: sign.rand,
        }
      }
    },
  }

fn edge_decimals() -> List<Decimal> =
  [
    0m,
    1m,
    0m - 1m,
    match of_parts(0, 2) { Some(d) -> d, None -> 0m },
    decimal::max_value(),
    decimal::min_value(),
  ]

fn decimal(g: Gen, r: Rand) -> Generated =
  match g.edge {
    Some(i) -> { value: VDecimal(nth(edge_decimals(), i % 6)), rand: r },
    None -> {
      let s = word(r);
      if s.lo % 32 < 6 { { value: VDecimal(nth(edge_decimals(), s.lo % 32)), rand: s.rand } } else {
        let scale = word(s.rand);
        let x = word(scale.rand);
        let magnitude = shifted(x, 1) & (1 << 8 + min(g.size, 54)) - 1;
        let mantissa = if x.lo % 2 == 0 { magnitude } else { 0 - magnitude };
        {
          value: VDecimal(match of_parts(mantissa, modulo(scale, 7)) { Some(d) -> d, None -> 0m }),
          rand: x.rand,
        }
      }
    },
  }

fn boolean(g: Gen, r: Rand) -> Generated =
  match g.edge {
    Some(i) -> { value: VBool(i % 2 == 1), rand: r },
    None -> {
      let s = word(r);
      { value: VBool(s.lo % 2 == 1), rand: s.rand }
    },
  }

// The lesser of two draws, capped by the size, so early cases are short.
fn length(g: Gen, r: Rand) -> { n: Int, rand: Rand } =
  match g.edge {
    Some(i) -> { n: i % 3, rand: r },
    None -> {
      let cap = min(max_len(), 1 + g.size / 4);
      let a = word(r);
      let b = word(a.rand);
      { n: min(modulo(a, cap + 1), modulo(b, cap + 1)), rand: b.rand }
    },
  }

fn text(g: Gen, r: Rand) -> Generated = {
  let l = length(g, r);
  let drawn = fold(
    range(0, l.n),
    { out: [], rand: l.rand },
    |acc: { out: List<Bytes>, rand: Rand }, _i: Int| {
      let c = word(acc.rand);
      { out: push(acc.out, bytes_slice(alphabet(), c.lo % 16, c.lo % 16 + 1)), rand: c.rand }
    },
  );
  { value: VStr(string_of_bytes(bytes_concat_all(drawn.out))), rand: drawn.rand }
}

// Characters a reader of text trips on: the zero, a line break, a quote, one outside ASCII, one
// outside the Basic Multilingual Plane and the last one there is.
fn edge_chars() -> List<Char> = ['a', '\0', '\n', ' ', '\'', '\u{e9}', '\u{1F600}', '\u{10FFFF}']

fn letter(i: Int) -> Char = match char_of_int(97 + i) { Some(c) -> c, None -> 'a' }

// Mostly the alphabet strings draw from, so a character and a string's characters agree.
fn character(g: Gen, r: Rand) -> Generated =
  match g.edge {
    Some(i) -> { value: VChar(nth(edge_chars(), i % 8)), rand: r },
    None -> {
      let c = word(r);
      if c.lo % 8 == 0 { { value: VChar(nth(edge_chars(), c.lo / 8 % 8)), rand: c.rand } }
      else { { value: VChar(letter(c.lo % 16)), rand: c.rand } }
    },
  }

fn bytes(g: Gen, r: Rand) -> Generated = {
  let l = length(g, r);
  let drawn = fold(
    range(0, l.n),
    { out: [], rand: l.rand },
    |acc: { out: List<Bytes>, rand: Rand }, _i: Int| {
      let c = word(acc.rand);
      { out: push(acc.out, byte_of_int(c.lo % 256)), rand: c.rand }
    },
  );
  { value: VBytes(bytes_concat_all(drawn.out)), rand: drawn.rand }
}

// `n` values of `t` in a row, each at `depth`.
fn several(
  g: Gen,
  t: Ty,
  n: Int,
  r: Rand,
  depth: Int,
) -> Result<{ values: List<Value>, rand: Rand }, Ungeneratable> =
  fold(
    range(0, n),
    Ok({ values: [], rand: r }),
    |acc: Result<{ values: List<Value>, rand: Rand }, Ungeneratable>, _i: Int|
      match acc {
        Err(_) -> acc,
        Ok(so_far) -> match value(g, t, so_far.rand, depth) {
          Err(e) -> Err(e),
          Ok(d) -> Ok({ values: push(so_far.values, d.value), rand: d.rand }),
        },
      },
  )

fn list(
  g: Gen,
  elem: Ty,
  r: Rand,
  depth: Int,
  made: (List<Value>) -> Value,
) -> Result<Generated, Ungeneratable> = {
  let l = if depth >= gen_depth() { { n: 0, rand: r } } else { length(g, r) };
  match several(g, elem, l.n, l.rand, depth + 1) {
    Err(e) -> Err(e),
    Ok(items) -> Ok({ value: made(items.values), rand: items.rand }),
  }
}

fn map_value(g: Gen, key: Ty, val: Ty, r: Rand, depth: Int) -> Result<Generated, Ungeneratable> = {
  let l = if depth >= gen_depth() { { n: 0, rand: r } } else { length(g, r) };
  let drawn = fold(
    range(0, min(l.n, max_entries())),
    Ok({ entries: [], rand: l.rand }),
    |acc: Result<{ entries: List<Entry>, rand: Rand }, Ungeneratable>, _i: Int|
      match acc {
        Err(_) -> acc,
        Ok(so_far) -> match value(g, key, so_far.rand, depth + 1) {
          Err(e) -> Err(e),
          Ok(k) -> match value(g, val, k.rand, depth + 1) {
            Err(e) -> Err(e),
            Ok(v) ->
              Ok({ entries: push(so_far.entries, { key: k.value, value: v.value }), rand: v.rand }),
          },
        },
      },
  );
  match drawn { Err(e) -> Err(e), Ok(d) -> Ok({ value: map_of(d.entries), rand: d.rand }) }
}

fn record(
  g: Gen,
  fields: List<{ name: String, ty: Ty }>,
  r: Rand,
  depth: Int,
) -> Result<Generated, Ungeneratable> = {
  let drawn = fold(
    fields,
    Ok({ out: [], rand: r }),
    |acc: Result<{ out: List<Field>, rand: Rand }, Ungeneratable>, f: { name: String, ty: Ty }|
      match acc {
        Err(_) -> acc,
        Ok(so_far) -> match value(g, f.ty, so_far.rand, depth + 1) {
          Err(e) -> Err(e),
          Ok(d) -> Ok({ out: push(so_far.out, { name: f.name, value: d.value }), rand: d.rand }),
        },
      },
  );
  match drawn { Err(e) -> Err(e), Ok(d) -> Ok({ value: VRecord(d.out), rand: d.rand }) }
}

// The variants a value of `name<args>` may be drawn as: those whose fields can be drawn, and past
// the soft depth only the shallowest of them.
pub fn usable(
  ts: Types,
  name: String,
  args: List<Ty>,
  depth: Int,
) -> Result<List<{ name: String, index: Int, fields: List<Ty> }>, Ungeneratable> =
  match map_get(ts, name) {
    None -> Err(UUnknown(name)),
    Some(typed) -> {
      let all = fold(
        range(0, len(typed.decl.variants)),
        [],
        |acc: List<{ name: String, index: Int, fields: List<Ty> }>, i: Int| {
          let v = nth(typed.decl.variants, i);
          let fields = fields_of(v.fields, args);
          if fold(fields, true, |ok: Bool, f: Ty| ok && generatable(f, ts) == Ok(())) {
            push(acc, { name: v.name, index: i, fields: fields })
          } else { acc }
        },
      );
      let kept = if depth < gen_depth() { all } else {
        let depth_of = |u: { name: String, index: Int, fields: List<Ty> }|
          match list_at(typed.depths, u.index) { Some(d) -> d, None -> None };
        let shallowest = fold(
          all,
          None,
          |m: Option<Int>, u: { name: String, index: Int, fields: List<Ty> }|
            match depth_of(u) {
              None -> m,
              Some(d) -> match m { None -> Some(d), Some(x) -> Some(min(x, d)) },
            },
        );
        match shallowest {
          None -> [],
          Some(s) ->
            filter(all, |u: { name: String, index: Int, fields: List<Ty> }| depth_of(u) == Some(s)),
        }
      };
      if len(kept) == 0 { Err(UUninhabited(name)) } else { Ok(kept) }
    },
  }

fn adt(
  g: Gen,
  name: String,
  args: List<Ty>,
  r: Rand,
  depth: Int,
) -> Result<Generated, Ungeneratable> =
  match usable(g.ts, name, args, depth) {
    Err(e) -> Err(e),
    Ok(variants) -> {
      let picked = match g.edge {
        Some(i) -> { index: i % len(variants), rand: r },
        None -> {
          let w = word(r);
          { index: modulo(w, len(variants)), rand: w.rand }
        },
      };
      let v = nth(variants, picked.index);
      match several_of(g, v.fields, picked.rand, depth + 1) {
        Err(e) -> Err(e),
        Ok(drawn) -> Ok({ value: VCtor(v.name, drawn.values), rand: drawn.rand }),
      }
    },
  }

// One value of each type, in order.
fn several_of(
  g: Gen,
  ts: List<Ty>,
  r: Rand,
  depth: Int,
) -> Result<{ values: List<Value>, rand: Rand }, Ungeneratable> =
  fold(
    ts,
    Ok({ values: [], rand: r }),
    |acc: Result<{ values: List<Value>, rand: Rand }, Ungeneratable>, t: Ty|
      match acc {
        Err(_) -> acc,
        Ok(so_far) -> match value(g, t, so_far.rand, depth) {
          Err(e) -> Err(e),
          Ok(d) -> Ok({ values: push(so_far.values, d.value), rand: d.rand }),
        },
      },
  )

pub fn comparable(t: Ty) -> Bool =
  match t {
    Fn(_, _, _) -> false,
    Var(_) -> true,
    Record(fields) ->
      fold(fields, true, |ok: Bool, f: { name: String, ty: Ty }| ok && comparable(f.ty)),
    Con(_, args) -> fold(args, true, |ok: Bool, a: Ty| ok && comparable(a)),
  }

// From a fixed family of pure, total, printable functions, so a counterexample reads.
fn function(
  g: Gen,
  params: List<Ty>,
  ret: Ty,
  r: Rand,
  depth: Int,
) -> Result<Generated, Ungeneratable> = {
  let arity = len(params);
  let projection = fold(range(0, arity), None, |found: Option<Int>, i: Int|
    match found { Some(_) -> found, None -> if nth(params, i) == ret { Some(i) } else { None } });
  let tabulatable = match list_at(params, 0) { Some(p) -> comparable(p), None -> false };
  let chosen = match g.edge {
    Some(_) -> { choice: 0, rand: r },
    None -> {
      let w = word(r);
      { choice: w.lo % 4, rand: w.rand }
    },
  };
  match projection {
    Some(index) if chosen.choice == 1 ->
      Ok({ value: VFn(FProject({ arity: arity, index: index })), rand: chosen.rand }),
    _ -> if (chosen.choice == 2 || chosen.choice == 3) && tabulatable {
      let count = word(chosen.rand);
      let drawn = fold(
        range(0, 1 + count.lo % 2),
        Ok({ entries: [], rand: count.rand }),
        |acc: Result<{ entries: List<Entry>, rand: Rand }, Ungeneratable>, _i: Int|
          match acc {
            Err(_) -> acc,
            Ok(so_far) -> match value(g, nth(params, 0), so_far.rand, depth + 1) {
              Err(e) -> Err(e),
              Ok(k) -> match value(g, ret, k.rand, depth + 1) {
                Err(e) -> Err(e),
                Ok(v) ->
                  Ok({
                    entries: push(so_far.entries, { key: k.value, value: v.value }),
                    rand: v.rand,
                  }),
              },
            },
          },
      );
      match drawn {
        Err(e) -> Err(e),
        Ok(table) -> match value(g, ret, table.rand, depth + 1) {
          Err(e) -> Err(e),
          Ok(fallback) ->
            Ok({
              value: VFn(FTable({ arity: arity, entries: table.entries, default: fallback.value })),
              rand: fallback.rand,
            }),
        },
      }
    } else {
      match value(g, ret, chosen.rand, depth + 1) {
        Err(e) -> Err(e),
        Ok(v) -> Ok({ value: VFn(FConst({ arity: arity, value: v.value })), rand: v.rand }),
      }
    },
  }
}

// --- Tests --------------------------------------------------------------------

fn shapes() -> List<Decl> =
  [
    {
      name: "m.Shape",
      params: 0,
      variants: [
        { name: "m.Empty", fields: [] },
        { name: "m.Circle", fields: [Con("Int", [])] },
        { name: "m.Square", fields: [Con("Int", []), Con("Int", [])] },
      ],
    },
    {
      name: "m.Tree",
      params: 0,
      variants: [
        { name: "m.Leaf", fields: [] },
        { name: "m.Node", fields: [Con("m.Tree", []), Con("m.Tree", [])] },
      ],
    },
    { name: "m.Loop", params: 0, variants: [{ name: "m.Again", fields: [Con("m.Loop", [])] }] },
  ]

fn drawn_at(t: Ty, root: Int, case: Int) -> Result<Value, Ungeneratable> =
  match generate(t, types_of(shapes()), random::rand_keyed(root, b"key"), case) {
    Ok(g) -> Ok(g.value),
    Err(e) -> Err(e),
  }

fn int_t() -> Ty = Con("Int", [])

test "every type a binder may have generates, at every size" {
  let tys = [
    int_t(),
    Con("U8", []),
    Con("I128", []),
    Con("Float", []),
    Con("Decimal", []),
    Con("Bool", []),
    Con("String", []),
    Con("Bytes", []),
    Con("Unit", []),
    Con("List", [int_t()]),
    Con("Map", [int_t(), Con("String", [])]),
    Record([{ name: "x", ty: int_t() }]),
    Fn([int_t()], Con("Bool", []), true),
    Con("m.Shape", []),
    Con("m.Tree", []),
    Var(0),
  ];
  assert(
    fold(tys, true, |ok: Bool, t: Ty|
      ok
        && fold(range(0, 40), true, |o: Bool, c: Int|
          o && (match drawn_at(t, 3, c) { Ok(_) -> true, Err(_) -> false }))),
  )
}

test "a record draws its fields in name order" {
  match drawn_at(Record([{ name: "b", ty: int_t() }, { name: "a", ty: Con("Bool", []) }]), 0, 0) {
    Ok(VRecord(fields)) -> assert_eq(map(fields, |f: Field| f.name), ["a", "b"]),
    _ -> panic("a record"),
  }
}

test "the first cases are each type's edges, and a declared type draws every constructor" {
  assert_eq(
    map(range(0, 5), |c: Int| drawn_at(int_t(), 9, c)),
    map(edge_ints(), |n: Int| Ok(VInt(n))),
  );
  assert_eq(drawn_at(Con("Bool", []), 9, 1), Ok(VBool(true)));
  let names = fold(range(0, 60), [], |acc: List<String>, c: Int|
    match drawn_at(Con("m.Shape", []), 1, c) {
      Ok(VCtor(n, _)) -> if fold(acc, false, |s: Bool, x: String| s || x == n) { acc }
      else { push(acc, n) },
      _ -> acc,
    });
  assert_eq(len(names), 3)
}

test "a recursive type terminates, and one nothing finite inhabits is not generatable" {
  assert(
    fold(range(0, 64), true, |ok: Bool, c: Int|
      ok && (match drawn_at(Con("m.Tree", []), 5, c) { Ok(_) -> true, Err(_) -> false })),
  );
  let ts = types_of(shapes());
  assert_eq(generatable(Con("m.Loop", []), ts), Err(UUninhabited("m.Loop")));
  assert_eq(generatable(Con("Cell", [int_t()]), ts), Err(UCell));
  assert_eq(generatable(Fn([int_t()], int_t(), false), ts), Err(UEffectful));
  assert_eq(generatable(Con("m.Nowhere", []), ts), Err(UUnknown("m.Nowhere")))
}

test "a draw is a function of its root, its key and its case" {
  let t = Con("List", [int_t()]);
  assert_eq(drawn_at(t, 7, 20), drawn_at(t, 7, 20));
  assert(
    fold(range(10, 20), false, |differs: Bool, c: Int|
      differs || drawn_at(t, 7, c) != drawn_at(t, 8, c)),
  )
}
