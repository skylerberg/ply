//! `keys` — what an obligation's proof is filed under.
//!
//! A proof read off the claim alone is a fact about the claim, and one a run helped make is a fact
//! about every definition the claim executes, so each is filed under a key made from the hash that
//! covers what it rests on. That is why an entry can be read back at all: the reader recomputes the
//! key, and an entry under the other one is a refusal rather than a mistake.
//!
//! This is the only encoding of them: the runtime reads and writes evidence under the keys the program
//! hands it.

import std.bytes (bytes_of_hex, hex_of)
import std.hash (blake3)

/// The tag every key starts from, so an entry an earlier layout filed is never read as one of these.
fn domain() -> Bytes = b"ply.prove.key.3"

/// The key a proof read off the claim that hashes to `claim` is filed under.
pub fn claim_key(claim: Bytes) -> Bytes =
  blake3(bytes_concat_all([domain(), b"\x00claim\x00", claim]))

/// The key a proof a run helped make is filed under, for a claim that executes what hashes to
/// `executes`.
pub fn run_key(executes: Bytes) -> Bytes =
  blake3(bytes_concat_all([domain(), b"\x00run\x00", executes]))

// --- Tests ------------------------------------------------------------------
//
// A key is the only thing standing between two eras of a proof, so it is pinned whole: the bytes
// every obligation cache already written holds.

fn a_hash() -> Bytes / {abort.raise} =
  bytes_of_hex("1111111111111111111111111111111111111111111111111111111111111111")

fn sevens() -> Bytes / {abort.raise} =
  bytes_of_hex("0707070707070707070707070707070707070707070707070707070707070707")

test "a key is the layout's tag, what the proof rests on, and the hash of it" {
  assert_eq(
    hex_of(claim_key(a_hash())),
    "bfde86cbb3dd5ddb8ae2ed0cdc6672f85f7294558c608ecd1bcd292c9a118eb0",
  );
  assert_eq(
    hex_of(run_key(a_hash())),
    "292c86811496ff6d2b44ba37fc35344456006707317f1b2300e21ee03e2e4ba4",
  )
}

test "a claim's two keys are apart, from each other and from its hash, and separate claims" {
  assert(claim_key(a_hash()) != run_key(a_hash()));
  assert(claim_key(a_hash()) != a_hash());
  assert(run_key(a_hash()) != a_hash());
  assert(claim_key(a_hash()) != claim_key(sevens()));
  assert(run_key(a_hash()) != run_key(sevens()))
}
