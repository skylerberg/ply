// `keys` — what an obligation's result is filed under.
//
// A discharge weaker than a proof is only evidence *about the plan that produced it*: a sample drawn
// with one root set, case count and budget says nothing about another. So the result is filed under a
// key that folds the whole plan in, and a proof — which covers every case — is the only tier that may
// sit under the obligation's own key. That single rule is why an entry can be read back at all: the
// reader recomputes the key, and an entry under the wrong one is a refusal rather than a mistake.
//
// The plan's own digest is here too, because the two must agree: the runtime digests a plan to
// decide what a *test* is keyed on, and an obligation's key folds that digest in. The simulation's
// digest is an input rather than a re-derivation — it is the test package's own encoding, and one
// place should own it.

import std.bytes (bytes_of_hex, hex_of, u32_le, u64_le)
import std.hash (blake3)

// The domain tag for a plan-keyed result, so it cannot collide with the obligation's own key.
pub fn plan_domain() -> Bytes = b"ply.prove.key.1"

// The domain tag for a plan's own digest.
pub fn digest_domain() -> Bytes = b"ply.prove.plan.1"

// The digest of everything that makes a discharge the one it is: the cases, the budgets, the roots,
// and the simulation the cases were drawn from. `sim_digest` is the runtime's own digest of that
// plan, which the test package computes for the search a seeded test is keyed on.
pub fn plan_digest(
  cases: Int,
  prove_budget: Int,
  step_budget: Int,
  roots: List<Int>,
  sim_digest: Bytes,
) -> Bytes =
  blake3(
    bytes_concat_all([
      digest_domain(),
      u32_le(cases),
      u32_le(prove_budget),
      i64_le(step_budget),
      u32_le(len(roots)),
      bytes_concat_all(map(roots, u64_le)),
      sim_digest,
    ]),
  )

// The key everything weaker than a proof is filed under.
pub fn prove_key(key: Bytes, plan_digest: Bytes) -> Bytes =
  blake3(bytes_concat_all([plan_domain(), key, plan_digest]))

/// The key a result at this tier is filed under. Only a proof sits under the obligation's own key.
pub fn result_key(key: Bytes, proved: Bool, plan_digest: Bytes) -> Bytes =
  if proved { key } else { prove_key(key, plan_digest) }

// An `i64` little-endian: the step budget is signed, and `u64_le` takes an `Int` the same way for
// every value either way, so the two halves are built directly.
fn i64_le(n: Int) -> Bytes =
  bytes_concat(bytes_slice(u32_le(n), 0, 4), bytes_slice(u32_le(n >> 32), 0, 4))

// --- Tests ------------------------------------------------------------------
//
// The expectations are the runtime's own keys for one fixed plan, printed from a scratch run against
// it. A key is the only thing standing between two eras of a proof, so it is pinned whole.

fn a_hash() -> Bytes =
  bytes_of_hex("1111111111111111111111111111111111111111111111111111111111111111")

fn sim() -> Bytes = bytes_of_hex("3fd52dde1cf3697764f69bc85a2f911e96beccbee26bd7961190b298f4694469")

fn the_plan() -> Bytes = plan_digest(200, 10000, 1000000000, [0], sim())

test "a plan's digest is the fields the runtime digests, in its order" {
  assert_eq(hex_of(the_plan()), "9ed1cdc7058a8c37ab8a26b8058dfaef51440f94f29b3c57d33074ab9bc118a0")
}

test "a key is the domain, the obligation, and the plan it was discharged under" {
  assert_eq(
    hex_of(prove_key(a_hash(), the_plan())),
    "d0a5aa5c92cc239f36b4a2fcf96ba09d0eceb86dd501ebef8e341825c1d0a16d",
  )
}

test "only a proof sits under the obligation's own key" {
  assert_eq(hex_of(result_key(a_hash(), true, the_plan())), hex_of(a_hash()));
  // A sample — any tier but a proof — is filed under the plan's key instead.
  assert_eq(
    hex_of(result_key(a_hash(), false, the_plan())),
    "d0a5aa5c92cc239f36b4a2fcf96ba09d0eceb86dd501ebef8e341825c1d0a16d",
  )
}

test "a moved plan moves the key" {
  let other = plan_digest(200, 10000, 1000000000, [0, 1], sim());
  assert_eq(hex_of(other) == hex_of(the_plan()), false);
  assert_eq(hex_of(prove_key(a_hash(), other)) == hex_of(prove_key(a_hash(), the_plan())), false)
}
