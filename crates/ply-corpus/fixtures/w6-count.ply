// The service as a program a launcher runs: one connection per request, with a handler for the
// network rather than a socket under it, so `--count-allocs` and the clock describe the served path
// itself. Appended where the service's own `main` begins — the rung program has its own entry.

// What this entry performs once the network is handled here.
effect set Counting = {config.get[server], trace.enter[http], trace.exit[http], trace.event[http], trace.enter[orders], trace.exit[orders], trace.event[orders], trace.count[orders], trace.event[items]}

/// How many connections the service is asked to serve, from the run's own configuration.
fn requests_asked() -> Int / {config.get[server]} =
  match config.get[server]("W6_REQUESTS") {
    Some(text) -> match router::int_of_text(text) {
      Some(n) -> if n > 0 { n } else { 1 },
      None -> 200,
    },
    None -> 200,
  }

/// The service, driven: one connection at a time, one request on each, and the script the harness's
/// `SimNet` plays — a canned request in, and the answer counted on its way out.
fn served_as_a_program() -> Int / {Counting} = {
  let asked = requests_asked();
  with_cell[waiting](asked) { left -> {
    with_cell[answered](0) { done -> {
      with_cell[serving](0) { open -> {
        handle {
          run_memory(0, None, asked)
        } with {
          net.listen[listener](port) -> 7,
          net.accept[listener](l) -> {
            cell_set(left, cell_get(left) - 1);
            if cell_get(left) < 0 { 0 } else { 100 + cell_get(left) }
          },
          // One request on each connection, then end of stream: a handler that answered every read
          // would let the service's keep-alive loop serve its whole budget on the first connection,
          // and the count would be of a run twice over rather than of a request.
          net.recv[conn](c, max, t) -> if cell_get(open) == c { Some(b"") } else {
            cell_set(open, c);
            Some(w6_head())
          },
          net.send[conn](c, payload, t) -> {
            cell_set(done, cell_get(done) + 1);
            Some(bytes_len(payload))
          },
          net.close[conn](c) -> (),
          net.listen_tls[listener](port, credential) -> 8,
          net.close[listener](l) -> (),
        };
        cell_get(done)
      } }
    } }
  } }
}

fn main() -> Int / {Counting} = served_as_a_program()
