// Where one request's time goes, a layer at a time, in one process: framing, routing, a derived
// encoder and the response bytes through the language's own libraries, the four together, and then
// the whole request through `std.http`'s serve loop with the network answered by handler clauses.
// The request and the route table have the desk's shapes; nothing here reaches a socket.
//
// It times itself and prints one JSON object: for each layer, the microseconds each of `repeats`
// rounds of `iterations` calls took. `BENCH_ITERATIONS` and `BENCH_REPEATS` are its settings.

import std.config
import std.config (config)
import std.http
import std.json
import std.json (Json)
import std.net (net)
import std.process (process)
import std.router
import std.time (time)

// --- The request, the table and the endpoint ----------------------------------------------

fn head() -> Bytes = b"GET /health HTTP/1.1\r\nHost: 127.0.0.1\r\n\r\n"

pub type Endpoint =
  | Health
  | Ready
  | Docs
  | ListItems
  | Featured
  | GetItem
  | ListOrders
  | PlaceOrder
  | GetOrder
  | CancelOrder
  | Receipt

pub type Pattern = { method: http::Method, pattern: String, endpoint: Endpoint }

fn get(pattern: String, e: Endpoint) -> Pattern =
  { method: http::Get, pattern: pattern, endpoint: e }

fn patterns() -> List<Pattern> =
  [
    get("/health", Health),
    get("/ready", Ready),
    get("/docs/{..page}", Docs),
    get("/items", ListItems),
    get("/items/featured", Featured),
    get("/items/{sku}", GetItem),
    get("/orders", ListOrders),
    { method: http::Post, pattern: "/orders", endpoint: PlaceOrder },
    get("/orders/{id:Int}", GetOrder),
    { method: http::Delete, pattern: "/orders/{id:Int}", endpoint: CancelOrder },
    get("/orders/{id:Int}/receipt", Receipt),
  ]

fn table_of(ps: List<Pattern>) -> List<router::Route<Endpoint>> / {abort.raise} =
  map(ps, |p: Pattern|
    { method: p.method, path: router::pattern_of_string(p.pattern), endpoint: p.endpoint })

// Nullary, as the desk's is, so a request pays for it what a request to the desk pays.
fn table() -> List<router::Route<Endpoint>> / {abort.raise} = table_of(patterns())

pub type Health = { service: String, routes: Int }

derive json for Health

fn json_response(body: Bytes) -> http::Response =
  {
    status: 200,
    headers: map_of_entries([{ key: "content-type", value: ["application/json"] }]),
    body: body,
  }

fn health(routes: Int) -> http::Response / {abort.raise} =
  json_response(json::encode_bytes({ service: "parts desk", routes: routes }, health_json()))

fn respond(method: http::Method, path: String) -> http::Response / {abort.raise} =
  match router::route(table(), method, path) {
    router::Found(m) -> match m.endpoint {
      Health -> health(len(table())),
      _ -> http::text_response(501, "this bench serves /health\n"),
    },
    router::NotFound -> http::text_response(404, "no such route\n"),
    router::MethodNotAllowed(ms) -> http::method_not_allowed(ms),
  }

// The request, answered with no socket: framing, routing, the endpoint and the response bytes.
fn answered(raw: Bytes, l: http::Limits) -> Bytes / {abort.raise} =
  match http::parse_head(raw, l) {
    http::Parsed(h) ->
      http::encode(
        h.request.method,
        h.request.version,
        h.keep_alive,
        respond(h.request.method, h.request.path),
      ),
    _ -> b"",
  }

// One connection through `std.http`'s serve loop: the request read, answered and written, the next
// read the peer's close, and every `net` operation answered by a clause here.
fn handled(raw: Bytes, l: http::Limits) -> Int / {abort.raise} =
  with_cell[wire](0) { sent -> {
    with_cell[heard](false) { read -> {
      handle {
        http::serve_connection[conn](7, l, |req: http::Request| respond(req.method, req.path))
      } with {
        net.recv[conn](c, max, timeout_ms) -> if cell_get(read) { Some(b"") } else {
          cell_set(read, true);
          Some(raw)
        },
        net.send[conn](c, payload, timeout_ms) -> {
          cell_set(sent, cell_get(sent) + bytes_len(payload));
          Some(bytes_len(payload))
        },
        net.close[conn](c) -> (),
      };
      cell_get(sent)
    } }
  } }

// --- The clock --------------------------------------------------------------------------

// `n` calls of `body`, each result folded into the next so none is dead.
fn spin<| e>(left: Int, acc: Int, body: (Int) -> Int / e) -> Int / e =
  if left <= 0 { acc } else { spin(left - 1, acc + body(left), body) }

fn timed<| e>(n: Int, body: (Int) -> Int / e) -> Int / {time.elapsed_us | e} = {
  let started = time.elapsed_us();
  let _ = observe(spin(n, 0, body));
  time.elapsed_us() - started
}

pub type Layer = { name: String, what: String, runs_us: List<Int> }

fn layer<| e>(
  name: String,
  what: String,
  n: Int,
  repeats: Int,
  body: (Int) -> Int / e,
) -> Layer / {time.elapsed_us | e} =
  { name: name, what: what, runs_us: map(range(0, repeats), |_r: Int| timed(n, body)) }

fn layers(n: Int, repeats: Int) -> List<Layer> / {time.elapsed_us, abort.raise} = {
  let l = http::default_limits();
  let raw = head();
  let built = table();
  let response = health(len(built));
  [
    layer("loop", "the timing loop and nothing in it", n, repeats, |i: Int| observe(i)),
    layer("frame", "one head parsed: request line, fields, host, framing", n, repeats, |i: Int|
      match http::parse_head(observe(raw), l) { http::Parsed(h) -> h.consumed, _ -> 0 }),
    layer("table", "the eleven routes built from their pattern strings", n, repeats, |i: Int|
      len(table_of(observe(patterns())))),
    layer("route", "one path matched against the built table", n, repeats, |i: Int|
      match router::route(observe(built), http::Get, "/health") { router::Found(_) -> 1, _ -> 0 }),
    layer("endpoint", "a record through a derived JSON encoder", n, repeats, |i: Int|
      bytes_len(health(len(observe(built))).body)),
    layer(
      "encode",
      "the response bytes: status line, fields, length, body",
      n,
      repeats,
      |i: Int| bytes_len(http::encode(http::Get, http::Http11, true, observe(response))),
    ),
    layer(
      "answer",
      "the four together, as a request with no socket pays them",
      n,
      repeats,
      |i: Int| bytes_len(answered(observe(raw), l)),
    ),
    layer(
      "handled",
      "the whole request through std.http's serve loop, each net operation a handler clause",
      n,
      repeats,
      |i: Int| handled(observe(raw), l),
    ),
  ]
}

// --- The report ------------------------------------------------------------------------

fn number(n: Int) -> Json = json::Number(decimal_of_int(n))

pub fn report(n: Int, repeats: Int, ls: List<Layer>) -> Json =
  json::object([
    { key: "iterations", value: number(n) },
    { key: "repeats", value: number(repeats) },
    {
      key: "layers",
      value: json::array(
        map(ls, |one: Layer|
          json::object([
            { key: "name", value: json::Str(one.name) },
            { key: "what", value: json::Str(one.what) },
            { key: "runs_us", value: json::array(map(one.runs_us, |us: Int| number(us))) },
          ])),
      ),
    },
  ])

fn setting(key: String, fallback: Int) -> Int / {config.get[bench], abort.raise} =
  match config.get[bench](key) {
    None -> fallback,
    Some(text) -> match router::int_of_text(text) {
      Some(n) -> if n > 0 { n } else { fallback },
      None -> panic(key ++ " is `" ++ text ++ "`, which is not a number"),
    },
  }

fn main() -> Unit / {config.get[bench], time.elapsed_us, process.out[proc], abort.raise} = {
  let n = setting("BENCH_ITERATIONS", 2000);
  let repeats = setting("BENCH_REPEATS", 3);
  process.out[proc](json::to_string(report(n, repeats, layers(n, repeats))))
}

// --- Tests ---------------------------------------------------------------------------------

test "the request is answered 200 whether a socket is under it or not" {
  let l = http::default_limits();
  let bytes = answered(head(), l);
  assert(bytes_starts_with(bytes, b"HTTP/1.1 200 OK\r\n"));
  assert(bytes_index_of(bytes, b"{\"routes\":11,\"service\":\"parts desk\"}") != None);
  assert_eq(handled(head(), l), bytes_len(bytes))
}

test "every pattern is a route, and the table is the desk's size" {
  assert_eq(len(table()), 11);
  assert_eq(router::conflicts(table()), [])
}

test "the report carries each layer's rounds under its name" {
  let written = json::to_string(
    report(10, 2, [{ name: "frame", what: "a head", runs_us: [7, 5] }]),
  );
  assert(string_contains(written, "\"iterations\":10"));
  assert(string_contains(written, "\"name\":\"frame\""));
  assert(string_contains(written, "\"runs_us\":[7,5]"))
}
