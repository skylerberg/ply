//! `std.template` beside the modules it writes for: an HTML template's filling read back by
//! `std.xml`, a reader that shares nothing with the one that wrote it, and a filling handed to the
//! `html"..."` tag as a program writes one. `std.template` imports no XML reader, so these stand
//! here, beside the program that runs the standard library's own.

import std.html
import std.html (Hostile, Html, hostile_text, text)
import std.template
import std.template (Template)
import std.xml
import std.xml (Element)

/// A page with a value in every place one may stand: an element's content, an attribute's value
/// quoted either way and unquoted, a URL's path and its query, a `textarea`, and a loop's passes.
fn page() -> Template / {abort.raise} =
  match template::parse_html(
      "<div class=\"{{ a }}\" title='{{ b }}'><p id={{ c }}>{{ a }}</p><a href=\"/x/{{ b }}?q={{ c }}\">{{ b }}<br/></a><textarea>{{ c }}</textarea>{{ for x in xs }}<i lang=\"{{ x }}\">{{ x }}</i>{{ end }}</div>",
    ) {
    Ok(t) -> t,
    Err(r) -> panic(template::explain(r.why)),
  }

/// The text of `h` that an XML document may hold as it is: without its controls, which XML has
/// no way to write, a tab and a line end among them, which an attribute's value reads as blanks.
fn written(h: Hostile) -> String =
  string_of_chars(filter(string_chars(hostile_text(h)), |c: Char| int_of_char(c) >= 32))

fn part(at: html::UrlPart, value: String) -> String / {abort.raise} =
  match html::url_value(at, value, false) {
    Ok(url) -> url,
    Err(scheme) -> panic("a value past a URL's start named the scheme " ++ scheme),
  }

/// The element `page` is written to be over these values, built with no template.
fn meant(a: String, b: String, c: String) -> Element / {abort.raise} = {
  let named = |name: String, value: String| xml::attr(xml::name(name), value);
  let item = |x: String|
    xml::Element(xml::element(xml::name("i"), [named("lang", x)], xml::chars(x)));
  xml::element(xml::name("div"), [named("class", a), named("title", b)], [
    xml::Element(xml::element(xml::name("p"), [named("id", c)], xml::chars(a))),
    xml::Element(
      xml::element(
        xml::name("a"),
        [named("href", "/x/" ++ part(html::Path, b) ++ "?q=" ++ part(html::Query, c))],
        push(xml::chars(b), xml::Element(xml::element(xml::name("br"), [], []))),
      ),
    ),
    xml::Element(xml::element(xml::name("textarea"), [], xml::chars(c))),
    item(a),
    item(b),
  ])
}

fn filled(a: String, b: String, c: String) -> Result<String, template::Failure> / {abort.raise} =
  template::render(
    page(),
    reflect({ a: a, b: b, c: c, xs: [a, b] }),
    map_new(),
    template::default_limits(),
  )

law "a page's filling holds the elements and attributes its template wrote, and each value whole"
  forall (a: Hostile, b: Hostile, c: Hostile) {
    match filled(written(a), written(b), written(c)) {
      Err(_) -> false,
      Ok(document) -> match xml::parse(bytes_of_string(document), xml::default_limits()) {
        Err(_) -> false,
        Ok(read) -> read.root == meant(written(a), written(b), written(c)),
      },
    }
  }

test "a value that is markup to a reader is one element's text and one attribute's value" {
  let attack = "\"'></p></div><script>alert(1)</script><p onmouseover=\"x";
  assert_eq(
    match filled(attack, "' onclick='go()", "x y=z") {
      Ok(document) -> xml::parse(bytes_of_string(document), xml::default_limits()),
      Err(f) -> panic(template::explain(f.why)),
    },
    Ok(xml::document(meant(attack, "' onclick='go()", "x y=z"))),
  )
}

fn row(name: String) -> Html / {abort.raise} =
  match template::parse_html("<li>{{ name }}</li>") {
    Err(r) -> panic(template::explain(r.why)),
    Ok(t) -> match template::render_html(
        t,
        reflect({ name: name }),
        map_new(),
        template::default_limits(),
      ) {
      Ok(markup) -> markup,
      Err(f) -> panic(template::explain(f.why)),
    },
  }

fn list(kind: String, names: List<String>) -> Html / {abort.raise} =
  html"<ul class={text(kind)}>{html::fragment(map(names, row))}</ul>"

test "what a template fills is markup to the tag, and what the tag writes is markup to a template" {
  let names = list("k\"", ["a<b", "c"]);
  assert_eq(html::render(names), "<ul class=\"k&quot;\"><li>a&lt;b</li><li>c</li></ul>");
  let around = match template::parse_html("<main title=\"{{ title }}\">{{ body }}</main>") {
    Ok(t) -> t,
    Err(r) -> panic(template::explain(r.why)),
  };
  assert_eq(
    template::render(
      around,
      reflect({ title: "<ul>", body: names }),
      map_new(),
      template::default_limits(),
    ),
    Ok("<main title=\"&lt;ul&gt;\"><ul class=\"k&quot;\"><li>a&lt;b</li><li>c</li></ul></main>"),
  );
  // The same text handed over as a `String` is characters.
  assert_eq(
    template::render(
      around,
      reflect({ title: "t", body: html::render(names) }),
      map_new(),
      template::default_limits(),
    ),
    Ok(
      "<main title=\"t\">&lt;ul class=&quot;k&amp;quot;&quot;&gt;&lt;li&gt;a&amp;lt;b&lt;/li&gt;&lt;li&gt;c&lt;/li&gt;&lt;/ul&gt;</main>",
    ),
  )
}
