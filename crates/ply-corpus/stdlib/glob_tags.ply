//! `std.glob`'s tag written in source. A module cannot write its own tag, so the test that does
//! stands here, beside the program that runs the standard library's own.

import std.glob
import std.glob (base, matches)

test "a pattern written in source is compiled when the program is checked" {
  let sources = glob"src/**/*.{{ply,md}}";
  assert(matches(sources, "src/lib/main.ply"));
  assert(matches(sources, "src/README.md"));
  assert(!matches(sources, "src/.cache/main.ply"));
  assert_eq(base(sources), "src");
  assert(matches(glob"a\\*b", "a*b"))
}
