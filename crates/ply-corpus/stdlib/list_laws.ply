//! The laws `std.list` is held to. They stand here, beside the program that runs the standard
//! library's own, for two reasons. A program that imports `std.list` reads the module whole, so
//! what the module holds is what every such load pays for. And a bound that holds a logarithm is
//! written with `std.math`'s `ilog2`, while `std.math` imports `std.string`, which imports
//! `std.list`.

import std.laws (agrees, idempotent, inverse, monoid)
import std.list (all, any, at, at_or, binary_search, chunk_by, chunks, concat, contains, count,
                 dedup, drop, drop_last, drop_while, enumerate, filter_map, find, find_index,
                 find_last, find_map, first, flat_map, flatten, fold_right, index_of, interleave,
                 intersperse, is_empty, is_sorted, last, last_index_of, max_by, max_of, min_by,
                 min_of, pairwise, partition, partition_point, prepend, push_unique, remove_at,
                 remove_first, replicate, reverse, rotate, scan, slice, somes, sort, sort_by,
                 sort_by_key, span, split_at, take, take_last, take_while, transpose, unique, unzip,
                 windows, zip, zip_strict, zip_with)
import std.math (ilog2)

/// A list and a number, which a law draws together.
type Cut = { xs: List<Int>, n: Int }

/// Two lists, which a law draws together.
type Two = { xs: List<Int>, ys: List<Int> }

fn small(x: Int) -> Bool = x % 4 != 0

fn parity(x: Int) -> Int = x & 1

fn halved(x: Int) -> Option<Int> = if x % 2 == 0 { Some(x / 2) } else { None }

fn doubled(x: Int) -> List<Int> = [x, x ^ 1]

/// A count a law may hand to a function that makes that many of something.
fn few(n: Int) -> Int = n & 7

/// The even elements in order and then the odd ones: what a stable sort by `parity` answers.
fn evens_first(xs: List<Int>) -> List<Int> =
  concat(filter(xs, |x: Int| parity(x) == 0), filter(xs, |x: Int| parity(x) == 1))

law "the last element is the first of the list reversed" =
  agrees(|xs: List<Int>| last(xs), |xs: List<Int>| first(reverse(xs)))

law "at answers what the list holds at an index, and at_or the spare elsewhere" =
  agrees(
    |c: Cut|
      {
        at: handle { Some(at(c.xs, few(c.n))) } with { abort.raise(_) -> None },
        at_or: at_or(c.xs, few(c.n), 0 - 1),
      },
    |c: Cut|
      {
        at: list_at(c.xs, few(c.n)),
        at_or: match list_at(c.xs, few(c.n)) { Some(x) -> x, None -> 0 - 1 },
      },
  )

law "what take takes and drop drops make the list" =
  agrees(|c: Cut| concat(take(c.xs, c.n), drop(c.xs, c.n)), |c: Cut| c.xs)

law "what drop_last drops and take_last takes make the list" =
  agrees(|c: Cut| concat(drop_last(c.xs, c.n), take_last(c.xs, c.n)), |c: Cut| c.xs)

law "the last elements are the first of the list reversed" =
  agrees(|c: Cut| take_last(c.xs, c.n), |c: Cut| reverse(take(reverse(c.xs), c.n)))

law "a slice is what is left of a take after a drop" =
  agrees(|c: Cut| slice(c.xs, few(c.n) - 2, c.n >> 8 & 15), |c: Cut|
    drop(take(c.xs, c.n >> 8 & 15), few(c.n) - 2))

law "split_at answers take and drop" =
  agrees(|c: Cut| split_at(c.xs, c.n), |c: Cut| { head: take(c.xs, c.n), tail: drop(c.xs, c.n) })

law "the prefix take_while keeps and what drop_while leaves make the list" =
  agrees(|xs: List<Int>| concat(take_while(xs, small), drop_while(xs, small)), |xs: List<Int>| xs)

law "span answers take_while and drop_while" =
  agrees(|xs: List<Int>| span(xs, small), |xs: List<Int>|
    { prefix: take_while(xs, small), rest: drop_while(xs, small) })

law "take_while keeps only what holds, and drop_while starts at what does not"
  forall (xs: List<Int>) {
    all(take_while(xs, small), small)
      && (match first(drop_while(xs, small)) { Some(x) -> !small(x), None -> true })
  }

law "reversing twice is the list" =
  inverse(|xs: List<Int>| reverse(xs), |xs: List<Int>| reverse(xs))

law "a join reversed is the reversed halves the other way round" =
  agrees(|t: Two| reverse(concat(t.xs, t.ys)), |t: Two| concat(reverse(t.ys), reverse(t.xs)))

law "turning a list back leaves it as it was" =
  agrees(|c: Cut| rotate(rotate(c.xs, c.n % 100), 0 - c.n % 100), |c: Cut| c.xs)

law "a turn within the list is its drop and then its take"
  forall (c: Cut) {
    let n = few(c.n) % (len(c.xs) + 1);
    rotate(c.xs, n) == concat(drop(c.xs, n), take(c.xs, n))
  }

law "concat is a monoid over the empty list" =
  monoid(|xs: List<Int>, ys: List<Int>| concat(xs, ys), [])

law "flat_map is the map and then the flatten" =
  agrees(|xs: List<Int>| flat_map(xs, doubled), |xs: List<Int>| flatten(map(xs, doubled)))

law "the chunks of a list flatten back to it" =
  agrees(|c: Cut| flatten(chunks(c.xs, few(c.n) + 1)), |c: Cut| c.xs)

law "every chunk but the last is full, and the last is not empty"
  forall (c: Cut) {
    let n = few(c.n) + 1;
    let groups = chunks(c.xs, n);
    all(drop_last(groups, 1), |group: List<Int>| len(group) == n)
      && all(groups, |group: List<Int>| len(group) > 0 && len(group) <= n)
  }

law "unzip gives back what zip paired" =
  agrees(|t: Two| unzip(zip(t.xs, t.ys)), |t: Two|
    {
      firsts: take(t.xs, min(len(t.xs), len(t.ys))),
      seconds: take(t.ys, min(len(t.xs), len(t.ys))),
    })

law "zip_with is the map over the zip" =
  agrees(|t: Two| zip_with(t.xs, t.ys, |x: Int, y: Int| x ^ y), |t: Two|
    map(zip(t.xs, t.ys), |p: { first: Int, second: Int }| p.first ^ p.second))

law "the strict zip answers the zip for two lists of one length, and nothing for others" =
  agrees(
    |t: Two|
      {
        same: zip_strict(t.xs, map(t.xs, parity)),
        longer: zip_strict(t.xs, push(t.xs, 0)),
        any: zip_strict(t.xs, t.ys) != None,
      },
    |t: Two|
      { same: Some(zip(t.xs, map(t.xs, parity))), longer: None, any: len(t.xs) == len(t.ys) },
  )

law "enumerate zips the positions with the elements" =
  agrees(|xs: List<Int>| enumerate(xs), |xs: List<Int>|
    zip_with(range(0, len(xs)), xs, |i: Int, x: Int| { index: i, value: x }))

law "pairwise zips a list with itself one place on" =
  agrees(|xs: List<Int>| pairwise(xs), |xs: List<Int>| zip(xs, drop(xs, 1)))

law "the windows of two are the pairs" =
  agrees(|xs: List<Int>| windows(xs, 2), |xs: List<Int>|
    map(pairwise(xs), |p: { first: Int, second: Int }| [p.first, p.second]))

law "a window is the slice at its position, and there is one for each place it fits"
  forall (c: Cut) {
    let n = few(c.n) + 1;
    let found = windows(c.xs, n);
    len(found) == max(len(c.xs) - n + 1, 0)
      && all(enumerate(found), |w: { index: Int, value: List<Int> }|
        w.value == slice(c.xs, w.index, w.index + n))
  }

law "two lists transposed are their zip" =
  agrees(|t: Two| transpose([t.xs, t.ys]), |t: Two|
    map(zip(t.xs, t.ys), |p: { first: Int, second: Int }| [p.first, p.second]))

law "a grid transposed twice is the grid"
  forall (c: Cut) {
    let width = few(c.n) + 1;
    let grid = chunks(drop_last(c.xs, len(c.xs) % width), width);
    transpose(transpose(grid)) == grid
  }

law "replicate makes the count asked of the one element"
  forall (c: Cut) {
    let made = replicate(c.n, few(c.n) - 2);
    len(made) == max(few(c.n) - 2, 0) && all(made, |x: Int| x == c.n)
  }

law "something holds exactly when not everything fails" =
  agrees(|xs: List<Int>| any(xs, small), |xs: List<Int>| !all(xs, |x: Int| !small(x)))

law "count is how many filter keeps, and any is a count above zero" =
  agrees(|xs: List<Int>| { count: count(xs, small), any: any(xs, small) }, |xs: List<Int>|
    { count: len(filter(xs, small)), any: count(xs, small) > 0 })

law "find answers the first that filter keeps, and find_last the last" =
  agrees(|xs: List<Int>| { first: find(xs, small), last: find_last(xs, small) }, |xs: List<Int>|
    { first: first(filter(xs, small)), last: last(filter(xs, small)) })

law "find_index answers where find found"
  forall (xs: List<Int>) {
    match find_index(xs, small) {
      Some(i) -> list_at(xs, i) == find(xs, small) && !any(take(xs, i), small),
      None -> find(xs, small) == None,
    }
  }

law "find_map answers the first that filter_map keeps" =
  agrees(|xs: List<Int>| find_map(xs, halved), |xs: List<Int>| first(filter_map(xs, halved)))

law "filter_map is the map and then its somes" =
  agrees(|xs: List<Int>| filter_map(xs, halved), |xs: List<Int>| somes(map(xs, halved)))

law "the somes of a list are what filter_map keeps of it unchanged" =
  agrees(|os: List<Option<Int>>| somes(os), |os: List<Option<Int>>|
    filter_map(os, |o: Option<Int>| o))

law "an element is contained exactly where index_of finds it" =
  agrees(|c: Cut| contains(c.xs, parity(c.n)), |c: Cut| index_of(c.xs, parity(c.n)) != None)

law "index_of is the first index that holds the element, and last_index_of the last"
  forall (c: Cut) {
    let bits = map(c.xs, parity);
    let x = parity(c.n);
    index_of(bits, x) == find_index(bits, |y: Int| y == x)
      && last_index_of(bits, x)
      == (match index_of(reverse(bits), x) { Some(i) -> Some(len(bits) - 1 - i), None -> None })
  }

law "remove_at is what comes before the index and what comes after it" =
  agrees(|c: Cut| remove_at(c.xs, few(c.n) - 2), |c: Cut|
    concat(take(c.xs, few(c.n) - 2), drop(c.xs, few(c.n) - 1)))

law "remove_first takes out the element where index_of finds it" =
  agrees(|c: Cut| remove_first(map(c.xs, parity), parity(c.n)), |c: Cut|
    match index_of(map(c.xs, parity), parity(c.n)) {
      Some(i) -> Some(remove_at(map(c.xs, parity), i)),
      None -> None,
    })

law "remove_first leaves one fewer of the element, or answers nothing where there was none"
  forall (c: Cut) {
    let bits = map(c.xs, parity);
    let same = |y: Int| y == parity(c.n);
    match remove_first(bits, parity(c.n)) {
      Some(rest) -> len(rest) + 1 == len(bits) && count(rest, same) + 1 == count(bits, same),
      None -> !contains(bits, parity(c.n)),
    }
  }

law "push_unique holds the element after, and a second push changes nothing"
  forall (c: Cut) {
    let once = push_unique(c.xs, c.n);
    contains(once, c.n) && push_unique(once, c.n) == once
      && len(once) == len(c.xs) + (if contains(c.xs, c.n) { 0 } else { 1 })
  }

law "a list is empty exactly when it has no first element" =
  agrees(|xs: List<Int>| is_empty(xs), |xs: List<Int>| first(xs) == None)

law "prepend is the join onto a list of the one element" =
  agrees(|c: Cut| prepend(c.n, c.xs), |c: Cut| concat([c.n], c.xs))

law "scan answers the fold of every prefix, so its last is the fold"
  forall (c: Cut) {
    let sums = scan(c.xs, c.n, |acc: Int, x: Int| acc ^ x);
    len(sums) == len(c.xs)
      && last(sums)
      == (if is_empty(c.xs) { None } else { Some(fold(c.xs, c.n, |acc: Int, x: Int| acc ^ x)) })
      && take(sums, few(c.n)) == scan(take(c.xs, few(c.n)), c.n, |acc: Int, x: Int| acc ^ x)
  }

law "a fold from the right is the fold of the list reversed" =
  agrees(|c: Cut| fold_right(c.xs, c.n, |x: Int, acc: Int| acc *% 31 ^ x), |c: Cut|
    fold(reverse(c.xs), c.n, |acc: Int, x: Int| acc *% 31 ^ x))

law "a fold from the right that appends reverses" =
  agrees(
    |xs: List<Int>| fold_right(xs, [], |x: Int, acc: List<Int>| push(acc, x)),
    |xs: List<Int>| reverse(xs),
  )

law "the extremes are the ends of the sorted list" =
  agrees(|xs: List<Int>| { least: min_of(xs), greatest: max_of(xs) }, |xs: List<Int>|
    { least: first(sort(xs)), greatest: last(sort(xs)) })

law "min_by answers the first of the list sorted by the key" =
  agrees(|xs: List<Int>| min_by(xs, parity), |xs: List<Int>| first(sort_by_key(xs, parity)))

law "max_by answers the first of the list sorted by the key, greatest first" =
  agrees(|xs: List<Int>| max_by(xs, parity), |xs: List<Int>|
    first(sort_by(xs, |x: Int, y: Int| parity(x) >= parity(y))))

law "the extreme by the element itself is the extreme" =
  agrees(
    |xs: List<Int>| { least: min_by(xs, |x: Int| x), greatest: max_by(xs, |x: Int| x) },
    |xs: List<Int>| { least: min_of(xs), greatest: max_of(xs) },
  )

law "a list is sorted exactly when sorting leaves it as it is" =
  agrees(|xs: List<Int>| is_sorted(xs), |xs: List<Int>| sort(xs) == xs)

law "sorting twice is sorting once" = idempotent(|xs: List<Int>| sort(xs))

law "a sort answers the same for a list and the list reversed, and is as long" =
  agrees(|xs: List<Int>| { sorted: sort(reverse(xs)), length: len(sort(xs)) }, |xs: List<Int>|
    { sorted: sort(xs), length: len(xs) })

law "sort_by under the order of the elements is sort" =
  agrees(|xs: List<Int>| sort_by(xs, |x: Int, y: Int| x <= y), |xs: List<Int>| sort(xs))

law "sort_by keeps the order of what it does not order, whether it calls equals before each other or not" =
  agrees(
    |xs: List<Int>|
      {
        strict: sort_by(xs, |x: Int, y: Int| parity(x) < parity(y)),
        loose: sort_by(xs, |x: Int, y: Int| parity(x) <= parity(y)),
      },
    |xs: List<Int>| { strict: evens_first(xs), loose: evens_first(xs) },
  )

law "sort_by_key is the stable sort by the order of the keys" =
  agrees(|xs: List<Int>| sort_by_key(xs, parity), |xs: List<Int>|
    sort_by(xs, |x: Int, y: Int| parity(x) < parity(y)))

law "a partition point of a sorted list is how many elements come before" =
  agrees(|c: Cut| partition_point(sort(c.xs), |x: Int| x < c.n), |c: Cut|
    count(c.xs, |x: Int| x < c.n))

law "a partition point of any list is a place where it turns"
  forall (xs: List<Int>) {
    let point = partition_point(xs, small);
    (match list_at(xs, point - 1) { Some(x) -> small(x), None -> point == 0 })
      && (match list_at(xs, point) { Some(x) -> !small(x), None -> point == len(xs) })
  }

law "a binary search of any list answers an index of the element, or one within the list"
  forall (c: Cut) {
    let bits = map(c.xs, parity);
    match binary_search(bits, |x: Int| compare(x, parity(c.n))) {
      Ok(i) -> list_at(bits, i) == Some(parity(c.n)),
      Err(i) -> i >= 0 && i <= len(bits) && list_at(bits, i) != Some(parity(c.n)),
    }
  }

law "a binary search of a sorted list finds the first index of the element, or where it goes" =
  agrees(
    |c: Cut| {
      let sorted = sort(map(c.xs, few));
      binary_search(sorted, |x: Int| compare(x, few(c.n)))
    },
    |c: Cut| {
      let sorted = sort(map(c.xs, few));
      match index_of(sorted, few(c.n)) {
        Some(i) -> Ok(i),
        None -> Err(count(sorted, |x: Int| x < few(c.n))),
      }
    },
  )

law "partition answers what filter keeps and what it leaves" =
  agrees(|xs: List<Int>| partition(xs, small), |xs: List<Int>|
    { yes: filter(xs, small), no: filter(xs, |x: Int| !small(x)) })

law "the runs of chunk_by flatten back to the list" =
  agrees(|xs: List<Int>| flatten(chunk_by(xs, parity)), |xs: List<Int>| xs)

law "a run of chunk_by is of one key, and its neighbour of another"
  forall (xs: List<Int>) {
    let runs = chunk_by(xs, parity);
    let keys = filter_map(runs, |run: List<Int>| first(map(run, parity)));
    all(runs, |run: List<Int>| len(run) > 0 && len(dedup(map(run, parity))) == 1)
      && dedup(keys) == keys
  }

law "dedup answers the first of each run of equals" =
  agrees(|xs: List<Int>| dedup(map(xs, parity)), |xs: List<Int>|
    filter_map(chunk_by(map(xs, parity), |x: Int| x), |run: List<Int>| first(run)))

law "a second dedup removes nothing" = idempotent(|xs: List<Int>| dedup(map(xs, parity)))

law "a second unique removes nothing" = idempotent(|xs: List<Int>| unique(xs))

law "unique keeps one of each element, which sorted is the sorted list without its repeats" =
  agrees(|xs: List<Int>| sort(unique(map(xs, few))), |xs: List<Int>| dedup(sort(map(xs, few))))

law "intersperse is the separator after each element but the last" =
  agrees(|c: Cut| intersperse(c.xs, c.n), |c: Cut| drop_last(flat_map(c.xs, |x: Int| [x, c.n]), 1))

law "interleave is the pairs of a zip laid flat, then what the longer list has left" =
  agrees(|t: Two| interleave(t.xs, t.ys), |t: Two|
    concat(
      flat_map(zip(t.xs, t.ys), |p: { first: Int, second: Int }| [p.first, p.second]),
      concat(drop(t.xs, len(t.ys)), drop(t.ys, len(t.xs))),
    ))

law "a cut takes steps in the elements it keeps"
  forall (n: Int) where n > 0 cost n {
    {
      dropped: drop(range(0, 2 * n), n),
      last: drop_last(range(0, 2 * n), n),
      sliced: slice(range(0, 3 * n), n, 2 * n),
    }
  }

law "replicate takes steps in its count" forall (n: Int) where n > 0 cost n { replicate(0, n) }

law "joining lists takes steps in the elements joined"
  forall (n: Int) where n > 0 cost n {
    flatten(chunks(range(0, n), 4))
  }

law "a flat_map takes steps in the elements it answers"
  forall (n: Int) where n > 0 cost n {
    flat_map(range(0, n), doubled)
  }

law "the windows of a width take steps in the length"
  forall (n: Int) where n > 0 cost n {
    windows(range(0, n), 3)
  }

law "transposing rows of a width takes steps in their number"
  forall (n: Int) where n > 0 cost n {
    transpose(chunks(range(0, n), 4))
  }

law "transposing two rows takes steps in their length"
  forall (n: Int) where n > 0 cost n {
    transpose([range(0, n), range(0, n)])
  }

/// The numbers below `n`, each once, in no order.
fn scattered(n: Int) -> List<Int> / {abort.raise} = map(range(0, n), |i: Int| i * 7919 % n)

law "a sort takes the length times its logarithm"
  forall (n: Int) where n > 1 cost n * ilog2(n) {
    sort(scattered(n))
  }

law "a sort by an order takes the length times its logarithm, whether the order is strict or not"
  forall (n: Int) where n > 1 cost n * ilog2(n) {
    {
      strict: sort_by(scattered(n), |x: Int, y: Int| x < y),
      loose: sort_by(scattered(n), |x: Int, y: Int| x <= y),
    }
  }

law "a sort by a key takes the length times its logarithm"
  forall (n: Int) where n > 1 cost n * ilog2(n) {
    sort_by_key(scattered(n), |x: Int| n - x)
  }

law "a sort of a list in order takes the length times its logarithm"
  forall (n: Int) where n > 1 cost n * ilog2(n) {
    { ascending: sort(range(0, n)), by_key: sort_by_key(range(0, n), |x: Int| n - x) }
  }

law "a partition point takes the logarithm of the length"
  forall (n: Int) where n > 1 cost ilog2(n) {
    partition_point(range(0, n), |x: Int| x < n / 3)
  }

law "a binary search takes the logarithm of the length, for an element the list holds or lacks"
  forall (n: Int) where n > 1 cost ilog2(n) {
    {
      held: binary_search(range(0, n), |x: Int| compare(x, n / 3)),
      lacked: binary_search(range(0, n), |x: Int| compare(2 * x, 2 * (n / 3) + 1)),
    }
  }
