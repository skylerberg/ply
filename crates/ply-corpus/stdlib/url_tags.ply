//! `std.url`'s tag written in source. A module cannot write its own tag, so the test that does
//! stands here, beside the program that runs the standard library's own.

import std.ip
import std.url
import std.url (Name, Url, V6, url_host, url_join, url_normalized, url_param, url_port_or_default,
                url_render, url_scheme)

fn api() -> Url = url"https://API.example.com/v1/items?page=2#top"

test "a URL written in source is the value its text writes" {
  assert_eq(url_render(api()), "https://API.example.com/v1/items?page=2#top");
  assert_eq(url_scheme(api()), "https");
  assert_eq(url_host(api()), Some(Name("api.example.com")));
  assert_eq(url_port_or_default(api()), Some(443));
  assert_eq(url_param(api(), "page"), Some("2"));
  assert_eq(url_join(api(), "../users?id=7"), Ok(url"https://API.example.com/users?id=7"));
  assert_eq(url_normalized(url"HTTP://Example.COM:80/a/../b"), url"http://example.com/b");
  assert_eq(f"{url"https://alice:s3cret@example.com/"}", "https://alice:xxxxx@example.com/");
  assert_eq(
    match url_host(url"http://[::FFFF:127.0.0.1]:8080/") {
      Some(V6(six)) -> ip::is_loopback_v6(six),
      _ -> false,
    },
    true,
  )
}
