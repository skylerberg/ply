//! `std.segment` against `GraphemeBreakTest.txt` and `WordBreakTest.txt`, the database's
//! conformance tests of UAX #29: every line of each, a hundred or so lines to a case, cut where
//! the line says and nowhere else.

import std.list (concat)
import std.segment
import std.width
import ucd_files
import ucd_files (Block, hex, spelled, text, trimmed)

/// A line of a test: a text, and the places in it where the line marks a boundary.
type Line = { text: String, boundaries: List<Int> }

/// The code points read so far and the boundaries marked among them.
type Marked = { points: List<Int>, at: List<Int> }

/// Every line of a break test: code points with `÷` where a boundary falls and `×` where none
/// does.
fn lines(file: Bytes) -> List<Line> / {abort.raise} =
  fold(bytes_split(file, b"\n"), [], |found: List<Line>, line: Bytes| {
    let data = trimmed(match bytes_index_of_byte(line, b'#') {
      Some(i) -> bytes_slice(line, 0, i),
      None -> line,
    });
    if bytes_len(data) == 0 { found } else {
      let marked = fold(
        bytes_split(data, b" "),
        { points: [], at: [] },
        |m: Marked, token: Bytes|
          if token == b"\xc3\xb7" { { points: m.points, at: push(m.at, len(m.points)) } }
          else if token == b"\xc3\x97" || bytes_len(token) == 0 { m }
          else { { points: push(m.points, hex(token)), at: m.at } },
      );
      push(found, { text: text(marked.points), boundaries: marked.at })
    }
  })

fn blocks(file: Bytes) -> List<Block<Line>> / {abort.raise} =
  ucd_files::blocks(lines(file), 128, |l: Line| spelled(l.text))

test "the {len(b.lines)} lines of GraphemeBreakTest.txt from {b.from} are cut into clusters where they say" for b: Block<Line> in blocks(
    ucd_files::grapheme_break_test(),
  ) {
  let wrong = filter(b.lines, |l: Line| segment::grapheme_boundaries(l.text) != l.boundaries);
  assert_eq(map(wrong, |l: Line| spelled(l.text)), [])
}

test "the {len(b.lines)} lines of WordBreakTest.txt from {b.from} are cut into words where they say" for b: Block<Line> in blocks(
    ucd_files::word_break_test(),
  ) {
  let wrong = filter(b.lines, |l: Line| segment::word_boundaries(l.text) != l.boundaries);
  assert_eq(map(wrong, |l: Line| spelled(l.text)), [])
}

test "the segments of each text of the two tests join to it, each cluster is one alone, and the text is as wide as its clusters" {
  let joined = |segments: List<String>| fold(segments, "", |all: String, s: String| all ++ s);
  let wrong = filter(
    concat(lines(ucd_files::grapheme_break_test()), lines(ucd_files::word_break_test())),
    |l: Line| {
      let clusters = segment::graphemes(l.text);
      joined(clusters) != l.text || joined(segment::split_words(l.text)) != l.text
        || len(filter(clusters, |cluster: String| segment::grapheme_count(cluster) != 1)) > 0
        || width::columns(l.text)
        != fold(clusters, 0, |sum: Int, cluster: String| sum + width::cluster_columns(cluster))
    },
  );
  assert_eq(map(wrong, |l: Line| spelled(l.text)), [])
}
