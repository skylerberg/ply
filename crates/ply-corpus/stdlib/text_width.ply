//! `std.text` laid out by `std.width`'s columns, which is the measure a caller hands it where a
//! text may hold wide or combining characters. `std.text` counts a column a character unless it
//! is handed one, since the compiler imports it and would carry `std.width`'s tables.

import std.text
import std.text (Measure)
import std.width

fn columns() -> Measure = Some(|c: Char| width::char_columns(c))

test "a width is a terminal's columns: two for an ideograph or an emoji, none for a combining mark" {
  assert_eq(text::width("\u{4E2D}\u{6587} ok", columns()), 7);
  assert_eq(text::width("\u{4E2D}\u{6587} ok"), 5);
  assert_eq(text::width("e\u{301}te\u{301}", columns()), 3);
  assert_eq(text::width("\u{1F600}!", columns()), 3);
  assert_eq(text::width("\u{FF21}\u{FF22}", columns()), 4);
  assert_eq(text::width("plain", columns()), 5)
}

test "prose of ideographs and emoji wraps where its columns run out, not where its characters do" {
  let cjk = "\u{4E2D}\u{6587} \u{4E2D}\u{6587} \u{4E2D}\u{6587}";
  assert_eq(text::wrap(cjk, 9, measure: columns()), [
    "\u{4E2D}\u{6587} \u{4E2D}\u{6587}",
    "\u{4E2D}\u{6587}",
  ]);
  assert_eq(text::wrap(cjk, 9), [cjk]);
  assert_eq(text::wrap(cjk, 5, measure: columns()), [
    "\u{4E2D}\u{6587}",
    "\u{4E2D}\u{6587}",
    "\u{4E2D}\u{6587}",
  ]);
  let faces = "\u{1F600} \u{1F601} \u{1F602} ok";
  assert_eq(text::wrap(faces, 5, measure: columns()), ["\u{1F600} \u{1F601}", "\u{1F602} ok"]);
  assert_eq(text::wrap(faces, 8), ["\u{1F600} \u{1F601} \u{1F602} ok"]);
  assert_eq(text::wrap("cafe\u{301} cre\u{300}me", 10, measure: columns()), [
    "cafe\u{301} cre\u{300}me",
  ]);
  assert_eq(text::wrap("cafe\u{301} cre\u{300}me", 10), ["cafe\u{301}", "cre\u{300}me"])
}

test "a cell is padded to its columns" {
  assert_eq(text::aligned("\u{4E2D}", 4, measure: columns()), "\u{4E2D}  ");
  assert_eq(text::aligned("\u{4E2D}", 4), "\u{4E2D}   ")
}

// The measure is asked a character at a time; `width::columns` measures a text by its clusters.
test "an emoji written as a sequence is counted as its parts by a measure of characters" {
  let thumb = "\u{1F44D}\u{1F3FD}";
  assert_eq(text::width(thumb, columns()), 4);
  assert_eq(width::columns(thumb), 2)
}
