//! `std.xml`'s literal as a program writes it. A module cannot name its own tag, so the tests that
//! write `xml"..."` stand here, beside the program that runs the standard library's own.

import std.xml
import std.xml (Compact, Element, Text, chars)

fn link(url: String, label: String, tags: List<String>) -> Element =
  xml"<a href={chars(url)} class='tag {chars(label)}'>{chars(label)}<ul>{map(tags, |t: String| Element(xml"<li>{chars(t)}</li>"))}</ul></a>"

fn feed() -> Element = xml"<feed xmlns='http://www.w3.org/2005/Atom'><title>t</title></feed>"

test "a literal with holes is the element its text and values make" {
  assert_eq(
    xml::encode(xml::document(link("/q?a=1&b=\"2\"", "<b>", ["x", "y & z"])), Compact),
    Ok(
      b"<a href=\"/q?a=1&amp;b=&quot;2&quot;\" class=\"tag &lt;b>\">&lt;b&gt;<ul><li>x</li><li>y &amp; z</li></ul></a>",
    ),
  );
  assert_eq(link("u", "", []), xml"<a href='u' class='tag '><ul/></a>")
}

test "a literal with no hole is its element, namespaces resolved" {
  assert_eq(feed().name, xml::qualified("http://www.w3.org/2005/Atom", "feed"));
  assert_eq(xml::children(feed(), xml::qualified("http://www.w3.org/2005/Atom", "title")), [
    xml"<a:title xmlns:a='http://www.w3.org/2005/Atom'>t</a:title>",
  ]);
  assert_eq(xml::text(feed()), "t");
  assert_eq(
    xml"<a>1 &lt; 2<![CDATA[ & ]]></a>",
    xml::element(xml::name("a"), [], [Text("1 < 2 & ")]),
  )
}
