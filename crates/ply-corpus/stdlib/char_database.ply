//! `std.char` against the Unicode Character Database's own files, over every code point there is:
//! the published files `ucd_files` reads, asked here what they say of each code point, so a table
//! that was made wrong, of another version or read wrong answers unlike them.

import std.bytes (int_of_ascii)
import std.char
import std.list (at)
import std.ucd
import ucd_files
import ucd_files (Row, Stretch, hex, rows_under, unicode_data, unlike)

/// What the database says of a code point: its category, the decimal digit it is, and how far
/// its three case mappings lie from it.
type Said = { category: String, digit: Option<Int>, upper: Int, lower: Int, title: Int }

/// How far the mapping a field of `UnicodeData.txt` names lies from `cp`: nowhere where it is empty.
fn away(field: Bytes, cp: Int) -> Int / {abort.raise} =
  if bytes_len(field) == 0 { 0 } else { hex(field) - cp }

fn said(row: Row) -> Stretch<Said> / {abort.raise} =
  {
    first: row.first,
    last: row.last,
    said: {
      category: string_of_bytes(at(row.fields, 2)),
      digit: int_of_ascii(at(row.fields, 6)),
      upper: away(at(row.fields, 12), row.last),
      lower: away(at(row.fields, 13), row.last),
      title: away(at(row.fields, 14), row.last),
    },
  }

/// What the database says of a code point it lists nowhere.
fn unlisted() -> Said = { category: "Cn", digit: None, upper: 0, lower: 0, title: 0 }

/// Whether `std.char` answers for the code point `cp` as `said` does. A surrogate is no `Char`,
/// so there is nothing to ask of one.
fn answers(cp: Int, said: Said) -> Bool =
  match char::of_code_point(cp) {
    None -> said.category == "Cs",
    Some(c) ->
      char::abbreviation(char::general_category(c)) == said.category
        && char::decimal_value(c) == said.digit
        && char::code_point(char::to_uppercase(c)) == cp + said.upper
        && char::code_point(char::to_lowercase(c)) == cp + said.lower
        && char::code_point(char::to_titlecase(c)) == cp + said.title,
  }

test "every code point has the category, decimal digit and case mappings UnicodeData.txt gives it" {
  let wrong = unlike(map(unicode_data(), said), |cp: Int, listed: Option<Said>|
    answers(cp, match listed { Some(s) -> s, None -> unlisted() }));
  assert_eq(wrong, [])
}

/// A property a file of the database lists the code points of, and the predicate that is it.
type Property = { file: Bytes, holds: (Char) -> Bool }

fn property(name: String) -> Property / {abort.raise} = {
  let core = ucd_files::derived_core_properties();
  match name {
    "Alphabetic" -> { file: core, holds: char::is_alphabetic },
    "Lowercase" -> { file: core, holds: char::is_lowercase },
    "Uppercase" -> { file: core, holds: char::is_uppercase },
    "XID_Start" -> { file: core, holds: char::is_xid_start },
    "XID_Continue" -> { file: core, holds: char::is_xid_continue },
    "White_Space" -> { file: ucd_files::prop_list(), holds: char::is_whitespace },
    _ -> panic(f"no predicate is {name}"),
  }
}

test "{name} holds of the code points the database lists for it and of no other" for name: String in [
    "Alphabetic",
    "Lowercase",
    "Uppercase",
    "White_Space",
    "XID_Start",
    "XID_Continue",
  ] {
  let p = property(name);
  let rows = map(rows_under(p.file, [name]), |row: Row|
    { first: row.first, last: row.last, said: () });
  assert(len(rows) > 0);
  // A surrogate is no `Char`, so there is nothing to ask of one.
  let wrong = unlike(rows, |cp: Int, listed: Option<Unit>|
    match char::of_code_point(cp) { Some(c) -> (p.holds)(c) == (listed != None), None -> true });
  assert_eq(wrong, [])
}

test "the files are the database's of the version std.ucd names" {
  let v = ucd::version();
  let version = f"{v.major}.{v.minor}.{v.update}";
  assert_eq(ucd_files::version_of(ucd_files::derived_core_properties()), version);
  assert_eq(ucd_files::version_of(ucd_files::prop_list()), version)
}
