//! `std.otlp` and `std.prometheus` held to what the reference implementations write and read.
//!
//! `telemetry/traces.bin` and `telemetry/metrics.bin` are the requests `traces` and `metrics`
//! below are, as the `opentelemetry-proto` Python package (1.45.0, over protobuf 7.36.2)
//! serializes them. `traces.json` and `metrics.json` are those requests in OTLP's JSON, as
//! OpenTelemetry Collector 0.162.0 took them at `/v1/traces` and `/v1/metrics` and printed back
//! field for field. `page.txt` is `registry` in the text format, which `promtool check metrics`
//! (Prometheus 3.15.0) and `prometheus_client` 0.26.0 read, and `page.om` in OpenMetrics, which
//! that package's OpenMetrics parser read.

import std.otlp
import std.otlp (AnyValue, Metrics, Span, Traces)
import std.prometheus
import std.prometheus (Registry)
import std.traceparent
import std.traceparent (SpanId, TraceId)

fn trace_of(hex: String) -> TraceId / {abort.raise} =
  match traceparent::trace_id_of_hex(hex) { Some(id) -> id, None -> panic("a trace id") }

fn span_named(hex: String) -> SpanId / {abort.raise} =
  match traceparent::span_id_of_hex(hex) { Some(id) -> id, None -> panic("a span id") }

fn shop() -> otlp::Resource =
  {
    attributes: [
      otlp::attribute("service.name", otlp::StringValue("shop")),
      otlp::attribute("service.instance.id", otlp::StringValue("shop-7")),
    ],
    dropped_attributes: 1u32,
  }

/// A request of two spans that between them set every field the model has.
pub fn traces() -> Traces / {abort.raise} = {
  let server: Span = {
    trace_id: trace_of("0af7651916cd43dd8448eb211c80319c"),
    span_id: span_named("b7ad6b7169203331"),
    trace_state: "congo=t61rcWkgMzE,rojo=00f067aa0ba902b7",
    parent: Some(span_named("00f067aa0ba902b7")),
    flags: 769u32,
    name: "POST /orders",
    kind: otlp::Server,
    start: 1700000000000000000u64,
    end: 1700000000250000000u64,
    attributes: [
      otlp::attribute("http.request.method", otlp::StringValue("POST")),
      otlp::attribute("http.response.status_code", otlp::IntValue(503)),
      otlp::attribute("retried", otlp::BoolValue(true)),
      otlp::attribute("load", otlp::DoubleValue(0.75)),
      otlp::attribute("digest", otlp::BytesValue(b"\x00\x01\xfe\xff")),
      otlp::attribute(
        "skus",
        otlp::ArrayValue([otlp::StringValue("BOLT-1"), otlp::IntValue(-7), otlp::NoValue]),
      ),
      otlp::attribute(
        "peer",
        otlp::KvlistValue([
          otlp::attribute("zone", otlp::StringValue("eu")),
          otlp::attribute("weights", otlp::ArrayValue([otlp::DoubleValue(1.5)])),
        ]),
      ),
      otlp::attribute("unset", otlp::NoValue),
    ],
    dropped_attributes: 2u32,
    events: [
      {
        time: 1700000000100000000u64,
        name: "retry",
        attributes: [otlp::attribute("attempt", otlp::IntValue(2))],
        dropped_attributes: 3u32,
      },
      { time: 0u64, name: "", attributes: [], dropped_attributes: 0u32 },
    ],
    dropped_events: 4u32,
    links: [
      {
        trace_id: trace_of("4bf92f3577b34da6a3ce929d0e0e4736"),
        span_id: span_named("00f067aa0ba902b7"),
        trace_state: "rojo=1",
        attributes: [otlp::attribute("why", otlp::StringValue("batch"))],
        dropped_attributes: 5u32,
        flags: 1u32,
      },
    ],
    dropped_links: 6u32,
    status: { code: otlp::StatusError, message: "upstream timed out" },
  };
  let internal: Span = {
    trace_id: trace_of("0af7651916cd43dd8448eb211c80319c"),
    span_id: span_named("00f067aa0ba902b8"),
    trace_state: "",
    parent: None,
    flags: 0u32,
    name: "",
    kind: otlp::Unspecified,
    start: 0u64,
    end: 18446744073709551615u64,
    attributes: [],
    dropped_attributes: 0u32,
    events: [],
    dropped_events: 0u32,
    links: [],
    dropped_links: 0u32,
    status: { code: otlp::StatusOk, message: "" },
  };
  {
    resource_spans: [
      {
        resource: shop(),
        scope_spans: [
          {
            scope: {
              name: "http",
              version: "1.2.3",
              attributes: [otlp::attribute("lib", otlp::StringValue("std.http"))],
              dropped_attributes: 7u32,
            },
            spans: [server],
            schema_url: "https://opentelemetry.io/schemas/1.37.0",
          },
          { scope: otlp::scope(""), spans: [internal], schema_url: "" },
        ],
        schema_url: "https://opentelemetry.io/schemas/1.37.0",
      },
    ],
  }
}

/// A request holding a sum, a gauge and a histogram, with a point of each number kind.
pub fn metrics() -> Metrics =
  {
    resource_metrics: [
      {
        resource: shop(),
        scope_metrics: [
          {
            scope: otlp::scope("orders"),
            metrics: [
              {
                name: "orders.placed",
                description: "Orders taken.",
                unit: "{order}",
                data: otlp::Sum(
                  [
                    {
                      attributes: [otlp::attribute("sku", otlp::StringValue("BOLT-1"))],
                      start: 1700000000000000000u64,
                      time: 1700000060000000000u64,
                      value: otlp::AsInt(7),
                    },
                    {
                      attributes: [],
                      start: 0u64,
                      time: 1700000060000000000u64,
                      value: otlp::AsInt(0),
                    },
                  ],
                  otlp::Cumulative,
                  true,
                ),
              },
              {
                name: "stock.delta",
                description: "",
                unit: "",
                data: otlp::Sum(
                  [{ attributes: [], start: 0u64, time: 1u64, value: otlp::AsDouble(-2.5) }],
                  otlp::Delta,
                  false,
                ),
              },
              {
                name: "shelf.level",
                description: "",
                unit: "1",
                data: otlp::Gauge([
                  {
                    attributes: [],
                    start: 0u64,
                    time: 1700000060000000000u64,
                    value: otlp::AsDouble(41.75),
                  },
                  {
                    attributes: [],
                    start: 0u64,
                    time: 1700000060000000000u64,
                    value: otlp::AsDouble(0.0),
                  },
                ]),
              },
              { name: "empty", description: "", unit: "", data: otlp::Gauge([]) },
              {
                name: "http.server.request.duration",
                description: "How long a request took.",
                unit: "s",
                data: otlp::Histogram(
                  [
                    {
                      attributes: [
                        otlp::attribute("http.request.method", otlp::StringValue("POST")),
                      ],
                      start: 1700000000000000000u64,
                      time: 1700000060000000000u64,
                      count: 6u64,
                      sum: Some(3.25),
                      bucket_counts: [1u64, 0u64, 3u64, 2u64],
                      explicit_bounds: [0.005, 0.1, 1.0],
                      min: Some(0.001),
                      max: Some(2.0),
                    },
                    {
                      attributes: [],
                      start: 0u64,
                      time: 0u64,
                      count: 0u64,
                      sum: Some(0.0),
                      bucket_counts: [],
                      explicit_bounds: [],
                      min: None,
                      max: None,
                    },
                  ],
                  otlp::Delta,
                ),
              },
            ],
            schema_url: "",
          },
        ],
        schema_url: "",
      },
    ],
  }

fn sku(value: String) -> prometheus::Labels =
  prometheus::labels([prometheus::pair(prometheus::label_like("sku"), value)])

fn seen(value: Float) -> Option<prometheus::Exemplar> =
  Some({
    labels: prometheus::labels([
      prometheus::pair(prometheus::label_like("trace_id"), "0af7651916cd43dd8448eb211c80319c"),
      prometheus::pair(prometheus::label_like("span_id"), "b7ad6b7169203331"),
    ]),
    value: value,
  })

/// A registry with a counter, a gauge and a histogram, a help and a label value that need every
/// escape, a unit and two exemplars.
pub fn registry() -> Registry = {
  let described = prometheus::describe(
    prometheus::describe(
      prometheus::describe(
        prometheus::registry(100),
        prometheus::name_like("shop_orders"),
        prometheus::Counter,
        "Orders \"placed\", by sku.\nA \\ is a backslash.",
        "",
      ),
      prometheus::name_like("shop_request_duration_seconds"),
      prometheus::Histogram,
      "How long a request took.",
      "seconds",
    ),
    prometheus::name_like("shop_shelf_level"),
    prometheus::Gauge,
    "What is left on the shelf.",
    "",
  );
  let bounded = prometheus::with_bounds(
    described,
    prometheus::name_like("shop_request_duration_seconds"),
    [0.005, 0.1, 1.0, 2500000.0],
  );
  let counted = prometheus::add(
    prometheus::add_with(
      prometheus::add(bounded, prometheus::name_like("shop_orders"), sku("BOLT-1"), 2.0),
      prometheus::name_like("shop_orders"),
      sku("BOLT-1"),
      1.0,
      seen(1.0),
    ),
    prometheus::name_like("shop_orders"),
    sku("a\"b\\c\nd"),
    1234567.0,
  );
  let levelled = prometheus::set(
    prometheus::set(counted, prometheus::name_like("shop_shelf_level"), sku("BOLT-1"), 41.75),
    prometheus::name_like("shop_shelf_level"),
    prometheus::no_labels(),
    -0.00002,
  );
  fold([0.001, 0.05, 0.5, 0.75, 30.0], levelled, |r: Registry, seconds: Float|
    prometheus::observe_with(
      r,
      prometheus::name_like("shop_request_duration_seconds"),
      sku("BOLT-1"),
      seconds,
      if seconds == 0.5 { seen(0.5) } else { None },
    ))
}

// --- Tests ------------------------------------------------------------------

test "std.otlp writes the bytes the reference encoder writes, and reads them as the request" {
  assert_eq(otlp::encode_traces(otlp::Protobuf, traces()), embed("telemetry/traces.bin"));
  assert_eq(otlp::encode_metrics(otlp::Protobuf, metrics()), embed("telemetry/metrics.bin"));
  assert_eq(
    otlp::decode_traces(otlp::Protobuf, embed("telemetry/traces.bin"), otlp::default_limits()),
    Ok(traces()),
  );
  assert_eq(
    otlp::decode_metrics(otlp::Protobuf, embed("telemetry/metrics.bin"), otlp::default_limits()),
    Ok(metrics()),
  )
}

test "std.otlp writes the JSON a collector took, and reads it as the request" {
  assert_eq(otlp::encode_traces(otlp::Json, traces()), embed("telemetry/traces.json"));
  assert_eq(otlp::encode_metrics(otlp::Json, metrics()), embed("telemetry/metrics.json"));
  assert_eq(
    otlp::decode_traces(otlp::Json, embed("telemetry/traces.json"), otlp::default_limits()),
    Ok(traces()),
  );
  assert_eq(
    otlp::decode_metrics(otlp::Json, embed("telemetry/metrics.json"), otlp::default_limits()),
    Ok(metrics()),
  )
}

test "std.prometheus writes the pages the reference parsers read, and reads them as the registry" {
  let held = prometheus::snapshot(registry());
  assert_eq(prometheus::render_text(held), embed("telemetry/page.txt"));
  assert_eq(prometheus::render_openmetrics(held), embed("telemetry/page.om"));
  assert_eq(prometheus::parse(embed("telemetry/page.om"), prometheus::default_limits()), Ok(held));
  assert_eq(
    prometheus::parse(embed("telemetry/page.txt"), prometheus::default_limits()),
    Ok(prometheus::plain(held)),
  )
}
