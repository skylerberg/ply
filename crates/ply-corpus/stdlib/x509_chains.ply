fn checked(
  leaf: Certificate,
  offered: List<Certificate>,
  anchors: List<Certificate>,
  at: Instant,
  who: String,
) -> Result<List<Certificate>, { leaf: Bool, why: Fault }> / {abort.raise} =
  match x509::verify(leaf, offered, anchors, at, identity(who), x509::ServerAuth, x509::strict()) {
    Ok(path) -> Ok(path),
    Err(failure) -> Err({ leaf: failure.certificate == leaf, why: failure.why }),
  }

test "{w.file} verifies for {w.who} to the root {w.root} alone, as of its capture" for w: Way in ways(
  ) {
  let s = served(w.file);
  let anchor = filter(roots(), |r: Certificate| root_name(r) == w.root);
  assert_eq(len(anchor), 1);
  match checked(s.leaf, s.rest, anchor, captured(), w.who) {
    Ok(path) -> {
      assert_eq(map(path, shape), w.path);
      assert_eq(list_at(path, 0), Some(s.leaf));
      assert_eq(last(path), list_at(anchor, 0))
    },
    Err(refused) -> panic(show(refused.why)),
  }
}

fn forger() -> crypto::SigningKey / {abort.raise} =
  match crypto::ed25519_signing(secret_of_bytes(repeat(b"\x07", 32))) {
    Some(key) -> key,
    None -> panic("thirty-two bytes are a seed"),
  }

fn called(name: String) -> List<x509::Attribute> = [{ id: oid::common_name(), value: name }]

/// A certificate for `bank.example` that says `leaf` issued it, over `leaf`'s own validity.
fn forged(leaf: Certificate) -> Certificate / {abort.raise} = {
  let asked = {
    ..x509::draft(),
    subject: called("bank.example"),
    alt_names: [x509::Dns("bank.example")],
    usages: [x509::DigitalSignature],
    purposes: [x509::server_auth()],
  };
  let made = try {
    x509::certificate(
      asked,
      crypto::verifying_key(forger()),
      b"\x01",
      x509::info(leaf).not_before,
      x509::info(leaf).not_after,
      Some(leaf),
      forger(),
    )
  };
  match made { Ok(c) -> c, Err(refusal) -> panic(show(refusal)) }
}

test "{s.file} verifies for {s.who}, and is refused once expired, for {s.other}, without its issuer, and as a CA" for s: Site in sites(
  ) {
  let c = served(s.file);
  let anchors = roots();
  assert_eq(result_err(checked(c.leaf, c.rest, anchors, captured(), s.who)), None);
  let after = match date::instant(x509::info(c.leaf).not_after) {
    Some(end) -> Instant(nanos_at(end) + 1000000000),
    None -> panic("an instant"),
  };
  assert_eq(
    result_err(checked(c.leaf, c.rest, anchors, after, s.who)),
    Some({ leaf: true, why: x509::Expired }),
  );
  assert_eq(
    result_err(checked(c.leaf, c.rest, anchors, captured(), s.other)),
    Some({ leaf: true, why: x509::Unnamed }),
  );
  let orphaned = filter(c.rest, |above: Certificate|
    x509::info(above).subject != x509::info(c.leaf).issuer);
  assert(len(orphaned) < len(c.rest));
  assert_eq(
    result_err(checked(c.leaf, orphaned, anchors, captured(), s.who)),
    Some({ leaf: true, why: x509::Unissued }),
  );
  let bank = forged(c.leaf);
  match x509::verify(
      bank,
      concat([c.leaf], c.rest),
      anchors,
      captured(),
      x509::Host("bank.example"),
      x509::ServerAuth,
      x509::strict(),
    ) {
    Ok(_) -> panic("a leaf signed as a CA"),
    Err(failure) -> {
      assert(failure.certificate == c.leaf);
      assert_eq(failure.why, x509::NotACa)
    },
  }
}

test "an address a certificate names is matched as an address, and never as a host written like one" {
  let cloudflare = served("ip-cloudflare-dns.pem");
  let google = served("ip-google-dns.pem");
  let anchors = roots();
  let named = |c: Served, who: x509::Identity| x509::names(c.leaf, who);
  assert(named(cloudflare, identity("1.0.0.1")) && named(cloudflare, identity("1.1.1.1")));
  assert(named(google, identity("8.8.4.4")) && named(google, identity("2001:4860:4860::8888")));
  assert(!named(cloudflare, x509::Host("1.1.1.1")) && !named(google, x509::Host("8.8.8.8")));
  assert(!named(cloudflare, identity("8.8.8.8")) && !named(google, identity("1.1.1.1")));
  assert_eq(
    result_err(checked(google.leaf, google.rest, anchors, captured(), "dns.google.example")),
    Some({ leaf: true, why: x509::Unnamed }),
  )
}

test "a host in another script is the A-labels its certificate names, and a wildcard is one label of them" {
  let muenchen = served("idn-muenchen.pem").leaf;
  let buecher = served("idn-buecher.pem").leaf;
  assert_eq(x509::alt_names(muenchen), [
    x509::Dns("www.xn--mnchen-3ya.de"),
    x509::Dns("xn--mnchen-3ya.de"),
  ]);
  assert_eq(x509::alt_names(buecher), [
    x509::Dns("*.xn--bcher-kva.de"),
    x509::Dns("xn--bcher-kva.de"),
  ]);
  let named = |c: Certificate, host: String| x509::names(c, x509::Host(host));
  assert(named(muenchen, "münchen.de") && named(muenchen, "WWW.MÜNCHEN.DE"));
  assert(named(muenchen, "xn--mnchen-3ya.de") && !named(muenchen, "mail.münchen.de"));
  assert(named(buecher, "bücher.de") && named(buecher, "shop.bücher.de"));
  assert(!named(buecher, "a.shop.bücher.de") && !named(buecher, "bucher.de"))
}

type Unread = { name: String, why: x509::Refusal }

fn unread(files: List<File>) -> List<Unread> / {abort.raise} =
  flat_map(files, |f: File|
    match read_all(f, x509::Strict) { Ok(_) -> [], Err(why) -> [{ name: f.name, why: why }] })

test "what was served reads to the letter of RFC 5280, and every root but the one numbered zero" {
  assert_eq(unread(chain_files()), []);
  assert_eq(unread(root_files()), [{ name: "568d6905a2c88708.pem", why: x509::BadSerial }]);
  assert_eq(
    map(
      flat_map(filter(root_files(), |f: File| f.name == "568d6905a2c88708.pem"), certificates),
      |c: Certificate| x509::info(c).serial,
    ),
    [b"\x00"],
  )
}

test "every chain is a site here, and every root is one a chain ends at" {
  assert_eq(map(chain_files(), |f: File| f.name), sort(map(sites(), |s: Site| s.file)));
  assert_eq(unique(sort(map(ways(), |w: Way| w.file))), sort(map(sites(), |s: Site| s.file)));
  assert_eq(
    map(root_files(), |f: File| f.name),
    unique(sort(map(ways(), |w: Way| w.root ++ ".pem"))),
  );
  assert_eq(map(roots(), root_name), map(root_files(), |f: File| strip_suffix(f.name, ".pem")))
}
