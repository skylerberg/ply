//! `std.x509` against what real sites served. Under `x509/chains` a file is one site's answer, the
//! leaf and then what came with it in the order it came, as the wire had them at `captured()`;
//! under `x509/roots` are the roots those end at, out of one system's store, each named by the
//! first eight bytes of its fingerprint. A shipped module embeds no file, so these stand here.
//!
//! No site's key is held, so what a leaf is made to sign below is signed by a key made here: the
//! verifier refuses it before any signature is looked at, which is the point.

import std.bytes (hex_of, repeat)
import std.crypto
import std.crypto (Sha256, Sha384, Sha512)
import std.date
import std.ip
import std.list (concat, flat_map, last, sort, unique)
import std.oid
import std.result (result_err)
import std.show (show)
import std.string (strip_suffix)
import std.time (nanos_at)
import std.x509
import std.x509 (x509, Certificate, Fault)

type File = { name: String, bytes: Bytes }

fn chain_files() -> List<File> = embed_dir("x509/chains")

fn root_files() -> List<File> = embed_dir("x509/roots")

/// When the chains were served: each is verified as of then, whatever the day the test runs.
fn captured() -> Instant / {abort.raise} =
  match date::parse_rfc3339("2026-10-06T14:54:16+00:00") {
    Some(t) -> match date::instant(t) { Some(i) -> i, None -> panic("an instant") },
    None -> panic("a time"),
  }

fn read_all(
  file: File,
  mode: x509::Reading,
) -> Result<List<Certificate>, x509::Refusal> / {abort.raise} =
  try { x509::read_pem(string_of_bytes(file.bytes), x509::limits(), mode) }

fn certificates(file: File) -> List<Certificate> / {abort.raise} =
  match read_all(file, x509::Tolerant) {
    Ok(found) -> found,
    Err(refusal) -> panic(f"{file.name}: {show(refusal)}"),
  }

fn root_name(c: Certificate) -> String / {abort.raise} =
  hex_of(bytes_slice(x509::fingerprint(c), 0, 8))

fn roots() -> List<Certificate> / {abort.raise} = flat_map(root_files(), certificates)

type Served = { leaf: Certificate, rest: List<Certificate> }

fn served(file: String) -> Served / {abort.raise} =
  match flat_map(filter(chain_files(), |f: File| f.name == file), certificates) {
    [leaf, ..rest] -> { leaf: leaf, rest: rest },
    [] -> panic(f"no chain {file}"),
  }

/// A host, or an address where the text is one.
fn identity(who: String) -> x509::Identity / {abort.raise} =
  match ip::parse(who) { Ok(address) -> x509::At(address), Err(_) -> x509::Host(who) }

fn digest_text(d: crypto::Digest) -> String =
  match d { Sha256 -> "SHA-256", Sha384 -> "SHA-384", Sha512 -> "SHA-512" }

/// A certificate's key and how the certificate is signed.
fn shape(c: Certificate) -> String = {
  let key = match x509::info(c).key {
    x509::RsaKey(public) -> match crypto::rsa_modulus_bits(public) {
      Some(bits) -> f"RSA {bits}",
      None -> "RSA",
    },
    x509::EcKey(_, point) -> if bytes_len(point) == 65 { "P-256" }
    else if bytes_len(point) == 97 { "P-384" }
    else { "a curve" },
    x509::Ed25519Key(_) -> "Ed25519",
    x509::OtherKey(id, _) -> oid::to_string(id),
  };
  let signed = match x509::info(c).algorithm {
    x509::RsaPkcs1(d) -> "RSA " ++ digest_text(d),
    x509::RsaPss(d) -> "RSA-PSS " ++ digest_text(d),
    x509::Ecdsa(d) -> "ECDSA " ++ digest_text(d),
    x509::Ed25519 -> "Ed25519",
    x509::OtherAlgorithm(id) -> oid::to_string(id),
  };
  f"{key}, {signed}"
}

/// A site: its file, who it was asked for, and a name it is not for.
type Site = { file: String, who: String, other: String }

fn sites() -> List<Site> =
  [
    { file: "letsencrypt.pem", who: "letsencrypt.org", other: "letsencrypt.org.example.com" },
    { file: "google.pem", who: "www.google.com", other: "google.com" },
    { file: "github.pem", who: "github.com", other: "api.github.com" },
    { file: "cloudflare.pem", who: "www.cloudflare.com", other: "cloudflare.com" },
    { file: "amazon.pem", who: "www.amazon.com", other: "www.amazon.example" },
    { file: "microsoft.pem", who: "www.microsoft.com", other: "www.microsoft.example" },
    { file: "apple.pem", who: "www.apple.com", other: "apple.com" },
    { file: "bbc.pem", who: "www.bbc.co.uk", other: "www.bbc.example" },
    { file: "sectigo.pem", who: "www.sectigo.com", other: "www.sectigo.example" },
    { file: "idn-muenchen.pem", who: "münchen.de", other: "munchen.de" },
    { file: "idn-buecher.pem", who: "www.bücher.de", other: "a.b.bücher.de" },
    { file: "ip-cloudflare-dns.pem", who: "1.1.1.1", other: "1.1.1.2" },
    { file: "ip-google-dns.pem", who: "8.8.8.8", other: "8.8.8.9" },
  ]

/// A site's chain under one root alone: the path it verifies by, each certificate's `shape`.
type Way = { file: String, who: String, root: String, path: List<String> }

