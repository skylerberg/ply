//! Bytes of the textures a codec's fixtures need, made here, so the corpus stores only what a
//! reference tool packed of them: `zstd/` and `xz/` hold no plain file.

import std.bytes (repeat, u32_le)

/// A number that scatters `i`: what the samples draw their choices from.
fn mixed(i: Int) -> Int = (i * 2654435761 >>> 13 ^ i * 40503 >>> 5 ^ i) & 0xFFFF_FFFF

/// `n` bytes no match shortens.
pub fn noise(n: Int) -> Bytes / {abort.raise} =
  bytes_slice(bytes_concat_all(map(range(0, n / 4 + 1), |i: Int| u32_le(mixed(i + 1)))), 0, n)

fn syllables() -> List<Bytes> =
  [
    b"ta",
    b"ri",
    b"mon",
    b"el",
    b"qua",
    b"ser",
    b"vo",
    b"lin",
    b"dra",
    b"pes",
    b"ku",
    b"zor",
    b"hem",
    b"bi",
    b"fal",
    b"nys",
  ]

fn syllable(k: Int) -> Bytes = match list_at(syllables(), k & 15) { Some(s) -> s, None -> b"" }

/// One word and what follows it: a space, and now and then a comma, a full stop, a number or the
/// end of a line.
fn word(i: Int) -> Bytes / {abort.raise} = {
  let k = mixed(i);
  let stem = bytes_concat(syllable(k), syllable(k >>> 4));
  let long = if k >>> 8 & 3 == 0 { bytes_concat(stem, syllable(k >>> 10)) } else { stem };
  let after = k >>> 14 & 31;
  if after == 0 { bytes_concat(long, b".\n") }
  else if after == 1 { bytes_concat(long, b", ") } else if after == 2 {
    bytes_concat_all([long, b" ", bytes_of_string(int_to_string(k >>> 19 & 1023)), b" "])
  } else if after < 6 { bytes_concat(long, b". ") }
  else { bytes_concat(long, b" ") }
}

/// `n` bytes that read as text does: words that recur, in no order that does.
pub fn prose(n: Int) -> Bytes / {abort.raise} =
  bytes_slice(bytes_concat_all(map(range(0, n / 4 + 8), word)), 0, n)

/// `n` bytes of sixteen-byte records: a counter, a field that changes slowly, one that scatters,
/// and four bytes above the ASCII range, so every byte value occurs.
pub fn records(n: Int) -> Bytes / {abort.raise} =
  bytes_slice(
    bytes_concat_all(
      map(range(0, n / 16 + 1), |i: Int|
        bytes_concat_all([
          u32_le(i),
          u32_le(i / 37 * 7919 & 0xFFFF),
          u32_le(mixed(i) & 0xFF00_FF1F),
          b"\xFF\xFE\x80",
          byte_of_int(i & 255),
        ])),
    ),
    0,
    n,
  )

/// Three runs: a pattern of three bytes, every byte value in turn, and one byte.
pub fn runs() -> Bytes / {abort.raise} =
  bytes_concat_all([
    repeat(b"abc", 30000),
    repeat(bytes_concat_all(map(range(0, 256), byte_of_int)), 300),
    repeat(b"x", 70000),
  ])

/// Noise twice over and half of it again, so a match is 70000 bytes back and as long.
pub fn far() -> Bytes / {abort.raise} = {
  let once = noise(70000);
  bytes_concat_all([once, once, b"tail", bytes_slice(once, 0, 35000)])
}

/// The sample a fixture's name opens with: `prose.l19.zst` is `prose` as a tool packed it.
pub fn sample(name: String) -> Bytes / {abort.raise} =
  if name == "prose" { prose(40000) }
  else if name == "long" { prose(150000) }
  else if name == "brief" { prose(2000) }
  else if name == "records" { records(40000) }
  else if name == "noise" { noise(10000) }
  else if name == "zeros" { repeat(b"\x00", 100000) }
  else if name == "runs" { runs() }
  else if name == "far" { far() }
  else if name == "one" { b"a" }
  else if name == "empty" { b"" }
  else { panic(f"no sample named {name}") }

/// Every sample's name.
pub fn names() -> List<String> =
  ["prose", "long", "brief", "records", "noise", "zeros", "runs", "far", "one", "empty"]

test "each sample is as long as it says, and prose and records are no noise" {
  assert_eq(map(names(), |name: String| bytes_len(sample(name))), [
    40000,
    150000,
    2000,
    40000,
    10000,
    100000,
    236800,
    175004,
    1,
    0,
  ]);
  assert_eq(bytes_slice(prose(40), 0, 6), bytes_slice(prose(2000), 0, 6));
  assert(bytes_index_of(noise(10000), bytes_slice(noise(10000), 100, 108)) == Some(100))
}
