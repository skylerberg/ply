// `pipeline` — where a compile's time goes.
//
// A `ply test` report publishes the phases the toolchain spent — reading, the front end, writing
// back — but not the work the *harness* does before it hands anything over: walking the tree and
// reading every file itself. This module measures both, so the three numbers in one row are the
// whole path from "a directory" to "a checked program", and a slow phase has an owner: a slow walk
// is a walk that should not happen twice, a slow read is I/O, and a slow front end is the compiler.
//
// The walk is in a fixed order — a directory listing's own order would move the measurement between
// runs — and the paths are relative to the `work` root the corpus directory is under.

import spine (exit_zero, ply, report_json, test_report, under)
import std.fs (Dir, fs)
import std.fs
import std.json (Json, Str, Number, Bool, Null, Object, array, object)
import std.json
import std.process (process)
import std.config (config)
import std.time (time)

// What this harness spent on the tree, in microseconds: a benchmark's unit, not a user's.
pub type Harness = { discover_us: Int, read_us: Int, files: Int, bytes: Int }

/// One run: what the harness spent, and what the product reported. The two halves are different
/// clocks measuring different work, which is the point of putting them in one row.
pub type Stages = {
  wall_ms: Int,
  read_ms: Int,
  front_ms: Int,
  write_back_ms: Int,
  harness: Harness,
}

/// Every `.ply` file under `dir`, relative to it, ascending: the order the run's own reading takes.
pub fn discover(dir: String) -> Result<List<String>, String> / {fs.list_dir[work], fs.kind[work]} =
  match fs.list_dir[work](dir) {
    None -> Err("`" ++ dir ++ "` cannot be listed"),
    Some(names) ->
      Ok({
        let entries = sorted(names);
        let here = filter(entries, |n: String| string_ends_with(n, ".ply"));
        let dirs = filter(entries, |n: String| is_dir(under(dir, n)));
        fold(dirs, here, |acc: List<String>, n: String|
          match discover(under(dir, n)) {
            Ok(deeper) -> appended(acc, map(deeper, |path: String| under(n, path))),
            Err(_) -> acc,
          })
      }),
  }

fn is_dir(path: String) -> Bool / {fs.kind[work]} = fs.kind[work](path) == Dir

/// The harness's own phases: walking the tree, then reading what it found. A `Symlink` or a
/// `Missing` entry is neither read nor walked, so the numbers are about files that are there.
pub fn harness(
  dir: String,
) -> Result<Harness, String> / {fs.list_dir[work], fs.kind[work], fs.read_file[work], time.elapsed_us} = {
  let started = time.elapsed_us();
  match discover(dir) {
    Err(why) -> Err(why),
    Ok(files) -> {
      let discover_us = time.elapsed_us() - started;
      if len(files) == 0 { Err("this corpus holds no `.ply` files") } else {
        let read_started = time.elapsed_us();
        // A file the walk found and the read cannot open is a failure, not a zero: the number this
        // reports is what the toolchain then has to read again.
        let unread = fold(files, 0, |bad: Int, path: String|
          match fs.read_file[work](under(dir, path)) { Some(_) -> bad, None -> bad + 1 });
        let bytes = fold(files, 0, |acc: Int, path: String|
          match fs.read_file[work](under(dir, path)) {
            Some(text) -> acc + bytes_len(text),
            None -> acc,
          });
        if unread > 0 {
          Err(
            int_to_string(unread) ++ " of " ++ int_to_string(len(files))
              ++ " files could not be read",
          )
        } else {
          Ok({
            discover_us: discover_us,
            read_us: time.elapsed_us() - read_started,
            files: len(files),
            bytes: bytes,
          })
        }
      }
    },
  }
}

/// One compile, as a whole: the harness's own phases, and the toolchain's, from the same run.
pub fn stages(
  dir: String,
) -> Result<Stages, String> / {fs.list_dir[work], fs.kind[work], fs.read_file[work], time.elapsed_us, time.elapsed_ms, process.spawn[ply], config.get[env]} =
  match harness(dir) {
    Err(why) -> Err("the harness could not walk the corpus: " ++ why),
    Ok(measured) -> {
      let started = time.elapsed_ms();
      let finished = ply(["test", ".", "--json", "--color", "never"], dir);
      let wall_ms = time.elapsed_ms() - started;
      if !exit_zero(finished) { Err("the compile failed: " ++ string_of_bytes_lossy(finished.err)) } else {
        match report_json(finished) {
          Err(why) -> Err(why),
          Ok(j) -> match test_report(j) {
            Err(e) -> Err(e),
            Ok(report) ->
              Ok({
                wall_ms: wall_ms,
                // The harness has already read the tree once, so this is what the toolchain's *own*
                // read cost on top: two reads of one tree is the number worth knowing.
                read_ms: report.read_ms,
                front_ms: report.front_ms,
                write_back_ms: report.write_back_ms,
                harness: measured,
              }),
          },
        }
      }
    },
  }

pub fn stages_json(s: Stages) -> Json =
  object([
    { key: "wall_ms", value: Number(decimal_of_int(s.wall_ms)) },
    // The harness's half, in microseconds — the unit the work is in.
    {
      key: "harness",
      value: object([
        { key: "discover_us", value: Number(decimal_of_int(s.harness.discover_us)) },
        { key: "read_us", value: Number(decimal_of_int(s.harness.read_us)) },
        { key: "files", value: Number(decimal_of_int(s.harness.files)) },
        { key: "source_bytes", value: Number(decimal_of_int(s.harness.bytes)) },
      ]),
    },
    // The toolchain's half, as its own report gives it, in milliseconds.
    {
      key: "toolchain",
      value: object([
        { key: "read_ms", value: Number(decimal_of_int(s.read_ms)) },
        { key: "front_ms", value: Number(decimal_of_int(s.front_ms)) },
        { key: "write_back_ms", value: Number(decimal_of_int(s.write_back_ms)) },
      ]),
    },
  ])

/// One compile's phases, split by who spent them: the harness's own walk and read, and the three
/// phases the product reports.
pub fn pipeline_json(
  dir: String,
) -> Json / {fs.list_dir[work], fs.kind[work], fs.read_file[work], time.elapsed_us, time.elapsed_ms, process.spawn[ply], config.get[env]} =
  match stages(dir) {
    Err(why) -> object([{ key: "ok", value: Bool(false) }, { key: "why", value: Str(why) }]),
    Ok(one) ->
      object([{ key: "ok", value: Bool(true) }, { key: "stages", value: stages_json(one) }]),
  }

/// What a row reads as: the harness's own phases, then the toolchain's.
pub fn stages_text(label: String, s: Stages) -> String =
  label ++ ": " ++ int_to_string(s.harness.files) ++ " files · "
    ++ int_to_string(s.harness.bytes / 1024)
    ++ " KiB · harness "
    ++ int_to_string(s.harness.discover_us)
    ++ "µs walk + "
    ++ int_to_string(s.harness.read_us)
    ++ "µs read · toolchain "
    ++ int_to_string(s.read_ms)
    ++ "ms read + "
    ++ int_to_string(s.front_ms)
    ++ "ms front + "
    ++ int_to_string(s.write_back_ms)
    ++ "ms write back · "
    ++ int_to_string(s.wall_ms)
    ++ "ms wall\n"

// --- Tests ------------------------------------------------------------------

fn sorted(xs: List<String>) -> List<String> =
  fold(xs, [], |acc: List<String>, x: String| {
    let at = fold(range(0, len(acc)), len(acc), |i: Int, j: Int|
      if i < len(acc) { i } else if compare(x, at_or(acc, j)) == Less { j } else { i });
    let head = map(range(0, at), |j: Int| at_or(acc, j));
    fold(range(at, len(acc)), push(head, x), |out: List<String>, j: Int| push(out, at_or(acc, j)))
  })

fn at_or<a>(xs: List<a>, i: Int) -> a =
  match list_at(xs, i) { Some(x) -> x, None -> panic("an index the list holds") }

fn appended<a>(head: List<a>, tail: List<a>) -> List<a> =
  fold(tail, head, |acc: List<a>, x: a| push(acc, x))

test "a stage's two halves are reported apart, because they answer different questions" {
  let s: Stages = {
    wall_ms: 120,
    read_ms: 9,
    front_ms: 90,
    write_back_ms: 4,
    harness: { discover_us: 300, read_us: 1200, files: 12, bytes: 20480 },
  };
  let text = stages_text("rebuild", s);
  assert(string_contains(text, "12 files"));
  assert(string_contains(text, "20 KiB"));
  // The harness's walk and read are microseconds; the toolchain's are milliseconds. Both are here.
  assert(string_contains(text, "300µs walk + 1200µs read"));
  assert(string_contains(text, "9ms read + 90ms front + 4ms write back"));
  assert(string_contains(text, "120ms wall"))
}

test "the walk's order is its own, so a measurement does not move between runs" {
  assert_eq(sorted(["b.ply", "a.ply", "c.ply"]), ["a.ply", "b.ply", "c.ply"]);
  assert_eq(sorted([]), []);
  assert_eq(appended(["a"], ["b", "c"]), ["a", "b", "c"])
}
