// The W4 measurement program: one table, four workloads, two handlers.
import std.db
import std.db (db, with_server)
import std.net (net)
import std.random (entropy)

pub fn schema() -> db::Schema = { tables: [part()] }

pub fn part() -> db::Table =
  {
    name: "part",
    columns: [
      db::column("sku", db::TText, false),
      db::column("name", db::TText, false),
      db::column("price", db::TNumeric(10, 4), false),
      db::column("n", db::TInt, false),
    ],
    primary_key: ["sku"],
    unique: [],
    foreign_keys: [],
    checks: [],
  }

pub fn ddl() -> List<db::Stmt> = db::create_schema(schema())

pub fn select_all() -> db::Stmt =
  db::stmt("select sku, name, price, n from part order by sku limit 1")

pub fn select_by() -> db::Stmt = db::stmt("select sku, name, price, n from part where sku = $1")

pub fn insert_one() -> db::Stmt =
  db::stmt("insert into part (sku, name, price, n) values ($1, $2, $3, $4)")

fn sku_of(i: Int) -> String = "sku-" ++ int_to_string(i)

fn row_params(i: Int) -> List<db::Param> =
  [db::PText(sku_of(i)), db::PText("a part"), db::PNumeric(1.2500m), db::PInt(i)]

fn counted(a: db::Answer) -> Int =
  match a { db::Rows(rows) -> len(rows), db::Count(n) -> n, db::Failed(_) -> 0 }

// --- The four workloads, as the program performs them ------------------------

pub fn selects(n: Int) -> Int / {db.read[part]} =
  fold(range(0, n), 0, |acc: Int, i: Int| acc + counted(db.query[part](select_all(), [])))

// The parameter varies over the keys the fixture holds, so every execution binds a different value
// and finds a row.
pub fn keys() -> Int = 64

pub fn selects_by(n: Int) -> Int / {db.read[part]} =
  fold(range(0, n), 0, |acc: Int, i: Int|
    acc + counted(db.query[part](select_by(), [db::PText(sku_of(i % keys()))])))

pub fn inserts(base: Int, n: Int) -> Int / {db.write[part]} =
  fold(range(0, n), 0, |acc: Int, i: Int|
    acc + counted(db.execute[part](insert_one(), row_params(base + i))))

// One transaction per iteration: begin, one insert, commit.
pub fn transactions(base: Int, n: Int) -> Int / {db.write[part], db.write} =
  fold(range(0, n), 0, |acc: Int, i: Int|
    acc
      + (match db::transaction(db::ReadCommitted, db::ReadWrite, || {
          counted(db.execute[part](insert_one(), row_params(base + i)))
        }) {
        Ok(k) -> k,
        Err(_) -> 0,
      }))

// --- The same four, spread over tasks ----------------------------------------

pub fn selects_at(tasks: Int, per: Int) -> Int / {db.read[part], task.write} =
  joined(map(range(0, tasks), |t: Int| task.spawn(|| selects(per))))

pub fn selects_by_at(tasks: Int, per: Int) -> Int / {db.read[part], task.write} =
  joined(map(range(0, tasks), |t: Int| task.spawn(|| selects_by(per))))

pub fn inserts_at(base: Int, tasks: Int, per: Int) -> Int / {db.write[part], task.write} =
  joined(map(range(0, tasks), |t: Int| task.spawn(|| inserts(base + t * per, per))))

pub fn transactions_at(
  base: Int,
  tasks: Int,
  per: Int,
) -> Int / {db.write[part], db.write, task.write} =
  joined(map(range(0, tasks), |t: Int| task.spawn(|| transactions(base + t * per, per))))

fn joined(ts: List<Task<Int>>) -> Int / {task.write} =
  fold(ts, 0, |acc: Int, t: Task<Int>| acc + task.join(t))

// --- Serving the workloads from a database the program opens itself -----------

// Where to reach the database and how many connections to keep are arguments rather than flags a
// host reads: the program answers its own `db` — `std.db`'s reader, label check and driver are all
// Ply — so a caller that wants a pool of a given size says so.
effect set Served = {net.connect[link], net.send[link], net.recv[link], net.close[link], entropy.next}

fn served<a | e>(
  url: String,
  size: Int,
  body: () -> a / {db.read[*], db.write[*] | e},
) -> a / {net.connect[link], net.send[link], net.recv[link], net.close[link], entropy.next | e} =
  match with_server(url, size, body) {
    Ok(answered) -> answered,
    Err(why) -> panic("the database would not open: " ++ why),
  }

pub fn selects_served(url: String, size: Int, n: Int) -> Int / {Served} =
  served(url, size, || selects(n))

pub fn selects_by_served(url: String, size: Int, n: Int) -> Int / {Served} =
  served(url, size, || selects_by(n))

pub fn inserts_served(url: String, size: Int, base: Int, n: Int) -> Int / {Served} =
  served(url, size, || inserts(base, n))

pub fn transactions_served(url: String, size: Int, base: Int, n: Int) -> Int / {Served} =
  served(url, size, || transactions(base, n))

pub fn selects_at_served(
  url: String,
  size: Int,
  tasks: Int,
  per: Int,
) -> Int / {Served, task.write} = served(url, size, || selects_at(tasks, per))

pub fn selects_by_at_served(
  url: String,
  size: Int,
  tasks: Int,
  per: Int,
) -> Int / {Served, task.write} = served(url, size, || selects_by_at(tasks, per))

pub fn inserts_at_served(
  url: String,
  size: Int,
  base: Int,
  tasks: Int,
  per: Int,
) -> Int / {Served, task.write} = served(url, size, || inserts_at(base, tasks, per))

pub fn transactions_at_served(
  url: String,
  size: Int,
  base: Int,
  tasks: Int,
  per: Int,
) -> Int / {Served, task.write} = served(url, size, || transactions_at(base, tasks, per))

// --- The twin, installed the way `examples/desk.ply` installs it --------------

// The row a handler clause list discharges is the whole of what the twin answers, and a Ply row is
// invariant in argument position, so each workload reaches the twin through a wrapper that
// publishes the whole set.
pub fn twin_seed() -> Int = twinned(|| wide_selects(0))

pub fn twin_selects(n: Int) -> Int = twinned(|| wide_selects(n))

pub fn twin_selects_by(n: Int) -> Int = twinned(|| wide_selects_by(n))

pub fn twin_inserts(base: Int, n: Int) -> Int = twinned(|| wide_inserts(base, n))

pub fn twin_transactions(base: Int, n: Int) -> Int = twinned(|| wide_transactions(base, n))

fn wide_selects(n: Int) -> Int / {db.read[part], db.write[part], db.write} = selects(n)

fn wide_selects_by(n: Int) -> Int / {db.read[part], db.write[part], db.write} = selects_by(n)

fn wide_inserts(base: Int, n: Int) -> Int / {db.read[part], db.write[part], db.write} =
  inserts(base, n)

fn wide_transactions(base: Int, n: Int) -> Int / {db.read[part], db.write[part], db.write} =
  transactions(base, n)

fn twinned(body: () -> Int / {db.read[part], db.write[part], db.write}) -> Int = sized(keys(), body)

// The same twin over a table of a chosen size.
pub fn twin_scan(k: Int, n: Int) -> Int = sized(k, || wide_selects(n))

pub fn twin_scan_seed(k: Int) -> Int = sized(k, || wide_selects(0))

fn sized(k: Int, body: () -> Int / {db.read[part], db.write[part], db.write}) -> Int =
  with_cell[store](seeded_to(k)) { c -> {
    let step = |s: db::Stmt, ps: List<db::Param>| {
      let o = db::step(cell_get(c), s, ps);
      cell_set(c, o.db);
      o.out
    };
    let opened = |level: db::Isolation, access: db::Access| {
      let o = db::begin_step(cell_get(c), level, access);
      cell_set(c, o.db);
      o.out
    };
    let committed = || {
      let o = db::commit_step(cell_get(c));
      cell_set(c, o.db);
      o.out
    };
    let aborted = || {
      let o = db::abort_step(cell_get(c));
      cell_set(c, o.db);
      o.out
    };
    handle {
      body()
    } with {
      db.query[part](s, ps) -> step(s, ps),
      db.execute[part](s, ps) -> step(s, ps),
      db.returning[part](s, ps) -> step(s, ps),
      db.begin(level, access) -> opened(level, access),
      db.commit() -> committed(),
      db.abort() -> aborted(),
      db.rollback(reason) -> (),
    }
  } }

// The twin holding the same rows the fixture holds, put there through the same insert statement the
// write workloads use.
pub fn seeded() -> db::MemDb = seeded_to(keys())

pub fn seeded_to(k: Int) -> db::MemDb =
  fold(range(0, k), db::open(schema()), |d: db::MemDb, i: Int|
    db::step(d, insert_one(), row_params(i)).db)

test "the twin answers every workload" {
  assert_eq(twin_selects(3), 3);
  assert_eq(twin_selects_by(1), 1);
  assert_eq(twin_inserts(100, 4), 4);
  assert_eq(twin_transactions(200, 2), 2)
}

// --- What the harness asks the database, which is not a measurement --------

// The harness's own database work is this program's, not a second client's: the same `std.db`, over
// the same `net`, through the same pool the served rungs use. Nothing here is timed, and the table
// it prepares and inspects is the one the workloads read and the desk serves.

/// One number out of a counting statement, by the name its SQL gives the column.
fn only_int(answered: db::Answer, column: String) -> Int =
  match answered {
    db::Rows(rows) -> match rows {
      [row, ..] -> match map_get(row, column) {
        Some(db::CInt(n)) -> n,
        Some(db::CNumeric(d)) -> match int_of_decimal(d, Down) {
          Some(n) -> n,
          None -> panic("`" ++ column ++ "` does not fit an Int"),
        },
        Some(other) -> panic("`" ++ column ++ "` is not a number"),
        None -> panic("the answer has no column `" ++ column ++ "`"),
      },
      [] -> panic("the statement answered no rows"),
    },
    db::Count(n) -> n,
    db::Failed(why) -> panic("the harness's query failed: " ++ why.code ++ " " ++ why.detail),
  }

fn counted_row(answered: db::Answer, column: String) -> Int =
  match answered { db::Failed(_) -> 0, other -> only_int(other, column) }

/// The rows the twin holds, so a keyed select hits on both sides.
///
/// One statement, and its `values` written out rather than generated by the server: the driver
/// refuses a set-returning function in `from`, which is the rule that keeps the tables a labelled
/// statement touches nameable.
pub fn refill(url: String, size: Int, rows: Int) -> Int / {Served} =
  served(url, size, || {
    let cleared = counted_row(db.execute[part](db::stmt("delete from part"), []), "n");
    cleared + counted_row(db.execute[part](db::stmt(seed_sql(rows)), []), "n")
  })

fn seed_sql(rows: Int) -> String =
  if rows <= 0 { "delete from part" } else {
    let tuples = map(range(0, rows), |i: Int|
      "('sku-" ++ int_to_string(i) ++ "', 'a part', 1.2500, " ++ int_to_string(i) ++ ")");
    "insert into part (sku, name, price, n) values "
      ++ fold(tuples, "", |acc: String, tuple: String|
        if string_len(acc) == 0 { tuple } else { acc ++ ", " ++ tuple })
  }

// The four questions W5's drain test asks of the desk's own schema, each its own statement so the
// column it reads is the statement's to name.

pub fn order_count(url: String, size: Int) -> Int / {Served} =
  served(url, size, ||
    only_int(db.query[orders](db::stmt("select count(*) as n from orders"), []), "n"))

pub fn last_order_id(url: String, size: Int) -> Int / {Served} =
  served(url, size, ||
    only_int(
      db.query[orders_id_seq](db::stmt("select last_value as n from orders_id_seq"), []),
      "n",
    ))

pub fn idle_in_transaction(url: String, size: Int) -> Int / {Served} =
  served(url, size, ||
    only_int(
      db.query[pg_stat_activity](
        db::stmt(
          "select count(*) as n from pg_stat_activity where state = 'idle in transaction' and application_name <> 'ply-corpus'",
        ),
        [],
      ),
      "n",
    ))

pub fn waiting_on_lock(url: String, size: Int) -> Int / {Served} =
  served(url, size, ||
    only_int(
      db.query[pg_stat_activity](
        db::stmt(
          "select count(*) as n from pg_stat_activity where wait_event_type = 'Lock' and state = 'active'",
        ),
        [],
      ),
      "n",
    ))

test "the harness's counting helper reads the column its SQL names" {
  assert_eq(only_int(db::Count(3), "n"), 3);
  assert_eq(only_int(db::Rows([map_of_entries([{ key: "n", value: db::CInt(7) }])]), "n"), 7);
  assert_eq(
    counted_row(db::Failed({ code: "42P01", constraint: "", detail: "no such table" }), "n"),
    0,
  )
}
