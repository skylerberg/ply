// `w4`: what a statement costs through the effect boundary. The statements are those of
// `fixtures/statements.ply`, which times itself over its own `part` table: against the in-memory
// twin, which needs no server; against a database it opens itself, one statement after another or
// spread over tasks; and beside a floor in C over libpq that runs the same statements with no
// language in the path. Then what a pool of each size carries, what one smaller than the
// transactions open at once does, and the desk served over each store and loaded. The runner
// builds the floor and binds it as `pg_floor`; without a database, or without the floor, the rows
// that need one are inconclusive and say which.

import kit
import kit (Kit, Server, Sample)
import report
import report (Row, Criterion, Measurement, Pass, Fail, Inconclusive, Holds, holding, number, exact,
               row, untaken)
import served
import spine
import spine (under)
import stats
import std.config (config)
import std.fs (fs)
import std.json
import std.json (Json, Object, Number, Str, Bool, array)
import std.net (net)
import std.process
import std.process (process, Finished)
import std.router (int_of_text)
import std.time (time)
import std.list
import std.string

pub type Args = {
  repo: String,
  scratch: String,
  db: Option<String>,
  // Which sections: `ops`, `sizes`, `pool`, `exhaustion` and `crud`.
  sections: List<String>,
  concurrency: List<Int>,
  operations: Int,
  rows: List<Int>,
  pool_sizes: List<Int>,
  pool: Int,
  load_concurrency: List<Int>,
  per_conn: Int,
  requests_per_point: Int,
  repeats: Int,
}

pub fn sections() -> List<String> = ["ops", "sizes", "pool", "exhaustion", "crud"]

fn tasks_text(n: Int) -> String = if n == 1 { "1 task" } else { int_to_string(n) ++ " tasks" }

// --- The workloads, as the program and the floor both name them ----------------------------

pub type Workload = | Select | SelectBy | Insert | Transaction

pub fn workloads() -> List<Workload> = [Select, SelectBy, Insert, Transaction]

pub fn label(w: Workload) -> String =
  match w {
    Select -> "select",
    SelectBy -> "select $1",
    Insert -> "insert",
    Transaction -> "transaction",
  }

// The first key a write takes, past every key a fill puts in the table.
fn base() -> Int = 1000000

// The rows the table holds before every repeat, which is also how many keys a keyed select cycles.
fn keys() -> Int = 64

// One point: `tasks` tasks of `per` statements each, over a table of `rows` rows, `repeats` times.
pub type Point = { workload: Workload, tasks: Int, per: Int, rows: Int, repeats: Int }

pub fn point_settings(section: String, p: Point) -> List<List<String>> =
  [
    kit::set("BENCH_SECTION", section),
    kit::set("BENCH_WORKLOAD", label(p.workload)),
    kit::set("BENCH_TASKS", int_to_string(p.tasks)),
    kit::set("BENCH_PER", int_to_string(p.per)),
    kit::set("BENCH_ROWS", int_to_string(p.rows)),
    kit::set("BENCH_BASE", int_to_string(base())),
    kit::set("BENCH_REPEATS", int_to_string(p.repeats)),
  ]

// --- What a point took ------------------------------------------------------------------------

// Every statement asked across the repeats, what they answered, what the pool refused and what
// otherwise failed, and each repeat's microseconds.
pub type Took = { asked: Int, answered: Int, refused: Int, failed: Int, runs_us: List<Int> }

pub fn took_of(j: Json) -> Result<Took, String> =
  match j {
    Object(m) ->
      Ok({
        asked: spine::int_field(m, "asked"),
        answered: spine::int_field(m, "answered"),
        refused: spine::int_field(m, "refused"),
        failed: spine::int_field(m, "failed"),
        runs_us: spine::ints_field(m, "runs_us"),
      }),
    _ -> Err("the program's report is not an object"),
  }

// A point the program timed, one it ended by raising, which is itself the measurement, or one whose
// report could not be read.
pub type Ran = | Timed(Took) | Raised(String) | Unread(String)

// The diagnostic a run ended with, past any warning written before it.
fn raised_line(text: String) -> String =
  match filter(string_split(text, "\n"), |line: String| string_contains(line, "error[")) {
    [line, ..] -> string_trim(line),
    [] -> spine::first_line(text),
  }

pub fn ran_of(f: Finished) -> Ran =
  if !spine::exit_zero(f) { Raised(raised_line(string_of_bytes_lossy(f.err))) } else {
    match kit::printed(f, "statements.ply") {
      Err(why) -> Unread(why),
      Ok(j) -> match took_of(j) { Err(why) -> Unread(why), Ok(t) -> Timed(t) },
    }
  }

fn over_twin(k: Kit, p: Point) -> Ran / {process.spawn[ply], config.get[env]} =
  ran_of(kit::ran(k, "statements.ply", point_settings("twin", p)))

fn over_database(
  k: Kit,
  url: String,
  pool: Int,
  p: Point,
) -> Ran / {process.spawn[ply], config.get[env]} =
  ran_of(
    kit::ran(
      k,
      "statements.ply",
      list::flatten([
        point_settings("postgres", p),
        [kit::set("BENCH_DATABASE", url), kit::set("BENCH_POOL", int_to_string(pool))],
      ]),
    ),
  )

// --- The criteria -------------------------------------------------------------------------------

// A run that raised fails on that alone; otherwise `holds` is asked of what was asked, answered,
// refused and failed.
fn statements(text: String, holds: (Decimal, Decimal, Decimal, Decimal) -> Bool) -> Criterion =
  Holds(text, |ms: List<Measurement>|
    match report::measurement(ms, "raised") {
      None -> Inconclusive("`raised` was not measured"),
      Some(r) -> if r.value != 0m { Fail([r]) } else {
        let counts = report::named(ms, ["asked", "answered", "refused", "failed"]);
        match map(counts, |m: Measurement| m.value) {
          [asked, answered, refused, failed] -> if holds(asked, answered, refused, failed) { Pass }
          else { Fail(counts) },
          _ -> Inconclusive("not every count was measured"),
        }
      },
    })

pub fn every_answered() -> Criterion =
  statements(
    "every statement answered, none refused by the pool or failed",
    |asked: Decimal, answered: Decimal, refused: Decimal, failed: Decimal|
      answered == asked && refused == 0m && failed == 0m,
  )

// A pool smaller than the tasks drawing on it may refuse a checkout, and that is its answer rather
// than a lost statement; anything else that fails is lost.
pub fn nothing_lost() -> Criterion =
  statements(
    "every statement answered or refused by the pool at once, none otherwise failed",
    |asked: Decimal, answered: Decimal, refused: Decimal, failed: Decimal|
      answered + refused == asked && failed == 0m,
  )

fn floor_ran() -> Criterion =
  holding("the floor ran every statement", ["asked", "ran"], |vs: List<Decimal>|
    match vs { [asked, ran] -> ran == asked, _ -> false })

// --- The rows -----------------------------------------------------------------------------------

fn best_us(runs: List<Int>) -> Option<Int> = stats::best(runs)

fn per_statement(us: Int, statements: Int) -> Decimal =
  decimal_div(
    decimal_of_int(us),
    decimal_of_int(if statements < 1 { 1 } else { statements }),
    3,
    HalfEven,
  )

// The counts a row is judged by, and its fastest repeat as microseconds a statement and a rate.
pub fn took_measurements(t: Took, per_repeat: Int) -> List<Measurement> =
  list::flatten([
    [
      number("raised", 0, ""),
      number("asked", t.asked, "statements"),
      number("answered", t.answered, "statements"),
      number("refused", t.refused, "statements"),
      number("failed", t.failed, "statements"),
    ],
    match best_us(t.runs_us) {
      Some(us) ->
        [
          exact("us_per_statement", per_statement(us, per_repeat), "µs"),
          number("per_second", stats::per_second(per_repeat, us), "statements/s"),
        ],
      None -> [],
    },
  ])

pub fn point_row(
  name: String,
  c: Criterion,
  per_repeat: Int,
  r: Ran,
  beside: List<Measurement>,
) -> Row =
  match r {
    Timed(t) -> row(name, c, list::flatten([took_measurements(t, per_repeat), beside])),
    Raised(why) -> { ..row(name, c, [number("raised", 1, "")]), detail: Str(why) },
    Unread(why) -> untaken(name, c, why),
  }

// What running the statements over a database needs, and why a row that needs it was not taken.
pub type Prepared = | NoDatabase | NoFloor | Unprepared(String) | Ready(Database)

// The database, and the statements that put its table back as the program fills it.
pub type Database = { url: String, fill: String }

pub fn unready(p: Prepared) -> String =
  match p {
    NoDatabase ->
      "no database was given: pass `--db` with a URL the corpus may make its `part` table in",
    NoFloor ->
      "the `part` table is made and refilled by the libpq tool, which is not bound (benches/corpus.sh builds it where `pg_config` is)",
    Unprepared(why) -> "the `part` table could not be made: " ++ why,
    Ready(_) -> "",
  }

// --- The floor ------------------------------------------------------------------------------

fn tool(args: List<String>) -> Result<String, String> / {process.spawn[pg_floor], config.get[env]} = {
  let f = process.spawn[pg_floor](args, "", spine::inherited_env());
  if spine::exit_zero(f) { Ok(string_of_bytes_lossy(f.out)) } else {
    Err(
      "the libpq tool's `" ++ (match args { [mode, ..] -> mode, [] -> "" }) ++ "` failed: "
        ++ spine::first_line(string_of_bytes_lossy(f.err)),
    )
  }
}

// `floor 1234`: the microseconds around the statements.
pub fn floor_us(out: String) -> Option<Int> =
  match filter(string_split(string_trim(out), " "), |w: String| w != "") {
    ["floor", us] -> int_of_text(us),
    _ -> None,
  }

// The table put back as the program fills it, then the floor's run; the fastest of the repeats.
fn floored(
  d: Database,
  w: Workload,
  tasks: Int,
  per: Int,
  repeats: Int,
) -> Result<Int, String> / {process.spawn[pg_floor], config.get[env]} =
  match kit::all_of(
      map(range(0, if repeats < 1 { 1 } else { repeats }), |r: Int|
        match tool(["sql", d.url, d.fill]) {
          Err(why) -> Err(why),
          Ok(_) -> match tool([
              "floor",
              d.url,
              label(w),
              int_to_string(tasks),
              int_to_string(per),
              int_to_string(base()),
            ]) {
            Err(why) -> Err(why),
            Ok(out) -> match floor_us(out) {
              Some(us) -> Ok(us),
              None -> Err("the floor printed `" ++ string_trim(out) ++ "`, not a duration"),
            },
          },
        }),
    ) {
    Err(why) -> Err(why),
    Ok(runs) -> match stats::best(runs) {
      Some(us) -> Ok(us),
      None -> Err("no floor run was taken"),
    },
  }

// --- Making the table -----------------------------------------------------------------------

fn texts_of(m: Map<String, Json>, key: String) -> List<String> =
  map(spine::array_field(m, key), |j: Json| match j { Str(s) -> s, _ -> "" })

// The program's own `drop` and `create`, run by the tool, which runs what `std.db` will not.
fn prepared(
  k: Kit,
  db: Option<String>,
) -> Prepared / {process.bound[pg_floor], process.spawn[ply], process.spawn[pg_floor], config.get[env]} =
  match db {
    None -> NoDatabase,
    Some(url) -> if !process.bound[pg_floor]() { NoFloor } else {
      match kit::printed(
          kit::ran(k, "statements.ply", [
            kit::set("BENCH_SECTION", "schema"),
            kit::set("BENCH_ROWS", int_to_string(keys())),
          ]),
          "statements.ply",
        ) {
        Err(why) -> Unprepared(why),
        Ok(Object(m)) -> match tool([
            "sql",
            url,
            string::join(list::flatten([texts_of(m, "drop"), texts_of(m, "create")]), "; "),
          ]) {
          Err(why) -> Unprepared(why),
          Ok(_) -> Ready({ url: url, fill: string::join(texts_of(m, "fill"), "; ") }),
        },
        Ok(_) -> Unprepared("the schema report is not an object"),
      }
    },
  }

// --- ops: every workload at every concurrency, on three rungs ----------------------------------

fn per_task(operations: Int, tasks: Int) -> Int = {
  let per = operations / (if tasks < 1 { 1 } else { tasks });
  if per < 1 { 1 } else { per }
}

fn ops_name(w: Workload, tasks: Int, rung: String) -> String =
  "ops, " ++ label(w) ++ ", " ++ tasks_text(tasks) ++ ", " ++ rung

// The floor's microseconds a statement, and the program's as a multiple of them.
fn over_floor(floor: Option<Decimal>, mine: Ran, statements: Int) -> List<Measurement> =
  match ((floor, mine)) {
    (Some(f), Timed(t)) -> match best_us(t.runs_us) {
      Some(us) -> if f > 0m {
        [exact("over_floor", decimal_div(per_statement(us, statements), f, 3, HalfEven), "×")]
      } else { [] },
      None -> [],
    },
    _ -> [],
  }

fn ops_point(
  k: Kit,
  a: Args,
  p: Prepared,
  w: Workload,
  tasks: Int,
  twin: Bool,
) -> List<Row> / {process.spawn[ply], process.spawn[pg_floor], config.get[env]} = {
  let per = per_task(a.operations, tasks);
  let statements = per * tasks;
  let point = { workload: w, tasks: tasks, per: per, rows: keys(), repeats: a.repeats };
  let database = match p {
    Ready(d) -> {
      let floor = floored(d, w, tasks, per, a.repeats);
      let mine = over_database(k, d.url, a.pool, point);
      let floor_each = match floor {
        Ok(us) -> Some(per_statement(us, statements)),
        Err(_) -> None,
      };
      [
        match floor {
          Ok(us) ->
            row(ops_name(w, tasks, "libpq floor"), floor_ran(), [
              number("asked", statements, "statements"),
              number("ran", statements, "statements"),
              exact("us_per_statement", per_statement(us, statements), "µs"),
              number("per_second", stats::per_second(statements, us), "statements/s"),
            ]),
          Err(why) -> {
            let failed = row(ops_name(w, tasks, "libpq floor"), floor_ran(), [
              number("asked", statements, "statements"),
              number("ran", 0, "statements"),
            ]);
            { ..failed, detail: Str(why) }
          },
        },
        point_row(
          ops_name(w, tasks, "std.db"),
          every_answered(),
          statements,
          mine,
          over_floor(floor_each, mine, statements),
        ),
      ]
    },
    other ->
      [
        untaken(ops_name(w, tasks, "libpq floor"), floor_ran(), unready(other)),
        untaken(ops_name(w, tasks, "std.db"), every_answered(), unready(other)),
      ],
  };
  // The twin has no server to be concurrent against: the same statements, one after another.
  if twin {
    push(
      database,
      point_row(
        "ops, " ++ label(w) ++ ", twin",
        every_answered(),
        statements,
        over_twin(k, { ..point, tasks: 1, per: statements }),
        [],
      ),
    )
  } else { database }
}

fn ops_rows(
  k: Kit,
  a: Args,
  p: Prepared,
) -> List<Row> / {process.spawn[ply], process.spawn[pg_floor], config.get[env]} =
  list::flatten(
    map(workloads(), |w: Workload|
      list::flatten(
        map(range(0, len(a.concurrency)), |i: Int|
          match list_at(a.concurrency, i) {
            Some(tasks) -> ops_point(k, a, p, w, tasks, i == 0),
            None -> [],
          }),
      )),
  )

// --- sizes: one ordered select against the rows it sorts ---------------------------------------

fn sizes_rows(k: Kit, a: Args, p: Prepared) -> List<Row> / {process.spawn[ply], config.get[env]} =
  list::flatten(
    map(a.rows, |n: Int| {
      let point = { workload: Select, tasks: 1, per: a.operations, rows: n, repeats: a.repeats };
      let name = |rung: String| "sizes, " ++ int_to_string(n) ++ " rows, " ++ rung;
      [
        point_row(name("twin"), every_answered(), a.operations, over_twin(k, point), []),
        match p {
          Ready(d) ->
            point_row(
              name("std.db"),
              every_answered(),
              a.operations,
              over_database(k, d.url, 4, point),
              [],
            ),
          other -> untaken(name("std.db"), every_answered(), unready(other)),
        },
      ]
    }),
  )

// --- pool: throughput against pool size, and a pool smaller than its open transactions ----------

fn pool_tasks() -> Int = 8

fn pool_rows(k: Kit, a: Args, p: Prepared) -> List<Row> / {process.spawn[ply], config.get[env]} =
  list::flatten(
    map([Select, Transaction], |w: Workload|
      map(a.pool_sizes, |size: Int| {
        let per = per_task(a.operations, pool_tasks());
        let name = "pool of " ++ int_to_string(size) ++ ", " ++ label(w) ++ ", "
          ++ tasks_text(pool_tasks());
        let c = if size >= pool_tasks() { every_answered() } else { nothing_lost() };
        match p {
          Ready(d) ->
            point_row(
              name,
              c,
              per * pool_tasks(),
              over_database(k, d.url, size, {
                workload: w,
                tasks: pool_tasks(),
                per: per,
                rows: keys(),
                repeats: a.repeats,
              }),
              [],
            ),
          other -> untaken(name, c, unready(other)),
        }
      })),
  )

// Pools smaller than the transactions open at once, and one that holds them all.
pub fn exhaustion_points() -> List<{ pool: Int, tasks: Int }> =
  [{ pool: 1, tasks: 8 }, { pool: 1, tasks: 32 }, { pool: 8, tasks: 32 }]

fn exhaustion_rows(k: Kit, p: Prepared) -> List<Row> / {process.spawn[ply], config.get[env]} =
  map(exhaustion_points(), |e: { pool: Int, tasks: Int }| {
    let name = "exhaustion, pool of " ++ int_to_string(e.pool) ++ ", " ++ tasks_text(e.tasks)
      ++ " in transactions";
    match p {
      Ready(d) -> {
        let r = over_database(k, d.url, e.pool, {
          workload: Transaction,
          tasks: e.tasks,
          per: 8,
          rows: keys(),
          repeats: 1,
        });
        point_row(name, nothing_lost(), e.tasks * 8, r, match r {
          Timed(t) -> match best_us(t.runs_us) {
            Some(us) -> [report::ms_of_us("wall", us)],
            None -> [],
          },
          _ -> [],
        })
      },
      other -> untaken(name, nothing_lost(), unready(other)),
    }
  })

// --- crud: the desk over each store, loaded --------------------------------------------------

pub fn crud_routes() -> List<String> = ["/health", "/items", "/orders/1"]

fn crud_load(a: Args, port: Int, route: String, clients: Int) -> kit::Load =
  {
    port: port,
    routes: [route],
    connections: clients * served::share(clients, a.per_conn, a.requests_per_point),
    concurrency: clients,
    per_conn: a.per_conn,
    trust: None,
  }

type Pointed = { name: String, load: kit::Load, sample: Sample }

fn loaded(
  k: Kit,
  a: Args,
  store: String,
  s: Server,
) -> Result<List<Pointed>, String> / {process.spawn[ply], config.get[env], fs.read_file[work], fs.remove[work]} =
  kit::all_of(
    list::flatten(
      map(crud_routes(), |route: String|
        map(a.load_concurrency, |c: Int| {
          let l = crud_load(a, s.port, route, c);
          match kit::measured(k, l, a.repeats) {
            Err(why) -> Err(why),
            Ok(sample) ->
              Ok({
                name: "crud, " ++ store ++ ", GET " ++ route ++ ", " ++ kit::clients_text(c),
                load: l,
                sample: sample,
              }),
          }
        })),
    ),
  )

fn crud_names(a: Args, store: String) -> List<String> =
  list::flatten(
    map(crud_routes(), |route: String|
      map(a.load_concurrency, |c: Int|
        "crud, " ++ store ++ ", GET " ++ route ++ ", " ++ kit::clients_text(c))),
  )

fn stop_name(store: String) -> String = "the desk over the " ++ store ++ ","

// One store's rows: every point answered and the desk drained, or every row untaken with why.
fn store_rows(
  k: Kit,
  a: Args,
  store: String,
  d: served::Desk,
) -> List<Row> / {process.start[ply], process.output_line[ply], process.wait[ply], process.signal[ply], process.spawn[ply], config.get[env], fs.read_file[work], fs.remove[work], net.connect[probe], net.close[probe], time.elapsed_ms, time.sleep_ms} =
  match kit::serving[ply](k, "desk-" ++ store, served::desk_args(k, d), |s: Server|
      loaded(k, a, store, s)) {
    Err(why) ->
      push(
        map(crud_names(a, store), |name: String| untaken(name, kit::complete(200), why)),
        untaken(stop_name(store) ++ " stops", kit::drained(), why),
      ),
    Ok(done) ->
      push(
        map(done.value, |p: Pointed| kit::answered_row(p.name, p.load, p.sample)),
        kit::stop_row(stop_name(store), done.stop, kit::drained()),
      ),
  }

fn crud_desks(a: Args) -> List<{ store: String, desk: served::Desk }> =
  [
    { store: "twin", desk: served::twin("sequential") },
    {
      store: "postgres",
      desk: served::over("sequential", match a.db {
        Some(url) -> url,
        None -> served::unreached(),
      }),
    },
  ]

fn crud_rows(
  k: Kit,
  a: Args,
) -> List<Row> / {process.start[ply], process.output_line[ply], process.wait[ply], process.signal[ply], process.spawn[ply], config.get[env], fs.read_file[work], fs.remove[work], net.connect[probe], net.close[probe], time.elapsed_ms, time.sleep_ms} =
  list::flatten(
    map(crud_desks(a), |one: { store: String, desk: served::Desk }|
      if one.store == "postgres" && a.db == None {
        push(
          map(crud_names(a, one.store), |name: String|
            untaken(name, kit::complete(200), unready(NoDatabase))),
          untaken(stop_name(one.store) ++ " stops", kit::drained(), unready(NoDatabase)),
        )
      } else { store_rows(k, a, one.store, one.desk) }),
  )

// Every line `crud` runs the desk with, taken by `ply hosts` whether or not a database is there to
// run it against.
fn lines(k: Kit, a: Args) -> List<served::Line> =
  map(crud_desks(a), |one: { store: String, desk: served::Desk }|
    { label: "the desk over the " ++ one.store, args: served::desk_args(k, one.desk) })

// --- The report ------------------------------------------------------------------------

pub fn run(
  a: Args,
) -> Result<report::Report, String> / {process.bound[pg_floor], process.start[ply], process.output_line[ply], process.wait[ply], process.signal[ply], process.spawn[ply], process.spawn[pg_floor], config.get[env], fs.read_file[work], fs.remove[work], fs.create_dir[work], fs.read[repo], net.connect[probe], net.close[probe], time.elapsed_ms, time.sleep_ms} = {
  let k = { repo: a.repo, scratch: under(a.scratch, "w4") };
  match kit::prepare(k) {
    Err(why) -> Err(why),
    Ok(_) -> {
      let tabled = list::contains(a.sections, "ops") || list::contains(a.sections, "sizes")
        || list::contains(a.sections, "pool")
        || list::contains(a.sections, "exhaustion");
      let p = if tabled { prepared(k, a.db) } else { NoDatabase };
      let rows = list::flatten([
        if list::contains(a.sections, "crud") {
          [served::lines_row("the desk lines `crud` runs", served::checked(lines(k, a)))]
        } else { [] },
        if list::contains(a.sections, "ops") { ops_rows(k, a, p) } else { [] },
        if list::contains(a.sections, "sizes") { sizes_rows(k, a, p) } else { [] },
        if list::contains(a.sections, "pool") { pool_rows(k, a, p) } else { [] },
        if list::contains(a.sections, "exhaustion") { exhaustion_rows(k, p) } else { [] },
        if list::contains(a.sections, "crud") { crud_rows(k, a) } else { [] },
      ]);
      report::made("w4", "w4 — a statement through the effect boundary, beside libpq", rows, [
        { key: "sections", value: array(map(a.sections, |s: String| Str(s))) },
        { key: "database", value: Bool(a.db != None) },
        { key: "operations", value: Number(decimal_of_int(a.operations)) },
        { key: "pool", value: Number(decimal_of_int(a.pool)) },
      ])
    },
  }
}

// --- Tests ---------------------------------------------------------------------------------

fn took(asked: Int, answered: Int, refused: Int, failed: Int) -> Took =
  { asked: asked, answered: answered, refused: refused, failed: failed, runs_us: [900, 400] }

test "a point is judged by its counts, and a run that raised fails on that alone" {
  assert_eq(
    report::judged_alone(point_row("p", every_answered(), 200, Timed(took(400, 400, 0, 0)), [])),
    Pass,
  );
  assert(
    report::judged_alone(point_row("p", every_answered(), 200, Timed(took(400, 399, 1, 0)), []))
      != Pass,
  );
  assert_eq(
    report::judged_alone(point_row("p", nothing_lost(), 200, Timed(took(400, 399, 1, 0)), [])),
    Pass,
  );
  assert(
    report::judged_alone(point_row("p", nothing_lost(), 200, Timed(took(400, 399, 0, 1)), []))
      != Pass,
  );
  let raised = point_row("p", nothing_lost(), 200, Raised("error[E0502]: the pool panicked"), []);
  assert_eq(report::judged_alone(raised), Fail([number("raised", 1, "")]));
  assert_eq(raised.detail, Str("error[E0502]: the pool panicked"));
  assert_eq(
    report::judged_alone(point_row("p", every_answered(), 200, Unread("no report"), [])),
    Inconclusive("no report"),
  )
}

test "a point's fastest repeat is its microseconds a statement and its rate" {
  let ms = took_measurements(took(400, 400, 0, 0), 200);
  assert_eq(report::value_of(ms, "us_per_statement"), Some(2.000m));
  assert_eq(report::value_of(ms, "per_second"), Some(500000m));
  assert_eq(over_floor(Some(0.500m), Timed(took(400, 400, 0, 0)), 200), [
    exact("over_floor", 4.000m, "×"),
  ]);
  assert_eq(over_floor(None, Timed(took(400, 400, 0, 0)), 200), [])
}

test "the program's report is read into what it took, and its failure is what it raised" {
  let out = b"   binding host\n{\"answered\":8,\"asked\":8,\"failed\":0,\"refused\":0,\"runs_us\":[30,20]}\n";
  assert_eq(
    ran_of(process::exited(0, out, b"")),
    Timed({ asked: 8, answered: 8, refused: 0, failed: 0, runs_us: [30, 20] }),
  );
  assert_eq(
    ran_of(
      process::exited(
        1,
        b"",
        b"warning[W0607]: an undeclared key\nerror[E0502]: the database would not open\n   raised at\n",
      ),
    ),
    Raised("error[E0502]: the database would not open"),
  );
  assert_eq(floor_us("floor 1234\n"), Some(1234));
  assert_eq(floor_us("connecting: refused"), None)
}

test "a point is the program's settings, and every write starts past the fill's keys" {
  let settings = list::flatten(
    point_settings("postgres", { workload: SelectBy, tasks: 4, per: 100, rows: 64, repeats: 3 }),
  );
  assert(
    fold(
      ["BENCH_WORKLOAD=select $1", "BENCH_TASKS=4", "BENCH_PER=100", "BENCH_BASE=1000000"],
      true,
      |ok: Bool, want: String| ok && list::contains(settings, want),
    ),
  );
  assert(base() > keys());
  assert_eq(per_task(400, 16), 25);
  assert_eq(per_task(4, 16), 1)
}

test "without a database the rows that need one are inconclusive, and say why" {
  let a = {
    repo: ".",
    scratch: "s",
    db: None,
    sections: sections(),
    concurrency: [1, 4],
    operations: 8,
    rows: [8],
    pool_sizes: [1, 8],
    pool: 16,
    load_concurrency: [1],
    per_conn: 1,
    requests_per_point: 1,
    repeats: 1,
  };
  let k = { repo: ".", scratch: "s" };
  let pooled = handle {
    pool_rows(k, a, NoDatabase)
  } with {
    process.spawn[ply](args, dir, env) -> panic("nothing is run without a database"),
    config.get[env](key) -> None,
  };
  assert_eq(map(report::judge(pooled), |j: report::Judged| j.verdict), [
    Inconclusive(unready(NoDatabase)),
    Inconclusive(unready(NoDatabase)),
    Inconclusive(unready(NoDatabase)),
    Inconclusive(unready(NoDatabase)),
  ]);
  assert_eq(map(crud_desks(a), |one: { store: String, desk: served::Desk }| one.desk.database), [
    None,
    Some(served::unreached()),
  ])
}
