// `regions` — what region isolation costs the scheduler. Every test's footprint is coloured twice with
// the runner's own colouring: as the runner colours it, where an atom naming a region label contends
// like any other, and as the forkable world did, where every test was handed its own copy of each
// region and only the rest contended. What separates the two schedules is the price of the region
// model, and a test the world kept apart that now shares a class is one it serialized.
//
// A project is measured by the product: its tests' footprints and their durations on one worker from
// `ply test --json --no-cache --jobs 1`, and the suite's own wall at the workers asked for. A
// hypothetical corpus is a footprint shape drawn from a seed, for pricing a risk no tree carries yet.

import rng
import report
import report (Row, Measurement, AtMost, holding, number, exact, ms_of_us, row, untaken)
import product
import suite.schedule
import suite.schedule (Atom, Scheduled, ambient_effects, footprints_conflict, group_by_conflict,
                       is_region_scoped)
import std.json (Json, Str, Number, Object, object, array)
import std.json
import std.fs (fs)
import std.process (process)
import std.config (config)

// One test as the colourings see it: the atoms another test could contend over (the footprint minus
// the inputs only this test is handed), whether it was handed one, and what it took on one worker.
pub type Test = {
  index: Int,
  key: String,
  footprint: String,
  contends: List<Atom>,
  seeded: Bool,
  us: Int,
}

pub type Corpus = {
  root: String,
  tests: List<Test>,
  // What one worker costs before it runs a test.
  setup_us: Int,
  // The suite as the product timed it, at the workers asked for and at one; a hypothetical has none.
  suite_us: Option<Int>,
  sequential_us: Option<Int>,
  // The classes the runner itself coloured the tests into.
  runner: Option<List<List<Int>>>,
}

// One colouring, priced.
pub type Split = {
  groups: Int,
  largest_group: Int,
  // Tests outside the first class: what a barrier is charged for.
  after_the_first_group: Int,
  // The suite at `jobs` workers, modelled the way the runner schedules it.
  makespan_us: Int,
  // The same with a worker for every test: each class's slowest member, summed.
  critical_path_us: Int,
  // Every test one after another.
  sequential_us: Int,
}

// A test the forkable world kept apart that the region model makes share a class.
pub type Newly = { key: String, footprint: String, conflicts_with: String }

pub type Cost = {
  root: String,
  jobs: Int,
  tests: Int,
  // Isolated under the forkable world: nothing but region labels, or nothing at all, contends.
  isolated: Int,
  // Of those: empty footprints, which conflict with nothing either way.
  pure: Int,
  // Of those: handed a seed and nothing else, which neither model touches.
  seeded: Int,
  // Of those: carrying a region label, the only ones that can lose anything.
  world_backed: Int,
  newly: List<Newly>,
  forked: Split,
  regions: Split,
  region_groups: List<List<Int>>,
}

// --- The two projections ----------------------------------------------------------

// What contended under the forkable world: every region was a test's own.
fn forked(t: Test) -> List<Atom> = filter(t.contends, |a: Atom| !is_region_scoped(a))

// What contends in the region model, which is what the runner colours.
fn in_regions(t: Test) -> List<Atom> = t.contends

fn world_isolated(t: Test) -> Bool = len(forked(t)) == 0

fn isolated_by_forking(t: Test) -> Bool =
  world_isolated(t) && fold(t.contends, false, |hit: Bool, a: Atom| hit || is_region_scoped(a))

fn is_pure(t: Test) -> Bool = len(t.contends) == 0 && !t.seeded

// The runner's colouring over one projection.
pub fn colour(
  tests: List<Test>,
  projection: (Test) -> List<Atom>,
) -> List<List<Int>> / {abort.raise} =
  group_by_conflict(map(tests, |t: Test| { index: t.index, contends: projection(t) }))

// --- The wall-clock model ----------------------------------------------------------------

fn at<a>(xs: List<a>, i: Int, spare: a) -> a = match list_at(xs, i) { Some(x) -> x, None -> spare }

// The worker a test is handed to: the first of the least loaded.
fn least(free: List<Int>) -> Int =
  fold(range(0, len(free)), 0, |best: Int, i: Int|
    if at(free, i, 0) < at(free, best, 0) { i } else { best })

// Wall clock for a schedule as the runner executes it: classes in turn, each on `jobs` workers (one
// per test at 0), every worker starting at `setup`.
pub fn makespan(groups: List<List<Int>>, us: Map<Int, Int>, jobs: Int, setup: Int) -> Int =
  fold(groups, 0, |total: Int, group: List<Int>|
    if len(group) == 0 { total } else {
      let workers = if jobs == 0 { len(group) } else { min(jobs, len(group)) };
      let free = fold(
        group,
        map(range(0, workers), |_w: Int| setup),
        |free: List<Int>, index: Int| {
          let slot = least(free);
          let cost = match map_get(us, index) { Some(c) -> c, None -> 0 };
          map(range(0, len(free)), |w: Int|
            if w == slot { at(free, w, 0) + cost } else { at(free, w, 0) })
        },
      );
      total + fold(free, 0, |m: Int, f: Int| max(m, f))
    })

fn split(groups: List<List<Int>>, us: Map<Int, Int>, jobs: Int, setup: Int) -> Split =
  {
    groups: len(groups),
    largest_group: fold(groups, 0, |m: Int, g: List<Int>| max(m, len(g))),
    after_the_first_group: fold(range(1, len(groups)), 0, |n: Int, i: Int|
      n + len(at(groups, i, []))),
    makespan_us: makespan(groups, us, jobs, setup),
    critical_path_us: makespan(groups, us, 0, setup),
    sequential_us: makespan(
      [
        fold(groups, [], |all: List<Int>, g: List<Int>|
          fold(g, all, |acc: List<Int>, i: Int| push(acc, i))),
      ],
      us,
      1,
      setup,
    ),
  }

// --- The analysis ----------------------------------------------------------------------

fn newly_serialized(tests: List<Test>) -> List<Newly> =
  fold(tests, [], |acc: List<Newly>, t: Test|
    if !world_isolated(t) || len(in_regions(t)) == 0 { acc } else {
      match fold(tests, None, |found: Option<Test>, u: Test|
          match found {
            Some(_) -> found,
            None -> if u.index != t.index && footprints_conflict(in_regions(t), in_regions(u)) {
              Some(u)
            } else { None },
          }) {
        None -> acc,
        Some(u) -> push(acc, { key: t.key, footprint: t.footprint, conflicts_with: u.key }),
      }
    })

pub fn analyse(corpus: Corpus, jobs: Int) -> Cost / {abort.raise} = {
  let us = fold(corpus.tests, map_new(), |m: Map<Int, Int>, t: Test| map_insert(m, t.index, t.us));
  let forked_groups = colour(corpus.tests, forked);
  let region_groups = colour(corpus.tests, in_regions);
  let isolated = len(filter(corpus.tests, world_isolated));
  let pure = len(filter(corpus.tests, is_pure));
  let world_backed = len(filter(corpus.tests, isolated_by_forking));
  {
    root: corpus.root,
    jobs: jobs,
    tests: len(corpus.tests),
    isolated: isolated,
    pure: pure,
    seeded: isolated - pure - world_backed,
    world_backed: world_backed,
    newly: newly_serialized(corpus.tests),
    forked: split(forked_groups, us, jobs, corpus.setup_us),
    regions: split(region_groups, us, jobs, corpus.setup_us),
    region_groups: region_groups,
  }
}

// What the region model costs the suite at `jobs`, as a multiple of the forkable world's.
pub fn ratio(cost: Cost) -> Decimal / {abort.raise} =
  if cost.forked.makespan_us <= 0 { 1m } else {
    decimal_div(
      decimal_of_int(cost.regions.makespan_us),
      decimal_of_int(cost.forked.makespan_us),
      2,
      HalfEven,
    )
  }

// --- A hypothetical corpus ---------------------------------------------------------------

pub type Hypothetical = {
  // Tests carrying a `cell` atom, and the distinct labels they spread over.
  cell_tests: Int,
  labels: Int,
  // Tests carrying a contending resource atom, so the graph already has edges, and their labels.
  shared_tests: Int,
  shared_labels: Int,
  pure_tests: Int,
  seed: Int,
}

fn atom_at(e: String, label: Int, writes: Bool) -> Atom =
  { effect: e, resource: "r" ++ int_to_string(label), writes: writes }

fn drawn(key: String, index: Int, contends: List<Atom>) -> Test =
  { index: index, key: key, footprint: "", contends: contends, seeded: false, us: 1000 }

// A footprint shape drawn from its seed: the same shape is the same corpus, test for test.
pub fn hypothetical(h: Hypothetical) -> Corpus / {abort.raise} = {
  let cells = fold(
    range(0, h.cell_tests),
    { r: rng::new(h.seed), tests: [] },
    |acc: { r: rng::Rng, tests: List<Test> }, i: Int| {
      let (r, label) = rng::below(acc.r, max(h.labels, 1));
      {
        r: r,
        tests: push(
          acc.tests,
          drawn("hypothetical.cell" ++ int_to_string(i), len(acc.tests), [
            atom_at("cell", label, false),
            atom_at("cell", label, true),
          ]),
        ),
      }
    },
  );
  let shared = fold(
    range(0, h.shared_tests),
    cells,
    |acc: { r: rng::Rng, tests: List<Test> }, i: Int| {
      let (r, label) = rng::below(acc.r, max(h.shared_labels, 1));
      {
        r: r,
        tests: push(
          acc.tests,
          drawn("hypothetical.shared" ++ int_to_string(i), len(acc.tests), [
            atom_at("db", label, true),
          ]),
        ),
      }
    },
  );
  let all = fold(range(0, h.pure_tests), shared.tests, |tests: List<Test>, i: Int|
    push(tests, drawn("hypothetical.pure" ++ int_to_string(i), len(tests), [])));
  {
    root: "hypothetical " ++ int_to_string(h.cell_tests) ++ ":" ++ int_to_string(h.labels),
    tests: all,
    setup_us: 0,
    suite_us: None,
    sequential_us: None,
    runner: None,
  }
}

// `cells:labels`, as the line writes a hypothetical.
pub fn shape_of(
  text: String,
  shared: Int,
  pure: Int,
) -> Result<Hypothetical, String> / {abort.raise} =
  match string_split(text, ":") {
    [c, l] -> match ((product::count_of(c), product::count_of(l))) {
      (Some(cells), Some(labels)) ->
        Ok({
          cell_tests: cells,
          labels: labels,
          shared_tests: shared,
          shared_labels: 3,
          pure_tests: pure,
          seed: 1,
        }),
      _ -> Err("`--hypothetical " ++ text ++ "` is not two counts, `cells:labels`"),
    },
    _ -> Err("`--hypothetical " ++ text ++ "` is not `cells:labels`"),
  }

// --- A project, measured by the product --------------------------------------------------------

fn atoms_of(xs: List<Json>) -> List<Atom> =
  map(product::objects(xs), |a: Map<String, Json>|
    {
      effect: product::str_field(a, "effect"),
      resource: product::str_field(a, "resource"),
      writes: product::bool_field(a, "writes"),
    })

// One `ply test --json` run of every test in scope, nothing read from a cache.
fn suite_run(
  root: String,
  jobs: Int,
  std: Bool,
) -> Result<Map<String, Json>, String> / {process.spawn[ply], config.get[env], abort.raise} = {
  let base = [
    "test",
    ".",
    "--json",
    "--no-cache",
    "--jobs",
    int_to_string(jobs),
    "--color",
    "never",
  ];
  match product::document(product::ply(if std { push(base, "--std") } else { base }, root)) {
    Err(why) -> Err(why),
    Ok(Object(m)) -> match product::field(m, "summary") {
      Err(e) -> Err(e),
      Ok(summary) -> if product::int_field(summary, "failed") > 0 {
        Err(
          int_to_string(product::int_field(summary, "failed"))
            ++ " tests failed while being timed; a suite that is not green times nothing",
        )
      } else { Ok(m) },
    },
    Ok(_) -> Err("the test report is not an object"),
  }
}

pub fn corpus_of(
  root: String,
  one: Map<String, Json>,
  suite_us: Option<Int>,
) -> Result<Corpus, String> =
  match product::field(one, "selection") {
    Err(e) -> Err(e),
    Ok(selection) -> {
      let durations = fold(
        product::objects(product::array_field(one, "results")),
        map_new(),
        |m: Map<Int, Int>, r: Map<String, Json>|
          map_insert(
            m,
            product::int_field(r, "index"),
            product::us_of_ms(product::decimal_field(r, "duration_ms")),
          ),
      );
      let tests = map(
        product::objects(product::array_field(selection, "tests")),
        |t: Map<String, Json>| {
          let index = product::int_field(t, "index");
          {
            index: index,
            key: product::str_field(t, "key"),
            footprint: product::str_field(t, "footprint"),
            contends: atoms_of(product::array_field(t, "contends")),
            seeded: product::bool_field(t, "seeded"),
            us: match map_get(durations, index) { Some(us) -> us, None -> 0 },
          }
        },
      );
      if len(tests) == 0 { Err("`" ++ root ++ "` declares no tests in scope") } else {
        let setup_us = match product::field(one, "backend") {
          Err(_) -> 0,
          Ok(b) ->
            ((match product::opt_int_field(b, "analysis_nanos") { Some(n) -> n, None -> 0 })
              + (match product::opt_int_field(b, "codegen_nanos") { Some(n) -> n, None -> 0 }))
              / 1000,
        };
        let sequential_us = match product::field(one, "summary") {
          Ok(summary) -> Some(product::us_of_ms(product::decimal_field(summary, "duration_ms"))),
          Err(_) -> None,
        };
        Ok({
          root: root,
          tests: tests,
          setup_us: setup_us,
          suite_us: suite_us,
          sequential_us: sequential_us,
          runner: Some(
            map(
              product::objects(product::array_field(selection, "groups")),
              |g: Map<String, Json>|
                map(product::array_field(g, "tests"), |x: Json|
                  match x {
                    Number(d) -> match int_of_decimal(d, Down) { Some(n) -> n, None -> -1 },
                    _ -> -1,
                  }),
            ),
          ),
        })
      }
    },
  }

// A project as the runner sees it: one pass on one worker for the per-test costs, free of contention,
// and one at `jobs` for the suite's own wall.
fn measured(
  root: String,
  jobs: Int,
  std: Bool,
) -> Result<Corpus, String> / {process.spawn[ply], config.get[env], abort.raise} =
  match suite_run(root, 1, std) {
    Err(why) -> Err(why),
    Ok(one) -> match suite_run(root, jobs, std) {
      Err(why) -> Err(why),
      Ok(many) -> {
        let suite_us = match product::field(many, "summary") {
          Ok(summary) -> Some(product::us_of_ms(product::decimal_field(summary, "duration_ms"))),
          Err(_) -> None,
        };
        corpus_of(root, one, suite_us)
      },
    },
  }

// --- The rows ------------------------------------------------------------------------------

fn criterion() -> report::Criterion = AtMost("newly_serialized", 0m)

pub fn cost_measurements(cost: Cost, corpus: Corpus) -> List<Measurement> / {abort.raise} = {
  let modelled = [
    number("tests", cost.tests, "tests"),
    number("isolated", cost.isolated, "tests"),
    number("pure", cost.pure, "tests"),
    number("seeded", cost.seeded, "tests"),
    number("cell", cost.world_backed, "tests"),
    number("newly_serialized", len(cost.newly), "tests"),
    number("groups_forked", cost.forked.groups, "groups"),
    number("groups_regions", cost.regions.groups, "groups"),
    number("after_first_forked", cost.forked.after_the_first_group, "tests"),
    number("after_first_regions", cost.regions.after_the_first_group, "tests"),
    ms_of_us("forked", cost.forked.makespan_us),
    ms_of_us("regions", cost.regions.makespan_us),
    exact("ratio", ratio(cost), "×"),
    ms_of_us("critical_forked", cost.forked.critical_path_us),
    ms_of_us("critical_regions", cost.regions.critical_path_us),
    ms_of_us("setup", corpus.setup_us),
  ];
  match corpus.suite_us {
    None -> modelled,
    Some(suite) -> {
      let timed = push(modelled, ms_of_us("suite", suite));
      let with_sequential = match corpus.sequential_us {
        Some(s) -> push(timed, ms_of_us("sequential", s)),
        None -> timed,
      };
      // How far the region model's wall is from the one the product measured, which is what makes
      // the other column believable.
      if suite <= 0 { with_sequential } else {
        push(
          with_sequential,
          exact(
            "model_error",
            decimal_div(
              decimal_of_int((cost.regions.makespan_us - suite) * 100),
              decimal_of_int(suite),
              1,
              HalfEven,
            ),
            "%",
          ),
        )
      }
    },
  }
}

// The effects that reach any test's footprint: the contended ones, and the seed a simulated one is
// handed.
pub fn effects_present(corpus: Corpus) -> List<String> = {
  let names = fold(corpus.tests, map_new(), |m: Map<String, Bool>, t: Test| {
    let with_atoms = fold(t.contends, m, |inner: Map<String, Bool>, a: Atom|
      map_insert(inner, a.effect, true));
    if t.seeded {
      fold(ambient_effects(), with_atoms, |inner: Map<String, Bool>, e: String|
        map_insert(inner, e, true))
    } else { with_atoms }
  });
  map_keys(names)
}

fn cost_detail(cost: Cost, corpus: Corpus) -> Json =
  object([
    { key: "effects", value: array(map(effects_present(corpus), |e: String| Str(e))) },
    {
      key: "newly_serialized",
      value: array(
        map(cost.newly, |n: Newly|
          object([
            { key: "key", value: Str(n.key) },
            { key: "footprint", value: Str(n.footprint) },
            { key: "conflicts_with", value: Str(n.conflicts_with) },
          ])),
      ),
    },
  ])

pub fn cost_row(corpus: Corpus, jobs: Int) -> Row / {abort.raise} = {
  let cost = analyse(corpus, jobs);
  {
    ..row(corpus.root, criterion(), cost_measurements(cost, corpus)),
    detail: cost_detail(cost, corpus),
  }
}

fn agreement_criterion() -> report::Criterion =
  holding(
    "the region model colours the tests into the classes the runner did",
    ["agrees"],
    |vs: List<Decimal>| vs == [1m],
  )

// The model's colouring against the runner's own: the one place the two could drift apart.
pub fn agreement_row(corpus: Corpus) -> Row / {abort.raise} = {
  let name = corpus.root ++ " colouring";
  match corpus.runner {
    None -> untaken(name, agreement_criterion(), "the runner coloured nothing"),
    Some(runner) -> {
      let modelled = colour(corpus.tests, in_regions);
      row(name, agreement_criterion(), [
        number("agrees", report::one_if(modelled == runner), ""),
        number("groups_regions", len(modelled), "groups"),
        number("groups_runner", len(runner), "groups"),
      ])
    },
  }
}

pub type Args = {
  roots: List<String>,
  jobs: Int,
  hypothetical: List<String>,
  hypothetical_shared: Int,
  hypothetical_pure: Int,
  std: Bool,
}

// Every root measured and every hypothetical drawn, a row or two each, in the order they were asked
// for.
pub fn run(
  args: Args,
) -> Result<report::Report, String> / {process.spawn[ply], config.get[env], fs.read[repo], abort.raise} = {
  let roots = filter(args.roots, |r: String| r != "");
  if len(roots) == 0 && len(args.hypothetical) == 0 {
    Err("nothing to analyse: pass a project root or `--hypothetical cells:labels`")
  } else {
    match fold(
        args.hypothetical,
        Ok([]),
        |acc: Result<List<Hypothetical>, String>, text: String|
          match acc {
            Err(e) -> Err(e),
            Ok(done) -> match shape_of(text, args.hypothetical_shared, args.hypothetical_pure) {
              Err(e) -> Err(e),
              Ok(h) -> Ok(push(done, h)),
            },
          },
      ) {
      Err(why) -> Err(why),
      Ok(shapes) -> {
        let measured_rows = fold(roots, [], |acc: List<Row>, root: String|
          match measured(root, args.jobs, args.std) {
            Err(why) ->
              push(
                push(acc, untaken(root, criterion(), why)),
                untaken(root ++ " colouring", agreement_criterion(), why),
              ),
            Ok(c) -> push(push(acc, cost_row(c, args.jobs)), agreement_row(c)),
          });
        let drawn_rows = map(shapes, |h: Hypothetical| cost_row(hypothetical(h), args.jobs));
        report::made(
          "regions",
          "region isolation at " ++ int_to_string(args.jobs)
            ++ " workers: the forkable world against the region model",
          fold(drawn_rows, measured_rows, |acc: List<Row>, r: Row| push(acc, r)),
          [{ key: "jobs", value: Number(decimal_of_int(args.jobs)) }],
        )
      },
    }
  }
}

// --- Tests ------------------------------------------------------------------------------------

fn cell(label: String) -> Atom = { effect: "cell", resource: label, writes: true }

fn db(label: String) -> Atom = { effect: "db", resource: label, writes: true }

fn a_corpus(tests: List<Test>) -> Corpus =
  { root: "unit", tests: tests, setup_us: 0, suite_us: None, sequential_us: None, runner: None }

fn test_at(index: Int, contends: List<Atom>) -> Test =
  {
    index: index,
    key: "m.t" ++ int_to_string(index),
    footprint: "",
    contends: contends,
    seeded: false,
    us: 1000,
  }

test "two tests sharing one cell label split without forking" {
  let cost = analyse(a_corpus([test_at(0, [cell("users")]), test_at(1, [cell("users")])]), 8);
  assert_eq(cost.isolated, 2);
  assert_eq(cost.forked.groups, 1);
  assert_eq(cost.regions.groups, 2);
  assert_eq(len(cost.newly), 2);
  assert_eq(ratio(cost), 2.00m)
}

test "pure tests cost nothing under either model" {
  let tests = fold(range(1, 101), [test_at(0, [db("a")])], |acc: List<Test>, i: Int|
    push(acc, test_at(i, [])));
  let cost = analyse(a_corpus(tests), 8);
  assert_eq(len(cost.newly), 0);
  assert_eq(cost.forked.groups, cost.regions.groups);
  assert_eq(cost.pure, 100)
}

test "a seeded test is untouched by the change" {
  let seeded = |i: Int| -> Test { { ..test_at(i, []), seeded: true } };
  let cost = analyse(a_corpus([seeded(0), seeded(1)]), 8);
  assert_eq(len(cost.newly), 0);
  assert_eq(cost.seeded, 2);
  assert_eq(cost.regions.groups, 1)
}

test "a lone cell label does not serialize" {
  let cost = analyse(a_corpus([test_at(0, [cell("users")]), test_at(1, [cell("orders")])]), 8);
  assert_eq(cost.world_backed, 2);
  assert_eq(len(cost.newly), 0);
  assert_eq(cost.regions.groups, 1)
}

test "the wall-clock model charges a barrier between groups" {
  let us = fold(range(0, 5), map_new(), |m: Map<Int, Int>, i: Int|
    map_insert(m, i, if i == 4 { 10 } else { 1 }));
  let groups = [[0, 1, 2, 3], [4]];
  assert_eq(makespan(groups, us, 2, 0), 2 + 10);
  assert_eq(makespan(groups, us, 0, 0), 1 + 10);
  assert_eq(makespan(groups, us, 1, 0), 4 + 10);
  let pure = a_corpus(
    map(range(0, 4), |i: Int| { ..test_at(i, []), us: if i == 0 { 4000 } else { 1000 } }),
  );
  assert_eq(analyse(pure, 8).forked.makespan_us, 4000);
  assert_eq(
    makespan(
      [[0], [1], [2], [3]],
      fold(pure.tests, map_new(), |m: Map<Int, Int>, x: Test| map_insert(m, x.index, x.us)),
      8,
      0,
    ),
    7000,
  )
}

test "a hypothetical corpus is a function of its shape" {
  let shape = {
    cell_tests: 40,
    labels: 4,
    shared_tests: 10,
    shared_labels: 3,
    pure_tests: 100,
    seed: 7,
  };
  let a = hypothetical(shape);
  assert_eq(
    map(a.tests, |x: Test| x.contends),
    map(hypothetical(shape).tests, |x: Test| x.contends),
  );
  assert_eq(len(a.tests), 150)
}

test "the exposure is a group per test only at one label" {
  let at_labels = |labels: Int| -> Cost {
    analyse(
      hypothetical({
        cell_tests: 176,
        labels: labels,
        shared_tests: 10,
        shared_labels: 3,
        pure_tests: 165,
        seed: 1,
      }),
      8,
    )
  };
  assert_eq(at_labels(1).regions.groups, 176);
  assert(at_labels(8).regions.groups <= 30);
  // Collisions, not the count.
  assert_eq(len(at_labels(176).newly), 118)
}

test "a hypothetical is two counts" {
  assert_eq(
    match shape_of("12:3", 10, 165) {
      Ok(h) -> (h.cell_tests, h.labels, h.pure_tests),
      Err(_) -> (0, 0, 0),
    },
    (12, 3, 165),
  );
  assert(match shape_of("12", 10, 165) { Err(_) -> true, Ok(_) -> false });
  assert(match shape_of("12:x", 10, 165) { Err(_) -> true, Ok(_) -> false })
}

test "the rows read a project's footprints off the product's report" {
  let report = "{\"selection\": {\"tests\": [{\"index\": 0, \"key\": \"m.a\", \"footprint\": \"cell.write[users]\", \"seeded\": false, \"contends\": [{\"effect\": \"cell\", \"resource\": \"users\", \"writes\": true}]}, {\"index\": 1, \"key\": \"m.b\", \"footprint\": \"cell.write[users]\", \"seeded\": false, \"contends\": [{\"effect\": \"cell\", \"resource\": \"users\", \"writes\": true}]}], \"groups\": [{\"tests\": [0]}, {\"tests\": [1]}]}, \"results\": [{\"index\": 0, \"duration_ms\": 2.0}, {\"index\": 1, \"duration_ms\": 1.0}], \"summary\": {\"duration_ms\": 3.5}}";
  match json::parse(bytes_of_string(report)) {
    Ok(Object(m)) -> match corpus_of("cells", m, Some(3000)) {
      Err(why) -> panic(why),
      Ok(c) -> {
        assert_eq(map(c.tests, |x: Test| x.us), [2000, 1000]);
        assert_eq(c.sequential_us, Some(3500));
        assert_eq(effects_present(c), ["cell"]);
        let judged = report::judge([cost_row(c, 4), agreement_row(c)]);
        assert_eq(map(judged, |j: report::Judged| report::passed(j)), [false, true])
      },
    },
    _ -> panic("the report is JSON"),
  }
}
