// The statistics a row is read off: a percentile of a sample, the best of repeated runs, a rate,
// and the fixed-point text a table shows them in.

import std.list

// The nearest-rank percentile: the smallest value at least `p` percent of the sample is no greater
// than. An empty sample has none, and a row that needs one says so rather than reading a zero.
pub fn percentile(xs: List<Int>, p: Int) -> Option<Int> =
  if len(xs) == 0 { None } else {
    let rank = (p * len(xs) + 99) / 100;
    list_at(list::sort(xs), if rank < 1 { 0 }
    else if rank > len(xs) { len(xs) - 1 }
    else { rank - 1 })
  }

pub fn percentile_or_zero(xs: List<Int>, p: Int) -> Int =
  match percentile(xs, p) { Some(v) -> v, None -> 0 }

// The fastest of repeated runs: a bench reports its best case, and the repeats are what make the
// best a measurement rather than a reading.
pub fn best(xs: List<Int>) -> Option<Int> =
  fold(xs, None, |acc: Option<Int>, x: Int|
    match acc { None -> Some(x), Some(b) -> Some(if x < b { x } else { b }) })

// The run of `runs` whose `key` is smallest, the first of equals.
pub fn best_by<a>(runs: List<a>, key: (a) -> Int) -> Option<a> =
  fold(runs, None, |acc: Option<a>, r: a|
    match acc { None -> Some(r), Some(b) -> Some(if key(r) < key(b) { r } else { b }) })

// Work per second, from how many and the microseconds they took.
pub fn per_second(count: Int, micros: Int) -> Int =
  if micros <= 0 { 0 } else { count * 1000000 / micros }

// Nanoseconds per call, from `calls` calls that took `micros` microseconds.
pub fn nanos_each(micros: Int, calls: Int) -> Int =
  if calls <= 0 { 0 } else { micros * 1000 / calls }

// `a` as a percentage of `b`, rounded down.
pub fn percent(a: Int, b: Int) -> Int = if b <= 0 { 0 } else { a * 100 / b }

// `n` thousandths as text with `places` of its decimals: `fixed(12345, 2)` is `12.34`.
pub fn fixed(n: Int, places: Int) -> String = {
  let whole = n / 1000;
  let fraction = (if n < 0 { 0 - n } else { n }) % 1000;
  let digits = string_slice(padded(fraction), 0, places);
  if places <= 0 { int_to_string(whole) } else { int_to_string(whole) ++ "." ++ digits }
}

fn padded(fraction: Int) -> String =
  if fraction < 10 { "00" ++ int_to_string(fraction) }
  else if fraction < 100 { "0" ++ int_to_string(fraction) }
  else { int_to_string(fraction) }

// --- Tests ---------------------------------------------------------------------------------

test "percentiles are nearest-rank over the sample" {
  let xs = list::reverse(range(1, 101));
  assert_eq(percentile(xs, 50), Some(50));
  assert_eq(percentile(xs, 95), Some(95));
  assert_eq(percentile(xs, 99), Some(99));
  assert_eq(percentile(xs, 100), Some(100));
  assert_eq(percentile([7], 99), Some(7));
  assert_eq(percentile([], 50), None)
}

test "the best of repeats is the smallest, and a keyed best keeps the first of equals" {
  assert_eq(best([30, 10, 20]), Some(10));
  assert_eq(best([]), None);
  let runs = [{ id: 1, us: 9 }, { id: 2, us: 4 }, { id: 3, us: 4 }];
  assert_eq(best_by(runs, |r: { id: Int, us: Int }| r.us), Some({ id: 2, us: 4 }))
}

test "a rate is the count over the time, and no time is no rate" {
  assert_eq(per_second(500, 250000), 2000);
  assert_eq(per_second(5, 0), 0);
  assert_eq(nanos_each(3, 2000), 1);
  assert_eq(percent(1, 4), 25)
}

test "fixed-point text keeps the places it is asked for" {
  assert_eq(fixed(12345, 2), "12.34");
  assert_eq(fixed(1005, 1), "1.0");
  assert_eq(fixed(7, 3), "0.007");
  assert_eq(fixed(42000, 0), "42")
}
