import std.pkg (Manifest)

// The corpus: workloads the language is measured against, as a program. Its entry is `main`, the one
// `cmd` declares, as the CLI's is; `benches/corpus.sh` runs it. The CLI's modules answer here as
// `cli.*`; the suite's schedule and the prover's obligations are read from their own packages, as the
// CLI reads them.
fn package() -> Manifest = {
  name: "corpus",
  version: { major: 0, minor: 1, patch: 0 },
  prefix: None,
  runtime: { major: 0, minor: 16, patch: 0 },
  dependencies: [
    {
      name: "cli",
      prefix: None,
      min: { major: 0, minor: 1, patch: 0 },
      source: Path("../../ply-cli/ply"),
    },
    {
      name: "suite",
      prefix: None,
      min: { major: 0, minor: 1, patch: 0 },
      source: Path("../../ply-test/ply"),
    },
    {
      name: "prove",
      prefix: Some("proof"),
      min: { major: 0, minor: 1, patch: 0 },
      source: Path("../../ply-prove/ply"),
    },
  ],
  entry: None,
}
