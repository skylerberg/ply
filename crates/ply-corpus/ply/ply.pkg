import std.pkg (Manifest)

// The corpus: workloads the language is measured against, as a package. The first external
// consumer of another unit's code -- the CLI's modules answer here as `cli.*`.
fn package() -> Manifest = {
  name: "corpus",
  version: { major: 0, minor: 1, patch: 0 },
  prefix: None,
  runtime: { major: 0, minor: 16, patch: 0 },
  dependencies: [
    {
      name: "cli",
      prefix: None,
      min: { major: 0, minor: 1, patch: 0 },
      source: Path("../../ply-cli/ply"),
    },
  ],
  entry: None,
}
