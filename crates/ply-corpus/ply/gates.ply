// A row of a served measurement: its criterion, declared before anything runs, the verdict of that
// criterion on the numbers, and the numbers as the evidence. A table is the rows one question asked,
// and a report is its tables as text and as JSON.

import std.json
import std.json (Json, Str, Number, Bool, object, array)

// One number a verdict rests on; its key names its unit.
pub type Figure = { key: String, value: Int }

// What the numbers said of a criterion: it held, it did not and why, or there were no numbers to
// judge it by and why not.
pub type Verdict = | Pass | Fail(String) | Inconclusive(String)

pub type Row = { name: String, criterion: String, verdict: Verdict, figures: List<Figure> }

pub type Table = { title: String, rows: List<Row> }

pub fn figure(key: String, value: Int) -> Figure = { key: key, value: value }

pub fn row(name: String, criterion: String, verdict: Verdict, figures: List<Figure>) -> Row =
  { name: name, criterion: criterion, verdict: verdict, figures: figures }

// A pass when the claim holds, or the failure that says what the numbers did instead.
pub fn holds(claim: Bool, otherwise: String) -> Verdict = if claim { Pass } else { Fail(otherwise) }

// Both verdicts: a failure wins over everything, and an inconclusive one over a pass.
pub fn both(a: Verdict, b: Verdict) -> Verdict =
  match a {
    Fail(why) -> Fail(why),
    Inconclusive(why) -> match b { Fail(other) -> Fail(other), _ -> Inconclusive(why) },
    Pass -> b,
  }

pub fn passed(r: Row) -> Bool = match r.verdict { Pass -> true, _ -> false }

pub fn failed(r: Row) -> Bool = match r.verdict { Fail(_) -> true, _ -> false }

// A report stands when no row failed; an inconclusive row says what was not measured and why.
pub fn none_failed(tables: List<Table>) -> Bool =
  fold(tables, true, |ok: Bool, t: Table|
    fold(t.rows, ok, |inner: Bool, r: Row| inner && !failed(r)))

// --- The report ------------------------------------------------------------------------

fn number(n: Int) -> Json = Number(decimal_of_int(n))

fn row_json(r: Row) -> Json =
  object([
    { key: "name", value: Str(r.name) },
    { key: "criterion", value: Str(r.criterion) },
    { key: "passed", value: Bool(passed(r)) },
    { key: "verdict", value: Str(verdict_text(r.verdict)) },
    {
      key: "figures",
      value: object(map(r.figures, |f: Figure| { key: f.key, value: number(f.value) })),
    },
  ])

pub fn tables_json(tables: List<Table>) -> Json =
  array(
    map(tables, |t: Table|
      object([
        { key: "title", value: Str(t.title) },
        { key: "rows", value: array(map(t.rows, row_json)) },
      ])),
  )

pub fn verdict_text(v: Verdict) -> String =
  match v {
    Pass -> "pass",
    Fail(why) -> "FAIL: " ++ why,
    Inconclusive(why) -> "inconclusive: " ++ why,
  }

fn figures_text(fs: List<Figure>) -> String =
  fold(fs, "", |acc: String, f: Figure|
    (if acc == "" { "" } else { acc ++ " · " }) ++ f.key ++ " " ++ int_to_string(f.value))

fn row_text(r: Row) -> String =
  "  " ++ (match r.verdict { Pass -> "✓", Fail(_) -> "✗", Inconclusive(_) -> "?" }) ++ "  "
    ++ r.name
    ++ " — "
    ++ r.criterion
    ++ (match r.verdict {
      Pass -> "",
      Fail(why) -> "\n       " ++ why,
      Inconclusive(why) -> "\n       " ++ why,
    })
    ++ (if len(r.figures) == 0 { "" } else { "\n       " ++ figures_text(r.figures) })
    ++ "\n"

pub fn render(title: String, tables: List<Table>) -> String =
  fold(tables, title ++ "\n", |acc: String, t: Table|
    fold(t.rows, acc ++ "\n" ++ t.title ++ "\n", |inner: String, r: Row| inner ++ row_text(r)))

// --- Tests ---------------------------------------------------------------------------------

test "a verdict is its criterion's: a failure wins, then an inconclusive one" {
  assert_eq(holds(true, "no"), Pass);
  assert_eq(both(holds(false, "first"), holds(false, "second")), Fail("first"));
  assert_eq(both(Pass, holds(false, "second")), Fail("second"));
  assert_eq(both(Inconclusive("unmeasured"), Pass), Inconclusive("unmeasured"));
  assert_eq(both(Inconclusive("unmeasured"), Fail("slow")), Fail("slow"))
}

test "a report shows each row's verdict, criterion and numbers, as text and as JSON" {
  let good = row("warm", "every request answered 200", Pass, [figure("per_second", 1200)]);
  let bad = row("cold", "at least the floor's rate", Fail("half of it"), []);
  let unmeasured = row("floor", "every request answered 200", Inconclusive("not bound"), []);
  let tables = [{ title: "load", rows: [good, bad, unmeasured] }];
  let text = render("serve", tables);
  assert(string_contains(text, "✓  warm — every request answered 200\n       per_second 1200"));
  assert(string_contains(text, "✗  cold — at least the floor's rate\n       half of it"));
  assert(string_contains(text, "?  floor — every request answered 200\n       not bound"));
  let written = json::to_string(tables_json(tables));
  assert(string_contains(written, "\"figures\":{\"per_second\":1200}"));
  assert(string_contains(written, "\"verdict\":\"FAIL: half of it\""));
  assert(string_contains(written, "\"verdict\":\"inconclusive: not bound\""));
  assert(!none_failed(tables));
  // A row that could not be judged fails nothing.
  assert(none_failed([{ title: "load", rows: [good, unmeasured] }]))
}
