// The generator: a spec and a seed to a corpus on disk, verified by the product. The corpus is
// a function of its seed, so the seed is the artifact worth keeping rather than the megabytes
// it expands to.

import gbuild
import gemit
import gwrite
import spine
import spine (under)
import std.bytes (hex_of)
import std.hash (blake3)
import std.json (Json, Str, Number, Bool, Null, Object, object, array)
import std.json
import std.fs (fs)
import std.fs
import std.process (process, exit_code)
import std.config (config)

// --- The spec --------------------------------------------------------------------------------

// The shape a corpus takes where the line says nothing: `gen`'s defaults, and what a sweep's sizes
// are laid over.
pub fn default_spec() -> gbuild::Spec =
  {
    seed: 1,
    modules: 20,
    defs_per_module: 25,
    tests: 200,
    depth: 4,
    tables: 12,
    regions: 6,
    effect_fraction: 0.35,
    nondet_fraction: 0.03,
    hub_modules: 3,
    max_weight: 192,
    concurrent_tests: 0,
    tasks_per_test: 3,
    steps_per_task: 2,
    conflict_density: 0.5,
    spec_fraction: 0.0,
    specimens_per_module: 0,
  }

fn fraction(f: Float) -> Bool = f >= 0.0 && f <= 1.0

pub fn validate(spec: gbuild::Spec) -> Result<gbuild::Spec, String> =
  if spec.modules == 0 { Err("a corpus needs at least one module") }
  else if spec.defs_per_module == 0 { Err("a module needs at least one definition") }
  else if spec.depth == 0 { Err("`--depth` must be at least 1") }
  else if spec.depth > spec.modules {
    Err(
      "`--depth " ++ int_to_string(spec.depth) ++ "` exceeds `--modules "
        ++ int_to_string(spec.modules)
        ++ "`: every layer must hold at least one module",
    )
  } else if spec.tables == 0 { Err("`--tables` must be at least 1") }
  else if spec.regions == 0 { Err("`--regions` must be at least 1") }
  else if !fraction(spec.effect_fraction) { Err("`--effect-fraction` must be between 0 and 1") }
  else if !fraction(spec.nondet_fraction) { Err("`--nondet-fraction` must be between 0 and 1") }
  else if spec.max_weight < 8 { Err("`--max-weight` below 8 leaves no room for a call graph") }
  else if spec.concurrent_tests > 0 && spec.tasks_per_test < 2 {
    Err("`--tasks-per-test` below 2 has nothing to interleave")
  } else if spec.concurrent_tests > 0 && spec.steps_per_task == 0 {
    Err("`--steps-per-task` must be at least 1")
  } else if !fraction(spec.conflict_density) { Err("`--conflict-density` must be between 0 and 1") }
  else if !fraction(spec.spec_fraction) { Err("`--spec-fraction` must be between 0 and 1") }
  else { Ok(spec) }

// --- The subcommand --------------------------------------------------------------------------------

// What `gen` wrote: where, the manifest it wrote beside the corpus, and whether the product
// compiled it and passed its tests.
pub type Generated = { root: String, manifest: Json, verified: Bool }

// Write the corpus to `dir`, a path relative to the working directory, then compile and run it to
// prove it is real — unless told to skip the proof.
pub fn run(
  dir: String,
  spec: gbuild::Spec,
  no_verify: Bool,
) -> Result<Generated, String> / {fs.read[work], fs.write[work], process.spawn[ply], config.get[env], abort.raise} =
  match validate(spec) {
    Err(e) -> Err(e),
    Ok(valid) -> {
      let corpus = gbuild::generate(valid);
      let files = gemit::emit(corpus);
      let bytes = fold(files, 0, |acc: Int, f: gemit::Emitted|
        acc + bytes_len(bytes_of_string(f.text)));
      match gwrite::manifest_for(valid, corpus, len(files), bytes) {
        Err(e) -> Err(e),
        Ok(manifest) -> match prepare(dir) {
          Err(e) -> Err(e),
          Ok(_) -> {
            let _ = map(files, |f: gemit::Emitted| write_at(dir, f));
            let manifest_json = gwrite::manifest_json(valid, corpus, manifest);
            let _ = fs.write_file[work](
              under(dir, "corpus.json"),
              bytes_of_string(json::to_string(manifest_json) ++ "\n"),
            );
            let verified = if no_verify { Ok(false) } else { verify(dir) };
            match verified {
              Err(e) -> Err(e),
              Ok(v) -> Ok({ root: dir, manifest: manifest_json, verified: v }),
            }
          },
        },
      }
    },
  }

fn write_at(
  dir: String,
  f: gemit::Emitted,
) -> Bool / {fs.write_file[work], fs.create_dir[work], abort.raise} = {
  let path = under(dir, f.path);
  let _ = fs.create_dir[work](parent_of(path));
  fs.write_file[work](path, bytes_of_string(f.text))
}

fn parent_of(path: String) -> String = {
  let b = bytes_of_string(path);
  let slashes = fold(range(0, bytes_len(b)), [], |acc: List<Int>, i: Int|
    if bytes_at(b, i) == 47 { push(acc, i) } else { acc });
  match list_at(slashes, len(slashes) - 1) {
    Some(i) -> string_of_bytes(bytes_slice(b, 0, i)),
    None -> ".",
  }
}

// The directory must be empty, or a corpus this tool already wrote.
fn prepare(
  dir: String,
) -> Result<Unit, String> / {fs.read_file[work], fs.list_dir[work], fs.kind[work], fs.resolved[work], fs.remove[work], fs.create_dir[work], abort.raise} =
  match fs.resolved[work](dir) {
    fs::Missing -> Ok(mk_dirs(dir)),
    fs::Dir -> {
      let ours = fs.kind[work](under(dir, "corpus.json"));
      let entries = match fs.list_dir[work](dir) { Some(e) -> e, None -> [] };
      if ours != fs::File && len(entries) > 0 {
        Err("`" ++ dir ++ "` is not empty and holds no `corpus.json`; refusing to overwrite it")
      } else {
        let _ = map(entries, |name: String| remove_at(under(dir, name)));
        Ok(())
      }
    },
    _ -> Err("`" ++ dir ++ "` exists and is not a directory"),
  }

// `dir` and every directory above it, made where missing.
pub fn mk_dirs(dir: String) -> Unit / {fs.create_dir[work], abort.raise} = {
  let b = bytes_of_string(dir);
  let _ = fold(range(0, bytes_len(b)), 0, |acc: Int, i: Int|
    if bytes_at(b, i) == 47 && fs.create_dir[work](string_of_bytes(bytes_slice(b, 0, i))) {
      acc + 1
    } else { acc });
  let _ = fs.create_dir[work](dir);
  ()
}

fn remove_at(path: String) -> Unit / {fs.kind[work], fs.list_dir[work], fs.remove[work]} =
  match fs.kind[work](path) {
    fs::Dir -> {
      let entries = match fs.list_dir[work](path) { Some(e) -> e, None -> [] };
      let _ = map(entries, |name: String| remove_at(under(path, name)));
      let _ = fs.remove[work](path);
      ()
    },
    _ -> {
      let _ = fs.remove[work](path);
      ()
    },
  }

// Compile and run it, the way a user would.
pub fn verify(dir: String) -> Result<Bool, String> / {process.spawn[ply], config.get[env]} = {
  let done = spine::ply(["test", ".", "--json", "--color", "never"], dir);
  match exit_code(done) {
    Some(0) -> Ok(true),
    Some(code) ->
      Err(
        "the corpus does not check: ply test exited " ++ int_to_string(code) ++ "\n"
          ++ string_of_bytes_lossy(done.err),
      ),
    None -> Err("ply was signalled: " ++ string_of_bytes_lossy(done.err)),
  }
}

// --- What it says -----------------------------------------------------------------------------

pub fn report_json(g: Generated) -> Json =
  object([
    { key: "root", value: Str(g.root) },
    { key: "manifest", value: g.manifest },
    { key: "verified", value: Bool(g.verified) },
  ])

fn count(m: Map<String, Json>, key: String) -> String = int_to_string(spine::int_field(m, key))

fn section(m: Map<String, Json>, key: String) -> Map<String, Json> =
  match spine::field(m, key) { Ok(inner) -> inner, Err(_) -> map_new() }

// A fraction to two places, as the summary prints the manifest's readings.
pub fn two_places(m: Map<String, Json>, key: String) -> String = {
  let hundredths = match map_get(m, key) {
    Some(Number(d)) -> match int_of_decimal(
        decimal_div(
          d,
          decimal_div(decimal_of_int(1), decimal_of_int(100), 2, HalfEven),
          0,
          HalfEven,
        ),
        Down,
      ) {
      Some(n) -> n,
      None -> 0,
    },
    _ -> 0,
  };
  let cents = hundredths % 100;
  int_to_string(hundredths / 100) ++ "." ++ (if cents < 10 { "0" } else { "" })
    ++ int_to_string(cents)
}

// What a reader is told about the corpus `gen` wrote, read off the manifest it wrote.
pub fn summary(g: Generated) -> String = {
  let m = match g.manifest { Object(fields) -> fields, _ -> map_new() };
  let c = section(m, "concurrency");
  let sp = section(m, "specs");
  let shape = "  " ++ count(m, "modules") ++ " modules · " ++ count(m, "definitions")
    ++ " definitions ("
    ++ count(m, "effectful_definitions")
    ++ " effectful) · "
    ++ count(m, "tests")
    ++ " tests ("
    ++ count(m, "nondet_tests")
    ++ " nondet)\n";
  let concurrent = if spine::int_field(c, "tests") > 0 {
    "  " ++ count(c, "tests") ++ " concurrent tests · " ++ count(c, "tasks_per_test")
      ++ " tasks × "
      ++ count(c, "steps_per_task")
      ++ " steps over "
      ++ count(c, "shards_per_test")
      ++ " shards · contention "
      ++ two_places(c, "contention")
      ++ " (asked "
      ++ two_places(c, "conflict_density")
      ++ ")\n"
  } else { "" };
  let specs = if spine::int_field(sp, "obligations") > 0 {
    "  " ++ count(sp, "specified_definitions") ++ " definitions carry an obligation · "
      ++ count(sp, "unspecified_definitions")
      ++ " do not\n"
      ++ "  "
      ++ count(sp, "obligations")
      ++ " obligations ("
      ++ count(sp, "laws")
      ++ " laws) · built to be "
      ++ count(sp, "decided")
      ++ " decided · "
      ++ count(sp, "sampled")
      ++ " sampled · "
      ++ count(sp, "gaps")
      ++ " gaps\n"
  } else { "" };
  let size = "  " ++ int_to_string(spine::int_field(m, "bytes") / 1024)
    ++ " KiB of source · mean out-degree "
    ++ two_places(m, "mean_out_degree")
    ++ " · "
    ++ count(m, "distinct_resources")
    ++ " distinct resources\n";
  let verdict = if g.verified { "  verified: the corpus compiles and its tests pass" }
  else { "  not verified (--no-verify)" };
  "wrote " ++ g.root ++ "\n" ++ shape ++ concurrent ++ specs ++ size ++ verdict
}

// --- Tests ---------------------------------------------------------------------------------------

// The corpus a spec generates, as the files `gen` writes and the manifest it writes beside them.
fn generated(spec: gbuild::Spec) -> (List<gemit::Emitted>, gwrite::Manifest) = {
  let corpus = gbuild::generate(spec);
  let files = gemit::emit(corpus);
  let bytes = fold(files, 0, |acc: Int, f: gemit::Emitted|
    acc + bytes_len(bytes_of_string(f.text)));
  match gwrite::manifest_for(spec, corpus, len(files), bytes) {
    Ok(manifest) -> (files, manifest),
    Err(why) -> panic(why),
  }
}

// Every file's path and text, each closed by a zero byte, in the order `gen` writes them.
fn digest_of(files: List<gemit::Emitted>) -> String =
  hex_of(
    blake3(
      bytes_concat_all(
        fold(files, [], |acc: List<Bytes>, f: gemit::Emitted|
          push(
            push(push(push(acc, bytes_of_string(f.path)), b"\0"), bytes_of_string(f.text)),
            b"\0",
          )),
      ),
    ),
  )

// The corpus a seed produces is a function of the seed, and these are the function's current values;
// when the generator changes on purpose, re-take them.
test "the seed-1 corpus is pinned" {
  let (files, manifest) = generated({
    ..default_spec(),
    seed: 1,
    modules: 4,
    defs_per_module: 5,
    tests: 8,
    depth: 2,
    tables: 3,
    regions: 2,
  });
  assert_eq(digest_of(files), "ab4868d2f6b44d5bc0c7117f3dd21359034931aca2956dd5cc3c0eb9ed0c94de");
  assert_eq(manifest.hub_edit.dependents, 9);
  assert_eq(manifest.leaf_edit.dependents, 1);
  assert_eq(manifest.rename_symbol, "render_11")
}

test "the seed-7 corpus is pinned" {
  let (files, manifest) = generated({
    ..default_spec(),
    seed: 7,
    modules: 6,
    defs_per_module: 8,
    tests: 12,
    depth: 3,
    tables: 4,
    regions: 3,
    hub_modules: 2,
    concurrent_tests: 2,
    spec_fraction: 0.5,
    specimens_per_module: 1,
  });
  assert_eq(digest_of(files), "c2e0cba4f57a689b83ff4d16c158d28bd8ac5e3d4762327852602a84d03c3be9");
  assert_eq(manifest.hub_edit.dependents, 8);
  assert_eq(manifest.leaf_edit.dependents, 1);
  assert_eq(manifest.rename_symbol, "merge_36")
}

fn refusal(spec: gbuild::Spec) -> String = match validate(spec) { Ok(_) -> "", Err(why) -> why }

test "the default spec is valid" { assert_eq(validate(default_spec()), Ok(default_spec())) }

test "a depth deeper than the module count is refused" {
  assert(string_contains(refusal({ ..default_spec(), modules: 3, depth: 8 }), "--depth 8"))
}

test "a concurrent test needs two tasks and a step" {
  assert(
    string_contains(
      refusal({ ..default_spec(), concurrent_tests: 4, tasks_per_test: 1 }),
      "nothing to interleave",
    ),
  );
  assert(
    string_contains(
      refusal({ ..default_spec(), concurrent_tests: 4, steps_per_task: 0 }),
      "--steps-per-task",
    ),
  );
  // A corpus with no concurrent tests is not constrained by their shape.
  assert_eq(
    refusal({ ..default_spec(), concurrent_tests: 0, tasks_per_test: 1, steps_per_task: 0 }),
    "",
  )
}

test "a fraction outside 0 to 1 is refused, whichever knob it is" {
  assert(string_contains(refusal({ ..default_spec(), effect_fraction: 1.5 }), "--effect-fraction"));
  assert(
    string_contains(refusal({ ..default_spec(), nondet_fraction: -0.1 }), "--nondet-fraction"),
  );
  assert(
    string_contains(refusal({ ..default_spec(), conflict_density: 2.0 }), "--conflict-density"),
  );
  assert(string_contains(refusal({ ..default_spec(), spec_fraction: 1.2 }), "--spec-fraction"))
}

test "a small spec generates the modules it asks for" {
  let (files, manifest) = generated({
    ..default_spec(),
    modules: 4,
    defs_per_module: 5,
    tests: 8,
    depth: 2,
    tables: 3,
    regions: 2,
  });
  assert(len(filter(files, |f: gemit::Emitted| string_starts_with(f.path, "store0/"))) > 0);
  assert_eq(manifest.modules, 4)
}

test "the summary reads the manifest a reader is told about" {
  let manifest = "{\"modules\":4,\"definitions\":20,\"effectful_definitions\":7,\"tests\":8,\"nondet_tests\":1,\"concurrency\":{\"tests\":2,\"tasks_per_test\":3,\"steps_per_task\":2,\"shards_per_test\":2,\"contention\":0.625,\"conflict_density\":0.5},\"specs\":{\"obligations\":0},\"bytes\":10240,\"mean_out_degree\":1.2345,\"distinct_resources\":5}";
  match json::parse(bytes_of_string(manifest)) {
    Err(_) -> assert(false),
    Ok(j) -> {
      let text = summary({ root: "out/m4", manifest: j, verified: false });
      assert(string_starts_with(text, "wrote out/m4\n  4 modules · 20 definitions (7 effectful)"));
      assert(
        string_contains(
          text,
          "2 concurrent tests · 3 tasks × 2 steps over 2 shards · contention 0.62 (asked 0.50)",
        ),
      );
      assert(!string_contains(text, "obligation"));
      assert(
        string_contains(text, "10 KiB of source · mean out-degree 1.23 · 5 distinct resources"),
      );
      assert(string_contains(text, "not verified (--no-verify)"))
    },
  }
}
