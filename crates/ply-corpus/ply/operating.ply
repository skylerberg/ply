// `operating`: what operating the service costs. The desk over postgres under each trace sink, with only
// `--trace` and where stderr goes moved; a stop with requests held in flight, under a drain long
// enough and one that runs out; a transaction open when the drain runs out, which the database has
// to end by the statement timeout the driver told it; and a deploy, one definition edited by
// `ply replace` and the builds before and after read by `ply build --diff`. The runner binds the
// libpq tool as `pg_floor`, whose lock session holds the row the transaction waits on; without a
// database, or without the tool, the rows that need one are inconclusive and say which.

import kit
import kit (Kit, Server, Sample, Stop)
import report
import report (Row, Criterion, Measurement, AtMost, holding, number, row, untaken)
import served
import served (NoTrace, JsonTrace)
import spine
import spine (under)
import stats
import std.config (config)
import std.db
import std.db (db, with_server)
import std.fs (fs)
import std.http
import std.json
import std.json (Json, Object, Number, Str, Bool, Null, array)
import std.net (net, send_all)
import std.process
import std.process (process, Finished, Ended, Exited, Signalled)
import std.random (entropy)
import std.time (time)
import std.list
import std.string

pub type Args = {
  repo: String,
  scratch: String,
  db: Option<String>,
  // Which sections: `sinks`, `drain`, `transaction` and `deploy`.
  sections: List<String>,
  // The loop the sinks table is served from, as `DESK_ACCEPT` names it.
  accept: String,
  concurrency: List<Int>,
  per_conn: Int,
  requests_per_point: Int,
  in_flight: List<Int>,
  drain_ms: Int,
  hold_ms: Int,
  repeats: Int,
}

pub fn sections() -> List<String> = ["sinks", "drain", "transaction", "deploy"]

fn requests_text(n: Int) -> String =
  if n == 1 { "1 request" } else { int_to_string(n) ++ " requests" }

fn one_if(claim: Bool) -> Int = if claim { 1 } else { 0 }

fn at_least_zero(ms: Int) -> Int = if ms < 0 { 0 } else { ms }

// How a run ended, as one number: its code, or as a shell reports a signal, 128 and the signal.
pub fn code_of(e: Ended) -> Int =
  match e { Exited(code) -> code, Signalled(signal) -> 128 + signal }

fn logged(log: String, text: String) -> Bool / {fs.read_file[work]} =
  match fs.read_file[work](log) {
    Some(bytes) -> bytes_index_of(bytes, bytes_of_string(text)) != None,
    None -> false,
  }

fn no_database() -> String =
  "no database was given: pass `--db` with a URL whose database holds the desk's schema"

// --- sinks: the same load, with only the sink and stderr moved -----------------------------

pub type Sink = | Discarded | Encoded | Filed

pub fn sinks() -> List<Sink> = [Discarded, Encoded, Filed]

pub fn sink_name(s: Sink) -> String =
  match s {
    Discarded -> "--trace off",
    Encoded -> "--trace json to nowhere",
    Filed -> "--trace json to a file",
  }

fn sink_label(s: Sink) -> String =
  match s { Discarded -> "sink-off", Encoded -> "sink-nowhere", Filed -> "sink-file" }

fn trace_of(s: Sink) -> served::Trace = match s { Discarded -> NoTrace, _ -> JsonTrace }

// Where the desk's stderr goes: a log beside the discarding sink, which must stay empty of records;
// nowhere, for the encoder with no destination; and a file the records are counted in.
pub fn err_of(k: Kit, s: Sink) -> process::Output =
  match s {
    Discarded -> process::File(kit::log_of(k, sink_label(s))),
    Encoded -> process::Discard,
    Filed -> process::File(under(k.scratch, "trace.jsonl")),
  }

// The records a sink wrote: its lines that are JSON objects, past the ones `ply run` writes about
// the run, which are indented.
pub fn records_in(text: String) -> Int / {abort.raise} =
  len(filter(string_split(text, "\n"), |line: String| string_starts_with(line, "{")))

pub fn sink_routes() -> List<String> = ["/health", "/items"]

fn sink_desk(a: Args, s: Sink) -> served::Desk = {
  let d = served::over(a.accept, match a.db { Some(url) -> url, None -> served::unreached() });
  { ..d, trace: trace_of(s) }
}

fn point_name(s: Sink, route: String, clients: Int) -> String =
  sink_name(s) ++ ", GET " ++ route ++ ", " ++ kit::clients_text(clients)

fn stop_name(s: Sink) -> String = sink_name(s) ++ ","

fn records_name(s: Sink) -> String =
  match s {
    Discarded -> "--trace off writes no record",
    _ -> sink_name(s) ++ " writes a record for every request",
  }

fn records_criterion(s: Sink) -> Criterion =
  match s {
    Discarded -> AtMost("records", 0m),
    _ ->
      holding(
        "at least one record for every request the loads were answered",
        ["records", "answered"],
        |vs: List<Decimal>|
          match vs { [records, answered] -> answered > 0m && records >= answered, _ -> false },
      ),
  }

fn has_records(s: Sink) -> Bool = match s { Encoded -> false, _ -> true }

pub type Pointed = { name: String, route: String, load: kit::Load, sample: Sample }

// One sink's measurements: every point, how the desk stopped, and the records it left.
pub type Sunk = { sink: Sink, points: List<Pointed>, stop: Stop, records: Int }

fn sink_load(a: Args, port: Int, route: String, clients: Int) -> kit::Load / {abort.raise} =
  {
    port: port,
    routes: [route],
    connections: clients * served::share(clients, a.per_conn, a.requests_per_point),
    concurrency: clients,
    per_conn: a.per_conn,
    trust: None,
  }

fn loaded(
  k: Kit,
  a: Args,
  s: Sink,
  port: Int,
) -> Result<List<Pointed>, String> / {process.spawn[ply], config.get[env], fs.read_file[work], fs.remove[work], abort.raise} =
  kit::all_of(
    list::flatten(
      map(sink_routes(), |route: String|
        map(a.concurrency, |c: Int| {
          let l = sink_load(a, port, route, c);
          match kit::measured(k, l, a.repeats) {
            Err(why) -> Err(why),
            Ok(sample) ->
              Ok({ name: point_name(s, route, c), route: route, load: l, sample: sample }),
          }
        })),
    ),
  )

fn sunk(
  k: Kit,
  a: Args,
  s: Sink,
) -> Result<Sunk, String> / {process.start[ply], process.output_line[ply], process.wait[ply], process.signal[ply], process.spawn[ply], config.get[env], fs.read_file[work], fs.remove[work], net.connect[probe], net.close[probe], time.elapsed_ms, time.sleep_ms, abort.raise} =
  match kit::start[ply](
      k,
      "desk-" ++ sink_label(s),
      served::desk_args(k, sink_desk(a, s)),
      err_of(k, s),
    ) {
    Err(why) -> Err(why),
    Ok(server) -> {
      let got = loaded(k, a, s, server.port);
      // Counted once the desk has stopped and its sink has flushed.
      let stopped = kit::stop[ply](server);
      match got {
        Err(why) -> Err(why),
        Ok(points) ->
          Ok({
            sink: s,
            points: points,
            stop: stopped,
            records: match err_of(k, s) {
              process::File(path) -> match fs.read_file[work](path) {
                Some(bytes) -> records_in(string_of_bytes_lossy(bytes)),
                None -> 0,
              },
              _ -> 0,
            },
          }),
      }
    },
  }

fn rate(p: Pointed) -> Int / {abort.raise} = stats::per_second(p.sample.answered, p.sample.wall_us)

fn discarding(all: List<Sunk>, p: Pointed) -> Option<Pointed> =
  fold(all, None, |found: Option<Pointed>, one: Sunk|
    match one.sink {
      Discarded ->
        fold(one.points, found, |f: Option<Pointed>, q: Pointed|
          if q.route == p.route && q.load.concurrency == p.load.concurrency { Some(q) } else { f }),
      _ -> found,
    })

// A sink's rows: every point answered, measured beside the discarding sink at the same point, the
// desk drained, and what the sink left behind.
pub fn sink_rows_of(
  s: Sink,
  taken: Result<Sunk, String>,
  all: List<Sunk>,
  names: List<String>,
) -> List<Row> / {abort.raise} =
  match taken {
    Err(why) ->
      list::flatten([
        map(names, |name: String| untaken(name, kit::complete(200), why)),
        [untaken(stop_name(s) ++ " stops", kit::drained(), why)],
        if has_records(s) { [untaken(records_name(s), records_criterion(s), why)] } else { [] },
      ]),
    Ok(one) ->
      list::flatten([
        map(one.points, |p: Pointed| {
          let beside = match ((s, discarding(all, p))) {
            (Discarded, _) -> [],
            (_, Some(off)) -> [number("off_percent", stats::percent(rate(p), rate(off)), "%")],
            (_, None) -> [],
          };
          let taken = row(
            p.name,
            kit::complete(200),
            list::flatten([kit::measurements_of(p.load, p.sample, 200), beside]),
          );
          { ..taken, detail: kit::detail_of(p.sample) }
        }),
        [kit::stop_row(stop_name(s), one.stop, kit::drained())],
        if has_records(s) {
          [
            row(records_name(s), records_criterion(s), [
              number("records", one.records, "records"),
              number(
                "answered",
                fold(one.points, 0, |n: Int, p: Pointed| n + p.sample.answered),
                "requests",
              ),
            ]),
          ]
        } else { [] },
      ]),
  }

fn sink_point_names(a: Args, s: Sink) -> List<String> =
  list::flatten(
    map(sink_routes(), |route: String| map(a.concurrency, |c: Int| point_name(s, route, c))),
  )

fn sink_rows(
  k: Kit,
  a: Args,
) -> List<Row> / {process.start[ply], process.output_line[ply], process.wait[ply], process.signal[ply], process.spawn[ply], config.get[env], fs.read_file[work], fs.remove[work], net.connect[probe], net.close[probe], time.elapsed_ms, time.sleep_ms, abort.raise} = {
  let taken = map(sinks(), |s: Sink|
    match a.db { None -> Err(no_database()), Some(_) -> sunk(k, a, s) });
  let all = fold(taken, [], |acc: List<Sunk>, t: Result<Sunk, String>|
    match t { Ok(one) -> push(acc, one), Err(_) -> acc });
  list::flatten(
    map(range(0, len(sinks())), |i: Int|
      match ((list_at(sinks(), i), list_at(taken, i))) {
        (Some(s), Some(t)) -> sink_rows_of(s, t, all, sink_point_names(a, s)),
        _ -> [],
      }),
  )
}

// --- drain: a stop with requests held in flight ---------------------------------------------

// The held request is a whole head that says a body follows, and the body held back: the desk
// gives a head that never ends far less time than a body, and a request holds the drain open only
// while it is in flight.
pub fn held_head() -> Bytes =
  b"GET /health HTTP/1.1\r\nHost: localhost\r\nContent-Length: 2\r\n\r\n"

pub fn held_body() -> Bytes = b"{}"

pub type Held = { conn: Int, opened_ms: Int }

pub fn held(
  port: Int,
) -> Result<Held, String> / {net.connect[probe], net.send[probe], net.close[probe], time.elapsed_ms, abort.raise} =
  match net.connect[probe]("127.0.0.1", port, 5000) {
    None -> Err("a held request could not connect to port " ++ int_to_string(port)),
    Some(c) -> if send_all[probe](c, held_head(), 5000) {
      Ok({ conn: c, opened_ms: time.elapsed_ms() })
    } else {
      net.close[probe](c);
      Err("a held request's head could not be sent")
    },
  }

// The body sent, and whether a 200 came back; the connection is closed either way.
pub fn finished(
  h: Held,
) -> Bool / {net.send[probe], net.recv[probe], net.close[probe], abort.raise} = {
  let answered = send_all[probe](h.conn, held_body(), 5000)
    && (match net.recv[probe](h.conn, 4096, 10000) {
      Some(bytes) -> bytes_starts_with(bytes, b"HTTP/1.1 200"),
      None -> false,
    });
  net.close[probe](h.conn);
  answered
}

pub type Scenario = { name: String, in_flight: Int, hold_ms: Int, lead_ms: Int, expires: Bool }

pub fn scenarios(a: Args) -> List<Scenario> = {
  let widest = fold(a.in_flight, 1, |w: Int, n: Int| if n > w { n } else { w });
  list::flatten([
    map(a.in_flight, |n: Int|
      {
        name: "drain, " ++ requests_text(n) ++ " held " ++ int_to_string(a.hold_ms) ++ "ms",
        in_flight: n,
        hold_ms: a.hold_ms,
        lead_ms: 0,
        expires: false,
      }),
    [
      // Held past the drain, so it runs out with them in flight.
      {
        name: "drain, " ++ requests_text(widest) ++ " held past the drain",
        in_flight: widest,
        hold_ms: a.drain_ms + 3000,
        lead_ms: 0,
        expires: true,
      },
      // Accept keeps running while `signal.stopping()` answers true, so a readiness route can shed.
      {
        name: "drain, 1 request, a 1500ms lead",
        in_flight: 1,
        hold_ms: a.hold_ms,
        lead_ms: 1500,
        expires: false,
      },
    ],
  ])
}

fn drain_desk(a: Args, lead_ms: Int) -> served::Desk = {
  let d = served::twin("task-per-connection");
  { ..d, drain: Some({ drain_ms: a.drain_ms, lead_ms: lead_ms }) }
}

// What a stop did: the held requests answered and not, how the run ended, whether it said the drain
// ran out, and how long after the signal it was gone.
pub type Drained = {
  answered: Int,
  abandoned: Int,
  exit_code: Int,
  w0608: Bool,
  stop_to_exit_ms: Int,
}

fn opened_last(holds: List<Held>) -> Int =
  fold(holds, 0, |latest: Int, h: Held| if h.opened_ms > latest { h.opened_ms } else { latest })

// The requests held, the signal sent, the wait for the hold to end doubling as the watch on the
// run, then every held request finished and the run waited out.
fn stopped_holding<[l]>(
  s: Server,
  a: Args,
  sc: Scenario,
  holds: List<Held>,
) -> Result<Drained, String> / {process.signal[l], process.wait[l], net.send[probe], net.recv[probe], net.close[probe], fs.read_file[work], time.elapsed_ms, time.sleep_ms, abort.raise} = {
  // The accept loop takes them all, so the signal finds them in flight rather than in the backlog.
  time.sleep_ms(200);
  let signalled = time.elapsed_ms();
  let _ = process.signal[l](s.child, process::Terminate);
  let early = process.wait[l](
    s.child,
    at_least_zero(opened_last(holds) + sc.hold_ms - time.elapsed_ms()),
  );
  let early_ms = time.elapsed_ms() - signalled;
  let answered = fold(holds, 0, |n: Int, h: Held| if finished(h) { n + 1 } else { n });
  let ended = match early {
    Some(f) -> Some({ finished: f, after_ms: early_ms }),
    None -> match process.wait[l](s.child, sc.lead_ms + a.drain_ms + 30000) {
      Some(f) -> Some({ finished: f, after_ms: time.elapsed_ms() - signalled }),
      None -> None,
    },
  };
  match ended {
    None -> {
      kit::killed[l](s.child);
      Err("the desk was still running thirty seconds past its lead and drain")
    },
    Some(e) ->
      Ok({
        answered: answered,
        abandoned: len(holds) - answered,
        exit_code: code_of(e.finished.ended),
        w0608: logged(s.log, "W0608"),
        stop_to_exit_ms: e.after_ms,
      }),
  }
}

fn drained_run(
  k: Kit,
  a: Args,
  sc: Scenario,
) -> Result<Drained, String> / {process.start[ply], process.output_line[ply], process.wait[ply], process.signal[ply], config.get[env], fs.read_file[work], net.connect[probe], net.send[probe], net.recv[probe], net.close[probe], time.elapsed_ms, time.sleep_ms, abort.raise} =
  match kit::start[ply](
      k,
      "desk-drain",
      served::desk_args(k, drain_desk(a, sc.lead_ms)),
      process::File(kit::log_of(k, "desk-drain")),
    ) {
    Err(why) -> Err(why),
    Ok(s) -> {
      let opened = map(range(0, sc.in_flight), |i: Int| held(s.port));
      match kit::all_of(opened) {
        Err(why) -> {
          // The ones that did open are closed with the desk, or the drain would wait on them.
          fold(opened, (), |done: Unit, h: Result<Held, String>|
            match h { Ok(one) -> net.close[probe](one.conn), Err(_) -> () });
          let _ = kit::stop[ply](s);
          Err(why)
        },
        Ok(holds) -> stopped_holding[ply](s, a, sc, holds),
      }
    },
  }

pub fn drain_criterion(sc: Scenario) -> Criterion =
  if sc.expires {
    holding(
      "the drain runs out: exit 3 with W0608, no held request answered, and not before the drain",
      ["answered", "exit_code", "w0608", "stop_to_exit_ms", "drain_ms"],
      |vs: List<Decimal>|
        match vs {
          [answered, code, w0608, took, drain] ->
            answered == 0m && code == 3m && w0608 == 1m && took >= drain,
          _ -> false,
        },
    )
  } else {
    holding(
      "every held request answered 200, and the run accepts through its lead and exits 0 without W0608",
      ["in_flight", "answered", "exit_code", "w0608", "stop_to_exit_ms", "lead_ms"],
      |vs: List<Decimal>|
        match vs {
          [n, answered, code, w0608, took, lead] ->
            answered == n && code == 0m && w0608 == 0m && took >= lead,
          _ -> false,
        },
    )
  }

pub fn drain_row(a: Args, sc: Scenario, taken: Result<Drained, String>) -> Row =
  match taken {
    Err(why) -> untaken(sc.name, drain_criterion(sc), why),
    Ok(d) ->
      row(sc.name, drain_criterion(sc), [
        number("in_flight", sc.in_flight, "requests"),
        number("answered", d.answered, "requests"),
        number("abandoned", d.abandoned, "requests"),
        number("exit_code", d.exit_code, ""),
        number("w0608", one_if(d.w0608), ""),
        number("stop_to_exit_ms", d.stop_to_exit_ms, "ms"),
        number("drain_ms", a.drain_ms, "ms"),
        number("lead_ms", sc.lead_ms, "ms"),
      ]),
  }

fn drain_rows(
  k: Kit,
  a: Args,
) -> List<Row> / {process.start[ply], process.output_line[ply], process.wait[ply], process.signal[ply], config.get[env], fs.read_file[work], net.connect[probe], net.send[probe], net.recv[probe], net.close[probe], time.elapsed_ms, time.sleep_ms, abort.raise} =
  map(scenarios(a), |sc: Scenario| drain_row(a, sc, drained_run(k, a, sc)))

// --- transaction: one open when the drain runs out --------------------------------------------

// The name the desk's sessions are listed under, so the harness counts the desk's backends and no
// one else's.
pub fn desk_session() -> String = "ply-corpus-desk"

// Past the drain, so the drain runs out with the transaction in flight, and near it, since a
// backend nothing ends is what the row waits for.
pub fn statement_ms(a: Args) -> Int = a.drain_ms + 5000

// `url` with settings added to its query.
pub fn with_settings(url: String, settings: List<{ key: String, value: String }>) -> String =
  fold(settings, url, |acc: String, s: { key: String, value: String }|
    acc ++ (if string_contains(acc, "?") { "&" } else { "?" }) ++ s.key ++ "=" ++ s.value)

// What the desk's connections start with: statements and idle transactions bounded by the server.
pub fn bounded(a: Args, url: String) -> String =
  with_settings(url, [
    { key: "statement_timeout", value: int_to_string(statement_ms(a)) },
    { key: "idle_in_transaction_session_timeout", value: int_to_string(statement_ms(a)) },
    { key: "application_name", value: desk_session() },
  ])

fn transaction_desk(a: Args, url: String) -> served::Desk = {
  let d = served::over("task-per-connection", bounded(a, url));
  { ..d, drain: Some({ drain_ms: a.drain_ms, lead_ms: 0 }) }
}

// The row an order reserves, held by a second session while the order waits on it.
pub fn lock_sql() -> String = "select 1 from items where sku = 'bolt' for update"

pub fn order_request() -> Bytes / {abort.raise} = {
  let r = http::request_to(
    http::Post,
    "localhost",
    "/orders",
    b"{\"customer\":\"drain\",\"lines\":[{\"sku\":\"bolt\",\"qty\":1}]}",
  );
  http::encode_request({
    ..r,
    headers: map_of_entries([
      { key: "x-api-key", value: [served::api_key()] },
      { key: "content-type", value: ["application/json"] },
    ]),
  })
}

// The harness asks the database through the same driver the desk writes it with.
effect set Asking = {net.connect[link], net.send[link], net.recv[link], net.close[link], entropy.next}

pub fn count_in(a: db::Answer) -> Result<Int, String> =
  match a {
    db::Rows(rows) -> match rows {
      [row, ..] -> match map_get(row, "n") {
        Some(db::CInt(n)) -> Ok(n),
        Some(db::CNumeric(d)) -> match int_of_decimal(d, Down) {
          Some(n) -> Ok(n),
          None -> Err("`n` does not fit an Int"),
        },
        _ -> Err("the answer's `n` is not a number"),
      },
      [] -> Err("the statement answered no rows"),
    },
    db::Count(n) -> Ok(n),
    db::Failed(e) -> Err(e.detail),
  }

fn answered_count(asked: Result<db::Answer, String>) -> Result<Int, String> =
  match asked { Err(why) -> Err(why), Ok(a) -> count_in(a) }

fn orders(url: String) -> Result<Int, String> / {Asking, abort.raise} =
  answered_count(
    with_server(url, 1, || db.query[orders](db::stmt("select count(*) as n from orders"), [])),
  )

fn last_order(url: String) -> Result<Int, String> / {Asking, abort.raise} =
  answered_count(
    with_server(url, 1, ||
      db.query[orders_id_seq](db::stmt("select last_value as n from orders_id_seq"), [])),
  )

fn desk_waiting(url: String) -> Result<Int, String> / {Asking, abort.raise} =
  answered_count(
    with_server(url, 1, ||
      db.query[pg_stat_activity](
        db::stmt(
          "select count(*) as n from pg_stat_activity where application_name = $1 and wait_event_type = 'Lock'",
        ),
        [db::PText(desk_session())],
      )),
  )

fn desk_in_transaction(url: String) -> Result<Int, String> / {Asking, abort.raise} =
  answered_count(
    with_server(url, 1, ||
      db.query[pg_stat_activity](
        db::stmt(
          "select count(*) as n from pg_stat_activity where application_name = $1 and xact_start is not null",
        ),
        [db::PText(desk_session())],
      )),
  )

fn desk_idle_in_transaction(url: String) -> Result<Int, String> / {Asking, abort.raise} =
  answered_count(
    with_server(url, 1, ||
      db.query[pg_stat_activity](
        db::stmt(
          "select count(*) as n from pg_stat_activity where application_name = $1 and state like 'idle in transaction%'",
        ),
        [db::PText(desk_session())],
      )),
  )

pub type Book = { orders: Int, sequence: Int }

fn book(url: String) -> Result<Book, String> / {Asking, abort.raise} =
  match orders(url) {
    Err(why) -> Err(why),
    Ok(n) -> match last_order(url) {
      Err(why) -> Err(why),
      Ok(s) -> Ok({ orders: n, sequence: s }),
    },
  }

fn until_waiting(
  url: String,
  deadline: Int,
) -> Result<Bool, String> / {Asking, time.elapsed_ms, time.sleep_ms, abort.raise} =
  match desk_waiting(url) {
    Err(why) -> Err(why),
    Ok(n) -> if n > 0 { Ok(true) }
    else if time.elapsed_ms() >= deadline { Ok(false) } else {
      time.sleep_ms(50);
      until_waiting(url, deadline)
    },
  }

// The desk's backends still in a transaction, once none are or the deadline passes.
fn until_ended(
  url: String,
  deadline: Int,
) -> Result<Int, String> / {Asking, time.elapsed_ms, time.sleep_ms, abort.raise} =
  match desk_in_transaction(url) {
    Err(why) -> Err(why),
    Ok(n) -> if n == 0 || time.elapsed_ms() >= deadline { Ok(n) } else {
      time.sleep_ms(100);
      until_ended(url, deadline)
    },
  }

// The lock session: `locked` once the row is held; closing its input lets go.
pub fn lock_io(k: Kit) -> process::Io =
  { input: true, out: process::Lines, err: process::File(kit::log_of(k, "lock")) }

fn heard_locked<[l]>(
  k: Kit,
  child: Int,
  deadline: Int,
) -> Result<Int, String> / {process.output_line[l], process.wait[l], process.signal[l], fs.read_file[work], time.elapsed_ms, abort.raise} =
  match process.output_line[l](child, 250) {
    process::Said(line) -> if string_trim(line) == "locked" { Ok(child) }
    else { heard_locked[l](k, child, deadline) },
    process::Quiet -> if time.elapsed_ms() >= deadline {
      kit::killed[l](child);
      Err("the lock session held no lock in time")
    } else { heard_locked[l](k, child, deadline) },
    process::Closed -> {
      let _ = process.wait[l](child, 5000);
      Err(
        "the lock session ended without the lock: "
          ++ spine::first_line(kit::tail_of(kit::log_of(k, "lock"))),
      )
    },
  }

pub fn locked<[l]>(
  k: Kit,
  url: String,
  deadline: Int,
) -> Result<Int, String> / {process.start[l], process.output_line[l], process.wait[l], process.signal[l], config.get[env], fs.read_file[work], time.elapsed_ms, abort.raise} =
  match process.start[l](["lock", url, lock_sql()], "", spine::inherited_env(), lock_io(k)) {
    Err(why) -> Err("the lock session did not start: " ++ why),
    Ok(child) -> heard_locked[l](k, child, deadline),
  }

pub fn released<[l]>(
  child: Int,
) -> Result<Unit, String> / {process.end_input[l], process.wait[l], process.signal[l]} = {
  process.end_input[l](child);
  match process.wait[l](child, 30000) {
    Some(f) -> if spine::exit_zero(f) { Ok(()) }
    else { Err("the lock session " ++ kit::ended_text(f.ended) ++ " as it let go") },
    None -> {
      kit::killed[l](child);
      Err("the lock session did not let go")
    },
  }
}

// What the deadline did: how the run ended, and the desk's backends once the server had the time
// its statement timeout gives it.
pub type Deadline = {
  exit_code: Int,
  w0608: Bool,
  stop_to_exit_ms: Int,
  in_transaction: Int,
  idle_in_transaction: Int,
  ended_after_ms: Int,
}

fn posted(
  port: Int,
) -> Result<Int, String> / {net.connect[probe], net.send[probe], net.close[probe], abort.raise} =
  match net.connect[probe]("127.0.0.1", port, 5000) {
    None -> Err("the order could not connect to port " ++ int_to_string(port)),
    Some(c) -> if send_all[probe](c, order_request(), 5000) { Ok(c) } else {
      net.close[probe](c);
      Err("the order could not be sent")
    },
  }

// Signalled with the order waiting on the lock, and waited out; then the desk's backends, polled
// while the lock is still held, so only the server's own timeout can have ended the transaction.
fn signalled_waiting(
  a: Args,
  url: String,
  s: Server,
  order: Int,
) -> Result<Deadline, String> / {process.signal[ply], process.wait[ply], net.close[probe], fs.read_file[work], Asking, time.elapsed_ms, time.sleep_ms, abort.raise} = {
  let signalled = time.elapsed_ms();
  let _ = process.signal[ply](s.child, process::Terminate);
  let ended = process.wait[ply](s.child, a.drain_ms + 60000);
  let exit_ms = time.elapsed_ms() - signalled;
  net.close[probe](order);
  match ended {
    None -> {
      kit::killed[ply](s.child);
      Err("the desk was still running a minute past its drain")
    },
    Some(f) -> match until_ended(url, signalled + statement_ms(a) + 10000) {
      Err(why) -> Err(why),
      Ok(left) -> match desk_idle_in_transaction(url) {
        Err(why) -> Err(why),
        Ok(idle) ->
          Ok({
            exit_code: code_of(f.ended),
            w0608: logged(s.log, "W0608"),
            stop_to_exit_ms: exit_ms,
            in_transaction: left,
            idle_in_transaction: idle,
            ended_after_ms: time.elapsed_ms() - signalled,
          }),
      },
    },
  }
}

fn at_the_deadline(
  k: Kit,
  a: Args,
  url: String,
) -> Result<Deadline, String> / {process.start[ply], process.output_line[ply], process.wait[ply], process.signal[ply], config.get[env], fs.read_file[work], net.connect[probe], net.send[probe], net.close[probe], Asking, time.elapsed_ms, time.sleep_ms, abort.raise} =
  match kit::start[ply](
      k,
      "desk-transaction",
      served::desk_args(k, transaction_desk(a, url)),
      process::File(kit::log_of(k, "desk-transaction")),
    ) {
    Err(why) -> Err(why),
    Ok(s) -> match posted(s.port) {
      Err(why) -> {
        let _ = kit::stop[ply](s);
        Err(why)
      },
      Ok(order) -> match until_waiting(url, time.elapsed_ms() + 30000) {
        Ok(true) -> signalled_waiting(a, url, s, order),
        other -> {
          net.close[probe](order);
          let _ = kit::stop[ply](s);
          Err(match other {
            Err(why) -> why,
            _ -> "the order never waited on the lock: its update does not reach the locked row",
          })
        },
      },
    },
  }

pub fn expired_criterion() -> Criterion =
  holding(
    "the drain runs out with the order in flight: exit 3 with W0608",
    ["exit_code", "w0608"],
    |vs: List<Decimal>| match vs { [code, w0608] -> code == 3m && w0608 == 1m, _ -> false },
  )

pub fn uncommitted_criterion() -> Criterion =
  holding(
    "nothing the order did is committed, though its insert ran",
    ["orders_before", "orders_after", "sequence_before", "sequence_after"],
    |vs: List<Decimal>|
      match vs { [before, after, was, now] -> after == before && now > was, _ -> false },
  )

pub fn ended_criterion() -> Criterion =
  holding(
    "no backend of the desk is left in a transaction, the lock still held",
    ["in_transaction", "idle_in_transaction"],
    |vs: List<Decimal>| match vs { [open, idle] -> open == 0m && idle == 0m, _ -> false },
  )

fn transaction_name(what: String) -> String = "transaction at the drain deadline: " ++ what

pub fn transaction_names() -> List<String> =
  [
    transaction_name("the drain runs out"),
    transaction_name("nothing committed"),
    transaction_name("the server ends it"),
  ]

fn transaction_criteria() -> List<Criterion> =
  [expired_criterion(), uncommitted_criterion(), ended_criterion()]

fn all_untaken(why: String) -> List<Row> / {abort.raise} =
  map(range(0, 3), |i: Int|
    match ((list_at(transaction_names(), i), list_at(transaction_criteria(), i))) {
      (Some(name), Some(c)) -> untaken(name, c, why),
      _ -> panic("a name for every criterion"),
    })

pub fn transaction_rows_of(
  a: Args,
  was: Book,
  d: Deadline,
  now: Result<Book, String>,
  freed: Result<Unit, String>,
) -> List<Row> =
  [
    row(transaction_name("the drain runs out"), expired_criterion(), [
      number("exit_code", d.exit_code, ""),
      number("w0608", one_if(d.w0608), ""),
      number("stop_to_exit_ms", d.stop_to_exit_ms, "ms"),
      number("drain_ms", a.drain_ms, "ms"),
    ]),
    match now {
      Err(why) -> untaken(transaction_name("nothing committed"), uncommitted_criterion(), why),
      Ok(after) -> {
        let taken = row(transaction_name("nothing committed"), uncommitted_criterion(), [
          number("orders_before", was.orders, "orders"),
          number("orders_after", after.orders, "orders"),
          number("sequence_before", was.sequence, ""),
          number("sequence_after", after.sequence, ""),
        ]);
        { ..taken, detail: match freed { Err(why) -> Str(why), Ok(_) -> Null } }
      },
    },
    row(transaction_name("the server ends it"), ended_criterion(), [
      number("in_transaction", d.in_transaction, "backends"),
      number("idle_in_transaction", d.idle_in_transaction, "backends"),
      number("statement_timeout_ms", statement_ms(a), "ms"),
      number("ended_after_ms", d.ended_after_ms, "ms"),
    ]),
  ]

fn transaction_rows(
  k: Kit,
  a: Args,
) -> List<Row> / {process.bound[pg_floor], process.start[ply], process.output_line[ply], process.wait[ply], process.signal[ply], process.start[pg_floor], process.output_line[pg_floor], process.wait[pg_floor], process.signal[pg_floor], process.end_input[pg_floor], config.get[env], fs.read_file[work], net.connect[probe], net.send[probe], net.close[probe], Asking, time.elapsed_ms, time.sleep_ms, abort.raise} =
  match a.db {
    None -> all_untaken(no_database()),
    Some(url) -> if !process.bound[pg_floor]() {
      all_untaken(
        "the lock is held by the libpq tool, which is not bound (benches/corpus.sh builds it where `pg_config` is)",
      )
    } else {
      match book(url) {
        Err(why) -> all_untaken("the desk's tables could not be read: " ++ why),
        Ok(was) -> match locked[pg_floor](k, url, time.elapsed_ms() + 30000) {
          Err(why) -> all_untaken(why),
          Ok(lock) -> {
            let outcome = at_the_deadline(k, a, url);
            let freed = released[pg_floor](lock);
            match outcome {
              Err(why) -> all_untaken(why),
              Ok(d) -> transaction_rows_of(a, was, d, book(url), freed),
            }
          },
        },
      }
    },
  }

// --- deploy: one definition edited, and what a build of each says -------------------------------

fn deploy_dir(k: Kit) -> String = under(k.scratch, "deploy")

// Nothing reads it at start-up, so the edited desk differs in this definition alone.
pub fn edited_definition() -> String =
  "// The readiness probe, pointed at the order book.\nfn store_reachable() -> db::Stmt = db::stmt(\"select count(*) from orders\")\n"

// The desk three times over, in directories of their own: two to build as they are, from two roots,
// and one to edit.
fn copied(
  k: Kit,
) -> Result<Unit, String> / {fs.read_file[repo], fs.create_dir[work], fs.write_file[work]} =
  match fs.read_file[repo]("examples/desk.ply") {
    None -> Err("`examples/desk.ply` could not be read under the `repo` root"),
    Some(source) -> if fold(["a", "b", "edited"], true, |ok: Bool, d: String|
          ok && fs.create_dir[work](under(deploy_dir(k), d))
            && fs.write_file[work](under(under(deploy_dir(k), d), "desk.ply"), source))
        && fs.write_file[work](
          under(deploy_dir(k), "store_reachable.ply"),
          bytes_of_string(edited_definition()),
        ) { Ok(()) }
    else { Err("the desk could not be copied under " ++ deploy_dir(k)) },
  }

fn product(args: List<String>) -> Finished / {process.spawn[ply], config.get[env]} =
  process.spawn[ply](args, "", spine::inherited_env())

// The definition the deploy edits, as `ply build --diff` names it.
fn edited_name() -> String = "desk.store_reachable"

fn member(xs: List<String>, x: String) -> Bool =
  fold(xs, false, |seen: Bool, y: String| seen || y == x)

pub fn replace_args(k: Kit) -> List<String> =
  [
    "replace",
    "store_reachable",
    under(deploy_dir(k), "edited/desk.ply"),
    "--with",
    under(deploy_dir(k), "store_reachable.ply"),
    "--color",
    "never",
  ]

pub fn build_args(k: Kit, dir: String) -> List<String> =
  [
    "build",
    under(deploy_dir(k), dir),
    "-o",
    under(deploy_dir(k), dir ++ ".plyx"),
    "--json",
    "--color",
    "never",
  ]

pub fn diff_args(k: Kit) -> List<String> =
  [
    "build",
    under(deploy_dir(k), "edited"),
    "--diff",
    under(deploy_dir(k), "a.plyx"),
    "--json",
    "--color",
    "never",
  ]

fn object_of(f: Finished) -> Result<Map<String, Json>, String> / {abort.raise} =
  match spine::report_json(f) {
    Err(why) -> Err(why),
    Ok(Object(m)) -> Ok(m),
    Ok(_) -> Err("`ply build --json` wrote a document that is not an object"),
  }

fn names_in(m: Map<String, Json>, key: String) -> List<String> =
  map(spine::array_field(m, key), |j: Json| match j { Str(s) -> s, _ -> "" })

fn replaced_criterion() -> Criterion =
  holding("`ply replace` rewrites the one definition", ["exit_code"], |vs: List<Decimal>|
    match vs { [code] -> code == 0m, _ -> false })

fn reproducible_criterion() -> Criterion =
  holding(
    "the same source built from two directories is one artifact",
    ["same_digest"],
    |vs: List<Decimal>| match vs { [same] -> same == 1m, _ -> false },
  )

// A definition's hash covers what it calls, so an edit moves every definition that reaches it: what
// a deploy ships is the edit's reach, and anything else that moved is a leak.
fn shipped_criterion() -> Criterion =
  holding(
    "the edited definition changed and every changed one reaches it, none added or dropped",
    ["edited", "outside_reach", "added", "dropped"],
    |vs: List<Decimal>|
      match vs {
        [edited, outside, added, dropped] ->
          edited == 1m && outside == 0m && added == 0m && dropped == 0m,
        _ -> false,
      },
  )

pub fn deploy_names() -> List<String> =
  [
    "deploy: the edit is one `ply replace`",
    "deploy: the build is reproducible",
    "deploy: the edit ships only what reaches it",
  ]

fn deploy_name(i: Int) -> String = match list_at(deploy_names(), i) { Some(n) -> n, None -> "" }

fn replaced_row(f: Finished) -> Row / {abort.raise} = {
  let code = code_of(f.ended);
  let taken = row(deploy_name(0), replaced_criterion(), [number("exit_code", code, "")]);
  {
    ..taken,
    detail: if code == 0 { Null } else { Str(spine::first_line(string_of_bytes_lossy(f.err))) },
  }
}

fn number_field(m: Map<String, Json>, key: String, unit: String) -> List<Measurement> =
  match spine::opt_int_field(m, key) { Some(n) -> [number(key, n, unit)], None -> [] }

pub fn reproducible_row(
  one: Result<Map<String, Json>, String>,
  two: Result<Map<String, Json>, String>,
) -> Row =
  match ((one, two)) {
    (Err(why), _) -> untaken(deploy_name(1), reproducible_criterion(), why),
    (_, Err(why)) -> untaken(deploy_name(1), reproducible_criterion(), why),
    (Ok(a), Ok(b)) -> {
      let first = spine::str_field(a, "digest");
      let second = spine::str_field(b, "digest");
      let taken = row(
        deploy_name(1),
        reproducible_criterion(),
        list::flatten([
          [number("same_digest", one_if(first == second), "")],
          number_field(a, "definitions", "definitions"),
          number_field(a, "artifact_bytes", "bytes"),
          number_field(a, "binary_bytes", "bytes"),
        ]),
      );
      { ..taken, detail: Str(if first == second { first } else { first ++ " and " ++ second }) }
    },
  }

pub fn shipped_row(replaced: Bool, diff: Result<Map<String, Json>, String>) -> Row =
  if !replaced {
    untaken(
      deploy_name(2),
      shipped_criterion(),
      "the edit was not made, so there is nothing to diff",
    )
  } else {
    match diff {
      Err(why) -> untaken(deploy_name(2), shipped_criterion(), why),
      Ok(m) -> {
        let changed = names_in(m, "changed");
        let reached = names_in(m, "reached");
        let taken = row(deploy_name(2), shipped_criterion(), [
          number("edited", if member(changed, edited_name()) { 1 } else { 0 }, "definitions"),
          number(
            "outside_reach",
            len(filter(changed, |n: String| !member(reached, n))),
            "definitions",
          ),
          number("changed", len(changed), "definitions"),
          number("added", len(names_in(m, "added")), "definitions"),
          number("dropped", len(names_in(m, "dropped")), "definitions"),
          number("unchanged", spine::int_field(m, "unchanged"), "definitions"),
          number("reached", len(reached), "definitions"),
          number("artifact_bytes", spine::int_field(m, "artifact_bytes"), "bytes"),
        ]);
        { ..taken, detail: Str(string::join(changed, ", ")) }
      },
    }
  }

fn deploy_rows(
  k: Kit,
) -> List<Row> / {process.spawn[ply], config.get[env], fs.read_file[repo], fs.create_dir[work], fs.write_file[work], abort.raise} =
  match copied(k) {
    Err(why) ->
      [
        untaken(deploy_name(0), replaced_criterion(), why),
        untaken(deploy_name(1), reproducible_criterion(), why),
        untaken(deploy_name(2), shipped_criterion(), why),
      ],
    Ok(_) -> {
      let edit = product(replace_args(k));
      let one = object_of(product(build_args(k, "a")));
      let two = object_of(product(build_args(k, "b")));
      let diff = match one {
        Err(why) -> Err("the first build failed: " ++ why),
        Ok(_) -> object_of(product(diff_args(k))),
      };
      [replaced_row(edit), reproducible_row(one, two), shipped_row(spine::exit_zero(edit), diff)]
    },
  }

// --- The lines every section runs the desk with -----------------------------------------------

fn lines(k: Kit, a: Args) -> List<served::Line> =
  list::flatten([
    if list::contains(a.sections, "sinks") {
      map(sinks(), |s: Sink| { label: sink_name(s), args: served::desk_args(k, sink_desk(a, s)) })
    } else { [] },
    if list::contains(a.sections, "drain") {
      [
        { label: "the drain", args: served::desk_args(k, drain_desk(a, 0)) },
        { label: "the drain with a lead", args: served::desk_args(k, drain_desk(a, 1500)) },
      ]
    } else { [] },
    if list::contains(a.sections, "transaction") {
      [
        {
          label: "the transaction",
          args: served::desk_args(
            k,
            transaction_desk(a, match a.db { Some(url) -> url, None -> served::unreached() }),
          ),
        },
      ]
    } else { [] },
  ])

// --- The report ------------------------------------------------------------------------

pub fn run(
  a: Args,
) -> Result<report::Report, String> / {process.bound[pg_floor], process.start[ply], process.output_line[ply], process.wait[ply], process.signal[ply], process.spawn[ply], process.start[pg_floor], process.output_line[pg_floor], process.wait[pg_floor], process.signal[pg_floor], process.end_input[pg_floor], config.get[env], fs.read_file[work], fs.write_file[work], fs.remove[work], fs.create_dir[work], fs.read[repo], net.connect[probe], net.send[probe], net.recv[probe], net.close[probe], Asking, time.elapsed_ms, time.sleep_ms, abort.raise} = {
  let k = { repo: a.repo, scratch: under(a.scratch, "operating") };
  match kit::prepare(k) {
    Err(why) -> Err(why),
    Ok(_) -> {
      let desk_lines = lines(k, a);
      let rows = list::flatten([
        if len(desk_lines) == 0 { [] } else {
          [served::lines_row("the desk lines `operating` runs", served::checked(desk_lines))]
        },
        if list::contains(a.sections, "sinks") { sink_rows(k, a) } else { [] },
        if list::contains(a.sections, "drain") { drain_rows(k, a) } else { [] },
        if list::contains(a.sections, "transaction") { transaction_rows(k, a) } else { [] },
        if list::contains(a.sections, "deploy") { deploy_rows(k) } else { [] },
      ]);
      report::made(
        "operating",
        "operating — tracing, a drain, the drain's deadline and a deploy",
        rows,
        [
          { key: "sections", value: array(map(a.sections, |s: String| Str(s))) },
          { key: "database", value: Bool(a.db != None) },
          { key: "accept", value: Str(a.accept) },
          { key: "drain_ms", value: Number(decimal_of_int(a.drain_ms)) },
        ],
      )
    },
  }
}

// --- Tests ---------------------------------------------------------------------------------

fn args() -> Args =
  {
    repo: "../repo",
    scratch: "s",
    db: None,
    sections: sections(),
    accept: "sequential",
    concurrency: [1, 8],
    per_conn: 32,
    requests_per_point: 3000,
    in_flight: [1, 8, 32],
    drain_ms: 5000,
    hold_ms: 500,
    repeats: 3,
  }

fn drained(answered: Int, code: Int, w0608: Bool, took: Int) -> Drained =
  { answered: answered, abandoned: 0, exit_code: code, w0608: w0608, stop_to_exit_ms: took }

test "a drain completes with its held requests answered, and one held past it runs out" {
  let a = args();
  match scenarios(a) {
    [one, eight, many, widest, lead] -> {
      assert_eq(many.in_flight, 32);
      assert(widest.expires && widest.in_flight == 32 && widest.hold_ms == 8000);
      assert(!lead.expires && lead.lead_ms == 1500);
      assert_eq(
        report::judged_alone(drain_row(a, eight, Ok(drained(8, 0, false, 320)))),
        report::Pass,
      );
      assert(
        report::judged_alone(drain_row(a, eight, Ok(drained(7, 0, false, 320)))) != report::Pass,
      );
      assert(
        report::judged_alone(drain_row(a, eight, Ok(drained(8, 3, true, 5100)))) != report::Pass,
      );
      assert_eq(
        report::judged_alone(drain_row(a, widest, Ok(drained(0, 3, true, 5012)))),
        report::Pass,
      );
      assert(
        report::judged_alone(drain_row(a, widest, Ok(drained(0, 0, false, 4100)))) != report::Pass,
      );
      assert(
        report::judged_alone(drain_row(a, widest, Ok(drained(0, 3, true, 4990)))) != report::Pass,
      );
      assert_eq(
        report::judged_alone(drain_row(a, lead, Ok(drained(1, 0, false, 1530)))),
        report::Pass,
      );
      assert(
        report::judged_alone(drain_row(a, lead, Ok(drained(1, 0, false, 400)))) != report::Pass,
      );
      assert_eq(
        report::judged_alone(drain_row(a, one, Err("the desk did not start"))),
        report::Inconclusive("the desk did not start"),
      )
    },
    _ -> panic("three widths, one run out, one lead"),
  }
}

test "a held request sends its head, then its body, and reads the answer" {
  with_cell[wire](b"") { wire -> {
    let answered = handle {
      match held(4000) { Ok(h) -> finished(h), Err(why) -> panic(why) }
    } with {
      net.connect[probe](host, port, timeout_ms) -> if port == 4000 { Some(9) } else { None },
      net.send[probe](c, payload, timeout_ms) -> {
        cell_set(wire, bytes_concat(cell_get(wire), payload));
        Some(bytes_len(payload))
      },
      net.recv[probe](c, max, timeout_ms) ->
        Some(b"HTTP/1.1 200 OK\r\ncontent-length: 2\r\n\r\n{}"),
      net.close[probe](c) -> (),
      time.elapsed_ms() -> 0,
    };
    assert(answered);
    assert_eq(cell_get(wire), bytes_concat(held_head(), held_body()))
  } }
}

test "a stop that kills a run reads as a shell reads it" {
  assert_eq(code_of(Exited(3)), 3);
  assert_eq(code_of(Signalled(9)), 137)
}

test "the lock is held until its session's input is closed, and it must then exit cleanly" {
  let planned = process::script(0, process::exited(0, b"released\n", b""), [
    process::Said("locked"),
  ]);
  with_cell[kids](process::children([planned])) { kids -> {
    let answer = handle {
      match locked[tool]({ repo: ".", scratch: "s" }, "postgres://u@db/desk", 1000) {
        Err(why) -> Err(why),
        Ok(child) -> released[tool](child),
      }
    } with {
      process.start[tool](args, dir, env, io) -> {
        let step = process::start_step(cell_get(kids), { args: args, dir: dir, env: env }, io);
        cell_set(kids, step.children);
        step.answer
      },
      process.output_line[tool](child, timeout_ms) -> {
        let step = process::output_line_step(cell_get(kids), child);
        cell_set(kids, step.children);
        step.answer
      },
      process.end_input[tool](child) ->
        cell_set(kids, process::end_input_step(cell_get(kids), child)),
      process.wait[tool](child, timeout_ms) -> {
        let step = process::wait_step(cell_get(kids), child);
        cell_set(kids, step.children);
        step.answer
      },
      process.signal[tool](child, signal) -> {
        let step = process::signal_step(cell_get(kids), child, signal);
        cell_set(kids, step.children);
        step.answer
      },
      config.get[env](key) -> None,
      fs.read_file[work](path) -> None,
      time.elapsed_ms() -> 0,
    };
    assert_eq(answer, Ok(()));
    match cell_get(kids).started {
      [session] -> {
        assert_eq(session.launch.args, ["lock", "postgres://u@db/desk", lock_sql()]);
        assert_eq(session.io, lock_io({ repo: ".", scratch: "s" }));
        assert(!session.open);
        assert_eq(session.signals, [])
      },
      _ -> panic("one lock session was started"),
    }
  } }
}

test "the desk's database is bounded by the server, and its sessions are named for the count" {
  let a = args();
  assert_eq(
    bounded(a, "postgres://u@db/desk?sslmode=disable"),
    "postgres://u@db/desk?sslmode=disable&statement_timeout=10000&idle_in_transaction_session_timeout=10000&application_name=ply-corpus-desk",
  );
  assert_eq(
    with_settings("postgres://u@db/desk", [{ key: "a", value: "1" }]),
    "postgres://u@db/desk?a=1",
  );
  let request = string_of_bytes(order_request());
  assert(string_starts_with(request, "POST /orders HTTP/1.1\r\n"));
  assert(string_contains(request, "x-api-key: bench-key\r\n"));
  assert(string_contains(request, "\"sku\":\"bolt\""))
}

test "the transaction's rows are judged on the drain, the book and the backends" {
  let a = args();
  let d = {
    exit_code: 3,
    w0608: true,
    stop_to_exit_ms: 5020,
    in_transaction: 0,
    idle_in_transaction: 0,
    ended_after_ms: 9800,
  };
  let was = { orders: 2, sequence: 2 };
  let rows = transaction_rows_of(a, was, d, Ok({ orders: 2, sequence: 3 }), Ok(()));
  assert_eq(map(rows, |r: Row| r.name), transaction_names());
  assert_eq(map(rows, report::judged_alone), [report::Pass, report::Pass, report::Pass]);
  let committed = transaction_rows_of(a, was, d, Ok({ orders: 3, sequence: 3 }), Ok(()));
  assert(match list_at(committed, 1) {
    Some(r) -> report::judged_alone(r) != report::Pass,
    None -> false,
  });
  let held = transaction_rows_of(
    a,
    was,
    { ..d, in_transaction: 1 },
    Ok({ orders: 2, sequence: 3 }),
    Ok(()),
  );
  assert(match list_at(held, 2) {
    Some(r) -> report::judged_alone(r) != report::Pass,
    None -> false,
  });
  assert_eq(count_in(db::Rows([map_of_entries([{ key: "n", value: db::CInt(4) }])])), Ok(4));
  assert_eq(count_in(db::Failed(db::db_error("", "", "no such table"))), Err("no such table"))
}

test "a sink's records are its lines that are objects, and the discarding sink must write none" {
  assert_eq(records_in("   binding host\n{\"kind\":\"enter\"}\n{\"kind\":\"exit\"}\n"), 2);
  assert_eq(err_of({ repo: ".", scratch: "s" }, Encoded), process::Discard);
  assert_eq(err_of({ repo: ".", scratch: "s" }, Filed), process::File("s/trace.jsonl"));
  let names = ["n1"];
  let rows = sink_rows_of(Discarded, Err(no_database()), [], names);
  assert_eq(map(rows, |r: Row| r.name), [
    "n1",
    "--trace off, stops",
    "--trace off writes no record",
  ]);
  assert(
    fold(report::judge(rows), true, |ok: Bool, j: report::Judged|
      ok && j.verdict == report::Inconclusive(no_database())),
  )
}

test "a deploy's rows read the builds and the diff the product wrote" {
  let built = |digest: String|
    match json::parse_string(
        "{\"digest\":\"" ++ digest
          ++ "\",\"definitions\":400,\"artifact_bytes\":900000,\"binary_bytes\":null}",
      ) {
      Ok(Object(m)) -> Ok(m),
      _ -> Err("not an object"),
    };
  assert_eq(report::judged_alone(reproducible_row(built("b3:aa"), built("b3:aa"))), report::Pass);
  assert(report::judged_alone(reproducible_row(built("b3:aa"), built("b3:bb"))) != report::Pass);
  let diff = match json::parse_string(
      "{\"added\":[],\"changed\":[\"desk.store_reachable\"],\"dropped\":[],\"unchanged\":399,\"reached\":[\"desk.ready\",\"desk.store_reachable\"],\"artifact_bytes\":900010}",
    ) {
    Ok(Object(m)) -> Ok(m),
    _ -> Err("not an object"),
  };
  let shipped = shipped_row(true, diff);
  assert_eq(report::judged_alone(shipped), report::Pass);
  assert_eq(shipped.detail, Str("desk.store_reachable"));
  let diffed = |text: String|
    match json::parse_string(text) { Ok(Object(m)) -> Ok(m), _ -> Err("not an object") };
  // Its callers move with it, which is the edit's reach and what a deploy ships.
  assert_eq(
    report::judged_alone(
      shipped_row(
        true,
        diffed(
          "{\"added\":[],\"changed\":[\"desk.ready\",\"desk.store_reachable\"],\"dropped\":[],\"unchanged\":398,\"reached\":[\"desk.ready\",\"desk.store_reachable\"],\"artifact_bytes\":900010}",
        ),
      ),
    ),
    report::Pass,
  );
  // A definition that moved without reaching the edit leaked into the deploy.
  assert(
    report::judged_alone(
        shipped_row(
          true,
          diffed(
            "{\"added\":[],\"changed\":[\"desk.health\",\"desk.store_reachable\"],\"dropped\":[],\"unchanged\":398,\"reached\":[\"desk.ready\",\"desk.store_reachable\"],\"artifact_bytes\":900010}",
          ),
        ),
      )
      != report::Pass,
  );
  // An edit that left its own definition's hash alone did not ship.
  assert(
    report::judged_alone(
        shipped_row(
          true,
          diffed(
            "{\"added\":[],\"changed\":[],\"dropped\":[],\"unchanged\":400,\"reached\":[],\"artifact_bytes\":900000}",
          ),
        ),
      )
      != report::Pass,
  );
  assert(report::judged_alone(shipped_row(false, diff)) != report::Pass);
  assert_eq(report::judged_alone(replaced_row(process::exited(0, b"", b""))), report::Pass);
  assert(
    report::judged_alone(replaced_row(process::exited(2, b"", b"error[E0128]: no\n")))
      != report::Pass,
  );
  assert_eq(list_at(diff_args({ repo: ".", scratch: "s" }), 3), Some("s/deploy/a.plyx"))
}
