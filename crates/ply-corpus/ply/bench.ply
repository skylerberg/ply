// The bench: where a `ply test` run's time goes over a generated corpus, answered from the product's
// own reports. Every scenario is a row that declares its criterion before anything runs, and one more
// row sets the harness's own walk and read of the tree beside the toolchain's phases (`pipeline`).
//
// `dir`, everywhere below, is the corpus's path relative to the working directory: the `work` root
// the files are read and written through, and the directory `ply` is spawned in.

import pipeline
import report
import report (Row, Measurement, AtMost, holding, number, row, untaken)
import spine
import spine (under)
import std.json (Json, Str, Number, Object, object)
import std.json
import std.fs (fs)
import std.fs
import std.process (process)
import std.config (config)
import std.time (time)

// --- The generated corpus's own description ------------------------------------------

pub type EditSite = { path: String, find: String, replace: String, dependents: Int }

pub type Corpus = {
  modules: Int,
  definitions: Int,
  tests: Int,
  bytes: Int,
  leaf: EditSite,
  hub: EditSite,
  rename_symbol: String,
  rename_replacement: String,
}

pub fn corpus_at(dir: String) -> Result<Corpus, String> / {fs.read_file[work], abort.raise} =
  match fs.read_file[work](under(dir, "corpus.json")) {
    None -> Err("`" ++ dir ++ "` is not a generated corpus: no corpus.json"),
    Some(bytes) -> match json::parse(bytes) {
      Err(e) -> Err("the corpus manifest is not JSON: " ++ e.message),
      Ok(Object(m)) -> {
        let edit = |key: String|
          match map_get(m, key) {
            Some(Object(e)) ->
              Ok({
                path: spine::str_field(e, "path"),
                find: spine::str_field(e, "find"),
                replace: spine::str_field(e, "replace"),
                dependents: spine::int_field(e, "dependents"),
              }),
            _ -> Err("the manifest's `" ++ key ++ "` is not an edit site"),
          };
        match edit("leaf_edit") {
          Err(e) -> Err(e),
          Ok(leaf) -> match edit("hub_edit") {
            Err(e) -> Err(e),
            Ok(hub) -> match map_get(m, "rename") {
              Some(Object(r)) ->
                Ok({
                  modules: spine::int_field(m, "modules"),
                  definitions: spine::int_field(m, "definitions"),
                  tests: spine::int_field(m, "tests"),
                  bytes: spine::int_field(m, "bytes"),
                  leaf: leaf,
                  hub: hub,
                  rename_symbol: spine::str_field(r, "symbol"),
                  rename_replacement: spine::str_field(r, "replacement"),
                }),
              _ -> Err("the manifest carries no `rename`"),
            },
          },
        }
      },
      _ -> Err("the corpus manifest is not an object"),
    },
  }

// --- Mutations, applied and undone ----------------------------------------------------

pub type Applied = List<{ path: String, text: Bytes }>

// Every `.ply` file under the corpus, as a path under the root: the walk `ply test` itself takes.
pub fn ply_files(dir: String) -> List<String> / {fs.list_dir[work], fs.kind[work]} = walk(dir, [])

fn walk(dir: String, acc: List<String>) -> List<String> / {fs.list_dir[work], fs.kind[work]} =
  match fs.list_dir[work](dir) {
    None -> acc,
    Some(names) ->
      fold(names, acc, |inner: List<String>, name: String|
        if name == ".ply-cache" { inner } else {
          let path = under(dir, name);
          match fs.kind[work](path) {
            fs::Dir -> walk(path, inner),
            _ -> if bytes_ends_with(bytes_of_string(name), b".ply") { push(inner, path) }
            else { inner },
          }
        }),
  }

// The rename is a whole-corpus textual substitution; the edit is one site, once. Both answer what
// they changed so the scenario can put it back.
pub fn apply_rename(
  dir: String,
  from: String,
  to: String,
) -> Result<Applied, String> / {fs.list_dir[work], fs.kind[work], fs.read_file[work], fs.write_file[work], abort.raise} = {
  let applied = fold(ply_files(dir), [], |acc: Applied, path: String|
    match fs.read_file[work](path) {
      None -> acc,
      Some(text) -> if bytes_index_of(text, bytes_of_string(from)) != None {
        push(acc, { path: path, text: text })
      } else { acc },
    });
  if len(applied) == 0 {
    Err("`" ++ from ++ "` does not occur in the corpus; the manifest is stale")
  } else {
    let _ = map(applied, |a: { path: String, text: Bytes }|
      fs.write_file[work](a.path, replace_all(a.text, bytes_of_string(from), bytes_of_string(to))));
    Ok(applied)
  }
}

pub fn apply_edit(
  dir: String,
  site: EditSite,
) -> Result<Applied, String> / {fs.read_file[work], fs.write_file[work], abort.raise} = {
  let path = under(dir, site.path);
  match fs.read_file[work](path) {
    None -> Err("the edit site `" ++ site.path ++ "` is not in the corpus"),
    Some(text) -> {
      let find = bytes_of_string(site.find);
      let count = occurrences(text, find);
      if count != 1 {
        Err(
          "the edit site occurs " ++ int_to_string(count) ++ " times in `" ++ site.path
            ++ "`, not once",
        )
      } else {
        let _ = fs.write_file[work](path, replace_first(text, find, bytes_of_string(site.replace)));
        Ok([{ path: path, text: text }])
      }
    },
  }
}

pub fn undo(applied: Applied) -> Unit / {fs.write_file[work]} = {
  let _ = map(applied, |a: { path: String, text: Bytes }| fs.write_file[work](a.path, a.text));
  ()
}

pub fn replace_all(text: Bytes, find: Bytes, replacement: Bytes) -> Bytes =
  match bytes_index_of(text, find) {
    None -> text,
    Some(i) ->
      bytes_concat_all([
        bytes_slice(text, 0, i),
        replacement,
        replace_all(bytes_slice(text, i + bytes_len(find), bytes_len(text)), find, replacement),
      ]),
  }

fn replace_first(text: Bytes, find: Bytes, replacement: Bytes) -> Bytes =
  match bytes_index_of(text, find) {
    None -> text,
    Some(i) ->
      bytes_concat_all([
        bytes_slice(text, 0, i),
        replacement,
        bytes_slice(text, i + bytes_len(find), bytes_len(text)),
      ]),
  }

fn occurrences(text: Bytes, find: Bytes) -> Int =
  match bytes_index_of(text, find) {
    None -> 0,
    Some(i) -> 1 + occurrences(bytes_slice(text, i + bytes_len(find), bytes_len(text)), find),
  }

// --- The runs -------------------------------------------------------------------------

// The result cache under a corpus root, held whole in memory so restoring it is not measured
// as disk work.
pub type Snapshot = List<{ name: String, body: Bytes }>

pub fn take_snapshot(dir: String) -> Snapshot / {fs.list_dir[work], fs.read_file[work]} = {
  let cache = under(dir, ".ply-cache");
  match fs.list_dir[work](cache) {
    None -> [],
    Some(names) ->
      fold(names, [], |acc: Snapshot, name: String|
        match fs.read_file[work](under(cache, name)) {
          Some(body) -> push(acc, { name: name, body: body }),
          None -> acc,
        }),
  }
}

pub fn restore_snapshot(
  dir: String,
  snap: Snapshot,
) -> Unit / {fs.list_dir[work], fs.remove[work], fs.create_dir[work], fs.write_file[work]} = {
  let cache = under(dir, ".ply-cache");
  clear_dir(cache);
  let _ = fs.create_dir[work](cache);
  let _ = map(snap, |f: { name: String, body: Bytes }|
    fs.write_file[work](under(cache, f.name), f.body));
  ()
}

fn clear_dir(dir: String) -> Unit / {fs.list_dir[work], fs.remove[work]} = {
  let _ = match fs.list_dir[work](dir) {
    None -> [],
    Some(names) -> map(names, |name: String| fs.remove[work](under(dir, name))),
  };
  ()
}

pub fn clear_cache(dir: String) -> Unit / {fs.list_dir[work], fs.remove[work]} =
  clear_dir(under(dir, ".ply-cache"))

// One measured run of the product over the corpus.
pub fn once(
  dir: String,
) -> Result<spine::TestReport, String> / {process.spawn[ply], config.get[env], time.elapsed_ms, abort.raise} = {
  let started = time.elapsed_ms();
  let done = spine::ply(["test", ".", "--json", "--color", "never"], dir);
  // The wall, not the report's own clock: the user waits for the process.
  let wall_ms = time.elapsed_ms() - started;
  match spine::report_json(done) {
    Err(why) -> Err(why),
    Ok(j) -> match spine::test_report(j) {
      Err(e) -> Err(e),
      Ok(r) -> Ok({ ..r, duration_ms: wall_ms }),
    },
  }
}

fn go_repeat(
  dir: String,
  left: Int,
  clear: Bool,
  acc: List<spine::TestReport>,
) -> Result<List<spine::TestReport>, String> / {process.spawn[ply], config.get[env], time.elapsed_ms, fs.list_dir[work], fs.remove[work], abort.raise} =
  if left <= 0 { Ok(acc) } else {
    let _ = if clear { clear_cache(dir) } else { () };
    match once(dir) { Err(e) -> Err(e), Ok(r) -> go_repeat(dir, left - 1, clear, push(acc, r)) }
  }

pub type Mutation = | Rename | Leaf | Hub

// A mutated scenario's runs: the warm cache restored before each repeat, the mutation undone after,
// so the next scenario starts from the state everyone chose.
fn mutated(
  dir: String,
  corpus: Corpus,
  repeats: Int,
  which: Mutation,
) -> Result<List<spine::TestReport>, String> / {process.spawn[ply], config.get[env], time.elapsed_ms, fs.read[work], fs.write[work], abort.raise} = {
  let snap = take_snapshot(dir);
  let applied = match which {
    Rename -> apply_rename(dir, corpus.rename_symbol, corpus.rename_replacement),
    Leaf -> apply_edit(dir, corpus.leaf),
    Hub -> apply_edit(dir, corpus.hub),
  };
  match applied {
    Err(e) -> Err(e),
    Ok(changed) -> {
      let runs = go_mutation(if repeats < 1 { 1 } else { repeats }, dir, snap, []);
      undo(changed);
      let _ = restore_snapshot(dir, snap);
      runs
    },
  }
}

fn go_mutation(
  left: Int,
  dir: String,
  snap: Snapshot,
  acc: List<spine::TestReport>,
) -> Result<List<spine::TestReport>, String> / {process.spawn[ply], config.get[env], time.elapsed_ms, fs.list_dir[work], fs.remove[work], fs.create_dir[work], fs.write_file[work], abort.raise} =
  if left <= 0 { Ok(acc) } else {
    let _ = restore_snapshot(dir, snap);
    match once(dir) { Err(e) -> Err(e), Ok(r) -> go_mutation(left - 1, dir, snap, push(acc, r)) }
  }

// --- The rows -------------------------------------------------------------------------------

// What one scenario's fastest run reported.
pub fn scenario_measurements(r: spine::TestReport) -> List<Measurement> =
  [
    number("wall", r.duration_ms, "ms"),
    number("tests", r.total, "tests"),
    number("selected", r.selected, "tests"),
    number("cached", r.cached, "tests"),
    number("passed", r.passed, "tests"),
    number("failed", r.failed, "tests"),
    number("groups", r.groups, "groups"),
    number("read", r.read_ms, "ms"),
    number("front", r.front_ms, "ms"),
    number("write_back", r.write_back_ms, "ms"),
  ]

fn cold_row(r: spine::TestReport) -> Row =
  row(
    "cold",
    holding(
      "empty cache: every test runs, and passes",
      ["cached", "failed", "passed", "tests"],
      |vs: List<Decimal>|
        match vs {
          [cached, failed, passed, total] -> cached == 0m && failed == 0m && passed == total,
          _ -> false,
        },
    ),
    scenario_measurements(r),
  )

fn warm_row(r: spine::TestReport) -> Row =
  row("warm", AtMost("selected", 0m), scenario_measurements(r))

fn rename_row(r: spine::TestReport) -> Row =
  row("rename", AtMost("selected", 0m), scenario_measurements(r))

fn leaf_row(r: spine::TestReport) -> Row =
  row(
    "edit-leaf",
    holding(
      "editing a leaf selects what it reaches and no more",
      ["selected", "tests"],
      |vs: List<Decimal>|
        match vs { [selected, total] -> selected > 0m && selected * 2m <= total, _ -> false },
    ),
    scenario_measurements(r),
  )

// The dependents and the definitions they are a share of are the manifest's, and they are in the row
// so its verdict is a function of the numbers it shows.
fn hub_row(c: Corpus, r: spine::TestReport) -> Row =
  row(
    "edit-hub",
    holding(
      "a hub edit re-runs at least its dependents' share of the tests",
      ["selected", "tests", "dependents", "definitions"],
      |vs: List<Decimal>|
        match vs {
          [selected, total, dependents, definitions] ->
            selected * definitions >= dependents * total,
          _ -> false,
        },
    ),
    push(
      push(scenario_measurements(r), number("dependents", c.hub.dependents, "definitions")),
      number("definitions", c.definitions, "definitions"),
    ),
  )

fn pipeline_row(staged: Result<pipeline::Stages, String>) -> Row = {
  let criterion = holding(
    "the harness walked and read the tree the toolchain compiled",
    ["files"],
    |vs: List<Decimal>| match vs { [files] -> files > 0m, _ -> false },
  );
  match staged {
    Err(why) -> untaken("pipeline", criterion, why),
    Ok(s) -> row("pipeline", criterion, pipeline::stage_measurements(s)),
  }
}

// What `bench` measured: the corpus it read, and one row per scenario.
pub type Benched = { corpus: Corpus, rows: List<Row> }

pub fn measured(
  dir: String,
  repeats: Int,
) -> Result<Benched, String> / {process.spawn[ply], config.get[env], time.elapsed_ms, time.elapsed_us, fs.read[work], fs.write[work], abort.raise} =
  match corpus_at(dir) {
    Err(why) -> Err(why),
    Ok(corpus) -> match go_repeat(dir, repeats, true, []) {
      Err(e) -> Err(e),
      Ok(cold) -> match go_repeat(dir, repeats, false, []) {
        Err(e) -> Err(e),
        Ok(warm) -> match mutated(dir, corpus, repeats, Rename) {
          Err(e) -> Err(e),
          Ok(renamed) -> match mutated(dir, corpus, repeats, Leaf) {
            Err(e) -> Err(e),
            Ok(leaf) -> match mutated(dir, corpus, repeats, Hub) {
              Err(e) -> Err(e),
              Ok(hub) ->
                Ok({
                  corpus: corpus,
                  rows: [
                    cold_row(spine::best_of(cold)),
                    warm_row(spine::best_of(warm)),
                    rename_row(spine::best_of(renamed)),
                    leaf_row(spine::best_of(leaf)),
                    hub_row(corpus, spine::best_of(hub)),
                    pipeline_row(pipeline::stages(dir)),
                  ],
                }),
            },
          },
        },
      },
    },
  }

// --- The report -------------------------------------------------------------------------------

pub fn title_of(dir: String, corpus: Corpus) -> String =
  dir ++ "\n" ++ int_to_string(corpus.modules) ++ " modules · "
    ++ int_to_string(corpus.definitions)
    ++ " definitions · "
    ++ int_to_string(corpus.tests)
    ++ " tests · "
    ++ int_to_string(corpus.bytes / 1024)
    ++ " KiB of source"

pub fn corpus_json(dir: String, corpus: Corpus) -> Json =
  object([
    { key: "root", value: Str(dir) },
    { key: "modules", value: Number(decimal_of_int(corpus.modules)) },
    { key: "definitions", value: Number(decimal_of_int(corpus.definitions)) },
    { key: "tests", value: Number(decimal_of_int(corpus.tests)) },
    { key: "source_bytes", value: Number(decimal_of_int(corpus.bytes)) },
  ])

// The scenarios, in order: each resets what it must, repeats, and keeps its fastest run.
pub fn run(
  dir: String,
  repeats: Int,
) -> Result<report::Report, String> / {process.spawn[ply], config.get[env], time.elapsed_ms, time.elapsed_us, fs.read[work], fs.write[work], fs.read[repo], abort.raise} =
  match measured(dir, repeats) {
    Err(why) -> Err(why),
    Ok(b) ->
      report::made("bench", title_of(dir, b.corpus), b.rows, [
        { key: "corpus", value: corpus_json(dir, b.corpus) },
      ]),
  }

// --- Tests -------------------------------------------------------------------------------------

fn a_run() -> spine::TestReport =
  {
    ok: true,
    duration_ms: 12,
    total: 4,
    selected: 0,
    passed: 4,
    failed: 0,
    cached: 4,
    groups: 1,
    read_ms: 0,
    front_ms: 1,
    write_back_ms: 0,
  }

fn a_corpus() -> Corpus =
  {
    modules: 2,
    definitions: 5,
    tests: 4,
    bytes: 2048,
    leaf: { path: "a", find: "x", replace: "y", dependents: 1 },
    hub: { path: "b", find: "p", replace: "q", dependents: 3 },
    rename_symbol: "s",
    rename_replacement: "t",
  }

test "the manifest's edit sites decode" {
  let m = "{\"modules\": 2, \"definitions\": 5, \"tests\": 4, \"bytes\": 100, \"leaf_edit\": {\"path\": \"a.ply\", \"find\": \"x\", \"replace\": \"y\", \"dependents\": 1}, \"hub_edit\": {\"path\": \"b.ply\", \"find\": \"p\", \"replace\": \"q\", \"dependents\": 4}, \"rename\": {\"symbol\": \"s\", \"replacement\": \"t\"}}";
  match json::parse(bytes_of_string(m)) { Ok(Object(_)) -> assert(true), _ -> assert(false) }
}

test "replace_all substitutes every occurrence" {
  assert_eq(replace_all(b"a.b.c", b".", b"-"), b"a-b-c");
  assert_eq(replace_all(b"nothing here", b"zzz", b"y"), b"nothing here");
}

test "a rename that selects anything fails with the count it selected" {
  assert_eq(
    report::judged_alone(rename_row({ ..a_run(), selected: 2, cached: 2 })),
    report::Fail([number("selected", 2, "tests")]),
  );
  assert_eq(report::judged_alone(rename_row(a_run())), report::Pass)
}

test "a cold run fails when anything was cached or failed" {
  let cold = { ..a_run(), selected: 4, cached: 0 };
  assert_eq(report::judged_alone(cold_row(cold)), report::Pass);
  assert(report::judged_alone(cold_row({ ..cold, cached: 1 })) != report::Pass);
  assert(report::judged_alone(cold_row({ ..cold, failed: 1, passed: 3 })) != report::Pass)
}

test "a leaf edit selects some tests and not most of them" {
  assert(report::judged_alone(leaf_row(a_run())) != report::Pass);
  assert_eq(report::judged_alone(leaf_row({ ..a_run(), selected: 2 })), report::Pass);
  assert(report::judged_alone(leaf_row({ ..a_run(), selected: 3 })) != report::Pass)
}

test "a hub edit is judged against the share the manifest counts" {
  // Three dependents of five definitions: at least three fifths of four tests, so three.
  assert_eq(report::judged_alone(hub_row(a_corpus(), { ..a_run(), selected: 3 })), report::Pass);
  assert(report::judged_alone(hub_row(a_corpus(), { ..a_run(), selected: 2 })) != report::Pass)
}

test "the report's title is the corpus it benched" {
  let r = report::report_of(
    "bench",
    title_of("sweep/m2", a_corpus()),
    { corpus: "b3:c0", runtime: "ply 1" },
    [warm_row(a_run())],
    [{ key: "corpus", value: corpus_json("sweep/m2", a_corpus()) }],
  );
  assert(string_starts_with(report::rendered(r), "sweep/m2\n2 modules · 5 definitions"));
  assert(
    string_contains(report::rendered(r), "✓ warm  wall 12ms · 4 tests · selected 0 tests"),
  );
  assert(string_contains(json::to_string(report::to_json(r)), "\"root\":\"sweep/m2\""))
}
