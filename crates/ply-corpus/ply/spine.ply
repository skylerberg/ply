// The corpus's orchestration spine. A measurement is the product's own report: a real `ply`
// subprocess, its JSON read back. Nothing here reaches inside the toolchain; what `ply` does not
// report, the spine does not know.

import cli.cmdline
import std.json (Json, Str, Number, Bool, Null, Object, Array, object, array)
import std.json
import std.process (process, Finished, Var, var, exit_code)
import std.process
import std.config (config)

// --- Driving the product ---------------------------------------------------------

// One run of the real `ply`, bound for the run under the `ply` label, in `dir`: a path relative to
// the working directory, which is the `work` root too, so the child sees the tree the program does.
pub fn ply(args: List<String>, dir: String) -> Finished / {process.spawn[ply], config.get[env]} =
  process.spawn[ply](args, dir, inherited_env())

// What a child is given of the run's environment: the few variables the toolchain reads, and no
// others.
pub fn inherited_env() -> List<Var> / {config.get[env]} =
  fold(["HOME", "TMPDIR", "PATH"], [], |acc: List<Var>, name: String|
    match config.get[env](name) { Some(v) -> push(acc, var(name, v)), None -> acc })

// `name` under `dir`, both relative to one root; `.` is the root itself and is not spelled.
pub fn under(dir: String, name: String) -> String =
  if dir == "." || dir == "" { name } else { dir ++ "/" ++ name }

pub fn exit_zero(f: Finished) -> Bool = exit_code(f) == Some(0)

// The stdout of a run that succeeded, decoded; a failure carries the child's stderr.
pub fn report_json(f: Finished) -> Result<Json, String> =
  match exit_code(f) {
    Some(0) -> document(f),
    Some(code) -> Err("ply exited " ++ int_to_string(code) ++ ": " ++ string_of_bytes_lossy(f.err)),
    None -> Err("ply was signalled: " ++ string_of_bytes_lossy(f.err)),
  }

// The one document a `--json` run wrote, whatever it exited with: a report that says no is still a
// report, and its `ok` is what says so.
pub fn document(f: Finished) -> Result<Json, String> =
  match exit_code(f) {
    None -> Err("ply was signalled: " ++ string_of_bytes_lossy(f.err)),
    Some(code) -> match json::parse(f.out) {
      Ok(j) -> Ok(j),
      Err(e) ->
        Err(
          "ply exited " ++ int_to_string(code) ++ " and its report was not JSON (" ++ e.message
            ++ "): "
            ++ string_of_bytes_lossy(f.err),
        ),
    },
  }

// Why a `--json` run refused the tree it was given: it exits 2, and its diagnostics say why.
pub fn refusal(j: Json) -> Option<String> =
  match j {
    Object(m) -> if int_field(m, "exit_code") != 2 { None } else {
      match objects(array_field(m, "diagnostics")) {
        [d, ..] -> Some(str_field(d, "message")),
        [] -> Some("it exited 2 and gave no diagnostic"),
      }
    },
    _ -> None,
  }

// --- Reading a report --------------------------------------------------------------

pub fn field(m: Map<String, Json>, key: String) -> Result<Map<String, Json>, String> =
  match map_get(m, key) {
    Some(Object(inner)) -> Ok(inner),
    _ -> Err("the report's `" ++ key ++ "` is not an object"),
  }

// A number toward zero; anything else, or one no `Int` holds, is `0`.
fn int_of(j: Json) -> Int =
  match j { Number(d) -> match int_of_decimal(d, Down) { Some(n) -> n, None -> 0 }, _ -> 0 }

pub fn int_field(m: Map<String, Json>, key: String) -> Int =
  match map_get(m, key) { Some(j) -> int_of(j), None -> 0 }

// Each item of an array field, read as `int_field` reads a number.
pub fn ints_field(m: Map<String, Json>, key: String) -> List<Int> = map(array_field(m, key), int_of)

// A number the report may leave out, or write as `null`.
pub fn opt_int_field(m: Map<String, Json>, key: String) -> Option<Int> =
  match map_get(m, key) { Some(Number(d)) -> int_of_decimal(d, Down), _ -> None }

pub fn decimal_field(m: Map<String, Json>, key: String) -> Decimal =
  match map_get(m, key) { Some(Number(d)) -> d, _ -> 0m }

pub fn bool_field(m: Map<String, Json>, key: String) -> Bool =
  match map_get(m, key) { Some(Bool(b)) -> b, _ -> false }

pub fn str_field(m: Map<String, Json>, key: String) -> String =
  match map_get(m, key) { Some(Str(s)) -> s, _ -> "" }

pub fn array_field(m: Map<String, Json>, key: String) -> List<Json> =
  match map_get(m, key) { Some(Array(xs)) -> xs, _ -> [] }

// The members of each object in a list; anything else in it is skipped.
pub fn objects(xs: List<Json>) -> List<Map<String, Json>> =
  fold(xs, [], |acc: List<Map<String, Json>>, x: Json|
    match x { Object(m) -> push(acc, m), _ -> acc })

// Milliseconds as the product writes them, to the microsecond, as whole microseconds.
pub fn us_of_ms(ms: Decimal) -> Int =
  match int_of_decimal(ms * 1000m, HalfEven) { Some(n) -> n, None -> 0 }

// A count written on a line or in a child's output, spaces around it allowed.
pub fn count_of(text: String) -> Option<Int> = cmdline::parse_nat(string_trim(text))

// --- A `ply test` report --------------------------------------------------------------

pub type TestReport = {
  ok: Bool,
  duration_ms: Int,
  total: Int,
  selected: Int,
  passed: Int,
  failed: Int,
  cached: Int,
  groups: Int,
  read_ms: Int,
  front_ms: Int,
  write_back_ms: Int,
}

pub fn test_report(j: Json) -> Result<TestReport, String> =
  match j {
    Object(m) -> match field(m, "selection") {
      Err(e) -> Err(e),
      Ok(selection) -> match field(m, "summary") {
        Err(e) -> Err(e),
        Ok(summary) -> match field(m, "front_end") {
          Err(e) -> Err(e),
          Ok(front_end) -> match field(front_end, "phases") {
            Err(e) -> Err(e),
            Ok(phases) ->
              Ok({
                ok: bool_field(m, "ok"),
                duration_ms: int_field(m, "duration_ms"),
                total: int_field(selection, "total"),
                selected: int_field(selection, "selected"),
                passed: int_field(summary, "passed"),
                failed: int_field(summary, "failed"),
                cached: int_field(summary, "cached"),
                groups: len(array_field(selection, "groups")),
                read_ms: int_field(phases, "read"),
                front_ms: int_field(phases, "front"),
                write_back_ms: int_field(phases, "write_back"),
              }),
          },
        },
      },
    },
    _ -> Err("the report is not an object"),
  }

// The fastest of `n` runs; a bench reports its best case, and the repeats are what make the
// best a measurement rather than a reading.
pub fn best_of(runs: List<TestReport>) -> TestReport =
  match fold(runs, None, |acc: Option<TestReport>, r: TestReport|
      match acc {
        None -> Some(r),
        Some(best) -> Some(if r.duration_ms < best.duration_ms { r } else { best }),
      }) {
    Some(b) -> b,
    None -> panic("best of no runs"),
  }

// --- Tests -----------------------------------------------------------------------------

test "a name under the root itself is the name alone" {
  assert_eq(under(".", "corpus.json"), "corpus.json");
  assert_eq(under("sweep/m4_d5_t8", "corpus.json"), "sweep/m4_d5_t8/corpus.json")
}

test "best_of keeps the fastest" {
  let r1: TestReport = {
    ok: true,
    duration_ms: 80,
    total: 3,
    selected: 3,
    passed: 3,
    failed: 0,
    cached: 0,
    groups: 1,
    read_ms: 1,
    front_ms: 60,
    write_back_ms: 1,
  };
  let r2: TestReport = { ..r1, duration_ms: 40 };
  assert_eq(best_of([r1, r2]).duration_ms, 40);
}

test "a run that refused its tree is read as the diagnostic it gave, and only such a run" {
  let refused = "{\"command\":\"prove\",\"ok\":false,\"exit_code\":2,\"diagnostics\":[{\"code\":\"E0201\",\"message\":\"type mismatch\"}]}";
  let failed = "{\"command\":\"prove\",\"ok\":false,\"exit_code\":1,\"diagnostics\":[]}";
  match ((json::parse_string(refused), json::parse_string(failed))) {
    (Ok(r), Ok(f)) -> {
      assert_eq(refusal(r), Some("type mismatch"));
      assert_eq(refusal(f), None)
    },
    _ -> panic("the reports are JSON"),
  }
}

test "a millisecond reading is whole microseconds" {
  assert_eq(us_of_ms(12.345m), 12345);
  assert_eq(us_of_ms(0.0004m), 0);
  assert_eq(us_of_ms(0m), 0)
}
