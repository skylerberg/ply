// The real-code row: the compiler and the CLI themselves as corpus members, each pinned by the digest
// of the sources `ply` reads for it. Real code is the realism benchmark; the synthetic corpora are for
// controlled variables. The members are the checkout's own trees under the working directory — `real`
// runs from the repository's root — so the tree `ply` is spawned over is the one the pin was read
// from.

import pin
import pin (Member)
import report
import report (Row, Measurement, holding, number)
import product
import std.json (Json, Str, Object, object, array)
import std.json
import std.fs (fs)
import std.process (process)
import std.config (config)
import std.time (time)

// A member before it is pinned: its name, and the tree `ply` is spawned over.
type Tree = { name: String, dir: String }

// The toolchain's own trees: the compiler's modules, and the CLI package with what it depends on.
fn toolchain() -> List<Tree> =
  [{ name: "compiler", dir: "crates/ply-compiler/ply" }, { name: "cli", dir: "crates/ply-cli/ply" }]

pub fn names() -> List<String> = map(toolchain(), |t: Tree| t.name)

fn chosen(only: Option<String>) -> Result<List<Tree>, String> =
  match only {
    None -> Ok(toolchain()),
    Some(name) -> match filter(toolchain(), |t: Tree| t.name == name) {
      [] -> Err("no member of the toolchain is named `" ++ name ++ "`"),
      found -> Ok(found),
    },
  }

pub fn members(
  only: Option<String>,
) -> Result<List<Member>, String> / {fs.read[work], abort.raise, diverges} =
  match chosen(only) {
    Err(e) -> Err(e),
    Ok(trees) ->
      fold(trees, Ok([]), |acc: Result<List<Member>, String>, t: Tree|
        match acc {
          Err(e) -> Err(e),
          Ok(pinned) -> match pin::member[work](t.name, t.dir) {
            Err(e) -> Err(e ++ ": run `real` from the repository's root"),
            Ok(m) -> Ok(push(pinned, m)),
          },
        }),
  }

// --- Measuring one --------------------------------------------------------------------------

// `ply check` on a tree: the front end's own numbers, its verdict, and the wall the user waits.
pub fn check(
  dir: String,
) -> Result<List<Measurement>, String> / {process.spawn[ply], config.get[env], time.elapsed_ms, abort.raise} = {
  let started = time.elapsed_ms();
  let done = product::ply(["check", ".", "--json", "--color", "never"], dir);
  let wall = time.elapsed_ms() - started;
  match product::document(done) {
    Err(why) -> Err(why),
    Ok(Object(m)) ->
      Ok([
        number("ok", report::one_if(product::bool_field(m, "ok")), ""),
        number("wall", wall, "ms"),
        number(
          "front",
          match product::field(m, "front_end") {
            Ok(fe) -> match product::field(fe, "phases") {
              Ok(phases) -> product::int_field(phases, "total"),
              Err(_) -> 0,
            },
            Err(_) -> 0,
          },
          "ms",
        ),
        number("modules", len(product::array_field(m, "modules")), "modules"),
        number("definitions", len(product::array_field(m, "definitions")), "definitions"),
        number("tests", len(product::array_field(m, "tests")), "tests"),
      ]),
    _ -> Err("the check report is not an object"),
  }
}

// `ply test` on a tree: the suite's own verdict, and the wall.
pub fn tested(
  dir: String,
) -> Result<List<Measurement>, String> / {process.spawn[ply], config.get[env], time.elapsed_ms, abort.raise} = {
  let started = time.elapsed_ms();
  let done = product::ply(["test", ".", "--json", "--color", "never"], dir);
  let wall = time.elapsed_ms() - started;
  match product::document(done) {
    Err(why) -> Err(why),
    Ok(j) -> match product::test_report(j) {
      Err(e) -> Err(e),
      Ok(r) ->
        Ok([
          number("ok", report::one_if(r.ok), ""),
          number("wall", wall, "ms"),
          number("tests", r.total, "tests"),
          number("passed", r.passed, "tests"),
          number("failed", r.failed, "tests"),
          number("cached", r.cached, "tests"),
        ]),
    },
  }
}

// --- The rows -----------------------------------------------------------------------------

fn check_row(m: Member, taken: Result<List<Measurement>, String>) -> Row =
  {
    name: m.name ++ " check",
    criterion: holding("the tree front-ends clean", ["ok"], |vs: List<Decimal>| vs == [1m]),
    taken: taken,
    detail: Str(m.digest),
  }

fn test_row(m: Member, taken: Result<List<Measurement>, String>) -> Row =
  {
    name: m.name ++ " test",
    criterion: holding("the tree's tests all pass", ["ok", "failed"], |vs: List<Decimal>|
      vs == [1m, 0m]),
    taken: taken,
    detail: Str(m.digest),
  }

pub fn rows_of(
  member: Member,
  checked: Result<List<Measurement>, String>,
  tests: Option<Result<List<Measurement>, String>>,
) -> List<Row> =
  match tests {
    None -> [check_row(member, checked)],
    Some(t) -> [check_row(member, checked), test_row(member, t)],
  }

// The members chosen, in order, each pinned, front-ended and (unless told otherwise) tested.
pub fn run(
  tests: Bool,
  only: Option<String>,
) -> Result<report::Report, String> / {fs.read[work], fs.read[repo], process.spawn[ply], config.get[env], time.elapsed_ms, abort.raise, diverges} =
  match members(only) {
    Err(e) -> Err(e),
    Ok(ms) -> {
      let rows = fold(ms, [], |acc: List<Row>, m: Member| {
        let checked = check(m.dir);
        let t = if tests { Some(tested(m.dir)) } else { None };
        fold(rows_of(m, checked, t), acc, |out: List<Row>, row: Row| push(out, row))
      });
      report::made("real", title_of(ms), rows, [
        { key: "members", value: array(map(ms, member_json)) },
      ])
    },
  }

fn title_of(ms: List<Member>) -> String =
  fold(ms, "the toolchain, pinned by digest", |acc: String, m: Member|
    acc ++ "\n  " ++ m.name ++ "  " ++ m.digest)

fn member_json(m: Member) -> Json =
  object([
    { key: "name", value: Str(m.name) },
    { key: "dir", value: Str(m.dir) },
    { key: "digest", value: Str(m.digest) },
    { key: "trees", value: array(map(m.trees, |tree: String| Str(tree))) },
  ])

// --- Tests -----------------------------------------------------------------------------

fn a_member() -> Member = { name: "compiler", dir: ".", trees: ["."], digest: "b3:abc123" }

fn outcomes(rows: List<Row>) -> List<report::Verdict> =
  map(report::judge(rows), |judged: report::Judged| judged.verdict)

test "a member's check fails with the verdict the product gave" {
  let refused = [number("ok", 0, ""), number("wall", 1, "ms")];
  assert_eq(outcomes(rows_of(a_member(), Ok(refused), None)), [report::Fail([number("ok", 0, "")])])
}

test "a member's tests pass only when the product said so and nothing failed" {
  let checked = [number("ok", 1, "")];
  let green = [number("ok", 1, ""), number("failed", 0, "tests")];
  let red = [number("ok", 0, ""), number("failed", 2, "tests")];
  assert_eq(outcomes(rows_of(a_member(), Ok(checked), Some(Ok(green)))), [
    report::Pass,
    report::Pass,
  ]);
  assert_eq(outcomes(rows_of(a_member(), Ok(checked), Some(Ok(red)))), [
    report::Pass,
    report::Fail(red),
  ]);
  assert_eq(outcomes(rows_of(a_member(), Err("ply was signalled"), None)), [
    report::Inconclusive("ply was signalled"),
  ])
}

test "the table pins each member's digest beside its rows" {
  let r = report::report_of(
    "real",
    title_of([a_member()]),
    { corpus: "b3:c0", runtime: "ply 1" },
    rows_of(a_member(), Ok([number("ok", 1, "")]), None),
    [],
  );
  assert(
    string_starts_with(
      report::rendered(r),
      "the toolchain, pinned by digest\n  compiler  b3:abc123\n",
    ),
  );
  assert(string_contains(json::to_string(report::to_json(r)), "\"detail\":\"b3:abc123\""))
}

fn names_of(trees: Result<List<Tree>, String>) -> List<String> =
  match trees { Ok(ts) -> map(ts, |t: Tree| t.name), Err(_) -> [] }

test "a member is taken by its name, every one when none is named, and no other name is one" {
  assert_eq(names_of(chosen(None)), ["compiler", "cli"]);
  assert_eq(names_of(chosen(Some("cli"))), ["cli"]);
  assert_eq(chosen(Some("std")), Err("no member of the toolchain is named `std`"))
}
