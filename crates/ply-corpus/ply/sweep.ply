// `sweep`: a corpus generated and benched at each of several sizes, for one comparison table. A size
// is `modules,defs_per_module,tests`, laid over the generator's defaults with the sweep's seed, and
// each is written to a directory of its own under the sweep's; its rows are the bench's, named under
// that directory.

import bench
import cli.cmdline
import gbuild
import gen
import report
import report (Row)
import spine (under)
import std.json (Json, array)
import std.fs (fs)
import std.process (process)
import std.config (config)
import std.time (time)

pub type Size = { dir: String, text: String, spec: gbuild::Spec }

fn number(text: String) -> Result<Int, String> / {abort.raise} = {
  let digits = string_trim(text);
  match cmdline::parse_nat(digits) {
    Some(n) -> Ok(n),
    None -> Err("`" ++ digits ++ "` is not a number"),
  }
}

// One size, as the spec it asks the generator for; refused before anything is written when that
// spec is not one the generator takes.
pub fn size_of(text: String, seed: Int) -> Result<Size, String> / {abort.raise} =
  match string_split(text, ",") {
    [m, d, t] -> match number(m) {
      Err(e) -> Err(e),
      Ok(modules) -> match number(d) {
        Err(e) -> Err(e),
        Ok(defs) -> match number(t) {
          Err(e) -> Err(e),
          Ok(tests) -> {
            let base = gen::default_spec();
            let spec = {
              ..base,
              seed: seed,
              modules: modules,
              defs_per_module: defs,
              tests: tests,
              depth: min(4, max(modules, 1)),
            };
            match gen::validate(spec) {
              Err(why) -> Err("`" ++ text ++ "`: " ++ why),
              Ok(valid) ->
                Ok({
                  dir: "m" ++ int_to_string(modules) ++ "_d" ++ int_to_string(defs) ++ "_t"
                    ++ int_to_string(tests),
                  text: text,
                  spec: valid,
                }),
            }
          },
        },
      },
    },
    _ -> Err("`" ++ text ++ "` is not `modules,defs_per_module,tests`"),
  }

pub fn sizes_of(texts: List<String>, seed: Int) -> Result<List<Size>, String> / {abort.raise} =
  fold(texts, Ok([]), |acc: Result<List<Size>, String>, text: String|
    match acc {
      Err(e) -> Err(e),
      Ok(sizes) -> match size_of(text, seed) { Err(e) -> Err(e), Ok(s) -> Ok(push(sizes, s)) },
    })

// One size benched: where it was written, and the bench's rows over it.
pub type Swept = { size: Size, root: String, benched: bench::Benched }

// Each size generated under `out`, verified, and benched, in order; the first that fails stops the
// sweep and says which size it was.
pub fn run(
  out: String,
  sizes: List<Size>,
  repeats: Int,
) -> Result<report::Report, String> / {process.spawn[ply], config.get[env], time.elapsed_ms, time.elapsed_us, fs.read[work], fs.write[work], fs.read[repo], abort.raise} =
  match fold(sizes, Ok([]), |acc: Result<List<Swept>, String>, size: Size|
      match acc {
        Err(e) -> Err(e),
        Ok(done) -> {
          let root = under(out, size.dir);
          match gen::run(root, size.spec, false) {
            Err(why) -> Err("the corpus for `" ++ size.text ++ "` does not compile: " ++ why),
            Ok(_) -> match bench::measured(root, repeats) {
              Err(e) -> Err(e),
              Ok(b) -> Ok(push(done, { size: size, root: root, benched: b })),
            },
          }
        },
      }) {
    Err(e) -> Err(e),
    Ok(swept) ->
      report::made("sweep", title_of(out, swept), rows_of(swept), [
        {
          key: "sizes",
          value: array(map(swept, |s: Swept| bench::corpus_json(s.root, s.benched.corpus))),
        },
      ]),
  }

// Every size's rows, each named under the size's directory.
pub fn rows_of(swept: List<Swept>) -> List<Row> =
  fold(swept, [], |acc: List<Row>, s: Swept|
    fold(report::prefixed(s.size.dir ++ " ", s.benched.rows), acc, |out: List<Row>, r: Row|
      push(out, r)))

fn title_of(out: String, swept: List<Swept>) -> String =
  fold(swept, "sweep under " ++ out, |acc: String, s: Swept|
    acc ++ "\n  " ++ s.size.dir ++ ": " ++ int_to_string(s.benched.corpus.modules) ++ " modules · "
      ++ int_to_string(s.benched.corpus.definitions)
      ++ " definitions · "
      ++ int_to_string(s.benched.corpus.tests)
      ++ " tests")

// --- Tests ------------------------------------------------------------------

fn sized(text: String, seed: Int) -> Size / {abort.raise} =
  match size_of(text, seed) { Ok(s) -> s, Err(why) -> panic(why) }

test "a size is three numbers and nothing else" {
  let s = sized("10,20,30", 5);
  assert_eq((s.spec.modules, s.spec.defs_per_module, s.spec.tests), (10, 20, 30));
  assert_eq(s.spec.seed, 5);
  assert_eq(s.dir, "m10_d20_t30");
  assert(match size_of("10,20", 1) { Err(_) -> true, Ok(_) -> false });
  assert(match size_of("10,20,x", 1) { Err(why) -> string_contains(why, "`x`"), Ok(_) -> false });
  assert(match size_of("10,-2,4", 1) { Err(_) -> true, Ok(_) -> false })
}

test "a sweep never asks for more layers than it has modules" {
  assert_eq(sized("2,5,5", 1).spec.depth, 2);
  assert_eq(sized("40,25,500", 1).spec.depth, 4)
}

fn benched(selected: Int) -> bench::Benched =
  {
    corpus: {
      modules: 2,
      definitions: 5,
      tests: 4,
      bytes: 100,
      leaf: { path: "a", find: "x", replace: "y", dependents: 1 },
      hub: { path: "b", find: "p", replace: "q", dependents: 3 },
      rename_symbol: "s",
      rename_replacement: "t",
    },
    rows: [
      report::row("warm", report::AtMost("selected", 0m), [
        report::number("selected", selected, "tests"),
      ]),
    ],
  }

test "every size's rows are named under its directory, in the order the sizes were asked for" {
  let swept = [
    { size: sized("4,5,8", 1), root: "s/m4_d5_t8", benched: benched(0) },
    { size: sized("6,5,8", 1), root: "s/m6_d5_t8", benched: benched(2) },
  ];
  let judged = report::judge(rows_of(swept));
  assert_eq(map(judged, |j: report::Judged| j.row.name), ["m4_d5_t8 warm", "m6_d5_t8 warm"]);
  assert_eq(map(judged, |j: report::Judged| report::passed(j)), [true, false])
}

test "a size the generator would refuse stops the sweep before it writes anything" {
  assert(match sizes_of(["4,5,8", "0,5,8"], 1) {
    Err(why) -> string_contains(why, "`0,5,8`") && string_contains(why, "at least one module"),
    Ok(_) -> false,
  })
}
