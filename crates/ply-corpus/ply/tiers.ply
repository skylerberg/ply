// `tiers` — the statistical gate on the prover's tiers. Corpora are generated with obligations the
// prover can decide; the prover the product drives, lent to this program as the `claims` family,
// discharges every one of them; and every obligation it reports proved is drawn again through its own
// replay, at many cases from many roots. One draw that refutes a proof, or raises under it, is a
// defect in Ply, and too few proofs to draw from is no gate at all.

import cli.claims
import cli.claims (prover)
import gbuild
import gen
import harness
import report
import report (Row, Measurement, AtLeast, AtMost, number, row, untaken)
import spine (under)
import proof.obligation (Binding, Falsified, Held, Kept, NotDrawn, Outcome, Point, Proved, Raised,
                         Rejected, Uncached, Undrawn, reason_word)
import std.json (Json, Str, Number, object, array)
import std.json
import std.fs (fs)
import std.process (process)
import std.config (config)
import std.time (time)

// The fewest proofs an audit may draw from and still be a gate.
fn least_audited() -> Int = 100

// One corpus's shape: small enough to discharge quickly, specified enough that the prover proves some
// of what it carries.
pub fn spec_for(seed: Int) -> gbuild::Spec = {
  let base = gen::default_spec();
  {
    ..base,
    seed: seed,
    modules: 6,
    defs_per_module: 10,
    tests: 20,
    depth: 3,
    spec_fraction: 0.4,
    specimens_per_module: 3,
  }
}

// The job as `ply prove` would configure it over `dir`, hermetic and uncached: a proof the audit
// re-draws is one this run made.
fn options_for(dir: String) -> claims::Options =
  {
    path: dir,
    no_incremental: false,
    no_cache: true,
    std: false,
    jobs: None,
    host: false,
    tls: [],
    trust: [],
    fs: [],
    config: { set: [], files: [], schema: None },
    trace: { sink: "off", level: "info" },
    prove: { cases: None, roots: None, budget: None, shrink_budget: None, steps: None },
    sim: {
      seed: None,
      mode: "dpor",
      seeds: None,
      budget: None,
      steps: None,
      measure_reduction: false,
    },
  }

// A proof a draw contradicted: whose it is, and how.
pub type Defect = { claim: String, how: String }

pub type Audit = { obligations: Int, proved: Int, draws: Int, defects: List<Defect> }

fn rendered(bs: List<Binding>) -> String =
  fold(bs, "", |acc: String, b: Binding|
    (if acc == "" { "" } else { acc ++ ", " }) ++ b.name ++ " = " ++ b.rendered)

// How one draw contradicts a proof, or `None` when it does not: a refutation and a raise are both
// defects, and a draw the guard rejects or the generator could not make says nothing.
pub fn contradiction(point: Point) -> Option<String> =
  match point {
    Falsified(bs) -> Some("refutes it at " ++ rendered(bs)),
    Undrawn(Raised(r)) -> Some("raises `" ++ r.message ++ "` at " ++ rendered(r.bindings)),
    _ -> None,
  }

// What re-drawing one proof came to: the draws made, and the first that contradicted it.
type Drawn = { draws: Int, how: Option<String> }

// Every case from every root, until one contradicts the proof.
fn drawn(
  index: Int,
  root: Int,
  case: Int,
  cases: Int,
  roots: Int,
  draws: Int,
) -> Result<Drawn, String> / {prover.replay[claims]} =
  if root >= roots { Ok({ draws: draws, how: None }) }
  else if case >= cases { drawn(index, root + 1, 0, cases, roots, draws) } else {
    match prover.replay[claims](index, root, case) {
      Err(_) -> Err("the prover would not replay claim " ++ int_to_string(index)),
      Ok(point) -> match contradiction(point) {
        Some(how) ->
          Ok({
            draws: draws + 1,
            how: Some(
              how ++ " (root " ++ int_to_string(root) ++ ", case " ++ int_to_string(case) ++ ")",
            ),
          }),
        None -> drawn(index, root, case + 1, cases, roots, draws + 1),
      },
    }
  }

fn proved(outcome: Outcome) -> Bool = match outcome { Held(h) -> h.tier == Proved, _ -> false }

// One corpus, discharged and re-drawn. The run ends with the review every discharged run may read,
// which is what lets the next corpus start a run of its own.
pub fn audited(
  dir: String,
  cases: Int,
  roots: Int,
) -> Result<Audit, String> / {fs.read[work], fs.read[repo], time.elapsed_us, prover.configure[claims], prover.collected[claims], prover.discharged[claims], prover.replay[claims], prover.reviewed[claims]} =
  match harness::project(dir) {
    Err(why) -> Err(why),
    Ok(sources) -> match harness::fronted(sources) {
      Err(why) -> Err("`" ++ dir ++ "` does not check: " ++ why),
      Ok(pair) -> {
        let (front, _) = pair;
        prover.configure[claims](options_for(dir), front);
        match prover.collected[claims]() {
          Err(_) -> Err("the prover would not collect the obligations of `" ++ dir ++ "`"),
          Ok(c) -> {
            let all = range(0, len(c.claims));
            match prover.discharged[claims]({
                claims: all,
                runs: all,
                // Uncached, as `ply prove --no-cache` says of every claim it runs.
                reasons: map(all, |_i: Int| reason_word(Uncached)),
                domains: [],
              }) {
              Err(_) -> Err("the prover would not discharge the obligations of `" ++ dir ++ "`"),
              Ok(v) -> {
                let proofs = filter(all, |i: Int|
                  match list_at(v.outcomes, i) { Some(o) -> proved(o), None -> false });
                let redrawn = fold(
                  proofs,
                  Ok({ draws: 0, defects: [] }),
                  |acc: Result<{ draws: Int, defects: List<Defect> }, String>, i: Int|
                    match acc {
                      Err(e) -> Err(e),
                      Ok(so_far) -> match drawn(i, 0, 0, cases, roots, 0) {
                        Err(e) -> Err(e),
                        Ok(d) ->
                          Ok({
                            draws: so_far.draws + d.draws,
                            defects: match d.how {
                              None -> so_far.defects,
                              Some(how) ->
                                push(so_far.defects, {
                                  claim: match list_at(c.claims, i) {
                                    Some(claim) -> claims::label_of(claim),
                                    None -> int_to_string(i),
                                  },
                                  how: how,
                                }),
                            },
                          }),
                      },
                    },
                );
                let _ = prover.reviewed[claims]();
                match redrawn {
                  Err(e) -> Err(e),
                  Ok(r) ->
                    Ok({
                      obligations: len(c.claims),
                      proved: len(proofs),
                      draws: r.draws,
                      defects: r.defects,
                    }),
                }
              },
            }
          },
        }
      },
    },
  }

// --- The rows ---------------------------------------------------------------------------

pub fn audit_row(name: String, audit: Result<Audit, String>) -> Row =
  match audit {
    Err(why) -> untaken(name, AtMost("disagreements", 0m), why),
    Ok(a) ->
      {
        ..row(name, AtMost("disagreements", 0m), [number("obligations", a.obligations, "obligations"), number("proved", a.proved, "obligations"), number("draws", a.draws, "draws"), number("disagreements", len(a.defects), "obligations")]),
        detail: array(
          map(a.defects, |d: Defect|
            object([{ key: "claim", value: Str(d.claim) }, { key: "how", value: Str(d.how) }])),
        ),
      },
  }

pub fn total_row(audits: List<Result<Audit, String>>) -> Row = {
  let taken = fold(audits, [], |acc: List<Audit>, a: Result<Audit, String>|
    match a { Ok(x) -> push(acc, x), Err(_) -> acc });
  row("audited", AtLeast("proved", decimal_of_int(least_audited())), [
    number("corpora", len(taken), "corpora"),
    number("proved", fold(taken, 0, |n: Int, a: Audit| n + a.proved), "obligations"),
    number("draws", fold(taken, 0, |n: Int, a: Audit| n + a.draws), "draws"),
  ])
}

pub type Args = { out: String, seeds: Int, cases: Int, roots: Int }

// Each seed's corpus generated under `out` and audited, in order, and the proofs they carried counted.
// A corpus that would not generate is a row that says why; a prover that refused stops the audit,
// since the run it was in cannot be ended for the next one to start.
pub fn run(
  a: Args,
) -> Result<report::Report, String> / {fs.read[work], fs.write[work], fs.read[repo], time.elapsed_us, process.spawn[ply], config.get[env], prover.configure[claims], prover.collected[claims], prover.discharged[claims], prover.replay[claims], prover.reviewed[claims]} =
  match fold(
      range(1, a.seeds + 1),
      Ok([]),
      |acc: Result<List<{ seed: Int, audit: Result<Audit, String> }>, String>, seed: Int|
        match acc {
          Err(e) -> Err(e),
          Ok(done) -> {
            let dir = under(a.out, "seed" ++ int_to_string(seed));
            match gen::run(dir, spec_for(seed), false) {
              Err(why) ->
                Ok(push(done, { seed: seed, audit: Err("the corpus did not generate: " ++ why) })),
              Ok(_) -> match audited(dir, a.cases, a.roots) {
                Err(why) -> Err("seed " ++ int_to_string(seed) ++ ": " ++ why),
                Ok(audit) -> Ok(push(done, { seed: seed, audit: Ok(audit) })),
              },
            }
          },
        },
    ) {
    Err(why) -> Err(why),
    Ok(results) -> {
      let rows = map(results, |r: { seed: Int, audit: Result<Audit, String> }|
        audit_row("seed " ++ int_to_string(r.seed), r.audit));
      report::made(
        "tiers",
        "every proof re-drawn at " ++ int_to_string(a.cases) ++ " cases from each of "
          ++ int_to_string(a.roots)
          ++ " roots",
        push(
          rows,
          total_row(map(results, |r: { seed: Int, audit: Result<Audit, String> }| r.audit)),
        ),
        [
          { key: "cases", value: Number(decimal_of_int(a.cases)) },
          { key: "roots", value: Number(decimal_of_int(a.roots)) },
        ],
      )
    },
  }

// --- Tests -------------------------------------------------------------------------------

fn verdicts(rows: List<Row>) -> List<report::Verdict> =
  map(report::judge(rows), |j: report::Judged| j.verdict)

test "a draw contradicts a proof by refuting it or by raising under it, and in no other way" {
  let b: Binding = { name: "n", ty: "Int", rendered: "3" };
  assert_eq(contradiction(Falsified([b])), Some("refutes it at n = 3"));
  assert_eq(
    contradiction(Undrawn(Raised({ message: "division by zero", bindings: [b] }))),
    Some("raises `division by zero` at n = 3"),
  );
  assert_eq(contradiction(Kept([b])), None);
  assert_eq(contradiction(Rejected), None);
  assert_eq(contradiction(Undrawn(NotDrawn)), None)
}

test "one disagreement fails a corpus's row, and too few proofs fail the audit" {
  let clean: Audit = { obligations: 40, proved: 60, draws: 480000, defects: [] };
  let broken = { ..clean, defects: [{ claim: "law \"x\"", how: "refutes it at n = 3" }] };
  assert_eq(verdicts([audit_row("seed 1", Ok(clean))]), [report::Pass]);
  assert(verdicts([audit_row("seed 1", Ok(broken))]) != [report::Pass]);
  assert_eq(verdicts([total_row([Ok(clean), Ok(clean)])]), [report::Pass]);
  assert(verdicts([total_row([Ok(clean), Err("did not generate")])]) != [report::Pass])
}

test "the audited corpora are the generator's, specified" {
  let s = spec_for(3);
  assert_eq(s.seed, 3);
  assert_eq(gen::validate(s), Ok(s));
  assert(s.spec_fraction > 0.0 && s.specimens_per_module > 0)
}
