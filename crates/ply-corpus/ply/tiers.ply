//! `tiers` — the statistical gate on the prover's proofs. Corpora are generated with obligations the
//! prover can decide; the prover the product drives, lent to this program as the `claims` family,
//! discharges every one of them; and every obligation it reports proved is judged again at points
//! drawn here, many cases from many roots. One draw that refutes a proof, raises under it, or that
//! Ply fails on, is a defect in Ply, and too few proofs to draw from is no gate at all.

import cli.claims
import cli.units (emit)
import cli.machine
import cli.claims (prover, proofs)
import cli.program (owned_of)
import compiler.front (view_of)
import gbuild
import gen
import harness
import report
import report (Row, Criterion, holding, number, row, untaken, verdicts)
import product (under)
import proof.obligation (Binding, Fault, Outcome, Proved, Judged, JFailed, JHeld, JRaised,
                         JRejected, JFaulted, Law, Pure, fault_summary, is_proved)
import proof.candidates (substituted)
import proof.decide (Static)
import proof.discharge (MWhole, bindings)
import proof.domain (Ty, Var, Fn, Record, Con, Decl, Variant, find_decl, name_order)
import proof.world (Binder, Bounded, Built, Obligation, world_of)
import std.bytes (bytes_of_hex)
import std.json (Json, Str, Number, object, array)
import std.json
import std.fs (fs)
import std.process (process)
import std.config (config)
import std.random (Rand, rand_below, rand_bytes, rand_int, rand_keyed)
import std.time (time)
import std.value (Value, VUnit, VBool, VInt, VFloat, VDecimal, VFixed, VChar, VStr, VBytes, VList,
                  VArray, VRecord, VCtor, Field, filled, map_of, render)
import compiler.unit (shipped)

/// The fewest proofs an audit may draw from and still be a gate.
fn least_audited() -> Int = 100

/// Each seed's share of that floor, rounded up: every seed carrying its share meets the floor, whether
/// the seeds are audited in one run or a run each.
fn share(seeds: Int) -> Int / {abort.raise} = (least_audited() + seeds - 1) / seeds

/// One corpus's shape: small enough to discharge quickly, specified enough that the prover proves some
/// of what it carries.
pub fn spec_for(seed: Int) -> gbuild::Spec = {
  let base = gen::default_spec();
  {
    ..base,
    seed: seed,
    modules: 6,
    defs_per_module: 10,
    tests: 20,
    depth: 3,
    spec_fraction: 0.4,
    specimens_per_module: 3,
  }
}

/// The job as `ply prove` would configure it over `dir`, hermetic and uncached: a proof the audit
/// re-draws is one this run made.
fn options_for(dir: String) -> claims::Options =
  {
    path: dir,
    no_incremental: false,
    no_cache: true,
    std: false,
    jobs: None,
    prove: { budget: None, steps: None },
    sim: {
      seed: None,
      mode: "dpor",
      roots: None,
      budget: None,
      steps: None,
      measure_reduction: false,
    },
  }

/// A proof a draw contradicted: whose it is, and how.
pub type Defect = { claim: String, how: String }

pub type Audit = { obligations: Int, proved: Int, draws: Int, defects: List<Defect> }

fn rendered(bs: List<Binding>) -> String / {abort.raise} =
  fold(bs, "", |acc: String, b: Binding|
    (if acc == "" { "" } else { acc ++ ", " }) ++ b.name ++ " = " ++ render(b.value))

/// How one judgement contradicts a proof, or `None` when it does not: a refutation, a raise and Ply
/// failing on it are all defects, and a point the guard rejects says nothing.
pub fn contradiction(judged: Judged, bs: List<Binding>) -> Option<String> / {abort.raise} =
  match judged {
    JFailed -> Some("refutes it at " ++ rendered(bs)),
    JRaised(r) -> Some("raises `" ++ filled(r.message, r.values) ++ "` at " ++ rendered(bs)),
    JFaulted(f) ->
      Some(
        fault_summary({
            code: f.code,
            message: f.message,
            notes: f.notes,
            values: f.values,
            bindings: bs,
          })
          ++ at_point(bs),
      ),
    _ -> None,
  }

/// Where Ply failed, when it had drawn a point to fail at.
fn at_point(bs: List<Binding>) -> String / {abort.raise} =
  if len(bs) == 0 { "" } else { ", at " ++ rendered(bs) }

// --- Drawing a point ------------------------------------------------------------------------

type Drew = { value: Value, rand: Rand }

/// One of `n` ways, by `rand`.
fn pick(rand: Rand, n: Int) -> { value: Int, rand: Rand } / {abort.raise} =
  match rand_below(rand, n) { Some(p) -> p, None -> { value: 0, rand: rand } }

/// An `Int` as likely at an edge of the type as away from one.
fn drawn_int(rand: Rand) -> { value: Int, rand: Rand } / {abort.raise} = {
  let way = pick(rand, 8);
  if way.value == 0 { { value: 0, rand: way.rand } }
  else if way.value == 1 { { value: 1, rand: way.rand } }
  else if way.value == 2 { { value: -1, rand: way.rand } }
  else if way.value == 3 { { value: 9223372036854775807, rand: way.rand } }
  else if way.value == 4 { { value: -9223372036854775807 - 1, rand: way.rand } }
  else if way.value == 5 {
    let small = pick(way.rand, 201);
    { value: small.value - 100, rand: small.rand }
  } else { rand_int(way.rand) }
}

fn chosen(rand: Rand, values: List<Value>) -> Drew / {abort.raise} = {
  let at = pick(rand, len(values));
  { value: match list_at(values, at.value) { Some(v) -> v, None -> VUnit }, rand: at.rand }
}

/// A width's bit pattern, which is a value of it whatever the bits are.
fn drawn_fixed(name: String, rand: Rand) -> Drew / {abort.raise} = {
  let w = if name == "U8" || name == "I8" { 8 }
  else if name == "U16" || name == "I16" { 16 }
  else if name == "U32" || name == "I32" { 32 }
  else if name == "U64" || name == "I64" { 64 }
  else { 128 };
  let mask = if w == 128 { ~0u128 } else { (1u128 << w) - 1u128 };
  let way = pick(rand, 4);
  if way.value == 0 { { value: VFixed(name, 0u128), rand: way.rand } }
  else if way.value == 1 { { value: VFixed(name, mask), rand: way.rand } } else {
    let bits = pick(way.rand, 4611686018427387904);
    { value: VFixed(name, u128_of_int(bits.value) & mask), rand: bits.rand }
  }
}

/// A value for each of `tys` in turn from one stream, or nothing where one of them has none.
fn drawn_all(
  tys: List<Ty>,
  decls: List<Decl>,
  rand: Rand,
  room: Int,
) -> Option<{ values: List<Value>, rand: Rand }> / {abort.raise} =
  fold(
    tys,
    Some({ values: [], rand: rand }),
    |acc: Option<{ values: List<Value>, rand: Rand }>, ty: Ty|
      match acc {
        None -> None,
        Some(so_far) -> match drawn(ty, decls, so_far.rand, room) {
          Some(d) -> Some({ values: push(so_far.values, d.value), rand: d.rand }),
          None -> None,
        },
      },
  )

/// A value of `ty` from `rand`, or nothing for a type nothing here makes one of: a function, or a
/// declared type none of whose variants is finished within `room`. A type variable is drawn as an
/// `Int`.
fn drawn(ty: Ty, decls: List<Decl>, rand: Rand, room: Int) -> Option<Drew> / {abort.raise} =
  match ty {
    Var(_) -> {
      let n = drawn_int(rand);
      Some({ value: VInt(n.value), rand: n.rand })
    },
    Fn(_, _, _) -> None,
    Record(fields) -> match drawn_all(
        map(fields, |f: { name: String, ty: Ty }| f.ty),
        decls,
        rand,
        room,
      ) {
      None -> None,
      Some(made) -> {
        let named = map(range(0, len(fields)), |i: Int|
          {
            name: match list_at(fields, i) { Some(f) -> f.name, None -> "" },
            value: match list_at(made.values, i) { Some(v) -> v, None -> VUnit },
          });
        Some({
          value: VRecord(
            fold(name_order(map(named, |f: Field| f.name)), [], |acc: List<Field>, i: Int|
              match list_at(named, i) { Some(f) -> push(acc, f), None -> acc }),
          ),
          rand: made.rand,
        })
      },
    },
    Con(name, args) -> if name == "Unit" { Some({ value: VUnit, rand: rand }) }
    else if name == "Bool" {
      let b = pick(rand, 2);
      Some({ value: VBool(b.value == 1), rand: b.rand })
    } else if name == "Int" {
      let n = drawn_int(rand);
      Some({ value: VInt(n.value), rand: n.rand })
    } else if name == "String" {
      Some(chosen(rand, [VStr(""), VStr("a"), VStr("b"), VStr("ab"), VStr("A b"), VStr("é")]))
    } else if name == "Bytes" {
      let n = pick(rand, 5);
      let made = rand_bytes(n.rand, n.value);
      Some({ value: VBytes(made.bytes), rand: made.rand })
    } else if name == "Float" {
      Some(
        chosen(rand, [
          VFloat(0.0),
          VFloat(1.0),
          VFloat(-1.0),
          VFloat(0.5),
          VFloat(1.0e300),
          VFloat(0.0 / 0.0),
          VFloat(1.0 / 0.0),
        ]),
      )
    } else if name == "Decimal" {
      Some(
        chosen(rand, [VDecimal(0m), VDecimal(1m), VDecimal(-1m), VDecimal(0.5m), VDecimal(1.50m)]),
      )
    } else if name == "Char" {
      Some(chosen(rand, [VChar('a'), VChar('b'), VChar('Z'), VChar('0')]))
    } else if name == "List" || name == "Array" {
      let n = pick(rand, 4);
      match list_at(args, 0) {
        None -> None,
        Some(of) -> match fold(
            range(0, n.value),
            Some({ values: [], rand: n.rand }),
            |acc: Option<{ values: List<Value>, rand: Rand }>, _i: Int|
              match acc {
                None -> None,
                Some(so_far) -> match drawn(of, decls, so_far.rand, room) {
                  Some(d) -> Some({ values: push(so_far.values, d.value), rand: d.rand }),
                  None -> None,
                },
              },
          ) {
          None -> None,
          Some(made) ->
            Some({
              value: if name == "List" { VList(made.values) } else { VArray(made.values) },
              rand: made.rand,
            }),
        },
      }
    } else if name == "Map" {
      let n = pick(rand, 3);
      match ((list_at(args, 0), list_at(args, 1))) {
        (Some(k), Some(v)) -> match fold(
            range(0, n.value),
            Some({ entries: [], rand: n.rand }),
            |acc: Option<{ entries: List<{ key: Value, value: Value }>, rand: Rand }>, _i: Int|
              match acc {
                None -> None,
                Some(so_far) -> match drawn(k, decls, so_far.rand, room) {
                  None -> None,
                  Some(key) -> match drawn(v, decls, key.rand, room) {
                    None -> None,
                    Some(value) ->
                      Some({
                        entries: push(so_far.entries, { key: key.value, value: value.value }),
                        rand: value.rand,
                      }),
                  },
                },
              },
          ) {
          None -> None,
          Some(made) -> Some({ value: map_of(made.entries), rand: made.rand }),
        },
        _ -> None,
      }
    } else {
      match find_decl(decls, name) {
        None -> if fold(
            ["U8", "U16", "U32", "U64", "U128", "I8", "I16", "I32", "I64", "I128"],
            false,
            |hit: Bool, n: String| hit || n == name,
          ) { Some(drawn_fixed(name, rand)) }
        else { None },
        Some(decl) -> if room <= 0 {
          // Out of room, only a variant that holds nothing ends the value.
          let bare = filter(decl.variants, |v: Variant| len(v.fields) == 0);
          let at = pick(rand, max(len(bare), 1));
          match list_at(bare, at.value) {
            Some(v) -> Some({ value: VCtor(v.name, []), rand: at.rand }),
            None -> None,
          }
        } else {
          let at = pick(rand, max(len(decl.variants), 1));
          match list_at(decl.variants, at.value) {
            None -> None,
            Some(v) -> match drawn_all(
                map(v.fields, |f: Ty| substituted(f, args)),
                decls,
                at.rand,
                room - 1,
              ) {
              Some(made) -> Some({ value: VCtor(v.name, made.values), rand: made.rand }),
              None -> None,
            },
          }
        },
      }
    },
  }

/// The point a draw at `root` and `case` makes for `obligation`'s binders, from a stream of its
/// own: nothing where a binder's type has no value made here, or holds one only its module builds.
fn drawn_point(
  obligation: Obligation,
  decls: List<Decl>,
  root: Int,
  case: Int,
) -> Option<List<Value>> / {abort.raise} =
  if fold(obligation.binders, false, |any: Bool, b: Binder| any || !b.made) { None } else {
    let stream = rand_keyed(
      root,
      bytes_concat(bytes_of_hex(obligation.key), bytes_of_string(int_to_string(case))),
    );
    match drawn_all(map(obligation.binders, |b: Binder| b.ty), decls, stream, 3) {
      Some(made) -> Some(made.values),
      None -> None,
    }
  }

/// What re-drawing one proof came to: the draws made, and the first that contradicted it.
type Drawn = { draws: Int, how: Option<String> }

/// Every case from every root, each drawn afresh, judged until one contradicts the proof. A point
/// nothing here makes says nothing, and is still a draw.
fn redrawn_proof(
  index: Int,
  obligation: Obligation,
  decls: List<Decl>,
  cases: Int,
  roots: Int,
) -> Drawn / {prover.judged[claims], abort.raise} = {
  let all = fold(range(0, roots), [], |acc: List<{ root: Int, case: Int }>, root: Int|
    fold(range(0, cases), acc, |a: List<{ root: Int, case: Int }>, case: Int|
      push(a, { root: root, case: case })));
  let made = fold(
    range(0, len(all)),
    { points: [], at: [] },
    |acc: { points: List<List<Value>>, at: List<Int> }, k: Int|
      match list_at(all, k) {
        None -> acc,
        Some(p) -> match drawn_point(obligation, decls, p.root, p.case) {
          Some(values) -> { points: push(acc.points, values), at: push(acc.at, k) },
          None -> acc,
        },
      },
  );
  let js = match list_at(
      prover.judged[claims]([{ claim: index, points: made.points, mode: MWhole }]),
      0,
    ) {
    Some(x) -> x,
    None -> [],
  };
  let found = fold(range(0, len(js)), None, |acc: Option<{ k: Int, how: String }>, i: Int|
    match acc {
      Some(_) -> acc,
      None -> match ((list_at(js, i), list_at(made.points, i), list_at(made.at, i))) {
        (Some(j), Some(values), Some(k)) -> match contradiction(j, bindings(obligation, values)) {
          Some(how) -> match list_at(all, k) {
            Some(p) ->
              Some({
                k: k,
                how: how ++ " (root " ++ int_to_string(p.root) ++ ", case " ++ int_to_string(p.case)
                  ++ ")",
              }),
            None -> None,
          },
          None -> None,
        },
        _ -> None,
      },
    });
  match found {
    Some(f) -> { draws: f.k + 1, how: Some(f.how) },
    None -> { draws: len(all), how: None },
  }
}

/// One corpus, discharged as `ply prove --no-cache` decides it, and re-drawn. Its configuration
/// begins a run of its own, so corpora are audited one after another.
pub fn audited(
  dir: String,
  cases: Int,
  roots: Int,
) -> Result<Audit, String> / {fs.read[work], fs.read[repo], time.elapsed_us, prover.configure[claims], prover.collected[claims], prover.prepared[claims], prover.judged[claims], prover.interleaved[claims], prover.ended[claims], time.elapsed_ms, prover.compiled[claims], emit.unit, emit.compiled, abort.raise, shipped.names, shipped.module, shipped.reached} =
  match harness::project(dir) {
    Err(why) -> Err(why),
    Ok(sources) -> match harness::fronted(sources) {
      Err(why) -> Err("`" ++ dir ++ "` does not check: " ++ why),
      Ok(f) -> {
        // Only the directory's own package is answered for, as `ply prove` answers.
        let owned = owned_of(view_of(f.whole).frame, false);
        let built: Built = world_of(f.whole, owned);
        prover.configure[claims](options_for(dir), f.front, built.world);
        match prover.collected[claims]() {
          Err(_) -> Err("the prover would not collect the obligations of `" ++ dir ++ "`"),
          Ok(got) -> {
            let c = claims::collection_of(
              got,
              claims::own_claims(f.whole, built),
              options_for(dir),
            );
            let all = range(0, len(c.claims));
            let discharge = |runs: List<Int>, settled: List<Static>|
              claims::discharged_over(f.front, c, runs, settled);
            let decided = handle {
              claims::decided(
                c,
                all,
                false,
                claims::statics_of(f.whole, built.world, owned),
                false,
                discharge,
              )
            } with {
              proofs.cached(keys) -> map(keys, |k: String| None),
              proofs.record(entries) -> [],
            };
            match decided {
              Err(_) -> Err("the prover would not discharge the obligations of `" ++ dir ++ "`"),
              Ok(v) -> {
                let proofs = filter(all, |i: Int|
                  match list_at(v.outcomes, i) { Some(o) -> is_proved(o), None -> false });
                let redrawn = fold(
                  proofs,
                  Ok({ draws: 0, defects: [] }),
                  |acc: Result<{ draws: Int, defects: List<Defect> }, String>, i: Int|
                    match acc {
                      Err(e) -> Err(e),
                      Ok(so_far) -> match list_at(built.world.obligations, i) {
                        None -> Err("the world holds no obligation " ++ int_to_string(i)),
                        Some(o) -> {
                          let d = redrawn_proof(i, o, built.world.decls, cases, roots);
                          Ok({
                            draws: so_far.draws + d.draws,
                            defects: match d.how {
                              None -> so_far.defects,
                              Some(how) ->
                                push(so_far.defects, {
                                  claim: match list_at(c.claims, i) {
                                    Some(claim) -> claims::label_of(claim),
                                    None -> int_to_string(i),
                                  },
                                  how: how,
                                }),
                            },
                          })
                        },
                      },
                    },
                );
                match redrawn {
                  Err(e) -> Err(e),
                  Ok(r) ->
                    Ok({
                      obligations: len(c.claims),
                      proved: len(proofs),
                      draws: r.draws,
                      defects: r.defects,
                    }),
                }
              },
            }
          },
        }
      },
    },
  }

// --- The rows ---------------------------------------------------------------------------

fn carried(owed: Int) -> Criterion =
  holding(
    "no draw contradicts a proof, and at least " ++ int_to_string(owed)
      ++ " proofs are drawn from, a seed's share of "
      ++ int_to_string(least_audited()),
    ["disagreements", "proved"],
    |vs: List<Decimal>|
      match vs {
        [disagreements, proved] -> disagreements == 0m && proved >= decimal_of_int(owed),
        _ -> false,
      },
  )

pub fn audit_row(name: String, owed: Int, audit: Result<Audit, String>) -> Row =
  match audit {
    Err(why) -> untaken(name, carried(owed), why),
    Ok(a) ->
      {
        ..row(name, carried(owed), [number("obligations", a.obligations, "obligations"), number("proved", a.proved, "obligations"), number("draws", a.draws, "draws"), number("disagreements", len(a.defects), "obligations")]),
        detail: array(
          map(a.defects, |d: Defect|
            object([{ key: "claim", value: Str(d.claim) }, { key: "how", value: Str(d.how) }])),
        ),
      },
  }

/// `seed`, when given, is the one of `seeds` to audit alone.
pub type Args = { out: String, seeds: Int, seed: Option<Int>, cases: Int, roots: Int }

pub fn taken(seeds: Int, seed: Option<Int>) -> Result<List<Int>, String> =
  match seed {
    None -> Ok(range(1, seeds + 1)),
    Some(one) -> if one >= 1 && one <= seeds { Ok([one]) }
    else { Err("the audit takes seeds 1 to " ++ int_to_string(seeds)) },
  }

fn title_of(args: Args) -> String =
  "every proof re-drawn at " ++ int_to_string(args.cases) ++ " cases from each of "
    ++ int_to_string(args.roots)
    ++ " roots, over "
    ++ (match args.seed {
      Some(one) -> "seed " ++ int_to_string(one) ++ " of " ++ int_to_string(args.seeds),
      None -> "all " ++ int_to_string(args.seeds) ++ " seeds",
    })

/// Each seed taken has its corpus generated under `out` and audited, in order, and is judged by its
/// share of the floor. A corpus that would not generate is a row that says why; a prover that refused
/// stops the audit.
pub fn run(
  args: Args,
) -> Result<report::Report, String> / {fs.read[work], fs.write[work], fs.read[repo], time.elapsed_us, process.spawn[ply], config.get[env], prover.configure[claims], prover.collected[claims], prover.prepared[claims], prover.judged[claims], prover.interleaved[claims], prover.ended[claims], time.elapsed_ms, prover.compiled[claims], emit.unit, emit.compiled, abort.raise, diverges, shipped.names, shipped.module, shipped.reached} =
  match taken(args.seeds, args.seed) {
    Err(why) -> Err(why),
    Ok(chosen) -> match fold(
        chosen,
        Ok([]),
        |acc: Result<List<{ seed: Int, audit: Result<Audit, String> }>, String>, seed: Int|
          match acc {
            Err(e) -> Err(e),
            Ok(done) -> {
              let dir = under(args.out, "seed" ++ int_to_string(seed));
              match gen::run(dir, spec_for(seed), false) {
                Err(why) ->
                  Ok(
                    push(done, { seed: seed, audit: Err("the corpus did not generate: " ++ why) }),
                  ),
                Ok(_) -> match audited(dir, args.cases, args.roots) {
                  Err(why) -> Err("seed " ++ int_to_string(seed) ++ ": " ++ why),
                  Ok(audit) -> Ok(push(done, { seed: seed, audit: Ok(audit) })),
                },
              }
            },
          },
      ) {
      Err(why) -> Err(why),
      Ok(results) ->
        report::made(
          "tiers",
          title_of(args),
          map(results, |r: { seed: Int, audit: Result<Audit, String> }|
            audit_row("seed " ++ int_to_string(r.seed), share(args.seeds), r.audit)),
          [
            { key: "cases", value: Number(decimal_of_int(args.cases)) },
            { key: "roots", value: Number(decimal_of_int(args.roots)) },
            { key: "seeds", value: Number(decimal_of_int(args.seeds)) },
          ],
        ),
    },
  }

// --- Tests -------------------------------------------------------------------------------

test "a draw contradicts a proof by refuting it, raising under it or Ply failing on it, and no other way" {
  let b: Binding = { name: "n", ty: "Int", value: VInt(3) };
  assert_eq(contradiction(JFailed, [b]), Some("refutes it at n = 3"));
  assert_eq(
    contradiction(JRaised({ message: "division by zero", values: [] }), [b]),
    Some("raises `division by zero` at n = 3"),
  );
  assert_eq(
    contradiction(
      JFaulted({
        code: "E0505",
        message: "the C backend declined to enter `m.law`",
        notes: [],
        values: [],
      }),
      [b],
    ),
    Some(
      "Ply failed rather than the program, so this is a defect in Ply: the C backend declined to enter `m.law`, at n = 3",
    ),
  );
  assert_eq(contradiction(JHeld, [b]), None);
  assert_eq(contradiction(JRejected, [b]), None)
}

fn int() -> Ty = Con("Int", [])

fn a_claim(tys: List<Ty>, made: Bool) -> Obligation =
  {
    key: "00",
    run_key: "00",
    owner: "m.f",
    kind: Law(None),
    at: { module: 0, start: 0, end: 0 },
    binders: map(tys, |ty: Ty| { name: "x", ty: ty, text: "", made: made }),
    result: None,
    variables: [],
    guards: [],
    literals: [],
    footprint: None,
    frame: Pure,
    strategy: Bounded,
  }

test "a point is a function of its root and case, and differs between them" {
  let o = a_claim([int(), Con("List", [Con("Bool", [])]), Con("String", [])], true);
  assert_eq(drawn_point(o, [], 3, 7), drawn_point(o, [], 3, 7));
  let points = fold(range(0, 40), [], |acc: List<Option<List<Value>>>, case: Int|
    push(acc, drawn_point(o, [], 1, case)));
  let first = match list_at(points, 0) { Some(p) -> p, None -> None };
  assert(first != None && len(filter(points, |p: Option<List<Value>>| p != first)) > 0)
}

test "a binder no value is made of here leaves no point: a function, and a type its module alone builds" {
  assert_eq(drawn_point(a_claim([int(), Fn([int()], int(), true)], true), [], 1, 1), None);
  assert_eq(drawn_point(a_claim([int()], false), [], 1, 1), None);
  assert_eq(drawn_point(a_claim([Con("m.Unknown", [])], true), [], 1, 1), None)
}

test "a seed's row fails on one disagreement, and on a corpus short of its share of proofs" {
  let clean: Audit = { obligations: 40, proved: 17, draws: 136000, defects: [] };
  let broken = { ..clean, defects: [{ claim: "law \"x\"", how: "refutes it at n = 3" }] };
  assert_eq(verdicts([audit_row("seed 1", 17, Ok(clean))]), [report::Pass]);
  assert(verdicts([audit_row("seed 1", 17, Ok(broken))]) != [report::Pass]);
  assert_eq(verdicts([audit_row("seed 1", 17, Ok({ ..clean, proved: 16 }))]), [
    report::Fail([number("disagreements", 0, "obligations"), number("proved", 16, "obligations")]),
  ]);
  assert(verdicts([audit_row("seed 1", 17, Err("did not generate"))]) != [report::Pass])
}

test "every seed carrying its share meets the floor, and no share is more than that needs" {
  assert(
    fold(range(1, 2 * least_audited()), true, |held: Bool, seeds: Int|
      held && share(seeds) * seeds >= least_audited()
        && (share(seeds) - 1) * seeds < least_audited()),
  )
}

test "a run audits every seed, or the one asked for when it is among them" {
  assert_eq(taken(6, None), Ok([1, 2, 3, 4, 5, 6]));
  assert_eq(taken(6, Some(6)), Ok([6]));
  assert_eq(taken(6, Some(7)), Err("the audit takes seeds 1 to 6"));
  assert_eq(taken(6, Some(0)), Err("the audit takes seeds 1 to 6"))
}

test "a seed audited alone is named as one of the seeds" {
  let a: Args = { out: "t", seeds: 6, seed: Some(3), cases: 1000, roots: 8 };
  assert(string_ends_with(title_of(a), "over seed 3 of 6"));
  assert(string_ends_with(title_of({ ..a, seed: None }), "over all 6 seeds"))
}

test "the audited corpora are the generator's, specified" {
  let s = spec_for(3);
  assert_eq(s.seed, 3);
  assert_eq(gen::validate(s), Ok(s));
  assert(s.spec_fraction > 0.0 && s.specimens_per_module > 0)
}
