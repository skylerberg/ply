// --- What a line asks for ------------------------------------------------------

pub type GenArgs = { out: String, spec: gbuild::Spec, no_verify: Bool, json: Bool }

pub type BenchArgs = { corpus: String, repeats: Int, json: Bool }

pub type SweepArgs = { out: String, sizes: List<String>, seed: Int, repeats: Int, json: Bool }

pub type RealArgs = { tests: Bool, json: Bool }

pub type MeasureArgs = { corpus: String, repeats: Int, only_throughput: Bool, json: Bool }

// A subcommand whose arguments are its module's own, and whether its report is wanted as JSON.
pub type Reported<a> = { args: a, json: Bool }

// A line, answered: text for stdout (help, a version), a refusal for stderr, a subcommand this
// package runs, or the plan the executor runs.
pub type Asked =
  | Said(String)
  | Refusal(String)
  | Gen(GenArgs)
  | Bench(BenchArgs)
  | Sweep(SweepArgs)
  | Real(RealArgs)
  | Measure(MeasureArgs)
  | Payload(Reported<payload::Args>)
  | Regions(Reported<regions::Args>)
  | Tiers(Reported<tiers::Args>)
  | Plan(Json)

fn nat_of(p: cmdline::Parsed, long: String) -> Int =
  match cmdline::value(p, long) {
    Some(v) -> match cmdline::parse_nat(v) { Some(n) -> n, None -> 0 },
    None -> 0,
  }

fn float_of(p: cmdline::Parsed, long: String) -> Float =
  match cmdline::value(p, long) {
    Some(v) -> match decimal_of_string(v) { Some(d) -> float_of_decimal(d), None -> 0.0 },
    None -> 0.0,
  }

fn spec_of(p: cmdline::Parsed) -> gbuild::Spec =
  {
    seed: nat_of(p, "seed"),
    modules: nat_of(p, "modules"),
    defs_per_module: nat_of(p, "defs-per-module"),
    tests: nat_of(p, "tests"),
    depth: nat_of(p, "depth"),
    tables: nat_of(p, "tables"),
    regions: nat_of(p, "regions"),
    effect_fraction: float_of(p, "effect-fraction"),
    nondet_fraction: float_of(p, "nondet-fraction"),
    hub_modules: nat_of(p, "hub-modules"),
    max_weight: nat_of(p, "max-weight"),
    concurrent_tests: nat_of(p, "concurrent-tests"),
    tasks_per_test: nat_of(p, "tasks-per-test"),
    steps_per_task: nat_of(p, "steps-per-task"),
    conflict_density: float_of(p, "conflict-density"),
    spec_fraction: float_of(p, "spec-fraction"),
    specimens_per_module: nat_of(p, "specimens-per-module"),
  }

// A valued flag that must be written: the line is refused when it was not, the library's way.
fn required(p: cmdline::Parsed, long: String) -> Result<String, String> =
  match cmdline::value(p, long) {
    Some(v) -> Ok(v),
    None ->
      Err(
        cmdline::refused(
          spec(),
          p.path,
          "a value is required for '--" ++ long ++ "' but none was supplied",
        ),
      ),
  }

pub fn asked(argv: List<String>) -> Asked =
  match cmdline::parse(spec(), argv) {
    cmdline::Help(text) -> Said(text),
    cmdline::Version(text) -> Said(text),
    cmdline::Refused(text) -> Refusal(text),
    cmdline::Run(p) -> match cmdline::nth_of(p.path, 0, "") {
      "gen" -> match required(p, "out") {
        Err(why) -> Refusal(why),
        Ok(out) ->
          Gen({
            out: out,
            spec: spec_of(p),
            no_verify: cmdline::has(p, "no-verify"),
            json: cmdline::has(p, "json"),
          }),
      },
      "bench" ->
        Bench({
          corpus: cmdline::nth_of(p.positionals, 0, ""),
          repeats: nat_of(p, "repeats"),
          json: cmdline::has(p, "json"),
        }),
      "sweep" -> match required(p, "out") {
        Err(why) -> Refusal(why),
        Ok(out) ->
          Sweep({
            out: out,
            sizes: cmdline::values_of(p, "sizes"),
            seed: nat_of(p, "seed"),
            repeats: nat_of(p, "repeats"),
            json: cmdline::has(p, "json"),
          }),
      },
      "real" -> Real({ tests: !cmdline::has(p, "no-tests"), json: cmdline::has(p, "json") }),
      "measure" ->
        Measure({
          corpus: cmdline::nth_of(p.positionals, 0, ""),
          repeats: nat_of(p, "repeats"),
          only_throughput: cmdline::has(p, "only-throughput"),
          json: cmdline::has(p, "json"),
        }),
      "payload" -> match shapes_of(p) {
        Err(why) -> Refusal(why),
        Ok(shapes) ->
          Payload({
            args: {
              lines: nats_of(p, "lines"),
              iterations: nat_of(p, "iterations"),
              shapes: shapes,
              entries: nats_of(p, "entries"),
              types: nats_of(p, "types"),
              types_per_module: nat_of(p, "types-per-module"),
              processes: nat_of(p, "processes"),
              repeats: nat_of(p, "repeats"),
              derivation: !cmdline::has(p, "no-derivation"),
            },
            json: cmdline::has(p, "json"),
          }),
      },
      "regions" ->
        Regions({
          args: {
            roots: filter(p.positionals, |r: String| r != ""),
            jobs: nat_of(p, "jobs"),
            hypothetical: cmdline::values_of(p, "hypothetical"),
            hypothetical_shared: nat_of(p, "hypothetical-shared"),
            hypothetical_pure: nat_of(p, "hypothetical-pure"),
            std: cmdline::has(p, "std"),
          },
          json: cmdline::has(p, "json"),
        }),
      "tiers" -> match required(p, "out") {
        Err(why) -> Refusal(why),
        Ok(out) ->
          Tiers({
            args: {
              out: out,
              seeds: nat_of(p, "seeds"),
              cases: nat_of(p, "cases"),
              roots: nat_of(p, "roots"),
            },
            json: cmdline::has(p, "json"),
          }),
      },
      _ -> match run_plan(p) { Ok(j) -> Plan(j), Err(why) -> Refusal(why) },
    },
  }

// A comma list the spec already checked entry by entry, as the numbers it holds.
fn nats_of(p: cmdline::Parsed, long: String) -> List<Int> =
  match cmdline::value(p, long) {
    None -> [],
    Some(v) ->
      fold(split_commas(v), [], |acc: List<Int>, s: String|
        match cmdline::parse_nat(s) { Some(n) -> push(acc, n), None -> acc }),
  }

fn shapes_of(p: cmdline::Parsed) -> Result<List<payload::Shape>, String> =
  match cmdline::value(p, "shape") {
    None -> Ok([]),
    Some(v) ->
      fold(split_commas(v), Ok([]), |acc: Result<List<payload::Shape>, String>, text: String|
        match acc {
          Err(e) -> Err(e),
          Ok(done) -> match payload::shape_of(text) {
            Err(e) -> Err(e),
            Ok(s) -> Ok(push(done, s)),
          },
        }),
  }

// --- The plan the executor runs ------------------------------------------------

fn str_flag(p: cmdline::Parsed, long: String) -> Json =
  match cmdline::value(p, long) { Some(v) -> Str(v), None -> Null }

fn int_flag(p: cmdline::Parsed, long: String) -> Json =
  match cmdline::value(p, long) {
    Some(v) -> match cmdline::parse_nat(v) { Some(n) -> Number(decimal_of_int(n)), None -> Null },
    None -> Null,
  }

fn bool_flag(p: cmdline::Parsed, long: String) -> Json = Bool(cmdline::has(p, long))

fn nats_json(text: String) -> Json =
  array(
    map(split_commas(text), |s: String|
      match cmdline::parse_nat(s) { Some(n) -> Number(decimal_of_int(n)), None -> Null }),
  )

fn list_flag(p: cmdline::Parsed, long: String) -> Json =
  match cmdline::value(p, long) { Some(v) -> nats_json(v), None -> array([]) }

fn positionals_json(p: cmdline::Parsed) -> Json = array(map(p.positionals, |s: String| Str(s)))

fn serve_args(p: cmdline::Parsed) -> List<{ key: String, value: Json }> =
  [
    { key: "repo", value: str_flag(p, "repo") },
    { key: "ply", value: str_flag(p, "ply") },
    { key: "requests", value: int_flag(p, "requests") },
    { key: "repeats", value: int_flag(p, "repeats") },
    { key: "json", value: bool_flag(p, "json") },
  ]

fn plan(command: String, args: List<{ key: String, value: Json }>) -> Json =
  object([
    { key: "outcome", value: Str("run") },
    { key: "command", value: Str(command) },
    { key: "args", value: object(args) },
  ])

// Every knob of a subcommand the executor runs, materialized: defaults filled, numbers parsed and
// comma lists split, so the executor only decodes.
fn run_plan(p: cmdline::Parsed) -> Result<Json, String> =
  match cmdline::nth_of(p.path, 0, "") {
    "sim" ->
      Ok(
        plan("sim", [
          { key: "corpus", value: Str(cmdline::nth_of(p.positionals, 0, "")) },
          { key: "trials", value: int_flag(p, "trials") },
          { key: "budget", value: int_flag(p, "budget") },
          { key: "steps", value: int_flag(p, "steps") },
          { key: "rate_seeds", value: int_flag(p, "rate-seeds") },
          { key: "no_reduction", value: bool_flag(p, "no-reduction") },
          { key: "json", value: bool_flag(p, "json") },
        ]),
      ),
    "prove" ->
      Ok(
        plan("prove", [
          { key: "projects", value: positionals_json(p) },
          { key: "cases", value: int_flag(p, "cases") },
          { key: "prove_budget", value: int_flag(p, "prove-budget") },
          { key: "json", value: bool_flag(p, "json") },
        ]),
      ),
    "serve" ->
      Ok(
        plan(
          "serve",
          cats([
            serve_args(p),
            [
              { key: "ladder_requests", value: int_flag(p, "ladder-requests") },
              { key: "concurrency", value: list_flag(p, "concurrency") },
              { key: "load_headers", value: list_flag(p, "load-headers") },
              { key: "no_ladder", value: bool_flag(p, "no-ladder") },
              { key: "no_load", value: bool_flag(p, "no-load") },
              { key: "baseline", value: bool_flag(p, "baseline") },
            ],
          ]),
        ),
      ),
    "w3" ->
      Ok(
        plan(
          "w3",
          cats([
            serve_args(p),
            [
              { key: "per_conn", value: int_flag(p, "per-conn") },
              { key: "requests_per_point", value: int_flag(p, "requests-per-point") },
              { key: "ladder_requests", value: int_flag(p, "ladder-requests") },
              { key: "ladder_concurrency", value: int_flag(p, "ladder-concurrency") },
              { key: "concurrency", value: list_flag(p, "concurrency") },
              { key: "concurrent", value: bool_flag(p, "concurrent") },
              { key: "w2_baseline", value: bool_flag(p, "w2-baseline") },
              { key: "no_load", value: bool_flag(p, "no-load") },
              { key: "no_shape", value: bool_flag(p, "no-shape") },
              { key: "no_tls", value: bool_flag(p, "no-tls") },
            ],
          ]),
        ),
      ),
    "w4" -> match required(p, "db") {
      Err(why) -> Err(why),
      Ok(_) ->
        Ok(
          plan("w4", [
            { key: "repo", value: str_flag(p, "repo") },
            { key: "db", value: str_flag(p, "db") },
            { key: "ply", value: str_flag(p, "ply") },
            { key: "concurrency", value: list_flag(p, "concurrency") },
            { key: "operations", value: int_flag(p, "operations") },
            { key: "rows", value: list_flag(p, "rows") },
            { key: "pool_sizes", value: list_flag(p, "pool-sizes") },
            { key: "pool", value: int_flag(p, "pool") },
            { key: "repeats", value: int_flag(p, "repeats") },
            { key: "load_concurrency", value: list_flag(p, "load-concurrency") },
            { key: "per_conn", value: int_flag(p, "per-conn") },
            { key: "requests_per_point", value: int_flag(p, "requests-per-point") },
            { key: "no_ops", value: bool_flag(p, "no-ops") },
            { key: "no_sizes", value: bool_flag(p, "no-sizes") },
            { key: "no_pool", value: bool_flag(p, "no-pool") },
            { key: "no_load", value: bool_flag(p, "no-load") },
            { key: "json", value: bool_flag(p, "json") },
          ]),
        ),
    },
    "w5" ->
      Ok(
        plan("w5", [
          { key: "repo", value: str_flag(p, "repo") },
          { key: "ply", value: str_flag(p, "ply") },
          { key: "db", value: str_flag(p, "db") },
          { key: "operations", value: int_flag(p, "operations") },
          { key: "twin_operations", value: int_flag(p, "twin-operations") },
          { key: "repeats", value: int_flag(p, "repeats") },
          { key: "concurrency", value: list_flag(p, "concurrency") },
          { key: "per_conn", value: int_flag(p, "per-conn") },
          { key: "requests_per_point", value: int_flag(p, "requests-per-point") },
          { key: "in_flight", value: list_flag(p, "in-flight") },
          { key: "drain_ms", value: int_flag(p, "drain-ms") },
          { key: "hold_ms", value: int_flag(p, "hold-ms") },
          { key: "api_key", value: str_flag(p, "api-key") },
          { key: "concurrent", value: bool_flag(p, "concurrent") },
          { key: "no_events", value: bool_flag(p, "no-events") },
          { key: "no_served", value: bool_flag(p, "no-served") },
          { key: "no_drain", value: bool_flag(p, "no-drain") },
          { key: "no_transaction", value: bool_flag(p, "no-transaction") },
          { key: "no_deploy", value: bool_flag(p, "no-deploy") },
          { key: "json", value: bool_flag(p, "json") },
        ]),
      ),
    "w6" ->
      Ok(
        plan("w6", [
          { key: "reports", value: positionals_json(p) },
          { key: "strict", value: bool_flag(p, "strict") },
          { key: "json", value: bool_flag(p, "json") },
        ]),
      ),
    "w6-ladder" -> match required(p, "db") {
      Err(why) -> Err(why),
      Ok(_) ->
        Ok(
          plan("w6-ladder", [
            { key: "repo", value: str_flag(p, "repo") },
            { key: "ply", value: str_flag(p, "ply") },
            { key: "db", value: str_flag(p, "db") },
            { key: "requests", value: int_flag(p, "requests") },
            { key: "iterations", value: int_flag(p, "iterations") },
            { key: "repeats", value: int_flag(p, "repeats") },
            { key: "concurrency", value: list_flag(p, "concurrency") },
            { key: "per_conn", value: int_flag(p, "per-conn") },
            { key: "requests_per_point", value: int_flag(p, "requests-per-point") },
            { key: "api_key", value: str_flag(p, "api-key") },
            { key: "machine", value: str_flag(p, "machine") },
            { key: "postgres", value: str_flag(p, "postgres") },
            { key: "no_served", value: bool_flag(p, "no-served") },
            { key: "only", value: str_flag(p, "only") },
            { key: "rounds", value: int_flag(p, "rounds") },
            { key: "accept", value: str_flag(p, "accept") },
            { key: "other_repeats", value: int_flag(p, "other-repeats") },
            { key: "served_repeats", value: int_flag(p, "served-repeats") },
            { key: "no_levers", value: bool_flag(p, "no-levers") },
            { key: "out", value: str_flag(p, "out") },
            { key: "detail", value: str_flag(p, "detail") },
            { key: "write_control", value: str_flag(p, "write-control") },
          ]),
        ),
    },
    other -> Err(cmdline::refused(spec(), p.path, "no command named " ++ other)),
  }

// --- Running what was asked ------------------------------------------------------

// A text as the stream carries it: `out` and `err` end each write with a newline, so one the text
// already ends with is not written twice.
fn chomped(text: String) -> String =
  if string_ends_with(text, "\n") { string_slice(text, 0, string_len(text) - 1) } else { text }

fn say(text: String) -> Unit / {process.out[proc]} =
  if text == "" { () } else { process.out[proc](chomped(text)) }

fn complain(text: String) -> Unit / {process.err[proc]} =
  if text == "" { () } else { process.err[proc](chomped(text)) }

// A subcommand's answer: what it printed and exit 0, or why it could not and exit 1.
fn answered(outcome: Result<String, String>) -> Int / {process.out[proc], process.err[proc]} =
  match outcome {
    Ok(text) -> {
      say(text);
      0
    },
    Err(why) -> {
      complain("ply-corpus: " ++ why);
      1
    },
  }

// A subcommand's report, as the line asked for it.
fn reported(outcome: Result<report::Report, String>, json_wanted: Bool) -> Result<String, String> =
  match outcome {
    Err(why) -> Err(why),
    Ok(r) ->
      Ok(if json_wanted { json::to_string(report::to_json(r)) } else { report::rendered(r) }),
  }

// The executor runs the plan with the few variables the toolchain reads, in the working directory,
// and what it wrote and the code it exited with are this program's.
fn executed(
  plan: Json,
) -> Int / {process.spawn[executor], config.get[env], process.out[proc], process.err[proc]} = {
  let done = process.spawn[executor](["--plan", json::to_string(plan)], "", spine::inherited_env());
  say(string_of_bytes_lossy(done.out));
  complain(string_of_bytes_lossy(done.err));
  match exit_code(done) {
    Some(code) -> if code >= 0 && code <= 125 { code } else { 1 },
    None -> {
      complain("ply-corpus: the executor was stopped by a signal");
      1
    },
  }
}

fn code_of(
  a: Asked,
) -> Int / {process.out[proc], process.err[proc], process.spawn[ply], process.spawn[executor], config.get[env], time.elapsed_ms, time.elapsed_us, fs.read[work], fs.write[work], fs.read[repo], machine.configure[bench], machine.load[bench], machine.bound[bench], machine.call[bench], machine.accounting[bench], machine.drop[bench], prover.configure[claims], prover.collected[claims], prover.discharged[claims], prover.replay[claims]} =
  match a {
    Said(text) -> {
      process.out[proc](text);
      0
    },
    Refusal(text) -> {
      complain(text);
      2
    },
    Gen(g) ->
      answered(match gen::run(g.out, g.spec, g.no_verify) {
        Err(why) -> Err(why),
        Ok(made) ->
          Ok(if g.json { json::to_string(gen::report_json(made)) } else { gen::summary(made) }),
      }),
    Bench(b) -> answered(reported(bench::run(b.corpus, b.repeats), b.json)),
    Sweep(s) ->
      answered(match sweep::sizes_of(s.sizes, s.seed) {
        Err(why) -> Err(why),
        Ok(sizes) -> reported(sweep::run(s.out, sizes, s.repeats), s.json),
      }),
    Real(r) -> answered(reported(real::run(r.tests), r.json)),
    Measure(m) -> answered(reported(measure::run(m.corpus, m.repeats, m.only_throughput), m.json)),
    Payload(p) -> answered(reported(payload::run(p.args), p.json)),
    Regions(r) -> answered(reported(regions::run(r.args), r.json)),
    Tiers(t) -> answered(reported(tiers::run(t.args), t.json)),
    Plan(j) -> executed(j),
  }

pub fn main() -> Unit / {process.args[proc], process.out[proc], process.err[proc], process.exit[proc], process.spawn[ply], process.spawn[executor], config.get[env], time.elapsed_ms, time.elapsed_us, fs.read[work], fs.write[work], fs.read[repo], machine.configure[bench], machine.load[bench], machine.bound[bench], machine.call[bench], machine.accounting[bench], machine.drop[bench], prover.configure[claims], prover.collected[claims], prover.discharged[claims], prover.replay[claims]} =
  process.exit[proc](code_of(asked(process.args[proc]())))

// --- Tests -----------------------------------------------------------------------

fn plan_text(argv: List<String>) -> String =
  match asked(argv) { Plan(j) -> json::to_string(j), _ -> "" }

fn refusal_of(argv: List<String>) -> String = match asked(argv) { Refusal(text) -> text, _ -> "" }

test "a bare word is refused with the help in it" {
  assert(string_contains(refusal_of(["nonsense"]), "unrecognized subcommand"))
}

test "gen fills the shape's defaults, which are the generator's" {
  match asked(["gen", "--out", "gen-out"]) {
    Gen(g) -> {
      assert_eq(g.out, "gen-out");
      assert_eq(g.spec, gen::default_spec());
      assert(!g.no_verify);
      assert(!g.json)
    },
    _ -> assert(false),
  }
}

test "gen refuses without --out" { assert(string_contains(refusal_of(["gen"]), "--out")) }

test "a conflict density outside 0 to 1 is refused by the generator" {
  match asked(["gen", "--out", "c", "--conflict-density", "2"]) {
    Gen(g) ->
      assert(match gen::validate(g.spec) {
        Err(why) -> string_contains(why, "--conflict-density"),
        Ok(_) -> false,
      }),
    _ -> assert(false),
  }
}

test "a directory the corpus writes is under the working directory" {
  assert(string_contains(refusal_of(["gen", "--out", "/tmp/corpus"]), "is absolute"));
  assert(string_contains(refusal_of(["bench", "../corpus"]), "climbs out"));
  match asked(["bench", "corpora/m4", "--repeats", "1"]) {
    Bench(b) -> {
      assert_eq(b.corpus, "corpora/m4");
      assert_eq(b.repeats, 1)
    },
    _ -> assert(false),
  }
}

test "sweep reads its sizes and its seed" {
  match asked(["sweep", "--out", "s", "--sizes", "4,5,8", "--sizes", "6,5,8", "--seed", "3"]) {
    Sweep(s) -> {
      assert_eq(s.sizes, ["4,5,8", "6,5,8"]);
      assert_eq(s.seed, 3)
    },
    _ -> assert(false),
  }
}

test "real tests unless told not to" {
  match asked(["real"]) { Real(r) -> assert(r.tests && !r.json), _ -> assert(false) };
  match asked(["real", "--no-tests", "--json"]) {
    Real(r) -> assert(!r.tests && r.json),
    _ -> assert(false),
  }
}

test "w4 refuses without --db" { assert(string_contains(refusal_of(["w4"]), "--db")) }

test "w6-ladder reads a comma list of concurrencies" {
  assert(
    string_contains(
      plan_text(["w6-ladder", "--db", "pg://x", "--concurrency", "1,16,64"]),
      "\"concurrency\":[1,16,64]",
    ),
  )
}

test "payload reads its lists at their defaults, and its shape as `lines:pad` pairs" {
  match asked(["payload"]) {
    Payload(p) -> {
      assert_eq(p.args.lines, [1, 10, 40, 200, 1000]);
      assert_eq(p.args.shapes, [
        { lines: 40, pad: 0 },
        { lines: 40, pad: 100 },
        { lines: 40, pad: 400 },
        { lines: 40, pad: 1600 },
      ]);
      assert_eq(p.args.entries, [16, 256, 4096, 65536]);
      assert(p.args.derivation && !p.json)
    },
    _ -> assert(false),
  };
  assert(string_contains(refusal_of(["payload", "--shape", "40:0,40"]), "40 is not two numbers"))
}

test "a list entry that is not a number is refused rather than read as nothing" {
  assert(string_contains(refusal_of(["payload", "--lines", "1,x"]), "x is not a number"))
}

test "measure's corpus is optional, and one named is under the working directory" {
  match asked(["measure"]) {
    Measure(m) -> assert(m.corpus == "" && !m.only_throughput),
    _ -> assert(false),
  };
  match asked(["measure", "corpora/m4", "--only-throughput", "--repeats", "2"]) {
    Measure(m) -> assert(m.corpus == "corpora/m4" && m.only_throughput && m.repeats == 2),
    _ -> assert(false),
  };
  assert(string_contains(refusal_of(["measure", "/tmp/m4"]), "is absolute"))
}

test "regions reads its roots and its hypotheticals, and a root outside is refused" {
  match asked(["regions", "examples", "--hypothetical", "12:3", "--hypothetical", "40:4"]) {
    Regions(r) -> {
      assert_eq(r.args.roots, ["examples"]);
      assert_eq(r.args.hypothetical, ["12:3", "40:4"]);
      assert_eq((r.args.jobs, r.args.hypothetical_shared, r.args.hypothetical_pure), (8, 10, 165))
    },
    _ -> assert(false),
  };
  match asked(["regions", "--hypothetical", "12:3"]) {
    Regions(r) -> assert_eq(r.args.roots, []),
    _ -> assert(false),
  };
  assert(string_contains(refusal_of(["regions", "../elsewhere"]), "climbs out"))
}

test "tiers audits six seeds at a thousand cases from eight roots unless told otherwise" {
  match asked(["tiers", "--out", "tiers"]) {
    Tiers(t) ->
      assert_eq((t.args.out, t.args.seeds, t.args.cases, t.args.roots), ("tiers", 6, 1000, 8)),
    _ -> assert(false),
  };
  assert(string_contains(refusal_of(["tiers"]), "--out"))
}

test "what is still Rust's is planned for the executor" {
  assert(string_contains(plan_text(["prove", "a.ply", "--cases", "7"]), "\"cases\":7"));
  assert(string_contains(plan_text(["sim", "a.ply"]), "\"command\":\"sim\""));
  assert_eq(plan_text(["measure"]), "")
}

test "an unknown flag is a refusal, not a panic" {
  assert(refusal_of(["bench", "some-corpus", "--bogus"]) != "")
}

test "help is text for stdout, and names every subcommand" {
  match asked(["--help"]) {
    Said(text) -> {
      assert(string_contains(text, "w6-ladder"));
      assert(string_contains(text, "sweep"));
      assert(string_contains(text, "tiers"))
    },
    _ -> assert(false),
  }
}

test "a text the stream would end with a newline is not given a second" {
  assert_eq(chomped("a\nb\n"), "a\nb");
  assert_eq(chomped("a"), "a")
}
