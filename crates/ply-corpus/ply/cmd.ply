          ]),
        ),
        cmdline::command(
          "w4",
          "Price a statement through the effect boundary against one with no Ply in the path",
          cats([
            served_flags(),
            [
              sections_flag(w4::sections(), "ops,sizes,pool,exhaustion,crud"),
              db_flag(
                "Where the corpus makes its `part` table, and where `crud` finds the desk's schema; without it their rows are inconclusive",
              ),
              counts("concurrency", "1,2,4,8,16", "Concurrent tasks in the `ops` sweep"),
