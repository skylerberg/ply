            nats("concurrency", "1,2,4,8,16", "Concurrent tasks in the `ops` sweep"),
            nat("operations", 400, "Statements per point in the `ops` sweep"),
            nats("rows", "8,32,128,512", "Table sizes the `sizes` section sweeps, in rows"),
            nats("pool-sizes", "1,2,4,8,16", "Pool sizes the `pool` section sweeps"),
            nat("pool", 16, "Connections the `ops` sweep's pool holds, constant across its rows"),
            nat("repeats", 3, "Repeats per point; the fastest is reported"),
            nats("load-concurrency", "1,8,32", "Client concurrencies in the `crud` section"),
            nat("per-conn", 32, "Requests one connection carries in the load table"),
            nat("requests-per-point", 3000, "Requests per point in the load table"),
            sw("no-ops", "Drop the `ops` sweep"),
            sw("no-sizes", "Drop the `sizes` section"),
            sw("no-pool", "Drop the `pool` section"),
            sw("no-load", "Drop the `crud` load table"),
