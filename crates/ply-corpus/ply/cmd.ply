// The corpus's command line, declared once as a cmdline spec: argument parsing for the corpus
// binary is the CLI package's library, not a copy of it. `dispatch` turns argv into the JSON
// plan the binary reads; `main` makes the front door an ordinary runnable program.

import cli.cmdline
import std.json (Json, Str, Number, Bool, Null, object, array)
import std.process (process)
import std.json

fn cats<a>(xss: List<List<a>>) -> List<a> =
  fold(xss, [], |acc: List<a>, xs: List<a>| fold(xs, acc, |acc2: List<a>, x: a| push(acc2, x)))

// --- Flags, as the corpus writes them -----------------------------------------

fn sw(long: String, help: String) -> cmdline::Flag = cmdline::switch(long, help)

fn nat(long: String, default: Int, help: String) -> cmdline::Flag =
  cmdline::with_default(cmdline::valued(long, "N", cmdline::Nat, help), int_to_string(default))

fn text(long: String, default: String, help: String) -> cmdline::Flag =
  cmdline::with_default(cmdline::valued(long, "TEXT", cmdline::Text, help), default)

fn opt(long: String, help: String) -> cmdline::Flag =
  cmdline::valued(long, "TEXT", cmdline::Text, help)

fn nats(long: String, default: String, help: String) -> cmdline::Flag =
  cmdline::with_default(cmdline::valued(long, "N,N,…", cmdline::Text, help), default)

fn texts(long: String, help: String) -> cmdline::Flag =
  cmdline::repeated(cmdline::valued(long, "TEXT", cmdline::Text, help))

fn is_a_number(v: String) -> Result<Unit, String> =
  match decimal_of_string(v) { Some(_) -> Ok(()), None -> Err("not a number: " ++ v) }

fn float(long: String, default: String, help: String) -> cmdline::Flag =
  cmdline::checking(
    cmdline::with_default(cmdline::valued(long, "F", cmdline::Text, help), default),
    is_a_number,
  )

fn json_switch() -> cmdline::Flag = sw("json", "The measurements as JSON rather than a table")

// The knobs a generated corpus's shape takes; `gen` and the sizes half of `sweep` share them.
fn shape_flags() -> List<cmdline::Flag> =
  [
    nat("seed", 1, "The seed the corpus is a function of"),
    nat("modules", 20, "Modules in the generated corpus"),
    nat("defs-per-module", 25, "Definitions per module"),
    nat("tests", 200, "Tests in the generated corpus"),
    nat("depth", 4, "Import depth of the generated module graph"),
    nat("tables", 12, "Tables in the generated schema"),
    nat("regions", 6, "Regions in the generated effect map"),
    float("effect-fraction", "0.35", "Definitions that perform effects"),
    float("nondet-fraction", "0.03", "Definitions that perform nondeterministically"),
    nat("hub-modules", 3, "Modules everything else imports"),
    nat("max-weight", 192, "The largest one definition weighs"),
    nat("concurrent-tests", 0, "Tests that run tasks concurrently"),
    nat("tasks-per-test", 3, "Tasks each concurrent test spawns"),
    nat("steps-per-task", 2, "Steps each spawned task takes"),
    float("conflict-density", "0.5", "How often concurrent tasks contend"),
    float("spec-fraction", "0.0", "Definitions carrying a spec the prover reads"),
    nat("specimens-per-module", 0, "Specimen definitions per module"),
  ]

fn serve_flags() -> List<cmdline::Flag> =
  [
    text("repo", ".", "The repository root the fixtures are read from"),
    opt("ply", "The `ply` binary the load tables drive; this binary's sibling when left off"),
    nat("requests", 2000, "Requests per point"),
    nat("repeats", 3, "Repeats per point; the fastest is reported"),
    json_switch(),
  ]

// --- The spec --------------------------------------------------------------------

