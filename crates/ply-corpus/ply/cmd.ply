          "real",
          "The compiler and the CLI themselves, pinned by digest, front-ended and tested; run from the repository's root",
          [
            cmdline::valued(
              "member",
              "NAME",
              cmdline::Choice(real::names()),
              "The one member to take; every one when left off",
            ),
            sw("no-tests", "Front-end only; skip the test suites"),
            json_switch(),
          ],
        ),
      ],
    ),
  }

// --- What a line asks for ------------------------------------------------------

pub type GenArgs = { out: String, spec: gbuild::Spec, no_verify: Bool, json: Bool }

pub type BenchArgs = { corpus: String, repeats: Int, json: Bool }

pub type SweepArgs = { out: String, sizes: List<String>, seed: Int, repeats: Int, json: Bool }

pub type RealArgs = { tests: Bool, member: Option<String>, json: Bool }

pub type MeasureArgs = { corpus: String, repeats: Int, only_throughput: Bool, json: Bool }

// A subcommand whose arguments are its module's own, and whether its report is wanted as JSON.
pub type Reported<a> = { args: a, json: Bool }

// A line, answered: text for stdout (help, a version), a refusal for stderr, or a subcommand.
pub type Asked =
  | Said(String)
  | Refusal(String)
  | Gen(GenArgs)
  | Bench(BenchArgs)
  | Sweep(SweepArgs)
  | Real(RealArgs)
  | Measure(MeasureArgs)
  | Payload(Reported<payload::Args>)
  | Regions(Reported<regions::Args>)
  | Tiers(Reported<tiers::Args>)
  | Sim(Reported<search::Args>)
  | Prove(Reported<discharge::Args>)
  | Serve(Reported<serve::Args>)
  | W3(Reported<w3::Args>)
  | W4(Reported<w4::Args>)
  | W5(Reported<w5::Args>)
  // Whether the shipped ladder's judgement is wanted as JSON.
  | W6(Bool)
  | W6Ladder(Reported<ladder::Args>)

fn nat_of(p: cmdline::Parsed, long: String) -> Int =
  match cmdline::value(p, long) {
    Some(v) -> match cmdline::parse_nat(v) { Some(n) -> n, None -> 0 },
    None -> 0,
  }

fn text_of(p: cmdline::Parsed, long: String) -> String =
  match cmdline::value(p, long) { Some(v) -> v, None -> "" }

fn serve_args(p: cmdline::Parsed) -> serve::Args =
  {
    repo: text_of(p, "repo"),
    scratch: text_of(p, "scratch"),
    sections: split_commas(text_of(p, "sections")),
    requests: nat_of(p, "requests"),
    per_conn: nat_of(p, "per-conn"),
    concurrency: nats_of(p, "concurrency"),
    repeats: nat_of(p, "repeats"),
    iterations: nat_of(p, "iterations"),
  }

fn w3_args(p: cmdline::Parsed) -> w3::Args =
  {
    repo: text_of(p, "repo"),
    scratch: text_of(p, "scratch"),
    sections: split_commas(text_of(p, "sections")),
    accept: text_of(p, "accept"),
    concurrency: nats_of(p, "concurrency"),
    per_conn: nat_of(p, "per-conn"),
    requests_per_point: nat_of(p, "requests-per-point"),
    ladder_requests: nat_of(p, "ladder-requests"),
    ladder_concurrency: nat_of(p, "ladder-concurrency"),
    repeats: nat_of(p, "repeats"),
    iterations: nat_of(p, "iterations"),
  }

fn w4_args(p: cmdline::Parsed) -> w4::Args =
  {
    repo: text_of(p, "repo"),
    scratch: text_of(p, "scratch"),
    db: cmdline::value(p, "db"),
    sections: split_commas(text_of(p, "sections")),
    concurrency: nats_of(p, "concurrency"),
    operations: nat_of(p, "operations"),
    rows: nats_of(p, "rows"),
    pool_sizes: nats_of(p, "pool-sizes"),
    pool: nat_of(p, "pool"),
    load_concurrency: nats_of(p, "load-concurrency"),
    per_conn: nat_of(p, "per-conn"),
    requests_per_point: nat_of(p, "requests-per-point"),
    repeats: nat_of(p, "repeats"),
  }

fn w5_args(p: cmdline::Parsed) -> w5::Args =
  {
    repo: text_of(p, "repo"),
    scratch: text_of(p, "scratch"),
    db: cmdline::value(p, "db"),
    sections: split_commas(text_of(p, "sections")),
    accept: text_of(p, "accept"),
    concurrency: nats_of(p, "concurrency"),
    per_conn: nat_of(p, "per-conn"),
    requests_per_point: nat_of(p, "requests-per-point"),
    in_flight: nats_of(p, "in-flight"),
    drain_ms: nat_of(p, "drain-ms"),
    hold_ms: nat_of(p, "hold-ms"),
    repeats: nat_of(p, "repeats"),
  }

fn ladder_args(p: cmdline::Parsed) -> ladder::Args =
  {
    repo: text_of(p, "repo"),
    scratch: text_of(p, "scratch"),
    sections: split_commas(text_of(p, "sections")),
    db: cmdline::value(p, "db"),
    accept: text_of(p, "accept"),
    concurrency: nats_of(p, "concurrency"),
    per_conn: nat_of(p, "per-conn"),
    requests_per_point: nat_of(p, "requests-per-point"),
    repeats: nat_of(p, "repeats"),
    served_repeats: nat_of(p, "served-repeats"),
    iterations: nat_of(p, "iterations"),
    alloc_requests: nat_of(p, "alloc-requests"),
    machine: text_of(p, "machine"),
    out: cmdline::value(p, "out"),
  }

fn float_of(p: cmdline::Parsed, long: String) -> Float =
  match cmdline::value(p, long) {
    Some(v) -> match decimal_of_string(v) { Some(d) -> float_of_decimal(d), None -> 0.0 },
    None -> 0.0,
  }

fn spec_of(p: cmdline::Parsed) -> gbuild::Spec =
  {
    seed: nat_of(p, "seed"),
    modules: nat_of(p, "modules"),
    defs_per_module: nat_of(p, "defs-per-module"),
    tests: nat_of(p, "tests"),
    depth: nat_of(p, "depth"),
    tables: nat_of(p, "tables"),
    regions: nat_of(p, "regions"),
    effect_fraction: float_of(p, "effect-fraction"),
    nondet_fraction: float_of(p, "nondet-fraction"),
    hub_modules: nat_of(p, "hub-modules"),
    max_weight: nat_of(p, "max-weight"),
    concurrent_tests: nat_of(p, "concurrent-tests"),
    tasks_per_test: nat_of(p, "tasks-per-test"),
    steps_per_task: nat_of(p, "steps-per-task"),
    conflict_density: float_of(p, "conflict-density"),
    spec_fraction: float_of(p, "spec-fraction"),
    specimens_per_module: nat_of(p, "specimens-per-module"),
  }

// A valued flag that must be written: the line is refused when it was not, the library's way.
fn required(p: cmdline::Parsed, long: String) -> Result<String, String> =
  match cmdline::value(p, long) {
    Some(v) -> Ok(v),
    None ->
      Err(
        cmdline::refused(
          spec(),
          p.path,
          "a value is required for '--" ++ long ++ "' but none was supplied",
        ),
      ),
  }

pub fn asked(argv: List<String>) -> Asked =
  match cmdline::parse(spec(), argv) {
    cmdline::Help(text) -> Said(text),
    cmdline::Version(text) -> Said(text),
    cmdline::Refused(text) -> Refusal(text),
    cmdline::Run(p) -> match cmdline::nth_of(p.path, 0, "") {
      "gen" -> match required(p, "out") {
        Err(why) -> Refusal(why),
        Ok(out) ->
          Gen({
            out: out,
            spec: spec_of(p),
            no_verify: cmdline::has(p, "no-verify"),
            json: cmdline::has(p, "json"),
          }),
      },
      "bench" ->
        Bench({
          corpus: cmdline::nth_of(p.positionals, 0, ""),
          repeats: nat_of(p, "repeats"),
          json: cmdline::has(p, "json"),
        }),
      "sweep" -> match required(p, "out") {
        Err(why) -> Refusal(why),
        Ok(out) ->
          Sweep({
            out: out,
            sizes: cmdline::values_of(p, "sizes"),
            seed: nat_of(p, "seed"),
            repeats: nat_of(p, "repeats"),
            json: cmdline::has(p, "json"),
          }),
      },
      "real" ->
        Real({
          tests: !cmdline::has(p, "no-tests"),
          member: cmdline::value(p, "member"),
          json: cmdline::has(p, "json"),
        }),
      "measure" ->
        Measure({
          corpus: cmdline::nth_of(p.positionals, 0, ""),
          repeats: nat_of(p, "repeats"),
          only_throughput: cmdline::has(p, "only-throughput"),
          json: cmdline::has(p, "json"),
        }),
      "payload" -> match shapes_of(p) {
        Err(why) -> Refusal(why),
        Ok(shapes) ->
          Payload({
            args: {
              lines: nats_of(p, "lines"),
              iterations: nat_of(p, "iterations"),
              shapes: shapes,
              entries: nats_of(p, "entries"),
              types: nats_of(p, "types"),
              types_per_module: nat_of(p, "types-per-module"),
              processes: nat_of(p, "processes"),
              repeats: nat_of(p, "repeats"),
              derivation: !cmdline::has(p, "no-derivation"),
            },
            json: cmdline::has(p, "json"),
          }),
      },
      "regions" ->
        Regions({
          args: {
            roots: filter(p.positionals, |r: String| r != ""),
            jobs: nat_of(p, "jobs"),
            hypothetical: cmdline::values_of(p, "hypothetical"),
            hypothetical_shared: nat_of(p, "hypothetical-shared"),
            hypothetical_pure: nat_of(p, "hypothetical-pure"),
            std: cmdline::has(p, "std"),
          },
          json: cmdline::has(p, "json"),
        }),
      "tiers" -> match required(p, "out") {
        Err(why) -> Refusal(why),
        Ok(out) ->
          Tiers({
            args: {
              out: out,
              seeds: nat_of(p, "seeds"),
              seed: match cmdline::value(p, "seed") {
                Some(v) -> cmdline::parse_nat(v),
                None -> None,
              },
              cases: nat_of(p, "cases"),
              roots: nat_of(p, "roots"),
            },
            json: cmdline::has(p, "json"),
          }),
      },
      "sim" ->
        Sim({
          args: {
            corpus: cmdline::nth_of(p.positionals, 0, ""),
            trials: nat_of(p, "trials"),
            budget: nat_of(p, "budget"),
            steps: nat_of(p, "steps"),
            rate_seeds: nat_of(p, "rate-seeds"),
            reduction: !cmdline::has(p, "no-reduction"),
          },
          json: cmdline::has(p, "json"),
        }),
      "prove" ->
        Prove({
          args: {
            projects: p.positionals,
            cases: nat_of(p, "cases"),
            prove_budget: nat_of(p, "prove-budget"),
          },
          json: cmdline::has(p, "json"),
        }),
      "serve" -> Serve({ args: serve_args(p), json: cmdline::has(p, "json") }),
      "w3" -> W3({ args: w3_args(p), json: cmdline::has(p, "json") }),
      "w4" -> W4({ args: w4_args(p), json: cmdline::has(p, "json") }),
      "w5" -> W5({ args: w5_args(p), json: cmdline::has(p, "json") }),
      "w6" -> W6(cmdline::has(p, "json")),
      "w6-ladder" -> W6Ladder({ args: ladder_args(p), json: cmdline::has(p, "json") }),
      other -> Refusal(cmdline::refused(spec(), p.path, "no command named " ++ other)),
    },
  }

// A comma list the spec already checked entry by entry, as the numbers it holds.
fn nats_of(p: cmdline::Parsed, long: String) -> List<Int> =
  match cmdline::value(p, long) {
    None -> [],
    Some(v) ->
      fold(split_commas(v), [], |acc: List<Int>, s: String|
        match cmdline::parse_nat(s) { Some(n) -> push(acc, n), None -> acc }),
  }

fn shapes_of(p: cmdline::Parsed) -> Result<List<payload::Shape>, String> =
  match cmdline::value(p, "shape") {
    None -> Ok([]),
    Some(v) ->
      fold(split_commas(v), Ok([]), |acc: Result<List<payload::Shape>, String>, text: String|
        match acc {
          Err(e) -> Err(e),
          Ok(done) -> match payload::shape_of(text) {
            Err(e) -> Err(e),
            Ok(s) -> Ok(push(done, s)),
          },
        }),
  }

// --- Running what was asked ------------------------------------------------------

// A text as the stream carries it: `out` and `err` end each write with a newline, so one the text
// already ends with is not written twice.
fn chomped(text: String) -> String =
  if string_ends_with(text, "\n") { string_slice(text, 0, string_len(text) - 1) } else { text }

fn say(text: String) -> Unit / {process.out[proc]} =
  if text == "" { () } else { process.out[proc](chomped(text)) }

fn complain(text: String) -> Unit / {process.err[proc]} =
  if text == "" { () } else { process.err[proc](chomped(text)) }

// A subcommand's answer: what it printed and exit 0, or why it could not and exit 1.
fn answered(outcome: Result<String, String>) -> Int / {process.out[proc], process.err[proc]} =
  match outcome {
    Ok(text) -> {
      say(text);
      0
    },
    Err(why) -> {
      complain("ply-corpus: " ++ why);
      1
    },
  }

// A subcommand's report, as the line asked for it.
fn reported(outcome: Result<report::Report, String>, json_wanted: Bool) -> Result<String, String> =
  match outcome {
    Err(why) -> Err(why),
    Ok(r) ->
      Ok(if json_wanted { json::to_string(report::to_json(r)) } else { report::rendered(r) }),
  }

// What serving a program takes: `ply run` children, the floor as `http_floor` when the runner
// bound one, the kit's own connections, the clock, and certificates for a TLS run.
effect set Serving = {process.start[ply], process.wait[ply], process.signal[ply], process.output_line[ply], process.bound[http_floor], process.start[http_floor], process.wait[http_floor], process.signal[http_floor], process.output_line[http_floor], net.connect[probe], net.send[probe], net.recv[probe], net.close[probe], certgen.issue, time.sleep_ms}

// What measuring a database takes besides: the libpq tool the runner built and bound as
// `pg_floor`, and the harness's own connections to the database, through the driver it measures.
effect set Database = {process.spawn[pg_floor], process.start[pg_floor], process.wait[pg_floor], process.signal[pg_floor], process.output_line[pg_floor], process.end_input[pg_floor], net.connect[link], net.send[link], net.recv[link], net.close[link], entropy.next}

fn code_of(
  a: Asked,
) -> Int / {process.bound[pg_floor], process.out[proc], process.err[proc], process.spawn[ply], config.get[env], time.elapsed_ms, time.elapsed_us, fs.read[work], fs.write[work], fs.read[repo], machine.configure[bench], machine.load[bench], machine.bound[bench], machine.call[bench], machine.accounting[bench], machine.drop[bench], prover.configure[claims], prover.collected[claims], prover.cached[claims], prover.prepared[claims], prover.judged[claims], prover.interleaved[claims], Serving, prover.record[claims], prover.accepted[claims], Database} =
  match a {
    Said(text) -> {
      process.out[proc](text);
      0
    },
    Refusal(text) -> {
      complain(text);
      2
    },
    Gen(g) ->
      answered(match gen::run(g.out, g.spec, g.no_verify) {
        Err(why) -> Err(why),
        Ok(made) ->
          Ok(if g.json { json::to_string(gen::report_json(made)) } else { gen::summary(made) }),
      }),
    Bench(b) -> answered(reported(bench::run(b.corpus, b.repeats), b.json)),
    Sweep(s) ->
      answered(match sweep::sizes_of(s.sizes, s.seed) {
        Err(why) -> Err(why),
        Ok(sizes) -> reported(sweep::run(s.out, sizes, s.repeats), s.json),
      }),
    Real(r) -> answered(reported(real::run(r.tests, r.member), r.json)),
    Measure(m) -> answered(reported(measure::run(m.corpus, m.repeats, m.only_throughput), m.json)),
    Payload(p) -> answered(reported(payload::run(p.args), p.json)),
    Regions(r) -> answered(reported(regions::run(r.args), r.json)),
    Tiers(t) -> answered(reported(tiers::run(t.args), t.json)),
    Sim(s) -> answered(reported(search::run(s.args), s.json)),
    Prove(p) -> answered(reported(discharge::run(p.args), p.json)),
    Serve(s) -> answered(reported(serve::run(s.args), s.json)),
    W3(w) -> answered(reported(w3::run(w.args), w.json)),
    W4(w) -> answered(reported(w4::run(w.args), w.json)),
    W5(w) -> answered(reported(w5::run(w.args), w.json)),
    W6(json_wanted) -> answered(reported(w6::run(), json_wanted)),
    W6Ladder(l) -> answered(reported(ladder::run(l.args), l.json)),
  }

pub fn main() -> Unit / {process.bound[pg_floor], process.args[proc], process.out[proc], process.err[proc], process.exit[proc], process.spawn[ply], config.get[env], time.elapsed_ms, time.elapsed_us, fs.read[work], fs.write[work], fs.read[repo], machine.configure[bench], machine.load[bench], machine.bound[bench], machine.call[bench], machine.accounting[bench], machine.drop[bench], prover.configure[claims], prover.collected[claims], prover.cached[claims], prover.prepared[claims], prover.judged[claims], prover.interleaved[claims], Serving, prover.record[claims], prover.accepted[claims], Database} =
  process.exit[proc](code_of(asked(process.args[proc]())))

// --- Tests -----------------------------------------------------------------------

fn refusal_of(argv: List<String>) -> String = match asked(argv) { Refusal(text) -> text, _ -> "" }

test "a bare word is refused with the help in it" {
  assert(string_contains(refusal_of(["nonsense"]), "unrecognized subcommand"))
}

test "gen fills the shape's defaults, which are the generator's" {
  match asked(["gen", "--out", "gen-out"]) {
    Gen(g) -> {
      assert_eq(g.out, "gen-out");
      assert_eq(g.spec, gen::default_spec());
      assert(!g.no_verify);
      assert(!g.json)
    },
    _ -> assert(false),
  }
}

test "gen refuses without --out" { assert(string_contains(refusal_of(["gen"]), "--out")) }

test "a conflict density outside 0 to 1 is refused by the generator" {
  match asked(["gen", "--out", "c", "--conflict-density", "2"]) {
    Gen(g) ->
      assert(match gen::validate(g.spec) {
        Err(why) -> string_contains(why, "--conflict-density"),
        Ok(_) -> false,
      }),
    _ -> assert(false),
  }
}

test "a directory the corpus writes is under the working directory" {
  assert(string_contains(refusal_of(["gen", "--out", "/tmp/corpus"]), "is absolute"));
  assert(string_contains(refusal_of(["bench", "../corpus"]), "climbs out"));
  match asked(["bench", "corpora/m4", "--repeats", "1"]) {
    Bench(b) -> {
      assert_eq(b.corpus, "corpora/m4");
      assert_eq(b.repeats, 1)
    },
    _ -> assert(false),
  }
}

test "sweep reads its sizes and its seed" {
  match asked(["sweep", "--out", "s", "--sizes", "4,5,8", "--sizes", "6,5,8", "--seed", "3"]) {
    Sweep(s) -> {
      assert_eq(s.sizes, ["4,5,8", "6,5,8"]);
      assert_eq(s.seed, 3)
    },
    _ -> assert(false),
  }
}

test "real takes every member and tests it unless told otherwise" {
  match asked(["real"]) {
    Real(r) -> assert(r.tests && !r.json && r.member == None),
    _ -> assert(false),
  };
  match asked(["real", "--no-tests", "--json"]) {
    Real(r) -> assert(!r.tests && r.json),
    _ -> assert(false),
  }
}

test "real takes one member when it is named, and refuses a name that is none" {
  match asked(["real", "--member", "cli", "--no-tests"]) {
    Real(r) -> assert_eq(r.member, Some("cli")),
    _ -> assert(false),
  };
  assert(
    string_contains(refusal_of(["real", "--member", "std"]), "[possible values: compiler, cli]"),
  )
}

test "w4 runs every table without a database, and takes one when it is named" {
  match asked(["w4"]) {
    W4(w) -> {
      assert_eq(w.args.db, None);
      assert_eq(w.args.sections, w4::sections());
      assert_eq(w.args.concurrency, [1, 2, 4, 8, 16]);
      assert_eq((w.args.operations, w.args.pool, w.args.repeats), (400, 16, 3))
    },
    _ -> assert(false),
  };
  match asked(["w4", "--db", "postgres://u@db/bench", "--sections", "ops", "--rows", "8"]) {
    W4(w) -> {
      assert_eq(w.args.db, Some("postgres://u@db/bench"));
      assert_eq(w.args.sections, ["ops"]);
      assert_eq(w.args.rows, [8])
    },
    _ -> assert(false),
  };
  assert(string_contains(refusal_of(["w4", "--sections", "events"]), "events is not a table"));
  assert(string_contains(refusal_of(["w4", "--pool-sizes", "0"]), "0 is not a count above zero"))
}

test "w5 reads its drain and its sinks' loop, and has no events table" {
  match asked(["w5", "--sections", "drain,deploy", "--drain-ms", "2000", "--in-flight", "4"]) {
    W5(w) -> {
      assert_eq(w.args.sections, ["drain", "deploy"]);
      assert_eq((w.args.drain_ms, w.args.hold_ms, w.args.in_flight), (2000, 500, [4]));
      assert_eq(w.args.accept, "sequential");
      assert_eq(w.args.db, None)
    },
    _ -> assert(false),
  };
  assert(string_contains(refusal_of(["w5", "--sections", "events"]), "events is not a table"));
  assert(string_contains(refusal_of(["w5", "--accept", "threads"]), "possible values"))
}

test "serve reads its tables and its load, and refuses a table it does not take" {
  match asked(["serve", "--sections", "layers,scans", "--concurrency", "2,8", "--json"]) {
    Serve(s) -> {
      assert_eq(s.args.sections, ["layers", "scans"]);
      assert_eq(s.args.concurrency, [2, 8]);
      assert_eq(s.args.per_conn, 1);
      assert_eq(s.args.repo, ".");
      assert_eq(s.args.scratch, "target/corpus");
      assert(s.json)
    },
    _ -> assert(false),
  };
  assert(
    string_contains(refusal_of(["serve", "--sections", "layers,ladder"]), "ladder is not a table"),
  );
  assert(
    string_contains(refusal_of(["serve", "--concurrency", "1,0"]), "0 is not a count above zero"),
  );
  assert(string_contains(refusal_of(["serve", "--scratch", "/tmp/corpus"]), "is absolute"))
}

test "w3 takes the desk's accept loops and no other" {
  match asked(["w3", "--accept", "task-per-connection", "--sections", "keep-alive"]) {
    W3(w) -> {
      assert_eq(w.args.accept, "task-per-connection");
      assert_eq(w.args.sections, ["keep-alive"]);
      assert_eq(w.args.ladder_concurrency, 8);
      assert(!w.json)
    },
    _ -> assert(false),
  };
  assert(string_contains(refusal_of(["w3", "--accept", "threads"]), "possible values"))
}

test "w6-ladder takes its sections, its loads, its database and where its evidence goes" {
  match asked([
      "w6-ladder",
      "--concurrency",
      "1,16,64",
      "--out",
      "benches",
      "--db",
      "postgres://ply@127.0.0.1/desk",
    ]) {
    W6Ladder(l) -> {
      assert_eq(l.args.concurrency, [1, 16, 64]);
      assert_eq(l.args.sections, ["in-process", "served", "alloc"]);
      assert_eq(l.args.out, Some("benches"));
      assert_eq(l.args.db, Some("postgres://ply@127.0.0.1/desk"));
      assert_eq((l.args.per_conn, l.args.alloc_requests, l.args.served_repeats), (32, 200, 3))
    },
    _ -> assert(false),
  };
  match asked(["w6-ladder"]) {
    W6Ladder(l) -> assert(l.args.db == None && l.args.out == None && l.args.accept == "sequential"),
    _ -> assert(false),
  };
  assert(string_contains(refusal_of(["w6-ladder", "--alloc-requests", "50"]), "at least 100"));
  assert(string_contains(refusal_of(["w6-ladder", "--out", "/tmp/evidence"]), "is absolute"));
  assert(string_contains(refusal_of(["w6-ladder", "--sections", "spike"]), "spike is not a table"));
  match asked(["w6", "--json"]) { W6(json_wanted) -> assert(json_wanted), _ -> assert(false) }
}

test "payload reads its lists at their defaults, and its shape as `lines:pad` pairs" {
  match asked(["payload"]) {
    Payload(p) -> {
      assert_eq(p.args.lines, [1, 10, 40, 200, 1000]);
      assert_eq(p.args.shapes, [
        { lines: 40, pad: 0 },
        { lines: 40, pad: 100 },
        { lines: 40, pad: 400 },
        { lines: 40, pad: 1600 },
      ]);
      assert_eq(p.args.entries, [16, 256, 4096, 65536]);
      assert(p.args.derivation && !p.json)
    },
    _ -> assert(false),
  };
  assert(string_contains(refusal_of(["payload", "--shape", "40:0,40"]), "40 is not two numbers"))
}

test "a list entry that is not a number is refused rather than read as nothing" {
  assert(string_contains(refusal_of(["payload", "--lines", "1,x"]), "x is not a number"))
}

test "measure's corpus is optional, and one named is under the working directory" {
  match asked(["measure"]) {
    Measure(m) -> assert(m.corpus == "" && !m.only_throughput),
    _ -> assert(false),
  };
  match asked(["measure", "corpora/m4", "--only-throughput", "--repeats", "2"]) {
    Measure(m) -> assert(m.corpus == "corpora/m4" && m.only_throughput && m.repeats == 2),
    _ -> assert(false),
  };
  assert(string_contains(refusal_of(["measure", "/tmp/m4"]), "is absolute"))
}

test "regions reads its roots and its hypotheticals, and a root outside is refused" {
  match asked(["regions", "examples", "--hypothetical", "12:3", "--hypothetical", "40:4"]) {
    Regions(r) -> {
      assert_eq(r.args.roots, ["examples"]);
      assert_eq(r.args.hypothetical, ["12:3", "40:4"]);
      assert_eq((r.args.jobs, r.args.hypothetical_shared, r.args.hypothetical_pure), (8, 10, 165))
    },
    _ -> assert(false),
  };
  match asked(["regions", "--hypothetical", "12:3"]) {
    Regions(r) -> assert_eq(r.args.roots, []),
    _ -> assert(false),
  };
  assert(string_contains(refusal_of(["regions", "../elsewhere"]), "climbs out"))
}

test "tiers audits six seeds at a thousand cases from eight roots unless told otherwise" {
  match asked(["tiers", "--out", "tiers"]) {
    Tiers(t) -> {
      assert_eq((t.args.out, t.args.seeds, t.args.cases, t.args.roots), ("tiers", 6, 1000, 8));
      assert_eq(t.args.seed, None)
    },
    _ -> assert(false),
  };
  assert(string_contains(refusal_of(["tiers"]), "--out"))
}

test "tiers audits one of its seeds alone when asked, and refuses a seed it does not take" {
  match asked(["tiers", "--out", "t", "--seed", "6"]) {
    Tiers(t) -> assert_eq((t.args.seeds, t.args.seed), (6, Some(6))),
    _ -> assert(false),
  };
  match asked(["tiers", "--out", "t", "--seeds", "8", "--seed", "8"]) {
    Tiers(t) -> assert_eq((t.args.seeds, t.args.seed), (8, Some(8))),
    _ -> assert(false),
  };
  assert(
    string_contains(
      refusal_of(["tiers", "--out", "t", "--seed", "7"]),
      "invalid value '7' for '--seed <N>': the audit takes seeds 1 to 6",
    ),
  );
  assert(string_contains(refusal_of(["tiers", "--out", "t", "--seed", "0"]), "'--seed <N>'"));
  assert(string_contains(refusal_of(["tiers", "--out", "t", "--seeds", "0"]), "'--seeds <N>'"))
}

test "sim takes its tables at their defaults, and drops one asked for zero" {
  match asked(["sim", "corpora/c4"]) {
    Sim(s) ->
      assert_eq(s.args, {
        corpus: "corpora/c4",
        trials: 32,
        budget: 4096,
        steps: 100000,
        rate_seeds: 64,
        reduction: true,
      }),
    _ -> assert(false),
  };
  match asked(["sim", "a.ply", "--trials", "0", "--rate-seeds", "0", "--no-reduction", "--json"]) {
    Sim(s) -> assert(s.args.trials == 0 && s.args.rate_seeds == 0 && !s.args.reduction && s.json),
    _ -> assert(false),
  };
  assert(string_contains(refusal_of(["sim", "a.ply", "--budget", "0"]), "'--budget <N>'"))
}

test "prove takes every project named, each on rows of its own" {
  match asked(["prove", "a.ply", "corpora/c4", "--cases", "7"]) {
    Prove(p) ->
      assert_eq(p.args, { projects: ["a.ply", "corpora/c4"], cases: 7, prove_budget: 10000 }),
    _ -> assert(false),
  };
  assert(string_contains(refusal_of(["prove", "a.ply", "--cases", "0"]), "'--cases <N>'"))
}

test "a subcommand that could not answer exits 1, and says why under the program's name" {
  let written = with_cell[said]([]) { lines -> {
    let code = handle {
      answered(Err("the corpus does not check"))
    } with {
      process.out[proc](text) -> cell_set(lines, push(cell_get(lines), "out: " ++ text)),
      process.err[proc](text) -> cell_set(lines, push(cell_get(lines), "err: " ++ text)),
    };
    (code, cell_get(lines))
  } };
  assert_eq(written, (1, ["err: ply-corpus: the corpus does not check"]))
}

test "an unknown flag is a refusal, not a panic" {
  assert(refusal_of(["bench", "some-corpus", "--bogus"]) != "")
}

test "help is text for stdout, and names every subcommand" {
  match asked(["--help"]) {
    Said(text) -> {
      assert(string_contains(text, "w6-ladder"));
      assert(string_contains(text, "sweep"));
      assert(string_contains(text, "tiers"))
    },
    _ -> assert(false),
  }
}

test "a text the stream would end with a newline is not given a second" {
  assert_eq(chomped("a\nb\n"), "a\nb");
  assert_eq(chomped("a"), "a")
}
