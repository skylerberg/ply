// --- The plan a run materializes ------------------------------------------------

fn str_flag(p: cmdline::Parsed, long: String) -> Json =
  match cmdline::value(p, long) { Some(v) -> Str(v), None -> Null }

fn int_flag(p: cmdline::Parsed, long: String) -> Json =
  match cmdline::value(p, long) {
    Some(v) -> match cmdline::parse_nat(v) { Some(n) -> Number(decimal_of_int(n)), None -> Null },
    None -> Null,
  }

fn float_flag(p: cmdline::Parsed, long: String) -> Json =
  match cmdline::value(p, long) {
    Some(v) -> match decimal_of_string(v) { Some(d) -> Number(d), None -> Null },
    None -> Null,
  }

fn bool_flag(p: cmdline::Parsed, long: String) -> Json = Bool(cmdline::has(p, long))

fn split_commas(text: String) -> List<String> =
  if text == "" { [] } else { split_from(bytes_of_string(text), 0, []) }

fn split_from(b: Bytes, from: Int, acc: List<String>) -> List<String> =
  match bytes_index_of(bytes_slice(b, from, bytes_len(b)), b",") {
    None -> push(acc, string_of_bytes(bytes_slice(b, from, bytes_len(b)))),
    Some(i) ->
      split_from(b, from + i + 1, push(acc, string_of_bytes(bytes_slice(b, from, from + i)))),
  }

fn nats_json(text: String) -> Json =
  array(
    map(split_commas(text), |s: String|
      match cmdline::parse_nat(s) { Some(n) -> Number(decimal_of_int(n)), None -> Null }),
  )

fn list_flag(p: cmdline::Parsed, long: String) -> Json =
  match cmdline::value(p, long) { Some(v) -> nats_json(v), None -> array([]) }

fn repeated_json(p: cmdline::Parsed, long: String) -> Json =
  array(map(cmdline::values_of(p, long), |s: String| Str(s)))

fn positionals_json(p: cmdline::Parsed) -> Json = array(map(p.positionals, |s: String| Str(s)))

// The shape knobs, one member list, shared by `gen`.
fn shape_args(p: cmdline::Parsed) -> List<{ key: String, value: Json }> =
  [
    { key: "seed", value: int_flag(p, "seed") },
    { key: "modules", value: int_flag(p, "modules") },
    { key: "defs_per_module", value: int_flag(p, "defs-per-module") },
    { key: "tests", value: int_flag(p, "tests") },
    { key: "depth", value: int_flag(p, "depth") },
    { key: "tables", value: int_flag(p, "tables") },
    { key: "regions", value: int_flag(p, "regions") },
    { key: "effect_fraction", value: float_flag(p, "effect-fraction") },
    { key: "nondet_fraction", value: float_flag(p, "nondet-fraction") },
    { key: "hub_modules", value: int_flag(p, "hub-modules") },
    { key: "max_weight", value: int_flag(p, "max-weight") },
    { key: "concurrent_tests", value: int_flag(p, "concurrent-tests") },
    { key: "tasks_per_test", value: int_flag(p, "tasks-per-test") },
    { key: "steps_per_task", value: int_flag(p, "steps-per-task") },
    { key: "conflict_density", value: float_flag(p, "conflict-density") },
    { key: "spec_fraction", value: float_flag(p, "spec-fraction") },
    { key: "specimens_per_module", value: int_flag(p, "specimens-per-module") },
  ]

fn serve_args(p: cmdline::Parsed) -> List<{ key: String, value: Json }> =
  [
    { key: "repo", value: str_flag(p, "repo") },
    { key: "ply", value: str_flag(p, "ply") },
    { key: "requests", value: int_flag(p, "requests") },
    { key: "repeats", value: int_flag(p, "repeats") },
    { key: "json", value: bool_flag(p, "json") },
  ]

fn plan(command: String, args: List<{ key: String, value: Json }>) -> Json =
  object([
    { key: "outcome", value: Str("run") },
    { key: "command", value: Str(command) },
    { key: "args", value: object(args) },
  ])

fn refused_plan(why: String) -> Json =
  object([{ key: "outcome", value: Str("refused") }, { key: "why", value: Str(why) }])

// A valued flag that must be written: the plan is a refusal when it was not, rendered the
// library's way.
fn required(p: cmdline::Parsed, long: String) -> Result<String, String> =
  match cmdline::value(p, long) {
    Some(v) -> Ok(v),
    None ->
      Err(
        cmdline::refused(
          spec(),
          p.path,
          "a value is required for '--" ++ long ++ "' but none was supplied",
        ),
      ),
  }

fn run_plan(p: cmdline::Parsed) -> Result<Json, String> =
  match cmdline::nth_of(p.path, 0, "") {
    "gen" -> match required(p, "out") {
      Err(why) -> Err(why),
      Ok(_) ->
        Ok(
          plan(
            "gen",
            cats([
              shape_args(p),
              [
                { key: "out", value: str_flag(p, "out") },
                { key: "no_verify", value: bool_flag(p, "no-verify") },
                { key: "json", value: bool_flag(p, "json") },
              ],
            ]),
          ),
        ),
    },
    "bench" ->
      Ok(
        plan("bench", [
          { key: "corpus", value: Str(cmdline::nth_of(p.positionals, 0, "")) },
          { key: "repeats", value: int_flag(p, "repeats") },
          { key: "backend", value: str_flag(p, "backend") },
          { key: "json", value: bool_flag(p, "json") },
        ]),
      ),
    "sweep" -> match required(p, "out") {
      Err(why) -> Err(why),
      Ok(_) ->
        Ok(
          plan("sweep", [
            { key: "out", value: str_flag(p, "out") },
            { key: "sizes", value: repeated_json(p, "sizes") },
            { key: "backend", value: str_flag(p, "backend") },
            { key: "seed", value: int_flag(p, "seed") },
            { key: "repeats", value: int_flag(p, "repeats") },
            { key: "json", value: bool_flag(p, "json") },
          ]),
        ),
    },
    "measure" ->
      Ok(
        plan("measure", [
          {
            key: "corpus",
            value: match list_at(p.positionals, 0) {
              Some(c) -> if c == "" { Null } else { Str(c) },
              None -> Null,
            },
          },
          { key: "repeats", value: int_flag(p, "repeats") },
          { key: "cells", value: list_flag(p, "cells") },
          { key: "only_throughput", value: bool_flag(p, "only-throughput") },
          { key: "json", value: bool_flag(p, "json") },
        ]),
      ),
    "sim" ->
      Ok(
        plan("sim", [
          { key: "corpus", value: Str(cmdline::nth_of(p.positionals, 0, "")) },
          { key: "trials", value: int_flag(p, "trials") },
          { key: "budget", value: int_flag(p, "budget") },
          { key: "steps", value: int_flag(p, "steps") },
          { key: "rate_seeds", value: int_flag(p, "rate-seeds") },
          { key: "no_reduction", value: bool_flag(p, "no-reduction") },
          { key: "json", value: bool_flag(p, "json") },
        ]),
      ),
    "prove" ->
      Ok(
        plan("prove", [
          { key: "projects", value: positionals_json(p) },
          { key: "cases", value: int_flag(p, "cases") },
          { key: "prove_budget", value: int_flag(p, "prove-budget") },
          { key: "shrink_budget", value: int_flag(p, "shrink-budget") },
          { key: "json", value: bool_flag(p, "json") },
        ]),
      ),
    "serve" ->
      Ok(
        plan(
          "serve",
          cats([
            serve_args(p),
            [
              { key: "ladder_requests", value: int_flag(p, "ladder-requests") },
              { key: "concurrency", value: list_flag(p, "concurrency") },
              { key: "load_headers", value: list_flag(p, "load-headers") },
              { key: "no_ladder", value: bool_flag(p, "no-ladder") },
              { key: "no_load", value: bool_flag(p, "no-load") },
              { key: "baseline", value: bool_flag(p, "baseline") },
            ],
          ]),
        ),
      ),
    "payload" ->
      Ok(
        plan("payload", [
          { key: "lines", value: list_flag(p, "lines") },
          { key: "iterations", value: int_flag(p, "iterations") },
          { key: "shape", value: list_flag(p, "shape") },
          { key: "entries", value: list_flag(p, "entries") },
          { key: "types", value: list_flag(p, "types") },
          { key: "types_per_module", value: int_flag(p, "types-per-module") },
          { key: "processes", value: int_flag(p, "processes") },
          { key: "ply", value: str_flag(p, "ply") },
          { key: "repeats", value: int_flag(p, "repeats") },
          { key: "no_derivation", value: bool_flag(p, "no-derivation") },
          { key: "json", value: bool_flag(p, "json") },
        ]),
      ),
    "w3" ->
      Ok(
        plan(
          "w3",
          cats([
            serve_args(p),
            [
              { key: "per_conn", value: int_flag(p, "per-conn") },
              { key: "requests_per_point", value: int_flag(p, "requests-per-point") },
              { key: "ladder_requests", value: int_flag(p, "ladder-requests") },
              { key: "ladder_concurrency", value: int_flag(p, "ladder-concurrency") },
              { key: "concurrency", value: list_flag(p, "concurrency") },
              { key: "concurrent", value: bool_flag(p, "concurrent") },
              { key: "w2_baseline", value: bool_flag(p, "w2-baseline") },
              { key: "no_load", value: bool_flag(p, "no-load") },
              { key: "no_shape", value: bool_flag(p, "no-shape") },
              { key: "no_tls", value: bool_flag(p, "no-tls") },
            ],
          ]),
        ),
      ),
    "w4" -> match required(p, "db") {
      Err(why) -> Err(why),
      Ok(_) ->
        Ok(
          plan("w4", [
            { key: "repo", value: str_flag(p, "repo") },
            { key: "db", value: str_flag(p, "db") },
            { key: "ply", value: str_flag(p, "ply") },
            { key: "concurrency", value: list_flag(p, "concurrency") },
            { key: "operations", value: int_flag(p, "operations") },
            { key: "rows", value: list_flag(p, "rows") },
            { key: "pool_sizes", value: list_flag(p, "pool-sizes") },
            { key: "pool", value: int_flag(p, "pool") },
            { key: "repeats", value: int_flag(p, "repeats") },
            { key: "load_concurrency", value: list_flag(p, "load-concurrency") },
            { key: "per_conn", value: int_flag(p, "per-conn") },
            { key: "requests_per_point", value: int_flag(p, "requests-per-point") },
            { key: "no_ops", value: bool_flag(p, "no-ops") },
            { key: "no_sizes", value: bool_flag(p, "no-sizes") },
            { key: "no_pool", value: bool_flag(p, "no-pool") },
            { key: "no_load", value: bool_flag(p, "no-load") },
            { key: "json", value: bool_flag(p, "json") },
          ]),
        ),
    },
    "w5" ->
      Ok(
        plan("w5", [
          { key: "repo", value: str_flag(p, "repo") },
          { key: "ply", value: str_flag(p, "ply") },
          { key: "db", value: str_flag(p, "db") },
          { key: "operations", value: int_flag(p, "operations") },
          { key: "twin_operations", value: int_flag(p, "twin-operations") },
          { key: "repeats", value: int_flag(p, "repeats") },
          { key: "concurrency", value: list_flag(p, "concurrency") },
          { key: "per_conn", value: int_flag(p, "per-conn") },
          { key: "requests_per_point", value: int_flag(p, "requests-per-point") },
          { key: "in_flight", value: list_flag(p, "in-flight") },
          { key: "drain_ms", value: int_flag(p, "drain-ms") },
          { key: "hold_ms", value: int_flag(p, "hold-ms") },
          { key: "api_key", value: str_flag(p, "api-key") },
          { key: "concurrent", value: bool_flag(p, "concurrent") },
          { key: "no_events", value: bool_flag(p, "no-events") },
          { key: "no_served", value: bool_flag(p, "no-served") },
          { key: "no_drain", value: bool_flag(p, "no-drain") },
          { key: "no_transaction", value: bool_flag(p, "no-transaction") },
          { key: "no_deploy", value: bool_flag(p, "no-deploy") },
          { key: "json", value: bool_flag(p, "json") },
        ]),
      ),
    "w6" ->
      Ok(
        plan("w6", [
          { key: "reports", value: positionals_json(p) },
          { key: "strict", value: bool_flag(p, "strict") },
          { key: "json", value: bool_flag(p, "json") },
        ]),
      ),
    "w6-ladder" -> match required(p, "db") {
      Err(why) -> Err(why),
      Ok(_) ->
        Ok(
          plan("w6-ladder", [
            { key: "repo", value: str_flag(p, "repo") },
            { key: "ply", value: str_flag(p, "ply") },
            { key: "db", value: str_flag(p, "db") },
            { key: "requests", value: int_flag(p, "requests") },
            { key: "iterations", value: int_flag(p, "iterations") },
            { key: "repeats", value: int_flag(p, "repeats") },
            { key: "concurrency", value: list_flag(p, "concurrency") },
            { key: "per_conn", value: int_flag(p, "per-conn") },
            { key: "requests_per_point", value: int_flag(p, "requests-per-point") },
            { key: "api_key", value: str_flag(p, "api-key") },
            { key: "machine", value: str_flag(p, "machine") },
            { key: "postgres", value: str_flag(p, "postgres") },
            { key: "no_served", value: bool_flag(p, "no-served") },
            { key: "only", value: str_flag(p, "only") },
            { key: "rounds", value: int_flag(p, "rounds") },
            { key: "accept", value: str_flag(p, "accept") },
            { key: "other_repeats", value: int_flag(p, "other-repeats") },
            { key: "served_repeats", value: int_flag(p, "served-repeats") },
            { key: "no_levers", value: bool_flag(p, "no-levers") },
            { key: "out", value: str_flag(p, "out") },
            { key: "detail", value: str_flag(p, "detail") },
            { key: "write_control", value: str_flag(p, "write-control") },
          ]),
        ),
    },
    "regions" ->
      Ok(
        plan("regions", [
          { key: "roots", value: positionals_json(p) },
          { key: "jobs", value: int_flag(p, "jobs") },
          { key: "hypothetical", value: repeated_json(p, "hypothetical") },
          { key: "hypothetical_shared", value: int_flag(p, "hypothetical-shared") },
          { key: "hypothetical_pure", value: int_flag(p, "hypothetical-pure") },
          { key: "std", value: bool_flag(p, "std") },
          { key: "json", value: bool_flag(p, "json") },
        ]),
      ),
    _ -> Err("no command named " ++ cmdline::nth_of(p.path, 0, "")),
  }

// --- The front door --------------------------------------------------------------

// argv as the binary's own, minus its name: the JSON plan the Rust half reads. A run plan's
// `args` carries every knob materialized -- defaults filled, nats and floats parsed, comma
// lists split -- so the Rust half only ever decodes.
pub fn dispatch(argv: List<String>) -> String =
  encode(match cmdline::parse(spec(), argv) {
    cmdline::Run(p) -> match run_plan(p) { Ok(j) -> j, Err(why) -> refused_plan(why) },
    cmdline::Help(text) ->
      object([{ key: "outcome", value: Str("help") }, { key: "text", value: Str(text) }]),
    cmdline::Version(text) ->
      object([{ key: "outcome", value: Str("version") }, { key: "text", value: Str(text) }]),
    cmdline::Refused(text) ->
      object([{ key: "outcome", value: Str("refused") }, { key: "why", value: Str(text) }]),
  })

fn encode(j: Json) -> String = json::to_string(j)

pub fn main() -> Unit / {process.args[proc], process.out[proc]} = {
  let argv: List<String> = process.args[proc]();
  process.out[proc](dispatch(drop_first(argv)))
}

fn drop_first(xs: List<String>) -> List<String> = match xs { [] -> [], [_, ..rest] -> rest }

// --- Tests -----------------------------------------------------------------------

test "a bare word is refused with the help in it" {
  match cmdline::parse(spec(), ["nonsense"]) {
    cmdline::Refused(text) -> assert(string_contains(text, "unrecognized subcommand")),
    _ -> assert(false),
  }
}

test "gen fills the shape's defaults" {
  let out = dispatch(["gen", "--out", "gen-out"]);
  assert(string_contains(out, "\"command\":\"gen\""));
  assert(string_contains(out, "\"seed\":1"));
  assert(string_contains(out, "\"effect_fraction\":0.35"));
  assert(string_contains(out, "\"no_verify\":false"));
  assert(string_contains(out, "\"out\":\"gen-out\""));
}

test "gen refuses without --out" {
  let out = dispatch(["gen"]);
  assert(string_contains(out, "\"outcome\":\"refused\""));
  assert(string_contains(out, "--out"));
}

test "w4 refuses without --db" {
  let out = dispatch(["w4"]);
  assert(string_contains(out, "\"outcome\":\"refused\""));
  assert(string_contains(out, "--db"));
}

test "w6-ladder reads a comma list of concurrencies" {
  let out = dispatch(["w6-ladder", "--db", "pg://x", "--concurrency", "1,16,64"]);
  assert(string_contains(out, "\"concurrency\":[1,16,64]"));
}

test "an unknown flag is a refusal, not a panic" {
  let out = dispatch(["bench", "some-corpus", "--bogus"]);
  assert(string_contains(out, "\"outcome\":\"refused\""));
}

test "help is its own outcome" {
  let out = dispatch(["--help"]);
  assert(string_contains(out, "\"outcome\":\"help\""));
  assert(string_contains(out, "w6-ladder"));
}
