            json_switch(),
          ],
        ),
        cmdline::with_positionals(
          cmdline::command(
            "measure",
            "Price interpreter throughput, fixture open against rebuild, and resumption cost",
            [
              nat("repeats", 3, "Repeats per measurement; the fastest is reported"),
