// The corpus's command line and its entry point. The line is declared once as a cmdline spec — the
// CLI package's library, not a copy of it — and `main` answers it: help, a version and a refusal
// here; `gen`, and `bench`, `sweep`, `real`, `measure`, `payload`, `regions`, `tiers`, `sim`,
// `prove`, `serve`, `w3`, `w4`, `w5`, `w6` and `w6-ladder`, each answering a report.
//
// It runs under `ply run` (`benches/corpus.sh` holds the whole line) with two filesystem roots:
// `work`, bound at the working directory, which every path this program reads, writes or spawns in
// is relative to, and `repo`, the checkout whose standard library the in-process measurements are
// checked against and whose corpus sources a report is pinned by. It is lent the `machine` family
// for the in-process measurements and the `claims` family for `tiers`; `serve`, `w3`, `w4`, `w5`
// and `w6-ladder` start the programs the runner binds by path, and `w4`, `w5` and `w6-ladder` reach
// the database they measure.

import cli.claims (prover)
import cli.cmdline
import cli.machine (machine)
import bench
import discharge
import gbuild
import gen
import ladder
import measure
import payload
import real
import regions
import report
import search
import serve
import sweep
import tiers
import w3
import w4
import w5
import w6
import std.certgen (certgen)
import std.json
import std.fs (fs)
import std.net (net)
import std.process (process)
import std.config (config)
import std.random (entropy)
import std.time (time)

fn cats<a>(xss: List<List<a>>) -> List<a> =
  fold(xss, [], |acc: List<a>, xs: List<a>| fold(xs, acc, |acc2: List<a>, x: a| push(acc2, x)))

// --- Flags, as the corpus writes them -----------------------------------------

fn sw(long: String, help: String) -> cmdline::Flag = cmdline::switch(long, help)

fn nat(long: String, default: Int, help: String) -> cmdline::Flag =
  cmdline::with_default(cmdline::valued(long, "N", cmdline::Nat, help), int_to_string(default))

fn text(long: String, default: String, help: String) -> cmdline::Flag =
  cmdline::with_default(cmdline::valued(long, "TEXT", cmdline::Text, help), default)

fn opt(long: String, help: String) -> cmdline::Flag =
  cmdline::valued(long, "TEXT", cmdline::Text, help)

fn texts(long: String, help: String) -> cmdline::Flag =
  cmdline::repeated(cmdline::valued(long, "TEXT", cmdline::Text, help))

// The entries of a comma list; the empty list is written as nothing at all.
fn split_commas(text: String) -> List<String> =
  if text == "" { [] } else { string_split(text, ",") }

fn every(v: String, ok: (String) -> Bool, what: String) -> Result<Unit, String> =
  fold(split_commas(v), Ok(()), |acc: Result<Unit, String>, entry: String|
    match acc { Err(e) -> Err(e), Ok(_) -> if ok(entry) { Ok(()) } else { Err(entry ++ what) } })

fn is_nat(entry: String) -> Bool = cmdline::parse_nat(entry) != None

fn is_pair(entry: String) -> Bool =
  match cmdline::cut_once(entry, ":") {
    Some(cut) -> is_nat(cut.head) && is_nat(cut.tail),
    None -> false,
  }

// Comma lists are checked entry by entry here, so the plan never carries an entry that is not what
// its flag says it holds.
fn nats(long: String, default: String, help: String) -> cmdline::Flag =
  cmdline::checking(
    cmdline::with_default(cmdline::valued(long, "N,N,…", cmdline::Text, help), default),
    |v: String| every(v, is_nat, " is not a number"),
  )

fn pairs(long: String, default: String, help: String) -> cmdline::Flag =
  cmdline::checking(
    cmdline::with_default(cmdline::valued(long, "N:N,…", cmdline::Text, help), default),
    |v: String| every(v, is_pair, " is not two numbers `N:N`"),
  )

fn is_a_number(v: String) -> Result<Unit, String> =
  match decimal_of_string(v) { Some(_) -> Ok(()), None -> Err("not a number: " ++ v) }

fn float(long: String, default: Float, help: String) -> cmdline::Flag =
  cmdline::checking(
    cmdline::with_default(
      cmdline::valued(long, "F", cmdline::Text, help),
      float_to_string(default),
    ),
    is_a_number,
  )

// A directory the corpus reads or writes itself goes through the `work` root, which is the working
// directory: a path that is absolute, or climbs out of it, names nothing the program can reach.
fn inside(v: String) -> Result<Unit, String> =
  if v == "" { Err("a directory is required") } else if string_starts_with(v, "/") {
    Err("`" ++ v ++ "` is absolute; paths are relative to the working directory")
  } else if fold(string_split(v, "/"), false, |up: Bool, segment: String| up || segment == "..") {
    Err("`" ++ v ++ "` climbs out of the working directory, which is all the corpus can reach")
  } else { Ok(()) }

fn dir_flag(long: String, help: String) -> cmdline::Flag =
  cmdline::checking(cmdline::valued(long, "DIR", cmdline::Text, help), inside)

fn json_switch() -> cmdline::Flag = sw("json", "The report as JSON rather than a table")

// The knobs a generated corpus's shape takes, at the generator's own defaults.
fn shape_flags() -> List<cmdline::Flag> = {
  let d = gen::default_spec();
  [
    nat("seed", d.seed, "The seed the corpus is a function of"),
    nat("modules", d.modules, "Modules in the generated corpus"),
    nat("defs-per-module", d.defs_per_module, "Definitions per module"),
    nat("tests", d.tests, "Tests in the generated corpus"),
    nat("depth", d.depth, "Import depth of the generated module graph"),
    nat("tables", d.tables, "Tables in the generated schema"),
    nat("regions", d.regions, "Regions in the generated effect map"),
    float("effect-fraction", d.effect_fraction, "Definitions that perform effects"),
    float("nondet-fraction", d.nondet_fraction, "Definitions that perform nondeterministically"),
    nat("hub-modules", d.hub_modules, "Modules everything else imports"),
    nat("max-weight", d.max_weight, "The largest one definition weighs"),
    nat("concurrent-tests", d.concurrent_tests, "Tests that run tasks concurrently"),
    nat("tasks-per-test", d.tasks_per_test, "Tasks each concurrent test spawns"),
    nat("steps-per-task", d.steps_per_task, "Steps each spawned task takes"),
    float("conflict-density", d.conflict_density, "How often concurrent tasks contend"),
    float("spec-fraction", d.spec_fraction, "Definitions carrying a spec the prover reads"),
    nat("specimens-per-module", d.specimens_per_module, "Specimen definitions per module"),
  ]
}

fn pos(long: String, default: Int, help: String) -> cmdline::Flag =
  cmdline::with_default(cmdline::valued(long, "N", cmdline::Pos, help), int_to_string(default))

fn is_positive(entry: String) -> Bool =
  match cmdline::parse_nat(entry) { Some(n) -> n > 0, None -> false }

fn counts(long: String, default: String, help: String) -> cmdline::Flag =
  cmdline::checking(
    cmdline::with_default(cmdline::valued(long, "N,N,…", cmdline::Text, help), default),
    |v: String| every(v, is_positive, " is not a count above zero"),
  )

fn joined(xs: List<String>) -> String =
  fold(xs, "", |acc: String, x: String| if acc == "" { x } else { acc ++ ", " ++ x })

fn sections_flag(taken: List<String>, default: String) -> cmdline::Flag =
  cmdline::checking(
    cmdline::with_default(
      cmdline::valued(
        "sections",
        "NAME,…",
        cmdline::Text,
        "The tables to take, of " ++ joined(taken),
      ),
      default,
    ),
    |v: String|
      every(
        v,
        |entry: String| fold(taken, false, |seen: Bool, t: String| seen || t == entry),
        " is not a table this command takes",
      ),
  )

// A request's allocations are the slope between two counted windows, the smaller a tenth of the
// larger, and a window of fewer than ten requests is mostly the run around it.
fn two_windows(v: String) -> Result<Unit, String> =
  match cmdline::parse_nat(v) {
    Some(n) -> if n >= 100 { Ok(()) }
    else { Err("`--alloc-requests` is at least 100, so the smaller window holds ten; not " ++ v) },
    None -> Err(v ++ " is not a number"),
  }

// What every served subcommand takes: where the repository is, which the children are handed paths
// into, and where a run keeps what it makes, which this program writes through `work`.
fn served_flags() -> List<cmdline::Flag> =
  [
    text(
      "repo",
      ".",
      "The repository: its example and fixtures are what is run, from the working directory or an absolute path",
    ),
    cmdline::checking(
      text(
        "scratch",
        "target/corpus",
        "Where a run keeps its logs, certificates and the load client's reports",
      ),
      inside,
    ),
    pos("repeats", 3, "Runs of each point; the fastest is reported"),
    json_switch(),
  ]

fn tiers_seeds() -> Int = 6

// A command's check runs before the defaults are filled, so an unwritten `--seeds` is read here at
// its default.
fn seed_taken(p: cmdline::Parsed) -> Result<Unit, String> =
  match cmdline::value(p, "seed") {
    None -> Ok(()),
    Some(v) -> {
      let seeds = match cmdline::value(p, "seeds") {
        Some(_) -> nat_of(p, "seeds"),
        None -> tiers_seeds(),
      };
      match tiers::taken(seeds, cmdline::parse_nat(v)) {
        Ok(_) -> Ok(()),
        Err(why) -> Err("invalid value '" ++ v ++ "' for '--seed <N>': " ++ why),
      }
    },
  }

fn iterations_flag() -> cmdline::Flag =
  pos("iterations", 2000, "Calls in each round of an in-process table")

// Where the database benches reach postgres: one URL both the language's driver and libpq read.
fn db_flag(help: String) -> cmdline::Flag = cmdline::valued("db", "URL", cmdline::Text, help)

fn accept_flag(help: String) -> cmdline::Flag =
  cmdline::with_default(
    cmdline::valued("accept", "LOOP", cmdline::Choice(["sequential", "task-per-connection"]), help),
    "sequential",
  )

// --- The spec --------------------------------------------------------------------

pub fn spec() -> cmdline::Spec =
  {
    bin: "ply-corpus",
    version: "0.1.0",
    root: cmdline::with_subs(
      cmdline::command(
        "ply-corpus",
        "Generate a scale corpus for Ply, and measure where a run's time goes",
        [],
      ),
      [
        cmdline::command(
          "gen",
          "Write a synthetic project, then compile and run it to prove it is real",
          cats([
            shape_flags(),
            [
              dir_flag("out", "Where to write it; must be empty, or a corpus this tool wrote"),
              sw("no-verify", "Write the corpus without compiling it"),
              json_switch(),
            ],
          ]),
        ),
        cmdline::with_extra(
          cmdline::with_positionals(
            cmdline::command(
              "bench",
              "Time discovery, cache lookup, selection, compilation and execution over a corpus",
              [
                nat("repeats", 3, "Repeats per scenario; the fastest run is reported"),
                json_switch(),
              ],
            ),
            [cmdline::positional("corpus", "A directory a previous `gen` wrote")],
          ),
          |p: cmdline::Parsed| inside(cmdline::nth_of(p.positionals, 0, "")),
        ),
        cmdline::command(
          "sweep",
          "Generate and benchmark at several sizes, for one comparison table",
          [
            dir_flag("out", "A directory to hold one sub-directory per size"),
            texts("sizes", "A size to sweep, `modules,defs_per_module,tests`; repeat for each"),
            nat("seed", gen::default_spec().seed, "The seed every size is a function of"),
            nat("repeats", 3, "Repeats per scenario; the fastest run is reported"),
            json_switch(),
          ],
        ),
        cmdline::with_extra(
          cmdline::with_positionals(
            cmdline::command(
              "measure",
              "Price a call and a resumption in-process, and a corpus's store, throughput and schedule",
              [
                nat("repeats", 3, "Repeats per measurement; the fastest is reported"),
                sw("only-throughput", "Only the corpus's tests on one worker, first and steady"),
                json_switch(),
              ],
            ),
            [
              cmdline::defaulted(
                "corpus",
                "A directory a previous `gen` wrote; omit it for the in-process rows alone",
                "",
              ),
            ],
          ),
          |p: cmdline::Parsed| {
            let corpus = cmdline::nth_of(p.positionals, 0, "");
            if corpus == "" { Ok(()) } else { inside(corpus) }
          },
        ),
        cmdline::with_positionals(
          cmdline::command(
            "sim",
            "Price the search: pruning, seeds to the first failure, and seeds per second",
            [
              nat("trials", 32, "Roots per strategy in the race-finding table; zero drops it"),
              pos("budget", 4096, "Interleavings a search may run per root, pruned or not"),
              pos("steps", 100000, "Scheduling steps one interleaving may take"),
              nat("rate-seeds", 64, "Seeds the throughput table times; zero drops it"),
              sw(
                "no-reduction",
                "Drop the reduction and synchronization tables, which are the expensive ones",
              ),
              json_switch(),
            ],
          ),
          [cmdline::positional("corpus", "A `.ply` file, or a directory a previous `gen` wrote")],
        ),
        cmdline::with_positionals(
          cmdline::command(
            "prove",
            "Price the spec tier: where obligations land, and why some fell short",
            [
              pos("cases", 200, "Cases the prover generates per obligation"),
              pos("prove-budget", 10000, "The prover's budget per obligation"),
              json_switch(),
            ],
          ),
          [
            cmdline::many(
              cmdline::positional(
                "projects",
                "`.ply` files or directories, each reported on its own row",
              ),
            ),
          ],
        ),
        cmdline::command(
          "serve",
          "Price a request: its cost per layer in one process, and served against a floor in C",
          cats([
            served_flags(),
            [
              iterations_flag(),
              sections_flag(serve::sections(), "layers,load"),
              pos("requests", 2000, "Requests in each served point"),
              pos("per-conn", 1, "Requests one connection carries in the served table"),
              counts(
                "concurrency",
                "1,2,4,8,16,32,64",
                "Clients the desk's task-per-connection loop and the threaded floor are loaded with",
              ),
            ],
          ]),
        ),
        cmdline::command(
          "payload",
          "Price a derived JSON codec, `Map`, and what derivation costs the front end and cache",
          [
            nats("lines", "1,10,40,200,1000", "Line items per JSON payload"),
            nat("iterations", 200, "Encodes and decodes per payload size"),
            pairs(
              "shape",
              "40:0,40:100,40:400,40:1600",
              "`lines:pad` pairs separating a decode's per-field cost from its per-byte one",
            ),
            nats("entries", "16,256,4096,65536", "Entries per `Map` measurement"),
            nats("types", "50,200,500", "Type counts the derivation comparison is taken at"),
            nat("types-per-module", 10, "Types per module in that comparison"),
            nat(
              "processes",
              4,
              "Processes the `map_keys` order check spawns; two is the minimum to see a hasher seed",
            ),
            nat("repeats", 3, "Repeats per point; the fastest is reported"),
            sw("no-derivation", "Drop the derivation comparison, the slow half"),
            json_switch(),
          ],
        ),
        cmdline::command(
          "w3",
          "Price routing, HTTP/1.1 framing, keep-alive and TLS on the request path",
          cats([
            served_flags(),
            [
              iterations_flag(),
              sections_flag(w3::sections(), "mix,routes,keep-alive,tls,shape"),
              accept_flag("The loop the desk accepts connections with"),
              counts("concurrency", "1,2,4,8,16,32,64", "Clients the read mix is loaded with"),
              pos(
                "per-conn",
                32,
                "Requests one connection carries in the read mix and one route at a time",
              ),
              pos(
                "requests-per-point",
                4000,
                "Requests in each point of the read mix and one route at a time",
              ),
              pos(
                "ladder-requests",
                3200,
                "Requests in each point of the keep-alive and TLS tables",
              ),
              pos("ladder-concurrency", 8, "Clients in the keep-alive and TLS tables"),
