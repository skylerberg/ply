                "operations",
                400,
                "Statements per point in the `ops`, `sizes` and `pool` sections",
              ),
              counts("rows", "8,32,128,512", "Table sizes the `sizes` section sweeps, in rows"),
              counts("pool-sizes", "1,2,4,8,16", "Pool sizes the `pool` section sweeps"),
              pos("pool", 16, "Connections the `ops` sweep's pool holds, constant across its rows"),
              counts("load-concurrency", "1,8,32", "Client concurrencies in the `crud` section"),
              pos("per-conn", 32, "Requests one connection carries in the `crud` section"),
              pos("requests-per-point", 3000, "Requests per point in the `crud` section"),
            ],
          ]),
        ),
        cmdline::command(
          "w5",
          "Price tracing, a drain with requests in flight, the drain's deadline, and a deploy",
          cats([
            served_flags(),
            [
              sections_flag(w5::sections(), "sinks,drain,transaction,deploy"),
              db_flag(
                "A database holding the desk's schema, for the `sinks` and `transaction` sections; without it their rows are inconclusive",
              ),
              accept_flag("The loop the `sinks` table's desk accepts connections with"),
              counts("concurrency", "1,8,32", "Client concurrencies in the `sinks` table"),
              pos("per-conn", 32, "Requests one connection carries in the `sinks` table"),
              pos("requests-per-point", 3000, "Requests per point in the `sinks` table"),
              counts("in-flight", "1,8,32", "Requests held in flight when the signal arrives"),
              pos(
                "drain-ms",
                5000,
                "The drain's deadline, in milliseconds; shorter than the desk waits for a request's body, or the held requests time out before the drain runs out",
              ),
              pos(
                "hold-ms",
                500,
                "How long a held request's body is held back when the drain completes",
