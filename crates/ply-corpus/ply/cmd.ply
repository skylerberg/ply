// The corpus's command line and its entry point. The line is declared once as a cmdline spec — the
// CLI package's library, not a copy of it — and `main` answers it: help, a version and a refusal
// here; `gen`, and `bench`, `sweep`, `real`, `measure`, `payload`, `regions` and `tiers`, each
// answering a report, in this package; and `sim`, `prove` and the request path as a JSON plan
// handed to the Rust executor bound as `executor`, whose output and exit code are this program's own.
//
// It runs under `ply run` (`benches/corpus.sh` holds the whole line) with two filesystem roots:
// `work`, bound at the working directory, which every path this program reads, writes or spawns in
// is relative to, and `repo`, the checkout whose standard library the in-process measurements are
// checked against and whose corpus sources a report is pinned by. It is lent the `machine` family
// for the in-process measurements and the `claims` family for `tiers`.

import cli.claims (prover)
import cli.cmdline
import cli.machine (machine)
import bench
import gbuild
import gen
import measure
import payload
import real
import regions
import report
import spine
import sweep
import tiers
import std.json (Json, Str, Number, Bool, Null, object, array)
import std.json
import std.fs (fs)
import std.process (process, exit_code)
import std.config (config)
import std.time (time)

fn cats<a>(xss: List<List<a>>) -> List<a> =
  fold(xss, [], |acc: List<a>, xs: List<a>| fold(xs, acc, |acc2: List<a>, x: a| push(acc2, x)))

// --- Flags, as the corpus writes them -----------------------------------------

fn sw(long: String, help: String) -> cmdline::Flag = cmdline::switch(long, help)

fn nat(long: String, default: Int, help: String) -> cmdline::Flag =
  cmdline::with_default(cmdline::valued(long, "N", cmdline::Nat, help), int_to_string(default))

fn text(long: String, default: String, help: String) -> cmdline::Flag =
  cmdline::with_default(cmdline::valued(long, "TEXT", cmdline::Text, help), default)

fn opt(long: String, help: String) -> cmdline::Flag =
  cmdline::valued(long, "TEXT", cmdline::Text, help)

fn texts(long: String, help: String) -> cmdline::Flag =
  cmdline::repeated(cmdline::valued(long, "TEXT", cmdline::Text, help))

// The entries of a comma list; the empty list is written as nothing at all.
fn split_commas(text: String) -> List<String> =
  if text == "" { [] } else { string_split(text, ",") }

fn every(v: String, ok: (String) -> Bool, what: String) -> Result<Unit, String> =
  fold(split_commas(v), Ok(()), |acc: Result<Unit, String>, entry: String|
    match acc { Err(e) -> Err(e), Ok(_) -> if ok(entry) { Ok(()) } else { Err(entry ++ what) } })

fn is_nat(entry: String) -> Bool = cmdline::parse_nat(entry) != None

fn is_pair(entry: String) -> Bool =
  match cmdline::cut_once(entry, ":") {
    Some(cut) -> is_nat(cut.head) && is_nat(cut.tail),
    None -> false,
  }

// Comma lists are checked entry by entry here, so the plan never carries an entry that is not what
// its flag says it holds.
fn nats(long: String, default: String, help: String) -> cmdline::Flag =
  cmdline::checking(
    cmdline::with_default(cmdline::valued(long, "N,N,…", cmdline::Text, help), default),
    |v: String| every(v, is_nat, " is not a number"),
  )

fn pairs(long: String, default: String, help: String) -> cmdline::Flag =
  cmdline::checking(
    cmdline::with_default(cmdline::valued(long, "N:N,…", cmdline::Text, help), default),
    |v: String| every(v, is_pair, " is not two numbers `N:N`"),
  )

fn is_a_number(v: String) -> Result<Unit, String> =
  match decimal_of_string(v) { Some(_) -> Ok(()), None -> Err("not a number: " ++ v) }

fn float(long: String, default: Float, help: String) -> cmdline::Flag =
  cmdline::checking(
    cmdline::with_default(
      cmdline::valued(long, "F", cmdline::Text, help),
      float_to_string(default),
    ),
    is_a_number,
  )

// A directory the corpus reads or writes itself goes through the `work` root, which is the working
// directory: a path that is absolute, or climbs out of it, names nothing the program can reach.
fn inside(v: String) -> Result<Unit, String> =
  if v == "" { Err("a directory is required") } else if string_starts_with(v, "/") {
    Err("`" ++ v ++ "` is absolute; paths are relative to the working directory")
  } else if fold(string_split(v, "/"), false, |up: Bool, segment: String| up || segment == "..") {
    Err("`" ++ v ++ "` climbs out of the working directory, which is all the corpus can reach")
  } else { Ok(()) }

fn dir_flag(long: String, help: String) -> cmdline::Flag =
  cmdline::checking(cmdline::valued(long, "DIR", cmdline::Text, help), inside)

fn json_switch() -> cmdline::Flag = sw("json", "The report as JSON rather than a table")

// The knobs a generated corpus's shape takes, at the generator's own defaults.
fn shape_flags() -> List<cmdline::Flag> = {
  let d = gen::default_spec();
  [
    nat("seed", d.seed, "The seed the corpus is a function of"),
    nat("modules", d.modules, "Modules in the generated corpus"),
    nat("defs-per-module", d.defs_per_module, "Definitions per module"),
    nat("tests", d.tests, "Tests in the generated corpus"),
    nat("depth", d.depth, "Import depth of the generated module graph"),
    nat("tables", d.tables, "Tables in the generated schema"),
    nat("regions", d.regions, "Regions in the generated effect map"),
    float("effect-fraction", d.effect_fraction, "Definitions that perform effects"),
    float("nondet-fraction", d.nondet_fraction, "Definitions that perform nondeterministically"),
    nat("hub-modules", d.hub_modules, "Modules everything else imports"),
    nat("max-weight", d.max_weight, "The largest one definition weighs"),
    nat("concurrent-tests", d.concurrent_tests, "Tests that run tasks concurrently"),
    nat("tasks-per-test", d.tasks_per_test, "Tasks each concurrent test spawns"),
    nat("steps-per-task", d.steps_per_task, "Steps each spawned task takes"),
    float("conflict-density", d.conflict_density, "How often concurrent tasks contend"),
    float("spec-fraction", d.spec_fraction, "Definitions carrying a spec the prover reads"),
    nat("specimens-per-module", d.specimens_per_module, "Specimen definitions per module"),
  ]
}

fn serve_flags() -> List<cmdline::Flag> =
  [
    text("repo", ".", "The repository root the fixtures are read from"),
    opt("ply", "The `ply` binary the load tables drive; the executor's sibling when left off"),
    nat("requests", 2000, "Requests per point"),
    nat("repeats", 3, "Repeats per point; the fastest is reported"),
    json_switch(),
  ]

