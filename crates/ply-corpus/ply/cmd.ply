        ),
        cmdline::command("w6", "Judge the W6 ladder benches/w6-ladder.json ships, rung by rung", [
          json_switch(),
        ]),
        cmdline::command(
          "w6-ladder",
          "Take the W6 ladder: in-process rungs, served ones against a floor in C, and what a request allocates",
          cats([
            served_flags(),
            [
              sections_flag(ladder::sections(), "in-process,served,alloc"),
              opt(
                "db",
                "The database the postgres stacks are served over, holding the desk's schema; without it their rungs are not taken",
              ),
              cmdline::with_default(
                cmdline::valued(
                  "accept",
                  "LOOP",
                  cmdline::Choice(["sequential", "task-per-connection"]),
                  "The loop the desk accepts connections with",
                ),
                "sequential",
              ),
              counts(
                "concurrency",
                "1,2,4,8,16,32",
                "Clients each served point is loaded with; the ladder is read at the number the total peaks at",
              ),
              pos(
                "per-conn",
                32,
                "Requests one connection carries, served and in the in-process connection rung",
