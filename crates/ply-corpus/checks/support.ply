// What a check reads a report with: a row by name, its numbers, and the words a failure is shown in,
// so a check that fails says what the run saw. Every check runs from the repository's root, bound as
// both the `work` root and the `repo` one, and keeps what it makes in a directory of its own.

import corpus.cmd
import corpus.kit
import corpus.report
import corpus.report (Report, Judged, Measurement, Criterion, Inconclusive)
import corpus.serve
import std.json (Json, Member)
import std.json
import std.list

pub fn scratch(name: String) -> String = "target/corpus-checks/" ++ name

pub fn cats<a>(xss: List<List<a>>) -> List<a> =
  fold(xss, [], |acc: List<a>, xs: List<a>| fold(xs, acc, |inner: List<a>, x: a| push(inner, x)))

pub fn joined(parts: List<String>, sep: String) -> String =
  fold(parts, "", |acc: String, p: String| if acc == "" { p } else { acc ++ sep ++ p })

pub fn shown(r: Report) -> String = json::to_string(report::to_json(r))

// A line the check wrote that did not ask for the subcommand the check runs.
pub fn refused<a>(line: cmd::Asked) -> a =
  match line {
    cmd::Refusal(why) -> panic("the line was refused: " ++ why),
    _ -> panic("the line asked for another subcommand"),
  }

pub fn reported(what: String, r: Result<Report, String>) -> Report =
  match r { Ok(x) -> x, Err(why) -> panic("`" ++ what ++ "` refused: " ++ why) }

pub fn named(r: Report, name: String) -> Judged =
  match filter(r.rows, |j: Judged| j.row.name == name) {
    [j] -> j,
    [] -> panic("the report has no `" ++ name ++ "` row: " ++ shown(r)),
    _ -> panic("the report has more than one `" ++ name ++ "` row: " ++ shown(r)),
  }

pub fn starting(r: Report, prefix: String) -> List<Judged> =
  filter(r.rows, |j: Judged| string_starts_with(j.row.name, prefix))

pub fn one_starting(r: Report, prefix: String) -> Judged =
  match starting(r, prefix) {
    [j] -> j,
    found ->
      panic(
        int_to_string(len(found)) ++ " rows are named from `" ++ prefix ++ "`, not one: "
          ++ shown(r),
      ),
  }

pub fn measured(j: Judged) -> List<Measurement> = match j.row.taken { Ok(ms) -> ms, Err(_) -> [] }

pub fn value(j: Judged, name: String) -> Decimal =
  match report::value_of(measured(j), name) {
    Some(v) -> v,
    None ->
      panic("`" ++ j.row.name ++ "` measured no `" ++ name ++ "`: " ++ report::judged_text(j)),
  }

pub fn criterion_of(j: Judged) -> String = report::criterion_text(j.row.criterion, measured(j))

pub fn passes(j: Judged) -> Unit = assert(report::passed(j), Some(report::judged_text(j)))

pub fn why_inconclusive(j: Judged) -> Option<String> =
  match j.verdict { Inconclusive(why) -> Some(why), _ -> None }

pub fn all_pass(r: Report) -> Unit = {
  let failing = filter(r.rows, |j: Judged| !report::passed(j));
  assert(len(failing) == 0, Some(joined(map(failing, report::judged_text), "\n")))
}

pub fn context(r: Report, key: String) -> Json =
  match filter(r.context, |m: Member| m.key == key) {
    [m, ..] -> m.value,
    [] -> panic("the report carries no `" ++ key ++ "`: " ++ shown(r)),
  }

// A row whose criterion is about correctness, which holds whatever the machine: every request
// answered, the floor answering the desk's bytes, and a server stopping on its signal. A rate on a
// shared runner is a reading, not a verdict a check can own.
pub fn correctness(j: Judged) -> Bool =
  list::contains(
    map([kit::complete(200), serve::agreement(), kit::drained(), kit::ended()], |c: Criterion|
      report::criterion_text(c, [])),
    criterion_of(j),
  )

// The rows about correctness, of which there is at least one, each passing.
pub fn correct(r: Report) -> Unit = {
  let checked = filter(r.rows, correctness);
  assert(len(checked) > 0, Some("no row's criterion is about correctness: " ++ shown(r)));
  let failing = filter(checked, |j: Judged| !report::passed(j));
  assert(len(failing) == 0, Some(joined(map(failing, report::judged_text), "\n")))
}
