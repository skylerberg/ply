import std.pkg (Manifest)

// The corpus's checks: its subcommands run end to end over the real toolchain, each spawning the
// `ply` a run binds with `--exec ply=PATH`. Every check spawns `ply`, so one run takes them one after
// another; they are a package of their own beside the program, a module a CI runner, so CI runs the
// modules side by side and the program's own tests stay a hermetic run.
fn package() -> Manifest = {
  name: "checks",
  version: { major: 0, minor: 1, patch: 0 },
  prefix: None,
  runtime: { major: 0, minor: 16, patch: 0 },
  dependencies: [
    {
      name: "corpus",
      prefix: None,
      min: { major: 0, minor: 1, patch: 0 },
      source: Path("../ply"),
    },
  ],
  entry: None,
}
