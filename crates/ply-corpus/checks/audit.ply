// The statistical gate on the prover's tiers, as `tiers` runs it, one seed a check: the seed's corpus
// generated, discharged by the prover the run lends, and every proof it made re-drawn at a thousand
// cases from eight roots. A seed's row is the whole gate for its corpus, so every seed passing is the
// audit passing.

import support
import support (scratch, shown, refused, reported, named, context)
import corpus.cmd
import corpus.report
import corpus.tiers
import std.json (Number)

fn audited(seed: Int) -> Unit = {
  let n = int_to_string(seed);
  let r = match cmd::asked(["tiers", "--out", scratch("audit"), "--seed", n]) {
    cmd::Tiers(t) -> reported("tiers --seed " ++ n, tiers::run(t.args)),
    other -> refused(other),
  };
  assert(
    context(r, "seeds") == Number(6m),
    Some("the checks here are every seed the audit takes, one each: " ++ shown(r)),
  );
  assert(len(r.rows) == 1, Some("only the seed asked for is audited: " ++ shown(r)));
  let audit = named(r, "seed " ++ n);
  assert(
    report::passed(audit),
    Some(
      "seed " ++ n
        ++ ": a proof a sampled run contradicts is a defect in Ply, and a corpus short of its share of proofs is no gate: "
        ++ report::judged_text(audit),
    ),
  )
}

test/nondet "every proof of seed 1 survives a wide sample" { audited(1) }

test/nondet "every proof of seed 2 survives a wide sample" { audited(2) }

test/nondet "every proof of seed 3 survives a wide sample" { audited(3) }

test/nondet "every proof of seed 4 survives a wide sample" { audited(4) }

test/nondet "every proof of seed 5 survives a wide sample" { audited(5) }

test/nondet "every proof of seed 6 survives a wide sample" { audited(6) }
