// `w4`, `w5` and `w6-ladder` over the postgres a run names with `--set CORPUS_DB=URL`, whose database
// holds the desk's schema (`examples/desk.sql`). A check told a database is there fails when a row that
// needs one was not taken, rather than going inconclusive; the same subcommands with no database are
// `serving`'s.

import support
import support (scratch, cats, joined, shown, refused, reported, starting, all_pass, correct)
import corpus.cmd
import corpus.ladder
import corpus.report
import corpus.report (Report, Judged)
import corpus.w4
import corpus.w5
import std.config (config)
import std.db
import std.db (db, stmt, PText, Rows, CText, Failed, ReadCommitted, ReadOnly)

fn database() -> String / {config.get[env], abort.raise} =
  match config.get[env]("CORPUS_DB") {
    Some(url) -> url,
    None ->
      panic(
        "the database checks read their database from `CORPUS_DB`: run them with `--set CORPUS_DB=postgres://…` naming one that holds the desk's schema",
      ),
  }

// Every row measured something: none was left for want of a database, a floor or a server.
fn all_taken(r: Report) -> Unit / {abort.raise} = {
  let untaken = filter(r.rows, |j: Judged| len(support::measured(j)) == 0);
  assert(len(untaken) == 0, Some(joined(map(untaken, report::judged_text), "\n")))
}

fn over_database(
  name: String,
  line: List<String>,
) -> List<String> / {config.get[env], abort.raise} =
  cats([line, ["--db", database(), "--scratch", scratch(name)]])

test/nondet "every statement and every served point of the database bench is answered over postgres" {
  let r = match cmd::asked(
      over_database("database-statements", [
        "w4",
        "--concurrency",
        "2",
        "--operations",
        "8",
        "--rows",
        "4",
        "--pool-sizes",
        "1",
        "--load-concurrency",
        "2",
        "--per-conn",
        "2",
        "--requests-per-point",
        "8",
        "--repeats",
        "1",
      ]),
    ) {
    cmd::W4(a) -> reported("w4", w4::run(a.args)),
    other -> refused(other),
  };
  all_taken(r);
  all_pass(r)
}

test/nondet "the trace sinks and the transaction at the drain deadline hold over postgres" {
  let r = match cmd::asked(
      over_database("database-lifecycle", [
        "w5",
        "--sections",
        "sinks,transaction",
        "--drain-ms",
        "2000",
        "--concurrency",
        "1",
        "--per-conn",
        "2",
        "--requests-per-point",
        "4",
        "--repeats",
        "1",
      ]),
    ) {
    cmd::W5(a) -> reported("w5", w5::run(a.args)),
    other -> refused(other),
  };
  all_taken(r);
  all_pass(r)
}

// Every rung postgres carries is taken, and every point it serves is answered; how the rungs compare
// is a reading of the runner, not a verdict a check can own.
test/nondet "the ladder's postgres rungs are taken, and every point it serves is answered" {
  let r = match cmd::asked(
      over_database("database-ladder", [
        "w6-ladder",
        "--sections",
        "in-process,served",
        "--repeats",
        "1",
        "--served-repeats",
        "1",
        "--concurrency",
        "1,2",
        "--per-conn",
        "4",
        "--requests-per-point",
        "8",
      ]),
    ) {
    cmd::W6Ladder(a) -> reported("w6-ladder", ladder::run(a.args)),
    other -> refused(other),
  };
  all_taken(r);
  correct(r);
  let _ = map(
    [
      "postgres in plaintext, /items",
      "postgres over TLS, /items",
      "postgres over TLS, --trace json, /items",
    ],
    |prefix: String|
      assert(
        len(starting(r, prefix)) > 0,
        Some("no `" ++ prefix ++ "` point was served: " ++ shown(r)),
      ),
  );
  ()
}

fn name_of(sku: String) -> String / {db.query[items]} =
  match db.query[items](stmt("select name from items where sku = $1"), [PText(sku)]) {
    Rows([r]) -> match map_get(r, "name") { Some(CText(n)) -> n, _ -> "?" },
    Rows([]) -> "-",
    Rows(_) -> "more than one",
    Failed(e) -> "failed " ++ e.code,
    _ -> "a count",
  }

// What reaches the server, counted on its way there.
fn counting<a>(
  go: () -> a / {db.query[items], db.batch[items], abort.raise},
) -> { value: a, statements: Int } / {db.query[items], db.batch[items], abort.raise} =
  with_cell[sent](0) { n -> {
    let value = handle {
      go()
    } with {
      db.query[items](s, ps) -> {
        cell_set(n, cell_get(n) + 1);
        db.query[items](s, ps)
      },
      db.batch[items](s, each) -> {
        cell_set(n, cell_get(n) + 1);
        db.batch[items](s, each)
      },
    };
    { value: value, statements: cell_get(n) }
  } }

test/nondet "a lookup batched over the desk's items is one statement, and answers what one query each would" {
  let skus = ["bolt", "gasket", "widget", "nope", "bolt", "gasket"];
  match db::with_server(database(), 2, || {
      let alone = map(skus, name_of);
      let together = counting(|| db::batched[items](skus, name_of));
      let inside = db::transaction(ReadCommitted, ReadOnly, || db::batched[items](skus, name_of));
      { alone: alone, together: together, inside: inside }
    }) {
    Err(why) -> panic(why),
    Ok(r) -> {
      assert_eq(r.alone, [
        "hex bolt",
        "copper gasket",
        "left-handed widget",
        "-",
        "hex bolt",
        "copper gasket",
      ]);
      assert_eq(r.together.value, r.alone);
      assert_eq(r.together.statements, 1);
      assert_eq(match r.inside { Ok(names) -> names, Err(_) -> [] }, r.alone)
    },
  }
}
