//! The served subcommands with no database, the way `benches/corpus.sh` runs them: the desk and the C
//! floor started as children, found by the port each says it listens on, loaded by the corpus's client
//! and stopped. The desk serves its twin, and a row that needs postgres is inconclusive and says so.
//! Only the rows whose criterion is about correctness are asserted, and what a request allocates,
//! which is a count.

import support
import support (scratch, cats, shown, refused, reported, named, starting, one_starting, value,
                passes, why_inconclusive, correct)
import corpus.cmd
import corpus.take_ladder
import corpus.report
import corpus.report (Report, Judged)
import corpus.serve
import corpus.request_path
import corpus.statements
import corpus.operating

test/nondet "the socket bench serves the desk and its floor" {
  let s = scratch("socket");
  let served = match cmd::asked([
      "serve",
      "--scratch",
      s,
      "--sections",
      "layers,scans,load",
      "--requests",
      "8",
      "--concurrency",
      "2",
      "--repeats",
      "1",
      "--iterations",
      "20",
    ]) {
    cmd::Serve(a) -> reported("serve", serve::run(a.args)),
    other -> refused(other),
  };
  correct(served);
  assert(
    len(starting(served, "layer handled")) == 1,
    Some("the layers table has its whole-request rung: " ++ shown(served)),
  );
  assert(
    len(starting(served, "scans, 0 filler field(s)")) > 0,
    Some("the scans table has its first head: " ++ shown(served)),
  );
  let _ = map(
    [
      "desk, one connection at a time, 1 client",
      "desk, a task per connection, 2 clients",
      "floor, one connection at a time, 1 client",
      "floor, a thread per connection, 2 clients",
    ],
    |prefix: String| {
      let point = one_starting(served, prefix);
      assert(
        value(point, "asked") == 8m && value(point, "answered") == 8m,
        Some(report::judged_text(point)),
      )
    },
  );
  let keep_alive = match cmd::asked([
      "request-path",
      "--scratch",
      s,
      "--sections",
      "keep-alive,tls",
      "--accept",
      "task-per-connection",
      "--ladder-requests",
      "8",
      "--ladder-concurrency",
      "2",
      "--repeats",
      "1",
    ]) {
    cmd::RequestPath(a) -> reported("request-path", request_path::run(a.args)),
    other -> refused(other),
  };
  correct(keep_alive);
  let _ = map(["1 request a connection", "100 requests a connection"], |prefix: String|
    one_starting(keep_alive, prefix));
  let secured = starting(keep_alive, "TLS, ");
  assert(len(secured) == 6, Some("three ladders at two client counts: " ++ shown(keep_alive)));
  let _ = map(secured, |judged: Judged|
    assert(
      value(judged, "handshakes") > 0m,
      Some("a TLS row times its handshakes: " ++ report::judged_text(judged)),
    ));
  ()
}

/// Each row named passes, and every other row is one that needs a database and says to name one.
fn passed_or_waiting_for_a_database(r: Report, passing: List<String>) -> Unit / {abort.raise} = {
  let _ = map(passing, |prefix: String| passes(one_starting(r, prefix)));
  let waiting = filter(r.rows, |judged: Judged| !report::passed(judged));
  assert(len(waiting) > 0, Some("no row waits for a database: " ++ shown(r)));
  let _ = map(waiting, |judged: Judged|
    assert(
      match why_inconclusive(judged) { Some(why) -> string_contains(why, "--db"), None -> false },
      Some(report::judged_text(judged)),
    ));
  ()
}

// The statements over the twin, the desk over the twin, and the lines `crud` runs the desk with —
// the one over postgres too, which `ply hosts` takes with no server behind it.
test/nondet "the database bench takes what needs no database and names what does" {
  let r = match cmd::asked([
      "statements",
      "--scratch",
      scratch("statements"),
      "--concurrency",
      "2",
      "--operations",
      "8",
      "--rows",
      "4",
      "--pool-sizes",
      "1",
      "--load-concurrency",
      "2",
      "--per-conn",
      "2",
      "--requests-per-point",
      "8",
      "--repeats",
      "1",
    ]) {
    cmd::Statements(a) -> reported("statements", statements::run(a.args)),
    other -> refused(other),
  };
  passed_or_waiting_for_a_database(r, [
    "the desk lines `crud` runs",
    "ops, select, twin",
    "ops, select $1, twin",
    "ops, insert, twin",
    "ops, transaction, twin",
    "sizes, 4 rows, twin",
    "crud, twin, GET /health, 2 clients",
    "crud, twin, GET /items, 2 clients",
    "crud, twin, GET /orders/1, 2 clients",
    "the desk over the twin, stops",
  ])
}

/// `operating` over `sections` with the bench's small sizes, under the scratch directory `name`.
fn operating_line(name: String, sections: String) -> List<String> =
  [
    "operating",
    "--scratch",
    scratch(name),
    "--sections",
    sections,
    "--in-flight",
    "1,4",
    "--drain-ms",
    "2000",
    "--hold-ms",
    "300",
    "--concurrency",
    "1",
    "--per-conn",
    "2",
    "--requests-per-point",
    "4",
    "--repeats",
    "1",
  ]

// A drain that completes, one that runs out and one with a lead, over the twin; the trace sinks and
// the transaction at the deadline need postgres, and say so.
test/nondet "the lifecycle bench drains, and names what needs a database" {
  let r = match cmd::asked(operating_line("lifecycle", "sinks,drain,transaction")) {
    cmd::Operating(a) -> reported("operating", operating::run(a.args)),
    other -> refused(other),
  };
  passed_or_waiting_for_a_database(r, [
    "the desk lines `operating` runs",
    "drain, 1 request held 300ms",
    "drain, 4 requests held 300ms",
    "drain, 4 requests held past the drain",
    "drain, 1 request, a 1500ms lead",
  ])
}

// A deploy read off `ply replace` and `ply build --diff`, which needs no database.
test/nondet "the lifecycle bench deploys one edit, built alike from two roots" {
  let r = match cmd::asked(operating_line("deploy", "deploy")) {
    cmd::Operating(a) -> reported("operating", operating::run(a.args)),
    other -> refused(other),
  };
  let _ = map(operating::deploy_names(), |name: String| passes(one_starting(r, name)));
  assert_eq(len(r.rows), len(operating::deploy_names()))
}

// The in-process rungs taken, the twin and the floor served, the rungs postgres would carry saying why
// they are not, and the desk as it is written counted over two served windows and held to the figure
// `benches/ladder-alloc.json` ships.
test/nondet "the ladder serves the desk and holds the shipped allocation figure" {
  let r = match cmd::asked([
      "take-ladder",
      "--scratch",
      scratch("ladder"),
      "--repeats",
      "1",
      "--served-repeats",
      "1",
      "--concurrency",
      "1,2",
      "--per-conn",
      "4",
      "--requests-per-point",
      "8",
    ]) {
    cmd::TakeLadder(a) -> reported("take-ladder", take_ladder::run(a.args)),
    other -> refused(other),
  };
  correct(r);
  let _ = map(["call", "endpoint", "framing", "routing", "machine"], |layer: String| {
    let rung = named(r, "layer " ++ layer);
    assert(
      value(rung, "with") > 0m,
      Some("the in-process `" ++ layer ++ "` rung was timed: " ++ report::judged_text(rung)),
    )
  });
  let _ = map(
    [
      "the twin in plaintext, /health, 1 client",
      "the twin in plaintext, /health, 2 clients",
      "the floor, one connection at a time, /health, 2 clients",
    ],
    |prefix: String| {
      let point = one_starting(r, prefix);
      assert(value(point, "answered") == value(point, "asked"), Some(report::judged_text(point)))
    },
  );
  let _ = map(
    ["layer socket", "layer tls", "layer database", "layer tracing", "total", "residue", "share"],
    |name: String| {
      let j = named(r, name);
      assert(
        match why_inconclusive(j) {
          Some(why) -> string_contains(why, "no database"),
          None -> false,
        },
        Some("a rung postgres would carry says why it was not taken: " ++ report::judged_text(j)),
      )
    },
  );
  let allocations = named(r, "allocations, one /health request");
  assert(
    report::passed(allocations),
    Some(
      "the request path allocates more than `benches/ladder-alloc.json` ships, or the figure is not one this tree takes. Lower it, or re-take it: `benches/corpus.sh take-ladder --sections alloc --out benches`, or `.github/workflows/bench.yml`. "
        ++ report::judged_text(allocations),
    ),
  )
}
