type Named = { zone: String, reading: String, names: Resolution }

/// The instant a clock that stands `east` seconds east of UTC reads `reading` at.
fn read_at(reading: String, east: Int) -> Instant / {abort.raise} = {
  let read = the_reading(reading);
  option_expect(
    instant_at(date::unix_seconds(date::utc(read)) - east, date::nanosecond(date::time_of(read))),
    reading,
  )
}

/// A reading the zone's clocks show once, standing `east` seconds east of UTC.
fn once(zone: String, reading: String, east: Int) -> Named / {abort.raise} =
  { zone: zone, reading: reading, names: Unique(read_at(reading, east)) }

/// A reading a change skips: the offset after the change, and the one before it.
fn skipped(zone: String, reading: String, after: Int, before: Int) -> Named / {abort.raise} =
  {
    zone: zone,
    reading: reading,
    names: Gap({ before: read_at(reading, after), after: read_at(reading, before) }),
  }

/// A reading a change repeats: the offset before the change, and the one after it.
fn twice(zone: String, reading: String, before: Int, after: Int) -> Named / {abort.raise} =
  {
    zone: zone,
    reading: reading,
    names: Overlap({ earlier: read_at(reading, before), later: read_at(reading, after) }),
  }

fn named_readings() -> List<Named> / {abort.raise} =
  [
    once("Europe/Paris", "2026-03-29T01:59:59.999999999", 3600),
    skipped("Europe/Paris", "2026-03-29T02:00:00", 7200, 3600),
    skipped("Europe/Paris", "2026-03-29T02:30:00", 7200, 3600),
    skipped("Europe/Paris", "2026-03-29T02:59:59.999999999", 7200, 3600),
    once("Europe/Paris", "2026-03-29T03:00:00", 7200),
    once("Europe/Paris", "2026-10-25T01:59:59.999999999", 7200),
    twice("Europe/Paris", "2026-10-25T02:00:00", 7200, 3600),
    twice("Europe/Paris", "2026-10-25T02:30:00.5", 7200, 3600),
    twice("Europe/Paris", "2026-10-25T02:59:59.999999999", 7200, 3600),
    once("Europe/Paris", "2026-10-25T03:00:00", 3600),
    skipped("America/New_York", "2026-03-08T02:30:00", -14400, -18000),
    twice("America/New_York", "2026-11-01T01:30:00", -14400, -18000),
    skipped("Pacific/Apia", "2011-12-30T12:00:00", 50400, -36000),
    once("Pacific/Apia", "2011-12-29T23:59:59", -36000),
    once("Pacific/Apia", "2011-12-31T00:00:00", 50400),
    skipped("Australia/Lord_Howe", "2026-10-04T02:15:00", 39600, 37800),
    twice("Australia/Lord_Howe", "2026-04-05T01:45:00", 39600, 37800),
    twice("America/St_Johns", "2006-10-29T00:00:30", -9000, -12600),
    skipped("America/St_Johns", "2006-04-02T00:30:00", -9000, -12600),
    skipped("Europe/Dublin", "2026-03-29T01:30:00", 3600, 0),
    twice("Europe/Dublin", "2026-10-25T01:30:00", 3600, 0),
    twice("Africa/Casablanca", "2026-02-15T02:30:00", 3600, 0),
    skipped("Africa/Casablanca", "2026-03-22T02:30:00", 3600, 0),
    twice("Asia/Pyongyang", "2015-08-14T23:45:00", 32400, 30600),
    skipped("Asia/Pyongyang", "2018-05-04T23:45:00", 32400, 30600),
    skipped("Europe/Moscow", "2011-03-27T02:30:00", 14400, 10800),
    twice("Europe/Moscow", "2014-10-26T01:30:00", 14400, 10800),
    skipped("America/Sao_Paulo", "2018-11-04T00:30:00", -7200, -10800),
    once("America/Sao_Paulo", "2019-11-03T00:30:00", -10800),
    skipped("Asia/Manila", "1844-12-31T12:00:00", 29032, -57368),
    twice("America/Juneau", "1867-10-18T20:00:00", 54139, -32261),
    once("Europe/Paris", "1700-06-01T12:00:00", 561),
    skipped("Europe/Paris", "2262-03-30T02:30:00", 7200, 3600),
    once("Asia/Tokyo", "2200-01-01T00:00:00", 32400),
  ]

test "what {c.reading} names in {c.zone}" for c: Named in named_readings() {
  assert_eq(resolve(the_zone(c.zone), the_reading(c.reading)), Some(c.names))
}

test "a policy chooses an instant of what a reading names" {
  let paris = the_zone("Europe/Paris");
  let noon = option_expect(resolve(paris, the_reading("2026-06-01T12:00:00")), "noon");
  let skipped = option_expect(resolve(paris, the_reading("2026-03-29T02:30:00")), "a gap");
  let twice = option_expect(resolve(paris, the_reading("2026-10-25T02:30:00")), "an overlap");
  let at = the_instant("2026-06-01T10:00:00Z");
  assert_eq([earlier(noon), later(noon), compatible(noon)], [at, at, at]);
  assert_eq(unique(noon), Some(at));
  assert_eq(earlier(skipped), the_instant("2026-03-29T00:30:00Z"));
  assert_eq(later(skipped), the_instant("2026-03-29T01:30:00Z"));
  assert_eq(compatible(skipped), the_instant("2026-03-29T01:30:00Z"));
  assert_eq(unique(skipped), None);
  assert_eq(local(paris, earlier(skipped)), the_reading("2026-03-29T01:30:00"));
  assert_eq(local(paris, later(skipped)), the_reading("2026-03-29T03:30:00"));
  assert_eq(earlier(twice), the_instant("2026-10-25T00:30:00Z"));
  assert_eq(later(twice), the_instant("2026-10-25T01:30:00Z"));
  assert_eq(compatible(twice), the_instant("2026-10-25T00:30:00Z"));
  assert_eq(unique(twice), None);
  assert_eq(offset_at(paris, earlier(twice)).abbreviation, "CEST");
  assert_eq(offset_at(paris, later(twice)).abbreviation, "CET")
}

test "a reading whose instant an `Instant` does not hold names nothing" {
  let paris = the_zone("Europe/Paris");
  assert_eq(
    resolve(paris, the_reading("2262-04-12T01:47:16")),
    Some(Unique(Instant(9223372036000000000))),
  );
  assert_eq(resolve(paris, the_reading("2262-04-12T01:47:17")), None);
  assert_eq(resolve(paris, the_reading("2300-01-01T00:00:00")), None);
  assert_eq(resolve(paris, the_reading("1500-01-01T00:00:00")), None);
  assert_eq(
    resolve(utc(), the_reading("1677-09-21T00:12:43.145224192")),
    Some(Unique(Instant(0 - 9223372036854775807 - 1))),
  );
  assert_eq(resolve(utc(), the_reading("1677-09-21T00:12:43.145224191")), None);
  assert_eq(
    resolve(utc(), the_reading("2262-04-11T23:47:16.854775807")),
    Some(Unique(Instant(9223372036854775807))),
  );
  assert_eq(resolve(utc(), the_reading("9999-12-31T23:59:59")), None);
  assert_eq(resolve(utc(), the_reading("0000-01-01T00:00:00")), None)
}

test "a calendar day and twenty-four hours part at a change of the clocks" {
  let paris = the_zone("Europe/Paris");
  let before = the_instant("2026-03-28T11:00:00Z");
  assert_eq(local(paris, before), the_reading("2026-03-28T12:00:00"));
  let a_day_on = option_expect(add(paris, before, date::days(1), date::Clamp), "a day on");
  assert_eq(a_day_on, Unique(the_instant("2026-03-29T10:00:00Z")));
  assert_eq(local(paris, earlier(a_day_on)), the_reading("2026-03-29T12:00:00"));
  let hours_on = time::after(before, time::hours(24));
  assert_eq(local(paris, hours_on), the_reading("2026-03-29T13:00:00"));
  assert_eq(time::as_nanos(time::between(before, earlier(a_day_on))), 23 * 3600000000000);
  let autumn = the_instant("2026-10-24T10:00:00Z");
  assert_eq(
    option_map(add(paris, autumn, date::days(1), date::Clamp), earlier),
    Some(the_instant("2026-10-25T11:00:00Z")),
  );
  assert_eq(
    option_map(
      add(paris, the_instant("2026-01-31T11:00:00Z"), date::months(1), date::Clamp),
      |found: Resolution| local(paris, earlier(found)),
    ),
    Some(the_reading("2026-02-28T12:00:00")),
  );
  assert_eq(add(paris, the_instant("2026-01-31T11:00:00Z"), date::months(1), date::Reject), None);
  assert_eq(add(paris, before, date::years(300), date::Clamp), None)
}

test "a day added to a reading may land in a gap or an overlap, and says so" {
  let paris = the_zone("Europe/Paris");
  let night = the_instant("2026-03-28T01:30:00Z");
  assert_eq(local(paris, night), the_reading("2026-03-28T02:30:00"));
  assert_eq(
    add(paris, night, date::days(1), date::Clamp),
    Some(
      Gap({
        before: the_instant("2026-03-29T00:30:00Z"),
        after: the_instant("2026-03-29T01:30:00Z"),
      }),
    ),
  );
  assert_eq(
    add(paris, the_instant("2026-10-24T00:30:00Z"), date::days(1), date::Clamp),
    Some(
      Overlap({
        earlier: the_instant("2026-10-25T00:30:00Z"),
        later: the_instant("2026-10-25T01:30:00Z"),
      }),
    ),
  )
}

test "a schedule kept by its first reading comes back to it after a gap" {
  let paris = the_zone("Europe/Paris");
  let first = the_instant("2026-03-27T01:30:00Z");
  let nights = map(range(0, 4), |n: Int|
    match add(paris, first, date::days(n), date::Clamp) {
      Some(found) -> date::date_time_text(local(paris, compatible(found))),
      None -> "",
    });
  assert_eq(nights, [
    "2026-03-27T02:30:00",
    "2026-03-28T02:30:00",
    "2026-03-29T03:30:00",
    "2026-03-30T02:30:00",
  ])
}

test "the changes of a zone's clocks are found from either side" {
  let paris = the_zone("Europe/Paris");
  let winter: Offset = { seconds: 3600, abbreviation: "CET", daylight: false };
  let summer: Offset = { seconds: 7200, abbreviation: "CEST", daylight: true };
  let spring = the_instant("2026-03-29T01:00:00Z");
  let autumn = the_instant("2025-10-26T01:00:00Z");
  assert_eq(
    next_transition(paris, the_instant("2026-01-01T00:00:00Z")),
    Some({ at: spring, before: winter, after: summer }),
  );
  assert_eq(
    previous_transition(paris, the_instant("2026-01-01T00:00:00Z")),
    Some({ at: autumn, before: summer, after: winter }),
  );
  assert_eq(
    option_map(previous_transition(paris, spring), |change: Transition| change.at),
    Some(spring),
  );
  assert_eq(
    option_map(next_transition(paris, spring), |change: Transition| change.at),
    Some(the_instant("2026-10-25T01:00:00Z")),
  );
  assert_eq(
    option_map(next_transition(paris, Instant(spring_nanos() - 1)), |change: Transition| change.at),
    Some(spring),
  );
  assert_eq(previous_transition(paris, the_instant("1800-01-01T00:00:00Z")), None);
  assert_eq(
    next_transition(paris, the_instant("1800-01-01T00:00:00Z")),
    Some({
      at: the_instant("1891-03-15T23:50:39Z"),
      before: { seconds: 561, abbreviation: "LMT", daylight: false },
      after: { seconds: 561, abbreviation: "PMT", daylight: false },
    }),
  );
  assert_eq(next_transition(paris, the_instant("2262-04-01T00:00:00Z")), None);
  assert_eq(
    option_map(previous_transition(paris, Instant(9223372036854775807)), |change: Transition|
      change.at),
    Some(the_instant("2262-03-30T01:00:00Z")),
  );
  assert_eq(next_transition(the_zone("Asia/Tokyo"), the_instant("2026-01-01T00:00:00Z")), None)
}

fn spring_nanos() -> Int / {abort.raise} =
  match the_instant("2026-03-29T01:00:00Z") { Instant(n) -> n }

test "an instant is written with its zone as RFC 9557 does, at an offset of whole minutes" {
  let paris = the_zone("Europe/Paris");
  let at = the_instant("2026-10-25T00:30:00Z");
  assert_eq(date::rfc3339(of_instant(paris, at)), "2026-10-25T02:30:00+02:00");
  assert_eq(date::rfc9557(extended(paris, at)), "2026-10-25T02:30:00+02:00[Europe/Paris]");
  assert_eq(
    date::rfc9557(extended(the_zone("US/Eastern"), at)),
    "2026-10-24T20:30:00-04:00[America/New_York]",
  );
  assert_eq(
    date::rfc9557(extended(option_expect(fixed(31500), "eight and three quarters"), at)),
    "2026-10-25T09:15:00+08:45[+08:45]",
  );
  let long_ago = the_instant("1890-01-01T12:00:00Z");
  assert_eq(local(paris, long_ago), the_reading("1890-01-01T12:09:21"));
  assert_eq(date::rfc3339(of_instant(paris, long_ago)), "1890-01-01T12:09:00+00:09");
  assert_eq(
    date::rfc3339(of_instant(the_zone("Africa/Monrovia"), the_instant("1960-01-01T12:00:00Z"))),
    "1960-01-01T11:15:00-00:45",
  )
}

/// A `tzdata.zi` of one zone that uses each form a rule and a zone line take.
fn sample() -> Bytes =
  bytes_of_string(
    \\# version sample
    \\R X 1990 1995 - Mar lastSu 2 1 S
    \\R X 1990 1995 - O lastSu 3 0 -
    \\R X 1996 ma - Ap Su>=1 1u 1 S
    \\R X 1996 ma - S Sa<=30 24 0 -
    \\R Y 2000 o - Jun 15 25 0:30 H
    \\R Y 2000 o - Jul 1 0s 0 -
    \\R N 2005 ma - O lastSu 1 0 IST
    \\R N 2005 ma - Mar lastSu 1 -1 GMT
    \\Z Sample/Rules 1:30:15 - LMT 1990
    \\1 X C%sT 2000
    \\2 Y %z 2001
    \\2 1 EEST 2002 Mar 3 4:15u
    \\-3 - A/B 2003 O Su>=8 2s
    \\-3 -1 A/B 2004
    \\1 N %s
    \\Z Sample/Fixed -9:30 - %z
    \\L Sample/Rules Sample/Link
    \\
  )

fn roomy() -> Limits = { transitions: 4096 }

/// The sample's changes to 1991, of 1995 and 1996 and from mid 2000 to 2005, as `zic` and `zdump`
/// make them of the same text.
fn sampled() -> List<Sight> =
  [
    seen("Sample/Rules", "1989-12-31T22:29:45Z", "1989-12-31T23:29:45", 3600, "CT", false),
    seen("Sample/Rules", "1990-03-25T01:00:00Z", "1990-03-25T03:00:00", 7200, "CST", true),
    seen("Sample/Rules", "1990-10-28T01:00:00Z", "1990-10-28T02:00:00", 3600, "CT", false),
    seen("Sample/Rules", "1995-03-26T01:00:00Z", "1995-03-26T03:00:00", 7200, "CST", true),
    seen("Sample/Rules", "1995-10-29T01:00:00Z", "1995-10-29T02:00:00", 3600, "CT", false),
    seen("Sample/Rules", "1996-04-07T01:00:00Z", "1996-04-07T03:00:00", 7200, "CST", true),
    seen("Sample/Rules", "1996-09-28T22:00:00Z", "1996-09-28T23:00:00", 3600, "CT", false),
    seen("Sample/Rules", "1999-09-25T22:00:00Z", "1999-09-25T23:00:00", 3600, "CT", false),
    seen("Sample/Rules", "1999-12-31T23:00:00Z", "2000-01-01T01:00:00", 7200, "+02", false),
    seen("Sample/Rules", "2000-06-15T23:00:00Z", "2000-06-16T01:30:00", 9000, "+0230", true),
    seen("Sample/Rules", "2000-06-30T22:00:00Z", "2000-07-01T00:00:00", 7200, "+02", false),
    seen("Sample/Rules", "2000-12-31T22:00:00Z", "2001-01-01T01:00:00", 10800, "EEST", true),
    seen("Sample/Rules", "2002-03-03T04:15:00Z", "2002-03-03T01:15:00", -10800, "A", false),
    seen("Sample/Rules", "2003-10-12T05:00:00Z", "2003-10-12T01:00:00", -14400, "B", true),
    seen("Sample/Rules", "2004-01-01T04:00:00Z", "2004-01-01T05:00:00", 3600, "IST", false),
    seen("Sample/Rules", "2005-03-27T00:00:00Z", "2005-03-27T00:00:00", 0, "GMT", true),
    seen("Sample/Rules", "2005-10-30T01:00:00Z", "2005-10-30T02:00:00", 3600, "IST", false),
    seen("Sample/Rules", "1800-01-01T00:00:00Z", "1800-01-01T01:30:15", 5415, "LMT", false),
    seen("Sample/Rules", "2262-01-01T00:00:00Z", "2262-01-01T01:00:00", 3600, "IST", false),
    seen("Sample/Fixed", "1970-01-01T00:00:00Z", "1969-12-31T14:30:00", -34200, "-0930", false),
  ]

test "supplied data's {c.zone} reads {c.reads} {c.abbreviation} at {c.at}" for c: Sight in sampled(
  ) {
  match try { zone_in(sample(), c.zone, roomy()) } {
    Ok(z) -> sighted(z, c),
    Err(refused) -> panic(refusal_message(refused)),
  }
}

test "a zone of supplied data is named, linked and versioned by that data" {
  assert_eq(version_in(sample()), "sample");
  assert_eq(version_in(b"Z A 1 - X\n"), "");
  let rules = try { zone_in(sample(), "Sample/Rules", roomy()) };
  assert_eq(result_map(rules, name), Ok("Sample/Rules"));
  assert_eq(try { zone_in(sample(), "Sample/Link", roomy()) }, rules);
  assert_eq(result_map(try { zone_in(sample(), "+01:00", roomy()) }, name), Ok("+01:00"));
  assert_eq(try { zone_in(sample(), "Europe/Paris", roomy()) }, Err({ why: Unknown, at: 0 }));
  assert_eq(try { zone_in(b"", "Europe/Paris", roomy()) }, Err({ why: Unknown, at: 0 }))
}

type Refused = { data: String, why: Why, at: Int }

fn refusals() -> List<Refused> =
  [
    { data: "#\nZ A 1 Nope X\n", why: NoRules, at: 2 },
    { data: "#\nZ A 1 - X 1990\n", why: Malformed, at: 2 },
    { data: "#\nZ A 1 - X\n2 - Y\n", why: Malformed, at: 12 },
    { data: "#\nZ A 1\n", why: Malformed, at: 2 },
    { data: "#\nZ A one - X\n", why: Malformed, at: 2 },
    { data: "#\nZ A 1:60 - X\n", why: Malformed, at: 2 },
    { data: "#\nZ A 1 - X 1990 Foo\n2 - Y\n", why: Malformed, at: 2 },
    { data: "#\nZ A 1 - X 19900\n2 - Y\n", why: Malformed, at: 2 },
    { data: "#\nZ A 1 - X 1990 Mar 32\n2 - Y\n", why: Malformed, at: 2 },
    { data: "#\nZ A 1 - X 1990 Mar lastXy\n2 - Y\n", why: Malformed, at: 2 },
    { data: "#\nZ A 1 - X 1990 Mar 1 2:00q\n2 - Y\n", why: Malformed, at: 2 },
    { data: "#\nR r 2000 ma - Mar lastSu 2 1\nZ A 1 r X\n", why: Malformed, at: 2 },
    { data: "#\nR r 2000 ma - J 1 2 1 S\nZ A 1 r X\n", why: Malformed, at: 2 },
    { data: "#\nR r 2000 1999x - Mar 1 2 1 S\nZ A 1 r X\n", why: Malformed, at: 2 },
    { data: "#\nR r 0 ma - Mar 1 2 1 S\nZ A 1 r X\n", why: Malformed, at: 2 },
    { data: "#\nR r 2000 ma - Mar Su>=x 2 1 S\nZ A 1 r X\n", why: Malformed, at: 2 },
    { data: "#\nZ A 24 - X\n", why: OffsetRange, at: 2 },
    { data: "#\nZ A -23 -1 X\n", why: OffsetRange, at: 2 },
    {
      data: "#\nZ A 1 - LMT 1990\n1 r C%sT\nR r 1995 2000 - Mar 1 0 1 S\n",
      why: NoAbbreviation,
      at: 19,
    },
    {
      data: "#\nR r 1900 ma - Mar 1 2 1 S\nR r 1900 ma - O 1 2 0 -\nZ A 1 r C%sT\n",
      why: TooMany,
      at: 52,
    },
  ]

test "supplied data `{c.data}` is refused: {c.why}" for c: Refused in refusals() {
  assert_eq(
    try { zone_in(bytes_of_string(c.data), "A", { transitions: 100 }) },
    Err({ why: c.why, at: c.at }),
  )
}

test "a refusal says why in a sentence" {
  assert_eq(
    map([Unknown, Malformed, NoRules, NoAbbreviation, OffsetRange, TooMany], |why: Why|
      refusal_message({ why: why, at: 0 })),
    [
      "no zone or link of the database has this name",
      "a line of the data is not one a `tzdata.zi` holds",
      "a zone line names rules the data has none of",
      "nothing settles the abbreviation a zone line starts with",
      "an offset a day or more from UTC",
      "more changes of the zone's clocks than the limit",
    ],
  )
}

test "the generators draw zones of the database and instants beside their changes" {
  let drawn = map(range(0, 40), |i: Int|
    gen::sample(sightings(), 7, bytes_of_string(int_to_string(i)), 30, None).value);
  assert_eq(len(filter(drawn, |s: Option<Sighting>| s == None)), 0);
  assert(
    len(
        filter(drawn, |s: Option<Sighting>|
          match s {
            Some(Sighting(z, at)) -> match previous_transition(z, at) {
              Some(change) -> time::as_nanos(time::between(change.at, at)) <= 172800000000000,
              None -> false,
            },
            None -> false,
          }),
      )
      > 5,
  )
}
