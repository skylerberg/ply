//! Media types: the `type/subtype; name=value` a `Content-Type` field carries, and the table from a
//! file name's extension to one and back.
//!
//! A `MediaType` is read and written as RFC 9110 §8.3 has it: tokens, and a parameter's value a
//! token or a quoted string. The type, the subtype and a parameter's name are case-insensitive and
//! kept in lower case; a value is kept as written, without its quotes. Two media types are `==`
//! when they name one type and subtype with the same parameters in any order, and `show` writes
//! the canonical text, quoting a value that is no token. `read` raises a `Refusal` saying where a
//! text stops being a media type and why, `parse` answers it as an `Err`, and with
//! `import std.mime`, `mime"text/html; charset=utf-8"` is the literal, checked with the program. A
//! text is refused rather than repaired: whitespace around `=`, a parameter named twice and
//! anything after the last parameter are each a refusal.
//!
//! A `MediaType` is also a range: `text/*` and `*/*` read as any other, `matches` says whether a
//! range covers a type, `quality` reads the weight an `Accept` field gives one and `read_list`
//! reads such a field. Choosing among ranges is `std.http`'s.
//!
//! `of_extension` and `of_path` answer the type a file name's extension names, and `extension` and
//! `extensions` the extensions a type is written under. The table is this module's own, never the
//! host's, so an answer is the same on every machine: about four hundred types a web server or an
//! upload handler meets, taken from jshttp's `mime-db` 1.54.0, which gathers the IANA registry and
//! the Apache and nginx tables. The whole registry arrives when a shipped module can embed a data
//! file. An extension names what the bytes are and says nothing of what they hold: a browser that
//! sniffs can be told another type by the bytes, which is what `X-Content-Type-Options: nosniff`
//! turns off.

import std.bytes (peek, scan, scan_until)
import std.laws (agrees, idempotent)
import std.list (contains, sort)
import std.path
import std.show (show)
import std.string (ascii_lower, ascii_upper, int_of_string, pad_right)

/// One parameter of a media type: its name in lower case, and its value as written without quotes.
pub type Param = { name: String, value: String }

/// A media type: its type, its subtype, and its parameters in the order written.
///
/// `media_type`, `with_param` and the readers make one whose type, subtype and names are tokens in
/// lower case; the constructor written by hand checks nothing, and `==`, `compare`, `digest` and
/// `show` read such a value in lower case too.
pub type MediaType = | MediaType(String, String, List<Param>)

key for MediaType by identity

show for MediaType by render

/// Why a text is no media type.
pub type Why =
  /// No token where a type, a subtype, a parameter's name or its value must stand.
  | NoToken
  /// No `/` after the type.
  | NoSlash
  /// No `=` after a parameter's name; whitespace before one is this too.
  | NoEquals
  /// A quoted string that never closes.
  | Unclosed
  /// A control byte in a quoted string, which holds none but a tab.
  | Control
  /// A parameter named twice, with its name.
  | Repeated(String)
  /// Text after the media type that is no parameter.
  | Trailing

/// A refusal, and the byte of the text's UTF-8 it was found at.
pub type Refusal = { at: Int, why: Why }

/// What a reader of this module raises where it refuses.
pub effect mime {
  /// The text is no media type.
  raise refused(e: Refusal)
}

// --- Reading ----------------------------------------------------------------

/// The media type `text` is, raising `mime.refused` where `parse` answers `Err`. Blanks around it
/// are passed over.
pub fn read(text: String) -> MediaType / {mime.refused, abort.raise} = {
  let b = bytes_of_string(text);
  let one = read_at(b, scan(b, 0, blanks()));
  let end = scan(b, one.at, blanks());
  if end < bytes_len(b) { refuse(end, Trailing) } else { one.value }
}

/// The media type `text` is, or where it stops being one and why.
pub fn parse(text: String) -> Result<MediaType, Refusal> / {abort.raise} = try { read(text) }

/// The media types of a comma-separated list, as an `Accept` field carries its ranges, in the
/// order written; an empty element is passed over (RFC 9110 §5.6.1). Raises `mime.refused` where
/// `parse_list` answers `Err`.
pub fn read_list(text: String) -> List<MediaType> / {mime.refused, abort.raise} = {
  let b = bytes_of_string(text);
  listed(b, 0, [], bytes_len(b) + 1)
}

/// The media types of a comma-separated list, or where it stops being one and why.
pub fn parse_list(text: String) -> Result<List<MediaType>, Refusal> / {abort.raise} =
  try { read_list(text) }

/// The parameters `text` holds from its byte `at` on, each after a `;` as a media type's are: what
/// follows the first word of a field such as `Content-Disposition`. Raises `mime.refused` as
/// `read` does.
pub fn read_params(text: String, at: Int) -> List<Param> / {mime.refused, abort.raise} = {
  let b = bytes_of_string(text);
  let held = parameters(b, { at: at, params: [], seen: map_new() }, bytes_len(b) + 1);
  let end = scan(b, held.at, blanks());
  if end < bytes_len(b) { refuse(end, Trailing) } else { held.params }
}

/// What a `mime"..."` literal is checked by: the media type `read` answers, or why the text is
/// none and the character it stops being one at.
pub fn literal(
  text: String,
) -> Result<MediaType, { message: String, offset: Int }> / {abort.raise} =
  match parse(text) {
    Ok(m) -> Ok(m),
    Err(r) ->
      Err({
        message: explained(r.why),
        offset: string_len(string_of_bytes_lossy(bytes_slice(bytes_of_string(text), 0, r.at))),
      }),
  }

fn explained(why: Why) -> String =
  match why {
    NoToken -> "a name is expected here",
    NoSlash -> "a `/` is expected between the type and the subtype",
    NoEquals -> "a `=` is expected after a parameter's name",
    Unclosed -> "the quoted string never closes",
    Control -> "a quoted string holds no control character but a tab",
    Repeated(name) -> "the parameter `" ++ name ++ "` is given twice",
    Trailing -> "nothing follows a media type but `;` and a parameter",
  }

fn refuse<a>(at: Int, why: Why) -> a / {mime.refused} = mime.refused({ at: at, why: why })

/// RFC 9110's `tchar`: what a token is made of.
fn tchars() -> Bytes =
  b"!#$%&'*+-.^_`|~0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"

fn blanks() -> Bytes = b" \t"

/// What ends a run of plain text in a quoted string: its quote, a backslash, and each control byte
/// but a tab.
fn quoted_stops() -> Bytes =
  b"\"\\\x00\x01\x02\x03\x04\x05\x06\x07\x08\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f\x7f"

fn lowered(b: Bytes, from: Int, to: Int) -> String / {abort.raise} =
  ascii_lower(string_of_bytes(bytes_slice(b, from, to)))

type One = { value: MediaType, at: Int }

/// The media type that starts at `at`, and where the text stands after its last parameter.
fn read_at(b: Bytes, at: Int) -> One / {mime.refused, abort.raise} = {
  let slash = scan(b, at, tchars());
  if slash == at { refuse(at, NoToken) }
  else if peek(b, slash) != b'/' { refuse(slash, NoSlash) } else {
    let end = scan(b, slash + 1, tchars());
    if end == slash + 1 { refuse(end, NoToken) } else {
      let held = parameters(b, { at: end, params: [], seen: map_new() }, bytes_len(b) + 1);
      {
        value: MediaType(lowered(b, at, slash), lowered(b, slash + 1, end), held.params),
        at: held.at,
      }
    }
  }
}

fn listed(
  b: Bytes,
  at: Int,
  acc: List<MediaType>,
  left: Int,
) -> List<MediaType> / {mime.refused, abort.raise} = {
  let start = scan(b, at, b" \t,");
  if left <= 0 { acc }
  else if start >= bytes_len(b) { acc } else {
    let one = read_at(b, start);
    let end = scan(b, one.at, blanks());
    if end < bytes_len(b) && bytes_at(b, end) != b',' { refuse(end, Trailing) }
    else { listed(b, end, push(acc, one.value), left - 1) }
  }
}

type Held = { at: Int, params: List<Param>, seen: Map<String, Unit> }

/// The parameters from `held.at` on. `left` bounds the rounds: each takes a `;` at least.
fn parameters(b: Bytes, held: Held, left: Int) -> Held / {mime.refused, abort.raise} = {
  let semi = scan(b, held.at, blanks());
  if left <= 0 { held }
  else if peek(b, semi) != b';' { held } else {
    let start = scan(b, semi + 1, blanks());
    let equals = scan(b, start, tchars());
    if equals == start { parameters(b, { ..held, at: start }, left - 1) }
    else if peek(b, equals) != b'=' { refuse(equals, NoEquals) }
    else { parameters(b, with_parameter(b, held, start, equals), left - 1) }
  }
}

fn with_parameter(
  b: Bytes,
  held: Held,
  start: Int,
  equals: Int,
) -> Held / {mime.refused, abort.raise} = {
  let name = lowered(b, start, equals);
  if map_contains(held.seen, name) { refuse(start, Repeated(name)) } else {
    let value = value_at(b, equals + 1);
    {
      at: value.at,
      params: push(held.params, { name: name, value: value.text }),
      seen: map_insert(held.seen, name, ()),
    }
  }
}

type Text = { text: String, at: Int }

fn value_at(b: Bytes, at: Int) -> Text / {mime.refused, abort.raise} =
  if peek(b, at) == b'"' { quoted(b, at + 1, [], bytes_len(b) + 1) } else {
    let end = scan(b, at, tchars());
    if end == at { refuse(at, NoToken) }
    else { { text: string_of_bytes(bytes_slice(b, at, end)), at: end } }
  }

/// The quoted string whose opening quote stands just before `at`, without its quotes and with each
/// backslash pair as the byte it holds. `left` bounds the rounds: each takes a pair.
fn quoted(b: Bytes, at: Int, kept: List<Bytes>, left: Int) -> Text / {mime.refused, abort.raise} = {
  let stop = scan_until(b, at, quoted_stops());
  let so_far = push(kept, bytes_slice(b, at, stop));
  let c = peek(b, stop);
  if left <= 0 { refuse(stop, Unclosed) }
  else if c == b'"' { { text: string_of_bytes(bytes_concat_all(so_far)), at: stop + 1 } }
  else if c < 0 { refuse(stop, Unclosed) }
  else if c != b'\\' { refuse(stop, Control) }
  else if stop + 1 >= bytes_len(b) { refuse(stop + 1, Unclosed) }
  else if !pairs(bytes_at(b, stop + 1)) { refuse(stop + 1, Control) }
  else { quoted(b, stop + 2, push(so_far, bytes_slice(b, stop + 1, stop + 2)), left - 1) }
}

/// Whether a backslash may stand before the byte `c`: a tab, or anything that is no control.
fn pairs(c: Int) -> Bool = c == b'\t' || (c >= b' ' && c != 0x7F)

// --- Writing ----------------------------------------------------------------

/// The canonical text: the type and subtype in lower case, then each parameter as `; name=value`
/// in the order held, a value that is no token in quotes with a backslash before each quote and
/// backslash in it. What `read` reads back for any value the makers and readers answer.
pub fn render(m: MediaType) -> String =
  match m {
    MediaType(top, subtype, held) ->
      fold(held, ascii_lower(top) ++ "/" ++ ascii_lower(subtype), |acc: String, p: Param|
        acc ++ "; " ++ ascii_lower(p.name) ++ "=" ++ written(p.value)),
  }

fn written(value: String) -> String =
  if is_token(value) { value } else {
    "\""
      ++ string_of_chars(
        fold(string_chars(value), [], |acc: List<Char>, c: Char|
          if c == '"' || c == '\\' { push(push(acc, '\\'), c) } else { push(acc, c) }),
      )
      ++ "\""
  }

/// Whether `text` is a token of RFC 9110 §5.6.2: one or more of the letters, the digits and
/// ``!#$%&'*+-.^_`|~``.
pub fn is_token(text: String) -> Bool =
  string_len(text) > 0
    && fold(string_chars(text), true, |ok: Bool, c: Char|
      ok && string_contains(token_chars(), string_of_chars([c])))

/// Where the token that starts at `at` in `b` ends: `at` itself where none starts there.
pub fn token_end(b: Bytes, at: Int) -> Int / {abort.raise} = scan(b, at, tchars())

fn token_chars() -> String =
  "!#$%&'*+-.^_`|~0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"

/// Whether a quoted string, or a header field's value, can hold `text`: no control character but
/// a tab.
pub fn is_quotable(text: String) -> Bool =
  fold(string_chars(text), true, |ok: Bool, c: Char|
    ok && (c == '\t' || (int_of_char(c) >= 32 && int_of_char(c) != 127)))

type Identity = { top: String, subtype: String, params: List<Param> }

/// What two media types are compared by: the names in lower case, and the parameters by name, a
/// `charset`'s value in lower case too.
fn identity(m: MediaType) -> Identity =
  match m {
    MediaType(top, subtype, held) ->
      {
        top: ascii_lower(top),
        subtype: ascii_lower(subtype),
        params: ordered(
          map(held, |p: Param| {
            let name = ascii_lower(p.name);
            { name: name, value: if name == "charset" { ascii_lower(p.value) } else { p.value } }
          }),
        ),
      },
  }

fn ordered(held: List<Param>) -> List<Param> = if len(held) < 2 { held } else { sort(held) }

// --- Making and asking ------------------------------------------------------

/// The media type `top/subtype` with no parameter, in lower case; `None` unless both are tokens.
pub fn media_type(top: String, subtype: String) -> Option<MediaType> =
  if is_token(top) && is_token(subtype) {
    Some(MediaType(ascii_lower(top), ascii_lower(subtype), []))
  } else { None }

/// `m` with the parameter `name` set to `value`: in place of the one it has under that name, or
/// after its last. `None` where `name` is no token or `value` holds a control character other
/// than a tab, which no text of a media type can carry.
pub fn with_param(m: MediaType, name: String, value: String) -> Option<MediaType> = {
  let lower = ascii_lower(name);
  if !is_token(name) || !is_quotable(value) { None } else {
    match m {
      MediaType(top, subtype, held) ->
        Some(
          MediaType(top, subtype, if has_param(held, lower) {
            map(held, |p: Param|
              if ascii_lower(p.name) == lower { { name: lower, value: value } } else { p })
          } else { push(held, { name: lower, value: value }) }),
        ),
    }
  }
}

fn has_param(held: List<Param>, lower: String) -> Bool =
  fold(held, false, |found: Bool, p: Param| found || ascii_lower(p.name) == lower)

/// `m` with no parameter.
pub fn without_params(m: MediaType) -> MediaType =
  match m { MediaType(top, subtype, _) -> MediaType(top, subtype, []) }

/// The type before the `/`, in lower case: `text` of `text/html`.
pub fn top_level(m: MediaType) -> String = match m { MediaType(top, _, _) -> ascii_lower(top) }

/// The subtype after the `/`, in lower case: `svg+xml` of `image/svg+xml`.
pub fn subtype(m: MediaType) -> String =
  match m { MediaType(_, subtype, _) -> ascii_lower(subtype) }

/// The structured syntax a subtype ends with, after its last `+`: `xml` of `image/svg+xml`, and
/// `None` of `text/html`.
pub fn suffix(m: MediaType) -> Option<String> / {abort.raise} = {
  let pieces = string_split(subtype(m), "+");
  if len(pieces) < 2 { None } else { list_at(pieces, len(pieces) - 1) }
}

/// The type and subtype alone, `text/html`, in lower case.
pub fn essence(m: MediaType) -> String = top_level(m) ++ "/" ++ subtype(m)

/// The parameters in the order held.
pub fn params(m: MediaType) -> List<Param> = match m { MediaType(_, _, held) -> held }

/// The value of the parameter `name`, whatever case either is written in.
pub fn param(m: MediaType, name: String) -> Option<String> = {
  let lower = ascii_lower(name);
  fold(params(m), None, |found: Option<String>, p: Param|
    match found {
      Some(_) -> found,
      None -> if ascii_lower(p.name) == lower { Some(p.value) } else { None },
    })
}

/// The `charset` parameter in lower case, as a charset's name is case-insensitive.
pub fn charset(m: MediaType) -> Option<String> =
  match param(m, "charset") { Some(name) -> Some(ascii_lower(name)), None -> None }

/// The `boundary` parameter, which delimits the parts of a `multipart` body.
pub fn boundary(m: MediaType) -> Option<String> = param(m, "boundary")

/// Whether the range `range` covers `m`: `*/*` covers every type, `text/*` every subtype of
/// `text`, and any other range the one type and subtype it names. Each parameter of the range but
/// `q` must be `m`'s too, with the same value.
pub fn matches(range: MediaType, m: MediaType) -> Bool = {
  let want = identity(range);
  let have = identity(m);
  (want.top == "*" || want.top == have.top) && (want.subtype == "*" || want.subtype == have.subtype)
    && fold(want.params, true, |ok: Bool, p: Param|
      ok && (p.name == "q" || contains(have.params, p)))
}

/// How much of a type a range pins down, for ranking the ranges that cover one: 0 for `*/*`, 1 for
/// `text/*`, 2 for `text/html`, and 3 for one with a parameter other than `q`.
pub fn specificity(range: MediaType) -> Int = {
  let want = identity(range);
  if want.top == "*" { 0 }
  else if want.subtype == "*" { 1 }
  else if len(filter(want.params, |p: Param| p.name != "q")) == 0 { 2 }
  else { 3 }
}

/// The weight an `Accept` field gives a range, in thousandths: 1000 where it has no `q`, and
/// `None` where its `q` is no weight of RFC 9110 §12.4.2, `0` to `1` with at most three decimals.
pub fn quality(range: MediaType) -> Option<Int> / {abort.raise} =
  match param(range, "q") { None -> Some(1000), Some(q) -> weight(q) }

fn weight(q: String) -> Option<Int> / {abort.raise} = {
  let b = bytes_of_string(q);
  let n = bytes_len(b);
  let digits = scan(b, 2, b"0123456789");
  if n == 0 || n > 5 || (n > 1 && (bytes_at(b, 1) != b'.' || digits < n)) { None } else {
    let whole = bytes_at(b, 0) - b'0';
    match int_of_string(pad_right(string_slice(q, if n > 1 { 2 } else { 1 }, n), 3, "0")) {
      Some(part) -> if (whole == 0 || whole == 1) && whole * 1000 + part <= 1000 {
        Some(whole * 1000 + part)
      } else { None },
      None -> None,
    }
  }
}

// --- Extensions -------------------------------------------------------------

/// The media type a file name's extension names, written with or without its dot and in any
/// case: `text/html` for `html`, `.html` and `HTML`. `None` for one the table does not hold.
pub fn of_extension(ext: String) -> Option<MediaType> / {abort.raise}
  cost string_len(ext)
=
  match map_get(table().types, undotted(ascii_lower(ext))) {
    Some(named) -> Some(bare(named)),
    None -> None,
  }

/// The media type of a path by its file name's last extension, so `a/b.tar.gz` is
/// `application/gzip`: what the bytes are, whatever they unpack to. `None` for a name with no
/// extension, a dotfile among them, and for an extension the table does not hold.
pub fn of_path(file: String) -> Option<MediaType> / {abort.raise} =
  match path::extension(file) { Some(ext) -> of_extension(ext), None -> None }

/// The extension a type is most often written under, without a dot: `jpg` for `image/jpeg`.
/// Parameters are passed over. `None` for a type the table does not hold.
pub fn extension(m: MediaType) -> Option<String> = list_at(extensions(m), 0)

/// Every extension the table holds for a type, the preferred one first; none for a type it does
/// not hold.
pub fn extensions(m: MediaType) -> List<String> =
  match map_get(table().extensions, essence(m)) { Some(found) -> found, None -> [] }

fn undotted(ext: String) -> String / {abort.raise} =
  if string_starts_with(ext, ".") { string_slice(ext, 1, string_len(ext)) } else { ext }

/// A media type of the table's text, which has no parameter.
fn bare(named: String) -> MediaType / {abort.raise} = {
  let slash = string_find(named, "/");
  MediaType(string_slice(named, 0, slash), string_slice(named, slash + 1, string_len(named)), [])
}

type Table = { types: Map<String, String>, extensions: Map<String, List<String>> }

/// Both directions of `rows`, built once: an extension several types list names the first of
/// them.
const fn table() -> Table =
  fold(
    string_split(rows(), "\n"),
    { types: map_new(), extensions: map_new() },
    |t: Table, row: String|
      match string_split(row, " ") {
        [named, ..exts] ->
          {
            types: fold(exts, t.types, |m: Map<String, String>, ext: String|
              if map_contains(m, ext) { m } else { map_insert(m, ext, named) }),
            extensions: map_insert(t.extensions, named, exts),
          },
        [] -> t,
      },
  )

/// The table as `mime.types` files write one: a type, then its extensions with the preferred one
/// first. The rows and their extensions are `mime-db` 1.54.0's; the order is this module's.
fn rows() -> String =
  \\text/html html htm shtml
  \\text/css css
  \\text/javascript js mjs
  \\application/json json map
  \\application/xml xml xsl xsd rng
  \\text/plain txt text conf def list log in ini
  \\text/csv csv
  \\text/tab-separated-values tsv
  \\text/markdown md markdown
  \\text/calendar ics ifb
  \\text/vcard vcard
  \\text/vtt vtt
  \\text/yaml yaml yml
  \\text/xml xml
  \\text/cache-manifest appcache manifest
  \\text/uri-list uri uris urls
  \\text/richtext rtx
  \\text/sgml sgml sgm
  \\text/turtle ttl
  \\text/n3 n3
  \\text/mathml mml
  \\text/troff t tr roff man me ms
  \\text/shex shex
  \\text/spdx spdx
  \\text/wgsl wgsl
  \\text/vnd.graphviz gv
  \\text/vnd.wap.wml wml
  \\text/x-c c cc cxx cpp h hh dic
  \\text/x-java-source java
  \\text/x-asm s asm
  \\text/x-fortran f for f77 f90
  \\text/x-pascal p pas
  \\text/x-lua lua
  \\text/x-sass sass
  \\text/x-scss scss
  \\text/less less
  \\text/stylus stylus styl
  \\text/coffeescript coffee litcoffee
  \\text/jsx jsx
  \\text/mdx mdx
  \\text/jade jade
  \\text/slim slim slm
  \\text/x-handlebars-template hbs
  \\text/x-org org
  \\text/x-opml opml
  \\text/x-nfo nfo
  \\text/x-sfv sfv
  \\text/x-setext etx
  \\text/x-uuencode uu
  \\text/x-vcalendar vcs
  \\text/x-vcard vcf
  \\text/x-component htc
  \\text/x-markdown mkd
  \\text/x-processing pde
  \\application/javascript js
  \\application/ecmascript ecma
  \\application/node cjs
  \\application/json5 json5
  \\application/ld+json jsonld
  \\application/geo+json geojson
  \\application/manifest+json webmanifest
  \\application/hjson hjson
  \\application/jsonml+json jsonml
  \\application/x-ipynb+json ipynb
  \\application/x-web-app-manifest+json webapp
  \\application/toml toml
  \\application/yang yang
  \\application/sql sql
  \\application/x-sql sql
  \\application/x-sh sh
  \\application/x-csh csh
  \\application/x-perl pl pm
  \\application/x-tcl tcl tk
  \\application/x-httpd-php php
  \\application/x-latex latex
  \\application/x-tex tex
  \\application/x-texinfo texinfo texi
  \\application/wasm wasm
  \\application/xhtml+xml xhtml xht
  \\application/xml-dtd dtd
  \\application/xslt+xml xsl xslt
  \\application/atom+xml atom
  \\application/rss+xml rss
  \\application/rdf+xml rdf owl
