// --- Tests ------------------------------------------------------------------

type Written = { text: String, canonical: String }

/// Texts that are media types, each with what `show` writes of it. The first four are RFC 9110
/// §8.3.1's and the `multipart` ones RFC 2046 §5.1.1's.
fn readable() -> List<Written> =
  [
    { text: "text/html;charset=utf-8", canonical: "text/html; charset=utf-8" },
    { text: "Text/HTML;Charset=\"utf-8\"", canonical: "text/html; charset=utf-8" },
    { text: "text/html; charset=\"utf-8\"", canonical: "text/html; charset=utf-8" },
    { text: "text/html;charset=UTF-8", canonical: "text/html; charset=UTF-8" },
    {
      text: "multipart/mixed; boundary=gc0p4Jq0M2Yt08j34c0p",
      canonical: "multipart/mixed; boundary=gc0p4Jq0M2Yt08j34c0p",
    },
    {
      text: "multipart/mixed; boundary=\"gc0pJq0M:08jU534c0p\"",
      canonical: "multipart/mixed; boundary=\"gc0pJq0M:08jU534c0p\"",
    },
    {
      text: "multipart/mixed; boundary=\"simple boundary\"",
      canonical: "multipart/mixed; boundary=\"simple boundary\"",
    },
    { text: "text/plain", canonical: "text/plain" },
    { text: " \ttext/plain \t", canonical: "text/plain" },
    { text: "APPLICATION/LD+JSON", canonical: "application/ld+json" },
    { text: "*/*", canonical: "*/*" },
    { text: "text/*;q=0.5", canonical: "text/*; q=0.5" },
    { text: "text/html;;charset=utf-8 ; ", canonical: "text/html; charset=utf-8" },
    { text: "text/plain; title=\"\"", canonical: "text/plain; title=\"\"" },
    {
      text: "text/plain; title=\"a \\\"b\\\" \\\\ \\c\"",
      canonical: "text/plain; title=\"a \\\"b\\\" \\\\ c\"",
    },
    {
      text: "text/plain; name=\"na\u{ef}ve.txt\"",
      canonical: "text/plain; name=\"na\u{ef}ve.txt\"",
    },
    {
      text: "text/plain; format=flowed; DelSp=yes",
      canonical: "text/plain; format=flowed; delsp=yes",
    },
  ]

test "reads {show(c.text)}" for c: Written in readable() {
  assert_eq(match parse(c.text) { Ok(m) -> Some(render(m)), Err(_) -> None }, Some(c.canonical));
  assert_eq(parse(c.canonical), parse(c.text))
}

type Refused = { text: String, at: Int, why: Why }

/// Texts that are no media type, each with where it stops being one and why. The colon is RFC
/// 2046 §5.1.1's boundary that must be quoted.
fn unreadable() -> List<Refused> =
  [
    { text: "", at: 0, why: NoToken },
    { text: "/html", at: 0, why: NoToken },
    { text: "text", at: 4, why: NoSlash },
    { text: "text html", at: 4, why: NoSlash },
    { text: "text/", at: 5, why: NoToken },
    { text: "text/ html", at: 5, why: NoToken },
    { text: "text/html charset=utf-8", at: 10, why: Trailing },
    { text: "text/html, text/plain", at: 9, why: Trailing },
    { text: "multipart/mixed; boundary=gc0pJq0M:08jU534c0p", at: 34, why: Trailing },
    { text: "text/html; charset", at: 18, why: NoEquals },
    { text: "text/html; charset =utf-8", at: 18, why: NoEquals },
    { text: "text/html; charset= utf-8", at: 19, why: NoToken },
    { text: "text/html; charset=", at: 19, why: NoToken },
    { text: "text/html; =utf-8", at: 11, why: Trailing },
    { text: "text/html; charset=\"utf-8", at: 25, why: Unclosed },
    { text: "text/html; a=\"x\\", at: 16, why: Unclosed },
    { text: "text/html; a=\"x\\\"", at: 17, why: Unclosed },
    { text: "text/html; a=\"x\u{7f}y\"", at: 15, why: Control },
    { text: "text/html; a=\"x\\\u{7f}y\"", at: 16, why: Control },
    { text: "text/html; a=1; b=2; A=3", at: 21, why: Repeated("a") },
    { text: "text/html; a=\"x\"y", at: 16, why: Trailing },
  ]

test "refuses {show(c.text)}" for c: Refused in unreadable() {
  assert_eq(parse(c.text), Err({ at: c.at, why: c.why }))
}

test "the raising reader raises what the other answers" {
  assert_eq(try { read("text") }, Err({ at: 4, why: NoSlash }));
  assert_eq(try { read_list("text/html, text") }, Err({ at: 15, why: NoSlash }))
}

test "a quoted string holds a blank after a backslash, and no NUL" {
  assert_eq(parse("text/plain; t=\"a\\ b\\\tc\""), parse("text/plain; t=\"a b\tc\""));
  assert_eq(parse("text/html; a=\"x\0y\""), Err({ at: 15, why: Control }));
  assert_eq(parse("text/html; a=\"x\\\0y\""), Err({ at: 16, why: Control }))
}

test "the parameters after a field's first word are read as a media type's are" {
  assert_eq(
    try { read_params("attachment; filename=\"a b.txt\"; Size=12 ", 10) },
    Ok([{ name: "filename", value: "a b.txt" }, { name: "size", value: "12" }]),
  );
  assert_eq(try { read_params("inline", 6) }, Ok([]));
  assert_eq(try { read_params("inline", 9) }, Ok([]));
  assert_eq(try { read_params("inline; a=1 b", 6) }, Err({ at: 12, why: Trailing }));
  assert_eq(try { read_params("inline; a=1; A=2", 6) }, Err({ at: 13, why: Repeated("a") }))
}

test "RFC 9110's four spellings of one media type are equal, and a parameter's order is not read" {
  let spellings = map(
    ["text/html;charset=utf-8", "Text/HTML;Charset=\"utf-8\"", "text/html; charset=\"utf-8\""],
    parse,
  );
  assert_eq(
    spellings,
    map(spellings, |_: Result<MediaType, Refusal>| parse("text/html;charset=UTF-8")),
  );
  assert_eq(parse("text/plain; a=1; b=2"), parse("TEXT/Plain; B=2; A=1"));
  assert(parse("text/plain; a=1") != parse("text/plain; a=2"));
  assert(parse("text/plain; a=x") != parse("text/plain; a=X"));
  assert(parse("text/plain") != parse("text/plain; a=1"));
  assert_eq(MediaType("Text", "HTML", [{ name: "Charset", value: "UTF-8" }]), html_utf8());
  assert_eq(digest(MediaType("Text", "HTML", [])), digest(MediaType("text", "html", [])))
}

fn html_utf8() -> MediaType = MediaType("text", "html", [{ name: "charset", value: "utf-8" }])

test "a media type is shown as its canonical text, and its parts are read in lower case" {
  let m = MediaType("Image", "SVG+XML", [{ name: "Charset", value: "UTF-8" }]);
  assert_eq(f"{m}", "image/svg+xml; charset=UTF-8");
  assert_eq(top_level(m), "image");
  assert_eq(subtype(m), "svg+xml");
  assert_eq(suffix(m), Some("xml"));
  assert_eq(suffix(html_utf8()), None);
  assert_eq(essence(m), "image/svg+xml");
  assert_eq(charset(m), Some("utf-8"));
  assert_eq(param(m, "CHARSET"), Some("UTF-8"));
  assert_eq(param(m, "boundary"), None);
  assert_eq(params(m), [{ name: "Charset", value: "UTF-8" }]);
  assert_eq(without_params(m), MediaType("image", "svg+xml", []));
  // Lower case is ASCII's: the Kelvin sign is no `k`, in a name or in a charset.
  let kelvin = MediaType("text", "MAR\u{212A}DOWN", [{ name: "charset", value: "\u{212A}OI8-R" }]);
  assert_eq(subtype(kelvin), "mar\u{212A}down");
  assert_eq(charset(kelvin), Some("\u{212A}oi8-r"));
  assert(without_params(kelvin) != MediaType("text", "markdown", []));
  assert_eq(
    match parse("multipart/form-data; boundary=\"simple boundary\"") {
      Ok(form) -> boundary(form),
      Err(_) -> None,
    },
    Some("simple boundary"),
  )
}

test "a maker answers a media type only of tokens and of values a text can carry" {
  assert_eq(media_type("Text", "HTML"), Some(MediaType("text", "html", [])));
  assert_eq(media_type("text", ""), None);
  assert_eq(media_type("te xt", "html"), None);
  assert_eq(media_type("text", "html/x"), None);
  let plain = MediaType("text", "plain", []);
  assert_eq(
    with_param(plain, "Charset", "utf-8"),
    Some(MediaType("text", "plain", [{ name: "charset", value: "utf-8" }])),
  );
  let two = MediaType("text", "plain", [{ name: "a", value: "1" }, { name: "b", value: "2" }]);
  assert_eq(
    match with_param(two, "A", "x y") { Some(m) -> render(m), None -> "" },
    "text/plain; a=\"x y\"; b=2",
  );
  assert_eq(with_param(plain, "a b", "1"), None);
  assert_eq(with_param(plain, "", "1"), None);
  assert_eq(with_param(plain, "a", "line\nbreak"), None);
  assert_eq(with_param(plain, "a", "nul\0"), None);
  assert_eq(with_param(plain, "a", "del\u{7f}"), None);
  assert(with_param(plain, "a", "next line\u{85}") != None);
  assert(with_param(plain, "a", "tab\tand caf\u{e9}") != None);
  assert(is_token("a.b-c_d~1"));
  assert(!is_token("a/b"));
  assert(!is_token(""))
}

fn range_of(text: String) -> MediaType / {abort.raise} =
  match parse(text) { Ok(m) -> m, Err(_) -> panic("no media type: " ++ text) }

test "a range covers the types it names, and a wider range is less specific" {
  let html = range_of("text/html; charset=utf-8");
  assert(matches(range_of("*/*"), html));
  assert(matches(range_of("text/*"), html));
  assert(matches(range_of("TEXT/HTML"), html));
  assert(matches(range_of("text/html; q=0.2"), html));
  assert(matches(range_of("text/html; charset=UTF-8"), html));
  assert(!matches(range_of("text/html; level=1"), html));
  assert(!matches(range_of("text/plain"), html));
  assert(!matches(range_of("image/*"), html));
  assert(!matches(html, range_of("text/*")));
  assert_eq(
    map(
      ["*/*", "text/*", "text/plain", "text/plain;format=flowed", "text/plain;q=0.1"],
      |t: String| specificity(range_of(t)),
    ),
    [0, 1, 2, 3, 2],
  )
}

type Weighed = { text: String, weight: Option<Int> }

fn weights() -> List<Weighed> =
  [
    { text: "text/html", weight: Some(1000) },
    { text: "text/html;q=1", weight: Some(1000) },
    { text: "text/html;q=1.000", weight: Some(1000) },
    { text: "text/html;q=1.", weight: Some(1000) },
    { text: "text/html;q=0", weight: Some(0) },
    { text: "text/html;q=0.", weight: Some(0) },
    { text: "text/html;q=0.5", weight: Some(500) },
    { text: "text/html;q=0.25", weight: Some(250) },
    { text: "text/html;Q=0.001", weight: Some(1) },
    { text: "text/html;q=0.999", weight: Some(999) },
    { text: "text/html;q=1.001", weight: None },
    { text: "text/html;q=2", weight: None },
    { text: "text/html;q=0.1234", weight: None },
    { text: "text/html;q=0.0001", weight: None },
    { text: "text/html;q=0.-1", weight: None },
    { text: "text/html;q=.5", weight: None },
    { text: "text/html;q=05", weight: None },
    { text: "text/html;q=-1", weight: None },
    { text: "text/html;q=\"\"", weight: None },
    { text: "text/html;q=0.x", weight: None },
  ]

test "weighs {show(c.text)}" for c: Weighed in weights() {
  assert_eq(quality(range_of(c.text)), c.weight)
}

type Listed = { text: String, canonical: List<String> }

/// `Accept` fields, the first three RFC 9110 §12.5.1's, each with its ranges as `show` writes
/// them.
fn accepted() -> List<Listed> =
  [
    { text: "audio/*; q=0.2, audio/basic", canonical: ["audio/*; q=0.2", "audio/basic"] },
    {
      text: "text/plain; q=0.5, text/html, text/x-dvi; q=0.8, text/x-c",
      canonical: ["text/plain; q=0.5", "text/html", "text/x-dvi; q=0.8", "text/x-c"],
    },
    {
      text: "text/*, text/plain, text/plain;format=flowed, */*",
      canonical: ["text/*", "text/plain", "text/plain; format=flowed", "*/*"],
    },
    { text: "", canonical: [] },
    { text: " , ,", canonical: [] },
    {
      text: ",text/html,,text/plain; a=\"x,y\" ,",
      canonical: ["text/html", "text/plain; a=\"x,y\""],
    },
  ]

test "lists {show(c.text)}" for c: Listed in accepted() {
  assert_eq(
    match parse_list(c.text) { Ok(ms) -> Some(map(ms, render)), Err(_) -> None },
    Some(c.canonical),
  )
}

test "a list is refused where an element is no media type" {
  assert_eq(parse_list("text/html text/plain"), Err({ at: 10, why: Trailing }));
  assert_eq(parse_list("text/html, plain"), Err({ at: 16, why: NoSlash }));
  assert_eq(parse_list("text/html; a=\"x, text/plain"), Err({ at: 27, why: Unclosed }))
}

test "the literal's check answers the media type, or the character the text stops being one at" {
  assert_eq(literal("text/html; charset=utf-8"), Ok(html_utf8()));
  assert_eq(
    literal("text/html; charset"),
    Err({ message: "a `=` is expected after a parameter's name", offset: 18 }),
  );
  assert_eq(
    literal("text/plain; a=\"caf\u{e9}\"; a=1"),
    Err({ message: "the parameter `a` is given twice", offset: 22 }),
  )
}

/// A token made of `text`: its characters a token holds, or `x` where it has none.
fn tokenized(text: String) -> String = {
  let kept = string_of_chars(
    filter(string_chars(text), |c: Char| string_contains(token_chars(), string_of_chars([c]))),
  );
  if kept == "" { "x" } else { kept }
}

/// What a law makes a media type of: any four texts.
type Seed = { top: String, subtype: String, name: String, value: String }

/// What of `text` a quoted string holds.
fn quoted_text(text: String) -> String =
  string_of_chars(filter(string_chars(text), |c: Char| is_quotable(string_of_chars([c]))))

/// A media type of a seed, through the makers: its names the seed's token characters, and its
/// parameter's value what of the seed's a quoted string holds.
fn made(s: Seed) -> MediaType =
  match media_type(tokenized(s.top), tokenized(s.subtype)) {
    Some(m) -> match with_param(m, tokenized(s.name), quoted_text(s.value)) {
      Some(set) -> set,
      None -> m,
    },
    None -> MediaType("x", "x", []),
  }

/// The media type `made` makes of a seed, as the constructor holds it with its names in upper
/// case.
fn shouted(s: Seed) -> MediaType =
  MediaType(ascii_upper(tokenized(s.top)), ascii_upper(tokenized(s.subtype)), [
    { name: ascii_upper(tokenized(s.name)), value: quoted_text(s.value) },
  ])

/// The canonical text of `text` where it is a media type, and `text` where it is none.
fn canonical(text: String) -> String / {abort.raise} =
  match parse(text) { Ok(m) -> render(m), Err(_) -> text }

law "a media type's canonical text reads back as it" =
  agrees(|s: Seed| parse(render(made(s))), |s: Seed| Ok(made(s)))

law "a media type is equal however its names are cased" = agrees(shouted, made)

law "a canonical text is its own canonical text" = idempotent(canonical)

type Named = { ext: String, named: String }

/// Extensions and the types `mime-db` 1.54.0 lists them under, read from its `db.json`.
fn sampled() -> List<Named> =
  [
    { ext: "html", named: "text/html" },
    { ext: "htm", named: "text/html" },
    { ext: "css", named: "text/css" },
    { ext: "js", named: "text/javascript" },
    { ext: "mjs", named: "text/javascript" },
    { ext: "json", named: "application/json" },
    { ext: "xml", named: "application/xml" },
    { ext: "txt", named: "text/plain" },
    { ext: "csv", named: "text/csv" },
    { ext: "md", named: "text/markdown" },
    { ext: "wasm", named: "application/wasm" },
    { ext: "png", named: "image/png" },
    { ext: "jpg", named: "image/jpeg" },
    { ext: "jpeg", named: "image/jpeg" },
    { ext: "gif", named: "image/gif" },
    { ext: "webp", named: "image/webp" },
    { ext: "svg", named: "image/svg+xml" },
    { ext: "avif", named: "image/avif" },
    { ext: "ico", named: "image/vnd.microsoft.icon" },
    { ext: "bmp", named: "image/bmp" },
    { ext: "mp3", named: "audio/mpeg" },
    { ext: "wav", named: "audio/wav" },
    { ext: "ogg", named: "audio/ogg" },
    { ext: "mid", named: "audio/midi" },
    { ext: "aiff", named: "audio/x-aiff" },
    { ext: "mp4", named: "video/mp4" },
    { ext: "webm", named: "video/webm" },
    { ext: "avi", named: "video/x-msvideo" },
    { ext: "mov", named: "video/quicktime" },
    { ext: "woff", named: "font/woff" },
    { ext: "woff2", named: "font/woff2" },
    { ext: "ttf", named: "font/ttf" },
    { ext: "otf", named: "font/otf" },
    { ext: "ttc", named: "font/collection" },
    { ext: "eot", named: "application/vnd.ms-fontobject" },
    { ext: "pdf", named: "application/pdf" },
    { ext: "ps", named: "application/postscript" },
    { ext: "zip", named: "application/zip" },
    { ext: "gz", named: "application/gzip" },
    { ext: "tar", named: "application/x-tar" },
    { ext: "rar", named: "application/vnd.rar" },
    { ext: "7z", named: "application/x-7z-compressed" },
    { ext: "doc", named: "application/msword" },
    {
      ext: "docx",
      named: "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
    },
    { ext: "xlsx", named: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" },
    { ext: "odt", named: "application/vnd.oasis.opendocument.text" },
    { ext: "epub", named: "application/epub+zip" },
    { ext: "eml", named: "message/rfc822" },
    { ext: "ics", named: "text/calendar" },
    { ext: "yaml", named: "text/yaml" },
    { ext: "toml", named: "application/toml" },
    { ext: "bin", named: "application/octet-stream" },
    { ext: "exe", named: "application/x-msdownload" },
    { ext: "glb", named: "model/gltf-binary" },
  ]

test "{c.ext} is {c.named}" for c: Named in sampled() {
  assert_eq(match of_extension(c.ext) { Some(m) -> Some(render(m)), None -> None }, Some(c.named));
  assert(match parse(c.named) { Ok(m) -> contains(extensions(m), c.ext), Err(_) -> false })
}

test "an extension is read with or without its dot and in any case, and a path by its last one" {
  let html = Some(MediaType("text", "html", []));
  assert_eq(of_extension("html"), html);
  assert_eq(of_extension(".html"), html);
  assert_eq(of_extension("HTML"), html);
  assert_eq(of_extension(".HtM"), html);
  assert_eq(of_extension("..html"), None);
  assert_eq(of_extension(""), None);
  assert_eq(of_extension("no-such-extension"), None);
  // The Kelvin sign is `k` in Unicode's lower case, and is no letter of `mkv`.
  assert_eq(of_extension("mkv"), Some(MediaType("video", "x-matroska", [])));
  assert_eq(of_extension("m\u{212A}v"), None);
  assert_eq(of_path("site/index.html"), html);
  assert_eq(of_path("a/b.tar.gz"), Some(MediaType("application", "gzip", [])));
  assert_eq(of_path("photo.JPG"), Some(MediaType("image", "jpeg", [])));
  assert_eq(of_path("a.d/README"), None);
  assert_eq(of_path(".gitignore"), None);
  assert_eq(of_path("archive."), None);
  assert_eq(of_path(""), None)
}

test "a type's extensions are its row, the preferred one first, whatever its case or parameters" {
  let jpeg = MediaType("IMAGE", "JPEG", [{ name: "q", value: "0.5" }]);
  assert_eq(extensions(jpeg), ["jpg", "jpeg", "jpe"]);
  assert_eq(extension(jpeg), Some("jpg"));
  assert_eq(extension(MediaType("audio", "mpeg", [])), Some("mp3"));
  assert_eq(extension(MediaType("text", "plain", [])), Some("txt"));
  assert_eq(extension(MediaType("application", "octet-stream", [])), Some("bin"));
  // A type that shares its extension with an earlier row still names it.
  assert_eq(extensions(MediaType("text", "xml", [])), ["xml"]);
  assert_eq(of_extension("xml"), Some(MediaType("application", "xml", [])));
  assert_eq(extensions(MediaType("application", "x-no-such-type", [])), []);
  assert_eq(extension(MediaType("application", "x-no-such-type", [])), None)
}

test "every row is a media type in lower case, and every extension names a type that lists it" {
  let t = table();
  assert(map_len(t.extensions) > 400);
  assert(map_len(t.types) > 550);
  assert_eq(
    filter(map_keys(t.extensions), |named: String|
      match parse(named) {
        Ok(m) -> render(m) != named || len(extensions(m)) == 0,
        Err(_) -> true,
      }),
    [],
  );
  assert_eq(
    filter(map_keys(t.types), |ext: String|
      ext != ascii_lower(ext)
        || (match of_extension(ext) { Some(m) -> !contains(extensions(m), ext), None -> true })),
    [],
  )
}

test "a lookup reads the table and does not walk it" {
  let first = metered(|| of_extension("html"));
  let last = metered(|| of_extension("buffer"));
  let absent = metered(|| of_extension("no-such-extension"));
  assert_eq(first.value, Some(MediaType("text", "html", [])));
  assert_eq(last.value, Some(MediaType("application", "octet-stream", [])));
  assert_eq(first.steps, last.steps);
  assert(first.steps < 10 && absent.steps < 10);
  let back = metered(|| extensions(MediaType("application", "octet-stream", [])));
  assert_eq(list_at(back.value, 0), Some("bin"));
  assert(back.steps < 10)
}
