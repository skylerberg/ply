//! Text outside ASCII in a header field: RFC 2047's encoded words, and RFC 2231's and RFC 8187's
//! extended parameter values.
//!
//! An encoded word is `=?charset?coding?text?=`: a charset's name, `Q` or `B`, and bytes written
//! in that coding. `Q` is quoted-printable cut down to what every header position takes, with `_`
//! for a space, and `B` is base64. `encode` leaves printable ASCII that holds no `=?` as it is and
//! writes any other text as UTF-8 words of at most 75 characters with a space between them, never
//! splitting a character; `encode_words` answers the words themselves, whatever the text holds.
//! `read` gives back the text of a field's value: each encoded word is decoded wherever it stands,
//! blanks between two of them are dropped, and everything else is kept as written. Whatever has
//! the shape of an encoded word must be one, so a charset or a coding this module does not know,
//! encoded text that is not its coding's and bytes that are no text in the charset each raise a
//! `Refusal`, which `decode` answers as an `Err`; a word longer than 75 characters is read all the
//! same. `pieces` answers the stretches `read` is made of, each word with what it carries or why
//! it carries nothing, for a reader that keeps a word it cannot read as written.
//!
//! An extended value is `charset'language'text`, with the text's bytes percent-encoded: what a
//! parameter named with a trailing `*`, `filename*=UTF-8''na%C3%AFve.txt`, carries. The language is
//! read and dropped. RFC 2231 also cuts a value into sections, `name*0*`, `name*1`, of which only
//! the first names the charset: `read_sections` reads them as one value and `encode_sections`
//! writes one. Which parameters are sections of one value is `std.mime`'s to say.
//!
//! The charsets read and written are UTF-8, US-ASCII, ISO-8859-1, ISO-8859-2, ISO-8859-15,
//! windows-1250, windows-1251, windows-1252 and KOI8-R. Any other is refused by name.

import std.base64 (base64_decode, base64_encode)
import std.bytes (peek, repeat, replace, scan, scan_until)
import std.laws (round_trip)
import std.quoted_printable (escape, unescape)
import std.list (at_or, concat)
import std.result (result_ok)
import std.show (show)
import std.string (ascii_lower, code_points, join, of_code_points)
import std.url (url_encode)

/// A character set this module reads and writes.
pub type Charset =
  | Utf8
  | UsAscii
  /// ISO-8859-1.
  | Latin1
  /// ISO-8859-2, central Europe's.
  | Latin2
  /// ISO-8859-15: ISO-8859-1 with the euro sign and the letters French and Finnish lacked.
  | Latin9
  | Windows1250
  | Windows1251
  | Windows1252
  | Koi8R

/// How an encoded word writes its bytes.
pub type Coding =
  /// Printable ASCII as itself, `_` for a space, and `=` with two hex digits for any other byte.
  | Q
  /// Base64.
  | B

/// Why a text is refused.
pub type Why =
  /// A charset this module does not read, with its name as written.
  | UnknownCharset(String)
  /// An encoded word whose coding is neither `Q` nor `B`, with the coding as written.
  | UnknownCoding(String)
  /// Encoded text that is not its coding's: a stray `=` in `Q`, base64 that is not canonical, or in
  /// an extended value a `%` without two hex digits or a character that must be escaped.
  | BadText
  /// Bytes that are no text in the charset named.
  | BadBytes
  /// An extended value without the two `'` that end its charset and its language.
  | NoCharset

/// A refusal, and the byte of the text's UTF-8 it was found at.
pub type Refusal = { at: Int, why: Why }

/// What a reader of this module raises where it refuses.
pub effect encoded_word {
  /// The text holds an encoded word or an extended value that cannot be read.
  raise refused(e: Refusal)
}

fn refuse<a>(at: Int, why: Why) -> a / {encoded_word.refused} =
  encoded_word.refused({ at: at, why: why })

// --- Charsets ---------------------------------------------------------------

/// The charset a name means, in any case: `utf-8` and `utf8`; `us-ascii` and `ascii`;
/// `iso-8859-1`, `iso8859-1`, `iso_8859-1`, `latin1` and `l1`, and the same five spellings of
/// ISO-8859-2 and ISO-8859-15 (`latin2`, `l2`, `latin9`, `l9`); `windows-1250`, `windows-1251` and
/// `windows-1252`, each also as `cp125x`; and `koi8-r`.
pub fn charset_named(name: String) -> Option<Charset> =
  match ascii_lower(name) {
    "utf-8" | "utf8" -> Some(Utf8),
    "us-ascii" | "ascii" -> Some(UsAscii),
    "iso-8859-1" | "iso8859-1" | "iso_8859-1" | "latin1" | "l1" -> Some(Latin1),
    "iso-8859-2" | "iso8859-2" | "iso_8859-2" | "latin2" | "l2" -> Some(Latin2),
    "iso-8859-15" | "iso8859-15" | "iso_8859-15" | "latin9" | "l9" -> Some(Latin9),
    "windows-1250" | "cp1250" -> Some(Windows1250),
    "windows-1251" | "cp1251" -> Some(Windows1251),
    "windows-1252" | "cp1252" -> Some(Windows1252),
    "koi8-r" -> Some(Koi8R),
    _ -> None,
  }

/// The name a charset is registered under.
pub fn charset_name(c: Charset) -> String =
  match c {
    Utf8 -> "UTF-8",
    UsAscii -> "US-ASCII",
    Latin1 -> "ISO-8859-1",
    Latin2 -> "ISO-8859-2",
    Latin9 -> "ISO-8859-15",
    Windows1250 -> "windows-1250",
    Windows1251 -> "windows-1251",
    Windows1252 -> "windows-1252",
    Koi8R -> "KOI8-R",
  }

/// Every charset this module reads and writes.
pub fn charsets() -> List<Charset> =
  [Utf8, UsAscii, Latin1, Latin2, Latin9, Windows1250, Windows1251, Windows1252, Koi8R]

/// The text `data` is in a charset; `None` where it is none: bytes that are not UTF-8, one past
/// 127 in US-ASCII, or one a single-byte charset gives no character. Every byte is a character of
/// ISO-8859-1, ISO-8859-2, ISO-8859-15 and KOI8-R.
pub fn text_of(c: Charset, data: Bytes) -> Option<String> / {abort.raise} =
  match c {
    Utf8 -> if bytes_is_utf8(data) { Some(string_of_bytes(data)) } else { None },
    UsAscii -> if is_ascii(data) { Some(string_of_bytes(data)) } else { None },
    _ -> {
      let points = points_of(c);
      of_code_points(map(range(0, bytes_len(data)), |i: Int| at_or(points, bytes_at(data, i), -1)))
    },
  }

/// `text` in a charset; `None` where it holds a character the charset does not.
pub fn bytes_of(c: Charset, text: String) -> Option<Bytes> / {abort.raise} =
  match c {
    Utf8 -> Some(bytes_of_string(text)),
    UsAscii -> if is_ascii(bytes_of_string(text)) { Some(bytes_of_string(text)) } else { None },
    _ -> {
      let held = fold(enumerate_points(points_of(c)), map_new(), |m: Map<Int, Int>, p: Point|
        if p.point < 0 { m } else { map_insert(m, p.point, p.byte) });
      let found = map(code_points(text), |p: Int| map_get(held, p));
      if fold(found, true, |ok: Bool, b: Option<Int>| ok && b != None) {
        Some(
          bytes_concat_all(
            map(found, |b: Option<Int>| match b { Some(n) -> byte_of_int(n), None -> b"" }),
          ),
        )
      } else { None }
    },
  }

type Point = { byte: Int, point: Int }

fn enumerate_points(points: List<Int>) -> List<Point> =
  map(range(0, len(points)), |b: Int| { byte: b, point: at_or(points, b, -1) })

/// The character of each byte of a single-byte charset, by its scalar value: `-1` for a byte the
/// charset gives none. A byte outside the charset's table is ISO-8859-1's.
fn points_of(c: Charset) -> List<Int> / {abort.raise} = {
  let first = table_start(c);
  let held = map(code_points(table(c)), |p: Int| if p == 0xFFFD { -1 } else { p });
  concat(concat(range(0, first), held), range(first + len(held), 256))
}

/// The byte a single-byte charset's table starts at.
fn table_start(c: Charset) -> Int =
  match c {
    Latin2 | Latin9 -> 0xA0,
    Windows1250 | Windows1251 | Windows1252 | Koi8R -> 0x80,
    _ -> 256,
  }

/// The characters of a single-byte charset's bytes from `table_start` on, as far as it leaves
/// ISO-8859-1: `U+FFFD` for a byte it gives no character. Each is what the Unicode Consortium's
/// mapping of the charset gives the byte.
fn table(c: Charset) -> String =
  match c {
    Latin2 ->
      "\u{A0}Ą˘Ł¤ĽŚ§¨ŠŞŤŹ\u{AD}ŽŻ°ą˛ł´ľśˇ¸šşťź˝žż"
        ++ "ŔÁÂĂÄĹĆÇČÉĘËĚÍÎĎĐŃŇÓÔŐÖ×ŘŮÚŰÜÝŢß"
        ++ "ŕáâăäĺćçčéęëěíîďđńňóôőö÷řůúűüýţ˙",
    Latin9 -> "\u{A0}¡¢£€¥Š§š©ª«¬\u{AD}®¯°±²³Žµ¶·ž¹º»ŒœŸ¿",
    Windows1250 ->
      "€\u{FFFD}‚\u{FFFD}„…†‡\u{FFFD}‰Š‹ŚŤŽŹ\u{FFFD}‘’“”•–—\u{FFFD}™š›śťžź"
        ++ "\u{A0}ˇ˘Ł¤Ą¦§¨©Ş«¬\u{AD}®Ż°±˛ł´µ¶·¸ąş»Ľ˝ľż"
        ++ "ŔÁÂĂÄĹĆÇČÉĘËĚÍÎĎĐŃŇÓÔŐÖ×ŘŮÚŰÜÝŢß"
        ++ "ŕáâăäĺćçčéęëěíîďđńňóôőö÷řůúűüýţ˙",
    Windows1251 ->
      "ЂЃ‚ѓ„…†‡€‰Љ‹ЊЌЋЏђ‘’“”•–—\u{FFFD}™љ›њќћџ"
        ++ "\u{A0}ЎўЈ¤Ґ¦§Ё©Є«¬\u{AD}®Ї°±Ііґµ¶·ё№є»јЅѕї"
        ++ "АБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ"
        ++ "абвгдежзийклмнопрстуфхцчшщъыьэюя",
    Windows1252 ->
      "€\u{FFFD}‚ƒ„…†‡ˆ‰Š‹Œ\u{FFFD}Ž\u{FFFD}\u{FFFD}‘’“”•–—˜™š›œ\u{FFFD}žŸ",
    Koi8R ->
      "─│┌┐└┘├┤┬┴┼▀▄█▌▐░▒▓⌠■∙√≈≤≥\u{A0}⌡°²·÷"
        ++ "═║╒ё╓╔╕╖╗╘╙╚╛╜╝╞╟╠╡Ё╢╣╤╥╦╧╨╩╪╫╬©"
        ++ "юабцдефгхийклмнопярстужвьызшэщчъ"
        ++ "ЮАБЦДЕФГХИЙКЛМНОПЯРСТУЖВЬЫЗШЭЩЧЪ",
    _ -> "",
  }

fn is_ascii(data: Bytes) -> Bool = bytes_position(data, 0, |c: Int| c > 127) == None

// --- Encoded words ----------------------------------------------------------

/// `text` as a header field carries it: itself where it is printable ASCII holding no `=?`, and
/// otherwise UTF-8 encoded words in `coding`, each at most 75 characters and holding whole
/// characters, with a space between them.
pub fn encode(text: String, coding: Coding) -> String / {abort.raise} =
  if is_plain(text) { text } else { join(encode_words(text, coding), " ") }

/// `text` as UTF-8 encoded words in `coding` whatever it holds, printable ASCII too: each word at
/// most 75 characters and holding whole characters. A text of nothing is no word.
pub fn encode_words(text: String, coding: Coding) -> List<String> / {abort.raise} =
  map(chunks(text, coding), |chunk: Bytes| word(chunk, coding))

/// One stretch of a field's value.
pub type Piece =
  /// Text that is no encoded word, as written.
  | Literal(String)
  /// An encoded word as written, and the text it carries or why it carries none.
  | Word(String, Result<String, Refusal>)

/// The stretches `text` is made of, in order, each encoded word apart from what stands around it.
/// Nothing is left out, the blanks between two encoded words included: the stretches as written,
/// one after another, are `text`. A refusal's offset is the word's place in `text`.
pub fn pieces(text: String) -> List<Piece> / {abort.raise} = {
  let b = bytes_of_string(text);
  words(b, { at: 0, out: [] }, bytes_len(b) + 1)
}

/// The text of a field's value with each encoded word in it decoded, raising
/// `encoded_word.refused` where `decode` answers `Err`.
pub fn read(text: String) -> String / {encoded_word.refused, abort.raise} = {
  let read = fold(pieces(text), { out: [], gap: "", joined: false }, |j: Joining, p: Piece|
    match p {
      Literal(written) -> if j.joined && is_blank(written) { { ..j, gap: written } }
      else { { out: push(push(j.out, j.gap), written), gap: "", joined: false } },
      Word(_, Ok(carried)) -> { out: push(j.out, carried), gap: "", joined: true },
      Word(_, Err(r)) -> refuse(r.at, r.why),
    });
  join(push(read.out, read.gap), "")
}

/// The text read so far, the blanks that stand after an encoded word, which are dropped where
/// another follows them, and whether an encoded word was the last thing read.
type Joining = { out: List<String>, gap: String, joined: Bool }

/// Whether `text` is nothing but spaces, tabs and line breaks: what stands between two encoded
/// words that are read as one text.
pub fn is_blank(text: String) -> Bool / {abort.raise} = {
  let b = bytes_of_string(text);
  scan(b, 0, b" \t\r\n") == bytes_len(b)
}

/// The text of a field's value with each encoded word in it decoded, or where one cannot be read
/// and why.
pub fn decode(text: String) -> Result<String, Refusal> / {abort.raise} = try { read(text) }

fn printable() -> Bytes =
  b" !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"

/// What `Q` writes as itself: the characters every header position takes.
fn q_safe() -> Bytes = b"!*+-/0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"

fn is_plain(text: String) -> Bool / {abort.raise} = {
  let b = bytes_of_string(text);
  !string_contains(text, "=?") && scan(b, 0, printable()) == bytes_len(b)
}

/// The most of a word's 75 characters its text may take, in what `width` counts: `=?UTF-8?Q?` and
/// `?=` take twelve, and base64 writes three bytes as four characters.
fn room_of(coding: Coding) -> Int = match coding { Q -> 63, B -> 45 }

/// What a character's bytes take of a word's room.
fn width(bytes: Bytes, coding: Coding) -> Int / {abort.raise} =
  match coding {
    B -> bytes_len(bytes),
    Q ->
      fold(range(0, bytes_len(bytes)), 0, |sum: Int, i: Int|
        sum + bytes_len(q_written(bytes_at(bytes, i)))),
  }

fn q_written(c: Int) -> Bytes / {abort.raise} =
  if c == b' ' { b"_" }
  else if scan(byte_of_int(c), 0, q_safe()) == 1 { byte_of_int(c) }
  else { escape(c) }

type Chunking = { done: List<Bytes>, held: List<Bytes>, room: Int }

/// The UTF-8 of `text` cut between characters into stretches that each fit one word.
fn chunks(text: String, coding: Coding) -> List<Bytes> / {abort.raise} = {
  let cut = fold(
    string_chars(text),
    { done: [], held: [], room: room_of(coding) },
    |c: Chunking, char: Char| {
      let bytes = bytes_of_string(string_of_chars([char]));
      let wide = width(bytes, coding);
      if wide > c.room {
        {
          done: push(c.done, bytes_concat_all(c.held)),
          held: [bytes],
          room: room_of(coding) - wide,
        }
      } else { { done: c.done, held: push(c.held, bytes), room: c.room - wide } }
    },
  );
  if len(cut.held) == 0 { cut.done } else { push(cut.done, bytes_concat_all(cut.held)) }
}

fn word(chunk: Bytes, coding: Coding) -> String / {abort.raise} =
  match coding {
    B -> "=?UTF-8?B?" ++ base64_encode(chunk) ++ "?=",
    Q ->
      "=?UTF-8?Q?"
        ++ string_of_bytes(
          bytes_concat_all(map(range(0, bytes_len(chunk)), |i: Int| q_written(bytes_at(chunk, i)))),
        )
        ++ "?=",
  }

type Scan = { at: Int, out: List<Piece> }

/// The stretches of the text from `s.at` on. `left` bounds the rounds: each takes a `=?`.
fn words(b: Bytes, s: Scan, left: Int) -> List<Piece> / {abort.raise} =
  if left <= 0 { s.out } else {
    match bytes_index_of_from(b, b"=?", s.at) {
      None -> with_literal(s.out, b, s.at, bytes_len(b)),
      Some(open) -> match word_at(b, open) {
        None -> words(b, { at: open + 2, out: with_literal(s.out, b, s.at, open + 2) }, left - 1),
        Some(w) ->
          words(
            b,
            {
              at: w.end,
              out: push(
                with_literal(s.out, b, s.at, open),
                Word(string_of_bytes(bytes_slice(b, open, w.end)), word_read(b, w)),
              ),
            },
            left - 1,
          ),
      },
    }
  }

fn with_literal(out: List<Piece>, b: Bytes, from: Int, to: Int) -> List<Piece> / {abort.raise} =
  if to <= from { out } else { push(out, Literal(string_of_bytes(bytes_slice(b, from, to)))) }

/// Where the pieces of an encoded word stand.
type Word = { charset_at: Int, coding_at: Int, text_at: Int, text_end: Int, end: Int }

/// The encoded word whose `=?` is at `open`, if what follows has the shape of one.
fn word_at(b: Bytes, open: Int) -> Option<Word> / {abort.raise} = {
  let stops = b"? \t\r\n";
  let charset_end = scan_until(b, open + 2, stops);
  let coding_end = scan_until(b, charset_end + 1, stops);
  let text_end = scan_until(b, coding_end + 1, stops);
  if charset_end == open + 2 || coding_end == charset_end + 1 { None }
  else if peek(b, charset_end) != b'?' || peek(b, coding_end) != b'?' { None }
  else if peek(b, text_end) != b'?' || peek(b, text_end + 1) != b'=' { None } else {
    Some({
      charset_at: open + 2,
      coding_at: charset_end + 1,
      text_at: coding_end + 1,
      text_end: text_end,
      end: text_end + 2,
    })
  }
}

fn word_read(b: Bytes, w: Word) -> Result<String, Refusal> / {abort.raise} = {
  let named = string_of_bytes(bytes_slice(b, w.charset_at, w.coding_at - 1));
  // RFC 2231 lets a language follow the charset after a `*`.
  let name = match string_split(named, "*") { [first, ..] -> first, [] -> named };
  let coding = string_of_bytes(bytes_slice(b, w.coding_at, w.text_at - 1));
  let coded = bytes_slice(b, w.text_at, w.text_end);
  match charset_named(name) {
    None -> Err({ at: w.charset_at, why: UnknownCharset(name) }),
    Some(charset) -> match word_bytes(ascii_lower(coding), coded) {
      None -> Err({ at: w.coding_at, why: UnknownCoding(coding) }),
      Some(None) -> Err({ at: w.text_at, why: BadText }),
      Some(Some(found)) -> match text_of(charset, found) {
        Some(text) -> Ok(text),
        None -> Err({ at: w.text_at, why: BadBytes }),
      },
    },
  }
}

/// The bytes a word's text is in the coding named in lower case: `None` for a coding that is
/// neither, and `Some(None)` for text that is not the coding's.
fn word_bytes(coding: String, coded: Bytes) -> Option<Option<Bytes>> / {abort.raise} =
  match coding {
    "q" -> Some(result_ok(unescape(replace(coded, b"_", b" "), b'=', printable()))),
    "b" -> Some(base64_decode(string_of_bytes(coded))),
    _ -> None,
  }

// --- Extended values --------------------------------------------------------

/// `text` as an extended parameter value: `UTF-8''` and its bytes percent-encoded.
pub fn encode_extended(text: String) -> String / {abort.raise} = "UTF-8''" ++ url_encode(text)

/// The text an extended parameter value carries, raising `encoded_word.refused` where
/// `decode_extended` answers `Err`.
pub fn read_extended(value: String) -> String / {encoded_word.refused, abort.raise} =
  read_sections([{ text: value, extended: true }])

/// The text an extended parameter value carries, or where it cannot be read and why.
pub fn decode_extended(value: String) -> Result<String, Refusal> / {abort.raise} =
  try { read_extended(value) }

/// One section of a parameter's value as RFC 2231 cuts it: its text as written, and whether it
/// is extended, which is percent-encoded and, for a value's first section, opens with the charset
/// and the language.
pub type Section = { text: String, extended: Bool }

/// The value its sections carry together, in the order given, raising `encoded_word.refused`
/// where `decode_sections` answers `Err`. Where none is extended the value is their texts as
/// written. Otherwise the first names the charset, each extended section is that charset's bytes
/// percent-encoded, and any other is text the charset must hold; a character's bytes may lie in
/// two sections. A refusal's offset counts through the sections' texts one after another.
pub fn read_sections(sections: List<Section>) -> String / {encoded_word.refused, abort.raise} =
  match sections {
    [] -> "",
    [first, ..rest] -> if !fold(sections, false, |any: Bool, s: Section| any || s.extended) {
      join(map(sections, |s: Section| s.text), "")
    } else if !first.extended { refuse(0, NoCharset) }
    else { extended_value(first.text, rest) },
  }

/// The value of an extended first section and the sections after it.
fn extended_value(
  head: String,
  rest: List<Section>,
) -> String / {encoded_word.refused, abort.raise} = {
  let b = bytes_of_string(head);
  let n = bytes_len(b);
  let first = scan_until(b, 0, b"'");
  let second = scan_until(b, first + 1, b"'");
  if second >= n { refuse(n, NoCharset) } else {
    let name = string_of_bytes(bytes_slice(b, 0, first));
    let charset = match charset_named(name) {
      Some(c) -> c,
      None -> refuse(0, UnknownCharset(name)),
    };
    let opening = string_of_bytes(bytes_slice(b, second + 1, n));
    let read = fold(
      rest,
      { out: [section_bytes(charset, { text: opening, extended: true }, second + 1)], at: n },
      |r: { out: List<Bytes>, at: Int }, s: Section|
        {
          out: push(r.out, section_bytes(charset, s, r.at)),
          at: r.at + bytes_len(bytes_of_string(s.text)),
        },
    );
    match text_of(charset, bytes_concat_all(read.out)) {
      Some(text) -> text,
      None -> refuse(second + 1, BadBytes),
    }
  }
}

/// The bytes one section stands for, where its text starts at `at`.
fn section_bytes(
  charset: Charset,
  s: Section,
  at: Int,
) -> Bytes / {encoded_word.refused, abort.raise} =
  if s.extended {
    match unescape(bytes_of_string(s.text), b'%', attr_chars()) {
      Ok(found) -> found,
      Err(i) -> refuse(at + i, BadText),
    }
  } else { match bytes_of(charset, s.text) { Some(found) -> found, None -> refuse(at, BadBytes) } }

/// The value its sections carry together, or where it cannot be read and why.
pub fn decode_sections(sections: List<Section>) -> Result<String, Refusal> / {abort.raise} =
  try { read_sections(sections) }

/// `text` as the extended sections of one value: its UTF-8 percent-encoded and cut between
/// characters, the first section opening with `UTF-8''`, and each at most `room` characters
/// wherever one character's escapes leave room. A text that fits is one section, which is
/// `encode_extended`'s value.
pub fn encode_sections(text: String, room: Int) -> List<String> / {abort.raise} = {
  let cut = fold(
    string_chars(text),
    { done: [], held: "UTF-8''" },
    |c: { done: List<String>, held: String }, char: Char| {
      let escaped = url_encode(string_of_chars([char]));
      if string_len(c.held) + string_len(escaped) > room {
        { done: push(c.done, c.held), held: escaped }
      } else { { done: c.done, held: c.held ++ escaped } }
    },
  );
  push(cut.done, cut.held)
}

/// RFC 8187's `attr-char`: what an extended value writes without a `%`.
fn attr_chars() -> Bytes =
  b"!#$&+-.^_`|~0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"

// --- Tests ------------------------------------------------------------------

law "a decode of Q words is the text encoded" =
  round_trip(|text: String| encode(text, Q), |field: String| result_ok(decode(field)))

law "a decode of B words is the text encoded" =
  round_trip(|text: String| encode(text, B), |field: String| result_ok(decode(field)))

law "a decode of an extended value is the text encoded" =
  round_trip(encode_extended, |value: String| result_ok(decode_extended(value)))

law "an encoding is ASCII, and each of its words at most 75 characters"
  forall (text: String) {
    is_plain(text)
      || fold([Q, B], true, |ok: Bool, coding: Coding|
        ok && is_ascii(bytes_of_string(encode(text, coding)))
          && fold(string_split(encode(text, coding), " "), true, |short: Bool, w: String|
            short && string_len(w) <= 75 && string_starts_with(w, "=?UTF-8?")
              && string_ends_with(w, "?=")))
  }

law "every byte string is text in ISO-8859-1, ISO-8859-2, ISO-8859-15 and KOI8-R"
  forall (data: Bytes) {
    fold([Latin1, Latin2, Latin9, Koi8R], true, |ok: Bool, c: Charset|
      ok && text_of(c, data) != None)
  }

law "bytes that are text in a charset write back as they were"
  forall (data: Bytes) {
    fold(charsets(), true, |ok: Bool, c: Charset|
      ok
        && (match text_of(c, data) { Some(text) -> bytes_of(c, text) == Some(data), None -> true }))
  }

law "a text is its UTF-8, and its bytes in any other charset only where they read back"
  forall (text: String) {
    fold(charsets(), true, |ok: Bool, c: Charset|
      ok
        && (match bytes_of(c, text) {
          Some(data) -> text_of(c, data) == Some(text),
          None -> c != Utf8,
        }))
  }

law "the stretches of a text, as written, are the text"
  forall (text: String) {
    join(
        map(pieces(text), |p: Piece|
          match p { Literal(written) -> written, Word(written, _) -> written }),
        "",
      )
      == text
  }

law "encoded words are read back whatever the text holds"
  forall (text: String) {
    fold([Q, B], true, |ok: Bool, coding: Coding|
      ok && decode(join(encode_words(text, coding), " ")) == Ok(text))
  }

law "the sections of a value read back as it, whatever room each is given"
  forall (text: String, room: Int) {
    let sections = encode_sections(text, room % 40);
    decode_sections(map(sections, |s: String| { text: s, extended: true })) == Ok(text)
      && (room % 40 < 19
      || fold(sections, true, |short: Bool, s: String| short && string_len(s) <= room % 40))
  }

type Vector = { field: String, text: String }

/// Field values and the text they carry. The first seven are fields of RFC 2047 §8's messages and
/// the next seven rows of its table of what a reader displays; the one in a charset this module
/// does not read is among `refused`.
fn vectors() -> List<Vector> =
  [
    {
      field: "=?US-ASCII?Q?Keith_Moore?= <moore@cs.utk.edu>",
      text: "Keith Moore <moore@cs.utk.edu>",
    },
    {
      field: "=?ISO-8859-1?Q?Keld_J=F8rn_Simonsen?= <keld@dkuug.dk>",
      text: "Keld J\u{f8}rn Simonsen <keld@dkuug.dk>",
    },
    {
      field: "=?ISO-8859-1?Q?Andr=E9?= Pirard <PIRARD@vm1.ulg.ac.be>",
      text: "Andr\u{e9} Pirard <PIRARD@vm1.ulg.ac.be>",
    },
    { field: "=?ISO-8859-1?B?SWYgeW91IGNhbiByZWFkIHRoaXMgeW8=?=", text: "If you can read this yo" },
    {
      field: "=?ISO-8859-1?B?SWYgeW91IGNhbiByZWFkIHRoaXMgeW8=?= =?ISO-8859-2?B?dSB1bmRlcnN0YW5kIHRoZSBleGFtcGxlLg==?=",
      text: "If you can read this you understand the example.",
    },
    {
      field: "=?ISO-8859-1?Q?Olle_J=E4rnefors?= <ojarnef@admin.kth.se>",
      text: "Olle J\u{e4}rnefors <ojarnef@admin.kth.se>",
    },
    {
      field: "=?ISO-8859-1?Q?Patrik_F=E4ltstr=F6m?= <paf@nada.kth.se>",
      text: "Patrik F\u{e4}ltstr\u{f6}m <paf@nada.kth.se>",
    },
    { field: "(=?ISO-8859-1?Q?a?=)", text: "(a)" },
    { field: "(=?ISO-8859-1?Q?a?= b)", text: "(a b)" },
    { field: "(=?ISO-8859-1?Q?a?= =?ISO-8859-1?Q?b?=)", text: "(ab)" },
    { field: "(=?ISO-8859-1?Q?a?=  =?ISO-8859-1?Q?b?=)", text: "(ab)" },
    { field: "(=?ISO-8859-1?Q?a?=\r\n    =?ISO-8859-1?Q?b?=)", text: "(ab)" },
    { field: "(=?ISO-8859-1?Q?a_b?=)", text: "(a b)" },
    { field: "(=?ISO-8859-1?Q?a?= =?US-ASCII?Q?_b?=)", text: "(a b)" },
    { field: "(=?ISO-8859-1?Q?a?= =?ISO-8859-2?Q?_b?=)", text: "(a b)" },
    { field: "=?windows-1252?Q?=80_=93quoted=94?=", text: "\u{20ac} \u{201c}quoted\u{201d}" },
    { field: "=?ISO-8859-15?Q?=A4uro?=", text: "\u{20ac}uro" },
    { field: "=?koi8-r?B?8NLJ18XU?=", text: "\u{41f}\u{440}\u{438}\u{432}\u{435}\u{442}" },
    {
      field: "=?windows-1251?Q?=CF=F0=E8=E2=E5=F2?=",
      text: "\u{41f}\u{440}\u{438}\u{432}\u{435}\u{442}",
    },
    { field: "=?CP1250?Q?=8Aal=E1t?=", text: "\u{160}al\u{e1}t" },
    {
      field: "Nathaniel Borenstein <nsb@thumper.bellcore.com>",
      text: "Nathaniel Borenstein <nsb@thumper.bellcore.com>",
    },
    { field: "=?utf-8?q?caf=c3=a9?=", text: "caf\u{e9}" },
    { field: "=?UTF-8*fr?B?Y2Fmw6k=?=", text: "caf\u{e9}" },
    { field: "=?UTF-8?Q??=", text: "" },
    { field: "a =?UTF-8?Q?b?= c =?UTF-8?Q?d?=", text: "a b c d" },
    { field: "=? not a word ?= and =?half?", text: "=? not a word ?= and =?half?" },
    { field: "1 + 1 =?", text: "1 + 1 =?" },
    { field: "=? =?UTF-8?Q?a?=", text: "=? a" },
    { field: "=?UTF-8?Q?a?=x =?UTF-8?Q?b?=", text: "ax b" },
    { field: "=??Q?a?=", text: "=??Q?a?=" },
    { field: "=??Q?a?b?=", text: "=??Q?a?b?=" },
    { field: "=?UTF-8??a?=", text: "=?UTF-8??a?=" },
    { field: "=?UTF-8??a?b?=", text: "=?UTF-8??a?b?=" },
    { field: "=?UTF-8 Q?a?=", text: "=?UTF-8 Q?a?=" },
    { field: "=?UTF-8?Q a?=", text: "=?UTF-8?Q a?=" },
    { field: "=?UTF-8?B?Y2Fm?w6k=?=", text: "=?UTF-8?B?Y2Fm?w6k=?=" },
    { field: "", text: "" },
  ]

test "reads {show(c.field)}" for c: Vector in vectors() { assert_eq(decode(c.field), Ok(c.text)) }

type Refused = { field: String, at: Int, why: Why }

/// Field values that cannot be read. The first is RFC 2047 §8's in the charset of Hebrew.
fn refused() -> List<Refused> =
  [
    { field: "=?iso-8859-8?b?7eXs+SDv4SDp7Oj08A==?=", at: 2, why: UnknownCharset("iso-8859-8") },
    {
      field: "=?ISO-8859-1?B?SWYgeW91IGNhbiByZWFkIHRoaXMgeW8=?= =?ISO-2022-JP?B?dSB1bmRlcnN0YW5k?=",
      at: 52,
      why: UnknownCharset("ISO-2022-JP"),
    },
    { field: "=?windows-1252?Q?=81?=", at: 17, why: BadBytes },
    { field: "=?UTF-8?X?abc?=", at: 8, why: UnknownCoding("X") },
    { field: "=?UTF-8?Q?a=ZZ?=", at: 10, why: BadText },
    { field: "=?UTF-8?Q?a=4?=", at: 10, why: BadText },
    { field: "=?UTF-8?B?abc?=", at: 10, why: BadText },
    { field: "=?UTF-8?Q?=FF?=", at: 10, why: BadBytes },
    { field: "=?US-ASCII?Q?caf=E9?=", at: 13, why: BadBytes },
    { field: "ok =?UTF-8?Q?a?= =?Big5?Q?b?=", at: 19, why: UnknownCharset("Big5") },
  ]

test "refuses {show(c.field)}" for c: Refused in refused() {
  assert_eq(decode(c.field), Err({ at: c.at, why: c.why }))
}

test "the raising readers raise what the others answer" {
  assert_eq(try { read("=?x?q?a?=") }, Err({ at: 2, why: UnknownCharset("x") }));
  assert_eq(try { read_extended("UTF-8'%41") }, Err({ at: 9, why: NoCharset }))
}

test "plain text is left alone, and anything else is words in the coding asked for" {
  assert_eq(encode("Hello, world", Q), "Hello, world");
  assert_eq(encode("", B), "");
  assert_eq(encode("caf\u{e9} au lait", Q), "=?UTF-8?Q?caf=C3=A9_au_lait?=");
  assert_eq(encode("caf\u{e9}", B), "=?UTF-8?B?Y2Fmw6k=?=");
  assert_eq(encode("a=?b", Q), "=?UTF-8?Q?a=3D=3Fb?=");
  assert_eq(encode("tab\there", Q), "=?UTF-8?Q?tab=09here?=");
  assert_eq(encode("\tx", Q), "=?UTF-8?Q?=09x?=");
  assert_eq(encode("\u{e9}", Q), "=?UTF-8?Q?=C3=A9?=");
  assert_eq(encode("under_score \u{20ac}", Q), "=?UTF-8?Q?under=5Fscore_=E2=82=AC?=")
}

test "a long text is cut between characters into words of at most 75" {
  let euros = string_of_chars(map(range(0, 20), |_: Int| '\u{20ac}'));
  assert_eq(string_split(encode(euros, Q), " "), [
    "=?UTF-8?Q?=E2=82=AC=E2=82=AC=E2=82=AC=E2=82=AC=E2=82=AC=E2=82=AC=E2=82=AC?=",
    "=?UTF-8?Q?=E2=82=AC=E2=82=AC=E2=82=AC=E2=82=AC=E2=82=AC=E2=82=AC=E2=82=AC?=",
    "=?UTF-8?Q?=E2=82=AC=E2=82=AC=E2=82=AC=E2=82=AC=E2=82=AC=E2=82=AC?=",
  ]);
  assert_eq(string_split(encode(euros, B), " "), [
    "=?UTF-8?B?4oKs4oKs4oKs4oKs4oKs4oKs4oKs4oKs4oKs4oKs4oKs4oKs4oKs4oKs4oKs?=",
    "=?UTF-8?B?4oKs4oKs4oKs4oKs4oKs?=",
  ]);
  assert_eq(decode(encode(euros, Q)), Ok(euros));
  assert_eq(decode(encode(euros, B)), Ok(euros));
  let letters = |n: Int| "\u{e9}" ++ string_of_chars(map(range(0, n), |_: Int| 'a'));
  assert_eq(map(string_split(encode(letters(57), Q), " "), string_len), [75]);
  assert_eq(map(string_split(encode(letters(58), Q), " "), string_len), [75, 13]);
  assert_eq(map(string_split(encode(letters(43), B), " "), string_len), [72]);
  assert_eq(map(string_split(encode(letters(44), B), " "), string_len), [72, 16])
}

type Extended = { value: String, text: String }

/// Extended values and their text: RFC 8187 §3.2.3's two, RFC 6266 §5's, and what the grammar
/// leaves to a reader.
fn extended() -> List<Extended> =
  [
    { value: "iso-8859-1'en'%A3%20rates", text: "\u{a3} rates" },
    { value: "UTF-8''%c2%a3%20and%20%e2%82%ac%20rates", text: "\u{a3} and \u{20ac} rates" },
    { value: "UTF-8''%e2%82%ac%20rates", text: "\u{20ac} rates" },
    { value: "utf-8'en-GB'plain.txt", text: "plain.txt" },
    { value: "US-ASCII''", text: "" },
    { value: "windows-1252'de'%80%20Kurs", text: "\u{20ac} Kurs" },
  ]

test "reads the extended value {c.value}" for c: Extended in extended() {
  assert_eq(decode_extended(c.value), Ok(c.text))
}

fn unreadable() -> List<Refused> =
  [
    { field: "plain.txt", at: 9, why: NoCharset },
    { field: "UTF-8'plain.txt", at: 15, why: NoCharset },
    { field: "''plain.txt", at: 0, why: UnknownCharset("") },
    { field: "shift_jis''plain.txt", at: 0, why: UnknownCharset("shift_jis") },
    { field: "UTF-8''two words", at: 10, why: BadText },
    { field: "UTF-8''100%", at: 10, why: BadText },
    { field: "UTF-8''a%2", at: 8, why: BadText },
    { field: "UTF-8''caf\u{e9}", at: 10, why: BadText },
    { field: "UTF-8''%FF", at: 7, why: BadBytes },
    { field: "US-ASCII'en'%E2%82%AC", at: 12, why: BadBytes },
  ]

test "refuses the extended value {c.field}" for c: Refused in unreadable() {
  assert_eq(decode_extended(c.field), Err({ at: c.at, why: c.why }))
}

test "an extended value is written as UTF-8 with everything but the unreserved escaped" {
  assert_eq(encode_extended("\u{20ac} rates.txt"), "UTF-8''%E2%82%AC%20rates.txt");
  assert_eq(encode_extended(""), "UTF-8''")
}

test "a charset is named in any case, and holds only its own characters" {
  assert_eq(
    map(["UTF-8", "utf8", "US-ASCII", "ascii", "ISO-8859-1", "Latin1", "l1"], charset_named),
    [
      Some(Utf8),
      Some(Utf8),
      Some(UsAscii),
      Some(UsAscii),
      Some(Latin1),
      Some(Latin1),
      Some(Latin1),
    ],
  );
  assert_eq(charset_named("iso-8859-8"), None);
  assert_eq(map(charsets(), charset_name), [
    "UTF-8",
    "US-ASCII",
    "ISO-8859-1",
    "ISO-8859-2",
    "ISO-8859-15",
    "windows-1250",
    "windows-1251",
    "windows-1252",
    "KOI8-R",
  ]);
  assert_eq(
    map(map(charsets(), charset_name), charset_named),
    map(charsets(), |c: Charset| Some(c)),
  );
  assert_eq(map(["Latin2", "L9", "iso_8859-15", "CP1251", "cp1252", "Koi8-R"], charset_named), [
    Some(Latin2),
    Some(Latin9),
    Some(Latin9),
    Some(Windows1251),
    Some(Windows1252),
    Some(Koi8R),
  ]);
  assert_eq(text_of(Latin1, b"caf\xe9"), Some("caf\u{e9}"));
  assert_eq(text_of(Utf8, b"caf\xe9"), None);
  assert_eq(text_of(UsAscii, b"caf\xe9"), None);
  assert_eq(bytes_of(Latin1, "caf\u{e9}"), Some(b"caf\xe9"));
  assert_eq(bytes_of(Latin1, "\u{20ac}"), None);
  assert_eq(bytes_of(Latin1, "\u{100}"), None);
  assert_eq(bytes_of(Latin1, "\u{ff}"), Some(b"\xff"));
  assert_eq(bytes_of(UsAscii, "caf\u{e9}"), None);
  assert_eq(bytes_of(Utf8, "\u{20ac}"), Some(b"\xe2\x82\xac"))
}

type Tabled = { charset: Charset, data: Bytes, text: String }

/// Bytes and the text they are in a single-byte charset, each where the charset leaves
/// ISO-8859-1.
fn tabled() -> List<Tabled> =
  [
    { charset: Latin1, data: b"\x80\xa4\xff", text: "\u{80}\u{a4}\u{ff}" },
    { charset: Latin2, data: b"\x80\xa1\xb1\xff", text: "\u{80}\u{104}\u{105}\u{2d9}" },
    {
      charset: Latin9,
      data: b"\x9f\xa4\xa6\xbc\xbd\xbe\xc0",
      text: "\u{9f}\u{20ac}\u{160}\u{152}\u{153}\u{178}\u{c0}",
    },
    { charset: Windows1250, data: b"\x80\x8a\xa5\xff", text: "\u{20ac}\u{160}\u{104}\u{2d9}" },
    { charset: Windows1251, data: b"\x80\x88\xc0\xff", text: "\u{402}\u{20ac}\u{410}\u{44f}" },
    {
      charset: Windows1252,
      data: b"\x80\x85\x99\x9f\xa0\xff",
      text: "\u{20ac}\u{2026}\u{2122}\u{178}\u{a0}\u{ff}",
    },
    { charset: Koi8R, data: b"\x80\xa3\xb3\xc0\xff", text: "\u{2500}\u{451}\u{401}\u{44e}\u{42a}" },
  ]

test "{charset_name(c.charset)} reads {c.data}" for c: Tabled in tabled() {
  assert_eq(text_of(c.charset, c.data), Some(c.text));
  assert_eq(bytes_of(c.charset, c.text), Some(c.data))
}

test "a byte a charset gives no character is no text, and a character it lacks has no byte" {
  assert_eq(map([0x81, 0x8d, 0x8f, 0x90, 0x9d], |b: Int| text_of(Windows1252, byte_of_int(b))), [
    None,
    None,
    None,
    None,
    None,
  ]);
  assert_eq(text_of(Windows1251, b"\x98"), None);
  assert_eq(text_of(Windows1250, b"\x81"), None);
  assert_eq(bytes_of(Windows1252, "\u{81}"), None);
  assert_eq(bytes_of(Windows1252, "\u{fffd}"), None);
  assert_eq(bytes_of(Latin9, "\u{a4}"), None);
  assert_eq(bytes_of(Latin2, "\u{20ac}"), None);
  assert_eq(bytes_of(Koi8R, "\u{e9}"), None)
}

test "the stretches of a value are its encoded words and what stands around them" {
  assert_eq(pieces("a =?UTF-8?Q?b?=  =?x?Q?c?= =?"), [
    Literal("a "),
    Word("=?UTF-8?Q?b?=", Ok("b")),
    Literal("  "),
    Word("=?x?Q?c?=", Err({ at: 19, why: UnknownCharset("x") })),
    Literal(" =?"),
  ]);
  assert_eq(pieces(""), []);
  assert_eq(pieces("plain"), [Literal("plain")]);
  assert_eq(pieces("=?UTF-8?B?!?="), [Word("=?UTF-8?B?!?=", Err({ at: 10, why: BadText }))])
}

test "encoded words are written of any text, plain or not, and none of no text" {
  assert_eq(encode_words("plain", Q), ["=?UTF-8?Q?plain?="]);
  assert_eq(encode_words("plain", B), ["=?UTF-8?B?cGxhaW4=?="]);
  assert_eq(encode_words("", Q), []);
  assert_eq(map(encode_words(string_of_bytes(repeat(b"a", 200)), Q), string_len), [75, 75, 75, 23])
}

type Sectioned = { sections: List<Section>, text: String }

/// Values in sections, the first two RFC 2231 §3's and §4.1's.
fn sectioned() -> List<Sectioned> =
  [
    {
      sections: [
        { text: "ftp://", extended: false },
        { text: "cs.utk.edu/pub/moore/bulk-mailer/bulk-mailer.tar", extended: false },
      ],
      text: "ftp://cs.utk.edu/pub/moore/bulk-mailer/bulk-mailer.tar",
    },
    {
      sections: [
        { text: "us-ascii'en'This%20is%20even%20more%20", extended: true },
        { text: "%2A%2A%2Afun%2A%2A%2A%20", extended: true },
        { text: "isn't it!", extended: false },
      ],
      text: "This is even more ***fun*** isn't it!",
    },
    {
      sections: [
        { text: "UTF-8''%E2%82", extended: true },
        { text: "%AC%20rates", extended: true },
        { text: " 100%.txt", extended: false },
      ],
      text: "\u{20ac} rates 100%.txt",
    },
    { sections: [], text: "" },
    { sections: [{ text: "as written%20", extended: false }], text: "as written%20" },
  ]

test "the sections {show(c.text)} is written in" for c: Sectioned in sectioned() {
  assert_eq(decode_sections(c.sections), Ok(c.text))
}

test "sections are refused where the first names no charset, or one is not the charset's" {
  let later = { text: "%41", extended: true };
  assert_eq(
    decode_sections([{ text: "plain", extended: false }, later]),
    Err({ at: 0, why: NoCharset }),
  );
  assert_eq(
    decode_sections([{ text: "UTF-8'x", extended: true }, later]),
    Err({ at: 7, why: NoCharset }),
  );
  assert_eq(
    decode_sections([{ text: "UTF-8''a", extended: true }, { text: "b%4", extended: true }]),
    Err({ at: 9, why: BadText }),
  );
  assert_eq(
    decode_sections([
      { text: "US-ASCII''a", extended: true },
      { text: "caf\u{e9}", extended: false },
    ]),
    Err({ at: 11, why: BadBytes }),
  );
  assert_eq(
    decode_sections([{ text: "UTF-8''%E2", extended: true }, { text: "%82", extended: true }]),
    Err({ at: 7, why: BadBytes }),
  )
}

test "a value is cut into sections between characters, the first naming UTF-8" {
  assert_eq(encode_sections("\u{20ac} rates.txt", 80), ["UTF-8''%E2%82%AC%20rates.txt"]);
  assert_eq(encode_sections("\u{20ac}\u{20ac}\u{20ac}", 20), [
    "UTF-8''%E2%82%AC",
    "%E2%82%AC%E2%82%AC",
  ]);
  assert_eq(encode_sections("", 80), ["UTF-8''"]);
  assert_eq(encode_sections("ab", 0), ["UTF-8''", "a", "b"])
}
