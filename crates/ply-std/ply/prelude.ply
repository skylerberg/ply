//! The prelude: the functions every module calls without importing them. Each is the runtime's to
//! implement, so it is declared and has no body, and its doc is what `ply doc` says of it.
//!
//! One declared under a type of the language's (`List::len`) is that type's function, called on a
//! value or through the type, and nothing hides it. A module may shadow any other except
//! `compare_values` and those an operator is written in (`E0105`). Out-of-range indexes and slices
//! raise unless a doc says otherwise; nothing is clamped, and a builtin that can raise carries
//! `abort.raise` in its row.
//! One that states a `requires` raises only where a clause of it fails, so a call the conditions on
//! the way to it show every clause of adds no `abort.raise`; an `ensures` is what the checker knows
//! of the answer, `result`, when it reads a later clause.
//! Strings are indexed by character and bytes by byte. A `Float` operation answers the same bits on
//! every machine, target and profile, since a result is cached and the prover evaluates ground terms:
//! the float functions are correctly rounded, each answering the `Float` nearest the exact value,
//! and a program sees one `NaN`, the one `Float::nan()` is.

/// E0501 when `cond` is false; `message` defaults to `None`.
extern fn assert(cond: Bool, message: Option<String>) -> Unit / {abort.raise}

/// E0501 when they differ.
extern fn assert_eq<a>(actual: a, expected: a) -> Unit / {abort.raise}

/// How many items the list holds.
extern fn List::len<a>(xs: List<a>) -> Int
  ensures 0 <= result

/// A new list with `x` at the end.
extern fn List::push<a>(xs: List<a>, x: a) -> List<a>

/// `None` if `i` is negative or past the end.
extern fn List::at<a>(xs: List<a>, i: Int) -> Option<a>

/// Raises if `i` is out of range.
extern fn List::set<a>(xs: List<a>, i: Int, v: a) -> List<a> / {abort.raise}
  requires 0 <= i && i < List::len(xs)

/// `n` of `x`; raises if `n` is negative or past `2^26`.
extern fn Array::new<a>(n: Int, x: a) -> Array<a> / {abort.raise}
  requires 0 <= n && n <= 67108864

/// The list's items as an array.
extern fn Array::of_list<a>(xs: List<a>) -> Array<a>

/// The array's items as a list.
extern fn Array::to_list<a>(xs: Array<a>) -> List<a>

/// How many items the array holds.
extern fn Array::len<a>(xs: Array<a>) -> Int
  ensures 0 <= result

/// `None` if `i` is negative or past the end.
extern fn Array::at<a>(xs: Array<a>, i: Int) -> Option<a>

/// Raises if `i` is out of range.
extern fn Array::get<a>(xs: Array<a>, i: Int) -> a / {abort.raise}
  requires 0 <= i && i < Array::len(xs)

/// In place when the caller holds the last reference; raises if `i` is out of range.
extern fn Array::set<a>(xs: Array<a>, i: Int, v: a) -> Array<a> / {abort.raise}
  requires 0 <= i && i < Array::len(xs)

/// `n` of `x`, each field held apart; raises if `n` is negative or past `2^26`. A `Columns` holds a
/// record type only (`E0224`).
extern fn Columns::new<a>(n: Int, x: a) -> Columns<a> / {abort.raise}
  requires 0 <= n && n <= 67108864

/// The list's records, each field held apart: `Columns::get(xs, i).f` reads field `f` of record `i`
/// without the rest of it.
extern fn Columns::of_list<a>(xs: List<a>) -> Columns<a>

/// The records as a list.
extern fn Columns::to_list<a>(xs: Columns<a>) -> List<a>

/// How many records it holds.
extern fn Columns::len<a>(xs: Columns<a>) -> Int
  ensures 0 <= result

/// `None` if `i` is negative or past the end.
extern fn Columns::at<a>(xs: Columns<a>, i: Int) -> Option<a>

/// Raises if `i` is out of range.
extern fn Columns::get<a>(xs: Columns<a>, i: Int) -> a / {abort.raise}
  requires 0 <= i && i < Columns::len(xs)

/// In place when the caller holds the last reference; raises if `i` is out of range.
extern fn Columns::set<a>(xs: Columns<a>, i: Int, v: a) -> Columns<a> / {abort.raise}
  requires 0 <= i && i < Columns::len(xs)

/// BLAKE3 of the value's canonical encoding, 32 bytes: values `==` calls equal have one digest
/// (`1.50m` and `1.5m`, two orders of one map, two values of a type whose `key` answers the same),
/// a constructor counts by the name its module declares, and a `new` record is the record it is
/// written as; needs `derivable(hash, a)`.
extern fn digest<a>(x: a) -> Bytes
  where derivable(hash, a)

/// `n` as the `numeric` type the call is at, which is its `of_int(n)` at a type that states
/// `numeric`; raises past a width's range, which a value in `0..=127` never is.
extern fn numeric_of_int<a>(n: Int) -> a / {abort.raise}
  where numeric(a)
  requires 0 <= n && n <= 127

/// `f` of each item, in order.
extern fn List::map<a, b | e>(xs: List<a>, f: (a) -> b / e) -> List<b> / e

/// The items `f` keeps, in order.
extern fn List::filter<a | e>(xs: List<a>, f: (a) -> Bool / e) -> List<a> / e

/// Left to right.
extern fn List::fold<a, b | e>(xs: List<a>, init: b, f: (b, a) -> b / e) -> b / e

/// `step` answers `Continue(next)` or `Stop(result)`; the budget bounds the steps.
extern fn iterate<a, b | e>(
  seed: a,
  budget: Int,
  step: (a) -> Iter<a, b> / e,
) -> b / {abort.raise | e}

/// What `body` answers for what `acquire` answered, with `release` run on it however `body` ends but a
/// failure. The three run as one, so each may perform what the others do.
extern fn bracket<a, b | e>(
  acquire: () -> a / e,
  release: (a) -> Unit / e,
  body: (a) -> b / e,
) -> b / e

/// What the hold holds, read under its region `r`. A hold its region has already let go, which
/// only a continuation resumed after the release still reaches, ends the run with E0331.
extern fn Hold::get<a, [r]>(h: Hold<a, [r]>) -> a / {hold.read[r]}

/// `f()` and what it cost: the calls it made, the objects it allocated and the bytes those took,
/// how many more objects are live once it answers, and how many times it performed each atom. An
/// update in place allocates nothing, so `bytes` is what tells a buffer grown in place from one
/// copied at each step; an `f` answering a number that leaves `live` above zero leaked.
extern fn metered<a | e>(
  f: () -> a / e,
) -> { value: a, steps: Int, allocations: Int, bytes: Int, live: Int, performs: List<{ atom: String, count: Int }> } / e

/// `[lo, hi)`.
extern fn range(lo: Int, hi: Int) -> List<Int>

/// Any integer type; wraps at its width. `a +% b` is this call.
extern fn wrap_add<a>(a: a, b: a) -> a

/// Any integer type; wraps at its width. `a -% b` is this call.
extern fn wrap_sub<a>(a: a, b: a) -> a

/// Any integer type; wraps at its width. `a *% b` is this call.
extern fn wrap_mul<a>(a: a, b: a) -> a

/// Any integer type; its greatest value where the sum passes it and its least where the sum falls
/// below. `a +| b` is this call.
extern fn saturating_add<a>(a: a, b: a) -> a

/// Any integer type; its least value where the difference falls below it, which is zero for an
/// unsigned one, and its greatest where the difference passes it. `a -| b` is this call.
extern fn saturating_sub<a>(a: a, b: a) -> a

/// Any integer type; its greatest or least value where the product leaves it. `a *| b` is this
/// call.
extern fn saturating_mul<a>(a: a, b: a) -> a

/// Any integer type; rotated right by `n` bits at its width, any `n` counted around it.
extern fn rotr<a>(x: a, n: Int) -> a

/// Any integer type; rotated left by `n` bits at its width, any `n` counted around it.
extern fn rotl<a>(x: a, n: Int) -> a

/// The low thirty-two bits of `x`, rotated right by `n`.
extern fn rotr32(x: Int, n: Int) -> Int
  ensures 0 <= result && result <= 4294967295

/// Any integer type; `None` where the sum leaves it.
extern fn checked_add<a>(a: a, b: a) -> Option<a>

/// Any integer type; `None` where the difference leaves it.
extern fn checked_sub<a>(a: a, b: a) -> Option<a>

/// Any integer type; `None` where the product leaves it.
extern fn checked_mul<a>(a: a, b: a) -> Option<a>

/// Any integer type; `None` for an unsigned nonzero `a` and a signed type's least value.
extern fn checked_neg<a>(a: a) -> Option<a>

/// `x` as an `Int`, from any integer type; `None` where `Int` does not hold it. With
/// `numeric_of_int` it converts between any two.
extern fn to_int<a>(x: a) -> Option<Int>
  where integer(a)

/// Raises if out of range.
extern fn U8::of_int(n: Int) -> U8 / {abort.raise}
  requires 0 <= n && n <= 255

/// Raises if out of range.
extern fn U16::of_int(n: Int) -> U16 / {abort.raise}
  requires 0 <= n && n <= 65535

/// Raises if out of range.
extern fn U32::of_int(n: Int) -> U32 / {abort.raise}
  requires 0 <= n && n <= 4294967295

/// Raises if out of range.
extern fn U64::of_int(n: Int) -> U64 / {abort.raise}
  requires 0 <= n

/// Raises if out of range.
extern fn I8::of_int(n: Int) -> I8 / {abort.raise}
  requires -128 <= n && n <= 127

/// Raises if out of range.
extern fn I16::of_int(n: Int) -> I16 / {abort.raise}
  requires -32768 <= n && n <= 32767

/// Raises if out of range.
extern fn I32::of_int(n: Int) -> I32 / {abort.raise}
  requires -2147483648 <= n && n <= 2147483647

/// Total.
extern fn I64::of_int(n: Int) -> I64

/// Raises if negative.
extern fn U128::of_int(n: Int) -> U128 / {abort.raise}
  requires 0 <= n

/// Total.
extern fn I128::of_int(n: Int) -> I128

/// Total.
extern fn Int::of_u8(n: U8) -> Int
  ensures 0 <= result && result <= 255

/// Total.
extern fn Int::of_u16(n: U16) -> Int
  ensures 0 <= result && result <= 65535

/// Total.
extern fn Int::of_u32(n: U32) -> Int
  ensures 0 <= result && result <= 4294967295

/// Raises above `Int`'s maximum.
extern fn Int::of_u64(n: U64) -> Int / {abort.raise}
  ensures 0 <= result

/// Total.
extern fn Int::of_i8(n: I8) -> Int
  ensures -128 <= result && result <= 127

/// Total.
extern fn Int::of_i16(n: I16) -> Int
  ensures -32768 <= result && result <= 32767

/// Total.
extern fn Int::of_i32(n: I32) -> Int
  ensures -2147483648 <= result && result <= 2147483647

/// Total.
extern fn Int::of_i64(n: I64) -> Int

/// Raises above `Int`'s maximum.
extern fn Int::of_u128(n: U128) -> Int / {abort.raise}
  ensures 0 <= result

/// Raises outside `Int`'s range.
extern fn Int::of_i128(n: I128) -> Int / {abort.raise}

/// Decimal.
extern fn U128::to_string(n: U128) -> String

/// Decimal, with a leading `-` when negative.
extern fn I128::to_string(n: I128) -> String

/// Decimal digits only; `None` otherwise or out of range.
extern fn U128::of_string(s: String) -> Option<U128>

/// An optional `-` and decimal digits; `None` otherwise or out of range.
extern fn I128::of_string(s: String) -> Option<I128>

/// In `compare`'s order, `a` when they are equal; needs `derivable(ord, a)`.
extern fn min<a>(a: a, b: a) -> a
  where derivable(ord, a)
  ensures result <= a && result <= b

/// In `compare`'s order, `a` when they are equal; needs `derivable(ord, a)`.
extern fn max<a>(a: a, b: a) -> a
  where derivable(ord, a)
  ensures a <= result && b <= result

/// One byte; raises outside `0..=255`.
extern fn byte_of_int(n: Int) -> Bytes / {abort.raise}
  requires 0 <= n && n <= 255

/// `n` in decimal, with a leading `-` when negative.
extern fn Int::to_string(n: Int) -> String

/// The shortest text that reads back to `f`; `Infinity`, `-Infinity` and `NaN`.
extern fn Float::to_string(f: Float) -> String

/// `a ++ b`.
extern fn String::concat(a: String, b: String) -> String

/// How many bytes `b` holds.
extern fn Bytes::len(b: Bytes) -> Int
  ensures 0 <= result

/// `0..=255`; raises out of range.
extern fn Bytes::at(b: Bytes, i: Int) -> Int / {abort.raise}
  requires 0 <= i && i < Bytes::len(b)
  ensures 0 <= result && result <= 255

/// Four bytes at `i`, little-endian.
extern fn Bytes::u32_le(b: Bytes, i: Int) -> U32 / {abort.raise}
  requires 0 <= i && i + 4 <= Bytes::len(b)

/// Raises out of range.
extern fn Bytes::slice(b: Bytes, start: Int, end: Int) -> Bytes / {abort.raise}
  requires 0 <= start && start <= end && end <= Bytes::len(b)

/// `a ++ b`.
extern fn Bytes::concat(a: Bytes, b: Bytes) -> Bytes

/// The 32-byte BLAKE3 digest of `b`.
extern fn Bytes::blake3(b: Bytes) -> Bytes

/// Gzip at the best level, the same bytes on every machine.
extern fn Bytes::gzip(b: Bytes) -> Bytes

/// `None` when `b` is not gzip.
extern fn Bytes::gunzip(b: Bytes) -> Option<Bytes>

/// One Zstandard frame at level 3, with its checksum: the same bytes on every machine of one
/// runtime. `std.zstd` reads it.
extern fn Bytes::zstd(b: Bytes) -> Bytes

/// One allocation.
extern fn Bytes::concat_all(bs: List<Bytes>) -> Bytes

/// UTF-8.
extern fn Bytes::of_string(s: String) -> Bytes

/// Whether `b` is valid UTF-8.
extern fn Bytes::is_utf8(b: Bytes) -> Bool

/// Where `needle` first occurs in `hay`.
extern fn Bytes::index_of(hay: Bytes, needle: Bytes) -> Option<Int>

/// Where `needle` first occurs in `hay` at or after `from`; raises on a `from` outside `hay`.
extern fn Bytes::index_of_from(hay: Bytes, needle: Bytes, from: Int) -> Option<Int> / {abort.raise}
  requires 0 <= from && from <= Bytes::len(hay)

/// Where the byte `byte` first occurs in `hay`; raises on a `byte` outside `0..=255`.
extern fn Bytes::index_of_byte(hay: Bytes, byte: Int) -> Option<Int> / {abort.raise}
  requires 0 <= byte && byte <= 255

/// Whether `b` begins with `prefix`.
extern fn Bytes::starts_with(b: Bytes, prefix: Bytes) -> Bool

/// Whether `b` ends with `suffix`.
extern fn Bytes::ends_with(b: Bytes, suffix: Bytes) -> Bool

/// The pieces between each occurrence of `sep`; raises on an empty `sep`.
extern fn Bytes::split(b: Bytes, sep: Bytes) -> List<Bytes> / {abort.raise}
  requires 0 < Bytes::len(sep)

/// The first index at or after `from` whose byte is not in `class`; `from + budget`, or the end of
/// `hay` if that comes first, if none. Raises on a `from` outside `hay` or a negative `budget`.
extern fn Bytes::scan(hay: Bytes, from: Int, class: Bytes, budget: Int) -> Int / {abort.raise}
  requires 0 <= from && from <= Bytes::len(hay) && 0 <= budget
  ensures from <= result && result <= Bytes::len(hay)

/// The first index at or after `from` whose byte is in `class`; `from + budget`, or the end of `hay`
/// if that comes first, if none. Raises on a `from` outside `hay` or a negative `budget`.
extern fn Bytes::scan_until(hay: Bytes, from: Int, class: Bytes, budget: Int) -> Int / {abort.raise}
  requires 0 <= from && from <= Bytes::len(hay) && 0 <= budget
  ensures from <= result && result <= Bytes::len(hay)

/// The first index at or after `from` whose byte satisfies `f`; raises on a `from` outside `b`.
extern fn Bytes::position<| e>(
  b: Bytes,
  from: Int,
  f: (Int) -> Bool / e,
) -> Option<Int> / {abort.raise | e}
  requires 0 <= from && from <= Bytes::len(b)

/// Raises on invalid UTF-8.
extern fn String::of_bytes(b: Bytes) -> String / {abort.raise}

/// U+FFFD for invalid UTF-8.
extern fn String::of_bytes_lossy(b: Bytes) -> String

/// In characters.
extern fn String::len(s: String) -> Int
  ensures 0 <= result

/// Character indexes; raises out of range.
extern fn String::slice(s: String, start: Int, end: Int) -> String / {abort.raise}
  requires 0 <= start && start <= end && end <= String::len(s)

/// The pieces between each occurrence of `sep`; raises on an empty `sep`.
extern fn String::split(s: String, sep: String) -> List<String> / {abort.raise}
  requires 0 < String::len(sep)

/// `s` without the characters Unicode calls white space at either end, a no-break space and an em
/// space among them: for text a person wrote. A token or a value in a protocol's text takes
/// `std.string`'s `ascii_trim`.
extern fn String::trim(s: String) -> String

/// `s` in lower case by Unicode's full mapping, the same under every locale: for text a person
/// reads. The answer can be longer than `s` (`İ` is two characters), a final `Σ` is `ς`, and a
/// character outside ASCII can become an ASCII letter (the Kelvin sign `U+212A` is `k`), so a name
/// that is compared takes `std.string`'s `ascii_lower`.
extern fn String::lower(s: String) -> String

/// `s` in upper case by Unicode's full mapping, as `String::lower` is in lower: `ß` is `SS`, and
/// `ſ` is `S`. A name that is compared takes `std.string`'s `ascii_upper`.
extern fn String::upper(s: String) -> String

/// Whether `s` begins with `prefix`.
extern fn String::starts_with(s: String, prefix: String) -> Bool

/// Whether `s` ends with `suffix`.
extern fn String::ends_with(s: String, suffix: String) -> Bool

/// Whether `t` occurs in `s`; an empty `t` occurs in every string.
extern fn String::contains(s: String, t: String) -> Bool

/// Raises if absent.
extern fn String::find(s: String, needle: String) -> Int / {abort.raise}
  ensures 0 <= result

/// `None` for a surrogate, a negative or past `U+10FFFF`.
extern fn Char::of_int(n: Int) -> Option<Char>

/// The Unicode scalar value.
extern fn Int::of_char(c: Char) -> Int
  ensures 0 <= result && result <= 1114111

/// Each character in order.
extern fn String::chars(s: String) -> List<Char>

/// The characters as a string.
extern fn String::of_chars(cs: List<Char>) -> String

/// A total order, a value of a type that states a `key` standing as its key; needs
/// `derivable(ord, a)`.
extern fn compare<a>(x: a, y: a) -> Ordering
  where derivable(ord, a)

/// `compare` under a name no module may shadow.
extern fn compare_values<a>(x: a, y: a) -> Ordering
  where derivable(ord, a)

/// The map with no entries.
extern fn Map::new<a, b>() -> Map<a, b>

/// Replaces.
extern fn Map::insert<a, b>(m: Map<a, b>, key: a, value: b) -> Map<a, b>

/// No-op if `key` is absent.
extern fn Map::update<a, b | e>(m: Map<a, b>, key: a, f: (b) -> b / e) -> Map<a, b> / e

/// The value under `key`.
extern fn Map::get<a, b>(m: Map<a, b>, key: a) -> Option<b>

/// Whether the map holds `key`.
extern fn Map::contains<a, b>(m: Map<a, b>, key: a) -> Bool

/// The map without `key`; the same map when it was absent.
extern fn Map::remove<a, b>(m: Map<a, b>, key: a) -> Map<a, b>

/// How many entries the map holds.
extern fn Map::len<a, b>(m: Map<a, b>) -> Int
  ensures 0 <= result

/// Ascending.
extern fn Map::keys<a, b>(m: Map<a, b>) -> List<a>

/// Key order.
extern fn Map::values<a, b>(m: Map<a, b>) -> List<b>

/// Key order.
extern fn Map::entries<a, b>(m: Map<a, b>) -> List<{ key: a, value: b }>

/// A later entry wins.
extern fn Map::of_entries<a, b>(es: List<{ key: a, value: b }>) -> Map<a, b>

/// `b` wins.
extern fn Map::merge<a, b>(a: Map<a, b>, b: Map<a, b>) -> Map<a, b>

/// Key order.
extern fn Map::fold<a, b, c | e>(m: Map<a, b>, init: c, f: (c, a, b) -> c / e) -> c / e

/// The entry with the least key; `None` for the empty map.
extern fn Map::first<a, b>(m: Map<a, b>) -> Option<{ key: a, value: b }>

/// The entry with the greatest key; `None` for the empty map.
extern fn Map::last<a, b>(m: Map<a, b>) -> Option<{ key: a, value: b }>

/// The entry with the greatest key at or below `key`.
extern fn Map::floor<a, b>(m: Map<a, b>, key: a) -> Option<{ key: a, value: b }>

/// The entry with the least key at or above `key`.
extern fn Map::ceiling<a, b>(m: Map<a, b>, key: a) -> Option<{ key: a, value: b }>

/// The entry with the greatest key below `key`.
extern fn Map::below<a, b>(m: Map<a, b>, key: a) -> Option<{ key: a, value: b }>

/// The entry with the least key above `key`.
extern fn Map::above<a, b>(m: Map<a, b>, key: a) -> Option<{ key: a, value: b }>

/// The entry with the least key and the map without it, in place when the caller holds the last
/// reference; `None` for the empty map.
extern fn Map::pop_first<a, b>(m: Map<a, b>) -> Option<{ key: a, value: b, rest: Map<a, b> }>

/// The entry with the greatest key and the map without it, in place when the caller holds the last
/// reference; `None` for the empty map.
extern fn Map::pop_last<a, b>(m: Map<a, b>) -> Option<{ key: a, value: b, rest: Map<a, b> }>

/// The first `limit` entries, in key order, whose keys lie from `lo` to `hi`. `None` is no bound on
/// its side; a bound that is not inclusive leaves its own key out; bounds that cross admit nothing,
/// and so does a `limit` below one.
extern fn Map::range<a, b>(
  m: Map<a, b>,
  lo: Option<a>,
  lo_inclusive: Bool,
  hi: Option<a>,
  hi_inclusive: Bool,
  limit: Int,
) -> List<{ key: a, value: b }>

/// The map of the entries below `key`, the value at `key`, and the map of the entries above it,
/// sharing what they can with `m`.
extern fn Map::split<a, b>(
  m: Map<a, b>,
  key: a,
) -> { below: Map<a, b>, at: Option<b>, above: Map<a, b> }

/// `a / b` with exactly `scale` digits after the point: the exact quotient, rounded once, there,
/// by `mode`. Raises on a zero divisor, on a `scale` outside `0..=28`, and on a quotient that
/// with that many digits is past the 96 bits a `Decimal` holds.
extern fn Decimal::div(
  a: Decimal,
  b: Decimal,
  scale: Int,
  mode: Rounding,
) -> Decimal / {abort.raise}

/// The digits `d` has after its point: `2` for `1.50m`.
extern fn Decimal::scale(d: Decimal) -> Int
  ensures 0 <= result && result <= 28

/// `d` with exactly `scale` digits after the point: rounded there by `mode` where it has more,
/// and filled with zeros where it has fewer. Raises on a `scale` outside `0..=28`, and on a `d`
/// that with that many digits is past the 96 bits a `Decimal` holds, which filling alone can do:
/// to no more digits than `d` has, it cannot raise.
extern fn Decimal::round(d: Decimal, scale: Int, mode: Rounding) -> Decimal / {abort.raise}
  requires 0 <= scale && scale <= Decimal::scale(d)

/// `n` as a `Decimal` at scale zero.
extern fn Decimal::of_int(n: Int) -> Decimal

/// `None` if the rounded value does not fit an `Int`.
extern fn Int::of_decimal(d: Decimal, mode: Rounding) -> Option<Int>

/// Nearest.
extern fn Float::of_decimal(d: Decimal) -> Float

/// `None` for `inf` or `NaN`.
extern fn Decimal::of_float(f: Float) -> Option<Decimal>

/// A decimal number, optionally signed or in scientific notation, read exactly; `None` for any other
/// text or one past what a `Decimal` holds.
extern fn Decimal::of_string(s: String) -> Option<Decimal>

/// `Float` literal syntax with a sign; `None` for `inf` or `NaN`.
extern fn Float::of_string(s: String) -> Option<Float>

/// Nearest; exact up to `2^53`.
extern fn Float::of_int(n: Int) -> Float

/// `x` rounded to a whole number by `mode`; `None` for `NaN`, an infinity, or one past `Int`.
extern fn Int::of_float(x: Float, mode: Rounding) -> Option<Int>

/// `x` at a whole number, chosen as `mode` chooses.
extern fn Float::round(x: Float, mode: Rounding) -> Float

/// The greatest whole number at or below `x`.
extern fn Float::floor(x: Float) -> Float

/// The least whole number at or above `x`.
extern fn Float::ceil(x: Float) -> Float

/// Correctly rounded; `NaN` below zero.
extern fn Float::sqrt(x: Float) -> Float

/// `e` to the power `x`.
extern fn Float::exp(x: Float) -> Float

/// The natural logarithm; `-inf` at zero, `NaN` below it.
extern fn Float::ln(x: Float) -> Float

/// The base-2 logarithm; `-inf` at zero, `NaN` below it.
extern fn Float::log2(x: Float) -> Float

/// The base-10 logarithm; `-inf` at zero, `NaN` below it.
extern fn Float::log10(x: Float) -> Float

/// Of `x` radians.
extern fn Float::sin(x: Float) -> Float

/// Of `x` radians.
extern fn Float::cos(x: Float) -> Float

/// Of `x` radians.
extern fn Float::tan(x: Float) -> Float

/// Radians in `[-pi/2, pi/2]`; `NaN` outside `[-1, 1]`.
extern fn Float::asin(x: Float) -> Float

/// Radians in `[0, pi]`; `NaN` outside `[-1, 1]`.
extern fn Float::acos(x: Float) -> Float

/// Radians in `[-pi/2, pi/2]`.
extern fn Float::atan(x: Float) -> Float

/// `x` to the power `y`.
extern fn Float::pow(x: Float, y: Float) -> Float

/// The angle of `(x, y)` in radians, in `[-pi, pi]`.
extern fn Float::atan2(y: Float, x: Float) -> Float

/// `Float::sqrt(x * x + y * y)` without overflow on the way.
extern fn Float::hypot(x: Float, y: Float) -> Float

/// `d` in decimal at its scale, so `1.50m` prints `1.50`.
extern fn Decimal::to_string(d: Decimal) -> String

/// The IEEE-754 bit pattern; total. Every `NaN` reads as `0x7FF8_0000_0000_0000`.
extern fn bits_of_float(f: Float) -> Int

/// The IEEE-754 bit pattern; total.
extern fn Float::of_bits(n: Int) -> Float

/// Raises `message`; unanswered, E0502.
extern fn panic<a>(message: String) -> a / {abort.raise}

/// The identity, through a call the C backend cannot see into: a pure computation whose value is only
/// observed still runs.
extern fn observe<a>(value: a) -> a

/// The string as a secret, which renders as `Secret(****)`. A secret holds a copy of its own,
/// which is overwritten with zeros when the last value holding the secret is dropped; the string
/// it was made of is the caller's, and is not.
extern fn Secret::of_string(s: String) -> Secret<String>

/// Constant-time; not rate-limited.
extern fn Secret::verify(stored: Secret<String>, supplied: String) -> Bool

/// Whether the secret holds nothing.
extern fn Secret::is_empty<a>(s: Secret<a>) -> Bool

/// The bytes as a secret, held as `Secret::of_string` holds a string's.
extern fn Secret::of_bytes(b: Bytes) -> Secret<Bytes>

/// The string's UTF-8, still a secret.
extern fn Secret::bytes(s: Secret<String>) -> Secret<Bytes>

/// How many bytes the secret holds. A length is not kept secret by anything here.
extern fn Secret::len(s: Secret<Bytes>) -> Int

/// `a` then `b`, still a secret.
extern fn Secret::concat(a: Secret<Bytes>, b: Secret<Bytes>) -> Secret<Bytes>

/// The bytes a secret text encodes, read without opening it: `encoding` is `"hex"`, `"base64"`,
/// `"base64url"`, `"base32"` or `"base32-typed"`, each what the `std` module of its name reads.
/// `None` for a text the encoding does not write, which is all a refusal says of it; raises for
/// any other encoding.
extern fn Secret::decode(
  encoding: String,
  text: Secret<String>,
) -> Option<Secret<Bytes>> / {abort.raise}

/// The text of a secret's bytes in an encoding, written without opening it, in the alphabet and
/// padding `Secret::decode` reads under the same name: `"hex"` (lower case), `"base64"`,
/// `"base64url"` (unpadded) or `"base32"`. Raises for any other encoding.
extern fn Secret::encode(encoding: String, bytes: Secret<Bytes>) -> Secret<String> / {abort.raise}

/// The private key a DER document holds, and the scheme `std.internal.crypto` signs or agrees
/// with it under: PKCS #8 for `"ed25519"`, `"x25519"`, `"p256"`, `"p384"`, `"p521"`, `"k256"`
/// (secp256k1) and `"rsa"`, a SEC 1 key on one of those curves, or a PKCS #1 RSA key. `None` for
/// anything else.
extern fn Secret::private_key(der: Secret<Bytes>) -> Option<{ key: Secret<Bytes>, scheme: String }>

/// The PKCS #1 document of the RSA key a JSON Web Key's numbers are (RFC 7518 §6.3): `n` and `e`
/// as bytes, and `d`, `p`, `q`, `dp`, `dq` and `qi`, in that order, each as its unpadded base64url
/// text, sealed. `None` for a text that is not one and for numbers that are no key of 2048 to 4096
/// bits together; raises for a list that is not six long.
extern fn Secret::rsa_jwk(
  n: Bytes,
  e: Bytes,
  private: List<Secret<String>>,
) -> Option<Secret<Bytes>> / {abort.raise}

/// HMAC under a secret key, over the hash a `std.hash.Hash` of that name is: `"SHA-1"`,
/// `"SHA-256"`, `"SHA-384"` or `"SHA-512"`. `None` for any other.
extern fn Secret::hmac(hash: String, key: Secret<Bytes>, message: Bytes) -> Option<Bytes>

/// HKDF's first step, RFC 5869, over the hashes `Secret::hmac` takes.
extern fn Secret::hkdf_extract(
  hash: String,
  salt: Bytes,
  key: Secret<Bytes>,
) -> Option<Secret<Bytes>>

/// HKDF's second step: `length` bytes. `None` for a length below zero or past 255 digests, too.
extern fn Secret::hkdf_expand(
  hash: String,
  key: Secret<Bytes>,
  info: Bytes,
  length: Int,
) -> Option<Secret<Bytes>>

/// PBKDF2, RFC 8018, over HMAC over the hashes `Secret::hmac` takes. `None` as well for an
/// iteration count below one, and for a length below one or past `2^20` bytes.
extern fn Secret::pbkdf2(
  hash: String,
  password: Secret<Bytes>,
  salt: Bytes,
  iterations: Int,
  length: Int,
) -> Option<Secret<Bytes>>
