// `uuid` — a 128-bit identifier, its canonical text form, and a v4 draw.
//
// The value is the sixteen octets; the text form is a rendering of them, so a `Uuid` parsed and a
// `Uuid` generated are the same kind of value and compare by their octets. Parsing and rendering
// are pure and total (a string that is not the canonical form is `None`, not a raise); only `v4`
// reaches the world, and it draws through `std.random`'s `entropy` so a test can pin it.

import std.bytes (bytes_of_hex, hex_of, u64_be)
import std.random (entropy)

pub type Uuid = { octets: Bytes }

/// The canonical form: lowercase hex, 8-4-4-4-12, as RFC 9562 §4 writes it.
pub fn uuid_render(u: Uuid) -> String / {abort.raise} = {
  let h = hex_of(u.octets);
  string_slice(h, 0, 8) ++ "-" ++ string_slice(h, 8, 12) ++ "-" ++ string_slice(h, 12, 16) ++ "-"
    ++ string_slice(h, 16, 20)
    ++ "-"
    ++ string_slice(h, 20, 32)
}

/// The `Uuid` a canonical text names, or `None`. Upper case is accepted — RFC 9562 says a reader
/// must accept it — and `uuid_render` always writes lower case.
pub fn uuid_parse(text: String) -> Option<Uuid> / {abort.raise} =
  if string_len(text) != 36 { None }
  else if string_slice(text, 8, 9) != "-" || string_slice(text, 13, 14) != "-"
      || string_slice(text, 18, 19) != "-"
      || string_slice(text, 23, 24) != "-" { None } else {
    // `bytes_of_hex` reads lower case only, and RFC 9562 says a reader accepts either.
    let h = lower_hex(
      string_slice(text, 0, 8) ++ string_slice(text, 9, 13) ++ string_slice(text, 14, 18)
        ++ string_slice(text, 19, 23)
        ++ string_slice(text, 24, 36),
    );
    if is_hex(h) { Some({ octets: bytes_of_hex(h) }) } else { None }
  }

/// A version 4 identifier: sixteen random octets with the version (6) and variant (8, 9, a or b)
/// bits overwritten.
pub fn uuid_v4() -> Uuid / {entropy.next, abort.raise} = {
  // Two `Int`s of entropy are sixteen octets; the host's draw is what makes them random, so this
  // is one effect perform per machine word rather than a loop of sixteen.
  let raw = bytes_concat(u64_be(entropy.next()), u64_be(entropy.next()));
  {
    octets: bytes_concat_all(
      map(range(0, 16), |i: Int| byte_of_int(v4_octet(bytes_at(raw, i), i))),
    ),
  }
}

fn v4_octet(octet: Int, at: Int) -> Int =
  if at == 6 { octet & 0x0F | 0x40 } else if at == 8 { octet & 0x3F | 0x80 } else { octet }

fn is_hex(text: String) -> Bool / {abort.raise} =
  fold(range(0, string_len(text)), true, |ok: Bool, i: Int|
    ok && string_contains(hex_digits(), string_slice(text, i, i + 1)))

fn hex_digits() -> String = "0123456789abcdef"

fn lower_hex(text: String) -> String / {abort.raise} =
  fold(range(0, string_len(text)), "", |acc: String, i: Int|
    acc ++ lower_hex_char(string_slice(text, i, i + 1)))

fn lower_hex_char(c: String) -> String / {abort.raise} =
  if string_contains("ABCDEF", c) {
    string_slice("abcdef", string_find("ABCDEF", c), string_find("ABCDEF", c) + 1)
  } else { c }

// --- Tests ------------------------------------------------------------------

test "render is the canonical lowercase form and parse is its inverse" {
  let u = { octets: bytes_of_hex("0190f5e2c3a74b6d8e1f2a3b4c5d6e7f") };
  assert_eq(uuid_render(u), "0190f5e2-c3a7-4b6d-8e1f-2a3b4c5d6e7f");
  assert_eq(uuid_parse("0190f5e2-c3a7-4b6d-8e1f-2a3b4c5d6e7f"), Some(u));
  // A reader accepts upper case; a writer never produces it.
  assert_eq(uuid_parse("0190F5E2-C3A7-4B6D-8E1F-2A3B4C5D6E7F"), Some(u))
}

test "parse refuses anything that is not 8-4-4-4-12 hex" {
  assert_eq(uuid_parse("0190f5e2c3a74b6d8e1f2a3b4c5d6e7f"), None);
  assert_eq(uuid_parse("0190f5e2-c3a7-4b6d-8e1f-2a3b4c5d6e7"), None);
  assert_eq(uuid_parse("0190f5e2-c3a7-4b6d-8e1f-2a3b4c5d6e7g"), None);
  assert_eq(uuid_parse("0190f5e2c3a7-4b6d-8e1f-2a3b-4c5d6e7f"), None)
}

test "v4 overwrites the version and variant bits and nothing else" {
  let u = handle { uuid_v4() } with { entropy.next() -> 0 };
  assert_eq(bytes_len(u.octets), 16);
  assert_eq(bytes_at(u.octets, 6) / 16, 4);
  assert_eq(bytes_at(u.octets, 8) / 64, 2);
  // Every other octet is what the draw was, which here is zero.
  assert_eq(bytes_at(u.octets, 5), 0)
}
