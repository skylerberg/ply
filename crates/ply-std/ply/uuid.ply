//! A 128-bit identifier: its canonical text, what its bits say of how it was made, and the
//! versions of RFC 9562 a program makes for itself.
//!
//! The value is the sixteen octets, and only this module builds one, so every `Uuid` holds
//! exactly sixteen. Two compare by their octets, the first that differs deciding, which is the
//! order of their texts and the order a `Map` keeps them in. Parsing and rendering are pure and
//! total: a string that is not the canonical form is `None`, not a raise. A shorter text of one
//! is `std.radix` over its `octets`, at whichever alphabet.
//!
//! Version 4 is random and says nothing. Version 5 is a function of a namespace and a name, so
//! two programs name one thing alike without talking. Version 7 opens with the millisecond it was
//! made in, so identifiers sort in the order they were made, which is what a database key wants;
//! it also tells whoever is shown one when it was made. `uuid_v4` and `uuid_v7` draw through
//! `std.random`'s `entropy` and `uuid_v7` reads `std.time`'s clock, so a test pins both by
//! handling them, and `uuid_v7_at` is the same identifier with the reading and the draws as
//! arguments.
//!
//! Two version 7 identifiers made in one millisecond are in no order, and a clock set back makes
//! earlier ones. `uuid_v7_after(previous)` answers one that sorts after `previous` whatever the
//! clock did in between. It is RFC 9562 §6.2's first method, a counter in the twelve bits after
//! the version: drawn afresh in a new millisecond, one more than `previous` holds in the same or
//! an earlier one, and carried into the next millisecond when it is spent. The clock here reads
//! whole milliseconds, so there is nothing finer to put in those bits, which is the third method;
//! and the sixty-two bits after the variant stay random in every identifier, so one made after
//! another is still not guessed from it. The state is the last identifier made, and the caller
//! holds it.

import std.bytes
import std.bytes (bytes_of_hex, hex_of, u16_be, u64_be)
import std.gen
import std.gen (Gen)
import std.hash_legacy (sha1)
import std.laws (round_trip, total_order)
import std.list (contains, last)
import std.option (option_and_then, option_expect, option_map)
import std.random (entropy)
import std.string (ascii_lower)
import std.time (after, millis, nanos_at, time)

/// A 128-bit identifier as its sixteen octets, which is what two compare by.
pub opaque type Uuid = new { octets: Bytes }

/// Which layout an identifier's bits follow, read off the leading bits of its ninth octet
/// (RFC 9562 §4.1).
pub type UuidVariant =
  /// `0xxx`: Apollo NCS's, kept for identifiers older than the RFCs. The nil identifier reads as
  /// this.
  | Ncs
  /// `10xx`: the layout RFC 9562 defines, as RFC 4122 did. Only under it is there a version.
  | Rfc
  /// `110x`: Microsoft's, kept for old GUIDs.
  | Microsoft
  /// `111x`: kept for a layout nobody has defined. The max identifier reads as this.
  | Future

/// The `Uuid` that is these octets, or `None` unless there are sixteen of them.
pub fn uuid_of_octets(octets: Bytes) -> Option<Uuid> =
  if bytes_len(octets) == 16 { Some({ octets: octets }) } else { None }

gen for Uuid by uuid_gen

/// Every kind of identifier: the nil and the max ones, and sixteen octets under each of the
/// sixteen versions and each of the four variants their bits can state, the RFC's variant most
/// often, since only it has versions.
pub fn uuid_gen() -> Gen<Uuid> =
  gen::and_then(gen::below(16), |pick: Int|
    if pick == 0 { gen::constant(uuid_nil()) }
    else if pick == 1 { gen::constant(uuid_max()) } else {
      gen::map2(gen::bytes_of(16), gen::below(16), |raw: Bytes, version: Int|
        laid_out(raw, version, variant_picked(pick)))
    })

fn variant_picked(pick: Int) -> UuidVariant =
  if pick == 2 { Ncs } else if pick == 3 { Microsoft } else if pick == 4 { Future } else { Rfc }

/// Sixteen zero octets: the identifier that stands for none, and sorts before every other
/// (RFC 9562 §5.9).
pub fn uuid_nil() -> Uuid =
  { octets: b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00" }

/// Sixteen `0xFF` octets: the identifier that sorts after every other (RFC 9562 §5.10).
pub fn uuid_max() -> Uuid =
  { octets: b"\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff" }

/// The canonical form: lowercase hex, 8-4-4-4-12, as RFC 9562 §4 writes it.
pub fn uuid_render(u: Uuid) -> String / {abort.raise} = {
  let h = hex_of(u.octets);
  string_slice(h, 0, 8) ++ "-" ++ string_slice(h, 8, 12) ++ "-" ++ string_slice(h, 12, 16) ++ "-"
    ++ string_slice(h, 16, 20)
    ++ "-"
    ++ string_slice(h, 20, 32)
}

/// The `Uuid` a canonical text names, or `None`. Upper case is accepted — RFC 9562 says a reader
/// must accept it — and `uuid_render` always writes lower case.
pub fn uuid_parse(text: String) -> Option<Uuid> / {abort.raise} =
  if string_len(text) != 36 { None }
  else if string_slice(text, 8, 9) != "-" || string_slice(text, 13, 14) != "-"
      || string_slice(text, 18, 19) != "-"
      || string_slice(text, 23, 24) != "-" { None } else {
    // `bytes_of_hex` reads lower case only, and RFC 9562 says a reader accepts either.
    let h = ascii_lower(
      string_slice(text, 0, 8) ++ string_slice(text, 9, 13) ++ string_slice(text, 14, 18)
        ++ string_slice(text, 19, 23)
        ++ string_slice(text, 24, 36),
    );
    if is_hex(h) { Some({ octets: bytes_of_hex(h) }) } else { None }
  }

/// What a `uuid"..."` literal is checked by: the `Uuid` a canonical text names, or the first
/// character that keeps it from being one.
pub fn literal(text: String) -> Result<Uuid, { message: String, offset: Int }> / {abort.raise} =
  match uuid_parse(text) {
    Some(u) -> Ok(u),
    None -> {
      let n = string_len(text);
      let stray = fold(range(0, min(n, 36)), None, |found: Option<Int>, i: Int|
        if found != None || placed(text, i) { found } else { Some(i) });
      Err(match stray {
        Some(i) ->
          { message: if hyphen_at(i) { "a `-` goes here" } else { "not a hex digit" }, offset: i },
        None -> { message: "a UUID is 36 characters, written 8-4-4-4-12", offset: min(n, 36) },
      })
    },
  }

fn hyphen_at(i: Int) -> Bool = i == 8 || i == 13 || i == 18 || i == 23

/// Whether the character at `i` is what the canonical form has there.
fn placed(text: String, i: Int) -> Bool / {abort.raise} = {
  let c = string_slice(text, i, i + 1);
  if hyphen_at(i) { c == "-" } else { is_hex(ascii_lower(c)) }
}

fn is_hex(text: String) -> Bool =
  fold(range(0, string_len(text)), true, |ok: Bool, i: Int|
    ok && string_contains(hex_digits(), string_slice(text, i, i + 1)))

fn hex_digits() -> String = "0123456789abcdef"

// --- What an identifier says ------------------------------------------------

/// The layout `u`'s bits follow.
pub fn uuid_variant(u: Uuid) -> UuidVariant / {abort.raise} = {
  let lead = bytes_at(u.octets, 8);
  if lead < 0x80 { Ncs }
  else if lead < 0xC0 { Rfc }
  else if lead < 0xE0 { Microsoft }
  else { Future }
}

/// The version `u` states: the four bits that open its seventh octet, which RFC 9562 gives a
/// meaning from 1 to 8. `None` under any variant but the RFC's, where those bits are something
/// else, so the nil and max identifiers state none.
pub fn uuid_version(u: Uuid) -> Option<Int> / {abort.raise} =
  match uuid_variant(u) { Rfc -> Some(bytes_at(u.octets, 6) >> 4), _ -> None }

/// When `u` says it was made: a version 7's millisecond, or a version 1's or 6's count of 100 ns
/// from 1582-10-15, as an `Instant` of nanoseconds from 1970-01-01T00:00:00Z, the reading
/// `std.date` writes. `None` for any other version, which states no time, and for a time past
/// what an `Instant` holds, in 2262. It is what the maker's clock read, or what the maker chose
/// to write.
pub fn uuid_time(u: Uuid) -> Option<Instant> / {abort.raise} =
  match uuid_version(u) {
    Some(7) -> instant_of(field(u, 0, 6), 1000000),
    Some(6) -> since_1582(field(u, 0, 6) << 12 | field(u, 6, 8) & 0x0FFF),
    Some(1) -> since_1582((field(u, 6, 8) & 0x0FFF) << 48 | field(u, 4, 6) << 32 | field(u, 0, 4)),
    _ -> None,
  }

/// The reading `ticks` spans of 100 ns after 1582-10-15, which is 0x01B21DD213814000 of them
/// before 1970.
fn since_1582(ticks: Int) -> Option<Instant> = instant_of(ticks - 0x01B2_1DD2_1381_4000, 100)

fn instant_of(count: Int, nanoseconds: Int) -> Option<Instant> =
  option_map(checked_mul(count, nanoseconds), |n: Int| Instant(n))

/// The whole number `u`'s octets from `from` up to `to` write, most significant first.
fn field(u: Uuid, from: Int, to: Int) -> Int / {abort.raise} =
  fold(range(from, to), 0, |n: Int, i: Int| n << 8 | bytes_at(u.octets, i))

/// `raw`'s sixteen octets with `version` and `variant` written over the bits that state them.
fn laid_out(raw: Bytes, version: Int, variant: UuidVariant) -> Uuid / {abort.raise} = {
  let lead = variant_bits(variant);
  {
    octets: bytes_concat_all([
      bytes_slice(raw, 0, 6),
      byte_of_int(bytes_at(raw, 6) & 0x0F | version << 4),
      bytes_slice(raw, 7, 8),
      byte_of_int(bytes_at(raw, 8) & lead.kept | lead.set),
      bytes_slice(raw, 9, 16),
    ]),
  }
}

/// The bits of the ninth octet a variant leaves to the identifier, and the ones it sets.
fn variant_bits(v: UuidVariant) -> { kept: Int, set: Int } =
  match v {
    Ncs -> { kept: 0x7F, set: 0x00 },
    Rfc -> { kept: 0x3F, set: 0x80 },
    Microsoft -> { kept: 0x1F, set: 0xC0 },
    Future -> { kept: 0x1F, set: 0xE0 },
  }

// --- Version 4 --------------------------------------------------------------

/// A version 4 identifier: sixteen random octets with the version and variant written over six
/// of their bits.
pub fn uuid_v4() -> Uuid / {entropy.next bounded, abort.raise} = {
  // A draw is sixty-three bits, so sixteen whole octets are the low ones of three.
  let raw = bytes_concat_all([
    low_octets(entropy.next(), 6),
    low_octets(entropy.next(), 6),
    low_octets(entropy.next(), 4),
  ]);
  laid_out(raw, 4, Rfc)
}

fn low_octets(n: Int, count: Int) -> Bytes / {abort.raise} = bytes_slice(u64_be(n), 8 - count, 8)

// --- Version 5 --------------------------------------------------------------

/// The namespace of fully qualified domain names (RFC 9562 §6.6).
pub fn uuid_namespace_dns() -> Uuid =
  { octets: b"\x6b\xa7\xb8\x10\x9d\xad\x11\xd1\x80\xb4\x00\xc0\x4f\xd4\x30\xc8" }

/// The namespace of URLs.
pub fn uuid_namespace_url() -> Uuid =
  { octets: b"\x6b\xa7\xb8\x11\x9d\xad\x11\xd1\x80\xb4\x00\xc0\x4f\xd4\x30\xc8" }

/// The namespace of ISO object identifiers, written in dots: `1.3.6.1`.
pub fn uuid_namespace_oid() -> Uuid =
  { octets: b"\x6b\xa7\xb8\x12\x9d\xad\x11\xd1\x80\xb4\x00\xc0\x4f\xd4\x30\xc8" }

/// The namespace of X.500 distinguished names.
pub fn uuid_namespace_x500() -> Uuid =
  { octets: b"\x6b\xa7\xb8\x14\x9d\xad\x11\xd1\x80\xb4\x00\xc0\x4f\xd4\x30\xc8" }

/// The version 5 identifier of `name` in `namespace`: the SHA-1 of the namespace's octets and
/// then the name's, cut to sixteen, with the version and variant written over (RFC 9562 §5.5).
///
/// A namespace and a name make one identifier on every machine, so it is found again from the
/// name alone. A name that is text is its UTF-8. SHA-1 no longer keeps two chosen inputs apart:
/// whoever picks the names can make two that share an identifier, so it tells apart names an
/// adversary does not choose.
pub fn uuid_v5(namespace: Uuid, name: Bytes) -> Uuid / {abort.raise} =
  laid_out(bytes_slice(sha1(bytes_concat(namespace.octets, name)), 0, 16), 5, Rfc)

// --- Version 7 --------------------------------------------------------------

/// A version 7 identifier: the millisecond the clock reads, then random bits (RFC 9562 §5.7).
///
/// One made in a later millisecond sorts after one made in an earlier. Two made in one
/// millisecond are in no order, and a clock set back makes earlier ones: `uuid_v7_after` is the
/// maker whose identifiers come out in order. Whoever is shown the identifier can read when it
/// was made (`uuid_time`).
pub fn uuid_v7() -> Uuid / {time.now_ms bounded, entropy.next bounded, abort.raise} = {
  let ms = time.now_ms();
  let rand_a = entropy.next();
  v7_of(stated_ms(ms), rand_a, entropy.next())
}

/// A version 7 identifier that sorts after `previous`, the last one this maker made: `uuid_v7`
/// where the clock has passed `previous`'s millisecond, and otherwise one in that millisecond
/// whose counter is one higher, or in the next where the counter is spent. So the clock standing
/// still or stepping back never makes an identifier out of order, and a burst of more than a few
/// thousand in a millisecond runs ahead of the clock.
///
/// `previous` may be any identifier, of this version or not. `None` only where no version 7
/// identifier follows it: its first six octets are the last millisecond forty-eight bits count,
/// in the year 10889, and its next two are `0x7FFF` or more.
pub fn uuid_v7_after(
  previous: Uuid,
) -> Option<Uuid> / {time.now_ms bounded, entropy.next bounded, abort.raise} = {
  let ms = time.now_ms();
  let rand_a = entropy.next();
  v7_after(previous, stated_ms(ms), rand_a, entropy.next())
}

/// `uuid_v7` of a clock reading `at` and two draws: the millisecond `at` falls in, the low twelve
/// bits of `rand_a` after the version and the low sixty-two of `rand_b` after the variant. A
/// reading before 1970 counts as 1970.
pub fn uuid_v7_at(at: Instant, rand_a: Int, rand_b: Int) -> Uuid / {abort.raise} =
  v7_of(ms_of(at), rand_a, rand_b)

/// `uuid_v7_after` of a clock reading `at` and two draws. Where the answer is in `previous`'s
/// millisecond its twelve bits are one more than `previous` holds and `rand_a` is not read.
pub fn uuid_v7_after_at(
  previous: Uuid,
  at: Instant,
  rand_a: Int,
  rand_b: Int,
) -> Option<Uuid> / {abort.raise} = v7_after(previous, ms_of(at), rand_a, rand_b)

fn v7_after(previous: Uuid, now: Int, rand_a: Int, rand_b: Int) -> Option<Uuid> / {abort.raise} = {
  let last = field(previous, 0, 6);
  // The version and the counter of a version 7; anything below `0x7000` sorts before every one.
  let held = field(previous, 6, 8);
  if now > last { Some(v7_of(now, rand_a, rand_b)) }
  else if held < 0x7000 { Some(v7_of(last, rand_a, rand_b)) }
  else if held < 0x7FFF { Some(v7_of(last, held + 1, rand_b)) }
  else if last < last_ms() { Some(v7_of(last + 1, rand_a, rand_b)) }
  else { None }
}

fn v7_of(ms: Int, rand_a: Int, rand_b: Int) -> Uuid / {abort.raise} =
  laid_out(
    bytes_concat_all([bytes_slice(u64_be(ms), 2, 8), u16_be(rand_a), u64_be(rand_b)]),
    7,
    Rfc,
  )

/// The last millisecond forty-eight bits count.
fn last_ms() -> Int = 0xFFFF_FFFF_FFFF

/// The millisecond a version 7 writes for a clock reading `ms`: one before 1970 counts as 1970,
/// and one past the last as the last.
fn stated_ms(ms: Int) -> Int = min(max(ms, 0), last_ms())

fn ms_of(at: Instant) -> Int = stated_ms(nanos_at(at) / 1000000)

// --- Tests ------------------------------------------------------------------

fn the(text: String) -> Uuid / {abort.raise} = option_expect(uuid_parse(text), text)

fn at_ms(ms: Int) -> Instant = after(Instant(0), millis(ms))

law "a UUID's text reads back as it" = round_trip(uuid_render, uuid_parse)

law "every UUID renders as 8-4-4-4-12"
  forall (us: List<Uuid>) {
    fold(us, true, |ok: Bool, u: Uuid| {
      let text = uuid_render(u);
      ok && string_len(text) == 36 && literal(text) == Ok(u)
    })
  }

law "a UUID is the one its octets make" = round_trip(|u: Uuid| u.octets, uuid_of_octets)

law "the order of UUIDs is a total order" = total_order(|x: Uuid, y: Uuid| compare(x, y))

law "UUIDs compare as their octets do, and so do their texts"
  forall (a: Uuid, b: Uuid) {
    let by_octets = bytes::compare(a.octets, b.octets);
    compare(a, b) == by_octets && compare(uuid_render(a), uuid_render(b)) == by_octets
      && (if a == b { by_octets == Equal } else { by_octets != Equal })
  }

law "the nil UUID sorts before every other and the max UUID after"
  forall (u: Uuid) {
    compare(uuid_nil(), u) != Greater && compare(uuid_max(), u) != Less
  }

law "a UUID states a version exactly under the RFC's variant, and a time only as version 1, 6 or 7"
  forall (u: Uuid) {
    (if uuid_variant(u) == Rfc { uuid_version(u) != None } else { uuid_version(u) == None })
      && (uuid_time(u) == None || contains([Some(1), Some(6), Some(7)], uuid_version(u)))
  }

law "a version 5 UUID states version 5 and no time"
  forall (namespace: Uuid, name: Bytes) {
    let u = uuid_v5(namespace, name);
    uuid_version(u) == Some(5) && uuid_time(u) == None
  }

law "a version 7 UUID says the millisecond it was made in"
  forall (at: Instant, rand_a: Int, rand_b: Int) where nanos_at(at) >= 0 {
    let u = uuid_v7_at(at, rand_a, rand_b);
    uuid_version(u) == Some(7) && uuid_time(u) == Some(at_ms(nanos_at(at) / 1000000))
  }

law "a version 7 UUID made after another sorts after it, as a value and as text, whatever the other is and whatever the clock reads"
  forall (previous: Uuid, at: Instant, rand_a: Int, rand_b: Int) {
    match uuid_v7_after_at(previous, at, rand_a, rand_b) {
      Some(next) ->
        compare(next, previous) == Greater
          && compare(uuid_render(next), uuid_render(previous)) == Greater
          && uuid_version(next) == Some(7),
      None -> field(previous, 0, 6) == last_ms() && field(previous, 6, 8) >= 0x7FFF,
    }
  }

type Reading = { at: Instant, rand_a: Int, rand_b: Int }

law "version 7 UUIDs made one after another come out in the order made, while the clock stands, steps on or runs back"
  forall (first: Reading, rest: List<Reading>) {
    fold(
      rest,
      { last: uuid_v7_at(first.at, first.rand_a, first.rand_b), ordered: true },
      |made: { last: Uuid, ordered: Bool }, r: Reading|
        match uuid_v7_after_at(made.last, r.at, r.rand_a, r.rand_b) {
          Some(next) ->
            {
              last: next,
              ordered: made.ordered && compare(next, made.last) == Greater
                && compare(uuid_render(next), uuid_render(made.last)) == Greater,
            },
          None -> { last: made.last, ordered: false },
        },
    ).ordered
  }

test "render is the canonical lowercase form and parse is its inverse" {
  let u: Uuid = { octets: bytes_of_hex("0190f5e2c3a74b6d8e1f2a3b4c5d6e7f") };
  assert_eq(uuid_render(u), "0190f5e2-c3a7-4b6d-8e1f-2a3b4c5d6e7f");
  assert_eq(uuid_parse("0190f5e2-c3a7-4b6d-8e1f-2a3b4c5d6e7f"), Some(u));
  // A reader accepts upper case; a writer never produces it.
  assert_eq(uuid_parse("0190F5E2-C3A7-4B6D-8E1F-2A3B4C5D6E7F"), Some(u))
}

test "parse refuses anything that is not 8-4-4-4-12 hex" {
  assert_eq(uuid_parse("0190f5e2c3a74b6d8e1f2a3b4c5d6e7f"), None);
  assert_eq(uuid_parse("0190f5e2-c3a7-4b6d-8e1f-2a3b4c5d6e7"), None);
  assert_eq(uuid_parse("0190f5e2-c3a7-4b6d-8e1f-2a3b4c5d6e7g"), None);
  assert_eq(uuid_parse("0190f5e2c3a7-4b6d-8e1f-2a3b-4c5d6e7f"), None);
  // Each hyphen is needed, a hex digit in its place or not.
  assert_eq(uuid_parse("0190f5e20c3a7-4b6d-8e1f-2a3b4c5d6e7f"), None);
  assert_eq(uuid_parse("0190f5e2-c3a704b6d-8e1f-2a3b4c5d6e7f"), None);
  assert_eq(uuid_parse("0190f5e2-c3a7-4b6d08e1f-2a3b4c5d6e7f"), None);
  assert_eq(uuid_parse("0190f5e2-c3a7-4b6d-8e1f02a3b4c5d6e7f"), None)
}

test "a literal's check answers the UUID, or the character that keeps the text from being one" {
  assert_eq(
    literal("0190f5e2-c3a7-4b6d-8e1f-2a3b4c5d6e7f"),
    Ok({ octets: bytes_of_hex("0190f5e2c3a74b6d8e1f2a3b4c5d6e7f") }),
  );
  assert_eq(
    literal("0190f5e2-c3a7-4b6d-8e1f-2a3b4c5d6e7g"),
    Err({ message: "not a hex digit", offset: 35 }),
  );
  assert_eq(
    literal("0190f5e2c3a7-4b6d-8e1f-2a3b-4c5d6e7f"),
    Err({ message: "a `-` goes here", offset: 8 }),
  );
  assert_eq(
    literal("g190f5e2-c3a7-4b6d-8e1f-2a3b4c5d6e7f"),
    Err({ message: "not a hex digit", offset: 0 }),
  );
  let short = Err({ message: "a UUID is 36 characters, written 8-4-4-4-12", offset: 8 });
  assert_eq(literal("0190f5e2"), short);
  assert_eq(
    literal("0190f5e2-c3a7-4b6d-8e1f-2a3b4c5d6e7fz"),
    Err({ message: "a UUID is 36 characters, written 8-4-4-4-12", offset: 36 }),
  );
  assert_eq(
    literal("0190f5e2-c3a7-4b6d-8e1f-2a3b4c5d6e7f0"),
    Err({ message: "a UUID is 36 characters, written 8-4-4-4-12", offset: 36 }),
  )
}

test "sixteen octets are a UUID, and no other number of them is" {
  let octets = bytes_of_hex("0190f5e2c3a74b6d8e1f2a3b4c5d6e7f");
  assert_eq(uuid_of_octets(octets), uuid_parse("0190f5e2-c3a7-4b6d-8e1f-2a3b4c5d6e7f"));
  assert_eq(uuid_of_octets(bytes_slice(octets, 0, 15)), None);
  assert_eq(uuid_of_octets(bytes_concat(octets, b"\x00")), None);
  assert_eq(uuid_of_octets(b""), None)
}

test "the nil and max UUIDs are all zeros and all ones, of no version" {
  assert_eq(uuid_render(uuid_nil()), "00000000-0000-0000-0000-000000000000");
  assert_eq(uuid_render(uuid_max()), "ffffffff-ffff-ffff-ffff-ffffffffffff");
  assert_eq(uuid_variant(uuid_nil()), Ncs);
  assert_eq(uuid_variant(uuid_max()), Future);
  assert_eq(uuid_version(uuid_nil()), None);
  assert_eq(uuid_version(uuid_max()), None);
  assert_eq(uuid_time(uuid_max()), None)
}

type Leading = { ninth: String, variant: UuidVariant }

/// The least and the greatest ninth octet of each variant.
fn leading() -> List<Leading> =
  [
    { ninth: "00", variant: Ncs },
    { ninth: "7f", variant: Ncs },
    { ninth: "80", variant: Rfc },
    { ninth: "bf", variant: Rfc },
    { ninth: "c0", variant: Microsoft },
    { ninth: "df", variant: Microsoft },
    { ninth: "e0", variant: Future },
    { ninth: "ff", variant: Future },
  ]

test "a ninth octet of {c.ninth} is the {c.variant} variant" for c: Leading in leading() {
  let u = the("0190f5e2-c3a7-7b6d-" ++ c.ninth ++ "1f-2a3b4c5d6e7f");
  assert_eq(uuid_variant(u), c.variant);
  assert_eq(uuid_version(u), if c.variant == Rfc { Some(7) } else { None })
}

type Example = { section: String, text: String, version: Int, made_ms: Option<Int> }

/// RFC 9562's appendices A and B, as it writes them: each example, the version it is of, and the
/// millisecond those that state a time were made in, 2022-02-22T19:22:22Z.
fn rfc_examples() -> List<Example> =
  [
    {
      section: "A.1",
      text: "C232AB00-9414-11EC-B3C8-9F6BDECED846",
      version: 1,
      made_ms: Some(1645557742000),
    },
    { section: "A.2", text: "5df41881-3aed-3515-88a7-2f4a814cf09e", version: 3, made_ms: None },
    { section: "A.3", text: "919108f7-52d1-4320-9bac-f847db4148a8", version: 4, made_ms: None },
    { section: "A.4", text: "2ed6657d-e927-568b-95e1-2665a8aea6a2", version: 5, made_ms: None },
    {
      section: "A.5",
      text: "1EC9414C-232A-6B00-B3C8-9F6BDECED846",
      version: 6,
      made_ms: Some(1645557742000),
    },
    {
      section: "A.6",
      text: "017F22E2-79B0-7CC3-98C4-DC0C0C07398F",
      version: 7,
      made_ms: Some(1645557742000),
    },
    { section: "B.1", text: "2489E9AD-2EE2-8E00-8EC9-32D5F69181C0", version: 8, made_ms: None },
    { section: "B.2", text: "5c146b14-3c52-8afd-938a-375d0df1fbf6", version: 8, made_ms: None },
  ]

test "RFC 9562's example {c.section} is of version {c.version}" for c: Example in rfc_examples() {
  let u = the(c.text);
  assert_eq(uuid_variant(u), Rfc);
  assert_eq(uuid_version(u), Some(c.version));
  assert_eq(uuid_time(u), option_map(c.made_ms, at_ms))
}

type Namespace = { name: String, namespace: Uuid, text: String }

/// RFC 9562's table 3.
fn rfc_namespaces() -> List<Namespace> =
  [
    { name: "DNS", namespace: uuid_namespace_dns(), text: "6ba7b810-9dad-11d1-80b4-00c04fd430c8" },
    { name: "URL", namespace: uuid_namespace_url(), text: "6ba7b811-9dad-11d1-80b4-00c04fd430c8" },
    { name: "OID", namespace: uuid_namespace_oid(), text: "6ba7b812-9dad-11d1-80b4-00c04fd430c8" },
    {
      name: "X500",
      namespace: uuid_namespace_x500(),
      text: "6ba7b814-9dad-11d1-80b4-00c04fd430c8",
    },
  ]

test "the {c.name} namespace is the one RFC 9562 registers" for c: Namespace in rfc_namespaces() {
  assert_eq(uuid_render(c.namespace), c.text)
}

type Named = { namespace: Uuid, name: String, id: String }

/// RFC 9562's appendix A.4 first, then what Python's `uuid.uuid5` answers.
fn named() -> List<Named> =
  [
    {
      namespace: uuid_namespace_dns(),
      name: "www.example.com",
      id: "2ed6657d-e927-568b-95e1-2665a8aea6a2",
    },
    {
      namespace: uuid_namespace_dns(),
      name: "python.org",
      id: "886313e1-3b8a-5372-9b90-0c9aee199e5d",
    },
    { namespace: uuid_namespace_dns(), name: "", id: "4ebd0208-8328-5d69-8c44-ec50939c0967" },
    {
      namespace: uuid_namespace_dns(),
      name: "b\u{fc}cher.example",
      id: "849d4d8f-6c8e-59fa-9721-89ccba396bf9",
    },
    {
      namespace: uuid_namespace_url(),
      name: "https://example.com/a?b=c",
      id: "c33ae727-a88e-54fd-83c1-eb80bc195938",
    },
    {
      namespace: uuid_namespace_oid(),
      name: "1.3.6.1.4.1",
      id: "106dd502-8b3e-50db-80ed-1134f5c18eae",
    },
    {
      namespace: uuid_namespace_x500(),
      name: "CN=Ply,O=Example",
      id: "a5da2c06-acbd-558e-b610-d880b37d6132",
    },
    { namespace: uuid_nil(), name: "x", id: "f3e951bb-a80b-5e6c-a038-a56ee0caa25d" },
  ]

test "the version 5 UUID of \"{c.name}\" in {uuid_render(c.namespace)}" for c: Named in named() {
  assert_eq(uuid_render(uuid_v5(c.namespace, bytes_of_string(c.name))), c.id)
}

test "v4 overwrites the version and variant bits and nothing else" {
  let zeros = handle { uuid_v4() } with { entropy.next() -> 0 };
  assert_eq(uuid_render(zeros), "00000000-0000-4000-8000-000000000000");
  // A draw's sixty-three bits are all set here, and so is every bit of the UUID that is drawn.
  let ones = handle { uuid_v4() } with { entropy.next() -> 0x7FFF_FFFF_FFFF_FFFF };
  assert_eq(uuid_render(ones), "ffffffff-ffff-4fff-bfff-ffffffffffff");
  assert_eq(uuid_version(ones), Some(4));
  // Three draws: the low six octets of the first two and the low four of the third.
  let counted = handle { uuid_v4() } with { entropy.next() -> 0x0102_0304_0506_0708 };
  assert_eq(uuid_render(counted), "03040506-0708-4304-8506-070805060708")
}

test "RFC 9562's version 7 example is its millisecond and its random fields laid out" {
  let made = at_ms(1645557742000);
  let u = uuid_v7_at(made, 0xCC3, 0x18C4_DC0C_0C07_398F);
  assert_eq(u, the("017F22E2-79B0-7CC3-98C4-DC0C0C07398F"));
  // Only the low twelve and the low sixty-two bits of the draws are read.
  assert_eq(uuid_v7_at(made, 0x7FFF_FFFF_FFFF_FCC3, 0x58C4_DC0C_0C07_398F), u);
  // Any reading inside the millisecond is that millisecond.
  assert_eq(uuid_v7_at(Instant(1645557742000999999), 0xCC3, 0x18C4_DC0C_0C07_398F), u)
}

test "v7 is the clock's millisecond and two draws, so handling both pins it" {
  let u = handle {
    uuid_v7()
  } with {
    time.now_ms() -> 1645557742000,
    entropy.next() -> 0x18C4_DC0C_0C07_398F,
  };
  assert_eq(uuid_render(u), "017f22e2-79b0-798f-98c4-dc0c0c07398f");
  assert_eq(uuid_time(u), Some(at_ms(1645557742000)))
}

test "a reading before 1970 is written as 1970, and one past what forty-eight bits count as the last they do" {
  assert_eq(uuid_time(uuid_v7_at(Instant(0 - 1), 0, 0)), Some(Instant(0)));
  assert_eq(
    uuid_render(uuid_v7_at(Instant(0 - 5000000000), 1, 2)),
    "00000000-0000-7001-8000-000000000002",
  );
  let late = handle {
    uuid_v7()
  } with {
    time.now_ms() -> 0x7FFF_FFFF_FFFF_FFFF,
    entropy.next() -> 0,
  };
  assert_eq(uuid_render(late), "ffffffff-ffff-7000-8000-000000000000");
  let early = handle { uuid_v7() } with { time.now_ms() -> 0 - 1, entropy.next() -> 0 };
  assert_eq(uuid_render(early), "00000000-0000-7000-8000-000000000000")
}

test "a UUID made after another is in its millisecond with the counter one higher until the clock passes it" {
  let first = uuid_v7_at(at_ms(1000), 0x123, 5);
  assert_eq(uuid_render(first), "00000000-03e8-7123-8000-000000000005");
  let same = uuid_v7_after_at(first, at_ms(1000), 0xABC, 6);
  assert_eq(option_map(same, uuid_render), Some("00000000-03e8-7124-8000-000000000006"));
  let back = uuid_v7_after_at(first, at_ms(999), 0xABC, 7);
  assert_eq(option_map(back, uuid_render), Some("00000000-03e8-7124-8000-000000000007"));
  let on = uuid_v7_after_at(first, at_ms(1001), 0xABC, 8);
  assert_eq(option_map(on, uuid_render), Some("00000000-03e9-7abc-8000-000000000008"));
  // A counter of zero is a counter: what follows it holds one, whatever was drawn.
  let zero = uuid_v7_after_at(uuid_v7_at(at_ms(1000), 0, 5), at_ms(1000), 0, 0);
  assert_eq(option_map(zero, uuid_render), Some("00000000-03e8-7001-8000-000000000000"))
}

test "a spent counter carries into the next millisecond, and a UUID of a lower version is passed in its own" {
  let spent = uuid_v7_at(at_ms(1000), 0xFFF, 5);
  let carried = uuid_v7_after_at(spent, at_ms(1000), 0xABC, 6);
  assert_eq(option_map(carried, uuid_render), Some("00000000-03e9-7abc-8000-000000000006"));
  let random = the("00000000-03e8-4fff-bfff-ffffffffffff");
  let passed = uuid_v7_after_at(random, at_ms(1000), 0xABC, 6);
  assert_eq(option_map(passed, uuid_render), Some("00000000-03e8-7abc-8000-000000000006"));
  let custom = the("00000000-03e8-8000-8000-000000000000");
  let past = uuid_v7_after_at(custom, at_ms(1000), 0xABC, 6);
  assert_eq(option_map(past, uuid_render), Some("00000000-03e9-7abc-8000-000000000006"))
}

test "nothing follows the last counter of the last millisecond" {
  let nearly = the("ffffffff-ffff-7ffe-8000-000000000000");
  assert_eq(
    option_map(uuid_v7_after_at(nearly, at_ms(0), 0, 9), uuid_render),
    Some("ffffffff-ffff-7fff-8000-000000000009"),
  );
  assert_eq(uuid_v7_after_at(the("ffffffff-ffff-7fff-8000-000000000000"), at_ms(0), 0, 0), None);
  assert_eq(uuid_v7_after_at(uuid_max(), at_ms(0), 0, 0), None)
}

test "v7 made after another under a clock that stands still comes out in order" {
  let made = handle {
    let first = uuid_v7();
    let second = option_expect(uuid_v7_after(first), "a second");
    [first, second, option_expect(uuid_v7_after(second), "a third")]
  } with {
    time.now_ms() -> 1645557742000,
    entropy.next() -> 0x18C4_DC0C_0C07_398F,
  };
  assert_eq(map(made, uuid_render), [
    "017f22e2-79b0-798f-98c4-dc0c0c07398f",
    "017f22e2-79b0-7990-98c4-dc0c0c07398f",
    "017f22e2-79b0-7991-98c4-dc0c0c07398f",
  ])
}

test "a map keyed by version 7 UUIDs lists them in the order they were made" {
  // Eight to a millisecond from a counter two short of spent, so some carry past the clock.
  let made = fold(
    range(1, 24),
    [uuid_v7_at(at_ms(1645557742000), 0xFFE, 1)],
    |us: List<Uuid>, i: Int|
      match option_and_then(last(us), |u: Uuid|
          uuid_v7_after_at(u, at_ms(1645557742000 + i / 8), 7919 * i, 104729 * (24 - i))) {
        Some(next) -> push(us, next),
        None -> us,
      },
  );
  assert_eq(len(made), 24);
  let kept = fold(range(0, 24), map_new(), |m: Map<Uuid, Int>, i: Int| {
    let place = i * 7 % 24;
    match list_at(made, place) { Some(u) -> map_insert(m, u, place), None -> m }
  });
  assert_eq(map_keys(kept), made);
  assert_eq(map_values(kept), range(0, 24))
}

test "the generator draws the nil and max UUIDs, every variant and every version" {
  let drawn = fold(range(0, 400), [], |us: List<Uuid>, root: Int|
    match gen::sample(uuid_gen(), root, b"uuid", root % 64, None).value {
      Some(u) -> push(us, u),
      None -> us,
    });
  assert_eq(len(drawn), 400);
  assert(contains(drawn, uuid_nil()));
  assert(contains(drawn, uuid_max()));
  // The nil UUID is of one variant and the max of another, so they are set aside.
  let variants = map(filter(drawn, |u: Uuid| u != uuid_nil() && u != uuid_max()), uuid_variant);
  assert_eq(filter([Ncs, Rfc, Microsoft, Future], |v: UuidVariant| !contains(variants, v)), []);
  let versions = map(drawn, uuid_version);
  assert_eq(filter(range(0, 16), |v: Int| !contains(versions, Some(v))), []);
  // The simplest draw, which a counterexample shrinks toward, is the nil UUID.
  assert_eq(gen::sample(uuid_gen(), 0, b"", 0, Some([])).value, Some(uuid_nil()))
}
