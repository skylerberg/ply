//! A 128-bit identifier, its canonical text form, and a v4 draw.
//!
//! The value is the sixteen octets; the text form is a rendering of them, so a `Uuid` parsed and a
//! `Uuid` generated are the same kind of value and compare by their octets. Only this module
//! builds one, so every `Uuid` holds exactly sixteen. Parsing and rendering are pure and total (a
//! string that is not the canonical form is `None`, not a raise); only `v4` reaches the world, and
//! it draws through `std.random`'s `entropy` so a test can pin it.

import std.bytes (bytes_of_hex, hex_of, u64_be)
import std.gen
import std.gen (Gen)
import std.laws (round_trip)
import std.random (entropy)

/// A 128-bit identifier as its sixteen octets, which is what two compare by.
pub opaque type Uuid = new { octets: Bytes }

/// The `Uuid` that is these octets, or `None` unless there are sixteen of them.
pub fn uuid_of_octets(octets: Bytes) -> Option<Uuid> =
  if bytes_len(octets) == 16 { Some({ octets: octets }) } else { None }

gen for Uuid by uuid_gen

/// Any sixteen octets, which is every `Uuid` there is.
pub fn uuid_gen() -> Gen<Uuid> = gen::map(gen::bytes_of(16), |octets: Bytes| { octets: octets })

/// The canonical form: lowercase hex, 8-4-4-4-12, as RFC 9562 §4 writes it.
pub fn uuid_render(u: Uuid) -> String / {abort.raise} = {
  let h = hex_of(u.octets);
  string_slice(h, 0, 8) ++ "-" ++ string_slice(h, 8, 12) ++ "-" ++ string_slice(h, 12, 16) ++ "-"
    ++ string_slice(h, 16, 20)
    ++ "-"
    ++ string_slice(h, 20, 32)
}

/// The `Uuid` a canonical text names, or `None`. Upper case is accepted — RFC 9562 says a reader
/// must accept it — and `uuid_render` always writes lower case.
pub fn uuid_parse(text: String) -> Option<Uuid> / {abort.raise} =
  if string_len(text) != 36 { None }
  else if string_slice(text, 8, 9) != "-" || string_slice(text, 13, 14) != "-"
      || string_slice(text, 18, 19) != "-"
      || string_slice(text, 23, 24) != "-" { None } else {
    // `bytes_of_hex` reads lower case only, and RFC 9562 says a reader accepts either.
    let h = lower_hex(
      string_slice(text, 0, 8) ++ string_slice(text, 9, 13) ++ string_slice(text, 14, 18)
        ++ string_slice(text, 19, 23)
        ++ string_slice(text, 24, 36),
    );
    if is_hex(h) { Some({ octets: bytes_of_hex(h) }) } else { None }
  }

/// What a `uuid"..."` literal is checked by: the `Uuid` a canonical text names, or the first
/// character that keeps it from being one.
pub fn literal(text: String) -> Result<Uuid, { message: String, offset: Int }> / {abort.raise} =
  match uuid_parse(text) {
    Some(u) -> Ok(u),
    None -> {
      let n = string_len(text);
      let stray = fold(range(0, min(n, 36)), None, |found: Option<Int>, i: Int|
        if found != None || placed(text, i) { found } else { Some(i) });
      Err(match stray {
        Some(i) ->
          { message: if hyphen_at(i) { "a `-` goes here" } else { "not a hex digit" }, offset: i },
        None -> { message: "a UUID is 36 characters, written 8-4-4-4-12", offset: min(n, 36) },
      })
    },
  }

fn hyphen_at(i: Int) -> Bool = i == 8 || i == 13 || i == 18 || i == 23

/// Whether the character at `i` is what the canonical form has there.
fn placed(text: String, i: Int) -> Bool / {abort.raise} = {
  let c = string_slice(text, i, i + 1);
  if hyphen_at(i) { c == "-" } else { is_hex(lower_hex(c)) }
}

/// A version 4 identifier: sixteen random octets with the version (6) and variant (8, 9, a or b)
/// bits overwritten.
pub fn uuid_v4() -> Uuid / {entropy.next bounded, abort.raise} = {
  // Two `Int`s of entropy are sixteen octets; the host's draw is what makes them random, so this
  // is one effect perform per machine word rather than a loop of sixteen.
  let raw = bytes_concat(u64_be(entropy.next()), u64_be(entropy.next()));
  {
    octets: bytes_concat_all(
      map(range(0, 16), |i: Int| byte_of_int(v4_octet(bytes_at(raw, i), i))),
    ),
  }
}

fn v4_octet(octet: Int, at: Int) -> Int =
  if at == 6 { octet & 0x0F | 0x40 } else if at == 8 { octet & 0x3F | 0x80 } else { octet }

fn is_hex(text: String) -> Bool =
  fold(range(0, string_len(text)), true, |ok: Bool, i: Int|
    ok && string_contains(hex_digits(), string_slice(text, i, i + 1)))

fn hex_digits() -> String = "0123456789abcdef"

fn lower_hex(text: String) -> String / {abort.raise} =
  fold(range(0, string_len(text)), "", |acc: String, i: Int|
    acc ++ lower_hex_char(string_slice(text, i, i + 1)))

fn lower_hex_char(c: String) -> String / {abort.raise} =
  if string_contains("ABCDEF", c) {
    string_slice("abcdef", string_find("ABCDEF", c), string_find("ABCDEF", c) + 1)
  } else { c }

// --- Tests ------------------------------------------------------------------

law "a UUID's text reads back as it" = round_trip(uuid_render, uuid_parse)

law "every UUID renders as 8-4-4-4-12"
  forall (us: List<Uuid>) {
    fold(us, true, |ok: Bool, u: Uuid| {
      let text = uuid_render(u);
      ok && string_len(text) == 36 && literal(text) == Ok(u)
    })
  }

test "render is the canonical lowercase form and parse is its inverse" {
  let u: Uuid = { octets: bytes_of_hex("0190f5e2c3a74b6d8e1f2a3b4c5d6e7f") };
  assert_eq(uuid_render(u), "0190f5e2-c3a7-4b6d-8e1f-2a3b4c5d6e7f");
  assert_eq(uuid_parse("0190f5e2-c3a7-4b6d-8e1f-2a3b4c5d6e7f"), Some(u));
  // A reader accepts upper case; a writer never produces it.
  assert_eq(uuid_parse("0190F5E2-C3A7-4B6D-8E1F-2A3B4C5D6E7F"), Some(u))
}

test "parse refuses anything that is not 8-4-4-4-12 hex" {
  assert_eq(uuid_parse("0190f5e2c3a74b6d8e1f2a3b4c5d6e7f"), None);
  assert_eq(uuid_parse("0190f5e2-c3a7-4b6d-8e1f-2a3b4c5d6e7"), None);
  assert_eq(uuid_parse("0190f5e2-c3a7-4b6d-8e1f-2a3b4c5d6e7g"), None);
  assert_eq(uuid_parse("0190f5e2c3a7-4b6d-8e1f-2a3b-4c5d6e7f"), None)
}

test "a literal's check answers the UUID, or the character that keeps the text from being one" {
  assert_eq(
    literal("0190f5e2-c3a7-4b6d-8e1f-2a3b4c5d6e7f"),
    Ok({ octets: bytes_of_hex("0190f5e2c3a74b6d8e1f2a3b4c5d6e7f") }),
  );
  assert_eq(
    literal("0190f5e2-c3a7-4b6d-8e1f-2a3b4c5d6e7g"),
    Err({ message: "not a hex digit", offset: 35 }),
  );
  assert_eq(
    literal("0190f5e2c3a7-4b6d-8e1f-2a3b-4c5d6e7f"),
    Err({ message: "a `-` goes here", offset: 8 }),
  );
  let short = Err({ message: "a UUID is 36 characters, written 8-4-4-4-12", offset: 8 });
  assert_eq(literal("0190f5e2"), short);
  assert_eq(
    literal("0190f5e2-c3a7-4b6d-8e1f-2a3b4c5d6e7f0"),
    Err({ message: "a UUID is 36 characters, written 8-4-4-4-12", offset: 36 }),
  )
}

test "sixteen octets are a UUID, and no other number of them is" {
  let octets = bytes_of_hex("0190f5e2c3a74b6d8e1f2a3b4c5d6e7f");
  assert_eq(uuid_of_octets(octets), uuid_parse("0190f5e2-c3a7-4b6d-8e1f-2a3b4c5d6e7f"));
  assert_eq(uuid_of_octets(bytes_slice(octets, 0, 15)), None);
  assert_eq(uuid_of_octets(bytes_concat(octets, b"\x00")), None);
  assert_eq(uuid_of_octets(b""), None)
}

law "a UUID is the one its octets make" = round_trip(|u: Uuid| u.octets, uuid_of_octets)

test "v4 overwrites the version and variant bits and nothing else" {
  let u = handle { uuid_v4() } with { entropy.next() -> 0 };
  assert_eq(bytes_len(u.octets), 16);
  assert_eq(bytes_at(u.octets, 6) / 16, 4);
  assert_eq(bytes_at(u.octets, 8) / 64, 2);
  // Every other octet is what the draw was, which here is zero.
  assert_eq(bytes_at(u.octets, 5), 0)
}
