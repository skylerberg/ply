// `float` — what a program asks of a `Float` beyond arithmetic: whether it is a number at all, its
// sign, its whole part and its magnitude, and the powers of two and special values an IEEE-754
// double is built from. Every answer is read off the value's bits, so none of it raises.

pub fn is_nan(f: Float) -> Bool = f != f

pub fn is_infinite(f: Float) -> Bool = magnitude_bits(f) == infinity_bits()

pub fn is_finite(f: Float) -> Bool = magnitude_bits(f) < infinity_bits()

/// Set for `-0.0` and a negative NaN as well as for a negative number.
pub fn is_sign_negative(f: Float) -> Bool = bits_of_float(f) < 0

pub fn abs(f: Float) -> Float = float_of_bits(magnitude_bits(f))

/// The whole part, toward zero; a NaN or an infinity is itself.
pub fn trunc(f: Float) -> Float = truncated(f, bits_of_float(f))

// Below exponent zero only the sign is left; from 52 up every bit is a whole one.
fn truncated(f: Float, bits: Int) -> Float = {
  let exponent = exponent_of(bits);
  if exponent >= 52 { f }
  else if exponent < 0 { float_of_bits(bits & sign_bit()) }
  else { float_of_bits(bits & ~low_bits(52 - exponent)) }
}

fn exponent_of(bits: Int) -> Int = (bits >>> 52 & 0x7FF) - 1023

fn low_bits(n: Int) -> Int = (1 << n) - 1

/// `2^k`: an infinity above the largest finite power, and zero below the least subnormal one.
pub fn pow2(k: Int) -> Float =
  if k > 1023 { infinity() }
  else if k >= 0 - 1022 { float_of_bits(k + 1023 << 52) }
  else if k >= 0 - 1074 { float_of_bits(1 << k + 1074) }
  else { 0.0 }

pub fn nan() -> Float = float_of_bits(0x7FF8_0000_0000_0000)

pub fn infinity() -> Float = float_of_bits(infinity_bits())

pub fn neg_infinity() -> Float = float_of_bits(infinity_bits() | sign_bit())

/// The greatest finite `Float`.
pub fn max_value() -> Float = float_of_bits(0x7FEF_FFFF_FFFF_FFFF)

fn infinity_bits() -> Int = 0x7FF0_0000_0000_0000

fn sign_bit() -> Int = 0x8000_0000_0000_0000

fn magnitude_bits(f: Float) -> Int = bits_of_float(f) & 0x7FFF_FFFF_FFFF_FFFF

test "NaN, the infinities and the finite numbers are told apart" {
  assert(is_nan(nan()));
  assert(!is_nan(1.5));
  assert(is_infinite(infinity()));
  assert(is_infinite(neg_infinity()));
  assert(!is_infinite(max_value()));
  assert(is_finite(max_value()));
  assert(!is_finite(nan()));
  assert(!is_finite(infinity()))
}

test "the sign is the top bit, so negative zero has one" {
  assert(is_sign_negative(-1.5));
  assert(!is_sign_negative(0.0));
  assert(is_sign_negative(float_of_bits(sign_bit())));
  assert_eq(abs(-2.5), 2.5);
  assert_eq(bits_of_float(abs(float_of_bits(sign_bit()))), 0)
}

test "trunc goes toward zero and keeps the sign" {
  assert_eq(trunc(2.75), 2.0);
  assert_eq(trunc(-2.75), -2.0);
  assert_eq(trunc(0.5), 0.0);
  assert(is_sign_negative(trunc(-0.5)));
  assert_eq(trunc(1.0e300), 1.0e300);
  assert(is_nan(trunc(nan())));
  assert_eq(trunc(infinity()), infinity())
}

test "pow2 spans the normal and subnormal range and saturates past it" {
  assert_eq(pow2(0), 1.0);
  assert_eq(pow2(3), 8.0);
  assert_eq(pow2(0 - 2), 0.25);
  assert_eq(bits_of_float(pow2(0 - 1074)), 1);
  assert_eq(pow2(0 - 1075), 0.0);
  assert_eq(pow2(1024), infinity())
}
