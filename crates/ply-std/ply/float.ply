//! What a program asks of a `Float` beyond arithmetic.
//!
//! Whether it is a number at all, its sign, its whole part and its magnitude, and the powers of two
//! and special values an IEEE-754 double is built from. Every answer is read off the value's bits,
//! so none of it raises; the arithmetic over a `Float` is the prelude's. A module that defines its
//! own `sqrt`, `exp`, `ln`, `sin` or `cos`, as one over complex numbers does, has hidden the prelude's
//! from itself: `square_root`, `exponential`, `natural_log`, `sine` and `cosine` are those, under
//! names it can still call.

/// Whether the value is not a number.
pub fn is_nan(f: Float) -> Bool = f != f

/// Whether the value is an infinity of either sign.
pub fn is_infinite(f: Float) -> Bool = magnitude_bits(f) == infinity_bits()

/// Whether the value is neither a NaN nor an infinity.
pub fn is_finite(f: Float) -> Bool = magnitude_bits(f) < infinity_bits()

/// Set for `-0.0` and a negative NaN as well as for a negative number.
pub fn is_sign_negative(f: Float) -> Bool = bits_of_float(f) < 0

/// The value with its sign bit cleared, NaN included.
pub fn abs(f: Float) -> Float = float_of_bits(magnitude_bits(f))

/// `magnitude` with the sign of `sign`, a zero's and a NaN's sign included.
pub fn copy_sign(magnitude: Float, sign: Float) -> Float =
  float_of_bits(magnitude_bits(magnitude) | bits_of_float(sign) & sign_bit())

/// Whether `a` and `b` are within `relative` of the larger of their magnitudes, or within
/// `absolute`, whichever allows more, as Python's `math.isclose` decides. Equal values are close,
/// two infinities of one sign among them, and a `NaN` is close to nothing.
pub fn is_close(a: Float, b: Float, relative: Float, absolute: Float) -> Bool =
  a == b
    || (is_finite(a) && is_finite(b)
    && (abs(a - b) <= relative * abs(a) || abs(a - b) <= relative * abs(b)
    || abs(a - b) <= absolute))

/// The prelude's `sqrt`.
pub fn square_root(x: Float) -> Float = sqrt(x)

/// The prelude's `exp`.
pub fn exponential(x: Float) -> Float = exp(x)

/// The prelude's `ln`.
pub fn natural_log(x: Float) -> Float = ln(x)

/// The prelude's `sin`.
pub fn sine(x: Float) -> Float = sin(x)

/// The prelude's `cos`.
pub fn cosine(x: Float) -> Float = cos(x)

/// The whole part, toward zero; a NaN or an infinity is itself.
pub fn trunc(f: Float) -> Float = truncated(f, bits_of_float(f))

/// Below exponent zero only the sign is left; from 52 up every bit is a whole one.
fn truncated(f: Float, bits: Int) -> Float = {
  let exponent = exponent_of(bits);
  if exponent >= 52 { f }
  else if exponent < 0 { float_of_bits(bits & sign_bit()) }
  else { float_of_bits(bits & ~low_bits(52 - exponent)) }
}

fn exponent_of(bits: Int) -> Int = (bits >>> 52 & 0x7FF) - 1023

fn low_bits(n: Int) -> Int = (1 << n) - 1

/// `2^k`: an infinity above the largest finite power, and zero below the least subnormal one.
pub fn pow2(k: Int) -> Float =
  if k > 1023 { infinity() }
  else if k >= 0 - 1022 { float_of_bits(k + 1023 << 52) }
  else if k >= 0 - 1074 { float_of_bits(1 << k + 1074) }
  else { 0.0 }

/// The nearest `Float` to π.
pub fn pi() -> Float = 3.141592653589793

/// The nearest `Float` to Euler's number.
pub fn e() -> Float = 2.718281828459045

/// The nearest `Float` to 2π, a full turn in radians.
pub fn tau() -> Float = 6.283185307179586

/// The NaN every float builtin answers.
pub fn nan() -> Float = float_of_bits(0x7FF8_0000_0000_0000)

/// Positive infinity.
pub fn infinity() -> Float = float_of_bits(infinity_bits())

/// Negative infinity.
pub fn neg_infinity() -> Float = float_of_bits(infinity_bits() | sign_bit())

/// The greatest finite `Float`.
pub fn max_value() -> Float = float_of_bits(0x7FEF_FFFF_FFFF_FFFF)

fn infinity_bits() -> Int = 0x7FF0_0000_0000_0000

fn sign_bit() -> Int = 0x8000_0000_0000_0000

fn magnitude_bits(f: Float) -> Int = bits_of_float(f) & 0x7FFF_FFFF_FFFF_FFFF

test "NaN, the infinities and the finite numbers are told apart" {
  assert(is_nan(nan()));
  assert(!is_nan(1.5));
  assert(is_infinite(infinity()));
  assert(is_infinite(neg_infinity()));
  assert(!is_infinite(max_value()));
  assert(is_finite(max_value()));
  assert(!is_finite(nan()));
  assert(!is_finite(infinity()))
}

test "the sign is the top bit, so negative zero has one" {
  assert(is_sign_negative(-1.5));
  assert(!is_sign_negative(0.0));
  assert(is_sign_negative(float_of_bits(sign_bit())));
  assert_eq(abs(-2.5), 2.5);
  assert_eq(bits_of_float(abs(float_of_bits(sign_bit()))), 0)
}

test "a sign is copied onto a magnitude, zeros and infinities included" {
  assert_eq(copy_sign(2.5, -1.0), -2.5);
  assert_eq(copy_sign(-2.5, 1.0), 2.5);
  assert(is_sign_negative(copy_sign(0.0, -3.0)));
  assert(!is_sign_negative(copy_sign(float_of_bits(sign_bit()), 3.0)));
  assert_eq(copy_sign(infinity(), float_of_bits(sign_bit())), neg_infinity())
}

test "two floats are close by a share of the larger or by a fixed distance" {
  assert(is_close(1.0, 1.0 + 1e-12, 1e-9, 0.0));
  assert(!is_close(1.0, 1.0 + 1e-6, 1e-9, 0.0));
  assert(is_close(1e-20, 0.0, 1e-9, 1e-12));
  assert(!is_close(1e-20, 0.0, 1e-9, 0.0));
  assert(is_close(infinity(), infinity(), 0.0, 0.0));
  assert(!is_close(infinity(), neg_infinity(), 1.0, 1e300));
  assert(!is_close(infinity(), max_value(), 1.0, 1e300));
  assert(!is_close(nan(), nan(), 1.0, 1.0))
}

test "the elementary functions under their other names are the prelude's" {
  assert_eq(square_root(2.0), sqrt(2.0));
  assert_eq(exponential(1.0), exp(1.0));
  assert_eq(natural_log(10.0), ln(10.0));
  assert_eq(sine(1.0), sin(1.0));
  assert_eq(cosine(1.0), cos(1.0))
}

test "trunc goes toward zero and keeps the sign" {
  assert_eq(trunc(2.75), 2.0);
  assert_eq(trunc(-2.75), -2.0);
  assert_eq(trunc(0.5), 0.0);
  assert(is_sign_negative(trunc(-0.5)));
  assert_eq(trunc(1.0e300), 1.0e300);
  assert(is_nan(trunc(nan())));
  assert_eq(trunc(infinity()), infinity())
}

test "pow2 spans the normal and subnormal range and saturates past it" {
  assert_eq(pow2(0), 1.0);
  assert_eq(pow2(3), 8.0);
  assert_eq(pow2(0 - 2), 0.25);
  assert_eq(bits_of_float(pow2(0 - 1074)), 1);
  assert_eq(pow2(0 - 1075), 0.0);
  assert_eq(pow2(1024), infinity())
}

test "pi, e and tau are the nearest floats to themselves" {
  assert_eq(bits_of_float(pi()), 0x4009_21FB_5444_2D18);
  assert_eq(bits_of_float(e()), 0x4005_BF0A_8B14_5769);
  assert_eq(bits_of_float(tau()), 0x4019_21FB_5444_2D18);
  assert_eq(tau(), 2.0 * pi())
}
