//! JSON: the value, a parser, a serializer, and the codecs `derive json for T` builds on.
//!
//! Numbers are `Decimal`, so a document's numbers read back exactly, and objects are maps, so key order
//! is canonical. A `JsonCodec<a>` pairs an encoder with a decoder; the codecs here are the ones a
//! derived codec is made of, and `decode_bytes`, `decode_string`, `encode_bytes` and `encode_string`
//! run one end to end.
//!
//! `to_bytes` writes a value with no whitespace and `pretty_bytes` writes it indented: one writer
//! makes both, so they hold the same tokens. `parse_lines` and `lines_to_bytes` read and write JSON
//! Lines, a value a line, and `lines_start`, `lines_step` and `lines_end` are the same reader for an
//! input that arrives in chunks. A `Pointer` is a JSON Pointer (RFC 6901), which `resolve` follows
//! into a value.

// --- The value --------------------------------------------------------------

import std.bytes
import std.bytes (hex_value, int_of_ascii, peek, scan, scan_until)
import std.laws (agrees, round_trip)
import std.list (at_or, concat, take)

/// A JSON value.
pub type Json =
  | Null
  | Bool(Bool)
  | Number(Decimal)
  | Str(String)
  | Array(List<Json>)
  | Object(Map<String, Json>)

/// The deepest nesting `parse` will accept.
pub fn max_depth() -> Int = 128

// --- Errors -----------------------------------------------------------------

/// `offset` is set only by the parser; a codec over a parsed `Json` locates an error by `path`.
pub type DecodeError = { path: String, offset: Option<Int>, message: String }

/// An error with no place yet; the decoders around it add the path.
pub fn decode_error(message: String) -> DecodeError = { path: "", offset: None, message: message }

/// An error at a byte offset of the parsed text.
pub fn error_at(offset: Int, message: String) -> DecodeError =
  { path: "", offset: Some(offset), message: message }

/// An error saying `what` was expected and naming the kind of value `found` is instead.
pub fn expected(what: String, found: Json) -> DecodeError =
  decode_error("expected " ++ what ++ ", found " ++ kind_of(found))

/// What a value is, as an error names it: `null`, `a number`, `an object`.
pub fn kind_of(j: Json) -> String =
  match j {
    Null -> "null",
    Bool(_) -> "a boolean",
    Number(_) -> "a number",
    Str(_) -> "a string",
    Array(_) -> "an array",
    Object(_) -> "an object",
  }

/// A path is built inside out: each enclosing decoder prefixes the step it took.
pub fn in_field(name: String, e: DecodeError) -> DecodeError =
  { path: "." ++ name ++ e.path, offset: e.offset, message: e.message }

/// `e`, one array index further in.
pub fn in_index(index: Int, e: DecodeError) -> DecodeError =
  { path: "[" ++ int_to_string(index) ++ "]" ++ e.path, offset: e.offset, message: e.message }

/// `$.lines[2].unit_price: expected a number, found a string`, with the byte offset when the parser
/// found it.
pub fn error_to_string(e: DecodeError) -> String =
  "$" ++ e.path ++ ": " ++ e.message
    ++ (match e.offset { Some(n) -> " (at byte " ++ int_to_string(n) ++ ")", None -> "" })

// --- Codecs -----------------------------------------------------------------

/// How to write an `a` as JSON and read one back.
pub type JsonCodec<a> = {
  encode: (a) -> Json / {abort.raise},
  decode: (Json) -> Result<a, DecodeError> / {abort.raise},
}

/// A decoded value through `f`; an error passes through.
pub fn decode_map<a, b | e>(
  r: Result<a, DecodeError>,
  f: (a) -> b / e,
) -> Result<b, DecodeError> / e = match r { Ok(x) -> Ok(f(x)), Err(e) -> Err(e) }

/// A decoded value through a further decoding step; the first error wins.
pub fn decode_and_then<a, b | e>(
  r: Result<a, DecodeError>,
  f: (a) -> Result<b, DecodeError> / e,
) -> Result<b, DecodeError> / e = match r { Ok(x) -> f(x), Err(e) -> Err(e) }

// --- The parser -------------------------------------------------------------

type Step = { value: Json, next: Int }

type Text = { text: String, next: Int }

type Piece = { bytes: Bytes, next: Int }

/// One JSON document: valid UTF-8, nested at most `max_depth` deep, with nothing but whitespace after
/// its value. A byte order mark is no part of one, and is refused by name.
pub fn parse(src: Bytes) -> Result<Json, DecodeError> / {abort.raise} =
  parse_within(src, max_depth())

/// `parse`, of a document nested at most `limit` deep; a `limit` past `max_depth` is `max_depth`.
fn parse_within(src: Bytes, limit: Int) -> Result<Json, DecodeError> / {abort.raise} =
  if !bytes_is_utf8(src) { Err(error_at(0, "a JSON document must be valid UTF-8")) } else {
    let step = value(src, skip_ws(src, 0), 0, min(limit, max_depth()))?;
    parse_end(src, step)
  }

/// `parse` over a string's bytes.
pub fn parse_string(src: String) -> Result<Json, DecodeError> / {abort.raise} =
  parse(bytes_of_string(src))

/// Anything but whitespace after the value is an error, so `Ok` means the input was one document.
fn parse_end(src: Bytes, step: Step) -> Result<Json, DecodeError> / {abort.raise} = {
  let end = skip_ws(src, step.next);
  if end == bytes_len(src) { Ok(step.value) }
  else { Err(error_at(end, "the document ended here; nothing may follow the top-level value")) }
}

fn ws() -> Bytes = b" \t\r\n"

fn digits() -> Bytes = b"0123456789"

fn skip_ws(src: Bytes, i: Int) -> Int / {abort.raise} = scan(src, i, ws())

/// Tests are ordered by how often a payload holds them: strings and numbers first.
fn value(src: Bytes, i: Int, depth: Int, limit: Int) -> Result<Step, DecodeError> / {abort.raise} = {
  let c = peek(src, i);
  if c == 34 { string_value(src, i) }
  else if c == 45 || (c >= 48 && c <= 57) { number(src, i) }
  else if c == 123 { object_value(src, i, depth, limit) }
  else if c == 91 { array_value(src, i, depth, limit) }
  else if c == 116 { keyword(src, i, b"true", Bool(true)) }
  else if c == 102 { keyword(src, i, b"false", Bool(false)) }
  else if c == 110 { keyword(src, i, b"null", Null) }
  else if c < 0 { Err(error_at(i, "the input ended where a value was expected")) }
  else if bytes_starts_with(bytes_slice(src, i, bytes_len(src)), byte_order_mark()) {
    Err(error_at(i, "a byte order mark is no part of JSON: remove its three bytes"))
  } else {
    Err(error_at(i, "expected a value: `{`, `[`, `\"`, a number, `true`, `false` or `null`"))
  }
}

fn byte_order_mark() -> Bytes = b"\xef\xbb\xbf"

fn keyword(src: Bytes, i: Int, word: Bytes, v: Json) -> Result<Step, DecodeError> / {abort.raise} =
  if i + bytes_len(word) > bytes_len(src) {
    Err(error_at(i, "the input ended inside `" ++ string_of_bytes(word) ++ "`"))
  } else if bytes_slice(src, i, i + bytes_len(word)) == word {
    Ok({ value: v, next: i + bytes_len(word) })
  } else { Err(error_at(i, "expected `" ++ string_of_bytes(word) ++ "`")) }

// --- The parser: arrays -----------------------------------------------------

fn array_value(
  src: Bytes,
  i: Int,
  depth: Int,
  limit: Int,
) -> Result<Step, DecodeError> / {abort.raise} =
  if depth >= limit { Err(too_deep_at(i, limit)) }
  else { array_start(src, skip_ws(src, i + 1), depth + 1, limit) }

fn too_deep_at(i: Int, limit: Int) -> DecodeError =
  error_at(
    i,
    "nested deeper than " ++ int_to_string(max(limit, 0))
      ++ (if limit == 1 { " level" } else { " levels" }),
  )

/// An item and its comma take two bytes at least, so the bytes left bound the items: `left`.
fn array_start(
  src: Bytes,
  i: Int,
  depth: Int,
  limit: Int,
) -> Result<Step, DecodeError> / {abort.raise} =
  if peek(src, i) == 93 { Ok({ value: Array([]), next: i + 1 }) }
  else { array_items(src, i, depth, limit, [], bytes_len(src) - i) }

reuse fn array_items(
  src: Bytes,
  i: Int,
  depth: Int,
  limit: Int,
  acc: List<Json>,
  left: Int,
) -> Result<Step, DecodeError> / {abort.raise} = {
  let step = value(src, i, depth, limit)?;
  array_more(src, step, depth, limit, push(acc, step.value), left)
}

fn array_more(
  src: Bytes,
  step: Step,
  depth: Int,
  limit: Int,
  items: List<Json>,
  left: Int,
) -> Result<Step, DecodeError> / {abort.raise} = {
  let j = skip_ws(src, step.next);
  let c = peek(src, j);
  if c == 44 {
    if left <= 0 { panic("more items than bytes") }
    else { array_items(src, skip_ws(src, j + 1), depth, limit, items, left - 1) }
  } else if c == 93 { Ok({ value: Array(items), next: j + 1 }) }
  else { Err(error_at(j, "expected `,` or `]` in an array")) }
}

// --- The parser: objects ----------------------------------------------------

fn object_value(
  src: Bytes,
  i: Int,
  depth: Int,
  limit: Int,
) -> Result<Step, DecodeError> / {abort.raise} =
  if depth >= limit { Err(too_deep_at(i, limit)) }
  else { object_start(src, skip_ws(src, i + 1), depth + 1, limit) }

/// `left` as in `array_start`.
fn object_start(
  src: Bytes,
  i: Int,
  depth: Int,
  limit: Int,
) -> Result<Step, DecodeError> / {abort.raise} =
  if peek(src, i) == 125 { Ok({ value: Object(map_new()), next: i + 1 }) }
  else { object_members(src, i, depth, limit, map_new(), bytes_len(src) - i) }

fn object_members(
  src: Bytes,
  i: Int,
  depth: Int,
  limit: Int,
  acc: Map<String, Json>,
  left: Int,
) -> Result<Step, DecodeError> / {abort.raise} =
  if peek(src, i) != 34 { Err(error_at(i, "an object key must be a quoted string")) } else {
    let key = string_body(src, i + 1)?;
    object_colon(src, key, depth, limit, acc, left)
  }

fn object_colon(
  src: Bytes,
  key: Text,
  depth: Int,
  limit: Int,
  acc: Map<String, Json>,
  left: Int,
) -> Result<Step, DecodeError> / {abort.raise} = {
  let j = skip_ws(src, key.next);
  if peek(src, j) != 58 { Err(error_at(j, "expected `:` after an object key")) }
  else { object_member(src, key.text, skip_ws(src, j + 1), depth, limit, acc, left) }
}

/// A repeated key keeps the last value, as every mainstream JSON parser does.
fn object_member(
  src: Bytes,
  key: String,
  i: Int,
  depth: Int,
  limit: Int,
  acc: Map<String, Json>,
  left: Int,
) -> Result<Step, DecodeError> / {abort.raise} = {
  let step = value(src, i, depth, limit)?;
  object_more(src, step, depth, limit, map_insert(acc, key, step.value), left)
}

fn object_more(
  src: Bytes,
  step: Step,
  depth: Int,
  limit: Int,
  members: Map<String, Json>,
  left: Int,
) -> Result<Step, DecodeError> / {abort.raise} = {
  let j = skip_ws(src, step.next);
  let c = peek(src, j);
  if c == 44 {
    if left <= 0 { panic("more members than bytes") }
    else { object_members(src, skip_ws(src, j + 1), depth, limit, members, left - 1) }
  } else if c == 125 { Ok({ value: Object(members), next: j + 1 }) }
  else { Err(error_at(j, "expected `,` or `}` in an object")) }
}

// --- The parser: strings ----------------------------------------------------

/// A quote, a backslash, or a control byte: everything that ends a run of plain string content.
fn string_stops() -> Bytes =
  b"\"\\\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f"

fn string_value(src: Bytes, i: Int) -> Result<Step, DecodeError> / {abort.raise} = {
  let t = string_body(src, i + 1)?;
  Ok({ value: Str(t.text), next: t.next })
}

/// `i` is the first byte of the content, one past the opening quote. An escape takes two bytes at
/// least, so the bytes left bound the escapes: `left`.
fn string_body(src: Bytes, i: Int) -> Result<Text, DecodeError> / {abort.raise} =
  string_chunks(src, i, b"", bytes_len(src) - i)

/// One native scan per run, so the recursion runs once per escape rather than once per byte.
fn string_chunks(
  src: Bytes,
  i: Int,
  acc: Bytes,
  left: Int,
) -> Result<Text, DecodeError> / {abort.raise} = {
  let n = bytes_len(src);
  let stop = scan_until(src, i, string_stops());
  if stop >= n { Err(error_at(i, "this string is never closed")) }
  else { string_stop(src, stop, bytes_concat(acc, bytes_slice(src, i, stop)), left) }
}

/// `string_of_bytes` cannot fail: valid UTF-8 input, cuts at ASCII bytes, no surrogate escapes.
fn string_stop(
  src: Bytes,
  stop: Int,
  so_far: Bytes,
  left: Int,
) -> Result<Text, DecodeError> / {abort.raise} = {
  let c = bytes_at(src, stop);
  if c == 34 { Ok({ text: string_of_bytes(so_far), next: stop + 1 }) }
  else if c == 92 { string_escape(src, stop, so_far, left) }
  else { Err(error_at(stop, "a control character must be written as an escape inside a string")) }
}

fn string_escape(
  src: Bytes,
  stop: Int,
  so_far: Bytes,
  left: Int,
) -> Result<Text, DecodeError> / {abort.raise} = {
  let p = escape(src, stop + 1)?;
  if left <= 0 { panic("more escapes than bytes") }
  else { string_chunks(src, p.next, bytes_concat(so_far, p.bytes), left - 1) }
}

fn escape(src: Bytes, i: Int) -> Result<Piece, DecodeError> / {abort.raise} = {
  let c = peek(src, i);
  if c == 34 { Ok({ bytes: b"\"", next: i + 1 }) }
  else if c == 92 { Ok({ bytes: b"\\", next: i + 1 }) }
  else if c == 47 { Ok({ bytes: b"/", next: i + 1 }) }
  else if c == 98 { Ok({ bytes: b"\x08", next: i + 1 }) }
  else if c == 102 { Ok({ bytes: b"\x0c", next: i + 1 }) }
  else if c == 110 { Ok({ bytes: b"\n", next: i + 1 }) }
  else if c == 114 { Ok({ bytes: b"\r", next: i + 1 }) }
  else if c == 116 { Ok({ bytes: b"\t", next: i + 1 }) }
  else if c == 117 { unicode_escape(src, i + 1) }
  else { Err(error_at(i - 1, "the escapes are \\\" \\\\ \\/ \\b \\f \\n \\r \\t and \\uXXXX")) }
}

/// A `\u` escape is a UTF-16 unit: past the BMP it is a surrogate pair, and a lone half is refused.
fn unicode_escape(src: Bytes, i: Int) -> Result<Piece, DecodeError> / {abort.raise} = {
  let cp = hex4(src, i);
  if cp < 0 { Err(error_at(i, "a \\u escape needs exactly four hexadecimal digits")) }
  else if cp >= 55296 && cp <= 56319 { surrogate_pair(src, i, cp) }
  else if cp >= 56320 && cp <= 57343 {
    Err(error_at(i, "a low surrogate must follow a high surrogate, which is \\ud800 to \\udbff"))
  } else { Ok({ bytes: utf8(cp), next: i + 4 }) }
}

fn surrogate_pair(src: Bytes, i: Int, high: Int) -> Result<Piece, DecodeError> / {abort.raise} =
  if peek(src, i + 4) != 92 || peek(src, i + 5) != 117 {
    Err(error_at(i, "a high surrogate must be followed by a \\u low surrogate"))
  } else { low_surrogate(i, high, hex4(src, i + 6)) }

fn low_surrogate(i: Int, high: Int, low: Int) -> Result<Piece, DecodeError> / {abort.raise} =
  if low < 56320 || low > 57343 {
    Err(
      error_at(
        i + 6,
        "a high surrogate must be followed by a low surrogate, which is \\udc00 to \\udfff",
      ),
    )
  } else { Ok({ bytes: utf8(65536 + (high - 55296) * 1024 + (low - 56320)), next: i + 10 }) }

fn hex4(src: Bytes, i: Int) -> Int / {abort.raise} = {
  let a = hex_value(peek(src, i));
  let b = hex_value(peek(src, i + 1));
  let c = hex_value(peek(src, i + 2));
  let d = hex_value(peek(src, i + 3));
  if a < 0 || b < 0 || c < 0 || d < 0 { -1 } else { a * 4096 + b * 256 + c * 16 + d }
}

// --- The parser: numbers ----------------------------------------------------

/// JSON's number grammar is stricter than a decimal parser's, so the syntax is checked here.
fn number(src: Bytes, i: Int) -> Result<Step, DecodeError> / {abort.raise} = {
  let start = if peek(src, i) == 45 { i + 1 } else { i };
  let int_end = scan(src, start, digits());
  if int_end == start { Err(error_at(start, "a number needs at least one digit")) }
  else if peek(src, start) == 48 && int_end - start > 1 {
    Err(error_at(i, "a number may not have a leading zero"))
  } else { number_fraction(src, i, int_end) }
}

fn number_fraction(
  src: Bytes,
  i: Int,
  after_int: Int,
) -> Result<Step, DecodeError> / {abort.raise} =
  if peek(src, after_int) != 46 { number_exponent(src, i, after_int) }
  else { number_fraction_digits(src, i, after_int + 1, scan(src, after_int + 1, digits())) }

fn number_fraction_digits(
  src: Bytes,
  i: Int,
  first: Int,
  end: Int,
) -> Result<Step, DecodeError> / {abort.raise} =
  if end == first { Err(error_at(first, "a fraction needs at least one digit after the `.`")) }
  else { number_exponent(src, i, end) }

fn number_exponent(src: Bytes, i: Int, after: Int) -> Result<Step, DecodeError> / {abort.raise} = {
  let c = peek(src, after);
  if c != 101 && c != 69 { number_of(src, i, after) }
  else { number_exponent_digits(src, i, exponent_first(src, after + 1)) }
}

fn exponent_first(src: Bytes, i: Int) -> Int / {abort.raise} = {
  let c = peek(src, i);
  if c == 43 || c == 45 { i + 1 } else { i }
}

fn number_exponent_digits(
  src: Bytes,
  i: Int,
  first: Int,
) -> Result<Step, DecodeError> / {abort.raise} = {
  let end = scan(src, first, digits());
  if end == first { Err(error_at(first, "an exponent needs at least one digit")) }
  else { number_of(src, i, end) }
}

/// A number outside `Decimal` rejects the whole document, even a field no codec would read.
fn number_of(src: Bytes, i: Int, end: Int) -> Result<Step, DecodeError> / {abort.raise} = {
  let text = string_of_bytes(bytes_slice(src, i, end));
  match decimal_of_string(text) {
    Some(d) -> Ok({ value: Number(d), next: end }),
    None ->
      Err(
        error_at(
          i,
          "`" ++ text ++ "` is outside `Decimal`'s range or needs more than 28 significant digits",
        ),
      ),
  }
}

// --- The serializer ---------------------------------------------------------

/// Bounded by the parser's `max_depth`, so nothing is written that `parse` would refuse.
pub fn to_bytes(j: Json) -> Bytes / {abort.raise} = write(j, 0, None)

/// `j` laid out for a reader: every array element and object member on a line of its own, `indent`
/// spaces deeper than what holds it, a space after each member's colon, and an empty array or
/// object as `[]` or `{}`. Members stand in ascending key order, as `to_bytes` writes them, and no
/// line feed follows the last token. An `indent` of zero or less starts every line at the margin.
/// The tokens are `to_bytes`'s own, so the two differ in whitespace alone.
pub fn pretty_bytes(j: Json, indent: Int) -> Bytes / {abort.raise} =
  write(j, 0, Some(bytes::repeat(b" ", indent)))

/// `pretty_bytes` as a string.
pub fn pretty_string(j: Json, indent: Int) -> String / {abort.raise} =
  string_of_bytes(pretty_bytes(j, indent))

fn unwritable<a>() -> a / {abort.raise} =
  panic(
    "a JSON value nested deeper than " ++ int_to_string(max_depth())
      ++ " levels has no encoding `parse` would read back",
  )

/// `pad` is what one level indents by, and `None` writes no whitespace at all.
fn write(j: Json, depth: Int, pad: Option<Bytes>) -> Bytes / {abort.raise} =
  match j {
    Null -> b"null",
    Bool(b) -> if b { b"true" } else { b"false" },
    Number(d) -> bytes_of_string(decimal_to_string(d)),
    Str(s) -> quote(s),
    Array(items) -> if depth >= max_depth() { unwritable() }
    else { held(b"[", map(items, |x: Json| write(x, depth + 1, pad)), b"]", depth, pad) },
    Object(m) -> if depth >= max_depth() { unwritable() } else {
      held(b"{", map(map_entries(m), |e: Member| member(e, depth + 1, pad)), b"}", depth, pad)
    },
  }

/// Valid UTF-8 by construction: every emitted byte is ASCII or comes from a `String`.
pub fn to_string(j: Json) -> String / {abort.raise} = string_of_bytes(to_bytes(j))

/// One member of a JSON object, as `map_entries` yields it and `object` takes it.
pub type Member = { key: String, value: Json }

fn member(e: Member, depth: Int, pad: Option<Bytes>) -> Bytes / {abort.raise} =
  bytes_concat(
    bytes_concat(quote(e.key), match pad { None -> b":", Some(_) -> b": " }),
    write(e.value, depth, pad),
  )

/// What an array or an object at `depth` holds, between its brackets.
fn held(open: Bytes, parts: List<Bytes>, close: Bytes, depth: Int, pad: Option<Bytes>) -> Bytes =
  match pad {
    None -> wrap(open, bytes::join(parts, b","), close),
    Some(step) -> if len(parts) == 0 { bytes_concat(open, close) } else {
      let outer = bytes_concat(b"\n", bytes::repeat(step, depth));
      let inner = bytes_concat(outer, step);
      bytes_concat_all([open, inner, bytes::join(parts, bytes_concat(b",", inner)), outer, close])
    },
  }

fn wrap(open: Bytes, inner: Bytes, close: Bytes) -> Bytes =
  bytes_concat(open, bytes_concat(inner, close))

// `bytes_concat_all` makes one allocation over the whole list.
// --- The serializer: strings ------------------------------------------------

fn quote(s: String) -> Bytes / {abort.raise} = {
  let raw = bytes_of_string(s);
  bytes_concat(
    b"\"",
    bytes_concat(bytes_concat_all(escape_runs(raw, 0, [], bytes_len(raw))), b"\""),
  )
}

/// The mirror of `string_chunks`: one native scan per run of bytes that need no escape. Each run
/// takes the byte it escapes, so the bytes left bound the runs: `left`.
reuse fn escape_runs(
  raw: Bytes,
  i: Int,
  acc: List<Bytes>,
  left: Int,
) -> List<Bytes> / {abort.raise} = {
  let n = bytes_len(raw);
  let stop = scan_until(raw, i, string_stops());
  if stop >= n { push(acc, bytes_slice(raw, i, n)) }
  else if left <= 0 { panic("more escapes than bytes") } else {
    escape_runs(
      raw,
      stop + 1,
      push(acc, bytes_concat(bytes_slice(raw, i, stop), escaped_byte(bytes_at(raw, stop)))),
      left - 1,
    )
  }
}

/// The escape a string writes for a byte it may not hold as it is: a quote, a backslash, or a
/// control character, the ones with a letter by it and any other as `\u00XX`. TOML's basic
/// strings take the same escapes.
pub fn escaped_byte(c: Int) -> Bytes / {abort.raise} =
  if c == 34 { b"\\\"" }
  else if c == 92 { b"\\\\" }
  else if c == 8 { b"\\b" }
  else if c == 9 { b"\\t" }
  else if c == 10 { b"\\n" }
  else if c == 12 { b"\\f" }
  else if c == 13 { b"\\r" }
  else { bytes_concat(b"\\u00", bytes_concat(bytes::hex_digit(c / 16), bytes::hex_digit(c % 16))) }

fn utf8(cp: Int) -> Bytes / {abort.raise} =
  if cp < 128 { byte_of_int(cp) }
  else if cp < 2048 { bytes_concat(byte_of_int(192 + cp / 64), byte_of_int(128 + cp % 64)) }
  else if cp < 65536 {
    bytes_concat(
      byte_of_int(224 + cp / 4096),
      bytes_concat(byte_of_int(128 + cp / 64 % 64), byte_of_int(128 + cp % 64)),
    )
  } else {
    bytes_concat(
      bytes_concat(byte_of_int(240 + cp / 262144), byte_of_int(128 + cp / 4096 % 64)),
      bytes_concat(byte_of_int(128 + cp / 64 % 64), byte_of_int(128 + cp % 64)),
    )
  }

// --- Reading a value --------------------------------------------------------

/// An object's member named `name`; `None` for an absent one and for any value not an object.
pub fn get(j: Json, name: String) -> Option<Json> =
  match j { Object(m) -> map_get(m, name), _ -> None }

/// What a derived record decoder calls per field.
pub fn field<a>(
  j: Json,
  name: String,
  codec: JsonCodec<a>,
) -> Result<a, DecodeError> / {abort.raise} =
  match j { Object(m) -> field_of(m, name, codec), _ -> Err(expected("an object", j)) }

fn field_of<a>(
  m: Map<String, Json>,
  name: String,
  codec: JsonCodec<a>,
) -> Result<a, DecodeError> / {abort.raise} =
  match map_get(m, name) {
    Some(v) -> decode_in_field(name, (codec.decode)(v)),
    None -> Err(in_field(name, decode_error("this field is missing"))),
  }

fn decode_in_field<a>(name: String, r: Result<a, DecodeError>) -> Result<a, DecodeError> =
  match r { Ok(x) -> Ok(x), Err(e) -> Err(in_field(name, e)) }

/// An absent field and a `null` field are one answer.
pub fn optional_field<a>(
  j: Json,
  name: String,
  codec: JsonCodec<a>,
) -> Result<Option<a>, DecodeError> / {abort.raise} =
  match j { Object(m) -> optional_field_of(m, name, codec), _ -> Err(expected("an object", j)) }

fn optional_field_of<a>(
  m: Map<String, Json>,
  name: String,
  codec: JsonCodec<a>,
) -> Result<Option<a>, DecodeError> / {abort.raise} =
  match map_get(m, name) {
    None -> Ok(None),
    Some(Null) -> Ok(None),
    Some(v) -> decode_in_field(name, decode_map((codec.decode)(v), |x: a| Some(x))),
  }

/// An object of these members; a repeated key keeps the last.
pub fn object(fields: List<Member>) -> Json = Object(map_of_entries(fields))

/// An array of these items.
pub fn array(items: List<Json>) -> Json = Array(items)

/// A number holding `n`.
pub fn int(n: Int) -> Json = Number(decimal_of_int(n))

/// An array of strings.
pub fn strings(xs: List<String>) -> Json = Array(map(xs, |x: String| Str(x)))

/// `Null` where there is no string.
pub fn string_or_null(s: Option<String>) -> Json = match s { Some(x) -> Str(x), None -> Null }

/// `Null` where there is no number.
pub fn int_or_null(n: Option<Int>) -> Json = match n { Some(x) -> int(x), None -> Null }

/// `Null` where there are no strings, which is not an empty list of them.
pub fn strings_or_null(xs: Option<List<String>>) -> Json =
  match xs { Some(x) -> strings(x), None -> Null }

// --- ADTs -------------------------------------------------------------------

/// A derived ADT codec's form: a fieldless variant is its tag, else `{"tag": .., "values": [..]}`.
pub type Tagged = { tag: String, values: List<Json> }

/// A variant as a derived codec writes it: its tag alone, or `{"tag", "values"}`.
pub fn variant(tag: String, values: List<Json>) -> Json =
  if len(values) == 0 { Str(tag) }
  else { object([{ key: "tag", value: Str(tag) }, { key: "values", value: Array(values) }]) }

/// A variant written by `variant`, read back.
pub fn variant_of(j: Json) -> Result<Tagged, DecodeError> =
  match j {
    Str(tag) -> Ok({ tag: tag, values: [] }),
    Object(m) -> tagged_of(j, m),
    _ -> Err(expected("a variant: a string, or an object with a `tag`", j)),
  }

fn tagged_of(j: Json, m: Map<String, Json>) -> Result<Tagged, DecodeError> =
  match map_get(m, "tag") {
    Some(Str(tag)) -> Ok({ tag: tag, values: tagged_values(m) }),
    Some(other) -> Err(in_field("tag", expected("a string", other))),
    None -> Err(expected("a variant: a string, or an object with a `tag`", j)),
  }

fn tagged_values(m: Map<String, Json>) -> List<Json> =
  match map_get(m, "values") { Some(Array(vs)) -> vs, _ -> [] }

/// Whether a variant is the one tagged `tag`.
pub fn has_tag(v: Tagged, tag: String) -> Bool = v.tag == tag

/// A variant's value at `index`, refused when it carries fewer.
pub fn variant_value(v: Tagged, index: Int) -> Result<Json, DecodeError> =
  match list_at(v.values, index) {
    Some(x) -> Ok(x),
    None ->
      Err(
        decode_error(
          "`" ++ v.tag ++ "` needs " ++ int_to_string(index + 1) ++ " values, and this one has "
            ++ int_to_string(len(v.values)),
        ),
      ),
  }

/// The error a derived decoder answers for a tag its type does not have.
pub fn unknown_variant<a>(tag: String, expected_tags: List<String>) -> Result<a, DecodeError> =
  Err(
    decode_error(
      "`" ++ tag ++ "` is not one of the variants, which are " ++ comma_list(expected_tags),
    ),
  )

/// A derived codec over a recursive type, past `max_depth` levels of it: no deeper than `parse` reads.
pub fn too_deep<a>() -> JsonCodec<a> =
  {
    encode: |_: a| unwritable(),
    decode: |_: Json|
      Err(decode_error("nested deeper than " ++ int_to_string(max_depth()) ++ " levels")),
  }

fn comma_list(names: List<String>) -> String =
  fold(names, "", |acc: String, n: String| if string_len(acc) == 0 { n } else { acc ++ ", " ++ n })

// --- Leaf codecs ------------------------------------------------------------

/// The value itself.
pub fn json_json() -> JsonCodec<Json> = { encode: |j: Json| j, decode: |j: Json| Ok(j) }

/// A boolean.
pub fn bool_json() -> JsonCodec<Bool> =
  {
    encode: |b: Bool| Bool(b),
    decode: |j: Json| match j { Bool(b) -> Ok(b), _ -> Err(expected("a boolean", j)) },
  }

/// `()` as `null`.
pub fn unit_json() -> JsonCodec<Unit> =
  {
    encode: |u: Unit| Null,
    decode: |j: Json| match j { Null -> Ok(()), _ -> Err(expected("null", j)) },
  }

/// A string.
pub fn string_json() -> JsonCodec<String> =
  {
    encode: |s: String| Str(s),
    decode: |j: Json| match j { Str(s) -> Ok(s), _ -> Err(expected("a string", j)) },
  }

/// A number, exactly.
pub fn decimal_json() -> JsonCodec<Decimal> =
  {
    encode: |d: Decimal| Number(d),
    decode: |j: Json| match j { Number(d) -> Ok(d), _ -> Err(expected("a number", j)) },
  }

/// `int_of_decimal` truncates, so the round trip through `decimal_of_int` is what refuses `1.5`.
pub fn int_json() -> JsonCodec<Int> =
  {
    encode: |n: Int| Number(decimal_of_int(n)),
    decode: |j: Json| match j { Number(d) -> int_of(d), _ -> Err(expected("a number", j)) },
  }

fn int_of(d: Decimal) -> Result<Int, DecodeError> =
  match int_of_decimal(d, Down) {
    None -> Err(decode_error("`" ++ decimal_to_string(d) ++ "` is outside `Int`'s range")),
    Some(n) -> if decimal_of_int(n) == d { Ok(n) }
    else { Err(decode_error("expected a whole number, found `" ++ decimal_to_string(d) ++ "`")) },
  }

/// A string of exactly one character.
pub fn char_json() -> JsonCodec<Char> =
  {
    encode: |c: Char| Str(string_of_chars([c])),
    decode: |j: Json|
      match j {
        Str(s) -> match string_chars(s) {
          [c] -> Ok(c),
          _ -> Err(expected("a string of one character", j)),
        },
        _ -> Err(expected("a string of one character", j)),
      },
  }

/// An `Instant` and a `Duration` are their nanoseconds.
pub fn instant_json() -> JsonCodec<Instant> =
  {
    encode: |t: Instant| match t { Instant(n) -> int_json().encode(n) },
    decode: |j: Json| decode_map(int_json().decode(j), |n: Int| Instant(n)),
  }

/// A number of nanoseconds.
pub fn duration_json() -> JsonCodec<Duration> =
  {
    encode: |t: Duration| match t { Duration(n) -> int_json().encode(n) },
    decode: |j: Json| decode_map(int_json().decode(j), |n: Int| Duration(n)),
  }

/// JSON has no non-finite literals, so there is nothing to write for a NaN or an infinity.
pub fn float_json() -> JsonCodec<Float> =
  {
    encode: |f: Float|
      match decimal_of_float(f) {
        Some(d) -> Number(d),
        None -> panic("a Float that is " ++ float_reason(f) ++ " has no JSON encoding"),
      },
    decode: |j: Json|
      match j { Number(d) -> Ok(float_of_decimal(d)), _ -> Err(expected("a number", j)) },
  }

fn float_reason(f: Float) -> String =
  if f != f { "NaN" }
  else if f * 2.0 == f && f != 0.0 { if f > 0.0 { "Infinity" } else { "-Infinity" } }
  else { "outside `Decimal`'s range" }

// --- Structural codecs ------------------------------------------------------

/// An array of items.
pub fn list_json<a>(item: JsonCodec<a>) -> JsonCodec<List<a>> =
  {
    encode: |xs: List<a>| Array(map(xs, |x: a| (item.encode)(x))),
    decode: |j: Json|
      match j { Array(items) -> collect(items, item, 0, []), _ -> Err(expected("an array", j)) },
  }

/// A JSON array, read back as an array of the length the document gives it.
pub fn array_json<a>(item: JsonCodec<a>) -> JsonCodec<Array<a>> = {
  let items = list_json(item);
  {
    encode: |xs: Array<a>| (items.encode)(array_to_list(xs)),
    decode: |j: Json| match (items.decode)(j) { Ok(xs) -> Ok(array_of_list(xs)), Err(e) -> Err(e) },
  }
}

fn collect<a>(
  items: List<Json>,
  item: JsonCodec<a>,
  index: Int,
  acc: List<a>,
) -> Result<List<a>, DecodeError> / {abort.raise} =
  match items {
    [] -> Ok(acc),
    [x, ..rest] -> match (item.decode)(x) {
      Err(e) -> Err(in_index(index, e)),
      Ok(v) -> collect(rest, item, index + 1, push(acc, v)),
    },
  }

/// `None` is `null` and `Some(x)` is `x`.
pub fn option_json<a>(item: JsonCodec<a>) -> JsonCodec<Option<a>> =
  {
    encode: |o: Option<a>| match o { None -> Null, Some(x) -> (item.encode)(x) },
    decode: |j: Json|
      match j { Null -> Ok(None), _ -> decode_map((item.decode)(j), |x: a| Some(x)) },
  }

/// A variant tagged `Ok` or `Err`, as a derived codec writes a sum type.
pub fn result_json<a, b>(ok: JsonCodec<a>, err: JsonCodec<b>) -> JsonCodec<Result<a, b>> =
  {
    encode: |r: Result<a, b>|
      match r {
        Ok(x) -> variant("Ok", [(ok.encode)(x)]),
        Err(e) -> variant("Err", [(err.encode)(e)]),
      },
    decode: |j: Json| decode_and_then(variant_of(j), |t: Tagged| result_of(t, ok, err)),
  }

fn result_of<a, b>(
  t: Tagged,
  ok: JsonCodec<a>,
  err: JsonCodec<b>,
) -> Result<Result<a, b>, DecodeError> / {abort.raise} =
  if t.tag == "Ok" {
    decode_and_then(variant_value(t, 0), |v: Json| decode_map((ok.decode)(v), |x: a| Ok(x)))
  } else if t.tag == "Err" {
    decode_and_then(variant_value(t, 0), |v: Json| decode_map((err.decode)(v), |x: b| Err(x)))
  } else { unknown_variant(t.tag, ["Ok", "Err"]) }

/// A map keyed by `String` is a JSON object.
pub fn string_map_json<v>(value: JsonCodec<v>) -> JsonCodec<Map<String, v>> =
  {
    encode: |m: Map<String, v>|
      Object(
        map_of_entries(
          map(map_entries(m), |e: { key: String, value: v }|
            { key: e.key, value: (value.encode)(e.value) }),
        ),
      ),
    decode: |j: Json|
      match j {
        Object(m) -> collect_members(map_entries(m), value, map_new()),
        _ -> Err(expected("an object", j)),
      },
  }

fn collect_members<v>(
  entries: List<Member>,
  value: JsonCodec<v>,
  acc: Map<String, v>,
) -> Result<Map<String, v>, DecodeError> / {abort.raise} =
  match entries {
    [] -> Ok(acc),
    [e, ..rest] -> match (value.decode)(e.value) {
      Err(err) -> Err(in_field(e.key, err)),
      Ok(v) -> collect_members(rest, value, map_insert(acc, e.key, v)),
    },
  }

/// Other keys have no object form: an array of `{"key", "value"}` objects in ascending key order.
pub fn map_json<k, v>(key: JsonCodec<k>, value: JsonCodec<v>) -> JsonCodec<Map<k, v>>
  where derivable(ord, k)
=
  {
    encode: |m: Map<k, v>|
      Array(
        map(map_entries(m), |e: { key: k, value: v }|
          object([
            { key: "key", value: (key.encode)(e.key) },
            { key: "value", value: (value.encode)(e.value) },
          ])),
      ),
    decode: |j: Json|
      match j {
        Array(items) -> collect_pairs(items, key, value, 0, map_new()),
        _ -> Err(expected("an array of `{key, value}` objects", j)),
      },
  }

fn collect_pairs<k, v>(
  items: List<Json>,
  key: JsonCodec<k>,
  value: JsonCodec<v>,
  index: Int,
  acc: Map<k, v>,
) -> Result<Map<k, v>, DecodeError> / {abort.raise}
  where derivable(ord, k)
=
  match items {
    [] -> Ok(acc),
    [x, ..rest] -> match pair_of(x, key, value) {
      Err(e) -> Err(in_index(index, e)),
      Ok(p) -> collect_pairs(rest, key, value, index + 1, map_insert(acc, p.key, p.value)),
    },
  }

fn pair_of<k, v>(
  x: Json,
  key: JsonCodec<k>,
  value: JsonCodec<v>,
) -> Result<{ key: k, value: v }, DecodeError> / {abort.raise} =
  decode_and_then(field(x, "key", key), |k2: k|
    decode_map(field(x, "value", value), |v2: v| { key: k2, value: v2 }))

// --- Bytes ------------------------------------------------------------------

/// JSON has no byte string, so `Bytes` is padded base64 (RFC 4648).
pub fn bytes_json() -> JsonCodec<Bytes> =
  {
    encode: |b: Bytes| Str(base64_encode(b)),
    decode: |j: Json|
      match j { Str(s) -> base64_decode(s), _ -> Err(expected("a base64 string", j)) },
  }

fn b64_alphabet() -> Bytes = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

fn b64_symbol(v: Int) -> Bytes / {abort.raise} = bytes_slice(b64_alphabet(), v, v + 1)

/// Padded base64 (RFC 4648), as `bytes_json` writes `Bytes`.
pub fn base64_encode(raw: Bytes) -> String / {abort.raise} =
  string_of_bytes(
    bytes_concat_all(map(range(0, (bytes_len(raw) + 2) / 3), |g: Int| b64_group(raw, g * 3))),
  )

fn b64_group(raw: Bytes, i: Int) -> Bytes / {abort.raise} = {
  let n = bytes_len(raw);
  let a = bytes_at(raw, i);
  if i + 3 <= n { b64_three(a, bytes_at(raw, i + 1), bytes_at(raw, i + 2)) }
  else if i + 2 == n { b64_two(a, bytes_at(raw, i + 1)) }
  else { b64_one(a) }
}

fn b64_three(a: Int, b: Int, c: Int) -> Bytes / {abort.raise} =
  bytes_concat(
    bytes_concat(b64_symbol(a / 4), b64_symbol(a % 4 * 16 + b / 16)),
    bytes_concat(b64_symbol(b % 16 * 4 + c / 64), b64_symbol(c % 64)),
  )

fn b64_two(a: Int, b: Int) -> Bytes / {abort.raise} =
  bytes_concat(
    bytes_concat(b64_symbol(a / 4), b64_symbol(a % 4 * 16 + b / 16)),
    bytes_concat(b64_symbol(b % 16 * 4), b"="),
  )

fn b64_one(a: Int) -> Bytes / {abort.raise} =
  bytes_concat(bytes_concat(b64_symbol(a / 4), b64_symbol(a % 4 * 16)), b"==")

/// Padded base64 read back; a length not a multiple of four or a symbol outside the alphabet is an
/// error.
pub fn base64_decode(text: String) -> Result<Bytes, DecodeError> / {abort.raise} = {
  let raw = bytes_of_string(text);
  if bytes_len(raw) % 4 != 0 {
    Err(decode_error("a base64 string's length must be a multiple of 4"))
  } else { decode_map(b64_groups(raw, 0, []), |pieces: List<Bytes>| bytes_concat_all(pieces)) }
}

fn b64_groups(
  raw: Bytes,
  i: Int,
  acc: List<Bytes>,
) -> Result<List<Bytes>, DecodeError> / {abort.raise} =
  if i >= bytes_len(raw) { Ok(acc) } else {
    let chunk = b64_decode_group(raw, i)?;
    b64_groups(raw, i + 4, push(acc, chunk))
  }

fn b64_decode_group(raw: Bytes, i: Int) -> Result<Bytes, DecodeError> / {abort.raise} = {
  let a = b64_value(bytes_at(raw, i));
  let b = b64_value(bytes_at(raw, i + 1));
  let third = bytes_at(raw, i + 2);
  let fourth = bytes_at(raw, i + 3);
  if a < 0 || b < 0 { Err(decode_error("this is not base64")) } else if third == 61 {
    if fourth == 61 { Ok(byte_of_int(a * 4 + b / 16)) }
    else { Err(decode_error("base64 padding may only be at the end")) }
  } else { b64_tail(a, b, b64_value(third), fourth) }
}

fn b64_tail(a: Int, b: Int, c: Int, fourth: Int) -> Result<Bytes, DecodeError> / {abort.raise} =
  if c < 0 { Err(decode_error("this is not base64")) } else if fourth == 61 {
    Ok(bytes_concat(byte_of_int(a * 4 + b / 16), byte_of_int(b % 16 * 16 + c / 4)))
  } else { b64_full(a, b, c, b64_value(fourth)) }

fn b64_full(a: Int, b: Int, c: Int, d: Int) -> Result<Bytes, DecodeError> / {abort.raise} =
  if d < 0 { Err(decode_error("this is not base64")) } else {
    Ok(
      bytes_concat(
        byte_of_int(a * 4 + b / 16),
        bytes_concat(byte_of_int(b % 16 * 16 + c / 4), byte_of_int(c % 4 * 64 + d)),
      ),
    )
  }

fn b64_value(c: Int) -> Int / {abort.raise} =
  match bytes_index_of_byte(b64_alphabet(), c) { Some(v) -> v, None -> -1 }

// --- The two ends together --------------------------------------------------

/// Parses a document and decodes it with `codec`.
pub fn decode_bytes<a>(src: Bytes, codec: JsonCodec<a>) -> Result<a, DecodeError> / {abort.raise} =
  decode_and_then(parse(src), |j: Json| (codec.decode)(j))

/// `decode_bytes` over a string's bytes.
pub fn decode_string<a>(
  src: String,
  codec: JsonCodec<a>,
) -> Result<a, DecodeError> / {abort.raise} = decode_bytes(bytes_of_string(src), codec)

/// `x` written with `codec`, as bytes.
pub fn encode_bytes<a>(x: a, codec: JsonCodec<a>) -> Bytes / {abort.raise} =
  to_bytes((codec.encode)(x))

/// `x` written with `codec`, as a string.
pub fn encode_string<a>(x: a, codec: JsonCodec<a>) -> String / {abort.raise} =
  to_string((codec.encode)(x))

// --- JSON Lines -------------------------------------------------------------

/// Where a JSON Lines input stopped being one: the line, counted from one, and the error on it,
/// whose `offset` is a byte of that line.
pub type LineError = new { line: Int, error: DecodeError }

/// `line 3: $: expected a value (at byte 0)`.
pub fn line_error_to_string(e: LineError) -> String =
  "line " ++ int_to_string(e.line) ++ ": " ++ error_to_string(e.error)

/// A JSON Lines reader between two chunks of its input: its limits, the line it is on, counted
/// from one, and the bytes of that line it has been handed so far.
pub type LineReader = new { max_line: Int, max_depth: Int, line: Int, partial: Bytes }

/// What a chunk completed: the values of the lines that ended in it, in order, and the reader to
/// hand the next chunk.
pub type LineStep = new { reader: LineReader, values: List<Json> }

/// A reader at the start of an input. It refuses a line of more than `max_line` bytes, as soon as
/// it has been handed that many with no line feed, and a value nested more than `max_depth` deep,
/// or deeper than `parse` reads where that is less.
pub fn lines_start(max_line: Int, max_depth: Int) -> LineReader =
  { max_line: max_line, max_depth: max_depth, line: 1, partial: b"" }

/// The reader handed the next `chunk` of its input, cut anywhere.
///
/// A line is the bytes up to a line feed, and holds one value as `parse` reads it, so a carriage
/// return before the line feed is whitespace. A line of whitespace alone holds no value and is
/// passed over, though it counts as a line; a byte order mark is refused, as `parse` refuses it.
pub fn lines_step(reader: LineReader, chunk: Bytes) -> Result<LineStep, LineError> / {abort.raise} = {
  let pieces = bytes_split(chunk, b"\n");
  let ended = len(pieces) - 1;
  let start: Result<LineStep, LineError> = Ok({ reader: reader, values: [] });
  let step = fold(take(pieces, ended), start, line_ended)?;
  let rest = carried(step.reader, at_or(pieces, ended, b""))?;
  Ok({ reader: rest, values: step.values })
}

/// The value of the line the input ended on with no line feed, where it holds one.
pub fn lines_end(reader: LineReader) -> Result<Option<Json>, LineError> / {abort.raise} =
  line_value(reader)

/// Every value of a JSON Lines text, in order, under the limits and rules of `lines_start` and
/// `lines_step`: the whole input as one chunk. A last line needs no line feed.
pub fn parse_lines(
  src: Bytes,
  max_line: Int,
  max_depth: Int,
) -> Result<List<Json>, LineError> / {abort.raise} = {
  let step = lines_step(lines_start(max_line, max_depth), src)?;
  let last = lines_end(step.reader)?;
  Ok(match last { Some(j) -> push(step.values, j), None -> step.values })
}

/// Each value as `to_bytes` writes it, which holds no line feed, and a line feed after each one.
pub fn lines_to_bytes(values: List<Json>) -> Bytes / {abort.raise} =
  bytes_concat_all(map(values, |j: Json| bytes_concat(to_bytes(j), b"\n")))

fn line_ended(
  acc: Result<LineStep, LineError>,
  piece: Bytes,
) -> Result<LineStep, LineError> / {abort.raise} = {
  let step = acc?;
  let whole = carried(step.reader, piece)?;
  let read = line_value(whole)?;
  Ok({
    reader: { ..whole, line: whole.line + 1, partial: b"" },
    values: match read { Some(j) -> push(step.values, j), None -> step.values },
  })
}

/// The reader with `piece` added to its line, refused where that outgrows `max_line`.
fn carried(r: LineReader, piece: Bytes) -> Result<LineReader, LineError> =
  if bytes_len(r.partial) + bytes_len(piece) > r.max_line {
    Err({
      line: r.line,
      error: error_at(
        max(r.max_line, 0),
        "a line is longer than the " ++ int_to_string(r.max_line) ++ " bytes this reader takes",
      ),
    })
  } else { Ok({ ..r, partial: bytes_concat(r.partial, piece) }) }

/// What the reader's line holds, read as a whole line.
fn line_value(r: LineReader) -> Result<Option<Json>, LineError> / {abort.raise} =
  if skip_ws(r.partial, 0) == bytes_len(r.partial) { Ok(None) } else {
    match parse_within(r.partial, r.max_depth) {
      Ok(j) -> Ok(Some(j)),
      Err(e) -> Err({ line: r.line, error: e }),
    }
  }

// --- Pointers ---------------------------------------------------------------

/// A JSON Pointer (RFC 6901): the reference tokens that lead from a document to one value in it,
/// each as it reads once `~1` and `~0` are unescaped. No tokens is the document itself.
pub type Pointer = | Pointer(List<String>)

show for Pointer by pointer_text

/// A pointer as RFC 6901 writes it: each token after a `/`, its `~` as `~0` and its `/` as `~1`.
pub fn pointer_text(p: Pointer) -> String =
  match p {
    Pointer(tokens) ->
      fold(tokens, "", |text: String, token: String| text ++ "/" ++ escaped_token(token)),
  }

fn escaped_token(token: String) -> String =
  fold(string_chars(token), "", |text: String, c: Char|
    text ++ (if c == '~' { "~0" } else if c == '/' { "~1" } else { string_of_chars([c]) }))

/// The pointer `text` writes; `None` for a text that is neither empty nor led by `/`, and for one
/// holding a `~` that neither `0` nor `1` follows.
pub fn pointer_of(text: String) -> Option<Pointer> / {abort.raise} =
  match string_split(text, "/") {
    [""] -> Some(Pointer([])),
    ["", ..written] -> match tokens_of(written) {
      Some(tokens) -> Some(Pointer(tokens)),
      None -> None,
    },
    _ -> None,
  }

fn tokens_of(written: List<String>) -> Option<List<String>> / {abort.raise} =
  fold(written, Some([]), token_read)

fn token_read(acc: Option<List<String>>, written: String) -> Option<List<String>> / {abort.raise} = {
  let tokens = acc?;
  let token = unescaped_token(written)?;
  Some(push(tokens, token))
}

/// `~01` is `~1`, not `/`: each `~` is read once, with the character after it.
fn unescaped_token(written: String) -> Option<String> / {abort.raise} =
  match string_split(written, "~") {
    [] -> Some(written),
    [first, ..rest] ->
      fold(rest, Some(first), |acc: Option<String>, piece: String|
        match acc {
          None -> None,
          Some(text) -> if string_starts_with(piece, "0") {
            Some(text ++ "~" ++ string_slice(piece, 1, string_len(piece)))
          } else if string_starts_with(piece, "1") {
            Some(text ++ "/" ++ string_slice(piece, 1, string_len(piece)))
          } else { None },
        }),
  }

/// The value `p` leads to in `j`, each token naming a member of an object or an element of an
/// array. `None` where it leads nowhere: a member the object lacks, an index at or past the
/// array's end, an index not written as RFC 6901 writes one (digits, with no leading zero), `-`,
/// which names the element after the last, or a token left over at a value that is neither.
pub fn resolve(j: Json, p: Pointer) -> Option<Json> / {abort.raise} =
  match p {
    Pointer(tokens) ->
      fold(tokens, Some(j), |at: Option<Json>, token: String|
        match at {
          Some(Object(m)) -> map_get(m, token),
          Some(Array(items)) -> element(items, token),
          _ -> None,
        }),
  }

fn element(items: List<Json>, token: String) -> Option<Json> / {abort.raise} = {
  let index = bytes_of_string(token);
  let n = bytes_len(index);
  if n == 0 || scan(index, 0, digits()) < n || (n > 1 && bytes_at(index, 0) == 48) { None }
  else { match int_of_ascii(index) { Some(i) -> list_at(items, i), None -> None } }
}

// --- Laws -------------------------------------------------------------------

law "parsing what was rendered gives back the value"
  forall (j: Json) {
    parse(to_bytes(j)) == Ok(j)
  }

law "a string survives being escaped and unescaped"
  forall (s: String) {
    parse(to_bytes(Str(s))) == Ok(Str(s))
  }

// `==` on a `Decimal` is numeric, so this checks the value and not the scale.
law "a number survives being rendered and read back"
  forall (d: Decimal) {
    parse(to_bytes(Number(d))) == Ok(Number(d))
  }

law "a codec's decode undoes its encode"
  forall (xs: List<Int>) {
    decode_bytes(encode_bytes(xs, list_json(int_json())), list_json(int_json())) == Ok(xs)
  }

law "an optional field round-trips through null"
  forall (o: Option<String>) {
    decode_bytes(encode_bytes(o, option_json(string_json())), option_json(string_json())) == Ok(o)
  }

law "base64 round-trips" forall (b: Bytes) { base64_decode(base64_encode(b)) == Ok(b) }

law "pretty text parses back to the value"
  forall (j: Json, indent: Int) {
    parse(pretty_bytes(j, indent % 8)) == Ok(j)
  }

law "pretty text is the compact text once the whitespace outside its strings is gone"
  forall (j: Json, indent: Int) {
    squeezed(pretty_bytes(j, indent % 8)) == to_bytes(j)
  }

law "a value is written on one line" forall (j: Json) { !bytes::contains(to_bytes(j), b"\n") }

law "JSON Lines read back what was written" =
  agrees(|js: List<Json>| parse_lines(lines_to_bytes(js), roomy(), max_depth()), |js: List<Json>|
    Ok(js))

law "a reader answers alike wherever its input is cut"
  forall (js: List<Json>, cut: Int) {
    fed(cut_in_two(lines_to_bytes(js), cut), roomy(), max_depth())
      == parse_lines(lines_to_bytes(js), roomy(), max_depth())
  }

law "a pointer's text reads back as the pointer" = round_trip(pointer_text, pointer_of)

type Squeeze = { out: Bytes, inside: Bool, escaped: Bool }

/// `text` without the whitespace outside its strings.
fn squeezed(text: Bytes) -> Bytes / {abort.raise} =
  fold(
    range(0, bytes_len(text)),
    { out: b"", inside: false, escaped: false },
    |s: Squeeze, i: Int| {
      let c = bytes_at(text, i);
      let kept = bytes_concat(s.out, byte_of_int(c));
      if s.inside { { out: kept, inside: s.escaped || c != 34, escaped: !s.escaped && c == 92 } }
      else if bytes::contains(ws(), byte_of_int(c)) { s }
      else { { out: kept, inside: c == 34, escaped: false } }
    },
  ).out

/// A line length no test's line reaches.
fn roomy() -> Int = 1_000_000

/// `text` as two chunks, cut at a byte `cut` picks.
fn cut_in_two(text: Bytes, cut: Int) -> List<Bytes> / {abort.raise} = {
  let n = bytes_len(text);
  let at = if n == 0 { 0 } else { (cut % n + n) % n };
  [bytes_slice(text, 0, at), bytes_slice(text, at, n)]
}

/// What a reader answers for an input handed to it as these chunks.
fn fed(
  chunks: List<Bytes>,
  max_line: Int,
  max_depth: Int,
) -> Result<List<Json>, LineError> / {abort.raise} = {
  let start: Result<LineStep, LineError> = Ok({
    reader: lines_start(max_line, max_depth),
    values: [],
  });
  let step = fold(chunks, start, fed_chunk)?;
  let last = lines_end(step.reader)?;
  Ok(match last { Some(j) -> push(step.values, j), None -> step.values })
}

fn fed_chunk(
  acc: Result<LineStep, LineError>,
  chunk: Bytes,
) -> Result<LineStep, LineError> / {abort.raise} = {
  let so_far = acc?;
  let next = lines_step(so_far.reader, chunk)?;
  Ok({ reader: next.reader, values: concat(so_far.values, next.values) })
}

// --- Tests: values ----------------------------------------------------------

fn parsed(src: Bytes) -> Json / {abort.raise} =
  match parse(src) { Ok(j) -> j, Err(e) -> panic("expected a parse: " ++ error_to_string(e)) }

fn failure(src: Bytes) -> DecodeError / {abort.raise} =
  match parse(src) { Ok(j) -> panic("expected a failure, parsed " ++ to_string(j)), Err(e) -> e }

fn offset_of(src: Bytes) -> Int / {abort.raise} =
  match failure(src).offset { Some(n) -> n, None -> -1 }

test "a missing number or list of strings is null, and an empty list is not" {
  assert_eq(int_or_null(Some(3)), int(3));
  assert_eq(int_or_null(None), Null);
  assert_eq(strings_or_null(Some([])), Array([]));
  assert_eq(strings_or_null(None), Null)
}

test "every kind of value parses" {
  assert_eq(parse(b"null"), Ok(Null));
  assert_eq(parse(b"true"), Ok(Bool(true)));
  assert_eq(parse(b"false"), Ok(Bool(false)));
  assert_eq(parse(b"42"), Ok(int(42)));
  assert_eq(parse(b"\"hi\""), Ok(Str("hi")));
  assert_eq(parse(b"[]"), Ok(Array([])));
  assert_eq(parse(b"{}"), Ok(Object(map_new())))
}

test "whitespace is allowed everywhere between tokens and nowhere inside one" {
  assert_eq(parse(b" \t\r\n [ 1 , 2 ] \n"), Ok(Array([int(1), int(2)])));
  assert_eq(parse(b"{ \"a\" : 1 }"), Ok(Object(map_insert(map_new(), "a", int(1)))));
  assert_eq(failure(b"tr ue").message, "expected `true`")
}

test "a nested document parses to the value it describes" {
  assert_eq(
    parse(b"{\"a\":[1,{\"b\":null}],\"c\":true}"),
    Ok(
      Object(
        map_insert(
          map_insert(map_new(), "a", Array([int(1), Object(map_insert(map_new(), "b", Null))])),
          "c",
          Bool(true),
        ),
      ),
    ),
  )
}

test "an object is a map, so key order is the map's and not the document's" {
  assert_eq(parsed(b"{\"b\":1,\"a\":2}"), parsed(b"{\"a\":2,\"b\":1}"));
  assert_eq(to_bytes(parsed(b"{\"b\":1,\"a\":2}")), b"{\"a\":2,\"b\":1}")
}

test "a repeated key keeps the last value" {
  assert_eq(parsed(b"{\"a\":1,\"a\":2}"), Object(map_insert(map_new(), "a", int(2))));
  assert_eq(map_len(match parsed(b"{\"a\":1,\"a\":2}") { Object(m) -> m, _ -> map_new() }), 1)
}

// --- Tests: strings and escapes ---------------------------------------------

/// A Ply string literal has no `\x`, so these two are written as bytes.
fn backspace() -> String / {abort.raise} = string_of_bytes(b"\x08")

fn form_feed() -> String / {abort.raise} = string_of_bytes(b"\x0c")

test "every escape form decodes" {
  assert_eq(parse(b"\"\\\"\""), Ok(Str("\"")));
  assert_eq(parse(b"\"\\\\\""), Ok(Str("\\")));
  assert_eq(parse(b"\"\\/\""), Ok(Str("/")));
  assert_eq(parse(b"\"\\b\""), Ok(Str(backspace())));
  assert_eq(parse(b"\"\\f\""), Ok(Str(form_feed())));
  assert_eq(parse(b"\"\\n\""), Ok(Str("\n")));
  assert_eq(parse(b"\"\\r\""), Ok(Str("\r")));
  assert_eq(parse(b"\"\\t\""), Ok(Str("\t")));
  assert_eq(parse(b"\"\\u0041\""), Ok(Str("A")))
}

test "a \\u escape covers all four UTF-8 lengths" {
  assert_eq(parse(b"\"\\u0000\""), Ok(Str("\0")));
  assert_eq(parse(b"\"\\u00e9\""), Ok(Str("é")));
  assert_eq(parse(b"\"\\u20ac\""), Ok(Str("€")));
  assert_eq(parse(b"\"\\ud83d\\ude00\""), Ok(Str("😀")));
  assert_eq(bytes_len(bytes_of_string("😀")), 4)
}

test "a surrogate that is not part of a pair is refused" {
  assert_eq(
    failure(b"\"\\ud83d\"").message,
    "a high surrogate must be followed by a \\u low surrogate",
  );
  assert_eq(
    failure(b"\"\\ud83dx\"").message,
    "a high surrogate must be followed by a \\u low surrogate",
  );
  assert_eq(
    failure(b"\"\\ud83d\\u0041\"").message,
    "a high surrogate must be followed by a low surrogate, which is \\udc00 to \\udfff",
  );
  assert_eq(
    failure(b"\"\\ude00\"").message,
    "a low surrogate must follow a high surrogate, which is \\ud800 to \\udbff",
  )
}

test "a malformed escape names itself and its position" {
  assert_eq(
    failure(b"\"\\q\"").message,
    "the escapes are \\\" \\\\ \\/ \\b \\f \\n \\r \\t and \\uXXXX",
  );
  assert_eq(offset_of(b"\"a\\q\""), 2);
  assert_eq(failure(b"\"\\u00g0\"").message, "a \\u escape needs exactly four hexadecimal digits");
  assert_eq(failure(b"\"\\u00\"").message, "a \\u escape needs exactly four hexadecimal digits")
}

test "an unescaped control character is refused and an escaped one is not" {
  assert_eq(
    failure(b"\"a\nb\"").message,
    "a control character must be written as an escape inside a string",
  );
  assert_eq(offset_of(b"\"a\nb\""), 2);
  assert_eq(parse(b"\"a\\nb\""), Ok(Str("a\nb")))
}

test "a string that is never closed is refused rather than truncated" {
  assert_eq(failure(b"\"abc").message, "this string is never closed");
  assert_eq(failure(b"\"abc\\\"").message, "this string is never closed");
  assert_eq(failure(b"\"").message, "this string is never closed")
}

test "a document that is not UTF-8 is refused whole" {
  assert_eq(failure(b"\"\xff\"").message, "a JSON document must be valid UTF-8")
}

test "escaping is the inverse of parsing, including the characters JSON does not require escaped" {
  assert_eq(to_bytes(Str("a\"b\\c")), b"\"a\\\"b\\\\c\"");
  assert_eq(to_bytes(Str("\n\t\r" ++ backspace() ++ form_feed())), b"\"\\n\\t\\r\\b\\f\"");
  assert_eq(to_bytes(Str(string_of_bytes(b"\x00\x1f"))), b"\"\\u0000\\u001f\"");
  // A solidus and non-ASCII characters are legal unescaped.
  assert_eq(
    to_bytes(Str("/é😀")),
    bytes_concat(b"\"", bytes_concat(bytes_of_string("/é😀"), b"\"")),
  )
}

test "runs and the escapes that end them survive the accumulator, byte for byte" {
  assert_eq(to_bytes(Str("\"ab\\cd\"")), b"\"\\\"ab\\\\cd\\\"\"");
  // Adjacent escapes: the empty run between them must contribute nothing.
  assert_eq(to_bytes(Str("\"\"\"")), b"\"\\\"\\\"\\\"\"");
  assert_eq(to_bytes(Str("\"tail")), b"\"\\\"tail\"");
  // Long enough to be the accumulator rather than the base case.
  let many = fold(range(0, 200), "", |a: String, _: Int| a ++ "ab\"");
  assert_eq(bytes_len(to_bytes(Str(many))), 2 + 200 * 4)
}

// --- Tests: numbers ---------------------------------------------------------

test "the number grammar is JSON's and not a decimal parser's" {
  assert_eq(parse(b"0"), Ok(int(0)));
  assert_eq(parse(b"-0"), Ok(int(0)));
  assert_eq(parse(b"-12"), Ok(int(-12)));
  assert_eq(parse(b"1e3"), Ok(int(1000)));
  assert_eq(parse(b"1E3"), Ok(int(1000)));
  assert_eq(parse(b"1e+3"), Ok(int(1000)));
  assert_eq(parse(b"1000e-3"), Ok(int(1)));
  assert_eq(parse(b"1.5"), Ok(Number(1.5m)));
  assert_eq(parse(b"-0.001"), Ok(Number(-0.001m)))
}

test "a number that JSON does not admit is refused with a position" {
  assert_eq(failure(b"01").message, "a number may not have a leading zero");
  assert_eq(failure(b"-").message, "a number needs at least one digit");
  assert_eq(failure(b"1.").message, "a fraction needs at least one digit after the `.`");
  assert_eq(
    failure(b".5").message,
    "expected a value: `{`, `[`, `\"`, a number, `true`, `false` or `null`",
  );
  assert_eq(failure(b"1e").message, "an exponent needs at least one digit");
  assert_eq(failure(b"1e+").message, "an exponent needs at least one digit");
  assert_eq(
    failure(b"+1").message,
    "expected a value: `{`, `[`, `\"`, a number, `true`, `false` or `null`",
  )
}

test "a number outside Decimal's range is a decode error naming the byte offset" {
  assert_eq(offset_of(b"[1,1e400]"), 3);
  assert_eq(offset_of(b"[1,12345678901234567890123456789012345678901234]"), 3);
  assert(string_contains(failure(b"[1,1e400]").message, "outside `Decimal`'s range"))
}

test "a number keeps the scale it was written with" {
  assert_eq(parse(b"1.50"), Ok(Number(1.50m)));
  assert_eq(to_bytes(Number(1.50m)), b"1.50");
  assert_eq(to_bytes(Number(1.5m)), b"1.5")
}

// --- Tests: structure -------------------------------------------------------

test "trailing data after a complete value is refused" {
  assert_eq(
    failure(b"1 2").message,
    "the document ended here; nothing may follow the top-level value",
  );
  assert_eq(offset_of(b"1 2"), 2);
  assert_eq(offset_of(b"{} {}"), 3);
  assert_eq(offset_of(b"[1,2]x"), 5);
  // Trailing whitespace is not trailing data.
  assert_eq(parse(b"1 \r\n"), Ok(int(1)))
}

test "a truncated document is a diagnostic and not a panic" {
  assert_eq(failure(b"").message, "the input ended where a value was expected");
  assert_eq(failure(b"[1,").message, "the input ended where a value was expected");
  assert_eq(failure(b"[1").message, "expected `,` or `]` in an array");
  assert_eq(failure(b"{\"a\"").message, "expected `:` after an object key");
  assert_eq(failure(b"{\"a\":").message, "the input ended where a value was expected");
  assert_eq(failure(b"{\"a\":1").message, "expected `,` or `}` in an object");
  assert_eq(failure(b"nul").message, "the input ended inside `null`")
}

test "the shapes a lenient parser would accept are refused" {
  assert_eq(
    failure(b"[1,]").message,
    "expected a value: `{`, `[`, `\"`, a number, `true`, `false` or `null`",
  );
  assert_eq(failure(b"{\"a\":1,}").message, "an object key must be a quoted string");
  assert_eq(failure(b"{a:1}").message, "an object key must be a quoted string");
  assert_eq(failure(b"[1 2]").message, "expected `,` or `]` in an array")
}

// --- Tests: depth -----------------------------------------------------------

fn nest(open: Bytes, close: Bytes, depth: Int) -> Bytes =
  fold(range(0, depth), b"1", |acc: Bytes, i: Int| bytes_concat(open, bytes_concat(acc, close)))

test "nesting is bounded, and the bound is a diagnostic rather than a stack overflow" {
  assert(match parse(nest(b"[", b"]", max_depth())) { Ok(_) -> true, Err(_) -> false });
  assert(string_contains(failure(nest(b"[", b"]", max_depth() + 1)).message, "nested deeper than"));
  assert(
    string_contains(failure(nest(b"{\"a\":", b"}", max_depth() + 1)).message, "nested deeper than"),
  );
  // The bound is checked on the way in, so an unclosed run stops at the limit.
  assert(string_contains(failure(nest(b"[", b"", 500)).message, "nested deeper than"))
}

// --- Tests: codecs ----------------------------------------------------------

fn round_trip_int(n: Int) -> Result<Int, DecodeError> / {abort.raise} =
  decode_bytes(encode_bytes(n, int_json()), int_json())

test "the leaf codecs round-trip" {
  assert_eq(round_trip_int(0), Ok(0));
  assert_eq(round_trip_int(-9007199254740993), Ok(-9007199254740993));
  assert_eq(decode_bytes(encode_bytes(true, bool_json()), bool_json()), Ok(true));
  assert_eq(decode_bytes(encode_bytes("hi\n", string_json()), string_json()), Ok("hi\n"));
  assert_eq(decode_bytes(encode_bytes(1.50m, decimal_json()), decimal_json()), Ok(1.50m));
  assert_eq(decode_bytes(encode_bytes((), unit_json()), unit_json()), Ok(()))
}

test "a character is a string of one, and time is its nanoseconds" {
  assert_eq(encode_bytes('\u{e9}', char_json()), b"\"\xc3\xa9\"");
  assert_eq(decode_bytes(encode_bytes('\u{1F600}', char_json()), char_json()), Ok('\u{1F600}'));
  assert_eq(
    char_json().decode(Str("ab")),
    Err(decode_error("expected a string of one character, found a string")),
  );
  assert(char_json().decode(Str("")) != Ok('a'));
  assert_eq(encode_bytes(Instant(1_500), instant_json()), b"1500");
  assert_eq(decode_bytes(b"-7", instant_json()), Ok(Instant(-7)));
  assert_eq(
    decode_bytes(encode_bytes(Duration(42), duration_json()), duration_json()),
    Ok(Duration(42)),
  );
  assert(duration_json().decode(Number(1.5m)) != Ok(Duration(1)))
}

test "a number with a fraction is not an Int" {
  assert_eq(
    int_json().decode(Number(1.5m)),
    Err(decode_error("expected a whole number, found `1.5`")),
  );
  assert_eq(int_json().decode(Number(1.0m)), Ok(1));
  assert_eq(
    int_json().decode(Number(100000000000000000000m)),
    Err(decode_error("`100000000000000000000` is outside `Int`'s range")),
  )
}

test "a finite Float round-trips, and a non-finite one has no encoding to make" {
  assert_eq(decode_bytes(encode_bytes(1.5, float_json()), float_json()), Ok(1.5));
  assert_eq(encode_bytes(0.0, float_json()), b"0");
  // A raise cannot be asserted here, so only `float_reason` is checked.
  assert_eq(float_reason(0.0 / 0.0), "NaN");
  assert_eq(float_reason(1.0 / 0.0), "Infinity");
  assert_eq(float_reason(-1.0 / 0.0), "-Infinity")
}

test "a codec that is handed the wrong shape says which shape it wanted" {
  assert_eq(int_json().decode(Str("1")), Err(decode_error("expected a number, found a string")));
  assert_eq(bool_json().decode(Null), Err(decode_error("expected a boolean, found null")));
  assert_eq(
    list_json(int_json()).decode(Object(map_new())),
    Err(decode_error("expected an array, found an object")),
  )
}

test "a failure inside a structure names its path" {
  assert_eq(
    error_to_string(match list_json(int_json()).decode(Array([int(1), Str("x")])) {
      Err(e) -> e,
      Ok(_) -> decode_error("unreachable"),
    }),
    "$[1]: expected a number, found a string",
  );
  assert_eq(
    error_to_string(match field(parsed(b"{\"a\":{\"b\":1}}"), "a", string_json()) {
      Err(e) -> e,
      Ok(_) -> decode_error("unreachable"),
    }),
    "$.a: expected a string, found an object",
  )
}

test "a missing field and an optional one are different answers" {
  let j = parsed(b"{\"a\":1}");
  assert_eq(
    error_to_string(match field(j, "b", int_json()) {
      Err(e) -> e,
      Ok(_) -> decode_error("unreachable"),
    }),
    "$.b: this field is missing",
  );
  assert_eq(optional_field(j, "b", int_json()), Ok(None));
  assert_eq(optional_field(j, "a", int_json()), Ok(Some(1)));
  // Absent and null are one answer, on purpose.
  assert_eq(optional_field(parsed(b"{\"a\":null}"), "a", int_json()), Ok(None))
}

test "a list codec round-trips through the wire form" {
  let xs = [1, 2, 3];
  assert_eq(encode_bytes(xs, list_json(int_json())), b"[1,2,3]");
  assert_eq(decode_bytes(b"[1,2,3]", list_json(int_json())), Ok(xs));
  assert_eq(decode_bytes(b"[]", list_json(int_json())), Ok([]))
}

test "an array is a JSON array, as a list is" {
  let xs = array_of_list([1, 2, 3]);
  assert_eq(encode_bytes(xs, array_json(int_json())), b"[1,2,3]");
  assert_eq(decode_bytes(b"[1,2,3]", array_json(int_json())), Ok(xs));
  assert_eq(decode_bytes(b"[]", array_json(int_json())), Ok(array_new(0, 0)));
  assert(decode_bytes(b"{}", array_json(int_json())) != Ok(xs))
}

test "a string-keyed map is an object and any other map is an array of pairs" {
  let m = map_insert(map_insert(map_new(), "b", 2), "a", 1);
  assert_eq(encode_bytes(m, string_map_json(int_json())), b"{\"a\":1,\"b\":2}");
  assert_eq(decode_bytes(b"{\"a\":1,\"b\":2}", string_map_json(int_json())), Ok(m));

  let byint = map_insert(map_insert(map_new(), 2, "b"), 1, "a");
  assert_eq(
    encode_bytes(byint, map_json(int_json(), string_json())),
    b"[{\"key\":1,\"value\":\"a\"},{\"key\":2,\"value\":\"b\"}]",
  );
  assert_eq(
    decode_bytes(
      b"[{\"key\":1,\"value\":\"a\"},{\"key\":2,\"value\":\"b\"}]",
      map_json(int_json(), string_json()),
    ),
    Ok(byint),
  )
}

test "a variant with no fields is a string and one with fields is a tagged object" {
  assert_eq(variant("Placed", []), Str("Placed"));
  assert_eq(to_bytes(variant("Refunded", [int(3)])), b"{\"tag\":\"Refunded\",\"values\":[3]}");
  assert_eq(variant_of(Str("Placed")), Ok({ tag: "Placed", values: [] }));
  assert_eq(
    variant_of(parsed(b"{\"tag\":\"Refunded\",\"values\":[3]}")),
    Ok({ tag: "Refunded", values: [int(3)] }),
  );
  assert_eq(
    variant_of(int(1)),
    Err(decode_error("expected a variant: a string, or an object with a `tag`, found a number")),
  )
}

test "a result codec round-trips both sides" {
  let codec = result_json(int_json(), string_json());
  assert_eq(encode_bytes(Ok(1), codec), b"{\"tag\":\"Ok\",\"values\":[1]}");
  assert_eq(decode_bytes(b"{\"tag\":\"Ok\",\"values\":[1]}", codec), Ok(Ok(1)));
  assert_eq(decode_bytes(b"{\"tag\":\"Err\",\"values\":[\"no\"]}", codec), Ok(Err("no")));
  assert(match decode_bytes(b"\"Other\"", codec) { Err(_) -> true, Ok(_) -> false })
}

test "an option is null, and null is an option" {
  assert_eq(encode_bytes(None, option_json(int_json())), b"null");
  assert_eq(encode_bytes(Some(1), option_json(int_json())), b"1");
  assert_eq(decode_bytes(b"null", option_json(int_json())), Ok(None));
  assert_eq(decode_bytes(b"1", option_json(int_json())), Ok(Some(1)))
}

test "bytes are base64, padding included" {
  assert_eq(base64_encode(b""), "");
  assert_eq(base64_encode(b"f"), "Zg==");
  assert_eq(base64_encode(b"fo"), "Zm8=");
  assert_eq(base64_encode(b"foo"), "Zm9v");
  assert_eq(base64_encode(b"foob"), "Zm9vYg==");
  assert_eq(base64_encode(b"fooba"), "Zm9vYmE=");
  assert_eq(base64_encode(b"foobar"), "Zm9vYmFy");
  assert_eq(base64_decode("Zm9vYmFy"), Ok(b"foobar"));
  assert_eq(base64_decode("Zg=="), Ok(b"f"));
  // Bytes that are not UTF-8.
  assert_eq(base64_decode(base64_encode(b"\x00\xff\xfe")), Ok(b"\x00\xff\xfe"));
  assert_eq(encode_bytes(b"\xff", bytes_json()), b"\"/w==\"")
}

test "base64 that is not base64 is a decode error" {
  assert(match base64_decode("Zg=") { Err(_) -> true, Ok(_) -> false });
  assert(match base64_decode("Z!==") { Err(_) -> true, Ok(_) -> false });
  assert(match base64_decode("Z=g=") { Err(_) -> true, Ok(_) -> false })
}

// --- Tests: a realistic payload --------------------------------------------

fn order_payload() -> Bytes =
  bytes_concat(
    b"{\"id\":\"a4f1c2\",\"customer\":{\"id\":991,\"name\":\"Ada Lovelace\",\"email\":\"ada@example.com\"},",
    bytes_concat(
      b"\"lines\":[{\"sku\":\"PLY-001\",\"qty\":2,\"price\":19.99},{\"sku\":\"PLY-002\",\"qty\":1,\"price\":4.50}],",
      b"\"total\":44.48,\"placed_at\":1723600000,\"notes\":null,\"paid\":true}",
    ),
  )

fn line_price(j: Json) -> Result<Decimal, DecodeError> / {abort.raise} =
  field(j, "price", decimal_json())

test "a realistic order payload parses, reads and re-renders" {
  let doc = parsed(order_payload());
  assert_eq(field(doc, "id", string_json()), Ok("a4f1c2"));
  assert_eq(field(doc, "paid", bool_json()), Ok(true));
  assert_eq(optional_field(doc, "notes", string_json()), Ok(None));
  assert_eq(field(doc, "placed_at", int_json()), Ok(1723600000));
  assert_eq(field(doc, "total", decimal_json()), Ok(44.48m));

  // Nested, through the same primitive a derived codec would call.
  assert_eq(
    decode_and_then(field(doc, "customer", json_json()), |c: Json| field(c, "name", string_json())),
    Ok("Ada Lovelace"),
  );

  // The money is exact: 19.99 is not the nearest double to 19.99.
  assert_eq(
    decode_and_then(field(doc, "lines", list_json(json_json())), |ls: List<Json>|
      collect_prices(ls, [])),
    Ok([19.99m, 4.50m]),
  );

  // Re-rendering is stable whatever key order the input had.
  assert_eq(to_bytes(doc), to_bytes(parsed(to_bytes(doc))))
}

fn collect_prices(
  ls: List<Json>,
  acc: List<Decimal>,
) -> Result<List<Decimal>, DecodeError> / {abort.raise} =
  match ls {
    [] -> Ok(acc),
    [l, ..rest] -> decode_and_then(line_price(l), |p: Decimal| collect_prices(rest, push(acc, p))),
  }

// --- Tests: the round trip --------------------------------------------------

fn stable(src: Bytes) -> Bool / {abort.raise} = to_bytes(parsed(src)) == src

test "a large array renders and parses back to itself" {
  let big = Array(map(range(0, 2000), |i: Int| Number(decimal_of_int(i))));
  let text = to_string(big);
  assert_eq(string_len(text), 8891);
  assert_eq(parse(bytes_of_string(text)), Ok(big));
  let joined = Array(map(range(0, 500), |i: Int| Str("value")));
  assert_eq(parse(to_bytes(joined)), Ok(joined))
}

test "rendering is canonical, so a rendered document parses to itself" {
  assert(stable(b"null"));
  assert(stable(b"[1,2,3]"));
  assert(stable(b"{\"a\":1,\"b\":[true,null]}"));
  assert(stable(b"\"\\u0000\\n\\\"\""));
  assert(stable(b"-1.50"));
  // Whitespace and key order round-trip through the value but not byte for byte.
  assert(!stable(b"[1, 2]"));
  assert_eq(parsed(b"[1, 2]"), parsed(b"[1,2]"))
}

// --- Tests: pretty printing -------------------------------------------------

fn laid_out() -> String =
  \\{
  \\  "a": {},
  \\  "b": [
  \\    1.50,
  \\    {
  \\      "c": null
  \\    },
  \\    []
  \\  ]
  \\}

test "pretty text is a member or an element a line, keys in order, and nothing after the last" {
  let doc = parsed(b"{\"b\":[1.50,{\"c\":null},[]],\"a\":{}}");
  assert_eq(pretty_string(doc, 2), laid_out());
  assert_eq(pretty_bytes(doc, 2), bytes_of_string(laid_out()));
  assert_eq(pretty_string(parsed(b"[1,[2]]"), 4), "[\n    1,\n    [\n        2\n    ]\n]")
}

test "a value that holds nothing is written on one line" {
  assert_eq(pretty_string(Array([]), 2), "[]");
  assert_eq(pretty_string(Object(map_new()), 2), "{}");
  assert_eq(pretty_string(Null, 2), "null");
  assert_eq(pretty_string(Str("a\nb"), 2), "\"a\\nb\"");
  assert_eq(pretty_string(parsed(b"[[],{}]"), 1), "[\n [],\n {}\n]")
}

test "an indent of zero or less keeps the lines and starts each at the margin" {
  let doc = parsed(b"{\"a\":[1,2]}");
  assert_eq(pretty_string(doc, 0), "{\n\"a\": [\n1,\n2\n]\n}");
  assert_eq(pretty_string(doc, 0 - 3), pretty_string(doc, 0))
}

test "pretty text holds the tokens the compact text does, a string's whitespace among them" {
  let doc = parsed(b"{\"a b\":\" [1, 2] \",\"c\":\"\\\" , \\\\\"}");
  assert_eq(squeezed(pretty_bytes(doc, 2)), to_bytes(doc));
  assert_eq(squeezed(b" [ 1 , \" a \\\" b \" ] \r\n"), b"[1,\" a \\\" b \"]")
}

test "a value nested past the depth has no pretty text either" {
  let deep = fold(range(0, max_depth() + 1), Null, |inner: Json, _: Int| Array([inner]));
  let written = try[abort.raise] { pretty_bytes(deep, 2) };
  assert(match written { Err(_) -> true, Ok(_) -> false });
  let deepest = fold(range(0, max_depth()), Null, |inner: Json, _: Int| Array([inner]));
  assert_eq(parse(pretty_bytes(deepest, 1)), Ok(deepest))
}

// --- Tests: JSON Lines ------------------------------------------------------

test "a value a line reads in order, and a last line needs no line feed" {
  let three = Ok([Object(map_insert(map_new(), "a", int(1))), Array([int(2)]), Str("three")]);
  assert_eq(parse_lines(b"{\"a\":1}\n[2]\n\"three\"\n", 64, 8), three);
  assert_eq(parse_lines(b"{\"a\":1}\n[2]\n\"three\"", 64, 8), three);
  assert_eq(parse_lines(b"", 64, 8), Ok([]));
  assert_eq(parse_lines(b"\n", 64, 8), Ok([]))
}

test "a blank line holds no value and still counts, and a carriage return is whitespace" {
  assert_eq(parse_lines(b"1\n\n \t\n2\n", 64, 8), Ok([int(1), int(2)]));
  assert_eq(parse_lines(b"1\r\n2\r\n\r\n", 64, 8), Ok([int(1), int(2)]));
  assert_eq(
    parse_lines(b"1\n\n \t\n?\n", 64, 8),
    Err({
      line: 4,
      error: error_at(0, "expected a value: `{`, `[`, `\"`, a number, `true`, `false` or `null`"),
    }),
  )
}

type Unread = { name: String, text: Bytes, line: Int, offset: Int, message: String }

fn unread() -> List<Unread> =
  [
    {
      name: "a byte order mark",
      text: b"\xef\xbb\xbf{}\n",
      line: 1,
      offset: 0,
      message: "a byte order mark is no part of JSON: remove its three bytes",
    },
    {
      name: "two values on a line",
      text: b"1\n2 3\n",
      line: 2,
      offset: 2,
      message: "the document ended here; nothing may follow the top-level value",
    },
    {
      name: "a value over two lines",
      text: b"[1,\n2]\n",
      line: 1,
      offset: 3,
      message: "the input ended where a value was expected",
    },
    {
      name: "a line that is not UTF-8",
      text: b"1\n2\n\"\xff\"\n",
      line: 3,
      offset: 0,
      message: "a JSON document must be valid UTF-8",
    },
    {
      name: "a line past the length",
      text: b"[1]\n[1,2,3,4,5,6,7]\n",
      line: 2,
      offset: 12,
      message: "a line is longer than the 12 bytes this reader takes",
    },
    {
      name: "a value past the depth",
      text: b"[[1]]\n[[[1]]]\n",
      line: 2,
      offset: 2,
      message: "nested deeper than 2 levels",
    },
    {
      name: "a last line that is cut short",
      text: b"1\n{\"a\":",
      line: 2,
      offset: 5,
      message: "the input ended where a value was expected",
    },
  ]

test "{c.name} is refused with its line" for c: Unread in unread() {
  let refused: Result<List<Json>, LineError> = Err({
    line: c.line,
    error: error_at(c.offset, c.message),
  });
  assert_eq(parse_lines(c.text, 12, 2), refused);
  assert_eq(fed(each_byte(c.text), 12, 2), refused)
}

fn each_byte(text: Bytes) -> List<Bytes> / {abort.raise} =
  map(range(0, bytes_len(text)), |i: Int| bytes_slice(text, i, i + 1))

test "a line may be as long as the limit, and a reader refuses a longer one before it ends" {
  assert_eq(parse_lines(b"[1,2,3]\n", 7, 8), Ok([Array([int(1), int(2), int(3)])]));
  assert_eq(parse_lines(b"[1,2,3]\r\n", 8, 8), Ok([Array([int(1), int(2), int(3)])]));
  let early = lines_step(lines_start(7, 8), b"[1,2,3,4");
  assert_eq(
    early,
    Err({ line: 1, error: error_at(7, "a line is longer than the 7 bytes this reader takes") }),
  );
  assert_eq(
    line_error_to_string({ line: 3, error: error_at(7, "no") }),
    "line 3: $: no (at byte 7)",
  )
}

test "a depth past the parser's own is the parser's, and one of nothing admits no array" {
  assert(match parse_lines(nest(b"[", b"]", max_depth()), roomy(), 1_000) {
    Ok(_) -> true,
    Err(_) -> false,
  });
  assert_eq(
    parse_lines(nest(b"[", b"]", max_depth() + 1), roomy(), 1_000),
    Err({ line: 1, error: error_at(max_depth(), "nested deeper than 128 levels") }),
  );
  assert_eq(parse_lines(b"7\n", 8, 0), Ok([int(7)]));
  assert_eq(
    parse_lines(b"[]\n", 8, 0 - 1),
    Err({ line: 1, error: error_at(0, "nested deeper than 0 levels") }),
  );
  assert_eq(
    parse_lines(b"[[]]\n", 8, 1),
    Err({ line: 1, error: error_at(1, "nested deeper than 1 level") }),
  )
}

test "a reader carries a line across chunks, cut inside a value or inside a character" {
  let text = bytes_of_string("{\"name\":\"zoë\"}\n[1,\"😀\"]\n");
  let whole = parse_lines(text, 64, 8);
  assert_eq(
    whole,
    Ok([parsed(bytes_of_string("{\"name\":\"zoë\"}")), Array([int(1), Str("😀")])]),
  );
  assert_eq(fed(each_byte(text), 64, 8), whole);
  let first = lines_step(lines_start(64, 8), bytes_slice(text, 0, 12));
  assert_eq(
    first,
    Ok({
      reader: { max_line: 64, max_depth: 8, line: 1, partial: bytes_slice(text, 0, 12) },
      values: [],
    }),
  )
}

test "JSON Lines are written a value a line, with no line feed inside one" {
  assert_eq(lines_to_bytes([]), b"");
  assert_eq(
    lines_to_bytes([Str("a\nb"), parsed(b"{ \"k\" : [ 1 , 2 ] }")]),
    b"\"a\\nb\"\n{\"k\":[1,2]}\n",
  )
}

// --- Tests: pointers --------------------------------------------------------

/// The document of RFC 6901, section 5.
fn pointed_at() -> Json / {abort.raise} =
  parsed(
    b"{\"foo\":[\"bar\",\"baz\"],\"\":0,\"a/b\":1,\"c%d\":2,\"e^f\":3,\"g|h\":4,\"i\\\\j\":5,\"k\\\"l\":6,\" \":7,\"m~n\":8}",
  )

type Pointed = { pointer: String, value: Bytes }

fn pointed() -> List<Pointed> =
  [
    { pointer: "/foo", value: b"[\"bar\",\"baz\"]" },
    { pointer: "/foo/0", value: b"\"bar\"" },
    { pointer: "/", value: b"0" },
    { pointer: "/a~1b", value: b"1" },
    { pointer: "/c%d", value: b"2" },
    { pointer: "/e^f", value: b"3" },
    { pointer: "/g|h", value: b"4" },
    { pointer: "/i\\j", value: b"5" },
    { pointer: "/k\"l", value: b"6" },
    { pointer: "/ ", value: b"7" },
    { pointer: "/m~0n", value: b"8" },
  ]

fn pointed_by(text: String) -> Option<Json> / {abort.raise} =
  match pointer_of(text) {
    Some(p) -> resolve(pointed_at(), p),
    None -> panic("not a pointer: " ++ text),
  }

test "RFC 6901 resolves `{c.pointer}`" for c: Pointed in pointed() {
  assert_eq(pointed_by(c.pointer), Some(parsed(c.value)))
}

test "the empty pointer is the document, and a pointer leads nowhere rather than failing" {
  assert_eq(pointed_by(""), Some(pointed_at()));
  assert_eq(pointed_by("/nope"), None);
  assert_eq(pointed_by("/foo/2"), None);
  assert_eq(pointed_by("/foo/-"), None);
  assert_eq(pointed_by("/foo/0/bar"), None);
  assert_eq(pointed_by("/a~1b/0"), None)
}

test "an array index is digits with no leading zero" {
  let items = parsed(b"[\"zero\",\"one\"]");
  let at = |token: String| resolve(items, Pointer([token]));
  assert_eq(at("1"), Some(Str("one")));
  assert_eq(at("0"), Some(Str("zero")));
  assert_eq(at("01"), None);
  assert_eq(at("00"), None);
  assert_eq(at("+1"), None);
  assert_eq(at("-1"), None);
  assert_eq(at("1.0"), None);
  assert_eq(at(""), None);
  assert_eq(at("99999999999999999999"), None)
}

test "a pointer's text is its tokens escaped, and a text that is no pointer is none" {
  let p = Pointer(["a/b", "m~n", "", "~1"]);
  assert_eq(pointer_text(p), "/a~1b/m~0n//~01");
  assert_eq(f"{p}", "/a~1b/m~0n//~01");
  assert_eq(pointer_of("/a~1b/m~0n//~01"), Some(p));
  assert_eq(pointer_of(""), Some(Pointer([])));
  assert_eq(pointer_of("/"), Some(Pointer([""])));
  assert_eq(pointer_of("foo"), None);
  assert_eq(pointer_of("foo/bar"), None);
  assert_eq(pointer_of("/a~"), None);
  assert_eq(pointer_of("/a~2b"), None)
}
