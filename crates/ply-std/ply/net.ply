// The network effect. `import std.net (net)` and the operations below are the
// ones `ply_host::tcp` registers against.
//
// This module is the declaration and nothing else: a program that reaches a
// socket imports it rather than copying it, so the signature the host binds to
// and the signature the program performs are one text that cannot drift. An
// operation renamed on either side is E0421 at bind time, naming the operation
// that moved.
//
// `nondet` is load-bearing. It is what makes a `det` test that reaches a socket
// E0412 at compile time, with `--host` and without it, and it is checked against
// the handler at bind time — a `Nondeterministic` handler over an effect
// declared without it is E0423. The declaration is the authority; the handler is
// what gets refused.
//
// Every operation is resource-parameterized, and that is the whole reason the
// scheduler can run two connections at once: `net.write[a]` and `net.write[b]`
// name different resources, so they do not conflict and the tests, tasks or
// requests that hold them are free to interleave. The label is the *static*
// identity conflict detection speaks in; the `Int` handle each operation takes
// and returns is the *dynamic* one the host's socket table is keyed on. Two
// sockets accepted at one source site share a label and therefore contend —
// resource labels are ground identifiers in the source, so nothing else is
// expressible yet.
//
// Every operation is `write`, `recv` included. A read consumes bytes from the
// kernel's receive buffer, so two tasks reading one socket race exactly as two
// writers do, and calling that a `read` would let the conflict graph run them
// side by side.

pub nondet effect net {
  write listen[s](port: Int) -> Int
  write accept[s](listener: Int) -> Int
  write recv[s](conn: Int, max: Int) -> Bytes
  write send[s](conn: Int, payload: Bytes) -> Int
  write close[s](socket: Int) -> Unit
}

// A `recv` shorter than `max` is ordinary — TCP preserves the byte stream and
// not the boundaries a peer wrote it in — and an empty answer means the peer is
// done sending. Anything that needs a whole message loops.
pub fn drain(c: Int, so_far: Bytes) -> Bytes / {net.write[conn]} = {
  let chunk = net.recv[conn](c, 4096);
  if bytes_len(chunk) == 0 { so_far } else { drain(c, bytes_concat(so_far, chunk)) }
}

fn head(queued: List<Bytes>) -> Bytes = match queued { [first, ..] -> first, _ -> b"" }

fn tail(queued: List<Bytes>) -> List<Bytes> = match queued { [_, ..rest] -> rest, _ -> [] }

// A shipped module's tests are the compiler's, not a project's: `ply test` in a
// project that imports this module does not select them and writes nothing about
// them to that project's cache, because a project's test count must not change
// with a compiler upgrade. `ply test --std` selects them, and the compiler's own
// suite runs them.
test "drain stops at end of stream rather than at the first short read" {
  with_cell[inbox]([b"ab", b"c", b"", b"unread"]) { inbox -> {
    handle {
      assert_eq(drain(1, b""), b"abc")
    } with {
      net.recv[conn](c, max) -> {
        let queued = cell_get(inbox);
        cell_set(inbox, tail(queued));
        head(queued)
      },
    };
    assert_eq(cell_get(inbox), [b"unread"])
  } }
}
