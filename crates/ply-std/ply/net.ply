// The network effect.

// TLS is not a separate effect.
pub nondet effect net {
  write listen[s](port: Int) -> Int
  write listen_tls[s](port: Int, credential: String) -> Int
  write accept[s](listener: Int) -> Int
  write recv[s](conn: Int, max: Int, timeout_ms: Int) -> Option<Bytes>
  write send[s](conn: Int, payload: Bytes, timeout_ms: Int) -> Option<Int>
  write close[s](socket: Int) -> Unit
}

// A `recv` shorter than `max` is ordinary — TCP preserves the byte stream and not the boundaries a
// peer wrote it in — and an empty answer means the peer is done sending.
pub fn drain(c: Int, so_far: Bytes, timeout_ms: Int) -> Bytes / {net.write[conn]} =
  match net.recv[conn](c, 4096, timeout_ms) {
    None -> so_far,
    Some(chunk) ->
      if bytes_len(chunk) == 0 {
        so_far
      } else {
        drain(c, bytes_concat(so_far, chunk), timeout_ms)
      },
  }

// What programs call, and what `std.http` writes every response through.
pub fn send_all(c: Int, payload: Bytes, timeout_ms: Int) -> Bool / {net.write[conn]} =
  send_from(c, payload, 0, timeout_ms, max_writes())

// One call per partial write.
fn max_writes() -> Int = 4096

fn send_from(c: Int, payload: Bytes, at: Int, timeout_ms: Int, left: Int) -> Bool
  / {net.write[conn]} =
  if at >= bytes_len(payload) {
    true
  } else if left <= 0 {
    false
  } else {
    match net.send[conn](c, bytes_slice(payload, at, bytes_len(payload)), timeout_ms) {
      None -> false,
      Some(n) -> if n <= 0 { false } else { send_from(c, payload, at + n, timeout_ms, left - 1) },
    }
  }

fn head(queued: List<Bytes>) -> Bytes = match queued { [first, ..] -> first, _ -> b"" }

fn tail(queued: List<Bytes>) -> List<Bytes> = match queued { [_, ..rest] -> rest, _ -> [] }

// A shipped module's tests are the compiler's, not a project's: `ply test` in a project that
// imports this module does not select them and writes nothing about them to that project's cache,
// because a project's test count must not change with a compiler upgrade.
test "drain stops at end of stream rather than at the first short read" {
  with_cell[inbox]([b"ab", b"c", b"", b"unread"]) { inbox -> {
    handle {
      assert_eq(drain(1, b"", 1000), b"abc")
    } with {
      net.recv[conn](c, max, timeout_ms) -> {
        let queued = cell_get(inbox);
        cell_set(inbox, tail(queued));
        Some(head(queued))
      },
    };
    assert_eq(cell_get(inbox), [b"unread"])
  } }
}

// A deadline and an ending are different answers, and a caller that could not tell them apart would
// answer 408 to a peer that had simply finished.
test "a deadline is not an ending" {
  with_cell[inbox]([b"ab"]) { inbox -> {
    handle {
      assert_eq(drain(1, b"", 1000), b"ab")
    } with {
      net.recv[conn](c, max, timeout_ms) -> {
        let queued = cell_get(inbox);
        cell_set(inbox, tail(queued));
        match queued {
          [first, ..] -> Some(first),
          _ -> None,
        }
      },
    }
  } }
}

test "send_all loops over a partial write and stops at a dead peer" {
  with_cell[written](b"") { written -> {
    handle {
      assert(send_all(1, b"hello", 1000));
      assert_eq(cell_get(written), b"hello")
    } with {
      net.send[conn](c, payload, timeout_ms) -> {
        let take = if bytes_len(payload) > 2 { 2 } else { bytes_len(payload) };
        cell_set(written, bytes_concat(cell_get(written), bytes_slice(payload, 0, take)));
        Some(take)
      },
    }
  } };
  handle {
    assert(!send_all(1, b"hello", 1000))
  } with {
    net.send[conn](c, payload, timeout_ms) -> Some(0),
  };
  handle {
    assert(!send_all(1, b"hello", 1000))
  } with {
    net.send[conn](c, payload, timeout_ms) -> None,
  }
}
