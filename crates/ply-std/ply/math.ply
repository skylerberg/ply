// `math` — the integer arithmetic a program wants and the operators are not.
//
// `min` and `max` are prelude builtins and stay there. Everything here is `Int`, which is `i64`:
// the arithmetic wraps at that width rather than raising, so `pow` and `abs(min_int())` answer a
// wrapped value. A checked variant would have to say what it answers instead, which is card `B10`'s
// ground (the numeric predicates) and not this module's.

/// The bound of an `Int`, asked of the compiler rather than written out, so the two cannot drift.
pub fn min_int() -> Int = 0 - max_int() - 1

pub fn max_int() -> Int = 9223372036854775807

/// The distance from zero; `abs(min_int())` is `min_int()` again, because its negation is not an
/// `Int`.
pub fn abs(n: Int) -> Int = if n < 0 { 0 - n } else { n }

/// `-1`, `0` or `1`.
pub fn sign(n: Int) -> Int = if n > 0 { 1 } else if n < 0 { 0 - 1 } else { 0 }

/// `n` brought into `lo..=hi`; a `lo` above `hi` answers `lo`, since there is nothing in the range
/// to answer.
pub fn clamp(n: Int, lo: Int, hi: Int) -> Int = if n < lo { lo } else if n > hi { hi } else { n }

pub fn even(n: Int) -> Bool = n % 2 == 0

pub fn odd(n: Int) -> Bool = n % 2 != 0

/// The greatest common divisor, never negative; `gcd(0, 0)` is `0`.
pub fn gcd(a: Int, b: Int) -> Int / {abort.raise} = gcd_from(abs(a), abs(b))

/// The least common multiple, never negative; either addend zero makes it `0`.
pub fn lcm(a: Int, b: Int) -> Int / {abort.raise} = if a == 0 || b == 0 { 0 } else { abs(a / gcd(a, b) * b) }

/// `base` to `exponent`, by squaring. A negative exponent is `1`, as integer arithmetic has it,
/// and an overflow wraps at `Int`'s width.
pub fn pow(base: Int, exponent: Int) -> Int =
  if exponent < 0 { 1 } else { pow_from(base, exponent, 1) }

/// Whether `n` is prime. Zero, one and every negative number are not.
pub fn is_prime(n: Int) -> Bool / {abort.raise} = if n < 2 { false } else { has_no_divisor(n, 2) }

/// `n!`. A negative `n` is `1`, and the product wraps at `Int`'s width.
pub fn factorial(n: Int) -> Int = if n <= 1 { 1 } else { n * factorial(n - 1) }

/// The integer square root: the greatest `r` whose square is at most `n`. A negative `n` has none
/// and answers `0`.
pub fn isqrt(n: Int) -> Int / {abort.raise} = if n <= 0 { 0 } else { isqrt_from(n, n / 2 + 1) }

fn gcd_from(a: Int, b: Int) -> Int / {abort.raise} = if b == 0 { a } else { gcd_from(b, a % b) }

fn pow_from(base: Int, exponent: Int, acc: Int) -> Int =
  if exponent == 0 { acc }
  else if even(exponent) { pow_from(base * base, exponent / 2, acc) }
  else { pow_from(base, exponent - 1, acc * base) }

fn has_no_divisor(n: Int, d: Int) -> Bool / {abort.raise} =
  if d * d > n { true } else if n % d == 0 { false } else { has_no_divisor(n, d + 1) }

fn isqrt_from(n: Int, guess: Int) -> Int / {abort.raise} = {
  let next = (guess + n / guess) / 2;
  if next >= guess { guess } else { isqrt_from(n, next) }
}

// --- Tests ------------------------------------------------------------------

test "sign, abs and clamp agree at the edges" {
  assert_eq(sign(0 - 5), 0 - 1);
  assert_eq(sign(0), 0);
  assert_eq(sign(5), 1);
  assert_eq(abs(0 - 5), 5);
  assert_eq(abs(5), 5);
  assert_eq(abs(0), 0);
  assert_eq(clamp(5, 1, 3), 3);
  assert_eq(clamp(0, 1, 3), 1);
  assert_eq(clamp(2, 1, 3), 2);
  assert_eq(clamp(2, 3, 1), 3)
}

test "gcd and lcm are non-negative, and zero is answered rather than refused" {
  assert_eq(gcd(12, 18), 6);
  assert_eq(gcd(0 - 12, 18), 6);
  assert_eq(gcd(0, 5), 5);
  assert_eq(gcd(0, 0), 0);
  assert_eq(lcm(4, 6), 12);
  assert_eq(lcm(0, 6), 0);
  assert_eq(lcm(7, 1), 7)
}

test "pow is by squaring, and the bounds are the compiler's" {
  assert_eq(pow(2, 10), 1024);
  assert_eq(pow(3, 0), 1);
  assert_eq(pow(0, 0), 1);
  assert_eq(pow(2, 0 - 1), 1);
  assert_eq(pow(0 - 2, 3), 0 - 8);
  assert_eq(min_int() + 1, 0 - max_int());
  assert(even(2));
  assert(odd(3));
  assert(even(0))
}

test "prime, factorial and isqrt are total over the whole range" {
  assert(is_prime(2));
  assert(is_prime(3));
  assert(is_prime(97));
  assert(!is_prime(1));
  assert(!is_prime(0));
  assert(!is_prime(0 - 7));
  assert(!is_prime(4));
  assert(!is_prime(99));
  assert_eq(factorial(5), 120);
  assert_eq(factorial(0), 1);
  assert_eq(factorial(0 - 3), 1);
  assert_eq(isqrt(0), 0);
  assert_eq(isqrt(1), 1);
  assert_eq(isqrt(2), 1);
  assert_eq(isqrt(4), 2);
  assert_eq(isqrt(99), 9);
  assert_eq(isqrt(100), 10);
  assert_eq(isqrt(0 - 4), 0)
}
