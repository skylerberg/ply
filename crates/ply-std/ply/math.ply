// `math` — the arithmetic a program wants and the operators are not.
//
// `min` and `max` are prelude builtins and stay there. `abs`, `sign`, `clamp`, `sum` and `product`
// take any numeric type and raise where its operators raise; the rest is `Int`.

/// The bound of an `Int`, asked of the compiler rather than written out, so the two cannot drift.
pub fn min_int() -> Int = 0 - max_int() - 1

pub fn max_int() -> Int = 9223372036854775807

/// The distance from zero; it raises where the negation leaves the type, as `abs(min_int())` does.
pub fn abs<a>(n: a) -> a
  where numeric(a)
= {
  let zero: a = numeric_of_int(0);
  if n < zero { zero - n } else { n }
}

/// `-1`, `0` or `1`.
pub fn sign<a>(n: a) -> Int
  where numeric(a)
= {
  let zero: a = numeric_of_int(0);
  if n > zero { 1 } else if n < zero { 0 - 1 } else { 0 }
}

/// `n` brought into `lo..=hi`; a `lo` above `hi` answers `lo`, since there is nothing in the range
/// to answer.
pub fn clamp<a>(n: a, lo: a, hi: a) -> a
  where numeric(a)
= if n < lo { lo } else if n > hi { hi } else { n }

/// The total, raising where a width overflows; the empty list's is zero.
pub fn sum<a>(xs: List<a>) -> a
  where numeric(a)
= fold(xs, numeric_of_int(0), |s: a, x: a| s + x)

/// The product, raising where a width overflows; the empty list's is one.
pub fn product<a>(xs: List<a>) -> a
  where numeric(a)
= fold(xs, numeric_of_int(1), |p: a, x: a| p * x)

pub fn even(n: Int) -> Bool = n % 2 == 0

pub fn odd(n: Int) -> Bool = n % 2 != 0

/// The greatest common divisor, never negative; `gcd(0, 0)` is `0`.
pub fn gcd(a: Int, b: Int) -> Int / {abort.raise} = gcd_from(abs(a), abs(b))

/// The least common multiple, never negative; either addend zero makes it `0`.
pub fn lcm(a: Int, b: Int) -> Int / {abort.raise} =
  if a == 0 || b == 0 { 0 } else { abs(a / gcd(a, b) * b) }

/// `base` to `exponent`, by squaring. A negative exponent is `1`, as integer arithmetic has it,
/// and an overflow wraps at `Int`'s width.
pub fn pow(base: Int, exponent: Int) -> Int =
  if exponent < 0 { 1 } else { pow_from(base, exponent, 1) }

/// Whether `n` is prime. Zero, one and every negative number are not.
pub fn is_prime(n: Int) -> Bool / {abort.raise} = if n < 2 { false } else { has_no_divisor(n, 2) }

/// `n!`. A negative `n` is `1`, and the product wraps at `Int`'s width.
pub fn factorial(n: Int) -> Int = if n <= 1 { 1 } else { n * factorial(n - 1) }

/// The integer square root: the greatest `r` whose square is at most `n`. A negative `n` has none
/// and answers `0`.
pub fn isqrt(n: Int) -> Int / {abort.raise} = if n <= 0 { 0 } else { isqrt_from(n, n / 2 + 1) }

/// The integer logarithm: the greatest `k` whose power of two is at most `n`, so `ilog2(1024)` is
/// `10`. A non-positive `n` has none and answers `0`, as `1` does.
pub fn ilog2(n: Int) -> Int = if n <= 1 { 0 } else { 1 + ilog2(n / 2) }

fn gcd_from(a: Int, b: Int) -> Int / {abort.raise} = if b == 0 { a } else { gcd_from(b, a % b) }

fn pow_from(base: Int, exponent: Int, acc: Int) -> Int =
  if exponent == 0 { acc }
  else if even(exponent) { pow_from(base * base, exponent / 2, acc) }
  else { pow_from(base, exponent - 1, acc * base) }

fn has_no_divisor(n: Int, d: Int) -> Bool / {abort.raise} =
  if d * d > n { true } else if n % d == 0 { false } else { has_no_divisor(n, d + 1) }

fn isqrt_from(n: Int, guess: Int) -> Int / {abort.raise} = {
  let next = (guess + n / guess) / 2;
  if next >= guess { guess } else { isqrt_from(n, next) }
}

// --- Tests ------------------------------------------------------------------

test "sign, abs and clamp agree at the edges" {
  assert_eq(sign(0 - 5), 0 - 1);
  assert_eq(sign(0), 0);
  assert_eq(sign(5), 1);
  assert_eq(abs(0 - 5), 5);
  assert_eq(abs(5), 5);
  assert_eq(abs(0), 0);
  assert_eq(clamp(5, 1, 3), 3);
  assert_eq(clamp(0, 1, 3), 1);
  assert_eq(clamp(2, 1, 3), 2);
  assert_eq(clamp(2, 3, 1), 3)
}

test "the numeric functions take every numeric type, and a width's own bounds" {
  assert_eq(abs(0.0 - 2.5), 2.5);
  assert_eq(abs(i8_of_int(0 - 7)), 7i8);
  assert_eq(sign(0m - 1.5m), 0 - 1);
  assert_eq(clamp(300u32, 1u32, 255u32), 255u32);
  assert_eq(sum([1, 2, 3]), 6);
  assert_eq(sum([250u8, 5u8]), 255u8);
  assert_eq(sum([1.5m, 2.25m]), 3.75m);
  assert_eq(sum([0.5, 0.25]), 0.75);
  assert_eq(sum(map(range(0, 4), |i: Int| u32_of_int(i))), 6u32);
  assert_eq(product([2, 3, 4]), 24);
  assert_eq(product([2u16, 300u16]), 600u16);
  assert_eq(sum([]), 0);
  assert_eq(product([]), 1.0)
}

test "gcd and lcm are non-negative, and zero is answered rather than refused" {
  assert_eq(gcd(12, 18), 6);
  assert_eq(gcd(0 - 12, 18), 6);
  assert_eq(gcd(0, 5), 5);
  assert_eq(gcd(0, 0), 0);
  assert_eq(lcm(4, 6), 12);
  assert_eq(lcm(0, 6), 0);
  assert_eq(lcm(7, 1), 7)
}

test "pow is by squaring, and the bounds are the compiler's" {
  assert_eq(pow(2, 10), 1024);
  assert_eq(pow(3, 0), 1);
  assert_eq(pow(0, 0), 1);
  assert_eq(pow(2, 0 - 1), 1);
  assert_eq(pow(0 - 2, 3), 0 - 8);
  assert_eq(min_int() + 1, 0 - max_int());
  assert(even(2));
  assert(odd(3));
  assert(even(0))
}

test "prime, factorial and isqrt are total over the whole range" {
  assert(is_prime(2));
  assert(is_prime(3));
  assert(is_prime(97));
  assert(!is_prime(1));
  assert(!is_prime(0));
  assert(!is_prime(0 - 7));
  assert(!is_prime(4));
  assert(!is_prime(99));
  assert_eq(factorial(5), 120);
  assert_eq(factorial(0), 1);
  assert_eq(factorial(0 - 3), 1);
  assert_eq(isqrt(0), 0);
  assert_eq(isqrt(1), 1);
  assert_eq(isqrt(2), 1);
  assert_eq(isqrt(4), 2);
  assert_eq(isqrt(99), 9);
  assert_eq(isqrt(100), 10);
  assert_eq(isqrt(0 - 4), 0);
  assert_eq(ilog2(1), 0);
  assert_eq(ilog2(2), 1);
  assert_eq(ilog2(1023), 9);
  assert_eq(ilog2(1024), 10);
  assert_eq(ilog2(max_int()), 62);
  assert_eq(ilog2(0), 0);
  assert_eq(ilog2(0 - 8), 0)
}
