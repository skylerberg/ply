// std.pkg — the package manifest as typed data: what a `ply.pkg` file parses to, and what a
// lockfile pins a resolution of.

import std.json

pub type Version = { major: Int, minor: Int, patch: Int }

// Where a dependency's sources come from: a path on this machine, a git remote pinned by
// revision, or the registry, whose address is the dependency's name and version and nothing else.
pub type Source = | Path(String) | Git(String, String) | Registry

// `min` is a floor, not a pin: resolution picks the highest version the closure asks for, and
// the lockfile records what it picked.
pub type Dep = { name: String, prefix: Option<String>, min: Version, source: Source }

pub type Manifest = {
  name: String,
  version: Version,
  // The module root importers reach this package through; `name` when None.
  prefix: Option<String>,
  // The toolchain this package builds with; artifacts already refuse a version mismatch (E0444).
  runtime: Version,
  dependencies: List<Dep>,
  // The definition `ply build` closes over; `main` when None.
  entry: Option<String>,
}

derive eq for Version
derive ord for Version
derive json for Version
derive eq for Source
derive json for Source
derive eq for Dep
derive json for Dep
derive eq for Manifest
derive json for Manifest

pub fn prefix_of(m: Manifest) -> String = match m.prefix { None -> m.name, Some(p) -> p }

pub fn entry_of(m: Manifest) -> String = match m.entry { None -> "main", Some(e) -> e }

pub fn render_version(v: Version) -> String =
  int_to_string(v.major) ++ "." ++ int_to_string(v.minor) ++ "." ++ int_to_string(v.patch)

test "a version renders dotted" {
  assert_eq(render_version({ major: 1, minor: 23, patch: 4 }), "1.23.4")
}

test "prefix and entry default to the name and main" {
  let m: Manifest = {
    name: "corpus",
    version: { major: 0, minor: 1, patch: 0 },
    prefix: None,
    runtime: { major: 0, minor: 1, patch: 0 },
    dependencies: [],
    entry: None,
  };
  assert_eq(prefix_of(m), "corpus");
  assert_eq(entry_of(m), "main");
  assert_eq(prefix_of({ ..m, prefix: Some("kx") }), "kx");
  assert_eq(entry_of({ ..m, entry: Some("app.serve") }), "app.serve")
}

test "a manifest round-trips through its json codec" {
  let m: Manifest = {
    name: "corpus",
    version: { major: 0, minor: 1, patch: 0 },
    prefix: Some("kx"),
    runtime: { major: 0, minor: 1, patch: 0 },
    dependencies: [
      { name: "cli", prefix: None, min: { major: 1, minor: 2, patch: 3 }, source: Path("../cli") },
      {
        name: "gitlib",
        prefix: None,
        min: { major: 0, minor: 0, patch: 1 },
        source: Git("https://example.com/gitlib", "deadbee"),
      },
      {
        name: "reglib",
        prefix: Some("rl"),
        min: { major: 2, minor: 0, patch: 0 },
        source: Registry,
      },
    ],
    entry: Some("app.serve"),
  };
  assert_eq(manifest_json().decode(manifest_json().encode(m)), Ok(m))
}

test "a version orders major, then minor, then patch" {
  let c = version_ord();
  assert_eq(
    (c.compare)({ major: 1, minor: 0, patch: 0 }, { major: 0, minor: 9, patch: 9 }),
    Greater,
  );
  assert_eq(
    (c.compare)({ major: 0, minor: 2, patch: 0 }, { major: 0, minor: 1, patch: 9 }),
    Greater,
  );
  assert_eq(
    (c.compare)({ major: 0, minor: 1, patch: 2 }, { major: 0, minor: 1, patch: 1 }),
    Greater,
  );
  assert_eq((c.compare)({ major: 1, minor: 2, patch: 3 }, { major: 1, minor: 2, patch: 3 }), Equal)
}
