test "{c.f} of {to_string(Complex(float_of_bits(c.re), float_of_bits(c.im)))}" for c: Point in published(
  ) {
  let got = applied(c.f, Complex(float_of_bits(c.re), float_of_bits(c.im)));
  assert(
    published_part(re(got), float_of_bits(c.want_re))
      && published_part(im(got), float_of_bits(c.want_im)),
    Some(
      to_string(got) ++ " is not "
        ++ to_string(Complex(float_of_bits(c.want_re), float_of_bits(c.want_im))),
    ),
  )
}

test "the special values Annex G gives where cmath raises instead" {
  let inf = float::infinity();
  // G.6.3.2: the logarithm of a zero is an infinity below zero, at the angle of the zero.
  assert(same(ln(Complex(0.0, 0.0)), Complex(-inf, 0.0)));
  assert(same(ln(Complex(-0.0, 0.0)), Complex(-inf, float::pi())));
  assert(same(ln(Complex(0.0, -0.0)), Complex(-inf, -0.0)));
  assert(same(ln(Complex(-0.0, -0.0)), Complex(-inf, -float::pi())));
  // G.6.3.1: an infinite angle has no direction.
  assert(same(exp(Complex(1.0, inf)), Complex(float::nan(), float::nan())));
  assert(same(exp(Complex(-1.0, -inf)), Complex(float::nan(), float::nan())));
  assert(same(exp(Complex(inf, inf)), Complex(inf, float::nan())));
  assert(same(exp(Complex(-inf, inf)), Complex(0.0, 0.0)))
}

test "a power is the exponential of the exponent times the logarithm, cut where the logarithm is" {
  let close = |got: Complex, x: Float, y: Float| is_close(got, Complex(x, y), 1e-12, 1e-15);
  assert(
    close(pow(Complex(-8.0, 0.0), Complex(1.0 / 3.0, 0.0)), 1.0000000000000002, 1.7320508075688772),
  );
  assert(close(pow(Complex(-1.0, -0.0), Complex(0.5, 0.0)), 6.123233995736766e-17, -1.0));
  assert(close(pow(Complex(2.0, 0.0), Complex(3.0, 0.0)), 8.0, 0.0));
  assert(close(pow(i(), i()), 0.20787957635076193, 0.0));
  assert(close(pow(Complex(1.0, 2.0), Complex(3.0, -1.0)), -27.43638199160605, 19.789310365010714));
  assert_eq(pow(zero(), zero()), one());
  assert_eq(pow(Complex(5.0, -7.0), zero()), one());
  assert_eq(pow(zero(), Complex(2.0, 1.0)), zero())
}

test "a number is written as its parts and read back, and nothing else is one" {
  assert_eq(to_string(Complex(1.5, 2.0)), "1.5+2.0i");
  assert_eq(to_string(Complex(-0.0, -1.5e-7)), "-0.0-1.5e-7i");
  assert_eq(f"{Complex(float::nan(), float::neg_infinity())}", "NaN-Infinityi");
  assert_eq(parse("1.5+2.0i"), Some(Complex(1.5, 2.0)));
  assert_eq(parse("-1e-5-2.5e3i"), Some(Complex(-1e-5, -2500.0)));
  assert(same(option_or_nan(parse("-0.0-0.0i")), Complex(-0.0, -0.0)));
  assert(
    same(
      option_or_nan(parse("Infinity-Infinityi")),
      Complex(float::infinity(), float::neg_infinity()),
    ),
  );
  assert(same(option_or_nan(parse("NaN+NaNi")), Complex(float::nan(), float::nan())));
  assert_eq(
    map(["", "1.5", "2.0i", "1.5+2.0", "1.5+-2.0i", "1.5+i", "+i", "1.5 + 2.0i", "x+1i"], parse),
    [None, None, None, None, None, None, None, None, None],
  )
}

fn option_or_nan(z: Option<Complex>) -> Complex =
  match z { Some(found) -> found, None -> Complex(float::nan(), float::nan()) }

/// Two `Int`s a law draws, and the number they make: each part a multiple of a sixty-fourth, up
/// to a few thousand either way, so that zero parts, which are where the cuts are, come up.
type Drawn = { a: Int, b: Int }

fn made(p: Drawn) -> Complex =
  Complex(float_of_int(p.a >> 46) / 64.0, float_of_int(p.b >> 46) / 64.0)

law "along the real axis the operators are Float's"
  forall (p: Drawn) {
    let x = re(made(p));
    let y = im(made(p));
    of_float(x) + of_float(y) == of_float(x + y) && of_float(x) - of_float(y) == of_float(x - y)
      && of_float(x) * of_float(y) == of_float(x * y)
  }

law "a conjugate's conjugate is the number, and a number times its conjugate its distance squared"
  forall (p: Drawn) {
    same(conj(conj(made(p))), made(p))
      && is_close(made(p) * conj(made(p)), of_float(abs(made(p)) * abs(made(p))), 1e-14, 0.0)
  }

law "division undoes multiplication"
  forall (p: Drawn, q: Drawn) {
    (re(made(q)) == 0.0 && im(made(q)) == 0.0)
      || is_close(div(made(p) * made(q), made(q)), made(p), 1e-12, 0.0)
  }

law "a square root lies in the right half-plane and squares to the number"
  forall (p: Drawn) {
    let root = sqrt(made(p));
    re(root) >= 0.0 && is_close(root * root, made(p), 1e-13, 0.0)
  }

law "the exponential of a logarithm is the number, the logarithm's angle within half a turn"
  forall (p: Drawn) {
    (re(made(p)) == 0.0 && im(made(p)) == 0.0)
      || (float::abs(im(ln(made(p)))) <= float::pi()
      && is_close(exp(ln(made(p))), made(p), 1e-12, 0.0))
  }

law "each function takes a conjugate to a conjugate, on a cut as off it"
  forall (p: Drawn) {
    let z = made(p);
    same(sqrt(conj(z)), conj(sqrt(z))) && same(ln(conj(z)), conj(ln(z)))
      && same(exp(conj(z)), conj(exp(z)))
      && same(asin(conj(z)), conj(asin(z)))
      && same(acos(conj(z)), conj(acos(z)))
      && same(atan(conj(z)), conj(atan(z)))
      && same(asinh(conj(z)), conj(asinh(z)))
      && same(acosh(conj(z)), conj(acosh(z)))
      && same(atanh(conj(z)), conj(atanh(z)))
      && same(sinh(conj(z)), conj(sinh(z)))
      && same(cosh(conj(z)), conj(cosh(z)))
      && same(tanh(conj(z)), conj(tanh(z)))
      && same(sin(conj(z)), conj(sin(z)))
      && same(cos(conj(z)), conj(cos(z)))
      && same(tan(conj(z)), conj(tan(z)))
  }

law "each inverse function is undone by its function"
  forall (p: Drawn) {
    let z = scale(made(p), 1.0 / 64.0);
    is_close(sin(asin(z)), z, 1e-9, 1e-12) && is_close(cos(acos(z)), z, 1e-9, 1e-12)
      && is_close(sinh(asinh(z)), z, 1e-9, 1e-12)
      && is_close(cosh(acosh(z)), z, 1e-9, 1e-12)
      && (float::abs(re(z)) == 1.0 || is_close(tanh(atanh(z)), z, 1e-9, 1e-12))
      && (float::abs(im(z)) == 1.0 || is_close(tan(atan(z)), z, 1e-9, 1e-12))
  }

law "a number reads back from its text, bit for bit"
  forall (x: Float, y: Float) {
    same(option_or_nan(parse(to_string(Complex(x, y)))), Complex(x, y))
  }
