//! Complex numbers over `Float`.
//!
//! A `Complex` is a real and an imaginary part, each any `Float`, so every pair is a number and
//! there is nothing to keep true of one. The type states `numeric`: `a + b`, `a - b`, `a * b` and
//! `-a` are `add`, `sub`, `mul` and `neg`. It states no `key`: `==` reads the two parts as IEEE
//! does, so `-0.0` equals `0.0` and a `NaN` equals nothing, itself included; a complex number has
//! no order, is no `Map` key, and fills no `numeric(a)`, which holds `<`. A law over one is run, not
//! proved.
//!
//! Each function answers its principal value, with the branch cuts and the signs of zero C99's
//! Annex G gives them, which are Kahan's: `sqrt` and `ln` are cut along the negative real axis;
//! `asin`, `acos` and `atanh` along the real axis outside `-1..=1`; `asinh` and `atan` along the
//! imaginary axis outside `-i..=i`; and `acosh` along the real axis below `1`. On a cut the sign of
//! the zero part says which side the point is on, so `sqrt` of `-4+0i` is `2i` and of `-4-0i` is
//! `-2i`, and each function takes a conjugate to a conjugate. `sqrt`, `ln` and `exp` answer what
//! Annex G does for an infinity and a `NaN` as well; the rest are held to it at finite points only.

import std.float
import std.float (copy_sign, cosine, exponential, natural_log, sine, square_root)
import std.list (at_or, slice)

/// A complex number: its real part, then its imaginary part.
pub type Complex = | Complex(Float, Float)

numeric for Complex by { add: add, sub: sub, mul: mul, neg: neg, of_int: of_int }

show for Complex by to_string

// --- Making and reading one -------------------------------------------------

/// Zero.
pub fn zero() -> Complex = Complex(0.0, 0.0)

/// One.
pub fn one() -> Complex = Complex(1.0, 0.0)

/// The imaginary unit.
pub fn i() -> Complex = Complex(0.0, 1.0)

/// `re + im * i`.
pub fn of_parts(re: Float, im: Float) -> Complex = Complex(re, im)

/// The real number `x`.
pub fn of_float(x: Float) -> Complex = Complex(x, 0.0)

/// The whole number `n`, to the nearest `Float`.
pub fn of_int(n: Int) -> Complex = Complex(float_of_int(n), 0.0)

/// The number at distance `r` from zero and angle `theta` radians from the positive real axis.
pub fn of_polar(r: Float, theta: Float) -> Complex = Complex(r * cosine(theta), r * sine(theta))

/// The real part.
pub fn re(z: Complex) -> Float = match z { Complex(x, _) -> x }

/// The imaginary part.
pub fn im(z: Complex) -> Float = match z { Complex(_, y) -> y }

/// The distance from zero, without overflow on the way: an infinity where either part is one.
pub fn abs(z: Complex) -> Float = hypot(re(z), im(z))

/// The angle from the positive real axis in radians, in `[-pi, pi]`: `pi` on the negative real
/// axis above a `+0.0` imaginary part and `-pi` below a `-0.0` one.
pub fn arg(z: Complex) -> Float = atan2(im(z), re(z))

/// The distance from zero and the angle: `abs` and `arg`.
pub fn to_polar(z: Complex) -> { r: Float, theta: Float } = { r: abs(z), theta: arg(z) }

/// Whether either part is a `NaN`.
pub fn is_nan(z: Complex) -> Bool = float::is_nan(re(z)) || float::is_nan(im(z))

/// Whether either part is an infinity, whatever the other is.
pub fn is_infinite(z: Complex) -> Bool = float::is_infinite(re(z)) || float::is_infinite(im(z))

/// Whether both parts are finite.
pub fn is_finite(z: Complex) -> Bool = float::is_finite(re(z)) && float::is_finite(im(z))

/// Whether `a` and `b` are within `relative` of the larger of their distances from zero, or
/// within `absolute`, whichever allows more, as Python's `cmath.isclose` decides.
pub fn is_close(a: Complex, b: Complex, relative: Float, absolute: Float) -> Bool =
  (re(a) == re(b) && im(a) == im(b))
    || (is_finite(a) && is_finite(b)
    && (abs(sub(a, b)) <= relative * abs(a) || abs(sub(a, b)) <= relative * abs(b)
    || abs(sub(a, b)) <= absolute))

// --- Arithmetic -------------------------------------------------------------

/// `a + b`.
pub fn add(a: Complex, b: Complex) -> Complex = Complex(re(a) + re(b), im(a) + im(b))

/// `a - b`.
pub fn sub(a: Complex, b: Complex) -> Complex = Complex(re(a) - re(b), im(a) - im(b))

/// `a * b`.
pub fn mul(a: Complex, b: Complex) -> Complex =
  Complex(re(a) * re(b) - im(a) * im(b), re(a) * im(b) + im(a) * re(b))

/// The number with both signs flipped, a zero's included.
pub fn neg(z: Complex) -> Complex = Complex(-re(z), -im(z))

/// The conjugate: the imaginary part's sign flipped.
pub fn conj(z: Complex) -> Complex = Complex(re(z), -im(z))

/// `z` times the real number `factor`.
pub fn scale(z: Complex, factor: Float) -> Complex = Complex(re(z) * factor, im(z) * factor)

/// `a / b`, by Smith's method: the divisor's smaller part is divided by its larger first, so
/// nothing is squared and a quotient that fits is not lost to an overflow on the way. A zero
/// divisor answers what each part over a zero is: infinities, or `NaN`s for zero over zero.
pub fn div(a: Complex, b: Complex) -> Complex =
  if re(b) == 0.0 && im(b) == 0.0 { Complex(re(a) / re(b), im(a) / re(b)) }
  else if float::abs(re(b)) >= float::abs(im(b)) {
    let ratio = im(b) / re(b);
    let over = re(b) + im(b) * ratio;
    Complex((re(a) + im(a) * ratio) / over, (im(a) - re(a) * ratio) / over)
  } else {
    let ratio = re(b) / im(b);
    let over = re(b) * ratio + im(b);
    Complex((re(a) * ratio + im(a)) / over, (im(a) * ratio - re(a)) / over)
  }

/// `1 / z`.
pub fn reciprocal(z: Complex) -> Complex = div(one(), z)

// --- Exponentials -----------------------------------------------------------

/// `e` to the power `z`: `e^re` at the angle `im`. A real `z` answers a real number, the sign of
/// its zero kept.
pub fn exp(z: Complex) -> Complex = {
  let x = re(z);
  let y = im(z);
  if y == 0.0 { Complex(exponential(x), y) } else if float::is_finite(y) {
    if float::is_infinite(x) && x < 0.0 {
      Complex(copy_sign(0.0, cosine(y)), copy_sign(0.0, sine(y)))
    } else { Complex(exponential(x) * cosine(y), exponential(x) * sine(y)) }
  } else if float::is_infinite(x) {
    if x < 0.0 { Complex(0.0, 0.0) } else { Complex(x, float::nan()) }
  } else { Complex(float::nan(), float::nan()) }
}

/// The natural logarithm: the logarithm of `abs`, and `arg`. It is cut along the negative real
/// axis, where the imaginary part is `pi` above the cut and `-pi` below it, and zero's is an
/// infinity below zero.
pub fn ln(z: Complex) -> Complex = Complex(natural_log(abs(z)), arg(z))

/// The square root in the right half-plane. It is cut along the negative real axis, where the
/// root is on the positive imaginary axis above the cut and on the negative one below it.
pub fn sqrt(z: Complex) -> Complex = {
  let x = re(z);
  let y = im(z);
  if x == 0.0 && y == 0.0 { Complex(0.0, y) }
  else if float::is_infinite(y) { Complex(float::infinity(), y) }
  else if float::is_nan(x) { Complex(float::nan(), float::nan()) } else if float::is_infinite(x) {
    if x > 0.0 { Complex(x, if float::is_nan(y) { y } else { copy_sign(0.0, y) }) }
    else { Complex(if float::is_nan(y) { y } else { 0.0 }, copy_sign(float::infinity(), y)) }
  } else if float::abs(x) >= 4e307 || float::abs(y) >= 4e307 {
    scale(finite_root(0.25 * x, 0.25 * y), 2.0)
  } else { finite_root(x, y) }
}

/// `z` to the power `w`: `exp` of `w` times `ln` of `z`, so it is cut where `ln` is. Anything to
/// the power zero is one, and zero to a power with a real part above zero is zero.
pub fn pow(z: Complex, w: Complex) -> Complex =
  if re(w) == 0.0 && im(w) == 0.0 { one() }
  else if re(z) == 0.0 && im(z) == 0.0 && re(w) > 0.0 { zero() }
  else { exp(mul(w, ln(z))) }

// --- Trigonometry -----------------------------------------------------------

/// The hyperbolic sine.
pub fn sinh(z: Complex) -> Complex =
  if im(z) == 0.0 { Complex(real_sinh(re(z)), im(z)) }
  else { Complex(real_sinh(re(z)) * cosine(im(z)), real_cosh(re(z)) * sine(im(z))) }

/// The hyperbolic cosine.
pub fn cosh(z: Complex) -> Complex =
  Complex(real_cosh(re(z)) * cosine(im(z)), real_sinh(re(z)) * sine(im(z)))

/// The hyperbolic tangent: `sinh` times `cosh` of the real part and `sin` times `cos` of the
/// imaginary one, each over their common divisor, which loses nothing where `sinh` over `cosh`
/// would cancel. Far from the imaginary axis the real part is within a rounding of `-1` or `1`,
/// and is that.
pub fn tanh(z: Complex) -> Complex =
  if float::abs(re(z)) > 22.0 {
    Complex(
      copy_sign(1.0, re(z)),
      4.0 * sine(im(z)) * cosine(im(z)) * exponential(-2.0 * float::abs(re(z))),
    )
  } else {
    let over = real_sinh(re(z)) * real_sinh(re(z)) + cosine(im(z)) * cosine(im(z));
    Complex(real_sinh(re(z)) * real_cosh(re(z)) / over, sine(im(z)) * cosine(im(z)) / over)
  }

/// The sine.
pub fn sin(z: Complex) -> Complex = turned_back(sinh(turned(z)))

/// The cosine.
pub fn cos(z: Complex) -> Complex = cosh(turned(z))

/// The tangent.
pub fn tan(z: Complex) -> Complex = turned_back(tanh(turned(z)))

/// The inverse sine, its real part in `[-pi/2, pi/2]`. It is cut along the real axis outside
/// `-1..=1`.
pub fn asin(z: Complex) -> Complex = {
  let below = sqrt(Complex(1.0 - re(z), -im(z)));
  let above = sqrt(Complex(1.0 + re(z), im(z)));
  Complex(
    atan2(re(z), re(below) * re(above) - im(below) * im(above)),
    real_asinh(re(below) * im(above) - im(below) * re(above)),
  )
}

/// The inverse cosine, its real part in `[0, pi]`. It is cut along the real axis outside
/// `-1..=1`.
pub fn acos(z: Complex) -> Complex = {
  let below = sqrt(Complex(1.0 - re(z), -im(z)));
  let above = sqrt(Complex(1.0 + re(z), im(z)));
  Complex(
    2.0 * atan2(re(below), re(above)),
    real_asinh(re(above) * im(below) - im(above) * re(below)),
  )
}

/// The inverse tangent, its real part in `[-pi/2, pi/2]`. It is cut along the imaginary axis
/// outside `-i..=i`.
pub fn atan(z: Complex) -> Complex = turned_back(atanh(turned(z)))

/// The inverse hyperbolic sine, its imaginary part in `[-pi/2, pi/2]`. It is cut along the
/// imaginary axis outside `-i..=i`.
pub fn asinh(z: Complex) -> Complex = turned_back(asin(turned(z)))

/// The inverse hyperbolic cosine, its real part not negative and its imaginary part in
/// `[-pi, pi]`. It is cut along the real axis below `1`.
pub fn acosh(z: Complex) -> Complex = {
  let below = sqrt(Complex(re(z) - 1.0, im(z)));
  let above = sqrt(Complex(re(z) + 1.0, im(z)));
  Complex(
    real_asinh(re(below) * re(above) + im(below) * im(above)),
    2.0 * atan2(im(below), re(above)),
  )
}

/// The inverse hyperbolic tangent, its imaginary part in `[-pi/2, pi/2]`. It is cut along the
/// real axis outside `-1..=1`, and is an infinity at `1` and at `-1`.
pub fn atanh(z: Complex) -> Complex = {
  let x = re(z);
  let y = im(z);
  let a = float::abs(x);
  Complex(
    copy_sign(0.25 * ln_one_plus(4.0 * a / ((1.0 - a) * (1.0 - a) + y * y)), x),
    0.5 * atan2(2.0 * y, (1.0 - x) * (1.0 + x) - y * y),
  )
}

// --- Text -------------------------------------------------------------------

/// The two parts as `float_to_string` writes each, the imaginary one signed and before an `i`:
/// `1.5+2.0i`, `-0.0-1e-7i`, `NaN+Infinityi`.
pub fn to_string(z: Complex) -> String =
  float_to_string(re(z)) ++ (if float::is_sign_negative(im(z)) { "-" } else { "+" })
    ++ float_to_string(float::abs(im(z)))
    ++ "i"

/// The number a text names, as `to_string` writes one: a real part, a sign, an imaginary part and
/// an `i`, each part a `Float` as `float_of_string` reads one, or `Infinity` or `NaN`. `None` for
/// any other text.
pub fn parse(text: String) -> Option<Complex> = {
  let chars = string_chars(text);
  let n = len(chars);
  let split = fold(range(1, n), 0, |found: Int, k: Int|
    if is_sign(at_or(chars, k, ' ')) && !is_exponent_mark(at_or(chars, k - 1, ' ')) { k }
    else { found });
  if split == 0 || at_or(chars, n - 1, ' ') != 'i' { None } else {
    match part(chars, 0, split) {
      None -> None,
      Some(real) -> match part(chars, split + 1, n - 1) {
        None -> None,
        Some(imaginary) -> if is_sign(at_or(chars, split + 1, ' ')) { None }
        else if at_or(chars, split, ' ') == '-' { Some(Complex(real, -imaginary)) }
        else { Some(Complex(real, imaginary)) },
      },
    }
  }
}

// --- The parts --------------------------------------------------------------

/// `i * z`, exactly: a quarter turn, which moves a function's argument between the trigonometric
/// function and the hyperbolic one.
fn turned(z: Complex) -> Complex = Complex(-im(z), re(z))

/// `-i * z`, exactly: the quarter turn back.
fn turned_back(z: Complex) -> Complex = Complex(im(z), -re(z))

/// The square root of a finite number that is not zero and whose parts are far below overflow:
/// the larger of the root's parts is found first, with no cancellation, and the other from it.
fn finite_root(x: Float, y: Float) -> Complex =
  if x >= 0.0 {
    let t = square_root((x + hypot(x, y)) * 0.5);
    Complex(t, y / (2.0 * t))
  } else {
    let t = square_root((hypot(x, y) - x) * 0.5);
    Complex(float::abs(y) / (2.0 * t), copy_sign(t, y))
  }

/// The hyperbolic sine of a real number: a series near zero, where the exponentials' difference
/// would cancel, and half an exponential squared past where `e^x` overflows and the sine does not.
fn real_sinh(x: Float) -> Float = {
  let a = float::abs(x);
  let x2 = x * x;
  if a < 0.5 {
    x
      * (1.0
      + x2 / 6.0
      * (1.0
      + x2 / 20.0
      * (1.0
      + x2 / 42.0
      * (1.0 + x2 / 72.0 * (1.0 + x2 / 110.0 * (1.0 + x2 / 156.0 * (1.0 + x2 / 210.0)))))))
  } else if a > 709.0 { copy_sign(0.5 * exponential(0.5 * a) * exponential(0.5 * a), x) }
  else { copy_sign(0.5 * (exponential(a) - 1.0 / exponential(a)), x) }
}

/// The hyperbolic cosine of a real number.
fn real_cosh(x: Float) -> Float = {
  let a = float::abs(x);
  if a > 709.0 { 0.5 * exponential(0.5 * a) * exponential(0.5 * a) }
  else { 0.5 * (exponential(a) + 1.0 / exponential(a)) }
}

/// `ln(1 + u)` without the rounding `1 + u` loses for a small `u`: the logarithm of the sum,
/// corrected by how far the sum is from what was meant.
fn ln_one_plus(u: Float) -> Float = {
  let sum = 1.0 + u;
  if sum == 1.0 { u } else { natural_log(sum) * (u / (sum - 1.0)) }
}

/// The inverse hyperbolic sine of a real number, with the sign of a zero kept.
fn real_asinh(t: Float) -> Float = {
  let a = float::abs(t);
  if a > 1e150 { copy_sign(natural_log(a) + natural_log(2.0), t) }
  else { copy_sign(ln_one_plus(a + a * a / (1.0 + square_root(a * a + 1.0))), t) }
}

fn is_sign(c: Char) -> Bool = c == '+' || c == '-'

fn is_exponent_mark(c: Char) -> Bool = c == 'e' || c == 'E'

/// The `Float` the characters from `from` up to `to` spell.
fn part(chars: List<Char>, from: Int, to: Int) -> Option<Float> = {
  let text = string_of_chars(slice(chars, from, to));
  if text == "NaN" { Some(float::nan()) }
  else if text == "Infinity" { Some(float::infinity()) }
  else if text == "-Infinity" { Some(float::neg_infinity()) }
  else if from >= to { None }
  else { float_of_string(text) }
}

// --- Tests ------------------------------------------------------------------

/// Whether two numbers are the same in every bit, or each part is a `NaN` where the other's is.
fn same(a: Complex, b: Complex) -> Bool = same_part(re(a), re(b)) && same_part(im(a), im(b))

fn same_part(a: Float, b: Float) -> Bool =
  bits_of_float(a) == bits_of_float(b) || (float::is_nan(a) && float::is_nan(b))

/// Whether a part is the published one: a `NaN` for a `NaN`, the same bits for a zero or an
/// infinity, whose sign is the point of a branch cut, and within a few roundings otherwise.
fn published_part(got: Float, want: Float) -> Bool =
  if float::is_nan(want) { float::is_nan(got) }
  else if want == 0.0 || float::is_infinite(want) { bits_of_float(got) == bits_of_float(want) }
  else { float::is_close(got, want, 1e-12, 0.0) }

test "a number is its two parts, and the constants are what they say" {
  let z = of_parts(1.5, -2.0);
  assert_eq(re(z), 1.5);
  assert_eq(im(z), -2.0);
  assert_eq(of_float(2.5), Complex(2.5, 0.0));
  assert_eq(of_int(-3), Complex(-3.0, 0.0));
  assert_eq(mul(i(), i()), Complex(-1.0, 0.0));
  assert_eq(zero() + one(), one());
  assert(is_finite(z) && !is_nan(z) && !is_infinite(z));
  assert(
    is_nan(Complex(float::nan(), 1.0)) && is_infinite(Complex(float::nan(), float::infinity())),
  );
  assert(!is_finite(Complex(1.0, float::neg_infinity())))
}

test "the operators are the functions, and equality is IEEE's on each part" {
  let a = Complex(1.0, 2.0);
  let b = Complex(3.0, -1.0);
  assert_eq(a + b, Complex(4.0, 1.0));
  assert_eq(a - b, Complex(-2.0, 3.0));
  assert_eq(a * b, Complex(5.0, 5.0));
  assert_eq(-a, Complex(-1.0, -2.0));
  assert_eq(conj(a), Complex(1.0, -2.0));
  assert_eq(scale(a, 2.0), Complex(2.0, 4.0));
  assert(Complex(0.0, -0.0) == Complex(-0.0, 0.0));
  assert(Complex(float::nan(), 0.0) != Complex(float::nan(), 0.0));
  assert(float::is_sign_negative(im(conj(zero()))) && float::is_sign_negative(re(-zero())))
}

test "division is Smith's: exact where it can be, and no overflow on the way to a quotient that fits" {
  assert(is_close(div(Complex(5.0, 5.0), Complex(3.0, -1.0)), Complex(1.0, 2.0), 1e-15, 0.0));
  assert_eq(div(Complex(5.0, 5.0), Complex(1.0, 2.0)), Complex(3.0, -1.0));
  assert_eq(div(Complex(1e300, 1e300), Complex(1e300, 1e300)), Complex(1.0, 0.0));
  assert_eq(div(Complex(1e300, -1e300), Complex(2e-300, 2e300)), Complex(-0.5, -0.5));
  assert_eq(reciprocal(i()), Complex(0.0, -1.0));
  assert_eq(div(Complex(1.0, -1.0), zero()), Complex(float::infinity(), float::neg_infinity()));
  assert(is_nan(div(zero(), zero())))
}

test "the distance from zero does not overflow, and the angle reads the sign of a zero" {
  assert_eq(abs(Complex(3.0, -4.0)), 5.0);
  assert(float::is_close(abs(Complex(3e200, 4e200)), 5e200, 1e-15, 0.0));
  assert_eq(abs(Complex(float::neg_infinity(), float::nan())), float::infinity());
  assert_eq(arg(Complex(-1.0, 0.0)), float::pi());
  assert_eq(arg(Complex(-1.0, -0.0)), -float::pi());
  assert_eq(arg(Complex(0.0, 1.0)), float::pi() / 2.0);
  assert_eq(arg(one()), 0.0);
  assert_eq(to_polar(Complex(0.0, -2.0)), { r: 2.0, theta: -float::pi() / 2.0 });
  assert(is_close(of_polar(2.0, float::pi() / 2.0), Complex(0.0, 2.0), 1e-15, 0.0));
  assert_eq(of_polar(3.0, 0.0), Complex(3.0, 0.0))
}

type Point = { f: String, re: Int, im: Int, want_re: Int, want_im: Int }

/// The function a published point names.
fn applied(name: String, z: Complex) -> Complex / {abort.raise} =
  if name == "sqrt" { sqrt(z) }
  else if name == "ln" { ln(z) }
  else if name == "exp" { exp(z) }
  else if name == "sin" { sin(z) }
  else if name == "cos" { cos(z) }
  else if name == "tan" { tan(z) }
  else if name == "sinh" { sinh(z) }
  else if name == "cosh" { cosh(z) }
  else if name == "tanh" { tanh(z) }
  else if name == "asin" { asin(z) }
  else if name == "acos" { acos(z) }
  else if name == "atan" { atan(z) }
  else if name == "asinh" { asinh(z) }
  else if name == "acosh" { acosh(z) }
  else if name == "atanh" { atanh(z) }
  else { panic("no such function") }

/// What Python's `cmath` answers, which follows C99's Annex G, at points on each side of every
/// branch cut, at the four zeros, in each quadrant and, for `sqrt`, `ln` and `exp`, at the
/// infinities and `NaN`s: each part by its IEEE-754 bits, the sign of a zero among them.
fn published() -> List<Point> =
  [
    {
      f: "sqrt",
      re: 0xC010000000000000,
      im: 0x0000000000000000,
      want_re: 0x0000000000000000,
      want_im: 0x4000000000000000,
    },
    {
      f: "sqrt",
      re: 0xC010000000000000,
      im: 0x8000000000000000,
      want_re: 0x0000000000000000,
      want_im: 0xC000000000000000,
    },
    {
      f: "sqrt",
      re: 0xBFF0000000000000,
      im: 0x0000000000000000,
      want_re: 0x0000000000000000,
      want_im: 0x3FF0000000000000,
    },
    {
      f: "sqrt",
      re: 0xBFF0000000000000,
      im: 0x8000000000000000,
      want_re: 0x0000000000000000,
      want_im: 0xBFF0000000000000,
    },
    {
      f: "sqrt",
      re: 0xC010000000000000,
      im: 0x01A56E1FC2F8F359,
      want_re: 0x01856E1FC2F8F359,
      want_im: 0x4000000000000000,
    },
    {
      f: "sqrt",
      re: 0xC010000000000000,
      im: 0x81A56E1FC2F8F359,
      want_re: 0x01856E1FC2F8F359,
      want_im: 0xC000000000000000,
    },
    {
      f: "sqrt",
      re: 0x0000000000000000,
      im: 0x0000000000000000,
      want_re: 0x0000000000000000,
      want_im: 0x0000000000000000,
    },
    {
      f: "sqrt",
      re: 0x8000000000000000,
      im: 0x0000000000000000,
      want_re: 0x0000000000000000,
      want_im: 0x0000000000000000,
    },
    {
      f: "sqrt",
      re: 0x0000000000000000,
      im: 0x8000000000000000,
      want_re: 0x0000000000000000,
      want_im: 0x8000000000000000,
    },
    {
      f: "sqrt",
      re: 0x8000000000000000,
      im: 0x8000000000000000,
      want_re: 0x0000000000000000,
      want_im: 0x8000000000000000,
    },
