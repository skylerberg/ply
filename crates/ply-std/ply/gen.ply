//! Generators: how a test draws the values it checks a property at.
//!
//! A `Gen<a>` makes a value from a sequence of draws, each a whole number below a bound it names.
//! Fresh, the draws come from a stream its root and its key name, so a value is a function of its
//! root, its key and its size on every machine. Every draw a generator takes is recorded, and a
//! generator handed a record back answers from it instead of the stream: the same record makes the
//! same value, and a record made shorter or lower makes a smaller value the same generator could
//! have drawn. That is how `check` walks a value a property fails at down without leaving what the
//! generator draws, whatever `map`, `and_then` and `such_that` it is built of. Past the end of a
//! record every draw is `0`, so a generator's least draws should make its simplest value.
//!
//! `check` asserts a property of what a generator draws. It is a test's evidence and no proof: a
//! property that must hold of every value is a `law`, which `ply prove` proves or refuses. A
//! generator may give up, where `such_that` has spent its budget or there was nothing to choose
//! from: it answers no value, and `check` draws its next case.
//!
//! This module imports no other, so that any module may import it to test itself.

/// What a generator draws from, and what it has drawn.
pub type Draws = new {
  /// The stream a fresh draw comes from: thirty-two bytes, each draw the digest of the last.
  stream: Bytes,
  /// A record answered from in place of the stream, each draw clamped below its bound.
  replay: Option<List<Int>>,
  /// How large a value may grow: `check` hands a size that rises over its run, to 63.
  size: Int,
  /// Every draw taken, in order.
  taken: List<Int>,
  /// How many values `such_that` turned away.
  discards: Int,
}

/// A generator's answer: the value, or `None` where it gave up, and the draws after it.
pub type Drawn<a> = { value: Option<a>, draws: Draws }

/// How a value of `a` is drawn.
pub type Gen<a> = | Gen((Draws) -> Drawn<a> / {abort.raise})

/// One run of a generator: its value, or `None` where it gave up, the draws it took, which
/// replayed make the value again, and how many values `such_that` turned away on the way.
pub type Sample<a> = { value: Option<a>, record: List<Int>, discards: Int }

/// What `g` draws from the stream `key` names under `root`, at `size`; or from `replay`, when
/// there is one, with the stream unread.
pub fn sample<a>(
  g: Gen<a>,
  root: Int,
  key: Bytes,
  size: Int,
  replay: Option<List<Int>>,
) -> Sample<a> / {abort.raise} = {
  let out = run(g, {
    stream: Bytes::concat_all([
      b"ply.gen.stream.1 ",
      Bytes::of_string(root.to_string()),
      b" ",
      key,
    ]).blake3(
    ),
    replay: replay,
    size: size,
    taken: [],
    discards: 0,
  });
  { value: out.value, record: out.draws.taken, discards: out.draws.discards }
}

/// `g` over `draws`: what a combinator of one's own is written with.
pub fn run<a>(g: Gen<a>, draws: Draws) -> Drawn<a> / {abort.raise} = match g { Gen(f) -> f(draws) }

fn gave_up<a>(draws: Draws) -> Drawn<a> = { value: None, draws: draws }

/// The draw at `i` of a record, which is zero past its end.
fn draw_at(record: List<Int>, i: Int) -> Int = match record.at(i) { Some(v) -> v, None -> 0 }

/// One draw below `bound`, which is at least one: from the stream, the low sixty-three bits of its
/// next digest, folded into the bound.
fn next(draws: Draws, bound: Int) -> { value: Int, draws: Draws } / {abort.raise} =
  match draws.replay {
    Some(record) -> {
      let v = min(max(draw_at(record, draws.taken.len()), 0), bound - 1);
      { value: v, draws: { ..draws, taken: draws.taken.push(v) } }
    },
    None -> {
      let digest = draws.stream.blake3();
      let low = Int::of_u32(digest.u32_le(0));
      let high = Int::of_u32(digest.u32_le(4)) & 0x7FFF_FFFF;
      let v = (high << 32 | low) % bound;
      { value: v, draws: { ..draws, stream: digest, taken: draws.taken.push(v) } }
    },
  }

/// Always `x`, with nothing drawn.
pub fn constant<a>(x: a) -> Gen<a> = Gen(|d: Draws| { value: Some(x), draws: d })

/// A whole number from `0` up to but not including `bound`: one draw, and what every other
/// generator is made of. Gives up for a bound below one.
pub fn below(bound: Int) -> Gen<Int> =
  Gen(|d: Draws|
    if bound < 1 { gave_up(d) } else {
      let step = next(d, bound);
      { value: Some(step.value), draws: step.draws }
    })

/// A whole number from `low` to `high`, both included, shrinking toward `low`. Gives up where
/// `high` is below `low`.
pub fn int_between(low: Int, high: Int) -> Gen<Int> =
  if high < low { Gen(|d: Draws| gave_up(d)) } else {
    match checked_sub(high, low) {
      Some(span) -> if span < max_bound() { map(below(span + 1), |k: Int| low + k) }
      else { wide_between(low, high) },
      None -> wide_between(low, high),
    }
  }

/// The largest bound one draw takes: a stream's draw is sixty-three bits.
fn max_bound() -> Int = 0x7FFF_FFFF_FFFF_FFFF

/// A span past what one draw covers: two draws make sixty-four bits, folded into the span.
fn wide_between(low: Int, high: Int) -> Gen<Int> =
  map2(below(4294967296), below(4294967296), |hi: Int, lo: Int| {
    let span = I128::of_int(high) - I128::of_int(low) + 1i128;
    let offset = (I128::of_int(hi) * 4294967296i128 + I128::of_int(lo)) % span;
    Int::of_i128(I128::of_int(low) + offset)
  })

/// A whole number of either sign that grows with the size, shrinking toward `0`.
pub fn int() -> Gen<Int> =
  sized(|size: Int|
    map2(below((1 << 8 + min(max(size, 0), 54)) + 1), below(2), |magnitude: Int, sign: Int|
      if sign == 1 { 0 - magnitude } else { magnitude }))

/// `false` or `true`, shrinking toward `false`.
pub fn bool() -> Gen<Bool> = map(below(2), |k: Int| k == 1)

/// One of `xs`, shrinking toward the first. Gives up for an empty list.
pub fn elements<a>(xs: List<a>) -> Gen<a> =
  Gen(|d: Draws|
    if xs.len() == 0 { gave_up(d) } else {
      let step = next(d, xs.len());
      { value: xs.at(step.value), draws: step.draws }
    })

/// The first `n` of `xs`, which is all of it where it holds fewer.
fn leading<a>(xs: List<a>, n: Int) -> List<a> =
  range(0, min(n, xs.len())).fold([], |acc: List<a>, i: Int|
    match xs.at(i) { Some(x) -> acc.push(x), None -> acc })

/// What one of `gs` draws, shrinking toward the first. Gives up for an empty list.
pub fn one_of<a>(gs: List<Gen<a>>) -> Gen<a> =
  Gen(|d: Draws|
    if gs.len() == 0 { gave_up(d) } else {
      let step = next(d, gs.len());
      match gs.at(step.value) { Some(g) -> run(g, step.draws), None -> gave_up(step.draws) }
    })

/// `Some` of what `g` draws, or `None`, shrinking toward `None`.
pub fn option_of<a>(g: Gen<a>) -> Gen<Option<a>> =
  and_then(below(2), |k: Int| if k == 0 { constant(None) } else { map(g, |x: a| Some(x)) })

/// A list of what `g` draws, of at most `most` elements and no more than the size, shrinking
/// toward the empty list.
pub fn list_of<a>(g: Gen<a>, most: Int) -> Gen<List<a>> =
  Gen(|d: Draws| {
    let length = next(d, 1 + max(0, min(most, d.size)));
    several(g, length.value, length.draws)
  })

/// A list of exactly `n` values `g` draws.
pub fn list_of_length<a>(g: Gen<a>, n: Int) -> Gen<List<a>> = Gen(|d: Draws| several(g, n, d))

fn several<a>(g: Gen<a>, n: Int, draws: Draws) -> Drawn<List<a>> / {abort.raise} = {
  let start: Drawn<List<a>> = { value: Some([]), draws: draws };
  range(0, n).fold(start, |acc: Drawn<List<a>>, _i: Int|
    match acc.value {
      None -> acc,
      Some(xs) -> {
        let x = run(g, acc.draws);
        { value: match x.value { Some(v) -> Some(xs.push(v)), None -> None }, draws: x.draws }
      },
    })
}

/// Exactly `n` bytes, each shrinking toward zero.
pub fn bytes_of(n: Int) -> Gen<Bytes> =
  map(list_of_length(below(256), n), |octets: List<Int>|
    octets.fold(b"", |acc: Bytes, b: Int| acc.concat(byte_of_int(b))))

/// What `g` draws, through `f`.
pub fn map<a, b>(g: Gen<a>, f: keep (a) -> b / {abort.raise}) -> Gen<b> =
  Gen(|d: Draws| {
    let x = run(g, d);
    { value: match x.value { Some(v) -> Some(f(v)), None -> None }, draws: x.draws }
  })

/// What `ga` and then `gb` draw, through `f`.
pub fn map2<a, b, c>(ga: Gen<a>, gb: Gen<b>, f: keep (a, b) -> c / {abort.raise}) -> Gen<c> =
  and_then(ga, |x: a| map(gb, |y: b| f(x, y)))

/// What `ga`, `gb` and then `gc` draw, through `f`.
pub fn map3<a, b, c, d>(
  ga: Gen<a>,
  gb: Gen<b>,
  gc: Gen<c>,
  f: keep (a, b, c) -> d / {abort.raise},
) -> Gen<d> = and_then(ga, |x: a| map2(gb, gc, |y: b, z: c| f(x, y, z)))

/// What `ga`, `gb`, `gc` and then `gd` draw, through `f`.
pub fn map4<a, b, c, d, r>(
  ga: Gen<a>,
  gb: Gen<b>,
  gc: Gen<c>,
  gd: Gen<d>,
  f: keep (a, b, c, d) -> r / {abort.raise},
) -> Gen<r> = and_then(ga, |x: a| map3(gb, gc, gd, |y: b, z: c, w: d| f(x, y, z, w)))

/// What the generator `f` makes of what `g` drew draws next: a value that decides how the rest
/// is drawn.
pub fn and_then<a, b>(g: Gen<a>, f: keep (a) -> Gen<b> / {abort.raise}) -> Gen<b> =
  Gen(|d: Draws| {
    let x = run(g, d);
    match x.value { Some(v) -> run(f(v), x.draws), None -> gave_up(x.draws) }
  })

/// The generator `f` makes of the size, for one that grows with it in its own way.
pub fn sized<a>(f: keep (Int) -> Gen<a> / {abort.raise}) -> Gen<a> =
  Gen(|d: Draws| run(f(d.size), d))

/// What `g` draws that `keep` admits: it draws again for each value turned away, counting it, and
/// gives up after `budget` tries.
pub fn such_that<a>(g: Gen<a>, keep: keep (a) -> Bool / {abort.raise}, budget: Int) -> Gen<a> =
  Gen(|d: Draws|
    iterate({ draws: d, left: budget }, max(budget, 0) + 1, |s: { draws: Draws, left: Int }|
      if s.left <= 0 { Stop(gave_up(s.draws)) } else {
        let x = run(g, s.draws);
        match x.value {
          None -> Stop(x),
          Some(v) -> if keep(v) { Stop(x) } else {
            Continue({ draws: { ..x.draws, discards: x.draws.discards + 1 }, left: s.left - 1 })
          },
        }
      }))

// --- A value of each built-in type -------------------------------------------

fn edge_ints() -> List<Int> = [0, 1, 0 - 1, 0 - 9223372036854775807 - 1, 9223372036854775807]

/// Any whole number: about one draw in six is zero, one, minus one, the least or the greatest,
/// where checked arithmetic breaks, and the rest are as `int` draws them. Shrinks toward `0`.
pub fn any_int() -> Gen<Int> =
  and_then(below(32), |k: Int| if k < 27 { int() } else { constant(draw_at(edge_ints(), k - 27)) })

/// How many elements a collection holds: the lesser of two draws, so most are short, and at most
/// sixteen, fewer at a small size.
fn length() -> Gen<Int> =
  sized(|size: Int| {
    let most = min(16, 1 + max(size, 0) / 4);
    map2(below(most + 1), below(most + 1), |one: Int, other: Int| min(one, other))
  })

/// A list of what `g` draws, of at most sixteen elements and fewer at a small size, shrinking
/// toward the empty list.
pub fn list<a>(g: Gen<a>) -> Gen<List<a>> = and_then(length(), |n: Int| list_of_length(g, n))

/// A map of the keys `gk` draws to the values `gv` draws, of at most eight entries, shrinking
/// toward the empty map.
pub fn map_of<k, v>(gk: Gen<k>, gv: Gen<v>) -> Gen<Map<k, v>>
  where derivable(ord, k)
=
  map(
    list(map2(gk, gv, |key: k, value: v| { key: key, value: value })),
    |entries: List<{ key: k, value: v }>| Map::of_entries(leading(entries, 8)),
  )

/// A string of the letters `a` to `p`, of at most sixteen, shrinking toward the empty string.
pub fn text() -> Gen<String> =
  map(list(below(16)), |letters: List<Int>|
    letters.fold("", |acc: String, i: Int| acc ++ "abcdefghijklmnop".slice(i, i + 1)))

/// At most sixteen bytes, each shrinking toward zero and the whole toward none.
pub fn bytes() -> Gen<Bytes> =
  map(list(below(256)), |octets: List<Int>|
    octets.fold(b"", |acc: Bytes, b: Int| acc.concat(byte_of_int(b))))

/// The zero, a line break, a space, a quote, one outside ASCII, one outside the Basic Multilingual
/// Plane and the last there is.
fn edge_chars() -> List<Char> = ['\0', '\n', ' ', '\'', '\u{e9}', '\u{1F600}', '\u{10FFFF}']

/// A character: mostly one of the letters `text` draws, and one draw in eight a character a reader
/// of text trips on. Shrinks toward `a`.
pub fn char() -> Gen<Char> =
  and_then(below(8), |k: Int|
    if k < 7 { map(below(16), |i: Int| match Char::of_int(97 + i) { Some(c) -> c, None -> 'a' }) }
    else { elements(edge_chars()) })

/// Not a number, minus zero, one, minus one, the infinities and the greatest, by their bits.
fn edge_floats() -> List<Float> =
  [
    Float::of_bits(0x7FF8_0000_0000_0000),
    Float::of_bits(0x8000_0000_0000_0000),
    1.0,
    0.0 - 1.0,
    Float::of_bits(0x7FF0_0000_0000_0000),
    Float::of_bits(0xFFF0_0000_0000_0000),
    Float::of_bits(0x7FEF_FFFF_FFFF_FFFF),
  ]

/// A float: one draw in four is not a number, minus zero, one, minus one, an infinity or the
/// greatest, and the rest a whole number below `2^53` scaled by a power of two that grows with the
/// size, of either sign. Shrinks toward `0.0`.
pub fn float() -> Gen<Float> =
  and_then(below(4), |k: Int|
    if k == 3 { elements(edge_floats()) } else {
      sized(|size: Int|
        map3(
          below(9007199254740992),
          below(1 + min(max(size, 0), 60)),
          below(2),
          |mantissa: Int, exponent: Int, sign: Int| {
            // Two to the `exponent - 30`, by its bits.
            let scale = Float::of_bits(exponent - 30 + 1023 << 52);
            let magnitude = Float::of_int(mantissa) * scale;
            if sign == 1 { 0.0 - magnitude } else { magnitude }
          },
        ))
    })

/// One, minus one, a zero of scale two, the greatest and the least.
fn edge_decimals() -> List<Decimal> / {abort.raise} = {
  let greatest = match Decimal::of_string("79228162514264337593543950335") {
    Some(d) -> d,
    None -> 0m,
  };
  [1m, 0m - 1m, Decimal::div(0m, 100m, 2, Down), greatest, 0m - greatest]
}

/// A decimal: one draw in five is one, minus one, a zero of scale two, the greatest or the least,
/// and the rest a whole number that grows with the size, at a scale of up to six. Shrinks toward
/// `0`.
pub fn decimal() -> Gen<Decimal> =
  and_then(below(5), |k: Int|
    if k < 4 {
      map2(int(), below(7), |mantissa: Int, scale: Int| {
        let unit = range(0, scale).fold(1, |power: Int, _place: Int| power * 10);
        Decimal::of_int(mantissa).div(Decimal::of_int(unit), scale, Down)
      })
    } else { elements(edge_decimals()) })

/// Any `U32`, shrinking toward `0`.
pub fn u32() -> Gen<U32> = map(below(4294967296), |n: Int| U32::of_int(n))

/// Any `U64`, its two halves drawn apart, shrinking toward `0`.
pub fn u64() -> Gen<U64> =
  map2(below(4294967296), below(4294967296), |high: Int, low: Int|
    U64::of_int(high) << 32 | U64::of_int(low))

/// `Ok` of what `ok` draws or `Err` of what `err` draws, shrinking toward `Ok`.
pub fn result_of<a, b>(ok: Gen<a>, err: Gen<b>) -> Gen<Result<a, b>> =
  and_then(below(2), |k: Int| if k == 0 { map(ok, |x: a| Ok(x)) } else { map(err, |x: b| Err(x)) })

// --- Checking a property -----------------------------------------------------

/// How many records a walk down from a failing value replays.
fn walk_budget() -> Int = 2000

/// What a property came to at one value.
type Tried = | Held | Failed | Raised(String)

/// A value a property did not hold at, the draws that made it and the size it was drawn at.
type Found<a> = { value: a, record: List<Int>, size: Int, why: Tried }

fn tried<a | e>(holds: (a) -> Bool / {abort.raise | e}, x: a) -> Tried / e =
  handle { if holds(x) { Held } else { Failed } } with { abort.raise(message) -> Raised(message) }

/// What a property came to over the values a generator drew.
pub type Checked<a> =
  | Holds
  /// The least value found that the property answers `false` at.
  | FailsAt(a)
  /// The least value found that the property raises at, and what it raised.
  | RaisesAt(a, String)
  /// No case drew a value: the generator gave up every time.
  | NothingDrawn

/// What `holds` comes to over the values `g` draws in `cases` cases, each from a stream of its
/// own and at a size that rises from nothing at the first to 63 at the last, so a run of few
/// cases still draws large values. The first value it answers `false` at, or raises at, is walked
/// down to a smaller one `g` could have drawn that ends the same way.
pub fn checked<a | e>(
  g: Gen<a>,
  holds: (a) -> Bool / {abort.raise | e},
  cases: Int = 25,
) -> Checked<a> / {abort.raise | e} = {
  let start: { drawn: Int, found: Option<Found<a>> } = { drawn: 0, found: None };
  let ran = range(0, cases).fold(
    start,
    |acc: { drawn: Int, found: Option<Found<a>> }, case: Int|
      match acc.found {
        Some(_) -> acc,
        None -> {
          let size = if cases <= 1 { 0 } else { case * 63 / (cases - 1) };
          let drew = sample(g, case, b"check", size, None);
          match drew.value {
            None -> acc,
            Some(x) -> match tried(holds, x) {
              Held -> { ..acc, drawn: acc.drawn + 1 },
              why ->
                {
                  drawn: acc.drawn + 1,
                  found: Some({ value: x, record: drew.record, size: size, why: why }),
                },
            },
          }
        },
      },
  );
  match ran.found {
    None -> if ran.drawn > 0 { Holds } else { NothingDrawn },
    Some(first) -> {
      let least = walked(g, holds, first);
      match least.why {
        Raised(message) -> RaisesAt(least.value, message),
        _ -> FailsAt(least.value),
      }
    },
  }
}

/// Asserts `holds` of every value `g` draws, as `checked` draws them: the test fails naming the
/// least value found that `holds` answers `false` at or raises at, and where `g` drew no value.
pub fn check<a | e>(
  g: Gen<a>,
  holds: (a) -> Bool / {abort.raise | e},
  cases: Int = 25,
) -> Unit / {abort.raise | e} = assert_eq(checked(g, holds, cases: cases), Holds)

/// `check` of a property of two values, drawn one after the other.
pub fn check2<a, b | e>(
  ga: Gen<a>,
  gb: Gen<b>,
  holds: (a, b) -> Bool / {abort.raise | e},
  cases: Int = 25,
) -> Unit / {abort.raise | e} =
  check(map2(ga, gb, |x: a, y: b| (x, y)), |p: (a, b)| holds(p._0, p._1), cases: cases)

/// `check` of a property of three values.
pub fn check3<a, b, c | e>(
  ga: Gen<a>,
  gb: Gen<b>,
  gc: Gen<c>,
  holds: (a, b, c) -> Bool / {abort.raise | e},
  cases: Int = 25,
) -> Unit / {abort.raise | e} =
  check(
    map3(ga, gb, gc, |x: a, y: b, z: c| (x, y, z)),
    |p: (a, b, c)| holds(p._0, p._1, p._2),
    cases: cases,
  )

/// `check` of a property of four values.
pub fn check4<a, b, c, d | e>(
  ga: Gen<a>,
  gb: Gen<b>,
  gc: Gen<c>,
  gd: Gen<d>,
  holds: (a, b, c, d) -> Bool / {abort.raise | e},
  cases: Int = 25,
) -> Unit / {abort.raise | e} =
  check(
    map4(ga, gb, gc, gd, |x: a, y: b, z: c, w: d| (x, y, z, w)),
    |p: (a, b, c, d)| holds(p._0, p._1, p._2, p._3),
    cases: cases,
  )

/// The record `k` steps into the ways one is made smaller: half of it, all but its last draw, and
/// then each draw in turn as zero, as its half and as one less. `None` past the last of them.
fn lowered(record: List<Int>, k: Int) -> Option<List<Int>> =
  if k == 0 { Some(leading(record, record.len() / 2)) }
  else if k == 1 { Some(leading(record, record.len() - 1)) } else {
    let i = (k - 2) / 3;
    match record.at(i) {
      None -> None,
      Some(v) -> {
        let way = (k - 2) % 3;
        let to = if way == 0 { 0 } else if way == 1 { v / 2 } else { max(v - 1, 0) };
        Some(
          range(0, record.len()).fold([], |acc: List<Int>, j: Int|
            acc.push(if j == i { to } else { draw_at(record, j) })),
        )
      },
    }
  }

/// Whether `one` comes before `other`: it is shorter, or as long and lower at the first draw they
/// differ at.
fn before(one: List<Int>, other: List<Int>) -> Bool =
  if one.len() != other.len() { one.len() < other.len() } else {
    range(0, one.len()).fold(None, |decided: Option<Bool>, i: Int|
        match decided {
          Some(_) -> decided,
          None -> {
            let x = draw_at(one, i);
            let y = draw_at(other, i);
            if x == y { None } else { Some(x < y) }
          },
        })
      == Some(true)
  }

fn ends_alike(one: Tried, other: Tried) -> Bool =
  match ((one, other)) { (Failed, Failed) -> true, (Raised(_), Raised(_)) -> true, _ -> false }

/// The least value found below `first` that ends as it did, replaying records made smaller until
/// none of the ways to make one smaller is kept, or the budget is spent.
fn walked<a | e>(
  g: Gen<a>,
  holds: (a) -> Bool / {abort.raise | e},
  first: Found<a>,
) -> Found<a> / {abort.raise | e} =
  range(0, walk_budget()).fold(
    { found: first, way: 0 },
    |s: { found: Found<a>, way: Int }, _step: Int|
      match lowered(s.found.record, s.way) {
        None -> s,
        Some(record) -> if record == s.found.record { { ..s, way: s.way + 1 } } else {
          let again = sample(g, 0, b"", s.found.size, Some(record));
          match again.value {
            None -> { ..s, way: s.way + 1 },
            Some(x) -> {
              let why = tried(holds, x);
              if ends_alike(why, s.found.why) && before(again.record, s.found.record) {
                { found: { value: x, record: again.record, size: s.found.size, why: why }, way: 0 }
              } else { { ..s, way: s.way + 1 } }
            },
          }
        },
      },
  ).found

// --- Tests ------------------------------------------------------------------

fn drawn<a>(g: Gen<a>, root: Int, size: Int) -> Sample<a> / {abort.raise} =
  sample(g, root, b"test", size, None)

fn replayed<a>(g: Gen<a>, record: List<Int>) -> Sample<a> / {abort.raise} =
  sample(g, 0, b"", 0, Some(record))

fn pairs() -> Gen<{ small: Int, items: List<Int> }> =
  and_then(int_between(1, 6), |n: Int|
    map(list_of_length(int_between(0 - n, n), n), |items: List<Int>| { small: n, items: items }))

test "a sample's record replayed makes its value again, from the same draws" {
  check2(any_int(), any_int(), |root: Int, size: Int| {
    let first = sample(pairs(), root, b"law", size, None);
    let again = replayed(pairs(), first.record);
    again.value == first.value && again.record == first.record
  })
}

test "a whole number drawn between two bounds is within them" {
  check3(any_int(), any_int(), any_int(), |low: Int, high: Int, root: Int|
    low > high
      || (match sample(int_between(low, high), root, b"law", 0, None).value {
        Some(n) -> low <= n && n <= high,
        None -> false,
      }))
}

test "a list is no longer than its bound or its size" {
  check3(
    int_between(0 - 8, 63),
    int_between(0 - 8, 63),
    any_int(),
    |most: Int, size: Int, root: Int|
      match sample(list_of(bool(), most), root, b"law", size, None).value {
        Some(xs) -> xs.len() <= max(0, most) && xs.len() <= max(0, size),
        None -> false,
      },
  )
}

test "a property that holds of every value drawn holds, and one that fails names the least value it fails at" {
  assert_eq(checked(any_int(), |n: Int| n == n), Holds);
  assert_eq(checked(int_between(0, 1000), |n: Int| n < 10), FailsAt(10));
  let pair = map2(list(int()), int_between(0, 9), |xs: List<Int>, n: Int| (xs, n));
  assert_eq(
    checked(pair, |p: (List<Int>, Int)| p._0.len() < 3 || p._1 < 2),
    FailsAt(([0, 0, 0], 2)),
  )
}

test "a property that raises names the least value it raises at, with what it raised" {
  assert_eq(
    checked(int_between(0, 1000), |n: Int| if n > 4 { panic("past four") } else { true }),
    RaisesAt(5, "past four"),
  )
}

test "a generator that draws no value is no check" {
  let none: Gen<Int> = below(0);
  assert_eq(checked(none, |n: Int| true), NothingDrawn)
}

test "a check that does not hold fails its test, and one that holds does not" {
  let failed = |run: () -> Unit / {abort.raise}|
    handle { run() } with { abort.raise(_) -> true, return _done -> false };
  assert(!failed(|| check(bool(), |b: Bool| b || !b)));
  assert(failed(|| check(bool(), |b: Bool| b)));
  assert(failed(|| check3(bool(), bool(), bool(), |x: Bool, y: Bool, z: Bool| x || y || !z)));
  assert(
    !failed(||
      check4(int(), int(), bool(), text(), |x: Int, y: Int, b: Bool, s: String|
        x + y == y + x && (b || s == s))),
  )
}

test "the built-in generators' least draws make each type's simplest value" {
  assert_eq(replayed(any_int(), []).value, Some(0));
  assert_eq(replayed(list(any_int()), []).value, Some([]));
  assert_eq(replayed(text(), []).value, Some(""));
  assert_eq(replayed(bytes(), []).value, Some(b""));
  assert_eq(replayed(char(), []).value, Some('a'));
  assert_eq(replayed(float(), []).value, Some(0.0));
  assert_eq(replayed(decimal(), []).value, Some(0m));
  assert_eq(replayed(u32(), []).value, Some(0u32));
  assert_eq(replayed(u64(), [1, 2]).value, Some(4294967298u64));
  assert_eq(replayed(result_of(int(), bool()), []).value, Some(Ok(0)));
  assert_eq(replayed(map_of(int(), bool()), []).value, Some(Map::new()))
}

test "any whole number is sometimes an edge, and a collection is never longer than sixteen" {
  let greatest = range(0, 200).fold(false, |seen: Bool, root: Int|
    seen || drawn(any_int(), root, 63).value == Some(9223372036854775807));
  assert(greatest);
  assert(
    range(0, 200).fold(true, |ok: Bool, root: Int|
      ok && (match drawn(text(), root, 63).value { Some(s) -> s.len() <= 16, None -> false })
        && (match drawn(list(bool()), root, 3).value { Some(xs) -> xs.len() <= 1, None -> false })),
  )
}

test "a draw is a function of its root, its key and its size" {
  assert_eq(drawn(pairs(), 7, 20), drawn(pairs(), 7, 20));
  assert(
    range(0, 20).fold(false, |differs: Bool, root: Int|
      differs || drawn(pairs(), root, 20).value != drawn(pairs(), root + 1, 20).value),
  );
  assert(sample(int(), 3, b"a", 30, None) != sample(int(), 3, b"b", 30, None))
}

test "a record replayed makes the value again, and takes the same draws" {
  let all = range(0, 50).fold(true, |ok: Bool, root: Int| {
    let first = drawn(pairs(), root, root);
    let again = replayed(pairs(), first.record);
    ok && again.value == first.value && again.record == first.record
  });
  assert(all)
}

test "past the end of a record every draw is zero, and a draw past its bound is clamped" {
  assert_eq(replayed(pairs(), []).value, Some({ small: 1, items: [0 - 1] }));
  assert_eq(replayed(int_between(10, 20), [99]), { value: Some(20), record: [10], discards: 0 });
  assert_eq(replayed(int_between(10, 20), [0 - 5]).value, Some(10));
  assert_eq(replayed(int(), []).value, Some(0));
  assert_eq(replayed(bool(), []).value, Some(false));
  assert_eq(replayed(list_of(int(), 9), []).value, Some([]));
  assert_eq(replayed(option_of(int()), []).value, Some(None));
  assert_eq(replayed(bytes_of(3), []).value, Some(b"\x00\x00\x00"))
}

test "a bounded draw stays in its bounds, the widest span included" {
  let least = 0 - 9223372036854775807 - 1;
  assert(
    range(0, 200).fold(true, |ok: Bool, root: Int| {
      let narrow = drawn(int_between(0 - 3, 4), root, 10).value;
      let wide = drawn(int_between(least, 9223372036854775807), root, 10).value;
      ok && (match narrow { Some(n) -> n >= 0 - 3 && n <= 4, None -> false }) && wide != None
    }),
  );
  assert_eq(replayed(int_between(least, 9223372036854775807), []).value, Some(least));
  assert_eq(drawn(int_between(5, 4), 0, 10).value, None);
  assert_eq(drawn(below(0), 0, 10).value, None)
}

test "a list is no longer than its bound or the size" {
  assert(
    range(0, 100).fold(true, |ok: Bool, root: Int|
      ok
        && (match drawn(list_of(bool(), 5), root, 40).value {
          Some(xs) -> xs.len() <= 5,
          None -> false,
        })
        && (match drawn(list_of(bool(), 50), root, 3).value {
          Some(xs) -> xs.len() <= 3,
          None -> false,
        })),
  );
  assert_eq(drawn(list_of(bool(), 50), 0, 0).value, Some([]))
}

test "a choice draws each of its options, and none from an empty list" {
  let seen = range(0, 60).fold([], |acc: List<Int>, root: Int|
    match drawn(one_of([constant(1), constant(2), elements([3, 4])]), root, 0).value {
      Some(n) -> if acc.fold(false, |hit: Bool, x: Int| hit || x == n) { acc } else { acc.push(n) },
      None -> acc,
    });
  assert_eq(seen.len(), 4);
  let nothing: List<Int> = [];
  let none: List<Gen<Int>> = [];
  assert_eq(drawn(elements(nothing), 0, 0).value, None);
  assert_eq(drawn(one_of(none), 0, 0).value, None)
}

test "such_that keeps what its predicate admits, counts what it turned away, and gives up at its budget" {
  let even = such_that(int_between(0, 99), |n: Int| n % 2 == 0, 50);
  let run = range(0, 40).fold(
    { ok: true, discards: 0 },
    |acc: { ok: Bool, discards: Int }, root: Int| {
      let s = drawn(even, root, 0);
      {
        ok: acc.ok && (match s.value { Some(n) -> n % 2 == 0, None -> false }),
        discards: acc.discards + s.discards,
      }
    },
  );
  assert(run.ok);
  assert(run.discards > 0);
  let never = drawn(such_that(int_between(0, 99), |n: Int| n > 100, 7), 0, 0);
  assert_eq(never.value, None);
  assert_eq(never.discards, 7);
  // What was turned away is in the record, so a replay turns the same values away.
  let odd = such_that(int_between(0, 9), |n: Int| n % 2 == 1, 20);
  assert_eq(replayed(odd, [4, 2, 7]), { value: Some(7), record: [4, 2, 7], discards: 2 })
}

test "a generator that gives up says so through whatever it is built into" {
  let none: Gen<Int> = below(0);
  assert_eq(drawn(map(none, |n: Int| n + 1), 0, 0).value, None);
  assert_eq(drawn(and_then(none, |n: Int| constant(n)), 0, 0).value, None);
  assert_eq(drawn(list_of_length(none, 2), 0, 0).value, None);
  assert_eq(drawn(list_of_length(none, 0), 0, 0).value, Some([]))
}
