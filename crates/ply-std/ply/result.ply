// `result` — what a program wants over a `Result<a, e>` and the prelude does not carry.
//
// `Result`'s constructors are the prelude's (`Ok`, `Err`) and `?` propagates one. The combinators
// are `result_`-prefixed for the same reason `option`'s are: `map` is a name a program already has.

pub fn result_map<a, b, e | row>(r: Result<a, e>, f: (a) -> b / row) -> Result<b, e> / row bounded =
  match r { Ok(x) -> Ok(f(x)), Err(e) -> Err(e) }

/// The failure mapped and the success left alone, which is how a low-level error becomes the one a
/// caller names.
pub fn result_map_err<a, e, f | row>(
  r: Result<a, e>,
  g: (e) -> f / row,
) -> Result<a, f> / row bounded = match r { Ok(x) -> Ok(x), Err(e) -> Err(g(e)) }

pub fn result_and_then<a, b, e | row>(
  r: Result<a, e>,
  f: (a) -> Result<b, e> / row,
) -> Result<b, e> / row bounded = match r { Ok(x) -> f(x), Err(e) -> Err(e) }

pub fn result_unwrap_or<a, e>(r: Result<a, e>, fallback: a) -> a =
  match r { Ok(x) -> x, Err(_) -> fallback }

/// The value, or the panic `message` names; `message` is the caller's, because only the caller
/// knows why this failure cannot happen here.
pub fn result_expect<a, e>(r: Result<a, e>, message: String) -> a / {abort.raise} =
  match r { Ok(x) -> x, Err(_) -> panic(message) }

pub fn result_ok<a, e>(r: Result<a, e>) -> Option<a> = match r { Ok(x) -> Some(x), Err(_) -> None }

pub fn result_err<a, e>(r: Result<a, e>) -> Option<e> = match r { Ok(_) -> None, Err(e) -> Some(e) }

pub fn result_is_ok<a, e>(r: Result<a, e>) -> Bool = match r { Ok(_) -> true, Err(_) -> false }

pub fn result_is_err<a, e>(r: Result<a, e>) -> Bool = match r { Ok(_) -> false, Err(_) -> true }

/// The success if it is there, and what `fallback` answers otherwise. The fallback only runs when
/// it is needed.
pub fn result_or_else<a, e | row>(
  r: Result<a, e>,
  fallback: (e) -> Result<a, e> / row,
) -> Result<a, e> / row bounded = match r { Ok(x) -> Ok(x), Err(e) -> fallback(e) }

/// The success, or what `fallback` answers for the failure.
pub fn result_unwrap_or_else<a, e | row>(
  r: Result<a, e>,
  fallback: (e) -> a / row,
) -> a / row bounded = match r { Ok(x) -> x, Err(e) -> fallback(e) }

/// `f` of the success, or `fallback` untouched for a failure.
pub fn result_map_or<a, b, e | row>(
  r: Result<a, e>,
  fallback: b,
  f: (a) -> b / row,
) -> b / row bounded = match r { Ok(x) -> f(x), Err(_) -> fallback }

// --- Tests ------------------------------------------------------------------

test "a success passes through and a failure keeps its value" {
  assert_eq(result_map(Ok(2), |x: Int| x * 3), Ok(6));
  assert_eq(result_map(Err("bad"), |x: Int| x * 3), Err("bad"));
  assert_eq(result_map_err(Err("bad"), |e: String| string_len(e)), Err(3));
  assert_eq(result_map_err(Ok(2), |e: String| string_len(e)), Ok(2));
  assert_eq(result_and_then(Ok(2), |x: Int| Ok(x + 1)), Ok(3));
  assert_eq(result_and_then(Ok(2), |_: Int| Err("later")), Err("later"));
  assert_eq(result_and_then(Err("bad"), |x: Int| Ok(x + 1)), Err("bad"));
  assert_eq(result_unwrap_or(Err("bad"), 9), 9);
  assert_eq(result_unwrap_or(Ok(1), 9), 1);
  assert_eq(result_ok(Ok(1)), Some(1));
  assert_eq(result_ok(Err("bad")), None);
  assert_eq(result_err(Ok(1)), None);
  assert_eq(result_err(Err("bad")), Some("bad"));
  assert(result_is_ok(Ok(1)));
  assert(result_is_err(Err("bad")));
  assert_eq(result_expect(Ok(7), "cannot happen"), 7)
}

test "the else-combinators see the failure and only run the fallback they need" {
  assert_eq(result_or_else(Err("bad"), |e: String| Ok(string_len(e))), Ok(3));
  assert_eq(result_or_else(Ok(1), |e: String| Ok(string_len(e))), Ok(1));
  assert_eq(result_unwrap_or_else(Err("bad"), |e: String| string_len(e)), 3);
  assert_eq(result_unwrap_or_else(Ok(1), |e: String| string_len(e)), 1);
  assert_eq(result_map_or(Ok(2), 0, |x: Int| x * 3), 6);
  assert_eq(result_map_or(Err("bad"), 0, |x: Int| x * 3), 0)
}

test "a callback may perform effects, and runs only where the value calls for it" {
  let calls = with_cell[calls](0) { c -> {
    let tick = |x: Int| {
      cell_update(c, |n: Int| n + 1);
      x
    };
    assert_eq(result_map(Ok(2), |x: Int| tick(x) * 3), Ok(6));
    assert_eq(result_map(Err("bad"), |x: Int| tick(x) * 3), Err("bad"));
    assert_eq(result_unwrap_or_else(Err(4), |e: Int| tick(e)), 4);
    assert_eq(result_unwrap_or_else(Ok(1), |e: Int| tick(e)), 1);
    cell_get(c)
  } };
  assert_eq(calls, 2)
}
