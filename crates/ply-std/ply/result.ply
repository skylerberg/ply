// `result` — what a program wants over a `Result<a, e>` and the prelude does not carry.
//
// `Result`'s constructors are the prelude's (`Ok`, `Err`) and `?` propagates one. The combinators
// are `result_`-prefixed for the same reason `option`'s are: `map` is a name a program already has.

pub fn result_map<a, b, e>(r: Result<a, e>, f: (a) -> b) -> Result<b, e> =
  match r { Ok(x) -> Ok(f(x)), Err(e) -> Err(e) }

/// The failure mapped and the success left alone, which is how a low-level error becomes the one a
/// caller names.
pub fn result_map_err<a, e, f>(r: Result<a, e>, g: (e) -> f) -> Result<a, f> =
  match r { Ok(x) -> Ok(x), Err(e) -> Err(g(e)) }

pub fn result_and_then<a, b, e>(r: Result<a, e>, f: (a) -> Result<b, e>) -> Result<b, e> =
  match r { Ok(x) -> f(x), Err(e) -> Err(e) }

pub fn result_unwrap_or<a, e>(r: Result<a, e>, fallback: a) -> a =
  match r { Ok(x) -> x, Err(_) -> fallback }

/// The value, or the panic `message` names; `message` is the caller's, because only the caller
/// knows why this failure cannot happen here.
pub fn result_expect<a, e>(r: Result<a, e>, message: String) -> a =
  match r { Ok(x) -> x, Err(_) -> panic(message) }

pub fn result_ok<a, e>(r: Result<a, e>) -> Option<a> = match r { Ok(x) -> Some(x), Err(_) -> None }

pub fn result_err<a, e>(r: Result<a, e>) -> Option<e> = match r { Ok(_) -> None, Err(e) -> Some(e) }

pub fn result_is_ok<a, e>(r: Result<a, e>) -> Bool = match r { Ok(_) -> true, Err(_) -> false }

pub fn result_is_err<a, e>(r: Result<a, e>) -> Bool = match r { Ok(_) -> false, Err(_) -> true }

// --- Tests ------------------------------------------------------------------

test "a success passes through and a failure keeps its value" {
  assert_eq(result_map(Ok(2), |x: Int| x * 3), Ok(6));
  assert_eq(result_map(Err("bad"), |x: Int| x * 3), Err("bad"));
  assert_eq(result_map_err(Err("bad"), |e: String| string_len(e)), Err(3));
  assert_eq(result_map_err(Ok(2), |e: String| string_len(e)), Ok(2));
  assert_eq(result_and_then(Ok(2), |x: Int| Ok(x + 1)), Ok(3));
  assert_eq(result_and_then(Ok(2), |_: Int| Err("later")), Err("later"));
  assert_eq(result_and_then(Err("bad"), |x: Int| Ok(x + 1)), Err("bad"));
  assert_eq(result_unwrap_or(Err("bad"), 9), 9);
  assert_eq(result_unwrap_or(Ok(1), 9), 1);
  assert_eq(result_ok(Ok(1)), Some(1));
  assert_eq(result_ok(Err("bad")), None);
  assert_eq(result_err(Ok(1)), None);
  assert_eq(result_err(Err("bad")), Some("bad"));
  assert(result_is_ok(Ok(1)));
  assert(result_is_err(Err("bad")));
  assert_eq(result_expect(Ok(7), "cannot happen"), 7)
}
