//! What a program wants over a `Result<a, e>` and the prelude does not carry.
//!
//! `Result`'s constructors are the prelude's (`Ok`, `Err`) and `?` propagates one. The combinators
//! are functions of `Result`, as `Option`'s are of `Option`: `r.map(f)` is `Result`'s.
//!
//! Over a list there are two policies. One ends at the first failure: `Result::all`,
//! `Result::traverse` and `Result::try_fold` read nothing past it, and a definition that recurses
//! through the callback of either of the last two is seen to end as it is through `fold`. The
//! other reads every element and answers every failure, which is what validating a form or a
//! configuration file wants: `Result::partition` and `Result::accumulate`.

import std.laws (inverse)
import std.list (somes)
import std.gen

/// The success through `f`; a failure passes through.
pub fn Result::map<a, b, e | row>(
  r: Result<a, e>,
  f: (a) -> b / row,
) -> Result<b, e> / row bounded = match r { Ok(x) -> Ok(f(x)), Err(e) -> Err(e) }

/// The failure mapped and the success left alone, which is how a low-level error becomes the one a
/// caller names.
pub fn Result::map_err<a, e, f | row>(
  r: Result<a, e>,
  g: (e) -> f / row,
) -> Result<a, f> / row bounded = match r { Ok(x) -> Ok(x), Err(e) -> Err(g(e)) }

/// The success through a step that may itself fail; the first failure wins.
pub fn Result::and_then<a, b, e | row>(
  r: Result<a, e>,
  f: (a) -> Result<b, e> / row,
) -> Result<b, e> / row bounded = match r { Ok(x) -> f(x), Err(e) -> Err(e) }

/// The success, or `fallback` for a failure.
pub fn Result::unwrap_or<a, e>(r: Result<a, e>, fallback: a) -> a =
  match r { Ok(x) -> x, Err(_) -> fallback }

/// The value, or the panic `message` names; `message` is the caller's, because only the caller
/// knows why this failure cannot happen here.
pub fn Result::expect<a, e>(r: Result<a, e>, message: String) -> a / {abort.raise} =
  match r { Ok(x) -> x, Err(_) -> panic(message) }

/// The success, dropping a failure.
pub fn Result::ok<a, e>(r: Result<a, e>) -> Option<a> = match r { Ok(x) -> Some(x), Err(_) -> None }

/// The failure, dropping a success.
pub fn Result::err<a, e>(r: Result<a, e>) -> Option<e> =
  match r { Ok(_) -> None, Err(e) -> Some(e) }

/// The success as a list of one, or the empty list for a failure: what a list of results is gathered
/// through, failures dropped.
pub fn Result::to_list<a, e>(r: Result<a, e>) -> List<a>
  returns fresh
= match r { Ok(x) -> [x], Err(_) -> [] }

/// Whether it succeeded.
pub fn Result::is_ok<a, e>(r: Result<a, e>) -> Bool = match r { Ok(_) -> true, Err(_) -> false }

/// Whether it failed.
pub fn Result::is_err<a, e>(r: Result<a, e>) -> Bool = match r { Ok(_) -> false, Err(_) -> true }

/// Whether it succeeded with `x`.
pub fn Result::contains<a, e>(r: Result<a, e>, x: a) -> Bool
  where derivable(eq, a)
= match r { Ok(y) -> y == x, Err(_) -> false }

/// The success if it is there, and what `fallback` answers otherwise. The fallback only runs when
/// it is needed.
pub fn Result::or_else<a, e | row>(
  r: Result<a, e>,
  fallback: (e) -> Result<a, e> / row,
) -> Result<a, e> / row bounded = match r { Ok(x) -> Ok(x), Err(e) -> fallback(e) }

/// The success, or what `fallback` answers for the failure.
pub fn Result::unwrap_or_else<a, e | row>(
  r: Result<a, e>,
  fallback: (e) -> a / row,
) -> a / row bounded = match r { Ok(x) -> x, Err(e) -> fallback(e) }

/// `f` of the success, or `fallback` untouched for a failure.
pub fn Result::map_or<a, b, e | row>(
  r: Result<a, e>,
  fallback: b,
  f: (a) -> b / row,
) -> b / row bounded = match r { Ok(x) -> f(x), Err(_) -> fallback }

/// The result a success holds; a failure at either layer is the failure.
pub fn Result::flatten<a, e>(r: Result<Result<a, e>, e>) -> Result<a, e> =
  match r { Ok(inner) -> inner, Err(e) -> Err(e) }

/// Both successes as a pair, or the failure: `r`'s where both failed.
pub fn Result::zip<a, b, e>(r: Result<a, e>, s: Result<b, e>) -> Result<(a, b), e> =
  match r { Err(e) -> Err(e), Ok(x) -> match s { Err(e) -> Err(e), Ok(y) -> Ok((x, y)) } }

/// The layers the other way round: a success that holds nothing is nothing, and a failure is a
/// failure that is there. `Option::transpose` goes back.
pub fn Result::transpose<a, e>(r: Result<Option<a>, e>) -> Option<Result<a, e>> =
  match r { Ok(None) -> None, Ok(Some(x)) -> Some(Ok(x)), Err(e) -> Some(Err(e)) }

/// A fold whose step may fail: `f` of the state and each element in order, or the first failure.
/// Nothing past the first failure is read.
pub fn Result::try_fold<a, s, e | row>(
  xs: List<a>,
  init: s,
  f: (s, a) -> Result<s, e> / row cost k,
) -> Result<s, e> / row
  cost xs.len() * k
=
  match xs {
    [] -> Ok(init),
    [x, ..rest] -> match f(init, x) {
      Err(e) -> Err(e),
      Ok(state) -> Result::try_fold(rest, state, f),
    },
  }

/// `f` of each element in order, or the first failure. Nothing past the first failure is read.
pub fn Result::traverse<a, b, e | row>(
  xs: List<a>,
  f: (a) -> Result<b, e> / row cost k,
) -> Result<List<b>, e> / row
  cost xs.len() * k
= traversed(xs, f, [])

fn traversed<a, b, e | row>(
  xs: List<a>,
  f: (a) -> Result<b, e> / row cost k,
  done: List<b>,
) -> Result<List<b>, e> / row
  cost xs.len() * k
=
  match xs {
    [] -> Ok(done),
    [x, ..rest] -> match f(x) { Err(e) -> Err(e), Ok(y) -> traversed(rest, f, done.push(y)) },
  }

/// Every success in order, or the first failure. What follows the first failure is not read.
pub fn Result::all<a, e>(rs: List<Result<a, e>>) -> Result<List<a>, e>
  cost rs.len()
= all_onto(rs, [])

fn all_onto<a, e>(rs: List<Result<a, e>>, done: List<a>) -> Result<List<a>, e> =
  match rs {
    [] -> Ok(done),
    [Err(e), ..] -> Err(e),
    [Ok(x), ..rest] -> all_onto(rest, done.push(x)),
  }

/// The successes and the failures apart, each in the order it came.
pub fn Result::partition<a, e>(rs: List<Result<a, e>>) -> { oks: List<a>, errs: List<e> }
  cost rs.len()
=
  rs.fold({ oks: [], errs: [] }, |acc: { oks: List<a>, errs: List<e> }, r: Result<a, e>|
    match r {
      Ok(x) -> { oks: acc.oks.push(x), errs: acc.errs },
      Err(e) -> { oks: acc.oks, errs: acc.errs.push(e) },
    })

/// Every success in order, or every failure in order where there is one. `Result::all` answers the
/// first of them and stops; this reads the whole list, so a caller can report all that is wrong
/// at once.
pub fn Result::accumulate<a, e>(rs: List<Result<a, e>>) -> Result<List<a>, List<e>>
  cost rs.len()
= {
  let parts = Result::partition(rs);
  if parts.errs.len() == 0 { Ok(parts.oks) } else { Err(parts.errs) }
}

// --- Tests ------------------------------------------------------------------

test "a success passes through and a failure keeps its value" {
  assert_eq(Ok(2).map(|x: Int| x * 3), Ok(6));
  assert_eq(Err("bad").map(|x: Int| x * 3), Err("bad"));
  assert_eq(Err("bad").map_err(|e: String| e.len()), Err(3));
  assert_eq(Ok(2).map_err(|e: String| e.len()), Ok(2));
  assert_eq(Ok(2).and_then(|x: Int| Ok(x + 1)), Ok(3));
  assert_eq(Ok(2).and_then(|_: Int| Err("later")), Err("later"));
  assert_eq(Err("bad").and_then(|x: Int| Ok(x + 1)), Err("bad"));
  assert_eq(Err("bad").unwrap_or(9), 9);
  assert_eq(Ok(1).unwrap_or(9), 1);
  assert_eq(Ok(1).ok(), Some(1));
  assert_eq(Err("bad").ok(), None);
  assert_eq(Ok(1).err(), None);
  assert_eq(Err("bad").err(), Some("bad"));
  assert(Ok(1).is_ok());
  assert(Err("bad").is_err());
  assert_eq(Ok(7).expect("cannot happen"), 7)
}

test "a result is a list of its success, and a list of results gathers into the successes there" {
  assert_eq(Ok(3).to_list(), [3]);
  let failed: Result<Int, Bytes> = Err(b"no");
  assert_eq(failed.to_list(), []);
  let gathered = [Ok(1), Err(b"no"), Ok(2)].fold([], |acc: List<Int>, r: Result<Int, Bytes>|
    r.to_list().fold(acc, |xs: List<Int>, x: Int| xs.push(x)));
  assert_eq(gathered, [1, 2])
}

test "a result contains only the success it holds" {
  let ok: Result<Int, String> = Ok(3);
  let failed: Result<Int, String> = Err("3");
  assert(ok.contains(3));
  assert(!ok.contains(4));
  assert(!failed.contains(3))
}

test "the else-combinators see the failure and only run the fallback they need" {
  assert_eq(Err("bad").or_else(|e: String| Ok(e.len())), Ok(3));
  assert_eq(Ok(1).or_else(|e: String| Ok(e.len())), Ok(1));
  assert_eq(Err("bad").unwrap_or_else(|e: String| e.len()), 3);
  assert_eq(Ok(1).unwrap_or_else(|e: String| e.len()), 1);
  assert_eq(Ok(2).map_or(0, |x: Int| x * 3), 6);
  assert_eq(Err("bad").map_or(0, |x: Int| x * 3), 0)
}

test "result_all keeps every success in order, or answers the first failure" {
  assert_eq(Result::all([Ok(1), Ok(2), Ok(3)]), Ok([1, 2, 3]));
  assert_eq(Result::all([Ok(1), Err("second"), Err("third")]), Err("second"));
  assert_eq(Result::all([Err("first"), Ok(2)]), Err("first"));
  let none: List<Result<Int, String>> = [];
  assert_eq(Result::all(none), Ok([]))
}

test "a callback may perform effects, and runs only where the value calls for it" {
  let calls = with_cell[calls](0) { c -> {
    let tick = |x: Int| {
      cell_update(c, |n: Int| n + 1);
      x
    };
    assert_eq(Ok(2).map(|x: Int| tick(x) * 3), Ok(6));
    assert_eq(Err("bad").map(|x: Int| tick(x) * 3), Err("bad"));
    assert_eq(Err(4).unwrap_or_else(|e: Int| tick(e)), 4);
    assert_eq(Ok(1).unwrap_or_else(|e: Int| tick(e)), 1);
    cell_get(c)
  } };
  assert_eq(calls, 2)
}

test "a nested result flattens to its inner one, and a failure at either layer is the failure" {
  let both: Result<Result<Int, String>, String> = Ok(Ok(1));
  assert_eq(both.flatten(), Ok(1));
  let inner: Result<Result<Int, String>, String> = Ok(Err("inner"));
  assert_eq(inner.flatten(), Err("inner"));
  let outer: Result<Result<Int, String>, String> = Err("outer");
  assert_eq(outer.flatten(), Err("outer"))
}

test "two results zip into a pair, or the first of their failures" {
  let one: Result<Int, String> = Ok(1);
  let word: Result<String, String> = Ok("one");
  assert_eq(one.zip(word), Ok((1, "one")));
  assert_eq(one.zip(Err("right")), Err("right"));
  assert_eq(Err("left").zip(word), Err("left"));
  let left: Result<Int, String> = Err("left");
  let right: Result<Int, String> = Err("right");
  assert_eq(left.zip(right), Err("left"))
}

test "the layers of an optional success swap" {
  let found: Result<Option<Int>, String> = Ok(Some(1));
  assert_eq(found.transpose(), Some(Ok(1)));
  let absent: Result<Option<Int>, String> = Ok(None);
  assert_eq(absent.transpose(), None);
  let failed: Result<Option<Int>, String> = Err("bad");
  assert_eq(failed.transpose(), Some(Err("bad")))
}

test "a traverse maps and gathers, and a fold threads its state until a step fails" {
  assert_eq(Result::traverse([1, 2, 3], halved), Err("1 is odd"));
  assert_eq(Result::traverse([2, 4, 6], halved), Ok([1, 2, 3]));
  let none: List<Int> = [];
  assert_eq(Result::traverse(none, halved), Ok([]));
  let summed = |sum: Int, x: Int| if x < 0 { Err(x) } else { Ok(sum + x) };
  assert_eq(Result::try_fold([1, 2, 3], 10, summed), Ok(16));
  assert_eq(Result::try_fold([1, 0 - 2, 0 - 3], 10, summed), Err(0 - 2))
}

test "a walk calls nothing past the first element that fails" {
  let calls = with_cell[calls](0) { c -> {
    let seen = |x: Int| {
      cell_update(c, |n: Int| n + 1);
      halved(x)
    };
    assert_eq(Result::traverse([2, 4, 5, 6, 7], seen), Err("5 is odd"));
    cell_get(c)
  } };
  assert_eq(calls, 3)
}

test "a failure at the front ends the walk in the same steps whatever follows it" {
  let short = failed_first(4);
  let long = failed_first(4000);
  assert_eq(metered(|| Result::all(long)).steps, metered(|| Result::all(short)).steps)
}

test "a traverse and a fold whose step fails first take the same steps whatever follows" {
  let short = [1, 2, 4, 6];
  let long = [1].concat(range(0, 4000));
  let stepped = |sum: Int, x: Int| if x % 2 == 1 { Err(x) } else { Ok(sum + x) };
  assert_eq(
    metered(|| Result::traverse(long, halved)).steps,
    metered(|| Result::traverse(short, halved)).steps,
  );
  assert_eq(
    metered(|| Result::try_fold(long, 0, stepped)).steps,
    metered(|| Result::try_fold(short, 0, stepped)).steps,
  )
}

test "a partition keeps both sides in order, and accumulating answers every failure" {
  let mixed = [Ok(1), Err("second"), Ok(3), Err("fourth")];
  assert_eq(Result::partition(mixed), { oks: [1, 3], errs: ["second", "fourth"] });
  assert_eq(Result::accumulate(mixed), Err(["second", "fourth"]));
  let clean: List<Result<Int, String>> = [Ok(1), Ok(2)];
  assert_eq(Result::accumulate(clean), Ok([1, 2]));
  let none: List<Result<Int, String>> = [];
  assert_eq(Result::accumulate(none), Ok([]));
  assert_eq(Result::partition(none), { oks: [], errs: [] })
}

type Nested = | Leaf(Int) | Branch(List<Nested>)

/// The leaves halved, in order, or the first odd one: a recursion through `Result::traverse`.
fn halves(t: Nested) -> Result<List<Int>, String> =
  match t {
    Leaf(n) -> halved(n).map(|half: Int| [half]),
    Branch(kids) ->
      Result::traverse(kids, halves).map(|found: List<List<Int>>|
        found.fold([], |all: List<Int>, some: List<Int>|
          some.fold(all, |acc: List<Int>, n: Int| acc.push(n)))),
  }

test "a definition that recurses through a traverse is seen to end" {
  assert_eq(halves(Branch([Leaf(2), Branch([Leaf(4), Leaf(6)]), Leaf(8)])), Ok([1, 2, 3, 4]));
  assert_eq(halves(Branch([Leaf(2), Branch([Leaf(5), Leaf(7)])])), Err("5 is odd"))
}

fn halved(x: Int) -> Result<Int, String> =
  if x % 2 == 0 { Ok(x / 2) } else { Err(x.to_string() ++ " is odd") }

fn failed_first(n: Int) -> List<Result<Int, Int>> =
  range(0, n).map(|i: Int| if i == 0 { Err(i) } else { Ok(i) })

test "accumulating answers every failure, of which result_all answers the first" {
  gen::check(
    gen::list(gen::result_of(gen::any_int(), gen::bool())),
    |rs: List<Result<Int, Bool>>| {
      match Result::accumulate(rs) {
        Ok(xs) -> Result::all(rs) == Ok(xs),
        Err(es) -> es == Result::partition(rs).errs && Result::all(rs).err() == es.first(),
      }
    },
  )
}

law "a result wrapped in a success flattens to itself" =
  inverse(|r: Result<Int, Bool>| Ok(r), Result::flatten)
