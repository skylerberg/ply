//! Printing one line to a console stream.
//!
//! `print` and `eprint` are `std.process`'s `out` and `err` under the conventional `proc` label:
//! one line to standard output and standard error. A value that is not a `String` is written by
//! interpolation, `print(f"{x}")`, which is `std.show.display`. Either reaches the process effect,
//! so a program that prints runs under `ply run --host`, and a test answers it with
//! `std.process.over`.
//!
//! `Console` is both streams as an `effect set`, so a program that prints writes
//! `fn main() -> Unit / {Console}` rather than naming them.

import std.process (process, Stdout, Stderr, captured, over, written_to)

/// Standard output and standard error as one row.
pub effect set Console = {process.out[proc], process.err[proc]}

/// `text` written to standard output, with a line ending.
pub fn print(text: String) -> Unit / {process.out[proc]} = process.out[proc](text)

/// `text` written to standard error, with a line ending.
pub fn eprint(text: String) -> Unit / {process.err[proc]} = process.err[proc](text)

test "each line goes to its own stream" {
  let ran = over[proc](captured([]), || {
    print("plain");
    eprint("trouble")
  });
  assert_eq(written_to(ran.captured, Stdout), b"plain\n");
  assert_eq(written_to(ran.captured, Stderr), b"trouble\n")
}
