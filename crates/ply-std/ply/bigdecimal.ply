    { a: "3.5", b: "1", n: 0, mode: Down, want: "3" },
    { a: "3.5", b: "1", n: 0, mode: Up, want: "4" },
    { a: "3.5", b: "1", n: 0, mode: Ceiling, want: "4" },
    { a: "3.5", b: "1", n: 0, mode: Floor, want: "3" },
    { a: "1.2345", b: "0.01", n: 0, mode: HalfEven, want: "1.23" },
    { a: "1.2345", b: "0.01", n: 0, mode: HalfUp, want: "1.23" },
    { a: "1.2345", b: "0.01", n: 0, mode: Down, want: "1.23" },
    { a: "1.2345", b: "0.01", n: 0, mode: Up, want: "1.24" },
    { a: "1.2345", b: "0.01", n: 0, mode: Ceiling, want: "1.24" },
    { a: "1.2345", b: "0.01", n: 0, mode: Floor, want: "1.23" },
    { a: "-1.2355", b: "0.001", n: 0, mode: HalfEven, want: "-1.236" },
    { a: "-1.2355", b: "0.001", n: 0, mode: HalfUp, want: "-1.236" },
    { a: "-1.2355", b: "0.001", n: 0, mode: Down, want: "-1.235" },
    { a: "-1.2355", b: "0.001", n: 0, mode: Up, want: "-1.236" },
    { a: "-1.2355", b: "0.001", n: 0, mode: Ceiling, want: "-1.235" },
    { a: "-1.2355", b: "0.001", n: 0, mode: Floor, want: "-1.236" },
    { a: "1.5", b: "0.0000", n: 0, mode: HalfEven, want: "1.5000" },
    { a: "1.5", b: "0.0000", n: 0, mode: HalfUp, want: "1.5000" },
    { a: "1.5", b: "0.0000", n: 0, mode: Down, want: "1.5000" },
    { a: "1.5", b: "0.0000", n: 0, mode: Up, want: "1.5000" },
    { a: "1.5", b: "0.0000", n: 0, mode: Ceiling, want: "1.5000" },
    { a: "1.5", b: "0.0000", n: 0, mode: Floor, want: "1.5000" },
    { a: "0.05", b: "0.1", n: 0, mode: HalfEven, want: "0.0" },
    { a: "0.05", b: "0.1", n: 0, mode: HalfUp, want: "0.1" },
    { a: "0.05", b: "0.1", n: 0, mode: Down, want: "0.0" },
    { a: "0.05", b: "0.1", n: 0, mode: Up, want: "0.1" },
    { a: "0.05", b: "0.1", n: 0, mode: Ceiling, want: "0.1" },
    { a: "0.05", b: "0.1", n: 0, mode: Floor, want: "0.0" },
    { a: "-0.15", b: "0.1", n: 0, mode: HalfEven, want: "-0.2" },
