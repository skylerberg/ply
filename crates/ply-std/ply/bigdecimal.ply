/// `a` at the scale of `b`: `quantize`.
fn quantizings() -> List<Vector> =
  [
    { a: "2.5", b: "1", n: 0, mode: HalfEven, want: "2" },
    { a: "2.5", b: "1", n: 0, mode: HalfUp, want: "3" },
    { a: "2.5", b: "1", n: 0, mode: Down, want: "2" },
    { a: "2.5", b: "1", n: 0, mode: Up, want: "3" },
    { a: "2.5", b: "1", n: 0, mode: Ceiling, want: "3" },
    { a: "2.5", b: "1", n: 0, mode: Floor, want: "2" },
    { a: "-2.5", b: "1", n: 0, mode: HalfEven, want: "-2" },
    { a: "-2.5", b: "1", n: 0, mode: HalfUp, want: "-3" },
    { a: "-2.5", b: "1", n: 0, mode: Down, want: "-2" },
    { a: "-2.5", b: "1", n: 0, mode: Up, want: "-3" },
    { a: "-2.5", b: "1", n: 0, mode: Ceiling, want: "-2" },
    { a: "-2.5", b: "1", n: 0, mode: Floor, want: "-3" },
