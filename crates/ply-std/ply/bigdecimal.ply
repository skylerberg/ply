test "{c.a} / {c.b} at {c.n} places, {c.mode}" for c: Vector in quotients_at_places() {
  assert_eq(text_of(div(dec(c.a), dec(c.b), c.n, c.mode)), c.want)
}

test "{c.a} / {c.b} to {c.n} digits, {c.mode}" for c: Vector in quotients_to_precision() {
  assert_eq(text_of(div_to_precision(dec(c.a), dec(c.b), c.n, c.mode)), c.want)
}

test "the root of {c.a} to {c.n} digits" for c: Vector in roots_to_precision() {
  assert_eq(text_of(sqrt_to_precision(dec(c.a), c.n, c.mode)), c.want)
}

test "{c.a} to {c.n} digits, {c.mode}" for c: Vector in roundings_to_precision() {
  assert_eq(to_string(round_to_precision(dec(c.a), c.n, c.mode)), c.want)
}

test "{c.a} at the scale of {c.b}, {c.mode}" for c: Vector in quantizings() {
  assert_eq(to_string(quantize(dec(c.a), dec(c.b), c.mode)), c.want)
}

test "a zero divisor and a root below zero have no answer, and an exact quotient need not exist" {
  assert_eq(div(one(), zero(), 5, HalfEven), None);
  assert_eq(div(one(), dec("0.00"), 5, HalfEven), None);
  assert_eq(div_to_precision(one(), zero(), 5, HalfEven), None);
  assert_eq(div_exact(one(), zero()), None);
  assert_eq(text_of(div_exact(dec("1"), dec("8"))), "0.125");
  assert_eq(text_of(div_exact(dec("-7.5"), dec("0.25"))), "-30");
  assert_eq(text_of(div_exact(dec("1"), dec("1024"))), "0.0009765625");
  assert_eq(div_exact(dec("1"), dec("3")), None);
  assert_eq(sqrt(dec("-0.01"), 5, HalfEven), None);
  assert_eq(sqrt_to_precision(dec("-4"), 5, HalfEven), None);
  assert_eq(text_of(sqrt(dec("2"), 10, Down)), "1.4142135623");
  assert_eq(text_of(sqrt(dec("2"), 10, Up)), "1.4142135624");
  assert_eq(text_of(sqrt(dec("4"), 3, Up)), "2.000");
  assert_eq(text_of(sqrt(dec("152399025"), 0 - 2, HalfUp)), "12300")
}

test "rounding to places leaves a shorter value alone, and rescaling writes its zeros" {
  assert_eq(to_string(round(dec("1.5"), 3, Down)), "1.5");
  assert_eq(to_string(rescale(dec("1.5"), 3, Down)), "1.500");
  assert_eq(to_string(round(dec("1.2345"), 2, HalfEven)), "1.23");
  assert_eq(to_string(round(dec("12345"), 0 - 2, HalfEven)), "12300");
  assert_eq(to_string(rescale(dec("12355.5"), 0 - 1, HalfUp)), "12360");
  assert_eq(to_string(strip_trailing_zeros(dec("1.500"))), "1.5");
  assert_eq(to_string(strip_trailing_zeros(dec("200.00"))), "200");
  assert_eq(to_string(strip_trailing_zeros(dec("0.000"))), "0");
  assert_eq(to_string(strip_trailing_zeros(dec("-0.0120"))), "-0.012")
}

test "a number is read plain or with an exponent, and written either way" {
  assert_eq(to_string(dec("123.45")), "123.45");
  assert_eq(to_string(dec("+.5")), "0.5");
  assert_eq(to_string(dec("5.")), "5");
  assert_eq(to_string(dec("-0.00")), "0.00");
  assert_eq(to_string(dec("1.5E2")), "150");
  assert_eq(to_string(dec("1.50e-3")), "0.00150");
  assert_eq(to_string(dec("12e+3")), "12000");
  assert_eq(to_string(dec("0e-5")), "0.00000");
  assert_eq(
    map(["123.45", "1.50", "0.00", "0", "-0.0012", "12345678901234567890", "100"], |t: String|
      to_scientific(dec(t))),
    ["1.2345E+2", "1.50E+0", "0E-2", "0E+0", "-1.2E-3", "1.2345678901234567890E+19", "1.00E+2"],
  );
  assert_eq(parse("1e400", 400), Ok(of_parts(bigint::one(), 0 - 400)));
  assert_eq(scale(dec("1e-400")), 400)
}

type Refused = { text: String, at: Int, why: Why }

fn refusals() -> List<Refused> =
  [
    { text: "", at: 0, why: Stray },
    { text: "-", at: 1, why: Stray },
    { text: ".", at: 1, why: Stray },
    { text: "x", at: 0, why: Stray },
    { text: "1x", at: 1, why: Stray },
    { text: "1.2.3", at: 3, why: Stray },
    { text: "--1", at: 1, why: Stray },
    { text: "1e", at: 2, why: Stray },
    { text: "1e+", at: 3, why: Stray },
    { text: "1e5x", at: 3, why: Stray },
    { text: "1 000", at: 1, why: Stray },
    { text: "1e401", at: 2, why: TooWide },
    { text: "1e-401", at: 2, why: TooWide },
    { text: "1e99999999999999999999", at: 2, why: TooWide },
  ]

test "`{c.text}` names no decimal number" for c: Refused in refusals() {
  assert_eq(parse(c.text, 400), Err({ at: c.at, why: c.why }))
}

test "a literal's check answers the number, or where the text stops being one" {
  assert_eq(result_ok(literal("-1.50")), Some(dec("-1.50")));
  assert_eq(
    literal("1,5"),
    Err({
      message: "a decimal number is digits, with an optional sign, point and exponent",
      offset: 1,
    }),
  );
  assert_eq(
    literal("1e7000"),
    Err({ message: "an exponent is at most 6144 either way", offset: 2 }),
  )
}

test "a Decimal keeps its scale both ways, and a value past one is refused" {
  assert_eq(to_string(of_decimal(1.50m)), "1.50");
  assert_eq(to_string(of_decimal(0m - 0.0070m)), "-0.0070");
  assert_eq(option_map(to_decimal(dec("1.50")), decimal_to_string), Some("1.50"));
  assert_eq(
    option_map(to_decimal(dec("-79228162514264337593543950335")), decimal_to_string),
    Some("-79228162514264337593543950335"),
  );
  assert_eq(to_decimal(dec("79228162514264337593543950336")), None);
  assert_eq(to_decimal(dec("0.00000000000000000000000000001")), None);
  // Thirty digits after the point that a Decimal need not hold.
  assert_eq(
    option_map(to_decimal(dec("2.500000000000000000000000000000")), decimal_to_string),
    Some("2.5"),
  )
}

test "a fraction and a Float are exact one way and rounded the other" {
  assert_eq(to_rational(dec("0.75")), fraction("3/4"));
  assert_eq(text_of(of_rational_exact(fraction("-3/8"))), "-0.375");
  assert_eq(of_rational_exact(fraction("1/3")), None);
  assert_eq(to_string(of_rational(fraction("2/3"), 4, HalfEven)), "0.6667");
  assert_eq(to_string(of_rational(fraction("-2/3"), 0 - 1, Up)), "-10");
  assert_eq(text_of(of_float(0.1)), "0.1000000000000000055511151231257827021181583404541015625");
  assert_eq(text_of(of_float(0.0 - 2.5)), "-2.5");
  assert_eq(of_float(0.0 / 0.0), None);
  assert_eq(to_float(dec("0.1")), 0.1);
  assert_eq(to_float(dec("-1e-400")), 0.0);
  assert_eq(to_float(dec("123456789012345678901234567890")), 1.2345678901234568e29)
}

/// The fraction a text names, for a test that writes one.
fn fraction(text: String) -> Rational / {abort.raise} =
  match rational::parse(text) { Ok(r) -> r, Err(_) -> panic("a fraction") }

/// A value past a `Decimal` from three `Int`s a law draws: the product of two as its digits, and
/// up to sixty-three of them after the point.
type Wide = { high: Int, low: Int, places: Int }

fn made(w: Wide) -> BigDecimal =
  of_parts(bigint::of_int(w.high) * bigint::of_int(w.low), w.places & 63)

/// Two `Decimal`s a law draws from `Int`s, small enough that a `Decimal` holds their sum and
/// product, with the places and the mode an operation is told.
type Drawn = { a: Int, b: Int, scales: Int, mode: Rounding }

fn first(c: Drawn) -> Decimal / {abort.raise} =
  match decimal::of_parts(c.a >> 34, c.scales & 7) {
    Some(d) -> d,
    None -> panic("a scale in range"),
  }

fn second(c: Drawn) -> Decimal / {abort.raise} =
  match decimal::of_parts(c.b >> 34, c.scales >> 3 & 7) {
    Some(d) -> d,
    None -> panic("a scale in range"),
  }

fn places_of(c: Drawn) -> Int = c.scales >> 6 & 15

law "a sum, a difference and a product are a Decimal's, digit for digit"
  forall (c: Drawn) {
    let product = of_decimal(first(c)) * of_decimal(second(c));
    to_string(of_decimal(first(c)) + of_decimal(second(c)))
      == decimal_to_string(first(c) + second(c))
      && to_string(of_decimal(first(c)) - of_decimal(second(c)))
      == decimal_to_string(first(c) - second(c))
      && product == of_decimal(first(c) * second(c))
      && (is_zero(product) || to_string(product) == decimal_to_string(first(c) * second(c)))
  }

law "a quotient at a scale is decimal_div's under every mode, written to the scale"
  forall (c: Drawn) {
    match div(of_decimal(first(c)), of_decimal(second(c)), places_of(c), c.mode) {
      Some(q) ->
        scale(q) == places_of(c)
          && q == of_decimal(decimal_div(first(c), second(c), places_of(c), c.mode)),
      None -> second(c) == 0m,
    }
  }

law "a value rounded to a scale is decimal_round's under every mode"
  forall (c: Drawn) {
    to_string(round(of_decimal(first(c)), places_of(c), c.mode))
      == decimal_to_string(decimal_round(first(c), places_of(c), c.mode))
  }

law "two values compare, and are equal, as their Decimals do"
  forall (c: Drawn) {
    compare(of_decimal(first(c)), of_decimal(second(c))) == compare_values(first(c), second(c))
      && compare_values(of_decimal(first(c)), of_decimal(second(c)))
      == compare_values(first(c), second(c))
      && of_decimal(first(c)) == of_decimal(second(c)) == (first(c) == second(c))
  }

law "a Decimal reads back from its value at its own scale"
  forall (d: Decimal) {
    match to_decimal(of_decimal(d)) {
      Some(back) -> decimal_to_string(back) == decimal_to_string(d),
      None -> false,
    }
  }

law "the key reads no scale, and orders as comparing does"
  forall (x: Wide, y: Wide) {
    made(x) == rescale(made(x), 70, Down) && digest(made(x)) == digest(rescale(made(x), 70, Down))
      && compare_values(made(x), made(y)) == compare(made(x), made(y))
  }

law "comparing is a total order"
  forall (x: Wide, y: Wide, z: Wide) {
    total_order(compare, made(x), made(y), made(z))
  }

law "addition is a monoid over zero"
  forall (x: Wide, y: Wide, z: Wide) {
    monoid(add, zero(), made(x), made(y), made(z))
  }

law "multiplication is a monoid over one, and distributes over addition"
  forall (x: Wide, y: Wide, z: Wide) {
    monoid(mul, one(), made(x), made(y), made(z))
      && made(x) * (made(y) + made(z)) == made(x) * made(y) + made(x) * made(z)
  }

law "a value reads back from its text, plain and scientific, at its scale"
  forall (x: Wide) {
    (match parse(to_string(made(x)), 0) {
        Ok(back) -> back == made(x) && scale(back) == scale(made(x)),
        Err(_) -> false,
      })
      && (match parse(to_scientific(made(x)), 200) {
        Ok(back) -> back == made(x) && scale(back) == scale(made(x)),
        Err(_) -> false,
      })
  }

law "a value is the fraction it names, and reads back from it"
  forall (x: Wide) {
    of_rational_exact(to_rational(made(x))) == Some(made(x))
      && of_rational(to_rational(made(x)), scale(made(x)), Down) == made(x)
  }

law "a finite Float reads back from its value, and no other Float has one"
  forall (f: Float) {
    match of_float(f) { Some(value) -> to_float(value) == f, None -> f != f || f - f != 0.0 }
  }

law "a root rounded down squares to the last value at or below, at every scale"
  forall (x: Wide) {
    let value = abs(made(x));
    let places = x.places >> 6 & 15;
    match sqrt(value, places, Down) {
      Some(r) ->
        compare(r * r, value) != Greater
          && compare(
            value,
            (r + of_parts(bigint::one(), places)) * (r + of_parts(bigint::one(), places)),
          )
          == Less,
      None -> false,
    }
  }

law "a quotient times its divisor is within one last place of the dividend's worth"
  forall (x: Wide, y: Wide, mode: Rounding) {
    let places = x.places >> 6 & 31;
    match div(made(x), made(y), places, mode) {
      Some(q) ->
        compare(abs(q * made(y) - made(x)), abs(made(y)) * of_parts(bigint::one(), places)) == Less,
      None -> is_zero(made(y)),
    }
  }
