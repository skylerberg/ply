    { a: "12", b: "0.00", n: 0, mode: Down, want: "12.00" },
    { a: "12", b: "0.00", n: 0, mode: Up, want: "12.00" },
    { a: "12", b: "0.00", n: 0, mode: Ceiling, want: "12.00" },
    { a: "12", b: "0.00", n: 0, mode: Floor, want: "12.00" },
