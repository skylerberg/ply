// The database effect.

import std.bytes (u32_be, u32_be_at)
import std.json
import std.net (net)
import std.random (entropy, nonce)
import std.pg
import std.string

pub nondet effect db {
  read query[t](s: Stmt, ps: List<Param>) -> Answer
  write execute[t](s: Stmt, ps: List<Param>) -> Answer
  write returning[t](s: Stmt, ps: List<Param>) -> Answer
  // Transaction control takes no resource, so its atom is the singleton `db.write`.
  write begin(level: Isolation, access: Access) -> Answer
  write commit() -> Answer
  write abort() -> Answer
  // Handled by `transaction`, never by the host: a host binding for it is a defect.
  write rollback(reason: String) -> Unit
}

pub type Isolation = | ReadCommitted | RepeatableRead | Serializable

pub type Access = | ReadWrite | ReadOnly

pub type Stmt = { sql: String }

pub fn stmt(sql: String) -> Stmt = { sql: sql }

pub type Param =
  | PNull
  | PInt(Int)
  | PBool(Bool)
  | PText(String)
  | PBytes(Bytes)
  | PFloat(Float)
  | PNumeric(Decimal)
  | PJson(json::Json)
  | PArray(List<Param>)

// One value out of one column.
pub type Datum =
  | CNull
  | CInt(Int)
  | CBool(Bool)
  | CText(String)
  | CBytes(Bytes)
  | CFloat(Float)
  | CNumeric(Decimal)
  | CJson(json::Json)
  | CArray(List<Datum>)

pub type Row = Map<String, Datum>

// The SQLSTATE the server returned and the object it named.
pub type DbError = { code: String, constraint: String, detail: String }

pub type Answer = | Rows(List<Row>) | Count(Int) | Failed(DbError)

// --- Transactions -----------------------------------------------------------

pub type Rollback = { reason: String, error: Option<DbError> }

// A `db.rollback` anywhere inside the body, however deep, discards the rest of it.
pub fn transaction<a | e>(
  level: Isolation,
  access: Access,
  body: () -> a / e,
) -> Result<a, Rollback> / {db.begin, db.commit, db.abort | e} =
  match db.begin(level, access) {
    Failed(err) -> Err({ reason: "begin", error: Some(err) }),
    _ -> match attempt(body) {
      Err(rolled) -> Err(rolled),
      Ok(value) -> match db.commit() {
        Failed(err) -> Err({ reason: "commit", error: Some(err) }),
        _ -> Ok(value),
      },
    },
  }

fn attempt<a | e>(body: () -> a / e) -> Result<a, Rollback> / {db.abort | e} =
  match handle {
      Ok(body())
    } with {
      db.rollback(reason) resume k -> Err({ reason: reason, error: None }),
    } {
    Err(rolled) -> {
      db.abort();
      Err(rolled)
    },
    Ok(value) -> Ok(value),
  }

// A transaction that always rolls back, whatever the body did.
pub fn sandbox<a | e>(body: () -> a / e) -> a / {db.begin, db.abort | e} = {
  assert(opened(db.begin(ReadCommitted, ReadWrite)));
  let value = body();
  db.abort();
  value
}

fn opened(a: Answer) -> Bool = match a { Failed(_) -> false, _ -> true }

// A serialization failure or a deadlock: the server is asking the program to retry.
pub fn is_retryable(e: DbError) -> Bool = e.code == "40001" || e.code == "40P01"

// --- Tests ------------------------------------------------------------------

// A rollback raised two calls deep, out of sight of the `handle` that answers it.
fn charge(stock: Bool) -> Int / {db.execute[items], db.rollback} = {
  db.execute[items](stmt("insert one"), []);
  reserve(stock);
  db.execute[items](stmt("insert three"), []);
  3
}

fn reserve(stock: Bool) -> Unit / {db.execute[items], db.rollback} =
  if stock {
    db.execute[items](stmt("insert two"), []);
    ()
  } else { db.rollback("no stock") }

test "a rollback discards the continuation the body had left" {
  with_cell[journal]([]) { j ->
    handle {
      let out = transaction(ReadCommitted, ReadWrite, || {
        db.execute[items](stmt("insert one"), []);
        db.rollback("out of stock");
        db.execute[items](stmt("insert two"), []);
        7
      });
      assert_eq(out, Err({ reason: "out of stock", error: None }));
      // `commit` is absent too: it was part of the discarded continuation.
      assert_eq(cell_get(j), ["begin", "insert one", "abort"])
    } with {
      db.begin(level, access) -> {
        cell_set(j, push(cell_get(j), "begin"));
        Count(0)
      },
      db.commit() -> {
        cell_set(j, push(cell_get(j), "commit"));
        Count(0)
      },
      db.abort() -> {
        cell_set(j, push(cell_get(j), "abort"));
        Count(0)
      },
      db.execute[items](s, ps) -> {
        cell_set(j, push(cell_get(j), s.sql));
        Count(1)
      },
      db.rollback(reason) -> panic("a transaction answers its own rollback"),
    }
  }
}

test "a body that returns commits, and its value comes out" {
  with_cell[journal]([]) { j ->
    handle {
      let out = transaction(Serializable, ReadWrite, || {
        db.execute[items](stmt("insert one"), []);
        "done"
      });
      assert_eq(out, Ok("done"));
      assert_eq(cell_get(j), ["begin", "insert one", "commit"])
    } with {
      db.begin(level, access) -> {
        cell_set(j, push(cell_get(j), "begin"));
        Count(0)
      },
      db.commit() -> {
        cell_set(j, push(cell_get(j), "commit"));
        Count(0)
      },
      db.abort() -> {
        cell_set(j, push(cell_get(j), "abort"));
        Count(0)
      },
      db.execute[items](s, ps) -> {
        cell_set(j, push(cell_get(j), s.sql));
        Count(1)
      },
    }
  }
}

test "a begin that fails runs no body and issues no abort" {
  with_cell[journal]([]) { j ->
    handle {
      let out = transaction(ReadCommitted, ReadWrite, || {
        db.execute[items](stmt("insert one"), []);
        7
      });
      assert_eq(
        out,
        Err({
          reason: "begin",
          error: Some({ code: "53300", constraint: "", detail: "too many clients already" }),
        }),
      );
      assert_eq(cell_get(j), ["begin"])
    } with {
      db.begin(level, access) -> {
        cell_set(j, push(cell_get(j), "begin"));
        Failed({ code: "53300", constraint: "", detail: "too many clients already" })
      },
      db.commit() -> {
        cell_set(j, push(cell_get(j), "commit"));
        Count(0)
      },
      db.abort() -> {
        cell_set(j, push(cell_get(j), "abort"));
        Count(0)
      },
      db.execute[items](s, ps) -> {
        cell_set(j, push(cell_get(j), s.sql));
        Count(1)
      },
    }
  }
}

test "a commit that fails is an Err carrying the SQLSTATE" {
  with_cell[journal]([]) { j ->
    handle {
      let out = transaction(Serializable, ReadWrite, || {
        db.execute[items](stmt("insert one"), []);
        7
      });
      let retryable = match out {
        Err(r) -> match r.error { Some(e) -> is_retryable(e), None -> false },
        Ok(_) -> false,
      };
      assert(retryable);
      assert_eq(cell_get(j), ["begin", "insert one", "commit"])
    } with {
      db.begin(level, access) -> {
        cell_set(j, push(cell_get(j), "begin"));
        Count(0)
      },
      db.commit() -> {
        cell_set(j, push(cell_get(j), "commit"));
        Failed({ code: "40001", constraint: "", detail: "could not serialize access" })
      },
      db.abort() -> {
        cell_set(j, push(cell_get(j), "abort"));
        Count(0)
      },
      db.execute[items](s, ps) -> {
        cell_set(j, push(cell_get(j), s.sql));
        Count(1)
      },
    }
  }
}

test "a rollback two calls deep discards its callers" {
  with_cell[journal]([]) { j ->
    handle {
      let out = transaction(ReadCommitted, ReadWrite, || charge(false));
      assert_eq(out, Err({ reason: "no stock", error: None }));
      assert_eq(cell_get(j), ["begin", "insert one", "abort"])
    } with {
      db.begin(level, access) -> {
        cell_set(j, push(cell_get(j), "begin"));
        Count(0)
      },
      db.commit() -> {
        cell_set(j, push(cell_get(j), "commit"));
        Count(0)
      },
      db.abort() -> {
        cell_set(j, push(cell_get(j), "abort"));
        Count(0)
      },
      db.execute[items](s, ps) -> {
        cell_set(j, push(cell_get(j), s.sql));
        Count(1)
      },
      db.rollback(reason) -> panic("a transaction answers its own rollback"),
    }
  }
}

test "the same body without the rollback runs to its end and commits" {
  with_cell[journal]([]) { j ->
    handle {
      assert_eq(transaction(ReadCommitted, ReadWrite, || charge(true)), Ok(3));
      assert_eq(cell_get(j), ["begin", "insert one", "insert two", "insert three", "commit"])
    } with {
      db.begin(level, access) -> {
        cell_set(j, push(cell_get(j), "begin"));
        Count(0)
      },
      db.commit() -> {
        cell_set(j, push(cell_get(j), "commit"));
        Count(0)
      },
      db.abort() -> {
        cell_set(j, push(cell_get(j), "abort"));
        Count(0)
      },
      db.execute[items](s, ps) -> {
        cell_set(j, push(cell_get(j), s.sql));
        Count(1)
      },
      db.rollback(reason) -> panic("a transaction answers its own rollback"),
    }
  }
}

// Nesting is a savepoint: the inner `transaction`'s `handle` is innermost and answers the rollback.
test "an inner rollback leaves the outer transaction running" {
  with_cell[journal]([]) { j ->
    handle {
      let out = transaction(ReadCommitted, ReadWrite, || {
        db.execute[items](stmt("outer one"), []);
        let inner = transaction(ReadCommitted, ReadWrite, || {
          db.execute[items](stmt("inner one"), []);
          db.rollback("inner gave up");
          db.execute[items](stmt("inner two"), []);
          1
        });
        db.execute[items](stmt("outer two"), []);
        inner
      });
      assert_eq(out, Ok(Err({ reason: "inner gave up", error: None })));
      assert_eq(cell_get(j), [
        "begin",
        "outer one",
        "begin",
        "inner one",
        "abort",
        "outer two",
        "commit",
      ])
    } with {
      db.begin(level, access) -> {
        cell_set(j, push(cell_get(j), "begin"));
        Count(0)
      },
      db.commit() -> {
        cell_set(j, push(cell_get(j), "commit"));
        Count(0)
      },
      db.abort() -> {
        cell_set(j, push(cell_get(j), "abort"));
        Count(0)
      },
      db.execute[items](s, ps) -> {
        cell_set(j, push(cell_get(j), s.sql));
        Count(1)
      },
      db.rollback(reason) -> panic("a transaction answers its own rollback"),
    }
  }
}

// A released savepoint is not a commit.
test "an outer rollback discards a committed inner scope" {
  with_cell[journal]([]) { j ->
    handle {
      let out = transaction(ReadCommitted, ReadWrite, || {
        let inner = transaction(ReadCommitted, ReadWrite, || {
          db.execute[items](stmt("inner one"), []);
          1
        });
        db.rollback("the outer gave up");
        inner
      });
      assert_eq(out, Err({ reason: "the outer gave up", error: None }));
      assert_eq(cell_get(j), ["begin", "begin", "inner one", "commit", "abort"])
    } with {
      db.begin(level, access) -> {
        cell_set(j, push(cell_get(j), "begin"));
        Count(0)
      },
      db.commit() -> {
        cell_set(j, push(cell_get(j), "commit"));
        Count(0)
      },
      db.abort() -> {
        cell_set(j, push(cell_get(j), "abort"));
        Count(0)
      },
      db.execute[items](s, ps) -> {
        cell_set(j, push(cell_get(j), s.sql));
        Count(1)
      },
      db.rollback(reason) -> panic("a transaction answers its own rollback"),
    }
  }
}

test "sandbox runs the body, hands back its value and aborts" {
  with_cell[journal]([]) { j ->
    handle {
      assert_eq(
        sandbox(|| {
          db.execute[items](stmt("insert one"), []);
          "kept"
        }),
        "kept",
      );
      assert_eq(cell_get(j), ["begin", "insert one", "abort"])
    } with {
      db.begin(level, access) -> {
        cell_set(j, push(cell_get(j), "begin"));
        Count(0)
      },
      db.commit() -> {
        cell_set(j, push(cell_get(j), "commit"));
        Count(0)
      },
      db.abort() -> {
        cell_set(j, push(cell_get(j), "abort"));
        Count(0)
      },
      db.execute[items](s, ps) -> {
        cell_set(j, push(cell_get(j), s.sql));
        Count(1)
      },
    }
  }
}

// `sandbox` installs no `handle`, so the enclosing transaction answers a rollback inside it.
test "a sandbox nested in a transaction keeps the transaction's rollback" {
  with_cell[journal]([]) { j ->
    handle {
      let out = transaction(ReadCommitted, ReadWrite, ||
        sandbox(|| {
          db.execute[items](stmt("insert one"), []);
          db.rollback("give up");
          2
        }));
      assert_eq(out, Err({ reason: "give up", error: None }));
      // The sandbox's own abort was part of the discarded continuation.
      assert_eq(cell_get(j), ["begin", "begin", "insert one", "abort"])
    } with {
      db.begin(level, access) -> {
        cell_set(j, push(cell_get(j), "begin"));
        Count(0)
      },
      db.commit() -> {
        cell_set(j, push(cell_get(j), "commit"));
        Count(0)
      },
      db.abort() -> {
        cell_set(j, push(cell_get(j), "abort"));
        Count(0)
      },
      db.execute[items](s, ps) -> {
        cell_set(j, push(cell_get(j), s.sql));
        Count(1)
      },
      db.rollback(reason) -> panic("a transaction answers its own rollback"),
    }
  }
}

test "is_retryable names the two the server is telling the program to try again" {
  assert(is_retryable({ code: "40001", constraint: "", detail: "" }));
  assert(is_retryable({ code: "40P01", constraint: "", detail: "" }));
  assert(!is_retryable({ code: "23505", constraint: "items_pkey", detail: "" }));
  assert(!is_retryable({ code: "25006", constraint: "", detail: "" }))
}

// --- A schema is a value --------------------------------------------------------

pub type ColumnType =
  | TInt
  | TBool
  | TText
  | TBytes
  | TFloat
  | TNumeric(Int, Int)
  | TJson
  | TArray(ColumnType)

pub type Default = | DNone | DSequence(String) | DLiteral(Param)

pub type Column = { name: String, ty: ColumnType, nullable: Bool, default: Default }

pub type ForeignKey = {
  name: String,
  columns: List<String>,
  references: String,
  refers_to: List<String>,
}

pub type Check = { name: String, expr: String }

pub type Unique = { name: String, columns: List<String> }

pub type Table = {
  name: String,
  columns: List<Column>,
  primary_key: List<String>,
  unique: List<Unique>,
  foreign_keys: List<ForeignKey>,
  checks: List<Check>,
}

pub type Schema = { tables: List<Table> }

// Deeper savepoint nesting is a program that recursed, so it is `Failed` with `54000`.
pub fn max_savepoints() -> Int = 16

pub fn db_error(code: String, constraint: String, detail: String) -> DbError =
  { code: code, constraint: constraint, detail: detail }

pub fn column(name: String, ty: ColumnType, nullable: Bool) -> Column =
  { name: name, ty: ty, nullable: nullable, default: DNone }

pub fn column_default(name: String, ty: ColumnType, nullable: Bool, d: Default) -> Column =
  { name: name, ty: ty, nullable: nullable, default: d }

// --- The DDL a schema renders to ------------------------------------------------

pub fn create_schema(s: Schema) -> List<Stmt> =
  fold(s.tables, sequence_statements(s), |acc: List<Stmt>, t: Table|
    push(acc, stmt(create_table_sql(t))))

pub fn drop_schema(s: Schema) -> List<Stmt> = {
  let drops = fold(reverse_list(s.tables), [], |acc: List<Stmt>, t: Table|
    push(acc, stmt("drop table if exists " ++ quote_ident(t.name) ++ " cascade")));
  fold(sequence_names(s), drops, |acc: List<Stmt>, n: String|
    push(acc, stmt("drop sequence if exists " ++ quote_ident(n))))
}

fn sequence_statements(s: Schema) -> List<Stmt> =
  fold(sequence_names(s), [], |acc: List<Stmt>, n: String|
    push(acc, stmt("create sequence " ++ quote_ident(n))))

fn sequence_names(s: Schema) -> List<String> =
  fold(s.tables, [], |acc: List<String>, t: Table|
    fold(t.columns, acc, |inner: List<String>, c: Column|
      match c.default { DSequence(n) -> push(inner, n), DNone -> inner, DLiteral(_) -> inner }))

fn create_table_sql(t: Table) -> String = {
  let cols = map(t.columns, |c: Column| column_sql(c));
  let pk = if len(t.primary_key) == 0 { [] }
  else { ["primary key (" ++ comma(map(t.primary_key, |n: String| quote_ident(n))) ++ ")"] };
  let uq = map(t.unique, |u: Unique|
    "constraint " ++ quote_ident(u.name) ++ " unique ("
      ++ comma(map(u.columns, |n: String| quote_ident(n)))
      ++ ")");
  let fks = map(t.foreign_keys, |f: ForeignKey|
    "constraint " ++ quote_ident(f.name) ++ " foreign key ("
      ++ comma(map(f.columns, |n: String| quote_ident(n)))
      ++ ") references "
      ++ quote_ident(f.references)
      ++ " ("
      ++ comma(map(f.refers_to, |n: String| quote_ident(n)))
      ++ ")");
  let cks = map(t.checks, |c: Check|
    "constraint " ++ quote_ident(c.name) ++ " check (" ++ c.expr ++ ")");
  "create table " ++ quote_ident(t.name) ++ " ("
    ++ comma(concat_lists(concat_lists(concat_lists(concat_lists(cols, pk), uq), fks), cks))
    ++ ")"
}

fn column_sql(c: Column) -> String =
  quote_ident(c.name) ++ " " ++ type_sql(c.ty) ++ (if c.nullable { "" } else { " not null" })
    ++ (match c.default {
      DNone -> "",
      DSequence(n) -> " default nextval('" ++ n ++ "')",
      DLiteral(p) -> " default " ++ literal_sql(p),
    })

fn type_sql(t: ColumnType) -> String =
  match t {
    TInt -> "bigint",
    TBool -> "boolean",
    TText -> "text",
    TBytes -> "bytea",
    TFloat -> "double precision",
    TNumeric(p, s) -> "numeric(" ++ int_to_string(p) ++ "," ++ int_to_string(s) ++ ")",
    TJson -> "jsonb",
    TArray(inner) -> type_sql(inner) ++ "[]",
  }

// Only for a `CREATE TABLE`'s `DEFAULT` clause, never for a value a request supplied.
fn literal_sql(p: Param) -> String =
  match p {
    PNull -> "null",
    PInt(n) -> int_to_string(n),
    PBool(b) -> if b { "true" } else { "false" },
    PText(s) -> "'" ++ string::join(string_split(s, "'"), "''") ++ "'",
    PNumeric(d) -> decimal_to_string(d),
    PFloat(_) -> "null",
    PBytes(_) -> "null",
    PJson(_) -> "null",
    PArray(_) -> "null",
  }

fn quote_ident(s: String) -> String = "\"" ++ string::join(string_split(s, "\""), "\"\"") ++ "\""

fn comma(pieces: List<String>) -> String = string::join(pieces, ", ")

// --- Lists ----------------------------------------------------------------------

fn concat_lists<a>(xs: List<a>, ys: List<a>) -> List<a> =
  fold(ys, xs, |acc: List<a>, y: a| push(acc, y))

fn reverse_list<a>(xs: List<a>) -> List<a> =
  fold(xs, [], |acc: List<a>, x: a| concat_lists([x], acc))

fn nth<a>(xs: List<a>, i: Int) -> Option<a> =
  match xs { [] -> None, [h, ..t] -> if i <= 0 { Some(h) } else { nth(t, i - 1) } }

fn last<a>(xs: List<a>) -> Option<a> = match xs { [] -> None, [h] -> Some(h), [_, ..t] -> last(t) }

fn drop_last<a>(xs: List<a>) -> List<a> =
  match xs { [] -> [], [_] -> [], [h, ..t] -> concat_lists([h], drop_last(t)) }

fn has_string(xs: List<String>, s: String) -> Bool =
  fold(xs, false, |acc: Bool, x: String| acc || x == s)

// --- The in-memory twin ---------------------------------------------------------

pub type MemTable = { def: Table, rows: List<Row> }

// One entry per open scope.
pub type Frame = { tables: List<MemTable>, failed: Bool, level: Isolation, access: Access }

pub type MemDb = {
  tables: List<MemTable>,
  sequences: Map<String, Int>,
  stack: List<Frame>,
  failed: Bool,
}

pub type Outcome = { db: MemDb, out: Answer }

pub fn open(s: Schema) -> MemDb =
  {
    tables: map(s.tables, |t: Table| { def: t, rows: [] }),
    sequences: fold(sequence_names(s), map_new(), |acc: Map<String, Int>, n: String|
      map_insert(acc, n, 0)),
    stack: [],
    failed: false,
  }

fn memdb(
  tables: List<MemTable>,
  sequences: Map<String, Int>,
  stack: List<Frame>,
  failed: Bool,
) -> MemDb = { tables: tables, sequences: sequences, stack: stack, failed: failed }

fn mark_failed(d: MemDb) -> MemDb =
  if len(d.stack) == 0 { d } else { memdb(d.tables, d.sequences, d.stack, true) }

fn fail(d: MemDb, e: DbError) -> Outcome = { db: mark_failed(d), out: Failed(e) }

fn done(d: MemDb, a: Answer) -> Outcome = { db: d, out: a }

// --- The SQLSTATEs the twin can produce -----------------------------------------

fn unsupported(what: String) -> DbError = db_error("0A000", "", what)

fn in_failed_txn() -> DbError =
  db_error(
    "25P02",
    "",
    "current transaction is aborted, commands ignored until end of transaction block",
  )

fn undefined_table(n: String) -> DbError =
  db_error("42P01", "", "relation \"" ++ n ++ "\" does not exist")

fn undefined_column(n: String) -> DbError =
  db_error("42703", "", "column \"" ++ n ++ "\" does not exist")

fn read_only_txn(what: String) -> DbError =
  db_error("25006", "", "cannot execute " ++ what ++ " in a read-only transaction")

// --- Tokens ----------------------------------------------------------------------

type Tok =
  | TWord(String)  // an unquoted identifier or keyword, folded to lower case
  | TQuoted(String)  // "an identifier", case preserved
  | TStr(String)  // 'a literal'
  | TNum(String)  // 12, or 1.50
  | TParam(Int)  // $1
  | TSym(String)

fn sql_ws() -> Bytes = b" \t\r\n"
fn sql_digits() -> Bytes = b"0123456789"
fn ident_rest() -> Bytes = b"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789$"
fn ident_start() -> Bytes = b"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_"

// `-1` is the end of the input, which is in no set.
fn in_set(set: Bytes, c: Int) -> Bool =
  if c < 0 { false } else { match bytes_index_of_byte(set, c) { Some(_) -> true, None -> false } }

fn byte_at(src: Bytes, i: Int) -> Int =
  if i < 0 || i >= bytes_len(src) { -1 } else { bytes_at(src, i) }

fn scan_set(src: Bytes, i: Int, set: Bytes) -> Int =
  if i >= bytes_len(src) { bytes_len(src) } else { bytes_scan(src, i, set, bytes_len(src)) }

fn lex_all(sql: String) -> Result<List<Tok>, DbError> = {
  let src = bytes_of_string(sql);
  if !bytes_is_utf8(src) { Err(unsupported("statement text that is not valid UTF-8")) }
  else { lex(src, 0, []) }
}

reuse fn lex(src: Bytes, i: Int, acc: List<Tok>) -> Result<List<Tok>, DbError> = {
  let j = scan_set(src, i, sql_ws());
  let c = byte_at(src, j);
  if c < 0 { Ok(acc) }
  else if c == 59 { Err(unsupported("more than one statement in one `Stmt`")) }
  else if c == 45 && byte_at(src, j + 1) == 45 { lex(src, line_comment_end(src, j + 2), acc) } else if c
      == 47
      && byte_at(src, j + 1) == 42 {
    match block_comment_end(src, j + 2, 1) {
      None -> Err(unsupported("a block comment that is never closed")),
      Some(end) -> lex(src, end, acc),
    }
  } else if in_set(ident_start(), c) {
    let end = scan_set(src, j, ident_rest());
    lex(src, end, push(acc, TWord(string_lower(string_of_bytes(bytes_slice(src, j, end))))))
  } else if in_set(sql_digits(), c) { lex_number(src, j, acc) }
  else if c == 39 { lex_string(src, j + 1, b"", acc) }
  else if c == 34 { lex_quoted(src, j + 1, b"", acc) }
  else if c == 36 { lex_param(src, j, acc) }
  else { lex_symbol(src, j, acc) }
}

fn line_comment_end(src: Bytes, i: Int) -> Int =
  if i >= bytes_len(src) || byte_at(src, i) == 10 { i + 1 } else { line_comment_end(src, i + 1) }

// Postgres nests block comments, so scanning to the first `*/` would leak an outer comment's tail.
fn block_comment_end(src: Bytes, i: Int, depth: Int) -> Option<Int> =
  if depth == 0 { Some(i) }
  else if i >= bytes_len(src) { None } else if byte_at(src, i) == 47 && byte_at(src, i + 1) == 42 {
    block_comment_end(src, i + 2, depth + 1)
  } else if byte_at(src, i) == 42 && byte_at(src, i + 1) == 47 {
    block_comment_end(src, i + 2, depth - 1)
  } else { block_comment_end(src, i + 1, depth) }

reuse fn lex_number(src: Bytes, i: Int, acc: List<Tok>) -> Result<List<Tok>, DbError> = {
  let whole = scan_set(src, i, sql_digits());
  let end = if byte_at(src, whole) == 46 { scan_set(src, whole + 1, sql_digits()) } else { whole };
  let after = byte_at(src, end);
  if after == 101 || after == 69 { Err(unsupported("a number in exponent notation")) }
  else if in_set(ident_start(), after) { Err(unsupported("a number followed by a letter")) }
  else { lex(src, end, push(acc, TNum(string_of_bytes(bytes_slice(src, i, end))))) }
}

// `''` is an escaped quote, which is the only escape a standard-conforming string has.
reuse fn lex_string(
  src: Bytes,
  i: Int,
  so_far: Bytes,
  acc: List<Tok>,
) -> Result<List<Tok>, DbError> = {
  let stop = if i >= bytes_len(src) { bytes_len(src) }
  else { bytes_scan_until(src, i, b"'", bytes_len(src)) };
  if stop >= bytes_len(src) { Err(unsupported("a string literal with no closing quote")) } else {
    let piece = bytes_concat(so_far, bytes_slice(src, i, stop));
    if byte_at(src, stop + 1) == 39 { lex_string(src, stop + 2, bytes_concat(piece, b"'"), acc) }
    else { lex(src, stop + 1, push(acc, TStr(string_of_bytes(piece)))) }
  }
}

reuse fn lex_quoted(
  src: Bytes,
  i: Int,
  so_far: Bytes,
  acc: List<Tok>,
) -> Result<List<Tok>, DbError> = {
  let stop = if i >= bytes_len(src) { bytes_len(src) }
  else { bytes_scan_until(src, i, b"\"", bytes_len(src)) };
  if stop >= bytes_len(src) { Err(unsupported("a quoted identifier with no closing quote")) } else {
    let piece = bytes_concat(so_far, bytes_slice(src, i, stop));
    if byte_at(src, stop + 1) == 34 { lex_quoted(src, stop + 2, bytes_concat(piece, b"\""), acc) }
    else { lex(src, stop + 1, push(acc, TQuoted(string_of_bytes(piece)))) }
  }
}

reuse fn lex_param(src: Bytes, i: Int, acc: List<Tok>) -> Result<List<Tok>, DbError> = {
  let end = scan_set(src, i + 1, sql_digits());
  if end == i + 1 { Err(unsupported("a dollar-quoted string, or a `$` that is not a parameter")) } else {
    match int_of_string(string_of_bytes(bytes_slice(src, i + 1, end))) {
      None -> Err(unsupported("a parameter number too large to read")),
      Some(n) -> lex(src, end, push(acc, TParam(n))),
    }
  }
}

reuse fn lex_symbol(src: Bytes, i: Int, acc: List<Tok>) -> Result<List<Tok>, DbError> = {
  let c = byte_at(src, i);
  let d = byte_at(src, i + 1);
  let two = if (c == 60 && d == 62) || (c == 33 && d == 61) { "<>" }
  else if c == 60 && d == 61 { "<=" }
  else if c == 62 && d == 61 { ">=" }
  else { "" };
  if two != "" { lex(src, i + 2, push(acc, TSym(two))) } else if c == 40 || c == 41 || c == 44
      || c == 42
      || c == 61
      || c == 60
      || c == 62
      || c == 46
      || c == 45
      || c == 43 { lex(src, i + 1, push(acc, TSym(string_of_bytes(bytes_slice(src, i, i + 1))))) } else {
    Err(
      unsupported(
        "the token `" ++ string_of_bytes_lossy(bytes_slice(src, i, i + 1)) ++ "` at byte "
          ++ int_to_string(i),
      ),
    )
  }
}

fn int_of_string(s: String) -> Option<Int> = {
  let d = decimal_of_string(s)?;
  int_of_decimal(d, Down)
}

// --- The statement, as the twin understands it -----------------------------------

// One item of a select list: the column it reads and the name it comes back under.
type Target = { column: String, name: String }

type Proj = | PStar | PCols(List<Target>) | PCount(String)

type Cmp = | CmpEq | CmpNe | CmpLt | CmpLe | CmpGt | CmpGe

type Expr =
  | XCol(String)
  | XParam(Int)
  | XLit(Datum)
  | XDefault
  | XNot(Expr)
  | XAnd(Expr, Expr)
  | XOr(Expr, Expr)
  | XCompare(Cmp, Expr, Expr)
  | XIsNull(Expr, Bool)
  | XIn(Expr, List<Expr>, Bool)
  | XBetween(Expr, Expr, Expr, Bool)
  | XLike(Expr, Expr, Bool)

type OrderKey = { column: String, desc: Bool, nulls_first: Bool }

type SelectQ = {
  source: String,
  proj: Proj,
  filter: Option<Expr>,
  order: List<OrderKey>,
  limit: Option<Expr>,
  offset: Option<Expr>,
}

type InsertQ = {
  source: String,
  columns: List<String>,
  tuples: List<List<Expr>>,
  returning: Option<Proj>,
}

type Assign = { column: String, value: Expr }

type UpdateQ = { source: String, sets: List<Assign>, filter: Option<Expr>, returning: Option<Proj> }

type DeleteQ = { source: String, filter: Option<Expr>, returning: Option<Proj> }

type Query = | QSelect(SelectQ) | QInsert(InsertQ) | QUpdate(UpdateQ) | QDelete(DeleteQ)

type Cut<a> = { value: a, rest: List<Tok> }

fn cut<a>(v: a, rest: List<Tok>) -> Cut<a> = { value: v, rest: rest }

fn tok_word(ts: List<Tok>) -> String = match ts { [TWord(w), ..] -> w, _ -> "" }

fn tok_sym(ts: List<Tok>) -> String = match ts { [TSym(s), ..] -> s, _ -> "" }

fn rest_of(ts: List<Tok>) -> List<Tok> = match ts { [] -> [], [_, ..t] -> t }

fn expected(what: String, ts: List<Tok>) -> DbError =
  unsupported("expected " ++ what ++ ", found " ++ show_tok(ts))

fn show_tok(ts: List<Tok>) -> String =
  match ts {
    [] -> "the end of the statement",
    [TWord(w), ..] -> "`" ++ w ++ "`",
    [TQuoted(w), ..] -> "`\"" ++ w ++ "\"`",
    [TStr(_), ..] -> "a string literal",
    [TNum(n), ..] -> "`" ++ n ++ "`",
    [TParam(n), ..] -> "`$" ++ int_to_string(n) ++ "`",
    [TSym(s), ..] -> "`" ++ s ++ "`",
    // Unreachable: the six above are every constructor.
    _ -> "a token",
  }

fn want_word(ts: List<Tok>, w: String) -> Result<List<Tok>, DbError> =
  if tok_word(ts) == w { Ok(rest_of(ts)) } else { Err(expected("`" ++ w ++ "`", ts)) }

fn want_sym(ts: List<Tok>, s: String) -> Result<List<Tok>, DbError> =
  if tok_sym(ts) == s { Ok(rest_of(ts)) } else { Err(expected("`" ++ s ++ "`", ts)) }

fn parse_name(ts: List<Tok>) -> Result<Cut<String>, DbError> =
  match ts {
    [TWord(w), ..t] -> Ok(cut(w, t)),
    [TQuoted(w), ..t] -> Ok(cut(w, t)),
    _ -> Err(expected("a name", ts)),
  }

// `t.c` names the column `c`.
fn parse_colref(ts: List<Tok>) -> Result<Cut<String>, DbError> = {
  let c = parse_name(ts)?;
  if tok_sym(c.rest) == "." { parse_name(rest_of(c.rest)) } else { Ok(c) }
}

fn parse_expr_text(s: String) -> Result<Expr, DbError> = {
  let ts = lex_all(s)?;
  let c = parse_or(ts)?;
  if len(c.rest) == 0 { Ok(c.value) } else { Err(expected("the end of the expression", c.rest)) }
}

fn parse_or(ts: List<Tok>) -> Result<Cut<Expr>, DbError> = parse_or_more(parse_and(ts)?)

fn parse_or_more(c: Cut<Expr>) -> Result<Cut<Expr>, DbError> =
  if tok_word(c.rest) == "or" {
    let r = parse_and(rest_of(c.rest))?;
    parse_or_more(cut(XOr(c.value, r.value), r.rest))
  } else { Ok(c) }

fn parse_and(ts: List<Tok>) -> Result<Cut<Expr>, DbError> = parse_and_more(parse_not(ts)?)

fn parse_and_more(c: Cut<Expr>) -> Result<Cut<Expr>, DbError> =
  if tok_word(c.rest) == "and" {
    let r = parse_not(rest_of(c.rest))?;
    parse_and_more(cut(XAnd(c.value, r.value), r.rest))
  } else { Ok(c) }

fn parse_not(ts: List<Tok>) -> Result<Cut<Expr>, DbError> =
  if tok_word(ts) == "not" {
    let c = parse_not(rest_of(ts))?;
    Ok(cut(XNot(c.value), c.rest))
  } else { parse_pred_tail(parse_primary(ts)?) }

fn parse_pred_tail(c: Cut<Expr>) -> Result<Cut<Expr>, DbError> = {
  let w = tok_word(c.rest);
  let s = tok_sym(c.rest);
  if s == "=" || s == "<>" || s == "<" || s == "<=" || s == ">" || s == ">=" {
    let r = parse_primary(rest_of(c.rest))?;
    Ok(cut(XCompare(cmp_of(s), c.value, r.value), r.rest))
  } else if w == "is" { parse_is(c, rest_of(c.rest)) }
  else if w == "in" { parse_in(c, false, rest_of(c.rest)) }
  else if w == "between" { parse_between(c, false, rest_of(c.rest)) }
  else if w == "like" { parse_like(c, false, rest_of(c.rest)) } else if w == "not" {
    let after = rest_of(c.rest);
    let w2 = tok_word(after);
    if w2 == "in" { parse_in(c, true, rest_of(after)) }
    else if w2 == "between" { parse_between(c, true, rest_of(after)) }
    else if w2 == "like" { parse_like(c, true, rest_of(after)) }
    else { Err(expected("`in`, `between` or `like` after `not`", after)) }
  } else { Ok(c) }
}

fn cmp_of(s: String) -> Cmp =
  if s == "=" { CmpEq }
  else if s == "<>" { CmpNe }
  else if s == "<" { CmpLt }
  else if s == "<=" { CmpLe }
  else if s == ">" { CmpGt }
  else { CmpGe }

fn parse_is(c: Cut<Expr>, ts: List<Tok>) -> Result<Cut<Expr>, DbError> =
  if tok_word(ts) == "null" { Ok(cut(XIsNull(c.value, true), rest_of(ts))) } else if tok_word(ts)
      == "not"
      && tok_word(rest_of(ts)) == "null" { Ok(cut(XIsNull(c.value, false), rest_of(rest_of(ts)))) }
  else { Err(expected("`null` or `not null` after `is`", ts)) }

fn parse_in(c: Cut<Expr>, negated: Bool, ts: List<Tok>) -> Result<Cut<Expr>, DbError> = {
  let after = want_sym(ts, "(")?;
  let items = parse_expr_list(after, [])?;
  Ok(cut(XIn(c.value, items.value, negated), items.rest))
}

fn parse_expr_list(ts: List<Tok>, acc: List<Expr>) -> Result<Cut<List<Expr>>, DbError> = {
  let c = parse_or(ts)?;
  let items = push(acc, c.value);
  if tok_sym(c.rest) == "," { parse_expr_list(rest_of(c.rest), items) } else {
    let after = want_sym(c.rest, ")")?;
    Ok(cut(items, after))
  }
}

fn parse_between(c: Cut<Expr>, negated: Bool, ts: List<Tok>) -> Result<Cut<Expr>, DbError> = {
  let lo = parse_primary(ts)?;
  let after = want_word(lo.rest, "and")?;
  let hi = parse_primary(after)?;
  Ok(cut(XBetween(c.value, lo.value, hi.value, negated), hi.rest))
}

fn parse_like(c: Cut<Expr>, negated: Bool, ts: List<Tok>) -> Result<Cut<Expr>, DbError> = {
  let p = parse_primary(ts)?;
  if tok_word(p.rest) == "escape" { Err(unsupported("`like ... escape`")) }
  else { Ok(cut(XLike(c.value, p.value, negated), p.rest)) }
}

fn parse_primary(ts: List<Tok>) -> Result<Cut<Expr>, DbError> =
  match ts {
    [] -> Err(unsupported("the statement ended where a value was expected")),
    [TParam(n), ..t] -> Ok(cut(XParam(n), t)),
    [TStr(s), ..t] -> Ok(cut(XLit(CText(s)), t)),
    [TNum(s), ..t] -> num_literal(s, false, t),
    [TQuoted(w), ..t] -> parse_column_tail(w, t),
    [TSym(s), ..t] -> if s == "(" {
      let c = parse_or(t)?;
      let after = want_sym(c.rest, ")")?;
      Ok(cut(c.value, after))
    } else if s == "-" {
      match t {
        [TNum(n), ..t2] -> num_literal(n, true, t2),
        _ -> Err(expected("a number after `-`", t)),
      }
    } else { Err(expected("a value", ts)) },
    [TWord(w), ..t] -> if w == "null" { Ok(cut(XLit(CNull), t)) }
    else if w == "true" { Ok(cut(XLit(CBool(true)), t)) }
    else if w == "false" { Ok(cut(XLit(CBool(false)), t)) }
    else if w == "default" { Ok(cut(XDefault, t)) } else if w == "count" || w == "sum" || w == "avg"
        || w == "min"
        || w == "max" {
      Err(unsupported("the aggregate `" ++ w ++ "` outside a bare `count(*)` projection"))
    } else if w == "select" { Err(unsupported("a subquery")) }
    else { parse_column_tail(w, t) },
    _ -> Err(expected("a value", ts)),
  }

fn parse_column_tail(name: String, ts: List<Tok>) -> Result<Cut<Expr>, DbError> =
  if tok_sym(ts) == "." {
    let c = parse_name(rest_of(ts))?;
    Ok(cut(XCol(c.value), c.rest))
  } else if tok_sym(ts) == "(" { Err(unsupported("the function `" ++ name ++ "`")) }
  else { Ok(cut(XCol(name), ts)) }

// A literal with a `.` is `numeric` and one without is `integer`, as in postgres.
fn num_literal(s: String, negative: Bool, ts: List<Tok>) -> Result<Cut<Expr>, DbError> = {
  let text = if negative { "-" ++ s } else { s };
  if string_contains(s, ".") {
    match decimal_of_string(text) {
      None -> Err(unsupported("the numeric literal `" ++ text ++ "`")),
      Some(d) -> Ok(cut(XLit(CNumeric(d)), ts)),
    }
  } else {
    match int_of_string(text) {
      None -> Err(unsupported("the integer literal `" ++ text ++ "`")),
      Some(n) -> Ok(cut(XLit(CInt(n)), ts)),
    }
  }
}

// --- The statement parser --------------------------------------------------------

fn parse_statement(sql: String) -> Result<Query, DbError> = {
  let ts = lex_all(sql)?;
  let c = parse_query(ts)?;
  if len(c.rest) == 0 { Ok(c.value) } else { Err(expected("the end of the statement", c.rest)) }
}

fn parse_query(ts: List<Tok>) -> Result<Cut<Query>, DbError> = {
  let w = tok_word(ts);
  if w == "select" { parse_select(rest_of(ts)) }
  else if w == "insert" { parse_insert(rest_of(ts)) }
  else if w == "update" { parse_update(rest_of(ts)) }
  else if w == "delete" { parse_delete(rest_of(ts)) }
  else if w == "with" { Err(unsupported("a common table expression")) }
  else if w == "values" { Err(unsupported("a bare `values` statement")) }
  else { Err(expected("`select`, `insert`, `update` or `delete`", ts)) }
}

fn parse_select(ts: List<Tok>) -> Result<Cut<Query>, DbError> = {
  let p = parse_proj(ts)?;
  let after = want_word(p.rest, "from")?;
  let src = parse_name(after)?;
  parse_select_tail(src.value, p.value, src.rest)
}

fn parse_select_tail(source: String, proj: Proj, ts: List<Tok>) -> Result<Cut<Query>, DbError> = {
  let w = parse_where(ts)?;
  let o = parse_order(w.rest)?;
  let lo = parse_limit_offset(o.rest)?;
  Ok(
    cut(
      QSelect({
        source: source,
        proj: proj,
        filter: w.value,
        order: o.value,
        limit: lo.value.limit,
        offset: lo.value.offset,
      }),
      lo.rest,
    ),
  )
}

fn parse_proj(ts: List<Tok>) -> Result<Cut<Proj>, DbError> =
  if tok_sym(ts) == "*" { Ok(cut(PStar, rest_of(ts))) } else if tok_word(ts) == "count" {
    let a = want_sym(rest_of(ts), "(")?;
    match want_sym(a, "*") {
      Err(_) -> Err(unsupported("`count` of anything but `*`")),
      Ok(b) -> {
        let c = want_sym(b, ")")?;
        let a = parse_alias(c, "count")?;
        Ok(cut(PCount(a.value), a.rest))
      },
    }
  } else { parse_proj_columns(ts, []) }

fn parse_proj_columns(ts: List<Tok>, acc: List<Target>) -> Result<Cut<Proj>, DbError> = {
  let c = parse_colref(ts)?;
  let a = parse_alias(c.rest, c.value)?;
  let targets = push(acc, { column: c.value, name: a.value });
  if tok_sym(a.rest) == "," { parse_proj_columns(rest_of(a.rest), targets) }
  else { Ok(cut(PCols(targets), a.rest)) }
}

fn parse_alias(ts: List<Tok>, dflt: String) -> Result<Cut<String>, DbError> =
  if tok_word(ts) == "as" {
    let n = parse_name(rest_of(ts))?;
    Ok(cut(n.value, n.rest))
  } else { Ok(cut(dflt, ts)) }

fn parse_where(ts: List<Tok>) -> Result<Cut<Option<Expr>>, DbError> =
  if tok_word(ts) == "where" {
    let c = parse_or(rest_of(ts))?;
    Ok(cut(Some(c.value), c.rest))
  } else { Ok(cut(None, ts)) }

fn parse_order(ts: List<Tok>) -> Result<Cut<List<OrderKey>>, DbError> =
  if tok_word(ts) == "order" {
    let after = want_word(rest_of(ts), "by")?;
    parse_order_keys(after, [])
  } else { Ok(cut([], ts)) }

fn parse_order_keys(ts: List<Tok>, acc: List<OrderKey>) -> Result<Cut<List<OrderKey>>, DbError> = {
  let c = parse_colref(ts)?;
  let dir = tok_word(c.rest);
  let desc = dir == "desc";
  let after_dir = if dir == "asc" || dir == "desc" { rest_of(c.rest) } else { c.rest };
  {
    let n = parse_nulls(after_dir, desc)?;
    let keys = push(acc, { column: c.value, desc: desc, nulls_first: n.value });
    if tok_sym(n.rest) == "," { parse_order_keys(rest_of(n.rest), keys) }
    else { Ok(cut(keys, n.rest)) }
  }
}

// Postgres's default is `NULLS LAST` under `ASC` and `NULLS FIRST` under `DESC`.
fn parse_nulls(ts: List<Tok>, desc: Bool) -> Result<Cut<Bool>, DbError> =
  if tok_word(ts) == "nulls" {
    let w = tok_word(rest_of(ts));
    if w == "first" { Ok(cut(true, rest_of(rest_of(ts)))) }
    else if w == "last" { Ok(cut(false, rest_of(rest_of(ts)))) }
    else { Err(expected("`first` or `last` after `nulls`", rest_of(ts))) }
  } else { Ok(cut(desc, ts)) }

type Slice = { limit: Option<Expr>, offset: Option<Expr> }

fn parse_limit_offset(ts: List<Tok>) -> Result<Cut<Slice>, DbError> = {
  let l = parse_one_bound(ts, "limit")?;
  let o = parse_one_bound(l.rest, "offset")?;
  Ok(cut({ limit: l.value, offset: o.value }, o.rest))
}

fn parse_one_bound(ts: List<Tok>, word: String) -> Result<Cut<Option<Expr>>, DbError> =
  if tok_word(ts) == word {
    let c = parse_primary(rest_of(ts))?;
    Ok(cut(Some(c.value), c.rest))
  } else { Ok(cut(None, ts)) }

fn parse_insert(ts: List<Tok>) -> Result<Cut<Query>, DbError> = {
  let a = want_word(ts, "into")?;
  let src = parse_name(a)?;
  let cols = parse_insert_columns(src.rest)?;
  match want_word(cols.rest, "values") {
    Err(_) -> Err(unsupported("an `insert` whose source is not a `values` list")),
    Ok(b) -> {
      let tuples = parse_tuples(b, [])?;
      let r = parse_returning(tuples.rest)?;
      Ok(
        cut(
          QInsert({
            source: src.value,
            columns: cols.value,
            tuples: tuples.value,
            returning: r.value,
          }),
          r.rest,
        ),
      )
    },
  }
}

fn parse_insert_columns(ts: List<Tok>) -> Result<Cut<List<String>>, DbError> =
  if tok_sym(ts) == "(" { parse_name_list(rest_of(ts), []) } else { Ok(cut([], ts)) }

fn parse_name_list(ts: List<Tok>, acc: List<String>) -> Result<Cut<List<String>>, DbError> = {
  let c = parse_name(ts)?;
  let names = push(acc, c.value);
  if tok_sym(c.rest) == "," { parse_name_list(rest_of(c.rest), names) } else {
    let after = want_sym(c.rest, ")")?;
    Ok(cut(names, after))
  }
}

fn parse_tuples(ts: List<Tok>, acc: List<List<Expr>>) -> Result<Cut<List<List<Expr>>>, DbError> = {
  let a = want_sym(ts, "(")?;
  let c = parse_expr_list(a, [])?;
  let tuples = push(acc, c.value);
  if tok_sym(c.rest) == "," { parse_tuples(rest_of(c.rest), tuples) }
  else { Ok(cut(tuples, c.rest)) }
}

fn parse_returning(ts: List<Tok>) -> Result<Cut<Option<Proj>>, DbError> =
  if tok_word(ts) == "returning" {
    let c = parse_proj(rest_of(ts))?;
    match c.value {
      PCount(_) -> Err(unsupported("`returning count(*)`")),
      PStar -> Ok(cut(Some(c.value), c.rest)),
      PCols(_) -> Ok(cut(Some(c.value), c.rest)),
    }
  } else { Ok(cut(None, ts)) }

fn parse_update(ts: List<Tok>) -> Result<Cut<Query>, DbError> = {
  let src = parse_name(ts)?;
  let a = want_word(src.rest, "set")?;
  let sets = parse_assignments(a, [])?;
  if tok_word(sets.rest) == "from" { Err(unsupported("`update ... from`")) } else {
    let w = parse_where(sets.rest)?;
    let r = parse_returning(w.rest)?;
    Ok(
      cut(
        QUpdate({ source: src.value, sets: sets.value, filter: w.value, returning: r.value }),
        r.rest,
      ),
    )
  }
}

fn parse_assignments(ts: List<Tok>, acc: List<Assign>) -> Result<Cut<List<Assign>>, DbError> = {
  let n = parse_name(ts)?;
  let a = want_sym(n.rest, "=")?;
  let v = parse_primary(a)?;
  let sets = push(acc, { column: n.value, value: v.value });
  if tok_sym(v.rest) == "," { parse_assignments(rest_of(v.rest), sets) }
  else { Ok(cut(sets, v.rest)) }
}

fn parse_delete(ts: List<Tok>) -> Result<Cut<Query>, DbError> = {
  let a = want_word(ts, "from")?;
  let src = parse_name(a)?;
  if tok_word(src.rest) == "using" { Err(unsupported("`delete ... using`")) } else {
    let w = parse_where(src.rest)?;
    let r = parse_returning(w.rest)?;
    Ok(cut(QDelete({ source: src.value, filter: w.value, returning: r.value }), r.rest))
  }
}

// --- Evaluating an expression ----------------------------------------------------

type Tri = | TriTrue | TriFalse | TriUnknown

fn tri_of(b: Bool) -> Tri = if b { TriTrue } else { TriFalse }

fn is_null(v: Datum) -> Bool = match v { CNull -> true, _ -> false }

fn tri_not(t: Tri) -> Tri =
  match t { TriTrue -> TriFalse, TriFalse -> TriTrue, TriUnknown -> TriUnknown }

fn tri_and(a: Tri, b: Tri) -> Tri =
  match a {
    TriFalse -> TriFalse,
    TriTrue -> b,
    TriUnknown -> match b { TriFalse -> TriFalse, _ -> TriUnknown },
  }

fn tri_or(a: Tri, b: Tri) -> Tri =
  match a {
    TriTrue -> TriTrue,
    TriFalse -> b,
    TriUnknown -> match b { TriTrue -> TriTrue, _ -> TriUnknown },
  }

pub fn param_datum(p: Param) -> Datum =
  match p {
    PNull -> CNull,
    PInt(n) -> CInt(n),
    PBool(b) -> CBool(b),
    PText(s) -> CText(s),
    PBytes(b) -> CBytes(b),
    PFloat(f) -> CFloat(f),
    PNumeric(d) -> CNumeric(d),
    PJson(j) -> CJson(j),
    PArray(xs) -> CArray(map(xs, |x: Param| param_datum(x))),
  }

fn datum_type(v: Datum) -> String =
  match v {
    CNull -> "unknown",
    CInt(_) -> "bigint",
    CBool(_) -> "boolean",
    CText(_) -> "text",
    CBytes(_) -> "bytea",
    CFloat(_) -> "double precision",
    CNumeric(_) -> "numeric",
    CJson(_) -> "jsonb",
    CArray(_) -> "array",
  }

fn eval_value(r: Row, ps: List<Param>, e: Expr) -> Result<Datum, DbError> =
  match e {
    XLit(v) -> Ok(v),
    XCol(n) -> match map_get(r, n) { None -> Err(undefined_column(n)), Some(v) -> Ok(v) },
    XParam(n) -> match nth(ps, n - 1) {
      None -> Err(db_error("42P02", "", "there is no parameter $" ++ int_to_string(n))),
      Some(p) -> Ok(param_datum(p)),
    },
    XDefault -> Err(unsupported("`default` outside an `insert ... values` list")),
    XNot(_) -> eval_bool_value(r, ps, e),
    XAnd(_, _) -> eval_bool_value(r, ps, e),
    XOr(_, _) -> eval_bool_value(r, ps, e),
    XCompare(_, _, _) -> eval_bool_value(r, ps, e),
    XIsNull(_, _) -> eval_bool_value(r, ps, e),
    XIn(_, _, _) -> eval_bool_value(r, ps, e),
    XBetween(_, _, _, _) -> eval_bool_value(r, ps, e),
    XLike(_, _, _) -> eval_bool_value(r, ps, e),
  }

fn eval_bool_value(r: Row, ps: List<Param>, e: Expr) -> Result<Datum, DbError> = {
  let t = eval_pred(r, ps, e)?;
  Ok(match t { TriTrue -> CBool(true), TriFalse -> CBool(false), TriUnknown -> CNull })
}

fn eval_pred(r: Row, ps: List<Param>, e: Expr) -> Result<Tri, DbError> =
  match e {
    XNot(x) -> {
      let t = eval_pred(r, ps, x)?;
      Ok(tri_not(t))
    },
    XAnd(a, b) -> {
      let ta = eval_pred(r, ps, a)?;
      let tb = eval_pred(r, ps, b)?;
      Ok(tri_and(ta, tb))
    },
    XOr(a, b) -> {
      let ta = eval_pred(r, ps, a)?;
      let tb = eval_pred(r, ps, b)?;
      Ok(tri_or(ta, tb))
    },
    XCompare(op, a, b) -> eval_compare(r, ps, op, a, b),
    XIsNull(x, want) -> {
      let v = eval_value(r, ps, x)?;
      Ok(tri_of(if want { is_null(v) } else { !is_null(v) }))
    },
    XIn(x, items, negated) -> eval_in(r, ps, x, items, negated),
    XBetween(x, lo, hi, negated) -> eval_between(r, ps, x, lo, hi, negated),
    XLike(x, p, negated) -> eval_like(r, ps, x, p, negated),
    XLit(_) -> eval_pred_of_value(r, ps, e),
    XCol(_) -> eval_pred_of_value(r, ps, e),
    XParam(_) -> eval_pred_of_value(r, ps, e),
    XDefault -> Err(unsupported("`default` in a predicate")),
  }

fn eval_pred_of_value(r: Row, ps: List<Param>, e: Expr) -> Result<Tri, DbError> = {
  let v = eval_value(r, ps, e)?;
  match v {
    CNull -> Ok(TriUnknown),
    CBool(b) -> Ok(tri_of(b)),
    _ ->
      Err(db_error("42804", "", "argument of a condition must be boolean, not " ++ datum_type(v))),
  }
}

fn eval_compare(r: Row, ps: List<Param>, op: Cmp, a: Expr, b: Expr) -> Result<Tri, DbError> = {
  let av = eval_value(r, ps, a)?;
  let bv = eval_value(r, ps, b)?;
  let o = datum_cmp(av, bv)?;
  match o {
    None -> Ok(TriUnknown),
    Some(c) ->
      Ok(
        tri_of(match op {
          CmpEq -> c == 0,
          CmpNe -> c != 0,
          CmpLt -> c < 0,
          CmpLe -> c <= 0,
          CmpGt -> c > 0,
          CmpGe -> c >= 0,
        }),
      ),
  }
}

fn eval_in(
  r: Row,
  ps: List<Param>,
  x: Expr,
  items: List<Expr>,
  negated: Bool,
) -> Result<Tri, DbError> = {
  let v = eval_value(r, ps, x)?;
  let t = in_scan(r, ps, v, items, TriFalse)?;
  Ok(if negated { tri_not(t) } else { t })
}

fn in_scan(
  r: Row,
  ps: List<Param>,
  v: Datum,
  items: List<Expr>,
  so_far: Tri,
) -> Result<Tri, DbError> =
  match items {
    [] -> Ok(so_far),
    [h, ..t] -> {
      let hv = eval_value(r, ps, h)?;
      let o = datum_cmp(v, hv)?;
      match o {
        None -> in_scan(r, ps, v, t, tri_or(so_far, TriUnknown)),
        Some(c) -> if c == 0 { Ok(TriTrue) } else { in_scan(r, ps, v, t, so_far) },
      }
    },
  }

fn eval_between(
  r: Row,
  ps: List<Param>,
  x: Expr,
  lo: Expr,
  hi: Expr,
  negated: Bool,
) -> Result<Tri, DbError> = {
  let a = eval_compare(r, ps, CmpGe, x, lo)?;
  let b = eval_compare(r, ps, CmpLe, x, hi)?;
  Ok(if negated { tri_not(tri_and(a, b)) } else { tri_and(a, b) })
}

fn eval_like(r: Row, ps: List<Param>, x: Expr, p: Expr, negated: Bool) -> Result<Tri, DbError> = {
  let xv = eval_value(r, ps, x)?;
  let pv = eval_value(r, ps, p)?;
  like_of(xv, pv, negated)
}

fn like_of(xv: Datum, pv: Datum, negated: Bool) -> Result<Tri, DbError> =
  match xv {
    CNull -> Ok(TriUnknown),
    CText(s) -> match pv {
      CNull -> Ok(TriUnknown),
      CText(p) -> {
        let hit = like_match(s, p, 0, 0);
        Ok(tri_of(if negated { !hit } else { hit }))
      },
      _ -> Err(db_error("42883", "", "operator does not exist: text like " ++ datum_type(pv))),
    },
    _ -> Err(db_error("42883", "", "operator does not exist: " ++ datum_type(xv) ++ " like ...")),
  }

// `_` matches one character, not one byte, or non-ASCII text stops matching.
fn like_match(s: String, p: String, si: Int, pi: Int) -> Bool =
  if pi >= string_len(p) { si >= string_len(s) } else {
    let pc = string_slice(p, pi, pi + 1);
    if pc == "%" { like_star(s, p, si, pi + 1) }
    else if pc == "_" { if si >= string_len(s) { false } else { like_match(s, p, si + 1, pi + 1) } } else if pc
        == "\\" {
      if pi + 1 >= string_len(p) { false } else if si < string_len(s)
          && string_slice(s, si, si + 1) == string_slice(p, pi + 1, pi + 2) {
        like_match(s, p, si + 1, pi + 2)
      } else { false }
    } else if si < string_len(s) && string_slice(s, si, si + 1) == pc {
      like_match(s, p, si + 1, pi + 1)
    } else { false }
  }

fn like_star(s: String, p: String, si: Int, pi: Int) -> Bool =
  if like_match(s, p, si, pi) { true }
  else if si >= string_len(s) { false }
  else { like_star(s, p, si + 1, pi) }

fn ord_int(o: Ordering) -> Int = match o { Less -> -1, Equal -> 0, Greater -> 1 }

fn sign_of(a: Int, b: Int) -> Int = if a < b { -1 } else if a > b { 1 } else { 0 }

fn float_cmp(a: Float, b: Float) -> Int =
  if a != a { if b != b { 0 } else { 1 } }
  else if b != b { -1 }
  else if a < b { -1 }
  else if a > b { 1 }
  else { 0 }

fn decimal_cmp(a: Decimal, b: Decimal) -> Int = if a < b { -1 } else if a > b { 1 } else { 0 }

// `None` is SQL's unknown: a comparison with a `NULL` operand has no answer.
fn datum_cmp(a: Datum, b: Datum) -> Result<Option<Int>, DbError> =
  match a {
    CNull -> Ok(None),
    CInt(x) -> match b {
      CNull -> Ok(None),
      CInt(y) -> Ok(Some(sign_of(x, y))),
      CNumeric(y) -> Ok(Some(decimal_cmp(decimal_of_int(x), y))),
      CFloat(y) -> Ok(Some(float_cmp(float_of_decimal(decimal_of_int(x)), y))),
      _ -> Err(no_operator(a, b)),
    },
    CNumeric(x) -> match b {
      CNull -> Ok(None),
      CNumeric(y) -> Ok(Some(decimal_cmp(x, y))),
      CInt(y) -> Ok(Some(decimal_cmp(x, decimal_of_int(y)))),
      CFloat(y) -> Ok(Some(float_cmp(float_of_decimal(x), y))),
      _ -> Err(no_operator(a, b)),
    },
    CFloat(x) -> match b {
      CNull -> Ok(None),
      CFloat(y) -> Ok(Some(float_cmp(x, y))),
      CInt(y) -> Ok(Some(float_cmp(x, float_of_decimal(decimal_of_int(y))))),
      CNumeric(y) -> Ok(Some(float_cmp(x, float_of_decimal(y)))),
      _ -> Err(no_operator(a, b)),
    },
    CText(x) -> match b {
      CNull -> Ok(None),
      CText(y) -> Ok(Some(ord_int(compare(x, y)))),
      _ -> Err(no_operator(a, b)),
    },
    CBool(x) -> match b {
      CNull -> Ok(None),
      CBool(y) -> Ok(Some(sign_of(if x { 1 } else { 0 }, if y { 1 } else { 0 }))),
      _ -> Err(no_operator(a, b)),
    },
    CBytes(x) -> match b {
      CNull -> Ok(None),
      CBytes(y) -> Ok(Some(ord_int(compare(x, y)))),
      _ -> Err(no_operator(a, b)),
    },
    CJson(_) -> Err(unsupported("comparing `jsonb`")),
    CArray(_) -> Err(unsupported("comparing an array")),
  }

fn no_operator(a: Datum, b: Datum) -> DbError =
  db_error("42883", "", "operator does not exist: " ++ datum_type(a) ++ " = " ++ datum_type(b))

// --- Column types, and what a value has to become to be stored -------------------

fn decimal_scale_of(d: Decimal) -> Int = {
  let s = decimal_to_string(d);
  if string_contains(s, ".") { string_len(s) - string_find(s, ".") - 1 } else { 0 }
}

fn zeros(n: Int) -> String = fold(range(0, n), "", |acc: String, i: Int| acc ++ "0")

// A `numeric(p, s)` column stores exactly `s` fractional digits: `1.00` becomes `1.0000`.
fn rescale(d: Decimal, s: Int) -> Option<Decimal> = {
  let reduced = if decimal_scale_of(d) > s { decimal_round(d, s, HalfUp) } else { d };
  let text = decimal_to_string(reduced);
  let have = decimal_scale_of(reduced);
  if have >= s { decimal_of_string(text) }
  else if have == 0 { decimal_of_string(if s > 0 { text ++ "." ++ zeros(s) } else { text }) }
  else { decimal_of_string(text ++ zeros(s - have)) }
}

fn strip_leading_zeros(s: String) -> String =
  if string_len(s) > 1 && string_starts_with(s, "0") {
    strip_leading_zeros(string_slice(s, 1, string_len(s)))
  } else if s == "0" { "" }
  else { s }

fn numeric_fits(d: Decimal, p: Int, s: Int) -> Bool = {
  let text = decimal_to_string(d);
  let unsigned = if string_starts_with(text, "-") { string_slice(text, 1, string_len(text)) }
  else { text };
  let whole = if string_contains(unsigned, ".") {
    string_slice(unsigned, 0, string_find(unsigned, "."))
  } else { unsigned };
  string_len(strip_leading_zeros(whole)) <= p - s
}

fn is_text(v: Datum) -> Bool = match v { CText(_) -> true, _ -> false }

// A string literal in statement text is `unknown`-typed and coerced, so a bad one is `22P02`.
fn wrong_type(c: Column, v: Datum, from_param: Bool, want: String) -> DbError =
  if !from_param && is_text(v) { db_error("22P02", "", "invalid input syntax for type " ++ want) } else {
    db_error(
      "42804",
      "",
      "column \"" ++ c.name ++ "\" is of type " ++ want ++ " but expression is of type "
        ++ datum_type(v),
    )
  }

fn coerce(c: Column, ty: ColumnType, v: Datum, from_param: Bool) -> Result<Datum, DbError> =
  match v { CNull -> Ok(CNull), _ -> coerce_value(c, ty, v, from_param) }

// The name postgres prints for a column type in a `22P02` or `42804`.
pub fn type_name(ty: ColumnType) -> String =
  match ty {
    TInt -> "bigint",
    TBool -> "boolean",
    TText -> "text",
    TBytes -> "bytea",
    TFloat -> "double precision",
    TNumeric(_, _) -> "numeric",
    TJson -> "jsonb",
    TArray(_) -> "array",
  }

// Postgres parses an `unknown` string at the type it is assigned or compared to.
fn coerce_value(c: Column, ty: ColumnType, v: Datum, from_param: Bool) -> Result<Datum, DbError> =
  match v {
    CText(s) -> if from_param { coerce_typed(c, ty, v, from_param) }
    else { coerce_unknown(c, ty, s) },
    _ -> coerce_typed(c, ty, v, from_param),
  }

fn coerce_unknown(c: Column, ty: ColumnType, s: String) -> Result<Datum, DbError> =
  match unknown_datum(ty, s) {
    None -> Err(bad_input(ty, s)),
    Some(v) -> coerce_typed(c, ty, v, false),
  }

fn bad_input(ty: ColumnType, s: String) -> DbError =
  db_error("22P02", "", "invalid input syntax for type " ++ type_name(ty) ++ ": \"" ++ s ++ "\"")

// What an `unknown` literal becomes at a given type, or `None` when postgres would refuse the text.
fn unknown_datum(ty: ColumnType, s: String) -> Option<Datum> =
  match ty {
    TInt -> {
      let n = whole_of_string(s)?;
      Some(CInt(n))
    },
    TBool -> unknown_bool(s),
    TText -> Some(CText(s)),
    TFloat -> {
      let d = decimal_of_string(s)?;
      Some(CFloat(float_of_decimal(d)))
    },
    TNumeric(_, _) -> {
      let d = decimal_of_string(s)?;
      Some(CNumeric(d))
    },
    TBytes -> None,
    TJson -> None,
    TArray(_) -> None,
  }

// Text is read at the target type, so `'2.6'` as `bigint` is refused rather than rounded.
fn whole_of_string(s: String) -> Option<Int> = {
  let d = decimal_of_string(s)?;
  let n = int_of_decimal(d, Down)?;
  if decimal_of_int(n) == d { Some(n) } else { None }
}

fn unknown_bool(s: String) -> Option<Datum> = {
  let t = string_lower(s);
  if t == "t" || t == "true" || t == "yes" || t == "on" || t == "1" { Some(CBool(true)) }
  else if t == "f" || t == "false" || t == "no" || t == "off" || t == "0" { Some(CBool(false)) }
  else { None }
}

fn coerce_typed(c: Column, ty: ColumnType, v: Datum, from_param: Bool) -> Result<Datum, DbError> =
  match ty {
    TInt -> match v {
      CInt(_) -> Ok(v),
      // Postgres's assignment cast rounds half away from zero: `2.5` is `3`, `-2.5` is `-3`.
      CNumeric(d) -> int_from_decimal(d),
      _ -> Err(wrong_type(c, v, from_param, "bigint")),
    },
    TBool -> match v { CBool(_) -> Ok(v), _ -> Err(wrong_type(c, v, from_param, "boolean")) },
    TText -> match v { CText(_) -> Ok(v), _ -> Err(wrong_type(c, v, from_param, "text")) },
    TBytes -> match v { CBytes(_) -> Ok(v), _ -> Err(wrong_type(c, v, from_param, "bytea")) },
    TJson -> match v { CJson(_) -> Ok(v), _ -> Err(wrong_type(c, v, from_param, "jsonb")) },
    TFloat -> match v {
      CFloat(_) -> Ok(v),
      CInt(n) -> Ok(CFloat(float_of_decimal(decimal_of_int(n)))),
      CNumeric(d) -> Ok(CFloat(float_of_decimal(d))),
      _ -> Err(wrong_type(c, v, from_param, "double precision")),
    },
    TNumeric(p, s) -> match v {
      CNumeric(d) -> numeric_into(c, d, p, s),
      CInt(n) -> numeric_into(c, decimal_of_int(n), p, s),
      _ -> Err(wrong_type(c, v, from_param, "numeric")),
    },
    TArray(inner) -> match v {
      CArray(xs) -> coerce_elements(c, inner, xs, from_param, []),
      _ -> Err(wrong_type(c, v, from_param, "array")),
    },
  }

fn int_from_decimal(d: Decimal) -> Result<Datum, DbError> =
  match int_of_decimal(decimal_round(d, 0, HalfUp), Down) {
    None -> Err(db_error("22003", "", "bigint out of range")),
    Some(n) -> Ok(CInt(n)),
  }

// Overflow is checked before the rescale, which would exhaust `Decimal` and answer `0A000`.
fn numeric_into(c: Column, d: Decimal, p: Int, s: Int) -> Result<Datum, DbError> =
  if !numeric_fits(d, p, s) { Err(numeric_overflow(p, s)) } else {
    match rescale(d, s) {
      None -> Err(unsupported("a `numeric` outside `Decimal`'s 96 bits or scale 28")),
      Some(r) -> if numeric_fits(r, p, s) { Ok(CNumeric(r)) } else { Err(numeric_overflow(p, s)) },
    }
  }

fn numeric_overflow(p: Int, s: Int) -> DbError =
  db_error(
    "22003",
    "",
    "numeric field overflow: a field with precision " ++ int_to_string(p) ++ ", scale "
      ++ int_to_string(s)
      ++ " must round to an absolute value less than 10^"
      ++ int_to_string(p - s),
  )

fn coerce_elements(
  c: Column,
  inner: ColumnType,
  xs: List<Datum>,
  from_param: Bool,
  acc: List<Datum>,
) -> Result<Datum, DbError> =
  match xs {
    [] -> Ok(CArray(acc)),
    [h, ..t] -> match h {
      CNull -> Err(unsupported("an array with a NULL element")),
      _ -> {
        let v = coerce_value(c, inner, h, from_param)?;
        coerce_elements(c, inner, t, from_param, push(acc, v))
      },
    },
  }

// --- Tables, columns, and the constraint checks ----------------------------------

fn find_table(ts: List<MemTable>, name: String) -> Option<MemTable> =
  match ts {
    [] -> None,
    [h, ..t] -> if h.def.name == name { Some(h) } else { find_table(t, name) },
  }

fn put_table(ts: List<MemTable>, mt: MemTable) -> List<MemTable> =
  map(ts, |x: MemTable| if x.def.name == mt.def.name { mt } else { x })

fn find_column(cs: List<Column>, n: String) -> Option<Column> =
  match cs { [] -> None, [h, ..t] -> if h.name == n { Some(h) } else { find_column(t, n) } }

fn index_of(xs: List<String>, s: String) -> Option<Int> = index_from(xs, s, 0)

fn index_from(xs: List<String>, s: String, i: Int) -> Option<Int> =
  match xs { [] -> None, [h, ..t] -> if h == s { Some(i) } else { index_from(t, s, i + 1) } }

fn cell_of(r: Row, n: String) -> Datum = match map_get(r, n) { None -> CNull, Some(v) -> v }

// A primary key column is not-null whether or not the schema says so.
fn not_null_here(def: Table, c: Column) -> Bool = !c.nullable || has_string(def.primary_key, c.name)

// Postgres's order: not-null, check, unique; referential integrity runs after the statement.
fn validate_row(def: Table, rows: List<Row>, row: Row, skip: Int) -> Option<DbError> =
  match check_not_null(def, def.columns, row) {
    Some(e) -> Some(e),
    None -> match check_checks(def, def.checks, row) {
      Some(e) -> Some(e),
      None -> check_unique(def, rows, row, skip),
    },
  }

fn check_not_null(def: Table, cs: List<Column>, row: Row) -> Option<DbError> =
  match cs {
    [] -> None,
    [c, ..t] -> if not_null_here(def, c) && is_null(cell_of(row, c.name)) {
      // Postgres names a column here and no constraint.
      Some(
        db_error(
          "23502",
          "",
          "null value in column \"" ++ c.name ++ "\" of relation \"" ++ def.name
            ++ "\" violates not-null constraint",
        ),
      )
    } else { check_not_null(def, t, row) },
  }

// A `CHECK` fails only when false and passes when unknown, the opposite of a `WHERE`.
fn check_checks(def: Table, cs: List<Check>, row: Row) -> Option<DbError> =
  match cs {
    [] -> None,
    [c, ..t] -> match parse_expr_text(c.expr) {
      Err(e) -> Some(e),
      Ok(x) -> match eval_pred(row, [], x) {
        Err(e) -> Some(e),
        Ok(TriFalse) ->
          Some(
            db_error(
              "23514",
              c.name,
              "new row for relation \"" ++ def.name ++ "\" violates check constraint \"" ++ c.name
                ++ "\"",
            ),
          ),
        Ok(_) -> check_checks(def, t, row),
      },
    },
  }

fn check_unique(def: Table, rows: List<Row>, row: Row, skip: Int) -> Option<DbError> =
  match unique_violation(def, rows, row, skip, def.primary_key, def.name ++ "_pkey") {
    Some(e) -> Some(e),
    None -> check_unique_list(def, def.unique, rows, row, skip),
  }

fn check_unique_list(
  def: Table,
  us: List<Unique>,
  rows: List<Row>,
  row: Row,
  skip: Int,
) -> Option<DbError> =
  match us {
    [] -> None,
    [u, ..t] -> match unique_violation(def, rows, row, skip, u.columns, u.name) {
      Some(e) -> Some(e),
      None -> check_unique_list(def, t, rows, row, skip),
    },
  }

// Two NULLs are distinct in a unique index, so a key with any NULL in it never collides.
fn unique_violation(
  def: Table,
  rows: List<Row>,
  row: Row,
  skip: Int,
  cols: List<String>,
  name: String,
) -> Option<DbError> =
  if len(cols) == 0 || key_has_null(row, cols) { None } else if collides(rows, row, cols, skip, 0) {
    Some(
      db_error("23505", name, "duplicate key value violates unique constraint \"" ++ name ++ "\""),
    )
  } else { None }

fn key_has_null(row: Row, cols: List<String>) -> Bool =
  fold(cols, false, |acc: Bool, c: String| acc || is_null(cell_of(row, c)))

fn collides(rows: List<Row>, row: Row, cols: List<String>, skip: Int, i: Int) -> Bool =
  match rows {
    [] -> false,
    [h, ..t] -> if i != skip && key_equal(h, row, cols) { true }
    else { collides(t, row, cols, skip, i + 1) },
  }

fn key_equal(a: Row, b: Row, cols: List<String>) -> Bool =
  fold(cols, true, |acc: Bool, c: String| acc && cell_of(a, c) == cell_of(b, c))

// `NO ACTION` is checked once after the statement, not per row.
fn check_referential(ts: List<MemTable>) -> Option<DbError> = check_ref_from(ts, ts)

fn check_ref_from(all: List<MemTable>, ts: List<MemTable>) -> Option<DbError> =
  match ts {
    [] -> None,
    [h, ..t] -> match check_table_fks(all, h, h.def.foreign_keys) {
      Some(e) -> Some(e),
      None -> check_ref_from(all, t),
    },
  }

fn check_table_fks(ts: List<MemTable>, mt: MemTable, fks: List<ForeignKey>) -> Option<DbError> =
  match fks {
    [] -> None,
    [f, ..rest] -> match check_fk_rows(ts, mt.rows, f) {
      Some(e) -> Some(e),
      None -> check_table_fks(ts, mt, rest),
    },
  }

fn check_fk_rows(ts: List<MemTable>, rows: List<Row>, f: ForeignKey) -> Option<DbError> =
  match rows {
    [] -> None,
    [r, ..t] -> if key_has_null(r, f.columns) { check_fk_rows(ts, t, f) } else {
      match find_table(ts, f.references) {
        None -> Some(undefined_table(f.references)),
        Some(parent) -> if parent_present(parent.rows, r, f) { check_fk_rows(ts, t, f) } else {
          Some(
            db_error(
              "23503",
              f.name,
              "insert or update on table violates foreign key constraint \"" ++ f.name ++ "\"",
            ),
          )
        },
      }
    },
  }

fn parent_present(rows: List<Row>, child: Row, f: ForeignKey) -> Bool =
  match rows {
    [] -> false,
    [p, ..t] -> if fk_matches(p, child, f) { true } else { parent_present(t, child, f) },
  }

fn fk_matches(parent: Row, child: Row, f: ForeignKey) -> Bool =
  fk_pairs(parent, child, f.columns, f.refers_to)

fn fk_pairs(parent: Row, child: Row, cs: List<String>, rs: List<String>) -> Bool =
  match cs {
    [] -> true,
    [c, ..ct] -> match rs {
      [] -> false,
      [r, ..rt] -> cell_of(child, c) == cell_of(parent, r) && fk_pairs(parent, child, ct, rt),
    },
  }

// --- Executing a statement -------------------------------------------------------

// The answer's shape follows the statement: a `RETURNING` answers `Rows` and a bare write `Count`.
pub fn step(d: MemDb, s: Stmt, ps: List<Param>) -> Outcome =
  if d.failed { fail(d, in_failed_txn()) }
  else { match parse_statement(s.sql) { Err(e) -> fail(d, e), Ok(q) -> exec(d, q, ps) } }

fn exec(d: MemDb, q: Query, ps: List<Param>) -> Outcome =
  match q {
    QSelect(sq) -> exec_select(d, sq, ps),
    QInsert(iq) -> if read_only(d) { fail(d, read_only_txn("INSERT")) }
    else { exec_insert(d, iq, ps) },
    QUpdate(uq) -> if read_only(d) { fail(d, read_only_txn("UPDATE")) }
    else { exec_update(d, uq, ps) },
    QDelete(dq) -> if read_only(d) { fail(d, read_only_txn("DELETE")) }
    else { exec_delete(d, dq, ps) },
  }

// The **outermost** scope decides, because a savepoint has no access mode.
fn read_only(d: MemDb) -> Bool =
  match nth(d.stack, 0) {
    None -> false,
    Some(f) -> match f.access { ReadOnly -> true, ReadWrite -> false },
  }

// --- The plan --------------------------------------------------------------------

type Planned = { left: Expr, right: Expr }

fn plan_filter(def: Table, f: Option<Expr>) -> Result<Option<Expr>, DbError> =
  match f {
    None -> Ok(None),
    Some(e) -> {
      let x = plan_expr(def, e)?;
      Ok(Some(x))
    },
  }

fn plan_expr(def: Table, e: Expr) -> Result<Expr, DbError> =
  match e {
    XCol(n) -> match find_column(def.columns, n) {
      None -> Err(undefined_column(n)),
      Some(_) -> Ok(e),
    },
    XParam(_) -> Ok(e),
    XLit(_) -> Ok(e),
    XDefault -> Ok(e),
    XNot(x) -> {
      let a = plan_expr(def, x)?;
      Ok(XNot(a))
    },
    XAnd(a, b) -> {
      let pa = plan_expr(def, a)?;
      let pb = plan_expr(def, b)?;
      Ok(XAnd(pa, pb))
    },
    XOr(a, b) -> {
      let pa = plan_expr(def, a)?;
      let pb = plan_expr(def, b)?;
      Ok(XOr(pa, pb))
    },
    XCompare(op, a, b) -> {
      let p = plan_operands(def, a, b)?;
      Ok(XCompare(op, p.left, p.right))
    },
    XIsNull(x, want) -> {
      let a = plan_expr(def, x)?;
      Ok(XIsNull(a, want))
    },
    XIn(x, items, negated) -> {
      let px = plan_expr(def, x)?;
      let pis = plan_items(def, column_type_of(def, px), items, [])?;
      Ok(XIn(px, pis, negated))
    },
    XBetween(x, lo, hi, negated) -> {
      let a = plan_operands(def, x, lo)?;
      let b = plan_operands(def, a.left, hi)?;
      Ok(XBetween(b.left, a.right, b.right, negated))
    },
    XLike(x, p, negated) -> {
      let px = plan_expr(def, x)?;
      let pp = plan_expr(def, p)?;
      Ok(XLike(px, pp, negated))
    },
  }

// An `unknown` literal takes its type from the column on the other side of the operator.
fn plan_operands(def: Table, a: Expr, b: Expr) -> Result<Planned, DbError> = {
  let pa = plan_expr(def, a)?;
  let pb = plan_expr(def, b)?;
  match column_type_of(def, pa) {
    Some(ty) -> {
      let nb = retype(ty, pb)?;
      Ok({ left: pa, right: nb })
    },
    None -> match column_type_of(def, pb) {
      Some(ty) -> {
        let na = retype(ty, pa)?;
        Ok({ left: na, right: pb })
      },
      None -> Ok({ left: pa, right: pb }),
    },
  }
}

fn plan_items(
  def: Table,
  ty: Option<ColumnType>,
  items: List<Expr>,
  acc: List<Expr>,
) -> Result<List<Expr>, DbError> =
  match items {
    [] -> Ok(acc),
    [h, ..t] -> {
      let ph = plan_expr(def, h)?;
      match ty {
        None -> plan_items(def, ty, t, push(acc, ph)),
        Some(want) -> {
          let rh = retype(want, ph)?;
          plan_items(def, ty, t, push(acc, rh))
        },
      }
    },
  }

fn column_type_of(def: Table, e: Expr) -> Option<ColumnType> =
  match e {
    XCol(n) -> {
      let c = find_column(def.columns, n)?;
      Some(c.ty)
    },
    _ -> None,
  }

// Only a string literal is `unknown`; a parameter and any other literal carry their own type.
fn retype(ty: ColumnType, e: Expr) -> Result<Expr, DbError> =
  match e {
    XLit(v) -> match v {
      CText(s) -> match ty {
        TText -> Ok(e),
        _ -> match unknown_datum(ty, s) { None -> Err(bad_input(ty, s)), Some(nv) -> Ok(XLit(nv)) },
      },
      _ -> Ok(e),
    },
    _ -> Ok(e),
  }

// Duplicate output names and unknown columns are the statement's shape, so they are refused here.
fn check_projection(def: Table, proj: Proj) -> Option<DbError> =
  match proj { PStar -> None, PCount(_) -> None, PCols(ns) -> check_result_columns(def, ns, []) }

fn check_result_columns(def: Table, ns: List<Target>, seen: List<String>) -> Option<DbError> =
  match ns {
    [] -> None,
    [h, ..t] -> match find_column(def.columns, h.column) {
      None -> Some(undefined_column(h.column)),
      Some(_) -> if has_string(seen, h.name) {
        Some(unsupported("a result set with two columns named `" ++ h.name ++ "`"))
      } else { check_result_columns(def, t, push(seen, h.name)) },
    },
  }

fn check_returning(def: Table, r: Option<Proj>) -> Option<DbError> = {
  let p = r?;
  check_projection(def, p)
}

// --- select ----------------------------------------------------------------------

fn exec_select(d: MemDb, q: SelectQ, ps: List<Param>) -> Outcome =
  match find_table(d.tables, q.source) {
    None -> fail(d, undefined_table(q.source)),
    Some(mt) -> match plan_select(mt.def, q) {
      Err(e) -> fail(d, e),
      Ok(planned) -> match select_rows(mt.rows, ps, planned.filter, []) {
        Err(e) -> fail(d, e),
        Ok(rows) -> finish_select(d, mt, planned, ps, rows),
      },
    },
  }

fn plan_select(def: Table, q: SelectQ) -> Result<SelectQ, DbError> =
  match check_projection(def, q.proj) {
    Some(e) -> Err(e),
    None -> match check_order_columns(def, q.order) {
      Some(e) -> Err(e),
      None -> {
        let f = plan_filter(def, q.filter)?;
        Ok({
          source: q.source,
          proj: q.proj,
          filter: f,
          order: q.order,
          limit: q.limit,
          offset: q.offset,
        })
      },
    },
  }

fn select_rows(
  rows: List<Row>,
  ps: List<Param>,
  filter: Option<Expr>,
  acc: List<Row>,
) -> Result<List<Row>, DbError> =
  match rows {
    [] -> Ok(acc),
    [h, ..t] -> {
      let k = keeps(h, ps, filter)?;
      select_rows(t, ps, filter, if k { push(acc, h) } else { acc })
    },
  }

fn keeps(r: Row, ps: List<Param>, filter: Option<Expr>) -> Result<Bool, DbError> =
  match filter {
    None -> Ok(true),
    Some(e) -> {
      let t = eval_pred(r, ps, e)?;
      Ok(match t { TriTrue -> true, TriFalse -> false, TriUnknown -> false })
    },
  }

fn finish_select(d: MemDb, mt: MemTable, q: SelectQ, ps: List<Param>, rows: List<Row>) -> Outcome =
  match q.proj {
    PCount(name) -> if len(q.order) > 0 || is_bound(q.limit) || is_bound(q.offset) {
      fail(d, unsupported("`count(*)` with an `order by`, `limit` or `offset`"))
    } else { done(d, Rows([map_insert(map_new(), name, CInt(len(rows)))])) },
    PStar -> ordered_slice(d, mt, q, ps, rows, PStar),
    PCols(ns) -> ordered_slice(d, mt, q, ps, rows, PCols(ns)),
  }

fn is_bound(e: Option<Expr>) -> Bool = match e { None -> false, Some(_) -> true }

fn ordered_slice(
  d: MemDb,
  mt: MemTable,
  q: SelectQ,
  ps: List<Param>,
  rows: List<Row>,
  proj: Proj,
) -> Outcome =
  match check_order_columns(mt.def, q.order) {
    Some(e) -> fail(d, e),
    None -> match sort_rows(rows, q.order, []) {
      Err(e) -> fail(d, e),
      Ok(sorted) -> slice_and_project(d, q, ps, sorted, proj),
    },
  }

fn check_order_columns(def: Table, keys: List<OrderKey>) -> Option<DbError> =
  match keys {
    [] -> None,
    [k, ..t] -> match find_column(def.columns, k.column) {
      None -> Some(undefined_column(k.column)),
      Some(_) -> check_order_columns(def, t),
    },
  }

fn slice_and_project(
  d: MemDb,
  q: SelectQ,
  ps: List<Param>,
  rows: List<Row>,
  proj: Proj,
) -> Outcome =
  match eval_bound(ps, q.offset, 0, "2201X", "OFFSET") {
    Err(e) -> fail(d, e),
    Ok(off) -> match eval_bound(ps, q.limit, -1, "2201W", "LIMIT") {
      Err(e) -> fail(d, e),
      Ok(lim) -> {
        let after = drop_n(rows, off);
        let bounded = if lim < 0 { after } else { take_n(after, lim, []) };
        match project_rows(bounded, proj, []) {
          Err(e) -> fail(d, e),
          Ok(out) -> done(d, Rows(out)),
        }
      },
    },
  }

fn eval_bound(
  ps: List<Param>,
  e: Option<Expr>,
  dflt: Int,
  code: String,
  what: String,
) -> Result<Int, DbError> =
  match e {
    None -> Ok(dflt),
    Some(x) -> {
      let v = eval_value(map_new(), ps, x)?;
      match v {
        CNull -> Ok(dflt),
        CInt(n) -> if n < 0 { Err(db_error(code, "", what ++ " must not be negative")) }
        else { Ok(n) },
        _ -> Err(db_error("42804", "", "argument of " ++ what ++ " must be integer")),
      }
    },
  }

fn drop_n<a>(xs: List<a>, n: Int) -> List<a> =
  if n <= 0 { xs } else { match xs { [] -> [], [_, ..t] -> drop_n(t, n - 1) } }

fn take_n<a>(xs: List<a>, n: Int, acc: List<a>) -> List<a> =
  if n <= 0 { acc } else { match xs { [] -> acc, [h, ..t] -> take_n(t, n - 1, push(acc, h)) } }

// Insertion sort, and stable by construction: a row goes after every row it compares equal to.
fn sort_rows(rows: List<Row>, keys: List<OrderKey>, acc: List<Row>) -> Result<List<Row>, DbError> =
  if len(keys) == 0 { Ok(concat_lists(acc, rows)) } else {
    match rows {
      [] -> Ok(acc),
      [h, ..t] -> {
        let next = insert_sorted(acc, h, keys, [])?;
        sort_rows(t, keys, next)
      },
    }
  }

reuse fn insert_sorted(
  sorted: List<Row>,
  r: Row,
  keys: List<OrderKey>,
  before: List<Row>,
) -> Result<List<Row>, DbError> =
  match sorted {
    [] -> Ok(push(before, r)),
    [h, ..t] -> {
      let c = rows_cmp(r, h, keys)?;
      if c < 0 { Ok(concat_lists(push(before, r), sorted)) }
      else { insert_sorted(t, r, keys, push(before, h)) }
    },
  }

fn rows_cmp(a: Row, b: Row, keys: List<OrderKey>) -> Result<Int, DbError> =
  match keys {
    [] -> Ok(0),
    [k, ..t] -> {
      let c = key_cmp(a, b, k)?;
      if c == 0 { rows_cmp(a, b, t) } else { Ok(c) }
    },
  }

// `NULLS FIRST` / `NULLS LAST` is absolute, so the null arms sit outside the `desc` flip.
fn key_cmp(a: Row, b: Row, k: OrderKey) -> Result<Int, DbError> = {
  let av = cell_of(a, k.column);
  let bv = cell_of(b, k.column);
  if is_null(av) && is_null(bv) { Ok(0) }
  else if is_null(av) { Ok(if k.nulls_first { -1 } else { 1 }) }
  else if is_null(bv) { Ok(if k.nulls_first { 1 } else { -1 }) } else {
    let o = datum_cmp(av, bv)?;
    match o { None -> Ok(0), Some(c) -> Ok(if k.desc { 0 - c } else { c }) }
  }
}

fn project_rows(rows: List<Row>, proj: Proj, acc: List<Row>) -> Result<List<Row>, DbError> =
  match rows {
    [] -> Ok(acc),
    [h, ..t] -> {
      let r = project_row(h, proj)?;
      project_rows(t, proj, push(acc, r))
    },
  }

fn project_row(r: Row, proj: Proj) -> Result<Row, DbError> =
  match proj { PStar -> Ok(r), PCount(_) -> Ok(r), PCols(ns) -> project_cols(r, ns, map_new()) }

// A `Row` is a `Map`, so two output columns of one name would silently keep one.
fn project_cols(r: Row, ns: List<Target>, acc: Row) -> Result<Row, DbError> =
  match ns {
    [] -> Ok(acc),
    [h, ..t] -> match map_get(r, h.column) {
      None -> Err(undefined_column(h.column)),
      Some(v) -> project_cols(r, t, map_insert(acc, h.name, v)),
    },
  }

// --- insert ----------------------------------------------------------------------

type RowAcc = { seqs: Map<String, Int>, row: Row, err: Option<DbError> }

type Build = { seqs: Map<String, Int>, rows: List<Row>, err: Option<DbError> }

fn exec_insert(d: MemDb, q: InsertQ, ps: List<Param>) -> Outcome =
  match find_table(d.tables, q.source) {
    None -> fail(d, undefined_table(q.source)),
    Some(mt) -> {
      let cols = if len(q.columns) == 0 { map(mt.def.columns, |c: Column| c.name) }
      else { q.columns };
      match check_column_list(mt.def, cols, []) {
        Some(e) -> fail(d, e),
        None -> match check_returning(mt.def, q.returning) {
          Some(e) -> fail(d, e),
          None -> insert_build(d, mt, cols, q, ps),
        },
      }
    },
  }

fn check_column_list(def: Table, cols: List<String>, seen: List<String>) -> Option<DbError> =
  match cols {
    [] -> None,
    [h, ..t] -> match find_column(def.columns, h) {
      None -> Some(undefined_column(h)),
      Some(_) -> if has_string(seen, h) {
        Some(db_error("42701", "", "column \"" ++ h ++ "\" specified more than once"))
      } else { check_column_list(def, t, push(seen, h)) },
    },
  }

// A sequence stays advanced even when the row is refused: postgres sequences are not transactional.
fn insert_build(
  d: MemDb,
  mt: MemTable,
  cols: List<String>,
  q: InsertQ,
  ps: List<Param>,
) -> Outcome = {
  let b = fold(
    q.tuples,
    { seqs: d.sequences, rows: [], err: None },
    |acc: Build, exprs: List<Expr>| build_tuple(mt.def, cols, exprs, ps, acc),
  );
  let advanced = memdb(d.tables, b.seqs, d.stack, d.failed);
  match b.err { Some(e) -> fail(advanced, e), None -> insert_rows(advanced, mt, b.rows, q) }
}

fn build_tuple(
  def: Table,
  cols: List<String>,
  exprs: List<Expr>,
  ps: List<Param>,
  acc: Build,
) -> Build =
  match acc.err {
    Some(_) -> acc,
    None -> if len(exprs) != len(cols) {
      {
        seqs: acc.seqs,
        rows: acc.rows,
        err: Some(
          db_error(
            "42601",
            "",
            "INSERT has " ++ (if len(exprs) > len(cols) { "more" } else { "fewer" })
              ++ " expressions than target columns",
          ),
        ),
      }
    } else {
      collect_tuple(
        build_columns(def, def.columns, cols, exprs, ps, {
          seqs: acc.seqs,
          row: map_new(),
          err: None,
        }),
        acc,
      )
    },
  }

fn collect_tuple(built: RowAcc, acc: Build) -> Build =
  match built.err {
    Some(e) -> { seqs: built.seqs, rows: acc.rows, err: Some(e) },
    None -> { seqs: built.seqs, rows: push(acc.rows, built.row), err: None },
  }

fn build_columns(
  def: Table,
  cs: List<Column>,
  cols: List<String>,
  exprs: List<Expr>,
  ps: List<Param>,
  acc: RowAcc,
) -> RowAcc =
  match cs {
    [] -> acc,
    [c, ..rest] -> match acc.err {
      Some(_) -> acc,
      None -> build_columns(def, rest, cols, exprs, ps, build_column(c, cols, exprs, ps, acc)),
    },
  }

fn build_column(
  c: Column,
  cols: List<String>,
  exprs: List<Expr>,
  ps: List<Param>,
  acc: RowAcc,
) -> RowAcc =
  match index_of(cols, c.name) {
    None -> default_into(c, acc),
    Some(i) -> match nth(exprs, i) {
      None -> default_into(c, acc),
      Some(e) -> match e {
        XDefault -> default_into(c, acc),
        _ -> store_value(c, eval_value(map_new(), ps, e), is_param(e), acc),
      },
    },
  }

fn is_param(e: Expr) -> Bool = match e { XParam(_) -> true, _ -> false }

fn store_value(c: Column, r: Result<Datum, DbError>, from_param: Bool, acc: RowAcc) -> RowAcc =
  match r {
    Err(e) -> { seqs: acc.seqs, row: acc.row, err: Some(e) },
    Ok(v) -> match coerce(c, c.ty, v, from_param) {
      Err(e) -> { seqs: acc.seqs, row: acc.row, err: Some(e) },
      Ok(cv) -> { seqs: acc.seqs, row: map_insert(acc.row, c.name, cv), err: None },
    },
  }

fn default_into(c: Column, acc: RowAcc) -> RowAcc =
  match c.default {
    DNone -> { seqs: acc.seqs, row: map_insert(acc.row, c.name, CNull), err: None },
    DLiteral(p) -> store_value(c, Ok(param_datum(p)), false, acc),
    DSequence(n) -> {
      let next = match map_get(acc.seqs, n) { None -> 1, Some(v) -> v + 1 };
      {
        seqs: map_insert(acc.seqs, n, next),
        row: map_insert(acc.row, c.name, CInt(next)),
        err: None,
      }
    },
  }

fn insert_rows(d: MemDb, mt: MemTable, rows: List<Row>, q: InsertQ) -> Outcome =
  match append_rows(mt, rows) {
    Err(e) -> fail(d, e),
    Ok(mt2) -> {
      let tables = put_table(d.tables, mt2);
      match check_referential(tables) {
        Some(e) -> fail(d, e),
        None ->
          finish_write(memdb(tables, d.sequences, d.stack, d.failed), rows, q.returning, len(rows)),
      }
    },
  }

fn append_rows(mt: MemTable, rows: List<Row>) -> Result<MemTable, DbError> =
  match rows {
    [] -> Ok(mt),
    [h, ..t] -> match validate_row(mt.def, mt.rows, h, -1) {
      Some(e) -> Err(e),
      None -> append_rows({ def: mt.def, rows: push(mt.rows, h) }, t),
    },
  }

fn finish_write(d: MemDb, rows: List<Row>, returning: Option<Proj>, count: Int) -> Outcome =
  match returning {
    None -> done(d, Count(count)),
    Some(p) -> match project_rows(rows, p, []) {
      Err(e) -> fail(d, e),
      Ok(out) -> done(d, Rows(out)),
    },
  }

// --- update ----------------------------------------------------------------------

type Changed = { at: Int, row: Row }

type UpAcc = { rows: List<Row>, changed: List<Changed>, at: Int, err: Option<DbError> }

fn exec_update(d: MemDb, q: UpdateQ, ps: List<Param>) -> Outcome =
  match find_table(d.tables, q.source) {
    None -> fail(d, undefined_table(q.source)),
    Some(mt) -> match plan_update(mt.def, q, ps) {
      Err(e) -> fail(d, e),
      Ok(planned) -> {
        let acc = update_walk(mt.def, mt.rows, planned, ps, {
          rows: [],
          changed: [],
          at: 0,
          err: None,
        });
        match acc.err { Some(e) -> fail(d, e), None -> finish_update(d, mt, acc, planned) }
      },
    },
  }

fn plan_update(def: Table, q: UpdateQ, ps: List<Param>) -> Result<UpdateQ, DbError> =
  match check_returning(def, q.returning) {
    Some(e) -> Err(e),
    None -> match constant_sets(def, q.sets, ps) {
      Some(e) -> Err(e),
      None -> {
        let f = plan_filter(def, q.filter)?;
        Ok({ source: q.source, sets: q.sets, filter: f, returning: q.returning })
      },
    },
  }

// A constant `set` is coerced at plan time, so one that cannot fit fails even when no row matches.
fn constant_sets(def: Table, sets: List<Assign>, ps: List<Param>) -> Option<DbError> =
  match sets {
    [] -> None,
    [s, ..t] -> match find_column(def.columns, s.column) {
      None -> Some(undefined_column(s.column)),
      Some(c) -> match constant_of(s.value, ps) {
        None -> constant_sets(def, t, ps),
        Some(v) -> match coerce(c, c.ty, v, is_param(s.value)) {
          Err(e) -> Some(e),
          Ok(_) -> constant_sets(def, t, ps),
        },
      },
    },
  }

fn constant_of(e: Expr, ps: List<Param>) -> Option<Datum> =
  match e {
    XLit(v) -> Some(v),
    XParam(n) -> {
      let p = nth(ps, n - 1)?;
      Some(param_datum(p))
    },
    _ -> None,
  }

fn update_walk(def: Table, rows: List<Row>, q: UpdateQ, ps: List<Param>, acc: UpAcc) -> UpAcc =
  match rows {
    [] -> acc,
    [h, ..t] -> match acc.err {
      Some(_) -> acc,
      None -> update_walk(def, t, q, ps, update_one(def, h, q, ps, acc)),
    },
  }

fn update_one(def: Table, r: Row, q: UpdateQ, ps: List<Param>, acc: UpAcc) -> UpAcc =
  match keeps(r, ps, q.filter) {
    Err(e) -> { rows: acc.rows, changed: acc.changed, at: acc.at, err: Some(e) },
    Ok(hit) -> if hit { update_hit(def, r, q, ps, acc) }
    else { { rows: push(acc.rows, r), changed: acc.changed, at: acc.at + 1, err: None } },
  }

fn update_hit(def: Table, r: Row, q: UpdateQ, ps: List<Param>, acc: UpAcc) -> UpAcc =
  match apply_sets(def, r, q.sets, ps) {
    Err(e) -> { rows: acc.rows, changed: acc.changed, at: acc.at, err: Some(e) },
    Ok(nr) ->
      {
        rows: push(acc.rows, nr),
        changed: push(acc.changed, { at: acc.at, row: nr }),
        at: acc.at + 1,
        err: None,
      },
  }

fn apply_sets(def: Table, r: Row, sets: List<Assign>, ps: List<Param>) -> Result<Row, DbError> =
  match sets {
    [] -> Ok(r),
    [s, ..t] -> match find_column(def.columns, s.column) {
      None -> Err(undefined_column(s.column)),
      Some(c) -> {
        let nr = set_value(c, r, s.value, ps)?;
        apply_sets(def, nr, t, ps)
      },
    },
  }

// Sequences are threaded through `insert` only, so `set c = default` on one is refused.
fn set_value(c: Column, r: Row, e: Expr, ps: List<Param>) -> Result<Row, DbError> =
  match e {
    XDefault -> match c.default {
      DSequence(_) -> Err(unsupported("`set ... = default` on a sequence column")),
      DNone -> Ok(map_insert(r, c.name, CNull)),
      DLiteral(p) -> {
        let v = coerce(c, c.ty, param_datum(p), false)?;
        Ok(map_insert(r, c.name, v))
      },
    },
    _ -> {
      let v = eval_value(r, ps, e)?;
      let cv = coerce(c, c.ty, v, is_param(e))?;
      Ok(map_insert(r, c.name, cv))
    },
  }

fn finish_update(d: MemDb, mt: MemTable, acc: UpAcc, q: UpdateQ) -> Outcome =
  match validate_changed(mt.def, acc.rows, acc.changed) {
    Some(e) -> fail(d, e),
    None -> {
      let tables = put_table(d.tables, { def: mt.def, rows: acc.rows });
      match check_referential(tables) {
        Some(e) -> fail(d, e),
        None ->
          finish_write(
            memdb(tables, d.sequences, d.stack, d.failed),
            map(acc.changed, |c: Changed| c.row),
            q.returning,
            len(acc.changed),
          ),
      }
    },
  }

fn validate_changed(def: Table, rows: List<Row>, cs: List<Changed>) -> Option<DbError> =
  match cs {
    [] -> None,
    [h, ..t] -> match validate_row(def, rows, h.row, h.at) {
      Some(e) -> Some(e),
      None -> validate_changed(def, rows, t),
    },
  }

// --- delete ----------------------------------------------------------------------

type DelAcc = { rows: List<Row>, gone: List<Row>, err: Option<DbError> }

fn exec_delete(d: MemDb, q: DeleteQ, ps: List<Param>) -> Outcome =
  match find_table(d.tables, q.source) {
    None -> fail(d, undefined_table(q.source)),
    Some(mt) -> match plan_delete(mt.def, q) {
      Err(e) -> fail(d, e),
      Ok(q) -> {
        let acc = delete_walk(mt.rows, q, ps, { rows: [], gone: [], err: None });
        match acc.err {
          Some(e) -> fail(d, e),
          None -> {
            let tables = put_table(d.tables, { def: mt.def, rows: acc.rows });
            match check_referential(tables) {
              Some(e) -> fail(d, e),
              None ->
                finish_write(
                  memdb(tables, d.sequences, d.stack, d.failed),
                  acc.gone,
                  q.returning,
                  len(acc.gone),
                ),
            }
          },
        }
      },
    },
  }

fn plan_delete(def: Table, q: DeleteQ) -> Result<DeleteQ, DbError> =
  match check_returning(def, q.returning) {
    Some(e) -> Err(e),
    None -> {
      let f = plan_filter(def, q.filter)?;
      Ok({ source: q.source, filter: f, returning: q.returning })
    },
  }

fn delete_walk(rows: List<Row>, q: DeleteQ, ps: List<Param>, acc: DelAcc) -> DelAcc =
  match rows {
    [] -> acc,
    [h, ..t] -> match acc.err {
      Some(_) -> acc,
      None -> match keeps(h, ps, q.filter) {
        Err(e) -> { rows: acc.rows, gone: acc.gone, err: Some(e) },
        Ok(hit) ->
          delete_walk(t, q, ps, if hit { { rows: acc.rows, gone: push(acc.gone, h), err: None } }
          else { { rows: push(acc.rows, h), gone: acc.gone, err: None } }),
      },
    },
  }

// --- The scope stack -------------------------------------------------------------

// A refused `begin` does not abort the transaction it is nested inside.
pub fn begin_step(d: MemDb, level: Isolation, access: Access) -> Outcome = {
  let frame = { tables: d.tables, failed: false, level: level, access: access };
  match nth(d.stack, 0) {
    None -> done(memdb(d.tables, d.sequences, [frame], false), Count(0)),
    Some(outer) -> match nested_refusal(
        d.failed,
        len(d.stack),
        outer.level,
        outer.access,
        level,
        access,
      ) {
      Some(e) -> fail_open(d, e),
      None -> done(memdb(d.tables, d.sequences, push(d.stack, frame), d.failed), Count(0)),
    },
  }
}

// Why a `begin` cannot be a savepoint of the transaction it is nested in, where `depth` scopes are
// open and `outer` is what the transaction's own `begin` asked for; the twin and the driver share it.
fn nested_refusal(
  failed: Bool,
  depth: Int,
  outer: Isolation,
  outer_access: Access,
  level: Isolation,
  access: Access,
) -> Option<DbError> =
  if failed { Some(in_failed_txn()) } else if depth > max_savepoints() {
    Some(db_error("54000", "", "savepoint stack deeper than " ++ int_to_string(max_savepoints())))
  } else if !same_isolation(outer, level) {
    Some(
      db_error(
        "25001",
        "",
        "the open transaction is " ++ isolation_name(outer) ++ " and this nested `begin` asks for "
          ++ isolation_name(level),
      ),
    )
  } else if widens(outer_access, access) {
    // A savepoint has no access mode, so it cannot widen the transaction's.
    Some(
      db_error(
        "25001",
        "",
        "the open transaction is " ++ access_name(outer_access)
          ++ " and this nested `begin` asks for "
          ++ access_name(access)
          ++ "; a savepoint cannot widen what the transaction may do",
      ),
    )
  } else { None }

fn widens(outer: Access, inner: Access) -> Bool =
  match outer {
    ReadOnly -> match inner { ReadWrite -> true, ReadOnly -> false },
    ReadWrite -> false,
  }

pub fn access_name(a: Access) -> String =
  match a { ReadWrite -> "read write", ReadOnly -> "read only" }

fn same_isolation(a: Isolation, b: Isolation) -> Bool =
  match a {
    ReadCommitted -> match b { ReadCommitted -> true, _ -> false },
    RepeatableRead -> match b { RepeatableRead -> true, _ -> false },
    Serializable -> match b { Serializable -> true, _ -> false },
  }

pub fn isolation_name(a: Isolation) -> String =
  match a {
    ReadCommitted -> "read committed",
    RepeatableRead -> "repeatable read",
    Serializable -> "serializable",
  }

// Committing an aborted transaction is `25P02`, stricter on purpose than the bare server.
pub fn commit_step(d: MemDb) -> Outcome =
  match last(d.stack) {
    None -> fail_open(d, no_transaction("`db.commit`")),
    Some(frame) -> if len(d.stack) == 1 {
      if d.failed {
        { db: memdb(frame.tables, d.sequences, [], false), out: Failed(in_failed_txn()) }
      } else { done(memdb(d.tables, d.sequences, [], false), Count(0)) }
    } else if d.failed {
      // A failed `commit` closes and rolls back its scope, as the driver does.
      {
        db: memdb(frame.tables, d.sequences, drop_last(d.stack), true),
        out: Failed(in_failed_txn()),
      }
    } else { done(memdb(d.tables, d.sequences, drop_last(d.stack), d.failed), Count(0)) },
  }

pub fn abort_step(d: MemDb) -> Outcome =
  match last(d.stack) {
    None -> fail_open(d, no_transaction("`db.abort`")),
    Some(frame) ->
      done(memdb(frame.tables, d.sequences, drop_last(d.stack), frame.failed), Count(0)),
  }

fn no_transaction(what: String) -> DbError =
  db_error("25P01", "", what ++ " with no transaction open")

// With no open scope there is no transaction to poison, so the database is left as it was.
fn fail_open(d: MemDb, e: DbError) -> Outcome = { db: d, out: Failed(e) }

// --- The twin's own tests --------------------------------------------------------

fn t_schema() -> Schema = { tables: [t_part(), t_bin()] }

fn t_part() -> Table =
  {
    name: "part",
    columns: [
      column("sku", TText, false),
      column("price", TNumeric(10, 4), false),
      column("tag", TText, true),
      column("n", TInt, true),
    ],
    primary_key: ["sku"],
    unique: [{ name: "part_tag_key", columns: ["tag"] }],
    foreign_keys: [],
    checks: [{ name: "part_price_check", expr: "price >= 0" }],
  }

fn t_bin() -> Table =
  {
    name: "bin",
    columns: [
      column_default("id", TInt, false, DSequence("bin_id_seq")),
      column("sku", TText, true),
      column("qty", TInt, true),
    ],
    primary_key: ["id"],
    unique: [],
    foreign_keys: [
      { name: "bin_sku_fkey", columns: ["sku"], references: "part", refers_to: ["sku"] },
    ],
    checks: [{ name: "bin_qty_check", expr: "qty >= 0" }],
  }

fn t_run(d: MemDb, sql: String, ps: List<Param>) -> Outcome = step(d, stmt(sql), ps)

fn t_out(d: MemDb, sql: String, ps: List<Param>) -> Answer = t_run(d, sql, ps).out

fn t_seed() -> MemDb = {
  let a = t_run(open(t_schema()), "insert into part (sku, price, tag, n) values ($1,$2,$3,$4)", [
    PText("a"),
    PNumeric(1m),
    PText("t1"),
    PInt(1),
  ]);
  let b = t_run(a.db, "insert into part (sku, price, tag, n) values ($1,$2,$3,$4)", [
    PText("b"),
    PNumeric(2m),
    PText("t2"),
    PNull,
  ]);
  t_run(b.db, "insert into part (sku, price, tag, n) values ($1,$2,$3,$4)", [
    PText("c"),
    PNumeric(3m),
    PNull,
    PInt(3),
  ]).db
}

fn t_code(a: Answer) -> String =
  match a { Failed(e) -> e.code, Rows(_) -> "rows", Count(_) -> "count" }

fn t_constraint(a: Answer) -> String = match a { Failed(e) -> e.constraint, _ -> "" }

fn t_skus(a: Answer) -> List<String> =
  match a {
    Rows(rs) -> map(rs, |r: Row| match cell_of(r, "sku") { CText(s) -> s, _ -> "?" }),
    _ -> [],
  }

fn t_count(a: Answer) -> Int =
  match a {
    Rows(rs) -> match rs {
      [r, ..] -> match cell_of(r, "count") { CInt(n) -> n, _ -> -1 },
      _ -> -1,
    },
    _ -> -1,
  }

test "create_schema renders one statement per table and one per sequence" {
  let sqls = map(create_schema(t_schema()), |s: Stmt| s.sql);
  assert_eq(len(sqls), 3);
  assert_eq(nth(sqls, 0), Some("create sequence \"bin_id_seq\""));
  assert_eq(
    nth(sqls, 1),
    Some(
      "create table \"part\" (\"sku\" text not null, \"price\" numeric(10,4) not null, "
        ++ "\"tag\" text, \"n\" bigint, primary key (\"sku\"), "
        ++ "constraint \"part_tag_key\" unique (\"tag\"), "
        ++ "constraint \"part_price_check\" check (price >= 0))",
    ),
  )
}

test "a where, an order by, a limit and an offset" {
  let d = t_seed();
  assert_eq(t_skus(t_out(d, "select sku from part order by sku", [])), ["a", "b", "c"]);
  assert_eq(t_skus(t_out(d, "select sku from part order by sku desc", [])), ["c", "b", "a"]);
  assert_eq(t_skus(t_out(d, "select sku from part order by sku limit 2", [])), ["a", "b"]);
  assert_eq(t_skus(t_out(d, "select sku from part order by sku limit 2 offset 1", [])), ["b", "c"]);
  assert_eq(t_skus(t_out(d, "select sku from part where price > 1 order by sku", [])), ["b", "c"]);
  assert_eq(t_skus(t_out(d, "select sku from part where sku in ('a','c') order by sku", [])), [
    "a",
    "c",
  ]);
  assert_eq(
    t_skus(t_out(d, "select sku from part where price between 2 and 3 order by sku", [])),
    ["b", "c"],
  );
  assert_eq(t_skus(t_out(d, "select sku from part where tag like 't%' order by sku", [])), [
    "a",
    "b",
  ]);
  assert_eq(t_skus(t_out(d, "select sku from part where sku = 'zz' order by sku", [])), []);
  assert_eq(t_count(t_out(d, "select count(*) from part", [])), 3)
}

test "a comparison with null is unknown, and a where keeps only what is true" {
  let d = t_seed();
  assert_eq(t_skus(t_out(d, "select sku from part where n = 1 order by sku", [])), ["a"]);
  assert_eq(t_skus(t_out(d, "select sku from part where n <> 1 order by sku", [])), ["c"]);
  assert_eq(t_skus(t_out(d, "select sku from part where n is null order by sku", [])), ["b"]);
  assert_eq(t_skus(t_out(d, "select sku from part where not (n = 1) order by sku", [])), ["c"]);
  assert_eq(t_skus(t_out(d, "select sku from part where n = 1 or tag = 't2' order by sku", [])), [
    "a",
    "b",
  ])
}

test "nulls order last under asc and first under desc, and the words override it" {
  let d = t_seed();
  assert_eq(t_skus(t_out(d, "select sku, n from part order by n, sku", [])), ["a", "c", "b"]);
  assert_eq(t_skus(t_out(d, "select sku, n from part order by n desc, sku", [])), ["b", "c", "a"]);
  assert_eq(t_skus(t_out(d, "select sku, n from part order by n nulls first, sku", [])), [
    "b",
    "a",
    "c",
  ])
}

test "insert answers a count, and returning answers the rows" {
  let d = open(t_schema());
  assert_eq(t_out(d, "insert into part (sku, price) values ('a', 1)", []), Count(1));
  assert_eq(t_out(d, "insert into part (sku, price) values ('a', 1), ('b', 2)", []), Count(2));
  assert_eq(t_skus(t_out(d, "insert into part (sku, price) values ('a', 1) returning sku", [])), [
    "a",
  ])
}

test "a numeric column stores the column's scale and refuses what will not fit" {
  let d = open(t_schema());
  let r = t_run(d, "insert into part (sku, price) values ('a', $1) returning price", [
    PNumeric(1.00m),
  ]);
  match r.out {
    Rows(rs) -> match rs {
      [row, ..] -> match cell_of(row, "price") {
        CNumeric(v) -> assert_eq(decimal_to_string(v), "1.0000"),
        _ -> assert(false),
      },
      _ -> assert(false),
    },
    _ -> assert(false),
  };
  assert_eq(t_code(t_out(d, "insert into part (sku, price) values ('a', 1.00005)", [])), "count");
  assert_eq(t_code(t_out(d, "insert into part (sku, price) values ('a', 1000000)", [])), "22003")
}

test "a constant that will not fit the column fails even when no row matches" {
  let d = t_seed();
  assert_eq(t_code(t_out(d, "update part set price = 1000000 where sku = 'zz'", [])), "22003");
  assert_eq(t_out(d, "update part set price = 9 where sku = 'zz'", []), Count(0))
}

test "the four constraint classes carry the codes and the names postgres sends" {
  let d = t_seed();
  let dup = t_out(d, "insert into part (sku, price) values ('a', 1)", []);
  assert_eq(t_code(dup), "23505");
  assert_eq(t_constraint(dup), "part_pkey");
  let tag = t_out(d, "insert into part (sku, price, tag) values ('z', 1, 't1')", []);
  assert_eq(t_code(tag), "23505");
  assert_eq(t_constraint(tag), "part_tag_key");
  let nn = t_out(d, "insert into part (sku, price) values ('z', null)", []);
  assert_eq(t_code(nn), "23502");
  // Postgres reports a *column* for a not-null violation and no constraint.
  assert_eq(t_constraint(nn), "");
  let ck = t_out(d, "insert into part (sku, price) values ('z', -1)", []);
  assert_eq(t_code(ck), "23514");
  assert_eq(t_constraint(ck), "part_price_check");
  let fk = t_out(d, "insert into bin (sku, qty) values ('zz', 1)", []);
  assert_eq(t_code(fk), "23503");
  assert_eq(t_constraint(fk), "bin_sku_fkey")
}

test "two nulls in a unique column do not collide" {
  let d = t_seed();
  assert_eq(t_out(d, "insert into part (sku, price, tag) values ('z', 1, null)", []), Count(1))
}

test "a check passes on unknown and fails only on false" {
  let d = t_seed();
  assert_eq(t_out(d, "insert into bin (sku, qty) values ('a', null)", []), Count(1));
  assert_eq(t_code(t_out(d, "insert into bin (sku, qty) values ('a', -1)", [])), "23514")
}

test "a parent with a child cannot be deleted" {
  let d0 = t_seed();
  let d1 = t_run(d0, "insert into bin (sku, qty) values ('a', 1)", []).db;
  assert_eq(t_code(t_out(d1, "delete from part where sku = 'a'", [])), "23503");
  assert_eq(t_out(d1, "delete from part where sku = 'b'", []), Count(1))
}

test "a parameter carrying SQL is a value and never syntax" {
  let d = open(t_schema());
  let r = t_run(d, "insert into part (sku, price) values ($1, 1) returning sku", [
    PText("'; drop table part; --"),
  ]);
  assert_eq(t_skus(r.out), ["'; drop table part; --"]);
  assert_eq(t_count(t_out(r.db, "select count(*) from part", [])), 1)
}

test "a committed scope is visible and an aborted one is not" {
  let d0 = t_seed();
  let b = begin_step(d0, ReadCommitted, ReadWrite);
  let i = t_run(b.db, "insert into part (sku, price) values ('z', 1)", []);
  assert_eq(t_count(t_out(i.db, "select count(*) from part", [])), 4);
  let c = commit_step(i.db);
  assert_eq(t_count(t_out(c.db, "select count(*) from part", [])), 4);
  let b2 = begin_step(c.db, ReadCommitted, ReadWrite);
  let i2 = t_run(b2.db, "delete from part where sku = 'z'", []);
  let a2 = abort_step(i2.db);
  assert_eq(t_count(t_out(a2.db, "select count(*) from part", [])), 4)
}

test "a statement that failed inside a scope makes every later one 25P02" {
  let d0 = t_seed();
  let b = begin_step(d0, ReadCommitted, ReadWrite);
  let bad = t_run(b.db, "insert into part (sku, price) values ('a', 1)", []);
  assert_eq(t_code(bad.out), "23505");
  assert_eq(t_code(t_out(bad.db, "select count(*) from part", [])), "25P02");
  // The server tags this `ROLLBACK` with no error; `Count(0)` would tell the caller lost writes are durable.
  let c = commit_step(bad.db);
  assert_eq(t_code(c.out), "25P02");
  assert_eq(t_count(t_out(c.db, "select count(*) from part", [])), 3)
}

test "rolling back to a savepoint clears the failed state and the inner writes" {
  let d0 = t_seed();
  let b = begin_step(d0, ReadCommitted, ReadWrite);
  let i = t_run(b.db, "insert into part (sku, price) values ('z', 1)", []);
  let sp = begin_step(i.db, ReadCommitted, ReadWrite);
  let bad = t_run(sp.db, "insert into part (sku, price) values ('z', 2)", []);
  assert_eq(t_code(bad.out), "23505");
  let back = abort_step(bad.db);
  assert_eq(t_count(t_out(back.db, "select count(*) from part", [])), 4);
  let c = commit_step(back.db);
  assert_eq(t_count(t_out(c.db, "select count(*) from part", [])), 4)
}

test "releasing a savepoint in an aborted transaction is 25P02 and commits nothing" {
  let d0 = t_seed();
  let b = begin_step(d0, ReadCommitted, ReadWrite);
  let i = t_run(b.db, "insert into part (sku, price) values ('z', 1)", []);
  let sp = begin_step(i.db, ReadCommitted, ReadWrite);
  let bad = t_run(sp.db, "insert into part (sku, price) values ('z', 2)", []);
  let rel = commit_step(bad.db);
  assert_eq(t_code(rel.out), "25P02");
  // Releasing did not un-abort the transaction, so the outer commit is `25P02` too.
  let c = commit_step(rel.db);
  assert_eq(t_code(c.out), "25P02");
  assert_eq(t_count(t_out(c.db, "select count(*) from part", [])), 3)
}

test "a sequence is not rolled back" {
  let d0 = t_seed();
  let b = begin_step(d0, ReadCommitted, ReadWrite);
  let i = t_run(b.db, "insert into bin (sku, qty) values ('a', 1) returning id", []);
  assert_eq(i.out, Rows([map_insert(map_new(), "id", CInt(1))]));
  let a = abort_step(i.db);
  let j = t_run(a.db, "insert into bin (sku, qty) values ('a', 2) returning id", []);
  assert_eq(j.out, Rows([map_insert(map_new(), "id", CInt(2))]))
}

test "a write in a read-only scope is 25006 and a nested begin at another level is 25001" {
  let d0 = t_seed();
  let ro = begin_step(d0, ReadCommitted, ReadOnly);
  assert_eq(t_code(t_out(ro.db, "insert into part (sku, price) values ('z', 1)", [])), "25006");
  assert_eq(t_count(t_out(ro.db, "select count(*) from part", [])), 3);
  let rw = begin_step(d0, Serializable, ReadWrite);
  let nested = begin_step(rw.db, ReadCommitted, ReadWrite);
  assert_eq(t_code(nested.out), "25001")
}

test "the savepoint stack is bounded" {
  assert_eq(
    t_code(
      t_deepen(begin_step(open(t_schema()), ReadCommitted, ReadWrite).db, max_savepoints() + 1).out,
    ),
    "54000",
  )
}

fn t_deepen(d: MemDb, left: Int) -> Outcome = {
  let r = begin_step(d, ReadCommitted, ReadWrite);
  if left <= 1 { r } else { t_deepen(r.db, left - 1) }
}

test "what the twin does not model, it refuses by name" {
  let d = t_seed();
  let refused = [
    "select p.sku from part p join bin b on p.sku = b.sku",
    "select sku from part where sku in (select sku from bin)",
    "select count(*), sku from part group by sku",
    "select sum(n) from part",
    "select sku from part union select sku from bin",
    "with x as (select 1) select sku from part",
    "insert into part (sku, price) values ('a', 1) on conflict do nothing",
    "select sku from part; select 1 from part",
    "create table t (a int)",
    "select sku from part order by n + 1",
    "select sku from part where tag like 'a%' escape '!'",
    "select 1e3 from part",
    "select now() from part",
    "select sku from part order by 1",
  ];
  assert_eq(map(refused, |s: String| t_code(t_out(d, s, []))), map(refused, |s: String| "0A000"))
}

test "a comment and a result-column alias are ordinary SQL rather than a refusal" {
  let d = t_seed();
  assert_eq(t_code(t_out(d, "select sku from part -- trailing", [])), "rows");
  assert_eq(t_code(t_out(d, "select /* leading */ sku from part order by sku", [])), "rows");
  assert_eq(t_code(t_out(d, "select /* a /* nested */ one */ sku from part", [])), "rows");
  assert_eq(
    t_out(d, "select sku as ident from part order by sku", []),
    Rows([
      map_insert(map_new(), "ident", CText("a")),
      map_insert(map_new(), "ident", CText("b")),
      map_insert(map_new(), "ident", CText("c")),
    ]),
  );
  assert_eq(
    t_out(d, "select count(*) as c from part", []),
    Rows([map_insert(map_new(), "c", CInt(3))]),
  );
  // Two targets under one name are still refused: a `Row` is a `Map`.
  assert_eq(t_code(t_out(d, "select sku, sku from part", [])), "0A000");
  assert_eq(t_code(t_out(d, "select sku as x, tag as x from part", [])), "0A000");
  // An unclosed comment is a refusal rather than a statement that lost its tail.
  assert_eq(t_code(t_out(d, "select sku from part /* never closed", [])), "0A000")
}

test "an unknown relation and an unknown column are named" {
  let d = t_seed();
  assert_eq(t_code(t_out(d, "select sku from nosuch order by sku", [])), "42P01");
  assert_eq(t_code(t_out(d, "select nosuch from part", [])), "42703");
  assert_eq(t_code(t_out(d, "select sku from part order by nosuch", [])), "42703")
}

test "a text parameter in an integer column is refused rather than coerced" {
  let d = open(t_schema());
  assert_eq(
    t_code(t_out(d, "insert into part (sku, price, n) values ('a', 1, $1)", [PText("x")])),
    "42804",
  );
  assert_eq(t_code(t_out(d, "insert into part (sku, price, n) values ('a', 1, 'x')", [])), "22P02")
}

// --- A live server ---------------------------------------------------------------
//
// The effect's own handler, over `std.pg`. A perform names its label — the table — and a clause
// written `[*]` answers every one of them, so the driver is here rather than in the host: the
// pool, the transaction scope, the text of every value and the tables a statement names. What is
// left to the host is `net`.

pub type Server = {
  host: String,
  port: Int,
  user: String,
  database: String,
  password: Option<String>,
  // Told to the server as each connection starts, so every connection the pool opens runs under
  // them: how long one statement may run, and a transaction sit idle between statements, before the
  // server ends it, in milliseconds (`None` leaves the server's own), and the name its sessions are
  // listed under.
  statement_timeout_ms: Option<Int>,
  idle_in_transaction_timeout_ms: Option<Int>,
  application_name: Option<String>,
  client: pg::Client,
}

pub fn server(
  host: String,
  port: Int,
  user: String,
  database: String,
  password: Option<String>,
) -> Server =
  {
    host: host,
    port: port,
    user: user,
    database: database,
    password: password,
    statement_timeout_ms: None,
    idle_in_transaction_timeout_ms: None,
    application_name: None,
    client: pg::default_client(),
  }

// The settings a connection starts with, under the names postgres gives them.
pub fn startup_parameters(s: Server) -> List<pg::Set> =
  concat_lists(
    concat_lists(
      parameter("application_name", s.application_name),
      parameter("statement_timeout", millis_text(s.statement_timeout_ms)),
    ),
    parameter("idle_in_transaction_session_timeout", millis_text(s.idle_in_transaction_timeout_ms)),
  )

fn parameter(name: String, value: Option<String>) -> List<pg::Set> =
  match value { Some(v) -> [{ name: name, value: v }], None -> [] }

fn millis_text(ms: Option<Int>) -> Option<String> =
  match ms { Some(n) -> Some(int_to_string(n)), None -> None }

// `n` numbers a connection among every one the pool has opened.
type Link = { n: Int, session: pg::Session }

// A transaction on connection `n`: `session` is `None` once the connection is lost, which ended the
// transaction on the server; `depth` counts the transaction and its savepoints; `level` and
// `access` are its outermost `begin`'s; `busy` while one of its operations is on the wire.
type Scope = {
  n: Int,
  session: Option<pg::Session>,
  depth: Int,
  level: Isolation,
  access: Access,
  busy: Bool,
}

// `opened` counts the connections open, which `size` bounds, and `made` every one ever opened.
type Pool = { idle: List<Link>, opened: Int, made: Int, open: List<Scope> }

// --- The text of a value ---------------------------------------------------------

fn hex_of(b: Bytes) -> String =
  fold(range(0, bytes_len(b)), "", |acc: String, i: Int| {
    let v = bytes_at(b, i);
    acc ++ string_slice("0123456789abcdef", v >>> 4, (v >>> 4) + 1)
      ++ string_slice("0123456789abcdef", v & 0xF, (v & 0xF) + 1)
  })

fn hex_value(c: Int) -> Int =
  if c >= 48 && c <= 57 { c - 48 }
  else if c >= 97 && c <= 102 { c - 87 }
  else if c >= 65 && c <= 70 { c - 55 }
  else { 0 }

fn unhex_text(text: String) -> Bytes = {
  let b = bytes_of_string(text);
  bytes_concat_all(
    map(range(0, bytes_len(b) / 2), |i: Int|
      byte_of_int(hex_value(bytes_at(b, i * 2)) * 16 + hex_value(bytes_at(b, i * 2 + 1)))),
  )
}

// Bytea's hex output is introduced by `\x`; the older escape format is read as its own bytes.
fn bytes_of_bytea(text: String) -> Bytes =
  if string_starts_with(text, "\\x") { unhex_text(string_slice(text, 2, string_len(text))) }
  else { bytes_of_string(text) }

fn signed_digits(text: String) -> Int = {
  let b = bytes_of_string(text);
  let negative = bytes_len(b) > 0 && bytes_at(b, 0) == 45;
  let from = if negative { 1 } else { 0 };
  let magnitude = fold(range(from, bytes_len(b)), 0, |acc: Int, i: Int| {
    let c = bytes_at(b, i);
    if c >= 48 && c <= 57 { acc * 10 + c - 48 } else { acc }
  });
  if negative { 0 - magnitude } else { magnitude }
}

fn nat_of_text(text: String) -> Int =
  fold(range(0, string_len(text)), 0, |acc: Int, i: Int| {
    let c = bytes_at(bytes_of_string(string_slice(text, i, i + 1)), 0);
    if c >= 48 && c <= 57 { acc * 10 + c - 48 } else { acc }
  })

fn float_of_text(text: String) -> Float = match float_of_string(text) { Some(f) -> f, None -> 0.0 }

fn decimal_of_text(text: String) -> Decimal =
  match decimal_of_string(text) { Some(d) -> d, None -> decimal_of_int(0) }

fn json_of_text(text: String) -> json::Json =
  match json::parse_string(text) { Ok(j) -> j, Err(_) -> json::Str(text) }

// The element type of an array type, or `0` when the OID is not one this reads.
fn element_oid(oid: Int) -> Int =
  if oid == 1000 { 16 }
  else if oid == 1001 { 17 }
  else if oid == 1005 { 21 }
  else if oid == 1007 { 23 }
  else if oid == 1016 { 20 }
  else if oid == 1009 { 25 }
  else if oid == 1015 { 1043 }
  else if oid == 1021 { 700 }
  else if oid == 1022 { 701 }
  else if oid == 1231 { 1700 }
  else if oid == 199 { 114 }
  else if oid == 3807 { 3802 }
  else { 0 }

// An array's text is `{...}`, elements separated by commas, quoted when they need to be, and the
// word `NULL` bare — so a quoted `NULL` is the text and an unquoted one is nothing.
type Scanning = {
  items: List<Datum>,
  piece: String,
  quoted: Bool,
  was_quoted: Bool,
  escaped: Bool,
  done: Bool,
}

fn array_values(element: Int, text: String) -> List<Datum> = {
  let inner = if string_len(text) >= 2 { string_slice(text, 1, string_len(text) - 1) } else { "" };
  let end = fold(
    range(0, string_len(inner)),
    { items: [], piece: "", quoted: false, was_quoted: false, escaped: false, done: false },
    |acc: Scanning, i: Int|
      if acc.done { acc } else {
        let c = string_slice(inner, i, i + 1);
        if acc.escaped { { ..acc, piece: acc.piece ++ c, escaped: false } }
        else if acc.quoted && c == "\\" { { ..acc, escaped: true } }
        else if c == "\"" { { ..acc, quoted: !acc.quoted, was_quoted: true } } else if !acc.quoted
            && c == "," {
          {
            ..acc,
            items: push(acc.items, array_value(element, acc.piece, acc.was_quoted)),
            piece: "",
            was_quoted: false,
          }
        } else { { ..acc, piece: acc.piece ++ c } }
      },
  );
  if string_len(inner) == 0 { [] }
  else { push(end.items, array_value(element, end.piece, end.was_quoted)) }
}

fn array_value(element: Int, piece: String, was_quoted: Bool) -> Datum =
  if !was_quoted && piece == "NULL" { CNull } else { datum_of(element, Some(piece)) }

fn datum_of(oid: Int, text: Option<String>) -> Datum =
  match text {
    None -> CNull,
    Some(t) -> if oid == 16 { CBool(t == "t") }
    else if oid == 20 || oid == 21 || oid == 23 { CInt(signed_digits(t)) }
    else if oid == 700 || oid == 701 { CFloat(float_of_text(t)) }
    else if oid == 1700 { CNumeric(decimal_of_text(t)) }
    else if oid == 17 { CBytes(bytes_of_bytea(t)) }
    else if oid == 114 || oid == 3802 { CJson(json_of_text(t)) }
    else if element_oid(oid) != 0 { CArray(array_values(element_oid(oid), t)) }
    else { CText(t) },
  }

// What the server sent for one column: text, except that bytea's hex form and the text of every
// other type are read by `datum_of`. `string_of_bytes_lossy` because a bytea is bytes, not text.
fn datum_bytes(oid: Int, raw: Option<Bytes>) -> Datum =
  match raw { None -> CNull, Some(b) -> datum_of(oid, Some(string_of_bytes_lossy(b))) }

fn param_text(p: Param) -> Option<String> =
  match p {
    PNull -> None,
    PInt(n) -> Some(int_to_string(n)),
    PBool(b) -> Some(if b { "t" } else { "f" }),
    PText(s) -> Some(s),
    PBytes(b) -> Some("\\x" ++ hex_of(b)),
    PFloat(f) -> Some(float_to_string(f)),
    PNumeric(d) -> Some(decimal_to_string(d)),
    PJson(j) -> Some(json::to_string(j)),
    PArray(items) ->
      Some("{" ++ string::join(map(items, |p: Param| array_element_text(p)), ",") ++ "}"),
  }

// An array element is always quoted, which is the one form whose escaping is two characters.
fn array_element_text(p: Param) -> String =
  match param_text(p) {
    None -> "NULL",
    Some(t) ->
      "\""
        ++ fold(range(0, string_len(t)), "", |acc: String, i: Int| {
          let c = string_slice(t, i, i + 1);
          if c == "\"" || c == "\\" { acc ++ "\\" ++ c } else { acc ++ c }
        })
        ++ "\"",
  }

// --- The answer a statement makes ------------------------------------------------

fn last_word(text: String) -> Option<String> =
  fold(string_split(text, " "), None, |acc: Option<String>, w: String|
    if string_len(w) > 0 { Some(w) } else { acc })

// `SELECT 3`, `INSERT 0 1`, `UPDATE 2`: the count is the tag's last number, and a tag with none
// (`BEGIN`) counts nothing.
fn count_of(tag: String) -> Int = match last_word(tag) { Some(w) -> nat_of_text(w), None -> 0 }

fn row_of(columns: List<pg::Column>, values: List<Option<Bytes>>, i: Int, acc: Row) -> Row =
  if i >= len(columns) { acc } else {
    match list_at(columns, i) {
      None -> acc,
      Some(column) -> {
        let raw = match list_at(values, i) { Some(v) -> v, None -> None };
        row_of(columns, values, i + 1, map_insert(acc, column.name, datum_bytes(column.ty, raw)))
      },
    }
  }

fn rows_of(columns: List<pg::Column>, rows: List<List<Option<Bytes>>>) -> List<Row> =
  map(rows, |r: List<Option<Bytes>>| row_of(columns, r, 0, map_new()))

// --- The scope a statement runs in -----------------------------------------------

fn isolation_sql(level: Isolation) -> String =
  match level {
    ReadCommitted -> "read committed",
    RepeatableRead -> "repeatable read",
    Serializable -> "serializable",
  }

fn access_sql(access: Access) -> String =
  match access { ReadWrite -> "read write", ReadOnly -> "read only" }

fn savepoint_name(depth: Int) -> String = "ply_sp" ++ int_to_string(depth)

// --- The handler's decisions -----------------------------------------------------
//
// Every operation takes what it will use from the pool before it sends a byte and settles what it
// used after, because a task parked on the wire lets another task's operation run in between.

// A handler cannot see which task performs an operation, so it goes by which transactions are
// between statements: the performer's own is never on the wire, because its task is the one running.
type Route = | Own(Scope) | NoTransaction | Ambiguous

fn route(open: List<Scope>) -> Route =
  match filter(open, |s: Scope| !s.busy) { [] -> NoTransaction, [s] -> Own(s), _ -> Ambiguous }

fn ambiguous(what: String) -> String =
  what
    ++ " was performed while two transactions were between statements, so which one it belongs to is unknown: a transaction is told apart by being the one not waiting on the server, so a task that holds one open must wait on nothing but its own statements"

// A connection for an operation outside any transaction, idle or still to be opened.
type Claim = | Idle(Link) | Fresh(Int)

fn claim_n(c: Claim) -> Int = match c { Idle(l) -> l.n, Fresh(n) -> n }

type Plan = | Answered(Answer) | Outside(Claim) | Within(Scope, pg::Session)

type Decided = { pool: Pool, plan: Plan }

fn outside(p: Pool, size: Int) -> Decided =
  match p.idle {
    [first, ..rest] -> { pool: { ..p, idle: rest }, plan: Outside(Idle(first)) },
    [] -> if p.opened >= size { { pool: p, plan: Answered(Failed(pool_busy(size))) } }
    else {
      { pool: { ..p, opened: p.opened + 1, made: p.made + 1 }, plan: Outside(Fresh(p.made)) }
    },
  }

fn pool_busy(size: Int) -> DbError =
  db_error("53300", "", "the pool of " ++ int_to_string(size) ++ " connection(s) is busy")

fn within(p: Pool, scope: Scope) -> Decided =
  match scope.session {
    None -> { pool: p, plan: Answered(Failed(connection_lost())) },
    Some(session) -> { pool: busy(p, scope.n), plan: Within(scope, session) },
  }

fn busy(p: Pool, n: Int) -> Pool =
  { ..p, open: map(p.open, |s: Scope| if s.n == n { { ..s, busy: true } } else { s }) }

fn for_statement(p: Pool, size: Int, what: String) -> Decided =
  match route(p.open) {
    Ambiguous -> panic(ambiguous(what)),
    Own(scope) -> within(p, scope),
    NoTransaction -> outside(p, size),
  }

// A `begin` inside the performer's transaction is a savepoint of it; any other opens a transaction
// on a connection of its own.
fn for_begin(p: Pool, size: Int, level: Isolation, access: Access) -> Decided =
  match route(p.open) {
    Ambiguous -> panic(ambiguous("`db.begin`")),
    NoTransaction -> outside(p, size),
    Own(scope) -> match scope.session {
      None -> within(p, scope),
      Some(s) -> match nested_refusal(
          s.status == pg::FailedTransaction,
          scope.depth,
          scope.level,
          scope.access,
          level,
          access,
        ) {
        Some(e) -> { pool: p, plan: Answered(Failed(e)) },
        None -> within(p, scope),
      },
    },
  }

type Closing = | Settled(Answer) | Closes(Scope, pg::Session)

type ToClose = { pool: Pool, closing: Closing }

// A transaction whose connection is lost has nothing to send: the server ended it when the
// connection went, and `lost` is the answer.
fn for_close(p: Pool, what: String, lost: Answer) -> ToClose =
  match route(p.open) {
    Ambiguous -> panic(ambiguous(what)),
    NoTransaction -> { pool: p, closing: Settled(Failed(no_transaction(what))) },
    Own(scope) -> match scope.session {
      None -> { pool: { ..p, open: without_scope(p.open, scope) }, closing: Settled(lost) },
      Some(session) -> { pool: busy(p, scope.n), closing: Closes(scope, session) },
    },
  }

fn without_scope(open: List<Scope>, scope: Scope) -> List<Scope> = {
  let others = filter(open, |s: Scope| s.n != scope.n);
  if scope.depth > 1 { push(others, { ..scope, depth: scope.depth - 1 }) } else { others }
}

// A connection let go of: still talking, and so back to the pool, or closed.
type Freed = | Reuse(Link) | Lost

// What an operation on connection `n` leaves: `scope` is its transaction as it now stands, `None`
// when there is none or it ended.
type Left = { answer: Answer, n: Int, scope: Option<Scope>, freed: Option<Freed> }

fn settle(p: Pool, left: Left) -> Pool = {
  let others = filter(p.open, |s: Scope| s.n != left.n);
  let q = { ..p, open: match left.scope { Some(s) -> push(others, s), None -> others } };
  match left.freed {
    None -> q,
    Some(Reuse(l)) -> { ..q, idle: push(q.idle, l) },
    Some(Lost) -> { ..q, opened: q.opened - 1 },
  }
}

// --- The errors a connection makes -----------------------------------------------

// A refusal is the server's own SQLSTATE; a conversation that failed is class `08`, the connection
// exceptions.
fn client_error(e: pg::ClientError) -> DbError =
  match e {
    pg::Rejected(_, s) -> server_error(s),
    pg::Refused(s) -> server_error(s),
    pg::Unreachable -> db_error("08001", "", pg::client_error_text(e)),
    pg::Unexpected(what) -> db_error("08P01", "", what),
    _ -> db_error("08006", "", pg::client_error_text(e)),
  }

fn server_error(s: pg::Server) -> DbError = {
  let said = if s.detail == "" { s.message } else { s.message ++ ": " ++ s.detail };
  db_error(s.code, s.constraint, said)
}

fn connection_lost() -> DbError =
  db_error(
    "08003",
    "",
    "the connection this transaction ran on was lost, and the transaction with it",
  )

// A `commit` the connection failed under may have been applied or not.
fn unresolved(e: pg::ClientError) -> DbError =
  db_error(
    "08007",
    "",
    "the connection failed before the server answered the commit: " ++ pg::client_error_text(e),
  )

fn is_space_byte(c: Int) -> Bool = c == 32 || c == 9 || c == 10 || c == 13 || c == 11 || c == 12

fn is_word_byte(c: Int) -> Bool =
  (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95 || (c >= 48 && c <= 57)

// --- Reading a statement ----------------------------------------------------------

// A statement is read before it is sent: the tables its text reaches are what its endpoints are
// scheduled on, so a statement whose footprint cannot be computed is refused rather than run with
// one that under-reports. The reader is a tokenizer and a small parser over it, and it refuses far
// more than it accepts: `with` is the only admitted construct that can hide a verb.

// What a statement does, which decides the operations that may perform it.
pub type ScanKind = | KSelect | KInsert | KUpdate | KDelete | KValues

pub fn kind_writes(k: ScanKind) -> Bool =
  match k { KSelect -> false, KValues -> false, KInsert -> true, KUpdate -> true, KDelete -> true }

pub fn kind_text(k: ScanKind) -> String =
  match k {
    KSelect -> "select",
    KValues -> "values",
    KInsert -> "insert",
    KUpdate -> "update",
    KDelete -> "delete",
  }

// The tables a statement names, split by what it does to them and deduplicated: one name is one
// entry, and a table that is written is not also reported as read.
pub type SqlTables = { written: List<String>, read: List<String> }

pub fn no_sql_tables() -> SqlTables = { written: [], read: [] }

fn sql_note_written(t: SqlTables, name: String) -> SqlTables =
  { ..t, written: sql_insert_table(t.written, name), read: sql_without_table(t.read, name) }

fn sql_note_read(t: SqlTables, name: String) -> SqlTables =
  if sql_has_table(t.written, name) { t } else { { ..t, read: sql_insert_table(t.read, name) } }

fn sql_absorb_tables(t: SqlTables, other: SqlTables) -> SqlTables =
  fold(
    other.written,
    fold(other.read, t, |acc: SqlTables, n: String| sql_note_read(acc, n)),
    |acc: SqlTables, n: String| sql_note_written(acc, n),
  )

fn sql_has_table(names: List<String>, name: String) -> Bool =
  fold(names, false, |acc: Bool, n: String| acc || n == name)

// Sorted, so one set is one list: two statements that touch the same tables read the same however
// they were written, and a comparison against a row does not depend on the order of the text.
fn sql_insert_table(names: List<String>, name: String) -> List<String> =
  if sql_has_table(names, name) { names } else { sql_in_order(names, name, []) }

fn sql_in_order(names: List<String>, name: String, before: List<String>) -> List<String> =
  match names {
    [] -> push(before, name),
    [h, ..rest] -> if sql_name_before(name, h) { concat_lists(push(before, name), names) }
    else { sql_in_order(rest, name, push(before, h)) },
  }

// A name's bytes, compared as postgres compares them: byte by byte, so `"Items"` sorts before
// `items`.
fn sql_name_before(a: String, b: String) -> Bool =
  sql_bytes_cmp(bytes_of_string(a), bytes_of_string(b)) < 0

fn sql_bytes_cmp(a: Bytes, b: Bytes) -> Int =
  if bytes_len(a) == 0 { if bytes_len(b) == 0 { 0 } else { -1 } }
  else if bytes_len(b) == 0 { 1 } else {
    let x = bytes_at(a, 0);
    let y = bytes_at(b, 0);
    if x == y { sql_bytes_cmp(bytes_slice(a, 1, bytes_len(a)), bytes_slice(b, 1, bytes_len(b))) }
    else if x < y { -1 }
    else { 1 }
  }

// Every table the statement names, written and read as one sorted list.
pub fn scan_table_names(t: SqlTables) -> List<String> = sql_merge_names(t.written, t.read)

fn sql_merge_names(a: List<String>, b: List<String>) -> List<String> =
  match a {
    [] -> b,
    [ah, ..at] -> match b {
      [] -> a,
      [bh, ..bt] -> if ah == bh { concat_lists([ah], sql_merge_names(at, bt)) }
      else if sql_name_before(ah, bh) { concat_lists([ah], sql_merge_names(at, b)) }
      else { concat_lists([bh], sql_merge_names(a, bt)) },
    },
  }

fn sql_without_table(names: List<String>, name: String) -> List<String> =
  fold(names, [], |acc: List<String>, n: String| if n == name { acc } else { push(acc, n) })

// --- The tokens --------------------------------------------------------------------

// A token, with the source text it was read from, so a refusal can name it.
pub type SqlTok =
  | SqlWord({ text: String, quoted: Bool })
  | SqlNumber
  | SqlText
  | SqlPlaceholder
  | SqlPunct(String)
  | SqlSemi

pub type SqlTokAt = { tok: SqlTok, at: Int, text: String }

pub fn sql_is_word(t: SqlTok, word: String) -> Bool =
  match t { SqlWord(w) -> if w.quoted { false } else { w.text == word }, _ -> false }

pub fn sql_is_punct(t: SqlTok, p: String) -> Bool = match t { SqlPunct(x) -> x == p, _ -> false }

pub fn sql_is_semi(t: SqlTok) -> Bool = match t { SqlSemi -> true, _ -> false }

// The tokens of `sql`, in order. Whitespace and comments are dropped, and a quote that is never
// closed is refused rather than guessed at: past one, the reader cannot tell text from statement.
pub fn tokenize(sql: String) -> Result<List<SqlTokAt>, DbError> = {
  let b = bytes_of_string(sql);
  sql_tokens_from(b, 0, [])
}

fn sql_tokens_from(b: Bytes, at: Int, acc: List<SqlTokAt>) -> Result<List<SqlTokAt>, DbError> = {
  let i = sql_skip_trivia(b, at)?;
  if i >= bytes_len(b) { Ok(acc) } else {
    let step = sql_next_token(b, i)?;
    sql_tokens_from(b, step.next, push(acc, step.tok))
  }
}

fn sql_skip_trivia(b: Bytes, at: Int) -> Result<Int, DbError> =
  if at >= bytes_len(b) { Ok(at) }
  else if is_space_byte(bytes_at(b, at)) { sql_skip_trivia(b, at + 1) } else if bytes_at(b, at)
      == 45
      && sql_byte_is(b, at + 1, 45) { sql_skip_trivia(b, sql_past_line(b, at)) } else if bytes_at(
        b,
        at,
      )
      == 47
      && sql_byte_is(b, at + 1, 42) {
    match sql_past_comment(b, at + 2, 1) {
      Err(_) -> Err(sql_unclosed(b, at, "a block comment")),
      Ok(e) -> sql_skip_trivia(b, e),
    }
  } else { Ok(at) }

fn sql_byte_is(b: Bytes, at: Int, c: Int) -> Bool = at < bytes_len(b) && bytes_at(b, at) == c

fn sql_past_line(b: Bytes, at: Int) -> Int =
  if at >= bytes_len(b) { at }
  else if bytes_at(b, at) == 10 { at + 1 }
  else { sql_past_line(b, at + 1) }

// Postgres nests block comments, so stopping at the first `*/` would leave statement text behind.
fn sql_past_comment(b: Bytes, at: Int, depth: Int) -> Result<Int, Int> =
  if at >= bytes_len(b) { Err(at) } else if bytes_at(b, at) == 47 && sql_byte_is(b, at + 1, 42) {
    sql_past_comment(b, at + 2, depth + 1)
  } else if bytes_at(b, at) == 42 && sql_byte_is(b, at + 1, 47) {
    if depth == 1 { Ok(at + 2) } else { sql_past_comment(b, at + 2, depth - 1) }
  } else { sql_past_comment(b, at + 1, depth) }

fn sql_next_token(b: Bytes, at: Int) -> Result<{ tok: SqlTokAt, next: Int }, DbError> = {
  let c = bytes_at(b, at);
  if c == 59 { Ok(sql_filled(b, at, at + 1, SqlSemi)) }
  else if c == 39 { sql_literal(b, at, at + 1, at, false) } else if (c == 101 || c == 69)
      && sql_byte_is(b, at + 1, 39) { sql_literal(b, at, at + 2, at + 1, true) } else if (c == 98
      || c == 66
      || c == 120
      || c == 88)
      && sql_byte_is(b, at + 1, 39) { sql_literal(b, at, at + 2, at + 1, false) } else if (c == 117
      || c == 85)
      && sql_byte_is(b, at + 1, 38)
      && sql_byte_is(b, at + 2, 39) { sql_literal(b, at, at + 3, at + 2, false) }
  else if c == 34 { sql_quoted_word(b, at, at + 1, at) } else if c == 36 {
    match sql_digit_end(b, at + 1) {
      Some(e) -> Ok(sql_filled(b, at, e, SqlPlaceholder)),
      None -> sql_dollar_quoted(b, at),
    }
  } else if sql_is_digit(c) { Ok(sql_filled(b, at, sql_past_number(b, at), SqlNumber)) } else if sql_is_name_byte(
      c,
    ) {
    Ok(
      sql_filled(
        b,
        at,
        sql_past_word(b, at),
        SqlWord({ text: sql_lower_bytes(b, at, sql_past_word(b, at)), quoted: false }),
      ),
    )
  } else { Ok(sql_filled(b, at, at + 1, SqlPunct(string_of_bytes(bytes_slice(b, at, at + 1))))) }
}

fn sql_filled(b: Bytes, at: Int, next: Int, tok: SqlTok) -> { tok: SqlTokAt, next: Int } =
  { tok: { tok: tok, at: at, text: string_of_bytes(bytes_slice(b, at, next)) }, next: next }

fn sql_unclosed(b: Bytes, at: Int, what: String) -> DbError =
  db_error(
    "0A000",
    "",
    what ++ " opened at byte " ++ int_to_string(at)
      ++ " is never closed, and past one the reader cannot tell text from statement",
  )

fn sql_lower_bytes(b: Bytes, at: Int, end: Int) -> String =
  string_of_bytes(
    fold(range(at, end), b"", |acc: Bytes, i: Int| {
      let c = bytes_at(b, i);
      bytes_concat(acc, byte_of_int(if c >= 65 && c <= 90 { c + 32 } else { c }))
    }),
  )

// The end of a string sql_literal, from just after its opening quote.
fn sql_end_of_literal(b: Bytes, at: Int, open: Int, escapes: Bool) -> Result<Int, DbError> =
  if at >= bytes_len(b) { Err(sql_unclosed(b, open, "a string sql_literal")) }
  else if escapes && bytes_at(b, at) == 92 { sql_end_of_literal(b, at + 2, open, escapes) } else if bytes_at(
        b,
        at,
      )
      == 39
      && sql_byte_is(b, at + 1, 39) { sql_end_of_literal(b, at + 2, open, escapes) }
  else if bytes_at(b, at) == 39 { Ok(at + 1) }
  else { sql_end_of_literal(b, at + 1, open, escapes) }

fn sql_literal(
  b: Bytes,
  start: Int,
  body: Int,
  quote: Int,
  escapes: Bool,
) -> Result<{ tok: SqlTokAt, next: Int }, DbError> =
  match sql_end_of_literal(b, body, quote, escapes) {
    Err(e) -> Err(e),
    Ok(e) -> Ok(sql_filled(b, start, e, SqlText)),
  }

fn sql_end_of_quoted(b: Bytes, at: Int, open: Int) -> Result<Int, DbError> =
  if at >= bytes_len(b) { Err(sql_unclosed(b, open, "a quoted identifier")) }
  else if bytes_at(b, at) == 34 && sql_byte_is(b, at + 1, 34) { sql_end_of_quoted(b, at + 2, open) }
  else if bytes_at(b, at) == 34 { Ok(at + 1) }
  else { sql_end_of_quoted(b, at + 1, open) }

fn sql_quoted_word(
  b: Bytes,
  start: Int,
  body: Int,
  quote: Int,
) -> Result<{ tok: SqlTokAt, next: Int }, DbError> =
  match sql_end_of_quoted(b, body, quote) {
    Err(e) -> Err(e),
    Ok(e) ->
      Ok(
        sql_filled(b, start, e, SqlWord({ text: sql_unquoted(b, body, e - 1, b""), quoted: true })),
      ),
  }

// The name inside `"…"`, with a doubled quote standing for one.
fn sql_unquoted(b: Bytes, at: Int, end: Int, acc: Bytes) -> String =
  if at >= end { string_of_bytes(acc) } else if bytes_at(b, at) == 34
      && sql_byte_is(b, at + 1, 34) {
    sql_unquoted(b, at + 2, end, bytes_concat(acc, byte_of_int(34)))
  } else { sql_unquoted(b, at + 1, end, bytes_concat(acc, byte_of_int(bytes_at(b, at)))) }

// `$1` … `$9`: where the digits end, or `None` when this is a dollar quote instead.
fn sql_digit_end(b: Bytes, at: Int) -> Option<Int> =
  if at >= bytes_len(b) || !sql_is_digit(bytes_at(b, at)) { None }
  else { Some(sql_past_number(b, at)) }

// `$tag$ … $tag$`, where the tag may be empty.
fn sql_dollar_quoted(b: Bytes, at: Int) -> Result<{ tok: SqlTokAt, next: Int }, DbError> = {
  let tag_end = sql_past_tag(b, at + 1);
  if !sql_byte_is(b, tag_end, 36) { Err(sql_unclosed(b, at, "a dollar-quoted string")) } else {
    let tag = bytes_slice(b, at, tag_end + 1);
    match sql_find_tag(b, tag, tag_end + 1) {
      None -> Err(sql_unclosed(b, at, "a dollar-quoted string")),
      Some(e) -> Ok(sql_filled(b, at, e + bytes_len(tag), SqlText)),
    }
  }
}

fn sql_past_tag(b: Bytes, at: Int) -> Int =
  if at < bytes_len(b) && (sql_is_name_byte(bytes_at(b, at)) || sql_is_digit(bytes_at(b, at))) {
    sql_past_tag(b, at + 1)
  } else { at }

fn sql_find_tag(b: Bytes, tag: Bytes, at: Int) -> Option<Int> =
  if at + bytes_len(tag) > bytes_len(b) { None }
  else if sql_tag_at(b, tag, at) { Some(at) }
  else { sql_find_tag(b, tag, at + 1) }

fn sql_tag_at(b: Bytes, tag: Bytes, at: Int) -> Bool =
  fold(range(0, bytes_len(tag)), true, |acc: Bool, i: Int|
    acc && bytes_at(b, at + i) == bytes_at(tag, i))

// A number runs to the next byte that is not part of one, as postgres' own lexer reads it.
fn sql_past_number(b: Bytes, at: Int) -> Int =
  if at < bytes_len(b) && (is_word_byte(bytes_at(b, at)) || bytes_at(b, at) == 46) {
    sql_past_number(b, at + 1)
  } else { at }

fn sql_past_word(b: Bytes, at: Int) -> Int =
  if at < bytes_len(b)
      && (sql_is_name_byte(bytes_at(b, at)) || sql_is_digit(bytes_at(b, at))
      || bytes_at(b, at) == 36) { sql_past_word(b, at + 1) }
  else { at }

fn sql_is_digit(c: Int) -> Bool = c >= 48 && c <= 57

fn sql_is_name_byte(c: Int) -> Bool =
  (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95 || c >= 128

// What each token of `sql` is, which is what a test of the reader compares and what a refusal
// quotes back.
pub fn sql_token_summary(t: SqlTokAt) -> String =
  match t.tok {
    SqlWord(w) -> if w.quoted { "quoted:" ++ w.text } else { "word:" ++ w.text },
    SqlNumber -> "number:" ++ t.text,
    SqlText -> "text:" ++ t.text,
    SqlPlaceholder -> "placeholder:" ++ t.text,
    SqlPunct(p) -> "punct:" ++ p,
    SqlSemi -> "semi",
  }

pub fn sql_tokenize_summary(sql: String) -> Result<List<String>, DbError> =
  match tokenize(sql) {
    Err(e) -> Err(e),
    Ok(ts) -> Ok(map(ts, |t: SqlTokAt| sql_token_summary(t))),
  }

// --- The parser --------------------------------------------------------------------

// What a statement does and which tables its text reaches. `written` and `read` are what the row of
// the definition that reached the call site is checked against, so a construct the reader cannot
// account for is refused rather than run with a footprint that under-reports.
pub type SqlScan = { kind: ScanKind, tables: SqlTables }

// A statement that writes anywhere — including inside a `with` — is a write wherever it leads.
pub fn scan_writes(s: SqlScan) -> Bool = kind_writes(s.kind) || len(s.tables.written) > 0

// The reader's position: the tokens left, the common table expressions in scope, and how deep the
// statement has nested.
type SqlAt = { toks: List<SqlTokAt>, ctes: List<String>, depth: Int, end_pos: Int }

fn sql_nesting() -> Int = 32

fn sql_refuse(where_: String, at: Int, why: String) -> DbError =
  db_error(
    "0A000",
    "",
    "the database driver refuses this statement: " ++ where_ ++ " at byte " ++ int_to_string(at)
      ++ ". "
      ++ why,
  )

fn sql_refuse_tok(t: SqlTokAt, why: String) -> DbError = sql_refuse("`" ++ t.text ++ "`", t.at, why)

fn sql_here(p: SqlAt, why: String) -> DbError =
  match sql_head(p.toks) {
    Some(t) -> sql_refuse_tok(t, why),
    None -> sql_refuse("the statement ends", p.end_pos, why),
  }

fn sql_stacked(at: Int) -> DbError =
  db_error(
    "0A000",
    "",
    "the database driver refuses this statement: `Stmt` holds more than one statement, and a `;` is at byte "
      ++ int_to_string(at)
      ++ ". One `Stmt` is one statement, which is what removes the stacked-statement payload an injected fragment would otherwise become",
  )

fn sql_head(toks: List<SqlTokAt>) -> Option<SqlTokAt> =
  match toks { [] -> None, [h, ..rest] -> Some(h) }

fn sql_rest(toks: List<SqlTokAt>) -> List<SqlTokAt> = match toks { [] -> [], [h, ..rest] -> rest }

fn sql_nth(toks: List<SqlTokAt>, n: Int) -> Option<SqlTokAt> =
  if n <= 0 { sql_head(toks) }
  else { match toks { [] -> None, [h, ..rest] -> sql_nth(rest, n - 1) } }

fn sql_step(p: SqlAt) -> SqlAt = { ..p, toks: sql_rest(p.toks) }

fn sql_at_word(p: SqlAt, word: String) -> Bool =
  match sql_head(p.toks) { Some(t) -> sql_is_word(t.tok, word), None -> false }

fn sql_at_punct(p: SqlAt, k: String) -> Bool =
  match sql_head(p.toks) { Some(t) -> sql_is_punct(t.tok, k), None -> false }

fn sql_eat_word(p: SqlAt, word: String) -> { p: SqlAt, ate: Bool } =
  if sql_at_word(p, word) { { p: sql_step(p), ate: true } } else { { p: p, ate: false } }

fn sql_eat_punct(p: SqlAt, k: String) -> { p: SqlAt, ate: Bool } =
  if sql_at_punct(p, k) { { p: sql_step(p), ate: true } } else { { p: p, ate: false } }

fn sql_expect_word(p: SqlAt, word: String) -> Result<SqlAt, DbError> =
  if sql_at_word(p, word) { Ok(sql_step(p)) }
  else { Err(sql_here(p, "`" ++ word ++ "` was expected here")) }

fn sql_expect_punct(p: SqlAt, k: String) -> Result<SqlAt, DbError> =
  if sql_at_punct(p, k) { Ok(sql_step(p)) }
  else { Err(sql_here(p, "`" ++ k ++ "` was expected here")) }

fn sql_identifier(p: SqlAt, what: String) -> Result<{ p: SqlAt, name: String }, DbError> =
  match sql_head(p.toks) {
    Some(t) -> match t.tok {
      SqlWord(w) -> Ok({ p: sql_step(p), name: w.text }),
      _ -> Err(sql_refuse_tok(t, what ++ " was expected here")),
    },
    None -> Err(sql_here(p, what ++ " was expected here")),
  }

// `[schema.]name`, answering the last segment.
fn sql_qualified_name(p: SqlAt, rest: Int) -> Result<{ p: SqlAt, name: String }, DbError> = {
  let first = sql_identifier(p, "a table name")?;
  sql_more_names(first.p, first.name)
}

fn sql_more_names(p: SqlAt, name: String) -> Result<{ p: SqlAt, name: String }, DbError> =
  if !sql_at_punct(p, ".") { Ok({ p: p, name: name }) } else {
    match sql_nth(p.toks, 1) {
      Some(next) -> match next.tok {
        SqlWord(w) -> {
          let after = sql_step(sql_step(p));
          sql_more_names(after, w.text)
        },
        _ -> Ok({ p: p, name: name }),
      },
      None -> Ok({ p: p, name: name }),
    }
  }

// `[AS] alias [(columns)]`, if there is one. A word that is reserved cannot be an alias without
// `AS`, so a statement is not read as though a clause word were a name.
fn sql_alias(p: SqlAt) -> Result<SqlAt, DbError> = {
  let as_ = sql_eat_word(p, "as");
  if as_.ate {
    let named = sql_identifier(as_.p, "an alias")?;
    sql_alias_columns(named.p)
  } else {
    match sql_head(p.toks) {
      Some(t) -> match t.tok {
        SqlWord(w) -> if w.quoted || !sql_reserved(w.text) { sql_alias_columns(sql_step(p)) }
        else { Ok(p) },
        _ -> Ok(p),
      },
      None -> Ok(p),
    }
  }
}

fn sql_alias_columns(p: SqlAt) -> Result<SqlAt, DbError> = {
  let open = sql_eat_punct(p, "(");
  if open.ate { sql_name_list(open.p) } else { Ok(p) }
}

// A column list, which consumes its own `)`.
fn sql_name_list(p: SqlAt) -> Result<SqlAt, DbError> = {
  let first = sql_identifier(p, "a column name")?;
  let comma = sql_eat_punct(first.p, ",");
  if comma.ate { sql_name_list(comma.p) } else { sql_expect_punct(first.p, ")") }
}

// --- What the reader vouches for ----------------------------------------------------

// Words that may precede a `(` without being a call.
fn sql_syntactic() -> List<String> = ["array", "cast", "exists", "row", "any", "some", "nullif"]

// Functions whose value is not a function of the program's state. Refused inside statement text:
// a timestamp belongs in the row as a parameter, where the effect system can see it.
fn sql_nondeterministic() -> List<String> =
  [
    "now",
    "random",
    "current_timestamp",
    "current_date",
    "current_time",
    "localtime",
    "localtimestamp",
    "clock_timestamp",
    "statement_timestamp",
    "transaction_timestamp",
    "timeofday",
    "gen_random_uuid",
  ]

// The calls a statement may make. A call is the one place an admitted statement can reach outside
// its own table set, so the list is closed.
fn sql_callable() -> List<String> =
  [
    "avg",
    "count",
    "max",
    "min",
    "sum",
    "coalesce",
    "greatest",
    "least",
    "nullif",
    "abs",
    "ceil",
    "ceiling",
    "div",
    "exp",
    "floor",
    "ln",
    "log",
    "mod",
    "power",
    "round",
    "sign",
    "sqrt",
    "trunc",
    "btrim",
    "char_length",
    "character_length",
    "concat",
    "concat_ws",
    "decode",
    "encode",
    "left",
    "length",
    "lower",
    "lpad",
    "ltrim",
    "md5",
    "octet_length",
    "overlay",
    "position",
    "repeat",
    "replace",
    "reverse",
    "right",
    "rpad",
    "rtrim",
    "split_part",
    "starts_with",
    "strpos",
    "substr",
    "substring",
    "translate",
    "trim",
    "upper",
    "json_build_array",
    "json_build_object",
    "jsonb_array_length",
    "jsonb_build_array",
    "jsonb_build_object",
    "jsonb_extract_path",
    "jsonb_extract_path_text",
    "jsonb_strip_nulls",
    "jsonb_typeof",
    "to_json",
    "to_jsonb",
  ]

// Words that end an expression at depth zero.
fn sql_clause_words() -> List<String> =
  [
    "from",
    "where",
    "group",
    "having",
    "window",
    "order",
    "limit",
    "offset",
    "fetch",
    "for",
    "union",
    "intersect",
    "except",
    "returning",
    "using",
    "on",
    "set",
    "values",
    "join",
    "inner",
    "left",
    "right",
    "full",
    "cross",
    "natural",
    "as",
  ]

fn sql_reserved(word: String) -> Bool =
  sql_has_table(sql_clause_words(), word)
    || sql_has_table(
      [
        "select",
        "insert",
        "update",
        "delete",
        "with",
        "into",
        "and",
        "or",
        "not",
        "null",
        "is",
        "in",
        "between",
        "like",
        "ilike",
        "similar",
        "when",
        "then",
        "else",
        "end",
        "case",
        "asc",
        "desc",
        "nulls",
        "first",
        "last",
        "all",
        "distinct",
        "only",
        "lateral",
        "default",
        "conflict",
        "do",
        "nothing",
        "recursive",
        "materialized",
        "by",
        "outer",
      ],
      word,
    )

// A word followed by `(` is a call unless it is reserved, a syntactic form, or one of the names
// above. Everything else is refused where it is written.
fn sql_check_call(p: SqlAt) -> Result<SqlAt, DbError> =
  match sql_head(p.toks) {
    None -> Ok(p),
    Some(t) -> match t.tok {
      SqlWord(w) -> if w.quoted || !sql_at_punct(sql_step(p), "(") { Ok(p) } else if sql_reserved(
            w.text,
          )
          || sql_has_table(sql_syntactic(), w.text)
          || sql_has_table(sql_callable(), w.text) { Ok(p) } else {
        Err(
          sql_refuse_tok(
            t,
            "this call is not one the reader will vouch for: a call is the one place an admitted statement reaches outside its own table set, and it can only report the relations it was selected from",
          ),
        )
      },
      _ -> Ok(p),
    },
  }

fn sql_reject_nondeterministic(p: SqlAt) -> Result<SqlAt, DbError> = sql_reject_in(p.toks, p)

fn sql_reject_in(toks: List<SqlTokAt>, p: SqlAt) -> Result<SqlAt, DbError> =
  match toks {
    [] -> Ok(p),
    [t, ..rest] -> match t.tok {
      SqlWord(w) -> if !w.quoted && sql_has_table(sql_nondeterministic(), w.text) {
        Err(
          sql_refuse_tok(
            t,
            "`" ++ w.text
              ++ "` is not a function of the program's state, so it cannot be hidden in statement text: pass the value as a parameter, where the row the effect system sees says where it came from",
          ),
        )
      } else { sql_reject_in(rest, p) },
      _ -> sql_reject_in(rest, p),
    },
  }

// --- The statement ------------------------------------------------------------------

fn sql_statement(p: SqlAt) -> Result<{ p: SqlAt, scan: SqlScan }, DbError> = {
  let deeper = { ..p, depth: p.depth + 1 };
  if deeper.depth > sql_nesting() {
    Err(sql_here(p, "this statement nests deeper than the reader will follow"))
  } else {
    match sql_reject_nondeterministic(deeper) {
      Err(e) -> Err(e),
      Ok(checked) -> sql_with_clause(checked),
    }
  }
}

// `with` is the one admitted construct that can hide a verb: a CTE's body is a whole statement, so
// a `delete` inside one makes a statement led by `select` a write.
fn sql_with_clause(p: SqlAt) -> Result<{ p: SqlAt, scan: SqlScan }, DbError> = {
  let opening = sql_eat_word(p, "with");
  if !opening.ate { sql_body(p) } else {
    let recursive = sql_eat_word(opening.p, "recursive");
    sql_cte_list(recursive.p, recursive.ate, no_sql_tables())
  }
}

fn sql_cte_list(
  p: SqlAt,
  recursive: Bool,
  gathered: SqlTables,
) -> Result<{ p: SqlAt, scan: SqlScan }, DbError> =
  match sql_cte(p, recursive) {
    Err(e) -> Err(e),
    Ok(one) -> {
      let absorbed = sql_absorb_tables(gathered, one.tables);
      let comma = sql_eat_punct(one.p, ",");
      if comma.ate { sql_cte_list(comma.p, recursive, absorbed) } else {
        match sql_body(comma.p) {
          Err(e) -> Err(e),
          Ok(b) ->
            Ok({
              p: b.p,
              scan: { kind: b.scan.kind, tables: sql_absorb_tables(absorbed, b.scan.tables) },
            }),
        }
      }
    },
  }

fn sql_cte(p: SqlAt, recursive: Bool) -> Result<{ p: SqlAt, tables: SqlTables }, DbError> = {
  let named = sql_identifier(p, "a common table expression's name")?;
  // A `recursive` CTE names itself in its body, so its name is in scope before the body is read.
  let scope = if recursive { push(named.p.ctes, named.name) } else { named.p.ctes };
  let in_scope = { ..named.p, ctes: scope };
  let columns = sql_eat_punct(in_scope, "(");
  match sql_after_columns(columns) {
    Err(e) -> Err(e),
    Ok(listed) -> match sql_expect_word(listed, "as") {
      Err(e) -> Err(e),
      Ok(after_as) -> {
        let not_ = sql_eat_word(after_as, "not");
        let materialized = sql_eat_word(not_.p, "materialized");
        match sql_expect_punct(materialized.p, "(") {
          Err(e) -> Err(e),
          Ok(inside) -> match sql_statement(inside) {
            Err(e) -> Err(e),
            Ok(inner) -> match sql_expect_punct(inner.p, ")") {
              Err(e) -> Err(e),
              Ok(after) ->
                Ok({
                  p: { ..after, ctes: push(after.ctes, named.name) },
                  tables: sql_without_names(inner.scan.tables, after.ctes),
                }),
            },
          },
        }
      },
    },
  }
}

// The column list after a table name, if there is one.
fn sql_after_columns(columns: { p: SqlAt, ate: Bool }) -> Result<SqlAt, DbError> =
  if columns.ate { sql_name_list(columns.p) } else { Ok(columns.p) }

// A nested statement, which inherits the enclosing `WITH`'s names: a reference to a CTE names that
// expression rather than a table.
fn sql_without_names(tables: SqlTables, names: List<String>) -> SqlTables =
  {
    written: fold(names, tables.written, |acc: List<String>, n: String| sql_without_table(acc, n)),
    read: fold(names, tables.read, |acc: List<String>, n: String| sql_without_table(acc, n)),
  }

fn sql_body(p: SqlAt) -> Result<{ p: SqlAt, scan: SqlScan }, DbError> =
  match sql_head(p.toks) {
    None -> Err(sql_here(p, "this statement is empty")),
    Some(t) -> if sql_is_semi(t.tok) { Err(sql_stacked(t.at)) } else if sql_is_word(t.tok, "select")
        || sql_is_punct(t.tok, "(") {
      match sql_select_stmt(p) {
        Err(e) -> Err(e),
        Ok(s) -> Ok({ p: s.p, scan: { kind: KSelect, tables: s.tables } }),
      }
    } else if sql_is_word(t.tok, "values") {
      match sql_select_stmt(p) {
        Err(e) -> Err(e),
        Ok(s) -> Ok({ p: s.p, scan: { kind: KValues, tables: s.tables } }),
      }
    } else if sql_is_word(t.tok, "insert") { sql_insert(p) }
    else if sql_is_word(t.tok, "update") { sql_update(p) }
    else if sql_is_word(t.tok, "delete") { sql_delete(p) } else {
      Err(
        sql_refuse_tok(
          t,
          "a statement begins with one of `select`, `insert`, `update`, `delete` or `values`, with an optional `with`",
        ),
      )
    },
  }

fn sql_select_stmt(p: SqlAt) -> Result<{ p: SqlAt, tables: SqlTables }, DbError> =
  match sql_select_core(p) {
    Err(e) -> Err(e),
    Ok(core) -> {
      match sql_select_arms(core.p, core.tables) {
        Err(e) -> Err(e),
        Ok(armed) -> sql_select_tail(armed.p, armed.tables),
      }
    },
  }

fn sql_select_arms(
  p: SqlAt,
  tables: SqlTables,
) -> Result<{ p: SqlAt, tables: SqlTables }, DbError> =
  if sql_at_word(p, "union") || sql_at_word(p, "intersect") || sql_at_word(p, "except") {
    let opened = sql_step(p);
    let quantified = sql_eat_word(sql_eat_word(opened, "all").p, "distinct");
    match sql_select_core(quantified.p) {
      Err(e) -> Err(e),
      Ok(inner) -> sql_select_arms(inner.p, sql_absorb_tables(tables, inner.tables)),
    }
  } else { Ok({ p: p, tables: tables }) }

fn sql_select_tail(
  p: SqlAt,
  tables: SqlTables,
) -> Result<{ p: SqlAt, tables: SqlTables }, DbError> = {
  let ordered = sql_eat_word(p, "order");
  let after_order = if ordered.ate {
    match sql_expect_word(ordered.p, "by") {
      Err(e) -> Err(e),
      Ok(after) -> sql_skip_expr(after, tables, ["limit", "offset", "fetch", "for"], false),
    }
  } else { Ok({ p: p, tables: tables }) };
  match after_order { Err(e) -> Err(e), Ok(o) -> sql_select_tails(o.p, o.tables) }
}

fn sql_select_tails(
  p: SqlAt,
  tables: SqlTables,
) -> Result<{ p: SqlAt, tables: SqlTables }, DbError> =
  if sql_at_word(p, "limit") || sql_at_word(p, "offset") {
    let opened = sql_step(p);
    match sql_skip_expr(opened, tables, ["limit", "offset", "fetch", "for"], false) {
      Err(e) -> Err(e),
      Ok(o) -> sql_select_tails(o.p, o.tables),
    }
  } else if sql_at_word(p, "fetch") || sql_at_word(p, "for") {
    match sql_head(p.toks) {
      Some(t) ->
        Err(
          sql_refuse_tok(
            t,
            "`fetch` and the row-locking clauses are outside the statements this reader admits: a row lock is a write it cannot express",
          ),
        ),
      None -> Err(sql_here(p, "the statement ends mid-clause")),
    }
  } else { Ok({ p: p, tables: tables }) }

fn sql_select_core(p: SqlAt) -> Result<{ p: SqlAt, tables: SqlTables }, DbError> = {
  let open = sql_eat_punct(p, "(");
  if open.ate {
    match sql_select_stmt(open.p) {
      Err(e) -> Err(e),
      Ok(inner) -> match sql_expect_punct(inner.p, ")") {
        Err(e) -> Err(e),
        Ok(after) -> Ok({ p: after, tables: inner.tables }),
      },
    }
  } else if sql_at_word(p, "values") { sql_values_rows(sql_step(p), no_sql_tables()) } else {
    let opened = sql_expect_word(p, "select");
    match opened {
      Err(e) -> Err(e),
      Ok(after_select) -> {
        let alls = sql_eat_word(after_select, "all");
        let distinct = sql_eat_word(alls.p, "distinct");
        let on_prefix = if distinct.ate { sql_eat_word(distinct.p, "on") }
        else { { p: distinct.p, ate: false } };
        let after_prefix = if on_prefix.ate {
          match sql_expect_punct(on_prefix.p, "(") {
            Err(e) -> Err(e),
            Ok(open) -> sql_skip_parens(open, no_sql_tables()),
          }
        } else { Ok({ p: distinct.p, tables: no_sql_tables() }) };
        match after_prefix {
          Err(e) -> Err(e),
          Ok(prefixed) -> match sql_target_list(prefixed.p, prefixed.tables) {
            Err(e) -> Err(e),
            Ok(targets) -> sql_select_rest(targets),
          },
        }
      },
    }
  }
}

fn sql_select_rest(
  at: { p: SqlAt, tables: SqlTables },
) -> Result<{ p: SqlAt, tables: SqlTables }, DbError> = {
  let from = sql_source_after_from(at)?;
  let filtered = sql_select_filter(from)?;
  let grouped = sql_select_grouped(filtered)?;
  sql_select_having(grouped)
}

fn sql_source_after_from(
  at: { p: SqlAt, tables: SqlTables },
) -> Result<{ p: SqlAt, tables: SqlTables }, DbError> = {
  let from = sql_eat_word(at.p, "from");
  if from.ate { sql_source_list(from.p, at.tables) } else { Ok(at) }
}

fn sql_select_filter(
  at: { p: SqlAt, tables: SqlTables },
) -> Result<{ p: SqlAt, tables: SqlTables }, DbError> = {
  let where_ = sql_eat_word(at.p, "where");
  if where_.ate { sql_skip_expr(where_.p, at.tables, sql_clause_words(), false) } else { Ok(at) }
}

fn sql_select_grouped(
  at: { p: SqlAt, tables: SqlTables },
) -> Result<{ p: SqlAt, tables: SqlTables }, DbError> = {
  let group = sql_eat_word(at.p, "group");
  if group.ate {
    match sql_expect_word(group.p, "by") {
      Err(e) -> Err(e),
      Ok(after) -> sql_skip_expr(after, at.tables, sql_clause_words(), false),
    }
  } else { Ok(at) }
}

fn sql_select_having(
  at: { p: SqlAt, tables: SqlTables },
) -> Result<{ p: SqlAt, tables: SqlTables }, DbError> = {
  let having = sql_eat_word(at.p, "having");
  let after = if having.ate { sql_skip_expr(having.p, at.tables, sql_clause_words(), false) }
  else { Ok(at) };
  match after {
    Err(e) -> Err(e),
    Ok(h) -> if sql_at_word(h.p, "window") {
      match sql_head(h.p.toks) {
        Some(t) -> Err(sql_refuse_tok(t, "window definitions are not modelled")),
        None -> Err(sql_here(h.p, "the statement ends mid-clause")),
      }
    } else { Ok(h) },
  }
}

fn sql_source_list(
  p: SqlAt,
  tables: SqlTables,
) -> Result<{ p: SqlAt, tables: SqlTables }, DbError> =
  match sql_source_item(p, tables) {
    Err(e) -> Err(e),
    Ok(one) -> {
      let comma = sql_eat_punct(one.p, ",");
      if comma.ate { sql_source_list(comma.p, one.tables) } else { Ok(one) }
    },
  }

fn sql_source_item(
  p: SqlAt,
  tables: SqlTables,
) -> Result<{ p: SqlAt, tables: SqlTables }, DbError> =
  match sql_source_base(p, tables) { Err(e) -> Err(e), Ok(base) -> sql_joins(base.p, base.tables) }

fn sql_joins(p: SqlAt, tables: SqlTables) -> Result<{ p: SqlAt, tables: SqlTables }, DbError> = {
  let natural = sql_eat_word(p, "natural");
  let joined = sql_at_word(natural.p, "join") || sql_at_word(natural.p, "inner")
    || sql_at_word(natural.p, "left")
    || sql_at_word(natural.p, "right")
    || sql_at_word(natural.p, "full")
    || sql_at_word(natural.p, "cross");
  if !joined {
    if natural.ate { Err(sql_here(natural.p, "`natural` must be followed by a join")) }
    else { Ok({ p: p, tables: tables }) }
  } else {
    let inner = sql_eat_word(natural.p, "inner");
    let side = sql_eat_word(inner.p, "left");
    let side2 = sql_eat_word(side.p, "right");
    let side3 = sql_eat_word(side2.p, "full");
    let after_side = if side.ate || side2.ate || side3.ate { sql_eat_word(side3.p, "outer").p }
    else { side3.p };
    let cross = sql_eat_word(after_side, "cross");
    let join = sql_expect_word(cross.p, "join");
    match join {
      Err(e) -> Err(e),
      Ok(after_join) -> match sql_source_base(after_join, tables) {
        Err(e) -> Err(e),
        Ok(base) -> {
          let on = sql_eat_word(base.p, "on");
          let after_on = if on.ate { sql_skip_expr(on.p, base.tables, sql_clause_words(), true) } else {
            let using = sql_eat_word(base.p, "using");
            if using.ate {
              match sql_expect_punct(using.p, "(") {
                Err(e) -> Err(e),
                Ok(open) -> match sql_name_list(open) {
                  Err(e) -> Err(e),
                  Ok(after) -> Ok({ p: after, tables: base.tables }),
                },
              }
            } else { Ok({ p: base.p, tables: base.tables }) }
          };
          match after_on { Err(e) -> Err(e), Ok(tail) -> sql_joins(tail.p, tail.tables) }
        },
      },
    }
  }
}

fn sql_source_base(
  p: SqlAt,
  tables: SqlTables,
) -> Result<{ p: SqlAt, tables: SqlTables }, DbError> = {
  let lateral = sql_eat_word(p, "lateral");
  let open_at = match sql_head(lateral.p.toks) { Some(t) -> t.at, None -> lateral.p.end_pos };
  let open = sql_eat_punct(lateral.p, "(");
  if open.ate {
    if sql_at_word(open.p, "select") || sql_at_word(open.p, "values")
        || sql_at_word(open.p, "with") {
      match sql_statement(open.p) {
        Err(e) -> Err(e),
        Ok(inner) -> match sql_expect_punct(inner.p, ")") {
          Err(e) -> Err(e),
          Ok(after) -> {
            let aliased = sql_alias(after);
            match aliased {
              Err(e) -> Err(e),
              Ok(done) -> Ok({ p: done, tables: sql_absorb_tables(tables, inner.scan.tables) }),
            }
          },
        },
      }
    } else {
      Err(sql_refuse("`(`", open_at, "a parenthesised from-item is not a shape the reader models"))
    }
  } else {
    let only = sql_eat_word(lateral.p, "only");
    match sql_qualified_name(only.p, 0) {
      Err(e) -> Err(e),
      Ok(named) -> if sql_at_punct(named.p, "(") {
        match sql_head(named.p.toks) {
          Some(t) ->
            Err(
              sql_refuse_tok(
                t,
                "a set-returning function in `from` reads tables no reader can name",
              ),
            ),
          None -> Err(sql_here(named.p, "the statement ends mid-clause")),
        }
      } else {
        let starred = sql_eat_punct(named.p, "*");
        let noted = if sql_has_table(named.p.ctes, named.name) { tables }
        else { sql_note_read(tables, named.name) };
        match sql_alias(starred.p) {
          Err(e) -> Err(e),
          Ok(after) -> Ok({ p: after, tables: noted }),
        }
      },
    }
  }
}

fn sql_target_list(
  p: SqlAt,
  tables: SqlTables,
) -> Result<{ p: SqlAt, tables: SqlTables }, DbError> =
  match sql_skip_expr(p, tables, sql_clause_words(), true) {
    Err(e) -> Err(e),
    Ok(item) -> {
      let as_ = sql_eat_word(item.p, "as");
      let named = if as_.ate {
        match sql_identifier(as_.p, "an output column name") { Err(e) -> Err(e), Ok(n) -> Ok(n.p) }
      } else { Ok(item.p) };
      match named {
        Err(e) -> Err(e),
        Ok(after) -> {
          let comma = sql_eat_punct(after, ",");
          if comma.ate { sql_target_list(comma.p, item.tables) }
          else { Ok({ p: after, tables: item.tables }) }
        },
      }
    },
  }

// --- The four verbs -----------------------------------------------------------------

fn sql_insert(p: SqlAt) -> Result<{ p: SqlAt, scan: SqlScan }, DbError> = {
  let after_insert = sql_expect_word(p, "insert")?;
  let into = sql_expect_word(after_insert, "into")?;
  let named = sql_qualified_name(into, 0)?;
  let written = sql_note_written(no_sql_tables(), named.name);
  let aliased = sql_alias(named.p)?;
  let columns = sql_eat_punct(aliased, "(");
  match sql_after_columns(columns) {
    Err(e) -> Err(e),
    Ok(after_columns) -> {
      let default = sql_eat_word(after_columns, "default");
      match sql_insert_source(default, after_columns) {
        Err(e) -> Err(e),
        Ok(source) -> {
          let rows = sql_absorb_tables(written, source.tables);
          if sql_at_word(source.p, "on") {
            match sql_head(source.p.toks) {
              Some(t) ->
                Err(
                  sql_refuse_tok(
                    t,
                    "`on conflict` is not modelled: an upsert is a write whose outcome the engine cannot reproduce",
                  ),
                ),
              None -> Err(sql_here(source.p, "the statement ends mid-clause")),
            }
          } else {
            match sql_returning(source.p, rows) {
              Err(e) -> Err(e),
              Ok(done) -> Ok({ p: done.p, scan: { kind: KInsert, tables: done.tables } }),
            }
          }
        },
      }
    },
  }
}

// `default values`, or a `select` that answers the rows.
fn sql_insert_source(
  default: { p: SqlAt, ate: Bool },
  after_columns: SqlAt,
) -> Result<{ p: SqlAt, tables: SqlTables }, DbError> =
  if default.ate {
    match sql_expect_word(default.p, "values") {
      Err(e) -> Err(e),
      Ok(after) -> Ok({ p: after, tables: no_sql_tables() }),
    }
  } else { sql_select_stmt(after_columns) }

fn sql_update(p: SqlAt) -> Result<{ p: SqlAt, scan: SqlScan }, DbError> = {
  let after_update = sql_expect_word(p, "update")?;
  let only = sql_eat_word(after_update, "only");
  let named = sql_qualified_name(only.p, 0)?;
  let written = sql_note_written(no_sql_tables(), named.name);
  let aliased = sql_alias(named.p)?;
  let after_set = sql_expect_word(aliased, "set")?;
  let assignments = sql_skip_expr(after_set, written, ["from", "where", "returning"], false)?;
  let from = sql_eat_word(assignments.p, "from");
  let after_from = if from.ate { sql_source_list(from.p, assignments.tables) }
  else { Ok(assignments) };
  let sourced = match after_from { Err(e) -> Err(e), Ok(s) -> Ok(s) };
  let filtered = match sourced {
    Err(e) -> Err(e),
    Ok(s) -> {
      let where_ = sql_eat_word(s.p, "where");
      if where_.ate { sql_skip_expr(where_.p, s.tables, ["returning"], false) } else { Ok(s) }
    },
  };
  match filtered {
    Err(e) -> Err(e),
    Ok(f) -> match sql_returning(f.p, f.tables) {
      Err(e) -> Err(e),
      Ok(done) -> Ok({ p: done.p, scan: { kind: KUpdate, tables: done.tables } }),
    },
  }
}

fn sql_delete(p: SqlAt) -> Result<{ p: SqlAt, scan: SqlScan }, DbError> = {
  let after_delete = sql_expect_word(p, "delete")?;
  let from = sql_expect_word(after_delete, "from")?;
  let only = sql_eat_word(from, "only");
  let named = sql_qualified_name(only.p, 0)?;
  let written = sql_note_written(no_sql_tables(), named.name);
  let aliased = sql_alias(named.p)?;
  let using = sql_eat_word(aliased, "using");
  let sourced = if using.ate { sql_source_list(using.p, written) }
  else { Ok({ p: aliased, tables: written }) };
  let filtered = match sourced {
    Err(e) -> Err(e),
    Ok(s) -> {
      let where_ = sql_eat_word(s.p, "where");
      if where_.ate { sql_skip_expr(where_.p, s.tables, ["returning"], false) } else { Ok(s) }
    },
  };
  match filtered {
    Err(e) -> Err(e),
    Ok(f) -> match sql_returning(f.p, f.tables) {
      Err(e) -> Err(e),
      Ok(done) -> Ok({ p: done.p, scan: { kind: KDelete, tables: done.tables } }),
    },
  }
}

fn sql_returning(p: SqlAt, tables: SqlTables) -> Result<{ p: SqlAt, tables: SqlTables }, DbError> = {
  let returning = sql_eat_word(p, "returning");
  if returning.ate { sql_skip_expr(returning.p, tables, [], false) }
  else { Ok({ p: p, tables: tables }) }
}

// `values (…), (…)`: the rows are expressions, but a subquery inside one is still a statement.
fn sql_values_rows(
  p: SqlAt,
  tables: SqlTables,
) -> Result<{ p: SqlAt, tables: SqlTables }, DbError> = {
  let open = sql_expect_punct(p, "(");
  match open {
    Err(e) -> Err(e),
    Ok(after) -> match sql_row_body(after, tables, 1) {
      Err(e) -> Err(e),
      Ok(row) -> {
        let comma = sql_eat_punct(row.p, ",");
        if comma.ate { sql_values_rows(comma.p, row.tables) } else { Ok(row) }
      },
    },
  }
}

fn sql_row_body(
  p: SqlAt,
  tables: SqlTables,
  depth: Int,
) -> Result<{ p: SqlAt, tables: SqlTables }, DbError> =
  match sql_head(p.toks) {
    None -> Err(sql_here(p, "this row is never closed")),
    Some(t) -> if sql_is_punct(t.tok, "(") { sql_row_body(sql_step(p), tables, depth + 1) } else if sql_is_punct(
        t.tok,
        ")",
      ) {
      if depth == 1 { Ok({ p: sql_step(p), tables: tables }) }
      else { sql_row_body(sql_step(p), tables, depth - 1) }
    } else if sql_is_semi(t.tok) { Err(sql_stacked(t.at)) } else {
      match sql_check_call(p) {
        Err(e) -> Err(e),
        Ok(_) -> sql_row_body(sql_step(p), tables, depth),
      }
    },
  }

// --- Expressions ----------------------------------------------------------------------

// Walk an expression, following subqueries, up to the next stop word at depth zero. This is where
// a subquery's tables are absorbed: a `select` inside a `where` reaches tables of its own.
fn sql_skip_expr(
  p: SqlAt,
  tables: SqlTables,
  stops: List<String>,
  stop_at_comma: Bool,
) -> Result<{ p: SqlAt, tables: SqlTables }, DbError> =
  match sql_head(p.toks) {
    None -> Ok({ p: p, tables: tables }),
    Some(t) -> if sql_is_semi(t.tok) { Err(sql_stacked(t.at)) }
    else if sql_is_punct(t.tok, "(") { sql_skip_paren(p, tables, stops, stop_at_comma) }
    else if sql_is_punct(t.tok, ")") { Ok({ p: p, tables: tables }) }
    else if stop_at_comma && sql_is_punct(t.tok, ",") { Ok({ p: p, tables: tables }) }
    else { sql_skip_word(p, t, tables, stops, stop_at_comma) },
  }

fn sql_skip_word(
  p: SqlAt,
  t: SqlTokAt,
  tables: SqlTables,
  stops: List<String>,
  stop_at_comma: Bool,
) -> Result<{ p: SqlAt, tables: SqlTables }, DbError> =
  match t.tok {
    SqlWord(w) -> if !w.quoted && sql_has_table(stops, w.text) { Ok({ p: p, tables: tables }) } else {
      match sql_check_call(p) {
        Err(e) -> Err(e),
        Ok(_) -> sql_skip_expr(sql_step(p), tables, stops, stop_at_comma),
      }
    },
    _ -> match sql_check_call(p) {
      Err(e) -> Err(e),
      Ok(_) -> sql_skip_expr(sql_step(p), tables, stops, stop_at_comma),
    },
  }

// A `(` inside an expression opens either a subquery, whose tables count, or a group, whose
// contents are walked but whose depth the stops do not see into.
fn sql_skip_paren(
  p: SqlAt,
  tables: SqlTables,
  stops: List<String>,
  stop_at_comma: Bool,
) -> Result<{ p: SqlAt, tables: SqlTables }, DbError> = {
  let opened = sql_step(p);
  if sql_at_word(opened, "select") || sql_at_word(opened, "values") || sql_at_word(opened, "with") {
    match sql_statement(opened) {
      Err(e) -> Err(e),
      Ok(inner) -> match sql_expect_punct(inner.p, ")") {
        Err(e) -> Err(e),
        Ok(after) ->
          sql_skip_expr(after, sql_absorb_tables(tables, inner.scan.tables), stops, stop_at_comma),
      },
    }
  } else {
    match sql_skip_group(opened, tables, 1) {
      Err(e) -> Err(e),
      Ok(closed) -> sql_skip_expr(closed.p, closed.tables, stops, stop_at_comma),
    }
  }
}

// The body of a group, from just after its `(`, to just past the `)` that closes it.
fn sql_skip_group(
  p: SqlAt,
  tables: SqlTables,
  depth: Int,
) -> Result<{ p: SqlAt, tables: SqlTables }, DbError> =
  match sql_head(p.toks) {
    None -> Err(sql_here(p, "this group is never closed")),
    Some(t) -> if sql_is_semi(t.tok) { Err(sql_stacked(t.at)) } else if sql_is_punct(t.tok, "(") {
      match sql_check_call(p) {
        Err(e) -> Err(e),
        Ok(_) -> sql_skip_group(sql_step(p), tables, depth + 1),
      }
    } else if sql_is_punct(t.tok, ")") {
      if depth == 1 { Ok({ p: sql_step(p), tables: tables }) } else {
        match sql_check_call(p) {
          Err(e) -> Err(e),
          Ok(_) -> sql_skip_group(sql_step(p), tables, depth - 1),
        }
      }
    } else if sql_at_word(p, "select") || sql_at_word(p, "values") || sql_at_word(p, "with") {
      match sql_statement(p) {
        Err(e) -> Err(e),
        Ok(inner) -> sql_skip_group(inner.p, sql_absorb_tables(tables, inner.scan.tables), depth),
      }
    } else {
      match sql_check_call(p) {
        Err(e) -> Err(e),
        Ok(_) -> sql_skip_group(sql_step(p), tables, depth),
      }
    },
  }

// The body of a parenthesised group whose opening paren is already eaten.
fn sql_skip_parens(
  p: SqlAt,
  tables: SqlTables,
) -> Result<{ p: SqlAt, tables: SqlTables }, DbError> =
  match sql_skip_group(p, tables, 1) {
    Err(e) -> Err(e),
    Ok(closed) -> Ok({ p: closed.p, tables: closed.tables }),
  }

// --- The entry point ------------------------------------------------------------------

// What `sql` does and which tables it reaches, or why it is refused. Nothing below the driver's
// own read of the verb depends on a guess: an unmodelled construct is a table set that would be
// wrong, and a wrong table set is a scheduler that runs two writers beside each other.
pub fn scan_statement(sql: String) -> Result<SqlScan, DbError> =
  match tokenize(sql) {
    Err(e) -> Err(e),
    Ok(toks) -> match sql_statement({
        toks: toks,
        ctes: [],
        depth: 0,
        end_pos: bytes_len(bytes_of_string(sql)),
      }) {
      Err(e) -> Err(e),
      Ok(s) -> match sql_nothing_left(s.p) { Err(e) -> Err(e), Ok(_) -> Ok(s.scan) },
    },
  }

// A statement ends where the first one does: a `;` after it is a second statement, and any other
// token is a construct the reader did not account for.
fn sql_nothing_left(p: SqlAt) -> Result<(), DbError> =
  match sql_head(p.toks) {
    None -> Ok(()),
    Some(t) -> if sql_is_semi(t.tok) { Err(sql_stacked(t.at)) }
    else { Err(sql_refuse_tok(t, "the statement ends here")) },
  }

type Ran = { session: pg::Session, answer: Answer }

// The statement's own check, before it takes a connection. A statement's tables are a function of
// its text rather than of the call site's label, so a join reaches tables the label never named —
// and the atom the scheduler records is the label's, so the label has to be one of them.
fn check_statement(s: Stmt, reads_only: Bool, label: String) -> Unit = {
  let scanned = match scan_statement(s.sql) { Err(e) -> panic(e.detail), Ok(scanned) -> scanned };
  if !sql_has_table(scan_table_names(scanned.tables), label) {
    panic(
      "this call site names `" ++ label ++ "`, and the statement touches "
        ++ describe_tables(scanned.tables)
        ++ ": label the call site with a table the statement names, or split the statement",
    )
  };
  if scan_writes(scanned) && reads_only {
    panic(
      "this statement writes, and `db.query` is a read: perform it as `db.execute` or `db.returning`, or two endpoints that both write would be run beside each other",
    )
  }
}

// What a statement touches, for a refusal that says why a label does not fit.
fn describe_tables(t: SqlTables) -> String =
  if len(t.written) > 0 && len(t.read) > 0 {
    "`" ++ string::join(t.written, "`, `") ++ "` (written) and `" ++ string::join(t.read, "`, `")
      ++ "` (read)"
  } else if len(t.written) > 0 { "`" ++ string::join(t.written, "`, `") ++ "` (written)" }
  else if len(t.read) > 0 { "`" ++ string::join(t.read, "`, `") ++ "` (read)" }
  else { "no table" }

fn run_checked(
  session: pg::Session,
  s: Stmt,
  ps: List<Param>,
  rows: Bool,
  cfg: Server,
) -> Result<Ran, pg::ClientError> / {net.send[link], net.recv[link]} =
  match pg::extended_query[link](session, s.sql, map(ps, |p: Param| param_text(p)), cfg.client) {
    Err(e) -> Err(e),
    Ok(reply) ->
      Ok({
        session: reply.session,
        answer: if rows { Rows(rows_of(reply.answer.columns, reply.answer.rows)) }
        else { Count(count_of(reply.answer.tag)) },
      }),
  }

// A statement the driver itself sends.
fn control(
  session: pg::Session,
  sql: String,
  cfg: Server,
) -> Result<pg::Reply, pg::ClientError> / {net.send[link], net.recv[link]} =
  pg::simple_query[link](session, sql, cfg.client)

fn linked(
  cfg: Server,
  nonce: String,
  c: Claim,
) -> Result<Link, DbError> / {net.connect[link], net.send[link], net.recv[link], net.close[link]} =
  match c {
    Idle(l) -> Ok(l),
    Fresh(n) -> match pg::connect[link](
        cfg.host,
        cfg.port,
        cfg.user,
        cfg.database,
        startup_parameters(cfg),
        cfg.password,
        nonce ++ "-" ++ int_to_string(n),
        cfg.client,
      ) {
      Err(e) -> Err(client_error(e)),
      Ok(session) -> Ok({ n: n, session: session }),
    },
  }

// An exchange outside any transaction that failed: a refusal leaves the server talking on the
// connection, and anything else ends it.
fn let_go(l: Link, e: pg::ClientError, cfg: Server) -> Left / {net.send[link], net.close[link]} =
  match e {
    pg::Rejected(session, server) ->
      {
        answer: Failed(server_error(server)),
        n: l.n,
        scope: None,
        freed: Some(Reuse({ ..l, session: session })),
      },
    _ -> {
      pg::finish[link](l.session, cfg.client);
      { answer: Failed(client_error(e)), n: l.n, scope: None, freed: Some(Lost) }
    },
  }

// A transaction's scope after an exchange on its connection, `deeper` scopes more or fewer.
fn kept(scope: Scope, session: pg::Session, deeper: Int) -> Scope =
  { ..scope, session: Some(session), depth: scope.depth + deeper, busy: false }

// An exchange inside a transaction that failed: a refusal leaves the transaction where it stood,
// and anything else loses its connection and the transaction with it.
fn failed_within(
  scope: Scope,
  session: pg::Session,
  e: pg::ClientError,
  cfg: Server,
  deeper: Int,
) -> Left / {net.send[link], net.close[link]} =
  match e {
    pg::Rejected(after, server) ->
      {
        answer: Failed(server_error(server)),
        n: scope.n,
        scope: Some(kept(scope, after, deeper)),
        freed: None,
      },
    _ -> {
      pg::finish[link](session, cfg.client);
      {
        answer: Failed(client_error(e)),
        n: scope.n,
        scope: Some({ ..scope, session: None, depth: scope.depth + deeper, busy: false }),
        freed: Some(Lost),
      }
    },
  }

fn statement_outside(
  cfg: Server,
  nonce: String,
  c: Claim,
  s: Stmt,
  ps: List<Param>,
  rows: Bool,
) -> Left / {net.connect[link], net.send[link], net.recv[link], net.close[link]} =
  match linked(cfg, nonce, c) {
    Err(e) -> { answer: Failed(e), n: claim_n(c), scope: None, freed: Some(Lost) },
    Ok(l) -> match run_checked(l.session, s, ps, rows, cfg) {
      Ok(ran) ->
        {
          answer: ran.answer,
          n: l.n,
          scope: None,
          freed: Some(Reuse({ ..l, session: ran.session })),
        },
      Err(e) -> let_go(l, e, cfg),
    },
  }

fn statement_within(
  cfg: Server,
  scope: Scope,
  session: pg::Session,
  s: Stmt,
  ps: List<Param>,
  rows: Bool,
) -> Left / {net.send[link], net.recv[link], net.close[link]} =
  match run_checked(session, s, ps, rows, cfg) {
    Ok(ran) ->
      { answer: ran.answer, n: scope.n, scope: Some(kept(scope, ran.session, 0)), freed: None },
    Err(e) -> failed_within(scope, session, e, cfg, 0),
  }

fn opening(
  cfg: Server,
  nonce: String,
  c: Claim,
  level: Isolation,
  access: Access,
) -> Left / {net.connect[link], net.send[link], net.recv[link], net.close[link]} =
  match linked(cfg, nonce, c) {
    Err(e) -> { answer: Failed(e), n: claim_n(c), scope: None, freed: Some(Lost) },
    Ok(l) -> match control(
        l.session,
        "begin isolation level " ++ isolation_sql(level) ++ " " ++ access_sql(access),
        cfg,
      ) {
      Ok(reply) ->
        {
          answer: Count(0),
          n: l.n,
          scope: Some({
            n: l.n,
            session: Some(reply.session),
            depth: 1,
            level: level,
            access: access,
            busy: false,
          }),
          freed: None,
        },
      Err(e) -> let_go(l, e, cfg),
    },
  }

fn nesting(
  cfg: Server,
  scope: Scope,
  session: pg::Session,
) -> Left / {net.send[link], net.recv[link], net.close[link]} =
  match control(session, "savepoint " ++ savepoint_name(scope.depth + 1), cfg) {
    Ok(reply) ->
      { answer: Count(0), n: scope.n, scope: Some(kept(scope, reply.session, 1)), freed: None },
    Err(e) -> failed_within(scope, session, e, cfg, 0),
  }

// A transaction that has ended, its connection back in the pool.
fn ended(scope: Scope, session: pg::Session, answer: Answer) -> Left =
  { answer: answer, n: scope.n, scope: None, freed: Some(Reuse({ n: scope.n, session: session })) }

// A `commit` closes its scope whatever the server answers: a savepoint's leaves the scope around
// it, and a transaction's gives its connection back.
fn committing(
  cfg: Server,
  scope: Scope,
  session: pg::Session,
) -> Left / {net.send[link], net.recv[link], net.close[link]} =
  if scope.depth > 1 {
    match control(session, "release savepoint " ++ savepoint_name(scope.depth), cfg) {
      Ok(reply) ->
        { answer: Count(0), n: scope.n, scope: Some(kept(scope, reply.session, -1)), freed: None },
      Err(e) -> failed_within(scope, session, e, cfg, -1),
    }
  } else {
    match control(session, "commit", cfg) {
      Ok(reply) -> ended(scope, reply.session, committed(reply.answer.tag)),
      Err(pg::Rejected(after, server)) -> ended(scope, after, Failed(server_error(server))),
      Err(e) -> {
        pg::finish[link](session, cfg.client);
        { answer: Failed(unresolved(e)), n: scope.n, scope: None, freed: Some(Lost) }
      },
    }
  }

// The server ends an aborted transaction's `COMMIT` with a rollback, and no error.
fn committed(tag: String) -> Answer =
  if tag == "ROLLBACK" { Failed(in_failed_txn()) } else { Count(0) }

fn aborting(
  cfg: Server,
  scope: Scope,
  session: pg::Session,
) -> Left / {net.send[link], net.recv[link], net.close[link]} =
  if scope.depth > 1 {
    // A savepoint outlives a rollback to it, so it is released too.
    let name = savepoint_name(scope.depth);
    match control(
        session,
        "rollback to savepoint " ++ name ++ "; release savepoint " ++ name,
        cfg,
      ) {
      Ok(reply) ->
        { answer: Count(0), n: scope.n, scope: Some(kept(scope, reply.session, -1)), freed: None },
      Err(e) -> failed_within(scope, session, e, cfg, -1),
    }
  } else {
    match control(session, "rollback", cfg) {
      Ok(reply) -> ended(scope, reply.session, Count(0)),
      Err(e) -> let_go({ n: scope.n, session: session }, e, cfg),
    }
  }

// The `db` effect served from a live server. `nonce` is the caller's, so a run's seed decides it
// and a test can fix it; each connection's nonce is that text and its own number.
pub fn serve<a | e>(
  cfg: Server,
  size: Int,
  nonce: String,
  body: () -> a / {db.read[*], db.write[*] | e},
) -> a / {net.connect[link], net.send[link], net.recv[link], net.close[link] | e} =
  with_cell[dbpool]({ idle: [], opened: 0, made: 0, open: [] }) { pool -> {
    let taken = |d: Decided| {
      cell_set(pool, d.pool);
      d.plan
    };
    let settled = |left: Left| {
      cell_set(pool, settle(cell_get(pool), left));
      left.answer
    };
    let statement = |s: Stmt, ps: List<Param>, rows: Bool, what: String|
      match taken(for_statement(cell_get(pool), size, what)) {
        Answered(a) -> a,
        Outside(c) -> settled(statement_outside(cfg, nonce, c, s, ps, rows)),
        Within(scope, session) -> settled(statement_within(cfg, scope, session, s, ps, rows)),
      };
    let closing = |d: ToClose| {
      cell_set(pool, d.pool);
      d.closing
    };
    let answer = handle {
      body()
    } with {
      db.query[*t](s, ps) -> {
        check_statement(s, true, t);
        statement(s, ps, true, "`db.query`")
      },
      db.execute[*t](s, ps) -> {
        check_statement(s, false, t);
        statement(s, ps, false, "`db.execute`")
      },
      db.returning[*t](s, ps) -> {
        check_statement(s, false, t);
        statement(s, ps, true, "`db.returning`")
      },
      db.begin(level, access) -> match taken(for_begin(cell_get(pool), size, level, access)) {
        Answered(a) -> a,
        Outside(c) -> settled(opening(cfg, nonce, c, level, access)),
        Within(scope, session) -> settled(nesting(cfg, scope, session)),
      },
      db.commit() -> match closing(
          for_close(cell_get(pool), "`db.commit`", Failed(connection_lost())),
        ) {
        Settled(a) -> a,
        Closes(scope, session) -> settled(committing(cfg, scope, session)),
      },
      db.abort() -> match closing(for_close(cell_get(pool), "`db.abort`", Count(0))) {
        Settled(a) -> a,
        Closes(scope, session) -> settled(aborting(cfg, scope, session)),
      },
    };
    finished(cell_get(pool), cfg);
    answer
  } }

// Every connection the pool still holds once its body has returned, told it is done and closed:
// the idle ones, and one a body returned from inside its transaction, which the server rolls back.
fn finished(p: Pool, cfg: Server) -> Unit / {net.send[link], net.close[link]} = {
  fold(p.idle, (), |done: Unit, l: Link| pg::finish[link](l.session, cfg.client));
  fold(p.open, (), |done: Unit, scope: Scope|
    match scope.session { Some(session) -> pg::finish[link](session, cfg.client), None -> () })
}

// --- Where the server is ---------------------------------------------------------

// `postgres://user[:password]@host[:port]/database[?key=value&…]`, the form `with_server` takes.
// The language reads it, so a driver needs nothing from the host but `net`.

type Split = { head: String, tail: String }

// Around the first `sep`; the URL grammar needs no regular expressions.
fn split_at(text: String, sep: String) -> Option<Split> =
  match bytes_index_of(bytes_of_string(text), bytes_of_string(sep)) {
    None -> None,
    Some(i) -> {
      let whole = bytes_of_string(text);
      let after = i + bytes_len(bytes_of_string(sep));
      Some({
        head: string_of_bytes(bytes_slice(whole, 0, i)),
        tail: string_of_bytes(bytes_slice(whole, after, bytes_len(whole))),
      })
    },
  }

// Around the last `sep`, which is what separates the userinfo from the host: a password may
// hold an `@`.
fn rsplit_at(text: String, sep: String) -> Option<Split> = {
  let whole = bytes_of_string(text);
  let needle = bytes_of_string(sep);
  let last = fold(range(0, bytes_len(whole)), 0 - 1, |acc: Int, i: Int|
    if i + bytes_len(needle) <= bytes_len(whole)
        && bytes_slice(whole, i, i + bytes_len(needle)) == needle { i }
    else { acc });
  if last < 0 { None } else {
    Some({
      head: string_of_bytes(bytes_slice(whole, 0, last)),
      tail: string_of_bytes(bytes_slice(whole, last + bytes_len(needle), bytes_len(whole))),
    })
  }
}

// `%XX` as the byte it names; anything else is itself, so a password may hold a `:` or an `@`.
fn unpercent(text: String) -> Result<String, String> =
  match unpercent_from(bytes_of_string(text), 0, b"") {
    Err(why) -> Err(why),
    Ok(bytes) -> if bytes_is_utf8(bytes) { Ok(string_of_bytes(bytes)) }
    else { Err("a `%` escape in the URL is not UTF-8") },
  }

fn unpercent_from(whole: Bytes, at: Int, acc: Bytes) -> Result<Bytes, String> =
  if at >= bytes_len(whole) { Ok(acc) } else if bytes_at(whole, at) == 37 {
    if at + 2 >= bytes_len(whole) || !is_hex(bytes_at(whole, at + 1))
        || !is_hex(bytes_at(whole, at + 2)) {
      Err("a `%` in the URL is not followed by two hex digits")
    } else {
      unpercent_from(
        whole,
        at + 3,
        bytes_concat(
          acc,
          byte_of_int(hex_value(bytes_at(whole, at + 1)) * 16 + hex_value(bytes_at(whole, at + 2))),
        ),
      )
    }
  } else { unpercent_from(whole, at + 1, bytes_concat(acc, bytes_slice(whole, at, at + 1))) }

fn is_hex(c: Int) -> Bool = (c >= 48 && c <= 57) || (c >= 97 && c <= 102) || (c >= 65 && c <= 70)

fn url_refusal(url: String) -> String =
  if string_contains(url, "=") && !string_contains(url, "://") {
    "this is libpq's keyword/value form; the URI form is `postgres://user@host:5432/database`"
  } else { "a connection string begins `postgres://`, as in `postgres://user@host:5432/database`" }

pub fn server_of(url: String) -> Result<Server, String> =
  match split_at(url, "://") {
    None -> Err(url_refusal(url)),
    Some(scheme) -> if scheme.head != "postgres" && scheme.head != "postgresql" {
      Err(
        "`" ++ scheme.head
          ++ "` is not a database this driver speaks; only `postgres://` and `postgresql://` are",
      )
    } else { server_parts(scheme.tail) },
  }

type Credentials = { user: String, password: Option<String> }

fn credentials_of(userinfo: String) -> Result<Credentials, String> =
  match split_at(userinfo, ":") {
    None -> match unpercent(userinfo) {
      Err(why) -> Err(why),
      Ok(user) -> checked_user(user, None),
    },
    Some(s) -> match unpercent(s.tail) {
      Err(why) -> Err(why),
      Ok(password) -> match unpercent(s.head) {
        Err(why) -> Err(why),
        Ok(user) -> checked_user(user, Some(password)),
      },
    },
  }

fn checked_user(user: String, password: Option<String>) -> Result<Credentials, String> =
  if string_len(user) == 0 { Err("the user is empty") }
  else { Ok({ user: user, password: password }) }

type HostPort = { host: String, port: Int }

fn hostport_of(text: String) -> Result<HostPort, String> =
  match rsplit_at(text, ":") {
    None -> checked_host(text, 5432),
    Some(s) -> match natural_of(s.tail) {
      None -> Err("`" ++ s.tail ++ "` is not a port"),
      Some(port) -> if port == 0 { Err("port 0 is not a port a server listens on") }
      else { checked_host(s.head, port) },
    },
  }

// A decimal number, and nothing that merely begins with one.
fn natural_of(text: String) -> Option<Int> =
  if string_len(text) == 0 { None } else {
    let value = nat_of_text(text);
    if string_len(int_to_string(value)) == string_len(text) { Some(value) } else { None }
  }

fn checked_host(host: String, port: Int) -> Result<HostPort, String> =
  if string_len(host) == 0 { Err("there is no host; a unix socket path is not configurable here") }
  else { Ok({ host: host, port: port }) }

type Database = { name: String, query: String }

fn database_of(path_and_query: String) -> Result<Database, String> = {
  let split = match split_at(path_and_query, "?") {
    Some(s) -> s,
    None -> { head: path_and_query, tail: "" },
  };
  match unpercent(split.head) {
    Err(why) -> Err(why),
    Ok(name) -> if string_len(name) == 0 { Err("there is no database name after the host") }
    else { Ok({ name: name, query: split.tail }) },
  }
}

fn server_parts(rest: String) -> Result<Server, String> = {
  let split = match split_at(rest, "/") { Some(s) -> s, None -> { head: rest, tail: "" } };
  match rsplit_at(split.head, "@") {
    None ->
      Err(
        "there is no `user@` before the host; a run whose database user comes from the environment is a run whose identity depends on who invoked it",
      ),
    Some(who) -> match credentials_of(who.head) {
      Err(why) -> Err(why),
      Ok(c) -> match hostport_of(who.tail) {
        Err(why) -> Err(why),
        Ok(hp) -> match database_of(split.tail) {
          Err(why) -> Err(why),
          Ok(database) ->
            with_query(database.query, server(hp.host, hp.port, c.user, database.name, c.password)),
        },
      },
    },
  }
}

// `sslmode` is read and nothing more: TLS to postgres is not wired up. Every other parameter is a
// setting the server is told at start-up, under the name postgres gives it.
fn with_query(query: String, s: Server) -> Result<Server, String> =
  if string_len(query) == 0 { Ok(s) } else {
    fold(string_split(query, "&"), Ok(s), |acc: Result<Server, String>, pair: String|
      match acc {
        Err(why) -> Err(why),
        Ok(so_far) -> match split_at(pair, "=") {
          None -> Err("`" ++ pair ++ "` is not a `key=value` parameter"),
          Some(kv) -> match unpercent(kv.tail) {
            Err(why) -> Err(why),
            Ok(value) -> with_setting(so_far, kv.head, value),
          },
        },
      })
  }

fn with_setting(s: Server, key: String, value: String) -> Result<Server, String> =
  if key == "sslmode" {
    if value == "disable" || value == "prefer" { Ok(s) } else {
      Err(
        "`sslmode=" ++ value
          ++ "` is not configurable: TLS to postgres is not wired up, so only `disable` and `prefer` are read",
      )
    }
  } else if key == "application_name" {
    // A zero byte ends a start-up parameter, so the rest of the name would be read as another.
    if string_contains(value, "\0") { Err("an `application_name` may not hold a zero byte") }
    else { once(s.application_name, key, { ..s, application_name: Some(value) }) }
  } else if key == "statement_timeout" {
    match millis_of(key, value) {
      Err(why) -> Err(why),
      Ok(ms) -> once(s.statement_timeout_ms, key, { ..s, statement_timeout_ms: Some(ms) }),
    }
  } else if key == "idle_in_transaction_session_timeout" {
    match millis_of(key, value) {
      Err(why) -> Err(why),
      Ok(ms) ->
        once(s.idle_in_transaction_timeout_ms, key, {
          ..s,
          idle_in_transaction_timeout_ms: Some(ms),
        }),
    }
  } else { Err("`" ++ key ++ "` is not a parameter this driver reads") }

fn once<a>(given: Option<a>, key: String, set: Server) -> Result<Server, String> =
  match given { Some(_) -> Err("`" ++ key ++ "` is given twice"), None -> Ok(set) }

// Postgres reads a timeout written without a unit as milliseconds, and `0` as none at all.
fn millis_of(key: String, text: String) -> Result<Int, String> =
  match natural_of(text) {
    None -> Err("`" ++ key ++ "=" ++ text ++ "`: a timeout is a whole number of milliseconds"),
    Some(ms) -> if ms > most_millis() {
      Err(
        "`" ++ key ++ "=" ++ text ++ "` is past the most postgres takes, "
          ++ int_to_string(most_millis())
          ++ " milliseconds",
      )
    } else { Ok(ms) },
  }

fn most_millis() -> Int = 2147483647

// The `db` effect served from a connection string: the driver, wrapped for a program that was
// told where the server is rather than handling the effect's clauses itself.
pub fn with_server<a | e>(
  url: String,
  size: Int,
  body: () -> a / {db.read[*], db.write[*] | e},
) -> Result<a, String> / {net.connect[link], net.send[link], net.recv[link], net.close[link], entropy.next | e} =
  match server_of(url) { Err(why) -> Err(why), Ok(cfg) -> Ok(serve(cfg, size, nonce(), body)) }

// --- Tests ------------------------------------------------------------------

test "a statement's words fold and a quoted identifier keeps its case" {
  assert_eq(
    sql_tokenize_summary("SELECT t.Sku FROM parts AS t"),
    Ok([
      "word:select",
      "word:t",
      "punct:.",
      "word:sku",
      "word:from",
      "word:parts",
      "word:as",
      "word:t",
    ]),
  );
  assert_eq(
    sql_tokenize_summary("select \"MiXeD\" from \"a\"\"b\""),
    Ok(["word:select", "quoted:MiXeD", "word:from", "quoted:a\"b"]),
  )
}

test "a comment is not a token, and a block comment nests" {
  assert_eq(
    sql_tokenize_summary("select 1 -- and the rest\nfrom t"),
    Ok(["word:select", "number:1", "word:from", "word:t"]),
  );
  assert_eq(sql_tokenize_summary("select /* a /* b */ c */ 1"), Ok(["word:select", "number:1"]))
}

test "a semicolon is its own token, and one inside a literal is text" {
  assert_eq(
    sql_tokenize_summary("select 1; drop table t"),
    Ok(["word:select", "number:1", "semi", "word:drop", "word:table", "word:t"]),
  );
  assert_eq(sql_tokenize_summary("select ';a'"), Ok(["word:select", "text:';a'"]));
  assert_eq(
    sql_tokenize_summary("select $tag$a;b$tag$"),
    Ok(["word:select", "text:$tag$a;b$tag$"]),
  );
  assert_eq(sql_tokenize_summary("select 'it''s'"), Ok(["word:select", "text:'it''s'"]))
}

test "a placeholder is not a dollar quote, and a string may be escaped" {
  assert_eq(
    sql_tokenize_summary("select $1, $23"),
    Ok(["word:select", "placeholder:$1", "punct:,", "placeholder:$23"]),
  );
  assert_eq(sql_tokenize_summary("select e'a b'"), Ok(["word:select", "text:e'a b'"]));
  assert_eq(
    sql_tokenize_summary("select b'0110', x'ff'"),
    Ok(["word:select", "text:b'0110'", "punct:,", "text:x'ff'"]),
  )
}

test "a number is one token however it is written" {
  assert_eq(
    sql_tokenize_summary("select 1, 1.5, 1e3, 0x1f, 12ab"),
    Ok([
      "word:select",
      "number:1",
      "punct:,",
      "number:1.5",
      "punct:,",
      "number:1e3",
      "punct:,",
      "number:0x1f",
      "punct:,",
      "number:12ab",
    ]),
  )
}

test "punctuation is one byte each, and a non-ascii name is one word" {
  assert_eq(
    sql_tokenize_summary("a.b::int[] @ 1 <> 2"),
    Ok([
      "word:a",
      "punct:.",
      "word:b",
      "punct::",
      "punct::",
      "word:int",
      "punct:[",
      "punct:]",
      "punct:@",
      "number:1",
      "punct:<",
      "punct:>",
      "number:2",
    ]),
  );
  assert_eq(sql_tokenize_summary("select ünïcode"), Ok(["word:select", "word:ünïcode"]))
}

test "a quote that is never closed is refused, not guessed at" {
  assert(refused(sql_tokenize_summary("select '")));
  assert(refused(sql_tokenize_summary("select \"x")));
  assert(refused(sql_tokenize_summary("select /* never")));
  assert(refused(sql_tokenize_summary("select $tag$ never")));
  assert(refused(sql_tokenize_summary("select $ ")))
}

fn refused<a>(r: Result<List<a>, DbError>) -> Bool = match r { Err(_) -> true, Ok(_) -> false }

// --- What the reader accepts and what it refuses ---------------------------------------
//
// These are the statements the Rust scanner's own tests name, moved here with it: the same
// statements, the same tables, and the same refusals. A reader that accepts one of these is a
// footprint that under-reports, which is the one failure that corrupts scheduling silently.

fn scan_ok(sql: String) -> SqlScan =
  match scan_statement(sql) { Err(e) -> panic(e.detail), Ok(s) -> s }

fn scan_names(sql: String) -> List<String> = scan_table_names(scan_ok(sql).tables)

fn scan_refused(sql: String) -> Bool = match scan_statement(sql) { Err(_) -> true, Ok(_) -> false }

fn scan_refused_at(sql: String, byte: Int) -> Bool =
  match scan_statement(sql) {
    Err(e) -> string_contains(e.detail, "byte " ++ int_to_string(byte)),
    Ok(_) -> false,
  }

test "a select names the table it reads" {
  assert_eq(scan_names("select sku from items"), ["items"]);
  assert_eq(scan_ok("select sku from items").kind, KSelect);
  assert_eq(scan_ok("select sku from items").tables.written, [])
}

test "a join names both tables" {
  assert_eq(scan_names("select o.id, i.sku from orders o join items i on i.sku = o.sku"), [
    "items",
    "orders",
  ]);
  assert_eq(scan_names("select * from orders, items where orders.sku = items.sku"), [
    "items",
    "orders",
  ]);
  assert_eq(
    scan_names("select * from a left outer join b on a.x = b.x full join c on c.y = a.y"),
    ["a", "b", "c"],
  );
  assert_eq(scan_names("select * from a natural join b"), ["a", "b"]);
  assert_eq(scan_names("select * from a join b using (x)"), ["a", "b"])
}

test "a set operation names every arm" {
  assert_eq(scan_names("select sku from items union all select sku from orders"), [
    "items",
    "orders",
  ]);
  assert_eq(scan_names("select a from x intersect select a from y except select a from z"), [
    "x",
    "y",
    "z",
  ]);
  assert_eq(scan_names("(select a from x) union (select a from y)"), ["x", "y"])
}

test "a subquery is followed rather than ignored" {
  assert_eq(scan_names("select sku from items where sku in (select sku from orders)"), [
    "items",
    "orders",
  ]);
  assert_eq(scan_names("select (select count(*) from orders) from items"), ["items", "orders"]);
  assert_eq(scan_names("select * from (select sku from orders) o"), ["orders"]);
  assert_eq(
    scan_names(
      "select * from items where exists (select 1 from orders where orders.sku = items.sku)",
    ),
    ["items", "orders"],
  )
}

test "a common table expression resolves to its own sources" {
  assert_eq(scan_names("with recent as (select * from orders) select * from recent"), ["orders"]);
  assert_eq(
    scan_names(
      "with a as (select * from x), b as (select * from a join y on true) select * from b",
    ),
    ["x", "y"],
  );
  assert_eq(
    scan_names("with recursive t(n) as (select 1 union all select n+1 from t) select n from t"),
    [],
  )
}

test "a data-modifying common table expression reports its write" {
  let s = scan_ok("with gone as (delete from stale returning id) select id from gone");
  assert_eq(s.kind, KSelect);
  assert_eq(s.tables.written, ["stale"]);
  assert(scan_writes(s))
}

test "an insert writes its target and reads its source" {
  let one = scan_ok("insert into items (sku, name) values ($1, $2)");
  assert_eq(one.kind, KInsert);
  assert_eq(one.tables.written, ["items"]);
  assert_eq(one.tables.read, []);
  let two = scan_ok("insert into archive select * from items where on_hand = 0");
  assert_eq(two.tables.written, ["archive"]);
  assert_eq(two.tables.read, ["items"]);
  assert_eq(scan_names("insert into items default values"), ["items"]);
  assert_eq(scan_names("insert into items (sku) values ($1) returning sku"), ["items"])
}

test "an update writes its target and reads its from list" {
  let s = scan_ok(
    "update items set on_hand = on_hand - l.qty from lines l where l.sku = items.sku",
  );
  assert_eq(s.kind, KUpdate);
  assert_eq(s.tables.written, ["items"]);
  assert_eq(s.tables.read, ["lines"])
}

test "a delete writes its target and reads its using list" {
  let s = scan_ok(
    "delete from orders using items where items.sku = orders.sku returning orders.id",
  );
  assert_eq(s.kind, KDelete);
  assert_eq(s.tables.written, ["orders"]);
  assert_eq(s.tables.read, ["items"])
}

test "a table read and written by one statement is a write" {
  let s = scan_ok("update items set n = n + 1 where sku in (select sku from items where n < 3)");
  assert_eq(s.tables.written, ["items"]);
  assert_eq(s.tables.read, [])
}

test "a schema-qualified name is its last segment" {
  assert_eq(scan_names("select * from public.items"), ["items"]);
  assert_eq(scan_names("insert into public.items values ($1)"), ["items"])
}

test "case folding follows postgres rather than the reader" {
  assert_eq(scan_names("SELECT * FROM Items"), ["items"]);
  assert_eq(scan_names("select * from \"Items\""), ["Items"]);
  assert_eq(scan_names("select * from \"has space\""), ["has space"])
}

test "a second statement is refused and named" {
  assert(scan_refused_at("select 1 from items; drop table items", 19));
  assert(scan_refused("insert into items values (1); delete from items"))
}

test "a semicolon inside a literal is text" {
  assert_eq(scan_names("select * from items where sku = '; drop table items; --'"), ["items"]);
  assert_eq(scan_names("select * from items where sku = $tag$; drop table items$tag$"), ["items"]);
  assert_eq(scan_names("select * from items where sku = $$;$$"), ["items"]);
  assert_eq(scan_names("select * from items where sku = e'\\'; drop table items; --'"), ["items"]);
  assert_eq(scan_names("select * from items where name = 'it''s; fine'"), ["items"]);
  assert_eq(scan_names("select * from \"weird;name\""), ["weird;name"])
}

test "a comment is not statement text" {
  assert_eq(scan_names("select 1 from items -- ; drop table items"), ["items"]);
  assert_eq(scan_names("select 1 /* ; drop table items */ from items"), ["items"]);
  assert_eq(scan_names("select 1 /* outer /* inner ; */ still comment */ from items"), ["items"]);
  assert(scan_refused("select 1 /* never closed from items"))
}

test "an unterminated literal is a refusal rather than a guess" {
  assert(scan_refused_at("select * from items where sku = 'open", 32));
  assert(scan_refused_at("select * from \"open", 14));
  assert(scan_refused_at("select * from items where sku = $tag$open", 32))
}

test "every statement shape outside the admitted set is refused" {
  assert(scan_refused("create table t (a int)"));
  assert(scan_refused("alter table t add column b int"));
  assert(scan_refused("drop table t"));
  assert(scan_refused("truncate t"));
  assert(scan_refused("copy t from stdin"));
  assert(scan_refused("do $$ begin end $$"));
  assert(scan_refused("call p()"));
  assert(scan_refused("lock table t"));
  assert(scan_refused("listen chan"));
  assert(scan_refused("notify chan"));
  assert(scan_refused("set statement_timeout = 0"));
  assert(scan_refused("show all"));
  assert(scan_refused("grant select on t to r"));
  assert(scan_refused("explain select * from t"));
  assert(scan_refused("begin"));
  assert(scan_refused("commit"));
  assert(scan_refused("vacuum"));
  assert(scan_refused("table items"));
  assert(scan_refused(""));
  assert(scan_refused("   "))
}

test "a construct the reader cannot account for is a named refusal" {
  // A set-returning function's relations live in a function body.
  assert(scan_refused("select * from generate_series(1, 10)"));
  // A row lock is a write the reader has no way to report through a read.
  assert(scan_refused("select * from items for update"));
  assert(scan_refused("select * from items limit 1 for share"));
  // An upsert's outcome is not reproducible by the engine.
  assert(scan_refused("insert into items values ($1) on conflict do nothing"));
  assert(scan_refused("select rank() over w from items window w as (order by sku)"));
  assert(scan_refused("select * from (items join orders on true)"))
}

test "an alias in the select list is a name and not a clause" {
  assert_eq(scan_names("select id as ident from items"), ["items"]);
  assert_eq(scan_names("select count(*) as n from items"), ["items"]);
  assert_eq(scan_names("select id ident from items"), ["items"]);
  assert_eq(
    scan_names("select a.id as a_id, b.id as b_id from items as a join orders as b on a.id = b.id"),
    ["items", "orders"],
  );
  assert_eq(scan_names("select (select max(n) from orders) as top, sku from items"), [
    "items",
    "orders",
  ]);
  assert_eq(scan_names("select n as v from items where n > $1 order by n limit 3"), ["items"])
}

test "a function the reader will not vouch for is refused" {
  assert(scan_refused("select set_config('search_path', 'pg_catalog', false) from items"));
  assert(scan_refused("select pg_advisory_lock(918) from items"));
  assert(scan_refused("select pg_read_file('/etc/hosts') from items"));
  assert(scan_refused("select pg_sleep(0) from items"));
  assert(scan_refused("select id from items where pg_backend_pid() > 0"));
  assert(scan_refused("insert into items (id) values (pg_backend_pid())"));
  assert(scan_refused("update items set n = pg_backend_pid()"));
  assert(scan_refused("delete from items where id = pg_backend_pid()"));
  assert_eq(scan_names("select count(*) from items"), ["items"]);
  assert_eq(scan_names("select sum(n) from items"), ["items"]);
  assert_eq(scan_names("select coalesce(n, 0) from items"), ["items"]);
  assert_eq(scan_names("select lower(sku), length(sku) from items"), ["items"]);
  assert_eq(scan_names("select id from items where id = any($1)"), ["items"]);
  assert_eq(scan_names("select id from items where sku in (select sku from orders)"), [
    "items",
    "orders",
  ]);
  assert_eq(scan_names("select cast(n as text) from items"), ["items"]);
  assert_eq(scan_names("select id from items where not (n > $1)"), ["items"]);
  assert_eq(scan_names("select case when n > $1 then upper(sku) else sku end from items"), [
    "items",
  ]);
  // Quoted, it is a name and not a call.
  assert_eq(scan_names("select \"pg_sleep\" from items"), ["items"])
}

test "a nondeterministic function in statement text is refused" {
  assert(scan_refused("insert into items (at) values (now())"));
  assert(scan_refused("select * from items where at < current_timestamp"));
  assert(scan_refused("select random() from items"));
  assert(scan_refused("update items set at = clock_timestamp()"));
  assert(scan_refused("select * from items where d = current_date"));
  // Quoted, it is a column name and not a call.
  assert_eq(scan_names("select \"now\" from items"), ["items"])
}

test "nesting is bounded rather than a stack overflow" { assert(scan_refused(nested_selects(64))) }

fn nested_selects(n: Int) -> String = nested_from("select * from items", n)

fn nested_from(sql: String, n: Int) -> String =
  if n <= 0 { sql } else { nested_from("select * from (" ++ sql ++ ") t", n - 1) }

test "malformed input is answered and never a panic" {
  // A panic would fail this test, so calling the reader *is* the assertion: whatever it answers,
  // it answers, and a program that built the text is not killed by the driver's own check.
  let _ = scan_statement("select");
  let _ = scan_statement("select * from");
  let _ = scan_statement("select * from (");
  let _ = scan_statement("insert into");
  let _ = scan_statement("update");
  let _ = scan_statement("update t");
  let _ = scan_statement("update t set");
  let _ = scan_statement("delete");
  let _ = scan_statement("delete from");
  let _ = scan_statement("with");
  let _ = scan_statement("with a");
  let _ = scan_statement("with a as");
  let _ = scan_statement("with a as (");
  let _ = scan_statement("select * from a join");
  let _ = scan_statement("select * from a join b on");
  let _ = scan_statement("((((");
  let _ = scan_statement("))))");
  let _ = scan_statement("$");
  let _ = scan_statement("$$");
  let _ = scan_statement("'");
  let _ = scan_statement("\"");
  let _ = scan_statement("select * from items order by");
  let _ = scan_statement("select * from items group by");
  let _ = scan_statement("select ,,, from items");
  let _ = scan_statement("select * from items where (");
  let _ = scan_statement("натурально");
  let _ = scan_statement("select * from ünïcode");
  // A statement cut short may be read as far as it goes; what must not happen is a panic.
  assert(scan_refused("with a as ("))
}

test "the payloads that change a statement's shape are refusals" {
  assert(scan_refused("select * from items where sku = '' ; drop table items --'"));
  // Kept, not refused here: the injected table is in the scan, so the row is what refuses it.
  assert_eq(scan_names("select * from items where sku = '' union select * from pg_shadow --'"), [
    "items",
    "pg_shadow",
  ]);
  // A legal `or` reading no new table; parameters never becoming syntax defends it.
  assert_eq(scan_names("select * from items where sku = '' or 1=1"), ["items"])
}

test "a placeholder is a token and never a value" {
  assert_eq(scan_names("select * from items where sku = $1 and n > $22"), ["items"]);
  assert_eq(scan_names("insert into items values ($1, $2, $3) returning sku"), ["items"])
}

test "the statement kind is reported so a read label over a write can be refused" {
  assert(!kind_writes(scan_ok("select * from items").kind));
  assert(!kind_writes(scan_ok("values (1), (2)").kind));
  assert(kind_writes(scan_ok("insert into items values ($1)").kind));
  assert(kind_writes(scan_ok("update items set a = 1").kind));
  assert(kind_writes(scan_ok("delete from items").kind));
  assert(scan_writes(scan_ok("with gone as (delete from items returning id) select * from gone")))
}

test "a connection string reads into the parts a driver needs" {
  match server_of(
      "postgres://ply:hunter2@127.0.0.1:5433/app?sslmode=disable&application_name=ply",
    ) {
    Err(why) -> panic(why),
    Ok(s) -> {
      assert_eq(s.user, "ply");
      assert_eq(s.password, Some("hunter2"));
      assert_eq(s.host, "127.0.0.1");
      assert_eq(s.port, 5433);
      assert_eq(s.database, "app");
      assert_eq(s.application_name, Some("ply"))
    },
  }
}

test "a connection string's timeouts and name are what every connection starts with" {
  match server_of(
      "postgres://ply@db/app?statement_timeout=250&application_name=the%20desk&idle_in_transaction_session_timeout=0",
    ) {
    Err(why) -> panic(why),
    Ok(s) -> {
      assert_eq(s.statement_timeout_ms, Some(250));
      assert_eq(s.idle_in_transaction_timeout_ms, Some(0));
      assert_eq(startup_parameters(s), [
        { name: "application_name", value: "the desk" },
        { name: "statement_timeout", value: "250" },
        { name: "idle_in_transaction_session_timeout", value: "0" },
      ])
    },
  };
  match server_of("postgres://ply@db/app?sslmode=disable") {
    Err(why) -> panic(why),
    Ok(s) -> {
      assert_eq(s.statement_timeout_ms, None);
      assert_eq(startup_parameters(s), [])
    },
  }
}

test "a timeout is whole milliseconds, given once, and no more than postgres takes" {
  assert_err("postgres://ply@db/app?statement_timeout=5s", "whole number of milliseconds");
  assert_err("postgres://ply@db/app?statement_timeout=-1", "whole number of milliseconds");
  assert_err("postgres://ply@db/app?idle_in_transaction_session_timeout=", "whole number");
  assert_err("postgres://ply@db/app?statement_timeout=2147483648", "past the most postgres takes");
  assert_err("postgres://ply@db/app?statement_timeout=1&statement_timeout=2", "given twice");
  assert_err("postgres://ply@db/app?application_name=a%00b", "zero byte")
}

test "a connection string may leave out the port, the password and the parameters" {
  match server_of("postgresql://ply@db/app") {
    Err(why) -> panic(why),
    Ok(s) -> {
      assert_eq(s.port, 5432);
      assert_eq(s.password, None);
      assert_eq(s.database, "app")
    },
  }
}

test "a password may hold what separates the fields, escaped" {
  match server_of("postgres://ply:a%40b%3Ac@db/app") {
    Err(why) -> panic(why),
    Ok(s) -> assert_eq(s.password, Some("a@b:c")),
  }
}

test "what a connection string cannot mean is refused rather than guessed" {
  assert_err("host=db user=ply", "keyword");
  assert_err("mysql://ply@db/app", "not a database");
  assert_err("postgres://db/app", "user@");
  assert_err("postgres://@db/app", "user is empty");
  assert_err("postgres://ply@/app", "no host");
  assert_err("postgres://ply@db:0/app", "port 0");
  assert_err("postgres://ply@db:nine/app", "is not a port");
  assert_err("postgres://ply@db/", "no database name");
  assert_err("postgres://ply@db/app?sslmode=require", "sslmode=require");
  assert_err("postgres://ply@db/app?timeout=3", "not a parameter");
  assert_err("postgres://ply@db/app?sslmode", "key=value")
}

fn assert_err(url: String, wanted: String) -> Unit =
  match server_of(url) {
    Ok(_) -> panic("`" ++ url ++ "` was accepted"),
    Err(why) ->
      assert(
        string_contains(why, wanted),
        Some(
          "`" ++ url ++ "` was refused with `" ++ why ++ "`, which does not name `" ++ wanted
            ++ "`",
        ),
      ),
  }

// --- The driver over a scripted server -------------------------------------------
//
// A postgres that answers what the driver sends as a server would, one conversation a connection:
// a statement completes, `BEGIN`, `COMMIT` and a refusal move the transaction's status, and a
// statement the script names is refused. A statement's reply is read after a `task.yield`, which is
// where a socket parks the task waiting on it.

// A refusal the script holds for the first statement that begins with `on`; a `fatal` one ends the
// session rather than the statement.
type Refusal = {
  on: String,
  code: String,
  constraint: String,
  message: String,
  detail: String,
  fatal: Bool,
}

fn refuse(
  on: String,
  code: String,
  constraint: String,
  message: String,
  detail: String,
) -> Refusal =
  { on: on, code: code, constraint: constraint, message: message, detail: detail, fatal: false }

fn hang_up(on: String, code: String) -> Refusal =
  { on: on, code: code, constraint: "", message: "terminating connection", detail: "", fatal: true }

// One connection: the bytes sent that are not yet a whole message, the replies not yet read, the
// transaction's status (73 idle, 84 in one, 69 in a failed one), the statement the extended cycle
// parsed, what it was sent, and whether the server still talks on it.
type Wire = {
  inbox: Bytes,
  outbox: Bytes,
  started: Bool,
  status: Int,
  parsed: String,
  said: List<String>,
  open: Bool,
}

type Fake = { wires: List<Wire>, refusals: List<Refusal> }

type Fed = { wire: Wire, refusals: List<Refusal> }

type Scripted<a> = { value: a, wires: List<Wire> }

fn t_frame(kind: Int, body: Bytes) -> Bytes =
  bytes_concat_all([byte_of_int(kind), u32_be(bytes_len(body) + 4), body])

fn t_text(s: String) -> Bytes = bytes_concat(bytes_of_string(s), b"\x00")

fn t_ready(status: Int) -> Bytes = t_frame(90, byte_of_int(status))

fn t_done(tag: String) -> Bytes = t_frame(67, t_text(tag))

fn t_field(code: String, text: String) -> Bytes =
  if text == "" { b"" } else { bytes_concat(bytes_of_string(code), t_text(text)) }

fn t_error(severity: String, r: Refusal) -> Bytes =
  t_frame(
    69,
    bytes_concat_all([
      t_field("S", severity),
      t_field("C", r.code),
      t_field("M", r.message),
      t_field("D", r.detail),
      t_field("n", r.constraint),
      b"\x00",
    ]),
  )

fn t_aborted() -> Refusal =
  refuse(
    "",
    "25P02",
    "",
    "current transaction is aborted, commands ignored until end of transaction block",
    "",
  )

fn t_greeted() -> Wire =
  {
    inbox: b"",
    outbox: bytes_concat(t_frame(82, u32_be(0)), t_ready(73)),
    started: false,
    status: 73,
    parsed: "",
    said: [],
    open: true,
  }

type Said = { bytes: Bytes, status: Int }

fn t_tagged(tag: String, status: Int) -> Said = { bytes: t_done(tag), status: status }

fn t_in_failed() -> Said = { bytes: t_error("ERROR", t_aborted()), status: 69 }

// Rolling back to a savepoint un-aborts the transaction, and the release that follows closes it.
fn t_rolled_back_to() -> Said =
  { bytes: bytes_concat(t_done("ROLLBACK"), t_done("RELEASE")), status: 84 }

fn t_answer(sql: String, status: Int, extended: Bool) -> Said =
  if extended { t_extended(sql, status) } else { t_simple(sql, status) }

fn t_extended(sql: String, status: Int) -> Said =
  if status == 69 { t_in_failed() } else {
    {
      bytes: bytes_concat_all([
        t_frame(49, b""),
        t_frame(50, b""),
        t_frame(110, b""),
        t_done(t_tag(sql)),
      ]),
      status: status,
    }
  }

fn t_simple(sql: String, status: Int) -> Said =
  if string_starts_with(sql, "begin") { t_tagged("BEGIN", 84) }
  else if sql == "commit" { t_tagged(if status == 69 { "ROLLBACK" } else { "COMMIT" }, 73) }
  else if sql == "rollback" { t_tagged("ROLLBACK", 73) }
  else if string_starts_with(sql, "rollback to") { t_rolled_back_to() }
  else if status == 69 { t_in_failed() }
  else if string_starts_with(sql, "savepoint") { t_tagged("SAVEPOINT", status) }
  else { t_tagged("RELEASE", status) }

fn t_tag(sql: String) -> String =
  if string_starts_with(sql, "insert") { "INSERT 0 1" }
  else if string_starts_with(sql, "update") { "UPDATE 1" }
  else { "DELETE 1" }

// An error in a transaction fails it, and a `COMMIT` that errs ends it.
fn t_after_error(sql: String, status: Int) -> Int =
  if sql == "commit" { 73 } else if status == 84 { 69 } else { status }

type Picked = { found: Option<Refusal>, rest: List<Refusal> }

fn t_pick(refusals: List<Refusal>, sql: String) -> Picked =
  fold(refusals, { found: None, rest: [] }, |acc: Picked, r: Refusal|
    match acc.found {
      None -> if string_starts_with(sql, r.on) { { ..acc, found: Some(r) } }
      else { { ..acc, rest: push(acc.rest, r) } },
      Some(_) -> { ..acc, rest: push(acc.rest, r) },
    })

fn t_statement(w: Wire, refusals: List<Refusal>, sql: String, extended: Bool) -> Fed = {
  let heard = { ..w, said: push(w.said, sql) };
  let picked = t_pick(refusals, sql);
  match picked.found {
    Some(r) -> if r.fatal {
      {
        wire: { ..heard, outbox: bytes_concat(heard.outbox, t_error("FATAL", r)), open: false },
        refusals: picked.rest,
      }
    } else {
      let status = t_after_error(sql, w.status);
      {
        wire: {
          ..heard,
          outbox: bytes_concat_all([heard.outbox, t_error("ERROR", r), t_ready(status)]),
          status: status,
        },
        refusals: picked.rest,
      }
    },
    None -> {
      let a = t_answer(sql, w.status, extended);
      {
        wire: {
          ..heard,
          outbox: bytes_concat_all([heard.outbox, a.bytes, t_ready(a.status)]),
          status: a.status,
        },
        refusals: picked.rest,
      }
    },
  }
}

fn t_cstring(b: Bytes, at: Int) -> String =
  match pg::read_cstring(b, at) { Some(c) -> c.text, None -> "" }

// A `Query` or a `Parse` while a reply is unread is a second conversation on the connection.
fn t_message(w: Wire, refusals: List<Refusal>, kind: Int, body: Bytes) -> Fed =
  if (kind == 81 || kind == 80) && bytes_len(w.outbox) > 0 {
    panic("a connection was sent a statement before its last one was answered")
  } else if kind == 81 { t_statement(w, refusals, t_cstring(body, 0), false) } else if kind == 80 {
    // A `Parse` names its statement before its text.
    match pg::read_cstring(body, 0) {
      Some(name) -> { wire: { ..w, parsed: t_cstring(body, name.next) }, refusals: refusals },
      None -> { wire: w, refusals: refusals },
    }
  } else if kind == 83 { t_statement(w, refusals, w.parsed, true) }
  else if kind == 88 { { wire: { ..w, open: false }, refusals: refusals } }
  else { { wire: w, refusals: refusals } }

// Every whole message in the inbox; the start-up message has no kind byte.
fn t_feed(w: Wire, refusals: List<Refusal>) -> Fed =
  if !w.started {
    match u32_be_at(w.inbox, 0) {
      None -> { wire: w, refusals: refusals },
      Some(n) -> if bytes_len(w.inbox) < n { { wire: w, refusals: refusals } } else {
        t_feed({ ..w, inbox: bytes_slice(w.inbox, n, bytes_len(w.inbox)), started: true }, refusals)
      },
    }
  } else {
    match u32_be_at(w.inbox, 1) {
      None -> { wire: w, refusals: refusals },
      Some(n) -> if bytes_len(w.inbox) < 1 + n { { wire: w, refusals: refusals } } else {
        let fed = t_message(
          { ..w, inbox: bytes_slice(w.inbox, 1 + n, bytes_len(w.inbox)) },
          refusals,
          bytes_at(w.inbox, 0),
          bytes_slice(w.inbox, 5, 1 + n),
        );
        t_feed(fed.wire, fed.refusals)
      },
    }
  }

fn t_sent(f: Fake, c: Int, payload: Bytes) -> Fake =
  match list_at(f.wires, c) {
    None -> panic("a send on a connection the script never opened"),
    Some(w) -> if !w.open { f } else {
      let fed = t_feed({ ..w, inbox: bytes_concat(w.inbox, payload) }, f.refusals);
      { wires: list_set(f.wires, c, fed.wire), refusals: fed.refusals }
    },
  }

type Heard = { fake: Fake, bytes: Bytes }

fn t_read(f: Fake, c: Int) -> Heard =
  match list_at(f.wires, c) {
    None -> panic("a read on a connection the script never opened"),
    Some(w) -> if bytes_len(w.outbox) > 0 {
      { fake: { ..f, wires: list_set(f.wires, c, { ..w, outbox: b"" }) }, bytes: w.outbox }
    } else if w.open { panic("the driver waited on a reply the script never sends") }
    else { { fake: f, bytes: b"" } },
  }

fn t_closed(f: Fake, c: Int) -> Fake =
  match list_at(f.wires, c) {
    None -> f,
    Some(w) -> { ..f, wires: list_set(f.wires, c, { ..w, open: false }) },
  }

// `body` served by `serve` over the script; a test runs it in a `simulate` region, so every
// interleaving of its tasks at the replies is run.
fn over_script<a | e>(
  size: Int,
  refusals: List<Refusal>,
  body: () -> a / {db.read[*], db.write[*] | e},
) -> Scripted<a> / {task.yield | e} =
  with_cell[wire]({ wires: [], refusals: refusals }) { fake -> {
    let value = handle {
      serve(server("db", 5432, "ply", "ply", None), size, "t", body)
    } with {
      net.connect[link](host, port, timeout_ms) -> {
        let f = cell_get(fake);
        cell_set(fake, { ..f, wires: push(f.wires, t_greeted()) });
        Some(len(f.wires))
      },
      net.send[link](c, payload, timeout_ms) -> {
        cell_set(fake, t_sent(cell_get(fake), c, payload));
        Some(bytes_len(payload))
      },
      net.recv[link](c, max, timeout_ms) -> {
        if t_talking(cell_get(fake), c) { task.yield() };
        let heard = t_read(cell_get(fake), c);
        cell_set(fake, heard.fake);
        Some(heard.bytes)
      },
      net.close[link](c) -> cell_set(fake, t_closed(cell_get(fake), c)),
    };
    { value: value, wires: cell_get(fake).wires }
  } }

// A connection past its greeting, whose replies park the task reading them.
fn t_talking(f: Fake, c: Int) -> Bool =
  match list_at(f.wires, c) { Some(w) -> len(w.said) > 0, None -> false }

fn t_said(wires: List<Wire>) -> List<List<String>> = map(wires, |w: Wire| w.said)

fn t_insert(sku: String) -> Stmt = stmt("insert into part (sku) values ('" ++ sku ++ "')")

fn t_begin(level: String) -> String = "begin isolation level " ++ level ++ " read write"

// Every connection's statements, cut where a transaction ends.
fn t_runs(wires: List<Wire>) -> List<List<String>> =
  fold(wires, [], |acc: List<List<String>>, w: Wire| concat_lists(acc, t_cut(w.said, [], [])))

fn t_cut(said: List<String>, run: List<String>, acc: List<List<String>>) -> List<List<String>> =
  match said {
    [] -> if len(run) == 0 { acc } else { push(acc, run) },
    [s, ..rest] -> if s == "commit" || s == "rollback" { t_cut(rest, [], push(acc, push(run, s))) }
    else { t_cut(rest, push(run, s), acc) },
  }

fn t_has_run(runs: List<List<String>>, run: List<String>) -> Bool =
  fold(runs, false, |acc: Bool, r: List<String>| acc || r == run)

// A serialization failure is the server asking for the transaction again, from its `begin`.
fn retried(
  left: Int,
  seen: List<String>,
) -> { result: Result<Int, Rollback>, seen: List<String> } / {db.begin, db.commit, db.abort, db.execute[part]} =
  match transaction(Serializable, ReadWrite, || {
      db.execute[part](t_insert("a"), []);
      1
    }) {
    Ok(v) -> { result: Ok(v), seen: seen },
    Err(rolled) -> match rolled.error {
      None -> { result: Err(rolled), seen: seen },
      Some(e) -> if is_retryable(e) && left > 1 { retried(left - 1, push(seen, e.code)) }
      else { { result: Err(rolled), seen: push(seen, e.code) } },
    },
  }

test "a refusal from the server is its SQLSTATE, the constraint it names and its message" {
  simulate {
    let r = over_script(
      1,
      [
        refuse(
          t_insert("a").sql,
          "23505",
          "part_pkey",
          "duplicate key value violates unique constraint \"part_pkey\"",
          "Key (sku)=(a) already exists.",
        ),
      ],
      || [db.execute[part](t_insert("a"), []), db.execute[part](t_insert("b"), [])],
    );
    assert_eq(r.value, [
      Failed({
        code: "23505",
        constraint: "part_pkey",
        detail: "duplicate key value violates unique constraint \"part_pkey\": Key (sku)=(a) already exists.",
      }),
      Count(1),
    ]);
    // The refusal left the server talking on the connection, so the next statement ran on it.
    assert_eq(t_said(r.wires), [[t_insert("a").sql, t_insert("b").sql]])
  }
}

test "a pool finishes every connection it holds once its body returns" {
  simulate {
    let r = over_script(2, [], || {
      let first = db.execute[part](t_insert("a"), []);
      [first, db.execute[part](t_insert("b"), [])]
    });
    assert_eq(r.value, [Count(1), Count(1)]);
    assert(len(r.wires) > 0);
    assert(fold(r.wires, true, |all: Bool, w: Wire| all && !w.open))
  }
}

test "a serialization failure at commit is retryable, and the retry begins a transaction afresh" {
  simulate {
    let r = over_script(
      1,
      [
        refuse(
          "commit",
          "40001",
          "",
          "could not serialize access due to read/write dependencies among transactions",
          "",
        ),
      ],
      || retried(3, []),
    );
    assert_eq(r.value, { result: Ok(1), seen: ["40001"] });
    let begin = t_begin("serializable");
    assert_eq(t_said(r.wires), [
      [begin, t_insert("a").sql, "commit", begin, t_insert("a").sql, "commit"],
    ])
  }
}

test "two tasks' transactions each hold a connection of their own, whichever order they run in" {
  simulate {
    let r = over_script(2, [], || {
      let a = task.spawn(||
        transaction(ReadCommitted, ReadWrite, || {
          db.execute[part](t_insert("a1"), []);
          "a"
        }));
      let b = task.spawn(||
        transaction(ReadCommitted, ReadWrite, || {
          db.execute[part](t_insert("b1"), []);
          db.rollback("b gave up")
        }));
      { a: task.join(a), b: task.join(b) }
    });
    assert_eq(r.value.a, Ok("a"));
    assert_eq(r.value.b, Err({ reason: "b gave up", error: None }));
    let begin = t_begin("read committed");
    let runs = t_runs(r.wires);
    assert_eq(len(runs), 2);
    assert(t_has_run(runs, [begin, t_insert("a1").sql, "commit"]));
    assert(t_has_run(runs, [begin, t_insert("b1").sql, "rollback"]))
  }
}

test "an operation belongs to the one transaction not waiting on the server, and to none when all are" {
  let s = { n: 0, session: None, depth: 1, level: ReadCommitted, access: ReadWrite, busy: false };
  let waiting = { ..s, n: 1, busy: true };
  assert_eq(route([]), NoTransaction);
  assert_eq(route([waiting]), NoTransaction);
  assert_eq(route([waiting, s]), Own(s));
  assert_eq(route([s, { ..s, n: 2 }]), Ambiguous)
}

test "a pool lends a connection to one statement at a time, and says so when it has none left" {
  simulate {
    let r = over_script(1, [], || {
      let a = task.spawn(|| db.execute[part](t_insert("t1"), []));
      let b = task.spawn(|| db.execute[part](t_insert("t2"), []));
      let c = task.spawn(|| db.execute[part](t_insert("t3"), []));
      [task.join(a), task.join(b), task.join(c)]
    });
    assert(
      fold(r.value, true, |acc: Bool, a: Answer| acc && (a == Count(1) || t_code(a) == "53300")),
    );
    assert(fold(r.value, false, |acc: Bool, a: Answer| acc || a == Count(1)));
    assert_eq(len(r.wires), 1)
  }
}

test "an inner abort closes its savepoint, and the transaction around it still commits" {
  simulate {
    let r = over_script(1, [], || {
      let out = transaction(ReadCommitted, ReadWrite, || {
        db.execute[part](t_insert("x"), []);
        let inner = transaction(ReadCommitted, ReadWrite, || {
          db.execute[part](t_insert("y"), []);
          db.rollback("inner gave up")
        });
        db.execute[part](t_insert("z"), []);
        inner
      });
      let after = transaction(ReadCommitted, ReadWrite, || db.execute[part](t_insert("w"), []));
      { out: out, after: after }
    });
    assert_eq(r.value.out, Ok(Err({ reason: "inner gave up", error: None })));
    assert_eq(r.value.after, Ok(Count(1)));
    let begin = t_begin("read committed");
    assert_eq(t_said(r.wires), [
      [
        begin,
        t_insert("x").sql,
        "savepoint ply_sp2",
        t_insert("y").sql,
        "rollback to savepoint ply_sp2; release savepoint ply_sp2",
        t_insert("z").sql,
        "commit",
        begin,
        t_insert("w").sql,
        "commit",
      ],
    ])
  }
}

test "a commit the server turns into a rollback is 25P02, and gives the connection back" {
  simulate {
    let r = over_script(
      1,
      [
        refuse(
          t_insert("a").sql,
          "23505",
          "part_pkey",
          "duplicate key value violates unique constraint \"part_pkey\"",
          "",
        ),
      ],
      || {
        let out = transaction(ReadCommitted, ReadWrite, || db.execute[part](t_insert("a"), []));
        { out: out, next: db.execute[part](t_insert("b"), []) }
      },
    );
    assert_eq(r.value.out, Err({ reason: "commit", error: Some(in_failed_txn()) }));
    assert_eq(r.value.next, Count(1));
    assert_eq(t_said(r.wires), [
      [t_begin("read committed"), t_insert("a").sql, "commit", t_insert("b").sql],
    ])
  }
}

test "a nested begin the transaction cannot take is refused before anything is sent" {
  simulate {
    let r = over_script(
      1,
      [refuse(t_insert("a").sql, "23505", "part_pkey", "duplicate key", "")],
      || {
        let bounded = transaction(ReadCommitted, ReadOnly, ||
          [db.begin(Serializable, ReadOnly), db.begin(ReadCommitted, ReadWrite)]);
        let failed = sandbox(|| {
          db.execute[part](t_insert("a"), []);
          db.begin(ReadCommitted, ReadWrite)
        });
        { bounded: bounded, failed: failed }
      },
    );
    assert_eq(match r.value.bounded { Ok(answers) -> map(answers, t_code), Err(_) -> [] }, [
      "25001",
      "25001",
    ]);
    assert_eq(t_code(r.value.failed), "25P02");
    assert_eq(t_said(r.wires), [
      [
        "begin isolation level read committed read only",
        "commit",
        t_begin("read committed"),
        t_insert("a").sql,
        "rollback",
      ],
    ])
  }
}

test "a connection lost inside a transaction fails the rest of it, and nothing of it runs elsewhere" {
  simulate {
    let r = over_script(
      1,
      [hang_up(t_insert("a").sql, "57P01"), hang_up(t_insert("d").sql, "57P01")],
      || {
        let rest = sandbox(||
          [
            db.execute[part](t_insert("a"), []),
            db.execute[part](t_insert("b"), []),
            db.begin(ReadCommitted, ReadWrite),
          ]);
        let next = db.execute[part](t_insert("c"), []);
        let committed = transaction(ReadCommitted, ReadWrite, ||
          db.execute[part](t_insert("d"), []));
        { rest: map(rest, t_code), next: next, committed: committed }
      },
    );
    assert_eq(r.value.rest, ["57P01", "08003", "08003"]);
    assert_eq(r.value.next, Count(1));
    assert_eq(r.value.committed, Err({ reason: "commit", error: Some(connection_lost()) }));
    let begin = t_begin("read committed");
    assert_eq(t_said(r.wires), [
      [begin, t_insert("a").sql],
      [t_insert("c").sql, begin, t_insert("d").sql],
    ]);
    assert_eq(map(r.wires, |w: Wire| w.open), [false, false])
  }
}
