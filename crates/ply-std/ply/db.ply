//! PostgreSQL: the `db` effect, its driver over `std.pg`, and an in-memory twin.
//!
//! The resource label is a table: `db.query[items]` is `db.read[items]`. Transaction control is on the
//! singleton resource, so transactions conflict. SQL errors are values: a `DbError` names the SQLSTATE,
//! the constraint a violation names, and the server's message and detail.
//!
//! The driver reads a statement before it sends it. A statement that writes, performed as `db.query`,
//! is refused, because the endpoints that perform it would be scheduled as if they only read; so is
//! text the reader cannot account for (a second statement after a `;`, `for update`, `on conflict`, a
//! call it will not vouch for, a function whose value is not a function of the program's state),
//! because a footprint it guessed at is a scheduler that runs two writers beside each other; and so
//! is a statement whose tables do not include the label the call site named. Each refusal is raised,
//! so a program cannot ignore it. These are `std.sql`'s `checked`, which `ply check` runs before
//! anything does on every statement whose text it can compute; `fetch` reads a statement's rows as
//! values of a record type through the codec `derive row` writes for it.
//!
//! `with_server(url, size, body)` serves the effect from a connection string: the pool, the transaction
//! scope and the text of every value are Ply's, and the host is left with `net`. A statement outside a
//! transaction takes an idle connection, or opens one while fewer than `size` are open, and gives it
//! back once the server has answered; with none to take it is `53300`. A `begin` takes a connection for
//! its transaction, a `begin` inside it is a savepoint on that connection, and the `commit` or `abort`
//! that closes the transaction gives the connection back whatever the server answered. A `commit` the
//! server turned into a rollback is `25P02`, as it is in the twin. A handler cannot see which task
//! performs an operation, so `serve` takes an operation to belong to the one open transaction whose
//! connection is not waiting on the server: a task holding a transaction open must wait on nothing but
//! its own statements, and an operation performed while two transactions are between statements is
//! raised.
//!
//! A connection that fails is class `08`: `08001` it could not be opened, TLS included, `08006` it
//! broke, `08P01` a reply could not be read, `08003` the transaction's connection is gone and the
//! transaction with it, and `08007` a `commit` whose outcome is unknown. A server that asks for a
//! password when none was given is `28000`. A connection string's `sslmode` decides whether every
//! connection is secured, and a secured one is always verified (`Ssl`). The password is a
//! `Secret<Bytes>` from where it is read, the connection string or `with_server`'s `password` (as
//! `config.secret` answers one), to the wire.
//!
//! `db.notify` is a statement like any other, on its transaction's connection, so the server delivers
//! it when that commits. Listening is not: `db.listen` opens a connection of the driver's own, outside
//! the pool and never inside a transaction, and `db.notified` waits on it, one task at a time. That
//! connection can be lost, and what is notified while it is lost is lost with it, so the wait that
//! opens a new one and listens again answers `Reconnected` before anything heard after: a program
//! that keeps state from notifications reads it afresh there. The wait is an operation rather than
//! a `std.seq` sequence because each wait needs a deadline of its own and changes the listener (its
//! buffer, its connection) in a way a sequence pulled again from its start would repeat.
//!
//! `copy_into` and `copy_from` move rows with `COPY` in its text format, the values as text as every
//! statement's are: in, a sequence of rows sent a chunk at a time and kept whole or not at all; out,
//! a sequence of the rows a statement answers, read a page at a time. Each holds its connection, a
//! transaction's or one of the pool's, until it ends; `db.copy_in`, `db.copy_rows`, `db.copy_end`,
//! `db.copy_out` and `db.copy_take` are the operations under them.
//!
//! `MemDb` is the in-memory twin: `open` a schema, then `step`, `begin_step`, `commit_step` and
//! `abort_step` answer what a server would, and `notify_step`, `listen_step`, `unlisten_step`,
//! `notified_step` and `cut_step` what its notifications would. It holds no copy.

import std.bytes (u32_be, u32_be_at, cstring, peek)
import std.json
import std.net (net)
import std.random (entropy, nonce)
import std.pg
import std.string
import std.list (concat, contains, drop_last, find)
import std.seq
import std.seq (Seq, Done, Skip, Yield, seq)
import std.bytes
import std.option (option_unwrap_or)
import std.result (result_map, result_map_err)
import std.sql
import std.sql (Stmt, Param, Answer, DbError, Row, Failed, db_error, stmt, Count, Schema, Table,
                Column, DSequence, DNone, DLiteral, Unique, ForeignKey, Check, ColumnType, TInt,
                TBool, TText, TBytes, TFloat, TNumeric, TJson, TArray, PNull, PInt, PBool, PText,
                PNumeric, PFloat, PBytes, PJson, PArray, column, Datum, CText, CNull, CBool,
                CNumeric, CInt, CBytes, CFloat, CJson, CArray, Rows, column_default, Postgres,
                tokenize, SqlTokAt, SqlPlaceholder, sql_is_semi, datum_type, Operation, Reads,
                Writes, WritesRows)

/// The database, one table per label.
pub nondet effect db {
  /// Runs a statement that only reads, its `$n` placeholders bound to `ps`.
  read query[t](s: Stmt, ps: List<Param>) -> Answer
  /// The statement once for each parameter list, each answer what its own `query` would have had.
  read batch[t](s: Stmt, each: List<List<Param>>) -> List<Answer>
  /// Runs a statement that writes, answering the rows it touched as `Count`.
  write execute[t](s: Stmt, ps: List<Param>) -> Answer
  /// Runs a statement that writes and answers rows, as one with `returning` does.
  write returning[t](s: Stmt, ps: List<Param>) -> Answer
  /// Transaction control takes no resource, so its atom is the singleton `db.write`.
  write begin(level: Isolation, access: Access) -> Answer
  /// Commits the innermost open transaction or savepoint.
  write commit() -> Answer
  /// Rolls back the innermost open transaction or savepoint.
  write abort() -> Answer
  /// Handled by `transaction`, never by the host: a host binding for it is a defect.
  write rollback(reason: String) -> Unit
  /// Notifies the channel `c` with `payload`: every session listening on `c` hears it once the
  /// transaction this is performed in commits, at once outside one, and never if the transaction
  /// rolls back. Two with one payload in one transaction are heard once. A payload of 8000 bytes or
  /// more is `22023`.
  write notify[c](payload: String) -> Answer
  /// Listens on the channel `c`, on a connection of its own outside the pool that `notified`
  /// reads.
  write listen[c]() -> Answer
  /// Stops listening on the channel `c`.
  write unlisten[c]() -> Answer
  /// The next notification on a channel the program listens on, waiting at most `timeout_ms` for
  /// one, or what became of the connection it is heard on. One task waits at a time.
  write notified(timeout_ms: Int) -> Notice
  /// Begins copying rows into the `columns` of table `t` with `COPY`, answering the copy's number.
  /// Inside a transaction it runs on the transaction's connection, which runs nothing else until
  /// the copy ends; outside one it holds a connection of the pool's until then.
  write copy_in[t](columns: List<String>) -> Result<Int, DbError>
  /// Sends rows to a copy `copy_in` began, each its columns' values in order.
  write copy_rows[t](copy: Int, rows: List<List<Param>>) -> Result<Unit, DbError>
  /// Ends a copy. A copy in with `None` keeps every row it was sent and answers how many; with
  /// `Some(why)` the server keeps none of them and the answer is its refusal, `57014`, which is also
  /// how a row the server could not take refuses it. A copy out reads and drops what was not taken,
  /// and answers how many rows were, or what failed it.
  write copy_end[t](copy: Int, failure: Option<String>) -> Result<Int, DbError>
  /// Begins copying the rows the statement `s` answers out of the server with `COPY`, answering the
  /// copy's number. It holds a connection as `copy_in` does.
  read copy_out[t](s: Stmt) -> Result<Int, DbError>
  /// At most `rows` more rows of a copy out, as `query` would have answered them; none once the
  /// server has sent every row or the copy failed, which `copy_end` then says.
  read copy_take[t](copy: Int, rows: Int) -> Result<List<Row>, DbError>
}

/// What a wait for a notification answers.
pub type Notice =
  /// A notification on a channel the program listens on.
  | Notified(pg::Notification)
  /// The listening connection was lost and a new one listens again on every channel. A
  /// notification sent in between was lost, so a program that keeps state from them reads it
  /// afresh.
  | Reconnected
  /// The listening connection is lost and a new one could not be opened, for this reason; the next
  /// wait tries again, and answers `Reconnected` once one is.
  | Unheard(DbError)
  /// Nothing arrived before the deadline.
  | Quiet

/// A transaction's isolation level, as postgres names them.
pub type Isolation = | ReadCommitted | RepeatableRead | Serializable

/// Whether a transaction may write.
pub type Access = | ReadWrite | ReadOnly

// --- Transactions -----------------------------------------------------------

/// Why a transaction rolled back: the reason `db.rollback` gave, and the error that caused it, if one
/// did.
pub type Rollback = { reason: String, error: Option<DbError> }

/// A `db.rollback` anywhere inside the body, however deep, discards the rest of it, and the
/// transaction is aborted however the body ends short of its commit: a clause unwinding out of it, or
/// a cancel, included. A `rollback` performed in the body still reaches the caller's row through `e`,
/// so a handler around a transaction names it too.
pub fn transaction<a | e>(
  level: Isolation,
  access: Access,
  body: () -> a / e,
) -> Result<a, Rollback> / {db.begin bounded, db.commit bounded, db.abort bounded | e bounded} =
  match db.begin(level, access) {
    Failed(err) -> Err({ reason: "begin", error: Some(err) }),
    _ -> with_cell[settled](false) { committing ->
      bracket(|| (), |u: Unit| if !cell_get(committing) { aborted() }, |u: Unit|
        match attempt(body) {
          Err(rolled) -> Err(rolled),
          Ok(value) -> {
            cell_set(committing, true);
            match db.commit() {
              Failed(err) -> Err({ reason: "commit", error: Some(err) }),
              _ -> Ok(value),
            }
          },
        })
    },
  }

fn attempt<a | e>(body: () -> a / e) -> Result<a, Rollback> / e =
  handle {
    Ok(body())
  } with {
    db.rollback(reason) resume k -> Err({ reason: reason, error: None }),
  }

/// A transaction that always rolls back, whatever the body did.
pub fn sandbox<a | e>(
  body: () -> a / e,
) -> a / {abort.raise, db.begin bounded, db.abort bounded | e bounded} =
  bracket(|| assert(opened(db.begin(ReadCommitted, ReadWrite))), |u: Unit| aborted(), |u: Unit|
    body())

/// Whatever the server said, the transaction is over: its answer is a warning at most.
fn aborted() -> Unit / {db.abort} = {
  db.abort();
  ()
}

fn opened(a: Answer) -> Bool = match a { Failed(_) -> false, _ -> true }

/// A serialization failure or a deadlock: the server is asking the program to retry.
pub fn is_retryable(e: DbError) -> Bool = e.code == "40001" || e.code == "40P01"

// --- Rows read as values -------------------------------------------------------------

/// The rows `s` answers, each read by `codec`. Where the check can compute the statement and the
/// codec is a derived one, it holds the columns the statement answers to the codec's fields.
pub fn fetch<a, [t]>(
  s: Stmt,
  codec: sql::RowCodec<a>,
  ps: List<Param>,
) -> Result<List<a>, sql::Unread> / {db.query[t], abort.raise} =
  sql::decoded(db.query[t](s, ps), codec)

/// `fetch` over a statement that writes and answers the rows its `returning` names.
pub fn fetch_returning<a, [t]>(
  s: Stmt,
  codec: sql::RowCodec<a>,
  ps: List<Param>,
) -> Result<List<a>, sql::Unread> / {db.returning[t], abort.raise} =
  sql::decoded(db.returning[t](s, ps), codec)

// --- Copying ------------------------------------------------------------------------

/// Copies `rows` into the `columns` of table `t` with `COPY`, sending them a chunk of at most `chunk`
/// rows at a time, so no more than one chunk is held, and answers how many rows the server took.
/// The rows are pulled as they are sent, within `budget` elements and skips. The copy keeps every
/// row or none: a chunk refused, the budget spent (`seq.spent`) or a raise out of a pull fails it
/// with `CopyFail` before the raise goes on.
pub fn copy_into<[t] | e>(
  columns: List<String>,
  rows: Seq<List<Param> | e>,
  chunk: Int,
  budget: Int,
) -> Result<Int, DbError> / {db.copy_in[t], db.copy_rows[t], db.copy_end[t], seq.spent | e} =
  match db.copy_in[t](columns) {
    Err(e) -> Err(e),
    Ok(id) -> with_cell[sending](false) { closed ->
      bracket(
        || (),
        |u: Unit|
          if !cell_get(closed) {
            db.copy_end[t](id, Some("the rows stopped short of their end"));
            ()
          },
        |u: Unit|
          match sent_chunks[t](id, rows, max(chunk, 1), budget, budget, []) {
            Err(e) -> Err(e),
            Ok(_) -> {
              cell_set(closed, true);
              db.copy_end[t](id, None)
            },
          },
      )
    },
  }

/// What is left of `s` pulled and sent, `held` the rows of the chunk not yet sent.
fn sent_chunks<[t] | e>(
  id: Int,
  s: Seq<List<Param> | e>,
  chunk: Int,
  budget: Int,
  left: Int,
  held: List<List<Param>>,
) -> Result<Unit, DbError> / {db.copy_rows[t], seq.spent | e} =
  match s() {
    Done -> if len(held) == 0 { Ok(()) } else { db.copy_rows[t](id, held) },
    Skip(rest) -> if left <= 0 { seq.spent(budget) }
    else { sent_chunks[t](id, rest, chunk, budget, left - 1, held) },
    Yield(row, rest) -> if left <= 0 { seq.spent(budget) } else {
      let more = push(held, row);
      if len(more) < chunk { sent_chunks[t](id, rest, chunk, budget, left - 1, more) } else {
        match db.copy_rows[t](id, more) {
          Err(e) -> Err(e),
          Ok(_) -> sent_chunks[t](id, rest, chunk, budget, left - 1, []),
        }
      }
    },
  }

/// The rows the statement `s` answers, copied out of the server with `COPY` and handed to `body` as
/// a sequence whose pulls read them `page` at a time, so no more than a page is held. Each row is
/// what `query` would have answered. The copy ends when `body` returns, what it did not pull read
/// and dropped; the answer is `body`'s, or what failed the copy, which ends the sequence early.
pub fn copy_from<a, [t] | e>(
  s: Stmt,
  page: Int,
  body: (Seq<Row | {db.copy_take[t]}>) -> a / e,
) -> Result<a, DbError> / {db.copy_out[t], db.copy_end[t] | e} =
  match db.copy_out[t](s) {
    Err(e) -> Err(e),
    Ok(id) -> with_cell[receiving](false) { closed ->
      bracket(
        || (),
        |u: Unit|
          if !cell_get(closed) {
            db.copy_end[t](id, None);
            ()
          },
        |u: Unit| {
          let answer = body(paged[t](id, max(page, 1), [], 4611686018427387903));
          cell_set(closed, true);
          match db.copy_end[t](id, None) { Err(e) -> Err(e), Ok(_) -> Ok(answer) }
        },
      )
    },
  }

/// A copy out's rows, `held` the ones a page brought that are not yet pulled.
fn paged<[t]>(id: Int, page: Int, held: List<Row>, fuel: Int) -> Seq<Row | {db.copy_take[t]}> =
  ||
    match held {
      [row, ..rest] -> Yield(row, paged[t](id, page, rest, fuel)),
      [] -> if fuel <= 0 { Done } else {
        match db.copy_take[t](id, page) {
          Ok(rows) -> if len(rows) == 0 { Done } else { Skip(paged[t](id, page, rows, fuel - 1)) },
          Err(_) -> Done,
        }
      },
    }

// --- Batching ----------------------------------------------------------------------

/// A lookup stepped to the ask it waits on, and what it does with the answer.
type Pending<b> = | Looked(b) | Asking({ s: Stmt, ps: List<Param>, next: (Answer) -> Pending<b> })

/// `lookup` over each of `xs`, answering what `map` would. Each lookup runs until it asks the store,
/// and the asks of one round that share a statement are one `db.batch`. A lookup only reads, so its
/// asks may be answered in any order, and each answer is the one its own `db.query` would have had.
pub fn batched<a, b, [t]>(
  xs: List<a>,
  lookup: (a) -> b / {db.query[t]},
) -> List<b> / {db.query[t], db.batch[t], abort.raise, diverges} =
  rounds[t](map(xs, |x: a| stepped[t](|| lookup(x))))

fn stepped<b, [t]>(go: () -> b / {db.query[t]}) -> Pending<b> =
  handle { Looked(go()) } with { db.query[t](s, ps) resume k -> Asking({ s: s, ps: ps, next: k }) }

fn rounds<b, [t]>(
  ps: List<Pending<b>>,
) -> List<b> / {db.query[t], db.batch[t], abort.raise, diverges} = {
  let waiting = filter(range(0, len(ps)), |i: Int|
    match list_at(ps, i) { Some(Asking(_)) -> true, _ -> false });
  if len(waiting) == 0 {
    fold(ps, [], |acc: List<b>, p: Pending<b>| match p { Looked(v) -> push(acc, v), _ -> acc })
  } else {
    let answers = asked[t](ps, waiting);
    rounds[t](
      map(range(0, len(ps)), |i: Int|
        match list_at(ps, i) {
          Some(Asking(a)) ->
            (a.next)(match map_get(answers, i) {
              Some(answer) -> answer,
              None -> Failed(db_error("XX000", "", "a batched ask went unanswered")),
            }),
          Some(done) -> done,
          None -> Looked(panic("an index the round holds")),
        }),
    )
  }
}

/// One round's asks answered, by their place: a statement asked once is a `db.query`, and one asked
/// more is a `db.batch` of all its parameter lists, in the order the asks were made.
fn asked<b, [t]>(
  ps: List<Pending<b>>,
  waiting: List<Int>,
) -> Map<Int, Answer> / {db.query[t], db.batch[t]} = {
  let groups = fold(waiting, [], |acc: List<{ s: Stmt, at: List<Int> }>, i: Int|
    match list_at(ps, i) {
      Some(Asking(a)) -> match fold(range(0, len(acc)), None, |found: Option<Int>, g: Int|
          match found {
            Some(_) -> found,
            None -> match list_at(acc, g) {
              Some(x) -> if x.s == a.s { Some(g) } else { None },
              None -> None,
            },
          }) {
        Some(g) -> match list_at(acc, g) {
          Some(x) -> list_set(acc, g, { ..x, at: push(x.at, i) }),
          None -> acc,
        },
        None -> push(acc, { s: a.s, at: [i] }),
      },
      _ -> acc,
    });
  let params = |i: Int| match list_at(ps, i) { Some(Asking(a)) -> a.ps, _ -> [] };
  fold(groups, map_new(), |acc: Map<Int, Answer>, g: { s: Stmt, at: List<Int> }|
    match g.at {
      [only] -> map_insert(acc, only, db.query[t](g.s, params(only))),
      _ -> {
        let answers = db.batch[t](g.s, map(g.at, params));
        fold(range(0, len(g.at)), acc, |m: Map<Int, Answer>, k: Int|
          match ((list_at(g.at, k), list_at(answers, k))) {
            (Some(i), Some(answer)) -> map_insert(m, i, answer),
            (Some(i), None) ->
              map_insert(
                m,
                i,
                Failed(db_error("XX000", "", "a batch answered fewer asks than it was given")),
              ),
            _ -> m,
          })
      },
    })
}

// --- Tests ------------------------------------------------------------------

/// A rollback raised two calls deep, out of sight of the `handle` that answers it.
fn charge(stock: Bool) -> Int / {db.execute[items], db.rollback} = {
  db.execute[items](stmt("insert one"), []);
  reserve(stock);
  db.execute[items](stmt("insert three"), []);
  3
}

fn reserve(stock: Bool) -> Unit / {db.execute[items], db.rollback} =
  if stock {
    db.execute[items](stmt("insert two"), []);
    ()
  } else { db.rollback("no stock") }

test "a rollback discards the continuation the body had left" {
  with_cell[journal]([]) { j ->
    handle {
      let out = transaction(ReadCommitted, ReadWrite, || {
        db.execute[items](stmt("insert one"), []);
        db.rollback("out of stock");
        db.execute[items](stmt("insert two"), []);
        7
      });
      assert_eq(out, Err({ reason: "out of stock", error: None }));
      // `commit` is absent too: it was part of the discarded continuation.
      assert_eq(cell_get(j), ["begin", "insert one", "abort"])
    } with {
      db.begin(level, access) -> {
        cell_set(j, push(cell_get(j), "begin"));
        Count(0)
      },
      db.commit() -> {
        cell_set(j, push(cell_get(j), "commit"));
        Count(0)
      },
      db.abort() -> {
        cell_set(j, push(cell_get(j), "abort"));
        Count(0)
      },
      db.execute[items](s, ps) -> {
        cell_set(j, push(cell_get(j), s.sql));
        Count(1)
      },
      db.rollback(reason) -> panic("a transaction answers its own rollback"),
    }
  }
}

test "a body that returns commits, and its value comes out" {
  with_cell[journal]([]) { j ->
    handle {
      let out = transaction(Serializable, ReadWrite, || {
        db.execute[items](stmt("insert one"), []);
        "done"
      });
      assert_eq(out, Ok("done"));
      assert_eq(cell_get(j), ["begin", "insert one", "commit"])
    } with {
      db.begin(level, access) -> {
        cell_set(j, push(cell_get(j), "begin"));
        Count(0)
      },
      db.commit() -> {
        cell_set(j, push(cell_get(j), "commit"));
        Count(0)
      },
      db.abort() -> {
        cell_set(j, push(cell_get(j), "abort"));
        Count(0)
      },
      db.execute[items](s, ps) -> {
        cell_set(j, push(cell_get(j), s.sql));
        Count(1)
      },
    }
  }
}

test "a begin that fails runs no body and issues no abort" {
  with_cell[journal]([]) { j ->
    handle {
      let out = transaction(ReadCommitted, ReadWrite, || {
        db.execute[items](stmt("insert one"), []);
        7
      });
      assert_eq(
        out,
        Err({
          reason: "begin",
          error: Some({ code: "53300", constraint: "", detail: "too many clients already" }),
        }),
      );
      assert_eq(cell_get(j), ["begin"])
    } with {
      db.begin(level, access) -> {
        cell_set(j, push(cell_get(j), "begin"));
        Failed({ code: "53300", constraint: "", detail: "too many clients already" })
      },
      db.commit() -> {
        cell_set(j, push(cell_get(j), "commit"));
        Count(0)
      },
      db.abort() -> {
        cell_set(j, push(cell_get(j), "abort"));
        Count(0)
      },
      db.execute[items](s, ps) -> {
        cell_set(j, push(cell_get(j), s.sql));
        Count(1)
      },
    }
  }
}

test "a commit that fails is an Err carrying the SQLSTATE" {
  with_cell[journal]([]) { j ->
    handle {
      let out = transaction(Serializable, ReadWrite, || {
        db.execute[items](stmt("insert one"), []);
        7
      });
      let retryable = match out {
        Err(r) -> match r.error { Some(e) -> is_retryable(e), None -> false },
        Ok(_) -> false,
      };
      assert(retryable);
      assert_eq(cell_get(j), ["begin", "insert one", "commit"])
    } with {
      db.begin(level, access) -> {
        cell_set(j, push(cell_get(j), "begin"));
        Count(0)
      },
      db.commit() -> {
        cell_set(j, push(cell_get(j), "commit"));
        Failed({ code: "40001", constraint: "", detail: "could not serialize access" })
      },
      db.abort() -> {
        cell_set(j, push(cell_get(j), "abort"));
        Count(0)
      },
      db.execute[items](s, ps) -> {
        cell_set(j, push(cell_get(j), s.sql));
        Count(1)
      },
    }
  }
}

test "a rollback two calls deep discards its callers" {
  with_cell[journal]([]) { j ->
    handle {
      let out = transaction(ReadCommitted, ReadWrite, || charge(false));
      assert_eq(out, Err({ reason: "no stock", error: None }));
      assert_eq(cell_get(j), ["begin", "insert one", "abort"])
    } with {
      db.begin(level, access) -> {
        cell_set(j, push(cell_get(j), "begin"));
        Count(0)
      },
      db.commit() -> {
        cell_set(j, push(cell_get(j), "commit"));
        Count(0)
      },
      db.abort() -> {
        cell_set(j, push(cell_get(j), "abort"));
        Count(0)
      },
      db.execute[items](s, ps) -> {
        cell_set(j, push(cell_get(j), s.sql));
        Count(1)
      },
      db.rollback(reason) -> panic("a transaction answers its own rollback"),
    }
  }
}

test "the same body without the rollback runs to its end and commits" {
  with_cell[journal]([]) { j ->
    handle {
      assert_eq(transaction(ReadCommitted, ReadWrite, || charge(true)), Ok(3));
      assert_eq(cell_get(j), ["begin", "insert one", "insert two", "insert three", "commit"])
    } with {
      db.begin(level, access) -> {
        cell_set(j, push(cell_get(j), "begin"));
        Count(0)
      },
      db.commit() -> {
        cell_set(j, push(cell_get(j), "commit"));
        Count(0)
      },
      db.abort() -> {
        cell_set(j, push(cell_get(j), "abort"));
        Count(0)
      },
      db.execute[items](s, ps) -> {
        cell_set(j, push(cell_get(j), s.sql));
        Count(1)
      },
      db.rollback(reason) -> panic("a transaction answers its own rollback"),
    }
  }
}

// Nesting is a savepoint: the inner `transaction`'s `handle` is innermost and answers the rollback.
test "an inner rollback leaves the outer transaction running" {
  with_cell[journal]([]) { j ->
    handle {
      let out = transaction(ReadCommitted, ReadWrite, || {
        db.execute[items](stmt("outer one"), []);
        let inner = transaction(ReadCommitted, ReadWrite, || {
          db.execute[items](stmt("inner one"), []);
          db.rollback("inner gave up");
          db.execute[items](stmt("inner two"), []);
          1
        });
        db.execute[items](stmt("outer two"), []);
        inner
      });
      assert_eq(out, Ok(Err({ reason: "inner gave up", error: None })));
      assert_eq(cell_get(j), [
        "begin",
        "outer one",
        "begin",
        "inner one",
        "abort",
        "outer two",
        "commit",
      ])
    } with {
      db.begin(level, access) -> {
        cell_set(j, push(cell_get(j), "begin"));
        Count(0)
      },
      db.commit() -> {
        cell_set(j, push(cell_get(j), "commit"));
        Count(0)
      },
      db.abort() -> {
        cell_set(j, push(cell_get(j), "abort"));
        Count(0)
      },
      db.execute[items](s, ps) -> {
        cell_set(j, push(cell_get(j), s.sql));
        Count(1)
      },
      db.rollback(reason) -> panic("a transaction answers its own rollback"),
    }
  }
}

// A released savepoint is not a commit.
test "an outer rollback discards a committed inner scope" {
  with_cell[journal]([]) { j ->
    handle {
      let out = transaction(ReadCommitted, ReadWrite, || {
        let inner = transaction(ReadCommitted, ReadWrite, || {
          db.execute[items](stmt("inner one"), []);
          1
        });
        db.rollback("the outer gave up");
        inner
      });
      assert_eq(out, Err({ reason: "the outer gave up", error: None }));
      assert_eq(cell_get(j), ["begin", "begin", "inner one", "commit", "abort"])
    } with {
      db.begin(level, access) -> {
        cell_set(j, push(cell_get(j), "begin"));
        Count(0)
      },
      db.commit() -> {
        cell_set(j, push(cell_get(j), "commit"));
        Count(0)
      },
      db.abort() -> {
        cell_set(j, push(cell_get(j), "abort"));
        Count(0)
      },
      db.execute[items](s, ps) -> {
        cell_set(j, push(cell_get(j), s.sql));
        Count(1)
      },
      db.rollback(reason) -> panic("a transaction answers its own rollback"),
    }
  }
}

test "sandbox runs the body, hands back its value and aborts" {
  with_cell[journal]([]) { j ->
    handle {
      assert_eq(
        sandbox(|| {
          db.execute[items](stmt("insert one"), []);
          "kept"
        }),
        "kept",
      );
      assert_eq(cell_get(j), ["begin", "insert one", "abort"])
    } with {
      db.begin(level, access) -> {
        cell_set(j, push(cell_get(j), "begin"));
        Count(0)
      },
      db.commit() -> {
        cell_set(j, push(cell_get(j), "commit"));
        Count(0)
      },
      db.abort() -> {
        cell_set(j, push(cell_get(j), "abort"));
        Count(0)
      },
      db.execute[items](s, ps) -> {
        cell_set(j, push(cell_get(j), s.sql));
        Count(1)
      },
    }
  }
}

// `sandbox` installs no `handle`, so the enclosing transaction answers a rollback inside it.
test "a sandbox nested in a transaction keeps the transaction's rollback" {
  with_cell[journal]([]) { j ->
    handle {
      let out = transaction(ReadCommitted, ReadWrite, ||
        sandbox(|| {
          db.execute[items](stmt("insert one"), []);
          db.rollback("give up");
          2
        }));
      assert_eq(out, Err({ reason: "give up", error: None }));
      // The rollback unwinds through the sandbox, which aborts on its way out, then the
      // transaction's own abort follows.
      assert_eq(cell_get(j), ["begin", "begin", "insert one", "abort", "abort"])
    } with {
      db.begin(level, access) -> {
        cell_set(j, push(cell_get(j), "begin"));
        Count(0)
      },
      db.commit() -> {
        cell_set(j, push(cell_get(j), "commit"));
        Count(0)
      },
      db.abort() -> {
        cell_set(j, push(cell_get(j), "abort"));
        Count(0)
      },
      db.execute[items](s, ps) -> {
        cell_set(j, push(cell_get(j), s.sql));
        Count(1)
      },
      db.rollback(reason) -> panic("a transaction answers its own rollback"),
    }
  }
}

test "is_retryable names the two the server is telling the program to try again" {
  assert(is_retryable({ code: "40001", constraint: "", detail: "" }));
  assert(is_retryable({ code: "40P01", constraint: "", detail: "" }));
  assert(!is_retryable({ code: "23505", constraint: "items_pkey", detail: "" }));
  assert(!is_retryable({ code: "25006", constraint: "", detail: "" }))
}

/// Deeper savepoint nesting is a program that recursed, so it is `Failed` with `54000`.
pub fn max_savepoints() -> Int = 16

// --- The DDL a schema renders to ------------------------------------------------

/// The statements that create a schema's sequences and then its tables, in order.
pub fn create_schema(s: Schema) -> List<Stmt> =
  fold(s.tables, sequence_statements(s), |acc: List<Stmt>, t: Table|
    push(acc, stmt(create_table_sql(t))))

/// The statements that drop a schema's tables, last created first, and then its sequences.
pub fn drop_schema(s: Schema) -> List<Stmt> = {
  let drops = fold(reverse_list(s.tables), [], |acc: List<Stmt>, t: Table|
    push(acc, stmt("drop table if exists " ++ quote_ident(t.name) ++ " cascade")));
  fold(sequence_names(s), drops, |acc: List<Stmt>, n: String|
    push(acc, stmt("drop sequence if exists " ++ quote_ident(n))))
}

fn sequence_statements(s: Schema) -> List<Stmt> =
  fold(sequence_names(s), [], |acc: List<Stmt>, n: String|
    push(acc, stmt("create sequence " ++ quote_ident(n))))

fn sequence_names(s: Schema) -> List<String> =
  fold(s.tables, [], |acc: List<String>, t: Table|
    fold(t.columns, acc, |inner: List<String>, c: Column|
      match c.default { DSequence(n) -> push(inner, n), DNone -> inner, DLiteral(_) -> inner }))

fn create_table_sql(t: Table) -> String = {
  let cols = map(t.columns, |c: Column| column_sql(c));
  let pk = if len(t.primary_key) == 0 { [] }
  else { ["primary key (" ++ comma(map(t.primary_key, |n: String| quote_ident(n))) ++ ")"] };
  let uq = map(t.unique, |u: Unique|
    "constraint " ++ quote_ident(u.name) ++ " unique ("
      ++ comma(map(u.columns, |n: String| quote_ident(n)))
      ++ ")");
  let fks = map(t.foreign_keys, |f: ForeignKey|
    "constraint " ++ quote_ident(f.name) ++ " foreign key ("
      ++ comma(map(f.columns, |n: String| quote_ident(n)))
      ++ ") references "
      ++ quote_ident(f.references)
      ++ " ("
      ++ comma(map(f.refers_to, |n: String| quote_ident(n)))
      ++ ")");
  let cks = map(t.checks, |c: Check|
    "constraint " ++ quote_ident(c.name) ++ " check (" ++ c.expr ++ ")");
  "create table " ++ quote_ident(t.name) ++ " ("
    ++ comma(concat(concat(concat(concat(cols, pk), uq), fks), cks))
    ++ ")"
}

fn column_sql(c: Column) -> String =
  quote_ident(c.name) ++ " " ++ type_sql(c.ty) ++ (if c.nullable { "" } else { " not null" })
    ++ (match c.default {
      DNone -> "",
      DSequence(n) -> " default nextval('" ++ n ++ "')",
      DLiteral(p) -> " default " ++ literal_sql(p),
    })

fn type_sql(t: ColumnType) -> String =
  match t {
    TInt -> "bigint",
    TBool -> "boolean",
    TText -> "text",
    TBytes -> "bytea",
    TFloat -> "double precision",
    TNumeric(p, s) -> "numeric(" ++ int_to_string(p) ++ "," ++ int_to_string(s) ++ ")",
    TJson -> "jsonb",
    TArray(inner) -> type_sql(inner) ++ "[]",
  }

/// Only for a `CREATE TABLE`'s `DEFAULT` clause, never for a value a request supplied.
fn literal_sql(p: Param) -> String =
  match p {
    PNull -> "null",
    PInt(n) -> int_to_string(n),
    PBool(b) -> if b { "true" } else { "false" },
    PText(s) -> "'" ++ string::join(string_split(s, "'"), "''") ++ "'",
    PNumeric(d) -> decimal_to_string(d),
    PFloat(_) -> "null",
    PBytes(_) -> "null",
    PJson(_) -> "null",
    PArray(_) -> "null",
  }

fn quote_ident(s: String) -> String = "\"" ++ string::join(string_split(s, "\""), "\"\"") ++ "\""

fn comma(pieces: List<String>) -> String = string::join(pieces, ", ")

// --- Lists ----------------------------------------------------------------------

fn reverse_list<a>(xs: List<a>) -> List<a> = fold(xs, [], |acc: List<a>, x: a| concat([x], acc))

fn last<a>(xs: List<a>) -> Option<a> = match xs { [] -> None, [h] -> Some(h), [_, ..t] -> last(t) }

// --- The in-memory twin ---------------------------------------------------------

/// A table of the twin and the rows it holds.
pub type MemTable = { def: Table, rows: List<Row> }

/// One entry per open scope: what the scope began with, which a rollback to it restores.
pub type Frame = {
  tables: List<MemTable>,
  failed: Bool,
  level: Isolation,
  access: Access,
  pending: List<pg::Notification>,
}

/// The program's listener in the twin: the channels it listens on, what was delivered to it and not
/// yet taken, and whether its connection was cut, which the next wait answers `Reconnected` for.
pub type MemListener = { channels: List<String>, inbox: List<pg::Notification>, cut: Bool }

/// The in-memory twin of a database: its tables, sequences, the transaction scopes open on it, the
/// notifications the open transaction will deliver when it commits, and the program's listener.
pub type MemDb = {
  tables: List<MemTable>,
  sequences: Map<String, Int>,
  stack: List<Frame>,
  failed: Bool,
  pending: List<pg::Notification>,
  listener: MemListener,
}

/// The twin after an operation, and what the operation answered.
pub type Outcome = { db: MemDb, out: Answer }

/// An empty twin of a schema, every sequence at zero, nothing listened to.
pub fn open(s: Schema) -> MemDb =
  {
    tables: map(s.tables, |t: Table| { def: t, rows: [] }),
    sequences: fold(sequence_names(s), map_new(), |acc: Map<String, Int>, n: String|
      map_insert(acc, n, 0)),
    stack: [],
    failed: false,
    pending: [],
    listener: { channels: [], inbox: [], cut: false },
  }

fn memdb(
  db: MemDb,
  tables: List<MemTable>,
  sequences: Map<String, Int>,
  stack: List<Frame>,
  failed: Bool,
) -> MemDb = { ..db, tables: tables, sequences: sequences, stack: stack, failed: failed }

fn mark_failed(db: MemDb) -> MemDb =
  if len(db.stack) == 0 { db } else { memdb(db, db.tables, db.sequences, db.stack, true) }

fn fail(db: MemDb, e: DbError) -> Outcome = { db: mark_failed(db), out: Failed(e) }

fn done(db: MemDb, a: Answer) -> Outcome = { db: db, out: a }

// --- The SQLSTATEs the twin can produce -----------------------------------------

fn unsupported(what: String) -> DbError = db_error("0A000", "", what)

fn in_failed_txn() -> DbError =
  db_error(
    "25P02",
    "",
    "current transaction is aborted, commands ignored until end of transaction block",
  )

fn undefined_table(n: String) -> DbError =
  db_error("42P01", "", "relation \"" ++ n ++ "\" does not exist")

fn undefined_column(n: String) -> DbError =
  db_error("42703", "", "column \"" ++ n ++ "\" does not exist")

fn read_only_txn(what: String) -> DbError =
  db_error("25006", "", "cannot execute " ++ what ++ " in a read-only transaction")

// --- Tokens ----------------------------------------------------------------------

type Token =
  | TWord(String)  // an unquoted identifier or keyword, folded to lower case
  | TQuoted(String)  // "an identifier", case preserved
  | TStr(String)  // 'a literal'
  | TNum(String)  // 12, or 1.50
  | TParam(Int)  // $1
  | TSym(String)

fn sql_ws() -> Bytes = b" \t\r\n"
fn sql_digits() -> Bytes = b"0123456789"
fn ident_rest() -> Bytes = b"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789$"
fn ident_start() -> Bytes = b"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_"

/// `-1` is the end of the input, which is in no set.
fn in_set(set: Bytes, c: Int) -> Bool / {abort.raise} =
  if c < 0 { false } else { match bytes_index_of_byte(set, c) { Some(_) -> true, None -> false } }

fn lex_all(sql: String) -> Result<List<Token>, DbError> / {abort.raise} = {
  let src = bytes_of_string(sql);
  if !bytes_is_utf8(src) { Err(unsupported("statement text that is not valid UTF-8")) }
  else { lex(src, 0, [], 2 * bytes_len(src) + 2) }
}

/// A token takes a byte at least and two calls at most, so twice the bytes bound the calls: `left`.
reuse fn lex(
  src: Bytes,
  i: Int,
  acc: List<Token>,
  left: Int,
) -> Result<List<Token>, DbError> / {abort.raise} =
  if left <= 0 { panic("more tokens than bytes") } else {
    let j = bytes::scan(src, i, sql_ws());
    let c = peek(src, j);
    if c < 0 { Ok(acc) }
    else if c == 59 { Err(unsupported("more than one statement in one `Stmt`")) }
    else if c == 45 && peek(src, j + 1) == 45 {
      lex(src, line_comment_end(src, j + 2), acc, left - 1)
    } else if c == 47 && peek(src, j + 1) == 42 {
      match block_comment_end(src, j + 2, 1) {
        None -> Err(unsupported("a block comment that is never closed")),
        Some(end) -> lex(src, end, acc, left - 1),
      }
    } else if in_set(ident_start(), c) {
      let end = bytes::scan(src, j, ident_rest());
      lex(
        src,
        end,
        push(acc, TWord(string::ascii_lower(string_of_bytes(bytes_slice(src, j, end))))),
        left - 1,
      )
    } else if in_set(sql_digits(), c) { lex_number(src, j, acc, left - 1) }
    else if c == 39 { lex_string(src, j + 1, b"", acc, left - 1) }
    else if c == 34 { lex_quoted(src, j + 1, b"", acc, left - 1) }
    else if c == 36 { lex_param(src, j, acc, left - 1) }
    else { lex_symbol(src, j, acc, left - 1) }
  }

fn line_comment_end(src: Bytes, i: Int) -> Int =
  if i >= bytes_len(src) || peek(src, i) == 10 { i + 1 } else { line_comment_end(src, i + 1) }

/// Postgres nests block comments, so scanning to the first `*/` would leak an outer comment's tail.
fn block_comment_end(src: Bytes, i: Int, depth: Int) -> Option<Int> =
  if depth == 0 { Some(i) }
  else if i >= bytes_len(src) { None }
  else if peek(src, i) == 47 && peek(src, i + 1) == 42 { block_comment_end(src, i + 2, depth + 1) }
  else if peek(src, i) == 42 && peek(src, i + 1) == 47 { block_comment_end(src, i + 2, depth - 1) }
  else { block_comment_end(src, i + 1, depth) }

reuse fn lex_number(
  src: Bytes,
  i: Int,
  acc: List<Token>,
  left: Int,
) -> Result<List<Token>, DbError> / {abort.raise} =
  if left <= 0 { panic("more tokens than bytes") } else {
    let whole = bytes::scan(src, i, sql_digits());
    let end = if peek(src, whole) == 46 { bytes::scan(src, whole + 1, sql_digits()) }
    else { whole };
    let after = peek(src, end);
    if after == 101 || after == 69 { Err(unsupported("a number in exponent notation")) }
    else if in_set(ident_start(), after) { Err(unsupported("a number followed by a letter")) }
    else { lex(src, end, push(acc, TNum(string_of_bytes(bytes_slice(src, i, end)))), left - 1) }
  }

/// `''` is an escaped quote, which is the only escape a standard-conforming string has.
reuse fn lex_string(
  src: Bytes,
  i: Int,
  so_far: Bytes,
  acc: List<Token>,
  left: Int,
) -> Result<List<Token>, DbError> / {abort.raise} =
  if left <= 0 { panic("more tokens than bytes") } else {
    let stop = if i >= bytes_len(src) { bytes_len(src) }
    else { bytes_scan_until(src, i, b"'", bytes_len(src)) };
    if stop >= bytes_len(src) { Err(unsupported("a string literal with no closing quote")) } else {
      let piece = bytes_concat(so_far, bytes_slice(src, i, stop));
      if peek(src, stop + 1) == 39 {
        lex_string(src, stop + 2, bytes_concat(piece, b"'"), acc, left - 1)
      } else { lex(src, stop + 1, push(acc, TStr(string_of_bytes(piece))), left - 1) }
    }
  }

reuse fn lex_quoted(
  src: Bytes,
  i: Int,
  so_far: Bytes,
  acc: List<Token>,
  left: Int,
) -> Result<List<Token>, DbError> / {abort.raise} =
  if left <= 0 { panic("more tokens than bytes") } else {
    let stop = if i >= bytes_len(src) { bytes_len(src) }
    else { bytes_scan_until(src, i, b"\"", bytes_len(src)) };
    if stop >= bytes_len(src) { Err(unsupported("a quoted identifier with no closing quote")) }
    else {
      let piece = bytes_concat(so_far, bytes_slice(src, i, stop));
      if peek(src, stop + 1) == 34 {
        lex_quoted(src, stop + 2, bytes_concat(piece, b"\""), acc, left - 1)
      } else { lex(src, stop + 1, push(acc, TQuoted(string_of_bytes(piece))), left - 1) }
    }
  }

reuse fn lex_param(
  src: Bytes,
  i: Int,
  acc: List<Token>,
  left: Int,
) -> Result<List<Token>, DbError> / {abort.raise} =
  if left <= 0 { panic("more tokens than bytes") } else {
    let end = bytes::scan(src, i + 1, sql_digits());
    if end == i + 1 { Err(unsupported("a dollar-quoted string, or a `$` that is not a parameter")) }
    else {
      match string::int_of_string(string_of_bytes(bytes_slice(src, i + 1, end))) {
        None -> Err(unsupported("a parameter number too large to read")),
        Some(n) -> lex(src, end, push(acc, TParam(n)), left - 1),
      }
    }
  }

reuse fn lex_symbol(
  src: Bytes,
  i: Int,
  acc: List<Token>,
  left: Int,
) -> Result<List<Token>, DbError> / {abort.raise} =
  if left <= 0 { panic("more tokens than bytes") } else {
    let c = peek(src, i);
    let d = peek(src, i + 1);
    let two = if (c == 60 && d == 62) || (c == 33 && d == 61) { "<>" }
    else if c == 60 && d == 61 { "<=" }
    else if c == 62 && d == 61 { ">=" }
    else { "" };
    if two != "" { lex(src, i + 2, push(acc, TSym(two)), left - 1) }
    else if c == 40 || c == 41 || c == 44 || c == 42 || c == 61 || c == 60 || c == 62 || c == 46
        || c == 45
        || c == 43 {
      lex(src, i + 1, push(acc, TSym(string_of_bytes(bytes_slice(src, i, i + 1)))), left - 1)
    } else {
      Err(
        unsupported(
          "the token `" ++ string_of_bytes_lossy(bytes_slice(src, i, i + 1)) ++ "` at byte "
            ++ int_to_string(i),
        ),
      )
    }
  }

// --- The statement, as the twin understands it -----------------------------------

/// One item of a select list: the column it reads and the name it comes back under.
type Target = { column: String, name: String }

type Projection = | PStar | PCols(List<Target>) | PCount(String)

type Comparison = | CmpEq | CmpNe | CmpLt | CmpLe | CmpGt | CmpGe

type Expr =
  | XCol(String)
  | XParam(Int)
  | XLit(Datum)
  | XDefault
  | XNot(Expr)
  | XAnd(Expr, Expr)
  | XOr(Expr, Expr)
  | XCompare(Comparison, Expr, Expr)
  | XIsNull(Expr, Bool)
  | XIn(Expr, List<Expr>, Bool)
  | XBetween(Expr, Expr, Expr, Bool)
  | XLike(Expr, Expr, Bool)

type OrderKey = { column: String, desc: Bool, nulls_first: Bool }

type SelectQ = {
  source: String,
  proj: Projection,
  filter: Option<Expr>,
  order: List<OrderKey>,
  limit: Option<Expr>,
  offset: Option<Expr>,
}

type InsertQ = {
  source: String,
  columns: List<String>,
  tuples: List<List<Expr>>,
  returning: Option<Projection>,
}

type Assign = { column: String, value: Expr }

type UpdateQ = {
  source: String,
  sets: List<Assign>,
  filter: Option<Expr>,
  returning: Option<Projection>,
}

type DeleteQ = { source: String, filter: Option<Expr>, returning: Option<Projection> }

type Query = | QSelect(SelectQ) | QInsert(InsertQ) | QUpdate(UpdateQ) | QDelete(DeleteQ)

type Parsed<a> = { value: a, rest: List<Token> }

fn parsed<a>(v: a, rest: List<Token>) -> Parsed<a> = { value: v, rest: rest }

fn token_word(ts: List<Token>) -> String = match ts { [TWord(w), ..] -> w, _ -> "" }

fn token_symbol(ts: List<Token>) -> String = match ts { [TSym(s), ..] -> s, _ -> "" }

fn rest_of(ts: List<Token>) -> List<Token> = match ts { [] -> [], [_, ..t] -> t }

fn expected(what: String, ts: List<Token>) -> DbError =
  unsupported("expected " ++ what ++ ", found " ++ show_tok(ts))

fn show_tok(ts: List<Token>) -> String =
  match ts {
    [] -> "the end of the statement",
    [TWord(w), ..] -> "`" ++ w ++ "`",
    [TQuoted(w), ..] -> "`\"" ++ w ++ "\"`",
    [TStr(_), ..] -> "a string literal",
    [TNum(n), ..] -> "`" ++ n ++ "`",
    [TParam(n), ..] -> "`$" ++ int_to_string(n) ++ "`",
    [TSym(s), ..] -> "`" ++ s ++ "`",
    // Unreachable: the six above are every constructor.
    _ -> "a token",
  }

fn want_word(ts: List<Token>, w: String) -> Result<List<Token>, DbError> =
  if token_word(ts) == w { Ok(rest_of(ts)) } else { Err(expected("`" ++ w ++ "`", ts)) }

fn want_sym(ts: List<Token>, s: String) -> Result<List<Token>, DbError> =
  if token_symbol(ts) == s { Ok(rest_of(ts)) } else { Err(expected("`" ++ s ++ "`", ts)) }

fn parse_name(ts: List<Token>) -> Result<Parsed<String>, DbError> =
  match ts {
    [TWord(w), ..t] -> Ok(parsed(w, t)),
    [TQuoted(w), ..t] -> Ok(parsed(w, t)),
    _ -> Err(expected("a name", ts)),
  }

/// `t.c` names the column `c`.
fn parse_colref(ts: List<Token>) -> Result<Parsed<String>, DbError> = {
  let c = parse_name(ts)?;
  if token_symbol(c.rest) == "." { parse_name(rest_of(c.rest)) } else { Ok(c) }
}

/// Every cycle through the expression parser takes a token, so a path meets each of its eleven
/// functions once per token at most: the room each starts with.
fn expr_room(ts: List<Token>) -> Int = (len(ts) + 1) * 11

fn parse_expr_text(s: String) -> Result<Expr, DbError> / {abort.raise} = {
  let ts = lex_all(s)?;
  let c = parse_or(ts, expr_room(ts))?;
  if len(c.rest) == 0 { Ok(c.value) } else { Err(expected("the end of the expression", c.rest)) }
}

fn parse_or(ts: List<Token>, left: Int) -> Result<Parsed<Expr>, DbError> / {abort.raise} =
  if left <= 0 { panic("more calls than tokens allow") }
  else { parse_or_more(parse_and(ts, left - 1)?, left - 1) }

fn parse_or_more(c: Parsed<Expr>, left: Int) -> Result<Parsed<Expr>, DbError> / {abort.raise} =
  if left <= 0 { panic("more calls than tokens allow") } else {
    if token_word(c.rest) == "or" {
      let r = parse_and(rest_of(c.rest), left - 1)?;
      parse_or_more(parsed(XOr(c.value, r.value), r.rest), left - 1)
    } else { Ok(c) }
  }

fn parse_and(ts: List<Token>, left: Int) -> Result<Parsed<Expr>, DbError> / {abort.raise} =
  if left <= 0 { panic("more calls than tokens allow") }
  else { parse_and_more(parse_not(ts, left - 1)?, left - 1) }

fn parse_and_more(c: Parsed<Expr>, left: Int) -> Result<Parsed<Expr>, DbError> / {abort.raise} =
  if left <= 0 { panic("more calls than tokens allow") } else {
    if token_word(c.rest) == "and" {
      let r = parse_not(rest_of(c.rest), left - 1)?;
      parse_and_more(parsed(XAnd(c.value, r.value), r.rest), left - 1)
    } else { Ok(c) }
  }

fn parse_not(ts: List<Token>, left: Int) -> Result<Parsed<Expr>, DbError> / {abort.raise} =
  if left <= 0 { panic("more calls than tokens allow") } else {
    if token_word(ts) == "not" {
      let c = parse_not(rest_of(ts), left - 1)?;
      Ok(parsed(XNot(c.value), c.rest))
    } else { parse_pred_tail(parse_primary(ts, left - 1)?, left - 1) }
  }

fn parse_pred_tail(c: Parsed<Expr>, left: Int) -> Result<Parsed<Expr>, DbError> / {abort.raise} =
  if left <= 0 { panic("more calls than tokens allow") } else {
    let w = token_word(c.rest);
    let s = token_symbol(c.rest);
    if s == "=" || s == "<>" || s == "<" || s == "<=" || s == ">" || s == ">=" {
      let r = parse_primary(rest_of(c.rest), left - 1)?;
      Ok(parsed(XCompare(comparison_of(s), c.value, r.value), r.rest))
    } else if w == "is" { parse_is(c, rest_of(c.rest)) }
    else if w == "in" { parse_in(c, false, rest_of(c.rest), left - 1) }
    else if w == "between" { parse_between(c, false, rest_of(c.rest), left - 1) }
    else if w == "like" { parse_like(c, false, rest_of(c.rest), left - 1) } else if w == "not" {
      let after = rest_of(c.rest);
      let w2 = token_word(after);
      if w2 == "in" { parse_in(c, true, rest_of(after), left - 1) }
      else if w2 == "between" { parse_between(c, true, rest_of(after), left - 1) }
      else if w2 == "like" { parse_like(c, true, rest_of(after), left - 1) }
      else { Err(expected("`in`, `between` or `like` after `not`", after)) }
    } else { Ok(c) }
  }

fn comparison_of(s: String) -> Comparison =
  if s == "=" { CmpEq }
  else if s == "<>" { CmpNe }
  else if s == "<" { CmpLt }
  else if s == "<=" { CmpLe }
  else if s == ">" { CmpGt }
  else { CmpGe }

fn parse_is(c: Parsed<Expr>, ts: List<Token>) -> Result<Parsed<Expr>, DbError> =
  if token_word(ts) == "null" { Ok(parsed(XIsNull(c.value, true), rest_of(ts))) }
  else if token_word(ts) == "not" && token_word(rest_of(ts)) == "null" {
    Ok(parsed(XIsNull(c.value, false), rest_of(rest_of(ts))))
  } else { Err(expected("`null` or `not null` after `is`", ts)) }

fn parse_in(
  c: Parsed<Expr>,
  negated: Bool,
  ts: List<Token>,
  left: Int,
) -> Result<Parsed<Expr>, DbError> / {abort.raise} =
  if left <= 0 { panic("more calls than tokens allow") } else {
    let after = want_sym(ts, "(")?;
    let items = parse_expr_list(after, [], left - 1)?;
    Ok(parsed(XIn(c.value, items.value, negated), items.rest))
  }

fn parse_expr_list(
  ts: List<Token>,
  acc: List<Expr>,
  left: Int,
) -> Result<Parsed<List<Expr>>, DbError> / {abort.raise} =
  if left <= 0 { panic("more calls than tokens allow") } else {
    let c = parse_or(ts, left - 1)?;
    let items = push(acc, c.value);
    if token_symbol(c.rest) == "," { parse_expr_list(rest_of(c.rest), items, left - 1) } else {
      let after = want_sym(c.rest, ")")?;
      Ok(parsed(items, after))
    }
  }

fn parse_between(
  c: Parsed<Expr>,
  negated: Bool,
  ts: List<Token>,
  left: Int,
) -> Result<Parsed<Expr>, DbError> / {abort.raise} =
  if left <= 0 { panic("more calls than tokens allow") } else {
    let lo = parse_primary(ts, left - 1)?;
    let after = want_word(lo.rest, "and")?;
    let hi = parse_primary(after, left - 1)?;
    Ok(parsed(XBetween(c.value, lo.value, hi.value, negated), hi.rest))
  }

fn parse_like(
  c: Parsed<Expr>,
  negated: Bool,
  ts: List<Token>,
  left: Int,
) -> Result<Parsed<Expr>, DbError> / {abort.raise} =
  if left <= 0 { panic("more calls than tokens allow") } else {
    let p = parse_primary(ts, left - 1)?;
    if token_word(p.rest) == "escape" { Err(unsupported("`like ... escape`")) }
    else { Ok(parsed(XLike(c.value, p.value, negated), p.rest)) }
  }

fn parse_primary(ts: List<Token>, left: Int) -> Result<Parsed<Expr>, DbError> / {abort.raise} =
  if left <= 0 { panic("more calls than tokens allow") } else {
    match ts {
      [] -> Err(unsupported("the statement ended where a value was expected")),
      [TParam(n), ..t] -> Ok(parsed(XParam(n), t)),
      [TStr(s), ..t] -> Ok(parsed(XLit(CText(s)), t)),
      [TNum(s), ..t] -> num_literal(s, false, t),
      [TQuoted(w), ..t] -> parse_column_tail(w, t),
      [TSym(s), ..t] -> if s == "(" {
        let c = parse_or(t, left - 1)?;
        let after = want_sym(c.rest, ")")?;
        Ok(parsed(c.value, after))
      } else if s == "-" {
        match t {
          [TNum(n), ..t2] -> num_literal(n, true, t2),
          _ -> Err(expected("a number after `-`", t)),
        }
      } else { Err(expected("a value", ts)) },
      [TWord(w), ..t] -> if w == "null" { Ok(parsed(XLit(CNull), t)) }
      else if w == "true" { Ok(parsed(XLit(CBool(true)), t)) }
      else if w == "false" { Ok(parsed(XLit(CBool(false)), t)) }
      else if w == "default" { Ok(parsed(XDefault, t)) }
      else if w == "count" || w == "sum" || w == "avg" || w == "min" || w == "max" {
        Err(unsupported("the aggregate `" ++ w ++ "` outside a bare `count(*)` projection"))
      } else if w == "select" { Err(unsupported("a subquery")) }
      else { parse_column_tail(w, t) },
      _ -> Err(expected("a value", ts)),
    }
  }

fn parse_column_tail(name: String, ts: List<Token>) -> Result<Parsed<Expr>, DbError> =
  if token_symbol(ts) == "." {
    let c = parse_name(rest_of(ts))?;
    Ok(parsed(XCol(c.value), c.rest))
  } else if token_symbol(ts) == "(" { Err(unsupported("the function `" ++ name ++ "`")) }
  else { Ok(parsed(XCol(name), ts)) }

/// A literal with a `.` is `numeric` and one without is `integer`, as in postgres.
fn num_literal(
  s: String,
  negative: Bool,
  ts: List<Token>,
) -> Result<Parsed<Expr>, DbError> / {abort.raise} = {
  let text = if negative { "-" ++ s } else { s };
  if string_contains(s, ".") {
    match decimal_of_string(text) {
      None -> Err(unsupported("the numeric literal `" ++ text ++ "`")),
      Some(d) -> Ok(parsed(XLit(CNumeric(d)), ts)),
    }
  } else {
    match string::int_of_string(text) {
      None -> Err(unsupported("the integer literal `" ++ text ++ "`")),
      Some(n) -> Ok(parsed(XLit(CInt(n)), ts)),
    }
  }
}

// --- The statement parser --------------------------------------------------------

fn parse_statement(sql: String) -> Result<Query, DbError> / {abort.raise} = {
  let ts = lex_all(sql)?;
  let c = parse_query(ts)?;
  if len(c.rest) == 0 { Ok(c.value) } else { Err(expected("the end of the statement", c.rest)) }
}

fn parse_query(ts: List<Token>) -> Result<Parsed<Query>, DbError> / {abort.raise} = {
  let w = token_word(ts);
  if w == "select" { parse_select(rest_of(ts)) }
  else if w == "insert" { parse_insert(rest_of(ts)) }
  else if w == "update" { parse_update(rest_of(ts)) }
  else if w == "delete" { parse_delete(rest_of(ts)) }
  else if w == "with" { Err(unsupported("a common table expression")) }
  else if w == "values" { Err(unsupported("a bare `values` statement")) }
  else { Err(expected("`select`, `insert`, `update` or `delete`", ts)) }
}

fn parse_select(ts: List<Token>) -> Result<Parsed<Query>, DbError> / {abort.raise} = {
  let p = parse_proj(ts)?;
  let after = want_word(p.rest, "from")?;
  let src = parse_name(after)?;
  parse_select_tail(src.value, p.value, src.rest)
}

fn parse_select_tail(
  source: String,
  proj: Projection,
  ts: List<Token>,
) -> Result<Parsed<Query>, DbError> / {abort.raise} = {
  let w = parse_where(ts)?;
  let o = parse_order(w.rest)?;
  let lo = parse_limit_offset(o.rest)?;
  Ok(
    parsed(
      QSelect({
        source: source,
        proj: proj,
        filter: w.value,
        order: o.value,
        limit: lo.value.limit,
        offset: lo.value.offset,
      }),
      lo.rest,
    ),
  )
}

fn parse_proj(ts: List<Token>) -> Result<Parsed<Projection>, DbError> =
  if token_symbol(ts) == "*" { Ok(parsed(PStar, rest_of(ts))) } else if token_word(ts) == "count" {
    let a = want_sym(rest_of(ts), "(")?;
    match want_sym(a, "*") {
      Err(_) -> Err(unsupported("`count` of anything but `*`")),
      Ok(b) -> {
        let c = want_sym(b, ")")?;
        let a = parse_alias(c, "count")?;
        Ok(parsed(PCount(a.value), a.rest))
      },
    }
  } else { parse_proj_columns(ts, [], len(ts) + 1) }

/// `left` bounds the items: each but the last takes its comma.
fn parse_proj_columns(
  ts: List<Token>,
  acc: List<Target>,
  left: Int,
) -> Result<Parsed<Projection>, DbError> =
  if left <= 0 { Err(db_error("XX000", "", "more items than tokens")) } else {
    let c = parse_colref(ts)?;
    let a = parse_alias(c.rest, c.value)?;
    let targets = push(acc, { column: c.value, name: a.value });
    if token_symbol(a.rest) == "," { parse_proj_columns(rest_of(a.rest), targets, left - 1) }
    else { Ok(parsed(PCols(targets), a.rest)) }
  }

fn parse_alias(ts: List<Token>, dflt: String) -> Result<Parsed<String>, DbError> =
  if token_word(ts) == "as" {
    let n = parse_name(rest_of(ts))?;
    Ok(parsed(n.value, n.rest))
  } else { Ok(parsed(dflt, ts)) }

fn parse_where(ts: List<Token>) -> Result<Parsed<Option<Expr>>, DbError> / {abort.raise} =
  if token_word(ts) == "where" {
    let c = parse_or(rest_of(ts), expr_room(ts))?;
    Ok(parsed(Some(c.value), c.rest))
  } else { Ok(parsed(None, ts)) }

fn parse_order(ts: List<Token>) -> Result<Parsed<List<OrderKey>>, DbError> =
  if token_word(ts) == "order" {
    let after = want_word(rest_of(ts), "by")?;
    parse_order_keys(after, [], len(after) + 1)
  } else { Ok(parsed([], ts)) }

/// `left` bounds the items: each but the last takes its comma.
fn parse_order_keys(
  ts: List<Token>,
  acc: List<OrderKey>,
  left: Int,
) -> Result<Parsed<List<OrderKey>>, DbError> =
  if left <= 0 { Err(db_error("XX000", "", "more items than tokens")) } else {
    let c = parse_colref(ts)?;
    let dir = token_word(c.rest);
    let desc = dir == "desc";
    let after_dir = if dir == "asc" || dir == "desc" { rest_of(c.rest) } else { c.rest };
    {
      let n = parse_nulls(after_dir, desc)?;
      let keys = push(acc, { column: c.value, desc: desc, nulls_first: n.value });
      if token_symbol(n.rest) == "," { parse_order_keys(rest_of(n.rest), keys, left - 1) }
      else { Ok(parsed(keys, n.rest)) }
    }
  }

/// Postgres's default is `NULLS LAST` under `ASC` and `NULLS FIRST` under `DESC`.
fn parse_nulls(ts: List<Token>, desc: Bool) -> Result<Parsed<Bool>, DbError> =
  if token_word(ts) == "nulls" {
    let w = token_word(rest_of(ts));
    if w == "first" { Ok(parsed(true, rest_of(rest_of(ts)))) }
    else if w == "last" { Ok(parsed(false, rest_of(rest_of(ts)))) }
    else { Err(expected("`first` or `last` after `nulls`", rest_of(ts))) }
  } else { Ok(parsed(desc, ts)) }

type Slice = { limit: Option<Expr>, offset: Option<Expr> }

fn parse_limit_offset(ts: List<Token>) -> Result<Parsed<Slice>, DbError> / {abort.raise} = {
  let l = parse_one_bound(ts, "limit")?;
  let o = parse_one_bound(l.rest, "offset")?;
  Ok(parsed({ limit: l.value, offset: o.value }, o.rest))
}

fn parse_one_bound(
  ts: List<Token>,
  word: String,
) -> Result<Parsed<Option<Expr>>, DbError> / {abort.raise} =
  if token_word(ts) == word {
    let c = parse_primary(rest_of(ts), expr_room(ts))?;
    Ok(parsed(Some(c.value), c.rest))
  } else { Ok(parsed(None, ts)) }

fn parse_insert(ts: List<Token>) -> Result<Parsed<Query>, DbError> / {abort.raise} = {
  let a = want_word(ts, "into")?;
  let src = parse_name(a)?;
  let cols = parse_insert_columns(src.rest)?;
  match want_word(cols.rest, "values") {
    Err(_) -> Err(unsupported("an `insert` whose source is not a `values` list")),
    Ok(b) -> {
      let tuples = parse_tuples(b, [], len(b) + 1)?;
      let r = parse_returning(tuples.rest)?;
      Ok(
        parsed(
          QInsert({
            source: src.value,
            columns: cols.value,
            tuples: tuples.value,
            returning: r.value,
          }),
          r.rest,
        ),
      )
    },
  }
}

fn parse_insert_columns(ts: List<Token>) -> Result<Parsed<List<String>>, DbError> =
  if token_symbol(ts) == "(" { parse_name_list(rest_of(ts), [], len(ts) + 1) }
  else { Ok(parsed([], ts)) }

/// `left` bounds the items: each but the last takes its comma.
fn parse_name_list(
  ts: List<Token>,
  acc: List<String>,
  left: Int,
) -> Result<Parsed<List<String>>, DbError> =
  if left <= 0 { Err(db_error("XX000", "", "more items than tokens")) } else {
    let c = parse_name(ts)?;
    let names = push(acc, c.value);
    if token_symbol(c.rest) == "," { parse_name_list(rest_of(c.rest), names, left - 1) } else {
      let after = want_sym(c.rest, ")")?;
      Ok(parsed(names, after))
    }
  }

/// `left` bounds the items: each but the last takes its comma.
fn parse_tuples(
  ts: List<Token>,
  acc: List<List<Expr>>,
  left: Int,
) -> Result<Parsed<List<List<Expr>>>, DbError> / {abort.raise} =
  if left <= 0 { panic("more items than tokens") } else {
    let a = want_sym(ts, "(")?;
    let c = parse_expr_list(a, [], expr_room(a))?;
    let tuples = push(acc, c.value);
    if token_symbol(c.rest) == "," { parse_tuples(rest_of(c.rest), tuples, left - 1) }
    else { Ok(parsed(tuples, c.rest)) }
  }

fn parse_returning(ts: List<Token>) -> Result<Parsed<Option<Projection>>, DbError> =
  if token_word(ts) == "returning" {
    let c = parse_proj(rest_of(ts))?;
    match c.value {
      PCount(_) -> Err(unsupported("`returning count(*)`")),
      PStar -> Ok(parsed(Some(c.value), c.rest)),
      PCols(_) -> Ok(parsed(Some(c.value), c.rest)),
    }
  } else { Ok(parsed(None, ts)) }

fn parse_update(ts: List<Token>) -> Result<Parsed<Query>, DbError> / {abort.raise} = {
  let src = parse_name(ts)?;
  let a = want_word(src.rest, "set")?;
  let sets = parse_assignments(a, [], len(a) + 1)?;
  if token_word(sets.rest) == "from" { Err(unsupported("`update ... from`")) } else {
    let w = parse_where(sets.rest)?;
    let r = parse_returning(w.rest)?;
    Ok(
      parsed(
        QUpdate({ source: src.value, sets: sets.value, filter: w.value, returning: r.value }),
        r.rest,
      ),
    )
  }
}

/// `left` bounds the items: each but the last takes its comma.
fn parse_assignments(
  ts: List<Token>,
  acc: List<Assign>,
  left: Int,
) -> Result<Parsed<List<Assign>>, DbError> / {abort.raise} =
  if left <= 0 { panic("more items than tokens") } else {
    let n = parse_name(ts)?;
    let a = want_sym(n.rest, "=")?;
    let v = parse_primary(a, expr_room(a))?;
    let sets = push(acc, { column: n.value, value: v.value });
    if token_symbol(v.rest) == "," { parse_assignments(rest_of(v.rest), sets, left - 1) }
    else { Ok(parsed(sets, v.rest)) }
  }

fn parse_delete(ts: List<Token>) -> Result<Parsed<Query>, DbError> / {abort.raise} = {
  let a = want_word(ts, "from")?;
  let src = parse_name(a)?;
  if token_word(src.rest) == "using" { Err(unsupported("`delete ... using`")) } else {
    let w = parse_where(src.rest)?;
    let r = parse_returning(w.rest)?;
    Ok(parsed(QDelete({ source: src.value, filter: w.value, returning: r.value }), r.rest))
  }
}

// --- Evaluating an expression ----------------------------------------------------

type Tri = | TriTrue | TriFalse | TriUnknown

fn tri_of(b: Bool) -> Tri = if b { TriTrue } else { TriFalse }

fn is_null(v: Datum) -> Bool = match v { CNull -> true, _ -> false }

fn tri_not(t: Tri) -> Tri =
  match t { TriTrue -> TriFalse, TriFalse -> TriTrue, TriUnknown -> TriUnknown }

fn tri_and(a: Tri, b: Tri) -> Tri =
  match a {
    TriFalse -> TriFalse,
    TriTrue -> b,
    TriUnknown -> match b { TriFalse -> TriFalse, _ -> TriUnknown },
  }

fn tri_or(a: Tri, b: Tri) -> Tri =
  match a {
    TriTrue -> TriTrue,
    TriFalse -> b,
    TriUnknown -> match b { TriTrue -> TriTrue, _ -> TriUnknown },
  }

/// The value a parameter stores as.
pub fn param_datum(p: Param) -> Datum =
  match p {
    PNull -> CNull,
    PInt(n) -> CInt(n),
    PBool(b) -> CBool(b),
    PText(s) -> CText(s),
    PBytes(b) -> CBytes(b),
    PFloat(f) -> CFloat(f),
    PNumeric(d) -> CNumeric(d),
    PJson(j) -> CJson(j),
    PArray(xs) -> CArray(map(xs, |x: Param| param_datum(x))),
  }

fn eval_value(row: Row, ps: List<Param>, e: Expr) -> Result<Datum, DbError> / {abort.raise} =
  match e {
    XNot(_) -> eval_bool_value(row, ps, e),
    XAnd(_, _) -> eval_bool_value(row, ps, e),
    XOr(_, _) -> eval_bool_value(row, ps, e),
    XCompare(_, _, _) -> eval_bool_value(row, ps, e),
    XIsNull(_, _) -> eval_bool_value(row, ps, e),
    XIn(_, _, _) -> eval_bool_value(row, ps, e),
    XBetween(_, _, _, _) -> eval_bool_value(row, ps, e),
    XLike(_, _, _) -> eval_bool_value(row, ps, e),
    _ -> leaf_value(row, ps, e),
  }

/// What a literal, a column or a parameter is; the rest are predicates.
fn leaf_value(r: Row, ps: List<Param>, e: Expr) -> Result<Datum, DbError> / {abort.raise} =
  match e {
    XLit(v) -> Ok(v),
    XCol(n) -> match map_get(r, n) { None -> Err(undefined_column(n)), Some(v) -> Ok(v) },
    XParam(n) -> match list_at(ps, n - 1) {
      None -> Err(db_error("42P02", "", "there is no parameter $" ++ int_to_string(n))),
      Some(p) -> Ok(param_datum(p)),
    },
    XDefault -> Err(unsupported("`default` outside an `insert ... values` list")),
    _ -> panic("a predicate is no leaf"),
  }

fn eval_bool_value(row: Row, ps: List<Param>, e: Expr) -> Result<Datum, DbError> / {abort.raise} = {
  let t = eval_pred(row, ps, e)?;
  Ok(match t { TriTrue -> CBool(true), TriFalse -> CBool(false), TriUnknown -> CNull })
}

fn eval_pred(row: Row, ps: List<Param>, e: Expr) -> Result<Tri, DbError> / {abort.raise} =
  match e {
    XNot(x) -> {
      let t = eval_pred(row, ps, x)?;
      Ok(tri_not(t))
    },
    XAnd(a, b) -> {
      let ta = eval_pred(row, ps, a)?;
      let tb = eval_pred(row, ps, b)?;
      Ok(tri_and(ta, tb))
    },
    XOr(a, b) -> {
      let ta = eval_pred(row, ps, a)?;
      let tb = eval_pred(row, ps, b)?;
      Ok(tri_or(ta, tb))
    },
    XCompare(op, a, b) -> eval_compare(row, ps, op, a, b),
    XIsNull(x, want) -> {
      let v = eval_value(row, ps, x)?;
      Ok(tri_of(if want { is_null(v) } else { !is_null(v) }))
    },
    XIn(x, items, negated) -> eval_in(row, ps, x, items, negated),
    XBetween(x, lo, hi, negated) -> eval_between(row, ps, x, lo, hi, negated),
    XLike(x, p, negated) -> eval_like(row, ps, x, p, negated),
    XLit(_) -> eval_pred_of_value(row, ps, e),
    XCol(_) -> eval_pred_of_value(row, ps, e),
    XParam(_) -> eval_pred_of_value(row, ps, e),
    XDefault -> Err(unsupported("`default` in a predicate")),
  }

fn eval_pred_of_value(row: Row, ps: List<Param>, e: Expr) -> Result<Tri, DbError> / {abort.raise} = {
  let v = leaf_value(row, ps, e)?;
  match v {
    CNull -> Ok(TriUnknown),
    CBool(b) -> Ok(tri_of(b)),
    _ ->
      Err(db_error("42804", "", "argument of a condition must be boolean, not " ++ datum_type(v))),
  }
}

fn eval_compare(
  row: Row,
  ps: List<Param>,
  op: Comparison,
  a: Expr,
  b: Expr,
) -> Result<Tri, DbError> / {abort.raise} = {
  let av = eval_value(row, ps, a)?;
  let bv = eval_value(row, ps, b)?;
  let o = datum_cmp(av, bv)?;
  match o {
    None -> Ok(TriUnknown),
    Some(c) ->
      Ok(
        tri_of(match op {
          CmpEq -> c == 0,
          CmpNe -> c != 0,
          CmpLt -> c < 0,
          CmpLe -> c <= 0,
          CmpGt -> c > 0,
          CmpGe -> c >= 0,
        }),
      ),
  }
}

fn eval_in(
  row: Row,
  ps: List<Param>,
  x: Expr,
  items: List<Expr>,
  negated: Bool,
) -> Result<Tri, DbError> / {abort.raise} = {
  let v = eval_value(row, ps, x)?;
  let t = in_scan(row, ps, v, items, TriFalse)?;
  Ok(if negated { tri_not(t) } else { t })
}

fn in_scan(
  row: Row,
  ps: List<Param>,
  v: Datum,
  items: List<Expr>,
  so_far: Tri,
) -> Result<Tri, DbError> / {abort.raise} =
  match items {
    [] -> Ok(so_far),
    [h, ..t] -> {
      let hv = eval_value(row, ps, h)?;
      let o = datum_cmp(v, hv)?;
      match o {
        None -> in_scan(row, ps, v, t, tri_or(so_far, TriUnknown)),
        Some(c) -> if c == 0 { Ok(TriTrue) } else { in_scan(row, ps, v, t, so_far) },
      }
    },
  }

fn eval_between(
  row: Row,
  ps: List<Param>,
  x: Expr,
  lo: Expr,
  hi: Expr,
  negated: Bool,
) -> Result<Tri, DbError> / {abort.raise} = {
  let a = eval_compare(row, ps, CmpGe, x, lo)?;
  let b = eval_compare(row, ps, CmpLe, x, hi)?;
  Ok(if negated { tri_not(tri_and(a, b)) } else { tri_and(a, b) })
}

fn eval_like(
  row: Row,
  ps: List<Param>,
  x: Expr,
  p: Expr,
  negated: Bool,
) -> Result<Tri, DbError> / {abort.raise} = {
  let xv = eval_value(row, ps, x)?;
  let pv = eval_value(row, ps, p)?;
  like_of(xv, pv, negated)
}

fn like_of(xv: Datum, pv: Datum, negated: Bool) -> Result<Tri, DbError> / {abort.raise} =
  match xv {
    CNull -> Ok(TriUnknown),
    CText(s) -> match pv {
      CNull -> Ok(TriUnknown),
      CText(p) -> {
        let hit = like_match(s, p, 0, 0);
        Ok(tri_of(if negated { !hit } else { hit }))
      },
      _ -> Err(db_error("42883", "", "operator does not exist: text like " ++ datum_type(pv))),
    },
    _ -> Err(db_error("42883", "", "operator does not exist: " ++ datum_type(xv) ++ " like ...")),
  }

/// `_` matches one character, not one byte, or non-ASCII text stops matching.
fn like_match(s: String, p: String, si: Int, pi: Int) -> Bool / {abort.raise} =
  if pi >= string_len(p) { si >= string_len(s) } else {
    let pc = string_slice(p, pi, pi + 1);
    if pc == "%" { like_star(s, p, si, pi + 1) }
    else if pc == "_" { if si >= string_len(s) { false } else { like_match(s, p, si + 1, pi + 1) } }
    else if pc == "\\" {
      if pi + 1 >= string_len(p) { false }
      else if si < string_len(s) && string_slice(s, si, si + 1) == string_slice(p, pi + 1, pi + 2) {
        like_match(s, p, si + 1, pi + 2)
      } else { false }
    } else if si < string_len(s) && string_slice(s, si, si + 1) == pc {
      like_match(s, p, si + 1, pi + 1)
    } else { false }
  }

fn like_star(s: String, p: String, si: Int, pi: Int) -> Bool / {abort.raise} =
  if like_match(s, p, si, pi) { true }
  else if si >= string_len(s) { false }
  else { like_star(s, p, si + 1, pi) }

fn ord_int(o: Ordering) -> Int = match o { Less -> -1, Equal -> 0, Greater -> 1 }

fn sign_of(a: Int, b: Int) -> Int = if a < b { -1 } else if a > b { 1 } else { 0 }

fn float_cmp(a: Float, b: Float) -> Int =
  if a != a { if b != b { 0 } else { 1 } }
  else if b != b { -1 }
  else if a < b { -1 }
  else if a > b { 1 }
  else { 0 }

fn decimal_cmp(a: Decimal, b: Decimal) -> Int = if a < b { -1 } else if a > b { 1 } else { 0 }

/// `None` is SQL's unknown: a comparison with a `NULL` operand has no answer.
fn datum_cmp(a: Datum, b: Datum) -> Result<Option<Int>, DbError> =
  match a {
    CNull -> Ok(None),
    CInt(x) -> match b {
      CNull -> Ok(None),
      CInt(y) -> Ok(Some(sign_of(x, y))),
      CNumeric(y) -> Ok(Some(decimal_cmp(decimal_of_int(x), y))),
      CFloat(y) -> Ok(Some(float_cmp(float_of_decimal(decimal_of_int(x)), y))),
      _ -> Err(no_operator(a, b)),
    },
    CNumeric(x) -> match b {
      CNull -> Ok(None),
      CNumeric(y) -> Ok(Some(decimal_cmp(x, y))),
      CInt(y) -> Ok(Some(decimal_cmp(x, decimal_of_int(y)))),
      CFloat(y) -> Ok(Some(float_cmp(float_of_decimal(x), y))),
      _ -> Err(no_operator(a, b)),
    },
    CFloat(x) -> match b {
      CNull -> Ok(None),
      CFloat(y) -> Ok(Some(float_cmp(x, y))),
      CInt(y) -> Ok(Some(float_cmp(x, float_of_decimal(decimal_of_int(y))))),
      CNumeric(y) -> Ok(Some(float_cmp(x, float_of_decimal(y)))),
      _ -> Err(no_operator(a, b)),
    },
    CText(x) -> match b {
      CNull -> Ok(None),
      CText(y) -> Ok(Some(ord_int(compare(x, y)))),
      _ -> Err(no_operator(a, b)),
    },
    CBool(x) -> match b {
      CNull -> Ok(None),
      CBool(y) -> Ok(Some(sign_of(if x { 1 } else { 0 }, if y { 1 } else { 0 }))),
      _ -> Err(no_operator(a, b)),
    },
    CBytes(x) -> match b {
      CNull -> Ok(None),
      CBytes(y) -> Ok(Some(ord_int(compare(x, y)))),
      _ -> Err(no_operator(a, b)),
    },
    CJson(_) -> Err(unsupported("comparing `jsonb`")),
    CArray(_) -> Err(unsupported("comparing an array")),
  }

fn no_operator(a: Datum, b: Datum) -> DbError =
  db_error("42883", "", "operator does not exist: " ++ datum_type(a) ++ " = " ++ datum_type(b))

// --- Column types, and what a value has to become to be stored -------------------

fn zeros(n: Int) -> String = fold(range(0, n), "", |acc: String, i: Int| acc ++ "0")

/// A `numeric(p, s)` column stores exactly `s` fractional digits: `1.00` becomes `1.0000`.
fn rescale(d: Decimal, s: Int) -> Option<Decimal> / {abort.raise} = {
  let reduced = if decimal_scale(d) > s { decimal_round(d, s, HalfUp) } else { d };
  let text = decimal_to_string(reduced);
  let have = decimal_scale(reduced);
  if have >= s { decimal_of_string(text) }
  else if have == 0 { decimal_of_string(if s > 0 { text ++ "." ++ zeros(s) } else { text }) }
  else { decimal_of_string(text ++ zeros(s - have)) }
}

fn strip_leading_zeros(s: String) -> String / {abort.raise} = {
  let n = string_len(s);
  let first = fold(range(0, n), n, |at: Int, i: Int|
    if at < n || string_slice(s, i, i + 1) == "0" { at } else { i });
  string_slice(s, first, n)
}

fn numeric_fits(d: Decimal, p: Int, s: Int) -> Bool / {abort.raise} = {
  let text = decimal_to_string(d);
  let unsigned = if string_starts_with(text, "-") { string_slice(text, 1, string_len(text)) }
  else { text };
  let whole = if string_contains(unsigned, ".") {
    string_slice(unsigned, 0, string_find(unsigned, "."))
  } else { unsigned };
  string_len(strip_leading_zeros(whole)) <= p - s
}

fn is_text(v: Datum) -> Bool = match v { CText(_) -> true, _ -> false }

/// A string literal in statement text is `unknown`-typed and coerced, so a bad one is `22P02`.
fn wrong_type(c: Column, v: Datum, from_param: Bool, want: String) -> DbError =
  if !from_param && is_text(v) { db_error("22P02", "", "invalid input syntax for type " ++ want) }
  else {
    db_error(
      "42804",
      "",
      "column \"" ++ c.name ++ "\" is of type " ++ want ++ " but expression is of type "
        ++ datum_type(v),
    )
  }

fn coerce(
  c: Column,
  ty: ColumnType,
  v: Datum,
  from_param: Bool,
) -> Result<Datum, DbError> / {abort.raise} =
  match v { CNull -> Ok(CNull), _ -> coerce_value(c, ty, v, from_param) }

/// The name postgres prints for a column type in a `22P02` or `42804`.
pub fn type_name(ty: ColumnType) -> String =
  match ty {
    TInt -> "bigint",
    TBool -> "boolean",
    TText -> "text",
    TBytes -> "bytea",
    TFloat -> "double precision",
    TNumeric(_, _) -> "numeric",
    TJson -> "jsonb",
    TArray(_) -> "array",
  }

/// Postgres parses an `unknown` string at the type it is assigned or compared to.
fn coerce_value(
  c: Column,
  ty: ColumnType,
  v: Datum,
  from_param: Bool,
) -> Result<Datum, DbError> / {abort.raise} =
  match v {
    CText(s) -> if from_param { coerce_typed(c, ty, v, from_param) }
    else { coerce_unknown(c, ty, s) },
    _ -> coerce_typed(c, ty, v, from_param),
  }

fn coerce_unknown(c: Column, ty: ColumnType, s: String) -> Result<Datum, DbError> / {abort.raise} =
  match unknown_datum(ty, s) {
    None -> Err(bad_input(ty, s)),
    Some(v) -> coerce_typed(c, ty, v, false),
  }

fn bad_input(ty: ColumnType, s: String) -> DbError =
  db_error("22P02", "", "invalid input syntax for type " ++ type_name(ty) ++ ": \"" ++ s ++ "\"")

/// What an `unknown` literal becomes at a given type, or `None` when postgres would refuse the text.
fn unknown_datum(ty: ColumnType, s: String) -> Option<Datum> =
  match ty {
    TInt -> {
      let n = whole_of_string(s)?;
      Some(CInt(n))
    },
    TBool -> unknown_bool(s),
    TText -> Some(CText(s)),
    TFloat -> {
      let d = decimal_of_string(s)?;
      Some(CFloat(float_of_decimal(d)))
    },
    TNumeric(_, _) -> {
      let d = decimal_of_string(s)?;
      Some(CNumeric(d))
    },
    TBytes -> None,
    TJson -> None,
    TArray(_) -> None,
  }

/// Text is read at the target type, so `'2.6'` as `bigint` is refused rather than rounded.
fn whole_of_string(s: String) -> Option<Int> = {
  let d = decimal_of_string(s)?;
  let n = int_of_decimal(d, Down)?;
  if decimal_of_int(n) == d { Some(n) } else { None }
}

fn unknown_bool(s: String) -> Option<Datum> = {
  let t = string::ascii_lower(s);
  if t == "t" || t == "true" || t == "yes" || t == "on" || t == "1" { Some(CBool(true)) }
  else if t == "f" || t == "false" || t == "no" || t == "off" || t == "0" { Some(CBool(false)) }
  else { None }
}

fn coerce_typed(
  c: Column,
  ty: ColumnType,
  v: Datum,
  from_param: Bool,
) -> Result<Datum, DbError> / {abort.raise} =
  match ty {
    TInt -> match v {
      CInt(_) -> Ok(v),
      // Postgres's assignment cast rounds half away from zero: `2.5` is `3`, `-2.5` is `-3`.
      CNumeric(d) -> int_from_decimal(d),
      _ -> Err(wrong_type(c, v, from_param, "bigint")),
    },
    TBool -> match v { CBool(_) -> Ok(v), _ -> Err(wrong_type(c, v, from_param, "boolean")) },
    TText -> match v { CText(_) -> Ok(v), _ -> Err(wrong_type(c, v, from_param, "text")) },
    TBytes -> match v { CBytes(_) -> Ok(v), _ -> Err(wrong_type(c, v, from_param, "bytea")) },
    TJson -> match v { CJson(_) -> Ok(v), _ -> Err(wrong_type(c, v, from_param, "jsonb")) },
    TFloat -> match v {
      CFloat(_) -> Ok(v),
      CInt(n) -> Ok(CFloat(float_of_decimal(decimal_of_int(n)))),
      CNumeric(d) -> Ok(CFloat(float_of_decimal(d))),
      _ -> Err(wrong_type(c, v, from_param, "double precision")),
    },
    TNumeric(p, s) -> match v {
      CNumeric(d) -> numeric_into(c, d, p, s),
      CInt(n) -> numeric_into(c, decimal_of_int(n), p, s),
      _ -> Err(wrong_type(c, v, from_param, "numeric")),
    },
    TArray(inner) -> match v {
      CArray(xs) -> coerce_elements(c, inner, xs, from_param, []),
      _ -> Err(wrong_type(c, v, from_param, "array")),
    },
  }

fn int_from_decimal(d: Decimal) -> Result<Datum, DbError> =
  match int_of_decimal(decimal_round(d, 0, HalfUp), Down) {
    None -> Err(db_error("22003", "", "bigint out of range")),
    Some(n) -> Ok(CInt(n)),
  }

/// Overflow is checked before the rescale, which would exhaust `Decimal` and answer `0A000`.
fn numeric_into(c: Column, d: Decimal, p: Int, s: Int) -> Result<Datum, DbError> / {abort.raise} =
  if !numeric_fits(d, p, s) { Err(numeric_overflow(p, s)) } else {
    match rescale(d, s) {
      None -> Err(unsupported("a `numeric` outside `Decimal`'s 96 bits or scale 28")),
      Some(r) -> if numeric_fits(r, p, s) { Ok(CNumeric(r)) } else { Err(numeric_overflow(p, s)) },
    }
  }

fn numeric_overflow(p: Int, s: Int) -> DbError =
  db_error(
    "22003",
    "",
    "numeric field overflow: a field with precision " ++ int_to_string(p) ++ ", scale "
      ++ int_to_string(s)
      ++ " must round to an absolute value less than 10^"
      ++ int_to_string(p - s),
  )

fn coerce_elements(
  c: Column,
  inner: ColumnType,
  xs: List<Datum>,
  from_param: Bool,
  acc: List<Datum>,
) -> Result<Datum, DbError> / {abort.raise} =
  match xs {
    [] -> Ok(CArray(acc)),
    [h, ..t] -> match h {
      CNull -> Err(unsupported("an array with a NULL element")),
      _ -> {
        let v = coerce_value(c, inner, h, from_param)?;
        coerce_elements(c, inner, t, from_param, push(acc, v))
      },
    },
  }

// --- Tables, columns, and the constraint checks ----------------------------------

fn find_table(ts: List<MemTable>, name: String) -> Option<MemTable> =
  match ts {
    [] -> None,
    [h, ..t] -> if h.def.name == name { Some(h) } else { find_table(t, name) },
  }

fn put_table(ts: List<MemTable>, mt: MemTable) -> List<MemTable> =
  map(ts, |x: MemTable| if x.def.name == mt.def.name { mt } else { x })

fn find_column(cs: List<Column>, n: String) -> Option<Column> =
  match cs { [] -> None, [h, ..t] -> if h.name == n { Some(h) } else { find_column(t, n) } }

fn index_of(xs: List<String>, s: String) -> Option<Int> = index_from(xs, s, 0)

fn index_from(xs: List<String>, s: String, i: Int) -> Option<Int> =
  match xs { [] -> None, [h, ..t] -> if h == s { Some(i) } else { index_from(t, s, i + 1) } }

fn cell_of(r: Row, n: String) -> Datum = match map_get(r, n) { None -> CNull, Some(v) -> v }

/// A primary key column is not-null whether or not the schema says so.
fn not_null_here(def: Table, c: Column) -> Bool = !c.nullable || contains(def.primary_key, c.name)

/// Postgres's order: not-null, check, unique; referential integrity runs after the statement.
fn validate_row(
  def: Table,
  rows: List<Row>,
  row: Row,
  skip: Int,
) -> Option<DbError> / {abort.raise} =
  match check_not_null(def, def.columns, row) {
    Some(e) -> Some(e),
    None -> match check_checks(def, def.checks, row) {
      Some(e) -> Some(e),
      None -> check_unique(def, rows, row, skip),
    },
  }

fn check_not_null(def: Table, cs: List<Column>, row: Row) -> Option<DbError> =
  match cs {
    [] -> None,
    [c, ..t] -> if not_null_here(def, c) && is_null(cell_of(row, c.name)) {
      // Postgres names a column here and no constraint.
      Some(
        db_error(
          "23502",
          "",
          "null value in column \"" ++ c.name ++ "\" of relation \"" ++ def.name
            ++ "\" violates not-null constraint",
        ),
      )
    } else { check_not_null(def, t, row) },
  }

/// A `CHECK` fails only when false and passes when unknown, the opposite of a `WHERE`.
fn check_checks(def: Table, cs: List<Check>, row: Row) -> Option<DbError> / {abort.raise} =
  match cs {
    [] -> None,
    [c, ..t] -> match parse_expr_text(c.expr) {
      Err(e) -> Some(e),
      Ok(x) -> match eval_pred(row, [], x) {
        Err(e) -> Some(e),
        Ok(TriFalse) ->
          Some(
            db_error(
              "23514",
              c.name,
              "new row for relation \"" ++ def.name ++ "\" violates check constraint \"" ++ c.name
                ++ "\"",
            ),
          ),
        Ok(_) -> check_checks(def, t, row),
      },
    },
  }

fn check_unique(def: Table, rows: List<Row>, row: Row, skip: Int) -> Option<DbError> =
  match unique_violation(def, rows, row, skip, def.primary_key, def.name ++ "_pkey") {
    Some(e) -> Some(e),
    None -> check_unique_list(def, def.unique, rows, row, skip),
  }

fn check_unique_list(
  def: Table,
  us: List<Unique>,
  rows: List<Row>,
  row: Row,
  skip: Int,
) -> Option<DbError> =
  match us {
    [] -> None,
    [u, ..t] -> match unique_violation(def, rows, row, skip, u.columns, u.name) {
      Some(e) -> Some(e),
      None -> check_unique_list(def, t, rows, row, skip),
    },
  }

/// Two NULLs are distinct in a unique index, so a key with any NULL in it never collides.
fn unique_violation(
  def: Table,
  rows: List<Row>,
  row: Row,
  skip: Int,
  cols: List<String>,
  name: String,
) -> Option<DbError> =
  if len(cols) == 0 || key_has_null(row, cols) { None } else if collides(rows, row, cols, skip, 0) {
    Some(
      db_error("23505", name, "duplicate key value violates unique constraint \"" ++ name ++ "\""),
    )
  } else { None }

fn key_has_null(row: Row, cols: List<String>) -> Bool =
  fold(cols, false, |acc: Bool, c: String| acc || is_null(cell_of(row, c)))

fn collides(rows: List<Row>, row: Row, cols: List<String>, skip: Int, i: Int) -> Bool =
  match rows {
    [] -> false,
    [h, ..t] -> if i != skip && key_equal(h, row, cols) { true }
    else { collides(t, row, cols, skip, i + 1) },
  }

fn key_equal(a: Row, b: Row, cols: List<String>) -> Bool =
  fold(cols, true, |acc: Bool, c: String| acc && cell_of(a, c) == cell_of(b, c))

/// `NO ACTION` is checked once after the statement, not per row.
fn check_referential(ts: List<MemTable>) -> Option<DbError> = check_ref_from(ts, ts)

fn check_ref_from(all: List<MemTable>, ts: List<MemTable>) -> Option<DbError> =
  match ts {
    [] -> None,
    [h, ..t] -> match check_table_fks(all, h, h.def.foreign_keys) {
      Some(e) -> Some(e),
      None -> check_ref_from(all, t),
    },
  }

fn check_table_fks(ts: List<MemTable>, mt: MemTable, fks: List<ForeignKey>) -> Option<DbError> =
  match fks {
    [] -> None,
    [f, ..rest] -> match check_fk_rows(ts, mt.rows, f) {
      Some(e) -> Some(e),
      None -> check_table_fks(ts, mt, rest),
    },
  }

fn check_fk_rows(ts: List<MemTable>, rows: List<Row>, f: ForeignKey) -> Option<DbError> =
  match rows {
    [] -> None,
    [r, ..t] -> if key_has_null(r, f.columns) { check_fk_rows(ts, t, f) } else {
      match find_table(ts, f.references) {
        None -> Some(undefined_table(f.references)),
        Some(parent) -> if parent_present(parent.rows, r, f) { check_fk_rows(ts, t, f) } else {
          Some(
            db_error(
              "23503",
              f.name,
              "insert or update on table violates foreign key constraint \"" ++ f.name ++ "\"",
            ),
          )
        },
      }
    },
  }

fn parent_present(rows: List<Row>, child: Row, f: ForeignKey) -> Bool =
  match rows {
    [] -> false,
    [p, ..t] -> if fk_matches(p, child, f) { true } else { parent_present(t, child, f) },
  }

fn fk_matches(parent: Row, child: Row, f: ForeignKey) -> Bool =
  fk_pairs(parent, child, f.columns, f.refers_to)

fn fk_pairs(parent: Row, child: Row, cs: List<String>, rs: List<String>) -> Bool =
  match cs {
    [] -> true,
    [c, ..ct] -> match rs {
      [] -> false,
      [r, ..rt] -> cell_of(child, c) == cell_of(parent, r) && fk_pairs(parent, child, ct, rt),
    },
  }

// --- Executing a statement -------------------------------------------------------

/// The answer's shape follows the statement: a `RETURNING` answers `Rows` and a bare write `Count`.
pub fn step(d: MemDb, s: Stmt, ps: List<Param>) -> Outcome / {abort.raise} =
  if d.failed { fail(d, in_failed_txn()) }
  else { match parse_statement(s.sql) { Err(e) -> fail(d, e), Ok(q) -> exec(d, q, ps) } }

fn exec(db: MemDb, q: Query, ps: List<Param>) -> Outcome / {abort.raise} =
  match q {
    QSelect(sq) -> exec_select(db, sq, ps),
    QInsert(iq) -> if read_only(db) { fail(db, read_only_txn("INSERT")) }
    else { exec_insert(db, iq, ps) },
    QUpdate(uq) -> if read_only(db) { fail(db, read_only_txn("UPDATE")) }
    else { exec_update(db, uq, ps) },
    QDelete(dq) -> if read_only(db) { fail(db, read_only_txn("DELETE")) }
    else { exec_delete(db, dq, ps) },
  }

/// The **outermost** scope decides, because a savepoint has no access mode.
fn read_only(db: MemDb) -> Bool =
  match list_at(db.stack, 0) {
    None -> false,
    Some(f) -> match f.access { ReadOnly -> true, ReadWrite -> false },
  }

// --- The plan --------------------------------------------------------------------

type Planned = { left: Expr, right: Expr }

fn plan_filter(def: Table, f: Option<Expr>) -> Result<Option<Expr>, DbError> =
  match f {
    None -> Ok(None),
    Some(e) -> {
      let x = plan_expr(def, e)?;
      Ok(Some(x))
    },
  }

fn plan_expr(def: Table, e: Expr) -> Result<Expr, DbError> =
  match e {
    XCol(n) -> match find_column(def.columns, n) {
      None -> Err(undefined_column(n)),
      Some(_) -> Ok(e),
    },
    XParam(_) -> Ok(e),
    XLit(_) -> Ok(e),
    XDefault -> Ok(e),
    XNot(x) -> {
      let a = plan_expr(def, x)?;
      Ok(XNot(a))
    },
    XAnd(a, b) -> {
      let pa = plan_expr(def, a)?;
      let pb = plan_expr(def, b)?;
      Ok(XAnd(pa, pb))
    },
    XOr(a, b) -> {
      let pa = plan_expr(def, a)?;
      let pb = plan_expr(def, b)?;
      Ok(XOr(pa, pb))
    },
    XCompare(op, a, b) -> {
      let p = plan_operands(def, a, b)?;
      Ok(XCompare(op, p.left, p.right))
    },
    XIsNull(x, want) -> {
      let a = plan_expr(def, x)?;
      Ok(XIsNull(a, want))
    },
    XIn(x, items, negated) -> {
      let px = plan_expr(def, x)?;
      let pis = plan_items(def, column_type_of(def, px), items, [])?;
      Ok(XIn(px, pis, negated))
    },
    XBetween(x, lo, hi, negated) -> {
      let a = plan_operands(def, x, lo)?;
      let ph = plan_expr(def, hi)?;
      let b = paired(def, a.left, ph)?;
      Ok(XBetween(b.left, a.right, b.right, negated))
    },
    XLike(x, p, negated) -> {
      let px = plan_expr(def, x)?;
      let pp = plan_expr(def, p)?;
      Ok(XLike(px, pp, negated))
    },
  }

fn plan_operands(def: Table, a: Expr, b: Expr) -> Result<Planned, DbError> = {
  let pa = plan_expr(def, a)?;
  let pb = plan_expr(def, b)?;
  paired(def, pa, pb)
}

/// Two planned operands, where an `unknown` literal takes its type from the column on the other side.
fn paired(def: Table, pa: Expr, pb: Expr) -> Result<Planned, DbError> =
  match column_type_of(def, pa) {
    Some(ty) -> {
      let nb = retype(ty, pb)?;
      Ok({ left: pa, right: nb })
    },
    None -> match column_type_of(def, pb) {
      Some(ty) -> {
        let na = retype(ty, pa)?;
        Ok({ left: na, right: pb })
      },
      None -> Ok({ left: pa, right: pb }),
    },
  }

fn plan_items(
  def: Table,
  ty: Option<ColumnType>,
  items: List<Expr>,
  acc: List<Expr>,
) -> Result<List<Expr>, DbError> =
  match items {
    [] -> Ok(acc),
    [h, ..t] -> {
      let ph = plan_expr(def, h)?;
      match ty {
        None -> plan_items(def, ty, t, push(acc, ph)),
        Some(want) -> {
          let rh = retype(want, ph)?;
          plan_items(def, ty, t, push(acc, rh))
        },
      }
    },
  }

fn column_type_of(def: Table, e: Expr) -> Option<ColumnType> =
  match e {
    XCol(n) -> {
      let c = find_column(def.columns, n)?;
      Some(c.ty)
    },
    _ -> None,
  }

/// Only a string literal is `unknown`; a parameter and any other literal carry their own type.
fn retype(ty: ColumnType, e: Expr) -> Result<Expr, DbError> =
  match e {
    XLit(v) -> match v {
      CText(s) -> match ty {
        TText -> Ok(e),
        _ -> match unknown_datum(ty, s) { None -> Err(bad_input(ty, s)), Some(nv) -> Ok(XLit(nv)) },
      },
      _ -> Ok(e),
    },
    _ -> Ok(e),
  }

/// Duplicate output names and unknown columns are the statement's shape, so they are refused here.
fn check_projection(def: Table, proj: Projection) -> Option<DbError> =
  match proj { PStar -> None, PCount(_) -> None, PCols(ns) -> check_result_columns(def, ns, []) }

fn check_result_columns(def: Table, ns: List<Target>, seen: List<String>) -> Option<DbError> =
  match ns {
    [] -> None,
    [h, ..t] -> match find_column(def.columns, h.column) {
      None -> Some(undefined_column(h.column)),
      Some(_) -> if contains(seen, h.name) {
        Some(unsupported("a result set with two columns named `" ++ h.name ++ "`"))
      } else { check_result_columns(def, t, push(seen, h.name)) },
    },
  }

fn check_returning(def: Table, r: Option<Projection>) -> Option<DbError> = {
  let p = r?;
  check_projection(def, p)
}

// --- select ----------------------------------------------------------------------

fn exec_select(db: MemDb, q: SelectQ, ps: List<Param>) -> Outcome / {abort.raise} =
  match find_table(db.tables, q.source) {
    None -> fail(db, undefined_table(q.source)),
    Some(mt) -> match plan_select(mt.def, q) {
      Err(e) -> fail(db, e),
      Ok(planned) -> match select_rows(mt.rows, ps, planned.filter, []) {
        Err(e) -> fail(db, e),
        Ok(rows) -> finish_select(db, mt, planned, ps, rows),
      },
    },
  }

fn plan_select(def: Table, q: SelectQ) -> Result<SelectQ, DbError> =
  match check_projection(def, q.proj) {
    Some(e) -> Err(e),
    None -> match check_order_columns(def, q.order) {
      Some(e) -> Err(e),
      None -> {
        let f = plan_filter(def, q.filter)?;
        Ok({
          source: q.source,
          proj: q.proj,
          filter: f,
          order: q.order,
          limit: q.limit,
          offset: q.offset,
        })
      },
    },
  }

fn select_rows(
  rows: List<Row>,
  ps: List<Param>,
  filter: Option<Expr>,
  acc: List<Row>,
) -> Result<List<Row>, DbError> / {abort.raise} =
  match rows {
    [] -> Ok(acc),
    [h, ..t] -> {
      let k = keeps(h, ps, filter)?;
      select_rows(t, ps, filter, if k { push(acc, h) } else { acc })
    },
  }

fn keeps(row: Row, ps: List<Param>, filter: Option<Expr>) -> Result<Bool, DbError> / {abort.raise} =
  match filter {
    None -> Ok(true),
    Some(e) -> {
      let t = eval_pred(row, ps, e)?;
      Ok(match t { TriTrue -> true, TriFalse -> false, TriUnknown -> false })
    },
  }

fn finish_select(
  db: MemDb,
  mt: MemTable,
  q: SelectQ,
  ps: List<Param>,
  rows: List<Row>,
) -> Outcome / {abort.raise} =
  match q.proj {
    PCount(name) -> if len(q.order) > 0 || is_bound(q.limit) || is_bound(q.offset) {
      fail(db, unsupported("`count(*)` with an `order by`, `limit` or `offset`"))
    } else { done(db, Rows([map_insert(map_new(), name, CInt(len(rows)))])) },
    PStar -> ordered_slice(db, mt, q, ps, rows, PStar),
    PCols(ns) -> ordered_slice(db, mt, q, ps, rows, PCols(ns)),
  }

fn is_bound(e: Option<Expr>) -> Bool = match e { None -> false, Some(_) -> true }

fn ordered_slice(
  db: MemDb,
  mt: MemTable,
  q: SelectQ,
  ps: List<Param>,
  rows: List<Row>,
  proj: Projection,
) -> Outcome / {abort.raise} =
  match check_order_columns(mt.def, q.order) {
    Some(e) -> fail(db, e),
    None -> match sort_rows(rows, q.order, []) {
      Err(e) -> fail(db, e),
      Ok(sorted) -> slice_and_project(db, q, ps, sorted, proj),
    },
  }

fn check_order_columns(def: Table, keys: List<OrderKey>) -> Option<DbError> =
  match keys {
    [] -> None,
    [k, ..t] -> match find_column(def.columns, k.column) {
      None -> Some(undefined_column(k.column)),
      Some(_) -> check_order_columns(def, t),
    },
  }

fn slice_and_project(
  db: MemDb,
  q: SelectQ,
  ps: List<Param>,
  rows: List<Row>,
  proj: Projection,
) -> Outcome / {abort.raise} =
  match eval_bound(ps, q.offset, 0, "2201X", "OFFSET") {
    Err(e) -> fail(db, e),
    Ok(off) -> match eval_bound(ps, q.limit, -1, "2201W", "LIMIT") {
      Err(e) -> fail(db, e),
      Ok(lim) -> {
        let after = drop_n(rows, off);
        let bounded = if lim < 0 { after } else { take_n(after, lim, []) };
        match project_rows(bounded, proj, []) {
          Err(e) -> fail(db, e),
          Ok(out) -> done(db, Rows(out)),
        }
      },
    },
  }

fn eval_bound(
  ps: List<Param>,
  e: Option<Expr>,
  dflt: Int,
  code: String,
  what: String,
) -> Result<Int, DbError> / {abort.raise} =
  match e {
    None -> Ok(dflt),
    Some(x) -> {
      let v = eval_value(map_new(), ps, x)?;
      match v {
        CNull -> Ok(dflt),
        CInt(n) -> if n < 0 { Err(db_error(code, "", what ++ " must not be negative")) }
        else { Ok(n) },
        _ -> Err(db_error("42804", "", "argument of " ++ what ++ " must be integer")),
      }
    },
  }

fn drop_n<a>(xs: List<a>, n: Int) -> List<a> =
  if n <= 0 { xs } else { match xs { [] -> [], [_, ..t] -> drop_n(t, n - 1) } }

fn take_n<a>(xs: List<a>, n: Int, acc: List<a>) -> List<a> =
  if n <= 0 { acc } else { match xs { [] -> acc, [h, ..t] -> take_n(t, n - 1, push(acc, h)) } }

/// Insertion sort, and stable by construction: a row goes after every row it compares equal to.
fn sort_rows(rows: List<Row>, keys: List<OrderKey>, acc: List<Row>) -> Result<List<Row>, DbError> =
  if len(keys) == 0 { Ok(concat(acc, rows)) } else {
    match rows {
      [] -> Ok(acc),
      [h, ..t] -> {
        let next = insert_sorted(acc, h, keys, [])?;
        sort_rows(t, keys, next)
      },
    }
  }

reuse fn insert_sorted(
  sorted: List<Row>,
  row: Row,
  keys: List<OrderKey>,
  before: List<Row>,
) -> Result<List<Row>, DbError> =
  match sorted {
    [] -> Ok(push(before, row)),
    [h, ..t] -> {
      let c = rows_cmp(row, h, keys)?;
      if c < 0 { Ok(concat(push(before, row), sorted)) }
      else { insert_sorted(t, row, keys, push(before, h)) }
    },
  }

fn rows_cmp(a: Row, b: Row, keys: List<OrderKey>) -> Result<Int, DbError> =
  match keys {
    [] -> Ok(0),
    [k, ..t] -> {
      let c = key_cmp(a, b, k)?;
      if c == 0 { rows_cmp(a, b, t) } else { Ok(c) }
    },
  }

/// `NULLS FIRST` / `NULLS LAST` is absolute, so the null arms sit outside the `desc` flip.
fn key_cmp(a: Row, b: Row, k: OrderKey) -> Result<Int, DbError> = {
  let av = cell_of(a, k.column);
  let bv = cell_of(b, k.column);
  if is_null(av) && is_null(bv) { Ok(0) }
  else if is_null(av) { Ok(if k.nulls_first { -1 } else { 1 }) }
  else if is_null(bv) { Ok(if k.nulls_first { 1 } else { -1 }) } else {
    let o = datum_cmp(av, bv)?;
    match o { None -> Ok(0), Some(c) -> Ok(if k.desc { 0 - c } else { c }) }
  }
}

fn project_rows(rows: List<Row>, proj: Projection, acc: List<Row>) -> Result<List<Row>, DbError> =
  match rows {
    [] -> Ok(acc),
    [h, ..t] -> {
      let r = project_row(h, proj)?;
      project_rows(t, proj, push(acc, r))
    },
  }

fn project_row(r: Row, proj: Projection) -> Result<Row, DbError> =
  match proj { PStar -> Ok(r), PCount(_) -> Ok(r), PCols(ns) -> project_cols(r, ns, map_new()) }

/// A `Row` is a `Map`, so two output columns of one name would silently keep one.
fn project_cols(row: Row, ns: List<Target>, acc: Row) -> Result<Row, DbError> =
  match ns {
    [] -> Ok(acc),
    [h, ..t] -> match map_get(row, h.column) {
      None -> Err(undefined_column(h.column)),
      Some(v) -> project_cols(row, t, map_insert(acc, h.name, v)),
    },
  }

// --- insert ----------------------------------------------------------------------

type RowAcc = { seqs: Map<String, Int>, row: Row, err: Option<DbError> }

type Build = { seqs: Map<String, Int>, rows: List<Row>, err: Option<DbError> }

fn exec_insert(db: MemDb, q: InsertQ, ps: List<Param>) -> Outcome / {abort.raise} =
  match find_table(db.tables, q.source) {
    None -> fail(db, undefined_table(q.source)),
    Some(mt) -> {
      let cols = if len(q.columns) == 0 { map(mt.def.columns, |c: Column| c.name) }
      else { q.columns };
      match check_column_list(mt.def, cols, []) {
        Some(e) -> fail(db, e),
        None -> match check_returning(mt.def, q.returning) {
          Some(e) -> fail(db, e),
          None -> insert_build(db, mt, cols, q, ps),
        },
      }
    },
  }

fn check_column_list(def: Table, cols: List<String>, seen: List<String>) -> Option<DbError> =
  match cols {
    [] -> None,
    [h, ..t] -> match find_column(def.columns, h) {
      None -> Some(undefined_column(h)),
      Some(_) -> if contains(seen, h) {
        Some(db_error("42701", "", "column \"" ++ h ++ "\" specified more than once"))
      } else { check_column_list(def, t, push(seen, h)) },
    },
  }

/// A sequence stays advanced even when the row is refused: postgres sequences are not transactional.
fn insert_build(
  db: MemDb,
  mt: MemTable,
  cols: List<String>,
  q: InsertQ,
  ps: List<Param>,
) -> Outcome / {abort.raise} = {
  let b = fold(
    q.tuples,
    { seqs: db.sequences, rows: [], err: None },
    |acc: Build, exprs: List<Expr>| build_tuple(mt.def, cols, exprs, ps, acc),
  );
  let advanced = memdb(db, db.tables, b.seqs, db.stack, db.failed);
  match b.err { Some(e) -> fail(advanced, e), None -> insert_rows(advanced, mt, b.rows, q) }
}

fn build_tuple(
  def: Table,
  cols: List<String>,
  exprs: List<Expr>,
  ps: List<Param>,
  acc: Build,
) -> Build / {abort.raise} =
  match acc.err {
    Some(_) -> acc,
    None -> if len(exprs) != len(cols) {
      {
        seqs: acc.seqs,
        rows: acc.rows,
        err: Some(
          db_error(
            "42601",
            "",
            "INSERT has " ++ (if len(exprs) > len(cols) { "more" } else { "fewer" })
              ++ " expressions than target columns",
          ),
        ),
      }
    } else {
      collect_tuple(
        build_columns(def, def.columns, cols, exprs, ps, {
          seqs: acc.seqs,
          row: map_new(),
          err: None,
        }),
        acc,
      )
    },
  }

fn collect_tuple(built: RowAcc, acc: Build) -> Build =
  match built.err {
    Some(e) -> { seqs: built.seqs, rows: acc.rows, err: Some(e) },
    None -> { seqs: built.seqs, rows: push(acc.rows, built.row), err: None },
  }

fn build_columns(
  def: Table,
  cs: List<Column>,
  cols: List<String>,
  exprs: List<Expr>,
  ps: List<Param>,
  acc: RowAcc,
) -> RowAcc / {abort.raise} =
  match cs {
    [] -> acc,
    [c, ..rest] -> match acc.err {
      Some(_) -> acc,
      None -> build_columns(def, rest, cols, exprs, ps, build_column(c, cols, exprs, ps, acc)),
    },
  }

fn build_column(
  c: Column,
  cols: List<String>,
  exprs: List<Expr>,
  ps: List<Param>,
  acc: RowAcc,
) -> RowAcc / {abort.raise} =
  match index_of(cols, c.name) {
    None -> default_into(c, acc),
    Some(i) -> match list_at(exprs, i) {
      None -> default_into(c, acc),
      Some(e) -> match e {
        XDefault -> default_into(c, acc),
        _ -> store_value(c, eval_value(map_new(), ps, e), is_param(e), acc),
      },
    },
  }

fn is_param(e: Expr) -> Bool = match e { XParam(_) -> true, _ -> false }

fn store_value(
  c: Column,
  r: Result<Datum, DbError>,
  from_param: Bool,
  acc: RowAcc,
) -> RowAcc / {abort.raise} =
  match r {
    Err(e) -> { seqs: acc.seqs, row: acc.row, err: Some(e) },
    Ok(v) -> match coerce(c, c.ty, v, from_param) {
      Err(e) -> { seqs: acc.seqs, row: acc.row, err: Some(e) },
      Ok(cv) -> { seqs: acc.seqs, row: map_insert(acc.row, c.name, cv), err: None },
    },
  }

fn default_into(c: Column, acc: RowAcc) -> RowAcc / {abort.raise} =
  match c.default {
    DNone -> { seqs: acc.seqs, row: map_insert(acc.row, c.name, CNull), err: None },
    DLiteral(p) -> store_value(c, Ok(param_datum(p)), false, acc),
    DSequence(n) -> {
      let next = match map_get(acc.seqs, n) { None -> 1, Some(v) -> v + 1 };
      {
        seqs: map_insert(acc.seqs, n, next),
        row: map_insert(acc.row, c.name, CInt(next)),
        err: None,
      }
    },
  }

fn insert_rows(db: MemDb, mt: MemTable, rows: List<Row>, q: InsertQ) -> Outcome / {abort.raise} =
  match append_rows(mt, rows) {
    Err(e) -> fail(db, e),
    Ok(mt2) -> {
      let tables = put_table(db.tables, mt2);
      match check_referential(tables) {
        Some(e) -> fail(db, e),
        None ->
          finish_write(
            memdb(db, tables, db.sequences, db.stack, db.failed),
            rows,
            q.returning,
            len(rows),
          ),
      }
    },
  }

fn append_rows(mt: MemTable, rows: List<Row>) -> Result<MemTable, DbError> / {abort.raise} =
  match rows {
    [] -> Ok(mt),
    [h, ..t] -> match validate_row(mt.def, mt.rows, h, -1) {
      Some(e) -> Err(e),
      None -> append_rows({ def: mt.def, rows: push(mt.rows, h) }, t),
    },
  }

fn finish_write(db: MemDb, rows: List<Row>, returning: Option<Projection>, count: Int) -> Outcome =
  match returning {
    None -> done(db, Count(count)),
    Some(p) -> match project_rows(rows, p, []) {
      Err(e) -> fail(db, e),
      Ok(out) -> done(db, Rows(out)),
    },
  }

// --- update ----------------------------------------------------------------------

type Changed = { at: Int, row: Row }

type UpAcc = { rows: List<Row>, changed: List<Changed>, at: Int, err: Option<DbError> }

fn exec_update(db: MemDb, q: UpdateQ, ps: List<Param>) -> Outcome / {abort.raise} =
  match find_table(db.tables, q.source) {
    None -> fail(db, undefined_table(q.source)),
    Some(mt) -> match plan_update(mt.def, q, ps) {
      Err(e) -> fail(db, e),
      Ok(planned) -> {
        let acc = update_walk(mt.def, mt.rows, planned, ps, {
          rows: [],
          changed: [],
          at: 0,
          err: None,
        });
        match acc.err { Some(e) -> fail(db, e), None -> finish_update(db, mt, acc, planned) }
      },
    },
  }

fn plan_update(
  def: Table,
  q: UpdateQ,
  ps: List<Param>,
) -> Result<UpdateQ, DbError> / {abort.raise} =
  match check_returning(def, q.returning) {
    Some(e) -> Err(e),
    None -> match constant_sets(def, q.sets, ps) {
      Some(e) -> Err(e),
      None -> {
        let f = plan_filter(def, q.filter)?;
        Ok({ source: q.source, sets: q.sets, filter: f, returning: q.returning })
      },
    },
  }

/// A constant `set` is coerced at plan time, so one that cannot fit fails even when no row matches.
fn constant_sets(
  def: Table,
  sets: List<Assign>,
  ps: List<Param>,
) -> Option<DbError> / {abort.raise} =
  match sets {
    [] -> None,
    [s, ..t] -> match find_column(def.columns, s.column) {
      None -> Some(undefined_column(s.column)),
      Some(c) -> match constant_of(s.value, ps) {
        None -> constant_sets(def, t, ps),
        Some(v) -> match coerce(c, c.ty, v, is_param(s.value)) {
          Err(e) -> Some(e),
          Ok(_) -> constant_sets(def, t, ps),
        },
      },
    },
  }

fn constant_of(e: Expr, ps: List<Param>) -> Option<Datum> =
  match e {
    XLit(v) -> Some(v),
    XParam(n) -> {
      let p = list_at(ps, n - 1)?;
      Some(param_datum(p))
    },
    _ -> None,
  }

fn update_walk(
  def: Table,
  rows: List<Row>,
  q: UpdateQ,
  ps: List<Param>,
  acc: UpAcc,
) -> UpAcc / {abort.raise} =
  match rows {
    [] -> acc,
    [h, ..t] -> match acc.err {
      Some(_) -> acc,
      None -> update_walk(def, t, q, ps, update_one(def, h, q, ps, acc)),
    },
  }

fn update_one(
  def: Table,
  row: Row,
  q: UpdateQ,
  ps: List<Param>,
  acc: UpAcc,
) -> UpAcc / {abort.raise} =
  match keeps(row, ps, q.filter) {
    Err(e) -> { rows: acc.rows, changed: acc.changed, at: acc.at, err: Some(e) },
    Ok(hit) -> if hit { update_hit(def, row, q, ps, acc) }
    else { { rows: push(acc.rows, row), changed: acc.changed, at: acc.at + 1, err: None } },
  }

fn update_hit(
  def: Table,
  row: Row,
  q: UpdateQ,
  ps: List<Param>,
  acc: UpAcc,
) -> UpAcc / {abort.raise} =
  match apply_sets(def, row, q.sets, ps) {
    Err(e) -> { rows: acc.rows, changed: acc.changed, at: acc.at, err: Some(e) },
    Ok(nr) ->
      {
        rows: push(acc.rows, nr),
        changed: push(acc.changed, { at: acc.at, row: nr }),
        at: acc.at + 1,
        err: None,
      },
  }

fn apply_sets(
  def: Table,
  row: Row,
  sets: List<Assign>,
  ps: List<Param>,
) -> Result<Row, DbError> / {abort.raise} =
  match sets {
    [] -> Ok(row),
    [s, ..t] -> match find_column(def.columns, s.column) {
      None -> Err(undefined_column(s.column)),
      Some(c) -> {
        let nr = set_value(c, row, s.value, ps)?;
        apply_sets(def, nr, t, ps)
      },
    },
  }

/// Sequences are threaded through `insert` only, so `set c = default` on one is refused.
fn set_value(
  c: Column,
  row: Row,
  e: Expr,
  ps: List<Param>,
) -> Result<Row, DbError> / {abort.raise} =
  match e {
    XDefault -> match c.default {
      DSequence(_) -> Err(unsupported("`set ... = default` on a sequence column")),
      DNone -> Ok(map_insert(row, c.name, CNull)),
      DLiteral(p) -> {
        let v = coerce(c, c.ty, param_datum(p), false)?;
        Ok(map_insert(row, c.name, v))
      },
    },
    _ -> {
      let v = eval_value(row, ps, e)?;
      let cv = coerce(c, c.ty, v, is_param(e))?;
      Ok(map_insert(row, c.name, cv))
    },
  }

fn finish_update(db: MemDb, mt: MemTable, acc: UpAcc, q: UpdateQ) -> Outcome / {abort.raise} =
  match validate_changed(mt.def, acc.rows, acc.changed) {
    Some(e) -> fail(db, e),
    None -> {
      let tables = put_table(db.tables, { def: mt.def, rows: acc.rows });
      match check_referential(tables) {
        Some(e) -> fail(db, e),
        None ->
          finish_write(
            memdb(db, tables, db.sequences, db.stack, db.failed),
            map(acc.changed, |c: Changed| c.row),
            q.returning,
            len(acc.changed),
          ),
      }
    },
  }

fn validate_changed(
  def: Table,
  rows: List<Row>,
  cs: List<Changed>,
) -> Option<DbError> / {abort.raise} =
  match cs {
    [] -> None,
    [h, ..t] -> match validate_row(def, rows, h.row, h.at) {
      Some(e) -> Some(e),
      None -> validate_changed(def, rows, t),
    },
  }

// --- delete ----------------------------------------------------------------------

type DelAcc = { rows: List<Row>, gone: List<Row>, err: Option<DbError> }

fn exec_delete(db: MemDb, q: DeleteQ, ps: List<Param>) -> Outcome / {abort.raise} =
  match find_table(db.tables, q.source) {
    None -> fail(db, undefined_table(q.source)),
    Some(mt) -> match plan_delete(mt.def, q) {
      Err(e) -> fail(db, e),
      Ok(q) -> {
        let acc = delete_walk(mt.rows, q, ps, { rows: [], gone: [], err: None });
        match acc.err {
          Some(e) -> fail(db, e),
          None -> {
            let tables = put_table(db.tables, { def: mt.def, rows: acc.rows });
            match check_referential(tables) {
              Some(e) -> fail(db, e),
              None ->
                finish_write(
                  memdb(db, tables, db.sequences, db.stack, db.failed),
                  acc.gone,
                  q.returning,
                  len(acc.gone),
                ),
            }
          },
        }
      },
    },
  }

fn plan_delete(def: Table, q: DeleteQ) -> Result<DeleteQ, DbError> =
  match check_returning(def, q.returning) {
    Some(e) -> Err(e),
    None -> {
      let f = plan_filter(def, q.filter)?;
      Ok({ source: q.source, filter: f, returning: q.returning })
    },
  }

fn delete_walk(
  rows: List<Row>,
  q: DeleteQ,
  ps: List<Param>,
  acc: DelAcc,
) -> DelAcc / {abort.raise} =
  match rows {
    [] -> acc,
    [h, ..t] -> match acc.err {
      Some(_) -> acc,
      None -> match keeps(h, ps, q.filter) {
        Err(e) -> { rows: acc.rows, gone: acc.gone, err: Some(e) },
        Ok(hit) ->
          delete_walk(t, q, ps, if hit { { rows: acc.rows, gone: push(acc.gone, h), err: None } }
          else { { rows: push(acc.rows, h), gone: acc.gone, err: None } }),
      },
    },
  }

// --- The scope stack -------------------------------------------------------------

/// A refused `begin` does not abort the transaction it is nested inside.
pub fn begin_step(db: MemDb, level: Isolation, access: Access) -> Outcome = {
  let frame = {
    tables: db.tables,
    failed: false,
    level: level,
    access: access,
    pending: db.pending,
  };
  match list_at(db.stack, 0) {
    None -> done(memdb(db, db.tables, db.sequences, [frame], false), Count(0)),
    Some(outer) -> match nested_refusal(
        db.failed,
        len(db.stack),
        outer.level,
        outer.access,
        level,
        access,
      ) {
      Some(e) -> fail_open(db, e),
      None -> done(memdb(db, db.tables, db.sequences, push(db.stack, frame), db.failed), Count(0)),
    },
  }
}

/// Why a `begin` cannot be a savepoint of the transaction it is nested in, where `depth` scopes are
/// open and `outer` is what the transaction's own `begin` asked for; the twin and the driver share it.
fn nested_refusal(
  failed: Bool,
  depth: Int,
  outer: Isolation,
  outer_access: Access,
  level: Isolation,
  access: Access,
) -> Option<DbError> =
  if failed { Some(in_failed_txn()) } else if depth > max_savepoints() {
    Some(db_error("54000", "", "savepoint stack deeper than " ++ int_to_string(max_savepoints())))
  } else if !same_isolation(outer, level) {
    Some(
      db_error(
        "25001",
        "",
        "the open transaction is " ++ isolation_name(outer) ++ " and this nested `begin` asks for "
          ++ isolation_name(level),
      ),
    )
  } else if widens(outer_access, access) {
    // A savepoint has no access mode, so it cannot widen the transaction's.
    Some(
      db_error(
        "25001",
        "",
        "the open transaction is " ++ access_name(outer_access)
          ++ " and this nested `begin` asks for "
          ++ access_name(access)
          ++ "; a savepoint cannot widen what the transaction may do",
      ),
    )
  } else { None }

fn widens(outer: Access, inner: Access) -> Bool =
  match outer {
    ReadOnly -> match inner { ReadWrite -> true, ReadOnly -> false },
    ReadWrite -> false,
  }

/// The access mode as `begin` spells it.
pub fn access_name(a: Access) -> String =
  match a { ReadWrite -> "read write", ReadOnly -> "read only" }

fn same_isolation(a: Isolation, b: Isolation) -> Bool =
  match a {
    ReadCommitted -> match b { ReadCommitted -> true, _ -> false },
    RepeatableRead -> match b { RepeatableRead -> true, _ -> false },
    Serializable -> match b { Serializable -> true, _ -> false },
  }

/// The isolation level as `begin` spells it.
pub fn isolation_name(a: Isolation) -> String =
  match a {
    ReadCommitted -> "read committed",
    RepeatableRead -> "repeatable read",
    Serializable -> "serializable",
  }

/// Committing an aborted transaction is `25P02`, stricter on purpose than the bare server. A
/// transaction that commits delivers what it notified; one that does not, nothing of it.
pub fn commit_step(db: MemDb) -> Outcome =
  match last(db.stack) {
    None -> fail_open(db, no_transaction("`db.commit`")),
    Some(frame) -> if len(db.stack) == 1 {
      if db.failed {
        {
          db: { ..memdb(db, frame.tables, db.sequences, [], false), pending: frame.pending },
          out: Failed(in_failed_txn()),
        }
      } else {
        done(
          delivered({ ..memdb(db, db.tables, db.sequences, [], false), pending: [] }, db.pending),
          Count(0),
        )
      }
    } else if db.failed {
      // A failed `commit` closes and rolls back its scope, as the driver does.
      {
        db: {
          ..memdb(db, frame.tables, db.sequences, drop_last(db.stack, 1), true),
          pending: frame.pending,
        },
        out: Failed(in_failed_txn()),
      }
    } else {
      done(memdb(db, db.tables, db.sequences, drop_last(db.stack, 1), db.failed), Count(0))
    },
  }

/// `db.abort` on the twin: the innermost scope's changes undone, and what it notified with them.
pub fn abort_step(db: MemDb) -> Outcome =
  match last(db.stack) {
    None -> fail_open(db, no_transaction("`db.abort`")),
    Some(frame) ->
      done(
        {
          ..memdb(db, frame.tables, db.sequences, drop_last(db.stack, 1), frame.failed),
          pending: frame.pending,
        },
        Count(0),
      ),
  }

// --- Notifications, on the twin --------------------------------------------------

/// The twin with `notes` heard by its listener: each on a channel it listens on goes to its inbox,
/// and the rest are dropped, as is every one while its connection is cut.
fn delivered(db: MemDb, notes: List<pg::Notification>) -> MemDb =
  if db.listener.cut { db } else {
    {
      ..db,
      listener: {
        ..db.listener,
        inbox: fold(
          notes,
          db.listener.inbox,
          |inbox: List<pg::Notification>, n: pg::Notification|
            if contains(db.listener.channels, n.channel) { push(inbox, n) } else { inbox },
        ),
      },
    }
  }

/// The most bytes a notification's payload may hold, short of the 8000 postgres refuses.
pub fn max_payload() -> Int = 7999

/// `db.notify[channel]` on the twin: queued until the transaction commits, delivered at once outside
/// one, and once however often one transaction sends it. A notification's sender is `0`: the twin is
/// no server process.
pub fn notify_step(db: MemDb, channel: String, payload: String) -> Outcome =
  if db.failed { fail(db, in_failed_txn()) }
  else if bytes_len(bytes_of_string(payload)) > max_payload() {
    fail(db, db_error("22023", "", "payload string too long"))
  } else {
    let n = { sender: 0, channel: channel, payload: payload };
    if len(db.stack) == 0 { done(delivered(db, [n]), Count(1)) }
    else if contains(db.pending, n) { done(db, Count(1)) }
    else { done({ ..db, pending: push(db.pending, n) }, Count(1)) }
  }

/// `db.listen[channel]` on the twin: from now on, what is notified on it is heard.
pub fn listen_step(db: MemDb, channel: String) -> Outcome =
  if contains(db.listener.channels, channel) { done(db, Count(0)) } else {
    done(
      { ..db, listener: { ..db.listener, channels: push(db.listener.channels, channel) } },
      Count(0),
    )
  }

/// `db.unlisten[channel]` on the twin; what was already heard on it stays to be taken.
pub fn unlisten_step(db: MemDb, channel: String) -> Outcome =
  done(
    {
      ..db,
      listener: { ..db.listener, channels: filter(db.listener.channels, |c: String| c != channel) },
    },
    Count(0),
  )

/// The twin after a wait for a notification, and what the wait answered.
pub type Waited = { db: MemDb, notice: Notice }

/// `db.notified` on the twin: `Reconnected` after a cut, which listens again; otherwise the oldest
/// notification heard, or `Quiet` at once, since nothing in the twin waits. A wait with nothing
/// listened to panics, as the driver does.
pub fn notified_step(db: MemDb) -> Waited / {abort.raise} =
  if len(db.listener.channels) == 0 { panic(nothing_listened()) } else if db.listener.cut {
    { db: { ..db, listener: { ..db.listener, cut: false } }, notice: Reconnected }
  } else {
    match db.listener.inbox {
      [oldest, ..later] ->
        { db: { ..db, listener: { ..db.listener, inbox: later } }, notice: Notified(oldest) },
      [] -> { db: db, notice: Quiet },
    }
  }

/// The twin with its listener's connection cut: what was heard and not taken is lost, and so is
/// everything notified until the next wait listens again.
pub fn cut_step(db: MemDb) -> MemDb = { ..db, listener: { ..db.listener, inbox: [], cut: true } }

fn nothing_listened() -> String =
  "`db.notified` waits on the channels `db.listen` named, and there are none"

fn no_transaction(what: String) -> DbError =
  db_error("25P01", "", what ++ " with no transaction open")

/// With no open scope there is no transaction to poison, so the database is left as it was.
fn fail_open(db: MemDb, e: DbError) -> Outcome = { db: db, out: Failed(e) }

// --- The twin's own tests --------------------------------------------------------

fn t_schema() -> Schema = { tables: [t_part(), t_bin()] }

fn t_part() -> Table =
  {
    name: "part",
    columns: [
      column("sku", TText, false),
      column("price", TNumeric(10, 4), false),
      column("tag", TText, true),
      column("n", TInt, true),
    ],
    primary_key: ["sku"],
    unique: [{ name: "part_tag_key", columns: ["tag"] }],
    foreign_keys: [],
    checks: [{ name: "part_price_check", expr: "price >= 0" }],
  }

fn t_bin() -> Table =
  {
    name: "bin",
    columns: [
      column_default("id", TInt, false, DSequence("bin_id_seq")),
      column("sku", TText, true),
      column("qty", TInt, true),
    ],
    primary_key: ["id"],
    unique: [],
    foreign_keys: [
      { name: "bin_sku_fkey", columns: ["sku"], references: "part", refers_to: ["sku"] },
    ],
    checks: [{ name: "bin_qty_check", expr: "qty >= 0" }],
  }

fn t_run(db: MemDb, sql: String, ps: List<Param>) -> Outcome / {abort.raise} =
  step(db, stmt(sql), ps)

fn t_out(db: MemDb, sql: String, ps: List<Param>) -> Answer / {abort.raise} = t_run(db, sql, ps).out

fn t_seed() -> MemDb / {abort.raise} = {
  let a = t_run(open(t_schema()), "insert into part (sku, price, tag, n) values ($1,$2,$3,$4)", [
    PText("a"),
    PNumeric(1m),
    PText("t1"),
    PInt(1),
  ]);
  let b = t_run(a.db, "insert into part (sku, price, tag, n) values ($1,$2,$3,$4)", [
    PText("b"),
    PNumeric(2m),
    PText("t2"),
    PNull,
  ]);
  t_run(b.db, "insert into part (sku, price, tag, n) values ($1,$2,$3,$4)", [
    PText("c"),
    PNumeric(3m),
    PNull,
    PInt(3),
  ]).db
}

fn t_code(a: Answer) -> String =
  match a { Failed(e) -> e.code, Rows(_) -> "rows", Count(_) -> "count" }

fn t_constraint(a: Answer) -> String = match a { Failed(e) -> e.constraint, _ -> "" }

fn t_skus(a: Answer) -> List<String> =
  match a {
    Rows(rs) -> map(rs, |r: Row| match cell_of(r, "sku") { CText(s) -> s, _ -> "?" }),
    _ -> [],
  }

fn t_count(a: Answer) -> Int =
  match a {
    Rows(rs) -> match rs {
      [r, ..] -> match cell_of(r, "count") { CInt(n) -> n, _ -> -1 },
      _ -> -1,
    },
    _ -> -1,
  }

test "create_schema renders one statement per table and one per sequence" {
  let sqls = map(create_schema(t_schema()), |s: Stmt| s.sql);
  assert_eq(len(sqls), 3);
  assert_eq(list_at(sqls, 0), Some("create sequence \"bin_id_seq\""));
  assert_eq(
    list_at(sqls, 1),
    Some(
      "create table \"part\" (\"sku\" text not null, \"price\" numeric(10,4) not null, "
        ++ "\"tag\" text, \"n\" bigint, primary key (\"sku\"), "
        ++ "constraint \"part_tag_key\" unique (\"tag\"), "
        ++ "constraint \"part_price_check\" check (price >= 0))",
    ),
  )
}

test "a where, an order by, a limit and an offset" {
  let d = t_seed();
  assert_eq(t_skus(t_out(d, "select sku from part order by sku", [])), ["a", "b", "c"]);
  assert_eq(t_skus(t_out(d, "select sku from part order by sku desc", [])), ["c", "b", "a"]);
  assert_eq(t_skus(t_out(d, "select sku from part order by sku limit 2", [])), ["a", "b"]);
  assert_eq(t_skus(t_out(d, "select sku from part order by sku limit 2 offset 1", [])), ["b", "c"]);
  assert_eq(t_skus(t_out(d, "select sku from part where price > 1 order by sku", [])), ["b", "c"]);
  assert_eq(t_skus(t_out(d, "select sku from part where sku in ('a','c') order by sku", [])), [
    "a",
    "c",
  ]);
  assert_eq(
    t_skus(t_out(d, "select sku from part where price between 2 and 3 order by sku", [])),
    ["b", "c"],
  );
  assert_eq(t_skus(t_out(d, "select sku from part where tag like 't%' order by sku", [])), [
    "a",
    "b",
  ]);
  assert_eq(t_skus(t_out(d, "select sku from part where sku = 'zz' order by sku", [])), []);
  assert_eq(t_count(t_out(d, "select count(*) from part", [])), 3)
}

test "a comparison with null is unknown, and a where keeps only what is true" {
  let d = t_seed();
  assert_eq(t_skus(t_out(d, "select sku from part where n = 1 order by sku", [])), ["a"]);
  assert_eq(t_skus(t_out(d, "select sku from part where n <> 1 order by sku", [])), ["c"]);
  assert_eq(t_skus(t_out(d, "select sku from part where n is null order by sku", [])), ["b"]);
  assert_eq(t_skus(t_out(d, "select sku from part where not (n = 1) order by sku", [])), ["c"]);
  assert_eq(t_skus(t_out(d, "select sku from part where n = 1 or tag = 't2' order by sku", [])), [
    "a",
    "b",
  ])
}

test "nulls order last under asc and first under desc, and the words override it" {
  let d = t_seed();
  assert_eq(t_skus(t_out(d, "select sku, n from part order by n, sku", [])), ["a", "c", "b"]);
  assert_eq(t_skus(t_out(d, "select sku, n from part order by n desc, sku", [])), ["b", "c", "a"]);
  assert_eq(t_skus(t_out(d, "select sku, n from part order by n nulls first, sku", [])), [
    "b",
    "a",
    "c",
  ])
}

test "insert answers a count, and returning answers the rows" {
  let d = open(t_schema());
  assert_eq(t_out(d, "insert into part (sku, price) values ('a', 1)", []), Count(1));
  assert_eq(t_out(d, "insert into part (sku, price) values ('a', 1), ('b', 2)", []), Count(2));
  assert_eq(t_skus(t_out(d, "insert into part (sku, price) values ('a', 1) returning sku", [])), [
    "a",
  ])
}

test "a numeric column stores the column's scale and refuses what will not fit" {
  let d = open(t_schema());
  let r = t_run(d, "insert into part (sku, price) values ('a', $1) returning price", [
    PNumeric(1.00m),
  ]);
  match r.out {
    Rows(rs) -> match rs {
      [row, ..] -> match cell_of(row, "price") {
        CNumeric(v) -> assert_eq(decimal_to_string(v), "1.0000"),
        _ -> assert(false),
      },
      _ -> assert(false),
    },
    _ -> assert(false),
  };
  assert_eq(t_code(t_out(d, "insert into part (sku, price) values ('a', 1.00005)", [])), "count");
  assert_eq(t_code(t_out(d, "insert into part (sku, price) values ('a', 1000000)", [])), "22003")
}

test "a constant that will not fit the column fails even when no row matches" {
  let d = t_seed();
  assert_eq(t_code(t_out(d, "update part set price = 1000000 where sku = 'zz'", [])), "22003");
  assert_eq(t_out(d, "update part set price = 9 where sku = 'zz'", []), Count(0))
}

test "the four constraint classes carry the codes and the names postgres sends" {
  let d = t_seed();
  let dup = t_out(d, "insert into part (sku, price) values ('a', 1)", []);
  assert_eq(t_code(dup), "23505");
  assert_eq(t_constraint(dup), "part_pkey");
  let tag = t_out(d, "insert into part (sku, price, tag) values ('z', 1, 't1')", []);
  assert_eq(t_code(tag), "23505");
  assert_eq(t_constraint(tag), "part_tag_key");
  let nn = t_out(d, "insert into part (sku, price) values ('z', null)", []);
  assert_eq(t_code(nn), "23502");
  // Postgres reports a *column* for a not-null violation and no constraint.
  assert_eq(t_constraint(nn), "");
  let ck = t_out(d, "insert into part (sku, price) values ('z', -1)", []);
  assert_eq(t_code(ck), "23514");
  assert_eq(t_constraint(ck), "part_price_check");
  let fk = t_out(d, "insert into bin (sku, qty) values ('zz', 1)", []);
  assert_eq(t_code(fk), "23503");
  assert_eq(t_constraint(fk), "bin_sku_fkey")
}

test "two nulls in a unique column do not collide" {
  let d = t_seed();
  assert_eq(t_out(d, "insert into part (sku, price, tag) values ('z', 1, null)", []), Count(1))
}

test "a check passes on unknown and fails only on false" {
  let d = t_seed();
  assert_eq(t_out(d, "insert into bin (sku, qty) values ('a', null)", []), Count(1));
  assert_eq(t_code(t_out(d, "insert into bin (sku, qty) values ('a', -1)", [])), "23514")
}

test "a parent with a child cannot be deleted" {
  let d0 = t_seed();
  let d1 = t_run(d0, "insert into bin (sku, qty) values ('a', 1)", []).db;
  assert_eq(t_code(t_out(d1, "delete from part where sku = 'a'", [])), "23503");
  assert_eq(t_out(d1, "delete from part where sku = 'b'", []), Count(1))
}

test "a parameter carrying SQL is a value and never syntax" {
  let d = open(t_schema());
  let r = t_run(d, "insert into part (sku, price) values ($1, 1) returning sku", [
    PText("'; drop table part; --"),
  ]);
  assert_eq(t_skus(r.out), ["'; drop table part; --"]);
  assert_eq(t_count(t_out(r.db, "select count(*) from part", [])), 1)
}

test "a committed scope is visible and an aborted one is not" {
  let d0 = t_seed();
  let b = begin_step(d0, ReadCommitted, ReadWrite);
  let i = t_run(b.db, "insert into part (sku, price) values ('z', 1)", []);
  assert_eq(t_count(t_out(i.db, "select count(*) from part", [])), 4);
  let c = commit_step(i.db);
  assert_eq(t_count(t_out(c.db, "select count(*) from part", [])), 4);
  let b2 = begin_step(c.db, ReadCommitted, ReadWrite);
  let i2 = t_run(b2.db, "delete from part where sku = 'z'", []);
  let a2 = abort_step(i2.db);
  assert_eq(t_count(t_out(a2.db, "select count(*) from part", [])), 4)
}

test "a statement that failed inside a scope makes every later one 25P02" {
  let d0 = t_seed();
  let b = begin_step(d0, ReadCommitted, ReadWrite);
  let bad = t_run(b.db, "insert into part (sku, price) values ('a', 1)", []);
  assert_eq(t_code(bad.out), "23505");
  assert_eq(t_code(t_out(bad.db, "select count(*) from part", [])), "25P02");
  // The server tags this `ROLLBACK` with no error; `Count(0)` would tell the caller lost writes are durable.
  let c = commit_step(bad.db);
  assert_eq(t_code(c.out), "25P02");
  assert_eq(t_count(t_out(c.db, "select count(*) from part", [])), 3)
}

test "rolling back to a savepoint clears the failed state and the inner writes" {
  let d0 = t_seed();
  let b = begin_step(d0, ReadCommitted, ReadWrite);
  let i = t_run(b.db, "insert into part (sku, price) values ('z', 1)", []);
  let sp = begin_step(i.db, ReadCommitted, ReadWrite);
  let bad = t_run(sp.db, "insert into part (sku, price) values ('z', 2)", []);
  assert_eq(t_code(bad.out), "23505");
  let back = abort_step(bad.db);
  assert_eq(t_count(t_out(back.db, "select count(*) from part", [])), 4);
  let c = commit_step(back.db);
  assert_eq(t_count(t_out(c.db, "select count(*) from part", [])), 4)
}

test "releasing a savepoint in an aborted transaction is 25P02 and commits nothing" {
  let d0 = t_seed();
  let b = begin_step(d0, ReadCommitted, ReadWrite);
  let i = t_run(b.db, "insert into part (sku, price) values ('z', 1)", []);
  let sp = begin_step(i.db, ReadCommitted, ReadWrite);
  let bad = t_run(sp.db, "insert into part (sku, price) values ('z', 2)", []);
  let rel = commit_step(bad.db);
  assert_eq(t_code(rel.out), "25P02");
  // Releasing did not un-abort the transaction, so the outer commit is `25P02` too.
  let c = commit_step(rel.db);
  assert_eq(t_code(c.out), "25P02");
  assert_eq(t_count(t_out(c.db, "select count(*) from part", [])), 3)
}

test "a sequence is not rolled back" {
  let d0 = t_seed();
  let b = begin_step(d0, ReadCommitted, ReadWrite);
  let i = t_run(b.db, "insert into bin (sku, qty) values ('a', 1) returning id", []);
  assert_eq(i.out, Rows([map_insert(map_new(), "id", CInt(1))]));
  let a = abort_step(i.db);
  let j = t_run(a.db, "insert into bin (sku, qty) values ('a', 2) returning id", []);
  assert_eq(j.out, Rows([map_insert(map_new(), "id", CInt(2))]))
}

test "a write in a read-only scope is 25006 and a nested begin at another level is 25001" {
  let d0 = t_seed();
  let ro = begin_step(d0, ReadCommitted, ReadOnly);
  assert_eq(t_code(t_out(ro.db, "insert into part (sku, price) values ('z', 1)", [])), "25006");
  assert_eq(t_count(t_out(ro.db, "select count(*) from part", [])), 3);
  let rw = begin_step(d0, Serializable, ReadWrite);
  let nested = begin_step(rw.db, ReadCommitted, ReadWrite);
  assert_eq(t_code(nested.out), "25001")
}

test "the savepoint stack is bounded" {
  assert_eq(
    t_code(
      t_deepen(begin_step(open(t_schema()), ReadCommitted, ReadWrite).db, max_savepoints() + 1).out,
    ),
    "54000",
  )
}

fn t_deepen(db: MemDb, left: Int) -> Outcome = {
  let r = begin_step(db, ReadCommitted, ReadWrite);
  if left <= 1 { r } else { t_deepen(r.db, left - 1) }
}

test "what the twin does not model, it refuses by name" {
  let d = t_seed();
  let refused = [
    "select p.sku from part p join bin b on p.sku = b.sku",
    "select sku from part where sku in (select sku from bin)",
    "select count(*), sku from part group by sku",
    "select sum(n) from part",
    "select sku from part union select sku from bin",
    "with x as (select 1) select sku from part",
    "insert into part (sku, price) values ('a', 1) on conflict do nothing",
    "select sku from part; select 1 from part",
    "create table t (a int)",
    "select sku from part order by n + 1",
    "select sku from part where tag like 'a%' escape '!'",
    "select 1e3 from part",
    "select now() from part",
    "select sku from part order by 1",
  ];
  assert_eq(map(refused, |s: String| t_code(t_out(d, s, []))), map(refused, |s: String| "0A000"))
}

test "a comment and a result-column alias are ordinary SQL rather than a refusal" {
  let d = t_seed();
  assert_eq(t_code(t_out(d, "select sku from part -- trailing", [])), "rows");
  assert_eq(t_code(t_out(d, "select /* leading */ sku from part order by sku", [])), "rows");
  assert_eq(t_code(t_out(d, "select /* a /* nested */ one */ sku from part", [])), "rows");
  assert_eq(
    t_out(d, "select sku as ident from part order by sku", []),
    Rows([
      map_insert(map_new(), "ident", CText("a")),
      map_insert(map_new(), "ident", CText("b")),
      map_insert(map_new(), "ident", CText("c")),
    ]),
  );
  assert_eq(
    t_out(d, "select count(*) as c from part", []),
    Rows([map_insert(map_new(), "c", CInt(3))]),
  );
  // Two targets under one name are still refused: a `Row` is a `Map`.
  assert_eq(t_code(t_out(d, "select sku, sku from part", [])), "0A000");
  assert_eq(t_code(t_out(d, "select sku as x, tag as x from part", [])), "0A000");
  // An unclosed comment is a refusal rather than a statement that lost its tail.
  assert_eq(t_code(t_out(d, "select sku from part /* never closed", [])), "0A000")
}

test "an unknown relation and an unknown column are named" {
  let d = t_seed();
  assert_eq(t_code(t_out(d, "select sku from nosuch order by sku", [])), "42P01");
  assert_eq(t_code(t_out(d, "select nosuch from part", [])), "42703");
  assert_eq(t_code(t_out(d, "select sku from part order by nosuch", [])), "42703")
}

test "a text parameter in an integer column is refused rather than coerced" {
  let d = open(t_schema());
  assert_eq(
    t_code(t_out(d, "insert into part (sku, price, n) values ('a', 1, $1)", [PText("x")])),
    "42804",
  );
  assert_eq(t_code(t_out(d, "insert into part (sku, price, n) values ('a', 1, 'x')", [])), "22P02")
}

test "a parameter numbered past the ones given, or below one, is refused" {
  let d = open(t_schema());
  assert_eq(
    t_code(t_out(d, "insert into part (sku, price) values ($2, 1)", [PText("a")])),
    "42P02",
  );
  assert_eq(t_code(t_out(d, "insert into part (sku, price) values ($0, 1)", [PText("a")])), "42P02")
}

fn t_heard(channel: String, payload: String) -> Notice =
  Notified({ sender: 0, channel: channel, payload: payload })

fn t_listening() -> MemDb = listen_step(open({ tables: [] }), "jobs").db

fn t_notified(db: MemDb, payload: String) -> MemDb = notify_step(db, "jobs", payload).db

fn t_begun(db: MemDb) -> MemDb = begin_step(db, ReadCommitted, ReadWrite).db

test "the twin delivers a notification when its transaction commits, and never when it rolls back" {
  let queued = t_notified(t_notified(t_begun(t_listening()), "a"), "a");
  assert_eq(notified_step(queued).notice, Quiet);
  let others = notify_step(queued, "audit", "x").db;
  let committed = notified_step(commit_step(others).db);
  // Two with one payload in one transaction are heard once, and a channel nobody hears is dropped.
  assert_eq(committed.notice, t_heard("jobs", "a"));
  assert_eq(notified_step(committed.db).notice, Quiet);
  let rolled = abort_step(t_notified(t_begun(committed.db), "b")).db;
  assert_eq(notified_step(rolled).notice, Quiet);
  let now = t_notified(rolled, "c");
  assert_eq(notified_step(now).notice, t_heard("jobs", "c"))
}

test "a savepoint rolled back takes back what it notified, and leaves what the transaction did" {
  let outer = t_notified(t_begun(t_listening()), "kept");
  let inner = abort_step(t_notified(t_begun(outer), "undone")).db;
  let first = notified_step(commit_step(inner).db);
  assert_eq(first.notice, t_heard("jobs", "kept"));
  assert_eq(notified_step(first.db).notice, Quiet)
}

test "a notification the twin refuses is refused as the server refuses it" {
  let long = string_of_bytes(bytes_concat_all(map(range(0, 8000), |i: Int| b"x")));
  assert_eq(t_code(notify_step(t_listening(), "jobs", long).out), "22023");
  let failed = t_run(t_begun(t_listening()), "select * from missing", []).db;
  assert_eq(t_code(notify_step(failed, "jobs", "x").out), "25P02")
}

test "a cut listener loses what it held and what is sent until its next wait, which says so" {
  let held = t_notified(t_listening(), "before");
  let cut = cut_step(held);
  let lost = t_notified(cut, "during");
  let back = notified_step(lost);
  assert_eq(back.notice, Reconnected);
  assert_eq(notified_step(back.db).notice, Quiet);
  let after = notified_step(t_notified(back.db, "after"));
  assert_eq(after.notice, t_heard("jobs", "after"));
  let unheard = unlisten_step(after.db, "jobs").db;
  assert_eq(unheard.listener.channels, []);
  assert_eq(t_notified(unheard, "gone").listener.inbox, [])
}

/// What cuts the listener's connection in a law's run.
effect outage {
  write cut() -> Unit
}

/// `body` over a twin of no tables, its transactions, notifications on `jobs` and outages answered
/// from the twin.
fn on_twin<a | e>(
  body: () -> a / {db.begin, db.commit, db.abort, db.notify[jobs], db.listen[jobs], db.notified, outage.cut | e},
) -> a / {abort.raise | e} =
  with_cell[twin](open({ tables: [] })) { t -> {
    let stepped = |o: Outcome| {
      cell_set(t, o.db);
      o.out
    };
    handle {
      body()
    } with {
      db.begin(level, access) -> stepped(begin_step(cell_get(t), level, access)),
      db.commit() -> stepped(commit_step(cell_get(t))),
      db.abort() -> stepped(abort_step(cell_get(t))),
      db.notify[jobs](payload) -> stepped(notify_step(cell_get(t), "jobs", payload)),
      db.listen[jobs]() -> stepped(listen_step(cell_get(t), "jobs")),
      db.notified(timeout_ms) -> {
        let w = notified_step(cell_get(t));
        cell_set(t, w.db);
        w.notice
      },
      outage.cut() -> cell_set(t, cut_step(cell_get(t))),
    }
  } }

/// How often something happens in a law's run: a domain small enough to search whole.
type Times = | Never | Once | Twice

fn times(t: Times) -> Int = match t { Never -> 0, Once -> 1, Twice -> 2 }

/// `waits` waits, each followed by a yield, and what each answered.
fn t_waits(waits: Int) -> List<Notice> / {db.notified, task.yield} =
  fold(range(0, waits), [], |heard: List<Notice>, i: Int| {
    let n = db.notified(100);
    task.yield();
    push(heard, n)
  })

/// Whether the notifications `0` to `sent - 1` were heard in order, each one missing told by a
/// `Reconnected` between the last one heard before it and the next one heard after it, or at the end.
fn announced(heard: List<Notice>, sent: Int) -> Bool / {abort.raise} = {
  let walked = fold(
    heard,
    { next: 0, warned: false, ok: true },
    |at: { next: Int, warned: Bool, ok: Bool }, n: Notice|
      match n {
        Reconnected -> { ..at, warned: true },
        Notified(note) -> match string::int_of_string(note.payload) {
          Some(i) -> if i == at.next { { next: i + 1, warned: false, ok: at.ok } }
          else if i > at.next && at.warned { { next: i + 1, warned: false, ok: at.ok } }
          else { { ..at, ok: false } },
          None -> { ..at, ok: false },
        },
        _ -> at,
      },
  );
  walked.ok && (walked.next == sent || walked.warned)
}

law "a listener over the twin hears what is committed while it listens, in order, and is told of every loss, in every interleaving"
  forall (sent: Times, cut: Times) {
    simulate {
      let n = times(sent) + 1;
      let heard = on_twin(|| {
        db.listen[jobs]();
        let notifier = task.spawn(||
          fold(range(0, n), (), |u: Unit, i: Int| {
            transaction(ReadCommitted, ReadWrite, || db.notify[jobs](int_to_string(i)));
            task.yield()
          }));
        let cutter = task.spawn(||
          fold(range(0, times(cut)), (), |u: Unit, i: Int| {
            task.yield();
            outage.cut()
          }));
        let early = t_waits(n + 1);
        task.join(notifier);
        task.join(cutter);
        concat(early, t_waits(n + 2))
      });
      let delivered = filter(heard, |h: Notice| match h { Notified(_) -> true, _ -> false });
      announced(heard, n)
        && (cut != Never || (len(delivered) == n && !contains(heard, Reconnected)))
    }
  }

// --- A live server ---------------------------------------------------------------
//
// The effect's own handler, over `std.pg`. A perform names its label — the table — and a clause
// written `[*]` answers every one of them, so the driver is here rather than in the host: the
// pool, the transaction scope, the text of every value and the tables a statement names. What is
// left to the host is `net`.

/// Whether the driver's connections are secured: not at all; with TLS after asking the server, as
/// `sslmode=require`, `verify-ca` and `verify-full` ask; or with TLS at once, as
/// `sslnegotiation=direct` asks of a server from Postgres 17 on. Whenever TLS is asked for, the
/// server's certificate is verified for the host as `verify-full` verifies it, against the built-in
/// roots and `--trust`: `std.net` has no handshake that skips verification, so `require` and
/// `verify-ca` here are `verify-full`, never libpq's weaker readings of them.
pub type Ssl = | Disabled | Negotiated | Immediate

/// Where the driver connects, and what each connection starts with; `server` makes one with no
/// settings, and `server_of` reads one from a connection string. The password is sealed from where
/// it is read to the wire.
pub type Server = {
  host: String,
  port: Int,
  ssl: Ssl,
  user: String,
  database: String,
  password: Option<Secret<Bytes>>,
  /// Told to the server as each connection starts, so every connection the pool opens runs under
  /// them: how long one statement may run, and a transaction sit idle between statements, before the
  /// server ends it, in milliseconds (`None` leaves the server's own), and the name its sessions are
  /// listed under.
  statement_timeout_ms: Option<Int>,
  idle_in_transaction_timeout_ms: Option<Int>,
  application_name: Option<String>,
  client: pg::Client,
}

/// A server reached in plaintext, with none of the start-up settings.
pub fn server(
  host: String,
  port: Int,
  user: String,
  database: String,
  password: Option<Secret<Bytes>>,
) -> Server =
  {
    host: host,
    port: port,
    ssl: Disabled,
    user: user,
    database: database,
    password: password,
    statement_timeout_ms: None,
    idle_in_transaction_timeout_ms: None,
    application_name: None,
    client: pg::default_client(),
  }

/// The settings a connection starts with, under the names postgres gives them.
pub fn startup_parameters(s: Server) -> List<pg::Set> =
  concat(
    concat(
      parameter("application_name", s.application_name),
      parameter("statement_timeout", millis_text(s.statement_timeout_ms)),
    ),
    parameter("idle_in_transaction_session_timeout", millis_text(s.idle_in_transaction_timeout_ms)),
  )

fn parameter(name: String, value: Option<String>) -> List<pg::Set> =
  match value { Some(v) -> [{ name: name, value: v }], None -> [] }

fn millis_text(ms: Option<Int>) -> Option<String> =
  match ms { Some(n) -> Some(int_to_string(n)), None -> None }

/// `n` numbers a connection among every one the pool has opened.
type Link = { n: Int, session: pg::Session }

/// A transaction on connection `n`: `session` is `None` once the connection is lost, which ended the
/// transaction on the server; `depth` counts the transaction and its savepoints; `level` and
/// `access` are its outermost `begin`'s; `busy` while one of its operations is on the wire;
/// `copying` while a copy holds its connection, which then runs nothing else.
type Scope = {
  n: Int,
  session: Option<pg::Session>,
  depth: Int,
  level: Isolation,
  access: Access,
  busy: Bool,
  copying: Bool,
}

/// A copy under way, numbered `id`, on connection `n`: its session, `None` while one of its
/// operations is on the wire or once the server has sent all of a copy out; whether the connection
/// is a transaction's; and for a copy out, the columns its rows are read as, what has arrived of
/// rows not yet taken, whether the server has sent every one, how many were taken, and what failed
/// it, if anything did.
type Copy = {
  id: Int,
  n: Int,
  session: Option<pg::Session>,
  within: Bool,
  out: Bool,
  columns: List<pg::Column>,
  pending: Bytes,
  done: Bool,
  taken: Int,
  failed: Option<DbError>,
}

/// The listening connection: its session, `None` until one is opened and once it is lost; the
/// channels it listens on; whether a wait is on the wire; and whether it was lost, which the wait
/// that opens a new one answers `Reconnected` for.
type Listener = {
  session: Option<pg::Session>,
  channels: List<String>,
  waiting: Bool,
  lost: Bool,
  made: Int,
}

/// `opened` counts the connections open, which `size` bounds, and `made` every one ever opened;
/// `copied` numbers the copies begun. The listener's connection is not the pool's.
type Pool = {
  idle: List<Link>,
  opened: Int,
  made: Int,
  open: List<Scope>,
  copies: List<Copy>,
  copied: Int,
  listener: Listener,
}

// --- The text of a value ---------------------------------------------------------

fn hex_of(b: Bytes) -> String =
  fold(range(0, bytes_len(b)), "", |acc: String, i: Int| {
    let v = bytes_at(b, i);
    acc ++ string_slice("0123456789abcdef", v >>> 4, (v >>> 4) + 1)
      ++ string_slice("0123456789abcdef", v & 0xF, (v & 0xF) + 1)
  })

fn hex_value(c: Int) -> Int =
  if c >= 48 && c <= 57 { c - 48 }
  else if c >= 97 && c <= 102 { c - 87 }
  else if c >= 65 && c <= 70 { c - 55 }
  else { 0 }

fn unhex_text(text: String) -> Bytes / {abort.raise} = {
  let b = bytes_of_string(text);
  bytes_concat_all(
    map(range(0, bytes_len(b) / 2), |i: Int|
      byte_of_int(hex_value(bytes_at(b, i * 2)) * 16 + hex_value(bytes_at(b, i * 2 + 1)))),
  )
}

/// Bytea's hex output is introduced by `\x`; the older escape format is read as its own bytes.
fn bytes_of_bytea(text: String) -> Bytes / {abort.raise} =
  if string_starts_with(text, "\\x") { unhex_text(string_slice(text, 2, string_len(text))) }
  else { bytes_of_string(text) }

/// The integer `text` writes in decimal, and zero for a text that writes none.
fn int_or_zero(text: String) -> Int / {abort.raise} =
  option_unwrap_or(string::int_of_string(text), 0)

fn float_of_text(text: String) -> Float = match float_of_string(text) { Some(f) -> f, None -> 0.0 }

fn json_of_text(text: String) -> json::Json / {abort.raise} =
  match json::parse_string(text) { Ok(j) -> j, Err(_) -> json::Str(text) }

/// The element type of an array type, or `0` when the OID is not one this reads.
fn element_oid(oid: Int) -> Int =
  if oid == 1000 { 16 }
  else if oid == 1001 { 17 }
  else if oid == 1005 { 21 }
  else if oid == 1007 { 23 }
  else if oid == 1016 { 20 }
  else if oid == 1009 { 25 }
  else if oid == 1015 { 1043 }
  else if oid == 1021 { 700 }
  else if oid == 1022 { 701 }
  else if oid == 1231 { 1700 }
  else if oid == 199 { 114 }
  else if oid == 3807 { 3802 }
  else { 0 }

/// An array's text is `{...}`, elements separated by commas, quoted when they need to be, and the
/// word `NULL` bare — so a quoted `NULL` is the text and an unquoted one is nothing.
type Scanning = {
  items: List<Datum>,
  piece: String,
  quoted: Bool,
  was_quoted: Bool,
  escaped: Bool,
  done: Bool,
}

fn array_values(element: Int, text: String) -> List<Datum> / {abort.raise} = {
  let inner = if string_len(text) >= 2 { string_slice(text, 1, string_len(text) - 1) } else { "" };
  let end = fold(
    range(0, string_len(inner)),
    { items: [], piece: "", quoted: false, was_quoted: false, escaped: false, done: false },
    |acc: Scanning, i: Int|
      if acc.done { acc } else {
        let c = string_slice(inner, i, i + 1);
        if acc.escaped { { ..acc, piece: acc.piece ++ c, escaped: false } }
        else if acc.quoted && c == "\\" { { ..acc, escaped: true } }
        else if c == "\"" { { ..acc, quoted: !acc.quoted, was_quoted: true } }
        else if !acc.quoted && c == "," {
          {
            ..acc,
            items: push(acc.items, array_value(element, acc.piece, acc.was_quoted)),
            piece: "",
            was_quoted: false,
          }
        } else { { ..acc, piece: acc.piece ++ c } }
      },
  );
  if string_len(inner) == 0 { [] }
  else { push(end.items, array_value(element, end.piece, end.was_quoted)) }
}

/// An element is never an array itself: `element_oid` answers only scalar types.
fn array_value(element: Int, piece: String, was_quoted: Bool) -> Datum / {abort.raise} =
  if !was_quoted && piece == "NULL" { CNull } else { scalar_datum(element, piece) }

fn datum_of(oid: Int, text: Option<String>) -> Datum / {abort.raise} =
  match text {
    None -> CNull,
    Some(t) -> if element_oid(oid) != 0 { CArray(array_values(element_oid(oid), t)) }
    else { scalar_datum(oid, t) },
  }

fn scalar_datum(oid: Int, t: String) -> Datum / {abort.raise} =
  if oid == 16 { CBool(t == "t") }
  else if oid == 20 || oid == 21 || oid == 23 { CInt(int_or_zero(t)) }
  else if oid == 700 || oid == 701 { CFloat(float_of_text(t)) }
  else if oid == 1700 { CNumeric(option_unwrap_or(decimal_of_string(t), decimal_of_int(0))) }
  else if oid == 17 { CBytes(bytes_of_bytea(t)) }
  else if oid == 114 || oid == 3802 { CJson(json_of_text(t)) }
  else { CText(t) }

/// What the server sent for one column: text, except that bytea's hex form and the text of every
/// other type are read by `datum_of`. `string_of_bytes_lossy` because a bytea is bytes, not text.
fn datum_bytes(oid: Int, raw: Option<Bytes>) -> Datum / {abort.raise} =
  match raw { None -> CNull, Some(b) -> datum_of(oid, Some(string_of_bytes_lossy(b))) }

fn param_text(p: Param) -> Option<String> / {abort.raise} =
  match p {
    PNull -> None,
    PInt(n) -> Some(int_to_string(n)),
    PBool(b) -> Some(if b { "t" } else { "f" }),
    PText(s) -> Some(s),
    PBytes(b) -> Some("\\x" ++ hex_of(b)),
    PFloat(f) -> Some(float_to_string(f)),
    PNumeric(d) -> Some(decimal_to_string(d)),
    PJson(j) -> Some(json::to_string(j)),
    PArray(items) ->
      Some("{" ++ string::join(map(items, |p: Param| array_element_text(p)), ",") ++ "}"),
  }

/// An array element is always quoted, which is the one form whose escaping is two characters.
fn array_element_text(p: Param) -> String / {abort.raise} =
  match param_text(p) {
    None -> "NULL",
    Some(t) ->
      "\""
        ++ fold(range(0, string_len(t)), "", |acc: String, i: Int| {
          let c = string_slice(t, i, i + 1);
          if c == "\"" || c == "\\" { acc ++ "\\" ++ c } else { acc ++ c }
        })
        ++ "\"",
  }

// --- The answer a statement makes ------------------------------------------------

fn last_word(text: String) -> Option<String> =
  fold(string_split(text, " "), None, |acc: Option<String>, w: String|
    if string_len(w) > 0 { Some(w) } else { acc })

/// `SELECT 3`, `INSERT 0 1`, `UPDATE 2`: the count is the tag's last number, and a tag with none
/// (`BEGIN`) counts nothing.
fn count_of(tag: String) -> Int / {abort.raise} =
  match last_word(tag) { Some(w) -> int_or_zero(w), None -> 0 }

fn row_of(
  columns: List<pg::Column>,
  values: List<Option<Bytes>>,
  i: Int,
  acc: Row,
) -> Row / {abort.raise} =
  if i >= len(columns) { acc } else {
    match list_at(columns, i) {
      None -> acc,
      Some(column) -> {
        let raw = match list_at(values, i) { Some(v) -> v, None -> None };
        row_of(columns, values, i + 1, map_insert(acc, column.name, datum_bytes(column.ty, raw)))
      },
    }
  }

fn rows_of(
  columns: List<pg::Column>,
  rows: List<List<Option<Bytes>>>,
) -> List<Row> / {abort.raise} =
  map(rows, |r: List<Option<Bytes>>| row_of(columns, r, 0, map_new()))

// --- The scope a statement runs in -----------------------------------------------

fn isolation_sql(level: Isolation) -> String =
  match level {
    ReadCommitted -> "read committed",
    RepeatableRead -> "repeatable read",
    Serializable -> "serializable",
  }

fn access_sql(access: Access) -> String =
  match access { ReadWrite -> "read write", ReadOnly -> "read only" }

fn savepoint_name(depth: Int) -> String = "ply_sp" ++ int_to_string(depth)

// --- The handler's decisions -----------------------------------------------------
//
// Every operation takes what it will use from the pool before it sends a byte and settles what it
// used after, because a task parked on the wire lets another task's operation run in between.

/// A handler cannot see which task performs an operation, so it goes by which transactions are
/// between statements: the performer's own is never on the wire, because its task is the one running.
type Route = | Own(Scope) | NoTransaction | Ambiguous

fn route(open: List<Scope>) -> Route =
  match filter(open, |s: Scope| !s.busy) { [] -> NoTransaction, [s] -> Own(s), _ -> Ambiguous }

fn ambiguous(what: String) -> String =
  what
    ++ " was performed while two transactions were between statements, so which one it belongs to is unknown: a transaction is told apart by being the one not waiting on the server, so a task that holds one open must wait on nothing but its own statements"

/// A connection for an operation outside any transaction, idle or still to be opened.
type Claim = | Idle(Link) | Fresh(Int)

fn claim_n(c: Claim) -> Int = match c { Idle(l) -> l.n, Fresh(n) -> n }

type Plan = | Answered(Answer) | Outside(Claim) | Within(Scope, pg::Session)

type Decided = { pool: Pool, plan: Plan }

fn outside(p: Pool, size: Int) -> Decided =
  match p.idle {
    [first, ..rest] -> { pool: { ..p, idle: rest }, plan: Outside(Idle(first)) },
    [] -> if p.opened >= size { { pool: p, plan: Answered(Failed(pool_busy(size))) } } else {
      { pool: { ..p, opened: p.opened + 1, made: p.made + 1 }, plan: Outside(Fresh(p.made)) }
    },
  }

fn pool_busy(size: Int) -> DbError =
  db_error("53300", "", "the pool of " ++ int_to_string(size) ++ " connection(s) is busy")

fn within(p: Pool, scope: Scope) -> Decided =
  if scope.copying { { pool: p, plan: Answered(Failed(copy_holds())) } } else {
    match scope.session {
      None -> { pool: p, plan: Answered(Failed(connection_lost())) },
      Some(session) -> { pool: busy(p, scope.n), plan: Within(scope, session) },
    }
  }

fn copy_holds() -> DbError =
  db_error(
    "55000",
    "",
    "a copy holds this transaction's connection, which runs nothing else until the copy ends",
  )

fn busy(p: Pool, n: Int) -> Pool =
  { ..p, open: map(p.open, |s: Scope| if s.n == n { { ..s, busy: true } } else { s }) }

fn for_statement(p: Pool, size: Int, what: String) -> Decided / {abort.raise} =
  match route(p.open) {
    Ambiguous -> panic(ambiguous(what)),
    Own(scope) -> within(p, scope),
    NoTransaction -> outside(p, size),
  }

/// A `begin` inside the performer's transaction is a savepoint of it; any other opens a transaction
/// on a connection of its own.
fn for_begin(p: Pool, size: Int, level: Isolation, access: Access) -> Decided / {abort.raise} =
  match route(p.open) {
    Ambiguous -> panic(ambiguous("`db.begin`")),
    NoTransaction -> outside(p, size),
    Own(scope) -> match scope.session {
      None -> within(p, scope),
      Some(s) -> match nested_refusal(
          s.status == pg::FailedTransaction,
          scope.depth,
          scope.level,
          scope.access,
          level,
          access,
        ) {
        Some(e) -> { pool: p, plan: Answered(Failed(e)) },
        None -> within(p, scope),
      },
    },
  }

type Closing = | Settled(Answer) | Closes(Scope, pg::Session)

type ToClose = { pool: Pool, closing: Closing }

/// A transaction whose connection is lost has nothing to send: the server ended it when the
/// connection went, and `lost` is the answer.
fn for_close(p: Pool, what: String, lost: Answer) -> ToClose / {abort.raise} =
  match route(p.open) {
    Ambiguous -> panic(ambiguous(what)),
    NoTransaction -> { pool: p, closing: Settled(Failed(no_transaction(what))) },
    Own(scope) -> if scope.copying { { pool: p, closing: Settled(Failed(copy_holds())) } } else {
      match scope.session {
        None -> { pool: { ..p, open: without_scope(p.open, scope) }, closing: Settled(lost) },
        Some(session) -> { pool: busy(p, scope.n), closing: Closes(scope, session) },
      }
    },
  }

fn without_scope(open: List<Scope>, scope: Scope) -> List<Scope> = {
  let others = filter(open, |s: Scope| s.n != scope.n);
  if scope.depth > 1 { push(others, { ..scope, depth: scope.depth - 1 }) } else { others }
}

/// A connection let go of: still talking, and so back to the pool, or closed.
type Freed = | Reuse(Link) | Lost

/// What an operation on connection `n` leaves: `scope` is its transaction as it now stands, `None`
/// when there is none or it ended.
type Left = { answer: Answer, n: Int, scope: Option<Scope>, freed: Option<Freed> }

fn settle(p: Pool, left: Left) -> Pool = {
  let others = filter(p.open, |s: Scope| s.n != left.n);
  let q = { ..p, open: match left.scope { Some(s) -> push(others, s), None -> others } };
  match left.freed {
    None -> q,
    Some(Reuse(l)) -> { ..q, idle: push(q.idle, l) },
    Some(Lost) -> { ..q, opened: q.opened - 1 },
  }
}

// --- The errors a connection makes -----------------------------------------------

/// A refusal is the server's own SQLSTATE; a conversation that failed is class `08`, the connection
/// exceptions.
fn client_error(e: pg::ClientError) -> DbError =
  match e {
    pg::Rejected(_, s) -> server_error(s),
    pg::Refused(s) -> server_error(s),
    pg::Unreachable -> db_error("08001", "", pg::client_error_text(e)),
    pg::Declined -> db_error("08001", "", pg::client_error_text(e)),
    pg::Unsecured(_) -> db_error("08001", "", pg::client_error_text(e)),
    pg::Unexpected(what) -> db_error("08P01", "", what),
    _ -> db_error("08006", "", pg::client_error_text(e)),
  }

fn server_error(s: pg::Server) -> DbError = {
  let said = if s.detail == "" { s.message } else { s.message ++ ": " ++ s.detail };
  db_error(s.code, s.constraint, said)
}

fn connection_lost() -> DbError =
  db_error(
    "08003",
    "",
    "the connection this transaction ran on was lost, and the transaction with it",
  )

/// A `commit` the connection failed under may have been applied or not.
fn unresolved(e: pg::ClientError) -> DbError =
  db_error(
    "08007",
    "",
    "the connection failed before the server answered the commit: " ++ pg::client_error_text(e),
  )

type Ran = { session: pg::Session, answer: Answer }

/// The statement's own check, before it takes a connection: what `ply check` holds a statement it
/// can read to, raised here for one it could not. A statement's tables are a function of its text
/// rather than of the call's label, so a join reaches tables the label never named, and the atom
/// the scheduler records is the label's, so the label has to be one of them.
fn check_statement(
  s: Stmt,
  operation: Operation,
  label: String,
  what: String,
) -> Unit / {abort.raise} =
  match sql::checked(
      None,
      { dialect: Postgres, operation: operation, label: Some(label), given: None, row: None },
      s.sql,
    ) {
    [] -> (),
    [f, ..] -> panic(what ++ " refuses this statement: " ++ f.message),
  }

fn run_checked(
  session: pg::Session,
  s: Stmt,
  ps: List<Param>,
  rows: Bool,
  cfg: Server,
) -> Result<Ran, pg::ClientError> / {net.send[link], net.recv[link], abort.raise, diverges} =
  match pg::extended_query[link](
      session,
      s.sql,
      map(ps, |param: Param| param_text(param)),
      cfg.client,
    ) {
    Err(e) -> Err(e),
    Ok(reply) ->
      Ok({
        session: reply.session,
        answer: if rows { Rows(rows_of(reply.answer.columns, reply.answer.rows)) }
        else { Count(count_of(reply.answer.tag)) },
      }),
  }

/// A statement the driver itself sends.
fn control(
  session: pg::Session,
  sql: String,
  cfg: Server,
) -> Result<pg::Reply, pg::ClientError> / {net.send[link], net.recv[link], abort.raise, diverges} =
  pg::simple_query[link](session, sql, cfg.client)

/// How a connection to `cfg` is secured: verified as the host it was told to reach.
fn tls_of(cfg: Server) -> pg::Tls =
  match cfg.ssl {
    Disabled -> pg::NoTls,
    Negotiated -> pg::Requested(cfg.host),
    Immediate -> pg::Direct(cfg.host),
  }

fn linked(
  cfg: Server,
  nonce: String,
  c: Claim,
) -> Result<Link, DbError> / {net.connect[link], net.start_tls[link], net.peer_certificate[link], net.send[link], net.send_secret[link], net.recv[link], net.close[link], abort.raise, diverges} =
  match c {
    Idle(l) -> Ok(l),
    Fresh(n) -> match pg::connect[link](
        cfg.host,
        cfg.port,
        tls_of(cfg),
        cfg.user,
        cfg.database,
        startup_parameters(cfg),
        cfg.password,
        nonce ++ "-" ++ int_to_string(n),
        cfg.client,
      ) {
      Err(e) -> Err(client_error(e)),
      Ok(session) -> Ok({ n: n, session: session }),
    },
  }

/// An exchange outside any transaction that failed: a refusal leaves the server talking on the
/// connection, and anything else ends it.
fn let_go(
  l: Link,
  e: pg::ClientError,
  cfg: Server,
) -> Left / {net.send[link], net.close[link], abort.raise} =
  match e {
    pg::Rejected(session, server) ->
      {
        answer: Failed(server_error(server)),
        n: l.n,
        scope: None,
        freed: Some(Reuse({ ..l, session: session })),
      },
    _ -> {
      pg::finish[link](l.session, cfg.client);
      { answer: Failed(client_error(e)), n: l.n, scope: None, freed: Some(Lost) }
    },
  }

/// A transaction's scope after an exchange on its connection, `deeper` scopes more or fewer.
fn kept(scope: Scope, session: pg::Session, deeper: Int) -> Scope =
  { ..scope, session: Some(session), depth: scope.depth + deeper, busy: false }

/// An exchange inside a transaction that failed: a refusal leaves the transaction where it stood,
/// and anything else loses its connection and the transaction with it.
fn failed_within(
  scope: Scope,
  session: pg::Session,
  e: pg::ClientError,
  cfg: Server,
  deeper: Int,
) -> Left / {net.send[link], net.close[link], abort.raise} =
  match e {
    pg::Rejected(after, server) ->
      {
        answer: Failed(server_error(server)),
        n: scope.n,
        scope: Some(kept(scope, after, deeper)),
        freed: None,
      },
    _ -> {
      pg::finish[link](session, cfg.client);
      {
        answer: Failed(client_error(e)),
        n: scope.n,
        scope: Some({ ..scope, session: None, depth: scope.depth + deeper, busy: false }),
        freed: Some(Lost),
      }
    },
  }

fn statement_outside(
  cfg: Server,
  nonce: String,
  c: Claim,
  s: Stmt,
  ps: List<Param>,
  rows: Bool,
) -> Left / {net.connect[link], net.start_tls[link], net.peer_certificate[link], net.send[link], net.send_secret[link], net.recv[link], net.close[link], abort.raise, diverges} =
  match linked(cfg, nonce, c) {
    Err(e) -> { answer: Failed(e), n: claim_n(c), scope: None, freed: Some(Lost) },
    Ok(l) -> match run_checked(l.session, s, ps, rows, cfg) {
      Ok(ran) ->
        {
          answer: ran.answer,
          n: l.n,
          scope: None,
          freed: Some(Reuse({ ..l, session: ran.session })),
        },
      Err(e) -> let_go(l, e, cfg),
    },
  }

fn statement_within(
  cfg: Server,
  scope: Scope,
  session: pg::Session,
  s: Stmt,
  ps: List<Param>,
  rows: Bool,
) -> Left / {net.send[link], net.recv[link], net.close[link], abort.raise, diverges} =
  match run_checked(session, s, ps, rows, cfg) {
    Ok(ran) ->
      { answer: ran.answer, n: scope.n, scope: Some(kept(scope, ran.session, 0)), freed: None },
    Err(e) -> failed_within(scope, session, e, cfg, 0),
  }

fn opening(
  cfg: Server,
  nonce: String,
  c: Claim,
  level: Isolation,
  access: Access,
) -> Left / {net.connect[link], net.start_tls[link], net.peer_certificate[link], net.send[link], net.send_secret[link], net.recv[link], net.close[link], abort.raise, diverges} =
  match linked(cfg, nonce, c) {
    Err(e) -> { answer: Failed(e), n: claim_n(c), scope: None, freed: Some(Lost) },
    Ok(l) -> match control(
        l.session,
        "begin isolation level " ++ isolation_sql(level) ++ " " ++ access_sql(access),
        cfg,
      ) {
      Ok(reply) ->
        {
          answer: Count(0),
          n: l.n,
          scope: Some({
            n: l.n,
            session: Some(reply.session),
            depth: 1,
            level: level,
            access: access,
            busy: false,
            copying: false,
          }),
          freed: None,
        },
      Err(e) -> let_go(l, e, cfg),
    },
  }

fn nesting(
  cfg: Server,
  scope: Scope,
  session: pg::Session,
) -> Left / {net.send[link], net.recv[link], net.close[link], abort.raise, diverges} =
  match control(session, "savepoint " ++ savepoint_name(scope.depth + 1), cfg) {
    Ok(reply) ->
      { answer: Count(0), n: scope.n, scope: Some(kept(scope, reply.session, 1)), freed: None },
    Err(e) -> failed_within(scope, session, e, cfg, 0),
  }

/// A transaction that has ended, its connection back in the pool.
fn ended(scope: Scope, session: pg::Session, answer: Answer) -> Left =
  { answer: answer, n: scope.n, scope: None, freed: Some(Reuse({ n: scope.n, session: session })) }

/// A `commit` closes its scope whatever the server answers: a savepoint's leaves the scope around
/// it, and a transaction's gives its connection back.
fn committing(
  cfg: Server,
  scope: Scope,
  session: pg::Session,
) -> Left / {net.send[link], net.recv[link], net.close[link], abort.raise, diverges} =
  if scope.depth > 1 {
    match control(session, "release savepoint " ++ savepoint_name(scope.depth), cfg) {
      Ok(reply) ->
        { answer: Count(0), n: scope.n, scope: Some(kept(scope, reply.session, -1)), freed: None },
      Err(e) -> failed_within(scope, session, e, cfg, -1),
    }
  } else {
    match control(session, "commit", cfg) {
      Ok(reply) -> ended(scope, reply.session, committed(reply.answer.tag)),
      Err(pg::Rejected(after, server)) -> ended(scope, after, Failed(server_error(server))),
      Err(e) -> {
        pg::finish[link](session, cfg.client);
        { answer: Failed(unresolved(e)), n: scope.n, scope: None, freed: Some(Lost) }
      },
    }
  }

/// The server ends an aborted transaction's `COMMIT` with a rollback, and no error.
fn committed(tag: String) -> Answer =
  if tag == "ROLLBACK" { Failed(in_failed_txn()) } else { Count(0) }

fn aborting(
  cfg: Server,
  scope: Scope,
  session: pg::Session,
) -> Left / {net.send[link], net.recv[link], net.close[link], abort.raise, diverges} =
  if scope.depth > 1 {
    // A savepoint outlives a rollback to it, so it is released too.
    let name = savepoint_name(scope.depth);
    match control(
        session,
        "rollback to savepoint " ++ name ++ "; release savepoint " ++ name,
        cfg,
      ) {
      Ok(reply) ->
        { answer: Count(0), n: scope.n, scope: Some(kept(scope, reply.session, -1)), freed: None },
      Err(e) -> failed_within(scope, session, e, cfg, -1),
    }
  } else {
    match control(session, "rollback", cfg) {
      Ok(reply) -> ended(scope, reply.session, Count(0)),
      Err(e) -> let_go({ n: scope.n, session: session }, e, cfg),
    }
  }

// --- Copies on a live server -------------------------------------------------------

/// Where a copy is to run: refused, on a connection outside any transaction, or on the performer's
/// transaction's.
type CopyClaim = | CopyRefused(DbError) | CopyOutside(Claim) | CopyWithin(Scope, pg::Session)

type ClaimedCopy = { pool: Pool, claim: CopyClaim }

fn for_copy(p: Pool, size: Int, what: String) -> ClaimedCopy / {abort.raise} =
  match route(p.open) {
    Ambiguous -> panic(ambiguous(what)),
    NoTransaction -> {
      let d = outside(p, size);
      match d.plan {
        Outside(c) -> { pool: d.pool, claim: CopyOutside(c) },
        Answered(Failed(e)) -> { pool: d.pool, claim: CopyRefused(e) },
        _ -> { pool: d.pool, claim: CopyRefused(pool_busy(size)) },
      }
    },
    Own(scope) -> if scope.copying { { pool: p, claim: CopyRefused(copy_holds()) } } else {
      match scope.session {
        None -> { pool: p, claim: CopyRefused(connection_lost()) },
        Some(session) ->
          {
            pool: {
              ..p,
              open: map(p.open, |s: Scope| if s.n == scope.n { { ..s, copying: true } } else { s }),
            },
            claim: CopyWithin(scope, session),
          },
      }
    },
  }

/// A copy as it began: the connection it holds and the columns of a copy out, or why it did not
/// begin, with the connection still talking or `None` once it is lost.
type Begun = {
  n: Int,
  within: Bool,
  session: Option<pg::Session>,
  columns: List<pg::Column>,
  failed: Option<DbError>,
}

/// `sql` sent on the connection `claim` names; `out` is the statement a copy out reads, whose
/// columns are described first.
fn copy_begun(
  cfg: Server,
  nonce: String,
  claim: CopyClaim,
  sql: String,
  out: Option<String>,
) -> Begun / {net.connect[link], net.start_tls[link], net.peer_certificate[link], net.send[link], net.send_secret[link], net.recv[link], net.close[link], abort.raise, diverges} =
  match claim {
    CopyRefused(e) -> { n: 0 - 1, within: false, session: None, columns: [], failed: Some(e) },
    CopyOutside(c) -> match linked(cfg, nonce, c) {
      Err(e) -> { n: claim_n(c), within: false, session: None, columns: [], failed: Some(e) },
      Ok(l) -> copy_on(cfg, l.n, false, l.session, sql, out),
    },
    CopyWithin(scope, session) -> copy_on(cfg, scope.n, true, session, sql, out),
  }

fn copy_on(
  cfg: Server,
  n: Int,
  within: Bool,
  session: pg::Session,
  sql: String,
  out: Option<String>,
) -> Begun / {net.send[link], net.recv[link], net.close[link], abort.raise, diverges} =
  match out {
    None -> match pg::copy_in_begin[link](session, sql, cfg.client) {
      Ok(c) -> { n: n, within: within, session: Some(c.session), columns: [], failed: None },
      Err(e) -> copy_refused(cfg, n, within, session, e),
    },
    Some(query) -> match pg::described[link](session, query, cfg.client) {
      Err(e) -> copy_refused(cfg, n, within, session, e),
      Ok(r) -> match pg::copy_out_begin[link](r.session, sql, cfg.client) {
        Ok(c) ->
          {
            n: n,
            within: within,
            session: Some(c.session),
            columns: r.answer.columns,
            failed: None,
          },
        Err(e) -> copy_refused(cfg, n, within, r.session, e),
      },
    },
  }

/// A copy that did not begin: a refusal leaves the server talking on the connection, and anything
/// else ends it.
fn copy_refused(
  cfg: Server,
  n: Int,
  within: Bool,
  session: pg::Session,
  e: pg::ClientError,
) -> Begun / {net.send[link], net.close[link], abort.raise} =
  match e {
    pg::Rejected(after, server) ->
      {
        n: n,
        within: within,
        session: Some(after),
        columns: [],
        failed: Some(server_error(server)),
      },
    _ -> {
      pg::finish[link](session, cfg.client);
      { n: n, within: within, session: None, columns: [], failed: Some(client_error(e)) }
    },
  }

/// The pool once a copy has let its connection go: back to its transaction, or to the idle ones,
/// while the server still talks on it; lost, and its transaction with it, otherwise.
fn let_copy_go(p: Pool, n: Int, within: Bool, session: Option<pg::Session>) -> Pool = {
  let counted = match session { Some(_) -> p, None -> { ..p, opened: p.opened - 1 } };
  if within {
    {
      ..counted,
      open: map(counted.open, |s: Scope|
        if s.n == n { { ..s, copying: false, session: session } } else { s }),
    }
  } else {
    match session {
      Some(talking) -> { ..counted, idle: push(counted.idle, { n: n, session: talking }) },
      None -> counted,
    }
  }
}

fn copy_of(p: Pool, id: Int) -> Option<Copy> = find(p.copies, |c: Copy| c.id == id)

fn with_copy(p: Pool, c: Copy) -> Pool =
  { ..p, copies: map(p.copies, |held: Copy| if held.id == c.id { c } else { held }) }

fn without_copy(p: Pool, id: Int) -> Pool =
  { ..p, copies: filter(p.copies, |held: Copy| held.id != id) }

fn no_copy(id: Int) -> DbError =
  db_error("55000", "", "no copy is open under the number " ++ int_to_string(id))

fn copy_busy(id: Int) -> DbError =
  db_error(
    "55000",
    "",
    "copy " ++ int_to_string(id) ++ " is already on the wire for another operation",
  )

fn copy_direction(id: Int, out: Bool) -> DbError =
  db_error(
    "55000",
    "",
    "copy " ++ int_to_string(id) ++ " is a copy " ++ (if out { "out" } else { "in" })
      ++ ", and this operation is the other way",
  )

/// A copy's connection taken for one operation on the wire.
type Took = { pool: Pool, copy: Copy, session: pg::Session }

fn took(p: Pool, id: Int, out: Bool) -> Result<Took, DbError> =
  match copy_of(p, id) {
    None -> Err(no_copy(id)),
    Some(c) -> if c.out != out { Err(copy_direction(id, c.out)) } else {
      match c.session {
        None -> Err(copy_busy(id)),
        Some(session) ->
          Ok({ pool: with_copy(p, { ..c, session: None }), copy: c, session: session }),
      }
    },
  }

/// Rows in `COPY`'s text format, each parameter as its text.
fn copy_text(rows: List<List<Param>>) -> Bytes / {abort.raise} =
  bytes_concat_all(map(rows, |row: List<Param>| pg::copy_row(map(row, param_text))))

/// The first `most` whole lines of `data`, and what follows them.
type Lines = { lines: List<Bytes>, rest: Bytes }

fn first_lines(data: Bytes, most: Int) -> Lines / {abort.raise} = {
  let split = fold(
    range(0, max(most, 0)),
    { lines: [], rest: data, open: true },
    |acc: { lines: List<Bytes>, rest: Bytes, open: Bool }, i: Int|
      if !acc.open { acc } else {
        match bytes_index_of_byte(acc.rest, 10) {
          None -> { ..acc, open: false },
          Some(at) ->
            {
              lines: push(acc.lines, bytes_slice(acc.rest, 0, at)),
              rest: bytes_slice(acc.rest, at + 1, bytes_len(acc.rest)),
              open: true,
            },
        }
      },
  );
  { lines: split.lines, rest: split.rest }
}

/// Lines of a copy out as rows, read as `columns` say.
fn copied_rows(
  columns: List<pg::Column>,
  lines: List<Bytes>,
) -> Result<List<Row>, DbError> / {abort.raise} =
  fold(lines, Ok([]), |acc: Result<List<Row>, DbError>, line: Bytes|
    match acc {
      Err(e) -> Err(e),
      Ok(rows) -> match pg::copy_fields(line) {
        None ->
          Err(db_error("08P01", "", "a row of the copy does not read: it ends in a backslash")),
        Some(values) -> Ok(push(rows, row_of(columns, values, 0, map_new()))),
      },
    })

/// What a take of a copy out came to: the copy as it now stands, the connection it lets go of
/// once the server has sent everything (`Some` of `None` when that connection was lost), and the
/// rows.
type Taking = {
  copy: Copy,
  release: Option<Option<pg::Session>>,
  answer: Result<List<Row>, DbError>,
}

/// At most `rows` rows, read from what has arrived and then from the server, a piece at a time.
fn taking_rows(
  cfg: Server,
  c: Copy,
  session: Option<pg::Session>,
  rows: Int,
) -> Taking / {net.send[link], net.recv[link], net.close[link], abort.raise, diverges} = {
  let ready = first_lines(c.pending, rows);
  let answered = |copy: Copy, release: Option<Option<pg::Session>>, lines: Lines|
    match copied_rows(copy.columns, lines.lines) {
      Ok(found) ->
        {
          copy: { ..copy, pending: lines.rest, taken: copy.taken + len(found) },
          release: release,
          answer: Ok(found),
        },
      Err(e) -> { copy: { ..copy, failed: Some(e) }, release: release, answer: Err(e) },
    };
  match session {
    None -> answered(c, None, ready),
    Some(s) -> if len(ready.lines) >= rows { answered({ ..c, session: Some(s) }, None, ready) }
    else {
      match pg::copy_out_take[link](s, cfg.client) {
        Ok(piece) -> match piece.data {
          Some(data) ->
            taking_rows(
              cfg,
              { ..c, pending: bytes_concat(c.pending, data) },
              Some(piece.session),
              rows,
            ),
          None ->
            answered(
              { ..c, session: None, done: true },
              Some(Some(piece.session)),
              first_lines(c.pending, rows),
            ),
        },
        Err(pg::Rejected(after, server)) -> {
          let failed = server_error(server);
          {
            copy: { ..c, session: None, done: true, failed: Some(failed) },
            release: Some(Some(after)),
            answer: Err(failed),
          }
        },
        Err(e) -> {
          pg::finish[link](s, cfg.client);
          let failed = client_error(e);
          {
            copy: { ..c, session: None, done: true, failed: Some(failed) },
            release: Some(None),
            answer: Err(failed),
          }
        },
      }
    },
  }
}

/// What remains of a copy out read and dropped, so its connection is ready for the next statement.
fn drained(
  cfg: Server,
  s: pg::Session,
) -> Result<pg::Session, pg::ClientError> / {net.recv[link], abort.raise, diverges} =
  match pg::copy_out_take[link](s, cfg.client) {
    Err(e) -> Err(e),
    Ok(piece) -> match piece.data {
      None -> Ok(piece.session),
      Some(_) -> drained(cfg, piece.session),
    },
  }

/// What ending a copy came to: the connection it lets go of, `None` when it is lost, and the answer.
type Ended = { session: Option<pg::Session>, answer: Result<Int, DbError> }

fn ended_in(
  cfg: Server,
  session: pg::Session,
  failure: Option<String>,
) -> Ended / {net.send[link], net.recv[link], net.close[link], abort.raise, diverges} =
  match pg::copy_in_end[link]({ session: session, columns: 0 }, failure, cfg.client) {
    Ok(r) -> { session: Some(r.session), answer: Ok(count_of(r.answer.tag)) },
    Err(pg::Rejected(after, server)) -> { session: Some(after), answer: Err(server_error(server)) },
    Err(e) -> {
      pg::finish[link](session, cfg.client);
      { session: None, answer: Err(client_error(e)) }
    },
  }

fn ended_out(
  cfg: Server,
  c: Copy,
  session: pg::Session,
) -> Ended / {net.send[link], net.recv[link], net.close[link], abort.raise, diverges} =
  match drained(cfg, session) {
    Ok(s) -> { session: Some(s), answer: Ok(c.taken) },
    Err(pg::Rejected(after, server)) -> { session: Some(after), answer: Err(server_error(server)) },
    Err(e) -> {
      pg::finish[link](session, cfg.client);
      { session: None, answer: Err(client_error(e)) }
    },
  }

/// `COPY` of the `columns` of table `t` from the client, every name quoted.
fn copy_in_sql(t: String, columns: List<String>) -> String =
  "copy " ++ quote_ident(t) ++ " (" ++ comma(map(columns, quote_ident)) ++ ") from stdin"

// --- The listening connection --------------------------------------------------------

/// A connection of its own that listens on every one of `channels`.
fn listening(
  cfg: Server,
  nonce: String,
  made: Int,
  channels: List<String>,
) -> Result<pg::Session, DbError> / {net.connect[link], net.start_tls[link], net.peer_certificate[link], net.send[link], net.send_secret[link], net.recv[link], net.close[link], abort.raise, diverges} =
  match pg::connect[link](
      cfg.host,
      cfg.port,
      tls_of(cfg),
      cfg.user,
      cfg.database,
      startup_parameters(cfg),
      cfg.password,
      nonce ++ "-listener-" ++ int_to_string(made),
      cfg.client,
    ) {
    Err(e) -> Err(client_error(e)),
    Ok(s) ->
      fold(channels, Ok(s), |acc: Result<pg::Session, DbError>, channel: String|
        match acc {
          Err(e) -> Err(e),
          Ok(talking) -> match control(talking, "listen " ++ quote_ident(channel), cfg) {
            Ok(r) -> Ok(r.session),
            Err(e) -> {
              pg::finish[link](talking, cfg.client);
              Err(client_error(e))
            },
          },
        }),
  }

/// What a wait on the listener left: the listener, and what it answered.
type Listened = { listener: Listener, notice: Notice }

type Subscribed = { listener: Listener, answer: Answer }

fn listened_to(
  cfg: Server,
  nonce: String,
  l: Listener,
  channel: String,
) -> Subscribed / {net.connect[link], net.start_tls[link], net.peer_certificate[link], net.send[link], net.send_secret[link], net.recv[link], net.close[link], abort.raise, diverges} =
  match l.session {
    None -> match listening(cfg, nonce, l.made, push(l.channels, channel)) {
      Err(e) -> { listener: { ..l, made: l.made + 1 }, answer: Failed(e) },
      Ok(s) ->
        {
          listener: {
            ..l,
            session: Some(s),
            channels: push(l.channels, channel),
            made: l.made + 1,
          },
          answer: Count(0),
        },
    },
    Some(s) -> match control(s, "listen " ++ quote_ident(channel), cfg) {
      Ok(r) ->
        {
          listener: { ..l, session: Some(r.session), channels: push(l.channels, channel) },
          answer: Count(0),
        },
      Err(pg::Rejected(after, server)) ->
        { listener: { ..l, session: Some(after) }, answer: Failed(server_error(server)) },
      Err(e) -> {
        pg::finish[link](s, cfg.client);
        { listener: { ..l, session: None, lost: true }, answer: Failed(client_error(e)) }
      },
    },
  }

fn unlistened(
  cfg: Server,
  l: Listener,
  channel: String,
) -> Subscribed / {net.send[link], net.recv[link], net.close[link], abort.raise, diverges} = {
  let rest = filter(l.channels, |c: String| c != channel);
  match l.session {
    None -> { listener: { ..l, channels: rest }, answer: Count(0) },
    Some(s) -> match control(s, "unlisten " ++ quote_ident(channel), cfg) {
      Ok(r) -> { listener: { ..l, session: Some(r.session), channels: rest }, answer: Count(0) },
      Err(pg::Rejected(after, server)) ->
        { listener: { ..l, session: Some(after) }, answer: Failed(server_error(server)) },
      Err(e) -> {
        pg::finish[link](s, cfg.client);
        { listener: { ..l, session: None, channels: rest, lost: true }, answer: Count(0) }
      },
    },
  }
}

/// A wait on the listener, which opens a new connection first when the last one was lost.
fn waited(
  cfg: Server,
  nonce: String,
  l: Listener,
  timeout_ms: Int,
) -> Listened / {net.connect[link], net.start_tls[link], net.peer_certificate[link], net.send[link], net.send_secret[link], net.recv[link], net.close[link], abort.raise, diverges} =
  match l.session {
    None -> reopened(cfg, nonce, l),
    Some(s) -> match pg::await_notification[link](s, timeout_ms) {
      Ok(w) ->
        {
          listener: { ..l, session: Some(w.session) },
          notice: match w.notice { Some(n) -> Notified(n), None -> Quiet },
        },
      Err(_) -> {
        pg::finish[link](s, cfg.client);
        reopened(cfg, nonce, { ..l, session: None, lost: true })
      },
    },
  }

fn reopened(
  cfg: Server,
  nonce: String,
  l: Listener,
) -> Listened / {net.connect[link], net.start_tls[link], net.peer_certificate[link], net.send[link], net.send_secret[link], net.recv[link], net.close[link], abort.raise, diverges} =
  match listening(cfg, nonce, l.made, l.channels) {
    Ok(s) ->
      { listener: { ..l, session: Some(s), lost: false, made: l.made + 1 }, notice: Reconnected },
    Err(e) -> { listener: { ..l, lost: true, made: l.made + 1 }, notice: Unheard(e) },
  }

fn listener_busy() -> String =
  "the listener was used while a wait or a subscription on it was on the wire: one task listens at a time"

/// The `db` effect served from a live server. `nonce` is the caller's, so a run's seed decides it
/// and a test can fix it; each connection's nonce is that text and its own number.
pub fn serve<a | e>(
  cfg: Server,
  size: Int,
  nonce: String,
  body: () -> a / {db.read[*], db.write[*] | e},
) -> a / {diverges, abort.raise, net.connect[link], net.start_tls[link], net.peer_certificate[link], net.send[link], net.send_secret[link], net.recv[link], net.close[link] | e} =
  with_cell[dbpool]({
      idle: [],
      opened: 0,
      made: 0,
      open: [],
      copies: [],
      copied: 0,
      listener: { session: None, channels: [], waiting: false, lost: false, made: 0 },
    }) { pool -> {
    let taken = |d: Decided| {
      cell_set(pool, d.pool);
      d.plan
    };
    let settled = |left: Left| {
      cell_set(pool, settle(cell_get(pool), left));
      left.answer
    };
    let statement = |s: Stmt, ps: List<Param>, rows: Bool, what: String|
      match taken(for_statement(cell_get(pool), size, what)) {
        Answered(a) -> a,
        Outside(c) -> settled(statement_outside(cfg, nonce, c, s, ps, rows)),
        Within(scope, session) -> settled(statement_within(cfg, scope, session, s, ps, rows)),
      };
    let closing = |d: ToClose| {
      cell_set(pool, d.pool);
      d.closing
    };
    let alone = |s: Stmt, each: List<List<Param>>|
      map(each, |ps: List<Param>| statement(s, ps, true, "`db.batch`"));
    let shared = |s: Stmt, each: List<List<Param>>|
      match coalesced(s, each) {
        None -> None,
        Some(c) -> match statement(c.s, c.ps, true, "`db.batch`") {
          Rows(rows) -> Some(split_asks(rows, len(each))),
          _ -> None,
        },
      };
    // The savepoint a batch inside a transaction runs under, let go or rolled back to.
    let ended_savepoint = |kept: Bool|
      match closing(for_close(cell_get(pool), "`db.batch`", Count(0))) {
        Settled(_) -> (),
        Closes(scope, session) -> {
          settled(if kept { committing(cfg, scope, session) }
          else { aborting(cfg, scope, session) });
          ()
        },
      };
    // A batch's asks as one statement; inside a transaction, under a savepoint, so that a refusal
    // leaves the transaction as asking each alone would have. A statement the asks cannot share,
    // or one the server refuses, is asked once for each.
    let batch = |s: Stmt, each: List<List<Param>>|
      if len(each) < 2 { alone(s, each) } else {
        match route(cell_get(pool).open) {
          Own(scope) -> match taken(for_begin(cell_get(pool), size, scope.level, scope.access)) {
            Within(inner, session) -> match settled(nesting(cfg, inner, session)) {
              Failed(_) -> alone(s, each),
              _ -> match shared(s, each) {
                Some(answers) -> {
                  ended_savepoint(true);
                  answers
                },
                None -> {
                  ended_savepoint(false);
                  alone(s, each)
                },
              },
            },
            _ -> alone(s, each),
          },
          _ -> match shared(s, each) { Some(answers) -> answers, None -> alone(s, each) },
        }
      };
    // A copy begun on the connection it claims, numbered once the server has begun it.
    let copy_begin = |sql: String, out: Option<String>, what: String| {
      let claimed = for_copy(cell_get(pool), size, what);
      cell_set(pool, claimed.pool);
      match claimed.claim {
        CopyRefused(e) -> Err(e),
        claim -> {
          let b = copy_begun(cfg, nonce, claim, sql, out);
          match b.failed {
            Some(e) -> {
              cell_set(pool, let_copy_go(cell_get(pool), b.n, b.within, b.session));
              Err(e)
            },
            None -> {
              let p = cell_get(pool);
              cell_set(pool, {
                ..p,
                copies: push(p.copies, {
                  id: p.copied,
                  n: b.n,
                  session: b.session,
                  within: b.within,
                  out: out != None,
                  columns: b.columns,
                  pending: b"",
                  done: false,
                  taken: 0,
                  failed: None,
                }),
                copied: p.copied + 1,
              });
              Ok(p.copied)
            },
          }
        },
      }
    };
    // A copy ended: its connection let go of and its number forgotten.
    let copy_closed = |c: Copy, e: Ended| {
      cell_set(pool, let_copy_go(without_copy(cell_get(pool), c.id), c.n, c.within, e.session));
      e.answer
    };
    let copy_end = |id: Int, failure: Option<String>|
      match copy_of(cell_get(pool), id) {
        None -> Err(no_copy(id)),
        Some(c) -> if c.out && c.done {
          cell_set(pool, without_copy(cell_get(pool), id));
          match c.failed { Some(e) -> Err(e), None -> Ok(c.taken) }
        } else {
          match took(cell_get(pool), id, c.out) {
            Err(e) -> Err(e),
            Ok(t) -> {
              cell_set(pool, t.pool);
              copy_closed(c, if c.out { ended_out(cfg, c, t.session) }
              else { ended_in(cfg, t.session, failure) })
            },
          }
        },
      };
    let taken_from = |c: Copy, session: Option<pg::Session>, rows: Int| {
      let t = taking_rows(cfg, c, session, rows);
      let kept = with_copy(cell_get(pool), t.copy);
      cell_set(pool, match t.release {
        None -> kept,
        Some(left) -> let_copy_go(kept, c.n, c.within, left),
      });
      t.answer
    };
    let copy_take = |id: Int, rows: Int|
      match copy_of(cell_get(pool), id) {
        None -> Err(no_copy(id)),
        Some(c) -> if !c.out { Err(copy_direction(id, false)) }
        else if c.done { taken_from(c, None, rows) } else {
          match took(cell_get(pool), id, true) {
            Err(e) -> Err(e),
            Ok(t) -> {
              cell_set(pool, t.pool);
              taken_from(c, Some(t.session), rows)
            },
          }
        },
      };
    // The listener taken for one operation on the wire, and given back with what it came to.
    let listener_taken = || {
      let p = cell_get(pool);
      if p.listener.waiting { panic(listener_busy()) } else {
        cell_set(pool, { ..p, listener: { ..p.listener, waiting: true } });
        p.listener
      }
    };
    let listener_back = |l: Listener| {
      cell_set(pool, { ..cell_get(pool), listener: { ..l, waiting: false } });
      ()
    };
    let answer = handle {
      body()
    } with {
      db.query[*t](s, ps) -> {
        check_statement(s, Reads, t, "`db.query`");
        statement(s, ps, true, "`db.query`")
      },
      db.batch[*t](s, each) -> {
        check_statement(s, Reads, t, "`db.batch`");
        batch(s, each)
      },
      db.execute[*t](s, ps) -> {
        check_statement(s, Writes, t, "`db.execute`");
        statement(s, ps, false, "`db.execute`")
      },
      db.returning[*t](s, ps) -> {
        check_statement(s, WritesRows, t, "`db.returning`");
        statement(s, ps, true, "`db.returning`")
      },
      db.begin(level, access) -> match taken(for_begin(cell_get(pool), size, level, access)) {
        Answered(a) -> a,
        Outside(c) -> settled(opening(cfg, nonce, c, level, access)),
        Within(scope, session) -> settled(nesting(cfg, scope, session)),
      },
      db.commit() -> match closing(
          for_close(cell_get(pool), "`db.commit`", Failed(connection_lost())),
        ) {
        Settled(a) -> a,
        Closes(scope, session) -> settled(committing(cfg, scope, session)),
      },
      db.abort() -> match closing(for_close(cell_get(pool), "`db.abort`", Count(0))) {
        Settled(a) -> a,
        Closes(scope, session) -> settled(aborting(cfg, scope, session)),
      },
      db.notify[*c](payload) ->
        statement(notify_statement(), [PText(c), PText(payload)], false, "`db.notify`"),
      db.listen[*c]() -> {
        let l = listener_taken();
        if contains(l.channels, c) {
          listener_back(l);
          Count(0)
        } else {
          let s = listened_to(cfg, nonce, l, c);
          listener_back(s.listener);
          s.answer
        }
      },
      db.unlisten[*c]() -> {
        let s = unlistened(cfg, listener_taken(), c);
        listener_back(s.listener);
        s.answer
      },
      db.notified(timeout_ms) -> {
        if len(cell_get(pool).listener.channels) == 0 { panic(nothing_listened()) } else { () };
        let w = waited(cfg, nonce, listener_taken(), timeout_ms);
        listener_back(w.listener);
        w.notice
      },
      db.copy_in[*t](columns) -> copy_begin(copy_in_sql(t, columns), None, "`db.copy_in`"),
      db.copy_rows[*t](id, rows) -> match took(cell_get(pool), id, false) {
        Err(e) -> Err(e),
        Ok(took_rows) -> {
          cell_set(pool, took_rows.pool);
          match pg::copy_send[link](
              { session: took_rows.session, columns: 0 },
              copy_text(rows),
              cfg.client,
            ) {
            Ok(c) -> {
              cell_set(
                pool,
                with_copy(cell_get(pool), { ..took_rows.copy, session: Some(c.session) }),
              );
              Ok(())
            },
            Err(e) -> {
              pg::finish[link](took_rows.session, cfg.client);
              copy_closed(took_rows.copy, { session: None, answer: Err(client_error(e)) });
              Err(client_error(e))
            },
          }
        },
      },
      db.copy_end[*t](id, failure) -> copy_end(id, failure),
      db.copy_out[*t](s) -> {
        check_statement(s, Reads, t, "`db.copy_out`");
        let body = statement_text(s.sql);
        copy_begin("copy (" ++ body ++ ") to stdout", Some(body), "`db.copy_out`")
      },
      db.copy_take[*t](id, rows) -> copy_take(id, rows),
    };
    finished(cell_get(pool), cfg);
    answer
  } }

/// What `db.notify` sends: the channel and the payload as parameters, so neither is ever read as
/// SQL.
fn notify_statement() -> Stmt = stmt("select pg_notify($1, $2)")

/// A statement's text short of a closing `;`, which a statement inside a `COPY` may not have.
fn statement_text(sql: String) -> String / {abort.raise} =
  match tokenize(Postgres, sql) {
    Err(_) -> sql,
    Ok(ts) -> match statement_body(sql, ts) { Some(body) -> body, None -> sql },
  }

// --- One statement for a batch -----------------------------------------------------

/// The statement once for each ask, joined with `union all`: each arm's placeholders numbered on
/// from the asks before it, and each row marked with the ask it answers and its place among that
/// ask's rows, so the answers come apart in order. `None` when the asks cannot share one statement:
/// text the reader cannot take apart, an ask whose parameters are not the placeholders', or more
/// parameters than one statement may carry.
fn coalesced(
  s: Stmt,
  each: List<List<Param>>,
) -> Option<{ s: Stmt, ps: List<Param> }> / {abort.raise} =
  match tokenize(Postgres, s.sql) {
    Err(_) -> None,
    Ok(ts) -> match statement_body(s.sql, ts) {
      None -> None,
      Some(body) -> {
        let places = filter(ts, |t: SqlTokAt| match t.tok { SqlPlaceholder -> true, _ -> false });
        let width = fold(places, 0, |m: Int, t: SqlTokAt| max(m, placeholder_number(t.text)));
        let fits = fold(each, true, |ok: Bool, ps: List<Param>| ok && len(ps) == width);
        if !fits || width * len(each) > 65535 { None } else {
          let arms = map(range(0, len(each)), |i: Int|
            "select " ++ int_to_string(i)
              ++ " as \"ply.ask\", row_number() over () as \"ply.row\", \"ply.arm\".* from ("
              ++ renumbered(body, places, i * width)
              ++ ") as \"ply.arm\"");
          Some({
            s: stmt(
              "select * from (" ++ string::join(arms, " union all ")
                ++ ") as \"ply.batch\" order by \"ply.ask\", \"ply.row\"",
            ),
            ps: fold(each, [], |acc: List<Param>, ps: List<Param>| fold(ps, acc, push)),
          })
        }
      },
    },
  }

/// The statement's text short of a closing `;`; `None` when a `;` comes before its end.
fn statement_body(sql: String, ts: List<SqlTokAt>) -> Option<String> / {abort.raise} = {
  let semis = filter(range(0, len(ts)), |i: Int|
    match list_at(ts, i) { Some(t) -> sql_is_semi(t.tok), None -> false });
  match semis {
    [] -> Some(sql),
    [i] -> if i == len(ts) - 1 {
      match list_at(ts, i) {
        Some(t) -> Some(string_of_bytes(bytes_slice(bytes_of_string(sql), 0, t.at))),
        None -> None,
      }
    } else { None },
    _ -> None,
  }
}

fn placeholder_number(text: String) -> Int / {abort.raise} =
  int_or_zero(string_slice(text, 1, string_len(text)))

/// Each placeholder `$k` of `body` written `$(k + by)`.
fn renumbered(body: String, places: List<SqlTokAt>, by: Int) -> String / {abort.raise} = {
  let b = bytes_of_string(body);
  let walked = fold(places, { at: 0, out: b"" }, |acc: { at: Int, out: Bytes }, t: SqlTokAt|
    if t.at < acc.at || t.at >= bytes_len(b) { acc } else {
      {
        at: t.at + bytes_len(bytes_of_string(t.text)),
        out: bytes_concat_all([
          acc.out,
          bytes_slice(b, acc.at, t.at),
          bytes_of_string("$" ++ int_to_string(placeholder_number(t.text) + by)),
        ]),
      }
    });
  string_of_bytes(bytes_concat(walked.out, bytes_slice(b, walked.at, bytes_len(b))))
}

/// The rows of a batch's statement, each ask's in order and without the batch's own columns.
fn split_asks(rows: List<Row>, asks: Int) -> List<Answer> = {
  let held = fold(rows, map_new(), |acc: Map<Int, List<Row>>, row: Row|
    match map_get(row, "ply.ask") {
      Some(CInt(i)) ->
        map_insert(
          acc,
          i,
          push(
            match map_get(acc, i) { Some(xs) -> xs, None -> [] },
            map_remove(map_remove(row, "ply.ask"), "ply.row"),
          ),
        ),
      _ -> acc,
    });
  map(range(0, asks), |i: Int| Rows(match map_get(held, i) { Some(xs) -> xs, None -> [] }))
}

/// Every connection the pool still holds once its body has returned, told it is done and closed:
/// the idle ones; one a body returned from inside its transaction, which the server rolls back; one
/// a copy left open, which the server keeps none of; and the listener's.
fn finished(p: Pool, cfg: Server) -> Unit / {net.send[link], net.close[link], abort.raise} = {
  let close = |s: Option<pg::Session>|
    match s { Some(session) -> pg::finish[link](session, cfg.client), None -> () };
  fold(p.idle, (), |done: Unit, l: Link| pg::finish[link](l.session, cfg.client));
  fold(p.open, (), |done: Unit, scope: Scope| close(scope.session));
  fold(filter(p.copies, |c: Copy| !c.within), (), |done: Unit, c: Copy| close(c.session));
  close(p.listener.session)
}

// --- Where the server is ---------------------------------------------------------

// `postgres://user[:password]@host[:port]/database[?key=value&…]`, the form `with_server` takes.
// The language reads it, so a driver needs nothing from the host but `net`.

type Split = { head: String, tail: String }

/// Around the first `sep`; the URL grammar needs no regular expressions.
fn split_at(text: String, sep: String) -> Option<Split> / {abort.raise} =
  match bytes_index_of(bytes_of_string(text), bytes_of_string(sep)) {
    None -> None,
    Some(i) -> {
      let whole = bytes_of_string(text);
      let after = i + bytes_len(bytes_of_string(sep));
      Some({
        head: string_of_bytes(bytes_slice(whole, 0, i)),
        tail: string_of_bytes(bytes_slice(whole, after, bytes_len(whole))),
      })
    },
  }

/// Around the last `sep`, which is what separates the userinfo from the host: a password may
/// hold an `@`.
fn rsplit_at(text: String, sep: String) -> Option<Split> / {abort.raise} = {
  let whole = bytes_of_string(text);
  let needle = bytes_of_string(sep);
  let last = fold(range(0, bytes_len(whole)), 0 - 1, |acc: Int, i: Int|
    if i + bytes_len(needle) <= bytes_len(whole)
        && bytes_slice(whole, i, i + bytes_len(needle)) == needle { i }
    else { acc });
  if last < 0 { None } else {
    Some({
      head: string_of_bytes(bytes_slice(whole, 0, last)),
      tail: string_of_bytes(bytes_slice(whole, last + bytes_len(needle), bytes_len(whole))),
    })
  }
}

/// `%XX` as the byte it names; anything else is itself, so a password may hold a `:` or an `@`.
fn unpercent(text: String) -> Result<String, String> / {abort.raise} =
  match unpercent_from(bytes_of_string(text), 0, b"") {
    Err(why) -> Err(why),
    Ok(bytes) -> if bytes_is_utf8(bytes) { Ok(string_of_bytes(bytes)) }
    else { Err("a `%` escape in the URL is not UTF-8") },
  }

fn unpercent_from(whole: Bytes, at: Int, acc: Bytes) -> Result<Bytes, String> / {abort.raise} =
  if at >= bytes_len(whole) { Ok(acc) } else if bytes_at(whole, at) == 37 {
    if at + 2 >= bytes_len(whole) || !is_hex(bytes_at(whole, at + 1))
        || !is_hex(bytes_at(whole, at + 2)) {
      Err("a `%` in the URL is not followed by two hex digits")
    } else {
      unpercent_from(
        whole,
        at + 3,
        bytes_concat(
          acc,
          byte_of_int(hex_value(bytes_at(whole, at + 1)) * 16 + hex_value(bytes_at(whole, at + 2))),
        ),
      )
    }
  } else { unpercent_from(whole, at + 1, bytes_concat(acc, bytes_slice(whole, at, at + 1))) }

fn is_hex(c: Int) -> Bool = (c >= 48 && c <= 57) || (c >= 97 && c <= 102) || (c >= 65 && c <= 70)

fn url_refusal(url: String) -> String =
  if string_contains(url, "=") && !string_contains(url, "://") {
    "this is libpq's keyword/value form; the URI form is `postgres://user@host:5432/database`"
  } else { "a connection string begins `postgres://`, as in `postgres://user@host:5432/database`" }

/// A `Server` from `postgres://user[:password]@host[:port]/database`, whose query may set
/// `statement_timeout`, `idle_in_transaction_session_timeout` (whole milliseconds, `0` for none, at
/// most 2147483647), `application_name`, `sslmode` and `sslnegotiation`. Any other key, or a key
/// given twice, is refused.
///
/// Without `sslmode` a connection is plaintext, as `sslmode=disable` asks. `require`, `verify-ca`
/// and `verify-full` secure every connection and verify the server as `verify-full` does (`Ssl`
/// says why all three). `allow` and `prefer` are refused: each goes on in plaintext when the server
/// says it does not speak TLS, and anyone between the two can say that for it.
/// `sslnegotiation=direct` begins TLS without asking first, which a server before Postgres 17 does
/// not understand, and asks for an `sslmode` that secures; `postgres`, asking first, is the default.
///
/// The password is sealed before anything else of the string is read: the bytes between the
/// userinfo's `:` and the `@` before the host are percent-decoded straight into a secret, and the
/// rest is read from the string without them, so no reading of it holds the password.
pub fn server_of(url: String) -> Result<Server, String> / {abort.raise} =
  match sealed_password(url) {
    Err(why) -> Err(why),
    Ok(unsealed) -> match split_at(unsealed.url, "://") {
      None -> Err(url_refusal(unsealed.url)),
      Some(scheme) -> if scheme.head != "postgres" && scheme.head != "postgresql" {
        Err(
          "`" ++ scheme.head
            ++ "` is not a database this driver speaks; only `postgres://` and `postgresql://` are",
        )
      } else { server_parts(scheme.tail, unsealed.password) },
    },
  }

/// A connection string with its password taken out, and the password, sealed.
type Unsealed = { url: String, password: Option<Secret<Bytes>> }

/// The password between the first `:` of the userinfo and the last `@` before the host, read
/// straight into a secret, and the string without the `:` and the password. An empty one is none.
fn sealed_password(url: String) -> Result<Unsealed, String> / {abort.raise} = {
  let b = bytes_of_string(url);
  let start = match bytes_index_of(b, b"://") { Some(i) -> i + 3, None -> 0 };
  let end = match bytes_index_of_from(b, b"/", start) { Some(i) -> i, None -> bytes_len(b) };
  let at = fold(range(start, end), 0 - 1, |found: Int, i: Int|
    if bytes_at(b, i) == 64 { i } else { found });
  let colon = match bytes_index_of_from(b, b":", start) { Some(i) -> i, None -> end };
  if at < 0 || colon >= at { Ok({ url: url, password: None }) } else {
    match sealed_unpercent(b, colon + 1, at, secret_of_bytes(b""), at - colon + 1) {
      Err(why) -> Err(why),
      Ok(password) ->
        Ok({
          url: string_of_bytes(
            bytes_concat(bytes_slice(b, 0, colon), bytes_slice(b, at, bytes_len(b))),
          ),
          password: if secret_is_empty(password) { None } else { Some(password) },
        }),
    }
  }
}

/// Bytes `at` to `end` of `b`, each `%XX` as the byte it names, appended to `acc` a run at a time
/// without leaving the secret. `left` bounds the runs: each takes a byte at least.
fn sealed_unpercent(
  b: Bytes,
  at: Int,
  end: Int,
  acc: Secret<Bytes>,
  left: Int,
) -> Result<Secret<Bytes>, String> / {abort.raise} =
  if at >= end || left <= 0 { Ok(acc) } else if bytes_at(b, at) == 37 {
    if at + 2 >= end || !is_hex(bytes_at(b, at + 1)) || !is_hex(bytes_at(b, at + 2)) {
      Err("a `%` in the URL is not followed by two hex digits")
    } else {
      sealed_unpercent(
        b,
        at + 3,
        end,
        secret_concat(
          acc,
          secret_of_bytes(
            byte_of_int(hex_value(bytes_at(b, at + 1)) * 16 + hex_value(bytes_at(b, at + 2))),
          ),
        ),
        left - 1,
      )
    }
  } else {
    let run = match bytes_index_of_from(b, b"%", at) { Some(i) -> min(i, end), None -> end };
    sealed_unpercent(
      b,
      run,
      end,
      secret_concat(acc, secret_of_bytes(bytes_slice(b, at, run))),
      left - 1,
    )
  }

fn user_of(userinfo: String) -> Result<String, String> / {abort.raise} =
  match unpercent(userinfo) {
    Err(why) -> Err(why),
    Ok(user) -> if string_len(user) == 0 { Err("the user is empty") } else { Ok(user) },
  }

type HostPort = { host: String, port: Int }

fn hostport_of(text: String) -> Result<HostPort, String> / {abort.raise} =
  match rsplit_at(text, ":") {
    None -> checked_host(text, 5432),
    Some(s) -> match natural_of(s.tail) {
      None -> Err("`" ++ s.tail ++ "` is not a port"),
      Some(port) -> if port == 0 { Err("port 0 is not a port a server listens on") }
      else { checked_host(s.head, port) },
    },
  }

/// A decimal number, and nothing that merely begins with one.
fn natural_of(text: String) -> Option<Int> / {abort.raise} =
  match string::int_of_string(text) {
    Some(n) -> if n >= 0 && int_to_string(n) == text { Some(n) } else { None },
    None -> None,
  }

fn checked_host(host: String, port: Int) -> Result<HostPort, String> =
  if string_len(host) == 0 { Err("there is no host; a unix socket path is not configurable here") }
  else { Ok({ host: host, port: port }) }

type Database = { name: String, query: String }

fn database_of(path_and_query: String) -> Result<Database, String> / {abort.raise} = {
  let split = match split_at(path_and_query, "?") {
    Some(s) -> s,
    None -> { head: path_and_query, tail: "" },
  };
  match unpercent(split.head) {
    Err(why) -> Err(why),
    Ok(name) -> if string_len(name) == 0 { Err("there is no database name after the host") }
    else { Ok({ name: name, query: split.tail }) },
  }
}

fn server_parts(
  rest: String,
  password: Option<Secret<Bytes>>,
) -> Result<Server, String> / {abort.raise} = {
  let split = match split_at(rest, "/") { Some(s) -> s, None -> { head: rest, tail: "" } };
  match rsplit_at(split.head, "@") {
    None ->
      Err(
        "there is no `user@` before the host; a run whose database user comes from the environment is a run whose identity depends on who invoked it",
      ),
    Some(who) -> match user_of(who.head) {
      Err(why) -> Err(why),
      Ok(user) -> match hostport_of(who.tail) {
        Err(why) -> Err(why),
        Ok(hp) -> match database_of(split.tail) {
          Err(why) -> Err(why),
          Ok(database) ->
            with_query(database.query, server(hp.host, hp.port, user, database.name, password)),
        },
      },
    },
  }
}

/// A connection string's query read: the server as far as it goes, and the two TLS settings, which
/// are read together once every parameter is.
type Reading = { server: Server, mode: Option<String>, negotiation: Option<String> }

/// `sslmode` and `sslnegotiation` decide `ssl` between them. Every other parameter is a setting the
/// server is told at start-up, under the name postgres gives it.
fn with_query(query: String, s: Server) -> Result<Server, String> / {abort.raise} =
  if string_len(query) == 0 { Ok(s) } else {
    let read = fold(
      string_split(query, "&"),
      Ok({ server: s, mode: None, negotiation: None }),
      |acc: Result<Reading, String>, pair: String|
        match acc {
          Err(why) -> Err(why),
          Ok(so_far) -> match split_at(pair, "=") {
            None -> Err("`" ++ pair ++ "` is not a `key=value` parameter"),
            Some(kv) -> match unpercent(kv.tail) {
              Err(why) -> Err(why),
              Ok(value) -> with_parameter(so_far, kv.head, value),
            },
          },
        },
    );
    match read {
      Err(why) -> Err(why),
      Ok(r) -> match ssl_of(r.mode, r.negotiation) {
        Err(why) -> Err(why),
        Ok(ssl) -> Ok({ ..r.server, ssl: ssl }),
      },
    }
  }

fn with_parameter(
  r: Reading,
  key: String,
  value: String,
) -> Result<Reading, String> / {abort.raise} =
  if key == "sslmode" {
    match r.mode {
      Some(_) -> Err("`sslmode` is given twice"),
      None -> Ok({ ..r, mode: Some(value) }),
    }
  } else if key == "sslnegotiation" {
    match r.negotiation {
      Some(_) -> Err("`sslnegotiation` is given twice"),
      None -> Ok({ ..r, negotiation: Some(value) }),
    }
  } else {
    match with_setting(r.server, key, value) {
      Err(why) -> Err(why),
      Ok(server) -> Ok({ ..r, server: server }),
    }
  }

/// What the two TLS settings ask for together.
fn ssl_of(mode: Option<String>, negotiation: Option<String>) -> Result<Ssl, String> =
  match secures(mode) {
    Err(why) -> Err(why),
    Ok(secured) -> match negotiation {
      None -> Ok(if secured { Negotiated } else { Disabled }),
      Some(way) -> if way == "postgres" { Ok(if secured { Negotiated } else { Disabled }) }
      else if way == "direct" {
        if secured { Ok(Immediate) } else {
          Err(
            "`sslnegotiation=direct` begins TLS at once, and this `sslmode` does not secure the connection: add `sslmode=verify-full`",
          )
        }
      } else {
        Err("`sslnegotiation=" ++ way ++ "` is not a negotiation; `postgres` and `direct` are")
      },
    },
  }

/// Whether an `sslmode` secures the connection, or why it is refused.
fn secures(mode: Option<String>) -> Result<Bool, String> =
  match mode {
    None -> Ok(false),
    Some(m) -> if m == "disable" { Ok(false) }
    else if m == "require" || m == "verify-ca" || m == "verify-full" { Ok(true) }
    else if m == "allow" || m == "prefer" {
      Err(
        "`sslmode=" ++ m
          ++ "` goes on in plaintext when the server says it does not speak TLS, which anyone between the two can say: write `sslmode=verify-full`, or `sslmode=disable` for a server that is reached in plaintext",
      )
    } else {
      Err(
        "`sslmode=" ++ m
          ++ "` is not a mode; `disable`, `require`, `verify-ca` and `verify-full` are read",
      )
    },
  }

fn with_setting(s: Server, key: String, value: String) -> Result<Server, String> / {abort.raise} =
  if key == "application_name" {
    // A zero byte ends a start-up parameter, so the rest of the name would be read as another.
    if string_contains(value, "\0") { Err("an `application_name` may not hold a zero byte") }
    else { once(s.application_name, key, { ..s, application_name: Some(value) }) }
  } else if key == "statement_timeout" {
    match millis_of(key, value) {
      Err(why) -> Err(why),
      Ok(ms) -> once(s.statement_timeout_ms, key, { ..s, statement_timeout_ms: Some(ms) }),
    }
  } else if key == "idle_in_transaction_session_timeout" {
    match millis_of(key, value) {
      Err(why) -> Err(why),
      Ok(ms) ->
        once(s.idle_in_transaction_timeout_ms, key, {
          ..s,
          idle_in_transaction_timeout_ms: Some(ms),
        }),
    }
  } else { Err("`" ++ key ++ "` is not a parameter this driver reads") }

fn once<a>(given: Option<a>, key: String, set: Server) -> Result<Server, String> =
  match given { Some(_) -> Err("`" ++ key ++ "` is given twice"), None -> Ok(set) }

/// Postgres reads a timeout written without a unit as milliseconds, and `0` as none at all.
fn millis_of(key: String, text: String) -> Result<Int, String> / {abort.raise} =
  match natural_of(text) {
    None -> Err("`" ++ key ++ "=" ++ text ++ "`: a timeout is a whole number of milliseconds"),
    Some(ms) -> if ms > most_millis() {
      Err(
        "`" ++ key ++ "=" ++ text ++ "` is past the most postgres takes, "
          ++ int_to_string(most_millis())
          ++ " milliseconds",
      )
    } else { Ok(ms) },
  }

fn most_millis() -> Int = 2147483647

/// The `db` effect served from a connection string: the driver, wrapped for a program that was
/// told where the server is rather than handling the effect's clauses itself. The password is the
/// connection string's, or `password`, as `config.secret` answers one; a password given both ways
/// is refused.
pub fn with_server<a | e>(
  url: String,
  size: Int,
  body: () -> a / {db.read[*], db.write[*] | e},
  password: Option<Secret<Bytes>> = None,
) -> Result<a, String> / {diverges, abort.raise, net.connect[link], net.start_tls[link], net.peer_certificate[link], net.send[link], net.send_secret[link], net.recv[link], net.close[link], entropy.next | e} =
  match server_of(url) {
    Err(why) -> Err(why),
    Ok(read) -> match with_password(read, password) {
      Err(why) -> Err(why),
      Ok(cfg) -> Ok(serve(cfg, size, nonce(), body)),
    },
  }

/// `s` with `password`, where it is given; refused where `s` has one already.
pub fn with_password(s: Server, password: Option<Secret<Bytes>>) -> Result<Server, String> =
  match ((s.password, password)) {
    (Some(_), Some(_)) ->
      Err("the password is in the connection string and given beside it; give it once"),
    (None, Some(given)) -> Ok({ ..s, password: Some(given) }),
    _ -> Ok(s),
  }

// --- Tests ------------------------------------------------------------------

test "a connection string reads into the parts a driver needs" {
  match server_of(
      "postgres://ply:hunter2@127.0.0.1:5433/app?sslmode=disable&application_name=ply",
    ) {
    Err(why) -> panic(why),
    Ok(s) -> {
      assert_eq(s.user, "ply");
      assert_eq(s.password, Some(secret_of_bytes(b"hunter2")));
      assert_eq(s.host, "127.0.0.1");
      assert_eq(s.port, 5433);
      assert_eq(s.database, "app");
      assert_eq(s.application_name, Some("ply"))
    },
  }
}

test "a connection string's timeouts and name are what every connection starts with" {
  match server_of(
      "postgres://ply@db/app?statement_timeout=250&application_name=the%20desk&idle_in_transaction_session_timeout=0",
    ) {
    Err(why) -> panic(why),
    Ok(s) -> {
      assert_eq(s.statement_timeout_ms, Some(250));
      assert_eq(s.idle_in_transaction_timeout_ms, Some(0));
      assert_eq(startup_parameters(s), [
        { name: "application_name", value: "the desk" },
        { name: "statement_timeout", value: "250" },
        { name: "idle_in_transaction_session_timeout", value: "0" },
      ])
    },
  };
  match server_of("postgres://ply@db/app?sslmode=disable") {
    Err(why) -> panic(why),
    Ok(s) -> {
      assert_eq(s.statement_timeout_ms, None);
      assert_eq(startup_parameters(s), [])
    },
  }
}

test "a timeout is whole milliseconds, given once, and no more than postgres takes" {
  assert_err("postgres://ply@db/app?statement_timeout=5s", "whole number of milliseconds");
  assert_err("postgres://ply@db/app?statement_timeout=-1", "whole number of milliseconds");
  assert_err("postgres://ply@db/app?idle_in_transaction_session_timeout=", "whole number");
  assert_err("postgres://ply@db/app?statement_timeout=2147483648", "past the most postgres takes");
  assert_err("postgres://ply@db/app?statement_timeout=1&statement_timeout=2", "given twice");
  assert_err("postgres://ply@db/app?application_name=a%00b", "zero byte")
}

test "a connection string may leave out the port, the password and the parameters" {
  match server_of("postgresql://ply@db/app") {
    Err(why) -> panic(why),
    Ok(s) -> {
      assert_eq(s.port, 5432);
      assert_eq(s.password, None);
      assert_eq(s.database, "app")
    },
  }
}

test "a password may hold what separates the fields, escaped, and is read sealed" {
  match server_of("postgres://ply:a%40b%3Ac@db:5433/app") {
    Err(why) -> panic(why),
    Ok(s) -> {
      assert_eq(s.password, Some(secret_of_bytes(b"a@b:c")));
      assert_eq(s.user, "ply");
      assert_eq(s.port, 5433)
    },
  };
  // The last `@` before the host ends it, and a byte past UTF-8 is a byte of it.
  match server_of("postgres://ply:p@ss%FF@db/app") {
    Err(why) -> panic(why),
    Ok(s) -> assert_eq(s.password, Some(secret_of_bytes(b"p@ss\xff"))),
  };
  match server_of("postgres://ply:@db/app") {
    Err(why) -> panic(why),
    Ok(s) -> assert_eq(s.password, None),
  };
  assert_err("postgres://ply:a%4@db/app", "two hex digits")
}

test "a password is taken from settings once, and refused beside a connection string's" {
  let given = Some(secret_of_bytes(b"b"));
  match server_of("postgres://ply@db/app") {
    Err(why) -> panic(why),
    Ok(s) -> assert_eq(result_map(with_password(s, given), |t: Server| t.password), Ok(given)),
  };
  match server_of("postgres://ply:a@db/app") {
    Err(why) -> panic(why),
    Ok(s) -> {
      assert(result_map(with_password(s, given), |t: Server| t.password) != Ok(given));
      assert_eq(result_map(with_password(s, None), |t: Server| t.password), Ok(s.password))
    },
  }
}

test "what a connection string cannot mean is refused rather than guessed" {
  assert_err("host=db user=ply", "keyword");
  assert_err("mysql://ply@db/app", "not a database");
  assert_err("postgres://db/app", "user@");
  assert_err("postgres://@db/app", "user is empty");
  assert_err("postgres://ply@/app", "no host");
  assert_err("postgres://ply@db:0/app", "port 0");
  assert_err("postgres://ply@db:nine/app", "is not a port");
  assert_err("postgres://ply@db/", "no database name");
  assert_err("postgres://ply@db/app?timeout=3", "not a parameter");
  assert_err("postgres://ply@db/app?sslmode", "key=value")
}

fn ssl_in(url: String) -> Ssl / {abort.raise} =
  match server_of(url) { Ok(s) -> s.ssl, Err(why) -> panic(why) }

test "every sslmode that secures verifies the server, and one that can be talked out of TLS is refused" {
  assert_eq(ssl_in("postgres://ply@db/app"), Disabled);
  assert_eq(ssl_in("postgres://ply@db/app?sslmode=disable"), Disabled);
  assert_eq(ssl_in("postgres://ply@db/app?sslmode=require"), Negotiated);
  assert_eq(ssl_in("postgres://ply@db/app?sslmode=verify-ca"), Negotiated);
  assert_eq(
    ssl_in("postgres://ply@db/app?sslmode=verify-full&sslnegotiation=postgres"),
    Negotiated,
  );
  assert_eq(ssl_in("postgres://ply@db/app?sslnegotiation=direct&sslmode=verify-full"), Immediate);
  assert_err("postgres://ply@db/app?sslmode=prefer", "plaintext");
  assert_err("postgres://ply@db/app?sslmode=allow", "plaintext");
  assert_err("postgres://ply@db/app?sslmode=on", "not a mode");
  assert_err("postgres://ply@db/app?sslnegotiation=direct", "does not secure");
  assert_err("postgres://ply@db/app?sslmode=disable&sslnegotiation=direct", "does not secure");
  assert_err("postgres://ply@db/app?sslnegotiation=fast&sslmode=require", "not a negotiation");
  assert_err("postgres://ply@db/app?sslmode=require&sslmode=disable", "given twice")
}

fn assert_err(url: String, wanted: String) -> Unit / {abort.raise} =
  match server_of(url) {
    Ok(_) -> panic("`" ++ url ++ "` was accepted"),
    Err(why) ->
      assert(
        string_contains(why, wanted),
        Some(
          "`" ++ url ++ "` was refused with `" ++ why ++ "`, which does not name `" ++ wanted
            ++ "`",
        ),
      ),
  }

// --- The driver over a scripted server -------------------------------------------
//
// A postgres that answers what the driver sends as a server would, one conversation a connection:
// a statement completes, `BEGIN`, `COMMIT` and a refusal move the transaction's status, and a
// statement the script names is refused. A statement's reply is read after a `task.yield`, which is
// where a socket parks the task waiting on it.

/// A refusal the script holds for the first statement that begins with `on`; a `fatal` one ends the
/// session rather than the statement.
type Refusal = {
  on: String,
  code: String,
  constraint: String,
  message: String,
  detail: String,
  fatal: Bool,
}

fn refuse(
  on: String,
  code: String,
  constraint: String,
  message: String,
  detail: String,
) -> Refusal =
  { on: on, code: code, constraint: constraint, message: message, detail: detail, fatal: false }

fn hang_up(on: String, code: String) -> Refusal =
  { on: on, code: code, constraint: "", message: "terminating connection", detail: "", fatal: true }

/// One connection: the bytes sent that are not yet a whole message, the replies not yet read, the
/// transaction's status (73 idle, 84 in one, 69 in a failed one), the statement the extended cycle
/// parsed, what it was sent, and whether the server still talks on it.
type Wire = {
  inbox: Bytes,
  outbox: Bytes,
  started: Bool,
  status: Int,
  parsed: String,
  said: List<String>,
  open: Bool,
}

type Fake = { wires: List<Wire>, refusals: List<Refusal> }

type Fed = { wire: Wire, refusals: List<Refusal> }

type Scripted<a> = { value: a, wires: List<Wire> }

fn t_frame(kind: Int, body: Bytes) -> Bytes / {abort.raise} =
  bytes_concat_all([byte_of_int(kind), u32_be(bytes_len(body) + 4), body])

fn t_ready(status: Int) -> Bytes / {abort.raise} = t_frame(90, byte_of_int(status))

fn t_done(tag: String) -> Bytes / {abort.raise} = t_frame(67, cstring(tag))

fn t_field(code: String, text: String) -> Bytes =
  if text == "" { b"" } else { bytes_concat(bytes_of_string(code), cstring(text)) }

fn t_error(severity: String, r: Refusal) -> Bytes / {abort.raise} =
  t_frame(
    69,
    bytes_concat_all([
      t_field("S", severity),
      t_field("C", r.code),
      t_field("M", r.message),
      t_field("D", r.detail),
      t_field("n", r.constraint),
      b"\x00",
    ]),
  )

fn t_aborted() -> Refusal =
  refuse(
    "",
    "25P02",
    "",
    "current transaction is aborted, commands ignored until end of transaction block",
    "",
  )

fn t_greeted() -> Wire / {abort.raise} =
  {
    inbox: b"",
    outbox: bytes_concat(t_frame(82, u32_be(0)), t_ready(73)),
    started: false,
    status: 73,
    parsed: "",
    said: [],
    open: true,
  }

type Said = { bytes: Bytes, status: Int }

fn t_tagged(tag: String, status: Int) -> Said / {abort.raise} =
  { bytes: t_done(tag), status: status }

fn t_in_failed() -> Said / {abort.raise} = { bytes: t_error("ERROR", t_aborted()), status: 69 }

/// Rolling back to a savepoint un-aborts the transaction, and the release that follows closes it.
fn t_rolled_back_to() -> Said / {abort.raise} =
  { bytes: bytes_concat(t_done("ROLLBACK"), t_done("RELEASE")), status: 84 }

fn t_answer(sql: String, status: Int, extended: Bool) -> Said / {abort.raise} =
  if extended { t_extended(sql, status) } else { t_simple(sql, status) }

fn t_extended(sql: String, status: Int) -> Said / {abort.raise} =
  if status == 69 { t_in_failed() } else {
    {
      bytes: bytes_concat_all([
        t_frame(49, b""),
        t_frame(50, b""),
        t_frame(110, b""),
        t_done(t_tag(sql)),
      ]),
      status: status,
    }
  }

fn t_simple(sql: String, status: Int) -> Said / {abort.raise} =
  if string_starts_with(sql, "begin") { t_tagged("BEGIN", 84) }
  else if sql == "commit" { t_tagged(if status == 69 { "ROLLBACK" } else { "COMMIT" }, 73) }
  else if sql == "rollback" { t_tagged("ROLLBACK", 73) }
  else if string_starts_with(sql, "rollback to") { t_rolled_back_to() }
  else if status == 69 { t_in_failed() }
  else if string_starts_with(sql, "savepoint") { t_tagged("SAVEPOINT", status) }
  else { t_tagged("RELEASE", status) }

fn t_tag(sql: String) -> String =
  if string_starts_with(sql, "insert") { "INSERT 0 1" }
  else if string_starts_with(sql, "update") { "UPDATE 1" }
  else { "DELETE 1" }

/// An error in a transaction fails it, and a `COMMIT` that errs ends it.
fn t_after_error(sql: String, status: Int) -> Int =
  if sql == "commit" { 73 } else if status == 84 { 69 } else { status }

type Picked = { found: Option<Refusal>, rest: List<Refusal> }

fn t_pick(refusals: List<Refusal>, sql: String) -> Picked =
  fold(refusals, { found: None, rest: [] }, |acc: Picked, r: Refusal|
    match acc.found {
      None -> if string_starts_with(sql, r.on) { { ..acc, found: Some(r) } }
      else { { ..acc, rest: push(acc.rest, r) } },
      Some(_) -> { ..acc, rest: push(acc.rest, r) },
    })

fn t_statement(
  w: Wire,
  refusals: List<Refusal>,
  sql: String,
  extended: Bool,
) -> Fed / {abort.raise} = {
  let heard = { ..w, said: push(w.said, sql) };
  let picked = t_pick(refusals, sql);
  match picked.found {
    Some(r) -> if r.fatal {
      {
        wire: { ..heard, outbox: bytes_concat(heard.outbox, t_error("FATAL", r)), open: false },
        refusals: picked.rest,
      }
    } else {
      let status = t_after_error(sql, w.status);
      {
        wire: {
          ..heard,
          outbox: bytes_concat_all([heard.outbox, t_error("ERROR", r), t_ready(status)]),
          status: status,
        },
        refusals: picked.rest,
      }
    },
    None -> {
      let a = t_answer(sql, w.status, extended);
      {
        wire: {
          ..heard,
          outbox: bytes_concat_all([heard.outbox, a.bytes, t_ready(a.status)]),
          status: a.status,
        },
        refusals: picked.rest,
      }
    },
  }
}

fn t_cstring(b: Bytes, at: Int) -> String / {abort.raise} =
  match pg::read_cstring(b, at) { Some(c) -> c.text, None -> "" }

/// A `Query` or a `Parse` while a reply is unread is a second conversation on the connection.
fn t_message(w: Wire, refusals: List<Refusal>, kind: Int, body: Bytes) -> Fed / {abort.raise} =
  if (kind == 81 || kind == 80) && bytes_len(w.outbox) > 0 {
    panic("a connection was sent a statement before its last one was answered")
  } else if kind == 81 { t_statement(w, refusals, t_cstring(body, 0), false) } else if kind == 80 {
    // A `Parse` names its statement before its text.
    match pg::read_cstring(body, 0) {
      Some(name) -> { wire: { ..w, parsed: t_cstring(body, name.next) }, refusals: refusals },
      None -> { wire: w, refusals: refusals },
    }
  } else if kind == 83 { t_statement(w, refusals, w.parsed, true) }
  else if kind == 88 { { wire: { ..w, open: false }, refusals: refusals } }
  else { { wire: w, refusals: refusals } }

/// Every whole message in the inbox; the start-up message has no kind byte, and a length under
/// its own four bytes is no message. `left` bounds the rounds: each takes four bytes at least.
fn t_feed(w: Wire, refusals: List<Refusal>, left: Int) -> Fed / {abort.raise} =
  if left <= 0 { panic("more rounds than input") } else {
    if !w.started {
      match u32_be_at(w.inbox, 0) {
        None -> { wire: w, refusals: refusals },
        Some(n) -> if n < 4 || bytes_len(w.inbox) < n { { wire: w, refusals: refusals } } else {
          t_feed(
            { ..w, inbox: bytes_slice(w.inbox, n, bytes_len(w.inbox)), started: true },
            refusals,
            left - 1,
          )
        },
      }
    } else {
      match u32_be_at(w.inbox, 1) {
        None -> { wire: w, refusals: refusals },
        Some(n) -> if n < 4 || bytes_len(w.inbox) < 1 + n { { wire: w, refusals: refusals } } else {
          let fed = t_message(
            { ..w, inbox: bytes_slice(w.inbox, 1 + n, bytes_len(w.inbox)) },
            refusals,
            bytes_at(w.inbox, 0),
            bytes_slice(w.inbox, 5, 1 + n),
          );
          t_feed(fed.wire, fed.refusals, left - 1)
        },
      }
    }
  }

fn t_sent(f: Fake, c: Int, payload: Bytes) -> Fake / {abort.raise} =
  match list_at(f.wires, c) {
    None -> panic("a send on a connection the script never opened"),
    Some(w) -> if !w.open { f } else {
      let inbox = bytes_concat(w.inbox, payload);
      let fed = t_feed({ ..w, inbox: inbox }, f.refusals, bytes_len(inbox) + 1);
      { wires: list_set(f.wires, c, fed.wire), refusals: fed.refusals }
    },
  }

type Heard = { fake: Fake, bytes: Bytes }

fn t_read(f: Fake, c: Int) -> Heard / {abort.raise} =
  match list_at(f.wires, c) {
    None -> panic("a read on a connection the script never opened"),
    Some(w) -> if bytes_len(w.outbox) > 0 {
      { fake: { ..f, wires: list_set(f.wires, c, { ..w, outbox: b"" }) }, bytes: w.outbox }
    } else if w.open { panic("the driver waited on a reply the script never sends") }
    else { { fake: f, bytes: b"" } },
  }

fn t_closed(f: Fake, c: Int) -> Fake =
  match list_at(f.wires, c) {
    None -> f,
    Some(w) -> { ..f, wires: list_set(f.wires, c, { ..w, open: false }) },
  }

/// `body` served by `serve` over the script; a test runs it in a `simulate` region, so every
/// interleaving of its tasks at the replies is run.
fn over_script<a | e>(
  size: Int,
  refusals: List<Refusal>,
  body: () -> a / {db.read[*], db.write[*] | e},
) -> Scripted<a> / {diverges, abort.raise, task.yield | e} =
  with_cell[wire]({ wires: [], refusals: refusals }) { fake -> {
    let value = handle {
      serve(server("db", 5432, "ply", "ply", None), size, "t", body)
    } with {
      net.connect[link](host, port, timeout_ms) -> {
        let f = cell_get(fake);
        cell_set(fake, { ..f, wires: push(f.wires, t_greeted()) });
        Some(len(f.wires))
      },
      net.send[link](c, payload, timeout_ms) -> {
        cell_set(fake, t_sent(cell_get(fake), c, payload));
        Some(bytes_len(payload))
      },
      net.recv[link](c, max, timeout_ms) -> {
        if t_talking(cell_get(fake), c) { task.yield() };
        let heard = t_read(cell_get(fake), c);
        cell_set(fake, heard.fake);
        Some(heard.bytes)
      },
      net.close[link](c) -> cell_set(fake, t_closed(cell_get(fake), c)),
      net.start_tls[link](c, name, alpn, unread, timeout_ms) ->
        panic("the scripted server speaks no TLS"),
      net.peer_certificate[link](c) -> panic("the scripted server speaks no TLS"),
      net.send_secret[link](c, before, secret, encoding, after, timeout_ms) ->
        panic("the scripted server asks for no password"),
    };
    { value: value, wires: cell_get(fake).wires }
  } }

/// A connection past its greeting, whose replies park the task reading them.
fn t_talking(f: Fake, c: Int) -> Bool =
  match list_at(f.wires, c) { Some(w) -> len(w.said) > 0, None -> false }

fn t_said(wires: List<Wire>) -> List<List<String>> = map(wires, |w: Wire| w.said)

fn t_insert(sku: String) -> Stmt = stmt("insert into part (sku) values ('" ++ sku ++ "')")

fn t_begin(level: String) -> String = "begin isolation level " ++ level ++ " read write"

/// Every connection's statements, cut where a transaction ends.
fn t_runs(wires: List<Wire>) -> List<List<String>> =
  fold(wires, [], |acc: List<List<String>>, w: Wire| concat(acc, t_cut(w.said, [], [])))

fn t_cut(said: List<String>, run: List<String>, acc: List<List<String>>) -> List<List<String>> =
  match said {
    [] -> if len(run) == 0 { acc } else { push(acc, run) },
    [s, ..rest] -> if s == "commit" || s == "rollback" { t_cut(rest, [], push(acc, push(run, s))) }
    else { t_cut(rest, push(run, s), acc) },
  }

fn t_has_run(runs: List<List<String>>, run: List<String>) -> Bool =
  fold(runs, false, |acc: Bool, r: List<String>| acc || r == run)

/// A serialization failure is the server asking for the transaction again, from its `begin`.
fn retried(
  left: Int,
  seen: List<String>,
) -> { result: Result<Int, Rollback>, seen: List<String> } / {db.begin, db.commit, db.abort, db.execute[part]} =
  match transaction(Serializable, ReadWrite, || {
      db.execute[part](t_insert("a"), []);
      1
    }) {
    Ok(v) -> { result: Ok(v), seen: seen },
    Err(rolled) -> match rolled.error {
      None -> { result: Err(rolled), seen: seen },
      Some(e) -> if is_retryable(e) && left > 1 { retried(left - 1, push(seen, e.code)) }
      else { { result: Err(rolled), seen: push(seen, e.code) } },
    },
  }

test "a refusal from the server is its SQLSTATE, the constraint it names and its message" {
  simulate {
    let r = over_script(
      1,
      [
        refuse(
          t_insert("a").sql,
          "23505",
          "part_pkey",
          "duplicate key value violates unique constraint \"part_pkey\"",
          "Key (sku)=(a) already exists.",
        ),
      ],
      || [db.execute[part](t_insert("a"), []), db.execute[part](t_insert("b"), [])],
    );
    assert_eq(r.value, [
      Failed({
        code: "23505",
        constraint: "part_pkey",
        detail: "duplicate key value violates unique constraint \"part_pkey\": Key (sku)=(a) already exists.",
      }),
      Count(1),
    ]);
    // The refusal left the server talking on the connection, so the next statement ran on it.
    assert_eq(t_said(r.wires), [[t_insert("a").sql, t_insert("b").sql]])
  }
}

test "a pool finishes every connection it holds once its body returns" {
  simulate {
    let r = over_script(2, [], || {
      let first = db.execute[part](t_insert("a"), []);
      [first, db.execute[part](t_insert("b"), [])]
    });
    assert_eq(r.value, [Count(1), Count(1)]);
    assert(len(r.wires) > 0);
    assert(fold(r.wires, true, |all: Bool, w: Wire| all && !w.open))
  }
}

test "a serialization failure at commit is retryable, and the retry begins a transaction afresh" {
  simulate {
    let r = over_script(
      1,
      [
        refuse(
          "commit",
          "40001",
          "",
          "could not serialize access due to read/write dependencies among transactions",
          "",
        ),
      ],
      || retried(3, []),
    );
    assert_eq(r.value, { result: Ok(1), seen: ["40001"] });
    let begin = t_begin("serializable");
    assert_eq(t_said(r.wires), [
      [begin, t_insert("a").sql, "commit", begin, t_insert("a").sql, "commit"],
    ])
  }
}

test "two tasks' transactions each hold a connection of their own, whichever order they run in" {
  simulate {
    let r = over_script(2, [], || {
      let a = task.spawn(||
        transaction(ReadCommitted, ReadWrite, || {
          db.execute[part](t_insert("a1"), []);
          "a"
        }));
      let b = task.spawn(||
        transaction(ReadCommitted, ReadWrite, || {
          db.execute[part](t_insert("b1"), []);
          db.rollback("b gave up")
        }));
      { a: task.join(a), b: task.join(b) }
    });
    assert_eq(r.value.a, Ok("a"));
    assert_eq(r.value.b, Err({ reason: "b gave up", error: None }));
    let begin = t_begin("read committed");
    let runs = t_runs(r.wires);
    assert_eq(len(runs), 2);
    assert(t_has_run(runs, [begin, t_insert("a1").sql, "commit"]));
    assert(t_has_run(runs, [begin, t_insert("b1").sql, "rollback"]))
  }
}

test "an operation belongs to the one transaction not waiting on the server, and to none when all are" {
  let s = {
    n: 0,
    session: None,
    depth: 1,
    level: ReadCommitted,
    access: ReadWrite,
    busy: false,
    copying: false,
  };
  let waiting = { ..s, n: 1, busy: true };
  assert_eq(route([]), NoTransaction);
  assert_eq(route([waiting]), NoTransaction);
  assert_eq(route([waiting, s]), Own(s));
  assert_eq(route([s, { ..s, n: 2 }]), Ambiguous)
}

test "a pool lends a connection to one statement at a time, and says so when it has none left" {
  simulate {
    let r = over_script(1, [], || {
      let a = task.spawn(|| db.execute[part](t_insert("t1"), []));
      let b = task.spawn(|| db.execute[part](t_insert("t2"), []));
      let c = task.spawn(|| db.execute[part](t_insert("t3"), []));
      [task.join(a), task.join(b), task.join(c)]
    });
    assert(
      fold(r.value, true, |acc: Bool, a: Answer| acc && (a == Count(1) || t_code(a) == "53300")),
    );
    assert(fold(r.value, false, |acc: Bool, a: Answer| acc || a == Count(1)));
    assert_eq(len(r.wires), 1)
  }
}

test "a notification goes on its transaction's connection, its channel and payload as parameters" {
  simulate {
    let r = over_script(1, [], || {
      let inside = transaction(ReadCommitted, ReadWrite, || db.notify[jobs]("in"));
      { inside: inside, outside: db.notify[jobs]("out") }
    });
    assert_eq(r.value.inside, Ok(Count(1)));
    assert_eq(r.value.outside, Count(1));
    assert_eq(t_said(r.wires), [
      [t_begin("read committed"), notify_statement().sql, "commit", notify_statement().sql],
    ])
  }
}

test "an inner abort closes its savepoint, and the transaction around it still commits" {
  simulate {
    let r = over_script(1, [], || {
      let out = transaction(ReadCommitted, ReadWrite, || {
        db.execute[part](t_insert("x"), []);
        let inner = transaction(ReadCommitted, ReadWrite, || {
          db.execute[part](t_insert("y"), []);
          db.rollback("inner gave up")
        });
        db.execute[part](t_insert("z"), []);
        inner
      });
      let after = transaction(ReadCommitted, ReadWrite, || db.execute[part](t_insert("w"), []));
      { out: out, after: after }
    });
    assert_eq(r.value.out, Ok(Err({ reason: "inner gave up", error: None })));
    assert_eq(r.value.after, Ok(Count(1)));
    let begin = t_begin("read committed");
    assert_eq(t_said(r.wires), [
      [
        begin,
        t_insert("x").sql,
        "savepoint ply_sp2",
        t_insert("y").sql,
        "rollback to savepoint ply_sp2; release savepoint ply_sp2",
        t_insert("z").sql,
        "commit",
        begin,
        t_insert("w").sql,
        "commit",
      ],
    ])
  }
}

test "a commit the server turns into a rollback is 25P02, and gives the connection back" {
  simulate {
    let r = over_script(
      1,
      [
        refuse(
          t_insert("a").sql,
          "23505",
          "part_pkey",
          "duplicate key value violates unique constraint \"part_pkey\"",
          "",
        ),
      ],
      || {
        let out = transaction(ReadCommitted, ReadWrite, || db.execute[part](t_insert("a"), []));
        { out: out, next: db.execute[part](t_insert("b"), []) }
      },
    );
    assert_eq(r.value.out, Err({ reason: "commit", error: Some(in_failed_txn()) }));
    assert_eq(r.value.next, Count(1));
    assert_eq(t_said(r.wires), [
      [t_begin("read committed"), t_insert("a").sql, "commit", t_insert("b").sql],
    ])
  }
}

test "a nested begin the transaction cannot take is refused before anything is sent" {
  simulate {
    let r = over_script(
      1,
      [refuse(t_insert("a").sql, "23505", "part_pkey", "duplicate key", "")],
      || {
        let bounded = transaction(ReadCommitted, ReadOnly, ||
          [db.begin(Serializable, ReadOnly), db.begin(ReadCommitted, ReadWrite)]);
        let failed = sandbox(|| {
          db.execute[part](t_insert("a"), []);
          db.begin(ReadCommitted, ReadWrite)
        });
        { bounded: bounded, failed: failed }
      },
    );
    assert_eq(match r.value.bounded { Ok(answers) -> map(answers, t_code), Err(_) -> [] }, [
      "25001",
      "25001",
    ]);
    assert_eq(t_code(r.value.failed), "25P02");
    assert_eq(t_said(r.wires), [
      [
        "begin isolation level read committed read only",
        "commit",
        t_begin("read committed"),
        t_insert("a").sql,
        "rollback",
      ],
    ])
  }
}

test "a connection lost inside a transaction fails the rest of it, and nothing of it runs elsewhere" {
  simulate {
    let r = over_script(
      1,
      [hang_up(t_insert("a").sql, "57P01"), hang_up(t_insert("d").sql, "57P01")],
      || {
        let rest = sandbox(||
          [
            db.execute[part](t_insert("a"), []),
            db.execute[part](t_insert("b"), []),
            db.begin(ReadCommitted, ReadWrite),
          ]);
        let next = db.execute[part](t_insert("c"), []);
        let committed = transaction(ReadCommitted, ReadWrite, ||
          db.execute[part](t_insert("d"), []));
        { rest: map(rest, t_code), next: next, committed: committed }
      },
    );
    assert_eq(r.value.rest, ["57P01", "08003", "08003"]);
    assert_eq(r.value.next, Count(1));
    assert_eq(r.value.committed, Err({ reason: "commit", error: Some(connection_lost()) }));
    let begin = t_begin("read committed");
    assert_eq(t_said(r.wires), [
      [begin, t_insert("a").sql],
      [t_insert("c").sql, begin, t_insert("d").sql],
    ]);
    assert_eq(map(r.wires, |w: Wire| w.open), [false, false])
  }
}

// --- Batching's own tests --------------------------------------------------------

/// A store of `id * 10` for every id, answering each ask alone, counting what it was asked.
fn tens<a>(
  go: () -> a / {db.query[items], db.batch[items], abort.raise, diverges},
) -> { value: a, queries: Int, batches: Int } / {abort.raise, diverges} =
  with_cell[asked]({ queries: 0, batches: 0 }) { counts -> {
    let row = |ps: List<Param>|
      match ps {
        [PInt(id)] -> Rows([map_insert(map_new(), "v", CInt(id * 10))]),
        _ -> Failed(db_error("08P01", "", "one id")),
      };
    let value = handle {
      go()
    } with {
      db.query[items](s, ps) -> {
        cell_set(counts, { ..cell_get(counts), queries: cell_get(counts).queries + 1 });
        row(ps)
      },
      db.batch[items](s, each) -> {
        cell_set(counts, { ..cell_get(counts), batches: cell_get(counts).batches + 1 });
        map(each, row)
      },
    };
    { value: value, queries: cell_get(counts).queries, batches: cell_get(counts).batches }
  } }

fn ten_of(id: Int) -> Int / {db.query[items]} =
  match db.query[items](stmt("select v from items where id = $1"), [PInt(id)]) {
    Rows([r]) -> match map_get(r, "v") { Some(CInt(v)) -> v, _ -> 0 - 1 },
    _ -> 0 - 1,
  }

test "a lookup mapped over its ids asks the store once, and answers what each ask alone would" {
  let ids = [3, 1, 4, 1, 5];
  let alone = tens(|| map(ids, ten_of));
  let together = tens(|| batched[items](ids, ten_of));
  assert_eq(together.value, alone.value);
  assert_eq({ queries: alone.queries, batches: alone.batches }, { queries: 5, batches: 0 });
  assert_eq({ queries: together.queries, batches: together.batches }, { queries: 0, batches: 1 })
}

test "a lookup that asks twice is answered in two rounds, and a lone ask is a query" {
  let twice = |id: Int| ten_of(id) + ten_of(id + 100);
  let r = tens(|| batched[items]([1, 2, 3], twice));
  assert_eq(r.value, [1020, 1040, 1060]);
  assert_eq({ queries: r.queries, batches: r.batches }, { queries: 0, batches: 2 });
  let one = tens(|| batched[items]([7], ten_of));
  assert_eq({ value: one.value, queries: one.queries, batches: one.batches }, {
    value: [70],
    queries: 1,
    batches: 0,
  })
}

test "a batch is the statement once per ask, its placeholders numbered on and its rows marked" {
  let c = coalesced(stmt("select v from items where id = $1 and kind = $2;"), [
    [PInt(1), PText("a")],
    [PInt(2), PText("b")],
  ]);
  assert_eq(
    match c { Some(x) -> x.s.sql, None -> "" },
    "select * from (select 0 as \"ply.ask\", row_number() over () as \"ply.row\", \"ply.arm\".* from (select v from items where id = $1 and kind = $2) as \"ply.arm\" union all select 1 as \"ply.ask\", row_number() over () as \"ply.row\", \"ply.arm\".* from (select v from items where id = $3 and kind = $4) as \"ply.arm\") as \"ply.batch\" order by \"ply.ask\", \"ply.row\"",
  );
  assert_eq(match c { Some(x) -> x.ps, None -> [] }, [PInt(1), PText("a"), PInt(2), PText("b")]);
  // An ask whose parameters are not the placeholders' would answer another's: it is asked alone.
  assert_eq(coalesced(stmt("select v from items where id = $1"), [[PInt(1)], []]), None);
  // A placeholder inside text is text.
  assert_eq(
    match coalesced(stmt("select '$1' as t from items where id = $1"), [[PInt(1)], [PInt(2)]]) {
      Some(x) -> string_contains(x.s.sql, "select '$1' as t from items where id = $2"),
      None -> false,
    },
    true,
  )
}

test "a batch's rows come apart by the ask they answer, in order, without the batch's columns" {
  let marked = |ask: Int, place: Int, v: Int|
    map_insert(
      map_insert(map_insert(map_new(), "ply.ask", CInt(ask)), "ply.row", CInt(place)),
      "v",
      CInt(v),
    );
  assert_eq(split_asks([marked(0, 1, 5), marked(0, 2, 6), marked(2, 1, 7)], 3), [
    Rows([map_insert(map_new(), "v", CInt(5)), map_insert(map_new(), "v", CInt(6))]),
    Rows([]),
    Rows([map_insert(map_new(), "v", CInt(7))]),
  ])
}
