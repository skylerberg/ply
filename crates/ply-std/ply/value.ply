// std.value — a value of any type as data, and `render`, the one way a value is shown.

// What `machine.call` crosses, what a runtime diagnostic carries, and what the prover draws.
pub type Value =
  | VUnit
  | VBool(Bool)
  | VInt(Int)
  | VFloat(Float)
  | VDecimal(Decimal)
  // The width's name and the pattern it reads, with nothing above the width: `-1i8` is `0xFFu128`.
  | VFixed(String, U128)
  | VStr(String)
  | VBytes(Bytes)
  | VList(List<Value>)
  // Sorted by name, as a record's fields are.
  | VRecord(List<Field>)
  | VCtor(String, List<Value>)
  // In key order.
  | VMap(List<Entry>)
  | VFn(Fun)
  | VCell({ index: Int, generation: Int })
  | VTask(Int)
  // A credential, whose payload never leaves the runtime.
  | VSecret
  // What a diagnostic's snapshot left out: that many more items of a list or map, or with 0,
  // everything nested deeper.
  | VElided(Int)

pub type Field = { name: String, value: Value }

pub type Entry = { key: Value, value: Value }

// A function as data. Only a generated one (constant, projection, table) can be called.
pub type Fun =
  | FNamed(String)
  | FAnonymous
  | FConst({ arity: Int, value: Value })
  | FProject({ arity: Int, index: Int })
  // The first entry whose key equals the first argument, else `default`.
  | FTable({ arity: Int, entries: List<Entry>, default: Value })

// A list or a map shows this many items before the rest is counted.
pub fn shown_items() -> Int = 32

// Nesting past this shows as `…`.
pub fn shown_depth() -> Int = 16

pub fn render(v: Value) -> String = rendered(v, 0)

fn rendered(v: Value, depth: Int) -> String =
  if depth > shown_depth() { "…" } else {
    match v {
      VUnit -> "()",
      VBool(b) -> if b { "true" } else { "false" },
      VInt(n) -> int_to_string(n),
      VFloat(f) -> float_to_string(f),
      VDecimal(d) -> decimal_to_string(d),
      VFixed(ty, bits) -> fixed_text(ty, bits),
      VStr(s) -> "\"" ++ escaped(s) ++ "\"",
      VBytes(b) -> bytes_text(b),
      VList(items) -> "[" ++ items_text(map(items, |x: Value| rendered(x, depth + 1))) ++ "]",
      VRecord(fields) -> record_text(fields, depth),
      VCtor(name, args) -> if len(args) == 0 { name }
      else { name ++ "(" ++ joined(map(args, |x: Value| rendered(x, depth + 1)), ", ") ++ ")" },
      VMap(entries) -> "{" ++ items_text(map(entries, |e: Entry| entry_text(e, depth))) ++ "}",
      VFn(f) -> "<fn" ++ fun_text(f) ++ ">",
      VCell(c) -> "<cell @" ++ int_to_string(c.index) ++ "." ++ int_to_string(c.generation) ++ ">",
      VTask(id) -> "<task @" ++ int_to_string(id) ++ ">",
      VSecret -> "Secret(****)",
      VElided(n) -> elided(n),
    }
  }

fn elided(n: Int) -> String = if n == 0 { "…" } else { "… " ++ int_to_string(n) ++ " more" }

fn entry_text(e: Entry, depth: Int) -> String =
  match e.key {
    VElided(n) -> elided(n),
    k -> rendered(k, depth + 1) ++ ": " ++ rendered(e.value, depth + 1),
  }

// Past `shown_items`, the rest is counted; a snapshot already cut short says so itself.
fn items_text(parts: List<String>) -> String =
  if len(parts) <= shown_items() { joined(parts, ", ") }
  else { joined(push(take(parts, shown_items()), elided(len(parts) - shown_items())), ", ") }

fn take(xs: List<String>, n: Int) -> List<String> =
  map(range(0, n), |i: Int| match list_at(xs, i) { Some(x) -> x, None -> "" })

fn joined(parts: List<String>, sep: String) -> String =
  fold(range(0, len(parts)), "", |acc: String, i: Int|
    match list_at(parts, i) { Some(p) -> if i == 0 { p } else { acc ++ sep ++ p }, None -> acc })

// A tuple is the record `{_0: a, _1: b}` and shows as one.
fn record_text(fields: List<Field>, depth: Int) -> String =
  if is_tuple(fields) {
    "(" ++ joined(map(range(0, len(fields)), |i: Int| tuple_item(fields, i, depth)), ", ") ++ ")"
  } else {
    "{" ++ joined(map(fields, |f: Field| f.name ++ ": " ++ rendered(f.value, depth + 1)), ", ")
      ++ "}"
  }

fn is_tuple(fields: List<Field>) -> Bool =
  len(fields) >= 2
    && fold(range(0, len(fields)), true, |acc: Bool, i: Int|
      acc && field_named(fields, "_" ++ int_to_string(i)) != None)

fn field_named(fields: List<Field>, name: String) -> Option<Value> =
  fold(fields, None, |acc: Option<Value>, f: Field|
    if f.name == name { Some(f.value) } else { acc })

fn tuple_item(fields: List<Field>, i: Int, depth: Int) -> String =
  match field_named(fields, "_" ++ int_to_string(i)) {
    Some(v) -> rendered(v, depth + 1),
    None -> "",
  }

// A generated function shows as the lambda it behaves as.
fn fun_text(f: Fun) -> String =
  match f {
    FNamed(name) -> " " ++ name,
    FAnonymous -> "",
    FConst(c) ->
      " |" ++ joined(map(range(0, c.arity), |_: Int| "_"), ", ") ++ "| " ++ render(c.value),
    FProject(p) -> " |" ++ params(p.arity) ++ "| x" ++ int_to_string(p.index),
    FTable(t) -> " |" ++ params(t.arity) ++ "| " ++ table_text(t.entries, t.default),
  }

fn params(arity: Int) -> String =
  joined(map(range(0, arity), |i: Int| "x" ++ int_to_string(i)), ", ")

fn table_text(entries: List<Entry>, default: Value) -> String =
  fold(range(0, len(entries)), render(default), |acc: String, j: Int|
    match list_at(entries, len(entries) - 1 - j) {
      Some(e) ->
        "if x0 == " ++ render(e.key) ++ " { " ++ render(e.value) ++ " } else { " ++ acc ++ " }",
      None -> acc,
    })

// --- Slots ------------------------------------------------------------------

// A runtime diagnostic's text stands `values[i]` in as `\x01`, `i` in decimal, `\x02`.
fn opener() -> String = string_of_bytes(b"\x01")

fn closer() -> String = string_of_bytes(b"\x02")

// `text` with each slot replaced by its value, rendered.
pub fn filled(text: String, values: List<Value>) -> String =
  match string_split(text, opener()) {
    [head, ..pieces] ->
      fold(pieces, head, |acc: String, piece: String| acc ++ slot_piece(piece, values)),
    [] -> text,
  }

// A slot naming no value is kept as it came.
fn slot_piece(piece: String, values: List<Value>) -> String =
  match string_split(piece, closer()) {
    [index, ..rest] -> match slot_value(index, values) {
      Some(v) -> render(v) ++ joined(rest, closer()),
      None -> opener() ++ piece,
    },
    [] -> opener() ++ piece,
  }

fn slot_value(index: String, values: List<Value>) -> Option<Value> = {
  let digits = bytes_of_string(index);
  if bytes_len(digits) == 0 || bytes_len(digits) > 9
      || !fold(range(0, bytes_len(digits)), true, |ok: Bool, i: Int|
        ok && bytes_at(digits, i) >= 48 && bytes_at(digits, i) <= 57) { None } else {
    list_at(
      values,
      fold(range(0, bytes_len(digits)), 0, |n: Int, i: Int| n * 10 + bytes_at(digits, i) - 48),
    )
  }
}

// --- Fixed widths -----------------------------------------------------------

fn width_of(ty: String) -> Int =
  if ty == "U8" || ty == "I8" { 8 }
  else if ty == "U16" || ty == "I16" { 16 }
  else if ty == "U32" || ty == "I32" { 32 }
  else if ty == "U64" || ty == "I64" { 64 }
  else { 128 }

fn mask(width: Int) -> U128 = if width == 128 { ~0u128 } else { wrap_sub(1u128 << width, 1u128) }

fn fixed_text(ty: String, bits: U128) -> String = {
  let width = width_of(ty);
  let pattern = bits & mask(width);
  let negative = string_starts_with(ty, "I") && pattern >> width - 1 == 1u128;
  if negative { "-" ++ u128_to_string(wrap_sub(0u128, pattern) & mask(width)) }
  else { u128_to_string(pattern) }
}

// --- Order ------------------------------------------------------------------

// The order the runtime keeps values in, which is a map's key order: by kind first, then within
// one kind as `compare` orders its payloads.
pub fn order(a: Value, b: Value) -> Ordering = {
  let ranks = compare(rank(a), rank(b));
  if ranks != Equal { ranks } else {
    match (a, b) {
      (VBool(x), VBool(y)) -> compare(x, y),
      (VInt(x), VInt(y)) -> compare(x, y),
      (VFloat(x), VFloat(y)) -> compare(total_key(x), total_key(y)),
      (VDecimal(x), VDecimal(y)) -> compare(x, y),
      (VFixed(tx, x), VFixed(ty, y)) -> {
        let widths = compare(width_rank(tx), width_rank(ty));
        if widths != Equal { widths } else { compare(signed_key(tx, x), signed_key(ty, y)) }
      },
      (VStr(x), VStr(y)) -> compare(x, y),
      (VBytes(x), VBytes(y)) -> compare(x, y),
      (VList(xs), VList(ys)) -> ordered(xs, ys, order),
      (VMap(xs), VMap(ys)) -> ordered(xs, ys, |p: Entry, q: Entry| {
        let keys = order(p.key, q.key);
        if keys != Equal { keys } else { order(p.value, q.value) }
      }),
      (VRecord(xs), VRecord(ys)) -> ordered(xs, ys, |p: Field, q: Field| {
        let names = compare(p.name, q.name);
        if names != Equal { names } else { order(p.value, q.value) }
      }),
      (VCtor(nx, xs), VCtor(ny, ys)) -> {
        let names = compare(nx, ny);
        if names != Equal { names } else { ordered(xs, ys, order) }
      },
      (VCell(x), VCell(y)) -> compare(x, y),
      (VTask(x), VTask(y)) -> compare(x, y),
      _ -> Equal,
    }
  }
}

fn rank(v: Value) -> Int =
  match v {
    VUnit -> 0,
    VBool(_) -> 1,
    VInt(_) -> 2,
    VFloat(_) -> 3,
    VDecimal(_) -> 4,
    VStr(_) -> 5,
    VBytes(_) -> 6,
    VList(_) -> 7,
    VMap(_) -> 8,
    VRecord(_) -> 9,
    VCtor(_, _) -> 10,
    VFn(_) -> 11,
    VCell(_) -> 12,
    VTask(_) -> 13,
    VSecret -> 14,
    VFixed(_, _) -> 15,
    VElided(_) -> 16,
  }

// IEEE 754's total order as a signed integer: a negative float's magnitude bits are flipped.
fn total_key(f: Float) -> Int = {
  let b = bits_of_float(f);
  if b < 0 { b ^ 0x7FFF_FFFF_FFFF_FFFF } else { b }
}

// The widths in the runtime's declaration order.
fn width_rank(ty: String) -> Int =
  match list_index(["U8", "U16", "U32", "U64", "I8", "I16", "I32", "I64", "U128", "I128"], ty) {
    Some(i) -> i,
    None -> 10,
  }

fn list_index(xs: List<String>, x: String) -> Option<Int> =
  fold(range(0, len(xs)), None, |found: Option<Int>, i: Int|
    match found { Some(_) -> found, None -> if list_at(xs, i) == Some(x) { Some(i) } else { None } })

// A signed pattern with its width's sign bit flipped orders as an unsigned one.
fn signed_key(ty: String, bits: U128) -> U128 = {
  let width = width_of(ty);
  let pattern = bits & mask(width);
  if string_starts_with(ty, "I") { pattern ^ (1u128 << width - 1) } else { pattern }
}

fn ordered<a>(xs: List<a>, ys: List<a>, by: (a, a) -> Ordering) -> Ordering = {
  let common = fold(range(0, min(len(xs), len(ys))), Equal, |acc: Ordering, i: Int|
    if acc != Equal { acc } else {
      match (list_at(xs, i), list_at(ys, i)) { (Some(x), Some(y)) -> by(x, y), _ -> Equal }
    });
  if common != Equal { common } else { compare(len(xs), len(ys)) }
}

// A map of these entries in key order; a later entry for a key replaces an earlier one, as
// inserting them one at a time would.
pub fn map_of(entries: List<Entry>) -> Value =
  VMap(fold(entries, [], |acc: List<Entry>, e: Entry| inserted(acc, e)))

fn inserted(sorted: List<Entry>, e: Entry) -> List<Entry> = {
  let at = fold(range(0, len(sorted)), len(sorted), |found: Int, i: Int|
    if found < len(sorted) { found } else {
      match list_at(sorted, i) { Some(s) -> if order(e.key, s.key) != Greater { i } else { found }, None -> found }
    });
  if at == len(sorted) { push(sorted, e) } else {
    let same = match list_at(sorted, at) { Some(s) -> order(e.key, s.key) == Equal, None -> false };
    fold(range(0, len(sorted)), [], |out: List<Entry>, i: Int|
      match list_at(sorted, i) {
        Some(s) -> if i != at { push(out, s) } else if same { push(out, e) } else { push(push(out, e), s) },
        None -> out,
      })
  }
}

// --- Text -------------------------------------------------------------------

fn escaped(s: String) -> String =
  string_of_bytes(
    escape_each(bytes_of_string(s), |c: Int|
      if c == 10 { Some(b"\\n") }
      else if c == 9 { Some(b"\\t") }
      else if c == 13 { Some(b"\\r") }
      else if c == 0 { Some(b"\\0") }
      else if c == 92 { Some(b"\\\\") }
      else if c == 34 { Some(b"\\\"") }
      else { None }),
  )

// Only ASCII is replaced, so UTF-8 stays whole.
fn escape_each(b: Bytes, swap: (Int) -> Option<Bytes>) -> Bytes =
  bytes_concat_all(
    map(range(0, bytes_len(b)), |i: Int|
      match swap(bytes_at(b, i)) { Some(r) -> r, None -> bytes_slice(b, i, i + 1) }),
  )

fn bytes_text(b: Bytes) -> String = {
  let n = bytes_len(b);
  let head = if n > shown_items() { bytes_slice(b, 0, shown_items()) } else { b };
  let body = escape_each(head, |c: Int|
    if c == 10 { Some(b"\\n") }
    else if c == 9 { Some(b"\\t") }
    else if c == 13 { Some(b"\\r") }
    else if c == 92 { Some(b"\\\\") }
    else if c == 34 { Some(b"\\\"") }
    else if c >= 32 && c <= 126 { None }
    else { Some(bytes_concat(b"\\x", hex2(c))) });
  let more = if n > shown_items() { " " ++ elided(n - shown_items()) } else { "" };
  "b\"" ++ string_of_bytes(body) ++ "\"" ++ more
}

fn hex2(c: Int) -> Bytes = bytes_concat(hex_digit(c / 16), hex_digit(c % 16))

fn hex_digit(d: Int) -> Bytes = bytes_slice(b"0123456789abcdef", d, d + 1)

// --- Tests ------------------------------------------------------------------

test "scalars show as their literals do, without a width suffix" {
  assert_eq(render(VInt(-3)), "-3");
  assert_eq(render(VBool(true)), "true");
  assert_eq(render(VUnit), "()");
  assert_eq(render(VFloat(1.5)), "1.5");
  assert_eq(render(VDecimal(1.50m)), "1.50");
  assert_eq(render(VFixed("U8", 255u128)), "255");
  assert_eq(render(VFixed("I8", 255u128)), "-1");
  assert_eq(
    render(VFixed("I128", 170141183460469231731687303715884105728u128)),
    "-170141183460469231731687303715884105728",
  );
  assert_eq(
    render(VFixed("U128", 340282366920938463463374607431768211455u128)),
    "340282366920938463463374607431768211455",
  )
}

test "text is quoted and escaped, and bytes past the first 32 are counted" {
  assert_eq(render(VStr("a\"b\n")), "\"a\\\"b\\n\"");
  assert_eq(render(VStr("é")), "\"é\"");
  assert_eq(render(VBytes(b"GET \x00\xff")), "b\"GET \\x00\\xff\"");
  assert_eq(
    render(VBytes(bytes_concat_all(map(range(0, 40), |_: Int| b"a")))),
    "b\"" ++ string_of_bytes(bytes_concat_all(map(range(0, 32), |_: Int| b"a"))) ++ "\" … 8 more",
  )
}

test "containers nest, a tuple shows as one, and a list past 32 items is counted" {
  assert_eq(render(VList([VInt(1), VInt(2)])), "[1, 2]");
  assert_eq(
    render(VRecord([{ name: "a", value: VInt(1) }, { name: "b", value: VStr("x") }])),
    "{a: 1, b: \"x\"}",
  );
  assert_eq(
    render(VRecord([{ name: "_0", value: VInt(1) }, { name: "_1", value: VBool(false) }])),
    "(1, false)",
  );
  assert_eq(render(VCtor("Some", [VInt(3)])), "Some(3)");
  assert_eq(render(VCtor("None", [])), "None");
  assert_eq(render(VMap([{ key: VStr("k"), value: VInt(1) }])), "{\"k\": 1}");
  assert_eq(
    render(VList(map(range(0, 34), |i: Int| VInt(i)))),
    "[" ++ joined(map(range(0, 32), |i: Int| int_to_string(i)), ", ") ++ ", … 2 more]",
  )
}

test "a snapshot cut short shows where it was cut" {
  assert_eq(render(VList([VInt(1), VElided(5)])), "[1, … 5 more]");
  assert_eq(
    render(VMap([{ key: VInt(1), value: VInt(2) }, { key: VElided(3), value: VElided(3) }])),
    "{1: 2, … 3 more}",
  );
  assert_eq(render(VCtor("Some", [VElided(0)])), "Some(…)")
}

test "nesting past the shown depth is elided" {
  let deep = fold(range(0, 20), VInt(0), |acc: Value, _: Int| VList([acc]));
  assert(string_contains(render(deep), "[…]"));
  assert(!string_contains(render(deep), "0"))
}

test "a slot is filled with its value, and a slot naming none is kept" {
  let slot = |i: Int| opener() ++ int_to_string(i) ++ closer();
  assert_eq(
    filled("expected " ++ slot(0) ++ ", found " ++ slot(1), [VInt(1), VStr("a")]),
    "expected 1, found \"a\"",
  );
  assert_eq(filled("no slots", []), "no slots");
  assert_eq(filled("at " ++ slot(3), [VInt(1)]), "at " ++ slot(3))
}

test "a function shows as what it is" {
  assert_eq(render(VFn(FNamed("m.double"))), "<fn m.double>");
  assert_eq(render(VFn(FAnonymous)), "<fn>");
  assert_eq(render(VFn(FConst({ arity: 2, value: VInt(3) }))), "<fn |_, _| 3>");
  assert_eq(render(VFn(FProject({ arity: 2, index: 1 }))), "<fn |x0, x1| x1>");
  assert_eq(
    render(
      VFn(
        FTable({
          arity: 1,
          entries: [{ key: VInt(1), value: VBool(true) }],
          default: VBool(false),
        }),
      ),
    ),
    "<fn |x0| if x0 == 1 { true } else { false }>",
  );
  assert_eq(render(VSecret), "Secret(****)");
  assert_eq(render(VCell({ index: 3, generation: 1 })), "<cell @3.1>");
  assert_eq(render(VTask(7)), "<task @7>")
}

test "values order by kind first, then as their payloads compare" {
  assert_eq(order(VInt(5), VStr("a")), Less);
  assert_eq(order(VStr("b"), VStr("ab")), Greater);
  assert_eq(order(VList([VInt(1)]), VList([VInt(1), VInt(0)])), Less);
  assert_eq(order(VCtor("m.A", [VInt(9)]), VCtor("m.B", [])), Less);
  // A signed width orders by value, so `-1i8` is below `0i8`; an unsigned one by pattern.
  assert_eq(order(VFixed("I8", 255u128), VFixed("I8", 0u128)), Less);
  assert_eq(order(VFixed("U8", 255u128), VFixed("U8", 0u128)), Greater);
  assert_eq(order(VFloat(0.0 - 1.0), VFloat(0.5)), Less)
}

test "a map is in key order, and a later entry for a key replaces an earlier one" {
  assert_eq(
    map_of([
      { key: VInt(3), value: VStr("c") },
      { key: VInt(1), value: VStr("a") },
      { key: VInt(3), value: VStr("z") },
      { key: VInt(2), value: VStr("b") },
    ]),
    VMap([
      { key: VInt(1), value: VStr("a") },
      { key: VInt(2), value: VStr("b") },
      { key: VInt(3), value: VStr("z") },
    ]),
  )
}
