//! Base64 as RFC 4648 defines it: the standard alphabet with padding, and the URL-safe alphabet
//! without.
//!
//! RFC 4648 §4 is `base64_encode`/`base64_decode`: `A-Za-z0-9+/`, padded to a multiple of four.
//! RFC 4648 §5 is `base64url_encode`/`base64url_decode`: `A-Za-z0-9-_`, unpadded, which is the form a
//! JWT and a URL carry. Both directions are pure and total; a decoder answers `None` rather than
//! raising, and refuses what the RFC says is not canonical (a padding character anywhere but the
//! end, a wrong length, or bits left over in the last group that are not zero), so a decode of an
//! encode is the identity.
//!
//! These are `std.radix` at two of its alphabets; a padded URL-safe text, or an unpadded standard
//! one, is that module's `padded` and `unpadded`.

import std.bytes (repeat)
import std.laws (round_trip)
import std.radix

/// The standard alphabet, padded.
pub fn base64_encode(data: Bytes) -> String / {abort.raise} = radix::encode(radix::base64(), data)

/// The URL-safe alphabet, unpadded.
pub fn base64url_encode(data: Bytes) -> String / {abort.raise} =
  radix::encode(radix::base64url(), data)

/// The standard padded form read back; `None` for anything not canonical.
pub fn base64_decode(text: String) -> Option<Bytes> / {abort.raise} =
  radix::decode(radix::base64(), text)

/// What `base64_decode` reads of a sealed text, sealed: the runtime decodes it without opening it,
/// in steps that follow its length alone. `None` for anything not canonical, which is all it says
/// of the text.
pub fn base64_decode_secret(text: Secret<String>) -> Option<Secret<Bytes>> / {abort.raise} =
  secret_decode("base64", text)

/// What `base64url_decode` reads of a sealed text, sealed, as `base64_decode_secret` reads one.
pub fn base64url_decode_secret(text: Secret<String>) -> Option<Secret<Bytes>> / {abort.raise} =
  secret_decode("base64url", text)

/// The URL-safe unpadded form read back; `None` for anything not canonical.
pub fn base64url_decode(text: String) -> Option<Bytes> / {abort.raise} =
  radix::decode(radix::base64url(), text)

/// What a `base64"..."` literal is checked by: the bytes a padded text in the standard alphabet
/// names, or where it stops being canonical.
pub fn literal(text: String) -> Result<Bytes, { message: String, offset: Int }> / {abort.raise} =
  match radix::parse(radix::base64(), text) {
    Ok(data) -> Ok(data),
    Err(r) ->
      Err({
        message: match r.why {
          radix::Stray -> "not a base64 letter",
          radix::Ragged -> "padded base64 is a multiple of four characters",
          radix::Lone -> "the last letter completes no byte",
          radix::Loose -> "the last letter leaves bits no byte holds",
        },
        offset: r.at,
      }),
  }

// --- Tests ------------------------------------------------------------------

law "a decode of an encode is the bytes encoded" = round_trip(base64_encode, base64_decode)

law "a URL-safe decode of an encode is the bytes encoded" =
  round_trip(base64url_encode, base64url_decode)

law "a sealed text decodes to what its plain text does, sealed"
  forall (text: String) {
    base64_decode_secret(secret_of_string(text))
      == (match base64_decode(text) { Some(data) -> Some(secret_of_bytes(data)), None -> None })
      && base64url_decode_secret(secret_of_string(text))
      == (match base64url_decode(text) { Some(data) -> Some(secret_of_bytes(data)), None -> None })
  }

law "a sealed encoding decodes to its bytes, sealed"
  forall (data: Bytes) {
    base64_decode_secret(secret_of_string(base64_encode(data))) == Some(secret_of_bytes(data))
      && base64url_decode_secret(secret_of_string(base64url_encode(data)))
      == Some(secret_of_bytes(data))
  }

type Vector = { bytes: Bytes, text: String }

/// RFC 4648, section 10.
fn rfc_4648() -> List<Vector> =
  [
    { bytes: b"", text: "" },
    { bytes: b"f", text: "Zg==" },
    { bytes: b"fo", text: "Zm8=" },
    { bytes: b"foo", text: "Zm9v" },
    { bytes: b"foob", text: "Zm9vYg==" },
    { bytes: b"fooba", text: "Zm9vYmE=" },
    { bytes: b"foobar", text: "Zm9vYmFy" },
  ]

test "the RFC 4648 vector of {v.bytes} encodes and decodes" for v: Vector in rfc_4648() {
  assert_eq(base64_encode(v.bytes), v.text);
  assert_eq(base64_decode(v.text), Some(v.bytes))
}

test "the URL-safe form has no padding and its own two letters" {
  assert_eq(base64url_encode(b"\xff\xff\xfe"), "___-");
  assert_eq(base64url_decode("___-"), Some(b"\xff\xff\xfe"));
  assert_eq(base64url_encode(b"foob"), "Zm9vYg");
  assert_eq(base64url_decode("Zm9vYg"), Some(b"foob"));
  assert_eq(base64url_encode(b"f"), "Zg");
  assert_eq(base64url_decode("Zg"), Some(b"f"))
}

test "a decoder refuses what is not the canonical form" {
  // A wrong length, padding in the middle, a letter outside the alphabet, and a final letter whose
  // low bits are not the zero bits the bytes it would name do not use.
  assert_eq(base64_decode("Zg"), None);
  assert_eq(base64_decode("Zg="), None);
  assert_eq(base64_decode("Z==="), None);
  assert_eq(base64_decode("Zm9vYg"), None);
  assert_eq(base64_decode("Zm9!"), None);
  assert_eq(base64_decode("Zm9="), None);
  // The URL-safe alphabet has neither `+`, `/` nor `=`.
  assert_eq(base64url_decode("+/+/"), None);
  assert_eq(base64url_decode("Zg=="), None)
}

test "a sealed text is read as a plain one is, and refused as one is" {
  let read = |text: String| base64_decode_secret(secret_of_string(text));
  let url = |text: String| base64url_decode_secret(secret_of_string(text));
  assert_eq(read("Zm9vYg=="), Some(secret_of_bytes(b"foob")));
  assert_eq(read("Zm9vYmE="), Some(secret_of_bytes(b"fooba")));
  assert_eq(read("+/+/"), Some(secret_of_bytes(b"\xfb\xff\xbf")));
  assert_eq(read(""), Some(secret_of_bytes(b"")));
  assert_eq(read("Zg"), None);
  assert_eq(read("Zg="), None);
  assert_eq(read("Z==="), None);
  assert_eq(read("===="), None);
  assert_eq(read("Zm9vYg"), None);
  assert_eq(read("Zm9!"), None);
  assert_eq(read("Zm9="), None);
  assert_eq(read("Zg=a"), None);
  assert_eq(read("___-"), None);
  assert_eq(url("___-"), Some(secret_of_bytes(b"\xff\xff\xfe")));
  assert_eq(url("Zm9vYg"), Some(secret_of_bytes(b"foob")));
  assert_eq(url("Zg"), Some(secret_of_bytes(b"f")));
  assert_eq(url("+/+/"), None);
  assert_eq(url("Zg=="), None);
  assert_eq(url("Z"), None);
  assert_eq(url("Zh"), None)
}

test "a literal's check answers the bytes, or where the text stops being canonical" {
  assert_eq(literal("Zm9vYg=="), Ok(b"foob"));
  assert_eq(literal(""), Ok(b""));
  assert_eq(literal("Zm9!"), Err({ message: "not a base64 letter", offset: 3 }));
  assert_eq(literal("Zg=a"), Err({ message: "not a base64 letter", offset: 2 }));
  assert_eq(
    literal("Zm9vYg"),
    Err({ message: "padded base64 is a multiple of four characters", offset: 6 }),
  );
  assert_eq(
    literal("Zm9="),
    Err({ message: "the last letter leaves bits no byte holds", offset: 2 }),
  );
  assert_eq(literal("Z==="), Err({ message: "the last letter completes no byte", offset: 0 }))
}

test "three bytes are at most a step either way, and nothing allocates but to grow the answer" {
  let within = |got: Int, most: Int|
    assert(got <= most, Some(int_to_string(got) ++ " is past " ++ int_to_string(most)));
  let written = |b: Bytes| metered(|| base64_encode(b));
  let read = |b: Bytes| {
    let text = base64_encode(b);
    metered(|| base64_decode(text))
  };
  let short = repeat(b"\x5a\xc3\x01", 20);
  let long = repeat(b"\x5a\xc3\x01", 1044);
  within(written(long).steps - written(short).steps, 1024);
  within(read(long).steps - read(short).steps, 1024);
  within(written(long).allocations - written(short).allocations, 8);
  within(read(long).allocations - read(short).allocations, 8);
  // Thirty-two bytes end in a group short of three, which is read a letter at a time.
  let digest = repeat(b"\x5a", 32);
  within(written(digest).steps, 36);
  within(read(digest).steps, 44);
  within(written(digest).allocations, 10);
  within(read(digest).allocations, 20)
}
