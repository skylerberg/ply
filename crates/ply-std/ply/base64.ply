// `base64` — the standard alphabet with padding, and the URL-safe alphabet without.
//
// RFC 4648 §4 is `base64_encode`/`base64_decode`: `A-Za-z0-9+/`, padded to a multiple of four.
// RFC 4648 §5 is `base64url_encode`/`base64url_decode`: `A-Za-z0-9-_`, unpadded, which is the form a
// JWT and a URL carry. Both directions are pure and total; a decoder answers `None` rather than
// raising, and refuses what the RFC says is not canonical (a padding character anywhere but the
// end, a wrong length, or bits left over in the last group that are not zero), so a decode of an
// encode is the identity.

pub fn base64_encode(data: Bytes) -> String / {abort.raise} = encode(standard(), data, true)

pub fn base64url_encode(data: Bytes) -> String / {abort.raise} = encode(url_safe(), data, false)

pub fn base64_decode(text: String) -> Option<Bytes> / {abort.raise} = decode(standard(), text, true)

pub fn base64url_decode(text: String) -> Option<Bytes> / {abort.raise} = decode(url_safe(), text, false)

fn standard() -> String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

fn url_safe() -> String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"

fn encode(alpha: String, data: Bytes, padded: Bool) -> String / {abort.raise} =
  fold(range(0, (bytes_len(data) + 2) / 3), "", |acc: String, i: Int| {
    let at = i * 3;
    let left = bytes_len(data) - at;
    let n = octet_at(data, at) * 65536 + octet_at(data, at + 1) * 256 + octet_at(data, at + 2);
    let c0 = letter(alpha, n >>> 18 & 0x3F);
    let c1 = letter(alpha, n >>> 12 & 0x3F);
    let c2 = letter(alpha, n >>> 6 & 0x3F);
    let c3 = letter(alpha, n & 0x3F);
    if left == 1 { acc ++ c0 ++ c1 ++ (if padded { "==" } else { "" }) }
    else if left == 2 { acc ++ c0 ++ c1 ++ c2 ++ (if padded { "=" } else { "" }) }
    else { acc ++ c0 ++ c1 ++ c2 ++ c3 }
  })

fn decode(alpha: String, text: String, padded: Bool) -> Option<Bytes> / {abort.raise} = {
  let n = string_len(text);
  let pad = if padded { padding_of(text) } else { 0 };
  let body = n - pad;
  if padded && n % 4 != 0 { None }
  else if !letters_only(alpha, text, body) { None } else {
    let groups = body / 4;
    let rem = body % 4;
    // The letters are in the alphabet by now, so `group`'s lookups cannot raise.
    let m = group(alpha, text, groups * 4, rem);
    if rem == 1 { None }
    else if rem == 3 && m & 0xFF != 0 { None }
    else if rem == 2 && m & 0xFFFF != 0 { None } else {
      Some(
        bytes_concat_all([
          fold(range(0, groups), b"", |acc: Bytes, g: Int|
            bytes_concat(acc, group_bytes(group(alpha, text, g * 4, 4)))),
          tail_bytes(m, rem),
        ]),
      )
    }
  }
}

// The three bytes a full group names.
fn group_bytes(m: Int) -> Bytes / {abort.raise} =
  bytes_concat_all([
    byte_of_int(m >>> 16 & 0xFF),
    byte_of_int(m >>> 8 & 0xFF),
    byte_of_int(m & 0xFF),
  ])

// The bytes a final group of two or three letters names.
fn tail_bytes(m: Int, rem: Int) -> Bytes / {abort.raise} =
  if rem == 3 { bytes_concat_all([byte_of_int(m >>> 16 & 0xFF), byte_of_int(m >>> 8 & 0xFF)]) }
  else if rem == 2 { byte_of_int(m >>> 16 & 0xFF) }
  else { b"" }

// The letters a body of `len` (zero to four) name, in the 24-bit positions a full group uses, so a
// partial group's unused low bits are the ones a canonical decoder checks are zero.
fn group(alpha: String, text: String, at: Int, len: Int) -> Int / {abort.raise} = {
  // Only the letters that are there are read: an index past the body is a padding character, and
  // `string_find` raises on one.
  let c0 = letter_value(alpha, text, at);
  if len <= 1 { c0 } else {
    let c1 = letter_value(alpha, text, at + 1);
    if len == 2 { c0 << 18 | c1 << 12 } else {
      let c2 = letter_value(alpha, text, at + 2);
      if len == 3 { c0 << 18 | c1 << 12 | c2 << 6 }
      else { c0 << 18 | c1 << 12 | c2 << 6 | letter_value(alpha, text, at + 3) }
    }
  }
}

fn letter_value(alpha: String, text: String, at: Int) -> Int / {abort.raise} =
  if at < string_len(text) { string_find(alpha, string_slice(text, at, at + 1)) } else { 0 }

// How many padding characters `text` ends with: zero, one or two. A padding character anywhere else
// is caught by `letters_only`, and one that leaves a length not divisible by four by the length
// check.
fn padding_of(text: String) -> Int / {abort.raise} = {
  let n = string_len(text);
  let last = if n == 0 { "" } else { string_slice(text, n - 1, n) };
  let second = if n < 2 { "" } else { string_slice(text, n - 2, n - 1) };
  if last != "=" { 0 } else if second == "=" { 2 } else { 1 }
}

fn letters_only(alpha: String, text: String, len: Int) -> Bool / {abort.raise} =
  fold(range(0, len), true, |ok: Bool, i: Int|
    ok && string_contains(alpha, string_slice(text, i, i + 1)))

fn octet_at(data: Bytes, i: Int) -> Int / {abort.raise} = if i < bytes_len(data) { bytes_at(data, i) } else { 0 }

fn letter(alpha: String, n: Int) -> String / {abort.raise} = string_slice(alpha, n, n + 1)

// --- Tests ------------------------------------------------------------------

test "the RFC 4648 vectors encode and decode" {
  assert_eq(base64_encode(b""), "");
  assert_eq(base64_encode(b"f"), "Zg==");
  assert_eq(base64_encode(b"fo"), "Zm8=");
  assert_eq(base64_encode(b"foo"), "Zm9v");
  assert_eq(base64_encode(b"foob"), "Zm9vYg==");
  assert_eq(base64_encode(b"fooba"), "Zm9vYmE=");
  assert_eq(base64_encode(b"foobar"), "Zm9vYmFy");
  assert_eq(base64_decode(""), Some(b""));
  assert_eq(base64_decode("Zg=="), Some(b"f"));
  assert_eq(base64_decode("Zm8="), Some(b"fo"));
  assert_eq(base64_decode("Zm9v"), Some(b"foo"));
  assert_eq(base64_decode("Zm9vYg=="), Some(b"foob"));
  assert_eq(base64_decode("Zm9vYmE="), Some(b"fooba"));
  assert_eq(base64_decode("Zm9vYmFy"), Some(b"foobar"))
}

test "the URL-safe form has no padding and its own two letters" {
  assert_eq(base64url_encode(b"\xff\xff\xfe"), "___-");
  assert_eq(base64url_decode("___-"), Some(b"\xff\xff\xfe"));
  assert_eq(base64url_encode(b"foob"), "Zm9vYg");
  assert_eq(base64url_decode("Zm9vYg"), Some(b"foob"));
  assert_eq(base64url_encode(b"f"), "Zg");
  assert_eq(base64url_decode("Zg"), Some(b"f"))
}

test "a decoder refuses what is not the canonical form" {
  // A wrong length, padding in the middle, a letter outside the alphabet, and a final letter whose
  // low bits are not the zero bits the bytes it would name do not use.
  assert_eq(base64_decode("Zg"), None);
  assert_eq(base64_decode("Zg="), None);
  assert_eq(base64_decode("Z==="), None);
  assert_eq(base64_decode("Zm9vYg"), None);
  assert_eq(base64_decode("Zm9!"), None);
  assert_eq(base64_decode("Zm9="), None);
  // The URL-safe alphabet has neither `+`, `/` nor `=`.
  assert_eq(base64url_decode("+/+/"), None);
  assert_eq(base64url_decode("Zg=="), None)
}
