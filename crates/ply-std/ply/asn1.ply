//! ASN.1 in its distinguished encoding (DER): builders that write it, a cursor that reads it, and
//! a tree for a document whose shape is not known.
//!
//! DER is the one encoding of each value, which is what lets a signature be checked over bytes: a
//! certificate, a key and a signature are DER. Every rule that makes it the one is enforced here,
//! on both sides. A builder computes its own length and writes the shortest form of everything, so
//! what it answers is canonical by construction: `sequence([int(2), oid(o), set_of(names)])`. A
//! reader refuses, saying why and at which byte, a length or a tag number not in its shortest
//! form, an indefinite length, a `BOOLEAN` that is not `00` or `FF`, an `INTEGER` with an octet its
//! sign makes redundant, a `BIT STRING` whose unused bits are set, an identifier arc with a leading
//! `80`, a `SET OF` out of order, a character outside its string type's set, a time not written
//! `YYMMDDHHMMSSZ` or `YYYYMMDDHHMMSS[.f]Z` or naming no real date, a string or a time in
//! constructed form, a default written out, and anything after the value. Every length is checked
//! against what remains before it is walked and nesting is bounded by the depth a reader is given.
//!
//! BER, the looser encoding DER is a subset of, is refused, and some files called DER are BER: a
//! PKCS #7 or PKCS #12 bundle from an older tool uses indefinite lengths.
//!
//! A time is an instant, `std.date`'s `OffsetDateTime`. DER writes one as UTC reads it and no
//! other way, so a reader answers it at UTC and a builder writes the instant it is given,
//! whatever offset that is held at. A `UTCTime`'s two-digit year is one of 1950 to 2049.
//!
//! The cursor is a `Reader`, a window onto the bytes. A read takes the element at its front and
//! answers its value with the reader after it, so a parser threads one through a `SEQUENCE`'s
//! fields; `read_sequence` answers a reader over the content, and `within` runs a parser on one and
//! refuses what it left unread. `read_explicit` and `read_implicit` read a field a schema tags,
//! `read_optional` and `read_default` one that may be absent. A read raises `asn1.refused`;
//! `decode_with` answers it as an `Err`.
//!
//! `Value` is a whole document: `decode` and `encode` are each other's inverse, a refusal on
//! either side an `Err`, and `read` and `write` raise it. The tree names the universal types this
//! module checks; any other element is a `Primitive` or a `Constructed` under its tag. A `SET` is
//! held to `SET OF`'s order, the order of its members' encodings; one whose schema orders it by tag
//! is read with `read_constructed`.

import std.bigint
import std.bigint (BigInt)
import std.bytes (is_digit, u16_be, u32_be, u64_be)
import std.date
import std.date (DateTime, OffsetDateTime)
import std.laws (round_trip)
import std.list
import std.gen
import std.oid
import std.oid (Oid)
import std.result
import std.string
import std.timestamp

// --- Tags -----------------------------------------------------------------------

/// The four namespaces a tag's number is in.
pub type Class =
  /// The types ASN.1 itself defines: `INTEGER` is universal 2.
  | Universal
  /// Numbers one application's schemas share.
  | Application
  /// Numbers that mean what the enclosing type says, as `[0]` does.
  | Context
  /// Numbers one organisation keeps.
  | Private

/// What an element says its type is: a class, and a number in it.
pub type Tag = new { class: Class, number: Int }

/// The tag of a type ASN.1 defines.
pub fn universal(number: Int) -> Tag = { class: Universal, number: number }

/// An application tag, `[APPLICATION n]`.
pub fn application(number: Int) -> Tag = { class: Application, number: number }

/// A context-specific tag, `[n]`.
pub fn context(number: Int) -> Tag = { class: Context, number: number }

/// A private tag, `[PRIVATE n]`.
pub fn private(number: Int) -> Tag = { class: Private, number: number }

fn class_of(bits: Int) -> Class =
  if bits == 0 { Universal }
  else if bits == 1 { Application }
  else if bits == 2 { Context }
  else { Private }

fn class_bits(class: Class) -> Int =
  match class { Universal -> 0, Application -> 0x40, Context -> 0x80, Private -> 0xC0 }

// --- Values ---------------------------------------------------------------------

/// The string types whose characters this module checks.
pub type StringKind =
  /// Any text, in UTF-8.
  | Utf8String
  /// Digits and the space.
  | NumericString
  /// Letters, digits, the space and `'()+,-./:=?`.
  | PrintableString
  /// ASCII, control characters included.
  | Ia5String
  /// ASCII from the space to `~`.
  | VisibleString
  /// Any text, four octets a character.
  | UniversalString
  /// Text of the Basic Multilingual Plane, two octets a character.
  | BmpString

/// A `BIT STRING`: the bits of `bytes`, most significant first, less the last `unused` of them.
/// `unused` is 0 to 7, zero where there are no octets, and the bits it leaves out are zero.
pub type Bits = new { unused: Int, bytes: Bytes }

/// A document, or one element of it.
pub type Value =
  | Boolean(Bool)
  /// An `INTEGER`, as its content: the number's two's complement, most significant octet first, in
  /// the fewest octets. `int_of_integer` and `big_int_of_integer` read the number.
  | Integer(Bytes)
  /// An `ENUMERATED`, as an `Integer` holds its number.
  | Enumerated(Bytes)
  | BitString(Bits)
  | OctetString(Bytes)
  | Null
  | ObjectId(Oid)
  /// A string of one of the checked types.
  | Text(StringKind, String)
  /// A `UTCTime`: an instant of the years 1950 to 2049, to the second, at UTC.
  | UtcTime(OffsetDateTime)
  /// A `GeneralizedTime`: an instant of the years 0 to 9999, to the nanosecond, at UTC.
  | GeneralizedTime(OffsetDateTime)
  | Sequence(List<Value>)
  /// A `SET OF`: its members in the order of their encodings.
  | Set(List<Value>)
  /// A constructed element of any other tag, as an explicitly tagged field is: what it holds.
  | Constructed(Tag, List<Value>)
  /// A primitive element of any other tag, as an implicitly tagged field is: its content.
  | Primitive(Tag, Bytes)

// --- Refusals -------------------------------------------------------------------

/// Why a reader refused bytes, or a writer a value.
pub type Why =
  /// The input ends before the element does.
  | Truncated
  /// Bytes follow the last element.
  | Trailing
  /// Nested past the depth the reader was given.
  | TooDeep
  /// A length of the indefinite form, which only BER has.
  | IndefiniteLength
  /// A length not written in the fewest octets.
  | LongLength
  /// A tag number not written in the fewest octets.
  | LongTag
  /// A length, a tag number, an arc, a fraction of a second or an `INTEGER` past what its answer
  /// holds.
  | TooWide
  /// An element tagged universal 0, which ends an indefinite length and is no element of DER.
  | EndOfContents
  /// An element of another tag than the one asked for, which this carries.
  | WrongTag(Tag)
  /// A constructed element where its type is primitive, as a string in pieces is, or the reverse.
  | WrongForm
  /// A `BOOLEAN` that is not the one octet `00` or `FF`.
  | BadBoolean
  /// An `INTEGER` of no octets.
  | EmptyInteger
  /// An `INTEGER` whose first octet only repeats the sign of its second.
  | LongInteger
  /// A negative `INTEGER` where a magnitude was asked for.
  | Negative
  /// A `BIT STRING` with no count of unused bits, a count past 7 or past its octets, or an unused
  /// bit set.
  | BadBits
  /// A list of named bits that ends in a zero bit.
  | TrailingZeroBits
  /// A `NULL` with content.
  | BadNull
  /// An identifier of no octets, one that ends inside an arc, or arcs no identifier has.
  | BadOid
  /// An identifier arc with a leading `80`.
  | LongArc
  /// A string holding what its type does not: the kind, and for a reader the offset of the octet.
  | BadText(StringKind)
  /// A time not in the one form DER writes it or naming no real date or time of day, an instant
  /// its type has no place for, or in a tree one that is not at UTC.
  | BadTime
  /// A `GeneralizedTime` where X.509 writes a `UTCTime`: a year from 1950 to 2049.
  | TimeChoice
  /// A `SET OF` whose members are not in the order of their encodings.
  | Unsorted
  /// A field written out with the value its schema says an absent one has.
  | DefaultEncoded
  /// A tag with a negative number or universal 0, or in a tree one the tree reads as another
  /// value.
  | BadTag

/// A reader's refusal, and the offset in the input of what it refused.
pub type Refusal = new { at: Int, why: Why }

/// What this module raises where it refuses.
pub effect asn1 {
  /// The bytes are not the DER asked for.
  raise refused(e: Refusal)
  /// The value has no DER encoding.
  raise unwritable(why: Why)
}

fn refuse<a>(at: Int, why: Why) -> a / {asn1.refused} = asn1.refused({ at: at, why: why })

// --- Integers -------------------------------------------------------------------

/// The content of the `INTEGER` `n`: its two's complement in the fewest octets.
pub fn integer_of_int(n: Int) -> Bytes / {abort.raise} = minimal(u64_be(n))

/// The `Int` an `INTEGER`'s content names; `None` for one past 64 bits, and for no octets.
pub fn int_of_integer(content: Bytes) -> Option<Int> =
  if content.len() == 0 || content.len() > 8 { None } else {
    Some(
      range(0, content.len()).fold(
        if content.at(0) >= 0x80 { 0 - 1 } else { 0 },
        |n: Int, i: Int| n << 8 | content.at(i),
      ),
    )
  }

/// The content of the `INTEGER` `n`, whatever its size.
pub fn integer_of_big_int(n: BigInt) -> Bytes / {abort.raise} =
  if bigint::is_negative(n) {
    signed(bigint::to_bytes(bigint::sub(bigint::neg(n), bigint::one()))).xor_byte(0xFF)
  } else { signed(bigint::to_bytes(n)) }

/// The number an `INTEGER`'s content names; zero for no octets.
pub fn big_int_of_integer(content: Bytes) -> BigInt / {abort.raise} =
  if content.len() > 0 && content.at(0) >= 0x80 {
    bigint::sub(bigint::neg(bigint::of_bytes(content.xor_byte(0xFF))), bigint::one())
  } else { bigint::of_bytes(content) }

/// Whether the octet at `i` only repeats the sign of the one after it.
fn redundant(content: Bytes, i: Int) -> Bool / {abort.raise} =
  i + 1 < content.len()
    && ((content.at(i) == 0 && content.at(i + 1) < 0x80)
    || (content.at(i) == 0xFF && content.at(i + 1) >= 0x80))

/// The two's complement `content` in the fewest octets; no octets are zero.
fn minimal(content: Bytes) -> Bytes / {abort.raise} =
  if content.len() == 0 { b"\x00" } else { content.slice(lead(content, 0), content.len()) }

fn lead(content: Bytes, i: Int) -> Int / {abort.raise} =
  if i >= content.len() - 1 { i } else if redundant(content, i) { lead(content, i + 1) } else { i }

/// A magnitude with a zero octet before it where its own first would read as a sign, or where it
/// has none.
fn signed(magnitude: Bytes) -> Bytes =
  if magnitude.len() == 0 || magnitude.at(0) >= 0x80 { b"\x00".concat(magnitude) }
  else { magnitude }

// --- Bits and times -------------------------------------------------------------

/// Whether `b` is a bit string DER writes: what `Bits` says of its fields holds.
pub fn bits_valid(b: Bits) -> Bool / {abort.raise} =
  b.unused >= 0 && b.unused <= 7 && (b.unused == 0 || b.bytes.len() > 0)
    && (b.unused == 0 || b.bytes.at(b.bytes.len() - 1) & (1 << b.unused) - 1 == 0)

/// Bit `i` of the string, counting the first octet's most significant bit as 0; `false` past its
/// end.
pub fn bit_at(b: Bits, i: Int) -> Bool / {abort.raise} =
  i >= 0 && i < 8 * b.bytes.len() - b.unused && b.bytes.at(i / 8) & 0x80 >> i % 8 != 0

/// What UTC's clock read at the instant `t`, which is what DER writes of it.
fn at_utc(t: OffsetDateTime) -> DateTime = date::local(date::in_utc(t))

/// The year UTC's clock read at `t`.
fn year_of(t: OffsetDateTime) -> Int = date::year(date::date_of(at_utc(t)))

/// The fraction of its second `t` falls at, in nanoseconds.
fn nanosecond_of(t: OffsetDateTime) -> Int = date::nanosecond(date::time_of(at_utc(t)))

/// The text of the `UTCTime` of the instant `t`, `YYMMDDHHMMSSZ` as UTC reads it; `None` where it
/// has none: a year outside 1950 to 2049, or a fraction of a second.
pub fn utc_time_text(t: OffsetDateTime) -> Option<String> =
  if year_of(t) >= 1950 && year_of(t) <= 2049 && nanosecond_of(t) == 0 {
    Some(two(year_of(t) % 100) ++ clock_text(at_utc(t)) ++ "Z")
  } else { None }

/// The text of the `GeneralizedTime` of the instant `t`, `YYYYMMDDHHMMSSZ` as UTC reads it, with
/// the fraction of its second before the `Z` where it has one.
pub fn generalized_time_text(t: OffsetDateTime) -> String =
  year_of(t).to_string().pad_left(4, "0") ++ clock_text(at_utc(t))
    ++ (if nanosecond_of(t) == 0 { "" } else { "." ++ significant(nanosecond_of(t), 9) })
    ++ "Z"

fn two(n: Int) -> String = n.to_string().pad_left(2, "0")

fn clock_text(at: DateTime) -> String = {
  let day = date::parts(date::date_of(at));
  let time = date::time_of(at);
  two(day.month) ++ two(day.day) ++ two(date::hour(time)) ++ two(date::minute(time))
    ++ two(date::second(time))
}

/// `n` in `digits` digits, less its trailing zeros.
fn significant(n: Int, digits: Int) -> String =
  if digits > 1 && n % 10 == 0 { significant(n / 10, digits - 1) }
  else { n.to_string().pad_left(digits, "0") }

// --- Writing --------------------------------------------------------------------

/// A length in the fewest octets: itself below 128, and above that its octets after their count.
fn length_octets(n: Int) -> Bytes / {abort.raise} =
  if n < 0x80 { byte_of_int(n) } else {
    let octets = u64_be(n).strip_leading_zeros();
    byte_of_int(0x80 | octets.len()).concat(octets)
  }

/// `n` in base 128, most significant first, the high bit set on every octet but the last.
fn septets(n: Int) -> Bytes = septets_before(n / 128, byte_of_int(n & 0x7F))

fn septets_before(n: Int, low: Bytes) -> Bytes =
  if n <= 0 { low } else { septets_before(n / 128, byte_of_int(n & 0x7F | 0x80).concat(low)) }

fn identifier(tag: Tag, constructed: Bool) -> Bytes / {asn1.unwritable, abort.raise} = {
  let lead = class_bits(tag.class) | (if constructed { 0x20 } else { 0 });
  if tag.number < 0 || (tag.class == Universal && tag.number == 0) { asn1.unwritable(BadTag) }
  else if tag.number < 31 { byte_of_int(lead | tag.number) }
  else { byte_of_int(lead | 0x1F).concat(septets(tag.number)) }
}

/// An element whose identifier is the one octet `lead`.
fn element(lead: Int, content: Bytes) -> Bytes / {abort.raise} =
  Bytes::concat_all([byte_of_int(lead), length_octets(content.len()), content])

/// A `BOOLEAN`.
pub fn boolean(b: Bool) -> Bytes / {abort.raise} = element(0x01, if b { b"\xff" } else { b"\x00" })

/// The `INTEGER` whose two's complement `content` is, most significant octet first, written in
/// the fewest octets whatever `content` pads it with; no octets are zero.
pub fn integer(content: Bytes) -> Bytes / {abort.raise} = element(0x02, minimal(content))

/// The `INTEGER` `n`.
pub fn int(n: Int) -> Bytes / {abort.raise} = element(0x02, integer_of_int(n))

/// The `INTEGER` `n`, whatever its size.
pub fn big_int(n: BigInt) -> Bytes / {abort.raise} = element(0x02, integer_of_big_int(n))

/// The `INTEGER` whose magnitude `magnitude` is, most significant octet first: never negative,
/// whatever its first bit is. The form a modulus or a signature's half is held in.
pub fn unsigned(magnitude: Bytes) -> Bytes / {abort.raise} =
  element(0x02, signed(magnitude.strip_leading_zeros()))

/// The `ENUMERATED` `n`.
pub fn enumerated(n: Int) -> Bytes / {abort.raise} = element(0x0A, integer_of_int(n))

/// A `BIT STRING`. Raises `BadBits` unless `bits_valid`.
pub fn bit_string(b: Bits) -> Bytes / {asn1.unwritable, abort.raise} =
  if bits_valid(b) { element(0x03, byte_of_int(b.unused).concat(b.bytes)) }
  else { asn1.unwritable(BadBits) }

/// The `BIT STRING` of a list of named bits, as a key's usages are: the bits at the positions in
/// `set` are one, and the string ends at the last of them. A negative position names no bit.
pub fn named_bits(set: List<Int>) -> Bytes / {abort.raise} = {
  let top = set.fold(0 - 1, |highest: Int, position: Int| max(highest, position));
  let octets = range(0, (top + 8) / 8).map(|i: Int|
    byte_of_int(
      set.fold(0, |octet: Int, position: Int|
        if position >= 0 && position / 8 == i { octet | 0x80 >> position % 8 } else { octet }),
    ));
  element(
    0x03,
    byte_of_int(if top < 0 { 0 } else { 7 - top % 8 }).concat(Bytes::concat_all(octets)),
  )
}

/// An `OCTET STRING`.
pub fn octet_string(octets: Bytes) -> Bytes / {abort.raise} = element(0x04, octets)

/// A `NULL`.
pub fn null() -> Bytes = b"\x05\x00"

/// An `OBJECT IDENTIFIER`. Raises `BadOid` for arcs no identifier has.
pub fn oid(o: Oid) -> Bytes / {asn1.unwritable, abort.raise} =
  match oid::arcs(o) {
    [first, second, ..rest] if oid::is_valid(o) ->
      element(0x06, Bytes::concat_all([first * 40 + second].concat(rest).map(septets))),
    _ -> asn1.unwritable(BadOid),
  }

/// A string of the type `kind`. Raises `BadText` for a character the type does not hold.
pub fn string(kind: StringKind, text: String) -> Bytes / {asn1.unwritable, abort.raise} =
  element(string_number(kind), match kind {
    Utf8String -> Bytes::of_string(text),
    UniversalString -> Bytes::concat_all(text.chars().map(|c: Char| u32_be(Int::of_char(c)))),
    BmpString ->
      Bytes::concat_all(
        text.chars().map(|c: Char|
          if Int::of_char(c) > 0xFFFF { asn1.unwritable(BadText(kind)) }
          else { u16_be(Int::of_char(c)) }),
      ),
    _ -> match stray(kind, Bytes::of_string(text)) {
      None -> Bytes::of_string(text),
      Some(_) -> asn1.unwritable(BadText(kind)),
    },
  })

/// A `UTCTime` of the instant `t`, whatever offset it is held at. Raises `BadTime` where
/// `utc_time_text` answers `None`.
pub fn utc_time(t: OffsetDateTime) -> Bytes / {asn1.unwritable, abort.raise} =
  match utc_time_text(t) {
    Some(text) -> element(0x17, Bytes::of_string(text)),
    None -> asn1.unwritable(BadTime),
  }

/// A `GeneralizedTime` of the instant `t`, whatever offset it is held at.
pub fn generalized_time(t: OffsetDateTime) -> Bytes / {abort.raise} =
  element(0x18, Bytes::of_string(generalized_time_text(t)))

/// The `Time` of an X.509 certificate, of the instant `t`: a `UTCTime` where UTC reads it in the
/// years 1950 to 2049 and a `GeneralizedTime` in any other, as RFC 5280 has it. Raises `BadTime`
/// for a fraction of a second, which it has no place for.
pub fn time(t: OffsetDateTime) -> Bytes / {asn1.unwritable, abort.raise} =
  if nanosecond_of(t) != 0 { asn1.unwritable(BadTime) }
  else if year_of(t) >= 1950 && year_of(t) <= 2049 { utc_time(t) }
  else { generalized_time(t) }

/// A `SEQUENCE` of the encoded elements `parts`, in order.
pub fn sequence(parts: List<Bytes>) -> Bytes / {abort.raise} =
  element(0x30, Bytes::concat_all(parts))

/// A `SET OF` the encoded elements `parts`, which it puts in the order of their encodings.
pub fn set_of(parts: List<Bytes>) -> Bytes / {abort.raise} =
  element(0x31, Bytes::concat_all(parts.sort()))

/// A primitive element of any tag: `content` as it is. Raises `BadTag` for a negative number and
/// for universal 0.
pub fn primitive(tag: Tag, content: Bytes) -> Bytes / {asn1.unwritable, abort.raise} =
  Bytes::concat_all([identifier(tag, false), length_octets(content.len()), content])

/// A constructed element of any tag holding the encoded elements `parts`, in order. Raises
/// `BadTag` as `primitive` does.
pub fn constructed(tag: Tag, parts: List<Bytes>) -> Bytes / {asn1.unwritable, abort.raise} = {
  let content = Bytes::concat_all(parts);
  Bytes::concat_all([identifier(tag, true), length_octets(content.len()), content])
}

/// The encoded element `inner` tagged explicitly, `[n] EXPLICIT`: wrapped whole in an element of
/// `tag`.
pub fn explicit(tag: Tag, inner: Bytes) -> Bytes / {asn1.unwritable, abort.raise} =
  constructed(tag, [inner])

/// The encoded element `inner` tagged implicitly, `[n] IMPLICIT`: `tag` in place of its own.
/// Raises `Truncated` for bytes that hold no tag to replace.
pub fn implicit(tag: Tag, inner: Bytes) -> Bytes / {asn1.unwritable, abort.raise} =
  if inner.len() == 0 { asn1.unwritable(Truncated) } else {
    let first = inner.at(0);
    let after = if first & 0x1F != 0x1F { Some(1) } else {
      match inner.position(1, |octet: Int| octet < 0x80) {
        Some(last) -> Some(last + 1),
        None -> None,
      }
    };
    match after {
      Some(n) -> identifier(tag, first & 0x20 != 0).concat(inner.slice(n, inner.len())),
      None -> asn1.unwritable(Truncated),
    }
  }

// --- Reading: one element's header ----------------------------------------------

/// One element's header: its tag, its form, and where its content lies in the input.
type Head = { tag: Tag, constructed: Bool, from: Int, to: Int }

/// A base-128 number where a tag or an arc holds one: its value and where it ends, or that the
/// input ended inside it, that it has a leading `80`, or that it is past 63 bits.
type Septets = | Number(Int, Int) | Cut | Padded | Wide

fn septets_at(data: Bytes, at: Int, end: Int) -> Septets / {abort.raise} =
  if at >= end { Cut }
  else if data.at(at) == 0x80 { Padded }
  else { septets_from(data, at, end, 0, 9) }

fn septets_from(data: Bytes, at: Int, end: Int, value: Int, left: Int) -> Septets / {abort.raise} =
  if at >= end { Cut }
  else if left <= 0 { Wide } else {
    let octet = data.at(at);
    let more = value << 7 | octet & 0x7F;
    if octet < 0x80 { Number(more, at + 1) }
    else { septets_from(data, at + 1, end, more, left - 1) }
  }

/// The header of the element at `at`, whose content must lie before `end`.
fn head(data: Bytes, at: Int, end: Int) -> Head / {asn1.refused, abort.raise} =
  if at >= end { refuse(at, Truncated) } else {
    let first = data.at(at);
    let id = if first & 0x1F != 0x1F { { number: first & 0x1F, next: at + 1 } } else {
      match septets_at(data, at + 1, end) {
        Number(number, next) -> if number < 31 { refuse(at, LongTag) }
        else { { number: number, next: next } },
        Cut -> refuse(end, Truncated),
        Padded -> refuse(at, LongTag),
        Wide -> refuse(at, TooWide),
      }
    };
    if first < 0x40 && id.number == 0 { refuse(at, EndOfContents) } else {
      let span = length_at(data, id.next, end);
      if span.length > end - span.from { refuse(span.from, Truncated) } else {
        {
          tag: { class: class_of(first >> 6), number: id.number },
          constructed: first & 0x20 != 0,
          from: span.from,
          to: span.from + span.length,
        }
      }
    }
  }

/// The length at `at`, and where the content it measures starts.
fn length_at(
  data: Bytes,
  at: Int,
  end: Int,
) -> { length: Int, from: Int } / {asn1.refused, abort.raise} =
  if at >= end { refuse(at, Truncated) } else {
    let first = data.at(at);
    let octets = first & 0x7F;
    if first < 0x80 { { length: first, from: at + 1 } }
    else if octets == 0 { refuse(at, IndefiniteLength) }
    else if octets > end - at - 1 { refuse(end, Truncated) }
    else if data.at(at + 1) == 0 { refuse(at, LongLength) }
    else if octets > 8 || (octets == 8 && data.at(at + 1) >= 0x80) { refuse(at, TooWide) } else {
      let length = range(at + 1, at + 1 + octets).fold(0, |n: Int, i: Int| n << 8 | data.at(i));
      if length < 0x80 { refuse(at, LongLength) } else { { length: length, from: at + 1 + octets } }
    }
  }

// --- Reading: what each type's content must be ----------------------------------

fn boolean_of(content: Bytes, at: Int) -> Bool / {asn1.refused} =
  if content == b"\x00" { false }
  else if content == b"\xff" { true }
  else { refuse(at, BadBoolean) }

fn integer_of(content: Bytes, at: Int) -> Bytes / {asn1.refused, abort.raise} =
  if content.len() == 0 { refuse(at, EmptyInteger) }
  else if redundant(content, 0) { refuse(at, LongInteger) }
  else { content }

fn int_of(content: Bytes, at: Int) -> Int / {asn1.refused, abort.raise} =
  match int_of_integer(integer_of(content, at)) { Some(n) -> n, None -> refuse(at, TooWide) }

fn unsigned_of(content: Bytes, at: Int) -> Bytes / {asn1.refused, abort.raise} = {
  let number = integer_of(content, at);
  if number.at(0) >= 0x80 { refuse(at, Negative) }
  else if number.len() > 1 && number.at(0) == 0 { number.slice(1, number.len()) }
  else { number }
}

fn bits_of(content: Bytes, at: Int) -> Bits / {asn1.refused, abort.raise} =
  if content.len() == 0 { refuse(at, BadBits) } else {
    let bits: Bits = { unused: content.at(0), bytes: content.slice(1, content.len()) };
    if bits_valid(bits) { bits } else { refuse(at, BadBits) }
  }

fn named_bits_of(content: Bytes, at: Int) -> Bits / {asn1.refused, abort.raise} = {
  let bits = bits_of(content, at);
  let octets = bits.bytes.len();
  if octets > 0 && bits.bytes.at(octets - 1) >> bits.unused & 1 == 0 {
    refuse(at, TrailingZeroBits)
  } else { bits }
}

fn null_of(content: Bytes, at: Int) -> Unit / {asn1.refused} =
  if content.len() == 0 { () } else { refuse(at, BadNull) }

fn oid_of(content: Bytes, at: Int) -> Oid / {asn1.refused, abort.raise} =
  match arcs_of(content, 0, at, [], content.len()) {
    [] -> refuse(at, BadOid),
    [first, ..rest] ->
      oid::Oid(
        List::concat(
          if first < 40 { [0, first] }
          else if first < 80 { [1, first - 40] }
          else { [2, first - 80] },
          rest,
        ),
      ),
  }

/// The numbers an identifier's content holds, the first of them its first two arcs. An arc is an
/// octet at least, so `left`, the content's length, outlasts them.
fn arcs_of(
  content: Bytes,
  i: Int,
  at: Int,
  acc: List<Int>,
  left: Int,
) -> List<Int> / {asn1.refused, abort.raise} =
  if i >= content.len() || left <= 0 { acc } else {
    match septets_at(content, i, content.len()) {
      Number(arc, next) -> arcs_of(content, next, at, acc.push(arc), left - 1),
      Cut -> refuse(at + i, BadOid),
      Padded -> refuse(at + i, LongArc),
      Wide -> refuse(at + i, TooWide),
    }
  }

fn string_number(kind: StringKind) -> Int =
  match kind {
    Utf8String -> 12,
    NumericString -> 18,
    PrintableString -> 19,
    Ia5String -> 22,
    VisibleString -> 26,
    UniversalString -> 28,
    BmpString -> 30,
  }

fn string_kind(number: Int) -> Option<StringKind> =
  match number {
    12 -> Some(Utf8String),
    18 -> Some(NumericString),
    19 -> Some(PrintableString),
    22 -> Some(Ia5String),
    26 -> Some(VisibleString),
    28 -> Some(UniversalString),
    30 -> Some(BmpString),
    _ -> None,
  }

/// Where the first octet is that a string of an ASCII kind does not hold.
fn stray(kind: StringKind, content: Bytes) -> Option<Int> =
  content.position(0, |b: Int|
    !(match kind {
      NumericString -> is_digit(b) || b == 0x20,
      PrintableString ->
        is_digit(b) || (b >= 0x41 && b <= 0x5A) || (b >= 0x61 && b <= 0x7A)
          || b" '()+,-./:=?".index_of_byte(b) != None,
      VisibleString -> b >= 0x20 && b <= 0x7E,
      _ -> b < 0x80,
    }))

fn text_of(kind: StringKind, content: Bytes, at: Int) -> String / {asn1.refused, abort.raise} =
  match kind {
    Utf8String -> if content.is_utf8() { String::of_bytes(content) }
    else { refuse(at, BadText(kind)) },
    UniversalString -> wide_text(kind, content, at, 4),
    BmpString -> wide_text(kind, content, at, 2),
    _ -> match stray(kind, content) {
      None -> String::of_bytes(content),
      Some(i) -> refuse(at + i, BadText(kind)),
    },
  }

/// Text of `width` octets a character, most significant first.
fn wide_text(
  kind: StringKind,
  content: Bytes,
  at: Int,
  width: Int,
) -> String / {asn1.refused, abort.raise} =
  if content.len() % width != 0 { refuse(at, BadText(kind)) } else {
    String::of_chars(
      range(0, content.len() / width).map(|i: Int|
        match Char::of_int(
            range(i * width, i * width + width).fold(0, |point: Int, j: Int|
              point << 8 | content.at(j)),
          ) {
          Some(c) -> c,
          None -> refuse(at + i * width, BadText(kind)),
        }),
    )
  }

/// The `n` decimal digits at `from`, which `content` reaches, as their number; `None` for
/// anything else there.
fn digits_at(content: Bytes, from: Int, n: Int) -> Option<Int> / {abort.raise} =
  range(from, from + n).fold(Some(0), |so_far: Option<Int>, i: Int|
    match so_far {
      Some(v) if is_digit(content.at(i)) -> Some(v * 10 + content.at(i) - 48),
      _ -> None,
    })

/// The instant UTC reads as `year` and the five two-digit fields at `from`, where they are a
/// real date and time of day. No second is a leap second.
fn moment(
  year: Int,
  content: Bytes,
  from: Int,
  nanosecond: Int,
) -> Option<OffsetDateTime> / {abort.raise} =
  match range(0, 5).map(|i: Int| digits_at(content, from + 2 * i, 2)) {
    [Some(month), Some(day), Some(hour), Some(minute), Some(second)] -> match ((
        date::of(year, month, day),
        date::time(hour, minute, second, nanosecond),
      )) {
      (Some(on), Some(clock)) -> Some(date::utc(date::at(on, clock))),
      _ -> None,
    },
    _ -> None,
  }

/// A two-digit year is in 1950 to 2049, as RFC 5280 reads one.
fn utc_time_of(content: Bytes, at: Int) -> OffsetDateTime / {asn1.refused, abort.raise} = {
  let read = if content.len() != 13 || content.at(12) != 0x5A { None } else {
    match digits_at(content, 0, 2) {
      Some(year) -> moment(if year >= 50 { 1900 + year } else { 2000 + year }, content, 2, 0),
      None -> None,
    }
  };
  match read { Some(t) -> t, None -> refuse(at, BadTime) }
}

fn generalized_time_of(content: Bytes, at: Int) -> OffsetDateTime / {asn1.refused, abort.raise} = {
  let z = content.len() - 1;
  if z < 14 || content.at(z) != 0x5A { refuse(at, BadTime) } else {
    let nanosecond = if z == 14 { 0 } else { fraction_of(content, at, z) };
    let read = match digits_at(content, 0, 4) {
      Some(year) -> moment(year, content, 4, nanosecond),
      None -> None,
    };
    match read { Some(t) -> t, None -> refuse(at, BadTime) }
  }
}

/// The nanoseconds a fraction between the seconds and the `Z` at `z` names: a `.`, then digits
/// that do not end in a zero, of which an instant holds nine.
fn fraction_of(content: Bytes, at: Int, z: Int) -> Int / {asn1.refused, abort.raise} =
  if content.at(14) != 0x2E || z < 16 || content.skip(15, b"0123456789") < z
      || content.at(z - 1) == 0x30 { refuse(at, BadTime) }
  else if z > 24 { refuse(at, TooWide) } else {
    range(15, 24).fold(0, |n: Int, i: Int| n * 10 + (if i < z { content.at(i) - 48 } else { 0 }))
  }

// --- Reading: the cursor --------------------------------------------------------

/// A window onto DER: the elements from `at` up to `end` in `data`, and how many more levels a
/// read may enter. `implicit` is the tag the next typed read takes in place of its type's own.
pub type Reader = new { data: Bytes, at: Int, end: Int, room: Int, implicit: Option<Tag> }

/// What a read answers: a value, and the reader past what it took.
pub type Read<a> = { value: a, rest: Reader }

/// A reader over all of `data` that enters at most `depth` nested elements.
pub fn reader(data: Bytes, depth: Int) -> Reader =
  { data: data, at: 0, end: data.len(), room: depth, implicit: None }

/// Whether nothing is left to read.
pub fn is_empty(r: Reader) -> Bool = r.at >= r.end

/// Refuses, as `Trailing`, a reader with anything left to read.
pub fn finish(r: Reader) -> Unit / {asn1.refused} =
  if is_empty(r) { () } else { refuse(r.at, Trailing) }

/// The tag of the next element, or `None` where nothing is left.
pub fn peek(r: Reader) -> Option<Tag> / {asn1.refused, abort.raise} =
  if is_empty(r) { None } else { Some(head(r.data, r.at, r.end).tag) }

fn after(r: Reader, h: Head) -> Reader = { ..r, at: h.to, implicit: None }

/// The next element's header, which must have `tag` and the form asked for.
fn expect(r: Reader, tag: Tag, constructed: Bool) -> Head / {asn1.refused, abort.raise} = {
  let h = head(r.data, r.at, r.end);
  if h.tag != tag { refuse(r.at, WrongTag(h.tag)) }
  else if h.constructed != constructed { refuse(r.at, WrongForm) }
  else { h }
}

/// The next element's header for a read of the universal type `number`, or under the tag a
/// `read_implicit` around the read gave it.
fn typed(r: Reader, number: Int, constructed: Bool) -> Head / {asn1.refused, abort.raise} =
  expect(r, match r.implicit { Some(tag) -> tag, None -> universal(number) }, constructed)

/// A primitive element of the universal type `number`, its content read by `of`.
fn leaf<a>(
  r: Reader,
  number: Int,
  of: (Bytes, Int) -> a / {asn1.refused, abort.raise},
) -> Read<a> / {asn1.refused, abort.raise} = {
  let h = typed(r, number, false);
  { value: of(r.data.slice(h.from, h.to), h.from), rest: after(r, h) }
}

/// A `BOOLEAN`.
pub fn read_boolean(r: Reader) -> Read<Bool> / {asn1.refused, abort.raise} = leaf(r, 1, boolean_of)

/// An `INTEGER`, as its content: the number's two's complement in the fewest octets.
pub fn read_integer(r: Reader) -> Read<Bytes> / {asn1.refused, abort.raise} = leaf(r, 2, integer_of)

/// An `INTEGER` an `Int` holds; `TooWide` for any other.
pub fn read_int(r: Reader) -> Read<Int> / {asn1.refused, abort.raise} = leaf(r, 2, int_of)

/// An `INTEGER` of any size.
pub fn read_big_int(r: Reader) -> Read<BigInt> / {asn1.refused, abort.raise} =
  leaf(r, 2, |content: Bytes, at: Int| big_int_of_integer(integer_of(content, at)))

/// An `INTEGER` that is not negative, as its magnitude: most significant octet first with no
/// leading zero octet, and one zero octet for zero. `Negative` for one below zero.
pub fn read_unsigned(r: Reader) -> Read<Bytes> / {asn1.refused, abort.raise} =
  leaf(r, 2, unsigned_of)

/// An `ENUMERATED` an `Int` holds.
pub fn read_enumerated(r: Reader) -> Read<Int> / {asn1.refused, abort.raise} = leaf(r, 10, int_of)

/// A `BIT STRING`.
pub fn read_bit_string(r: Reader) -> Read<Bits> / {asn1.refused, abort.raise} = leaf(r, 3, bits_of)

/// A `BIT STRING` that is a list of named bits, which DER ends at its last one bit:
/// `TrailingZeroBits` for one that ends in a zero.
pub fn read_named_bits(r: Reader) -> Read<Bits> / {asn1.refused, abort.raise} =
  leaf(r, 3, named_bits_of)

/// An `OCTET STRING`.
pub fn read_octet_string(r: Reader) -> Read<Bytes> / {asn1.refused, abort.raise} =
  leaf(r, 4, |content: Bytes, _: Int| content)

/// A `NULL`.
pub fn read_null(r: Reader) -> Read<Unit> / {asn1.refused, abort.raise} = leaf(r, 5, null_of)

/// An `OBJECT IDENTIFIER`.
pub fn read_oid(r: Reader) -> Read<Oid> / {asn1.refused, abort.raise} = leaf(r, 6, oid_of)

/// A string of the type `kind`.
pub fn read_string(r: Reader, kind: StringKind) -> Read<String> / {asn1.refused, abort.raise} =
  leaf(r, string_number(kind), |content: Bytes, at: Int| text_of(kind, content, at))

/// A `UTCTime`: the instant it names, at UTC, its two-digit year read in 1950 to 2049.
pub fn read_utc_time(r: Reader) -> Read<OffsetDateTime> / {asn1.refused, abort.raise} =
  leaf(r, 23, utc_time_of)

/// A `GeneralizedTime`: the instant it names, at UTC.
pub fn read_generalized_time(r: Reader) -> Read<OffsetDateTime> / {asn1.refused, abort.raise} =
  leaf(r, 24, generalized_time_of)

/// The `Time` of an X.509 certificate: a `UTCTime`, or for a year outside 1950 to 2049 a
/// `GeneralizedTime` without a fraction of a second. `TimeChoice` for a `GeneralizedTime` X.509
/// writes the other way.
pub fn read_time(r: Reader) -> Read<OffsetDateTime> / {asn1.refused, abort.raise} =
  if peek(r) != Some(universal(24)) { read_utc_time(r) } else {
    let read = read_generalized_time(r);
    if (year_of(read.value) >= 1950 && year_of(read.value) <= 2049)
        || nanosecond_of(read.value) != 0 { refuse(r.at, TimeChoice) }
    else { read }
  }

/// The content of a primitive element of `tag`, whatever it holds.
pub fn read_primitive(r: Reader, tag: Tag) -> Read<Bytes> / {asn1.refused, abort.raise} = {
  let h = expect(r, tag, false);
  { value: r.data.slice(h.from, h.to), rest: after(r, h) }
}

fn entered(r: Reader, h: Head) -> Read<Reader> / {asn1.refused} =
  if r.room <= 0 { refuse(r.at, TooDeep) } else {
    {
      value: { data: r.data, at: h.from, end: h.to, room: r.room - 1, implicit: None },
      rest: after(r, h),
    }
  }

/// A reader over what a constructed element of `tag` holds.
pub fn read_constructed(r: Reader, tag: Tag) -> Read<Reader> / {asn1.refused, abort.raise} =
  entered(r, expect(r, tag, true))

/// A reader over the fields of a `SEQUENCE`.
pub fn read_sequence(r: Reader) -> Read<Reader> / {asn1.refused, abort.raise} =
  entered(r, typed(r, 16, true))

/// `item` run on the reader `inner` answers, which it must leave empty: `Trailing` otherwise.
/// Answers what `item` read, and the reader after the element `inner` was read from.
pub fn within<a | e>(
  inner: Read<Reader>,
  item: (Reader) -> Read<a> / {asn1.refused, abort.raise | e},
) -> Read<a> / {asn1.refused, abort.raise | e} = {
  let read = item(inner.value);
  finish(read.rest);
  { value: read.value, rest: inner.rest }
}

/// A field tagged explicitly, `[n] EXPLICIT`: the one element inside a constructed element of
/// `tag`, read by `item`.
pub fn read_explicit<a | e>(
  r: Reader,
  tag: Tag,
  item: (Reader) -> Read<a> / {asn1.refused, abort.raise | e},
) -> Read<a> / {asn1.refused, abort.raise | e} = within(read_constructed(r, tag), item)

/// A field tagged implicitly, `[n] IMPLICIT`: `item` reads the next element taking `tag` for its
/// type's own. `item` is a read of one type of this module, or `read_sequence_of` or
/// `read_set_of`; a read that asks for a tag itself is not changed.
pub fn read_implicit<a | e>(
  r: Reader,
  tag: Tag,
  item: (Reader) -> Read<a> / {asn1.refused, abort.raise | e},
) -> Read<a> / {asn1.refused, abort.raise | e} = item({ ..r, implicit: Some(tag) })

/// A field that may be absent: `item`'s reading of the next element where its tag is `tag`, and
/// `None` with the reader as it was where it is not or nothing is left.
pub fn read_optional<a | e>(
  r: Reader,
  tag: Tag,
  item: (Reader) -> Read<a> / {asn1.refused, abort.raise | e},
) -> Read<Option<a>> / {asn1.refused, abort.raise | e} =
  if peek(r) != Some(tag) { { value: None, rest: r } } else {
    let read = item(r);
    { value: Some(read.value), rest: read.rest }
  }

/// A field with a default: `default` where it is absent, as `read_optional` finds it, and
/// `DefaultEncoded` where it is written out with that value, which DER leaves out.
pub fn read_default<a | e>(
  r: Reader,
  tag: Tag,
  default: a,
  item: (Reader) -> Read<a> / {asn1.refused, abort.raise | e},
) -> Read<a> / {asn1.refused, abort.raise | e}
  where derivable(eq, a)
= {
  let read = read_optional(r, tag, item);
  match read.value {
    None -> { value: default, rest: read.rest },
    Some(value) -> if value == default { refuse(r.at, DefaultEncoded) }
    else { { value: value, rest: read.rest } },
  }
}

/// The members of the constructed element `inner` is over, each one element read whole by `item`.
/// `sorted` holds them to the order of their encodings, `last` being the one before. An element
/// is two octets at least, so `left`, the octets there are, outlasts them.
fn members<a | e>(
  inner: Reader,
  item: (Reader) -> Read<a> / {asn1.refused, abort.raise | e},
  sorted: Bool,
  last: Bytes,
  acc: List<a>,
  left: Int,
) -> List<a> / {asn1.refused, abort.raise | e} =
  if is_empty(inner) || left <= 0 { acc } else {
    let h = head(inner.data, inner.at, inner.end);
    let whole = if sorted { inner.data.slice(inner.at, h.to) } else { b"" };
    if compare(last, whole) == Greater { refuse(inner.at, Unsorted) } else {
      let read = item({ ..inner, end: h.to });
      finish(read.rest);
      members({ ..inner, at: h.to }, item, sorted, whole, acc.push(read.value), left - 1)
    }
  }

/// A `SEQUENCE OF`: each member read by `item`, which reads one element.
pub fn read_sequence_of<a | e>(
  r: Reader,
  item: (Reader) -> Read<a> / {asn1.refused, abort.raise | e},
) -> Read<List<a>> / {asn1.refused, abort.raise | e} = {
  let inner = read_sequence(r);
  {
    value: members(inner.value, item, false, b"", [], inner.value.end - inner.value.at),
    rest: inner.rest,
  }
}

/// A `SET OF`: each member read by `item`, which reads one element. `Unsorted` unless the members
/// are in the order of their encodings.
pub fn read_set_of<a | e>(
  r: Reader,
  item: (Reader) -> Read<a> / {asn1.refused, abort.raise | e},
) -> Read<List<a>> / {asn1.refused, abort.raise | e} = {
  let inner = entered(r, typed(r, 17, true));
  {
    value: members(inner.value, item, true, b"", [], inner.value.end - inner.value.at),
    rest: inner.rest,
  }
}

/// The next element whole, header and all, as the bytes a signature is over are wanted.
pub fn read_raw(r: Reader) -> Read<Bytes> / {asn1.refused, abort.raise} = {
  let h = head(r.data, r.at, r.end);
  { value: r.data.slice(r.at, h.to), rest: after(r, h) }
}

/// The next element, whatever it is, as a tree.
pub fn read_any(r: Reader) -> Read<Value> / {asn1.refused, abort.raise} = {
  let tree = tree_at(r.data, r.at, r.end, r.room);
  { value: tree.value, rest: { ..r, at: tree.at, implicit: None } }
}

/// What `item` reads from all of `data`, entering at most `depth` nested elements: `Trailing` for
/// anything it leaves.
pub fn read_with<a | e>(
  data: Bytes,
  depth: Int,
  item: (Reader) -> Read<a> / {asn1.refused, abort.raise | e},
) -> a / {asn1.refused, abort.raise | e} = {
  let read = item(reader(data, depth));
  finish(read.rest);
  read.value
}

/// `read_with`, answering a refusal as an `Err`.
pub fn decode_with<a | e>(
  data: Bytes,
  depth: Int,
  item: (Reader) -> Read<a> / {asn1.refused, abort.raise | e},
) -> Result<a, Refusal> / {abort.raise | e} = try { read_with(data, depth, item) }

// --- The tree -------------------------------------------------------------------

/// The universal types that are constructed: `EXTERNAL`, `EMBEDDED PDV`, `SEQUENCE`, `SET` and
/// `CHARACTER STRING`. Every other is primitive in DER.
fn grouped(number: Int) -> Bool =
  number == 8 || number == 11 || number == 16 || number == 17 || number == 29

/// Whether the tree reads an element of this tag and form as a `Primitive` or a `Constructed`,
/// having no other value for it.
fn untyped(tag: Tag, constructed: Bool) -> Bool =
  if tag.class != Universal { true }
  else if constructed { tag.number == 8 || tag.number == 11 || tag.number == 29 } else {
    !grouped(tag.number) && (tag.number < 1 || tag.number > 6) && tag.number != 10
      && tag.number != 23
      && tag.number != 24
      && string_kind(tag.number) == None
  }

fn leaf_value(tag: Tag, content: Bytes, at: Int) -> Value / {asn1.refused, abort.raise} =
  if tag.class != Universal { Primitive(tag, content) } else {
    match tag.number {
      1 -> Boolean(boolean_of(content, at)),
      2 -> Integer(integer_of(content, at)),
      3 -> BitString(bits_of(content, at)),
      4 -> OctetString(content),
      5 -> {
        null_of(content, at);
        Null
      },
      6 -> ObjectId(oid_of(content, at)),
      10 -> Enumerated(integer_of(content, at)),
      23 -> UtcTime(utc_time_of(content, at)),
      24 -> GeneralizedTime(generalized_time_of(content, at)),
      number -> match string_kind(number) {
        Some(kind) -> Text(kind, text_of(kind, content, at)),
        None -> Primitive(tag, content),
      },
    }
  }

/// The element at `at` as a tree, and where it ends. `room` is how many levels deeper it may
/// nest; each constructed element spends one.
fn tree_at(
  data: Bytes,
  at: Int,
  end: Int,
  room: Int,
) -> { value: Value, at: Int } / {asn1.refused, abort.raise} = {
  let h = head(data, at, end);
  if h.tag.class == Universal && h.constructed != grouped(h.tag.number) { refuse(at, WrongForm) }
  else if !h.constructed {
    { value: leaf_value(h.tag, data.slice(h.from, h.to), h.from), at: h.to }
  } else if room <= 0 { refuse(at, TooDeep) } else {
    let set = h.tag == universal(17);
    let held = trees(data, h.from, h.to, room - 1, set, b"", [], h.to - h.from);
    {
      value: if set { Set(held) }
      else if h.tag == universal(16) { Sequence(held) }
      else { Constructed(h.tag, held) },
      at: h.to,
    }
  }
}

/// The elements from `at` to `end`, as `members` reads a constructed element's.
fn trees(
  data: Bytes,
  at: Int,
  end: Int,
  room: Int,
  sorted: Bool,
  last: Bytes,
  acc: List<Value>,
  left: Int,
) -> List<Value> / {asn1.refused, abort.raise} =
  if at >= end || left <= 0 { acc } else {
    let tree = tree_at(data, at, end, room);
    let whole = if sorted { data.slice(at, tree.at) } else { b"" };
    if compare(last, whole) == Greater { refuse(at, Unsorted) }
    else { trees(data, tree.at, end, room, sorted, whole, acc.push(tree.value), left - 1) }
  }

/// The document `data` is, nested at most `depth` deep, raising `asn1.refused` where `decode`
/// answers `Err`.
pub fn read(data: Bytes, depth: Int) -> Value / {asn1.refused, abort.raise} =
  read_with(data, depth, read_any)

/// The document `data` is, nested at most `depth` deep, or why it is not exactly one DER value.
pub fn decode(data: Bytes, depth: Int) -> Result<Value, Refusal> / {abort.raise} =
  try { read(data, depth) }

/// An `INTEGER`'s content as a tree holds it, which is as a reader answers it.
fn exact_integer(content: Bytes) -> Bytes / {asn1.unwritable, abort.raise} =
  if content.len() == 0 { asn1.unwritable(EmptyInteger) }
  else if redundant(content, 0) { asn1.unwritable(LongInteger) }
  else { content }

/// The encoding of `v`, raising `asn1.unwritable` where `encode` answers `Err`. A tree is written
/// only as `read` would have answered it: an `Integer` in its fewest octets, a `Set` in order, a
/// `Primitive` or a `Constructed` under a tag the tree has no other reading of.
pub fn write(v: Value) -> Bytes / {asn1.unwritable, abort.raise} =
  match v {
    Boolean(b) -> boolean(b),
    Integer(content) -> element(0x02, exact_integer(content)),
    Enumerated(content) -> element(0x0A, exact_integer(content)),
    BitString(b) -> bit_string(b),
    OctetString(octets) -> octet_string(octets),
    Null -> null(),
    ObjectId(o) -> oid(o),
    Text(kind, text) -> string(kind, text),
    UtcTime(t) -> if date::offset_minutes(t) == 0 { utc_time(t) } else { asn1.unwritable(BadTime) },
    GeneralizedTime(t) -> if date::offset_minutes(t) == 0 { generalized_time(t) }
    else { asn1.unwritable(BadTime) },
    Sequence(held) -> sequence(held.map(write)),
    Set(held) -> {
      let parts = held.map(write);
      if parts.is_sorted() { element(0x31, Bytes::concat_all(parts)) }
      else { asn1.unwritable(Unsorted) }
    },
    Constructed(tag, held) -> if untyped(tag, true) { constructed(tag, held.map(write)) }
    else { asn1.unwritable(BadTag) },
    Primitive(tag, content) -> if untyped(tag, false) { primitive(tag, content) }
    else { asn1.unwritable(BadTag) },
  }

/// The encoding of `v`, or why it has none.
pub fn encode(v: Value) -> Result<Bytes, Why> / {abort.raise} = try { write(v) }

// --- Laws -----------------------------------------------------------------------

/// How deep `v` nests: the depth a reader needs for it.
fn height(v: Value) -> Int =
  match v {
    Sequence(held) | Set(held) | Constructed(_, held) ->
      1 + held.map(height).fold(0, |deepest: Int, h: Int| max(deepest, h)),
    _ -> 0,
  }

/// Whether `t` is a day and a time of day `std.date` makes, which a test's draw of its
/// constructors need not be.
fn in_calendar(t: OffsetDateTime) -> Bool =
  match t {
    OffsetDateTime(DateTime(on, clock), _) ->
      date::of_unix_days(date::unix_days(on)) == Some(on)
        && date::time_of_nanos(date::nanos_of_day(clock)) == Some(clock),
  }

/// Whether every time in `v` is in the calendar.
fn made(v: Value) -> Bool =
  match v {
    UtcTime(t) | GeneralizedTime(t) -> in_calendar(t),
    Sequence(held) | Set(held) | Constructed(_, held) -> held.all(made),
    _ -> true,
  }

fn writable(v: Value) -> Bool / {abort.raise} =
  made(v) && (match encode(v) { Ok(_) -> true, Err(_) -> false })

/// Whether `data` is refused, or read as a value that writes back as exactly `data`.
fn rewritten(data: Bytes) -> Bool / {abort.raise} =
  match decode(data, 64) { Err(_) -> true, Ok(v) -> encode(v) == Ok(data) }

/// `data` with the octet at `at`, wherever in it that lands, replaced by `octet`'s low eight bits.
fn altered(data: Bytes, at: Int, octet: Int) -> Bytes / {abort.raise} =
  if data.len() == 0 { data } else {
    let i = (at & 9223372036854775807) % data.len();
    Bytes::concat_all([data.slice(0, i), byte_of_int(octet & 0xFF), data.slice(i + 1, data.len())])
  }

/// An object identifier of any arcs, whether or not it is one that writes.
fn oids() -> gen::Gen<Oid> = gen::map(gen::list(gen::any_int()), |arcs: List<Int>| Oid(arcs))

/// A `Value` as a test draws one.
fn values_at(depth: Int) -> gen::Gen<Value> =
  if depth <= 0 {
    gen::one_of([
      gen::map(gen::bool(), |f0: Bool| Boolean(f0)),
      gen::map(gen::bytes(), |f0: Bytes| Integer(f0)),
      gen::map(gen::bytes(), |f0: Bytes| Enumerated(f0)),
      gen::map(bits_drawn(), |f0: Bits| BitString(f0)),
      gen::map(gen::bytes(), |f0: Bytes| OctetString(f0)),
      gen::constant(Null),
      gen::map(oids(), |f0: Oid| ObjectId(f0)),
      gen::map2(string_kinds(), gen::text(), |f0: StringKind, f1: String| Text(f0, f1)),
      gen::map(date::offset_date_times(), |f0: OffsetDateTime| UtcTime(f0)),
      gen::map(date::offset_date_times(), |f0: OffsetDateTime| GeneralizedTime(f0)),
      gen::map2(tags(), gen::bytes(), |f0: Tag, f1: Bytes| Primitive(f0, f1)),
    ])
  } else {
    gen::one_of([
      gen::map(gen::bool(), |f0: Bool| Boolean(f0)),
      gen::map(gen::bytes(), |f0: Bytes| Integer(f0)),
      gen::map(gen::bytes(), |f0: Bytes| Enumerated(f0)),
      gen::map(bits_drawn(), |f0: Bits| BitString(f0)),
      gen::map(gen::bytes(), |f0: Bytes| OctetString(f0)),
      gen::constant(Null),
      gen::map(oids(), |f0: Oid| ObjectId(f0)),
      gen::map2(string_kinds(), gen::text(), |f0: StringKind, f1: String| Text(f0, f1)),
      gen::map(date::offset_date_times(), |f0: OffsetDateTime| UtcTime(f0)),
      gen::map(date::offset_date_times(), |f0: OffsetDateTime| GeneralizedTime(f0)),
      gen::map(gen::list_of(values_at(depth - 1), 3), |f0: List<Value>| Sequence(f0)),
      gen::map(gen::list_of(values_at(depth - 1), 3), |f0: List<Value>| Set(f0)),
      gen::map2(tags(), gen::list_of(values_at(depth - 1), 3), |f0: Tag, f1: List<Value>|
        Constructed(f0, f1)),
      gen::map2(tags(), gen::bytes(), |f0: Tag, f1: Bytes| Primitive(f0, f1)),
    ])
  }

fn values() -> gen::Gen<Value> = gen::sized(|size: Int| values_at(min(max(size / 16, 0), 3)))

/// A `Bits` as a test draws one.
fn bits_drawn() -> gen::Gen<Bits> =
  gen::map2(gen::any_int(), gen::bytes(), |unused: Int, bytes: Bytes|
    { unused: unused, bytes: bytes })

/// A `StringKind` as a test draws one.
fn string_kinds() -> gen::Gen<StringKind> =
  gen::elements([
    Utf8String,
    NumericString,
    PrintableString,
    Ia5String,
    VisibleString,
    UniversalString,
    BmpString,
  ])

/// A `Tag` as a test draws one.
fn tags() -> gen::Gen<Tag> =
  gen::map2(classes(), gen::any_int(), |class: Class, number: Int| { class: class, number: number })

/// A `Class` as a test draws one.
fn classes() -> gen::Gen<Class> = gen::elements([Universal, Application, Context, Private])

test "a value that writes reads back as itself" {
  gen::check(values(), |v: Value|
    if writable(v) { decode(write(v), height(v)) == Ok(v) } else { true })
}

test "a written value with one octet changed is refused or is another value's encoding" {
  gen::check3(values(), gen::any_int(), gen::any_int(), |v: Value, at: Int, octet: Int|
    if writable(v) { rewritten(altered(write(v), at, octet)) } else { true })
}

law "a Bool reads back from the BOOLEAN written for it" =
  round_trip(boolean, |der: Bytes| decode_with(der, 0, read_boolean).ok())

// --- Tests ----------------------------------------------------------------------

type Vector = { name: String, der: Bytes, value: Value }

fn vector(name: String, der: Bytes, value: Value) -> Vector = { name: name, der: der, value: value }

fn zeros(n: Int) -> Bytes = b"\x00".repeat(n)

fn vectors() -> List<Vector> / {abort.raise} =
  [
    vector("TRUE", Bytes::of_hex("0101ff"), Boolean(true)),
    vector("FALSE", Bytes::of_hex("010100"), Boolean(false)),
    vector("the INTEGER 0", Bytes::of_hex("020100"), Integer(b"\x00")),
    vector("the INTEGER 127", Bytes::of_hex("02017f"), Integer(b"\x7f")),
    vector("the INTEGER 128", Bytes::of_hex("02020080"), Integer(b"\x00\x80")),
    vector("the INTEGER -128", Bytes::of_hex("020180"), Integer(b"\x80")),
    vector("the INTEGER -129", Bytes::of_hex("0202ff7f"), Integer(b"\xff\x7f")),
    vector("an ENUMERATED", Bytes::of_hex("0a0101"), Enumerated(b"\x01")),
    vector(
      "a BIT STRING of eighteen bits",
      Bytes::of_hex("0304066e5dc0"),
      BitString({ unused: 6, bytes: Bytes::of_hex("6e5dc0") }),
    ),
    vector(
      "a BIT STRING of no bits",
      Bytes::of_hex("030100"),
      BitString({ unused: 0, bytes: b"" }),
    ),
    vector(
      "an OCTET STRING",
      Bytes::of_hex("04080123456789abcdef"),
      OctetString(Bytes::of_hex("0123456789abcdef")),
    ),
    vector("NULL", Bytes::of_hex("0500"), Null),
    vector(
      "the identifier 1.2.840.113549",
      Bytes::of_hex("06062a864886f70d"),
      ObjectId(oid"1.2.840.113549"),
    ),
    vector("the identifier 2.999.3", Bytes::of_hex("0603883703"), ObjectId(oid"2.999.3")),
    vector("the identifier 0.39", Bytes::of_hex("060127"), ObjectId(oid"0.39")),
    vector("the identifier 1.0", Bytes::of_hex("060128"), ObjectId(oid"1.0")),
    vector("the identifier 1.39", Bytes::of_hex("06014f"), ObjectId(oid"1.39")),
    vector("the identifier 2.0", Bytes::of_hex("060150"), ObjectId(oid"2.0")),
    vector("the identifier 1.2.16384", Bytes::of_hex("06042a818000"), ObjectId(oid"1.2.16384")),
    vector("a UTF8String", Bytes::of_hex("0c0668c3a96c6c6f"), Text(Utf8String, "héllo")),
    vector("a NumericString", b"\x12\x0512 34", Text(NumericString, "12 34")),
    vector("a PrintableString", b"\x13\x0bTest User 1", Text(PrintableString, "Test User 1")),
    vector("an IA5String", b"\x16\x05a@b\x0a\x7f", Text(Ia5String, "a@b\n\u{7f}")),
    vector("a VisibleString", b"\x1a\x03a~ ", Text(VisibleString, "a~ ")),
    vector("a UniversalString", Bytes::of_hex("1c040001f600"), Text(UniversalString, "\u{1F600}")),
    vector("a BMPString", Bytes::of_hex("1e0203c0"), Text(BmpString, "\u{3c0}")),
    vector("a UTCTime", b"\x17\x0d191216030210Z", UtcTime(timestamp"2019-12-16T03:02:10Z")),
    vector("a UTCTime of 1950", b"\x17\x0d500101000000Z", UtcTime(timestamp"1950-01-01T00:00:00Z")),
    vector("a UTCTime of 2049", b"\x17\x0d491231235959Z", UtcTime(timestamp"2049-12-31T23:59:59Z")),
    vector(
      "a GeneralizedTime",
      b"\x18\x0f20200229235959Z",
      GeneralizedTime(timestamp"2020-02-29T23:59:59Z"),
    ),
    vector(
      "a GeneralizedTime on the leap day of a century",
      b"\x18\x0f20000229000000Z",
      GeneralizedTime(timestamp"2000-02-29T00:00:00Z"),
    ),
    vector(
      "a GeneralizedTime with a fraction of its second",
      b"\x18\x1320191216030210.025Z",
      GeneralizedTime(timestamp"2019-12-16T03:02:10.025Z"),
    ),
    vector(
      "a GeneralizedTime to the nanosecond",
      b"\x18\x1999991231235959.999999999Z",
      GeneralizedTime(timestamp"9999-12-31T23:59:59.999999999Z"),
    ),
    vector(
      "a GeneralizedTime of the year 0",
      b"\x18\x0f00000101000000Z",
      GeneralizedTime(timestamp"0000-01-01T00:00:00Z"),
    ),
    vector(
      "a SEQUENCE",
      Bytes::of_hex("3006020101020102"),
      Sequence([Integer(b"\x01"), Integer(b"\x02")]),
    ),
    vector("a SEQUENCE of nothing", Bytes::of_hex("3000"), Sequence([])),
    vector(
      "a SET OF in order, a repeat included",
      Bytes::of_hex("310a020101020101020200ff"),
      Set([Integer(b"\x01"), Integer(b"\x01"), Integer(b"\x00\xff")]),
    ),
    vector(
      "an explicitly tagged field",
      Bytes::of_hex("a003020102"),
      Constructed(context(0), [Integer(b"\x02")]),
    ),
    vector(
      "an implicitly tagged field",
      Bytes::of_hex("8203666f6f"),
      Primitive(context(2), b"foo"),
    ),
    vector(
      "an application tag past 30",
      Bytes::of_hex("7f814800"),
      Constructed(application(200), []),
    ),
    vector("the application tag 0", Bytes::of_hex("4000"), Primitive(application(0), b"")),
    vector("the private tag 31", Bytes::of_hex("df1f00"), Primitive(private(31), b"")),
    vector(
      "the largest tag number",
      Bytes::of_hex("9fffffffffffffffff7f00"),
      Primitive(context(9223372036854775807), b""),
    ),
    vector(
      "a universal type the tree does not check",
      b"\x14\x03abc",
      Primitive(universal(20), b"abc"),
    ),
    vector(
      "a universal type that is constructed",
      Bytes::of_hex("28020500"),
      Constructed(universal(8), [Null]),
    ),
    vector("a length of 127", Bytes::of_hex("047f").concat(zeros(127)), OctetString(zeros(127))),
    vector("a length of 128", Bytes::of_hex("048180").concat(zeros(128)), OctetString(zeros(128))),
    vector(
      "a length of 256",
      Bytes::of_hex("04820100").concat(zeros(256)),
      OctetString(zeros(256)),
    ),
    vector(
      "a length of 65536",
      Bytes::of_hex("0483010000").concat(zeros(65536)),
      OctetString(zeros(65536)),
    ),
  ]

test "{c.name} reads as its value and writes back" for c: Vector in vectors() {
  assert_eq(decode(c.der, 1), Ok(c.value));
  assert_eq(encode(c.value), Ok(c.der))
}

type Refused = { name: String, der: Bytes, at: Int, why: Why }

fn refused(name: String, der: Bytes, at: Int, why: Why) -> Refused =
  { name: name, der: der, at: at, why: why }

fn refusals() -> List<Refused> / {abort.raise} =
  [
    refused("no bytes at all", b"", 0, Truncated),
    refused("a tag and no length", Bytes::of_hex("02"), 1, Truncated),
    refused("content cut short", Bytes::of_hex("020201"), 2, Truncated),
    refused("a length cut short", Bytes::of_hex("0482"), 2, Truncated),
    refused("a tag number cut short", Bytes::of_hex("9f81"), 2, Truncated),
    refused("a tag number that never starts", Bytes::of_hex("9f"), 1, Truncated),
    refused("a length claiming more than remains", Bytes::of_hex("0484ffffffff00"), 6, Truncated),
    refused(
      "a length of eight octets an Int holds",
      Bytes::of_hex("04880100000000000000"),
      10,
      Truncated,
    ),
    refused("bytes after the value", Bytes::of_hex("050000"), 2, Trailing),
    refused(
      "five levels where four are allowed",
      Bytes::of_hex("30083006300430023000"),
      8,
      TooDeep,
    ),
    refused("an indefinite length", Bytes::of_hex("30800000"), 1, IndefiniteLength),
    refused("a length under 128 in the long form", Bytes::of_hex("04810100"), 1, LongLength),
    refused(
      "a length with a leading zero octet",
      Bytes::of_hex("04820080").concat(zeros(128)),
      1,
      LongLength,
    ),
    refused("a length of nine octets", Bytes::of_hex("0489010000000000000000"), 1, TooWide),
    refused("a length of sixty-four bits", Bytes::of_hex("04888000000000000000"), 1, TooWide),
    refused("a tag number under 31 in the long form", Bytes::of_hex("1f0100"), 0, LongTag),
    refused("a tag number with a leading 80", Bytes::of_hex("9f807f00"), 0, LongTag),
    refused("a tag number of seventy bits", Bytes::of_hex("9fffffffffffffffffff7f00"), 0, TooWide),
    refused("an end of contents", Bytes::of_hex("0000"), 0, EndOfContents),
    refused("a BOOLEAN of 01", Bytes::of_hex("010101"), 2, BadBoolean),
    refused("a BOOLEAN of two octets", Bytes::of_hex("0102ffff"), 2, BadBoolean),
    refused("a BOOLEAN of no octets", Bytes::of_hex("0100"), 2, BadBoolean),
    refused("an INTEGER of no octets", Bytes::of_hex("0200"), 2, EmptyInteger),
    refused("an INTEGER padded with 00", Bytes::of_hex("02020001"), 2, LongInteger),
    refused("an INTEGER padded with FF", Bytes::of_hex("0202ff80"), 2, LongInteger),
    refused("an ENUMERATED padded with 00", Bytes::of_hex("0a020001"), 2, LongInteger),
    refused("a BIT STRING with no count", Bytes::of_hex("0300"), 2, BadBits),
    refused("a BIT STRING leaving out eight bits", Bytes::of_hex("03020800"), 2, BadBits),
    refused("a BIT STRING leaving out bits it does not have", Bytes::of_hex("030101"), 2, BadBits),
    refused("a BIT STRING with an unused bit set", Bytes::of_hex("03020101"), 2, BadBits),
    refused("a NULL with content", Bytes::of_hex("050100"), 2, BadNull),
    refused("an identifier of no octets", Bytes::of_hex("0600"), 2, BadOid),
    refused("an identifier that ends inside an arc", Bytes::of_hex("06022a86"), 3, BadOid),
    refused("an identifier arc with a leading 80", Bytes::of_hex("06032a8001"), 3, LongArc),
    refused(
      "an identifier arc of seventy bits",
      Bytes::of_hex("060b2affffffffffffffffff7f"),
      3,
      TooWide,
    ),
    refused("a UTF8String that is not UTF-8", Bytes::of_hex("0c02c328"), 2, BadText(Utf8String)),
    refused("a NumericString with a letter", b"\x12\x021a", 3, BadText(NumericString)),
    refused("a PrintableString with an @", b"\x13\x03a@b", 3, BadText(PrintableString)),
    refused(
      "an IA5String with an octet past ASCII",
      Bytes::of_hex("16026180"),
      3,
      BadText(Ia5String),
    ),
    refused("a VisibleString with a line break", b"\x1a\x02a\x0a", 3, BadText(VisibleString)),
    refused(
      "a UniversalString past the last character",
      Bytes::of_hex("1c0400110000"),
      2,
      BadText(UniversalString),
    ),
    refused(
      "a UniversalString of five octets",
      Bytes::of_hex("1c050000006100"),
      2,
      BadText(UniversalString),
    ),
    refused(
      "a BMPString with half a surrogate pair",
