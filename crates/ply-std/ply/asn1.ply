    ),
    refused("a BMPString of three octets", Bytes::of_hex("1e03006100"), 2, BadText(BmpString)),
    refused("a UTCTime without its seconds", b"\x17\x0b1912160302Z", 2, BadTime),
    refused("a UTCTime with an offset for its Z", b"\x17\x11191216030210+0000", 2, BadTime),
    refused("a UTCTime on the 30th of February", b"\x17\x0d190230000000Z", 2, BadTime),
    refused("a UTCTime on the 29th of February in 2023", b"\x17\x0d230229000000Z", 2, BadTime),
    refused("a UTCTime in a month before the first", b"\x17\x0d230001000000Z", 2, BadTime),
    refused("a UTCTime at sixty seconds", b"\x17\x0d191216030260Z", 2, BadTime),
    refused("a UTCTime with a letter in it", b"\x17\x0d1912160302x0Z", 2, BadTime),
    refused("a GeneralizedTime without its Z", b"\x18\x0e20191216030210", 2, BadTime),
    refused(
