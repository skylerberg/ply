/// The same key's public half, as a PKCS #1 `RSAPublicKey`.
fn rsa_public() -> Bytes / {abort.raise} =
  the_bytes(
    "MIIBCgKCAQEAofgWCuLjybRlzo0tZWJjNiuSfb4p4fAkd_wWJcyQoTbji9k0l8W26mPddxHmfHQp-Vaw-4qPCJrcS2mJPMEzP1Pt0Bm4d4QlL-yRT-SFd2lZS-pCgNMsD1W_YpRPEwOWvG6b32690r2jZ47soMZo9wGzjb_7OMg0LOL-bSf63kpaSHSXndS5z5rexMdbBYUsLA9e-KXBdQOS-UTo7WTBEMa2R2CapHg665xsmtdVMTBQY4uDZlxvb3qCo5ZwKh9kG4LT6_I5IhlJH7aGhyxXFvUK-DWNmoudF8NAco9_h9iaGNj8q2ethFkMLs91kzk2PAcDTW9gb54h4FRWyuXpoQIDAQAB",
  )

fn rsa_token() -> String =
  "eyJhbGciOiJSUzI1NiJ9." ++ rfc_claims_part()
    ++ ".cC4hiUPoj9Eetdgtv3hF80EGrhuB__dzERat0XF9g2VtQgr9PJbu3XOiZj5RZmh7AAuHIm4Bh-0Qc_lF5YKt_O8W2Fp5jujGbds9uJdbF9CUAr7t1dnZcAcQjbKBYNX4BAynRFdiuB--f_nZLgrnbyTyWzO75vRK5h6xBArLIARNPvkSjtQBMHlb1L07Qe7K0GarZRmB_eSN9383LcOLn6_dO--xi12jzDwusC-eOkHWEsqtFZESc6BfI7noOPqvhJ1phCnvWh6IeYI2w9QOYEUipUTI8np6LbgGY9Fs98rqVt5AXLIhWkWywlVmtVrBp0igcN_IoypGlUPQGe77Rw"

/// The public key of RFC 7515 appendix A.3: `04`, then its JWK's `x` and `y`.
fn curve_point() -> Bytes / {abort.raise} =
  bytes_concat_all([
    b"\x04",
    the_bytes("f83OJ3D2xF1Bg8vub9tLe1gHMzV76e8Tus9uPHvRVEU"),
    the_bytes("x_FEzRu9m36HLN_tue659LNpXW6pCyStikYjKIWI5a0"),
  ])

/// Its private key: the JWK's `d`.
fn curve_scalar() -> Bytes / {abort.raise} =
  the_bytes("jpsQnnGQmL-YBIffH1136cspYG6-0iY7X1fCE9-E9LI")

fn curve_token() -> String =
  "eyJhbGciOiJFUzI1NiJ9." ++ rfc_claims_part()
    ++ ".DtEhU3ljbEg8L38VWAfUAqOyKAM6-Xx-F4GawxaepmXFCgfTjDxw5djxLa8ISlSApmWQxfKTUJqPP3-Kg6NU1Q"

/// The token of RFC 7515 appendix A.4, signed over P-521.
fn p521_token() -> String =
  "eyJhbGciOiJFUzUxMiJ9.UGF5bG9hZA.AdwMgeerwtHoh-l192l60hp9wAHZFVJbLfD_UxMi70cwnZOYaRI1bKPWROc-mZZqwqT2SI-KGDKB34XO0aw_7XdtAG8GaSwFKdCAPZgoXD2YBJZCPEX3xKpRwcdOO8KpEHwJjyqOgzDO7iKvU8vcnwNrmxYbSW9ERBXukOXolLzeO_Jn"

fn rfc_payload() -> Bytes =
  b"{\"iss\":\"joe\",\r\n \"exp\":1300819380,\r\n \"http://example.com/is_root\":true}"

type Published = { name: String, token: String, key: Stated, alg: String, payload: Bytes }

/// The signed tokens the RFCs publish under an algorithm this module has, each with its key and
/// the octets it signs.
fn published() -> List<Published> / {abort.raise} =
  [
    {
      name: "RFC 7515 appendix A.1",
      token: rfc_token(),
      key: rfc_stated(),
      alg: "HS256",
      payload: rfc_payload(),
    },
    {
      name: "RFC 7515 appendix A.2",
      token: rsa_token(),
      key: Pkcs1(Sha256, rsa_public()),
      alg: "RS256",
      payload: rfc_payload(),
    },
    {
      name: "RFC 7515 appendix A.3",
      token: curve_token(),
      key: Point(crypto::NistP256, curve_point()),
      alg: "ES256",
      payload: rfc_payload(),
    },
    {
      name: "RFC 8037 appendix A.4",
      token: rfc_edwards_token(),
      key: Edwards(rfc_public()),
      alg: "EdDSA",
      payload: b"Example of Ed25519 signing",
    },
  ]

/// A key on a curve as a JWK states it, and a token over `Payload` another implementation signed
/// under it: RFC 7515 appendix A.4's on P-521, and OpenSSL's on P-384 and secp256k1.
type Curved = {
  alg: String,
  curve: EcdsaCurve,
  crv: String,
  x: String,
  y: String,
  d: String,
  token: String,
}

fn curved() -> List<Curved> =
  [
    {
      alg: "ES512",
      curve: crypto::NistP521,
      crv: "P-521",
      x: "AekpBQ8ST8a8VcfVOTNl353vSrDCLLJXmPk06wTjxrrjcBpXp5EOnYG_NjFZ6OvLFV1jSfS9tsz4qUxcWceqwQGk",
      y: "ADSmRA43Z1DSNx_RvcLI87cdL07l6jQyyBXMoxVg_l2Th-x3S1WDhjDly79ajL4Kkd0AZMaZmh9ubmf63e3kyMj2",
      d: "AY5pb7A0UFiB3RELSD64fTLOSV_jazdF7fLYyuTw8lOfRhWg6Y6rUrPAxerEzgdRhajnu0ferB0d53vM9mE15j2C",
      token: p521_token(),
    },
    {
      alg: "ES384",
      curve: crypto::NistP384,
      crv: "P-384",
      x: "QhZc-4gfd3Z8qRgFiJDhjVLqVUD3mj6u8YNM5-cHCdefbv08-Vzs_QmKvoFuiNOh",
      y: "vcaP9WReSce1y6bpVMpxTZAR8DuLMzQ_W5P81mpeVPMJ0110aYszrrt5eeUg06Qz",
      d: "AAAAAAAAAAAAAAAAAAAAEjRWeJCrze8AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAH",
      token: "eyJhbGciOiJFUzM4NCJ9.UGF5bG9hZA.oaz9_irmTOXXK0MQ5E8-cO6Hl5dCNoUYidoIqS48VbYszTILb2ya5L0x3B118p7n1zk68rUx5dh9vc4HzwKddcECxICEmExMNsvqVffAsayRB3bYBr2nhUMgCPlKy9tR",
    },
    {
      alg: "ES256K",
      curve: crypto::Secp256k1,
      crv: "secp256k1",
      x: "ibaPEM95vmILZmAy6VE-50OtbnnlxyWAbUB0NsMtK_8",
      y: "mzcQ1Apyn49D2GcuUrs43lgcKfzgge8O4phFP-trgVc",
      d: "AAAAAAAAAAAAwP_uAAAAAAAAAAAAAAAAAAAAAAAAAAs",
      token: "eyJhbGciOiJFUzI1NksifQ.UGF5bG9hZA._fNpjb3g9ve-d0BEOqYkmzYFYc0qDvoNcmj7cwRA6tTarn3w79z88vRFh0cznda6lFcE3kO-Anxl3JNNo6Jc7g",
    },
  ]

test "{c.alg}: another's token verifies, the JWK's scalar signs what its point verifies, and a turned bit is refused" for c: Curved in curved(
  ) {
  let point = bytes_concat_all([b"\x04", the_bytes(c.x), the_bytes(c.y)]);
  let public = key_of(Point(c.curve, point));
  assert_eq(algorithm(public), c.alg);
  assert_eq(verify_bytes(c.token, public, 4096).payload, b"Payload");
  let read = jwk(
    document(
      "{\"kty\":\"EC\",\"alg\":\"" ++ c.alg ++ "\",\"crv\":\"" ++ c.crv ++ "\",\"x\":\"" ++ c.x
        ++ "\",\"y\":\""
        ++ c.y
        ++ "\",\"d\":\""
        ++ c.d
        ++ "\"}",
    ),
  );
  assert_eq(verifying(read.key), public);
  let ours = sign_bytes(b"Payload", read.key, unmarked());
  assert_eq(ours, sign_bytes(b"Payload", read.key, unmarked()));
  assert_eq(verify_bytes(ours, public, 4096).payload, b"Payload");
  assert_eq(
    option_map(list_at(string_split(ours, "."), 2), |part: String| bytes_len(the_bytes(part))),
    Some(2 * crypto::scalar_size(c.curve)),
  );
  let parts = string_split(ours, ".");
  let turned = option_expect(list_at(parts, 0), "a header") ++ "." ++ base64url_encode(b"Payloae")
    ++ "."
    ++ option_expect(list_at(parts, 2), "a signature");
  assert_eq(try { verify_bytes(turned, public, 4096) }, Err(BadSignature))
}

/// RFC 7515 appendix A.2's RSA key as its JWK states it, private numbers and all, under `alg`.
