//! JSON Web Tokens: claims a key vouches for, signed and verified as RFC 7519 and RFC 7515 define
//! them, with the mistakes RFC 8725 lists kept out by what the functions take.
//!
//! A token is three base64url texts joined by dots: a header naming how it was signed, a payload,
//! and a signature over the first two as written. `sign` makes one of a `Claims`. `verify` answers
//! a `Verified` only where the key it was handed made the signature and the claims meet the
//! `Policy` it was handed, at the instant it was handed; `Verified` is opaque, so a function that
//! takes one cannot be given claims nobody checked. `peek` reads a token without checking it, to
//! choose a key by what the token says of itself, and answers an `Unverified`. `sign_bytes` and
//! `verify_bytes` are the same signature over a payload that is not claims.
//!
//! A `Key` names its one algorithm, and a token whose header names another is refused before any
//! signature is computed. So the token never chooses how it is judged: `none` is no algorithm a
//! key can name, and a public key is never read as an HMAC secret. The algorithms are HMAC with
//! SHA-256, SHA-384 and SHA-512 (`HS256`, `HS384`, `HS512`), EdDSA over Ed25519, ECDSA over P-256
//! with SHA-256 (`ES256`), P-384 with SHA-384 (`ES384`), P-521 with SHA-512 (`ES512`) and
//! secp256k1 with SHA-256 (`ES256K`, RFC 8812), RSA PKCS #1 v1.5 (`RS256`, `RS384`, `RS512`) and
//! RSA-PSS (`PS256`, `PS384`, `PS512`). Every signature here is a function of the key and the
//! input: an ECDSA nonce is RFC 6979's and a PSS salt is made of the key and the message.
//!
//! A key that signs holds its material as a `Secret`, which the runtime alone reads; a key that
//! only verifies is public bytes. An HMAC secret shorter than its hash's digest is refused by
//! `sign` and by `verify` alike (RFC 7518 §3.2), since a verifier under a guessable secret admits
//! whoever guesses it, and an RSA key under 2048 bits is refused as `SmallKey`. An `ES256`
//! signature is `r` then `s`, each as long as the curve's scalar, and nothing else: the DER form
//! X.509 writes is no signature here.
//!
//! Reading is strict. A token longer than the limit its reader names is refused unread. Its
//! parts are unpadded base64url with no stray character and no loose bits; its header and its
//! claims are JSON objects that name each member once; a `crit` header, `b64` set false and the
//! five parts of an encrypted token are refused by name. A header that points at a key (`jku`,
//! `x5u`, `jwk`) is never followed: nothing here performs anything, so no token makes a verifier
//! fetch. An HMAC is compared as `std.hash`'s `tags_match` compares, and the payload is not
//! parsed until the signature holds.
//!
//! A `Policy` has no default: its writer says how long a token may be, how far two clocks may
//! differ, whether a token must expire, and what `iss`, `aud`, `sub` and `typ` must be, or `Any`
//! for each one it does not look at. `exp` and `nbf` are judged against the `Instant` the caller
//! passes, never a clock read here. `iat` and `jti` are answered and not judged: a verifier that
//! bounds a token's age, or refuses one used twice, keeps that state itself.
//!
//! `jwk` and `jwks` read the keys of RFC 7517 this module can use: `oct`, `OKP` over Ed25519,
//! `EC` over the four curves and `RSA`, and `key_for` picks the one a peeked header names. A JWK
//! is JSON its caller parsed, so the text of a `k` or a `d` has been a plain `String` on the way
//! here; the bytes it encodes are decoded inside a `Secret` and are never a plain value, and an
//! RSA private key's numbers are made a document by the runtime alone.

import std.base64 (base64url_decode, base64url_decode_secret, base64url_encode)
import std.crypto
import std.crypto (Digest, EcdsaCurve, Raw, Sha256, Sha384, Sha512)
import std.decimal
import std.ed25519
import std.gen
import std.gen (Gen)
import std.hash (hmac_sha256, hmac_sha384, hmac_sha512, tags_match)
import std.json
import std.json (Array, DecodeError, Json, JsonCodec, Member, Number, Object, Str)
import std.list (any, concat, contains, enumerate, find, flat_map, somes)
import std.math (max_int, min_int)
import std.option (option_expect, option_map)
import std.result (result_expect)
import std.string (join, repeat, replace)
import std.time (after, as_nanos, nanos_at, seconds)

// --- Keys -------------------------------------------------------------------

/// A key, which names the one algorithm it signs or verifies under. A key that signs holds a
/// `Secret`, and verifies what it signed; a key that only verifies is public. Holding a `Secret`,
/// a `Key` is drawn by no `forall`: a law states the bytes and builds the key.
pub type Key =
  /// `HS256`: HMAC with SHA-256 under a shared secret of thirty-two bytes or more.
  | HmacSha256(Secret<Bytes>)
  /// `HS384`: HMAC with SHA-384 under a shared secret of forty-eight bytes or more.
  | HmacSha384(Secret<Bytes>)
  /// `HS512`: HMAC with SHA-512 under a shared secret of sixty-four bytes or more.
  | HmacSha512(Secret<Bytes>)
  /// `EdDSA` over Ed25519, to verify with: the thirty-two bytes of a public key.
  | Ed25519(Bytes)
  /// `EdDSA` over Ed25519, to sign with: the thirty-two bytes of a seed, which is the private key.
  | Ed25519Seed(Secret<Bytes>)
  /// `ES256`, `ES384`, `ES512` or `ES256K` by its curve (P-256, P-384, P-521 or secp256k1), to
  /// verify with: a point of the curve in its uncompressed form.
  | Ecdsa(EcdsaCurve, Bytes)
  /// The same, to sign with: the curve's scalar, most significant byte first.
  | EcdsaScalar(EcdsaCurve, Secret<Bytes>)
  /// `RS256`, `RS384` or `RS512` by its digest, to verify with: a PKCS #1 `RSAPublicKey` of 2048
  /// bits or more.
  | RsaPkcs1(Digest, Bytes)
  /// The same, to sign with: a private key document, PKCS #8 or PKCS #1 in DER.
  | RsaPkcs1Document(Digest, Secret<Bytes>)
  /// `PS256`, `PS384` or `PS512` by its digest, to verify with: a PKCS #1 `RSAPublicKey` of 2048
  /// bits or more.
  | RsaPss(Digest, Bytes)
  /// The same, to sign with: a private key document, PKCS #8 or PKCS #1 in DER.
  | RsaPssDocument(Digest, Secret<Bytes>)

fn digest_bits(digest: Digest) -> String =
  match digest { Sha256 -> "256", Sha384 -> "384", Sha512 -> "512" }

/// The `alg` of ECDSA on `curve` (RFC 7518 §3.4, RFC 8812 §3.2).
fn curve_algorithm(curve: EcdsaCurve) -> String =
  match curve {
    crypto::NistP256 -> "ES256",
    crypto::NistP384 -> "ES384",
    crypto::NistP521 -> "ES512",
    crypto::Secp256k1 -> "ES256K",
  }

/// The `alg` a token signed with `key` names.
pub fn algorithm(key: Key) -> String =
  match key {
    HmacSha256(_) -> "HS256",
    HmacSha384(_) -> "HS384",
    HmacSha512(_) -> "HS512",
    Ed25519(_) -> "EdDSA",
    Ed25519Seed(_) -> "EdDSA",
    Ecdsa(curve, _) -> curve_algorithm(curve),
    EcdsaScalar(curve, _) -> curve_algorithm(curve),
    RsaPkcs1(digest, _) -> "RS" ++ digest_bits(digest),
    RsaPkcs1Document(digest, _) -> "RS" ++ digest_bits(digest),
    RsaPss(digest, _) -> "PS" ++ digest_bits(digest),
    RsaPssDocument(digest, _) -> "PS" ++ digest_bits(digest),
  }

/// The key a verifier holds for what `key` signs: the public key of an Ed25519 seed, an ECDSA
/// scalar or an RSA document, and an HMAC secret itself, which both sides share. Raises for a key
/// `sign` would refuse.
pub fn verifying(key: Key) -> Key / {jwt.refused, abort.raise} =
  match usable(key) {
    Ed25519Seed(seed) -> Ed25519(ed25519::public_key(seed)),
    EcdsaScalar(curve, scalar) ->
      Ecdsa(curve, public_of(crypto::ecdsa_signing(curve, scalar, Raw), key)),
    RsaPkcs1Document(digest, document) ->
      RsaPkcs1(digest, public_of(crypto::rsa_pkcs1_signing(document, digest), key)),
    RsaPssDocument(digest, document) ->
      RsaPss(digest, public_of(crypto::rsa_pss_signing(document, digest), key)),
    other -> other,
  }

/// What verifies ECDSA under `point` on `curve`, over the curve's own hash, `r` then `s`.
fn point_key(curve: EcdsaCurve, point: Bytes) -> Option<crypto::VerifyingKey> =
  crypto::ecdsa_verifying(curve, crypto::curve_digest(curve), point, Raw)

fn public_of(signer: Option<crypto::SigningKey>, key: Key) -> Bytes / {jwt.refused} =
  match signer {
    Some(made) -> crypto::verifying_bytes(crypto::verifying_key(made)),
    None -> jwt.refused(NoKey(algorithm(key))),
  }

/// `key`, refused where its algorithm cannot use it.
fn usable(key: Key) -> Key / {jwt.refused} =
  match key {
    HmacSha256(secret) -> if secret_len(secret) < 32 { short(secret) } else { key },
    HmacSha384(secret) -> if secret_len(secret) < 48 { short(secret) } else { key },
    HmacSha512(secret) -> if secret_len(secret) < 64 { short(secret) } else { key },
    Ed25519(public) -> if bytes_len(public) != 32 { odd(bytes_len(public)) } else { key },
    Ed25519Seed(seed) -> if secret_len(seed) != 32 { odd(secret_len(seed)) } else { key },
    Ecdsa(curve, point) -> if point_key(curve, point) == None { no_key(key) } else { key },
    EcdsaScalar(curve, scalar) -> if crypto::ecdsa_signing(curve, scalar, Raw) == None {
      no_key(key)
    } else { key },
    RsaPkcs1(_, public) -> rsa_usable(key, public),
    RsaPss(_, public) -> rsa_usable(key, public),
    RsaPkcs1Document(digest, document) -> if crypto::rsa_pkcs1_signing(document, digest) == None {
      no_key(key)
    } else { key },
    RsaPssDocument(digest, document) -> if crypto::rsa_pss_signing(document, digest) == None {
      no_key(key)
    } else { key },
  }

fn rsa_usable(key: Key, public: Bytes) -> Key / {jwt.refused} =
  match crypto::rsa_modulus_bits(public) {
    None -> no_key(key),
    Some(bits) -> if bits < 2048 { jwt.refused(SmallKey(bits)) }
    else if crypto::rsa_pkcs1_verifying(public, Sha256) == None { no_key(key) }
    else { key },
  }

fn short<a>(secret: Secret<Bytes>) -> a / {jwt.refused} = jwt.refused(ShortKey(secret_len(secret)))

fn odd<a>(size: Int) -> a / {jwt.refused} = jwt.refused(KeyLength(size))

fn no_key<a>(key: Key) -> a / {jwt.refused} = jwt.refused(NoKey(algorithm(key)))

fn signature(key: Key, input: Bytes) -> Bytes / {jwt.refused, abort.raise} =
  match key {
    HmacSha256(secret) -> hmac_sha256(secret, input),
    HmacSha384(secret) -> hmac_sha384(secret, input),
    HmacSha512(secret) -> hmac_sha512(secret, input),
    Ed25519Seed(seed) -> ed25519::sign(seed, input),
    EcdsaScalar(curve, scalar) ->
      signed_with(crypto::ecdsa_signing(curve, scalar, Raw), key, input),
    RsaPkcs1Document(digest, document) ->
      signed_with(crypto::rsa_pkcs1_signing(document, digest), key, input),
    RsaPssDocument(digest, document) ->
      signed_with(crypto::rsa_pss_signing(document, digest), key, input),
    Ed25519(_) -> jwt.refused(CannotSign),
    Ecdsa(_, _) -> jwt.refused(CannotSign),
    RsaPkcs1(_, _) -> jwt.refused(CannotSign),
    RsaPss(_, _) -> jwt.refused(CannotSign),
  }

fn signed_with(
  signer: Option<crypto::SigningKey>,
  key: Key,
  input: Bytes,
) -> Bytes / {jwt.refused, abort.raise} =
  match signer { Some(made) -> crypto::sign(made, input), None -> no_key(key) }

fn signed_by(key: Key, input: Bytes, signature: Bytes) -> Bool / {abort.raise} =
  match key {
    HmacSha256(secret) -> tags_match(hmac_sha256(secret, input), signature),
    HmacSha384(secret) -> tags_match(hmac_sha384(secret, input), signature),
    HmacSha512(secret) -> tags_match(hmac_sha512(secret, input), signature),
    Ed25519(public) -> ed25519::verify(public, input, signature),
    Ed25519Seed(seed) -> ed25519::verify(ed25519::public_key(seed), input, signature),
    Ecdsa(curve, point) -> held_by(point_key(curve, point), input, signature),
    EcdsaScalar(curve, scalar) ->
      held_by(verifier_of(crypto::ecdsa_signing(curve, scalar, Raw)), input, signature),
    RsaPkcs1(digest, public) ->
      held_by(crypto::rsa_pkcs1_verifying(public, digest), input, signature),
    RsaPkcs1Document(digest, document) ->
      held_by(verifier_of(crypto::rsa_pkcs1_signing(document, digest)), input, signature),
    RsaPss(digest, public) -> held_by(crypto::rsa_pss_verifying(public, digest), input, signature),
    RsaPssDocument(digest, document) ->
      held_by(verifier_of(crypto::rsa_pss_signing(document, digest)), input, signature),
  }

fn verifier_of(signer: Option<crypto::SigningKey>) -> Option<crypto::VerifyingKey> =
  match signer { Some(made) -> Some(crypto::verifying_key(made)), None -> None }

fn held_by(key: Option<crypto::VerifyingKey>, input: Bytes, signature: Bytes) -> Bool =
  match key { Some(verifier) -> crypto::verify(verifier, input, signature), None -> false }

// --- Tokens -----------------------------------------------------------------

/// What a signer writes in a token's header beside `alg`, which is its key's.
pub type Marks = new {
  /// `typ`: what kind of token this is, as `JWT` or `at+jwt`, for a verifier that is sent more
  /// than one kind.
  typ: Option<String>,
  /// `kid`: which of the signer's keys this is, for a verifier that holds several.
  kid: Option<String>,
}

/// A token's header as it was read.
pub type Header = new {
  /// `alg`, as the token spells it.
  alg: String,
  /// `typ`, where it has one.
  typ: Option<String>,
  /// `kid`, where it has one.
  kid: Option<String>,
  /// Every member, those above among them.
  members: Map<String, Json>,
}

/// A token's claims: the seven RFC 7519 registers, and every other by name.
pub type Claims = new {
  /// `iss`: who issued the token.
  issuer: Option<String>,
  /// `sub`: whom it is about.
  subject: Option<String>,
  /// `aud`: whom it is for. A token that names one audience as a string names a list of one,
  /// and one that names none an empty list.
  audience: List<String>,
  /// `exp`: the instant it stops being valid.
  expires: Option<Instant>,
  /// `nbf`: the instant it starts being valid.
  not_before: Option<Instant>,
  /// `iat`: when it was issued.
  issued_at: Option<Instant>,
  /// `jti`: a name the issuer gives no two tokens, for a verifier that refuses one used twice
  /// to remember.
  id: Option<String>,
  /// Every other member. It holds none of the seven names above.
  other: Map<String, Json>,
}

/// No claims at all, for a record update to state some of.
pub fn claims() -> Claims =
  {
    issuer: None,
    subject: None,
    audience: [],
    expires: None,
    not_before: None,
    issued_at: None,
    id: None,
    other: map_new(),
  }

/// What a verifier requires one claim, or the header's `typ`, to say.
pub type Expect =
  /// Nothing: the verifier does not look, and a token with none passes.
  | Any
  /// This string, as written. Of `aud`, which may list several, this one among them.
  | Exactly(String)
  /// One of these strings.
  | OneOf(List<String>)

/// What a verifier requires of a token. It has no default: each field is written out.
pub type Policy = new {
  /// The longest token read, in bytes.
  max_bytes: Int,
  /// How far the issuer's clock may be from the verifier's: `exp` and `nbf` are judged this
  /// much in the token's favour. Below zero is zero.
  leeway: Duration,
  /// Whether a token with no `exp` is refused.
  must_expire: Bool,
  /// What `iss` must be.
  issuer: Expect,
  /// What `aud` must hold: the name this verifier answers to.
  audience: Expect,
  /// What `sub` must be.
  subject: Expect,
  /// What the header's `typ` must be, compared as written: capitals and an `application/` prefix
  /// count.
  typ: Expect,
}

/// Claims a key the verifier held signed and a policy the verifier wrote admitted. Only `verify`
/// makes one.
pub opaque type Verified = new { header: Header, claims: Claims }

/// A payload a key the verifier held signed. Only `verify_bytes` makes one.
pub opaque type Signed = new { header: Header, payload: Bytes }

/// What a token says of itself, with nothing checked: fit to choose a key by, and for nothing
/// that trusts it.
pub type Unverified = new { header: Header, claims: Claims }

/// Which part of a token, or a key set.
pub type Part = | InHeader | InPayload | InSignature | InKeys

/// Why a token, a key or a signing was refused.
pub type Refusal =
  /// The token, or the key set, is this many bytes, which is past the limit its reader named.
  | TooLong(Int)
  /// It is this many parts between dots, where a signed token is three.
  | Parts(Int)
  /// It is five parts: an encrypted token (JWE), which this module does not read.
  | Encrypted
  /// This part is not unpadded base64url as RFC 4648 §5 writes it: it holds a character outside
  /// the alphabet, padding or whitespace among them, or a last character with bits no byte
  /// holds.
  | Encoding(Part)
  /// This part is not a JSON object that names each member once, and why.
  | Malformed(Part, DecodeError)
  /// The header has no `alg`, or one that is not a string.
  | NoAlgorithm
  /// The header's `alg` is `none`, in these capitals: nobody signed the token.
  | Unsecured(String)
  /// The header's `alg`, or a key's type or curve, is this, which JOSE defines and this module
  /// does not implement.
  | Unsupported(String)
  /// The header's `alg` is the first and the key is for the second.
  | WrongAlgorithm(String, String)
  /// The header's `crit` lists these: extensions a reader accepts a token only by understanding,
  /// and this module understands none.
  | Critical(List<String>)
  /// The header sets `b64` false: a payload that is not base64url (RFC 7797).
  | Unencoded
  /// The signature is not the key's over this header and payload.
  | BadSignature
  /// An HMAC secret of this many bytes, fewer than its hash's digest.
  | ShortKey(Int)
  /// An Ed25519 key of this many bytes, where a public key and a seed are thirty-two.
  | KeyLength(Int)
  /// An RSA key whose modulus is this many bits, fewer than 2048.
  | SmallKey(Int)
  /// The key's bytes are no key of this algorithm, which is its own: a point off the curve, a
  /// scalar out of range, or bytes that are no RSA key.
  | NoKey(String)
  /// A public key was asked to sign.
  | CannotSign
  /// This member is not of the type its definition gives it.
  | Mistyped(String)
  /// `other` holds this name, which is a registered claim's and has a field of its own.
  | Reserved(String)
  /// The token expired at this instant, the leeway or more before now.
  | Expired(Instant)
  /// The token is not valid before this instant, more than the leeway after now.
  | NotYet(Instant)
  /// This member is required and absent.
  | Missing(String)
  /// This member is these, which is not what was required.
  | Unexpected(String, List<String>)

/// What a function of this module raises where it refuses.
pub effect jwt {
  /// A token, a key or a set of claims is not one the function takes.
  raise refused(e: Refusal)
}

/// The sentence a refusal says to whoever reads a log.
pub fn refusal_to_string(r: Refusal) -> String =
  match r {
    TooLong(size) -> "it is " ++ int_to_string(size) ++ " bytes, past the limit",
    Parts(count) ->
      "a signed token is three parts joined by dots, and this is " ++ int_to_string(count),
    Encrypted -> "five parts are an encrypted token (JWE), which is not read here",
    Encoding(part) -> part_name(part) ++ " is not unpadded base64url",
    Malformed(part, e) ->
      part_name(part) ++ " is not a JSON object naming each member once: "
        ++ json::error_to_string(e),
    NoAlgorithm -> "the header names no `alg`",
    Unsecured(alg) -> "the header's `alg` is `" ++ alg ++ "`: nobody signed this token",
    Unsupported(name) ->
      "`" ++ name
        ++ "` is not implemented: this module has HS256, HS384, HS512, EdDSA over Ed25519, ES256, ES384, ES512, ES256K, RS256, RS384, RS512, PS256, PS384 and PS512",
    WrongAlgorithm(found, wanted) ->
      "the header's `alg` is `" ++ found ++ "` and the key is for `" ++ wanted ++ "`",
    Critical(names) ->
      "the header marks critical what is not understood here: " ++ join(names, ", "),
    Unencoded -> "the header sets `b64` false, and a payload that is not base64url is not read",
    BadSignature -> "the signature is not this key's over this header and payload",
    ShortKey(size) ->
      "an HMAC secret of " ++ int_to_string(size) ++ " bytes is shorter than its hash's digest",
    KeyLength(size) -> "an Ed25519 key is 32 bytes, and this is " ++ int_to_string(size),
    SmallKey(bits) ->
      "an RSA key of " ++ int_to_string(bits) ++ " bits is under the 2048 a signature needs",
    NoKey(alg) -> "the key's bytes are no `" ++ alg ++ "` key",
    CannotSign -> "a public key signs nothing",
    Mistyped(name) -> "`" ++ name ++ "` is not of the type its definition gives it",
    Reserved(name) -> "`" ++ name ++ "` is a registered claim, which has a field of its own",
    Expired(at) -> "the token expired at " ++ seconds_text(at),
    NotYet(at) -> "the token is not valid before " ++ seconds_text(at),
    Missing(name) -> "`" ++ name ++ "` is required and absent",
    Unexpected(name, found) ->
      "`" ++ name ++ "` is " ++ join(found, ", ") ++ ", which is not what is required",
  }

fn part_name(part: Part) -> String =
  match part {
    InHeader -> "the header",
    InPayload -> "the payload",
    InSignature -> "the signature",
    InKeys -> "the key set",
  }

fn seconds_text(at: Instant) -> String =
  int_to_string(nanos_at(at) / 1000000000) ++ " seconds from 1970-01-01T00:00:00Z"

// --- Signing ----------------------------------------------------------------

/// A token of `claims` signed with `key`, its header naming the key's `alg` and what `marks`
/// states. The same claims, key and marks always make the same token: both objects are written
/// with no whitespace and their members in ascending order.
///
/// Raises for a key that cannot sign, as `sign_bytes` does, and for a registered claim's name in
/// `claims.other`.
pub fn sign(claims: Claims, key: Key, marks: Marks) -> String / {jwt.refused, abort.raise} =
  sign_bytes(json::to_bytes(claims_json(claims)), key, marks)

/// A token whose payload is `payload`, signed with `key`: the compact form of RFC 7515.
///
/// Raises for an HMAC secret shorter than its hash's digest, a seed, a scalar or a document that
/// is no key of its algorithm, a public key, and a PSS key, which nothing here signs.
pub fn sign_bytes(payload: Bytes, key: Key, marks: Marks) -> String / {jwt.refused, abort.raise} = {
  let signer = usable(key);
  let header = json::to_bytes(header_json(algorithm(signer), marks));
  let input = base64url_encode(header) ++ "." ++ base64url_encode(payload);
  input ++ "." ++ base64url_encode(signature(signer, bytes_of_string(input)))
}

fn header_json(alg: String, marks: Marks) -> Json =
  json::object(
    somes([
      text_member("alg", Some(alg)),
      text_member("typ", marks.typ),
      text_member("kid", marks.kid),
    ]),
  )

fn text_member(name: String, text: Option<String>) -> Option<Member> =
  option_map(text, |s: String| { key: name, value: Str(s) })

// --- Verifying --------------------------------------------------------------

/// The claims of `token`, where `key` signed it and they meet `policy` at `now`.
///
/// Refusals come in this order. The key is one `sign` would refuse. The token is longer than
/// `policy.max_bytes`, is not three parts, or its header is not base64url of a JSON object with
/// a string `alg`. The `alg` is `none`, is not the key's, or the header sets `b64` false or
/// lists anything in `crit`. The signature is not base64url, or is not the key's. The payload is
/// not base64url of a JSON object, or a registered claim in it has the wrong type. Then the
/// policy: `typ`; `exp`, which is past once `now` is `exp` plus the leeway or later; `nbf`, which
/// is ahead while `now` is before `nbf` less the leeway; `iss`; `aud`; and `sub`.
pub fn verify(
  token: String,
  key: Key,
  policy: Policy,
  now: Instant,
) -> Verified / {jwt.refused, abort.raise} = {
  let signed = verify_bytes(token, key, policy.max_bytes);
  let claims = claims_of_members(members_of(InPayload, signed.payload));
  admitted(signed.header, claims, policy, now);
  { header: signed.header, claims: claims }
}

/// `verify`, with its refusal as an `Err`.
pub fn try_verify(
  token: String,
  key: Key,
  policy: Policy,
  now: Instant,
) -> Result<Verified, Refusal> / {abort.raise} = try { verify(token, key, policy, now) }

/// The payload of `token`, where `key` signed it: `verify` up to the signature, for a payload
/// that is not claims. `max_bytes` is the longest token read.
pub fn verify_bytes(
  token: String,
  key: Key,
  max_bytes: Int,
) -> Signed / {jwt.refused, abort.raise} = {
  let verifier = usable(key);
  let parts = parts_of(token, max_bytes);
  let header = header_of(parts.header);
  accepted(header, verifier);
  let stated = decoded(InSignature, parts.signature);
  if !signed_by(verifier, bytes_of_string(parts.header ++ "." ++ parts.payload), stated) {
    jwt.refused(BadSignature)
  } else { { header: header, payload: decoded(InPayload, parts.payload) } }
}

/// What `token` says of itself, with nothing checked: neither its signature, nor its `alg`, nor
/// a claim. For choosing the key to verify it with, by its `kid` or its issuer. `max_bytes` is
/// the longest token read.
pub fn peek(token: String, max_bytes: Int) -> Unverified / {jwt.refused, abort.raise} = {
  let parts = parts_of(token, max_bytes);
  let header = header_of(parts.header);
  {
    header: header,
    claims: claims_of_members(members_of(InPayload, decoded(InPayload, parts.payload))),
  }
}

type Parts = { header: String, payload: String, signature: String }

fn parts_of(token: String, max_bytes: Int) -> Parts / {jwt.refused} = {
  let size = bytes_len(bytes_of_string(token));
  if size > max_bytes { jwt.refused(TooLong(size)) } else {
    match string_split(token, ".") {
      [header, payload, signature] -> { header: header, payload: payload, signature: signature },
      parts -> if len(parts) == 5 { jwt.refused(Encrypted) }
      else { jwt.refused(Parts(len(parts))) },
    }
  }
}

fn decoded(part: Part, text: String) -> Bytes / {jwt.refused, abort.raise} =
  match base64url_decode(text) { Some(raw) -> raw, None -> jwt.refused(Encoding(part)) }

fn members_of(part: Part, raw: Bytes) -> Map<String, Json> / {jwt.refused, abort.raise} =
  match json::parse_unique(raw) {
    Ok(Object(members)) -> members,
    Ok(other) -> jwt.refused(Malformed(part, json::expected("an object", other))),
    Err(e) -> jwt.refused(Malformed(part, e)),
  }

fn header_of(text: String) -> Header / {jwt.refused, abort.raise} = {
  let members = members_of(InHeader, decoded(InHeader, text));
  match map_get(members, "alg") {
    Some(Str(alg)) ->
      { alg: alg, typ: text_of(members, "typ"), kid: text_of(members, "kid"), members: members },
    _ -> jwt.refused(NoAlgorithm),
  }
}

/// Whether a header is one `key` may judge: the algorithm first, so nothing is computed for a
/// token that names another.
fn accepted(header: Header, key: Key) -> Unit / {jwt.refused} =
  if spells_none(header.alg) { jwt.refused(Unsecured(header.alg)) }
  else if header.alg != algorithm(key) { jwt.refused(WrongAlgorithm(header.alg, algorithm(key))) }
  else if map_get(header.members, "b64") == Some(json::Bool(false)) { jwt.refused(Unencoded) }
  else {
    match map_get(header.members, "crit") {
      Some(listed) -> jwt.refused(Critical(strings_in(listed))),
      None -> (),
    }
  }

/// Whether `alg` is `none` in any capitals: an ASCII letter is its lower case with bit five set.
fn spells_none(alg: String) -> Bool =
  map(string_chars(alg), |c: Char| int_of_char(c) | 0x20) == [110, 111, 110, 101]

fn strings_in(j: Json) -> List<String> =
  match j {
    Array(items) -> somes(map(items, |item: Json| match item { Str(s) -> Some(s), _ -> None })),
    _ -> [],
  }

// --- Claims -----------------------------------------------------------------

fn registered() -> List<String> = ["iss", "sub", "aud", "exp", "nbf", "iat", "jti"]

/// The claims object a token of `c` carries: each registered claim that is stated, an audience
/// of one as a string, each time as a NumericDate, and the members of `c.other`. Raises for a
/// registered claim's name in `c.other`.
pub fn claims_json(c: Claims) -> Json / {jwt.refused, abort.raise} =
  match find(registered(), |name: String| map_contains(c.other, name)) {
    Some(name) -> jwt.refused(Reserved(name)),
    None ->
      Object(
        fold(stated(c), c.other, |members: Map<String, Json>, m: Member|
          map_insert(members, m.key, m.value)),
      ),
  }

/// The claims a JSON object states. Raises `Malformed` for a value that is no object, and
/// `Mistyped` for a registered claim of the wrong type: `iss`, `sub` and `jti` are strings,
/// `aud` a string or an array of them, and `exp`, `nbf` and `iat` numbers.
///
/// A time finer than a nanosecond is read to the nanosecond that favours no token: `exp` and
/// `iat` toward the earlier, `nbf` toward the later. One past what an `Instant` holds, as the
/// `exp` of a token meant never to expire, is the last instant it holds, or the first.
pub fn claims_of_json(j: Json) -> Claims / {jwt.refused, abort.raise} =
  match j {
    Object(members) -> claims_of_members(members),
    other -> jwt.refused(Malformed(InPayload, json::expected("an object", other))),
  }

/// The claim `name` among `c.other`, read through `codec`; an `Err` where there is none or it is
/// not what the codec reads. A codec of a whole record reads `Object(c.other)`.
pub fn claim<a>(
  c: Claims,
  name: String,
  codec: JsonCodec<a>,
) -> Result<a, DecodeError> / {abort.raise} = json::field(Object(c.other), name, codec)

fn stated(c: Claims) -> List<Member> / {abort.raise} =
  somes([
    text_member("iss", c.issuer),
    text_member("sub", c.subject),
    audience_member(c.audience),
    time_member("exp", c.expires),
    time_member("nbf", c.not_before),
    time_member("iat", c.issued_at),
    text_member("jti", c.id),
  ])

fn audience_member(audience: List<String>) -> Option<Member> =
  match audience {
    [] -> None,
    [one] -> Some({ key: "aud", value: Str(one) }),
    several -> Some({ key: "aud", value: json::strings(several) }),
  }

fn time_member(name: String, at: Option<Instant>) -> Option<Member> / {abort.raise} =
  option_map(at, |t: Instant| { key: name, value: numeric_date(t) })

/// A NumericDate (RFC 7519 §2): seconds from 1970-01-01T00:00:00Z, written whole where they are.
fn numeric_date(at: Instant) -> Json / {abort.raise} =
  Number(decimal::normalize(decimal_div(decimal_of_int(nanos_at(at)), 1000000000m, 9, Down)))

fn claims_of_members(members: Map<String, Json>) -> Claims / {jwt.refused, abort.raise} =
  {
    issuer: text_of(members, "iss"),
    subject: text_of(members, "sub"),
    audience: audience_of(members),
    expires: time_of(members, "exp", Floor),
    not_before: time_of(members, "nbf", Ceiling),
    issued_at: time_of(members, "iat", Floor),
    id: text_of(members, "jti"),
    other: fold(registered(), members, |rest: Map<String, Json>, name: String|
      map_remove(rest, name)),
  }

fn text_of(members: Map<String, Json>, name: String) -> Option<String> / {jwt.refused} =
  match map_get(members, name) {
    None -> None,
    Some(Str(text)) -> Some(text),
    Some(_) -> jwt.refused(Mistyped(name)),
  }

fn audience_of(members: Map<String, Json>) -> List<String> / {jwt.refused} =
  match map_get(members, "aud") {
    None -> [],
    Some(Str(one)) -> [one],
    Some(Array(items)) ->
      map(items, |item: Json| match item { Str(s) -> s, _ -> jwt.refused(Mistyped("aud")) }),
    Some(_) -> jwt.refused(Mistyped("aud")),
  }

fn time_of(
  members: Map<String, Json>,
  name: String,
  toward: Rounding,
) -> Option<Instant> / {jwt.refused, abort.raise} =
  match map_get(members, name) {
    None -> None,
    Some(Number(seconds)) -> Some(instant_of(seconds, toward)),
    Some(_) -> jwt.refused(Mistyped(name)),
  }

/// The instant a NumericDate names, to the nanosecond `toward` picks; one past what an `Instant`
/// holds is the last it holds, or the first.
fn instant_of(seconds: Decimal, toward: Rounding) -> Instant / {abort.raise} =
  if seconds >= 9223372037m { Instant(max_int()) }
  else if seconds <= -9223372037m { Instant(min_int()) } else {
    match int_of_decimal(decimal_round(seconds, 9, toward) * 1000000000m, toward) {
      Some(nanos) -> Instant(nanos),
      None -> Instant(if seconds > 0m { max_int() } else { min_int() }),
    }
  }

fn admitted(header: Header, c: Claims, policy: Policy, now: Instant) -> Unit / {jwt.refused} = {
  held("typ", policy.typ, listed(header.typ));
  in_time(c, policy, now);
  held("iss", policy.issuer, listed(c.issuer));
  held("aud", policy.audience, c.audience);
  held("sub", policy.subject, listed(c.subject))
}

fn in_time(c: Claims, policy: Policy, now: Instant) -> Unit / {jwt.refused} = {
  let leeway = max(as_nanos(policy.leeway), 0);
  let at = nanos_at(now);
  match c.expires {
    Some(expires) -> if at >= nanos_at(expires) +| leeway { jwt.refused(Expired(expires)) },
    None -> if policy.must_expire { jwt.refused(Missing("exp")) },
  };
  match c.not_before {
    Some(start) -> if at < nanos_at(start) -| leeway { jwt.refused(NotYet(start)) },
    None -> (),
  }
}

fn held(name: String, expect: Expect, found: List<String>) -> Unit / {jwt.refused} =
  if admits(expect, found) { () }
  else if len(found) == 0 { jwt.refused(Missing(name)) }
  else { jwt.refused(Unexpected(name, found)) }

fn admits(expect: Expect, found: List<String>) -> Bool =
  match expect {
    Any -> true,
    Exactly(wanted) -> contains(found, wanted),
    OneOf(wanted) -> any(found, |value: String| contains(wanted, value)),
  }

fn listed(text: Option<String>) -> List<String> = match text { Some(t) -> [t], None -> [] }

// --- Key sets ---------------------------------------------------------------

/// A key as a JSON Web Key (RFC 7517) states it, under the `kid` its set knows it by.
pub type Jwk = new { kid: Option<String>, key: Key }

/// The key a JWK states: an `oct` key whose `alg` is `HS256`, `HS384` or `HS512`; an `OKP` key
/// on `Ed25519`, a public one or, with `d`, a seed; an `EC` key on `P-256`, `P-384`, `P-521` or
/// `secp256k1`, a public one or, with `d`, a scalar; or an `RSA` key whose `alg` is one of the
/// six RSA algorithms, a public one or, with `d`, a private one.
///
/// An `oct` or an `RSA` key with no `alg` is refused as `Missing`, since a `Key` names its
/// algorithm and the bytes alone do not: build it with the constructor meant, and so is a private
/// `RSA` key that leaves its primes out. Raises `Unsupported` for any other `kty`, curve or `alg`;
/// `Unexpected` for a `use` other than `sig` and for a `d` that is not the private key of `x`;
/// `SmallKey` for an RSA modulus under 2048 bits, `NoKey` for a point off its curve or private
/// numbers that are no key with `n` and `e`, and `Mistyped` for a member of the wrong type or not
/// base64url.
pub fn jwk(j: Json) -> Jwk / {jwt.refused, abort.raise} =
  match j {
    Object(members) -> {
      where_stated("use", text_of(members, "use"), "sig");
      let alg = text_of(members, "alg");
      let key = match needed(members, "kty") {
        "oct" -> shared_key(alg, sealed_octets(members, "k")),
        "OKP" -> edwards_key(members, alg),
        "EC" -> curve_key(members, alg),
        "RSA" -> rsa_key(members, alg),
        kind -> jwt.refused(Unsupported(kind)),
      };
      { kid: text_of(members, "kid"), key: usable(key) }
    },
    other -> jwt.refused(Malformed(InKeys, json::expected("an object", other))),
  }

/// The keys of a JWK Set this module can use, in its order. A key `jwk` would refuse is passed
/// over, as RFC 7517 §5 asks, so a set that also holds an encryption key reads as its others.
/// Raises for
/// a text longer than `max_bytes`, or one that is not a JSON object with an array `keys`.
pub fn jwks(src: Bytes, max_bytes: Int) -> List<Jwk> / {jwt.refused, abort.raise} =
  if bytes_len(src) > max_bytes { jwt.refused(TooLong(bytes_len(src))) } else {
    match map_get(members_of(InKeys, src), "keys") {
      Some(Array(items)) -> somes(map(items, |item: Json| usable_jwk(item))),
      Some(_) -> jwt.refused(Mistyped("keys")),
      None -> jwt.refused(Missing("keys")),
    }
  }

fn usable_jwk(j: Json) -> Option<Jwk> / {abort.raise} =
  match try { jwk(j) } { Ok(k) -> Some(k), Err(_) -> None }

/// The key among `keys` for a token with this header: the one of the header's algorithm, which
/// a key's `kty`, curve and `alg` decided when it was read, and of its `kid` where the header
/// names one. `None` where there is none, or more than one.
pub fn key_for(keys: List<Jwk>, header: Header) -> Option<Key> =
  match filter(keys, |k: Jwk|
      algorithm(k.key) == header.alg && (header.kid == None || k.kid == header.kid)) {
    [only] -> Some(only.key),
    _ -> None,
  }

fn needed(members: Map<String, Json>, name: String) -> String / {jwt.refused} =
  match text_of(members, name) { Some(text) -> text, None -> jwt.refused(Missing(name)) }

fn octets(members: Map<String, Json>, name: String) -> Bytes / {jwt.refused, abort.raise} =
  match base64url_decode(needed(members, name)) {
    Some(raw) -> raw,
    None -> jwt.refused(Mistyped(name)),
  }

/// The bytes a base64url member encodes, decoded inside a `Secret`.
fn sealed_octets(
  members: Map<String, Json>,
  name: String,
) -> Secret<Bytes> / {jwt.refused, abort.raise} =
  match base64url_decode_secret(secret_of_string(needed(members, name))) {
    Some(raw) -> raw,
    None -> jwt.refused(Mistyped(name)),
  }

fn shared_key(alg: Option<String>, secret: Secret<Bytes>) -> Key / {jwt.refused} =
  match alg {
    Some("HS256") -> HmacSha256(secret),
    Some("HS384") -> HmacSha384(secret),
    Some("HS512") -> HmacSha512(secret),
    Some(other) -> jwt.refused(Unsupported(other)),
    None -> jwt.refused(Missing("alg")),
  }

fn edwards_key(
  members: Map<String, Json>,
  alg: Option<String>,
) -> Key / {jwt.refused, abort.raise} = {
  where_stated("alg", alg, "EdDSA");
  let curve = needed(members, "crv");
  if curve != "Ed25519" { jwt.refused(Unsupported(curve)) } else {
    let public = usable(Ed25519(octets(members, "x")));
    if !map_contains(members, "d") { public } else {
      let seed = usable(Ed25519Seed(sealed_octets(members, "d")));
      if verifying(seed) == public { seed }
      else { jwt.refused(Unexpected("x", [needed(members, "x")])) }
    }
  }
}

/// The curve a JWK's `crv` names (RFC 7518 §6.2.1.1, RFC 8812 §3.1).
fn jwk_curve(name: String) -> Option<EcdsaCurve> =
  match name {
    "P-256" -> Some(crypto::NistP256),
    "P-384" -> Some(crypto::NistP384),
    "P-521" -> Some(crypto::NistP521),
    "secp256k1" -> Some(crypto::Secp256k1),
    _ -> None,
  }

fn curve_key(members: Map<String, Json>, alg: Option<String>) -> Key / {jwt.refused, abort.raise} = {
  let named = needed(members, "crv");
  match jwk_curve(named) {
    None -> jwt.refused(Unsupported(named)),
    Some(curve) -> {
      where_stated("alg", alg, curve_algorithm(curve));
      let size = crypto::scalar_size(curve);
      let x = octets(members, "x");
      let y = octets(members, "y");
      let public = if bytes_len(x) != size || bytes_len(y) != size {
        jwt.refused(NoKey(curve_algorithm(curve)))
      } else { usable(Ecdsa(curve, bytes_concat_all([b"\x04", x, y]))) };
      if !map_contains(members, "d") { public } else {
        let scalar = usable(EcdsaScalar(curve, sealed_octets(members, "d")));
        if verifying(scalar) == public { scalar }
        else { jwt.refused(Unexpected("x", [needed(members, "x")])) }
      }
    },
  }
}

/// A member's text, sealed as it is read out of the JSON its caller parsed.
fn sealed_text(members: Map<String, Json>, name: String) -> Secret<String> / {jwt.refused} =
  secret_of_string(needed(members, name))

fn rsa_key(members: Map<String, Json>, alg: Option<String>) -> Key / {jwt.refused, abort.raise} = {
  let n = octets(members, "n");
  let e = octets(members, "e");
  let public = match crypto::public_of_jwk(crypto::Rsa(n, e)) {
    Some(crypto::RsaPublic(document)) -> document,
    _ -> jwt.refused(NoKey("RSA")),
  };
  let private = if !map_contains(members, "d") { None } else {
    let numbers = {
      d: sealed_text(members, "d"),
      p: sealed_text(members, "p"),
      q: sealed_text(members, "q"),
      dp: sealed_text(members, "dp"),
      dq: sealed_text(members, "dq"),
      qi: sealed_text(members, "qi"),
    };
    match crypto::rsa_private_of_jwk(n, e, numbers) {
      Some(crypto::RsaPrivate(document)) -> Some(document),
      _ -> jwt.refused(NoKey(match alg { Some(named) -> named, None -> "RSA" })),
    }
  };
  match ((alg, private)) {
    (Some("RS256"), None) -> RsaPkcs1(Sha256, public),
    (Some("RS384"), None) -> RsaPkcs1(Sha384, public),
    (Some("RS512"), None) -> RsaPkcs1(Sha512, public),
    (Some("PS256"), None) -> RsaPss(Sha256, public),
    (Some("PS384"), None) -> RsaPss(Sha384, public),
    (Some("PS512"), None) -> RsaPss(Sha512, public),
    (Some("RS256"), Some(document)) -> RsaPkcs1Document(Sha256, document),
    (Some("RS384"), Some(document)) -> RsaPkcs1Document(Sha384, document),
    (Some("RS512"), Some(document)) -> RsaPkcs1Document(Sha512, document),
    (Some("PS256"), Some(document)) -> RsaPssDocument(Sha256, document),
    (Some("PS384"), Some(document)) -> RsaPssDocument(Sha384, document),
    (Some("PS512"), Some(document)) -> RsaPssDocument(Sha512, document),
    (Some(other), _) -> jwt.refused(Unsupported(other)),
    (None, _) -> jwt.refused(Missing("alg")),
  }
}

/// A member that may be left out, and must be `wanted` where it is not.
fn where_stated(name: String, stated: Option<String>, wanted: String) -> Unit / {jwt.refused} =
  match stated {
    Some(value) -> if value != wanted { jwt.refused(Unexpected(name, [value])) },
    None -> (),
  }

// --- Tests ------------------------------------------------------------------

fn the_bytes(text: String) -> Bytes / {abort.raise} = option_expect(base64url_decode(text), text)

/// A key as a table of cases states one, its bytes in the clear: a test tells its cases apart by
/// their digests, and a `Secret` has none.
type Stated =
  /// An HMAC secret, under SHA-256, SHA-384 or SHA-512 by the number.
  | Shared(Int, Bytes)
  | Seed(Bytes)
  | Edwards(Bytes)
  | Scalar(EcdsaCurve, Bytes)
  | Point(EcdsaCurve, Bytes)
  | Document(Digest, Bytes)
  | Pkcs1(Digest, Bytes)
  | Pss(Digest, Bytes)
  | PssDocument(Digest, Bytes)

gen for Stated by stated_keys

/// A key that signs: an HMAC secret of each of the three hashes, of its digest's length or up to
/// sixteen bytes more, an Ed25519 seed, or a P-256 scalar. No RSA key is drawn, since none is made
/// here: RFC 7515's stands for them below.
fn stated_keys() -> Gen<Stated> =
  gen::and_then(gen::below(5), |kind: Int|
    if kind < 3 {
      gen::and_then(gen::below(17), |more: Int|
        gen::map(gen::bytes_of(32 + 16 * kind + more), |secret: Bytes|
          Shared(256 + 128 * kind, secret)))
    } else {
      gen::map(gen::bytes_of(32), |material: Bytes|
        if kind == 3 { Seed(material) }
        else if crypto::ecdsa_signing(crypto::NistP256, secret_of_bytes(material), Raw) != None {
          Scalar(crypto::NistP256, material)
        } else { Scalar(crypto::NistP256, scalar_one()) })
    })

/// The scalar one, for a draw that is no scalar: zero, or a number at or past the curve's order.
fn scalar_one() -> Bytes =
  b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01"

fn key_of(stated: Stated) -> Key =
  match stated {
    Shared(256, secret) -> HmacSha256(secret_of_bytes(secret)),
    Shared(384, secret) -> HmacSha384(secret_of_bytes(secret)),
    Shared(_, secret) -> HmacSha512(secret_of_bytes(secret)),
    Seed(seed) -> Ed25519Seed(secret_of_bytes(seed)),
    Edwards(public) -> Ed25519(public),
    Scalar(curve, scalar) -> EcdsaScalar(curve, secret_of_bytes(scalar)),
    Point(curve, point) -> Ecdsa(curve, point),
    Document(digest, document) -> RsaPkcs1Document(digest, secret_of_bytes(document)),
    Pkcs1(digest, public) -> RsaPkcs1(digest, public),
    Pss(digest, public) -> RsaPss(digest, public),
    PssDocument(digest, document) -> RsaPssDocument(digest, secret_of_bytes(document)),
  }

fn b64(text: String) -> String / {abort.raise} = base64url_encode(bytes_of_string(text))

fn at_second(secs: Int) -> Instant = after(Instant(0), seconds(secs))

/// The bytes `0`, `1`, `2` and on: the keys the Python cross-checks were made with.
fn counting(n: Int) -> Bytes / {abort.raise} =
  bytes_concat_all(map(range(0, n), |i: Int| byte_of_int(i)))

/// A policy that looks at the signature and the times and nothing else.
fn lax() -> Policy =
  {
    max_bytes: 4096,
    leeway: seconds(0),
    must_expire: false,
    issuer: Any,
    audience: Any,
    subject: Any,
    typ: Any,
  }

fn as_jwt() -> Marks = { typ: Some("JWT"), kid: None }

fn unmarked() -> Marks = { typ: None, kid: None }

/// A token of this header and payload, signed by `key` whatever the header says.
fn forged(header: String, payload: String, key: Key) -> String / {jwt.refused, abort.raise} =
  resigned(b64(header) ++ "." ++ b64(payload), key)

/// These two parts as written, with `key`'s signature over them.
fn resigned(input: String, key: Key) -> String / {jwt.refused, abort.raise} =
  input ++ "." ++ base64url_encode(signature(key, bytes_of_string(input)))

/// The key of RFC 7515 appendix A.1, whose token RFC 7519 §3.1 shows again.
fn rfc_stated() -> Stated / {abort.raise} =
  Shared(
    256,
    the_bytes(
      "AyM1SysPpbyDfgZld3umj1qzKObwVMkoqQ-EstJQLr_T-1qS0gZH75aKtMN3Yj0iPS4hcgUuTwjAzZr1Z9CAow",
    ),
  )

fn rfc_key() -> Key / {abort.raise} = key_of(rfc_stated())

fn rfc_claims_part() -> String =
  "eyJpc3MiOiJqb2UiLA0KICJleHAiOjEzMDA4MTkzODAsDQogImh0dHA6Ly9leGFtcGxlLmNvbS9pc19yb290Ijp0cnVlfQ"

fn rfc_token() -> String =
  "eyJ0eXAiOiJKV1QiLA0KICJhbGciOiJIUzI1NiJ9." ++ rfc_claims_part()
    ++ ".dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk"

test "RFC 7519's example token verifies under its key, and its claims are the RFC's" {
  let v = verify(rfc_token(), rfc_key(), lax(), at_second(1300819379));
  assert_eq(v.header.alg, "HS256");
  assert_eq(v.header.typ, Some("JWT"));
  assert_eq(v.header.kid, None);
  assert_eq(v.claims, {
    ..claims(),
    issuer: Some("joe"),
    expires: Some(at_second(1300819380)),
    other: #{"http://example.com/is_root": json::Bool(true)},
  });
  // The token is good until its `exp` and not at it.
  assert_eq(
    try_verify(rfc_token(), rfc_key(), lax(), at_second(1300819380)),
    Err(Expired(at_second(1300819380))),
  )
}

/// The seed of RFC 8037 appendix A's Ed25519 key.
fn rfc_seed() -> Bytes / {abort.raise} = the_bytes("nWGxne_9WmC6hEr0kuwsxERJxWl7MmkZcDusAxyuf2A")

fn rfc_public() -> Bytes / {abort.raise} = the_bytes("11qYAYKxCrfVS_7TyWQHOg7hcvPapiMlrwIaaPcHURo")

fn rfc_edwards_token() -> String =
  "eyJhbGciOiJFZERTQSJ9.RXhhbXBsZSBvZiBFZDI1NTE5IHNpZ25pbmc.hgyY0il_MGCjP0JzlnLWG1PPOt7-09PGcvMg3AIbQR6dWbhijcNR4ki4iylGjg5BhVsPt9g7sVvpAr_MuM0KAg"

test "RFC 8037's Ed25519 example is what its seed signs" {
  assert_eq(
    sign_bytes(b"Example of Ed25519 signing", Ed25519Seed(secret_of_bytes(rfc_seed())), unmarked()),
    rfc_edwards_token(),
  );
  let asked = try { sign_bytes(b"x", Ed25519(rfc_public()), unmarked()) };
  assert_eq(asked, Err(CannotSign))
}

