    { range: ">1.0.0-alpha, <1.0", written: ">1.0.0-alpha, <1.0", all: [], none: ["1.0.0-beta"] },
    { range: ">1.0.0-alpha, <1", written: ">1.0.0-alpha, <1", all: [], none: ["1.0.0-beta"] },
    {
