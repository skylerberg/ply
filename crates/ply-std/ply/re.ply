//! The `re"a+b"` literal: a `std.regex` pattern over text, compiled when the program is checked.
//!
//! A tag is a module, and this one is `std.regex`'s: the type and everything done with it are
//! there. A literal's text is an interpolated string's, so a pattern's `\` is written `\\` and
//! its braces twice: `\d{2,4}` is `re"\\d{{2,4}}"`. No literal takes its text raw. A pattern that
//! is mostly `\` and braces reads better as a line string handed to `std.regex`'s `read` in a
//! `const fn`, which a build compiles once and a check refuses as it refuses a literal.

import std.regex (Regex, compile, reason)
import std.result (result_ok)

/// What a `re"..."` literal is checked by: the pattern compiled under `std.regex`'s `options()`,
/// or why it is refused and the character it is refused at.
pub fn literal(text: String) -> Result<Regex, { message: String, offset: Int }> / {abort.raise} =
  match compile(text) {
    Ok(re) -> Ok(re),
    Err(refused) -> Err({ message: reason(refused.why), offset: refused.at }),
  }

// --- Tests ------------------------------------------------------------------

test "the check answers the pattern, or why it is refused and the character it is refused at" {
  assert_eq(result_ok(literal("a+b")), result_ok(compile("a+b")));
  assert_eq(literal("a(b"), Err({ message: "this `(` has no closing `)`", offset: 1 }));
  assert_eq(
    literal("(a)\\1"),
    Err({
      message: "backreferences are not supported: matching would no longer be linear",
      offset: 3,
    }),
  );
  assert_eq(
    literal("a(?=b)"),
    Err({
      message: "lookahead and lookbehind are not supported: matching would no longer be linear",
      offset: 1,
    }),
  )
}
