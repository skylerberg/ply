//! The signals a program is sent, as an effect.
//!
//! `stopping` and `deadline_ms` say whether the service has been asked to stop, by `SIGINT` or
//! `SIGTERM`, and how long its drain has left.
//!
//! `hangup`, `user1`, `user2` and `resized` each answer whether their signal, `SIGHUP`, `SIGUSR1`,
//! `SIGUSR2` or `SIGWINCH`, has arrived since the program last asked. Asking is what installs the
//! handler: a signal no ask has named does what the platform does with it, which for the first
//! three is to end the process, so a program that reloads on a hangup asks once as it starts. The
//! first ask answers `false`. Arrivals are not counted: two hangups before an ask are one `true`,
//! so an answer says that at least one arrived. No code runs in a signal's context; a program
//! polls between its own steps, and a hangup that should be seen within a second is asked about
//! once a second.
//!
//! It is never bound under `ply test`, even with `--host` (`E0424`); a test handles the stop over
//! a `Stop` and the rest over `Arrivals`, and `over` answers all six from the pair. A signal is
//! `std.process`'s `Signal`, the one a program sends a child, so a test scripts what arrives in the
//! words a supervisor sends it in.

import std.list (push_unique, remove_first)
import std.process (Signal, Hangup, User1, User2, WindowChange)

/// The host's request to stop, and the signals a program asks about.
pub nondet effect signal {
  /// Whether the service has been asked to stop.
  read stopping() -> Bool
  /// The milliseconds the drain has left; `-1` while nobody has asked the service to stop.
  read deadline_ms() -> Int
  /// Whether a `SIGHUP` has arrived since the last ask, which daemons take as the word to read
  /// their configuration again. A write rather than a read: the ask takes the arrival.
  write hangup() -> Bool
  /// Whether a `SIGUSR1` has arrived since the last ask.
  write user1() -> Bool
  /// Whether a `SIGUSR2` has arrived since the last ask.
  write user2() -> Bool
  /// Whether a `SIGWINCH` has arrived since the last ask: the terminal changed size, and
  /// `std.term`'s `size` says to what.
  write resized() -> Bool
}

/// What a test hands the two clauses below in place of the host.
pub type Stop = { stopping: Bool, deadline_ms: Int }

/// A service nobody has asked to stop.
pub fn running() -> Stop = { stopping: false, deadline_ms: -1 }

/// A service that was asked to stop and has `ms` milliseconds of drain left.
pub fn draining(ms: Int) -> Stop = { stopping: true, deadline_ms: ms }

/// What `signal.stopping` answers over `s`.
pub fn stopping_step(s: Stop) -> Bool = s.stopping

/// What `signal.deadline_ms` answers over `s`.
pub fn deadline_step(s: Stop) -> Int = s.deadline_ms

/// Whether there is time to start work that needs `ms` milliseconds.
pub fn has_time_for(s: Stop, ms: Int) -> Bool = if s.stopping { s.deadline_ms >= ms } else { true }

/// What a test hands the four asking clauses in place of the host: the signals that have arrived
/// and not been asked about, and the ones still to come, a batch arriving just before each ask.
/// `Hangup`, `User1`, `User2` and `WindowChange` are the four an operation asks about; any other
/// a script names waits, as no ask takes it.
pub type Arrivals = { arrived: List<Signal>, later: List<List<Signal>> }

/// A twin whose batches arrive in order, one just before each ask, and nothing after the last.
pub fn arrivals(script: List<List<Signal>>) -> Arrivals = { arrived: [], later: script }

/// The twin once `which` has arrived; one already waiting to be asked about is not counted twice.
pub fn delivered(a: Arrivals, which: Signal) -> Arrivals =
  { ..a, arrived: push_unique(a.arrived, which) }

/// One ask's answer and the twin with the arrival taken.
pub type Asking = { arrivals: Arrivals, arrived: Bool }

/// What asking about `which` answers over `a`: the next batch arrives, and the answer is whether
/// `which` is among what has arrived, which the ask takes.
pub fn asked_step(a: Arrivals, which: Signal) -> Asking = {
  let now = match a.later {
    [] -> a,
    [batch, ..rest] -> { arrived: fold(batch, a.arrived, push_unique), later: rest },
  };
  match remove_first(now.arrived, which) {
    Some(left) -> { arrivals: { ..now, arrived: left }, arrived: true },
    None -> { arrivals: now, arrived: false },
  }
}

/// What `go` answered over a twin, and the arrivals it left.
pub type Over<a> = { value: a, arrivals: Arrivals }

/// `go` run with every operation answered from `stop` and `a`.
pub fn over<a | e>(
  stop: Stop,
  a: Arrivals,
  go: () -> a / {signal.read, signal.write | e},
) -> Over<a> / e =
  with_cell[signal_twin](a) { twin -> {
    let asked = |which: Signal| {
      let asking = asked_step(cell_get(twin), which);
      cell_set(twin, asking.arrivals);
      asking.arrived
    };
    let value = handle {
      go()
    } with {
      signal.stopping() -> stopping_step(stop),
      signal.deadline_ms() -> deadline_step(stop),
      signal.hangup() -> asked(Hangup),
      signal.user1() -> asked(User1),
      signal.user2() -> asked(User2),
      signal.resized() -> asked(WindowChange),
    };
    { value: value, arrivals: cell_get(twin) }
  } }

test "a running service has time for anything and a drained one for nothing" {
  assert(has_time_for(running(), 60000));
  assert(has_time_for(draining(400), 100));
  assert(!has_time_for(draining(400), 900))
}

test "a handled `signal` leaves an empty row, so a stop-aware route stays det" {
  handle {
    assert(signal.stopping());
    assert_eq(signal.deadline_ms(), 250)
  } with {
    signal.stopping() -> stopping_step(draining(250)),
    signal.deadline_ms() -> deadline_step(draining(250)),
  }
}

/// A daemon's loop: each turn it reads its configuration again if it was hung up on, and it
/// leaves when asked to stop. Answers the turn each reload happened on.
fn serve(turns: Int) -> List<Int> / {signal.hangup, signal.stopping} =
  fold(range(0, turns), [], |reloads: List<Int>, turn: Int|
    if signal.stopping() { reloads }
    else if signal.hangup() { push(reloads, turn) }
    else { reloads })

test "a hangup is seen by the ask after it, once, and two before one ask are one" {
  let ran = over(running(), arrivals([[], [Hangup], [], [Hangup, Hangup], []]), || serve(6));
  assert_eq(ran.value, [1, 3]);
  assert_eq(ran.arrivals, arrivals([]))
}

test "an ask takes its own signal and leaves the others waiting" {
  let waiting = delivered(delivered(delivered(arrivals([]), User1), WindowChange), User1);
  assert_eq(waiting.arrived, [User1, WindowChange]);
  let first = asked_step(waiting, Hangup);
  assert(!first.arrived);
  let second = asked_step(first.arrivals, WindowChange);
  assert(second.arrived);
  assert_eq(second.arrivals.arrived, [User1]);
  assert(!asked_step(second.arrivals, WindowChange).arrived);
  assert(asked_step(second.arrivals, User1).arrived)
}

test "each signal has its own operation, and a stop is read beside them" {
  let ran = over(draining(100), arrivals([[User1, User2, WindowChange]]), ||
    [signal.user1(), signal.user2(), signal.resized(), signal.hangup(), signal.stopping()]);
  assert_eq(ran.value, [true, true, true, false, true])
}
