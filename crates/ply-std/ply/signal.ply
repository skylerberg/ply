// The stop signal, as an effect.
pub nondet effect signal {
  read stopping()    -> Bool
  read deadline_ms() -> Int
}

// What a test hands the two clauses below in place of the host.
pub type Stop = { stopping: Bool, deadline_ms: Int }

// A service nobody has asked to stop.
pub fn running() -> Stop = { stopping: false, deadline_ms: -1 }

// A service that was asked to stop and has `ms` milliseconds of drain left.
pub fn draining(ms: Int) -> Stop = { stopping: true, deadline_ms: ms }

pub fn stopping_step(s: Stop) -> Bool = s.stopping

pub fn deadline_step(s: Stop) -> Int = s.deadline_ms

// Whether there is time to start work that needs `ms` milliseconds.
pub fn has_time_for(s: Stop, ms: Int) -> Bool =
  if s.stopping { s.deadline_ms >= ms } else { true }

// A shipped module's tests are the compiler's, not a project's: `ply test` in a project that
// imports this module does not select them.
test "a running service has time for anything and a drained one for nothing" {
  assert(has_time_for(running(), 60000));
  assert(has_time_for(draining(400), 100));
  assert(!has_time_for(draining(400), 900))
}

test "a handled `signal` leaves an empty row, so a stop-aware route stays det" {
  handle {
    assert(signal.stopping());
    assert_eq(signal.deadline_ms(), 250)
  } with {
    signal.stopping() -> stopping_step(draining(250)),
    signal.deadline_ms() -> deadline_step(draining(250)),
  }
}
