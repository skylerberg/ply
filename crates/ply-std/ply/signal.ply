// The stop signal, as an effect. `import std.signal (signal)` and the two
// operations below are the ones `ply_host::signal` registers against.
//
// A way to stop is ambient in every other language: a global handler, installed
// by whoever got there first, observable from nowhere in a signature. Here it is
// an effect, so a definition that consults it says so in its row and
// `ply check --types` answers "which routes shed load when the service is
// stopping" out of the type.
//
// `nondet` is load-bearing and is the same sentence `std.net` and `std.db`
// carry. Whether a stop has been requested is not a function of the program's
// state, so a `det` test that reaches either operation is E0412 at compile time,
// with `--host` and without it, and the only way to make such a test compile is
// to handle the effect — which is what `Stop` below is for.
//
// **Neither operation takes a resource**, so the atom is the singleton
// `signal.read`. Two readers never conflict, which is right: nothing a program
// does to this effect changes it, so two tests that consult it are placed in one
// concurrency group and run beside each other.
//
// **`signal` does not bind under `ply test`, with or without `--host`.** A test
// that could be ended by the suite's own ctrl-C, or that observed a stop another
// test requested, would be a test whose verdict depends on the terminal — and a
// flag set once ends every test after it, which is exactly the shared-state
// coupling this language spends its scheduling on preventing. Reaching an
// operation under `ply test` is E0424 naming this module; the remedy is to
// handle it over a `Stop`.
pub nondet effect signal {
  read stopping()    -> Bool
  read deadline_ms() -> Int
}

// What a test hands the two clauses below in place of the host.
//
// `deadline_ms` is milliseconds left in the drain and is `-1` when no stop has
// been requested — a negative number rather than an `Option` because the value
// is compared against a duration at every call site, and a program that has to
// unwrap before it can compare would write the unwrap and not the comparison.
pub type Stop = { stopping: Bool, deadline_ms: Int }

// A service nobody has asked to stop.
pub fn running() -> Stop = { stopping: false, deadline_ms: -1 }

// A service that was asked to stop and has `ms` milliseconds of drain left.
pub fn draining(ms: Int) -> Stop = { stopping: true, deadline_ms: ms }

pub fn stopping_step(s: Stop) -> Bool = s.stopping

pub fn deadline_step(s: Stop) -> Int = s.deadline_ms

// Whether there is time to start work that needs `ms` milliseconds.
//
// The reason `deadline_ms` exists at all: without it the only choice a handler
// has at a stop is to begin work it cannot finish and be cut off half way, and
// the client sees a truncated response rather than a refusal it can retry
// elsewhere. With it a route can answer 503 while the load balancer still has
// somewhere else to send the request.
pub fn has_time_for(s: Stop, ms: Int) -> Bool =
  if s.stopping { s.deadline_ms >= ms } else { true }

// A shipped module's tests are the compiler's, not a project's: `ply test` in a
// project that imports this module does not select them. `ply test --std` does.
test "a running service has time for anything and a drained one for nothing" {
  assert(has_time_for(running(), 60000));
  assert(has_time_for(draining(400), 100));
  assert(!has_time_for(draining(400), 900))
}

test "a handled `signal` leaves an empty row, so a stop-aware route stays det" {
  handle {
    assert(signal.stopping());
    assert_eq(signal.deadline_ms(), 250)
  } with {
    signal.stopping() -> stopping_step(draining(250)),
    signal.deadline_ms() -> deadline_step(draining(250)),
  }
}
