    { text: "192.0.0.11", classes: [] },
    { text: "192.0.0.170", classes: [] },
    { text: "192.0.1.0", classes: ["global"] },
    { text: "192.0.2.1", classes: ["documentation"] },
    { text: "192.31.196.1", classes: ["global"] },
    { text: "192.52.193.1", classes: ["global"] },
    { text: "192.88.99.1", classes: [] },
    { text: "192.88.99.2", classes: [] },
