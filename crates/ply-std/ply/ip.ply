/// The multicast blocks, and the blocks IANA's IPv6 address space registry marks "Reserved by
/// IETF": what the classifiers read beside the special-purpose registries.
fn unassigned_rows() -> List<(String, String)> =
  [
    ("224.0.0.0/4", "Multicast"),
    ("ff00::/8", "Multicast"),
    ("::/8", "Reserved by IETF"),
