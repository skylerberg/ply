      new: "a\nb\ne\nf\ng\nh\ni\nj\nk\nL1\nL2\nL3\nm\nn\no\np\nq\nr\ns\nt\nU\ny\nz\n",
      unified: "--- a\n+++ b\n@@ -1,7 +1,5 @@\n a\n b\n-c\n-d\n e\n f\n g\n@@ -9,7 +7,9 @@\n i\n j\n k\n-l\n+L1\n+L2\n+L3\n m\n n\n o\n@@ -18,9 +18,6 @@\n r\n s\n t\n-u\n-v\n-w\n-x\n+U\n y\n z\n",
    },
    {
      name: "an insertion with no context",
      context: 0,
      old: "a\nb\nc\nd\n",
      new: "a\nb\nX\nY\nc\nd\n",
      unified: "--- a\n+++ b\n@@ -2,0 +3,2 @@\n+X\n+Y\n",
    },
    {
      name: "a deletion with no context",
      context: 0,
      old: "a\nb\nX\nY\nc\nd\n",
      new: "a\nb\nc\nd\n",
      unified: "--- a\n+++ b\n@@ -3,2 +2,0 @@\n-X\n-Y\n",
    },
    {
      name: "an insertion at the start with no context",
      context: 0,
      old: "a\nb\n",
      new: "X\na\nb\n",
      unified: "--- a\n+++ b\n@@ -0,0 +1 @@\n+X\n",
    },
    {
      name: "a deletion at the start with no context",
      context: 0,
