//! The `strftime"%Y-%m-%d"` literal: a `std.date` pattern, checked when the program is.
//!
//! A tag is a module, and `std.date`'s own reads a date, so the pattern has this one: a directive
//! `std.date` does not have is a check error where it is written, not a wrong text at run time.
//! The type, its directives (`ply doc std.date.pattern`) and the functions that format and read by
//! one are `std.date`'s.

import std.date (Pattern, Refusal, format_date, of, pattern)

/// What a `strftime"..."` literal is checked by: the pattern `std.date`'s `pattern` reads, or why
/// the text is none and the `%` it stops being one at.
pub fn literal(text: String) -> Result<Pattern, Refusal> = pattern(text)

// --- Tests ------------------------------------------------------------------

test "the check answers the pattern, or the directive that is none" {
  let written = match ((literal("%d %b %Y"), of(2026, 10, 4))) {
    (Ok(p), Some(d)) -> format_date(p, d),
    _ -> None,
  };
  assert_eq(written, Some("04 Oct 2026"));
  assert_eq(literal("%d %Q"), Err({ message: "`%Q` is no directive", offset: 3 }))
}
