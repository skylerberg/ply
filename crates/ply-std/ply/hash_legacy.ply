//! MD5 and SHA-1, which are broken: two inputs with one digest are found for either at will.
//!
//! They are here for the protocols that still name them, such as a version 5 UUID, a one-time
//! password or an old peer, and in a module of their own so that a use of either shows in an
//! import. Neither is fit for a signature, a certificate or anything an adversary chooses the input
//! of. Each is a `std.hash` `Hash`, so `std.hash`'s streaming and `hmac_plain` take it, and the
//! runtime keys SHA-1 under a `Secret`, so `hmac`, `hkdf` and `pbkdf2` take `sha1_hash()` too;
//! HMAC over either is not known to be broken.

import std.bytes (bytes_of_hex, hex_of, repeat, u32_be, u32_le, u64_be, u64_le)
import std.float (abs)
import std.hash (Hash, Hasher, Unkeyed, any_split, digest_of, finish, hkdf_expand, hkdf_extract,
                 hmac, hmac_plain, init, md_closed, pbkdf2, update)
import std.list (all)

// --- SHA-1 ------------------------------------------------------------------------

/// SHA-1 as FIPS 180-4 defines it. Broken for collisions.
pub fn sha1_hash() -> Hash =
  {
    name: "SHA-1",
    block_size: 64,
    digest_size: 20,
    start: array_of_list([0x6745_2301, 0xEFCD_AB89, 0x98BA_DCFE, 0x1032_5476, 0xC3D2_E1F0]),
    block: sha1_block,
    finish: |h: Array<Int>, seen: Int, tail: Bytes| {
      let closed = md_closed(sha1_block, 64, h, seen, tail, u64_be((seen + bytes_len(tail)) * 8));
      bytes_concat_all(map(array_to_list(closed), u32_be))
    },
  }

fn sha1_block(h: Array<Int>, _: Int, data: Bytes, at: Int) -> Array<Int> / {abort.raise} = {
  let a = array_get(h, 0);
  let b = array_get(h, 1);
  let c = array_get(h, 2);
  let d = array_get(h, 3);
  let e = array_get(h, 4);
  sha1_rounds(h, array_new(16, 0), data, at, 0, a, b, c, d, e)
}

/// The rounds from `t` on. `w` holds the sixteen schedule words before `t`, the word for `t - 16`
/// where the one for `t` goes.
fn sha1_rounds(
  h: Array<Int>,
  w: Array<Int>,
  data: Bytes,
  at: Int,
  t: Int,
  a: Int,
  b: Int,
  c: Int,
  d: Int,
  e: Int,
) -> Array<Int> / {abort.raise} =
  if t >= 80 {
    let a = array_get(h, 0) + a & 0xFFFF_FFFF;
    let b = array_get(h, 1) + b & 0xFFFF_FFFF;
    let c = array_get(h, 2) + c & 0xFFFF_FFFF;
    let d = array_get(h, 3) + d & 0xFFFF_FFFF;
    let e = array_get(h, 4) + e & 0xFFFF_FFFF;
    array_set(array_set(array_set(array_set(array_set(h, 0, a), 1, b), 2, c), 3, d), 4, e)
  } else {
    let x = if t < 16 {
      let p = at + 4 * t;
      bytes_at(data, p) << 24 | bytes_at(data, p + 1) << 16 | bytes_at(data, p + 2) << 8
        | bytes_at(data, p + 3)
    } else {
      let mixed = array_get(w, t - 3 & 15) ^ array_get(w, t - 8 & 15) ^ array_get(w, t - 14 & 15)
        ^ array_get(w, t & 15);
      (mixed << 1 | mixed >>> 31) & 0xFFFF_FFFF
    };
    let f = if t < 20 { (d ^ b & (c ^ d)) + 0x5A82_7999 }
    else if t < 40 { (b ^ c ^ d) + 0x6ED9_EBA1 }
    else if t < 60 { (b & c | d & (b | c)) + 0x8F1B_BCDC }
    else { (b ^ c ^ d) + 0xCA62_C1D6 };
    sha1_rounds(
      h,
      array_set(w, t & 15, x),
      data,
      at,
      t + 1,
      (a << 5 | a >>> 27) + f + e + x & 0xFFFF_FFFF,
      a,
      (b << 30 | b >>> 2) & 0xFFFF_FFFF,
      c,
      d,
    )
  }

/// Twenty bytes, of SHA-1 as the standard defines it. Broken for collisions.
pub fn sha1(input: Bytes) -> Bytes / {abort.raise}
  cost bytes_len(input)
= digest_of(sha1_hash(), input)

/// HMAC-SHA-1 under a secret key, which a one-time password and an old peer still ask for.
pub fn hmac_sha1(key: Secret<Bytes>, message: Bytes) -> Bytes / {abort.raise} =
  match secret_hmac("SHA-1", key, message) {
    Some(tag) -> tag,
    None -> panic("SHA-1 is a hash the runtime keys"),
  }

// --- MD5 --------------------------------------------------------------------------

/// MD5 as RFC 1321 defines it. Broken for collisions.
pub fn md5_hash() -> Hash = {
  // The integer part of 2^32 times the sine of each of 1 to 64, which is how the RFC defines them.
  let sines = array_of_list(
    map(range(1, 65), |i: Int|
      match int_of_float(abs(sin(float_of_int(i))) * 4294967296.0, Down) {
        Some(n) -> n,
        None -> 0,
      }),
  );
  let block = |h: Array<Int>, _: Int, data: Bytes, at: Int| {
    let a = array_get(h, 0);
    let b = array_get(h, 1);
    let c = array_get(h, 2);
    let d = array_get(h, 3);
    md5_rounds(h, sines, data, at, 0, a, b, c, d)
  };
  {
    name: "MD5",
    block_size: 64,
    digest_size: 16,
    start: array_of_list([0x6745_2301, 0xEFCD_AB89, 0x98BA_DCFE, 0x1032_5476]),
    block: block,
    finish: |h: Array<Int>, seen: Int, tail: Bytes| {
      let closed = md_closed(block, 64, h, seen, tail, u64_le((seen + bytes_len(tail)) * 8));
      bytes_concat_all(map(array_to_list(closed), u32_le))
    },
  }
}

/// The steps from `i` on, sixteen a round: each round has its own function of `b`, `c` and `d`,
/// its own order through the block's words, and its own four rotations.
fn md5_rounds(
  h: Array<Int>,
  sines: Array<Int>,
  data: Bytes,
  at: Int,
  i: Int,
  a: Int,
  b: Int,
  c: Int,
  d: Int,
) -> Array<Int> / {abort.raise} =
  if i >= 64 {
    let a = array_get(h, 0) + a & 0xFFFF_FFFF;
    let b = array_get(h, 1) + b & 0xFFFF_FFFF;
    let c = array_get(h, 2) + c & 0xFFFF_FFFF;
    let d = array_get(h, 3) + d & 0xFFFF_FFFF;
    array_set(array_set(array_set(array_set(h, 0, a), 1, b), 2, c), 3, d)
  } else {
    let f = if i < 16 { d ^ b & (c ^ d) }
    else if i < 32 { c ^ d & (b ^ c) }
    else if i < 48 { b ^ c ^ d }
    else { c ^ (b | d ^ 0xFFFF_FFFF) };
    let word = if i < 16 { i }
    else if i < 32 { 5 * i + 1 & 15 }
    else if i < 48 { 3 * i + 5 & 15 }
    else { 7 * i & 15 };
    let x = a + f + array_get(sines, i) + int_of_u32(bytes_u32_le(data, at + 4 * word))
      & 0xFFFF_FFFF;
    let turn = bytes_at(
      b"\x07\x0c\x11\x16\x05\x09\x0e\x14\x04\x0b\x10\x17\x06\x0a\x0f\x15",
      (i >>> 4) * 4 + (i & 3),
    );
    md5_rounds(h, sines, data, at, i + 1, d, b + (x << turn | x >>> 32 - turn) & 0xFFFF_FFFF, b, c)
  }

/// Sixteen bytes, of MD5 as the RFC defines it. Broken for collisions.
pub fn md5(input: Bytes) -> Bytes / {abort.raise}
  cost bytes_len(input)
= digest_of(md5_hash(), input)

// --- Tests ------------------------------------------------------------------

/// One published digest.
type Digest = { message: String, input: Bytes, digest: String }

/// RFC 1321's test suite, A.5.
fn rfc_1321() -> List<Digest> / {abort.raise} =
  [
    { message: "the empty message", input: b"", digest: "d41d8cd98f00b204e9800998ecf8427e" },
    { message: "a", input: b"a", digest: "0cc175b9c0f1b6a831c399e269772661" },
    { message: "abc", input: b"abc", digest: "900150983cd24fb0d6963f7d28e17f72" },
    {
      message: "message digest",
      input: b"message digest",
      digest: "f96b697d7cb7938d525a2f31aaf161d0",
    },
    {
      message: "the alphabet",
      input: b"abcdefghijklmnopqrstuvwxyz",
      digest: "c3fcd3d76192e4007dfb496cca67e13b",
    },
    {
      message: "letters and digits",
      input: b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789",
      digest: "d174ab98d277d9f5a5611c2c9f419d9f",
    },
    {
      message: "eighty digits",
      input: b"12345678901234567890123456789012345678901234567890123456789012345678901234567890",
      digest: "57edf4a22be3c955ac49da2e2107b67a",
    },
  ]

/// FIPS 180-4's SHA-1 examples, and the empty and the million-byte messages NIST publishes beside
/// them.
fn fips_180() -> List<Digest> / {abort.raise} =
  [
    {
      message: "the empty message",
      input: b"",
      digest: "da39a3ee5e6b4b0d3255bfef95601890afd80709",
    },
    { message: "abc", input: b"abc", digest: "a9993e364706816aba3e25717850c26c9cd0d89d" },
    {
      message: "the 448-bit message",
      input: b"abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq",
      digest: "84983e441c3bd26ebaae4aa1f95129e5e54670f1",
    },
    {
      message: "the 896-bit message",
      input: b"abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu",
      digest: "a49b2446a02c645bf419f995b67091253a04a259",
    },
    {
      message: "a million a",
      input: repeat(b"a", 1000000),
      digest: "34aa973cd4c4daa4f61eeb2bdbad27316534016f",
    },
  ]

test "RFC 1321: MD5 of {v.message}" for v: Digest in rfc_1321() {
  assert_eq(hex_of(md5(v.input)), v.digest)
}

test "FIPS 180-4: SHA-1 of {v.message}" for v: Digest in fips_180() {
  assert_eq(hex_of(sha1(v.input)), v.digest)
}

test "each one-shot digest is its hash's, and as long as its hash says" {
  let input = b"the quick brown fox";
  assert_eq(md5(input), digest_of(md5_hash(), input));
  assert_eq(sha1(input), digest_of(sha1_hash(), input));
  assert_eq(bytes_len(md5(input)), md5_hash().digest_size);
  assert_eq(bytes_len(sha1(input)), sha1_hash().digest_size)
}

/// A hash and the one digest its sweep comes to.
type Sweep = { hash: String, digest: String }

/// For each hash, its digest of its own digests of the first `n` of the bytes that count up from
/// zero, for every `n` to 340, which is past five blocks, as another implementation computes it.
fn sweeps() -> List<Sweep> =
  [
    { hash: "MD5", digest: "acdad58997faecb74cd01406e0e78694" },
    { hash: "SHA-1", digest: "280cb8044538193103c9fc1a9acfe91559955151" },
  ]

// Every padding there is: a message that ends a block, one a byte short, one the length just fits.
test "{v.hash} of every length to 340 bytes, as one digest of the digests" for v: Sweep in sweeps(
  ) {
  let h = if v.hash == "MD5" { md5_hash() } else { sha1_hash() };
  let input = bytes_concat_all(map(range(0, 340), |i: Int| byte_of_int(i & 0xFF)));
  let all = fold(range(0, 341), init(h), |s: Hasher, n: Int|
    update(s, digest_of(h, bytes_slice(input, 0, n))));
  assert_eq(hex_of(finish(all)), v.digest)
}

law "MD5 of an input is one digest however it is split" = any_split(md5_hash())

law "SHA-1 of an input is one digest however it is split" = any_split(sha1_hash())

test "a split at, before and after a block's edge gives the digest of the whole" {
  let input = bytes_concat_all(map(range(0, 197), |i: Int| byte_of_int(i)));
  assert(
    all([md5_hash(), sha1_hash()], |h: Hash|
      all([1, 55, 56, 63, 64, 65, 119, 120, 128, 192, 196, 197], |cut: Int|
        any_split(h, [bytes_slice(input, 0, cut), bytes_slice(input, cut, 197)]))),
  )
}

/// One of RFC 2202's cases.
type Mac = { hash: String, case: Int, key: Bytes, data: Bytes, tag: String }

/// RFC 2202's seven cases for each of HMAC-MD5 and HMAC-SHA-1.
fn rfc_2202() -> List<Mac> / {abort.raise} =
  [
    {
      hash: "MD5",
      case: 1,
      key: repeat(b"\x0b", 16),
      data: b"Hi There",
      tag: "9294727a3638bb1c13f48ef8158bfc9d",
    },
    {
      hash: "MD5",
      case: 2,
      key: b"Jefe",
      data: b"what do ya want for nothing?",
      tag: "750c783e6ab0b503eaa86e310a5db738",
    },
    {
      hash: "MD5",
      case: 3,
      key: repeat(b"\xaa", 16),
      data: repeat(b"\xdd", 50),
      tag: "56be34521d144c88dbb8c733f0e8b3f6",
    },
    {
      hash: "MD5",
      case: 4,
      key: bytes_of_hex("0102030405060708090a0b0c0d0e0f10111213141516171819"),
      data: repeat(b"\xcd", 50),
      tag: "697eaf0aca3a3aea3a75164746ffaa79",
    },
    {
      hash: "MD5",
      case: 5,
      key: repeat(b"\x0c", 16),
      data: b"Test With Truncation",
      tag: "56461ef2342edc00f9bab995690efd4c",
    },
    {
      hash: "MD5",
      case: 6,
      key: repeat(b"\xaa", 80),
      data: b"Test Using Larger Than Block-Size Key - Hash Key First",
      tag: "6b1ab7fe4bd7bf8f0b62e6ce61b9d0cd",
    },
    {
      hash: "MD5",
      case: 7,
      key: repeat(b"\xaa", 80),
      data: b"Test Using Larger Than Block-Size Key and Larger Than One Block-Size Data",
      tag: "6f630fad67cda0ee1fb1f562db3aa53e",
    },
    {
      hash: "SHA-1",
      case: 1,
      key: repeat(b"\x0b", 20),
      data: b"Hi There",
      tag: "b617318655057264e28bc0b6fb378c8ef146be00",
    },
    {
      hash: "SHA-1",
      case: 2,
      key: b"Jefe",
      data: b"what do ya want for nothing?",
      tag: "effcdf6ae5eb2fa2d27416d5f184df9c259a7c79",
    },
    {
      hash: "SHA-1",
      case: 3,
      key: repeat(b"\xaa", 20),
      data: repeat(b"\xdd", 50),
      tag: "125d7342b9ac11cd91a39af48aa17b4f63f175d3",
    },
    {
      hash: "SHA-1",
      case: 4,
      key: bytes_of_hex("0102030405060708090a0b0c0d0e0f10111213141516171819"),
      data: repeat(b"\xcd", 50),
      tag: "4c9007f4026250c6bc8414f9bf50c86c2d7235da",
    },
    {
      hash: "SHA-1",
      case: 5,
      key: repeat(b"\x0c", 20),
      data: b"Test With Truncation",
      tag: "4c1a03424b55e07fe7f27be1d58bb9324a9a5a04",
    },
    {
      hash: "SHA-1",
      case: 6,
      key: repeat(b"\xaa", 80),
      data: b"Test Using Larger Than Block-Size Key - Hash Key First",
      tag: "aa4ae5e15272d00e95705637ce8a3b55ed402112",
    },
    {
      hash: "SHA-1",
      case: 7,
      key: repeat(b"\xaa", 80),
      data: b"Test Using Larger Than Block-Size Key and Larger Than One Block-Size Data",
      tag: "e8e99d0f45237d786d6bbaa7965c7808bbff1a91",
    },
  ]

test "RFC 2202: HMAC-{v.hash}, case {v.case}" for v: Mac in rfc_2202() {
  let h = if v.hash == "MD5" { md5_hash() } else { sha1_hash() };
  assert_eq(hex_of(hmac_plain(h, v.key, v.data)), v.tag);
  if v.hash == "SHA-1" { assert_eq(hex_of(hmac_sha1(secret_of_bytes(v.key), v.data)), v.tag) }
  else { assert_eq(try { hmac(h, secret_of_bytes(v.key), v.data) }, Err(Unkeyed("MD5"))) }
}

law "HMAC-SHA-1 under a secret key is HMAC over SHA-1 as Ply writes it"
  forall (material: Bytes, message: Bytes) {
    hmac_sha1(secret_of_bytes(material), message) == hmac_plain(sha1_hash(), material, message)
  }

/// One of RFC 5869's cases: what goes in, the pseudorandom key the first step makes of it, and the
/// output.
type Derivation = {
  case: Int,
  key: Bytes,
  salt: Bytes,
  info: Bytes,
  length: Int,
  prk: String,
  okm: String,
}

/// RFC 5869's SHA-1 cases, A.4 to A.7; the last leaves the salt out.
fn rfc_5869() -> List<Derivation> / {abort.raise} =
  [
    {
      case: 4,
      key: repeat(b"\x0b", 11),
      salt: bytes_of_hex("000102030405060708090a0b0c"),
      info: bytes_of_hex("f0f1f2f3f4f5f6f7f8f9"),
      length: 42,
      prk: "9b6c18c432a7bf8f0e71c8eb88f4b30baa2ba243",
      okm: "085a01ea1b10f36933068b56efa5ad81a4f14b822f5b091568a9cdd4f155fda2c22e422478d305f3f896",
    },
    {
      case: 5,
      key: bytes_of_hex(
        "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f",
      ),
      salt: bytes_of_hex(
        "606162636465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e7f808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9fa0a1a2a3a4a5a6a7a8a9aaabacadaeaf",
      ),
      info: bytes_of_hex(
        "b0b1b2b3b4b5b6b7b8b9babbbcbdbebfc0c1c2c3c4c5c6c7c8c9cacbcccdcecfd0d1d2d3d4d5d6d7d8d9dadbdcdddedfe0e1e2e3e4e5e6e7e8e9eaebecedeeeff0f1f2f3f4f5f6f7f8f9fafbfcfdfeff",
      ),
      length: 82,
      prk: "8adae09a2a307059478d309b26c4115a224cfaf6",
      okm: "0bd770a74d1160f7c9f12cd5912a06ebff6adcae899d92191fe4305673ba2ffe8fa3f1a4e5ad79f3f334b3b202b2173c486ea37ce3d397ed034c7f9dfeb15c5e927336d0441f4c4300e2cff0d0900b52d3b4",
    },
    {
      case: 6,
      key: repeat(b"\x0b", 22),
      salt: b"",
      info: b"",
      length: 42,
      prk: "da8c8a73c7fa77288ec6f5e7c297786aa0d32d01",
      okm: "0ac1af7002b3d761d1e55298da9d0506b9ae52057220a306e07b6b87e8df21d0ea00033de03984d34918",
    },
    {
      case: 7,
      key: repeat(b"\x0c", 22),
      salt: b"",
      info: b"",
      length: 42,
      prk: "2adccada18779e7c2077ad2eb19d3f3e731385dd",
      okm: "2c91117204d745f3500d636a62f64f0ab3bae548aa53d423b0d1f27ebba6f5e5673a081d70cce7acfc48",
    },
  ]

test "RFC 5869, case {v.case}" for v: Derivation in rfc_5869() {
  let derived = try {
    let prk = hkdf_extract(sha1_hash(), v.salt, secret_of_bytes(v.key));
    { prk: prk, okm: hkdf_expand(sha1_hash(), prk, v.info, v.length) }
  };
  assert_eq(
    derived,
    Ok({ prk: secret_of_bytes(bytes_of_hex(v.prk)), okm: secret_of_bytes(bytes_of_hex(v.okm)) }),
  )
}

/// One published PBKDF2 key.
type Stretch = { password: Bytes, salt: Bytes, iterations: Int, length: Int, key: String }

/// RFC 6070's vectors but the fourth, whose 16777216 iterations are a minute of nothing new.
fn rfc_6070() -> List<Stretch> =
  [
    {
      password: b"password",
      salt: b"salt",
      iterations: 1,
      length: 20,
      key: "0c60c80f961f0e71f3a9b524af6012062fe037a6",
    },
    {
      password: b"password",
      salt: b"salt",
      iterations: 2,
      length: 20,
      key: "ea6c014dc72d6f8ccd1ed92ace1d41f0d8de8957",
    },
    {
      password: b"password",
      salt: b"salt",
      iterations: 4096,
      length: 20,
      key: "4b007901b765489abead49d926f721d065a429c1",
    },
    {
      password: b"passwordPASSWORDpassword",
      salt: b"saltSALTsaltSALTsaltSALTsaltSALTsalt",
      iterations: 4096,
      length: 25,
      key: "3d2eec4fe41c849b80c8d83662c0e44a8b291a964cf2f07038",
    },
    {
      password: b"pass\x00word",
      salt: b"sa\x00lt",
      iterations: 4096,
      length: 16,
      key: "56fa6aa75548099dcc37d7f03425e0c3",
    },
  ]

test "RFC 6070: {v.password} and {v.salt}, {v.iterations} rounds to {v.length} bytes" for v: Stretch in rfc_6070(
  ) {
  assert_eq(
    try { pbkdf2(sha1_hash(), secret_of_bytes(v.password), v.salt, v.iterations, v.length) },
    Ok(secret_of_bytes(bytes_of_hex(v.key))),
  )
}
