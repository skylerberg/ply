//! Password hashes, as the strings a table of users stores: Argon2id and scrypt made and checked,
//! and Argon2i, Argon2d, bcrypt and PBKDF2 checked, so a store that used them can move.
//!
//! A hash string carries how it was made: the algorithm, what it costs, the salt and the tag.
//! `hash` writes one in the PHC string format, `$argon2id$v=19$m=19456,t=2,p=1$salt$tag`, under
//! sixteen bytes of salt drawn from `entropy`. `verify` reads the costs back out of the stored
//! string, has the tag computed again for the password supplied, and compares the two in time that
//! follows their length and never where they differ.
//!
//! Nothing here has a default cost. `hash` and `verify` both take the `Params` a deployment hashes
//! with, and `verify` answers `ValidNeedsRehash` for a right password under a stored hash that is
//! not what `hash` would write with them: another algorithm, another cost, another length of salt
//! or tag. That is the one moment the password is in hand, so it is when the stored hash is
//! replaced, and raising the cost is a change to one value.
//!
//! The work is the host's. Each operation of `kdf` is built to take tens of milliseconds to
//! seconds, and Argon2 and scrypt megabytes to gigabytes, so a perform runs on a thread of the
//! host's own while the program's other tasks run: as many hashes at once as the machine has
//! cores, and the rest in line behind them, each task waiting only for its own. `--host` binds
//! them. Each is a function of its arguments, so a test that reaches one under `--host` is cached
//! like any other. Lanes are filled in turn, so a hash of `p` lanes takes as long as one lane of
//! all its memory. `stand_in` answers `kdf` without the work, for a test of a sign-up or a login
//! that is not a test of a hash.
//!
//! A password is a `Secret` from where it is read to the operation that hashes it, and that
//! operation's answer is one-way in it. It is hashed as its UTF-8, byte for byte as it was given,
//! which is what every implementation read here does. A refusal says which number was out of
//! range and never what was being hashed.
//!
//! The numbers in a stored string are its writer's to choose, so `read` holds each to `bounds`
//! before anything is computed, and `verify` answers `Invalid` for a string `read` refuses. Each
//! bound is a few seconds of one core: 2 GiB of memory, which is RFC 9106's first recommended
//! option, and 1 GiB filled four times for Argon2; a gigabyte filled once for scrypt; cost 16 for
//! bcrypt; ten million iterations of PBKDF2.
//!
//! What is read: Argon2 version 19 as the reference implementation writes it; scrypt in the PHC
//! form `$scrypt$ln=17,r=8,p=1$salt$tag`, which passlib and the Rust `scrypt` crate write, and not
//! `$7$`, `$s0$` or a framework's own; bcrypt as `$2a$`, `$2b$` and `$2y$`, each read as `$2b$`,
//! whose key is the first seventy-two bytes of the password and its terminating zero, so nothing
//! of a longer password is checked; PBKDF2 under SHA-1, SHA-256 and SHA-512 as passlib writes it,
//! `$pbkdf2-sha256$29000$salt$tag`, and in the PHC form, `$pbkdf2-sha256$i=29000,l=32$salt$tag`.

import std.bytes (hex_of, int_of_ascii, u32_be)
import std.gen
import std.gen (Gen)
import std.hash (hmac_sha256, tags_match)
import std.laws (round_trip)
import std.list (unique)
import std.radix
import std.radix (Alphabet)
import std.random (entropy, rand, token_bytes, with_rand)
import std.result (result_ok)
import std.show (show)
import std.string (pad_left, repeat, replace)

/// Which Argon2: how a pass chooses the blocks it reads.
pub type Variant =
  /// By the password, which is hardest on a guesser's hardware and shows in what memory is read.
  | Argon2d
  /// By nothing secret.
  | Argon2i
  /// As `Argon2i` for the first half pass and as `Argon2d` after it: the one RFC 9106 says to use.
  | Argon2id

/// The hash PBKDF2's HMAC is under.
pub type Digest = | Sha1 | Sha256 | Sha512

/// What an Argon2 hash costs: `memory` KiB, filled `passes` times, in `lanes` lanes.
pub type Argon2Cost = new { memory: Int, passes: Int, lanes: Int }

/// What a scrypt hash costs: `2^log_n` blocks of `128 * r` bytes, mixed `p` times over.
pub type ScryptCost = new { log_n: Int, r: Int, p: Int }

/// An algorithm and what it costs.
pub type Scheme =
  /// Argon2 version 1.3, which a hash string writes `v=19`.
  | Argon2(Variant, Argon2Cost)
  /// scrypt as RFC 7914 defines it.
  | Scrypt(ScryptCost)
  /// bcrypt at this cost: `2^cost` rounds of its key schedule.
  | Bcrypt(Int)
  /// PBKDF2 under HMAC, with this many iterations.
  | Pbkdf2(Digest, Int)

/// A stored hash, read: how it was made, and the salt and the tag it holds.
pub type Stored = new { scheme: Scheme, salt: Bytes, tag: Bytes }

/// What `hash` writes: Argon2id or scrypt at a cost within `bounds`. `argon2id` and `scrypt` make
/// one, and each preset is one.
pub opaque type Params = | WithArgon2id(Argon2Cost) | WithScrypt(ScryptCost)

/// What `verify` found.
pub type Verdict =
  /// The password is the one hashed, and the stored hash is what `hash` would write.
  | Valid
  /// The password is the one hashed, and the stored hash is to be replaced with `hash` of it.
  | ValidNeedsRehash
  /// The password is not the one hashed, or the stored text is no hash `read` reads.
  | Invalid

/// The bounds a hash is held to before anything is computed.
pub type Bounds = new {
  /// The longest hash string, in bytes.
  text: Int,
  /// The most memory an Argon2 hash fills, in KiB.
  memory: Int,
  /// The most KiB an Argon2 hash fills over all its passes.
  argon2_work: Int,
  /// The most `2^log_n * r * p` of a scrypt hash, which holds its memory, `128 * r * 2^log_n`
  /// bytes, to a gigabyte.
  scrypt_work: Int,
  /// The highest cost of a bcrypt hash.
  bcrypt_cost: Int,
  /// The most iterations of PBKDF2.
  iterations: Int,
  /// The longest salt, in bytes.
  salt: Int,
  /// The longest tag, in bytes.
  tag: Int,
}

/// Why a text is no hash this module reads, or a cost is none it takes.
pub type Refusal =
  /// The text is this many bytes, more than `bounds().text`.
  | Long(Int)
  /// The text is not the fields its first field promises: a field missing or one too many, a
  /// parameter misnamed or out of order, a number that is not plain decimal, or a salt or tag
  /// that is not the base64 its form writes.
  | Malformed
  /// The first field is this, which names no algorithm read here.
  | Unknown(String)
  /// Argon2 of this version, where only 19 is read. A string with no `v=` is version 16.
  | Version(Int)
  /// Argon2's memory in KiB: under eight a lane, or over `bounds().memory`.
  | Memory(Int)
  /// Argon2's passes: under one, or so many that they fill more than `bounds().argon2_work`.
  | Passes(Int)
  /// Argon2's lanes: outside 1 to 255.
  | Lanes(Int)
  /// scrypt's cost: a `log_n`, `r` or `p` under one, or a product over `bounds().scrypt_work`.
  | ScryptWork(ScryptCost)
  /// bcrypt's cost: outside 4 to `bounds().bcrypt_cost`.
  | BcryptCost(Int)
  /// PBKDF2's iterations: outside 1 to `bounds().iterations`.
  | Iterations(Int)
  /// A salt of this many bytes: under eight for Argon2 and for a salt to hash under, other than
  /// sixteen for bcrypt, or over `bounds().salt`.
  | SaltLength(Int)
  /// A tag of this many bytes: under four, other than twenty-three for bcrypt, or over
  /// `bounds().tag`.
  | TagLength(Int)

/// What a function of this module raises where it refuses.
pub effect password {
  /// A text is no hash this module reads, or a cost is outside what it takes.
  raise refused(e: Refusal)
}

/// The functions a password is hashed with, each the host's to compute, on a thread of its own.
/// The host refuses a cost past `bounds`, which no function of this module asks for.
pub effect kdf {
  /// Argon2 version 1.3 as RFC 9106 defines it: `variant` is `argon2d`, `argon2i` or `argon2id`,
  /// `key` and `data` its secret and its associated data, either of which may be empty, `memory`
  /// in KiB, and `length` how many bytes of tag to answer.
  read argon2(variant: String, password: Secret<Bytes>, salt: Bytes, key: Secret<Bytes>, data: Bytes, memory: Int, passes: Int, lanes: Int, length: Int) -> Bytes
  /// scrypt as RFC 7914 defines it, with `N = 2^log_n`.
  read scrypt(password: Secret<Bytes>, salt: Bytes, log_n: Int, r: Int, p: Int, length: Int) -> Bytes
  /// The twenty-three bytes a bcrypt hash string holds, under a salt of sixteen. The key is the
  /// password and a terminating zero, cut to seventy-two bytes.
  read bcrypt(password: Secret<Bytes>, salt: Bytes, cost: Int) -> Bytes
  /// PBKDF2 under HMAC with the hash named `SHA-1`, `SHA-256`, `SHA-384` or `SHA-512`.
  read pbkdf2(hash: String, password: Secret<Bytes>, salt: Bytes, iterations: Int, length: Int) -> Bytes
}

gen for Params by arbitrary_params

gen for Stored by arbitrary_stored

/// The bounds every hash is held to.
pub const fn bounds() -> Bounds =
  {
    text: 512,
    memory: 1 << 21,
    argon2_work: 1 << 22,
    scrypt_work: 1 << 23,
    bcrypt_cost: 16,
    iterations: 10000000,
    salt: 64,
    tag: 64,
  }

/// The bytes of salt `hash` draws.
fn salt_bytes() -> Int = 16

/// The bytes of tag `hash` writes.
fn tag_bytes() -> Int = 32

// --- What to hash with ------------------------------------------------------

/// Argon2id filling `memory` KiB `passes` times in `lanes` lanes. Raises `Memory`, `Passes` or
/// `Lanes` for a cost Argon2 does not define or one past `bounds`.
pub fn argon2id(memory: Int, passes: Int, lanes: Int) -> Params / {password.refused} = {
  let cost: Argon2Cost = { memory: memory, passes: passes, lanes: lanes };
  held(Argon2(Argon2id, cost), salt_bytes(), tag_bytes());
  WithArgon2id(cost)
}

/// scrypt with `N = 2^log_n`, a block of `128 * r` bytes and `p` mixes. Raises `ScryptWork` for a
/// cost scrypt does not define or one past `bounds`.
pub fn scrypt(log_n: Int, r: Int, p: Int) -> Params / {password.refused} = {
  let cost: ScryptCost = { log_n: log_n, r: r, p: p };
  held(Scrypt(cost), salt_bytes(), tag_bytes());
  WithScrypt(cost)
}

/// Argon2id at 19 MiB, two passes and one lane: the least OWASP's Password Storage Cheat Sheet
/// recommended in October 2026.
pub const fn owasp_argon2id() -> Params = WithArgon2id({ memory: 19456, passes: 2, lanes: 1 })

/// Argon2id at 46 MiB, one pass and one lane: the same sheet's equal choice for a machine with
/// the memory to spare.
pub const fn owasp_argon2id_46mib() -> Params = WithArgon2id({ memory: 47104, passes: 1, lanes: 1 })

/// scrypt at `N = 2^17`, `r = 8` and `p = 1`, which fills 128 MiB: what the same sheet recommends
/// where Argon2id is not to be had.
pub const fn owasp_scrypt() -> Params = WithScrypt({ log_n: 17, r: 8, p: 1 })

/// The algorithm and cost `params` hashes with.
pub fn scheme_of(params: Params) -> Scheme =
  match params { WithArgon2id(cost) -> Argon2(Argon2id, cost), WithScrypt(cost) -> Scrypt(cost) }

// --- Hashing and verifying --------------------------------------------------

/// The hash string of `password` under `params` and sixteen bytes of salt from `entropy`.
pub fn hash(
  password: Secret<String>,
  params: Params,
) -> String / {entropy.next, kdf.argon2, kdf.scrypt, abort.raise} =
  salted(secret_bytes(password), params, token_bytes(salt_bytes()))

/// `hash` under a salt the caller names: what a test pins, and what a store that kept its salts
/// apart is moved with. Raises `SaltLength` for a salt outside 8 to 64 bytes.
pub fn hash_with_salt(
  password: Secret<String>,
  params: Params,
  salt: Bytes,
) -> String / {password.refused, kdf.argon2, kdf.scrypt, abort.raise} =
  if bytes_len(salt) < 8 || bytes_len(salt) > bounds().salt {
    password.refused(SaltLength(bytes_len(salt)))
  } else { salted(secret_bytes(password), params, salt) }

/// Whether `supplied` is the password `stored` is a hash of, and whether `stored` is what `hash`
/// writes under `params`.
///
/// The tag is computed at the stored string's own costs, whatever `params` are, and compared as
/// `std.hash`'s `tags_match` compares. A text `read` refuses is `Invalid` at no cost, which tells
/// a caller with a clock that the account holds no hash this reads; one who must not tell has a
/// hash verified either way.
pub fn verify(
  stored: String,
  supplied: Secret<String>,
  params: Params,
) -> Verdict / {kdf.argon2, kdf.scrypt, kdf.bcrypt, kdf.pbkdf2, abort.raise} =
  match parse(stored) {
    Err(_) -> Invalid,
    Ok(kept) -> {
      let tag = tag_of(kept.scheme, secret_bytes(supplied), kept.salt, bytes_len(kept.tag));
      if !tags_match(tag, kept.tag) { Invalid }
      else if written_by(kept, params) { Valid }
      else { ValidNeedsRehash }
    },
  }

/// Whether `stored` is other than what `hash` writes under `params`: another algorithm, another
/// cost, a salt that is not sixteen bytes or a tag that is not thirty-two, or no hash `read`
/// reads. What `verify` goes by, for a sweep of a table that has no passwords in hand.
pub fn needs_rehash(stored: String, params: Params) -> Bool / {abort.raise} =
  match parse(stored) { Ok(kept) -> !written_by(kept, params), Err(_) -> true }

fn written_by(kept: Stored, params: Params) -> Bool =
  kept.scheme == scheme_of(params) && bytes_len(kept.salt) == salt_bytes()
    && bytes_len(kept.tag) == tag_bytes()

fn salted(
  password: Secret<Bytes>,
  params: Params,
  salt: Bytes,
) -> String / {kdf.argon2, kdf.scrypt, abort.raise} =
  match params {
    WithArgon2id(cost) ->
      written({
        scheme: Argon2(Argon2id, cost),
        salt: salt,
        tag: argon2_tag(Argon2id, cost, password, salt, tag_bytes()),
      }),
    WithScrypt(cost) ->
      written({
        scheme: Scrypt(cost),
        salt: salt,
        tag: scrypt_tag(cost, password, salt, tag_bytes()),
      }),
  }

fn tag_of(
  scheme: Scheme,
  password: Secret<Bytes>,
  salt: Bytes,
  length: Int,
) -> Bytes / {kdf.argon2, kdf.scrypt, kdf.bcrypt, kdf.pbkdf2} =
  match scheme {
    Argon2(variant, cost) -> argon2_tag(variant, cost, password, salt, length),
    Scrypt(cost) -> scrypt_tag(cost, password, salt, length),
    Bcrypt(cost) -> kdf.bcrypt(password, salt, cost),
    Pbkdf2(digest, iterations) ->
      kdf.pbkdf2(digest_name(digest), password, salt, iterations, length),
  }

fn argon2_tag(
  variant: Variant,
  cost: Argon2Cost,
  password: Secret<Bytes>,
  salt: Bytes,
  length: Int,
) -> Bytes / {kdf.argon2} =
  kdf.argon2(
    variant_name(variant),
    password,
    salt,
    secret_of_bytes(b""),
    b"",
    cost.memory,
    cost.passes,
    cost.lanes,
    length,
  )

fn scrypt_tag(
  cost: ScryptCost,
  password: Secret<Bytes>,
  salt: Bytes,
  length: Int,
) -> Bytes / {kdf.scrypt} = kdf.scrypt(password, salt, cost.log_n, cost.r, cost.p, length)

// --- Bounds -----------------------------------------------------------------

/// Raises unless `scheme`, with a salt of `salt` bytes and a tag of `tag`, is a hash its
/// algorithm defines and `bounds` allows.
fn held(scheme: Scheme, salt: Int, tag: Int) -> Unit / {password.refused} =
  match scheme {
    Argon2(_, cost) -> {
      argon2_held(cost);
      lengths_held(salt, 8, tag)
    },
    Scrypt(cost) -> {
      scrypt_held(cost);
      lengths_held(salt, 0, tag)
    },
    Bcrypt(cost) -> if cost < 4 || cost > bounds().bcrypt_cost {
      password.refused(BcryptCost(cost))
    } else if salt != 16 { password.refused(SaltLength(salt)) }
    else if tag != 23 { password.refused(TagLength(tag)) }
    else { () },
    Pbkdf2(_, iterations) -> if iterations < 1 || iterations > bounds().iterations {
      password.refused(Iterations(iterations))
    } else { lengths_held(salt, 0, tag) },
  }

fn argon2_held(cost: Argon2Cost) -> Unit / {password.refused} =
  if cost.lanes < 1 || cost.lanes > 255 { password.refused(Lanes(cost.lanes)) }
  else if cost.memory < 8 * cost.lanes || cost.memory > bounds().memory {
    password.refused(Memory(cost.memory))
  } else if cost.passes < 1 || over(cost.memory, cost.passes, bounds().argon2_work) {
    password.refused(Passes(cost.passes))
  } else { () }

fn scrypt_held(cost: ScryptCost) -> Unit / {password.refused} =
  if cost.log_n < 1 || cost.log_n > 62 || cost.r < 1 || cost.p < 1 {
    password.refused(ScryptWork(cost))
  } else {
    let costly = match checked_mul(1 << cost.log_n, cost.r) {
      Some(blocks) -> over(blocks, cost.p, bounds().scrypt_work),
      None -> true,
    };
    if costly { password.refused(ScryptWork(cost)) } else { () }
  }

/// Whether `a * b` is more than `most`, or more than an `Int`.
fn over(a: Int, b: Int, most: Int) -> Bool =
  match checked_mul(a, b) { Some(product) -> product > most, None -> true }

fn lengths_held(salt: Int, least_salt: Int, tag: Int) -> Unit / {password.refused} =
  if salt < least_salt || salt > bounds().salt { password.refused(SaltLength(salt)) }
  else if tag < 4 || tag > bounds().tag { password.refused(TagLength(tag)) }
  else { () }

// --- Hash strings -----------------------------------------------------------

/// What `stored` holds, raising `password.refused` where `parse` answers `Err`: a text that is
/// none of the forms this module reads, or a hash past `bounds`.
pub fn read(stored: String) -> Stored / {password.refused, abort.raise} = {
  let size = bytes_len(bytes_of_string(stored));
  if size > bounds().text { password.refused(Long(size)) }
  else if !string_starts_with(stored, "$") { malformed() } else {
    let kept = fields_read(string_split(string_slice(stored, 1, string_len(stored)), "$"));
    held(kept.scheme, bytes_len(kept.salt), bytes_len(kept.tag));
    kept
  }
}

/// What `stored` holds, or why it is no hash this module reads.
pub fn parse(stored: String) -> Result<Stored, Refusal> / {abort.raise} = try { read(stored) }

/// The hash string of `stored`, which `read` reads back: Argon2 and scrypt in the PHC form,
/// bcrypt as `$2b$`, PBKDF2 as passlib writes it. A store that kept an algorithm's salt and tag
/// in columns of their own is given strings by this. Raises for a hash past `bounds`.
pub fn write(stored: Stored) -> String / {password.refused, abort.raise} = {
  held(stored.scheme, bytes_len(stored.salt), bytes_len(stored.tag));
  written(stored)
}

fn written(kept: Stored) -> String / {abort.raise} =
  match kept.scheme {
    Argon2(variant, cost) ->
      "$" ++ variant_name(variant) ++ "$v=19$m=" ++ int_to_string(cost.memory) ++ ",t="
        ++ int_to_string(cost.passes)
        ++ ",p="
        ++ int_to_string(cost.lanes)
        ++ "$"
        ++ radix::encode(phc64(), kept.salt)
        ++ "$"
        ++ radix::encode(phc64(), kept.tag),
    Scrypt(cost) ->
      "$scrypt$ln=" ++ int_to_string(cost.log_n) ++ ",r=" ++ int_to_string(cost.r) ++ ",p="
        ++ int_to_string(cost.p)
        ++ "$"
        ++ radix::encode(phc64(), kept.salt)
        ++ "$"
        ++ radix::encode(phc64(), kept.tag),
    Bcrypt(cost) ->
      "$2b$" ++ pad_left(int_to_string(cost), 2, "0") ++ "$" ++ radix::encode(crypt64(), kept.salt)
        ++ radix::encode(crypt64(), kept.tag),
    Pbkdf2(digest, iterations) ->
      "$" ++ digest_id(digest) ++ "$" ++ int_to_string(iterations) ++ "$"
        ++ replace(radix::encode(phc64(), kept.salt), "+", ".")
        ++ "$"
        ++ replace(radix::encode(phc64(), kept.tag), "+", "."),
  }

/// Base64 as a PHC string carries it: the standard alphabet, unpadded.
const fn phc64() -> Alphabet = radix::unpadded(radix::base64())

fn crypt_symbols() -> Bytes = b"./ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"

/// Base64 as bcrypt writes it: grouped as the standard one is, under an alphabet of its own.
const fn crypt64() -> Alphabet =
  match radix::alphabet(crypt_symbols(), false) { Some(a) -> a, None -> radix::base64() }

fn malformed<a>() -> a / {password.refused} = password.refused(Malformed)

fn needed<a>(found: Option<a>) -> a / {password.refused} =
  match found { Some(x) -> x, None -> malformed() }

fn variant_name(v: Variant) -> String =
  match v { Argon2d -> "argon2d", Argon2i -> "argon2i", Argon2id -> "argon2id" }

fn variant_of(id: String) -> Option<Variant> =
  if id == "argon2id" { Some(Argon2id) }
  else if id == "argon2i" { Some(Argon2i) }
  else if id == "argon2d" { Some(Argon2d) }
  else { None }

fn digest_name(d: Digest) -> String =
  match d { Sha1 -> "SHA-1", Sha256 -> "SHA-256", Sha512 -> "SHA-512" }

fn digest_id(d: Digest) -> String =
  match d { Sha1 -> "pbkdf2", Sha256 -> "pbkdf2-sha256", Sha512 -> "pbkdf2-sha512" }

fn digest_of(id: String) -> Option<Digest> =
  if id == "pbkdf2-sha256" { Some(Sha256) }
  else if id == "pbkdf2-sha512" { Some(Sha512) }
  else if id == "pbkdf2" { Some(Sha1) }
  else { None }

fn is_bcrypt(id: String) -> Bool = id == "2a" || id == "2b" || id == "2y"

/// The hash the fields after the first `$` spell, its numbers not yet held to anything.
fn fields_read(fields: List<String>) -> Stored / {password.refused, abort.raise} =
  match fields {
    [id, version, costs, salt, tag] -> match variant_of(id) {
      Some(variant) -> {
        versioned(version);
        argon2_read(variant, costs, salt, tag)
      },
      None -> stray(id),
    },
    [id, costs, salt, tag] -> four_read(id, costs, salt, tag),
    [id, cost, rest] -> if is_bcrypt(id) { bcrypt_read(cost, rest) } else { stray(id) },
    [id, _] -> stray(id),
    [id] -> stray(id),
    _ -> malformed(),
  }

/// The refusal of a first field that is here with the wrong number of fields after it, or is no
/// algorithm at all.
fn stray<a>(id: String) -> a / {password.refused} =
  if variant_of(id) != None || digest_of(id) != None || is_bcrypt(id) || id == "scrypt" {
    malformed()
  } else { password.refused(Unknown(id)) }

fn four_read(
  id: String,
  costs: String,
  salt: String,
  tag: String,
) -> Stored / {password.refused, abort.raise} =
  if id == "scrypt" {
    match numbers(costs, ["ln", "r", "p"]) {
      [log_n, r, p] ->
        { scheme: Scrypt({ log_n: log_n, r: r, p: p }), salt: unbased(salt), tag: unbased(tag) },
      _ -> malformed(),
    }
  } else {
    match digest_of(id) {
      Some(digest) -> pbkdf2_read(digest, costs, salt, tag),
      None -> if variant_of(id) != None { password.refused(Version(16)) } else { stray(id) },
    }
  }

fn versioned(field: String) -> Unit / {password.refused, abort.raise} = {
  let version = named(field, "v");
  if version == 19 { () } else { password.refused(Version(version)) }
}

fn argon2_read(
  variant: Variant,
  costs: String,
  salt: String,
  tag: String,
) -> Stored / {password.refused, abort.raise} =
  match numbers(costs, ["m", "t", "p"]) {
    [memory, passes, lanes] ->
      {
        scheme: Argon2(variant, { memory: memory, passes: passes, lanes: lanes }),
        salt: unbased(salt),
        tag: unbased(tag),
      },
    _ -> malformed(),
  }

/// PBKDF2's fields in either form: passlib's bare count and `.` for `+`, or the PHC form's
/// `i=` and an `l=` that, where it is written, is the tag's length.
fn pbkdf2_read(
  digest: Digest,
  costs: String,
  salt: String,
  tag: String,
) -> Stored / {password.refused, abort.raise} = {
  let key = unbased(replace(tag, ".", "+"));
  let iterations = if !string_contains(costs, "=") { number(costs) } else {
    match string_split(costs, ",") {
      [count] -> named(count, "i"),
      [count, length] -> if named(length, "l") == bytes_len(key) { named(count, "i") }
      else { malformed() },
      _ -> malformed(),
    }
  };
  { scheme: Pbkdf2(digest, iterations), salt: unbased(replace(salt, ".", "+")), tag: key }
}

/// bcrypt's two fields: a cost of two digits, then twenty-two symbols of salt and thirty-one of
/// tag with nothing between them.
fn bcrypt_read(cost: String, rest: String) -> Stored / {password.refused, abort.raise} = {
  let digits = bytes_of_string(cost);
  let symbols = bytes_of_string(rest);
  if bytes_len(digits) != 2 || bytes_len(symbols) != 53 { malformed() } else {
    {
      scheme: Bcrypt(needed(digits_read(digits))),
      salt: uncrypted(bytes_slice(symbols, 0, 22), 4),
      tag: uncrypted(bytes_slice(symbols, 22, 53), 2),
    }
  }
}

/// The bytes of bcrypt's base64, whatever the last symbol's `spare` low bits hold: sixteen and
/// twenty-three bytes do not fill their last symbol, and a hash made under a salt someone typed
/// has bits there that every reader of bcrypt drops.
fn uncrypted(symbols: Bytes, spare: Int) -> Bytes / {password.refused, abort.raise} = {
  let last = bytes_len(symbols) - 1;
  let value = needed(bytes_index_of_byte(crypt_symbols(), bytes_at(symbols, last)));
  let kept = value >>> spare << spare;
  needed(
    radix::decode(
      crypt64(),
      string_of_bytes(
        bytes_concat(bytes_slice(symbols, 0, last), bytes_slice(crypt_symbols(), kept, kept + 1)),
      ),
    ),
  )
}

fn unbased(text: String) -> Bytes / {password.refused, abort.raise} =
  needed(radix::decode(phc64(), text))

/// The numbers of `text`: each of `names` in turn, then `=` and a plain decimal, with commas
/// between them.
fn numbers(text: String, names: List<String>) -> List<Int> / {password.refused, abort.raise} = {
  let parts = string_split(text, ",");
  if len(parts) != len(names) { malformed() } else {
    map(range(0, len(names)), |i: Int|
      match ((list_at(parts, i), list_at(names, i))) {
        (Some(part), Some(name)) -> named(part, name),
        _ -> malformed(),
      })
  }
}

/// The number of `part`, which is `name`, `=` and a plain decimal.
fn named(part: String, name: String) -> Int / {password.refused, abort.raise} =
  if !string_starts_with(part, name ++ "=") { malformed() }
  else { number(string_slice(part, string_len(name) + 1, string_len(part))) }

/// A plain decimal: one to ten digits, and no zero ahead of another digit.
fn number(text: String) -> Int / {password.refused, abort.raise} = {
  let digits = bytes_of_string(text);
  if bytes_len(digits) > 10 || (bytes_len(digits) > 1 && bytes_at(digits, 0) == b'0') {
    malformed()
  } else { needed(digits_read(digits)) }
}

/// The number digits spell, zeros leading or not; `None` for no digits or any other byte.
fn digits_read(digits: Bytes) -> Option<Int> / {abort.raise} =
  if bytes_scan(digits, 0, b"0123456789", bytes_len(digits)) < bytes_len(digits) { None }
  else { int_of_ascii(digits) }

// --- Without the work ---------------------------------------------------------

/// `body` with every operation of `kdf` answered by a stand-in: an HMAC of what the operation was
/// handed, under the password. It takes a step where a hash takes its cost and it protects
/// nothing, so it is for tests: a sign-up, a login and a rehash run under it without `--host`.
/// A tag it answers is no algorithm's, so a hash made under it verifies under it alone.
pub fn stand_in<a | e>(
  body: () -> a / {kdf.argon2, kdf.scrypt, kdf.bcrypt, kdf.pbkdf2 | e},
) -> a / {abort.raise | e} =
  handle {
    body()
  } with {
    kdf.argon2(variant, password, salt, key, data, memory, passes, lanes, length) ->
      stood_in(
        secret_concat(password, key),
        [
          b"argon2",
          bytes_of_string(variant),
          salt,
          u32_be(secret_len(key)),
          data,
          u32_be(memory),
          u32_be(passes),
          u32_be(lanes),
        ],
        length,
      ),
    kdf.scrypt(password, salt, log_n, r, p, length) ->
      stood_in(password, [b"scrypt", salt, u32_be(log_n), u32_be(r), u32_be(p)], length),
    kdf.bcrypt(password, salt, cost) -> stood_in(password, [b"bcrypt", salt, u32_be(cost)], 23),
    kdf.pbkdf2(name, password, salt, iterations, length) ->
      stood_in(password, [b"pbkdf2", bytes_of_string(name), salt, u32_be(iterations)], length),
  }

/// `length` bytes, sixty-four at most, of HMAC-SHA-256 under `password` over `said`, each part
/// behind its length.
fn stood_in(password: Secret<Bytes>, said: List<Bytes>, length: Int) -> Bytes / {abort.raise} = {
  let message = bytes_concat_all(
    map(said, |part: Bytes| bytes_concat(u32_be(bytes_len(part)), part)),
  );
  let wide = bytes_concat(
    hmac_sha256(password, bytes_concat(message, b"\x00")),
    hmac_sha256(password, bytes_concat(message, b"\x01")),
  );
  bytes_slice(wide, 0, min(max(length, 0), bytes_len(wide)))
}

// --- Generators ---------------------------------------------------------------

/// Costs within `bounds`, small and at the bounds.
fn arbitrary_params() -> Gen<Params> =
  gen::one_of([
    gen::map(arbitrary_argon2(), |cost: Argon2Cost| WithArgon2id(cost)),
    gen::map(arbitrary_scrypt(), |cost: ScryptCost| WithScrypt(cost)),
  ])

fn arbitrary_argon2() -> Gen<Argon2Cost> =
  gen::and_then(gen::int_between(1, 255), |lanes: Int|
    gen::and_then(
      gen::one_of([gen::int_between(8 * lanes, 1 << 16), gen::constant(1 << 21)]),
      |memory: Int|
        gen::map(gen::int_between(1, min(64, (1 << 22) / memory)), |passes: Int|
          { memory: memory, passes: passes, lanes: lanes }),
    ))

fn arbitrary_scrypt() -> Gen<ScryptCost> =
  gen::and_then(gen::int_between(1, 20), |log_n: Int|
    gen::and_then(gen::int_between(1, min(16, 1 << 23 - log_n)), |r: Int|
      gen::map(gen::int_between(1, min(16, (1 << 23 - log_n) / r)), |p: Int|
        { log_n: log_n, r: r, p: p })))

/// Hashes `write` writes: every algorithm, with salts and tags of every length it takes.
fn arbitrary_stored() -> Gen<Stored> =
  gen::one_of([
    sized_stored(
      gen::map2(
        gen::elements([Argon2d, Argon2i, Argon2id]),
        arbitrary_argon2(),
        |v: Variant, cost: Argon2Cost| Argon2(v, cost),
      ),
      8,
    ),
    sized_stored(gen::map(arbitrary_scrypt(), |cost: ScryptCost| Scrypt(cost)), 0),
    gen::and_then(gen::int_between(4, 16), |cost: Int|
      gen::map2(gen::bytes_of(16), gen::bytes_of(23), |salt: Bytes, tag: Bytes|
        { scheme: Bcrypt(cost), salt: salt, tag: tag })),
    sized_stored(
      gen::map2(
        gen::elements([Sha1, Sha256, Sha512]),
        gen::int_between(1, 10000000),
        |d: Digest, n: Int| Pbkdf2(d, n),
      ),
      0,
    ),
  ])

fn sized_stored(schemes: Gen<Scheme>, least_salt: Int) -> Gen<Stored> =
  gen::and_then(schemes, |scheme: Scheme|
    gen::and_then(gen::int_between(least_salt, 64), |salt: Int|
      gen::and_then(gen::int_between(4, 64), |tag: Int|
        gen::map2(gen::bytes_of(salt), gen::bytes_of(tag), |s: Bytes, t: Bytes|
          { scheme: scheme, salt: s, tag: t }))))

// --- Tests ------------------------------------------------------------------
//
// Every test here answers `kdf` itself, because the library's tests run without `--host`: none is
// about what an algorithm computes.

/// `hash` under the stand-in, its salt drawn from the stream `root` names.
fn hashed(password: String, params: Params, root: Int) -> String / {abort.raise} =
  stand_in(|| with_rand(rand(root), || hash(secret_of_string(password), params)).value)

/// `verify` under the stand-in.
fn verified(stored: String, supplied: String, params: Params) -> Verdict / {abort.raise} =
  stand_in(|| verify(stored, secret_of_string(supplied), params))

/// The string of a hash of `scheme` that the stand-in makes of `password` under `salt`.
fn stood(scheme: Scheme, password: String, salt: Bytes, length: Int) -> String / {abort.raise} =
  written({
    scheme: scheme,
    salt: salt,
    tag: stand_in(|| tag_of(scheme, secret_bytes(secret_of_string(password)), salt, length)),
  })

/// How many times `body` performed an operation of `kdf`, each answered with no bytes.
fn performed<a>(
  body: () -> a / {kdf.argon2, kdf.scrypt, kdf.bcrypt, kdf.pbkdf2, abort.raise},
) -> Int / {abort.raise} =
  with_cell[performs](0) { c ->
    handle {
      let _answer = body();
      cell_get(c)
    } with {
      kdf.argon2(_, _, _, _, _, _, _, _, _) -> {
        cell_update(c, |n: Int| n + 1);
        b""
      },
      kdf.scrypt(_, _, _, _, _, _) -> {
        cell_update(c, |n: Int| n + 1);
        b""
      },
      kdf.bcrypt(_, _, _) -> {
        cell_update(c, |n: Int| n + 1);
        b""
      },
      kdf.pbkdf2(_, _, _, _, _) -> {
        cell_update(c, |n: Int| n + 1);
        b""
      },
    }
  }

/// An Argon2id string of `costs` over a salt of `salt` bytes and a tag of `tag`.
fn argon2_text(costs: String, salt: Int, tag: Int) -> String / {abort.raise} =
  "$argon2id$v=19$" ++ costs ++ "$" ++ radix::encode(phc64(), zeros(salt)) ++ "$"
    ++ radix::encode(phc64(), zeros(tag))

fn zeros(n: Int) -> Bytes = bytes_concat_all(map(range(0, n), |_: Int| b"\x00"))

test "a hash is a PHC string of its algorithm, its costs, its salt and its tag" {
  let secret = secret_of_string("correct horse");
  let salt = b"0123456789abcdef";
  let argon = try { stand_in(|| hash_with_salt(secret, owasp_argon2id(), salt)) };
  let scrypted = try { stand_in(|| hash_with_salt(secret, owasp_scrypt(), salt)) };
  let tag = |scheme: Scheme|
    radix::encode(phc64(), stand_in(|| tag_of(scheme, secret_bytes(secret), salt, 32)));
  assert_eq(
    argon,
    Ok(
      "$argon2id$v=19$m=19456,t=2,p=1$MDEyMzQ1Njc4OWFiY2RlZg$" ++ tag(scheme_of(owasp_argon2id())),
    ),
  );
  assert_eq(
    scrypted,
    Ok("$scrypt$ln=17,r=8,p=1$MDEyMzQ1Njc4OWFiY2RlZg$" ++ tag(scheme_of(owasp_scrypt()))),
  );
  assert_eq(string_len(tag(scheme_of(owasp_scrypt()))), 43);
  assert_eq(
    try { stand_in(|| hash_with_salt(secret, owasp_argon2id(), b"7 bytes")) },
    Err(SaltLength(7)),
  );
  assert_eq(
    try { stand_in(|| hash_with_salt(secret, owasp_argon2id(), zeros(65))) },
    Err(SaltLength(65)),
  )
}

test "a hash draws sixteen bytes of salt, so two of one password are two strings" {
  let first = hashed("correct horse", owasp_argon2id(), 1);
  let second = hashed("correct horse", owasp_argon2id(), 2);
  assert(first != second);
  assert_eq(hashed("correct horse", owasp_argon2id(), 1), first);
  assert_eq(map([first, second], |text: String| salt_length(parse(text))), [Some(16), Some(16)])
}

fn salt_length(read: Result<Stored, Refusal>) -> Option<Int> =
  match read { Ok(kept) -> Some(bytes_len(kept.salt)), Err(_) -> None }

test "a right password is valid, a wrong one is not, and neither says more" {
  let stored = hashed("correct horse", owasp_argon2id(), 7);
  assert_eq(verified(stored, "correct horse", owasp_argon2id()), Valid);
  assert_eq(verified(stored, "correct horsf", owasp_argon2id()), Invalid);
  assert_eq(verified(stored, "", owasp_argon2id()), Invalid);
  assert_eq(verified(stored, "correct horse ", owasp_argon2id()), Invalid);
  let scrypted = hashed("", owasp_scrypt(), 7);
  assert_eq(verified(scrypted, "", owasp_scrypt()), Valid);
  assert_eq(verified(scrypted, " ", owasp_scrypt()), Invalid)
}

test "a right password under a hash other params would not write wants rehashing" {
  let stored = hashed("correct horse", owasp_argon2id(), 7);
  assert_eq(verified(stored, "correct horse", owasp_argon2id_46mib()), ValidNeedsRehash);
  assert_eq(verified(stored, "correct horse", owasp_scrypt()), ValidNeedsRehash);
  assert_eq(verified(stored, "wrong", owasp_scrypt()), Invalid);
  assert_eq(needs_rehash(stored, owasp_argon2id()), false);
  assert_eq(needs_rehash(stored, owasp_argon2id_46mib()), true);
  assert_eq(needs_rehash(stored, owasp_scrypt()), true);
  assert_eq(needs_rehash("not a hash", owasp_argon2id()), true);
  assert_eq(performed(|| needs_rehash(stored, owasp_scrypt())), 0)
}

/// A hash `hash` would not write, in a form `verify` reads.
type Legacy = { name: String, scheme: Scheme, salt: Int, tag: Int }

fn legacies() -> List<Legacy> =
  [
    {
      name: "Argon2i",
      scheme: Argon2(Argon2i, { memory: 19456, passes: 2, lanes: 1 }),
      salt: 16,
      tag: 32,
    },
    {
      name: "Argon2d",
      scheme: Argon2(Argon2d, { memory: 19456, passes: 2, lanes: 1 }),
      salt: 16,
      tag: 32,
    },
    {
      name: "Argon2id under eight bytes of salt",
      scheme: scheme_of(owasp_argon2id()),
      salt: 8,
      tag: 32,
    },
    {
      name: "Argon2id with sixteen bytes of tag",
      scheme: scheme_of(owasp_argon2id()),
      salt: 16,
      tag: 16,
    },
    {
      name: "scrypt at a lower cost",
      scheme: Scrypt({ log_n: 14, r: 8, p: 1 }),
      salt: 16,
      tag: 32,
    },
    { name: "bcrypt", scheme: Bcrypt(12), salt: 16, tag: 23 },
    { name: "PBKDF2 under SHA-256", scheme: Pbkdf2(Sha256, 600000), salt: 16, tag: 32 },
    { name: "PBKDF2 under SHA-512", scheme: Pbkdf2(Sha512, 220000), salt: 16, tag: 64 },
    { name: "PBKDF2 under SHA-1", scheme: Pbkdf2(Sha1, 1400000), salt: 12, tag: 20 },
  ]

test "{c.name} verifies and wants rehashing" for c: Legacy in legacies() {
  let stored = stood(c.scheme, "correct horse", zeros(c.salt), c.tag);
  assert_eq(verified(stored, "correct horse", owasp_argon2id()), ValidNeedsRehash);
  assert_eq(verified(stored, "correct horsf", owasp_argon2id()), Invalid);
  assert_eq(needs_rehash(stored, owasp_argon2id()), true);
  assert_eq(performed(|| verify(stored, secret_of_string("any"), owasp_argon2id())), 1)
}

/// A hash string another implementation wrote, and what it holds.
type Foreign = { name: String, text: String, scheme: Scheme, salt: String, tag: String }

fn foreign() -> List<Foreign> =
  [
    {
      name: "the reference implementation's Argon2id",
      text: "$argon2id$v=19$m=65536,t=2,p=1$c29tZXNhbHQ$CTFhFdXPJO1aFaMaO6Mm5c8y7cJHAph8ArZWb2GRPPc",
      scheme: Argon2(Argon2id, { memory: 65536, passes: 2, lanes: 1 }),
      salt: "736f6d6573616c74",
      tag: "09316115d5cf24ed5a15a31a3ba326e5cf32edc24702987c02b6566f61913cf7",
    },
    {
      name: "the reference implementation's Argon2i",
      text: "$argon2i$v=19$m=65536,t=2,p=1$c29tZXNhbHQ$wWKIMhR9lyDFvRz9YTZweHKfbftvj+qf+YFY4NeBbtA",
      scheme: Argon2(Argon2i, { memory: 65536, passes: 2, lanes: 1 }),
      salt: "736f6d6573616c74",
      tag: "c1628832147d9720c5bd1cfd61367078729f6dfb6f8fea9ff98158e0d7816ed0",
    },
    {
      name: "jBCrypt's empty password",
      text: "$2a$06$DCq7YPn5Rq63x1Lad4cll.TV4S6ytwfsfvkgY8jIucDrjc8deX1s.",
      scheme: Bcrypt(6),
      salt: "144b3d691a7b4ecf39cf735c7fa7a79c",
      tag: "557e94f34bf286e8719a26be94ac1e16d95ef9f819dee0",
    },
    {
      name: "jBCrypt's alphabet",
      text: "$2a$08$aTsUwsyowQuzRrDqFflhgekJ8d9/7Z3GV3UcgvzQW3J5zMyrTvlz.",
      scheme: Bcrypt(8),
      salt: "715b96caed2ac92c354ed16c1e19e38a",
      tag: "98bf9ffc1f5be485f959e8b1d526392fbd4ed2d5719f50",
    },
  ]

test "{c.name} reads as its costs, its salt and its tag" for c: Foreign in foreign() {
  match parse(c.text) {
    Ok(kept) -> {
      assert_eq(kept.scheme, c.scheme);
      assert_eq(hex_of(kept.salt), c.salt);
      assert_eq(hex_of(kept.tag), c.tag)
    },
    Err(why) -> assert(false, Some(show(why))),
  }
}

test "bcrypt's three prefixes are one hash, written `$2b$`" {
  let rest = "$06$DCq7YPn5Rq63x1Lad4cll.TV4S6ytwfsfvkgY8jIucDrjc8deX1s.";
  let read = map(["$2a", "$2b", "$2y"], |prefix: String| parse(prefix ++ rest));
  assert_eq(list_at(read, 0), list_at(read, 1));
  assert_eq(list_at(read, 1), list_at(read, 2));
  assert_eq(
    match list_at(read, 0) { Some(Ok(kept)) -> Some(written(kept)), _ -> None },
    Some("$2b" ++ rest),
  );
  assert_eq(parse("$2x" ++ rest), Err(Unknown("2x")))
}

test "the bits a bcrypt salt or tag leaves spare in its last symbol are dropped" {
  let clean = parse("$2b$06$DCq7YPn5Rq63x1Lad4cll.TV4S6ytwfsfvkgY8jIucDrjc8deX1s.");
  assert(result_ok(clean) != None);
  assert_eq(parse("$2b$06$DCq7YPn5Rq63x1Lad4cll/TV4S6ytwfsfvkgY8jIucDrjc8deX1s."), clean);
  assert_eq(parse("$2b$06$DCq7YPn5Rq63x1Lad4cllMTV4S6ytwfsfvkgY8jIucDrjc8deX1s."), clean);
  assert_eq(parse("$2b$06$DCq7YPn5Rq63x1Lad4cll.TV4S6ytwfsfvkgY8jIucDrjc8deX1s/"), clean);
  assert(parse("$2b$06$DCq7YPn5Rq63x1Lad4cllOTV4S6ytwfsfvkgY8jIucDrjc8deX1s.") != clean)
}

test "PBKDF2 reads in passlib's form and in the PHC form, and is written in passlib's" {
  let kept: Stored = {
    scheme: Pbkdf2(Sha256, 29000),
    salt: b"\xfb\xef\xbe\x00sixteen bytes",
    tag: bytes_concat(b"\xfb\xef\xbe", zeros(29)),
  };
  let salt = "++++AHNpeHRlZW4gYnl0ZXM";
  let tag = "++++" ++ repeat("A", 39);
  let dotted = |text: String| replace(text, "+", ".");
  let passlib = "$pbkdf2-sha256$29000$" ++ dotted(salt) ++ "$" ++ dotted(tag);
  assert_eq(written(kept), passlib);
  assert_eq(parse(passlib), Ok(kept));
  assert_eq(parse("$pbkdf2-sha256$i=29000$" ++ salt ++ "$" ++ tag), Ok(kept));
  assert_eq(parse("$pbkdf2-sha256$i=29000,l=32$" ++ salt ++ "$" ++ tag), Ok(kept));
  assert_eq(parse("$pbkdf2-sha256$i=29000,l=31$" ++ salt ++ "$" ++ tag), Err(Malformed));
  assert_eq(parse("$pbkdf2-sha256$l=32,i=29000$" ++ salt ++ "$" ++ tag), Err(Malformed));
  assert_eq(
    map(["pbkdf2", "pbkdf2-sha512"], |id: String|
      match parse("$" ++ id ++ "$29000$" ++ dotted(salt) ++ "$" ++ dotted(tag)) {
        Ok(read) -> Some(read.scheme),
        Err(_) -> None,
      }),
    [Some(Pbkdf2(Sha1, 29000)), Some(Pbkdf2(Sha512, 29000))],
  )
}

/// A text that is no hash, and why.
type Refused = { name: String, text: String, why: Refusal }

fn bcrypt_rest() -> String = "DCq7YPn5Rq63x1Lad4cll.TV4S6ytwfsfvkgY8jIucDrjc8deX1s."

fn refused_texts() -> List<Refused> / {abort.raise} =
  [
    { name: "nothing", text: "", why: Malformed },
    { name: "a password in the clear", text: "correct horse", why: Malformed },
    { name: "a bare `$`", text: "$", why: Unknown("") },
    { name: "an algorithm alone", text: "$argon2id", why: Malformed },
    { name: "SHA-crypt", text: "$5$rounds=5000$salt$hash", why: Unknown("5") },
    { name: "yescrypt", text: "$y$j9T$salt$hash", why: Unknown("y") },
    { name: "scrypt's `$7$`", text: "$7$C6..../....salt$hash", why: Unknown("7") },
    {
      name: "PBKDF2 under a hash not read",
      text: "$pbkdf2-md5$1000$c2FsdA$AAAAAA",
      why: Unknown("pbkdf2-md5"),
    },
    {
      name: "Argon2 with no version",
      text: "$argon2id$m=64,t=1,p=1$AAAAAAAAAAA$AAAAAA",
      why: Version(16),
    },
    {
      name: "Argon2 version 16",
      text: "$argon2id$v=16$m=64,t=1,p=1$AAAAAAAAAAA$AAAAAA",
      why: Version(16),
    },
    {
      name: "an Argon2 version not yet made",
      text: "$argon2id$v=20$m=64,t=1,p=1$AAAAAAAAAAA$AAAAAA",
      why: Version(20),
    },
    {
      name: "Argon2 with no number for its version",
      text: "$argon2id$v=$m=64,t=1,p=1$AAAAAAAAAAA$AAAAAA",
      why: Malformed,
    },
    {
      name: "Argon2's costs out of order",
      text: argon2_text("t=1,m=64,p=1", 8, 32),
      why: Malformed,
    },
    {
      name: "a cost with a zero ahead of it",
      text: argon2_text("m=064,t=1,p=1", 8, 32),
      why: Malformed,
    },
    { name: "a cost with a sign", text: argon2_text("m=+64,t=1,p=1", 8, 32), why: Malformed },
    {
      name: "a cost of eleven digits",
      text: argon2_text("m=10000000000,t=1,p=1", 8, 32),
      why: Malformed,
    },
    { name: "a cost left out", text: argon2_text("m=64,t=1", 8, 32), why: Malformed },
    {
      name: "Argon2 with a key identifier",
      text: argon2_text("m=64,t=1,p=1,keyid=AAAA", 8, 32),
      why: Malformed,
    },
    { name: "a field too many", text: argon2_text("m=64,t=1,p=1", 8, 32) ++ "$", why: Malformed },
    {
      name: "four gigabytes of memory",
      text: argon2_text("m=4194304,t=1,p=1", 16, 32),
      why: Memory(4194304),
    },
    {
      name: "a kibibyte past two gigabytes",
      text: argon2_text("m=2097153,t=1,p=1", 16, 32),
      why: Memory(2097153),
    },
    {
      name: "memory under eight kibibytes a lane",
      text: argon2_text("m=31,t=1,p=4", 16, 32),
      why: Memory(31),
    },
    {
      name: "three passes over two gigabytes",
      text: argon2_text("m=2097152,t=3,p=1", 16, 32),
      why: Passes(3),
    },
    {
      name: "five passes over a gigabyte",
      text: argon2_text("m=1048576,t=5,p=1", 16, 32),
      why: Passes(5),
    },
    {
      name: "four billion passes",
      text: argon2_text("m=64,t=4294967295,p=1", 16, 32),
      why: Passes(4294967295),
    },
    { name: "no passes", text: argon2_text("m=64,t=0,p=1", 16, 32), why: Passes(0) },
    { name: "no lanes", text: argon2_text("m=64,t=1,p=0", 16, 32), why: Lanes(0) },
    {
      name: "more lanes than a string names",
      text: argon2_text("m=4096,t=1,p=256", 16, 32),
      why: Lanes(256),
    },
    {
      name: "Argon2 under seven bytes of salt",
      text: argon2_text("m=64,t=1,p=1", 7, 32),
      why: SaltLength(7),
    },
    {
      name: "a salt of sixty-five bytes",
      text: argon2_text("m=64,t=1,p=1", 65, 32),
      why: SaltLength(65),
    },
    { name: "a tag of three bytes", text: argon2_text("m=64,t=1,p=1", 16, 3), why: TagLength(3) },
    {
      name: "a tag of sixty-five bytes",
      text: argon2_text("m=64,t=1,p=1", 16, 65),
      why: TagLength(65),
    },
    {
      name: "a salt with bits past its last byte",
      text: "$argon2id$v=19$m=64,t=1,p=1$c29tZXNhbHR$AAAAAA",
      why: Malformed,
    },
    {
      name: "a padded salt",
      text: "$argon2id$v=19$m=64,t=1,p=1$c29tZXNhbHQ=$AAAAAA",
      why: Malformed,
    },
    {
      name: "scrypt past a gigabyte",
      text: "$scrypt$ln=21,r=8,p=1$c2FsdA$AAAAAA",
      why: ScryptWork({ log_n: 21, r: 8, p: 1 }),
    },
    {
      name: "scrypt mixed twice over a gigabyte",
      text: "$scrypt$ln=20,r=8,p=2$c2FsdA$AAAAAA",
      why: ScryptWork({ log_n: 20, r: 8, p: 2 }),
    },
    {
      name: "scrypt of one block",
      text: "$scrypt$ln=0,r=8,p=1$c2FsdA$AAAAAA",
      why: ScryptWork({ log_n: 0, r: 8, p: 1 }),
    },
    {
      name: "scrypt of `2^4000000000` blocks",
      text: "$scrypt$ln=4000000000,r=1,p=1$c2FsdA$AAAAAA",
      why: ScryptWork({ log_n: 4000000000, r: 1, p: 1 }),
    },
    {
      name: "scrypt whose costs overflow",
      text: "$scrypt$ln=62,r=4294967295,p=4294967295$c2FsdA$AAAAAA",
      why: ScryptWork({ log_n: 62, r: 4294967295, p: 4294967295 }),
    },
    {
      name: "scrypt with `N` written out",
      text: "$scrypt$n=16384,r=8,p=1$c2FsdA$AAAAAA",
      why: Malformed,
    },
    { name: "bcrypt at cost 17", text: "$2b$17$" ++ bcrypt_rest(), why: BcryptCost(17) },
    { name: "bcrypt at cost 31", text: "$2b$31$" ++ bcrypt_rest(), why: BcryptCost(31) },
    { name: "bcrypt at cost 3", text: "$2b$03$" ++ bcrypt_rest(), why: BcryptCost(3) },
    { name: "bcrypt with a cost of one digit", text: "$2b$6$" ++ bcrypt_rest(), why: Malformed },
    { name: "bcrypt with a cost of no digits", text: "$2b$1x$" ++ bcrypt_rest(), why: Malformed },
    {
      name: "bcrypt a symbol short",
      text: "$2b$06$" ++ string_slice(bcrypt_rest(), 0, 52),
      why: Malformed,
    },
    {
      name: "bcrypt with a symbol of another alphabet",
      text: "$2b$06$+" ++ string_slice(bcrypt_rest(), 1, 53),
      why: Malformed,
    },
    {
      name: "PBKDF2 past ten million iterations",
      text: "$pbkdf2-sha256$10000001$c2FsdA$AAAAAA",
      why: Iterations(10000001),
    },
    { name: "PBKDF2 of no iterations", text: "$pbkdf2-sha256$0$c2FsdA$AAAAAA", why: Iterations(0) },
    { name: "PBKDF2 with no count", text: "$pbkdf2-sha256$$c2FsdA$AAAAAA", why: Malformed },
    { name: "a text past any hash string", text: "$" ++ repeat("a", 512), why: Long(513) },
  ]

test "{c.name} is refused, and nothing is performed for it" for c: Refused in refused_texts() {
  assert_eq(parse(c.text), Err(c.why));
  assert_eq(needs_rehash(c.text, owasp_argon2id()), true);
  let asked = performed(||
    assert_eq(verify(c.text, secret_of_string("correct horse"), owasp_argon2id()), Invalid));
  assert_eq(asked, 0)
}

test "a hash at a bound is read, and verifying it performs once" {
  let at_bounds = [
    argon2_text("m=2097152,t=2,p=4", 16, 32),
    argon2_text("m=1048576,t=4,p=1", 16, 32),
    argon2_text("m=2040,t=2056,p=255", 64, 64),
    argon2_text("m=8,t=524288,p=1", 8, 4),
    "$scrypt$ln=20,r=8,p=1$$AAAAAA",
    "$scrypt$ln=1,r=1,p=4194304$c2FsdA$AAAAAA",
    "$2b$16$" ++ bcrypt_rest(),
    "$2b$04$" ++ bcrypt_rest(),
    "$pbkdf2-sha256$10000000$$AAAAAA",
  ];
  fold(at_bounds, (), |_: Unit, text: String| {
    assert(result_ok(parse(text)) != None, Some(text));
    assert_eq(performed(|| verify(text, secret_of_string("any"), owasp_argon2id())), 1)
  })
}

test "params are made within the bounds and of nothing past them" {
  assert_eq(try { argon2id(19456, 2, 1) }, Ok(owasp_argon2id()));
  assert_eq(try { argon2id(47104, 1, 1) }, Ok(owasp_argon2id_46mib()));
  assert_eq(try { scrypt(17, 8, 1) }, Ok(owasp_scrypt()));
  assert(result_ok(try { argon2id(bounds().memory, 2, 4) }) != None);
  assert(result_ok(try { scrypt(20, 8, 1) }) != None);
  assert_eq(try { argon2id(bounds().memory + 1, 1, 1) }, Err(Memory(bounds().memory + 1)));
  assert_eq(try { argon2id(bounds().memory, 3, 1) }, Err(Passes(3)));
  assert_eq(try { argon2id(7, 1, 1) }, Err(Memory(7)));
  assert_eq(try { argon2id(64, 1, 0) }, Err(Lanes(0)));
  assert_eq(try { scrypt(21, 8, 1) }, Err(ScryptWork({ log_n: 21, r: 8, p: 1 })));
  assert_eq(try { scrypt(14, 0, 1) }, Err(ScryptWork({ log_n: 14, r: 0, p: 1 })));
  assert_eq(scheme_of(owasp_argon2id()), Argon2(Argon2id, { memory: 19456, passes: 2, lanes: 1 }));
  assert_eq(scheme_of(owasp_scrypt()), Scrypt({ log_n: 17, r: 8, p: 1 }))
}

test "a hash to write is held to the bounds a hash read is" {
  let salt = zeros(16);
  assert_eq(
    try { write({ scheme: Bcrypt(12), salt: salt, tag: zeros(23) }) },
    Ok("$2b$12$" ++ repeat(".", 53)),
  );
  assert_eq(
    try { write({ scheme: Bcrypt(12), salt: zeros(15), tag: zeros(23) }) },
    Err(SaltLength(15)),
  );
  assert_eq(try { write({ scheme: Bcrypt(12), salt: salt, tag: zeros(24) }) }, Err(TagLength(24)));
  assert_eq(try { write({ scheme: Bcrypt(17), salt: salt, tag: zeros(23) }) }, Err(BcryptCost(17)));
  assert_eq(
    try { write({ scheme: Pbkdf2(Sha256, 0), salt: salt, tag: zeros(32) }) },
    Err(Iterations(0)),
  );
  assert_eq(
    try { write({ scheme: scheme_of(owasp_argon2id()), salt: zeros(7), tag: zeros(32) }) },
    Err(SaltLength(7)),
  )
}

test "the stand-in answers a function of all an operation is handed, at the length asked" {
  let secret = secret_of_bytes(b"correct horse");
  let empty = secret_of_bytes(b"");
  let argon = |variant: String, password: Secret<Bytes>, salt: Bytes, key: Secret<Bytes>, data: Bytes, memory: Int, passes: Int, lanes: Int|
    stand_in(|| kdf.argon2(variant, password, salt, key, data, memory, passes, lanes, 32));
  let base = argon("argon2id", secret, b"saltsalt", empty, b"", 64, 1, 1);
  assert_eq(argon("argon2id", secret, b"saltsalt", empty, b"", 64, 1, 1), base);
  assert_eq(bytes_len(base), 32);
  let others = [
    argon("argon2i", secret, b"saltsalt", empty, b"", 64, 1, 1),
    argon("argon2id", secret_of_bytes(b"correct horsf"), b"saltsalt", empty, b"", 64, 1, 1),
    argon("argon2id", secret, b"saltsalu", empty, b"", 64, 1, 1),
    argon("argon2id", secret, b"saltsalt", secret_of_bytes(b"k"), b"", 64, 1, 1),
    argon("argon2id", secret, b"saltsalt", empty, b"d", 64, 1, 1),
    argon("argon2id", secret, b"saltsalt", empty, b"", 65, 1, 1),
    argon("argon2id", secret, b"saltsalt", empty, b"", 64, 2, 1),
    argon("argon2id", secret, b"saltsalt", empty, b"", 64, 1, 2),
    stand_in(|| kdf.scrypt(secret, b"saltsalt", 14, 8, 1, 32)),
    stand_in(|| kdf.scrypt(secret, b"saltsalt", 15, 8, 1, 32)),
    stand_in(|| kdf.pbkdf2("SHA-256", secret, b"saltsalt", 1000, 32)),
    stand_in(|| kdf.pbkdf2("SHA-512", secret, b"saltsalt", 1000, 32)),
    stand_in(|| kdf.pbkdf2("SHA-256", secret, b"saltsalt", 1001, 32)),
  ];
  assert_eq(len(filter(others, |tag: Bytes| tag == base)), 0);
  assert_eq(len(unique(others)), len(others));
  assert_eq(bytes_len(stand_in(|| kdf.bcrypt(secret, zeros(16), 12))), 23);
  assert_eq(
    map([4, 20, 64], |length: Int|
      bytes_len(stand_in(|| kdf.scrypt(secret, b"", 14, 8, 1, length)))),
    [4, 20, 64],
  )
}

law "a hash string reads back as the hash it was written from" =
  round_trip(written, |text: String| result_ok(parse(text)))

law "a hash that is read is written as a text that reads as it"
  forall (kept: Stored, at: Int, to: Int) {
    let text = bytes_of_string(written(kept));
    let i = (at % bytes_len(text) + bytes_len(text)) % bytes_len(text);
    let altered = string_of_bytes_lossy(
      bytes_concat_all([
        bytes_slice(text, 0, i),
        byte_of_int(to & 0x7F),
        bytes_slice(text, i + 1, bytes_len(text)),
      ]),
    );
    match parse(altered) { Err(_) -> true, Ok(read) -> parse(written(read)) == Ok(read) }
  }

law "a text is read or refused, whatever follows an algorithm's name"
  forall (rest: String) {
    let heads = [
      "",
      "$",
      "$argon2id$",
      "$argon2id$v=19$",
      "$scrypt$",
      "$2b$",
      "$2b$10$",
      "$pbkdf2-sha256$",
    ];
    fold(heads, true, |ok: Bool, head: String|
      ok && (match parse(head ++ rest) { Ok(_) -> true, Err(_) -> true }))
  }

law "a hash verifies its password and no other, and is what its params write"
  forall (password: String, other: String, params: Params, root: Int) {
    let stored = hashed(password, params, root);
    verified(stored, password, params) == Valid
      && (other == password || verified(stored, other, params) == Invalid)
      && !needs_rehash(stored, params)
  }

law "a hash wants rehashing under exactly the params that would not write it"
  forall (password: String, made: Params, wanted: Params, root: Int) {
    let stored = hashed(password, made, root);
    needs_rehash(stored, wanted) == (made != wanted)
      && verified(stored, password, wanted)
      == (if made == wanted { Valid } else { ValidNeedsRehash })
  }
