// `msgpack` — MessagePack, the compact binary form of the same data JSON carries.
//
// The subset here is the one a program needs and not the whole format: nil, booleans, integers in
// every width, float64, UTF-8 text, binary, arrays and maps. MessagePack's extension types
// (`0xc7`–`0xc9`, `0xd4`–`0xd8`), `float32` (`0xca`) and the reserved `0xc1` are refused by the
// reader rather than guessed at — a `Refusal`, not a nearest value — and the writer never produces
// one.
//
// The writer chooses the shortest *signed* encoding the value fits — it never emits a
// `uint` — and one value has one encoding. The reader accepts `uint` widths, because another
// writer will use them. The
// reader is total: it refuses a truncated input, a length that claims more bytes than are left, a
// value nested past `max_depth()`, or a tag in the extension range, saying which and where. Every
// length is checked against what remains before it is walked, so a hostile header cannot make it
// loop. Inside, a refusal is the raise `msgpack.refused`, so no reader hands another's on.

import std.bytes (bytes_of_hex, hex_of, i16_be, i32_be, i64_be, u16_be, u32_be)

pub type Value =
  | Nil
  | Flag(Bool)
  | Int(Int)
  | Float(Float)
  | Text(String)
  | Bits(Bytes)
  | Items(List<Value>)
  | Fields(List<Field>)

pub type Field = { key: Value, value: Value }

pub fn field(key: Value, value: Value) -> Field = { key: key, value: value }

// --- Writing ----------------------------------------------------------------

pub fn msgpack_encode(v: Value) -> Bytes / {abort.raise} =
  match v {
    Nil -> byte_of_int(0xC0),
    Flag(b) -> if b { byte_of_int(0xC3) } else { byte_of_int(0xC2) },
    Int(n) -> int_bytes(n),
    Float(f) -> bytes_concat(byte_of_int(0xCB), i64_be(bits_of_float(f))),
    Text(s) -> with_head(text_head(bytes_len(bytes_of_string(s))), bytes_of_string(s)),
    Bits(b) -> with_head(bits_head(bytes_len(b)), b),
    Items(xs) -> with_head(items_head(len(xs)), bytes_concat_all(map(xs, msgpack_encode))),
    Fields(kvs) ->
      with_head(
        fields_head(len(kvs)),
        bytes_concat_all(
          map(kvs, |f: Field| bytes_concat(msgpack_encode(f.key), msgpack_encode(f.value))),
        ),
      ),
  }

fn with_head(head: Bytes, body: Bytes) -> Bytes = bytes_concat(head, body)

// Integers, shortest first: positive fixint, negative fixint, then int8/16/32/64.
fn int_bytes(n: Int) -> Bytes / {abort.raise} =
  if n >= 0 && n <= 127 { byte_of_int(n) }
  else if n >= 0 - 32 && n < 0 { byte_of_int(0xE0 | n & 0x1F) }
  else if n >= 0 - 128 && n <= 127 { bytes_concat(byte_of_int(0xD0), byte_of_int(n & 0xFF)) }
  else if n >= 0 - 32768 && n <= 32767 { bytes_concat(byte_of_int(0xD1), i16_be(n)) }
  else if n >= 0 - 2147483648 && n <= 2147483647 { bytes_concat(byte_of_int(0xD2), i32_be(n)) }
  else { bytes_concat(byte_of_int(0xD3), i64_be(n)) }

fn text_head(n: Int) -> Bytes / {abort.raise} =
  if n <= 31 { byte_of_int(0xA0 | n) }
  else if n <= 255 { bytes_concat(byte_of_int(0xD9), byte_of_int(n)) }
  else if n <= 65535 { bytes_concat(byte_of_int(0xDA), u16_be(n)) }
  else { bytes_concat(byte_of_int(0xDB), u32_be(n)) }

fn bits_head(n: Int) -> Bytes / {abort.raise} =
  if n <= 255 { bytes_concat(byte_of_int(0xC4), byte_of_int(n)) }
  else if n <= 65535 { bytes_concat(byte_of_int(0xC5), u16_be(n)) }
  else { bytes_concat(byte_of_int(0xC6), u32_be(n)) }

fn items_head(n: Int) -> Bytes / {abort.raise} =
  if n <= 15 { byte_of_int(0x90 | n) }
  else if n <= 65535 { bytes_concat(byte_of_int(0xDC), u16_be(n)) }
  else { bytes_concat(byte_of_int(0xDD), u32_be(n)) }

fn fields_head(n: Int) -> Bytes / {abort.raise} =
  if n <= 15 { byte_of_int(0x80 | n) }
  else if n <= 65535 { bytes_concat(byte_of_int(0xDE), u16_be(n)) }
  else { bytes_concat(byte_of_int(0xDF), u32_be(n)) }

// --- Reading ----------------------------------------------------------------

/// Why a reader refused: the input ends before a value does, a value nests past `max_depth()`, a
/// tag is not of this subset, a `uint64` is past what an `Int` holds, text is not UTF-8, or bytes
/// follow the one value.
pub type Why = | Truncated | TooDeep | Unsupported(Int) | TooWide | NotUtf8 | Trailing

/// A refusal, and the offset of the byte the reader stood at.
pub type Refusal = { at: Int, why: Why }

pub effect msgpack {
  raise refused(e: Refusal)
}

/// The value `data` holds, or why it is not exactly one value of this subset.
pub fn msgpack_decode(data: Bytes) -> Result<Value, Refusal> / {abort.raise} =
  try { msgpack_read(data) }

/// The value `data` holds, raising `msgpack.refused` where `msgpack_decode` answers `Err`.
pub fn msgpack_read(data: Bytes) -> Value / {msgpack.refused, abort.raise} = {
  let read = read_at(data, 0, max_depth());
  if read.at == bytes_len(data) { read.value } else { refuse(read.at, Trailing) }
}

fn refuse<a>(at: Int, why: Why) -> a / {msgpack.refused} = msgpack.refused({ at: at, why: why })

pub type Read = { value: Value, at: Int }

/// How deep a value may nest. A reader that recursed from the input alone could be made to walk a
/// stack it cannot hold; 64 is deeper than any message and shallower than the stack.
fn max_depth() -> Int = 64

// `room` is how many levels deeper a value may nest; each level below this one spends one.
fn read_at(data: Bytes, at: Int, room: Int) -> Read / {msgpack.refused, abort.raise} =
  if room < 0 { refuse(at, TooDeep) }
  else if at >= bytes_len(data) { refuse(at, Truncated) } else {
    let tag = bytes_at(data, at);
    if tag <= 0x7F { { value: Int(tag), at: at + 1 } }
    else if tag >= 0xE0 { { value: Int(tag - 256), at: at + 1 } }
    else if tag >= 0x80 && tag <= 0x8F { read_fields(data, at + 1, tag & 0x0F, room - 1) }
    else if tag >= 0x90 && tag <= 0x9F { read_items(data, at + 1, tag & 0x0F, room - 1) }
    else if tag >= 0xA0 && tag <= 0xBF { read_text(data, at + 1, tag & 0x1F) }
    else {
      // A table rather than a chain of comparisons: one level of nesting for twenty-odd tags, and
      // the emitter's recursion is what the depth costs.
      read_tagged(data, at, tag, room - 1)
    }
  }

fn read_tagged(data: Bytes, at: Int, tag: Int, room: Int) -> Read / {msgpack.refused, abort.raise} =
  match tag {
    0xC0 -> { value: Nil, at: at + 1 },
    0xC2 -> { value: Flag(false), at: at + 1 },
    0xC3 -> { value: Flag(true), at: at + 1 },
    0xC4 -> read_length(data, at + 1, 1, KBits, room),
    0xC5 -> read_length(data, at + 1, 2, KBits, room),
    0xC6 -> read_length(data, at + 1, 4, KBits, room),
    0xCB -> read_float(data, at),
    0xCC -> unsigned(data, at, 1, 2),
    0xCD -> unsigned(data, at, 2, 3),
    0xCE -> unsigned(data, at, 4, 5),
    0xCF -> read_uint64(data, at),
    0xD0 -> read_signed(data, at, 1, 0x80, 256),
    0xD1 -> read_signed(data, at, 2, 0x8000, 0x1_0000),
    0xD2 -> read_signed(data, at, 4, 0x8000_0000, 0x1_0000_0000),
    0xD3 -> read_int64(data, at),
    0xD9 -> read_length(data, at + 1, 1, KText, room),
    0xDA -> read_length(data, at + 1, 2, KText, room),
    0xDB -> read_length(data, at + 1, 4, KText, room),
    0xDC -> read_length(data, at + 1, 2, KItems, room),
    0xDD -> read_length(data, at + 1, 4, KItems, room),
    0xDE -> read_length(data, at + 1, 2, KFields, room),
    0xDF -> read_length(data, at + 1, 4, KFields, room),
    // `float32`, the extension types, the reserved `0xc1`, and everything above `0xdf`.
    _ -> refuse(at, Unsupported(tag)),
  }

fn read_float(data: Bytes, at: Int) -> Read / {msgpack.refused, abort.raise} =
  { value: Float(float_of_bits(be_int(read_n(data, at + 1, 8)))), at: at + 9 }

// Eight bytes are the two's complement an `Int` already is.
fn read_int64(data: Bytes, at: Int) -> Read / {msgpack.refused, abort.raise} =
  { value: Int(be_int(read_n(data, at + 1, 8))), at: at + 9 }

// A `uint64` above `i63` is not an `Int`, and answering the wrapped bits would be a lie.
fn read_uint64(data: Bytes, at: Int) -> Read / {msgpack.refused, abort.raise} = {
  let eight = read_n(data, at + 1, 8);
  if bytes_at(eight, 0) & 0x80 != 0 { refuse(at, TooWide) }
  else { { value: Int(be_int(eight)), at: at + 9 } }
}

fn read_signed(
  data: Bytes,
  at: Int,
  width: Int,
  high: Int,
  span: Int,
) -> Read / {msgpack.refused, abort.raise} =
  { value: Int(signed(be_int(read_n(data, at + 1, width)), high, span)), at: at + 1 + width }

// What a length-prefixed tag says its payload is.
type Kind = | KBits | KText | KItems | KFields

// One length-prefixed value. The length is checked against what remains *before* it is walked, so a
// header claiming four billion elements is truncation rather than four billion iterations.
fn read_length(
  data: Bytes,
  at: Int,
  width: Int,
  kind: Kind,
  room: Int,
) -> Read / {msgpack.refused, abort.raise} = {
  let n = be_int(read_n(data, at, width));
  let from = at + width;
  if n < 0 || n > bytes_len(data) - from { refuse(from, Truncated) }
  else if kind == KBits { { value: Bits(read_n(data, from, n)), at: from + n } }
  else if kind == KText { read_text(data, from, n) }
  else if kind == KItems { read_items(data, from, n, room) }
  else { read_fields(data, from, n, room) }
}

// A `uint8`/`uint16`/`uint32`, which fit an `Int` whatever their bits say.
fn unsigned(data: Bytes, at: Int, width: Int, after: Int) -> Read / {msgpack.refused, abort.raise} =
  { value: Int(be_int(read_n(data, at + 1, width))), at: at + after }

fn read_n(data: Bytes, at: Int, n: Int) -> Bytes / {msgpack.refused, abort.raise} =
  if n < 0 || at + n > bytes_len(data) { refuse(at, Truncated) }
  else { bytes_slice(data, at, at + n) }

fn read_text(data: Bytes, at: Int, n: Int) -> Read / {msgpack.refused, abort.raise} = {
  let payload = read_n(data, at, n);
  if bytes_is_utf8(payload) { { value: Text(string_of_bytes(payload)), at: at + n } }
  else { refuse(at, NotUtf8) }
}

fn read_items(data: Bytes, at: Int, n: Int, room: Int) -> Read / {msgpack.refused, abort.raise} = {
  let done = read_values(data, at, n, room, []);
  { value: Items(done.items), at: done.at }
}

fn read_values(
  data: Bytes,
  at: Int,
  n: Int,
  room: Int,
  acc: List<Value>,
) -> { items: List<Value>, at: Int } / {msgpack.refused, abort.raise} =
  if n <= 0 { { items: acc, at: at } } else {
    let read = read_at(data, at, room);
    read_values(data, read.at, n - 1, room, push(acc, read.value))
  }

fn read_fields(data: Bytes, at: Int, n: Int, room: Int) -> Read / {msgpack.refused, abort.raise} = {
  let done = read_pairs(data, at, n, room, []);
  { value: Fields(done.fields), at: done.at }
}

fn read_pairs(
  data: Bytes,
  at: Int,
  n: Int,
  room: Int,
  acc: List<Field>,
) -> { fields: List<Field>, at: Int } / {msgpack.refused, abort.raise} =
  if n <= 0 { { fields: acc, at: at } } else {
    let key = read_at(data, at, room);
    let value = read_at(data, key.at, room);
    read_pairs(data, value.at, n - 1, room, push(acc, { key: key.value, value: value.value }))
  }

// The big-endian integer a byte string names, as the `Int` its bits are.
fn be_int(data: Bytes) -> Int / {abort.raise} =
  fold(range(0, bytes_len(data)), 0, |acc: Int, i: Int| acc << 8 | bytes_at(data, i))

// A width narrower than an `Int` sign-extends from its own high bit.
fn signed(n: Int, high: Int, span: Int) -> Int = if n >= high { n - span } else { n }

// --- Tests ------------------------------------------------------------------

test "the shortest signed encoding of each width, and each reads back" {
  assert_eq(msgpack_encode(Nil), bytes_of_hex("c0"));
  assert_eq(msgpack_encode(Flag(false)), bytes_of_hex("c2"));
  assert_eq(msgpack_encode(Flag(true)), bytes_of_hex("c3"));
  assert_eq(msgpack_encode(Int(0)), bytes_of_hex("00"));
  assert_eq(msgpack_encode(Int(127)), bytes_of_hex("7f"));
  assert_eq(msgpack_encode(Int(-1)), bytes_of_hex("ff"));
  assert_eq(msgpack_encode(Int(-32)), bytes_of_hex("e0"));
  assert_eq(msgpack_encode(Int(-33)), bytes_of_hex("d0df"));
  assert_eq(msgpack_encode(Int(128)), bytes_of_hex("d10080"));
  assert_eq(msgpack_encode(Int(-32768)), bytes_of_hex("d18000"));
  assert_eq(msgpack_encode(Int(-32769)), bytes_of_hex("d2ffff7fff"));
  assert_eq(msgpack_encode(Float(1.5)), bytes_of_hex("cb3ff8000000000000"));
  assert_eq(msgpack_decode(msgpack_encode(Int(70000))), Ok(Int(70000)));
  assert_eq(msgpack_decode(msgpack_encode(Float(-0.5))), Ok(Float(-0.5)));
  assert_eq(msgpack_decode(msgpack_encode(Text("héllo"))), Ok(Text("héllo")));
  assert_eq(msgpack_decode(msgpack_encode(Bits(b"\x00\xff"))), Ok(Bits(b"\x00\xff")))
}

test "text, binary, arrays and maps round-trip, and two values are not one" {
  assert_eq(msgpack_encode(Text("hello")), bytes_of_hex("a568656c6c6f"));
  assert_eq(msgpack_encode(Bits(b"\x01\x02")), bytes_of_hex("c4020102"));
  assert_eq(msgpack_encode(Items([Int(1), Int(2)])), bytes_of_hex("920102"));
  assert_eq(msgpack_encode(Fields([field(Text("a"), Int(1))])), bytes_of_hex("81a16101"));
  let nested = Items([Int(1), Items([Flag(true)]), Fields([field(Text("k"), Bits(b"v"))])]);
  assert_eq(msgpack_decode(msgpack_encode(nested)), Ok(nested));
  // `decode` is one value: two concatenated is not a value this reader answers.
  let two = bytes_concat(msgpack_encode(Int(1)), msgpack_encode(Int(2)));
  assert_eq(msgpack_decode(two), Err({ at: 1, why: Trailing }))
}

test "a reader accepts the unsigned widths and refuses what this subset does not name" {
  assert_eq(msgpack_decode(bytes_of_hex("cc80")), Ok(Int(128)));
  assert_eq(msgpack_decode(bytes_of_hex("cd0100")), Ok(Int(256)));
  assert_eq(msgpack_decode(bytes_of_hex("ce00010000")), Ok(Int(65536)));
  let refused = |hex: String, at: Int, why: Why|
    assert_eq(msgpack_decode(bytes_of_hex(hex)), Err({ at: at, why: why }));
  // float32, an extension type, the reserved byte, a truncated string, a length past the end, a
  // `uint64` above i63, a truncated array, text that is not UTF-8, and nothing at all.
  refused("ca3fc00000", 0, Unsupported(0xCA));
  refused("c70102ff", 0, Unsupported(0xC7));
  refused("c1", 0, Unsupported(0xC1));
  refused("d90561", 2, Truncated);
  refused("db0000000561", 5, Truncated);
  refused("cfffffffffffffffff", 0, TooWide);
  refused("9201", 2, Truncated);
  refused("a1ff", 1, NotUtf8);
  refused("", 0, Truncated)
}

test "a value nested past the depth is refused where the depth ran out" {
  let nested = |levels: Int|
    bytes_concat(bytes_concat_all(map(range(0, levels), |_: Int| byte_of_int(0x91))), b"\xc0");
  assert(match msgpack_decode(nested(64)) { Ok(_) -> true, Err(_) -> false });
  assert_eq(msgpack_decode(nested(65)), Err({ at: 65, why: TooDeep }))
}

test "the raising reader raises what the other answers, and a task may perform it" {
  assert_eq(try { msgpack_read(bytes_of_hex("c1")) }, Err({ at: 0, why: Unsupported(0xC1) }));
  let read = simulate {
    let t = task.spawn(|| try { msgpack_read(bytes_of_hex("9201")) });
    task.join(t)
  };
  assert_eq(read, Err({ at: 2, why: Truncated }))
}
