//! The `semver_range">=1.2, <2"` literal: a `std.semver` range, checked when the program is.
//!
//! A tag is a module, and `std.semver`'s own reads a version, so a range has this one. The type
//! and everything done with it are `std.semver`'s.

import std.result
import std.semver (Range, parse_range, range_literal)

/// What a `semver_range"..."` literal is checked by: the range `std.semver`'s `parse_range` reads,
/// or why the text is none and the character it stops being one at.
pub fn literal(text: String) -> Result<Range, { message: String, offset: Int }> / {abort.raise} =
  range_literal(text)

// --- Tests ------------------------------------------------------------------

test "the check answers the range, or where the text stops being one" {
  assert_eq(literal(">=1.0 <2.0").ok(), parse_range(">=1.0, <2.0").ok());
  assert_eq(literal("*").ok(), Some(Range([])));
  assert_eq(literal("1.*.1"), Err({ message: "only a `*` follows a `*`", offset: 4 }));
  assert_eq(literal("1.2.3 - 2.0.0"), Err({ message: "a count goes here", offset: 6 }))
}
