//! The `datetime"2026-10-04T12:30:00"` literal: a `std.date` date-time with no zone, checked when
//! the program is.
//!
//! A tag is a module, and `std.date`'s own reads a date, so the date-time has this one. The type
//! and everything done with it are `std.date`'s.

import std.date (DateTime, Refusal, date_time, date_time_literal)
import std.result (result_ok)

/// What a `datetime"..."` literal is checked by: the date-time `std.date`'s `parse_date_time`
/// reads, or why the text is none and the character it stops being one at.
pub fn literal(text: String) -> Result<DateTime, Refusal> = date_time_literal(text)

// --- Tests ------------------------------------------------------------------

test "the check answers the date-time, or where the text stops being one" {
  assert_eq(result_ok(literal("2026-10-04T12:30:00")), date_time(2026, 10, 4, 12, 30, 0));
  assert_eq(literal("2026-10-04T12:30:00Z"), Err({ message: "nothing follows here", offset: 19 }))
}
