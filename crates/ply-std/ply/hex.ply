//! Hex as a program writes bytes down: `hex"deadbeef"` is four bytes, read when the program is
//! checked.
//!
//! The text is lower case, two digits a byte: what `std.bytes`'s `hex_of` writes, and the only
//! text `decode` and the literal read. Upper case is another alphabet, RFC 4648's base16, which
//! `std.radix` names beside this one.

import std.bytes (hex_of)
import std.laws (round_trip)
import std.radix
import std.string (ascii_lower)

/// The bytes `hex_of` wrote `text` for; `None` for any other text: an odd length, an upper-case
/// digit, or a character that is no digit.
pub fn decode(text: String) -> Option<Bytes> / {abort.raise} = radix::decode(radix::hex(), text)

/// What a `hex"..."` literal is checked by: the bytes a lower-case hex text names, or where it
/// stops being one.
pub fn literal(text: String) -> Result<Bytes, { message: String, offset: Int }> / {abort.raise} =
  match radix::parse(radix::hex(), text) {
    Ok(data) -> Ok(data),
    Err(r) ->
      Err({
        message: match r.why {
          radix::Lone -> "a byte is two hex digits, and this one has no pair",
          _ -> if upper_digit(text, r.at) { "hex is written in lower case" }
          else { "not a hex digit" },
        },
        offset: r.at,
      }),
  }

/// Whether the character at `at` is one of `A` to `F`.
fn upper_digit(text: String, at: Int) -> Bool / {abort.raise} =
  string_contains("ABCDEF", string_slice(text, at, at + 1))

// --- Tests ------------------------------------------------------------------

law "a decode of what hex_of wrote is the bytes" = round_trip(hex_of, decode)

law "RFC 4648's base16 reads back" =
  round_trip(|data: Bytes| radix::encode(radix::base16(), data), |text: String|
    radix::decode(radix::base16(), text))

type Vector = { bytes: Bytes, text: String }

/// RFC 4648, section 10: base16, which is these digits in upper case.
fn rfc_4648() -> List<Vector> =
  [
    { bytes: b"", text: "" },
    { bytes: b"f", text: "66" },
    { bytes: b"fo", text: "666F" },
    { bytes: b"foo", text: "666F6F" },
    { bytes: b"foob", text: "666F6F62" },
    { bytes: b"fooba", text: "666F6F6261" },
    { bytes: b"foobar", text: "666F6F626172" },
  ]

test "the RFC 4648 vector of {v.bytes} encodes and decodes" for v: Vector in rfc_4648() {
  assert_eq(radix::encode(radix::base16(), v.bytes), v.text);
  assert_eq(radix::decode(radix::base16(), v.text), Some(v.bytes));
  assert_eq(hex_of(v.bytes), ascii_lower(v.text));
  assert_eq(decode(ascii_lower(v.text)), Some(v.bytes))
}

test "each alphabet reads its own case and not the other's" {
  assert_eq(decode("666f"), Some(b"fo"));
  assert_eq(decode("666F"), None);
  assert_eq(radix::decode(radix::base16(), "666f"), None);
  assert_eq(decode("666"), None);
  assert_eq(decode("66 6f"), None);
  assert_eq(decode("0x66"), None)
}

test "a literal's check answers the bytes, or where the text stops being lower-case hex" {
  assert_eq(literal("deadbeef"), Ok(b"\xde\xad\xbe\xef"));
  assert_eq(literal(""), Ok(b""));
  assert_eq(literal("deadBeef"), Err({ message: "hex is written in lower case", offset: 4 }));
  assert_eq(literal("dead beef"), Err({ message: "not a hex digit", offset: 4 }));
  assert_eq(
    literal("deadbee"),
    Err({ message: "a byte is two hex digits, and this one has no pair", offset: 6 }),
  )
}
