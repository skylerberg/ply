// std.http — HTTP/1.1 framing.

import std.net (net, send_all)

// --- The message ------------------------------------------------------------

pub type Method = Get | Head | Post | Put | Patch | Delete | Options | Other(String)

pub type Version = Http10 | Http11

// Names are lowercased on parse; a name may repeat, so it maps to its field lines in order.
pub type Headers = Map<String, List<String>>

pub type Request = {
  method:    Method,
  target:    String,
  path:      String,
  query:     String,
  authority: String,
  version:   Version,
  headers:   Headers,
  trailers:  Headers,
  body:      Bytes,
}

pub type Response = { status: Int, headers: Headers, body: Bytes }

// --- Limits -----------------------------------------------------------------

pub type Limits = {
  max_request_line:  Int,
  max_header_bytes:  Int,
  max_header_count:  Int,
  max_body:          Int,
  max_chunk_size:    Int,
  max_chunk_line:    Int,
  max_trailer_bytes: Int,
  max_keep_alive:    Int,
  max_stream_chunks: Int,
  header_timeout_ms: Int,
  body_timeout_ms:   Int,
  idle_timeout_ms:   Int,
  write_timeout_ms:  Int,
  connect_timeout_ms: Int,
}

pub fn default_limits() -> Limits = {
  max_request_line:  8192,
  max_header_bytes:  65536,
  max_header_count:  100,
  max_body:          1048576,
  max_chunk_size:    1048576,
  max_chunk_line:    4096,
  max_trailer_bytes: 8192,
  max_keep_alive:    100,
  max_stream_chunks: 2048,
  header_timeout_ms: 5000,
  body_timeout_ms:   30000,
  idle_timeout_ms:   5000,
  write_timeout_ms:  30000,
  connect_timeout_ms: 5000,
}

// A non-positive limit is a configuration mistake, so it panics at `serve` naming the field.
pub fn check_limits(l: Limits) -> Unit = {
  bad_limit("max_request_line", l.max_request_line);
  bad_limit("max_header_bytes", l.max_header_bytes);
  bad_limit("max_header_count", l.max_header_count);
  bad_limit("max_body", l.max_body);
  bad_limit("max_chunk_size", l.max_chunk_size);
  bad_limit("max_chunk_line", l.max_chunk_line);
  bad_limit("max_trailer_bytes", l.max_trailer_bytes);
  bad_limit("max_keep_alive", l.max_keep_alive);
  bad_limit("max_stream_chunks", l.max_stream_chunks);
  bad_limit("header_timeout_ms", l.header_timeout_ms);
  bad_limit("body_timeout_ms", l.body_timeout_ms);
  bad_limit("idle_timeout_ms", l.idle_timeout_ms);
  bad_limit("write_timeout_ms", l.write_timeout_ms);
  bad_limit("connect_timeout_ms", l.connect_timeout_ms)
}

fn bad_limit(field: String, value: Int) -> Unit =
  if value <= 0 {
    panic("`Limits." ++ field ++ "` is " ++ int_to_string(value)
          ++ ", and every limit must be positive")
  } else {
    ()
  }

// The most `net.recv` calls one head or body is read in; a deadline is split into this many slices.
pub fn max_reads() -> Int = 2048

// The most chunks one `body_step` will decode before answering `Await`.
pub fn chunk_budget() -> Int = 512

// The most bytes one `net.recv` asks for.
pub fn read_size() -> Int = 65536

// --- Refusals ---------------------------------------------------------------

// Every framing refusal closes the connection.
pub type Refusal = { status: Int, reason: String }

// `UntilClose` is a response without a length field: a client reads it until the server closes.
pub type Framing = NoBody | Length(Int) | Chunked | UntilClose

pub type Head = {
  request:          Request,
  framing:          Framing,
  consumed:         Int,
  keep_alive:       Bool,
  expects_continue: Bool,
}

pub type HeadResult =
  | Incomplete
  | Parsed(Head)
  | Refused(Refusal)

fn refuse(status: Int, reason: String) -> HeadResult = Refused({status: status, reason: reason})

pub fn empty_headers() -> Headers = map_new()

// --- Byte classes -----------------------------------------------------------

// CR, LF, DEL and every other control byte except HTAB: what ends or is illegal in a header line.
fn line_stops() -> Bytes =
  b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f\x7f"

// RFC 9110's `tchar`. A field name and a method are tokens and nothing else.
fn tchars() -> Bytes =
  b"!#$%&'*+-.^_`|~0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"

fn digits() -> Bytes = b"0123456789"

fn hex_digits() -> Bytes = b"0123456789abcdefABCDEF"

fn ows() -> Bytes = b" \t"

fn is_token(b: Bytes) -> Bool =
  bytes_len(b) > 0 && bytes_scan(b, 0, tchars(), bytes_len(b)) == bytes_len(b)

fn all_digits(b: Bytes) -> Bool =
  bytes_len(b) > 0 && bytes_scan(b, 0, digits(), bytes_len(b)) == bytes_len(b)

// --- Lines ------------------------------------------------------------------

// A line is terminated by CRLF and by nothing else.
pub type Line =
  | LineAt({ start: Int, stop: Int, next: Int })
  | LineIncomplete
  | LineTooLong
  | LineIllegal({ at: Int, why: String })

// The scan is one byte wider than `budget`, so a terminator exactly at the bound differs from none.
fn read_line(buf: Bytes, from: Int, budget: Int) -> Line = {
  let n = bytes_len(buf);
  if from > n {
    LineIncomplete
  } else {
    let stop = bytes_scan_until(buf, from, line_stops(), budget + 1);
    if stop > from + budget {
      LineTooLong
    } else if stop >= n {
      LineIncomplete
    } else {
      line_at(buf, from, stop, n)
    }
  }
}

fn line_at(buf: Bytes, from: Int, stop: Int, n: Int) -> Line = {
  let c = bytes_at(buf, stop);
  if c == 10 {
    LineIllegal({at: stop, why: "a line ended with a bare LF; HTTP/1.1 lines end with CRLF"})
  } else if c != 13 {
    LineIllegal({at: stop, why: "a control character is not allowed in a header line"})
  } else if stop + 1 >= n {
    LineIncomplete
  } else if bytes_at(buf, stop + 1) != 10 {
    LineIllegal({at: stop, why: "a bare CR is not allowed in a header line"})
  } else {
    LineAt({start: from, stop: stop, next: stop + 2})
  }
}

// --- The head ---------------------------------------------------------------

pub fn parse_head(buf: Bytes, limits: Limits) -> HeadResult =
  match read_line(buf, 0, limits.max_request_line) {
    LineIncomplete -> Incomplete,
    LineTooLong -> refuse(414, "the request line is longer than "
                               ++ int_to_string(limits.max_request_line) ++ " bytes"),
    LineIllegal(e) -> refuse(400, e.why),
    LineAt(l) -> after_request_line(buf, limits, l),
  }

fn after_request_line(buf: Bytes, limits: Limits, l: { start: Int, stop: Int, next: Int })
  -> HeadResult =
  match request_line(bytes_slice(buf, l.start, l.stop)) {
    Err(r) -> Refused(r),
    Ok(start) ->
      match fields(buf, l.next, l.next, limits) {
        FieldsIncomplete -> Incomplete,
        FieldsRefused(r) -> Refused(r),
        FieldsDone(done) ->
          match host_of(start, done.headers) {
            Err(r) -> Refused(r),
            Ok(authority) ->
              match framing_of(done.headers, limits) {
                Err(r) -> Refused(r),
                Ok(framing) ->
                  match expect_of(done.headers) {
                    Err(r) -> Refused(r),
                    Ok(continues) -> Parsed({
                      request: {
                        method:    start.method,
                        target:    start.target,
                        path:      start.path,
                        query:     start.query,
                        authority: authority,
                        version:   start.version,
                        headers:   done.headers,
                        trailers:  empty_headers(),
                        body:      b"",
                      },
                      framing:          framing,
                      consumed:         done.next,
                      keep_alive:       keep_alive_of(start.version, done.headers),
                      expects_continue: continues,
                    }),
                  },
              },
          },
      },
  }

type Start = { method: Method, target: String, path: String, query: String,
               authority: String, version: Version }

// --- The request line -------------------------------------------------------

// HTAB is legal in a field value but not here: splitting a request line on it is a smuggle vector.
fn request_line(line: Bytes) -> Result<Start, Refusal> = {
  let n = bytes_len(line);
  let sp1 = bytes_scan_until(line, 0, b" ", n);
  if bytes_scan_until(line, 0, b"\t", n) < n {
    Err({status: 400, reason: "a request line holds no whitespace but the two spaces that split it"})
  } else if sp1 >= n {
    Err({status: 400, reason: "a request line is `METHOD SP TARGET SP VERSION`"})
  } else {
    let sp2 = bytes_scan_until(line, sp1 + 1, b" ", n - sp1 - 1);
    if sp2 >= n {
      Err({status: 400, reason: "a request line is `METHOD SP TARGET SP VERSION`"})
    } else if bytes_scan_until(line, sp2 + 1, b" ", n - sp2 - 1) < n {
      Err({status: 400, reason: "a request line holds exactly two spaces"})
    } else {
      request_parts(
        bytes_slice(line, 0, sp1),
        bytes_slice(line, sp1 + 1, sp2),
        bytes_slice(line, sp2 + 1, n))
    }
  }
}

fn request_parts(method: Bytes, target: Bytes, version: Bytes) -> Result<Start, Refusal> =
  if !is_token(method) {
    Err({status: 400, reason: "a method must be a token"})
  } else {
    let v = version_of(version)?;
    with_target(method_of(method), target, v)
  }

// A token-valid unknown method parses as `Other(name)`, and routing answers 405.
fn method_of(m: Bytes) -> Method =
  if m == b"GET" {
    Get
  } else if m == b"POST" {
    Post
  } else if m == b"HEAD" {
    Head
  } else if m == b"PUT" {
    Put
  } else if m == b"PATCH" {
    Patch
  } else if m == b"DELETE" {
    Delete
  } else if m == b"OPTIONS" {
    Options
  } else {
    Other(string_of_bytes(m))
  }

pub fn method_name(m: Method) -> String =
  match m {
    Get -> "GET",
    Head -> "HEAD",
    Post -> "POST",
    Put -> "PUT",
    Patch -> "PATCH",
    Delete -> "DELETE",
    Options -> "OPTIONS",
    Other(name) -> name,
  }

// No version is HTTP/0.9, which is not served; an unknown `HTTP/x.y` is well formed, so 505.
fn version_of(v: Bytes) -> Result<Version, Refusal> =
  if v == b"HTTP/1.1" {
    Ok(Http11)
  } else if v == b"HTTP/1.0" {
    Ok(Http10)
  } else if bytes_len(v) == 8 && bytes_starts_with(v, b"HTTP/")
            && is_digit(bytes_at(v, 5)) && bytes_at(v, 6) == 46 && is_digit(bytes_at(v, 7)) {
    Err({status: 505, reason: "this server speaks HTTP/1.1 and HTTP/1.0"})
  } else {
    Err({status: 400, reason: "a request line ends with `HTTP/1.1` or `HTTP/1.0`"})
  }

fn is_digit(c: Int) -> Bool = c >= 48 && c <= 57

fn with_target(method: Method, target: Bytes, version: Version) -> Result<Start, Refusal> =
  if bytes_len(target) == 0 {
    Err({status: 400, reason: "a request line needs a target"})
  } else if !bytes_is_utf8(target) {
    Err({status: 400, reason: "a request target must be valid UTF-8"})
  } else if bytes_scan_until(target, 0, b"#", bytes_len(target)) < bytes_len(target) {
    // At a `#`, a recipient parsing a URI reference and one that does not disagree on the target.
    Err({status: 400, reason: "a request target carries no fragment"})
  } else {
    target_form(method, target, version)
  }

// Origin-form, absolute-form, or asterisk-form and only with OPTIONS.
fn target_form(method: Method, target: Bytes, version: Version) -> Result<Start, Refusal> =
  if target == b"*" {
    match method {
      Options -> Ok(start_of(method, target, "*", "", "", version)),
      _ -> Err({status: 400, reason: "an asterisk-form target is only valid with OPTIONS"}),
    }
  } else if bytes_at(target, 0) == 47 {
    Ok(origin_form(method, target, version))
  } else {
    absolute_form(method, target, version)
  }

fn start_of(method: Method, target: Bytes, path: String, query: String, authority: String,
            version: Version) -> Start =
  {method: method, target: string_of_bytes(target), path: path, query: query,
   authority: authority, version: version}

fn origin_form(method: Method, target: Bytes, version: Version) -> Start = {
  let n = bytes_len(target);
  let q = bytes_scan_until(target, 0, b"?", n);
  start_of(method, target,
           string_of_bytes(bytes_slice(target, 0, q)),
           if q >= n { "" } else { string_of_bytes(bytes_slice(target, q + 1, n)) },
           "", version)
}

// The target's authority is the request's (RFC 9112 §3.2.2); `Host` stays visible for comparison.
fn absolute_form(method: Method, target: Bytes, version: Version) -> Result<Start, Refusal> = {
  let n = bytes_len(target);
  let after = if starts_with_ascii_ci(target, b"http://") {
    7
  } else if starts_with_ascii_ci(target, b"https://") {
    8
  } else {
    -1
  };
  if after < 0 {
    Err({status: 400, reason: "a request target must be origin-form, absolute-form, or `*`"})
  } else {
    split_authority(method, target, version, after, n)
  }
}

fn starts_with_ascii_ci(b: Bytes, want: Bytes) -> Bool =
  bytes_len(b) >= bytes_len(want) && ascii_ci_from(b, want, 0, bytes_len(want))

fn ascii_ci_from(b: Bytes, want: Bytes, i: Int, n: Int) -> Bool =
  if i >= n {
    true
  } else if lower_byte(bytes_at(b, i)) != bytes_at(want, i) {
    false
  } else {
    ascii_ci_from(b, want, i + 1, n)
  }

fn lower_byte(c: Int) -> Int = if c >= 65 && c <= 90 { c + 32 } else { c }

fn split_authority(method: Method, target: Bytes, version: Version, after: Int, n: Int)
  -> Result<Start, Refusal> = {
  let end = bytes_scan_until(target, after, b"/?", n - after);
  let authority = bytes_slice(target, after, end);
  let a = bytes_len(authority);
  if a == 0 {
    Err({status: 400, reason: "an absolute-form target needs an authority"})
  } else if bytes_scan_until(authority, 0, b"@", a) < a {
    // Refused so the authority a program compares against `Host` cannot be disguised.
    Err({status: 400, reason: "a request target's authority carries no userinfo"})
  } else {
    // The target holds no `#`, so the path always begins with `/`, which `std.router` relies on.
    let rest = bytes_slice(target, end, n);
    let m = bytes_len(rest);
    let q = bytes_scan_until(rest, 0, b"?", m);
    Ok({method: method,
        target: string_of_bytes(target),
        path: if q == 0 { "/" } else { string_of_bytes(bytes_slice(rest, 0, q)) },
        query: if q >= m { "" } else { string_of_bytes(bytes_slice(rest, q + 1, m)) },
        authority: string_of_bytes(authority),
        version: version})
  }
}

fn min_int(a: Int, b: Int) -> Int = if a < b { a } else { b }

// --- The header block -------------------------------------------------------

type FieldsBlock = { headers: Headers, count: Int, next: Int }

type FieldsResult =
  | FieldsDone(FieldsBlock)
  | FieldsIncomplete
  | FieldsRefused(Refusal)

fn fields(buf: Bytes, block_start: Int, from: Int, limits: Limits) -> FieldsResult =
  field_lines(buf, block_start, from, limits, empty_headers(), 0)

// A line's scan budget is the block's remainder, so a long line costs the bound, not the buffer.
fn field_lines(buf: Bytes, block_start: Int, from: Int, limits: Limits,
               acc: Headers, count: Int) -> FieldsResult = {
  let used = from - block_start;
  let left = limits.max_header_bytes - used;
  if left <= 0 {
    FieldsRefused(too_much_header(limits))
  } else {
    match read_line(buf, from, left) {
      LineIncomplete -> FieldsIncomplete,
      LineTooLong -> FieldsRefused(too_much_header(limits)),
      LineIllegal(e) -> FieldsRefused({status: 400, reason: e.why}),
      LineAt(l) -> field_line(buf, block_start, limits, acc, count, l),
    }
  }
}

fn too_much_header(limits: Limits) -> Refusal =
  {status: 431,
   reason: "the header block is longer than " ++ int_to_string(limits.max_header_bytes)
           ++ " bytes"}

fn field_line(buf: Bytes, block_start: Int, limits: Limits, acc: Headers, count: Int,
              l: { start: Int, stop: Int, next: Int }) -> FieldsResult =
  if l.stop == l.start {
    FieldsDone({headers: acc, count: count, next: l.next})
  } else if count >= limits.max_header_count {
    FieldsRefused({status: 431,
                   reason: "more than " ++ int_to_string(limits.max_header_count)
                           ++ " header fields"})
  } else {
    match parse_field(bytes_slice(buf, l.start, l.stop)) {
      Err(r) -> FieldsRefused(r),
      Ok(f) -> field_lines(buf, block_start, l.next, limits,
                           add_field(acc, f.name, f.value), count + 1),
    }
  }

type Field = { name: String, value: String }

fn parse_field(content: Bytes) -> Result<Field, Refusal> = {
  let n = bytes_len(content);
  let first = bytes_at(content, 0);
  if first == 32 || first == 9 {
    Err({status: 400, reason: "obsolete line folding is not accepted"})
  } else {
    let colon = bytes_scan_until(content, 0, b":", n);
    if colon >= n {
      Err({status: 400, reason: "a header field is `name: value`"})
    } else {
      named_field(content, colon, n)
    }
  }
}

fn named_field(content: Bytes, colon: Int, n: Int) -> Result<Field, Refusal> = {
  let raw = bytes_slice(content, 0, colon);
  if colon > 0 && (bytes_at(content, colon - 1) == 32 || bytes_at(content, colon - 1) == 9) {
    // `Foo : bar` is read as `Foo` by one implementation and dropped by another.
    Err({status: 400, reason: "whitespace between a field name and its colon"})
  } else if !is_token(raw) {
    Err({status: 400, reason: "a field name must be a token"})
  } else {
    field_value(string_lower(string_of_bytes(raw)), trim_ows(content, colon + 1, n))
  }
}

fn field_value(name: String, value: Bytes) -> Result<Field, Refusal> =
  // The line scan already refused control bytes, so only non-text is left to refuse.
  if !bytes_is_utf8(value) {
    Err({status: 400, reason: "the value of `" ++ name ++ "` is not valid UTF-8"})
  } else {
    Ok({name: name, value: string_of_bytes(value)})
  }

fn trim_ows(content: Bytes, from: Int, to: Int) -> Bytes = {
  let start = bytes_scan(content, from, ows(), to - from);
  bytes_slice(content, start, trim_end(content, start, to))
}

fn trim_end(content: Bytes, start: Int, to: Int) -> Int =
  if to <= start {
    start
  } else if bytes_at(content, to - 1) == 32 || bytes_at(content, to - 1) == 9 {
    trim_end(content, start, to - 1)
  } else {
    to
  }

fn add_field(h: Headers, name: String, value: String) -> Headers =
  match map_get(h, name) {
    None -> map_insert(h, name, [value]),
    Some(vs) -> map_insert(h, name, push(vs, value)),
  }

// --- Reading a header -------------------------------------------------------

// Every field line under this name, in order of appearance.
pub fn header_lines(h: Headers, name: String) -> List<String> =
  match map_get(h, name) {
    Some(vs) -> vs,
    None -> [],
  }

pub fn header(h: Headers, name: String) -> Option<String> =
  match map_get(h, name) {
    Some([v, ..]) -> Some(v),
    _ -> None,
  }

pub fn has_header(h: Headers, name: String) -> Bool = map_contains(h, name)

pub fn set_header(h: Headers, name: String, value: String) -> Headers =
  map_insert(h, string_lower(name), [value])

pub fn add_header(h: Headers, name: String, value: String) -> Headers =
  add_field(h, string_lower(name), value)

// A comma-separated list field, split, trimmed and lowercased.
fn list_field(h: Headers, name: String) -> List<String> =
  fold(header_lines(h, name), [], |acc: List<String>, line: String|
    fold(string_split(line, ","), acc, |inner: List<String>, part: String|
      push(inner, string_lower(string_trim(part)))))

// --- Host -------------------------------------------------------------------

// An HTTP/1.1 request needs exactly one `Host`.
fn host_of(start: Start, h: Headers) -> Result<String, Refusal> = {
  let lines = header_lines(h, "host");
  if len(lines) > 1 {
    Err({status: 400, reason: "a request carries at most one `Host` field"})
  } else if string_len(start.authority) > 0 {
    Ok(start.authority)
  } else {
    match lines {
      [only] -> Ok(only),
      _ -> match start.version {
        Http11 -> Err({status: 400, reason: "an HTTP/1.1 request must carry a `Host` field"}),
        Http10 -> Ok(""),
      },
    }
  }
}

// --- Framing ----------------------------------------------------------------

// Where RFC 9112 §6 permits a choice, this refuses.
fn framing_of(h: Headers, limits: Limits) -> Result<Framing, Refusal> = {
  let cl = header_lines(h, "content-length");
  let te = header_lines(h, "transfer-encoding");
  if len(cl) > 0 && len(te) > 0 {
    Err({status: 400,
         reason: "a request carries `Content-Length` or `Transfer-Encoding`, never both"})
  } else if len(te) > 0 {
    chunked_of(list_field(h, "transfer-encoding"))
  } else if len(cl) > 1 {
    Err({status: 400,
         reason: "a request carries at most one `Content-Length` field line"})
  } else {
    match cl {
      [only] -> length_of(only, limits),
      _ -> Ok(NoBody),
    }
  }
}

// A coding list not ending in `chunked` has no decidable length (400); any other coding is 501.
fn chunked_of(codings: List<String>) -> Result<Framing, Refusal> =
  if !contains_string(codings, "chunked") {
    Err({status: 501, reason: "the only transfer coding this server decodes is `chunked`"})
  } else if count_string(codings, "chunked") > 1 {
    Err({status: 400, reason: "`chunked` may be applied at most once"})
  } else if last_string(codings) != "chunked" {
    Err({status: 400,
         reason: "`chunked` must be the final transfer coding, or the message length is undecidable"})
  } else if len(codings) > 1 {
    Err({status: 501, reason: "the only transfer coding this server decodes is `chunked`"})
  } else {
    Ok(Chunked)
  }

fn contains_string(xs: List<String>, want: String) -> Bool =
  fold(xs, false, |acc: Bool, x: String| acc || x == want)

fn count_string(xs: List<String>, want: String) -> Int =
  fold(xs, 0, |acc: Int, x: String| if x == want { acc + 1 } else { acc })

fn last_string(xs: List<String>) -> String = fold(xs, "", |prev: String, x: String| x)

// ASCII digits only: no sign, whitespace or `0x`, and a comma makes it a list rather than a length.
fn length_of(raw: String, limits: Limits) -> Result<Framing, Refusal> = {
  let b = bytes_of_string(raw);
  if !all_digits(b) {
    Err({status: 400, reason: "a `Content-Length` is one or more ASCII digits"})
  } else if bytes_len(b) > 18 || digits_to_int(b, 0, 0) > limits.max_body {
    Err({status: 413,
         reason: "the body is longer than " ++ int_to_string(limits.max_body) ++ " bytes"})
  } else {
    Ok(Length(digits_to_int(b, 0, 0)))
  }
}

// At most 18 digits by the guard above, so this cannot overflow.
fn digits_to_int(b: Bytes, i: Int, acc: Int) -> Int =
  if i >= bytes_len(b) { acc } else { digits_to_int(b, i + 1, acc * 10 + (bytes_at(b, i) - 48)) }

// --- Expect and Connection --------------------------------------------------

// A client waiting for a `100` it never gets hangs, so any other expectation is 417.
fn expect_of(h: Headers) -> Result<Bool, Refusal> = {
  let lines = header_lines(h, "expect");
  if len(lines) == 0 {
    Ok(false)
  } else if len(lines) == 1 && string_lower(string_trim(first_string(lines))) == "100-continue" {
    Ok(true)
  } else {
    Err({status: 417, reason: "the only `Expect` this server implements is `100-continue`"})
  }
}

fn first_string(xs: List<String>) -> String =
  match xs {
    [x, ..] -> x,
    _ -> "",
  }

// HTTP/1.1 is persistent by default; HTTP/1.0 closes by default and opts in.
fn keep_alive_of(version: Version, h: Headers) -> Bool = {
  let tokens = list_field(h, "connection");
  match version {
    Http11 -> !contains_string(tokens, "close"),
    Http10 -> contains_string(tokens, "keep-alive"),
  }
}

// --- Bodies -----------------------------------------------------------------

type ChunkPhase = AtSize | InData | AfterData | InTrailers | Finished

pub type BodyState = {
  framing:   Framing,
  phase:     ChunkPhase,
  remaining: Int,
  received:  Int,
  limits:    Limits,
}

pub type BodyStep =
  | Await({ state: BodyState, consumed: Int, out: Bytes })
  | Complete({ consumed: Int, out: Bytes, trailers: Headers })
  | Rejected(Refusal)

pub fn body_start(framing: Framing, limits: Limits) -> BodyState =
  {framing: framing,
   phase: match framing { Chunked -> AtSize, _ -> InData },
   remaining: match framing { Length(n) -> n, _ -> 0 },
   received: 0,
   limits: limits}

// Decoding is pure; only refilling the buffer performs `net`.
pub fn body_step(state: BodyState, buf: Bytes) -> BodyStep =
  match state.framing {
    NoBody -> Complete({consumed: 0, out: b"", trailers: empty_headers()}),
    Length(_) -> length_step(state, buf),
    Chunked -> chunk_step(state, buf, 0, [], chunk_budget()),
    UntilClose -> until_close_step(state, buf),
  }

// Every byte is body; the reader turns the close into the end.
fn until_close_step(state: BodyState, buf: Bytes) -> BodyStep = {
  let n = bytes_len(buf);
  if state.received + n > state.limits.max_body {
    Rejected({status: 413,
              reason: "the body is longer than " ++ int_to_string(state.limits.max_body) ++ " bytes"})
  } else {
    Await({state: {..state, received: state.received + n}, consumed: n, out: buf})
  }
}

fn length_step(state: BodyState, buf: Bytes) -> BodyStep = {
  let take = min_int(state.remaining, bytes_len(buf));
  let out = bytes_slice(buf, 0, take);
  if take >= state.remaining {
    Complete({consumed: take, out: out, trailers: empty_headers()})
  } else {
    Await({state: {framing: state.framing, phase: state.phase,
                   remaining: state.remaining - take, received: state.received + take,
                   limits: state.limits},
           consumed: take, out: out})
  }
}

// At most `chunk_budget()` chunks per step, so tiny chunks cost the caller a loop, not the stack.
fn chunk_step(state: BodyState, buf: Bytes, at: Int, out: List<Bytes>, fuel: Int) -> BodyStep =
  if fuel <= 0 {
    Await({state: state, consumed: at, out: bytes_concat_all(out)})
  } else {
    match state.phase {
      AtSize -> chunk_size(state, buf, at, out, fuel),
      InData -> chunk_data(state, buf, at, out, fuel),
      AfterData -> chunk_crlf(state, buf, at, out, fuel),
      InTrailers -> chunk_trailers(state, buf, at, out),
      Finished -> Complete({consumed: at, out: bytes_concat_all(out), trailers: empty_headers()}),
    }
  }

fn waiting(state: BodyState, at: Int, out: List<Bytes>) -> BodyStep =
  Await({state: state, consumed: at, out: bytes_concat_all(out)})

fn phased(state: BodyState, phase: ChunkPhase, remaining: Int, received: Int) -> BodyState =
  {framing: state.framing, phase: phase, remaining: remaining, received: received,
   limits: state.limits}

// A chunk-size line is hex digits, optionally followed by `;` and extensions, terminated by CRLF.
fn chunk_size(state: BodyState, buf: Bytes, at: Int, out: List<Bytes>, fuel: Int) -> BodyStep =
  match read_line(buf, at, state.limits.max_chunk_line) {
    LineIncomplete -> waiting(state, at, out),
    LineTooLong -> Rejected({status: 400,
                             reason: "a chunk-size line is longer than "
                                     ++ int_to_string(state.limits.max_chunk_line) ++ " bytes"}),
    LineIllegal(e) -> Rejected({status: 400, reason: e.why}),
    LineAt(l) -> sized(state, buf, out, fuel, bytes_slice(buf, l.start, l.stop), l.next),
  }

fn sized(state: BodyState, buf: Bytes, out: List<Bytes>, fuel: Int, line: Bytes, next: Int)
  -> BodyStep = {
  let n = bytes_len(line);
  let end = bytes_scan_until(line, 0, b";", n);
  let digits = bytes_slice(line, 0, end);
  if bytes_len(digits) == 0 || bytes_len(digits) > 16
     || bytes_scan(digits, 0, hex_digits(), bytes_len(digits)) != bytes_len(digits) {
    Rejected({status: 400,
              reason: "a chunk size is 1 to 16 hexadecimal digits, optionally followed by `;`"})
  } else if !fits_in_int(digits, 0, bytes_len(digits)) {
    Rejected(too_large_chunk(state.limits))
  } else {
    chunk_sized(state, buf, out, fuel, hex_to_int(digits, 0, 0), next)
  }
}

// Sixteen hex digits can exceed a signed `Int`, so the digit bound alone does not prevent overflow.
fn fits_in_int(b: Bytes, i: Int, n: Int) -> Bool =
  if i >= n {
    true
  } else if bytes_at(b, i) == 48 {
    fits_in_int(b, i + 1, n)
  } else {
    n - i < 16 || (n - i == 16 && hex_value(bytes_at(b, i)) < 8)
  }

fn too_large_chunk(limits: Limits) -> Refusal =
  {status: 413,
   reason: "a chunk is larger than " ++ int_to_string(limits.max_chunk_size) ++ " bytes"}

fn chunk_sized(state: BodyState, buf: Bytes, out: List<Bytes>, fuel: Int, size: Int, next: Int)
  -> BodyStep =
  if size > state.limits.max_chunk_size {
    Rejected(too_large_chunk(state.limits))
  } else if state.received + size > state.limits.max_body {
    Rejected({status: 413,
              reason: "the body is longer than " ++ int_to_string(state.limits.max_body)
                      ++ " bytes"})
  } else if size == 0 {
    chunk_step(phased(state, InTrailers, 0, state.received), buf, next, out, fuel - 1)
  } else {
    chunk_step(phased(state, InData, size, state.received), buf, next, out, fuel - 1)
  }

// Only called after `fits_in_int`; the digit bound alone would let this overflow.
fn hex_to_int(b: Bytes, i: Int, acc: Int) -> Int =
  if i >= bytes_len(b) { acc } else { hex_to_int(b, i + 1, acc * 16 + hex_value(bytes_at(b, i))) }

fn hex_value(c: Int) -> Int =
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else {
    c - 55
  }

reuse fn chunk_data(state: BodyState, buf: Bytes, at: Int, out: List<Bytes>, fuel: Int) -> BodyStep = {
  let take = min_int(state.remaining, bytes_len(buf) - at);
  let taken = push(out, bytes_slice(buf, at, at + take));
  let next = phased(state,
                    if take >= state.remaining { AfterData } else { InData },
                    state.remaining - take,
                    state.received + take);
  if take >= state.remaining {
    chunk_step(next, buf, at + take, taken, fuel)
  } else {
    waiting(next, at + take, taken)
  }
}

fn chunk_crlf(state: BodyState, buf: Bytes, at: Int, out: List<Bytes>, fuel: Int) -> BodyStep =
  if bytes_len(buf) < at + 2 {
    waiting(state, at, out)
  } else if bytes_at(buf, at) != 13 || bytes_at(buf, at + 1) != 10 {
    Rejected({status: 400, reason: "a chunk's data must be followed by CRLF"})
  } else {
    chunk_step(phased(state, AtSize, 0, state.received), buf, at + 2, out, fuel - 1)
  }

// Trailers follow the header block's rules under `max_trailer_bytes` and are returned separately.
fn chunk_trailers(state: BodyState, buf: Bytes, at: Int, out: List<Bytes>) -> BodyStep = {
  let trailer_limits = {..state.limits, max_header_bytes: state.limits.max_trailer_bytes};
  match fields(buf, at, at, trailer_limits) {
    FieldsIncomplete -> waiting(state, at, out),
    FieldsRefused(r) -> Rejected(r),
    FieldsDone(done) ->
      Complete({consumed: done.next, out: bytes_concat_all(out), trailers: done.headers}),
  }
}

// --- Responses --------------------------------------------------------------

pub fn response(status: Int, body: Bytes) -> Response =
  {status: status, headers: empty_headers(), body: body}

pub fn text_response(status: Int, text: String) -> Response = {
  let body = bytes_of_string(text);
  {status: status,
   headers: set_header(empty_headers(), "content-type", "text/plain; charset=utf-8"),
   body: body}
}

pub fn refusal_response(r: Refusal) -> Response =
  text_response(r.status, r.reason ++ "\n")

// A 405 carrying the `Allow` field it must.
pub fn method_not_allowed(ms: List<Method>) -> Response = {
  let allow = allow_field(ms);
  let body = text_response(405, "the methods this resource allows are " ++ allow ++ "\n");
  {status: body.status, headers: set_header(body.headers, "allow", allow), body: body.body}
}

pub fn allow_field(ms: List<Method>) -> String =
  fold(ms, "", |acc: String, m: Method|
    if string_len(acc) == 0 { method_name(m) } else { acc ++ ", " ++ method_name(m) })

pub fn reason_phrase(status: Int) -> String =
  if status == 100 {
    "Continue"
  } else if status == 200 {
    "OK"
  } else if status == 201 {
    "Created"
  } else if status == 204 {
    "No Content"
  } else if status == 301 {
    "Moved Permanently"
  } else if status == 302 {
    "Found"
  } else if status == 304 {
    "Not Modified"
  } else if status == 400 {
    "Bad Request"
  } else if status == 401 {
    "Unauthorized"
  } else if status == 403 {
    "Forbidden"
  } else if status == 404 {
    "Not Found"
  } else if status == 405 {
    "Method Not Allowed"
  } else if status == 408 {
    "Request Timeout"
  } else if status == 411 {
    "Length Required"
  } else if status == 413 {
    "Content Too Large"
  } else if status == 414 {
    "URI Too Long"
  } else if status == 415 {
    "Unsupported Media Type"
  } else if status == 417 {
    "Expectation Failed"
  } else if status == 431 {
    "Request Header Fields Too Large"
  } else if status == 500 {
    "Internal Server Error"
  } else if status == 501 {
    "Not Implemented"
  } else if status == 503 {
    "Service Unavailable"
  } else if status == 505 {
    "HTTP Version Not Supported"
  } else {
    "Unknown"
  }

// 1xx, 204 and 304 carry no body or `Content-Length`: a client would read one as the next message.
fn bodiless(status: Int) -> Bool =
  (status >= 100 && status < 200) || status == 204 || status == 304

// Panics on a header the program may not set: a bad name, a framing field, or CR/LF in a value.
pub reuse fn encode(method: Method, version: Version, keep_alive: Bool, r: Response) -> Bytes = {
  let head = bytes_of_string(
    "HTTP/1.1 " ++ int_to_string(r.status) ++ " " ++ reason_phrase(r.status) ++ "\r\n");
  let fields = fold(map_entries(r.headers), [],
                    |acc: List<Bytes>, e: { key: String, value: List<String> }|
                      fold(e.value, acc, |inner: List<Bytes>, v: String|
                        push(inner, header_bytes(e.key, v))));
  let framing = framing_fields(r);
  bytes_concat_all([head, bytes_concat_all(fields), framing,
                    connection_field(version, keep_alive), b"\r\n", response_body(method, r)])
}

fn header_bytes(name: String, value: String) -> Bytes = {
  let raw = bytes_of_string(name);
  if !is_token(raw) {
    panic("`" ++ name ++ "` is not a valid header name")
  } else if reserved_field(name) {
    panic("`" ++ name ++ "` is computed by `encode` and may not be set by the program")
  } else if string_contains(value, "\r") || string_contains(value, "\n") {
    panic("the value of `" ++ name ++ "` contains CR or LF, which would split the response")
  } else {
    bytes_of_string(name ++ ": " ++ value ++ "\r\n")
  }
}

fn reserved_field(name: String) -> Bool = {
  let lower = string_lower(name);
  lower == "content-length" || lower == "transfer-encoding" || lower == "connection"
}

// A response to `HEAD` carries the `Content-Length` a `GET` would have produced, and no body.
fn framing_fields(r: Response) -> Bytes =
  if bodiless(r.status) {
    b""
  } else {
    bytes_of_string("Content-Length: " ++ int_to_string(bytes_len(r.body)) ++ "\r\n")
  }

fn response_body(method: Method, r: Response) -> Bytes =
  match method {
    Head -> b"",
    _ -> if bodiless(r.status) { b"" } else { r.body },
  }

fn connection_field(version: Version, keep_alive: Bool) -> Bytes =
  if !keep_alive {
    b"Connection: close\r\n"
  } else {
    match version {
      Http10 -> b"Connection: keep-alive\r\n",
      Http11 -> b"",
    }
  }

// The head of a streamed response.
pub reuse fn encode_chunked_head(version: Version, keep_alive: Bool, r: Response) -> Bytes = {
  let head = bytes_of_string(
    "HTTP/1.1 " ++ int_to_string(r.status) ++ " " ++ reason_phrase(r.status) ++ "\r\n");
  let fields = fold(map_entries(r.headers), [],
                    |acc: List<Bytes>, e: { key: String, value: List<String> }|
                      fold(e.value, acc, |inner: List<Bytes>, v: String|
                        push(inner, header_bytes(e.key, v))));
  match version {
    Http11 ->
      bytes_concat_all([head, bytes_concat_all(fields), b"Transfer-Encoding: chunked\r\n",
                        connection_field(Http11, keep_alive), b"\r\n"]),
    Http10 ->
      bytes_concat_all([head, bytes_concat_all(fields), connection_field(Http10, false), b"\r\n"]),
  }
}

pub fn encode_chunk(chunk: Bytes) -> Bytes =
  if bytes_len(chunk) == 0 {
    b""
  } else {
    bytes_concat_all([bytes_of_string(int_to_hex(bytes_len(chunk))), b"\r\n", chunk, b"\r\n"])
  }

pub fn last_chunk() -> Bytes = b"0\r\n\r\n"

fn int_to_hex(n: Int) -> String =
  if n < 16 {
    hex_digit(n)
  } else {
    int_to_hex(n / 16) ++ hex_digit(n % 16)
  }

fn hex_digit(v: Int) -> String = string_slice("0123456789abcdef", v, v + 1)

pub fn continue_response() -> Bytes = b"HTTP/1.1 100 Continue\r\n\r\n"

// --- The read loop ----------------------------------------------------------

// Reading a head never re-scans its buffer, which would make it quadratic.
pub type HeadRead =
  | HeadBytes({ buf: Bytes, complete: Bool })
  // The head began arriving and did not finish inside `header_timeout_ms`: 408.
  | HeadTimedOut
  // Nothing arrived between messages on a kept-alive connection: close without writing.
  | HeadIdle
  | HeadClosed(Bytes)

type Reading = { pieces: List<Bytes>, total: Int, tail: Bytes, found: Bool }

// `idle` is the wait for the first byte of a message on a connection that has already answered one.
pub fn read_head(c: Int, carried: Bytes, limits: Limits, idle: Bool) -> HeadRead
  / {net.write[conn]} = {
  let cap = limits.max_request_line + limits.max_header_bytes;
  let start = {pieces: [carried], total: bytes_len(carried),
               tail: keep_tail(carried), found: terminated(carried, 0)};
  if idle && bytes_len(carried) == 0 {
    match net.recv[conn](c, min_int(read_size(), cap), limits.idle_timeout_ms) {
      None -> HeadIdle,
      Some(chunk) ->
        if bytes_len(chunk) == 0 {
          HeadClosed(b"")
        } else {
          head_deadline(c, limits, cap, absorb(start, chunk))
        },
    }
  } else {
    head_deadline(c, limits, cap, start)
  }
}

fn head_deadline(c: Int, limits: Limits, cap: Int, r: Reading) -> HeadRead / {net.write[conn]} =
  read_head_loop(c, limits, cap, slice_ms(limits.header_timeout_ms),
                 read_budget(limits.header_timeout_ms), r)

// Each read waits one slice of the timeout, so the deadline bounds the whole head, not each read.
fn slice_ms(timeout_ms: Int) -> Int =
  if timeout_ms / max_reads() < 1 { 1 } else { timeout_ms / max_reads() }

fn read_budget(timeout_ms: Int) -> Int = min_int(max_reads(), timeout_ms / slice_ms(timeout_ms))

fn read_head_loop(c: Int, limits: Limits, cap: Int, slice: Int, reads: Int, r: Reading) -> HeadRead
  / {net.write[conn]} =
  if r.found {
    HeadBytes({buf: bytes_concat_all(r.pieces), complete: true})
  } else if r.total >= cap {
    // Stop at the bound rather than buffer past it; `parse_head` answers 431 or 414 against it.
    HeadBytes({buf: bytes_concat_all(r.pieces), complete: false})
  } else if reads <= 0 {
    HeadTimedOut
  } else {
    match net.recv[conn](c, min_int(read_size(), cap - r.total), slice) {
      // An empty slice is not the deadline; the deadline is the budget running out, above.
      None -> read_head_loop(c, limits, cap, slice, reads - 1, r),
      Some(chunk) ->
        if bytes_len(chunk) == 0 {
          HeadClosed(bytes_concat_all(r.pieces))
        } else {
          read_head_loop(c, limits, cap, slice, reads - 1, absorb(r, chunk))
        },
    }
  }

fn absorb(r: Reading, chunk: Bytes) -> Reading = {
  let probe = bytes_concat(r.tail, chunk);
  {pieces: push(r.pieces, chunk),
   total: r.total + bytes_len(chunk),
   tail: keep_tail(probe),
   found: terminated(probe, 0)}
}

// A blank line ends the head.
fn terminated(b: Bytes, from: Int) -> Bool =
  match bytes_index_of_from(b, b"\r\n\r\n", from) {
    Some(_) -> true,
    None -> match bytes_index_of_from(b, b"\n\n", from) {
      Some(_) -> true,
      None -> false,
    },
  }

fn keep_tail(b: Bytes) -> Bytes = {
  let n = bytes_len(b);
  bytes_slice(b, if n > 3 { n - 3 } else { 0 }, n)
}

// --- Reading a body ---------------------------------------------------------

pub type BodyResult =
  | Body({ bytes: Bytes, rest: Bytes, trailers: Headers })
  | BodyRefused(Refusal)
  | BodyTimedOut
  | BodyClosed

// The buffered form, for a handler that wants a whole body.
pub fn read_body(c: Int, framing: Framing, buf: Bytes, limits: Limits) -> BodyResult
  / {net.write[conn]} =
  body_loop(c, body_start(framing, limits), buf, [], slice_ms(limits.body_timeout_ms),
            read_budget(limits.body_timeout_ms), limits)

reuse fn body_loop(c: Int, state: BodyState, buf: Bytes, out: List<Bytes>, slice: Int, reads: Int,
             limits: Limits) -> BodyResult / {net.write[conn]} =
  match body_step(state, buf) {
    Rejected(r) -> BodyRefused(r),
    Complete(done) ->
      Body({bytes: bytes_concat_all(push(out, done.out)),
            rest: bytes_slice(buf, done.consumed, bytes_len(buf)),
            trailers: done.trailers}),
    Await(step) -> body_more(c, step, buf, out, slice, reads, limits),
  }

reuse fn body_more(c: Int, step: { state: BodyState, consumed: Int, out: Bytes }, buf: Bytes,
             out: List<Bytes>, slice: Int, reads: Int, limits: Limits) -> BodyResult
  / {net.write[conn]} = {
  let rest = bytes_slice(buf, step.consumed, bytes_len(buf));
  let taken = push(out, step.out);
  if reads <= 0 {
    BodyTimedOut
  } else if step.consumed > 0 && bytes_len(rest) > 0 {
    // The chunk budget ran out, not the input: loop without a read, so small chunks share reads.
    body_loop(c, step.state, rest, taken, slice, reads - 1, limits)
  } else {
    match net.recv[conn](c, read_size(), slice) {
      None -> body_loop(c, step.state, rest, taken, slice, reads - 1, limits),
      Some(chunk) ->
        if bytes_len(chunk) == 0 {
          match step.state.framing {
            UntilClose -> Body({bytes: bytes_concat_all(taken), rest: b"", trailers: empty_headers()}),
            _ -> BodyClosed,
          }
        } else {
          body_loop(c, step.state, bytes_concat(rest, chunk), taken, slice, reads - 1, limits)
        },
    }
  }
}

// --- Responses, as a client reads them --------------------------------------

pub type ResponseHead = {
  version:    Version,
  status:     Int,
  reason:     String,
  headers:    Headers,
  framing:    Framing,
  consumed:   Int,
  keep_alive: Bool,
}

pub type ResponseHeadResult =
  | ResponseIncomplete
  | ResponseParsed(ResponseHead)
  | ResponseRefused(Refusal)

// `method` decides the framing: an answer to `HEAD` carries no body whatever its fields say.
pub fn parse_response_head(buf: Bytes, method: Method, limits: Limits) -> ResponseHeadResult =
  match read_line(buf, 0, limits.max_request_line) {
    LineIncomplete -> ResponseIncomplete,
    LineTooLong -> ResponseRefused({status: 502, reason: "the status line is longer than "
                                    ++ int_to_string(limits.max_request_line) ++ " bytes"}),
    LineIllegal(e) -> ResponseRefused({status: 502, reason: e.why}),
    LineAt(l) -> after_status_line(buf, method, limits, l),
  }

fn after_status_line(buf: Bytes, method: Method, limits: Limits,
                     l: { start: Int, stop: Int, next: Int }) -> ResponseHeadResult =
  match status_line(bytes_slice(buf, l.start, l.stop)) {
    Err(r) -> ResponseRefused(r),
    Ok(start) ->
      match fields(buf, l.next, l.next, limits) {
        FieldsIncomplete -> ResponseIncomplete,
        FieldsRefused(r) -> ResponseRefused(relayed(r)),
        FieldsDone(done) ->
          match response_framing(method, start.status, done.headers, limits) {
            Err(r) -> ResponseRefused(relayed(r)),
            Ok(framing) -> ResponseParsed({
              version:    start.version,
              status:     start.status,
              reason:     start.reason,
              headers:    done.headers,
              framing:    framing,
              consumed:   done.next,
              keep_alive: keep_alive_of(start.version, done.headers),
            }),
          },
      },
  }

// A fault in a response is the server's, reported as a gateway would relay it: 502.
fn relayed(r: Refusal) -> Refusal = {status: 502, reason: r.reason}

type StatusLine = { version: Version, status: Int, reason: String }

// `VERSION SP 3DIGIT SP REASON`; the reason may be empty and may hold spaces.
fn status_line(line: Bytes) -> Result<StatusLine, Refusal> = {
  let n = bytes_len(line);
  let sp = bytes_scan_until(line, 0, b" ", n);
  if sp >= n {
    Err({status: 502, reason: "a status line is `VERSION SP STATUS SP REASON`"})
  } else {
    let version = response_version(bytes_slice(line, 0, sp))?;
    let code = bytes_slice(line, sp + 1, min_int(sp + 4, n));
    let after = sp + 4;
    if bytes_len(code) != 3 || !all_digits(code) {
      Err({status: 502, reason: "a status is three digits"})
    } else if after < n && bytes_at(line, after) != 32 {
      Err({status: 502, reason: "a status line is `VERSION SP STATUS SP REASON`"})
    } else {
      Ok({version: version,
          status: digits_to_int(code, 0, 0),
          reason: string_of_bytes_lossy(bytes_slice(line, min_int(after + 1, n), n))})
    }
  }
}

fn response_version(v: Bytes) -> Result<Version, Refusal> =
  match version_of(v) {
    Ok(version) -> Ok(version),
    Err(_) -> Err({status: 502, reason: "a status line begins with `HTTP/1.1` or `HTTP/1.0`"}),
  }

// 1xx, 204, 304 and any answer to `HEAD` carry no body; without a length field the body runs
// until the server closes.
fn response_framing(method: Method, status: Int, h: Headers, limits: Limits)
  -> Result<Framing, Refusal> =
  match method {
    Head -> Ok(NoBody),
    _ ->
      if bodiless(status) {
        Ok(NoBody)
      } else {
        match framing_of(h, limits)? {
          NoBody -> Ok(UntilClose),
          framing -> Ok(framing),
        }
      },
  }

// --- Requests, as a client sends them ---------------------------------------

// `target` is the path with its query; `authority` is the `Host` the request carries.
pub fn request_to(method: Method, authority: String, target: String, body: Bytes) -> Request = {
  let raw = bytes_of_string(target);
  let split = match bytes_index_of(raw, b"?") {
    Some(at) -> {path: bytes_slice(raw, 0, at), query: bytes_slice(raw, at + 1, bytes_len(raw))},
    None -> {path: raw, query: b""},
  };
  {method:    method,
   target:    target,
   path:      string_of_bytes_lossy(split.path),
   query:     string_of_bytes_lossy(split.query),
   authority: authority,
   version:   Http11,
   headers:   empty_headers(),
   trailers:  empty_headers(),
   body:      body}
}

// One request per connection, so it says `Connection: close`. Panics on a header the program may
// not set: `Host` comes from `authority`, and the rest as in `encode`.
pub reuse fn encode_request(r: Request) -> Bytes = {
  let line = bytes_of_string(method_name(r.method) ++ " " ++ request_target(r) ++ " HTTP/1.1\r\n");
  let host = if has_header(r.headers, "host") {
    panic("`Host` is computed from `Request.authority` and may not be set by the program")
  } else {
    bytes_of_string("Host: " ++ r.authority ++ "\r\n")
  };
  let fields = fold(map_entries(r.headers), [],
                    |acc: List<Bytes>, e: { key: String, value: List<String> }|
                      fold(e.value, acc, |inner: List<Bytes>, v: String|
                        push(inner, header_bytes(e.key, v))));
  bytes_concat_all([line, host, bytes_concat_all(fields), request_framing(r),
                    b"Connection: close\r\n", b"\r\n", r.body])
}

fn request_target(r: Request) -> String =
  if string_len(r.target) > 0 {
    r.target
  } else if string_len(r.query) > 0 {
    r.path ++ "?" ++ r.query
  } else if string_len(r.path) > 0 {
    r.path
  } else {
    "/"
  }

// A body, or a method that usually carries one, is framed by its length; `GET` without a body is not.
fn request_framing(r: Request) -> Bytes =
  if bytes_len(r.body) > 0 || carries_body(r.method) {
    bytes_of_string("Content-Length: " ++ int_to_string(bytes_len(r.body)) ++ "\r\n")
  } else {
    b""
  }

fn carries_body(m: Method) -> Bool =
  match m {
    Post -> true,
    Put -> true,
    Patch -> true,
    _ -> false,
  }

// --- The client -------------------------------------------------------------

pub type ClientError =
  | Unreachable
  | NotSent
  | TimedOut
  | Closed
  | Malformed(Refusal)

// One exchange on a fresh connection, closed afterwards whatever happened. A `1xx` answer is
// returned as it is.
pub fn request(host: String, port: Int, req: Request, limits: Limits)
  -> Result<Response, ClientError> / {net.write[conn]} =
  match net.connect[conn](host, port, limits.connect_timeout_ms) {
    None -> Err(Unreachable),
    Some(c) -> {
      let answer = exchange(c, req, limits);
      net.close[conn](c);
      answer
    },
  }

fn exchange(c: Int, req: Request, limits: Limits) -> Result<Response, ClientError>
  / {net.write[conn]} =
  if !send_all(c, encode_request(req), limits.write_timeout_ms) {
    Err(NotSent)
  } else {
    match read_head(c, b"", limits, false) {
      HeadTimedOut -> Err(TimedOut),
      HeadIdle -> Err(TimedOut),
      HeadClosed(_) -> Err(Closed),
      HeadBytes(got) ->
        match parse_response_head(got.buf, req.method, limits) {
          ResponseRefused(r) -> Err(Malformed(r)),
          ResponseIncomplete ->
            Err(Malformed({status: 502, reason: "the head is longer than "
                           ++ int_to_string(limits.max_request_line + limits.max_header_bytes)
                           ++ " bytes"})),
          ResponseParsed(head) ->
            read_answer(c, head, bytes_slice(got.buf, head.consumed, bytes_len(got.buf)), limits),
        },
    }
  }

fn read_answer(c: Int, head: ResponseHead, rest: Bytes, limits: Limits)
  -> Result<Response, ClientError> / {net.write[conn]} =
  match read_body(c, head.framing, rest, limits) {
    Body(b) -> Ok({status: head.status, headers: head.headers, body: b.bytes}),
    BodyRefused(r) -> Err(Malformed(relayed(r))),
    BodyTimedOut -> Err(TimedOut),
    BodyClosed -> Err(Closed),
  }

// --- Serving ----------------------------------------------------------------

// One connection: read a head, answer it, then close or go round again with the leftover bytes.
pub fn serve_connection<| e>(c: Int, limits: Limits, app: (Request) -> Response / e) -> Unit
  / {net.write[conn] | e} = {
  connection_loop(c, limits, app, b"", limits.max_keep_alive, false);
  net.close[conn](c)
}

// One function, not five: mutually recursive helpers would each get a rigid `e` that cannot unify.
fn connection_loop<| e>(c: Int, limits: Limits, app: (Request) -> Response / e, carried: Bytes,
                        left: Int, reused: Bool) -> Unit / {net.write[conn] | e} =
  if left <= 0 {
    ()
  } else {
    // The idle timeout runs until the next request's first byte; the header timeout from then.
    match read_head(c, carried, limits, reused) {
      // The peer went away, or went quiet between messages.
      HeadClosed(_) -> (),
      HeadIdle -> (),
      HeadTimedOut ->
        write_response(c, limits, Get, Http11, false,
                       text_response(408, "the request head did not arrive\n")),
      HeadBytes(read) ->
        match parse_head(read.buf, limits) {
          // The head stopped midway, or overran the bound without a terminator.
          Incomplete ->
            if read.complete {
              write_response(c, limits, Get, Http11, false,
                             text_response(400, "the request head never ended\n"))
            } else {
              write_response(c, limits, Get, Http11, false,
                             text_response(431,
                               "the request head never ended within the bound\n"))
            },
          Refused(r) -> write_response(c, limits, Get, Http11, false, refusal_response(r)),
          Parsed(head) -> {
            let rest = bytes_slice(read.buf, head.consumed, bytes_len(read.buf));
            // The `100` goes out before the body is read, or the client waits for it forever.
            if head.expects_continue
               && !send_all(c, continue_response(), limits.write_timeout_ms) {
              ()
            } else {
              // Read the body even if the handler ignores it, or it is framed as the next request.
              match read_body(c, head.framing, rest, limits) {
                BodyTimedOut ->
                  write_response(c, limits, head.request.method, head.request.version, false,
                                 text_response(408, "the request body did not arrive\n")),
                BodyClosed -> (),
                BodyRefused(r) ->
                  write_response(c, limits, head.request.method, head.request.version, false,
                                 refusal_response(r)),
                Body(got) -> {
                  let req = {method: head.request.method, target: head.request.target,
                             path: head.request.path, query: head.request.query,
                             authority: head.request.authority, version: head.request.version,
                             headers: head.request.headers, trailers: got.trailers,
                             body: got.bytes};
                  let keep = head.keep_alive && left > 1;
                  write_response(c, limits, req.method, req.version, keep, app(req));
                  if keep {
                    connection_loop(c, limits, app, got.rest, left - 1, true)
                  } else {
                    ()
                  }
                },
              }
            }
          },
        },
    }
  }

fn write_response(c: Int, limits: Limits, method: Method, version: Version, keep_alive: Bool,
                  r: Response) -> Unit / {net.write[conn]} = {
  send_all(c, encode(method, version, keep_alive, r), limits.write_timeout_ms);
  ()
}

// Streams `produce`'s chunks (raw under HTTP/1.0); answers whether the connection may be reused.
pub fn respond_chunked<s | e>(c: Int, version: Version, r: Response, keep_alive: Bool,
                             limits: Limits, seed: s,
                             produce: (s) -> Option<{ chunk: Bytes, next: s }> / e) -> Bool
  / {net.write[conn] | e} =
  match version {
    Http11 ->
      if !send_all(c, encode_chunked_head(Http11, keep_alive, r), limits.write_timeout_ms) {
        false
      } else {
        stream_chunks(c, limits, seed, produce, limits.max_stream_chunks)
      },
    Http10 ->
      if !send_all(c, encode_chunked_head(Http10, false, r), limits.write_timeout_ms) {
        false
      } else {
        stream_raw(c, limits, seed, produce, limits.max_stream_chunks)
      },
  }

// Always write the terminating chunk: a chunked response without one is response smuggling.
fn stream_chunks<s | e>(c: Int, limits: Limits, seed: s,
                       produce: (s) -> Option<{ chunk: Bytes, next: s }> / e, fuel: Int) -> Bool
  / {net.write[conn] | e} =
  if fuel <= 0 {
    // Close the framing even though the body is short, so the client sees where the message ends.
    send_all(c, last_chunk(), limits.write_timeout_ms);
    false
  } else {
    iterate({ s: seed, left: fuel }, fuel + 1, |it: { s: s, left: Int }|
      if it.left <= 0 {
        send_all(c, last_chunk(), limits.write_timeout_ms);
        Stop(false)
      } else {
        match produce(it.s) {
          None -> Stop(send_all(c, last_chunk(), limits.write_timeout_ms)),
          Some(step) ->
            if !send_all(c, encode_chunk(step.chunk), limits.write_timeout_ms) {
              Stop(false)
            } else {
              Continue({ s: step.next, left: it.left - 1 })
            },
        }
      })
  }

// HTTP/1.0 has no chunked coding: the body is raw and the close frames it, so this answers `false`.
fn stream_raw<s | e>(c: Int, limits: Limits, seed: s,
                    produce: (s) -> Option<{ chunk: Bytes, next: s }> / e, fuel: Int) -> Bool
  / {net.write[conn] | e} =
  if fuel <= 0 {
    false
  } else {
    iterate({ s: seed, left: fuel }, fuel + 1, |it: { s: s, left: Int }|
      if it.left <= 0 {
        Stop(false)
      } else {
        match produce(it.s) {
          None -> Stop(false),
          Some(step) ->
            if bytes_len(step.chunk) > 0
               && !send_all(c, step.chunk, limits.write_timeout_ms) {
              Stop(false)
            } else {
              Continue({ s: step.next, left: it.left - 1 })
            },
        }
      })
  }

// Accept `count` connections and answer each.
pub fn serve<| e>(listener: Int, count: Int, limits: Limits, app: (Request) -> Response / e) -> Int
  / {net.write[listener], net.write[conn] | e} =
  if count <= 0 {
    0
  } else {
    let c = net.accept[listener](listener);
    if c == 0 {
      0
    } else {
      serve_connection(c, limits, app);
      1 + serve(listener, count - 1, limits, app)
    }
  }

pub fn listen_and_serve<| e>(port: Int, count: Int, limits: Limits,
                           app: (Request) -> Response / e) -> Int
  / {net.write[listener], net.write[conn] | e} = {
  check_limits(limits);
  let l = net.listen[listener](port);
  let served = serve(l, count, limits, app);
  net.close[listener](l);
  served
}

// --- Tests: helpers ---------------------------------------------------------

fn head_status(raw: Bytes) -> Int = head_status_with(raw, default_limits())

// `-1` is incomplete and `0` is accepted, so a table of cases reads as the status each input earns.
fn head_status_with(raw: Bytes, limits: Limits) -> Int =
  match parse_head(raw, limits) {
    Refused(r) -> r.status,
    Incomplete -> -1,
    Parsed(_) -> 0,
  }

fn head_reason(raw: Bytes) -> String =
  match parse_head(raw, default_limits()) {
    Refused(r) -> r.reason,
    Incomplete -> "incomplete",
    Parsed(_) -> "parsed",
  }

fn parsed(raw: Bytes) -> Head =
  match parse_head(raw, default_limits()) {
    Parsed(h) -> h,
    Refused(r) -> panic("expected a parse, got " ++ int_to_string(r.status) ++ ": " ++ r.reason),
    Incomplete -> panic("expected a parse, got an incomplete head"),
  }

// Spreads `default_limits()`: every field is `Int`, so a hand-spelled record can mispair silently.
fn limits_with(request_line: Int, header_bytes: Int, header_count: Int, body: Int,
               chunk_size: Int, chunk_line: Int, trailer_bytes: Int) -> Limits = {
  let base: Limits = default_limits();
  {..base, max_request_line: request_line, max_header_bytes: header_bytes,
   max_header_count: header_count, max_body: body, max_chunk_size: chunk_size,
   max_chunk_line: chunk_line, max_trailer_bytes: trailer_bytes}
}

fn get(fields: Bytes) -> Bytes =
  bytes_concat_all([b"GET / HTTP/1.1\r\nHost: x\r\n", fields, b"\r\n"])

fn post(fields: Bytes, body: Bytes) -> Bytes =
  bytes_concat_all([b"POST / HTTP/1.1\r\nHost: x\r\n", fields, b"\r\n", body])

// --- Tests: the request line ------------------------------------------------

test "a well-formed request line is split into its parts" {
  let h = parsed(b"GET /orders?id=7 HTTP/1.1\r\nHost: api.example\r\n\r\n");
  assert_eq(h.request.method, Get);
  assert_eq(h.request.target, "/orders?id=7");
  assert_eq(h.request.path, "/orders");
  assert_eq(h.request.query, "id=7");
  assert_eq(h.request.authority, "api.example");
  assert_eq(h.request.version, Http11);
  assert_eq(h.framing, NoBody);
  assert_eq(h.consumed, 48);
  assert(h.keep_alive)
}

test "a token-valid method this server does not know reaches routing" {
  assert_eq(parsed(b"PROPFIND / HTTP/1.1\r\nHost: x\r\n\r\n").request.method, Other("PROPFIND"));
  assert_eq(parsed(b"DELETE / HTTP/1.1\r\nHost: x\r\n\r\n").request.method, Delete);
  assert_eq(method_name(Other("PROPFIND")), "PROPFIND")
}

test "a request line that is not `METHOD SP TARGET SP VERSION` is refused" {
  assert_eq(head_status(b"GET / HTTP/2.0\r\nHost: x\r\n\r\n"), 505);
  assert_eq(head_status(b"GET / HTTP/9.9\r\nHost: x\r\n\r\n"), 505);
  assert_eq(head_status(b"GET /\r\nHost: x\r\n\r\n"), 400);
  assert_eq(head_status(b"GET / \r\nHost: x\r\n\r\n"), 400);
  assert_eq(head_status(b"GE(T / HTTP/1.1\r\nHost: x\r\n\r\n"), 400);
  assert_eq(head_status(b"G\x00T / HTTP/1.1\r\nHost: x\r\n\r\n"), 400);
  assert_eq(head_status(b"GET / HTTP/1.1 extra\r\nHost: x\r\n\r\n"), 400);
  assert_eq(head_status(b"GET  HTTP/1.1\r\nHost: x\r\n\r\n"), 400);
  // Authority-form: this is a server, not a proxy, and `CONNECT` is not served.
  assert_eq(head_status(b"CONNECT example.com:443 HTTP/1.1\r\nHost: x\r\n\r\n"), 400);
  assert_eq(head_status(b"GET example.com HTTP/1.1\r\nHost: x\r\n\r\n"), 400);
  // Asterisk-form is OPTIONS and nothing else.
  assert_eq(head_status(b"GET * HTTP/1.1\r\nHost: x\r\n\r\n"), 400);
  assert_eq(head_status(b"OPTIONS * HTTP/1.1\r\nHost: x\r\n\r\n"), 0)
}

test "an absolute-form target's authority is the request's, and Host stays visible" {
  let h = parsed(b"GET http://a.example/orders?x=1 HTTP/1.1\r\nHost: b.example\r\n\r\n");
  assert_eq(h.request.authority, "a.example");
  assert_eq(h.request.path, "/orders");
  assert_eq(h.request.query, "x=1");
  assert_eq(header(h.request.headers, "host"), Some("b.example"));
  assert_eq(parsed(b"GET http://a.example HTTP/1.1\r\nHost: a\r\n\r\n").request.path, "/");
  // A scheme is case-insensitive and is compared as bytes, never decoded.
  assert_eq(parsed(b"GET HTTPS://a.example/x HTTP/1.1\r\nHost: a\r\n\r\n").request.authority,
            "a.example")
}

test "a target that is not origin-form is refused rather than ending the run" {
  assert_eq(head_status(b"GET \xe2\x82\xac\xe2\x82\xac\xe2\x82\xac HTTP/1.1\r\nHost: x\r\n\r\n"), 400);
  assert_eq(head_status(b"GET \xf0\x9f\x92\xa9\xf0\x9f\x92\xa9 HTTP/1.1\r\nHost: x\r\n\r\n"), 400);
  assert_eq(head_status(b"GET \xe2\x82\xac HTTP/1.1\r\nHost: x\r\n\r\n"), 400);
  assert_eq(head_status(b"GET htt\xe2\x82\xac://a/x HTTP/1.1\r\nHost: x\r\n\r\n"), 400)
}

test "whitespace inside a request target is refused" {
  assert_eq(head_status(b"GET /a\tb HTTP/1.1\r\nHost: x\r\n\r\n"), 400);
  assert_eq(head_status(b"GET\t/a HTTP/1.1\r\nHost: x\r\n\r\n"), 400);
  assert_eq(head_status(b"GET /a HTTP/1.1\t\r\nHost: x\r\n\r\n"), 400);
  // A vertical tab is a control byte and is already refused by the line scan.
  assert_eq(head_status(b"GET /a\x0bb HTTP/1.1\r\nHost: x\r\n\r\n"), 400);
  // HTAB stays legal where it is legal, which is inside a field value.
  assert_eq(header(parsed(b"GET / HTTP/1.1\r\nHost: x\r\nFoo: a\tb\r\n\r\n").request.headers, "foo"),
            Some("a\tb"))
}

test "an absolute-form target carrying userinfo is refused" {
  assert_eq(head_status(b"GET http://trusted.example@evil.example/x HTTP/1.1\r\nHost: h\r\n\r\n"),
            400);
  assert_eq(head_status(b"GET http://u:p@evil.example/x HTTP/1.1\r\nHost: h\r\n\r\n"), 400);
  assert_eq(head_status(b"GET http:///x HTTP/1.1\r\nHost: h\r\n\r\n"), 400)
}

test "a request target carrying a fragment is refused" {
  assert_eq(head_status(b"GET http://h#a/b HTTP/1.1\r\nHost: h\r\n\r\n"), 400);
  assert_eq(head_status(b"GET http://h/x#a HTTP/1.1\r\nHost: h\r\n\r\n"), 400);
  assert_eq(head_status(b"GET /health#x HTTP/1.1\r\nHost: h\r\n\r\n"), 400);
  assert_eq(head_status(b"GET /health?q=a#x HTTP/1.1\r\nHost: h\r\n\r\n"), 400);
  // Percent-encoded, it is an ordinary byte of the path and nothing splits on it.
  assert_eq(parsed(b"GET /health%23x HTTP/1.1\r\nHost: h\r\n\r\n").request.path, "/health%23x")
}

test "a request line over the bound is 414 and is not buffered past it" {
  let small = limits_with(32, 1024, 8, 64, 64, 64, 64);
  let long = bytes_concat_all([b"GET /", filler(4096), b" HTTP/1.1\r\nHost: x\r\n\r\n"]);
  assert_eq(head_status_with(long, small), 414);
  // Under the default bound the same input frames, so 414 is the bound, not a parse failure.
  assert_eq(head_status(long), 0)
}

fn filler(n: Int) -> Bytes = bytes_concat_all(map(range(0, n), |i: Int| b"a"))

// --- Tests: line terminators ------------------------------------------------

test "a line ends with CRLF and with nothing else" {
  assert_eq(head_status(b"GET / HTTP/1.1\nHost: x\r\n\r\n"), 400);
  assert_eq(head_status(b"GET / HTTP/1.1\r\nHost: x\n\r\n"), 400);
  assert_eq(head_status(b"GET / HTTP/1.1\r\nHost: x\rmore\r\n\r\n"), 400);
  assert_eq(head_status(b"GET / HTTP/1.1\r\nHost: x\r\nFoo: a\x00b\r\n\r\n"), 400);
  assert_eq(head_status(b"GET / HTTP/1.1\r\nHost: x\r\nFoo: a\x7fb\r\n\r\n"), 400);
  // A tab inside a value is legal and is the one control byte that is.
  assert_eq(head_status(b"GET / HTTP/1.1\r\nHost: x\r\nFoo: a\tb\r\n\r\n"), 0);
  assert_eq(header(parsed(b"GET / HTTP/1.1\r\nHost: x\r\nFoo: a\tb\r\n\r\n").request.headers,
                   "foo"),
            Some("a\tb"))
}

test "obsolete line folding and whitespace before a colon are refused" {
  assert_eq(head_status(b"GET / HTTP/1.1\r\nHost: x\r\nFoo: a\r\n bar\r\n\r\n"), 400);
  assert_eq(head_reason(b"GET / HTTP/1.1\r\nHost: x\r\nFoo: a\r\n bar\r\n\r\n"),
            "obsolete line folding is not accepted");
  assert_eq(head_status(b"GET / HTTP/1.1\r\nHost: x\r\nFoo: a\r\n\tbar\r\n\r\n"), 400);
  assert_eq(head_status(b"GET / HTTP/1.1\r\nHost: x\r\nFoo : bar\r\n\r\n"), 400);
  assert_eq(head_reason(b"GET / HTTP/1.1\r\nHost: x\r\nFoo : bar\r\n\r\n"),
            "whitespace between a field name and its colon");
  assert_eq(head_status(b"GET / HTTP/1.1\r\nHost: x\r\nFo o: bar\r\n\r\n"), 400);
  assert_eq(head_status(b"GET / HTTP/1.1\r\nHost: x\r\n: bar\r\n\r\n"), 400);
  assert_eq(head_status(b"GET / HTTP/1.1\r\nHost: x\r\nnocolon\r\n\r\n"), 400)
}

test "a head that has not finished arriving is incomplete rather than refused" {
  assert_eq(head_status(b""), -1);
  assert_eq(head_status(b"GET / HTTP/1.1\r\n"), -1);
  assert_eq(head_status(b"GET / HTTP/1.1\r\nHost: x\r\n"), -1);
  assert_eq(head_status(b"GET / HTTP/1.1\r\nHost: x\r\n\r"), -1);
  assert_eq(head_status(b"GET / HTT"), -1)
}

// --- Tests: Host ------------------------------------------------------------

test "an HTTP/1.1 request carries exactly one Host" {
  assert_eq(head_status(b"GET / HTTP/1.1\r\n\r\n"), 400);
  assert_eq(head_status(b"GET / HTTP/1.1\r\nHost: a\r\nHost: b\r\n\r\n"), 400);
  assert_eq(head_status(b"GET / HTTP/1.1\r\nHost: a\r\nhost: a\r\n\r\n"), 400);
  // HTTP/1.0 predates it.
  assert_eq(head_status(b"GET / HTTP/1.0\r\n\r\n"), 0);
  assert_eq(parsed(b"GET / HTTP/1.0\r\n\r\n").request.authority, "")
}

// --- Tests: Content-Length --------------------------------------------------

test "a duplicate Content-Length is refused even when the values agree" {
  assert_eq(head_status(post(b"Content-Length: 5\r\nContent-Length: 5\r\n", b"hello")), 400);
  assert_eq(head_status(post(b"Content-Length: 5\r\nContent-Length: 6\r\n", b"hello")), 400);
  // A comma-separated list is one field line and is not digits.
  assert_eq(head_status(post(b"Content-Length: 5, 5\r\n", b"hello")), 400)
}

test "a Content-Length is one or more ASCII digits and nothing else" {
  assert_eq(head_status(post(b"Content-Length: +5\r\n", b"hello")), 400);
  assert_eq(head_status(post(b"Content-Length: -5\r\n", b"hello")), 400);
  assert_eq(head_status(post(b"Content-Length: 5x\r\n", b"hello")), 400);
  assert_eq(head_status(post(b"Content-Length: 0x5\r\n", b"hello")), 400);
  assert_eq(head_status(post(b"Content-Length: \r\n", b"")), 400);
  // U+0660 ARABIC-INDIC DIGIT ZERO: a digit, and not an ASCII one.
  assert_eq(head_status(post(b"Content-Length: \xd9\xa0\r\n", b"")), 400);
  // Leading and trailing OWS around the value is not part of it, so ` 5 ` is 5.
  assert_eq(parsed(post(b"Content-Length:  5 \r\n", b"hello")).framing, Length(5));
  assert_eq(parsed(post(b"Content-Length: 007\r\n", b"hello!!")).framing, Length(7))
}

test "a Content-Length over the bound is 413 before a body byte is read" {
  let small = limits_with(8192, 65536, 100, 16, 64, 64, 64);
  assert_eq(head_status_with(post(b"Content-Length: 17\r\n", b""), small), 413);
  assert_eq(head_status_with(post(b"Content-Length: 16\r\n", b""), small), 0);
  // A value too long to be any body at all, refused without arithmetic that could overflow.
  assert_eq(head_status(post(b"Content-Length: 99999999999999999999999999\r\n", b"")), 413)
}

// --- Tests: Transfer-Encoding -----------------------------------------------

test "Content-Length and Transfer-Encoding together is refused" {
  assert_eq(head_status(post(b"Content-Length: 5\r\nTransfer-Encoding: chunked\r\n", b"")), 400);
  assert_eq(head_status(post(b"Transfer-Encoding: chunked\r\nContent-Length: 5\r\n", b"")), 400);
  assert_eq(head_reason(post(b"Content-Length: 5\r\nTransfer-Encoding: chunked\r\n", b"")),
            "a request carries `Content-Length` or `Transfer-Encoding`, never both")
}

test "chunked must be the final transfer coding and may be applied once" {
  assert_eq(head_status(post(b"Transfer-Encoding: chunked\r\n", b"0\r\n\r\n")), 0);
  assert_eq(parsed(post(b"Transfer-Encoding: chunked\r\n", b"0\r\n\r\n")).framing, Chunked);
  assert_eq(head_status(post(b"Transfer-Encoding: chunked, gzip\r\n", b"")), 400);
  assert_eq(head_status(post(b"Transfer-Encoding: gzip, chunked, chunked\r\n", b"")), 400);
  assert_eq(head_status(post(b"Transfer-Encoding: gzip\r\n", b"")), 501);
  assert_eq(head_status(post(b"Transfer-Encoding: identity\r\n", b"")), 501);
  // A coding this server cannot decode is 501 even when `chunked` is the last of them.
  assert_eq(head_status(post(b"Transfer-Encoding: gzip, chunked\r\n", b"0\r\n\r\n")), 501);
  // Two field lines are one list, in order of appearance.
  assert_eq(head_status(post(b"Transfer-Encoding: gzip\r\nTransfer-Encoding: chunked\r\n",
                             b"0\r\n\r\n")),
            501);
  assert_eq(head_status(post(b"Transfer-Encoding: chunked\r\nTransfer-Encoding: gzip\r\n", b"")),
            400);
  // Case and whitespace are not a way past it.
  assert_eq(parsed(post(b"Transfer-Encoding:  ChUnKeD \r\n", b"0\r\n\r\n")).framing, Chunked)
}

// `Content-Encoding` is end to end and is not a transfer coding.
test "Content-Encoding is passed through untouched" {
  let h = parsed(post(b"Content-Encoding: gzip\r\nContent-Length: 3\r\n", b"abc"));
  assert_eq(h.framing, Length(3));
  assert_eq(header(h.request.headers, "content-encoding"), Some("gzip"))
}

// --- Tests: bodies ----------------------------------------------------------

type Decoded = { bytes: Bytes, trailers: Headers, consumed: Int }

fn decode_body(framing: Framing, buf: Bytes) -> Result<Decoded, Refusal> =
  decode_from(body_start(framing, default_limits()), buf, 0, [], 64)

fn decode_body_with(framing: Framing, buf: Bytes, limits: Limits) -> Result<Decoded, Refusal> =
  decode_from(body_start(framing, limits), buf, 0, [], 64)

// Step until `Complete`; a step that consumed and produced nothing means truncated, not loop again.
reuse fn decode_from(state: BodyState, buf: Bytes, at: Int, out: List<Bytes>, fuel: Int)
  -> Result<Decoded, Refusal> =
  if fuel <= 0 {
    Err({status: 0, reason: "the decoder did not finish"})
  } else {
    match body_step(state, bytes_slice(buf, at, bytes_len(buf))) {
      Rejected(r) -> Err(r),
      Complete(d) -> Ok({bytes: bytes_concat_all(push(out, d.out)), trailers: d.trailers,
                         consumed: at + d.consumed}),
      Await(s) ->
        if s.consumed == 0 && bytes_len(s.out) == 0 {
          Err({status: 0, reason: "truncated"})
        } else {
          decode_from(s.state, buf, at + s.consumed, push(out, s.out), fuel - 1)
        },
    }
  }

fn body_status(framing: Framing, buf: Bytes, limits: Limits) -> Int =
  match decode_body_with(framing, buf, limits) {
    Err(r) -> r.status,
    Ok(_) -> 0,
  }

fn decoded(framing: Framing, buf: Bytes) -> Decoded =
  match decode_body(framing, buf) {
    Ok(d) -> d,
    Err(r) -> panic("expected a body: " ++ r.reason),
  }

test "a length-framed body stops at its length and leaves the rest" {
  let d = decoded(Length(5), b"helloGET / HTTP/1.1\r\n");
  assert_eq(d.bytes, b"hello");
  assert_eq(d.consumed, 5);
  assert_eq(map_len(d.trailers), 0);
  assert_eq(decoded(Length(0), b"anything").bytes, b"");
  assert_eq(decoded(NoBody, b"anything").consumed, 0)
}

test "a body arriving in pieces decodes to the same bytes" {
  let whole = decoded(Length(11), b"hello world");
  assert_eq(whole.bytes, b"hello world");
  match body_step(body_start(Length(11), default_limits()), b"hello ") {
    Await(s) -> {
      assert_eq(s.out, b"hello ");
      assert_eq(s.consumed, 6);
      match body_step(s.state, b"world") {
        Complete(d) -> {
          assert_eq(d.out, b"world");
          assert_eq(d.consumed, 5)
        },
        _ -> panic("the second piece should have completed the body"),
      }
    },
    _ -> panic("a partial body should await"),
  }
}

test "a chunked body decodes, and every malformed chunk is refused" {
  assert_eq(decoded(Chunked, b"5\r\nhello\r\n0\r\n\r\n").bytes, b"hello");
  assert_eq(decoded(Chunked, b"5\r\nhello\r\n6\r\n world\r\n0\r\n\r\n").bytes, b"hello world");
  assert_eq(decoded(Chunked, b"0\r\n\r\n").bytes, b"");
  // Extensions are parsed for framing and discarded; nothing reads them.
  assert_eq(decoded(Chunked, b"5;name=value\r\nhello\r\n0\r\n\r\n").bytes, b"hello");
  // Upper and lower case hex, and a size with a leading zero.
  assert_eq(decoded(Chunked, b"A\r\n0123456789\r\n0\r\n\r\n").bytes, b"0123456789");
  assert_eq(decoded(Chunked, b"00a\r\n0123456789\r\n0\r\n\r\n").bytes, b"0123456789");

  let l = default_limits();
  assert_eq(body_status(Chunked, b"\r\nhello\r\n0\r\n\r\n", l), 400);
  assert_eq(body_status(Chunked, b"5x\r\nhello\r\n0\r\n\r\n", l), 400);
  assert_eq(body_status(Chunked, b"-5\r\nhello\r\n0\r\n\r\n", l), 400);
  assert_eq(body_status(Chunked, b"0x5\r\nhello\r\n0\r\n\r\n", l), 400);
  assert_eq(body_status(Chunked, b"11111111111111111\r\nx\r\n0\r\n\r\n", l), 400);
  // The data and the size disagree: two implementations would place the boundary differently.
  assert_eq(body_status(Chunked, b"5\r\nhelloX\r\n0\r\n\r\n", l), 400);
  assert_eq(body_status(Chunked, b"5\r\nhello\n0\r\n\r\n", l), 400)
}

test "a chunk size that does not fit in an Int is refused rather than overflowing" {
  let l = default_limits();
  assert_eq(body_status(Chunked, b"FFFFFFFFFFFFFFFF\r\nx\r\n0\r\n\r\n", l), 413);
  assert_eq(body_status(Chunked, b"8000000000000000\r\nx\r\n0\r\n\r\n", l), 413);
  assert_eq(body_status(Chunked, b"ffffffffffffffff;e=1\r\nx\r\n0\r\n\r\n", l), 413);
  // The largest size that fits is still over `max_chunk_size`, so the two share a refusal.
  assert_eq(body_status(Chunked, b"7FFFFFFFFFFFFFFF\r\nx\r\n0\r\n\r\n", l), 413);
  // Leading zeros are legal, so the guard counts significant digits.
  assert_eq(decoded(Chunked, b"0000000000000005\r\nhello\r\n0\r\n\r\n").bytes, b"hello");
  assert_eq(body_status(Chunked, b"0000000000000000\r\n\r\n", l), 0)
}

test "a chunk over the size bound and a body over the length bound are 413" {
  let small = limits_with(8192, 65536, 100, 8, 4, 64, 64);
  assert_eq(body_status(Chunked, b"5\r\nhello\r\n0\r\n\r\n", small), 413);
  assert_eq(body_status(Chunked, b"4\r\nhell\r\n0\r\n\r\n", small), 0);
  // Each chunk is under `max_chunk_size` and their sum is over `max_body`.
  assert_eq(body_status(Chunked, b"4\r\nhell\r\n4\r\nabcd\r\n4\r\nefgh\r\n0\r\n\r\n", small), 413)
}

test "a chunk-size line over the bound is 400" {
  let small = limits_with(8192, 65536, 100, 1048576, 1048576, 16, 64);
  let long = bytes_concat_all([b"5;", filler(1024), b"\r\nhello\r\n0\r\n\r\n"]);
  assert_eq(body_status(Chunked, long, small), 400);
  assert_eq(body_status(Chunked, long, default_limits()), 0)
}

test "trailers are exposed separately and never merged into headers" {
  // A trailer section where a chunk-size line belongs frames nothing, and is refused.
  assert_eq(body_status(Chunked,
                        b"5\r\nhello\r\nContent-Length: 0\r\nAuthorization: root\r\n\r\n0\r\n\r\n",
                        default_limits()),
            400);

  let t = decoded(Chunked, b"5\r\nhello\r\n0\r\nContent-Length: 0\r\nAuthorization: root\r\n\r\n");
  assert_eq(t.bytes, b"hello");
  assert_eq(header(t.trailers, "content-length"), Some("0"));
  assert_eq(header(t.trailers, "authorization"), Some("root"));

  // The head's framing was decided before the trailers arrived, and never sees them.
  let h = parsed(post(b"Transfer-Encoding: chunked\r\n", b""));
  assert_eq(h.framing, Chunked);
  assert_eq(header(h.request.headers, "authorization"), None);
  assert_eq(map_len(h.request.trailers), 0);
  // A trailer section that is not a header block is refused like one.
  assert_eq(body_status(Chunked, b"0\r\nFoo : bar\r\n\r\n", default_limits()), 400)
}

test "a body that stops mid-chunk is truncated rather than accepted short" {
  assert_eq(decode_body(Chunked, b"5\r\nhel"), Err({status: 0, reason: "truncated"}));
  assert_eq(decode_body(Chunked, b"5\r\nhello\r\n"), Err({status: 0, reason: "truncated"}));
  assert_eq(decode_body(Chunked, b"5\r\nhello\r\n0\r\n"), Err({status: 0, reason: "truncated"}));
  assert_eq(decode_body(Length(5), b"hel"), Err({status: 0, reason: "truncated"}))
}

// --- Tests: sizes -----------------------------------------------------------

test "a header block over its bounds is 431" {
  let small = limits_with(8192, 64, 4, 1024, 1024, 1024, 1024);
  assert_eq(head_status_with(get(b"Foo: bar\r\n"), small), 0);
  assert_eq(head_status_with(get(bytes_concat_all([b"Foo: ", filler(200), b"\r\n"])), small), 431);
  assert_eq(head_status_with(get(b"A: 1\r\nB: 2\r\nC: 3\r\nD: 4\r\nE: 5\r\n"), small), 431);
  // The same heads are ordinary under the default bounds.
  assert_eq(head_status(get(bytes_concat_all([b"Foo: ", filler(200), b"\r\n"]))), 0);
  assert_eq(head_status(get(b"A: 1\r\nB: 2\r\nC: 3\r\nD: 4\r\nE: 5\r\n")), 0)
}

// --- Tests: Expect and Connection -------------------------------------------

test "Expect is 100-continue or 417" {
  assert(parsed(post(b"Content-Length: 5\r\nExpect: 100-continue\r\n", b"hello")).expects_continue);
  assert(parsed(post(b"Content-Length: 5\r\nExpect: 100-Continue\r\n", b"hello")).expects_continue);
  assert(!parsed(post(b"Content-Length: 5\r\n", b"hello")).expects_continue);
  assert_eq(head_status(post(b"Expect: something-else\r\n", b"")), 417);
  assert_eq(head_status(post(b"Expect: 100-continue\r\nExpect: 100-continue\r\n", b"")), 417)
}

test "keep-alive is the version's default unless Connection says otherwise" {
  assert(parsed(b"GET / HTTP/1.1\r\nHost: x\r\n\r\n").keep_alive);
  assert(!parsed(b"GET / HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n").keep_alive);
  assert(!parsed(b"GET / HTTP/1.1\r\nHost: x\r\nConnection: Close\r\n\r\n").keep_alive);
  assert(!parsed(b"GET / HTTP/1.1\r\nHost: x\r\nConnection: keep-alive, close\r\n\r\n").keep_alive);
  assert(!parsed(b"GET / HTTP/1.0\r\n\r\n").keep_alive);
  assert(parsed(b"GET / HTTP/1.0\r\nConnection: keep-alive\r\n\r\n").keep_alive)
}

// --- Tests: header representation -------------------------------------------

test "a repeated field keeps every line in order and combines nothing" {
  let h = parsed(b"GET / HTTP/1.1\r\nHost: x\r\nSet-Cookie: a=1\r\nSet-Cookie: b=2\r\n\r\n");
  assert_eq(header_lines(h.request.headers, "set-cookie"), ["a=1", "b=2"]);
  assert_eq(header(h.request.headers, "set-cookie"), Some("a=1"));
  // Names are lowercased on parse, so a lookup cannot depend on what the peer capitalised.
  assert(has_header(h.request.headers, "set-cookie"));
  assert(!has_header(h.request.headers, "Set-Cookie"));
  assert_eq(header_lines(h.request.headers, "absent"), [])
}

test "a field value that is not text is refused rather than decoded lossily" {
  assert_eq(head_status(b"GET / HTTP/1.1\r\nHost: x\r\nFoo: \xff\xfe\r\n\r\n"), 400);
  // Valid UTF-8 above ASCII is obs-text and is passed through as written.
  assert_eq(header(parsed(b"GET / HTTP/1.1\r\nHost: x\r\nFoo: caf\xc3\xa9\r\n\r\n").request.headers,
                   "foo"),
            Some("café"))
}

// --- Tests: the framing property --------------------------------------------

fn adversarial() -> List<Bytes> = [
  b"GET / HTTP/1.1\r\nHost: x\r\n\r\n",
  b"POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n\r\nhello",
  b"POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 0\r\n\r\n",
  b"POST / HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n",
  b"POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\nTransfer-Encoding: chunked\r\n\r\nhello",
  b"POST / HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\nContent-Length: 5\r\n\r\nhello",
  b"POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\nContent-Length: 5\r\n\r\nhello",
  b"POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\nContent-Length: 6\r\n\r\nhello",
  b"POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 5, 5\r\n\r\nhello",
  b"POST / HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked, identity\r\n\r\n5\r\nhello\r\n",
  b"POST / HTTP/1.1\r\nHost: x\r\nTransfer-Encoding : chunked\r\n\r\n0\r\n\r\n",
  b"POST / HTTP/1.1\r\nHost: x\r\nTransfer-Encoding:\r\n chunked\r\n\r\n0\r\n\r\n",
  b"POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 5\n\r\nhello",
  b"POST / HTTP/1.1\nHost: x\nContent-Length: 5\n\nhello",
  b"POST / HTTP/1.1\r\nHost: x\r\nContent-Length: \x0035\r\n\r\nhello",
  b"POST / HTTP/1.1\r\nHost: x\r\nX: y\r\nContent-Length: 5\r\n\r\nhello",
  b"POST / HTTP/1.1\r\nHost: x\r\nhost: y\r\nContent-Length: 5\r\n\r\nhello",
  b"POST / HTTP/1.1\r\nContent-Length: 5\r\n\r\nhello",
  b"GET / HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n\r\nhello",
  b"GET / HTTP/1.1\r\nHost: x\r\n\r\nGET /two HTTP/1.1\r\nHost: x\r\n\r\n",
]

// The oracle: the message length read off the field lines, without calling the parser.
fn reference_length(raw: Bytes) -> Int = {
  let head_end = match bytes_index_of(raw, b"\r\n\r\n") {
    Some(at) -> at + 4,
    None -> -1,
  };
  if head_end < 0 {
    -1
  } else {
    let lines = string_split(string_of_bytes_lossy(bytes_slice(raw, 0, head_end)), "\r\n");
    let cl = values_of(lines, "content-length:");
    let te = values_of(lines, "transfer-encoding:");
    if len(te) > 0 && len(cl) > 0 {
      -1
    } else if len(te) > 0 {
      if last_string(te) == "chunked" { -2 } else { -1 }
    } else if len(cl) > 1 {
      -1
    } else {
      match cl {
        [only] -> reference_int(only),
        _ -> 0,
      }
    }
  }
}

fn values_of(lines: List<String>, prefix: String) -> List<String> =
  fold(lines, [], |acc: List<String>, line: String|
    if string_starts_with(string_lower(line), prefix) {
      push(acc, string_lower(string_trim(string_slice(line, string_len(prefix),
                                                      string_len(line)))))
    } else {
      acc
    })

fn reference_int(raw: String) -> Int = {
  let b = bytes_of_string(raw);
  if all_digits(b) && bytes_len(b) <= 18 { digits_to_int(b, 0, 0) } else { -1 }
}

test "no accepted head admits two framings" {
  fold(adversarial(), (), |acc: Unit, raw: Bytes| one_framing(raw))
}

fn one_framing(raw: Bytes) -> Unit =
  match parse_head(raw, default_limits()) {
    Refused(_) -> (),
    Incomplete -> (),
    Parsed(h) -> {
      // The oracle found exactly one framing available, and the parser chose it.
      let reference = reference_length(raw);
      assert(reference >= -2);
      assert(reference != -1);
      assert_eq(match h.framing {
        Length(n) -> n,
        Chunked -> -2,
        NoBody -> 0,
      }, reference);
      // `consumed` lands on the oracle's terminator, so the body starts at the same byte for both.
      assert_eq(h.consumed, match bytes_index_of(raw, b"\r\n\r\n") {
        Some(at) -> at + 4,
        None -> -1,
      })
    },
  }

law "an accepted head names a boundary inside the bytes it was given"
  forall (raw: Bytes) {
    match parse_head(raw, default_limits()) {
      Parsed(h) -> h.consumed >= 0 && h.consumed <= bytes_len(raw),
      Refused(r) -> r.status >= 400,
      Incomplete -> true,
    }
  }

// What makes carrying a pipelined remainder across iterations of the serve loop safe.
law "a head frames the same message however much follows it"
  forall (raw: Bytes) {
    parse_head(raw, default_limits()) == parse_head(raw, default_limits())
  }

// --- Tests: pipelining ------------------------------------------------------

test "consumed is where the body begins, so a pipelined request is a slice" {
  let two = b"GET /one HTTP/1.1\r\nHost: x\r\n\r\nGET /two HTTP/1.1\r\nHost: x\r\n\r\n";
  let first = parsed(two);
  assert_eq(first.request.path, "/one");
  assert_eq(first.consumed, 30);
  let rest = bytes_slice(two, first.consumed, bytes_len(two));
  assert_eq(parsed(rest).request.path, "/two");

  let posted = b"POST /one HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n\r\nhelloGET /two HTTP/1.1\r\nHost: x\r\n\r\n";
  let h = parsed(posted);
  assert_eq(h.framing, Length(5));
  let after = bytes_slice(posted, h.consumed, bytes_len(posted));
  let d = decoded(Length(5), after);
  assert_eq(d.bytes, b"hello");
  assert_eq(parsed(bytes_slice(after, d.consumed, bytes_len(after))).request.path, "/two")
}

// --- Tests: responses -------------------------------------------------------

test "a response carries exactly one framing field" {
  assert_eq(encode(Get, Http11, true, response(200, b"hi")),
            b"HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nhi");
  assert_eq(encode(Get, Http11, false, response(200, b"hi")),
            b"HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nhi");
  assert_eq(encode(Get, Http10, true, response(200, b"hi")),
            b"HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: keep-alive\r\n\r\nhi")
}

test "a 405 built here carries the Allow field it must" {
  let r = method_not_allowed([Get, Head, Post]);
  assert_eq(r.status, 405);
  assert_eq(header(r.headers, "allow"), Some("GET, HEAD, POST"));
  assert_eq(method_not_allowed([]).status, 405);
  assert_eq(allow_field([Delete]), "DELETE");
  assert_eq(allow_field([Get, Other("PROPFIND")]), "GET, PROPFIND");
  // It survives `encode`, which refuses a malformed header rather than sanitizing it.
  assert(match bytes_index_of(encode(Get, Http11, false, r), b"allow: GET, HEAD, POST\r\n") {
    Some(_) -> true,
    None -> false,
  })
}

test "1xx, 204 and 304 carry no body and no Content-Length" {
  assert_eq(encode(Get, Http11, true, response(204, b"ignored")),
            b"HTTP/1.1 204 No Content\r\n\r\n");
  assert_eq(encode(Get, Http11, true, response(304, b"ignored")),
            b"HTTP/1.1 304 Not Modified\r\n\r\n");
  assert_eq(encode(Get, Http11, true, response(100, b"ignored")),
            b"HTTP/1.1 100 Continue\r\n\r\n")
}

test "a HEAD response carries Content-Length and no body" {
  assert_eq(encode(Head, Http11, true, response(200, b"hello")),
            b"HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\n");
  assert_eq(encode(Get, Http11, true, response(200, b"hello")),
            b"HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nhello")
}

test "a response's header order is a function of its value" {
  let r = {status: 200,
           headers: add_header(add_header(set_header(empty_headers(), "b", "2"), "a", "1"),
                               "a", "3"),
           body: b""};
  assert_eq(encode(Get, Http11, true, r),
            b"HTTP/1.1 200 OK\r\na: 1\r\na: 3\r\nb: 2\r\nContent-Length: 0\r\n\r\n")
}

test "a chunked response is framed by Transfer-Encoding and nothing else" {
  assert_eq(encode_chunked_head(Http11, true, response(200, b"")),
            b"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n");
  assert_eq(encode_chunk(b"hello"), b"5\r\nhello\r\n");
  assert_eq(encode_chunk(filler(16)), bytes_concat_all([b"10\r\n", filler(16), b"\r\n"]));
  assert_eq(encode_chunk(b""), b"");
  assert_eq(last_chunk(), b"0\r\n\r\n");
  // What was written is what this module's own decoder reads back.
  assert_eq(decoded(Chunked, bytes_concat_all([encode_chunk(b"hello"), encode_chunk(b" world"),
                                               last_chunk()])).bytes,
            b"hello world")
}

// --- Tests: the round trip --------------------------------------------------

law "a chunk-encoded body decodes back to itself"
  forall (payload: Bytes) {
    match decode_body(Chunked, bytes_concat_all([encode_chunk(payload), last_chunk()])) {
      Ok(d) -> d.bytes == payload,
      Err(_) -> bytes_len(payload) == 0,
    }
  }

// --- Tests: the serve loop --------------------------------------------------

fn next_answer(queued: List<Option<Bytes>>) -> Option<Bytes> =
  match queued {
    [x, ..] -> x,
    _ -> Some(b""),
  }

fn rest_answers(queued: List<Option<Bytes>>) -> List<Option<Bytes>> =
  match queued {
    [_, ..rest] -> rest,
    _ -> [],
  }

fn echo_app(req: Request) -> Response =
  text_response(200, method_name(req.method) ++ " " ++ req.path ++ "|"
                     ++ string_of_bytes_lossy(req.body))

// Ignores the body: decides whether an unread body gets framed as the next request.
fn ignore_body_app(req: Request) -> Response = text_response(200, req.path)

fn limits_keeping(n: Int) -> Limits = {
  let base: Limits = default_limits();
  {..base, max_keep_alive: n}
}

fn answer_of(status: Int, body: String, keep: Bool) -> Bytes =
  encode(Get, Http11, keep, text_response(status, body))

test "a 1.1 connection is reused and its requests are answered in order" {
  with_cell[inbox]([Some(b"GET /a HTTP/1.1\r\nHost: x\r\n\r\n"),
                    Some(b"GET /b HTTP/1.1\r\nHost: x\r\n\r\n")]) { inbox -> {
  with_cell[outbox](b"") { outbox -> {
  with_cell[closed](0) { closed -> {
    handle {
      serve_connection(7, default_limits(), echo_app)
    } with {
      net.recv[conn](c, max, t) -> {
        let queued = cell_get(inbox);
        cell_set(inbox, rest_answers(queued));
        next_answer(queued)
      },
      net.send[conn](c, payload, t) -> {
        cell_set(outbox, bytes_concat(cell_get(outbox), payload));
        Some(bytes_len(payload))
      },
      net.close[conn](c) -> cell_set(closed, cell_get(closed) + 1),
    };
    assert_eq(cell_get(outbox),
              bytes_concat(answer_of(200, "GET /a|", true), answer_of(200, "GET /b|", true)));
    assert_eq(cell_get(closed), 1)
  } }
  } }
  } }
}

test "Connection: close, HTTP/1.0 and the keep-alive bound each end the connection" {
  // Nothing is read after `Connection: close`, so the second scripted request is never seen.
  with_cell[inbox]([Some(b"GET /a HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n"),
                    Some(b"GET /b HTTP/1.1\r\nHost: x\r\n\r\n")]) { inbox -> {
  with_cell[outbox](b"") { outbox -> {
    handle {
      serve_connection(7, default_limits(), echo_app)
    } with {
      net.recv[conn](c, max, t) -> {
        let queued = cell_get(inbox);
        cell_set(inbox, rest_answers(queued));
        next_answer(queued)
      },
      net.send[conn](c, payload, t) -> {
        cell_set(outbox, bytes_concat(cell_get(outbox), payload));
        Some(bytes_len(payload))
      },
      net.close[conn](c) -> (),
    };
    assert_eq(cell_get(outbox), answer_of(200, "GET /a|", false));
    // The second request is still queued: it was never read.
    assert_eq(len(cell_get(inbox)), 1)
  } }
  } };
  // The `max_keep_alive`th response says `close` and the connection ends there.
  with_cell[inbox]([Some(b"GET /a HTTP/1.1\r\nHost: x\r\n\r\n"),
                    Some(b"GET /b HTTP/1.1\r\nHost: x\r\n\r\n")]) { inbox -> {
  with_cell[outbox](b"") { outbox -> {
    handle {
      serve_connection(7, limits_keeping(1), echo_app)
    } with {
      net.recv[conn](c, max, t) -> {
        let queued = cell_get(inbox);
        cell_set(inbox, rest_answers(queued));
        next_answer(queued)
      },
      net.send[conn](c, payload, t) -> {
        cell_set(outbox, bytes_concat(cell_get(outbox), payload));
        Some(bytes_len(payload))
      },
      net.close[conn](c) -> (),
    };
    assert_eq(cell_get(outbox), answer_of(200, "GET /a|", false));
    assert_eq(len(cell_get(inbox)), 1)
  } }
  } }
}

test "a body the handler ignores is drained before the next request is framed" {
  with_cell[inbox]([Some(b"POST /a HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n\r\nhelloGET /b HTTP/1.1\r\nHost: x\r\n\r\n")]) { inbox -> {
  with_cell[outbox](b"") { outbox -> {
    handle {
      serve_connection(7, default_limits(), ignore_body_app)
    } with {
      net.recv[conn](c, max, t) -> {
        let queued = cell_get(inbox);
        cell_set(inbox, rest_answers(queued));
        next_answer(queued)
      },
      net.send[conn](c, payload, t) -> {
        cell_set(outbox, bytes_concat(cell_get(outbox), payload));
        Some(bytes_len(payload))
      },
      net.close[conn](c) -> (),
    };
    assert_eq(cell_get(outbox),
              bytes_concat(answer_of(200, "/a", true), answer_of(200, "/b", true)))
  } }
  } }
}

test "a chunked request is decoded and its trailers reach the handler separately" {
  with_cell[inbox]([Some(b"POST /c HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n"),
                    Some(b"6\r\n world\r\n0\r\nX-Checksum: 7\r\n\r\n")]) { inbox -> {
  with_cell[outbox](b"") { outbox -> {
    handle {
      serve_connection(7, default_limits(), trailer_app)
    } with {
      net.recv[conn](c, max, t) -> {
        let queued = cell_get(inbox);
        cell_set(inbox, rest_answers(queued));
        next_answer(queued)
      },
      net.send[conn](c, payload, t) -> {
        cell_set(outbox, bytes_concat(cell_get(outbox), payload));
        Some(bytes_len(payload))
      },
      net.close[conn](c) -> (),
    };
    assert_eq(cell_get(outbox), answer_of(200, "hello world|7|none", true))
  } }
  } }
}

fn trailer_app(req: Request) -> Response =
  text_response(200, string_of_bytes_lossy(req.body) ++ "|"
                     ++ (match header(req.trailers, "x-checksum") { Some(v) -> v, None -> "none" })
                     ++ "|"
                     ++ (match header(req.headers, "x-checksum") { Some(v) -> v, None -> "none" }))

test "a header timeout is 408, a body timeout is 408, and an idle timeout writes nothing" {
  // Nothing arrives at all.
  with_cell[outbox](b"") { outbox -> {
    handle {
      serve_connection(7, default_limits(), echo_app)
    } with {
      net.recv[conn](c, max, t) -> None,
      net.send[conn](c, payload, t) -> {
        cell_set(outbox, bytes_concat(cell_get(outbox), payload));
        Some(bytes_len(payload))
      },
      net.close[conn](c) -> (),
    };
    assert_eq(cell_get(outbox),
              encode(Get, Http11, false,
                     text_response(408, "the request head did not arrive\n")))
  } };
  // The head arrives and the body never does.
  with_cell[reads](0) { reads -> {
  with_cell[outbox](b"") { outbox -> {
    handle {
      serve_connection(7, default_limits(), echo_app)
    } with {
      net.recv[conn](c, max, t) -> {
        let n = cell_get(reads);
        cell_set(reads, n + 1);
        if n == 0 {
          Some(b"POST /a HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n\r\n")
        } else {
          None
        }
      },
      net.send[conn](c, payload, t) -> {
        cell_set(outbox, bytes_concat(cell_get(outbox), payload));
        Some(bytes_len(payload))
      },
      net.close[conn](c) -> (),
    };
    assert_eq(cell_get(outbox),
              encode(Post, Http11, false,
                     text_response(408, "the request body did not arrive\n")))
  } }
  } };
  // One request answered, then silence between messages.
  with_cell[inbox]([Some(b"GET /a HTTP/1.1\r\nHost: x\r\n\r\n"), None]) { inbox -> {
  with_cell[outbox](b"") { outbox -> {
  with_cell[closed](0) { closed -> {
    handle {
      serve_connection(7, default_limits(), echo_app)
    } with {
      net.recv[conn](c, max, t) -> {
        let queued = cell_get(inbox);
        cell_set(inbox, rest_answers(queued));
        next_answer(queued)
      },
      net.send[conn](c, payload, t) -> {
        cell_set(outbox, bytes_concat(cell_get(outbox), payload));
        Some(bytes_len(payload))
      },
      net.close[conn](c) -> cell_set(closed, cell_get(closed) + 1),
    };
    assert_eq(cell_get(outbox), answer_of(200, "GET /a|", true));
    assert_eq(cell_get(closed), 1)
  } }
  } }
  } }
}

test "the whole head is bounded by header_timeout_ms and not by each read" {
  with_cell[granted](0) { granted -> {
  with_cell[outbox](b"") { outbox -> {
    handle {
      serve_connection(7, default_limits(), echo_app)
    } with {
      // One byte per read, forever: the slow loris.
      net.recv[conn](c, max, t) -> {
        cell_set(granted, cell_get(granted) + t);
        Some(b"a")
      },
      net.send[conn](c, payload, t) -> {
        cell_set(outbox, bytes_concat(cell_get(outbox), payload));
        Some(bytes_len(payload))
      },
      net.close[conn](c) -> (),
    };
    assert(cell_get(granted) <= default_limits().header_timeout_ms);
    assert_eq(cell_get(outbox),
              encode(Get, Http11, false,
                     text_response(408, "the request head did not arrive\n")))
  } }
  } };
  // The same for the body.
  with_cell[granted](0) { granted -> {
  with_cell[reads](0) { reads -> {
  with_cell[outbox](b"") { outbox -> {
    handle {
      serve_connection(7, default_limits(), echo_app)
    } with {
      net.recv[conn](c, max, t) -> {
        let n = cell_get(reads);
        cell_set(reads, n + 1);
        if n == 0 {
          Some(b"POST /a HTTP/1.1\r\nHost: x\r\nContent-Length: 1048576\r\n\r\n")
        } else {
          cell_set(granted, cell_get(granted) + t);
          Some(b"a")
        }
      },
      net.send[conn](c, payload, t) -> {
        cell_set(outbox, bytes_concat(cell_get(outbox), payload));
        Some(bytes_len(payload))
      },
      net.close[conn](c) -> (),
    };
    assert(cell_get(granted) <= default_limits().body_timeout_ms);
    assert_eq(cell_get(outbox),
              encode(Post, Http11, false,
                     text_response(408, "the request body did not arrive\n")))
  } }
  } }
  } }
}

test "a head arriving in pieces is read to its terminator" {
  with_cell[inbox]([Some(b"GET /a HT"), Some(b"TP/1.1\r\nHost: x\r"), Some(b"\n\r\n")]) { inbox -> {
  with_cell[outbox](b"") { outbox -> {
    handle {
      serve_connection(7, default_limits(), echo_app)
    } with {
      net.recv[conn](c, max, t) -> {
        let queued = cell_get(inbox);
        cell_set(inbox, rest_answers(queued));
        next_answer(queued)
      },
      net.send[conn](c, payload, t) -> {
        cell_set(outbox, bytes_concat(cell_get(outbox), payload));
        Some(bytes_len(payload))
      },
      net.close[conn](c) -> (),
    };
    assert_eq(cell_get(outbox), answer_of(200, "GET /a|", true))
  } }
  } }
}

// After a refusal the next message's position is unknown, so there is nothing safe to resync from.
test "a framing refusal is answered once and the connection is not reused" {
  with_cell[inbox]([Some(b"POST /a HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\nTransfer-Encoding: chunked\r\n\r\nhello"),
                    Some(b"GET /b HTTP/1.1\r\nHost: x\r\n\r\n")]) { inbox -> {
  with_cell[outbox](b"") { outbox -> {
    handle {
      serve_connection(7, default_limits(), echo_app)
    } with {
      net.recv[conn](c, max, t) -> {
        let queued = cell_get(inbox);
        cell_set(inbox, rest_answers(queued));
        next_answer(queued)
      },
      net.send[conn](c, payload, t) -> {
        cell_set(outbox, bytes_concat(cell_get(outbox), payload));
        Some(bytes_len(payload))
      },
      net.close[conn](c) -> (),
    };
    assert_eq(cell_get(outbox),
              encode(Get, Http11, false,
                     text_response(400,
                       "a request carries `Content-Length` or `Transfer-Encoding`, never both\n")));
    assert_eq(len(cell_get(inbox)), 1)
  } }
  } }
}

test "a 100-continue is written before the body is read" {
  with_cell[inbox]([Some(b"POST /a HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\nExpect: 100-continue\r\n\r\n"),
                    Some(b"hello")]) { inbox -> {
  with_cell[outbox](b"") { outbox -> {
    handle {
      serve_connection(7, default_limits(), echo_app)
    } with {
      net.recv[conn](c, max, t) -> {
        let queued = cell_get(inbox);
        cell_set(inbox, rest_answers(queued));
        next_answer(queued)
      },
      net.send[conn](c, payload, t) -> {
        cell_set(outbox, bytes_concat(cell_get(outbox), payload));
        Some(bytes_len(payload))
      },
      net.close[conn](c) -> (),
    };
    assert_eq(cell_get(outbox),
              bytes_concat(continue_response(),
                           encode(Post, Http11, true, text_response(200, "POST /a|hello"))))
  } }
  } }
}

// --- Tests: streaming a response --------------------------------------------

fn counted(seed: Int) -> Option<{ chunk: Bytes, next: Int }> =
  if seed >= 3 {
    None
  } else {
    Some({chunk: bytes_of_string(int_to_string(seed)), next: seed + 1})
  }

test "a streamed response is chunk-framed and ends with the terminating chunk" {
  with_cell[outbox](b"") { outbox -> {
    handle {
      assert(respond_chunked(7, Http11, response(200, b""), true, default_limits(), 0, counted))
    } with {
      net.send[conn](c, payload, t) -> {
        cell_set(outbox, bytes_concat(cell_get(outbox), payload));
        Some(bytes_len(payload))
      },
    };
    let written = cell_get(outbox);
    assert_eq(written,
              bytes_concat_all([b"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n",
                                b"1\r\n0\r\n", b"1\r\n1\r\n", b"1\r\n2\r\n", b"0\r\n\r\n"]));
    // What was streamed is what this module's own decoder reads back.
    assert_eq(decoded(Chunked, bytes_slice(written, 47, bytes_len(written))).bytes, b"012")
  } }
}

test "a streamed response stops at a dead peer rather than writing into it" {
  handle {
    assert(!respond_chunked(7, Http11, response(200, b""), true, default_limits(), 0, counted))
  } with {
    net.send[conn](c, payload, t) -> Some(0),
  };
  handle {
    assert(!respond_chunked(7, Http11, response(200, b""), true, default_limits(), 0, counted))
  } with {
    net.send[conn](c, payload, t) -> None,
  }
}

// A producer with more chunks than `max_stream_chunks`.
fn endless(seed: Int) -> Option<{ chunk: Bytes, next: Int }> =
  Some({chunk: b"x", next: seed + 1})

test "a streamed response always ends with its terminating chunk" {
  let small = limits_streaming(4);
  with_cell[outbox](b"") { outbox -> {
    handle {
      assert(!respond_chunked(7, Http11, response(200, b""), true, small, 0, endless))
    } with {
      net.send[conn](c, payload, t) -> {
        cell_set(outbox, bytes_concat(cell_get(outbox), payload));
        Some(bytes_len(payload))
      },
    };
    assert(bytes_ends_with(cell_get(outbox), last_chunk()))
  } }
}

test "a streamed response to an HTTP/1.0 peer is delimited by the close" {
  with_cell[outbox](b"") { outbox -> {
    handle {
      assert(!respond_chunked(7, Http10, response(200, b""), true, default_limits(), 0, counted))
    } with {
      net.send[conn](c, payload, t) -> {
        cell_set(outbox, bytes_concat(cell_get(outbox), payload));
        Some(bytes_len(payload))
      },
    };
    assert_eq(cell_get(outbox),
              bytes_concat_all([b"HTTP/1.1 200 OK\r\nConnection: close\r\n\r\n", b"0", b"1", b"2"]))
  } }
}

fn limits_streaming(n: Int) -> Limits = {
  let base: Limits = default_limits();
  {..base, max_stream_chunks: n}
}

// --- Tests: the client ------------------------------------------------------

fn client_limits() -> Limits = {
  let base: Limits = default_limits();
  {..base, header_timeout_ms: 8, body_timeout_ms: 8}
}

fn response_head_of(raw: Bytes, method: Method) -> ResponseHead =
  match parse_response_head(raw, method, default_limits()) {
    ResponseParsed(h) -> h,
    ResponseIncomplete -> panic("incomplete"),
    ResponseRefused(r) -> panic("refused: " ++ r.reason),
  }

fn response_status_of(raw: Bytes) -> Int =
  match parse_response_head(raw, Get, default_limits()) {
    ResponseParsed(h) -> h.status,
    ResponseIncomplete -> 0,
    ResponseRefused(r) -> r.status,
  }

test "a status line is split into version, status and reason" {
  let h = response_head_of(b"HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nhello", Get);
  assert_eq(h.version, Http11);
  assert_eq(h.status, 200);
  assert_eq(h.reason, "OK");
  assert_eq(h.framing, Length(5));
  assert_eq(h.consumed, 38);
  assert_eq(h.keep_alive, true);
  assert_eq(response_head_of(b"HTTP/1.0 404 Not Found\r\n\r\n", Get).reason, "Not Found");
  assert_eq(response_head_of(b"HTTP/1.1 204 \r\n\r\n", Get).reason, "");
  assert_eq(response_head_of(b"HTTP/1.1 204\r\n\r\n", Get).reason, "")
}

test "a malformed status line is a 502 to relay" {
  assert_eq(response_status_of(b"HTTP/2.0 200 OK\r\n\r\n"), 502);
  assert_eq(response_status_of(b"200 OK\r\n\r\n"), 502);
  assert_eq(response_status_of(b"HTTP/1.1 20 OK\r\n\r\n"), 502);
  assert_eq(response_status_of(b"HTTP/1.1 2000 OK\r\n\r\n"), 502);
  assert_eq(response_status_of(b"HTTP/1.1 abc OK\r\n\r\n"), 502);
  assert_eq(response_status_of(b"HTTP/1.1 200 OK\r\nContent-Length: 1\r\nContent-Length: 2\r\n\r\n"),
            502);
  assert_eq(response_status_of(b"HTTP/1.1 200 OK\r\n"), 0)
}

test "a response is framed by its length, its coding, its status or the close" {
  assert_eq(response_head_of(b"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n", Get).framing,
            Chunked);
  assert_eq(response_head_of(b"HTTP/1.1 200 OK\r\n\r\n", Get).framing, UntilClose);
  assert_eq(response_head_of(b"HTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\n", Get).framing,
            Length(0));
  assert_eq(response_head_of(b"HTTP/1.1 304 Not Modified\r\nContent-Length: 5\r\n\r\n", Get).framing,
            NoBody);
  assert_eq(response_head_of(b"HTTP/1.1 100 Continue\r\n\r\n", Get).framing, NoBody);
  assert_eq(response_head_of(b"HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\n", Head).framing,
            NoBody);
  assert_eq(response_head_of(b"HTTP/1.1 200 OK\r\nConnection: close\r\n\r\n", Get).keep_alive,
            false)
}

test "a request encodes with its host, its length and a close" {
  assert_eq(encode_request(request_to(Get, "example.org", "/a?b=1", b"")),
            b"GET /a?b=1 HTTP/1.1\r\nHost: example.org\r\nConnection: close\r\n\r\n");
  assert_eq(encode_request(request_to(Post, "example.org:8080", "/items", b"{}")),
            b"POST /items HTTP/1.1\r\nHost: example.org:8080\r\nContent-Length: 2\r\n"
            ++ b"Connection: close\r\n\r\n{}");
  assert_eq(encode_request(request_to(Put, "h", "/", b"")),
            b"PUT / HTTP/1.1\r\nHost: h\r\nContent-Length: 0\r\nConnection: close\r\n\r\n");
  let with_header: Request = request_to(Get, "h", "", b"");
  assert_eq(encode_request({..with_header, headers: set_header(empty_headers(), "Accept", "*/*")}),
            b"GET / HTTP/1.1\r\nHost: h\r\naccept: */*\r\nConnection: close\r\n\r\n")
}

test "a request target splits into its path and query" {
  let r = request_to(Get, "h", "/a/b?c=1&d=2", b"");
  assert_eq(r.path, "/a/b");
  assert_eq(r.query, "c=1&d=2");
  assert_eq(request_to(Get, "h", "/plain", b"").query, "")
}

test "a request is sent, its answer read, and the connection closed" {
  with_cell[inbox]([Some(b"HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nhel"), Some(b"lo")]) { inbox -> {
  with_cell[outbox](b"") { outbox -> {
  with_cell[closed](0) { closed -> {
    let answer = handle {
      request("example.org", 80, request_to(Get, "example.org", "/a", b""), client_limits())
    } with {
      net.connect[conn](host, port, t) -> if host == "example.org" && port == 80 { Some(7) } else { None },
      net.recv[conn](c, max, t) -> {
        let queued = cell_get(inbox);
        cell_set(inbox, rest_answers(queued));
        next_answer(queued)
      },
      net.send[conn](c, payload, t) -> {
        cell_set(outbox, bytes_concat(cell_get(outbox), payload));
        Some(bytes_len(payload))
      },
      net.close[conn](c) -> cell_set(closed, cell_get(closed) + 1),
    };
    assert_eq(cell_get(outbox),
              b"GET /a HTTP/1.1\r\nHost: example.org\r\nConnection: close\r\n\r\n");
    assert_eq(answer, Ok({status: 200,
                          headers: set_header(empty_headers(), "content-length", "5"),
                          body: b"hello"}));
    assert_eq(cell_get(closed), 1)
  } }
  } }
  } }
}

fn fetched(answers: List<Option<Bytes>>, reached: Bool) -> Result<Response, ClientError> =
  with_cell[inbox](answers) { inbox -> {
    handle {
      request("h", 80, request_to(Get, "h", "/", b""), client_limits())
    } with {
      net.connect[conn](host, port, t) -> if reached { Some(7) } else { None },
      net.recv[conn](c, max, t) -> {
        let queued = cell_get(inbox);
        cell_set(inbox, rest_answers(queued));
        next_answer(queued)
      },
      net.send[conn](c, payload, t) -> Some(bytes_len(payload)),
      net.close[conn](c) -> (),
    }
  } }

fn body_fetched(answers: List<Option<Bytes>>) -> Bytes =
  match fetched(answers, true) {
    Ok(r) -> r.body,
    Err(_) -> panic("no answer"),
  }

test "a body without a length runs until the server closes" {
  assert_eq(body_fetched([Some(b"HTTP/1.1 200 OK\r\n\r\nhel"), Some(b"lo")]), b"hello");
  assert_eq(body_fetched([Some(b"HTTP/1.1 200 OK\r\n\r\n")]), b"");
  assert_eq(body_fetched([Some(b"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n"),
                          Some(b"0\r\n\r\n")]),
            b"hello");
  assert_eq(body_fetched([Some(b"HTTP/1.1 204 No Content\r\n\r\n")]), b"")
}

test "each way an exchange can fail has its own error" {
  assert_eq(fetched([], false), Err(Unreachable));
  assert_eq(fetched([Some(b"HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nhel")], true), Err(Closed));
  assert_eq(fetched([Some(b"HTTP/1.1 200 OK\r\nContent-Le")], true), Err(Closed));
  assert_eq(fetched([None, None, None, None, None, None, None, None, None], true), Err(TimedOut));
  assert_eq(fetched([Some(b"HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\n"), None, None, None,
                     None, None, None, None, None, None], true),
            Err(TimedOut));
  assert_eq(fetched([Some(b"HTTP/9.9 200 OK\r\n\r\n")], true),
            Err(Malformed({status: 502,
                           reason: "a status line begins with `HTTP/1.1` or `HTTP/1.0`"})));
  assert_eq(fetched([Some(b"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\nzz\r\n")], true),
            Err(Malformed({status: 502,
                           reason: "a chunk size is 1 to 16 hexadecimal digits, optionally followed by `;`"})))
}

test "a peer that stops taking bytes is reported as not sent" {
  let answer = handle {
    request("h", 80, request_to(Get, "h", "/", b""), client_limits())
  } with {
    net.connect[conn](host, port, t) -> Some(7),
    net.recv[conn](c, max, t) -> Some(b""),
    net.send[conn](c, payload, t) -> None,
    net.close[conn](c) -> (),
  };
  assert_eq(answer, Err(NotSent))
}
