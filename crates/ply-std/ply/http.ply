//! HTTP/1.1, and HTTP/2 over `std.http2`: messages as values, framing, serve loops and a client.
//!
//! Parsing and encoding are pure; the serve loop and the client perform `net` under the labels a caller
//! fills. An ambiguous message is refused and the connection closed, and every loop is bounded by
//! `Limits`. Every connection the module opens or accepts is closed however serving it ends, an `app`
//! a clause unwinds out of included. `std.coding` codes bodies and `std.websocket` upgrades a
//! connection.
//!
//! A body is `Whole` bytes or `Streamed`: a `std.seq` sequence of chunks, made as it is pulled, its
//! length where that is known, and what lets go of what makes it. A response's chunks are pulled as
//! they are sent, under `Content-Length` where the stream names its length, chunk-framed over
//! HTTP/1.1 where it does not, and over HTTP/2 as `DATA` frames as the stream's window takes them,
//! so a body of any size is sent in the memory of a few chunks; an answer to `HEAD` pulls none. A
//! served HTTP/1.1 request's body is a stream too, read from the connection a piece at a time as the
//! `Handler` pulls it, under `max_body` and `body_timeout_ms`: pulling performs `incoming`, which
//! the serving loop answers, and a body refused on the way is answered with its status. What a
//! handler leaves of a body is read past before the next request, and a client still holding its
//! body back for `100 Continue` is told to send it at the first pull, and never where there is none.
//!
//! A request's `multipart/form-data` body is read by `form` through `std.multipart`; `dated` and
//! `last_modified` write `std.date`'s HTTP dates; `negotiate` picks among the types a resource is
//! offered in by the request's `Accept`, and `negotiated` answers with it and says the answer
//! varies by `Accept`. `std.cookie` reads and sets cookies, `std.cors` answers cross-origin
//! requests, and `std.static` serves files.
//!
//! `fetch` asks for a `std.url` `Url`, over TLS for `https`, follows redirects and keeps a
//! `std.cookie` jar, and goes through a proxy where it is given one; `request`, `dial` and `ask`
//! are the exchange underneath, on a host and port.
//!
//! A request served over TLS carries the certificate its client presented, which the run verified
//! against `--trust`, as `client_certificate`, read once at the handshake; `--mtls` makes a
//! listener refuse a client that presents none. `fetch` presents the `--tls` credential
//! `Fetching.credential` names to a server that asks for one.
//!
//! `serve` answers connections one at a time. `serve_pooled` answers them with a pool of tasks
//! over a bounded queue and sheds what it cannot hold: a connection that finds the queue full, or
//! that waited in it past `Shedding.max_wait_ms`, is answered 503 with `Retry-After` and closed
//! unread, and `Pooled` counts each kind. When `accept` answers that the listener is closed, as it
//! does at a stop under `--host`, the pool drains: it accepts nothing more, serves every connection
//! it already accepted, those still queued included, answers a request already read on a kept
//! connection with `Connection: close`, closes a kept connection that waits idle at once, and
//! returns when every worker is done; the run's `--drain-ms` bounds the whole.
//!
//! HTTP/2 is spoken where a connection is known to speak it. Over TLS the two ends agree it by
//! ALPN: `serve_pooled_tls` and `serve_secured` secure each connection offering `h2` and then
//! `http/1.1`, and `fetch` offers the same for an `https` URL, directly or through a proxy's
//! tunnel. In the clear it is spoken by prior knowledge (`h2c`): under `serve_pooled` and
//! `serve_draining` a connection that opens with the HTTP/2 preface is HTTP/2, and `fetch` speaks it
//! to an `http` URL where `Fetching.prior_knowledge` says its server does. An HTTP/2 connection is
//! served by `std.http2`'s machine: each request is read as an `Http2` one and answered as it
//! arrives, the stop drains it with `GOAWAY`, and `http2_limits` says what it may cost; `serve_h2`
//! serves one already known to be HTTP/2. `serve` and `serve_connection` speak HTTP/1.1 alone and
//! refuse the preface as they refuse any other version.

import std.bytes (int_of_ascii, is_digit)
import std.chan (Accepted, try_send)
import std.cookie
import std.cookie (Jar)
import std.date
import std.date (OffsetDateTime)
import std.dns
import std.dns (dns)
import std.http2
import std.ip
import std.ip (Ip, Prefix, SocketAddress, ip)
import std.mime
import std.mime (MediaType)
import std.multipart
import std.net
import std.net (Blocks, Hears, Leaves, MemNet, Repeats, Says, Silent, Stalls, Step, net, send_all)
import std.list (all, any, at_or, concat, contains, drop, last, reverse, take)
import std.option (option_unwrap_or)
import std.seq
import std.seq (Seq, Done, Skip, Yield)
import std.task
import std.time (as_millis, at_millis, between, millis, nanos_at)
import std.url
import std.url (Url, url_fragment, url_host, url_host_port, url_parse, url_path, url_query,
                url_reason, url_render, url_scheme, url_userinfo)
import std.string (ascii_lower, ascii_trim, eq_ignore_ascii_case, is_ascii, join)

// --- The message ------------------------------------------------------------

/// A request's method; `Other` holds any token the standard methods are not.
pub type Method = | Get | Head | Post | Put | Patch | Delete | Options | Other(String)

/// The protocol a message came over: an HTTP/1.0 connection closes after one answer, and an
/// `Http2` request came on a stream of an HTTP/2 connection, which `std.http2` carries.
pub type Version = | Http10 | Http11 | Http2

/// Names are lowercased on parse; a name may repeat, so it maps to its field lines in order.
pub type Headers = Map<String, List<String>>

/// A body made a chunk at a time as it is sent or read, each pull of its chunks performing `e`.
pub type Stream<| e> = {
  /// How many bytes its chunks hold in all, where that is known before the first: what
  /// `Content-Length` says of it. A stream that gives more or fewer ends its connection.
  length: Option<Int>,
  chunks: Seq<Bytes | e>,
  /// Lets go of what making the chunks holds: whoever sends or reads the stream calls it once,
  /// however that ends, every chunk pulled or not.
  close: () -> Unit / e,
}

/// A message's body: its bytes whole, or a stream of chunks.
pub type Body<| e> = | Whole(Bytes) | Streamed(Stream<| e>)

/// The body of the request being answered, read from its connection as the application pulls it.
/// The serving loop answers these operations, and a request's `Streamed` body performs them.
pub effect incoming {
  /// The next piece of the body, at most `read_size()` bytes; empty once the body has ended.
  write pull() -> Bytes
  /// The fields a chunked body sent after its last chunk, once it has ended; none before.
  read trailers() -> Headers
  /// The body is refused: past `Limits.max_body`, malformed, or late. The serving loop answers
  /// with its status where no answer has begun, and closes the connection.
  raise refused(r: Refusal)
}

/// What pulling a request's body performs.
pub effect set Reading = {incoming.pull, incoming.trailers, incoming.refused, abort.raise}

/// A request as the server reads it, or as a client builds it with `request_to`.
pub type Request = {
  method: Method,
  /// The request target as sent: the path with its query.
  target: String,
  path: String,
  /// What follows the `?`, without it; empty when there is none.
  query: String,
  /// The `Host` the request names.
  authority: String,
  version: Version,
  headers: Headers,
  /// The fields a chunked body sent after its last chunk, where they came before the request
  /// was handed over; `request_trailers` reads those of a streamed body.
  trailers: Headers,
  /// A served HTTP/1.1 request's body streams from its connection, and any other is whole.
  body: Body<| {Reading}>,
  /// Where the connection that carried the request comes from, as its socket says: behind a
  /// proxy that is the proxy, and `client_ip` reads past it. `None` for a request no TCP
  /// connection carried: one a client built, a test's, or one from a Unix socket.
  peer: Option<SocketAddress>,
  /// The certificate (DER) the client presented when its connection was secured, which the run
  /// verified against `--trust`: who the client is, to a server that knows its clients by mutual
  /// TLS, read once at the handshake; `std.x509` reads its subject and names. `None` for a client
  /// that presented none, and a request no secured connection carried.
  client_certificate: Option<Bytes>,
}

/// A response to encode or serve, or one a client read; `encode` adds the framing fields. A
/// streamed body's chunks perform `e` as they are pulled, which they are as it is sent.
pub type Response<| e> = { status: Int, headers: Headers, body: Body<| e> }

/// What a server answers requests with: the response, and what it and its body perform, the
/// reads of a request's body among them.
pub type Handler<| e> = (Request) -> Response<| {Reading | e}> / {Reading | e}

// --- Limits -----------------------------------------------------------------

/// What one connection may cost: a message past a size bound is refused, and a wait past a deadline
/// ends it. Every limit must be positive (`check_limits`).
pub type Limits = {
  /// Bytes in the request line (414 past it), and in a response's status line.
  max_request_line: Int,
  /// Bytes in the header fields after the request line (431 past it).
  max_header_bytes: Int,
  max_header_count: Int,
  /// Bytes in a body, decoded (413 past it).
  max_body: Int,
  max_chunk_size: Int,
  max_chunk_line: Int,
  max_trailer_bytes: Int,
  /// Requests one connection answers before the server closes it.
  max_keep_alive: Int,
  /// Chunks one streamed response writes.
  max_stream_chunks: Int,
  /// From a head's first byte to its last (408 past it).
  header_timeout_ms: Int,
  body_timeout_ms: Int,
  /// The wait for the next request on a kept-alive connection, which closes it silently.
  idle_timeout_ms: Int,
  write_timeout_ms: Int,
  connect_timeout_ms: Int,
}

/// Eight KiB request lines, 64 KiB of headers, 1 MiB bodies, five-second head and idle deadlines and
/// thirty-second body and write ones.
pub fn default_limits() -> Limits =
  {
    max_request_line: 8192,
    max_header_bytes: 65536,
    max_header_count: 100,
    max_body: 1048576,
    max_chunk_size: 1048576,
    max_chunk_line: 4096,
    max_trailer_bytes: 8192,
    max_keep_alive: 100,
    max_stream_chunks: 2048,
    header_timeout_ms: 5000,
    body_timeout_ms: 30000,
    idle_timeout_ms: 5000,
    write_timeout_ms: 30000,
    connect_timeout_ms: 5000,
  }

/// A non-positive limit is a configuration mistake, so it panics at `serve` naming the field.
pub fn check_limits(l: Limits) -> Unit / {abort.raise} = {
  bad_limit("max_request_line", l.max_request_line);
  bad_limit("max_header_bytes", l.max_header_bytes);
  bad_limit("max_header_count", l.max_header_count);
  bad_limit("max_body", l.max_body);
  bad_limit("max_chunk_size", l.max_chunk_size);
  bad_limit("max_chunk_line", l.max_chunk_line);
  bad_limit("max_trailer_bytes", l.max_trailer_bytes);
  bad_limit("max_keep_alive", l.max_keep_alive);
  bad_limit("max_stream_chunks", l.max_stream_chunks);
  bad_limit("header_timeout_ms", l.header_timeout_ms);
  bad_limit("body_timeout_ms", l.body_timeout_ms);
  bad_limit("idle_timeout_ms", l.idle_timeout_ms);
  bad_limit("write_timeout_ms", l.write_timeout_ms);
  bad_limit("connect_timeout_ms", l.connect_timeout_ms)
}

fn bad_limit(field: String, value: Int) -> Unit / {abort.raise} =
  if value <= 0 {
    panic(
      "`Limits." ++ field ++ "` is " ++ int_to_string(value)
        ++ ", and every limit must be positive",
    )
  } else { () }

/// The most `net.recv` calls one head or body is read in; a deadline is split into this many slices.
pub fn max_reads() -> Int = 2048

/// The most chunks one `body_step` will decode before answering `Await`.
pub fn chunk_budget() -> Int = 512

/// The most bytes one `net.recv` asks for.
pub fn read_size() -> Int = 65536

// --- Refusals ---------------------------------------------------------------

/// Every framing refusal closes the connection.
pub type Refusal = { status: Int, reason: String }

/// `UntilClose` is a response without a length field: a client reads it until the server closes.
pub type Framing = | NoBody | Length(Int) | Chunked | UntilClose

/// A parsed request head: the request without its body, how the body is framed, and how many bytes of
/// the buffer the head took.
pub type Head = {
  request: Request,
  framing: Framing,
  consumed: Int,
  keep_alive: Bool,
  /// The client sent `Expect: 100-continue` and waits for `continue_response` before its body.
  expects_continue: Bool,
}

/// `Incomplete` asks for more bytes; `Refused` names the status the connection is closed with.
pub type HeadResult = | Incomplete | Parsed(Head) | Refused(Refusal)

fn refuse(status: Int, reason: String) -> HeadResult = Refused({ status: status, reason: reason })

/// Headers with no field.
pub fn empty_headers() -> Headers = map_new()

// --- Byte classes -----------------------------------------------------------

/// CR, LF, DEL and every other control byte except HTAB: what ends or is illegal in a header line.
fn line_stops() -> Bytes =
  b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f\x7f"

/// RFC 9110's `tchar`. A field name and a method are tokens and nothing else.
fn tchars() -> Bytes =
  b"!#$%&'*+-.^_`|~0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"

fn digits() -> Bytes = b"0123456789"

fn hex_digits() -> Bytes = b"0123456789abcdefABCDEF"

fn ows() -> Bytes = b" \t"

fn is_token(b: Bytes) -> Bool =
  bytes_len(b) > 0 && bytes_scan(b, 0, tchars(), bytes_len(b)) == bytes_len(b)

fn all_digits(b: Bytes) -> Bool =
  bytes_len(b) > 0 && bytes_scan(b, 0, digits(), bytes_len(b)) == bytes_len(b)

// --- Lines ------------------------------------------------------------------

/// A line is terminated by CRLF and by nothing else.
pub type Line =
  | LineAt({ start: Int, stop: Int, next: Int })
  | LineIncomplete
  | LineTooLong
  | LineIllegal({ at: Int, why: String })

/// The scan is one byte wider than `budget`, so a terminator exactly at the bound differs from none.
fn read_line(buf: Bytes, from: Int, budget: Int) -> Line / {abort.raise} = {
  let n = bytes_len(buf);
  if from > n { LineIncomplete } else {
    let stop = bytes_scan_until(buf, from, line_stops(), budget + 1);
    if stop > from + budget { LineTooLong }
    else if stop >= n { LineIncomplete }
    else { line_at(buf, from, stop, n) }
  }
}

fn line_at(buf: Bytes, from: Int, stop: Int, n: Int) -> Line / {abort.raise} = {
  let c = bytes_at(buf, stop);
  if c == b'\n' {
    LineIllegal({ at: stop, why: "a line ended with a bare LF; HTTP/1.1 lines end with CRLF" })
  } else if c != b'\r' {
    LineIllegal({ at: stop, why: "a control character is not allowed in a header line" })
  } else if stop + 1 >= n { LineIncomplete } else if bytes_at(buf, stop + 1) != b'\n' {
    LineIllegal({ at: stop, why: "a bare CR is not allowed in a header line" })
  } else { LineAt({ start: from, stop: stop, next: stop + 2 }) }
}

// --- The head ---------------------------------------------------------------

/// The request head at the start of `buf`, refused rather than guessed at when it is ambiguous: a bare
/// LF, a duplicate `Content-Length`, both a length and chunked framing, an unknown transfer coding.
pub fn parse_head(buf: Bytes, limits: Limits) -> HeadResult / {abort.raise} =
  match read_line(buf, 0, limits.max_request_line) {
    LineIncomplete -> Incomplete,
    LineTooLong ->
      refuse(
        414,
        "the request line is longer than " ++ int_to_string(limits.max_request_line) ++ " bytes",
      ),
    LineIllegal(e) -> refuse(400, e.why),
    LineAt(l) -> after_request_line(buf, limits, l),
  }

fn after_request_line(
  buf: Bytes,
  limits: Limits,
  l: { start: Int, stop: Int, next: Int },
) -> HeadResult / {abort.raise} =
  match request_line(bytes_slice(buf, l.start, l.stop)) {
    Err(r) -> Refused(r),
    Ok(start) -> match fields(buf, l.next, l.next, limits) {
      FieldsIncomplete -> Incomplete,
      FieldsRefused(r) -> Refused(r),
      FieldsDone(done) -> match host_of(start, done.headers) {
        Err(r) -> Refused(r),
        Ok(authority) -> match framing_of(done.headers, limits) {
          Err(r) -> Refused(r),
          Ok(framing) -> match expect_of(done.headers) {
            Err(r) -> Refused(r),
            Ok(continues) ->
              Parsed({
                request: {
                  method: start.method,
                  target: start.target,
                  path: start.path,
                  query: start.query,
                  authority: authority,
                  version: start.version,
                  headers: done.headers,
                  trailers: empty_headers(),
                  body: Whole(b""),
                  peer: None,
                  client_certificate: None,
                },
                framing: framing,
                consumed: done.next,
                keep_alive: keep_alive_of(start.version, done.headers),
                expects_continue: continues,
              }),
          },
        },
      },
    },
  }

type Start = {
  method: Method,
  target: String,
  path: String,
  query: String,
  authority: String,
  version: Version,
}

// --- The request line -------------------------------------------------------

/// HTAB is legal in a field value but not here: splitting a request line on it is a smuggle vector.
fn request_line(line: Bytes) -> Result<Start, Refusal> / {abort.raise} = {
  let n = bytes_len(line);
  let sp1 = bytes_scan_until(line, 0, b" ", n);
  if bytes_scan_until(line, 0, b"\t", n) < n {
    Err({
      status: 400,
      reason: "a request line holds no whitespace but the two spaces that split it",
    })
  } else if sp1 >= n {
    Err({ status: 400, reason: "a request line is `METHOD SP TARGET SP VERSION`" })
  } else {
    let sp2 = bytes_scan_until(line, sp1 + 1, b" ", n - sp1 - 1);
    if sp2 >= n { Err({ status: 400, reason: "a request line is `METHOD SP TARGET SP VERSION`" }) }
    else if bytes_scan_until(line, sp2 + 1, b" ", n - sp2 - 1) < n {
      Err({ status: 400, reason: "a request line holds exactly two spaces" })
    } else {
      request_parts(
        bytes_slice(line, 0, sp1),
        bytes_slice(line, sp1 + 1, sp2),
        bytes_slice(line, sp2 + 1, n),
      )
    }
  }
}

fn request_parts(
  method: Bytes,
  target: Bytes,
  version: Bytes,
) -> Result<Start, Refusal> / {abort.raise} =
  if !is_token(method) { Err({ status: 400, reason: "a method must be a token" }) } else {
    let v = version_of(version)?;
    with_target(method_of(method), target, v)
  }

/// A token-valid unknown method parses as `Other(name)`, and routing answers 405.
fn method_of(m: Bytes) -> Method / {abort.raise} =
  if m == b"GET" { Get }
  else if m == b"POST" { Post }
  else if m == b"HEAD" { Head }
  else if m == b"PUT" { Put }
  else if m == b"PATCH" { Patch }
  else if m == b"DELETE" { Delete }
  else if m == b"OPTIONS" { Options }
  else { Other(string_of_bytes(m)) }

/// The method as the request line spells it.
pub fn method_name(m: Method) -> String =
  match m {
    Get -> "GET",
    Head -> "HEAD",
    Post -> "POST",
    Put -> "PUT",
    Patch -> "PATCH",
    Delete -> "DELETE",
    Options -> "OPTIONS",
    Other(name) -> name,
  }

/// No version is HTTP/0.9, which is not served; an unknown `HTTP/x.y` is well formed, so 505.
fn version_of(v: Bytes) -> Result<Version, Refusal> =
  if v == b"HTTP/1.1" { Ok(Http11) }
  else if v == b"HTTP/1.0" { Ok(Http10) }
  else if bytes_len(v) == 8 && bytes_starts_with(v, b"HTTP/") && is_digit(bytes_at(v, 5))
      && bytes_at(v, 6) == b'.'
      && is_digit(bytes_at(v, 7)) {
    Err({ status: 505, reason: "this server speaks HTTP/1.1 and HTTP/1.0" })
  } else { Err({ status: 400, reason: "a request line ends with `HTTP/1.1` or `HTTP/1.0`" }) }

fn with_target(
  method: Method,
  target: Bytes,
  version: Version,
) -> Result<Start, Refusal> / {abort.raise} =
  if bytes_len(target) == 0 { Err({ status: 400, reason: "a request line needs a target" }) }
  else if !bytes_is_utf8(target) {
    Err({ status: 400, reason: "a request target must be valid UTF-8" })
  } else if bytes_scan_until(target, 0, b"#", bytes_len(target)) < bytes_len(target) {
    // At a `#`, a recipient parsing a URI reference and one that does not disagree on the target.
    Err({ status: 400, reason: "a request target carries no fragment" })
  } else { target_form(method, target, version) }

/// Origin-form, absolute-form, or asterisk-form and only with OPTIONS.
fn target_form(
  method: Method,
  target: Bytes,
  version: Version,
) -> Result<Start, Refusal> / {abort.raise} =
  if target == b"*" {
    match method {
      Options -> Ok(start_of(method, target, "*", "", "", version)),
      _ -> Err({ status: 400, reason: "an asterisk-form target is only valid with OPTIONS" }),
    }
  } else if bytes_at(target, 0) == b'/' { Ok(origin_form(method, target, version)) }
  else { absolute_form(method, target, version) }

fn start_of(
  method: Method,
  target: Bytes,
  path: String,
  query: String,
  authority: String,
  version: Version,
) -> Start / {abort.raise} =
  {
    method: method,
    target: string_of_bytes(target),
    path: path,
    query: query,
    authority: authority,
    version: version,
  }

fn origin_form(method: Method, target: Bytes, version: Version) -> Start / {abort.raise} = {
  let n = bytes_len(target);
  let q = bytes_scan_until(target, 0, b"?", n);
  start_of(
    method,
    target,
    string_of_bytes(bytes_slice(target, 0, q)),
    if q >= n { "" } else { string_of_bytes(bytes_slice(target, q + 1, n)) },
    "",
    version,
  )
}

/// The target's authority is the request's (RFC 9112 §3.2.2); `Host` stays visible for comparison.
/// `std.url` reads the target, so a request line and a URL are read one way.
fn absolute_form(
  method: Method,
  target: Bytes,
  version: Version,
) -> Result<Start, Refusal> / {abort.raise} =
  match url_parse(string_of_bytes(target)) {
    Err(refused) -> Err({ status: 400, reason: target_refusal(refused.why) }),
    Ok(u) -> absolute_start(method, target, version, u),
  }

fn target_refusal(why: url::Why) -> String =
  match why {
    url::NoScheme -> no_target_form(),
    url::BadScheme -> no_target_form(),
    _ -> "an absolute-form target is not a URL: " ++ url_reason(why),
  }

fn no_target_form() -> String = "a request target must be origin-form, absolute-form, or `*`"

fn absolute_start(
  method: Method,
  target: Bytes,
  version: Version,
  u: Url,
) -> Result<Start, Refusal> / {abort.raise} =
  if url_scheme(u) != "http" && url_scheme(u) != "https" {
    Err({ status: 400, reason: no_target_form() })
  } else if url_host(u) == None {
    Err({ status: 400, reason: "an absolute-form target needs an authority" })
  } else if url_userinfo(u) != None {
    // Refused so the authority a program compares against `Host` cannot be disguised.
    Err({ status: 400, reason: "a request target's authority carries no userinfo" })
  } else if !on_the_wire(u) {
    Err({ status: 400, reason: "a request target's host is ASCII, a name as its A-labels" })
  } else {
    // The path of a URL with an authority is empty or begins with `/`, which `std.router` relies on.
    Ok(
      start_of(
        method,
        target,
        if url_path(u) == "" { "/" } else { url_path(u) },
        option_unwrap_or(url_query(u), ""),
        option_unwrap_or(url_host_port(u), ""),
        version,
      ),
    )
  }

/// Whether the URL's host is written as a request carries one, in ASCII with no escape: `std.url`
/// reads a name in its own script too, which no program's comparison with `Host` would match.
fn on_the_wire(u: Url) -> Bool =
  match url_host_port(u) {
    Some(written) -> is_ascii(written) && !string_contains(written, "%"),
    None -> true,
  }

fn min_int(a: Int, b: Int) -> Int = if a < b { a } else { b }

// --- The header block -------------------------------------------------------

type FieldsBlock = { headers: Headers, count: Int, next: Int }

type FieldsResult = | FieldsDone(FieldsBlock) | FieldsIncomplete | FieldsRefused(Refusal)

fn fields(buf: Bytes, block_start: Int, from: Int, limits: Limits) -> FieldsResult / {abort.raise} =
  field_lines(buf, block_start, from, limits, empty_headers(), 0)

/// A line's scan budget is the block's remainder, so a long line costs the bound, not the buffer.
fn field_lines(
  buf: Bytes,
  block_start: Int,
  from: Int,
  limits: Limits,
  acc: Headers,
  count: Int,
) -> FieldsResult / {abort.raise} = {
  let used = from - block_start;
  let left = limits.max_header_bytes - used;
  if left <= 0 { FieldsRefused(too_much_header(limits)) } else {
    match read_line(buf, from, left) {
      LineIncomplete -> FieldsIncomplete,
      LineTooLong -> FieldsRefused(too_much_header(limits)),
      LineIllegal(e) -> FieldsRefused({ status: 400, reason: e.why }),
      LineAt(l) -> field_line(buf, block_start, limits, acc, count, l),
    }
  }
}

fn too_much_header(limits: Limits) -> Refusal =
  {
    status: 431,
    reason: "the header block is longer than " ++ int_to_string(limits.max_header_bytes)
      ++ " bytes",
  }

fn field_line(
  buf: Bytes,
  block_start: Int,
  limits: Limits,
  acc: Headers,
  count: Int,
  l: { start: Int, stop: Int, next: Int },
) -> FieldsResult / {abort.raise} =
  if l.stop == l.start { FieldsDone({ headers: acc, count: count, next: l.next }) }
  else if count >= limits.max_header_count {
    FieldsRefused({
      status: 431,
      reason: "more than " ++ int_to_string(limits.max_header_count) ++ " header fields",
    })
  } else {
    match parse_field(bytes_slice(buf, l.start, l.stop)) {
      Err(r) -> FieldsRefused(r),
      Ok(f) ->
        field_lines(buf, block_start, l.next, limits, add_field(acc, f.name, f.value), count + 1),
    }
  }

type Field = { name: String, value: String }

fn parse_field(content: Bytes) -> Result<Field, Refusal> / {abort.raise} = {
  let n = bytes_len(content);
  let first = bytes_at(content, 0);
  if first == b' ' || first == b'\t' {
    Err({ status: 400, reason: "obsolete line folding is not accepted" })
  } else {
    let colon = bytes_scan_until(content, 0, b":", n);
    if colon >= n { Err({ status: 400, reason: "a header field is `name: value`" }) }
    else { named_field(content, colon, n) }
  }
}

fn named_field(content: Bytes, colon: Int, n: Int) -> Result<Field, Refusal> / {abort.raise} = {
  let raw = bytes_slice(content, 0, colon);
  if colon > 0 && (bytes_at(content, colon - 1) == b' ' || bytes_at(content, colon - 1) == b'\t') {
    // `Foo : bar` is read as `Foo` by one implementation and dropped by another.
    Err({ status: 400, reason: "whitespace between a field name and its colon" })
  } else if !is_token(raw) { Err({ status: 400, reason: "a field name must be a token" }) }
  else { field_value(ascii_lower(string_of_bytes(raw)), trim_ows(content, colon + 1, n)) }
}

fn field_value(name: String, value: Bytes) -> Result<Field, Refusal> / {abort.raise} =

  // The line scan already refused control bytes, so only non-text is left to refuse.
  if !bytes_is_utf8(value) {
    Err({ status: 400, reason: "the value of `" ++ name ++ "` is not valid UTF-8" })
  } else { Ok({ name: name, value: string_of_bytes(value) }) }

fn trim_ows(content: Bytes, from: Int, to: Int) -> Bytes / {abort.raise} = {
  let start = bytes_scan(content, from, ows(), to - from);
  bytes_slice(content, start, trim_end(content, start, to))
}

fn trim_end(content: Bytes, start: Int, to: Int) -> Int / {abort.raise} =
  if to <= start { start }
  else if bytes_at(content, to - 1) == b' ' || bytes_at(content, to - 1) == b'\t' {
    trim_end(content, start, to - 1)
  } else { to }

fn add_field(headers: Headers, name: String, value: String) -> Headers =
  match map_get(headers, name) {
    None -> map_insert(headers, name, [value]),
    Some(vs) -> map_insert(headers, name, push(vs, value)),
  }

// --- Reading a header -------------------------------------------------------

/// Every field line under this name, in order of appearance.
pub fn header_lines(h: Headers, name: String) -> List<String> =
  match map_get(h, name) { Some(vs) -> vs, None -> [] }

/// The first field line under `name`, which must be lowercase, as parsed names are.
pub fn header(h: Headers, name: String) -> Option<String> =
  match map_get(h, name) { Some([v, ..]) -> Some(v), _ -> None }

/// Whether a field named `name` (lowercase) is present.
pub fn has_header(headers: Headers, name: String) -> Bool = map_contains(headers, name)

/// `headers` with every line under `name` replaced by `value`; the name is lowercased.
pub fn set_header(headers: Headers, name: String, value: String) -> Headers =
  map_insert(headers, ascii_lower(name), [value])

/// `headers` with `value` appended under `name`, keeping the lines already there.
pub fn add_header(headers: Headers, name: String, value: String) -> Headers =
  add_field(headers, ascii_lower(name), value)

/// A comma-separated list field, split, trimmed and lowercased.
fn list_field(headers: Headers, name: String) -> List<String> =
  fold(header_lines(headers, name), [], |acc: List<String>, line: String|
    fold(string_split(line, ","), acc, |inner: List<String>, part: String|
      push(inner, ascii_lower(ascii_trim(part)))))

// --- Who a request came from ------------------------------------------------

/// One hop a `Forwarded` or `X-Forwarded-For` field names: where a proxy saw its request come
/// from.
pub type Hop =
  /// An address, and its port where the field gave one.
  | From(Ip, Option<Int>)
  /// An identifier a proxy wrote in place of an address, such as `_hidden`.
  | Obscured(String)
  /// `unknown`, a hop that says nothing of where it came from, or one that does not read.
  | Unknown

/// The hops a request's `Forwarded` fields name (RFC 7239), oldest first: the `for` of each
/// element of each field line, in order. An element with no `for`, or whose `for` is no node, is
/// `Unknown`. A line that is not a list of `;`-separated `name=value` pairs is one `Unknown`,
/// since nothing left of where it stops reading can be placed.
pub fn forwarded_for(headers: Headers) -> List<Hop> / {abort.raise} =
  fold(header_lines(headers, "forwarded"), [], |hops: List<Hop>, line: String| {
    let b = bytes_of_string(line);
    match forwarded_elements(b, 0, [], [], bytes_len(b) + 1) {
      None -> push(hops, Unknown),
      Some(elements) ->
        fold(elements, hops, |found: List<Hop>, pairs: List<ForwardedPair>|
          if len(pairs) == 0 { found } else {
            match filter(pairs, |p: ForwardedPair| p.name == "for") {
              [only] -> push(found, hop_of(only.value)),
              _ -> push(found, Unknown),
            }
          }),
    }
  })

/// The hops a request's `X-Forwarded-For` fields name, oldest first: each comma-separated item of
/// each field line, an address with or without a port, an IPv6 one bare or in brackets. An item
/// that is none of them is `Unknown`.
pub fn x_forwarded_for(headers: Headers) -> List<Hop> / {abort.raise} =
  fold(header_lines(headers, "x-forwarded-for"), [], |hops: List<Hop>, line: String|
    fold(string_split(line, ","), hops, |found: List<Hop>, item: String| {
      let text = ascii_trim(item);
      match ip::parse(text) {
        Ok(address) -> push(found, From(address, None)),
        Err(_) -> push(found, hop_of(text)),
      }
    }))

/// The client a request came from, as far as proxies the caller trusts vouch for it. The
/// connection's far end is what the socket says, and it alone is believed: `hops` is read only
/// while the address in hand is inside one of `trusted`, from the newest hop back, each trusted
/// address vouching for the hop before it, and the first address not trusted is the client. A
/// far end that is not trusted is therefore the client whatever the request's fields say, which
/// is what keeps a client from naming its own address. `None` where a trusted proxy's hop is
/// `Unknown` or `Obscured`, and where there is no connection to start from. An IPv4-mapped IPv6
/// address is read as the IPv4 address it holds.
pub fn client_of(
  peer: Option<SocketAddress>,
  hops: List<Hop>,
  trusted: List<Prefix>,
) -> Option<Ip> =
  match peer {
    None -> None,
    Some(at) -> vouched(ip::to_canonical(ip::socket_ip(at)), reverse(hops), trusted),
  }

fn vouched(current: Ip, back: List<Hop>, trusted: List<Prefix>) -> Option<Ip> =
  if !any(trusted, |p: Prefix| ip::contains(p, current)) { Some(current) } else {
    match back {
      [] -> Some(current),
      [From(address, _), ..rest] -> vouched(ip::to_canonical(address), rest, trusted),
      _ -> None,
    }
  }

/// The client `req` came from by its connection and its `Forwarded` fields, believing only the
/// proxies in `trusted`: `client_of` over `forwarded_for`. A deployment whose proxies write
/// `X-Forwarded-For` reads that instead, `client_of(req.peer, x_forwarded_for(req.headers), trusted)`,
/// and one that reads the field its proxies do not write believes whatever a client put there.
pub fn client_ip(req: Request, trusted: List<Prefix>) -> Option<Ip> / {abort.raise} =
  client_of(req.peer, forwarded_for(req.headers), trusted)

type ForwardedPair = { name: String, value: String }

/// The elements of one `Forwarded` field value from `at`, each its pairs with lowercased names;
/// `None` where it is not `forwarded-element`s in a list.
fn forwarded_elements(
  b: Bytes,
  at: Int,
  pairs: List<ForwardedPair>,
  elements: List<List<ForwardedPair>>,
  fuel: Int,
) -> Option<List<List<ForwardedPair>>> / {abort.raise} = {
  let n = bytes_len(b);
  let i = if at >= n { n } else { bytes_scan(b, at, ows(), n) };
  if i >= n { Some(push(elements, pairs)) }
  else if fuel <= 0 { None } else if bytes_at(b, i) == b',' {
    forwarded_elements(b, i + 1, [], push(elements, pairs), fuel - 1)
  } else if bytes_at(b, i) == b';' { forwarded_elements(b, i + 1, pairs, elements, fuel - 1) }
  else {
    let name_end = bytes_scan(b, i, tchars(), n);
    if name_end == i || name_end >= n || bytes_at(b, name_end) != b'=' { None } else {
      let value = forwarded_value(b, name_end + 1)?;
      let after = if value.next >= n { n } else { bytes_scan(b, value.next, ows(), n) };
      if after < n && bytes_at(b, after) != b',' && bytes_at(b, after) != b';' { None } else {
        let pair = {
          name: ascii_lower(string_of_bytes_lossy(bytes_slice(b, i, name_end))),
          value: value.text,
        };
        forwarded_elements(b, after, push(pairs, pair), elements, fuel - 1)
      }
    }
  }
}

/// A pair's value from `at`: a token, or a quoted string with its escapes undone.
fn forwarded_value(b: Bytes, at: Int) -> Option<{ text: String, next: Int }> / {abort.raise} = {
  let n = bytes_len(b);
  if at >= n { None }
  else if bytes_at(b, at) == b'"' { quoted_from(b, at + 1, b"", n - at) } else {
    let end = bytes_scan(b, at, tchars(), n);
    if end == at { None }
    else { Some({ text: string_of_bytes_lossy(bytes_slice(b, at, end)), next: end }) }
  }
}

/// A quoted string's content from `at`, just past its opening quote or a pair it escaped.
fn quoted_from(
  b: Bytes,
  at: Int,
  so_far: Bytes,
  fuel: Int,
) -> Option<{ text: String, next: Int }> / {abort.raise} = {
  let n = bytes_len(b);
  let stop = if at >= n { n } else { bytes_scan_until(b, at, b"\"\\", n) };
  if stop >= n || fuel <= 0 { None } else {
    let read = bytes_concat(so_far, bytes_slice(b, at, stop));
    if bytes_at(b, stop) == b'"' { Some({ text: string_of_bytes_lossy(read), next: stop + 1 }) }
    else if stop + 1 >= n { None } else {
      quoted_from(b, stop + 2, bytes_concat(read, bytes_slice(b, stop + 1, stop + 2)), fuel - 1)
    }
  }
}

/// RFC 7239's `obfnode` and `obfport`: `_`, then letters, digits, `.`, `_` and `-`.
fn is_obscured(b: Bytes) -> Bool / {abort.raise} =
  bytes_len(b) > 1 && bytes_at(b, 0) == b'_'
    && bytes_scan(
      b,
      1,
      b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._-",
      bytes_len(b),
    )
    == bytes_len(b)

/// The hop a `node` names: an IPv4 address, an IPv6 address in brackets, `unknown` or an
/// obscured identifier, each with or without a port.
fn hop_of(node: String) -> Hop / {abort.raise} = {
  let b = bytes_of_string(node);
  let n = bytes_len(b);
  if n == 0 { Unknown }
  else if eq_ignore_ascii_case(node, "unknown") { Unknown } else if bytes_at(b, 0) == b'_' {
    let end = bytes_scan_until(b, 0, b":", n);
    if is_obscured(bytes_slice(b, 0, end)) && node_port(b, end) != None {
      Obscured(string_of_bytes_lossy(bytes_slice(b, 0, end)))
    } else { Unknown }
  } else if bytes_at(b, 0) == b'[' {
    let close = bytes_scan_until(b, 1, b"]", n);
    if close >= n { Unknown } else {
      match ip::parse_v6(string_of_bytes_lossy(bytes_slice(b, 1, close))) {
        Ok(six) -> match node_port(b, close + 1) {
          Some(port) -> From(ip::V6(six), port),
          None -> Unknown,
        },
        Err(_) -> Unknown,
      }
    }
  } else {
    let colon = bytes_scan_until(b, 0, b":", n);
    match ip::parse_v4(string_of_bytes_lossy(bytes_slice(b, 0, colon))) {
      Ok(four) -> match node_port(b, colon) {
        Some(port) -> From(ip::V4(four), port),
        None -> Unknown,
      },
      Err(_) -> Unknown,
    }
  }
}

/// What follows a node's name from `at`: nothing, or `:` and a port, which is a number or an
/// obscured one. `None` where it is neither.
fn node_port(b: Bytes, at: Int) -> Option<Option<Int>> / {abort.raise} = {
  let n = bytes_len(b);
  if at >= n { Some(None) }
  else if bytes_at(b, at) != b':' { None } else {
    let rest = bytes_slice(b, at + 1, n);
    if is_obscured(rest) { Some(None) } else if all_digits(rest) && bytes_len(rest) <= 5 {
      match int_of_ascii(rest) {
        Some(port) -> if port <= 65535 { Some(Some(port)) } else { None },
        None -> None,
      }
    } else { None }
  }
}

// --- Host -------------------------------------------------------------------

/// An HTTP/1.1 request needs exactly one `Host`.
fn host_of(start: Start, headers: Headers) -> Result<String, Refusal> = {
  let lines = header_lines(headers, "host");
  if len(lines) > 1 { Err({ status: 400, reason: "a request carries at most one `Host` field" }) }
  else if string_len(start.authority) > 0 { Ok(start.authority) } else {
    match lines {
      [only] -> Ok(only),
      _ -> match start.version {
        Http10 -> Ok(""),
        _ -> Err({ status: 400, reason: "an HTTP/1.1 request must carry a `Host` field" }),
      },
    }
  }
}

// --- Framing ----------------------------------------------------------------

/// Where RFC 9112 §6 permits a choice, this refuses.
fn framing_of(headers: Headers, limits: Limits) -> Result<Framing, Refusal> / {abort.raise} = {
  let cl = header_lines(headers, "content-length");
  let te = header_lines(headers, "transfer-encoding");
  if len(cl) > 0 && len(te) > 0 {
    Err({
      status: 400,
      reason: "a request carries `Content-Length` or `Transfer-Encoding`, never both",
    })
  } else if len(te) > 0 { chunked_of(list_field(headers, "transfer-encoding")) }
  else if len(cl) > 1 {
    Err({ status: 400, reason: "a request carries at most one `Content-Length` field line" })
  } else { match cl { [only] -> length_of(only, limits), _ -> Ok(NoBody) } }
}

/// A coding list not ending in `chunked` has no decidable length (400); any other coding is 501.
fn chunked_of(codings: List<String>) -> Result<Framing, Refusal> =
  if !contains(codings, "chunked") {
    Err({ status: 501, reason: "the only transfer coding this server decodes is `chunked`" })
  } else if count_string(codings, "chunked") > 1 {
    Err({ status: 400, reason: "`chunked` may be applied at most once" })
  } else if last_string(codings) != "chunked" {
    Err({
      status: 400,
      reason: "`chunked` must be the final transfer coding, or the message length is undecidable",
    })
  } else if len(codings) > 1 {
    Err({ status: 501, reason: "the only transfer coding this server decodes is `chunked`" })
  } else { Ok(Chunked) }

fn count_string(xs: List<String>, want: String) -> Int =
  fold(xs, 0, |acc: Int, x: String| if x == want { acc + 1 } else { acc })

fn last_string(xs: List<String>) -> String = fold(xs, "", |prev: String, x: String| x)

/// ASCII digits only: no sign, whitespace or `0x`, and a comma makes it a list rather than a length.
fn length_of(raw: String, limits: Limits) -> Result<Framing, Refusal> / {abort.raise} = {
  let b = bytes_of_string(raw);
  if !all_digits(b) {
    Err({ status: 400, reason: "a `Content-Length` is one or more ASCII digits" })
  } else {
    // Only a length past what an `Int` holds fails to read, and it is past any limit too.
    match int_of_ascii(b) {
      Some(n) -> if n > limits.max_body { Err(too_long(limits)) } else { Ok(Length(n)) },
      None -> Err(too_long(limits)),
    }
  }
}

fn too_long(limits: Limits) -> Refusal =
  { status: 413, reason: "the body is longer than " ++ int_to_string(limits.max_body) ++ " bytes" }

// --- Expect and Connection --------------------------------------------------

/// A client waiting for a `100` it never gets hangs, so any other expectation is 417.
fn expect_of(headers: Headers) -> Result<Bool, Refusal> = {
  let lines = header_lines(headers, "expect");
  let continues = eq_ignore_ascii_case(ascii_trim(first_string(lines)), "100-continue");
  if len(lines) == 0 { Ok(false) }
  else if len(lines) == 1 && continues { Ok(true) } else {
    Err({ status: 417, reason: "the only `Expect` this server implements is `100-continue`" })
  }
}

fn first_string(xs: List<String>) -> String = match xs { [x, ..] -> x, _ -> "" }

/// HTTP/1.1 is persistent by default; HTTP/1.0 closes by default and opts in.
fn keep_alive_of(version: Version, headers: Headers) -> Bool = {
  let tokens = list_field(headers, "connection");
  match version { Http10 -> contains(tokens, "keep-alive"), _ -> !contains(tokens, "close") }
}

// --- Bodies -----------------------------------------------------------------

type ChunkPhase = | AtSize | InData | AfterData | InTrailers | Finished

/// Where a body's decoding stands between buffers, which `body_start` begins and `body_step` advances.
pub type BodyState = {
  framing: Framing,
  phase: ChunkPhase,
  remaining: Int,
  received: Int,
  limits: Limits,
}

/// `Await` has decoded what `buf` held and needs more; `consumed` is how many of its bytes are done
/// with and `out` what they decoded to.
pub type BodyStep =
  | Await({ state: BodyState, consumed: Int, out: Bytes })
  | Complete({ consumed: Int, out: Bytes, trailers: Headers })
  | Rejected(Refusal)

/// The state before a body's first byte.
pub fn body_start(framing: Framing, limits: Limits) -> BodyState =
  {
    framing: framing,
    phase: match framing { Chunked -> AtSize, _ -> InData },
    remaining: match framing { Length(n) -> n, _ -> 0 },
    received: 0,
    limits: limits,
  }

/// Decoding is pure; only refilling the buffer performs `net`.
pub fn body_step(state: BodyState, buf: Bytes) -> BodyStep / {abort.raise} =
  match state.framing {
    NoBody -> Complete({ consumed: 0, out: b"", trailers: empty_headers() }),
    Length(_) -> length_step(state, buf),
    Chunked -> chunk_step(state, buf, 0, [], chunk_budget()),
    UntilClose -> until_close_step(state, buf),
  }

/// Every byte is body; the reader turns the close into the end.
fn until_close_step(state: BodyState, buf: Bytes) -> BodyStep = {
  let n = bytes_len(buf);
  if state.received + n > state.limits.max_body {
    Rejected({
      status: 413,
      reason: "the body is longer than " ++ int_to_string(state.limits.max_body) ++ " bytes",
    })
  } else { Await({ state: { ..state, received: state.received + n }, consumed: n, out: buf }) }
}

fn length_step(state: BodyState, buf: Bytes) -> BodyStep / {abort.raise} = {
  let take = min_int(state.remaining, bytes_len(buf));
  let out = bytes_slice(buf, 0, take);
  if take >= state.remaining { Complete({ consumed: take, out: out, trailers: empty_headers() }) }
  else {
    Await({
      state: {
        framing: state.framing,
        phase: state.phase,
        remaining: state.remaining - take,
        received: state.received + take,
        limits: state.limits,
      },
      consumed: take,
      out: out,
    })
  }
}

/// At most `chunk_budget()` chunks per step, so tiny chunks cost the caller a loop, not the stack.
fn chunk_step(
  state: BodyState,
  buf: Bytes,
  at: Int,
  out: List<Bytes>,
  fuel: Int,
) -> BodyStep / {abort.raise} =
  if fuel <= 0 { Await({ state: state, consumed: at, out: bytes_concat_all(out) }) } else {
    match state.phase {
      AtSize -> chunk_size(state, buf, at, out, fuel),
      InData -> chunk_data(state, buf, at, out, fuel),
      AfterData -> chunk_crlf(state, buf, at, out, fuel),
      InTrailers -> chunk_trailers(state, buf, at, out),
      Finished -> Complete({ consumed: at, out: bytes_concat_all(out), trailers: empty_headers() }),
    }
  }

fn waiting(state: BodyState, at: Int, out: List<Bytes>) -> BodyStep =
  Await({ state: state, consumed: at, out: bytes_concat_all(out) })

fn phased(state: BodyState, phase: ChunkPhase, remaining: Int, received: Int) -> BodyState =
  {
    framing: state.framing,
    phase: phase,
    remaining: remaining,
    received: received,
    limits: state.limits,
  }

/// A chunk-size line is hex digits, optionally followed by `;` and extensions, terminated by CRLF.
fn chunk_size(
  state: BodyState,
  buf: Bytes,
  at: Int,
  out: List<Bytes>,
  fuel: Int,
) -> BodyStep / {abort.raise} =
  match read_line(buf, at, state.limits.max_chunk_line) {
    LineIncomplete -> waiting(state, at, out),
    LineTooLong ->
      Rejected({
        status: 400,
        reason: "a chunk-size line is longer than " ++ int_to_string(state.limits.max_chunk_line)
          ++ " bytes",
      }),
    LineIllegal(e) -> Rejected({ status: 400, reason: e.why }),
    LineAt(l) -> sized(state, buf, out, fuel, bytes_slice(buf, l.start, l.stop), l.next),
  }

fn sized(
  state: BodyState,
  buf: Bytes,
  out: List<Bytes>,
  fuel: Int,
  line: Bytes,
  next: Int,
) -> BodyStep / {abort.raise} = {
  let n = bytes_len(line);
  let end = bytes_scan_until(line, 0, b";", n);
  let digits = bytes_slice(line, 0, end);
  if bytes_len(digits) == 0 || bytes_len(digits) > 16
      || bytes_scan(digits, 0, hex_digits(), bytes_len(digits)) != bytes_len(digits) {
    Rejected({
      status: 400,
      reason: "a chunk size is 1 to 16 hexadecimal digits, optionally followed by `;`",
    })
  } else if !fits_in_int(digits, 0, bytes_len(digits)) { Rejected(too_large_chunk(state.limits)) }
  else { chunk_sized(state, buf, out, fuel, hex_to_int(digits, 0, 0), next) }
}

/// Sixteen hex digits can exceed a signed `Int`, so the digit bound alone does not prevent overflow.
fn fits_in_int(b: Bytes, i: Int, n: Int) -> Bool / {abort.raise} =
  if i >= n { true }
  else if bytes_at(b, i) == b'0' { fits_in_int(b, i + 1, n) }
  else { n - i < 16 || (n - i == 16 && hex_value(bytes_at(b, i)) < 8) }

fn too_large_chunk(limits: Limits) -> Refusal =
  {
    status: 413,
    reason: "a chunk is larger than " ++ int_to_string(limits.max_chunk_size) ++ " bytes",
  }

fn chunk_sized(
  state: BodyState,
  buf: Bytes,
  out: List<Bytes>,
  fuel: Int,
  size: Int,
  next: Int,
) -> BodyStep / {abort.raise} =
  if size > state.limits.max_chunk_size { Rejected(too_large_chunk(state.limits)) }
  else if state.received + size > state.limits.max_body {
    Rejected({
      status: 413,
      reason: "the body is longer than " ++ int_to_string(state.limits.max_body) ++ " bytes",
    })
  } else if size == 0 {
    chunk_step(phased(state, InTrailers, 0, state.received), buf, next, out, fuel - 1)
  } else { chunk_step(phased(state, InData, size, state.received), buf, next, out, fuel - 1) }

/// Only called after `fits_in_int`; the digit bound alone would let this overflow.
fn hex_to_int(b: Bytes, i: Int, acc: Int) -> Int / {abort.raise} =
  if i >= bytes_len(b) { acc } else { hex_to_int(b, i + 1, acc * 16 + hex_value(bytes_at(b, i))) }

fn hex_value(c: Int) -> Int =
  match c { b'0'..=b'9' -> c - b'0', b'a'..=b'f' -> c - b'a' + 10, _ -> c - b'A' + 10 }

reuse fn chunk_data(
  state: BodyState,
  buf: Bytes,
  at: Int,
  out: List<Bytes>,
  fuel: Int,
) -> BodyStep / {abort.raise} = {
  let take = min_int(state.remaining, bytes_len(buf) - at);
  let taken = push(out, bytes_slice(buf, at, at + take));
  let next = phased(
    state,
    if take >= state.remaining { AfterData } else { InData },
    state.remaining - take,
    state.received + take,
  );
  if take >= state.remaining { chunk_step(next, buf, at + take, taken, fuel) }
  else { waiting(next, at + take, taken) }
}

fn chunk_crlf(
  state: BodyState,
  buf: Bytes,
  at: Int,
  out: List<Bytes>,
  fuel: Int,
) -> BodyStep / {abort.raise} =
  if bytes_len(buf) < at + 2 { waiting(state, at, out) }
  else if bytes_at(buf, at) != b'\r' || bytes_at(buf, at + 1) != b'\n' {
    Rejected({ status: 400, reason: "a chunk's data must be followed by CRLF" })
  } else { chunk_step(phased(state, AtSize, 0, state.received), buf, at + 2, out, fuel - 1) }

/// Trailers follow the header block's rules under `max_trailer_bytes` and are returned separately.
fn chunk_trailers(
  state: BodyState,
  buf: Bytes,
  at: Int,
  out: List<Bytes>,
) -> BodyStep / {abort.raise} = {
  let trailer_limits = { ..state.limits, max_header_bytes: state.limits.max_trailer_bytes };
  match fields(buf, at, at, trailer_limits) {
    FieldsIncomplete -> waiting(state, at, out),
    FieldsRefused(r) -> Rejected(r),
    FieldsDone(done) ->
      Complete({ consumed: done.next, out: bytes_concat_all(out), trailers: done.headers }),
  }
}

// --- Bodies -----------------------------------------------------------------

/// A body made of `chunks` as they are pulled, its length not known before.
pub fn chunked<| e>(chunks: Seq<Bytes | e>) -> Body<| e> = {
  let held: Stream<| e> = { length: None, chunks: chunks, close: || () };
  Streamed(held)
}

/// The bytes of a whole body, which is what a client reads; panics on a streamed one, which
/// `gathered` reads.
pub fn whole_bytes<| e>(b: Body<| e>) -> Bytes / {abort.raise} =
  match b {
    Whole(bytes) -> bytes,
    Streamed(_) -> panic("a streamed body is read a chunk at a time, by `gathered`"),
  }

/// How many bytes a body holds, where that is known without reading it.
pub fn body_length<| e>(b: Body<| e>) -> Option<Int> =
  match b { Whole(bytes) -> Some(bytes_len(bytes)), Streamed(s) -> s.length }

/// The bytes a body holds, a stream's chunks read and the stream closed; `None` where they are
/// more than `limit`, which is read no further than the chunk that passes it.
pub fn gathered<| e>(b: Body<| e>, limit: Int) -> Option<Bytes> / {abort.raise | e} =
  match b {
    Whole(bytes) -> if bytes_len(bytes) > limit { None } else { Some(bytes) },
    Streamed(s) ->
      bracket(|| s, |held: Stream<| e>| (held.close)(), |held: Stream<| e>|
        gathered_from(held.chunks, limit)),
  }

/// A chunk is a byte at least or a pull that ends the stream, so `limit + 2` pulls of chunks that
/// are not empty find the end or pass the limit.
fn gathered_from<| e>(chunks: Seq<Bytes | e>, limit: Int) -> Option<Bytes> / {abort.raise | e} =
  iterate(
    { rest: chunks, parts: [], total: 0 },
    max(limit, 0) + 2,
    |g: { rest: Seq<Bytes | e>, parts: List<Bytes>, total: Int }|
      match (g.rest)() {
        Done -> Stop(Some(bytes_concat_all(g.parts))),
        Skip(more) -> Continue({ ..g, rest: more }),
        Yield(chunk, more) -> if g.total + bytes_len(chunk) > limit { Stop(None) } else {
          Continue({ rest: more, parts: push(g.parts, chunk), total: g.total + bytes_len(chunk) })
        },
      },
  )

/// The body of `req` whole, refused with 413 where it holds more than `limit` bytes.
pub fn request_body(req: Request, limit: Int) -> Bytes / {Reading} =
  match gathered(req.body, limit) {
    Some(bytes) -> bytes,
    None ->
      incoming.refused({
        status: 413,
        reason: "the body is longer than " ++ int_to_string(limit) ++ " bytes",
      }),
  }

/// The fields `req`'s chunked body sent after its last chunk: a streamed body's once it has been
/// read to its end.
pub fn request_trailers(req: Request) -> Headers / {incoming.trailers} =
  match req.body { Whole(_) -> req.trailers, Streamed(_) -> incoming.trailers() }

// --- Responses --------------------------------------------------------------

/// A response with no header fields.
pub fn response<| e>(status: Int, body: Bytes) -> Response<| e> =
  { status: status, headers: empty_headers(), body: Whole(body) }

/// A `text/plain` UTF-8 response.
pub fn text_response<| e>(status: Int, text: String) -> Response<| e> =
  {
    status: status,
    headers: set_header(empty_headers(), "content-type", "text/plain; charset=utf-8"),
    body: Whole(bytes_of_string(text)),
  }

/// The response a refused message is answered with: its status, and its reason as the body.
pub fn refusal_response<| e>(r: Refusal) -> Response<| e> =
  text_response(r.status, r.reason ++ "\n")

/// A 405 carrying the `Allow` field it must.
pub fn method_not_allowed<| e>(ms: List<Method>) -> Response<| e> = {
  let allow = allow_field(ms);
  let body = text_response(405, "the methods this resource allows are " ++ allow ++ "\n");
  { status: body.status, headers: set_header(body.headers, "allow", allow), body: body.body }
}

/// The methods as an `Allow` field lists them.
pub fn allow_field(ms: List<Method>) -> String =
  fold(ms, "", |acc: String, m: Method|
    if string_len(acc) == 0 { method_name(m) } else { acc ++ ", " ++ method_name(m) })

/// The standard reason for a status; `Unknown` for one this module does not name.
pub fn reason_phrase(status: Int) -> String =
  match status {
    100 -> "Continue",
    200 -> "OK",
    201 -> "Created",
    202 -> "Accepted",
    204 -> "No Content",
    206 -> "Partial Content",
    301 -> "Moved Permanently",
    302 -> "Found",
    303 -> "See Other",
    304 -> "Not Modified",
    307 -> "Temporary Redirect",
    308 -> "Permanent Redirect",
    400 -> "Bad Request",
    401 -> "Unauthorized",
    403 -> "Forbidden",
    404 -> "Not Found",
    405 -> "Method Not Allowed",
    406 -> "Not Acceptable",
    407 -> "Proxy Authentication Required",
    408 -> "Request Timeout",
    411 -> "Length Required",
    412 -> "Precondition Failed",
    413 -> "Content Too Large",
    414 -> "URI Too Long",
    415 -> "Unsupported Media Type",
    416 -> "Range Not Satisfiable",
    417 -> "Expectation Failed",
    429 -> "Too Many Requests",
    431 -> "Request Header Fields Too Large",
    500 -> "Internal Server Error",
    501 -> "Not Implemented",
    502 -> "Bad Gateway",
    503 -> "Service Unavailable",
    504 -> "Gateway Timeout",
    505 -> "HTTP Version Not Supported",
    _ -> "Unknown",
  }

/// 1xx, 204 and 304 carry no body or `Content-Length`: a client would read one as the next message.
fn bodiless(status: Int) -> Bool = (status >= 100 && status < 200) || status == 204 || status == 304

/// A response with a whole body, head and body. Panics on a header the program may not set: a
/// bad name, a framing field, or CR/LF in a value; and on a streamed body, which is sent a chunk
/// at a time by serving it.
pub reuse fn encode<| e>(
  method: Method,
  version: Version,
  keep_alive: Bool,
  r: Response<| e>,
) -> Bytes / {abort.raise} =
  match r.body {
    Whole(bytes) ->
      bytes_concat(
        encode_head(method, version, keep_alive, r),
        if method == Head || bodiless(r.status) { b"" } else { bytes },
      ),
    Streamed(_) ->
      panic("a streamed body is sent a chunk at a time by serving it, not encoded whole"),
  }

/// A response's head: its status line and fields, the fields that frame its body, and
/// `Connection` where the connection closes after it or is an HTTP/1.0 one kept open. A whole body
/// and a stream of known length are framed by `Content-Length`, which an answer to `HEAD` carries
/// as one to `GET` would; any other stream by `Transfer-Encoding: chunked`, or over HTTP/1.0 by the
/// close. Panics as `encode` does on a field the program may not set.
pub reuse fn encode_head<| e>(
  method: Method,
  version: Version,
  keep_alive: Bool,
  r: Response<| e>,
) -> Bytes / {abort.raise} = {
  let head = bytes_of_string(
    "HTTP/1.1 " ++ int_to_string(r.status) ++ " " ++ reason_phrase(r.status) ++ "\r\n",
  );
  let fields = fold(
    map_entries(r.headers),
    [],
    |acc: List<Bytes>, e: { key: String, value: List<String> }|
      fold(e.value, acc, |inner: List<Bytes>, v: String| push(inner, header_bytes(e.key, v))),
  );
  bytes_concat_all([
    head,
    bytes_concat_all(fields),
    framing_fields(version, r),
    connection_field(version, keep_alive && !close_framed(version, r)),
    b"\r\n",
  ])
}

fn header_bytes(name: String, value: String) -> Bytes / {abort.raise} = {
  let raw = bytes_of_string(name);
  if !is_token(raw) { panic("`" ++ name ++ "` is not a valid header name") }
  else if reserved_field(name) {
    panic("`" ++ name ++ "` is computed by `encode` and may not be set by the program")
  } else if string_contains(value, "\r") || string_contains(value, "\n") {
    panic("the value of `" ++ name ++ "` contains CR or LF, which would split the response")
  } else { bytes_of_string(name ++ ": " ++ value ++ "\r\n") }
}

fn reserved_field(name: String) -> Bool = {
  let lower = ascii_lower(name);
  lower == "content-length" || lower == "transfer-encoding" || lower == "connection"
}

fn framing_fields<| e>(version: Version, r: Response<| e>) -> Bytes =
  if bodiless(r.status) { b"" } else {
    match body_length(r.body) {
      Some(n) -> bytes_of_string("Content-Length: " ++ int_to_string(n) ++ "\r\n"),
      None -> if version == Http10 { b"" } else { b"Transfer-Encoding: chunked\r\n" },
    }
  }

/// An HTTP/1.0 stream of no known length ends where its connection closes.
fn close_framed<| e>(version: Version, r: Response<| e>) -> Bool =
  version == Http10 && !bodiless(r.status) && body_length(r.body) == None

fn connection_field(version: Version, keep_alive: Bool) -> Bytes =
  if !keep_alive { b"Connection: close\r\n" }
  else { match version { Http10 -> b"Connection: keep-alive\r\n", _ -> b"" } }

/// One chunk of a streamed body; an empty chunk encodes to nothing, since a zero-length chunk ends
/// the stream.
pub fn encode_chunk(chunk: Bytes) -> Bytes / {abort.raise} =
  if bytes_len(chunk) == 0 { b"" } else {
    bytes_concat_all([bytes_of_string(int_to_hex(bytes_len(chunk))), b"\r\n", chunk, b"\r\n"])
  }

/// The chunk that ends a streamed body.
pub fn last_chunk() -> Bytes = b"0\r\n\r\n"

fn int_to_hex(n: Int) -> String / {abort.raise} =
  if n < 16 { hex_digit(n) } else { int_to_hex(n / 16) ++ hex_digit(n % 16) }

fn hex_digit(v: Int) -> String / {abort.raise} = string_slice("0123456789abcdef", v, v + 1)

/// The interim answer that tells a client sending `Expect: 100-continue` to send its body.
pub fn continue_response() -> Bytes = b"HTTP/1.1 100 Continue\r\n\r\n"

// --- Forms ------------------------------------------------------------------

/// Why a request carries no form `form` reads.
pub type FormError =
  /// Its `Content-Type` is not `multipart/form-data` with a boundary: what it says, or `None`.
  | NotAForm(Option<String>)
  /// The body is one `std.multipart` refuses, at a byte and for a reason.
  | Unreadable(multipart::Refusal)

/// The fields and files of a `multipart/form-data` request body, read by `std.multipart` under
/// `limits`; a body longer than `limits.max_body` is read no further than the piece that passes it.
pub fn form(
  req: Request,
  limits: multipart::Limits,
) -> Result<multipart::Form, FormError> / {Reading} =
  match header(req.headers, "content-type") {
    None -> Err(NotAForm(None)),
    Some(text) -> match form_boundary(text) {
      None -> Err(NotAForm(Some(text))),
      Some(boundary) -> match gathered(req.body, limits.max_body) {
        None -> Err(Unreadable({ at: max(limits.max_body, 0), why: multipart::BodyTooLarge })),
        Some(body) -> match multipart::parse_form(body, boundary, limits) {
          Ok(f) -> Ok(f),
          Err(r) -> Err(Unreadable(r)),
        },
      },
    },
  }

fn form_boundary(text: String) -> Option<String> / {abort.raise} =
  match mime::parse(text) {
    Ok(m) -> if mime::essence(m) == "multipart/form-data" { mime::boundary(m) } else { None },
    Err(_) -> None,
  }

/// What a request whose form does not read is answered with: 415 for a body of another type,
/// 400 for one that does not read, saying at which byte.
pub fn form_refusal<| e>(why: FormError) -> Response<| e> =
  match why {
    NotAForm(_) -> text_response(415, "the body is not multipart/form-data with a boundary\n"),
    Unreadable(r) ->
      text_response(400, "the form does not read at byte " ++ int_to_string(r.at) ++ "\n"),
  }

// --- Dates ------------------------------------------------------------------

/// `r` with a `Date` field naming `at`, as RFC 9110 §6.6.1 asks of a server with a clock.
pub fn dated<| e>(r: Response<| e>, at: OffsetDateTime) -> Response<| e> =
  { ..r, headers: set_header(r.headers, "date", date::http_date(at)) }

/// `r` with a `Last-Modified` field naming `at`.
pub fn last_modified<| e>(r: Response<| e>, at: OffsetDateTime) -> Response<| e> =
  { ..r, headers: set_header(r.headers, "last-modified", date::http_date(at)) }

/// The instant the first field `name` names as an HTTP date, `now` deciding the century of a
/// two-digit year; `None` where there is no such field or it does not read as one.
pub fn date_field(
  headers: Headers,
  name: String,
  now: Instant,
) -> Option<OffsetDateTime> / {abort.raise} =
  match header(headers, name) { Some(text) -> date::parse_http_date(text, now), None -> None }

// --- Negotiation ------------------------------------------------------------

/// The media types the `Accept` fields of `headers` list, in order; `None` where there is no
/// such field, or one that does not read, which a server treats as accepting anything.
pub fn accepted(headers: Headers) -> Option<List<MediaType>> / {abort.raise} =
  match header_lines(headers, "accept") {
    [] -> None,
    lines -> match mime::parse_list(join(lines, ", ")) {
      Ok(ranges) -> Some(ranges),
      Err(_) -> None,
    },
  }

/// The type of `offered` a request's `Accept` prefers, as RFC 9110 §12.5.1 weighs them: each
/// offer takes the weight of the most specific range that covers it, and of equal weights the
/// earlier offer wins. `None` where every offer weighs zero, which is 406; the first offer where
/// the request names no `Accept`.
pub fn negotiate(headers: Headers, offered: List<MediaType>) -> Option<MediaType> / {abort.raise} =
  match accepted(headers) {
    None -> list_at(offered, 0),
    Some(ranges) -> {
      let best = fold(
        offered,
        { pick: None, weight: 0 },
        |b: { pick: Option<MediaType>, weight: Int }, m: MediaType| {
          let w = weight_of(ranges, m);
          if w > b.weight { { pick: Some(m), weight: w } } else { b }
        },
      );
      best.pick
    },
  }

/// The weight in thousandths the most specific range of `ranges` covering `m` gives it; zero where
/// none does.
fn weight_of(ranges: List<MediaType>, m: MediaType) -> Int / {abort.raise} = {
  let covering = filter(ranges, |r: MediaType| mime::matches(r, m));
  let chosen = fold(
    covering,
    { specificity: -1, weight: 0 },
    |b: { specificity: Int, weight: Int }, r: MediaType|
      if mime::specificity(r) > b.specificity {
        { specificity: mime::specificity(r), weight: option_unwrap_or(mime::quality(r), 0) }
      } else { b },
  );
  chosen.weight
}

/// `r` with `field` among those its `Vary` names, once, so a cache keys what it holds by it.
pub fn vary<| e>(r: Response<| e>, field: String) -> Response<| e> / {abort.raise} = {
  let named = fold(header_lines(r.headers, "vary"), [], |acc: List<String>, line: String|
    fold(string_split(line, ","), acc, |inner: List<String>, part: String| {
      let t = ascii_trim(part);
      if string_len(t) == 0 { inner } else { push(inner, t) }
    }));
  if any(named, |n: String| eq_ignore_ascii_case(n, field) || n == "*") { r }
  else { { ..r, headers: set_header(r.headers, "vary", join(push(named, field), ", ")) } }
}

/// What `produce` answers for the type `negotiate` chooses among `offered`, its `Content-Type`
/// that type; 406 naming the types offered where none is acceptable. Either way the response
/// says it varies by `Accept`, or a cache hands one client's type to another.
pub fn negotiated<| e, s>(
  req: Request,
  offered: List<MediaType>,
  produce: (MediaType) -> Response<| s> / e,
) -> Response<| s> / {abort.raise | e} =
  match negotiate(req.headers, offered) {
    Some(m) -> {
      let r = produce(m);
      vary({ ..r, headers: set_header(r.headers, "content-type", mime::render(m)) }, "Accept")
    },
    None ->
      vary(
        text_response(
          406,
          "this resource is available as " ++ join(map(offered, mime::render), ", ") ++ "\n",
        ),
        "Accept",
      ),
  }

// --- The read loop ----------------------------------------------------------

/// Reading a head never re-scans its buffer, which would make it quadratic.
pub type HeadRead =
  /// What arrived up to the end of the head; `complete` is false when the head ran past the size bound,
  /// which `parse_head` then refuses with 431 or 414.
  | HeadBytes({ buf: Bytes, complete: Bool })
  /// The head began arriving and did not finish inside `header_timeout_ms`: 408.
  | HeadTimedOut
  /// Nothing arrived between messages on a kept-alive connection: close without writing.
  | HeadIdle
  /// The peer closed before the head ended, after sending these bytes.
  | HeadClosed(Bytes)

type Reading = { pieces: List<Bytes>, total: Int, tail: Bytes, found: Bool }

/// `idle` is the wait for the first byte of a message on a connection that has already answered one.
pub fn read_head<[l]>(
  c: Int,
  carried: Bytes,
  limits: Limits,
  idle: Bool,
) -> HeadRead / {net.recv[l], abort.raise} = {
  let cap = limits.max_request_line + limits.max_header_bytes;
  let start = {
    pieces: [carried],
    total: bytes_len(carried),
    tail: keep_tail(carried),
    found: terminated(carried, 0),
  };
  if idle && bytes_len(carried) == 0 {
    match net.recv[l](c, min_int(read_size(), cap), limits.idle_timeout_ms) {
      None -> HeadIdle,
      Some(chunk) -> if bytes_len(chunk) == 0 { HeadClosed(b"") }
      else { head_deadline[l](c, limits, cap, absorb(start, chunk)) },
    }
  } else { head_deadline[l](c, limits, cap, start) }
}

fn head_deadline<[l]>(
  c: Int,
  limits: Limits,
  cap: Int,
  r: Reading,
) -> HeadRead / {net.recv[l], abort.raise} =
  read_head_loop[l](
    c,
    limits,
    cap,
    slice_ms(limits.header_timeout_ms),
    read_budget(limits.header_timeout_ms),
    r,
  )

/// Each read waits one slice of the timeout, so the deadline bounds the whole head, not each read.
fn slice_ms(timeout_ms: Int) -> Int / {abort.raise} =
  if timeout_ms / max_reads() < 1 { 1 } else { timeout_ms / max_reads() }

fn read_budget(timeout_ms: Int) -> Int / {abort.raise} =
  min_int(max_reads(), timeout_ms / slice_ms(timeout_ms))

fn read_head_loop<[l]>(
  c: Int,
  limits: Limits,
  cap: Int,
  slice: Int,
  reads: Int,
  r: Reading,
) -> HeadRead / {net.recv[l], abort.raise} =
  if r.found { HeadBytes({ buf: bytes_concat_all(r.pieces), complete: true }) }
  else if r.total >= cap {
    // Stop at the bound rather than buffer past it; `parse_head` answers 431 or 414 against it.
    HeadBytes({ buf: bytes_concat_all(r.pieces), complete: false })
  } else if reads <= 0 { HeadTimedOut } else {
    match net.recv[l](c, min_int(read_size(), cap - r.total), slice) {
      // An empty slice is not the deadline; the deadline is the budget running out, above.
      None -> read_head_loop(c, limits, cap, slice, reads - 1, r),
      Some(chunk) -> if bytes_len(chunk) == 0 { HeadClosed(bytes_concat_all(r.pieces)) }
      else { read_head_loop(c, limits, cap, slice, reads - 1, absorb(r, chunk)) },
    }
  }

fn absorb(r: Reading, chunk: Bytes) -> Reading / {abort.raise} = {
  let probe = bytes_concat(r.tail, chunk);
  {
    pieces: push(r.pieces, chunk),
    total: r.total + bytes_len(chunk),
    tail: keep_tail(probe),
    found: terminated(probe, 0),
  }
}

/// A blank line ends the head.
fn terminated(b: Bytes, from: Int) -> Bool / {abort.raise} =
  match bytes_index_of_from(b, b"\r\n\r\n", from) {
    Some(_) -> true,
    None -> match bytes_index_of_from(b, b"\n\n", from) { Some(_) -> true, None -> false },
  }

fn keep_tail(b: Bytes) -> Bytes / {abort.raise} = {
  let n = bytes_len(b);
  bytes_slice(b, if n > 3 { n - 3 } else { 0 }, n)
}

// --- Reading a body ---------------------------------------------------------

/// A whole body and the bytes after it, which begin the next message; or why there is none.
pub type BodyResult =
  | Body({ bytes: Bytes, rest: Bytes, trailers: Headers })
  | BodyRefused(Refusal)
  | BodyTimedOut
  | BodyClosed

/// The buffered form, for a handler that wants a whole body.
pub fn read_body<[l]>(
  c: Int,
  framing: Framing,
  buf: Bytes,
  limits: Limits,
) -> BodyResult / {net.recv[l], abort.raise} =
  body_loop[l](
    c,
    body_start(framing, limits),
    buf,
    [],
    slice_ms(limits.body_timeout_ms),
    read_budget(limits.body_timeout_ms),
  )

reuse fn body_loop<[l]>(
  c: Int,
  state: BodyState,
  buf: Bytes,
  out: List<Bytes>,
  slice: Int,
  reads: Int,
) -> BodyResult / {net.recv[l], abort.raise} =
  match body_step(state, buf) {
    Rejected(r) -> BodyRefused(r),
    Complete(done) ->
      Body({
        bytes: bytes_concat_all(push(out, done.out)),
        rest: bytes_slice(buf, done.consumed, bytes_len(buf)),
        trailers: done.trailers,
      }),
    Await(step) -> body_more(c, step, buf, out, slice, reads),
  }

reuse fn body_more<[l]>(
  c: Int,
  step: { state: BodyState, consumed: Int, out: Bytes },
  buf: Bytes,
  out: List<Bytes>,
  slice: Int,
  reads: Int,
) -> BodyResult / {net.recv[l], abort.raise} = {
  let rest = bytes_slice(buf, step.consumed, bytes_len(buf));
  let taken = push(out, step.out);
  if reads <= 0 { BodyTimedOut } else if step.consumed > 0 && bytes_len(rest) > 0 {
    // The chunk budget ran out, not the input: loop without a read, so small chunks share reads.
    body_loop(c, step.state, rest, taken, slice, reads - 1)
  } else {
    match net.recv[l](c, read_size(), slice) {
      None -> body_loop(c, step.state, rest, taken, slice, reads - 1),
      Some(chunk) -> if bytes_len(chunk) == 0 {
        match step.state.framing {
          UntilClose ->
            Body({ bytes: bytes_concat_all(taken), rest: b"", trailers: empty_headers() }),
          _ -> BodyClosed,
        }
      } else { body_loop(c, step.state, bytes_concat(rest, chunk), taken, slice, reads - 1) },
    }
  }
}

// --- Responses, as a client reads them --------------------------------------

/// A response's status line and fields, as a client reads them, with how its body is framed.
pub type ResponseHead = {
  version: Version,
  status: Int,
  reason: String,
  headers: Headers,
  framing: Framing,
  consumed: Int,
  keep_alive: Bool,
}

/// `ResponseIncomplete` asks for more bytes; a refused response carries the status a gateway answers
/// with.
pub type ResponseHeadResult =
  | ResponseIncomplete
  | ResponseParsed(ResponseHead)
  | ResponseRefused(Refusal)

/// `method` decides the framing: an answer to `HEAD` carries no body whatever its fields say.
pub fn parse_response_head(
  buf: Bytes,
  method: Method,
  limits: Limits,
) -> ResponseHeadResult / {abort.raise} =
  match read_line(buf, 0, limits.max_request_line) {
    LineIncomplete -> ResponseIncomplete,
    LineTooLong ->
      ResponseRefused({
        status: 502,
        reason: "the status line is longer than " ++ int_to_string(limits.max_request_line)
          ++ " bytes",
      }),
    LineIllegal(e) -> ResponseRefused({ status: 502, reason: e.why }),
    LineAt(l) -> after_status_line(buf, method, limits, l),
  }

fn after_status_line(
  buf: Bytes,
  method: Method,
  limits: Limits,
  l: { start: Int, stop: Int, next: Int },
) -> ResponseHeadResult / {abort.raise} =
  match status_line(bytes_slice(buf, l.start, l.stop)) {
    Err(r) -> ResponseRefused(r),
    Ok(start) -> match fields(buf, l.next, l.next, limits) {
      FieldsIncomplete -> ResponseIncomplete,
      FieldsRefused(r) -> ResponseRefused(relayed(r)),
      FieldsDone(done) -> match response_framing(method, start.status, done.headers, limits) {
        Err(r) -> ResponseRefused(relayed(r)),
        Ok(framing) ->
          ResponseParsed({
            version: start.version,
            status: start.status,
            reason: start.reason,
            headers: done.headers,
            framing: framing,
            consumed: done.next,
            keep_alive: keep_alive_of(start.version, done.headers),
          }),
      },
    },
  }

/// A fault in a response is the server's, reported as a gateway would relay it: 502.
fn relayed(r: Refusal) -> Refusal = { status: 502, reason: r.reason }

type StatusLine = { version: Version, status: Int, reason: String }

/// `VERSION SP 3DIGIT SP REASON`; the reason may be empty and may hold spaces.
fn status_line(line: Bytes) -> Result<StatusLine, Refusal> / {abort.raise} = {
  let n = bytes_len(line);
  let sp = bytes_scan_until(line, 0, b" ", n);
  if sp >= n { Err({ status: 502, reason: "a status line is `VERSION SP STATUS SP REASON`" }) }
  else {
    let version = response_version(bytes_slice(line, 0, sp))?;
    let code = bytes_slice(line, sp + 1, min_int(sp + 4, n));
    let after = sp + 4;
    let status = if bytes_len(code) == 3 && all_digits(code) { int_of_ascii(code) } else { None };
    match status {
      None -> Err({ status: 502, reason: "a status is three digits" }),
      Some(s) -> if after < n && bytes_at(line, after) != 32 {
        Err({ status: 502, reason: "a status line is `VERSION SP STATUS SP REASON`" })
      } else {
        Ok({
          version: version,
          status: s,
          reason: string_of_bytes_lossy(bytes_slice(line, min_int(after + 1, n), n)),
        })
      },
    }
  }
}

fn response_version(v: Bytes) -> Result<Version, Refusal> =
  match version_of(v) {
    Ok(version) -> Ok(version),
    Err(_) -> Err({ status: 502, reason: "a status line begins with `HTTP/1.1` or `HTTP/1.0`" }),
  }

/// 1xx, 204, 304 and any answer to `HEAD` carry no body; without a length field the body runs
/// until the server closes.
fn response_framing(
  method: Method,
  status: Int,
  headers: Headers,
  limits: Limits,
) -> Result<Framing, Refusal> / {abort.raise} =
  match method {
    Head -> Ok(NoBody),
    _ -> if bodiless(status) { Ok(NoBody) } else {
      match framing_of(headers, limits)? { NoBody -> Ok(UntilClose), framing -> Ok(framing) }
    },
  }

// --- Requests, as a client sends them ---------------------------------------

/// `target` is the path with its query; `authority` is the `Host` the request carries.
pub fn request_to(
  method: Method,
  authority: String,
  target: String,
  body: Bytes,
) -> Request / {abort.raise} = {
  let raw = bytes_of_string(target);
  let split = match bytes_index_of(raw, b"?") {
    Some(at) -> { path: bytes_slice(raw, 0, at), query: bytes_slice(raw, at + 1, bytes_len(raw)) },
    None -> { path: raw, query: b"" },
  };
  {
    method: method,
    target: target,
    path: string_of_bytes_lossy(split.path),
    query: string_of_bytes_lossy(split.query),
    authority: authority,
    version: Http11,
    headers: empty_headers(),
    trailers: empty_headers(),
    body: Whole(body),
    peer: None,
    client_certificate: None,
  }
}

/// One request per connection, so it says `Connection: close`. Panics on a header the program may
/// not set: `Host` comes from `authority`, and the rest as in `encode`; and on a streamed body,
/// which a client sends whole.
pub reuse fn encode_request(r: Request) -> Bytes / {abort.raise} =
  bytes_concat_all([request_head(r), b"Connection: close\r\n", b"\r\n", sent_body(r)])

/// The same request on a connection that stays open. HTTP/1.1 keeps a connection by default, so the
/// difference is the field `encode_request` adds rather than one this leaves out.
pub reuse fn encode_request_kept(r: Request) -> Bytes / {abort.raise} =
  bytes_concat_all([request_head(r), b"\r\n", sent_body(r)])

fn sent_body(r: Request) -> Bytes / {abort.raise} =
  match r.body {
    Whole(bytes) -> bytes,
    Streamed(_) -> panic("a client sends a request's body whole"),
  }

fn request_head(r: Request) -> Bytes / {abort.raise} = {
  let line = bytes_of_string(method_name(r.method) ++ " " ++ request_target(r) ++ " HTTP/1.1\r\n");
  let host = if has_header(r.headers, "host") {
    panic("`Host` is computed from `Request.authority` and may not be set by the program")
  } else { bytes_of_string("Host: " ++ r.authority ++ "\r\n") };
  let fields = fold(
    map_entries(r.headers),
    [],
    |acc: List<Bytes>, e: { key: String, value: List<String> }|
      fold(e.value, acc, |inner: List<Bytes>, v: String| push(inner, header_bytes(e.key, v))),
  );
  bytes_concat_all([line, host, bytes_concat_all(fields), request_framing(r)])
}

fn request_target(r: Request) -> String =
  if string_len(r.target) > 0 { r.target }
  else if string_len(r.query) > 0 { r.path ++ "?" ++ r.query }
  else if string_len(r.path) > 0 { r.path }
  else { "/" }

/// A body, or a method that usually carries one, is framed by its length; `GET` without a body is not.
fn request_framing(r: Request) -> Bytes = {
  let n = option_unwrap_or(body_length(r.body), 0);
  if n > 0 || carries_body(r.method) {
    bytes_of_string("Content-Length: " ++ int_to_string(n) ++ "\r\n")
  } else { b"" }
}

fn carries_body(m: Method) -> Bool =
  match m { Post -> true, Put -> true, Patch -> true, _ -> false }

// --- The client -------------------------------------------------------------

/// Why a client exchange has no answer: the host was not reached, the request could not be written,
/// the answer did not arrive in time, the server closed before answering in full, or the answer was
/// malformed (its refusal carries 502).
pub type ClientError = | Unreachable | NotSent | TimedOut | Closed | Malformed(Refusal)

/// One exchange on a fresh connection, closed afterwards whatever happened. A `1xx` answer is
/// returned as it is.
pub fn request<[l]>(
  host: String,
  port: Int,
  req: Request,
  limits: Limits,
) -> Result<Response<| {}>, ClientError> / {net.connect[l], net.send[l], net.recv[l], net.close[l], abort.raise} =
  match net.connect[l](host, port, limits.connect_timeout_ms) {
    None -> Err(Unreachable),
    Some(c) -> bracket(|| c, |h: Int| net.close[l](h), |h: Int| exchange[l](h, req, limits)),
  }

/// A connection kept open for more than one exchange: `dial`, then `ask` as many times as the server
/// allows, then `close`. A load generator wants this — a request on a fresh connection measures the
/// handshake as much as it measures the request — and `request` above is its one-shot case.
pub type Connection = { handle: Int, host: String, port: Int }

/// Opens a connection for `ask`, within `connect_timeout_ms`.
pub fn dial<[l]>(
  host: String,
  port: Int,
  limits: Limits,
) -> Result<Connection, ClientError> / {net.connect[l] bounded} =
  match net.connect[l](host, port, limits.connect_timeout_ms) {
    None -> Err(Unreachable),
    Some(c) -> {
      let opened: Connection = { handle: c, host: host, port: port };
      Ok(opened)
    },
  }

/// The same over TLS, verifying the server against the roots this run was given (`--trust`).
pub fn dial_tls<[l]>(
  host: String,
  port: Int,
  limits: Limits,
) -> Result<Connection, ClientError> / {net.connect_tls[l] bounded} =
  match net.connect_tls[l](host, port, limits.connect_timeout_ms) {
    None -> Err(Unreachable),
    Some(c) -> {
      let opened: Connection = { handle: c, host: host, port: port };
      Ok(opened)
    },
  }

/// One exchange on a connection that stays open: the request is sent, its answer read whole, and the
/// connection left for the next `ask`.
pub fn ask<[l]>(
  c: Connection,
  req: Request,
  limits: Limits,
) -> Result<Response<| {}>, ClientError> / {net.send[l], net.recv[l], abort.raise} =
  exchange_over[l](c.handle, req, limits, false)

/// The last exchange on a connection: it says `Connection: close`, so the peer hangs up after
/// answering, which is what `request` does on a connection of its own.
pub fn ask_last<[l]>(
  c: Connection,
  req: Request,
  limits: Limits,
) -> Result<Response<| {}>, ClientError> / {net.send[l], net.recv[l], abort.raise} =
  exchange_over[l](c.handle, req, limits, true)

/// Closes a connection `dial` opened.
pub fn close<[l]>(c: Connection) -> Unit / {net.close[l] bounded} = net.close[l](c.handle)

fn exchange<[l]>(
  c: Int,
  req: Request,
  limits: Limits,
) -> Result<Response<| {}>, ClientError> / {net.send[l], net.recv[l], abort.raise} =
  exchange_over[l](c, req, limits, true)

fn exchange_over<[l]>(
  c: Int,
  req: Request,
  limits: Limits,
  close: Bool,
) -> Result<Response<| {}>, ClientError> / {net.send[l], net.recv[l], abort.raise} = {
  let out = if close { encode_request(req) } else { encode_request_kept(req) };
  if !send_all[l](c, out, limits.write_timeout_ms) { Err(NotSent) } else {
    match read_head[l](c, b"", limits, false) {
      HeadTimedOut -> Err(TimedOut),
      HeadIdle -> Err(TimedOut),
      HeadClosed(_) -> Err(Closed),
      HeadBytes(got) -> match parse_response_head(got.buf, req.method, limits) {
        ResponseRefused(r) -> Err(Malformed(r)),
        ResponseIncomplete ->
          Err(
            Malformed({
              status: 502,
              reason: "the head is longer than "
                ++ int_to_string(limits.max_request_line + limits.max_header_bytes)
                ++ " bytes",
            }),
          ),
        ResponseParsed(head) ->
          read_answer[l](c, head, bytes_slice(got.buf, head.consumed, bytes_len(got.buf)), limits),
      },
    }
  }
}

fn read_answer<[l]>(
  c: Int,
  head: ResponseHead,
  rest: Bytes,
  limits: Limits,
) -> Result<Response<| {}>, ClientError> / {net.recv[l], abort.raise} =
  match read_body[l](c, head.framing, rest, limits) {
    Body(b) -> Ok({ status: head.status, headers: head.headers, body: Whole(b.bytes) }),
    BodyRefused(r) -> Err(Malformed(relayed(r))),
    BodyTimedOut -> Err(TimedOut),
    BodyClosed -> Err(Closed),
  }

// --- Fetching a URL ---------------------------------------------------------

/// A proxy every request goes through: a request for an `http` URL is sent to it in absolute
/// form, and one for an `https` URL through a `CONNECT` tunnel to the URL's host, secured end to
/// end inside it.
pub type Proxy = { host: String, port: Int }

/// How `fetch` goes about a request.
pub type Fetching = {
  /// The bounds of each exchange, whose deadlines are the fetch's timeouts.
  limits: Limits,
  /// The redirects followed before the answer is `TooManyRedirects`.
  max_redirects: Int,
  proxy: Option<Proxy>,
  /// Every server reached without a proxy speaks HTTP/2, so a request for an `http` URL goes as
  /// HTTP/2 from its first byte (RFC 9113 §3.3) rather than as HTTP/1.1.
  prior_knowledge: Bool,
  /// The `--tls` credential whose certificate an `https` connection presents to a server that asks
  /// its client for one (`net::Presenting`).
  credential: Option<String>,
}

/// Ten redirects, no proxy, HTTP/1.1 in the clear, no client certificate, and `default_limits`,
/// whose deadlines bound every wait.
pub fn fetching() -> Fetching =
  {
    limits: default_limits(),
    max_redirects: 10,
    proxy: None,
    prior_knowledge: false,
    credential: None,
  }

/// Why a fetch has no answer.
pub type FetchError =
  /// The URL's scheme is neither `http` nor `https`, or it names no host.
  | NotHttp(String)
  /// No connection was made, or it was not secured, to the URL's host or to the proxy.
  | NoConnection(net::Refusal)
  /// The proxy answered `CONNECT` with this status rather than a tunnel.
  | ProxyRefused(Int)
  /// The exchange on the connection failed.
  | NoAnswer(ClientError)
  /// A redirect's `Location` does not resolve against the URL it answered.
  | BadLocation(String)
  /// A redirect from `https` led to this URL over `http`, which is not followed.
  | Downgraded(String)
  /// The redirects ran past the bound.
  | TooManyRedirects(Int)

/// What a fetch answered: the last response, the URL that gave it, the jar with what every
/// response along the way set, and how many redirects were followed.
pub type Fetched = { response: Response<| {}>, url: Url, jar: Jar, redirects: Int }

/// `method` with `headers` and `body` to `to`, a connection to its host for each exchange, or
/// through the proxy. An `https` connection is secured offering `h2` and then `http/1.1`, and
/// speaks what the server chose; an `http` one speaks HTTP/1.1, or HTTP/2 by
/// `Fetching.prior_knowledge`.
/// Redirects are followed as the Fetch standard follows them, up to `max_redirects`: a 303 is
/// fetched with `GET` (a `HEAD` stays one), a 301 or 302 that answered a `POST` with `GET`, and a
/// 307 or 308 with the method and body it answered; a method that changes drops the body and its
/// type. A redirect to another origin drops `Authorization`, `Proxy-Authorization` and the
/// `Cookie` the caller wrote, and one from `https` to `http` is not followed. The jar's cookies
/// for each URL go with its request, and what each response sets goes into the jar, at `now`,
/// the wall clock's, from the epoch. `Host` comes from the URL and is not the caller's to set.
pub fn fetch<[l]>(
  method: Method,
  to: Url,
  headers: Headers,
  body: Bytes,
  jar: Jar,
  options: Fetching,
  now: Instant,
) -> Result<Fetched, FetchError> / {dns.lookup, net.connect_to[l], net.start_tls[l], net.send[l], net.recv[l], net.close[l], task.write, clock.read, clock.write, task::deadline.at, abort.raise} =
  hop[l](
    method,
    to,
    map_remove(headers, "host"),
    body,
    jar,
    options,
    now,
    max(options.max_redirects, 0),
  )

fn hop<[l]>(
  method: Method,
  at: Url,
  headers: Headers,
  body: Bytes,
  jar: Jar,
  options: Fetching,
  now: Instant,
  left: Int,
) -> Result<Fetched, FetchError> / {dns.lookup, net.connect_to[l], net.start_tls[l], net.send[l], net.recv[l], net.close[l], task.write, clock.read, clock.write, task::deadline.at, abort.raise} =
  match exchanged_at[l](method, at, with_cookies(headers, jar, at, now), body, options) {
    Err(e) -> Err(e),
    Ok(res) -> {
      let kept = cookie::store(jar, at, header_lines(res.headers, "set-cookie"), now);
      let redirects = max(options.max_redirects, 0) - left;
      match redirect_of(res) {
        None -> Ok({ response: res, url: at, jar: kept, redirects: redirects }),
        Some(location) -> if left <= 0 { Err(TooManyRedirects(redirects)) } else {
          match url::url_join(at, location) {
            Err(_) -> Err(BadLocation(location)),
            Ok(next) -> if url_scheme(at) == "https" && url_scheme(next) != "https" {
              Err(Downgraded(url::url_redacted(next)))
            } else {
              let m = redirected_method(res.status, method);
              hop(
                m,
                next,
                followed_headers(
                  headers,
                  m != method,
                  url::url_origin(at) == url::url_origin(next),
                ),
                if m == method { body } else { b"" },
                kept,
                options,
                now,
                left - 1,
              )
            },
          }
        },
      }
    },
  }

/// The `Location` of a redirect, where the response is one and names it.
fn redirect_of<| e>(res: Response<| e>) -> Option<String> =
  if res.status == 301 || res.status == 302 || res.status == 303 || res.status == 307
      || res.status == 308 { header(res.headers, "location") }
  else { None }

fn redirected_method(status: Int, m: Method) -> Method =
  if status == 303 { if m == Head { Head } else { Get } }
  else if (status == 301 || status == 302) && m == Post { Get }
  else { m }

fn followed_headers(headers: Headers, method_changed: Bool, same_origin: Bool) -> Headers = {
  let kept = if same_origin { headers } else {
    map_remove(map_remove(map_remove(headers, "authorization"), "proxy-authorization"), "cookie")
  };
  if method_changed { map_remove(map_remove(kept, "content-type"), "content-encoding") }
  else { kept }
}

/// `headers` with the jar's cookies for `at` after any the caller wrote.
fn with_cookies(headers: Headers, jar: Jar, at: Url, now: Instant) -> Headers / {abort.raise} =
  match cookie::header_for(jar, at, now) {
    None -> headers,
    Some(jarred) -> match header(headers, "cookie") {
      Some(own) -> set_header(headers, "cookie", own ++ "; " ++ jarred),
      None -> set_header(headers, "cookie", jarred),
    },
  }

/// The host a URL names, as a connection dials it: a name, or an address without brackets.
fn host_text(u: Url) -> Option<String> =
  match url_host(u) {
    Some(url::Name(name)) -> Some(name),
    Some(url::V4(four)) -> Some(ip::render(ip::V4(four))),
    Some(url::V6(six)) -> Some(ip::render(ip::V6(six))),
    None -> None,
  }

/// What a request to `u` names as its target: its path, `/` for none, and its query.
fn target_of(u: Url) -> String =
  (if url_path(u) == "" { "/" } else { url_path(u) })
    ++ (match url_query(u) { Some(q) -> "?" ++ q, None -> "" })

/// The host and port a `CONNECT` names, an IPv6 address in brackets.
fn tunnel_authority(u: Url, host: String, port: Int) -> String =
  (match url_host(u) { Some(url::V6(_)) -> "[" ++ host ++ "]", _ -> host }) ++ ":"
    ++ int_to_string(port)

fn exchanged_at<[l]>(
  method: Method,
  at: Url,
  headers: Headers,
  body: Bytes,
  options: Fetching,
) -> Result<Response<| {}>, FetchError> / {dns.lookup, net.connect_to[l], net.start_tls[l], net.send[l], net.recv[l], net.close[l], task.write, clock.read, clock.write, task::deadline.at, abort.raise} = {
  let scheme = url_scheme(at);
  match ((host_text(at), url::url_port_or_default(at), url_host_port(at))) {
    (Some(host), Some(port), Some(authority)) -> if scheme != "http" && scheme != "https" {
      Err(NotHttp(url::url_redacted(at)))
    } else {
      let bare = request_to(method, authority, target_of(at), body);
      let req = { ..bare, headers: headers };
      let presenting = match options.credential {
        Some(name) -> [net::Presenting(name)],
        None -> [],
      };
      match options.proxy {
        None ->
          direct[l](
            scheme == "https",
            options.prior_knowledge,
            host,
            port,
            presenting,
            req,
            options.limits,
          ),
        Some(p) -> proxied[l](at, host, port, p, presenting, req, options.limits),
      }
    },
    _ -> Err(NotHttp(url::url_redacted(at))),
  }
}

/// `h2` says a connection in the clear speaks HTTP/2 from its first byte. Over TLS the handshake
/// offers `h2` and then `http/1.1`, and the server's choice is the protocol spoken. The connection
/// is opened with `options`.
fn direct<[l]>(
  secure: Bool,
  h2: Bool,
  host: String,
  port: Int,
  options: List<net::SocketOption>,
  req: Request,
  limits: Limits,
) -> Result<Response<| {}>, FetchError> / {dns.lookup, net.connect_to[l], net.start_tls[l], net.send[l], net.recv[l], net.close[l], task.write, clock.read, clock.write, task::deadline.at, abort.raise} = {
  let opened: Result<Int, net::Refusal> = try {
    net::dial[l](host, port, options, limits.connect_timeout_ms)
  };
  match opened {
    Err(why) -> Err(NoConnection(why)),
    Ok(c) ->
      bracket(|| c, |h: Int| net.close[l](h), |h: Int|
        if secure { secured_on[l](h, host, b"", req, limits) }
        else { spoken[l](h, h2, "http", req, limits) }),
  }
}

/// The request on `c` once it is secured as `host`, offering `h2` and then `http/1.1`: over
/// HTTP/2 where the server agreed `h2`, and over HTTP/1.1 otherwise. `unread` is what was read of
/// the connection before the handshake, which must be nothing.
fn secured_on<[l]>(
  c: Int,
  host: String,
  unread: Bytes,
  req: Request,
  limits: Limits,
) -> Result<Response<| {}>, FetchError> / {net.start_tls[l], net.send[l], net.recv[l], clock.read, abort.raise} =
  match net.start_tls[l](c, host, ["h2", "http/1.1"], unread, limits.connect_timeout_ms) {
    Err(why) -> Err(NoConnection(why)),
    Ok(secured) -> spoken[l](c, secured.protocol == Some("h2"), "https", req, limits),
  }

/// The request on `c`, over HTTP/2 where `h2` says so and over HTTP/1.1 otherwise.
fn spoken<[l]>(
  c: Int,
  h2: Bool,
  scheme: String,
  req: Request,
  limits: Limits,
) -> Result<Response<| {}>, FetchError> / {net.send[l], net.recv[l], clock.read, abort.raise} =
  if h2 {
    match exchange_h2[l](c, req, scheme, limits) { Ok(r) -> Ok(r), Err(e) -> Err(NoAnswer(e)) }
  } else { answer_on[l](c, req, limits) }

fn answer_on<[l]>(
  c: Int,
  req: Request,
  limits: Limits,
) -> Result<Response<| {}>, FetchError> / {net.send[l], net.recv[l], abort.raise} =
  match exchange_over[l](c, req, limits, true) { Ok(r) -> Ok(r), Err(e) -> Err(NoAnswer(e)) }

/// The request through the proxy `p`, on a connection opened with `options`, which the TLS inside
/// a tunnel is secured over.
fn proxied<[l]>(
  at: Url,
  host: String,
  port: Int,
  p: Proxy,
  options: List<net::SocketOption>,
  req: Request,
  limits: Limits,
) -> Result<Response<| {}>, FetchError> / {dns.lookup, net.connect_to[l], net.start_tls[l], net.send[l], net.recv[l], net.close[l], task.write, clock.read, clock.write, task::deadline.at, abort.raise} = {
  let opened: Result<Int, net::Refusal> = try {
    net::dial[l](p.host, p.port, options, limits.connect_timeout_ms)
  };
  match opened {
    Err(why) -> Err(NoConnection(why)),
    Ok(c) ->
      bracket(|| c, |h: Int| net.close[l](h), |h: Int|
        if url_scheme(at) == "https" {
          tunnelled[l](h, tunnel_authority(at, host, port), host, req, limits)
        } else {
          answer_on[l](h, { ..req, target: "http://" ++ req.authority ++ target_of(at) }, limits)
        }),
  }
}

/// A `CONNECT` to `authority` on the proxy's connection, then TLS to `host` inside the tunnel and
/// the request over it.
fn tunnelled<[l]>(
  c: Int,
  authority: String,
  host: String,
  req: Request,
  limits: Limits,
) -> Result<Response<| {}>, FetchError> / {net.send[l], net.recv[l], net.start_tls[l], clock.read, abort.raise} = {
  let asked = bytes_of_string(
    "CONNECT " ++ authority ++ " HTTP/1.1\r\nHost: " ++ authority ++ "\r\n\r\n",
  );
  if !send_all[l](c, asked, limits.write_timeout_ms) { Err(NoAnswer(NotSent)) } else {
    match read_head[l](c, b"", limits, false) {
      HeadTimedOut -> Err(NoAnswer(TimedOut)),
      HeadIdle -> Err(NoAnswer(TimedOut)),
      HeadClosed(_) -> Err(NoAnswer(Closed)),
      HeadBytes(got) -> match parse_response_head(got.buf, Other("CONNECT"), limits) {
        ResponseRefused(r) -> Err(NoAnswer(Malformed(r))),
        ResponseIncomplete ->
          Err(
            NoAnswer(
              Malformed({ status: 502, reason: "the proxy's answer to CONNECT did not end" }),
            ),
          ),
        ResponseParsed(head) -> if head.status < 200 || head.status > 299 {
          Err(ProxyRefused(head.status))
        } else {
          secured_on[l](
            c,
            host,
            bytes_slice(got.buf, head.consumed, bytes_len(got.buf)),
            req,
            limits,
          )
        },
      },
    }
  }
}

// --- Serving ----------------------------------------------------------------

/// One connection: read a head, answer it, then close or go round again with the leftover bytes.
/// Each request the `app` is handed carries the connection's far end as its `peer` and the
/// certificate its client presented as its `client_certificate`, each read once, and a body to
/// read as it pulls it (`incoming`), which is read past to the next request where it does not; one
/// that pulls none of a body its client holds back for `100 Continue` ends the connection. A
/// streamed response is sent as its chunks are pulled. The connection is closed however serving it
/// ends, an `app` a clause unwinds out of included.
pub fn serve_connection<[l] | e>(
  c: Int,
  limits: Limits,
  app: Handler<| e>,
) -> Unit / {abort.raise, net.peer_address[l], net.peer_certificate[l], net.recv[l], net.send[l], net.close[l] | e} =
  bracket(|| c, |h: Int| net.close[l](h), |h: Int|
    connection_loop[l](
      h,
      limits,
      app,
      false,
      || false,
      origin_of[l](h),
      b"",
      limits.max_keep_alive,
      false,
    ))

/// `serve_connection`, until `stop` is closed, and drained from then on: the request being read or
/// answered is answered, and so is one already read behind it, but the connection is kept no
/// longer, so the last answer says `Connection: close`; a connection waiting idle for its next
/// request is closed at once, its wait cut into slices of at most 250 milliseconds between which
/// it looks at `stop`. A connection that opens with the HTTP/2 preface is served as `serve_h2`
/// serves one.
pub fn serve_draining<[l] | e>(
  c: Int,
  limits: Limits,
  stop: Chan<Unit>,
  app: Handler<| {task.select | e}>,
) -> Unit / {abort.raise, net.peer_address[l], net.peer_certificate[l], net.recv[l], net.send[l], net.close[l], task.select, clock.read | e} =
  bracket(|| c, |h: Int| net.close[l](h), |h: Int| {
    let origin = origin_of[l](h);
    let first = read_head[l](h, b"", limits, false);
    match first {
      HeadBytes(got) if bytes_starts_with(got.buf, preface_head()) ->
        served_h2[l](h, got.buf, limits, app, || stopped_by(stop), origin),
      _ ->
        headed[l](
          h,
          limits,
          app,
          true,
          || stopped_by(stop),
          origin,
          first,
          limits.max_keep_alive - 1,
        ),
    }
  })

/// Where a connection's requests come from: its far end, and the certificate its client presented,
/// which is read once the handshake of a connection secured as it is first read is over.
type Origin = { peer: Option<SocketAddress>, certificate: Option<Bytes>, looked: Bool }

fn origin_of<[l]>(c: Int) -> Origin / {net.peer_address[l]} =
  { peer: net.peer_address[l](c), certificate: None, looked: false }

/// `o` with the certificate the client presented, read once its connection has carried a request.
fn looked_up<[l]>(c: Int, o: Origin) -> Origin / {net.peer_certificate[l]} =
  if o.looked { o } else { { ..o, certificate: net.peer_certificate[l](c), looked: true } }

/// Whether `stop` is closed: what a serving loop that drains looks at between requests.
pub fn stopped_by(stop: Chan<Unit>) -> Bool / {task.select} =
  match task.select([(stop, None)], false) { Some(_) -> true, None -> false }

/// The longest one wait of an idle connection that drains takes, between its looks at the stop.
fn idle_slice_ms() -> Int = 250

/// `watched` says the loop drains, `stopping` whether the stop has come; a loop that does not
/// drain reads an idle connection in one wait.
fn connection_loop<[l] | e>(
  c: Int,
  limits: Limits,
  app: Handler<| e>,
  watched: Bool,
  stopping: () -> Bool / e,
  origin: Origin,
  carried: Bytes,
  left: Int,
  reused: Bool,
) -> Unit / {abort.raise, net.peer_certificate[l], net.recv[l], net.send[l] | e} =
  if left <= 0 { () } else {
    headed[l](
      c,
      limits,
      app,
      watched,
      stopping,
      origin,
      next_head[l](c, limits, watched, stopping, carried, reused),
      left - 1,
    )
  }

/// What the head read for the next request makes of the connection; `left` is how many it may
/// serve after this one.
fn headed<[l] | e>(
  c: Int,
  limits: Limits,
  app: Handler<| e>,
  watched: Bool,
  stopping: () -> Bool / e,
  origin: Origin,
  read: HeadRead,
  left: Int,
) -> Unit / {abort.raise, net.peer_certificate[l], net.recv[l], net.send[l] | e} =
  match read {
    // The peer went away, or went quiet between messages.
    HeadClosed(_) -> (),
    HeadIdle -> (),
    HeadTimedOut -> refused_with[l](c, limits, 408, "the request head did not arrive\n"),
    HeadBytes(got) -> after_head(c, limits, app, watched, stopping, origin, got, left),
  }

/// A refusal written on a connection that then closes.
fn refused_with<[l]>(
  c: Int,
  limits: Limits,
  status: Int,
  text: String,
) -> Unit / {net.send[l], abort.raise} = {
  send_all[l](c, encode(Get, Http11, false, text_response(status, text)), limits.write_timeout_ms);
  ()
}

/// The next request's head. The idle timeout runs until its first byte and the header timeout
/// from then; a loop that drains waits idle in slices, and is idle once it sees the stop.
fn next_head<[l] | e>(
  c: Int,
  limits: Limits,
  watched: Bool,
  stopping: () -> Bool / e,
  carried: Bytes,
  reused: Bool,
) -> HeadRead / {net.recv[l], abort.raise | e} =
  if watched && reused && bytes_len(carried) == 0 {
    match idle_wait[l](c, limits, stopping) {
      None -> HeadIdle,
      Some(chunk) -> if bytes_len(chunk) == 0 { HeadClosed(b"") }
      else { read_head[l](c, chunk, limits, false) },
    }
  } else { read_head[l](c, carried, limits, reused) }

/// The first bytes of the next request on an idle connection, read in slices until the idle
/// timeout; `None` where it times out or a stop is seen first.
fn idle_wait<[l] | e>(
  c: Int,
  limits: Limits,
  stopping: () -> Bool / e,
) -> Option<Bytes> / {net.recv[l], abort.raise | e} = {
  let slice = min_int(limits.idle_timeout_ms, idle_slice_ms());
  let rounds = max(limits.idle_timeout_ms / slice, 1);
  iterate(rounds, rounds + 1, |left: Int|
    if left <= 0 || stopping() { Stop(None) } else {
      match net.recv[l](
          c,
          min_int(read_size(), limits.max_request_line + limits.max_header_bytes),
          slice,
        ) {
        None -> Continue(left - 1),
        Some(chunk) -> Stop(Some(chunk)),
      }
    })
}

/// From here on `left` is how many requests the connection may serve after this one.
fn after_head<[l] | e>(
  c: Int,
  limits: Limits,
  app: Handler<| e>,
  watched: Bool,
  stopping: () -> Bool / e,
  origin: Origin,
  read: { buf: Bytes, complete: Bool },
  left: Int,
) -> Unit / {abort.raise, net.peer_certificate[l], net.recv[l], net.send[l] | e} =
  match parse_head(read.buf, limits) {
    // The head stopped midway, or overran the bound without a terminator.
    Incomplete -> if read.complete {
      refused_with[l](c, limits, 400, "the request head never ended\n")
    } else { refused_with[l](c, limits, 431, "the request head never ended within the bound\n") },
    Refused(r) -> refused_with[l](c, limits, r.status, r.reason ++ "\n"),
    Parsed(head) -> {
      let rest = bytes_slice(read.buf, head.consumed, bytes_len(read.buf));
      // A stop seen now ends the connection after this answer, unless more of it has been read.
      let keep = head.keep_alive && left > 0 && !(watched && bytes_len(rest) == 0 && stopping());
      let from = looked_up[l](c, origin);
      let req = {
        ..head.request,
        body: served_body(head.framing),
        peer: from.peer,
        client_certificate: from.certificate,
      };
      let out = exchanged[l](c, limits, app, req, head, rest, keep, || watched && stopping());
      if out.keep { connection_loop(c, limits, app, watched, stopping, from, out.rest, left, true) }
      else { () }
    },
  }

/// A served request's body: none, or a stream its connection is read for as it is pulled.
fn served_body(framing: Framing) -> Body<| {Reading}> =
  match framing {
    NoBody -> Whole(b""),
    Length(n) -> {
      let held: Stream<| {Reading}> = { length: Some(n), chunks: incoming_chunks(), close: || () };
      Streamed(held)
    },
    _ -> chunked(incoming_chunks()),
  }

/// The pieces `incoming.pull` answers, until the empty one that ends them.
fn incoming_chunks() -> Seq<Bytes | {Reading}> = {
  let step: (Unit) -> Option<{ value: Bytes, next: Unit }> / {Reading} = |u: Unit| {
    let piece = incoming.pull();
    if bytes_len(piece) == 0 { None } else { Some({ value: piece, next: u }) }
  };
  seq::unfold((), step)
}

/// Where a served request's body stands between pulls: its decoding, the bytes read and not yet
/// decoded, whether the client has been told to send it, the reads its deadline has left and how
/// long each waits, whether it has ended and the trailers it ended with, and whether the answer's
/// head has gone out.
type Inbound = {
  state: BodyState,
  buf: Bytes,
  continued: Bool,
  reads: Int,
  slice: Int,
  ended: Bool,
  trailers: Headers,
  started: Bool,
}

/// What an exchange leaves the connection: whether it carries another request, and the bytes read
/// past this one's body.
type Exchanged = { keep: Bool, rest: Bytes }

/// One request answered: `app` called, its answer written, and its body read past where `app` did
/// not read it all, unless `closing` says by then that the connection ends after this answer. The
/// body's reads are answered from the connection, its refusal with its status where no answer has
/// begun, after which the connection closes.
fn exchanged<[l] | e>(
  c: Int,
  limits: Limits,
  app: Handler<| e>,
  req: Request,
  head: Head,
  rest: Bytes,
  keep: Bool,
  closing: () -> Bool / e,
) -> Exchanged / {abort.raise, net.recv[l], net.send[l] | e} = {
  let start: Inbound = {
    state: body_start(head.framing, limits),
    buf: rest,
    continued: !head.expects_continue,
    reads: read_budget(limits.body_timeout_ms),
    slice: slice_ms(limits.body_timeout_ms),
    ended: head.framing == NoBody,
    trailers: empty_headers(),
    started: false,
  };
  with_cell[inbound](start) { cell -> {
    let answered: Result<Bool, Refusal> = try[incoming.refused] {
      handle {
        let res = app(req);
        let held = cell_get(cell);
        cell_set(cell, { ..held, started: true });
        // A client still holding its body back for a `100` is answered without it, and the
        // connection ends there, as it does where a stop came before the answer with the body
        // left unread: nothing waits on a body for a request the connection will not carry.
        let kept = keep && held.continued && (held.ended || !closing());
        respond[l](c, limits, req.method, req.version, kept, res)
      } with {
        incoming.pull() -> {
          let p = pulled[l](c, limits, cell_get(cell));
          cell_set(cell, p.inbound);
          p.piece
        },
        incoming.trailers() -> cell_get(cell).trailers,
      }
    };
    let s = cell_get(cell);
    match answered {
      Err(r) -> {
        if !s.started { refused_with[l](c, limits, r.status, r.reason ++ "\n") } else { () };
        { keep: false, rest: b"" }
      },
      Ok(kept) -> if !kept || !s.continued { { keep: false, rest: b"" } }
      else if s.ended { { keep: true, rest: s.buf } }
      else { read_past[l](c, limits, s) },
    }
  } }
}

/// The rest of a body `app` left unread, read and dropped; a body that does not end well ends the
/// connection.
fn read_past<[l]>(
  c: Int,
  limits: Limits,
  s: Inbound,
) -> Exchanged / {net.recv[l], net.send[l], abort.raise} = {
  let read: Result<Inbound, Refusal> = try[incoming.refused] {
    iterate(s, limits.max_body + s.reads + 2, |at: Inbound|
      if at.ended { Stop(at) } else { Continue(pulled[l](c, limits, at).inbound) })
  };
  match read { Ok(done) -> { keep: true, rest: done.buf }, Err(_) -> { keep: false, rest: b"" } }
}

/// The next piece of a body, reading the connection until one is decoded or the body ends: empty
/// at its end. The client is told to send it first where it waits to be. Refused where the body is
/// malformed, passes the bound, or does not arrive within its deadline.
fn pulled<[l]>(
  c: Int,
  limits: Limits,
  s: Inbound,
) -> { inbound: Inbound, piece: Bytes } / {net.recv[l], net.send[l], incoming.refused, abort.raise} =
  if s.ended { { inbound: s, piece: b"" } } else {
    if !s.continued && !send_all[l](c, continue_response(), limits.write_timeout_ms) {
      incoming.refused({ status: 400, reason: "the client went away\n" })
    } else { () };
    iterate({ ..s, continued: true }, s.reads + bytes_len(s.buf) + 2, |at: Inbound|
      match body_step(at.state, at.buf) {
        Rejected(r) -> incoming.refused(r),
        Complete(done) ->
          Stop({
            inbound: {
              ..at,
              buf: bytes_slice(at.buf, done.consumed, bytes_len(at.buf)),
              ended: true,
              trailers: done.trailers,
            },
            piece: done.out,
          }),
        Await(step) -> {
          let rest = bytes_slice(at.buf, step.consumed, bytes_len(at.buf));
          let moved = { ..at, state: step.state, buf: rest };
          if bytes_len(step.out) > 0 { Stop({ inbound: moved, piece: step.out }) }
          else if at.reads <= 0 {
            incoming.refused({ status: 408, reason: "the request body did not arrive" })
          } else if step.consumed > 0 && bytes_len(rest) > 0 {
            // The chunk budget ran out, not the input: go on without a read.
            Continue({ ..moved, reads: at.reads - 1 })
          } else {
            match net.recv[l](c, read_size(), at.slice) {
              None -> Continue({ ..moved, reads: at.reads - 1 }),
              Some(chunk) -> if bytes_len(chunk) == 0 {
                incoming.refused({ status: 400, reason: "the client closed before its body ended" })
              } else { Continue({ ..moved, buf: bytes_concat(rest, chunk), reads: at.reads - 1 }) },
            }
          }
        },
      })
  }

/// Writes `r` on `c`, the answer to a request of `method` over `version`: its head, then its body
/// whole or a chunk at a time as it is pulled, its stream closed however that ends; what a
/// connection loop of a program's own writes an answer with. Answers whether the connection may
/// carry another message: not where `keep_alive` says not, a write failed, an HTTP/1.0 stream
/// ended at the close, a stream gave other than the length it named, or one ran past
/// `max_stream_chunks`. Panics for `Http2`, whose connection's loop answers it in frames.
pub fn respond<[l] | e>(
  c: Int,
  limits: Limits,
  method: Method,
  version: Version,
  keep_alive: Bool,
  r: Response<| e>,
) -> Bool / {net.send[l], abort.raise | e} =
  match r.body {
    _ if version == Http2 ->
      panic("an HTTP/2 request is answered by its connection's loop, in frames"),
    Whole(_) ->
      send_all[l](c, encode(method, version, keep_alive, r), limits.write_timeout_ms) && keep_alive,
    Streamed(s) ->
      bracket(|| s, |held: Stream<| e>| (held.close)(), |held: Stream<| e>| {
        let keep = keep_alive && !close_framed(version, r);
        if !send_all[l](c, encode_head(method, version, keep, r), limits.write_timeout_ms) { false }
        else if method == Head || bodiless(r.status) { keep }
        else { sent_out[l](c, limits, version, held) && keep }
      }),
  }

/// A stream's chunks, each as it is pulled: as they are under a length, which they must give
/// exactly, and under HTTP/1.0, and chunk-framed under HTTP/1.1, the terminating chunk written
/// however the stream ends. Answers whether the body ended where its framing says.
fn sent_out<[l] | e>(
  c: Int,
  limits: Limits,
  version: Version,
  s: Stream<| e>,
) -> Bool / {net.send[l], abort.raise | e} = {
  let framed = s.length == None && version != Http10;
  let cap = option_unwrap_or(s.length, -1);
  let ran = iterate(
    { rest: s.chunks, sent: 0, left: limits.max_stream_chunks, ok: true, ended: false },
    limits.max_stream_chunks + 1,
    |o: { rest: Seq<Bytes | e>, sent: Int, left: Int, ok: Bool, ended: Bool }|
      if o.left <= 0 { Stop(o) } else {
        match (o.rest)() {
          Done -> Stop({ ..o, ended: true }),
          Skip(more) -> Continue({ ..o, rest: more, left: o.left - 1 }),
          Yield(chunk, more) -> if cap >= 0 && o.sent + bytes_len(chunk) > cap {
            Stop({ ..o, ok: false })
          } else if !send_all[l](
              c,
              if framed { encode_chunk(chunk) } else { chunk },
              limits.write_timeout_ms,
            ) { Stop({ ..o, ok: false }) }
          else { Continue({ ..o, rest: more, sent: o.sent + bytes_len(chunk), left: o.left - 1 }) },
        }
      },
  );
  if framed {
    // A chunked body left without its terminator is response smuggling, so it always gets one.
    send_all[l](c, last_chunk(), limits.write_timeout_ms) && ran.ok && ran.ended
  } else { ran.ok && ran.ended && (cap < 0 || ran.sent == cap) }
}

/// Accept `count` connections and answer each. `l` is the listener's label and `k` each connection's.
pub fn serve<[l], [k] | e>(
  listener: Int,
  count: Int,
  limits: Limits,
  app: Handler<| e>,
) -> Int / {abort.raise, net.accept[l], net.peer_address[k], net.peer_certificate[k], net.recv[k], net.send[k], net.close[k] | e} =
  if count <= 0 { 0 } else {
    let c = net.accept[l](listener);
    if c == 0 { 0 } else {
      serve_connection[k](c, limits, app);
      1 + serve(listener, count - 1, limits, app)
    }
  }

/// Listens on `port` and serves `count` connections, as `serve` does, after `check_limits`; the
/// listener is closed however serving ends. It answers how many connections it served.
pub fn listen_and_serve<[l], [k] | e>(
  port: Int,
  count: Int,
  limits: Limits,
  app: Handler<| e>,
) -> Int / {abort.raise, net.listen[l], net.accept[l], net.close[l], net.peer_address[k], net.peer_certificate[k], net.recv[k], net.send[k], net.close[k] | e} = {
  check_limits(limits);
  bracket(|| net.listen[l](port), |s: Int| net.close[l](s), |s: Int|
    serve[l, k](s, count, limits, app))
}

// --- HTTP/2 -----------------------------------------------------------------

/// What a connection that speaks HTTP/2 from its first byte opens with (RFC 9113 §3.4), as an
/// HTTP/1.1 reader reads it: a request head, `PRI * HTTP/2.0` and a blank line, before `SM`.
fn preface_head() -> Bytes = b"PRI * HTTP/2.0\r\n\r\n"

/// The bounds `std.http2` serves and fetches under: `l`'s body and field bounds, its keep-alive
/// bound as the streams one connection takes, the head and body deadlines together as a stream's,
/// its idle deadline, and its write deadline as the longest a response waits on a shut window;
/// `std.http2`'s defaults for the rest.
pub fn http2_limits(l: Limits) -> http2::Limits =
  {
    ..http2::default_limits(),
    max_body: l.max_body,
    max_header_list_size: l.max_request_line + l.max_header_bytes,
    max_header_block: l.max_request_line + l.max_header_bytes,
    max_requests: l.max_keep_alive,
    request_timeout_ms: l.header_timeout_ms + l.body_timeout_ms,
    idle_timeout_ms: l.idle_timeout_ms,
    stall_ms: l.write_timeout_ms,
  }

/// The request `std.http2` read on a stream, as this module reads one: its method, its target split
/// at its `?`, `Http2`, and the far end of the connection that carried it and its certificate.
fn stream_request(r: http2::Request, origin: Origin) -> Request / {abort.raise} = {
  let method = method_of(bytes_of_string(r.method));
  let start = if r.target == "*" { start_of(method, b"*", "*", "", "", Http2) }
  else { origin_form(method, bytes_of_string(r.target), Http2) };
  {
    method: method,
    target: start.target,
    path: start.path,
    query: start.query,
    authority: r.authority,
    version: Http2,
    headers: r.headers,
    trailers: r.trailers,
    body: Whole(r.body),
    peer: origin.peer,
    client_certificate: origin.certificate,
  }
}

/// A request as `std.http2` sends it, over `scheme`. Panics on a streamed body, which a client
/// sends whole.
fn wire_request(r: Request, scheme: String) -> http2::Request / {abort.raise} =
  {
    method: method_name(r.method),
    scheme: scheme,
    authority: r.authority,
    target: request_target(r),
    headers: r.headers,
    trailers: r.trailers,
    body: sent_body(r),
  }

/// The clock's reading in milliseconds.
fn clock_ms() -> Int / {clock.read} = nanos_at(clock.now()) / 1000000

fn ms_at(i: Instant) -> Int = nanos_at(i) / 1000000

/// The most turns one HTTP/2 connection takes: as many reads as its requests' heads could.
fn h2_turns(limits: Limits) -> Int / {abort.raise} = limits.max_keep_alive * max_reads()

/// A connection that speaks HTTP/2 from its first byte, as one ALPN chose `h2` for does, served
/// with `app` until `stop` is closed and drained from then on: a `GOAWAY` names the last stream
/// there could be, a second the last one taken once the client has had a round trip to see the
/// first, and every stream taken is answered before the connection closes. Each request is
/// answered as it is read whole, with `Http2` as its version and the connection's far end and its
/// client's certificate as its `peer` and `client_certificate`, and a streamed answer's chunks are pulled as the stream's window takes them, `DATA` frame
/// by frame; `http2_limits` says what it may cost. The connection is closed however serving it
/// ends.
pub fn serve_h2<[l] | e>(
  c: Int,
  limits: Limits,
  stop: Chan<Unit>,
  app: Handler<| {task.select | e}>,
) -> Unit / {abort.raise, net.peer_address[l], net.peer_certificate[l], net.recv[l], net.send[l], net.close[l], task.select, clock.read | e} =
  bracket(|| c, |h: Int| net.close[l](h), |h: Int|
    served_h2[l](h, b"", limits, app, || stopped_by(stop), origin_of[l](h)))

/// `serve_draining` for a connection not yet secured: it is secured with the `--tls` credential
/// `credential` within `header_timeout_ms`, offering `h2` and then `http/1.1` (ALPN), and served
/// as `serve_h2` serves one where the client agrees `h2`, and with HTTP/1.1 otherwise. One whose
/// handshake fails is closed. The connection is closed however serving it ends.
pub fn serve_secured<[l] | e>(
  c: Int,
  limits: Limits,
  credential: String,
  stop: Chan<Unit>,
  app: Handler<| {task.select | e}>,
) -> Unit / {abort.raise, net.peer_address[l], net.peer_certificate[l], net.serve_tls[l], net.recv[l], net.send[l], net.close[l], task.select, clock.read | e} =
  bracket(|| c, |h: Int| net.close[l](h), |h: Int|
    match net.serve_tls[l](h, credential, ["h2", "http/1.1"], b"", limits.header_timeout_ms) {
      Err(_) -> (),
      Ok(secured) -> {
        let origin = looked_up[l](h, origin_of[l](h));
        if secured.protocol == Some("h2") {
          served_h2[l](h, b"", limits, app, || stopped_by(stop), origin)
        } else {
          connection_loop[l](
            h,
            limits,
            app,
            true,
            || stopped_by(stop),
            origin,
            b"",
            limits.max_keep_alive,
            false,
          )
        }
      },
    })

/// A streamed answer's body as an HTTP/2 connection sends it: the stream, the bytes of it sent,
/// and the pulls it has left.
type Feeding<| e> = { body: Stream<| e>, sent: Int, left: Int }

/// What a turn of an HTTP/2 connection carries to the next: the connection, the bodies its
/// streams are sending, and whether one could have taken more than the turn gave it.
type Turned<| e> = { connection: http2::Connection, bodies: Map<Int, Feeding<| e>>, busy: Bool }

/// `f` where the body of the request it answers is whole already: `incoming` reads nothing more of
/// it, its trailers are `trailers`, and a refusal of it is `Err`. This is how a `Handler` is called
/// outside a serving loop, as a test calls one.
pub fn read_whole<a | e>(
  trailers: Headers,
  f: () -> a / {Reading | e},
) -> Result<a, Refusal> / {abort.raise | e} =
  try[incoming.refused] {
    handle { f() } with { incoming.pull() -> b"", incoming.trailers() -> trailers }
  }

/// `first` is what was read of the connection before it was known to be HTTP/2.
fn served_h2<[l] | e>(
  c: Int,
  first: Bytes,
  limits: Limits,
  app: Handler<| e>,
  stopping: () -> Bool / e,
  origin: Origin,
) -> Unit / {abort.raise, net.peer_certificate[l], net.recv[l], net.send[l], clock.read | e} = {
  let now = clock_ms();
  let from = looked_up[l](c, origin);
  let opened = http2::receive(
    http2::server(http2_limits(limits), at_millis(now)),
    first,
    at_millis(now),
  );
  let begun = h2_answered(opened, map_new(), app, from, limits, now);
  h2_served[l](c, limits, app, stopping, from, begun, now, false, h2_turns(limits))
}

/// Each request among `r`'s events answered by `app`, a streamed answer's body among `bodies`.
fn h2_answered<| e>(
  r: http2::Received,
  bodies: Map<Int, Feeding<| {Reading | e}>>,
  app: Handler<| e>,
  origin: Origin,
  limits: Limits,
  now: Int,
) -> Turned<| {Reading | e}> / {abort.raise | e} =
  fold(
    r.events,
    { connection: r.connection, bodies: bodies, busy: false },
    |t: Turned<| {Reading | e}>, ev: http2::Event|
      match ev {
        http2::Requested(q) -> {
          let req = stream_request(q.request, origin);
          let res = match read_whole(req.trailers, || app(req)) {
            Ok(answer) -> answer,
            Err(why) -> refusal_response(why),
          };
          match res.body {
            Whole(bytes) ->
              {
                ..t,
                connection: http2::respond(
                  t.connection,
                  q.stream,
                  { status: res.status, headers: res.headers, body: bytes },
                  at_millis(now),
                ),
              },
            Streamed(s) -> {
              let headed = http2::respond_head(
                t.connection,
                q.stream,
                res.status,
                res.headers,
                s.length,
                at_millis(now),
              );
              if http2::backlog(headed, q.stream) == None {
                read_whole(empty_headers(), s.close);
                { ..t, connection: headed }
              } else {
                {
                  ..t,
                  connection: headed,
                  bodies: map_insert(t.bodies, q.stream, {
                    body: s,
                    sent: 0,
                    left: limits.max_stream_chunks,
                  }),
                }
              }
            },
          }
        },
        _ -> t,
      },
  )

/// The bodies of `t`'s streams pulled while each stream's window and backlog take more, each body
/// that ends or whose stream is gone closed: one that gives other than the length it named, runs
/// past `max_stream_chunks` or is refused leaves its stream reset.
fn h2_fed<| e>(
  t: Turned<| {Reading | e}>,
  now: Int,
) -> Turned<| {Reading | e}> / {abort.raise | e} =
  map_fold(
    t.bodies,
    { ..t, busy: false },
    |acc: Turned<| {Reading | e}>, stream: Int, f: Feeding<| {Reading | e}>|
      fed_stream(acc, stream, f, now),
  )

/// The most octets a stream's body may wait on its windows before its next chunk is pulled.
fn h2_backlog() -> Int = 65536

/// The most chunks one stream's body gives in one turn.
fn h2_pulls() -> Int = 64

fn fed_stream<| e>(
  t: Turned<| {Reading | e}>,
  stream: Int,
  f: Feeding<| {Reading | e}>,
  now: Int,
) -> Turned<| {Reading | e}> / {abort.raise | e} = {
  let cap = option_unwrap_or(f.body.length, -1);
  let ran = iterate(
    { connection: t.connection, feeding: f, pulls: h2_pulls(), over: false },
    h2_pulls() + 1,
    |s: { connection: http2::Connection, feeding: Feeding<| {Reading | e}>, pulls: Int, over: Bool }| {
      let g = s.feeding;
      match http2::backlog(s.connection, stream) {
        None -> Stop({ ..s, over: true }),
        Some(waiting) -> if waiting >= h2_backlog() || s.pulls <= 0 { Stop(s) }
        else if g.left <= 0 {
          Stop({ ..s, connection: http2::cancel(s.connection, stream, at_millis(now)), over: true })
        } else {
          match read_whole(empty_headers(), g.body.chunks) {
            Err(_) ->
              Stop({
                ..s,
                connection: http2::cancel(s.connection, stream, at_millis(now)),
                over: true,
              }),
            Ok(Done) -> if cap >= 0 && g.sent != cap {
              Stop({
                ..s,
                connection: http2::cancel(s.connection, stream, at_millis(now)),
                over: true,
              })
            } else {
              Stop({
                ..s,
                connection: http2::give(s.connection, stream, b"", true, at_millis(now)),
                over: true,
              })
            },
            Ok(Skip(rest)) ->
              Continue({
                ..s,
                feeding: { ..g, body: { ..g.body, chunks: rest }, left: g.left - 1 },
                pulls: s.pulls - 1,
              }),
            Ok(Yield(chunk, rest)) -> if cap >= 0 && g.sent + bytes_len(chunk) > cap {
              Stop({
                ..s,
                connection: http2::cancel(s.connection, stream, at_millis(now)),
                over: true,
              })
            } else {
              Continue({
                ..s,
                connection: http2::give(s.connection, stream, chunk, false, at_millis(now)),
                feeding: {
                  body: { ..g.body, chunks: rest },
                  sent: g.sent + bytes_len(chunk),
                  left: g.left - 1,
                },
                pulls: s.pulls - 1,
              })
            },
          }
        },
      }
    },
  );
  if ran.over {
    read_whole(empty_headers(), ran.feeding.body.close);
    { ..t, connection: ran.connection, bodies: map_remove(t.bodies, stream) }
  } else {
    {
      connection: ran.connection,
      bodies: map_insert(t.bodies, stream, ran.feeding),
      busy: t.busy || ran.pulls <= 0,
    }
  }
}

/// Every body still being sent let go, as the connection ends.
fn h2_closed<| e>(bodies: Map<Int, Feeding<| {Reading | e}>>) -> Unit / {abort.raise | e} =
  map_fold(bodies, (), |u: Unit, stream: Int, f: Feeding<| {Reading | e}>| {
    read_whole(empty_headers(), f.body.close);
    u
  })

/// One turn: feed the streamed bodies, write what the machine has to say, then read what comes,
/// or let time act where nothing does before the machine's next deadline. `at` is the time as the
/// loop knows it: a read that waited in vain took at least its wait, so a clock that does not move
/// still lets every deadline come. A body that could have taken more than the turn gave it waits
/// no time for the next.
fn h2_served<[l] | e>(
  c: Int,
  limits: Limits,
  app: Handler<| e>,
  stopping: () -> Bool / e,
  origin: Origin,
  turned: Turned<| {Reading | e}>,
  at: Int,
  draining: Bool,
  fuel: Int,
) -> Unit / {abort.raise, net.recv[l], net.send[l], clock.read | e} = {
  let fed = h2_fed(turned, at);
  let out = http2::take_output(fed.connection);
  let t = { ..fed, connection: out.connection };
  if bytes_len(out.bytes) > 0 && !send_all[l](c, out.bytes, limits.write_timeout_ms) {
    h2_closed(t.bodies)
  } else if fuel <= 0 || http2::finished(t.connection) { h2_closed(t.bodies) } else {
    let now = max(clock_ms(), at);
    if !draining && stopping() {
      h2_served(
        c,
        limits,
        app,
        stopping,
        origin,
        { ..t, connection: http2::drain(t.connection, at_millis(now)) },
        now,
        true,
        fuel - 1,
      )
    } else {
      let wait = if t.busy { 1 } else {
        match http2::deadline(t.connection) {
          Some(d) -> max(1, ms_at(d) - now),
          None -> limits.idle_timeout_ms,
        }
      };
      // A loop that may yet see the stop looks at it between slices of its wait.
      let slice = if draining { wait } else { min_int(wait, idle_slice_ms()) };
      match net.recv[l](c, read_size(), slice) {
        None -> {
          let later = max(clock_ms(), now + slice);
          h2_served(
            c,
            limits,
            app,
            stopping,
            origin,
            h2_answered(
              http2::tick(t.connection, at_millis(later)),
              t.bodies,
              app,
              origin,
              limits,
              later,
            ),
            later,
            draining,
            fuel - 1,
          )
        },
        // The client hung up; nothing it sent is left to answer.
        Some(chunk) -> if bytes_len(chunk) == 0 { h2_closed(t.bodies) } else {
          h2_served(
            c,
            limits,
            app,
            stopping,
            origin,
            h2_answered(
              http2::receive(t.connection, chunk, at_millis(now)),
              t.bodies,
              app,
              origin,
              limits,
              now,
            ),
            now,
            draining,
            fuel - 1,
          )
        },
      }
    }
  }
}

/// One exchange on a connection that speaks HTTP/2 from its first byte, over `scheme`: the client's
/// preface, the request on stream 1 and its answer, then a `GOAWAY`. A response the client refuses
/// is `Malformed` with 502, one that does not come whole within the deadlines is `TimedOut`, and a
/// stream or a connection the server ends first is `Closed`.
fn exchange_h2<[l]>(
  c: Int,
  req: Request,
  scheme: String,
  limits: Limits,
) -> Result<Response<| {}>, ClientError> / {net.send[l], net.recv[l], clock.read, abort.raise} = {
  let now = clock_ms();
  match http2::request(
      http2::client(http2_limits(limits), at_millis(now)),
      wire_request(req, scheme),
      at_millis(now),
    ) {
    None -> Err(NotSent),
    Some(sent) -> {
      let asked = http2::take_output(sent.connection);
      if !send_all[l](c, asked.bytes, limits.write_timeout_ms) { Err(NotSent) }
      else { awaited_h2[l](c, asked.connection, sent.stream, limits, now, h2_turns(limits)) }
    },
  }
}

/// After the request went: a write that fails now finds the server gone.
fn awaited_h2<[l]>(
  c: Int,
  conn: http2::Connection,
  stream: Int,
  limits: Limits,
  at: Int,
  fuel: Int,
) -> Result<Response<| {}>, ClientError> / {net.send[l], net.recv[l], clock.read, abort.raise} = {
  let out = http2::take_output(conn);
  if bytes_len(out.bytes) > 0 && !send_all[l](c, out.bytes, limits.write_timeout_ms) { Err(Closed) }
  else if fuel <= 0 { Err(TimedOut) } else {
    let now = max(clock_ms(), at);
    let wait = match http2::deadline(out.connection) {
      Some(d) -> max(1, ms_at(d) - now),
      None -> limits.body_timeout_ms,
    };
    match net.recv[l](c, read_size(), wait) {
      None -> {
        let later = max(clock_ms(), now + wait);
        let r = http2::tick(out.connection, at_millis(later));
        match h2_outcome(r.events, stream, true) {
          Some(done) -> h2_finished[l](c, r.connection, limits, done),
          None -> awaited_h2(c, r.connection, stream, limits, later, fuel - 1),
        }
      },
      Some(chunk) -> if bytes_len(chunk) == 0 { Err(Closed) } else {
        let r = http2::receive(out.connection, chunk, at_millis(now));
        match h2_outcome(r.events, stream, false) {
          Some(done) -> h2_finished[l](c, r.connection, limits, done),
          None -> awaited_h2(c, r.connection, stream, limits, now, fuel - 1),
        }
      },
    }
  }
}

/// How the exchange on `stream` ended, if these events end it; `timed` says time alone made them.
fn h2_outcome(
  events: List<http2::Event>,
  stream: Int,
  timed: Bool,
) -> Option<Result<Response<| {}>, ClientError>> =
  fold(events, None, |found: Option<Result<Response<| {}>, ClientError>>, ev: http2::Event|
    if found != None { found } else {
      match ev {
        http2::Answered(a) if a.stream == stream ->
          Some(
            Ok({
              status: a.response.status,
              headers: a.response.headers,
              body: Whole(a.response.body),
            }),
          ),
        http2::Failed(f) if f.stream == stream ->
          Some(Err(if timed { TimedOut } else { Malformed({ status: 502, reason: f.reason }) })),
        http2::Reset(r) if r.stream == stream -> Some(Err(Closed)),
        http2::Closed(_) -> Some(Err(Closed)),
        _ -> None,
      }
    })

/// The exchange's end, after the client says with a `GOAWAY` that it opens no more streams.
fn h2_finished<[l]>(
  c: Int,
  conn: http2::Connection,
  limits: Limits,
  done: Result<Response<| {}>, ClientError>,
) -> Result<Response<| {}>, ClientError> / {net.send[l], clock.read, abort.raise} = {
  let goodbye = http2::take_output(http2::drain(conn, at_millis(clock_ms())));
  if bytes_len(goodbye.bytes) > 0 {
    send_all[l](c, goodbye.bytes, limits.write_timeout_ms);
    ()
  } else { () };
  done
}

// --- Shedding and draining --------------------------------------------------

/// How a pool of workers holds load. A connection accepted while every worker is busy waits in a
/// queue; one accepted while the queue is full, and one that waited past `max_wait_ms` by the time
/// a worker takes it, is shed: answered 503 with `Retry-After`, without its request being read,
/// and closed.
pub type Shedding = {
  /// Connections served at once.
  workers: Int,
  /// Connections accepted and waiting for a worker, at most; zero sheds whatever finds every
  /// worker busy.
  queue: Int,
  /// The longest a connection waits for a worker and is still served.
  max_wait_ms: Int,
  /// The seconds a shed connection is told to wait before it asks again.
  retry_after_s: Int,
}

/// Eight workers, a queue of sixty-four, a second's wait at most, and a second's `Retry-After`.
pub fn default_shedding() -> Shedding =
  { workers: 8, queue: 64, max_wait_ms: 1000, retry_after_s: 1 }

/// What a pool did with the connections it accepted: served them, or shed them because the queue
/// was full or because they had waited too long.
pub type Pooled = { served: Int, shed_full: Int, shed_late: Int }

type Queued = { conn: Int, at: Instant }

type Worked = { served: Int, late: Int }

/// Accepts up to `count` connections on `listener` and serves each with `app`, `shedding.workers`
/// at once, holding and shedding load as `Shedding` says. When `accept` answers that the listener
/// is closed, as it does at a stop, the pool drains: it accepts no more, every connection already
/// accepted is served, those in the queue included, with `serve_draining`'s rules, and it
/// answers once every worker is done. `l` is the listener's label and `k` each connection's.
pub fn serve_pooled<[l], [k] | e>(
  listener: Int,
  count: Int,
  limits: Limits,
  shedding: Shedding,
  app: Handler<| {task.select | e}>,
) -> Pooled / {abort.raise, net.accept[l], net.peer_address[k], net.peer_certificate[k], net.recv[k], net.send[k], net.close[k], task.write, clock.read | e} =
  pooled[l, k](listener, count, limits, shedding, |c: Int, stop: Chan<Unit>|
    serve_draining[k](c, limits, stop, app))

/// `serve_pooled` with each connection served by `conn`, handed the connection and the channel the
/// pool closes when it stops accepting, for a program with a connection loop of its own; a
/// connection `conn` is handed is its to close.
pub fn pooled<[l], [k] | e>(
  listener: Int,
  count: Int,
  limits: Limits,
  shedding: Shedding,
  conn: (Int, Chan<Unit>) -> Unit / e,
) -> Pooled / {abort.raise, net.accept[l], net.send[k], net.close[k], task.write, clock.read | e} =
  pool[l](listener, count, limits, shedding, |c: Int, turn: Turn<Chan<Unit>>|
    match turn { Shed -> busy[k](c, limits, shedding), Serve(stop) -> conn(c, stop) })

/// `serve_pooled` for a listener `net.listen` opened, each connection secured with the `--tls`
/// credential `credential` before anything is read of it, offering `h2` and then `http/1.1`
/// (ALPN): one whose client agrees `h2` is served as `serve_h2` serves one, and any other with
/// HTTP/1.1 as `serve_draining` serves one. A connection the pool sheds is secured offering
/// `http/1.1` alone and answered 503; one whose handshake fails within `header_timeout_ms` is
/// closed.
pub fn serve_pooled_tls<[l], [k] | e>(
  listener: Int,
  count: Int,
  limits: Limits,
  shedding: Shedding,
  credential: String,
  app: Handler<| {task.select | e}>,
) -> Pooled / {abort.raise, net.accept[l], net.peer_address[k], net.peer_certificate[k], net.serve_tls[k], net.recv[k], net.send[k], net.close[k], task.write, clock.read | e} =
  pool[l](listener, count, limits, shedding, |c: Int, turn: Turn<Chan<Unit>>|
    match turn {
      Shed -> busy_secured[k](c, limits, shedding, credential),
      Serve(stop) -> serve_secured[k](c, limits, credential, stop, app),
    })

/// What a pool does with a connection it accepted: sheds it, or serves it with what tells it the
/// pool has stopped accepting, which is a channel the pool closes.
type Turn<s> = | Shed | Serve(s)

/// The pool, each connection it accepts handed to `handled` with what to do with it.
fn pool<[l] | e>(
  listener: Int,
  count: Int,
  limits: Limits,
  shedding: Shedding,
  handled: (Int, Turn<Chan<Unit>>) -> Unit / e,
) -> Pooled / {abort.raise, net.accept[l], task.write, clock.read | e} = {
  check_limits(limits);
  check_shedding(shedding);
  let line: Chan<Queued> = task.channel(shedding.queue);
  let stop: Chan<Unit> = task.channel(0);
  let workers = map(range(0, shedding.workers), |_i: Int|
    task.spawn(|| worker(line, stop, shedding, handled, { served: 0, late: 0 }, count)));
  let accepted = accepting[l](listener, line, handled, count, 0);
  task.close(stop);
  task.close(line);
  fold(workers, { served: 0, shed_full: accepted, shed_late: 0 }, |p: Pooled, w: Task<Worked>| {
    let done = task.join(w);
    { served: p.served + done.served, shed_full: p.shed_full, shed_late: p.shed_late + done.late }
  })
}

/// A shedding of no worker, or of a negative queue, wait or `Retry-After`, is a mistake in the
/// configuration, so it panics naming the field.
pub fn check_shedding(s: Shedding) -> Unit / {abort.raise} =
  if s.workers <= 0 {
    panic("`Shedding.workers` is " ++ int_to_string(s.workers) ++ ", and a pool needs one")
  } else if s.queue < 0 || s.max_wait_ms < 0 || s.retry_after_s < 0 {
    panic("`Shedding`'s queue, wait and `Retry-After` may not be negative")
  } else { () }

/// The accept loop: each connection into the queue, or shed where it is full; answers how many it
/// shed.
fn accepting<[l] | e>(
  listener: Int,
  line: Chan<Queued>,
  handled: (Int, Turn<Chan<Unit>>) -> Unit / e,
  left: Int,
  shed: Int,
) -> Int / {abort.raise, net.accept[l], task.select, clock.read | e} =
  if left <= 0 { shed } else {
    let c = net.accept[l](listener);
    if c == 0 { shed } else {
      match try_send(line, { conn: c, at: clock.now() }) {
        Accepted -> accepting(listener, line, handled, left - 1, shed),
        _ -> {
          handled(c, Shed);
          accepting(listener, line, handled, left - 1, shed + 1)
        },
      }
    }
  }

fn worker<| e>(
  line: Chan<Queued>,
  stop: Chan<Unit>,
  shedding: Shedding,
  handled: (Int, Turn<Chan<Unit>>) -> Unit / e,
  done: Worked,
  left: Int,
) -> Worked / {abort.raise, task.recv, clock.read | e} =
  if left <= 0 { done } else {
    match task.recv(line) {
      None -> done,
      Some(q) -> if as_millis(between(q.at, clock.now())) > shedding.max_wait_ms {
        handled(q.conn, Shed);
        worker(
          line,
          stop,
          shedding,
          handled,
          { served: done.served, late: done.late + 1 },
          left - 1,
        )
      } else {
        handled(q.conn, Serve(stop));
        worker(
          line,
          stop,
          shedding,
          handled,
          { served: done.served + 1, late: done.late },
          left - 1,
        )
      },
    }
  }

/// What a shed connection is answered with, before it is closed.
pub fn busy_response<| e>(shedding: Shedding) -> Response<| e> = {
  let r = text_response(503, "the server is busy; ask again shortly\n");
  { ..r, headers: set_header(r.headers, "retry-after", int_to_string(shedding.retry_after_s)) }
}

fn busy<[k]>(
  c: Int,
  limits: Limits,
  shedding: Shedding,
) -> Unit / {net.send[k], net.close[k], abort.raise} = {
  send_all[k](c, encode(Get, Http11, false, busy_response(shedding)), limits.write_timeout_ms);
  net.close[k](c)
}

/// `busy` for a connection not yet secured: the handshake offers `http/1.1` alone, so the 503 is
/// one every client reads; one that does not secure is closed unanswered.
fn busy_secured<[k]>(
  c: Int,
  limits: Limits,
  shedding: Shedding,
  credential: String,
) -> Unit / {net.serve_tls[k], net.send[k], net.close[k], abort.raise} =
  match net.serve_tls[k](c, credential, ["http/1.1"], b"", limits.header_timeout_ms) {
    Ok(_) -> busy[k](c, limits, shedding),
    Err(_) -> net.close[k](c),
  }

// --- Tests: helpers ---------------------------------------------------------

fn head_status(raw: Bytes) -> Int / {abort.raise} = head_status_with(raw, default_limits())

/// `-1` is incomplete and `0` is accepted, so a table of cases reads as the status each input earns.
fn head_status_with(raw: Bytes, limits: Limits) -> Int / {abort.raise} =
  match parse_head(raw, limits) { Refused(r) -> r.status, Incomplete -> -1, Parsed(_) -> 0 }

fn head_reason(raw: Bytes) -> String / {abort.raise} =
  match parse_head(raw, default_limits()) {
    Refused(r) -> r.reason,
    Incomplete -> "incomplete",
    Parsed(_) -> "parsed",
  }

fn parsed(raw: Bytes) -> Head / {abort.raise} =
  match parse_head(raw, default_limits()) {
    Parsed(h) -> h,
    Refused(r) -> panic("expected a parse, got " ++ int_to_string(r.status) ++ ": " ++ r.reason),
    Incomplete -> panic("expected a parse, got an incomplete head"),
  }

/// Spreads `default_limits()`: every field is `Int`, so a hand-spelled record can mispair silently.
fn limits_with(
  request_line: Int,
  header_bytes: Int,
  header_count: Int,
  body: Int,
  chunk_size: Int,
  chunk_line: Int,
  trailer_bytes: Int,
) -> Limits = {
  let base: Limits = default_limits();
  {
    ..base,
    max_request_line: request_line,
    max_header_bytes: header_bytes,
    max_header_count: header_count,
    max_body: body,
    max_chunk_size: chunk_size,
    max_chunk_line: chunk_line,
    max_trailer_bytes: trailer_bytes,
  }
}

fn get(fields: Bytes) -> Bytes =
  bytes_concat_all([b"GET / HTTP/1.1\r\nHost: x\r\n", fields, b"\r\n"])

fn post(fields: Bytes, body: Bytes) -> Bytes =
  bytes_concat_all([b"POST / HTTP/1.1\r\nHost: x\r\n", fields, b"\r\n", body])

// --- Tests: the request line ------------------------------------------------

test "a well-formed request line is split into its parts" {
  let h = parsed(b"GET /orders?id=7 HTTP/1.1\r\nHost: api.example\r\n\r\n");
  assert_eq(h.request.method, Get);
  assert_eq(h.request.target, "/orders?id=7");
  assert_eq(h.request.path, "/orders");
  assert_eq(h.request.query, "id=7");
  assert_eq(h.request.authority, "api.example");
  assert_eq(h.request.version, Http11);
  assert_eq(h.framing, NoBody);
  assert_eq(h.consumed, 48);
  assert(h.keep_alive)
}

test "a token-valid method this server does not know reaches routing" {
  assert_eq(parsed(b"PROPFIND / HTTP/1.1\r\nHost: x\r\n\r\n").request.method, Other("PROPFIND"));
  assert_eq(parsed(b"DELETE / HTTP/1.1\r\nHost: x\r\n\r\n").request.method, Delete);
  assert_eq(method_name(Other("PROPFIND")), "PROPFIND")
}

test "a request line that is not `METHOD SP TARGET SP VERSION` is refused" {
  assert_eq(head_status(b"GET / HTTP/2.0\r\nHost: x\r\n\r\n"), 505);
  assert_eq(head_status(b"GET / HTTP/9.9\r\nHost: x\r\n\r\n"), 505);
  assert_eq(head_status(b"GET /\r\nHost: x\r\n\r\n"), 400);
  assert_eq(head_status(b"GET / \r\nHost: x\r\n\r\n"), 400);
  assert_eq(head_status(b"GE(T / HTTP/1.1\r\nHost: x\r\n\r\n"), 400);
  assert_eq(head_status(b"G\x00T / HTTP/1.1\r\nHost: x\r\n\r\n"), 400);
  assert_eq(head_status(b"GET / HTTP/1.1 extra\r\nHost: x\r\n\r\n"), 400);
  assert_eq(head_status(b"GET  HTTP/1.1\r\nHost: x\r\n\r\n"), 400);
  // Authority-form: this is a server, not a proxy, and `CONNECT` is not served.
  assert_eq(head_status(b"CONNECT example.com:443 HTTP/1.1\r\nHost: x\r\n\r\n"), 400);
  assert_eq(head_status(b"GET example.com HTTP/1.1\r\nHost: x\r\n\r\n"), 400);
  // Asterisk-form is OPTIONS and nothing else.
  assert_eq(head_status(b"GET * HTTP/1.1\r\nHost: x\r\n\r\n"), 400);
  assert_eq(head_status(b"OPTIONS * HTTP/1.1\r\nHost: x\r\n\r\n"), 0)
}

test "an absolute-form target's authority is the request's, and Host stays visible" {
  let h = parsed(b"GET http://a.example/orders?x=1 HTTP/1.1\r\nHost: b.example\r\n\r\n");
  assert_eq(h.request.authority, "a.example");
  assert_eq(h.request.path, "/orders");
  assert_eq(h.request.query, "x=1");
  assert_eq(header(h.request.headers, "host"), Some("b.example"));
  assert_eq(parsed(b"GET http://a.example HTTP/1.1\r\nHost: a\r\n\r\n").request.path, "/");
  assert_eq(parsed(b"GET http://a.example?x=1 HTTP/1.1\r\nHost: a\r\n\r\n").request.path, "/");
  // A scheme is case-insensitive, and the authority is kept as it was sent.
  assert_eq(
    parsed(b"GET HTTPS://A.example:0443/x HTTP/1.1\r\nHost: a\r\n\r\n").request.authority,
    "A.example:0443",
  );
  assert_eq(
    parsed(b"GET http://[2001:DB8::1]:8080/x HTTP/1.1\r\nHost: a\r\n\r\n").request.authority,
    "[2001:DB8::1]:8080",
  );
  assert_eq(
    parsed(b"GET http://xn--bcher-kva.example/x HTTP/1.1\r\nHost: a\r\n\r\n").request.authority,
    "xn--bcher-kva.example",
  )
}

type Target = { target: String, reason: String }

/// Targets `std.url` refuses, or reads as no `http` URL with a host.
fn refused_targets() -> List<Target> =
  [
    {
      target: "http://127.1/",
      reason: "an absolute-form target is not a URL: the host is no address: an IPv4 address is four octets",
    },
    {
      target: "http://0x7f.0.0.1/",
      reason: "an absolute-form target is not a URL: a host that ends in a number is four decimal octets",
    },
    {
      target: "http://a.example:port/",
      reason: "an absolute-form target is not a URL: a port is decimal digits",
    },
    {
      target: "http://a.example:65536/",
      reason: "an absolute-form target is not a URL: a port is at most 65535",
    },
    {
      target: "http://a.example:80:81/",
      reason: "an absolute-form target is not a URL: a port is decimal digits",
    },
    {
      target: "http://[::1/",
      reason: "an absolute-form target is not a URL: a `]` closes the address a `[` opens",
    },
    {
      target: "http://[::1%25eth0]/",
      reason: "an absolute-form target is not a URL: the host is no address: a zone is no part of an address",
    },
    {
      target: "http://ex%61mple/",
      reason: "an absolute-form target is not a URL: an escape in a host spells a character outside ASCII and nothing else",
    },
    {
      target: "http://b\u{FC}cher.example/",
      reason: "a request target's host is ASCII, a name as its A-labels",
    },
    {
      target: "http://b%C3%BCcher.example/",
      reason: "a request target's host is ASCII, a name as its A-labels",
    },
    {
      target: "http://\u{FF11}\u{FF12}\u{FF17}.0.0.1/",
      reason: "an absolute-form target is not a URL: a host that ends in a number is four decimal octets",
    },
    {
      target: "http://a.example/x[1]",
      reason: "an absolute-form target is not a URL: this character cannot stand here unencoded",
    },
    {
      target: "http://a.example/x?y={z}",
      reason: "an absolute-form target is not a URL: no part of a URL holds this character unencoded",
    },
    {
      target: "http://a.example/\\x",
      reason: "an absolute-form target is not a URL: no part of a URL holds this character unencoded",
    },
    {
      target: "http://a.example/%zz",
      reason: "an absolute-form target is not a URL: two hex digits follow a `%`",
    },
    {
      target: "http://a.example/\u{E9}",
      reason: "an absolute-form target is not a URL: outside a host's name a URL is ASCII: write this percent-encoded",
    },
    {
      target: "http://a@b@c/",
      reason: "an absolute-form target is not a URL: an authority holds one `@` at most",
    },
    { target: "http://:80/x", reason: "an absolute-form target needs an authority" },
    { target: "http:///x", reason: "an absolute-form target needs an authority" },
    { target: "http:/x", reason: "an absolute-form target needs an authority" },
    { target: "http:x", reason: "an absolute-form target needs an authority" },
    { target: "http://u@a.example/x", reason: "a request target's authority carries no userinfo" },
    {
      target: "ftp://a.example/x",
      reason: "a request target must be origin-form, absolute-form, or `*`",
    },
    {
      target: "a.example:80",
      reason: "a request target must be origin-form, absolute-form, or `*`",
    },
    { target: "a.example", reason: "a request target must be origin-form, absolute-form, or `*`" },
    {
      target: "1http://a.example/",
      reason: "a request target must be origin-form, absolute-form, or `*`",
    },
  ]

test "`{c.target}` is no absolute-form target: {c.reason}" for c: Target in refused_targets() {
  let raw = bytes_of_string("GET " ++ c.target ++ " HTTP/1.1\r\nHost: h\r\n\r\n");
  assert_eq(head_status(raw), 400);
  assert_eq(head_reason(raw), c.reason)
}

law "an absolute-form target is read as `std.url` reads its URL, and refused where that names no host to serve"
  forall (u: Url) {
    let served = (url_scheme(u) == "http" || url_scheme(u) == "https") && url_host(u) != None
      && url_userinfo(u) == None
      && url_fragment(u) == None
      && on_the_wire(u);
    match parse_head(
        bytes_of_string("GET " ++ url_render(u) ++ " HTTP/1.1\r\nHost: h\r\n\r\n"),
        default_limits(),
      ) {
      Parsed(h) ->
        served && Some(h.request.authority) == url_host_port(u)
          && h.request.path == (if url_path(u) == "" { "/" } else { url_path(u) })
          && h.request.query == option_unwrap_or(url_query(u), "")
          && h.request.target == url_render(u),
      Refused(r) -> !served && r.status == 400,
      Incomplete -> false,
    }
  }

test "a target that is not origin-form is refused rather than ending the run" {
  assert_eq(
    head_status(b"GET \xe2\x82\xac\xe2\x82\xac\xe2\x82\xac HTTP/1.1\r\nHost: x\r\n\r\n"),
    400,
  );
  assert_eq(head_status(b"GET \xf0\x9f\x92\xa9\xf0\x9f\x92\xa9 HTTP/1.1\r\nHost: x\r\n\r\n"), 400);
  assert_eq(head_status(b"GET \xe2\x82\xac HTTP/1.1\r\nHost: x\r\n\r\n"), 400);
  assert_eq(head_status(b"GET htt\xe2\x82\xac://a/x HTTP/1.1\r\nHost: x\r\n\r\n"), 400)
}

test "whitespace inside a request target is refused" {
  assert_eq(head_status(b"GET /a\tb HTTP/1.1\r\nHost: x\r\n\r\n"), 400);
  assert_eq(head_status(b"GET\t/a HTTP/1.1\r\nHost: x\r\n\r\n"), 400);
  assert_eq(head_status(b"GET /a HTTP/1.1\t\r\nHost: x\r\n\r\n"), 400);
  // A vertical tab is a control byte and is already refused by the line scan.
  assert_eq(head_status(b"GET /a\x0bb HTTP/1.1\r\nHost: x\r\n\r\n"), 400);
  // HTAB stays legal where it is legal, which is inside a field value.
  assert_eq(
    header(parsed(b"GET / HTTP/1.1\r\nHost: x\r\nFoo: a\tb\r\n\r\n").request.headers, "foo"),
    Some("a\tb"),
  )
}

test "an absolute-form target carrying userinfo is refused" {
  assert_eq(
    head_status(b"GET http://trusted.example@evil.example/x HTTP/1.1\r\nHost: h\r\n\r\n"),
    400,
  );
  assert_eq(head_status(b"GET http://u:p@evil.example/x HTTP/1.1\r\nHost: h\r\n\r\n"), 400);
  assert_eq(head_status(b"GET http:///x HTTP/1.1\r\nHost: h\r\n\r\n"), 400)
}

test "a request target carrying a fragment is refused" {
  assert_eq(head_status(b"GET http://h#a/b HTTP/1.1\r\nHost: h\r\n\r\n"), 400);
  assert_eq(head_status(b"GET http://h/x#a HTTP/1.1\r\nHost: h\r\n\r\n"), 400);
  assert_eq(head_status(b"GET /health#x HTTP/1.1\r\nHost: h\r\n\r\n"), 400);
  assert_eq(head_status(b"GET /health?q=a#x HTTP/1.1\r\nHost: h\r\n\r\n"), 400);
  // Percent-encoded, it is an ordinary byte of the path and nothing splits on it.
  assert_eq(parsed(b"GET /health%23x HTTP/1.1\r\nHost: h\r\n\r\n").request.path, "/health%23x")
}

test "a request line over the bound is 414 and is not buffered past it" {
  let small = limits_with(32, 1024, 8, 64, 64, 64, 64);
  let long = bytes_concat_all([b"GET /", filler(4096), b" HTTP/1.1\r\nHost: x\r\n\r\n"]);
  assert_eq(head_status_with(long, small), 414);
  // Under the default bound the same input frames, so 414 is the bound, not a parse failure.
  assert_eq(head_status(long), 0)
}

fn filler(n: Int) -> Bytes = bytes_concat_all(map(range(0, n), |i: Int| b"a"))

// --- Tests: line terminators ------------------------------------------------

test "a line ends with CRLF and with nothing else" {
  assert_eq(head_status(b"GET / HTTP/1.1\nHost: x\r\n\r\n"), 400);
  assert_eq(head_status(b"GET / HTTP/1.1\r\nHost: x\n\r\n"), 400);
  assert_eq(head_status(b"GET / HTTP/1.1\r\nHost: x\rmore\r\n\r\n"), 400);
  assert_eq(head_status(b"GET / HTTP/1.1\r\nHost: x\r\nFoo: a\x00b\r\n\r\n"), 400);
  assert_eq(head_status(b"GET / HTTP/1.1\r\nHost: x\r\nFoo: a\x7fb\r\n\r\n"), 400);
  // A tab inside a value is legal and is the one control byte that is.
  assert_eq(head_status(b"GET / HTTP/1.1\r\nHost: x\r\nFoo: a\tb\r\n\r\n"), 0);
  assert_eq(
    header(parsed(b"GET / HTTP/1.1\r\nHost: x\r\nFoo: a\tb\r\n\r\n").request.headers, "foo"),
    Some("a\tb"),
  )
}

test "obsolete line folding and whitespace before a colon are refused" {
  assert_eq(head_status(b"GET / HTTP/1.1\r\nHost: x\r\nFoo: a\r\n bar\r\n\r\n"), 400);
  assert_eq(
    head_reason(b"GET / HTTP/1.1\r\nHost: x\r\nFoo: a\r\n bar\r\n\r\n"),
    "obsolete line folding is not accepted",
  );
  assert_eq(head_status(b"GET / HTTP/1.1\r\nHost: x\r\nFoo: a\r\n\tbar\r\n\r\n"), 400);
  assert_eq(head_status(b"GET / HTTP/1.1\r\nHost: x\r\nFoo : bar\r\n\r\n"), 400);
  assert_eq(
    head_reason(b"GET / HTTP/1.1\r\nHost: x\r\nFoo : bar\r\n\r\n"),
    "whitespace between a field name and its colon",
  );
  assert_eq(head_status(b"GET / HTTP/1.1\r\nHost: x\r\nFo o: bar\r\n\r\n"), 400);
  assert_eq(head_status(b"GET / HTTP/1.1\r\nHost: x\r\n: bar\r\n\r\n"), 400);
  assert_eq(head_status(b"GET / HTTP/1.1\r\nHost: x\r\nnocolon\r\n\r\n"), 400)
}

test "a head that has not finished arriving is incomplete rather than refused" {
  assert_eq(head_status(b""), -1);
  assert_eq(head_status(b"GET / HTTP/1.1\r\n"), -1);
  assert_eq(head_status(b"GET / HTTP/1.1\r\nHost: x\r\n"), -1);
  assert_eq(head_status(b"GET / HTTP/1.1\r\nHost: x\r\n\r"), -1);
  assert_eq(head_status(b"GET / HTT"), -1)
}

// --- Tests: Host ------------------------------------------------------------

test "an HTTP/1.1 request carries exactly one Host" {
  assert_eq(head_status(b"GET / HTTP/1.1\r\n\r\n"), 400);
  assert_eq(head_status(b"GET / HTTP/1.1\r\nHost: a\r\nHost: b\r\n\r\n"), 400);
  assert_eq(head_status(b"GET / HTTP/1.1\r\nHost: a\r\nhost: a\r\n\r\n"), 400);
  // HTTP/1.0 predates it.
  assert_eq(head_status(b"GET / HTTP/1.0\r\n\r\n"), 0);
  assert_eq(parsed(b"GET / HTTP/1.0\r\n\r\n").request.authority, "")
}

// --- Tests: Content-Length --------------------------------------------------

test "a duplicate Content-Length is refused even when the values agree" {
  assert_eq(head_status(post(b"Content-Length: 5\r\nContent-Length: 5\r\n", b"hello")), 400);
  assert_eq(head_status(post(b"Content-Length: 5\r\nContent-Length: 6\r\n", b"hello")), 400);
  // A comma-separated list is one field line and is not digits.
  assert_eq(head_status(post(b"Content-Length: 5, 5\r\n", b"hello")), 400)
}

test "a Content-Length is one or more ASCII digits and nothing else" {
  assert_eq(head_status(post(b"Content-Length: +5\r\n", b"hello")), 400);
  assert_eq(head_status(post(b"Content-Length: -5\r\n", b"hello")), 400);
  assert_eq(head_status(post(b"Content-Length: 5x\r\n", b"hello")), 400);
  assert_eq(head_status(post(b"Content-Length: 0x5\r\n", b"hello")), 400);
  assert_eq(head_status(post(b"Content-Length: \r\n", b"")), 400);
  // U+0660 ARABIC-INDIC DIGIT ZERO: a digit, and not an ASCII one.
  assert_eq(head_status(post(b"Content-Length: \xd9\xa0\r\n", b"")), 400);
  // Leading and trailing OWS around the value is not part of it, so ` 5 ` is 5.
  assert_eq(parsed(post(b"Content-Length:  5 \r\n", b"hello")).framing, Length(5));
  assert_eq(parsed(post(b"Content-Length: 007\r\n", b"hello!!")).framing, Length(7))
}

test "a Content-Length over the bound is 413 before a body byte is read" {
  let small = limits_with(8192, 65536, 100, 16, 64, 64, 64);
  assert_eq(head_status_with(post(b"Content-Length: 17\r\n", b""), small), 413);
  assert_eq(head_status_with(post(b"Content-Length: 16\r\n", b""), small), 0);
  // A value too long to be any body at all, refused without arithmetic that could overflow.
  assert_eq(head_status(post(b"Content-Length: 99999999999999999999999999\r\n", b"")), 413)
}

// --- Tests: Transfer-Encoding -----------------------------------------------

test "Content-Length and Transfer-Encoding together is refused" {
  assert_eq(head_status(post(b"Content-Length: 5\r\nTransfer-Encoding: chunked\r\n", b"")), 400);
  assert_eq(head_status(post(b"Transfer-Encoding: chunked\r\nContent-Length: 5\r\n", b"")), 400);
  assert_eq(
    head_reason(post(b"Content-Length: 5\r\nTransfer-Encoding: chunked\r\n", b"")),
    "a request carries `Content-Length` or `Transfer-Encoding`, never both",
  )
}

test "chunked must be the final transfer coding and may be applied once" {
  assert_eq(head_status(post(b"Transfer-Encoding: chunked\r\n", b"0\r\n\r\n")), 0);
  assert_eq(parsed(post(b"Transfer-Encoding: chunked\r\n", b"0\r\n\r\n")).framing, Chunked);
  assert_eq(head_status(post(b"Transfer-Encoding: chunked, gzip\r\n", b"")), 400);
  assert_eq(head_status(post(b"Transfer-Encoding: gzip, chunked, chunked\r\n", b"")), 400);
  assert_eq(head_status(post(b"Transfer-Encoding: gzip\r\n", b"")), 501);
  assert_eq(head_status(post(b"Transfer-Encoding: identity\r\n", b"")), 501);
  // A coding this server cannot decode is 501 even when `chunked` is the last of them.
  assert_eq(head_status(post(b"Transfer-Encoding: gzip, chunked\r\n", b"0\r\n\r\n")), 501);
  // Two field lines are one list, in order of appearance.
  assert_eq(
    head_status(post(b"Transfer-Encoding: gzip\r\nTransfer-Encoding: chunked\r\n", b"0\r\n\r\n")),
    501,
  );
  assert_eq(
    head_status(post(b"Transfer-Encoding: chunked\r\nTransfer-Encoding: gzip\r\n", b"")),
    400,
  );
  // Case and whitespace are not a way past it.
  assert_eq(parsed(post(b"Transfer-Encoding:  ChUnKeD \r\n", b"0\r\n\r\n")).framing, Chunked);
  // The Kelvin sign is `k` in Unicode's lower case, and is no letter of `chunked`.
  assert_eq(head_status(post(b"Transfer-Encoding: chun\xe2\x84\xaaed\r\n", b"0\r\n\r\n")), 501)
}

// `Content-Encoding` is end to end and is not a transfer coding.
test "Content-Encoding is passed through untouched" {
  let h = parsed(post(b"Content-Encoding: gzip\r\nContent-Length: 3\r\n", b"abc"));
  assert_eq(h.framing, Length(3));
  assert_eq(header(h.request.headers, "content-encoding"), Some("gzip"))
}

// --- Tests: bodies ----------------------------------------------------------

type Decoded = { bytes: Bytes, trailers: Headers, consumed: Int }

fn decode_body(framing: Framing, buf: Bytes) -> Result<Decoded, Refusal> / {abort.raise} =
  decode_from(body_start(framing, default_limits()), buf, 0, [], 64)

fn decode_body_with(
  framing: Framing,
  buf: Bytes,
  limits: Limits,
) -> Result<Decoded, Refusal> / {abort.raise} =
  decode_from(body_start(framing, limits), buf, 0, [], 64)

/// Step until `Complete`; a step that consumed and produced nothing means truncated, not loop again.
reuse fn decode_from(
  state: BodyState,
  buf: Bytes,
  at: Int,
  out: List<Bytes>,
  fuel: Int,
) -> Result<Decoded, Refusal> / {abort.raise} =
  if fuel <= 0 { Err({ status: 0, reason: "the decoder did not finish" }) } else {
    match body_step(state, bytes_slice(buf, at, bytes_len(buf))) {
      Rejected(r) -> Err(r),
      Complete(d) ->
        Ok({
          bytes: bytes_concat_all(push(out, d.out)),
          trailers: d.trailers,
          consumed: at + d.consumed,
        }),
      Await(s) -> if s.consumed == 0 && bytes_len(s.out) == 0 {
        Err({ status: 0, reason: "truncated" })
      } else { decode_from(s.state, buf, at + s.consumed, push(out, s.out), fuel - 1) },
    }
  }

fn body_status(framing: Framing, buf: Bytes, limits: Limits) -> Int / {abort.raise} =
  match decode_body_with(framing, buf, limits) { Err(r) -> r.status, Ok(_) -> 0 }

fn decoded(framing: Framing, buf: Bytes) -> Decoded / {abort.raise} =
  match decode_body(framing, buf) { Ok(d) -> d, Err(r) -> panic("expected a body: " ++ r.reason) }

test "a length-framed body stops at its length and leaves the rest" {
  let d = decoded(Length(5), b"helloGET / HTTP/1.1\r\n");
  assert_eq(d.bytes, b"hello");
  assert_eq(d.consumed, 5);
  assert_eq(map_len(d.trailers), 0);
  assert_eq(decoded(Length(0), b"anything").bytes, b"");
  assert_eq(decoded(NoBody, b"anything").consumed, 0)
}

test "a body arriving in pieces decodes to the same bytes" {
  let whole = decoded(Length(11), b"hello world");
  assert_eq(whole.bytes, b"hello world");
  match body_step(body_start(Length(11), default_limits()), b"hello ") {
    Await(s) -> {
      assert_eq(s.out, b"hello ");
      assert_eq(s.consumed, 6);
      match body_step(s.state, b"world") {
        Complete(d) -> {
          assert_eq(d.out, b"world");
          assert_eq(d.consumed, 5)
        },
        _ -> panic("the second piece should have completed the body"),
      }
    },
    _ -> panic("a partial body should await"),
  }
}

test "a chunked body decodes, and every malformed chunk is refused" {
  assert_eq(decoded(Chunked, b"5\r\nhello\r\n0\r\n\r\n").bytes, b"hello");
  assert_eq(decoded(Chunked, b"5\r\nhello\r\n6\r\n world\r\n0\r\n\r\n").bytes, b"hello world");
  assert_eq(decoded(Chunked, b"0\r\n\r\n").bytes, b"");
  // Extensions are parsed for framing and discarded; nothing reads them.
  assert_eq(decoded(Chunked, b"5;name=value\r\nhello\r\n0\r\n\r\n").bytes, b"hello");
  // Upper and lower case hex, and a size with a leading zero.
  assert_eq(decoded(Chunked, b"A\r\n0123456789\r\n0\r\n\r\n").bytes, b"0123456789");
  assert_eq(decoded(Chunked, b"00a\r\n0123456789\r\n0\r\n\r\n").bytes, b"0123456789");

  let l = default_limits();
  assert_eq(body_status(Chunked, b"\r\nhello\r\n0\r\n\r\n", l), 400);
  assert_eq(body_status(Chunked, b"5x\r\nhello\r\n0\r\n\r\n", l), 400);
  assert_eq(body_status(Chunked, b"-5\r\nhello\r\n0\r\n\r\n", l), 400);
  assert_eq(body_status(Chunked, b"0x5\r\nhello\r\n0\r\n\r\n", l), 400);
  assert_eq(body_status(Chunked, b"11111111111111111\r\nx\r\n0\r\n\r\n", l), 400);
  // The data and the size disagree: two implementations would place the boundary differently.
  assert_eq(body_status(Chunked, b"5\r\nhelloX\r\n0\r\n\r\n", l), 400);
  assert_eq(body_status(Chunked, b"5\r\nhello\n0\r\n\r\n", l), 400)
}

test "a chunk size that does not fit in an Int is refused rather than overflowing" {
  let l = default_limits();
  assert_eq(body_status(Chunked, b"FFFFFFFFFFFFFFFF\r\nx\r\n0\r\n\r\n", l), 413);
  assert_eq(body_status(Chunked, b"8000000000000000\r\nx\r\n0\r\n\r\n", l), 413);
  assert_eq(body_status(Chunked, b"ffffffffffffffff;e=1\r\nx\r\n0\r\n\r\n", l), 413);
  // The largest size that fits is still over `max_chunk_size`, so the two share a refusal.
  assert_eq(body_status(Chunked, b"7FFFFFFFFFFFFFFF\r\nx\r\n0\r\n\r\n", l), 413);
  // Leading zeros are legal, so the guard counts significant digits.
  assert_eq(decoded(Chunked, b"0000000000000005\r\nhello\r\n0\r\n\r\n").bytes, b"hello");
  assert_eq(body_status(Chunked, b"0000000000000000\r\n\r\n", l), 0)
}

test "a chunk over the size bound and a body over the length bound are 413" {
  let small = limits_with(8192, 65536, 100, 8, 4, 64, 64);
  assert_eq(body_status(Chunked, b"5\r\nhello\r\n0\r\n\r\n", small), 413);
  assert_eq(body_status(Chunked, b"4\r\nhell\r\n0\r\n\r\n", small), 0);
  // Each chunk is under `max_chunk_size` and their sum is over `max_body`.
  assert_eq(body_status(Chunked, b"4\r\nhell\r\n4\r\nabcd\r\n4\r\nefgh\r\n0\r\n\r\n", small), 413)
}

test "a chunk-size line over the bound is 400" {
  let small = limits_with(8192, 65536, 100, 1048576, 1048576, 16, 64);
  let long = bytes_concat_all([b"5;", filler(1024), b"\r\nhello\r\n0\r\n\r\n"]);
  assert_eq(body_status(Chunked, long, small), 400);
  assert_eq(body_status(Chunked, long, default_limits()), 0)
}

test "trailers are exposed separately and never merged into headers" {
  // A trailer section where a chunk-size line belongs frames nothing, and is refused.
  assert_eq(
    body_status(
      Chunked,
      b"5\r\nhello\r\nContent-Length: 0\r\nAuthorization: root\r\n\r\n0\r\n\r\n",
      default_limits(),
    ),
    400,
  );

  let t = decoded(Chunked, b"5\r\nhello\r\n0\r\nContent-Length: 0\r\nAuthorization: root\r\n\r\n");
  assert_eq(t.bytes, b"hello");
  assert_eq(header(t.trailers, "content-length"), Some("0"));
  assert_eq(header(t.trailers, "authorization"), Some("root"));

  // The head's framing was decided before the trailers arrived, and never sees them.
  let h = parsed(post(b"Transfer-Encoding: chunked\r\n", b""));
  assert_eq(h.framing, Chunked);
  assert_eq(header(h.request.headers, "authorization"), None);
  assert_eq(map_len(h.request.trailers), 0);
  // A trailer section that is not a header block is refused like one.
  assert_eq(body_status(Chunked, b"0\r\nFoo : bar\r\n\r\n", default_limits()), 400)
}

test "a body that stops mid-chunk is truncated rather than accepted short" {
  assert_eq(decode_body(Chunked, b"5\r\nhel"), Err({ status: 0, reason: "truncated" }));
  assert_eq(decode_body(Chunked, b"5\r\nhello\r\n"), Err({ status: 0, reason: "truncated" }));
  assert_eq(decode_body(Chunked, b"5\r\nhello\r\n0\r\n"), Err({ status: 0, reason: "truncated" }));
  assert_eq(decode_body(Length(5), b"hel"), Err({ status: 0, reason: "truncated" }))
}

// --- Tests: sizes -----------------------------------------------------------

test "a header block over its bounds is 431" {
  let small = limits_with(8192, 64, 4, 1024, 1024, 1024, 1024);
  assert_eq(head_status_with(get(b"Foo: bar\r\n"), small), 0);
  assert_eq(head_status_with(get(bytes_concat_all([b"Foo: ", filler(200), b"\r\n"])), small), 431);
  assert_eq(head_status_with(get(b"A: 1\r\nB: 2\r\nC: 3\r\nD: 4\r\nE: 5\r\n"), small), 431);
  // The same heads are ordinary under the default bounds.
  assert_eq(head_status(get(bytes_concat_all([b"Foo: ", filler(200), b"\r\n"]))), 0);
  assert_eq(head_status(get(b"A: 1\r\nB: 2\r\nC: 3\r\nD: 4\r\nE: 5\r\n")), 0)
}

// --- Tests: Expect and Connection -------------------------------------------

test "Expect is 100-continue or 417" {
  assert(parsed(post(b"Content-Length: 5\r\nExpect: 100-continue\r\n", b"hello")).expects_continue);
  assert(parsed(post(b"Content-Length: 5\r\nExpect: 100-Continue\r\n", b"hello")).expects_continue);
  assert(!parsed(post(b"Content-Length: 5\r\n", b"hello")).expects_continue);
  assert_eq(head_status(post(b"Expect: something-else\r\n", b"")), 417);
  assert_eq(head_status(post(b"Expect: 100-continue\r\nExpect: 100-continue\r\n", b"")), 417)
}

test "keep-alive is the version's default unless Connection says otherwise" {
  assert(parsed(b"GET / HTTP/1.1\r\nHost: x\r\n\r\n").keep_alive);
  assert(!parsed(b"GET / HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n").keep_alive);
  assert(!parsed(b"GET / HTTP/1.1\r\nHost: x\r\nConnection: Close\r\n\r\n").keep_alive);
  assert(!parsed(b"GET / HTTP/1.1\r\nHost: x\r\nConnection: keep-alive, close\r\n\r\n").keep_alive);
  assert(!parsed(b"GET / HTTP/1.0\r\n\r\n").keep_alive);
  assert(parsed(b"GET / HTTP/1.0\r\nConnection: keep-alive\r\n\r\n").keep_alive);
  assert(parsed(b"GET / HTTP/1.0\r\nConnection: Keep-Alive\r\n\r\n").keep_alive);
  assert(!parsed(b"GET / HTTP/1.0\r\nConnection: \xe2\x84\xaaeep-alive\r\n\r\n").keep_alive)
}

// A no-break space and an em space, which Unicode's trim takes and a proxy's does not.
test "white space outside ASCII beside a token is part of it, in each field that frames a message" {
  assert_eq(head_status(post(b"Transfer-Encoding: chunked\xe2\x80\x83\r\n", b"0\r\n\r\n")), 501);
  assert_eq(head_status(post(b"Transfer-Encoding: \xc2\xa0chunked\r\n", b"0\r\n\r\n")), 501);
  assert_eq(
    head_status(post(b"Transfer-Encoding: gzip,\xe2\x80\x83chunked\r\n", b"0\r\n\r\n")),
    501,
  );
  assert_eq(parsed(post(b"Transfer-Encoding: \t chunked\t \r\n", b"0\r\n\r\n")).framing, Chunked);
  assert_eq(head_status(post(b"Content-Length: 5\xc2\xa0\r\n", b"hello")), 400);
  assert_eq(head_status(post(b"Content-Length: \xe2\x80\x835\r\n", b"hello")), 400);
  assert_eq(
    head_status(post(b"Content-Length: 5\r\nExpect: 100-continue\xc2\xa0\r\n", b"hello")),
    417,
  );
  assert_eq(
    head_status(post(b"Content-Length: 5\r\nExpect: \xe2\x80\x83100-continue\r\n", b"hello")),
    417,
  );
  assert(parsed(b"GET / HTTP/1.1\r\nHost: x\r\nConnection: close\xc2\xa0\r\n\r\n").keep_alive);
  assert(parsed(b"GET / HTTP/1.1\r\nHost: x\r\nConnection: a,\xc2\xa0close\r\n\r\n").keep_alive);
  assert(!parsed(b"GET / HTTP/1.1\r\nHost: x\r\nConnection: a ,\t close\r\n\r\n").keep_alive);
  assert(!parsed(b"GET / HTTP/1.0\r\nConnection: \xe2\x80\x83keep-alive\r\n\r\n").keep_alive)
}

// --- Tests: header representation -------------------------------------------

test "a repeated field keeps every line in order and combines nothing" {
  let h = parsed(b"GET / HTTP/1.1\r\nHost: x\r\nSet-Cookie: a=1\r\nSet-Cookie: b=2\r\n\r\n");
  assert_eq(header_lines(h.request.headers, "set-cookie"), ["a=1", "b=2"]);
  assert_eq(header(h.request.headers, "set-cookie"), Some("a=1"));
  // Names are lowercased on parse, so a lookup cannot depend on what the peer capitalised.
  assert(has_header(h.request.headers, "set-cookie"));
  assert(!has_header(h.request.headers, "Set-Cookie"));
  assert_eq(header_lines(h.request.headers, "absent"), []);
  // Only `A-Z` are folded: a name spelled with the Kelvin sign is not the one spelled with `k`.
  let set = add_header(set_header(empty_headers(), "Set-Cookie", "a=1"), "Coo\u{212A}ie", "b=2");
  assert_eq(header_lines(set, "set-cookie"), ["a=1"]);
  assert(!has_header(set, "cookie"));
  assert(has_header(set, "coo\u{212A}ie"))
}

test "a field value that is not text is refused rather than decoded lossily" {
  assert_eq(head_status(b"GET / HTTP/1.1\r\nHost: x\r\nFoo: \xff\xfe\r\n\r\n"), 400);
  // Valid UTF-8 above ASCII is obs-text and is passed through as written.
  assert_eq(
    header(parsed(b"GET / HTTP/1.1\r\nHost: x\r\nFoo: caf\xc3\xa9\r\n\r\n").request.headers, "foo"),
    Some("café"),
  )
}

// --- Tests: the framing property --------------------------------------------

fn adversarial() -> List<Bytes> =
  [
    b"GET / HTTP/1.1\r\nHost: x\r\n\r\n",
    b"POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n\r\nhello",
    b"POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 0\r\n\r\n",
    b"POST / HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n",
    b"POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\nTransfer-Encoding: chunked\r\n\r\nhello",
    b"POST / HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\nContent-Length: 5\r\n\r\nhello",
    b"POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\nContent-Length: 5\r\n\r\nhello",
    b"POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\nContent-Length: 6\r\n\r\nhello",
    b"POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 5, 5\r\n\r\nhello",
    b"POST / HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked, identity\r\n\r\n5\r\nhello\r\n",
    b"POST / HTTP/1.1\r\nHost: x\r\nTransfer-Encoding : chunked\r\n\r\n0\r\n\r\n",
    b"POST / HTTP/1.1\r\nHost: x\r\nTransfer-Encoding:\r\n chunked\r\n\r\n0\r\n\r\n",
    b"POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 5\n\r\nhello",
    b"POST / HTTP/1.1\nHost: x\nContent-Length: 5\n\nhello",
    b"POST / HTTP/1.1\r\nHost: x\r\nContent-Length: \x0035\r\n\r\nhello",
    b"POST / HTTP/1.1\r\nHost: x\r\nX: y\r\nContent-Length: 5\r\n\r\nhello",
    b"POST / HTTP/1.1\r\nHost: x\r\nhost: y\r\nContent-Length: 5\r\n\r\nhello",
    b"POST / HTTP/1.1\r\nContent-Length: 5\r\n\r\nhello",
    b"GET / HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n\r\nhello",
    b"GET / HTTP/1.1\r\nHost: x\r\n\r\nGET /two HTTP/1.1\r\nHost: x\r\n\r\n",
  ]

/// The oracle: the message length read off the field lines, without calling the parser.
fn reference_length(raw: Bytes) -> Int / {abort.raise} = {
  let head_end = match bytes_index_of(raw, b"\r\n\r\n") { Some(at) -> at + 4, None -> -1 };
  if head_end < 0 { -1 } else {
    let lines = string_split(string_of_bytes_lossy(bytes_slice(raw, 0, head_end)), "\r\n");
    let cl = values_of(lines, "content-length:");
    let te = values_of(lines, "transfer-encoding:");
    if len(te) > 0 && len(cl) > 0 { -1 }
    else if len(te) > 0 { if last_string(te) == "chunked" { -2 } else { -1 } }
    else if len(cl) > 1 { -1 }
    else { match cl { [only] -> reference_int(only), _ -> 0 } }
  }
}

fn values_of(lines: List<String>, prefix: String) -> List<String> / {abort.raise} =
  fold(lines, [], |acc: List<String>, line: String|
    if string_starts_with(ascii_lower(line), prefix) {
      push(acc, ascii_lower(ascii_trim(string_slice(line, string_len(prefix), string_len(line)))))
    } else { acc })

fn reference_int(raw: String) -> Int / {abort.raise} = {
  let b = bytes_of_string(raw);
  if !all_digits(b) { -1 } else { match int_of_ascii(b) { Some(n) -> n, None -> -1 } }
}

test "no accepted head admits two framings" {
  fold(adversarial(), (), |acc: Unit, raw: Bytes| one_framing(raw))
}

fn one_framing(raw: Bytes) -> Unit / {abort.raise} =
  match parse_head(raw, default_limits()) {
    Refused(_) -> (),
    Incomplete -> (),
    Parsed(h) -> {
      // The oracle found exactly one framing available, and the parser chose it.
      let reference = reference_length(raw);
      assert(reference >= -2);
      assert(reference != -1);
      assert_eq(
        match h.framing { Length(n) -> n, Chunked -> -2, NoBody -> 0, UntilClose -> -3 },
        reference,
      );
      // `consumed` lands on the oracle's terminator, so the body starts at the same byte for both.
      assert_eq(h.consumed, match bytes_index_of(raw, b"\r\n\r\n") {
        Some(at) -> at + 4,
        None -> -1,
      })
    },
  }

law "an accepted head names a boundary inside the bytes it was given"
  forall (raw: Bytes) {
    match parse_head(raw, default_limits()) {
      Parsed(h) -> h.consumed >= 0 && h.consumed <= bytes_len(raw),
      Refused(r) -> r.status >= 400,
      Incomplete -> true,
    }
  }

// What makes carrying a pipelined remainder across iterations of the serve loop safe.
law "a head frames the same message however much follows it"
  forall (raw: Bytes) {
    parse_head(raw, default_limits()) == parse_head(raw, default_limits())
  }

// --- Tests: pipelining ------------------------------------------------------

test "consumed is where the body begins, so a pipelined request is a slice" {
  let two = b"GET /one HTTP/1.1\r\nHost: x\r\n\r\nGET /two HTTP/1.1\r\nHost: x\r\n\r\n";
  let first = parsed(two);
  assert_eq(first.request.path, "/one");
  assert_eq(first.consumed, 30);
  let rest = bytes_slice(two, first.consumed, bytes_len(two));
  assert_eq(parsed(rest).request.path, "/two");

  let posted = b"POST /one HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n\r\nhelloGET /two HTTP/1.1\r\nHost: x\r\n\r\n";
  let h = parsed(posted);
  assert_eq(h.framing, Length(5));
  let after = bytes_slice(posted, h.consumed, bytes_len(posted));
  let d = decoded(Length(5), after);
  assert_eq(d.bytes, b"hello");
  assert_eq(parsed(bytes_slice(after, d.consumed, bytes_len(after))).request.path, "/two")
}

// --- Tests: responses -------------------------------------------------------

test "a response carries exactly one framing field" {
  assert_eq(
    encode(Get, Http11, true, response(200, b"hi")),
    b"HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nhi",
  );
  assert_eq(
    encode(Get, Http11, false, response(200, b"hi")),
    b"HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nhi",
  );
  assert_eq(
    encode(Get, Http10, true, response(200, b"hi")),
    b"HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: keep-alive\r\n\r\nhi",
  )
}

test "a 405 built here carries the Allow field it must" {
  let r = method_not_allowed([Get, Head, Post]);
  assert_eq(r.status, 405);
  assert_eq(header(r.headers, "allow"), Some("GET, HEAD, POST"));
  assert_eq(method_not_allowed([]).status, 405);
  assert_eq(allow_field([Delete]), "DELETE");
  assert_eq(allow_field([Get, Other("PROPFIND")]), "GET, PROPFIND");
  // It survives `encode`, which refuses a malformed header rather than sanitizing it.
  assert(match bytes_index_of(encode(Get, Http11, false, r), b"allow: GET, HEAD, POST\r\n") {
    Some(_) -> true,
    None -> false,
  })
}

test "1xx, 204 and 304 carry no body and no Content-Length" {
  assert_eq(
    encode(Get, Http11, true, response(204, b"ignored")),
    b"HTTP/1.1 204 No Content\r\n\r\n",
  );
  assert_eq(
    encode(Get, Http11, true, response(304, b"ignored")),
    b"HTTP/1.1 304 Not Modified\r\n\r\n",
  );
  assert_eq(encode(Get, Http11, true, response(100, b"ignored")), b"HTTP/1.1 100 Continue\r\n\r\n")
}

test "a HEAD response carries Content-Length and no body" {
  assert_eq(
    encode(Head, Http11, true, response(200, b"hello")),
    b"HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\n",
  );
  assert_eq(
    encode(Get, Http11, true, response(200, b"hello")),
    b"HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nhello",
  )
}

test "a response's header order is a function of its value" {
  let r: Response<| {}> = {
    status: 200,
    headers: add_header(add_header(set_header(empty_headers(), "b", "2"), "a", "1"), "a", "3"),
    body: Whole(b""),
  };
  assert_eq(
    encode(Get, Http11, true, r),
    b"HTTP/1.1 200 OK\r\na: 1\r\na: 3\r\nb: 2\r\nContent-Length: 0\r\n\r\n",
  )
}

test "a stream is framed by its length where it names one, and by Transfer-Encoding where not" {
  let open: Response<| {}> = { status: 200, headers: empty_headers(), body: chunked(seq::empty()) };
  let sized: Response<| {}> = {
    status: 200,
    headers: empty_headers(),
    body: Streamed({ length: Some(7), chunks: seq::empty(), close: || () }),
  };
  assert_eq(
    encode_head(Get, Http11, true, open),
    b"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n",
  );
  assert_eq(
    encode_head(Head, Http11, true, sized),
    b"HTTP/1.1 200 OK\r\nContent-Length: 7\r\n\r\n",
  );
  assert_eq(encode_head(Get, Http10, true, open), b"HTTP/1.1 200 OK\r\nConnection: close\r\n\r\n");
  assert_eq(
    encode_head(Get, Http10, true, sized),
    b"HTTP/1.1 200 OK\r\nContent-Length: 7\r\nConnection: keep-alive\r\n\r\n",
  );
  assert_eq(encode_chunk(b"hello"), b"5\r\nhello\r\n");
  assert_eq(encode_chunk(filler(16)), bytes_concat_all([b"10\r\n", filler(16), b"\r\n"]));
  assert_eq(encode_chunk(b""), b"");
  assert_eq(last_chunk(), b"0\r\n\r\n");
  // What was written is what this module's own decoder reads back.
  assert_eq(
    decoded(
      Chunked,
      bytes_concat_all([encode_chunk(b"hello"), encode_chunk(b" world"), last_chunk()]),
    ).bytes,
    b"hello world",
  )
}

// --- Tests: the round trip --------------------------------------------------

law "a chunk-encoded body decodes back to itself"
  forall (payload: Bytes) {
    match decode_body(Chunked, bytes_concat_all([encode_chunk(payload), last_chunk()])) {
      Ok(d) -> d.bytes == payload,
      Err(_) -> bytes_len(payload) == 0,
    }
  }

// --- Tests: the serve loop --------------------------------------------------

fn echo_app<| e>(req: Request) -> Response<| e> / {Reading} =
  text_response(
    200,
    method_name(req.method) ++ " " ++ req.path ++ "|"
      ++ string_of_bytes_lossy(request_body(req, 1048576)),
  )

/// Ignores the body: decides whether an unread body gets framed as the next request.
fn ignore_body_app<| e>(req: Request) -> Response<| e> = text_response(200, req.path)

fn limits_keeping(n: Int) -> Limits = {
  let base: Limits = default_limits();
  { ..base, max_keep_alive: n }
}

fn answer_of(status: Int, body: String, keep: Bool) -> Bytes / {abort.raise} =
  encode(Get, Http11, keep, text_response(status, body))

/// Where the client of a served connection calls from.
fn caller() -> SocketAddress / {ip.refused, abort.raise} = ip::read_socket("203.0.113.9:4431")

/// The handle of the connection `served` serves: the listener is the twin's first socket.
fn served_conn() -> Int = 2

/// What a connection whose client does `script` was written back, and the network that serving
/// it left: `app` under `limits` on the one connection a listener takes.
fn served(
  script: List<Step>,
  limits: Limits,
  app: Handler<| {}>,
) -> { out: Bytes, net: MemNet } / {ip.refused, abort.raise} = {
  let ran = net::on_mem(net::mem_calling(net::mem_empty(), caller(), script), || {
    let listener = net.listen[listener](0);
    serve_connection[conn](net.accept[listener](listener), limits, app)
  });
  { out: net::mem_sent(ran.net, served_conn()), net: ran.net }
}

test "a 1.1 connection is reused and its requests are answered in order" {
  let ran = served(
    [Says(b"GET /a HTTP/1.1\r\nHost: x\r\n\r\n"), Says(b"GET /b HTTP/1.1\r\nHost: x\r\n\r\n")],
    default_limits(),
    echo_app,
  );
  assert_eq(
    ran.out,
    bytes_concat(answer_of(200, "GET /a|", true), answer_of(200, "GET /b|", true)),
  );
  assert_eq(ran.net.closed, [served_conn()])
}

// A loop bound to one label would make a program with two kinds of socket write it twice.
test "a connection is served under whichever label the caller fills" {
  let script = [Says(b"GET /a HTTP/1.1\r\nHost: x\r\n\r\n"), Stalls];
  let ran = net::on_mem(net::mem_calling(net::mem_empty(), caller(), script), || {
    let listener = net.listen[listener](0);
    serve_connection[upstream](net.accept[listener](listener), default_limits(), echo_app)
  });
  assert_eq(net::mem_sent(ran.net, served_conn()), answer_of(200, "GET /a|", true));
  assert_eq(ran.net.closed, [served_conn()])
}

test "Connection: close, HTTP/1.0 and the keep-alive bound each end the connection" {
  let second = Says(b"GET /b HTTP/1.1\r\nHost: x\r\n\r\n");
  // Nothing is read after `Connection: close`, so the second scripted request is never seen.
  let closing = served(
    [Says(b"GET /a HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n"), second],
    default_limits(),
    echo_app,
  );
  assert_eq(closing.out, answer_of(200, "GET /a|", false));
  // The second request is still unsent: it was never read.
  assert_eq(net::mem_unmet(closing.net, served_conn()), [second]);
  // The `max_keep_alive`th response says `close` and the connection ends there.
  let bounded = served(
    [Says(b"GET /a HTTP/1.1\r\nHost: x\r\n\r\n"), second],
    limits_keeping(1),
    echo_app,
  );
  assert_eq(bounded.out, answer_of(200, "GET /a|", false));
  assert_eq(net::mem_unmet(bounded.net, served_conn()), [second])
}

test "a body the handler ignores is drained before the next request is framed" {
  let ran = served(
    [
      Says(
        b"POST /a HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n\r\nhelloGET /b HTTP/1.1\r\nHost: x\r\n\r\n",
      ),
    ],
    default_limits(),
    ignore_body_app,
  );
  assert_eq(ran.out, bytes_concat(answer_of(200, "/a", true), answer_of(200, "/b", true)))
}

test "a chunked request is decoded and its trailers reach the handler separately" {
  let ran = served(
    [
      Says(b"POST /c HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n"),
      Says(b"6\r\n world\r\n0\r\nX-Checksum: 7\r\n\r\n"),
    ],
    default_limits(),
    trailer_app,
  );
  assert_eq(ran.out, answer_of(200, "hello world|7|none", true))
}

test "a request carries the address its connection came from" {
  let ran = served(
    [Says(b"GET /a HTTP/1.1\r\nHost: x\r\n\r\n"), Says(b"GET /b HTTP/1.1\r\nHost: x\r\n\r\n")],
    default_limits(),
    |req: Request|
      text_response(200, match req.peer {
        Some(from) -> ip::render_socket(from),
        None -> "nowhere",
      }),
  );
  assert_eq(
    ran.out,
    bytes_concat(
      answer_of(200, "203.0.113.9:4431", true),
      answer_of(200, "203.0.113.9:4431", true),
    ),
  )
}

fn trailer_app<| e>(req: Request) -> Response<| e> / {Reading} = {
  let body = request_body(req, 1048576);
  text_response(
    200,
    string_of_bytes_lossy(body) ++ "|"
      ++ (match header(request_trailers(req), "x-checksum") { Some(v) -> v, None -> "none" })
      ++ "|"
      ++ (match header(req.headers, "x-checksum") { Some(v) -> v, None -> "none" }),
  )
}

test "a header timeout is 408, a body timeout is 408, and an idle timeout writes nothing" {
  // Nothing arrives at all.
  let nothing = served([Silent], default_limits(), echo_app);
  assert_eq(
    nothing.out,
    encode(Get, Http11, false, text_response(408, "the request head did not arrive\n")),
  );
  // The head arrives and the body never does.
  let headless = served(
    [Says(b"POST /a HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n\r\n"), Silent],
    default_limits(),
    echo_app,
  );
  assert_eq(
    headless.out,
    encode(Post, Http11, false, text_response(408, "the request body did not arrive\n")),
  );
  // One request answered, then silence between messages.
  let idle = served(
    [Says(b"GET /a HTTP/1.1\r\nHost: x\r\n\r\n"), Stalls],
    default_limits(),
    echo_app,
  );
  assert_eq(idle.out, answer_of(200, "GET /a|", true));
  assert_eq(idle.net.closed, [served_conn()])
}

/// The milliseconds the reads of the served connection were given in all, past its first `skip`.
fn granted(net: MemNet, skip: Int) -> Int =
  fold(drop(net::mem_deadlines(net, served_conn()), skip), 0, |total: Int, ms: Int| total + ms)

test "the whole head is bounded by header_timeout_ms and not by each read" {
  // One byte per read, forever: the slow loris.
  let slow = served([Repeats(b"a")], default_limits(), echo_app);
  assert(granted(slow.net, 0) <= default_limits().header_timeout_ms);
  assert_eq(
    slow.out,
    encode(Get, Http11, false, text_response(408, "the request head did not arrive\n")),
  );
  // The same for the body, whose reads are the ones after the head's.
  let body = served(
    [Says(b"POST /a HTTP/1.1\r\nHost: x\r\nContent-Length: 1048576\r\n\r\n"), Repeats(b"a")],
    default_limits(),
    echo_app,
  );
  assert(granted(body.net, 1) <= default_limits().body_timeout_ms);
  assert_eq(
    body.out,
    encode(Post, Http11, false, text_response(408, "the request body did not arrive\n")),
  )
}

test "a head arriving in pieces is read to its terminator" {
  let ran = served(
    [Says(b"GET /a HT"), Says(b"TP/1.1\r\nHost: x\r"), Says(b"\n\r\n")],
    default_limits(),
    echo_app,
  );
  assert_eq(ran.out, answer_of(200, "GET /a|", true))
}

// After a refusal the next message's position is unknown, so there is nothing safe to resync from.
test "a framing refusal is answered once and the connection is not reused" {
  let second = Says(b"GET /b HTTP/1.1\r\nHost: x\r\n\r\n");
  let ran = served(
    [
      Says(
        b"POST /a HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\nTransfer-Encoding: chunked\r\n\r\nhello",
      ),
      second,
    ],
    default_limits(),
    echo_app,
  );
  assert_eq(
    ran.out,
    encode(
      Get,
      Http11,
      false,
      text_response(400, "a request carries `Content-Length` or `Transfer-Encoding`, never both\n"),
    ),
  );
  assert_eq(net::mem_unmet(ran.net, served_conn()), [second])
}

test "a 100-continue is written before the body is read" {
  // The client holds its body until it has heard the interim response.
  let ran = served(
    [
      Says(b"POST /a HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\nExpect: 100-continue\r\n\r\n"),
      Hears(continue_response()),
      Says(b"hello"),
    ],
    default_limits(),
    echo_app,
  );
  assert_eq(
    ran.out,
    bytes_concat(
      continue_response(),
      encode(Post, Http11, true, text_response(200, "POST /a|hello")),
    ),
  )
}

// --- Tests: streaming a response --------------------------------------------

fn counted(seed: Int) -> Option<{ value: Bytes, next: Int }> =
  if seed >= 3 { None }
  else { Some({ value: bytes_of_string(int_to_string(seed)), next: seed + 1 }) }

/// What `write` wrote to the one connection a listener takes, whose client does `script`, and
/// what it answered.
fn written(
  script: List<Step>,
  write: (Int) -> Bool / {net.send[conn], abort.raise},
) -> { out: Bytes, reusable: Bool } / {ip.refused, abort.raise} = {
  let ran = net::on_mem(net::mem_calling(net::mem_empty(), caller(), script), || {
    let listener = net.listen[listener](0);
    write(net.accept[listener](listener))
  });
  { out: net::mem_sent(ran.net, served_conn()), reusable: ran.value }
}

/// `produce`'s chunks as a response's body, of no length known before, written over a connection
/// of `version` under `limits`.
fn streamed(
  script: List<Step>,
  version: Version,
  limits: Limits,
  produce: (Int) -> Option<{ value: Bytes, next: Int }>,
) -> { out: Bytes, reusable: Bool } / {ip.refused, abort.raise} =
  written(script, |c: Int| {
    let r: Response<| {}> = {
      status: 200,
      headers: empty_headers(),
      body: chunked(seq::unfold(0, produce)),
    };
    respond[conn](c, limits, Get, version, true, r)
  })

test "a streamed response is chunk-framed and ends with the terminating chunk" {
  let ran = streamed([], Http11, default_limits(), counted);
  assert(ran.reusable);
  assert_eq(
    ran.out,
    bytes_concat_all([
      b"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n",
      b"1\r\n0\r\n",
      b"1\r\n1\r\n",
      b"1\r\n2\r\n",
      b"0\r\n\r\n",
    ]),
  );
  // What was streamed is what this module's own decoder reads back.
  assert_eq(decoded(Chunked, bytes_slice(ran.out, 47, bytes_len(ran.out))).bytes, b"012")
}

test "a streamed response stops at a dead peer rather than writing into it" {
  // A peer that has gone takes nothing, and one that stops reading is a deadline.
  assert(!streamed([Leaves], Http11, default_limits(), counted).reusable);
  assert(!streamed([Blocks], Http11, default_limits(), counted).reusable)
}

/// A producer with more chunks than `max_stream_chunks`.
fn endless(seed: Int) -> Option<{ value: Bytes, next: Int }> = Some({ value: b"x", next: seed + 1 })

test "a streamed response always ends with its terminating chunk" {
  let ran = streamed([], Http11, limits_streaming(4), endless);
  assert(!ran.reusable);
  assert(bytes_ends_with(ran.out, last_chunk()))
}

test "a streamed response to an HTTP/1.0 peer is delimited by the close" {
  let ran = streamed([], Http10, default_limits(), counted);
  assert(!ran.reusable);
  assert_eq(
    ran.out,
    bytes_concat_all([b"HTTP/1.1 200 OK\r\nConnection: close\r\n\r\n", b"0", b"1", b"2"]),
  )
}

fn limits_streaming(n: Int) -> Limits = {
  let base: Limits = default_limits();
  { ..base, max_stream_chunks: n }
}

// --- Tests: the client ------------------------------------------------------

fn client_limits() -> Limits = {
  let base: Limits = default_limits();
  { ..base, header_timeout_ms: 8, body_timeout_ms: 8 }
}

fn response_head_of(raw: Bytes, method: Method) -> ResponseHead / {abort.raise} =
  match parse_response_head(raw, method, default_limits()) {
    ResponseParsed(h) -> h,
    ResponseIncomplete -> panic("incomplete"),
    ResponseRefused(r) -> panic("refused: " ++ r.reason),
  }

fn response_status_of(raw: Bytes) -> Int / {abort.raise} =
  match parse_response_head(raw, Get, default_limits()) {
    ResponseParsed(h) -> h.status,
    ResponseIncomplete -> 0,
    ResponseRefused(r) -> r.status,
  }

test "a status line is split into version, status and reason" {
  let h = response_head_of(b"HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nhello", Get);
  assert_eq(h.version, Http11);
  assert_eq(h.status, 200);
  assert_eq(h.reason, "OK");
  assert_eq(h.framing, Length(5));
  assert_eq(h.consumed, 38);
  assert_eq(h.keep_alive, true);
  assert_eq(response_head_of(b"HTTP/1.0 404 Not Found\r\n\r\n", Get).reason, "Not Found");
  assert_eq(response_head_of(b"HTTP/1.1 204 \r\n\r\n", Get).reason, "");
  assert_eq(response_head_of(b"HTTP/1.1 204\r\n\r\n", Get).reason, "")
}

test "a malformed status line is a 502 to relay" {
  assert_eq(response_status_of(b"HTTP/2.0 200 OK\r\n\r\n"), 502);
  assert_eq(response_status_of(b"200 OK\r\n\r\n"), 502);
  assert_eq(response_status_of(b"HTTP/1.1 20 OK\r\n\r\n"), 502);
  assert_eq(response_status_of(b"HTTP/1.1 2000 OK\r\n\r\n"), 502);
  assert_eq(response_status_of(b"HTTP/1.1 abc OK\r\n\r\n"), 502);
  assert_eq(
    response_status_of(b"HTTP/1.1 200 OK\r\nContent-Length: 1\r\nContent-Length: 2\r\n\r\n"),
    502,
  );
  assert_eq(response_status_of(b"HTTP/1.1 200 OK\r\n"), 0)
}

test "a response is framed by its length, its coding, its status or the close" {
  assert_eq(
    response_head_of(b"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n", Get).framing,
    Chunked,
  );
  assert_eq(response_head_of(b"HTTP/1.1 200 OK\r\n\r\n", Get).framing, UntilClose);
  assert_eq(
    response_head_of(b"HTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\n", Get).framing,
    Length(0),
  );
  assert_eq(
    response_head_of(b"HTTP/1.1 304 Not Modified\r\nContent-Length: 5\r\n\r\n", Get).framing,
    NoBody,
  );
  assert_eq(response_head_of(b"HTTP/1.1 100 Continue\r\n\r\n", Get).framing, NoBody);
  assert_eq(
    response_head_of(b"HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\n", Head).framing,
    NoBody,
  );
  assert_eq(
    response_head_of(b"HTTP/1.1 200 OK\r\nConnection: close\r\n\r\n", Get).keep_alive,
    false,
  )
}

test "a request encodes with its host, its length and a close" {
  assert_eq(
    encode_request(request_to(Get, "example.org", "/a?b=1", b"")),
    b"GET /a?b=1 HTTP/1.1\r\nHost: example.org\r\nConnection: close\r\n\r\n",
  );
  assert_eq(
    encode_request(request_to(Post, "example.org:8080", "/items", b"{}")),
    bytes_concat(
      b"POST /items HTTP/1.1\r\nHost: example.org:8080\r\nContent-Length: 2\r\n",
      b"Connection: close\r\n\r\n{}",
    ),
  );
  assert_eq(
    encode_request(request_to(Put, "h", "/", b"")),
    b"PUT / HTTP/1.1\r\nHost: h\r\nContent-Length: 0\r\nConnection: close\r\n\r\n",
  );
  let with_header: Request = request_to(Get, "h", "", b"");
  assert_eq(
    encode_request({ ..with_header, headers: set_header(empty_headers(), "Accept", "*/*") }),
    b"GET / HTTP/1.1\r\nHost: h\r\naccept: */*\r\nConnection: close\r\n\r\n",
  )
}

test "a request target splits into its path and query" {
  let r = request_to(Get, "h", "/a/b?c=1&d=2", b"");
  assert_eq(r.path, "/a/b");
  assert_eq(r.query, "c=1&d=2");
  assert_eq(request_to(Get, "h", "/plain", b"").query, "")
}

/// A network on which `host` is one address, whose port 80 answers one connection with `script`.
fn serving(host: String, script: List<Step>) -> MemNet / {ip.refused, abort.raise} =
  net::mem_serving(
    net::mem_resolving(
      net::mem_empty(),
      dns::with_name(dns::table(), host, [ip::read("192.0.2.80")]),
    ),
    ip::read_socket("192.0.2.80:80"),
    [script],
  )

test "a request is sent, its answer read, and the connection closed" {
  let request_bytes = b"GET /a HTTP/1.1\r\nHost: example.org\r\nConnection: close\r\n\r\n";
  let script = [
    Hears(request_bytes),
    Says(b"HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nhel"),
    Says(b"lo"),
  ];
  let ran = net::on_mem(serving("example.org", script), ||
    request[conn]("example.org", 80, request_to(Get, "example.org", "/a", b""), client_limits()));
  assert_eq(net::mem_sent(ran.net, 1), request_bytes);
  match ran.value {
    Ok(r) -> {
      assert_eq((r.status, r.headers), (200, set_header(empty_headers(), "content-length", "5")));
      assert_eq(whole_bytes(r.body), b"hello")
    },
    Err(_) -> panic("no answer"),
  };
  assert_eq(ran.net.closed, [1])
}

/// What a request to `h` is answered with by a server that does `script`, or by none.
fn fetched(
  script: List<Step>,
  reached: Bool,
) -> Result<Plain, ClientError> / {ip.refused, abort.raise} =
  plainly(
    net::on_mem(if reached { serving("h", script) } else { net::mem_empty() }, ||
      request[conn]("h", 80, request_to(Get, "h", "/", b""), client_limits())).value,
  )

/// A response a client read, its body whole, as a value a test compares.
type Plain = { status: Int, headers: Headers, body: Bytes }

fn plainly(r: Result<Response<| {}>, ClientError>) -> Result<Plain, ClientError> / {abort.raise} =
  match r {
    Ok(res) -> Ok({ status: res.status, headers: res.headers, body: whole_bytes(res.body) }),
    Err(why) -> Err(why),
  }

fn body_fetched(script: List<Step>) -> Bytes / {ip.refused, abort.raise} =
  match fetched(script, true) { Ok(r) -> r.body, Err(_) -> panic("no answer") }

test "a body without a length runs until the server closes" {
  assert_eq(body_fetched([Says(b"HTTP/1.1 200 OK\r\n\r\nhel"), Says(b"lo")]), b"hello");
  assert_eq(body_fetched([Says(b"HTTP/1.1 200 OK\r\n\r\n")]), b"");
  assert_eq(
    body_fetched([
      Says(b"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n"),
      Says(b"0\r\n\r\n"),
    ]),
    b"hello",
  );
  assert_eq(body_fetched([Says(b"HTTP/1.1 204 No Content\r\n\r\n")]), b"")
}

test "each way an exchange can fail has its own error" {
  assert_eq(fetched([], false), Err(Unreachable));
  assert_eq(fetched([Says(b"HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nhel")], true), Err(Closed));
  assert_eq(fetched([Says(b"HTTP/1.1 200 OK\r\nContent-Le")], true), Err(Closed));
  assert_eq(fetched([Silent], true), Err(TimedOut));
  assert_eq(
    fetched([Says(b"HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\n"), Silent], true),
    Err(TimedOut),
  );
  assert_eq(
    fetched([Says(b"HTTP/9.9 200 OK\r\n\r\n")], true),
    Err(Malformed({ status: 502, reason: "a status line begins with `HTTP/1.1` or `HTTP/1.0`" })),
  );
  assert_eq(
    fetched([Says(b"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\nzz\r\n")], true),
    Err(
      Malformed({
        status: 502,
        reason: "a chunk size is 1 to 16 hexadecimal digits, optionally followed by `;`",
      }),
    ),
  )
}

test "a peer that stops taking bytes is reported as not sent" {
  assert_eq(fetched([Blocks], true), Err(NotSent))
}

test "a kept connection sends every request but the last without `Connection`" {
  let answer = Says(b"HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nhello");
  // HTTP/1.1 keeps a connection by default, so only the request that ends it says so.
  let script = [
    Hears(b"GET /a HTTP/1.1\r\nHost: example.org\r\n\r\n"),
    answer,
    Hears(b"GET /b HTTP/1.1\r\nHost: example.org\r\n\r\n"),
    answer,
    Hears(b"GET /c HTTP/1.1\r\nHost: example.org\r\nConnection: close\r\n\r\n"),
    answer,
  ];
  let ran = net::on_mem(serving("example.org", script), ||
    match dial[conn]("example.org", 80, client_limits()) {
      Err(_) -> (Err(Unreachable), Err(Unreachable), Err(Unreachable)),
      Ok(c) -> {
        let first = ask[conn](c, request_to(Get, "example.org", "/a", b""), client_limits());
        let second = ask[conn](c, request_to(Get, "example.org", "/b", b""), client_limits());
        let last = ask_last[conn](c, request_to(Get, "example.org", "/c", b""), client_limits());
        close[conn](c);
        (first, second, last)
      },
    });
  // One connection for all three exchanges, played to its end and closed once.
  assert_eq(map_len(ran.net.conns), 1);
  assert_eq(net::mem_unmet(ran.net, 1), []);
  assert_eq(ran.net.closed, [1]);
  let expected = Ok({
    status: 200,
    headers: set_header(empty_headers(), "content-length", "5"),
    body: b"hello",
  });
  let (first, second, last) = ran.value;
  assert_eq((plainly(first), plainly(second), plainly(last)), (expected, expected, expected))
}

fn shown_hop(hop: Hop) -> String =
  match hop {
    From(address, Some(port)) -> ip::render(address) ++ " port " ++ int_to_string(port),
    From(address, None) -> ip::render(address),
    Obscured(name) -> "obscured " ++ name,
    Unknown -> "unknown",
  }

test "`Forwarded: {c.line}` names its hops" for c: { line: String, hops: List<String> } in [
    { line: "for=192.0.2.43", hops: ["192.0.2.43"] },
    { line: "For=\"[2001:db8:cafe::17]:4711\"", hops: ["2001:db8:cafe::17 port 4711"] },
    {
      line: "for=192.0.2.43, for=198.51.100.17;by=203.0.113.60;proto=http;host=example.com",
      hops: ["192.0.2.43", "198.51.100.17"],
    },
    { line: "for=\"192.0.2.43:47011\"", hops: ["192.0.2.43 port 47011"] },
    { line: "for=192.0.2.43:47011", hops: ["unknown"] },
    { line: "for=_gazonk", hops: ["obscured _gazonk"] },
    { line: "for=\"_hidden:_port\"", hops: ["obscured _hidden"] },
    { line: "for=unknown", hops: ["unknown"] },
    { line: "for=\"un\\known\"", hops: ["unknown"] },
    { line: "proto=https", hops: ["unknown"] },
    { line: "for=192.0.2.1;for=192.0.2.2", hops: ["unknown"] },
    { line: "for=192.0.2.1,,  , for=192.0.2.2", hops: ["192.0.2.1", "192.0.2.2"] },
    { line: "for=\"192.0.2.1, 203.0.113.9\"", hops: ["unknown"] },
    { line: "for=2001:db8::1", hops: ["unknown"] },
    { line: "for=\"[2001:db8::1\"", hops: ["unknown"] },
    { line: "for=192.0.2.1:99999", hops: ["unknown"] },
    { line: "for=192.0.2.1 for=192.0.2.2", hops: ["unknown"] },
    { line: "for=\"192.0.2.1", hops: ["unknown"] },
    { line: "for", hops: ["unknown"] },
    { line: "", hops: [] },
  ] {
  assert_eq(map(forwarded_for(add_header(empty_headers(), "Forwarded", c.line)), shown_hop), c.hops)
}

test "the hops of several field lines are read in the order the lines came" {
  let headers = add_header(
    add_header(empty_headers(), "Forwarded", "for=192.0.2.1"),
    "forwarded",
    "for=192.0.2.2, for=192.0.2.3",
  );
  assert_eq(map(forwarded_for(headers), shown_hop), ["192.0.2.1", "192.0.2.2", "192.0.2.3"]);
  let old = add_header(
    empty_headers(),
    "X-Forwarded-For",
    "192.0.2.1, 2001:db8::1 ,[2001:db8::2]:80, 192.0.2.4:81, nonsense",
  );
  assert_eq(map(x_forwarded_for(old), shown_hop), [
    "192.0.2.1",
    "2001:db8::1",
    "2001:db8::2 port 80",
    "192.0.2.4 port 81",
    "unknown",
  ])
}

type Vouched = { peer: String, forwarded: String, trusted: List<String>, client: Option<String> }

test "from {c.peer} with `{c.forwarded}`, trusting {c.trusted}, the client is read past the trusted proxies only" for c: Vouched in [
    // No proxy is trusted, so the field is whatever a client wrote and is not read.
    {
      peer: "203.0.113.9:4000",
      forwarded: "for=192.0.2.1",
      trusted: [],
      client: Some("203.0.113.9"),
    },
    {
      peer: "203.0.113.9:4000",
      forwarded: "for=192.0.2.1",
      trusted: ["10.0.0.0/8"],
      client: Some("203.0.113.9"),
    },
    {
      peer: "10.0.0.5:4000",
      forwarded: "for=192.0.2.1",
      trusted: ["10.0.0.0/8"],
      client: Some("192.0.2.1"),
    },
    // The client wrote the first hop itself; the proxy appended what it saw.
    {
      peer: "10.0.0.5:4000",
      forwarded: "for=127.0.0.1, for=198.51.100.7",
      trusted: ["10.0.0.0/8"],
      client: Some("198.51.100.7"),
    },
    {
      peer: "10.0.0.5:4000",
      forwarded: "for=198.51.100.7, for=10.0.0.9",
      trusted: ["10.0.0.0/8"],
      client: Some("198.51.100.7"),
    },
    {
      peer: "10.0.0.5:4000",
      forwarded: "for=10.0.0.8, for=10.0.0.9",
      trusted: ["10.0.0.0/8"],
      client: Some("10.0.0.8"),
    },
    { peer: "10.0.0.5:4000", forwarded: "", trusted: ["10.0.0.0/8"], client: Some("10.0.0.5") },
    { peer: "10.0.0.5:4000", forwarded: "for=unknown", trusted: ["10.0.0.0/8"], client: None },
    {
      peer: "10.0.0.5:4000",
      forwarded: "for=198.51.100.7, for=_hidden",
      trusted: ["10.0.0.0/8"],
      client: None,
    },
    {
      peer: "10.0.0.5:4000",
      forwarded: "for=198.51.100.7, garbage",
      trusted: ["10.0.0.0/8"],
      client: None,
    },
    {
      peer: "[::ffff:10.0.0.5]:4000",
      forwarded: "for=\"[2001:db8::7]\"",
      trusted: ["10.0.0.0/8"],
      client: Some("2001:db8::7"),
    },
    {
      peer: "[2001:db8:1::5]:4000",
      forwarded: "for=192.0.2.1",
      trusted: ["2001:db8:1::/48"],
      client: Some("192.0.2.1"),
    },
  ] {
  let bare = request_to(Get, "example.org", "/", b"");
  let req = {
    ..bare,
    headers: add_header(empty_headers(), "Forwarded", c.forwarded),
    peer: Some(ip::read_socket(c.peer)),
  };
  let client = match client_ip(req, map(c.trusted, ip::read_prefix)) {
    Some(address) -> Some(ip::render(address)),
    None -> None,
  };
  assert_eq(client, c.client)
}

/// What each of two clients of a TLS listener is answered with, the first presenting `der`: the
/// certificate each request carried, as text, or `none`.
fn certified(der: Bytes) -> List<String> / {ip.refused, abort.raise} = {
  let world = net::mem_calling(
    net::mem_calling_presenting(net::mem_credential(net::mem_empty(), "api"), caller(), der, [
      Says(
        b"GET /a HTTP/1.1\r\nHost: x\r\n\r\nGET /b HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n",
      ),
    ]),
    caller(),
    [Says(b"GET /c HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")],
  );
  let app = |req: Request|
    text_response(200, match req.client_certificate {
      Some(c) -> string_of_bytes_lossy(c),
      None -> "none",
    });
  let ran = net::on_mem(world, || {
    let l = net.listen_tls[listener](0, "api");
    serve[listener, conn](l, 2, default_limits(), app)
  });
  [
    string_of_bytes_lossy(net::mem_sent(ran.net, served_conn())),
    string_of_bytes_lossy(net::mem_sent(ran.net, served_conn() + 1)),
  ]
}

test "a request carries the certificate its client presented at the handshake, and one without carries none" {
  let answers = certified(b"the client's leaf");
  assert_eq(
    at_or(answers, 0, ""),
    string_of_bytes_lossy(
      bytes_concat(
        answer_of(200, "the client's leaf", true),
        answer_of(200, "the client's leaf", false),
      ),
    ),
  );
  assert_eq(at_or(answers, 1, ""), string_of_bytes_lossy(answer_of(200, "none", false)));
  assert_eq(request_to(Get, "example.org", "/", b"").client_certificate, None)
}

test "a request no connection carried has no client" {
  let bare = request_to(Get, "example.org", "/", b"");
  let req = { ..bare, headers: add_header(empty_headers(), "Forwarded", "for=192.0.2.1") };
  assert_eq(client_ip(req, [ip::read_prefix("0.0.0.0/0")]), None)
}

// --- Tests: forms, dates and negotiation ------------------------------------

/// What a connection whose client says `request` is answered by `app`.
fn exchanged_with(request: Bytes, app: Handler<| {}>) -> Bytes / {ip.refused, abort.raise} = {
  let ran = net::on_mem(net::mem_calling(net::mem_empty(), caller(), [Says(request)]), || {
    let listener = net.listen[listener](0);
    serve_connection[conn](net.accept[listener](listener), default_limits(), app)
  });
  net::mem_sent(ran.net, served_conn())
}

fn upload() -> Bytes =
  b"--XyZ\r\nContent-Disposition: form-data; name=\"title\"\r\n\r\nBolts\r\n--XyZ\r\nContent-Disposition: form-data; name=\"sheet\"; filename=\"parts.csv\"\r\nContent-Type: text/csv\r\n\r\nsku,qty\n\r\n--XyZ--\r\n"

fn posted(content_type: String, body: Bytes) -> Request / {abort.raise} = {
  let bare = request_to(Post, "example.org", "/upload", body);
  { ..bare, headers: set_header(empty_headers(), "content-type", content_type) }
}

/// Answers what a form held, or the response its refusal is.
fn form_app<| e>(req: Request) -> Response<| e> / {Reading} =
  match form(req, multipart::default_limits()) {
    Ok(f) ->
      text_response(
        200,
        fold(f.fields, "", |acc: String, field: multipart::Field|
            acc ++ field.name ++ "=" ++ field.value ++ ";")
          ++ fold(f.files, "", |acc: String, file: multipart::File|
            acc ++ file.name ++ ":" ++ file.filename ++ ":" ++ string_of_bytes_lossy(file.data)),
      ),
    Err(e) -> form_refusal(e),
  }

test "a multipart form's fields and files are read from the request that carried them" {
  let body = upload();
  let out = exchanged_with(
    bytes_concat_all([
      b"POST /upload HTTP/1.1\r\nHost: x\r\nContent-Type: multipart/form-data; boundary=XyZ\r\nContent-Length: ",
      bytes_of_string(int_to_string(bytes_len(body))),
      b"\r\nConnection: close\r\n\r\n",
      body,
    ]),
    form_app,
  );
  assert_eq(
    out,
    encode(Post, Http11, false, text_response(200, "title=Bolts;sheet:parts.csv:sku,qty\n")),
  )
}

test "a body that is no form is refused for what it is" {
  assert_eq(
    read_whole(empty_headers(), ||
      form(posted("application/json", b"{}"), multipart::default_limits())),
    Ok(Err(NotAForm(Some("application/json")))),
  );
  assert_eq(
    read_whole(empty_headers(), ||
      form(request_to(Post, "example.org", "/", b""), multipart::default_limits())),
    Ok(Err(NotAForm(None))),
  );
  assert_eq(form_status(posted("multipart/form-data", upload())), 415);
  let cut = posted("multipart/form-data; boundary=XyZ", bytes_slice(upload(), 0, 40));
  match read_whole(empty_headers(), || form(cut, multipart::default_limits())) {
    Ok(Err(Unreadable(_))) -> (),
    _ -> panic("a body cut short is unreadable"),
  };
  assert_eq(form_status(cut), 400);
  let small = { ..multipart::default_limits(), max_body: 10 };
  assert_eq(
    read_whole(empty_headers(), ||
      form(posted("multipart/form-data; boundary=XyZ", upload()), small)),
    Ok(Err(Unreadable({ at: 10, why: multipart::BodyTooLarge }))),
  )
}

fn form_status(req: Request) -> Int / {abort.raise} =
  match read_whole(empty_headers(), || form_app(req).status) { Ok(s) -> s, Err(r) -> r.status }

test "a response names its date and when its resource last changed" {
  match date::of_unix_seconds(1700000000) {
    None -> panic("a date"),
    Some(at) -> {
      let r = last_modified(dated(response(200, b""), at), at);
      assert_eq(header(r.headers, "date"), Some("Tue, 14 Nov 2023 22:13:20 GMT"));
      assert_eq(header(r.headers, "last-modified"), Some("Tue, 14 Nov 2023 22:13:20 GMT"));
      assert_eq(date_field(r.headers, "last-modified", Instant(1700000000000000000)), Some(at));
      assert_eq(date_field(r.headers, "if-modified-since", Instant(0)), None)
    },
  }
}

test "the type a request accepts is chosen by weight, then by the order offered: {c.accept}" for c: { accept: String, offered: List<MediaType>, chosen: Option<MediaType> } in [
    {
      accept: "",
      offered: [mime"text/html", mime"application/json"],
      chosen: Some(mime"text/html"),
    },
    {
      accept: "application/json",
      offered: [mime"text/html", mime"application/json"],
      chosen: Some(mime"application/json"),
    },
    {
      accept: "text/html;q=0.5, application/json",
      offered: [mime"text/html", mime"application/json"],
      chosen: Some(mime"application/json"),
    },
    {
      accept: "text/*;q=0.3, text/html;q=0.9",
      offered: [mime"text/plain", mime"text/html"],
      chosen: Some(mime"text/html"),
    },
    {
      accept: "*/*;q=0.1, text/plain;q=0",
      offered: [mime"text/plain", mime"application/json"],
      chosen: Some(mime"application/json"),
    },
    { accept: "image/png", offered: [mime"application/json"], chosen: None },
    { accept: "a;;b", offered: [mime"text/plain"], chosen: Some(mime"text/plain") },
  ] {
  let headers = if string_len(c.accept) == 0 { empty_headers() }
  else { set_header(empty_headers(), "accept", c.accept) };
  assert_eq(negotiate(headers, c.offered), c.chosen)
}

fn parts_app<| e>(req: Request) -> Response<| e> / {abort.raise} =
  negotiated(req, [mime"text/html", mime"application/json"], |m: MediaType|
    if mime::subtype(m) == "json" { response(200, b"[]") } else { response(200, b"<ul></ul>") })

test "a negotiated answer says what it is and that it varies by Accept, a refused one too" {
  let json = exchanged_with(
    b"GET /parts HTTP/1.1\r\nHost: x\r\nAccept: application/json\r\nConnection: close\r\n\r\n",
    parts_app,
  );
  assert_eq(
    json,
    b"HTTP/1.1 200 OK\r\ncontent-type: application/json\r\nvary: Accept\r\nContent-Length: 2\r\nConnection: close\r\n\r\n[]",
  );
  let none = exchanged_with(
    b"GET /parts HTTP/1.1\r\nHost: x\r\nAccept: image/png\r\nConnection: close\r\n\r\n",
    parts_app,
  );
  assert(bytes_index_of(none, b"HTTP/1.1 406 Not Acceptable\r\n") == Some(0));
  assert(bytes_index_of(none, b"vary: Accept\r\n") != None)
}

test "a field a response varies by is named once" {
  let r = vary(vary(vary(response(200, b""), "Accept"), "accept"), "Origin");
  assert_eq(header_lines(r.headers, "vary"), ["Accept, Origin"]);
  let any_at_all = { ..response(200, b""), headers: set_header(empty_headers(), "vary", "*") };
  assert_eq(header_lines(vary(any_at_all, "Accept").headers, "vary"), ["*"])
}

// --- Tests: fetching a URL --------------------------------------------------

fn wall() -> Instant = Instant(1700000000000000000)

type Site = { name: String, at: String, port: Int, scripts: List<List<Step>> }

/// A network where each site's name resolves to its address, and each connection to it is answered
/// with the next of its scripts.
fn world_of(sites: List<Site>) -> MemNet / {ip.refused, abort.raise} = {
  let names = fold(sites, dns::table(), |t: dns::Table, s: Site|
    dns::with_name(t, s.name, [ip::read(s.at)]));
  fold(sites, net::mem_resolving(net::mem_empty(), names), |n: MemNet, s: Site|
    net::mem_serving(n, ip::socket_at(ip::read(s.at), s.port), s.scripts))
}

fn said(r: Response<| {}>) -> Step / {abort.raise} = Says(encode(Get, Http11, false, r))

fn redirect(status: Int, location: String) -> Response<| {}> =
  { ..response(status, b""), headers: set_header(empty_headers(), "location", location) }

fn shop(scripts: List<List<Step>>) -> Site =
  { name: "shop.example", at: "192.0.2.10", port: 80, scripts: scripts }

fn sent_text(n: MemNet, conn: Int) -> String = string_of_bytes_lossy(net::mem_sent(n, conn))

type Fetch = { method: Method, url: Url, headers: Headers, body: Bytes, options: Fetching }

fn plain(method: Method, to: Url, body: Bytes) -> Fetch =
  { method: method, url: to, headers: empty_headers(), body: body, options: fetching() }

/// `f` fetched over `world` with a jar of its own, and the network it left.
fn fetched_over(
  world: MemNet,
  f: Fetch,
) -> { value: Result<Fetched, FetchError>, net: MemNet } / {sim.read, abort.raise} = {
  let ran = net::on_mem(world, ||
    simulate {
      task::unbounded(||
        fetch[site](f.method, f.url, f.headers, f.body, cookie::jar(50), f.options, wall()))
    });
  { value: ran.value, net: ran.net }
}

fn status_of(r: Result<Fetched, FetchError>) -> Int =
  match r { Ok(f) -> f.response.status, Err(_) -> 0 }

test "a POST that is redirected is fetched again with GET, and carries what the first answer set" {
  let ran = fetched_over(
    world_of([
      shop([
        [
          said({
            ..redirect(302, "/next"),
            headers: add_header(redirect(302, "/next").headers, "set-cookie", "s=1; Path=/"),
          }),
        ],
        [said(text_response(200, "done"))],
      ]),
    ]),
    plain(Post, url"http://shop.example/start", b"x"),
  );
  match ran.value {
    Ok(f) -> {
      assert_eq((f.response.status, whole_bytes(f.response.body), f.redirects), (200, b"done", 1));
      assert_eq(url_render(f.url), "http://shop.example/next");
      assert_eq(cookie::header_for(f.jar, url"http://shop.example/", wall()), Some("s=1"))
    },
    Err(_) -> panic("the redirect is followed"),
  };
  assert(
    string_starts_with(
      sent_text(ran.net, 1),
      "POST /start HTTP/1.1\r\nHost: shop.example\r\nContent-Length: 1\r\n",
    ),
  );
  assert_eq(
    sent_text(ran.net, 2),
    "GET /next HTTP/1.1\r\nHost: shop.example\r\ncookie: s=1\r\nConnection: close\r\n\r\n",
  )
}

test "a 307 is fetched again with the method and the body it answered" {
  let ran = fetched_over(
    world_of([
      shop([
        [said(redirect(307, "http://shop.example/again"))],
        [said(text_response(201, "made"))],
      ]),
    ]),
    plain(Post, url"http://shop.example/orders", b"x"),
  );
  assert_eq(status_of(ran.value), 201);
  assert_eq(
    sent_text(ran.net, 2),
    "POST /again HTTP/1.1\r\nHost: shop.example\r\nContent-Length: 1\r\nConnection: close\r\n\r\nx",
  )
}

test "credentials go no further than the origin they were written for" {
  let asked = {
    ..plain(Get, url"http://shop.example/", b""),
    headers: set_header(
      set_header(empty_headers(), "authorization", "Bearer t"),
      "cookie",
      "own=1",
    ),
  };
  let ran = fetched_over(
    world_of([
      shop([[said(redirect(302, "/same"))], [said(redirect(301, "http://other.example/x"))]]),
      {
        name: "other.example",
        at: "192.0.2.20",
        port: 80,
        scripts: [[said(text_response(200, "there"))]],
      },
    ]),
    asked,
  );
  assert_eq(status_of(ran.value), 200);
  assert(string_contains(sent_text(ran.net, 2), "authorization: Bearer t\r\n"));
  assert(string_contains(sent_text(ran.net, 2), "cookie: own=1\r\n"));
  assert(!string_contains(sent_text(ran.net, 3), "authorization"));
  assert(!string_contains(sent_text(ran.net, 3), "cookie"))
}

test "a redirect from https to http is not followed, and nor is one past the bound" {
  let secure = {
    name: "secure.example",
    at: "192.0.2.30",
    port: 443,
    scripts: [[net::Upgrades, Says(h2_answering(redirect(301, "http://secure.example/"))), Silent]],
  };
  assert_eq(
    fetched_over(world_of([secure]), plain(Get, url"https://secure.example/", b"")).value,
    Err(Downgraded("http://secure.example/")),
  );
  let looping = world_of([
    shop([[said(redirect(302, "/a"))], [said(redirect(302, "/b"))], [said(redirect(302, "/c"))]]),
  ]);
  let bounded = {
    ..plain(Get, url"http://shop.example/", b""),
    options: { ..fetching(), max_redirects: 2 },
  };
  assert_eq(fetched_over(looping, bounded).value, Err(TooManyRedirects(2)))
}

test "an https URL is fetched over TLS to its host, over HTTP/2 where it agrees h2, and what cannot be reached says why" {
  let ran = fetched_over(
    world_of([
      {
        name: "secure.example",
        at: "192.0.2.30",
        port: 443,
        scripts: [[net::Upgrades, Says(h2_answering(text_response(200, "secret"))), Silent]],
      },
    ]),
    plain(Get, url"https://secure.example/parts", b""),
  );
  match ran.value {
    Ok(f) -> assert_eq((f.response.status, whole_bytes(f.response.body)), (200, b"secret")),
    Err(_) -> panic("the answer comes over HTTP/2"),
  };
  assert_eq(net::mem_secured(ran.net, 1), Some("secure.example"));
  assert(bytes_starts_with(net::mem_sent(ran.net, 1), http2::preface()));
  assert_eq(
    fetched_over(world_of([]), plain(Get, url"http://nowhere.example/", b"")).value,
    Err(NoConnection(net::NameNotFound)),
  );
  assert_eq(
    fetched_over(world_of([]), plain(Get, url"ftp://files.example/", b"")).value,
    Err(NotHttp("ftp://files.example/")),
  )
}

fn proxy_site(scripts: List<List<Step>>) -> Site =
  { name: "proxy.example", at: "192.0.2.99", port: 3128, scripts: scripts }

fn via_proxy(f: Fetch) -> Fetch =
  { ..f, options: { ..fetching(), proxy: Some({ host: "proxy.example", port: 3128 }) } }

test "through a proxy an http URL is asked for in absolute form" {
  let ran = fetched_over(
    world_of([proxy_site([[said(text_response(200, "proxied"))]])]),
    via_proxy(plain(Get, url"http://shop.example/parts?x=1", b"")),
  );
  assert_eq(status_of(ran.value), 200);
  assert(
    string_starts_with(
      sent_text(ran.net, 1),
      "GET http://shop.example/parts?x=1 HTTP/1.1\r\nHost: shop.example\r\n",
    ),
  )
}

test "through a proxy an https URL is tunnelled and secured to its host, or refused by the proxy" {
  let ran = fetched_over(
    world_of([
      proxy_site([
        [
          Says(b"HTTP/1.1 200 Connection established\r\n\r\n"),
          net::Upgrades,
          Says(h2_answering(text_response(200, "inside"))),
          Silent,
        ],
      ]),
    ]),
    via_proxy(plain(Get, url"https://secure.example/parts", b"")),
  );
  match ran.value {
    Ok(f) -> assert_eq(whole_bytes(f.response.body), b"inside"),
    Err(_) -> panic("the tunnel carries the request"),
  };
  // The host agreed `h2` inside the tunnel, so the request goes as HTTP/2 after the `CONNECT`.
  let connect = b"CONNECT secure.example:443 HTTP/1.1\r\nHost: secure.example:443\r\n\r\n";
  assert(bytes_starts_with(net::mem_sent(ran.net, 1), bytes_concat(connect, http2::preface())));
  assert_eq(net::mem_secured(ran.net, 1), Some("secure.example"));
  let refused = fetched_over(
    world_of([
      proxy_site([
        [Says(b"HTTP/1.1 407 Proxy Authentication Required\r\nContent-Length: 0\r\n\r\n")],
      ]),
    ]),
    via_proxy(plain(Get, url"https://secure.example/parts", b"")),
  );
  assert_eq(refused.value, Err(ProxyRefused(407)))
}

// --- Tests: shedding and draining -------------------------------------------

/// `n` clients, each saying `script` from a port of its own.
fn clients(n: Int, script: List<Step>) -> MemNet / {ip.refused, abort.raise} =
  fold(range(0, n), net::mem_empty(), |m: MemNet, i: Int|
    net::mem_calling(m, ip::socket_at(ip::read("203.0.113.9"), 4000 + i), script))

fn get_closing() -> Bytes = b"GET /a HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n"

/// Fifty milliseconds of virtual time for every request.
fn slow_app<| e>(req: Request) -> Response<| e> / {clock.write} = {
  clock.sleep(millis(50));
  text_response(200, "ok")
}

fn answers(n: MemNet, count: Int) -> List<String> =
  map(range(2, count + 2), |c: Int| string_of_bytes_lossy(net::mem_sent(n, c)))

fn one_answer(a: String) -> Bool =
  string_starts_with(a, "HTTP/1.1 200 OK\r\n")
    || string_starts_with(a, "HTTP/1.1 503 Service Unavailable\r\n")

test "past a full queue a connection is shed with 503 and Retry-After, and no more are held than the bound" {
  let ran = net::on_mem(clients(5, [Says(get_closing())]), ||
    simulate {
      let listener = net.listen[listener](0);
      serve_pooled[listener, conn](
        listener,
        10,
        default_limits(),
        { ..default_shedding(), workers: 1, queue: 1 },
        slow_app,
      )
    });
  let p = ran.value;
  assert_eq((p.served + p.shed_full, p.shed_late), (5, 0));
  // One worker busy and one connection queued is all the pool holds while it accepts.
  assert(p.served >= 1 && p.served <= 2);
  let said = answers(ran.net, 5);
  assert(all(said, one_answer));
  assert_eq(len(filter(said, |a: String| string_contains(a, "retry-after: 1\r\n"))), p.shed_full);
  assert_eq(len(ran.net.closed), 5)
}

test "a connection that waited past its bound for a worker is shed rather than served" {
  let ran = net::on_mem(clients(3, [Says(get_closing())]), ||
    simulate {
      let listener = net.listen[listener](0);
      serve_pooled[listener, conn](
        listener,
        10,
        default_limits(),
        { ..default_shedding(), workers: 1, queue: 2, max_wait_ms: 10 },
        slow_app,
      )
    });
  let p = ran.value;
  assert_eq(p.served, 1);
  assert_eq(p.shed_full + p.shed_late, 2);
  assert(p.shed_late >= 1);
  assert(all(answers(ran.net, 3), one_answer))
}

fn quick_idle() -> Limits = { ..default_limits(), idle_timeout_ms: 250 }

test "a pool that stops accepting answers every connection it accepted, and leaves none open" {
  let ran = net::on_mem(
    clients(2, [Says(b"GET /a HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")]),
    ||
      simulate {
        let listener = net.listen[listener](0);
        serve_pooled[listener, conn](
          listener,
          10,
          quick_idle(),
          { ..default_shedding(), workers: 1, queue: 1 },
          echo_app,
        )
      },
  );
  assert_eq(ran.value.served + ran.value.shed_full, 2);
  assert(
    all(answers(ran.net, 2), |a: String|
      string_starts_with(a, "HTTP/1.1 503 ")
        || (string_starts_with(a, "HTTP/1.1 200 OK\r\n")
        && string_find(a, "GET /a|") == string_len(a) - 7)),
  );
  assert_eq(len(ran.net.closed), 2)
}

test "a kept-alive connection a pool is serving as it stops is answered, then closed" {
  let ran = net::on_mem(clients(1, [Says(b"GET /a HTTP/1.1\r\nHost: x\r\n\r\n"), Silent]), ||
    simulate {
      let listener = net.listen[listener](0);
      serve_pooled[listener, conn](
        listener,
        10,
        quick_idle(),
        { ..default_shedding(), workers: 1, queue: 1 },
        echo_app,
      )
    });
  assert_eq(ran.value, { served: 1, shed_full: 0, shed_late: 0 });
  // Answered as kept alive where the stop came after it, and closing where before.
  let out = net::mem_sent(ran.net, 2);
  assert(out == answer_of(200, "GET /a|", true) || out == answer_of(200, "GET /a|", false));
  assert_eq(ran.net.closed, [2])
}

/// `script` served by `serve_draining` under a stop that has already come.
fn drained(script: List<Step>) -> MemNet / {ip.refused, sim.read, abort.raise} =
  net::on_mem(net::mem_calling(net::mem_empty(), caller(), script), ||
    simulate {
      let stop: Chan<Unit> = task.channel(0);
      task.close(stop);
      let listener = net.listen[listener](0);
      serve_draining[conn](net.accept[listener](listener), default_limits(), stop, echo_app)
    }).net

test "once stopped a connection answers what it has read, the last answer closing it, and waits for no more" {
  let one = drained([Says(b"GET /a HTTP/1.1\r\nHost: x\r\n\r\n"), Silent]);
  assert_eq(net::mem_sent(one, served_conn()), answer_of(200, "GET /a|", false));
  assert_eq(len(net::mem_deadlines(one, served_conn())), 1);
  assert_eq(one.closed, [served_conn()]);
  let two = drained([
    Says(b"GET /a HTTP/1.1\r\nHost: x\r\n\r\nGET /b HTTP/1.1\r\nHost: x\r\n\r\n"),
    Silent,
  ]);
  assert_eq(
    net::mem_sent(two, served_conn()),
    bytes_concat(answer_of(200, "GET /a|", true), answer_of(200, "GET /b|", false)),
  )
}

test "a stop that comes while a handler answers without reading its body closes the connection unread" {
  let n = net::on_mem(
    net::mem_calling(net::mem_empty(), caller(), [
      Says(b"POST /a HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n\r\n"),
      Silent,
    ]),
    ||
      simulate {
        let stop: Chan<Unit> = task.channel(0);
        let listener = net.listen[listener](0);
        let early = |req: Request| {
          task.close(stop);
          ignore_body_app(req)
        };
        serve_draining[conn](net.accept[listener](listener), default_limits(), stop, early)
      },
  ).net;
  assert_eq(net::mem_sent(n, served_conn()), answer_of(200, "/a", false));
  // The head's read alone waited: nothing waited on the body.
  assert_eq(len(net::mem_deadlines(n, served_conn())), 1);
  assert_eq(n.closed, [served_conn()])
}

test "a shed connection is told when to ask again" {
  let r = busy_response({ ..default_shedding(), retry_after_s: 7 });
  assert_eq((r.status, header(r.headers, "retry-after")), (503, Some("7")))
}

// --- Tests: HTTP/2 ----------------------------------------------------------

fn h2_field(name: String, value: String) -> http2::Field =
  { name: bytes_of_string(name), value: bytes_of_string(value) }

type Asking = { encoder: http2::Encoder, frames: List<Bytes> }

/// What a client that speaks HTTP/2 from its first byte sends to ask for each of `paths` with a
/// `GET`, on streams 1, 3 and on, its table kept across them. It acknowledges the server's
/// `SETTINGS` before it has them, as no scripted client can wait for them.
fn h2_asking(paths: List<String>) -> Bytes / {abort.raise} = {
  let opening = bytes_concat_all([
    http2::preface(),
    http2::encode_frame(http2::SettingsFrame({ ack: false, settings: [] })),
    http2::encode_frame(http2::SettingsFrame({ ack: true, settings: [] })),
  ]);
  let asked = fold(
    range(0, len(paths)),
    { encoder: http2::encoder(4096), frames: [opening] },
    |w: Asking, i: Int| {
      let e = http2::encode(w.encoder, [
        h2_field(":method", "GET"),
        h2_field(":scheme", "http"),
        h2_field(":authority", "x"),
        h2_field(":path", match list_at(paths, i) { Some(p) -> p, None -> "/" }),
      ]);
      {
        encoder: e.encoder,
        frames: push(
          w.frames,
          http2::encode_frame(
            http2::HeadersFrame({
              stream: 2 * i + 1,
              block: e.block,
              end_stream: true,
              end_headers: true,
              priority: None,
              padding: None,
            }),
          ),
        ),
      }
    },
  );
  bytes_concat_all(asked.frames)
}

type FrameScan = { at: Int, shown: List<String> }

/// The frames in what an HTTP/2 end wrote, each as a line: its type and stream, a `DATA` frame's
/// payload, and a `GOAWAY`'s last stream and code.
fn h2_frames(b: Bytes) -> List<String> / {abort.raise} =
  iterate({ at: 0, shown: [] }, bytes_len(b) + 1, |s: FrameScan|
    match try { http2::read_frame(b, s.at, http2::largest_frame_size()) } {
      Ok(Some(r)) -> Continue({ at: r.next, shown: push(s.shown, h2_shown(r.frame)) }),
      _ -> Stop(s.shown),
    })

fn h2_shown(f: http2::Frame) -> String / {abort.raise} =
  match f {
    http2::SettingsFrame(s) -> if s.ack { "SETTINGS ACK" } else { "SETTINGS" },
    http2::WindowUpdateFrame(_) -> "WINDOW_UPDATE",
    http2::HeadersFrame(h) -> "HEADERS " ++ int_to_string(h.stream),
    http2::DataFrame(d) ->
      "DATA " ++ int_to_string(d.stream) ++ " " ++ string_of_bytes_lossy(d.data)
        ++ (if d.end_stream { " END_STREAM" } else { "" }),
    http2::GoAwayFrame(g) ->
      "GOAWAY " ++ int_to_string(g.last_stream) ++ " " ++ http2::code_name(g.code),
    http2::PingFrame(p) -> if p.ack { "PING ACK" } else { "PING" },
    http2::ResetFrame(r) -> "RST_STREAM " ++ int_to_string(r.stream),
    _ -> "OTHER",
  }

/// What the server says first, before any answer: its `SETTINGS`, the window it adds to the
/// connection's, and the acknowledgement of the client's `SETTINGS`.
fn h2_greeting() -> List<String> = ["SETTINGS", "WINDOW_UPDATE", "SETTINGS ACK"]

test "a connection that opens with the HTTP/2 preface is served HTTP/2, and drained with GOAWAY at the stop" {
  let n = drained([Says(h2_asking(["/a?x=1"])), Silent]);
  assert_eq(
    h2_frames(net::mem_sent(n, served_conn())),
    concat(h2_greeting(), [
      "HEADERS 1",
      "DATA 1 GET /a| END_STREAM",
      "GOAWAY 2147483647 NO_ERROR",
      "PING",
      "GOAWAY 1 NO_ERROR",
    ]),
  );
  assert_eq(n.closed, [served_conn()])
}

/// The one connection a pool serves for a client that does `script`, and what it wrote.
fn pooled_one(
  script: List<Step>,
  app: Handler<| {task.select}>,
) -> Bytes / {ip.refused, sim.read, abort.raise} =
  net::mem_sent(
    net::on_mem(net::mem_calling(net::mem_empty(), caller(), script), ||
      simulate {
        let listener = net.listen[listener](0);
        serve_pooled[listener, conn](
          listener,
          1,
          quick_idle(),
          { ..default_shedding(), workers: 1, queue: 1 },
          app,
        )
      }).net,
    served_conn(),
  )

test "a pool answers an HTTP/2 connection's streams as they arrive, as Http2 requests from its peer" {
  let wrote = pooled_one([Says(h2_asking(["/a", "/b?q=2"])), Silent], |req: Request|
    text_response(
      200,
      method_name(req.method) ++ " " ++ req.path ++ "?" ++ req.query ++ " "
        ++ (if req.version == Http2 { "h2" } else { "h1" })
        ++ " "
        ++ (match req.peer { Some(from) -> ip::render_socket(from), None -> "nowhere" }),
    ));
  let frames = h2_frames(wrote);
  assert_eq(
    take(frames, 7),
    concat(h2_greeting(), [
      "HEADERS 1",
      "DATA 1 GET /a? h2 203.0.113.9:4431 END_STREAM",
      "HEADERS 3",
      "DATA 3 GET /b?q=2 h2 203.0.113.9:4431 END_STREAM",
    ]),
  );
  // Idle or stopped, the connection ends with the GOAWAY naming the last stream it took.
  assert_eq(last(frames), Some("GOAWAY 3 NO_ERROR"))
}

/// `pieces` as a streamed answer of no length known before.
fn pieces_answer<| e>(pieces: List<Bytes>) -> Response<| e> =
  { status: 200, headers: empty_headers(), body: chunked(seq::of_list(pieces)) }

test "a streamed answer over HTTP/2 goes as DATA frames as it is pulled" {
  let wrote = pooled_one([Says(h2_asking(["/a"])), Silent], |req: Request|
    pieces_answer([b"one ", b"two ", b"three"]));
  assert_eq(
    take(h2_frames(wrote), 8),
    concat(h2_greeting(), [
      "HEADERS 1",
      "DATA 1 one ",
      "DATA 1 two ",
      "DATA 1 three",
      "DATA 1  END_STREAM",
    ]),
  )
}

test "a streamed answer over HTTP/2 that says its length and gives fewer bytes is reset" {
  let short = |req: Request| {
    let held: Stream<| {Reading, task.select}> = {
      length: Some(10),
      chunks: seq::of_list([b"four"]),
      close: || (),
    };
    { status: 200, headers: empty_headers(), body: Streamed(held) }
  };
  let frames = h2_frames(pooled_one([Says(h2_asking(["/a"])), Silent], short));
  assert_eq(take(drop(frames, 3), 3), ["HEADERS 1", "DATA 1 four", "RST_STREAM 1"])
}

/// What a handler saw of a body it pulled a piece at a time: how many pieces, and the bytes.
fn pieces_app<| e>(req: Request) -> Response<| e> / {Reading} =
  match req.body {
    Whole(b) -> text_response(200, "whole " ++ string_of_bytes_lossy(b)),
    Streamed(s) -> {
      let seen = iterate(
        { rest: s.chunks, pieces: 0, bytes: b"" },
        64,
        |at: { rest: Seq<Bytes | {Reading}>, pieces: Int, bytes: Bytes }|
          match (at.rest)() {
            Done -> Stop(at),
            Skip(more) -> Continue({ ..at, rest: more }),
            Yield(piece, more) ->
              Continue({ rest: more, pieces: at.pieces + 1, bytes: bytes_concat(at.bytes, piece) }),
          },
      );
      text_response(200, int_to_string(seen.pieces) ++ " " ++ string_of_bytes_lossy(seen.bytes))
    },
  }

test "a request's body is read from its connection a piece at a time, as the handler pulls it" {
  let ran = served(
    [
      Says(b"POST /a HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n"),
      Says(b"6\r\n world\r\n"),
      Says(b"0\r\n\r\nGET /b HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n"),
    ],
    default_limits(),
    pieces_app,
  );
  assert_eq(
    ran.out,
    bytes_concat(answer_of(200, "2 hello world", true), answer_of(200, "whole ", false)),
  )
}

test "a body past max_body is refused at the piece that passes it, and what follows is not read" {
  let rest = Says(b"5\r\nworld\r\n0\r\n\r\n");
  let ran = served(
    [
      Says(b"POST /a HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n"),
      Says(b"5\r\nthere\r\n"),
      rest,
    ],
    limits_with(8192, 65536, 100, 8, 1048576, 4096, 8192),
    echo_app,
  );
  assert_eq(
    ran.out,
    encode(Post, Http11, false, text_response(413, "the body is longer than 8 bytes\n")),
  );
  assert_eq(net::mem_unmet(ran.net, served_conn()), [rest])
}

test "a client waiting to send its body is not told to where its handler answers without it" {
  let body = Says(b"hello");
  let ran = served(
    [
      Says(b"POST /a HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\nExpect: 100-continue\r\n\r\n"),
      body,
    ],
    default_limits(),
    ignore_body_app,
  );
  assert_eq(ran.out, answer_of(200, "/a", false));
  assert_eq(net::mem_unmet(ran.net, served_conn()), [body])
}

test "a stream that names its length is sent under Content-Length, and one that falls short ends the connection" {
  let sized = |n: Int| {
    let held: Stream<| {}> = {
      length: Some(n),
      chunks: seq::of_list([b"abc", b"de"]),
      close: || (),
    };
    { status: 200, headers: empty_headers(), body: Streamed(held) }
  };
  let whole = written([], |c: Int| respond[conn](c, default_limits(), Get, Http11, true, sized(5)));
  assert(whole.reusable);
  assert_eq(whole.out, b"HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nabcde");
  let short = written([], |c: Int| respond[conn](c, default_limits(), Get, Http11, true, sized(9)));
  assert(!short.reusable);
  let head = written([], |c: Int| respond[conn](c, default_limits(), Head, Http11, true, sized(9)));
  assert_eq(head, { out: b"HTTP/1.1 200 OK\r\nContent-Length: 9\r\n\r\n", reusable: true })
}

test "an HTTP/2 request whose body never comes is answered 408 at its deadline, and the connection closes" {
  let opening = h2_asking([]);
  let open_head = http2::encode(http2::encoder(4096), [
    h2_field(":method", "POST"),
    h2_field(":scheme", "http"),
    h2_field(":path", "/slow"),
  ]);
  let script = [
    Says(
      bytes_concat(
        opening,
        http2::encode_frame(
          http2::HeadersFrame({
            stream: 1,
            block: open_head.block,
            end_stream: false,
            end_headers: true,
            priority: None,
            padding: None,
          }),
        ),
      ),
    ),
    Silent,
  ];
  // A stop that never comes: the deadlines alone end the connection.
  let ran = net::on_mem(net::mem_calling(net::mem_empty(), caller(), script), ||
    simulate {
      let stop: Chan<Unit> = task.channel(0);
      let listener = net.listen[listener](0);
      serve_draining[conn](net.accept[listener](listener), quick_idle(), stop, echo_app)
    });
  assert_eq(
    h2_frames(net::mem_sent(ran.net, served_conn())),
    concat(h2_greeting(), [
      "HEADERS 1",
      "DATA 1 the request did not arrive whole within 35000 ms\n END_STREAM",
      "RST_STREAM 1",
      "GOAWAY 1 NO_ERROR",
    ]),
  );
  assert_eq(ran.net.closed, [served_conn()])
}

test "an HTTP/2 connection is bounded by this module's limits" {
  let l = http2_limits({ ..default_limits(), max_body: 10, max_keep_alive: 3, idle_timeout_ms: 7 });
  assert_eq((l.max_body, l.max_requests, l.idle_timeout_ms), (10, 3, 7));
  assert_eq(
    l.request_timeout_ms,
    default_limits().header_timeout_ms + default_limits().body_timeout_ms,
  )
}

test "a pool serves an HTTP/1.1 connection as it did, whatever HTTP/2 it speaks" {
  assert_eq(pooled_one([Says(get_closing())], echo_app), answer_of(200, "GET /a|", false))
}

test "serve_connection speaks HTTP/1.1 alone, and refuses the HTTP/2 preface as another version" {
  let ran = served([Says(h2_asking(["/a"]))], default_limits(), echo_app);
  assert(string_starts_with(string_of_bytes_lossy(ran.out), "HTTP/1.1 505 "))
}

test "an HTTP/2 request reads as this module's, its target split at the query" {
  let wire = {
    method: "OPTIONS",
    scheme: "https",
    authority: "shop.example",
    target: "*",
    headers: set_header(empty_headers(), "accept", "*/*"),
    trailers: empty_headers(),
    body: b"",
  };
  let star = stream_request(wire, { peer: None, certificate: None, looked: true });
  assert_eq((star.method, star.path, star.query, star.authority, star.version), (
    Options,
    "*",
    "",
    "shop.example",
    Http2,
  ));
  let pathed = stream_request({ ..wire, method: "PURGE", target: "/p/q?r=1&s" }, {
    peer: None,
    certificate: None,
    looked: true,
  });
  assert_eq((pathed.method, pathed.target, pathed.path, pathed.query), (
    Other("PURGE"),
    "/p/q?r=1&s",
    "/p/q",
    "r=1&s",
  ));
  assert_eq(wire_request(pathed, "https").target, "/p/q?r=1&s")
}

/// A server that speaks HTTP/2 from its first byte and answers stream 1 with `r`, whatever it is
/// asked: its `SETTINGS`, the answer's head and its body.
fn h2_answering(r: Response<| {}>) -> Bytes / {abort.raise} = {
  let head = http2::encode(
    http2::encoder(4096),
    fold(
      map_entries(r.headers),
      [h2_field(":status", int_to_string(r.status))],
      |fs: List<http2::Field>, e: { key: String, value: List<String> }|
        fold(e.value, fs, |more: List<http2::Field>, v: String| push(more, h2_field(e.key, v))),
    ),
  );
  bytes_concat_all([
    http2::encode_frame(http2::SettingsFrame({ ack: false, settings: [] })),
    http2::encode_frame(
      http2::HeadersFrame({
        stream: 1,
        block: head.block,
        end_stream: false,
        end_headers: true,
        priority: None,
        padding: None,
      }),
    ),
    http2::encode_frame(
      http2::DataFrame({ stream: 1, data: whole_bytes(r.body), end_stream: true, padding: None }),
    ),
  ])
}

test "fetch with prior knowledge asks an http URL over HTTP/2 from the first byte" {
  let ran = fetched_over(
    world_of([shop([[Says(h2_answering(text_response(200, "over h2"))), Silent]])]),
    {
      ..plain(Get, url"http://shop.example/parts?x=1", b""),
      options: { ..fetching(), prior_knowledge: true },
    },
  );
  match ran.value {
    Ok(f) -> {
      assert_eq((f.response.status, whole_bytes(f.response.body)), (200, b"over h2"));
      assert_eq(header(f.response.headers, "content-type"), Some("text/plain; charset=utf-8"))
    },
    Err(_) -> panic("the answer comes over HTTP/2"),
  };
  let sent = net::mem_sent(ran.net, 1);
  assert(bytes_starts_with(sent, http2::preface()));
  assert_eq(
    filter(
      h2_frames(bytes_slice(sent, bytes_len(http2::preface()), bytes_len(sent))),
      |f: String| f != "WINDOW_UPDATE",
    ),
    ["SETTINGS", "HEADERS 1", "SETTINGS ACK", "GOAWAY 0 NO_ERROR"],
  )
}

test "fetch with prior knowledge reports a server that closes before it answers" {
  let ran = fetched_over(
    world_of([
      shop([
        [Says(http2::encode_frame(http2::SettingsFrame({ ack: false, settings: [] }))), Leaves],
      ]),
    ]),
    {
      ..plain(Get, url"http://shop.example/", b""),
      options: { ..fetching(), prior_knowledge: true },
    },
  );
  assert_eq(ran.value, Err(NoAnswer(Closed)))
}

test "a TLS pool secures each connection offering h2, and serves one that agrees it over HTTP/2" {
  let callers = net::mem_calling(net::mem_empty(), caller(), [
    net::Upgrades,
    Says(h2_asking(["/a"])),
    Silent,
  ]);
  let ran = net::on_mem(net::mem_credential(callers, "api"), ||
    simulate {
      let listener = net.listen[listener](0);
      serve_pooled_tls[listener, conn](
        listener,
        1,
        quick_idle(),
        { ..default_shedding(), workers: 1, queue: 1 },
        "api",
        |req: Request|
          text_response(200, (if req.version == Http2 { "h2 " } else { "h1 " }) ++ req.path),
      )
    });
  assert_eq(ran.value, { served: 1, shed_full: 0, shed_late: 0 });
  assert_eq(net::mem_secured(ran.net, served_conn()), Some("api"));
  // The server speaks first over TLS, so its `SETTINGS` may go before the stop and its drain.
  let frames = h2_frames(net::mem_sent(ran.net, served_conn()));
  assert_eq(take(frames, 1), ["SETTINGS"]);
  assert(contains(frames, "DATA 1 h2 /a END_STREAM"));
  assert_eq(last(frames), Some("GOAWAY 1 NO_ERROR"));
  assert_eq(ran.net.closed, [served_conn()])
}

test "a connection shed over TLS is secured offering http/1.1 alone, then told when to ask again" {
  let ran = net::on_mem(
    net::mem_credential(
      net::mem_calling(net::mem_empty(), caller(), [net::Upgrades, Silent]),
      "api",
    ),
    || {
      let listener = net.listen[listener](0);
      busy_secured[conn](
        net.accept[listener](listener),
        default_limits(),
        default_shedding(),
        "api",
      )
    },
  );
  let said = string_of_bytes_lossy(net::mem_sent(ran.net, served_conn()));
  assert(string_starts_with(said, "HTTP/1.1 503 "));
  assert(string_contains(said, "retry-after: 1\r\n"));
  assert_eq(net::mem_secured(ran.net, served_conn()), Some("api"));
  assert_eq(ran.net.closed, [served_conn()])
}
