/// `service.name`: the resource attribute every exporter is given.
pub fn service_name() -> String = "service.name"

/// `service.version`.
pub fn service_version() -> String = "service.version"

/// `service.namespace`.
pub fn service_namespace() -> String = "service.namespace"

/// `service.instance.id`.
pub fn service_instance_id() -> String = "service.instance.id"

/// `deployment.environment.name`.
pub fn deployment_environment_name() -> String = "deployment.environment.name"

/// `host.name`.
pub fn host_name() -> String = "host.name"

/// `telemetry.sdk.name`.
pub fn telemetry_sdk_name() -> String = "telemetry.sdk.name"

/// `telemetry.sdk.language`.
pub fn telemetry_sdk_language() -> String = "telemetry.sdk.language"

/// `http.request.method`.
pub fn http_request_method() -> String = "http.request.method"

/// `http.response.status_code`.
pub fn http_response_status_code() -> String = "http.response.status_code"

/// `http.route`: the route's pattern, which a router knows and this module does not.
pub fn http_route() -> String = "http.route"

/// `url.path`.
pub fn url_path() -> String = "url.path"

/// `url.query`.
pub fn url_query() -> String = "url.query"

/// `url.scheme`.
pub fn url_scheme() -> String = "url.scheme"

/// `url.full`.
pub fn url_full() -> String = "url.full"

/// `server.address`.
pub fn server_address() -> String = "server.address"

/// `server.port`.
pub fn server_port() -> String = "server.port"

/// `client.address`.
pub fn client_address() -> String = "client.address"

/// `network.protocol.version`.
pub fn network_protocol_version() -> String = "network.protocol.version"

/// `user_agent.original`.
pub fn user_agent_original() -> String = "user_agent.original"

/// `error.type`.
pub fn error_type() -> String = "error.type"

// --- Tests ------------------------------------------------------------------

type Ran<a> = { value: a, records: List<trace::Record> }

/// `body` with every `trace` operation it performs collected, and `entropy` drawn from a seed.
fn collecting<a | e>(
  seed: Int,
  body: () -> a / {trace.enter[*], trace.exit[*], trace.event[*], entropy.next, entropy.below | e},
) -> Ran<a> / {abort.raise | e} =
  with_cell[sink](trace::sink()) { s -> {
    let value = with_rand(rand(seed), ||
      handle {
        body()
      } with {
        trace.enter[*c](name, fields) -> {
          let out = trace::enter_step(cell_get(s), c, name, fields);
          cell_set(s, out.sink);
          out.span
        },
        trace.exit[*c](span, outcome) ->
          cell_set(s, trace::exit_step(cell_get(s), span, outcome).sink),
        trace.event[*c](level, name, fields) ->
          cell_set(s, trace::event_step(cell_get(s), c, level, name, fields)),
      }).value;
    { value: value, records: trace::drain(cell_get(s)) }
  } }

fn entered(records: List<trace::Record>) -> List<trace::Record> =
  filter(records, |r: trace::Record| r.kind == trace::KEnter)

fn id_of(r: trace::Record) -> Identity / {abort.raise} =
  match identity(r.fields) { Some(id) -> id, None -> panic("a span with no identity") }

fn trace_hex(context: Context) -> String = traceparent::trace_id_hex(context.parent.trace_id)

fn span_hex(context: Context) -> String = traceparent::span_id_hex(context.parent.parent_id)

fn get(target: String) -> Request / {abort.raise} =
  http::request_to(http::Get, "shop.example:8443", target, b"")

fn remote_parent() -> String = "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01"

test "a span inside a span is its child, in its trace, with its decision" {
  let ran = collecting(1, ||
    traced(AlwaysOn, ||
      in_span[work]("outer", Internal, #{"n": FInt(1)}, ||
        in_span[work]("inner", Client, map_new(), || tracing.current()))));
  match entered(ran.records) {
    [outer, inner] -> {
      let up = id_of(outer);
      let down = id_of(inner);
      assert_eq(up.parent, None);
      assert_eq(down.parent, Some(up.context.parent.parent_id));
      assert_eq(trace_hex(down.context), trace_hex(up.context));
      assert(traceparent::sampled(up.context.parent));
      assert(traceparent::random(up.context.parent));
      assert_eq(down.context.parent.flags, up.context.parent.flags);
      assert_eq(down.kind, Client);
      assert_eq(up.kind, Internal);
      // The body sees the innermost span, and its own fields are left as written.
      assert_eq(ran.value, Some(down.context));
      assert_eq(attributes(outer.fields), #{"n": FInt(1)})
    },
    _ -> panic("expected two spans"),
  }
}

test "a trace that is not recorded stays unrecorded below its first span" {
  let ran = collecting(2, ||
    traced(AlwaysOff, ||
      in_span[work]("outer", Internal, map_new(), ||
        in_span[work]("inner", Internal, map_new(), || ()))));
  assert_eq(
    map(entered(ran.records), |r: trace::Record| traceparent::sampled(id_of(r).context.parent)),
    [false, false],
  )
}

test "a span closes Ok where its body answers and Failed where it does not" {
  let ran = collecting(3, ||
    traced(AlwaysOn, ||
      try[abort.raise] {
        in_span[work]("fine", Internal, map_new(), || 1)
          + in_span[work]("broken", Internal, map_new(), || panic("no"))
      }));
  assert_eq(ran.value, Err("no"));
  assert_eq(
    map(filter(ran.records, |r: trace::Record| r.kind == trace::KExit), |r: trace::Record|
      r.outcome),
    [trace::Ok, trace::Failed(unwound())],
  )
}

/// The trace id a `traceparent` of these 32 digits names.
fn id(hex: String) -> TraceId / {abort.raise} =
  match traceparent::parse("00-" ++ hex ++ "-00f067aa0ba902b7-01") {
    Ok(parent) -> parent.trace_id,
    Err(_) -> panic("a trace id"),
  }

test "a ratio decides from the last seven bytes of the trace id" {
  let low = id("4bf92f3577b34da6a300000000000001");
  let middle = id("4bf92f3577b34da6a380000000000000");
  let high = id("4bf92f3577b34da6a3ffffffffffffff");
  assert(!records(Ratio(1, 2), low));
  assert(records(Ratio(1, 2), middle));
  assert(records(Ratio(1, 2), high));
  assert(!records(Ratio(1, 100), middle));
  assert(records(Ratio(1, 100), high));
  assert(records(Ratio(1, 1), low));
  assert(records(Ratio(3, 2), low));
  assert(!records(Ratio(0, 5), high));
  assert(!records(Ratio(1, 0), high));
  assert(records(AlwaysOn, low));
  assert(!records(AlwaysOff, high))
}

law "a higher ratio records every trace a lower one does"
  forall (t: TraceId, a: Int, b: Int, c: Int) {
    let parts = 1 + (c & 0xFFFF);
    let low = a & 0xFFFF;
    match try[abort.raise] {
        !records(Ratio(low, parts), t) || records(Ratio(low + (b & 0xFFFF), parts), t)
      } {
      Ok(holds) -> holds,
      Err(_) -> false,
    }
  }

law "a span's identity reads back from its fields"
  forall (parent: Traceparent, above: Option<SpanId>, state: traceparent::Tracestate) {
    let context: Context = { parent: parent, state: state };
    let written = identified(#{"sku": FText("BOLT-1")}, context, above, Server);
    (try[abort.raise] { identity(written) })
      == Ok(Some({ context: context, parent: above, kind: Server }))
      && attributes(written) == #{"sku": FText("BOLT-1")}
  }

test "a served request continues the trace it arrived with, and says what it was" {
  let req = get("/orders/7?full=1");
  let arriving = {
    ..req,
    headers: http::set_header(
      http::set_header(req.headers, "traceparent", remote_parent()),
      "tracestate",
      "rojo=1",
    ),
  };
  let ran = collecting(4, ||
    traced(AlwaysOff, ||
      served[web](arriving, |r: Request| {
        let here = tracing.current();
        http::text_response(503, match here { Some(c) -> trace_hex(c), None -> "" })
      })));
  assert_eq(ran.value.status, 503);
  assert_eq(string_of_bytes(ran.value.body), "4bf92f3577b34da6a3ce929d0e0e4736");
  match entered(ran.records) {
    [span] -> {
      let who = id_of(span);
      assert_eq(span.name, "GET");
      assert_eq(span.channel, "web");
      assert_eq(who.kind, Server);
      assert_eq(who.parent, traceparent::span_id_of_hex("00f067aa0ba902b7"));
      // The caller recorded its span, so this one is recorded whatever the sampler here says.
      assert(traceparent::sampled(who.context.parent));
      assert_eq(traceparent::render_state(who.context.state), "rojo=1");
      assert_eq(
        attributes(span.fields),
        #{
          "http.request.method": FText("GET"),
          "url.path": FText("/orders/7"),
          "url.query": FText("full=1"),
          "server.address": FText("shop.example"),
          "server.port": FInt(8443),
          "network.protocol.version": FText("1.1"),
        },
      )
    },
    _ -> panic("expected one span"),
  };
  assert_eq(
    map(filter(ran.records, |r: trace::Record| r.kind == trace::KExit), |r: trace::Record|
      r.outcome),
    [trace::Failed("503")],
  )
}

type Noted = { span: String, fields: Fields }

/// `body` under a root that keeps what is annotated, as an exporter does.
fn annotated<a | e>(body: () -> a / {Tracing | e}) -> { value: a, notes: List<Noted> } / e =
  with_cell[notes]([]) { notes -> {
    let value = handle {
      body()
    } with {
      tracing.current() -> None,
      tracing.sampler() -> AlwaysOn,
      tracing.annotate(span, fields) -> {
        let note: Noted = { span: traceparent::span_id_hex(span), fields: fields };
        cell_set(notes, push(cell_get(notes), note))
      },
    };
    { value: value, notes: cell_get(notes) }
  } }

test "an asked request names its client span to the server, and the answer's status to the span" {
  let ran = collecting(5, ||
    annotated(||
      in_span[work]("checkout", Internal, map_new(), ||
        asked[upstream](get("/stock"), |sent: Request| {
          let answer: Result<Response, ClientError> = Ok(
            http::text_response(404, match http::header(sent.headers, "traceparent") {
              Some(parent) -> parent,
              None -> "",
            }),
          );
          answer
        }))));
  match ((entered(ran.records), ran.value.value)) {
    ([outer, client], Ok(res)) -> {
      let who = id_of(client);
      assert_eq(who.kind, Client);
      assert_eq(who.parent, Some(id_of(outer).context.parent.parent_id));
      assert_eq(string_of_bytes(res.body), traceparent::render(who.context.parent));
      assert_eq(ran.value.notes, [
        {
          span: span_hex(who.context),
          fields: #{"http.response.status_code": FInt(404), "error.type": FText("404")},
        },
      ])
    },
    _ -> panic("expected two spans and an answer"),
  }
}

/// What a request's handler saw of the span around it.
effect witness {
  write saw(request: String, trace: String) -> Unit
}

fn look(who: String) -> Unit / {tracing.current, witness.saw} =
  witness.saw(who, match tracing.current() { Some(c) -> trace_hex(c), None -> "none" })

/// A handler that looks at the span around it, gives way to every other task, calls on, gives
/// way again and looks once more.
fn relayed(
  who: String,
  req: Request,
) -> Response / {Tracing, witness.saw, trace.enter[upstream], trace.exit[upstream], entropy.next, task.yield, abort.raise} = {
  look(who);
  task.yield();
  let answer = asked[upstream](get("/next"), |out: Request| {
    task.yield();
    witness.saw(who, match extract(out) { Some(c) -> trace_hex(c), None -> "none" });
    let ok: Result<Response, ClientError> = Ok(http::response(204, b""));
    ok
  });
  task.yield();
  look(who);
  http::response(match answer { Ok(res) -> res.status, Err(_) -> 502 }, b"")
}

fn arriving(parent: String) -> Request / {abort.raise} = {
  let req = get("/orders");
  { ..req, headers: http::set_header(req.headers, "traceparent", parent) }
}

type Sight = { request: String, trace: String }

test "two requests served at once each see their own span, whatever order they run in" {
  let first = "00-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa-00f067aa0ba902b7-01";
  let second = "00-bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb-00f067aa0ba902b7-00";
  let sights = with_cell[sights]([]) { log -> {
    handle {
      traced(AlwaysOn, ||
        simulate {
          let a = task.spawn(|| served[web](arriving(first), |r: Request| relayed("a", r)));
          let b = task.spawn(|| served[web](arriving(second), |r: Request| relayed("b", r)));
          assert_eq(task.join(a).status, 204);
          assert_eq(task.join(b).status, 204)
        })
    } with {
      witness.saw(request, trace) -> {
        let sight: Sight = { request: request, trace: trace };
        cell_set(log, push(cell_get(log), sight))
      },
      trace.enter[*c](name, fields) -> { id: 1, channel: c },
      trace.exit[*c](span, outcome) -> (),
      entropy.next() -> 11,
    };
    cell_get(log)
  } };
  let seen_by = |who: String| map(filter(sights, |s: Sight| s.request == who), |s: Sight| s.trace);
  assert_eq(seen_by("a"), [
    "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  ]);
  assert_eq(seen_by("b"), [
    "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
    "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
    "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
  ])
}

test "a task spawned inside a span runs in that span, and one spawned outside it in none" {
  let seen = handle {
    traced(AlwaysOn, ||
      simulate {
        let outside = task.spawn(|| tracing.current());
        let inside = in_span[work]("outer", Internal, map_new(), || {
          let here = tracing.current();
          let t = task.spawn(|| {
            task.yield();
            tracing.current()
          });
          { here: here, there: task.join(t) }
        });
        { inside: inside, outside: task.join(outside) }
      })
  } with {
    trace.enter[*c](name, fields) -> { id: 1, channel: c },
    trace.exit[*c](span, outcome) -> (),
    entropy.next() -> 11,
  };
  assert(seen.inside.here != None);
  assert_eq(seen.inside.there, seen.inside.here);
  assert_eq(seen.outside, None)
}
