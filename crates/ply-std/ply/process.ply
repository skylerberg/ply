//! The process a program runs in, and the programs it runs, as an effect.
//!
//! The operations on the program's own process take its label, `[proc]` by convention; they are bound
//! only by `ply run --host`, and `ply test` withholds them even with `--host` (`E0424`). Under
//! `ply run --json` what the program writes to standard output goes to stderr, lines and bytes
//! alike and each at once, so stdout still carries the one object.
//!
//! Standard output is buffered and standard error is not. `out_bytes` adds to the buffer, which
//! is written when it holds 64 KiB, when `flush` asks, when `out` writes a line, before anything
//! is written to standard error, before standard input is read, before a child that inherits a
//! stream is started, and when the program ends, however it ends: by returning, by a raise or by
//! `exit`. So the two streams carry what was written in the order it was written, a prompt is
//! seen before its answer is waited for, and nothing written is lost; what `flush` adds is the
//! moment, for a partial line that should be seen while the program computes or sleeps.
//!
//! Standard input has one buffer, which `line` and `in_bytes` both read: a read of bytes after a
//! line starts where that line ended, and a line after a read of bytes where those bytes did.
//!
//! A stream whose reader has gone away, as when the program writes into `head`, takes nothing
//! more. `out_bytes`, `err_bytes` and `flush` answer `false` then; `write_out`, `write_err` and
//! `flush_out` raise `pipe.broken` in its place, which a program answers as any raise. Unanswered,
//! and for a line written with `out` or `err`, which answer nothing, the run ends there quietly
//! with the status a shell reports for `SIGPIPE`, 141.
//!
//! `std.io` has the three streams as a `Source` and two `Sink`s (`io::stdin`, `io::stdout`,
//! `io::stderr`), for what reads and writes any stream.
//!
//! The operations that run another program take an executable as their label: `--exec cc=/usr/bin/cc`
//! binds one program to `cc`, and `process.spawn[cc](..)` can start that program and no other, so the
//! run decides what a footprint's `process.spawn[cc]` may do. They are bound by `ply test --host` too.
//! A label `--exec` does not name is `E0456`, and an `--exec` path that is missing, is not a file or
//! has no execute bit is `E0457` before anything runs. A child's `dir` is its working directory (`""`
//! is the run's own) and is not confined the way an `fs` path is: the label is the capability. A child
//! is given the whole environment it runs with and inherits none of the run's. What the host holds of a
//! child's stream is bounded at 64 MiB: the excess is dropped, and the next answer about it is `E0458`.
//!
//! No child outlives the run that started it: however the run ends, every child still running is
//! killed with `SIGKILL` and reaped by the host.
//!
//! A test handles the program's own process over `Captured`, which `over` does for a whole
//! program, spawns over `Runs`, and started children over `Children`.

/// The program's own process, and the children it runs; `spawn` runs another to its end, and `start`
/// runs one beside the program.
pub nondet effect process {
  /// What followed `--` on the `ply run` command line.
  read args[p]() -> List<String>
  /// Whether the run bound an executable to the label, which is settled before anything runs.
  read bound[e]() -> Bool
  /// Writes one line to standard output, after whatever its buffer held.
  write out[p](text: String) -> Unit
  /// Writes one line to standard error.
  write err[p](text: String) -> Unit
  /// Adds `bytes` to standard output's buffer as they are, with no line ending. `false` once the
  /// stream's reader has gone away, when the bytes go nowhere.
  write out_bytes[p](bytes: Bytes) -> Bool
  /// Writes `bytes` to standard error as they are, with no line ending. `false` once the stream's
  /// reader has gone away.
  write err_bytes[p](bytes: Bytes) -> Bool
  /// Writes what standard output's buffer holds. `false` when its reader has gone away.
  write flush[p]() -> Bool
  /// One line of the program's standard input, without its line ending, or `None` at end of input.
  /// A write rather than a read: each line is consumed, so two readers of one input race for it.
  /// A line that is not UTF-8 is `E0502`: `in_bytes` reads one.
  write line[p]() -> Option<String>
  /// What comes next on standard input, at most `max` bytes, waiting until there is something. An
  /// answer shorter than `max` is not the end; an empty one is. One read answers at most 1 MiB,
  /// and a negative `max` is `E0502`.
  write in_bytes[p](max: Int) -> Bytes
  /// Ends the program here with `code`, `0` to `125` (else `E0502`): nothing after it runs and no value
  /// is printed.
  write exit[p](code: Int) -> Unit
  /// Runs the program the label names to its end, with empty input, and answers how it ended and both
  /// streams whole; a stream over 64 MiB is `E0458`.
  write spawn[e](args: List<String>, dir: String, env: List<Var>) -> Finished
  /// A child's handle, or why it could not start. The run kills any child still running when it
  /// ends, however it ends.
  write start[e](args: List<String>, dir: String, env: List<Var>, io: Io) -> Result<Int, String>
  /// How the child ended and what its streams hold, once it has, and the handle is then spent.
  /// `None` while it runs past the timeout; a negative timeout waits for as long as it takes.
  write wait[e](child: Int, timeout_ms: Int) -> Option<Finished>
  /// `false` when the child had already ended.
  write signal[e](child: Int, signal: Signal) -> Bool
  /// Every byte, or `false` once the child's input is closed or the child has ended.
  write input[e](child: Int, bytes: Bytes) -> Bool
  /// Closes the child's input.
  write end_input[e](child: Int) -> Unit
  /// The next line any of the child's `Lines` streams wrote, in the order the host read them, without
  /// its `\n` or `\r\n` and with anything not UTF-8 read as U+FFFD.
  write output_line[e](child: Int, timeout_ms: Int) -> Heard
}

/// What a write to one of the program's own streams refuses.
pub effect pipe {
  /// The stream's reader went away, so it takes nothing more. Unanswered under `ply run --host`,
  /// it ends the run quietly with status 141, as the closed pipe ends a program that never asked.
  raise broken(stream: Stream)
}

/// One of the three streams a process is started with.
pub type Stream = | Stdin | Stdout | Stderr

/// Writes `bytes` to standard output as they are, with no line ending.
pub fn write_out<[p]>(bytes: Bytes) -> Unit / {process.out_bytes[p], pipe.broken} =
  if process.out_bytes[p](bytes) { () } else { pipe.broken(Stdout) }

/// Writes `bytes` to standard error as they are, with no line ending.
pub fn write_err<[p]>(bytes: Bytes) -> Unit / {process.err_bytes[p], pipe.broken} =
  if process.err_bytes[p](bytes) { () } else { pipe.broken(Stderr) }

/// Writes what standard output's buffer holds.
pub fn flush_out<[p]>() -> Unit / {process.flush[p], pipe.broken} =
  if process.flush[p]() { () } else { pipe.broken(Stdout) }

/// One environment variable. A child is given the whole environment and inherits none of the run's.
pub type Var = { name: String, value: String }

/// One variable of a child's environment.
pub fn var(name: String, value: String) -> Var = { name: name, value: value }

/// How a child ended: its own code, or the signal that killed it.
pub type Ended = | Exited(Int) | Signalled(Int)

/// What a child left behind: how it ended and what the host held of each stream, which for a spawn
/// is everything it wrote.
pub type Finished = { ended: Ended, out: Bytes, err: Bytes }

/// The code a child exited with; `None` for one a signal killed.
pub fn exit_code(f: Finished) -> Option<Int> =
  match f.ended { Exited(code) -> Some(code), Signalled(_) -> None }

/// Where one of a started child's output streams goes. `Keep` holds all of it for `wait`; `Lines`
/// hands it over a line at a time through `output_line`, and the unread ones at `wait`; `Inherit`
/// is the program's own stream; `File` writes a file, relative to the child's directory, from empty.
pub type Output = | Keep | Discard | Inherit | Lines | File(String)

/// How a started child is wired: whether it reads what the program writes, and where each of its
/// output streams goes.
pub type Io = { input: Bool, out: Output, err: Output }

/// `SIGHUP`, `SIGINT`, `SIGTERM`, `SIGKILL`, `SIGUSR1`, `SIGUSR2` or `SIGWINCH`.
pub type Signal = | Hangup | Interrupt | Terminate | Kill | User1 | User2 | WindowChange

/// What `output_line` heard: the next line of any `Lines` stream without its ending, nothing before
/// the timeout, or the end of every `Lines` stream once each line has been read.
pub type Heard = | Said(String) | Quiet | Closed

// --- The twin ---------------------------------------------------------------

/// One write the twin took: the stream, and the bytes exactly, a line with the `\n` that ends it.
pub type Written = { stream: Stream, bytes: Bytes }

/// What a test hands the clauses below in place of the host: the arguments the program was started
/// with, what it may read, what it wrote, and the code it asked to exit with.
pub type Captured = {
  args: List<String>,
  /// What the input still holds, in the chunks its reads are answered from. A read of bytes takes
  /// from the first chunk and never past it, so a chunk is the most one read answers; an empty
  /// chunk is an end the input goes on after, as a terminal's is; running out is the end.
  input: List<Bytes>,
  /// Each text `out` wrote.
  out: List<String>,
  /// Each text `err` wrote.
  err: List<String>,
  /// Every write to either stream in the order it was made, lines and bytes alike.
  written: List<Written>,
  /// The streams whose reader has gone away, which take nothing more.
  gone: List<Stream>,
  code: Option<Int>,
}

/// A twin started with these arguments, with no input.
pub fn captured(args: List<String>) -> Captured =
  { args: args, input: [], out: [], err: [], written: [], gone: [], code: None }

/// The same twin, reading the given lines before end of input, a chunk each.
pub fn with_input(c: Captured, lines: List<String>) -> Captured =
  { ..c, input: map(lines, |line: String| bytes_of_string(line ++ "\n")) }

/// The same twin, its input handed out in these chunks, so a test names the short reads a pipe
/// or a terminal gives.
pub fn with_chunks(c: Captured, chunks: List<Bytes>) -> Captured = { ..c, input: chunks }

/// The same twin once `stream`'s reader has gone away.
pub fn hung_up(c: Captured, stream: Stream) -> Captured = { ..c, gone: push(c.gone, stream) }

/// Everything `stream` was written, byte for byte.
pub fn written_to(c: Captured, stream: Stream) -> Bytes =
  bytes_concat_all(
    fold(c.written, [], |parts: List<Bytes>, w: Written|
      if w.stream == stream { push(parts, w.bytes) } else { parts }),
  )

/// The status a shell reports of a program a closed pipe ended.
pub fn broken_pipe_status() -> Int = 141

/// What `process.args` answers over `c`.
pub fn args_step(c: Captured) -> List<String> = c.args

/// One scripted line and the twin with it consumed; `None` once the script is empty.
pub type Line = { captured: Captured, line: Option<String> }

type Cut = { before: List<Bytes>, after: List<Bytes>, ended: Bool }

/// The chunks cut at their first `\n`: what comes before it, what follows it, and whether there
/// was one.
fn cut_at_newline(chunks: List<Bytes>) -> Cut / {abort.raise} =
  fold(chunks, { before: [], after: [], ended: false }, |cut: Cut, chunk: Bytes|
    if cut.ended { { ..cut, after: push(cut.after, chunk) } } else {
      match bytes_index_of_byte(chunk, b'\n') {
        None -> { ..cut, before: push(cut.before, chunk) },
        Some(i) -> {
          let rest = bytes_slice(chunk, i + 1, bytes_len(chunk));
          {
            before: push(cut.before, bytes_slice(chunk, 0, i)),
            after: if bytes_len(rest) == 0 { cut.after } else { push(cut.after, rest) },
            ended: true,
          }
        },
      }
    })

/// Where a line ends once the `\r`s before its `\n` are dropped.
fn before_returns(line: Bytes, n: Int) -> Int / {abort.raise} =
  if n <= 0 { 0 } else if bytes_at(line, n - 1) == b'\r' { before_returns(line, n - 1) } else { n }

/// What `process.line` answers over `c`: what the input holds up to its first `\n`, over as many
/// chunks as that takes, and what follows stays for the next read, of a line or of bytes. A last
/// line needs no `\n`. A line that is not UTF-8 panics, as the host refuses one.
pub fn line_step(c: Captured) -> Line / {abort.raise} = {
  let cut = cut_at_newline(c.input);
  let line = bytes_concat_all(cut.before);
  if !cut.ended && bytes_len(line) == 0 { { captured: { ..c, input: [] }, line: None } } else {
    {
      captured: { ..c, input: cut.after },
      line: Some(string_of_bytes(bytes_slice(line, 0, before_returns(line, bytes_len(line))))),
    }
  }
}

/// One read's answer and the twin with it consumed.
pub type Read = { captured: Captured, bytes: Bytes }

/// What `process.in_bytes` answers over `c`: at most `max` bytes of the input's first chunk, the
/// rest of which stays first, and nothing once the input has run out. A negative `max` panics, as
/// the host refuses one.
pub fn in_bytes_step(c: Captured, max: Int) -> Read / {abort.raise} =
  if max < 0 { panic("a read's length cannot be negative") } else {
    match c.input {
      [] -> { captured: c, bytes: b"" },
      [chunk, ..later] -> {
        let n = min(max, bytes_len(chunk));
        let left = bytes_slice(chunk, n, bytes_len(chunk));
        {
          captured: {
            ..c,
            input: if bytes_len(left) == 0 { later } else { fold(later, [left], push) },
          },
          bytes: bytes_slice(chunk, 0, n),
        }
      },
    }
  }

/// Whether `stream`'s reader has gone away.
fn reader_gone(c: Captured, stream: Stream) -> Bool =
  fold(c.gone, false, |gone: Bool, s: Stream| gone || s == stream)

fn line_written(c: Captured, stream: Stream, text: String) -> List<Written> =
  push(c.written, { stream: stream, bytes: bytes_of_string(text ++ "\n") })

/// What `process.out` records; nothing, once the stream's reader has gone.
pub fn out_step(c: Captured, text: String) -> Captured =
  if reader_gone(c, Stdout) { c }
  else { { ..c, out: push(c.out, text), written: line_written(c, Stdout, text) } }

/// What `process.err` records; nothing, once the stream's reader has gone.
pub fn err_step(c: Captured, text: String) -> Captured =
  if reader_gone(c, Stderr) { c }
  else { { ..c, err: push(c.err, text), written: line_written(c, Stderr, text) } }

/// One write of bytes: the twin after it, and whether the stream took them.
pub type Wrote = { captured: Captured, taken: Bool }

fn bytes_written(c: Captured, stream: Stream, bytes: Bytes) -> Wrote =
  if reader_gone(c, stream) { { captured: c, taken: false } } else {
    { captured: { ..c, written: push(c.written, { stream: stream, bytes: bytes }) }, taken: true }
  }

/// What `process.out_bytes` answers over `c`, and records.
pub fn out_bytes_step(c: Captured, bytes: Bytes) -> Wrote = bytes_written(c, Stdout, bytes)

/// What `process.err_bytes` answers over `c`, and records.
pub fn err_bytes_step(c: Captured, bytes: Bytes) -> Wrote = bytes_written(c, Stderr, bytes)

/// What `process.flush` answers over `c`. The twin holds nothing back, so a flush moves nothing.
pub fn flush_step(c: Captured) -> Bool = !reader_gone(c, Stdout)

/// The first code wins, as it does under the host: the program has stopped by the time a second could run.
pub fn exit_step(c: Captured, code: Int) -> Captured =
  match c.code { Some(_) -> c, None -> { ..c, code: Some(code) } }

/// What a program answered over a twin, and the twin it left. `value` is `None` where the program
/// ended itself: by `process.exit`, or by a line written to a stream whose reader had gone, which
/// leaves the code 141.
pub type Over<a> = { value: Option<a>, captured: Captured }

/// `go` run as the program whose process `c` is: every operation on its own streams, arguments
/// and exit code answered by the twin, as the host answers them.
pub fn over<a, [p] | e>(
  c: Captured,
  go: () -> a / {process.args[p], process.out[p], process.err[p], process.out_bytes[p], process.err_bytes[p], process.flush[p], process.line[p], process.in_bytes[p], process.exit[p] | e},
) -> Over<a> / {abort.raise | e} =
  with_cell[process_twin](c) { io -> {
    let lined = |stream: Stream, after: Captured| {
      let gone = reader_gone(cell_get(io), stream);
      cell_set(io, if gone { exit_step(cell_get(io), broken_pipe_status()) } else { after });
      !gone
    };
    let wrote = |w: Wrote| {
      cell_set(io, w.captured);
      w.taken
    };
    let value = handle {
      Some(go())
    } with {
      process.args[p]() -> args_step(cell_get(io)),
      process.out[p](text) resume k -> if lined(Stdout, out_step(cell_get(io), text)) { k(()) }
      else { None },
      process.err[p](text) resume k -> if lined(Stderr, err_step(cell_get(io), text)) { k(()) }
      else { None },
      process.out_bytes[p](bytes) -> wrote(out_bytes_step(cell_get(io), bytes)),
      process.err_bytes[p](bytes) -> wrote(err_bytes_step(cell_get(io), bytes)),
      process.flush[p]() -> flush_step(cell_get(io)),
      process.line[p]() -> {
        let read = line_step(cell_get(io));
        cell_set(io, read.captured);
        read.line
      },
      process.in_bytes[p](max) -> {
        let read = in_bytes_step(cell_get(io), max);
        cell_set(io, read.captured);
        read.bytes
      },
      process.exit[p](code) resume k -> {
        cell_set(io, exit_step(cell_get(io), code));
        None
      },
    };
    { value: value, captured: cell_get(io) }
  } }

/// What one spawn or start asked for. The executable is not here: the label names it, and the host
/// binds that.
pub type Launch = { args: List<String>, dir: String, env: List<Var> }

/// What a test answers spawns with, and what it has been asked to run; replies are handed out in order.
/// The label is bound once a reply is planned unless the test sets `bound`, and no step changes it.
pub type Runs = { replies: List<Finished>, launched: List<Launch>, bound: Bool }

/// A twin that answers spawns with `replies`, in order.
pub fn runs(replies: List<Finished>) -> Runs =
  { replies: replies, launched: [], bound: len(replies) > 0 }

/// What `process.bound` answers over `r`.
pub fn runs_bound_step(r: Runs) -> Bool = r.bound

/// One spawn's answer and the twin that recorded it.
pub type Ran = { runs: Runs, finished: Finished }

/// A spawn a test planned no reply for answers 127, as a shell does for a command it cannot run.
pub fn spawn_step(r: Runs, launch: Launch) -> Ran =
  match r.replies {
    [] ->
      {
        runs: { ..r, launched: push(r.launched, launch) },
        finished: { ended: Exited(127), out: b"", err: b"" },
      },
    [first, ..rest] ->
      { runs: { ..r, replies: rest, launched: push(r.launched, launch) }, finished: first },
  }

/// A child that exited with `code` and wrote these streams.
pub fn exited(code: Int, out: Bytes, err: Bytes) -> Finished =
  { ended: Exited(code), out: out, err: err }

/// A child killed by `signal`, having written these streams.
pub fn signalled(signal: Int, out: Bytes, err: Bytes) -> Finished =
  { ended: Signalled(signal), out: out, err: err }

// --- The children's twin ----------------------------------------------------

/// One child a test plans: how many `wait`s find it still running, how it ends, and what
/// `output_line` hears from it, in order.
pub type Script = { polls: Int, finished: Finished, heard: List<Heard> }

/// A child that `wait` finds running `polls` times, then `finished`, and that says `heard`.
pub fn script(polls: Int, finished: Finished, heard: List<Heard>) -> Script =
  { polls: polls, finished: finished, heard: heard }

/// A started child and what the program did to it: the bytes it wrote to the child's input,
/// whether that input is still open, and the signals it sent.
pub type Child = {
  launch: Launch,
  io: Io,
  script: Script,
  written: Bytes,
  open: Bool,
  signals: List<Signal>,
  spent: Bool,
}

/// What a test hands the children's clauses in place of the host: the children it planned, handed
/// to `start`s in order, and each child started, whose handle is its place in `started` from 1.
/// The label is bound once a child is planned unless the test sets `bound`, and no step changes it.
pub type Children = { planned: List<Script>, started: List<Child>, bound: Bool }

/// A twin that hands `start`s the planned children, in order.
pub fn children(planned: List<Script>) -> Children =
  { planned: planned, started: [], bound: len(planned) > 0 }

/// What `process.bound` answers over `c`.
pub fn bound_step(c: Children) -> Bool = c.bound

/// One step of the twin: the twin with the step recorded, and what the host would have answered.
pub type Answered<a> = { children: Children, answer: a }

/// A start a test planned no child for could not start, as a spawn it planned no reply for could
/// not run.
pub fn start_step(c: Children, launch: Launch, io: Io) -> Answered<Result<Int, String>> =
  match c.planned {
    [] -> { children: c, answer: Err("no child was planned for this start") },
    [first, ..rest] -> {
      let child = {
        launch: launch,
        io: io,
        script: first,
        written: b"",
        open: io.input,
        signals: [],
        spent: false,
      };
      let started = push(c.started, child);
      { children: { ..c, planned: rest, started: started }, answer: Ok(len(started)) }
    },
  }

/// The host refuses a handle it never answered and one already waited on, and so does the twin.
fn child_at(c: Children, child: Int) -> Child / {abort.raise} =
  match list_at(c.started, child - 1) {
    None -> panic("no child has the handle " ++ int_to_string(child)),
    Some(one) -> if one.spent {
      panic("child " ++ int_to_string(child) ++ " has already been waited on")
    } else { one },
  }

fn replaced(c: Children, child: Int, one: Child) -> Children / {abort.raise} =
  { ..c, started: list_set(c.started, child - 1, one) }

/// What `process.wait` answers over `c`: the child's `Finished` once its planned polls are spent, and
/// the handle is then spent.
pub fn wait_step(c: Children, child: Int) -> Answered<Option<Finished>> / {abort.raise} = {
  let one = child_at(c, child);
  if one.script.polls > 0 {
    let polled = { ..one.script, polls: one.script.polls - 1 };
    { children: replaced(c, child, { ..one, script: polled }), answer: None }
  } else {
    { children: replaced(c, child, { ..one, spent: true }), answer: Some(one.script.finished) }
  }
}

/// `Kill` ends a scripted child as it ends a real one, so the next `wait` hands it back.
pub fn signal_step(c: Children, child: Int, signal: Signal) -> Answered<Bool> / {abort.raise} = {
  let one = child_at(c, child);
  let polls = match signal { Kill -> 0, _ -> one.script.polls };
  let signalled = {
    ..one,
    script: { ..one.script, polls: polls },
    signals: push(one.signals, signal),
  };
  { children: replaced(c, child, signalled), answer: true }
}

/// What `process.input` answers over `c`.
pub fn input_step(c: Children, child: Int, bytes: Bytes) -> Answered<Bool> / {abort.raise} = {
  let one = child_at(c, child);
  if one.open {
    let fed = { ..one, written: bytes_concat(one.written, bytes) };
    { children: replaced(c, child, fed), answer: true }
  } else { { children: c, answer: false } }
}

/// What `process.end_input` records.
pub fn end_input_step(c: Children, child: Int) -> Children / {abort.raise} =
  replaced(c, child, { ..child_at(c, child), open: false })

/// A script that runs out is the end of the child's lines, as a stream's end is.
pub fn output_line_step(c: Children, child: Int) -> Answered<Heard> / {abort.raise} = {
  let one = child_at(c, child);
  match one.script.heard {
    [] -> { children: c, answer: Closed },
    [first, ..rest] -> {
      let heard = { ..one, script: { ..one.script, heard: rest } };
      { children: replaced(c, child, heard), answer: first }
    },
  }
}

// --- Tests ------------------------------------------------------------------

fn greet(names: List<String>) -> Unit / {process.out[proc]} =
  match names {
    [] -> (),
    [first, ..rest] -> {
      process.out[proc]("hello " ++ first);
      greet(rest)
    },
  }

fn greet_all() -> Unit / {process.args[proc], process.out[proc], process.err[proc], process.exit[proc]} = {
  let names = process.args[proc]();
  if len(names) == 0 {
    process.err[proc]("no one to greet");
    process.exit[proc](2)
  } else {
    greet(names);
    process.exit[proc](0)
  }
}

test "a handled program's lines arrive in order, on the stream each was written to" {
  with_cell[twin](captured(["ada", "bob"])) { s -> {
    handle {
      greet_all()
    } with {
      process.args[proc]() -> args_step(cell_get(s)),
      process.out[proc](t) -> cell_set(s, out_step(cell_get(s), t)),
      process.err[proc](t) -> cell_set(s, err_step(cell_get(s), t)),
      process.exit[proc](c) -> cell_set(s, exit_step(cell_get(s), c)),
    };
    let c = cell_get(s);
    assert_eq(c.out, ["hello ada", "hello bob"]);
    assert_eq(c.err, []);
    assert_eq(c.code, Some(0))
  } }
}

// Dropping the continuation ends the program at the exit, as the host does.
test "an exit clause without a resume ends the program there" {
  with_cell[twin](captured([])) { s -> {
    handle {
      greet_all();
      process.out[proc]("after the exit")
    } with {
      process.args[proc]() -> args_step(cell_get(s)),
      process.out[proc](t) -> cell_set(s, out_step(cell_get(s), t)),
      process.err[proc](t) -> cell_set(s, err_step(cell_get(s), t)),
      process.exit[proc](c) resume k -> cell_set(s, exit_step(cell_get(s), c)),
    };
    let c = cell_get(s);
    assert_eq(c.out, []);
    assert_eq(c.err, ["no one to greet"]);
    assert_eq(c.code, Some(2))
  } }
}

test "the twin starts with the arguments and nothing written" {
  let c = captured(["--verbose"]);
  assert_eq(args_step(c), ["--verbose"]);
  assert_eq(c.out, []);
  assert_eq(c.err, []);
  assert_eq(c.code, None)
}

test "the first exit code is the one kept" {
  let once = exit_step(captured([]), 3);
  assert_eq(once.code, Some(3));
  assert_eq(exit_step(once, 4).code, Some(3))
}

/// A compiler driver's shape: the label is the compiler, and a failed unit is an answer.
fn compile(unit: String) -> Result<Bytes, String> / {process.spawn[cc]} = {
  let done = process.spawn[cc](["-c", unit, "-o", unit ++ ".o"], "build", [
    var("LANG", "C"),
    var("TMPDIR", "/tmp"),
  ]);
  match done.ended {
    Exited(code) -> if code == 0 { Ok(done.out) } else { Err("cc exited " ++ int_to_string(code)) },
    Signalled(sig) -> Err("cc was killed by signal " ++ int_to_string(sig)),
  }
}

test "a spawn is answered by the twin, which records what it was asked to run" {
  with_cell[builds](runs([exited(0, b"built", b"")])) { s -> {
    handle {
      assert_eq(compile("lexer.c"), Ok(b"built"))
    } with {
      process.spawn[cc](args, dir, env) -> {
        let r = spawn_step(cell_get(s), { args: args, dir: dir, env: env });
        cell_set(s, r.runs);
        r.finished
      },
    };
    let seen = cell_get(s);
    assert_eq(len(seen.launched), 1);
    match list_at(seen.launched, 0) {
      None -> panic("the spawn was recorded"),
      Some(one) -> {
        assert_eq(one.args, ["-c", "lexer.c", "-o", "lexer.c.o"]);
        assert_eq(one.dir, "build");
        assert_eq(one.env, [var("LANG", "C"), var("TMPDIR", "/tmp")])
      },
    }
  } }
}

// Neither ending is a diagnostic: what the compiler said is the value the driver reads.
test "a nonzero exit and a signal are both answers" {
  handle {
    assert_eq(compile("parser.c"), Err("cc exited 1"))
  } with {
    process.spawn[cc](args, dir, env) -> exited(1, b"", b"parser.c:3: expected `;`"),
  };
  handle {
    assert_eq(compile("parser.c"), Err("cc was killed by signal 9"))
  } with {
    process.spawn[cc](args, dir, env) -> signalled(9, b"", b""),
  }
}

fn echo_lines() -> Unit / {process.line[proc], process.out[proc], diverges} =
  match process.line[proc]() {
    None -> (),
    Some(text) -> {
      process.out[proc](text);
      echo_lines()
    },
  }

test "a program reads lines until the input ends, and each ends at its newline" {
  with_cell[twin](with_input(captured([]), ["one", "two"])) { s -> {
    handle {
      echo_lines()
    } with {
      process.line[proc]() -> {
        let step = line_step(cell_get(s));
        cell_set(s, step.captured);
        step.line
      },
      process.out[proc](t) -> cell_set(s, out_step(cell_get(s), t)),
    };
    let c = cell_get(s);
    assert_eq(c.out, ["one", "two"]);
    // The script runs out into end of input, and reading past it is `None` rather than a raise.
    assert_eq(line_step(captured([])).line, None)
  } }
}

test "a spawn a test planned no reply for is a command that could not be run" {
  let r = spawn_step(runs([]), { args: [], dir: "", env: [] });
  assert_eq(exit_code(r.finished), Some(127));
  assert_eq(r.finished.out, b"");
  assert_eq(len(r.runs.launched), 1);
  assert_eq(exit_code(signalled(9, b"", b"")), None)
}

/// A supervisor's shape: start a server, read until it says it listens, stop it, and kill it if it
/// has not stopped in time.
fn supervise(
  tries: Int,
) -> Result<Finished, String> / {process.start[srv], process.output_line[srv], process.signal[srv], process.wait[srv]} = {
  let child = process.start[srv](["serve"], "", [], { input: false, out: Lines, err: Inherit })?;
  if listening(child, tries) {
    let _ = process.signal[srv](child, Terminate);
    match process.wait[srv](child, 1000) { Some(done) -> Ok(done), None -> killed(child) }
  } else {
    let _ = killed(child);
    Err("the server never said it was listening")
  }
}

fn listening(child: Int, tries: Int) -> Bool / {process.output_line[srv]} =
  if tries <= 0 { false } else {
    match process.output_line[srv](child, 100) {
      Said(line) -> string_starts_with(line, "listening") || listening(child, tries - 1),
      Quiet -> listening(child, tries - 1),
      Closed -> false,
    }
  }

fn killed(child: Int) -> Result<Finished, String> / {process.signal[srv], process.wait[srv]} = {
  let _ = process.signal[srv](child, Kill);
  match process.wait[srv](child, -1) {
    Some(done) -> Ok(done),
    None -> Err("the server outlived a kill"),
  }
}

/// The supervisor with every child it starts answered by the twin.
fn supervised(planned: List<Script>) -> Answered<Result<Finished, String>> / {abort.raise} =
  with_cell[kids](children(planned)) { kids -> {
    let answer = handle {
      supervise(5)
    } with {
      process.start[srv](args, dir, env, io) -> {
        let step = start_step(cell_get(kids), { args: args, dir: dir, env: env }, io);
        cell_set(kids, step.children);
        step.answer
      },
      process.output_line[srv](child, timeout_ms) -> {
        let step = output_line_step(cell_get(kids), child);
        cell_set(kids, step.children);
        step.answer
      },
      process.signal[srv](child, signal) -> {
        let step = signal_step(cell_get(kids), child, signal);
        cell_set(kids, step.children);
        step.answer
      },
      process.wait[srv](child, timeout_ms) -> {
        let step = wait_step(cell_get(kids), child);
        cell_set(kids, step.children);
        step.answer
      },
    };
    { children: cell_get(kids), answer: answer }
  } }

fn only_child(c: Children) -> Child / {abort.raise} =
  match c.started { [one] -> one, _ -> panic("one child was started") }

test "a server that says it listens is stopped, and the stop is what ended it" {
  let run = supervised([
    script(0, exited(0, b"", b""), [Said("booting"), Quiet, Said("listening on 8080")]),
  ]);
  assert_eq(run.answer, Ok(exited(0, b"", b"")));
  let server = only_child(run.children);
  assert_eq(server.launch.args, ["serve"]);
  assert_eq(server.io, { input: false, out: Lines, err: Inherit });
  assert_eq(server.signals, [Terminate]);
  assert(server.spent)
}

test "a server that outlives its stop is killed, and the kill hands it back" {
  let run = supervised([script(3, signalled(9, b"", b""), [Said("listening on 8080")])]);
  assert_eq(run.answer, Ok(signalled(9, b"", b"")));
  assert_eq(only_child(run.children).signals, [Terminate, Kill])
}

test "a server that never says it listens is killed rather than waited on" {
  let run = supervised([script(10, signalled(9, b"", b""), [Said("booting")])]);
  assert_eq(run.answer, Err("the server never said it was listening"));
  assert_eq(only_child(run.children).signals, [Kill])
}

test "a start with no child planned could not start, and nothing is waited on" {
  let run = supervised([]);
  assert_eq(run.answer, Err("no child was planned for this start"));
  assert_eq(run.children.started, [])
}

/// A tool driven over its input: every line in, the end of its input, and what it wrote back.
fn feed(
  lines: List<String>,
) -> Result<Bytes, String> / {process.start[tool], process.input[tool], process.end_input[tool], process.wait[tool]} = {
  let child = process.start[tool](["--stdin"], "", [], { input: true, out: Keep, err: Discard })?;
  let fed = fold(lines, true, |ok: Bool, line: String|
    ok && process.input[tool](child, bytes_of_string(line ++ "\n")));
  process.end_input[tool](child);
  match process.wait[tool](child, -1) {
    Some(done) -> if fed { Ok(done.out) } else { Err("the tool stopped reading") },
    None -> Err("the tool is still running"),
  }
}

test "a tool fed over its input gets every byte, then the end of its input" {
  with_cell[kids](children([script(0, exited(0, b"2 lines\n", b""), [])])) { kids -> {
    handle {
      assert_eq(feed(["one", "two"]), Ok(b"2 lines\n"))
    } with {
      process.start[tool](args, dir, env, io) -> {
        let step = start_step(cell_get(kids), { args: args, dir: dir, env: env }, io);
        cell_set(kids, step.children);
        step.answer
      },
      process.input[tool](child, bytes) -> {
        let step = input_step(cell_get(kids), child, bytes);
        cell_set(kids, step.children);
        step.answer
      },
      process.end_input[tool](child) -> cell_set(kids, end_input_step(cell_get(kids), child)),
      process.wait[tool](child, timeout_ms) -> {
        let step = wait_step(cell_get(kids), child);
        cell_set(kids, step.children);
        step.answer
      },
    };
    let tool = only_child(cell_get(kids));
    assert_eq(tool.written, b"one\ntwo\n");
    assert(!tool.open)
  } }
}

test "a child's input takes nothing once it is ended or was never opened" {
  let io = { input: true, out: Keep, err: Keep };
  let started = start_step(
    children([script(0, exited(0, b"", b""), [])]),
    { args: [], dir: "", env: [] },
    io,
  );
  let ended = end_input_step(started.children, 1);
  assert_eq(input_step(ended, 1, b"late").answer, false);
  let unopened = start_step(
    children([script(0, exited(0, b"", b""), [])]),
    { args: [], dir: "", env: [] },
    { ..io, input: false },
  );
  assert_eq(input_step(unopened.children, 1, b"early").answer, false)
}

test "a child runs through its polls, then hands back how it ended, and its lines run out closed" {
  let started = start_step(
    children([script(2, exited(3, b"", b""), [Said("one")])]),
    { args: [], dir: "", env: [] },
    { input: false, out: Lines, err: Keep },
  );
  let first = wait_step(started.children, 1);
  assert_eq(first.answer, None);
  let second = wait_step(first.children, 1);
  assert_eq(second.answer, None);
  let heard = output_line_step(second.children, 1);
  assert_eq(heard.answer, Said("one"));
  assert_eq(output_line_step(heard.children, 1).answer, Closed);
  let third = wait_step(heard.children, 1);
  assert_eq(third.answer, Some(exited(3, b"", b"")));
  assert(only_child(third.children).spent)
}

/// What a driver that can do without its compiler and its server asks before it reaches for either.
fn tools_bound() -> List<Bool> / {process.bound[cc], process.bound[srv]} =
  [process.bound[cc](), process.bound[srv]()]

test "`bound` answers true for a label the twin binds and false for one it does not" {
  handle {
    assert_eq(tools_bound(), [true, false])
  } with {
    process.bound[cc]() -> runs_bound_step(runs([exited(0, b"", b"")])),
    process.bound[srv]() -> bound_step(children([])),
  };
  handle {
    assert_eq(tools_bound(), [false, true])
  } with {
    process.bound[cc]() -> runs_bound_step(runs([])),
    process.bound[srv]() -> bound_step(children([script(0, exited(0, b"", b""), [])])),
  }
}

test "a label stays bound however its twin moves, and a test may say otherwise" {
  let launch = { args: [], dir: "", env: [] };
  let spent = spawn_step(runs([exited(0, b"", b"")]), launch).runs;
  assert_eq(spent.replies, []);
  assert(runs_bound_step(spent));
  let planned = children([script(0, exited(0, b"", b""), [])]);
  let started = start_step(planned, launch, { input: false, out: Keep, err: Keep });
  assert_eq(started.children.planned, []);
  assert(bound_step(wait_step(started.children, 1).children));
  assert(!bound_step({ ..planned, bound: false }));
  assert(runs_bound_step({ ..runs([]), bound: true }))
}

/// Asks a question and reads the answer from the line the question is on.
fn ask(
  question: String,
) -> Option<String> / {process.out_bytes[proc], process.line[proc], pipe.broken} = {
  write_out[proc](bytes_of_string(question));
  process.line[proc]()
}

test "a prompt is written without a newline, and its answer read from the same line" {
  let ran = over[proc](with_input(captured([]), ["ada"]), || ask("name: "));
  assert_eq(ran.value, Some(Some("ada")));
  assert_eq(written_to(ran.captured, Stdout), b"name: ");
  assert_eq(ran.captured.out, []);
  assert_eq(ran.captured.input, [])
}

test "bytes read after a line start where the line ended, and a line after bytes where they did" {
  let first = line_step(with_chunks(captured([]), [b"head", b"er\r\nbo", b"dy\nlast"]));
  assert_eq(first.line, Some("header"));
  let some = in_bytes_step(first.captured, 100);
  assert_eq(some.bytes, b"bo");
  let more = in_bytes_step(some.captured, 1);
  assert_eq(more.bytes, b"d");
  let second = line_step(more.captured);
  assert_eq(second.line, Some("y"));
  let last = line_step(second.captured);
  assert_eq(last.line, Some("last"));
  assert_eq(line_step(last.captured).line, None);
  assert_eq(in_bytes_step(last.captured, 8).bytes, b"")
}

test "a read answers no more than it asks for or than its chunk holds, and an empty chunk is an end the input goes on after" {
  let c = with_chunks(captured([]), [b"abc", b"", b"de"]);
  let none = in_bytes_step(c, 0);
  assert_eq(none.bytes, b"");
  assert_eq(none.captured.input, c.input);
  let two = in_bytes_step(c, 2);
  assert_eq(two.bytes, b"ab");
  let short = in_bytes_step(two.captured, 100);
  assert_eq(short.bytes, b"c");
  let ended = in_bytes_step(short.captured, 100);
  assert_eq(ended.bytes, b"");
  assert_eq(in_bytes_step(ended.captured, 100).bytes, b"de")
}

test "the twin keeps what each stream was written, and both in the order it was written" {
  let ran = over[proc](captured([]), || {
    write_out[proc](b"a");
    process.err[proc]("warn");
    process.out[proc]("b");
    write_err[proc](b"\x00\xff")
  });
  assert_eq(ran.captured.written, [
    { stream: Stdout, bytes: b"a" },
    { stream: Stderr, bytes: b"warn\n" },
    { stream: Stdout, bytes: b"b\n" },
    { stream: Stderr, bytes: b"\x00\xff" },
  ]);
  assert_eq(written_to(ran.captured, Stdout), b"ab\n");
  assert_eq(written_to(ran.captured, Stderr), b"warn\n\x00\xff");
  assert_eq(ran.captured.out, ["b"]);
  assert_eq(ran.captured.err, ["warn"])
}

test "a reader that went away is a raise a program answers, and a line written to it ends the program" {
  let closed = hung_up(captured([]), Stdout);
  let answered = over[proc](closed, || {
    let wrote: Result<Unit, Stream> = try[pipe.broken] { write_out[proc](b"x") };
    wrote
  });
  assert_eq(answered.value, Some(Err(Stdout)));
  assert_eq(answered.captured.code, None);
  let flushed = over[proc](closed, || {
    let wrote: Result<Unit, Stream> = try[pipe.broken] { flush_out[proc]() };
    wrote
  });
  assert_eq(flushed.value, Some(Err(Stdout)));
  let ended = over[proc](closed, || {
    process.err[proc]("still read");
    process.out[proc]("into nothing");
    process.err[proc]("never written")
  });
  assert_eq(ended.value, None);
  assert_eq(ended.captured.code, Some(broken_pipe_status()));
  assert_eq(ended.captured.err, ["still read"]);
  assert_eq(written_to(ended.captured, Stdout), b"")
}

test "an exit under `over` ends the program there, with what it had written" {
  let ran = over[proc](captured(["x"]), || {
    process.out[proc](at_first(process.args[proc]()));
    process.exit[proc](3);
    process.out[proc]("after the exit")
  });
  assert_eq(ran.value, None);
  assert_eq(ran.captured.out, ["x"]);
  assert_eq(ran.captured.code, Some(3))
}

fn at_first(args: List<String>) -> String = match args { [first, ..] -> first, [] -> "" }

type Fed = { head: List<Int>, tail: List<Int>, ask: Int }

/// Bytes a reader of lines and a reader of bytes both care about, one for each of `picks`.
fn fed(picks: List<Int>) -> Bytes =
  bytes_concat_all(
    map(picks, |p: Int| if p % 3 == 0 { b"\n" } else if p % 3 == 1 { b"\x00" } else { b"\xff" }),
  )

fn read_in_pieces(f: Fed) -> Bytes / {abort.raise} = {
  let chunks = filter([fed(f.head), fed(f.tail)], |chunk: Bytes| bytes_len(chunk) > 0);
  let most = (f.ask % 5 + 5) % 5 + 1;
  bytes_concat_all(
    iterate(
      { twin: with_chunks(captured([]), chunks), parts: [] },
      len(f.head) + len(f.tail) + 2,
      |s: { twin: Captured, parts: List<Bytes> }| {
        let read = in_bytes_step(s.twin, most);
        if bytes_len(read.bytes) == 0 { Stop(s.parts) }
        else { Continue({ twin: read.captured, parts: push(s.parts, read.bytes) }) }
      },
    ),
  )
}

fn read_whole(f: Fed) -> Bytes = bytes_concat(fed(f.head), fed(f.tail))

law "what a program reads is what its input held, whatever the chunks and however much each read asks for"
  forall (f: Fed) {
    read_in_pieces(f) == read_whole(f)
  }
