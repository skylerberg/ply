// The process a program runs in, as an effect; `spawn` starts another one.
pub nondet effect process {
  read args[p]()             -> List<String>
  write out[p](text: String) -> Unit
  write err[p](text: String) -> Unit
  write exit[p](code: Int)   -> Unit
  write spawn[e](args: List<String>, dir: String, env: List<Var>) -> Finished
}

// One environment variable. A spawn is given the whole environment and inherits none of the run's.
pub type Var = { name: String, value: String }

pub fn var(name: String, value: String) -> Var = { name: name, value: value }

// How a spawned process ended: its own code, or the signal that killed it.
pub type Ended = Exited(Int) | Signalled(Int)

// What a spawned process left behind: how it ended and, whole, what it wrote to each stream.
pub type Finished = { ended: Ended, out: Bytes, err: Bytes }

pub fn exit_code(f: Finished) -> Option<Int> =
  match f.ended { Exited(code) -> Some(code), Signalled(_) -> None }

// --- The twin ---------------------------------------------------------------

// What a test hands the clauses below in place of the host: the arguments the
// program was started with, each stream's lines, and the code it asked to exit with.
pub type Captured = {
  args: List<String>,
  out:  List<String>,
  err:  List<String>,
  code: Option<Int>,
}

pub fn captured(args: List<String>) -> Captured =
  { args: args, out: [], err: [], code: None }

pub fn args_step(c: Captured) -> List<String> = c.args

pub fn out_step(c: Captured, text: String) -> Captured = { ..c, out: push(c.out, text) }

pub fn err_step(c: Captured, text: String) -> Captured = { ..c, err: push(c.err, text) }

// The first code wins, as it does under the host: the program has stopped by the time a second could run.
pub fn exit_step(c: Captured, code: Int) -> Captured =
  match c.code { Some(_) -> c, None -> { ..c, code: Some(code) } }

// What one spawn asked for. The executable is not here: the label names it, and the host binds that.
pub type Launch = { args: List<String>, dir: String, env: List<Var> }

// What a test answers spawns with, and what it has been asked to run; replies are handed out in order.
pub type Runs = { replies: List<Finished>, launched: List<Launch> }

pub fn runs(replies: List<Finished>) -> Runs = { replies: replies, launched: [] }

// One spawn's answer and the twin that recorded it.
pub type Ran = { runs: Runs, finished: Finished }

// A spawn a test planned no reply for answers 127, as a shell does for a command it cannot run.
pub fn spawn_step(r: Runs, launch: Launch) -> Ran =
  match r.replies {
    [] -> { runs: { ..r, launched: push(r.launched, launch) },
            finished: { ended: Exited(127), out: b"", err: b"" } },
    [first, ..rest] -> { runs: { ..r, replies: rest, launched: push(r.launched, launch) },
                         finished: first },
  }

pub fn exited(code: Int, out: Bytes, err: Bytes) -> Finished =
  { ended: Exited(code), out: out, err: err }

pub fn signalled(signal: Int, out: Bytes, err: Bytes) -> Finished =
  { ended: Signalled(signal), out: out, err: err }

// --- Tests ------------------------------------------------------------------

fn greet(names: List<String>) -> Unit / {process.out[proc]} =
  match names {
    [] -> (),
    [first, ..rest] -> { process.out[proc]("hello " ++ first); greet(rest) },
  }

fn greet_all() -> Unit / {process.args[proc], process.out[proc], process.err[proc], process.exit[proc]} = {
  let names = process.args[proc]();
  if len(names) == 0 {
    process.err[proc]("no one to greet");
    process.exit[proc](2)
  } else {
    greet(names);
    process.exit[proc](0)
  }
}

test "a handled program's lines arrive in order, on the stream each was written to" {
  with_cell[twin](captured(["ada", "bob"])) { s -> {
    handle {
      greet_all()
    } with {
      process.args[proc]() -> args_step(cell_get(s)),
      process.out[proc](t) -> cell_set(s, out_step(cell_get(s), t)),
      process.err[proc](t) -> cell_set(s, err_step(cell_get(s), t)),
      process.exit[proc](c) -> cell_set(s, exit_step(cell_get(s), c)),
    };
    let c = cell_get(s);
    assert_eq(c.out, ["hello ada", "hello bob"]);
    assert_eq(c.err, []);
    assert_eq(c.code, Some(0))
  } }
}

// Dropping the continuation ends the program at the exit, as the host does.
test "an exit clause without a resume ends the program there" {
  with_cell[twin](captured([])) { s -> {
    handle {
      greet_all();
      process.out[proc]("after the exit")
    } with {
      process.args[proc]() -> args_step(cell_get(s)),
      process.out[proc](t) -> cell_set(s, out_step(cell_get(s), t)),
      process.err[proc](t) -> cell_set(s, err_step(cell_get(s), t)),
      process.exit[proc](c) resume k -> cell_set(s, exit_step(cell_get(s), c)),
    };
    let c = cell_get(s);
    assert_eq(c.out, []);
    assert_eq(c.err, ["no one to greet"]);
    assert_eq(c.code, Some(2))
  } }
}

test "the twin starts with the arguments and nothing written" {
  let c = captured(["--verbose"]);
  assert_eq(args_step(c), ["--verbose"]);
  assert_eq(c.out, []);
  assert_eq(c.err, []);
  assert_eq(c.code, None)
}

test "the first exit code is the one kept" {
  let once = exit_step(captured([]), 3);
  assert_eq(once.code, Some(3));
  assert_eq(exit_step(once, 4).code, Some(3))
}

// A compiler driver's shape: the label is the compiler, and a failed unit is an answer.
fn compile(unit: String) -> Result<Bytes, String> / {process.spawn[cc]} = {
  let done = process.spawn[cc](["-c", unit, "-o", unit ++ ".o"], "build",
                               [var("LANG", "C"), var("TMPDIR", "/tmp")]);
  match done.ended {
    Exited(code) ->
      if code == 0 { Ok(done.out) } else { Err("cc exited " ++ int_to_string(code)) },
    Signalled(sig) -> Err("cc was killed by signal " ++ int_to_string(sig)),
  }
}

test "a spawn is answered by the twin, which records what it was asked to run" {
  with_cell[builds](runs([exited(0, b"built", b"")])) { s -> {
    handle {
      assert_eq(compile("lexer.c"), Ok(b"built"))
    } with {
      process.spawn[cc](args, dir, env) -> {
        let r = spawn_step(cell_get(s), { args: args, dir: dir, env: env });
        cell_set(s, r.runs);
        r.finished
      },
    };
    let seen = cell_get(s);
    assert_eq(len(seen.launched), 1);
    match list_at(seen.launched, 0) {
      None -> panic("the spawn was recorded"),
      Some(one) -> {
        assert_eq(one.args, ["-c", "lexer.c", "-o", "lexer.c.o"]);
        assert_eq(one.dir, "build");
        assert_eq(one.env, [var("LANG", "C"), var("TMPDIR", "/tmp")])
      },
    }
  } }
}

// Neither ending is a diagnostic: what the compiler said is the value the driver reads.
test "a nonzero exit and a signal are both answers" {
  handle {
    assert_eq(compile("parser.c"), Err("cc exited 1"))
  } with {
    process.spawn[cc](args, dir, env) -> exited(1, b"", b"parser.c:3: expected `;`"),
  };
  handle {
    assert_eq(compile("parser.c"), Err("cc was killed by signal 9"))
  } with {
    process.spawn[cc](args, dir, env) -> signalled(9, b"", b""),
  }
}

test "a spawn a test planned no reply for is a command that could not be run" {
  let r = spawn_step(runs([]), { args: [], dir: "", env: [] });
  assert_eq(exit_code(r.finished), Some(127));
  assert_eq(r.finished.out, b"");
  assert_eq(len(r.runs.launched), 1);
  assert_eq(exit_code(signalled(9, b"", b"")), None)
}
