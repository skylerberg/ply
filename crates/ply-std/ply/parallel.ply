// `std.parallel` — work on a list split across `parallel` blocks. A list is cut in halves until a
// piece holds `grain()` items, however many threads there are, so each function answers what its
// sequential counterpart answers.

import std.list (concat)

// The items a piece holds before it is cut in two.
pub fn grain() -> Int = 512

// `map(xs, f)`, its pieces mapped at once.
pub fn par_map<a, b>(xs: List<a>, f: (a) -> b) -> List<b> = mapped(xs, f, 0, len(xs))

fn mapped<a, b>(xs: List<a>, f: (a) -> b, lo: Int, hi: Int) -> List<b> =
  if hi - lo <= grain() {
    fold(range(lo, hi), [], |out: List<b>, i: Int|
      match list_at(xs, i) { Some(x) -> push(out, f(x)), None -> out })
  } else {
    let mid = lo + (hi - lo) / 2;
    let halves = parallel { mapped(xs, f, lo, mid), mapped(xs, f, mid, hi) };
    concat(halves._0, halves._1)
  }

// Each piece folded from `zero` by `step`, and the pieces' answers merged left to right. This is
// `fold(xs, zero, step)` when `merge` is associative, `zero` is its identity and `step(b, x)` is
// `merge(b, step(zero, x))`, as a sum's or a count's are; the pieces are the same on every run.
pub fn par_fold<a, b>(xs: List<a>, zero: b, step: (b, a) -> b, merge: (b, b) -> b) -> b =
  folded(xs, zero, step, merge, 0, len(xs))

fn folded<a, b>(
  xs: List<a>,
  zero: b,
  step: (b, a) -> b,
  merge: (b, b) -> b,
  lo: Int,
  hi: Int,
) -> b =
  if hi - lo <= grain() {
    fold(range(lo, hi), zero, |acc: b, i: Int|
      match list_at(xs, i) { Some(x) -> step(acc, x), None -> acc })
  } else {
    let mid = lo + (hi - lo) / 2;
    let halves = parallel {
      folded(xs, zero, step, merge, lo, mid),
      folded(xs, zero, step, merge, mid, hi),
    };
    merge(halves._0, halves._1)
  }

test "par_map answers what map answers, in order, at every size around a piece" {
  let sizes = [0, 1, grain() - 1, grain(), grain() + 1, 10 * grain() + 7];
  fold(sizes, (), |_u: Unit, n: Int| {
    let xs = range(0, n);
    assert_eq(par_map(xs, |x: Int| x * 3 - 1), map(xs, |x: Int| x * 3 - 1))
  });
  let words = par_map(range(0, 3 * grain()), |i: Int| "w" ++ int_to_string(i));
  assert_eq(list_at(words, 2 * grain()), Some("w" ++ int_to_string(2 * grain())))
}

test "par_fold answers what fold answers for a merge that is associative with its identity" {
  let xs = range(0, 20 * grain() + 3);
  assert_eq(
    par_fold(xs, 0, |acc: Int, x: Int| acc + x, |a: Int, b: Int| a + b),
    fold(xs, 0, |acc: Int, x: Int| acc + x),
  );
  // A list is a monoid under concatenation, so the pieces come back in order.
  let evens = par_fold(
    xs,
    [],
    |acc: List<Int>, x: Int| if x % 2 == 0 { push(acc, x) } else { acc },
    concat,
  );
  assert_eq(evens, filter(xs, |x: Int| x % 2 == 0))
}
