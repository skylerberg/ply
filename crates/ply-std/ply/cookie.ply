//! Cookies as RFC 6265bis has them: the `Cookie` field a request carries, the `Set-Cookie` field a
//! response sets, values signed or sealed under a key, and the jar a client keeps.
//!
//! `pairs` reads a `Cookie` field leniently, as a server must: a pair it cannot read is passed
//! over, never the field. `set_cookie` makes a cookie as a server should set one unless told
//! otherwise: `Secure`, `HttpOnly`, `Path=/` and `SameSite=Lax`. `render` writes one and refuses
//! (`cookie.refused`) what a browser would drop or what would read back as something else: a name
//! that is no token, a value outside the cookie octets, a name and value over 4096 bytes or an
//! attribute over 1024, a `Domain` or `Path` a field cannot carry, a `__Secure-` cookie without
//! `Secure`, a `__Host-` one with a `Domain` or a `Path` other than `/`, and `SameSite=None` or
//! `Partitioned` without `Secure`. The prefixes are matched without regard to case, as a browser
//! matches them.
//!
//! `signed` writes a value a client can read and cannot change: HMAC-SHA-256 under a key, over
//! the cookie's name and the value. `sealed` writes one it can neither read nor change:
//! XChaCha20-Poly1305 under a `std.crypto` key, the name bound in. Either binds the name, so a
//! value set for one cookie is refused under another.
//!
//! A `Jar` is a client's cookies as a value. `store` takes the `Set-Cookie` fields of a response
//! from a URL, and `header_for` answers the `Cookie` field a request to a URL carries, each at an
//! instant the caller reads from the wall clock, counted from the Unix epoch. A cookie goes back to
//! the host that set it, or to the domain it named where that host is in it; under its path; over
//! `https` alone where it is `Secure`; and until it expires. A response over `http` sets no
//! `Secure` cookie and replaces none. There is no public suffix list here: a `Domain` of one label
//! is refused, and one such as `co.uk` is not, so a jar shared between sites that do not trust one
//! another is not what this is. `SameSite` is a browser's rule about which site started a request,
//! which a client that starts every request itself does not have.

import std.base64 (base64url_decode, base64url_encode)
import std.crypto
import std.crypto (SealKey)
import std.date
import std.date (OffsetDateTime)
import std.hash (hmac_sha256, tags_match)
import std.ip
import std.list (any, sort_by)
import std.math (abs)
import std.mime (is_token)
import std.random (entropy)
import std.string (ascii_lower, ascii_trim, eq_ignore_ascii_case, int_of_string, is_ascii)
import std.time (after, nanos_at, seconds)
import std.url
import std.url (Url, url_host, url_path, url_scheme)

// --- The Cookie field -------------------------------------------------------

/// One `name=value` of a request's `Cookie` field.
pub type Pair = { name: String, value: String }

/// The pairs of a `Cookie` field, in the order written. A pair whose name is no token, or that
/// has no `=`, is passed over; a value in double quotes is read without them.
pub fn pairs(field: String) -> List<Pair> / {abort.raise} =
  fold(string_split(field, ";"), [], |found: List<Pair>, piece: String|
    match pair_of(piece) { Some(p) -> push(found, p), None -> found })

/// The pairs of every `Cookie` field a request carries, the fields in order.
pub fn pairs_of(fields: List<String>) -> List<Pair> / {abort.raise} =
  fold(fields, [], |found: List<Pair>, field: String| concat_pairs(found, pairs(field)))

fn concat_pairs(a: List<Pair>, b: List<Pair>) -> List<Pair> =
  fold(b, a, |acc: List<Pair>, p: Pair| push(acc, p))

/// The value of the first pair named `name`, the name matched exactly.
pub fn get(found: List<Pair>, name: String) -> Option<String> = url::query_get(found, name)

fn pair_of(piece: String) -> Option<Pair> / {abort.raise} = {
  let b = bytes_of_string(piece);
  match bytes_index_of(b, b"=") {
    None -> None,
    Some(at) -> {
      let name = ascii_trim(string_of_bytes_lossy(bytes_slice(b, 0, at)));
      let value = unquoted(ascii_trim(string_of_bytes_lossy(bytes_slice(b, at + 1, bytes_len(b)))));
      if is_token(name) { Some({ name: name, value: value }) } else { None }
    },
  }
}

fn unquoted(value: String) -> String = {
  let n = string_len(value);
  if n >= 2 && string_starts_with(value, "\"") && string_ends_with(value, "\"") {
    string_slice(value, 1, n - 1)
  } else { value }
}

// --- Setting a cookie -------------------------------------------------------

/// When a browser sends a cookie on a request another site started: never, on a top-level
/// navigation, or always. `Unrestricted` is written `SameSite=None` and needs `Secure`.
pub type SameSite = | Strict | Lax | Unrestricted

/// A cookie a response sets.
pub type SetCookie = {
  name: String,
  value: String,
  /// Seconds it lives from when it arrives; zero or less removes it. Written as `Max-Age`.
  max_age: Option<Int>,
  /// When it expires, for a client that does not read `Max-Age`; one in the past removes it.
  expires: Option<OffsetDateTime>,
  /// The domain it is sent to besides the host that set it; `None` keeps it to that host.
  domain: Option<String>,
  /// The path under which it is sent; `None` leaves the client to take the request's directory.
  path: Option<String>,
  secure: Bool,
  http_only: Bool,
  same_site: SameSite,
  /// Kept apart for each site that embeds the one that set it (CHIPS); needs `Secure`.
  partitioned: Bool,
}

/// A cookie as a server sets one unless told otherwise: until the browser closes, to the host
/// alone, under `/`, over `https` alone, out of scripts' reach, and on cross-site navigations only.
pub fn set_cookie(name: String, value: String) -> SetCookie =
  {
    name: name,
    value: value,
    max_age: None,
    expires: None,
    domain: None,
    path: Some("/"),
    secure: true,
    http_only: true,
    same_site: Lax,
    partitioned: false,
  }

/// What tells a client to forget the cookie `c` names: the same name, domain and path, an empty
/// value, `Max-Age=0`, and an `Expires` at the epoch for a client that reads no `Max-Age`.
pub fn removal(c: SetCookie) -> SetCookie =
  { ..c, value: "", max_age: Some(0), expires: date::of_unix_seconds(0) }

/// Why a cookie cannot be written.
pub type Why =
  /// The name is no token of RFC 9110.
  | BadName
  /// The value holds a byte outside the cookie octets: a control, a space, `"`, `,`, `;` or `\`.
  | BadValue
  /// The domain is not one or more labels of letters, digits and `-`.
  | BadDomain
  /// The path does not begin with `/`, or holds a control or `;`.
  | BadPath
  /// The name and the value are over 4096 bytes together.
  | TooLong
  /// The named attribute's value is over 1024 bytes.
  | AttributeTooLong(String)
  /// What the text names needs `Secure`: a `__Secure-` or `__Host-` name, `SameSite=None`, or
  /// `Partitioned`.
  | NeedsSecure(String)
  /// A `__Host-` cookie names a `Domain`, or a `Path` other than `/`.
  | HostPrefix

/// What this module raises where it refuses.
pub effect cookie {
  /// The cookie cannot be written as it is.
  raise refused(why: Why)
}

/// The most bytes a name and its value take together.
pub fn max_pair() -> Int = 4096

/// The most bytes an attribute's value takes.
pub fn max_attribute() -> Int = 1024

/// The `Set-Cookie` field's value for `c`, raising `cookie.refused` where `written` answers `Err`.
pub fn render(c: SetCookie) -> String / {cookie.refused} = {
  checked(c);
  let parts = [
    c.name ++ "=" ++ c.value,
    attribute("Max-Age", option_map_text(c.max_age, int_to_string)),
    attribute("Expires", option_map_text(c.expires, date::http_date)),
    attribute("Domain", c.domain),
    attribute("Path", c.path),
    flag("Secure", c.secure),
    flag("HttpOnly", c.http_only),
    "SameSite=" ++ same_site_name(c.same_site),
    flag("Partitioned", c.partitioned),
  ];
  fold(parts, "", |acc: String, part: String|
    if string_len(part) == 0 { acc }
    else if string_len(acc) == 0 { part }
    else { acc ++ "; " ++ part })
}

/// The `Set-Cookie` field's value for `c`, or why it cannot be written.
pub fn written(c: SetCookie) -> Result<String, Why> = try { render(c) }

fn option_map_text<a>(x: Option<a>, f: (a) -> String) -> Option<String> =
  match x { Some(v) -> Some(f(v)), None -> None }

fn attribute(name: String, value: Option<String>) -> String =
  match value { Some(v) -> name ++ "=" ++ v, None -> "" }

fn flag(name: String, on: Bool) -> String = if on { name } else { "" }

/// How `SameSite` writes each.
pub fn same_site_name(s: SameSite) -> String =
  match s { Strict -> "Strict", Lax -> "Lax", Unrestricted -> "None" }

fn checked(c: SetCookie) -> Unit / {cookie.refused} =
  if !is_token(c.name) { cookie.refused(BadName) }
  else if !cookie_octets(c.value) { cookie.refused(BadValue) }
  else if bytes_len(bytes_of_string(c.name ++ c.value)) > max_pair() { cookie.refused(TooLong) }
  else { attributes_checked(c) }

fn attributes_checked(c: SetCookie) -> Unit / {cookie.refused} = {
  match c.domain {
    Some(d) -> if bytes_len(bytes_of_string(d)) > max_attribute() {
      cookie.refused(AttributeTooLong("Domain"))
    } else if !domain_text(d) { cookie.refused(BadDomain) }
    else { () },
    None -> (),
  };
  match c.path {
    Some(p) -> if bytes_len(bytes_of_string(p)) > max_attribute() {
      cookie.refused(AttributeTooLong("Path"))
    } else if !path_text(p) { cookie.refused(BadPath) }
    else { () },
    None -> (),
  };
  prefixes_checked(c)
}

fn prefixes_checked(c: SetCookie) -> Unit / {cookie.refused} =
  if host_prefixed(c.name) {
    if !c.secure { cookie.refused(NeedsSecure("a `__Host-` name")) }
    else if c.domain != None || c.path != Some("/") { cookie.refused(HostPrefix) }
    else { () }
  } else if secure_prefixed(c.name) && !c.secure {
    cookie.refused(NeedsSecure("a `__Secure-` name"))
  } else if c.same_site == Unrestricted && !c.secure {
    cookie.refused(NeedsSecure("`SameSite=None`"))
  } else if c.partitioned && !c.secure { cookie.refused(NeedsSecure("`Partitioned`")) }
  else { () }

fn host_prefixed(name: String) -> Bool = string_starts_with(ascii_lower(name), "__host-")

fn secure_prefixed(name: String) -> Bool = string_starts_with(ascii_lower(name), "__secure-")

/// Whether every byte of `value` is a cookie octet: `!`, `#` to `+`, `-` to `:`, `<` to `[` or `]`
/// to `~`.
fn cookie_octets(value: String) -> Bool = {
  let b = bytes_of_string(value);
  fold(range(0, bytes_len(b)), true, |ok: Bool, i: Int| ok && cookie_octet(bytes_at(b, i)))
}

fn cookie_octet(o: Int) -> Bool =
  o == 0x21 || (o >= 0x23 && o <= 0x2b) || (o >= 0x2d && o <= 0x3a) || (o >= 0x3c && o <= 0x5b)
    || (o >= 0x5d && o <= 0x7e)

/// One or more labels of letters, digits and `-`, a label neither empty nor longer than 63.
fn domain_text(d: String) -> Bool =
  is_ascii(d) && string_len(d) > 0
    && fold(string_split(d, "."), true, |ok: Bool, label: String| ok && label_text(label))

fn label_text(label: String) -> Bool = {
  let b = bytes_of_string(label);
  bytes_len(b) > 0 && bytes_len(b) <= 63
    && fold(range(0, bytes_len(b)), true, |ok: Bool, i: Int| ok && ldh(bytes_at(b, i)))
}

fn ldh(o: Int) -> Bool =
  (o >= 0x30 && o <= 0x39) || (o >= 0x41 && o <= 0x5a) || (o >= 0x61 && o <= 0x7a) || o == 0x2d

fn path_text(p: String) -> Bool = {
  let b = bytes_of_string(p);
  string_starts_with(p, "/")
    && fold(range(0, bytes_len(b)), true, |ok: Bool, i: Int| {
      let o = bytes_at(b, i);
      ok && o >= 0x20 && o != 0x7f && o != 0x3b
    })
}

// --- Reading a Set-Cookie field ---------------------------------------------

/// A `Set-Cookie` field as a client reads it, by RFC 6265bis §5.6: `None` where it holds no
/// cookie, a name and value with no `=`, an empty name, or over 4096 bytes. An attribute that does
/// not read, or whose value is over 1024 bytes, is passed over; of one written twice the last
/// counts. An `Expires` is read as an HTTP date with `now` deciding a two-digit year; a `Path`
/// that does not begin with `/` is no path. An unknown `SameSite` is `Lax`. Nothing is checked
/// against the URL here: that is `store`'s.
pub fn parse_set_cookie(field: String, now: Instant) -> Option<SetCookie> / {abort.raise} = {
  let pieces = string_split(field, ";");
  let first = match list_at(pieces, 0) { Some(p) -> p, None -> "" };
  let b = bytes_of_string(first);
  match bytes_index_of(b, b"=") {
    None -> None,
    Some(at) -> {
      let name = ascii_trim(string_of_bytes_lossy(bytes_slice(b, 0, at)));
      let value = ascii_trim(string_of_bytes_lossy(bytes_slice(b, at + 1, bytes_len(b))));
      if string_len(name) == 0 || bytes_len(bytes_of_string(name ++ value)) > max_pair() { None }
      else {
        let bare = {
          name: name,
          value: value,
          max_age: None,
          expires: None,
          domain: None,
          path: None,
          secure: false,
          http_only: false,
          same_site: Lax,
          partitioned: false,
        };
        Some(
          fold(drop_first(pieces), bare, |c: SetCookie, piece: String|
            with_attribute(c, piece, now)),
        )
      }
    },
  }
}

fn drop_first(xs: List<String>) -> List<String> = match xs { [_, ..rest] -> rest, [] -> [] }

fn with_attribute(c: SetCookie, piece: String, now: Instant) -> SetCookie / {abort.raise} = {
  let b = bytes_of_string(piece);
  let split = match bytes_index_of(b, b"=") {
    Some(at) ->
      {
        name: ascii_lower(ascii_trim(string_of_bytes_lossy(bytes_slice(b, 0, at)))),
        value: ascii_trim(string_of_bytes_lossy(bytes_slice(b, at + 1, bytes_len(b)))),
      },
    None -> { name: ascii_lower(ascii_trim(piece)), value: "" },
  };
  if bytes_len(bytes_of_string(split.value)) > max_attribute() { c }
  else { attribute_read(c, split.name, split.value, now) }
}

fn attribute_read(
  c: SetCookie,
  name: String,
  value: String,
  now: Instant,
) -> SetCookie / {abort.raise} =
  if name == "expires" {
    match date::parse_http_date(value, now) { Some(at) -> { ..c, expires: Some(at) }, None -> c }
  } else if name == "max-age" {
    match max_age_of(value) { Some(n) -> { ..c, max_age: Some(n) }, None -> c }
  } else if name == "domain" {
    if string_len(value) == 0 { c } else {
      // A leading dot is ignored, as RFC 6265bis §5.6.3 says.
      let bare = if string_starts_with(value, ".") { string_slice(value, 1, string_len(value)) }
      else { value };
      { ..c, domain: Some(ascii_lower(bare)) }
    }
  } else if name == "path" {
    { ..c, path: if string_starts_with(value, "/") { Some(value) } else { None } }
  } else { flag_read(c, name, value) }

fn flag_read(c: SetCookie, name: String, value: String) -> SetCookie =
  if name == "secure" { { ..c, secure: true } }
  else if name == "httponly" { { ..c, http_only: true } }
  else if name == "partitioned" { { ..c, partitioned: true } }
  else if name == "samesite" { { ..c, same_site: same_site_of(value) } }
  else { c }

fn same_site_of(value: String) -> SameSite =
  if eq_ignore_ascii_case(value, "strict") { Strict }
  else if eq_ignore_ascii_case(value, "none") { Unrestricted }
  else { Lax }

/// Digits with an optional leading `-`, as RFC 6265bis reads `Max-Age`.
fn max_age_of(value: String) -> Option<Int> / {abort.raise} = {
  let negative = string_starts_with(value, "-");
  let digits = if negative { string_slice(value, 1, string_len(value)) } else { value };
  let b = bytes_of_string(digits);
  if bytes_len(b) == 0 || bytes_len(b) > 18
      || !fold(range(0, bytes_len(b)), true, |ok: Bool, i: Int|
        ok && bytes_at(b, i) >= 0x30 && bytes_at(b, i) <= 0x39) { None } else {
    match int_of_string(digits) { Some(n) -> Some(if negative { 0 - n } else { n }), None -> None }
  }
}

// --- Values signed or sealed -----------------------------------------------

/// `value` as a cookie named `name` carries it with a tag under `key`: its bytes and the tag, each
/// in unpadded base64url, joined by `.`. A client can read it and cannot change it.
pub fn signed(key: Secret<Bytes>, name: String, value: Bytes) -> String / {abort.raise} = {
  let text = base64url_encode(value);
  text ++ "." ++ base64url_encode(hmac_sha256(key, tagged(name, text)))
}

/// What `signed` wrote under `key` for the cookie `name`, or `None`: the tag is not that key's
/// over that name and value, or the text is not what `signed` writes.
pub fn verified(key: Secret<Bytes>, name: String, text: String) -> Option<Bytes> / {abort.raise} = {
  let b = bytes_of_string(text);
  match bytes_index_of(b, b".") {
    None -> None,
    Some(at) -> {
      let body = string_of_bytes_lossy(bytes_slice(b, 0, at));
      let tag = base64url_decode(string_of_bytes_lossy(bytes_slice(b, at + 1, bytes_len(b))));
      match tag {
        Some(t) -> if tags_match(t, hmac_sha256(key, tagged(name, body))) { base64url_decode(body) }
        else { None },
        None -> None,
      }
    },
  }
}

fn tagged(name: String, body: String) -> Bytes = bytes_of_string(name ++ "=" ++ body)

/// `value` sealed under `key` for the cookie `name`, in unpadded base64url: a client can neither
/// read it nor change it, and a value sealed for one name does not open under another.
pub fn sealed(key: SealKey, name: String, value: Bytes) -> String / {entropy.next, abort.raise} =
  base64url_encode(crypto::seal(key, value, bytes_of_string(name)))

/// `sealed` under the nonce it is handed, which is what a test runs.
pub fn sealed_under(
  key: SealKey,
  nonce: Bytes,
  name: String,
  value: Bytes,
) -> String / {abort.raise} =
  base64url_encode(crypto::seal_under(key, nonce, value, bytes_of_string(name)))

/// What `sealed` sealed under `key` for the cookie `name`, or `None`.
pub fn opened(key: SealKey, name: String, text: String) -> Option<Bytes> / {abort.raise} =
  match base64url_decode(text) {
    Some(b) -> crypto::open(key, b, bytes_of_string(name)),
    None -> None,
  }

// --- The jar ----------------------------------------------------------------

/// A cookie a jar holds, as RFC 6265bis §5.7 stores one: the host or domain it goes back to, the
/// path under which it does, when it expires from the epoch (`None` for one that lasts the session)
/// and the order it was first set in.
pub type Stored = {
  name: String,
  value: String,
  domain: String,
  host_only: Bool,
  path: String,
  expires: Option<Instant>,
  secure: Bool,
  http_only: Bool,
  same_site: SameSite,
  created: Int,
}

/// A client's cookies, and the most it keeps: past that the oldest goes first.
pub type Jar = new { cookies: List<Stored>, made: Int, most: Int }

/// A jar that holds no cookie and keeps at most `most`.
pub fn jar(most: Int) -> Jar = { cookies: [], made: 0, most: max(most, 0) }

/// The cookies `j` holds, in the order they were first set.
pub fn held(j: Jar) -> List<Stored> = j.cookies

/// `j` with what each `Set-Cookie` field of a response from `from` sets, at `now`. A field that
/// does not read, or that sets a cookie `from` may not set, is passed over: a `Domain` `from`'s
/// host is not in, or of one label; a `Secure` cookie, or one that would replace one, over
/// `http`; a prefixed name its attributes do not keep to; `SameSite=None` without `Secure`. A
/// cookie that has expired removes the one it names.
pub fn store(j: Jar, from: Url, fields: List<String>, now: Instant) -> Jar / {abort.raise} =
  fold(fields, j, |kept: Jar, field: String|
    match parse_set_cookie(field, now) {
      Some(c) -> match admitted(kept, from, c, now) {
        Some(s) -> placed(kept, s, now),
        None -> kept,
      },
      None -> kept,
    })

/// The `Cookie` field a request to `to` carries at `now`, or `None` where no cookie goes there.
pub fn header_for(j: Jar, to: Url, now: Instant) -> Option<String> / {abort.raise} =
  match sent_to(j, to, now) {
    [] -> None,
    sent ->
      Some(
        fold(sent, "", |acc: String, p: Pair|
          if string_len(acc) == 0 { p.name ++ "=" ++ p.value }
          else { acc ++ "; " ++ p.name ++ "=" ++ p.value }),
      ),
  }

/// The cookies a request to `to` carries at `now`, the longer paths first and of equal paths the
/// older first, as RFC 6265bis §5.8.3 orders them.
pub fn sent_to(j: Jar, to: Url, now: Instant) -> List<Pair> / {abort.raise} = {
  let host = host_of(to);
  let secure = secure_scheme(to);
  let path = request_path(to);
  let going = filter(j.cookies, |s: Stored|
    live(s, now) && domain_goes(s, host) && path_matches(path, s.path) && (secure || !s.secure));
  map(
    sort_by(going, |a: Stored, b: Stored|
      string_len(a.path) > string_len(b.path)
        || (string_len(a.path) == string_len(b.path) && a.created < b.created)),
    |s: Stored| { name: s.name, value: s.value },
  )
}

/// `j` without the cookies that have expired at `now`.
pub fn expired_removed(j: Jar, now: Instant) -> Jar =
  { ..j, cookies: filter(j.cookies, |s: Stored| live(s, now)) }

fn live(s: Stored, now: Instant) -> Bool =
  match s.expires { Some(at) -> nanos_at(at) > nanos_at(now), None -> true }

fn host_of(u: Url) -> String =
  match url_host(u) {
    Some(url::Name(name)) -> ascii_lower(name),
    Some(url::V4(four)) -> ip::render(ip::V4(four)),
    Some(url::V6(six)) -> ip::render(ip::V6(six)),
    None -> "",
  }

fn host_is_address(u: Url) -> Bool =
  match url_host(u) { Some(url::Name(_)) -> false, Some(_) -> true, None -> false }

fn secure_scheme(u: Url) -> Bool = url_scheme(u) == "https" || url_scheme(u) == "wss"

fn request_path(u: Url) -> String = if string_len(url_path(u)) == 0 { "/" } else { url_path(u) }

/// RFC 6265bis §5.1.4's default path: the request path up to its last `/`, or `/`.
fn default_path(u: Url) -> String / {abort.raise} = {
  let p = request_path(u);
  if !string_starts_with(p, "/") { "/" } else {
    let b = bytes_of_string(p);
    let last = fold(range(0, bytes_len(b)), 0, |at: Int, i: Int|
      if bytes_at(b, i) == 0x2f { i } else { at });
    if last == 0 { "/" } else { string_of_bytes_lossy(bytes_slice(b, 0, last)) }
  }
}

fn domain_goes(s: Stored, host: String) -> Bool =
  if s.host_only { host == s.domain } else { domain_matches(host, s.domain) }

/// Whether `host` is `domain`, or a name below it.
fn domain_matches(host: String, domain: String) -> Bool =
  host == domain || string_ends_with(host, "." ++ domain)

/// RFC 6265bis §5.1.4: the path is the cookie's, or below it at a `/`.
fn path_matches(path: String, cookie_path: String) -> Bool / {abort.raise} =
  path == cookie_path
    || (string_starts_with(path, cookie_path)
    && (string_ends_with(cookie_path, "/")
    || string_slice(path, string_len(cookie_path), string_len(cookie_path) + 1) == "/"))

/// What `c`, set by a response from `from`, is stored as, or `None` where it may not be.
fn admitted(j: Jar, from: Url, c: SetCookie, now: Instant) -> Option<Stored> / {abort.raise} = {
  let host = host_of(from);
  let secure = secure_scheme(from);
  let place = match c.domain {
    None -> Some({ domain: host, host_only: true }),
    Some(d) -> if host_is_address(from) {
      if d == host { Some({ domain: host, host_only: true }) } else { None }
    } else if !string_contains(d, ".") && d != host { None }
    else if domain_matches(host, d) { Some({ domain: d, host_only: false }) }
    else { None },
  };
  let path = match c.path { Some(p) -> p, None -> default_path(from) };
  let refused = string_len(host) == 0 || (c.secure && !secure)
    || (host_prefixed(c.name) && (!c.secure || c.domain != None || path != "/"))
    || (secure_prefixed(c.name) && !c.secure)
    || (c.same_site == Unrestricted && !c.secure)
    || (!secure && shadows_secure(j, c.name, host, path));
  match place {
    None -> None,
    Some(at) -> if refused { None } else {
      Some({
        name: c.name,
        value: c.value,
        domain: at.domain,
        host_only: at.host_only,
        path: path,
        expires: expiry(c, now),
        secure: c.secure,
        http_only: c.http_only,
        same_site: c.same_site,
        created: j.made,
      })
    },
  }
}

/// Whether a `Secure` cookie of this name is held where a cookie set over `http` would replace it.
fn shadows_secure(j: Jar, name: String, host: String, path: String) -> Bool / {abort.raise} =
  any(j.cookies, |s: Stored|
    s.secure && s.name == name && (domain_matches(s.domain, host) || domain_matches(host, s.domain))
      && path_matches(path, s.path))

/// `Max-Age` wins over `Expires`; zero or less is the earliest instant there is.
fn expiry(c: SetCookie, now: Instant) -> Option<Instant> =
  match c.max_age {
    Some(n) -> Some(if n <= 0 { Instant(0) } else { after(now, seconds(n)) }),
    None -> match c.expires { Some(at) -> Some(date_instant(at)), None -> None },
  }

fn date_instant(at: OffsetDateTime) -> Instant =
  match date::instant(at) { Some(i) -> i, None -> Instant(0) }

/// `j` with `s` in place of the cookie of its name, domain and path, which keeps its place in
/// the order; an expired `s` only removes that one.
fn placed(j: Jar, s: Stored, now: Instant) -> Jar = {
  let same = |t: Stored| t.name == s.name && t.domain == s.domain && t.path == s.path;
  let before = filter(j.cookies, |t: Stored| same(t));
  let others = filter(j.cookies, |t: Stored| !same(t));
  if !live(s, now) { { ..j, cookies: others } } else {
    let kept = match before { [old, ..] -> { ..s, created: old.created }, [] -> s };
    let all = sort_by(
      push(filter(others, |t: Stored| live(t, now)), kept),
      |a: Stored, b: Stored| a.created < b.created,
    );
    let over = len(all) - j.most;
    { cookies: if over > 0 { drop_oldest(all, over) } else { all }, made: j.made + 1, most: j.most }
  }
}

fn drop_oldest(xs: List<Stored>, n: Int) -> List<Stored> =
  match xs { [_, ..rest] -> if n <= 0 { xs } else { drop_oldest(rest, n - 1) }, [] -> [] }

// --- Tests ------------------------------------------------------------------

test "a Cookie field's pairs are read in order, past what does not read" {
  assert_eq(pairs("a=1; b=\"two\";c=3;=4; broken; d e=5;f="), [
    { name: "a", value: "1" },
    { name: "b", value: "two" },
    { name: "c", value: "3" },
    { name: "f", value: "" },
  ]);
  let found = pairs_of(["a=1", "a=2; b=3"]);
  assert_eq(get(found, "a"), Some("1"));
  assert_eq(get(found, "b"), Some("3"));
  assert_eq(get(found, "B"), None)
}

test "a cookie set by default is secure, out of scripts' reach and lax" {
  assert_eq(
    written(set_cookie("session", "abc123")),
    Ok("session=abc123; Path=/; Secure; HttpOnly; SameSite=Lax"),
  );
  let every = {
    ..set_cookie("id", "7"),
    max_age: Some(3600),
    expires: date::of_unix_seconds(1700000000),
    domain: Some("example.com"),
    same_site: Unrestricted,
    partitioned: true,
  };
  assert_eq(
    written(every),
    Ok(
      "id=7; Max-Age=3600; Expires=Tue, 14 Nov 2023 22:13:20 GMT; Domain=example.com; Path=/; Secure; HttpOnly; SameSite=None; Partitioned",
    ),
  );
  assert_eq(
    written(removal(set_cookie("id", "7"))),
    Ok(
      "id=; Max-Age=0; Expires=Thu, 01 Jan 1970 00:00:00 GMT; Path=/; Secure; HttpOnly; SameSite=Lax",
    ),
  )
}

test "a cookie that cannot be written is refused: {c.what}" for c: { what: String, cookie: SetCookie, why: Why } in [
    { what: "a name with a space", cookie: set_cookie("a b", "1"), why: BadName },
    { what: "a value with a semicolon", cookie: set_cookie("a", "1;2"), why: BadValue },
    { what: "a value with a space", cookie: set_cookie("a", "1 2"), why: BadValue },
    {
      what: "a domain of an empty label",
      cookie: { ..set_cookie("a", "1"), domain: Some("a..b") },
      why: BadDomain,
    },
    {
      what: "a path not from the root",
      cookie: { ..set_cookie("a", "1"), path: Some("x") },
      why: BadPath,
    },
    {
      what: "a path that ends the field",
      cookie: { ..set_cookie("a", "1"), path: Some("/a;b") },
      why: BadPath,
    },
    {
      what: "a `__Secure-` cookie over http",
      cookie: { ..set_cookie("__Secure-a", "1"), secure: false },
      why: NeedsSecure("a `__Secure-` name"),
    },
    {
      what: "a `__Host-` cookie that names a domain",
      cookie: { ..set_cookie("__Host-a", "1"), domain: Some("example.com") },
      why: HostPrefix,
    },
    {
      what: "a `__host-` cookie under a path",
      cookie: { ..set_cookie("__host-a", "1"), path: Some("/app") },
      why: HostPrefix,
    },
    {
      what: "`SameSite=None` over http",
      cookie: { ..set_cookie("a", "1"), secure: false, same_site: Unrestricted },
      why: NeedsSecure("`SameSite=None`"),
    },
    {
      what: "`Partitioned` over http",
      cookie: { ..set_cookie("a", "1"), secure: false, partitioned: true },
      why: NeedsSecure("`Partitioned`"),
    },
  ] { assert_eq(written(c.cookie), Err(c.why)) }

test "a name and value over 4096 bytes, or an attribute over 1024, is refused" {
  let long = |n: Int| fold(range(0, n), "", |acc: String, _i: Int| acc ++ "x");
  assert_eq(written(set_cookie("a", long(4096))), Err(TooLong));
  assert(written(set_cookie("a", long(4095))) != Err(TooLong));
  assert_eq(
    written({ ..set_cookie("a", "1"), path: Some("/" ++ long(1024)) }),
    Err(AttributeTooLong("Path")),
  )
}

test "a Set-Cookie field is read as a client reads one" {
  let now = today();
  assert_eq(
    parse_set_cookie(
      "id=7; Path=/a; Domain=.Example.COM; Max-Age=60; Secure; HttpOnly; SameSite=strict; Partitioned; Bogus",
      now,
    ),
    Some({
      name: "id",
      value: "7",
      max_age: Some(60),
      expires: None,
      domain: Some("example.com"),
      path: Some("/a"),
      secure: true,
      http_only: true,
      same_site: Strict,
      partitioned: true,
    }),
  );
  let loose = parse_set_cookie(
    "x=1; path=relative; samesite=sideways; max-age=1e3; expires=never",
    now,
  );
  assert_eq(
    loose,
    Some({
      name: "x",
      value: "1",
      max_age: None,
      expires: None,
      domain: None,
      path: None,
      secure: false,
      http_only: false,
      same_site: Lax,
      partitioned: false,
    }),
  );
  assert_eq(parse_set_cookie("no equals sign", now), None);
  assert_eq(parse_set_cookie("=1", now), None)
}

test "a signed value is read back under its key and name, and under nothing else" {
  let key = secret_of_bytes(b"0123456789abcdef0123456789abcdef");
  let other = secret_of_bytes(b"fedcba9876543210fedcba9876543210");
  let text = signed(key, "cart", b"3 bolts");
  assert_eq(verified(key, "cart", text), Some(b"3 bolts"));
  assert_eq(verified(other, "cart", text), None);
  assert_eq(verified(key, "basket", text), None);
  assert_eq(verified(key, "cart", signed(key, "cart", b"4 bolts") ++ "x"), None);
  assert_eq(verified(key, "cart", "no dot here"), None);
  assert(cookie_octets(text))
}

test "a sealed value opens under its key and name, and is no value to read" {
  match crypto::seal_key(secret_of_bytes(b"0123456789abcdef0123456789abcdef")) {
    None -> panic("a key of 32 bytes"),
    Some(key) -> {
      let nonce = b"abcdefghijklmnopqrstuvwx";
      let text = sealed_under(key, nonce, "cart", b"3 bolts");
      assert_eq(opened(key, "cart", text), Some(b"3 bolts"));
      assert_eq(opened(key, "basket", text), None);
      assert(!string_contains(text, base64url_encode(b"3 bolts")));
      assert(cookie_octets(text))
    },
  }
}

fn today() -> Instant = after(Instant(0), seconds(1700000000))

test "a jar sends a cookie back where it was set, and no further" {
  let set = store(
    jar(50),
    url"https://shop.example.com/cart/add",
    [
      "host=1",
      "wide=2; Domain=example.com; Path=/",
      "deep=3; Path=/cart/items",
      "safe=4; Secure; Path=/",
    ],
    today(),
  );
  assert_eq(
    header_for(set, url"https://shop.example.com/cart/items/9", today()),
    Some("deep=3; host=1; wide=2; safe=4"),
  );
  assert_eq(header_for(set, url"https://api.example.com/", today()), Some("wide=2"));
  assert_eq(header_for(set, url"http://shop.example.com/", today()), Some("wide=2"));
  assert_eq(header_for(set, url"https://example.org/", today()), None);
  assert_eq(
    header_for(set, url"https://shop.example.com/cartography", today()),
    Some("wide=2; safe=4"),
  )
}

test "a jar refuses what a response may not set: {c.what}" for c: { what: String, from: Url, field: String } in [
    {
      what: "a domain the host is not in",
      from: url"https://a.example.com/",
      field: "x=1; Domain=example.org",
    },
    { what: "a domain of one label", from: url"https://example/", field: "x=1; Domain=com" },
    { what: "a secure cookie over http", from: url"http://example.com/", field: "x=1; Secure" },
    {
      what: "a `__Host-` cookie with a domain",
      from: url"https://example.com/",
      field: "__Host-x=1; Secure; Path=/; Domain=example.com",
    },
    {
      what: "a `__Host-` cookie under a path",
      from: url"https://example.com/",
      field: "__Host-x=1; Secure; Path=/a",
    },
    {
      what: "a `__Secure-` cookie without Secure",
      from: url"https://example.com/",
      field: "__Secure-x=1",
    },
    {
      what: "`SameSite=None` without Secure",
      from: url"https://example.com/",
      field: "x=1; SameSite=None",
    },
    { what: "a domain on an address", from: url"https://192.0.2.1/", field: "x=1; Domain=0.2.1" },
  ] { assert_eq(held(store(jar(50), c.from, [c.field], today())), []) }

test "an http response replaces no secure cookie, and an expired one removes its namesake" {
  let secure = store(jar(50), url"https://example.com/", ["id=s; Secure; Path=/"], today());
  let shadowed = store(secure, url"http://example.com/", ["id=plain; Path=/"], today());
  assert_eq(header_for(shadowed, url"https://example.com/", today()), Some("id=s"));
  let gone = store(secure, url"https://example.com/", ["id=; Secure; Path=/; Max-Age=0"], today());
  assert_eq(held(gone), []);
  let later = store(secure, url"https://example.com/", ["t=1; Max-Age=10"], today());
  assert_eq(
    header_for(later, url"https://example.com/", after(today(), seconds(11))),
    Some("id=s"),
  );
  let dated = store(
    jar(50),
    url"https://example.com/",
    [
      "old=1; Expires=Thu, 01 Jan 1970 00:00:00 GMT",
      "new=2; Expires=Wed, 01 Jan 2031 00:00:00 GMT",
    ],
    today(),
  );
  assert_eq(header_for(dated, url"https://example.com/", today()), Some("new=2"))
}

test "a jar keeps at most its bound, the oldest going first" {
  let full = store(jar(2), url"https://example.com/", ["a=1", "b=2", "c=3"], today());
  assert_eq(map(held(full), |s: Stored| s.name), ["b", "c"]);
  let replaced = store(full, url"https://example.com/", ["b=9"], today());
  assert_eq(header_for(replaced, url"https://example.com/", today()), Some("b=9; c=3"))
}

fn named(n: Int) -> String = "c" ++ int_to_string(abs(n % 1000))

law "a cookie a response sets is sent back to where it was set"
  forall (n: Int, v: Int) {
    let u = url"https://example.com/a/b";
    let j = store(jar(50), u, [named(n) ++ "=" ++ int_to_string(abs(v % 1000000))], today());
    header_for(j, u, today()) == Some(named(n) ++ "=" ++ int_to_string(abs(v % 1000000)))
  }

law "a cookie set for its own host is never sent to another"
  forall (n: Int, v: Int) {
    let j = store(
      jar(50),
      url"https://a.example.com/",
      [named(n) ++ "=" ++ int_to_string(v)],
      today(),
    );
    header_for(j, url"https://b.example.com/", today()) == None
      && header_for(j, url"https://example.com/", today()) == None
  }

law "storing a field twice holds what storing it once does"
  forall (n: Int, v: Int) {
    let u = url"https://example.com/";
    let field = named(n) ++ "=" ++ int_to_string(v);
    let once = store(jar(50), u, [field], today());
    held(store(once, u, [field], today())) == held(once)
  }

law "a jar holds no more than its bound"
  forall (most: Int, ns: List<Int>) {
    let j = store(
      jar(abs(most % 8)),
      url"https://example.com/",
      map(ns, |n: Int| named(n) ++ "=1"),
      today(),
    );
    len(held(j)) <= abs(most % 8)
  }

law "a value read back from what signing wrote is the value"
  forall (b: Bytes) {
    let key = secret_of_bytes(b"0123456789abcdef0123456789abcdef");
    verified(key, "k", signed(key, "k", b)) == Some(b)
  }
