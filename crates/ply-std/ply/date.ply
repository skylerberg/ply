    "1996-12-19T16:39:57-08:00[America/]",
    "1996-12-19T16:39:57-08:00[..]",
    "1996-12-19T16:39:57-08:00[America/./Los_Angeles]",
    "1996-12-19T16:39:57-08:00[9to5]",
    "1996-12-19T16:39:57-08:00[-08]",
    "1996-12-19T16:39:57-08:00[U-CA=hebrew]",
    "1996-12-19T16:39:57-08:00[u-ca=]",
