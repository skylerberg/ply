//! A set: elements of one ordered type, each held once, in their order.
//!
//! The set literal `#[a, b]` builds a `Set`, and `show` writes one back as that literal. The order
//! is the elements' `compare` order: `==`, `compare`, `digest` and `elements` answer alike however
//! the elements went in. A signature that names `Set<a>` is held to `derivable(ord, a)` without
//! writing it. `map`, `filter`, `fold`, `min` and `max` are also the prelude's names for a list, so
//! qualify them: `set::map(s, f)`. A module that writes a set literal imports this one itself,
//! under a name no source can write, so this module writes none.
//!
//! An update of a set held once is made in place, as one of its map would be. The two-set
//! operations walk the smaller set and ask the larger, so each takes as many steps as the smaller
//! holds. `min`, `max` and `between` read one path of the set's tree, however much it holds.

import std.gen
import std.gen (Gen)
import std.laws (agrees, inverse, monoid)
import std.list
import std.map
import std.map (Bound, Excluded, Included, Unbounded)
import std.show
import std.string (join)
import std.value (render_all)

/// A set of `a`, which the literal `#[a, b]` writes.
pub opaque type Set<a> = | Set(Map<a, Unit>)

key for Set by items

show for Set by written

gen for Set by sets

/// The map a set is, each element a key whose value is `()`: what `==`, `compare` and `digest`
/// read of it.
fn items<a>(s: Set<a>) -> Map<a, Unit> = match s { Set(m) -> m }

/// The literal that builds the set, each element as `show` writes it.
fn written<a>(s: Set<a>) -> String =
  "#["
    ++ join(
      map_fold(items(s), [], |acc: List<String>, x: a, _: Unit| push(acc, render_all(shown(x)))),
      ", ",
    )
    ++ "]"

/// Sets of up to eight of what `g` draws.
fn sets<a>(g: Gen<a>) -> Gen<Set<a>> = gen::map(gen::list_of(g, 8), of_list)

/// The set with nothing in it.
pub fn empty<a>() -> Set<a> = Set(map_new())

/// Whether the set holds nothing.
pub fn is_empty<a>(s: Set<a>) -> Bool = map_len(items(s)) == 0

/// How many elements the set holds.
pub fn size<a>(s: Set<a>) -> Int = map_len(items(s))

/// Whether `x` is in the set.
pub fn contains<a>(s: Set<a>, x: a) -> Bool = map_contains(items(s), x)

/// `s` with `x` in it; one already there is the set itself.
pub fn insert<a>(s: Set<a>, x: a) -> Set<a> = match s { Set(m) -> Set(map_insert(m, x, ())) }

/// `s` without `x`; removing one that is absent is the set itself.
pub fn remove<a>(s: Set<a>, x: a) -> Set<a> = match s { Set(m) -> Set(map_remove(m, x)) }

/// The elements, in order.
pub fn elements<a>(s: Set<a>) -> List<a> = map_keys(items(s))

/// The set of the elements of `xs`.
pub fn of_list<a>(xs: List<a>) -> Set<a> = Set(with_from(map_new(), xs, 0))

fn with_from<a>(m: Map<a, Unit>, xs: List<a>, i: Int) -> Map<a, Unit>
  where derivable(ord, a)
= match list_at(xs, i) { Some(x) -> with_from(map_insert(m, x, ()), xs, i + 1), None -> m }

/// The least element, or `None` of the empty set.
pub fn min<a>(s: Set<a>) -> Option<a> =
  match map_first(items(s)) { Some(least) -> Some(least.key), None -> None }

/// The greatest element, or `None` of the empty set.
pub fn max<a>(s: Set<a>) -> Option<a> =
  match map_last(items(s)) { Some(greatest) -> Some(greatest.key), None -> None }

/// The elements from `lo` to `hi`, each end counted or left out as its bound says: a set that
/// shares what it can with `s`.
pub fn between<a>(s: Set<a>, lo: Bound<a>, hi: Bound<a>) -> Set<a> =
  Set(map::between(items(s), lo, hi))

/// `step` over the elements in order, each handed what the last one answered, from `init`.
pub fn fold<a, b | e>(s: Set<a>, init: b, step: (b, a) -> b / e cost k) -> b / e =
  folded(items(s), init, step)

fn folded<a, b | e>(m: Map<a, Unit>, init: b, step: (b, a) -> b / e cost k) -> b / e
  where derivable(ord, a)
  cost map_len(m) * k
= map_fold(m, init, |acc: b, x: a, _: Unit| step(acc, x))

/// The set of what `f` answers for each element, which is smaller than `s` where `f` answers two of
/// them alike.
pub fn map<a, b | e>(s: Set<a>, f: (a) -> b / e cost k) -> Set<b> / e = Set(mapped(items(s), f))

fn mapped<a, b | e>(m: Map<a, Unit>, f: (a) -> b / e cost k) -> Map<b, Unit> / e
  where derivable(ord, a), derivable(ord, b)
  cost map_len(m) * k
= map_fold(m, map_new(), |acc: Map<b, Unit>, x: a, _: Unit| map_insert(acc, f(x), ()))

/// The elements `keep` answers true for.
pub fn filter<a | e>(s: Set<a>, keep: (a) -> Bool / e cost k) -> Set<a> / e =
  Set(kept(items(s), keep))

fn kept<a | e>(m: Map<a, Unit>, keep: (a) -> Bool / e cost k) -> Map<a, Unit> / e
  where derivable(ord, a)
  cost map_len(m) * k
=
  map_fold(m, map_new(), |acc: Map<a, Unit>, x: a, _: Unit|
    if keep(x) { map_insert(acc, x, ()) } else { acc })

/// The elements `ok` answers true for, and the rest; `ok` is asked once of each.
pub fn partition<a | e>(s: Set<a>, ok: (a) -> Bool / e cost k) -> { yes: Set<a>, no: Set<a> } / e = {
  let split = parted(items(s), ok);
  { yes: Set(split.yes), no: Set(split.no) }
}

fn parted<a | e>(
  m: Map<a, Unit>,
  ok: (a) -> Bool / e cost k,
) -> { yes: Map<a, Unit>, no: Map<a, Unit> } / e
  where derivable(ord, a)
  cost map_len(m) * k
=
  map_fold(
    m,
    { yes: map_new(), no: map_new() },
    |acc: { yes: Map<a, Unit>, no: Map<a, Unit> }, x: a, _: Unit| {
      let yes = acc.yes;
      let no = acc.no;
      if ok(x) { { yes: map_insert(yes, x, ()), no: no } }
      else { { yes: yes, no: map_insert(no, x, ()) } }
    },
  )

/// Whether `ok` answers true for an element, asked in order until one does. The empty set is `false`.
pub fn any<a | e>(s: Set<a>, ok: (a) -> Bool / e cost k) -> Bool / e = any_in(items(s), ok)

fn any_in<a | e>(m: Map<a, Unit>, ok: (a) -> Bool / e cost k) -> Bool / e
  where derivable(ord, a)
  cost map_len(m) * k
= map_fold(m, false, |found: Bool, x: a, _: Unit| found || ok(x))

/// Whether `ok` answers true for every element, asked in order until one does not. The empty set is
/// `true`.
pub fn all<a | e>(s: Set<a>, ok: (a) -> Bool / e cost k) -> Bool / e = all_in(items(s), ok)

fn all_in<a | e>(m: Map<a, Unit>, ok: (a) -> Bool / e cost k) -> Bool / e
  where derivable(ord, a)
  cost map_len(m) * k
= map_fold(m, true, |held: Bool, x: a, _: Unit| held && ok(x))

/// Whether every element of `xs` is in the set, which an empty `xs` is.
pub fn contains_all<a>(s: Set<a>, xs: List<a>) -> Bool = {
  let m = items(s);
  list::all(xs, |x: a| map_contains(m, x))
}

/// Whether no element of `xs` is in the set, which an empty `xs` is.
pub fn contains_none<a>(s: Set<a>, xs: List<a>) -> Bool = {
  let m = items(s);
  list::all(xs, |x: a| !map_contains(m, x))
}

/// Everything in either set.
pub fn union<a>(a: Set<a>, b: Set<a>) -> Set<a> = {
  let x = items(a);
  let y = items(b);
  Set(if map_len(x) < map_len(y) { map_merge(y, x) } else { map_merge(x, y) })
}

/// Everything in any of the sets.
pub fn unions<a>(sets: List<Set<a>>) -> Set<a> = unions_from(empty(), sets, 0)

fn unions_from<a>(acc: Set<a>, sets: List<Set<a>>, i: Int) -> Set<a> =
  match list_at(sets, i) { Some(s) -> unions_from(union(acc, s), sets, i + 1), None -> acc }

/// The elements in both sets.
pub fn intersection<a>(a: Set<a>, b: Set<a>) -> Set<a> = Set(shared(items(a), items(b)))

/// The elements the two maps share, walking the smaller and asking the larger.
fn shared<a>(x: Map<a, Unit>, y: Map<a, Unit>) -> Map<a, Unit>
  where derivable(ord, a)
  cost map_len(x) + map_len(y)
= if map_len(x) <= map_len(y) { kept_in(x, y) } else { kept_in(y, x) }

/// The keys of `walked` that `asked` holds too.
fn kept_in<a>(walked: Map<a, Unit>, asked: Map<a, Unit>) -> Map<a, Unit>
  where derivable(ord, a)
=
  map_fold(walked, map_new(), |acc: Map<a, Unit>, x: a, _: Unit|
    if map_contains(asked, x) { map_insert(acc, x, ()) } else { acc })

/// The elements of `a` that are not in `b`.
pub fn difference<a>(a: Set<a>, b: Set<a>) -> Set<a> = Set(without(items(a), items(b)))

/// The keys of `x` that `y` does not hold, walking whichever is smaller.
fn without<a>(x: Map<a, Unit>, y: Map<a, Unit>) -> Map<a, Unit>
  where derivable(ord, a)
  cost map_len(x) + map_len(y)
=
  if map_len(y) < map_len(x) {
    map_fold(y, x, |acc: Map<a, Unit>, k: a, _: Unit| map_remove(acc, k))
  } else {
    map_fold(x, map_new(), |acc: Map<a, Unit>, k: a, _: Unit|
      if map_contains(y, k) { acc } else { map_insert(acc, k, ()) })
  }

/// The elements in exactly one of the two sets.
pub fn symmetric_difference<a>(a: Set<a>, b: Set<a>) -> Set<a> =
  Set(either_alone(items(a), items(b)))

fn either_alone<a>(x: Map<a, Unit>, y: Map<a, Unit>) -> Map<a, Unit>
  where derivable(ord, a)
  cost map_len(x) + map_len(y)
= {
  let left = without(x, y);
  let right = without(y, x);
  if map_len(left) < map_len(right) { map_merge(right, left) } else { map_merge(left, right) }
}

/// Whether every element of `a` is in `b`. The empty set is a subset of everything.
pub fn is_subset<a>(a: Set<a>, b: Set<a>) -> Bool = within(items(a), items(b))

fn within<a>(x: Map<a, Unit>, y: Map<a, Unit>) -> Bool
  where derivable(ord, a)
  cost map_len(x)
=
  map_len(x) <= map_len(y)
    && map_fold(x, true, |held: Bool, k: a, _: Unit| held && map_contains(y, k))

/// Whether every element of `b` is in `a`.
pub fn is_superset<a>(a: Set<a>, b: Set<a>) -> Bool = is_subset(b, a)

/// Whether the two sets share no element, which the empty set does with every set.
pub fn is_disjoint<a>(a: Set<a>, b: Set<a>) -> Bool = apart(items(a), items(b))

fn apart<a>(x: Map<a, Unit>, y: Map<a, Unit>) -> Bool
  where derivable(ord, a)
  cost map_len(x) + map_len(y)
= if map_len(x) <= map_len(y) { missing_from(x, y) } else { missing_from(y, x) }

/// Whether `asked` holds no key of `walked`.
fn missing_from<a>(walked: Map<a, Unit>, asked: Map<a, Unit>) -> Bool
  where derivable(ord, a)
= map_fold(walked, true, |held: Bool, k: a, _: Unit| held && !map_contains(asked, k))

// --- Tests ------------------------------------------------------------------

test "a set's elements come back in order, each once" {
  let s = of_list([3, 1, 2, 1]);
  assert_eq(s, of_list([1, 2, 3]));
  assert_eq(size(s), 3);
  assert(!is_empty(s));
  assert(is_empty(empty()));
  assert(contains(s, 2));
  assert(!contains(s, 9));
  assert_eq(elements(s), [1, 2, 3]);
  assert_eq(elements(of_list(["b", "a", "b"])), ["a", "b"])
}

test "a set is shown as the literal that builds it" {
  assert_eq(written(of_list([3, 1, 2])), "#[1, 2, 3]");
  assert_eq(written(of_list(["b", "a"])), "#[\"a\", \"b\"]");
  assert_eq(written(empty()), "#[]");
  assert_eq(written(of_list([of_list([2]), of_list([])])), "#[#[], #[2]]")
}

test "insert and remove are idempotent, and union is the two of them" {
  let s = insert(empty(), 1);
  assert_eq(insert(s, 1), of_list([1]));
  assert_eq(remove(s, 1), empty());
  assert_eq(remove(s, 9), of_list([1]));
  assert_eq(union(of_list([1, 2]), of_list([2, 3])), of_list([1, 2, 3]));
  assert_eq(
    unions([of_list([1]), of_list([3, 4]), empty(), of_list([1, 2])]),
    of_list([1, 2, 3, 4]),
  );
  let none: List<Set<Int>> = [];
  assert_eq(unions(none), empty());
  assert(contains_all(of_list([1, 2, 3]), [1, 3]));
  assert(contains_all(of_list([1]), []));
  assert(!contains_all(of_list([1, 2]), [1, 9]));
  assert(contains_none(of_list([1, 2]), [8, 9]));
  assert(contains_none(of_list([1, 2]), []));
  assert(!contains_none(of_list([1, 2]), [1]))
}

test "the two-set operations answer what is shared and what is not" {
  let a = of_list([1, 2, 3]);
  let b = of_list([3, 4]);
  assert_eq(intersection(a, b), of_list([3]));
  assert_eq(intersection(a, empty()), empty());
  assert_eq(difference(a, b), of_list([1, 2]));
  assert_eq(difference(b, a), of_list([4]));
  assert_eq(difference(a, a), empty());
  assert_eq(symmetric_difference(a, b), of_list([1, 2, 4]));
  assert_eq(symmetric_difference(a, a), empty());
  assert(is_subset(of_list([1, 2]), a));
  assert(is_subset(empty(), a));
  assert(!is_subset(b, a));
  assert(is_superset(a, of_list([1])));
  assert(!is_superset(a, b));
  assert(is_disjoint(of_list([1, 2]), of_list([3])));
  assert(is_disjoint(a, empty()));
  assert(!is_disjoint(a, b))
}

test "map may shrink the set, filter keeps what it is told to and partition splits it" {
  let s = of_list([1, 2, 3, 4, 5]);
  assert_eq(map(s, |x: Int| x * 10), of_list([10, 20, 30, 40, 50]));
  assert_eq(map(s, |x: Int| x % 2), of_list([0, 1]));
  assert_eq(map(s, |x: Int| int_to_string(x)), of_list(["1", "2", "3", "4", "5"]));
  assert_eq(filter(s, |x: Int| x > 3), of_list([4, 5]));
  assert_eq(filter(s, |x: Int| x > 9), empty());
  assert_eq(partition(s, |x: Int| x % 2 == 0), { yes: of_list([2, 4]), no: of_list([1, 3, 5]) })
}

test "min and max are the ends of the order, and the empty set has neither" {
  assert_eq(min(of_list([3, 1, 2])), Some(1));
  assert_eq(max(of_list([3, 1, 2])), Some(3));
  assert_eq(min(of_list(["b", "a"])), Some("a"));
  let none: Set<Int> = empty();
  assert_eq(min(none), None);
  assert_eq(max(none), None)
}

test "between holds the elements within its bounds, an end counted or not as the bound says" {
  let s = of_list([1, 3, 5, 7, 9]);
  assert_eq(between(s, Included(3), Included(7)), of_list([3, 5, 7]));
  assert_eq(between(s, Excluded(3), Excluded(7)), of_list([5]));
  assert_eq(between(s, Included(4), Unbounded), of_list([5, 7, 9]));
  assert_eq(between(s, Unbounded, Excluded(5)), of_list([1, 3]));
  assert_eq(between(s, Unbounded, Unbounded), s);
  assert_eq(between(s, Included(8), Included(2)), empty());
  assert_eq(
    between(of_list(["pear", "apple", "fig"]), Excluded("apple"), Unbounded),
    of_list(["fig", "pear"]),
  )
}

test "the ends of a set of a hundred thousand are read without listing it" {
  let read = |n: Int| {
    let s = of_list(range(0, n));
    metered(||
      {
        least: min(s),
        greatest: max(s),
        some: size(between(s, Included(n / 2), Excluded(n / 2 + 3))),
      }).allocations
  };
  assert_eq(min(of_list(range(0, 100000))), Some(0));
  assert(read(100000) <= read(100) + 16, Some(int_to_string(read(100000))))
}

test "a set held once is updated in place, allocating what its map alone would" {
  let keys = |n: Int| with_from(map_new(), range(0, n), 0);
  let raw = |n: Int| {
    let k = keys(n);
    metered(||
      map_fold(k, map_new(), |m: Map<Int, Unit>, x: Int, _: Unit| map_insert(m, x, ()))).allocations
  };
  let held = |n: Int| {
    let k = keys(n);
    metered(|| map_fold(k, empty(), |s: Set<Int>, x: Int, _: Unit| insert(s, x))).allocations
  };
  let over = held(2000) - held(1000) - (raw(2000) - raw(1000));
  assert(over <= 4, Some(int_to_string(over)))
}

test "a fold walks in order, and its step may perform" {
  assert_eq(fold(of_list([3, 1, 2]), [], |acc: List<Int>, x: Int| push(acc, x)), [1, 2, 3]);
  let walked = with_cell[walked](0) { c -> {
    let total = fold(of_list([1, 2, 3]), 0, |acc: Int, x: Int| {
      cell_set(c, cell_get(c) + 1);
      acc + x
    });
    { total: total, steps: cell_get(c) }
  } };
  assert_eq(walked, { total: 6, steps: 3 })
}

test "any and all stop asking once the answer is settled" {
  let s = of_list([1, 2, 3]);
  assert(any(s, |x: Int| x == 2));
  assert(!any(s, |x: Int| x > 3));
  assert(all(s, |x: Int| x > 0));
  assert(!all(s, |x: Int| x < 3));
  let none: Set<Int> = empty();
  assert(!any(none, |_: Int| true));
  assert(all(none, |_: Int| false));
  let asked = with_cell[asked](0) { c -> {
    let found = any(s, |x: Int| {
      cell_set(c, cell_get(c) + 1);
      x == 2
    });
    let held = all(s, |x: Int| {
      cell_set(c, cell_get(c) + 1);
      x < 1
    });
    { found: found, held: held, asked: cell_get(c) }
  } };
  assert_eq(asked, { found: true, held: false, asked: 3 })
}

test "a two-set operation's steps follow the smaller set, whichever side it is on" {
  let small = of_list([5, 500, 5000]);
  let large = of_list(range(0, 1000));
  let larger = of_list(range(0, 2000));
  assert_eq(
    metered(|| intersection(small, larger)).steps,
    metered(|| intersection(small, large)).steps,
  );
  assert_eq(
    metered(|| intersection(larger, small)).steps,
    metered(|| intersection(large, small)).steps,
  );
  assert_eq(
    metered(|| difference(small, larger)).steps,
    metered(|| difference(small, large)).steps,
  );
  assert_eq(
    metered(|| difference(larger, small)).steps,
    metered(|| difference(large, small)).steps,
  );
  assert_eq(
    metered(|| symmetric_difference(larger, small)).steps,
    metered(|| symmetric_difference(large, small)).steps,
  );
  assert_eq(
    metered(|| is_disjoint(larger, small)).steps,
    metered(|| is_disjoint(large, small)).steps,
  );
  assert_eq(metered(|| is_subset(small, larger)).steps, metered(|| is_subset(small, large)).steps);
  assert_eq(metered(|| union(larger, small)).steps, metered(|| union(small, large)).steps)
}

test "a partition builds its two sets where they are, an allocation or so an element" {
  let even = |x: Int| x % 2 == 0;
  let small = metered(|| partition(of_list(range(0, 1000)), even)).allocations;
  let large = metered(|| partition(of_list(range(0, 2000)), even)).allocations;
  assert(large - small < 1500, Some(int_to_string(large - small)))
}

/// Which of 0, 1 and 2 a set holds: every set over three elements, in a type a claim can list.
type Pick = { low: Bool, mid: Bool, high: Bool }

type Two = { a: Pick, b: Pick }

fn picked(p: Pick) -> Set<Int> = {
  let low = if p.low { of_list([0]) } else { empty() };
  let mid = if p.mid { insert(low, 1) } else { low };
  if p.high { insert(mid, 2) } else { mid }
}

fn pick_of(s: Set<Int>) -> Pick = { low: contains(s, 0), mid: contains(s, 1), high: contains(s, 2) }

fn universe() -> Set<Int> = of_list([0, 1, 2])

/// `op` over the sets two picks stand for.
fn over(op: (Set<Int>, Set<Int>) -> Set<Int>) -> (Two) -> Set<Int> =
  |t: Two| op(picked(t.a), picked(t.b))

/// `op` as an operation on picks.
fn lifted(op: (Set<Int>, Set<Int>) -> Set<Int>) -> (Pick, Pick) -> Pick =
  |x: Pick, y: Pick| pick_of(op(picked(x), picked(y)))

/// The set holding each element `holds` says to, told whether each of the two sets holds it.
fn each(t: Two, holds: (Bool, Bool) -> Bool) -> Set<Int> =
  picked({
    low: holds(t.a.low, t.b.low),
    mid: holds(t.a.mid, t.b.mid),
    high: holds(t.a.high, t.b.high),
  })

law "a pick reads back from the set it stands for" = inverse(picked, pick_of)

law "a union holds what either set holds" =
  agrees(over(union), |t: Two| each(t, |x: Bool, y: Bool| x || y))

law "an intersection holds what both sets hold" =
  agrees(over(intersection), |t: Two| each(t, |x: Bool, y: Bool| x && y))

law "a difference holds what the first set holds and the second does not" =
  agrees(over(difference), |t: Two| each(t, |x: Bool, y: Bool| x && !y))

law "a symmetric difference holds what exactly one set holds" =
  agrees(over(symmetric_difference), |t: Two| each(t, |x: Bool, y: Bool| x != y))

law "a subset holds nothing the other set lacks" =
  agrees(|t: Two| is_subset(picked(t.a), picked(t.b)), |t: Two|
    each(t, |x: Bool, y: Bool| x && !y) == empty())

law "disjoint sets hold nothing in common" =
  agrees(|t: Two| is_disjoint(picked(t.a), picked(t.b)), |t: Two|
    each(t, |x: Bool, y: Bool| x && y) == empty())

law "union is commutative" = agrees(over(union), over(|a: Set<Int>, b: Set<Int>| union(b, a)))

law "intersection is commutative" =
  agrees(over(intersection), over(|a: Set<Int>, b: Set<Int>| intersection(b, a)))

law "union is associative, and the empty set is its identity" =
  monoid(lifted(union), pick_of(empty()))

law "intersection is associative, and the universe is its identity" =
  monoid(lifted(intersection), pick_of(universe()))

law "a union absorbs an intersection with it" =
  agrees(over(|a: Set<Int>, b: Set<Int>| union(a, intersection(a, b))), |t: Two| picked(t.a))

law "an intersection absorbs a union with it" =
  agrees(over(|a: Set<Int>, b: Set<Int>| intersection(a, union(a, b))), |t: Two| picked(t.a))

law "what a union lacks is what both sets lack" =
  agrees(
    over(|a: Set<Int>, b: Set<Int>| difference(universe(), union(a, b))),
    over(|a: Set<Int>, b: Set<Int>|
      intersection(difference(universe(), a), difference(universe(), b))),
  )

law "what an intersection lacks is what either set lacks" =
  agrees(
    over(|a: Set<Int>, b: Set<Int>| difference(universe(), intersection(a, b))),
    over(|a: Set<Int>, b: Set<Int>| union(difference(universe(), a), difference(universe(), b))),
  )

law "min and max are the first and the last of the elements" =
  agrees(|p: Pick| { least: min(picked(p)), greatest: max(picked(p)) }, |p: Pick|
    { least: list::first(elements(picked(p))), greatest: list::last(elements(picked(p))) })

/// A bound of `kind` at `x`: none, counted, or left out.
fn ended(kind: Int, x: Int) -> Bound<Int> =
  if kind == 0 { Unbounded } else if kind == 1 || kind == -1 { Included(x) } else { Excluded(x) }

law "between holds the elements its bounds admit"
  forall (xs: List<Int>, low: Int, high: Int, ends: Int) {
    let s = map(of_list(xs), |x: Int| x % 8);
    let lo = ended(ends % 3, low % 8);
    let hi = ended(ends / 3 % 3, high % 8);
    elements(between(s, lo, hi))
      == list::partition(elements(s), |x: Int|
        (match lo {
            Included(least) -> least <= x,
            Excluded(least) -> least < x,
            Unbounded -> true,
          })
          && (match hi {
            Included(most) -> x <= most,
            Excluded(most) -> x < most,
            Unbounded -> true,
          })).yes
  }

law "a set's elements are its list's, sorted and each once" =
  agrees(|xs: List<Int>| elements(of_list(xs)), |xs: List<Int>| list::sort(list::unique(xs)))

law "a set built of a list holds exactly what the list holds"
  forall (xs: List<Int>, x: Int) {
    contains(of_list(xs), x) == list::contains(xs, x)
  }

law "a drawn set is shown as the list of its elements is, after a `#`"
  forall (s: Set<Int>) {
    written(s) == "#" ++ show::show(elements(s))
  }
