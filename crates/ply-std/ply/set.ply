// `set` — a set of elements, which is a `Map` whose values are `Unit` and nothing else.
//
// There is no set type in the language, so a set is spelled `Map<a, Unit>` and this module is the
// operations over that spelling. An alias would read better — `type Set<a>` — and one cannot exist
// yet: a `Map` key has to be ordered, the constraint would have to ride on the alias, and a type
// alias cannot carry `derivable` (card `313874be`). Until it can, the constraint is written on each
// signature and the parameter is the map. The key order is the set's order, so `elements` is
// stable: taking it twice is the same list.

/// The set with nothing in it.
pub fn empty<a>() -> Map<a, Unit>
  where derivable(ord, a)
= map_new()

pub fn is_empty<a>(s: Map<a, Unit>) -> Bool
  where derivable(ord, a)
= map_len(s) == 0

/// How many elements the set holds.
pub fn size<a>(s: Map<a, Unit>) -> Int
  where derivable(ord, a)
= map_len(s)

pub fn contains<a>(s: Map<a, Unit>, x: a) -> Bool
  where derivable(ord, a)
= map_contains(s, x)

/// `s` with `x` in it; one already there is the set itself.
pub fn insert<a>(s: Map<a, Unit>, x: a) -> Map<a, Unit>
  where derivable(ord, a)
= map_insert(s, x, ())

/// `s` without `x`; removing one that is absent is the set itself.
pub fn remove<a>(s: Map<a, Unit>, x: a) -> Map<a, Unit>
  where derivable(ord, a)
= map_remove(s, x)

/// Everything in either set.
pub fn union<a>(a: Map<a, Unit>, b: Map<a, Unit>) -> Map<a, Unit>
  where derivable(ord, a)
= map_merge(a, b)

/// The elements, in key order.
pub fn elements<a>(s: Map<a, Unit>) -> List<a>
  where derivable(ord, a)
= map_keys(s)

/// The set of the elements of `xs`.
pub fn of_list<a>(xs: List<a>) -> Map<a, Unit>
  where derivable(ord, a)
= fold(xs, map_new(), |acc: Map<a, Unit>, x: a| map_insert(acc, x, ()))

/// Whether every element of `xs` is in the set, which an empty `xs` is.
pub fn contains_all<a>(s: Map<a, Unit>, xs: List<a>) -> Bool
  where derivable(ord, a)
= fold(xs, true, |acc: Bool, x: a| acc && map_contains(s, x))

/// Whether no element of `xs` is in the set, which an empty `xs` is.
pub fn contains_none<a>(s: Map<a, Unit>, xs: List<a>) -> Bool
  where derivable(ord, a)
= fold(xs, true, |acc: Bool, x: a| acc && !map_contains(s, x))

// --- Tests ------------------------------------------------------------------

test "a set is a map of nothing, and its elements come back in key order" {
  let s = of_list([3, 1, 2, 1]);
  assert_eq(size(s), 3);
  assert(!is_empty(s));
  assert(is_empty(empty()));
  assert(contains(s, 2));
  assert(!contains(s, 9));
  assert_eq(elements(s), [1, 2, 3]);
  assert_eq(elements(of_list(["b", "a", "b"])), ["a", "b"])
}

test "insert and remove are idempotent, and union is the two of them" {
  let s = insert(empty(), 1);
  assert_eq(elements(insert(s, 1)), [1]);
  assert_eq(elements(remove(s, 1)), []);
  assert_eq(elements(remove(s, 9)), [1]);
  assert_eq(elements(union(of_list([1, 2]), of_list([2, 3]))), [1, 2, 3]);
  assert(contains_all(of_list([1, 2, 3]), [1, 3]));
  assert(contains_all(of_list([1]), []));
  assert(!contains_all(of_list([1, 2]), [1, 9]));
  assert(contains_none(of_list([1, 2]), [8, 9]));
  assert(contains_none(of_list([1, 2]), []));
  assert(!contains_none(of_list([1, 2]), [1]))
}
