//! A set: elements of one ordered type, each held once, in their order.
//!
//! The set literal `#[a, b]` builds a `Set`, and `show` writes one back as that literal. The order
//! is the elements' `compare` order: `==`, `compare`, `digest` and `Set::elements` answer alike
//! however the elements went in. A signature that names `Set<a>` is held to `derivable(ord, a)`
//! without writing it. `Set::map`, `Set::filter`, `Set::fold`, `Set::min` and `Set::max` are also
//! the prelude's names for a list, so qualify them: `s.map(f)`. A module that writes a set literal
//! imports this one itself, under a name no source can write, so this module writes none.
//!
//! An update of a set held once is made in place, as one of its map would be. The two-set
//! operations walk the smaller set and ask the larger, so each takes as many steps as the smaller
//! holds. `Set::min`, `Set::max` and `Set::between` read one path of the set's tree, however much
//! it holds.

import std.gen
import std.gen (Gen)
import std.laws (agrees, inverse, monoid)
import std.list
import std.map
import std.map (Bound, Excluded, Included, Unbounded)
import std.show
import std.string
import std.value (render_all, shown)

/// A set of `a`, which the literal `#[a, b]` writes.
pub opaque type Set<a> = | Set(Map<a, Unit>)

key for Set by items

show for Set by written

/// The map a set is, each element a key whose value is `()`: what `==`, `compare` and `digest`
/// read of it.
fn items<a>(s: Set<a>) -> Map<a, Unit> = match s { Set(m) -> m }

/// The literal that builds the set, each element as `show` writes it.
fn written<a>(s: Set<a>) -> String =
  "#["
    ++ String::join(
      items(s).fold([], |acc: List<String>, x: a, _: Unit| acc.push(render_all(shown(x)))),
      ", ",
    )
    ++ "]"

/// The set with nothing in it.
pub fn Set::empty<a>() -> Set<a> = Set(Map::new())

/// Whether the set holds nothing.
pub fn Set::is_empty<a>(s: Set<a>) -> Bool = items(s).len() == 0

/// How many elements the set holds.
pub fn Set::size<a>(s: Set<a>) -> Int = items(s).len()

/// Whether `x` is in the set.
pub fn Set::contains<a>(s: Set<a>, x: a) -> Bool = items(s).contains(x)

/// `s` with `x` in it; one already there is the set itself.
pub fn Set::insert<a>(s: Set<a>, x: a) -> Set<a> = match s { Set(m) -> Set(m.insert(x, ())) }

/// `s` without `x`; removing one that is absent is the set itself.
pub fn Set::remove<a>(s: Set<a>, x: a) -> Set<a> = match s { Set(m) -> Set(m.remove(x)) }

/// The elements, in order.
pub fn Set::elements<a>(s: Set<a>) -> List<a> = items(s).keys()

/// The set of the elements of `xs`.
pub fn Set::of_list<a>(xs: List<a>) -> Set<a> = Set(with_from(Map::new(), xs, 0))

fn with_from<a>(m: Map<a, Unit>, xs: List<a>, i: Int) -> Map<a, Unit>
  where derivable(ord, a)
= match xs.at(i) { Some(x) -> with_from(m.insert(x, ()), xs, i + 1), None -> m }

/// The least element, or `None` of the empty set.
pub fn Set::min<a>(s: Set<a>) -> Option<a> =
  match items(s).first() { Some(least) -> Some(least.key), None -> None }

/// The greatest element, or `None` of the empty set.
pub fn Set::max<a>(s: Set<a>) -> Option<a> =
  match items(s).last() { Some(greatest) -> Some(greatest.key), None -> None }

/// The elements from `lo` to `hi`, each end counted or left out as its bound says: a set that
/// shares what it can with `s`.
pub fn Set::between<a>(s: Set<a>, lo: Bound<a>, hi: Bound<a>) -> Set<a> =
  Set(items(s).between(lo, hi))

/// `step` over the elements in order, each handed what the last one answered, from `init`.
pub fn Set::fold<a, b | e>(s: Set<a>, init: b, step: (b, a) -> b / e cost k) -> b / e =
  folded(items(s), init, step)

fn folded<a, b | e>(m: Map<a, Unit>, init: b, step: (b, a) -> b / e cost k) -> b / e
  where derivable(ord, a)
  cost m.len() * k
= m.fold(init, |acc: b, x: a, _: Unit| step(acc, x))

/// The set of what `f` answers for each element, which is smaller than `s` where `f` answers two of
/// them alike.
pub fn Set::map<a, b | e>(s: Set<a>, f: (a) -> b / e cost k) -> Set<b> / e =
  Set(mapped(items(s), f))

fn mapped<a, b | e>(m: Map<a, Unit>, f: (a) -> b / e cost k) -> Map<b, Unit> / e
  where derivable(ord, a), derivable(ord, b)
  cost m.len() * k
= m.fold(Map::new(), |acc: Map<b, Unit>, x: a, _: Unit| acc.insert(f(x), ()))

/// The elements `keep` answers true for.
pub fn Set::filter<a | e>(s: Set<a>, keep: (a) -> Bool / e cost k) -> Set<a> / e =
  Set(kept(items(s), keep))

fn kept<a | e>(m: Map<a, Unit>, keep: (a) -> Bool / e cost k) -> Map<a, Unit> / e
  where derivable(ord, a)
  cost m.len() * k
=
  m.fold(Map::new(), |acc: Map<a, Unit>, x: a, _: Unit|
    if keep(x) { acc.insert(x, ()) } else { acc })

/// The elements `ok` answers true for, and the rest; `ok` is asked once of each.
pub fn Set::partition<a | e>(
  s: Set<a>,
  ok: (a) -> Bool / e cost k,
) -> { yes: Set<a>, no: Set<a> } / e = {
  let split = parted(items(s), ok);
  { yes: Set(split.yes), no: Set(split.no) }
}

fn parted<a | e>(
  m: Map<a, Unit>,
  ok: (a) -> Bool / e cost k,
) -> { yes: Map<a, Unit>, no: Map<a, Unit> } / e
  where derivable(ord, a)
  cost m.len() * k
=
  m.fold(
    { yes: Map::new(), no: Map::new() },
    |acc: { yes: Map<a, Unit>, no: Map<a, Unit> }, x: a, _: Unit| {
      let yes = acc.yes;
      let no = acc.no;
      if ok(x) { { yes: yes.insert(x, ()), no: no } } else { { yes: yes, no: no.insert(x, ()) } }
    },
  )

/// Whether `ok` answers true for an element, asked in order until one does. The empty set is `false`.
pub fn Set::any<a | e>(s: Set<a>, ok: (a) -> Bool / e cost k) -> Bool / e = any_in(items(s), ok)

fn any_in<a | e>(m: Map<a, Unit>, ok: (a) -> Bool / e cost k) -> Bool / e
  where derivable(ord, a)
  cost m.len() * k
= m.fold(false, |found: Bool, x: a, _: Unit| found || ok(x))

/// Whether `ok` answers true for every element, asked in order until one does not. The empty set is
/// `true`.
pub fn Set::all<a | e>(s: Set<a>, ok: (a) -> Bool / e cost k) -> Bool / e = all_in(items(s), ok)

fn all_in<a | e>(m: Map<a, Unit>, ok: (a) -> Bool / e cost k) -> Bool / e
  where derivable(ord, a)
  cost m.len() * k
= m.fold(true, |held: Bool, x: a, _: Unit| held && ok(x))

/// Whether every element of `xs` is in the set, which an empty `xs` is.
pub fn Set::contains_all<a>(s: Set<a>, xs: List<a>) -> Bool = {
  let m = items(s);
  xs.all(|x: a| m.contains(x))
}

/// Whether no element of `xs` is in the set, which an empty `xs` is.
pub fn Set::contains_none<a>(s: Set<a>, xs: List<a>) -> Bool = {
  let m = items(s);
  xs.all(|x: a| !m.contains(x))
}

/// Everything in either set.
pub fn Set::union<a>(a: Set<a>, b: Set<a>) -> Set<a> = {
  let x = items(a);
  let y = items(b);
  Set(if x.len() < y.len() { y.merge(x) } else { x.merge(y) })
}

/// Everything in any of the sets.
pub fn Set::unions<a>(sets: List<Set<a>>) -> Set<a> = unions_from(Set::empty(), sets, 0)

fn unions_from<a>(acc: Set<a>, sets: List<Set<a>>, i: Int) -> Set<a> =
  match sets.at(i) { Some(s) -> unions_from(acc.union(s), sets, i + 1), None -> acc }

/// The elements in both sets.
pub fn Set::intersection<a>(a: Set<a>, b: Set<a>) -> Set<a> = Set(shared(items(a), items(b)))

/// The elements the two maps share, walking the smaller and asking the larger.
fn shared<a>(x: Map<a, Unit>, y: Map<a, Unit>) -> Map<a, Unit>
  where derivable(ord, a)
  cost x.len() + y.len()
= if x.len() <= y.len() { kept_in(x, y) } else { kept_in(y, x) }

/// The keys of `walked` that `asked` holds too.
fn kept_in<a>(walked: Map<a, Unit>, asked: Map<a, Unit>) -> Map<a, Unit>
  where derivable(ord, a)
=
  walked.fold(Map::new(), |acc: Map<a, Unit>, x: a, _: Unit|
    if asked.contains(x) { acc.insert(x, ()) } else { acc })

/// The elements of `a` that are not in `b`.
pub fn Set::difference<a>(a: Set<a>, b: Set<a>) -> Set<a> = Set(without(items(a), items(b)))

/// The keys of `x` that `y` does not hold, walking whichever is smaller.
fn without<a>(x: Map<a, Unit>, y: Map<a, Unit>) -> Map<a, Unit>
  where derivable(ord, a)
  cost x.len() + y.len()
=
  if y.len() < x.len() { y.fold(x, |acc: Map<a, Unit>, k: a, _: Unit| acc.remove(k)) } else {
    x.fold(Map::new(), |acc: Map<a, Unit>, k: a, _: Unit|
      if y.contains(k) { acc } else { acc.insert(k, ()) })
  }

/// The elements in exactly one of the two sets.
pub fn Set::symmetric_difference<a>(a: Set<a>, b: Set<a>) -> Set<a> =
  Set(either_alone(items(a), items(b)))

fn either_alone<a>(x: Map<a, Unit>, y: Map<a, Unit>) -> Map<a, Unit>
  where derivable(ord, a)
  cost x.len() + y.len()
= {
  let left = without(x, y);
  let right = without(y, x);
  if left.len() < right.len() { right.merge(left) } else { left.merge(right) }
}

/// Whether every element of `a` is in `b`. The empty set is a subset of everything.
pub fn Set::is_subset<a>(a: Set<a>, b: Set<a>) -> Bool = within(items(a), items(b))

fn within<a>(x: Map<a, Unit>, y: Map<a, Unit>) -> Bool
  where derivable(ord, a)
  cost x.len()
= x.len() <= y.len() && x.fold(true, |held: Bool, k: a, _: Unit| held && y.contains(k))

/// Whether every element of `b` is in `a`.
pub fn Set::is_superset<a>(a: Set<a>, b: Set<a>) -> Bool = b.is_subset(a)

/// Whether the two sets share no element, which the empty set does with every set.
pub fn Set::is_disjoint<a>(a: Set<a>, b: Set<a>) -> Bool = apart(items(a), items(b))

fn apart<a>(x: Map<a, Unit>, y: Map<a, Unit>) -> Bool
  where derivable(ord, a)
  cost x.len() + y.len()
= if x.len() <= y.len() { missing_from(x, y) } else { missing_from(y, x) }

/// Whether `asked` holds no key of `walked`.
fn missing_from<a>(walked: Map<a, Unit>, asked: Map<a, Unit>) -> Bool
  where derivable(ord, a)
= walked.fold(true, |held: Bool, k: a, _: Unit| held && !asked.contains(k))

// --- Tests ------------------------------------------------------------------

test "a set's elements come back in order, each once" {
  let s = Set::of_list([3, 1, 2, 1]);
  assert_eq(s, Set::of_list([1, 2, 3]));
  assert_eq(s.size(), 3);
  assert(!s.is_empty());
  assert(Set::empty().is_empty());
  assert(s.contains(2));
  assert(!s.contains(9));
  assert_eq(s.elements(), [1, 2, 3]);
  assert_eq(Set::of_list(["b", "a", "b"]).elements(), ["a", "b"])
}

test "a set is shown as the literal that builds it" {
  assert_eq(written(Set::of_list([3, 1, 2])), "#[1, 2, 3]");
  assert_eq(written(Set::of_list(["b", "a"])), "#[\"a\", \"b\"]");
  assert_eq(written(Set::empty()), "#[]");
  assert_eq(written(Set::of_list([Set::of_list([2]), Set::of_list([])])), "#[#[], #[2]]")
}

test "insert and remove are idempotent, and union is the two of them" {
  let s = Set::empty().insert(1);
  assert_eq(s.insert(1), Set::of_list([1]));
  assert_eq(s.remove(1), Set::empty());
  assert_eq(s.remove(9), Set::of_list([1]));
  assert_eq(Set::of_list([1, 2]).union(Set::of_list([2, 3])), Set::of_list([1, 2, 3]));
  assert_eq(
    Set::unions([Set::of_list([1]), Set::of_list([3, 4]), Set::empty(), Set::of_list([1, 2])]),
    Set::of_list([1, 2, 3, 4]),
  );
  let none: List<Set<Int>> = [];
  assert_eq(Set::unions(none), Set::empty());
  assert(Set::of_list([1, 2, 3]).contains_all([1, 3]));
  assert(Set::of_list([1]).contains_all([]));
  assert(!Set::of_list([1, 2]).contains_all([1, 9]));
  assert(Set::of_list([1, 2]).contains_none([8, 9]));
  assert(Set::of_list([1, 2]).contains_none([]));
  assert(!Set::of_list([1, 2]).contains_none([1]))
}

test "the two-set operations answer what is shared and what is not" {
  let a = Set::of_list([1, 2, 3]);
  let b = Set::of_list([3, 4]);
  assert_eq(a.intersection(b), Set::of_list([3]));
  assert_eq(a.intersection(Set::empty()), Set::empty());
  assert_eq(a.difference(b), Set::of_list([1, 2]));
  assert_eq(b.difference(a), Set::of_list([4]));
  assert_eq(a.difference(a), Set::empty());
  assert_eq(a.symmetric_difference(b), Set::of_list([1, 2, 4]));
  assert_eq(a.symmetric_difference(a), Set::empty());
  assert(Set::of_list([1, 2]).is_subset(a));
  assert(Set::empty().is_subset(a));
  assert(!b.is_subset(a));
  assert(a.is_superset(Set::of_list([1])));
  assert(!a.is_superset(b));
  assert(Set::of_list([1, 2]).is_disjoint(Set::of_list([3])));
  assert(a.is_disjoint(Set::empty()));
  assert(!a.is_disjoint(b))
}

test "map may shrink the set, filter keeps what it is told to and partition splits it" {
  let s = Set::of_list([1, 2, 3, 4, 5]);
  assert_eq(s.map(|x: Int| x * 10), Set::of_list([10, 20, 30, 40, 50]));
  assert_eq(s.map(|x: Int| x % 2), Set::of_list([0, 1]));
  assert_eq(s.map(|x: Int| x.to_string()), Set::of_list(["1", "2", "3", "4", "5"]));
  assert_eq(s.filter(|x: Int| x > 3), Set::of_list([4, 5]));
  assert_eq(s.filter(|x: Int| x > 9), Set::empty());
  assert_eq(s.partition(|x: Int| x % 2 == 0), {
    yes: Set::of_list([2, 4]),
    no: Set::of_list([1, 3, 5]),
  })
}

test "min and max are the ends of the order, and the empty set has neither" {
  assert_eq(Set::of_list([3, 1, 2]).min(), Some(1));
  assert_eq(Set::of_list([3, 1, 2]).max(), Some(3));
  assert_eq(Set::of_list(["b", "a"]).min(), Some("a"));
  let none: Set<Int> = Set::empty();
  assert_eq(none.min(), None);
  assert_eq(none.max(), None)
}

test "between holds the elements within its bounds, an end counted or not as the bound says" {
  let s = Set::of_list([1, 3, 5, 7, 9]);
  assert_eq(s.between(Included(3), Included(7)), Set::of_list([3, 5, 7]));
  assert_eq(s.between(Excluded(3), Excluded(7)), Set::of_list([5]));
  assert_eq(s.between(Included(4), Unbounded), Set::of_list([5, 7, 9]));
  assert_eq(s.between(Unbounded, Excluded(5)), Set::of_list([1, 3]));
  assert_eq(s.between(Unbounded, Unbounded), s);
  assert_eq(s.between(Included(8), Included(2)), Set::empty());
  assert_eq(
    Set::of_list(["pear", "apple", "fig"]).between(Excluded("apple"), Unbounded),
    Set::of_list(["fig", "pear"]),
  )
}

test "the ends of a set of a hundred thousand are read without listing it" {
  let read = |n: Int| {
    let s = Set::of_list(range(0, n));
    metered(||
      {
        least: s.min(),
        greatest: s.max(),
        some: s.between(Included(n / 2), Excluded(n / 2 + 3)).size(),
      }).allocations
  };
  assert_eq(Set::of_list(range(0, 100000)).min(), Some(0));
  assert(read(100000) <= read(100) + 16, Some(read(100000).to_string()))
}

test "a set held once is updated in place, allocating what its map alone would" {
  let keys = |n: Int| with_from(Map::new(), range(0, n), 0);
  let raw = |n: Int| {
    let k = keys(n);
    metered(|| k.fold(Map::new(), |m: Map<Int, Unit>, x: Int, _: Unit| m.insert(x, ()))).allocations
  };
  let held = |n: Int| {
    let k = keys(n);
    metered(|| k.fold(Set::empty(), |s: Set<Int>, x: Int, _: Unit| s.insert(x))).allocations
  };
  let over = held(2000) - held(1000) - (raw(2000) - raw(1000));
  assert(over <= 4, Some(over.to_string()))
}

/// What a test's callback performs to be counted.
effect asking {
  write ask() -> Unit
}

test "a fold walks in order, and its step may perform" {
  assert_eq(Set::of_list([3, 1, 2]).fold([], |acc: List<Int>, x: Int| acc.push(x)), [1, 2, 3]);
  let walked = handle {
    Set::of_list([1, 2, 3]).fold(0, |acc: Int, x: Int| {
      asking.ask();
      acc + x
    })
  } with {
    var n = 0,
    asking.ask() -> {
      n = n + 1;
    },
    return total -> { total: total, steps: n },
  };
  assert_eq(walked, { total: 6, steps: 3 })
}

test "any and all stop asking once the answer is settled" {
  let s = Set::of_list([1, 2, 3]);
  assert(s.any(|x: Int| x == 2));
  assert(!s.any(|x: Int| x > 3));
  assert(s.all(|x: Int| x > 0));
  assert(!s.all(|x: Int| x < 3));
  let none: Set<Int> = Set::empty();
  assert(!none.any(|_: Int| true));
  assert(none.all(|_: Int| false));
  let asked = handle {
    let found = s.any(|x: Int| {
      asking.ask();
      x == 2
    });
    let held = s.all(|x: Int| {
      asking.ask();
      x < 1
    });
    { found: found, held: held }
  } with {
    var n = 0,
    asking.ask() -> {
      n = n + 1;
    },
    return r -> { found: r.found, held: r.held, asked: n },
  };
  assert_eq(asked, { found: true, held: false, asked: 3 })
}

test "a two-set operation's steps follow the smaller set, whichever side it is on" {
  let small = Set::of_list([5, 500, 5000]);
  let large = Set::of_list(range(0, 1000));
  let larger = Set::of_list(range(0, 2000));
  assert_eq(
    metered(|| small.intersection(larger)).steps,
    metered(|| small.intersection(large)).steps,
  );
  assert_eq(
    metered(|| larger.intersection(small)).steps,
    metered(|| large.intersection(small)).steps,
  );
  assert_eq(metered(|| small.difference(larger)).steps, metered(|| small.difference(large)).steps);
  assert_eq(metered(|| larger.difference(small)).steps, metered(|| large.difference(small)).steps);
  assert_eq(
    metered(|| larger.symmetric_difference(small)).steps,
    metered(|| large.symmetric_difference(small)).steps,
  );
  assert_eq(
    metered(|| larger.is_disjoint(small)).steps,
    metered(|| large.is_disjoint(small)).steps,
  );
  assert_eq(metered(|| small.is_subset(larger)).steps, metered(|| small.is_subset(large)).steps);
  assert_eq(metered(|| larger.union(small)).steps, metered(|| small.union(large)).steps)
}

test "a partition builds its two sets where they are, an allocation or so an element" {
  let even = |x: Int| x % 2 == 0;
  let small = metered(|| Set::of_list(range(0, 1000)).partition(even)).allocations;
  let large = metered(|| Set::of_list(range(0, 2000)).partition(even)).allocations;
  assert(large - small < 1500, Some(Int::to_string(large - small)))
}

/// Which of 0, 1 and 2 a set holds: every set over three elements, in a type a claim can list.
type Pick = { low: Bool, mid: Bool, high: Bool }

type Two = { a: Pick, b: Pick }

fn picked(p: Pick) -> Set<Int> = {
  let low = if p.low { Set::of_list([0]) } else { Set::empty() };
  let mid = if p.mid { low.insert(1) } else { low };
  if p.high { mid.insert(2) } else { mid }
}

fn pick_of(s: Set<Int>) -> Pick = { low: s.contains(0), mid: s.contains(1), high: s.contains(2) }

fn universe() -> Set<Int> = Set::of_list([0, 1, 2])

/// `op` over the sets two picks stand for.
fn over(op: (Set<Int>, Set<Int>) -> Set<Int>) -> (Two) -> Set<Int> =
  |t: Two| op(picked(t.a), picked(t.b))

/// `op` as an operation on picks.
fn lifted(op: (Set<Int>, Set<Int>) -> Set<Int>) -> (Pick, Pick) -> Pick =
  |x: Pick, y: Pick| pick_of(op(picked(x), picked(y)))

/// The set holding each element `holds` says to, told whether each of the two sets holds it.
fn each(t: Two, holds: (Bool, Bool) -> Bool) -> Set<Int> =
  picked({
    low: holds(t.a.low, t.b.low),
    mid: holds(t.a.mid, t.b.mid),
    high: holds(t.a.high, t.b.high),
  })

law "a pick reads back from the set it stands for" = inverse(picked, pick_of)

law "a union holds what either set holds" =
  agrees(over(Set::union), |t: Two| each(t, |x: Bool, y: Bool| x || y))

law "an intersection holds what both sets hold" =
  agrees(over(Set::intersection), |t: Two| each(t, |x: Bool, y: Bool| x && y))

law "a difference holds what the first set holds and the second does not" =
  agrees(over(Set::difference), |t: Two| each(t, |x: Bool, y: Bool| x && !y))

law "a symmetric difference holds what exactly one set holds" =
  agrees(over(Set::symmetric_difference), |t: Two| each(t, |x: Bool, y: Bool| x != y))

law "a subset holds nothing the other set lacks" =
  agrees(|t: Two| picked(t.a).is_subset(picked(t.b)), |t: Two|
    each(t, |x: Bool, y: Bool| x && !y) == Set::empty())

law "disjoint sets hold nothing in common" =
  agrees(|t: Two| picked(t.a).is_disjoint(picked(t.b)), |t: Two|
    each(t, |x: Bool, y: Bool| x && y) == Set::empty())

law "union is commutative" = agrees(over(Set::union), over(|a: Set<Int>, b: Set<Int>| b.union(a)))

law "intersection is commutative" =
  agrees(over(Set::intersection), over(|a: Set<Int>, b: Set<Int>| b.intersection(a)))

law "union is associative, and the empty set is its identity" =
  monoid(lifted(Set::union), pick_of(Set::empty()))

law "intersection is associative, and the universe is its identity" =
  monoid(lifted(Set::intersection), pick_of(universe()))

law "a union absorbs an intersection with it" =
  agrees(over(|a: Set<Int>, b: Set<Int>| a.union(a.intersection(b))), |t: Two| picked(t.a))

law "an intersection absorbs a union with it" =
  agrees(over(|a: Set<Int>, b: Set<Int>| a.intersection(a.union(b))), |t: Two| picked(t.a))

law "what a union lacks is what both sets lack" =
  agrees(
    over(|a: Set<Int>, b: Set<Int>| universe().difference(a.union(b))),
    over(|a: Set<Int>, b: Set<Int>|
      universe().difference(a).intersection(universe().difference(b))),
  )

law "what an intersection lacks is what either set lacks" =
  agrees(
    over(|a: Set<Int>, b: Set<Int>| universe().difference(a.intersection(b))),
    over(|a: Set<Int>, b: Set<Int>| universe().difference(a).union(universe().difference(b))),
  )

law "min and max are the first and the last of the elements" =
  agrees(|p: Pick| { least: picked(p).min(), greatest: picked(p).max() }, |p: Pick|
    { least: picked(p).elements().first(), greatest: picked(p).elements().last() })

test "a set's elements are its list's, sorted and each once" {
  gen::check(gen::list(gen::any_int()), |x: List<Int>|
    agrees(|xs: List<Int>| Set::of_list(xs).elements(), |xs: List<Int>| xs.unique().sort(), x))
}
