//! A set: elements of one ordered type, each held once, in their order.
//!
//! `Set<a>` names the type the set literal `#[a, b]` builds, a `Map` whose values are `()`, so a
//! literal is a set as it stands, and `show` writes a set as that map. The key order is the set's
//! order: `==`, `compare`, `digest` and `elements` answer alike however the elements went in. An
//! alias carries no constraint, so a signature generic over the element writes
//! `where derivable(ord, a)` itself. `map`, `filter`, `fold`, `min` and `max` are also the prelude's
//! names for a list, so qualify them: `set::map(s, f)`.
//!
//! The two-set operations walk the smaller set and ask the larger, so each takes as many steps as the
//! smaller holds. `min` and `max` list every element to read one: a map has no first key to ask for.

import std.laws (agrees, inverse, monoid)
import std.list

/// A set of `a`, which the literal `#[a, b]` writes.
pub type Set<a> = Map<a, Unit>

/// The set with nothing in it.
pub fn empty<a>() -> Set<a>
  where derivable(ord, a)
= map_new()

/// Whether the set holds nothing.
pub fn is_empty<a>(s: Set<a>) -> Bool
  where derivable(ord, a)
= map_len(s) == 0

/// How many elements the set holds.
pub fn size<a>(s: Set<a>) -> Int
  where derivable(ord, a)
= map_len(s)

/// Whether `x` is in the set.
pub fn contains<a>(s: Set<a>, x: a) -> Bool
  where derivable(ord, a)
= map_contains(s, x)

/// `s` with `x` in it; one already there is the set itself.
pub fn insert<a>(s: Set<a>, x: a) -> Set<a>
  where derivable(ord, a)
= map_insert(s, x, ())

/// `s` without `x`; removing one that is absent is the set itself.
pub fn remove<a>(s: Set<a>, x: a) -> Set<a>
  where derivable(ord, a)
= map_remove(s, x)

/// The elements, in order.
pub fn elements<a>(s: Set<a>) -> List<a>
  where derivable(ord, a)
= map_keys(s)

/// The set of the elements of `xs`.
pub fn of_list<a>(xs: List<a>) -> Set<a>
  where derivable(ord, a)
= with_from(map_new(), xs, 0)

fn with_from<a>(s: Set<a>, xs: List<a>, i: Int) -> Set<a>
  where derivable(ord, a)
= match list_at(xs, i) { Some(x) -> with_from(map_insert(s, x, ()), xs, i + 1), None -> s }

/// The least element, or `None` of the empty set.
pub fn min<a>(s: Set<a>) -> Option<a>
  where derivable(ord, a)
= list_at(map_keys(s), 0)

/// The greatest element, or `None` of the empty set.
pub fn max<a>(s: Set<a>) -> Option<a>
  where derivable(ord, a)
= list_at(map_keys(s), map_len(s) - 1)

/// `step` over the elements in order, each handed what the last one answered, from `init`.
pub fn fold<a, b | e>(s: Set<a>, init: b, step: (b, a) -> b / e cost k) -> b / e
  where derivable(ord, a)
  cost map_len(s) * k
= map_fold(s, init, |acc: b, x: a, _: Unit| step(acc, x))

/// The set of what `f` answers for each element, which is smaller than `s` where `f` answers two of
/// them alike.
pub fn map<a, b | e>(s: Set<a>, f: (a) -> b / e cost k) -> Set<b> / e
  where derivable(ord, a), derivable(ord, b)
  cost map_len(s) * k
= map_fold(s, map_new(), |acc: Set<b>, x: a, _: Unit| map_insert(acc, f(x), ()))

/// The elements `keep` answers true for.
pub fn filter<a | e>(s: Set<a>, keep: (a) -> Bool / e cost k) -> Set<a> / e
  where derivable(ord, a)
  cost map_len(s) * k
=
  map_fold(s, map_new(), |acc: Set<a>, x: a, _: Unit|
    if keep(x) { map_insert(acc, x, ()) } else { acc })

/// The elements `ok` answers true for, and the rest; `ok` is asked once of each.
pub fn partition<a | e>(s: Set<a>, ok: (a) -> Bool / e cost k) -> { yes: Set<a>, no: Set<a> } / e
  where derivable(ord, a)
  cost map_len(s) * k
=
  map_fold(
    s,
    { yes: map_new(), no: map_new() },
    |acc: { yes: Set<a>, no: Set<a> }, x: a, _: Unit| {
      let yes = acc.yes;
      let no = acc.no;
      if ok(x) { { yes: map_insert(yes, x, ()), no: no } }
      else { { yes: yes, no: map_insert(no, x, ()) } }
    },
  )

/// Whether `ok` answers true for an element, asked in order until one does. The empty set is `false`.
pub fn any<a | e>(s: Set<a>, ok: (a) -> Bool / e cost k) -> Bool / e
  where derivable(ord, a)
  cost map_len(s) * k
= map_fold(s, false, |found: Bool, x: a, _: Unit| found || ok(x))

/// Whether `ok` answers true for every element, asked in order until one does not. The empty set is
/// `true`.
pub fn all<a | e>(s: Set<a>, ok: (a) -> Bool / e cost k) -> Bool / e
  where derivable(ord, a)
  cost map_len(s) * k
= map_fold(s, true, |held: Bool, x: a, _: Unit| held && ok(x))

/// Whether every element of `xs` is in the set, which an empty `xs` is.
pub fn contains_all<a>(s: Set<a>, xs: List<a>) -> Bool
  where derivable(ord, a)
= all_from(s, xs, 0)

fn all_from<a>(s: Set<a>, xs: List<a>, i: Int) -> Bool
  where derivable(ord, a)
= match list_at(xs, i) { Some(x) -> map_contains(s, x) && all_from(s, xs, i + 1), None -> true }

/// Whether no element of `xs` is in the set, which an empty `xs` is.
pub fn contains_none<a>(s: Set<a>, xs: List<a>) -> Bool
  where derivable(ord, a)
= none_from(s, xs, 0)

fn none_from<a>(s: Set<a>, xs: List<a>, i: Int) -> Bool
  where derivable(ord, a)
= match list_at(xs, i) { Some(x) -> !map_contains(s, x) && none_from(s, xs, i + 1), None -> true }

/// Everything in either set.
pub fn union<a>(a: Set<a>, b: Set<a>) -> Set<a>
  where derivable(ord, a)
= if map_len(a) < map_len(b) { map_merge(b, a) } else { map_merge(a, b) }

/// Everything in any of the sets.
pub fn unions<a>(sets: List<Set<a>>) -> Set<a>
  where derivable(ord, a)
= unions_from(map_new(), sets, 0)

fn unions_from<a>(acc: Set<a>, sets: List<Set<a>>, i: Int) -> Set<a>
  where derivable(ord, a)
= match list_at(sets, i) { Some(s) -> unions_from(union(acc, s), sets, i + 1), None -> acc }

/// The elements in both sets.
pub fn intersection<a>(a: Set<a>, b: Set<a>) -> Set<a>
  where derivable(ord, a)
  cost map_len(a) + map_len(b)
= if map_len(a) <= map_len(b) { shared(a, b) } else { shared(b, a) }

/// The elements of `walked` that `asked` holds too.
fn shared<a>(walked: Set<a>, asked: Set<a>) -> Set<a>
  where derivable(ord, a)
=
  map_fold(walked, map_new(), |acc: Set<a>, x: a, _: Unit|
    if map_contains(asked, x) { map_insert(acc, x, ()) } else { acc })

/// The elements of `a` that are not in `b`.
pub fn difference<a>(a: Set<a>, b: Set<a>) -> Set<a>
  where derivable(ord, a)
  cost map_len(a) + map_len(b)
=
  if map_len(b) < map_len(a) { map_fold(b, a, |acc: Set<a>, x: a, _: Unit| map_remove(acc, x)) }
  else {
    map_fold(a, map_new(), |acc: Set<a>, x: a, _: Unit|
      if map_contains(b, x) { acc } else { map_insert(acc, x, ()) })
  }

/// The elements in exactly one of the two sets.
pub fn symmetric_difference<a>(a: Set<a>, b: Set<a>) -> Set<a>
  where derivable(ord, a)
  cost map_len(a) + map_len(b)
= union(difference(a, b), difference(b, a))

/// Whether every element of `a` is in `b`. The empty set is a subset of everything.
pub fn is_subset<a>(a: Set<a>, b: Set<a>) -> Bool
  where derivable(ord, a)
  cost map_len(a)
=
  map_len(a) <= map_len(b)
    && map_fold(a, true, |held: Bool, x: a, _: Unit| held && map_contains(b, x))

/// Whether every element of `b` is in `a`.
pub fn is_superset<a>(a: Set<a>, b: Set<a>) -> Bool
  where derivable(ord, a)
= is_subset(b, a)

/// Whether the two sets share no element, which the empty set does with every set.
pub fn is_disjoint<a>(a: Set<a>, b: Set<a>) -> Bool
  where derivable(ord, a)
  cost map_len(a) + map_len(b)
= if map_len(a) <= map_len(b) { apart(a, b) } else { apart(b, a) }

/// Whether `asked` holds no element of `walked`.
fn apart<a>(walked: Set<a>, asked: Set<a>) -> Bool
  where derivable(ord, a)
= map_fold(walked, true, |held: Bool, x: a, _: Unit| held && !map_contains(asked, x))

// --- Tests ------------------------------------------------------------------

test "a set is the literal's type, and its elements come back in order" {
  let s = of_list([3, 1, 2, 1]);
  assert_eq(s, #[1, 2, 3]);
  assert_eq(size(s), 3);
  assert(!is_empty(s));
  assert(is_empty(empty()));
  assert(contains(s, 2));
  assert(!contains(s, 9));
  assert_eq(elements(s), [1, 2, 3]);
  assert_eq(elements(of_list(["b", "a", "b"])), ["a", "b"])
}

test "insert and remove are idempotent, and union is the two of them" {
  let s = insert(empty(), 1);
  assert_eq(insert(s, 1), #[1]);
  assert_eq(remove(s, 1), #[]);
  assert_eq(remove(s, 9), #[1]);
  assert_eq(union(#[1, 2], #[2, 3]), #[1, 2, 3]);
  assert_eq(unions([#[1], #[3, 4], #[], #[1, 2]]), #[1, 2, 3, 4]);
  let none: List<Set<Int>> = [];
  assert_eq(unions(none), #[]);
  assert(contains_all(#[1, 2, 3], [1, 3]));
  assert(contains_all(#[1], []));
  assert(!contains_all(#[1, 2], [1, 9]));
  assert(contains_none(#[1, 2], [8, 9]));
  assert(contains_none(#[1, 2], []));
  assert(!contains_none(#[1, 2], [1]))
}

test "the two-set operations answer what is shared and what is not" {
  let a = #[1, 2, 3];
  let b = #[3, 4];
  assert_eq(intersection(a, b), #[3]);
  assert_eq(intersection(a, #[]), #[]);
  assert_eq(difference(a, b), #[1, 2]);
  assert_eq(difference(b, a), #[4]);
  assert_eq(difference(a, a), #[]);
  assert_eq(symmetric_difference(a, b), #[1, 2, 4]);
  assert_eq(symmetric_difference(a, a), #[]);
  assert(is_subset(#[1, 2], a));
  assert(is_subset(#[], a));
  assert(!is_subset(b, a));
  assert(is_superset(a, #[1]));
  assert(!is_superset(a, b));
  assert(is_disjoint(#[1, 2], #[3]));
  assert(is_disjoint(a, #[]));
  assert(!is_disjoint(a, b))
}

test "map may shrink the set, filter keeps what it is told to and partition splits it" {
  let s = #[1, 2, 3, 4, 5];
  assert_eq(map(s, |x: Int| x * 10), #[10, 20, 30, 40, 50]);
  assert_eq(map(s, |x: Int| x % 2), #[0, 1]);
  assert_eq(map(s, |x: Int| int_to_string(x)), #["1", "2", "3", "4", "5"]);
  assert_eq(filter(s, |x: Int| x > 3), #[4, 5]);
  assert_eq(filter(s, |x: Int| x > 9), #[]);
  assert_eq(partition(s, |x: Int| x % 2 == 0), { yes: #[2, 4], no: #[1, 3, 5] })
}

test "min and max are the ends of the order, and the empty set has neither" {
  assert_eq(min(#[3, 1, 2]), Some(1));
  assert_eq(max(#[3, 1, 2]), Some(3));
  assert_eq(min(#["b", "a"]), Some("a"));
  let none: Set<Int> = #[];
  assert_eq(min(none), None);
  assert_eq(max(none), None)
}

test "a fold walks in order, and its step may perform" {
  assert_eq(fold(#[3, 1, 2], [], |acc: List<Int>, x: Int| push(acc, x)), [1, 2, 3]);
  let walked = with_cell[walked](0) { c -> {
    let total = fold(#[1, 2, 3], 0, |acc: Int, x: Int| {
      cell_set(c, cell_get(c) + 1);
      acc + x
    });
    { total: total, steps: cell_get(c) }
  } };
  assert_eq(walked, { total: 6, steps: 3 })
}

test "any and all stop asking once the answer is settled" {
  assert(any(#[1, 2, 3], |x: Int| x == 2));
  assert(!any(#[1, 2, 3], |x: Int| x > 3));
  assert(all(#[1, 2, 3], |x: Int| x > 0));
  assert(!all(#[1, 2, 3], |x: Int| x < 3));
  let none: Set<Int> = #[];
  assert(!any(none, |_: Int| true));
  assert(all(none, |_: Int| false));
  let asked = with_cell[asked](0) { c -> {
    let found = any(#[1, 2, 3], |x: Int| {
      cell_set(c, cell_get(c) + 1);
      x == 2
    });
    let held = all(#[1, 2, 3], |x: Int| {
      cell_set(c, cell_get(c) + 1);
      x < 1
    });
    { found: found, held: held, asked: cell_get(c) }
  } };
  assert_eq(asked, { found: true, held: false, asked: 3 })
}

test "a two-set operation's steps follow the smaller set, whichever side it is on" {
  let small = #[5, 500, 5000];
  let large = of_list(range(0, 1000));
  let larger = of_list(range(0, 2000));
  assert_eq(
    metered(|| intersection(small, larger)).steps,
    metered(|| intersection(small, large)).steps,
  );
  assert_eq(
    metered(|| intersection(larger, small)).steps,
    metered(|| intersection(large, small)).steps,
  );
  assert_eq(
    metered(|| difference(small, larger)).steps,
    metered(|| difference(small, large)).steps,
  );
  assert_eq(
    metered(|| difference(larger, small)).steps,
    metered(|| difference(large, small)).steps,
  );
  assert_eq(
    metered(|| symmetric_difference(larger, small)).steps,
    metered(|| symmetric_difference(large, small)).steps,
  );
  assert_eq(
    metered(|| is_disjoint(larger, small)).steps,
    metered(|| is_disjoint(large, small)).steps,
  );
  assert_eq(metered(|| is_subset(small, larger)).steps, metered(|| is_subset(small, large)).steps);
  assert_eq(metered(|| union(larger, small)).steps, metered(|| union(small, large)).steps)
}

test "a partition builds its two sets where they are, an allocation or so an element" {
  let even = |x: Int| x % 2 == 0;
  let small = metered(|| partition(of_list(range(0, 1000)), even)).allocations;
  let large = metered(|| partition(of_list(range(0, 2000)), even)).allocations;
  assert(large - small < 1500, Some(int_to_string(large - small)))
}

/// Which of 0, 1 and 2 a set holds: every set over three elements, in a type a claim can list.
type Pick = { low: Bool, mid: Bool, high: Bool }

type Two = { a: Pick, b: Pick }

fn picked(p: Pick) -> Set<Int> = {
  let low = if p.low { #[0] } else { #[] };
  let mid = if p.mid { insert(low, 1) } else { low };
  if p.high { insert(mid, 2) } else { mid }
}

fn pick_of(s: Set<Int>) -> Pick = { low: contains(s, 0), mid: contains(s, 1), high: contains(s, 2) }

fn universe() -> Set<Int> = #[0, 1, 2]

/// `op` over the sets two picks stand for.
fn over(op: (Set<Int>, Set<Int>) -> Set<Int>) -> (Two) -> Set<Int> =
  |t: Two| op(picked(t.a), picked(t.b))

/// `op` as an operation on picks.
fn lifted(op: (Set<Int>, Set<Int>) -> Set<Int>) -> (Pick, Pick) -> Pick =
  |x: Pick, y: Pick| pick_of(op(picked(x), picked(y)))

/// The set holding each element `holds` says to, told whether each of the two sets holds it.
fn each(t: Two, holds: (Bool, Bool) -> Bool) -> Set<Int> =
  picked({
    low: holds(t.a.low, t.b.low),
    mid: holds(t.a.mid, t.b.mid),
    high: holds(t.a.high, t.b.high),
  })

law "a pick reads back from the set it stands for" = inverse(picked, pick_of)

law "a union holds what either set holds" =
  agrees(over(union), |t: Two| each(t, |x: Bool, y: Bool| x || y))

law "an intersection holds what both sets hold" =
  agrees(over(intersection), |t: Two| each(t, |x: Bool, y: Bool| x && y))

law "a difference holds what the first set holds and the second does not" =
  agrees(over(difference), |t: Two| each(t, |x: Bool, y: Bool| x && !y))

law "a symmetric difference holds what exactly one set holds" =
  agrees(over(symmetric_difference), |t: Two| each(t, |x: Bool, y: Bool| x != y))

law "a subset holds nothing the other set lacks" =
  agrees(|t: Two| is_subset(picked(t.a), picked(t.b)), |t: Two|
    each(t, |x: Bool, y: Bool| x && !y) == #[])

law "disjoint sets hold nothing in common" =
  agrees(|t: Two| is_disjoint(picked(t.a), picked(t.b)), |t: Two|
    each(t, |x: Bool, y: Bool| x && y) == #[])

law "union is commutative" = agrees(over(union), over(|a: Set<Int>, b: Set<Int>| union(b, a)))

law "intersection is commutative" =
  agrees(over(intersection), over(|a: Set<Int>, b: Set<Int>| intersection(b, a)))

law "union is associative, and the empty set is its identity" = monoid(lifted(union), pick_of(#[]))

law "intersection is associative, and the universe is its identity" =
  monoid(lifted(intersection), pick_of(universe()))

law "a union absorbs an intersection with it" =
  agrees(over(|a: Set<Int>, b: Set<Int>| union(a, intersection(a, b))), |t: Two| picked(t.a))

law "an intersection absorbs a union with it" =
  agrees(over(|a: Set<Int>, b: Set<Int>| intersection(a, union(a, b))), |t: Two| picked(t.a))

law "what a union lacks is what both sets lack" =
  agrees(
    over(|a: Set<Int>, b: Set<Int>| difference(universe(), union(a, b))),
    over(|a: Set<Int>, b: Set<Int>|
      intersection(difference(universe(), a), difference(universe(), b))),
  )

law "what an intersection lacks is what either set lacks" =
  agrees(
    over(|a: Set<Int>, b: Set<Int>| difference(universe(), intersection(a, b))),
    over(|a: Set<Int>, b: Set<Int>| union(difference(universe(), a), difference(universe(), b))),
  )

law "a set's elements are its list's, sorted and each once" =
  agrees(|xs: List<Int>| elements(of_list(xs)), |xs: List<Int>| list::sort(list::unique(xs)))

law "a set built of a list holds exactly what the list holds"
  forall (xs: List<Int>, x: Int) {
    contains(of_list(xs), x) == list::contains(xs, x)
  }
