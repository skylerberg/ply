// `option` — what a program wants over an `Option<a>` and the prelude does not carry.
//
// `Option`'s constructors are the prelude's (`Some`, `None`), and `?` propagates one. What is
// missing is the combinators a chain reads with, and each of these is `option_`-prefixed because
// `map` and `and_then` are names a program already has — for lists, and for `Parser` — and an
// unqualified `map` that silently took an `Option` would be a trap.

pub fn option_map<a, b | e>(o: Option<a>, f: (a) -> b / e) -> Option<b> / e =
  match o { None -> None, Some(x) -> Some(f(x)) }

pub fn option_and_then<a, b | e>(o: Option<a>, f: (a) -> Option<b> / e) -> Option<b> / e =
  match o { None -> None, Some(x) -> f(x) }

/// The value if it is there and `ok` answers true, and `None` otherwise.
pub fn option_filter<a | e>(o: Option<a>, ok: (a) -> Bool / e) -> Option<a> / e =
  match o { None -> None, Some(x) -> if ok(x) { Some(x) } else { None } }

/// The value if it is there, and `fallback` otherwise. Both are already evaluated, which
/// `option_or_else` is for when the fallback is expensive.
pub fn option_or<a>(o: Option<a>, fallback: Option<a>) -> Option<a> =
  match o { None -> fallback, Some(x) -> Some(x) }

pub fn option_unwrap_or<a>(o: Option<a>, fallback: a) -> a =
  match o { None -> fallback, Some(x) -> x }

/// The value, or the panic `message` names. This is the one place an absent value is a defect
/// rather than a case, so say why it cannot happen.
pub fn option_expect<a>(o: Option<a>, message: String) -> a / {abort.raise} =
  match o { None -> panic(message), Some(x) -> x }

pub fn option_is_some<a>(o: Option<a>) -> Bool = match o { None -> false, Some(_) -> true }

pub fn option_is_none<a>(o: Option<a>) -> Bool = match o { None -> true, Some(_) -> false }

/// The value as an `Ok`, or `err` as the `Err`.
pub fn option_ok_or<a, e>(o: Option<a>, err: e) -> Result<a, e> =
  match o { None -> Err(err), Some(x) -> Ok(x) }

/// The value if it is there, and what `fallback` answers otherwise. The fallback only runs when it
/// is needed, which is what `option_or` is for when it is not expensive.
pub fn option_or_else<a | e>(o: Option<a>, fallback: () -> Option<a> / e) -> Option<a> / e =
  match o { None -> fallback(), Some(x) -> Some(x) }

pub fn option_unwrap_or_else<a | e>(o: Option<a>, fallback: () -> a / e) -> a / e =
  match o { None -> fallback(), Some(x) -> x }

/// `f` of the value, or `fallback` untouched.
pub fn option_map_or<a, b | e>(o: Option<a>, fallback: b, f: (a) -> b / e) -> b / e =
  match o { None -> fallback, Some(x) -> f(x) }

// --- Tests ------------------------------------------------------------------

test "the combinators answer the absence rather than raising" {
  assert_eq(option_map(Some(2), |x: Int| x * 3), Some(6));
  assert_eq(option_map(None, |x: Int| x * 3), None);
  assert_eq(option_and_then(Some(2), |x: Int| Some(x + 1)), Some(3));
  assert_eq(option_and_then(Some(2), |_: Int| None), None);
  assert_eq(option_filter(Some(4), |x: Int| x > 3), Some(4));
  assert_eq(option_filter(Some(2), |x: Int| x > 3), None);
  assert_eq(option_or(None, Some(9)), Some(9));
  assert_eq(option_or(Some(1), Some(9)), Some(1));
  assert_eq(option_unwrap_or(None, 9), 9);
  assert_eq(option_unwrap_or(Some(1), 9), 1);
  assert_eq(option_ok_or(Some(1), "missing"), Ok(1));
  assert_eq(option_ok_or(None, "missing"), Err("missing"));
  assert(option_is_some(Some(1)));
  assert(option_is_none(None));
  assert_eq(option_expect(Some(7), "cannot happen"), 7)
}

test "the else-combinators only run the fallback they need" {
  assert_eq(option_or_else(None, || Some(9)), Some(9));
  assert_eq(option_or_else(Some(1), || Some(9)), Some(1));
  assert_eq(option_unwrap_or_else(None, || 9), 9);
  assert_eq(option_unwrap_or_else(Some(1), || 9), 1);
  assert_eq(option_map_or(Some(2), 0, |x: Int| x * 3), 6);
  assert_eq(option_map_or(None, 0, |x: Int| x * 3), 0)
}

test "a callback may perform effects, and runs only where the value calls for it" {
  let calls = with_cell[calls](0) { c -> {
    let tick = |x: Int| {
      cell_update(c, |n: Int| n + 1);
      x
    };
    assert_eq(option_map(Some(2), |x: Int| tick(x) * 3), Some(6));
    assert_eq(option_map(None, |x: Int| tick(x) * 3), None);
    assert_eq(option_unwrap_or_else(None, || tick(5)), 5);
    assert_eq(option_unwrap_or_else(Some(1), || tick(5)), 1);
    cell_get(c)
  } };
  assert_eq(calls, 2)
}
