//! What a program wants over an `Option<a>` and the prelude does not carry.
//!
//! `Option`'s constructors are the prelude's (`Some`, `None`), and `?` propagates one. What is missing
//! is the combinators a chain reads with, each a function of `Option`: `o.map(f)` is `Option`'s
//! whatever else a program calls `map`. A callback may perform effects, and runs only where the
//! value calls for it: `Option::map` of `None` never calls `f`.
//!
//! Over a list, `Option::all` answers every value or nothing and reads nothing past the first
//! `None`. `Option::traverse` maps and gathers in one pass and `Option::try_fold` threads a state:
//! neither reads past the first `None`, and a definition that recurses through the callback of
//! either is seen to end as it is through `List::fold`.

import std.laws (agrees, inverse)
import std.gen

/// The value through `f`, if there is one.
pub fn Option::map<a, b | e>(o: Option<a>, f: (a) -> b / e) -> Option<b> / e bounded =
  match o { None -> None, Some(x) -> Some(f(x)) }

/// The value through a step that may itself answer nothing.
pub fn Option::and_then<a, b | e>(o: Option<a>, f: (a) -> Option<b> / e) -> Option<b> / e bounded =
  match o { None -> None, Some(x) -> f(x) }

/// The value if it is there and `ok` answers true, and `None` otherwise.
pub fn Option::filter<a | e>(o: Option<a>, ok: (a) -> Bool / e) -> Option<a> / e bounded =
  match o { None -> None, Some(x) -> if ok(x) { Some(x) } else { None } }

/// The value if it is there, and `fallback` otherwise. Both are already evaluated, which
/// `Option::or_else` is for when the fallback is expensive.
pub fn Option::or<a>(o: Option<a>, fallback: Option<a>) -> Option<a> =
  match o { None -> fallback, Some(x) -> Some(x) }

/// The value, or `fallback` when there is none.
pub fn Option::unwrap_or<a>(o: Option<a>, fallback: a) -> a =
  match o { None -> fallback, Some(x) -> x }

/// The value, or the panic `message` names. This is the one place an absent value is a defect
/// rather than a case, so say why it cannot happen.
pub fn Option::expect<a>(o: Option<a>, message: String) -> a / {abort.raise} =
  match o { None -> panic(message), Some(x) -> x }

/// Whether there is a value.
pub fn Option::is_some<a>(o: Option<a>) -> Bool = match o { None -> false, Some(_) -> true }

/// Whether there is no value.
pub fn Option::is_none<a>(o: Option<a>) -> Bool = match o { None -> true, Some(_) -> false }

/// Whether the value is there and equals `x`.
pub fn Option::contains<a>(o: Option<a>, x: a) -> Bool
  where derivable(eq, a)
= match o { None -> false, Some(y) -> y == x }

/// The value as an `Ok`, or `err` as the `Err`.
pub fn Option::ok_or<a, e>(o: Option<a>, err: e) -> Result<a, e> =
  match o { None -> Err(err), Some(x) -> Ok(x) }

/// The value if it is there, and what `fallback` answers otherwise. The fallback only runs when it
/// is needed, which is what `Option::or` is for when it is not expensive.
pub fn Option::or_else<a | e>(
  o: Option<a>,
  fallback: () -> Option<a> / e,
) -> Option<a> / e bounded = match o { None -> fallback(), Some(x) -> Some(x) }

/// The value, or what `fallback` answers when there is none; `fallback` runs only then.
pub fn Option::unwrap_or_else<a | e>(o: Option<a>, fallback: () -> a / e) -> a / e bounded =
  match o { None -> fallback(), Some(x) -> x }

/// `f` of the value, or `fallback` untouched.
pub fn Option::map_or<a, b | e>(o: Option<a>, fallback: b, f: (a) -> b / e) -> b / e bounded =
  match o { None -> fallback, Some(x) -> f(x) }

/// Both values as a pair when both are there, and `None` when either is missing.
pub fn Option::zip<a, b>(o: Option<a>, p: Option<b>) -> Option<(a, b)> =
  match ((o, p)) { (Some(x), Some(y)) -> Some((x, y)), _ -> None }

/// The option an option holds, and `None` where either layer is missing.
pub fn Option::flatten<a>(o: Option<Option<a>>) -> Option<a> =
  match o { None -> None, Some(inner) -> inner }

/// The value as a list of one, or the empty list: what a list of options is gathered through.
pub fn Option::to_list<a>(o: Option<a>) -> List<a>
  returns fresh
= match o { None -> [], Some(x) -> [x] }

/// The layers the other way round: a missing value is a success that holds none, and a failure
/// stays the failure. `Result::transpose` goes back.
pub fn Option::transpose<a, e>(o: Option<Result<a, e>>) -> Result<Option<a>, e> =
  match o { None -> Ok(None), Some(Ok(x)) -> Ok(Some(x)), Some(Err(e)) -> Err(e) }

/// A fold whose step may answer nothing: `f` of the state and each element in order, or `None`
/// where a step answers none. `f` is not called for what follows.
pub fn Option::try_fold<a, s | e>(
  xs: List<a>,
  init: s,
  f: (s, a) -> Option<s> / e cost k,
) -> Option<s> / e
  cost xs.len() * k
=
  match xs {
    [] -> Some(init),
    [x, ..rest] -> match f(init, x) {
      None -> None,
      Some(state) -> Option::try_fold(rest, state, f),
    },
  }

/// `f` of each element in order, or `None` where `f` answers none. Nothing past the first `None`
/// is read.
pub fn Option::traverse<a, b | e>(
  xs: List<a>,
  f: (a) -> Option<b> / e cost k,
) -> Option<List<b>> / e
  cost xs.len() * k
= traversed(xs, f, [])

fn traversed<a, b | e>(
  xs: List<a>,
  f: (a) -> Option<b> / e cost k,
  done: List<b>,
) -> Option<List<b>> / e
  cost xs.len() * k
=
  match xs {
    [] -> Some(done),
    [x, ..rest] -> match f(x) { None -> None, Some(y) -> traversed(rest, f, done.push(y)) },
  }

/// Every value in order, or `None` where one is missing. What follows the first `None` is not
/// read.
pub fn Option::all<a>(os: List<Option<a>>) -> Option<List<a>>
  cost os.len()
= all_onto(os, [])

fn all_onto<a>(os: List<Option<a>>, done: List<a>) -> Option<List<a>> =
  match os {
    [] -> Some(done),
    [None, ..] -> None,
    [Some(x), ..rest] -> all_onto(rest, done.push(x)),
  }

// --- Tests ------------------------------------------------------------------

test "the combinators answer the absence rather than raising" {
  assert_eq(Some(2).map(|x: Int| x * 3), Some(6));
  assert_eq(Option::map(None, |x: Int| x * 3), None);
  assert_eq(Some(2).and_then(|x: Int| Some(x + 1)), Some(3));
  assert_eq(Some(2).and_then(|_: Int| None), None);
  assert_eq(Some(4).filter(|x: Int| x > 3), Some(4));
  assert_eq(Some(2).filter(|x: Int| x > 3), None);
  assert_eq(Option::or(None, Some(9)), Some(9));
  assert_eq(Some(1).or(Some(9)), Some(1));
  assert_eq(Option::unwrap_or(None, 9), 9);
  assert_eq(Some(1).unwrap_or(9), 1);
  assert_eq(Some(1).ok_or("missing"), Ok(1));
  assert_eq(Option::ok_or(None, "missing"), Err("missing"));
  assert(Some(1).is_some());
  assert(Option::is_none(None));
  assert_eq(Some(7).expect("cannot happen"), 7)
}

test "an option contains only the value it holds" {
  assert(Some(3).contains(3));
  assert(!Some(3).contains(4));
  assert(!Option::contains(None, 3))
}

test "two options zip into a pair only when both are there" {
  assert_eq(Some(1).zip(Some("one")), Some((1, "one")));
  assert_eq(Some(1).zip(None), None);
  assert_eq(Option::zip(None, Some("one")), None)
}

test "the else-combinators only run the fallback they need" {
  assert_eq(Option::or_else(None, || Some(9)), Some(9));
  assert_eq(Some(1).or_else(|| Some(9)), Some(1));
  assert_eq(Option::unwrap_or_else(None, || 9), 9);
  assert_eq(Some(1).unwrap_or_else(|| 9), 1);
  assert_eq(Some(2).map_or(0, |x: Int| x * 3), 6);
  assert_eq(Option::map_or(None, 0, |x: Int| x * 3), 0)
}

test "a callback may perform effects, and runs only where the value calls for it" {
  let calls = with_cell[calls](0) { c -> {
    let tick = |x: Int| {
      cell_update(c, |n: Int| n + 1);
      x
    };
    assert_eq(Some(2).map(|x: Int| tick(x) * 3), Some(6));
    assert_eq(Option::map(None, |x: Int| tick(x) * 3), None);
    assert_eq(Option::unwrap_or_else(None, || tick(5)), 5);
    assert_eq(Some(1).unwrap_or_else(|| tick(5)), 1);
    cell_get(c)
  } };
  assert_eq(calls, 2)
}

test "an option is a list of at most one, and a list of options gathers into the values there" {
  assert_eq(Some(3).to_list(), [3]);
  assert_eq(Option::to_list(None), []);
  let gathered = [Some(1), None, Some(2)].fold([], |acc: List<Int>, o: Option<Int>|
    o.to_list().fold(acc, |xs: List<Int>, x: Int| xs.push(x)));
  assert_eq(gathered, [1, 2])
}

test "a nested option flattens to its inner one, and the layers of a result swap" {
  assert_eq(Some(Some(1)).flatten(), Some(1));
  let inner_missing: Option<Option<Int>> = Some(None);
  assert_eq(inner_missing.flatten(), None);
  let outer_missing: Option<Option<Int>> = None;
  assert_eq(outer_missing.flatten(), None);
  let found: Option<Result<Int, String>> = Some(Ok(1));
  assert_eq(found.transpose(), Ok(Some(1)));
  let failed: Option<Result<Int, String>> = Some(Err("bad"));
  assert_eq(failed.transpose(), Err("bad"));
  let absent: Option<Result<Int, String>> = None;
  assert_eq(absent.transpose(), Ok(None))
}

test "option_all keeps every value in order, or answers nothing where one is missing" {
  assert_eq(Option::all([Some(1), Some(2), Some(3)]), Some([1, 2, 3]));
  assert_eq(Option::all([Some(1), None, Some(3)]), None);
  let none: List<Option<Int>> = [];
  assert_eq(Option::all(none), Some([]))
}

test "a traverse maps and gathers, and a fold threads its state until a step answers nothing" {
  assert_eq(Option::traverse([1, 2, 3], |x: Int| Some(x * 2)), Some([2, 4, 6]));
  assert_eq(Option::traverse([1, 2, 3], |x: Int| if x == 2 { None } else { Some(x) }), None);
  assert_eq(Option::try_fold([1, 2, 3], 10, |sum: Int, x: Int| Some(sum + x)), Some(16));
  assert_eq(
    Option::try_fold([1, 2, 3], 0, |sum: Int, x: Int| if x > 2 { None } else { Some(sum + x) }),
    None,
  )
}

test "a walk calls nothing past the first element that answers none" {
  let calls = with_cell[calls](0) { c -> {
    let seen = |x: Int| {
      cell_update(c, |n: Int| n + 1);
      if x == 2 { None } else { Some(x) }
    };
    assert_eq(Option::traverse([1, 2, 3, 4, 5], seen), None);
    cell_get(c)
  } };
  assert_eq(calls, 2)
}

test "a traverse and a fold that answer none first take the same steps whatever follows" {
  let short = [0 - 1, 2, 4, 6];
  let long = range(0, 4000).fold([0 - 1], |acc: List<Int>, i: Int| acc.push(i));
  let kept = |x: Int| if x < 0 { None } else { Some(x) };
  let stepped = |sum: Int, x: Int| if x < 0 { None } else { Some(sum + x) };
  assert_eq(
    metered(|| Option::traverse(long, kept)).steps,
    metered(|| Option::traverse(short, kept)).steps,
  );
  assert_eq(
    metered(|| Option::try_fold(long, 0, stepped)).steps,
    metered(|| Option::try_fold(short, 0, stepped)).steps,
  )
}

type Nested = | Leaf(Int) | Branch(List<Nested>)

/// The leaves in order, or `None` where one is negative: a recursion through `Option::traverse`.
fn leaves(t: Nested) -> Option<List<Int>> =
  match t {
    Leaf(n) -> if n < 0 { None } else { Some([n]) },
    Branch(kids) ->
      Option::traverse(kids, leaves).map(|found: List<List<Int>>|
        found.fold([], |all: List<Int>, some: List<Int>|
          some.fold(all, |acc: List<Int>, n: Int| acc.push(n)))),
  }

test "a definition that recurses through a traverse is seen to end" {
  assert_eq(leaves(Branch([Leaf(1), Branch([Leaf(2), Leaf(3)]), Leaf(4)])), Some([1, 2, 3, 4]));
  assert_eq(leaves(Branch([Leaf(1), Branch([Leaf(0 - 2), Leaf(3)])])), None)
}

fn missing_first(n: Int) -> List<Option<Int>> =
  range(0, n).map(|i: Int| if i == 0 { None } else { Some(i) })

test "a missing value at the front ends the walk in the same steps whatever follows it" {
  let short = missing_first(4);
  let long = missing_first(4000);
  assert_eq(metered(|| Option::all(long)).steps, metered(|| Option::all(short)).steps)
}

/// What `Option::all` answers, by a fold that reads every element.
fn all_by_fold(os: List<Option<Int>>) -> Option<List<Int>> =
  os.fold(Some([]), |acc: Option<List<Int>>, o: Option<Int>|
    match ((acc, o)) { (Some(xs), Some(x)) -> Some(xs.push(x)), _ -> None })

test "option_all answers what a fold over every element does" {
  gen::check(gen::list(gen::option_of(gen::any_int())), |x: List<Option<Int>>|
    agrees(Option::all, all_by_fold, x))
}

law "an option wrapped once more flattens to itself" =
  inverse(|o: Option<Int>| Some(o), Option::flatten)
