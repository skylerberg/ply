//! What a program wants over an `Option<a>` and the prelude does not carry.
//!
//! `Option`'s constructors are the prelude's (`Some`, `None`), and `?` propagates one. What is missing
//! is the combinators a chain reads with, each `option_`-prefixed because `map` and `and_then` are
//! names a program already has (for lists, and for `std.parse`), and an unqualified `map` that silently
//! took an `Option` would be a trap. A callback may perform effects, and runs only where the value
//! calls for it: `option_map` of `None` never calls `f`.
//!
//! Over a list, `option_all` answers every value or nothing and reads nothing past the first `None`.
//! `option_traverse` maps and gathers in one pass and `option_try_fold` threads a state: neither
//! reads past the first `None`, and a definition that recurses through the callback of either is
//! seen to end as it is through `fold`.

import std.laws (agrees, inverse)

/// The value through `f`, if there is one.
pub fn option_map<a, b | e>(o: Option<a>, f: (a) -> b / e) -> Option<b> / e bounded =
  match o { None -> None, Some(x) -> Some(f(x)) }

/// The value through a step that may itself answer nothing.
pub fn option_and_then<a, b | e>(o: Option<a>, f: (a) -> Option<b> / e) -> Option<b> / e bounded =
  match o { None -> None, Some(x) -> f(x) }

/// The value if it is there and `ok` answers true, and `None` otherwise.
pub fn option_filter<a | e>(o: Option<a>, ok: (a) -> Bool / e) -> Option<a> / e bounded =
  match o { None -> None, Some(x) -> if ok(x) { Some(x) } else { None } }

/// The value if it is there, and `fallback` otherwise. Both are already evaluated, which
/// `option_or_else` is for when the fallback is expensive.
pub fn option_or<a>(o: Option<a>, fallback: Option<a>) -> Option<a> =
  match o { None -> fallback, Some(x) -> Some(x) }

/// The value, or `fallback` when there is none.
pub fn option_unwrap_or<a>(o: Option<a>, fallback: a) -> a =
  match o { None -> fallback, Some(x) -> x }

/// The value, or the panic `message` names. This is the one place an absent value is a defect
/// rather than a case, so say why it cannot happen.
pub fn option_expect<a>(o: Option<a>, message: String) -> a / {abort.raise} =
  match o { None -> panic(message), Some(x) -> x }

/// Whether there is a value.
pub fn option_is_some<a>(o: Option<a>) -> Bool = match o { None -> false, Some(_) -> true }

/// Whether there is no value.
pub fn option_is_none<a>(o: Option<a>) -> Bool = match o { None -> true, Some(_) -> false }

/// Whether the value is there and equals `x`.
pub fn option_contains<a>(o: Option<a>, x: a) -> Bool
  where derivable(eq, a)
= match o { None -> false, Some(y) -> y == x }

/// The value as an `Ok`, or `err` as the `Err`.
pub fn option_ok_or<a, e>(o: Option<a>, err: e) -> Result<a, e> =
  match o { None -> Err(err), Some(x) -> Ok(x) }

/// The value if it is there, and what `fallback` answers otherwise. The fallback only runs when it
/// is needed, which is what `option_or` is for when it is not expensive.
pub fn option_or_else<a | e>(o: Option<a>, fallback: () -> Option<a> / e) -> Option<a> / e bounded =
  match o { None -> fallback(), Some(x) -> Some(x) }

/// The value, or what `fallback` answers when there is none; `fallback` runs only then.
pub fn option_unwrap_or_else<a | e>(o: Option<a>, fallback: () -> a / e) -> a / e bounded =
  match o { None -> fallback(), Some(x) -> x }

/// `f` of the value, or `fallback` untouched.
pub fn option_map_or<a, b | e>(o: Option<a>, fallback: b, f: (a) -> b / e) -> b / e bounded =
  match o { None -> fallback, Some(x) -> f(x) }

/// Both values as a pair when both are there, and `None` when either is missing.
pub fn option_zip<a, b>(o: Option<a>, p: Option<b>) -> Option<(a, b)> =
  match ((o, p)) { (Some(x), Some(y)) -> Some((x, y)), _ -> None }

/// The option an option holds, and `None` where either layer is missing.
pub fn option_flatten<a>(o: Option<Option<a>>) -> Option<a> =
  match o { None -> None, Some(inner) -> inner }

/// The value as a list of one, or the empty list: what a list of options is gathered through.
pub fn option_to_list<a>(o: Option<a>) -> List<a>
  returns fresh
= match o { None -> [], Some(x) -> [x] }

/// The layers the other way round: a missing value is a success that holds none, and a failure
/// stays the failure. `std.result`'s `result_transpose` goes back.
pub fn option_transpose<a, e>(o: Option<Result<a, e>>) -> Result<Option<a>, e> =
  match o { None -> Ok(None), Some(Ok(x)) -> Ok(Some(x)), Some(Err(e)) -> Err(e) }

/// A fold whose step may answer nothing: `f` of the state and each element in order, or `None`
/// where a step answers none. `f` is not called for what follows.
pub fn option_try_fold<a, s | e>(
  xs: List<a>,
  init: s,
  f: (s, a) -> Option<s> / e cost k,
) -> Option<s> / e
  cost len(xs) * k
=
  match xs {
    [] -> Some(init),
    [x, ..rest] -> match f(init, x) {
      None -> None,
      Some(state) -> option_try_fold(rest, state, f),
    },
  }

/// `f` of each element in order, or `None` where `f` answers none. Nothing past the first `None`
/// is read.
pub fn option_traverse<a, b | e>(xs: List<a>, f: (a) -> Option<b> / e cost k) -> Option<List<b>> / e
  cost len(xs) * k
= traversed(xs, f, [])

fn traversed<a, b | e>(
  xs: List<a>,
  f: (a) -> Option<b> / e cost k,
  done: List<b>,
) -> Option<List<b>> / e
  cost len(xs) * k
=
  match xs {
    [] -> Some(done),
    [x, ..rest] -> match f(x) { None -> None, Some(y) -> traversed(rest, f, push(done, y)) },
  }

/// Every value in order, or `None` where one is missing. What follows the first `None` is not
/// read.
pub fn option_all<a>(os: List<Option<a>>) -> Option<List<a>>
  cost len(os)
= all_onto(os, [])

fn all_onto<a>(os: List<Option<a>>, done: List<a>) -> Option<List<a>> =
  match os {
    [] -> Some(done),
    [None, ..] -> None,
    [Some(x), ..rest] -> all_onto(rest, push(done, x)),
  }

// --- Tests ------------------------------------------------------------------

test "the combinators answer the absence rather than raising" {
  assert_eq(option_map(Some(2), |x: Int| x * 3), Some(6));
  assert_eq(option_map(None, |x: Int| x * 3), None);
  assert_eq(option_and_then(Some(2), |x: Int| Some(x + 1)), Some(3));
  assert_eq(option_and_then(Some(2), |_: Int| None), None);
  assert_eq(option_filter(Some(4), |x: Int| x > 3), Some(4));
  assert_eq(option_filter(Some(2), |x: Int| x > 3), None);
  assert_eq(option_or(None, Some(9)), Some(9));
  assert_eq(option_or(Some(1), Some(9)), Some(1));
  assert_eq(option_unwrap_or(None, 9), 9);
  assert_eq(option_unwrap_or(Some(1), 9), 1);
  assert_eq(option_ok_or(Some(1), "missing"), Ok(1));
  assert_eq(option_ok_or(None, "missing"), Err("missing"));
  assert(option_is_some(Some(1)));
  assert(option_is_none(None));
  assert_eq(option_expect(Some(7), "cannot happen"), 7)
}

test "an option contains only the value it holds" {
  assert(option_contains(Some(3), 3));
  assert(!option_contains(Some(3), 4));
  assert(!option_contains(None, 3))
}

test "two options zip into a pair only when both are there" {
  assert_eq(option_zip(Some(1), Some("one")), Some((1, "one")));
  assert_eq(option_zip(Some(1), None), None);
  assert_eq(option_zip(None, Some("one")), None)
}

test "the else-combinators only run the fallback they need" {
  assert_eq(option_or_else(None, || Some(9)), Some(9));
  assert_eq(option_or_else(Some(1), || Some(9)), Some(1));
  assert_eq(option_unwrap_or_else(None, || 9), 9);
  assert_eq(option_unwrap_or_else(Some(1), || 9), 1);
  assert_eq(option_map_or(Some(2), 0, |x: Int| x * 3), 6);
  assert_eq(option_map_or(None, 0, |x: Int| x * 3), 0)
}

test "a callback may perform effects, and runs only where the value calls for it" {
  let calls = with_cell[calls](0) { c -> {
    let tick = |x: Int| {
      cell_update(c, |n: Int| n + 1);
      x
    };
    assert_eq(option_map(Some(2), |x: Int| tick(x) * 3), Some(6));
    assert_eq(option_map(None, |x: Int| tick(x) * 3), None);
    assert_eq(option_unwrap_or_else(None, || tick(5)), 5);
    assert_eq(option_unwrap_or_else(Some(1), || tick(5)), 1);
    cell_get(c)
  } };
  assert_eq(calls, 2)
}

test "an option is a list of at most one, and a list of options gathers into the values there" {
  assert_eq(option_to_list(Some(3)), [3]);
  assert_eq(option_to_list(None), []);
  let gathered = fold([Some(1), None, Some(2)], [], |acc: List<Int>, o: Option<Int>|
    fold(option_to_list(o), acc, |xs: List<Int>, x: Int| push(xs, x)));
  assert_eq(gathered, [1, 2])
}

test "a nested option flattens to its inner one, and the layers of a result swap" {
  assert_eq(option_flatten(Some(Some(1))), Some(1));
  let inner_missing: Option<Option<Int>> = Some(None);
  assert_eq(option_flatten(inner_missing), None);
  let outer_missing: Option<Option<Int>> = None;
  assert_eq(option_flatten(outer_missing), None);
  let found: Option<Result<Int, String>> = Some(Ok(1));
  assert_eq(option_transpose(found), Ok(Some(1)));
  let failed: Option<Result<Int, String>> = Some(Err("bad"));
  assert_eq(option_transpose(failed), Err("bad"));
  let absent: Option<Result<Int, String>> = None;
  assert_eq(option_transpose(absent), Ok(None))
}

test "option_all keeps every value in order, or answers nothing where one is missing" {
  assert_eq(option_all([Some(1), Some(2), Some(3)]), Some([1, 2, 3]));
  assert_eq(option_all([Some(1), None, Some(3)]), None);
  let none: List<Option<Int>> = [];
  assert_eq(option_all(none), Some([]))
}

test "a traverse maps and gathers, and a fold threads its state until a step answers nothing" {
  assert_eq(option_traverse([1, 2, 3], |x: Int| Some(x * 2)), Some([2, 4, 6]));
  assert_eq(option_traverse([1, 2, 3], |x: Int| if x == 2 { None } else { Some(x) }), None);
  assert_eq(option_try_fold([1, 2, 3], 10, |sum: Int, x: Int| Some(sum + x)), Some(16));
  assert_eq(
    option_try_fold([1, 2, 3], 0, |sum: Int, x: Int| if x > 2 { None } else { Some(sum + x) }),
    None,
  )
}

test "a walk calls nothing past the first element that answers none" {
  let calls = with_cell[calls](0) { c -> {
    let seen = |x: Int| {
      cell_update(c, |n: Int| n + 1);
      if x == 2 { None } else { Some(x) }
    };
    assert_eq(option_traverse([1, 2, 3, 4, 5], seen), None);
    cell_get(c)
  } };
  assert_eq(calls, 2)
}

test "a traverse and a fold that answer none first take the same steps whatever follows" {
  let short = [0 - 1, 2, 4, 6];
  let long = fold(range(0, 4000), [0 - 1], |acc: List<Int>, i: Int| push(acc, i));
  let kept = |x: Int| if x < 0 { None } else { Some(x) };
  let stepped = |sum: Int, x: Int| if x < 0 { None } else { Some(sum + x) };
  assert_eq(
    metered(|| option_traverse(long, kept)).steps,
    metered(|| option_traverse(short, kept)).steps,
  );
  assert_eq(
    metered(|| option_try_fold(long, 0, stepped)).steps,
    metered(|| option_try_fold(short, 0, stepped)).steps,
  )
}

type Nested = | Leaf(Int) | Branch(List<Nested>)

/// The leaves in order, or `None` where one is negative: a recursion through `option_traverse`.
fn leaves(t: Nested) -> Option<List<Int>> =
  match t {
    Leaf(n) -> if n < 0 { None } else { Some([n]) },
    Branch(kids) ->
      option_map(option_traverse(kids, leaves), |found: List<List<Int>>|
        fold(found, [], |all: List<Int>, some: List<Int>|
          fold(some, all, |acc: List<Int>, n: Int| push(acc, n)))),
  }

test "a definition that recurses through a traverse is seen to end" {
  assert_eq(leaves(Branch([Leaf(1), Branch([Leaf(2), Leaf(3)]), Leaf(4)])), Some([1, 2, 3, 4]));
  assert_eq(leaves(Branch([Leaf(1), Branch([Leaf(0 - 2), Leaf(3)])])), None)
}

fn missing_first(n: Int) -> List<Option<Int>> =
  map(range(0, n), |i: Int| if i == 0 { None } else { Some(i) })

test "a missing value at the front ends the walk in the same steps whatever follows it" {
  let short = missing_first(4);
  let long = missing_first(4000);
  assert_eq(metered(|| option_all(long)).steps, metered(|| option_all(short)).steps)
}

/// What `option_all` answers, by a fold that reads every element.
fn all_by_fold(os: List<Option<Int>>) -> Option<List<Int>> =
  fold(os, Some([]), |acc: Option<List<Int>>, o: Option<Int>|
    match ((acc, o)) { (Some(xs), Some(x)) -> Some(push(xs, x)), _ -> None })

law "option_all answers what a fold over every element does" = agrees(option_all, all_by_fold)

law "a traverse is the map and then option_all"
  forall (xs: List<Int>) {
    option_traverse(xs, odd) == option_all(map(xs, odd))
  }

law "a fold whose step always answers is the fold"
  forall (xs: List<Int>) {
    option_try_fold(xs, [], |done: List<Int>, x: Int| Some(push(done, x))) == Some(xs)
  }

law "an option wrapped once more flattens to itself" =
  inverse(|o: Option<Int>| Some(o), option_flatten)

law "a zip holds both values exactly when both are there"
  forall (o: Option<Int>, p: Option<Bool>) {
    match option_zip(o, p) {
      Some(pair) -> o == Some(pair._0) && p == Some(pair._1),
      None -> o == None || p == None,
    }
  }

law "a transpose keeps what each layer held"
  forall (o: Option<Result<Int, Bool>>) {
    match option_transpose(o) {
      Ok(None) -> o == None,
      Ok(Some(x)) -> o == Some(Ok(x)),
      Err(e) -> o == Some(Err(e)),
    }
  }

fn odd(x: Int) -> Option<Int> = if x % 2 == 0 { None } else { Some(x) }
