//! SQLite: an embedded SQL database, a file under a root or an image in memory.
//!
//! The effect's label is a database's root, bound as `std.fs`'s are: `--fs app=./data` lends the
//! directory, and `sqlite.query[app]` reads a database under it. A path that leaves its root is
//! `E0452`, an unbound label `E0451`, and no part of a database's path, nor the journal beside it,
//! may be a symbolic link. One writer writes a database at a time, so two endpoints that write
//! `[app]` conflict and two that query it do not. The engine is SQLite 3.53.2, compiled into
//! `ply` and the same on every machine.
//!
//! A connection is opened under a `with_hold`, which closes it however its body ends:
//! `with_hold[db](sqlite::opening[app]("app.db", sqlite::Create, options), |c| sqlite::close(c))
//! { conn -> .. }`. It is opened once with settings no statement can change: write-ahead
//! logging, foreign keys enforced, the wait `Options.busy_ms` on another connection's lock,
//! defensive mode, an untrusted schema, no extension loading, no attached database, no temporary
//! or virtual table, and, with `Options.strict`, no table that is not `STRICT` (declare tables
//! `STRICT` either way: without it a column takes any value). The engine's authorizer holds a
//! statement to that inside the engine, so a view or a trigger is held to it too: `ATTACH`,
//! `DETACH` and `VACUUM` are refused, as is a pragma outside `user_version`, `application_id`,
//! `optimize` and the ones that describe a schema or check it, and a function outside
//! `functions()`.
//!
//! A statement is a `Bound`: text the reader has read, and its parameters. `bound(stmt(".."), ps)`
//! makes one of text a program built, and the tag `sqlite"insert into t (a) values ({PInt(n)})"`
//! one whose text is read when the program is checked and whose holes are its parameters, bound
//! as `?1`, `?2`; nothing a hole holds is ever statement text. The parameters are `std.sql`'s
//! `Param`: null, an integer, a float, text and bytes are what SQLite stores, and a `PBool` is
//! bound 1 or 0. A `Decimal`, a date, JSON and an array are the caller's to encode, as text or an
//! integer, so `PNumeric`, `PJson` and `PArray` are refused. `query` answers rows, each a
//! `std.sql` `Row`, read a column at a time by `int`, `float`, `text` and `bytes`, and through
//! `optional` where a column may be null; `execute` answers the rows a statement changed and the
//! row id it last inserted; `returning` is a write that answers rows; `run` answers either as
//! `std.sql`'s `Answer`. Every one takes its `Limits`, and there is no call without them.
//!
//! `transaction` runs its body between `BEGIN IMMEDIATE` and `COMMIT`, and rolls back if the body
//! raises or its task is cancelled; inside another it is a savepoint. `snapshot` is the same over
//! a transaction that only reads, which sees one state of the database throughout. `fold_rows`
//! reads a large answer a page at a time. `backup` writes a compacted copy under the same root.
//!
//! What is refused is raised as `sql.refused` with a `Refusal`: `Busy` is another connection
//! holding the lock past the wait, and is the one to retry (`is_retryable`); `Constraint` names
//! its kind and what the engine names, `table.column` for a unique, not-null or strict-type
//! failure, the constraint's name for a check, and nothing for a foreign key. `try` makes a
//! `Result` of any call.
//!
//! A statement reads no clock and draws no random number: `CURRENT_TIMESTAMP`, `random()` and
//! `randomblob()` are refused, and so is a date or time function given no time, the time `'now'`
//! or the modifier `'localtime'` or `'utc'`, whether written in the statement or bound to it. The
//! functions `last_insert_rowid()`, `changes()` and `total_changes()` are refused too, since
//! `execute` answers what they would; so is a row id of 9223372036854775807, past which the
//! engine draws row ids at random. What a statement answers is then a function of the database
//! and the values bound, and the same engine runs over an image in memory as the twin:
//! `in_memory[app](|| ..)` answers every operation from `sqlite_run`, a builtin that performs
//! nothing, so a test over it is deterministic and cached, a law may quantify over it, and
//! neither needs `--host`. The twin keeps a database for each path, gives a transaction its own
//! copy, and answers `Busy` at once to a second writer. It differs from a file in three ways: a
//! deferred foreign key is checked at its statement, not at the commit; `backup` copies the image
//! without compacting it; and each statement costs a copy of the database, so a test that fills a
//! large one belongs on a file under `--host`.
//!
//! A schema's version is `pragma user_version`: a migration is a `transaction` that reads it,
//! runs the statements past it and sets it.

import std.sql (Stmt, stmt, Param, PNull, PInt, PBool, PText, PBytes, PFloat, PNumeric, PJson,
                PArray, Datum, CNull, CInt, CFloat, CText, CBytes, Row, Answer, Rows, Count, Failed,
                Sqlite, scan_statement, refusal_byte)
import std.fs
import std.laws (agrees, round_trip)
import std.list (slice)
import std.math (rem_euclid)
import std.option (option_unwrap_or)

/// How a database file is opened: to be read, to be read and written, or made if it is not there.
pub type Mode = | ReadOnly | ReadWrite | Create

/// What a connection is opened with: whether every table it makes must be `STRICT`, the
/// milliseconds a statement waits on another connection's lock before it is `Busy`, and how many
/// prepared statements the connection keeps for the next statement of the same text.
pub type Options = { strict: Bool, busy_ms: Int, statements: Int }

/// What one statement may take and answer: the bytes of its text, its parameters, the rows it
/// answers, the bytes of the values in them (a text's or a blob's length, eight for a number),
/// and the steps of the engine's virtual machine it may run, in thousands. The steps bound its
/// work without a clock, so the same statement over the same database is refused or not alike.
pub type Limits = { sql_bytes: Int, params: Int, rows: Int, bytes: Int, steps: Int }

/// One value as the engine binds and answers it: `kind` is 0 for null, 1 an integer in `int`, 2 a
/// float in `real`, 3 text and 4 bytes, both in `bytes`.
pub type Scalar = { kind: Int, int: Int, real: Float, bytes: Bytes }

/// Why the engine did not do what it was asked: the word `refusal_of` types, the constraint,
/// limit or engine code it names, and the engine's own sentence.
pub type Failure = { kind: String, name: String, detail: String }

/// What the engine answered one operation: the columns and rows of a statement that answers
/// them, whether the statement could have changed the database, the rows it changed itself, the
/// row id it last inserted or 0, and why it did not run.
pub type Reply = {
  columns: List<String>,
  rows: List<List<Scalar>>,
  wrote: Bool,
  changed: Int,
  last_row_id: Int,
  failure: Option<Failure>,
}

/// One step of a connection's transaction. `Begin` takes the write lock at once and `BeginRead`
/// reads one snapshot; either is a savepoint inside a transaction, where `Commit` and `Rollback`
/// close the innermost.
pub type Control = | Begin | BeginRead | Commit | Rollback

/// A database under the root its label names. Every operation on a connection goes to the
/// engine one at a time, in the order it was performed.
pub nondet effect sqlite {
  /// Opens the database at `path`, answering the connection's number.
  write open[d](path: String, mode: Mode, options: Options) -> Result<Int, Failure>
  /// Closes a connection, rolling back what it left open; `false` for a number that names none.
  write close[d](conn: Int) -> Bool
  /// Runs a statement that only reads.
  read query[d](conn: Int, sql: String, params: List<Scalar>, limits: Limits) -> Reply
  /// Runs a statement that may write. One refused after it ran, for what it answered or what it
  /// left, leaves nothing behind.
  write execute[d](conn: Int, sql: String, params: List<Scalar>, limits: Limits) -> Reply
  /// Opens or closes a transaction or a savepoint.
  write control[d](conn: Int, step: Control) -> Reply
  /// Writes a compacted copy of the database to `path`, which holds nothing yet.
  write backup[d](conn: Int, path: String) -> Reply
  /// Opens a statement that only reads to be fetched a page at a time, answering its columns.
  /// Nothing else runs on the connection until `finish`.
  write cursor[d](conn: Int, sql: String, params: List<Scalar>, limits: Limits) -> Reply
  /// The next `rows` rows of the open statement; fewer is its end. `limits.rows` bounds all its
  /// pages together and `limits.bytes` each.
  write fetch[d](conn: Int, rows: Int) -> Reply
  /// Ends the open statement; `false` when none is open.
  write finish[d](conn: Int) -> Bool
}

/// What this module raises. It is an effect of its own, so code that handles every `sqlite`
/// operation, as the twin does, is deterministic though it may still be refused.
pub effect sql {
  /// A database did not do what it was asked.
  raise refused(why: Refusal)
}

/// The constraint a write broke: a unique index or a primary key, a foreign key, `NOT NULL`, a
/// `CHECK`, a `STRICT` column's type, or another the engine keeps (a trigger's `RAISE`).
pub type Violation = | Unique | ForeignKey | NotNull | Check | Datatype | Other

/// Why a database did not do what it was asked.
///
/// `Busy`: another connection holds the lock past the wait the connection was opened with.
/// `Constraint`: a write broke one, with what the engine names of it. `Unopened`: the database
/// did not open. `Refused`: the statement is one this module does not run, which the reader or
/// the engine's authorizer said before it ran. `Malformed`: the engine could not read the
/// statement, or it names what the database does not hold. `Over`: a limit its caller set, by its
/// field's name, or `value` for one text or blob past 64 MiB. `Mistyped`: a column does not hold
/// what a reader asked it for. `Closed`: the connection is closed, or its transaction was rolled
/// back under it. `Engine`: anything else, with the engine's code.
pub type Refusal =
  | Busy
  | Constraint(Violation, String)
  | Unopened(String)
  | Refused(String)
  | Malformed(String)
  | Over(String)
  | Mistyped(String, String)
  | Closed(String)
  | Engine(String, String)

/// Whether running the same thing again may succeed: only `Busy` says so.
pub fn is_retryable(why: Refusal) -> Bool = match why { Busy -> true, _ -> false }

/// What a `Failure` is as a `Refusal`.
pub fn refusal_of(f: Failure) -> Refusal =
  if f.kind == "busy" { Busy }
  else if f.kind == "unique" { Constraint(Unique, f.name) }
  else if f.kind == "foreign_key" { Constraint(ForeignKey, f.name) }
  else if f.kind == "not_null" { Constraint(NotNull, f.name) }
  else { refusal_of_rest(f) }

fn refusal_of_rest(f: Failure) -> Refusal =
  if f.kind == "check" { Constraint(Check, f.name) }
  else if f.kind == "datatype" { Constraint(Datatype, f.name) }
  else if f.kind == "constraint" { Constraint(Other, f.name) }
  else if f.kind == "unopened" { Unopened(f.detail) }
  else { refusal_of_last(f) }

fn refusal_of_last(f: Failure) -> Refusal =
  if f.kind == "refused" || f.kind == "writes" || f.kind == "read_only" || f.kind == "exists" {
    Refused(f.detail)
  } else if f.kind == "statement" { Malformed(f.detail) }
  else if f.kind == "too_large" { Over(f.name) }
  else if f.kind == "steps" { Over("steps") }
  else if f.kind == "closed" || f.kind == "aborted" { Closed(f.detail) }
  else { Engine(if f.name == "" { f.kind } else { f.name }, f.detail) }

/// The SQL functions a statement may call, in order.
pub fn functions() -> List<String> = sqlite_functions()

// --- A statement and its parameters ------------------------------------------------------

/// A statement the reader has read, with the values bound to its `?1`, `?2`.
pub opaque type Bound = | Bound(String, List<Scalar>)

/// `s` with `ps` bound to its placeholders, in order. Raises `Refused` for a statement the reader
/// refuses and for a parameter SQLite does not store.
pub fn bound(s: Stmt, ps: List<Param>) -> Bound / {sql.refused, abort.raise} =
  match scan_statement(Sqlite, s.sql) {
    Err(e) -> sql.refused(Refused(e.detail)),
    Ok(_) -> Bound(s.sql, scalars(ps)),
  }

/// The statement a `Bound` holds.
pub fn statement(b: Bound) -> Stmt = match b { Bound(sql, _) -> stmt(sql) }

/// A tagged literal with no hole: `sqlite"select count(*) from t"`, read when the program is
/// checked.
pub fn literal(text: String) -> Result<Bound, { message: String, offset: Int }> / {abort.raise} =
  match compile([text]) {
    Ok(s) -> Ok(Bound(s.sql, [])),
    Err(e) -> Err({ message: e.message, offset: e.offset }),
  }

/// The statement a tagged literal's texts make, each hole between two of them written `?1`,
/// `?2`: read when the program is checked, and refused there where the reader refuses it.
pub fn compile(
  texts: List<String>,
) -> Result<Stmt, { message: String, offset: Int, part: Int }> / {abort.raise} = {
  let sql = fold(range(0, len(texts)), "", |acc: String, i: Int|
    match list_at(texts, i) {
      Some(text) -> if i == 0 { text } else { acc ++ "?" ++ int_to_string(i) ++ text },
      None -> acc,
    });
  match scan_statement(Sqlite, sql) {
    Ok(_) -> Ok(stmt(sql)),
    Err(e) -> Err(placed(texts, option_unwrap_or(refusal_byte(e), 0), e.detail)),
  }
}

/// A tagged literal's statement with its holes bound, each a `Param`.
pub fn fill(c: Stmt, holes: List<Param>) -> Bound / {sql.refused} = Bound(c.sql, scalars(holes))

type Placing = { begins: Int, part: Int, offset: Int, found: Bool }

/// Byte `at` of the statement the texts make, as the text it stands in and the characters before
/// it there. A byte in a hole's `?n` stands at the end of the text before the hole.
fn placed(
  texts: List<String>,
  at: Int,
  message: String,
) -> { message: String, offset: Int, part: Int } / {abort.raise} = {
  let last = fold(
    range(0, len(texts)),
    { begins: 0, part: 0, offset: 0, found: false },
    |s: Placing, i: Int| {
      let text = bytes_of_string(option_unwrap_or(list_at(texts, i), ""));
      let begins = s.begins + (if i == 0 { 0 } else { 1 + string_len(int_to_string(i)) });
      let ends = begins + bytes_len(text);
      if s.found { s } else if at > ends {
        { begins: ends, part: i, offset: characters(text, bytes_len(text)), found: false }
      } else { { begins: ends, part: i, offset: characters(text, at - begins), found: true } }
    },
  );
  { message: message, offset: last.offset, part: last.part }
}

/// How many characters the first `n` bytes of `text` hold.
fn characters(text: Bytes, n: Int) -> Int / {abort.raise} =
  if n <= 0 { 0 }
  else { len(string_chars(string_of_bytes(bytes_slice(text, 0, min(n, bytes_len(text)))))) }

fn scalars(ps: List<Param>) -> List<Scalar> / {sql.refused} =
  map(range(0, len(ps)), |i: Int|
    match list_at(ps, i) { Some(p) -> scalar_of(p, i + 1), None -> null_scalar() })

fn null_scalar() -> Scalar = { kind: 0, int: 0, real: 0.0, bytes: b"" }

fn scalar_of(p: Param, place: Int) -> Scalar / {sql.refused} =
  match p {
    PNull -> null_scalar(),
    PInt(n) -> { kind: 1, int: n, real: 0.0, bytes: b"" },
    PBool(b) -> { kind: 1, int: if b { 1 } else { 0 }, real: 0.0, bytes: b"" },
    PFloat(x) -> { kind: 2, int: 0, real: x, bytes: b"" },
    PText(s) -> { kind: 3, int: 0, real: 0.0, bytes: bytes_of_string(s) },
    PBytes(b) -> { kind: 4, int: 0, real: 0.0, bytes: b },
    PNumeric(_) -> unbindable(place, "PNumeric", "a `Decimal`"),
    PJson(_) -> unbindable(place, "PJson", "JSON"),
    PArray(_) -> unbindable(place, "PArray", "an array"),
  }

fn unbindable<a>(place: Int, name: String, what: String) -> a / {sql.refused} =
  sql.refused(
    Refused(
      "parameter " ++ int_to_string(place) ++ " is a `" ++ name
        ++ "`, and SQLite stores null, integers, floats, text and bytes: encode "
        ++ what
        ++ " as a `PText` or a `PInt`",
    ),
  )

/// A column's value as `std.sql` writes one.
fn datum_of(s: Scalar) -> Datum / {abort.raise} =
  if s.kind == 1 { CInt(s.int) }
  else if s.kind == 2 { CFloat(s.real) }
  else if s.kind == 3 { CText(string_of_bytes(s.bytes)) }
  else if s.kind == 4 { CBytes(s.bytes) }
  else { CNull }

/// The rows of a reply, each by column name. Two columns of one name would be one entry, so a
/// statement that answers them is refused: name each with `as`.
fn rows_of(
  columns: List<String>,
  rows: List<List<Scalar>>,
) -> List<Row> / {sql.refused, abort.raise} = {
  let names = fold(columns, map_new(), |seen: Map<String, Unit>, c: String|
    map_insert(seen, c, ()));
  if map_len(names) != len(columns) {
    sql.refused(
      Refused(
        "the statement answers two columns of one name, and a row is read by name: name each with `as`",
      ),
    )
  } else {
    map(rows, |row: List<Scalar>|
      fold(range(0, len(columns)), map_new(), |acc: Row, i: Int|
        match ((list_at(columns, i), list_at(row, i))) {
          (Some(name), Some(value)) -> map_insert(acc, name, datum_of(value)),
          _ -> acc,
        }))
  }
}

fn settled(r: Reply) -> Reply / {sql.refused} =
  match r.failure { None -> r, Some(f) -> sql.refused(refusal_of(f)) }

// --- A connection ------------------------------------------------------------------------

/// An open database under the root `d`. What it holds is useless once its `with_hold` has closed
/// it: an operation on it then raises `Closed`.
pub opaque type Connection<[d]> = | Connection(Int)

/// The database at `path` under the root `d`, opened as `mode` and `options` say: what a
/// `with_hold` acquires. Raises `Unopened` where it does not open.
pub fn opening<[d]>(
  path: String,
  mode: Mode,
  options: Options,
) -> Connection<[d]> / {sqlite.open[d], sql.refused} =
  match sqlite.open[d](path, mode, options) {
    Ok(conn) -> Connection(conn),
    Err(f) -> sql.refused(refusal_of(f)),
  }

/// Closes a connection, rolling back a transaction it left open: what a `with_hold` over one
/// releases it with, written `|c| sqlite::close(c)`.
pub fn close<[d]>(c: Connection<[d]>) -> Unit / {sqlite.close[d]} =
  match c {
    Connection(conn) -> {
      sqlite.close[d](conn);
      ()
    },
  }

fn number<[d]>(c: Connection<[d]>) -> Int = match c { Connection(conn) -> conn }

/// The rows a statement that only reads answers. Raises `Refused` for one that could write.
pub fn query<[d]>(
  conn: Hold<Connection<[d]>>,
  q: Bound,
  limits: Limits,
) -> List<Row> / {hold.read, sqlite.query[d], sql.refused, abort.raise} =
  match q {
    Bound(sql, params) -> {
      let reply = settled(sqlite.query[d](number(hold_get(conn)), sql, params, limits));
      rows_of(reply.columns, reply.rows)
    },
  }

/// What a write did: the rows the statement itself changed, a trigger's not among them, and the
/// row id of the last row it inserted, or 0 where it inserted none.
pub type Changed = { rows: Int, last_row_id: Int }

/// Runs a statement that writes, a schema statement among them.
pub fn execute<[d]>(
  conn: Hold<Connection<[d]>>,
  q: Bound,
  limits: Limits,
) -> Changed / {hold.read, sqlite.execute[d], sql.refused} =
  match q {
    Bound(sql, params) -> {
      let reply = settled(sqlite.execute[d](number(hold_get(conn)), sql, params, limits));
      { rows: reply.changed, last_row_id: reply.last_row_id }
    },
  }

/// Runs a statement that writes and answers rows, as one with `returning` does.
pub fn returning<[d]>(
  conn: Hold<Connection<[d]>>,
  q: Bound,
  limits: Limits,
) -> List<Row> / {hold.read, sqlite.execute[d], sql.refused, abort.raise} =
  match q {
    Bound(sql, params) -> {
      let reply = settled(sqlite.execute[d](number(hold_get(conn)), sql, params, limits));
      rows_of(reply.columns, reply.rows)
    },
  }

/// What a statement answered as `std.sql` writes an answer: `Rows` where it answers columns,
/// `Count` of the rows it changed otherwise, and `Failed` in place of a raise, its `code` a
/// `Failure`'s `kind` and its `constraint` the `name`.
pub fn run<[d]>(
  conn: Hold<Connection<[d]>>,
  q: Bound,
  limits: Limits,
) -> Answer / {hold.read, sqlite.execute[d], abort.raise} =
  match q {
    Bound(sql, params) -> {
      let reply = sqlite.execute[d](number(hold_get(conn)), sql, params, limits);
      match reply.failure {
        Some(f) -> Failed({ code: f.kind, constraint: f.name, detail: f.detail }),
        None -> if len(reply.columns) == 0 { Count(reply.changed) } else {
          match try { rows_of(reply.columns, reply.rows) } {
            Ok(rows) -> Rows(rows),
            Err(_) ->
              Failed({
                code: "refused",
                constraint: "",
                detail: "the statement answers two columns of one name",
              }),
          }
        },
      }
    },
  }

/// `body` inside a transaction that holds the write lock from its start, so nothing in it waits
/// on a lock again: committed when the body returns, and rolled back when it raises, a clause
/// unwinds through it or its task is cancelled. Inside another transaction it is a savepoint,
/// which rolls back alone. Raises `Busy` where another connection holds the lock past the wait.
/// On a connection opened to read it takes no lock and is a `snapshot`.
pub fn transaction<a, [d] | e>(
  conn: Hold<Connection<[d]>>,
  body: () -> a / e,
) -> a / {hold.read, sqlite.control[d], sql.refused | e} =
  scoped[d](number(hold_get(conn)), Begin, body)

/// `body` inside a transaction that only reads: every query in it sees the database as it stood
/// at the first. A write in it raises `Busy` if another connection has written since.
pub fn snapshot<a, [d] | e>(
  conn: Hold<Connection<[d]>>,
  body: () -> a / e,
) -> a / {hold.read, sqlite.control[d], sql.refused | e} =
  scoped[d](number(hold_get(conn)), BeginRead, body)

fn scoped<a, [d] | e>(
  conn: Int,
  opens: Control,
  body: () -> a / e,
) -> a / {sqlite.control[d], sql.refused | e} = {
  settled(sqlite.control[d](conn, opens));
  with_cell[sqlite_scope](false) { closed ->
    bracket(
      || (),
      |_u: Unit|
        if !cell_get(closed) {
          sqlite.control[d](conn, Rollback);
          ()
        },
      |_u: Unit| {
        let value = body();
        // Whatever the commit answers, its scope is closed.
        cell_set(closed, true);
        settled(sqlite.control[d](conn, Commit));
        value
      },
    )
  }
}

/// `f` over each row a statement that only reads answers, fetched `page` rows at a time, so a
/// large answer is held a page at a time. `limits.rows` is the most rows it folds over, past
/// which it raises `Over`, and `limits.bytes` bounds each page. Nothing else runs on the
/// connection while it folds: `f` reads another connection, or gathers what it will write.
pub fn fold_rows<a, [d] | e>(
  conn: Hold<Connection<[d]>>,
  q: Bound,
  limits: Limits,
  page: Int,
  init: a,
  f: (a, Row) -> a / e,
) -> a / {hold.read, sqlite.cursor[d], sqlite.fetch[d], sqlite.finish[d], sql.refused, abort.raise | e} =
  match q {
    Bound(sql, params) -> {
      let id = number(hold_get(conn));
      if page < 1 { panic("a page is at least one row") } else {
        bracket(
          || settled(sqlite.cursor[d](id, sql, params, limits)).columns,
          |_c: List<String>| {
            sqlite.finish[d](id);
            ()
          },
          |columns: List<String>|
            iterate(init, max(limits.rows, 0) / page + 2, |acc: a| {
              let got = settled(sqlite.fetch[d](id, page));
              let next = fold(rows_of(columns, got.rows), acc, f);
              if len(got.rows) < page { Stop(next) } else { Continue(next) }
            }),
        )
      }
    },
  }

/// A compacted copy of the database written to `path` under the same root, which must hold
/// nothing yet: `VACUUM INTO`. The copy is a database of its own, consistent though others write
/// meanwhile. Raises `Malformed` inside a transaction, where the engine cannot copy.
pub fn backup<[d]>(
  conn: Hold<Connection<[d]>>,
  path: String,
) -> Unit / {hold.read, sqlite.backup[d], sql.refused} = {
  settled(sqlite.backup[d](number(hold_get(conn)), path));
  ()
}

// --- Reading a row -----------------------------------------------------------------------

fn held(row: Row, column: String) -> Datum / {sql.refused} =
  match map_get(row, column) {
    Some(value) -> value,
    None -> sql.refused(Mistyped(column, "a column of the answer")),
  }

/// The integer `column` holds. Raises `Mistyped` for anything else, null and no such column
/// included.
pub fn int(row: Row, column: String) -> Int / {sql.refused} =
  match held(row, column) { CInt(n) -> n, _ -> sql.refused(Mistyped(column, "an integer")) }

/// The float `column` holds. An integer is not one: a `STRICT` table's `REAL` column answers
/// floats, and an expression is cast.
pub fn float(row: Row, column: String) -> Float / {sql.refused} =
  match held(row, column) { CFloat(x) -> x, _ -> sql.refused(Mistyped(column, "a float")) }

/// The text `column` holds.
pub fn text(row: Row, column: String) -> String / {sql.refused} =
  match held(row, column) { CText(s) -> s, _ -> sql.refused(Mistyped(column, "text")) }

/// The bytes `column` holds.
pub fn bytes(row: Row, column: String) -> Bytes / {sql.refused} =
  match held(row, column) { CBytes(b) -> b, _ -> sql.refused(Mistyped(column, "bytes")) }

/// `None` where `column` holds null, and what `read` reads of it otherwise:
/// `optional(row, "note", sqlite::text)`.
pub fn optional<a | e>(
  row: Row,
  column: String,
  read: (Row, String) -> a / e,
) -> Option<a> / {sql.refused | e} =
  match held(row, column) { CNull -> None, _ -> Some(read(row, column)) }

// --- The twin ----------------------------------------------------------------------------

/// A statement a fold has open: the rows it answered, how many were fetched, and each page's
/// bound in bytes.
type Folding = { rows: List<List<Scalar>>, at: Int, bytes: Int }

/// A twin's connection. `saved` holds the image each open transaction and savepoint rolls back
/// to, outermost first, and `working` the image the transaction has made; `base` is the image it
/// began from and `writes` whether it holds the write lock.
type Open = {
  path: String,
  mode: Mode,
  strict: Bool,
  saved: List<Bytes>,
  working: Bytes,
  base: Bytes,
  writes: Bool,
  folding: Option<Folding>,
}

type Twin = { files: Map<String, Bytes>, open: Map<Int, Open>, writer: Map<String, Int>, next: Int }

type Stepped = { twin: Twin, reply: Reply }

/// The databases of one root, in memory: each path's bytes as a file would hold them, and the
/// connections open on them.
pub opaque type Memory = | Memory(Twin)

/// A root that holds no database.
pub fn memory() -> Memory =
  Memory({ files: map_new(), open: map_new(), writer: map_new(), next: 1 })

/// The bytes of the database at `path`, as a file would hold them: what was last committed.
pub fn stored(m: Memory, path: String) -> Option<Bytes> =
  match m { Memory(t) -> map_get(t.files, path) }

/// `m` with the database at `path` holding `image`, a database file's bytes.
pub fn storing(m: Memory, path: String, image: Bytes) -> Memory =
  match m { Memory(t) -> Memory({ ..t, files: map_insert(t.files, path, image) }) }

/// What `go` answered over a twin, and the twin it left.
pub type Over<a> = { value: a, memory: Memory }

/// `go` run over `m` as the root its row names, every operation answered by the engine over an
/// image in memory. It performs nothing, so a test or a law over it needs no `--host` and is
/// cached. A path that leaves the root raises with `E0452`'s words.
pub fn on_memory<a, [d] | e>(
  m: Memory,
  go: () -> a / {sqlite.read[d], sqlite.write[d] | e},
) -> Over<a> / {abort.raise | e bounded} =
  with_cell[sqlite_memory](match m { Memory(t) -> t }) { t -> {
    let stepped = |s: Stepped| {
      cell_set(t, s.twin);
      s.reply
    };
    let value = handle {
      go()
    } with {
      sqlite.open[d](path, mode, options) -> {
        let opened = twin_open(cell_get(t), path, mode, options);
        cell_set(t, opened.twin);
        opened.conn
      },
      sqlite.close[d](conn) -> {
        let now = cell_get(t);
        cell_set(t, twin_close(now, conn));
        map_contains(now.open, conn)
      },
      sqlite.query[d](conn, sql, params, limits) ->
        stepped(twin_run(cell_get(t), conn, sql, params, limits, true)),
      sqlite.execute[d](conn, sql, params, limits) ->
        stepped(twin_run(cell_get(t), conn, sql, params, limits, false)),
      sqlite.control[d](conn, step) -> stepped(twin_control(cell_get(t), conn, step)),
      sqlite.backup[d](conn, path) -> stepped(twin_backup(cell_get(t), conn, path)),
      sqlite.cursor[d](conn, sql, params, limits) ->
        stepped(twin_cursor(cell_get(t), conn, sql, params, limits)),
      sqlite.fetch[d](conn, rows) -> stepped(twin_fetch(cell_get(t), conn, rows)),
      sqlite.finish[d](conn) -> {
        let now = cell_get(t);
        match map_get(now.open, conn) {
          Some(o) -> {
            cell_set(t, { ..now, open: map_insert(now.open, conn, { ..o, folding: None }) });
            o.folding != None
          },
          None -> false,
        }
      },
    };
    { value: value, memory: Memory(cell_get(t)) }
  } }

/// `go` over a root that holds no database yet: what a test hands code written against a root.
pub fn in_memory<a, [d] | e>(
  go: () -> a / {sqlite.read[d], sqlite.write[d] | e},
) -> a / {abort.raise | e bounded} = on_memory[d](memory(), go).value

fn quiet() -> Reply =
  { columns: [], rows: [], wrote: false, changed: 0, last_row_id: 0, failure: None }

fn failing(kind: String, name: String, detail: String) -> Reply =
  { ..quiet(), failure: Some({ kind: kind, name: name, detail: detail }) }

fn unconnected() -> Reply = failing("closed", "", "no connection is open under this number")

fn locked() -> Reply = failing("busy", "", "database is locked")

fn folded() -> Reply =
  failing(
    "refused",
    "",
    "a fold is reading this connection: nothing else runs on it until the fold ends",
  )

fn confined(path: String) -> String / {abort.raise} =
  if fs::mem_confined(path) { path } else { panic("`" ++ path ++ "` leaves the root it was given") }

fn committed(t: Twin, path: String) -> Bytes = option_unwrap_or(map_get(t.files, path), b"")

/// The image a connection's next statement runs over: its transaction's, or the last committed.
fn image_of(t: Twin, o: Open) -> Bytes =
  if len(o.saved) > 0 { o.working } else { committed(t, o.path) }

fn written_by_another(t: Twin, path: String, conn: Int) -> Bool =
  match map_get(t.writer, path) { Some(holder) -> holder != conn, None -> false }

fn twin_open(
  t: Twin,
  path: String,
  mode: Mode,
  options: Options,
) -> { twin: Twin, conn: Result<Int, Failure> } / {abort.raise} = {
  let at = confined(path);
  if mode != Create && !map_contains(t.files, at) {
    { twin: t, conn: Err({ kind: "unopened", name: "", detail: "unable to open database file" }) }
  } else {
    let files = if map_contains(t.files, at) { t.files } else { map_insert(t.files, at, b"") };
    let opened = {
      path: at,
      mode: mode,
      strict: options.strict,
      saved: [],
      working: b"",
      base: b"",
      writes: false,
      folding: None,
    };
    {
      twin: { ..t, files: files, open: map_insert(t.open, t.next, opened), next: t.next + 1 },
      conn: Ok(t.next),
    }
  }
}

fn twin_close(t: Twin, conn: Int) -> Twin =
  match map_get(t.open, conn) {
    None -> t,
    Some(o) -> { ..unlocked(t, o, conn), open: map_remove(t.open, conn) },
  }

/// `t` with the write lock on a connection's database let go, where the connection holds it.
fn unlocked(t: Twin, o: Open, conn: Int) -> Twin =
  if map_get(t.writer, o.path) == Some(conn) { { ..t, writer: map_remove(t.writer, o.path) } }
  else { t }

fn replied(
  r: { image: Bytes, columns: List<String>, rows: List<List<Scalar>>, wrote: Bool, changed: Int, last_row_id: Int, failure: Option<Failure> },
) -> Reply =
  {
    columns: r.columns,
    rows: r.rows,
    wrote: r.wrote,
    changed: r.changed,
    last_row_id: r.last_row_id,
    failure: r.failure,
  }

fn twin_run(
  t: Twin,
  conn: Int,
  sql: String,
  params: List<Scalar>,
  limits: Limits,
  querying: Bool,
) -> Stepped =
  match map_get(t.open, conn) {
    None -> { twin: t, reply: unconnected() },
    Some(o) -> if o.folding != None { { twin: t, reply: folded() } } else {
      let ran = sqlite_run(
        image_of(t, o),
        sql,
        params,
        querying || o.mode == ReadOnly,
        o.strict,
        limits,
      );
      match ran.failure {
        Some(f) -> if f.kind == "writes" && !querying {
          {
            twin: t,
            reply: failing(
              "read_only",
              "",
              "this statement writes, and the connection was opened to read",
            ),
          }
        } else { { twin: t, reply: replied(ran) } },
        None -> if ran.wrote { twin_written(t, conn, o, ran.image, replied(ran)) }
        else { { twin: t, reply: replied(ran) } },
      }
    },
  }

/// A statement that wrote, kept: where another connection holds the write lock, or wrote since
/// this one's transaction began to read, it is `busy` and nothing is kept.
fn twin_written(t: Twin, conn: Int, o: Open, image: Bytes, reply: Reply) -> Stepped =
  if written_by_another(t, o.path, conn) { { twin: t, reply: locked() } }
  else if len(o.saved) == 0 {
    { twin: { ..t, files: map_insert(t.files, o.path, image) }, reply: reply }
  } else if !o.writes && committed(t, o.path) != o.base { { twin: t, reply: locked() } } else {
    {
      twin: {
        ..t,
        open: map_insert(t.open, conn, { ..o, working: image, writes: true }),
        writer: map_insert(t.writer, o.path, conn),
      },
      reply: reply,
    }
  }

fn twin_control(t: Twin, conn: Int, step: Control) -> Stepped =
  match map_get(t.open, conn) {
    None -> { twin: t, reply: unconnected() },
    Some(o) -> if o.folding != None { { twin: t, reply: folded() } } else {
      match step {
        Begin -> twin_begin(t, conn, o, true),
        BeginRead -> twin_begin(t, conn, o, false),
        Commit -> twin_end(t, conn, o, true),
        Rollback -> twin_end(t, conn, o, false),
      }
    },
  }

/// `asked` is whether the write lock was asked for, which a connection opened to read never
/// takes: its transaction reads, as the engine's does.
fn twin_begin(t: Twin, conn: Int, o: Open, asked: Bool) -> Stepped = {
  let writes = asked && o.mode != ReadOnly;
  if len(o.saved) >= 32 {
    { twin: t, reply: failing("refused", "", "a connection nests 32 transactions at most") }
  } else if len(o.saved) > 0 {
    {
      twin: { ..t, open: map_insert(t.open, conn, { ..o, saved: push(o.saved, o.working) }) },
      reply: quiet(),
    }
  } else if writes && written_by_another(t, o.path, conn) { { twin: t, reply: locked() } } else {
    let image = committed(t, o.path);
    {
      twin: {
        ..t,
        open: map_insert(t.open, conn, {
          ..o,
          saved: [image],
          working: image,
          base: image,
          writes: writes,
        }),
        writer: if writes { map_insert(t.writer, o.path, conn) } else { t.writer },
      },
      reply: quiet(),
    }
  }
}

/// The innermost scope closed: kept, or rolled back to the image it began from.
fn twin_end(t: Twin, conn: Int, o: Open, kept: Bool) -> Stepped = {
  let depth = len(o.saved);
  if depth == 0 { { twin: t, reply: failing("refused", "", "no transaction is open") } }
  else if depth > 1 {
    let outer = slice(o.saved, 0, depth - 1);
    let working = if kept { o.working }
    else { option_unwrap_or(list_at(o.saved, depth - 1), o.working) };
    {
      twin: { ..t, open: map_insert(t.open, conn, { ..o, saved: outer, working: working }) },
      reply: quiet(),
    }
  } else {
    let files = if kept && o.writes { map_insert(t.files, o.path, o.working) } else { t.files };
    let ended = { ..o, saved: [], working: b"", base: b"", writes: false };
    {
      twin: { ..unlocked(t, o, conn), files: files, open: map_insert(t.open, conn, ended) },
      reply: quiet(),
    }
  }
}

fn twin_backup(t: Twin, conn: Int, path: String) -> Stepped / {abort.raise} =
  match map_get(t.open, conn) {
    None -> { twin: t, reply: unconnected() },
    Some(o) -> {
      let to = confined(path);
      if o.folding != None { { twin: t, reply: folded() } } else if len(o.saved) > 0 {
        { twin: t, reply: failing("statement", "", "cannot VACUUM from within a transaction") }
      } else if map_contains(t.files, to) {
        {
          twin: t,
          reply: failing(
            "exists",
            "",
            "`" ++ path ++ "` is there already, and a backup writes a new file",
          ),
        }
      } else {
        { twin: { ..t, files: map_insert(t.files, to, committed(t, o.path)) }, reply: quiet() }
      }
    },
  }

fn twin_cursor(t: Twin, conn: Int, sql: String, params: List<Scalar>, limits: Limits) -> Stepped =
  match map_get(t.open, conn) {
    None -> { twin: t, reply: unconnected() },
    Some(o) -> if o.folding != None { { twin: t, reply: folded() } } else {
      // Every row at once: a page's bound is held to as each is fetched.
      let ran = sqlite_run(image_of(t, o), sql, params, true, o.strict, {
        ..limits,
        bytes: 9223372036854775807,
      });
      match ran.failure {
        Some(_) -> { twin: t, reply: replied(ran) },
        None -> {
          let folding = Some({ rows: ran.rows, at: 0, bytes: limits.bytes });
          {
            twin: { ..t, open: map_insert(t.open, conn, { ..o, folding: folding }) },
            reply: { ..quiet(), columns: ran.columns },
          }
        },
      }
    },
  }

fn twin_fetch(t: Twin, conn: Int, rows: Int) -> Stepped =
  match map_get(t.open, conn) {
    None -> { twin: t, reply: unconnected() },
    Some(o) -> match o.folding {
      None -> { twin: t, reply: failing("closed", "", "no fold is open on this connection") },
      Some(f) -> {
        let page = slice(f.rows, f.at, min(f.at + max(rows, 0), len(f.rows)));
        let size = fold(page, 0, |n: Int, row: List<Scalar>|
          fold(row, n, |m: Int, s: Scalar|
            m + (if s.kind == 0 { 0 } else if s.kind < 3 { 8 } else { bytes_len(s.bytes) })));
        if size > f.bytes {
          { twin: t, reply: failing("too_large", "bytes", "more than its caller allowed") }
        } else {
          let folding = Some({ ..f, at: f.at + len(page) });
          {
            twin: { ..t, open: map_insert(t.open, conn, { ..o, folding: folding }) },
            reply: { ..quiet(), rows: page },
          }
        }
      },
    },
  }

// --- Laws --------------------------------------------------------------------------------

fn roomy() -> Limits = { sql_bytes: 10000, params: 100, rows: 1000, bytes: 1000000, steps: 100000 }

fn plain() -> Options = { strict: true, busy_ms: 0, statements: 16 }

/// What a column of any type holds after `p` is written to it, read back through the engine.
fn kept(p: Param) -> Datum / {abort.raise} = {
  let read = try {
    in_memory[scratch](||
      with_hold[kept_value](opening[scratch]("v.db", Create, plain()), |c| close(c)) { conn -> {
        execute(conn, bound(stmt("create table v (x any) strict"), []), roomy());
        execute(conn, bound(stmt("insert into v (x) values (?1)"), [p]), roomy());
        held(
          option_unwrap_or(
            list_at(query(conn, bound(stmt("select x from v"), []), roomy()), 0),
            map_new(),
          ),
          "x",
        )
      } })
  };
  match read { Ok(d) -> d, Err(_) -> panic("a value was refused") }
}

law "an integer written is the integer read" =
  round_trip(|n: Int| kept(PInt(n)), |d: Datum| match d { CInt(n) -> Some(n), _ -> None })

law "text written is the text read" =
  round_trip(|s: String| kept(PText(s)), |d: Datum| match d { CText(s) -> Some(s), _ -> None })

law "bytes written are the bytes read" =
  round_trip(|b: Bytes| kept(PBytes(b)), |d: Datum| match d { CBytes(b) -> Some(b), _ -> None })

law "a float written is the float read, and a NaN is stored as null" =
  agrees(|x: Float| kept(PFloat(x)), |x: Float| if x != x { CNull } else { CFloat(x) })

/// The integers a table holds once `ns` are inserted in a transaction that then raises.
fn after_a_failed_transaction(ns: List<Int>) -> List<Int> / {abort.raise} = {
  let read = try {
    in_memory[scratch](||
      with_hold[rolled_back](opening[scratch]("t.db", Create, plain()), |c| close(c)) { conn -> {
        execute(conn, bound(stmt("create table t (n integer) strict"), []), roomy());
        execute(conn, bound(stmt("insert into t (n) values (7)"), []), roomy());
        let gave_up: Result<Unit, Refusal> = try {
          transaction(conn, || {
            map(ns, |n: Int|
              execute(conn, bound(stmt("insert into t (n) values (?1)"), [PInt(n)]), roomy()));
            sql.refused(Closed("the body gave up"))
          })
        };
        map(query(conn, bound(stmt("select n from t order by rowid"), []), roomy()), |row: Row|
          int(row, "n"))
      } })
  };
  match read { Ok(held) -> held, Err(_) -> panic("the table was not read") }
}

law "a transaction whose body raises changes nothing" =
  agrees(after_a_failed_transaction, |_: List<Int>| [7])

/// How many rows a query limited to `limit` answers of a table of `held`, or -1 where it is
/// refused.
fn answered(held: Int, limit: Int) -> Int / {abort.raise} = {
  let read = try {
    in_memory[scratch](||
      with_hold[limited](opening[scratch]("t.db", Create, plain()), |c| close(c)) { conn -> {
        execute(conn, bound(stmt("create table t (n integer) strict"), []), roomy());
        execute(
          conn,
          bound(
            stmt(
              "with recursive c(i) as (select 1 union all select i + 1 from c where i < ?1) insert into t select i from c where ?1 > 0",
            ),
            [PInt(held)],
          ),
          roomy(),
        );
        len(query(conn, bound(stmt("select n from t"), []), { ..roomy(), rows: limit }))
      } })
  };
  match read { Ok(n) -> n, Err(_) -> -1 }
}

// Each binder is folded into 0 to 23, so a law over every integer reads small tables.
law "a query answers every row within its limit, and is refused past it" =
  agrees(
    |c: { held: Int, limit: Int }| answered(rem_euclid(c.held, 24), rem_euclid(c.limit, 24)),
    |c: { held: Int, limit: Int }|
      if rem_euclid(c.held, 24) <= rem_euclid(c.limit, 24) { rem_euclid(c.held, 24) } else { -1 },
  )

fn unread() -> List<String> =
  [
    "select random()",
    "select randomblob(4)",
    "select current_timestamp",
    "select current_date",
    "select current_time",
    "select datetime('now')",
    "select date()",
    "select strftime('%s', 'now')",
    "select time('12:00', 'localtime')",
  ]

/// Whether `bound` refuses the statement, before any connection is asked.
fn refused_unrun(sql: String) -> Bool / {abort.raise} =
  match try { bound(stmt(sql), []) } { Err(Refused(_)) -> true, _ -> false }

law "a statement that reads the clock or draws a random number is refused before it runs" =
  agrees(
    |i: Int| refused_unrun(option_unwrap_or(list_at(unread(), rem_euclid(i, len(unread()))), "")),
    |_: Int| true,
  )

// --- Tests -------------------------------------------------------------------------------

fn s(sql: String) -> Bound / {sql.refused, abort.raise} = bound(stmt(sql), [])

fn numbers(rows: List<Row>, column: String) -> List<Int> / {sql.refused} =
  map(rows, |row: Row| int(row, column))

fn refusal<a | e>(go: () -> a / {sql.refused | e}) -> Option<Refusal> / e =
  match try[sql.refused] { go() } { Ok(_) -> None, Err(why) -> Some(why) }

test "a database written and closed is read back when it is opened again" {
  let wrote = over_twin(memory(), ||
    with_hold[first](opening[app]("data/app.db", Create, plain()), |c| close(c)) { conn -> {
      execute(
        conn,
        s("create table person (id integer primary key, name text not null) strict"),
        roomy(),
      );
      execute(conn, bound(stmt("insert into person (name) values (?1)"), [PText("Ada")]), roomy())
    } });
  let left = match wrote { Ok(over) -> over, Err(_) -> panic("the database was not written") };
  assert_eq(left.value, { rows: 1, last_row_id: 1 });
  let names = in_twin(left.memory, ||
    with_hold[second](opening[app]("data/app.db", ReadOnly, plain()), |c| close(c)) { conn ->
      map(query(conn, s("select id, name from person"), roomy()), |row: Row| text(row, "name"))
    });
  assert_eq(names, Ok(["Ada"]))
}

fn over_twin<a>(
  m: Memory,
  go: () -> a / {sqlite.read[app], sqlite.write[app], sql.refused, abort.raise},
) -> Result<Over<a>, Refusal> / {abort.raise} = try[sql.refused] { on_memory[app](m, go) }

fn in_twin<a>(
  m: Memory,
  go: () -> a / {sqlite.read[app], sqlite.write[app], sql.refused, abort.raise},
) -> Result<a, Refusal> / {abort.raise} = try[sql.refused] { on_memory[app](m, go).value }

fn fresh<a>(
  go: () -> a / {sqlite.read[app], sqlite.write[app], sql.refused, abort.raise},
) -> Result<a, Refusal> / {abort.raise} = in_twin(memory(), go)

test "a database that is not there opens only to be made" {
  assert_eq(
    fresh(||
      with_hold[missing](opening[app]("no.db", ReadWrite, plain()), |c| close(c)) { conn -> 1 }),
    Err(Unopened("unable to open database file")),
  );
  assert_eq(
    fresh(|| with_hold[made](opening[app]("no.db", Create, plain()), |c| close(c)) { conn -> 1 }),
    Ok(1),
  )
}

test "each kind of value is read by its reader, and null through optional" {
  let read = fresh(||
    with_hold[typed](opening[app]("t.db", Create, plain()), |c| close(c)) { conn -> {
      execute(
        conn,
        s("create table v (i integer, r real, t text, b blob, n text) strict"),
        roomy(),
      );
      execute(
        conn,
        bound(stmt("insert into v values (?1, ?2, ?3, ?4, ?5)"), [
          PInt(-9223372036854775807 - 1),
          PFloat(1.5),
          PText("a\0b \u{1F600}"),
          PBytes(b"\x00\xff"),
          PNull,
        ]),
        roomy(),
      );
      let rows = query(conn, s("select i, r, t, b, n from v"), roomy());
      let row = option_unwrap_or(list_at(rows, 0), map_new());
      {
        i: int(row, "i"),
        r: float(row, "r"),
        t: text(row, "t"),
        b: bytes(row, "b"),
        n: optional(row, "n", text),
        t_again: optional(row, "t", text),
        mistyped: refusal(|| int(row, "t")),
        missing: refusal(|| int(row, "absent")),
      }
    } });
  assert_eq(
    read,
    Ok({
      i: -9223372036854775807 - 1,
      r: 1.5,
      t: "a\0b \u{1F600}",
      b: b"\x00\xff",
      n: None,
      t_again: Some("a\0b \u{1F600}"),
      mistyped: Some(Mistyped("t", "an integer")),
      missing: Some(Mistyped("absent", "a column of the answer")),
    }),
  )
}

test "a boolean is bound as 1 or 0, and what SQLite does not store is refused" {
  let read = fresh(||
    with_hold[bools](opening[app]("t.db", Create, plain()), |c| close(c)) { conn ->
      numbers(
        query(
          conn,
          bound(stmt("select ?1 as a union all select ?2"), [PBool(true), PBool(false)]),
          roomy(),
        ),
        "a",
      )
    });
  assert_eq(read, Ok([1, 0]));
  let unbound = refusal(|| bound(stmt("select ?1"), [PNumeric(1.50m)]));
  assert(match unbound { Some(Refused(_)) -> true, _ -> false })
}

test "a transaction commits when its body returns and rolls back when it raises" {
  let read = fresh(||
    with_hold[txn](opening[app]("t.db", Create, plain()), |c| close(c)) { conn -> {
      execute(conn, s("create table t (n integer) strict"), roomy());
      transaction(conn, || execute(conn, s("insert into t values (1)"), roomy()));
      let failed = refusal(||
        transaction(conn, || {
          execute(conn, s("insert into t values (2)"), roomy());
          execute(conn, s("insert into t values ('two')"), roomy())
        }));
      let inner = transaction(conn, || {
        execute(conn, s("insert into t values (3)"), roomy());
        let gave_up = refusal(||
          transaction(conn, || {
            execute(conn, s("insert into t values (4)"), roomy());
            sql.refused(Closed("no"))
          }));
        execute(conn, s("insert into t values (5)"), roomy());
        gave_up
      });
      {
        held: numbers(query(conn, s("select n from t order by n"), roomy()), "n"),
        failed: failed,
        inner: inner,
      }
    } });
  assert_eq(
    read,
    Ok({ held: [1, 3, 5], failed: Some(Constraint(Datatype, "t.n")), inner: Some(Closed("no")) }),
  )
}

test "a second writer is Busy, and a reader sees what was committed" {
  let read = fresh(||
    with_hold[writer](opening[app]("t.db", Create, plain()), |c| close(c)) { one ->
      with_hold[reader](opening[app]("t.db", ReadWrite, plain()), |c| close(c)) { two -> {
        execute(one, s("create table t (n integer) strict"), roomy());
        execute(one, s("insert into t values (1)"), roomy());
        let during = transaction(one, || {
          execute(one, s("insert into t values (2)"), roomy());
          {
            seen: numbers(query(two, s("select n from t order by n"), roomy()), "n"),
            written: refusal(|| execute(two, s("insert into t values (3)"), roomy())),
            begun: refusal(|| transaction(two, || 0)),
          }
        });
        {
          during: during,
          after: numbers(query(two, s("select n from t order by n"), roomy()), "n"),
          then: execute(two, s("insert into t values (3)"), roomy()).rows,
        }
      } }
    });
  assert_eq(
    read,
    Ok({ during: { seen: [1], written: Some(Busy), begun: Some(Busy) }, after: [1, 2], then: 1 }),
  );
  assert(is_retryable(Busy));
  assert(!is_retryable(Constraint(Unique, "t.n")))
}

test "a snapshot reads one state, and its write is Busy once another has written" {
  let read = fresh(||
    with_hold[snap](opening[app]("t.db", Create, plain()), |c| close(c)) { one ->
      with_hold[other](opening[app]("t.db", ReadWrite, plain()), |c| close(c)) { two -> {
        execute(one, s("create table t (n integer) strict"), roomy());
        snapshot(one, || {
          let before = len(query(one, s("select n from t"), roomy()));
          execute(two, s("insert into t values (1)"), roomy());
          {
            before: before,
            still: len(query(one, s("select n from t"), roomy())),
            stale: refusal(|| execute(one, s("insert into t values (2)"), roomy())),
          }
        })
      } }
    });
  assert_eq(read, Ok({ before: 0, still: 0, stale: Some(Busy) }))
}

type Broken = { sql: String, why: Refusal }

fn broken() -> List<Broken> =
  [
    { sql: "insert into p values (2, 'a')", why: Constraint(Unique, "p.code") },
    { sql: "insert into p values (1, 'b')", why: Constraint(Unique, "p.id") },
    { sql: "insert into p (code) values (null)", why: Constraint(NotNull, "p.code") },
    { sql: "insert into c (p, n) values (1, 0)", why: Constraint(Check, "positive") },
    { sql: "insert into c (p, n) values (9, 1)", why: Constraint(ForeignKey, "") },
    { sql: "insert into c (p, n) values (1, 'many')", why: Constraint(Datatype, "c.n") },
    { sql: "delete from p", why: Constraint(ForeignKey, "") },
  ]

test "{c.sql} breaks the constraint it names" for c: Broken in broken() {
  let read = fresh(||
    with_hold[constrained](opening[app]("t.db", Create, plain()), |x| close(x)) { conn -> {
      execute(
        conn,
        s("create table p (id integer primary key, code text not null unique) strict"),
        roomy(),
      );
      execute(
        conn,
        s(
          "create table c (id integer primary key, p integer not null references p (id), n integer, constraint positive check (n > 0)) strict",
        ),
        roomy(),
      );
      execute(conn, s("insert into p values (1, 'a')"), roomy());
      execute(conn, s("insert into c (p, n) values (1, 1)"), roomy());
      refusal(|| execute(conn, s(c.sql), roomy()))
    } });
  assert_eq(read, Ok(Some(c.why)))
}

test "each limit refuses what passes it, by its name" {
  let read = fresh(||
    with_hold[bounded](opening[app]("t.db", Create, plain()), |c| close(c)) { conn -> {
      execute(conn, s("create table t (n integer) strict"), roomy());
      execute(conn, s("insert into t values (1), (2), (3)"), roomy());
      [
        refusal(|| query(conn, s("select n from t"), { ..roomy(), rows: 2 })),
        refusal(|| query(conn, s("select 'abcdef' as a"), { ..roomy(), bytes: 5 })),
        refusal(|| query(conn, s("select 1 as a"), { ..roomy(), sql_bytes: 5 })),
        refusal(||
          query(conn, bound(stmt("select ?1 as a, ?2 as b"), [PInt(1), PInt(2)]), {
            ..roomy(),
            params: 1,
          })),
        refusal(||
          query(
            conn,
            s(
              "with recursive c(i) as (select 1 union all select i + 1 from c where i < 1000000) select count(*) as n from c",
            ),
            { ..roomy(), steps: 10 },
          )),
        refusal(|| returning(conn, s("delete from t returning n"), { ..roomy(), rows: 1 })),
        refusal(|| query(conn, s("select n from t"), { ..roomy(), rows: 3 })),
      ]
    } });
  assert_eq(
    read,
    Ok([
      Some(Over("rows")),
      Some(Over("bytes")),
      Some(Over("sql_bytes")),
      Some(Over("params")),
      Some(Over("steps")),
      Some(Over("rows")),
      None,
    ]),
  )
}

test "a write refused for what it answered leaves nothing behind" {
  let read = fresh(||
    with_hold[undone](opening[app]("t.db", Create, plain()), |c| close(c)) { conn -> {
      execute(conn, s("create table t (n integer) strict"), roomy());
      execute(conn, s("insert into t values (1), (2), (3)"), roomy());
      let over = refusal(||
        returning(conn, s("delete from t returning n"), { ..roomy(), rows: 1 }));
      let gone = numbers(returning(conn, s("delete from t where n = 2 returning n"), roomy()), "n");
      {
        over: over,
        gone: gone,
        left: numbers(query(conn, s("select n from t order by n"), roomy()), "n"),
      }
    } });
  assert_eq(read, Ok({ over: Some(Over("rows")), gone: [2], left: [1, 3] }))
}

test "fold_rows reads every row a page at a time and nothing else runs meanwhile" {
  let read = fresh(||
    with_hold[folding](opening[app]("t.db", Create, plain()), |c| close(c)) { conn -> {
      execute(conn, s("create table t (n integer) strict"), roomy());
      execute(
        conn,
        s(
          "with recursive c(i) as (select 1 union all select i + 1 from c where i < 10) insert into t select i from c",
        ),
        roomy(),
      );
      let all = s("select n from t order by n");
      let counted = |acc: Int, _: Row| acc + 1;
      {
        sum: fold_rows(conn, all, roomy(), 3, 0, |acc: Int, row: Row| acc + int(row, "n")),
        whole: fold_rows(conn, all, roomy(), 10, 0, counted),
        none: fold_rows(conn, s("select n from t where n > 99"), roomy(), 4, 0, counted),
        over: refusal(|| fold_rows(conn, all, { ..roomy(), rows: 7 }, 3, 0, counted)),
        meanwhile: is_refused(
          fold_rows(conn, all, roomy(), 20, None, |_: Option<Refusal>, _: Row|
            refusal(|| query(conn, s("select 1 as a"), roomy()))),
        ),
        writes: is_refused(
          refusal(|| fold_rows(conn, s("delete from t returning n"), roomy(), 3, 0, counted)),
        ),
        after: len(query(conn, all, roomy())),
      }
    } });
  assert_eq(
    read,
    Ok({
      sum: 55,
      whole: 10,
      none: 0,
      over: Some(Over("rows")),
      meanwhile: true,
      writes: true,
      after: 10,
    }),
  )
}

fn is_refused(why: Option<Refusal>) -> Bool = match why { Some(Refused(_)) -> true, _ -> false }

test "a backup is a database of its own, and writes over nothing" {
  let made = over_twin(memory(), ||
    with_hold[source](opening[app]("t.db", Create, plain()), |c| close(c)) { conn -> {
      execute(conn, s("create table t (n integer) strict"), roomy());
      execute(conn, s("insert into t values (1)"), roomy());
      backup(conn, "copies/t.db");
      execute(conn, s("insert into t values (2)"), roomy());
      {
        again: is_refused(refusal(|| backup(conn, "copies/t.db"))),
        inside: refusal(|| transaction(conn, || backup(conn, "copies/u.db"))),
      }
    } });
  let left = match made { Ok(over) -> over, Err(_) -> panic("the backup was not made") };
  assert_eq(left.value, {
    again: true,
    inside: Some(Malformed("cannot VACUUM from within a transaction")),
  });
  let copy = in_twin(left.memory, ||
    with_hold[copied](opening[app]("copies/t.db", ReadOnly, plain()), |c| close(c)) { conn ->
      numbers(query(conn, s("select n from t"), roomy()), "n")
    });
  assert_eq(copy, Ok([1]));
  assert(stored(left.memory, "copies/u.db") == None);
  assert(stored(left.memory, "copies/t.db") != stored(left.memory, "t.db"))
}

test "a connection opened to read writes nothing, and a query never writes" {
  let read = fresh(|| {
    with_hold[seeded](opening[app]("t.db", Create, plain()), |c| close(c)) { conn ->
      execute(conn, s("create table t (n integer) strict"), roomy())
    };
    with_hold[reading](opening[app]("t.db", ReadOnly, plain()), |c| close(c)) { conn ->
      [
        refusal(|| execute(conn, s("insert into t values (1)"), roomy())),
        refusal(|| query(conn, s("insert into t values (1) returning n"), roomy())),
        refusal(|| transaction(conn, || execute(conn, s("insert into t values (1)"), roomy()))),
        refusal(|| transaction(conn, || len(query(conn, s("select n from t"), roomy())))),
        refusal(|| snapshot(conn, || len(query(conn, s("select n from t"), roomy())))),
      ]
    }
  });
  assert(match read {
    Ok([Some(Refused(_)), Some(Refused(_)), Some(Refused(_)), None, None]) -> true,
    _ -> false,
  })
}

test "a strict connection refuses a table that is not, and another takes it" {
  let made = |strict: Bool|
    fresh(||
      with_hold[strictness](
        opening[app]("t.db", Create, { ..plain(), strict: strict }),
        |c| close(c),
      ) { conn -> refusal(|| execute(conn, s("create table loose (a)"), roomy())) });
  assert(match made(true) { Ok(Some(Refused(_))) -> true, _ -> false });
  assert_eq(made(false), Ok(None))
}

fn engine_refuses() -> List<String> =
  [
    "select last_insert_rowid() as a",
    "select changes() as a",
    "pragma journal_mode = delete",
    "pragma database_list",
    "select datetime(?1) as a",
    "select * from pragma_database_list",
    "create view v as select 1 as a; drop table t",
  ]

test "the engine refuses {c}, which the reader cannot tell" for c: String in engine_refuses() {
  let read = fresh(||
    with_hold[authorized](opening[app]("t.db", Create, plain()), |x| close(x)) { conn -> {
      execute(conn, s("create table t (n integer) strict"), roomy());
      let params = if string_contains(c, "?1") { [PText("now")] } else { [] };
      refusal(|| execute(conn, bound(stmt(c), params), roomy()))
    } });
  assert(match read { Ok(Some(Refused(_))) -> true, _ -> false })
}

test "a view and a trigger are held to what a statement is" {
  let read = fresh(||
    with_hold[smuggled](opening[app]("t.db", Create, plain()), |c| close(c)) { conn -> {
      execute(conn, s("create table t (n integer, at text) strict"), roomy());
      execute(conn, s("create view stamped as select datetime(at) as at from t"), roomy());
      execute(
        conn,
        s(
          "create trigger stamp after insert on t begin update t set at = datetime(new.at, '+1 day'); end",
        ),
        roomy(),
      );
      execute(conn, s("insert into t values (1, '2024-01-31 12:00:00')"), roomy());
      let kept = map(query(conn, s("select at from stamped"), roomy()), |row: Row| text(row, "at"));
      let now = refusal(|| execute(conn, s("insert into t values (2, 'now')"), roomy()));
      { kept: kept, now: now, held: len(query(conn, s("select n from t"), roomy())) }
    } });
  assert(match read {
    Ok(r) ->
      r.kept == ["2024-02-01 12:00:00"] && r.held == 1
        && (match r.now { Some(Refused(_)) -> true, _ -> false }),
    Err(_) -> false,
  })
}

test "a tagged literal's holes are its parameters, and its text is placed where it is refused" {
  assert_eq(
    compile(["select n from t where a = ", " and b = ", ""]),
    Ok(stmt("select n from t where a = ?1 and b = ?2")),
  );
  let filled = fill(stmt("select ?1 as a, ?2 as b"), [PInt(1), PText("x")]);
  assert_eq(statement(filled), stmt("select ?1 as a, ?2 as b"));
  let placed_at = |texts: List<String>|
    match compile(texts) { Err(e) -> Some({ part: e.part, offset: e.offset }), Ok(_) -> None };
  assert_eq(placed_at(["select random()"]), Some({ part: 0, offset: 7 }));
  assert_eq(placed_at(["select ", ", é, current_date"]), Some({ part: 1, offset: 5 }));
  assert_eq(placed_at(["attach ", " as x"]), Some({ part: 0, offset: 0 }));
  assert(match literal("vacuum") { Err(e) -> e.offset == 0, Ok(_) -> false });
  assert(match literal("select 1") { Ok(_) -> true, Err(_) -> false })
}

test "a path that leaves its root is refused in E0452's words" {
  let escaped = try[abort.raise] {
    fresh(||
      with_hold[escaping](opening[app]("../t.db", Create, plain()), |c| close(c)) { conn -> 0 })
  };
  assert_eq(escaped, Err("`../t.db` leaves the root it was given"))
}

test "what was closed, and what was never opened, is Closed" {
  let read = fresh(|| {
    let kept = with_hold[leaving](opening[app]("t.db", Create, plain()), |c| close(c)) { conn ->
      hold_get(conn)
    };
    with_hold[again](kept, |_: Connection<[app]>| ()) { conn ->
      refusal(|| query(conn, s("select 1 as a"), roomy()))
    }
  });
  assert(match read { Ok(Some(Closed(_))) -> true, _ -> false })
}

test "every admitted function is listed once, in order" {
  let names = functions();
  assert(len(names) > 80);
  assert(
    fold(range(1, len(names)), true, |ok: Bool, i: Int|
      ok && compare(list_at(names, i - 1), list_at(names, i)) == Less),
  )
}
