//! OTLP, the OpenTelemetry protocol: its traces and metrics as values, the two encodings a
//! collector takes over HTTP, and an exporter that is a `trace` handler.
//!
//! The model is the protocol's own, with a field's width where the protocol gives it one: a
//! time is a `U64` of nanoseconds since the Unix epoch and a dropped count a `U32`, so every
//! value of a type has an encoding and reads back as itself. A trace id and a span id are
//! `std.traceparent`'s. Metrics are a gauge, a sum and a histogram with explicit bounds; an
//! exponential histogram and a summary are not modelled, and a reader refuses a metric that is
//! one, by name. Exemplars, a data point's flags, a metric's metadata and a resource's entity
//! references are passed over, as a field a later version adds is.
//!
//! `encode_traces` and `encode_metrics` write a request in either `Encoding`. `Protobuf` is the
//! binary form a collector expects unless told otherwise, written by field number over
//! `std.protobuf`. `Json` is OTLP's JSON mapping and not proto3's: ids are hex, a 64-bit number is
//! a decimal string, an enum is its number, keys are lowerCamelCase and bytes are base64. A
//! double JSON has no number for is written as a string: `NaN`, `Infinity`, `-Infinity`, or its
//! digits where `std.json`'s `Decimal` cannot hold them, which the mapping lets a reader take.
//! Either reader takes its `Limits`, passes over a field it does not know, and refuses with why
//! and where; the `decode_` functions answer a refusal as an `Err` and the `read_` ones raise it.
//! The field numbers are those of `opentelemetry-proto` 1.11.1.
//!
//! `exporting` is the sink: a handler for `trace` that keeps what a program traces, a span from
//! its `enter` to its `exit` and each counter, gauge and timing as a series, and sends it to a
//! collector through `std.http`'s client in batches, from a bounded queue, with retries.
//! Nothing is exported until a program installs it.

import std.base64 (base64_decode, base64_encode)
import std.bytes (bytes_of_hex, int_of_ascii)
import std.float (infinity, nan, neg_infinity, pow2)
import std.gen
import std.gen (Gen)
import std.gzip
import std.json
import std.json (Json, Null, Number, Str)
import std.protobuf
import std.protobuf (Field, Message, protobuf)
import std.http
import std.ip
import std.list (any, concat, contains, drop, find, last, reverse, take)
import std.net
import std.net (Says, net)
import std.random (entropy, rand, with_rand)
import std.show (show)
import std.string (ascii_lower, ascii_trim)
import std.telemetry
import std.telemetry (Sampler, Tracing, tracing)
import std.time (time)
import std.trace
import std.trace (Fields, trace)
import std.traceparent
import std.traceparent (SpanId, TraceId)

// --- The model ----------------------------------------------------------------

/// An attribute's value.
pub type AnyValue =
  | StringValue(String)
  | BoolValue(Bool)
  | IntValue(Int)
  | DoubleValue(Float)
  | ArrayValue(List<AnyValue>)
  /// Keys and values in order; the protocol asks that no key repeats and nothing here checks.
  | KvlistValue(List<KeyValue>)
  | BytesValue(Bytes)
  /// A value that was not set, which the protocol allows and an array's null element is.
  | NoValue

/// One attribute.
pub type KeyValue = new { key: String, value: AnyValue }

/// What produced the telemetry: `service.name` and its siblings.
pub type Resource = new { attributes: List<KeyValue>, dropped_attributes: U32 }

/// The instrumentation that recorded it; this module's exporter names a `trace` channel here.
pub type Scope = new {
  name: String,
  version: String,
  attributes: List<KeyValue>,
  dropped_attributes: U32,
}

/// Which side of a call a span is.
pub type SpanKind = | Unspecified | Internal | Server | Client | Producer | Consumer

/// How a span ended.
pub type StatusCode = | StatusUnset | StatusOk | StatusError

/// A span's status; `message` says what went wrong under `StatusError`.
pub type Status = new { code: StatusCode, message: String }

/// Something that happened at one moment of a span.
pub type Event = new {
  time: U64,
  name: String,
  attributes: List<KeyValue>,
  dropped_attributes: U32,
}

/// Another span this one is related to, in any trace.
pub type Link = new {
  trace_id: TraceId,
  span_id: SpanId,
  trace_state: String,
  attributes: List<KeyValue>,
  dropped_attributes: U32,
  flags: U32,
}

/// One operation of a trace.
pub type Span = new {
  trace_id: TraceId,
  span_id: SpanId,
  /// The `tracestate` header's text.
  trace_state: String,
  /// `None` on a trace's first span.
  parent: Option<SpanId>,
  /// The W3C trace flags in the low eight bits; bits 8 and 9 say whether the parent is known
  /// to be in another process, and that it is.
  flags: U32,
  name: String,
  kind: SpanKind,
  start: U64,
  end: U64,
  attributes: List<KeyValue>,
  dropped_attributes: U32,
  events: List<Event>,
  dropped_events: U32,
  links: List<Link>,
  dropped_links: U32,
  status: Status,
}

/// The spans one scope recorded.
pub type ScopeSpans = new { scope: Scope, spans: List<Span>, schema_url: String }

/// The spans of one resource.
pub type ResourceSpans = new {
  resource: Resource,
  scope_spans: List<ScopeSpans>,
  schema_url: String,
}

/// A request to `/v1/traces`.
pub type Traces = new { resource_spans: List<ResourceSpans> }

/// Whether a point covers the time since the last one, or since `start`.
pub type Temporality = | Delta | Cumulative

/// A measurement.
pub type Number = | AsDouble(Float) | AsInt(Int)

/// One series of a gauge or a sum at one time.
pub type NumberPoint = new {
  attributes: List<KeyValue>,
  /// When the series began to be counted; zero where that is not known.
  start: U64,
  time: U64,
  value: Number,
}

/// One series of a histogram at one time. `bucket_counts` holds one count more than
/// `explicit_bounds` has bounds: a bound is the greatest value its bucket counts, and the last
/// bucket counts what is past them all.
pub type HistogramPoint = new {
  attributes: List<KeyValue>,
  start: U64,
  time: U64,
  count: U64,
  sum: Option<Float>,
  bucket_counts: List<U64>,
  explicit_bounds: List<Float>,
  min: Option<Float>,
  max: Option<Float>,
}

/// What a metric holds.
pub type Data =
  | Gauge(List<NumberPoint>)
  /// The points, how they add up over time, and whether the sum only ever grows.
  | Sum(List<NumberPoint>, Temporality, Bool)
  | Histogram(List<HistogramPoint>, Temporality)

/// One metric and its series.
pub type Metric = new { name: String, description: String, unit: String, data: Data }

/// The metrics one scope recorded.
pub type ScopeMetrics = new { scope: Scope, metrics: List<Metric>, schema_url: String }

/// The metrics of one resource.
pub type ResourceMetrics = new {
  resource: Resource,
  scope_metrics: List<ScopeMetrics>,
  schema_url: String,
}

/// A request to `/v1/metrics`.
pub type Metrics = new { resource_metrics: List<ResourceMetrics> }

/// What a collector answers a request with where it took only part of it: how many spans or
/// data points it turned away, and why. All of it taken is zero and no message.
pub type Receipt = new { rejected: Int, message: String }

/// A resource with no attributes.
pub fn empty_resource() -> Resource = { attributes: [], dropped_attributes: 0u32 }

/// A scope named `name`, with nothing else said of it.
pub fn scope(name: String) -> Scope =
  { name: name, version: "", attributes: [], dropped_attributes: 0u32 }

/// A status that says nothing.
pub fn unset() -> Status = { code: StatusUnset, message: "" }

/// An attribute.
pub fn attribute(key: String, value: AnyValue) -> KeyValue = { key: key, value: value }

/// Where a collector takes traces over HTTP.
pub fn traces_path() -> String = "/v1/traces"

/// Where a collector takes metrics over HTTP.
pub fn metrics_path() -> String = "/v1/metrics"

// --- Generators ---------------------------------------------------------------

gen for AnyValue by any_values

gen for Number by numbers

gen for HistogramPoint by histogram_points

/// Every double but a NaN, which is not equal to itself and so reads back as nothing a claim
/// can compare.
fn doubles() -> Gen<Float> =
  gen::one_of([
    gen::elements([
      0.0,
      1.5,
      -2.25,
      0.1,
      1e300,
      -1e-300,
      5e-324,
      123456789.125,
      0.30000000000000004,
    ]),
    gen::map(gen::int(), |n: Int| float_of_int(n)),
    gen::map2(gen::int(), gen::int_between(-80, 80), |m: Int, e: Int| float_of_int(m) * pow2(e)),
    gen::elements([infinity(), neg_infinity()]),
  ])

fn texts() -> Gen<String> =
  gen::one_of([
    gen::elements([
      "",
      "a",
      "service.name",
      "two words",
      "quote \" slash \\ line\nfeed",
      "h\u{e9}llo \u{1F600}",
    ]),
    gen::map(gen::list_of(gen::int_between(32, 767), 12), |points: List<Int>|
      string_of_chars(
        fold(points, [], |acc: List<Char>, p: Int|
          match char_of_int(p) { Some(c) -> push(acc, c), None -> acc }),
      )),
  ])

fn wide() -> Gen<U64> =
  gen::map2(gen::below(4294967296), gen::below(4294967296), |high: Int, low: Int|
    u64_of_int(high) << 32 | u64_of_int(low))

fn any_values() -> Gen<AnyValue> = gen::sized(|size: Int| values_at(min(max(size / 16, 0), 3)))

fn scalars() -> Gen<AnyValue> =
  gen::one_of([
    gen::map(texts(), |s: String| StringValue(s)),
    gen::map(gen::bool(), |b: Bool| BoolValue(b)),
    gen::map(gen::int(), |n: Int| IntValue(n)),
    gen::map(doubles(), |f: Float| DoubleValue(f)),
    gen::map(gen::and_then(gen::below(5), |n: Int| gen::bytes_of(n)), |b: Bytes| BytesValue(b)),
    gen::constant(NoValue),
  ])

fn values_at(depth: Int) -> Gen<AnyValue> =
  if depth <= 0 { scalars() } else {
    gen::one_of([
      scalars(),
      gen::map(gen::list_of(values_at(depth - 1), 3), |xs: List<AnyValue>| ArrayValue(xs)),
      gen::map(gen::list_of(key_values_at(depth - 1), 3), |kvs: List<KeyValue>| KvlistValue(kvs)),
    ])
  }

fn key_values_at(depth: Int) -> Gen<KeyValue> =
  gen::map2(texts(), values_at(depth), |key: String, value: AnyValue| -> KeyValue {
    { key: key, value: value }
  })

fn numbers() -> Gen<Number> =
  gen::one_of([
    gen::map(gen::int(), |n: Int| AsInt(n)),
    gen::map(doubles(), |f: Float| AsDouble(f)),
  ])

fn histogram_points() -> Gen<HistogramPoint> =
  gen::and_then(gen::list_of(key_values_at(1), 3), |attributes: List<KeyValue>|
    gen::and_then(gen::list_of_length(wide(), 3), |times: List<U64>|
      gen::and_then(
        gen::list_of_length(gen::option_of(doubles()), 3),
        |stats: List<Option<Float>>|
          gen::map2(
            gen::list_of(wide(), 5),
            gen::list_of(doubles(), 4),
            |counts: List<U64>, bounds: List<Float>| -> HistogramPoint {
              {
                attributes: attributes,
                start: wide_at(times, 0),
                time: wide_at(times, 1),
                count: wide_at(times, 2),
                sum: stat_at(stats, 0),
                bucket_counts: counts,
                explicit_bounds: bounds,
                min: stat_at(stats, 1),
                max: stat_at(stats, 2),
              }
            },
          ),
      )))

fn wide_at(xs: List<U64>, i: Int) -> U64 = match list_at(xs, i) { Some(x) -> x, None -> 0u64 }

fn stat_at(xs: List<Option<Float>>, i: Int) -> Option<Float> =
  match list_at(xs, i) { Some(x) -> x, None -> None }

// --- Refusals -----------------------------------------------------------------

/// Why a reader refused a request.
pub type Why =
  /// The bytes are not the protobuf of a request: `std.protobuf`'s own refusal.
  | NotProtobuf(protobuf::Why)
  /// The text is not JSON; what the parser said.
  | NotJson(String)
  /// A JSON value that is not what its field takes; what the field takes.
  | WrongKind(String)
  /// A trace id that is not sixteen bytes or a span id that is not eight, or one all zeros.
  | BadId
  /// An enum's number that names nothing.
  | BadEnum(Int)
  /// A whole number that is not one, or is past its field's width.
  | BadNumber
  /// Hex or base64 that is not.
  | BadText
  /// A metric of a kind this module does not model: `exponential_histogram` or `summary`.
  | Unsupported(String)
  /// Something a message must say and does not: a metric's data, a point's value, how a sum
  /// or a histogram adds up over time.
  | Missing(String)
  /// Longer than `Limits.length`.
  | TooLong
  /// Attribute values nested deeper than `Limits.depth`.
  | TooDeep

/// A refusal: why, at which byte, and in which field.
pub type Refusal = new {
  why: Why,
  /// For protobuf, the offset of the field refused. For JSON, the byte the parser stopped at,
  /// or -1 for a value refused once the text had parsed.
  at: Int,
  /// The field's name as the JSON mapping spells it, `traceId`; empty where the refusal is
  /// of the encoding and no field.
  field: String,
}

/// What the readers of this module raise where they refuse.
pub effect otlp {
  /// The bytes are not a request this module models.
  raise refused(e: Refusal)
  /// Sends everything the exporter around the caller holds, and answers what it has done.
  write flush() -> Stats
  /// What the exporter around the caller has done so far.
  read stats() -> Stats
}

/// What a reader holds a request to.
pub type Limits = new {
  /// The most bytes a request may be.
  length: Int,
  /// How deep messages may nest, an attribute's arrays and lists among them.
  depth: Int,
}

/// Four mebibytes and 64 levels: what a collector takes by default, and deeper than any
/// request this module writes.
pub fn default_limits() -> Limits = { length: 4194304, depth: 64 }

fn refuse<a>(why: Why, at: Int, field: String) -> a / {otlp.refused} =
  otlp.refused({ why: why, at: at, field: field })

// --- The two encodings ----------------------------------------------------------

/// How a request is written.
pub type Encoding =
  /// The binary form: `application/x-protobuf`.
  | Protobuf
  /// OTLP's JSON mapping: `application/json`.
  | Json

/// Which request a receipt answers, since the two name what was turned away differently.
pub type Signal = | TraceSignal | MetricSignal

/// The `Content-Type` a request in this encoding is sent with.
pub fn content_type(e: Encoding) -> String =
  match e { Protobuf -> "application/x-protobuf", Json -> "application/json" }

/// A request to `/v1/traces`.
pub fn encode_traces(e: Encoding, t: Traces) -> Bytes / {abort.raise} =
  match e { Protobuf -> traces_body(t), Json -> json::to_bytes(traces_json(t)) }

/// A request to `/v1/metrics`.
pub fn encode_metrics(e: Encoding, m: Metrics) -> Bytes / {abort.raise} =
  match e { Protobuf -> metrics_body(m), Json -> json::to_bytes(metrics_json(m)) }

/// A collector's answer; an empty receipt is the empty message.
pub fn encode_receipt(e: Encoding, signal: Signal, r: Receipt) -> Bytes / {abort.raise} =
  match e { Protobuf -> receipt_body(r), Json -> json::to_bytes(receipt_json(signal, r)) }

/// The traces a request holds, raising `otlp.refused` where `decode_traces` answers `Err`.
pub fn read_traces(
  e: Encoding,
  data: Bytes,
  limits: Limits,
) -> Traces / {otlp.refused, abort.raise} =
  match e {
    Protobuf -> from_protobuf(data, limits, |m: Message| traces_of(m, limits.depth)),
    Json -> traces_of_json(parsed(data, limits), limits.depth),
  }

/// The metrics a request holds, raising `otlp.refused` where `decode_metrics` answers `Err`.
pub fn read_metrics(
  e: Encoding,
  data: Bytes,
  limits: Limits,
) -> Metrics / {otlp.refused, abort.raise} =
  match e {
    Protobuf -> from_protobuf(data, limits, |m: Message| metrics_of(m, limits.depth)),
    Json -> metrics_of_json(parsed(data, limits), limits.depth),
  }

/// The receipt a collector's answer holds, raising `otlp.refused` where `decode_receipt`
/// answers `Err`.
pub fn read_receipt(
  e: Encoding,
  signal: Signal,
  data: Bytes,
  limits: Limits,
) -> Receipt / {otlp.refused, abort.raise} =
  match e {
    Protobuf -> from_protobuf(data, limits, receipt_of),
    Json -> receipt_of_json(signal, parsed(data, limits)),
  }

/// The traces a request holds, or why it is refused.
pub fn decode_traces(
  e: Encoding,
  data: Bytes,
  limits: Limits,
) -> Result<Traces, Refusal> / {abort.raise} = try { read_traces(e, data, limits) }

/// The metrics a request holds, or why it is refused.
pub fn decode_metrics(
  e: Encoding,
  data: Bytes,
  limits: Limits,
) -> Result<Metrics, Refusal> / {abort.raise} = try { read_metrics(e, data, limits) }

/// The receipt a collector's answer holds, or why it is refused.
pub fn decode_receipt(
  e: Encoding,
  signal: Signal,
  data: Bytes,
  limits: Limits,
) -> Result<Receipt, Refusal> / {abort.raise} = try { read_receipt(e, signal, data, limits) }

// --- Protobuf: writing ----------------------------------------------------------

fn text(field: Int, s: String) -> Bytes / {abort.raise} =
  if s == "" { b"" } else { protobuf::string_field(field, s) }

fn narrow(field: Int, n: U32) -> Bytes / {abort.raise} =
  if n == 0u32 { b"" } else { protobuf::int_field(field, int_of_u32(n)) }

fn moment(field: Int, n: U64) -> Bytes / {abort.raise} =
  if n == 0u64 { b"" } else { protobuf::fixed64_field(field, n) }

fn number(field: Int, n: Int) -> Bytes / {abort.raise} =
  if n == 0 { b"" } else { protobuf::int_field(field, n) }

fn each(field: Int, bodies: List<Bytes>) -> Bytes / {abort.raise} =
  bytes_concat_all(map(bodies, |body: Bytes| protobuf::message_field(field, body)))

fn value_body(v: AnyValue) -> Bytes / {abort.raise} =
  match v {
    StringValue(s) -> protobuf::string_field(1, s),
    BoolValue(b) -> protobuf::bool_field(2, b),
    IntValue(n) -> protobuf::int_field(3, n),
    DoubleValue(f) -> protobuf::double_field(4, f),
    ArrayValue(xs) -> protobuf::message_field(5, each(1, map(xs, value_body))),
    KvlistValue(kvs) -> protobuf::message_field(6, each(1, map(kvs, key_value_body))),
    BytesValue(b) -> protobuf::bytes_field(7, b),
    NoValue -> b"",
  }

fn key_value_body(kv: KeyValue) -> Bytes / {abort.raise} =
  bytes_concat(text(1, kv.key), match kv.value {
    NoValue -> b"",
    held -> protobuf::message_field(2, value_body(held)),
  })

fn attributes_at(field: Int, kvs: List<KeyValue>) -> Bytes / {abort.raise} =
  each(field, map(kvs, key_value_body))

fn resource_body(r: Resource) -> Bytes / {abort.raise} =
  bytes_concat(attributes_at(1, r.attributes), narrow(2, r.dropped_attributes))

fn scope_body(s: Scope) -> Bytes / {abort.raise} =
  bytes_concat_all([
    text(1, s.name),
    text(2, s.version),
    attributes_at(3, s.attributes),
    narrow(4, s.dropped_attributes),
  ])

fn kind_number(k: SpanKind) -> Int =
  match k {
    Unspecified -> 0,
    Internal -> 1,
    Server -> 2,
    Client -> 3,
    Producer -> 4,
    Consumer -> 5,
  }

fn code_number(c: StatusCode) -> Int = match c { StatusUnset -> 0, StatusOk -> 1, StatusError -> 2 }

fn temporality_number(t: Temporality) -> Int = match t { Delta -> 1, Cumulative -> 2 }

fn status_at(field: Int, s: Status) -> Bytes / {abort.raise} =
  if s == unset() { b"" } else {
    protobuf::message_field(field, bytes_concat(text(2, s.message), number(3, code_number(s.code))))
  }

fn flags_at(field: Int, flags: U32) -> Bytes / {abort.raise} =
  if flags == 0u32 { b"" } else { protobuf::fixed32_field(field, flags) }

fn event_body(e: Event) -> Bytes / {abort.raise} =
  bytes_concat_all([
    moment(1, e.time),
    text(2, e.name),
    attributes_at(3, e.attributes),
    narrow(4, e.dropped_attributes),
  ])

fn link_body(l: Link) -> Bytes / {abort.raise} =
  bytes_concat_all([
    protobuf::bytes_field(1, traceparent::trace_id_bytes(l.trace_id)),
    protobuf::bytes_field(2, traceparent::span_id_bytes(l.span_id)),
    text(3, l.trace_state),
    attributes_at(4, l.attributes),
    narrow(5, l.dropped_attributes),
    flags_at(6, l.flags),
  ])

fn span_body(s: Span) -> Bytes / {abort.raise} =
  bytes_concat_all([
    protobuf::bytes_field(1, traceparent::trace_id_bytes(s.trace_id)),
    protobuf::bytes_field(2, traceparent::span_id_bytes(s.span_id)),
    text(3, s.trace_state),
    match s.parent {
      Some(id) -> protobuf::bytes_field(4, traceparent::span_id_bytes(id)),
      None -> b"",
    },
    text(5, s.name),
    number(6, kind_number(s.kind)),
    moment(7, s.start),
    moment(8, s.end),
    attributes_at(9, s.attributes),
    narrow(10, s.dropped_attributes),
    each(11, map(s.events, event_body)),
    narrow(12, s.dropped_events),
    each(13, map(s.links, link_body)),
    narrow(14, s.dropped_links),
    status_at(15, s.status),
    flags_at(16, s.flags),
  ])

fn scope_spans_body(s: ScopeSpans) -> Bytes / {abort.raise} =
  bytes_concat_all([
    protobuf::message_field(1, scope_body(s.scope)),
    each(2, map(s.spans, span_body)),
    text(3, s.schema_url),
  ])

fn resource_spans_body(r: ResourceSpans) -> Bytes / {abort.raise} =
  bytes_concat_all([
    protobuf::message_field(1, resource_body(r.resource)),
    each(2, map(r.scope_spans, scope_spans_body)),
    text(3, r.schema_url),
  ])

fn traces_body(t: Traces) -> Bytes / {abort.raise} =
  each(1, map(t.resource_spans, resource_spans_body))

fn number_point_body(p: NumberPoint) -> Bytes / {abort.raise} =
  bytes_concat_all([
    moment(2, p.start),
    moment(3, p.time),
    match p.value { AsDouble(f) -> protobuf::double_field(4, f), AsInt(_) -> b"" },
    match p.value { AsInt(n) -> protobuf::sfixed64_field(6, n), AsDouble(_) -> b"" },
    attributes_at(7, p.attributes),
  ])

fn optional_double(field: Int, f: Option<Float>) -> Bytes / {abort.raise} =
  match f { Some(x) -> protobuf::double_field(field, x), None -> b"" }

fn histogram_point_body(p: HistogramPoint) -> Bytes / {abort.raise} =
  bytes_concat_all([
    moment(2, p.start),
    moment(3, p.time),
    moment(4, p.count),
    optional_double(5, p.sum),
    protobuf::packed_fixed64(6, p.bucket_counts),
    protobuf::packed_doubles(7, p.explicit_bounds),
    attributes_at(9, p.attributes),
    optional_double(11, p.min),
    optional_double(12, p.max),
  ])

fn data_body(d: Data) -> Bytes / {abort.raise} =
  match d {
    Gauge(points) -> protobuf::message_field(5, each(1, map(points, number_point_body))),
    Sum(points, temporality, monotonic) ->
      protobuf::message_field(
        7,
        bytes_concat_all([
          each(1, map(points, number_point_body)),
          protobuf::int_field(2, temporality_number(temporality)),
          if monotonic { protobuf::bool_field(3, true) } else { b"" },
        ]),
      ),
    Histogram(points, temporality) ->
      protobuf::message_field(
        9,
        bytes_concat(
          each(1, map(points, histogram_point_body)),
          protobuf::int_field(2, temporality_number(temporality)),
        ),
      ),
  }

fn metric_body(m: Metric) -> Bytes / {abort.raise} =
  bytes_concat_all([text(1, m.name), text(2, m.description), text(3, m.unit), data_body(m.data)])

fn scope_metrics_body(s: ScopeMetrics) -> Bytes / {abort.raise} =
  bytes_concat_all([
    protobuf::message_field(1, scope_body(s.scope)),
    each(2, map(s.metrics, metric_body)),
    text(3, s.schema_url),
  ])

fn resource_metrics_body(r: ResourceMetrics) -> Bytes / {abort.raise} =
  bytes_concat_all([
    protobuf::message_field(1, resource_body(r.resource)),
    each(2, map(r.scope_metrics, scope_metrics_body)),
    text(3, r.schema_url),
  ])

fn metrics_body(m: Metrics) -> Bytes / {abort.raise} =
  each(1, map(m.resource_metrics, resource_metrics_body))

fn receipt_body(r: Receipt) -> Bytes / {abort.raise} =
  if r.rejected == 0 && r.message == "" { b"" }
  else { protobuf::message_field(1, bytes_concat(number(1, r.rejected), text(2, r.message))) }

// --- Protobuf: reading ----------------------------------------------------------

/// `read` over `data` as a message, with a refusal of the wire format answered as this
/// module's.
fn from_protobuf<a>(
  data: Bytes,
  limits: Limits,
  read: (Message) -> a / {otlp.refused, protobuf.refused, abort.raise},
) -> a / {otlp.refused, abort.raise} =
  match try[protobuf.refused] {
      read(protobuf::message(data, { depth: limits.depth, length: limits.length }))
    } {
    Ok(answer) -> answer,
    Err(e) -> refuse(NotProtobuf(e.why), e.at, ""),
  }

effect set Reading = {otlp.refused, protobuf.refused, abort.raise}

fn value_of(m: Message, room: Int) -> AnyValue / {Reading} =
  if room <= 0 { refuse(TooDeep, protobuf::offset(m), "value") } else {
    fold(protobuf::fields(m), NoValue, |held: AnyValue, f: Field|
      match f.number {
        1 -> StringValue(protobuf::string_of(f)),
        2 -> BoolValue(protobuf::bool_of(f)),
        3 -> IntValue(protobuf::int_of(f)),
        4 -> DoubleValue(protobuf::double_of(f)),
        5 -> ArrayValue(values_in(protobuf::message_of(f), room - 1)),
        6 -> KvlistValue(key_values_in(protobuf::message_of(f), 1, room - 1)),
        7 -> BytesValue(protobuf::bytes_of(f)),
        _ -> held,
      })
  }

fn values_in(m: Message, room: Int) -> List<AnyValue> / {Reading} =
  fold(protobuf::fields(m), [], |acc: List<AnyValue>, f: Field|
    match f.number { 1 -> push(acc, value_of(protobuf::message_of(f), room)), _ -> acc })

/// Every `KeyValue` under the field `number` of `m`.
fn key_values_in(m: Message, number: Int, room: Int) -> List<KeyValue> / {Reading} =
  fold(protobuf::fields(m), [], |acc: List<KeyValue>, f: Field|
    if f.number == number { push(acc, key_value_of(protobuf::message_of(f), room)) } else { acc })

fn key_value_of(m: Message, room: Int) -> KeyValue / {Reading} = {
  let start: KeyValue = { key: "", value: NoValue };
  fold(protobuf::fields(m), start, |kv: KeyValue, f: Field|
    match f.number {
      1 -> { ..kv, key: protobuf::string_of(f) },
      2 -> { ..kv, value: value_of(protobuf::message_of(f), room) },
      _ -> kv,
    })
}

fn resource_of(m: Message, room: Int) -> Resource / {Reading} =
  fold(protobuf::fields(m), empty_resource(), |r: Resource, f: Field|
    match f.number {
      1 -> { ..r, attributes: push(r.attributes, key_value_of(protobuf::message_of(f), room)) },
      2 -> { ..r, dropped_attributes: protobuf::uint32_of(f) },
      _ -> r,
    })

fn scope_of(m: Message, room: Int) -> Scope / {Reading} =
  fold(protobuf::fields(m), scope(""), |s: Scope, f: Field|
    match f.number {
      1 -> { ..s, name: protobuf::string_of(f) },
      2 -> { ..s, version: protobuf::string_of(f) },
      3 -> { ..s, attributes: push(s.attributes, key_value_of(protobuf::message_of(f), room)) },
      4 -> { ..s, dropped_attributes: protobuf::uint32_of(f) },
      _ -> s,
    })

fn kind_of(n: Int, at: Int) -> SpanKind / {otlp.refused} =
  match n {
    0 -> Unspecified,
    1 -> Internal,
    2 -> Server,
    3 -> Client,
    4 -> Producer,
    5 -> Consumer,
    _ -> refuse(BadEnum(n), at, "kind"),
  }

fn code_of(n: Int, at: Int) -> StatusCode / {otlp.refused} =
  match n { 0 -> StatusUnset, 1 -> StatusOk, 2 -> StatusError, _ -> refuse(BadEnum(n), at, "code") }

fn temporality_of(n: Int, at: Int) -> Temporality / {otlp.refused} =
  match n {
    1 -> Delta,
    2 -> Cumulative,
    0 -> refuse(Missing("aggregationTemporality"), at, "aggregationTemporality"),
    _ -> refuse(BadEnum(n), at, "aggregationTemporality"),
  }

fn status_of(m: Message) -> Status / {Reading} =
  fold(protobuf::fields(m), unset(), |s: Status, f: Field|
    match f.number {
      2 -> { ..s, message: protobuf::string_of(f) },
      3 -> { ..s, code: code_of(protobuf::int_of(f), f.at) },
      _ -> s,
    })

fn event_of(m: Message, room: Int) -> Event / {Reading} = {
  let start: Event = { time: 0u64, name: "", attributes: [], dropped_attributes: 0u32 };
  fold(protobuf::fields(m), start, |e: Event, f: Field|
    match f.number {
      1 -> { ..e, time: protobuf::fixed64_of(f) },
      2 -> { ..e, name: protobuf::string_of(f) },
      3 -> { ..e, attributes: push(e.attributes, key_value_of(protobuf::message_of(f), room)) },
      4 -> { ..e, dropped_attributes: protobuf::uint32_of(f) },
      _ -> e,
    })
}

/// A span's or a link's fields before its ids are held to their lengths.
type Raw = {
  trace_id: Bytes,
  span_id: Bytes,
  parent: Bytes,
  trace_state: String,
  flags: U32,
  name: String,
  kind: SpanKind,
  start: U64,
  end: U64,
  attributes: List<KeyValue>,
  dropped_attributes: U32,
  events: List<Event>,
  dropped_events: U32,
  links: List<Link>,
  dropped_links: U32,
  status: Status,
  at: Int,
}

fn raw_at(at: Int) -> Raw =
  {
    trace_id: b"",
    span_id: b"",
    parent: b"",
    trace_state: "",
    flags: 0u32,
    name: "",
    kind: Unspecified,
    start: 0u64,
    end: 0u64,
    attributes: [],
    dropped_attributes: 0u32,
    events: [],
    dropped_events: 0u32,
    links: [],
    dropped_links: 0u32,
    status: unset(),
    at: at,
  }

fn trace_id_of(raw: Bytes, at: Int) -> TraceId / {otlp.refused, abort.raise} =
  match traceparent::trace_id(raw) { Some(id) -> id, None -> refuse(BadId, at, "traceId") }

fn span_id_of(raw: Bytes, at: Int, field: String) -> SpanId / {otlp.refused, abort.raise} =
  match traceparent::span_id(raw) { Some(id) -> id, None -> refuse(BadId, at, field) }

/// A parent of no bytes, or of eight zeros as some writers send it, is none.
fn parent_of(raw: Bytes, at: Int) -> Option<SpanId> / {otlp.refused, abort.raise} =
  if bytes_len(raw) == 0 || raw == b"\x00\x00\x00\x00\x00\x00\x00\x00" { None }
  else { Some(span_id_of(raw, at, "parentSpanId")) }

fn span_from(r: Raw) -> Span / {otlp.refused, abort.raise} =
  {
    trace_id: trace_id_of(r.trace_id, r.at),
    span_id: span_id_of(r.span_id, r.at, "spanId"),
    trace_state: r.trace_state,
    parent: parent_of(r.parent, r.at),
    flags: r.flags,
    name: r.name,
    kind: r.kind,
    start: r.start,
    end: r.end,
    attributes: r.attributes,
    dropped_attributes: r.dropped_attributes,
    events: r.events,
    dropped_events: r.dropped_events,
    links: r.links,
    dropped_links: r.dropped_links,
    status: r.status,
  }

fn link_from(r: Raw) -> Link / {otlp.refused, abort.raise} =
  {
    trace_id: trace_id_of(r.trace_id, r.at),
    span_id: span_id_of(r.span_id, r.at, "spanId"),
    trace_state: r.trace_state,
    attributes: r.attributes,
    dropped_attributes: r.dropped_attributes,
    flags: r.flags,
  }

fn link_of(m: Message, room: Int) -> Link / {Reading} =
  link_from(
    fold(protobuf::fields(m), raw_at(protobuf::offset(m)), |r: Raw, f: Field|
      match f.number {
        1 -> { ..r, trace_id: protobuf::bytes_of(f) },
        2 -> { ..r, span_id: protobuf::bytes_of(f) },
        3 -> { ..r, trace_state: protobuf::string_of(f) },
        4 -> { ..r, attributes: push(r.attributes, key_value_of(protobuf::message_of(f), room)) },
        5 -> { ..r, dropped_attributes: protobuf::uint32_of(f) },
        6 -> { ..r, flags: protobuf::fixed32_of(f) },
        _ -> r,
      }),
  )

fn span_of(m: Message, room: Int) -> Span / {Reading} =
  span_from(
    fold(protobuf::fields(m), raw_at(protobuf::offset(m)), |r: Raw, f: Field|
      if f.number <= 8 { span_head(r, f) } else { span_tail(r, f, room) }),
  )

fn span_head(r: Raw, f: Field) -> Raw / {Reading} =
  match f.number {
    1 -> { ..r, trace_id: protobuf::bytes_of(f) },
    2 -> { ..r, span_id: protobuf::bytes_of(f) },
    3 -> { ..r, trace_state: protobuf::string_of(f) },
    4 -> { ..r, parent: protobuf::bytes_of(f) },
    5 -> { ..r, name: protobuf::string_of(f) },
    6 -> { ..r, kind: kind_of(protobuf::int_of(f), f.at) },
    7 -> { ..r, start: protobuf::fixed64_of(f) },
    8 -> { ..r, end: protobuf::fixed64_of(f) },
    _ -> r,
  }

fn span_tail(r: Raw, f: Field, room: Int) -> Raw / {Reading} =
  match f.number {
    9 -> { ..r, attributes: push(r.attributes, key_value_of(protobuf::message_of(f), room)) },
    10 -> { ..r, dropped_attributes: protobuf::uint32_of(f) },
    11 -> { ..r, events: push(r.events, event_of(protobuf::message_of(f), room)) },
    12 -> { ..r, dropped_events: protobuf::uint32_of(f) },
    13 -> { ..r, links: push(r.links, link_of(protobuf::message_of(f), room)) },
    14 -> { ..r, dropped_links: protobuf::uint32_of(f) },
    15 -> { ..r, status: status_of(protobuf::message_of(f)) },
    16 -> { ..r, flags: protobuf::fixed32_of(f) },
    _ -> r,
  }

fn scope_spans_of(m: Message, room: Int) -> ScopeSpans / {Reading} = {
  let start: ScopeSpans = { scope: scope(""), spans: [], schema_url: "" };
  fold(protobuf::fields(m), start, |s: ScopeSpans, f: Field|
    match f.number {
      1 -> { ..s, scope: scope_of(protobuf::message_of(f), room) },
      2 -> { ..s, spans: push(s.spans, span_of(protobuf::message_of(f), room)) },
      3 -> { ..s, schema_url: protobuf::string_of(f) },
      _ -> s,
    })
}

fn resource_spans_of(m: Message, room: Int) -> ResourceSpans / {Reading} = {
  let start: ResourceSpans = { resource: empty_resource(), scope_spans: [], schema_url: "" };
  fold(protobuf::fields(m), start, |r: ResourceSpans, f: Field|
    match f.number {
      1 -> { ..r, resource: resource_of(protobuf::message_of(f), room) },
      2 -> { ..r, scope_spans: push(r.scope_spans, scope_spans_of(protobuf::message_of(f), room)) },
      3 -> { ..r, schema_url: protobuf::string_of(f) },
      _ -> r,
    })
}

fn traces_of(m: Message, room: Int) -> Traces / {Reading} = {
  let start: Traces = { resource_spans: [] };
  fold(protobuf::fields(m), start, |t: Traces, f: Field|
    match f.number {
      1 ->
        {
          resource_spans: push(t.resource_spans, resource_spans_of(protobuf::message_of(f), room)),
        },
      _ -> t,
    })
}

type RawPoint = {
  attributes: List<KeyValue>,
  start: U64,
  time: U64,
  value: Option<Number>,
  at: Int,
}

fn number_point_of(m: Message, room: Int) -> NumberPoint / {Reading} = {
  let start: RawPoint = {
    attributes: [],
    start: 0u64,
    time: 0u64,
    value: None,
    at: protobuf::offset(m),
  };
  let raw = fold(protobuf::fields(m), start, |p: RawPoint, f: Field|
    match f.number {
      2 -> { ..p, start: protobuf::fixed64_of(f) },
      3 -> { ..p, time: protobuf::fixed64_of(f) },
      4 -> { ..p, value: Some(AsDouble(protobuf::double_of(f))) },
      6 -> { ..p, value: Some(AsInt(protobuf::sfixed64_of(f))) },
      7 -> { ..p, attributes: push(p.attributes, key_value_of(protobuf::message_of(f), room)) },
      _ -> p,
    });
  match raw.value {
    Some(value) -> { attributes: raw.attributes, start: raw.start, time: raw.time, value: value },
    None -> refuse(Missing("value"), raw.at, "asDouble"),
  }
}

fn empty_histogram_point() -> HistogramPoint =
  {
    attributes: [],
    start: 0u64,
    time: 0u64,
    count: 0u64,
    sum: None,
    bucket_counts: [],
    explicit_bounds: [],
    min: None,
    max: None,
  }

fn histogram_point_of(m: Message, room: Int) -> HistogramPoint / {Reading} =
  fold(protobuf::fields(m), empty_histogram_point(), |p: HistogramPoint, f: Field|
    match f.number {
      2 -> { ..p, start: protobuf::fixed64_of(f) },
      3 -> { ..p, time: protobuf::fixed64_of(f) },
      4 -> { ..p, count: protobuf::fixed64_of(f) },
      5 -> { ..p, sum: Some(protobuf::double_of(f)) },
      6 ->
        {
          ..p,
          bucket_counts: fold(
            protobuf::fixed64s_of(f),
            p.bucket_counts,
            |acc: List<U64>, n: U64| push(acc, n),
          ),
        },
      7 ->
        {
          ..p,
          explicit_bounds: fold(
            protobuf::doubles_of(f),
            p.explicit_bounds,
            |acc: List<Float>, x: Float| push(acc, x),
          ),
        },
      9 -> { ..p, attributes: push(p.attributes, key_value_of(protobuf::message_of(f), room)) },
      11 -> { ..p, min: Some(protobuf::double_of(f)) },
      12 -> { ..p, max: Some(protobuf::double_of(f)) },
      _ -> p,
    })

/// The points, temporality and monotonicity a gauge, a sum or a histogram message holds.
type RawData<p> = { points: List<p>, temporality: Int, monotonic: Bool }

fn number_data_of(m: Message, room: Int) -> RawData<NumberPoint> / {Reading} = {
  let start: RawData<NumberPoint> = { points: [], temporality: 0, monotonic: false };
  fold(protobuf::fields(m), start, |d: RawData<NumberPoint>, f: Field|
    match f.number {
      1 -> { ..d, points: push(d.points, number_point_of(protobuf::message_of(f), room)) },
      2 -> { ..d, temporality: protobuf::int_of(f) },
      3 -> { ..d, monotonic: protobuf::bool_of(f) },
      _ -> d,
    })
}

fn histogram_data_of(m: Message, room: Int) -> RawData<HistogramPoint> / {Reading} = {
  let start: RawData<HistogramPoint> = { points: [], temporality: 0, monotonic: false };
  fold(protobuf::fields(m), start, |d: RawData<HistogramPoint>, f: Field|
    match f.number {
      1 -> { ..d, points: push(d.points, histogram_point_of(protobuf::message_of(f), room)) },
      2 -> { ..d, temporality: protobuf::int_of(f) },
      _ -> d,
    })
}

type RawMetric = { name: String, description: String, unit: String, data: Option<Data>, at: Int }

fn metric_of(m: Message, room: Int) -> Metric / {Reading} = {
  let start: RawMetric = {
    name: "",
    description: "",
    unit: "",
    data: None,
    at: protobuf::offset(m),
  };
  let raw = fold(protobuf::fields(m), start, |r: RawMetric, f: Field|
    match f.number {
      1 -> { ..r, name: protobuf::string_of(f) },
      2 -> { ..r, description: protobuf::string_of(f) },
      3 -> { ..r, unit: protobuf::string_of(f) },
      5 -> { ..r, data: Some(Gauge(number_data_of(protobuf::message_of(f), room).points)) },
      7 -> {
        let d = number_data_of(protobuf::message_of(f), room);
        { ..r, data: Some(Sum(d.points, temporality_of(d.temporality, f.at), d.monotonic)) }
      },
      9 -> {
        let d = histogram_data_of(protobuf::message_of(f), room);
        { ..r, data: Some(Histogram(d.points, temporality_of(d.temporality, f.at))) }
      },
      10 -> refuse(Unsupported("exponential_histogram"), f.at, "exponentialHistogram"),
      11 -> refuse(Unsupported("summary"), f.at, "summary"),
      _ -> r,
    });
  match raw.data {
    Some(data) -> { name: raw.name, description: raw.description, unit: raw.unit, data: data },
    None -> refuse(Missing("data"), raw.at, "data"),
  }
}

fn scope_metrics_of(m: Message, room: Int) -> ScopeMetrics / {Reading} = {
  let start: ScopeMetrics = { scope: scope(""), metrics: [], schema_url: "" };
  fold(protobuf::fields(m), start, |s: ScopeMetrics, f: Field|
    match f.number {
      1 -> { ..s, scope: scope_of(protobuf::message_of(f), room) },
      2 -> { ..s, metrics: push(s.metrics, metric_of(protobuf::message_of(f), room)) },
      3 -> { ..s, schema_url: protobuf::string_of(f) },
      _ -> s,
    })
}

fn resource_metrics_of(m: Message, room: Int) -> ResourceMetrics / {Reading} = {
  let start: ResourceMetrics = { resource: empty_resource(), scope_metrics: [], schema_url: "" };
  fold(protobuf::fields(m), start, |r: ResourceMetrics, f: Field|
    match f.number {
      1 -> { ..r, resource: resource_of(protobuf::message_of(f), room) },
      2 ->
        {
          ..r,
          scope_metrics: push(r.scope_metrics, scope_metrics_of(protobuf::message_of(f), room)),
        },
      3 -> { ..r, schema_url: protobuf::string_of(f) },
      _ -> r,
    })
}

fn metrics_of(m: Message, room: Int) -> Metrics / {Reading} = {
  let start: Metrics = { resource_metrics: [] };
  fold(protobuf::fields(m), start, |held: Metrics, f: Field|
    match f.number {
      1 ->
        {
          resource_metrics: push(
            held.resource_metrics,
            resource_metrics_of(protobuf::message_of(f), room),
          ),
        },
      _ -> held,
    })
}

fn receipt_of(m: Message) -> Receipt / {Reading} = {
  let start: Receipt = { rejected: 0, message: "" };
  fold(protobuf::fields(m), start, |r: Receipt, f: Field|
    match f.number {
      1 ->
        fold(protobuf::fields(protobuf::message_of(f)), r, |inner: Receipt, g: Field|
          match g.number {
            1 -> { ..inner, rejected: protobuf::int_of(g) },
            2 -> { ..inner, message: protobuf::string_of(g) },
            _ -> inner,
          }),
      _ -> r,
    })
}

// --- JSON: writing ---------------------------------------------------------------

type Member = { key: String, value: Json }

/// An object of the members that say something: a member whose value is `Null` is left out.
fn object(members: List<Member>) -> Json =
  json::Object(
    fold(members, map_new(), |m: Map<String, Json>, e: Member|
      match e.value { Null -> m, held -> map_insert(m, e.key, held) }),
  )

/// `j` where a field says something, and `Null`, which `object` leaves out, where it holds
/// what a reader takes a missing field for.
fn said(says: Bool, j: Json) -> Json = if says { j } else { Null }

fn text_json(s: String) -> Json = said(s != "", Str(s))

fn narrow_json(n: U32) -> Json = said(n != 0u32, json::int(int_of_u32(n)))

fn wide_text(n: U64) -> String / {abort.raise} =
  u128_to_string(
    u128_of_int(int_of_u64(n >>> 32)) * 4294967296u128
      + u128_of_int(int_of_u64(n & 0xFFFF_FFFFu64)),
  )

fn moment_json(n: U64) -> Json / {abort.raise} = if n == 0u64 { Null } else { Str(wide_text(n)) }

fn list_json(items: List<Json>) -> Json = said(len(items) > 0, json::Array(items))

fn double_json(f: Float) -> Json =
  if f != f { Str("NaN") }
  else if f == infinity() { Str("Infinity") }
  else if f == neg_infinity() { Str("-Infinity") } else {
    match decimal_of_float(f) {
      Some(d) -> if float_of_decimal(d) == f { Number(d) } else { Str(float_to_string(f)) },
      None -> Str(float_to_string(f)),
    }
  }

fn value_json(v: AnyValue) -> Json / {abort.raise} =
  match v {
    StringValue(s) -> json::object([{ key: "stringValue", value: Str(s) }]),
    BoolValue(b) -> json::object([{ key: "boolValue", value: json::Bool(b) }]),
    IntValue(n) -> json::object([{ key: "intValue", value: Str(int_to_string(n)) }]),
    DoubleValue(f) -> json::object([{ key: "doubleValue", value: double_json(f) }]),
    ArrayValue(xs) ->
      json::object([
        {
          key: "arrayValue",
          value: object([{ key: "values", value: list_json(map(xs, value_json)) }]),
        },
      ]),
    KvlistValue(kvs) ->
      json::object([
        { key: "kvlistValue", value: object([{ key: "values", value: attributes_json(kvs) }]) },
      ]),
    BytesValue(b) -> json::object([{ key: "bytesValue", value: Str(base64_encode(b)) }]),
    NoValue -> json::object([]),
  }

fn key_value_json(kv: KeyValue) -> Json / {abort.raise} =
  object([
    { key: "key", value: text_json(kv.key) },
    { key: "value", value: match kv.value { NoValue -> Null, held -> value_json(held) } },
  ])

fn attributes_json(kvs: List<KeyValue>) -> Json / {abort.raise} =
  list_json(map(kvs, key_value_json))

fn resource_json(r: Resource) -> Json / {abort.raise} =
  object([
    { key: "attributes", value: attributes_json(r.attributes) },
    { key: "droppedAttributesCount", value: narrow_json(r.dropped_attributes) },
  ])

fn scope_json(s: Scope) -> Json / {abort.raise} =
  object([
    { key: "name", value: text_json(s.name) },
    { key: "version", value: text_json(s.version) },
    { key: "attributes", value: attributes_json(s.attributes) },
    { key: "droppedAttributesCount", value: narrow_json(s.dropped_attributes) },
  ])

fn enum_json(n: Int) -> Json = said(n != 0, json::int(n))

fn status_json(s: Status) -> Json =
  if s == unset() { Null } else {
    object([
      { key: "message", value: text_json(s.message) },
      { key: "code", value: enum_json(code_number(s.code)) },
    ])
  }

fn event_json(e: Event) -> Json / {abort.raise} =
  object([
    { key: "timeUnixNano", value: moment_json(e.time) },
    { key: "name", value: text_json(e.name) },
    { key: "attributes", value: attributes_json(e.attributes) },
    { key: "droppedAttributesCount", value: narrow_json(e.dropped_attributes) },
  ])

fn link_json(l: Link) -> Json / {abort.raise} =
  object([
    { key: "traceId", value: Str(traceparent::trace_id_hex(l.trace_id)) },
    { key: "spanId", value: Str(traceparent::span_id_hex(l.span_id)) },
    { key: "traceState", value: text_json(l.trace_state) },
    { key: "attributes", value: attributes_json(l.attributes) },
    { key: "droppedAttributesCount", value: narrow_json(l.dropped_attributes) },
    { key: "flags", value: narrow_json(l.flags) },
  ])

fn span_json(s: Span) -> Json / {abort.raise} =
  object([
    { key: "traceId", value: Str(traceparent::trace_id_hex(s.trace_id)) },
    { key: "spanId", value: Str(traceparent::span_id_hex(s.span_id)) },
    { key: "traceState", value: text_json(s.trace_state) },
    {
      key: "parentSpanId",
      value: match s.parent { Some(id) -> Str(traceparent::span_id_hex(id)), None -> Null },
    },
    { key: "flags", value: narrow_json(s.flags) },
    { key: "name", value: text_json(s.name) },
    { key: "kind", value: enum_json(kind_number(s.kind)) },
    { key: "startTimeUnixNano", value: moment_json(s.start) },
    { key: "endTimeUnixNano", value: moment_json(s.end) },
    { key: "attributes", value: attributes_json(s.attributes) },
    { key: "droppedAttributesCount", value: narrow_json(s.dropped_attributes) },
    { key: "events", value: list_json(map(s.events, event_json)) },
    { key: "droppedEventsCount", value: narrow_json(s.dropped_events) },
    { key: "links", value: list_json(map(s.links, link_json)) },
    { key: "droppedLinksCount", value: narrow_json(s.dropped_links) },
    { key: "status", value: status_json(s.status) },
  ])

fn scope_spans_json(s: ScopeSpans) -> Json / {abort.raise} =
  object([
    { key: "scope", value: scope_json(s.scope) },
    { key: "spans", value: list_json(map(s.spans, span_json)) },
    { key: "schemaUrl", value: text_json(s.schema_url) },
  ])

fn resource_spans_json(r: ResourceSpans) -> Json / {abort.raise} =
  object([
    { key: "resource", value: resource_json(r.resource) },
    { key: "scopeSpans", value: list_json(map(r.scope_spans, scope_spans_json)) },
    { key: "schemaUrl", value: text_json(r.schema_url) },
  ])

fn traces_json(t: Traces) -> Json / {abort.raise} =
  object([{ key: "resourceSpans", value: list_json(map(t.resource_spans, resource_spans_json)) }])

fn number_point_json(p: NumberPoint) -> Json / {abort.raise} =
  object([
    { key: "attributes", value: attributes_json(p.attributes) },
    { key: "startTimeUnixNano", value: moment_json(p.start) },
    { key: "timeUnixNano", value: moment_json(p.time) },
    match p.value {
      AsDouble(f) -> { key: "asDouble", value: double_json(f) },
      AsInt(n) -> { key: "asInt", value: Str(int_to_string(n)) },
    },
  ])

fn optional_double_json(f: Option<Float>) -> Json =
  match f { Some(x) -> double_json(x), None -> Null }

fn histogram_point_json(p: HistogramPoint) -> Json / {abort.raise} =
  object([
    { key: "attributes", value: attributes_json(p.attributes) },
    { key: "startTimeUnixNano", value: moment_json(p.start) },
    { key: "timeUnixNano", value: moment_json(p.time) },
    { key: "count", value: moment_json(p.count) },
    { key: "sum", value: optional_double_json(p.sum) },
    { key: "bucketCounts", value: list_json(map(p.bucket_counts, |n: U64| Str(wide_text(n)))) },
    { key: "explicitBounds", value: list_json(map(p.explicit_bounds, double_json)) },
    { key: "min", value: optional_double_json(p.min) },
    { key: "max", value: optional_double_json(p.max) },
  ])

fn data_member(d: Data) -> Member / {abort.raise} =
  match d {
    Gauge(points) ->
      {
        key: "gauge",
        value: json::object([
          { key: "dataPoints", value: json::Array(map(points, number_point_json)) },
        ]),
      },
    Sum(points, temporality, monotonic) ->
      {
        key: "sum",
        value: object([
          { key: "dataPoints", value: list_json(map(points, number_point_json)) },
          { key: "aggregationTemporality", value: json::int(temporality_number(temporality)) },
          { key: "isMonotonic", value: if monotonic { json::Bool(true) } else { Null } },
        ]),
      },
    Histogram(points, temporality) ->
      {
        key: "histogram",
        value: object([
          { key: "dataPoints", value: list_json(map(points, histogram_point_json)) },
          { key: "aggregationTemporality", value: json::int(temporality_number(temporality)) },
        ]),
      },
  }

fn metric_json(m: Metric) -> Json / {abort.raise} =
  object([
    { key: "name", value: text_json(m.name) },
    { key: "description", value: text_json(m.description) },
    { key: "unit", value: text_json(m.unit) },
    data_member(m.data),
  ])

fn scope_metrics_json(s: ScopeMetrics) -> Json / {abort.raise} =
  object([
    { key: "scope", value: scope_json(s.scope) },
    { key: "metrics", value: list_json(map(s.metrics, metric_json)) },
    { key: "schemaUrl", value: text_json(s.schema_url) },
  ])

fn resource_metrics_json(r: ResourceMetrics) -> Json / {abort.raise} =
  object([
    { key: "resource", value: resource_json(r.resource) },
    { key: "scopeMetrics", value: list_json(map(r.scope_metrics, scope_metrics_json)) },
    { key: "schemaUrl", value: text_json(r.schema_url) },
  ])

fn metrics_json(m: Metrics) -> Json / {abort.raise} =
  object([
    { key: "resourceMetrics", value: list_json(map(m.resource_metrics, resource_metrics_json)) },
  ])

fn rejected_name(signal: Signal) -> String =
  match signal { TraceSignal -> "rejectedSpans", MetricSignal -> "rejectedDataPoints" }

fn receipt_json(signal: Signal, r: Receipt) -> Json =
  if r.rejected == 0 && r.message == "" { json::object([]) } else {
    json::object([
      {
        key: "partialSuccess",
        value: object([
          {
            key: rejected_name(signal),
            value: if r.rejected == 0 { Null } else { Str(int_to_string(r.rejected)) },
          },
          { key: "errorMessage", value: text_json(r.message) },
        ]),
      },
    ])
  }

// --- JSON: reading ---------------------------------------------------------------

type Members = Map<String, Json>

fn parsed(data: Bytes, limits: Limits) -> Json / {otlp.refused, abort.raise} =
  if bytes_len(data) > limits.length { refuse(TooLong, limits.length, "") } else {
    match json::parse(data) {
      Ok(j) -> j,
      Err(e) -> refuse(NotJson(e.message), match e.offset { Some(at) -> at, None -> -1 }, ""),
    }
  }

fn unfit<a>(why: Why, field: String) -> a / {otlp.refused} = refuse(why, -1, field)

/// A member's value, with a `null` read as the member left out, as the mapping reads one.
fn member(o: Members, name: String) -> Option<Json> =
  match map_get(o, name) { Some(Null) -> None, other -> other }

fn members_of(j: Json, field: String) -> Members / {otlp.refused} =
  match j { json::Object(m) -> m, _ -> unfit(WrongKind("an object"), field) }

/// The object under `name`, or an empty one where it is left out.
fn members_in(o: Members, name: String) -> Members / {otlp.refused} =
  match member(o, name) { Some(j) -> members_of(j, name), None -> map_new() }

fn items_in(o: Members, name: String) -> List<Json> / {otlp.refused} =
  match member(o, name) {
    Some(json::Array(items)) -> items,
    Some(_) -> unfit(WrongKind("an array"), name),
    None -> [],
  }

fn text_in(o: Members, name: String) -> String / {otlp.refused} =
  match member(o, name) {
    Some(Str(s)) -> s,
    Some(_) -> unfit(WrongKind("a string"), name),
    None -> "",
  }

fn all_digits(raw: Bytes) -> Bool / {abort.raise} =
  bytes_len(raw) > 0 && bytes_scan(raw, 0, b"0123456789", bytes_len(raw)) >= bytes_len(raw)

/// The whole number a 64-bit field holds: a decimal string, or a JSON number that is whole.
fn whole_text(j: Json, field: String) -> String / {otlp.refused} =
  match j {
    Str(s) -> s,
    Number(d) -> decimal_to_string(d),
    _ -> unfit(WrongKind("a whole number, as a string of digits or a number"), field),
  }

fn wide_of(j: Json, field: String) -> U64 / {otlp.refused, abort.raise} = {
  let digits = whole_text(j, field);
  if !all_digits(bytes_of_string(digits)) || string_len(digits) > 20 { unfit(BadNumber, field) }
  else {
    match u128_of_string(digits) {
      Some(n) -> if n > 18446744073709551615u128 { unfit(BadNumber, field) } else {
        u64_of_int(int_of_u128(n / 4294967296u128)) << 32
          | u64_of_int(int_of_u128(n % 4294967296u128))
      },
      None -> unfit(BadNumber, field),
    }
  }
}

fn wide_in(o: Members, name: String) -> U64 / {otlp.refused, abort.raise} =
  match member(o, name) { Some(j) -> wide_of(j, name), None -> 0u64 }

fn int_of_json(j: Json, field: String) -> Int / {otlp.refused, abort.raise} = {
  let written = whole_text(j, field);
  let raw = bytes_of_string(written);
  let negative = bytes_starts_with(raw, b"-");
  let digits = if negative { bytes_slice(raw, 1, bytes_len(raw)) } else { raw };
  if !all_digits(digits) || bytes_len(digits) > 19 { unfit(BadNumber, field) } else {
    match i128_of_string(written) {
      Some(n) -> if n > 9223372036854775807i128 || n < 0i128 - 9223372036854775808i128 {
        unfit(BadNumber, field)
      } else { int_of_i128(n) },
      None -> unfit(BadNumber, field),
    }
  }
}

fn int_in(o: Members, name: String) -> Int / {otlp.refused, abort.raise} =
  match member(o, name) { Some(j) -> int_of_json(j, name), None -> 0 }

/// A 32-bit field: a JSON number, whole and in range.
fn narrow_in(o: Members, name: String) -> U32 / {otlp.refused, abort.raise} =
  match member(o, name) {
    None -> 0u32,
    Some(j) -> {
      let n = int_of_json(j, name);
      if n < 0 || n > 4294967295 { unfit(BadNumber, name) } else { u32_of_int(n) }
    },
  }

/// An enum's number: the mapping writes no names.
fn enum_in(o: Members, name: String) -> Int / {otlp.refused, abort.raise} =
  match member(o, name) {
    None -> 0,
    Some(Number(d)) -> int_of_json(Number(d), name),
    Some(_) -> unfit(WrongKind("an enum's number"), name),
  }

fn double_of_json(j: Json, field: String) -> Float / {otlp.refused} =
  match j {
    Number(d) -> float_of_decimal(d),
    Str("NaN") -> nan(),
    Str("Infinity") -> infinity(),
    Str("-Infinity") -> neg_infinity(),
    Str(s) -> match float_of_string(s) {
      Some(f) -> f,
      None -> unfit(WrongKind("a number"), field),
    },
    _ -> unfit(WrongKind("a number"), field),
  }

fn optional_double_in(o: Members, name: String) -> Option<Float> / {otlp.refused} =
  match member(o, name) { Some(j) -> Some(double_of_json(j, name)), None -> None }

fn bool_in(o: Members, name: String) -> Bool / {otlp.refused} =
  match member(o, name) {
    Some(json::Bool(b)) -> b,
    Some(_) -> unfit(WrongKind("true or false"), name),
    None -> false,
  }

/// An id's bytes: hex in either case, as the mapping writes one.
fn hex_in(o: Members, name: String) -> Bytes / {otlp.refused, abort.raise} = {
  let written = ascii_lower(text_in(o, name));
  match try[abort.raise] { bytes_of_hex(written) } {
    Ok(raw) -> raw,
    Err(_) -> unfit(BadText, name),
  }
}

fn value_of_json(j: Json, room: Int) -> AnyValue / {otlp.refused, abort.raise} =
  if room <= 0 { unfit(TooDeep, "value") } else {
    let o = members_of(j, "value");
    match ((member(o, "stringValue"), member(o, "boolValue"), member(o, "intValue"))) {
      (Some(Str(s)), _, _) -> StringValue(s),
      (Some(_), _, _) -> unfit(WrongKind("a string"), "stringValue"),
      (_, Some(json::Bool(b)), _) -> BoolValue(b),
      (_, Some(_), _) -> unfit(WrongKind("true or false"), "boolValue"),
      (_, _, Some(n)) -> IntValue(int_of_json(n, "intValue")),
      _ -> compound_of_json(o, room - 1),
    }
  }

fn compound_of_json(o: Members, room: Int) -> AnyValue / {otlp.refused, abort.raise} =
  match member(o, "doubleValue") {
    Some(f) -> DoubleValue(double_of_json(f, "doubleValue")),
    None -> match member(o, "arrayValue") {
      Some(held) ->
        ArrayValue(
          map(items_in(members_of(held, "arrayValue"), "values"), |x: Json| value_of_json(x, room)),
        ),
      None -> match member(o, "kvlistValue") {
        Some(held) ->
          KvlistValue(key_values_of_json(members_of(held, "kvlistValue"), "values", room)),
        None -> match member(o, "bytesValue") {
          Some(Str(text)) -> match base64_decode(text) {
            Some(raw) -> BytesValue(raw),
            None -> unfit(BadText, "bytesValue"),
          },
          Some(_) -> unfit(WrongKind("a string of base64"), "bytesValue"),
          None -> NoValue,
        },
      },
    },
  }

fn key_values_of_json(
  o: Members,
  name: String,
  room: Int,
) -> List<KeyValue> / {otlp.refused, abort.raise} =
  map(items_in(o, name), |j: Json| -> KeyValue {
    let kv = members_of(j, name);
    {
      key: text_in(kv, "key"),
      value: match member(kv, "value") { Some(v) -> value_of_json(v, room), None -> NoValue },
    }
  })

fn resource_of_json(o: Members, room: Int) -> Resource / {otlp.refused, abort.raise} =
  {
    attributes: key_values_of_json(o, "attributes", room),
    dropped_attributes: narrow_in(o, "droppedAttributesCount"),
  }

fn scope_of_json(o: Members, room: Int) -> Scope / {otlp.refused, abort.raise} =
  {
    name: text_in(o, "name"),
    version: text_in(o, "version"),
    attributes: key_values_of_json(o, "attributes", room),
    dropped_attributes: narrow_in(o, "droppedAttributesCount"),
  }

fn status_of_json(o: Members) -> Status / {otlp.refused, abort.raise} =
  { code: code_of(enum_in(o, "code"), -1), message: text_in(o, "message") }

fn event_of_json(j: Json, room: Int) -> Event / {otlp.refused, abort.raise} = {
  let o = members_of(j, "events");
  {
    time: wide_in(o, "timeUnixNano"),
    name: text_in(o, "name"),
    attributes: key_values_of_json(o, "attributes", room),
    dropped_attributes: narrow_in(o, "droppedAttributesCount"),
  }
}

fn link_of_json(j: Json, room: Int) -> Link / {otlp.refused, abort.raise} = {
  let o = members_of(j, "links");
  {
    trace_id: trace_id_of(hex_in(o, "traceId"), -1),
    span_id: span_id_of(hex_in(o, "spanId"), -1, "spanId"),
    trace_state: text_in(o, "traceState"),
    attributes: key_values_of_json(o, "attributes", room),
    dropped_attributes: narrow_in(o, "droppedAttributesCount"),
    flags: narrow_in(o, "flags"),
  }
}

fn span_of_json(j: Json, room: Int) -> Span / {otlp.refused, abort.raise} = {
  let o = members_of(j, "spans");
  {
    trace_id: trace_id_of(hex_in(o, "traceId"), -1),
    span_id: span_id_of(hex_in(o, "spanId"), -1, "spanId"),
    trace_state: text_in(o, "traceState"),
    parent: parent_of(hex_in(o, "parentSpanId"), -1),
    flags: narrow_in(o, "flags"),
    name: text_in(o, "name"),
    kind: kind_of(enum_in(o, "kind"), -1),
    start: wide_in(o, "startTimeUnixNano"),
    end: wide_in(o, "endTimeUnixNano"),
    attributes: key_values_of_json(o, "attributes", room),
    dropped_attributes: narrow_in(o, "droppedAttributesCount"),
    events: map(items_in(o, "events"), |e: Json| event_of_json(e, room)),
    dropped_events: narrow_in(o, "droppedEventsCount"),
    links: map(items_in(o, "links"), |l: Json| link_of_json(l, room)),
    dropped_links: narrow_in(o, "droppedLinksCount"),
    status: status_of_json(members_in(o, "status")),
  }
}

fn traces_of_json(j: Json, room: Int) -> Traces / {otlp.refused, abort.raise} =
  {
    resource_spans: map(items_in(members_of(j, ""), "resourceSpans"), |r: Json| -> ResourceSpans {
      let o = members_of(r, "resourceSpans");
      {
        resource: resource_of_json(members_in(o, "resource"), room),
        scope_spans: map(items_in(o, "scopeSpans"), |s: Json| -> ScopeSpans {
          let held = members_of(s, "scopeSpans");
          {
            scope: scope_of_json(members_in(held, "scope"), room),
            spans: map(items_in(held, "spans"), |x: Json| span_of_json(x, room)),
            schema_url: text_in(held, "schemaUrl"),
          }
        }),
        schema_url: text_in(o, "schemaUrl"),
      }
    }),
  }

fn number_point_of_json(j: Json, room: Int) -> NumberPoint / {otlp.refused, abort.raise} = {
  let o = members_of(j, "dataPoints");
  {
    attributes: key_values_of_json(o, "attributes", room),
    start: wide_in(o, "startTimeUnixNano"),
    time: wide_in(o, "timeUnixNano"),
    value: match ((member(o, "asDouble"), member(o, "asInt"))) {
      (Some(f), _) -> AsDouble(double_of_json(f, "asDouble")),
      (_, Some(n)) -> AsInt(int_of_json(n, "asInt")),
      _ -> unfit(Missing("value"), "asDouble"),
    },
  }
}

fn histogram_point_of_json(j: Json, room: Int) -> HistogramPoint / {otlp.refused, abort.raise} = {
  let o = members_of(j, "dataPoints");
  {
    attributes: key_values_of_json(o, "attributes", room),
    start: wide_in(o, "startTimeUnixNano"),
    time: wide_in(o, "timeUnixNano"),
    count: wide_in(o, "count"),
    sum: optional_double_in(o, "sum"),
    bucket_counts: map(items_in(o, "bucketCounts"), |n: Json| wide_of(n, "bucketCounts")),
    explicit_bounds: map(items_in(o, "explicitBounds"), |x: Json|
      double_of_json(x, "explicitBounds")),
    min: optional_double_in(o, "min"),
    max: optional_double_in(o, "max"),
  }
}

fn data_of_json(o: Members, room: Int) -> Data / {otlp.refused, abort.raise} =
  match ((member(o, "gauge"), member(o, "sum"), member(o, "histogram"))) {
    (Some(g), _, _) ->
      Gauge(
        map(items_in(members_of(g, "gauge"), "dataPoints"), |p: Json|
          number_point_of_json(p, room)),
      ),
    (_, Some(s), _) -> {
      let held = members_of(s, "sum");
      Sum(
        map(items_in(held, "dataPoints"), |p: Json| number_point_of_json(p, room)),
        temporality_of(enum_in(held, "aggregationTemporality"), -1),
        bool_in(held, "isMonotonic"),
      )
    },
    (_, _, Some(h)) -> {
      let held = members_of(h, "histogram");
      Histogram(
        map(items_in(held, "dataPoints"), |p: Json| histogram_point_of_json(p, room)),
        temporality_of(enum_in(held, "aggregationTemporality"), -1),
      )
    },
    _ -> if map_contains(o, "exponentialHistogram") {
      unfit(Unsupported("exponential_histogram"), "exponentialHistogram")
    } else if map_contains(o, "summary") { unfit(Unsupported("summary"), "summary") }
    else { unfit(Missing("data"), "data") },
  }

fn metrics_of_json(j: Json, room: Int) -> Metrics / {otlp.refused, abort.raise} =
  {
    resource_metrics: map(
      items_in(members_of(j, ""), "resourceMetrics"),
      |r: Json| -> ResourceMetrics {
        let o = members_of(r, "resourceMetrics");
        {
          resource: resource_of_json(members_in(o, "resource"), room),
          scope_metrics: map(items_in(o, "scopeMetrics"), |s: Json| -> ScopeMetrics {
            let held = members_of(s, "scopeMetrics");
            {
              scope: scope_of_json(members_in(held, "scope"), room),
              metrics: map(items_in(held, "metrics"), |x: Json| -> Metric {
                let m = members_of(x, "metrics");
                {
                  name: text_in(m, "name"),
                  description: text_in(m, "description"),
                  unit: text_in(m, "unit"),
                  data: data_of_json(m, room),
                }
              }),
              schema_url: text_in(held, "schemaUrl"),
            }
          }),
          schema_url: text_in(o, "schemaUrl"),
        }
      },
    ),
  }

fn receipt_of_json(signal: Signal, j: Json) -> Receipt / {otlp.refused, abort.raise} = {
  let partial = members_in(members_of(j, ""), "partialSuccess");
  { rejected: int_in(partial, rejected_name(signal)), message: text_in(partial, "errorMessage") }
}

// --- The exporter ---------------------------------------------------------------

/// What an exporter has done so far.
pub type Stats = new {
  /// Spans a collector took.
  exported: Int,
  /// Spans that ended while the queue was full.
  dropped: Int,
  /// Spans in requests that were given up on: refused outright, or failed `attempts` times.
  failed: Int,
  /// Spans a collector answered it had turned away.
  rejected: Int,
  /// Spans that ended in a trace that is not recorded.
  unsampled: Int,
  /// Requests a collector answered with success, of spans or of metrics.
  requests: Int,
  /// Requests sent again after a failure that may pass.
  retries: Int,
  /// Label sets turned away because their metric already had `max_series`.
  series_dropped: Int,
  /// `trace.exit` of a span that was not open.
  misplaced: Int,
  /// Spans waiting to be sent, those of a request waiting to be sent again among them.
  queued: Int,
}

/// How an exporter ships.
pub type Config = new {
  /// The collector's host, as `net.connect` takes one.
  host: String,
  port: Int,
  /// Whether to connect over TLS.
  tls: Bool,
  /// What stands before `/v1/traces` in the collector's paths; empty at its root.
  prefix: String,
  /// Fields every request carries, an `Authorization` among them.
  headers: http::Headers,
  encoding: Encoding,
  /// Whether a request's body is gzipped.
  gzip: Bool,
  resource: Resource,
  /// How a trace that starts in this process is sampled; a span under a parent takes its
  /// parent's decision.
  sampler: Sampler,
  /// The most finished spans that wait; one that ends past it is dropped and counted.
  queue: Int,
  /// The most spans one request carries, and how many waiting make a request due.
  batch: Int,
  /// How long, in milliseconds, a span waits before a request is due whatever the count.
  max_age_ms: Int,
  /// How often, in milliseconds, the metrics are sent.
  metrics_every_ms: Int,
  /// The most label sets one metric keeps; a new one past it is dropped and counted.
  max_series: Int,
  /// How many times one request is sent before it is given up on.
  attempts: Int,
  /// The wait before a first retry, in milliseconds; it doubles with each one.
  backoff_ms: Int,
  /// The longest wait before a retry.
  max_backoff_ms: Int,
  /// How long, in milliseconds, a flush may take; what still waits after it stays waiting.
  flush_ms: Int,
  /// The upper bounds, in seconds, a timing is counted under.
  bounds: List<Float>,
  /// The deadlines of one request, and the most bytes of an answer.
  limits: http::Limits,
}

/// An exporter for the service `service` to the collector at `host` and `port`, over plain
/// HTTP in protobuf, with what OpenTelemetry's SDKs default to: every trace recorded, 2048
/// spans queued, 512 a request, a request after five seconds, metrics every minute, five
/// attempts from one second up to thirty apart, ten seconds for a request and thirty for a
/// flush.
pub fn config(service: String, host: String, port: Int) -> Config = {
  let base: http::Limits = http::default_limits();
  {
    host: host,
    port: port,
    tls: false,
    prefix: "",
    headers: http::empty_headers(),
    encoding: Protobuf,
    gzip: false,
    resource: {
      attributes: [
        attribute(telemetry::service_name(), StringValue(service)),
        attribute(telemetry::telemetry_sdk_name(), StringValue("ply")),
        attribute(telemetry::telemetry_sdk_language(), StringValue("ply")),
      ],
      dropped_attributes: 0u32,
    },
    sampler: telemetry::AlwaysOn,
    queue: 2048,
    batch: 512,
    max_age_ms: 5000,
    metrics_every_ms: 60000,
    max_series: 2000,
    attempts: 5,
    backoff_ms: 1000,
    max_backoff_ms: 30000,
    flush_ms: 30000,
    bounds: telemetry::duration_bounds(),
    limits: {
      ..base,
      connect_timeout_ms: 10000,
      header_timeout_ms: 10000,
      body_timeout_ms: 10000,
      write_timeout_ms: 10000,
    },
  }
}

/// A span that is open.
type Open = {
  id: Int,
  channel: String,
  name: String,
  who: telemetry::Identity,
  start: U64,
  fields: Fields,
}

/// A span that ended, with the channel it was on.
type Done = { channel: String, span: Span }

/// A request, encoded: what it holds, how many times it has been sent, and when it may be
/// sent again.
type Outbound = { signal: Signal, body: Bytes, items: Int, attempts: Int, not_before: Int }

/// What one series of a metric has come to.
type Tallied =
  /// A counter's total, and whether every step so far added to it.
  | Counted(Int, Bool)
  | Level(Float)
  /// A timing's count in each bucket, and its sum, least and greatest, in seconds.
  | Timed(List<Int>, Float, Float, Float)

type Series = { channel: String, name: String, fields: Fields, value: Tallied }

type State = {
  /// Innermost first.
  open: List<Open>,
  next: Int,
  queue: List<Done>,
  /// When the oldest span in the queue joined it.
  queued_at: Int,
  pending: Option<Outbound>,
  busy: Bool,
  /// By channel, kind, name and fields, so one metric's series stand together.
  series: Map<String, Series>,
  /// How many series each metric has.
  widths: Map<String, Int>,
  /// Whether a metric moved since the metrics were last sent.
  dirty: Bool,
  metrics_at: Int,
  started: U64,
  stats: Stats,
}

fn fresh(started: U64, now_ms: Int) -> State =
  {
    open: [],
    next: 1,
    queue: [],
    queued_at: now_ms,
    pending: None,
    busy: false,
    series: map_new(),
    widths: map_new(),
    dirty: false,
    metrics_at: now_ms,
    started: started,
    stats: {
      exported: 0,
      dropped: 0,
      failed: 0,
      rejected: 0,
      unsampled: 0,
      requests: 0,
      retries: 0,
      series_dropped: 0,
      misplaced: 0,
      queued: 0,
    },
  }

fn stats_of(s: State) -> Stats =
  {
    ..s.stats,
    queued: len(s.queue)
      + (match s.pending {
        Some(waiting) -> match waiting.signal { TraceSignal -> waiting.items, MetricSignal -> 0 },
        None -> 0,
      }),
  }

/// Nanoseconds since the Unix epoch: the wall clock read once, and the monotonic clock since.
fn nanos_now(wall_ms: Int, mono_us: Int, now_us: Int) -> U64 =
  match try[abort.raise] { u64_of_int(max(wall_ms * 1000 + (now_us - mono_us), 0) * 1000) } {
    Ok(n) -> n,
    Err(_) -> 0u64,
  }

fn opened(
  s: State,
  channel: String,
  name: String,
  who: telemetry::Identity,
  fields: Fields,
  at: U64,
) -> State =
  {
    ..s,
    next: s.next + 1,
    open: concat(
      [{ id: s.next, channel: channel, name: name, who: who, start: at, fields: fields }],
      s.open,
    ),
  }

fn value_of_field(f: trace::Field) -> AnyValue / {abort.raise} =
  match f {
    trace::FInt(n) -> IntValue(n),
    trace::FBool(b) -> BoolValue(b),
    trace::FText(s) -> StringValue(s),
    trace::FFloat(x) -> DoubleValue(x),
    trace::FDecimal(d) -> DoubleValue(float_of_decimal(d)),
    trace::FBytes(b) -> BytesValue(b),
    trace::FJson(j) -> StringValue(json::to_string(j)),
  }

/// Fields as attributes, in the order of their names.
fn attributes_of(fields: Fields) -> List<KeyValue> / {abort.raise} =
  map(map_entries(fields), |e: { key: String, value: trace::Field }| -> KeyValue {
    { key: e.key, value: value_of_field(e.value) }
  })

fn kind_from(kind: telemetry::Kind) -> SpanKind =
  match kind {
    telemetry::Internal -> Internal,
    telemetry::Server -> Server,
    telemetry::Client -> Client,
    telemetry::Producer -> Producer,
    telemetry::Consumer -> Consumer,
  }

/// A span that ended well says nothing, as OpenTelemetry asks of instrumentation.
fn status_for(outcome: trace::Outcome) -> Status =
  match outcome {
    trace::Ok -> unset(),
    trace::Failed(why) -> { code: StatusError, message: why },
    trace::Abandoned -> { code: StatusError, message: "abandoned" },
  }

fn finished(o: Open, outcome: trace::Outcome, at: U64) -> Done / {abort.raise} = {
  let context = o.who.context;
  {
    channel: o.channel,
    span: {
      trace_id: context.parent.trace_id,
      span_id: context.parent.parent_id,
      trace_state: traceparent::render_state(context.state),
      parent: o.who.parent,
      flags: u32_of_int(context.parent.flags & 0xFF),
      name: o.name,
      kind: kind_from(o.who.kind),
      start: o.start,
      end: at,
      attributes: attributes_of(o.fields),
      dropped_attributes: 0u32,
      events: [],
      dropped_events: 0u32,
      links: [],
      dropped_links: 0u32,
      status: status_for(outcome),
    },
  }
}

fn is_sampled(o: Open) -> Bool = traceparent::sampled(o.who.context.parent)

/// `s` with `done` waiting to be sent, or counted as dropped where the queue is full.
fn queued(s: State, cfg: Config, done: Done, now_ms: Int) -> State =
  if len(s.queue) >= max(cfg.queue, 1) {
    { ..s, stats: { ..s.stats, dropped: s.stats.dropped + 1 } }
  } else {
    {
      ..s,
      queue: push(s.queue, done),
      queued_at: if len(s.queue) == 0 { now_ms } else { s.queued_at },
    }
  }

type Sweep = { closing: List<SpanId>, kept: List<Open>, state: State }

/// `s` with the span `span` closed as `outcome`, and every span opened under it that is still
/// open closed as abandoned, which is what `trace.exit` says it does.
fn closed(
  s: State,
  cfg: Config,
  span: trace::Span,
  outcome: trace::Outcome,
  at: U64,
  now_ms: Int,
) -> State / {abort.raise} =
  match find(s.open, |o: Open| o.id == span.id && o.channel == span.channel) {
    None -> { ..s, stats: { ..s.stats, misplaced: s.stats.misplaced + 1 } },
    Some(target) -> {
      let start: Sweep = { closing: [target.who.context.parent.parent_id], kept: [], state: s };
      let swept = fold(reverse(s.open), start, |acc: Sweep, o: Open| -> Sweep {
        let under = match o.who.parent { Some(p) -> contains(acc.closing, p), None -> false };
        if o.id == target.id { { ..acc, state: ended(acc.state, cfg, o, outcome, at, now_ms) } }
        else if under {
          {
            closing: push(acc.closing, o.who.context.parent.parent_id),
            kept: acc.kept,
            state: ended(acc.state, cfg, o, trace::Abandoned, at, now_ms),
          }
        } else { { ..acc, kept: push(acc.kept, o) } }
      });
      { ..swept.state, open: reverse(swept.kept) }
    },
  }

fn ended(
  s: State,
  cfg: Config,
  o: Open,
  outcome: trace::Outcome,
  at: U64,
  now_ms: Int,
) -> State / {abort.raise} =
  if is_sampled(o) { queued(s, cfg, finished(o, outcome, at), now_ms) }
  else { { ..s, stats: { ..s.stats, unsampled: s.stats.unsampled + 1 } } }

fn annotated(s: State, span: SpanId, fields: Fields) -> State =
  {
    ..s,
    open: map(s.open, |o: Open|
      if o.who.context.parent.parent_id == span { { ..o, fields: map_merge(o.fields, fields) } }
      else { o }),
  }

/// `s` with one metric's series under `fields` moved by `step`, which is handed what the
/// series held; a label set past the metric's `max_series` is counted and not kept.
fn tallied(
  s: State,
  cfg: Config,
  channel: String,
  kind: String,
  name: String,
  fields: Fields,
  step: (Option<Tallied>) -> Tallied,
) -> State = {
  let metric = channel ++ "\u{0}" ++ kind ++ "\u{0}" ++ name;
  let key = metric ++ "\u{0}" ++ show(fields);
  match map_get(s.series, key) {
    Some(held) ->
      {
        ..s,
        dirty: true,
        series: map_insert(s.series, key, { ..held, value: step(Some(held.value)) }),
      },
    None -> {
      let width = match map_get(s.widths, metric) { Some(n) -> n, None -> 0 };
      if width >= max(cfg.max_series, 1) {
        { ..s, stats: { ..s.stats, series_dropped: s.stats.series_dropped + 1 } }
      } else {
        {
          ..s,
          dirty: true,
          widths: map_insert(s.widths, metric, width + 1),
          series: map_insert(s.series, key, {
            channel: channel,
            name: name,
            fields: fields,
            value: step(None),
          }),
        }
      }
    },
  }
}

fn counted(held: Option<Tallied>, delta: Int) -> Tallied =
  match held {
    Some(Counted(total, rising)) -> Counted(total + delta, rising && delta >= 0),
    _ -> Counted(delta, delta >= 0),
  }

fn timed(held: Option<Tallied>, bounds: List<Float>, seconds: Float) -> Tallied =
  match held {
    Some(Timed(counts, sum, least, greatest)) ->
      Timed(
        telemetry::counted(bounds, counts, seconds),
        sum + seconds,
        if seconds < least { seconds } else { least },
        if seconds > greatest { seconds } else { greatest },
      ),
    _ -> Timed(telemetry::counted(bounds, [], seconds), seconds, seconds, seconds),
  }

fn wide_of_int(n: Int) -> U64 =
  match try[abort.raise] { u64_of_int(max(n, 0)) } { Ok(w) -> w, Err(_) -> 0u64 }

/// One series as a metric holding its one point.
fn metric_of_series(cfg: Config, held: Series, started: U64, at: U64) -> Metric / {abort.raise} = {
  let attributes = attributes_of(held.fields);
  match held.value {
    Counted(total, rising) ->
      {
        name: held.name,
        description: "",
        unit: "",
        data: Sum(
          [{ attributes: attributes, start: started, time: at, value: AsInt(total) }],
          Cumulative,
          rising,
        ),
      },
    Level(level) ->
      {
        name: held.name,
        description: "",
        unit: "",
        data: Gauge([{ attributes: attributes, start: 0u64, time: at, value: AsDouble(level) }]),
      },
    Timed(counts, sum, least, greatest) ->
      {
        name: held.name,
        description: "",
        unit: "s",
        data: Histogram(
          [
            {
              attributes: attributes,
              start: started,
              time: at,
              count: wide_of_int(fold(counts, 0, |n: Int, c: Int| n + c)),
              sum: Some(sum),
              bucket_counts: map(counts, wide_of_int),
              explicit_bounds: cfg.bounds,
              min: Some(least),
              max: Some(greatest),
            },
          ],
          Cumulative,
        ),
      },
  }
}

/// Two metrics of one name and kind as one, the second's points after the first's.
fn joined_data(a: Data, b: Data) -> Option<Data> =
  match ((a, b)) {
    (Gauge(xs), Gauge(ys)) -> Some(Gauge(concat(xs, ys))),
    (Sum(xs, t, rising), Sum(ys, _, also)) -> Some(Sum(concat(xs, ys), t, rising && also)),
    (Histogram(xs, t), Histogram(ys, _)) -> Some(Histogram(concat(xs, ys), t)),
    _ -> None,
  }

fn with_metric(metrics: List<Metric>, m: Metric) -> List<Metric> =
  match last(metrics) {
    Some(before) -> match ((before.name == m.name, joined_data(before.data, m.data))) {
      (true, Some(data)) -> push(take(metrics, len(metrics) - 1), { ..before, data: data }),
      _ -> push(metrics, m),
    },
    None -> [m],
  }

fn with_scoped(scopes: List<ScopeMetrics>, channel: String, m: Metric) -> List<ScopeMetrics> =
  match last(scopes) {
    Some(before) -> if before.scope.name == channel {
      push(take(scopes, len(scopes) - 1), { ..before, metrics: with_metric(before.metrics, m) })
    } else { push(scopes, { scope: scope(channel), metrics: [m], schema_url: "" }) },
    None -> [{ scope: scope(channel), metrics: [m], schema_url: "" }],
  }

/// Every series as a request: a scope for each channel, a metric for each name and kind.
fn metrics_request(cfg: Config, s: State, at: U64) -> Metrics / {abort.raise} =
  {
    resource_metrics: [
      {
        resource: cfg.resource,
        scope_metrics: fold(map_values(s.series), [], |scopes: List<ScopeMetrics>, held: Series|
          with_scoped(scopes, held.channel, metric_of_series(cfg, held, s.started, at))),
        schema_url: "",
      },
    ],
  }

/// Finished spans as a request: a scope for each channel, in the order the channels first
/// appear.
fn traces_request(cfg: Config, batch: List<Done>) -> Traces =
  {
    resource_spans: [
      {
        resource: cfg.resource,
        scope_spans: fold(batch, [], |scopes: List<ScopeSpans>, done: Done| -> List<ScopeSpans> {
          if any(scopes, |held: ScopeSpans| held.scope.name == done.channel) {
            map(scopes, |held: ScopeSpans|
              if held.scope.name == done.channel { { ..held, spans: push(held.spans, done.span) } }
              else { held })
          } else {
            push(scopes, { scope: scope(done.channel), spans: [done.span], schema_url: "" })
          }
        }),
        schema_url: "",
      },
    ],
  }

fn sealed(cfg: Config, body: Bytes) -> Bytes = if cfg.gzip { bytes_gzip(body) } else { body }

type Plan = { state: State, send: Option<Outbound>, wait_ms: Int }

/// What is due to be sent at `now_ms`: a request waiting to be sent again, once its wait has
/// passed; else a batch of spans, where enough wait or the oldest has waited long enough; else
/// the metrics, where one moved and their interval has passed. `force` is a flush: everything
/// that waits is due, and a request waiting on its backoff is sent after it.
fn planned(s: State, cfg: Config, now_ms: Int, at: U64, force: Bool) -> Plan / {abort.raise} =
  if s.busy { { state: s, send: None, wait_ms: 0 } } else {
    match s.pending {
      Some(waiting) -> if force || now_ms >= waiting.not_before {
        {
          state: { ..s, pending: None, busy: true },
          send: Some(waiting),
          wait_ms: max(waiting.not_before - now_ms, 0),
        }
      } else { { state: s, send: None, wait_ms: 0 } },
      None -> {
        let size = max(cfg.batch, 1);
        let waiting = len(s.queue);
        if waiting >= size || (waiting > 0 && (force || now_ms - s.queued_at >= cfg.max_age_ms)) {
          let batch = take(s.queue, size);
          {
            state: { ..s, queue: drop(s.queue, size), queued_at: now_ms, busy: true },
            send: Some({
              signal: TraceSignal,
              body: sealed(cfg, encode_traces(cfg.encoding, traces_request(cfg, batch))),
              items: len(batch),
              attempts: 0,
              not_before: now_ms,
            }),
            wait_ms: 0,
          }
        } else if s.dirty && (force || now_ms - s.metrics_at >= cfg.metrics_every_ms) {
          {
            state: { ..s, dirty: false, metrics_at: now_ms, busy: true },
            send: Some({
              signal: MetricSignal,
              body: sealed(cfg, encode_metrics(cfg.encoding, metrics_request(cfg, s, at))),
              items: 0,
              attempts: 0,
              not_before: now_ms,
            }),
            wait_ms: 0,
          }
        } else { { state: s, send: None, wait_ms: 0 } }
      },
    }
  }

/// How a request ended.
type Shipped =
  /// The collector took it, and says what of it it turned away.
  | Taken(Receipt)
  /// It failed in a way that may pass: no answer, or a 429, 502, 503 or 504, with the
  /// milliseconds its `Retry-After` asked for.
  | Later(Option<Int>)
  /// The collector refused it, and would refuse it again.
  | Spurned

/// How long to wait before attempt `attempt` (the first retry is 1): the backoff doubled for
/// each retry before it, no more than the longest, and somewhere in its upper half by `draw`
/// in a thousand; or what `Retry-After` asked for, where that is longer.
pub fn retry_wait(cfg: Config, attempt: Int, retry_after_ms: Option<Int>, draw: Int) -> Int = {
  let doubled = fold(
    range(1, min(max(attempt, 1), 32)),
    max(cfg.backoff_ms, 0),
    |wait: Int, _: Int| min(wait * 2, max(cfg.max_backoff_ms, 0)),
  );
  let capped = min(doubled, max(cfg.max_backoff_ms, 0));
  let jittered = capped / 2 + capped / 2 * min(max(draw, 0), 999) / 1000;
  match retry_after_ms { Some(asked) -> max(asked, jittered), None -> jittered }
}

fn settled(s: State, cfg: Config, out: Outbound, how: Shipped, now_ms: Int, draw: Int) -> State = {
  let free = { ..s, busy: false };
  let lost = |held: State| -> State {
    match out.signal {
      TraceSignal -> { ..held, stats: { ..held.stats, failed: held.stats.failed + out.items } },
      // The series still hold what the request said, so the next one says it again.
      MetricSignal -> { ..held, dirty: true },
    }
  };
  match how {
    Taken(receipt) ->
      {
        ..free,
        stats: {
          ..free.stats,
          requests: free.stats.requests + 1,
          exported: free.stats.exported + max(out.items - max(receipt.rejected, 0), 0),
          rejected: free.stats.rejected + min(max(receipt.rejected, 0), out.items),
        },
      },
    Spurned -> lost(free),
    Later(retry_after) -> if out.attempts + 1 >= max(cfg.attempts, 1) { lost(free) } else {
      {
        ..free,
        pending: Some({
          ..out,
          attempts: out.attempts + 1,
          not_before: now_ms + retry_wait(cfg, out.attempts + 1, retry_after, draw),
        }),
        stats: { ..free.stats, retries: free.stats.retries + 1 },
      }
    },
  }
}

/// The milliseconds a `Retry-After` of whole seconds asks for; a date is not read.
fn retry_after(headers: http::Headers) -> Option<Int> =
  match http::header(headers, "retry-after") {
    Some(text) -> match try[abort.raise] { int_of_ascii(bytes_of_string(ascii_trim(text))) } {
      Ok(Some(seconds)) -> if seconds > 86400 { Some(86400000) } else { Some(seconds * 1000) },
      _ -> None,
    },
    None -> None,
  }

fn judged(cfg: Config, signal: Signal, res: http::Response<| {}>) -> Shipped / {abort.raise} =
  if res.status >= 200 && res.status < 300 {
    Taken(
      match decode_receipt(cfg.encoding, signal, http::whole_bytes(res.body), default_limits()) {
        Ok(receipt) -> receipt,
        Err(_) -> { rejected: 0, message: "" },
      },
    )
  } else if res.status == 429 || res.status == 502 || res.status == 503 || res.status == 504 {
    Later(retry_after(res.headers))
  } else { Spurned }

/// The request `out` is, to the collector `cfg` names.
fn request_of(cfg: Config, out: Outbound) -> http::Request / {abort.raise} = {
  let path = cfg.prefix
    ++ (match out.signal { TraceSignal -> traces_path(), MetricSignal -> metrics_path() });
  let req = http::request_to(
    http::Post,
    cfg.host ++ ":" ++ int_to_string(cfg.port),
    path,
    out.body,
  );
  let typed = http::set_header(cfg.headers, "content-type", content_type(cfg.encoding));
  {
    ..req,
    headers: if cfg.gzip { http::set_header(typed, "content-encoding", "gzip") } else { typed },
  }
}

fn exchanged<[l]>(
  cfg: Config,
  out: Outbound,
) -> Result<http::Response<| {}>, http::ClientError> / {net.connect[l], net.connect_tls[l], net.send[l], net.recv[l], net.close[l], abort.raise} =
  if cfg.tls {
    match http::dial_tls[l](cfg.host, cfg.port, cfg.limits) {
      Err(e) -> Err(e),
      Ok(conn) ->
        bracket(|| conn, |c: http::Connection| http::close[l](c), |c: http::Connection|
          http::ask_last[l](c, request_of(cfg, out), cfg.limits)),
    }
  } else { http::request[l](cfg.host, cfg.port, request_of(cfg, out), cfg.limits) }

/// One request and how it ended. Nothing it does raises: a request that cannot be written, a
/// header among `cfg.headers` that `std.http` will not send, is one the collector refused.
fn shipped<[l]>(
  cfg: Config,
  out: Outbound,
) -> Shipped / {net.connect[l], net.connect_tls[l], net.send[l], net.recv[l], net.close[l]} =
  match try[abort.raise] {
      match exchanged[l](cfg, out) {
        Ok(res) -> judged(cfg, out.signal, res),
        Err(_) -> Later(None),
      }
    } {
    Ok(how) -> how,
    Err(_) -> Spurned,
  }

/// What an exporter performs beside `net` on its collector's label: the host's clocks, and its
/// entropy for ids and jitter.
pub effect set Exporting = {time.now_ms, time.elapsed_ms, time.elapsed_us, time.sleep_ms, entropy.next, entropy.below}

/// `body` with its spans, counters, gauges and timings sent to the collector `cfg` names, over
/// connections under the label the call gives: `exporting[collector](cfg, ..)` performs `net`
/// on `collector` and on nothing else, so telemetry goes where a run binds that label.
///
/// It answers every `trace.enter`, `trace.exit`, `trace.count`, `trace.gauge` and `trace.time`
/// `body` performs, on any channel, and `std.telemetry`'s `tracing`; `trace.event` passes to
/// whatever handles it outside. A span's channel is its instrumentation scope. A span opened
/// by `std.telemetry` says who its parent is; any other is a child of the span this handler
/// last saw opened and not yet closed, which is one stack for the whole program and not one a
/// task, so a program whose tasks open spans at once opens them with `in_span`.
///
/// An event never waits on the collector. A span that ends while `cfg.queue` spans wait is
/// dropped and counted. The task whose event makes a request due, by count or by age, makes
/// that one request itself, inside the deadlines of `cfg.limits`, and while it does every other
/// event is queued or counted. A request that fails in a way that may pass (no answer, or a
/// 429, 502, 503 or 504) is kept and sent again by a later event once its backoff has passed,
/// `cfg.attempts` times in all; nothing here raises on a collector's account. There is no
/// timer: age and backoff are read when the program next traces something. A `Retry-After` is
/// honoured as a number of seconds; a date is not read. `flush` sends all that waits, sleeping
/// out a backoff where it must, for `cfg.flush_ms` at most, and so does `exporting` itself
/// however `body` ends.
pub fn exporting<a, [l] | e>(
  cfg: Config,
  body: () -> a / {trace.enter[*], trace.exit[*], trace.count[*], trace.gauge[*], trace.time[*], Tracing, otlp.flush, otlp.stats | e},
) -> a / {net.connect[l], net.connect_tls[l], net.send[l], net.recv[l], net.close[l], Exporting, abort.raise | e} = {
  let wall_ms = time.now_ms();
  let mono_us = time.elapsed_us();
  with_cell[otlp_export](fresh(nanos_now(wall_ms, mono_us, mono_us), time.elapsed_ms())) { st -> {
    // `patience` is how long a flush may still wait; an event's own request waits for nothing.
    let pump = |force: Bool, patience: Int| {
      let before = cell_get(st);
      let plan = planned(
        before,
        cfg,
        time.elapsed_ms(),
        nanos_now(wall_ms, mono_us, time.elapsed_us()),
        force,
      );
      match plan.send {
        None -> false,
        Some(out) -> if plan.wait_ms > patience { false } else {
          cell_set(st, plan.state);
          if plan.wait_ms > 0 { time.sleep_ms(plan.wait_ms) } else { () };
          let how = shipped[l](cfg, out);
          let draw = entropy.below(1000);
          cell_set(st, settled(cell_get(st), cfg, out, how, time.elapsed_ms(), draw));
          true
        },
      }
    };
    let flushed = || {
      let held = cell_get(st);
      let began = time.elapsed_ms();
      let rounds = (len(held.queue) / max(cfg.batch, 1) + 3) * (max(cfg.attempts, 1) + 1);
      fold(range(0, rounds), true, |more: Bool, _: Int| {
        let left = cfg.flush_ms - (time.elapsed_ms() - began);
        if more && left > 0 { pump(true, left) } else { false }
      });
      stats_of(cell_get(st))
    };
    bracket(
      || (),
      |_: Unit| {
        flushed();
        ()
      },
      |_: Unit|
        handle {
          body()
        } with {
          trace.enter[*c](name, fields) -> {
            let held = cell_get(st);
            let who = match telemetry::identity(fields) {
              Some(named) -> named,
              None -> {
                let above = match held.open { [inner, ..] -> Some(inner.who.context), [] -> None };
                let made: telemetry::Identity = {
                  context: telemetry::begin(above, cfg.sampler),
                  parent: match above { Some(up) -> Some(up.parent.parent_id), None -> None },
                  kind: telemetry::Internal,
                };
                made
              },
            };
            cell_set(
              st,
              opened(
                held,
                c,
                name,
                who,
                telemetry::attributes(fields),
                nanos_now(wall_ms, mono_us, time.elapsed_us()),
              ),
            );
            { id: held.next, channel: c }
          },
          trace.exit[*c](span, outcome) -> {
            cell_set(
              st,
              closed(
                cell_get(st),
                cfg,
                span,
                outcome,
                nanos_now(wall_ms, mono_us, time.elapsed_us()),
                time.elapsed_ms(),
              ),
            );
            pump(false, 0);
            ()
          },
          trace.count[*c](name, delta, fields) -> {
            cell_set(
              st,
              tallied(cell_get(st), cfg, c, "sum", name, fields, |held: Option<Tallied>|
                counted(held, delta)),
            );
            pump(false, 0);
            ()
          },
          trace.gauge[*c](name, value, fields) -> {
            cell_set(
              st,
              tallied(cell_get(st), cfg, c, "gauge", name, fields, |_: Option<Tallied>|
                Level(float_of_decimal(value))),
            );
            pump(false, 0);
            ()
          },
          trace.time[*c](name, micros, fields) -> {
            cell_set(
              st,
              tallied(cell_get(st), cfg, c, "histogram", name, fields, |held: Option<Tallied>|
                timed(held, cfg.bounds, float_of_int(micros) / 1000000.0)),
            );
            pump(false, 0);
            ()
          },
          tracing.current() -> None,
          tracing.sampler() -> cfg.sampler,
          tracing.annotate(span, fields) -> cell_set(st, annotated(cell_get(st), span, fields)),
          otlp.flush() -> flushed(),
          otlp.stats() -> stats_of(cell_get(st)),
        },
    )
  } }
}

/// Sends everything the exporter around the caller holds, waiting out a backoff where a
/// request has one, and answers what the exporter has done: what a program calls when it
/// drains.
pub fn flush() -> Stats / {otlp.flush} = otlp.flush()

/// What the exporter around the caller has done so far.
pub fn stats() -> Stats / {otlp.stats} = otlp.stats()

// --- Tests: the codecs --------------------------------------------------------

fn trace_of(hex: String) -> TraceId / {abort.raise} =
  match traceparent::trace_id_of_hex(hex) { Some(id) -> id, None -> panic("a trace id") }

fn span_named(hex: String) -> SpanId / {abort.raise} =
  match traceparent::span_id_of_hex(hex) { Some(id) -> id, None -> panic("a span id") }

fn sample_span() -> Span / {abort.raise} =
  {
    trace_id: trace_of("5b8efff798038103d269b633813fc60c"),
    span_id: span_named("eee19b7ec3c1b174"),
    trace_state: "rojo=1",
    parent: Some(span_named("eee19b7ec3c1b173")),
    flags: 1u32,
    name: "GET",
    kind: Server,
    start: 1544712660000000000u64,
    end: 1544712661000000000u64,
    attributes: [
      attribute("http.response.status_code", IntValue(200)),
      attribute("ratio", DoubleValue(0.5)),
      attribute("raw", BytesValue(b"\x00\xff")),
      attribute("ok", BoolValue(true)),
      attribute("tags", ArrayValue([StringValue("a"), NoValue])),
      attribute("peer", KvlistValue([attribute("port", IntValue(-1))])),
    ],
    dropped_attributes: 2u32,
    events: [
      {
        time: 1544712660500000000u64,
        name: "retry",
        attributes: [attribute("attempt", IntValue(2))],
        dropped_attributes: 0u32,
      },
    ],
    dropped_events: 0u32,
    links: [
      {
        trace_id: trace_of("0af7651916cd43dd8448eb211c80319c"),
        span_id: span_named("b7ad6b7169203331"),
        trace_state: "",
        attributes: [],
        dropped_attributes: 0u32,
        flags: 0u32,
      },
    ],
    dropped_links: 0u32,
    status: { code: StatusError, message: "boom" },
  }

fn sample_traces() -> Traces / {abort.raise} =
  {
    resource_spans: [
      {
        resource: {
          attributes: [attribute("service.name", StringValue("shop"))],
          dropped_attributes: 0u32,
        },
        scope_spans: [
          {
            scope: { name: "http", version: "1.0", attributes: [], dropped_attributes: 0u32 },
            spans: [sample_span()],
            schema_url: "",
          },
        ],
        schema_url: "https://opentelemetry.io/schemas/1.37.0",
      },
    ],
  }

fn sample_traces_json() -> String =
  \\{"resourceSpans":[{"resource":{"attributes":[{"key":"service.name","value":{"stringValue":"shop"}}]},
  \\"scopeSpans":[{"scope":{"name":"http","version":"1.0"},"spans":[{
  \\"traceId":"5b8efff798038103d269b633813fc60c","spanId":"eee19b7ec3c1b174","traceState":"rojo=1",
  \\"parentSpanId":"eee19b7ec3c1b173","flags":1,"name":"GET","kind":2,
  \\"startTimeUnixNano":"1544712660000000000","endTimeUnixNano":"1544712661000000000",
  \\"attributes":[{"key":"http.response.status_code","value":{"intValue":"200"}},
  \\{"key":"ratio","value":{"doubleValue":0.5}},{"key":"raw","value":{"bytesValue":"AP8="}},
  \\{"key":"ok","value":{"boolValue":true}},
  \\{"key":"tags","value":{"arrayValue":{"values":[{"stringValue":"a"},{}]}}},
  \\{"key":"peer","value":{"kvlistValue":{"values":[{"key":"port","value":{"intValue":"-1"}}]}}}],
  \\"droppedAttributesCount":2,
  \\"events":[{"timeUnixNano":"1544712660500000000","name":"retry",
  \\"attributes":[{"key":"attempt","value":{"intValue":"2"}}]}],
  \\"links":[{"traceId":"0af7651916cd43dd8448eb211c80319c","spanId":"b7ad6b7169203331"}],
  \\"status":{"message":"boom","code":2}}]}],
  \\"schemaUrl":"https://opentelemetry.io/schemas/1.37.0"}]}

fn sample_metrics() -> Metrics =
  {
    resource_metrics: [
      {
        resource: {
          attributes: [attribute("service.name", StringValue("shop"))],
          dropped_attributes: 0u32,
        },
        scope_metrics: [
          {
            scope: scope("orders"),
            metrics: [
              {
                name: "orders.placed",
                description: "orders taken",
                unit: "{order}",
                data: Sum(
                  [
                    {
                      attributes: [attribute("sku", StringValue("BOLT-1"))],
                      start: 1544712660000000000u64,
                      time: 1544712661000000000u64,
                      value: AsInt(7),
                    },
                  ],
                  Cumulative,
                  true,
                ),
              },
              {
                name: "shelf.level",
                description: "",
                unit: "",
                data: Gauge([
                  {
                    attributes: [],
                    start: 0u64,
                    time: 1544712661000000000u64,
                    value: AsDouble(41.75),
                  },
                ]),
              },
              {
                name: "request.duration",
                description: "",
                unit: "s",
                data: Histogram(
                  [
                    {
                      attributes: [],
                      start: 1544712660000000000u64,
                      time: 1544712661000000000u64,
                      count: 3u64,
                      sum: Some(0.75),
                      bucket_counts: [1u64, 2u64, 0u64],
                      explicit_bounds: [0.1, 1.0],
                      min: Some(0.05),
                      max: Some(0.5),
                    },
                  ],
                  Delta,
                ),
              },
            ],
            schema_url: "",
          },
        ],
        schema_url: "",
      },
    ],
  }

fn sample_metrics_json() -> String =
  \\{"resourceMetrics":[{"resource":{"attributes":[{"key":"service.name","value":{"stringValue":"shop"}}]},
  \\"scopeMetrics":[{"scope":{"name":"orders"},"metrics":[
  \\{"name":"orders.placed","description":"orders taken","unit":"{order}","sum":{"dataPoints":[
  \\{"attributes":[{"key":"sku","value":{"stringValue":"BOLT-1"}}],
  \\"startTimeUnixNano":"1544712660000000000","timeUnixNano":"1544712661000000000","asInt":"7"}],
  \\"aggregationTemporality":2,"isMonotonic":true}},
  \\{"name":"shelf.level","gauge":{"dataPoints":[{"timeUnixNano":"1544712661000000000","asDouble":41.75}]}},
  \\{"name":"request.duration","unit":"s","histogram":{"dataPoints":[
  \\{"startTimeUnixNano":"1544712660000000000","timeUnixNano":"1544712661000000000","count":"3",
  \\"sum":0.75,"bucketCounts":["1","2","0"],"explicitBounds":[0.1,1],"min":0.05,"max":0.5}],
  \\"aggregationTemporality":1}}]}]}]}

fn joined(text: String) -> Bytes / {abort.raise} =
  bytes_concat_all(bytes_split(bytes_of_string(text), b"\n"))

test "traces are written as OTLP's JSON mapping says: hex ids, 64-bit numbers as strings, enums as numbers" {
  assert_eq(
    json::parse(encode_traces(Json, sample_traces())),
    json::parse(joined(sample_traces_json())),
  );
  assert_eq(
    decode_traces(Json, joined(sample_traces_json()), default_limits()),
    Ok(sample_traces()),
  )
}

test "metrics are written as OTLP's JSON mapping says" {
  assert_eq(
    json::parse(encode_metrics(Json, sample_metrics())),
    json::parse(joined(sample_metrics_json())),
  );
  assert_eq(
    decode_metrics(Json, joined(sample_metrics_json()), default_limits()),
    Ok(sample_metrics()),
  )
}

test "a request reads back from its protobuf, and the two encodings read as one model" {
  let wire = encode_traces(Protobuf, sample_traces());
  assert_eq(decode_traces(Protobuf, wire, default_limits()), Ok(sample_traces()));
  let metrics = encode_metrics(Protobuf, sample_metrics());
  assert_eq(decode_metrics(Protobuf, metrics, default_limits()), Ok(sample_metrics()));
  assert_eq(
    decode_metrics(Json, encode_metrics(Json, sample_metrics()), default_limits()),
    decode_metrics(Protobuf, metrics, default_limits()),
  )
}

law "traces read back from their protobuf"
  forall (t: Traces) {
    decode_traces(Protobuf, encode_traces(Protobuf, t), default_limits()) == Ok(t)
  }

law "traces read back from their JSON"
  forall (t: Traces) {
    decode_traces(Json, encode_traces(Json, t), default_limits()) == Ok(t)
  }

law "metrics read back from their protobuf"
  forall (m: Metrics) {
    decode_metrics(Protobuf, encode_metrics(Protobuf, m), default_limits()) == Ok(m)
  }

law "metrics read back from their JSON"
  forall (m: Metrics) {
    decode_metrics(Json, encode_metrics(Json, m), default_limits()) == Ok(m)
  }

law "the JSON and the protobuf of one request read as one model"
  forall (t: Traces, m: Metrics) {
    decode_traces(Json, encode_traces(Json, t), default_limits())
      == decode_traces(Protobuf, encode_traces(Protobuf, t), default_limits())
      && decode_metrics(Json, encode_metrics(Json, m), default_limits())
      == decode_metrics(Protobuf, encode_metrics(Protobuf, m), default_limits())
  }

law "a receipt reads back from either encoding"
  forall (rejected: Int, message: String) {
    let receipt: Receipt = { rejected: rejected, message: message };
    decode_receipt(
        Protobuf,
        TraceSignal,
        encode_receipt(Protobuf, TraceSignal, receipt),
        default_limits(),
      )
      == Ok(receipt)
      && decode_receipt(
        Json,
        MetricSignal,
        encode_receipt(Json, MetricSignal, receipt),
        default_limits(),
      )
      == Ok(receipt)
  }

test "a double JSON has no number for is written as a string a reader takes" {
  let doubles = [nan(), infinity(), neg_infinity(), 1e300, 5e-324, 0.1];
  let written = map(doubles, |f: Float| json::to_string(double_json(f)));
  assert_eq(written, [
    "\"NaN\"",
    "\"Infinity\"",
    "\"-Infinity\"",
    "\"1e300\"",
    "\"5e-324\"",
    "0.1",
  ]);
  let back = try { map(doubles, |f: Float| double_of_json(double_json(f), "asDouble")) };
  match back {
    Ok([first, ..rest]) -> {
      assert(first != first);
      assert_eq(rest, [infinity(), neg_infinity(), 1e300, 5e-324, 0.1])
    },
    _ -> panic("refused"),
  }
}

type Refused = { name: String, encoding: Encoding, body: Bytes, why: Why, field: String }

fn span_json_with(members: String) -> Bytes =
  bytes_of_string("{\"resourceSpans\":[{\"scopeSpans\":[{\"spans\":[{" ++ members ++ "}]}]}]}")

fn good_ids() -> String =
  "\"traceId\":\"5b8efff798038103d269b633813fc60c\",\"spanId\":\"eee19b7ec3c1b174\""

fn metric_json_with(members: String) -> Bytes =
  bytes_of_string(
    "{\"resourceMetrics\":[{\"scopeMetrics\":[{\"metrics\":[{\"name\":\"m\"" ++ members
      ++ "}]}]}]}",
  )

fn refused_traces() -> List<Refused> / {abort.raise} =
  [
    {
      name: "text that is not JSON",
      encoding: Json,
      body: b"{\"resourceSpans\":",
      why: NotJson("the input ended where a value was expected"),
      field: "",
    },
    {
      name: "an id in base64",
      encoding: Json,
      body: span_json_with(
        "\"traceId\":\"W47/95gDgQPSabYzgT/GDA==\",\"spanId\":\"eee19b7ec3c1b174\"",
      ),
      why: BadText,
      field: "traceId",
    },
    {
      name: "a trace id of eight bytes",
      encoding: Json,
      body: span_json_with("\"traceId\":\"eee19b7ec3c1b174\",\"spanId\":\"eee19b7ec3c1b174\""),
      why: BadId,
      field: "traceId",
    },
    {
      name: "a span with no span id",
      encoding: Json,
      body: span_json_with("\"traceId\":\"5b8efff798038103d269b633813fc60c\""),
      why: BadId,
      field: "spanId",
    },
    {
      name: "an enum by its name",
      encoding: Json,
      body: span_json_with(good_ids() ++ ",\"kind\":\"SPAN_KIND_SERVER\""),
      why: WrongKind("an enum's number"),
      field: "kind",
    },
    {
      name: "an enum that names nothing",
      encoding: Json,
      body: span_json_with(good_ids() ++ ",\"kind\":9"),
      why: BadEnum(9),
      field: "kind",
    },
    {
      name: "a time that is not whole",
      encoding: Json,
      body: span_json_with(good_ids() ++ ",\"startTimeUnixNano\":\"1.5\""),
      why: BadNumber,
      field: "startTimeUnixNano",
    },
    {
      name: "a time past 64 bits",
      encoding: Json,
      body: span_json_with(good_ids() ++ ",\"startTimeUnixNano\":\"18446744073709551616\""),
      why: BadNumber,
      field: "startTimeUnixNano",
    },
    {
      name: "a name that is a number",
      encoding: Json,
      body: span_json_with(good_ids() ++ ",\"name\":7"),
      why: WrongKind("a string"),
      field: "name",
    },
    {
      name: "spans that are no array",
      encoding: Json,
      body: b"{\"resourceSpans\":{}}",
      why: WrongKind("an array"),
      field: "resourceSpans",
    },
    {
      name: "bytes that are no message",
      encoding: Protobuf,
      body: b"\x0b",
      why: NotProtobuf(protobuf::Group),
      field: "",
    },
    {
      name: "a trace id of the wrong length, in protobuf",
      encoding: Protobuf,
      body: protobuf::message_field(
        1,
        protobuf::message_field(
          2,
          protobuf::message_field(2, protobuf::bytes_field(1, b"\x01\x02")),
        ),
      ),
      why: BadId,
      field: "traceId",
    },
  ]

test "traces are refused: {c.name}" for c: Refused in refused_traces() {
  match decode_traces(c.encoding, c.body, default_limits()) {
    Ok(_) -> panic("accepted"),
    Err(refusal) -> {
      assert_eq(refusal.why, c.why);
      assert_eq(refusal.field, c.field)
    },
  }
}

fn refused_metrics() -> List<Refused> / {abort.raise} =
  [
    {
      name: "a metric with no data",
      encoding: Json,
      body: metric_json_with(""),
      why: Missing("data"),
      field: "data",
    },
    {
      name: "an exponential histogram",
      encoding: Json,
      body: metric_json_with(",\"exponentialHistogram\":{}"),
      why: Unsupported("exponential_histogram"),
      field: "exponentialHistogram",
    },
    {
      name: "a summary",
      encoding: Json,
      body: metric_json_with(",\"summary\":{}"),
      why: Unsupported("summary"),
      field: "summary",
    },
    {
      name: "a sum that does not say how it adds up",
      encoding: Json,
      body: metric_json_with(",\"sum\":{\"dataPoints\":[]}"),
      why: Missing("aggregationTemporality"),
      field: "aggregationTemporality",
    },
    {
      name: "a point with no value",
      encoding: Json,
      body: metric_json_with(",\"gauge\":{\"dataPoints\":[{}]}"),
      why: Missing("value"),
      field: "asDouble",
    },
    {
      name: "a summary, in protobuf",
      encoding: Protobuf,
      body: protobuf::message_field(
        1,
        protobuf::message_field(2, protobuf::message_field(2, protobuf::message_field(11, b""))),
      ),
      why: Unsupported("summary"),
      field: "summary",
    },
    {
      name: "a metric with no data, in protobuf",
      encoding: Protobuf,
      body: protobuf::message_field(
        1,
        protobuf::message_field(2, protobuf::message_field(2, protobuf::string_field(1, "m"))),
      ),
      why: Missing("data"),
      field: "data",
    },
  ]

test "metrics are refused: {c.name}" for c: Refused in refused_metrics() {
  match decode_metrics(c.encoding, c.body, default_limits()) {
    Ok(_) -> panic("accepted"),
    Err(refusal) -> {
      assert_eq(refusal.why, c.why);
      assert_eq(refusal.field, c.field)
    },
  }
}

test "a field a reader does not know is passed over, in either encoding" {
  let known = span_json_with(good_ids() ++ ",\"name\":\"GET\"");
  let more = span_json_with(
    good_ids() ++ ",\"name\":\"GET\",\"later\":{\"a\":[1,2]},\"trace_id\":\"x\"",
  );
  assert_eq(
    decode_traces(Json, more, default_limits()),
    decode_traces(Json, known, default_limits()),
  );
  let wire = encode_traces(Protobuf, sample_traces());
  let extended = bytes_concat(wire, protobuf::string_field(900, "from a later version"));
  assert_eq(decode_traces(Protobuf, extended, default_limits()), Ok(sample_traces()));
  // A 64-bit number may be written as a JSON number, and an id in upper case.
  let loose = span_json_with(
    "\"traceId\":\"5B8EFFF798038103D269B633813FC60C\",\"spanId\":\"EEE19B7EC3C1B174\",\"startTimeUnixNano\":12,\"parentSpanId\":\"\"",
  );
  match decode_traces(Json, loose, default_limits()) {
    Ok({ resource_spans: [{ scope_spans: [{ spans: [span], .. }], .. }] }) -> {
      assert_eq(span.start, 12u64);
      assert_eq(span.parent, None);
      assert_eq(traceparent::span_id_hex(span.span_id), "eee19b7ec3c1b174")
    },
    _ -> panic("refused"),
  }
}

test "a request past its limits is refused" {
  let tight: Limits = { length: 16, depth: 64 };
  match decode_traces(Json, encode_traces(Json, sample_traces()), tight) {
    Err(refusal) -> assert_eq(refusal.why, TooLong),
    Ok(_) -> panic("accepted"),
  };
  match decode_traces(Protobuf, encode_traces(Protobuf, sample_traces()), tight) {
    Err(refusal) -> assert_eq(refusal.why, NotProtobuf(protobuf::TooLong)),
    Ok(_) -> panic("accepted"),
  };
  let shallow: Limits = { length: 4194304, depth: 5 };
  match decode_traces(Protobuf, encode_traces(Protobuf, sample_traces()), shallow) {
    Err(refusal) -> assert_eq(refusal.why, NotProtobuf(protobuf::TooDeep)),
    Ok(_) -> panic("accepted"),
  };
  match decode_traces(Json, encode_traces(Json, sample_traces()), { length: 4194304, depth: 1 }) {
    Err(refusal) -> assert_eq(refusal.why, TooDeep),
    Ok(_) -> panic("accepted"),
  }
}

test "an empty receipt is the empty message, and a partial one says what was turned away" {
  let none: Receipt = { rejected: 0, message: "" };
  assert_eq(encode_receipt(Protobuf, TraceSignal, none), b"");
  assert_eq(encode_receipt(Json, TraceSignal, none), b"{}");
  let some: Receipt = { rejected: 3, message: "too old" };
  assert_eq(
    string_of_bytes(encode_receipt(Json, TraceSignal, some)),
    "{\"partialSuccess\":{\"errorMessage\":\"too old\",\"rejectedSpans\":\"3\"}}",
  );
  assert_eq(
    string_of_bytes(encode_receipt(Json, MetricSignal, some)),
    "{\"partialSuccess\":{\"errorMessage\":\"too old\",\"rejectedDataPoints\":\"3\"}}",
  )
}

// --- Tests: the exporter ---------------------------------------------------------

/// What a test's collector does with a request.
type Reply =
  /// Refuses the connection.
  | Down
  | Take
  /// Takes it and says it turned this many away.
  | Partial(Int)
  /// Answers this status, with this many seconds of `Retry-After`.
  | Busy(Int, Option<Int>)
  | Bad

/// What the collector saw.
type Collector = {
  script: List<Reply>,
  traces: List<Traces>,
  metrics: List<Metrics>,
  /// When each request arrived, in milliseconds on the virtual clock.
  arrivals: List<Int>,
  types: List<String>,
  gzipped: Int,
  conns: Map<Int, Conn>,
  next: Int,
}

/// One connection: what its client wrote, and what is left of the answer.
type Conn = { written: Bytes, answer: Bytes, served: Bool }

effect collector {
  write next(content_type: String, gzipped: Bool) -> Reply
  write took_traces(t: Traces) -> Unit
  write took_metrics(m: Metrics) -> Unit
}

fn receipt_response<| r>(
  e: Encoding,
  signal: Signal,
  rejected: Int,
) -> http::Response<| r> / {abort.raise} = {
  let receipt: Receipt = {
    rejected: rejected,
    message: if rejected == 0 { "" } else { "turned away" },
  };
  {
    status: 200,
    headers: http::set_header(http::empty_headers(), "content-type", content_type(e)),
    body: http::Whole(encode_receipt(e, signal, receipt)),
  }
}

fn took<| r>(
  e: Encoding,
  path: String,
  raw: Bytes,
  rejected: Int,
) -> http::Response<| r> / {collector.took_traces, collector.took_metrics, abort.raise} =
  if path == traces_path() {
    match decode_traces(e, raw, default_limits()) {
      Ok(t) -> {
        collector.took_traces(t);
        receipt_response(e, TraceSignal, rejected)
      },
      Err(_) -> http::text_response(400, "not traces"),
    }
  } else if path == metrics_path() {
    match decode_metrics(e, raw, default_limits()) {
      Ok(m) -> {
        collector.took_metrics(m);
        receipt_response(e, MetricSignal, rejected)
      },
      Err(_) -> http::text_response(400, "not metrics"),
    }
  } else { http::text_response(404, "no such signal") }

/// An OTLP receiver over `std.http`: both paths, both encodings, gzipped or not.
fn receive<| r>(
  req: http::Request,
) -> http::Response<| r> / {collector.next, collector.took_traces, collector.took_metrics, http::Reading} = {
  let kind = match http::header(req.headers, "content-type") { Some(k) -> k, None -> "" };
  let packed = http::header(req.headers, "content-encoding") == Some("gzip");
  let sent = http::request_body(req, 4194304);
  let raw = if packed { gzip::try_gunzip(sent, 4194304) } else { Ok(sent) };
  let encoding = if kind == content_type(Json) { Some(Json) }
  else if kind == content_type(Protobuf) { Some(Protobuf) }
  else { None };
  match ((req.method, encoding, raw)) {
    (http::Post, Some(e), Ok(body)) -> match collector.next(kind, packed) {
      Take | Down -> took(e, req.path, body, 0),
      Partial(n) -> took(e, req.path, body, n),
      Busy(status, after) -> {
        let res = http::text_response(status, "later");
        match after {
          Some(seconds) ->
            {
              ..res,
              headers: http::set_header(res.headers, "retry-after", int_to_string(seconds)),
            },
          None -> res,
        }
      },
      Bad -> http::text_response(400, "no"),
    },
    (http::Post, None, _) -> http::text_response(415, "neither JSON nor protobuf"),
    (http::Post, _, Err(_)) -> http::text_response(400, "not gzip"),
    _ -> http::method_not_allowed([http::Post]),
  }
}

/// What `receive` under `std.http`'s serve loop writes back for the bytes one connection's client
/// wrote.
fn answered(
  written: Bytes,
) -> Bytes / {collector.next, collector.took_traces, collector.took_metrics, abort.raise} = {
  let client = ip::socket_at(ip::loopback_v4(), 49152);
  let ran = net::on_mem(net::mem_calling(net::mem_empty(), client, [Says(written)]), || {
    let conn = net.accept[listener](net.listen[listener](0));
    http::serve_connection[inner](conn, http::default_limits(), receive);
    conn
  });
  net::mem_sent(ran.net, ran.value)
}

type Ran<a> = { value: a, seen: Collector }

fn collector_host() -> String = "collector.test"

/// `body` with the label `collector` bound to a collector at `collector.test:4318` that runs in
/// place: a connection's request is served by `receive` when its client first reads, and a
/// connection anywhere else is refused.
fn collected<a | e>(
  script: List<Reply>,
  body: () -> a / {net.connect[collector], net.connect_tls[collector], net.send[collector], net.recv[collector], net.close[collector] | e},
) -> Ran<a> / {clock.now, abort.raise | e} = {
  let start: Collector = {
    script: script,
    traces: [],
    metrics: [],
    arrivals: [],
    types: [],
    gzipped: 0,
    conns: map_new(),
    next: 1,
  };
  with_cell[collector](start) { w -> {
    let value = handle {
      handle {
        body()
      } with {
        net.connect[collector](host, port, t) -> {
          let held: Collector = cell_get(w);
          match held.script {
            [Down, ..rest] -> {
              cell_set(w, { ..held, script: rest });
              None
            },
            _ -> if host != collector_host() || port != 4318 { None } else {
              let conn: Conn = { written: b"", answer: b"", served: false };
              cell_set(w, {
                ..held,
                next: held.next + 1,
                conns: map_insert(held.conns, held.next, conn),
              });
              Some(held.next)
            },
          }
        },
        net.connect_tls[collector](host, port, t) -> None,
        net.send[collector](conn, payload, t) -> {
          let held: Collector = cell_get(w);
          match map_get(held.conns, conn) {
            Some(c) -> {
              cell_set(w, {
                ..held,
                conns: map_insert(held.conns, conn, {
                  ..c,
                  written: bytes_concat(c.written, payload),
                }),
              });
              Some(bytes_len(payload))
            },
            None -> None,
          }
        },
        net.recv[collector](conn, most, t) -> {
          let before: Collector = cell_get(w);
          match map_get(before.conns, conn) {
            None -> Some(b""),
            Some(c) -> {
              let ready = if c.served { c } else {
                let out: Conn = { written: c.written, answer: answered(c.written), served: true };
                out
              };
              let n = min(most, bytes_len(ready.answer));
              let held: Collector = cell_get(w);
              cell_set(w, {
                ..held,
                conns: map_insert(held.conns, conn, {
                  ..ready,
                  answer: bytes_slice(ready.answer, n, bytes_len(ready.answer)),
                }),
              });
              Some(bytes_slice(ready.answer, 0, n))
            },
          }
        },
        net.close[collector](conn) -> {
          let held: Collector = cell_get(w);
          cell_set(w, { ..held, conns: map_remove(held.conns, conn) })
        },
      }
    } with {
      collector.next(kind, packed) -> {
        let held: Collector = cell_get(w);
        let noted = {
          ..held,
          arrivals: push(held.arrivals, match clock.now() { Instant(n) -> n / 1000000 }),
          types: push(held.types, kind),
          gzipped: held.gzipped + (if packed { 1 } else { 0 }),
        };
        match held.script {
          [first, ..rest] -> {
            cell_set(w, { ..noted, script: rest });
            first
          },
          [] -> {
            cell_set(w, noted);
            Take
          },
        }
      },
      collector.took_traces(t) -> {
        let held: Collector = cell_get(w);
        cell_set(w, { ..held, traces: push(held.traces, t) })
      },
      collector.took_metrics(m) -> {
        let held: Collector = cell_get(w);
        cell_set(w, { ..held, metrics: push(held.metrics, m) })
      },
    };
    { value: value, seen: cell_get(w) }
  } }
}

/// The wall clock when a test starts: 2023-11-14T22:13:20Z.
fn epoch_ms() -> Int = 1700000000000

/// `body` with the host's clocks answered from the simulation's, so a wait costs no wall clock.
fn on_clock<a | e>(
  body: () -> a / {time.now_ms, time.elapsed_ms, time.elapsed_us, time.sleep_ms | e},
) -> a / {clock.now, clock.sleep | e} =
  handle {
    body()
  } with {
    time.now_ms() -> epoch_ms() + (match clock.now() { Instant(n) -> n / 1000000 }),
    time.elapsed_ms() -> match clock.now() { Instant(n) -> n / 1000000 },
    time.elapsed_us() -> match clock.now() { Instant(n) -> n / 1000 },
    time.sleep_ms(ms) -> clock.sleep(Duration(ms * 1000000)),
  }

fn test_config() -> Config = {
  let base: Config = config("shop", collector_host(), 4318);
  { ..base, backoff_ms: 100, max_backoff_ms: 1000 }
}

/// A span opened through `std.telemetry`, a bare one inside it, an annotation, and one of each
/// metric.
fn checkout() -> Unit / {trace.enter[shop], trace.exit[shop], trace.count[shop], trace.gauge[shop], trace.time[shop], Tracing, entropy.next, time.sleep_ms, abort.raise} =
  telemetry::in_span[shop]("checkout", telemetry::Server, #{"sku": trace::FText("BOLT-1")}, || {
    time.sleep_ms(5);
    let inner = trace.enter[shop]("reserve", #{"qty": trace::FInt(2)});
    time.sleep_ms(2);
    trace.exit[shop](inner, trace::Failed("out of stock"));
    telemetry::annotate(#{"http.response.status_code": trace::FInt(409)});
    trace.count[shop]("orders placed", 1, #{"sku": trace::FText("BOLT-1")});
    trace.gauge[shop]("shelf", 41.75m, map_new());
    trace.time[shop]("checkout", 7000, map_new())
  })

/// `exporting` to the label `collector`: the row names no other.
fn shipping(
  cfg: Config,
) -> Stats / {net.connect[collector], net.connect_tls[collector], net.send[collector], net.recv[collector], net.close[collector], Exporting, abort.raise} =
  exporting[collector](cfg, || {
    checkout();
    flush()
  })

fn nanos_at(ms: Int) -> U64 / {abort.raise} = u64_of_int((epoch_ms() + ms) * 1000000)

/// What `checkout` traces, with the ids a stream seeded with `seed` draws.
fn expected_traces(cfg: Config, seed: Int) -> Traces / {abort.raise} = {
  let trace_drawn = traceparent::rand_trace_id(rand(seed));
  let root = traceparent::rand_span_id(trace_drawn.rand);
  let child = traceparent::rand_span_id(root.rand);
  let reserve: Span = {
    trace_id: trace_drawn.value,
    span_id: child.value,
    trace_state: "",
    parent: Some(root.value),
    flags: 3u32,
    name: "reserve",
    kind: Internal,
    start: nanos_at(5),
    end: nanos_at(7),
    attributes: [attribute("qty", IntValue(2))],
    dropped_attributes: 0u32,
    events: [],
    dropped_events: 0u32,
    links: [],
    dropped_links: 0u32,
    status: { code: StatusError, message: "out of stock" },
  };
  let whole: Span = {
    ..reserve,
    span_id: root.value,
    parent: None,
    name: "checkout",
    kind: Server,
    start: nanos_at(0),
    attributes: [
      attribute("http.response.status_code", IntValue(409)),
      attribute("sku", StringValue("BOLT-1")),
    ],
    status: unset(),
  };
  {
    resource_spans: [
      {
        resource: cfg.resource,
        scope_spans: [{ scope: scope("shop"), spans: [reserve, whole], schema_url: "" }],
        schema_url: "",
      },
    ],
  }
}

fn expected_metrics(cfg: Config) -> Metrics / {abort.raise} = {
  let seconds = float_of_int(7000) / 1000000.0;
  {
    resource_metrics: [
      {
        resource: cfg.resource,
        scope_metrics: [
          {
            scope: scope("shop"),
            metrics: [
              {
                name: "shelf",
                description: "",
                unit: "",
                data: Gauge([
                  { attributes: [], start: 0u64, time: nanos_at(7), value: AsDouble(41.75) },
                ]),
              },
              {
                name: "checkout",
                description: "",
                unit: "s",
                data: Histogram(
                  [
                    {
                      attributes: [],
                      start: nanos_at(0),
                      time: nanos_at(7),
                      count: 1u64,
                      sum: Some(seconds),
                      bucket_counts: [
                        0u64,
                        1u64,
                        0u64,
                        0u64,
                        0u64,
                        0u64,
                        0u64,
                        0u64,
                        0u64,
                        0u64,
                        0u64,
                        0u64,
                        0u64,
                        0u64,
                        0u64,
                      ],
                      explicit_bounds: telemetry::duration_bounds(),
                      min: Some(seconds),
                      max: Some(seconds),
                    },
                  ],
                  Cumulative,
                ),
              },
              {
                name: "orders placed",
                description: "",
                unit: "",
                data: Sum(
                  [
                    {
                      attributes: [attribute("sku", StringValue("BOLT-1"))],
                      start: nanos_at(0),
                      time: nanos_at(7),
                      value: AsInt(1),
                    },
                  ],
                  Cumulative,
                  true,
                ),
              },
            ],
            schema_url: "",
          },
        ],
        schema_url: "",
      },
    ],
  }
}

type Shipment = { name: String, encoding: Encoding, gzip: Bool }

fn shipments() -> List<Shipment> =
  [
    { name: "protobuf", encoding: Protobuf, gzip: false },
    { name: "JSON", encoding: Json, gzip: false },
    { name: "gzipped protobuf", encoding: Protobuf, gzip: true },
    { name: "gzipped JSON", encoding: Json, gzip: true },
  ]

test "a collector decodes what was traced, sent as {c.name}" for c: Shipment in shipments() {
  let base: Config = test_config();
  let cfg: Config = { ..base, encoding: c.encoding, gzip: c.gzip };
  let ran = with_rand(rand(41), || simulate { on_clock(|| collected([], || shipping(cfg))) }).value;
  assert_eq(ran.seen.traces, [expected_traces(cfg, 41)]);
  assert_eq(ran.seen.metrics, [expected_metrics(cfg)]);
  assert_eq(ran.seen.types, [content_type(c.encoding), content_type(c.encoding)]);
  assert_eq(ran.seen.gzipped, if c.gzip { 2 } else { 0 });
  assert_eq(ran.value.exported, 2);
  assert_eq(ran.value.requests, 2);
  assert_eq(ran.value.queued + ran.value.dropped + ran.value.failed + ran.value.retries, 0)
}

fn step<[c]>(name: String) -> Unit / {trace.enter[c], trace.exit[c]} = {
  let span = trace.enter[c](name, map_new());
  trace.exit[c](span, trace::Ok)
}

fn span_names(t: Traces) -> List<String> =
  fold(t.resource_spans, [], |acc: List<String>, r: ResourceSpans|
    fold(r.scope_spans, acc, |inner: List<String>, s: ScopeSpans|
      fold(s.spans, inner, |names: List<String>, x: Span| push(names, x.name))))

test "a request the collector cannot take yet is sent again after what Retry-After and the backoff ask" {
  let cfg: Config = test_config();
  let ran = with_rand(rand(7), ||
    simulate {
      on_clock(||
        collected([Busy(503, Some(2)), Busy(429, None), Take], ||
          exporting[collector](cfg, || {
            step[shop]("only");
            flush()
          })))
    }).value;
  assert_eq(map(ran.seen.traces, span_names), [["only"]]);
  assert_eq(ran.value.exported, 1);
  assert_eq(ran.value.retries, 2);
  assert_eq(ran.value.failed, 0);
  match ran.seen.arrivals {
    [first, second, third] -> {
      assert_eq(first, 0);
      // `Retry-After: 2` is longer than the first backoff, and the second backoff is 200 ms,
      // waited somewhere in its upper half.
      assert_eq(second, 2000);
      assert(third >= 2100 && third < 2200)
    },
    _ -> panic("expected three requests"),
  }
}

test "a failed request waits for an event after its backoff, and the events before it queue" {
  let base: Config = test_config();
  let cfg: Config = { ..base, batch: 1 };
  let ran = with_rand(rand(8), ||
    simulate {
      on_clock(||
        collected([Busy(503, None), Take], ||
          exporting[collector](cfg, || {
            step[shop]("a");
            step[shop]("b");
            let waiting = stats();
            time.sleep_ms(150);
            step[shop]("c");
            let resent = stats();
            { waiting: waiting, resent: resent, done: flush() }
          })))
    }).value;
  // `a` failed and waits; `b` queued behind it without a request of its own.
  assert_eq(ran.value.waiting.retries, 1);
  assert_eq(ran.value.waiting.queued, 2);
  assert_eq(ran.value.waiting.exported, 0);
  // `c` came after the backoff, so its event sent `a` again.
  assert_eq(ran.value.resent.exported, 1);
  assert_eq(ran.value.resent.queued, 2);
  assert_eq(map(ran.seen.traces, span_names), [["a"], ["b"], ["c"]]);
  assert_eq(ran.seen.arrivals, [0, 150, 150, 150]);
  assert_eq(ran.value.done.exported, 3)
}

test "a full queue drops and counts, and what was queued is sent once the collector is back" {
  let base: Config = test_config();
  let cfg: Config = { ..base, queue: 3, batch: 2, attempts: 3 };
  let ran = with_rand(rand(9), ||
    simulate {
      on_clock(||
        collected([Down, Down], ||
          exporting[collector](cfg, || {
            fold(["s1", "s2", "s3", "s4", "s5", "s6", "s7"], (), |_: Unit, name: String|
              step[shop](name));
            let full = stats();
            { full: full, done: flush() }
          })))
    }).value;
  assert_eq(ran.value.full.dropped, 2);
  assert_eq(ran.value.full.queued, 5);
  assert_eq(ran.value.full.retries, 1);
  assert_eq(map(ran.seen.traces, span_names), [["s1", "s2"], ["s3", "s4"], ["s5"]]);
  assert_eq(ran.value.done.exported, 5);
  assert_eq(ran.value.done.dropped, 2);
  assert_eq(ran.value.done.retries, 2);
  assert_eq(ran.value.done.failed, 0)
}

test "a request is given up on when the collector refuses it, or fails it as often as it may be tried" {
  let base: Config = test_config();
  let cfg: Config = { ..base, attempts: 2 };
  let spurned = with_rand(rand(10), ||
    simulate {
      on_clock(||
        collected([Bad], ||
          exporting[collector](cfg, || {
            step[shop]("a");
            flush()
          })))
    }).value;
  assert_eq(spurned.value.failed, 1);
  assert_eq(spurned.value.retries, 0);
  assert_eq(len(spurned.seen.arrivals), 1);
  let tired = with_rand(rand(10), ||
    simulate {
      on_clock(||
        collected([Busy(502, None), Busy(504, None), Take], ||
          exporting[collector](cfg, || {
            step[shop]("a");
            flush()
          })))
    }).value;
  assert_eq(tired.value.failed, 1);
  assert_eq(tired.value.retries, 1);
  assert_eq(tired.value.exported, 0);
  assert_eq(len(tired.seen.arrivals), 2);
  assert_eq(tired.seen.traces, [])
}

test "spans are sent when enough wait or the oldest has waited long enough, and metrics on their interval" {
  let base: Config = test_config();
  let cfg: Config = { ..base, batch: 3, max_age_ms: 5000, metrics_every_ms: 60000 };
  let ran = with_rand(rand(11), ||
    simulate {
      on_clock(||
        collected([], ||
          exporting[collector](cfg, || {
            step[shop]("a");
            step[shop]("b");
            let two = stats();
            step[shop]("c");
            step[shop]("d");
            time.sleep_ms(6000);
            step[shop]("e");
            trace.count[shop]("ticks", 1, map_new());
            time.sleep_ms(61000);
            trace.count[shop]("ticks", 2, map_new());
            { two: two, later: stats() }
          })))
    }).value;
  assert_eq(ran.value.two.queued, 2);
  assert_eq(ran.value.two.requests, 0);
  assert_eq(map(ran.seen.traces, span_names), [["a", "b", "c"], ["d", "e"]]);
  assert_eq(ran.seen.arrivals, [0, 6000, 67000]);
  assert_eq(ran.value.later.requests, 3);
  match ran.seen.metrics {
    [{ resource_metrics: [{ scope_metrics: [{ metrics: [ticks], .. }], .. }] }] ->
      assert_eq(
        ticks.data,
        Sum(
          [{ attributes: [], start: nanos_at(0), time: nanos_at(67000), value: AsInt(3) }],
          Cumulative,
          true,
        ),
      ),
    _ -> panic("expected one request of one metric"),
  }
}

fn remote(sampled: Bool) -> http::Request / {abort.raise} = {
  let req = http::request_to(http::Get, "shop.example", "/orders", b"");
  {
    ..req,
    headers: http::set_header(
      req.headers,
      "traceparent",
      "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-0" ++ (if sampled { "1" } else { "0" }),
    ),
  }
}

test "a trace that is not recorded is not sent, and a span takes the decision of its caller" {
  let base: Config = test_config();
  let cfg: Config = { ..base, sampler: telemetry::AlwaysOff };
  let ran = with_rand(rand(12), ||
    simulate {
      on_clock(||
        collected([], ||
          exporting[collector](cfg, || {
            step[shop]("unrecorded");
            telemetry::in_span[shop]("also unrecorded", telemetry::Internal, map_new(), ||
              step[shop]("nor this"));
            telemetry::served[web](remote(true), |r: http::Request| {
              step[shop]("inside a recorded request");
              http::response(204, b"")
            });
            telemetry::served[web](remote(false), |r: http::Request| http::response(204, b""));
            flush()
          })))
    }).value;
  assert_eq(ran.value.unsampled, 4);
  assert_eq(ran.value.exported, 2);
  match ran.seen.traces {
    [{ resource_spans: [{ scope_spans: [shop, web], .. }] }] -> {
      assert_eq(shop.scope.name, "shop");
      assert_eq(web.scope.name, "web");
      match ((shop.spans, web.spans)) {
        ([inner], [request]) -> {
          assert_eq(
            traceparent::trace_id_hex(request.trace_id),
            "4bf92f3577b34da6a3ce929d0e0e4736",
          );
          assert_eq(request.parent, traceparent::span_id_of_hex("00f067aa0ba902b7"));
          assert_eq(request.kind, Server);
          assert_eq(request.flags, 1u32);
          assert_eq(inner.parent, Some(request.span_id));
          assert_eq(inner.trace_id, request.trace_id);
          assert_eq(request.attributes, [
            attribute("http.request.method", StringValue("GET")),
            attribute("http.response.status_code", IntValue(204)),
            attribute("network.protocol.version", StringValue("1.1")),
            attribute("server.address", StringValue("shop.example")),
            attribute("url.path", StringValue("/orders")),
          ])
        },
        _ -> panic("expected one span on each channel"),
      }
    },
    _ -> panic("expected one request of two scopes"),
  }
}

test "a ratio records the traces whose ids it keeps, and no others" {
  let base: Config = test_config();
  let cfg: Config = { ..base, sampler: telemetry::Ratio(1, 2) };
  let ran = with_rand(rand(13), ||
    simulate {
      on_clock(||
        collected([], ||
          exporting[collector](cfg, || {
            fold(range(0, 24), (), |_: Unit, i: Int| step[shop]("s" ++ int_to_string(i)));
            flush()
          })))
    }).value;
  assert_eq(ran.value.exported + ran.value.unsampled, 24);
  assert(ran.value.exported > 4 && ran.value.unsampled > 4);
  let kept = fold(ran.seen.traces, true, |all_kept: Bool, t: Traces|
    fold(t.resource_spans, all_kept, |a: Bool, r: ResourceSpans|
      fold(r.scope_spans, a, |b: Bool, s: ScopeSpans|
        fold(s.spans, b, |c: Bool, x: Span|
          c && telemetry::records(telemetry::Ratio(1, 2), x.trace_id)))));
  assert(kept)
}

test "a collector that takes part of a request is believed, and a metric keeps no more series than its bound" {
  let base: Config = test_config();
  let cfg: Config = { ..base, max_series: 2 };
  let ran = with_rand(rand(14), ||
    simulate {
      on_clock(||
        collected([Partial(1)], ||
          exporting[collector](cfg, || {
            step[shop]("a");
            step[shop]("b");
            fold(["x", "y", "z", "x"], (), |_: Unit, sku: String|
              trace.count[shop]("orders", 1, #{"sku": trace::FText(sku)}));
            flush()
          })))
    }).value;
  assert_eq(ran.value.exported, 1);
  assert_eq(ran.value.rejected, 1);
  assert_eq(ran.value.series_dropped, 1);
  match ran.seen.metrics {
    [{ resource_metrics: [{ scope_metrics: [{ metrics: [orders], .. }], .. }] }] -> match orders.data {
      Sum(points, _, _) -> assert_eq(map(points, |p: NumberPoint| p.value), [AsInt(2), AsInt(1)]),
      _ -> panic("expected a sum"),
    },
    _ -> panic("expected one metric"),
  }
}

test "closing a span closes the spans left open under it, and an exit of a span not open is counted" {
  let cfg: Config = test_config();
  let ran = with_rand(rand(15), ||
    simulate {
      on_clock(||
        collected([], ||
          exporting[collector](cfg, || {
            let outer = trace.enter[shop]("outer", map_new());
            let inner = trace.enter[shop]("inner", map_new());
            trace.exit[shop](outer, trace::Ok);
            trace.exit[shop](inner, trace::Ok);
            flush()
          })))
    }).value;
  assert_eq(ran.value.misplaced, 1);
  match ran.seen.traces {
    [{ resource_spans: [{ scope_spans: [{ spans: [outer, inner], .. }], .. }] }] -> {
      assert_eq(inner.name, "inner");
      assert_eq(inner.status, { code: StatusError, message: "abandoned" });
      assert_eq(inner.parent, Some(outer.span_id));
      assert_eq(outer.status, unset())
    },
    _ -> panic("expected two spans"),
  }
}

test "a flush waits no longer than it is given, and what it could not send stays waiting" {
  let base: Config = test_config();
  let cfg: Config = { ..base, flush_ms: 3000 };
  let ran = with_rand(rand(16), ||
    simulate {
      on_clock(||
        collected([Busy(503, Some(60)), Take], ||
          exporting[collector](cfg, || {
            step[shop]("a");
            let first = flush();
            time.sleep_ms(60000);
            { first: first, second: flush() }
          })))
    }).value;
  assert_eq(ran.value.first.retries, 1);
  assert_eq(ran.value.first.exported, 0);
  assert_eq(ran.value.first.queued, 1);
  assert_eq(ran.value.second.exported, 1);
  assert_eq(ran.value.second.queued, 0);
  assert_eq(ran.seen.arrivals, [0, 60000])
}

test "the wait before a retry doubles to its bound, sits in its upper half, and is never under Retry-After" {
  let cfg: Config = test_config();
  assert_eq(retry_wait(cfg, 1, None, 0), 50);
  assert_eq(retry_wait(cfg, 1, None, 999), 99);
  assert_eq(retry_wait(cfg, 2, None, 0), 100);
  assert_eq(retry_wait(cfg, 4, None, 500), 600);
  assert_eq(retry_wait(cfg, 5, None, 0), 500);
  assert_eq(retry_wait(cfg, 30, None, 0), 500);
  assert_eq(retry_wait(cfg, 1, Some(3000), 999), 3000);
  assert_eq(retry_wait(cfg, 5, Some(10), 0), 500)
}
