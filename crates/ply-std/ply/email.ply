fn oddities() -> String =
  \\From: Pete(A nice \) chap) <pete(his account)@silly.test(his host)>
  \\To:A Group(Some people)
  \\     :Chris Jones <c@(Chris's host.)public.example>,
  \\         joe@example.org,
  \\  John <jdoe@one.test> (my dear friend); (the end of the group)
  \\Cc:(Empty list)(start)Hidden recipients  :(nobody(that I know))  ;
  \\Date: Thu,
  \\      13
  \\        Feb
  \\          1969
  \\      23:32
  \\               -0330 (Newfoundland Time)
  \\Message-ID:              <testabcd.1234@silly.test>
  \\
  \\Testing.

fn obsolete_addressing() -> String =
  \\From: Joe Q. Public <john.q.public@example.com>
  \\To: Mary Smith <@node.test:mary@example.net>, , jdoe@test  . example
  \\Date: Tue, 1 Jul 2003 10:52:37 +0200
  \\Message-ID: <5678.21-Nov-1997@example.com>
  \\
  \\Hi everyone.

fn obsolete_dates() -> String =
  \\From: John Doe <jdoe@machine.example>
  \\To: Mary Smith <mary@example.net>
  \\Subject: Saying Hello
  \\Date: 21 Nov 97 09:55:06 GMT
  \\Message-ID: <1234@local.machine.example>
  \\
  \\This is a message just to say hello.
  \\So, "Hello".

/// RFC 5322 Appendix A.6.3, where `__` stands for the two spaces its folded line is made of, as
/// it does in the RFC.
fn obsolete_white_space() -> String =
  \\From  : John Doe <jdoe@machine(comment).  example>
  \\To    : Mary Smith
  \\__
  \\          <mary@example.net>
  \\Subject     : Saying Hello
  \\Date  : Fri, 21 Nov 1997 09(comment):   55  :  06 -0600
  \\Message-ID  : <1234   @   local(blah)  .machine .example>
  \\
  \\This is a message just to say hello.
  \\So, "Hello".

/// The fields of RFC 2047 §8's first example, as a message with no body.
fn encoded_names() -> String =
  \\From: =?US-ASCII?Q?Keith_Moore?= <moore@cs.utk.edu>
  \\To: =?ISO-8859-1?Q?Keld_J=F8rn_Simonsen?= <keld@dkuug.dk>
  \\CC: =?ISO-8859-1?Q?Andr=E9?= Pirard <PIRARD@vm1.ulg.ac.be>
  \\Subject: =?ISO-8859-1?B?SWYgeW91IGNhbiByZWFkIHRoaXMgeW8=?=
  \\ =?ISO-8859-2?B?dSB1bmRlcnN0YW5kIHRoZSBleGFtcGxlLg==?=

type Example = { what: String, text: String, defects: List<Why>, says: List<String> }

/// RFC 5322 Appendix A's messages, each with what `read` refuses it for, none for all before
/// A.6, and what its fields say.
fn examples() -> List<Example> / {abort.raise} =
  [
    {
      what: "A.1.1, a message from one person to another",
      text: simple_addressing(),
      defects: [],
      says: [
        "from John Doe <jdoe@machine.example>",
        "to Mary Smith <mary@example.net>",
        "subject Saying Hello",
        "date 1997-11-21T09:55:06-06:00",
        "id <1234@local.machine.example>",
        hello(),
      ],
    },
    {
      what: "A.1.1, the same sent by a secretary",
      text: sent_by_a_secretary(),
      defects: [],
      says: [
        "from John Doe <jdoe@machine.example>",
        "sender Michael Jones <mjones@machine.example>",
        "to Mary Smith <mary@example.net>",
        "subject Saying Hello",
        "date 1997-11-21T09:55:06-06:00",
        "id <1234@local.machine.example>",
        hello(),
      ],
    },
    {
      what: "A.1.2, different types of mailboxes",
      text: different_mailboxes(),
      defects: [],
      says: [
        "from \"Joe Q. Public\" <john.q.public@example.com>",
        "to Mary Smith <mary@x.test>, jdoe@example.org, Who? <one@y.test>",
        "cc boss@nil.test, \"Giant; \\\"Big\\\" Box\" <sysservices@example.net>",
        "date 2003-07-01T10:52:37+02:00",
        "id <5678.21-Nov-1997@example.com>",
        "text Hi everyone.\n",
      ],
    },
    {
      what: "A.1.3, group addresses",
      text: group_addresses(),
      defects: [],
      says: [
        "from Pete <pete@silly.example>",
        "to A Group:Ed Jones <c@a.test>, joe@where.test, John <jdoe@one.test>;",
        "cc Undisclosed recipients:;",
        "date 1969-02-13T23:32:54-03:30",
        "id <testabcd.1234@silly.example>",
        "text Testing.\n",
      ],
    },
    {
      what: "A.2, a reply",
      text: first_reply(),
      defects: [],
      says: [
        "from Mary Smith <mary@example.net>",
        "reply-to \"Mary Smith: Personal Account\" <smith@home.example>",
        "to John Doe <jdoe@machine.example>",
        "subject Re: Saying Hello",
        "date 1997-11-21T10:01:10-06:00",
        "id <3456@example.net>",
        "in-reply-to <1234@local.machine.example>",
        "references <1234@local.machine.example>",
        "text This is a reply to your hello.\n",
      ],
    },
    {
      what: "A.2, a reply to the reply",
      text: second_reply(),
      defects: [],
      says: [
        "from John Doe <jdoe@machine.example>",
        "to \"Mary Smith: Personal Account\" <smith@home.example>",
        "subject Re: Saying Hello",
        "date 1997-11-21T11:00:00-06:00",
        "id <abcd.1234@local.machine.test>",
        "in-reply-to <3456@example.net>",
        "references <1234@local.machine.example> <3456@example.net>",
        "text This is a reply to your reply.\n",
      ],
    },
    {
      what: "A.3, a resent message",
      text: resent(),
      defects: [],
      says: [
        "from John Doe <jdoe@machine.example>",
        "to Mary Smith <mary@example.net>",
        "subject Saying Hello",
        "date 1997-11-21T09:55:06-06:00",
        "id <1234@local.machine.example>",
        hello(),
      ],
    },
    {
      what: "A.4, a message with trace fields",
      text: traced(),
      defects: [],
      says: [
        "from John Doe <jdoe@node.example>",
        "to Mary Smith <mary@example.net>",
        "subject Saying Hello",
        "date 1997-11-21T09:55:06-06:00",
        "id <1234@local.node.example>",
        hello(),
      ],
    },
    {
      what: "A.5, white space, comments and other oddities",
      text: oddities(),
      defects: [],
      says: [
        "from Pete <pete@silly.test>",
        "to A Group:Chris Jones <c@public.example>, joe@example.org, John <jdoe@one.test>;",
        "cc Hidden recipients:;",
        "date 1969-02-13T23:32:00-03:30",
        "id <testabcd.1234@silly.test>",
        "text Testing.\n",
      ],
    },
    {
      what: "A.6.1, obsolete addressing",
      text: obsolete_addressing(),
      defects: [ObsoleteSyntax, ObsoleteSyntax],
      says: [
        "from \"Joe Q. Public\" <john.q.public@example.com>",
        "to Mary Smith <mary@example.net>, jdoe@test.example",
        "date 2003-07-01T10:52:37+02:00",
        "id <5678.21-Nov-1997@example.com>",
        "text Hi everyone.\n",
      ],
    },
    {
      what: "A.6.2, obsolete dates",
      text: obsolete_dates(),
      defects: [ObsoleteSyntax],
      says: [
        "from John Doe <jdoe@machine.example>",
        "to Mary Smith <mary@example.net>",
        "subject Saying Hello",
        "date 1997-11-21T09:55:06Z",
        "id <1234@local.machine.example>",
        hello(),
      ],
    },
    {
      what: "A.6.3, obsolete white space and comments",
      text: string::replace(obsolete_white_space(), "__", "  "),
      defects: [
        ObsoleteSyntax,
        ObsoleteSyntax,
        ObsoleteSyntax,
        ObsoleteSyntax,
        ObsoleteSyntax,
        ObsoleteSyntax,
        ObsoleteSyntax,
        ObsoleteSyntax,
        ObsoleteSyntax,
      ],
      says: [
        "from John Doe <jdoe@machine.example>",
        "to Mary Smith <mary@example.net>",
        "subject Saying Hello",
        "date 1997-11-21T09:55:06-06:00",
        "id <1234@local.machine.example>",
        hello(),
      ],
    },
    {
      what: "the fields of RFC 2047's example",
      text: encoded_names(),
      defects: [Missing("date")],
      says: [
        "from Keith Moore <moore@cs.utk.edu>",
        "to Keld J\u{f8}rn Simonsen <keld@dkuug.dk>",
        "cc Andr\u{e9} Pirard <PIRARD@vm1.ulg.ac.be>",
        "subject If you can read this you understand the example.",
      ],
    },
  ]

test "reads {c.what}" for c: Example in examples() {
  let data = sent(c.text);
  let read = read_tolerant(data, default_limits());
  assert_eq(map(read.defects, |d: Refusal| d.why), c.defects);
  assert_eq(said(read.message), c.says);
  assert_eq(render(read.message), data);
  assert_eq(result_is_ok(parse(data, default_limits())), len(c.defects) == 0)
}

test "a field is kept as it was written beside its unfolded value" {
  let m = read(sent(traced()), default_limits());
  assert_eq(headers(m, "received"), [
    "from x.y.test   by example.net   via TCP   with ESMTP   id ABC12345   for <mary@example.net>;  21 Nov 1997 10:05:43 -0600",
    "from node.example by x.y.test; 21 Nov 1997 10:01:22 -0600",
  ]);
  assert_eq(header(m, "RECEIVED"), list_at(headers(m, "Received"), 0));
  assert_eq(header(m, "x-none"), None);
  assert_eq(
    option_map(first(fields(m)), |f: Field| f.raw),
    Some(
      b"Received: from x.y.test\r\n   by example.net\r\n   via TCP\r\n   with ESMTP\r\n   id ABC12345\r\n   for <mary@example.net>;  21 Nov 1997 10:05:43 -0600\r\n",
    ),
  );
  assert_eq(map(fields(m), |f: Field| f.name), [
    "Received",
    "Received",
    "From",
    "To",
    "Subject",
    "Date",
    "Message-ID",
  ]);
  assert_eq(body(m), b"This is a message just to say hello.\r\nSo, \"Hello\".\r\n");
  let again = read(sent(resent()), default_limits());
  assert_eq(header(again, "Resent-Message-ID"), Some("<78910@example.net>"));
  assert_eq(
    result_map(
      parse_address_list(match header(again, "resent-to") { Some(v) -> v, None -> "" }),
      address_list_text,
    ),
    Ok("Jane Brown <j-brown@other.example>"),
  )
}

fn stamped() -> String = "Date: Fri, 21 Nov 1997 09:55:06 -0600\r\nFrom: a@example.org\r\n"

/// A message of the two fields every message has, then `fields`, a blank line and `payload`.
fn message_of(extra: String, payload: Bytes) -> Bytes =
  bytes_concat_all([bytes_of_string(stamped()), bytes_of_string(extra), b"\r\n", payload])

type Defective = { what: String, data: Bytes, utf8: Bool, defects: List<Refusal> }

fn flawed(what: String, extra: String, payload: Bytes, defects: List<Refusal>) -> Defective =
  { what: what, data: message_of(extra, payload), utf8: false, defects: defects }

/// Messages a conforming writer does not write, each with every defect a tolerant reader lists
/// for it, the first of which is what a strict one refuses it for.
fn defective() -> List<Defective> / {abort.raise} =
  [
    {
      what: "a missing blank line",
      data: bytes_concat(bytes_of_string(stamped()), b"The body starts here: at once.\r\n"),
      utf8: false,
      defects: [{ at: 60, why: NoBlankLine }],
    },
    {
      what: "a header with no colon",
      data: bytes_concat(
        bytes_of_string(stamped()),
        b"Subject hello\r\nTo: b@example.org\r\n\r\nbody\r\n",
      ),
      utf8: false,
      defects: [{ at: 60, why: NoBlankLine }],
    },
    {
      what: "a continuation before any field",
      data: bytes_concat(b" folded\r\n", bytes_of_string(stamped())),
      utf8: false,
      defects: [
        { at: 0, why: NoBlankLine },
        { at: 0, why: Missing("date") },
        { at: 0, why: Missing("from") },
      ],
    },
    {
      what: "bare line feeds",
      data: b"Date: Fri, 21 Nov 1997 09:55:06 -0600\nFrom: a@example.org\n\nbody\nmore\n",
      utf8: false,
      defects: [{ at: 37, why: BareLineFeed }, { at: 63, why: BareLineFeed }],
    },
    flawed("a bare carriage return in the body", "", b"bo\rdy\r\n", [
      { at: 64, why: BareCarriageReturn },
    ]),
    flawed("a bare carriage return in a field", "Subject: a\rb\r\n", b"", [
      { at: 70, why: BareCarriageReturn },
    ]),
    flawed("an unterminated quoted string", "To: \"unclosed <b@example.org>\r\n", b"", [
      { at: 60, why: Unclosed },
    ]),
    flawed(
      "a boundary never closed",
      "Content-Type: multipart/mixed; boundary=b\r\n",
      b"--b\r\n\r\none\r\n--b\r\n\r\ntwo\r\n",
      [{ at: 129, why: UnclosedBoundary }],
    ),
    flawed("a line over 998 octets", "", bytes_concat(bytes::repeat(b"x", 999), b"\r\n"), [
      { at: 62 + 998, why: LongLine },
    ]),
    flawed(
      "a header line over 998 octets",
      "X-Long: " ++ string::repeat("x", 991) ++ "\r\n",
      b"",
      [{ at: 60 + 998, why: LongLine }],
    ),
    flawed("8-bit bytes in a header", "Subject: caf\u{e9}\r\n", b"", [
      { at: 60 + 12, why: EightBitHeader },
    ]),
    {
      what: "bytes that are no UTF-8 in a header that may hold UTF-8",
      data: bytes_concat_all([bytes_of_string(stamped()), b"Subject: caf\xe9\r\n\r\n"]),
      utf8: true,
      defects: [{ at: 60 + 12, why: EightBitHeader }],
    },
    flawed("a bad encoded word", "Subject: =?x-unknown?Q?a?= b\r\n", b"", [
      { at: 60, why: BadEncodedWord },
    ]),
    flawed(
      "an encoded word that carries a line break",
      "Subject: =?UTF-8?Q?a=0D=0ABcc:_x?=\r\n",
      b"",
      [{ at: 60, why: BadEncodedWord }],
    ),
    flawed("a control character in a field", "Subject: a\0b\r\n", b"", [{ at: 70, why: Control }]),
    {
      what: "no date and no author",
      data: b"Subject: x\r\n\r\n",
      utf8: false,
      defects: [{ at: 0, why: Missing("date") }, { at: 0, why: Missing("from") }],
    },
    flawed("a second author field", "From: b@example.org\r\n", b"", [
      { at: 60, why: Repeated("from") },
    ]),
    flawed("a group for an author", "Subject: x\r\nFrom: Team:b@example.org;\r\n", b"", [
      { at: 72, why: Repeated("from") },
      { at: 72, why: Unexpected },
    ]),
    {
      what: "a field that ends the message with no line break",
      data: b"Date: Fri, 21 Nov 1997 09:55:06 -0600\r\nFrom: a@example.org",
      utf8: false,
      defects: [{ at: 58, why: Truncated }],
    },
    {
      what: "a date that is none",
      data: b"Date: yesterday\r\nFrom: a@example.org\r\n\r\n",
      utf8: false,
      defects: [{ at: 0, why: BadDate }],
    },
    flawed("a message identifier with no brackets", "Message-ID: 1234@example.org\r\n", b"", [
      { at: 60, why: BadMessageId },
    ]),
    flawed("two message identifiers for one message", "Message-ID: <a@b> <c@d>\r\n", b"", [
      { at: 60, why: BadMessageId },
    ]),
    flawed("references that name nothing", "References: (none)\r\n", b"", [
      { at: 60, why: BadMessageId },
    ]),
    flawed("a media type that is none", "Content-Type: text\r\n", b"x", [
      { at: 60, why: BadMediaType },
    ]),
    flawed(
      "a parameter whose sections do not count from zero",
      "Content-Type: text/plain; name*1=x\r\n",
      b"x",
      [{ at: 60, why: BadMediaType }],
    ),
    flawed(
      "a second media type",
      "Content-Type: text/plain\r\nContent-Type: text/html\r\n",
      b"x",
      [{ at: 86, why: Repeated("content-type") }],
    ),
    flawed(
      "a disposition that does not read",
      "Content-Disposition: attachment; filename\r\n",
      b"x",
      [{ at: 60, why: BadDisposition }],
    ),
    flawed("a transfer encoding nobody names", "Content-Transfer-Encoding: uuencode\r\n", b"x", [
      { at: 60, why: BadEncoding("uuencode") },
    ]),
    flawed(
      "a body that is not the base64 it says",
      "Content-Transfer-Encoding: base64\r\n",
      b"!!!!",
      [{ at: 60 + 37, why: BadTransferData }],
    ),
    flawed(
      "a body that is not the quoted-printable it says",
      "Content-Transfer-Encoding: quoted-printable\r\n",
      b"a=ZZ",
      [{ at: 60 + 47, why: BadTransferData }],
    ),
    flawed("an 8-bit byte in a body that names no encoding", "", b"caf\xe9\r\n", [
      { at: 65, why: Undeclared8Bit },
    ]),
    flawed(
      "a multipart body under an encoding",
      "Content-Type: multipart/mixed; boundary=b\r\nContent-Transfer-Encoding: base64\r\n",
      b"--b--\r\n",
      [{ at: 103, why: BadEncoding("base64") }],
    ),
    flawed(
      "a multipart body with no boundary named",
      "Content-Type: multipart/mixed\r\n",
      b"--b--\r\n",
      [{ at: 93, why: BadMultipart(multipart::NoBoundary) }],
    ),
    flawed(
      "a delimiter that goes on as text",
      "Content-Type: multipart/mixed; boundary=b\r\n",
      b"--bx\r\n\r\none\r\n--b--\r\n",
      [{ at: 108, why: BadMultipart(multipart::BadDelimiter) }],
    ),
    flawed("an obsolete blank before a colon", "Subject : x\r\n", b"", [
      { at: 60, why: ObsoleteSyntax },
    ]),
    flawed("a folded line of blanks alone", "Subject: x\r\n \t\r\n y\r\n", b"", [
      { at: 72, why: ObsoleteSyntax },
    ]),
  ]

test "lists the defects of {c.what}" for c: Defective in defective() {
  let repertoire = if c.utf8 { Utf8 } else { Ascii };
  let read = read_tolerant(c.data, default_limits(), repertoire);
  assert_eq(read.defects, c.defects);
  assert_eq(render(read.message), c.data);
  assert_eq(result_map(parse(c.data, default_limits(), repertoire), render), match c.defects {
    [found, ..] -> Err(found),
    [] -> Ok(c.data),
  })
}

type Unbounded = { what: String, data: Bytes, limits: Limits, at: Int, why: Why }

/// Limits small enough for a test's message to pass each.
fn tight() -> Limits =
  { max_bytes: 400, max_fields: 3, max_header_bytes: 120, max_depth: 1, max_parts: 2 }

fn two_deep() -> Bytes =
  message_of(
    "Content-Type: multipart/mixed; boundary=a\r\n",
    b"--a\r\nContent-Type: multipart/mixed; boundary=b\r\n\r\n--b\r\n\r\ndeep\r\n--b--\r\n--a--\r\n",
  )

fn three_parts() -> Bytes =
  message_of(
    "Content-Type: multipart/mixed; boundary=a\r\n",
    b"--a\r\n\r\n1\r\n--a\r\n\r\n2\r\n--a\r\n\r\n3\r\n--a--\r\n",
  )

/// Messages past a limit, each with where it passes it.
fn unbounded() -> List<Unbounded> / {abort.raise} =
  [
    {
      what: "a message longer than the limit",
      data: message_of("", bytes::repeat(b"x", 400)),
      limits: tight(),
      at: 400,
      why: TooLarge,
    },
    {
      what: "a header field more than the limit",
      data: message_of("Subject: x\r\nTo: b@example.org\r\n", b""),
      limits: tight(),
      at: 72,
      why: TooManyFields,
    },
    {
      what: "a header block longer than the limit",
      data: message_of("Subject: " ++ string::repeat("x", 100) ++ "\r\n", b""),
      limits: tight(),
      at: 120,
      why: HeadersTooLarge,
    },
    {
      what: "a header block with no end",
      data: bytes_concat(bytes_of_string(stamped() ++ "Subject: "), bytes::repeat(b"x", 300)),
      limits: tight(),
      at: 120,
      why: HeadersTooLarge,
    },
    {
      what: "parts nested deeper than the limit",
      data: two_deep(),
      limits: tight(),
      at: 110,
      why: TooDeep,
    },
    {
      what: "any multipart body where none may nest",
      data: three_parts(),
      limits: { ..tight(), max_depth: 0 },
      at: 0,
      why: TooDeep,
    },
    {
      what: "a part more than the limit",
      data: three_parts(),
      limits: tight(),
      at: 130,
      why: TooManyParts,
    },
    {
      what: "a nested part more than the limit",
      data: two_deep(),
      limits: { ..tight(), max_depth: 2, max_parts: 1 },
      at: 160,
      why: TooManyParts,
    },
    {
      what: "a header field more than the limit in a part",
      data: message_of(
        "Content-Type: multipart/mixed; boundary=a\r\n",
        b"--a\r\nA: 1\r\nB: 2\r\nC: 3\r\nD: 4\r\n\r\n\r\n--a--\r\n",
      ),
      limits: tight(),
      at: 128,
      why: TooManyFields,
    },
  ]

test "refuses {c.what}" for c: Unbounded in unbounded() {
  assert_eq(result_map(parse(c.data, c.limits), render), Err({ at: c.at, why: c.why }));
  assert_eq(
    result_map(parse_tolerant(c.data, c.limits), |t: Tolerated| t.defects),
    Err({ at: c.at, why: c.why }),
  )
}

test "a message at its limits is read, and limits below zero are read as zero" {
  let limits: Limits = tight();
  assert(result_is_ok(parse(message_of("", bytes::repeat(b"x", 338)), limits)));
  assert(result_is_ok(parse(message_of("Subject: x\r\n", b""), limits)));
  assert(
    result_is_ok(parse(message_of("Subject: " ++ string::repeat("x", 47) ++ "\r\n", b""), limits)),
  );
  assert(result_is_ok(parse(two_deep(), { ..limits, max_depth: 2 })));
  assert(result_is_ok(parse(three_parts(), { ..limits, max_parts: 3 })));
  assert_eq(
    result_map(parse(b"", { ..limits, max_bytes: -1 }), render),
    Err({ at: 0, why: Missing("date") }),
  );
  assert_eq(
    result_map(parse(b"x", { ..limits, max_bytes: -1 }), render),
    Err({ at: 0, why: TooLarge }),
  );
  assert_eq(
    result_map(parse(message_of("", b""), { ..limits, max_fields: -1 }), render),
    Err({ at: 0, why: TooManyFields }),
  )
}

/// RFC 2046 §5.1.1's message.
fn sample_message() -> String =
  \\From: Nathaniel Borenstein <nsb@bellcore.com>
  \\To: Ned Freed <ned@innosoft.com>
  \\Date: Sun, 21 Mar 1993 23:56:48 -0800 (PST)
  \\Subject: Sample message
  \\MIME-Version: 1.0
  \\Content-type: multipart/mixed; boundary="simple boundary"
  \\
  \\This is the preamble.  It is to be ignored, though it
  \\is a handy place for composition agents to include an
  \\explanatory note to non-MIME conformant readers.
  \\
  \\--simple boundary
  \\
  \\This is implicitly typed plain US-ASCII text.
  \\It does NOT end with a linebreak.
  \\--simple boundary
  \\Content-type: text/plain; charset=us-ascii
  \\
  \\This is explicitly typed plain US-ASCII text.
  \\It DOES end with a linebreak.
  \\
  \\--simple boundary--
  \\
  \\This is the epilogue.  It is also to be ignored.

/// RFC 2046 §5.1.4's message.
fn formatted_text_mail() -> String =
  \\From: Nathaniel Borenstein <nsb@bellcore.com>
  \\To: Ned Freed <ned@innosoft.com>
  \\Date: Mon, 22 Mar 1993 09:41:09 -0800 (PST)
  \\Subject: Formatted text mail
  \\MIME-Version: 1.0
  \\Content-Type: multipart/alternative; boundary=boundary42
  \\
  \\--boundary42
  \\Content-Type: text/plain; charset=us-ascii
  \\
  \\  ... plain text version of message goes here ...
  \\
  \\--boundary42
  \\Content-Type: text/enriched
  \\
  \\  ... RFC 1896 text/enriched version of same message
  \\      goes here ...
  \\
  \\--boundary42
  \\Content-Type: application/x-whatever
  \\
  \\  ... fanciest version of same message goes here ...
  \\
  \\--boundary42--

/// RFC 2049 Appendix A's message, as printed: its audio part's encoding stands after a blank
/// line, in its body, and its base64 parts hold a sentence in place of their data.
fn complex_multipart() -> String =
  \\MIME-Version: 1.0
  \\From: Nathaniel Borenstein <nsb@nsb.fv.com>
  \\To: Ned Freed <ned@innosoft.com>
  \\Date: Fri, 07 Oct 1994 16:15:05 -0700 (PDT)
  \\Subject: A multipart example
  \\Content-Type: multipart/mixed;
  \\              boundary=unique-boundary-1
  \\
  \\This is the preamble area of a multipart message.
  \\Mail readers that understand multipart format
  \\should ignore this preamble.
  \\
  \\If you are reading this text, you might want to
  \\consider changing to a mail reader that understands
  \\how to properly display multipart messages.
  \\
  \\--unique-boundary-1
  \\
  \\  ... Some text appears here ...
  \\
  \\[Note that the blank between the boundary and the start
  \\ of the text in this part means no header fields were
  \\ given and this is text in the US-ASCII character set.
  \\ It could have been done with explicit typing as in the
  \\ next part.]
  \\
  \\--unique-boundary-1
  \\Content-type: text/plain; charset=US-ASCII
  \\
  \\This could have been part of the previous part, but
  \\illustrates explicit versus implicit typing of body
  \\parts.
  \\
  \\--unique-boundary-1
  \\Content-Type: multipart/parallel; boundary=unique-boundary-2
  \\
  \\--unique-boundary-2
  \\Content-Type: audio/basic
  \\
  \\Content-Transfer-Encoding: base64
  \\
  \\  ... base64-encoded 8000 Hz single-channel
  \\      mu-law-format audio data goes here ...
  \\
  \\--unique-boundary-2
  \\Content-Type: image/jpeg
  \\Content-Transfer-Encoding: base64
  \\
  \\  ... base64-encoded image data goes here ...
  \\
  \\--unique-boundary-2--
  \\
  \\--unique-boundary-1
  \\Content-type: text/enriched
  \\
  \\This is <bold><italic>enriched.</italic></bold>
  \\<smaller>as defined in RFC 1896</smaller>
  \\
  \\Isn't it
  \\<bigger><bigger>cool?</bigger></bigger>
  \\
  \\--unique-boundary-1
  \\Content-Type: message/rfc822
  \\
  \\From: (mailbox in US-ASCII)
  \\To: (address in US-ASCII)
  \\Subject: (subject in US-ASCII)
  \\Content-Type: Text/plain; charset=ISO-8859-1
  \\Content-Transfer-Encoding: Quoted-printable
  \\
  \\  ... Additional text in ISO-8859-1 goes here ...
  \\
  \\--unique-boundary-1--

/// The media type of each part of a message that is no multipart, in the order written.
fn leaf_types(m: Message) -> List<String> / {abort.raise} =
  map(leaves(m, []), |l: Leaf| show(content_type(l.part)))

test "RFC 2046's sample message is two parts between a preamble and an epilogue" {
  let m = read(sent(sample_message()), default_limits());
  assert_eq(show(content_type(m)), "multipart/mixed; boundary=\"simple boundary\"");
  assert_eq(mime_version(m), Some("1.0"));
  assert_eq(map(parts(m), body), [
    b"This is implicitly typed plain US-ASCII text.\r\nIt does NOT end with a linebreak.",
    b"This is explicitly typed plain US-ASCII text.\r\nIt DOES end with a linebreak.\r\n",
  ]);
  assert_eq(leaf_types(m), ["text/plain; charset=us-ascii", "text/plain; charset=us-ascii"]);
  assert_eq(
    text_body(m),
    Some(Text("This is implicitly typed plain US-ASCII text.\nIt does NOT end with a linebreak.")),
  );
  assert_eq(html_body(m), None);
  assert_eq(map(attachments(m), |a: Attachment| a.data), [
    b"This is explicitly typed plain US-ASCII text.\r\nIt DOES end with a linebreak.\r\n",
  ]);
  assert_eq(date(m), date::parse_rfc3339("1993-03-21T23:56:48-08:00"));
  assert_eq(render(m), sent(sample_message()))
}

test "RFC 2046's alternatives are read in the order written, the plainest the text body" {
  let m = read(sent(formatted_text_mail()), default_limits());
  assert_eq(leaf_types(m), [
    "text/plain; charset=us-ascii",
    "text/enriched",
    "application/x-whatever",
  ]);
  assert_eq(text_body(m), Some(Text("  ... plain text version of message goes here ...\n")));
  assert_eq(html_body(m), None);
  assert_eq(len(attachments(m)), 2);
  assert_eq(drafted(m), None)
}

test "RFC 2049's complex multipart message is read as the parts it prints" {
  let data = sent(complex_multipart());
  let read = read_tolerant(data, default_limits());
  let m = read.message;
  assert_eq(map(read.defects, |d: Refusal| d.why), [BadTransferData]);
  assert_eq(leaf_types(m), [
    "text/plain; charset=us-ascii",
    "text/plain; charset=US-ASCII",
    "audio/basic",
    "image/jpeg",
    "text/enriched",
    "message/rfc822",
  ]);
  assert_eq(map(parts(m), |p: Message| len(parts(p))), [0, 0, 2, 0, 0]);
  assert_eq(map(leaves(m, []), |l: Leaf| transfer_encoding(l.part)), [
    SevenBit,
    SevenBit,
    SevenBit,
    Base64,
    SevenBit,
    SevenBit,
  ]);
  assert_eq(subject(m), Some("A multipart example"));
  assert_eq(date(m), date::parse_rfc3339("1994-10-07T16:15:05-07:00"));
  // The encapsulated message is a part's body, and a message of its own to whoever reads it.
  let inner = read_tolerant(
    match list_at(parts(m), 4) { Some(p) -> body(p), None -> b"" },
    default_limits(),
  ).message;
  assert_eq(subject(inner), Some("(subject in US-ASCII)"));
  assert_eq(show(content_type(inner)), "text/plain; charset=ISO-8859-1");
  assert_eq(transfer_encoding(inner), QuotedPrintable);
  assert_eq(text(inner), Text("  ... Additional text in ISO-8859-1 goes here ...\n"));
  assert_eq(render(m), data)
}

type Typed = { fields: String, media: String }

/// `Content-Type` fields and the media type each is. The first two are RFC 2045 §5.1's, which
/// it calls completely equivalent, and the next three RFC 2231's.
fn typed() -> List<Typed> =
  [
    {
      fields: "Content-type: text/plain; charset=us-ascii (Plain text)\r\n",
      media: "text/plain; charset=us-ascii",
    },
    {
      fields: "Content-type: text/plain; charset=\"us-ascii\"\r\n",
      media: "text/plain; charset=us-ascii",
    },
    {
      fields: "Content-Type: message/external-body; access-type=URL;\r\n URL*0=\"ftp://\";\r\n URL*1=\"cs.utk.edu/pub/moore/bulk-mailer/bulk-mailer.tar\"\r\n",
      media: "message/external-body; access-type=URL; url=\"ftp://cs.utk.edu/pub/moore/bulk-mailer/bulk-mailer.tar\"",
    },
    {
      fields: "Content-Type: application/x-stuff;\r\n title*=us-ascii'en-us'This%20is%20%2A%2A%2Afun%2A%2A%2A\r\n",
      media: "application/x-stuff; title=\"This is ***fun***\"",
    },
    {
      fields: "Content-Type: application/x-stuff;\r\n title*0*=us-ascii'en'This%20is%20even%20more%20;\r\n title*1*=%2A%2A%2Afun%2A%2A%2A%20;\r\n title*2=\"isn't it!\"\r\n",
      media: "application/x-stuff; title=\"This is even more ***fun*** isn't it!\"",
    },
    { fields: "", media: "text/plain; charset=us-ascii" },
    { fields: "CONTENT-TYPE: (a comment) Image/PNG (and another)\r\n", media: "image/png" },
    {
      fields: "Content-Type: text/html; title=\"a (b) c\"\r\n",
      media: "text/html; title=\"a (b) c\"",
    },
    { fields: "Content-Type: nonsense\r\n", media: "text/plain; charset=us-ascii" },
  ]

test "the media type of {show(c.fields)}" for c: Typed in typed() {
  assert_eq(
    show(content_type(read_tolerant(message_of(c.fields, b""), default_limits()).message)),
    c.media,
  )
}

test "RFC 2045's four spellings of one MIME version are one version" {
  let version = |value: String|
    mime_version(read(message_of("MIME-Version: " ++ value ++ "\r\n", b""), default_limits()));
  assert_eq(
    map(
      [
        "1.0",
        "1.0 (produced by MetaSend Vx.x)",
        "(produced by MetaSend Vx.x) 1.0",
        "1.(produced by MetaSend Vx.x)0",
      ],
      version,
    ),
    [Some("1.0"), Some("1.0"), Some("1.0"), Some("1.0")],
  );
  assert_eq(mime_version(read(message_of("", b""), default_limits())), None)
}

type Encoded = {
  what: String,
  fields: String,
  payload: Bytes,
  content: Option<Bytes>,
  text: Decoded,
}

/// Bodies in each transfer encoding and charset, with their content and their text.
fn coded_bodies() -> List<Encoded> =
  [
    {
      what: "a body with no fields",
      fields: "",
      payload: b"plain\r\ntext\r\n",
      content: Some(b"plain\r\ntext\r\n"),
      text: Text("plain\ntext\n"),
    },
    {
      what: "quoted-printable UTF-8",
      fields: "Content-Type: text/plain; charset=utf-8\r\nContent-Transfer-Encoding: quoted-printable\r\n",
      payload: b"caf=C3=A9 au=\r\n lait\r\n",
      content: Some(b"caf\xc3\xa9 au lait\r\n"),
      text: Text("caf\u{e9} au lait\n"),
    },
    {
      what: "base64 in lines",
      fields: "Content-Type: text/plain; charset=UTF-8\r\nContent-Transfer-Encoding: BASE64\r\n",
      payload: b"Y2Fm\r\nw6k=\r\n",
      content: Some(b"caf\xc3\xa9"),
      text: Text("caf\u{e9}"),
    },
    {
      what: "base64 with blanks, a stray byte and no padding",
      fields: "Content-Transfer-Encoding: base64\r\n",
      payload: b" Y2 Fm!\r\n\tw6k\r\n",
      content: Some(b"caf\xc3\xa9"),
      text: Malformed(b"caf\xc3\xa9"),
    },
    {
      what: "8bit ISO-8859-1",
      fields: "Content-Type: text/plain; charset=ISO-8859-1\r\nContent-Transfer-Encoding: 8bit\r\n",
      payload: b"caf\xe9\r\n",
      content: Some(b"caf\xe9\r\n"),
      text: Text("caf\u{e9}\n"),
    },
    {
      what: "windows-1252",
      fields: "Content-Type: text/plain; charset=\"Windows-1252\"\r\nContent-Transfer-Encoding: quoted-printable\r\n",
      payload: b"=93quoted=94 =80",
      content: Some(b"\x93quoted\x94 \x80"),
      text: Text("\u{201c}quoted\u{201d} \u{20ac}"),
    },
    {
      what: "a charset this module does not read",
      fields: "Content-Type: text/plain; charset=Shift_JIS\r\nContent-Transfer-Encoding: base64\r\n",
      payload: b"k/qWe4zq",
      content: Some(b"\x93\xfa\x96\x7b\x8c\xea"),
      text: Unknown(b"\x93\xfa\x96\x7b\x8c\xea", "shift_jis"),
    },
    {
      what: "bytes that are no text in the charset named",
      fields: "Content-Type: text/plain; charset=utf-8\r\nContent-Transfer-Encoding: 8bit\r\n",
      payload: b"caf\xe9",
      content: Some(b"caf\xe9"),
      text: Malformed(b"caf\xe9"),
    },
    {
      what: "8-bit bytes under no charset",
      fields: "Content-Transfer-Encoding: 8bit\r\n",
      payload: b"caf\xc3\xa9",
      content: Some(b"caf\xc3\xa9"),
      text: Malformed(b"caf\xc3\xa9"),
    },
    {
      what: "a body that is not in its encoding",
      fields: "Content-Transfer-Encoding: quoted-printable\r\n",
      payload: b"a=ZZ",
      content: None,
      text: Malformed(b"a=ZZ"),
    },
    {
      what: "an encoding nobody names",
      fields: "Content-Transfer-Encoding: x-uuencode\r\n",
      payload: b"begin",
      content: None,
      text: Malformed(b"begin"),
    },
    {
      what: "line breaks of every kind",
      fields: "Content-Transfer-Encoding: binary\r\n",
      payload: b"a\r\nb\nc\r\r\nd\re",
      content: Some(b"a\r\nb\nc\r\r\nd\re"),
      text: Text("a\nb\nc\nd\re"),
    },
  ]

test "the content and the text of {c.what}" for c: Encoded in coded_bodies() {
  let m = read_tolerant(message_of(c.fields, c.payload), default_limits()).message;
  assert_eq(content(m), c.content);
  assert_eq(text(m), c.text)
}

fn mixed_message() -> String =
  \\From: =?UTF-8?Q?J=C3=BCrgen?= <j@example.org>
  \\Date: Fri, 21 Nov 1997 09:55:06 -0600
  \\MIME-Version: 1.0
  \\Content-Type: multipart/mixed; boundary="outer"
  \\
  \\--outer
  \\Content-Type: multipart/alternative; boundary=inner
  \\
  \\--inner
  \\Content-Type: text/plain; charset=utf-8
  \\Content-Transfer-Encoding: quoted-printable
  \\
  \\caf=C3=A9
  \\--inner
  \\Content-Type: multipart/related; boundary=deepest
  \\
  \\--deepest
  \\Content-Type: text/html
  \\
  \\<img src="cid:logo@example.org">
  \\--deepest
  \\Content-Type: image/png
  \\Content-Transfer-Encoding: base64
  \\Content-ID: <logo@example.org>
  \\Content-Disposition: inline; filename=logo.png
  \\
  \\iVBORw0KGgo=
  \\--deepest--
  \\--inner--
  \\--outer
  \\Content-Type: application/pdf; name="fallback.pdf"
  \\Content-Disposition: attachment;
  \\ filename*0*=UTF-8''na%C3%AFve%20;
  \\ filename*1="resume.pdf" (a comment)
  \\Content-Transfer-Encoding: base64
  \\
  \\JVBERi0xLjQ=
  \\--outer
  \\Content-Type: text/plain
  \\Content-Disposition: ATTACHMENT; filename="../../etc/passwd"
  \\
  \\root
  \\--outer--

test "a message's bodies and its attachments are found through its parts" {
  let data = sent(mixed_message());
  let m = read(data, default_limits());
  assert_eq(text_body(m), Some(Text("caf\u{e9}")));
  assert_eq(html_body(m), Some(Text("<img src=\"cid:logo@example.org\">")));
  assert_eq(map(attachments(m), |a: Attachment| a.filename), [
    Some("logo.png"),
    Some("na\u{ef}ve resume.pdf"),
    Some("../../etc/passwd"),
  ]);
  assert_eq(map(attachments(m), |a: Attachment| show(a.content_type)), [
    "image/png",
    "application/pdf; name=fallback.pdf",
    "text/plain",
  ]);
  assert_eq(map(attachments(m), |a: Attachment| a.data), [
    b"\x89PNG\r\n\x1a\n",
    b"%PDF-1.4",
    b"root",
  ]);
  assert_eq(map(attachments(m), |a: Attachment| option_map(a.content_id, id_text)), [
    Some("<logo@example.org>"),
    None,
    None,
  ]);
  // A file name is data: the one way to a name on disk refuses to leave its directory.
  assert_eq(multipart::safe_filename("../../etc/passwd"), Some("passwd"));
  let attached = match list_at(parts(m), 1) { Some(p) -> disposition(p), None -> None };
  assert_eq(attached, Some({ kind: "attachment", filename: Some("na\u{ef}ve resume.pdf") }));
  assert_eq(disposition(m), None);
  assert_eq(content_id(m), None);
  assert_eq(map(from(m), |a: Mailbox| display_name(a)), [Some("J\u{fc}rgen")]);
  assert_eq(render(m), data)
}

test "a single part that is no text is an attachment, and a text part that is attached is no body" {
  let pdf = read(
    message_of(
      "Content-Type: application/pdf\r\nContent-Transfer-Encoding: base64\r\n",
      b"JVBERi0xLjQ=",
    ),
    default_limits(),
  );
  assert_eq(text_body(pdf), None);
  assert_eq(map(attachments(pdf), |a: Attachment| a.data), [b"%PDF-1.4"]);
  let note = read(
    message_of(
      "Content-Type: text/plain\r\nContent-Disposition: attachment; filename=note.txt\r\n",
      b"x",
    ),
    default_limits(),
  );
  assert_eq(text_body(note), None);
  assert_eq(map(attachments(note), |a: Attachment| a.filename), [Some("note.txt")]);
  let page = read(message_of("Content-Type: text/html\r\n", b"<p>x</p>"), default_limits());
  assert_eq(html_body(page), Some(Text("<p>x</p>")));
  assert_eq(text_body(page), None);
  assert_eq(attachments(page), [])
}

test "UTF-8 in a header is read where it is asked for, and is a defect where it is not" {
  let data = bytes_of_string(
    "Date: Fri, 21 Nov 1997 09:55:06 -0600\r\nFrom: J\u{fc}rgen M\u{fc}ller <j\u{fc}rgen@b\u{fc}cher.example>\r\nTo: \u{7528}\u{6237}@\u{4f8b}\u{3048}.jp\r\nSubject: Gr\u{fc}\u{df}e aus K\u{f6}ln\r\n\r\n",
  );
  let m = read(data, default_limits(), Utf8);
  assert_eq(map(from(m), |a: Mailbox| show(a)), [
    "J\u{fc}rgen M\u{fc}ller <j\u{fc}rgen@b\u{fc}cher.example>",
  ]);
  assert_eq(address_list_text(to(m)), "\u{7528}\u{6237}@\u{4f8b}\u{3048}.jp");
  assert_eq(subject(m), Some("Gr\u{fc}\u{df}e aus K\u{f6}ln"));
  assert_eq(render(m), data);
  let plain = read_tolerant(data, default_limits());
  assert_eq(map(plain.defects, |d: Refusal| d.why), [
    NonAscii,
    EightBitHeader,
    NonAscii,
    EightBitHeader,
    EightBitHeader,
  ]);
  assert_eq(from(plain.message), []);
  assert_eq(subject(plain.message), Some("Gr\u{fc}\u{df}e aus K\u{f6}ln"));
  assert_eq(result_map(parse(data, default_limits()), render), Err({ at: 39, why: NonAscii }))
}

test "RFC 8058's fields are read, and written of the same links" {
  let simple = read(
    message_of(
      "List-Unsubscribe: <https://example.com/unsubscribe/opaquepart>\r\nList-Unsubscribe-Post: List-Unsubscribe=One-Click\r\n",
      b"",
    ),
    default_limits(),
  );
  assert_eq(
    header(simple, "List-Unsubscribe"),
    Some("<https://example.com/unsubscribe/opaquepart>"),
  );
  assert_eq(header(simple, "List-Unsubscribe-Post"), Some("List-Unsubscribe=One-Click"));
  let complex = read(
    message_of(
      "List-Unsubscribe:\r\n    <mailto:listrequest@example.com?subject=unsubscribe>,\r\n    <https://example.com/unsubscribe.html?opaque=123456789>\r\nList-Unsubscribe-Post: List-Unsubscribe=One-Click\r\n",
      b"",
    ),
    default_limits(),
  );
  assert_eq(
    header(complex, "list-unsubscribe"),
    Some(
      "<mailto:listrequest@example.com?subject=unsubscribe>,    <https://example.com/unsubscribe.html?opaque=123456789>",
    ),
  );
  let d = list_unsubscribe(plain_draft(), [
    "mailto:listrequest@example.com?subject=unsubscribe",
    "https://example.com/unsubscribe.html?opaque=123456789",
  ]);
  assert_eq(map(d.fields, |f: Field| f.raw), [
    b"List-Unsubscribe: <mailto:listrequest@example.com?subject=unsubscribe>,\r\n <https://example.com/unsubscribe.html?opaque=123456789>\r\n",
    b"List-Unsubscribe-Post: List-Unsubscribe=One-Click\r\n",
  ]);
  let once = list_unsubscribe(d, ["https://example.com/unsubscribe/opaquepart"]);
  assert_eq(map(once.fields, |f: Field| f.value), [
    "<https://example.com/unsubscribe/opaquepart>",
    "List-Unsubscribe=One-Click",
  ]);
  assert_eq(
    try { list_unsubscribe(d, ["mailto:list@example.com"]) },
    Err({ at: 0, why: Unexpected }),
  );
  assert_eq(try { list_unsubscribe(d, []) }, Err({ at: 0, why: Unexpected }));
  assert_eq(
    try {
      list_unsubscribe(d, [
        "https://example.com/a",
        "https://example.com/b>,<mailto:eve@example.org",
      ])
    },
    Err({ at: 1, why: Unexpected }),
  );
  assert_eq(
    try { list_unsubscribe(d, ["https://example.com/a b"]) },
    Err({ at: 0, why: Unexpected }),
  )
}

fn when() -> OffsetDateTime / {abort.raise} =
  match date::parse_rfc3339("1997-11-21T09:55:06-06:00") {
    Some(at) -> at,
    None -> panic("no date"),
  }

/// RFC 5322 Appendix A.1.1's message as a draft, with no body yet.
fn plain_draft() -> Draft / {email.refused, abort.raise} =
  draft(
    named("John Doe", address("jdoe", "machine.example")),
    [named("Mary Smith", address("mary", "example.net"))],
    "Saying Hello",
    when(),
    message_id("1234", "local.machine.example"),
  )

fn greeting() -> String = "This is a message just to say hello.\nSo, \"Hello\".\n"

test "a text draft is written as RFC 5322's first example, with the fields MIME adds" {
  let d = with_text(plain_draft(), greeting());
  assert_eq(
    build(d, "unused"),
    Ok(
      b"Date: Fri, 21 Nov 1997 09:55:06 -0600\r\nFrom: John Doe <jdoe@machine.example>\r\nTo: Mary Smith <mary@example.net>\r\nSubject: Saying Hello\r\nMessage-ID: <1234@local.machine.example>\r\nMIME-Version: 1.0\r\nContent-Type: text/plain; charset=us-ascii\r\nContent-Transfer-Encoding: 7bit\r\n\r\nThis is a message just to say hello.\r\nSo, \"Hello\".\r\n",
    ),
  );
  let read_back = read(write(d, "unused"), default_limits());
  assert_eq(said(read_back), said(read(sent(simple_addressing()), default_limits())));
  assert_eq(drafted(read_back), Some(d));
  // RFC 5322's own message, which has no MIME fields, is a draft of the same text.
  assert_eq(drafted(read(sent(simple_addressing()), default_limits())), Some(d))
}

test "a draft of nothing but its fields has no body and no content type" {
  assert_eq(
    build(plain_draft(), "unused"),
    Ok(
      b"Date: Fri, 21 Nov 1997 09:55:06 -0600\r\nFrom: John Doe <jdoe@machine.example>\r\nTo: Mary Smith <mary@example.net>\r\nSubject: Saying Hello\r\nMessage-ID: <1234@local.machine.example>\r\nMIME-Version: 1.0\r\n\r\n",
    ),
  );
  assert_eq(drafted(read(write(plain_draft(), "unused"), default_limits())), Some(plain_draft()));
  let empty = with_text(plain_draft(), "");
  assert(empty != plain_draft());
  assert_eq(drafted(read(write(empty, "unused"), default_limits())), Some(empty))
}

test "a text and an HTML body are alternatives, inline parts are related, and attachments are mixed" {
  let logo: Attachment = {
    filename: Some("logo.png"),
    content_type: MediaType("image", "png", []),
    content_id: Some(message_id("logo", "machine.example")),
    data: b"\x89PNG\r\n\x1a\n",
  };
  let d = attach(
    inline(
      with_html(with_text(plain_draft(), "caf\u{e9}\n"), "<img src=\"cid:logo@machine.example\">"),
      logo,
    ),
    attachment("r\u{e9}sum\u{e9}.txt", b"plain\r\nlines\r\n"),
  );
  assert_eq(
    result_map(build(d, "b"), |data: Bytes|
      string_of_bytes(
        bytes_slice(
          data,
          match bytes_index_of(data, b"MIME-Version") { Some(i) -> i, None -> 0 },
          bytes_len(data),
        ),
      )),
    Ok(
      string::replace(
        \\MIME-Version: 1.0
        \\Content-Type: multipart/mixed; boundary=b
        \\
        \\--b
        \\Content-Type: multipart/alternative; boundary=2-b
        \\
        \\--2-b
        \\Content-Type: text/plain; charset=utf-8
        \\Content-Transfer-Encoding: base64
        \\
        \\Y2Fmw6kNCg==
        \\--2-b
        \\Content-Type: multipart/related; boundary=3-b
        \\
        \\--3-b
        \\Content-Type: text/html; charset=us-ascii
        \\Content-Transfer-Encoding: 7bit
        \\
        \\<img src="cid:logo@machine.example">
        \\--3-b
        \\Content-Type: image/png
        \\Content-Transfer-Encoding: base64
        \\Content-Disposition: inline; filename=logo.png
        \\Content-ID: <logo@machine.example>
        \\
        \\iVBORw0KGgo=
        \\--3-b--
        \\
        \\--2-b--
        \\
        \\--b
        \\Content-Type: text/plain
        \\Content-Transfer-Encoding: 7bit
        \\Content-Disposition: attachment; filename*=UTF-8''r%C3%A9sum%C3%A9.txt
        \\
        \\plain
        \\lines
        \\
        \\--b--
        \\
        ,
        "\n",
        "\r\n",
      ),
    ),
  );
  let m = read(write(d, "b"), default_limits());
  assert_eq(text_body(m), Some(Text("caf\u{e9}\n")));
  assert_eq(html_body(m), Some(Text("<img src=\"cid:logo@machine.example\">")));
  assert_eq(map(attachments(m), |a: Attachment| a.filename), [
    Some("logo.png"),
    Some("r\u{e9}sum\u{e9}.txt"),
  ]);
  assert_eq(drafted(m), Some(d))
}

test "a draft's other fields are written after its own, and none takes the name of one it writes" {
  let d = with_field(
    with_field(plain_draft(), field("X-Mailer", "ply")),
    text_field("Comments", "caf\u{e9}"),
  );
  assert_eq(map(d.fields, |f: Field| f.raw), [
    b"X-Mailer: ply\r\n",
    b"Comments: =?UTF-8?B?Y2Fmw6k=?=\r\n",
  ]);
  let m = read(write(d, "unused"), default_limits());
  assert_eq(map(fields(m), |f: Field| f.name), [
    "Date",
    "From",
    "To",
    "Subject",
    "Message-ID",
    "X-Mailer",
    "Comments",
    "MIME-Version",
  ]);
  assert_eq(unstructured(m, "comments"), Some("caf\u{e9}"));
  assert_eq(drafted(m), Some(d));
  assert_eq(
    map(
      ["From", "bcc", "SUBJECT", "Message-Id", "MIME-Version", "Content-Type", "content-anything"],
      |name: String|
        (try { with_field(plain_draft(), field(name, "x")) }) == Err({ at: 0, why: BadName }),
    ),
    [true, true, true, true, true, true, true],
  )
}

test "no value given to a draft adds a field to it" {
  let eve = "x\r\nBcc: eve@example.org";
  assert_eq(try { with_subject(plain_draft(), eve) }, Err({ at: 1, why: LineBreak }));
  assert_eq(
    try { draft(mailbox(jdoe()), [], eve, when(), message_id("a", "example.org")) },
    Err({ at: 1, why: LineBreak }),
  );
  assert_eq(try { named(eve, jdoe()) }, Err({ at: 1, why: LineBreak }));
  assert_eq(try { address(eve, "example.org") }, Err({ at: 1, why: LineBreak }));
  assert_eq(
    try { address("jdoe", "example.org>\r\nBcc: eve@example.org") },
    Err({ at: 11, why: BadDomain }),
  );
  assert_eq(try { message_id("a", eve) }, Err({ at: 1, why: BadMessageId }));
  assert_eq(try { field("X-A", eve) }, Err({ at: 1, why: LineBreak }));
  assert_eq(try { field(eve, "x") }, Err({ at: 1, why: BadName }));
  assert_eq(try { with_from(plain_draft(), []) }, Err({ at: 0, why: NoAddress }));
  // A file name and a body are data, and are written so that they stay data.
  let d = attach(with_text(plain_draft(), eve), attachment("a\r\nBcc: eve@example.org", b"x"));
  let m = read(write(d, "b"), default_limits());
  assert_eq(bcc(m), []);
  assert_eq(text_body(m), Some(Text("x\nBcc: eve@example.org")));
  assert_eq(map(attachments(m), |a: Attachment| a.filename), [Some("a\r\nBcc: eve@example.org")]);
  assert_eq(len(fields(m)), 7)
}

test "a blind copy is in the envelope, and in the bytes only where it is asked for" {
  let eve = mailbox(address("eve", "example.org"));
  let d = with_bcc(
    with_cc(plain_draft(), [
      group("Team", [mailbox(address("mary", "EXAMPLE.NET")), eve]),
      one(mailbox(jdoe())),
    ]),
    [one(eve), one(mailbox(address("frank", "example.org")))],
  );
  let sent_to = map(recipients(d), |a: Address| show(a));
  assert_eq(sent_to, [
    "mary@example.net",
    "eve@example.org",
    "jdoe@example.org",
    "frank@example.org",
  ]);
  let e = envelope(d);
  assert_eq(show(e.sender), "jdoe@machine.example");
  assert_eq(e.recipients, recipients(d));
  assert_eq(e.utf8, false);
  let dropped = read(write(d, "unused"), default_limits());
  assert_eq(bcc(dropped), []);
  assert_eq(header(dropped, "bcc"), None);
  assert_eq(
    header(dropped, "cc"),
    Some("Team: mary@EXAMPLE.NET, eve@example.org;, jdoe@example.org"),
  );
  let kept = read(write(d, "unused", Ascii, Kept), default_limits());
  assert_eq(address_list_text(bcc(kept)), "eve@example.org, frank@example.org");
  assert_eq(drafted(kept), Some(d));
  assert_eq(drafted(dropped), Some(with_bcc(d, [])));
  let sender = named("Michael Jones", address("mjones", "machine.example"));
  assert_eq(show(envelope(with_sender(d, sender)).sender), "mjones@machine.example");
  let far = with_to(d, [one(mailbox(address("\u{7528}\u{6237}", "example.org", Utf8)))]);
  assert_eq(envelope(far).utf8, true)
}

test "a domain outside ASCII is written as its A-labels unless UTF-8 is asked for, and needs no `SMTPUTF8`" {
  let a = address("a", "b\u{fc}cher.example", Utf8);
  let written = |utf8: Bool| result_map(try { addressed("To", [one(mailbox(a))], utf8) }, value_of);
  assert_eq(
    result_map(written(false), |v: String| string_contains(v, "a@xn--bcher-kva.example")),
    Ok(true),
  );
  assert_eq(
    result_map(written(true), |v: String| string_contains(v, "a@b\u{fc}cher.example")),
    Ok(true),
  );
  let d = with_sender(with_text(plain_draft(), "text\n"), mailbox(a));
  assert_eq(envelope(d).utf8, false);
  assert_eq(map(prepend(envelope(d).sender, []), ascii_text), [Some("a@xn--bcher-kva.example")]);
  assert(result_is_ok(build(d, "x")))
}

type Unwritten = { what: String, draft: Draft, boundary: String, why: Unwritable }

fn unwritten() -> List<Unwritten> / {email.refused, abort.raise} = {
  let d = with_text(plain_draft(), "text\n--b\n");
  let file: Attachment = {
    filename: None,
    content_type: MediaType("text", "plain", []),
    content_id: None,
    data: b"x",
  };
  [
    {
      what: "an address outside ASCII",
      draft: with_to(d, [one(mailbox(address("j\u{fc}rgen", "example.org", Utf8)))]),
      boundary: "x",
      why: NeedsUtf8,
    },
    {
      what: "a local part outside ASCII beside a domain outside it",
      draft: with_sender(d, mailbox(address("\u{e4}", "b\u{fc}cher.example", Utf8))),
      boundary: "x",
      why: NeedsUtf8,
    },
    {
      what: "a field outside ASCII",
      draft: with_field(d, field("X-Note", "caf\u{e9}", Utf8)),
      boundary: "x",
      why: NeedsUtf8,
    },
    { what: "inline parts and no HTML body", draft: inline(d, file), boundary: "x", why: NoHtml },
    {
      what: "an attachment that is multipart",
      draft: attach(attach(d, file), { ..file, content_type: MediaType("multipart", "mixed", []) }),
      boundary: "x",
      why: UnfitAttachment(1),
    },
    {
      what: "an attachment that is a message",
      draft: attach(inline(with_html(d, "x"), file), {
        ..file,
        content_type: MediaType("message", "rfc822", []),
      }),
      boundary: "x",
      why: UnfitAttachment(1),
    },
    {
      what: "an attachment whose type is no token",
      draft: attach(d, { ..file, content_type: MediaType("text", "pl\r\nain", []) }),
      boundary: "x",
      why: UnfitAttachment(0),
    },
    {
      what: "an attachment whose parameter is named as a section",
      draft: attach(d, {
        ..file,
        content_type: MediaType("text", "plain", [{ name: "a*0", value: "x" }]),
      }),
      boundary: "x",
      why: UnfitAttachment(0),
    },
    {
      what: "a boundary a part holds",
      draft: attach(d, file),
      boundary: "b",
      why: Framing(multipart::BoundaryInPart(0)),
    },
    {
      what: "a boundary that is none",
      draft: attach(d, file),
      boundary: "a\"b",
      why: Framing(multipart::UnfitBoundary),
    },
    {
      what: "a boundary too long to nest",
      draft: attach(with_html(d, "x"), file),
      boundary: string::repeat("a", 69),
      why: Framing(multipart::UnfitBoundary),
    },
  ]
}

test "does not write {c.what}" for c: Unwritten in unwritten() {
  assert_eq(build(c.draft, c.boundary), Err(c.why))
}

test "under UTF-8 a draft is written as it is, and read back" {
  let d = with_field(
    with_text(
      draft(
        named("J\u{fc}rgen M\u{fc}ller", address("j\u{fc}rgen", "b\u{fc}cher.example", Utf8)),
        [mailbox(address("\u{7528}\u{6237}", "\u{4f8b}\u{3048}.jp", Utf8))],
        "Gr\u{fc}\u{df}e",
        when(),
        message_id("1", "example.org"),
      ),
      "Gr\u{fc}\u{df}e\n",
    ),
    field("X-Note", "caf\u{e9}", Utf8),
  );
  let data = write(d, "unused", Utf8);
  assert_eq(
    string_of_bytes(data),
    "Date: Fri, 21 Nov 1997 09:55:06 -0600\r\nFrom: J\u{fc}rgen M\u{fc}ller <j\u{fc}rgen@b\u{fc}cher.example>\r\nTo: \u{7528}\u{6237}@\u{4f8b}\u{3048}.jp\r\nSubject: Gr\u{fc}\u{df}e\r\nMessage-ID: <1@example.org>\r\nX-Note: caf\u{e9}\r\nMIME-Version: 1.0\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Transfer-Encoding: base64\r\n\r\nR3LDvMOfZQ0K",
  );
  assert_eq(drafted(read(data, default_limits(), Utf8)), Some(d));
  assert_eq(envelope(d).utf8, true)
}

test "a draft composed now is dated by the clock and known by the host's entropy" {
  let composed = handle {
    try {
      compose(named("John Doe", address("jdoe", "machine.example")), [mailbox(jdoe())], "Hello")
    }
  } with {
    time.now_ms() -> 880127706123,
    entropy.next() -> 7,
  };
  assert_eq(result_map(composed, |d: Draft| show(d.date)), Ok("1997-11-21T15:55:06Z"));
  assert_eq(result_map(composed, |d: Draft| id_text(d.id)), Ok("<7-7@machine.example>"));
  let fresh = handle {
    build_fresh(attach(with_text(plain_draft(), "x"), attachment("a.bin", b"\x00\x01")))
  } with {
    entropy.next() -> 7,
  };
  assert_eq(
    result_map(fresh, |data: Bytes| show(content_type(read(data, default_limits())))),
    Ok("multipart/mixed; boundary=boundary-7-7"),
  )
}

fn build_fresh(d: Draft) -> Result<Bytes, Unwritable> / {entropy.next bounded, abort.raise} =
  try { write_fresh(d) }

test "the generators draw drafts of every shape" {
  let drawn = list::somes(
    map(range(0, 300), |root: Int| gen::sample(drafts(), root, b"shapes", root % 40, None).value),
  );
  let some = |ok: (Draft) -> Bool / {abort.raise}| any(drawn, ok);
  assert_eq(len(drawn), 300);
  assert(some(|d: Draft| d.text != None && d.html == None));
  assert(some(|d: Draft| d.text == None && d.html != None));
  assert(some(|d: Draft| d.text != None && d.html != None));
  assert(some(|d: Draft| d.text == None && d.html == None && len(d.attachments) == 0));
  assert(some(|d: Draft| d.text == None && d.html == None && len(d.attachments) > 0));
  assert(some(|d: Draft| len(d.inline) > 0 && len(d.attachments) > 0 && d.text != None));
  assert(some(|d: Draft| d.subject == None));
  assert(some(|d: Draft| match d.subject { Some(s) -> string_len(s) > 998, None -> false }));
  assert(some(|d: Draft| !envelope(d).utf8 && len(d.fields) == 0));
  assert(some(|d: Draft| envelope(d).utf8));
  assert(some(|d: Draft| any(d.to, |e: Entry| group_name(e) != None)));
  assert(some(|d: Draft| len(d.bcc) > 0 && len(d.references) > 0 && d.sender != None));
  assert(some(|d: Draft| result_is_ok(build(d, "boundary"))));
  assert(some(|d: Draft| build(d, "boundary") == Err(NeedsUtf8)))
}

/// Limits no message a law draws comes near.
fn roomy() -> Limits =
  {
    max_bytes: 1073741824,
    max_fields: 100000,
    max_header_bytes: 16777216,
    max_depth: 64,
    max_parts: 100000,
  }

law "a draft written and read strictly is the draft, and what was read is rendered as the bytes written"
  forall (d: Draft) {
    match build(d, "boundary", Utf8, Kept) {
      Err(_) -> false,
      Ok(data) -> match parse(data, roomy(), Utf8) {
        Ok(m) -> drafted(m) == Some(d) && render(m) == data,
        Err(_) -> false,
      },
    }
  }

law "a draft written in ASCII is read back without its blind copies, or holds an address or a field outside ASCII"
  forall (d: Draft) {
    match build(d, "boundary") {
      Err(why) ->
        why == NeedsUtf8
          && (!all(push(envelope(d).recipients, envelope(d).sender), is_ascii)
          || !all(mailboxes_of(concat(each(d.from), d.reply_to)), |m: Mailbox|
            is_ascii(address_of(m)))
          || any(d.fields, |f: Field| scan_until(f.raw, 0, high()) < bytes_len(f.raw))),
      Ok(data) -> match parse(data, roomy()) {
        Ok(m) ->
          drafted(m) == Some(with_bcc(d, [])) && scan_until(data, 0, high()) >= bytes_len(data),
        Err(_) -> false,
      },
    }
  }

law "no subject and no name writes a line break of its own, a line past 998 octets or a second field"
  forall (topic: String, name: String) {
    match try {
        draft(
          named(name, jdoe()),
          [named(name, jdoe())],
          topic,
          when(),
          message_id("a", "example.org"),
        )
      } {
      Err(_) -> !is_quotable(topic) || !is_quotable(name),
      Ok(d) -> match build(d, "unused") {
        Err(_) -> false,
        Ok(data) -> match parse(data, roomy()) {
          Err(_) -> false,
          Ok(m) ->
            len(line_defects(data, 0)) == 0 && len(fields(m)) == 6 && subject(m) == Some(topic)
              && map(from(m), display_name) == [if name == "" { None } else { Some(name) }],
        },
      },
    }
  }

law "any bytes are read tolerantly, and rendered as they were"
  forall (data: Bytes) {
    let wrapped = bytes_concat_all([
      b"Content-Type: multipart/mixed; boundary=b\r\n\r\n--b\r\n",
      data,
      b"\r\n--b\r\nContent-Type: multipart/mixed; boundary=c\r\n\r\n--c\r\n",
      data,
      b"\r\n--b--\r\n",
    ]);
    all([data, wrapped], |given: Bytes|
      all([Ascii, Utf8], |repertoire: Repertoire|
        match parse_tolerant(given, default_limits(), repertoire) {
          Ok(read) ->
            render(read.message) == given
              && all(read.defects, |d: Refusal| d.at >= 0 && d.at <= bytes_len(given))
              && len(read.defects) == 0 == result_is_ok(parse(given, default_limits(), repertoire)),
          Err(_) -> false,
        }))
  }

law "bytes past a limit are refused at one of them, and bytes within the limits are read"
  forall (data: Bytes, small: Int) {
    let n = small % 8;
    let limits: Limits = {
      max_bytes: 4 * n,
      max_fields: n,
      max_header_bytes: 3 * n,
      max_depth: n % 2,
      max_parts: n,
    };
    match parse_tolerant(data, limits) {
      Ok(read) -> render(read.message) == data && bytes_len(data) <= max(4 * n, 0),
      Err(r) ->
        r.at >= 0 && r.at <= bytes_len(data)
          && list::contains(
            [TooLarge, TooManyFields, HeadersTooLarge, TooDeep, TooManyParts],
            r.why,
          ),
    }
  }

/// RFC 6376 §3.4.5's message.
fn signed_message() -> Bytes = b"A: X\r\nB : Y\t\r\n\tZ  \r\n\r\n C \r\nD \t E\r\n\r\n\r\n"

test "RFC 6376's examples are canonical in each form" {
  let m = read_tolerant(signed_message(), default_limits()).message;
  let head = |form: Canonical|
    bytes_concat_all(map(fields(m), |f: Field| canonical_field(f, form)));
  assert_eq(head(Relaxed), b"a:X\r\nb:Y Z\r\n");
  assert_eq(canonical_body(body(m), Relaxed), b" C\r\nD E\r\n");
  assert_eq(head(Simple), b"A: X\r\nB : Y\t\r\n\tZ  \r\n");
  assert_eq(canonical_body(body(m), Simple), b" C \r\nD \t E\r\n")
}

test "a body of nothing is a line break in the simple form and nothing in the relaxed one" {
  assert_eq(canonical_body(b"", Simple), b"\r\n");
  assert_eq(canonical_body(b"\r\n\r\n", Simple), b"\r\n");
  assert_eq(canonical_body(b"", Relaxed), b"");
  assert_eq(canonical_body(b"\r\n \t\r\n", Relaxed), b"");
  assert_eq(canonical_body(b"a", Simple), b"a\r\n");
  assert_eq(canonical_body(b"a", Relaxed), b"a\r\n");
  assert_eq(canonical_body(b"a\r\n\r\nb \r\n\r\n", Simple), b"a\r\n\r\nb \r\n");
  assert_eq(canonical_body(b"a\r\n\r\nb \r\n\r\n", Relaxed), b"a\r\n\r\nb\r\n");
  assert_eq(canonical_body(b"\ta  b\t", Relaxed), b" a b\r\n");
  let folded_field = field("Subject", string::repeat("word ", 30));
  assert_eq(
    canonical_field(folded_field, Relaxed),
    bytes_of_string("subject:" ++ string::repeat("word ", 29) ++ "word\r\n"),
  );
  assert_eq(canonical_field(folded_field, Simple), folded_field.raw)
}

law "a canonical form of a body is settled"
  forall (payload: Bytes) {
    all([Simple, Relaxed], |form: Canonical|
      canonical_body(canonical_body(payload, form), form) == canonical_body(payload, form))
  }

test "a message is read in steps that grow with its lines and its parts, not its bytes" {
  let small = message_of("", bytes::repeat(b"x", 900));
  let large = message_of(
    "",
    bytes_concat_all(map(range(0, 1000), |_: Int| bytes_concat(bytes::repeat(b"x", 900), b"\r\n"))),
  );
  let one = metered(|| parse(small, roomy()));
  let many = metered(|| parse(large, roomy()));
  assert(result_is_ok(one.value) && result_is_ok(many.value));
  assert(many.steps - one.steps < 20000, Some(int_to_string(many.steps - one.steps)))
}
