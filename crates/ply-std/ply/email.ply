//! Internet mail: addresses, and messages read and written (RFC 5322 and MIME).
//!
//! An `Address` is a local part and a domain, a `Mailbox` an address under a display name, and an
//! `Entry` of an address list a mailbox or a named group of them. Each is built only here, by a
//! maker or a reader, so none holds a line break, a control character or an `@` that is not its
//! one separator: a text that reads as two addresses to one reader and one to another is refused,
//! never repaired. Two addresses are `==` when their local parts are the same text, case and all,
//! and their domains are one name: they differ at most in the case of ASCII letters and in
//! whether an internationalized label is written in its script or as its A-label, so
//! `user@b\u{fc}cher.example` is `user@xn--bcher-kva.example`. `read_address_list` is the one
//! parser of RFC 5322 §3.4: display names as atoms, quoted strings and encoded words, angle
//! addresses, groups, comments wherever the grammar admits them, which are read and dropped,
//! quoted local parts and domain literals, whose text is kept as written. Under `Obsolete` it also
//! takes §4's syntax, which a reader of mail must: a route in an angle address is read and
//! dropped, and empty list elements, periods in a display name and blanks around the dots of an
//! address are passed over. A domain is host names' letters, digits and hyphens; UTF-8 in a local
//! part, a domain or a display name (RFC 6531, RFC 6532) is read only under `Utf8` and refused
//! by reason otherwise. A domain with a label outside ASCII, or one that opens `xn--`, is a
//! domain name as `std.idna` reads one or is refused with what it found wrong. An address keeps
//! its domain as written, and `show` writes it so; `ascii_domain` is its A-labels, which is what
//! a writer under `Ascii` writes and what a path without `SMTPUTF8` carries, so only a local
//! part outside ASCII needs `Utf8`. With `import std.email`, `email"jdoe@example.org"` is an
//! `Address` checked with the program.
//!
//! A `Message` is header fields in the order written and a body, and holds the bytes it was read
//! from: each `Field` keeps its lines as they were beside its unfolded value, so `render` of a
//! message read is the bytes read, which a signature depends on. `read` is strict: it takes what
//! a conforming writer writes and refuses anything else with a `Refusal` saying where and why.
//! `read_tolerant` reads mail as it is found and answers the message with every defect `read`
//! would have refused it for; it refuses only a message past its `Limits`, which every reader
//! takes. The typed readers (`from`, `to`, `date`, `id`, `subject`, `content_type` and the rest)
//! answer what a field holds, or nothing where its value does not read. A body is a tree:
//! `parts` are a multipart entity's, found by `std.multipart`; `content` undoes a part's transfer
//! encoding; `text` reads it in its charset, one of `std.encoded_word`'s, and answers the bytes
//! with the charset's name for any other, never a guess; `text_body`, `html_body` and
//! `attachments` find what a person would call those. A file name is data a sender chose, never
//! a path: `std.multipart`'s `safe_filename` is the one way to a name on disk.
//!
//! A `Draft` is a message to write, of typed parts: mailboxes, a subject, a date, an id, a text
//! and an HTML body, inline images and attachments. Nothing of it is written as it is given: text
//! outside ASCII goes out in encoded words, lines fold at 78 octets and never pass 998, a body's
//! transfer encoding is chosen from its bytes, and a value that holds a line break is refused
//! where it is set, so no value can add a field. The date, the id and the boundary are
//! arguments; `compose` and `write_fresh` take them from `time` and `entropy`. `write` leaves
//! `Bcc` out unless asked, and `envelope` answers who the message goes to.
//!
//! `canonical_field` and `canonical_body` are RFC 6376's `simple` and `relaxed` forms, which a
//! DKIM signature is taken over; the signature itself is not here.

import std.base64 (base64_decode, base64_encode)
import std.bytes
import std.bytes (peek, replace, scan, scan_until)
import std.date
import std.date (OffsetDateTime)
import std.encoded_word
import std.encoded_word (Literal, Piece, Word, encode_words, is_blank, pieces)
import std.gen
import std.gen (Gen)
import std.idna
import std.list
import std.list (all, any, concat, enumerate, find, first, flat_map, last, prepend, push_unique,
                 sort_by)
import std.mime
import std.mime (MediaType, Param, is_quotable, is_token)
import std.multipart
import std.multipart (Lenient, Span, Written)
import std.option (option_map)
import std.quoted_printable
import std.random (entropy, nonce)
import std.result (result_is_ok, result_map, result_ok)
import std.show (show)
import std.string
import std.string (ascii_lower, join)
import std.time (time)

// --- What is admitted, and what is refused -----------------------------------

/// The characters an address, a display name and a field's value may hold as themselves.
pub type Repertoire =
  /// ASCII alone, which every mail system carries. A writer puts other text in encoded words
  /// where a field admits them, and refuses an address that holds any.
  | Ascii
  /// UTF-8 too, as RFC 6531 and RFC 6532 have it. Only a path that offers `SMTPUTF8` carries
  /// such a message.
  | Utf8

/// Which of RFC 5322's grammars a reader takes.
pub type Syntax =
  /// §3's alone: what a conforming writer writes.
  | Current
  /// §4's obsolete syntax too, and what mail in the wild does with encoded words beside: one
  /// inside a quoted string is decoded, and one may touch the `<` or `:` after it.
  | Obsolete

/// Why a text is refused, or what is wrong with a message a tolerant reader took.
pub type Why =
  /// Nothing where an address must stand.
  | NoAddress
  /// Words with no `@` and no angle address after them.
  | NoAt
  /// A local part that is neither atoms between single dots nor a quoted string, or one that
  /// holds an `@` in its quotes.
  | BadLocalPart
  /// A domain that is neither host labels between single dots nor a literal in brackets.
  | BadDomain
  /// A domain with a label outside ASCII, or one that opens `xn--`, that is no domain name:
  /// each thing `std.idna` finds wrong with it, by its label.
  | BadIdna(List<idna::Problem>)
  /// A quoted string that never closes.
  | Unclosed
  /// A comment that never closes.
  | UnclosedComment
  /// An angle address with no `>` after it.
  | UnclosedAngle
  /// A group with no `;` after it.
  | UnclosedGroup
  /// A character that cannot stand where it does.
  | Unexpected
  /// A control character other than a tab.
  | Control
  /// A carriage return or a line feed inside a value.
  | LineBreak
  /// A character outside ASCII, where `Utf8` is not asked for.
  | NonAscii
  /// Syntax RFC 5322 §4 calls obsolete, where `Current` is asked for.
  | ObsoleteSyntax
  /// A local part, a domain, a name or a stretch of text longer than a line can hold.
  | TooLong
  /// An encoded word that cannot be read or that carries a control character, which a tolerant
  /// reader leaves as written; or one with no blank between it and the `<` or `:` after it,
  /// which RFC 2047 requires.
  | BadEncodedWord
  /// A field's name that is no name, or one a draft writes itself.
  | BadName
  /// A message identifier that is not `<` and `>` around text without blanks.
  | BadMessageId
  /// A `Date` field that is no RFC 5322 date.
  | BadDate
  /// A `Content-Type` that is no media type, or whose parameters do not join.
  | BadMediaType
  /// A `Content-Disposition` that does not read.
  | BadDisposition
  /// A `Content-Transfer-Encoding` this module does not undo, or one a multipart entity may not
  /// have, with its name.
  | BadEncoding(String)
  /// A body that is not in the transfer encoding it names.
  | BadTransferData
  /// A byte past 127 in a body whose transfer encoding is `7bit`, named or by default.
  | Undeclared8Bit
  /// A byte past 127 in a header field, where `Utf8` is not asked for or the field is not UTF-8.
  | EightBitHeader
  /// A line of a header block that is neither a field nor the continuation of one: the block
  /// ends before it, with no blank line, and the body starts with it.
  | NoBlankLine
  /// A line feed with no carriage return before it.
  | BareLineFeed
  /// A carriage return with no line feed after it.
  | BareCarriageReturn
  /// A line longer than 998 octets.
  | LongLine
  /// A header field with no line break after it: the message ends inside its header block.
  | Truncated
  /// A field every message has that this one lacks, with its name in lower case.
  | Missing(String)
  /// A field a message has at most once that this one has again, with its name in lower case.
  | Repeated(String)
  /// A multipart body with no closing delimiter: its last part runs to the body's end.
  | UnclosedBoundary
  /// A multipart body `std.multipart` refuses, and why. A tolerant reader keeps it as one part.
  | BadMultipart(multipart::Why)
  /// The message is longer than `Limits.max_bytes`.
  | TooLarge
  /// A header block has more fields than `Limits.max_fields`.
  | TooManyFields
  /// A header block is longer than `Limits.max_header_bytes`.
  | HeadersTooLarge
  /// Multipart bodies nest deeper than `Limits.max_depth`.
  | TooDeep
  /// The message has more parts than `Limits.max_parts`.
  | TooManyParts

/// A refusal, or a defect of a message read: the byte it was found at, and why. For a field whose
/// value does not read, the byte is the field's first.
pub type Refusal = { at: Int, why: Why }

/// Why a draft has no bytes.
pub type Unwritable =
  /// An address or a field holds a character outside ASCII, and `Utf8` is not asked for.
  | NeedsUtf8
  /// The draft has inline parts and no HTML body to show them in.
  | NoHtml
  /// The attachment of this index, counting the inline ones and then the attached, has a media
  /// type that is `multipart` or `message`, or that no `Content-Type` field can carry.
  | UnfitAttachment(Int)
  /// The parts cannot be set apart under the boundary given, as `std.multipart` says why.
  | Framing(multipart::Unwritable)

/// What this module raises where it refuses.
pub effect email {
  /// The text is no address, or the bytes no message, this module reads.
  raise refused(e: Refusal)
  /// The draft cannot be written.
  raise unwritable(why: Unwritable)
}

fn refuse<a>(at: Int, why: Why) -> a / {email.refused} = email.refused({ at: at, why: why })

/// What a refusal says in words.
pub fn explain(why: Why) -> String =
  match why {
    NoAddress -> "an address is expected here",
    NoAt -> "an `@` or an address in angle brackets is expected here",
    BadLocalPart -> "a local part is atoms between single dots, or a quoted string",
    BadDomain ->
      "a domain is labels of letters, digits and hyphens between single dots, or a literal in brackets",
    BadIdna(problems) ->
      "no internationalized domain name: "
        ++ (match problems { [found, ..] -> idna::reason(found.why), [] -> "it converts to none" }),
    Unclosed -> "the quoted string never closes",
    UnclosedComment -> "the comment never closes",
    UnclosedAngle -> "a `>` is expected here",
    UnclosedGroup -> "a `;` is expected to end the group",
    Unexpected -> "this cannot stand here",
    Control -> "a control character other than a tab",
    LineBreak -> "a line break inside a value",
    NonAscii -> "a character outside ASCII, which only `Utf8` admits",
    ObsoleteSyntax -> "obsolete syntax, which only `Obsolete` admits",
    TooLong -> "longer than a line can hold",
    BadEncodedWord -> "an encoded word that cannot be read",
    BadName -> "no name a field of this kind may have",
    BadMessageId -> "a message identifier is `<`, text without blanks and `>`",
    BadDate -> "no RFC 5322 date",
    BadMediaType -> "no media type",
    BadDisposition -> "no content disposition",
    BadEncoding(name) -> "the transfer encoding `" ++ name ++ "` cannot be used here",
    BadTransferData -> "the body is not in its transfer encoding",
    Undeclared8Bit -> "a byte past 127 in a 7bit body",
    EightBitHeader -> "a byte past 127 in a header field",
    NoBlankLine -> "a line that is no header field, with no blank line before it",
    BareLineFeed -> "a line feed with no carriage return before it",
    BareCarriageReturn -> "a carriage return with no line feed after it",
    LongLine -> "a line longer than 998 octets",
    Truncated -> "the message ends inside a header field",
    Missing(name) -> "the message has no `" ++ name ++ "` field",
    Repeated(name) -> "the message has a second `" ++ name ++ "` field",
    UnclosedBoundary -> "the multipart body has no closing delimiter",
    BadMultipart(_) -> "the multipart body cannot be read",
    TooLarge -> "the message is larger than the limit",
    TooManyFields -> "more header fields than the limit",
    HeadersTooLarge -> "a header block larger than the limit",
    TooDeep -> "parts nested deeper than the limit",
    TooManyParts -> "more parts than the limit",
  }

// --- Characters ---------------------------------------------------------------

/// RFC 5322's `atext`: what an atom is made of.
fn atext() -> Bytes =
  b"!#$%&'*+-/0123456789=?ABCDEFGHIJKLMNOPQRSTUVWXYZ^_`abcdefghijklmnopqrstuvwxyz{|}~"

/// What a host name's label is made of.
fn label_chars() -> Bytes = b"-0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"

fn printable() -> Bytes =
  b" !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"

/// RFC 5322's `dtext`: what a domain literal holds between its brackets.
fn dtext() -> Bytes =
  b"!\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ^_`abcdefghijklmnopqrstuvwxyz{|}~"

/// RFC 5322's `ftext`: what a field's name is made of.
fn ftext() -> Bytes =
  b"!\"#$%&'()*+,-./0123456789;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"

/// What a message identifier holds between its angle brackets.
fn id_chars() -> Bytes =
  b"!\"#$%&'()*+,-./0123456789:;=?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"

/// Every control character but a tab.
fn controls() -> Bytes =
  b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f\x7f"

/// Every byte past 127.
const fn high() -> Bytes = bytes_concat_all(map(range(128, 256), byte_of_int))

const fn atext_wide() -> Bytes = bytes_concat(atext(), high())

const fn label_wide() -> Bytes = bytes_concat(label_chars(), high())

const fn printable_wide() -> Bytes = bytes_concat(printable(), high())

/// What ends a run of plain text in a quoted string, where every byte past 127 is text.
const fn quoted_stops() -> Bytes = bytes_concat(b"\"\\", controls())

/// What ends a run of plain text in a quoted string that holds ASCII alone.
const fn quoted_stops_ascii() -> Bytes = bytes_concat(quoted_stops(), high())

// --- Reading: the pieces of an address ---------------------------------------

/// A text being read, and what its reader admits.
type Cx = { b: Bytes, utf8: Bool, obsolete: Bool }

fn cx_of(text: String, repertoire: Repertoire, syntax: Syntax) -> Cx =
  { b: bytes_of_string(text), utf8: repertoire == Utf8, obsolete: syntax == Obsolete }

fn atoms(cx: Cx) -> Bytes = if cx.utf8 { atext_wide() } else { atext() }

/// Why the byte at `at` cannot stand where it does.
fn stray(cx: Cx, at: Int) -> Why / {abort.raise} = {
  let c = peek(cx.b, at);
  if c == b'\r' || c == b'\n' { LineBreak }
  else if (c >= 0 && c < 32 && c != b'\t') || c == 127 { Control }
  else if c > 127 && !cx.utf8 { NonAscii }
  else { Unexpected }
}

/// Why the byte at `at` cannot stand where it does: `otherwise` where the byte itself is one a
/// value may hold.
fn unfit(cx: Cx, at: Int, otherwise: Why) -> Why / {abort.raise} =
  match stray(cx, at) { Unexpected -> otherwise, found -> found }

/// Whether a comment or a quoted string may hold the byte `c` as itself, or after a backslash.
fn is_text(cx: Cx, c: Int) -> Bool = c == b'\t' || (c >= 32 && c < 127) || (c > 127 && cx.utf8)

/// Where the blanks and comments from `at` end. Comments nest, and a backslash in one takes the
/// character after it.
fn cfws(cx: Cx, at: Int) -> Int / {email.refused, abort.raise} =
  blank(cx, at, 0, bytes_len(cx.b) - at + 1)

/// `depth` counts the comments open at `at`. `left` bounds the rounds: each takes a character.
fn blank(cx: Cx, at: Int, depth: Int, left: Int) -> Int / {email.refused, abort.raise} = {
  let c = peek(cx.b, at);
  if left <= 0 { at } else if depth > 0 {
    let opened = if c == b'(' { 1 } else if c == b')' { -1 } else { 0 };
    blank(cx, at + commented(cx, at), depth + opened, left - 1)
  } else if bytes::is_blank(c) { blank(cx, at + 1, 0, left - 1) }
  else if c == b'(' { blank(cx, at + 1, 1, left - 1) }
  else { at }
}

/// How many bytes the character of a comment at `at` takes: two for a backslash and what it
/// takes. Raises where the comment ends unclosed, and for a character no comment holds.
fn commented(cx: Cx, at: Int) -> Int / {email.refused, abort.raise} = {
  let c = peek(cx.b, at);
  if c < 0 { refuse(at, UnclosedComment) }
  else if c != b'\\' { if is_text(cx, c) { 1 } else { refuse(at, stray(cx, at)) } }
  else if peek(cx.b, at + 1) < 0 { refuse(at + 1, UnclosedComment) }
  else if !is_text(cx, peek(cx.b, at + 1)) { refuse(at + 1, stray(cx, at + 1)) }
  else { 2 }
}

/// A text read, and where its reader stands after it.
type Text = { text: String, at: Int }

/// The quoted string whose opening quote stands at `at`: what it holds, each backslash pair as
/// the character after the backslash.
fn quoted(cx: Cx, at: Int) -> Text / {email.refused, abort.raise} =
  quoted_from(cx, at + 1, [], bytes_len(cx.b) - at + 1)

/// `left` bounds the rounds: each takes a backslash pair.
fn quoted_from(
  cx: Cx,
  at: Int,
  kept: List<Bytes>,
  left: Int,
) -> Text / {email.refused, abort.raise} = {
  let stop = scan_until(cx.b, at, if cx.utf8 { quoted_stops() } else { quoted_stops_ascii() });
  let so_far = push(kept, bytes_slice(cx.b, at, stop));
  let c = peek(cx.b, stop);
  if c == b'"' { { text: string_of_bytes(bytes_concat_all(so_far)), at: stop + 1 } }
  else if c < 0 || left <= 0 { refuse(stop, Unclosed) }
  else if c != b'\\' { refuse(stop, stray(cx, stop)) }
  else if peek(cx.b, stop + 1) < 0 { refuse(stop + 1, Unclosed) }
  else if !is_text(cx, peek(cx.b, stop + 1)) { refuse(stop + 1, stray(cx, stop + 1)) }
  else { quoted_from(cx, stop + 2, push(so_far, bytes_slice(cx.b, stop + 1, stop + 2)), left - 1) }
}

/// One token of the words an address opens with.
type Tok = | Atom(String) | Quoted(String) | Dot

/// A token, where it starts and ends, and whether blanks or a comment stood before it.
type Seen = { tok: Tok, at: Int, end: Int, spaced: Bool }

/// The words an address opens with, and where the text stands after them and the blanks behind
/// them.
type Run = { toks: List<Seen>, at: Int }

/// The atoms, quoted strings and dots from `at`, which are a display name or a local part by
/// what stands after them.
fn run(cx: Cx, at: Int) -> Run / {email.refused, abort.raise} =
  run_from(cx, { toks: [], at: at }, bytes_len(cx.b) - at + 1)

/// `left` bounds the rounds: each takes a token.
fn run_from(cx: Cx, r: Run, left: Int) -> Run / {email.refused, abort.raise} = {
  let start = cfws(cx, r.at);
  let c = peek(cx.b, start);
  let spaced = start > r.at;
  if left <= 0 { { toks: r.toks, at: start } } else if c == b'"' {
    let q = quoted(cx, start);
    run_from(cx, with_tok(r, Quoted(q.text), start, q.at, spaced), left - 1)
  } else if c == b'.' { run_from(cx, with_tok(r, Dot, start, start + 1, spaced), left - 1) } else {
    let end = scan(cx.b, start, atoms(cx));
    if end == start { { toks: r.toks, at: start } } else {
      run_from(
        cx,
        with_tok(r, Atom(string_of_bytes(bytes_slice(cx.b, start, end))), start, end, spaced),
        left - 1,
      )
    }
  }
}

fn with_tok(r: Run, tok: Tok, at: Int, end: Int, spaced: Bool) -> Run =
  { toks: push(r.toks, { tok: tok, at: at, end: end, spaced: spaced }), at: end }

fn is_dot(t: Seen) -> Bool = match t.tok { Dot -> true, _ -> false }

fn tok_text(t: Seen) -> String =
  match t.tok { Atom(text) -> text, Quoted(text) -> text, Dot -> "." }

/// The local part the words `toks` are, which started at `at`: a word, then a dot and a word any
/// number of times.
fn local_of(cx: Cx, toks: List<Seen>, at: Int) -> String / {email.refused, abort.raise} =
  match find(enumerate(toks), |t: { index: Int, value: Seen }|
      t.index % 2 == 0 == is_dot(t.value)) {
    Some(odd) -> refuse(odd.value.at, BadLocalPart),
    None -> match last(toks) {
      None -> refuse(at, BadLocalPart),
      Some(end) -> if is_dot(end) { refuse(end.at, BadLocalPart) }
      else if !cx.obsolete && !is_current_local(toks) { refuse(at, ObsoleteSyntax) }
      else { local_checked(join(map(toks, tok_text), ""), cx.utf8, at) },
    },
  }

/// Whether a local part's words are RFC 5322 §3's: one quoted string, or atoms and dots with no
/// blank between them.
fn is_current_local(toks: List<Seen>) -> Bool =
  match toks {
    [_] -> true,
    [_, ..rest] ->
      all(toks, |t: Seen| match t.tok { Quoted(_) -> false, _ -> true })
        && all(rest, |t: Seen| !t.spaced),
    [] -> false,
  }

/// `local` where it is one a local part may be: printable characters but `@`, and at most 255
/// octets.
fn local_checked(local: String, utf8: Bool, at: Int) -> String / {email.refused, abort.raise} = {
  let b = bytes_of_string(local);
  let stop = scan(b, 0, if utf8 { printable_wide() } else { printable() });
  let second = scan_until(b, 0, b"@");
  if stop < bytes_len(b) {
    refuse(at + stop, unfit({ b: b, utf8: utf8, obsolete: false }, stop, Control))
  } else if second < bytes_len(b) { refuse(at + second, BadLocalPart) }
  else if bytes_len(b) > 255 { refuse(at, TooLong) }
  else { local }
}

/// A domain as written, what every spelling of it shares, and where the text stands after it.
type Domain = { text: String, key: String, at: Int }

/// The checks a mail domain is held to where `std.idna` reads it: a host name's, the hyphens
/// third and fourth apart, which a label in ASCII alone is not held to either.
fn host_checks() -> idna::Options =
  {
    check_hyphens: false,
    check_bidi: true,
    check_joiners: true,
    use_std3_ascii_rules: true,
    verify_dns_length: true,
  }

/// What every spelling of the name `labels` join to shares, which addresses are compared by:
/// the name in lower case where it is ASCII, and the A-labels `std.idna` makes of one with a
/// label outside ASCII or one that opens `xn--`. Raises `email.refused` at `at` where it makes
/// none.
fn name_key(labels: List<String>, name: String, at: Int) -> String / {email.refused, abort.raise} = {
  let coded = any(labels, |l: String| string_starts_with(ascii_lower(l), "xn--"));
  if string::is_ascii(name) && !coded { ascii_lower(name) } else {
    match idna::to_ascii(name, host_checks()) {
      Ok(wire) -> wire,
      Err(problems) -> refuse(at, BadIdna(problems)),
    }
  }
}

/// The domain that starts at `start`.
fn domain_from(cx: Cx, start: Int) -> Domain / {email.refused, abort.raise} =
  if peek(cx.b, start) == b'[' {
    let literal = bracketed(cx, start);
    { text: literal.text, key: ascii_lower(literal.text), at: literal.at }
  } else {
    let read = labels(cx, { at: start, held: [] }, bytes_len(cx.b) - start + 1);
    let name = join(read.held, ".");
    if !all(read.held, is_label) { refuse(start, BadDomain) }
    else if bytes_len(bytes_of_string(name)) > 255 { refuse(start, TooLong) }
    else { { text: name, key: name_key(read.held, name, start), at: read.at } }
  }

type Labels = { at: Int, held: List<String> }

/// The atoms between dots from `s.at`. `left` bounds the rounds: each takes an atom.
fn labels(cx: Cx, s: Labels, left: Int) -> Labels / {email.refused, abort.raise} = {
  let end = scan(cx.b, s.at, atoms(cx));
  if end == s.at { refuse(s.at, unfit(cx, s.at, BadDomain)) } else {
    let held = push(s.held, string_of_bytes(bytes_slice(cx.b, s.at, end)));
    let dot = cfws(cx, end);
    if left <= 0 || peek(cx.b, dot) != b'.' { { at: end, held: held } } else {
      let next = cfws(cx, dot + 1);
      if (dot > end || next > dot + 1) && !cx.obsolete { refuse(end, ObsoleteSyntax) }
      else { labels(cx, { at: next, held: held }, left - 1) }
    }
  }
}

/// Whether `label` is one a host name has: letters, digits and hyphens, and under `Utf8` any
/// character outside ASCII; at most 63 octets, with no hyphen first or last.
fn is_label(label: String) -> Bool / {abort.raise} = {
  let b = bytes_of_string(label);
  let n = bytes_len(b);
  n > 0 && n <= 63 && scan(b, 0, label_wide()) == n && bytes_at(b, 0) != b'-'
    && bytes_at(b, n - 1) != b'-'
}

/// The domain literal whose `[` stands at `at`, with its brackets and without the blanks RFC
/// 5322 admits after the one and before the other. A blank inside it is refused: what stands
/// between the brackets is one address, and no reader should have to decide whether it is two.
fn bracketed(cx: Cx, at: Int) -> Text / {email.refused, abort.raise} = {
  let from = scan(cx.b, at + 1, b" \t");
  let end = scan(cx.b, from, dtext());
  let close = scan(cx.b, end, b" \t");
  if peek(cx.b, close) != b']' { refuse(close, unfit(cx, close, BadDomain)) }
  else if end == from { refuse(at, BadDomain) }
  else if end - from > 253 { refuse(at, TooLong) }
  else { { text: "[" ++ string_of_bytes(bytes_slice(cx.b, from, end)) ++ "]", at: close + 1 } }
}

/// The domain after the `@` at `at - 1`, with the blanks and comments around it passed over.
fn domain_at(cx: Cx, at: Int) -> Domain / {email.refused, abort.raise} = {
  let d = domain_from(cx, cfws(cx, at));
  { text: d.text, key: d.key, at: cfws(cx, d.at) }
}

type Spec = { address: Address, at: Int }

/// The address whose local part is the words `r`, which started at `from`, and whose `@` stands
/// at `r.at`.
fn spec(cx: Cx, r: Run, from: Int) -> Spec / {email.refused, abort.raise} = {
  let local = local_of(cx, r.toks, from);
  let d = domain_at(cx, r.at + 1);
  { address: Address(local, d.text, d.key), at: d.at }
}

/// The address in the angle brackets that open at `at`, and where the text stands after its `>`
/// and the blanks behind it. A route, `@a,@b:`, is read and dropped under `Obsolete`.
fn angle(cx: Cx, at: Int) -> Spec / {email.refused, abort.raise} = {
  let start = cfws(cx, at + 1);
  let c = peek(cx.b, start);
  let routed = c == b'@' || c == b',';
  let from = if !routed { start }
  else if cx.obsolete { route(cx, start, false, false, bytes_len(cx.b) - start + 1) }
  else { refuse(start, ObsoleteSyntax) };
  let r = run(cx, from);
  let next = peek(cx.b, r.at);
  if next != b'@' {
    refuse(r.at, if len(r.toks) == 0 && next == b'>' { NoAddress }
    else if next < 0 { UnclosedAngle }
    else { unfit(cx, r.at, NoAt) })
  } else {
    let s = spec(cx, r, from);
    if peek(cx.b, s.at) != b'>' {
      refuse(s.at, if peek(cx.b, s.at) < 0 { UnclosedAngle } else { stray(cx, s.at) })
    } else { { address: s.address, at: cfws(cx, s.at + 1) } }
  }
}

/// Where a route that starts at `at` ends, after its `:`: `@` and a domain, and more of them
/// after commas. `any` says a domain was read, and `held` that one was since the last comma.
/// `left` bounds the rounds: each takes a comma or a domain.
fn route(cx: Cx, at: Int, any: Bool, held: Bool, left: Int) -> Int / {email.refused, abort.raise} = {
  let start = cfws(cx, at);
  let c = peek(cx.b, start);
  if c == b':' && any { start + 1 }
  else if left <= 0 { refuse(start, Unexpected) }
  else if c == b',' { route(cx, start + 1, any, false, left - 1) }
  else if c == b'@' && !held { route(cx, domain_at(cx, start + 1).at, true, true, left - 1) }
  else { refuse(start, if c < 0 { UnclosedAngle } else { stray(cx, start) }) }
}

/// The display name the words `toks` are: atoms and quoted strings with a space between them,
/// each encoded word decoded, and two encoded words side by side as one text.
fn phrase(cx: Cx, toks: List<Seen>) -> Option<String> / {email.refused, abort.raise} =
  match toks {
    [] -> None,
    [opening, ..] -> if is_dot(opening) { refuse(opening.at, Unexpected) } else {
      let said = fold(toks, { out: [], dot: false, word: false }, |s: Saying, t: Seen|
        said_with(cx, s, t));
      let name = join(said.out, "");
      if name == "" { None } else { Some(name) }
    },
  }

/// The words said so far, whether the last was a dot, and whether it was an encoded word.
type Saying = { out: List<String>, dot: Bool, word: Bool }

fn said_with(cx: Cx, s: Saying, t: Seen) -> Saying / {email.refused, abort.raise} =
  match t.tok {
    Dot -> if !cx.obsolete { refuse(t.at, ObsoleteSyntax) }
    else { { out: push(s.out, if t.spaced { " ." } else { "." }), dot: true, word: false } },
    Atom(written) -> {
      let w = worded(cx, written, t.at);
      { out: push(s.out, gap(s, t, w.whole) ++ w.text), dot: false, word: w.whole }
    },
    Quoted(held) ->
      {
        out: push(
          s.out,
          gap(s, t, false) ++ (if cx.obsolete { unworded(held).text } else { held }),
        ),
        dot: false,
        word: false,
      },
  }

/// What stands between the words said and the next one.
fn gap(s: Saying, t: Seen, word: Bool) -> String =
  if len(s.out) == 0 || (s.dot && !t.spaced) || (s.word && word) { "" } else { " " }

/// A text with its encoded words decoded: whether one could not be, and whether the text was
/// one encoded word and nothing else.
type Unworded = { text: String, bad: Bool, whole: Bool }

type Unwording = {
  out: List<String>,
  gap: String,
  joined: Bool,
  bad: Bool,
  words: Int,
  others: Int,
}

/// `text` with each encoded word in it decoded, as `std.encoded_word`'s `read` decodes them, but
/// for a word that cannot be read or that carries a control character, which is left as written.
fn unworded(text: String) -> Unworded / {abort.raise} = {
  let read = fold(
    pieces(text),
    { out: [], gap: "", joined: false, bad: false, words: 0, others: 0 },
    |u: Unwording, p: Piece|
      match p {
        Literal(written) -> if u.joined && is_blank(written) { { ..u, gap: written } }
        else { as_written(u, written, false) },
        Word(written, Ok(carried)) -> if !is_quotable(carried) { as_written(u, written, true) }
        else { { ..u, out: push(u.out, carried), gap: "", joined: true, words: u.words + 1 } },
        Word(written, Err(_)) -> as_written(u, written, true),
      },
  );
  {
    text: join(push(read.out, read.gap), ""),
    bad: read.bad,
    whole: read.words == 1 && read.others == 0 && read.gap == "",
  }
}

fn as_written(u: Unwording, written: String, bad: Bool) -> Unwording =
  {
    out: push(push(u.out, u.gap), written),
    gap: "",
    joined: false,
    bad: u.bad || bad,
    words: u.words,
    others: u.others + 1,
  }

/// An atom of a display name, decoded where it is an encoded word.
fn worded(cx: Cx, written: String, at: Int) -> Unworded / {email.refused, abort.raise} =
  if !string_contains(written, "=?") { { text: written, bad: false, whole: false } } else {
    let read = unworded(written);
    if read.bad && !cx.obsolete { refuse(at, BadEncodedWord) } else { read }
  }

/// Whether the words `r` end with an encoded word that touches what stands at `r.at`, with no
/// blank between them.
fn touches(r: Run) -> Bool =
  match last(r.toks) {
    Some(end) -> match end.tok {
      Atom(written) ->
        end.end == r.at && string_starts_with(written, "=?") && string_ends_with(written, "?="),
      _ -> false,
    },
    None -> false,
  }

type Boxed = { mailbox: Mailbox, at: Int }

/// The mailbox whose opening words are `r`, which started at `from`.
fn mailbox_from(cx: Cx, r: Run, from: Int) -> Boxed / {email.refused, abort.raise} = {
  let c = peek(cx.b, r.at);
  if c == b'<' {
    let name = if !cx.obsolete && touches(r) { refuse(r.at, BadEncodedWord) }
    else { phrase(cx, r.toks) };
    let a = angle(cx, r.at);
    { mailbox: Mailbox(name, a.address), at: a.at }
  } else if c == b'@' {
    let s = spec(cx, r, from);
    { mailbox: Mailbox(None, s.address), at: s.at }
  } else {
    let ends = c < 0 || c == b',' || c == b';';
    refuse(r.at, if !ends { stray(cx, r.at) } else if len(r.toks) == 0 { NoAddress } else { NoAt })
  }
}

type Listed = { entries: List<Entry>, at: Int }

type Element = { entry: Entry, at: Int }

/// What stands where a list's next element would: the list's end, nothing before a comma, or
/// an element.
type Place = | Ended | Empty | Filled

/// What stands at `r.at`, where `r` is the words read from an element's place. `any` says an
/// element was read before, and `grouped` that a `;` ends the list.
fn place(cx: Cx, r: Run, any: Bool, grouped: Bool) -> Place / {email.refused, abort.raise} = {
  let c = peek(cx.b, r.at);
  if len(r.toks) > 0 { Filled } else if c < 0 || (grouped && c == b';') {
    if any && !cx.obsolete { refuse(r.at, ObsoleteSyntax) } else { Ended }
  } else if c != b',' { Filled }
  else if cx.obsolete { Empty }
  else { refuse(r.at, ObsoleteSyntax) }
}

/// Where a list goes on after the element that ends at `at`: after a comma, or nowhere at the
/// list's end.
fn after_element(cx: Cx, at: Int, grouped: Bool) -> Option<Int> / {email.refused, abort.raise} = {
  let c = peek(cx.b, at);
  if c == b',' { Some(at + 1) }
  else if c < 0 || (grouped && c == b';') { None }
  else { refuse(at, stray(cx, at)) }
}

/// The addresses from `at` to the end of the text. `left` bounds the rounds: each takes an
/// address or a comma.
fn list_from(
  cx: Cx,
  at: Int,
  acc: List<Entry>,
  left: Int,
) -> Listed / {email.refused, abort.raise} = {
  let r = run(cx, at);
  if left <= 0 { { entries: acc, at: r.at } } else {
    match place(cx, r, len(acc) > 0, false) {
      Ended -> { entries: acc, at: r.at },
      Empty -> list_from(cx, r.at + 1, acc, left - 1),
      Filled -> {
        let e = element(cx, r, at);
        match after_element(cx, e.at, false) {
          Some(next) -> list_from(cx, next, push(acc, e.entry), left - 1),
          None -> { entries: push(acc, e.entry), at: e.at },
        }
      },
    }
  }
}

type Members = { members: List<Mailbox>, at: Int }

/// The mailboxes of a group from `at` to its `;`. `left` bounds the rounds: each takes a
/// mailbox or a comma.
fn members_from(
  cx: Cx,
  at: Int,
  acc: List<Mailbox>,
  left: Int,
) -> Members / {email.refused, abort.raise} = {
  let r = run(cx, at);
  if left <= 0 { { members: acc, at: r.at } } else {
    match place(cx, r, len(acc) > 0, true) {
      Ended -> { members: acc, at: r.at },
      Empty -> members_from(cx, r.at + 1, acc, left - 1),
      Filled -> {
        let m = if peek(cx.b, r.at) == b':' { refuse(r.at, Unexpected) }
        else { mailbox_from(cx, r, at) };
        match after_element(cx, m.at, true) {
          Some(next) -> members_from(cx, next, push(acc, m.mailbox), left - 1),
          None -> { members: push(acc, m.mailbox), at: m.at },
        }
      },
    }
  }
}

/// The mailbox or the group whose opening words are `r`, which started at `from`.
fn element(cx: Cx, r: Run, from: Int) -> Element / {email.refused, abort.raise} =
  if peek(cx.b, r.at) != b':' {
    let m = mailbox_from(cx, r, from);
    { entry: One(m.mailbox), at: m.at }
  } else if !cx.obsolete && touches(r) { refuse(r.at, BadEncodedWord) } else {
    match phrase(cx, r.toks) {
      None -> refuse(r.at, Unexpected),
      Some(name) -> {
        let inner = members_from(cx, r.at + 1, [], bytes_len(cx.b) - r.at + 2);
        if peek(cx.b, inner.at) != b';' { refuse(inner.at, UnclosedGroup) }
        else { { entry: Group(name, inner.members), at: cfws(cx, inner.at + 1) } }
      },
    }
  }

// --- Addresses ----------------------------------------------------------------

/// An address: a local part and a domain, `jdoe` and `example.org` of `jdoe@example.org`.
///
/// The local part is its text, without the quotes and backslashes it may be written with:
/// printable characters, a space among them, and at most 255 octets. It holds no `@`, though RFC
/// 5322 admits one in quotes: an address has one `@`, and what follows it is its domain however
/// a reader splits it. The domain is host labels between dots, or a literal in its brackets
/// (`[192.0.2.1]`), at most 255 octets. Two addresses are `==` when their local parts are the
/// same text, case and all, and their domains are one name: in any case of ASCII letters, and
/// with an internationalized label in its script or as its A-label, since `std.idna` makes one
/// name of both. `show` writes `local@domain` as the address was written, the local part
/// quoted where it must be.
pub opaque type Address = | Address(String, String, String)

key for Address by address_key

show for Address by address_text

gen for Address by addresses

type AddressKey = { domain: String, local: String }

fn address_key(a: Address) -> AddressKey =
  match a { Address(local, _, shared) -> { domain: shared, local: local } }

/// The address of this local part and this domain, raising `email.refused` where either is not
/// one an address has, at the byte of the argument that is not. The local part is given as its
/// text, with no quotes. A tab, which RFC 5322 admits in a quoted local part and SMTP cannot
/// carry, is refused, and so is an `@`.
pub fn address(
  local: String,
  domain: String,
  repertoire: Repertoire = Ascii,
) -> Address / {email.refused, abort.raise} = {
  let cx = cx_of(domain, repertoire, Current);
  let d = domain_from(cx, 0);
  if d.at < bytes_len(cx.b) { refuse(d.at, unfit(cx, d.at, BadDomain)) }
  else { Address(local_checked(local, cx.utf8, 0), d.text, d.key) }
}

/// An address's local part, as text: `john doe` of `"john doe"@example.org`.
pub fn local_part(a: Address) -> String = match a { Address(local, _, _) -> local }

/// An address's domain as written: host labels between dots, or a literal with its brackets.
pub fn domain(a: Address) -> String = match a { Address(_, domain, _) -> domain }

/// An address's domain in ASCII: as written where it is, and the A-labels of a name written
/// outside it, in lower case. It is what DNS is asked for and what a path without `SMTPUTF8`
/// carries.
pub fn ascii_domain(a: Address) -> String =
  match a { Address(_, domain, shared) -> if string::is_ascii(domain) { domain } else { shared } }

/// The address in ASCII, its domain as `ascii_domain` writes it: what a writer under `Ascii`
/// writes. `None` where the local part is outside ASCII, which nothing spells in ASCII.
pub fn ascii_text(a: Address) -> Option<String> =
  if is_ascii(a) { Some(local_text(local_part(a)) ++ "@" ++ ascii_domain(a)) } else { None }

/// What stands between the brackets of an address whose domain is a literal, `192.0.2.1` or
/// `IPv6:2001:db8::1`; `None` for a domain that is a name. The text is kept as written and is
/// not read as an address of any kind.
pub fn domain_literal(a: Address) -> Option<String> / {abort.raise} = {
  let d = domain(a);
  if string_starts_with(d, "[") { Some(string_slice(d, 1, string_len(d) - 1)) } else { None }
}

/// Whether an address can be written in ASCII alone, so that a message need not be sent under
/// `SMTPUTF8` for it: its local part holds ASCII alone. A domain always can be, as its
/// A-labels.
pub fn is_ascii(a: Address) -> Bool = string::is_ascii(local_part(a))

/// The address `text` is, raising `email.refused` where `parse_address` answers `Err`: a local
/// part, `@` and a domain in RFC 5322's current syntax, with no blank and no comment anywhere.
pub fn read_address(
  text: String,
  repertoire: Repertoire = Ascii,
) -> Address / {email.refused, abort.raise} = {
  let cx = cx_of(text, repertoire, Current);
  let r = run(cx, 0);
  let tight = all(r.toks, |t: Seen| !t.spaced)
    && (match last(r.toks) { Some(t) -> t.end == r.at, None -> true });
  if peek(cx.b, r.at) != b'@' {
    refuse(r.at, if peek(cx.b, r.at) >= 0 { unfit(cx, r.at, NoAt) }
    else if len(r.toks) == 0 { NoAddress }
    else { NoAt })
  } else if !tight { refuse(0, Unexpected) } else {
    let local = local_of(cx, r.toks, 0);
    let d = domain_from(cx, r.at + 1);
    if d.at < bytes_len(cx.b) { refuse(d.at, stray(cx, d.at)) }
    else if bytes_len(bytes_of_string(d.text)) != d.at - r.at - 1 { refuse(r.at + 1, Unexpected) }
    else { Address(local, d.text, d.key) }
  }
}

/// The address `text` is, or where it stops being one and why.
pub fn parse_address(
  text: String,
  repertoire: Repertoire = Ascii,
) -> Result<Address, Refusal> / {abort.raise} = try { read_address(text, repertoire) }

/// What an `email"..."` literal is checked by: the address `read_address` answers under `Utf8`,
/// or why the text is none and the character it stops being one at.
pub fn literal(text: String) -> Result<Address, { message: String, offset: Int }> / {abort.raise} =
  match parse_address(text, Utf8) {
    Ok(a) -> Ok(a),
    Err(r) ->
      Err({
        message: explain(r.why),
        offset: string_len(string_of_bytes_lossy(bytes_slice(bytes_of_string(text), 0, r.at))),
      }),
  }

fn address_text(a: Address) -> String =
  match a { Address(local, domain, _) -> local_text(local) ++ "@" ++ domain }

fn local_text(local: String) -> String = if is_dot_atom(local) { local } else { quote(local) }

/// `text` in quotes, with a backslash before each quote and backslash in it.
fn quote(text: String) -> String =
  "\""
    ++ string_of_chars(
      fold(string_chars(text), [], |acc: List<Char>, c: Char|
        if c == '"' || c == '\\' { push(push(acc, '\\'), c) } else { push(acc, c) }),
    )
    ++ "\""

/// Whether `text` is atoms between single dots, which a local part is written as without quotes.
fn is_dot_atom(text: String) -> Bool = {
  let seen = fold(
    string_chars(text),
    { ok: true, dot: true },
    |s: { ok: Bool, dot: Bool }, c: Char|
      if c == '.' { { ok: s.ok && !s.dot, dot: true } }
      else { { ok: s.ok && is_atom_char(c), dot: false } },
  );
  seen.ok && !seen.dot
}

fn is_atom_char(c: Char) -> Bool =
  int_of_char(c) > 127
    || string_contains(
      "!#$%&'*+-/0123456789=?ABCDEFGHIJKLMNOPQRSTUVWXYZ^_`abcdefghijklmnopqrstuvwxyz{|}~",
      string_of_chars([c]),
    )

// --- Mailboxes and address lists ----------------------------------------------

/// A mailbox: an address, and the display name it is written under, if any. A name holds no
/// control character but a tab and is never empty. `show` writes `Name <local@domain>`, the name
/// in quotes where it is not plain words.
pub opaque type Mailbox = | Mailbox(Option<String>, Address)

key for Mailbox by mailbox_key

show for Mailbox by mailbox_text

gen for Mailbox by mailboxes

type MailboxKey = { address: AddressKey, name: Option<String> }

fn mailbox_key(m: Mailbox) -> MailboxKey =
  match m { Mailbox(name, a) -> { address: address_key(a), name: name } }

/// The mailbox of an address under no name.
pub fn mailbox(a: Address) -> Mailbox = Mailbox(None, a)

/// The mailbox of an address under a display name, raising `email.refused` for a name that holds
/// a line break or a control character other than a tab, at its byte. An empty name is no name.
pub fn named(name: String, a: Address) -> Mailbox / {email.refused, abort.raise} =
  Mailbox(if name == "" { None } else { Some(header_text(name)) }, a)

/// `text` where a field's value can hold it: no control character but a tab.
fn header_text(text: String) -> String / {email.refused, abort.raise} = {
  let b = bytes_of_string(text);
  let stop = scan_until(b, 0, controls());
  if stop < bytes_len(b) {
    refuse(stop, if bytes_at(b, stop) == b'\r' || bytes_at(b, stop) == b'\n' { LineBreak }
    else { Control })
  } else { text }
}

/// A mailbox's display name.
pub fn display_name(m: Mailbox) -> Option<String> = match m { Mailbox(name, _) -> name }

/// A mailbox's address.
pub fn address_of(m: Mailbox) -> Address = match m { Mailbox(_, a) -> a }

/// The mailbox `text` is, raising `email.refused` where `parse_mailbox` answers `Err`: an
/// address alone, or a display name and an address in angle brackets, with comments wherever RFC
/// 5322 admits them. `text` is a field's value unfolded: a line break in it is refused.
pub fn read_mailbox(
  text: String,
  repertoire: Repertoire = Ascii,
  syntax: Syntax = Obsolete,
) -> Mailbox / {email.refused, abort.raise} = {
  let cx = cx_of(text, repertoire, syntax);
  let m = mailbox_from(cx, run(cx, 0), 0);
  if m.at < bytes_len(cx.b) { refuse(m.at, stray(cx, m.at)) } else { m.mailbox }
}

/// The mailbox `text` is, or where it stops being one and why.
pub fn parse_mailbox(
  text: String,
  repertoire: Repertoire = Ascii,
  syntax: Syntax = Obsolete,
) -> Result<Mailbox, Refusal> / {abort.raise} = try { read_mailbox(text, repertoire, syntax) }

fn mailbox_text(m: Mailbox) -> String =
  match m {
    Mailbox(None, a) -> address_text(a),
    Mailbox(Some(name), a) -> phrase_text(name) ++ " <" ++ address_text(a) ++ ">",
  }

/// A display name as `show` writes it: as it is where it is atoms with one space between them
/// and none is an encoded word, and in quotes otherwise.
fn phrase_text(name: String) -> String =
  if is_words(name) && !string_contains(name, "=?") { name } else { quote(name) }

/// Whether `text` is atoms with a single space between them.
fn is_words(text: String) -> Bool = {
  let seen = fold(
    string_chars(text),
    { ok: true, gap: true },
    |s: { ok: Bool, gap: Bool }, c: Char|
      if c == ' ' { { ok: s.ok && !s.gap, gap: true } }
      else { { ok: s.ok && is_atom_char(c), gap: false } },
  );
  seen.ok && !seen.gap
}

/// One element of an address list: a mailbox, or a group, which is a name and the mailboxes
/// listed under it, none for `undisclosed-recipients:;`.
pub opaque type Entry = | One(Mailbox) | Group(String, List<Mailbox>)

show for Entry by entry_text

gen for Entry by entries

/// The entry that is one mailbox.
pub fn one(m: Mailbox) -> Entry = One(m)

/// Each mailbox as an entry of its own.
pub fn each(ms: List<Mailbox>) -> List<Entry> = map(ms, one)

/// The group of this name and these members, raising `email.refused` for a name that is empty or
/// holds a line break or a control character other than a tab.
pub fn group(name: String, members: List<Mailbox>) -> Entry / {email.refused, abort.raise} =
  if name == "" { refuse(0, NoAddress) } else { Group(header_text(name), members) }

/// A group's name; `None` for an entry that is a mailbox.
pub fn group_name(e: Entry) -> Option<String> =
  match e { One(_) -> None, Group(name, _) -> Some(name) }

/// The mailboxes an entry holds: itself, or a group's members.
pub fn members(e: Entry) -> List<Mailbox> = match e { One(m) -> [m], Group(_, held) -> held }

/// Every mailbox of an address list in the order written, groups flattened.
pub fn mailboxes_of(es: List<Entry>) -> List<Mailbox> = flat_map(es, members)

/// The address list `text` is, raising `email.refused` where `parse_address_list` answers `Err`:
/// RFC 5322's `address-list`, mailboxes and groups between commas. `text` is a field's value
/// unfolded: a line break in it is refused. A list of nothing is refused too.
pub fn read_address_list(
  text: String,
  repertoire: Repertoire = Ascii,
  syntax: Syntax = Obsolete,
) -> List<Entry> / {email.refused, abort.raise} = {
  let cx = cx_of(text, repertoire, syntax);
  let read = list_from(cx, 0, [], bytes_len(cx.b) + 2);
  if read.at < bytes_len(cx.b) { refuse(read.at, stray(cx, read.at)) }
  else if len(read.entries) == 0 { refuse(read.at, NoAddress) }
  else { read.entries }
}

/// The address list `text` is, or where it stops being one and why.
pub fn parse_address_list(
  text: String,
  repertoire: Repertoire = Ascii,
  syntax: Syntax = Obsolete,
) -> Result<List<Entry>, Refusal> / {abort.raise} =
  try { read_address_list(text, repertoire, syntax) }

fn entry_text(e: Entry) -> String =
  match e {
    One(m) -> mailbox_text(m),
    Group(name, held) -> phrase_text(name) ++ ":" ++ join(map(held, mailbox_text), ", ") ++ ";",
  }

/// An address list as `show` writes its entries, with `, ` between them: what
/// `read_address_list` reads back under `Utf8` and `Current`.
pub fn address_list_text(es: List<Entry>) -> String = join(map(es, entry_text), ", ")

// --- Generators ---------------------------------------------------------------

/// A text of `least` to `most` characters, each one of `chars`.
fn drawn(chars: String, least: Int, most: Int) -> Gen<String> =
  gen::and_then(gen::int_between(least, most), |n: Int|
    gen::map(gen::list_of_length(gen::elements(string_chars(chars)), n), |cs: List<Char>|
      string_of_chars(cs)))

/// One to three of what `g` draws, with `sep` between them.
fn several(g: Gen<String>, sep: String) -> Gen<String> =
  gen::and_then(gen::int_between(1, 3), |n: Int|
    gen::map(gen::list_of_length(g, n), |held: List<String>| join(held, sep)))

fn drawn_local() -> Gen<String> =
  gen::one_of([
    several(drawn("abcxyzABC019", 1, 6), "."),
    several(drawn("ab0!#$%&'*+-/=?^_`{|}~", 1, 4), "."),
    drawn("ab .\"\\(),:;<>[]", 0, 8),
    drawn("a\u{e9}\u{65e5}\u{1f600}.", 1, 5),
  ])

fn drawn_label() -> Gen<String> =
  gen::map2(drawn("abcXYZ019", 1, 4), drawn("abc019-", 0, 3), |head: String, tail: String|
    head ++ tail ++ "z")

/// A domain as written, and what its spellings share.
type Drawn = { text: String, shared: String }

fn drawn_domain() -> Gen<Drawn> =
  gen::one_of([
    gen::map(several(drawn_label(), "."), |name: String| { text: name, shared: ascii_lower(name) }),
    gen::elements([
      { text: "example.org", shared: "example.org" },
      { text: "EXAMPLE.org", shared: "example.org" },
      { text: "[192.0.2.1]", shared: "[192.0.2.1]" },
      { text: "[IPv6:2001:db8::1]", shared: "[ipv6:2001:db8::1]" },
      { text: "xn--bcher-kva.example", shared: "xn--bcher-kva.example" },
      { text: "b\u{fc}cher.example", shared: "xn--bcher-kva.example" },
      { text: "B\u{dc}CHER.Example", shared: "xn--bcher-kva.example" },
      { text: "\u{4f8b}\u{3048}.jp", shared: "xn--r8jz45g.jp" },
      { text: "\u{5d0}\u{5d1}.xn--4dbc", shared: "xn--4dbc.xn--4dbc" },
    ]),
  ])

/// Addresses of every kind a reader answers: plain and quoted local parts, UTF-8 ones, and for
/// domains names, literals and internationalized names in their script and as A-labels.
pub fn addresses() -> Gen<Address> =
  gen::map2(drawn_local(), drawn_domain(), |local: String, d: Drawn|
    Address(local, d.text, d.shared))

fn drawn_name() -> Gen<String> =
  gen::one_of([
    several(drawn("abcXYZ", 1, 6), " "),
    drawn("ab Z.,\"\\()<>@:;=?_\t", 1, 10),
    drawn("a \u{e9}\u{65e5}\u{1f600}", 1, 6),
  ])

/// Mailboxes under no name, plain names, names that must be quoted and names outside ASCII.
pub fn mailboxes() -> Gen<Mailbox> =
  gen::map2(gen::option_of(drawn_name()), addresses(), |name: Option<String>, a: Address|
    Mailbox(name, a))

/// Mailboxes, and groups of none to three.
pub fn entries() -> Gen<Entry> =
  gen::one_of([
    gen::map(mailboxes(), one),
    gen::map(mailboxes(), one),
    gen::map2(drawn_name(), gen::list_of(mailboxes(), 3), |name: String, held: List<Mailbox>|
      Group(name, held)),
  ])

// --- Message identifiers ------------------------------------------------------

/// A message identifier: what stands between the angle brackets of a `Message-ID`, a
/// `Content-ID` or one of the `References`. It is ASCII text with no blank, no control character
/// and no angle bracket, short enough for a line, and two are `==` when they are the same text.
/// `show` writes it in its brackets.
pub opaque type MessageId = | MessageId(String)

show for MessageId by id_text

gen for MessageId by ids

/// The identifier `left@right`, raising `email.refused` where either side is not what RFC 5322
/// has a writer write: atoms between single dots, or for the right side a domain literal.
pub fn message_id(left: String, right: String) -> MessageId / {email.refused, abort.raise} = {
  let l = bytes_of_string(left);
  if !is_dot_atom(left) || scan(l, 0, bytes_concat(atext(), b".")) < bytes_len(l) {
    refuse(0, BadMessageId)
  } else {
    let cx = cx_of(right, Ascii, Current);
    let d = domain_from(cx, 0);
    if d.at < bytes_len(cx.b) || d.text != right { refuse(d.at, BadMessageId) }
    else { identifier(left ++ "@" ++ right, 0) }
  }
}

/// The identifier that is `text`, where it is one an identifier may be.
fn identifier(text: String, at: Int) -> MessageId / {email.refused, abort.raise} = {
  let b = bytes_of_string(text);
  let n = bytes_len(b);
  if n == 0 || scan(b, 0, id_chars()) < n { refuse(at, BadMessageId) }
  else if n > 995 { refuse(at, TooLong) }
  else { MessageId(text) }
}

/// An identifier in its angle brackets, `<left@right>`.
pub fn id_text(i: MessageId) -> String = match i { MessageId(text) -> "<" ++ text ++ ">" }

/// The identifiers `text` holds, raising `email.refused` where `parse_message_ids` answers
/// `Err`: each `<` and `>` around text with no blank, with blanks and comments between them, as
/// a `Message-ID`, an `In-Reply-To` or a `References` field carries. Under `Obsolete` a blank or
/// a comment inside the brackets is passed over, and so are the words and commas old mail wrote
/// between identifiers.
pub fn read_message_ids(
  text: String,
  syntax: Syntax = Current,
) -> List<MessageId> / {email.refused, abort.raise} = {
  let cx = cx_of(text, Ascii, syntax);
  let n = bytes_len(cx.b) + 2;
  if cx.obsolete { ids_from(cx, 0, [], n) } else {
    match try { ids_from(cx, 0, [], n) } {
      Ok(found) -> found,
      Err(r) ->
        refuse(r.at, if result_is_ok(try { ids_from({ ..cx, obsolete: true }, 0, [], n) }) {
          ObsoleteSyntax
        } else { r.why }),
    }
  }
}

/// The identifiers `text` holds, or where it stops being identifiers and why.
pub fn parse_message_ids(
  text: String,
  syntax: Syntax = Current,
) -> Result<List<MessageId>, Refusal> / {abort.raise} = try { read_message_ids(text, syntax) }

/// `left` bounds the rounds: each takes an identifier, a word or a comma.
fn ids_from(
  cx: Cx,
  at: Int,
  acc: List<MessageId>,
  left: Int,
) -> List<MessageId> / {email.refused, abort.raise} = {
  let start = cfws(cx, at);
  let c = peek(cx.b, start);
  if c < 0 || left <= 0 { acc } else if c == b'<' {
    let close = scan_until(cx.b, start + 1, b">");
    let inner = bytes_slice(cx.b, start + 1, close);
    if close >= bytes_len(cx.b) { refuse(close, UnclosedAngle) }
    else if bytes_len(inner) > 0 && scan(inner, 0, id_chars()) == bytes_len(inner) {
      ids_from(cx, close + 1, push(acc, identifier(string_of_bytes(inner), start)), left - 1)
    } else if !cx.obsolete {
      refuse(start, unfit(cx, start + 1 + scan(inner, 0, id_chars()), BadMessageId))
    } else {
      let i = spaced_id(cx, start);
      ids_from(cx, i.at, push(acc, identifier(i.text, start)), left - 1)
    }
  } else if !cx.obsolete { refuse(start, unfit(cx, start, BadMessageId)) }
  else if c == b',' { ids_from(cx, start + 1, acc, left - 1) } else {
    let r = run(cx, start);
    if r.at == start { refuse(start, unfit(cx, start, BadMessageId)) }
    else { ids_from(cx, r.at, acc, left - 1) }
  }
}

/// The identifier whose `<` stands at `at`, written with blanks or comments inside its brackets
/// as RFC 5322 §4 admits: a local part, `@` and a domain, read as an address's are.
fn spaced_id(cx: Cx, at: Int) -> Text / {email.refused, abort.raise} = {
  let r = run(cx, at + 1);
  if peek(cx.b, r.at) != b'@' { refuse(at, unfit(cx, r.at, BadMessageId)) } else {
    let left = join(map(r.toks, tok_text), "");
    let start = cfws(cx, r.at + 1);
    let right = if peek(cx.b, start) == b'[' { bracketed(cx, start) } else {
      let read = labels(cx, { at: start, held: [] }, bytes_len(cx.b) - start + 1);
      { text: join(read.held, "."), at: read.at }
    };
    let close = cfws(cx, right.at);
    if peek(cx.b, close) != b'>' { refuse(close, UnclosedAngle) }
    else { { text: left ++ "@" ++ right.text, at: close + 1 } }
  }
}

/// An identifier whose left side is the host's entropy and whose right side is `domain`, as RFC
/// 5322 recommends one be made. Raises `email.refused` for a domain that is none.
pub fn fresh_id(domain: String) -> MessageId / {entropy.next bounded, email.refused, abort.raise} =
  message_id(nonce(), domain)

/// Identifiers as `message_id` makes them, and the bare words old mail used.
pub fn ids() -> Gen<MessageId> =
  gen::one_of([
    gen::map2(several(drawn("abc019$=+", 1, 6), "."), drawn_label(), |l: String, r: String|
      MessageId(l ++ "@" ++ r ++ ".example")),
    gen::map(drawn("ab01.@[]:/", 1, 12), |text: String| MessageId(text)),
  ])

// --- Fields -------------------------------------------------------------------

/// One header field.
pub opaque type Field = new {
  /// The field's name as written: `Subject`, in whatever case.
  name: String,
  /// The field as it is in the message: its name, its colon, its value on as many lines as it
  /// was folded over, and its line break.
  raw: Bytes,
  /// The value unfolded, without the blanks around it. Encoded words in it are as written:
  /// `unstructured` decodes them.
  value: String,
}

/// The field `name: value`, folded at its spaces to lines of 78 octets where it can be and 998
/// at most. Raises `email.refused`, at the byte of the argument that is at fault, for a name
/// that is no field's, and for a value that holds a line break, a control character other than
/// a tab, a character outside ASCII where `Utf8` is not asked for, or a stretch between two
/// spaces that no line holds. The value is written as given, with no encoding: `text_field`
/// writes text outside ASCII.
pub fn field(
  name: String,
  value: String,
  repertoire: Repertoire = Ascii,
) -> Field / {email.refused, abort.raise} = {
  let held = string_of_chars(trimmed(string_chars(header_text(value))));
  let cut = stretches(held);
  let eight = scan_until(bytes_of_string(held), 0, high());
  if eight < bytes_len(bytes_of_string(held)) && repertoire == Ascii { refuse(eight, NonAscii) }
  else if any(cut, |s: String| bytes_len(bytes_of_string(s)) > 998) { refuse(0, TooLong) }
  else { { name: field_name(name), raw: folded(name, cut), value: held } }
}

/// The field `name` whose value is `text` as an unstructured field carries it: as it is where it
/// is printable ASCII, or under `Utf8` any printable text, and in encoded words otherwise.
/// Raises `email.refused` as `field` does, a character outside ASCII aside.
pub fn text_field(
  name: String,
  text: String,
  repertoire: Repertoire = Ascii,
) -> Field / {email.refused, abort.raise} = {
  let raw = folded(field_name(name), text_stretches(header_text(text), repertoire == Utf8));
  { name: name, raw: raw, value: value_of(raw) }
}

/// `name` where it is one a field has: printable ASCII with no space and no colon, short enough
/// to leave a line room.
fn field_name(name: String) -> String / {email.refused, abort.raise} = {
  let n = bytes_of_string(name);
  let stop = scan(n, 0, ftext());
  if bytes_len(n) == 0 || bytes_len(n) > 76 || stop < bytes_len(n) {
    refuse(min(stop, 76), BadName)
  } else { name }
}

/// `chars` without the spaces and tabs at either end.
fn trimmed(chars: List<Char>) -> List<Char> = {
  let blank = |c: Char| c == ' ' || c == '\t';
  list::reverse(list::drop_while(list::reverse(list::drop_while(chars, blank)), blank))
}

/// `text` cut before each run of spaces, each stretch opening with its spaces and the first with
/// the one that follows a field's colon: where a field's line may be folded.
fn stretches(text: String) -> List<String> / {abort.raise} =
  fold(
    string_split(text, " "),
    { out: [], pad: " " },
    |s: { out: List<String>, pad: String }, part: String|
      if part == "" { { out: s.out, pad: s.pad ++ " " } }
      else { { out: push(s.out, s.pad ++ part), pad: " " } },
  ).out

type Folding = { out: List<Bytes>, width: Int, fresh: Bool }

/// A field's lines: its name and colon, then each stretch, with a line break before one that
/// would take a line past 78 octets where the line already holds a stretch, and before one that
/// would take it past 998.
fn folded(name: String, cut: List<String>) -> Bytes / {abort.raise} = {
  let head = bytes_of_string(name ++ ":");
  let done = fold(
    cut,
    { out: [head], width: bytes_len(head), fresh: true },
    |f: Folding, s: String| {
      let piece = bytes_of_string(s);
      let wide = bytes_len(piece);
      if (f.width + wide > 78 && !f.fresh) || f.width + wide > 998 {
        { out: push(push(f.out, b"\r\n"), piece), width: wide, fresh: false }
      } else { { out: push(f.out, piece), width: f.width + wide, fresh: false } }
    },
  );
  bytes_concat_all(push(done.out, b"\r\n"))
}

/// The stretches that carry `text` as an unstructured value: its words where it is plain, and
/// encoded words otherwise.
fn text_stretches(text: String, utf8: Bool) -> List<String> / {abort.raise} = {
  let cut = stretches(text);
  if is_plain(text, utf8) && all(cut, |s: String| bytes_len(bytes_of_string(s)) <= 998) { cut }
  else { map(encode_words(text, coding_for(text)), |w: String| " " ++ w) }
}

/// Whether `text` reads back as itself written as it is: printable, with no blank at either end
/// and nothing that has the shape of an encoded word.
fn is_plain(text: String, utf8: Bool) -> Bool / {abort.raise} = {
  let b = bytes_of_string(text);
  !string_contains(text, "=?") && !string_starts_with(text, " ") && !string_ends_with(text, " ")
    && scan(b, 0, if utf8 { printable_wide() } else { printable() }) == bytes_len(b)
    && !has_c1(text)
}

/// Whether `text` holds one of the control characters `U+0080` to `U+009F`.
fn has_c1(text: String) -> Bool =
  any(string_chars(text), |c: Char| int_of_char(c) >= 128 && int_of_char(c) < 160)

/// What `Q` writes as itself, and a space.
fn q_plain() -> Bytes = b" !*+-/0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"

/// The coding that writes `text` in fewer characters: `Q` where few of its bytes take an escape.
fn coding_for(text: String) -> encoded_word::Coding / {abort.raise} =
  if mostly(bytes_of_string(text), q_plain()) { encoded_word::Q } else { encoded_word::B }

/// Whether fewer than one in six of the first 4096 bytes of `data` are outside `plain`, which is
/// where escaping them takes less room than base64 does.
fn mostly(data: Bytes, plain: Bytes) -> Bool / {abort.raise} = {
  let head = bytes_slice(data, 0, min(bytes_len(data), 4096));
  outside(head, plain, 0, 0, bytes_len(head) + 1) * 6 < bytes_len(head)
}

/// How many bytes of `b` from `at` on are not in `plain`, and `count`. `left` bounds the rounds:
/// each takes a run of them.
fn outside(b: Bytes, plain: Bytes, at: Int, count: Int, left: Int) -> Int / {abort.raise} = {
  let stop = scan(b, at, plain);
  let next = scan_until(b, stop, plain);
  if left <= 0 || stop >= bytes_len(b) { count }
  else { outside(b, plain, next, count + next - stop, left - 1) }
}

/// A field's value unfolded: what follows its colon, without its line breaks and the blanks
/// around it, and with `U+FFFD` for bytes that are no UTF-8.
fn value_of(raw: Bytes) -> String / {abort.raise} = {
  let n = bytes_len(raw);
  let colon = match bytes_index_of_byte(raw, b':') { Some(i) -> i + 1, None -> n };
  let held = replace(replace(bytes_slice(raw, colon, n), b"\r", b""), b"\n", b"");
  string_of_chars(trimmed(string_chars(string_of_bytes_lossy(held))))
}

// --- Messages -----------------------------------------------------------------

/// What reading one message may cost. A message past a limit is refused where it passes it,
/// by `read_tolerant` too.
pub type Limits = new {
  /// Bytes in the whole message.
  max_bytes: Int,
  /// Header fields in one header block: the message's, or a part's.
  max_fields: Int,
  /// Bytes in one header block.
  max_header_bytes: Int,
  /// How deep multipart bodies nest. At `0` none is read.
  max_depth: Int,
  /// Parts in the whole message, at every depth.
  max_parts: Int,
}

/// 25 MiB a message, a thousand fields and 256 KiB a header block, and a thousand parts nested
/// eight deep.
pub fn default_limits() -> Limits =
  { max_bytes: 26214400, max_fields: 1000, max_header_bytes: 262144, max_depth: 8, max_parts: 1000 }

/// What one entity holds: its fields, the blank line after them as written, its body, and
/// whether it was read under `Utf8`.
type Held = { fields: List<Field>, gap: Bytes, body: Bytes, utf8: Bool }

/// A message, or one part of one: header fields in the order written, and a body. It holds the
/// bytes it was read from, so `render` answers them again, and the parts of a multipart body as
/// messages of their own.
pub opaque type Message = | Message(Held, List<Message>)

fn held(m: Message) -> Held = match m { Message(h, _) -> h }

/// The bytes a message was read from, exactly.
pub fn render(m: Message) -> Bytes = {
  let h = held(m);
  bytes_concat_all(push(push(map(h.fields, |f: Field| f.raw), h.gap), h.body))
}

/// A message's header fields, in the order written.
pub fn fields(m: Message) -> List<Field> = held(m).fields

/// A message's body as it was transferred, its transfer encoding not undone: everything after
/// the blank line that ends the header block.
pub fn body(m: Message) -> Bytes = held(m).body

/// The parts of a multipart message, each a message of its own; none for any other. A part of
/// `message/rfc822` is a part like any other: its body is a message for a reader to read in turn.
pub fn parts(m: Message) -> List<Message> = match m { Message(_, children) -> children }

fn fields_named(held: List<Field>, lower: String) -> List<Field> =
  filter(held, |f: Field| ascii_lower(f.name) == lower)

/// The unfolded value of a message's first field named `name`, in any case.
pub fn header(m: Message, name: String) -> Option<String> =
  option_map(first(fields_named(held(m).fields, ascii_lower(name))), |f: Field| f.value)

/// The unfolded value of each of a message's fields named `name`, in the order written.
pub fn headers(m: Message, name: String) -> List<String> =
  map(fields_named(held(m).fields, ascii_lower(name)), |f: Field| f.value)

/// A message read by `read_tolerant`, and everything `read` would have refused it for, in the
/// order of their places.
pub type Tolerated = { message: Message, defects: List<Refusal> }

/// The message `data` is, raising `email.refused` where `parse` answers `Err`: what a
/// conforming writer writes, and nothing else. Lines end with CRLF and hold at most 998 octets;
/// a header block is fields and their folded lines, ended by a blank line or the message's end;
/// `Date` and `From` are there, and no field RFC 5322 allows once is there twice; each field
/// this module reads the value of reads in RFC 5322's current syntax; a header holds ASCII, or
/// under `Utf8` UTF-8; a body is in the transfer encoding it names, and a multipart body is
/// parts under its boundary, closed. A body whose encoding is `binary` has no lines to hold to.
pub fn read(
  data: Bytes,
  limits: Limits,
  repertoire: Repertoire = Ascii,
) -> Message / {email.refused, abort.raise} = {
  let read = read_tolerant(data, limits, repertoire);
  match read.defects { [] -> read.message, [found, ..] -> refuse(found.at, found.why) }
}

/// The message `data` is, or where it is refused and why.
pub fn parse(
  data: Bytes,
  limits: Limits,
  repertoire: Repertoire = Ascii,
) -> Result<Message, Refusal> / {abort.raise} = try { read(data, limits, repertoire) }

/// The message `data` is, with each thing `read` would have refused it for, raising
/// `email.refused` only for a message past a limit. Whatever the bytes, they are read: a line
/// feed alone ends a line; a line of a header block that is no field ends the block and starts
/// the body; a field whose value does not read is kept as written, and its typed reader answers
/// nothing; a multipart body with no closing delimiter has the parts found before its end, and
/// one `std.multipart` refuses for any other reason is kept as one part.
pub fn read_tolerant(
  data: Bytes,
  limits: Limits,
  repertoire: Repertoire = Ascii,
) -> Tolerated / {email.refused, abort.raise} = {
  let most = max(limits.max_bytes, 0);
  if bytes_len(data) > most { refuse(most, TooLarge) } else {
    let rd = { limits: limits, utf8: repertoire == Utf8 };
    let read = entity(data, 0, rd, limits.max_depth, limits.max_parts);
    let all_found = concat(read.defects, top_checks(held(read.message).fields, rd.utf8));
    { message: read.message, defects: sort_by(all_found, |a: Refusal, b: Refusal| a.at < b.at) }
  }
}

/// The message `data` is with its defects, or the limit it passes.
pub fn parse_tolerant(
  data: Bytes,
  limits: Limits,
  repertoire: Repertoire = Ascii,
) -> Result<Tolerated, Refusal> / {abort.raise} = try { read_tolerant(data, limits, repertoire) }

type Reading = { limits: Limits, utf8: Bool }

/// A header block read: its fields, the blank line that ends it as written, and where the body
/// starts.
type Block = { fields: List<Field>, gap: Bytes, body_at: Int, defects: List<Refusal> }

/// Where a header block's reader stands: at a line's start, with the field it is in started at
/// `start`, or at none where that is below zero.
type Heading = { at: Int, start: Int, fields: List<Field>, defects: List<Refusal> }

fn block(b: Bytes, origin: Int, rd: Reading) -> Block / {email.refused, abort.raise} =
  block_from(b, origin, rd, { at: 0, start: -1, fields: [], defects: [] }, bytes_len(b) + 2)

/// `left` bounds the rounds: each takes a line.
fn block_from(
  b: Bytes,
  origin: Int,
  rd: Reading,
  h: Heading,
  left: Int,
) -> Block / {email.refused, abort.raise} = {
  let n = bytes_len(b);
  let feed = scan_until(b, h.at, b"\n");
  let next = min(feed + 1, n);
  let end = if feed > h.at && bytes_at(b, feed - 1) == b'\r' { feed - 1 } else { feed };
  let most = max(rd.limits.max_header_bytes, 0);
  if h.at > most { refuse(origin + most, HeadersTooLarge) }
  else if left <= 0 || h.at >= n || end == h.at { ended(b, origin, rd, h, next, None) }
  else if !bytes::is_blank(bytes_at(b, h.at)) {
    match named_line(b, origin, rd, h) {
      Some(opened) -> block_from(b, origin, rd, opened, left - 1),
      None -> ended(b, origin, rd, h, h.at, Some(NoBlankLine)),
    }
  } else if h.start < 0 { ended(b, origin, rd, h, h.at, Some(NoBlankLine)) } else {
    let blank = scan(b, h.at, b" \t") >= end;
    block_from(
      b,
      origin,
      rd,
      { ..h, at: next, defects: line_found(h.defects, origin, h.at, blank, feed >= n, n) },
      left - 1,
    )
  }
}

/// The reader after the line at `h.at`, which opens with no blank, where that line opens a
/// field; `None` where it is no field's line.
fn named_line(
  b: Bytes,
  origin: Int,
  rd: Reading,
  h: Heading,
) -> Option<Heading> / {email.refused, abort.raise} = {
  let n = bytes_len(b);
  let feed = scan_until(b, h.at, b"\n");
  let name_end = scan(b, h.at, ftext());
  let colon = scan(b, name_end, b" \t");
  if name_end == h.at || peek(b, colon) != b':' { None } else {
    let done = closed(b, origin, rd, h, h.at);
    Some({
      at: min(feed + 1, n),
      start: h.at,
      fields: done.fields,
      defects: line_found(done.defects, origin, h.at, colon > name_end, feed >= n, n),
    })
  }
}

/// `defects` with what a header line at `at` showed: obsolete syntax, or no line break.
fn line_found(
  defects: List<Refusal>,
  origin: Int,
  at: Int,
  obsolete: Bool,
  open: Bool,
  n: Int,
) -> List<Refusal> = {
  let with_obsolete = if obsolete { push(defects, { at: origin + at, why: ObsoleteSyntax }) }
  else { defects };
  if open { push(with_obsolete, { at: origin + n, why: Truncated }) } else { with_obsolete }
}

/// The block that ends at `h.at`, its body starting at `body_at`.
fn ended(
  b: Bytes,
  origin: Int,
  rd: Reading,
  h: Heading,
  body_at: Int,
  why: Option<Why>,
) -> Block / {email.refused, abort.raise} = {
  let done = closed(b, origin, rd, h, h.at);
  {
    fields: done.fields,
    gap: bytes_slice(b, h.at, body_at),
    body_at: body_at,
    defects: match why {
      Some(found) -> push(done.defects, { at: origin + h.at, why: found }),
      None -> done.defects,
    },
  }
}

/// `h` with the field it is in ended at `to`.
fn closed(
  b: Bytes,
  origin: Int,
  rd: Reading,
  h: Heading,
  to: Int,
) -> Heading / {email.refused, abort.raise} =
  if h.start < 0 { h }
  else if len(h.fields) >= rd.limits.max_fields { refuse(origin + h.start, TooManyFields) } else {
    let raw = bytes_slice(b, h.start, to);
    {
      at: h.at,
      start: -1,
      fields: push(h.fields, {
        name: string_of_bytes(bytes_slice(raw, 0, scan(raw, 0, ftext()))),
        raw: raw,
        value: value_of(raw),
      }),
      defects: concat(h.defects, field_defects(raw, origin + h.start, rd.utf8)),
    }
  }

/// Every control character a header field holds none of: all but a tab and the two of a line
/// break.
fn field_controls() -> Bytes =
  b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x0b\x0c\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f\x7f"

fn field_defects(raw: Bytes, at: Int, utf8: Bool) -> List<Refusal> / {abort.raise} = {
  let n = bytes_len(raw);
  let eight = scan_until(raw, 0, high());
  let control = scan_until(raw, 0, field_controls());
  concat(
    if eight < n && !(utf8 && bytes_is_utf8(raw)) { [{ at: at + eight, why: EightBitHeader }] }
    else { [] },
    if control < n { [{ at: at + control, why: Control }] } else { [] },
  )
}

/// Where a reader of lines stands, and the first bare line feed, bare carriage return and line
/// past 998 octets it met, each below zero until it meets one.
type Lining = { at: Int, start: Int, feed: Int, ret: Int, long: Int }

/// What is wrong with the lines of `b`, which stands at `origin`: the first of each kind.
fn line_defects(b: Bytes, origin: Int) -> List<Refusal> / {abort.raise} = {
  let seen = lines_from(b, { at: 0, start: 0, feed: -1, ret: -1, long: -1 }, bytes_len(b) + 2);
  concat(
    concat(
      if seen.feed < 0 { [] } else { [{ at: origin + seen.feed, why: BareLineFeed }] },
      if seen.ret < 0 { [] } else { [{ at: origin + seen.ret, why: BareCarriageReturn }] },
    ),
    if seen.long < 0 { [] } else { [{ at: origin + seen.long, why: LongLine }] },
  )
}

/// `left` bounds the rounds: each takes a carriage return or a line feed.
fn lines_from(b: Bytes, s: Lining, left: Int) -> Lining / {abort.raise} = {
  let stop = scan_until(b, s.at, b"\r\n");
  let c = peek(b, stop);
  let long = if s.long < 0 && stop - s.start > 998 { s.start + 998 } else { s.long };
  if c < 0 || left <= 0 { { ..s, long: long } } else if c == b'\r' && peek(b, stop + 1) == b'\n' {
    lines_from(b, { ..s, at: stop + 2, start: stop + 2, long: long }, left - 1)
  } else if c == b'\r' {
    lines_from(
      b,
      { ..s, at: stop + 1, ret: if s.ret < 0 { stop } else { s.ret }, long: long },
      left - 1,
    )
  } else {
    lines_from(
      b,
      {
        ..s,
        at: stop + 1,
        start: stop + 1,
        feed: if s.feed < 0 { stop } else { s.feed },
        long: long,
      },
      left - 1,
    )
  }
}

/// An entity read: the message it is, the parts in it at every depth, and its defects.
type Entity = { message: Message, parts: Int, defects: List<Refusal> }

/// The entity `b` is, which stands at `origin` of the message. `room` is how many multipart
/// bodies deeper it may nest, and `parts_left` how many more parts the message may hold.
fn entity(
  b: Bytes,
  origin: Int,
  rd: Reading,
  room: Int,
  parts_left: Int,
) -> Entity / {email.refused, abort.raise} = {
  let head = block(b, origin, rd);
  let payload = bytes_slice(b, head.body_at, bytes_len(b));
  let at = origin + head.body_at;
  let media = media_of(head.fields).media;
  let multi = mime::top_level(media) == "multipart";
  let own = concat(
    concat(head.defects, line_defects(bytes_slice(b, 0, head.body_at), origin)),
    mime_checks(head.fields, origin, multi),
  );
  let kept = { fields: head.fields, gap: head.gap, body: payload, utf8: rd.utf8 };
  if !multi {
    {
      message: Message(kept, []),
      parts: 0,
      defects: concat(own, leaf_defects(head.fields, payload, at)),
    }
  } else if room <= 0 { refuse(origin, TooDeep) } else {
    let found = spans_of(
      payload,
      at,
      match mime::boundary(media) { Some(named_by) -> named_by, None -> "" },
      parts_left,
    );
    let read = fold(
      found.spans,
      { children: [], parts: len(found.spans), defects: [] },
      |r: Branching, s: Span| {
        let child = entity(
          bytes_slice(payload, s.from, s.to),
          at + s.from,
          rd,
          room - 1,
          parts_left - r.parts,
        );
        {
          children: push(r.children, child.message),
          parts: r.parts + child.parts,
          defects: concat(r.defects, child.defects),
        }
      },
    );
    {
      message: Message(kept, read.children),
      parts: read.parts,
      defects: concat(concat(concat(own, found.defects), around(payload, at, found)), read.defects),
    }
  }
}

type Branching = { children: List<Message>, parts: Int, defects: List<Refusal> }

/// What is wrong with the lines of a multipart body that are no part's: all of them, where the
/// body is kept as one part.
fn around(payload: Bytes, at: Int, found: Spanned) -> List<Refusal> / {abort.raise} =
  if found.ok { between(payload, at, found.spans) } else { line_defects(payload, at) }

/// Where a multipart body's parts lie, or that it is kept as one part, and why.
type Spanned = { spans: List<Span>, defects: List<Refusal>, ok: Bool }

/// Limits that bound nothing of a body but its parts: the message's own bound the rest.
fn framing(parts_left: Int) -> multipart::Limits = {
  let most = 9223372036854775807;
  {
    max_parts: parts_left,
    max_header_bytes: most,
    max_header_count: most,
    max_part_bytes: most,
    max_body: most,
    max_boundary: most,
    max_preamble: most,
    max_depth: 0,
  }
}

fn spans_of(
  payload: Bytes,
  at: Int,
  boundary: String,
  parts_left: Int,
) -> Spanned / {email.refused, abort.raise} =
  match multipart::parse_spans(payload, boundary, framing(parts_left), Lenient) {
    Ok(found) -> { spans: found, defects: [], ok: true },
    Err(r) -> match r.why {
      multipart::TooManyParts -> refuse(at + r.at, TooManyParts),
      multipart::Truncated -> closed_spans(payload, at, boundary, parts_left),
      why -> { spans: [], defects: [{ at: at + r.at, why: BadMultipart(why) }], ok: false },
    },
  }

/// The spans of a body that ends before its closing delimiter: those it has once one is put
/// after it.
fn closed_spans(
  payload: Bytes,
  at: Int,
  boundary: String,
  parts_left: Int,
) -> Spanned / {email.refused, abort.raise} = {
  let n = bytes_len(payload);
  let shut = bytes_concat_all([payload, b"\r\n--", bytes_of_string(boundary), b"--"]);
  match multipart::parse_spans(shut, boundary, framing(parts_left), Lenient) {
    Ok(found) ->
      {
        spans: map(found, |s: Span| { from: min(s.from, n), to: min(s.to, n) }),
        defects: [{ at: at + n, why: UnclosedBoundary }],
        ok: true,
      },
    Err(r) -> match r.why {
      multipart::TooManyParts -> refuse(at + min(r.at, n), TooManyParts),
      why -> { spans: [], defects: [{ at: at + min(r.at, n), why: BadMultipart(why) }], ok: false },
    },
  }
}

/// What is wrong with the lines of a multipart body that are no part's: its preamble, its
/// delimiters and its epilogue.
fn between(payload: Bytes, at: Int, spans: List<Span>) -> List<Refusal> / {abort.raise} = {
  let cut = fold(spans, { from: 0, out: [] }, |g: { from: Int, out: List<Refusal> }, s: Span|
    {
      from: s.to,
      out: concat(
        g.out,
        line_defects(bytes_slice(payload, g.from, max(s.from, g.from)), at + g.from),
      ),
    });
  concat(cut.out, line_defects(bytes_slice(payload, cut.from, bytes_len(payload)), at + cut.from))
}

/// What is wrong with the body of an entity that is no multipart.
fn leaf_defects(held: List<Field>, payload: Bytes, at: Int) -> List<Refusal> / {abort.raise} = {
  let encoding = encoding_of(held);
  let eight = scan_until(payload, 0, high());
  concat(if encoding == Binary { [] } else { line_defects(payload, at) }, match encoding {
    SevenBit -> if eight < bytes_len(payload) { [{ at: at + eight, why: Undeclared8Bit }] }
    else { [] },
    Base64 -> if clean_base64(payload) == None { [{ at: at, why: BadTransferData }] } else { [] },
    QuotedPrintable -> if unquoted(payload) == None { [{ at: at, why: BadTransferData }] }
    else { [] },
    _ -> [],
  })
}

/// A field, and the byte of the message it starts at.
type Placed = { at: Int, field: Field }

fn placed(held: List<Field>, origin: Int) -> List<Placed> =
  fold(held, { at: origin, out: [] }, |p: { at: Int, out: List<Placed> }, f: Field|
    { at: p.at + bytes_len(f.raw), out: push(p.out, { at: p.at, field: f }) }).out

/// Each field after the first of those named one of `names`, which a header block has once.
fn repeats(held: List<Placed>, names: List<String>) -> List<Refusal> =
  fold(
    held,
    { seen: map_new(), out: [] },
    |r: { seen: Map<String, Unit>, out: List<Refusal> }, p: Placed| {
      let lower = ascii_lower(p.field.name);
      if !list::contains(names, lower) { r } else if map_contains(r.seen, lower) {
        { seen: r.seen, out: push(r.out, { at: p.at, why: Repeated(lower) }) }
      } else { { seen: map_insert(r.seen, lower, ()), out: r.out } }
    },
  ).out

/// What is wrong with the MIME fields of one entity.
fn mime_checks(held: List<Field>, origin: Int, multi: Bool) -> List<Refusal> / {abort.raise} = {
  let all_placed = placed(held, origin);
  concat(
    repeats(all_placed, [
      "content-type",
      "content-transfer-encoding",
      "content-disposition",
      "content-id",
      "mime-version",
    ]),
    flat_map(all_placed, |p: Placed|
      map(mime_check(p.field, multi), |why: Why| { at: p.at, why: why })),
  )
}

fn mime_check(f: Field, multi: Bool) -> List<Why> / {abort.raise} =
  match ascii_lower(f.name) {
    "content-type" -> if media_of([f]).ok { [] } else { [BadMediaType] },
    "content-disposition" -> if disposed([f]).ok { [] } else { [BadDisposition] },
    "content-transfer-encoding" -> match encoding_of([f]) {
      Other(name) -> [BadEncoding(name)],
      QuotedPrintable -> if multi { [BadEncoding("quoted-printable")] } else { [] },
      Base64 -> if multi { [BadEncoding("base64")] } else { [] },
      _ -> [],
    },
    "content-id" -> match parse_message_ids(f.value, Current) {
      Ok([_]) -> [],
      _ -> [BadMessageId],
    },
    _ -> [],
  }

/// What is wrong with the fields of a message's own header block: one it must have and lacks,
/// one it may have once and has again, and each value this module reads that does not read in
/// RFC 5322's current syntax.
fn top_checks(held: List<Field>, utf8: Bool) -> List<Refusal> / {abort.raise} = {
  let all_placed = placed(held, 0);
  let lowered = map(held, |f: Field| ascii_lower(f.name));
  concat(
    concat(
      map(
        filter(["date", "from"], |name: String| !list::contains(lowered, name)),
        |name: String| { at: 0, why: Missing(name) },
      ),
      repeats(all_placed, [
        "date",
        "from",
        "sender",
        "reply-to",
        "to",
        "cc",
        "bcc",
        "message-id",
        "in-reply-to",
        "references",
        "subject",
      ]),
    ),
    flat_map(all_placed, |p: Placed|
      map(
        value_check(ascii_lower(p.field.name), p.field.value, if utf8 { Utf8 } else { Ascii }),
        |why: Why| { at: p.at, why: why },
      )),
  )
}

fn value_check(lower: String, value: String, repertoire: Repertoire) -> List<Why> / {abort.raise} =
  match lower {
    "from" -> match parse_address_list(value, repertoire, Current) {
      Ok(es) -> if all(es, |e: Entry| group_name(e) == None) { [] } else { [Unexpected] },
      Err(r) -> [r.why],
    },
    "sender" -> match parse_mailbox(value, repertoire, Current) { Ok(_) -> [], Err(r) -> [r.why] },
    "reply-to" | "to" | "cc" -> listed_check(value, repertoire),
    "bcc" -> if value == "" { [] } else { listed_check(value, repertoire) },
    "date" -> if date::parse_rfc5322(value) == None { [BadDate] }
    else if obsolete_date(value) { [ObsoleteSyntax] }
    else { [] },
    "message-id" -> match parse_message_ids(value, Current) {
      Ok([_]) -> [],
      Ok(_) -> [BadMessageId],
      Err(r) -> [r.why],
    },
    "in-reply-to" | "references" -> match parse_message_ids(value, Current) {
      Ok([]) -> [BadMessageId],
      Ok(_) -> [],
      Err(r) -> [r.why],
    },
    "subject" | "comments" -> if unworded(value).bad { [BadEncodedWord] } else { [] },
    _ -> [],
  }

fn listed_check(value: String, repertoire: Repertoire) -> List<Why> / {abort.raise} =
  match parse_address_list(value, repertoire, Current) { Ok(_) -> [], Err(r) -> [r.why] }

/// Whether a date that reads is written as only RFC 5322 §4 admits: with a comment anywhere but
/// after it, blanks inside its time, a year of fewer than four digits, or a zone that is a name.
fn obsolete_date(value: String) -> Bool / {abort.raise} = {
  let head = match string::split_once(value, "(") { Some(split) -> split.head, None -> value };
  let cx = cx_of(value, Utf8, Obsolete);
  let after = bytes_len(bytes_of_string(head));
  let words = string::words(head);
  match list::find_index(words, is_clock) {
    None -> true,
    Some(i) ->
      len(words) != i + 2 || !is_year(list::at_or(words, i - 1, ""))
        || !is_zone(list::at_or(words, i + 1, ""))
        || result_ok(try { cfws(cx, after) }) != Some(bytes_len(cx.b)),
  }
}

fn digits() -> Bytes = b"0123456789"

/// Whether `word` is a time as RFC 5322 §3 writes one: `hh:mm` or `hh:mm:ss`.
fn is_clock(word: String) -> Bool / {abort.raise} = {
  let b = bytes_of_string(word);
  let n = bytes_len(b);
  (n == 5 || n == 8) && scan(b, 0, digits()) == 2 && peek(b, 2) == b':' && scan(b, 3, digits()) >= 5
    && (n == 5 || (peek(b, 5) == b':' && scan(b, 6, digits()) == 8))
}

fn is_year(word: String) -> Bool / {abort.raise} = {
  let b = bytes_of_string(word);
  bytes_len(b) >= 4 && scan(b, 0, digits()) == bytes_len(b)
}

fn is_zone(word: String) -> Bool / {abort.raise} = {
  let b = bytes_of_string(word);
  bytes_len(b) == 5 && (peek(b, 0) == b'+' || peek(b, 0) == b'-') && scan(b, 1, digits()) == 5
}

// --- What a message's fields say ------------------------------------------------

fn repertoire_of(m: Message) -> Repertoire = if held(m).utf8 { Utf8 } else { Ascii }

fn listed_in(m: Message, lower: String) -> List<Entry> / {abort.raise} =
  match first(fields_named(held(m).fields, lower)) {
    None -> [],
    Some(f) -> match parse_address_list(f.value, repertoire_of(m), Obsolete) {
      Ok(found) -> found,
      Err(_) -> [],
    },
  }

/// The mailboxes of a message's `From` field, the members of a group among them; none where the
/// message has no such field or its value does not read. Each of the readers below answers
/// nothing likewise, and reads in RFC 5322's obsolete syntax too.
pub fn from(m: Message) -> List<Mailbox> / {abort.raise} = mailboxes_of(listed_in(m, "from"))

/// The mailbox of a message's `Sender` field.
pub fn sender(m: Message) -> Option<Mailbox> / {abort.raise} =
  match header(m, "sender") {
    None -> None,
    Some(value) -> result_ok(parse_mailbox(value, repertoire_of(m), Obsolete)),
  }

/// The address list of a message's `Reply-To` field.
pub fn reply_to(m: Message) -> List<Entry> / {abort.raise} = listed_in(m, "reply-to")

/// The address list of a message's `To` field.
pub fn to(m: Message) -> List<Entry> / {abort.raise} = listed_in(m, "to")

/// The address list of a message's `Cc` field.
pub fn cc(m: Message) -> List<Entry> / {abort.raise} = listed_in(m, "cc")

/// The address list of a message's `Bcc` field.
pub fn bcc(m: Message) -> List<Entry> / {abort.raise} = listed_in(m, "bcc")

/// The instant a message's `Date` field names, as `std.date` reads RFC 5322's dates, the
/// obsolete ones among them: a year of two digits, a zone that is a name.
pub fn date(m: Message) -> Option<OffsetDateTime> =
  match header(m, "date") { Some(value) -> date::parse_rfc5322(value), None -> None }

fn ids_in(m: Message, lower: String) -> List<MessageId> / {abort.raise} =
  match header(m, lower) {
    None -> [],
    Some(value) -> match parse_message_ids(value, Obsolete) { Ok(found) -> found, Err(_) -> [] },
  }

/// A message's own identifier: its `Message-ID` field's.
pub fn id(m: Message) -> Option<MessageId> / {abort.raise} = first(ids_in(m, "message-id"))

/// The identifiers of a message's `In-Reply-To` field.
pub fn in_reply_to(m: Message) -> List<MessageId> / {abort.raise} = ids_in(m, "in-reply-to")

/// The identifiers of a message's `References` field.
pub fn references(m: Message) -> List<MessageId> / {abort.raise} = ids_in(m, "references")

/// The text of a message's first field named `name`, read as an unstructured field: its value
/// with each encoded word decoded. A word that cannot be read, or that carries a control
/// character, is left as written.
pub fn unstructured(m: Message, name: String) -> Option<String> / {abort.raise} =
  match header(m, name) { Some(value) -> Some(unworded(value).text), None -> None }

/// A message's subject: its `Subject` field, read as `unstructured` reads one.
pub fn subject(m: Message) -> Option<String> / {abort.raise} = unstructured(m, "subject")

/// What a message's `MIME-Version` field says once its comments and blanks are taken out, `1.0`
/// for every version there is.
pub fn mime_version(m: Message) -> Option<String> / {abort.raise} =
  match header(m, "mime-version") {
    None -> None,
    Some(value) -> Some(string::replace(string::replace(uncommented(value), " ", ""), "\t", "")),
  }

/// `text` without its comments, each a space in its place, a parenthesis in a quoted string
/// being no comment's: what a MIME field's value is once RFC 5322's comments are taken out.
/// `text` itself where a comment or a quoted string never closes.
fn uncommented(text: String) -> String / {abort.raise} =
  if !string_contains(text, "(") { text } else {
    let cx = cx_of(text, Utf8, Obsolete);
    match try { stripped(cx, 0, [], bytes_len(cx.b) + 1) } {
      Ok(found) -> string_of_bytes(bytes_concat_all(found)),
      Err(_) -> text,
    }
  }

/// `left` bounds the rounds: each takes a quoted string or a comment.
fn stripped(
  cx: Cx,
  at: Int,
  out: List<Bytes>,
  left: Int,
) -> List<Bytes> / {email.refused, abort.raise} = {
  let stop = scan_until(cx.b, at, b"\"(");
  let so_far = push(out, bytes_slice(cx.b, at, stop));
  let c = peek(cx.b, stop);
  if c < 0 || left <= 0 { so_far } else if c == b'"' {
    let q = quoted(cx, stop);
    stripped(cx, q.at, push(so_far, bytes_slice(cx.b, stop, q.at)), left - 1)
  } else {
    stripped(cx, blank(cx, stop + 1, 1, bytes_len(cx.b) - stop), push(so_far, b" "), left - 1)
  }
}

/// A media type read from a `Content-Type` field, and whether the field read.
type Media = { media: MediaType, ok: Bool }

fn media_of(held: List<Field>) -> Media / {abort.raise} =
  match first(fields_named(held, "content-type")) {
    None ->
      { media: MediaType("text", "plain", [{ name: "charset", value: "us-ascii" }]), ok: true },
    Some(f) -> match mime::parse(uncommented(f.value)) {
      Err(_) ->
        { media: MediaType("text", "plain", [{ name: "charset", value: "us-ascii" }]), ok: false },
      Ok(m) -> match mime::join(mime::params(m)) {
        Ok(joined) -> { media: MediaType(mime::top_level(m), mime::subtype(m), joined), ok: true },
        Err(_) -> { media: m, ok: false },
      },
    },
  }

/// A message's media type: its `Content-Type` field's, comments passed over and each parameter
/// RFC 2231 writes in sections or with a charset as one value. `text/plain; charset=us-ascii`
/// where the message has no such field or its value is no media type, as RFC 2045 §5.2 says.
pub fn content_type(m: Message) -> MediaType / {abort.raise} = media_of(held(m).fields).media

/// How a body is written for transfer.
pub type Encoding =
  | SevenBit
  | EightBit
  | Binary
  | QuotedPrintable
  | Base64
  /// Any other encoding, by its name in lower case. `content` undoes none.
  | Other(String)

fn encoding_of(held: List<Field>) -> Encoding / {abort.raise} =
  match first(fields_named(held, "content-transfer-encoding")) {
    None -> SevenBit,
    Some(f) -> match ascii_lower(string_of_chars(trimmed(string_chars(uncommented(f.value))))) {
      "7bit" -> SevenBit,
      "8bit" -> EightBit,
      "binary" -> Binary,
      "quoted-printable" -> QuotedPrintable,
      "base64" -> Base64,
      other -> Other(other),
    },
  }

/// A message's transfer encoding: its `Content-Transfer-Encoding` field's, and `SevenBit` where
/// it has none.
pub fn transfer_encoding(m: Message) -> Encoding / {abort.raise} = encoding_of(held(m).fields)

/// What a `Content-Disposition` field says: `inline` or `attachment` or whatever else it opens
/// with, in lower case, and the file name it gives, which is data a sender chose and no path.
pub type Disposition = new { kind: String, filename: Option<String> }

/// A disposition read, and whether its field read whole.
type Disposed = { found: Option<Disposition>, ok: Bool }

fn disposed(held: List<Field>) -> Disposed / {abort.raise} =
  match first(fields_named(held, "content-disposition")) {
    None -> { found: None, ok: true },
    Some(f) -> {
      let value = uncommented(f.value);
      let b = bytes_of_string(value);
      let kind_end = mime::token_end(b, scan(b, 0, b" \t"));
      let kind = ascii_lower(string_of_bytes(bytes_slice(b, scan(b, 0, b" \t"), kind_end)));
      if kind == "" { { found: None, ok: false } } else {
        match parameters(value, kind_end) {
          Some(joined) ->
            {
              found: Some({
                kind: kind,
                filename: option_map(find(joined, |p: Param| p.name == "filename"), |p: Param|
                  p.value),
              }),
              ok: true,
            },
          None -> { found: Some({ kind: kind, filename: None }), ok: false },
        }
      }
    },
  }

/// The parameters `value` holds from its byte `at` on, each written in sections as one.
fn parameters(value: String, at: Int) -> Option<List<Param>> / {abort.raise} =
  match try { mime::read_params(value, at) } {
    Ok(read) -> result_ok(mime::join(read)),
    Err(_) -> None,
  }

/// What a message's `Content-Disposition` field says; `None` where it has none or its value
/// does not open with a word.
pub fn disposition(m: Message) -> Option<Disposition> / {abort.raise} =
  disposed(held(m).fields).found

/// The identifier of a message's `Content-ID` field, which a `cid:` link in an HTML body names
/// a part by.
pub fn content_id(m: Message) -> Option<MessageId> / {abort.raise} = first(ids_in(m, "content-id"))

// --- What a message's body holds -----------------------------------------------

fn base64_chars() -> Bytes = b"+/0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"

/// The bytes a base64 body stands for where it is nothing but canonical base64 and line breaks.
fn clean_base64(payload: Bytes) -> Option<Bytes> / {abort.raise} =
  if scan_until(payload, 0, high()) < bytes_len(payload) { None }
  else { base64_decode(string_of_bytes(replace(replace(payload, b"\r\n", b""), b"\n", b""))) }

/// The bytes a base64 body stands for, read as RFC 2045 §6.8 has a reader read one: every byte
/// outside the alphabet passed over, what follows the first `=` left out, and padding supplied.
fn robust_base64(payload: Bytes) -> Option<Bytes> / {abort.raise} = {
  let coded = bytes_slice(payload, 0, scan_until(payload, 0, b"="));
  let letters = bytes_concat_all(runs(coded, base64_chars(), 0, [], bytes_len(coded) + 1));
  let n = bytes_len(letters);
  let whole = if n % 4 == 1 { bytes_slice(letters, 0, n - 1) } else { letters };
  base64_decode(
    string_of_bytes(bytes_concat(whole, bytes::repeat(b"=", (4 - bytes_len(whole) % 4) % 4))),
  )
}

/// The runs of `b` from `at` on whose bytes are in `set`. `left` bounds the rounds: each takes
/// a run.
fn runs(b: Bytes, set: Bytes, at: Int, out: List<Bytes>, left: Int) -> List<Bytes> / {abort.raise} = {
  let start = scan_until(b, at, set);
  let end = scan(b, start, set);
  if left <= 0 || start >= bytes_len(b) { out }
  else { runs(b, set, end, push(out, bytes_slice(b, start, end)), left - 1) }
}

fn unquoted(payload: Bytes) -> Option<Bytes> / {abort.raise} =
  if !bytes_is_utf8(payload) { None }
  else { result_ok(quoted_printable::decode(string_of_bytes(payload))) }

/// A message's body with its transfer encoding undone: as it is under `7bit`, `8bit` and
/// `binary`, and decoded under `quoted-printable` and `base64`, the latter read as RFC 2045 has
/// a reader read it, bytes outside its alphabet passed over. `None` for any other encoding, and
/// for a body that is not in the one named. A multipart message's is its body as it is.
pub fn content(m: Message) -> Option<Bytes> / {abort.raise} = {
  let h = held(m);
  match encoding_of(h.fields) {
    SevenBit | EightBit | Binary -> Some(h.body),
    QuotedPrintable -> unquoted(h.body),
    Base64 -> match clean_base64(h.body) {
      Some(found) -> Some(found),
      None -> robust_base64(h.body),
    },
    Other(_) -> None,
  }
}

/// What a part's text is.
pub type Decoded =
  /// The text, read in the charset the part names, each line break a line feed.
  | Text(String)
  /// The part's bytes, its transfer encoding undone, in a charset this module does not read,
  /// with the charset's name in lower case.
  | Unknown(Bytes, String)
  /// The part's bytes, which are no text in the charset it names; or its body as transferred,
  /// where that is not in its transfer encoding.
  | Malformed(Bytes)

/// A message's body as text: its content read in the `charset` its `Content-Type` names,
/// `us-ascii` where it names none, and one of `std.encoded_word`'s. Any other charset answers
/// the bytes and its name, never a guess.
pub fn text(m: Message) -> Decoded / {abort.raise} =
  match content(m) {
    None -> Malformed(body(m)),
    Some(data) -> {
      let name = match mime::charset(content_type(m)) { Some(found) -> found, None -> "us-ascii" };
      match encoded_word::charset_named(name) {
        None -> Unknown(data, name),
        Some(charset) -> match encoded_word::text_of(charset, data) {
          Some(read) -> Text(unbroken(read)),
          None -> Malformed(data),
        },
      }
    },
  }

/// `text` with each line break a line feed alone: no carriage return stands before one.
fn unbroken(text: String) -> String / {abort.raise} =
  if !string_contains(text, "\r\n") { text } else {
    let lines = string_split(text, "\n");
    let end = len(lines) - 1;
    join(
      map(enumerate(lines), |l: { index: Int, value: String }|
        if l.index == end { l.value } else { unreturned(l.value) }),
      "\n",
    )
  }

/// `line` without the carriage returns it ends with.
fn unreturned(line: String) -> String =
  if !string_ends_with(line, "\r") { line } else {
    string_of_chars(
      list::reverse(list::drop_while(list::reverse(string_chars(line)), |c: Char| c == '\r')),
    )
  }

fn is_attached(held: List<Field>) -> Bool / {abort.raise} =
  match disposed(held).found { Some(d) -> d.kind == "attachment", None -> false }

/// Where the part that is a message's body of `text/<subtype>` lies, as the index of a part at
/// each depth.
fn body_path(m: Message, subtype: String) -> Option<List<Int>> / {abort.raise} =
  match m {
    Message(h, []) -> if mime::essence(media_of(h.fields).media) == "text/" ++ subtype
        && !is_attached(h.fields) { Some([]) }
    else { None },
    Message(h, children) -> {
      let lead_alone = mime::subtype(media_of(h.fields).media) == "related";
      fold(
        children,
        { at: 0, found: None },
        |s: { at: Int, found: Option<List<Int>> }, child: Message|
          {
            at: s.at + 1,
            found: if s.found != None || (lead_alone && s.at > 0) { s.found }
            else { option_map(body_path(child, subtype), |path: List<Int>| prepend(s.at, path)) },
          },
      ).found
    },
  }

fn part_at(m: Message, path: List<Int>) -> Option<Message> =
  fold(path, Some(m), |at: Option<Message>, i: Int|
    match at { Some(Message(_, children)) -> list_at(children, i), None -> None })

fn body_text(m: Message, subtype: String) -> Option<Decoded> / {abort.raise} =
  match body_path(m, subtype) { None -> None, Some(path) -> option_map(part_at(m, path), text) }

/// The text a person reads a message as: its first part of `text/plain` that is no attachment,
/// through each multipart body in turn, and of a `multipart/related` body its first part alone.
pub fn text_body(m: Message) -> Option<Decoded> / {abort.raise} = body_text(m, "plain")

/// A message's HTML body: its first part of `text/html` that is no attachment, found as
/// `text_body` finds its part.
pub fn html_body(m: Message) -> Option<Decoded> / {abort.raise} = body_text(m, "html")

/// A file a message carries.
pub type Attachment = new {
  /// The name its `Content-Disposition` gives it. It is data a sender chose, never a path:
  /// `std.multipart`'s `safe_filename` answers the one name it can be kept under.
  filename: Option<String>,
  /// Its media type as the sender named it.
  content_type: MediaType,
  /// Its `Content-ID`, which an HTML body's `cid:` link names it by.
  content_id: Option<MessageId>,
  /// Its bytes, the transfer encoding undone.
  data: Bytes,
}

type Leaf = { path: List<Int>, part: Message }

fn leaves(m: Message, path: List<Int>) -> List<Leaf> =
  match m {
    Message(_, []) -> [{ path: path, part: m }],
    Message(_, children) ->
      fold(children, { at: 0, out: [] }, |l: { at: Int, out: List<Leaf> }, child: Message|
        { at: l.at + 1, out: concat(l.out, leaves(child, push(path, l.at))) }).out,
  }

fn attachment_of(m: Message) -> Attachment / {abort.raise} =
  {
    filename: match disposition(m) { Some(d) -> d.filename, None -> None },
    content_type: content_type(m),
    content_id: content_id(m),
    data: match content(m) { Some(data) -> data, None -> body(m) },
  }

/// Every part of a message that is neither its text body nor its HTML body, in the order
/// written, inline images among them. A part whose transfer encoding cannot be undone holds its
/// body as transferred.
pub fn attachments(m: Message) -> List<Attachment> / {abort.raise} = {
  let plain = body_path(m, "plain");
  let html = body_path(m, "html");
  map(filter(leaves(m, []), |l: Leaf| Some(l.path) != plain && Some(l.path) != html), |l: Leaf|
    attachment_of(l.part))
}

// --- Drafts -------------------------------------------------------------------

/// A message to write: what `write` writes the bytes of.
///
/// Only this module makes one, and every part of it is a value that cannot hold a line break
/// where a field is written of it, so nothing given to a draft can add a field to the message.
pub opaque type Draft = new {
  /// Who wrote the message: one mailbox at least.
  from: List<Mailbox>,
  /// Who sent it, where that is not who wrote it.
  sender: Option<Mailbox>,
  reply_to: List<Entry>,
  to: List<Entry>,
  cc: List<Entry>,
  /// Who else it goes to. `envelope` holds them; `write` leaves the field out unless asked.
  bcc: List<Entry>,
  /// The subject's text, which is written in encoded words where it must be.
  subject: Option<String>,
  /// When it was written, to the second.
  date: OffsetDateTime,
  id: MessageId,
  in_reply_to: List<MessageId>,
  references: List<MessageId>,
  /// Every other field, in the order they are written.
  fields: List<Field>,
  /// The text body, each of its line breaks a line feed.
  text: Option<String>,
  /// The HTML body, each of its line breaks a line feed.
  html: Option<String>,
  /// What the HTML body shows by `cid:` links: the parts of a `multipart/related` body.
  inline: List<Attachment>,
  attachments: List<Attachment>,
}

gen for Draft by drafts

/// A draft from `from` to `to` with no body, written at `date` and known by `id`. Raises
/// `email.refused` for a subject that holds a line break or a control character other than a
/// tab, at its byte.
pub fn draft(
  from: Mailbox,
  to: List<Mailbox>,
  subject: String,
  date: OffsetDateTime,
  id: MessageId,
) -> Draft / {email.refused, abort.raise} =
  {
    from: [from],
    sender: None,
    reply_to: [],
    to: each(to),
    cc: [],
    bcc: [],
    subject: Some(header_text(subject)),
    date: to_the_second(date),
    id: id,
    in_reply_to: [],
    references: [],
    fields: [],
    text: None,
    html: None,
    inline: [],
    attachments: [],
  }

fn to_the_second(o: OffsetDateTime) -> OffsetDateTime =
  match o {
    date::OffsetDateTime(reading, minutes) ->
      date::OffsetDateTime(date::truncate_date_time(reading, date::Seconds), minutes),
  }

/// A draft from `from` to `to` written now, by the host's clock in UTC, and known by an
/// identifier drawn from the host's entropy under `from`'s domain. Raises `email.refused` as
/// `draft` does, and for a domain outside ASCII, which no identifier holds.
pub fn compose(
  from: Mailbox,
  to: List<Mailbox>,
  subject: String,
) -> Draft / {time.now_ms bounded, entropy.next bounded, email.refused, abort.raise} = {
  let now = match date::of_unix_millis(time.now_ms()) {
    Some(read) -> read,
    None -> date::utc(date::at(date::earliest(), date::midnight())),
  };
  draft(from, to, subject, now, fresh_id(domain(address_of(from))))
}

/// `d` written by these mailboxes, raising `email.refused` for none.
pub fn with_from(d: Draft, from: List<Mailbox>) -> Draft / {email.refused} =
  if len(from) == 0 { refuse(0, NoAddress) } else { { ..d, from: from } }

/// `d` sent by `sender` on its authors' behalf.
pub fn with_sender(d: Draft, sender: Mailbox) -> Draft = { ..d, sender: Some(sender) }

/// `d` with replies asked to these addresses.
pub fn with_reply_to(d: Draft, entries: List<Entry>) -> Draft = { ..d, reply_to: entries }

/// `d` addressed to these.
pub fn with_to(d: Draft, entries: List<Entry>) -> Draft = { ..d, to: entries }

/// `d` copied to these.
pub fn with_cc(d: Draft, entries: List<Entry>) -> Draft = { ..d, cc: entries }

/// `d` copied to these without the other recipients being told.
pub fn with_bcc(d: Draft, entries: List<Entry>) -> Draft = { ..d, bcc: entries }

/// `d` under this subject, raising `email.refused` as `draft` does.
pub fn with_subject(d: Draft, subject: String) -> Draft / {email.refused, abort.raise} =
  { ..d, subject: Some(header_text(subject)) }

/// `d` as a reply: `in_reply_to` are the messages it answers, and `references` the thread they
/// stand in, oldest first, as RFC 5322 §3.6.4 fills the two fields.
pub fn with_thread(d: Draft, in_reply_to: List<MessageId>, references: List<MessageId>) -> Draft =
  { ..d, in_reply_to: in_reply_to, references: references }

/// The names of the fields a draft writes itself.
fn managed() -> List<String> =
  [
    "date",
    "from",
    "sender",
    "reply-to",
    "to",
    "cc",
    "bcc",
    "subject",
    "message-id",
    "in-reply-to",
    "references",
    "mime-version",
  ]

fn is_managed(name: String) -> Bool = {
  let lower = ascii_lower(name);
  list::contains(managed(), lower) || string_starts_with(lower, "content-")
}

/// `d` with one more field after those it has, made again of the field's name and value as
/// `field` makes one. Raises `email.refused` as `field` does, and for the name of a field a
/// draft writes itself: `From`, `Subject`, `Content-Type` and the rest.
pub fn with_field(d: Draft, f: Field) -> Draft / {email.refused, abort.raise} =
  if is_managed(f.name) { refuse(0, BadName) }
  else { { ..d, fields: push(d.fields, field(f.name, f.value, Utf8)) } }

/// `d` with `text` for its text body, each line break of it a line feed.
pub fn with_text(d: Draft, text: String) -> Draft / {abort.raise} =
  { ..d, text: Some(unbroken(text)) }

/// `d` with `html` for its HTML body. With a text body too the message is
/// `multipart/alternative`, the text first.
pub fn with_html(d: Draft, html: String) -> Draft / {abort.raise} =
  { ..d, html: Some(unbroken(html)) }

/// `d` with one more attachment, which makes the message `multipart/mixed`.
pub fn attach(d: Draft, a: Attachment) -> Draft = { ..d, attachments: push(d.attachments, a) }

/// `d` with one more part its HTML body shows: an image a `cid:` link names by the part's
/// `content_id`. The HTML body and these are written as `multipart/related`.
pub fn inline(d: Draft, a: Attachment) -> Draft = { ..d, inline: push(d.inline, a) }

/// A file to attach: its name, its bytes, and the media type its name's extension names in
/// `std.mime`'s table, `application/octet-stream` where it names none.
pub fn attachment(filename: String, data: Bytes) -> Attachment / {abort.raise} =
  {
    filename: Some(filename),
    content_type: match mime::of_path(filename) {
      Some(found) -> found,
      None -> MediaType("application", "octet-stream", []),
    },
    content_id: None,
    data: data,
  }

/// `d` with the two fields RFC 8058 has a list's mail carry for one-click unsubscription:
/// `List-Unsubscribe` with each of `uris` in angle brackets, and `List-Unsubscribe-Post`. They
/// take the place of any the draft has. Raises `email.refused` where no URI is an `https:` one,
/// which RFC 8058 requires, or where one holds a blank, a comma, an angle bracket or a character
/// outside printable ASCII, at the index of that URI.
pub fn list_unsubscribe(d: Draft, uris: List<String>) -> Draft / {email.refused, abort.raise} = {
  let fit = |uri: String| {
    let b = bytes_of_string(uri);
    bytes_len(b) > 0 && scan(b, 0, uri_chars()) == bytes_len(b)
  };
  let kept = filter(d.fields, |f: Field| {
    let lower = ascii_lower(f.name);
    lower != "list-unsubscribe" && lower != "list-unsubscribe-post"
  });
  match list::find_index(uris, |uri: String| !fit(uri)) {
    Some(i) -> refuse(i, Unexpected),
    None -> if !any(uris, |uri: String| string_starts_with(ascii_lower(uri), "https:")) {
      refuse(0, Unexpected)
    } else {
      {
        ..d,
        fields: push(
          push(
            kept,
            field("List-Unsubscribe", join(map(uris, |uri: String| "<" ++ uri ++ ">"), ", ")),
          ),
          field("List-Unsubscribe-Post", "List-Unsubscribe=One-Click"),
        ),
      }
    },
  }
}

/// What a URI in a `List-Unsubscribe` field is made of: printable ASCII but a space, a comma and
/// the angle brackets.
fn uri_chars() -> Bytes =
  b"!\"#$%&'()*+-./0123456789:;=?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"

// --- Writing ------------------------------------------------------------------

/// Whether `write` writes a draft's `Bcc` field.
pub type Bcc =
  /// The field is left out: the copy every recipient gets.
  | Dropped
  /// The field is written: the copy a sender keeps.
  | Kept

/// The message `d` is, raising `email.unwritable` where `build` answers `Err`.
///
/// The fields are `Date`, `From`, `Sender`, `Reply-To`, `To`, `Cc`, `Bcc` where asked, `Subject`,
/// `Message-ID`, `In-Reply-To`, `References`, the draft's other fields and `MIME-Version`, each
/// only where the draft has something for it. A display name and a subject are written as they
/// are where that reads back, in quotes where a name must be, and in UTF-8 encoded words
/// otherwise; under `Utf8` text outside ASCII is written as it is. A line is folded at a space
/// before it passes 78 octets wherever one stands, and none passes 998. The body is `text/plain`,
/// `text/html`, or `multipart/alternative` of the two; the HTML with its inline parts is
/// `multipart/related`; and with attachments the whole is `multipart/mixed`. Each part's transfer
/// encoding is chosen from its bytes: `7bit` where they are lines of ASCII, `quoted-printable`
/// where few of them need an escape, and `base64` otherwise. `boundary` sets the outermost
/// multipart body's parts apart, and a body within that one has `2-` or `3-` before it, so a
/// boundary is at most 68 of RFC 2046's characters where bodies nest.
pub fn write(
  d: Draft,
  boundary: String,
  repertoire: Repertoire = Ascii,
  bcc: Bcc = Dropped,
) -> Bytes / {email.unwritable, abort.raise} = {
  let utf8 = repertoire == Utf8;
  let payload = payload_of(d, boundary);
  bytes_concat_all(
    concat(
      [
        folded("Date", [" " ++ date::rfc5322(d.date)]),
        addressed("From", each(d.from), utf8),
        addressed("Sender", match d.sender { Some(s) -> [One(s)], None -> [] }, utf8),
        addressed("Reply-To", d.reply_to, utf8),
        addressed("To", d.to, utf8),
        addressed("Cc", d.cc, utf8),
        addressed("Bcc", if bcc == Kept { d.bcc } else { [] }, utf8),
        match d.subject { Some(s) -> folded("Subject", text_stretches(s, utf8)), None -> b"" },
        identified("Message-ID", [d.id]),
        identified("In-Reply-To", d.in_reply_to),
        identified("References", d.references),
      ],
      concat(map(d.fields, |f: Field| carried(f, utf8)), [
        b"MIME-Version: 1.0\r\n",
        payload.head,
        b"\r\n",
        payload.data,
      ]),
    ),
  )
}

/// The message `d` is, or why it has no bytes.
pub fn build(
  d: Draft,
  boundary: String,
  repertoire: Repertoire = Ascii,
  bcc: Bcc = Dropped,
) -> Result<Bytes, Unwritable> / {abort.raise} = try { write(d, boundary, repertoire, bcc) }

/// The message `d` is under a boundary drawn from the host's entropy, raising
/// `email.unwritable` as `write` does.
pub fn write_fresh(
  d: Draft,
  repertoire: Repertoire = Ascii,
  bcc: Bcc = Dropped,
) -> Bytes / {entropy.next bounded, email.unwritable, abort.raise} =
  write(d, multipart::fresh_boundary(), repertoire, bcc)

/// A field's lines as a draft holds them, where the repertoire admits them.
fn carried(f: Field, utf8: Bool) -> Bytes / {email.unwritable, abort.raise} =
  if !utf8 && scan_until(f.raw, 0, high()) < bytes_len(f.raw) { email.unwritable(NeedsUtf8) }
  else { f.raw }

fn identified(name: String, held: List<MessageId>) -> Bytes / {abort.raise} =
  if len(held) == 0 { b"" } else { folded(name, map(held, |i: MessageId| " " ++ id_text(i))) }

/// The field `name` of these addresses; nothing for none.
fn addressed(
  name: String,
  held: List<Entry>,
  utf8: Bool,
) -> Bytes / {email.unwritable, abort.raise} =
  if len(held) == 0 { b"" } else {
    let end = len(held) - 1;
    folded(
      name,
      flat_map(enumerate(held), |e: { index: Int, value: Entry }|
        marked(entry_stretches(e.value, utf8), if e.index < end { "," } else { "" })),
    )
  }

/// `cut` with `mark` after its last stretch.
fn marked(cut: List<String>, mark: String) -> List<String> / {abort.raise} =
  match last(cut) { Some(end) -> list_set(cut, len(cut) - 1, end ++ mark), None -> cut }

fn entry_stretches(e: Entry, utf8: Bool) -> List<String> / {email.unwritable, abort.raise} =
  match e {
    One(m) -> mailbox_stretches(m, utf8),
    Group(name, held) -> {
      let end = len(held) - 1;
      let written = name_stretches(name, utf8);
      let coded = match last(written) { Some(w) -> string_ends_with(w, "?="), None -> false };
      marked(
        concat(
          marked(written, if coded { " :" } else { ":" }),
          flat_map(enumerate(held), |m: { index: Int, value: Mailbox }|
            marked(mailbox_stretches(m.value, utf8), if m.index < end { "," } else { "" })),
        ),
        ";",
      )
    },
  }

fn mailbox_stretches(m: Mailbox, utf8: Bool) -> List<String> / {email.unwritable, abort.raise} =
  match m {
    Mailbox(None, a) -> [" " ++ wire_address(a, utf8)],
    Mailbox(Some(name), a) ->
      push(name_stretches(name, utf8), " <" ++ wire_address(a, utf8) ++ ">"),
  }

/// An address as a field carries it: as written under `Utf8`, and in ASCII otherwise, a domain
/// written outside it as its A-labels.
fn wire_address(a: Address, utf8: Bool) -> String / {email.unwritable} =
  if utf8 { address_text(a) }
  else { match ascii_text(a) { Some(text) -> text, None -> email.unwritable(NeedsUtf8) } }

/// The stretches that carry a display name: its words where it is atoms with one space between
/// them, a quoted string where it is printable, and encoded words otherwise.
fn name_stretches(name: String, utf8: Bool) -> List<String> / {abort.raise} = {
  let b = bytes_of_string(name);
  let printed = !string_contains(name, "=?")
    && scan(b, 0, bytes_concat(if utf8 { printable_wide() } else { printable() }, b"\t"))
    == bytes_len(b)
    && !has_c1(name);
  let cut = stretches(if printed && is_words(name) { name } else { quote(name) });
  if printed && all(cut, |s: String| bytes_len(bytes_of_string(s)) <= 900) { cut }
  else { map(encode_words(name, coding_for(name)), |w: String| " " ++ w) }
}

/// The draft's body as one entity: its `Content` fields and its bytes.
fn payload_of(d: Draft, boundary: String) -> Written / {email.unwritable, abort.raise} = {
  let attached = map(enumerate(d.attachments), |a: { index: Int, value: Attachment }|
    file_part(a.value, len(d.inline) + a.index, "attachment"));
  if len(attached) == 0 {
    match core_part(d, boundary, 1) { Some(found) -> found, None -> { head: b"", data: b"" } }
  } else {
    multi(
      "mixed",
      match core_part(d, boundary, 2) { Some(found) -> prepend(found, attached), None -> attached },
      nested(boundary, 1),
    )
  }
}

/// The boundary of a multipart body `level` bodies deep.
fn nested(boundary: String, level: Int) -> String =
  if level <= 1 { boundary } else { int_to_string(level) ++ "-" ++ boundary }

/// The text body, the HTML body, or both as alternatives, where the next multipart body is
/// `level` deep.
fn core_part(
  d: Draft,
  boundary: String,
  level: Int,
) -> Option<Written> / {email.unwritable, abort.raise} =
  match d.text {
    None -> page_part(d, boundary, level),
    Some(plain) -> match page_part(d, boundary, level + 1) {
      None -> Some(text_part(plain, "plain")),
      Some(page) ->
        Some(multi("alternative", [text_part(plain, "plain"), page], nested(boundary, level))),
    },
  }

/// The HTML body, with its inline parts where it has any.
fn page_part(
  d: Draft,
  boundary: String,
  level: Int,
) -> Option<Written> / {email.unwritable, abort.raise} =
  match d.html {
    None -> if len(d.inline) > 0 { email.unwritable(NoHtml) } else { None },
    Some(html) -> if len(d.inline) == 0 { Some(text_part(html, "html")) } else {
      Some(
        multi(
          "related",
          prepend(
            text_part(html, "html"),
            map(enumerate(d.inline), |a: { index: Int, value: Attachment }|
              file_part(a.value, a.index, "inline")),
          ),
          nested(boundary, level),
        ),
      )
    },
  }

/// A multipart entity of these parts.
fn multi(
  subtype: String,
  held: List<Written>,
  boundary: String,
) -> Written / {email.unwritable, abort.raise} =
  match try { multipart::frame(held, boundary) } {
    Err(why) -> email.unwritable(Framing(why)),
    Ok(data) ->
      {
        head: folded(
          "Content-Type",
          param_stretches("multipart/" ++ subtype, [{ name: "boundary", value: boundary }]),
        ),
        data: data,
      },
  }

fn param_stretches(lead: String, held: List<Param>) -> List<String> = {
  let end = len(held) - 1;
  prepend(
    " " ++ lead ++ (if len(held) > 0 { ";" } else { "" }),
    map(enumerate(held), |p: { index: Int, value: Param }|
      " " ++ mime::param_text(p.value) ++ (if p.index < end { ";" } else { "" })),
  )
}

/// A part's body in the transfer encoding its bytes are best written in, and the encoding's
/// name.
type Coded = { encoding: String, data: Bytes }

/// `wire`, a body as it would be transferred as it is, encoded where it must be. `text` is the
/// body's text where its line breaks are to stay line breaks.
fn coded(wire: Bytes, text: Option<String>) -> Coded / {abort.raise} =
  if scan(wire, 0, seven_bit()) == bytes_len(wire) && len(line_defects(wire, 0)) == 0 {
    { encoding: "7bit", data: wire }
  } else if mostly(wire, qp_plain()) {
    {
      encoding: "quoted-printable",
      data: bytes_of_string(match text {
        Some(lines) -> quoted_printable::encode_text(lines),
        None -> quoted_printable::encode(wire),
      }),
    }
  } else {
    let letters = bytes_of_string(base64_encode(wire));
    let n = bytes_len(letters);
    {
      encoding: "base64",
      data: bytes::join(
        map(range(0, (n + 75) / 76), |i: Int| bytes_slice(letters, i * 76, min(n, i * 76 + 76))),
        b"\r\n",
      ),
    }
  }

/// Every byte a `7bit` body may hold: ASCII but NUL.
const fn seven_bit() -> Bytes = bytes_concat_all(map(range(1, 128), byte_of_int))

/// What quoted-printable writes as itself.
fn qp_plain() -> Bytes =
  b"\t\r\n !\"#$%&'()*+,-./0123456789:;<>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"

fn text_part(text: String, subtype: String) -> Written / {abort.raise} = {
  let wire = replace(bytes_of_string(text), b"\n", b"\r\n");
  let ascii = scan_until(wire, 0, high()) >= bytes_len(wire);
  let body = coded(wire, Some(text));
  {
    head: bytes_of_string(
      "Content-Type: text/" ++ subtype ++ "; charset=" ++ (if ascii { "us-ascii" } else { "utf-8" })
        ++ "\r\nContent-Transfer-Encoding: "
        ++ body.encoding
        ++ "\r\n",
    ),
    data: body.data,
  }
}

/// The part an attachment is, under the disposition `kind`.
fn file_part(a: Attachment, index: Int, kind: String) -> Written / {email.unwritable, abort.raise} = {
  let top = mime::top_level(a.content_type);
  let held = mime::params(a.content_type);
  let fit = is_token(top) && is_token(mime::subtype(a.content_type)) && top != "multipart"
    && top != "message"
    && all(held, |p: Param|
      is_token(p.name) && !string_contains(p.name, "*") && string_len(p.name) <= 40);
  if !fit { email.unwritable(UnfitAttachment(index)) } else {
    let body = coded(a.data, None);
    {
      head: bytes_concat_all([
        folded(
          "Content-Type",
          param_stretches(
            mime::essence(a.content_type),
            flat_map(held, |p: Param| mime::sectioned(ascii_lower(p.name), p.value, 60)),
          ),
        ),
        bytes_of_string("Content-Transfer-Encoding: " ++ body.encoding ++ "\r\n"),
        folded(
          "Content-Disposition",
          param_stretches(kind, match a.filename {
            Some(name) -> mime::sectioned("filename", name, 60),
            None -> [],
          }),
        ),
        match a.content_id { Some(i) -> identified("Content-ID", [i]), None -> b"" },
      ]),
      data: body.data,
    }
  }
}

// --- The draft a message is of ------------------------------------------------

type Core = { text: Option<String>, html: Option<String>, inline: List<Attachment> }

fn is_leaf(m: Message) -> Bool / {abort.raise} =
  match m { Message(h, []) -> mime::top_level(media_of(h.fields).media) != "multipart", _ -> false }

/// The text of a part that is `text/<subtype>` and reads in its charset.
fn leaf_text(m: Message, subtype: String) -> Option<String> / {abort.raise} =
  if !is_leaf(m) || mime::essence(content_type(m)) != "text/" ++ subtype { None }
  else { match text(m) { Text(read) -> Some(read), _ -> None } }

fn page_of(m: Message) -> Option<Core> / {abort.raise} =
  match leaf_text(m, "html") {
    Some(read) -> Some({ text: None, html: Some(read), inline: [] }),
    None -> if mime::essence(content_type(m)) != "multipart/related" { None } else {
      match parts(m) {
        [] -> None,
        [page, ..shown] -> match leaf_text(page, "html") {
          Some(read) -> if !all(shown, is_leaf) { None }
          else { Some({ text: None, html: Some(read), inline: map(shown, attachment_of) }) },
          None -> None,
        },
      }
    },
  }

fn core_of(m: Message) -> Option<Core> / {abort.raise} =
  match leaf_text(m, "plain") {
    Some(read) -> {
      let h = held(m);
      let bare = bytes_len(h.body) == 0 && len(fields_named(h.fields, "content-type")) == 0;
      Some({ text: if bare { None } else { Some(read) }, html: None, inline: [] })
    },
    None -> if mime::essence(content_type(m)) != "multipart/alternative" { page_of(m) } else {
      match parts(m) {
        [plain, rich] -> match leaf_text(plain, "plain") {
          Some(read) -> option_map(page_of(rich), |page: Core| { ..page, text: Some(read) }),
          None -> None,
        },
        _ -> None,
      }
    },
  }

type Shape = { core: Core, attachments: List<Attachment> }

fn shape_of(m: Message) -> Option<Shape> / {abort.raise} =
  if mime::essence(content_type(m)) != "multipart/mixed" {
    option_map(core_of(m), |core: Core| { core: core, attachments: [] })
  } else {
    match parts(m) {
      [] -> None,
      [lead, ..rest] -> if !all(rest, is_leaf) { None }
      else if is_leaf(lead) && is_attached(held(lead).fields) {
        Some({
          core: { text: None, html: None, inline: [] },
          attachments: map(parts(m), attachment_of),
        })
      } else {
        option_map(core_of(lead), |core: Core|
          { core: core, attachments: map(rest, attachment_of) })
      },
    }
  }

/// The draft a message is of: what `write` writes it, or a message that says the same, from.
/// `None` where the message has no author, date or identifier that reads, a subject or another
/// field no draft holds, or a body that is not one of a draft's: text, HTML, the two as
/// alternatives, the HTML with inline parts, and any of these with attachments.
pub fn drafted(m: Message) -> Option<Draft> / {abort.raise} = {
  let h = held(m);
  let others = map(filter(h.fields, |f: Field| !is_managed(f.name)), |f: Field|
    result_ok(try { field(f.name, f.value, Utf8) }));
  let topic = match subject(m) {
    Some(read) -> if is_quotable(read) { Some(Some(read)) } else { None },
    None -> Some(None),
  };
  match shape_of(m) {
    None -> None,
    Some(shape) -> match drafted_head(m, topic, list::somes(others)) {
      None -> None,
      Some(head) -> if len(others) != len(head.fields) { None } else {
        Some({
          ..head,
          text: shape.core.text,
          html: shape.core.html,
          inline: shape.core.inline,
          attachments: shape.attachments,
        })
      },
    },
  }
}

/// The draft of a message's fields, with no body.
fn drafted_head(
  m: Message,
  topic: Option<Option<String>>,
  others: List<Field>,
) -> Option<Draft> / {abort.raise} =
  match from(m) {
    [] -> None,
    authors -> match date(m) {
      None -> None,
      Some(when) -> match id(m) {
        None -> None,
        Some(known) -> match topic {
          None -> None,
          Some(said) ->
            Some({
              from: authors,
              sender: sender(m),
              reply_to: reply_to(m),
              to: to(m),
              cc: cc(m),
              bcc: bcc(m),
              subject: said,
              date: to_the_second(when),
              id: known,
              in_reply_to: in_reply_to(m),
              references: references(m),
              fields: others,
              text: None,
              html: None,
              inline: [],
              attachments: [],
            }),
        },
      },
    },
  }

// --- Who a message goes to ----------------------------------------------------

/// What a transport is handed beside a message's bytes.
pub type Envelope = new {
  /// Who the message is sent as: a draft's `Sender`, or else the first of its authors.
  sender: Address,
  /// Every address it goes to, once each.
  recipients: List<Address>,
  /// Whether a local part here is outside ASCII, so that only a path offering `SMTPUTF8` takes
  /// it. Any other path is handed each address as `ascii_text` writes it.
  utf8: Bool,
}

/// Every address a draft goes to: those of `To`, `Cc` and `Bcc` in that order, the members of a
/// group among them, each once however its domain is cased or spelled.
pub fn recipients(d: Draft) -> List<Address> =
  fold(
    map(mailboxes_of(concat(concat(d.to, d.cc), d.bcc)), address_of),
    [],
    |acc: List<Address>, a: Address| push_unique(acc, a),
  )

/// What a transport is handed beside the bytes `write` writes: who the draft is sent as, and who
/// it goes to, the `Bcc` recipients `write` leaves out among them.
pub fn envelope(d: Draft) -> Envelope / {abort.raise} = {
  let sent_as = match d.sender {
    Some(s) -> address_of(s),
    None -> match first(d.from) {
      Some(m) -> address_of(m),
      None -> panic("a draft has an author"),
    },
  };
  let to_all = recipients(d);
  { sender: sent_as, recipients: to_all, utf8: !is_ascii(sent_as) || !all(to_all, is_ascii) }
}

// --- Canonical forms ----------------------------------------------------------

/// One of the two forms RFC 6376 §3.4 takes a signature over.
pub type Canonical =
  /// The bytes as they are, but for empty lines at the body's end.
  | Simple
  /// Blanks squeezed and a field's name in lower case, so that what a relay may change of them
  /// changes nothing.
  | Relaxed

/// A header field in a canonical form (RFC 6376 §3.4.1, §3.4.2): under `Simple` its lines as
/// they are; under `Relaxed` its name in lower case, a colon, and its value unfolded with each
/// run of blanks one space and none at either end, then a CRLF.
pub fn canonical_field(f: Field, form: Canonical) -> Bytes / {abort.raise} =
  match form {
    Simple -> f.raw,
    Relaxed -> {
      let n = bytes_len(f.raw);
      let colon = match bytes_index_of_byte(f.raw, b':') { Some(i) -> i + 1, None -> n };
      let value = replace(replace(bytes_slice(f.raw, colon, n), b"\r", b""), b"\n", b"");
      bytes_concat_all([
        bytes_of_string(ascii_lower(f.name)),
        b":",
        bytes::join(unblank(value, 0, [], bytes_len(value) + 1), b" "),
        b"\r\n",
      ])
    },
  }

/// The stretches of `b` between its blanks. `left` bounds the rounds: each takes one.
fn unblank(b: Bytes, at: Int, out: List<Bytes>, left: Int) -> List<Bytes> / {abort.raise} = {
  let start = scan(b, at, b" \t");
  let end = scan_until(b, start, b" \t");
  if left <= 0 || start >= bytes_len(b) { out }
  else { unblank(b, end, push(out, bytes_slice(b, start, end)), left - 1) }
}

/// A body in a canonical form (RFC 6376 §3.4.3, §3.4.4): under `Simple` as it is but for the
/// empty lines at its end, which are dropped, and one CRLF after its last line, so a body of
/// nothing is a CRLF; under `Relaxed` also each line without the blanks at its end and with each
/// other run of blanks one space, and a body of nothing is nothing.
pub fn canonical_body(payload: Bytes, form: Canonical) -> Bytes / {abort.raise} =
  match form {
    Simple -> bytes_concat(bytes_slice(payload, 0, unended(payload, bytes_len(payload))), b"\r\n"),
    Relaxed -> {
      let lines = map(bytes_split(payload, b"\r\n"), squeezed);
      let kept = list::reverse(
        list::drop_while(list::reverse(lines), |l: Bytes| bytes_len(l) == 0),
      );
      if len(kept) == 0 { b"" } else { bytes_concat(bytes::join(kept, b"\r\n"), b"\r\n") }
    },
  }

/// Where `b` ends once the CRLFs its first `n` bytes end with are taken off.
fn unended(b: Bytes, n: Int) -> Int / {abort.raise} =
  if n >= 2 && bytes_at(b, n - 2) == b'\r' && bytes_at(b, n - 1) == b'\n' { unended(b, n - 2) }
  else { n }

/// A line with each run of blanks one space, and none at its end.
fn squeezed(line: Bytes) -> Bytes / {abort.raise} = {
  let words = bytes::join(unblank(line, 0, [], bytes_len(line) + 1), b" ");
  if bytes_len(words) > 0 && bytes::is_blank(peek(line, 0)) { bytes_concat(b" ", words) }
  else { words }
}

// --- Drawing drafts -----------------------------------------------------------

fn drawn_subject() -> Gen<String> =
  gen::one_of([
    several(drawn("abcXYZ019", 1, 8), " "),
    drawn("ab =?_.,:;\"\\<>()\t\u{e9}\u{65e5}\u{1f600}", 0, 12),
    gen::map2(drawn("ab \u{e9}", 0, 6), gen::int_between(70, 1100), |lead: String, n: Int|
      lead ++ string::repeat("x", n)),
    gen::map(gen::list_of_length(drawn("abcdefgh", 3, 9), 30), |words: List<String>|
      join(words, " ")),
  ])

fn drawn_body() -> Gen<String> =
  gen::one_of([
    drawn("ab \n", 0, 24),
    gen::map(drawn("a\u{e9}\n\r=. \t-", 0, 30), unbroken),
    gen::map(gen::int_between(990, 1010), |n: Int| string::repeat("y", n)),
    drawn("\u{65e5}\u{672c}\u{8a9e}\n", 1, 20),
  ])

fn drawn_date() -> Gen<OffsetDateTime> =
  gen::map2(
    gen::int_between(0, 4102444800),
    gen::int_between(-720, 840),
    |seconds: Int, east: Int|
      match date::of_unix_seconds(seconds) {
        Some(at) -> match date::in_offset(at, east) { Some(there) -> there, None -> at },
        None -> date::utc(date::at(date::earliest(), date::midnight())),
      },
  )

fn drawn_field() -> Gen<Field> =
  gen::map(
    gen::elements([
      { name: "X-Mailer", value: "ply" },
      { name: "Keywords", value: "one, two,  three" },
      { name: "List-Id", value: "A list <list.example.org>" },
      { name: "X-Note", value: "caf\u{e9} =?UTF-8?Q?as_written?=" },
      {
        name: "X-Long",
        value: "a long value that is folded where it has a space to fold at and no sooner than it has to be",
      },
    ]),
    |p: Param|
      match try { field(p.name, p.value, Utf8) } {
        Ok(made) -> made,
        Err(_) -> { name: "X-None", raw: b"X-None:\r\n", value: "" },
      },
  )

fn drawn_file() -> Gen<Attachment> =
  gen::map2(
    gen::map2(
      gen::option_of(drawn("ab.c d\u{e9}\"\\;%'*/", 0, 12)),
      gen::option_of(ids()),
      |filename: Option<String>, content_id: Option<MessageId>|
        { filename: filename, content_id: content_id },
    ),
    gen::map2(
      gen::elements([
        MediaType("application", "octet-stream", []),
        MediaType("image", "png", []),
        MediaType("text", "plain", [{ name: "charset", value: "utf-8" }]),
        MediaType("text", "csv", [
          { name: "header", value: "present" },
          { name: "title", value: "a \"b\" \u{e9}" },
        ]),
      ]),
      gen::one_of([
        gen::and_then(gen::int_between(0, 60), |n: Int| gen::bytes_of(n)),
        gen::map(drawn("ab \r\n", 0, 40), bytes_of_string),
        gen::map(drawn("ab\n", 0, 40), |lines: String|
          replace(bytes_of_string(lines), b"\n", b"\r\n")),
      ]),
      |content_type: MediaType, data: Bytes| { content_type: content_type, data: data },
    ),
    |named_as: { filename: Option<String>, content_id: Option<MessageId> }, held: { content_type: MediaType, data: Bytes }|
      {
        filename: named_as.filename,
        content_type: held.content_type,
        content_id: named_as.content_id,
        data: held.data,
      },
  )

fn drawn_shape() -> Gen<Shape> =
  gen::map2(
    gen::map2(
      gen::map2(
        gen::option_of(drawn_body()),
        gen::option_of(drawn_body()),
        |text: Option<String>, html: Option<String>| { text: text, html: html },
      ),
      gen::list_of(drawn_file(), 2),
      |said: { text: Option<String>, html: Option<String> }, inline: List<Attachment>|
        { text: said.text, html: said.html, inline: if said.html == None { [] } else { inline } },
    ),
    gen::list_of(drawn_file(), 2),
    |core: Core, attached: List<Attachment>| { core: core, attachments: attached },
  )

type Parties = { author: Mailbox, sender: Option<Mailbox>, lists: List<List<Entry>> }

fn drawn_parties() -> Gen<Parties> =
  gen::map2(
    gen::map2(
      mailboxes(),
      gen::option_of(mailboxes()),
      |author: Mailbox, sender: Option<Mailbox>| { author: author, sender: sender },
    ),
    gen::list_of_length(gen::list_of(entries(), 2), 4),
    |lead: { author: Mailbox, sender: Option<Mailbox> }, lists: List<List<Entry>>|
      { author: lead.author, sender: lead.sender, lists: lists },
  )

type Stamp = {
  subject: Option<String>,
  date: OffsetDateTime,
  id: MessageId,
  threads: List<List<MessageId>>,
  fields: List<Field>,
}

fn drawn_stamp() -> Gen<Stamp> =
  gen::map2(
    gen::map2(
      gen::option_of(drawn_subject()),
      drawn_date(),
      |subject: Option<String>, date: OffsetDateTime| { subject: subject, date: date },
    ),
    gen::map2(
      gen::map2(
        ids(),
        gen::list_of_length(gen::list_of(ids(), 2), 2),
        |id: MessageId, threads: List<List<MessageId>>| { id: id, threads: threads },
      ),
      gen::list_of(drawn_field(), 2),
      |known: { id: MessageId, threads: List<List<MessageId>> }, others: List<Field>|
        { id: known.id, threads: known.threads, fields: others },
    ),
    |said: { subject: Option<String>, date: OffsetDateTime }, rest: { id: MessageId, threads: List<List<MessageId>>, fields: List<Field> }|
      {
        subject: said.subject,
        date: said.date,
        id: rest.id,
        threads: rest.threads,
        fields: rest.fields,
      },
  )

/// Drafts of every shape `write` writes: with and without each address field, a subject, a
/// thread and other fields, a text and an HTML body, inline parts and attachments.
pub fn drafts() -> Gen<Draft> =
  gen::map2(
    gen::map2(drawn_parties(), drawn_stamp(), |who: Parties, stamp: Stamp|
      { who: who, stamp: stamp }),
    drawn_shape(),
    |head: { who: Parties, stamp: Stamp }, shape: Shape|
      {
        from: [head.who.author],
        sender: head.who.sender,
        reply_to: list::at_or(head.who.lists, 0, []),
        to: list::at_or(head.who.lists, 1, []),
        cc: list::at_or(head.who.lists, 2, []),
        bcc: list::at_or(head.who.lists, 3, []),
        subject: head.stamp.subject,
        date: head.stamp.date,
        id: head.stamp.id,
        in_reply_to: list::at_or(head.stamp.threads, 0, []),
        references: list::at_or(head.stamp.threads, 1, []),
        fields: head.stamp.fields,
        text: shape.core.text,
        html: shape.core.html,
        inline: shape.core.inline,
        attachments: shape.attachments,
      },
  )

// --- Tests ------------------------------------------------------------------

type Listing = { text: String, read: String }

/// Address lists and what each reads as, as `show` writes one. The first five are RFC 5322
/// Appendix A.1.2's and A.1.3's, the next three A.5's, the next three A.6's obsolete forms, and
/// the five after them the fields of RFC 2047 §8.
fn listings() -> List<Listing> =
  [
    {
      text: "Mary Smith <mary@x.test>, jdoe@example.org, Who? <one@y.test>",
      read: "Mary Smith <mary@x.test>, jdoe@example.org, Who? <one@y.test>",
    },
    {
      text: "<boss@nil.test>, \"Giant; \\\"Big\\\" Box\" <sysservices@example.net>",
      read: "boss@nil.test, \"Giant; \\\"Big\\\" Box\" <sysservices@example.net>",
    },
    {
      text: "\"Joe Q. Public\" <john.q.public@example.com>",
      read: "\"Joe Q. Public\" <john.q.public@example.com>",
    },
    {
      text: "A Group:Ed Jones <c@a.test>,joe@where.test,John <jdoe@one.test>;",
      read: "A Group:Ed Jones <c@a.test>, joe@where.test, John <jdoe@one.test>;",
    },
    { text: "Undisclosed recipients:;", read: "Undisclosed recipients:;" },
    {
      text: "Pete(A nice \\) chap) <pete(his account)@silly.test(his host)>",
      read: "Pete <pete@silly.test>",
    },
    {
      text: "A Group(Some people)     :Chris Jones <c@(Chris's host.)public.example>,         joe@example.org,  John <jdoe@one.test> (my dear friend); (the end of the group)",
      read: "A Group:Chris Jones <c@public.example>, joe@example.org, John <jdoe@one.test>;",
    },
    {
      text: "(Empty list)(start)Hidden recipients  :(nobody(that I know))  ;",
      read: "Hidden recipients:;",
    },
    {
      text: "Joe Q. Public <john.q.public@example.com>",
      read: "\"Joe Q. Public\" <john.q.public@example.com>",
    },
    {
      text: "Mary Smith <@node.test:mary@example.net>, , jdoe@test  . example",
      read: "Mary Smith <mary@example.net>, jdoe@test.example",
    },
    { text: "John Doe <jdoe@machine(comment).  example>", read: "John Doe <jdoe@machine.example>" },
    {
      text: "=?US-ASCII?Q?Keith_Moore?= <moore@cs.utk.edu>",
      read: "Keith Moore <moore@cs.utk.edu>",
    },
    {
      text: "=?ISO-8859-1?Q?Keld_J=F8rn_Simonsen?= <keld@dkuug.dk>",
      read: "Keld J\u{f8}rn Simonsen <keld@dkuug.dk>",
    },
    {
      text: "=?ISO-8859-1?Q?Andr=E9?= Pirard <PIRARD@vm1.ulg.ac.be>",
      read: "Andr\u{e9} Pirard <PIRARD@vm1.ulg.ac.be>",
    },
    {
      text: "Nathaniel Borenstein <nsb@thumper.bellcore.com> (=?iso-8859-8?b?7eXs+SDv4SDp7Oj08A==?=)",
      read: "Nathaniel Borenstein <nsb@thumper.bellcore.com>",
    },
    {
      text: "Greg Vaudreuil <gvaudre@NRI.Reston.VA.US>, Ned Freed <ned@innosoft.com>, Keith Moore <moore@cs.utk.edu>",
      read: "Greg Vaudreuil <gvaudre@NRI.Reston.VA.US>, Ned Freed <ned@innosoft.com>, Keith Moore <moore@cs.utk.edu>",
    },
    {
      text: "=?UTF-8?Q?J=C3=BCrgen?= =?UTF-8?Q?_M?= <j@example.org>",
      read: "J\u{fc}rgen M <j@example.org>",
    },
    { text: "\"=?UTF-8?Q?J=C3=BCrgen?=\" <j@example.org>", read: "J\u{fc}rgen <j@example.org>" },
    { text: "=?x-unknown?Q?a?= <j@example.org>", read: "\"=?x-unknown?Q?a?=\" <j@example.org>" },
    {
      text: "=?UTF-8?Q?a=0D=0ABcc=3A_x?= <j@example.org>",
      read: "\"=?UTF-8?Q?a=0D=0ABcc=3A_x?=\" <j@example.org>",
    },
    {
      text: "\"john doe\"@example.org, \"a,b <c>\"@example.org, \"quo\\\"te\"@example.org",
      read: "\"john doe\"@example.org, \"a,b <c>\"@example.org, \"quo\\\"te\"@example.org",
    },
    { text: "\"john.doe\"@example.org", read: "john.doe@example.org" },
    { text: "\"john\" . doe@example.org", read: "john.doe@example.org" },
    { text: "\"\"@example.org", read: "\"\"@example.org" },
    {
      text: "a@[192.0.2.1], b@[IPv6:2001:db8::1], c@[ 192.0.2.1 ]",
      read: "a@[192.0.2.1], b@[IPv6:2001:db8::1], c@[192.0.2.1]",
    },
    { text: "user@xn--bcher-kva.example", read: "user@xn--bcher-kva.example" },
    { text: "John.Doe@Example.ORG", read: "John.Doe@Example.ORG" },
    { text: "\"\" <a@example.org>", read: "a@example.org" },
    { text: "a@example.org,,b@example.org,", read: "a@example.org, b@example.org" },
    { text: "Group:,a@example.org,,;", read: "Group:a@example.org;" },
    { text: "<@a.test,@b.test:c@example.org>", read: "c@example.org" },
    { text: "<,@a.test,,@b.test , :c@example.org>", read: "c@example.org" },
    { text: "alice@example.org,<bob@example.com>", read: "alice@example.org, bob@example.com" },
    {
      text: "\"Alice, alice@example.org\" <bob@example.com>",
      read: "\"Alice, alice@example.org\" <bob@example.com>",
    },
    { text: "alice@example.org (Alice)", read: "alice@example.org" },
  ]

test "lists {show(c.text)}" for c: Listing in listings() {
  assert_eq(result_map(parse_address_list(c.text), address_list_text), Ok(c.read))
}

type Unlisted = { text: String, at: Int, why: Why }

/// Texts that are no address list, each with where it stops being one and why. The first
/// thirteen are the texts behind CVE-2023-27043 and CVE-2019-16056, which a reader took for
/// `alice@example.org` alone while a transport delivered to another address: each is refused
/// whole, under either syntax.
fn unlisted() -> List<Unlisted> =
  [
    { text: "alice@example.org)<bob@example.com>", at: 17, why: Unexpected },
    { text: "alice@example.org(<bob@example.com>", at: 35, why: UnclosedComment },
    { text: "alice@example.org<<bob@example.com>", at: 17, why: Unexpected },
    { text: "alice@example.org><bob@example.com>", at: 17, why: Unexpected },
    { text: "alice@example.org[<bob@example.com>", at: 17, why: Unexpected },
    { text: "alice@example.org]<bob@example.com>", at: 17, why: Unexpected },
    { text: "alice@example.org@<bob@example.com>", at: 17, why: Unexpected },
    { text: "alice@example.org;<bob@example.com>", at: 17, why: Unexpected },
    { text: "alice@example.org:<bob@example.com>", at: 17, why: Unexpected },
    { text: "alice@example.org.<bob@example.com>", at: 18, why: BadDomain },
    { text: "alice@example.org\"<bob@example.com>", at: 17, why: Unexpected },
    { text: "alice@example.org )Alice(", at: 18, why: Unexpected },
    { text: "a@malicious.org@important.com", at: 15, why: Unexpected },
    { text: "alice@example.org <bob@example.com>", at: 18, why: Unexpected },
    { text: "", at: 0, why: NoAddress },
    { text: " , ", at: 3, why: NoAddress },
    { text: "John Doe", at: 8, why: NoAt },
    { text: "jdoe", at: 4, why: NoAt },
    { text: "john doe@example.com", at: 5, why: BadLocalPart },
    { text: ".a@example.org", at: 0, why: BadLocalPart },
    { text: "a..b@example.org", at: 2, why: BadLocalPart },
    { text: "a.@example.org", at: 1, why: BadLocalPart },
    { text: "@example.org", at: 0, why: BadLocalPart },
    { text: "\"a\tb\"@example.org", at: 1, why: Control },
    { text: "\"a@b\"@example.org", at: 1, why: BadLocalPart },
    { text: "Eve <\"eve@example.net\"@example.org>", at: 8, why: BadLocalPart },
    { text: "a@b_c.example", at: 2, why: BadDomain },
    { text: "a@-b.example", at: 2, why: BadDomain },
    { text: "a@b..example", at: 4, why: BadDomain },
    { text: "a@b.", at: 4, why: BadDomain },
    { text: "a@", at: 2, why: BadDomain },
    { text: "a@[]", at: 2, why: BadDomain },
    { text: "a@[192.0.2.1", at: 12, why: BadDomain },
    { text: "a@[a\\]b]", at: 4, why: BadDomain },
    { text: "a@[1 92.0.2.1]", at: 5, why: BadDomain },
    { text: "a@[192.0.2.1 (]", at: 13, why: BadDomain },
    { text: "<@a.test@b.test:c@example.org>", at: 8, why: Unexpected },
    { text: "<,:c@example.org>", at: 2, why: Unexpected },
    { text: "j\u{fc}rgen@example.org", at: 1, why: NonAscii },
    { text: "a@b\u{fc}cher.example", at: 3, why: NonAscii },
    { text: "J\u{fc}rgen <j@example.org>", at: 1, why: NonAscii },
    { text: "<>", at: 1, why: NoAddress },
    { text: "<a@example.org", at: 14, why: UnclosedAngle },
    { text: "Joe <a>", at: 6, why: NoAt },
    { text: "x: a@example.org", at: 16, why: UnclosedGroup },
    { text: "x: y: a@example.org;;", at: 4, why: Unexpected },
    { text: ":;", at: 0, why: Unexpected },
    { text: "a@example.org, b@example.org;", at: 28, why: Unexpected },
    { text: "\"unclosed <a@example.org>", at: 25, why: Unclosed },
    { text: "a@example.org (unclosed", at: 23, why: UnclosedComment },
    { text: "Joe <a@example.org>\r\nBcc: <b@example.org>", at: 19, why: LineBreak },
    { text: "Joe\n <a@example.org>", at: 3, why: LineBreak },
    { text: "a@example.org\0", at: 13, why: Control },
    { text: "<@x.test a@example.org>", at: 9, why: Unexpected },
    { text: "a@example.org b@example.org", at: 14, why: Unexpected },
  ]

test "refuses {show(c.text)}" for c: Unlisted in unlisted() {
  assert_eq(parse_address_list(c.text), Err({ at: c.at, why: c.why }));
  assert(!result_is_ok(parse_address_list(c.text, Ascii, Current)))
}

/// Address lists only RFC 5322 §4 admits, each with where the current syntax stops and why.
fn outdated() -> List<Unlisted> =
  [
    { text: "Joe Q. Public <john.q.public@example.com>", at: 5, why: ObsoleteSyntax },
    { text: "Mary Smith <@node.test:mary@example.net>", at: 12, why: ObsoleteSyntax },
    { text: "a@example.org, , c@example.org", at: 15, why: ObsoleteSyntax },
    { text: "a@example.org,", at: 14, why: ObsoleteSyntax },
    { text: ",a@example.org", at: 0, why: ObsoleteSyntax },
    { text: "jdoe@test  . example", at: 9, why: ObsoleteSyntax },
    { text: "\"john\".doe@example.org", at: 0, why: ObsoleteSyntax },
    { text: "john . doe@example.org", at: 0, why: ObsoleteSyntax },
    { text: "x:,;", at: 2, why: ObsoleteSyntax },
    { text: "=?x-unknown?Q?a?= <j@example.org>", at: 0, why: BadEncodedWord },
    { text: "=?UTF-8?Q?a=0D=0ABcc=3A_x?= <j@example.org>", at: 0, why: BadEncodedWord },
    { text: "=?UTF-8?Q?J=C3=BCrgen?=<j@example.org>", at: 23, why: BadEncodedWord },
    { text: "=?UTF-8?Q?Team?=:j@example.org;", at: 16, why: BadEncodedWord },
  ]

test "the current syntax refuses {show(c.text)}" for c: Unlisted in outdated() {
  assert_eq(parse_address_list(c.text, Ascii, Current), Err({ at: c.at, why: c.why }));
  assert(result_is_ok(parse_address_list(c.text)))
}

test "an encoded word in a quoted string is decoded only under the obsolete syntax" {
  let text = "\"=?UTF-8?Q?J=C3=BCrgen?=\" <j@example.org>";
  assert_eq(
    result_map(parse_mailbox(text, Ascii, Current), display_name),
    Ok(Some("=?UTF-8?Q?J=C3=BCrgen?=")),
  );
  assert_eq(result_map(parse_mailbox(text), display_name), Ok(Some("J\u{fc}rgen")))
}

test "UTF-8 is read in a name, a local part and a domain only where it is asked for" {
  let text = "J\u{fc}rgen M\u{fc}ller <j\u{fc}rgen@b\u{fc}cher.example>, \u{7528}\u{6237}@\u{4f8b}\u{3048}.jp, \"\u{e9} \u{e8}\"@example.org";
  assert_eq(result_map(parse_address_list(text, Utf8), address_list_text), Ok(text));
  assert_eq(parse_address_list(text), Err({ at: 1, why: NonAscii }));
  let a = try { read_address("j\u{fc}rgen@b\u{fc}cher.example", Utf8) };
  assert_eq(result_map(a, local_part), Ok("j\u{fc}rgen"));
  assert_eq(result_map(a, domain), Ok("b\u{fc}cher.example"));
  assert_eq(result_map(a, is_ascii), Ok(false));
  assert_eq(parse_address("j\u{fc}rgen@example.org"), Err({ at: 1, why: NonAscii }));
  assert_eq(parse_address("jdoe@b\u{fc}cher.example"), Err({ at: 6, why: NonAscii }));
  assert_eq(result_map(parse_address("jdoe@xn--bcher-kva.example"), is_ascii), Ok(true));
  // A comment may hold UTF-8 too, and is dropped as any other is; a domain literal holds none.
  assert_eq(
    result_map(
      parse_address_list("J\u{fc}rgen (\u{e9}t\u{e9}) <a@example.org> (\u{65e5}\u{672c})", Utf8),
      address_list_text,
    ),
    Ok("J\u{fc}rgen <a@example.org>"),
  );
  assert_eq(parse_address("a@[\u{fc}]", Utf8), Err({ at: 3, why: BadDomain }))
}

type Spelled = { text: String, read: Result<String, Refusal> }

/// Texts `read_address` is given, each with the address it is as `show` writes it, or why it
/// is none.
fn spelled() -> List<Spelled> =
  [
    { text: "jdoe@example.org", read: Ok("jdoe@example.org") },
    { text: "john.q.public@example.com", read: Ok("john.q.public@example.com") },
    { text: "\"john doe\"@example.org", read: Ok("\"john doe\"@example.org") },
    { text: "\"jdoe\"@example.org", read: Ok("jdoe@example.org") },
    { text: "a!#$%&'*+-/=?^_`{|}~b@example.org", read: Ok("a!#$%&'*+-/=?^_`{|}~b@example.org") },
    { text: "jdoe@[192.0.2.1]", read: Ok("jdoe@[192.0.2.1]") },
    { text: "jdoe@localhost", read: Ok("jdoe@localhost") },
    { text: "", read: Err({ at: 0, why: NoAddress }) },
    { text: "jdoe", read: Err({ at: 4, why: NoAt }) },
    { text: " jdoe@example.org", read: Err({ at: 0, why: Unexpected }) },
    { text: "jdoe@example.org ", read: Err({ at: 16, why: Unexpected }) },
    { text: "jdoe @example.org", read: Err({ at: 0, why: Unexpected }) },
    { text: "jdoe@ example.org", read: Err({ at: 5, why: BadDomain }) },
    { text: "jdoe(comment)@example.org", read: Err({ at: 0, why: Unexpected }) },
    { text: "jdoe@example.org(comment)", read: Err({ at: 16, why: Unexpected }) },
    { text: "John <jdoe@example.org>", read: Err({ at: 5, why: NoAt }) },
    { text: "<jdoe@example.org>", read: Err({ at: 0, why: NoAt }) },
    { text: "jdoe@[ 192.0.2.1 ]", read: Err({ at: 5, why: Unexpected }) },
    { text: "john . doe@example.org", read: Err({ at: 0, why: Unexpected }) },
    { text: "\"john\".doe@example.org", read: Err({ at: 0, why: ObsoleteSyntax }) },
    { text: "a@b@c", read: Err({ at: 3, why: Unexpected }) },
    { text: "a@example.org\r\n", read: Err({ at: 13, why: LineBreak }) },
    { text: "a@example.org, b@example.org", read: Err({ at: 13, why: Unexpected }) },
  ]

test "the address {show(c.text)}" for c: Spelled in spelled() {
  assert_eq(result_map(parse_address(c.text), |a: Address| show(a)), c.read)
}

fn jdoe() -> Address / {email.refused, abort.raise} = address("jdoe", "example.org")

test "an address is made of a local part and a domain that are each what one holds" {
  assert_eq(try { address("jdoe", "example.org") }, parse_address("jdoe@example.org"));
  assert_eq(try { show(address("john doe", "Example.ORG")) }, Ok("\"john doe\"@Example.ORG"));
  assert_eq(try { show(address("", "example.org")) }, Ok("\"\"@example.org"));
  assert_eq(try { show(address("a,b", "example.org")) }, Ok("\"a,b\"@example.org"));
  assert_eq(try { address("eve@example.net", "example.org") }, Err({ at: 3, why: BadLocalPart }));
  assert_eq(try { address("a\r\nBcc: b", "example.org") }, Err({ at: 1, why: LineBreak }));
  assert_eq(try { address("a\tb", "example.org") }, Err({ at: 1, why: Control }));
  assert_eq(try { address("a\0", "example.org") }, Err({ at: 1, why: Control }));
  assert_eq(try { address("j\u{fc}rgen", "example.org") }, Err({ at: 1, why: NonAscii }));
  assert_eq(try { address(string::repeat("a", 256), "example.org") }, Err({ at: 0, why: TooLong }));
  assert(result_is_ok(try { address(string::repeat("a", 255), "example.org") }));
  assert_eq(try { address("a", "") }, Err({ at: 0, why: BadDomain }));
  assert_eq(try { address("a", "ex ample.org") }, Err({ at: 2, why: BadDomain }));
  assert_eq(try { address("a", "example.org>") }, Err({ at: 11, why: BadDomain }));
  assert_eq(try { address("a", "b@example.org") }, Err({ at: 1, why: BadDomain }));
  assert_eq(try { address("a", "example.org\r\n") }, Err({ at: 11, why: LineBreak }));
  assert_eq(try { address("a", "b\u{fc}cher.example") }, Err({ at: 1, why: NonAscii }));
  assert(result_is_ok(try { address("j\u{fc}rgen", "b\u{fc}cher.example", Utf8) }));
  assert_eq(
    try { address("a", string::repeat("a", 64) ++ ".example") },
    Err({ at: 0, why: BadDomain }),
  );
  assert(result_is_ok(try { address("a", string::repeat("a", 63) ++ ".example") }));
  let label = string::repeat("a", 63) ++ ".";
  assert_eq(
    try { address("a", string::repeat(label, 4) ++ "example") },
    Err({ at: 0, why: TooLong }),
  )
}

test "addresses are equal by their local part as written and their domain in any case" {
  assert_eq(try { address("jdoe", "EXAMPLE.Org") }, try { jdoe() });
  assert((try { address("JDoe", "example.org") }) != (try { jdoe() }));
  assert_eq(parse_address("\"jdoe\"@example.org"), try { jdoe() });
  assert_eq(
    result_map(try { address("jdoe", "EXAMPLE.Org") }, digest),
    result_map(try { jdoe() }, digest),
  );
  assert_eq(result_map(try { address("jdoe", "EXAMPLE.Org") }, domain), Ok("EXAMPLE.Org"))
}

test "addresses are equal whether a label of their domain is written in its script or as its A-label" {
  let written = try { address("user", "b\u{fc}cher.example", Utf8) };
  let coded = parse_address("user@xn--bcher-kva.example");
  assert_eq(written, coded);
  assert_eq(result_map(written, digest), result_map(coded, digest));
  assert_eq(
    try { address("user", "B\u{dc}CHER.Example", Utf8) },
    parse_address("user@XN--Bcher-KVA.example"),
  );
  assert_eq(try { address("user", "bu\u{308}cher.example", Utf8) }, coded);
  assert((try { address("user", "bucher.example") }) != coded);
  assert((try { address("User", "b\u{fc}cher.example", Utf8) }) != coded);
  // The name is `std.idna`'s, which reads the Kelvin sign as the `k` it maps to.
  assert_eq(try { address("a", "\u{212a}.example", Utf8) }, try { address("a", "k.example") });
  assert_eq(result_map(written, domain), Ok("b\u{fc}cher.example"));
  assert_eq(result_map(written, ascii_domain), Ok("xn--bcher-kva.example"));
  assert_eq(result_map(written, |a: Address| show(a)), Ok("user@b\u{fc}cher.example"));
  assert_eq(result_map(written, ascii_text), Ok(Some("user@xn--bcher-kva.example")));
  assert_eq(result_map(written, is_ascii), Ok(true));
  assert_eq(
    result_map(try { address("j\u{fc}rgen", "b\u{fc}cher.example", Utf8) }, ascii_text),
    Ok(None),
  );
  assert_eq(
    result_map(try { address("a b", "EXAMPLE.Org") }, ascii_text),
    Ok(Some("\"a b\"@EXAMPLE.Org")),
  );
  assert_eq(
    result_map(try { address("a", "[IPv6:2001:DB8::1]") }, ascii_domain),
    Ok("[IPv6:2001:DB8::1]"),
  )
}

test "a domain with a label outside ASCII or an A-label is a domain name, or is refused with what is wrong" {
  let wrong = |domain: String, label: Int, why: idna::Why|
    assert_eq(
      try { address("a", domain, Utf8) },
      Err({ at: 0, why: BadIdna([{ label: label, why: why }]) }),
    );
  wrong("xn--a.example", 0, idna::Disallowed);
  wrong("example.xn--0", 1, idna::Punycode);
  wrong("a.\u{200d}b.example", 1, idna::Joiner);
  wrong("\u{5d0}a.example", 0, idna::Bidi);
  wrong("b\u{ff20}c.example", 0, idna::Disallowed);
  wrong("\u{301}a.example", 0, idna::LeadingMark);
  wrong("\u{fc}" ++ string::repeat("a", 58) ++ ".example", 0, idna::LongLabel);
  assert_eq(
    parse_address("a@xn--a.example"),
    Err({ at: 2, why: BadIdna([{ label: 0, why: idna::Disallowed }]) }),
  );
  assert_eq(parse_address("a@b\u{fc}cher.example"), Err({ at: 3, why: NonAscii }));
  assert(result_is_ok(try { address("a", "ab--c.example") }));
  assert(result_is_ok(try { address("a", "ab--c.b\u{fc}cher.example", Utf8) }));
  assert(result_is_ok(try { address("a", "axn--b.example") }));
  assert_eq(
    explain(BadIdna([{ label: 0, why: idna::Bidi }])),
    "no internationalized domain name: a name with a right-to-left label keeps the Bidi rule in every label",
  )
}

test "a domain literal is kept as written between its brackets" {
  let a = try { address("jdoe", "[IPv6:2001:db8::1]") };
  assert_eq(result_map(a, domain), Ok("[IPv6:2001:db8::1]"));
  assert_eq(
    try { domain_literal(address("jdoe", "[IPv6:2001:db8::1]")) },
    Ok(Some("IPv6:2001:db8::1")),
  );
  assert_eq(try { domain_literal(jdoe()) }, Ok(None));
  // The blanks RFC 5322 admits in a literal are no part of it.
  assert_eq(result_map(try { address("a", "[192.0.2.1 ]") }, domain), Ok("[192.0.2.1]"))
}

fn joe() -> Mailbox / {email.refused, abort.raise} = named("Joe Q. Public", jdoe())

test "a mailbox is an address under a name that holds no line break" {
  assert_eq(try { show(joe()) }, Ok("\"Joe Q. Public\" <jdoe@example.org>"));
  assert_eq(try { show(named("Joe Public", jdoe())) }, Ok("Joe Public <jdoe@example.org>"));
  assert_eq(try { show(mailbox(jdoe())) }, Ok("jdoe@example.org"));
  assert_eq(try { named("", jdoe()) }, try { mailbox(jdoe()) });
  assert_eq(try { display_name(joe()) }, Ok(Some("Joe Q. Public")));
  assert_eq(try { address_of(joe()) }, try { jdoe() });
  assert_eq(try { named("Joe\r\nBcc: eve@example.org", jdoe()) }, Err({ at: 3, why: LineBreak }));
  assert_eq(try { named("Joe\0", jdoe()) }, Err({ at: 3, why: Control }));
  assert(result_is_ok(try { named("tab\tand caf\u{e9}", jdoe()) }));
  assert((try { named("Joe", jdoe()) }) != (try { named("joe", jdoe()) }));
  assert_eq(try { named("Joe", address("jdoe", "EXAMPLE.ORG")) }, try { named("Joe", jdoe()) });
  assert_eq(
    result_map(parse_mailbox("Joe <jdoe@example.org>, x@example.org"), display_name),
    Err({ at: 22, why: Unexpected }),
  );
  assert_eq(parse_mailbox("A Group:;"), Err({ at: 7, why: Unexpected }))
}

test "a group is a name and its members, and an address list flattens to its mailboxes" {
  let listed = parse_address_list(
    "a@example.org, Team: Joe <b@example.org>, c@example.org;, None:;",
  );
  assert_eq(
    result_map(listed, |es: List<Entry>| map(es, group_name)),
    Ok([None, Some("Team"), Some("None")]),
  );
  assert_eq(
    result_map(listed, |es: List<Entry>| map(mailboxes_of(es), |m: Mailbox| show(m))),
    Ok(["a@example.org", "Joe <b@example.org>", "c@example.org"]),
  );
  assert_eq(try { show(group("undisclosed-recipients", [])) }, Ok("undisclosed-recipients:;"));
  assert_eq(try { members(group("Team", [mailbox(jdoe())])) }, try { [mailbox(jdoe())] });
  assert_eq(try { members(one(mailbox(jdoe()))) }, try { [mailbox(jdoe())] });
  assert_eq(try { group("", []) }, Err({ at: 0, why: NoAddress }));
  assert_eq(try { group("a\nb", []) }, Err({ at: 1, why: LineBreak }))
}

test "the literal's check answers the address, or the character the text stops being one at" {
  assert_eq(result_ok(literal("jdoe@example.org")), result_ok(try { jdoe() }));
  assert_eq(literal("j\u{fc}rgen@"), Err({ message: explain(BadDomain), offset: 7 }));
  assert_eq(literal("John <jdoe@example.org>"), Err({ message: explain(NoAt), offset: 5 }))
}

law "an address's text reads back as it"
  forall (a: Address) {
    parse_address(show(a), Utf8) == Ok(a)
  }

law "an address is written in ASCII unless its local part is outside it, and reads back as it from that"
  forall (a: Address) {
    match ascii_text(a) {
      Some(text) -> is_ascii(a) && string::is_ascii(text) && parse_address(text) == Ok(a),
      None -> !is_ascii(a),
    }
  }

law "an address is the one its maker makes of its parts, however its domain is cased"
  forall (a: Address) {
    (try { address(local_part(a), domain(a), Utf8) }) == Ok(a)
      && (try { address(local_part(a), string::ascii_upper(domain(a)), Utf8) }) == Ok(a)
  }

law "a mailbox's text reads back as it"
  forall (m: Mailbox) {
    parse_mailbox(show(m), Utf8, Current) == Ok(m)
  }

law "an address list's text reads back as it"
  forall (es: List<Entry>) {
    len(es) == 0 || parse_address_list(address_list_text(es), Utf8, Current) == Ok(es)
  }

law "any text is addresses or a refusal at one of its bytes, and what the current syntax reads the obsolete one reads alike"
  forall (text: String) {
    let n = bytes_len(bytes_of_string(text));
    let within = |r: Result<List<Entry>, Refusal>|
      match r { Ok(_) -> true, Err(found) -> found.at >= 0 && found.at <= n };
    within(parse_address_list(text)) && within(parse_address_list(text, Utf8, Current))
      && (!result_is_ok(parse_address_list(text, Utf8, Current))
      || parse_address_list(text, Utf8, Obsolete) == parse_address_list(text, Utf8, Current)
      || string_contains(text, "=?"))
  }

law "an address list written in a field reads back as it, in lines no longer than 998 octets"
  forall (es: List<Entry>) {
    match try { addressed("To", es, false) } {
      Err(why) -> why == NeedsUtf8 && !all(mailboxes_of(es), |m: Mailbox| is_ascii(address_of(m))),
      Ok(raw) ->
        len(es) == 0
          || (parse_address_list(value_of(raw)) == Ok(es) && len(line_defects(raw, 0)) == 0
          && scan_until(raw, 0, high()) >= bytes_len(raw)),
    }
  }

type Identified = { text: String, syntax: Syntax, read: Result<List<String>, Refusal> }

/// Texts of identifiers and what each holds, the first four RFC 5322 Appendix A's.
fn identified_cases() -> List<Identified> =
  [
    {
      text: "<1234@local.machine.example>",
      syntax: Current,
      read: Ok(["<1234@local.machine.example>"]),
    },
    {
      text: "<1234@local.machine.example> <3456@example.net>",
      syntax: Current,
      read: Ok(["<1234@local.machine.example>", "<3456@example.net>"]),
    },
    {
      text: "             <testabcd.1234@silly.test>",
      syntax: Current,
      read: Ok(["<testabcd.1234@silly.test>"]),
    },
    {
      text: "<1234   @   local(blah)  .machine .example>",
      syntax: Obsolete,
      read: Ok(["<1234@local.machine.example>"]),
    },
    {
      text: "<1234   @   local(blah)  .machine .example>",
      syntax: Current,
      read: Err({ at: 0, why: ObsoleteSyntax }),
    },
    {
      text: "<a@b>(comment)<c@[192.0.2.1]>",
      syntax: Current,
      read: Ok(["<a@b>", "<c@[192.0.2.1]>"]),
    },
    { text: "<no-at-sign>", syntax: Current, read: Ok(["<no-at-sign>"]) },
    { text: "", syntax: Current, read: Ok([]) },
    { text: "<>", syntax: Current, read: Err({ at: 0, why: BadMessageId }) },
    { text: "<a@b", syntax: Current, read: Err({ at: 4, why: UnclosedAngle }) },
    { text: "1234@example.org", syntax: Current, read: Err({ at: 0, why: BadMessageId }) },
    { text: "<a@b>, <c@d>", syntax: Current, read: Err({ at: 5, why: ObsoleteSyntax }) },
    { text: "<a@b>, <c@d>", syntax: Obsolete, read: Ok(["<a@b>", "<c@d>"]) },
    {
      text: "Your message of \"Tue, 1 Jul\" <a@b> and (see) <c@d>",
      syntax: Obsolete,
      read: Ok(["<a@b>", "<c@d>"]),
    },
    { text: "<\"a b\"@c>", syntax: Obsolete, read: Err({ at: 0, why: BadMessageId }) },
    { text: "<caf\u{e9}@example.org>", syntax: Current, read: Err({ at: 0, why: NonAscii }) },
    { text: "<caf\u{e9}@example.org>", syntax: Obsolete, read: Err({ at: 0, why: NonAscii }) },
    { text: "<a@b>\r\n<c@d>", syntax: Obsolete, read: Err({ at: 5, why: LineBreak }) },
  ]

test "the identifiers of {show(c.text)}" for c: Identified in identified_cases() {
  assert_eq(
    result_map(parse_message_ids(c.text, c.syntax), |found: List<MessageId>| map(found, id_text)),
    c.read,
  )
}

test "an identifier is made of a left side and a domain a writer may write" {
  assert_eq(try { id_text(message_id("1234.abc", "example.org")) }, Ok("<1234.abc@example.org>"));
  assert_eq(try { show(message_id("a", "[192.0.2.1]")) }, Ok("<a@[192.0.2.1]>"));
  assert_eq(try { message_id("a b", "example.org") }, Err({ at: 0, why: BadMessageId }));
  assert_eq(try { message_id("", "example.org") }, Err({ at: 0, why: BadMessageId }));
  assert_eq(try { message_id("a..b", "example.org") }, Err({ at: 0, why: BadMessageId }));
  assert_eq(try { message_id("caf\u{e9}", "example.org") }, Err({ at: 0, why: BadMessageId }));
  assert_eq(try { message_id("a", "exa mple.org") }, Err({ at: 3, why: BadMessageId }));
  assert_eq(try { message_id("a>\r\nBcc: x", "example.org") }, Err({ at: 0, why: BadMessageId }));
  assert_eq(
    handle { try { id_text(fresh_id("example.org")) } } with { entropy.next() -> 7 },
    Ok("<7-7@example.org>"),
  )
}

law "an identifier's text reads back as it"
  forall (i: MessageId, j: MessageId) {
    parse_message_ids(id_text(i) ++ " " ++ id_text(j)) == Ok([i, j])
  }

test "a field is its name and its value, folded at its spaces" {
  let made = try { field("X-Mailer", "  ply 0.1 \t") };
  assert_eq(result_map(made, |f: Field| f.raw), Ok(b"X-Mailer: ply 0.1\r\n"));
  assert_eq(result_map(made, |f: Field| f.value), Ok("ply 0.1"));
  assert_eq(result_map(made, |f: Field| f.name), Ok("X-Mailer"));
  assert_eq(result_map(try { field("X-Empty", "") }, |f: Field| f.raw), Ok(b"X-Empty:\r\n"));
  let words = join(map(range(0, 20), |i: Int| "word" ++ int_to_string(i)), " ");
  assert_eq(
    result_map(try { field("X-Long", words) }, |f: Field| f.raw),
    Ok(
      b"X-Long: word0 word1 word2 word3 word4 word5 word6 word7 word8 word9 word10\r\n word11 word12 word13 word14 word15 word16 word17 word18 word19\r\n",
    ),
  );
  // A stretch with no space in it is kept whole, on a line of its own where it must be.
  let link = "https://example.org/" ++ string::repeat("a", 975);
  assert_eq(
    result_map(try { field("X-Link", "see " ++ link) }, |f: Field| f.raw),
    Ok(bytes_of_string("X-Link: see\r\n " ++ link ++ "\r\n")),
  );
  assert_eq(
    result_map(try { field("X-Link", link ++ " x") }, |f: Field| f.raw),
    Ok(bytes_of_string("X-Link:\r\n " ++ link ++ "\r\n x\r\n")),
  );
  assert_eq(
    result_map(try { field("X-Gaps", "a   b") }, |f: Field| f.raw),
    Ok(b"X-Gaps: a   b\r\n"),
  )
}

type Unmade = { name: String, value: String, at: Int, why: Why }

fn unmade() -> List<Unmade> =
  [
    { name: "", value: "x", at: 0, why: BadName },
    { name: "Bad Name", value: "x", at: 3, why: BadName },
    { name: "Bad:Name", value: "x", at: 3, why: BadName },
    { name: "X-Caf\u{e9}", value: "x", at: 5, why: BadName },
    { name: "X\r\nBcc", value: "x", at: 1, why: BadName },
    { name: string::repeat("X", 77), value: "x", at: 76, why: BadName },
    { name: "X-A", value: "a\r\nBcc: eve@example.org", at: 1, why: LineBreak },
    { name: "X-A", value: "a\nb", at: 1, why: LineBreak },
    { name: "X-A", value: "a\rb", at: 1, why: LineBreak },
    { name: "X-A", value: "a\0b", at: 1, why: Control },
    { name: "X-A", value: "caf\u{e9}", at: 3, why: NonAscii },
    { name: "X-A", value: string::repeat("a", 998), at: 0, why: TooLong },
  ]

test "no field is made of {show(c.name)} and {show(c.value)}" for c: Unmade in unmade() {
  assert_eq(try { field(c.name, c.value) }, Err({ at: c.at, why: c.why }))
}

test "an unstructured field is written as it is where that reads back, and in encoded words otherwise" {
  let raw = |text: String| result_map(try { text_field("Subject", text) }, |f: Field| f.raw);
  assert_eq(raw("Saying Hello"), Ok(b"Subject: Saying Hello\r\n"));
  assert_eq(raw(""), Ok(b"Subject:\r\n"));
  assert_eq(raw("Gr\u{fc}\u{df}e"), Ok(b"Subject: =?UTF-8?B?R3LDvMOfZQ==?=\r\n"));
  assert_eq(
    raw("a long subject with one caf\u{e9} in it"),
    Ok(b"Subject: =?UTF-8?Q?a_long_subject_with_one_caf=C3=A9_in_it?=\r\n"),
  );
  assert_eq(raw(" led by a space"), Ok(b"Subject: =?UTF-8?Q?_led_by_a_space?=\r\n"));
  assert_eq(raw("tab\there"), Ok(b"Subject: =?UTF-8?Q?tab=09here?=\r\n"));
  assert_eq(
    raw("=?UTF-8?Q?not_a_word?="),
    Ok(b"Subject: =?UTF-8?B?PT9VVEYtOD9RP25vdF9hX3dvcmQ/PQ==?=\r\n"),
  );
  assert_eq(raw("a\r\nBcc: x"), Err({ at: 1, why: LineBreak }));
  assert_eq(
    result_map(try { text_field("Subject", "Gr\u{fc}\u{df}e", Utf8) }, |f: Field| f.raw),
    Ok(bytes_of_string("Subject: Gr\u{fc}\u{df}e\r\n")),
  );
  assert_eq(
    result_map(try { text_field("Subject", "Gr\u{fc}\u{df}e") }, |f: Field| f.value),
    Ok("=?UTF-8?B?R3LDvMOfZQ==?="),
  );
  assert_eq(try { text_field("Sub ject", "x") }, Err({ at: 3, why: BadName }))
}

law "a field made of a field's name and value is the field"
  forall (value: String) {
    match try { field("X-Any", value, Utf8) } {
      Ok(made) -> (try { field(made.name, made.value, Utf8) }) == Ok(made),
      Err(r) -> !is_quotable(value) || r.why == TooLong,
    }
  }

law "a text written in a field is read back from it, in ASCII lines no longer than 998 octets"
  forall (text: String) {
    match try { text_field("Subject", text) } {
      Err(_) -> !is_quotable(text),
      Ok(made) ->
        unworded(made.value).text == text && len(line_defects(made.raw, 0)) == 0
          && scan_until(made.raw, 0, high()) >= bytes_len(made.raw)
          && string_ends_with(string_of_bytes(made.raw), "\r\n")
          && len(bytes_split(made.raw, b"\r\n")) == len(bytes_split(made.raw, b"\n")),
    }
  }

/// `text` as it is sent: each of its lines, the last too, ended by CRLF.
fn sent(text: String) -> Bytes / {abort.raise} =
  bytes_of_string(string::replace(text, "\n", "\r\n") ++ "\r\n")

fn shown_text(found: Option<Decoded>) -> String =
  match found { Some(Text(read)) -> read, Some(_) -> "(not text)", None -> "" }

fn said_line(label: String, value: String) -> String =
  if value == "" { "" } else { label ++ " " ++ value }

/// What a message's typed readers answer, each on a line of its own, and no line for a reader
/// that answers nothing.
fn said(m: Message) -> List<String> / {abort.raise} =
  filter(
    [
      said_line("from", address_list_text(each(from(m)))),
      said_line("sender", match sender(m) { Some(s) -> show(s), None -> "" }),
      said_line("reply-to", address_list_text(reply_to(m))),
      said_line("to", address_list_text(to(m))),
      said_line("cc", address_list_text(cc(m))),
      said_line("bcc", address_list_text(bcc(m))),
      said_line("subject", match subject(m) { Some(s) -> s, None -> "" }),
      said_line("date", match date(m) { Some(d) -> show(d), None -> "" }),
      said_line("id", match id(m) { Some(i) -> id_text(i), None -> "" }),
      said_line("in-reply-to", join(map(in_reply_to(m), id_text), " ")),
      said_line("references", join(map(references(m), id_text), " ")),
      said_line("text", shown_text(text_body(m))),
    ],
    |line: String| line != "",
  )

fn hello() -> String = "text This is a message just to say hello.\nSo, \"Hello\".\n"

fn simple_addressing() -> String =
  \\From: John Doe <jdoe@machine.example>
  \\To: Mary Smith <mary@example.net>
  \\Subject: Saying Hello
  \\Date: Fri, 21 Nov 1997 09:55:06 -0600
  \\Message-ID: <1234@local.machine.example>
  \\
  \\This is a message just to say hello.
  \\So, "Hello".

