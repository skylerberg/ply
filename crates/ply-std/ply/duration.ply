//! A `Duration` written in source: with `import std.duration`, `duration"1h30m"` is the span
//! `std.time`'s `read_duration` reads of that text, read when the program is checked.
//!
//! A text that is no duration is a check error at the character that keeps it from being one, so a
//! mistyped unit never reaches a run, and a call site says `duration"250ms"` where it would have
//! multiplied milliseconds out.

import std.time (parse_duration, refusal_message)

/// What a `duration"..."` literal is checked by: the span the text writes in `std.time`'s
/// compound form, or the sentence of its refusal at the character it is about.
pub fn literal(text: String) -> Result<Duration, { message: String, offset: Int }> / {abort.raise} =
  match parse_duration(text) {
    Ok(d) -> Ok(d),
    Err(refused) -> Err({ message: refusal_message(refused), offset: refused.at }),
  }

// --- Tests ------------------------------------------------------------------

type Read = { text: String, nanos: Int }

fn spans() -> List<Read> =
  [
    { text: "1h30m", nanos: 5400000000000 },
    { text: "1.5s", nanos: 1500000000 },
    { text: "250ms", nanos: 250000000 },
    { text: "-2m", nanos: 0 - 120000000000 },
    { text: "0", nanos: 0 },
  ]

test "the literal {c.text} is its span" for c: Read in spans() {
  assert_eq(literal(c.text), Ok(Duration(c.nanos)))
}

type Refused = { text: String, message: String, offset: Int }

fn refusals() -> List<Refused> =
  [
    { text: "", message: "no duration is written here", offset: 0 },
    { text: "90", message: "a number takes its unit after it", offset: 2 },
    {
      text: "1h30min",
      message: "not one of the units `h`, `m`, `s`, `ms`, `us` and `ns`: a day is no fixed span",
      offset: 4,
    },
    {
      text: "1.h",
      message: "a number goes here: digits, with digits after a point if it has one",
      offset: 2,
    },
    { text: "1.5ns", message: "finer than a nanosecond, the least a `Duration` holds", offset: 0 },
    { text: "1h9999999h", message: "past what a `Duration` holds, about 292 years", offset: 2 },
  ]

test "the literal {c.text} is refused where it stops being one" for c: Refused in refusals() {
  assert_eq(literal(c.text), Err({ message: c.message, offset: c.offset }))
}
