// BLAKE3, written in Ply: the hash content addressing is defined by, as a definition you can read.


// Every value in the algorithm is a 32-bit word held in an `Int`, non-negative and masked after
// every arithmetic step.
fn mask32(x: Int) -> Int = x & 0xFFFF_FFFF

// The rotate every quarter-round turns on, as the one step it is (GUIDE 13.10).
fn rotr(x: Int, n: Int) -> Int = rotr32(x, n)


// Eight words: what a chunk or a parent node hands to the node above it.
pub type Cv = {
  w0: Int, w1: Int, w2: Int, w3: Int, w4: Int, w5: Int, w6: Int, w7: Int,
}

// Sixteen words:
type Words16 = {
  m0: Int, m1: Int, m2: Int, m3: Int, m4: Int, m5: Int, m6: Int, m7: Int,
  m8: Int, m9: Int, m10: Int, m11: Int, m12: Int, m13: Int, m14: Int, m15: Int,
}

// The four words one `g` touches.
type Quad = { a: Int, b: Int, c: Int, d: Int }

fn iv() -> Cv = {
  w0: 0x6A09_E667, w1: 0xBB67_AE85, w2: 0x3C6E_F372, w3: 0xA54F_F53A,
  w4: 0x510E_527F, w5: 0x9B05_688C, w6: 0x1F83_D9AB, w7: 0x5BE0_CD19,
}

fn chunk_start() -> Int = 1
fn chunk_end() -> Int = 2
fn parent() -> Int = 4
fn root() -> Int = 8

fn block_len() -> Int = 64
fn chunk_len() -> Int = 1024


fn g(q: Quad, mx: Int, my: Int) -> Quad = {
  let a1 = mask32(q.a + q.b + mx);
  let d1 = rotr(q.d ^ a1, 16);
  let c1 = mask32(q.c + d1);
  let b1 = rotr(q.b ^ c1, 12);
  let a2 = mask32(a1 + b1 + my);
  let d2 = rotr(d1 ^ a2, 8);
  let c2 = mask32(c1 + d2);
  let b2 = rotr(b1 ^ c2, 7);
  {a: a2, b: b2, c: c2, d: d2}
}

// Four columns, then four diagonals.
fn round(s: Words16, m: Words16) -> Words16 = {
  let c0 = g({a: s.m0, b: s.m4, c: s.m8,  d: s.m12}, m.m0, m.m1);
  let c1 = g({a: s.m1, b: s.m5, c: s.m9,  d: s.m13}, m.m2, m.m3);
  let c2 = g({a: s.m2, b: s.m6, c: s.m10, d: s.m14}, m.m4, m.m5);
  let c3 = g({a: s.m3, b: s.m7, c: s.m11, d: s.m15}, m.m6, m.m7);
  let d0 = g({a: c0.a, b: c1.b, c: c2.c, d: c3.d}, m.m8,  m.m9);
  let d1 = g({a: c1.a, b: c2.b, c: c3.c, d: c0.d}, m.m10, m.m11);
  let d2 = g({a: c2.a, b: c3.b, c: c0.c, d: c1.d}, m.m12, m.m13);
  let d3 = g({a: c3.a, b: c0.b, c: c1.c, d: c2.d}, m.m14, m.m15);
  {
    m0: d0.a, m1: d1.a, m2: d2.a, m3: d3.a,
    m4: d3.b, m5: d0.b, m6: d1.b, m7: d2.b,
    m8: d2.c, m9: d3.c, m10: d0.c, m11: d1.c,
    m12: d1.d, m13: d2.d, m14: d3.d, m15: d0.d,
  }
}

// MSG_PERMUTATION = [2, 6, 3, 10, 7, 0, 4, 13, 1, 11, 12, 5, 9, 14, 15, 8]
fn permute(m: Words16) -> Words16 = {
  m0: m.m2,  m1: m.m6,  m2: m.m3,   m3: m.m10,
  m4: m.m7,  m5: m.m0,  m6: m.m4,   m7: m.m13,
  m8: m.m1,  m9: m.m11, m10: m.m12, m11: m.m5,
  m12: m.m9, m13: m.m14, m14: m.m15, m15: m.m8,
}

// The seven rounds, written out.
fn compress(cv: Cv, m: Words16, counter: Int, len: Int, flags: Int) -> Words16 = {
  let s0 = {
    m0: cv.w0, m1: cv.w1, m2: cv.w2, m3: cv.w3,
    m4: cv.w4, m5: cv.w5, m6: cv.w6, m7: cv.w7,
    m8: 0x6A09_E667, m9: 0xBB67_AE85, m10: 0x3C6E_F372, m11: 0xA54F_F53A,
    m12: mask32(counter), m13: mask32(counter >>> 32), m14: len, m15: flags,
  };
  let r1 = round(s0, m);
  let m1 = permute(m);
  let r2 = round(r1, m1);
  let m2 = permute(m1);
  let r3 = round(r2, m2);
  let m3 = permute(m2);
  let r4 = round(r3, m3);
  let m4 = permute(m3);
  let r5 = round(r4, m4);
  let m5 = permute(m4);
  let r6 = round(r5, m5);
  let m6 = permute(m5);
  let r = round(r6, m6);
  {
    m0: r.m0 ^ r.m8, m1: r.m1 ^ r.m9, m2: r.m2 ^ r.m10, m3: r.m3 ^ r.m11,
    m4: r.m4 ^ r.m12, m5: r.m5 ^ r.m13, m6: r.m6 ^ r.m14, m7: r.m7 ^ r.m15,
    m8: r.m8 ^ cv.w0, m9: r.m9 ^ cv.w1, m10: r.m10 ^ cv.w2, m11: r.m11 ^ cv.w3,
    m12: r.m12 ^ cv.w4, m13: r.m13 ^ cv.w5, m14: r.m14 ^ cv.w6, m15: r.m15 ^ cv.w7,
  }
}

fn first8(s: Words16) -> Cv = {
  w0: s.m0, w1: s.m1, w2: s.m2, w3: s.m3,
  w4: s.m4, w5: s.m5, w6: s.m6, w7: s.m7,
}


// Zero past the end, which is what pads a final short block.
fn byte_or_zero(input: Bytes, at: Int, limit: Int) -> Int =
  if at >= limit { 0 } else { bytes_at(input, at) }

// Little-endian, per the specification.
fn word_at(input: Bytes, at: Int, limit: Int) -> Int =
  byte_or_zero(input, at, limit)
  | (byte_or_zero(input, at + 1, limit) << 8)
  | (byte_or_zero(input, at + 2, limit) << 16)
  | (byte_or_zero(input, at + 3, limit) << 24)

fn block_words(input: Bytes, at: Int, limit: Int) -> Words16 = {
  m0: word_at(input, at, limit),        m1: word_at(input, at + 4, limit),
  m2: word_at(input, at + 8, limit),    m3: word_at(input, at + 12, limit),
  m4: word_at(input, at + 16, limit),   m5: word_at(input, at + 20, limit),
  m6: word_at(input, at + 24, limit),   m7: word_at(input, at + 28, limit),
  m8: word_at(input, at + 32, limit),   m9: word_at(input, at + 36, limit),
  m10: word_at(input, at + 40, limit),  m11: word_at(input, at + 44, limit),
  m12: word_at(input, at + 48, limit),  m13: word_at(input, at + 52, limit),
  m14: word_at(input, at + 56, limit),  m15: word_at(input, at + 60, limit),
}


// An empty input is one chunk of one empty block, which is why neither count is `0` at zero length.
fn block_count(n: Int) -> Int = if n <= 0 { 1 } else { (n + 63) / 64 }

fn chunk_count(n: Int) -> Int = if n <= 0 { 1 } else { (n + 1023) / 1024 }

fn min(a: Int, b: Int) -> Int = if a < b { a } else { b }

type ChunkStep = { cv: Cv, i: Int, out: Words16 }

// One chunk, block by block.
fn chunk_compress(input: Bytes, chunk: Int, is_root: Bool) -> Words16 = {
  let start = chunk * chunk_len();
  let stop = min(start + chunk_len(), bytes_len(input));
  let blocks = block_count(stop - start);
  iterate({cv: iv(), i: 0, out: empty16()}, blocks + 1, |s: ChunkStep|
    if s.i >= blocks {
      Stop(s.out)
    } else {
      let at = start + s.i * block_len();
      let limit = min(at + block_len(), stop);
      let last = s.i == blocks - 1;
      let flags =
        (if s.i == 0 { chunk_start() } else { 0 })
        | (if last { chunk_end() } else { 0 })
        | (if last && is_root { root() } else { 0 });
      let out = compress(s.cv, block_words(input, at, limit), chunk, limit - at, flags);
      Continue({cv: first8(out), i: s.i + 1, out: out})
    })
}

fn empty16() -> Words16 = {
  m0: 0, m1: 0, m2: 0, m3: 0, m4: 0, m5: 0, m6: 0, m7: 0,
  m8: 0, m9: 0, m10: 0, m11: 0, m12: 0, m13: 0, m14: 0, m15: 0,
}

fn parent_compress(left: Cv, right: Cv, is_root: Bool) -> Words16 =
  compress(
    iv(),
    {
      m0: left.w0, m1: left.w1, m2: left.w2, m3: left.w3,
      m4: left.w4, m5: left.w5, m6: left.w6, m7: left.w7,
      m8: right.w0, m9: right.w1, m10: right.w2, m11: right.w3,
      m12: right.w4, m13: right.w5, m14: right.w6, m15: right.w7,
    },
    0,
    block_len(),
    parent() | (if is_root { root() } else { 0 }),
  )

// The largest power of two strictly below `n`, which is where the tree splits.
fn left_chunks(n: Int) -> Int =
  iterate(1, 64, |p: Int| if p * 2 >= n { Stop(p) } else { Continue(p * 2) })

fn subtree(input: Bytes, lo: Int, hi: Int, is_root: Bool) -> Words16 =
  if hi - lo <= 1 {
    chunk_compress(input, lo, is_root)
  } else {
    let mid = lo + left_chunks(hi - lo);
    let left = first8(subtree(input, lo, mid, false));
    let right = first8(subtree(input, mid, hi, false));
    parent_compress(left, right, is_root)
  }


fn le_bytes(w: Int) -> Bytes =
  bytes_concat_all([
    byte_of_int(w & 0xFF),
    byte_of_int((w >>> 8) & 0xFF),
    byte_of_int((w >>> 16) & 0xFF),
    byte_of_int((w >>> 24) & 0xFF),
  ])

// The 32-byte hash of `input`.
pub fn blake3(input: Bytes) -> Bytes = {
  let out = subtree(input, 0, chunk_count(bytes_len(input)), true);
  bytes_concat_all([
    le_bytes(out.m0), le_bytes(out.m1), le_bytes(out.m2), le_bytes(out.m3),
    le_bytes(out.m4), le_bytes(out.m5), le_bytes(out.m6), le_bytes(out.m7),
  ])
}


// These are the published vectors, and they are the weaker half of what checks this module.

test "the empty input" {
  assert_eq(
    blake3(b""),
    b"\xaf\x13\x49\xb9\xf5\xf9\xa1\xa6\xa0\x40\x4d\xea\x36\xdc\xc9\x49\x9b\xcb\x25\xc9\xad\xc1\x12\xb7\xcc\x9a\x93\xca\xe4\x1f\x32\x62"
  )
}

test "one byte" {
  assert_eq(
    blake3(b"\x00"),
    b"\x2d\x3a\xde\xdf\xf1\x1b\x61\xf1\x4c\x88\x6e\x35\xaf\xa0\x36\x73\x6d\xcd\x87\xa7\x4d\x27\xb5\xc1\x51\x02\x25\xd0\xf5\x92\xe2\x13"
  )
}

test "a hash is thirty-two bytes whatever the input" {
  assert_eq(bytes_len(blake3(b"")), 32);
  assert_eq(bytes_len(blake3(b"ply")), 32)
}

test "the block boundary is where a transcription goes wrong" {
  // 63, 64 and 65 bytes:
  assert_eq(bytes_len(blake3(repeat(b"a", 63))), 32);
  assert_eq(bytes_len(blake3(repeat(b"a", 64))), 32);
  assert(blake3(repeat(b"a", 64)) != blake3(repeat(b"a", 65)))
}

test "a second chunk is a tree, and a tree is not a longer chunk" {
  // 1024 is one chunk and 1025 is two chunks joined by a parent node.
  assert(blake3(repeat(b"a", 1024)) != blake3(repeat(b"a", 1025)));
  assert_eq(bytes_len(blake3(repeat(b"a", 2048))), 32)
}

fn repeat(unit: Bytes, n: Int) -> Bytes =
  bytes_concat_all(map(range(0, n), |_i: Int| unit))
