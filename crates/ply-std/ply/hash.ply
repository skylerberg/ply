// BLAKE3 and SHA-256, written in Ply: the hashes content addressing and authentication are
// defined by.

// Every word is a `U32`, so a sum wraps in its register and nothing needs masking.

import std.bytes (u32_le, u32_be, u32_be_at, u64_be, xor, xor_byte)

// Eight words: what a chunk or a parent node hands to the node above it.
pub type Cv = { w0: U32, w1: U32, w2: U32, w3: U32, w4: U32, w5: U32, w6: U32, w7: U32 }

type Words16 = {
  m0: U32,
  m1: U32,
  m2: U32,
  m3: U32,
  m4: U32,
  m5: U32,
  m6: U32,
  m7: U32,
  m8: U32,
  m9: U32,
  m10: U32,
  m11: U32,
  m12: U32,
  m13: U32,
  m14: U32,
  m15: U32,
}

fn iv() -> Cv =
  {
    w0: 0x6A09_E667u32,
    w1: 0xBB67_AE85u32,
    w2: 0x3C6E_F372u32,
    w3: 0xA54F_F53Au32,
    w4: 0x510E_527Fu32,
    w5: 0x9B05_688Cu32,
    w6: 0x1F83_D9ABu32,
    w7: 0x5BE0_CD19u32,
  }

fn chunk_start() -> U32 = 1u32
fn chunk_end() -> U32 = 2u32
fn parent() -> U32 = 4u32
fn root() -> U32 = 8u32

fn block_len() -> Int = 64
fn chunk_len() -> Int = 1024

// The seven rounds, written out: scalar locals and the message schedule baked in, so a
