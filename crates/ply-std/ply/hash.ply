// The same of the square roots of the first eight.
fn sha512_initial() -> List<U64> =
  [
    0x6A09_E667_F3BC_C908u64,
    0xBB67_AE85_84CA_A73Bu64,
    0x3C6E_F372_FE94_F82Bu64,
    0xA54F_F53A_5F1D_36F1u64,
    0x510E_527F_ADE6_82D1u64,
    0x9B05_688C_2B3E_6C1Fu64,
    0x1F83_D9AB_FB41_BD6Bu64,
    0x5BE0_CD19_137E_2179u64,
  ]

fn sha512_word(xs: List<U64>, i: Int) -> U64 = match list_at(xs, i) { Some(w) -> w, None -> 0u64 }

fn sha512_big0(a: U64) -> U64 = rotr64(a, 28) ^ rotr64(a, 34) ^ rotr64(a, 39)

fn sha512_big1(e: U64) -> U64 = rotr64(e, 14) ^ rotr64(e, 18) ^ rotr64(e, 41)

fn sha512_small0(x: U64) -> U64 = rotr64(x, 1) ^ rotr64(x, 8) ^ x >>> 7

fn sha512_small1(x: U64) -> U64 = rotr64(x, 19) ^ rotr64(x, 61) ^ x >>> 6

fn sha512_sum(xs: List<U64>) -> U64 = fold(xs, 0u64, |acc: U64, x: U64| wrap_add(acc, x))

// Eighty words: the sixteen a block holds, then the four mixtures of the ones before.
fn sha512_schedule(block: List<U64>) -> List<U64> =
  fold(range(16, 80), block, |acc: List<U64>, t: Int|
    push(
      acc,
      sha512_sum([
        sha512_small1(sha512_word(acc, t - 2)),
        sha512_word(acc, t - 7),
        sha512_small0(sha512_word(acc, t - 15)),
        sha512_word(acc, t - 16),
      ]),
    ))

fn sha512_round(state: List<U64>, k: U64, w: U64) -> List<U64> = {
  let a = sha512_word(state, 0);
  let b = sha512_word(state, 1);
  let c = sha512_word(state, 2);
  let d = sha512_word(state, 3);
  let e = sha512_word(state, 4);
  let f = sha512_word(state, 5);
  let g = sha512_word(state, 6);
  let h = sha512_word(state, 7);
  let t1 = sha512_sum([h, sha512_big1(e), g ^ e & (f ^ g), k, w]);
  let t2 = wrap_add(sha512_big0(a), a & b ^ a & c ^ b & c);
  [wrap_add(t1, t2), a, b, c, wrap_add(d, t1), e, f, g]
}

fn sha512_compress(state: List<U64>, block: List<U64>) -> List<U64> = {
  let schedule = sha512_schedule(block);
  let constants = sha512_constants();
  let end = fold(range(0, 80), state, |s: List<U64>, i: Int|
    sha512_round(s, sha512_word(constants, i), sha512_word(schedule, i)));
  map(range(0, 8), |i: Int| wrap_add(sha512_word(state, i), sha512_word(end, i)))
}

fn sha512_be_at(b: Bytes, at: Int) -> U64 =
  fold(range(0, 8), 0u64, |acc: U64, i: Int| acc << 8 | u64_of_int(bytes_at(b, at + i)))

fn sha512_be(w: U64) -> Bytes =
  bytes_concat_all(map(range(0, 8), |i: Int| byte_of_int(int_of_u64(w >>> 56 - 8 * i & 0xFFu64))))

// The message, a one bit, as many zeros as leave the length sixteen short of a block, then the
// length in bits as a big-endian 128-bit number.
fn sha512_padded(input: Bytes) -> Bytes = {
  let n = bytes_len(input);
  let total = (n + 17 + 127) / 128 * 128;
  bytes_concat_all([input, b"\x80", sha_zeroes(total - n - 17), sha_zeroes(8), u64_be(n * 8)])
}

// Sixty-four bytes, of SHA-512 as the standard defines it.
pub fn sha512(input: Bytes) -> Bytes = {
  let full = sha512_padded(input);
  let state = fold(range(0, bytes_len(full) / 128), sha512_initial(), |acc: List<U64>, i: Int|
    sha512_compress(acc, map(range(0, 16), |j: Int| sha512_be_at(full, i * 128 + j * 8))));
  bytes_concat_all(map(state, sha512_be))
}

// Every byte of `b` xored with one byte, which is what an HMAC key pad is: `std.bytes`'s.

// HMAC-SHA-256, as RFC 2104 defines it and RFC 4231 publishes vectors for.
pub fn hmac_sha256(key: Bytes, message: Bytes) -> Bytes = {
  let short = if bytes_len(key) > 64 { sha256(key) } else { key };
  let pad = bytes_concat(short, sha_zeroes(64 - bytes_len(short)));
  sha256(bytes_concat(xor_byte(pad, 0x5C), sha256(bytes_concat(xor_byte(pad, 0x36), message))))
}

type ShaChain = { block: Bytes, total: Bytes }

// PBKDF2-HMAC-SHA-256 with one output block, which is thirty-two bytes: SCRAM's salted
// password, and nothing else here needs a longer key.
pub fn pbkdf2_sha256(password: Bytes, salt: Bytes, iterations: Int) -> Bytes = {
  let first = hmac_sha256(password, bytes_concat(salt, u32_be(1)));
  fold(range(1, iterations), { block: first, total: first }, |acc: ShaChain, _i: Int| {
    let next = hmac_sha256(password, acc.block);
    { block: next, total: xor(acc.total, next) }
  }).total
}

// The published test vectors.

test "the empty input" {
  assert_eq(
    blake3(b""),
    b"\xaf\x13\x49\xb9\xf5\xf9\xa1\xa6\xa0\x40\x4d\xea\x36\xdc\xc9\x49\x9b\xcb\x25\xc9\xad\xc1\x12\xb7\xcc\x9a\x93\xca\xe4\x1f\x32\x62",
  )
}

test "one byte" {
  assert_eq(
    blake3(b"\x00"),
    b"\x2d\x3a\xde\xdf\xf1\x1b\x61\xf1\x4c\x88\x6e\x35\xaf\xa0\x36\x73\x6d\xcd\x87\xa7\x4d\x27\xb5\xc1\x51\x02\x25\xd0\xf5\x92\xe2\x13",
  )
}

test "a hash is thirty-two bytes whatever the input" {
  assert_eq(bytes_len(blake3(b"")), 32);
  assert_eq(bytes_len(blake3(b"ply")), 32)
}

test "the block boundary is where a transcription goes wrong" {
  // 63, 64 and 65 bytes:
  assert_eq(bytes_len(blake3(repeat(b"a", 63))), 32);
  assert_eq(bytes_len(blake3(repeat(b"a", 64))), 32);
  assert(blake3(repeat(b"a", 64)) != blake3(repeat(b"a", 65)))
}

test "a second chunk is a tree, and a tree is not a longer chunk" {
  // 1024 is one chunk and 1025 is two chunks joined by a parent node.
  assert(blake3(repeat(b"a", 1024)) != blake3(repeat(b"a", 1025)));
  assert_eq(bytes_len(blake3(repeat(b"a", 2048))), 32)
}

fn repeat(unit: Bytes, n: Int) -> Bytes = bytes_concat_all(map(range(0, n), |_: Int| unit))

// The published SHA-256, HMAC-SHA-256 and PBKDF2-SHA-256 vectors, read as hex so a
// transcription shows up as a diff in one line rather than in thirty-two byte escapes.

fn sha_hex(b: Bytes) -> String =
  fold(range(0, bytes_len(b)), "", |acc: String, i: Int| acc ++ sha_byte_hex(bytes_at(b, i)))

fn sha_byte_hex(v: Int) -> String =
  string_slice("0123456789abcdef", v >>> 4, (v >>> 4) + 1)
    ++ string_slice("0123456789abcdef", v & 0xF, (v & 0xF) + 1)

test "sha-256 of the empty input" {
  assert_eq(
    sha_hex(sha256(b"")),
    "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
  )
}

test "sha-256 of abc" {
  assert_eq(
    sha_hex(sha256(b"abc")),
    "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
  )
}

// Fifty-six bytes is the input whose padding needs a block of its own.
test "sha-256 where the padding spills into a second block" {
  assert_eq(
    sha_hex(sha256(b"abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")),
    "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1",
  )
}

test "hmac-sha-256, against RFC 4231" {
  assert_eq(
    sha_hex(hmac_sha256(repeat(b"\x0b", 20), b"Hi There")),
    "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7",
  );
  assert_eq(
    sha_hex(hmac_sha256(b"Jefe", b"what do ya want for nothing?")),
    "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843",
  );
  assert_eq(
    sha_hex(hmac_sha256(repeat(b"\xaa", 20), repeat(b"\xdd", 50))),
    "773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe",
  )
}

test "pbkdf2-hmac-sha-256, one block" {
  assert_eq(
    sha_hex(pbkdf2_sha256(b"password", b"salt", 1)),
    "120fb6cffcf8b32c43e7225256c4f837a86548c92ccc35480805987cb70be17b",
  );
  assert_eq(
    sha_hex(pbkdf2_sha256(b"password", b"salt", 2)),
    "ae4d0c95af6b46d32d0adff928f06dd02a303f8ef3c251dfd6e2d85a95474c43",
  );
  assert_eq(
    sha_hex(pbkdf2_sha256(b"password", b"salt", 4096)),
    "c5e478d59288c841aa530db6845c4c8d962893a001ce4e11a4963873aa98134a",
  )
}

test "sha-512 of the empty input" {
  assert_eq(
    sha_hex(sha512(b"")),
    "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e",
  )
}

test "sha-512 of abc" {
  assert_eq(
    sha_hex(sha512(b"abc")),
    "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f",
  )
}

// A hundred and twelve bytes is the input whose padding needs a block of its own.
test "sha-512 where the padding spills into a second block" {
  assert_eq(
    sha_hex(
      sha512(
        b"abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu",
      ),
    ),
    "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909",
  )
}
