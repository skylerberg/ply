//! Hash functions as values, and what is written once over any of them: a digest, a digest of an
//! input that arrives in parts, HMAC, HKDF and PBKDF2.
//!
//! A `Hash` is a block size, a digest size and how a block is taken and a message ended, so `hmac`,
//! `hkdf` and `pbkdf2` take any of them. The SHA-2 and SHA-3 families, SHAKE and BLAKE2b are here;
//! MD5 and SHA-1, which are broken for collisions, are in `std.hash_legacy`, so a use of either
//! shows in an import. `blake3` is the `bytes_blake3` builtin and is no `Hash`.
//!
//! Everything else is written in Ply, and the vectors the standards publish are its tests. A round
//! keeps its working words in parameters and its state in an array it updates in place, so a digest
//! takes steps linear in its input.
//!
//! Nothing here runs in constant time, and a key is `Bytes`, since nothing written in Ply reads a
//! `Secret`.

import std.bytes (bytes_of_hex, hex_of, repeat, u32_be, u64_be, u64_le, xor, xor_byte)
import std.list (all, find)

/// The 32-byte BLAKE3 hash of `input`.
pub fn blake3(input: Bytes) -> Bytes = bytes_blake3(input)

// --- A hash as a value ------------------------------------------------------------

/// A hash function: its sizes, and how its state, an array of words, takes a block and ends.
pub type Hash = new {
  /// What its standard calls it, as `SHA-256`.
  name: String,
  /// The bytes of a block, which is what HMAC pads a key to.
  block_size: Int,
  /// The bytes of a digest.
  digest_size: Int,
  /// The state before any input.
  start: Array<Int>,
  /// `block(state, seen, data, at)` is the state after the `block_size` bytes of `data` at `at`,
  /// where `state` had `seen` bytes before them. It is never handed a message's last bytes.
  block: (Array<Int>, Int, Bytes, Int) -> Array<Int> / {abort.raise},
  /// `finish(state, seen, tail)` is the digest, where `tail` is the message's last bytes: at most
  /// `block_size` of them, and at least one unless the message is empty.
  finish: (Array<Int>, Int, Bytes) -> Bytes / {abort.raise},
}

/// A digest in progress: the state after the `seen` bytes its blocks held, and the bytes that
/// follow them, which no block has taken yet.
pub type Hasher = new { hash: Hash, words: Array<Int>, seen: Int, pending: Bytes }

/// Why a function here refused what it was asked for, with what was asked.
pub type Refusal =
  /// An output length the function does not give.
  | OutputLength(Int)
  /// A key of a length the function does not take.
  | KeyLength(Int)
  /// An iteration count below one.
  | Iterations(Int)

/// What a function of this module raises where it refuses its parameters.
pub effect hash {
  /// A length or a count is outside what the function defines.
  raise refused(e: Refusal)
}

/// The digest of `input` under `h`.
pub fn digest_of(h: Hash, input: Bytes) -> Bytes / {abort.raise} = finish(update(init(h), input))

/// A digest under `h` that has taken no input.
pub fn init(h: Hash) -> Hasher = { hash: h, words: h.start, seen: 0, pending: b"" }

/// `s` having taken `data` as well. However an input is split across calls, `finish` answers its
/// one digest.
pub fn update(s: Hasher, data: Bytes) -> Hasher / {abort.raise} = {
  let buffer = if bytes_len(s.pending) == 0 { data } else { bytes_concat(s.pending, data) };
  // The last block stays pending even when it is whole: only `finish` knows it is the last.
  taken(s, buffer, max(bytes_len(buffer) - 1, 0) / s.hash.block_size)
}

/// The digest of everything `s` has taken. `s` is a value still: it may take more.
pub fn finish(s: Hasher) -> Bytes / {abort.raise} = s.hash.finish(s.words, s.seen, s.pending)

/// Any split of an input gives the digest of the whole.
pub law schema any_split(h: Hash)
  forall (parts: List<Bytes>) {
    finish(fold(parts, init(h), update)) == digest_of(h, bytes_concat_all(parts))
  }

/// `s` after the first `count` blocks of `buffer`, which is all it has not taken, the rest pending.
fn taken(s: Hasher, buffer: Bytes, count: Int) -> Hasher / {abort.raise} = {
  let size = s.hash.block_size;
  {
    ..s,
    words: absorbed(s.hash.block, size, s.words, s.seen, buffer, 0, count),
    seen: s.seen + count * size,
    pending: bytes_slice(buffer, count * size, bytes_len(buffer)),
  }
}

/// `words` after the blocks `i` to `count` of `data`, in turn.
fn absorbed(
  block: (Array<Int>, Int, Bytes, Int) -> Array<Int> / {abort.raise},
  size: Int,
  words: Array<Int>,
  seen: Int,
  data: Bytes,
  i: Int,
  count: Int,
) -> Array<Int> / {abort.raise} =
  if i >= count { words } else {
    absorbed(block, size, block(words, seen + i * size, data, i * size), seen, data, i + 1, count)
  }

/// The state of a Merkle–Damgård hash once its message has ended: `words` after `tail`, a one bit,
/// zeros, and `length`, which is the message's length as the hash writes it, fill whole blocks.
pub fn md_closed(
  block: (Array<Int>, Int, Bytes, Int) -> Array<Int> / {abort.raise},
  block_size: Int,
  words: Array<Int>,
  seen: Int,
  tail: Bytes,
  length: Bytes,
) -> Array<Int> / {abort.raise} = {
  let used = bytes_len(tail) + 1 + bytes_len(length);
  let last = bytes_concat_all([
    tail,
    b"\x80",
    zeros((block_size - used % block_size) % block_size),
    length,
  ]);
  absorbed(block, block_size, words, seen, last, 0, bytes_len(last) / block_size)
}

fn zeros(n: Int) -> Bytes / {abort.raise} =
  if n <= 256 { bytes_slice(zero_run(), 0, max(n, 0)) }
  else { bytes_concat(zero_run(), zeros(n - 256)) }

/// Zero bytes, more than a block here holds, and made by no call, so reading them costs no step.
fn zero_run() -> Bytes = {
  let eight = b"\x00\x00\x00\x00\x00\x00\x00\x00";
  let run = bytes_concat_all([eight, eight, eight, eight, eight, eight, eight, eight]);
  bytes_concat_all([run, run, run, run])
}

// --- SHA-256 ----------------------------------------------------------------------

// A word is an `Int` below 2^32; a rotation leaves bits above it that the mask ending a sum drops.

/// The first thirty-two bits of the fractional parts of the cube roots of the first sixty-four
/// primes, as the standard publishes them.
fn sha256_constants() -> List<Int> =
  [
    0x428A_2F98,
    0x7137_4491,
    0xB5C0_FBCF,
    0xE9B5_DBA5,
    0x3956_C25B,
    0x59F1_11F1,
    0x923F_82A4,
    0xAB1C_5ED5,
    0xD807_AA98,
    0x1283_5B01,
    0x2431_85BE,
    0x550C_7DC3,
    0x72BE_5D74,
    0x80DE_B1FE,
    0x9BDC_06A7,
    0xC19B_F174,
    0xE49B_69C1,
    0xEFBE_4786,
    0x0FC1_9DC6,
    0x240C_A1CC,
    0x2DE9_2C6F,
    0x4A74_84AA,
    0x5CB0_A9DC,
    0x76F9_88DA,
    0x983E_5152,
    0xA831_C66D,
    0xB003_27C8,
    0xBF59_7FC7,
    0xC6E0_0BF3,
    0xD5A7_9147,
    0x06CA_6351,
    0x1429_2967,
    0x27B7_0A85,
    0x2E1B_2138,
    0x4D2C_6DFC,
    0x5338_0D13,
    0x650A_7354,
    0x766A_0ABB,
    0x81C2_C92E,
    0x9272_2C85,
    0xA2BF_E8A1,
    0xA81A_664B,
    0xC24B_8B70,
    0xC76C_51A3,
    0xD192_E819,
    0xD699_0624,
    0xF40E_3585,
    0x106A_A070,
    0x19A4_C116,
    0x1E37_6C08,
    0x2748_774C,
    0x34B0_BCB5,
    0x391C_0CB3,
    0x4ED8_AA4A,
    0x5B9C_CA4F,
    0x682E_6FF3,
    0x748F_82EE,
    0x78A5_636F,
    0x84C8_7814,
    0x8CC7_0208,
    0x90BE_FFFA,
    0xA450_6CEB,
    0xBEF9_A3F7,
    0xC671_78F2,
  ]

/// SHA-256 as FIPS 180-4 defines it.
pub fn sha256_hash() -> Hash = {
  let k = array_of_list(sha256_constants());
  let block = |h: Array<Int>, _: Int, data: Bytes, at: Int| sha256_block(h, k, data, at);
  {
    name: "SHA-256",
    block_size: 64,
    digest_size: 32,
    start: array_of_list([
      0x6A09_E667,
      0xBB67_AE85,
      0x3C6E_F372,
      0xA54F_F53A,
      0x510E_527F,
      0x9B05_688C,
      0x1F83_D9AB,
      0x5BE0_CD19,
    ]),
    block: block,
    finish: |h: Array<Int>, seen: Int, tail: Bytes| {
      let closed = md_closed(block, 64, h, seen, tail, u64_be((seen + bytes_len(tail)) * 8));
      bytes_concat_all(map(array_to_list(closed), u32_be))
    },
  }
}

fn sha256_block(h: Array<Int>, k: Array<Int>, data: Bytes, at: Int) -> Array<Int> / {abort.raise} = {
  let a = array_get(h, 0);
  let b = array_get(h, 1);
  let c = array_get(h, 2);
  let d = array_get(h, 3);
  let e = array_get(h, 4);
  let f = array_get(h, 5);
  let g = array_get(h, 6);
  let hh = array_get(h, 7);
  sha256_rounds(h, k, array_new(16, 0), data, at, 0, a, b, c, d, e, f, g, hh)
}

/// The rounds from `t` on. `w` holds the sixteen schedule words before `t`, the word for `t - 16`
/// where the one for `t` goes.
fn sha256_rounds(
  h: Array<Int>,
  k: Array<Int>,
  w: Array<Int>,
  data: Bytes,
  at: Int,
  t: Int,
  a: Int,
  b: Int,
  c: Int,
  d: Int,
  e: Int,
  f: Int,
  g: Int,
  hh: Int,
) -> Array<Int> / {abort.raise} =
  if t >= 64 { sha256_sum(h, a, b, c, d, e, f, g, hh) } else {
    let x = if t < 16 {
      let p = at + 4 * t;
      bytes_at(data, p) << 24 | bytes_at(data, p + 1) << 16 | bytes_at(data, p + 2) << 8
        | bytes_at(data, p + 3)
    } else {
      let w2 = array_get(w, t - 2 & 15);
      let w15 = array_get(w, t - 15 & 15);
      ((w2 >>> 17 | w2 << 15) ^ (w2 >>> 19 | w2 << 13) ^ w2 >>> 10) + array_get(w, t - 7 & 15)
        + ((w15 >>> 7 | w15 << 25) ^ (w15 >>> 18 | w15 << 14) ^ w15 >>> 3)
        + array_get(w, t & 15)
        & 0xFFFF_FFFF
    };
    let t1 = hh + ((e >>> 6 | e << 26) ^ (e >>> 11 | e << 21) ^ (e >>> 25 | e << 7))
      + (g ^ e & (f ^ g))
      + array_get(k, t)
      + x;
    let t2 = ((a >>> 2 | a << 30) ^ (a >>> 13 | a << 19) ^ (a >>> 22 | a << 10))
      + (a & b ^ a & c ^ b & c);
    sha256_rounds(
      h,
      k,
      array_set(w, t & 15, x),
      data,
      at,
      t + 1,
      t1 + t2 & 0xFFFF_FFFF,
      a,
      b,
      c,
      d + t1 & 0xFFFF_FFFF,
      e,
      f,
      g,
    )
  }

fn sha256_sum(
  h: Array<Int>,
  a: Int,
  b: Int,
  c: Int,
  d: Int,
  e: Int,
  f: Int,
  g: Int,
  hh: Int,
) -> Array<Int> / {abort.raise} = {
  let a = array_get(h, 0) + a & 0xFFFF_FFFF;
  let b = array_get(h, 1) + b & 0xFFFF_FFFF;
  let c = array_get(h, 2) + c & 0xFFFF_FFFF;
  let d = array_get(h, 3) + d & 0xFFFF_FFFF;
  let e = array_get(h, 4) + e & 0xFFFF_FFFF;
  let f = array_get(h, 5) + f & 0xFFFF_FFFF;
  let g = array_get(h, 6) + g & 0xFFFF_FFFF;
  let hh = array_get(h, 7) + hh & 0xFFFF_FFFF;
  let h = array_set(h, 0, a);
  let h = array_set(h, 1, b);
  let h = array_set(h, 2, c);
  let h = array_set(h, 3, d);
  let h = array_set(h, 4, e);
  let h = array_set(h, 5, f);
  let h = array_set(h, 6, g);
  array_set(h, 7, hh)
}

/// Thirty-two bytes, of SHA-256 as the standard defines it.
pub fn sha256(input: Bytes) -> Bytes / {abort.raise}
  cost bytes_len(input)
= digest_of(sha256_hash(), input)

// --- SHA-512, SHA-384 and SHA-512/256 ---------------------------------------------

// A word is an `Int` read as sixty-four bits; `+` is checked, so a sum is taken a half at a time.

/// The first sixty-four bits of the fractional parts of the cube roots of the first eighty primes.
fn sha512_constants() -> List<Int> =
