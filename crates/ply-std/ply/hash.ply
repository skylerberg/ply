  let v13 = rotr(v13 ^ v2, 8);
  let v8 = wrap_add(v8, v13);
  let v7 = rotr(v7 ^ v8, 7);
  let v3 = wrap_add(wrap_add(v3, v4), m.m4);
  let v14 = rotr(v14 ^ v3, 16);
  let v9 = wrap_add(v9, v14);
  let v4 = rotr(v4 ^ v9, 12);
  let v3 = wrap_add(wrap_add(v3, v4), m.m7);
  let v14 = rotr(v14 ^ v3, 8);
  let v9 = wrap_add(v9, v14);
  let v4 = rotr(v4 ^ v9, 7);
  let v0 = wrap_add(wrap_add(v0, v4), m.m11);
  let v12 = rotr(v12 ^ v0, 16);
  let v8 = wrap_add(v8, v12);
  let v4 = rotr(v4 ^ v8, 12);
  let v0 = wrap_add(wrap_add(v0, v4), m.m15);
  let v12 = rotr(v12 ^ v0, 8);
  let v8 = wrap_add(v8, v12);
  let v4 = rotr(v4 ^ v8, 7);
  let v1 = wrap_add(wrap_add(v1, v5), m.m5);
  let v13 = rotr(v13 ^ v1, 16);
  let v9 = wrap_add(v9, v13);
  let v5 = rotr(v5 ^ v9, 12);
  let v1 = wrap_add(wrap_add(v1, v5), m.m0);
  let v13 = rotr(v13 ^ v1, 8);
  let v9 = wrap_add(v9, v13);
  let v5 = rotr(v5 ^ v9, 7);
  let v2 = wrap_add(wrap_add(v2, v6), m.m1);
  let v14 = rotr(v14 ^ v2, 16);
  let v10 = wrap_add(v10, v14);
  let v6 = rotr(v6 ^ v10, 12);
  let v2 = wrap_add(wrap_add(v2, v6), m.m9);
  let v14 = rotr(v14 ^ v2, 8);
  let v10 = wrap_add(v10, v14);
  let v6 = rotr(v6 ^ v10, 7);
  let v3 = wrap_add(wrap_add(v3, v7), m.m8);
  let v15 = rotr(v15 ^ v3, 16);
  let v11 = wrap_add(v11, v15);
  let v7 = rotr(v7 ^ v11, 12);
  let v3 = wrap_add(wrap_add(v3, v7), m.m6);
  let v15 = rotr(v15 ^ v3, 8);
  let v11 = wrap_add(v11, v15);
  let v7 = rotr(v7 ^ v11, 7);
  let v0 = wrap_add(wrap_add(v0, v5), m.m14);
  let v15 = rotr(v15 ^ v0, 16);
  let v10 = wrap_add(v10, v15);
  let v5 = rotr(v5 ^ v10, 12);
  let v0 = wrap_add(wrap_add(v0, v5), m.m10);
  let v15 = rotr(v15 ^ v0, 8);
  let v10 = wrap_add(v10, v15);
  let v5 = rotr(v5 ^ v10, 7);
  let v1 = wrap_add(wrap_add(v1, v6), m.m2);
  let v12 = rotr(v12 ^ v1, 16);
  let v11 = wrap_add(v11, v12);
  let v6 = rotr(v6 ^ v11, 12);
  let v1 = wrap_add(wrap_add(v1, v6), m.m12);
  let v12 = rotr(v12 ^ v1, 8);
  let v11 = wrap_add(v11, v12);
  let v6 = rotr(v6 ^ v11, 7);
  let v2 = wrap_add(wrap_add(v2, v7), m.m3);
  let v13 = rotr(v13 ^ v2, 16);
  let v8 = wrap_add(v8, v13);
  let v7 = rotr(v7 ^ v8, 12);
  let v2 = wrap_add(wrap_add(v2, v7), m.m4);
  let v13 = rotr(v13 ^ v2, 8);
  let v8 = wrap_add(v8, v13);
  let v7 = rotr(v7 ^ v8, 7);
  let v3 = wrap_add(wrap_add(v3, v4), m.m7);
  let v14 = rotr(v14 ^ v3, 16);
  let v9 = wrap_add(v9, v14);
  let v4 = rotr(v4 ^ v9, 12);
  let v3 = wrap_add(wrap_add(v3, v4), m.m13);
  let v14 = rotr(v14 ^ v3, 8);
  let v9 = wrap_add(v9, v14);
  let v4 = rotr(v4 ^ v9, 7);
  {
    m0: v0 ^ v8,
    m1: v1 ^ v9,
    m2: v2 ^ v10,
    m3: v3 ^ v11,
    m4: v4 ^ v12,
    m5: v5 ^ v13,
    m6: v6 ^ v14,
    m7: v7 ^ v15,
    m8: v8 ^ cv.w0,
    m9: v9 ^ cv.w1,
    m10: v10 ^ cv.w2,
    m11: v11 ^ cv.w3,
    m12: v12 ^ cv.w4,
    m13: v13 ^ cv.w5,
    m14: v14 ^ cv.w6,
    m15: v15 ^ cv.w7,
  }
}

fn first8(s: Words16) -> Cv =
  { w0: s.m0, w1: s.m1, w2: s.m2, w3: s.m3, w4: s.m4, w5: s.m5, w6: s.m6, w7: s.m7 }

// Zero past the end, which is what pads a final short block.
fn byte_or_zero(input: Bytes, at: Int, limit: Int) -> Int =
  if at >= limit { 0 } else { bytes_at(input, at) }

// Little-endian; only the last block of a short input reads byte by byte, to pad with zeros.
fn word_at(input: Bytes, at: Int, limit: Int) -> U32 =
  u32_of_int(
    byte_or_zero(input, at, limit) | byte_or_zero(input, at + 1, limit) << 8
      | byte_or_zero(input, at + 2, limit) << 16
      | byte_or_zero(input, at + 3, limit) << 24,
  )

// Whether a block needs padding is a property of the block, not of each of its sixteen words.
fn block_words(input: Bytes, at: Int, limit: Int) -> Words16 =
  if at + 64 <= limit { full_words(input, at) } else { padded_words(input, at, limit) }

fn full_words(input: Bytes, at: Int) -> Words16 =
  {
    m0: bytes_u32_le(input, at),
    m1: bytes_u32_le(input, at + 4),
    m2: bytes_u32_le(input, at + 8),
    m3: bytes_u32_le(input, at + 12),
    m4: bytes_u32_le(input, at + 16),
    m5: bytes_u32_le(input, at + 20),
    m6: bytes_u32_le(input, at + 24),
    m7: bytes_u32_le(input, at + 28),
    m8: bytes_u32_le(input, at + 32),
    m9: bytes_u32_le(input, at + 36),
    m10: bytes_u32_le(input, at + 40),
    m11: bytes_u32_le(input, at + 44),
    m12: bytes_u32_le(input, at + 48),
    m13: bytes_u32_le(input, at + 52),
    m14: bytes_u32_le(input, at + 56),
    m15: bytes_u32_le(input, at + 60),
  }

fn padded_words(input: Bytes, at: Int, limit: Int) -> Words16 =
  {
    m0: word_at(input, at, limit),
    m1: word_at(input, at + 4, limit),
    m2: word_at(input, at + 8, limit),
    m3: word_at(input, at + 12, limit),
    m4: word_at(input, at + 16, limit),
    m5: word_at(input, at + 20, limit),
    m6: word_at(input, at + 24, limit),
    m7: word_at(input, at + 28, limit),
    m8: word_at(input, at + 32, limit),
    m9: word_at(input, at + 36, limit),
    m10: word_at(input, at + 40, limit),
    m11: word_at(input, at + 44, limit),
    m12: word_at(input, at + 48, limit),
    m13: word_at(input, at + 52, limit),
    m14: word_at(input, at + 56, limit),
    m15: word_at(input, at + 60, limit),
  }

// An empty input is one chunk of one empty block, which is why neither count is `0` at zero length.
fn block_count(n: Int) -> Int = if n <= 0 { 1 } else { (n + 63) / 64 }

fn chunk_count(n: Int) -> Int = if n <= 0 { 1 } else { (n + 1023) / 1024 }

fn min(a: Int, b: Int) -> Int = if a < b { a } else { b }

type ChunkStep = { cv: Cv, i: Int, out: Words16 }

fn chunk_compress(input: Bytes, chunk: Int, is_root: Bool) -> Words16 = {
  let start = chunk * chunk_len();
  let stop = min(start + chunk_len(), bytes_len(input));
  let blocks = block_count(stop - start);
  iterate({ cv: iv(), i: 0, out: empty16() }, blocks + 1, |s: ChunkStep|
    if s.i >= blocks { Stop(s.out) } else {
      let at = start + s.i * block_len();
      let limit = min(at + block_len(), stop);
      let last = s.i == blocks - 1;
      let flags = (if s.i == 0 { chunk_start() } else { 0u32 })
        | (if last { chunk_end() } else { 0u32 })
        | (if last && is_root { root() } else { 0u32 });
      let out = compress(s.cv, block_words(input, at, limit), chunk, u32_of_int(limit - at), flags);
      Continue({ cv: first8(out), i: s.i + 1, out: out })
    })
}

fn empty16() -> Words16 =
  {
    m0: 0u32,
    m1: 0u32,
    m2: 0u32,
    m3: 0u32,
    m4: 0u32,
    m5: 0u32,
    m6: 0u32,
    m7: 0u32,
    m8: 0u32,
    m9: 0u32,
    m10: 0u32,
    m11: 0u32,
    m12: 0u32,
    m13: 0u32,
    m14: 0u32,
    m15: 0u32,
  }

fn parent_compress(left: Cv, right: Cv, is_root: Bool) -> Words16 =
  compress(
    iv(),
    {
      m0: left.w0,
      m1: left.w1,
      m2: left.w2,
      m3: left.w3,
      m4: left.w4,
      m5: left.w5,
      m6: left.w6,
      m7: left.w7,
      m8: right.w0,
      m9: right.w1,
      m10: right.w2,
      m11: right.w3,
      m12: right.w4,
      m13: right.w5,
      m14: right.w6,
      m15: right.w7,
    },
    0,
    u32_of_int(block_len()),
    parent() | (if is_root { root() } else { 0u32 }),
  )

// The largest power of two strictly below `n`, which is where the tree splits.
fn left_chunks(n: Int) -> Int =
  iterate(1, 64, |p: Int| if p * 2 >= n { Stop(p) } else { Continue(p * 2) })

fn subtree(input: Bytes, lo: Int, hi: Int, is_root: Bool) -> Words16 =
  if hi - lo <= 1 { chunk_compress(input, lo, is_root) } else {
    let mid = lo + left_chunks(hi - lo);
    let left = first8(subtree(input, lo, mid, false));
    let right = first8(subtree(input, mid, hi, false));
    parent_compress(left, right, is_root)
  }

fn le_bytes(w: U32) -> Bytes = u32_le(int_of_u32(w))

// The 32-byte hash of `input`.
pub fn blake3(input: Bytes) -> Bytes = {
  let out = subtree(input, 0, chunk_count(bytes_len(input)), true);
  bytes_concat_all([
    le_bytes(out.m0),
    le_bytes(out.m1),
    le_bytes(out.m2),
    le_bytes(out.m3),
    le_bytes(out.m4),
    le_bytes(out.m5),
    le_bytes(out.m6),
    le_bytes(out.m7),
  ])
}

// The published test vectors.

test "the empty input" {
  assert_eq(
    blake3(b""),
    b"\xaf\x13\x49\xb9\xf5\xf9\xa1\xa6\xa0\x40\x4d\xea\x36\xdc\xc9\x49\x9b\xcb\x25\xc9\xad\xc1\x12\xb7\xcc\x9a\x93\xca\xe4\x1f\x32\x62",
  )
}

test "one byte" {
  assert_eq(
    blake3(b"\x00"),
    b"\x2d\x3a\xde\xdf\xf1\x1b\x61\xf1\x4c\x88\x6e\x35\xaf\xa0\x36\x73\x6d\xcd\x87\xa7\x4d\x27\xb5\xc1\x51\x02\x25\xd0\xf5\x92\xe2\x13",
  )
}

test "a hash is thirty-two bytes whatever the input" {
  assert_eq(bytes_len(blake3(b"")), 32);
  assert_eq(bytes_len(blake3(b"ply")), 32)
}

test "the block boundary is where a transcription goes wrong" {
  // 63, 64 and 65 bytes:
  assert_eq(bytes_len(blake3(repeat(b"a", 63))), 32);
  assert_eq(bytes_len(blake3(repeat(b"a", 64))), 32);
  assert(blake3(repeat(b"a", 64)) != blake3(repeat(b"a", 65)))
}

test "a second chunk is a tree, and a tree is not a longer chunk" {
  // 1024 is one chunk and 1025 is two chunks joined by a parent node.
  assert(blake3(repeat(b"a", 1024)) != blake3(repeat(b"a", 1025)));
  assert_eq(bytes_len(blake3(repeat(b"a", 2048))), 32)
}

fn repeat(unit: Bytes, n: Int) -> Bytes = bytes_concat_all(map(range(0, n), |_: Int| unit))
