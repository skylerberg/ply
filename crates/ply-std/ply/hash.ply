/// The same of the square roots of the first eight, which is where BLAKE2b starts too.
fn sha512_initial() -> List<Int> =
  [
    0x6A09_E667_F3BC_C908,
    0xBB67_AE85_84CA_A73B,
    0x3C6E_F372_FE94_F82B,
    0xA54F_F53A_5F1D_36F1,
    0x510E_527F_ADE6_82D1,
    0x9B05_688C_2B3E_6C1F,
    0x1F83_D9AB_FB41_BD6B,
    0x5BE0_CD19_137E_2179,
  ]

/// SHA-512 from the state `start`, cut to `size` bytes: the family differs in nothing else.
fn sha512_family(name: String, size: Int, start: List<Int>) -> Hash = {
  let k = array_of_list(sha512_constants());
  let block = |h: Array<Int>, _: Int, data: Bytes, at: Int| sha512_block(h, k, data, at);
  {
    name: name,
    block_size: 128,
    digest_size: size,
    start: array_of_list(start),
    block: block,
    finish: |h: Array<Int>, seen: Int, tail: Bytes| {
      let length = bytes_concat(zeros(8), u64_be((seen + bytes_len(tail)) * 8));
      let closed = md_closed(block, 128, h, seen, tail, length);
      bytes_slice(bytes_concat_all(map(array_to_list(closed), u64_be)), 0, size)
    },
  }
}

/// SHA-512 as FIPS 180-4 defines it.
pub fn sha512_hash() -> Hash = sha512_family("SHA-512", 64, sha512_initial())

/// SHA-384 as FIPS 180-4 defines it.
pub fn sha384_hash() -> Hash =
  sha512_family("SHA-384", 48, [
    0xCBBB_9D5D_C105_9ED8,
    0x629A_292A_367C_D507,
    0x9159_015A_3070_DD17,
    0x152F_ECD8_F70E_5939,
    0x6733_2667_FFC0_0B31,
    0x8EB4_4A87_6858_1511,
    0xDB0C_2E0D_64F9_8FA7,
    0x47B5_481D_BEFA_4FA4,
  ])

/// SHA-512/256 as FIPS 180-4 defines it: SHA-512's speed and a digest SHA-256's size, which no
/// length extension reaches.
pub fn sha512_256_hash() -> Hash =
  sha512_family("SHA-512/256", 32, [
    0x2231_2194_FC2B_F72C,
    0x9F55_5FA3_C84C_64C2,
    0x2393_B86B_6F53_B151,
    0x9638_7719_5940_EABD,
    0x9628_3EE2_A88E_FFE3,
    0xBE5E_1E25_5386_3992,
    0x2B01_99FC_2C85_B8AA,
    0x0EB7_2DDC_81C5_2CA2,
  ])

fn sha512_block(h: Array<Int>, k: Array<Int>, data: Bytes, at: Int) -> Array<Int> / {abort.raise} = {
  let a = array_get(h, 0);
  let b = array_get(h, 1);
  let c = array_get(h, 2);
  let d = array_get(h, 3);
  let e = array_get(h, 4);
  let f = array_get(h, 5);
  let g = array_get(h, 6);
  let hh = array_get(h, 7);
  sha512_rounds(h, k, array_new(16, 0), data, at, 0, a, b, c, d, e, f, g, hh)
}

/// The rounds from `t` on, with `w` as `sha256_rounds` keeps it.
fn sha512_rounds(
  h: Array<Int>,
  k: Array<Int>,
  w: Array<Int>,
  data: Bytes,
  at: Int,
  t: Int,
  a: Int,
  b: Int,
  c: Int,
  d: Int,
  e: Int,
  f: Int,
  g: Int,
  hh: Int,
) -> Array<Int> / {abort.raise} =
  if t >= 80 {
    array_of_list([
      add64(array_get(h, 0), a),
      add64(array_get(h, 1), b),
      add64(array_get(h, 2), c),
      add64(array_get(h, 3), d),
      add64(array_get(h, 4), e),
      add64(array_get(h, 5), f),
      add64(array_get(h, 6), g),
      add64(array_get(h, 7), hh),
    ])
  } else {
    let x = if t < 16 {
      let p = at + 8 * t;
      bytes_at(data, p) << 56 | bytes_at(data, p + 1) << 48 | bytes_at(data, p + 2) << 40
        | bytes_at(data, p + 3) << 32
        | bytes_at(data, p + 4) << 24
        | bytes_at(data, p + 5) << 16
        | bytes_at(data, p + 6) << 8
        | bytes_at(data, p + 7)
    } else {
      let w2 = array_get(w, t - 2 & 15);
      let w7 = array_get(w, t - 7 & 15);
      let w15 = array_get(w, t - 15 & 15);
      let w16 = array_get(w, t & 15);
      let s1 = (w2 >>> 19 | w2 << 45) ^ (w2 >>> 61 | w2 << 3) ^ w2 >>> 6;
      let s0 = (w15 >>> 1 | w15 << 63) ^ (w15 >>> 8 | w15 << 56) ^ w15 >>> 7;
      let low = (s1 & 0xFFFF_FFFF) + (w7 & 0xFFFF_FFFF) + (s0 & 0xFFFF_FFFF) + (w16 & 0xFFFF_FFFF);
      (s1 >>> 32) + (w7 >>> 32) + (s0 >>> 32) + (w16 >>> 32) + (low >>> 32) << 32
        | low & 0xFFFF_FFFF
    };
    let s1 = (e >>> 14 | e << 50) ^ (e >>> 18 | e << 46) ^ (e >>> 41 | e << 23);
    let ch = g ^ e & (f ^ g);
    let kt = array_get(k, t);
    let s0 = (a >>> 28 | a << 36) ^ (a >>> 34 | a << 30) ^ (a >>> 39 | a << 25);
    let maj = a & b ^ a & c ^ b & c;
    // `t1` a half at a time, which `a` and `e` each add their own words to.
    let low = (hh & 0xFFFF_FFFF) + (s1 & 0xFFFF_FFFF) + (ch & 0xFFFF_FFFF) + (kt & 0xFFFF_FFFF)
      + (x & 0xFFFF_FFFF);
    let high = (hh >>> 32) + (s1 >>> 32) + (ch >>> 32) + (kt >>> 32) + (x >>> 32);
    let low_a = low + (s0 & 0xFFFF_FFFF) + (maj & 0xFFFF_FFFF);
    let low_e = low + (d & 0xFFFF_FFFF);
    sha512_rounds(
      h,
      k,
      array_set(w, t & 15, x),
      data,
      at,
      t + 1,
      high + (s0 >>> 32) + (maj >>> 32) + (low_a >>> 32) << 32 | low_a & 0xFFFF_FFFF,
      a,
      b,
      c,
      high + (d >>> 32) + (low_e >>> 32) << 32 | low_e & 0xFFFF_FFFF,
      e,
      f,
      g,
    )
  }

/// Two 64-bit words added, wrapping.
fn add64(a: Int, b: Int) -> Int = {
  let low = (a & 0xFFFF_FFFF) + (b & 0xFFFF_FFFF);
  (a >>> 32) + (b >>> 32) + (low >>> 32) << 32 | low & 0xFFFF_FFFF
}

/// Sixty-four bytes, of SHA-512 as the standard defines it.
pub fn sha512(input: Bytes) -> Bytes / {abort.raise}
  cost bytes_len(input)
= digest_of(sha512_hash(), input)

/// Forty-eight bytes, of SHA-384 as the standard defines it.
pub fn sha384(input: Bytes) -> Bytes / {abort.raise}
  cost bytes_len(input)
= digest_of(sha384_hash(), input)

/// Thirty-two bytes, of SHA-512/256 as the standard defines it.
pub fn sha512_256(input: Bytes) -> Bytes / {abort.raise}
  cost bytes_len(input)
= digest_of(sha512_256_hash(), input)

// --- SHA-3 and SHAKE --------------------------------------------------------------

/// The round constants of Keccak-f[1600].
fn keccak_constants() -> List<Int> =
  [
    0x0000_0000_0000_0001,
    0x0000_0000_0000_8082,
    0x8000_0000_0000_808A,
    0x8000_0000_8000_8000,
    0x0000_0000_0000_808B,
    0x0000_0000_8000_0001,
    0x8000_0000_8000_8081,
    0x8000_0000_0000_8009,
    0x0000_0000_0000_008A,
    0x0000_0000_0000_0088,
    0x0000_0000_8000_8009,
    0x0000_0000_8000_000A,
    0x0000_0000_8000_808B,
    0x8000_0000_0000_008B,
    0x8000_0000_0000_8089,
    0x8000_0000_0000_8003,
    0x8000_0000_0000_8002,
    0x8000_0000_0000_0080,
    0x0000_0000_0000_800A,
    0x8000_0000_8000_000A,
    0x8000_0000_8000_8081,
    0x8000_0000_0000_8080,
    0x0000_0000_8000_0001,
    0x8000_0000_8000_8008,
  ]

/// A sponge over Keccak-f[1600] as FIPS 202 defines one: `rate` bytes a block, `size` bytes of
/// output, and `suffix`, the bits a function appends to its message with the padding's first bit.
fn sponge(name: String, rate: Int, size: Int, suffix: Int) -> Hash = {
  let rc = array_of_list(keccak_constants());
  let block = |s: Array<Int>, _: Int, data: Bytes, at: Int|
    keccak_rounds(keccak_mixed(s, data, at, 0, rate / 8), rc, 0);
  {
    name: name,
    block_size: rate,
    digest_size: size,
    start: array_of_list(map(range(0, 25), |_: Int| 0)),
    block: block,
    finish: |s: Array<Int>, seen: Int, tail: Bytes| {
      let fill = rate - bytes_len(tail) % rate;
      let padding = if fill == 1 { byte_of_int(suffix | 0x80) }
      else { bytes_concat_all([byte_of_int(suffix), zeros(fill - 2), b"\x80"]) };
      let last = bytes_concat(tail, padding);
      let full = absorbed(block, rate, s, seen, last, 0, bytes_len(last) / rate);
      bytes_slice(
        bytes_concat_all(squeezed(full, rc, rate, 0, (size + rate - 1) / rate, [])),
        0,
        size,
      )
    },
  }
}

/// The state with the block's first `lanes` lanes xored in, each least significant byte first.
fn keccak_mixed(
  s: Array<Int>,
  data: Bytes,
  at: Int,
  i: Int,
  lanes: Int,
) -> Array<Int> / {abort.raise} =
  if i >= lanes { s } else {
    let p = at + 8 * i;
    let lane = array_get(s, i)
      ^ (int_of_u32(bytes_u32_le(data, p)) | int_of_u32(bytes_u32_le(data, p + 4)) << 32);
    keccak_mixed(array_set(s, i, lane), data, at, i + 1, lanes)
  }

/// `rate` bytes of output a block, the state permuted between one and the next.
fn squeezed(
  s: Array<Int>,
  rc: Array<Int>,
  rate: Int,
  i: Int,
  blocks: Int,
  out: List<Bytes>,
) -> List<Bytes> / {abort.raise} =
  if i >= blocks { out } else {
    let next = if i == 0 { s } else { keccak_rounds(s, rc, 0) };
    let lanes = bytes_concat_all(map(array_to_list(next), u64_le));
    squeezed(next, rc, rate, i + 1, blocks, push(out, bytes_slice(lanes, 0, rate)))
  }

/// The rounds of Keccak-f[1600] from `round` on, a round written out: the column parities `c` and
/// what each column takes from its neighbours `d` (theta), every lane rotated into its new place
/// `b` (rho and pi), then each row mixed (chi) and the round's constant (iota).
fn keccak_rounds(s: Array<Int>, rc: Array<Int>, round: Int) -> Array<Int> / {abort.raise} =
  if round >= 24 { s } else {
    let a0 = array_get(s, 0);
    let a1 = array_get(s, 1);
    let a2 = array_get(s, 2);
    let a3 = array_get(s, 3);
    let a4 = array_get(s, 4);
    let a5 = array_get(s, 5);
    let a6 = array_get(s, 6);
    let a7 = array_get(s, 7);
    let a8 = array_get(s, 8);
    let a9 = array_get(s, 9);
    let a10 = array_get(s, 10);
    let a11 = array_get(s, 11);
    let a12 = array_get(s, 12);
    let a13 = array_get(s, 13);
    let a14 = array_get(s, 14);
    let a15 = array_get(s, 15);
    let a16 = array_get(s, 16);
    let a17 = array_get(s, 17);
    let a18 = array_get(s, 18);
    let a19 = array_get(s, 19);
    let a20 = array_get(s, 20);
    let a21 = array_get(s, 21);
    let a22 = array_get(s, 22);
    let a23 = array_get(s, 23);
    let a24 = array_get(s, 24);
    let c0 = a0 ^ a5 ^ a10 ^ a15 ^ a20;
    let c1 = a1 ^ a6 ^ a11 ^ a16 ^ a21;
    let c2 = a2 ^ a7 ^ a12 ^ a17 ^ a22;
    let c3 = a3 ^ a8 ^ a13 ^ a18 ^ a23;
    let c4 = a4 ^ a9 ^ a14 ^ a19 ^ a24;
    let d0 = c4 ^ (c1 << 1 | c1 >>> 63);
    let d1 = c0 ^ (c2 << 1 | c2 >>> 63);
    let d2 = c1 ^ (c3 << 1 | c3 >>> 63);
    let d3 = c2 ^ (c4 << 1 | c4 >>> 63);
    let d4 = c3 ^ (c0 << 1 | c0 >>> 63);
    let b0 = a0 ^ d0;
    let b1 = (a6 ^ d1) << 44 | (a6 ^ d1) >>> 20;
    let b2 = (a12 ^ d2) << 43 | (a12 ^ d2) >>> 21;
    let b3 = (a18 ^ d3) << 21 | (a18 ^ d3) >>> 43;
    let b4 = (a24 ^ d4) << 14 | (a24 ^ d4) >>> 50;
    let b5 = (a3 ^ d3) << 28 | (a3 ^ d3) >>> 36;
    let b6 = (a9 ^ d4) << 20 | (a9 ^ d4) >>> 44;
    let b7 = (a10 ^ d0) << 3 | (a10 ^ d0) >>> 61;
    let b8 = (a16 ^ d1) << 45 | (a16 ^ d1) >>> 19;
    let b9 = (a22 ^ d2) << 61 | (a22 ^ d2) >>> 3;
    let b10 = (a1 ^ d1) << 1 | (a1 ^ d1) >>> 63;
    let b11 = (a7 ^ d2) << 6 | (a7 ^ d2) >>> 58;
    let b12 = (a13 ^ d3) << 25 | (a13 ^ d3) >>> 39;
    let b13 = (a19 ^ d4) << 8 | (a19 ^ d4) >>> 56;
    let b14 = (a20 ^ d0) << 18 | (a20 ^ d0) >>> 46;
    let b15 = (a4 ^ d4) << 27 | (a4 ^ d4) >>> 37;
    let b16 = (a5 ^ d0) << 36 | (a5 ^ d0) >>> 28;
    let b17 = (a11 ^ d1) << 10 | (a11 ^ d1) >>> 54;
    let b18 = (a17 ^ d2) << 15 | (a17 ^ d2) >>> 49;
    let b19 = (a23 ^ d3) << 56 | (a23 ^ d3) >>> 8;
    let b20 = (a2 ^ d2) << 62 | (a2 ^ d2) >>> 2;
    let b21 = (a8 ^ d3) << 55 | (a8 ^ d3) >>> 9;
    let b22 = (a14 ^ d4) << 39 | (a14 ^ d4) >>> 25;
    let b23 = (a15 ^ d0) << 41 | (a15 ^ d0) >>> 23;
    let b24 = (a21 ^ d1) << 2 | (a21 ^ d1) >>> 62;
    keccak_rounds(
      array_of_list([
        b0 ^ ~b1 & b2 ^ array_get(rc, round),
        b1 ^ ~b2 & b3,
        b2 ^ ~b3 & b4,
        b3 ^ ~b4 & b0,
        b4 ^ ~b0 & b1,
        b5 ^ ~b6 & b7,
        b6 ^ ~b7 & b8,
        b7 ^ ~b8 & b9,
        b8 ^ ~b9 & b5,
        b9 ^ ~b5 & b6,
        b10 ^ ~b11 & b12,
        b11 ^ ~b12 & b13,
        b12 ^ ~b13 & b14,
        b13 ^ ~b14 & b10,
        b14 ^ ~b10 & b11,
        b15 ^ ~b16 & b17,
        b16 ^ ~b17 & b18,
        b17 ^ ~b18 & b19,
        b18 ^ ~b19 & b15,
        b19 ^ ~b15 & b16,
        b20 ^ ~b21 & b22,
        b21 ^ ~b22 & b23,
        b22 ^ ~b23 & b24,
        b23 ^ ~b24 & b20,
        b24 ^ ~b20 & b21,
      ]),
      rc,
      round + 1,
    )
  }

/// SHA3-224 as FIPS 202 defines it.
pub fn sha3_224_hash() -> Hash = sponge("SHA3-224", 144, 28, 0x06)

/// SHA3-256 as FIPS 202 defines it.
pub fn sha3_256_hash() -> Hash = sponge("SHA3-256", 136, 32, 0x06)

/// SHA3-384 as FIPS 202 defines it.
pub fn sha3_384_hash() -> Hash = sponge("SHA3-384", 104, 48, 0x06)

/// SHA3-512 as FIPS 202 defines it.
pub fn sha3_512_hash() -> Hash = sponge("SHA3-512", 72, 64, 0x06)

/// SHAKE128 as FIPS 202 defines it, read to `length` bytes. A length below zero is refused as an
/// `OutputLength`.
pub fn shake128_hash(length: Int) -> Hash / {hash.refused} =
  if length < 0 { hash.refused(OutputLength(length)) }
  else { sponge("SHAKE128", 168, length, 0x1F) }

/// SHAKE256 as FIPS 202 defines it, read to `length` bytes. A length below zero is refused as an
/// `OutputLength`.
pub fn shake256_hash(length: Int) -> Hash / {hash.refused} =
  if length < 0 { hash.refused(OutputLength(length)) }
  else { sponge("SHAKE256", 136, length, 0x1F) }

/// Twenty-eight bytes, of SHA3-224 as the standard defines it.
pub fn sha3_224(input: Bytes) -> Bytes / {abort.raise}
  cost bytes_len(input)
= digest_of(sha3_224_hash(), input)

/// Thirty-two bytes, of SHA3-256 as the standard defines it.
pub fn sha3_256(input: Bytes) -> Bytes / {abort.raise}
  cost bytes_len(input)
= digest_of(sha3_256_hash(), input)

/// Forty-eight bytes, of SHA3-384 as the standard defines it.
pub fn sha3_384(input: Bytes) -> Bytes / {abort.raise}
  cost bytes_len(input)
= digest_of(sha3_384_hash(), input)

/// Sixty-four bytes, of SHA3-512 as the standard defines it.
pub fn sha3_512(input: Bytes) -> Bytes / {abort.raise}
  cost bytes_len(input)
= digest_of(sha3_512_hash(), input)

/// `length` bytes of SHAKE128 over `input`; a length below zero is refused as an `OutputLength`.
pub fn shake128(input: Bytes, length: Int) -> Bytes / {hash.refused, abort.raise}
  cost bytes_len(input) + length
= digest_of(shake128_hash(length), input)

/// `length` bytes of SHAKE256 over `input`; a length below zero is refused as an `OutputLength`.
pub fn shake256(input: Bytes, length: Int) -> Bytes / {hash.refused, abort.raise}
  cost bytes_len(input) + length
= digest_of(shake256_hash(length), input)

// --- BLAKE2b ----------------------------------------------------------------------

/// Which message word each step of each of the twelve rounds takes: RFC 7693's SIGMA, a hex digit
/// a word.
fn blake2b_schedule() -> Array<Int> =
  array_of_list(
    map(
      string_chars(
        "0123456789abcdef" ++ "ea489fd61c02b753" ++ "b8c052fdae367194" ++ "7931dcbe265a40f8"
          ++ "905724afe1bc683d"
          ++ "2c6a0b834d75fe19"
          ++ "c51fed4a0763928b"
          ++ "db7ec13950f4862a"
          ++ "6fe9b308c2d714a5"
          ++ "a2847615fb9e3cd0"
          ++ "0123456789abcdef"
          ++ "ea489fd61c02b753",
      ),
      |c: Char| if int_of_char(c) >= 97 { int_of_char(c) - 87 } else { int_of_char(c) - 48 },
    ),
  )

/// BLAKE2b as RFC 7693 defines it, with a digest of sixty-four bytes and no key.
pub fn blake2b_hash() -> Hash / {abort.raise} = blake2b_over(b"", 64)

/// BLAKE2b with a digest of `size` bytes, keyed by `key` where that is not empty, which makes it a
/// MAC with no HMAC around it. A size outside one to sixty-four is refused as an `OutputLength`,
/// and a key past sixty-four bytes as a `KeyLength`.
pub fn blake2b_with(key: Bytes, size: Int) -> Hash / {hash.refused, abort.raise} =
  if size < 1 || size > 64 { hash.refused(OutputLength(size)) }
  else if bytes_len(key) > 64 { hash.refused(KeyLength(bytes_len(key))) }
  else { blake2b_over(key, size) }

/// A key is a block of its own before the message, so the state's count runs a block ahead of what
/// the message has had taken, and the key's block is taken when the first of the message is.
fn blake2b_over(key: Bytes, size: Int) -> Hash / {abort.raise} = {
  let iv = array_of_list(sha512_initial());
  let sigma = blake2b_schedule();
  let keyed = bytes_len(key) > 0;
  let lead = if keyed { 128 } else { 0 };
  let first = bytes_concat(key, zeros(128 - bytes_len(key)));
  let entered = |h: Array<Int>, seen: Int|
    if keyed && seen == 0 { blake2b_compress(h, iv, sigma, first, 0, 128, false) } else { h };
  {
    name: "BLAKE2b",
    block_size: 128,
    digest_size: size,
    start: array_set(iv, 0, array_get(iv, 0) ^ 0x0101_0000 ^ bytes_len(key) << 8 ^ size),
    block: |h: Array<Int>, seen: Int, data: Bytes, at: Int|
      blake2b_compress(entered(h, seen), iv, sigma, data, at, lead + seen + 128, false),
    finish: |h: Array<Int>, seen: Int, tail: Bytes| {
      let n = bytes_len(tail);
      let ended = if keyed && seen == 0 && n == 0 {
        blake2b_compress(h, iv, sigma, first, 0, 128, true)
      } else {
        blake2b_compress(
          entered(h, seen),
          iv,
          sigma,
          bytes_concat(tail, zeros(128 - n)),
          0,
          lead + seen + n,
          true,
        )
      };
      bytes_slice(bytes_concat_all(map(array_to_list(ended), u64_le)), 0, size)
    },
  }
}

/// F of RFC 7693: `h` after the block of `data` at `at`, where `count` is the message's bytes up
/// to that block's end and `last` says no block follows.
fn blake2b_compress(
  h: Array<Int>,
  iv: Array<Int>,
  sigma: Array<Int>,
  data: Bytes,
  at: Int,
  count: Int,
  last: Bool,
) -> Array<Int> / {abort.raise} = {
  let v = blake2b_mixed(
    array_of_list(
      map(range(0, 16), |i: Int|
        if i < 8 { array_get(h, i) }
        else if i == 12 { array_get(iv, 4) ^ count }
        else if i == 14 && last { ~array_get(iv, 6) }
        else { array_get(iv, i - 8) }),
    ),
    sigma,
    data,
    at,
    0,
  );
  array_of_list(map(range(0, 8), |i: Int| array_get(h, i) ^ array_get(v, i) ^ array_get(v, i + 8)))
}

/// The ninety-six steps from `i` on, eight a round: four down the columns of `v`, then four along
/// its diagonals.
fn blake2b_mixed(
  v: Array<Int>,
  sigma: Array<Int>,
  data: Bytes,
  at: Int,
  i: Int,
) -> Array<Int> / {abort.raise} =
  if i >= 96 { v } else {
    let a = i & 3;
    let turn = i >>> 2 & 1;
    blake2b_mixed(
      blake2b_g(
        v,
        a,
        4 + (a + turn & 3),
        8 + (a + 2 * turn & 3),
        12 + (a + 3 * turn & 3),
        data,
        at + 8 * array_get(sigma, 2 * i),
        at + 8 * array_get(sigma, 2 * i + 1),
      ),
      sigma,
      data,
      at,
      i + 1,
    )
  }

/// G of RFC 7693 over the words `a`, `b`, `c` and `d` of `v`, with the message words at `px` and
/// `py`.
fn blake2b_g(
  v: Array<Int>,
  a: Int,
  b: Int,
  c: Int,
  d: Int,
  data: Bytes,
  px: Int,
  py: Int,
) -> Array<Int> / {abort.raise} = {
  let x = int_of_u32(bytes_u32_le(data, px)) | int_of_u32(bytes_u32_le(data, px + 4)) << 32;
  let y = int_of_u32(bytes_u32_le(data, py)) | int_of_u32(bytes_u32_le(data, py + 4)) << 32;
  let va = array_get(v, a);
  let vb = array_get(v, b);
  let vc = array_get(v, c);
  let vd = array_get(v, d);
  let low = (va & 0xFFFF_FFFF) + (vb & 0xFFFF_FFFF) + (x & 0xFFFF_FFFF);
  let va = (va >>> 32) + (vb >>> 32) + (x >>> 32) + (low >>> 32) << 32 | low & 0xFFFF_FFFF;
  let vd = (vd ^ va) >>> 32 | (vd ^ va) << 32;
  let low = (vc & 0xFFFF_FFFF) + (vd & 0xFFFF_FFFF);
  let vc = (vc >>> 32) + (vd >>> 32) + (low >>> 32) << 32 | low & 0xFFFF_FFFF;
  let vb = (vb ^ vc) >>> 24 | (vb ^ vc) << 40;
  let low = (va & 0xFFFF_FFFF) + (vb & 0xFFFF_FFFF) + (y & 0xFFFF_FFFF);
  let va = (va >>> 32) + (vb >>> 32) + (y >>> 32) + (low >>> 32) << 32 | low & 0xFFFF_FFFF;
  let vd = (vd ^ va) >>> 16 | (vd ^ va) << 48;
  let low = (vc & 0xFFFF_FFFF) + (vd & 0xFFFF_FFFF);
  let vc = (vc >>> 32) + (vd >>> 32) + (low >>> 32) << 32 | low & 0xFFFF_FFFF;
  let vb = (vb ^ vc) >>> 63 | (vb ^ vc) << 1;
  array_set(array_set(array_set(array_set(v, a, va), b, vb), c, vc), d, vd)
}

/// Sixty-four bytes, of BLAKE2b as RFC 7693 defines it.
pub fn blake2b(input: Bytes) -> Bytes / {abort.raise}
  cost bytes_len(input)
= digest_of(blake2b_hash(), input)

// --- HMAC -------------------------------------------------------------------------

/// A key as HMAC uses it: its two pads, and the state after each for a message that follows one.
type Keyed = { inner_pad: Bytes, outer_pad: Bytes, inner: Hasher, outer: Hasher }

fn keyed(h: Hash, key: Bytes) -> Keyed / {abort.raise} = {
  let short = if bytes_len(key) > h.block_size { digest_of(h, key) } else { key };
  let block = bytes_concat(short, zeros(h.block_size - bytes_len(short)));
  let inner_pad = xor_byte(block, 0x36);
  let outer_pad = xor_byte(block, 0x5C);
  {
    inner_pad: inner_pad,
    outer_pad: outer_pad,
    inner: taken(init(h), inner_pad, bytes_len(inner_pad) / h.block_size),
    outer: taken(init(h), outer_pad, bytes_len(outer_pad) / h.block_size),
  }
}

/// The digest of `pad` and then `data`. `after` took the pad's blocks as if more followed, which
/// holds only where `data` is not empty.
fn continued(after: Hasher, pad: Bytes, data: Bytes) -> Bytes / {abort.raise} =
  if bytes_len(data) == 0 { digest_of(after.hash, pad) } else { finish(update(after, data)) }

fn tagged(k: Keyed, message: Bytes) -> Bytes / {abort.raise} =
  continued(k.outer, k.outer_pad, continued(k.inner, k.inner_pad, message))

/// HMAC over `h`, as RFC 2104 defines it: a tag of `h.digest_size` bytes. Compare one with
/// `tags_match`, never `==`.
pub fn hmac(h: Hash, key: Bytes, message: Bytes) -> Bytes / {abort.raise} =
  tagged(keyed(h, key), message)

/// Whether `tag` is the HMAC of `message` under `key`, compared as `tags_match` compares.
pub fn hmac_verify(h: Hash, key: Bytes, message: Bytes, tag: Bytes) -> Bool / {abort.raise} =
  tags_match(hmac(h, key, message), tag)

/// Whether two tags are the same bytes.
///
/// Two of one length are read to their ends whatever they hold, so the calls made, which is what
/// `metered` counts as steps, depend on the length alone and not on where they first differ. That
/// is all it promises: the compiled code's time is not held constant, and two of different lengths
/// answer `false` at once, a tag's length being no secret.
pub fn tags_match(a: Bytes, b: Bytes) -> Bool / {abort.raise} =
  bytes_len(a) == bytes_len(b) && differing(a, b, 0, 0) == 0

fn differing(a: Bytes, b: Bytes, i: Int, bits: Int) -> Int / {abort.raise} =
  if i >= bytes_len(a) { bits }
  else { differing(a, b, i + 1, bits | bytes_at(a, i) ^ bytes_at(b, i)) }

/// HMAC-SHA-256, as RFC 4231 publishes vectors for.
pub fn hmac_sha256(key: Bytes, message: Bytes) -> Bytes / {abort.raise}
  cost bytes_len(key) + bytes_len(message)
= hmac(sha256_hash(), key, message)

// --- HKDF and PBKDF2 --------------------------------------------------------------

/// HKDF's first step, as RFC 5869 defines it: a pseudorandom key of `h.digest_size` bytes out of
/// `key`, which need not be uniform, and `salt`, which may be empty.
pub fn hkdf_extract(h: Hash, salt: Bytes, key: Bytes) -> Bytes / {abort.raise} = hmac(h, salt, key)

/// HKDF's second step: `length` bytes out of the pseudorandom key `prk`, bound to `info`. A length
/// below zero or past 255 digests is refused as an `OutputLength`, and a `prk` shorter than a
/// digest as a `KeyLength`.
pub fn hkdf_expand(
  h: Hash,
  prk: Bytes,
  info: Bytes,
  length: Int,
) -> Bytes / {hash.refused, abort.raise} =
  if length < 0 || length > 255 * h.digest_size { hash.refused(OutputLength(length)) }
  else if bytes_len(prk) < h.digest_size { hash.refused(KeyLength(bytes_len(prk))) }
  else if length == 0 { b"" } else {
    let k = keyed(h, prk);
    let made = fold(
      range(1, (length + h.digest_size - 1) / h.digest_size + 1),
      { last: b"", all: [] },
      |acc: { last: Bytes, all: List<Bytes> }, i: Int| {
        let next = tagged(k, bytes_concat_all([acc.last, info, byte_of_int(i)]));
        { last: next, all: push(acc.all, next) }
      },
    );
    bytes_slice(bytes_concat_all(made.all), 0, length)
  }

/// HKDF, both steps: `length` bytes of key out of `key`, `salt` and `info`. It refuses a length as
/// `hkdf_expand` does.
pub fn hkdf(
  h: Hash,
  salt: Bytes,
  key: Bytes,
  info: Bytes,
  length: Int,
) -> Bytes / {hash.refused, abort.raise} = hkdf_expand(h, hkdf_extract(h, salt, key), info, length)

/// PBKDF2 over HMAC over `h`, as RFC 8018 defines it: `length` bytes out of a password, stretched
/// by `iterations` rounds. An iteration count below one is refused as `Iterations`, and a length
/// below one or past 2^32 - 1 digests as an `OutputLength`.
pub fn pbkdf2(
  h: Hash,
  password: Bytes,
  salt: Bytes,
  iterations: Int,
  length: Int,
) -> Bytes / {hash.refused, abort.raise} =
  if iterations < 1 { hash.refused(Iterations(iterations)) }
  else if length < 1 || length > 0xFFFF_FFFF * h.digest_size { hash.refused(OutputLength(length)) }
  else {
    let k = keyed(h, password);
    let blocks = map(range(1, (length + h.digest_size - 1) / h.digest_size + 1), |i: Int| {
      let first = tagged(k, bytes_concat(salt, u32_be(i)));
      stretched(k, first, first, iterations - 1)
    });
    bytes_slice(bytes_concat_all(blocks), 0, length)
  }

/// `sum` xored with each of the `left` tags that follow `last`, each the tag of the one before.
fn stretched(k: Keyed, last: Bytes, sum: Bytes, left: Int) -> Bytes / {abort.raise} =
  if left <= 0 { sum } else {
    let next = tagged(k, last);
    stretched(k, next, xor(sum, next), left - 1)
  }

/// PBKDF2-HMAC-SHA-256 with one output block, which is thirty-two bytes: SCRAM's salted password.
/// It raises for an iteration count below one.
pub fn pbkdf2_sha256(password: Bytes, salt: Bytes, iterations: Int) -> Bytes / {abort.raise} =
  handle {
    pbkdf2(sha256_hash(), password, salt, iterations, 32)
  } with {
    hash.refused(_) -> panic("PBKDF2 takes an iteration count of one or more"),
  }

// --- Tests ------------------------------------------------------------------

test "the empty input" {
  assert_eq(
    blake3(b""),
    b"\xaf\x13\x49\xb9\xf5\xf9\xa1\xa6\xa0\x40\x4d\xea\x36\xdc\xc9\x49\x9b\xcb\x25\xc9\xad\xc1\x12\xb7\xcc\x9a\x93\xca\xe4\x1f\x32\x62",
  )
}

test "one byte" {
  assert_eq(
    blake3(b"\x00"),
    b"\x2d\x3a\xde\xdf\xf1\x1b\x61\xf1\x4c\x88\x6e\x35\xaf\xa0\x36\x73\x6d\xcd\x87\xa7\x4d\x27\xb5\xc1\x51\x02\x25\xd0\xf5\x92\xe2\x13",
  )
}

test "a hash is thirty-two bytes whatever the input" {
  assert_eq(bytes_len(blake3(b"")), 32);
  assert_eq(bytes_len(blake3(b"ply")), 32)
}

test "the block boundary is where a transcription goes wrong" {
  // 63, 64 and 65 bytes:
  assert_eq(bytes_len(blake3(repeat(b"a", 63))), 32);
  assert_eq(bytes_len(blake3(repeat(b"a", 64))), 32);
  assert(blake3(repeat(b"a", 64)) != blake3(repeat(b"a", 65)))
}

test "a second chunk is a tree, and a tree is not a longer chunk" {
  // 1024 is one chunk and 1025 is two chunks joined by a parent node.
  assert(blake3(repeat(b"a", 1024)) != blake3(repeat(b"a", 1025)));
  assert_eq(bytes_len(blake3(repeat(b"a", 2048))), 32)
}

/// Every hash here that takes no parameter.
fn every() -> List<Hash> / {abort.raise} =
  [
    sha256_hash(),
    sha384_hash(),
    sha512_hash(),
    sha512_256_hash(),
    sha3_224_hash(),
    sha3_256_hash(),
    sha3_384_hash(),
    sha3_512_hash(),
    blake2b_hash(),
  ]

/// The hash of that name, a SHAKE read to thirty-two bytes.
fn named(name: String) -> Hash / {hash.refused, abort.raise} =
  match find(push(push(every(), shake128_hash(32)), shake256_hash(32)), |h: Hash| h.name == name) {
    Some(h) -> h,
    None -> panic("no hash here is named " ++ name),
  }

