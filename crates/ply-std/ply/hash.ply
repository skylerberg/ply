  let v13 = u32_of_int(counter >>> 32 & 0xFFFF_FFFF);
  let v14 = len;
  let v15 = flags;
  let v0 = wrap_add(wrap_add(v0, v4), m.m0);
  let v12 = rotr(v12 ^ v0, 16);
  let v8 = wrap_add(v8, v12);
  let v4 = rotr(v4 ^ v8, 12);
  let v0 = wrap_add(wrap_add(v0, v4), m.m1);
  let v12 = rotr(v12 ^ v0, 8);
  let v8 = wrap_add(v8, v12);
