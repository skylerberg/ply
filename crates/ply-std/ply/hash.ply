test "FIPS 180-4: {v.hash} of {v.message}" for v: Digest in fips_180() {
  assert_eq(hex_of(digest_of(named(v.hash), v.input)), v.digest)
}

test "FIPS 202: {v.hash} of {v.message}" for v: Digest in fips_202() {
  assert_eq(hex_of(digest_of(named(v.hash), v.input)), v.digest)
}

test "FIPS 202: {v.hash} of {v.message}, read to {v.length} bytes" for v: Squeeze in shake_examples(
  ) {
  let output = if v.hash == "SHAKE128" { shake128(v.input, v.length) }
  else { shake256(v.input, v.length) };
  assert_eq(hex_of(output), v.output)
}

/// A hash and the one digest its sweep comes to.
type Sweep = { hash: String, digest: String }

/// For each hash, its digest of its own digests of the first `n` bytes of `varied`, for every `n` to
/// 340, which is past two blocks of any of them, as another implementation computes it.
fn sweeps() -> List<Sweep> =
  [
    { hash: "SHA-256", digest: "bedbf56584b708fc9b41134658e504acf4a1997674d9f68ee930dfe060841106" },
    {
      hash: "SHA-384",
      digest: "2cf62d61a6068c6a2a0d18777cce8f0943d2f4212e84030cac4485f0bd8e5fa7064b7fd8ebced45bf3a8c5755093c9da",
    },
    {
      hash: "SHA-512",
      digest: "f865089c08bef7bda34a9d08cdc19c66e9893576ec08b2a6be17768cced4423e65e03d43fa4274df770200229df3d54bc3e5d2501937ae9a264218a99cb79bc0",
    },
    {
      hash: "SHA-512/256",
      digest: "1bd9605fc3d8c56234a286020e0c7eac1a68f2b32b6834181417e083f60bf1d5",
    },
    { hash: "SHA3-224", digest: "3ec903479ace331dc7f6f33d6059fe74466c5f2a554e4a0466f32ec6" },
    {
      hash: "SHA3-256",
      digest: "d6d65a8f9b8d118cfbc2c962463aea8188e4c3b7fa1773d36f6eba15c9b65b2e",
    },
    {
      hash: "SHA3-384",
      digest: "c4a8d0300e406168e123153a5cb83405c569843059ebc2785cbc3bc3c8cb936856fd4461d576bee217ef1b255e5c0a7b",
    },
    {
      hash: "SHA3-512",
      digest: "64c9ff4cd1d06cb8528301863bb6944cdb3bcc4d73775fab911326851313768fbdc72aeda4a017e053a9d68128c11bce89b21afc21071c0853e95916525a60b2",
    },
    {
      hash: "SHAKE128",
      digest: "6f3997c6af2cd1b26661fd88c37153b50a6d9a302ae4906de7e30ca48a9e7bdb",
    },
    {
      hash: "SHAKE256",
      digest: "e99a620062d47c0fa2154968f5105504c5be2c3f1092dc43fae1d44be7de7450",
    },
    {
      hash: "BLAKE2b",
      digest: "afc85db81547003f961f66356700589552346dff9d99ade4a41c5f792fa48f797c369d9dffda46236b73453aab11338e0e63a41783038dd756346fbfd464d066",
    },
  ]

/// `n` bytes no two blocks of which are alike.
fn varied(n: Int) -> Bytes / {abort.raise} =
  bytes_concat_all(map(range(0, n), |i: Int| byte_of_int(i * 7 + i / 64 & 0xFF)))

// Every padding there is: a message that ends a block, one a byte short, one the length just fits.
test "{v.hash} of every length to 340 bytes, as one digest of the digests" for v: Sweep in sweeps(
  ) {
  let h = named(v.hash);
  let input = varied(340);
  let all = fold(range(0, 341), init(h), |s: Hasher, n: Int|
    update(s, digest_of(h, bytes_slice(input, 0, n))));
  assert_eq(hex_of(finish(all)), v.digest)
}

test "a shorter SHAKE output is the start of a longer one, a block's edge or not" {
  let long = shake128(b"abc", 512);
  assert(
    all([0, 1, 167, 168, 169, 336, 337], |n: Int| shake128(b"abc", n) == bytes_slice(long, 0, n)),
  );
  let longer = shake256(b"abc", 512);
  assert(
    all([0, 1, 135, 136, 137, 272, 273], |n: Int| shake256(b"abc", n) == bytes_slice(longer, 0, n)),
  )
}

test "each one-shot digest is its hash's" {
  let input = b"the quick brown fox";
  assert_eq(sha256(input), digest_of(sha256_hash(), input));
  assert_eq(sha384(input), digest_of(sha384_hash(), input));
  assert_eq(sha512(input), digest_of(sha512_hash(), input));
  assert_eq(sha512_256(input), digest_of(sha512_256_hash(), input));
  assert_eq(sha3_224(input), digest_of(sha3_224_hash(), input));
  assert_eq(sha3_256(input), digest_of(sha3_256_hash(), input));
  assert_eq(sha3_384(input), digest_of(sha3_384_hash(), input));
  assert_eq(sha3_512(input), digest_of(sha3_512_hash(), input));
  assert_eq(blake2b(input), digest_of(blake2b_hash(), input))
}

test "a digest is as long as its hash says" {
  assert(all(every(), |h: Hash| bytes_len(digest_of(h, b"ply")) == h.digest_size));
  assert_eq(bytes_len(shake128(b"ply", 0)), 0);
  assert_eq(bytes_len(shake256(b"ply", 1000)), 1000)
}

test "BLAKE2b of abc, as RFC 7693 works it out" {
  assert_eq(
    hex_of(blake2b(b"abc")),
    "ba80a53f981c4d0d6a2797b69f12f6e94c212f14685ac4b74b12bb6fdbffa2d17d87c5392aab792dc252d5de4533cc9518d38aa8dbf1925ab92386edd4009923",
  )
}

/// What RFC 7693's self-test fills its inputs and keys with.
fn filler(n: Int, seed: Int) -> Bytes / {abort.raise} =
  bytes_concat_all(
    fold(
      range(0, n),
      { a: 0xDEAD_4BAD * seed & 0xFFFF_FFFF, b: 1, out: [] },
      |s: { a: Int, b: Int, out: List<Bytes> }, _: Int| {
        let t = s.a + s.b & 0xFFFF_FFFF;
        { a: s.b, b: t, out: push(s.out, byte_of_int(t >>> 24)) }
      },
    ).out,
  )

// Four digest sizes over six lengths, keyed and not, hashed into the one digest the RFC publishes.
test "BLAKE2b's self-test, RFC 7693 appendix E" {
  let all = fold([20, 32, 48, 64], init(blake2b_with(b"", 32)), |outer: Hasher, size: Int|
    fold([0, 3, 128, 129, 255, 1024], outer, |s: Hasher, n: Int| {
      let input = filler(n, n);
      let plain = digest_of(blake2b_with(b"", size), input);
      let keyed = digest_of(blake2b_with(filler(size, size), size), input);
      update(update(s, plain), keyed)
    }));
  assert_eq(hex_of(finish(all)), "c23a7800d98123bd10f506c61e29da5603d763b8bbad2e737f5e765a7bccd475")
}

/// One keyed digest.
type KeyedDigest = { key: Bytes, size: Int, input: Bytes, digest: String }

/// Keyed BLAKE2b at the edges of what it takes: a key of one byte and of sixty-four, a digest of
/// one byte, and no message, as another implementation computes them.
fn blake2b_keyed() -> List<KeyedDigest> / {abort.raise} =
  [
    {
      key: b"k",
      size: 64,
      input: b"abc",
      digest: "aa65cf292e7df1f7439b350072d55485083ccf55b149a400c8c0548233f46447d9f95242a31bf783081c997a6c26e086bc8c0f363dd0c03e8f8edfae0c4aa5ca",
    },
    {
      key: b"k",
      size: 32,
      input: b"",
      digest: "490b6c8300eb23464bd2f9ca37c036be5091da14ddbeafab424c4c0a1f9eaac5",
    },
    {
      key: bytes_of_hex(
        "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f",
      ),
      size: 1,
      input: b"abc",
      digest: "46",
    },
    {
      key: bytes_of_hex(
        "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f",
      ),
      size: 64,
      input: varied(129),
      digest: "83e828ebfb69c6cc9ff4799345eba19aa7e584e1d57ef1a4f3d1d522d8d697e7fde7811dd880e59c739adbb9a22c9bd641517883e76216711f39a5cc46237966",
    },
  ]

test "BLAKE2b of {bytes_len(v.input)} bytes to {v.size}, under a key of {bytes_len(v.key)}" for v: KeyedDigest in blake2b_keyed(
  ) { assert_eq(hex_of(digest_of(blake2b_with(v.key, v.size), v.input)), v.digest) }

law "SHA-256 of an input is one digest however it is split" = any_split(sha256_hash())

law "SHA-384 of an input is one digest however it is split" = any_split(sha384_hash())

law "SHA-512 of an input is one digest however it is split" = any_split(sha512_hash())

law "SHA-512/256 of an input is one digest however it is split" = any_split(sha512_256_hash())

law "SHA3-224 of an input is one digest however it is split" = any_split(sha3_224_hash())

law "SHA3-256 of an input is one digest however it is split" = any_split(sha3_256_hash())

law "SHA3-384 of an input is one digest however it is split" = any_split(sha3_384_hash())

law "SHA3-512 of an input is one digest however it is split" = any_split(sha3_512_hash())

law "SHAKE128 of an input is one output however it is split" = any_split(shake128_hash(200))

law "SHAKE256 of an input is one output however it is split" = any_split(shake256_hash(200))

law "BLAKE2b of an input is one digest however it is split" = any_split(blake2b_hash())

law "keyed BLAKE2b of an input is one digest however it is split" =
  any_split(blake2b_with(b"a key", 32))

// A random split seldom lands on a block's edge, which is where a buffer goes wrong.
test "a split at, before and after a block's edge gives the digest of the whole" {
  let hashes = push(push(every(), blake2b_with(b"a key", 32)), shake256_hash(300));
  assert(
    all(hashes, |h: Hash| {
      let size = h.block_size;
      let input = varied(3 * size + 5);
      let n = bytes_len(input);
      all([1, 2, size - 1, size, size + 1, 2 * size, 3 * size, n - 1, n], |cut: Int|
        any_split(h, [bytes_slice(input, 0, cut), bytes_slice(input, cut, n)])
          && any_split(h, [
            bytes_slice(input, 0, 1),
            bytes_slice(input, 1, cut),
            b"",
            bytes_slice(input, cut, n),
          ]))
    }),
  )
}

test "an input taken a byte at a time gives the digest of the whole" {
  assert(
    all(every(), |h: Hash| {
      let input = varied(2 * h.block_size + 1);
      any_split(h, map(range(0, bytes_len(input)), |i: Int| bytes_slice(input, i, i + 1)))
    }),
  )
}

test "a digest in progress is a value: finishing it does not end it" {
  let half = update(init(sha256_hash()), b"ab");
  assert_eq(finish(half), sha256(b"ab"));
  assert_eq(finish(update(half, b"c")), sha256(b"abc"));
  assert_eq(finish(update(half, b"d")), sha256(b"abd"))
}

/// One of RFC 4231's cases, with the tag it publishes for each hash.
type Mac = { case: Int, key: Bytes, data: Bytes, sha256: String, sha384: String, sha512: String }

/// RFC 4231's seven cases; the fifth publishes its tags cut to sixteen bytes.
fn rfc_4231() -> List<Mac> / {abort.raise} =
  [
    {
      case: 1,
      key: repeat(b"\x0b", 20),
      data: b"Hi There",
      sha256: "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7",
      sha384: "afd03944d84895626b0825f4ab46907f15f9dadbe4101ec682aa034c7cebc59cfaea9ea9076ede7f4af152e8b2fa9cb6",
      sha512: "87aa7cdea5ef619d4ff0b4241a1d6cb02379f4e2ce4ec2787ad0b30545e17cdedaa833b7d6b8a702038b274eaea3f4e4be9d914eeb61f1702e696c203a126854",
    },
    {
      case: 2,
      key: b"Jefe",
      data: b"what do ya want for nothing?",
      sha256: "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843",
      sha384: "af45d2e376484031617f78d2b58a6b1b9c7ef464f5a01b47e42ec3736322445e8e2240ca5e69e2c78b3239ecfab21649",
      sha512: "164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea2505549758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737",
    },
    {
      case: 3,
      key: repeat(b"\xaa", 20),
      data: repeat(b"\xdd", 50),
      sha256: "773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe",
      sha384: "88062608d3e6ad8a0aa2ace014c8a86f0aa635d947ac9febe83ef4e55966144b2a5ab39dc13814b94e3ab6e101a34f27",
      sha512: "fa73b0089d56a284efb0f0756c890be9b1b5dbdd8ee81a3655f83e33b2279d39bf3e848279a722c806b485a47e67c807b946a337bee8942674278859e13292fb",
    },
    {
      case: 4,
      key: bytes_of_hex("0102030405060708090a0b0c0d0e0f10111213141516171819"),
      data: repeat(b"\xcd", 50),
      sha256: "82558a389a443c0ea4cc819899f2083a85f0faa3e578f8077a2e3ff46729665b",
      sha384: "3e8a69b7783c25851933ab6290af6ca77a9981480850009cc5577c6e1f573b4e6801dd23c4a7d679ccf8a386c674cffb",
      sha512: "b0ba465637458c6990e5a8c5f61d4af7e576d97ff94b872de76f8050361ee3dba91ca5c11aa25eb4d679275cc5788063a5f19741120c4f2de2adebeb10a298dd",
    },
    {
      case: 5,
      key: repeat(b"\x0c", 20),
      data: b"Test With Truncation",
      sha256: "a3b6167473100ee06e0c796c2955552b",
      sha384: "3abf34c3503b2a23a46efc619baef897",
      sha512: "415fad6271580a531d4179bc891d87a6",
    },
    {
      case: 6,
      key: repeat(b"\xaa", 131),
      data: b"Test Using Larger Than Block-Size Key - Hash Key First",
      sha256: "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54",
      sha384: "4ece084485813e9088d2c63a041bc5b44f9ef1012a2b588f3cd11f05033ac4c60c2ef6ab4030fe8296248df163f44952",
      sha512: "80b24263c7c1a3ebb71493c1dd7be8b49b46d1f41b4aeec1121b013783f8f3526b56d037e05f2598bd0fd2215d6a1e5295e64f73f63f0aec8b915a985d786598",
    },
    {
      case: 7,
      key: repeat(b"\xaa", 131),
      data: b"This is a test using a larger than block-size key and a larger than block-size data. The key needs to be hashed before being used by the HMAC algorithm.",
      sha256: "9b09ffa71b942fcb27635fbcd5b0e944bfdc63644f0713938a7f51535c3a35e2",
      sha384: "6617178e941f020d351e2f254e8fd32c602420feb0b8fb9adccebb82461e99c5a678cc31e799176d3860e6110c46523e",
      sha512: "e37b6a775dc87dbaa4dfa9f96e5e3ffddebd71f8867289865df5a32d20cdc944b6022cac3c4982b10d5eeb55c3e4de15134676fb6de0446065c97440fa8c6a58",
    },
  ]

/// The tag's first bytes, as many as `published` has, in hex.
fn cut_to(tag: Bytes, published: String) -> String / {abort.raise} =
  hex_of(bytes_slice(tag, 0, string_len(published) / 2))

test "RFC 4231, case {v.case}" for v: Mac in rfc_4231() {
  assert_eq(cut_to(hmac(sha256_hash(), v.key, v.data), v.sha256), v.sha256);
  assert_eq(cut_to(hmac(sha384_hash(), v.key, v.data), v.sha384), v.sha384);
  assert_eq(cut_to(hmac(sha512_hash(), v.key, v.data), v.sha512), v.sha512);
  assert_eq(cut_to(hmac_sha256(v.key, v.data), v.sha256), v.sha256)
}

test "HMAC of the empty message, and under the empty key" {
  assert_eq(
    hex_of(hmac_sha256(b"", b"")),
    "b613679a0814d9ec772f95d778c35fc5ff1697c493715653c6c712144292c5ad",
  );
  assert_eq(
    hex_of(hmac_sha256(b"key", b"")),
    "5d5d139563c95b5967b9bd9a8c9b233a9dedb45072794cd232dc1b74832607d0",
  );
  // BLAKE2b ends its last block as no other: an empty message leaves the pad as that block.
  assert_eq(
    hex_of(hmac(blake2b_hash(), b"key", b"")),
    "019fe04bf010b8d72772e6b46897ecf74b4878c394ff2c4d5cfa0b7cc9bbefcb28c36de23cef03089db9c3d900468c89804f135e9fdef7ec9b3c7abe50ed33d3",
  );
  assert_eq(
    hex_of(hmac(blake2b_hash(), b"key", b"The quick brown fox jumps over the lazy dog")),
    "92294f92c0dfb9b00ec9ae8bd94d7e7d8a036b885a499f149dfe2fd2199394aaaf6b8894a1730cccb2cd050f9bcf5062a38b51b0dab33207f8ef35ae2c9df51b",
  );
  assert_eq(
    hex_of(hmac(sha3_256_hash(), b"key", b"The quick brown fox jumps over the lazy dog")),
    "8c6e0683409427f8931711b10ca92a506eb1fafa48fadd66d76126f47ac2c333",
  )
}

test "a key of a block's length is used as it is, and a longer one is its digest" {
  assert(
    all(every(), |h: Hash| {
      let whole = varied(h.block_size);
      let long = varied(h.block_size + 1);
      hmac(h, long, b"message") == hmac(h, digest_of(h, long), b"message")
        && hmac(h, whole, b"message") != hmac(h, digest_of(h, whole), b"message")
    }),
  )
}

test "two tags match when every byte does, and never across a length" {
  let tag = hmac_sha256(b"key", b"message");
  assert(tags_match(tag, hmac_sha256(b"key", b"message")));
  assert(!tags_match(tag, hmac_sha256(b"key", b"massage")));
  assert(!tags_match(tag, bytes_slice(tag, 0, 31)));
  assert(!tags_match(b"", tag));
  assert(tags_match(b"", b""));
  assert(hmac_verify(sha256_hash(), b"key", b"message", tag));
  assert(!hmac_verify(sha256_hash(), b"kex", b"message", tag));
  assert(!hmac_verify(sha512_hash(), b"key", b"message", tag))
}

test "comparing two tags takes the same steps wherever they differ" {
  let tag = hmac_sha256(b"key", b"message");
  let early = bytes_concat(b"\x00", bytes_slice(tag, 1, 32));
  let late = bytes_concat(bytes_slice(tag, 0, 31), b"\x00");
  let same = metered(|| tags_match(tag, tag));
  let first = metered(|| tags_match(tag, early));
  let last = metered(|| tags_match(tag, late));
  assert(same.value && !first.value && !last.value);
  assert_eq(first.steps, same.steps);
  assert_eq(last.steps, same.steps)
}

/// One of RFC 5869's cases: what goes in, the pseudorandom key the first step makes of it, and the
/// output.
type Derivation = {
  case: Int,
  key: Bytes,
  salt: Bytes,
  info: Bytes,
  length: Int,
  prk: String,
  okm: String,
}

/// RFC 5869's SHA-256 cases, A.1 to A.3.
fn rfc_5869() -> List<Derivation> / {abort.raise} =
  [
    {
      case: 1,
      key: repeat(b"\x0b", 22),
      salt: bytes_of_hex("000102030405060708090a0b0c"),
      info: bytes_of_hex("f0f1f2f3f4f5f6f7f8f9"),
      length: 42,
      prk: "077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5",
      okm: "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865",
    },
    {
      case: 2,
      key: bytes_of_hex(
        "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f",
      ),
      salt: bytes_of_hex(
        "606162636465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e7f808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9fa0a1a2a3a4a5a6a7a8a9aaabacadaeaf",
      ),
      info: bytes_of_hex(
        "b0b1b2b3b4b5b6b7b8b9babbbcbdbebfc0c1c2c3c4c5c6c7c8c9cacbcccdcecfd0d1d2d3d4d5d6d7d8d9dadbdcdddedfe0e1e2e3e4e5e6e7e8e9eaebecedeeeff0f1f2f3f4f5f6f7f8f9fafbfcfdfeff",
      ),
      length: 82,
      prk: "06a6b88c5853361a06104c9ceb35b45cef760014904671014a193f40c15fc244",
      okm: "b11e398dc80327a1c8e7f78c596a49344f012eda2d4efad8a050cc4c19afa97c59045a99cac7827271cb41c65e590e09da3275600c2f09b8367793a9aca3db71cc30c58179ec3e87c14c01d5c1f3434f1d87",
    },
    {
      case: 3,
      key: repeat(b"\x0b", 22),
      salt: b"",
      info: b"",
      length: 42,
      prk: "19ef24a32c717b167f33a91d6f648bdf96596776afdb6377ac434c1c293ccb04",
      okm: "8da4e775a563c18f715f802a063c5a31b8a11f5c5ee1879ec3454e5f3c738d2d9d201395faa4b61a96c8",
    },
  ]

test "RFC 5869, case {v.case}" for v: Derivation in rfc_5869() {
  let h = sha256_hash();
  let prk = hkdf_extract(h, v.salt, v.key);
  assert_eq(hex_of(prk), v.prk);
  assert_eq(hex_of(hkdf_expand(h, prk, v.info, v.length)), v.okm);
  assert_eq(hex_of(hkdf(h, v.salt, v.key, v.info, v.length)), v.okm)
}

test "a shorter HKDF output is the start of a longer one, and its first digest is one HMAC" {
  let h = sha256_hash();
  let prk = hkdf_extract(h, b"salt", b"key");
  let long = hkdf_expand(h, prk, b"info", 65);
  assert(
    all([1, 31, 32, 33, 64], |n: Int| hkdf_expand(h, prk, b"info", n) == bytes_slice(long, 0, n)),
  );
  assert_eq(hkdf_expand(h, prk, b"info", 32), hmac(h, prk, b"info\x01"))
}

/// One published PBKDF2 key.
type Stretch = { password: Bytes, salt: Bytes, iterations: Int, length: Int, key: String }

/// RFC 7914's first PBKDF2-HMAC-SHA-256 vector, which is two digests of output, then RFC 6070's
/// inputs under SHA-256, as libraries have long published them.
fn pbkdf2_sha256_vectors() -> List<Stretch> =
  [
    {
      password: b"passwd",
      salt: b"salt",
      iterations: 1,
      length: 64,
      key: "55ac046e56e3089fec1691c22544b605f94185216dde0465e68b9d57c20dacbc49ca9cccf179b645991664b39d77ef317c71b845b1e30bd509112041d3a19783",
    },
    {
      password: b"password",
      salt: b"salt",
      iterations: 1,
      length: 32,
      key: "120fb6cffcf8b32c43e7225256c4f837a86548c92ccc35480805987cb70be17b",
    },
    {
      password: b"password",
      salt: b"salt",
      iterations: 2,
      length: 32,
      key: "ae4d0c95af6b46d32d0adff928f06dd02a303f8ef3c251dfd6e2d85a95474c43",
    },
    {
      password: b"password",
      salt: b"salt",
      iterations: 4096,
      length: 32,
      key: "c5e478d59288c841aa530db6845c4c8d962893a001ce4e11a4963873aa98134a",
    },
    {
      password: b"passwordPASSWORDpassword",
      salt: b"saltSALTsaltSALTsaltSALTsaltSALTsalt",
      iterations: 4096,
      length: 40,
      key: "348c89dbcbd32b2f32d814b8116e84cf2b17347ebc1800181c4e2a1fb8dd53e1c635518c7dac47e9",
    },
    {
      password: b"pass\x00word",
      salt: b"sa\x00lt",
      iterations: 4096,
      length: 16,
      key: "89b69d0516f829893c696226650a8687",
    },
  ]

test "PBKDF2-HMAC-SHA-256 of {v.password} and {v.salt}, {v.iterations} rounds to {v.length} bytes" for v: Stretch in pbkdf2_sha256_vectors(
  ) { assert_eq(hex_of(pbkdf2(sha256_hash(), v.password, v.salt, v.iterations, v.length)), v.key) }

test "pbkdf2_sha256 is PBKDF2 over SHA-256 to one digest, and raises for no iterations" {
  assert_eq(
    pbkdf2_sha256(b"password", b"salt", 2),
    pbkdf2(sha256_hash(), b"password", b"salt", 2, 32),
  );
  assert_eq(
    try[abort.raise] { pbkdf2_sha256(b"password", b"salt", 0) },
    Err("PBKDF2 takes an iteration count of one or more"),
  )
}

test "a shorter PBKDF2 key is the start of a longer one" {
  let long = pbkdf2(sha256_hash(), b"password", b"salt", 3, 65);
  assert(
    all([1, 32, 33, 64], |n: Int|
      pbkdf2(sha256_hash(), b"password", b"salt", 3, n) == bytes_slice(long, 0, n)),
  )
}

// A block too many gives the same key at twice the work, which only the steps show.
test "PBKDF2 runs its rounds once for each digest of output" {
  let steps = |rounds: Int, length: Int|
    metered(|| pbkdf2(sha256_hash(), b"password", b"salt", rounds, length)).steps;
  assert_eq(steps(21, 64) - steps(1, 64), 2 * (steps(21, 32) - steps(1, 32)))
}

test "zero bytes come in any number" {
  assert(all([0, 1, 255, 256, 257, 600], |n: Int| zeros(n) == repeat(b"\x00", n)));
  assert_eq(zeros(0 - 1), b"")
}

fn refusal<a>(r: Result<a, Refusal>) -> Option<Refusal> =
  match r { Ok(_) -> None, Err(e) -> Some(e) }

test "a length, a key or a count outside what a function defines is refused, with what was asked" {
  let h = sha256_hash();
  let prk = repeat(b"\x0b", 32);
  assert_eq(bytes_len(hkdf_expand(h, prk, b"", 255 * 32)), 255 * 32);
  assert_eq(hkdf_expand(h, prk, b"", 0), b"");
  assert_eq(try { hkdf_expand(h, prk, b"", 255 * 32 + 1) }, Err(OutputLength(255 * 32 + 1)));
  assert_eq(try { hkdf_expand(h, prk, b"", 0 - 1) }, Err(OutputLength(0 - 1)));
  assert_eq(try { hkdf_expand(h, b"too short", b"", 32) }, Err(KeyLength(9)));
  assert_eq(try { hkdf(h, b"", b"key", b"", 255 * 32 + 1) }, Err(OutputLength(255 * 32 + 1)));
  assert_eq(try { pbkdf2(h, b"password", b"salt", 0, 32) }, Err(Iterations(0)));
  assert_eq(try { pbkdf2(h, b"password", b"salt", 1, 0) }, Err(OutputLength(0)));
  assert_eq(try { shake128(b"", 0 - 1) }, Err(OutputLength(0 - 1)));
  assert_eq(try { shake256(b"", 0 - 1) }, Err(OutputLength(0 - 1)));
  assert_eq(refusal(try { blake2b_with(b"", 0) }), Some(OutputLength(0)));
  assert_eq(refusal(try { blake2b_with(b"", 65) }), Some(OutputLength(65)));
  assert_eq(refusal(try { blake2b_with(repeat(b"k", 65), 64) }), Some(KeyLength(65)));
  assert_eq(refusal(try { blake2b_with(repeat(b"k", 64), 1) }), None)
}
