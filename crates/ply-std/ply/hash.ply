  let v7 = rotr(v7 ^ v8, 12);
  let v2 = wrap_add(wrap_add(v2, v7), m.m6);
  let v13 = rotr(v13 ^ v2, 8);
  let v8 = wrap_add(v8, v13);
  let v7 = rotr(v7 ^ v8, 7);
  let v3 = wrap_add(wrap_add(v3, v4), m.m4);
  let v14 = rotr(v14 ^ v3, 16);
  let v9 = wrap_add(v9, v14);
  let v4 = rotr(v4 ^ v9, 12);
  let v3 = wrap_add(wrap_add(v3, v4), m.m7);
  let v14 = rotr(v14 ^ v3, 8);
  let v9 = wrap_add(v9, v14);
  let v4 = rotr(v4 ^ v9, 7);
  let v0 = wrap_add(wrap_add(v0, v4), m.m11);
  let v12 = rotr(v12 ^ v0, 16);
  let v8 = wrap_add(v8, v12);
  let v4 = rotr(v4 ^ v8, 12);
  let v0 = wrap_add(wrap_add(v0, v4), m.m15);
  let v12 = rotr(v12 ^ v0, 8);
  let v8 = wrap_add(v8, v12);
  let v4 = rotr(v4 ^ v8, 7);
  let v1 = wrap_add(wrap_add(v1, v5), m.m5);
  let v13 = rotr(v13 ^ v1, 16);
  let v9 = wrap_add(v9, v13);
  let v5 = rotr(v5 ^ v9, 12);
  let v1 = wrap_add(wrap_add(v1, v5), m.m0);
  let v13 = rotr(v13 ^ v1, 8);
  let v9 = wrap_add(v9, v13);
  let v5 = rotr(v5 ^ v9, 7);
  let v2 = wrap_add(wrap_add(v2, v6), m.m1);
  let v14 = rotr(v14 ^ v2, 16);
  let v10 = wrap_add(v10, v14);
  let v6 = rotr(v6 ^ v10, 12);
  let v2 = wrap_add(wrap_add(v2, v6), m.m9);
  let v14 = rotr(v14 ^ v2, 8);
  let v10 = wrap_add(v10, v14);
  let v6 = rotr(v6 ^ v10, 7);
  let v3 = wrap_add(wrap_add(v3, v7), m.m8);
  let v15 = rotr(v15 ^ v3, 16);
  let v11 = wrap_add(v11, v15);
  let v7 = rotr(v7 ^ v11, 12);
  let v3 = wrap_add(wrap_add(v3, v7), m.m6);
  let v15 = rotr(v15 ^ v3, 8);
  let v11 = wrap_add(v11, v15);
  let v7 = rotr(v7 ^ v11, 7);
  let v0 = wrap_add(wrap_add(v0, v5), m.m14);
  let v15 = rotr(v15 ^ v0, 16);
  let v10 = wrap_add(v10, v15);
  let v5 = rotr(v5 ^ v10, 12);
  let v0 = wrap_add(wrap_add(v0, v5), m.m10);
  let v15 = rotr(v15 ^ v0, 8);
  let v10 = wrap_add(v10, v15);
  let v5 = rotr(v5 ^ v10, 7);
  let v1 = wrap_add(wrap_add(v1, v6), m.m2);
  let v12 = rotr(v12 ^ v1, 16);
  let v11 = wrap_add(v11, v12);
  let v6 = rotr(v6 ^ v11, 12);
  let v1 = wrap_add(wrap_add(v1, v6), m.m12);
  let v12 = rotr(v12 ^ v1, 8);
  let v11 = wrap_add(v11, v12);
  let v6 = rotr(v6 ^ v11, 7);
  let v2 = wrap_add(wrap_add(v2, v7), m.m3);
  let v13 = rotr(v13 ^ v2, 16);
  let v8 = wrap_add(v8, v13);
  let v7 = rotr(v7 ^ v8, 12);
  let v2 = wrap_add(wrap_add(v2, v7), m.m4);
  let v13 = rotr(v13 ^ v2, 8);
  let v8 = wrap_add(v8, v13);
  let v7 = rotr(v7 ^ v8, 7);
  let v3 = wrap_add(wrap_add(v3, v4), m.m7);
  let v14 = rotr(v14 ^ v3, 16);
  let v9 = wrap_add(v9, v14);
  let v4 = rotr(v4 ^ v9, 12);
  let v3 = wrap_add(wrap_add(v3, v4), m.m13);
  let v14 = rotr(v14 ^ v3, 8);
  let v9 = wrap_add(v9, v14);
  let v4 = rotr(v4 ^ v9, 7);
  {
    m0: v0 ^ v8,
    m1: v1 ^ v9,
    m2: v2 ^ v10,
    m3: v3 ^ v11,
    m4: v4 ^ v12,
    m5: v5 ^ v13,
    m6: v6 ^ v14,
    m7: v7 ^ v15,
    m8: v8 ^ cv.w0,
    m9: v9 ^ cv.w1,
    m10: v10 ^ cv.w2,
    m11: v11 ^ cv.w3,
    m12: v12 ^ cv.w4,
    m13: v13 ^ cv.w5,
    m14: v14 ^ cv.w6,
    m15: v15 ^ cv.w7,
  }
}

fn first8(s: Words16) -> Cv =
  { w0: s.m0, w1: s.m1, w2: s.m2, w3: s.m3, w4: s.m4, w5: s.m5, w6: s.m6, w7: s.m7 }

// Zero past the end, which is what pads a final short block.
fn byte_or_zero(input: Bytes, at: Int, limit: Int) -> Int =
  if at >= limit { 0 } else { bytes_at(input, at) }

// Little-endian; only the last block of a short input reads byte by byte, to pad with zeros.
fn word_at(input: Bytes, at: Int, limit: Int) -> U32 =
  u32_of_int(
    byte_or_zero(input, at, limit) | byte_or_zero(input, at + 1, limit) << 8
      | byte_or_zero(input, at + 2, limit) << 16
      | byte_or_zero(input, at + 3, limit) << 24,
  )

// Whether a block needs padding is a property of the block, not of each of its sixteen words.
fn block_words(input: Bytes, at: Int, limit: Int) -> Words16 =
  if at + 64 <= limit { full_words(input, at) } else { padded_words(input, at, limit) }

fn full_words(input: Bytes, at: Int) -> Words16 =
  {
    m0: bytes_u32_le(input, at),
    m1: bytes_u32_le(input, at + 4),
    m2: bytes_u32_le(input, at + 8),
    m3: bytes_u32_le(input, at + 12),
    m4: bytes_u32_le(input, at + 16),
    m5: bytes_u32_le(input, at + 20),
    m6: bytes_u32_le(input, at + 24),
    m7: bytes_u32_le(input, at + 28),
    m8: bytes_u32_le(input, at + 32),
    m9: bytes_u32_le(input, at + 36),
    m10: bytes_u32_le(input, at + 40),
    m11: bytes_u32_le(input, at + 44),
    m12: bytes_u32_le(input, at + 48),
    m13: bytes_u32_le(input, at + 52),
    m14: bytes_u32_le(input, at + 56),
    m15: bytes_u32_le(input, at + 60),
  }

fn padded_words(input: Bytes, at: Int, limit: Int) -> Words16 =
  {
    m0: word_at(input, at, limit),
    m1: word_at(input, at + 4, limit),
    m2: word_at(input, at + 8, limit),
    m3: word_at(input, at + 12, limit),
    m4: word_at(input, at + 16, limit),
    m5: word_at(input, at + 20, limit),
    m6: word_at(input, at + 24, limit),
    m7: word_at(input, at + 28, limit),
    m8: word_at(input, at + 32, limit),
    m9: word_at(input, at + 36, limit),
    m10: word_at(input, at + 40, limit),
    m11: word_at(input, at + 44, limit),
    m12: word_at(input, at + 48, limit),
    m13: word_at(input, at + 52, limit),
    m14: word_at(input, at + 56, limit),
    m15: word_at(input, at + 60, limit),
  }

// An empty input is one chunk of one empty block, which is why neither count is `0` at zero length.
fn block_count(n: Int) -> Int = if n <= 0 { 1 } else { (n + 63) / 64 }

fn chunk_count(n: Int) -> Int = if n <= 0 { 1 } else { (n + 1023) / 1024 }

fn min(a: Int, b: Int) -> Int = if a < b { a } else { b }

type ChunkStep = { cv: Cv, i: Int, out: Words16 }

fn chunk_compress(input: Bytes, chunk: Int, is_root: Bool) -> Words16 = {
  let start = chunk * chunk_len();
  let stop = min(start + chunk_len(), bytes_len(input));
  let blocks = block_count(stop - start);
  iterate({ cv: iv(), i: 0, out: empty16() }, blocks + 1, |s: ChunkStep|
    if s.i >= blocks { Stop(s.out) } else {
      let at = start + s.i * block_len();
      let limit = min(at + block_len(), stop);
      let last = s.i == blocks - 1;
      let flags = (if s.i == 0 { chunk_start() } else { 0u32 })
        | (if last { chunk_end() } else { 0u32 })
        | (if last && is_root { root() } else { 0u32 });
      let out = compress(s.cv, block_words(input, at, limit), chunk, u32_of_int(limit - at), flags);
      Continue({ cv: first8(out), i: s.i + 1, out: out })
    })
}

fn empty16() -> Words16 =
  {
    m0: 0u32,
    m1: 0u32,
    m2: 0u32,
    m3: 0u32,
    m4: 0u32,
    m5: 0u32,
    m6: 0u32,
    m7: 0u32,
    m8: 0u32,
    m9: 0u32,
    m10: 0u32,
    m11: 0u32,
    m12: 0u32,
    m13: 0u32,
    m14: 0u32,
    m15: 0u32,
  }

fn parent_compress(left: Cv, right: Cv, is_root: Bool) -> Words16 =
  compress(
    iv(),
    {
      m0: left.w0,
      m1: left.w1,
      m2: left.w2,
      m3: left.w3,
      m4: left.w4,
      m5: left.w5,
      m6: left.w6,
      m7: left.w7,
      m8: right.w0,
      m9: right.w1,
      m10: right.w2,
      m11: right.w3,
      m12: right.w4,
      m13: right.w5,
      m14: right.w6,
      m15: right.w7,
    },
    0,
    u32_of_int(block_len()),
    parent() | (if is_root { root() } else { 0u32 }),
  )

// The largest power of two strictly below `n`, which is where the tree splits.
fn left_chunks(n: Int) -> Int =
  iterate(1, 64, |p: Int| if p * 2 >= n { Stop(p) } else { Continue(p * 2) })

fn subtree(input: Bytes, lo: Int, hi: Int, is_root: Bool) -> Words16 =
  if hi - lo <= 1 { chunk_compress(input, lo, is_root) } else {
    let mid = lo + left_chunks(hi - lo);
    let left = first8(subtree(input, lo, mid, false));
    let right = first8(subtree(input, mid, hi, false));
    parent_compress(left, right, is_root)
  }

fn le_bytes(w: U32) -> Bytes = u32_le(int_of_u32(w))

// The 32-byte hash of `input`.
pub fn blake3(input: Bytes) -> Bytes = {
  let out = subtree(input, 0, chunk_count(bytes_len(input)), true);
  bytes_concat_all([
    le_bytes(out.m0),
    le_bytes(out.m1),
    le_bytes(out.m2),
    le_bytes(out.m3),
    le_bytes(out.m4),
    le_bytes(out.m5),
    le_bytes(out.m6),
    le_bytes(out.m7),
  ])
}

// --- SHA-256 ---------------------------------------------------------------------

// Every word is an `Int` with its low thirty-two bits significant, so a sum is masked down and
// `rotr32` is the whole of the bit arithmetic.

fn sha_mask(x: Int) -> Int = x & 0xFFFF_FFFF

// The first thirty-two bits of the fractional parts of the cube roots of the first sixty-four
// primes, as the standard publishes them.
fn sha_constants() -> List<Int> =
  [
    0x428A_2F98,
    0x7137_4491,
    0xB5C0_FBCF,
    0xE9B5_DBA5,
    0x3956_C25B,
    0x59F1_11F1,
    0x923F_82A4,
    0xAB1C_5ED5,
    0xD807_AA98,
    0x1283_5B01,
    0x2431_85BE,
    0x550C_7DC3,
    0x72BE_5D74,
    0x80DE_B1FE,
    0x9BDC_06A7,
    0xC19B_F174,
    0xE49B_69C1,
    0xEFBE_4786,
    0x0FC1_9DC6,
    0x240C_A1CC,
    0x2DE9_2C6F,
    0x4A74_84AA,
    0x5CB0_A9DC,
    0x76F9_88DA,
    0x983E_5152,
    0xA831_C66D,
    0xB003_27C8,
    0xBF59_7FC7,
    0xC6E0_0BF3,
    0xD5A7_9147,
    0x06CA_6351,
    0x1429_2967,
    0x27B7_0A85,
    0x2E1B_2138,
    0x4D2C_6DFC,
    0x5338_0D13,
    0x650A_7354,
    0x766A_0ABB,
    0x81C2_C92E,
    0x9272_2C85,
    0xA2BF_E8A1,
    0xA81A_664B,
    0xC24B_8B70,
    0xC76C_51A3,
    0xD192_E819,
    0xD699_0624,
    0xF40E_3585,
    0x106A_A070,
    0x19A4_C116,
    0x1E37_6C08,
    0x2748_774C,
    0x34B0_BCB5,
    0x391C_0CB3,
    0x4ED8_AA4A,
    0x5B9C_CA4F,
    0x682E_6FF3,
    0x748F_82EE,
    0x78A5_636F,
    0x84C8_7814,
    0x8CC7_0208,
    0x90BE_FFFA,
    0xA450_6CEB,
    0xBEF9_A3F7,
    0xC671_78F2,
  ]

// The same of the square roots of the first eight.
fn sha_initial() -> List<Int> =
  [
    0x6A09_E667,
    0xBB67_AE85,
    0x3C6E_F372,
    0xA54F_F53A,
    0x510E_527F,
    0x9B05_688C,
    0x1F83_D9AB,
    0x5BE0_CD19,
  ]

// `g ^ (e & (f ^ g))`, which is the choice without a complement.
fn sha_choose(e: Int, f: Int, g: Int) -> Int = g ^ e & (f ^ g)

fn sha_majority(a: Int, b: Int, c: Int) -> Int = a & b ^ a & c ^ b & c

fn sha_big0(a: Int) -> Int = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22)

fn sha_big1(e: Int) -> Int = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25)

fn sha_small0(x: Int) -> Int = rotr32(x, 7) ^ rotr32(x, 18) ^ x >>> 3

fn sha_small1(x: Int) -> Int = rotr32(x, 17) ^ rotr32(x, 19) ^ x >>> 10

fn sha_word(xs: List<Int>, i: Int) -> Int = match list_at(xs, i) { Some(w) -> w, None -> 0 }

// Sixty-four words: the sixteen a block holds, then the four mixtures of the ones before.
fn sha_schedule(block: List<Int>, at: Int, acc: List<Int>) -> List<Int> =
  if at >= 64 { acc }
  else if at < 16 { sha_schedule(block, at + 1, push(acc, sha_word(block, at))) } else {
    sha_schedule(
      block,
      at + 1,
      push(
        acc,
        sha_mask(
          sha_small1(sha_word(acc, at - 2)) + sha_word(acc, at - 7)
            + sha_small0(sha_word(acc, at - 15))
            + sha_word(acc, at - 16),
        ),
      ),
    )
  }

fn sha_round(state: List<Int>, k: Int, w: Int) -> List<Int> = {
  let a = sha_word(state, 0);
  let b = sha_word(state, 1);
  let c = sha_word(state, 2);
  let d = sha_word(state, 3);
  let e = sha_word(state, 4);
  let f = sha_word(state, 5);
  let g = sha_word(state, 6);
  let h = sha_word(state, 7);
  let t1 = sha_mask(h + sha_big1(e) + sha_choose(e, f, g) + k + w);
  let t2 = sha_mask(sha_big0(a) + sha_majority(a, b, c));
  [sha_mask(t1 + t2), a, b, c, sha_mask(d + t1), e, f, g]
}

fn sha_compress(state: List<Int>, block: List<Int>) -> List<Int> = {
  let schedule = sha_schedule(block, 0, []);
  let constants = sha_constants();
  let end = fold(range(0, 64), state, |s: List<Int>, i: Int|
    sha_round(s, sha_word(constants, i), sha_word(schedule, i)));
  map(range(0, 8), |i: Int| sha_mask(sha_word(state, i) + sha_word(end, i)))
}

fn sha_zeroes(n: Int) -> Bytes =
  if n <= 0 { b"" } else {
    let half = sha_zeroes(n / 2);
    if n % 2 == 0 { bytes_concat(half, half) }
    else { bytes_concat(bytes_concat(half, half), b"\x00") }
  }

fn sha_be_at(b: Bytes, at: Int) -> Int = match u32_be_at(b, at) { Some(w) -> w, None -> 0 }

fn sha_block(input: Bytes, at: Int) -> List<Int> =
  map(range(0, 16), |i: Int| sha_be_at(input, at + i * 4))

// The message, a one bit, as many zeros as leave the length eight short of a block, then the
// length in bits as a big-endian word.
fn sha_padded(input: Bytes) -> Bytes = {
  let n = bytes_len(input);
  let total = (n + 9 + 63) / 64 * 64;
  bytes_concat_all([input, b"\x80", sha_zeroes(total - n - 9), u64_be(n * 8)])
}

// Thirty-two bytes, of SHA-256 as the standard defines it.
pub fn sha256(input: Bytes) -> Bytes = {
  let full = sha_padded(input);
  let state = fold(range(0, bytes_len(full) / 64), sha_initial(), |acc: List<Int>, i: Int|
    sha_compress(acc, sha_block(full, i * 64)));
  bytes_concat_all(map(state, |w: Int| u32_be(w)))
}

// Every byte of `b` xored with one byte, which is what an HMAC key pad is: `std.bytes`'s.

// HMAC-SHA-256, as RFC 2104 defines it and RFC 4231 publishes vectors for.
pub fn hmac_sha256(key: Bytes, message: Bytes) -> Bytes = {
  let short = if bytes_len(key) > 64 { sha256(key) } else { key };
  let pad = bytes_concat(short, sha_zeroes(64 - bytes_len(short)));
  sha256(bytes_concat(xor_byte(pad, 0x5C), sha256(bytes_concat(xor_byte(pad, 0x36), message))))
}

type ShaChain = { block: Bytes, total: Bytes }

// PBKDF2-HMAC-SHA-256 with one output block, which is thirty-two bytes: SCRAM's salted
// password, and nothing else here needs a longer key.
pub fn pbkdf2_sha256(password: Bytes, salt: Bytes, iterations: Int) -> Bytes = {
  let first = hmac_sha256(password, bytes_concat(salt, u32_be(1)));
  fold(range(1, iterations), { block: first, total: first }, |acc: ShaChain, _i: Int| {
    let next = hmac_sha256(password, acc.block);
    { block: next, total: xor(acc.total, next) }
  }).total
}

// The published test vectors.

test "the empty input" {
  assert_eq(
    blake3(b""),
    b"\xaf\x13\x49\xb9\xf5\xf9\xa1\xa6\xa0\x40\x4d\xea\x36\xdc\xc9\x49\x9b\xcb\x25\xc9\xad\xc1\x12\xb7\xcc\x9a\x93\xca\xe4\x1f\x32\x62",
  )
}

test "one byte" {
  assert_eq(
    blake3(b"\x00"),
    b"\x2d\x3a\xde\xdf\xf1\x1b\x61\xf1\x4c\x88\x6e\x35\xaf\xa0\x36\x73\x6d\xcd\x87\xa7\x4d\x27\xb5\xc1\x51\x02\x25\xd0\xf5\x92\xe2\x13",
  )
}

test "a hash is thirty-two bytes whatever the input" {
  assert_eq(bytes_len(blake3(b"")), 32);
  assert_eq(bytes_len(blake3(b"ply")), 32)
}

test "the block boundary is where a transcription goes wrong" {
  // 63, 64 and 65 bytes:
  assert_eq(bytes_len(blake3(repeat(b"a", 63))), 32);
  assert_eq(bytes_len(blake3(repeat(b"a", 64))), 32);
  assert(blake3(repeat(b"a", 64)) != blake3(repeat(b"a", 65)))
}

test "a second chunk is a tree, and a tree is not a longer chunk" {
  // 1024 is one chunk and 1025 is two chunks joined by a parent node.
  assert(blake3(repeat(b"a", 1024)) != blake3(repeat(b"a", 1025)));
  assert_eq(bytes_len(blake3(repeat(b"a", 2048))), 32)
}

fn repeat(unit: Bytes, n: Int) -> Bytes = bytes_concat_all(map(range(0, n), |_: Int| unit))

// The published SHA-256, HMAC-SHA-256 and PBKDF2-SHA-256 vectors, read as hex so a
// transcription shows up as a diff in one line rather than in thirty-two byte escapes.

fn sha_hex(b: Bytes) -> String =
  fold(range(0, bytes_len(b)), "", |acc: String, i: Int| acc ++ sha_byte_hex(bytes_at(b, i)))

fn sha_byte_hex(v: Int) -> String =
  string_slice("0123456789abcdef", v >>> 4, (v >>> 4) + 1)
    ++ string_slice("0123456789abcdef", v & 0xF, (v & 0xF) + 1)

test "sha-256 of the empty input" {
  assert_eq(
    sha_hex(sha256(b"")),
    "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
  )
}

test "sha-256 of abc" {
  assert_eq(
    sha_hex(sha256(b"abc")),
    "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
  )
}

// Fifty-six bytes is the input whose padding needs a block of its own.
test "sha-256 where the padding spills into a second block" {
  assert_eq(
    sha_hex(sha256(b"abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")),
    "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1",
  )
}

test "hmac-sha-256, against RFC 4231" {
  assert_eq(
    sha_hex(hmac_sha256(repeat(b"\x0b", 20), b"Hi There")),
    "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7",
  );
  assert_eq(
    sha_hex(hmac_sha256(b"Jefe", b"what do ya want for nothing?")),
    "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843",
  );
  assert_eq(
    sha_hex(hmac_sha256(repeat(b"\xaa", 20), repeat(b"\xdd", 50))),
    "773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe",
  )
}

test "pbkdf2-hmac-sha-256, one block" {
  assert_eq(
    sha_hex(pbkdf2_sha256(b"password", b"salt", 1)),
    "120fb6cffcf8b32c43e7225256c4f837a86548c92ccc35480805987cb70be17b",
  );
  assert_eq(
    sha_hex(pbkdf2_sha256(b"password", b"salt", 2)),
    "ae4d0c95af6b46d32d0adff928f06dd02a303f8ef3c251dfd6e2d85a95474c43",
  );
  assert_eq(
    sha_hex(pbkdf2_sha256(b"password", b"salt", 4096)),
    "c5e478d59288c841aa530db6845c4c8d962893a001ce4e11a4963873aa98134a",
  )
}
