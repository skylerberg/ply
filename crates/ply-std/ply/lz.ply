//! What the writers of `std.zstd` and `std.brotli` share: finding what repeats, and making a
//! prefix code of how often each symbol occurs.
//!
//! `found` reads a block for matches and answers it as sequences, each a run of literals and the
//! match after it. `code_lengths` is a Huffman code held to a longest length, and `spans` the
//! table both formats spell a length or a count by: a code and a few extra bits.

import std.bytes (agreeing)
import std.list (sort)

/// Each code's first value over the count of its extra bits, `first << 5 | extra`: a code starts
/// where the one before it ends, and `first` is where the first does.
pub fn spans(extra: List<Int>, first: Int) -> Array<Int> =
  array_of_list(
    fold(extra, { out: [], base: first }, |s: { out: List<Int>, base: Int }, e: Int|
      { out: push(s.out, s.base << 5 | e), base: s.base + (1 << e) }).out,
  )

fn tallied(b: Bytes, i: Int, counts: Array<Int>) -> Array<Int> / {abort.raise} =
  if i >= bytes_len(b) { counts } else {
    let v = bytes_at(b, i);
    tallied(b, i + 1, array_set(counts, v, array_get(counts, v) + 1))
  }

/// How many times each byte value stands in `b`, by value.
pub fn tally(b: Bytes) -> Array<Int> / {abort.raise} = tallied(b, 0, array_new(256, 0))

/// The two lightest nodes not yet joined are joined under a new one, until one is left. Leaves
/// stand first, lightest first, and the joined nodes after them in the order they were made,
/// which is by weight too, so the lightest is the next leaf or the next joined node.
fn joined(
  weight: Array<Int>,
  parent: Array<Int>,
  i: Int,
  j: Int,
  m: Int,
  n: Int,
) -> Array<Int> / {abort.raise} =
  if m >= array_len(parent) { parent } else {
    let a = if i < n && (j >= m || array_get(weight, i) <= array_get(weight, j)) { i } else { j };
    let i1 = if a < n { i + 1 } else { i };
    let j1 = if a < n { j } else { j + 1 };
    let b = if i1 < n && (j1 >= m || array_get(weight, i1) <= array_get(weight, j1)) { i1 }
    else { j1 };
    let sum = array_get(weight, a) + array_get(weight, b);
    joined(
      array_set(weight, m, sum),
      array_set(array_set(parent, a, m), b, m),
      if b < n { i1 + 1 } else { i1 },
      if b < n { j1 } else { j1 + 1 },
      m + 1,
      n,
    )
  }

/// Each node's depth below the last one made, which is the root.
fn deepened(parent: Array<Int>, k: Int, depth: Array<Int>) -> Array<Int> / {abort.raise} =
  if k < 0 { depth }
  else { deepened(parent, k - 1, array_set(depth, k, array_get(depth, array_get(parent, k)) + 1)) }

/// The lengths over `keyed`, each `count << 10 | symbol` and sorted, into an array of `symbols`.
fn measured(keyed: List<Int>, most: Int, symbols: Int, fuel: Int) -> Array<Int> / {abort.raise} = {
  let n = len(keyed);
  let weight = array_of_list(
    fold(range(0, n - 1), map(keyed, |k: Int| k >>> 10), |all: List<Int>, _: Int| push(all, 0)),
  );
  let parent = joined(weight, array_new(2 * n - 1, 2 * n - 2), 0, n, n, n);
  let depth = deepened(parent, 2 * n - 3, array_new(2 * n - 1, 0));
  if array_get(depth, 0) > most && fuel > 0 {
    measured(map(keyed, |k: Int| (k >>> 11) + 1 << 10 | k & 1023), most, symbols, fuel - 1)
  } else {
    fold(range(0, n), array_new(symbols, 0), |lengths: Array<Int>, i: Int|
      array_set(
        lengths,
        (match list_at(keyed, i) { Some(k) -> k, None -> 0 }) & 1023,
        array_get(depth, i),
      ))
  }
}

/// The length of each symbol's code, by symbol and 0 for one that does not occur, in a Huffman
/// code of at most `most` bits, which is eight at least: `counts` holds how often each symbol of
/// an alphabet of 1024 at most occurs, and two of them at least do. A code that would run longer
/// than `most` is made again over half the counts, so it is whole and close to the shortest.
pub fn code_lengths(counts: Array<Int>, most: Int) -> Array<Int> / {abort.raise} =
  measured(
    sort(
      filter(map(range(0, array_len(counts)), |s: Int| array_get(counts, s) << 10 | s), |k: Int|
        k > 1023),
    ),
    most,
    array_len(counts),
    40,
  )

/// Each byte value as the one byte it is.
const fn singles() -> Array<Bytes> = array_of_list(map(range(0, 256), byte_of_int))

/// `out` and the whole bytes of the `n` bits in `acc`, the lowest eight first: how a writer of
/// bits lets go of them. What is left to write is `acc >>> (n & 0x78)`, of `n & 7` bits.
pub fn drained(out: Bytes, acc: Int, n: Int) -> Bytes / {abort.raise} =
  if n < 8 { out }
  else if n < 16 { out ++ array_get(singles(), acc & 255) } else {
    drained(
      out ++ array_get(singles(), acc & 255) ++ array_get(singles(), acc >>> 8 & 255),
      acc >>> 16,
      n - 16,
    )
  }

/// The code of each value below `n`: the last of `spans` that starts at or below it, `first`
/// being the least value they code.
pub fn codes_below(spans: Array<Int>, first: Int, n: Int) -> Bytes / {abort.raise} =
  bytes_concat_all(
    map(range(0, n), |v: Int|
      byte_of_int(
        fold(range(0, array_len(spans)), 0, |code: Int, c: Int|
          if array_get(spans, c) >>> 5 <= v + first { c } else { code }),
      )),
  )

/// What looking through a block leaves: where the bytes of four last stood, the block's
/// sequences as `literals | match length << 20 | distance << 40`, and where its last match
/// ended.
pub type Found = { table: Array<Int>, seqs: List<Int>, anchor: Int }

/// The matches of `buf` from `i` to `end`: at each place, the bytes of the last match's distance
/// back, or the last place the next four bytes stood within 2 MiB, if either holds the same four.
/// `table` holds each place plus one, counted from the stream's start, which is `shift` before
/// `buf`'s; it has 131072 entries, and `anchor` is where the block's unmatched bytes start. A
/// place nothing matches at is passed, the faster the longer nothing has, and `fuel` bounds the
/// places.
pub fn found(
  buf: Bytes,
  i: Int,
  anchor: Int,
  end: Int,
  table: Array<Int>,
  seqs: List<Int>,
  last: Int,
  shift: Int,
  fuel: Int,
) -> Found / {abort.raise} =
  if fuel <= 0 || i + 8 > end { { table: table, seqs: seqs, anchor: anchor } } else {
    let v = int_of_u32(bytes_u32_le(buf, i));
    let h = v * 506832829 >>> 44;
    let seen = array_get(table, h) - 1 - shift;
    let marked = array_set(table, h, i + shift + 1);
    let near = last > 0 && i - last >= 0 && int_of_u32(bytes_u32_le(buf, i - last)) == v;
    let dist = if near { last }
    else if seen >= 0 && seen < i && i - seen <= 2097152
        && int_of_u32(bytes_u32_le(buf, seen)) == v { i - seen }
    else { 0 };
    if dist == 0 {
      found(buf, i + 1 + (i - anchor >>> 7), anchor, end, marked, seqs, last, shift, fuel - 1)
    } else {
      let length = agreeing(buf, i - dist, i, end - i, 4);
      // Two places inside the match are filed as well, so what follows can match from within it.
      let inner = array_set(
        marked,
        int_of_u32(bytes_u32_le(buf, i + 2)) * 506832829 >>> 44,
        i + shift + 3,
      );
      let tail = i + length - 2;
      found(
        buf,
        i + length,
        i + length,
        end,
        if tail + 4 > end { inner } else {
          array_set(inner, int_of_u32(bytes_u32_le(buf, tail)) * 506832829 >>> 44, tail + shift + 1)
        },
        push(seqs, i - anchor | length << 20 | dist << 40),
        dist,
        shift,
        fuel - 1,
      )
    }
  }

test "spans start each code where the one before ends" {
  assert_eq(array_to_list(spans([0, 0, 1, 2], 3)), [3 << 5, 4 << 5, 5 << 5 | 1, 7 << 5 | 2])
}

test "a code's lengths are a whole code, the commoner symbol never the longer, and none past the most" {
  let counts = array_of_list([40, 0, 30, 10, 10, 5, 3, 1, 1]);
  let lengths = array_to_list(code_lengths(counts, 15));
  assert_eq(lengths, [1, 0, 2, 4, 4, 4, 5, 6, 6]);
  let held = array_to_list(code_lengths(counts, 8));
  assert_eq(fold(held, 0, |sum: Int, l: Int| if l == 0 { sum } else { sum + (256 >>> l) }), 256);
  let steep = array_of_list(map(range(0, 30), |i: Int| 1 << i));
  let capped = array_to_list(code_lengths(steep, 11));
  assert_eq(fold(capped, 0, |sum: Int, l: Int| sum + (2048 >>> l)), 2048);
  assert_eq(fold(capped, 0, |most: Int, l: Int| max(most, l)), 11);
  assert_eq(array_to_list(code_lengths(array_of_list([0, 7, 0, 9]), 15)), [0, 1, 0, 1])
}

test "a byte is counted each time it stands" {
  let counts = tally(b"abracadabra");
  assert_eq(array_get(counts, 97), 5);
  assert_eq(array_get(counts, 98), 2);
  assert_eq(array_get(counts, 122), 0)
}

test "what repeats is found as literals and a match, and what does not is left unmatched" {
  let text = b"a sentence with a sentence in it, and a sentence with a sentence in it again";
  let seen = found(text, 0, 0, bytes_len(text), array_new(131072, 0), [], 0, 0, 1000);
  let total = fold(seen.seqs, 0, |n: Int, s: Int| n + (s & 0xF_FFFF) + (s >>> 20 & 0xF_FFFF));
  assert(len(seen.seqs) >= 2);
  assert_eq(total, seen.anchor);
  assert(seen.anchor > 40);
  let none = found(b"abcdefghijklmnopqrstuvwxyz", 0, 0, 26, array_new(131072, 0), [], 0, 0, 100);
  assert_eq(none.seqs, []);
  assert_eq(none.anchor, 0)
}
