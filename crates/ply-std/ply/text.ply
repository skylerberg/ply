      camel: "caf\u{e9}Bar",
      pascal: "Caf\u{e9}Bar",
      title: "Caf\u{e9} Bar",
    },
    { name: "A", words: ["A"], snake: "a", kebab: "a", camel: "a", pascal: "A", title: "A" },
    { name: "", words: [], snake: "", kebab: "", camel: "", pascal: "", title: "" },
  ]

test "{show(c.name)} in each case style" for c: Styled in styled() {
  assert_eq(name_words(c.name), c.words);
  assert_eq(snake_case(c.name), c.snake);
  assert_eq(kebab_case(c.name), c.kebab);
  assert_eq(camel_case(c.name), c.camel);
  assert_eq(pascal_case(c.name), c.pascal);
  assert_eq(title_case(c.name), c.title)
}

type Quoted = { word: String, quoted: Option<String> }

fn quotings() -> List<Quoted> =
  [
    { word: "", quoted: Some("''") },
    { word: "abc", quoted: Some("abc") },
    { word: "src/main.ply:12", quoted: Some("src/main.ply:12") },
    { word: "a b", quoted: Some("'a b'") },
    { word: "it's", quoted: Some("'it'\\''s'") },
    { word: "'", quoted: Some("''\\'''") },
    { word: "$HOME", quoted: Some("'$HOME'") },
    { word: "{a,b}", quoted: Some("'{a,b}'") },
    { word: "~", quoted: Some("'~'") },
    { word: "*.ply", quoted: Some("'*.ply'") },
    { word: "a\nb", quoted: Some("'a\nb'") },
    { word: "a\\b", quoted: Some("'a\\b'") },
    { word: "CC=gcc", quoted: Some("'CC=gcc'") },
    { word: "if", quoted: Some("'if'") },
    { word: "time", quoted: Some("'time'") },
    { word: "iffy", quoted: Some("iffy") },
    { word: "=ls", quoted: Some("'=ls'") },
    { word: "--jobs=4", quoted: Some("--jobs=4") },
    { word: "-", quoted: Some("-") },
    { word: "caf\u{e9}", quoted: Some("'caf\u{e9}'") },
    { word: "a\0b", quoted: None },
  ]

test "the word {show(c.word)} is quoted for a shell" for c: Quoted in quotings() {
  assert_eq(shell_quote(c.word), c.quoted)
}

type Split = { line: String, words: Option<List<String>> }

fn splits() -> List<Split> =
  [
    { line: "", words: Some([]) },
    { line: " \t ", words: Some([]) },
    { line: "  a  b\tc ", words: Some(["a", "b", "c"]) },
    { line: "'a b' \"c d\" e\\ f", words: Some(["a b", "c d", "e f"]) },
    { line: "'' \"\"", words: Some(["", ""]) },
    { line: "a'b'\"c\"d", words: Some(["abcd"]) },
    { line: "\"a\\\"b\\\\c\\$d\\`e\"", words: Some(["a\"b\\c$d`e"]) },
    { line: "\"a\\nb\"", words: Some(["a\\nb"]) },
    { line: "'a\\nb'", words: Some(["a\\nb"]) },
    { line: "'it'\\''s'", words: Some(["it's"]) },
    { line: "\\$HOME \\*", words: Some(["$HOME", "*"]) },
    { line: "'a\nb' \"c\nd\"", words: Some(["a\nb", "c\nd"]) },
    { line: "a \\\n b", words: Some(["a", "b"]) },
    { line: "a\\\nb \"c\\\nd\"", words: Some(["ab", "cd"]) },
    { line: "make CC=gcc --jobs=4", words: Some(["make", "CC=gcc", "--jobs=4"]) },
    { line: "'CC=gcc' make", words: Some(["CC=gcc", "make"]) },
    { line: "caf\u{e9} \u{1F600}", words: Some(["caf\u{e9}", "\u{1F600}"]) },
    { line: "'abc", words: None },
    { line: "\"abc", words: None },
    { line: "abc\\", words: None },
    { line: "echo $HOME", words: None },
    { line: "echo \"$HOME\"", words: None },
    { line: "echo `date`", words: None },
    { line: "echo \"`date`\"", words: None },
    { line: "ls *.ply", words: None },
    { line: "a | b", words: None },
    { line: "a; b", words: None },
    { line: "a > b", words: None },
    { line: "a && b", words: None },
    { line: "(a)", words: None },
    { line: "~/bin/x", words: None },
    { line: "a # b", words: None },
    { line: "{a,b}", words: None },
    { line: "! a", words: None },
    { line: "a\nb", words: None },
    { line: "a\r", words: None },
    { line: "CC=gcc make", words: None },
    { line: "if x", words: None },
    { line: "time make", words: None },
    { line: "done", words: None },
    { line: "'if' x", words: Some(["if", "x"]) },
    { line: "i\\f x", words: Some(["if", "x"]) },
    { line: "x if done", words: Some(["x", "if", "done"]) },
    { line: "iffy", words: Some(["iffy"]) },
    { line: "_x1=2", words: None },
    { line: "a\u{3000}b", words: None },
    { line: "a\0b", words: None },
    { line: "'a\0b'", words: None },
  ]

test "a shell reads {show(c.line)} as its words, or as more than words" for c: Split in splits() {
  assert_eq(shell_split(c.line), c.words)
}

law "a wrapped line is within the width unless it is one word"
  forall (codes: List<Int>, w: Int) {
    let width = 1 + within(w, 24);
    all(wrap(prose(codes), width), |line: String|
      string_len(line) <= width || !string_contains(line, " "))
  }

law "wrapping keeps every word, in order"
  forall (codes: List<Int>, w: Int) {
    join(wrap(prose(codes), 1 + within(w, 24)), " ") == join(spaced(prose(codes)), " ")
  }

law "a broken word leaves no line over the width and no character out"
  forall (codes: List<Int>, w: Int) {
    let width = 1 + within(w, 24);
    let lines = wrap(prose(codes), width, break_words: true);
    all(lines, |line: String| string_len(line) <= width)
      && join(spaced(join(lines, " ")), "") == join(spaced(prose(codes)), "")
  }

/// Lines at the depths the codes pick, the first at none, and none of blanks alone.
fn staggered(codes: List<Int>) -> String / {abort.raise} =
  join(
    prepend(
      "x",
      map(codes, |code: Int|
        if within(code, 5) == 0 { "" } else { repeat(" ", within(code, 4)) ++ "y" }),
    ),
    "\n",
  )

law "an indent taken off again is the text"
  forall (codes: List<Int>, n: Int) {
    dedent(indent(staggered(codes), repeat(" ", within(n, 9)))) == staggered(codes)
  }

law "a dedented text has no more to lose" = idempotent(dedent)

law "a cut text fits its width, and a text that fits is not cut"
  forall (text: String, w: Int) {
    let width = within(w, 12) - 2;
    let cut = truncate(text, width);
    string_len(cut) <= max(width, 0) && (string_len(text) > width || cut == text)
  }

law "a table's lines hold their rows' cells, in order"
  forall (codes: List<List<List<Int>>>) {
    let rows = map(codes, |row: List<List<Int>>| map(row, |cell: List<Int>| spelled(cell, "abc")));
    map(table(rows, sides: [Right, Center]), spaced)
      == map(rows, |row: List<String>| filter(row, |cell: String| cell != ""))
  }

fn word_of(codes: List<Int>) -> String / {abort.raise} = spelled(codes, "abc")

/// The fewest edits, by trying each at the first place the two differ.
fn fewest(a: List<Char>, b: List<Char>, swaps: Bool) -> Int =
  match a {
    [] -> len(b),
    [x, ..xs] -> match b {
      [] -> len(a),
      [y, ..ys] -> if x == y { fewest(xs, ys, swaps) } else {
        let edited = 1
          + min(fewest(xs, b, swaps), min(fewest(a, ys, swaps), fewest(xs, ys, swaps)));
        match xs {
          [x2, ..xs2] -> match ys {
            [y2, ..ys2] -> if swaps && x == y2 && x2 == y {
              min(edited, 1 + fewest(xs2, ys2, swaps))
            } else { edited },
            [] -> edited,
          },
          [] -> edited,
        }
      },
    },
  }

type Two = { a: List<Int>, b: List<Int> }

law "the edit distance is the fewest edits, tried every way" =
  agrees(|p: Two| edit_distance(word_of(take(p.a, 5)), word_of(take(p.b, 5))), |p: Two|
    fewest(string_chars(word_of(take(p.a, 5))), string_chars(word_of(take(p.b, 5))), false))

law "the distance with swaps is the fewest edits and swaps, tried every way" =
  agrees(|p: Two| typo_distance(word_of(take(p.a, 5)), word_of(take(p.b, 5))), |p: Two|
    fewest(string_chars(word_of(take(p.a, 5))), string_chars(word_of(take(p.b, 5))), true))

law "the edit distance is a metric"
  forall (x: List<Int>, y: List<Int>, z: List<Int>) {
    let a = word_of(x);
    let b = word_of(y);
    let c = word_of(z);
    edit_distance(a, a) == 0 && (edit_distance(a, b) > 0 || a == b)
      && edit_distance(a, b) == edit_distance(b, a)
      && edit_distance(a, c) <= edit_distance(a, b) + edit_distance(b, c)
  }

law "a swap costs no more than the edits it stands for, either way round"
  forall (x: List<Int>, y: List<Int>) {
    let a = word_of(x);
    let b = word_of(y);
    typo_distance(a, b) <= edit_distance(a, b) && typo_distance(a, b) == typo_distance(b, a)
      && (typo_distance(a, b) > 0 || a == b)
  }

law "a bounded search agrees with the distance within its limit"
  forall (x: List<Int>, y: List<Int>, k: Int) {
    let a = word_of(x);
    let b = word_of(y);
    let limit = within(k, 9) - 1;
    edit_distance_within(a, b, limit)
      == (if edit_distance(a, b) <= limit { Some(edit_distance(a, b)) } else { None })
      && typo_distance_within(a, b, limit)
      == (if typo_distance(a, b) <= limit { Some(typo_distance(a, b)) } else { None })
  }

law "the closest candidate is within the limit, none is nearer, and none as near comes first"
  forall (x: List<Int>, ys: List<List<Int>>, k: Int) {
    let word = word_of(x);
    let candidates = map(ys, |y: List<Int>| word_of(y));
    let limit = within(k, 6);
    match closest(word, candidates, limit) {
      None -> all(candidates, |c: String| typo_distance(word, c) > limit),
      Some(best) ->
        typo_distance(word, best) <= limit
          && all(candidates, |c: String| typo_distance(word, c) >= typo_distance(word, best))
          && list_at(
            filter(candidates, |c: String| typo_distance(word, c) == typo_distance(word, best)),
            0,
          )
          == Some(best),
    }
  }

law "a bounded search is linear in the words it compares"
  forall (n: Int) where n > 0 cost n {
    edit_distance_within(repeat("ab", n), repeat("ba", n), 2)
  }

fn mixed(codes: List<Int>) -> String / {abort.raise} = spelled(codes, "abXY12_- .\u{e9}")

law "snake_case is settled after one pass" = idempotent(snake_case)

law "snake_case, kebab-case and Title Case are settled after one pass, and keep the words"
  forall (codes: List<Int>) {
    let name = mixed(codes);
    let words = map(name_words(name), ascii_lower);
    snake_case(snake_case(name)) == snake_case(name)
      && kebab_case(kebab_case(name)) == kebab_case(name)
      && title_case(title_case(name)) == title_case(name)
      && name_words(snake_case(name)) == words
      && name_words(kebab_case(name)) == words
      && map(name_words(title_case(name)), ascii_lower) == words
  }

/// A name in snake_case whose every word starts with two letters, so no style runs two together.
fn named(picks: List<Int>) -> String / {abort.raise} = {
  let vocabulary = ["http", "request", "id", "sha256", "line", "to", "utf8"];
  join(map(picks, |p: Int| at_or(vocabulary, within(p, 7), "")), "_")
}

law "camelCase reads back as the snake_case it was made of" =
  agrees(|picks: List<Int>| snake_case(camel_case(named(picks))), named)

law "PascalCase reads back as the snake_case it was made of" =
  agrees(|picks: List<Int>| snake_case(pascal_case(named(picks))), named)

law "kebab-case reads back as the snake_case it was made of" =
  agrees(|picks: List<Int>| snake_case(kebab_case(named(picks))), named)

law "Title Case reads back as the snake_case it was made of" =
  agrees(|picks: List<Int>| snake_case(title_case(named(picks))), named)

law "a word is refused exactly where it holds the zero character"
  forall (word: String) {
    shell_quote(word) == None == string_contains(word, "\0")
  }

law "a line of quoted words splits back into them"
  forall (args: List<String>) {
    match shell_join(args) {
      Some(line) -> shell_split(line) == Some(args),
      None -> !all(args, |arg: String| !string_contains(arg, "\0")),
    }
  }

law "a word a shell would take for its own grammar is quoted, and splits back"
  forall (picks: List<Int>) {
    let own = ["if", "do", "time", "in", "CC=1", "=x", "x", "", "-o=1", "~", "#"];
    let args = map(picks, |p: Int| at_or(own, within(p, 11), ""));
    match shell_join(args) { Some(line) -> shell_split(line) == Some(args), None -> false }
  }

law "what a shell reads into is quoted, and splits back whole"
  forall (codes: List<List<Int>>) {
    let args = map(codes, |word: List<Int>|
      spelled(word, "ab '\"\\$`\n\t*?[]{}~#!&|;<>()=-%\u{e9}\u{3000}"));
    match shell_join(args) { Some(line) -> shell_split(line) == Some(args), None -> false }
  }
