//! Ed25519 signatures, as RFC 8032 defines them and publishes vectors for.
//!
//! A 32-byte seed is a secret key, `public_key` its 32-byte public key, and `sign` a 64-byte
//! signature `verify` checks. A seed is a `Secret`: the runtime signs with it in constant time, and
//! nothing written in Ply reads it. A signature is a function of the seed and the message alone.
//!
//! `verify` is strict: a signature whose `S` is not below the group order is refused, so one
//! signature cannot be rewritten as another for the same message, and `R` is compared as the bytes
//! the signature carries. `std.crypto` holds the same keys as types of their own, beside the other
//! signatures.

import std.bytes (repeat)
import std.hex
import std.random (entropy)

/// A fresh seed of the operating system's entropy, drawn sealed: `std.fs`'s `write_secret` is how
/// one is written down, as `ply keygen` writes its own.
pub fn generate() -> Secret<Bytes> / {entropy.secret} = entropy.secret(32)

/// The public key of a 32-byte seed. Raises for a seed of any other length.
pub fn public_key(seed: Secret<Bytes>) -> Bytes / {abort.raise} =
  match crypto_public("ed25519", seed) {
    Some(key) -> key,
    None -> panic("an Ed25519 seed is 32 bytes"),
  }

/// The 64-byte signature of `message` under the 32-byte seed `seed`. Raises for a seed of any
/// other length.
pub fn sign(seed: Secret<Bytes>, message: Bytes) -> Bytes / {abort.raise} =
  match crypto_sign("ed25519", seed, message) {
    Some(signature) -> signature,
    None -> panic("an Ed25519 seed is 32 bytes"),
  }

/// Whether `signature` is `message` signed by the key `public` names. `false` for a key that is
/// not 32 bytes of a point on the curve and a signature that is not 64 bytes.
pub fn verify(public: Bytes, message: Bytes, signature: Bytes) -> Bool / {abort.raise} =
  crypto_verify("ed25519", public, message, signature)

// --- Tests ------------------------------------------------------------------

type Vector = { name: String, seed: Bytes, public: Bytes, message: Bytes, signature: Bytes }

/// RFC 8032 §7.1: tests 1 to 3, and the one over a SHA-512 digest.
fn vectors() -> List<Vector> =
  [
    {
      name: "test 1",
      seed: hex"9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60",
      public: hex"d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a",
      message: b"",
      signature: hex"e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b",
    },
    {
      name: "test 2",
      seed: hex"4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb",
      public: hex"3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c",
      message: hex"72",
      signature: hex"92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00",
    },
    {
      name: "test 3",
      seed: hex"c5aa8df43f9f837bedb7442f31dcb7b166d38535076f094b85ce3a2e0b4458f7",
      public: hex"fc51cd8e6218a1a38da47ed00230f0580816ed13ba3303ac5deb911548908025",
      message: hex"af82",
      signature: hex"6291d657deec24024827e69c3abe01a30ce548a284743a445e3680d7db5ac3ac18ff9b538d16f290ae67f760984dc6594a7c15e9716ed28dc027beceea1ec40a",
    },
    {
      name: "test SHA(abc)",
      seed: hex"833fe62409237b9d62ec77587520911e9a759cec1d19755b7da901b96dca3d42",
      public: hex"ec172b93ad5e563bf4932c70e1245034c35467ef2efd4d64ebf819683467e2bf",
      message: hex"ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f",
      signature: hex"dc2a4459e7369633a52b1bf277839a00201009a3efbf3ecb69bea2186c26b58909351fc9ac90b3ecfdfbc7c66431e0303dca179c138ac17ad9bef1177331a704",
    },
  ]

test "RFC 8032, {v.name}: the seed's public key, its signature, and the signature verifies" for v: Vector in vectors(
  ) {
  assert_eq(public_key(secret_of_bytes(v.seed)), v.public);
  assert_eq(sign(secret_of_bytes(v.seed), v.message), v.signature);
  assert(verify(v.public, v.message, v.signature))
}

fn vector(i: Int) -> Vector / {abort.raise} =
  match list_at(vectors(), i) { Some(v) -> v, None -> panic("a vector") }

test "a signature over other bytes, under another key, or altered does not verify" {
  let v = vector(1);
  assert(!verify(v.public, hex"73", v.signature));
  assert(!verify(vector(2).public, v.message, v.signature));
  let flipped = bytes_concat(
    bytes_slice(v.signature, 0, 63),
    byte_of_int(bytes_at(v.signature, 63) ^ 1),
  );
  assert(!verify(v.public, v.message, flipped));
  assert(!verify(v.public, v.message, bytes_slice(v.signature, 0, 63)));
  assert(!verify(bytes_slice(v.public, 0, 31), v.message, v.signature))
}

/// The group order, least byte first.
fn order() -> Bytes = hex"edd3f55c1a631258d69cf7a2def9de1400000000000000000000000000000010"

test "a signature whose S is not below the group order is refused" {
  let v = vector(0);
  // S + L encodes the same scalar mod L, which a strict verifier refuses.
  let s = bytes_slice(v.signature, 32, 64);
  let summed = fold(
    range(0, 32),
    { out: b"", carry: 0 },
    |acc: { out: Bytes, carry: Int }, i: Int| {
      let t = bytes_at(s, i) + bytes_at(order(), i) + acc.carry;
      { out: bytes_concat(acc.out, byte_of_int(t & 255)), carry: t >> 8 }
    },
  );
  assert(!verify(v.public, v.message, bytes_concat(bytes_slice(v.signature, 0, 32), summed.out)))
}

test "a seed that is not thirty-two bytes is no key" {
  assert_eq(
    try[abort.raise] { public_key(secret_of_bytes(b"short")) },
    Err("an Ed25519 seed is 32 bytes"),
  );
  assert_eq(
    try[abort.raise] { sign(secret_of_bytes(b""), b"m") },
    Err("an Ed25519 seed is 32 bytes"),
  )
}

test "a fresh seed is thirty-two bytes of the system's entropy, drawn sealed" {
  let seed = handle {
    generate()
  } with {
    entropy.secret(n) -> secret_of_bytes(repeat(b"\x06", n)),
  };
  assert_eq(secret_len(seed), 32);
  assert(seed == secret_of_bytes(repeat(b"\x06", 32)))
}

law "a signature verifies under its seed's key, and under no other message"
  forall (material: Bytes, message: Bytes) {
    let seed = secret_of_bytes(bytes_blake3(material));
    let signature = sign(seed, message);
    verify(public_key(seed), message, signature)
      && !verify(public_key(seed), bytes_concat(message, b"\x00"), signature)
  }

law "a seed decides its key and its signatures"
  forall (material: Bytes, message: Bytes) {
    let seed = bytes_blake3(material);
    public_key(secret_of_bytes(seed)) == public_key(secret_of_bytes(seed))
      && sign(secret_of_bytes(seed), message) == sign(secret_of_bytes(seed), message)
  }

law "another seed's key refuses the signature"
  forall (material: Bytes, message: Bytes) {
    let seed = secret_of_bytes(bytes_blake3(material));
    let other = secret_of_bytes(bytes_blake3(bytes_concat(material, b"\x01")));
    !verify(public_key(other), message, sign(seed, message))
  }
