test "XXH3 of {c.size} sanity bytes under seed {c.seed}" for c: Sanity in xxh3_sanity() {
  assert_eq(xxh3_64(sanity(c.size), c.seed), c.sum)
}

test "xxHash of text, unseeded" {
  assert_eq(xxh64(b"abc", 0u64), 0x44BC_2CF5_AD77_0999u64);
  assert_eq(xxh3_64(b"abc", 0u64), 0x78AF_5F94_892F_3950u64);
  assert_eq(xxh64(b"Nobody inspects the spammish repetition", 0u64), 0xFBCE_A83C_8A37_8BF1u64);
  assert_eq(xxh3_64(b"Nobody inspects the spammish repetition", 0u64), 0x6CB0_0603_B5CC_47E9u64)
}

/// The key 00 to 0f the SipHash paper's vectors are under.
fn sixteen() -> SipKey = SipKey(0x0706_0504_0302_0100, 0x0F0E_0D0C_0B0A_0908)

type SipVector = { size: Int, two_four: U64, one_three: U64 }

/// Inputs of 00 upward, on both sides of a word: SipHash-2-4 as the paper's reference code lists
/// it, and SipHash-1-3 as that code computes it.
fn sip_vectors() -> List<SipVector> =
  [
    { size: 0, two_four: 0x726F_DB47_DD0E_0E31u64, one_three: 0xABAC_0158_050F_C4DCu64 },
    { size: 1, two_four: 0x74F8_39C5_93DC_67FDu64, one_three: 0xC9F4_9BF3_7D57_CA93u64 },
    { size: 7, two_four: 0xAB02_00F5_8B01_D137u64, one_three: 0xD392_7D98_9BB1_1140u64 },
    { size: 8, two_four: 0x93F5_F579_9A93_2462u64, one_three: 0x3690_9511_8D29_9A8Eu64 },
    { size: 9, two_four: 0x9E00_82DF_0BA9_E4B0u64, one_three: 0x25A4_8EB3_6C06_3DE4u64 },
    { size: 15, two_four: 0xA129_CA61_49BE_45E5u64, one_three: 0xD320_D86D_2A51_9956u64 },
    { size: 16, two_four: 0x3F2A_CC7F_57C2_9BDBu64, one_three: 0xCC4F_DD1A_7D90_8B66u64 },
    { size: 63, two_four: 0x958A_324C_EB06_4572u64, one_three: 0x9D19_9062_B7BB_B3A8u64 },
  ]

test "SipHash of {c.size} bytes under the paper's key" for c: SipVector in sip_vectors() {
  assert_eq(siphash24(sixteen(), counted(c.size)), c.two_four);
  assert_eq(siphash13(sixteen(), counted(c.size)), c.one_three)
}

test "a key is sixteen bytes, shows as nothing, and a drawn one takes three draws" {
  assert_eq(sip_key(counted(16)), Some(sixteen()));
  assert_eq(sip_key(counted(15)), None);
  assert_eq(sip_key(counted(17)), None);
  assert_eq(show(sixteen()), "SipKey(****)");
  assert_eq(f"{sixteen()}", "SipKey(****)");
  let drawn = handle { sip_key_drawn() } with { entropy.next() -> 5 };
  assert_eq(drawn, SipKey(5 | 1 << 63, 5))
}

/// One of each, with a CRC of each width and reflection.
fn every() -> List<Algorithm> =
  [
    Crc(crc8_smbus()),
    Crc(crc16_arc()),
    Crc(crc16_xmodem()),
    Crc(crc32_iso_hdlc()),
    Crc(crc32_mpeg2()),
    Crc(crc64_xz()),
    Crc(crc64_ecma_182()),
    Adler32,
    Fnv1a32,
    Fnv1a64,
    Xxh64(0u64),
    Xxh64(0x9E37_79B1_85EB_CA8Du64),
    Xxh3(0u64),
    Xxh3(0x9E37_79B1_85EB_CA8Du64),
    SipHash13(sixteen()),
    SipHash24(sixteen()),
  ]

fn whole(a: Algorithm, data: Bytes) -> U64 = finish(update(init(a), data))

/// `data` fed in pieces of `size` bytes.
fn pieces(a: Algorithm, data: Bytes, size: Int) -> State / {abort.raise} =
  fold(range(0, (bytes_len(data) + size - 1) / size), init(a), |s: State, k: Int|
    update(s, bytes_slice(data, k * size, min((k + 1) * size, bytes_len(data)))))

test "an input cut in two anywhere, or fed in pieces of any size, sums as it does whole" {
  let data = sanity(1500);
  let cuts = [
    0,
    1,
    3,
    4,
    7,
    8,
    9,
    31,
    32,
    33,
    63,
    64,
    65,
    128,
    129,
    239,
    240,
    241,
    256,
    1023,
    1024,
    1025,
    1088,
    1089,
    1499,
    1500,
  ];
  fold(every(), (), |_: Unit, a: Algorithm| {
    let want = whole(a, data);
    fold(cuts, (), |_: Unit, at: Int|
      assert_eq(
        finish(update(update(init(a), bytes_slice(data, 0, at)), bytes_slice(data, at, 1500))),
        want,
      ));
    fold([1, 7, 64, 100, 241], (), |_: Unit, size: Int|
      assert_eq(finish(pieces(a, data, size)), want))
  })
}

test "a state is not spent by finishing: it takes more input after" {
  fold(every(), (), |_: Unit, a: Algorithm| {
    let half = update(init(a), b"the first half, ");
    assert_eq(finish(half), whole(a, b"the first half, "));
    assert_eq(finish(update(half, b"and the second")), whole(a, b"the first half, and the second"))
  })
}

law "a sum over an input cut in two is the sum over it whole"
  forall (a: Bytes, b: Bytes) {
    fold(every(), true, |ok: Bool, alg: Algorithm|
      ok && finish(update(update(init(alg), a), b)) == whole(alg, bytes_concat(a, b)))
  }

law "a CRC-64 part is a monoid under join" =
  monoid(|a: Part, b: Part| crc_join(crc64_xz(), a, b), crc_empty(crc64_xz()))

law "the CRC-32 of two inputs joined is their CRC-32s combined"
  forall (a: Bytes, b: Bytes) {
    crc32_combine(crc32(a), crc32(b), bytes_len(b)) == crc32(bytes_concat(a, b))
  }

law "the Adler-32 of two inputs joined is their Adler-32s combined"
  forall (a: Bytes, b: Bytes) {
    adler32_combine(adler32(a), adler32(b), bytes_len(b)) == adler32(bytes_concat(a, b))
  }

fn models() -> List<Crc> =
  [
    crc8_smbus(),
    crc16_arc(),
    crc16_ibm_3740(),
    crc16_xmodem(),
    crc32_iso_hdlc(),
    crc32_cksum(),
    crc32_mpeg2(),
    crc64_xz(),
    crc64_ecma_182(),
    match crc_of(umts()) { Some(c) -> c, None -> crc8_smbus() },
  ]

test "a CRC combines under every kind of model, over lengths short and long" {
  let data = sanity(3000);
  fold(models(), (), |_: Unit, c: Crc|
    fold([0, 1, 7, 8, 255, 256, 1500, 2999, 3000], (), |_: Unit, at: Int| {
      let head = bytes_slice(data, 0, at);
      let tail = bytes_slice(data, at, 3000);
      assert_eq(crc_combine(c, crc(c, head), crc(c, tail), 3000 - at), crc(c, data));
      assert_eq(crc_join(c, crc_part(c, head), crc_part(c, tail)), crc_part(c, data))
    }));
  // A length of nothing, or less, joins nothing on.
  assert_eq(crc32_combine(crc32(b"abc"), crc32(b""), 0), crc32(b"abc"));
  assert_eq(crc32_combine(crc32(b"abc"), crc32(b""), 0 - 5), crc32(b"abc"));
  assert_eq(adler32_combine(adler32(b"abc"), adler32(b""), 0 - 5), adler32(b"abc"))
}

test "a CRC over chunks folded in parallel is the CRC of them joined" {
  let chunks = map(range(0, 3 * grain() + 5), |i: Int| sanity(i % 41));
  let all = bytes_concat_all(chunks);
  fold([crc32_iso_hdlc(), crc16_xmodem(), crc64_xz()], (), |_: Unit, c: Crc| {
    let folded = par_fold(
      chunks,
      crc_empty(c),
      |acc: Part, chunk: Bytes| crc_join(c, acc, crc_part(c, chunk)),
      |a: Part, b: Part| crc_join(c, a, b),
    );
    assert_eq(folded.sum, crc(c, all))
  })
}

law "XXH64 takes steps in proportion to its input"
  forall (n: Int) cost n {
    xxh64(counted(n), 0u64)
  }

law "XXH3 takes steps in proportion to its input"
  forall (n: Int) cost n {
    xxh3_64(counted(n), 0u64)
  }

law "SipHash takes steps in proportion to its input"
  forall (n: Int) cost n {
    siphash24(sixteen(), counted(n))
  }

law "a CRC of any model takes steps in proportion to its input"
  forall (n: Int) cost n {
    crc(crc16_xmodem(), counted(n))
  }

test "eight bytes are a step, so 64 KiB is a CRC in an eighth of its length in steps" {
  let data = counted(65536);
  let empty = metered(|| crc32(b"")).steps;
  assert(metered(|| crc32(data)).steps - empty < 65536 / 8 + 16);
  assert(metered(|| adler32(data)).steps - metered(|| adler32(b"")).steps < 65536 / 8 + 16)
}
