// std.pg — the postgres wire protocol, framed in Ply.
//
// Every message the front end sends after start-up is one byte of kind, an `Int32` length that
// counts itself, and a body. The start-up message is the exception: no kind byte, the length
// first. Values travel as text here, so a parameter is the text the server would have printed
// and a column is the text it printed, which is what makes this layer only about framing.

import std.bytes (u16_be, u32_be, i32_be, u16_be_at, u32_be_at, i32_be_at, slice_at, xor)
import std.hash (sha256, hmac_sha256, pbkdf2_sha256)
import std.json (base64_decode, base64_encode)
import std.net (net, send_all)
import std.list (concat)

// --- Kinds --------------------------------------------------------------------

// What the front end sends.
pub type Frontend = | Query | Parse | Bind | Describe | Execute | Sync | Close | Flush | Terminate

pub fn frontend_byte(f: Frontend) -> Int =
  match f {
    Query -> 81,
    Parse -> 80,
    Bind -> 66,
    Describe -> 68,
    Execute -> 69,
    Sync -> 83,
    Close -> 67,
    Flush -> 72,
    Terminate -> 88,
  }

pub fn frontend_name(f: Frontend) -> String =
  match f {
    Query -> "Query",
    Parse -> "Parse",
    Bind -> "Bind",
    Describe -> "Describe",
    Execute -> "Execute",
    Sync -> "Sync",
    Close -> "Close",
    Flush -> "Flush",
    Terminate -> "Terminate",
  }

// What the back end sends. `Other` keeps the byte, so a message this module does not name is
// still reportable rather than silently dropped.
pub type Backend =
  | Authentication
  | ParameterStatus
  | BackendKeyData
  | ReadyForQuery
  | RowDescription
  | DataRow
  | CommandComplete
  | ErrorResponse
  | NoticeResponse
  | ParseComplete
  | BindComplete
  | CloseComplete
  | NoData
  | ParameterDescription
  | EmptyQueryResponse
  | Other(Int)

pub fn backend_byte(k: Backend) -> Int =
  match k {
    Authentication -> 82,
    ParameterStatus -> 83,
    BackendKeyData -> 75,
    ReadyForQuery -> 90,
    RowDescription -> 84,
    DataRow -> 68,
    CommandComplete -> 67,
    ErrorResponse -> 69,
    NoticeResponse -> 78,
    ParseComplete -> 49,
    BindComplete -> 50,
    CloseComplete -> 51,
    NoData -> 110,
    ParameterDescription -> 116,
    EmptyQueryResponse -> 73,
    Other(b) -> b,
  }

pub fn backend_name(k: Backend) -> String =
  match k {
    Authentication -> "Authentication",
    ParameterStatus -> "ParameterStatus",
    BackendKeyData -> "BackendKeyData",
    ReadyForQuery -> "ReadyForQuery",
    RowDescription -> "RowDescription",
    DataRow -> "DataRow",
    CommandComplete -> "CommandComplete",
    ErrorResponse -> "ErrorResponse",
    NoticeResponse -> "NoticeResponse",
    ParseComplete -> "ParseComplete",
    BindComplete -> "BindComplete",
    CloseComplete -> "CloseComplete",
    NoData -> "NoData",
    ParameterDescription -> "ParameterDescription",
    EmptyQueryResponse -> "EmptyQueryResponse",
    Other(b) -> "Other(" ++ int_to_string(b) ++ ")",
  }

pub fn backend_of(b: Int) -> Backend =
  if b == 82 { Authentication }
  else if b == 83 { ParameterStatus }
  else if b == 75 { BackendKeyData }
  else if b == 90 { ReadyForQuery }
  else if b == 84 { RowDescription }
  else if b == 68 { DataRow }
  else if b == 67 { CommandComplete }
  else if b == 69 { ErrorResponse }
  else if b == 78 { NoticeResponse }
  else if b == 49 { ParseComplete }
  else if b == 50 { BindComplete }
  else if b == 51 { CloseComplete }
  else if b == 110 { NoData }
  else if b == 116 { ParameterDescription }
  else if b == 73 { EmptyQueryResponse }
  else { Other(b) }

// --- Framing ------------------------------------------------------------------

pub type Message = { kind: Backend, body: Bytes }

// A buffer read into whole messages, with whatever trailing bytes are not yet a whole one.
pub type Frames = { done: List<Message>, rest: Bytes }

fn cstring(s: String) -> Bytes = bytes_concat(bytes_of_string(s), b"\x00")

// A length that counts itself, which is what every frame's header is.
fn counted(body: Bytes) -> Bytes / {abort.raise} = bytes_concat(u32_be(bytes_len(body) + 4), body)

fn frontend(f: Frontend, body: Bytes) -> Bytes / {abort.raise} =
  bytes_concat(byte_of_int(frontend_byte(f)), counted(body))

// The start-up message: the protocol version, then the parameters, then a zero byte. No kind
// byte, because the server has no connection to have agreed one on yet. A parameter past `user`
// and `database` is a run-time setting the server applies to the session before it answers.
pub fn startup(user: String, database: String, parameters: List<Set>) -> Bytes / {abort.raise} =
  counted(
    bytes_concat_all([
      u32_be(196608),
      cstring("user"),
      cstring(user),
      cstring("database"),
      cstring(database),
      bytes_concat_all(map(parameters, |p: Set| bytes_concat(cstring(p.name), cstring(p.value)))),
      byte_of_int(0),
    ]),
  )

// The byte a server answers a start-up with to say it will speak TLS; 1234 5679, the magic the
// protocol reserves so that it can never be mistaken for a supported version.
pub fn ssl_request() -> Bytes / {abort.raise} = counted(u32_be(80877103))

pub fn ssl_response() -> Bytes / {abort.raise} = byte_of_int(83)

pub fn cancel_request(pid: Int, secret: Int) -> Bytes / {abort.raise} =
  counted(bytes_concat_all([u32_be(80877102), u32_be(pid), u32_be(secret)]))

// The simple query protocol: one statement, answered with rows and a command tag.
pub fn query(sql: String) -> Bytes / {abort.raise} = frontend(Query, cstring(sql))

// The extended protocol: `parse` names a statement, `bind` names a portal over it, `execute`
// runs the portal, and `sync` is what makes the server answer. Text format both ways.
pub fn parse(statement: String, sql: String, param_types: List<Int>) -> Bytes / {abort.raise} =
  frontend(
    Parse,
    bytes_concat_all([
      cstring(statement),
      cstring(sql),
      u16_be(len(param_types)),
      bytes_concat_all(map(param_types, |t: Int| u32_be(t))),
    ]),
  )

fn bound_value(p: Option<String>) -> Bytes / {abort.raise} =
  match p {
    None -> i32_be(-1),
    Some(text) -> {
      let raw = bytes_of_string(text);
      bytes_concat(i32_be(bytes_len(raw)), raw)
    },
  }

pub fn bind(
  portal: String,
  statement: String,
  params: List<Option<String>>,
) -> Bytes / {abort.raise} =
  frontend(
    Bind,
    bytes_concat_all([
      cstring(portal),
      cstring(statement),
      // No parameter format codes and no result format codes: everything is text.
      u16_be(0),
      u16_be(len(params)),
      bytes_concat_all(map(params, |p: Option<String>| bound_value(p))),
      u16_be(0),
    ]),
  )

// `statement` describes the prepared statement, otherwise the portal.
pub fn describe(statement: Bool, name: String) -> Bytes / {abort.raise} =
  frontend(Describe, bytes_concat(byte_of_int(if statement { 83 } else { 80 }), cstring(name)))

// `max_rows` of zero is no limit.
pub fn execute(portal: String, max_rows: Int) -> Bytes / {abort.raise} =
  frontend(Execute, bytes_concat(cstring(portal), u32_be(max_rows)))

pub fn sync() -> Bytes / {abort.raise} = frontend(Sync, b"")

pub fn flush() -> Bytes / {abort.raise} = frontend(Flush, b"")

pub fn close(statement: Bool, name: String) -> Bytes / {abort.raise} =
  frontend(Close, bytes_concat(byte_of_int(if statement { 83 } else { 80 }), cstring(name)))

pub fn terminate() -> Bytes / {abort.raise} = frontend(Terminate, b"")

// The first whole frame in `buf`, and the bytes after it. `None` leaves the buffer untouched:
// a length that is not yet present, or is not a length, is a read that returned short rather
// than a protocol error.
pub type Partial = { frame: Option<Message>, rest: Bytes }

pub fn first(buf: Bytes) -> Partial / {abort.raise} = {
  let n = bytes_len(buf);
  if n < 5 { { frame: None, rest: buf } } else {
    match u32_be_at(buf, 1) {
      None -> { frame: None, rest: buf },
      Some(len) -> if len < 4 || 1 + len > n { { frame: None, rest: buf } } else {
        {
          frame: Some({ kind: backend_of(bytes_at(buf, 0)), body: bytes_slice(buf, 5, 1 + len) }),
          rest: bytes_slice(buf, 1 + len, n),
        }
      },
    }
  }
}

// Every whole frame in `buf`, and the bytes that are not yet one.
pub fn read(buf: Bytes) -> Frames / {abort.raise} = read_all(buf, [], bytes_len(buf))

// A frame is five bytes at least, so the bytes bound the frames: `left`.
fn read_all(buf: Bytes, acc: List<Message>, left: Int) -> Frames / {abort.raise} = {
  let p = first(buf);
  match p.frame {
    None -> { done: acc, rest: p.rest },
    Some(m) -> if left <= 0 { panic("more frames than bytes") }
    else { read_all(p.rest, push(acc, m), left - 1) },
  }
}

// --- Reading a body -----------------------------------------------------------

// A zero-terminated string starting at `at`, and where the next field begins.
pub type CString = { text: String, next: Int }

pub fn read_cstring(b: Bytes, at: Int) -> Option<CString> / {abort.raise} =
  if at < 0 || at >= bytes_len(b) { None } else {
    match bytes_index_of_byte(bytes_slice(b, at, bytes_len(b)), 0) {
      None -> None,
      Some(i) -> Some({ text: string_of_bytes(bytes_slice(b, at, at + i)), next: at + i + 1 }),
    }
  }

// What the server says before it will talk: 0 is authenticated, 3 wants a clear-text password,
// 5 wants md5, 10 offers SASL, 11 and 12 are its two SASL steps.
pub fn auth_code(message: Message) -> Option<Int> / {abort.raise} = u32_be_at(message.body, 0)

pub fn auth_name(code: Int) -> String =
  if code == 0 { "AuthenticationOk" }
  else if code == 3 { "AuthenticationCleartextPassword" }
  else if code == 5 { "AuthenticationMD5Password" }
  else if code == 10 { "AuthenticationSASL" }
  else if code == 11 { "AuthenticationSASLContinue" }
  else if code == 12 { "AuthenticationSASLFinal" }
  else { "Authentication(" ++ int_to_string(code) ++ ")" }

// The bytes after the code, which is what a SASL step carries.
pub fn auth_body(message: Message) -> Option<Bytes> / {abort.raise} =
  slice_at(message.body, 4, bytes_len(message.body) - 4)

// 'I' idle, 'T' in a transaction, 'E' in a failed transaction, which refuses everything but
// `ROLLBACK` until it ends.
pub fn ready_status(message: Message) -> Option<Int> / {abort.raise} =
  if bytes_len(message.body) < 1 { None } else { Some(bytes_at(message.body, 0)) }

pub type Status = | Idle | InTransaction | FailedTransaction | Unknown(Int)

pub fn status_of(b: Int) -> Status =
  if b == 73 { Idle }
  else if b == 84 { InTransaction }
  else if b == 69 { FailedTransaction }
  else { Unknown(b) }

pub fn status_name(s: Status) -> String =
  match s {
    Idle -> "idle",
    InTransaction -> "in transaction",
    FailedTransaction -> "in a failed transaction",
    Unknown(b) -> "unknown(" ++ int_to_string(b) ++ ")",
  }

pub type BackendKey = { pid: Int, secret: Int }

pub fn backend_key(message: Message) -> Option<BackendKey> / {abort.raise} =
  match u32_be_at(message.body, 0) {
    None -> None,
    Some(pid) -> match u32_be_at(message.body, 4) {
      None -> None,
      Some(secret) -> Some({ pid: pid, secret: secret }),
    },
  }

pub type Set = { name: String, value: String }

pub fn parameter_status(message: Message) -> Option<Set> / {abort.raise} =
  match read_cstring(message.body, 0) {
    None -> None,
    Some(name) -> match read_cstring(message.body, name.next) {
      None -> None,
      Some(value) -> Some({ name: name.text, value: value.text }),
    },
  }

// A column's name, its type's OID and the format its values arrive in: 0 text, 1 binary.
pub type Column = { name: String, ty: Int, format: Int }

pub fn row_description(message: Message) -> Option<List<Column>> / {abort.raise} =
  match u16_be_at(message.body, 0) {
    None -> None,
    Some(count) -> columns(message.body, 2, count, []),
  }

fn columns(
  body: Bytes,
  at: Int,
  left: Int,
  acc: List<Column>,
) -> Option<List<Column>> / {abort.raise} =
  if left <= 0 { Some(acc) } else {
    match read_cstring(body, at) {
      None -> None,
      Some(name) -> match u32_be_at(body, name.next + 6) {
        // Name, table OID, attribute number, type OID, type size, type modifier, format.
        None -> None,
        Some(ty) -> match u16_be_at(body, name.next + 16) {
          None -> None,
          Some(format) ->
            columns(
              body,
              name.next + 18,
              left - 1,
              push(acc, { name: name.text, ty: ty, format: format }),
            ),
        },
      },
    }
  }

// One row, with `None` for a NULL column. The length is a count of bytes, and -1 is NULL.
pub fn data_row(message: Message) -> Option<List<Option<Bytes>>> / {abort.raise} =
  match u16_be_at(message.body, 0) {
    None -> None,
    Some(count) -> values(message.body, 2, count, []),
  }

fn values(
  body: Bytes,
  at: Int,
  left: Int,
  acc: List<Option<Bytes>>,
) -> Option<List<Option<Bytes>>> / {abort.raise} =
  if left <= 0 { Some(acc) } else {
    match i32_be_at(body, at) {
      None -> None,
      Some(len) -> if len < 0 { values(body, at + 4, left - 1, push(acc, None)) } else {
        match slice_at(body, at + 4, len) {
          None -> None,
          Some(raw) -> values(body, at + 4 + len, left - 1, push(acc, Some(raw))),
        }
      },
    }
  }

// The tag a completed command answers with: `SELECT 3`, `INSERT 0 1`, `BEGIN`.
pub fn command_tag(message: Message) -> Option<String> / {abort.raise} =
  match read_cstring(message.body, 0) { None -> None, Some(tag) -> Some(tag.text) }

pub fn parameter_types(message: Message) -> Option<List<Int>> / {abort.raise} =
  match u16_be_at(message.body, 0) { None -> None, Some(count) -> oids(message.body, 2, count, []) }

fn oids(body: Bytes, at: Int, left: Int, acc: List<Int>) -> Option<List<Int>> / {abort.raise} =
  if left <= 0 { Some(acc) } else {
    match u32_be_at(body, at) {
      None -> None,
      Some(oid) -> oids(body, at + 4, left - 1, push(acc, oid)),
    }
  }

// An `ErrorResponse` and a `NoticeResponse` are the same shape: a field type byte, the field's
// text, and a zero byte at the end. `S` is severity, `C` the SQLSTATE, `M` the message, `D` its
// detail and `n` the constraint a violation names.
pub type Field = { code: Int, text: String }

pub fn diagnostic_fields(message: Message) -> List<Field> / {abort.raise} =
  fields_of(message.body, 0, [], bytes_len(message.body))

// A field is its code and its text's end at least, so the bytes bound the fields: `left`.
fn fields_of(b: Bytes, at: Int, acc: List<Field>, left: Int) -> List<Field> / {abort.raise} =
  if at >= bytes_len(b) { acc }
  else if bytes_at(b, at) == 0 { acc } else {
    let code = bytes_at(b, at);
    match read_cstring(b, at + 1) {
      None -> acc,
      Some(field) -> if left <= 0 { panic("more fields than bytes") }
      else { fields_of(b, field.next, push(acc, { code: code, text: field.text }), left - 1) },
    }
  }

pub fn field_of(message: Message, code: Int) -> Option<String> / {abort.raise} =
  fold(diagnostic_fields(message), None, |acc: Option<String>, f: Field|
    if f.code == code { Some(f.text) } else { acc })

// --- A connection ---------------------------------------------------------------

pub type Client = { connect_ms: Int, read_ms: Int, write_ms: Int }

pub fn default_client() -> Client = { connect_ms: 5000, read_ms: 30000, write_ms: 30000 }

pub fn read_size() -> Int = 65536

// What the server said when it refused: the SQLSTATE is what a program branches on, the
// constraint is the one a violation names, and the rest is what it prints.
pub type Server = {
  severity: String,
  code: String,
  message: String,
  detail: String,
  constraint: String,
}

// A connection with a server, the bytes read from it that are not yet a whole frame, the
// parameters it set at start-up, and where its transaction stood at the last `ReadyForQuery`.
pub type Session = {
  conn: Int,
  buffer: Bytes,
  user: String,
  database: String,
  settings: List<Set>,
  status: Status,
}

pub type ClientError =
  | Unreachable
  | NotSent
  | TimedOut
  | Closed
  // The server refused and there is no connection left to use: it refused before it would talk,
  // or its error ended the session.
  | Refused(Server)
  // A statement was refused. The connection is still usable — the server is waiting for the
  // next one — so the session comes back with the refusal for the caller to decide about.
  | Rejected(Session, Server)
  | Unexpected(String)

// How a refusal reads: the severity, the message, and the SQLSTATE a program branches on.
pub fn server_text(server: Server) -> String =
  server.severity ++ ": " ++ server.message ++ " (" ++ server.code ++ ")"

pub fn client_error_text(e: ClientError) -> String =
  match e {
    Unreachable -> "the server could not be reached",
    NotSent -> "a message could not be sent",
    TimedOut -> "the server did not answer in time",
    Closed -> "the server closed the connection",
    Refused(s) -> server_text(s),
    Rejected(_, s) -> server_text(s),
    Unexpected(what) -> what,
  }

pub fn setting(s: Session, name: String) -> Option<String> =
  fold(s.settings, None, |acc: Option<String>, set: Set|
    if set.name == name { Some(set.value) } else { acc })

// A message read, and the buffer after it.
type Received = { message: Message, rest: Bytes }

fn read_message<[l]>(
  c: Int,
  buf: Bytes,
  timeout_ms: Int,
) -> Result<Received, ClientError> / {net.recv[l], abort.raise} =
  awaiting[l](c, buf, timeout_ms, 4294967297)

// A frame is at most 2^32 bytes past its kind, and a round adds a byte at least, so a well-formed
// one is whole within `room` rounds.
fn awaiting<[l]>(
  c: Int,
  buf: Bytes,
  timeout_ms: Int,
  room: Int,
) -> Result<Received, ClientError> / {net.recv[l], abort.raise} = {
  let p = first(buf);
  match p.frame {
    Some(m) -> Ok({ message: m, rest: p.rest }),
    None -> if bytes_len(buf) >= 5
        && (match u32_be_at(buf, 1) { Some(n) -> n < 4, None -> false }) {
      Err(Unexpected("a frame whose length is less than its own four bytes"))
    } else if room <= 0 { panic("a frame past its own length") } else {
      match net.recv[l](c, read_size(), timeout_ms) {
        None -> Err(TimedOut),
        Some(bytes) -> if bytes_len(bytes) == 0 { Err(Closed) }
        else { awaiting[l](c, bytes_concat(buf, bytes), timeout_ms, room - 1) },
      }
    },
  }
}

fn server_of(message: Message) -> Server / {abort.raise} =
  {
    severity: field_or(message, 83, "ERROR"),
    code: field_or(message, 67, ""),
    message: field_or(message, 77, ""),
    detail: field_or(message, 68, ""),
    constraint: field_or(message, 110, ""),
  }

// A `ReadyForQuery` without its status byte says nothing about the transaction.
fn status_after(message: Message) -> Status / {abort.raise} =
  match ready_status(message) { Some(b) -> status_of(b), None -> Unknown(0) }

fn field_or(m: Message, code: Int, fallback: String) -> String / {abort.raise} =
  match field_of(m, code) { Some(text) -> text, None -> fallback }

// Open a socket and get to where the server will answer a query: start-up, whatever
// authentication it asks for, its parameters, and `ReadyForQuery`.
pub fn connect<[l]>(
  host: String,
  port: Int,
  user: String,
  database: String,
  parameters: List<Set>,
  password: Option<String>,
  nonce: String,
  client: Client,
) -> Result<Session, ClientError> / {net.connect[l], net.send[l], net.recv[l], net.close[l], abort.raise} =
  match net.connect[l](host, port, client.connect_ms) {
    None -> Err(Unreachable),
    Some(conn) -> {
      let opening: Session = {
        conn: conn,
        buffer: b"",
        user: user,
        database: database,
        settings: [],
        status: Idle,
      };
      if !send_all[l](conn, startup(user, database, parameters), client.write_ms) {
        net.close[l](conn);
        Err(NotSent)
      } else {
        match greet[l](opening, password, nonce, client, nothing_said()) {
          Ok(s) -> Ok(s),
          Err(e) -> {
            net.close[l](conn);
            Err(e)
          },
        }
      }
    },
  }

fn greet<[l]>(
  s: Session,
  password: Option<String>,
  nonce: String,
  client: Client,
  acc: Greeting,
) -> Result<Session, ClientError> / {net.send[l], net.recv[l], abort.raise} =
  match read_message[l](s.conn, s.buffer, client.read_ms) {
    Err(e) -> Err(e),
    Ok(got) -> {
      let m = got.message;
      let rest: Session = { ..s, buffer: got.rest };
      match m.kind {
        Authentication -> match auth_code(m) {
          None -> Err(Unexpected("an authentication message with no code")),
          Some(0) -> greet[l](rest, password, nonce, client, acc),
          Some(3) -> match password {
            None -> Err(Refused(no_password(s.user, "a clear-text password"))),
            Some(text) -> if !send_all[l](rest.conn, password_message(text), client.write_ms) {
              Err(NotSent)
            } else { greet[l](rest, password, nonce, client, acc) },
          },
          Some(10) -> scram_begin[l](rest, password, nonce, client, acc, m),
          Some(11) -> scram_continue[l](rest, password, nonce, client, acc, m),
          Some(12) -> match acc.sasl.expected {
            None -> Err(Unexpected("the server proved itself before it was asked to")),
            Some(expected) -> match auth_text(m) {
              None -> Err(Unexpected("a SASL final that is not text")),
              Some(text) -> if !scram_verify(text, expected) {
                Err(Unexpected("the server's proof did not verify"))
              } else { greet[l](rest, password, nonce, client, acc) },
            },
          },
          Some(other) ->
            Err(
              Unexpected(
                "the server asks for " ++ auth_name(other)
                  ++ ", which this client does not answer yet",
              ),
            ),
        },
        ParameterStatus -> match parameter_status(m) {
          Some(set) ->
            greet[l](rest, password, nonce, client, { ..acc, settings: push(acc.settings, set) }),
          None -> greet[l](rest, password, nonce, client, acc),
        },
        BackendKeyData -> greet[l](rest, password, nonce, client, acc),
        NoticeResponse -> greet[l](rest, password, nonce, client, acc),
        ErrorResponse -> Err(Refused(server_of(m))),
        ReadyForQuery -> Ok({ ..rest, settings: acc.settings, status: status_after(m) }),
        _ -> Err(Unexpected("a " ++ backend_name(m.kind) ++ " before the server was ready")),
      }
    },
  }

fn no_password(user: String, what: String) -> Server =
  {
    severity: "ERROR",
    code: "28000",
    message: "the server wants " ++ what ++ " for `" ++ user ++ "`, and none was given",
    detail: "",
    constraint: "",
  }

// `PasswordMessage`, which is also the frame a SASL step travels in.
pub fn password_message(text: String) -> Bytes / {abort.raise} =
  bytes_concat(byte_of_int(112), counted(cstring(text)))

// --- SCRAM-SHA-256 --------------------------------------------------------------

// RFC 5802's exchange with RFC 7677's SHA-256: the client proves it knows the password without
// sending it, and then the server proves it knows the verifier. Four messages.

// What the greeting has collected: the parameters the server set, and where SASL has got to.
type Greeting = { settings: List<Set>, sasl: Sasl }

type Sasl = { first_bare: String, expected: Option<Bytes> }

fn nothing_said() -> Greeting = { settings: [], sasl: { first_bare: "", expected: None } }

// The GS2 header says no channel binding is in use, and the bare message names the user and the
// client's nonce. `=` and `,` are escaped, because they separate the fields.
pub fn scram_first(user: String, nonce: String) -> String / {abort.raise} =
  "n,," ++ scram_first_bare(user, nonce)

pub fn scram_first_bare(user: String, nonce: String) -> String / {abort.raise} =
  "n=" ++ scram_name(user) ++ ",r=" ++ nonce

fn scram_name(user: String) -> String / {abort.raise} =
  fold(range(0, string_len(user)), "", |acc: String, i: Int| {
    let c = string_slice(user, i, i + 1);
    if c == "=" { acc ++ "=3D" } else if c == "," { acc ++ "=2C" } else { acc ++ c }
  })

// One `name=value` out of a comma-separated message, or `None` when it is not there.
fn scram_attribute(text: String, name: String) -> Option<String> / {abort.raise} =
  fold(string_split(text, ","), None, |acc: Option<String>, part: String|
    match acc {
      Some(found) -> Some(found),
      None -> if string_starts_with(part, name ++ "=") {
        Some(string_slice(part, string_len(name) + 1, string_len(part)))
      } else { None },
    })

// A decimal count, refused rather than defaulted when it is not one.
fn nat_text(text: String) -> Option<Int> / {abort.raise} =
  if string_len(text) == 0 { None } else {
    fold(range(0, string_len(text)), Some(0), |acc: Option<Int>, i: Int|
      match acc {
        None -> None,
        Some(n) -> {
          let v = bytes_at(bytes_of_string(string_slice(text, i, i + 1)), 0);
          if v >= 48 && v <= 57 { Some(n * 10 + v - 48) } else { None }
        },
      })
  }

// `r`, `s` and `i` out of the server's first message; the salt is base64 there.
pub type Challenge = { nonce: String, salt: Bytes, iterations: Int }

pub fn scram_challenge(server_first: String) -> Option<Challenge> / {abort.raise} =
  match scram_attribute(server_first, "r") {
    None -> None,
    Some(nonce) -> match scram_attribute(server_first, "s") {
      None -> None,
      Some(salt) -> match scram_attribute(server_first, "i") {
        None -> None,
        Some(count) -> match base64_decode(salt) {
          Err(_) -> None,
          Ok(bytes) -> match nat_text(count) {
            None -> None,
            Some(iterations) -> Some({ nonce: nonce, salt: bytes, iterations: iterations }),
          },
        },
      },
    },
  }

// The two things the keys are for: the reply that carries the proof, and the signature the
// server is about to prove itself with.
pub type Proof = { reply: String, expected: Bytes }

// What both sides sign: the client's bare message, the server's first message, and the final
// message without its proof, joined by commas.
pub fn scram_final(
  password: String,
  first_bare: String,
  server_first: String,
  challenge: Challenge,
) -> Proof / {abort.raise} = {
  let without_proof = "c=biws,r=" ++ challenge.nonce;
  let signed = first_bare ++ "," ++ server_first ++ "," ++ without_proof;
  let salted = pbkdf2_sha256(bytes_of_string(password), challenge.salt, challenge.iterations);
  let client_key = hmac_sha256(salted, b"Client Key");
  let signature = hmac_sha256(sha256(client_key), bytes_of_string(signed));
  {
    reply: without_proof ++ ",p=" ++ base64_encode(xor(client_key, signature)),
    expected: hmac_sha256(hmac_sha256(salted, b"Server Key"), bytes_of_string(signed)),
  }
}

// `v=` out of the server's last message, checked against what the keys said it would be.
pub fn scram_verify(server_final: String, expected: Bytes) -> Bool / {abort.raise} =
  match scram_attribute(server_final, "v") {
    None -> false,
    Some(text) -> match base64_decode(text) { Err(_) -> false, Ok(got) -> got == expected },
  }

// The bytes after an authentication code, as the text a SASL step carries.
fn auth_text(message: Message) -> Option<String> / {abort.raise} =
  match auth_body(message) { None -> None, Some(bytes) -> Some(string_of_bytes(bytes)) }

// The mechanisms an `AuthenticationSASL` offers: cstrings until an empty one.
fn mechanisms(message: Message) -> List<String> / {abort.raise} =
  match auth_body(message) { None -> [], Some(bytes) -> names_from(bytes, 0, [], bytes_len(bytes)) }

// `left` as in `fields_of`: a name that goes on is a byte and its end at least.
fn names_from(b: Bytes, at: Int, acc: List<String>, left: Int) -> List<String> / {abort.raise} =
  if at >= bytes_len(b) { acc } else {
    match read_cstring(b, at) {
      None -> acc,
      Some(name) -> if string_len(name.text) == 0 { acc }
      else if left <= 0 { panic("more names than bytes") }
      else { names_from(b, name.next, push(acc, name.text), left - 1) },
    }
  }

fn offers_scram(message: Message) -> Bool / {abort.raise} =
  fold(mechanisms(message), false, |acc: Bool, name: String| acc || name == "SCRAM-SHA-256")

// The client's first message: the mechanism, then the length-prefixed first message.
fn scram_begin<[l]>(
  s: Session,
  password: Option<String>,
  nonce: String,
  client: Client,
  acc: Greeting,
  message: Message,
) -> Result<Session, ClientError> / {net.send[l], net.recv[l], abort.raise} =
  match password {
    None -> Err(Refused(no_password(s.user, "a password"))),
    Some(_) -> if !offers_scram(message) {
      Err(Unexpected("the server offers no SCRAM-SHA-256 mechanism"))
    } else {
      let first_bare = scram_first_bare(s.user, nonce);
      let raw = bytes_of_string(scram_first(s.user, nonce));
      let payload = bytes_concat_all([cstring("SCRAM-SHA-256"), i32_be(bytes_len(raw)), raw]);
      if !send_all[l](s.conn, bytes_concat(byte_of_int(112), counted(payload)), client.write_ms) {
        Err(NotSent)
      } else {
        greet[l](s, password, nonce, client, {
          ..acc,
          sasl: { first_bare: first_bare, expected: None },
        })
      }
    },
  }

// The client's last message: the proof, and nothing else in the frame.
fn scram_continue<[l]>(
  s: Session,
  password: Option<String>,
  nonce: String,
  client: Client,
  acc: Greeting,
  message: Message,
) -> Result<Session, ClientError> / {net.send[l], net.recv[l], abort.raise} =
  match password {
    None -> Err(Refused(no_password(s.user, "a password"))),
    Some(secret) -> match auth_text(message) {
      None -> Err(Unexpected("a SASL continue that is not text")),
      Some(server_first) -> match scram_challenge(server_first) {
        None -> Err(Unexpected("a SASL continue this client cannot read: " ++ server_first)),
        Some(challenge) -> {
          let proof = scram_final(secret, acc.sasl.first_bare, server_first, challenge);
          let raw = bytes_of_string(proof.reply);
          if !send_all[l](s.conn, bytes_concat(byte_of_int(112), counted(raw)), client.write_ms) {
            Err(NotSent)
          } else {
            greet[l](s, password, nonce, client, {
              ..acc,
              sasl: { first_bare: acc.sasl.first_bare, expected: Some(proof.expected) },
            })
          }
        },
      },
    },
  }

// --- Queries --------------------------------------------------------------------

pub type Answer = { columns: List<Column>, rows: List<List<Option<Bytes>>>, tag: String }

pub type Reply = { session: Session, answer: Answer }

// The simple query protocol: one statement, no parameters.
pub fn simple_query<[l]>(
  s: Session,
  sql: String,
  client: Client,
) -> Result<Reply, ClientError> / {net.send[l], net.recv[l], abort.raise} =
  if !send_all[l](s.conn, query(sql), client.write_ms) { Err(NotSent) }
  else { gather[l](s, client, nothing()) }

// The extended query protocol, every parameter and every result in text format, so a parameter
// is the text the server would have printed. The statement and the portal are unnamed, which is
// what makes this one exchange at a time.
pub fn extended_query<[l]>(
  s: Session,
  sql: String,
  params: List<Option<String>>,
  client: Client,
) -> Result<Reply, ClientError> / {net.send[l], net.recv[l], abort.raise} =
  if !send_all[l](
      s.conn,
      bytes_concat_all([
        parse("", sql, []),
        bind("", "", params),
        describe(false, ""),
        execute("", 0),
        sync(),
      ]),
      client.write_ms,
    ) { Err(NotSent) }
  else { gather[l](s, client, nothing()) }

type Reading = {
  columns: List<Column>,
  rows: List<List<Option<Bytes>>>,
  tag: String,
  refused: Option<Server>,
}

fn nothing() -> Reading = { columns: [], rows: [], tag: "", refused: None }

// Everything a query answers, up to the `ReadyForQuery` that ends it. A refusal is carried to
// that point rather than raised where it arrives, so the connection is left usable; a server that
// hangs up after its refusal instead, as a `FATAL` one does, is answered with that refusal.
fn gather<[l]>(
  s: Session,
  client: Client,
  acc: Reading,
) -> Result<Reply, ClientError> / {net.recv[l], abort.raise} =
  match read_message[l](s.conn, s.buffer, client.read_ms) {
    Err(e) -> match acc.refused { Some(server) -> Err(Refused(server)), None -> Err(e) },
    Ok(got) -> {
      let m = got.message;
      let rest: Session = { ..s, buffer: got.rest };
      match m.kind {
        RowDescription ->
          gather[l](rest, client, {
            ..acc,
            columns: match row_description(m) { Some(c) -> c, None -> acc.columns },
          }),
        DataRow ->
          gather[l](rest, client, {
            ..acc,
            rows: concat(acc.rows, [match data_row(m) { Some(r) -> r, None -> [] }]),
          }),
        CommandComplete ->
          gather[l](rest, client, {
            ..acc,
            tag: match command_tag(m) { Some(t) -> t, None -> acc.tag },
          }),
        ErrorResponse -> gather[l](rest, client, { ..acc, refused: Some(server_of(m)) }),
        NoticeResponse -> gather[l](rest, client, acc),
        ReadyForQuery -> {
          let ready = { ..rest, status: status_after(m) };
          match acc.refused {
            Some(server) -> Err(Rejected(ready, server)),
            None ->
              Ok({
                session: ready,
                answer: { columns: acc.columns, rows: acc.rows, tag: acc.tag },
              }),
          }
        },
        _ -> gather[l](rest, client, acc),
      }
    },
  }

// The connection is done; the server expects nothing more.
pub fn finish<[l]>(s: Session, client: Client) -> Unit / {net.send[l], net.close[l], abort.raise} = {
  send_all[l](s.conn, terminate(), client.write_ms);
  net.close[l](s.conn)
}

// --- Tests --------------------------------------------------------------------

test "a start-up message is a length, the version, then the parameters" {
  let frame = startup("me", "db", []);
  assert_eq(u32_be_at(frame, 0), Some(29));
  assert_eq(u32_be_at(frame, 4), Some(196608));
  assert_eq(slice_at(frame, 8, 5), Some(b"user\x00"));
  assert_eq(slice_at(frame, 13, 3), Some(b"me\x00"));
  assert_eq(slice_at(frame, 16, 9), Some(b"database\x00"));
  assert_eq(bytes_at(frame, bytes_len(frame) - 1), 0)
}

test "a run-time setting rides the start-up message as one more name and value, in order" {
  let plain = startup("me", "db", []);
  let told = startup("me", "db", [
    { name: "statement_timeout", value: "250" },
    { name: "application_name", value: "desk" },
  ]);
  let settings = b"statement_timeout\x00250\x00application_name\x00desk\x00";
  assert_eq(u32_be_at(told, 0), Some(29 + bytes_len(settings)));
  assert_eq(slice_at(told, 28, bytes_len(settings)), Some(settings));
  assert_eq(bytes_slice(told, 4, 28), bytes_slice(plain, 4, 28));
  assert_eq(bytes_at(told, bytes_len(told) - 1), 0)
}

test "an ssl request is the magic the protocol reserves" {
  assert_eq(ssl_request(), bytes_concat(u32_be(8), u32_be(80877103)))
}

test "a simple query is a kind byte, a length and the text" {
  assert_eq(query("select 1"), bytes_concat_all([b"Q", u32_be(13), b"select 1", b"\x00"]))
}

test "a bind carries its values as text, with -1 for null" {
  let frame = bind("", "", [Some("a"), None]);
  // 'B', length, portal, statement, no formats, two values, no result formats.
  let body = bytes_concat_all([
    b"\x00",
    b"\x00",
    u16_be(0),
    u16_be(2),
    i32_be(1),
    b"a",
    i32_be(-1),
    u16_be(0),
  ]);
  assert_eq(frame, bytes_concat_all([b"B", u32_be(bytes_len(body) + 4), body]))
}

test "a buffer reads into whole frames and leaves the rest" {
  let one = bytes_concat_all([byte_of_int(90), u32_be(5), b"I"]);
  let two = bytes_concat_all([byte_of_int(67), u32_be(13), b"SELECT 1\x00"]);
  let whole = bytes_concat_all([one, two]);
  let frames = read(whole);
  assert_eq(len(frames.done), 2);
  assert_eq(frames.rest, b"");
  assert_eq(frames.done, [
    { kind: ReadyForQuery, body: b"I" },
    { kind: CommandComplete, body: b"SELECT 1\x00" },
  ]);
  // A prefix of the second frame waits rather than half-reading it.
  let partial = bytes_concat(one, bytes_slice(two, 0, 6));
  let waiting = read(partial);
  assert_eq(len(waiting.done), 1);
  assert_eq(waiting.rest, bytes_slice(two, 0, 6))
}

test "a frame with a length shorter than its own header is not a frame" {
  let frames = read(bytes_concat_all([byte_of_int(90), u32_be(3), b"I"]));
  assert_eq(len(frames.done), 0);
  assert_eq(frames.rest, bytes_concat_all([byte_of_int(90), u32_be(3), b"I"]))
}

test "an unnamed message keeps its byte" {
  let frames = read(bytes_concat_all([byte_of_int(87), u32_be(4)]));
  assert_eq(frames.done, [{ kind: Other(87), body: b"" }]);
  assert_eq(backend_name(Other(87)), "Other(87)")
}

test "authentication says which answer it wants" {
  let ok = { kind: Authentication, body: bytes_concat(u32_be(0), b"") };
  assert_eq(auth_code(ok), Some(0));
  assert_eq(auth_name(0), "AuthenticationOk");
  let sasl = { kind: Authentication, body: bytes_concat(u32_be(10), b"SCRAM-SHA-256\x00") };
  assert_eq(auth_code(sasl), Some(10));
  assert_eq(auth_body(sasl), Some(b"SCRAM-SHA-256\x00"));
  assert_eq(auth_name(5), "AuthenticationMD5Password");
  assert_eq(auth_name(99), "Authentication(99)")
}

test "a ready-for-query says which state the transaction is in" {
  assert_eq(ready_status({ kind: ReadyForQuery, body: b"I" }), Some(73));
  assert_eq(status_of(73), Idle);
  assert_eq(status_of(69), FailedTransaction);
  assert_eq(status_name(status_of(84)), "in transaction");
  assert_eq(ready_status({ kind: ReadyForQuery, body: b"" }), None)
}

test "a data row is its columns, with None for a null" {
  let body = bytes_concat_all([u16_be(2), i32_be(3), b"abc", i32_be(-1)]);
  assert_eq(data_row({ kind: DataRow, body: body }), Some([Some(b"abc"), None]));
  // A column claiming more bytes than the body holds is not a row.
  let short = bytes_concat_all([u16_be(1), i32_be(9), b"abc"]);
  assert_eq(data_row({ kind: DataRow, body: short }), None)
}

test "a row description names its columns and their types" {
  let body = bytes_concat_all([
    u16_be(1),
    b"sku\x00",
    u32_be(16385),
    u16_be(1),
    u32_be(25),
    u16_be(-1),
    i32_be(-1),
    u16_be(0),
  ]);
  assert_eq(
    row_description({ kind: RowDescription, body: body }),
    Some([{ name: "sku", ty: 25, format: 0 }]),
  );
  // An empty description is the empty list, not a refusal.
  assert_eq(row_description({ kind: RowDescription, body: u16_be(0) }), Some([]))
}

test "a diagnostic is a list of fields, and one is found by its code" {
  let body = bytes_concat_all([b"SERROR\x00", b"C42P01\x00", b"Mno such table\x00", b"\x00"]);
  let m = { kind: ErrorResponse, body: body };
  assert_eq(diagnostic_fields(m), [
    { code: 83, text: "ERROR" },
    { code: 67, text: "42P01" },
    { code: 77, text: "no such table" },
  ]);
  assert_eq(field_of(m, 67), Some("42P01"));
  assert_eq(field_of(m, 90), None);
  assert_eq(diagnostic_fields({ kind: ErrorResponse, body: b"\x00" }), [])
}

test "a command tag and a parameter status read back" {
  assert_eq(command_tag({ kind: CommandComplete, body: b"SELECT 3\x00" }), Some("SELECT 3"));
  assert_eq(command_tag({ kind: CommandComplete, body: b"" }), None);
  assert_eq(
    parameter_status({ kind: ParameterStatus, body: b"server_version\x00\x31\x36\x00" }),
    Some({ name: "server_version", value: "16" }),
  );
  assert_eq(
    parameter_types({
      kind: ParameterDescription,
      body: bytes_concat_all([u16_be(2), u32_be(23), u32_be(25)]),
    }),
    Some([23, 25]),
  )
}

test "a back end key is the two words a cancel needs" {
  assert_eq(
    backend_key({ kind: BackendKeyData, body: bytes_concat(u32_be(4321), u32_be(8765)) }),
    Some({ pid: 4321, secret: 8765 }),
  );
  assert_eq(backend_key({ kind: BackendKeyData, body: b"abc" }), None)
}

// RFC 7677's worked example, in full: its nonce, salt, iteration count, client proof and
// server signature. Anything wrong in the ladder changes the proof.
test "scram, against the example RFC 7677 works out" {
  let first_bare = scram_first_bare("user", "rOprNGfwEbeRWgbNEkqO");
  assert_eq(first_bare, "n=user,r=rOprNGfwEbeRWgbNEkqO");
  let server_first = "r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,s=W22ZaJ0SNY7soEsUEjb6gQ==,i=4096";
  match scram_challenge(server_first) {
    None -> panic("the example's challenge does not read"),
    Some(challenge) -> {
      assert_eq(challenge.iterations, 4096);
      assert_eq(bytes_len(challenge.salt), 16);
      let proof = scram_final("pencil", first_bare, server_first, challenge);
      assert_eq(
        proof.reply,
        "c=biws,r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,p=dHzbZapWIk4jUhN+Ute9ytag9zjfMHgsqmmiz7AndVQ=",
      );
      assert(scram_verify("v=6rriTRBi23WpRR/wtup+mMhUZUn/dB5nLTJRsjl95G4=", proof.expected));
      assert(!scram_verify("v=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=", proof.expected));
      assert(!scram_verify("e=other", proof.expected))
    },
  }
}

test "a scram user name escapes what separates fields" {
  assert_eq(scram_first_bare("a=b,c", "n"), "n=a=3Db=2Cc,r=n");
  assert_eq(scram_first("user", "n1"), "n,,n=user,r=n1")
}

test "a challenge that is not one is refused rather than defaulted" {
  assert_eq(scram_challenge("r=abc,s=!!,i=1"), None);
  assert_eq(scram_challenge("r=abc,s=AAAA,i=x"), None);
  assert_eq(scram_challenge("s=AAAA,i=1"), None);
  assert_eq(scram_challenge("r=abc,s=AAAA"), None)
}

test "the mechanisms an authentication message offers" {
  let offered = bytes_concat_all([b"SCRAM-SHA-256\x00", b"PLAIN\x00", b"\x00"]);
  assert(offers_scram({ kind: Authentication, body: bytes_concat(u32_be(10), offered) }));
  let plain = bytes_concat_all([b"PLAIN\x00", b"\x00"]);
  assert(!offers_scram({ kind: Authentication, body: bytes_concat(u32_be(10), plain) }))
}

fn t_frame(kind: Int, body: Bytes) -> Bytes / {abort.raise} =
  bytes_concat(byte_of_int(kind), counted(body))

fn t_session() -> Session =
  { conn: 1, buffer: b"", user: "ply", database: "ply", settings: [], status: Idle }

// Simple queries over a scripted connection: each `recv` takes the next chunk, and once they run
// out the server has hung up.
fn t_queries(
  chunks: List<Bytes>,
  sqls: List<String>,
) -> List<Result<Reply, ClientError>> / {abort.raise} =
  with_cell[inbox](chunks) { inbox ->
    handle {
      fold(
        sqls,
        { session: t_session(), answers: [] },
        |acc: { session: Session, answers: List<Result<Reply, ClientError>> }, sql: String| {
          let answer = simple_query[conn](acc.session, sql, default_client());
          let next = match answer {
            Ok(r) -> r.session,
            Err(Rejected(s, _)) -> s,
            Err(_) -> acc.session,
          };
          { session: next, answers: push(acc.answers, answer) }
        },
      ).answers
    } with {
      net.send[conn](c, payload, timeout_ms) -> Some(bytes_len(payload)),
      net.recv[conn](c, max, timeout_ms) -> {
        let queued = cell_get(inbox);
        cell_set(inbox, match queued { [_, ..rest] -> rest, [] -> [] });
        match queued { [first, ..] -> Some(first), [] -> Some(b"") }
      },
    }
  }

test "a refusal carries its SQLSTATE, the constraint it names and its detail" {
  let body = bytes_concat_all([
    b"SERROR\x00",
    b"C23505\x00",
    b"Mduplicate key value violates unique constraint \"part_pkey\"\x00",
    b"DKey (sku)=(a) already exists.\x00",
    b"npart_pkey\x00",
    b"\x00",
  ]);
  assert_eq(server_of({ kind: ErrorResponse, body: body }), {
    severity: "ERROR",
    code: "23505",
    message: "duplicate key value violates unique constraint \"part_pkey\"",
    detail: "Key (sku)=(a) already exists.",
    constraint: "part_pkey",
  })
}

// A `FATAL` refusal is followed by the server hanging up rather than by `ReadyForQuery`.
test "a refusal that ends the session keeps its SQLSTATE" {
  let fatal = t_frame(
    69,
    b"SFATAL\x00C57P01\x00Mterminating connection due to administrator command\x00\x00",
  );
  match t_queries([fatal], ["select 1"]) {
    [Err(Refused(s))] -> {
      assert_eq(s.code, "57P01");
      assert_eq(s.severity, "FATAL")
    },
    _ -> panic("the refusal was lost to the hang-up"),
  }
}

test "a frame shorter than its own length field is refused rather than waited on" {
  let short = bytes_concat_all([byte_of_int(90), u32_be(3), b"I"]);
  match t_queries([short, short], ["select 1"]) {
    [Err(Unexpected(why))] -> assert(string_contains(why, "less than its own four bytes")),
    _ -> panic("a malformed frame was waited on"),
  }
}

test "a session knows where its transaction stood when the server was last ready" {
  let refused = bytes_concat(
    t_frame(69, b"SERROR\x00C22012\x00Mdivision by zero\x00\x00"),
    t_frame(90, b"E"),
  );
  let rolled = bytes_concat(t_frame(67, b"ROLLBACK\x00"), t_frame(90, b"I"));
  match t_queries([refused, rolled], ["select 1/0", "rollback"]) {
    [Err(Rejected(failed, s)), Ok(r)] -> {
      assert_eq(s.code, "22012");
      assert_eq(failed.status, FailedTransaction);
      assert_eq(r.session.status, Idle);
      assert_eq(r.answer.tag, "ROLLBACK")
    },
    _ -> panic("the two exchanges did not answer a refusal and then a rollback"),
  }
}
