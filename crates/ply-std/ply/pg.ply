//! The postgres wire protocol, as framing and nothing else.
//!
//! Every message the front end sends after start-up is one byte of kind, an `Int32` length that counts
//! itself, and a body; the start-up, SSL and cancel requests are the exceptions, their length first.
//! Values travel as text both ways, so a parameter is the text the server would have printed and a
//! column the text it printed: this layer never decodes a value. `read` takes what a socket returned
//! and answers the whole messages in it and the bytes not yet one, so a short read is not an error.
//!
//! `connect` gets a session to where the server answers a query, authenticating with a clear-text
//! password or SCRAM-SHA-256 (md5 is refused with a message naming it); the client's SCRAM nonce is
//! the caller's to draw, so a run's `random` seed decides it and a test can fix it. The password is
//! a `Secret<Bytes>` throughout: SCRAM derives its proof from it under `std.sasl`, and a clear-text
//! password goes out by `net.send_secret`, its message's kind and length in the clear before it and
//! its NUL after, so no plain value in the program ever holds it. `simple_query` and
//! `extended_query` answer the columns, the rows and the command tag. The SCRAM steps are
//! `std.sasl`'s. A connection is `std.net`'s; which statements to send, what a transaction is and
//! when to retry are `std.db`'s.
//!
//! `connect` secures a connection before its start-up when `Tls` asks: after an `SSLRequest` the
//! server says yes or no, and a no is `Declined` rather than a plaintext session; with direct
//! negotiation the handshake begins at once. The server is verified as `net.start_tls` verifies one,
//! and plaintext the server sent behind its yes is `Injected`. Over TLS, SCRAM is bound to the
//! channel where the server offers it (SCRAM-SHA-256-PLUS), by the `tls-server-end-point` hash of
//! the certificate the server presented (`end_point`), so a proof made for one connection proves
//! nothing on another; where it does not, the client says it would have bound one, so a server
//! whose offer was stripped on the way refuses. An offer the client cannot bind, for a certificate
//! whose signature names no hash, is refused rather than answered unbound.
//!
//! A session that has sent `LISTEN` takes notifications with `await_notification`; one that arrives
//! while a statement is answered is kept in the session for the next wait. A copy moves rows in
//! `COPY`'s text format, `copy_row` writing one and `copy_fields` reading one: `copy_in_begin`,
//! `copy_send` and `copy_in_end` send them, `CopyFail` keeping none, and `copy_out_begin` and
//! `copy_out_take` read them a piece at a time.

import std.bytes
import std.bytes (u16_be, u32_be, i32_be, u16_be_at, u32_be_at, i32_be_at, slice_at, cstring)
import std.ip
import std.net
import std.net (Says, net, send_all)
import std.list (concat, contains)
import std.option (option_all)
import std.hash (sha256, sha384, sha512)
import std.sasl (scram_challenge, scram_final, scram_first, scram_first_bare, scram_verify, Binding,
                 Unbound, Unoffered, ServerEndPoint)

// --- Kinds --------------------------------------------------------------------

/// What the front end sends.
pub type Frontend =
  | Query
  | Parse
  | Bind
  | Describe
  | Execute
  | Sync
  | Close
  | Flush
  | Terminate
  | CopyData
  | CopyDone
  | CopyFail

/// The kind byte a front-end message is sent with.
pub fn frontend_byte(f: Frontend) -> Int =
  match f {
    Query -> 81,
    Parse -> 80,
    Bind -> 66,
    Describe -> 68,
    Execute -> 69,
    Sync -> 83,
    Close -> 67,
    Flush -> 72,
    Terminate -> 88,
    CopyData -> 100,
    CopyDone -> 99,
    CopyFail -> 102,
  }

/// The message's name as the protocol documents it.
pub fn frontend_name(f: Frontend) -> String =
  match f {
    Query -> "Query",
    Parse -> "Parse",
    Bind -> "Bind",
    Describe -> "Describe",
    Execute -> "Execute",
    Sync -> "Sync",
    Close -> "Close",
    Flush -> "Flush",
    Terminate -> "Terminate",
    CopyData -> "CopyData",
    CopyDone -> "CopyDone",
    CopyFail -> "CopyFail",
  }

/// What the back end sends. `Other` keeps the byte, so a message this module does not name is
/// still reportable rather than silently dropped.
pub type Backend =
  | Authentication
  | ParameterStatus
  | BackendKeyData
  | ReadyForQuery
  | RowDescription
  | DataRow
  | CommandComplete
  | ErrorResponse
  | NoticeResponse
  | ParseComplete
  | BindComplete
  | CloseComplete
  | NoData
  | ParameterDescription
  | EmptyQueryResponse
  | NotificationResponse
  | CopyInResponse
  | CopyOutResponse
  /// `CopyData` from the server: a piece of what a copy out sends.
  | CopyChunk
  /// `CopyDone` from the server: a copy out has sent all it will.
  | CopyEnd
  | Other(Int)

/// The kind byte a back-end message arrives with.
pub fn backend_byte(k: Backend) -> Int =
  match k {
    NotificationResponse -> 65,
    CopyInResponse -> 71,
    CopyOutResponse -> 72,
    CopyChunk -> 100,
    CopyEnd -> 99,
    Authentication -> 82,
    ParameterStatus -> 83,
    BackendKeyData -> 75,
    ReadyForQuery -> 90,
    RowDescription -> 84,
    DataRow -> 68,
    CommandComplete -> 67,
    ErrorResponse -> 69,
    NoticeResponse -> 78,
    ParseComplete -> 49,
    BindComplete -> 50,
    CloseComplete -> 51,
    NoData -> 110,
    ParameterDescription -> 116,
    EmptyQueryResponse -> 73,
    Other(b) -> b,
  }

/// The message's name as the protocol documents it.
pub fn backend_name(k: Backend) -> String =
  match k {
    Authentication -> "Authentication",
    ParameterStatus -> "ParameterStatus",
    BackendKeyData -> "BackendKeyData",
    ReadyForQuery -> "ReadyForQuery",
    RowDescription -> "RowDescription",
    DataRow -> "DataRow",
    CommandComplete -> "CommandComplete",
    ErrorResponse -> "ErrorResponse",
    NoticeResponse -> "NoticeResponse",
    ParseComplete -> "ParseComplete",
    BindComplete -> "BindComplete",
    CloseComplete -> "CloseComplete",
    NoData -> "NoData",
    ParameterDescription -> "ParameterDescription",
    EmptyQueryResponse -> "EmptyQueryResponse",
    NotificationResponse -> "NotificationResponse",
    CopyInResponse -> "CopyInResponse",
    CopyOutResponse -> "CopyOutResponse",
    CopyChunk -> "CopyData",
    CopyEnd -> "CopyDone",
    Other(b) -> "Other(" ++ int_to_string(b) ++ ")",
  }

/// The back-end message a kind byte names; `Other` for one this module does not.
pub fn backend_of(b: Int) -> Backend = if b < 75 { backend_low(b) } else { backend_high(b) }

fn backend_low(b: Int) -> Backend =
  if b == 49 { ParseComplete }
  else if b == 50 { BindComplete }
  else if b == 51 { CloseComplete }
  else if b == 65 { NotificationResponse }
  else if b == 67 { CommandComplete }
  else if b == 68 { DataRow }
  else if b == 69 { ErrorResponse }
  else if b == 71 { CopyInResponse }
  else if b == 72 { CopyOutResponse }
  else if b == 73 { EmptyQueryResponse }
  else { Other(b) }

fn backend_high(b: Int) -> Backend =
  if b == 75 { BackendKeyData }
  else if b == 78 { NoticeResponse }
  else if b == 82 { Authentication }
  else if b == 83 { ParameterStatus }
  else if b == 84 { RowDescription }
  else if b == 90 { ReadyForQuery }
  else if b == 99 { CopyEnd }
  else if b == 100 { CopyChunk }
  else if b == 110 { NoData }
  else if b == 116 { ParameterDescription }
  else { Other(b) }

// --- Framing ------------------------------------------------------------------

/// One back-end message: its kind and its body, without the length.
pub type Message = { kind: Backend, body: Bytes }

/// A buffer read into whole messages, with whatever trailing bytes are not yet a whole one.
pub type Frames = { done: List<Message>, rest: Bytes }

/// A length that counts itself, which is what every frame's header is.
fn counted(body: Bytes) -> Bytes = bytes_concat(u32_be(bytes_len(body) + 4), body)

fn frontend(f: Frontend, body: Bytes) -> Bytes / {abort.raise} =
  bytes_concat(byte_of_int(frontend_byte(f)), counted(body))

/// The start-up message: the protocol version, then the parameters, then a zero byte. No kind
/// byte, because the server has no connection to have agreed one on yet. A parameter past `user`
/// and `database` is a run-time setting the server applies to the session before it answers.
pub fn startup(user: String, database: String, parameters: List<Set>) -> Bytes =
  counted(
    bytes_concat_all([
      u32_be(196608),
      cstring("user"),
      cstring(user),
      cstring("database"),
      cstring(database),
      bytes_concat_all(map(parameters, |p: Set| bytes_concat(cstring(p.name), cstring(p.value)))),
      byte_of_int(0),
    ]),
  )

/// The byte a server answers a start-up with to say it will speak TLS; 1234 5679, the magic the
/// protocol reserves so that it can never be mistaken for a supported version.
pub fn ssl_request() -> Bytes = counted(u32_be(80877103))

/// The byte a server answers an SSL request with when it will speak TLS.
pub fn ssl_response() -> Bytes = byte_of_int(83)

/// The request that cancels the statement a session is running, named by its backend key.
pub fn cancel_request(pid: Int, secret: Int) -> Bytes =
  counted(bytes_concat_all([u32_be(80877102), u32_be(pid), u32_be(secret)]))

/// The simple query protocol: one statement, answered with rows and a command tag.
pub fn query(sql: String) -> Bytes / {abort.raise} = frontend(Query, cstring(sql))

/// The extended protocol: `parse` names a statement, `bind` names a portal over it, `execute`
/// runs the portal, and `sync` is what makes the server answer. Text format both ways.
pub fn parse(statement: String, sql: String, param_types: List<Int>) -> Bytes / {abort.raise} =
  frontend(
    Parse,
    bytes_concat_all([
      cstring(statement),
      cstring(sql),
      u16_be(len(param_types)),
      bytes_concat_all(map(param_types, |t: Int| u32_be(t))),
    ]),
  )

fn bound_value(p: Option<String>) -> Bytes =
  match p {
    None -> i32_be(-1),
    Some(text) -> {
      let raw = bytes_of_string(text);
      bytes_concat(i32_be(bytes_len(raw)), raw)
    },
  }

/// `Bind` of a portal over a prepared statement, every parameter in text and `None` for NULL, and every
/// result in text.
pub fn bind(
  portal: String,
  statement: String,
  params: List<Option<String>>,
) -> Bytes / {abort.raise} =
  frontend(
    Bind,
    bytes_concat_all([
      cstring(portal),
      cstring(statement),
      // No parameter format codes and no result format codes: everything is text.
      u16_be(0),
      u16_be(len(params)),
      bytes_concat_all(map(params, |p: Option<String>| bound_value(p))),
      u16_be(0),
    ]),
  )

/// `statement` describes the prepared statement, otherwise the portal.
pub fn describe(statement: Bool, name: String) -> Bytes / {abort.raise} =
  frontend(Describe, bytes_concat(byte_of_int(if statement { 83 } else { 80 }), cstring(name)))

/// `max_rows` of zero is no limit.
pub fn execute(portal: String, max_rows: Int) -> Bytes / {abort.raise} =
  frontend(Execute, bytes_concat(cstring(portal), u32_be(max_rows)))

/// `Sync`, which ends an extended-protocol exchange and makes the server answer.
pub fn sync() -> Bytes / {abort.raise} = frontend(Sync, b"")

/// `Flush`, which asks the server for what it has without ending the exchange.
pub fn flush() -> Bytes / {abort.raise} = frontend(Flush, b"")

/// `Close` of a prepared statement, or of a portal.
pub fn close(statement: Bool, name: String) -> Bytes / {abort.raise} =
  frontend(Close, bytes_concat(byte_of_int(if statement { 83 } else { 80 }), cstring(name)))

/// `Terminate`, after which the server expects nothing more.
pub fn terminate() -> Bytes / {abort.raise} = frontend(Terminate, b"")

/// The first whole frame in `buf`, and the bytes after it. `None` leaves the buffer untouched:
/// a length that is not yet present, or is not a length, is a read that returned short rather
/// than a protocol error.
pub type Partial = { frame: Option<Message>, rest: Bytes }

/// The first whole frame in `buf`, and the bytes after it.
pub fn first(buf: Bytes) -> Partial = {
  let n = bytes_len(buf);
  if n < 5 { { frame: None, rest: buf } } else {
    match u32_be_at(buf, 1) {
      None -> { frame: None, rest: buf },
      Some(len) -> if len < 4 || 1 + len > n { { frame: None, rest: buf } } else {
        {
          frame: Some({ kind: backend_of(bytes_at(buf, 0)), body: bytes_slice(buf, 5, 1 + len) }),
          rest: bytes_slice(buf, 1 + len, n),
        }
      },
    }
  }
}

/// Every whole frame in `buf`, and the bytes that are not yet one.
pub fn read(buf: Bytes) -> Frames / {abort.raise} = read_all(buf, [], bytes_len(buf))

/// A frame is five bytes at least, so the bytes bound the frames: `left`.
fn read_all(buf: Bytes, acc: List<Message>, left: Int) -> Frames / {abort.raise} = {
  let p = first(buf);
  match p.frame {
    None -> { done: acc, rest: p.rest },
    Some(m) -> if left <= 0 { panic("more frames than bytes") }
    else { read_all(p.rest, push(acc, m), left - 1) },
  }
}

// --- Reading a body -----------------------------------------------------------

/// A zero-terminated string starting at `at`, and where the next field begins.
pub type CString = { text: String, next: Int }

/// The zero-terminated string at `at`; `None` when no zero byte ends it.
pub fn read_cstring(b: Bytes, at: Int) -> Option<CString> / {abort.raise} =
  if at < 0 || at >= bytes_len(b) { None } else {
    match bytes_index_of_byte(bytes_slice(b, at, bytes_len(b)), 0) {
      None -> None,
      Some(i) -> Some({ text: string_of_bytes(bytes_slice(b, at, at + i)), next: at + i + 1 }),
    }
  }

/// What the server says before it will talk: 0 is authenticated, 3 wants a clear-text password,
/// 5 wants md5, 10 offers SASL, 11 and 12 are its two SASL steps.
pub fn auth_code(message: Message) -> Option<Int> = u32_be_at(message.body, 0)

/// What an authentication code asks for, as an error names it.
pub fn auth_name(code: Int) -> String =
  if code == 0 { "AuthenticationOk" }
  else if code == 3 { "AuthenticationCleartextPassword" }
  else if code == 5 { "AuthenticationMD5Password" }
  else if code == 10 { "AuthenticationSASL" }
  else if code == 11 { "AuthenticationSASLContinue" }
  else if code == 12 { "AuthenticationSASLFinal" }
  else { "Authentication(" ++ int_to_string(code) ++ ")" }

/// The bytes after the code, which is what a SASL step carries.
pub fn auth_body(message: Message) -> Option<Bytes> =
  slice_at(message.body, 4, bytes_len(message.body) - 4)

/// 'I' idle, 'T' in a transaction, 'E' in a failed transaction, which refuses everything but
/// `ROLLBACK` until it ends.
pub fn ready_status(message: Message) -> Option<Int> =
  if bytes_len(message.body) < 1 { None } else { Some(bytes_at(message.body, 0)) }

/// Where a session's transaction stands, as `ReadyForQuery` says.
pub type Status = | Idle | InTransaction | FailedTransaction | Unknown(Int)

/// The status a `ReadyForQuery` byte names.
pub fn status_of(b: Int) -> Status =
  if b == 73 { Idle }
  else if b == 84 { InTransaction }
  else if b == 69 { FailedTransaction }
  else { Unknown(b) }

/// A status as a refusal names it.
pub fn status_name(s: Status) -> String =
  match s {
    Idle -> "idle",
    InTransaction -> "in transaction",
    FailedTransaction -> "in a failed transaction",
    Unknown(b) -> "unknown(" ++ int_to_string(b) ++ ")",
  }

/// The process and secret a server names a session by, which `cancel_request` needs.
pub type BackendKey = { pid: Int, secret: Int }

/// The key a `BackendKeyData` message carries.
pub fn backend_key(message: Message) -> Option<BackendKey> =
  match u32_be_at(message.body, 0) {
    None -> None,
    Some(pid) -> match u32_be_at(message.body, 4) {
      None -> None,
      Some(secret) -> Some({ pid: pid, secret: secret }),
    },
  }

/// A run-time parameter and its value.
pub type Set = { name: String, value: String }

/// The parameter a `ParameterStatus` message sets.
pub fn parameter_status(message: Message) -> Option<Set> / {abort.raise} =
  match read_cstring(message.body, 0) {
    None -> None,
    Some(name) -> match read_cstring(message.body, name.next) {
      None -> None,
      Some(value) -> Some({ name: name.text, value: value.text }),
    },
  }

/// A column's name, its type's OID and the format its values arrive in: 0 text, 1 binary.
pub type Column = { name: String, ty: Int, format: Int }

/// The columns a `RowDescription` describes.
pub fn row_description(message: Message) -> Option<List<Column>> / {abort.raise} =
  match u16_be_at(message.body, 0) {
    None -> None,
    Some(count) -> columns(message.body, 2, count, []),
  }

fn columns(
  body: Bytes,
  at: Int,
  left: Int,
  acc: List<Column>,
) -> Option<List<Column>> / {abort.raise} =
  if left <= 0 { Some(acc) } else {
    match read_cstring(body, at) {
      None -> None,
      Some(name) -> match u32_be_at(body, name.next + 6) {
        // Name, table OID, attribute number, type OID, type size, type modifier, format.
        None -> None,
        Some(ty) -> match u16_be_at(body, name.next + 16) {
          None -> None,
          Some(format) ->
            columns(
              body,
              name.next + 18,
              left - 1,
              push(acc, { name: name.text, ty: ty, format: format }),
            ),
        },
      },
    }
  }

/// One row, with `None` for a NULL column. The length is a count of bytes, and -1 is NULL.
pub fn data_row(message: Message) -> Option<List<Option<Bytes>>> =
  match u16_be_at(message.body, 0) {
    None -> None,
    Some(count) -> values(message.body, 2, count, []),
  }

fn values(
  body: Bytes,
  at: Int,
  left: Int,
  acc: List<Option<Bytes>>,
) -> Option<List<Option<Bytes>>> =
  if left <= 0 { Some(acc) } else {
    match i32_be_at(body, at) {
      None -> None,
      Some(len) -> if len < 0 { values(body, at + 4, left - 1, push(acc, None)) } else {
        match slice_at(body, at + 4, len) {
          None -> None,
          Some(raw) -> values(body, at + 4 + len, left - 1, push(acc, Some(raw))),
        }
      },
    }
  }

/// The tag a completed command answers with: `SELECT 3`, `INSERT 0 1`, `BEGIN`.
pub fn command_tag(message: Message) -> Option<String> / {abort.raise} =
  match read_cstring(message.body, 0) { None -> None, Some(tag) -> Some(tag.text) }

/// The type OIDs a `ParameterDescription` lists for a statement's parameters.
pub fn parameter_types(message: Message) -> Option<List<Int>> =
  match u16_be_at(message.body, 0) { None -> None, Some(count) -> oids(message.body, 2, count, []) }

fn oids(body: Bytes, at: Int, left: Int, acc: List<Int>) -> Option<List<Int>> =
  if left <= 0 { Some(acc) } else {
    match u32_be_at(body, at) {
      None -> None,
      Some(oid) -> oids(body, at + 4, left - 1, push(acc, oid)),
    }
  }

/// An `ErrorResponse` and a `NoticeResponse` are the same shape: a field type byte, the field's
/// text, and a zero byte at the end. `S` is severity, `C` the SQLSTATE, `M` the message, `D` its
/// detail and `n` the constraint a violation names.
pub type Field = { code: Int, text: String }

/// Every field of an `ErrorResponse` or a `NoticeResponse`.
pub fn diagnostic_fields(message: Message) -> List<Field> / {abort.raise} =
  fields_of(message.body, 0, [], bytes_len(message.body))

/// A field is its code and its text's end at least, so the bytes bound the fields: `left`.
fn fields_of(b: Bytes, at: Int, acc: List<Field>, left: Int) -> List<Field> / {abort.raise} =
  if at >= bytes_len(b) { acc }
  else if bytes_at(b, at) == 0 { acc } else {
    let code = bytes_at(b, at);
    match read_cstring(b, at + 1) {
      None -> acc,
      Some(field) -> if left <= 0 { panic("more fields than bytes") }
      else { fields_of(b, field.next, push(acc, { code: code, text: field.text }), left - 1) },
    }
  }

/// The diagnostic field with this type byte, such as the SQLSTATE under `C`.
pub fn field_of(message: Message, code: Int) -> Option<String> / {abort.raise} =
  fold(diagnostic_fields(message), None, |acc: Option<String>, f: Field|
    if f.code == code { Some(f.text) } else { acc })

// --- A connection ---------------------------------------------------------------

/// How long a client waits, in milliseconds: to connect, for a read, for a write.
pub type Client = { connect_ms: Int, read_ms: Int, write_ms: Int }

/// Five seconds to connect, thirty to read or write.
pub fn default_client() -> Client = { connect_ms: 5000, read_ms: 30000, write_ms: 30000 }

/// The most bytes one `net.recv` asks for.
pub fn read_size() -> Int = 65536

/// What the server said when it refused: the SQLSTATE is what a program branches on, the
/// constraint is the one a violation names, and the rest is what it prints.
pub type Server = {
  severity: String,
  code: String,
  message: String,
  detail: String,
  constraint: String,
}

/// A connection with a server, the bytes read from it that are not yet a whole frame, the
/// parameters it set at start-up, where its transaction stood at the last `ReadyForQuery`, and the
/// notifications that arrived while it was reading something else, oldest first.
pub type Session = {
  conn: Int,
  buffer: Bytes,
  user: String,
  database: String,
  settings: List<Set>,
  status: Status,
  notices: List<Notification>,
}

/// How a connection is secured before its start-up, verifying the server as `name`: not at all;
/// by asking the server first with an `SSLRequest`; or by starting TLS at once, Postgres 17's
/// direct negotiation, which a server before 17 does not understand. Either way the handshake
/// offers the application protocol `postgresql`, and the server's certificate is verified as
/// `net.start_tls` verifies one: against the built-in roots and `--trust`, for the name.
pub type Tls = | NoTls | Requested(String) | Direct(String)

/// Why a client operation has no answer.
pub type ClientError =
  | Unreachable
  | NotSent
  | TimedOut
  | Closed
  /// TLS was asked for and the server answered that it does not speak it. Nothing goes on in
  /// plaintext.
  | Declined
  /// TLS did not complete: the certificate is not trusted for the name, plaintext was waiting
  /// where the handshake was to begin, or the handshake failed.
  | Unsecured(net::Refusal)
  /// The server refused and there is no connection left to use: it refused before it would talk,
  /// or its error ended the session.
  | Refused(Server)
  /// A statement was refused. The connection is still usable — the server is waiting for the
  /// next one — so the session comes back with the refusal for the caller to decide about.
  | Rejected(Session, Server)
  | Unexpected(String)

/// How a refusal reads: the severity, the message, and the SQLSTATE a program branches on.
pub fn server_text(server: Server) -> String =
  server.severity ++ ": " ++ server.message ++ " (" ++ server.code ++ ")"

/// How a client error reads.
pub fn client_error_text(e: ClientError) -> String =
  match e {
    Unreachable -> "the server could not be reached",
    NotSent -> "a message could not be sent",
    TimedOut -> "the server did not answer in time",
    Closed -> "the server closed the connection",
    Declined -> "the server does not speak TLS, and this connection does not go on without it",
    Unsecured(why) -> "TLS did not complete: " ++ net::refusal_message(why),
    Refused(s) -> server_text(s),
    Rejected(_, s) -> server_text(s),
    Unexpected(what) -> what,
  }

/// The value the server set `name` to at start-up.
pub fn setting(s: Session, name: String) -> Option<String> =
  fold(s.settings, None, |acc: Option<String>, set: Set|
    if set.name == name { Some(set.value) } else { acc })

/// A message read, and the buffer after it.
type Received = { message: Message, rest: Bytes }

fn read_message<[l]>(
  c: Int,
  buf: Bytes,
  timeout_ms: Int,
) -> Result<Received, ClientError> / {net.recv[l], abort.raise} =
  match arriving[l](c, buf, timeout_ms) {
    Ok(Arrived(got)) -> Ok(got),
    Ok(Partly(_)) -> Err(TimedOut),
    Err(e) -> Err(e),
  }

/// A message read, or what had arrived of the next one when a read's deadline passed.
type Arrival = | Arrived(Received) | Partly(Bytes)

fn arriving<[l]>(
  c: Int,
  buf: Bytes,
  timeout_ms: Int,
) -> Result<Arrival, ClientError> / {net.recv[l], abort.raise} =
  awaiting[l](c, buf, timeout_ms, 4294967297)

/// A frame is at most 2^32 bytes past its kind, and a round adds a byte at least, so a well-formed
/// one is whole within `room` rounds.
fn awaiting<[l]>(
  c: Int,
  buf: Bytes,
  timeout_ms: Int,
  room: Int,
) -> Result<Arrival, ClientError> / {net.recv[l], abort.raise} = {
  let p = first(buf);
  match p.frame {
    Some(m) -> Ok(Arrived({ message: m, rest: p.rest })),
    None -> if bytes_len(buf) >= 5
        && (match u32_be_at(buf, 1) { Some(n) -> n < 4, None -> false }) {
      Err(Unexpected("a frame whose length is less than its own four bytes"))
    } else if room <= 0 { panic("a frame past its own length") } else {
      match net.recv[l](c, read_size(), timeout_ms) {
        None -> Ok(Partly(buf)),
        Some(bytes) -> if bytes_len(bytes) == 0 { Err(Closed) }
        else { awaiting[l](c, bytes_concat(buf, bytes), timeout_ms, room - 1) },
      }
    },
  }
}

fn server_of(message: Message) -> Server / {abort.raise} =
  {
    severity: field_or(message, 83, "ERROR"),
    code: field_or(message, 67, ""),
    message: field_or(message, 77, ""),
    detail: field_or(message, 68, ""),
    constraint: field_or(message, 110, ""),
  }

/// A `ReadyForQuery` without its status byte says nothing about the transaction.
fn status_after(message: Message) -> Status =
  match ready_status(message) { Some(b) -> status_of(b), None -> Unknown(0) }

fn field_or(m: Message, code: Int, fallback: String) -> String / {abort.raise} =
  match field_of(m, code) { Some(text) -> text, None -> fallback }

/// Open a socket, secure it as `tls` says, and get to where the server will answer a query:
/// start-up, whatever authentication it asks for, its parameters, and `ReadyForQuery`.
pub fn connect<[l]>(
  host: String,
  port: Int,
  tls: Tls,
  user: String,
  database: String,
  parameters: List<Set>,
  password: Option<Secret<Bytes>>,
  nonce: String,
  client: Client,
) -> Result<Session, ClientError> / {net.connect[l], net.start_tls[l], net.peer_certificate[l], net.send[l], net.send_secret[l], net.recv[l], net.close[l], abort.raise, diverges} =
  match net.connect[l](host, port, client.connect_ms) {
    None -> Err(Unreachable),
    Some(conn) -> {
      let opening: Session = {
        conn: conn,
        buffer: b"",
        user: user,
        database: database,
        settings: [],
        status: Idle,
        notices: [],
      };
      let started = match secured[l](conn, tls, client) {
        Err(e) -> Err(e),
        Ok(channel) -> if !send_all[l](conn, startup(user, database, parameters), client.write_ms) {
          Err(NotSent)
        } else { greet[l](opening, password, nonce, client, nothing_said(channel)) },
      };
      match started {
        Ok(s) -> Ok(s),
        Err(e) -> {
          net.close[l](conn);
          Err(e)
        },
      }
    },
  }

/// The application protocol a TLS handshake with a server offers, which Postgres 17 requires of a
/// direct one.
pub fn alpn() -> String = "postgresql"

/// What a connection was secured as: not at all, or by TLS with the certificate the server
/// presented, which SCRAM binds the exchange to.
type Channel = | Plaintext | Secured(Option<Bytes>)

/// `conn` secured as `tls` asks, before anything else is sent on it. The answer to an
/// `SSLRequest` is read a byte at a time, so a byte the server sent after it is still on the socket
/// when the handshake begins, where `net.start_tls` refuses it as `Injected`.
fn secured<[l]>(
  conn: Int,
  tls: Tls,
  client: Client,
) -> Result<Channel, ClientError> / {net.send[l], net.recv[l], net.start_tls[l], net.peer_certificate[l], abort.raise} =
  match tls {
    NoTls -> Ok(Plaintext),
    Direct(name) -> upgraded[l](conn, name, client),
    Requested(name) -> if !send_all[l](conn, ssl_request(), client.write_ms) { Err(NotSent) } else {
      match net.recv[l](conn, 1, client.read_ms) {
        None -> Err(TimedOut),
        Some(answer) -> if bytes_len(answer) == 0 { Err(Closed) }
        else if bytes_at(answer, 0) == 83 { upgraded[l](conn, name, client) }
        else if bytes_at(answer, 0) == 78 { Err(Declined) }
        else { Err(Unexpected("the server answered the SSL request with neither `S` nor `N`")) },
      }
    },
  }

fn upgraded<[l]>(
  conn: Int,
  name: String,
  client: Client,
) -> Result<Channel, ClientError> / {net.start_tls[l], net.peer_certificate[l]} =
  match net.start_tls[l](conn, name, [alpn()], b"", client.connect_ms) {
    Ok(_) -> Ok(Secured(net.peer_certificate[l](conn))),
    Err(why) -> Err(Unsecured(why)),
  }

fn greet<[l]>(
  s: Session,
  password: Option<Secret<Bytes>>,
  nonce: String,
  client: Client,
  acc: Greeting,
) -> Result<Session, ClientError> / {net.send[l], net.send_secret[l], net.recv[l], abort.raise, diverges} =
  match read_message[l](s.conn, s.buffer, client.read_ms) {
    Err(e) -> Err(e),
    Ok(got) -> {
      let m = got.message;
      let rest: Session = { ..s, buffer: got.rest };
      match m.kind {
        Authentication -> match auth_code(m) {
          None -> Err(Unexpected("an authentication message with no code")),
          Some(0) -> greet[l](rest, password, nonce, client, acc),
          Some(3) -> match password {
            None -> Err(Refused(no_password(s.user, "a clear-text password"))),
            Some(secret) -> if !net.send_secret[l](
                rest.conn,
                password_head(secret_len(secret)),
                secret,
                "raw",
                b"\x00",
                client.write_ms,
              ) { Err(NotSent) }
            else { greet[l](rest, password, nonce, client, acc) },
          },
          Some(10) -> scram_begin[l](rest, password, nonce, client, acc, m),
          Some(11) -> scram_continue[l](rest, password, nonce, client, acc, m),
          Some(12) -> match acc.sasl.expected {
            None -> Err(Unexpected("the server proved itself before it was asked to")),
            Some(expected) -> match auth_text(m) {
              None -> Err(Unexpected("a SASL final that is not text")),
              Some(text) -> if !scram_verify(text, expected) {
                Err(Unexpected("the server's proof did not verify"))
              } else { greet[l](rest, password, nonce, client, acc) },
            },
          },
          Some(other) ->
            Err(
              Unexpected(
                "the server asks for " ++ auth_name(other)
                  ++ ", which this client does not answer yet",
              ),
            ),
        },
        ParameterStatus -> match parameter_status(m) {
          Some(set) ->
            greet[l](rest, password, nonce, client, { ..acc, settings: push(acc.settings, set) }),
          None -> greet[l](rest, password, nonce, client, acc),
        },
        BackendKeyData -> greet[l](rest, password, nonce, client, acc),
        NoticeResponse -> greet[l](rest, password, nonce, client, acc),
        ErrorResponse -> Err(Refused(server_of(m))),
        ReadyForQuery -> Ok({ ..rest, settings: acc.settings, status: status_after(m) }),
        _ -> Err(Unexpected("a " ++ backend_name(m.kind) ++ " before the server was ready")),
      }
    },
  }

fn no_password(user: String, what: String) -> Server =
  {
    severity: "ERROR",
    code: "28000",
    message: "the server wants " ++ what ++ " for `" ++ user ++ "`, and none was given",
    detail: "",
    constraint: "",
  }

/// What a `PasswordMessage` holding a password of `length` bytes begins with: its kind and its
/// length, which counts itself, the password and the NUL after it. It is all of the message a
/// server is told in the clear; a SASL step travels in the same frame.
pub fn password_head(length: Int) -> Bytes = bytes_concat(byte_of_int(112), u32_be(length + 5))

// --- SASL -----------------------------------------------------------------------

/// What the greeting has collected: the parameters the server set, where SASL has got to, and
/// the channel it runs over.
type Greeting = { settings: List<Set>, sasl: Sasl, channel: Channel }

/// SCRAM's first message without its header, the binding the header named, and the signature the
/// server is to prove itself with.
type Sasl = { first_bare: String, binding: Binding, expected: Option<Bytes> }

fn nothing_said(channel: Channel) -> Greeting =
  { settings: [], sasl: { first_bare: "", binding: Unbound, expected: None }, channel: channel }

/// The bytes after an authentication code, as the text a SASL step carries.
fn auth_text(message: Message) -> Option<String> / {abort.raise} =
  match auth_body(message) { None -> None, Some(bytes) -> Some(string_of_bytes(bytes)) }

/// The mechanisms an `AuthenticationSASL` offers: cstrings until an empty one.
fn mechanisms(message: Message) -> List<String> / {abort.raise} =
  match auth_body(message) { None -> [], Some(bytes) -> names_from(bytes, 0, [], bytes_len(bytes)) }

/// `left` as in `fields_of`: a name that goes on is a byte and its end at least.
fn names_from(b: Bytes, at: Int, acc: List<String>, left: Int) -> List<String> / {abort.raise} =
  if at >= bytes_len(b) { acc } else {
    match read_cstring(b, at) {
      None -> acc,
      Some(name) -> if string_len(name.text) == 0 { acc }
      else if left <= 0 { panic("more names than bytes") }
      else { names_from(b, name.next, push(acc, name.text), left - 1) },
    }
  }

/// The binding SCRAM runs under over `channel`, given the mechanisms the server offers: none over
/// plaintext; the channel where the server offers SCRAM-SHA-256-PLUS over TLS, and never less; and
/// otherwise none, saying the client would have bound one.
fn bound_as(
  channel: Channel,
  offered: List<String>,
) -> Result<Binding, ClientError> / {abort.raise} = {
  let plain = contains(offered, "SCRAM-SHA-256");
  match channel {
    Plaintext -> if plain { Ok(Unbound) } else { Err(no_scram()) },
    Secured(certificate) -> if !contains(offered, "SCRAM-SHA-256-PLUS") {
      if plain { Ok(Unoffered) } else { Err(no_scram()) }
    } else {
      match certificate {
        None ->
          Err(
            Unexpected(
              "the server offers SCRAM-SHA-256-PLUS and presented no certificate to bind it to",
            ),
          ),
        Some(der) -> match end_point(der) {
          Some(hash) -> Ok(ServerEndPoint(hash)),
          None ->
            Err(
              Unexpected(
                "the server offers SCRAM-SHA-256-PLUS, and its certificate is signed under an algorithm that names no hash to bind it by; this client does not answer the offer unbound",
              ),
            ),
        },
      }
    },
  }
}

fn no_scram() -> ClientError = Unexpected("the server offers no SCRAM-SHA-256 mechanism")

/// The mechanism SCRAM is named under for a binding.
fn scram_mechanism(b: Binding) -> String =
  match b { ServerEndPoint(_) -> "SCRAM-SHA-256-PLUS", _ -> "SCRAM-SHA-256" }

/// The client's first message: the mechanism, then the length-prefixed first message.
fn scram_begin<[l]>(
  s: Session,
  password: Option<Secret<Bytes>>,
  nonce: String,
  client: Client,
  acc: Greeting,
  message: Message,
) -> Result<Session, ClientError> / {net.send[l], net.send_secret[l], net.recv[l], abort.raise, diverges} =
  match password {
    None -> Err(Refused(no_password(s.user, "a password"))),
    Some(_) -> match bound_as(acc.channel, mechanisms(message)) {
      Err(e) -> Err(e),
      Ok(binding) -> {
        let first_bare = scram_first_bare(s.user, nonce);
        let raw = bytes_of_string(scram_first(binding, s.user, nonce));
        let payload = bytes_concat_all([
          cstring(scram_mechanism(binding)),
          i32_be(bytes_len(raw)),
          raw,
        ]);
        if !send_all[l](s.conn, bytes_concat(byte_of_int(112), counted(payload)), client.write_ms) {
          Err(NotSent)
        } else {
          greet[l](s, password, nonce, client, {
            ..acc,
            sasl: { first_bare: first_bare, binding: binding, expected: None },
          })
        }
      },
    },
  }

// --- The channel's binding --------------------------------------------------------

/// A DER element: its tag, and where its content starts and ends.
type Element = { tag: Int, start: Int, end: Int }

/// The DER element at `at` of `b`; `None` for one that is not whole within `b`. A length takes at
/// most four bytes, past which no certificate runs.
fn der_at(b: Bytes, at: Int) -> Option<Element> =
  if at < 0 || at + 2 > bytes_len(b) { None } else {
    let first = bytes_at(b, at + 1);
    let n = if first < 128 { 0 } else { first - 128 };
    if n > 4 || at + 2 + n > bytes_len(b) || first == 128 { None } else {
      let length = if n == 0 { first }
      else { fold(range(0, n), 0, |acc: Int, i: Int| acc * 256 + bytes_at(b, at + 2 + i)) };
      let start = at + 2 + n;
      if start + length > bytes_len(b) { None }
      else { Some({ tag: bytes_at(b, at), start: start, end: start + length }) }
    }
  }

/// The object identifier the DER element at `at` holds, where it holds one.
fn der_oid(b: Bytes, at: Int) -> Option<Bytes> / {abort.raise} =
  match der_at(b, at) {
    Some(e) -> if e.tag == 6 { Some(bytes_slice(b, e.start, e.end)) } else { None },
    None -> None,
  }

/// The hash a signature algorithm's identifier names, SHA-256 where it is MD5 or SHA-1, as RFC
/// 5929 §4.1 has `tls-server-end-point` take it; `params` is where its parameters are, which
/// name RSASSA-PSS's.
fn signing_hash(
  b: Bytes,
  algorithm: Bytes,
  params: Int,
  end: Int,
) -> Option<String> / {abort.raise} = {
  let rsa = b"\x2a\x86\x48\x86\xf7\x0d\x01\x01";
  let ecdsa = b"\x2a\x86\x48\xce\x3d\x04";
  if contains(
      [
        bytes_concat(rsa, b"\x04"),
        bytes_concat(rsa, b"\x05"),
        bytes_concat(rsa, b"\x0b"),
        bytes_concat(ecdsa, b"\x01"),
        bytes_concat(ecdsa, b"\x03\x02"),
      ],
      algorithm,
    ) { Some("SHA-256") }
  else if algorithm == bytes_concat(rsa, b"\x0c") || algorithm == bytes_concat(ecdsa, b"\x03\x03") {
    Some("SHA-384")
  } else if algorithm == bytes_concat(rsa, b"\x0d")
      || algorithm == bytes_concat(ecdsa, b"\x03\x04") { Some("SHA-512") }
  else if algorithm == bytes_concat(rsa, b"\x0a") { pss_hash(b, params, end) }
  else { None }
}

/// The hash RSASSA-PSS's parameters name in their first, explicitly tagged field; SHA-1, and so
/// SHA-256 here, where they name none.
fn pss_hash(b: Bytes, params: Int, end: Int) -> Option<String> / {abort.raise} =
  if params >= end { Some("SHA-256") } else {
    match der_at(b, params) {
      None -> None,
      Some(sequence) -> match der_at(b, sequence.start) {
        None -> Some("SHA-256"),
        Some(first) -> if first.tag != 160 || sequence.start >= sequence.end { Some("SHA-256") }
        else {
          match der_at(b, first.start) {
            None -> None,
            Some(identifier) -> match der_oid(b, identifier.start) {
              None -> None,
              Some(hash) -> {
                let nist = b"\x60\x86\x48\x01\x65\x03\x04\x02";
                if hash == bytes_concat(nist, b"\x01") || hash == b"\x2b\x0e\x03\x02\x1a" {
                  Some("SHA-256")
                } else if hash == bytes_concat(nist, b"\x02") { Some("SHA-384") }
                else if hash == bytes_concat(nist, b"\x03") { Some("SHA-512") }
                else { None }
              },
            },
          }
        },
      },
    }
  }

/// The `tls-server-end-point` data of a DER certificate, RFC 5929 §4.1: the certificate's hash under
/// the hash its signature algorithm names. `None` for a certificate that does not read, and for an
/// algorithm that names no hash, as Ed25519's does not.
pub fn end_point(der: Bytes) -> Option<Bytes> / {abort.raise} =
  match der_at(der, 0) {
    None -> None,
    Some(certificate) -> match der_at(der, certificate.start) {
      None -> None,
      Some(signed) -> match der_at(der, signed.end) {
        None -> None,
        Some(algorithm) -> match der_at(der, algorithm.start) {
          None -> None,
          Some(identifier) -> if identifier.tag != 6 { None } else {
            match signing_hash(
                der,
                bytes_slice(der, identifier.start, identifier.end),
                identifier.end,
                algorithm.end,
              ) {
              Some("SHA-256") -> Some(sha256(der)),
              Some("SHA-384") -> Some(sha384(der)),
              Some("SHA-512") -> Some(sha512(der)),
              _ -> None,
            }
          },
        },
      },
    },
  }

/// The client's last message: the proof, and nothing else in the frame.
fn scram_continue<[l]>(
  s: Session,
  password: Option<Secret<Bytes>>,
  nonce: String,
  client: Client,
  acc: Greeting,
  message: Message,
) -> Result<Session, ClientError> / {net.send[l], net.send_secret[l], net.recv[l], abort.raise, diverges} =
  match password {
    None -> Err(Refused(no_password(s.user, "a password"))),
    Some(secret) -> match auth_text(message) {
      None -> Err(Unexpected("a SASL continue that is not text")),
      Some(server_first) -> match scram_challenge(server_first) {
        None -> Err(Unexpected("a SASL continue this client cannot read: " ++ server_first)),
        Some(challenge) -> match scram_final(
            acc.sasl.binding,
            secret,
            acc.sasl.first_bare,
            server_first,
            challenge,
          ) {
          None -> Err(Unexpected("a SASL continue whose nonce is not the one this client sent")),
          Some(proof) -> {
            let raw = bytes_of_string(proof.reply);
            if !send_all[l](s.conn, bytes_concat(byte_of_int(112), counted(raw)), client.write_ms) {
              Err(NotSent)
            } else {
              greet[l](s, password, nonce, client, {
                ..acc,
                sasl: { ..acc.sasl, expected: Some(proof.expected) },
              })
            }
          },
        },
      },
    },
  }

// --- Queries --------------------------------------------------------------------

/// What a query answered: its columns, its rows with `None` for NULL, and its command tag.
pub type Answer = { columns: List<Column>, rows: List<List<Option<Bytes>>>, tag: String }

/// The session after a query, and its answer.
pub type Reply = { session: Session, answer: Answer }

/// The simple query protocol: one statement, no parameters.
pub fn simple_query<[l]>(
  s: Session,
  sql: String,
  client: Client,
) -> Result<Reply, ClientError> / {net.send[l], net.recv[l], abort.raise, diverges} =
  if !send_all[l](s.conn, query(sql), client.write_ms) { Err(NotSent) }
  else { gather[l](s, client, nothing()) }

/// The extended query protocol, every parameter and every result in text format, so a parameter
/// is the text the server would have printed. The statement and the portal are unnamed, which is
/// what makes this one exchange at a time.
pub fn extended_query<[l]>(
  s: Session,
  sql: String,
  params: List<Option<String>>,
  client: Client,
) -> Result<Reply, ClientError> / {net.send[l], net.recv[l], abort.raise, diverges} =
  if !send_all[l](
      s.conn,
      bytes_concat_all([
        parse("", sql, []),
        bind("", "", params),
        describe(false, ""),
        execute("", 0),
        sync(),
      ]),
      client.write_ms,
    ) { Err(NotSent) }
  else { gather[l](s, client, nothing()) }

/// The columns `sql` would answer, as its `RowDescription` names them, without running it: none for
/// a statement that answers no rows.
pub fn described<[l]>(
  s: Session,
  sql: String,
  client: Client,
) -> Result<Reply, ClientError> / {net.send[l], net.recv[l], abort.raise, diverges} =
  if !send_all[l](
      s.conn,
      bytes_concat_all([parse("", sql, []), describe(true, ""), sync()]),
      client.write_ms,
    ) { Err(NotSent) }
  else { gather[l](s, client, nothing()) }

type Reading = {
  columns: List<Column>,
  rows: List<List<Option<Bytes>>>,
  tag: String,
  refused: Option<Server>,
}

fn nothing() -> Reading = { columns: [], rows: [], tag: "", refused: None }

/// Everything a query answers, up to the `ReadyForQuery` that ends it. A refusal is carried to
/// that point rather than raised where it arrives, so the connection is left usable; a server that
/// hangs up after its refusal instead, as a `FATAL` one does, is answered with that refusal.
fn gather<[l]>(
  s: Session,
  client: Client,
  acc: Reading,
) -> Result<Reply, ClientError> / {net.recv[l], abort.raise, diverges} =
  match read_message[l](s.conn, s.buffer, client.read_ms) {
    Err(e) -> match acc.refused { Some(server) -> Err(Refused(server)), None -> Err(e) },
    Ok(got) -> {
      let m = got.message;
      let rest: Session = { ..s, buffer: got.rest };
      match m.kind {
        RowDescription ->
          gather[l](rest, client, {
            ..acc,
            columns: match row_description(m) { Some(c) -> c, None -> acc.columns },
          }),
        DataRow ->
          gather[l](rest, client, {
            ..acc,
            rows: concat(acc.rows, [match data_row(m) { Some(r) -> r, None -> [] }]),
          }),
        CommandComplete ->
          gather[l](rest, client, {
            ..acc,
            tag: match command_tag(m) { Some(t) -> t, None -> acc.tag },
          }),
        ErrorResponse -> gather[l](rest, client, { ..acc, refused: Some(server_of(m)) }),
        NoticeResponse -> gather[l](rest, client, acc),
        NotificationResponse -> gather[l](kept_notice(rest, m), client, acc),
        ReadyForQuery -> {
          let ready = { ..rest, status: status_after(m) };
          match acc.refused {
            Some(server) -> Err(Rejected(ready, server)),
            None ->
              Ok({
                session: ready,
                answer: { columns: acc.columns, rows: acc.rows, tag: acc.tag },
              }),
          }
        },
        _ -> gather[l](rest, client, acc),
      }
    },
  }

/// The connection is done; the server expects nothing more.
pub fn finish<[l]>(s: Session, client: Client) -> Unit / {net.send[l], net.close[l], abort.raise} = {
  send_all[l](s.conn, terminate(), client.write_ms);
  net.close[l](s.conn)
}

// --- Notifications --------------------------------------------------------------

/// What a `NOTIFY` delivered: the server process of the session that sent it, its channel, and its
/// payload.
pub type Notification = { sender: Int, channel: String, payload: String }

/// The notification a `NotificationResponse` carries.
pub fn notification(message: Message) -> Option<Notification> / {abort.raise} =
  match i32_be_at(message.body, 0) {
    None -> None,
    Some(sender) -> match read_cstring(message.body, 4) {
      None -> None,
      Some(channel) -> match read_cstring(message.body, channel.next) {
        None -> None,
        Some(payload) -> Some({ sender: sender, channel: channel.text, payload: payload.text }),
      },
    },
  }

fn kept_notice(s: Session, message: Message) -> Session / {abort.raise} =
  match notification(message) { Some(n) -> { ..s, notices: push(s.notices, n) }, None -> s }

/// The session after a wait, and the notification it took: `None` when the deadline passed first.
pub type Waited = { session: Session, notice: Option<Notification> }

/// The next notification for a session that has sent `LISTEN`, the oldest it already holds or the
/// next to arrive within `timeout_ms`. A notification arrives between statements, and so does what
/// a server says of a parameter it changed or a notice, which is read past; a refusal there is the
/// server ending the session.
pub fn await_notification<[l]>(
  s: Session,
  timeout_ms: Int,
) -> Result<Waited, ClientError> / {net.recv[l], abort.raise, diverges} =
  match s.notices {
    [oldest, ..later] -> Ok({ session: { ..s, notices: later }, notice: Some(oldest) }),
    [] -> match arriving[l](s.conn, s.buffer, timeout_ms) {
      Err(e) -> Err(e),
      Ok(Partly(held)) -> Ok({ session: { ..s, buffer: held }, notice: None }),
      Ok(Arrived(got)) -> {
        let rest = { ..s, buffer: got.rest };
        let m = got.message;
        match m.kind {
          NotificationResponse -> match notification(m) {
            Some(n) -> Ok({ session: rest, notice: Some(n) }),
            None -> Err(Unexpected("a notification that does not read")),
          },
          ParameterStatus -> await_notification[l](rest, timeout_ms),
          NoticeResponse -> await_notification[l](rest, timeout_ms),
          ErrorResponse -> Err(Refused(server_of(m))),
          _ -> Err(Unexpected("a " ++ backend_name(m.kind) ++ " between statements")),
        }
      },
    },
  }

// --- Copy -----------------------------------------------------------------------

/// `CopyData`, a piece of what a copy in sends: a row need not end where a piece does.
pub fn copy_data(data: Bytes) -> Bytes / {abort.raise} = frontend(CopyData, data)

/// `CopyDone`, which ends a copy in and asks the server to keep what it was sent.
pub fn copy_done() -> Bytes / {abort.raise} = frontend(CopyDone, b"")

/// `CopyFail`, which ends a copy in and asks the server to keep none of it, saying why.
pub fn copy_fail(why: String) -> Bytes / {abort.raise} = frontend(CopyFail, cstring(why))

/// One row in `COPY`'s text format: the values separated by tabs, `\N` for NULL, and a newline at
/// the end. A backslash, a tab, a newline and a carriage return in a value are written escaped, so
/// a value holds any text.
pub fn copy_row(values: List<Option<String>>) -> Bytes =
  bytes_concat(
    bytes::join(
      map(values, |v: Option<String>|
        match v { None -> b"\\N", Some(text) -> copy_escaped(bytes_of_string(text)) }),
      b"\t",
    ),
    b"\n",
  )

fn copy_escaped(raw: Bytes) -> Bytes =
  bytes_concat_all(
    map(range(0, bytes_len(raw)), |i: Int| {
      let c = bytes_at(raw, i);
      if c == 92 { b"\\\\" }
      else if c == 9 { b"\\t" }
      else if c == 10 { b"\\n" }
      else if c == 13 { b"\\r" }
      else { bytes_slice(raw, i, i + 1) }
    }),
  )

/// The values of one row in `COPY`'s text format, its newline already taken off: `None` for a
/// NULL, and each other value the text the server printed, its escapes read. A backslash that
/// ends the row is not a row.
pub fn copy_fields(line: Bytes) -> Option<List<Option<Bytes>>> / {abort.raise} =
  match copy_split(line, 0, 0, [], bytes_len(line) + 1) {
    None -> None,
    Some(raw) ->
      option_all(
        map(raw, |field: Bytes|
          if field == b"\\N" { Some(None) }
          else { match copy_unescaped(field) { Some(v) -> Some(Some(v)), None -> None } }),
      ),
  }

/// The fields of a line, split at each tab no backslash escapes. `left` bounds the rounds: each
/// takes a byte.
fn copy_split(
  line: Bytes,
  start: Int,
  at: Int,
  acc: List<Bytes>,
  left: Int,
) -> Option<List<Bytes>> / {abort.raise} =
  if left <= 0 { panic("more fields than bytes") }
  else if at >= bytes_len(line) { Some(push(acc, bytes_slice(line, start, at))) } else {
    let c = bytes_at(line, at);
    if c == 92 {
      if at + 1 >= bytes_len(line) { None } else { copy_split(line, start, at + 2, acc, left - 1) }
    } else if c == 9 {
      copy_split(line, at + 1, at + 1, push(acc, bytes_slice(line, start, at)), left - 1)
    } else { copy_split(line, start, at + 1, acc, left - 1) }
  }

/// A field's escapes read: `\b`, `\f`, `\n`, `\r`, `\t` and `\v` the control characters they name,
/// one to three octal digits or `x` and one or two hex digits a byte, and a backslash before
/// anything else that thing.
fn copy_unescaped(field: Bytes) -> Option<Bytes> / {abort.raise} =
  unescaping(field, 0, b"", bytes_len(field) + 1)

fn unescaping(field: Bytes, at: Int, acc: Bytes, left: Int) -> Option<Bytes> / {abort.raise} =
  if left <= 0 { panic("more escapes than bytes") }
  else if at >= bytes_len(field) { Some(acc) } else if bytes_at(field, at) != 92 {
    unescaping(field, at + 1, bytes_concat(acc, bytes_slice(field, at, at + 1)), left - 1)
  } else if at + 1 >= bytes_len(field) { None } else {
    let e = escape_at(field, at + 1);
    unescaping(field, e.next, bytes_concat(acc, e.byte), left - 1)
  }

/// What the escape after a backslash at `at` writes, and where the field goes on.
type Escape = { byte: Bytes, next: Int }

fn escape_at(field: Bytes, at: Int) -> Escape / {abort.raise} = {
  let c = bytes_at(field, at);
  let one = |b: Int| { byte: byte_of_int(b), next: at + 1 };
  if c == 98 { one(8) }
  else if c == 102 { one(12) }
  else if c == 110 { one(10) }
  else if c == 114 { one(13) }
  else if c == 116 { one(9) }
  else if c == 118 { one(11) }
  else if c >= 48 && c <= 55 { digits(field, at, 8, 3) }
  else if c == 120 && at + 1 < bytes_len(field) && bytes::hex_value(bytes_at(field, at + 1)) >= 0 {
    digits(field, at + 1, 16, 2)
  } else { { byte: bytes_slice(field, at, at + 1), next: at + 1 } }
}

/// Up to `most` digits in `radix` from `at`, as one byte.
fn digits(field: Bytes, at: Int, radix: Int, most: Int) -> Escape / {abort.raise} = {
  let taken = fold(
    range(0, most),
    { value: 0, next: at, open: true },
    |acc: { value: Int, next: Int, open: Bool }, i: Int|
      if !acc.open || acc.next >= bytes_len(field) { { ..acc, open: false } } else {
        let d = bytes::digit_value(bytes_at(field, acc.next));
        if d < 0 || d >= radix { { ..acc, open: false } }
        else { { value: acc.value * radix + d, next: acc.next + 1, open: true } }
      },
  );
  { byte: byte_of_int(taken.value & 255), next: taken.next }
}

/// A copy in under way: the session, and how many columns the server takes in each row.
pub type CopyIn = { session: Session, columns: Int }

/// Sends `sql`, a `COPY ... FROM STDIN`, and answers once the server waits for rows. A statement
/// the server refuses leaves the session ready for the next one, as a refused query does.
pub fn copy_in_begin<[l]>(
  s: Session,
  sql: String,
  client: Client,
) -> Result<CopyIn, ClientError> / {net.send[l], net.recv[l], abort.raise, diverges} =
  if !send_all[l](s.conn, query(sql), client.write_ms) { Err(NotSent) }
  else { copy_opened[l](s, client, CopyInResponse) }

/// Reads to the message that opens a copy, or to the refusal and readiness that say it did not.
fn copy_opened<[l]>(
  s: Session,
  client: Client,
  opens: Backend,
) -> Result<CopyIn, ClientError> / {net.recv[l], abort.raise, diverges} =
  match read_message[l](s.conn, s.buffer, client.read_ms) {
    Err(e) -> Err(e),
    Ok(got) -> {
      let m = got.message;
      let rest: Session = { ..s, buffer: got.rest };
      if m.kind == opens {
        match u16_be_at(m.body, 1) {
          Some(n) -> Ok({ session: rest, columns: n }),
          None -> Err(Unexpected("a " ++ backend_name(opens) ++ " with no column count")),
        }
      } else {
        match m.kind {
          ErrorResponse -> match gather[l](rest, client, {
              ..nothing(),
              refused: Some(server_of(m)),
            }) {
            Ok(r) -> Err(Unexpected("a refused copy that answered " ++ r.answer.tag)),
            Err(e) -> Err(e),
          },
          NoticeResponse -> copy_opened[l](rest, client, opens),
          NotificationResponse -> copy_opened[l](kept_notice(rest, m), client, opens),
          _ -> Err(Unexpected("a " ++ backend_name(m.kind) ++ " where a copy was to begin")),
        }
      }
    },
  }

/// Sends a piece of a copy in; the server answers nothing until the copy ends.
pub fn copy_send<[l]>(
  c: CopyIn,
  data: Bytes,
  client: Client,
) -> Result<CopyIn, ClientError> / {net.send[l], abort.raise} =
  if bytes_len(data) == 0 || send_all[l](c.session.conn, copy_data(data), client.write_ms) { Ok(c) }
  else { Err(NotSent) }

/// Ends a copy in. `None` keeps what was sent, and the answer's tag is `COPY n`, the rows the
/// server took; `Some(why)` sends `CopyFail`, the server keeps none of it, and the answer is its
/// refusal (`57014`), with the session ready for the next statement. A row the server could not
/// take is refused here too.
pub fn copy_in_end<[l]>(
  c: CopyIn,
  failure: Option<String>,
  client: Client,
) -> Result<Reply, ClientError> / {net.send[l], net.recv[l], abort.raise, diverges} = {
  let ending = match failure { None -> copy_done(), Some(why) -> copy_fail(why) };
  if !send_all[l](c.session.conn, ending, client.write_ms) { Err(NotSent) }
  else { gather[l](c.session, client, nothing()) }
}

/// Sends `sql`, a `COPY ... TO STDOUT`, and answers once the server has begun to send rows, with
/// how many columns each has.
pub fn copy_out_begin<[l]>(
  s: Session,
  sql: String,
  client: Client,
) -> Result<CopyIn, ClientError> / {net.send[l], net.recv[l], abort.raise, diverges} =
  if !send_all[l](s.conn, query(sql), client.write_ms) { Err(NotSent) }
  else { copy_opened[l](s, client, CopyOutResponse) }

/// The session after a read of a copy out, and the piece read: `None` once the server has sent
/// everything and is ready for the next statement.
pub type Piece = { session: Session, data: Option<Bytes> }

/// The next piece of a copy out. A refusal partway through, as a statement that fails on a row
/// gives, comes back as that refusal with the session ready for the next statement.
pub fn copy_out_take<[l]>(
  s: Session,
  client: Client,
) -> Result<Piece, ClientError> / {net.recv[l], abort.raise, diverges} =
  match read_message[l](s.conn, s.buffer, client.read_ms) {
    Err(e) -> Err(e),
    Ok(got) -> {
      let m = got.message;
      let rest: Session = { ..s, buffer: got.rest };
      match m.kind {
        CopyChunk -> Ok({ session: rest, data: Some(m.body) }),
        CopyEnd -> match gather[l](rest, client, nothing()) {
          Ok(r) -> Ok({ session: r.session, data: None }),
          Err(e) -> Err(e),
        },
        ErrorResponse -> match gather[l](rest, client, {
            ..nothing(),
            refused: Some(server_of(m)),
          }) {
          Ok(r) -> Err(Unexpected("a refused copy that answered " ++ r.answer.tag)),
          Err(e) -> Err(e),
        },
        NoticeResponse -> copy_out_take[l](rest, client),
        NotificationResponse -> copy_out_take[l](kept_notice(rest, m), client),
        _ -> Err(Unexpected("a " ++ backend_name(m.kind) ++ " inside a copy out")),
      }
    },
  }

// --- Tests --------------------------------------------------------------------

test "a start-up message is a length, the version, then the parameters" {
  let frame = startup("me", "db", []);
  assert_eq(u32_be_at(frame, 0), Some(29));
  assert_eq(u32_be_at(frame, 4), Some(196608));
  assert_eq(slice_at(frame, 8, 5), Some(b"user\x00"));
  assert_eq(slice_at(frame, 13, 3), Some(b"me\x00"));
  assert_eq(slice_at(frame, 16, 9), Some(b"database\x00"));
  assert_eq(bytes_at(frame, bytes_len(frame) - 1), 0)
}

test "a run-time setting rides the start-up message as one more name and value, in order" {
  let plain = startup("me", "db", []);
  let told = startup("me", "db", [
    { name: "statement_timeout", value: "250" },
    { name: "application_name", value: "desk" },
  ]);
  let settings = b"statement_timeout\x00250\x00application_name\x00desk\x00";
  assert_eq(u32_be_at(told, 0), Some(29 + bytes_len(settings)));
  assert_eq(slice_at(told, 28, bytes_len(settings)), Some(settings));
  assert_eq(bytes_slice(told, 4, 28), bytes_slice(plain, 4, 28));
  assert_eq(bytes_at(told, bytes_len(told) - 1), 0)
}

test "an ssl request is the magic the protocol reserves" {
  assert_eq(ssl_request(), bytes_concat(u32_be(8), u32_be(80877103)))
}

test "a simple query is a kind byte, a length and the text" {
  assert_eq(query("select 1"), bytes_concat_all([b"Q", u32_be(13), b"select 1", b"\x00"]))
}

test "a bind carries its values as text, with -1 for null" {
  let frame = bind("", "", [Some("a"), None]);
  // 'B', length, portal, statement, no formats, two values, no result formats.
  let body = bytes_concat_all([
    b"\x00",
    b"\x00",
    u16_be(0),
    u16_be(2),
    i32_be(1),
    b"a",
    i32_be(-1),
    u16_be(0),
  ]);
  assert_eq(frame, bytes_concat_all([b"B", u32_be(bytes_len(body) + 4), body]))
}

test "a buffer reads into whole frames and leaves the rest" {
  let one = bytes_concat_all([byte_of_int(90), u32_be(5), b"I"]);
  let two = bytes_concat_all([byte_of_int(67), u32_be(13), b"SELECT 1\x00"]);
  let whole = bytes_concat_all([one, two]);
  let frames = read(whole);
  assert_eq(len(frames.done), 2);
  assert_eq(frames.rest, b"");
  assert_eq(frames.done, [
    { kind: ReadyForQuery, body: b"I" },
    { kind: CommandComplete, body: b"SELECT 1\x00" },
  ]);
  // A prefix of the second frame waits rather than half-reading it.
  let partial = bytes_concat(one, bytes_slice(two, 0, 6));
  let waiting = read(partial);
  assert_eq(len(waiting.done), 1);
  assert_eq(waiting.rest, bytes_slice(two, 0, 6))
}

test "a frame with a length shorter than its own header is not a frame" {
  let frames = read(bytes_concat_all([byte_of_int(90), u32_be(3), b"I"]));
  assert_eq(len(frames.done), 0);
  assert_eq(frames.rest, bytes_concat_all([byte_of_int(90), u32_be(3), b"I"]))
}

test "an unnamed message keeps its byte" {
  let frames = read(bytes_concat_all([byte_of_int(87), u32_be(4)]));
  assert_eq(frames.done, [{ kind: Other(87), body: b"" }]);
  assert_eq(backend_name(Other(87)), "Other(87)")
}

test "authentication says which answer it wants" {
  let ok = { kind: Authentication, body: bytes_concat(u32_be(0), b"") };
  assert_eq(auth_code(ok), Some(0));
  assert_eq(auth_name(0), "AuthenticationOk");
  let sasl = { kind: Authentication, body: bytes_concat(u32_be(10), b"SCRAM-SHA-256\x00") };
  assert_eq(auth_code(sasl), Some(10));
  assert_eq(auth_body(sasl), Some(b"SCRAM-SHA-256\x00"));
  assert_eq(auth_name(5), "AuthenticationMD5Password");
  assert_eq(auth_name(99), "Authentication(99)")
}

test "a ready-for-query says which state the transaction is in" {
  assert_eq(ready_status({ kind: ReadyForQuery, body: b"I" }), Some(73));
  assert_eq(status_of(73), Idle);
  assert_eq(status_of(69), FailedTransaction);
  assert_eq(status_name(status_of(84)), "in transaction");
  assert_eq(ready_status({ kind: ReadyForQuery, body: b"" }), None)
}

test "a data row is its columns, with None for a null" {
  let body = bytes_concat_all([u16_be(2), i32_be(3), b"abc", i32_be(-1)]);
  assert_eq(data_row({ kind: DataRow, body: body }), Some([Some(b"abc"), None]));
  // A column claiming more bytes than the body holds is not a row.
  let short = bytes_concat_all([u16_be(1), i32_be(9), b"abc"]);
  assert_eq(data_row({ kind: DataRow, body: short }), None)
}

test "a row description names its columns and their types" {
  let body = bytes_concat_all([
    u16_be(1),
    b"sku\x00",
    u32_be(16385),
    u16_be(1),
    u32_be(25),
    u16_be(-1),
    i32_be(-1),
    u16_be(0),
  ]);
  assert_eq(
    row_description({ kind: RowDescription, body: body }),
    Some([{ name: "sku", ty: 25, format: 0 }]),
  );
  // An empty description is the empty list, not a refusal.
  assert_eq(row_description({ kind: RowDescription, body: u16_be(0) }), Some([]))
}

test "a diagnostic is a list of fields, and one is found by its code" {
  let body = bytes_concat_all([b"SERROR\x00", b"C42P01\x00", b"Mno such table\x00", b"\x00"]);
  let m = { kind: ErrorResponse, body: body };
  assert_eq(diagnostic_fields(m), [
    { code: 83, text: "ERROR" },
    { code: 67, text: "42P01" },
    { code: 77, text: "no such table" },
  ]);
  assert_eq(field_of(m, 67), Some("42P01"));
  assert_eq(field_of(m, 90), None);
  assert_eq(diagnostic_fields({ kind: ErrorResponse, body: b"\x00" }), [])
}

test "a command tag and a parameter status read back" {
  assert_eq(command_tag({ kind: CommandComplete, body: b"SELECT 3\x00" }), Some("SELECT 3"));
  assert_eq(command_tag({ kind: CommandComplete, body: b"" }), None);
  assert_eq(
    parameter_status({ kind: ParameterStatus, body: b"server_version\x00\x31\x36\x00" }),
    Some({ name: "server_version", value: "16" }),
  );
  assert_eq(
    parameter_types({
      kind: ParameterDescription,
      body: bytes_concat_all([u16_be(2), u32_be(23), u32_be(25)]),
    }),
    Some([23, 25]),
  )
}

test "a back end key is the two words a cancel needs" {
  assert_eq(
    backend_key({ kind: BackendKeyData, body: bytes_concat(u32_be(4321), u32_be(8765)) }),
    Some({ pid: 4321, secret: 8765 }),
  );
  assert_eq(backend_key({ kind: BackendKeyData, body: b"abc" }), None)
}

test "the mechanisms an authentication message offers" {
  let offered = bytes_concat_all([b"SCRAM-SHA-256\x00", b"PLAIN\x00", b"\x00"]);
  assert_eq(mechanisms({ kind: Authentication, body: bytes_concat(u32_be(10), offered) }), [
    "SCRAM-SHA-256",
    "PLAIN",
  ]);
  let plain = bytes_concat_all([b"PLAIN\x00", b"\x00"]);
  assert_eq(mechanisms({ kind: Authentication, body: bytes_concat(u32_be(10), plain) }), ["PLAIN"]);
  assert_eq(bound_as(Plaintext, ["PLAIN"]), Err(no_scram()))
}

/// A certificate whose signature algorithm is the object identifier `algorithm`, with `params`
/// after it: what `end_point` reads of one, and no more. Its signed part is long enough that it and
/// the whole take a length in two bytes, as a real certificate's do.
fn t_certificate(algorithm: Bytes, params: Bytes) -> Bytes / {abort.raise} = {
  let length = |n: Int|
    if n < 128 { byte_of_int(n) }
    else { bytes_concat_all([byte_of_int(130), byte_of_int(n / 256), byte_of_int(n % 256)]) };
  let element = |tag: Int, content: Bytes|
    bytes_concat_all([byte_of_int(tag), length(bytes_len(content)), content]);
  let subject = fold(range(0, 300), b"", |acc: Bytes, i: Int| bytes_concat(acc, b"s"));
  element(
    48,
    bytes_concat_all([
      element(48, bytes_concat(element(2, b"\x01"), element(4, subject))),
      element(48, bytes_concat(element(6, algorithm), params)),
      element(3, b"\x00\x01"),
    ]),
  )
}

test "a certificate is bound by its hash under the hash its signature names, SHA-256 for MD5 and SHA-1" {
  let rsa = |last: Bytes| bytes_concat(b"\x2a\x86\x48\x86\xf7\x0d\x01\x01", last);
  let ecdsa = |rest: Bytes| bytes_concat(b"\x2a\x86\x48\xce\x3d\x04", rest);
  let bound = |algorithm: Bytes, params: Bytes| {
    let der = t_certificate(algorithm, params);
    (end_point(der), der)
  };
  let sha256_of = |p: (Option<Bytes>, Bytes)| p._0 == Some(sha256(p._1));
  assert(sha256_of(bound(rsa(b"\x0b"), b"\x05\x00")));
  assert(sha256_of(bound(rsa(b"\x05"), b"\x05\x00")));
  assert(sha256_of(bound(rsa(b"\x04"), b"\x05\x00")));
  assert(sha256_of(bound(ecdsa(b"\x03\x02"), b"")));
  assert(sha256_of(bound(ecdsa(b"\x01"), b"")));
  let sha384_rsa = bound(rsa(b"\x0c"), b"\x05\x00");
  assert_eq(sha384_rsa._0, Some(sha384(sha384_rsa._1)));
  let sha512_ecdsa = bound(ecdsa(b"\x03\x04"), b"");
  assert_eq(sha512_ecdsa._0, Some(sha512(sha512_ecdsa._1)));
  // RSASSA-PSS names its hash in its parameters, and SHA-1 by saying nothing.
  let pss_sha384 = bound(
    rsa(b"\x0a"),
    b"\x30\x0f\xa0\x0d\x30\x0b\x06\x09\x60\x86\x48\x01\x65\x03\x04\x02\x02",
  );
  assert_eq(pss_sha384._0, Some(sha384(pss_sha384._1)));
  assert(sha256_of(bound(rsa(b"\x0a"), b"\x30\x00")));
  // Ed25519 names no hash, and a certificate cut short is none.
  assert_eq(bound(b"\x2b\x65\x70", b"")._0, None);
  assert_eq(end_point(b"\x30\x05\x30"), None);
  let whole = t_certificate(rsa(b"\x0b"), b"\x05\x00");
  assert_eq(end_point(bytes_slice(whole, 0, bytes_len(whole) - 1)), None)
}

/// The SCRAM step a client takes over a connection its far end does `script` on, secured as `tls`
/// says, the far end presenting `certificate`.
fn t_scram(
  script: List<net::Step>,
  tls: Tls,
  certificate: Bytes,
) -> String / {abort.raise, diverges} = {
  let server = ip::socket_at(ip::loopback_v4(), 5432);
  let world = net::mem_presenting(
    net::mem_serving(net::mem_empty(), server, [script]),
    "db.example",
    certificate,
  );
  let over = net::on_mem(world, ||
    connect[conn](
      "127.0.0.1",
      5432,
      tls,
      "ply",
      "ply",
      [],
      Some(secret_of_bytes(b"pencil")),
      "n",
      default_client(),
    ));
  match over.value { Ok(_) -> "connected", Err(e) -> client_error_text(e) }
}

fn t_offered(names: List<String>) -> Bytes / {abort.raise} =
  t_frame(82, bytes_concat_all([u32_be(10), bytes_concat_all(map(names, cstring)), b"\x00"]))

fn t_first(mechanism: String, header: String) -> Bytes / {abort.raise} = {
  let raw = bytes_of_string(header ++ "n=ply,r=n");
  t_frame(112, bytes_concat_all([cstring(mechanism), i32_be(bytes_len(raw)), raw]))
}

test "over TLS, SCRAM is bound to the server's certificate where it offers the binding, and says so where not" {
  let begun = startup("ply", "ply", []);
  let refused = t_frame(69, b"SFATAL\x00C28P01\x00Mno\x00\x00");
  let der = t_certificate(b"\x2a\x86\x48\xce\x3d\x04\x03\x02", b"");
  let both = t_offered(["SCRAM-SHA-256-PLUS", "SCRAM-SHA-256"]);
  // The script hears exactly the first message it names, or the run fails there.
  let plus = t_scram(
    [
      net::Upgrades,
      net::Hears(begun),
      Says(both),
      net::Hears(t_first("SCRAM-SHA-256-PLUS", "p=tls-server-end-point,,")),
      Says(refused),
    ],
    Direct("db.example"),
    der,
  );
  assert(string_contains(plus, "28P01"));
  let stripped = t_scram(
    [
      net::Upgrades,
      net::Hears(begun),
      Says(t_offered(["SCRAM-SHA-256"])),
      net::Hears(t_first("SCRAM-SHA-256", "y,,")),
      Says(refused),
    ],
    Direct("db.example"),
    der,
  );
  assert(string_contains(stripped, "28P01"));
  let plain = t_scram(
    [net::Hears(begun), Says(both), net::Hears(t_first("SCRAM-SHA-256", "n,,")), Says(refused)],
    NoTls,
    der,
  );
  assert(string_contains(plain, "28P01"));
  // An offer the client cannot bind is refused, and nothing is said under it.
  let unbindable = t_scram(
    [net::Upgrades, net::Hears(begun), Says(both)],
    Direct("db.example"),
    t_certificate(b"\x2b\x65\x70", b""),
  );
  assert(string_contains(unbindable, "names no hash"))
}

fn t_frame(kind: Int, body: Bytes) -> Bytes / {abort.raise} =
  bytes_concat(byte_of_int(kind), counted(body))

fn t_session(conn: Int) -> Session =
  { conn: conn, buffer: b"", user: "ply", database: "ply", settings: [], status: Idle, notices: [] }

/// Simple queries over a scripted connection: each `recv` takes the next chunk, and once they run
/// out the server has hung up.
fn t_queries(
  chunks: List<Bytes>,
  sqls: List<String>,
) -> List<Result<Reply, ClientError>> / {net::socket.refused, abort.raise, diverges} = {
  let server = ip::socket_at(ip::loopback_v4(), 5432);
  let scripted = net::mem_serving(net::mem_empty(), server, [
    map(chunks, |chunk: Bytes| Says(chunk)),
  ]);
  net::on_mem(scripted, ||
    fold(
      sqls,
      { session: t_session(net::dial_address[conn](server, [], 1000)), answers: [] },
      |acc: { session: Session, answers: List<Result<Reply, ClientError>> }, sql: String| {
        let answer = simple_query[conn](acc.session, sql, default_client());
        let next = match answer {
          Ok(r) -> r.session,
          Err(Rejected(s, _)) -> s,
          Err(_) -> acc.session,
        };
        { session: next, answers: push(acc.answers, answer) }
      },
    ).answers).value
}

test "a refusal carries its SQLSTATE, the constraint it names and its detail" {
  let body = bytes_concat_all([
    b"SERROR\x00",
    b"C23505\x00",
    b"Mduplicate key value violates unique constraint \"part_pkey\"\x00",
    b"DKey (sku)=(a) already exists.\x00",
    b"npart_pkey\x00",
    b"\x00",
  ]);
  assert_eq(server_of({ kind: ErrorResponse, body: body }), {
    severity: "ERROR",
    code: "23505",
    message: "duplicate key value violates unique constraint \"part_pkey\"",
    detail: "Key (sku)=(a) already exists.",
    constraint: "part_pkey",
  })
}

// A `FATAL` refusal is followed by the server hanging up rather than by `ReadyForQuery`.
test "a refusal that ends the session keeps its SQLSTATE" {
  let fatal = t_frame(
    69,
    b"SFATAL\x00C57P01\x00Mterminating connection due to administrator command\x00\x00",
  );
  match t_queries([fatal], ["select 1"]) {
    [Err(Refused(s))] -> {
      assert_eq(s.code, "57P01");
      assert_eq(s.severity, "FATAL")
    },
    _ -> panic("the refusal was lost to the hang-up"),
  }
}

test "a frame shorter than its own length field is refused rather than waited on" {
  let short = bytes_concat_all([byte_of_int(90), u32_be(3), b"I"]);
  match t_queries([short, short], ["select 1"]) {
    [Err(Unexpected(why))] -> assert(string_contains(why, "less than its own four bytes")),
    _ -> panic("a malformed frame was waited on"),
  }
}

test "a session knows where its transaction stood when the server was last ready" {
  let refused = bytes_concat(
    t_frame(69, b"SERROR\x00C22012\x00Mdivision by zero\x00\x00"),
    t_frame(90, b"E"),
  );
  let rolled = bytes_concat(t_frame(67, b"ROLLBACK\x00"), t_frame(90, b"I"));
  match t_queries([refused, rolled], ["select 1/0", "rollback"]) {
    [Err(Rejected(failed, s)), Ok(r)] -> {
      assert_eq(s.code, "22012");
      assert_eq(failed.status, FailedTransaction);
      assert_eq(r.session.status, Idle);
      assert_eq(r.answer.tag, "ROLLBACK")
    },
    _ -> panic("the two exchanges did not answer a refusal and then a rollback"),
  }
}

/// Authentication that needs nothing, and readiness.
fn t_welcome() -> Bytes / {abort.raise} = bytes_concat(t_frame(82, u32_be(0)), t_frame(90, b"I"))

/// What `connect` came to over a server that does `script`: whether it connected or why not, the
/// name the connection was secured as, and what the program sent.
type Connected = { outcome: String, secured: Option<String>, sent: Bytes }

fn t_connect(script: List<net::Step>, tls: Tls) -> Connected / {abort.raise, diverges} = {
  let server = ip::socket_at(ip::loopback_v4(), 5432);
  let over = net::on_mem(net::mem_serving(net::mem_empty(), server, [script]), ||
    connect[conn]("127.0.0.1", 5432, tls, "ply", "ply", [], None, "n", default_client()));
  {
    outcome: match over.value { Ok(_) -> "connected", Err(e) -> client_error_text(e) },
    secured: net::mem_secured(over.net, 1),
    sent: net::mem_sent(over.net, 1),
  }
}

test "an ssl request the server takes secures the connection before the start-up is sent" {
  let begun = startup("ply", "ply", []);
  let c = t_connect(
    [net::Hears(ssl_request()), Says(b"S"), net::Upgrades, net::Hears(begun), Says(t_welcome())],
    Requested("db.example"),
  );
  assert_eq(c.outcome, "connected");
  assert_eq(c.secured, Some("db.example"));
  assert_eq(c.sent, bytes_concat(ssl_request(), begun))
}

test "a server that will not speak TLS is refused, and nothing more is sent in plaintext" {
  let c = t_connect([net::Hears(ssl_request()), Says(b"N")], Requested("db.example"));
  assert_eq(c.outcome, client_error_text(Declined));
  assert_eq(c.secured, None);
  assert_eq(c.sent, ssl_request())
}

test "plaintext waiting behind the server's yes is injected, and the handshake does not begin" {
  let c = t_connect(
    [net::Hears(ssl_request()), Says(b"SR\x00\x00\x00\x08\x00\x00\x00\x00"), net::Upgrades],
    Requested("db.example"),
  );
  assert_eq(c.outcome, client_error_text(Unsecured(net::Injected)));
  assert_eq(c.secured, None);
  assert_eq(c.sent, ssl_request())
}

test "a certificate not trusted for the name ends the connection before the start-up" {
  let c = t_connect(
    [net::Hears(ssl_request()), Says(b"S"), net::Refuses(net::Untrusted)],
    Requested("db.example"),
  );
  assert_eq(c.outcome, client_error_text(Unsecured(net::Untrusted)));
  assert_eq(c.sent, ssl_request())
}

test "direct negotiation begins the handshake first, with no ssl request" {
  let begun = startup("ply", "ply", []);
  let c = t_connect([net::Upgrades, net::Hears(begun), Says(t_welcome())], Direct("db.example"));
  assert_eq(c.outcome, "connected");
  assert_eq(c.secured, Some("db.example"));
  assert_eq(c.sent, begun);
  let plain = t_connect([net::Hears(begun), Says(t_welcome())], NoTls);
  assert_eq(plain.outcome, "connected");
  assert_eq(plain.secured, None)
}

/// What `connect` with `password` came to over a server that does `script`, the bytes the program
/// sent in the clear, and how many it sent sealed.
fn t_authenticated(
  script: List<net::Step>,
  password: Option<Secret<Bytes>>,
) -> { outcome: String, sent: Bytes, sealed: Int } / {abort.raise, diverges} = {
  let server = ip::socket_at(ip::loopback_v4(), 5432);
  let over = net::on_mem(net::mem_serving(net::mem_empty(), server, [script]), ||
    connect[conn]("127.0.0.1", 5432, NoTls, "ply", "ply", [], password, "n", default_client()));
  {
    outcome: match over.value { Ok(_) -> "connected", Err(e) -> client_error_text(e) },
    sent: net::mem_sent(over.net, 1),
    sealed: len(net::mem_sent_secrets(over.net, 1)),
  }
}

test "a clear-text password goes out sealed: its kind and length, the password raw, then its NUL" {
  let begun = startup("ply", "ply", []);
  let asked = t_frame(82, u32_be(3));
  let c = t_authenticated(
    [
      net::Hears(begun),
      Says(asked),
      net::HearsSecret(bytes_concat_all([b"p", u32_be(11), b"pencil\x00"])),
      Says(t_welcome()),
    ],
    Some(secret_of_bytes(b"pencil")),
  );
  assert_eq(c.outcome, "connected");
  // No byte the program sent in the clear holds the password.
  assert_eq(c.sent, begun);
  assert_eq(c.sealed, 1);
  // A server that asks for one where none was given is refused, and nothing more is sent.
  let none = t_authenticated([net::Hears(begun), Says(asked)], None);
  assert_eq(none.outcome, client_error_text(Refused(no_password("ply", "a clear-text password"))));
  assert_eq(none.sent, begun);
  assert_eq(none.sealed, 0)
}

fn t_notify(sender: Int, channel: String, payload: String) -> Bytes / {abort.raise} =
  t_frame(65, bytes_concat_all([u32_be(sender), cstring(channel), cstring(payload)]))

/// The waits of a session that listens, over a connection whose far end does `script`.
fn t_waits(
  script: List<net::Step>,
  waits: Int,
) -> List<Option<Notification>> / {net::socket.refused, abort.raise, diverges} = {
  let server = ip::socket_at(ip::loopback_v4(), 5432);
  net::on_mem(net::mem_serving(net::mem_empty(), server, [script]), || {
    let s = t_session(net::dial_address[conn](server, [], 1000));
    fold(
      range(0, waits),
      { session: s, heard: [] },
      |acc: { session: Session, heard: List<Option<Notification>> }, i: Int|
        match await_notification[conn](acc.session, 50) {
          Ok(w) -> { session: w.session, heard: push(acc.heard, w.notice) },
          Err(e) -> panic(client_error_text(e)),
        },
    ).heard
  }).value
}

test "a notification is read whole, however its bytes arrive, and a deadline loses none of it" {
  let one = t_notify(4242, "orders", "7");
  let two = t_notify(4242, "orders", "");
  let settings = t_frame(83, b"TimeZone\x00UTC\x00");
  assert_eq(
    t_waits(
      [
        Says(bytes_slice(one, 0, 7)),
        net::Stalls,
        Says(bytes_slice(one, 7, bytes_len(one))),
        Says(bytes_concat(settings, two)),
        net::Silent,
      ],
      4,
    ),
    [
      None,
      Some({ sender: 4242, channel: "orders", payload: "7" }),
      Some({ sender: 4242, channel: "orders", payload: "" }),
      None,
    ],
  )
}

test "a notification that arrives while a statement is answered is kept for the next wait" {
  let server = ip::socket_at(ip::loopback_v4(), 5432);
  let answered = bytes_concat_all([
    t_frame(67, b"LISTEN\x00"),
    t_notify(9, "jobs", "early"),
    t_frame(90, b"I"),
  ]);
  let heard = net::on_mem(
    net::mem_serving(net::mem_empty(), server, [
      [net::Hears(query("listen jobs")), Says(answered), net::Silent],
    ]),
    || {
      let s = t_session(net::dial_address[conn](server, [], 1000));
      match simple_query[conn](s, "listen jobs", default_client()) {
        Err(e) -> panic(client_error_text(e)),
        Ok(r) -> match await_notification[conn](r.session, 50) {
          Err(e) -> panic(client_error_text(e)),
          Ok(w) -> w.notice,
        },
      }
    },
  ).value;
  assert_eq(heard, Some({ sender: 9, channel: "jobs", payload: "early" }))
}

test "a row's values are written in COPY's text format, every escape where one is needed" {
  assert_eq(copy_row([Some("a"), None, Some("")]), b"a\t\\N\t\n");
  assert_eq(
    copy_row([Some("tab\there"), Some("line\nbreak\r"), Some("back\\slash")]),
    b"tab\\there\tline\\nbreak\\r\tback\\\\slash\n",
  );
  assert_eq(copy_row([Some("\\N")]), b"\\\\N\n")
}

test "a row in COPY's text format reads back, each escape the server may write read as it means" {
  assert_eq(copy_fields(b"a\t\\N\t"), Some([Some(b"a"), None, Some(b"")]));
  assert_eq(copy_fields(b"\\b\\f\\v\\101\\x41\\q\\\\N"), Some([Some(b"\x08\x0c\x0bAAq\\N")]));
  assert_eq(copy_fields(b"one\\\ttab"), Some([Some(b"one\ttab")]));
  assert_eq(copy_fields(b"cut\\"), None)
}

law "a row written in COPY's text format reads back as the values it was written from"
  forall (values: List<Option<String>>) where len(values) > 0 {
    copy_fields(bytes_slice(copy_row(values), 0, bytes_len(copy_row(values)) - 1))
      == Some(
        map(values, |v: Option<String>|
          match v { Some(t) -> Some(bytes_of_string(t)), None -> None }),
      )
  }

/// One whole exchange of a copy over a scripted server: what the program's calls answered.
fn t_copy<a>(
  script: List<net::Step>,
  go: (Session) -> a / {net.send[conn], net.recv[conn], abort.raise, diverges},
) -> a / {net::socket.refused, abort.raise, diverges} = {
  let server = ip::socket_at(ip::loopback_v4(), 5432);
  net::on_mem(net::mem_serving(net::mem_empty(), server, [script]), ||
    go(t_session(net::dial_address[conn](server, [], 1000)))).value
}

fn t_copy_response(kind: Int, columns: Int) -> Bytes / {abort.raise} =
  t_frame(
    kind,
    bytes_concat_all([
      b"\x00",
      u16_be(columns),
      bytes_concat_all(map(range(0, columns), |i: Int| u16_be(0))),
    ]),
  )

test "a copy in sends its rows as data and is answered with how many the server took" {
  let sql = "copy items (id, name) from stdin";
  let rows = bytes_concat(copy_row([Some("1"), Some("one")]), copy_row([Some("2"), None]));
  let tag = t_copy(
    [
      net::Hears(query(sql)),
      Says(t_copy_response(71, 2)),
      net::Hears(copy_data(rows)),
      net::Hears(copy_done()),
      Says(bytes_concat(t_frame(67, b"COPY 2\x00"), t_frame(90, b"I"))),
    ],
    |s: Session|
      match copy_in_begin[conn](s, sql, default_client()) {
        Err(e) -> client_error_text(e),
        Ok(c) -> {
          assert_eq(c.columns, 2);
          match copy_send[conn](c, rows, default_client()) {
            Err(e) -> client_error_text(e),
            Ok(sent) -> match copy_in_end[conn](sent, None, default_client()) {
              Err(e) -> client_error_text(e),
              Ok(r) -> r.answer.tag,
            },
          }
        },
      },
  );
  assert_eq(tag, "COPY 2")
}

test "a failed copy in is the server's refusal, and the session is left ready" {
  let sql = "copy items (id) from stdin";
  let code = t_copy(
    [
      net::Hears(query(sql)),
      Says(t_copy_response(71, 1)),
      net::Hears(copy_fail("the rows ran out")),
      Says(
        bytes_concat(
          t_frame(69, b"SERROR\x00C57014\x00MCOPY from stdin failed: the rows ran out\x00\x00"),
          t_frame(90, b"I"),
        ),
      ),
    ],
    |s: Session|
      match copy_in_begin[conn](s, sql, default_client()) {
        Err(e) -> client_error_text(e),
        Ok(c) -> match copy_in_end[conn](c, Some("the rows ran out"), default_client()) {
          Err(Rejected(after, server)) -> server.code ++ " " ++ status_name(after.status),
          Err(e) -> client_error_text(e),
          Ok(_) -> "kept",
        },
      },
  );
  assert_eq(code, "57014 idle")
}

test "a copy out answers its pieces, then none once the server is ready again" {
  let sql = "copy (select id from items) to stdout";
  let pieces = t_copy(
    [
      net::Hears(query(sql)),
      Says(
        bytes_concat_all([
          t_copy_response(72, 1),
          t_frame(100, b"1\n"),
          t_frame(100, b"2\n3\n"),
          t_frame(99, b""),
          t_frame(67, b"COPY 3\x00"),
          t_frame(90, b"I"),
        ]),
      ),
    ],
    |s: Session|
      match copy_out_begin[conn](s, sql, default_client()) {
        Err(e) -> [client_error_text(e)],
        Ok(c) ->
          fold(
            range(0, 3),
            { session: c.session, said: [] },
            |acc: { session: Session, said: List<String> }, i: Int|
              match copy_out_take[conn](acc.session, default_client()) {
                Err(e) -> { ..acc, said: push(acc.said, client_error_text(e)) },
                Ok(p) ->
                  {
                    session: p.session,
                    said: push(acc.said, match p.data {
                      Some(d) -> string_of_bytes(d),
                      None -> "end",
                    }),
                  },
              },
          ).said,
      },
  );
  assert_eq(pieces, ["1\n", "2\n3\n", "end"])
}
