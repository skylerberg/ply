//! The properties a module's definitions are held to, each stated once as a `law schema`.
//!
//! A law instantiates one over a module's own definitions and is discharged as the schema's body
//! with those definitions written in place. Every function a schema takes may raise, so a
//! definition that fails on some input still fits, and the input it fails on is a gap in the claim
//! rather than a refusal to state it. Each schema is also the definition its body is, over its
//! parameters and then its binders, which answers whether the claim holds at one point.

/// `decode` reads back every value `encode` wrote.
///
/// One direction only: `decode` may also accept what `encode` never writes.
pub law schema round_trip<a, b>(
  encode: (a) -> b / {abort.raise},
  decode: (b) -> Option<a> / {abort.raise},
)
  forall (x: a) {
    decode(encode(x)) == Some(x)
  }

/// `back` undoes `there`.
///
/// One direction only: `there` need not undo `back`.
pub law schema inverse<a, b>(there: (a) -> b / {abort.raise}, back: (b) -> a / {abort.raise})
  forall (x: a) {
    back(there(x)) == x
  }

/// Applying `f` a second time changes nothing.
pub law schema idempotent<a>(f: (a) -> a / {abort.raise}) forall (x: a) { f(f(x)) == f(x) }

/// `f` and `g` answer alike on every input.
pub law schema agrees<a, b>(f: (a) -> b / {abort.raise}, g: (a) -> b / {abort.raise})
  forall (x: a) {
    f(x) == g(x)
  }

/// `compare` is a total order.
///
/// A value compares `Equal` with itself and with nothing `==` tells apart from it, two values
/// compare one way as they compare the other way round, and what is at most a value that is at most
/// a third is at most the third. A `compare` that reads only part of a value is not one.
pub law schema total_order<a>(compare: (a, a) -> Ordering / {abort.raise})
  forall (x: a, y: a, z: a) {
    compare(x, x) == Equal && (compare(x, y) != Equal || x == y)
      && compare(x, y) == reversed(compare(y, x))
      && (compare(x, y) == Greater || compare(y, z) == Greater || compare(x, z) != Greater)
  }

transparent fn reversed(o: Ordering) -> Ordering =
  match o { Less -> Greater, Equal -> Equal, Greater -> Less }

/// `op` is associative and `unit` is its identity on either side.
pub law schema monoid<a>(op: (a, a) -> a / {abort.raise}, unit: a)
  forall (x: a, y: a, z: a) {
    op(unit, x) == x && op(x, unit) == x && op(op(x, y), z) == op(x, op(y, z))
  }

/// An operation does to a state what the model's does to what `view` shows of it.
///
/// `view` is the abstraction: the claim is about what it shows, so two states it shows alike may
/// differ after `op` only in what it hides.
pub law schema refines<s, m, i>(
  view: (s) -> m / {abort.raise},
  op: (s, i) -> s / {abort.raise},
  model_op: (m, i) -> m / {abort.raise},
)
  forall (state: s, input: i) {
    view(op(state, input)) == model_op(view(state), input)
  }

// --- Tests ------------------------------------------------------------------

fn clamped(n: Int) -> Int = if n < 0 { 0 } else { n }

fn sign_of(text: String) -> Option<Bool> = if text == "-" { Some(true) } else { Some(false) }

fn negative(b: Bool) -> String = if b { "-" } else { "+" }

fn count(xs: List<Bool>) -> Int = len(xs)

law "a sign reads back" = round_trip(negative, sign_of)

law "not twice is the value" = inverse(|b: Bool| !b, |b: Bool| !b)

law "clamping is idempotent" = idempotent(clamped)

law "a clamped value is the larger of it and zero" = agrees(clamped, |n: Int| max(n, 0))

law "the builtin comparison orders booleans" = total_order(|x: Bool, y: Bool| compare(x, y))

law "conjunction is a monoid over true" = monoid(|x: Bool, y: Bool| x && y, true)

law "a pushed list is one longer" =
  refines(count, |xs: List<Bool>, x: Bool| push(xs, x), |n: Int, x: Bool| n + 1)
