//! Parser combinators: a parser is a value, and a bigger one is built from smaller ones.
//!
//! A parser takes the input and a position and answers a `Step` or `None`: a refusal is `None` rather
//! than a diagnostic, and every loop is bounded by the input rather than by a budget. `many` stops
//! when its parser consumes nothing or answers a position past the input, and `sep_by` when a
//! separator and an item together consume nothing, so a parser that can match the empty string still
//! cannot loop and nothing needs a fuel argument. There is no backtracking across a committed choice:
//! `or_else` runs its second parser from the same position as the first, so there is no half-consumed
//! state to unwind.

import std.list (prepend)

/// What a parser reads.
pub type Input = String

/// A position in an `Input`, in characters.
pub type Position = Int

/// What one parse answered: the value and where the input stood after it.
pub type Step<a> = { value: a, at: Position }

/// A parser: the input, a position, and `None` if it does not match there.
pub type Parser<a> = (Input, Position) -> Option<Step<a>> / {abort.raise}

/// The value an input parses to, or `None` if the parser does not consume all of it. A partial parse
/// is not an answer, so a trailing rest is a refusal; `at` is the one that reads a prefix.
pub fn run<a>(parser: Parser<a>, input: Input) -> Option<a> / {abort.raise} =
  match parser(input, 0) {
    None -> None,
    Some(step) -> if step.at == string_len(input) { Some(step.value) } else { None },
  }

/// The first `Step` a parser answers, leaving the rest of the input unread.
pub fn at<a>(
  parser: Parser<a>,
  input: Input,
  position: Position,
) -> Option<Step<a>> / {abort.raise} = parser(input, position)

/// One character for which `ok` answers true.
pub fn satisfy(ok: (String) -> Bool / {abort.raise}) -> Parser<String> =
  |input: Input, position: Position|
    if position < string_len(input) {
      let c = string_slice(input, position, position + 1);
      if ok(c) { Some({ value: c, at: position + 1 }) } else { None }
    } else { None }

/// The one character `c`.
pub fn char(c: String) -> Parser<String> = text(c)

/// The literal `t`, which is `""` matching at every position.
pub fn text(t: String) -> Parser<String> =
  |input: Input, position: Position|
    if position + string_len(t) > string_len(input) { None }
    else if string_slice(input, position, position + string_len(t)) == t {
      Some({ value: t, at: position + string_len(t) })
    } else { None }

/// `parser`, with its value passed through `f`.
pub fn map<a, b>(parser: Parser<a>, f: (a) -> b / {abort.raise}) -> Parser<b> =
  |input: Input, position: Position|
    match parser(input, position) {
      None -> None,
      Some(step) -> Some({ value: f(step.value), at: step.at }),
    }

/// `parser`, then whatever parser its value names, from where `parser` stopped.
pub fn and_then<a, b>(parser: Parser<a>, f: (a) -> Parser<b>) -> Parser<b> =
  |input: Input, position: Position|
    match parser(input, position) { None -> None, Some(step) -> f(step.value)(input, step.at) }

/// `p`, or `q` from the same position when `p` refuses.
pub fn or_else<a>(p: Parser<a>, q: Parser<a>) -> Parser<a> =
  |input: Input, position: Position|
    match p(input, position) { None -> q(input, position), Some(step) -> Some(step) }

/// `parser` any number of times, ending at the first position where it refuses — or where it answers
/// without consuming anything, which is the bound that makes an empty-matching parser safe.
pub fn many<a>(parser: Parser<a>) -> Parser<List<a>> =
  |input: Input, position: Position|
    many_from(parser, input, position, [], string_len(input) - position)

/// `parser` at least once.
pub fn many1<a>(parser: Parser<a>) -> Parser<List<a>> =
  and_then(parser, |first: a| map(many(parser), |rest: List<a>| prepend(first, rest)))

/// `parser`, or nothing without consuming.
pub fn opt<a>(parser: Parser<a>) -> Parser<Option<a>> =
  |input: Input, position: Position|
    match parser(input, position) {
      None -> Some({ value: None, at: position }),
      Some(step) -> Some({ value: Some(step.value), at: step.at }),
    }

/// `parser`, then `sep` between each, so a trailing separator is a refusal rather than a shorter list.
/// Like `many`, it ends where a separator and an item together consume nothing.
pub fn sep_by<a, b>(parser: Parser<a>, sep: Parser<b>) -> Parser<List<a>> =
  |input: Input, position: Position|
    match parser(input, position) {
      None -> Some({ value: [], at: position }),
      Some(first) ->
        separated(parser, sep, input, first.at, [first.value], string_len(input) - first.at),
    }

/// `s`, then `p`, answering `p`'s value: what a delimiter before an item needs.
pub fn after<s, a>(s: Parser<s>, p: Parser<a>) -> Parser<a> = and_then(s, |_: s| p)

/// `p`, then `s`, answering `s`'s value.
pub fn before<a, s>(p: Parser<a>, s: Parser<s>) -> Parser<s> = and_then(p, |_: a| s)

/// One decimal digit, as its text.
pub fn digit() -> Parser<String> = satisfy(|c: String| string_contains("0123456789", c))

/// One or more decimal digits, as their text.
pub fn digits() -> Parser<String> = map(many1(digit()), |ds: List<String>| joined(ds))

/// Zero or more spaces or tabs, as their text.
pub fn spaces() -> Parser<String> =
  map(many(satisfy(|c: String| c == " " || c == "\t")), |cs: List<String>| joined(cs))

/// A non-empty run of characters that are not `stop`.
pub fn word(stop: String) -> Parser<String> =
  map(many1(satisfy(|c: String| !string_contains(stop, c))), |cs: List<String>| joined(cs))

fn joined(xs: List<String>) -> String = fold(xs, "", |acc: String, x: String| acc ++ x)

/// A round goes on only past where the last one stood and no further than the input, so the
/// characters left bound the rounds: `left`.
fn many_from<a>(
  parser: Parser<a>,
  input: Input,
  position: Position,
  acc: List<a>,
  left: Int,
) -> Option<Step<List<a>>> / {abort.raise} =
  match parser(input, position) {
    None -> Some({ value: acc, at: position }),
    Some(step) -> if step.at <= position || step.at > string_len(input) {
      Some({ value: acc, at: position })
    } else if left <= 0 { panic("more rounds than characters") }
    else { many_from(parser, input, step.at, push(acc, step.value), left - 1) },
  }

fn separated<a, b>(
  parser: Parser<a>,
  sep: Parser<b>,
  input: Input,
  position: Position,
  acc: List<a>,
  left: Int,
) -> Option<Step<List<a>>> / {abort.raise} =
  match sep(input, position) {
    None -> Some({ value: acc, at: position }),
    Some(sep_step) -> match parser(input, sep_step.at) {
      None -> None,
      Some(step) -> if step.at <= position || step.at > string_len(input) {
        Some({ value: acc, at: position })
      } else if left <= 0 { panic("more rounds than characters") }
      else { separated(parser, sep, input, step.at, push(acc, step.value), left - 1) },
    },
  }

// --- Tests ------------------------------------------------------------------

fn int_text() -> Parser<Int> =
  map(digits(), |ds: String|
    fold(range(0, string_len(ds)), 0, |acc: Int, i: Int|
      acc * 10 + string_find("0123456789", string_slice(ds, i, i + 1))))

test "a literal consumes exactly what it matches, and `run` wants all of it" {
  assert_eq(run(text("ab"), "ab"), Some("ab"));
  assert_eq(run(text("ab"), "abc"), None);
  assert_eq(run(char("a"), "a"), Some("a"));
  assert_eq(run(char("a"), "b"), None);
  assert_eq(run(text(""), ""), Some(""));
  // `run` wants the whole input; `at` reads a prefix and answers where it stopped.
  assert_eq(at(text("ab"), "abc", 0), Some({ value: "ab", at: 2 }));
  assert_eq(at(text("ab"), "xab", 1), Some({ value: "ab", at: 3 }))
}

test "or_else tries the second from the same position" {
  let p = or_else(text("ab"), text("ac"));
  assert_eq(run(p, "ab"), Some("ab"));
  assert_eq(run(p, "ac"), Some("ac"));
  assert_eq(run(p, "ad"), None);
  // A prefix is a step, so `or_else` answered it and the fully-consuming `run` is what refused.
  assert_eq(at(p, "ac", 2), None);
  assert_eq(at(p, "ab", 0), Some({ value: "ab", at: 2 }))
}

test "many stops at a refusal and at a parser that consumes nothing" {
  assert_eq(run(many(digit()), "123"), Some(["1", "2", "3"]));
  assert_eq(run(many(digit()), ""), Some([]));
  // An empty match would be an infinite loop without the no-progress bound: it stops at the
  // position it began at, having consumed nothing.
  assert_eq(at(many(text("")), "abc", 0), Some({ value: [], at: 0 }));
  assert_eq(run(many(text("")), ""), Some([]));
  assert_eq(run(many1(digit()), ""), None);
  assert_eq(run(map(digits(), |ds: String| string_len(ds)), "12345"), Some(5))
}

test "sep_by refuses a trailing separator, and a sequence reads both sides" {
  let row = sep_by(word(","), char(","));
  assert_eq(run(row, "a,b,c"), Some(["a", "b", "c"]));
  assert_eq(run(row, "a,b,"), None);
  assert_eq(run(row, ""), Some([]));
  // A separator and an item that consume nothing end the list, as they end `many`.
  assert_eq(run(sep_by(opt(char("x")), opt(char(","))), ""), Some([None]));
  assert_eq(at(opt(char("+")), "x", 0), Some({ value: None, at: 0 }));
  assert_eq(run(opt(char("+")), ""), Some(None));
  assert_eq(run(opt(char("+")), "+"), Some(Some("+")));
  let sum = and_then(int_text(), |a: Int| map(after(char(":"), int_text()), |b: Int| a + b));
  assert_eq(run(sum, "12:30"), Some(42));
  assert_eq(run(before(spaces(), text("end")), "   end"), Some("end"))
}
