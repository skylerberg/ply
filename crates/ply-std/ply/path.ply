//! A path's pieces, as text. Nothing here reaches a filesystem: a path is a `String` and every answer
//! is one too, so a walk can be tested without a directory.

/// `dir` and `name` with exactly one separator between them; a root spelled `"."` or `""` adds none.
pub fn join(dir: String, name: String) -> String =
  if dir == "" || dir == "." { name }
  else if string_ends_with(dir, "/") { dir ++ name }
  else { dir ++ "/" ++ name }

/// The last segment; `""` for a path that ends in a separator.
pub fn file_name(path: String) -> String / {abort.raise} = {
  let segments = string_split(path, "/");
  match list_at(segments, len(segments) - 1) { Some(last) -> last, None -> "" }
}

/// The file name with its extension taken off: `a.tar.gz` is `a.tar`. A name with no extension is
/// itself, which is where this differs from `extension` being `Some`.
pub fn stem(path: String) -> String / {abort.raise} =
  match extension(path) {
    None -> file_name(path),
    Some(ext) -> {
      let name = file_name(path);
      string_slice(name, 0, string_len(name) - string_len(ext) - 1)
    },
  }

/// `path` with its extension replaced by `ext`, which is written without the dot. A name with no
/// extension gains one.
pub fn with_extension(path: String, ext: String) -> String / {abort.raise} = {
  let dir = parent(path);
  let renamed = stem(path) ++ "." ++ ext;
  if dir == "." { renamed } else { join(dir, renamed) }
}

/// What follows the last `.` of the file name. A name with no dot has none, and neither has a
/// dotfile: `".gitignore"` is a name, not an extension.
pub fn extension(path: String) -> Option<String> / {abort.raise} = {
  let pieces = string_split(file_name(path), ".");
  if len(pieces) < 2 { None } else {
    match list_at(pieces, 0) {
      Some(first) -> if first == "" { None } else { list_at(pieces, len(pieces) - 1) },
      None -> None,
    }
  }
}

/// The directory holding `path`. A name with no separator is in the working directory, so it
/// answers `"."`; a root holds itself, and answers `"."` too rather than a path above it.
pub fn parent(path: String) -> String / {abort.raise} =
  if path == "/" || path == "" { "." } else {
    let segments = string_split(path, "/");
    if len(segments) < 2 { "." } else {
      let dir = fold(range(0, len(segments) - 1), "", |acc: String, i: Int|
        match list_at(segments, i) {
          Some(seg) -> if i == 0 { seg } else { acc ++ "/" ++ seg },
          None -> acc,
        });
      if dir == "" { "/" } else { dir }
    }
  }

/// `./m.ply` and `m.ply` name one file, so a set keyed on the path holds one of them.
pub fn strip_dot(path: String) -> String / {abort.raise} =
  if string_starts_with(path, "./") { string_slice(path, 2, string_len(path)) } else { path }

/// Whether the path names the root directly: it starts at the separator.
pub fn is_absolute(path: String) -> Bool = string_starts_with(path, "/")

/// The path with duplicate separators folded, `.` segments dropped, and `..` resolved lexically.
/// A `..` past the start of a relative path stays written; at the root there is nothing above.
pub fn normalize(path: String) -> String / {abort.raise} = {
  let absolute = is_absolute(path);
  let segments = fold(string_split(path, "/"), [], |acc: List<String>, seg: String|
    if seg == "" || seg == "." { acc } else if seg == ".." {
      match list_at(acc, len(acc) - 1) {
        Some(last) -> if last == ".." { push(acc, seg) } else { drop_last(acc) },
        None -> if absolute { acc } else { push(acc, seg) },
      }
    } else { push(acc, seg) });
  let body = fold(segments, "", |acc: String, seg: String|
    if acc == "" { seg } else { acc ++ "/" ++ seg });
  let joined = if absolute { "/" ++ body } else { body };
  if joined == "" { if absolute { "/" } else { "." } } else { joined }
}

fn drop_last(xs: List<String>) -> List<String> =
  fold(range(0, len(xs) - 1), [], |acc: List<String>, i: Int|
    match list_at(xs, i) { Some(x) -> push(acc, x), None -> acc })

/// The segments between separators, in order. A leading separator is an empty first segment, so
/// `"/a/b"` is `["", "a", "b"]` and a caller that joins them with `/` gets the path back.
pub fn components(path: String) -> List<String> / {abort.raise} = string_split(path, "/")

/// The segments that name something: none empty and none spelled `.`.
pub fn segments(path: String) -> List<String> / {abort.raise} =
  filter(string_split(path, "/"), |s: String| s != "" && s != ".")

/// `path` against `base`: an absolute path is itself, and a relative one is `base` with the path
/// appended, both normalized afterwards. This is a lexical answer and reads no filesystem, so
/// `..` is resolved by segment rather than by what the directories hold.
pub fn resolve(base: String, path: String) -> String / {abort.raise} =
  if is_absolute(path) { normalize(path) } else { normalize(join(base, path)) }

// --- Tests ------------------------------------------------------------------

test "a join places one separator, and a dot root places none" {
  assert_eq(join("src", "a.ply"), "src/a.ply");
  assert_eq(join("src/", "a.ply"), "src/a.ply");
  assert_eq(join(".", "a.ply"), "a.ply");
  assert_eq(join("", "a.ply"), "a.ply");
  assert_eq(join("a/b", "c/d"), "a/b/c/d")
}

test "the file name is the last segment" {
  assert_eq(file_name("src/a.ply"), "a.ply");
  assert_eq(file_name("a.ply"), "a.ply");
  assert_eq(file_name("src/"), "");
  assert_eq(file_name(""), "")
}

test "an extension follows the last dot of the file name, and a dotfile has none" {
  assert_eq(extension("src/a.ply"), Some("ply"));
  assert_eq(extension("a.tar.gz"), Some("gz"));
  assert_eq(extension("src/README"), None);
  assert_eq(extension(".gitignore"), None);
  // The dot is in a directory, not in the name.
  assert_eq(extension("a.d/README"), None)
}

test "a leading dot-slash is the only thing stripped" {
  assert_eq(strip_dot("./m.ply"), "m.ply");
  assert_eq(strip_dot("m.ply"), "m.ply");
  assert_eq(strip_dot("./a/./b"), "a/./b");
  assert_eq(strip_dot("../m.ply"), "../m.ply");
  assert_eq(strip_dot("."), ".")
}

test "a stem is the file name without its extension, and with_extension replaces it" {
  assert_eq(stem("src/a.ply"), "a");
  assert_eq(stem("a.tar.gz"), "a.tar");
  assert_eq(stem("README"), "README");
  assert_eq(stem(".gitignore"), ".gitignore");
  assert_eq(stem("src/"), "");
  assert_eq(with_extension("src/a.ply", "txt"), "src/a.txt");
  assert_eq(with_extension("a.ply", "txt"), "a.txt");
  assert_eq(with_extension("README", "md"), "README.md");
  // The inverse of `extension` where there is one.
  assert_eq(extension(with_extension("a.ply", "gz")), Some("gz"))
}

test "components are the separators' parts, and resolve is lexical" {
  assert_eq(components("/a/b"), ["", "a", "b"]);
  assert_eq(components("a"), ["a"]);
  assert_eq(resolve("/a", "b"), "/a/b");
  assert_eq(resolve("/a", "/b"), "/b");
  assert_eq(resolve("a", "../b"), "b");
  assert_eq(resolve("/a", "../b"), "/b");
  assert_eq(resolve(".", "a/b"), "a/b")
}

test "normalize folds separators, dots and dot-dots" {
  assert_eq(normalize("a//b/./c"), "a/b/c");
  assert_eq(normalize("./a/b"), "a/b");
  assert_eq(normalize("a/./b"), "a/b");
  assert_eq(normalize("a/b/../c"), "a/c");
  assert_eq(normalize("/a//b"), "/a/b");
  assert_eq(normalize("/a/../b"), "/b");
  // A `..` at the root has nothing above it; one past a relative start stays written.
  assert_eq(normalize("/.."), "/");
  assert_eq(normalize("../a"), "../a");
  assert_eq(normalize("a/../../b"), "../b");
  assert_eq(normalize(""), ".");
  assert_eq(normalize("/"), "/");
  assert_eq(normalize("."), ".")
}

test "absolute paths name the root" {
  assert(is_absolute("/a/b"));
  assert(is_absolute("/"));
  assert(!is_absolute("a/b"));
  assert(!is_absolute("./a"))
}

test "a parent is the directory holding the path, and a name alone is in the working directory" {
  assert_eq(parent("src/m.ply"), "src");
  assert_eq(parent("a/b/c.ply"), "a/b");
  assert_eq(parent("m.ply"), ".");
  assert_eq(parent("/a/b"), "/a");
  assert_eq(parent("/a"), "/");
  // A root holds itself; there is no path above it to name.
  assert_eq(parent("/"), ".");
  assert_eq(parent(""), ".");
  // `join` puts back what `parent` and `file_name` took apart.
  assert_eq(join(parent("src/m.ply"), file_name("src/m.ply")), "src/m.ply")
}

test "segments are what names something, without the empty ones or a dot" {
  assert_eq(segments("a/./b//c/"), ["a", "b", "c"]);
  assert_eq(segments("/abs/x"), ["abs", "x"]);
  assert_eq(segments("."), [])
}
