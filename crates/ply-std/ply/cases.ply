// std.cases — what a test over cases, `test "{c.name}" for c: T in table() { .. }`, is made of: the
// listing that names each case, and the choice of the one a run is entered for.

// What a test ranges over: its cases, in the order a report lists them.
pub type Table<a> = List<a>

// A case as a run knows it: the label its test is reported under, and its value's digest.
pub type Listed = { label: String, digest: Bytes }

// Each case of `table`, in the table's order.
pub fn listed<a | e>(table: List<a>, label: (a) -> String / e) -> List<Listed> / e
  where derivable(hash, a)
= map(table, |c: a| { label: label(c), digest: digest(c) })

// The case whose digest is `wanted`: the one at `at` where the table still holds it there, and
// otherwise wherever it stands now. A table that no longer holds it raises.
pub fn chosen<a>(table: List<a>, at: Int, wanted: Bytes) -> a / {abort.raise}
  where derivable(hash, a)
=
  match list_at(table, at) {
    Some(c) -> if digest(c) == wanted { c } else { moved(table, wanted) },
    None -> moved(table, wanted),
  }

fn moved<a>(table: List<a>, wanted: Bytes) -> a / {abort.raise}
  where derivable(hash, a)
=
  match filter(table, |c: a| digest(c) == wanted) {
    [c, ..] -> c,
    [] -> panic("the table no longer holds this case"),
  }

test "a listing labels each case and digests its value, in the table's order" {
  assert_eq(listed([3, 4], |n: Int| int_to_string(n)), [
    { label: "3", digest: digest(3) },
    { label: "4", digest: digest(4) },
  ]);
  assert_eq(listed([], |n: Int| int_to_string(n)), [])
}

test "a case is chosen by its digest, at its place or wherever the table now holds it" {
  assert_eq(chosen(["a", "b"], 1, digest("b")), "b");
  assert_eq(chosen(["new", "a", "b"], 1, digest("b")), "b");
  assert_eq(chosen(["b"], 4, digest("b")), "b")
}

fn missing() -> Result<String, String> =
  handle { Ok(chosen(["a"], 0, digest("b"))) } with { abort.raise(reason) -> Err(reason) }

test "a case the table no longer holds raises" {
  assert_eq(missing(), Err("the table no longer holds this case"))
}
