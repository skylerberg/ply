// `string` — what a program wants over a `String` and the prelude does not carry.
//
// The prelude has the pieces — `string_len`, `string_slice`, `string_split`, `string_find`,
// `string_contains` — and no whole: no `join`, which three shipped modules were each writing for
// themselves, no `replace`, no trim, no case fold. This is those, and every one is total: a
// `String` is characters, not bytes, so a slice lands on a character boundary by construction, and
// `replace` with an empty needle is the text unchanged rather than a loop.

/// Every part, with `sep` between them and nowhere else.
pub fn join(parts: List<String>, sep: String) -> String =
  match parts {
    [] -> "",
    [first, ..rest] -> fold(rest, first, |acc: String, part: String| acc ++ sep ++ part),
  }

pub fn is_empty(text: String) -> Bool = string_len(text) == 0

/// Every occurrence of `from` as `to`. An empty `from` is the text unchanged: it occurs at every
/// position, and replacing there is not a well-defined answer.
pub fn replace(text: String, from: String, to: String) -> String =
  if string_len(from) == 0 { text } else { join(string_split(text, from), to) }

/// The first occurrence of `from` as `to`, and the rest untouched.
pub fn replace_first(text: String, from: String, to: String) -> String =
  if string_len(from) == 0 { text } else {
    match split_once(text, from) { None -> text, Some(split) -> split.head ++ to ++ split.tail }
  }

/// The text around the first `sep`, split there; `None` if `sep` is not in it.
pub fn split_once(text: String, sep: String) -> Option<{ head: String, tail: String }> =
  if string_contains(text, sep) {
    let at = string_find(text, sep);
    Some({
      head: string_slice(text, 0, at),
      tail: string_slice(text, at + string_len(sep), string_len(text)),
    })
  } else { None }

pub fn trim(text: String) -> String = trim_start(trim_end(text))

pub fn trim_start(text: String) -> String = trim_start_at(text, 0)

pub fn trim_end(text: String) -> String = trim_end_at(text, string_len(text))

/// Every letter folded to lower case; ASCII only, which is what a byte-per-character fold can
/// answer for. Anything else is left as it is.
pub fn to_lower(text: String) -> String = folded(text, lower(), "ABCDEFGHIJKLMNOPQRSTUVWXYZ")

pub fn to_upper(text: String) -> String = folded(text, upper(), "abcdefghijklmnopqrstuvwxyz")

/// `text` repeated `n` times; `n` at or below zero is the empty string.
pub fn repeat(text: String, n: Int) -> String =
  fold(range(0, if n > 0 { n } else { 0 }), "", |acc: String, _: Int| acc ++ text)

/// `text` grown on the left with `fill` until it is `width` characters. An empty `fill` leaves it
/// alone, and a `text` already at least that wide is untouched.
pub fn pad_left(text: String, width: Int, fill: String) -> String =
  if string_len(fill) == 0 || string_len(text) >= width { text }
  else { pad_left(fill ++ text, width, fill) }

/// The same on the right.
pub fn pad_right(text: String, width: Int, fill: String) -> String =
  if string_len(fill) == 0 || string_len(text) >= width { text }
  else { pad_right(text ++ fill, width, fill) }

fn trim_start_at(text: String, at: Int) -> String =
  if at < string_len(text) && is_space(string_slice(text, at, at + 1)) {
    trim_start_at(text, at + 1)
  } else { string_slice(text, at, string_len(text)) }

fn trim_end_at(text: String, at: Int) -> String =
  if at > 0 && is_space(string_slice(text, at - 1, at)) { trim_end_at(text, at - 1) }
  else { string_slice(text, 0, at) }

fn is_space(c: String) -> Bool = string_contains(" \t\n\r", c)

fn folded(text: String, to: String, from: String) -> String =
  fold(range(0, string_len(text)), "", |acc: String, i: Int|
    acc ++ folded_char(string_slice(text, i, i + 1), to, from))

fn folded_char(c: String, to: String, from: String) -> String =
  if string_contains(from, c) {
    let at = string_find(from, c);
    string_slice(to, at, at + 1)
  } else { c }

fn lower() -> String = "abcdefghijklmnopqrstuvwxyz"

fn upper() -> String = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"

// --- Tests ------------------------------------------------------------------

test "join puts the separator between and nowhere else" {
  assert_eq(join([], ", "), "");
  assert_eq(join(["a"], ", "), "a");
  assert_eq(join(["a", "b", "c"], ", "), "a, b, c");
  assert_eq(join(["", ""], "-"), "-");
  assert_eq(join(["a", ""], "-"), "a-")
}

test "replace is every occurrence and replace_first is one" {
  assert_eq(replace("a-b-c", "-", "+"), "a+b+c");
  assert_eq(replace("abc", "x", "+"), "abc");
  assert_eq(replace("abc", "", "+"), "abc");
  assert_eq(replace("aaa", "aa", "b"), "ba");
  assert_eq(replace_first("a-b-c", "-", "+"), "a+b-c");
  assert_eq(replace_first("abc", "-", "+"), "abc");
  assert_eq(split_once("a=b", "="), Some({ head: "a", tail: "b" }));
  assert_eq(split_once("a=b=c", "="), Some({ head: "a", tail: "b=c" }));
  assert_eq(split_once("ab", "="), None)
}

test "trim takes the whitespace and nothing else" {
  assert_eq(trim("  x \n"), "x");
  assert_eq(trim("   "), "");
  assert_eq(trim_start("  x "), "x ");
  assert_eq(trim_end("  x "), "  x");
  assert_eq(trim("\t\r\n"), "");
  assert_eq(trim(""), "")
}

test "case fold is ASCII, and leave anything else as it is" {
  assert_eq(to_lower("AbC1 é"), "abc1 é");
  assert_eq(to_upper("AbC1 é"), "ABC1 é");
  assert_eq(to_lower(""), "")
}

test "repeat and pad are total, and both treat a width of zero as the text" {
  assert_eq(repeat("ab", 3), "ababab");
  assert_eq(repeat("ab", 0), "");
  assert_eq(repeat("ab", 0 - 2), "");
  assert_eq(pad_left("7", 3, "0"), "007");
  assert_eq(pad_left("7", 1, "0"), "7");
  assert_eq(pad_left("7", 3, ""), "7");
  assert_eq(pad_right("7", 3, "."), "7..");
  assert(is_empty(""));
  assert(!is_empty("x"))
}
