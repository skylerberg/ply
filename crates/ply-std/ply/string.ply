//! What a program wants over a `String` and the prelude does not carry.
//!
//! The prelude has the pieces (`string_len`, `string_slice`, `string_split`, `string_find`,
//! `string_contains`) and no whole: no `join`, no `replace`. This is those, and every one is
//! total: a `String` is characters, not bytes, so a slice lands on a character boundary by
//! construction, and `replace` with an empty needle is the text unchanged rather than a loop.
//! `std.bytes.join` is `join` over `Bytes`.
//!
//! Case has two meanings and a name for each. `ascii_lower` and `ascii_upper` move `A-Z` and `a-z`
//! and leave every other character as it is: the fold for a name a protocol compares without case.
//! The prelude's `string_lower` and `string_upper` map by Unicode's tables: the one for text a
//! person reads, and never for a name that is compared, since it maps characters outside ASCII
//! onto ASCII letters (`string_lower` of the Kelvin sign `U+212A` is `k`).
//!
//! So has a trim. `ascii_trim` takes a space, a tab, a line feed and a carriage return, which is
//! what stands around a token in a protocol's text. The prelude's `string_trim` takes every
//! character Unicode calls white space, a no-break space among them: for text a person wrote, and
//! never for a token, which another reader of the same bytes would not take the same way.

import std.bytes (int_of_ascii)
import std.laws (agrees, idempotent)
import std.list (all, drop, drop_while, reverse, take)

/// Every part, with `sep` between them and nowhere else.
pub fn join(parts: List<String>, sep: String) -> String =
  match parts {
    [] -> "",
    [first, ..rest] -> fold(rest, first, |acc: String, part: String| acc ++ sep ++ part),
  }

/// Whether the text has no characters.
pub fn is_empty(text: String) -> Bool = string_len(text) == 0

/// Every occurrence of `from` as `to`. An empty `from` is the text unchanged: it occurs at every
/// position, and replacing there is not a well-defined answer.
pub fn replace(text: String, from: String, to: String) -> String =
  if string_len(from) == 0 { text } else { join(string_split(text, from), to) }

/// The first occurrence of `from` as `to`, and the rest untouched.
pub fn replace_first(text: String, from: String, to: String) -> String / {abort.raise} =
  if string_len(from) == 0 { text } else {
    match split_once(text, from) { None -> text, Some(split) -> split.head ++ to ++ split.tail }
  }

/// The text around the first `sep`, split there; `None` if `sep` is not in it.
pub fn split_once(
  text: String,
  sep: String,
) -> Option<{ head: String, tail: String }> / {abort.raise} =
  if string_contains(text, sep) {
    let at = string_find(text, sep);
    Some({
      head: string_slice(text, 0, at),
      tail: string_slice(text, at + string_len(sep), string_len(text)),
    })
  } else { None }

/// `text` without the spaces, tabs, line feeds and carriage returns at either end, and with every
/// other character it has: the trim for a token or a value in a protocol's text.
pub fn ascii_trim(text: String) -> String = ascii_trim_start(ascii_trim_end(text))

/// `text` without the spaces, tabs, line feeds and carriage returns it starts with.
pub fn ascii_trim_start(text: String) -> String =
  if leads_blank(text) { string_of_chars(drop_while(string_chars(text), is_blank)) } else { text }

/// `text` without the spaces, tabs, line feeds and carriage returns it ends with.
pub fn ascii_trim_end(text: String) -> String =
  if ends_blank(text) {
    string_of_chars(reverse(drop_while(reverse(string_chars(text)), is_blank)))
  } else { text }

/// `text` with each of `A` to `Z` as its lower-case letter and every other character as it is, a
/// letter outside ASCII included, so the answer is as long as `text`. This is the fold for a name
/// a protocol compares without case: a header's, a scheme's, a host's, a hex digit's.
pub fn ascii_lower(text: String) -> String
  cost string_len(text)
= if is_ascii(text) { string_lower(text) } else { string_of_chars(lowered_chars(text)) }

/// `text` with each of `a` to `z` as its upper-case letter and every other character as it is, as
/// `ascii_lower` leaves them.
pub fn ascii_upper(text: String) -> String
  cost string_len(text)
= if is_ascii(text) { string_upper(text) } else { string_of_chars(raised_chars(text)) }

/// Whether two texts differ at most in the case of the letters `A` to `Z`.
pub fn eq_ignore_ascii_case(a: String, b: String) -> Bool = ascii_lower(a) == ascii_lower(b)

/// `text` repeated `n` times; `n` at or below zero is the empty string.
pub fn repeat(text: String, n: Int) -> String =
  fold(range(0, if n > 0 { n } else { 0 }), "", |acc: String, _: Int| acc ++ text)

/// `text` grown on the left with `fill` until it is `width` characters. An empty `fill` leaves it
/// alone, and a `text` already at least that wide is untouched.
pub fn pad_left(text: String, width: Int, fill: String) -> String =
  padding(text, width, fill) ++ text

/// The same on the right.
pub fn pad_right(text: String, width: Int, fill: String) -> String =
  text ++ padding(text, width, fill)

/// The `fill`s that take `text` to `width`, the last one whole: none for an empty `fill`.
fn padding(text: String, width: Int, fill: String) -> String = {
  let missing = width - string_len(text);
  fold(range(0, if missing > 0 { missing } else { 0 }), "", |acc: String, _: Int|
    if string_len(acc) >= missing { acc } else { acc ++ fill })
}

/// The parts of `text` around each `sep`, in order. The prelude has this as `string_split`; the
/// name here is the one the rest of the module reads with.
pub fn split(text: String, sep: String) -> List<String> / {abort.raise} = string_split(text, sep)

/// Whether `needle` occurs anywhere in the text. An empty needle is in every text.
pub fn contains(text: String, needle: String) -> Bool = string_contains(text, needle)

/// Whether the text begins with `prefix`.
pub fn starts_with(text: String, prefix: String) -> Bool = string_starts_with(text, prefix)

/// Whether the text ends with `suffix`.
pub fn ends_with(text: String, suffix: String) -> Bool = string_ends_with(text, suffix)

/// Where `needle` first occurs, by character, or `None`, where the prelude's `string_find` raises.
pub fn index_of(text: String, needle: String) -> Option<Int> / {abort.raise} =
  if string_contains(text, needle) { Some(string_find(text, needle)) } else { None }

/// `text` without `suffix` at its end, or `text` itself where it does not end so.
pub fn strip_suffix(text: String, suffix: String) -> String / {abort.raise} =
  if string_ends_with(text, suffix) { string_slice(text, 0, string_len(text) - string_len(suffix)) }
  else { text }

/// Each of `rows` followed by a newline.
pub fn unlines(rows: List<String>) -> String =
  fold(rows, "", |acc: String, row: String| acc ++ row ++ "\n")

/// The lines of `text`: split on `\n`, with one trailing `\r` taken off each line, so a CRLF file
/// reads as an LF one. The empty text has no lines rather than one empty line.
pub fn lines(text: String) -> List<String> / {abort.raise} =
  if is_empty(text) { [] } else { map(string_split(text, "\n"), |line: String| without_cr(line)) }

/// The runs of characters that are not spaces, tabs or newlines, in order. There is never an
/// empty word, and an all-whitespace text has none.
pub fn words(text: String) -> List<String> / {abort.raise} = words_from(text, 0, "", [])

/// How many times `needle` occurs without overlapping: `"aaa"` has one `"aa"`, not two. An empty
/// needle is zero occurrences rather than unbounded many.
pub fn count(text: String, needle: String) -> Int / {abort.raise} =
  if is_empty(needle) { 0 } else { len(string_split(text, needle)) - 1 }

/// `text` with its first character upper-cased as `ascii_upper` does it, and the rest left as
/// they are; an empty text stays empty.
pub fn capitalize(text: String) -> String =
  match string_chars(text) {
    [] -> "",
    [head, ..tail] -> string_of_chars([upper_char(head)]) ++ string_of_chars(tail),
  }

fn without_cr(line: String) -> String / {abort.raise} =
  if string_ends_with(line, "\r") { string_slice(line, 0, string_len(line) - 1) } else { line }

fn words_from(
  text: String,
  at: Int,
  current: String,
  out: List<String>,
) -> List<String> / {abort.raise} =
  if at >= string_len(text) { if is_empty(current) { out } else { push(out, current) } } else {
    let c = string_slice(text, at, at + 1);
    if is_space(c) {
      if is_empty(current) { words_from(text, at + 1, "", out) }
      else { words_from(text, at + 1, "", push(out, current)) }
    } else { words_from(text, at + 1, current ++ c, out) }
  }

fn is_space(c: String) -> Bool = string_contains(" \t\n\r", c)

fn is_blank(c: Char) -> Bool = c == ' ' || c == '\t' || c == '\n' || c == '\r'

fn leads_blank(text: String) -> Bool =
  string_starts_with(text, " ") || string_starts_with(text, "\t") || string_starts_with(text, "\n")
    || string_starts_with(text, "\r")

fn ends_blank(text: String) -> Bool =
  string_ends_with(text, " ") || string_ends_with(text, "\t") || string_ends_with(text, "\n")
    || string_ends_with(text, "\r")

/// Whether `text` is ASCII alone: as many bytes as characters, a character outside ASCII being more
/// than one byte.
pub fn is_ascii(text: String) -> Bool = bytes_len(bytes_of_string(text)) == string_len(text)

fn lowered_chars(text: String) -> List<Char> = map(string_chars(text), lower_char)

fn raised_chars(text: String) -> List<Char> = map(string_chars(text), upper_char)

fn lower_char(c: Char) -> Char = if c >= 'A' && c <= 'Z' { shifted(c, 32) } else { c }

fn upper_char(c: Char) -> Char = if c >= 'a' && c <= 'z' { shifted(c, -32) } else { c }

fn shifted(c: Char, by: Int) -> Char =
  match char_of_int(int_of_char(c) + by) { Some(other) -> other, None -> c }

// --- Tests ------------------------------------------------------------------

test "strip_suffix takes one suffix off, and unlines ends each row" {
  assert_eq(strip_suffix("line\n", "\n"), "line");
  assert_eq(strip_suffix("line", "\n"), "line");
  assert_eq(strip_suffix("aa", "a"), "a");
  assert_eq(unlines(["a", "b"]), "a\nb\n");
  assert_eq(unlines([]), "")
}

test "join puts the separator between and nowhere else" {
  assert_eq(join([], ", "), "");
  assert_eq(join(["a"], ", "), "a");
  assert_eq(join(["a", "b", "c"], ", "), "a, b, c");
  assert_eq(join(["", ""], "-"), "-");
  assert_eq(join(["a", ""], "-"), "a-")
}

test "replace is every occurrence and replace_first is one" {
  assert_eq(replace("a-b-c", "-", "+"), "a+b+c");
  assert_eq(replace("abc", "x", "+"), "abc");
  assert_eq(replace("abc", "", "+"), "abc");
  assert_eq(replace("aaa", "aa", "b"), "ba");
  assert_eq(replace_first("a-b-c", "-", "+"), "a+b-c");
  assert_eq(replace_first("abc", "-", "+"), "abc");
  assert_eq(split_once("a=b", "="), Some({ head: "a", tail: "b" }));
  assert_eq(split_once("a=b=c", "="), Some({ head: "a", tail: "b=c" }));
  assert_eq(split_once("ab", "="), None)
}

test "the ASCII trim takes spaces, tabs, line feeds and carriage returns, and nothing else" {
  assert_eq(ascii_trim("  x \n"), "x");
  assert_eq(ascii_trim("   "), "");
  assert_eq(ascii_trim_start("  x "), "x ");
  assert_eq(ascii_trim_end("  x "), "  x");
  assert_eq(ascii_trim("\t\r\n"), "");
  assert_eq(ascii_trim(""), "");
  assert_eq(ascii_trim(" a b "), "a b");
  assert_eq(ascii_trim("\u{b}x\u{c}"), "\u{b}x\u{c}")
}

test "white space outside ASCII stays under the ASCII trim, where Unicode's takes it" {
  let spaced = "\u{a0}chunked\u{2003}";
  assert_eq(ascii_trim(spaced), spaced);
  assert_eq(string_trim(spaced), "chunked");
  assert_eq(ascii_trim(" " ++ spaced ++ "\t"), spaced);
  assert_eq(ascii_trim("\u{85}x\u{3000}"), "\u{85}x\u{3000}");
  assert_eq(string_trim("\u{85}x\u{3000}"), "x")
}

law "an ASCII trim is settled" = idempotent(ascii_trim)

law "below 256 the ASCII trim takes a space, a tab, a line feed and a carriage return alone"
  forall (b: U8) {
    let n = int_of_u8(b);
    ascii_trim(one(n)) == (if n == 32 || n == 9 || n == 10 || n == 13 { "" } else { one(n) })
      && ascii_trim("a" ++ one(n) ++ "b") == "a" ++ one(n) ++ "b"
  }

law "an ASCII trim takes blanks alone from an end, and leaves none there"
  forall (lead: Int, middle: String, tail: Int) {
    let text = repeat(" \t\r\n", lead & 3) ++ middle ++ repeat("\n \t", tail & 3);
    let whole = string_chars(text);
    let led = len(whole) - string_len(ascii_trim_start(text));
    let kept = string_len(ascii_trim_end(text));
    string_ends_with(text, ascii_trim_start(text)) && all(take(whole, led), is_blank)
      && !leads_blank(ascii_trim_start(text))
      && string_starts_with(text, ascii_trim_end(text))
      && all(drop(whole, kept), is_blank)
      && !ends_blank(ascii_trim_end(text))
      && ascii_trim(text) == ascii_trim_end(ascii_trim_start(text))
  }

law "Unicode's trim takes whatever the ASCII trim does" =
  agrees(|text: String| string_trim(ascii_trim(text)), string_trim)

test "the ASCII fold moves `A-Z` and `a-z`, and leaves every other character as it is" {
  assert_eq(ascii_lower("AbC1 É"), "abc1 É");
  assert_eq(ascii_upper("AbC1 é"), "ABC1 é");
  assert_eq(ascii_lower("@[`{"), "@[`{");
  assert_eq(ascii_upper("@[`{"), "@[`{");
  assert_eq(ascii_lower(""), "");
  assert_eq(ascii_upper(""), "")
}

type Cased = { text: String, ascii: String, unicode: String }

/// Texts whose two lower cases differ: each is a name the ASCII fold must not move.
fn lowered() -> List<Cased> =
  [
    { text: "\u{212A}", ascii: "\u{212A}", unicode: "k" },
    { text: "\u{130}", ascii: "\u{130}", unicode: "i\u{307}" },
    { text: "ÉCOLE", ascii: "École", unicode: "école" },
    { text: "ΟΔΟΣ", ascii: "ΟΔΟΣ", unicode: "οδος" },
  ]

/// Texts whose two upper cases differ, the first three by growing.
fn raised() -> List<Cased> =
  [
    { text: "straße", ascii: "STRAßE", unicode: "STRASSE" },
    { text: "ﬁn", ascii: "ﬁN", unicode: "FIN" },
    { text: "ŉ", ascii: "ŉ", unicode: "ʼN" },
    { text: "\u{17F}et", ascii: "\u{17F}ET", unicode: "SET" },
    { text: "\u{131}d", ascii: "\u{131}D", unicode: "ID" },
  ]

test "outside ASCII the fold leaves a text as it is where Unicode's lower case moves it" {
  fold(lowered(), (), |_: Unit, c: Cased| {
    assert_eq(ascii_lower(c.text), c.ascii);
    assert_eq(string_lower(c.text), c.unicode);
    assert_eq(string_len(ascii_lower(c.text)), string_len(c.text))
  })
}

test "outside ASCII the fold leaves a text as it is where Unicode's upper case moves it" {
  fold(raised(), (), |_: Unit, c: Cased| {
    assert_eq(ascii_upper(c.text), c.ascii);
    assert_eq(string_upper(c.text), c.unicode);
    assert_eq(string_len(ascii_upper(c.text)), string_len(c.text))
  })
}

test "texts are equal ignoring ASCII case where only `A-Z` and `a-z` differ" {
  assert(eq_ignore_ascii_case("Content-Length", "content-length"));
  assert(eq_ignore_ascii_case("", ""));
  assert(!eq_ignore_ascii_case("content-length", "content-length "));
  assert(!eq_ignore_ascii_case("\u{212A}", "k"));
  assert(!eq_ignore_ascii_case("É", "é"))
}

law "a text in ASCII lower case is settled" = idempotent(ascii_lower)

law "a text in ASCII upper case is settled" = idempotent(ascii_upper)

/// The one character `n` is the scalar value of, as a text; empty where it is no character's.
fn one(n: Int) -> String = match char_of_int(n) { Some(c) -> string_of_chars([c]), None -> "" }

law "below 256 the ASCII fold lowers `A-Z` as Unicode does, and moves no other character"
  forall (b: U8) {
    let n = int_of_u8(b);
    ascii_lower(one(n)) == one(if n >= 65 && n <= 90 { n + 32 } else { n })
      && (n >= 128 || ascii_lower(one(n)) == string_lower(one(n)))
  }

law "below 256 the ASCII fold raises `a-z` as Unicode does, and moves no other character"
  forall (b: U8) {
    let n = int_of_u8(b);
    ascii_upper(one(n)) == one(if n >= 97 && n <= 122 { n - 32 } else { n })
      && (n >= 128 || ascii_upper(one(n)) == string_upper(one(n)))
  }

/// The characters of `text` outside ASCII, in order.
fn beyond(text: String) -> List<Char> = filter(string_chars(text), |c: Char| int_of_char(c) >= 128)

/// `text` without its characters outside ASCII.
fn plain(text: String) -> String =
  string_of_chars(filter(string_chars(text), |c: Char| int_of_char(c) < 128))

law "the ASCII fold keeps a text's length and every character outside ASCII, either way"
  forall (text: String) {
    string_len(ascii_lower(text)) == string_len(text) && beyond(ascii_lower(text)) == beyond(text)
      && string_len(ascii_upper(text)) == string_len(text)
      && beyond(ascii_upper(text)) == beyond(text)
  }

law "a text of ASCII has the lower case Unicode gives it" =
  agrees(|text: String| string_of_chars(lowered_chars(plain(text))), |text: String|
    string_lower(plain(text)))

law "a text of ASCII has the upper case Unicode gives it" =
  agrees(|text: String| string_of_chars(raised_chars(plain(text))), |text: String|
    string_upper(plain(text)))

law "a text's ASCII lower case is each character's, whichever way it is reached" =
  agrees(ascii_lower, |text: String| string_of_chars(lowered_chars(text)))

law "a text's ASCII upper case is each character's, whichever way it is reached" =
  agrees(ascii_upper, |text: String| string_of_chars(raised_chars(text)))

law "texts are equal ignoring ASCII case exactly where their upper cases are equal"
  forall (a: String, b: String) {
    eq_ignore_ascii_case(a, b) == (ascii_upper(a) == ascii_upper(b))
      && eq_ignore_ascii_case(a, ascii_upper(a))
  }

test "repeat and pad are total, and both treat a width of zero as the text" {
  assert_eq(repeat("ab", 3), "ababab");
  assert_eq(repeat("ab", 0), "");
  assert_eq(repeat("ab", 0 - 2), "");
  assert_eq(pad_left("7", 3, "0"), "007");
  assert_eq(pad_left("7", 1, "0"), "7");
  assert_eq(pad_left("7", 3, ""), "7");
  assert_eq(pad_right("7", 3, "."), "7..");
  assert(is_empty(""));
  assert(!is_empty("x"))
}

test "split, contains and the prefix and suffix questions are the prelude's pieces renamed" {
  assert_eq(split("a-b-c", "-"), ["a", "b", "c"]);
  assert_eq(split("", "-"), [""]);
  assert(contains("abc", "b"));
  assert(!contains("abc", "z"));
  assert(contains("abc", ""));
  assert(starts_with("abc", "ab"));
  assert(!starts_with("abc", "b"));
  assert(ends_with("abc", "bc"));
  assert(!ends_with("abc", "b"));
  assert_eq(index_of("a-b", "-"), Some(1));
  assert_eq(index_of("abc", "z"), None)
}

test "lines takes the newline and one carriage return with it" {
  assert_eq(lines("a\nb"), ["a", "b"]);
  assert_eq(lines("a\r\nb\r\n"), ["a", "b", ""]);
  assert_eq(lines("a"), ["a"]);
  assert_eq(lines(""), []);
  assert_eq(lines("\n"), ["", ""])
}

test "words are the runs that are not whitespace, and never empty" {
  assert_eq(words("  a  bb\tc\n d "), ["a", "bb", "c", "d"]);
  assert_eq(words(""), []);
  assert_eq(words("   \t\n"), []);
  assert_eq(words("one"), ["one"])
}

test "count does not overlap, and capitalize touches one character" {
  assert_eq(count("aaa", "a"), 3);
  assert_eq(count("aaa", "aa"), 1);
  assert_eq(count("abc", "z"), 0);
  assert_eq(count("abc", ""), 0);
  assert_eq(count("", "a"), 0);
  assert_eq(capitalize("abc"), "Abc");
  assert_eq(capitalize("ABC"), "ABC");
  assert_eq(capitalize(""), "")
}

/// A decimal integer: an optional `-`, then digits, and nothing else; `None` for anything else, and
/// for a number past what an `Int` holds.
pub fn int_of_string(text: String) -> Option<Int> / {abort.raise} =
  int_of_ascii(bytes_of_string(text))

/// Each character's Unicode scalar value, in order.
pub fn code_points(text: String) -> List<Int> / {abort.raise} =
  decoded(bytes_of_string(text), 0, [])

/// The text these scalar values spell; `None` when one is negative, a surrogate or past `U+10FFFF`.
pub fn of_code_points(points: List<Int>) -> Option<String> / {abort.raise} =
  if all_scalar(points) {
    Some(string_of_bytes(bytes_concat_all(map(points, |c: Int| encoded(c)))))
  } else { None }

fn all_scalar(points: List<Int>) -> Bool =
  fold(points, true, |ok: Bool, c: Int| ok && c >= 0 && c <= 0x10FFFF && (c < 0xD800 || c > 0xDFFF))

/// A `String` is valid UTF-8, so every lead byte says how many continuation bytes follow it.
fn decoded(b: Bytes, i: Int, acc: List<Int>) -> List<Int> / {abort.raise} =
  if i >= bytes_len(b) { acc } else {
    let lead = bytes_at(b, i);
    if lead < 0x80 { decoded(b, i + 1, push(acc, lead)) } else if lead < 0xE0 {
      decoded(b, i + 2, push(acc, (lead & 0x1F) << 6 | continuation(b, i + 1)))
    } else if lead < 0xF0 {
      decoded(
        b,
        i + 3,
        push(acc, (lead & 0x0F) << 12 | continuation(b, i + 1) << 6 | continuation(b, i + 2)),
      )
    } else {
      decoded(
        b,
        i + 4,
        push(
          acc,
          (lead & 0x07) << 18 | continuation(b, i + 1) << 12 | continuation(b, i + 2) << 6
            | continuation(b, i + 3),
        ),
      )
    }
  }

fn continuation(b: Bytes, i: Int) -> Int / {abort.raise} = bytes_at(b, i) & 0x3F

fn encoded(c: Int) -> Bytes / {abort.raise} =
  if c < 0x80 { byte_of_int(c) }
  else if c < 0x800 { bytes_concat(byte_of_int(0xC0 | c >> 6), trailing(c, 0)) }
  else if c < 0x10000 {
    bytes_concat_all([byte_of_int(0xE0 | c >> 12), trailing(c, 6), trailing(c, 0)])
  } else {
    bytes_concat_all([byte_of_int(0xF0 | c >> 18), trailing(c, 12), trailing(c, 6), trailing(c, 0)])
  }

fn trailing(c: Int, shift: Int) -> Bytes = byte_of_int(0x80 | c >> shift & 0x3F)

test "int_of_string reads a signed decimal and refuses anything else" {
  assert_eq(int_of_string("-17"), Some(0 - 17));
  assert_eq(int_of_string("17"), Some(17));
  assert_eq(int_of_string("7.5"), None);
  assert_eq(int_of_string(""), None)
}

test "code points are each character's scalar value, and they spell the text back" {
  assert_eq(code_points("ab"), [97, 98]);
  assert_eq(code_points("é€😀"), [0xE9, 0x20AC, 0x1F600]);
  assert_eq(code_points(""), []);
  assert_eq(of_code_points([104, 0xE9, 0x20AC, 0x1F600]), Some("hé€😀"));
  assert_eq(of_code_points(code_points("mixed é text")), Some("mixed é text"));
  assert_eq(of_code_points([]), Some(""))
}

test "a surrogate, a negative and a value past U+10FFFF spell nothing" {
  assert_eq(of_code_points([0xD800]), None);
  assert_eq(of_code_points([0xDFFF]), None);
  assert_eq(of_code_points([0 - 1]), None);
  assert_eq(of_code_points([0x110000]), None);
  assert(of_code_points([0x10FFFF]) != None)
}
