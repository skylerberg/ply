//! Byte strings: integers in them, hex, ASCII decimal, searching and scanning.
//!
//! What a container format, a network protocol and a hand-written parser need, little-endian and
//! big-endian.
//!
//! A read past either end answers `None` rather than raising, and so does a `u64` past what an `Int`
//! holds, so an answer is never a negative length. `int_of_ascii_radix` is the one integer parser
//! the shipped modules share, `int_of_ascii` is it in decimal, and `std.math`'s `from_radix` is it
//! over a `String`. Hex is `std.radix` at its lowercase alphabet.

import std.radix

/// The low four bytes of `n`, least significant first.
pub fn u32_le(n: Int) -> Bytes =
  bytes_concat_all([
    byte_of_int(n & 0xFF),
    byte_of_int(n >>> 8 & 0xFF),
    byte_of_int(n >>> 16 & 0xFF),
    byte_of_int(n >>> 24 & 0xFF),
  ])

/// The low eight bytes of `n`, least significant first.
pub fn u64_le(n: Int) -> Bytes = bytes_concat(u32_le(n), u32_le(n >>> 32))

/// The four bytes at `at`, least significant first; `None` past either end.
pub fn u32_at(b: Bytes, at: Int) -> Option<Int> =
  if at < 0 || at > bytes_len(b) - 4 { None } else { Some(int_of_u32(bytes_u32_le(b, at))) }

/// The eight bytes at `at`, least significant first; `None` past either end, and `None` for a
/// value past what an `Int` holds, so an answer is never a negative length.
pub fn u64_at(b: Bytes, at: Int) -> Option<Int> =
  match u32_at(b, at) {
    None -> None,
    Some(low) -> match u32_at(b, at + 4) {
      None -> None,
      Some(high) -> if high > 0x7FFF_FFFF { None } else { Some(low | high << 32) },
    },
  }

/// The `n` bytes at `at`; `None` when the string is shorter or the bounds are not a range.
pub fn slice_at(b: Bytes, at: Int, n: Int) -> Option<Bytes> =
  if at < 0 || n < 0 || at > bytes_len(b) || n > bytes_len(b) - at { None }
  else { Some(bytes_slice(b, at, at + n)) }

/// Every byte xored with one byte, which is what an HMAC key pad is.
pub fn xor_byte(b: Bytes, constant: Int) -> Bytes / {abort.raise} =
  bytes_concat_all(map(range(0, bytes_len(b)), |i: Int| byte_of_int(bytes_at(b, i) ^ constant)))

/// Two byte strings xored, up to the shorter one's length.
pub fn xor(a: Bytes, b: Bytes) -> Bytes =
  bytes_concat_all(
    map(range(0, min(bytes_len(a), bytes_len(b))), |i: Int|
      byte_of_int(bytes_at(a, i) ^ bytes_at(b, i))),
  )

// --- Big-endian ------------------------------------------------------------------

/// The two bytes of `n`, most significant first.
pub fn u16_be(n: Int) -> Bytes =
  bytes_concat_all([byte_of_int(n >>> 8 & 0xFF), byte_of_int(n & 0xFF)])

/// The low four bytes of `n`, most significant first.
pub fn u32_be(n: Int) -> Bytes =
  bytes_concat_all([
    byte_of_int(n >>> 24 & 0xFF),
    byte_of_int(n >>> 16 & 0xFF),
    byte_of_int(n >>> 8 & 0xFF),
    byte_of_int(n & 0xFF),
  ])

/// The low eight bytes of `n`, most significant first.
pub fn u64_be(n: Int) -> Bytes = bytes_concat(u32_be(n >>> 32), u32_be(n))

/// A signed write is the same bytes: two's complement is the representation, so these are one
/// function with two names, for the call site to say which it meant.
pub fn i16_be(n: Int) -> Bytes = u16_be(n)

/// The same bytes as `u32_be`, for a call site writing a signed value.
pub fn i32_be(n: Int) -> Bytes = u32_be(n)

/// The same bytes as `u64_be`, for a call site writing a signed value.
pub fn i64_be(n: Int) -> Bytes = u64_be(n)

/// The two bytes at `at`, most significant first; `None` past either end.
pub fn u16_be_at(b: Bytes, at: Int) -> Option<Int> =
  if at < 0 || at > bytes_len(b) - 2 { None }
  else { Some(bytes_at(b, at) << 8 | bytes_at(b, at + 1)) }

/// The four bytes at `at`, most significant first; `None` past either end.
pub fn u32_be_at(b: Bytes, at: Int) -> Option<Int> =
  if at < 0 || at > bytes_len(b) - 4 { None } else {
    Some(
      bytes_at(b, at) << 24 | bytes_at(b, at + 1) << 16 | bytes_at(b, at + 2) << 8
        | bytes_at(b, at + 3),
    )
  }

/// The eight bytes at `at`, most significant first; `None` past either end, and `None` for a
/// value past what an `Int` holds, so an answer is never a negative length.
pub fn u64_be_at(b: Bytes, at: Int) -> Option<Int> =
  match u32_be_at(b, at) {
    None -> None,
    Some(high) -> match u32_be_at(b, at + 4) {
      None -> None,
      Some(low) -> if high > 0x7FFF_FFFF { None } else { Some(high << 32 | low) },
    },
  }

/// The two bytes at `at` as a signed value, most significant first: `0xFFFE` reads as -2.
pub fn i16_be_at(b: Bytes, at: Int) -> Option<Int> =
  match u16_be_at(b, at) {
    None -> None,
    Some(v) -> Some(if v >= 0x8000 { v - 0x1_0000 } else { v }),
  }

/// The four bytes at `at` as a signed value, most significant first.
pub fn i32_be_at(b: Bytes, at: Int) -> Option<Int> =
  match i16_be_at(b, at) {
    None -> None,
    Some(high) -> match u16_be_at(b, at + 2) { None -> None, Some(low) -> Some(high << 16 | low) },
  }

/// The eight bytes at `at` as a signed value, most significant first; every `Int` is reachable,
/// so unlike `u64_be_at` this answers for the whole range.
pub fn i64_be_at(b: Bytes, at: Int) -> Option<Int> =
  match i32_be_at(b, at) {
    None -> None,
    Some(high) -> match u32_be_at(b, at + 4) { None -> None, Some(low) -> Some(high << 32 | low) },
  }

// --- Tests ------------------------------------------------------------------

test "a u32 is four bytes, least significant first" {
  assert_eq(u32_le(0), b"\x00\x00\x00\x00");
  assert_eq(u32_le(1), b"\x01\x00\x00\x00");
  assert_eq(u32_le(0x0102_0304), b"\x04\x03\x02\x01");
  assert_eq(u32_le(4294967295), b"\xff\xff\xff\xff")
}

test "a u64 is eight bytes, least significant first" {
  assert_eq(u64_le(0), b"\x00\x00\x00\x00\x00\x00\x00\x00");
  assert_eq(u64_le(1), b"\x01\x00\x00\x00\x00\x00\x00\x00");
  assert_eq(u64_le(0x0102_0304_0506_0708), b"\x08\x07\x06\x05\x04\x03\x02\x01")
}

test "what is written reads back" {
  assert_eq(u32_at(u32_le(123456789), 0), Some(123456789));
  assert_eq(u64_at(u64_le(1099511627776), 0), Some(1099511627776));
  assert_eq(u32_at(bytes_concat(b"ab", u32_le(7)), 2), Some(7));
  assert_eq(u64_at(bytes_concat(b"ab", u64_le(7)), 2), Some(7))
}

test "a read past either end answers None rather than raising" {
  assert_eq(u32_at(b"abc", 0), None);
  assert_eq(u32_at(b"abcd", 1), None);
  assert_eq(u32_at(b"abcd", -1), None);
  assert_eq(u32_at(b"", 0), None);
  assert_eq(u64_at(b"abcdefg", 0), None)
}

test "a u64 past what an Int holds is refused rather than answered negative" {
  assert_eq(u64_at(b"\x00\x00\x00\x00\x00\x00\x00\x80", 0), None);
  assert_eq(u64_at(b"\xff\xff\xff\xff\xff\xff\xff\xff", 0), None);
  assert_eq(u64_at(b"\xff\xff\xff\xff\xff\xff\xff\x7f", 0), Some(9223372036854775807))
}

test "a slice past the end answers None" {
  assert_eq(slice_at(b"abcdef", 2, 3), Some(b"cde"));
  assert_eq(slice_at(b"abcdef", 0, 6), Some(b"abcdef"));
  assert_eq(slice_at(b"abcdef", 6, 0), Some(b""));
  assert_eq(slice_at(b"abcdef", 4, 3), None);
  assert_eq(slice_at(b"abcdef", 7, 0), None);
  assert_eq(slice_at(b"abcdef", -1, 2), None);
  assert_eq(slice_at(b"abcdef", 2, -1), None)
}

test "a big-endian integer is most significant first" {
  assert_eq(u16_be(0x0102), b"\x01\x02");
  assert_eq(u32_be(0x0102_0304), b"\x01\x02\x03\x04");
  assert_eq(u64_be(0x0102_0304_0506_0708), b"\x01\x02\x03\x04\x05\x06\x07\x08");
  assert_eq(u32_be(1), b"\x00\x00\x00\x01");
  assert_eq(u32_be(4294967295), b"\xff\xff\xff\xff")
}

test "a negative integer writes its two's complement, most significant first" {
  assert_eq(i16_be(-2), b"\xff\xfe");
  assert_eq(i32_be(-1), b"\xff\xff\xff\xff");
  assert_eq(i32_be(-2147483648), b"\x80\x00\x00\x00");
  assert_eq(i64_be(-1), b"\xff\xff\xff\xff\xff\xff\xff\xff")
}

test "what is written big-endian reads back" {
  assert_eq(u16_be_at(u16_be(0x0102), 0), Some(0x0102));
  assert_eq(u32_be_at(u32_be(123456789), 0), Some(123456789));
  assert_eq(u64_be_at(u64_be(1099511627776), 0), Some(1099511627776));
  assert_eq(u32_be_at(bytes_concat(b"ab", u32_be(7)), 2), Some(7));
  // The four bytes a protocol prefixes a message with, which is what these are for.
  assert_eq(slice_at(u32_be(16), 0, 4), Some(b"\x00\x00\x00\x10"))
}

test "a signed read carries the sign, and the whole Int range reads" {
  assert_eq(i16_be_at(b"\xff\xfe", 0), Some(-2));
  assert_eq(i16_be_at(b"\x80\x00", 0), Some(-32768));
  assert_eq(i16_be_at(b"\x7f\xff", 0), Some(32767));
  assert_eq(i32_be_at(b"\xff\xff\xff\xff", 0), Some(-1));
  assert_eq(i32_be_at(b"\x80\x00\x00\x00", 0), Some(-2147483648));
  assert_eq(i32_be_at(b"\x7f\xff\xff\xff", 0), Some(2147483647));
  assert_eq(i64_be_at(b"\xff\xff\xff\xff\xff\xff\xff\xff", 0), Some(-1));
  assert_eq(i64_be_at(b"\x80\x00\x00\x00\x00\x00\x00\x01", 0), Some(-9223372036854775807));
  assert_eq(i64_be_at(b"\x7f\xff\xff\xff\xff\xff\xff\xff", 0), Some(9223372036854775807))
}

test "a big-endian read past either end answers None rather than raising" {
  assert_eq(u16_be_at(b"a", 0), None);
  assert_eq(u16_be_at(b"ab", 1), None);
  assert_eq(u16_be_at(b"ab", -1), None);
  assert_eq(u32_be_at(b"abc", 0), None);
  assert_eq(u32_be_at(b"abcd", 1), None);
  assert_eq(u32_be_at(b"abcd", -1), None);
  assert_eq(u32_be_at(b"", 0), None);
  assert_eq(u64_be_at(b"abcdefg", 0), None);
  assert_eq(i32_be_at(b"abc", 0), None);
  assert_eq(i64_be_at(b"abcdefg", 0), None)
}

test "a u64 big-endian past what an Int holds is refused rather than answered negative" {
  assert_eq(u64_be_at(b"\x80\x00\x00\x00\x00\x00\x00\x00", 0), None);
  assert_eq(u64_be_at(b"\xff\xff\xff\xff\xff\xff\xff\xff", 0), None);
  assert_eq(u64_be_at(b"\x7f\xff\xff\xff\xff\xff\xff\xff", 0), Some(9223372036854775807))
}

test "the two byte orders read the same bytes as different numbers" {
  assert_eq(u32_be_at(b"\x04\x03\x02\x01", 0), Some(0x04030201));
  assert_eq(u32_at(b"\x04\x03\x02\x01", 0), Some(0x01020304))
}

test "two byte strings xor to their difference" {
  assert_eq(xor(b"\x00\xff\x0f", b"\xff\xff\xf0"), b"\xff\x00\xff");
  assert_eq(xor(b"abc", b"abc"), b"\x00\x00\x00");
  // The shorter one bounds the answer, so a pad of the wrong length cannot read past either.
  assert_eq(xor(b"\x01\x02", b"\x01"), b"\x00")
}

test "a byte xored with a constant is a key pad" {
  assert_eq(xor_byte(b"\x00\xff", 0xFF), b"\xff\x00");
  assert_eq(xor_byte(b"", 0x36), b"")
}

/// Whether `part` occurs in `b`.
pub fn contains(b: Bytes, part: Bytes) -> Bool =
  match bytes_index_of(b, part) { Some(_) -> true, None -> false }

/// `b` with every occurrence of `from` replaced by `to`, left to right; an empty `from` occurs nowhere.
pub fn replace(b: Bytes, from: Bytes, to: Bytes) -> Bytes =
  if bytes_len(from) == 0 { b } else { join(bytes_split(b, from), to) }

/// Every piece, with `sep` between them, in one allocation over the whole list.
pub fn join(pieces: List<Bytes>, sep: Bytes) -> Bytes =
  match pieces {
    [] -> b"",
    [first, ..rest] ->
      bytes_concat(first, bytes_concat_all(map(rest, |p: Bytes| bytes_concat(sep, p)))),
  }

/// The bytes lexicographic order: the first byte that differs decides, and a prefix sorts before
/// what extends it. The same order a `Map` keyed on `Bytes` is kept in.
pub fn compare(a: Bytes, b: Bytes) -> Ordering / {abort.raise} = compare_from(a, b, 0)

/// Whether the byte is an ASCII decimal digit.
pub fn is_digit(b: Int) -> Bool = b >= 48 && b <= 57

/// Whether the byte is an ASCII letter, of either case.
pub fn is_letter(b: Int) -> Bool = (b >= 65 && b <= 90) || (b >= 97 && b <= 122)

/// Whether the byte is a space or a tab: the blanks a line of a protocol's text holds.
pub fn is_blank(b: Int) -> Bool = b == b' ' || b == b'\t'

/// The lowercase hex digit for `v`, which is below 16.
pub fn hex_digit(v: Int) -> Bytes / {abort.raise} = bytes_slice(radix::hex().symbols, v, v + 1)

/// The value of the hex digit `c`, in either case, or `-1` for any other byte.
pub fn hex_value(c: Int) -> Int =
  if c >= 48 && c <= 57 { c - 48 }
  else if c >= 97 && c <= 102 { c - 87 }
  else if c >= 65 && c <= 70 { c - 55 }
  else { -1 }

/// The byte at `i`, or `-1` where `b` has none.
pub fn peek(b: Bytes, i: Int) -> Int = if i < 0 || i >= bytes_len(b) { -1 } else { bytes_at(b, i) }

/// Whether `word` stands in `b` at `i`.
pub fn starts_at(b: Bytes, i: Int, word: Bytes) -> Bool / {abort.raise} =
  i + bytes_len(word) <= bytes_len(b) && bytes_slice(b, i, i + bytes_len(word)) == word

/// From `i`, where the first byte not in `set` is: the length of `b` if there is none.
pub fn scan(b: Bytes, i: Int, set: Bytes) -> Int / {abort.raise} =
  if i >= bytes_len(b) { bytes_len(b) } else { bytes_scan(b, i, set, bytes_len(b)) }

/// From `i`, where the first byte in `set` is: the length of `b` if there is none.
pub fn scan_until(b: Bytes, i: Int, set: Bytes) -> Int / {abort.raise} =
  if i >= bytes_len(b) { bytes_len(b) } else { bytes_scan_until(b, i, set, bytes_len(b)) }

/// `n` in decimal ASCII: what `int_of_ascii` reads back.
pub fn ascii_of_int(n: Int) -> Bytes = bytes_of_string(int_to_string(n))

/// `s` and a NUL after it, as C and the wire protocols that borrow its strings spell one.
pub fn cstring(s: String) -> Bytes = bytes_concat(bytes_of_string(s), b"\x00")

/// `b` repeated `n` times; a non-positive `n` is the empty bytes.
pub fn repeat(b: Bytes, n: Int) -> Bytes =
  bytes_concat_all(map(range(0, if n > 0 { n } else { 0 }), |_: Int| b))

fn doubled(pattern: Bytes, n: Int, left: Int) -> Bytes =
  if left <= 0 || bytes_len(pattern) >= n { pattern }
  else { doubled(bytes_concat(pattern, pattern), n, left - 1) }

/// `pattern` over and over until it is `n` bytes, the last copy cut short: what a match copies
/// that reaches into what it is itself writing. Empty for an empty pattern and for an `n` below
/// one. It doubles what it has, so it takes steps in the logarithm of `n`.
pub fn cycle(pattern: Bytes, n: Int) -> Bytes / {abort.raise} =
  if n <= 0 || bytes_len(pattern) == 0 { b"" } else { bytes_slice(doubled(pattern, n, 62), 0, n) }

/// `data` with the byte at `at` made `byte`. Raises where `data` has no such byte, or `byte` is
/// none.
pub fn with_byte(data: Bytes, at: Int, byte: Int) -> Bytes / {abort.raise} =
  bytes_concat_all([
    bytes_slice(data, 0, at),
    byte_of_int(byte),
    bytes_slice(data, at + 1, bytes_len(data)),
  ])

fn pieces_from(
  data: Bytes,
  sizes: Array<Int>,
  at: Int,
  out: List<Bytes>,
  fuel: Int,
) -> List<Bytes> / {abort.raise} =
  if fuel <= 0 || at >= bytes_len(data) { out } else {
    let size = max(1, array_get(sizes, len(out) % array_len(sizes)));
    let end = if size >= bytes_len(data) - at { bytes_len(data) } else { at + size };
    pieces_from(data, sizes, end, push(out, bytes_slice(data, at, end)), fuel - 1)
  }

/// `data` cut into pieces as long as `sizes` say in turn, round and round: what a reader is
/// handed that takes its input a chunk at a time. A size below one counts as one and the last
/// piece is what is left; no sizes give one piece, and no bytes give none.
pub fn pieces(data: Bytes, sizes: List<Int>) -> List<Bytes> / {abort.raise} =
  if bytes_len(data) == 0 { [] }
  else if len(sizes) == 0 { [data] }
  else { pieces_from(data, array_of_list(sizes), 0, [], bytes_len(data)) }

/// How many bytes from `a` and from `b` are the same, up to `most`, given that the first `n`
/// are: how long a match is. It compares four at a time while four remain, and raises where
/// `most` bytes from either pass the end.
pub fn agreeing(data: Bytes, a: Int, b: Int, most: Int, n: Int) -> Int / {abort.raise} =
  if n + 4 <= most && bytes_u32_le(data, a + n) == bytes_u32_le(data, b + n) {
    agreeing(data, a, b, most, n + 4)
  } else { agreeing_bytes(data, a, b, most, n) }

fn agreeing_bytes(data: Bytes, a: Int, b: Int, most: Int, n: Int) -> Int / {abort.raise} =
  if n < most && bytes_at(data, a + n) == bytes_at(data, b + n) {
    agreeing_bytes(data, a, b, most, n + 1)
  } else { n }

/// The eight bytes at `at` as the 64 bits of an `Int`, the first byte lowest, so the last byte's
/// high bit is its sign. Raises unless all eight are there.
pub fn word_at(b: Bytes, at: Int) -> Int / {abort.raise} =
  int_of_u32(bytes_u32_le(b, at)) | int_of_u32(bytes_u32_le(b, at + 4)) << 32

/// The `n` bits from bit `bit`, each byte's lowest bit first, as a bit stream that fills bytes
/// from their low end reads them. `n` is at most 56, and the eight bytes from the one `bit` is in
/// must be there.
pub fn bits_at(b: Bytes, bit: Int, n: Int) -> Int / {abort.raise} =
  word_at(b, bit >>> 3) >>> (bit & 7) & (1 << n) - 1

/// `b` from its first byte that is not zero: a big-endian number in its fewest bytes, none for zero.
pub fn strip_leading_zeros(b: Bytes) -> Bytes / {abort.raise} =
  bytes_slice(b, scan(b, 0, b"\x00"), bytes_len(b))

/// A hash as every table in the language spells it back: lowercase hex, two characters a byte. This
/// is the form a key crosses in, and the form a caller computing one has to match.
pub fn hex_of(b: Bytes) -> String / {abort.raise} = radix::encode(radix::hex(), b)

/// The bytes a hex string names: the inverse of `hex_of`. Raises on a text `hex_of` does not
/// write: an odd length, or a character that is not a lowercase hex digit. `std.hex`'s `decode`
/// answers `None` for one instead.
pub fn bytes_of_hex(text: String) -> Bytes / {abort.raise} =
  match radix::decode(radix::hex(), text) {
    Some(b) -> b,
    None -> panic("not lowercase hex, two digits a byte: " ++ text),
  }

fn compare_from(a: Bytes, b: Bytes, i: Int) -> Ordering / {abort.raise} =
  if i >= bytes_len(a) { if i >= bytes_len(b) { Equal } else { Less } }
  else if i >= bytes_len(b) { Greater } else {
    let x = bytes_at(a, i);
    let y = bytes_at(b, i);
    if x < y { Less } else if x > y { Greater } else { compare_from(a, b, i + 1) }
  }

test "compare is the lexicographic order, and a prefix sorts first" {
  assert_eq(compare(b"", b""), Equal);
  assert_eq(compare(b"", b"a"), Less);
  assert_eq(compare(b"a", b""), Greater);
  assert_eq(compare(b"a", b"a"), Equal);
  assert_eq(compare(b"a", b"b"), Less);
  assert_eq(compare(b"b", b"a"), Greater);
  assert_eq(compare(b"a", b"aa"), Less);
  assert_eq(compare(b"ab", b"aa"), Greater)
}

test "repeat repeats, and a non-positive count is the empty bytes" {
  assert_eq(repeat(b"ab", 3), b"ababab");
  assert_eq(repeat(b"ab", 0), b"");
  assert_eq(repeat(b"ab", 0 - 2), b"");
  assert_eq(repeat(b"", 5), b"");
  assert_eq(bytes_len(repeat(b"x", 1024)), 1024)
}

test "leading zeros are stripped, and only leading ones" {
  assert_eq(strip_leading_zeros(b"\x00\x00\x01\x00"), b"\x01\x00");
  assert_eq(strip_leading_zeros(b"\x01\x00"), b"\x01\x00");
  assert_eq(strip_leading_zeros(b"\x00\x00"), b"");
  assert_eq(strip_leading_zeros(b""), b"")
}

/// A decimal integer in ASCII: an optional `-`, then one or more digits, and nothing else. `None`
/// for anything else, and for a number past what an `Int` holds.
pub fn int_of_ascii(b: Bytes) -> Option<Int> / {abort.raise} = int_of_ascii_radix(b, 10)

/// An integer in ASCII in `radix`: an optional `-`, then one or more digits, each `0-9`, `a-z` or
/// `A-Z` and below the radix, and nothing else: no `+`, no prefix such as `0x`, no separator and
/// no blank. `None` for anything else, and for a number past what an `Int` holds. Raises for a
/// radix outside `2..=36`.
pub fn int_of_ascii_radix(b: Bytes, radix: Int) -> Option<Int> / {abort.raise} =
  if radix < 2 || radix > 36 { panic("a radix is 2 to 36") } else {
    let negative = bytes_len(b) > 0 && bytes_at(b, 0) == 45;
    let start = if negative { 1 } else { 0 };
    if start >= bytes_len(b) { None } else {
      match digits_below(b, start, radix, 0) {
        Some(below) -> if negative { Some(below) } else { checked_neg(below) },
        None -> None,
      }
    }
  }

/// The value of the digit `c` of a radix up to 36, in either case, or `-1` for any other byte.
pub fn digit_value(c: Int) -> Int =
  if c >= 48 && c <= 57 { c - 48 }
  else if c >= 97 && c <= 122 { c - 87 }
  else if c >= 65 && c <= 90 { c - 55 }
  else { -1 }

/// The digits from `i` on, read below zero, because the least `Int` has no positive twin.
fn digits_below(b: Bytes, i: Int, radix: Int, acc: Int) -> Option<Int> / {abort.raise} =
  if i >= bytes_len(b) { Some(acc) } else {
    let d = digit_value(bytes_at(b, i));
    if d < 0 || d >= radix { None } else {
      match checked_mul(acc, radix) {
        None -> None,
        Some(scaled) -> match checked_sub(scaled, d) {
          None -> None,
          Some(next) -> digits_below(b, i + 1, radix, next),
        },
      }
    }
  }

test "a decimal integer reads back, signed, over the whole Int range" {
  assert_eq(int_of_ascii(b"0"), Some(0));
  assert_eq(int_of_ascii(b"42"), Some(42));
  assert_eq(int_of_ascii(b"-42"), Some(0 - 42));
  assert_eq(int_of_ascii(b"007"), Some(7));
  assert_eq(int_of_ascii(b"9223372036854775807"), Some(9223372036854775807));
  assert_eq(int_of_ascii(b"-9223372036854775808"), Some(0 - 9223372036854775807 - 1))
}

test "an integer reads in any radix, in either case, and its digits are below the radix" {
  assert_eq(int_of_ascii_radix(b"ff", 16), Some(255));
  assert_eq(int_of_ascii_radix(b"-FF", 16), Some(0 - 255));
  assert_eq(int_of_ascii_radix(b"-8000000000000000", 16), Some(0 - 9223372036854775807 - 1));
  assert_eq(int_of_ascii_radix(b"8000000000000000", 16), None);
  assert_eq(int_of_ascii_radix(b"zz", 36), Some(1295));
  assert_eq(int_of_ascii_radix(b"12", 2), None);
  assert_eq(int_of_ascii_radix(b"0x10", 16), None);
  assert_eq(map([47, 48, 57, 58, 64, 65, 90, 91, 96, 97, 122, 123], digit_value), [
    -1,
    0,
    9,
    -1,
    -1,
    10,
    35,
    -1,
    -1,
    10,
    35,
    -1,
  ]);
  assert_eq(try[abort.raise] { int_of_ascii_radix(b"1", 37) }, Err("a radix is 2 to 36"))
}

test "anything but an optional minus and digits is refused, and so is a number past Int" {
  assert_eq(int_of_ascii(b""), None);
  assert_eq(int_of_ascii(b"-"), None);
  assert_eq(int_of_ascii(b"+1"), None);
  assert_eq(int_of_ascii(b"7.5"), None);
  assert_eq(int_of_ascii(b" 7"), None);
  assert_eq(int_of_ascii(b"1_000"), None);
  assert_eq(int_of_ascii(b"0x10"), None);
  assert_eq(int_of_ascii(b"9223372036854775808"), None);
  assert_eq(int_of_ascii(b"-9223372036854775809"), None);
  assert_eq(int_of_ascii(b"99999999999999999999"), None)
}

test "peek and the scans read the end of the bytes as where they stop" {
  assert_eq(peek(b"ab", 1), 98);
  assert_eq(peek(b"ab", 2), -1);
  assert_eq(peek(b"ab", -1), -1);
  assert_eq(scan(b"  x", 0, b" "), 2);
  assert_eq(scan(b"   ", 0, b" "), 3);
  assert_eq(scan(b"ab", 5, b" "), 2);
  assert_eq(scan_until(b"ab,c", 0, b","), 2);
  assert_eq(scan_until(b"abc", 1, b","), 3)
}

test "a pattern cycles to any length, in steps that do not grow with it" {
  assert_eq(cycle(b"abc", 8), b"abcabcab");
  assert_eq(cycle(b"abc", 3), b"abc");
  assert_eq(cycle(b"abc", 2), b"ab");
  assert_eq(cycle(b"x", 5), b"xxxxx");
  assert_eq(cycle(b"", 5), b"");
  assert_eq(cycle(b"abc", 0), b"");
  assert_eq(cycle(b"abc", -1), b"");
  assert_eq(cycle(b"ab", 100000), repeat(b"ab", 50000));
  assert(metered(|| cycle(b"x", 1000000)).steps < 32)
}

test "one byte is changed, and a place the bytes do not hold is no place to change" {
  assert_eq(with_byte(b"abc", 0, 120), b"xbc");
  assert_eq(with_byte(b"abc", 2, 0), b"ab\x00");
  let past: Result<Bytes, String> = try[abort.raise] { with_byte(b"abc", 3, 120) };
  let wide: Result<Bytes, String> = try[abort.raise] { with_byte(b"abc", 1, 256) };
  assert(match past { Err(_) -> true, Ok(_) -> false });
  assert(match wide { Err(_) -> true, Ok(_) -> false })
}

test "bytes are cut into pieces of the sizes given in turn, and the pieces are the bytes" {
  assert_eq(pieces(b"abcdefgh", [1, 3]), [b"a", b"bcd", b"e", b"fgh"]);
  assert_eq(pieces(b"abcde", [2]), [b"ab", b"cd", b"e"]);
  assert_eq(pieces(b"abc", [0, -5, 9]), [b"a", b"b", b"c"]);
  assert_eq(pieces(b"abc", [9223372036854775807]), [b"abc"]);
  assert_eq(pieces(b"abc", []), [b"abc"]);
  assert_eq(pieces(b"", [3]), [])
}

law "bytes cut into pieces are the pieces joined"
  forall (x: Bytes, sizes: List<Int>) {
    bytes_concat_all(pieces(x, sizes)) == x
  }

test "two places agree for as long as their bytes do, and no longer than asked" {
  let b = b"abcdefgh-abcdefgX-abcdefgh";
  assert_eq(agreeing(b, 0, 9, 17, 0), 7);
  assert_eq(agreeing(b, 0, 18, 8, 0), 8);
  assert_eq(agreeing(b, 0, 18, 5, 0), 5);
  assert_eq(agreeing(b, 0, 18, 8, 4), 8);
  assert_eq(agreeing(b, 0, 1, 8, 0), 0);
  assert_eq(agreeing(b, 3, 3, 0, 0), 0)
}

test "a word is eight bytes with the first lowest, and bits are read from a byte's low end" {
  let b = b"\x01\x02\x03\x04\x05\x06\x07\x88\xff";
  assert_eq(word_at(b, 0), 0x8807_0605_0403_0201);
  assert(word_at(b, 0) < 0);
  assert_eq(word_at(b, 1) & 0xFF, 2);
  assert_eq(word_at(b, 1) >>> 56, 0xFF);
  assert_eq(bits_at(b, 0, 1), 1);
  assert_eq(bits_at(b, 0, 0), 0);
  assert_eq(bits_at(b, 1, 8), 0);
  assert_eq(bits_at(b, 4, 8), 0x20);
  assert_eq(bits_at(b, 7, 56), word_at(b, 0) >>> 7 & 0xFF_FFFF_FFFF_FFFF);
  let past: Result<Int, String> = try[abort.raise] { word_at(b, 2) };
  assert(match past { Err(_) -> true, Ok(_) -> false })
}

test "a hex digit's value in either case, a decimal integer in ASCII, and a C string" {
  assert_eq(map([48, 57, 97, 102, 65, 70, 103], hex_value), [0, 9, 10, 15, 10, 15, -1]);
  assert_eq(map([32, 9, 10, 13, 11, 160, -1], is_blank), [
    true,
    true,
    false,
    false,
    false,
    false,
    false,
  ]);
  assert_eq(ascii_of_int(0 - 42), b"-42");
  assert_eq(int_of_ascii(ascii_of_int(9223372036854775807)), Some(9223372036854775807));
  assert_eq(cstring("ab"), b"ab\x00")
}

test "hex is lowercase, two digits a byte, and reads back" {
  assert_eq(hex_of(b"\x00\x0f\xa5\xff"), "000fa5ff");
  assert_eq(hex_of(b""), "");
  assert_eq(bytes_of_hex("000fa5ff"), b"\x00\x0f\xa5\xff");
  assert_eq(bytes_of_hex(""), b"");
  assert_eq(bytes_concat_all(map(range(0, 16), hex_digit)), b"0123456789abcdef")
}

test "hex takes at most a step a byte either way, and allocates only as its answer grows" {
  let within = |got: Int, most: Int|
    assert(got <= most, Some(int_to_string(got) ++ " is past " ++ int_to_string(most)));
  let written = |b: Bytes| metered(|| hex_of(b));
  let read = |b: Bytes| {
    let text = hex_of(b);
    metered(|| bytes_of_hex(text))
  };
  let short = repeat(b"\x5a\xc3", 32);
  let long = repeat(b"\x5a\xc3", 544);
  within(written(long).steps - written(short).steps, 1024);
  within(read(long).steps - read(short).steps, 1024);
  within(written(long).allocations - written(short).allocations, 8);
  within(read(long).allocations - read(short).allocations, 8);
  // A digest is what most calls are handed.
  let digest = repeat(b"\x5a", 32);
  within(written(digest).steps, 48);
  within(read(digest).steps, 52);
  within(written(digest).allocations, 10);
  within(read(digest).allocations, 12)
}

test "a text hex_of does not write is refused whole, never read in part" {
  let read = |text: String| try[abort.raise] { bytes_of_hex(text) };
  assert_eq(read("abc"), Err("not lowercase hex, two digits a byte: abc"));
  assert_eq(read("AB"), Err("not lowercase hex, two digits a byte: AB"));
  assert_eq(read("0g"), Err("not lowercase hex, two digits a byte: 0g"));
  assert_eq(read("ab"), Ok(b"\xab"))
}

test "contains finds a part, and replace swaps every occurrence left to right" {
  assert(contains(b"abcabc", b"ca"));
  assert(!contains(b"abc", b"x"));
  assert_eq(replace(b"a.b.c", b".", b"::"), b"a::b::c");
  assert_eq(replace(b"aaa", b"aa", b"b"), b"ba");
  assert_eq(replace(b"abc", b"", b"x"), b"abc");
  assert_eq(replace(b"abc", b"z", b"x"), b"abc")
}
