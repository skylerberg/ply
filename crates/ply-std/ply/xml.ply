//! XML 1.0 (Fifth Edition) with Namespaces in XML 1.0: a reader that answers a document as events, the
//! tree built from them, a writer that escapes, and the `xml"..."` literal.
//!
//! A document type declaration is refused outright, as `Doctype`, wherever it stands. That is a
//! deliberate departure: a conforming non-validating processor reads a `<!DOCTYPE ...>` and the
//! entities and attribute defaults its internal subset declares, and this module reads no document
//! that holds one. With no declaration there is no external entity to fetch, no parameter entity and
//! no entity to expand, so the only references are `&lt;`, `&gt;`, `&amp;`, `&apos;`, `&quot;` and the
//! numbered ones, each of which must name a character a document may hold. Every reader takes
//! `Limits`, and none nests deeper than `deepest()` whatever they say.
//!
//! `start` and `next` are the reader: a `Cursor` over the bytes and a step from it to the next
//! `Event` and the cursor past it, so a caller stops where it likes, `skip`s a subtree, or builds one
//! with `subtree`. Every well-formedness and namespace rule is checked there, and `read` and `parse`
//! are the tree those events build. Character data, references and CDATA sections between two pieces
//! of markup are one `Characters` event and one `Text` node: a CDATA section is not told from the
//! text it holds. Line ends are read as line feeds (§2.11) and an attribute's value as §3.3.3
//! normalizes one of type CDATA, which with no declaration every attribute is.
//!
//! A `Name` is a namespace name and a local name. The prefix a document spelled it with and the
//! namespace declarations an element carried are kept as `Spelling`s: `write` spells a tree as it was
//! read, and no comparison reads them, so two trees that differ in prefixes alone are `==`. `write`
//! declares a namespace where a name first needs one, inventing `ns1`, `ns2` and on where a tree
//! gives no prefix, and refuses a tree no document can hold rather than write something that reads
//! back as another: `parse(write(d, Compact), limits)` is `d` for every tree it writes.
//!
//! UTF-8 is read with or without a byte order mark, and UTF-16 under one; any other encoding is
//! refused by name. A refusal carries its byte offset, line and column in the document as UTF-8,
//! which for a UTF-16 document is not its own bytes. `write` writes UTF-8.
//!
//! With `import std.xml`, `xml"<a href={chars(url)}>{rows}</a>"` is an `Element`: the literal's text
//! is read as one element when the program is checked, and each hole is a `List<Node>` that stands
//! as its nodes in content and as their text in an attribute's value, so nothing a hole holds is
//! read as markup.

import std.bytes
import std.bytes (hex_value, peek, scan, scan_until, starts_at)
import std.laws (agrees, idempotent)
import std.list (any, at_or, drop, find_index, first, flat_map, index_of, is_empty, take)
import std.option (option_unwrap_or)
import std.string (ascii_lower, ascii_trim)

/// The namespace the prefix `xml` is bound to in every document.
pub fn xml_namespace() -> String = "http://www.w3.org/XML/1998/namespace"

/// The namespace of namespace declarations themselves, which no name is written in.
pub fn xmlns_namespace() -> String = "http://www.w3.org/2000/xmlns/"

/// The most elements any reader here has open at once, and the deepest tree `write` writes. The
/// tree's own functions nest a few calls a level, so a document is bounded where they still return.
pub fn deepest() -> Int = 1000

// --- The tree -----------------------------------------------------------------------

/// What a document spelled and no comparison reads: every `Spelling` is `==` every other, so a
/// value compares by the rest of what it holds.
pub type Spelling<a> = | Spelling(a)

key for Spelling by unread

fn unread<a>(_: Spelling<a>) -> Unit = ()

/// What a `Spelling` holds.
pub fn spelled<a>(s: Spelling<a>) -> a = match s { Spelling(x) -> x }

/// An element's or an attribute's name: its namespace name, `""` for none, and its local name.
/// `prefix` is the one it was written with, `""` for none, which `write` uses where it can.
pub type Name = new { namespace: String, local: String, prefix: Spelling<String> }

/// A name in no namespace.
pub fn name(local: String) -> Name = { namespace: "", local: local, prefix: Spelling("") }

/// A name in `namespace`, for `write` to spell with whatever prefix is in scope.
pub fn qualified(namespace: String, local: String) -> Name =
  { namespace: namespace, local: local, prefix: Spelling("") }

/// A name in `namespace` that `write` spells with `prefix` where that prefix is free.
pub fn prefixed(namespace: String, prefix: String, local: String) -> Name =
  { namespace: namespace, local: local, prefix: Spelling(prefix) }

/// An attribute: its name, and its value with references replaced and white space normalized.
pub type Attribute = new { name: Name, value: String }

/// An attribute.
pub fn attr(name: Name, value: String) -> Attribute = { name: name, value: value }

/// A namespace declaration: `xmlns:prefix="namespace"`, or `xmlns="namespace"` where `prefix` is
/// `""`. The default one with `namespace` `""` puts unprefixed elements back in no namespace.
pub type Binding = new { prefix: String, namespace: String }

/// What may stand anywhere in a document and is none of its data: a comment's text, or a processing
/// instruction's target and data.
pub type Misc = | Comment(String) | Instruction(String, String)

/// One child of an element.
pub type Node = | Element(Element) | Text(String) | Misc(Misc)

/// An element: its name, its attributes in document order with no namespace declaration among them,
/// and its children. `declared` is the declarations its start tag carried, in order.
pub type Element = new {
  name: Name,
  attributes: List<Attribute>,
  children: List<Node>,
  declared: Spelling<List<Binding>>,
}

/// An element with no declarations of its own. Text nodes side by side become one and an empty one
/// is dropped, which is how a document reads them back.
pub fn element(name: Name, attributes: List<Attribute>, children: List<Node>) -> Element =
  {
    name: name,
    attributes: attributes,
    children: settled(fold(children, { nodes: [], text: [] }, joining)),
    declared: Spelling([]),
  }

type Joining = { nodes: List<Node>, text: List<Bytes> }

fn joining(j: Joining, node: Node) -> Joining =
  match node {
    Text(t) -> { ..j, text: push(j.text, bytes_of_string(t)) },
    _ -> { nodes: push(settled(j), node), text: [] },
  }

fn settled(j: Joining) -> List<Node> = {
  let text = string_of_bytes_lossy(bytes_concat_all(j.text));
  if text == "" { j.nodes } else { push(j.nodes, Text(text)) }
}

/// An XML declaration: its version, the encoding it names, and what it says of `standalone`.
pub type Declaration = new { version: String, encoding: Option<String>, standalone: Option<Bool> }

/// A document: its root element and the comments and instructions before and after it.
/// `declaration` is the XML declaration it opened with.
pub type Document = new {
  declaration: Spelling<Option<Declaration>>,
  before: List<Misc>,
  root: Element,
  after: List<Misc>,
}

/// The document that is `root` and nothing else.
pub fn document(root: Element) -> Document =
  { declaration: Spelling(None), before: [], root: root, after: [] }

// --- Refusals -----------------------------------------------------------------------

/// Why a reader refused bytes, or `write` a tree.
pub type Why =
  /// A document type declaration, which this module reads no part of.
  | Doctype
  /// An encoding other than UTF-8, or UTF-16 under a byte order mark, by the name the document
  /// declares or its first bytes show.
  | Encoding(String)
  /// Bytes that are not UTF-8.
  | NotUtf8
  /// UTF-16 with half a code unit, or a surrogate that has no pair.
  | NotUtf16
  /// A character a document cannot hold where it stands, by its code point: a control other than
  /// tab, line feed and carriage return, U+FFFE or U+FFFF; and for `write` a carriage return in a
  /// comment or an instruction, which a reader would answer as a line feed.
  | IllegalChar(Int)
  /// The document ends inside its root element or inside a piece of markup.
  | Truncated
  /// The document holds no element.
  | NoRoot
  /// Text, a reference, a CDATA section, an end tag or a second element outside the root element.
  | OutsideRoot
  /// A `<` that opens nothing a document holds.
  | BadMarkup
  /// A name is missing where one must stand, or has a colon where namespaces allow none.
  | BadName
  /// A tag malformed past its name: an attribute with no space before it, a `/` with no `>`, or
  /// anything in an end tag but its name.
  | BadTag
  /// An attribute with no `=`, or a value with no quotes.
  | BadAttribute
  /// A `<` in an attribute's value.
  | LessThanInValue
  /// An attribute an element holds twice, by its name as written: twice under one spelling, or
  /// under two prefixes bound to one namespace.
  | DuplicateAttribute(String)
  /// An end tag that does not close the open element, whose name as written this carries.
  | Mismatched(String)
  /// `--` inside a comment, or a comment that ends in `-`.
  | DoubleHyphen
  /// `]]>` in text.
  | CDataEnd
  /// A processing instruction whose target is `xml` in any case, with no space after its target,
  /// or, for `write`, whose data holds `?>` or begins with white space.
  | BadInstruction
  /// An XML declaration that is malformed, or whose version is not `1.` and digits.
  | BadDeclaration
  /// An `&` that begins no `&name;`, `&#digits;` or `&#xhex;`.
  | BadReference
  /// A reference to an entity other than the five XML predefines, by its name.
  | UnknownEntity(String)
  /// A numbered reference to what is no character of a document, by its number; one past
  /// `0x110000` is answered as that.
  | IllegalReference(Int)
  /// A prefix no declaration in scope binds.
  | UnboundPrefix(String)
  /// A namespace declaration no document may hold, by its prefix: `xmlns` declared, `xml` bound to
  /// another name, a prefix bound to either reserved name or to none, or, for `write`, a prefix
  /// declared twice on one element. Also a name written with the prefix `xmlns`.
  | BadNamespace(String)
  /// For `write`: a local name, a prefix or an instruction's target that is not a name without a
  /// colon, or an attribute in no namespace called `xmlns`.
  | NotAName(String)
  /// For `write`: an empty text node, or two side by side, which no document reads back as it is.
  | SplitText
  /// Elements nested past `Limits.max_depth` or `deepest()`.
  | TooDeep
  /// More attributes on an element than `Limits.max_attributes`.
  | TooManyAttributes
  /// A name longer than `Limits.max_name_bytes`.
  | NameTooLong
  /// Text, a value, a comment or an instruction's data longer than `Limits.max_text_bytes`.
  | TextTooLong
  /// More events than `Limits.max_events`.
  | TooManyEvents
  /// A document longer than `Limits.max_document_bytes`.
  | TooLarge

/// A reader's refusal: why, and where in the document as UTF-8, by byte offset and by line and
/// column, each from 1, the column in characters.
pub type Refusal = new { at: Int, line: Int, column: Int, why: Why }

/// What this module raises where it refuses.
pub effect xml {
  /// The bytes are not a document this module reads.
  raise refused(e: Refusal)
  /// The tree is not one a document can hold.
  raise unwritable(why: Why)
}

/// A place in a document: a byte offset, and the line and column it falls on, each from 1.
pub type Position = new { offset: Int, line: Int, column: Int }

/// Where `offset` falls in `data`, read as UTF-8: a line ends at a line feed, a carriage return, or
/// the two together, and a column counts characters, a leading byte order mark not among them.
/// Takes time in the bytes before `offset`.
pub fn position(data: Bytes, offset: Int) -> Position / {abort.raise} = {
  let at = min(max(offset, 0), bytes_len(data));
  let marked = if bytes_starts_with(data, b"\xef\xbb\xbf") { 3 } else { 0 };
  let line = line_of(data, at, min(marked, at), 1, at + 1);
  { offset: at, line: line.number, column: column_of(data, line.from, at, 1) }
}

fn line_of(
  data: Bytes,
  at: Int,
  from: Int,
  number: Int,
  left: Int,
) -> { from: Int, number: Int } / {abort.raise} = {
  let stop = if from >= at { at } else { bytes_scan_until(data, from, b"\r\n", at - from) };
  if stop >= at || left <= 0 { { from: from, number: number } } else {
    let paired = bytes_at(data, stop) == b'\r' && peek(data, stop + 1) == b'\n';
    let next = if paired { stop + 2 } else { stop + 1 };
    if next > at { { from: from, number: number } }
    else { line_of(data, at, next, number + 1, left - 1) }
  }
}

fn column_of(data: Bytes, i: Int, at: Int, column: Int) -> Int / {abort.raise} =
  if i >= at { column } else {
    column_of(data, i + 1, at, if bytes_at(data, i) & 0xC0 == 0x80 { column } else { column + 1 })
  }

fn refuse_at<a>(data: Bytes, at: Int, why: Why) -> a / {xml.refused, abort.raise} = {
  let p = position(data, at);
  xml.refused({ at: p.offset, line: p.line, column: p.column, why: why })
}

// --- Characters ---------------------------------------------------------------------

type Point = { point: Int, width: Int }

/// The character at `i` of well-formed UTF-8 and how many bytes it takes; `-1` past the end.
fn point_at(data: Bytes, i: Int) -> Point / {abort.raise} = {
  let b = peek(data, i);
  if b < 0x80 { { point: b, width: if b < 0 { 0 } else { 1 } } }
  else if b < 0xE0 { { point: (b & 0x1F) << 6 | six(data, i + 1), width: 2 } } else if b < 0xF0 {
    { point: (b & 0x0F) << 12 | six(data, i + 1) << 6 | six(data, i + 2), width: 3 }
  } else {
    {
      point: (b & 0x07) << 18 | six(data, i + 1) << 12 | six(data, i + 2) << 6 | six(data, i + 3),
      width: 4,
    }
  }
}

fn six(data: Bytes, i: Int) -> Int / {abort.raise} = max(peek(data, i), 0) & 0x3F

fn continuation(b: Int) -> Bool = b >= 0x80 && b <= 0xBF

/// How many bytes the well-formed UTF-8 character at `i` takes, or 0 where none stands.
fn utf8_width(data: Bytes, i: Int) -> Int / {abort.raise} = {
  let b = peek(data, i + 1);
  let c = continuation(peek(data, i + 2));
  let d = continuation(peek(data, i + 3));
  match bytes_at(data, i) {
    0x00..=0x7F -> 1,
    0xC2..=0xDF -> if continuation(b) { 2 } else { 0 },
    0xE0 -> if b >= 0xA0 && b <= 0xBF && c { 3 } else { 0 },
    0xED -> if b >= 0x80 && b <= 0x9F && c { 3 } else { 0 },
    0xE1..=0xEF -> if continuation(b) && c { 3 } else { 0 },
    0xF0 -> if b >= 0x90 && b <= 0xBF && c && d { 4 } else { 0 },
    0xF4 -> if b >= 0x80 && b <= 0x8F && c && d { 4 } else { 0 },
    0xF1..=0xF3 -> if continuation(b) && c && d { 4 } else { 0 },
    _ -> 0,
  }
}

/// The length of the longest prefix of `data` that is whole UTF-8 characters.
fn utf8_prefix(data: Bytes, i: Int, left: Int) -> Int / {abort.raise} =
  if i >= bytes_len(data) || left <= 0 { i } else {
    let width = utf8_width(data, i);
    if width == 0 { i } else { utf8_prefix(data, i + width, left - 1) }
  }

fn controls() -> Bytes =
  b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x0b\x0c\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f"

/// Where the first character of UTF-8 `data` that no document holds stands, and its code point;
/// the length of `data` where there is none.
fn unfit(data: Bytes) -> { at: Int, point: Int } / {abort.raise} = {
  let n = bytes_len(data);
  let control = scan_until(data, 0, controls());
  let fffe = option_unwrap_or(bytes_index_of(data, b"\xef\xbf\xbe"), n);
  let ffff = option_unwrap_or(bytes_index_of(data, b"\xef\xbf\xbf"), n);
  let at = min(control, min(fffe, ffff));
  if at >= n { { at: n, point: -1 } }
  else if at == control { { at: at, point: bytes_at(data, at) } }
  else { { at: at, point: if at == fffe { 0xFFFE } else { 0xFFFF } } }
}

/// Whether a numbered reference may name `n`: the `Char` production.
fn is_char(n: Int) -> Bool =
  match n {
    0x9 | 0xA | 0xD | 0x20..=0xD7FF | 0xE000..=0xFFFD | 0x10000..=0x10FFFF -> true,
    _ -> false,
  }

fn starts_name(point: Int) -> Bool =
  match point {
    b':' | b'A'..=b'Z' | b'_' | b'a'..=b'z' -> true,
    0xC0..=0xD6 | 0xD8..=0xF6 | 0xF8..=0x2FF | 0x370..=0x37D | 0x37F..=0x1FFF -> true,
    0x200C..=0x200D | 0x2070..=0x218F | 0x2C00..=0x2FEF | 0x3001..=0xD7FF -> true,
    0xF900..=0xFDCF | 0xFDF0..=0xFFFD | 0x10000..=0xEFFFF -> true,
    _ -> false,
  }

fn continues_name(point: Int) -> Bool =
  starts_name(point)
    || (match point {
      b'-' | b'.' | b'0'..=b'9' | 0xB7 | 0x300..=0x36F | 0x203F..=0x2040 -> true,
      _ -> false,
    })

fn name_bytes() -> Bytes = b"-.0123456789:ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz"

fn point_before(data: Bytes, i: Int, limit: Int) -> Point / {abort.raise} =
  if i >= limit { { point: -1, width: 0 } } else { point_at(data, i) }

/// Where the name that begins at `i` ends, reading no byte at or past `limit`; `i` where none
/// begins.
fn name_end(data: Bytes, i: Int, limit: Int) -> Int / {abort.raise} = {
  let head = point_before(data, i, limit);
  if starts_name(head.point) { name_rest(data, i + head.width, limit, limit - i) } else { i }
}

fn name_rest(data: Bytes, i: Int, limit: Int, left: Int) -> Int / {abort.raise} = {
  let j = min(scan(data, i, name_bytes()), limit);
  let next = point_before(data, j, limit);
  if next.point < 0x80 || !continues_name(next.point) || left <= 0 { j }
  else { name_rest(data, j + next.width, limit, left - 1) }
}

/// Whether `raw` is a name with no colon.
fn uncolonized(raw: Bytes) -> Bool / {abort.raise} =
  bytes_len(raw) > 0 && !bytes::contains(raw, b":")
    && name_end(raw, 0, bytes_len(raw)) == bytes_len(raw)

fn white() -> Bytes = b" \t\n\r"

fn is_white(b: Int) -> Bool = b == b' ' || b == b'\t' || b == b'\n' || b == b'\r'

/// `b` with each carriage return, and the line feed after it where there is one, as a line feed.
fn line_ends(b: Bytes) -> Bytes / {abort.raise} =
  if bytes::contains(b, b"\r") { bytes::replace(bytes::replace(b, b"\r\n", b"\n"), b"\r", b"\n") }
  else { b }

fn joined(pieces: List<Bytes>) -> Bytes =
  match pieces { [] -> b"", [only] -> only, _ -> bytes_concat_all(pieces) }

// --- The reader: a cursor -----------------------------------------------------------

/// What a reader may spend on one document. A limit that is not positive admits nothing of its
/// kind.
pub type Limits = new {
  /// Elements open at once; never more than `deepest()`.
  max_depth: Int,
  /// Attributes on one element, its namespace declarations among them.
  max_attributes: Int,
  /// Bytes in one name as written, its prefix and colon among them.
  max_name_bytes: Int,
  /// Bytes in one run of text, one attribute's value, one comment or one instruction's data.
  max_text_bytes: Int,
  /// Events a document is read as: an element is two, and text, a comment or an instruction one.
  max_events: Int,
  /// Bytes in the whole document.
  max_document_bytes: Int,
}

/// 256 levels, 256 attributes, names of 1 KiB, text of 4 MiB, four million events and 64 MiB.
pub fn default_limits() -> Limits =
  {
    max_depth: 256,
    max_attributes: 256,
    max_name_bytes: 1024,
    max_text_bytes: 4194304,
    max_events: 4000000,
    max_document_bytes: 67108864,
  }

type Stage = | Prolog | Content | Epilog

/// An open element: its name as written and as resolved, and what its start tag replaced, which
/// its end puts back: the scope, and the element names read under that scope when it declared any.
type Opened = {
  tag: Bytes,
  name: Name,
  outer: Map<String, String>,
  known: Option<Map<Bytes, Name>>,
}

type Open = | Outermost | Within(Opened, Open)

/// Where a reader stands in a document: `data` is the document as UTF-8 and `at` the offset of what
/// `next` reads. The rest is the reader's own: the elements open and the namespaces in scope.
pub type Cursor = new {
  data: Bytes,
  at: Int,
  limits: Limits,
  stage: Stage,
  open: Open,
  depth: Int,
  scope: Map<String, String>,
  tags: Map<Bytes, Name>,
  plain: Map<Bytes, Name>,
  closing: Bool,
  events: Int,
  sound: Int,
  flaw: Why,
  wide: Bool,
}

/// A start tag: the element's name, its attributes in document order, and the namespace
/// declarations it carried, which are not among the attributes.
pub type Start = new { name: Name, attributes: List<Attribute>, declared: List<Binding> }

/// One piece of a document, in the order it is written.
pub type Event =
  /// The XML declaration, which only a document's first event is.
  | XmlDeclaration(Declaration)
  /// A start tag, or the start of an empty-element tag, which an `EndElement` follows at once.
  | StartElement(Start)
  /// The end of the element of this name.
  | EndElement(Name)
  /// Text between two pieces of markup inside the root element, never empty: its character data,
  /// references and CDATA sections as the characters they stand for.
  | Characters(String)
  /// A comment or a processing instruction.
  | Aside(Misc)

/// An event, the offset in `Cursor.data` at which it begins, and the cursor past it.
pub type Step = new { event: Event, at: Int, rest: Cursor }

/// A cursor at the start of `data`: past a byte order mark, with UTF-16 read as UTF-8. Raises
/// `xml.refused` for an encoding this module does not read and for a document past
/// `max_document_bytes`.
pub fn start(data: Bytes, limits: Limits) -> Cursor / {xml.refused, abort.raise} = {
  let a = peek(data, 0);
  let b = peek(data, 1);
  let four = (a << 24 | max(b, 0) << 16 | max(peek(data, 2), 0) << 8 | max(peek(data, 3), 0))
    & 0xFFFF_FFFF;
  if bytes_len(data) > limits.max_document_bytes { refuse_at(b"", 0, TooLarge) }
  else if a == 0xEF && b == 0xBB && peek(data, 2) == 0xBF { begun(data, 3, false, limits) }
  else if bytes_len(data) >= 4 && unread_encoding(four) != "" {
    refuse_at(b"", 0, Encoding(unread_encoding(four)))
  } else if a == 0xFE && b == 0xFF { begun(narrowed(data, true), 0, true, limits) }
  else if a == 0xFF && b == 0xFE { begun(narrowed(data, false), 0, true, limits) }
  else { begun(data, 0, false, limits) }
}

/// The encoding a document's first four bytes show that this module does not read, or `""`.
fn unread_encoding(four: Int) -> String =
  match four {
    0x0000_FEFF | 0xFFFE_0000 | 0x0000_003C | 0x3C00_0000 -> "UCS-4",
    0x003C_003F -> "UTF-16BE",
    0x3C00_3F00 -> "UTF-16LE",
    0x4C6F_A794 -> "EBCDIC",
    _ -> "",
  }

fn begun(data: Bytes, origin: Int, wide: Bool, limits: Limits) -> Cursor / {abort.raise} = {
  let n = bytes_len(data);
  let whole = if bytes_is_utf8(data) { n } else { utf8_prefix(data, 0, n) };
  let odd = unfit(data);
  {
    data: data,
    at: origin,
    limits: { ..limits, max_depth: min(limits.max_depth, deepest()) },
    stage: Prolog,
    open: Outermost,
    depth: 0,
    scope: map_new(),
    tags: map_new(),
    plain: map_new(),
    closing: false,
    events: 0,
    sound: min(odd.at, whole),
    flaw: if odd.at < whole { IllegalChar(odd.point) } else { NotUtf8 },
    wide: wide,
  }
}

type Wide = { chars: List<Char>, high: Int, bad: Bool }

/// UTF-16 under its byte order mark, as UTF-8.
fn narrowed(data: Bytes, big: Bool) -> Bytes / {xml.refused, abort.raise} = {
  let units = (bytes_len(data) - 2) / 2;
  let read = fold(range(0, units), { chars: [], high: -1, bad: false }, |w: Wide, k: Int| {
    let first_byte = bytes_at(data, 2 + 2 * k);
    let second_byte = bytes_at(data, 3 + 2 * k);
    widened(w, if big { first_byte << 8 | second_byte } else { second_byte << 8 | first_byte })
  });
  let text = bytes_of_string(string_of_chars(read.chars));
  if read.bad || read.high >= 0 || bytes_len(data) % 2 != 0 {
    refuse_at(text, bytes_len(text), NotUtf16)
  } else { text }
}

fn widened(w: Wide, unit: Int) -> Wide =
  if w.bad { w } else if w.high >= 0 {
    if unit >= 0xDC00 && unit <= 0xDFFF {
      with_char({ ..w, high: -1 }, 0x10000 + (w.high - 0xD800 << 10) + (unit - 0xDC00))
    } else { { ..w, bad: true } }
  } else if unit >= 0xD800 && unit <= 0xDBFF { { ..w, high: unit } }
  else { with_char(w, unit) }

fn with_char(w: Wide, point: Int) -> Wide =
  match char_of_int(point) {
    Some(ch) -> { ..w, chars: push(w.chars, ch) },
    None -> { ..w, bad: true },
  }

/// Refuses at `at`, or at the first byte no document holds where that stands at or before it.
fn refuse<a>(c: Cursor, at: Int, why: Why) -> a / {xml.refused, abort.raise} =
  if c.sound < bytes_len(c.data) && c.sound <= at { refuse_at(c.data, c.sound, c.flaw) }
  else { refuse_at(c.data, at, why) }

/// The bytes from `from` to `to`, which are characters a document may hold or the reader refuses.
fn piece(c: Cursor, from: Int, to: Int) -> Bytes / {xml.refused, abort.raise} =
  if to > c.sound { refuse_at(c.data, c.sound, c.flaw) } else { bytes_slice(c.data, from, to) }

fn limited(c: Cursor, at: Int, text: Bytes) -> String / {xml.refused, abort.raise} =
  if bytes_len(text) > c.limits.max_text_bytes { refuse(c, at, TextTooLong) }
  else { string_of_bytes(text) }

fn answer(c: Cursor, at: Int, event: Event, rest: Cursor) -> Step / {xml.refused, abort.raise} =
  if c.events >= c.limits.max_events { refuse(c, at, TooManyEvents) }
  else { { event: event, at: at, rest: { ..rest, events: c.events + 1 } } }

/// The next event of the document and the cursor past it, or `None` where the document has ended
/// as one must: its root element closed and nothing but comments, instructions and white space
/// after. Raises `xml.refused` where the document is not well formed, is not namespace-well-formed,
/// holds a document type declaration or passes a limit, at the first byte that makes it so.
pub fn next(c: Cursor) -> Option<Step> / {xml.refused, abort.raise} =
  if c.closing { Some(closed(c, c.at, c.at)) } else {
    match c.stage {
      Prolog -> Some(before_root(c)),
      Content -> Some(inside(c)),
      Epilog -> after_root(c),
    }
  }

fn before_root(c: Cursor) -> Step / {xml.refused, abort.raise} =
  if c.events == 0 && starts_at(c.data, c.at, b"<?xml") && is_white(peek(c.data, c.at + 5)) {
    declaration(c)
  } else {
    let i = scan(c.data, c.at, white());
    let b = peek(c.data, i);
    if b < 0 { refuse(c, i, NoRoot) }
    else if b != b'<' { refuse(c, i, OutsideRoot) }
    else { markup(c, i) }
  }

fn after_root(c: Cursor) -> Option<Step> / {xml.refused, abort.raise} = {
  let i = scan(c.data, c.at, white());
  let b = peek(c.data, i + 1);
  if i >= bytes_len(c.data) { None }
  else if peek(c.data, i) == b'<' && (b == b'?' || b == b'!') { Some(markup(c, i)) }
  else { refuse(c, i, OutsideRoot) }
}

fn inside(c: Cursor) -> Step / {xml.refused, abort.raise} = {
  let b = peek(c.data, c.at);
  if b < 0 { refuse(c, c.at, Truncated) }
  else if b == b'<' && !(peek(c.data, c.at + 1) == b'!' && starts_at(c.data, c.at, b"<![CDATA[")) {
    markup(c, c.at)
  } else {
    let run = text_run(c, c.at, [], bytes_len(c.data) - c.at + 1);
    if bytes_len(run.bytes) > 0 {
      answer(c, c.at, Characters(limited(c, c.at, run.bytes)), { ..c, at: run.next })
    } else if run.next >= bytes_len(c.data) { refuse(c, run.next, Truncated) }
    else { markup(c, run.next) }
  }
}

/// The event the `<` at `i` begins.
fn markup(c: Cursor, i: Int) -> Step / {xml.refused, abort.raise} =
  match peek(c.data, i + 1) {
    b'?' -> {
      let read = instruction(c, i);
      answer(c, i, Aside(Instruction(read.target, read.data)), { ..c, at: read.next })
    },
    b'!' -> if starts_at(c.data, i, b"<!--") {
      let read = comment(c, i);
      answer(c, i, Aside(Comment(read.text)), { ..c, at: read.next })
    } else if starts_at(c.data, i, b"<!DOCTYPE") { refuse(c, i, Doctype) }
    else if starts_at(c.data, i, b"<![CDATA[") { refuse(c, i, OutsideRoot) }
    else { refuse(c, i, BadMarkup) },
    b'/' -> end_tag(c, i),
    _ -> start_tag(c, i),
  }

// --- The reader: text and references ------------------------------------------------

type Run = { bytes: Bytes, next: Int }

/// The text from `i` to the next markup: each run of character data as it stands, each reference as
/// its character, each CDATA section as what it holds.
fn text_run(c: Cursor, i: Int, pieces: List<Bytes>, left: Int) -> Run / {xml.refused, abort.raise} = {
  let stop = scan_until(c.data, i, b"<&]\r");
  let held = if stop > i { push(pieces, piece(c, i, stop)) } else { pieces };
  if left <= 0 { panic("more pieces of text than bytes") } else {
    match peek(c.data, stop) {
      b'&' -> {
        let named = reference(c, stop);
        text_run(c, named.next, push(held, named.bytes), left - 1)
      },
      b']' -> brackets(c, stop, held, left),
      b'\r' -> {
        let next = if peek(c.data, stop + 1) == b'\n' { stop + 2 } else { stop + 1 };
        text_run(c, next, push(held, b"\n"), left - 1)
      },
      b'<' -> if starts_at(c.data, stop, b"<![CDATA[") { section(c, stop, held, left) }
      else { { bytes: joined(held), next: stop } },
      _ -> { bytes: joined(held), next: stop },
    }
  }
}

fn brackets(c: Cursor, i: Int, held: List<Bytes>, left: Int) -> Run / {xml.refused, abort.raise} = {
  let end = scan(c.data, i, b"]");
  if end - i >= 2 && peek(c.data, end) == b'>' { refuse(c, end - 2, CDataEnd) }
  else if left <= 0 { panic("more pieces of text than bytes") }
  else { text_run(c, end, push(held, piece(c, i, end)), left - 1) }
}

fn section(c: Cursor, i: Int, held: List<Bytes>, left: Int) -> Run / {xml.refused, abort.raise} =
  match bytes_index_of_from(c.data, b"]]>", i + 9) {
    None -> refuse(c, i, Truncated),
    Some(end) -> if left <= 0 { panic("more pieces of text than bytes") }
    else { text_run(c, end + 3, push(held, line_ends(piece(c, i + 9, end))), left - 1) },
  }

/// The character the reference whose `&` stands at `i` names, as UTF-8.
fn reference(c: Cursor, i: Int) -> Run / {xml.refused, abort.raise} =
  if peek(c.data, i + 1) == b'#' { numbered(c, i) } else {
    let end = name_end(c.data, i + 1, c.sound);
    if end == i + 1 || peek(c.data, end) != b';' { refuse(c, i, BadReference) }
    else { { bytes: entity(c, i, piece(c, i + 1, end)), next: end + 1 } }
  }

fn entity(c: Cursor, i: Int, named: Bytes) -> Bytes / {xml.refused, abort.raise} =
  match named {
    b"lt" -> b"<",
    b"gt" -> b">",
    b"amp" -> b"&",
    b"apos" -> b"'",
    b"quot" -> b"\"",
    _ -> refuse(c, i, UnknownEntity(string_of_bytes(named))),
  }

fn numbered(c: Cursor, i: Int) -> Run / {xml.refused, abort.raise} = {
  let hex = peek(c.data, i + 2) == b'x';
  let from = if hex { i + 3 } else { i + 2 };
  let end = scan(c.data, from, if hex { b"0123456789ABCDEFabcdef" } else { b"0123456789" });
  let base = if hex { 16 } else { 10 };
  if end == from || peek(c.data, end) != b';' { refuse(c, i, BadReference) } else {
    let n = fold(range(from, end), 0, |acc: Int, k: Int|
      min(acc * base + hex_value(bytes_at(c.data, k)), 0x110000));
    match char_of_int(if is_char(n) { n } else { -1 }) {
      Some(ch) -> { bytes: bytes_of_string(string_of_chars([ch])), next: end + 1 },
      None -> refuse(c, i, IllegalReference(n)),
    }
  }
}

// --- The reader: tags ---------------------------------------------------------------

type Raw = { name: Bytes, value: String, at: Int }

type Tag = { raws: List<Raw>, next: Int, empty: Bool }

type Bound = {
  scope: Map<String, String>,
  declared: List<Binding>,
  seen: Map<Bytes, Unit>,
  plain: List<Raw>,
}

type Resolved = {
  attributes: List<Attribute>,
  expanded: Map<(String, String), Unit>,
  plain: Map<Bytes, Name>,
}

fn start_tag(c: Cursor, i: Int) -> Step / {xml.refused, abort.raise} = {
  let end = name_end(c.data, i + 1, c.sound);
  if end == i + 1 { refuse(c, i, if i + 1 >= bytes_len(c.data) { Truncated } else { BadMarkup }) }
  else if c.stage == Epilog { refuse(c, i, OutsideRoot) }
  else if end - i - 1 > c.limits.max_name_bytes { refuse(c, i + 1, NameTooLong) }
  else if c.depth >= c.limits.max_depth { refuse(c, i, TooDeep) }
  else { opened(c, i, piece(c, i + 1, end), attributes(c, end, [], bytes_len(c.data) - end + 1)) }
}

/// The attributes from `i`, as written, to the `>` or `/>` that ends the tag.
fn attributes(c: Cursor, i: Int, acc: List<Raw>, left: Int) -> Tag / {xml.refused, abort.raise} = {
  let j = scan(c.data, i, white());
  let b = peek(c.data, j);
  if b == b'>' { { raws: acc, next: j + 1, empty: false } } else if b == b'/' {
    if peek(c.data, j + 1) == b'>' { { raws: acc, next: j + 2, empty: true } }
    else { refuse(c, j, BadTag) }
  } else if b < 0 { refuse(c, j, Truncated) }
  else if j == i { refuse(c, j, BadTag) }
  else if len(acc) >= c.limits.max_attributes { refuse(c, j, TooManyAttributes) }
  else if left <= 0 { panic("more attributes than bytes") } else {
    let read = raw_attribute(c, j);
    attributes(c, read.next, push(acc, read.raw), left - 1)
  }
}

fn raw_attribute(c: Cursor, i: Int) -> { raw: Raw, next: Int } / {xml.refused, abort.raise} = {
  let end = name_end(c.data, i, c.sound);
  let equals = scan(c.data, end, white());
  let quote = scan(c.data, equals + 1, white());
  if end == i { refuse(c, i, BadName) }
  else if end - i > c.limits.max_name_bytes { refuse(c, i, NameTooLong) }
  else if peek(c.data, equals) != b'=' { refuse(c, equals, BadAttribute) }
  else if peek(c.data, quote) != b'"' && peek(c.data, quote) != b'\'' {
    refuse(c, quote, BadAttribute)
  } else {
    let read = value(c, quote + 1, bytes_at(c.data, quote), [], bytes_len(c.data) - quote);
    {
      raw: { name: piece(c, i, end), value: limited(c, quote, read.bytes), at: i },
      next: read.next,
    }
  }
}

/// An attribute's value from `i` to its closing `quote`, normalized: each reference as its
/// character, and each literal tab, line feed and line end as a space.
fn value(
  c: Cursor,
  i: Int,
  quote: Int,
  pieces: List<Bytes>,
  left: Int,
) -> Run / {xml.refused, abort.raise} = {
  let stop = scan_until(c.data, i, if quote == b'"' { b"\"<&\t\n\r" } else { b"'<&\t\n\r" });
  let held = if stop > i { push(pieces, piece(c, i, stop)) } else { pieces };
  let b = peek(c.data, stop);
  if b == quote { { bytes: joined(held), next: stop + 1 } }
  else if b < 0 { refuse(c, stop, Truncated) }
  else if b == b'<' { refuse(c, stop, LessThanInValue) }
  else if left <= 0 { panic("more pieces of a value than bytes") } else if b == b'&' {
    let named = reference(c, stop);
    value(c, named.next, quote, push(held, named.bytes), left - 1)
  } else {
    let paired = b == b'\r' && peek(c.data, stop + 1) == b'\n';
    value(c, if paired { stop + 2 } else { stop + 1 }, quote, push(held, b" "), left - 1)
  }
}

/// The start tag whose `<` stands at `i`, with its declarations bound and its names resolved. A
/// name is resolved once for each scope it is read under, and every element of that name holds the
/// one value.
fn opened(c: Cursor, i: Int, tag: Bytes, read: Tag) -> Step / {xml.refused, abort.raise} = {
  let bound = fold(
    read.raws,
    { scope: c.scope, declared: [], seen: map_new(), plain: [] },
    |b: Bound, raw: Raw| declare(c, b, raw),
  );
  let rescoped = !is_empty(bound.declared);
  let known = if rescoped { None } else { map_get(c.tags, tag) };
  let named = match known { Some(name) -> name, None -> element_name(c, i + 1, tag, bound.scope) };
  let tags = match known {
    Some(_) -> c.tags,
    None -> map_insert(if rescoped { map_new() } else { c.tags }, tag, named),
  };
  let resolved = fold(
    bound.plain,
    { attributes: [], expanded: map_new(), plain: c.plain },
    |r: Resolved, raw: Raw| resolve(c, bound.scope, r, raw),
  );
  answer(
    c,
    i,
    StartElement({ name: named, attributes: resolved.attributes, declared: bound.declared }),
    {
      ..c,
      at: read.next,
      stage: Content,
      open: Within(
        {
          tag: tag,
          name: named,
          outer: c.scope,
          known: if rescoped { Some(c.tags) } else { None },
        },
        c.open,
      ),
      depth: c.depth + 1,
      scope: bound.scope,
      tags: tags,
      plain: resolved.plain,
      closing: read.empty,
    },
  )
}

fn declare(c: Cursor, b: Bound, raw: Raw) -> Bound / {xml.refused, abort.raise} =
  if map_contains(b.seen, raw.name) {
    refuse(c, raw.at, DuplicateAttribute(string_of_bytes(raw.name)))
  } else {
    let seen: Bound = { ..b, seen: map_insert(b.seen, raw.name, ()) };
    if raw.name == b"xmlns" { bind(c, seen, raw, "") }
    else if bytes_starts_with(raw.name, b"xmlns:") {
      bind(c, seen, raw, local_of(c, raw.at, bytes_slice(raw.name, 6, bytes_len(raw.name))))
    } else { { ..seen, plain: push(seen.plain, raw) } }
  }

fn bind(c: Cursor, b: Bound, raw: Raw, prefix: String) -> Bound / {xml.refused, abort.raise} =
  if !bindable(prefix, raw.value) { refuse(c, raw.at, BadNamespace(prefix)) } else {
    {
      ..b,
      scope: map_insert(b.scope, prefix, raw.value),
      declared: push(b.declared, { prefix: prefix, namespace: raw.value }),
    }
  }

/// Whether a declaration may bind `prefix`, `""` for the default, to `namespace`.
fn bindable(prefix: String, namespace: String) -> Bool =
  if prefix == "xmlns" { false }
  else if prefix == "xml" { namespace == xml_namespace() }
  else if namespace == xml_namespace() || namespace == xmlns_namespace() { false }
  else { prefix == "" || namespace != "" }

type QName = { prefix: String, local: String }

fn qname(c: Cursor, at: Int, raw: Bytes) -> QName / {xml.refused, abort.raise} =
  match bytes_index_of_byte(raw, b':') {
    None -> { prefix: "", local: string_of_bytes(raw) },
    Some(colon) -> if colon == 0 { refuse(c, at, BadName) } else {
      {
        prefix: string_of_bytes(bytes_slice(raw, 0, colon)),
        local: local_of(c, at, bytes_slice(raw, colon + 1, bytes_len(raw))),
      }
    },
  }

fn local_of(c: Cursor, at: Int, raw: Bytes) -> String / {xml.refused, abort.raise} =
  if uncolonized(raw) { string_of_bytes(raw) } else { refuse(c, at, BadName) }

fn bound_to(
  c: Cursor,
  at: Int,
  prefix: String,
  scope: Map<String, String>,
) -> String / {xml.refused, abort.raise} =
  if prefix == "xml" { xml_namespace() }
  else if prefix == "xmlns" { refuse(c, at, BadNamespace(prefix)) } else {
    match map_get(scope, prefix) { Some(uri) -> uri, None -> refuse(c, at, UnboundPrefix(prefix)) }
  }

fn element_name(
  c: Cursor,
  at: Int,
  tag: Bytes,
  scope: Map<String, String>,
) -> Name / {xml.refused, abort.raise} = {
  let q = qname(c, at, tag);
  let namespace = if q.prefix == "" { option_unwrap_or(map_get(scope, ""), "") }
  else { bound_to(c, at, q.prefix, scope) };
  { namespace: namespace, local: q.local, prefix: Spelling(q.prefix) }
}

fn resolve(
  c: Cursor,
  scope: Map<String, String>,
  r: Resolved,
  raw: Raw,
) -> Resolved / {xml.refused, abort.raise} =
  match map_get(r.plain, raw.name) {
    Some(known) -> { ..r, attributes: push(r.attributes, { name: known, value: raw.value }) },
    None -> {
      let q = qname(c, raw.at, raw.name);
      let namespace = if q.prefix == "" { "" } else { bound_to(c, raw.at, q.prefix, scope) };
      let named: Name = { namespace: namespace, local: q.local, prefix: Spelling(q.prefix) };
      let held = push(r.attributes, { name: named, value: raw.value });
      if namespace == "" { { ..r, attributes: held, plain: map_insert(r.plain, raw.name, named) } }
      else if map_contains(r.expanded, (namespace, q.local)) {
        refuse(c, raw.at, DuplicateAttribute(string_of_bytes(raw.name)))
      } else {
        { ..r, attributes: held, expanded: map_insert(r.expanded, (namespace, q.local), ()) }
      }
    },
  }

fn end_tag(c: Cursor, i: Int) -> Step / {xml.refused, abort.raise} =
  match c.open {
    Outermost -> refuse(c, i, OutsideRoot),
    Within(top, _) -> {
      let after = i + 2 + bytes_len(top.tag);
      let close = scan(c.data, after, white());
      let longer = continues_name(point_before(c.data, after, c.sound).point);
      if !starts_at(c.data, i + 2, top.tag) || longer {
        refuse(c, i, Mismatched(string_of_bytes(top.tag)))
      } else if peek(c.data, close) == b'>' { closed(c, i, close + 1) }
      else { refuse(c, close, if close >= bytes_len(c.data) { Truncated } else { BadTag }) }
    },
  }

/// The end, begun at `from`, of the innermost open element, with the cursor at `at` and the scope as
/// it was outside.
fn closed(c: Cursor, from: Int, at: Int) -> Step / {xml.refused, abort.raise} =
  match c.open {
    Outermost -> refuse(c, from, OutsideRoot),
    Within(top, below) ->
      answer(c, from, EndElement(top.name), {
        ..c,
        at: at,
        open: below,
        depth: c.depth - 1,
        scope: top.outer,
        tags: match top.known { Some(outer) -> outer, None -> c.tags },
        closing: false,
        stage: match below { Outermost -> Epilog, Within(_, _) -> Content },
      }),
  }

// --- The reader: comments, instructions and the declaration -------------------------

fn comment(c: Cursor, i: Int) -> { text: String, next: Int } / {xml.refused, abort.raise} =
  match bytes_index_of_from(c.data, b"--", i + 4) {
    None -> refuse(c, i, Truncated),
    Some(end) -> if peek(c.data, end + 2) != b'>' {
      refuse(c, end, if end + 2 >= bytes_len(c.data) { Truncated } else { DoubleHyphen })
    } else { { text: limited(c, i, line_ends(piece(c, i + 4, end))), next: end + 3 } },
  }

type Instructed = { target: String, data: String, next: Int }

fn instruction(c: Cursor, i: Int) -> Instructed / {xml.refused, abort.raise} = {
  let end = name_end(c.data, i + 2, c.sound);
  let target = piece(c, i + 2, end);
  if end == i + 2 || !uncolonized(target) { refuse(c, i + 2, BadName) }
  else if end - i - 2 > c.limits.max_name_bytes { refuse(c, i + 2, NameTooLong) }
  else if ascii_lower(string_of_bytes(target)) == "xml" { refuse(c, i, BadInstruction) }
  else if starts_at(c.data, end, b"?>") {
    { target: string_of_bytes(target), data: "", next: end + 2 }
  } else if end >= bytes_len(c.data) { refuse(c, end, Truncated) }
  else if !is_white(peek(c.data, end)) { refuse(c, end, BadInstruction) } else {
    let from = scan(c.data, end, white());
    match bytes_index_of_from(c.data, b"?>", from) {
      None -> refuse(c, i, Truncated),
      Some(close) ->
        {
          target: string_of_bytes(target),
          data: limited(c, i, line_ends(piece(c, from, close))),
          next: close + 2,
        },
    }
  }
}

type Pseudo = { name: Bytes, value: Bytes, at: Int, next: Int }

/// One `name="value"` of an XML declaration after the white space that must lead it, or `None`
/// where the declaration's `?>` stands.
fn pseudo(c: Cursor, i: Int) -> Option<Pseudo> / {xml.refused, abort.raise} = {
  let from = scan(c.data, i, white());
  let end = scan(c.data, from, b"abcdefghijklmnopqrstuvwxyz");
  let equals = scan(c.data, end, white());
  let quote = scan(c.data, equals + 1, white());
  let mark = peek(c.data, quote);
  if starts_at(c.data, from, b"?>") { None }
  else if from == i || end == from || peek(c.data, equals) != b'=' {
    refuse(c, from, if from >= bytes_len(c.data) { Truncated } else { BadDeclaration })
  } else if mark != b'"' && mark != b'\'' { refuse(c, quote, BadDeclaration) } else {
    match bytes_index_of_from(c.data, bytes_slice(c.data, quote, quote + 1), quote + 1) {
      None -> refuse(c, quote, Truncated),
      Some(close) ->
        Some({
          name: piece(c, from, end),
          value: piece(c, quote + 1, close),
          at: quote + 1,
          next: close + 1,
        }),
    }
  }
}

fn declaration(c: Cursor) -> Step / {xml.refused, abort.raise} =
  match pseudo(c, c.at + 5) {
    None -> refuse(c, c.at, BadDeclaration),
    Some(version) -> if version.name != b"version" || !is_version(version.value) {
      refuse(c, version.at, BadDeclaration)
    } else {
      let second = pseudo(c, version.next);
      let encoding = match second {
        Some(p) -> if p.name == b"encoding" { second } else { None },
        None -> None,
      };
      let standalone = match encoding { Some(p) -> pseudo(c, p.next), None -> second };
      let end = match standalone {
        Some(p) -> p.next,
        None -> match encoding { Some(p) -> p.next, None -> version.next },
      };
      let close = scan(c.data, end, white());
      if !starts_at(c.data, close, b"?>") { refuse(c, close, BadDeclaration) } else {
        answer(
          c,
          c.at,
          XmlDeclaration({
            version: string_of_bytes(version.value),
            encoding: declared_encoding(c, encoding),
            standalone: declared_standalone(c, standalone),
          }),
          { ..c, at: close + 2 },
        )
      }
    },
  }

fn is_version(text: Bytes) -> Bool / {abort.raise} =
  bytes_len(text) > 2 && bytes_starts_with(text, b"1.")
    && scan(text, 2, b"0123456789") == bytes_len(text)

fn declared_encoding(c: Cursor, p: Option<Pseudo>) -> Option<String> / {xml.refused, abort.raise} =
  match p {
    None -> None,
    Some(named) -> {
      let letters = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz";
      let rest = scan(named.value, 1, bytes_concat(letters, b"0123456789._-"));
      let text = string_of_bytes(named.value);
      if scan(named.value, 0, letters) == 0 || rest != bytes_len(named.value) {
        refuse(c, named.at, BadDeclaration)
      } else if ascii_lower(text) != (if c.wide { "utf-16" } else { "utf-8" }) {
        refuse(c, named.at, Encoding(text))
      } else { Some(text) }
    },
  }

fn declared_standalone(c: Cursor, p: Option<Pseudo>) -> Option<Bool> / {xml.refused, abort.raise} =
  match p {
    None -> None,
    Some(said) -> if said.name == b"standalone" && said.value == b"yes" { Some(true) }
    else if said.name == b"standalone" && said.value == b"no" { Some(false) }
    else { refuse(c, said.at, BadDeclaration) },
  }

// --- The reader: trees --------------------------------------------------------------

type Frame = { start: Start, children: List<Node> }

type Frames = | Ground | Upon(Frame, Frames)

/// Every event of the document `data` holds, in order.
pub fn events(data: Bytes, limits: Limits) -> List<Event> / {xml.refused, abort.raise} =
  listed(start(data, limits), [], bytes_len(data) + 2)

fn listed(c: Cursor, acc: List<Event>, left: Int) -> List<Event> / {xml.refused, abort.raise} =
  match next(c) {
    None -> acc,
    Some(step) -> if left <= 0 { panic("more events than bytes") }
    else { listed(step.rest, push(acc, step.event), left - 1) },
  }

/// The element whose `start` was the last event read, and the cursor past its end.
pub fn subtree(
  start: Start,
  c: Cursor,
) -> { element: Element, rest: Cursor } / {xml.refused, abort.raise} =
  grown(Upon({ start: start, children: [] }, Ground), c, bytes_len(c.data) - c.at + 2)

fn grown(
  frames: Frames,
  c: Cursor,
  left: Int,
) -> { element: Element, rest: Cursor } / {xml.refused, abort.raise} =
  match next(c) {
    None -> refuse(c, c.at, Truncated),
    Some(step) -> if left <= 0 { panic("more events than bytes") } else {
      match step.event {
        StartElement(s) -> grown(Upon({ start: s, children: [] }, frames), step.rest, left - 1),
        EndElement(_) -> match frames {
          Ground -> refuse(c, c.at, OutsideRoot),
          Upon(top, below) -> match below {
            Ground -> { element: built(top), rest: step.rest },
            Upon(_, _) -> grown(holding(below, Element(built(top))), step.rest, left - 1),
          },
        },
        Characters(t) -> grown(holding(frames, Text(t)), step.rest, left - 1),
        Aside(m) -> grown(holding(frames, Misc(m)), step.rest, left - 1),
        XmlDeclaration(_) -> grown(frames, step.rest, left - 1),
      }
    },
  }

fn built(f: Frame) -> Element =
  {
    name: f.start.name,
    attributes: f.start.attributes,
    children: f.children,
    declared: Spelling(f.start.declared),
  }

fn holding(frames: Frames, node: Node) -> Frames =
  match frames {
    Ground -> Ground,
    Upon(top, below) -> Upon({ start: top.start, children: push(top.children, node) }, below),
  }

/// The cursor past the end of the element whose start was the last event read. What it passes is
/// checked as it would be read.
pub fn skip(c: Cursor) -> Cursor / {xml.refused, abort.raise} =
  skipped(c, 0, bytes_len(c.data) - c.at + 2)

fn skipped(c: Cursor, inner: Int, left: Int) -> Cursor / {xml.refused, abort.raise} =
  match next(c) {
    None -> refuse(c, c.at, Truncated),
    Some(step) -> if left <= 0 { panic("more events than bytes") } else {
      match step.event {
        StartElement(_) -> skipped(step.rest, inner + 1, left - 1),
        EndElement(_) -> if inner == 0 { step.rest }
        else { skipped(step.rest, inner - 1, left - 1) },
        _ -> skipped(step.rest, inner, left - 1),
      }
    },
  }

type Prologue = { declaration: Option<Declaration>, before: List<Misc> }

/// The document `data` holds. Raises `xml.refused` where `next` would.
pub fn read(data: Bytes, limits: Limits) -> Document / {xml.refused, abort.raise} =
  rooted(start(data, limits), { declaration: None, before: [] }, bytes_len(data) + 2)

fn rooted(c: Cursor, p: Prologue, left: Int) -> Document / {xml.refused, abort.raise} =
  match next(c) {
    None -> refuse(c, c.at, NoRoot),
    Some(step) -> if left <= 0 { panic("more events than bytes") } else {
      match step.event {
        XmlDeclaration(d) -> rooted(step.rest, { ..p, declaration: Some(d) }, left - 1),
        Aside(m) -> rooted(step.rest, { ..p, before: push(p.before, m) }, left - 1),
        StartElement(s) -> {
          let root = subtree(s, step.rest);
          {
            declaration: Spelling(p.declaration),
            before: p.before,
            root: root.element,
            after: trailing(root.rest, [], left),
          }
        },
        _ -> refuse(c, c.at, OutsideRoot),
      }
    },
  }

fn trailing(c: Cursor, acc: List<Misc>, left: Int) -> List<Misc> / {xml.refused, abort.raise} =
  match next(c) {
    None -> acc,
    Some(step) -> if left <= 0 { panic("more events than bytes") } else {
      match step.event {
        Aside(m) -> trailing(step.rest, push(acc, m), left - 1),
        _ -> refuse(c, c.at, OutsideRoot),
      }
    },
  }

/// The document `data` holds, or why and where it is not one this module reads.
pub fn parse(data: Bytes, limits: Limits) -> Result<Document, Refusal> / {abort.raise} =
  try { read(data, limits) }

// --- The writer ---------------------------------------------------------------------

/// How `write` lays a document out.
pub type Layout =
  /// Nothing but what the tree holds, so the document reads back as the tree.
  | Compact
  /// A line to each piece of the document, and to each child of an element that holds no text,
  /// indented by this many spaces a level. An element that holds text is written as `Compact`
  /// writes it, whatever is inside it, so no text gains white space.
  | Indented(Int)

type Look = { indent: Int, level: Int, flat: Bool }

type Scope = Map<String, String>

/// What one start tag binds: `taken` is each prefix it declares or relies on, and `order` the
/// declarations it writes.
type Claims = { taken: Scope, order: List<Binding> }

type Named = { text: Bytes, claims: Claims }

type Attributing = { claims: Claims, pieces: List<Bytes>, seen: Map<(String, String), Unit> }

type Filling = { out: List<Bytes>, texted: Bool }

type Escape = { raw: Bytes, written: Bytes }

/// The document as UTF-8. A namespace is declared on the first element that needs it: under the
/// prefix its name was spelled with where that is free, under one already in scope where there is
/// one, and under `ns1`, `ns2` and on otherwise. An element's own `declared` are written as they
/// are, but a default one where the element itself is in no namespace. Raises `xml.unwritable` for
/// a tree no document can hold: see `Why`.
pub fn write(d: Document, layout: Layout) -> Bytes / {xml.unwritable, abort.raise} = {
  let look = match layout {
    Compact -> { indent: 0, level: 0, flat: true },
    Indented(n) -> { indent: max(n, 0), level: 0, flat: false },
  };
  let line = if look.flat { b"" } else { b"\n" };
  let head = match spelled(d.declaration) {
    Some(said) -> [declaration_out(said), line],
    None -> [],
  };
  let before = fold(d.before, head, |out: List<Bytes>, m: Misc| push(push(out, misc_out(m)), line));
  let root = element_out(d.root, map_new(), look, deepest(), before);
  let after = fold(d.after, root, |out: List<Bytes>, m: Misc| push(push(out, line), misc_out(m)));
  bytes_concat_all(push(after, line))
}

/// The document as UTF-8, or why no document can hold the tree.
pub fn encode(d: Document, layout: Layout) -> Result<Bytes, Why> / {abort.raise} =
  try { write(d, layout) }

fn declaration_out(d: Declaration) -> Bytes / {xml.unwritable, abort.raise} =
  if !is_version(bytes_of_string(d.version)) { xml.unwritable(BadDeclaration) } else {
    bytes_concat_all([
      b"<?xml version=\"",
      bytes_of_string(d.version),
      match d.encoding { Some(_) -> b"\" encoding=\"UTF-8", None -> b"" },
      match d.standalone {
        Some(alone) -> if alone { b"\" standalone=\"yes" } else { b"\" standalone=\"no" },
        None -> b"",
      },
      b"\"?>",
    ])
  }

fn misc_out(m: Misc) -> Bytes / {xml.unwritable, abort.raise} =
  match m {
    Comment(text) -> {
      let raw = fitting(text);
      if bytes::contains(raw, b"--") || bytes_ends_with(raw, b"-") { xml.unwritable(DoubleHyphen) }
      else if bytes::contains(raw, b"\r") { xml.unwritable(IllegalChar(b'\r')) }
      else { bytes_concat_all([b"<!--", raw, b"-->"]) }
    },
    Instruction(target, data) -> {
      let raw = fitting(data);
      if !is_name(target) { xml.unwritable(NotAName(target)) }
      else if ascii_lower(target) == "xml" || bytes::contains(raw, b"?>")
          || is_white(peek(raw, 0)) { xml.unwritable(BadInstruction) }
      else if bytes::contains(raw, b"\r") { xml.unwritable(IllegalChar(b'\r')) }
      else if bytes_len(raw) == 0 { bytes_concat_all([b"<?", bytes_of_string(target), b"?>"]) }
      else { bytes_concat_all([b"<?", bytes_of_string(target), b" ", raw, b"?>"]) }
    },
  }

/// The bytes of `text`, every character of which a document may hold.
fn fitting(text: String) -> Bytes / {xml.unwritable, abort.raise} = {
  let raw = bytes_of_string(text);
  let odd = unfit(raw);
  if odd.at < bytes_len(raw) { xml.unwritable(IllegalChar(odd.point)) } else { raw }
}

fn escaped(
  text: String,
  stops: Bytes,
  escapes: List<Escape>,
) -> Bytes / {xml.unwritable, abort.raise} = {
  let raw = fitting(text);
  if scan_until(raw, 0, stops) >= bytes_len(raw) { raw }
  else { fold(escapes, raw, |b: Bytes, e: Escape| bytes::replace(b, e.raw, e.written)) }
}

/// `&` first, so the `&` of a reference written for another character is not written again.
fn text_out(text: String) -> Bytes / {xml.unwritable, abort.raise} =
  escaped(text, b"&<>\r", [
    { raw: b"&", written: b"&amp;" },
    { raw: b"<", written: b"&lt;" },
    { raw: b">", written: b"&gt;" },
    { raw: b"\r", written: b"&#xD;" },
  ])

/// Tab, line feed and carriage return as references, since a reader makes a space of each one
/// written as itself.
fn value_out(text: String) -> Bytes / {xml.unwritable, abort.raise} =
  escaped(text, b"&<\"\t\n\r", [
    { raw: b"&", written: b"&amp;" },
    { raw: b"<", written: b"&lt;" },
    { raw: b"\"", written: b"&quot;" },
    { raw: b"\t", written: b"&#x9;" },
    { raw: b"\n", written: b"&#xA;" },
    { raw: b"\r", written: b"&#xD;" },
  ])

/// Whether `text` is a name with no colon.
fn is_name(text: String) -> Bool / {abort.raise} = uncolonized(bytes_of_string(text))

fn margin(look: Look) -> Bytes = bytes_concat(b"\n", bytes::repeat(b" ", look.indent * look.level))

fn element_out(
  e: Element,
  outer: Scope,
  look: Look,
  room: Int,
  out: List<Bytes>,
) -> List<Bytes> / {xml.unwritable, abort.raise} =
  if room <= 0 { xml.unwritable(TooDeep) } else {
    let tag = tag_out(e, outer, out);
    if is_empty(e.children) { push(tag.out, b"/>") } else {
      let flat = look.flat || any(e.children, |n: Node| match n { Text(_) -> true, _ -> false });
      let inner = { indent: look.indent, level: look.level + 1, flat: flat };
      let filled = fold(
        e.children,
        { out: push(tag.out, b">"), texted: false },
        |f: Filling, child: Node| child_out(child, tag.scope, inner, room - 1, f),
      );
      let closing = if flat { filled.out } else { push(filled.out, margin(look)) };
      push(push(push(closing, b"</"), tag.name), b">")
    }
  }

fn child_out(
  child: Node,
  scope: Scope,
  look: Look,
  room: Int,
  f: Filling,
) -> Filling / {xml.unwritable, abort.raise} = {
  let lead = if look.flat { f.out } else { push(f.out, margin(look)) };
  match child {
    Element(e) -> { out: element_out(e, scope, look, room, lead), texted: false },
    Text(t) -> if f.texted || t == "" { xml.unwritable(SplitText) }
    else { { out: push(lead, text_out(t)), texted: true } },
    Misc(m) -> { out: push(lead, misc_out(m)), texted: false },
  }
}

type Opening = { out: List<Bytes>, name: Bytes, scope: Scope }

/// The start tag of `e` up to where `>` or `/>` closes it, and the namespaces in scope inside it.
fn tag_out(e: Element, outer: Scope, out: List<Bytes>) -> Opening / {xml.unwritable, abort.raise} = {
  let declared = fold(spelled(e.declared), { taken: map_new(), order: [] }, claimed);
  let own = named(e.name, declared, outer, false);
  let written = fold(
    e.attributes,
    { claims: own.claims, pieces: [], seen: map_new() },
    |a: Attributing, x: Attribute| attribute_out(a, x, outer),
  );
  let opened_tag = push(push(out, b"<"), own.text);
  let bound = fold(written.claims.order, opened_tag, |o: List<Bytes>, b: Binding|
    push(push(push(o, declaring(b.prefix)), value_out(b.namespace)), b"\""));
  {
    out: fold(written.pieces, bound, |o: List<Bytes>, p: Bytes| push(o, p)),
    name: own.text,
    scope: map_merge(outer, written.claims.taken),
  }
}

fn declaring(prefix: String) -> Bytes =
  if prefix == "" { b" xmlns=\"" } else { bytes_of_string(" xmlns:" ++ prefix ++ "=\"") }

fn claimed(c: Claims, b: Binding) -> Claims / {xml.unwritable, abort.raise} =
  if !bindable(b.prefix, b.namespace) || map_contains(c.taken, b.prefix) {
    xml.unwritable(BadNamespace(b.prefix))
  } else if b.prefix != "" && !is_name(b.prefix) { xml.unwritable(NotAName(b.prefix)) }
  else { claim(c, b.prefix, b.namespace) }

fn claim(c: Claims, prefix: String, namespace: String) -> Claims =
  {
    taken: map_insert(c.taken, prefix, namespace),
    order: push(c.order, { prefix: prefix, namespace: namespace }),
  }

fn attribute_out(
  a: Attributing,
  x: Attribute,
  outer: Scope,
) -> Attributing / {xml.unwritable, abort.raise} = {
  let own = named(x.name, a.claims, outer, true);
  let key = (x.name.namespace, x.name.local);
  if map_contains(a.seen, key) { xml.unwritable(DuplicateAttribute(x.name.local)) } else {
    {
      claims: own.claims,
      pieces: push(
        push(push(push(push(a.pieces, b" "), own.text), b"=\""), value_out(x.value)),
        b"\"",
      ),
      seen: map_insert(a.seen, key, ()),
    }
  }
}

/// `n` as a start tag writes it, and what the tag binds once it has.
fn named(
  n: Name,
  claims: Claims,
  outer: Scope,
  attribute: Bool,
) -> Named / {xml.unwritable, abort.raise} =
  if !is_name(n.local) || (attribute && n.namespace == "" && n.local == "xmlns") {
    xml.unwritable(NotAName(n.local))
  } else if n.namespace == "" {
    {
      text: bytes_of_string(n.local),
      claims: if attribute { claims } else { undefaulted(claims, outer) },
    }
  } else if n.namespace == xml_namespace() {
    { text: bytes_of_string("xml:" ++ n.local), claims: claims }
  } else if n.namespace == xmlns_namespace() { xml.unwritable(BadNamespace("xmlns")) } else {
    let chosen = prefix_for(n.namespace, spelled(n.prefix), claims, outer, attribute);
    {
      text: bytes_of_string(if chosen.prefix == "" { n.local }
      else { chosen.prefix ++ ":" ++ n.local }),
      claims: chosen.claims,
    }
  }

/// `claims` with no default namespace in force, for an element in none: a default the element
/// declared is dropped, and one in scope around it is undeclared.
fn undefaulted(claims: Claims, outer: Scope) -> Claims = {
  let own = map_get(claims.taken, "");
  let inherited = option_unwrap_or(map_get(outer, ""), "");
  let without: Claims = {
    taken: map_remove(claims.taken, ""),
    order: filter(claims.order, |b: Binding| b.prefix != ""),
  };
  if own == Some("") { claims } else if inherited == "" { without } else { claim(without, "", "") }
}

type Chosen = { prefix: String, claims: Claims }

fn bound_in(claims: Claims, outer: Scope, prefix: String) -> Option<String> =
  match map_get(claims.taken, prefix) { Some(uri) -> Some(uri), None -> map_get(outer, prefix) }

/// The prefix a name in `namespace` is written with, `""` for none, and the tag's bindings with
/// that prefix taken.
fn prefix_for(
  namespace: String,
  hint: String,
  claims: Claims,
  outer: Scope,
  attribute: Bool,
) -> Chosen / {xml.unwritable, abort.raise} = {
  let usable = !(attribute && hint == "");
  if hint != "" && (!is_name(hint) || hint == "xml" || hint == "xmlns") {
    xml.unwritable(NotAName(hint))
  } else if usable && bound_in(claims, outer, hint) == Some(namespace) {
    { prefix: hint, claims: { ..claims, taken: map_insert(claims.taken, hint, namespace) } }
  } else if usable && !map_contains(claims.taken, hint) {
    { prefix: hint, claims: claim(claims, hint, namespace) }
  } else {
    let scope = map_merge(outer, claims.taken);
    let found = first(
      filter(map_entries(scope), |e: { key: String, value: String }|
        e.value == namespace && !(attribute && e.key == "")),
    );
    match found {
      Some(e) ->
        { prefix: e.key, claims: { ..claims, taken: map_insert(claims.taken, e.key, namespace) } },
      None -> {
        let fresh = invented(scope, 1, map_len(scope) + 1);
        { prefix: fresh, claims: claim(claims, fresh, namespace) }
      },
    }
  }
}

fn invented(scope: Scope, k: Int, left: Int) -> String / {abort.raise} = {
  let prefix = "ns" ++ int_to_string(k);
  if !map_contains(scope, prefix) { prefix }
  else if left <= 0 { panic("more prefixes in scope than the scope holds") }
  else { invented(scope, k + 1, left - 1) }
}

// --- Looking things up --------------------------------------------------------------

/// The value of the attribute `name`, whatever prefix it was written with.
pub fn attribute(e: Element, name: Name) -> Option<String> =
  match first(filter(e.attributes, |a: Attribute| a.name == name)) {
    Some(a) -> Some(a.value),
    None -> None,
  }

/// Every child element, in order.
pub fn elements(e: Element) -> List<Element> =
  fold(e.children, [], |found: List<Element>, n: Node|
    match n { Element(child) -> push(found, child), _ -> found })

/// Every child element named `name`, in order.
pub fn children(e: Element, name: Name) -> List<Element> =
  filter(elements(e), |child: Element| child.name == name)

/// The first child element named `name`.
pub fn child(e: Element, name: Name) -> Option<Element> = first(children(e, name))

/// Every element inside `e` named `name`, at any depth, in document order. `e` is not among them.
pub fn descendants(e: Element, name: Name) -> List<Element> = within(e, name, [])

fn within(e: Element, name: Name, found: List<Element>) -> List<Element> =
  fold(e.children, found, |acc: List<Element>, n: Node|
    match n {
      Element(child) ->
        within(child, name, if child.name == name { push(acc, child) } else { acc }),
      _ -> acc,
    })

/// All the text inside `e`, at any depth, in document order, with nothing between the pieces.
pub fn text(e: Element) -> String = string_of_bytes_lossy(bytes_concat_all(spoken(e, [])))

fn spoken(e: Element, said: List<Bytes>) -> List<Bytes> =
  fold(e.children, said, |acc: List<Bytes>, n: Node|
    match n {
      Element(child) -> spoken(child, acc),
      Text(t) -> push(acc, bytes_of_string(t)),
      Misc(_) -> acc,
    })

/// Every element a path of child names leads to from `e`, in document order. The path is names
/// separated by `/`, each a local name for an element in no namespace or `{namespace}local` for one
/// in a namespace: `channel/item`, `{http://www.w3.org/2005/Atom}entry`. An empty path is `e`
/// itself, and one that is not such a path leads nowhere.
pub fn find_all(e: Element, path: String) -> List<Element> / {abort.raise} =
  if path == "" { [e] } else {
    match steps(bytes_of_string(path), 0, [], string_len(path) + 1) {
      None -> [],
      Some(names) ->
        fold(names, [e], |from: List<Element>, name: Name|
          flat_map(from, |parent: Element| children(parent, name))),
    }
  }

/// The first element `find_all` answers.
pub fn find(e: Element, path: String) -> Option<Element> / {abort.raise} = first(find_all(e, path))

/// The names of a path from its segment at `i` on, or `None` where a `{` is never closed.
fn steps(path: Bytes, i: Int, names: List<Name>, left: Int) -> Option<List<Name>> / {abort.raise} = {
  let n = bytes_len(path);
  let braced = peek(path, i) == b'{';
  let closing = if braced { scan_until(path, i, b"}") } else { i - 1 };
  let end = scan_until(path, closing + 1, b"/");
  if closing >= n { None } else {
    let named = push(
      names,
      qualified(
        string_of_bytes(if braced { bytes_slice(path, i + 1, closing) } else { b"" }),
        string_of_bytes(bytes_slice(path, closing + 1, end)),
      ),
    );
    if end >= n || left <= 0 { Some(named) } else { steps(path, end + 1, named, left - 1) }
  }
}

/// `e` without the white space that only lays it out: in every element whose text is all white
/// space, at any depth, that text is dropped. What `write` adds under `Indented` is such text.
pub fn without_indentation(e: Element) -> Element = {
  let blank = |n: Node| match n { Text(t) -> ascii_trim(t) == "", _ -> true };
  let laid_out = fold(e.children, true, |all: Bool, n: Node| all && blank(n));
  {
    ..e,
    children: fold(e.children, [], |kept: List<Node>, n: Node|
      match n {
        Element(child) -> push(kept, Element(without_indentation(child))),
        Text(_) -> if laid_out { kept } else { push(kept, n) },
        Misc(_) -> push(kept, n),
      }),
  }
}

// --- The literal --------------------------------------------------------------------

/// What a refusal says, as a clause a message can end with.
pub fn explain(why: Why) -> String =
  match why {
    Doctype -> "a document type declaration, which is never read",
    Encoding(named) -> "the encoding " ++ named ++ ", which is not read",
    NotUtf8 -> "bytes that are not UTF-8",
    NotUtf16 -> "UTF-16 with half a code unit or an unpaired surrogate",
    IllegalChar(point) ->
      "the character " ++ int_to_string(point) ++ ", which no document holds here",
    Truncated -> "the document ends inside an element or a piece of markup",
    NoRoot -> "the document holds no element",
    OutsideRoot -> "only comments and instructions stand outside the root element",
    BadMarkup -> "a `<` opens a tag, a comment or an instruction: write `&lt;` for the character",
    BadName -> "a name is missing, or holds a colon where namespaces allow none",
    BadTag -> "a tag holds its name, then attributes each led by a space, then `>` or `/>`",
    BadAttribute -> "an attribute is its name, `=` and a quoted value",
    LessThanInValue -> "a value holds no `<`: write `&lt;` for the character",
    DuplicateAttribute(named) -> "the attribute " ++ named ++ " is written twice",
    Mismatched(named) -> "this end tag does not close " ++ named ++ ", the element open here",
    DoubleHyphen -> "a comment holds no `--` and does not end in `-`",
    CDataEnd -> "text holds no `]]>`: write `]]&gt;`",
    BadInstruction -> "an instruction is a target other than `xml`, a space, and data with no `?>`",
    BadDeclaration ->
      "an XML declaration is a version of `1.` and digits, then an encoding, then standalone",
    BadReference -> "an `&` begins a reference: write `&amp;` for the character",
    UnknownEntity(named) -> "the entity " ++ named ++ " is not one of lt, gt, amp, apos and quot",
    IllegalReference(point) ->
      "a reference to " ++ int_to_string(point) ++ ", which is no character of a document",
    UnboundPrefix(prefix) -> "no declaration in scope binds the prefix " ++ prefix,
    BadNamespace(prefix) -> "the prefix `" ++ prefix ++ "` is declared or used as no document may",
    NotAName(text) -> "`" ++ text ++ "` is not a name with no colon",
    SplitText -> "text nodes side by side, or an empty one",
    TooDeep -> "elements nested past the limit",
    TooManyAttributes -> "more attributes on an element than the limit",
    NameTooLong -> "a name longer than the limit",
    TextTooLong -> "text, a value, a comment or an instruction longer than the limit",
    TooManyEvents -> "more events than the limit",
    TooLarge -> "a document longer than the limit",
  }

/// A literal's markup once read: its element, with the texts between the holes wherever holes
/// stand.
pub type Template = new { root: Mold }

/// An element of a literal: each attribute's value and each run of text as the texts between its
/// holes, one more than the holes it has.
type Mold = new {
  name: Name,
  attributes: List<Valued>,
  children: List<Cast>,
  declared: List<Binding>,
}

type Valued = { name: Name, texts: List<String> }

type Cast = | Shaped(Mold) | Texts(List<String>) | Apart(Misc)

fn molded(e: Element) -> Mold / {abort.raise} =
  {
    name: e.name,
    attributes: map(e.attributes, |a: Attribute|
      { name: a.name, texts: string_split(a.value, "\u{fdd0}") }),
    children: map(e.children, |n: Node|
      match n {
        Element(child) -> Shaped(molded(child)),
        Text(t) -> Texts(string_split(t, "\u{fdd0}")),
        Misc(m) -> Apart(m),
      }),
    declared: spelled(e.declared),
  }

/// Why a literal's markup is refused, and at which character of which text.
pub type Misplaced = { message: String, offset: Int, part: Int }

/// `text` as what a hole holds: one text node, or nothing for the empty string.
pub fn chars(text: String) -> List<Node> = if text == "" { [] } else { [Text(text)] }

/// U+FDD0, which Unicode keeps for a program's own use: it stands where a hole does while a
/// literal's texts are read as one document.
fn hole_mark() -> Bytes = b"\xef\xb7\x90"

fn marks_in(text: String) -> Int / {abort.raise} =
  len(bytes_split(bytes_of_string(text), hole_mark())) - 1

type Joined = { pieces: List<Bytes>, at: Int, starts: List<Int>, marks: List<Int> }

/// The texts as one document, a mark between each two, in quotes where `quoted` says the hole is the
/// whole of an attribute's value; where each text starts in it, and where each mark stands.
fn joined_parts(parts: List<String>, quoted: List<Bool>) -> Joined =
  fold(range(0, len(parts)), { pieces: [], at: 0, starts: [], marks: [] }, |j: Joined, k: Int| {
    let text = bytes_of_string(at_or(parts, k, ""));
    let after = j.at + bytes_len(text);
    let lead = if at_or(quoted, k, false) { 1 } else { 0 };
    if k == len(parts) - 1 {
      { ..j, pieces: push(j.pieces, text), at: after, starts: push(j.starts, j.at) }
    } else {
      {
        pieces: push(push(j.pieces, text), if lead == 1 { b"\"\xef\xb7\x90\"" }
        else { hole_mark() }),
        at: after + 3 + 2 * lead,
        starts: push(j.starts, j.at),
        marks: push(j.marks, after + lead),
      }
    }
  })

/// What an `xml"..."` literal with holes is checked by: the texts around its holes read as one
/// element, or the first character, hole or end that makes them no document. A hole stands in an
/// element's content, inside a quoted attribute value, or as the whole of one, `name={hole}`; a
/// refusal just past a text is its hole's, or the literal's end after the last.
pub fn compile(parts: List<String>) -> Result<Template, Misplaced> / {abort.raise} =
  match find_index(parts, |p: String| string_contains(p, "\u{fdd0}")) {
    Some(k) ->
      Err({
        message: "U+FDD0 stands for a hole while a literal is read, so no literal holds one",
        offset: string_find(at_or(parts, k, ""), "\u{fdd0}"),
        part: k,
      }),
    None -> templated(parts, map(parts, |_: String| false), len(parts)),
  }

fn templated(
  parts: List<String>,
  quoted: List<Bool>,
  left: Int,
) -> Result<Template, Misplaced> / {abort.raise} = {
  let j = joined_parts(parts, quoted);
  let text = bytes_concat_all(j.pieces);
  match try { placed(text, parts) } {
    Ok(answer) -> answer,
    Err(refusal) -> match index_of(j.marks, refusal.at) {
      Some(k) -> if refusal.why == BadAttribute && left > 0 && !at_or(quoted, k, true) {
        templated(parts, list_set(quoted, k, true), left - 1)
      } else {
        Err(at_hole(parts, k, "a hole stands in an element's content or in an attribute's value"))
      },
      None -> Err(located(parts, j.starts, refusal)),
    },
  }
}

fn at_hole(parts: List<String>, k: Int, message: String) -> Misplaced =
  { message: message, offset: string_len(at_or(parts, k, "")), part: k }

/// Where a refusal at a byte of the joined texts falls: in the last text that starts at or before
/// it, at the character it is, or just past the text where it is in the hole after it.
fn located(parts: List<String>, starts: List<Int>, refusal: Refusal) -> Misplaced / {abort.raise} = {
  let part = max(len(filter(starts, |from: Int| from <= refusal.at)) - 1, 0);
  let text = bytes_of_string(at_or(parts, part, ""));
  let within = min(max(refusal.at - at_or(starts, part, 0), 0), bytes_len(text));
  { message: explain(refusal.why), offset: column_of(text, 0, within, 0), part: part }
}

/// The template the joined texts are, or the hole that stands where none may: `try` answers a
/// refusal of the document itself.
fn placed(
  text: Bytes,
  parts: List<String>,
) -> Result<Template, Misplaced> / {xml.refused, abort.raise} = {
  let d = read(text, default_limits());
  let walk = strayed(start(text, default_limits()), 0, bytes_len(text) + 2);
  match walk.stray {
    Some(message) -> Err(at_hole(parts, walk.seen, message)),
    None -> if walk.seen != len(parts) - 1 {
      Err({
        message: "a reference to U+FDD0 reads as a hole, so no literal holds one",
        offset: 0,
        part: 0,
      })
    } else if spelled(d.declaration) != None || !is_empty(d.before) || !is_empty(d.after) {
      Err({
        message: "a literal is one element, with nothing before or after it",
        offset: 0,
        part: 0,
      })
    } else { Ok({ root: molded(d.root) }) },
  }
}

type Walk = { stray: Option<String>, seen: Int }

/// The first hole in a comment, an instruction or a namespace declaration, by how many holes stand
/// before it, or how many holes the document holds.
fn strayed(c: Cursor, seen: Int, left: Int) -> Walk / {xml.refused, abort.raise} =
  match next(c) {
    None -> { stray: None, seen: seen },
    Some(step) -> if left <= 0 { panic("more events than bytes") } else {
      match step.event {
        Characters(text) -> strayed(step.rest, seen + marks_in(text), left - 1),
        Aside(Comment(text)) -> if marks_in(text) > 0 {
          { stray: Some("a comment holds no hole"), seen: seen }
        } else { strayed(step.rest, seen, left - 1) },
        Aside(Instruction(_, data)) -> if marks_in(data) > 0 {
          { stray: Some("a processing instruction holds no hole"), seen: seen }
        } else { strayed(step.rest, seen, left - 1) },
        StartElement(_) -> {
          let tag = fold(raws_at(c, step.at), { stray: None, seen: seen }, |w: Walk, raw: Raw| {
            let declares = raw.name == b"xmlns" || bytes_starts_with(raw.name, b"xmlns:");
            if w.stray != None { w } else if declares && marks_in(raw.value) > 0 {
              { ..w, stray: Some("a namespace declaration holds no hole") }
            } else { { ..w, seen: w.seen + marks_in(raw.value) } }
          });
          if tag.stray != None { tag } else { strayed(step.rest, tag.seen, left - 1) }
        },
        _ -> strayed(step.rest, seen, left - 1),
      }
    },
  }

/// The attributes, as written and in order, of the start tag whose `<` stands at `i`.
fn raws_at(c: Cursor, i: Int) -> List<Raw> / {xml.refused, abort.raise} =
  attributes(c, name_end(c.data, i + 1, c.sound), [], bytes_len(c.data) - i).raws

/// The element a literal is with `holes` where its holes stand. In content a hole stands as the
/// nodes it holds, and in an attribute's value as their text. A hole the list does not hold is
/// empty.
pub fn fill(t: Template, holes: List<List<Node>>) -> Element = filled(t.root, holes, 0).element

type Filled = { element: Element, next: Int }

type Weaving = { attributes: List<Attribute>, next: Int }

type Grafted = { joining: Joining, next: Int }

fn filled(m: Mold, holes: List<List<Node>>, from: Int) -> Filled = {
  let woven_values = fold(m.attributes, { attributes: [], next: from }, |w: Weaving, a: Valued|
    {
      attributes: push(w.attributes, { name: a.name, value: woven(a.texts, holes, w.next) }),
      next: w.next + len(a.texts) - 1,
    });
  let grafted = fold(
    m.children,
    { joining: { nodes: [], text: [] }, next: woven_values.next },
    |g: Grafted, c: Cast|
      match c {
        Texts(texts) -> grafts(texts, holes, g),
        Shaped(child) -> {
          let inner = filled(child, holes, g.next);
          { joining: joining(g.joining, Element(inner.element)), next: inner.next }
        },
        Apart(misc) -> { ..g, joining: joining(g.joining, Misc(misc)) },
      },
  );
  {
    element: {
      name: m.name,
      attributes: woven_values.attributes,
      children: settled(grafted.joining),
      declared: Spelling(m.declared),
    },
    next: grafted.next,
  }
}

/// An attribute's value: the texts between its holes, and each hole's text between them.
fn woven(texts: List<String>, holes: List<List<Node>>, from: Int) -> String =
  string_of_bytes_lossy(
    bytes_concat_all(
      fold(range(0, len(texts)), [], |out: List<Bytes>, k: Int| {
        let with_text = push(out, bytes_of_string(at_or(texts, k, "")));
        if k == len(texts) - 1 { with_text }
        else { fold(at_or(holes, from + k, []), with_text, said) }
      }),
    ),
  )

fn said(out: List<Bytes>, n: Node) -> List<Bytes> =
  match n { Text(t) -> push(out, bytes_of_string(t)), Element(e) -> spoken(e, out), Misc(_) -> out }

/// An element's content: the texts between its holes, and each hole's nodes between them.
fn grafts(texts: List<String>, holes: List<List<Node>>, g: Grafted) -> Grafted =
  fold(range(0, len(texts)), g, |acc: Grafted, k: Int| {
    let with_text = joining(acc.joining, Text(at_or(texts, k, "")));
    if k == len(texts) - 1 { { ..acc, joining: with_text } }
    else { { joining: fold(at_or(holes, acc.next, []), with_text, joining), next: acc.next + 1 } }
  })

/// What an `xml"..."` literal with no hole is checked by: the text as one element, or where it is
/// not.
pub fn literal(text: String) -> Result<Element, { message: String, offset: Int }> / {abort.raise} =
  match compile([text]) {
    Ok(t) -> Ok(fill(t, [])),
    Err(refused) -> Err({ message: refused.message, offset: refused.offset }),
  }

// --- Laws ---------------------------------------------------------------------------

/// A tree the makers build of numbers: each adds text, a comment or an instruction, or closes an
/// element around the last few nodes, so every name, prefix and character class meets every other.
fn planted(numbers: List<Int>) -> Element = element(name("root"), [], fold(numbers, [], sprouted))

fn sprouted(nodes: List<Node>, n: Int) -> List<Node> = {
  let k = (n & 0xFFFF) / 8;
  match n & 7 {
    0 | 1 -> push(nodes, Text(at_or(words(), k % 8, "x"))),
    2 -> push(nodes, Misc(Comment(at_or(words(), k % 3, "x")))),
    3 ->
      push(
        nodes,
        Misc(Instruction("p" ++ int_to_string(k % 3), at_or(["", "a", "b c"], k % 3, ""))),
      ),
    _ -> {
      let kept = len(nodes) - min(k % 4, len(nodes));
      push(
        take(nodes, kept),
        Element(
          element(
            at_or(names(), k / 4 % 8, name("a")),
            at_or(attribute_sets(), k / 32 % 5, []),
            drop(nodes, kept),
          ),
        ),
      )
    },
  }
}

fn words() -> List<String> =
  ["a", "b c", " d ", "<&>", "]]>", "\"'", "\t\n\r \r\n", "\u{e9}\u{1d11e}"]

fn names() -> List<Name> =
  [
    name("a"),
    name("b"),
    qualified("urn:x", "a"),
    prefixed("urn:x", "p", "b"),
    prefixed("urn:y", "p", "c"),
    qualified("urn:y", "d"),
    prefixed("urn:z", "q", "e"),
    qualified(xml_namespace(), "f"),
  ]

fn attribute_sets() -> List<List<Attribute>> =
  [
    [],
    [attr(name("k"), "<&>\"'")],
    [attr(prefixed("urn:x", "p", "k"), "\t\n\r"), attr(name("k"), " a  b ")],
    [attr(qualified("urn:y", "k"), "v"), attr(prefixed("urn:x", "q", "j"), "]]>")],
    [attr(qualified(xml_namespace(), "lang"), "en"), attr(prefixed("urn:z", "p", "k"), "")],
  ]

fn reread(numbers: List<Int>) -> Result<Document, Refusal> / {xml.unwritable, abort.raise} =
  parse(write(document(planted(numbers)), Compact), default_limits())

fn relaid(numbers: List<Int>) -> Result<Element, Refusal> / {xml.unwritable, abort.raise} =
  match parse(write(document(planted(numbers)), Indented(2)), default_limits()) {
    Ok(d) -> Ok(without_indentation(d.root)),
    Err(refusal) -> Err(refusal),
  }

/// `text` as `write` spells the document it holds; `text` itself where it holds none.
fn respelled(text: Bytes) -> Bytes / {abort.raise} =
  match parse(text, default_limits()) {
    Err(_) -> text,
    Ok(d) -> match encode(d, Compact) { Ok(written) -> written, Err(_) -> text },
  }

/// A document of `n` elements, each with a declaration, attributes, references and a child.
fn rows(n: Int) -> Bytes =
  bytes_concat_all([
    b"<r xmlns='urn:r'>",
    bytes::repeat(
      b"<p:c xmlns:p='urn:p' k=\"a&amp;b\" p:j='1'>t &lt; <![CDATA[u]]><d/></p:c>\n",
      n,
    ),
    b"</r>",
  ])

/// A tree of `n` rows, each with a namespace to declare, an attribute, text to escape and a child.
fn table(n: Int) -> Element =
  element(
    name("t"),
    [],
    map(range(0, n), |i: Int|
      Element(
        element(prefixed("urn:x", "p", "row"), [attr(name("id"), int_to_string(i))], [
          Text("a < b"),
          Element(element(name("c"), [], [])),
        ]),
      )),
  )

law "a tree the writer writes reads back as itself" =
  agrees(reread, |numbers: List<Int>| Ok(document(planted(numbers))))

law "indentation adds nothing but layout" =
  agrees(relaid, |numbers: List<Int>| Ok(without_indentation(planted(numbers))))

law "a document respelled is spelled as it will be again" = idempotent(respelled)

law "a tree written with any layout respells to what respells to itself"
  forall (numbers: List<Int>, indent: Int) {
    let once = respelled(write(document(planted(numbers)), Indented(indent & 7)));
    respelled(once) == once
  }

law "reading takes its steps by the byte"
  forall (n: Int) where n > 0 cost n {
    parse(rows(n), default_limits())
  }

law "writing takes its steps by the node"
  forall (n: Int) where n > 0 cost n {
    encode(document(table(n)), Indented(2))
  }

// --- Tests --------------------------------------------------------------------------

fn tight() -> Limits =
  {
    max_depth: 2,
    max_attributes: 2,
    max_name_bytes: 8,
    max_text_bytes: 8,
    max_events: 8,
    max_document_bytes: 64,
  }

fn why_not(text: Bytes, limits: Limits) -> Option<Why> / {abort.raise} =
  match parse(text, limits) { Ok(_) -> None, Err(refusal) -> Some(refusal.why) }

fn rewritten(text: String) -> String / {abort.raise} =
  match parse(bytes_of_string(text), default_limits()) {
    Err(_) -> "refused",
    Ok(d) -> match encode(d, Compact) { Ok(b) -> string_of_bytes(b), Err(_) -> "unwritable" },
  }

fn written(e: Element) -> Result<String, Why> / {abort.raise} =
  match encode(document(e), Compact) { Ok(b) -> Ok(string_of_bytes(b)), Err(why) -> Err(why) }

fn plain(local: String, children: List<Node>) -> Element = element(name(local), [], children)

fn root_of(text: String) -> Element / {abort.raise} =
  match parse(bytes_of_string(text), default_limits()) {
    Ok(d) -> d.root,
    Err(_) -> plain("refused", []),
  }

type Refused = { name: String, text: Bytes, at: Int, line: Int, column: Int, why: Why }

fn refusals() -> List<Refused> =
  [
    {
      name: "a document type declaration",
      text: b"<!DOCTYPE a><a/>",
      at: 0,
      line: 1,
      column: 1,
      why: Doctype,
    },
    {
      name: "an entity declared in an internal subset",
      text: b"<?xml version=\"1.0\"?>\n<!DOCTYPE a [<!ENTITY x SYSTEM \"file:///etc/passwd\">]><a>&x;</a>",
      at: 22,
      line: 2,
      column: 1,
      why: Doctype,
    },
    {
      name: "a declaration after the root",
      text: b"<a/><!DOCTYPE a>",
      at: 4,
      line: 1,
      column: 5,
      why: Doctype,
    },
    {
      name: "a declaration inside the root",
      text: b"<a><!DOCTYPE a></a>",
      at: 3,
      line: 1,
      column: 4,
      why: Doctype,
    },
    {
      name: "Latin-1 by its declaration",
      text: b"<?xml version='1.0' encoding='ISO-8859-1'?><a/>",
      at: 30,
      line: 1,
      column: 31,
      why: Encoding("ISO-8859-1"),
    },
    {
      name: "UTF-16 with no mark",
      text: b"\x00<\x00?\x00x\x00m",
      at: 0,
      line: 1,
      column: 1,
      why: Encoding("UTF-16BE"),
    },
    {
      name: "UCS-4",
      text: b"\x00\x00\x00<\x00\x00\x00a",
      at: 0,
      line: 1,
      column: 1,
      why: Encoding("UCS-4"),
    },
    {
      name: "a byte that is not UTF-8",
      text: b"<a>\xc3\xa9\xff</a>",
      at: 5,
      line: 1,
      column: 5,
      why: NotUtf8,
    },
    {
      name: "a surrogate written in UTF-8",
      text: b"<a>\xed\xa0\x80</a>",
      at: 3,
      line: 1,
      column: 4,
      why: NotUtf8,
    },
    {
      name: "a UTF-16 surrogate with no pair",
      text: b"\xfe\xff\x00<\xd8\x00\x00a",
      at: 1,
      line: 1,
      column: 2,
      why: NotUtf16,
    },
    {
      name: "a control character",
      text: b"<a>\n\x01</a>",
      at: 4,
      line: 2,
      column: 1,
      why: IllegalChar(1),
    },
    {
      name: "U+FFFE",
      text: b"<a>\xef\xbf\xbe</a>",
      at: 3,
      line: 1,
      column: 4,
      why: IllegalChar(0xFFFE),
    },
    {
      name: "a control character before a later mistake",
      text: b"<a \x02></b>",
      at: 3,
      line: 1,
      column: 4,
      why: IllegalChar(2),
    },
    {
      name: "an element left open",
      text: b"<a><b></b>",
      at: 10,
      line: 1,
      column: 11,
      why: Truncated,
    },
    { name: "a tag left open", text: b"<a x='1'", at: 8, line: 1, column: 9, why: Truncated },
    { name: "a comment left open", text: b"<a><!-- c", at: 3, line: 1, column: 4, why: Truncated },
    {
      name: "nothing but a comment",
      text: b"<!--c-->\r\n",
      at: 10,
      line: 2,
      column: 1,
      why: NoRoot,
    },
    { name: "text after the root", text: b"<a/>x", at: 4, line: 1, column: 5, why: OutsideRoot },
    { name: "text before the root", text: b"x<a/>", at: 0, line: 1, column: 1, why: OutsideRoot },
    { name: "a second root", text: b"<a/>\r<b/>", at: 5, line: 2, column: 1, why: OutsideRoot },
    {
      name: "a reference after the root",
      text: b"<a/>&#32;",
      at: 4,
      line: 1,
      column: 5,
      why: OutsideRoot,
    },
    {
      name: "a bare less-than sign",
      text: b"<a>1 < 2</a>",
      at: 5,
      line: 1,
      column: 6,
      why: BadMarkup,
    },
    {
      name: "an attribute named by a digit",
      text: b"<a 1='x'/>",
      at: 3,
      line: 1,
      column: 4,
      why: BadName,
    },
    {
      name: "two colons in a name",
      text: b"<p:b:c xmlns:p='u'/>",
      at: 1,
      line: 1,
      column: 2,
      why: BadName,
    },
    { name: "a colon in a target", text: b"<?p:q?><a/>", at: 2, line: 1, column: 3, why: BadName },
    {
      name: "attributes with no space between",
      text: b"<a x='1'y='2'/>",
      at: 8,
      line: 1,
      column: 9,
      why: BadTag,
    },
    {
      name: "an end tag with an attribute",
      text: b"<a></a x='1'>",
      at: 7,
      line: 1,
      column: 8,
      why: BadTag,
    },
    {
      name: "an attribute with no value",
      text: b"<a x/>",
      at: 4,
      line: 1,
      column: 5,
      why: BadAttribute,
    },
    {
      name: "a value with no quotes",
      text: b"<a x=1/>",
      at: 5,
      line: 1,
      column: 6,
      why: BadAttribute,
    },
    {
      name: "a less-than sign in a value",
      text: b"<a x='<'/>",
      at: 6,
      line: 1,
      column: 7,
      why: LessThanInValue,
    },
    {
      name: "an attribute written twice",
      text: b"<a x='1' x='2'/>",
      at: 9,
      line: 1,
      column: 10,
      why: DuplicateAttribute("x"),
    },
    {
      name: "an attribute under two prefixes of one namespace",
      text: b"<a xmlns:p='u' xmlns:q='u' p:x='1' q:x='2'/>",
      at: 35,
      line: 1,
      column: 36,
      why: DuplicateAttribute("q:x"),
    },
    {
      name: "an end tag for another element",
      text: b"<a>\n  <b></c>",
      at: 9,
      line: 2,
      column: 6,
      why: Mismatched("b"),
    },
    {
      name: "an end tag for a longer name",
      text: b"<a></ab>",
      at: 3,
      line: 1,
      column: 4,
      why: Mismatched("a"),
    },
    {
      name: "two hyphens in a comment",
      text: b"<a><!-- b -- c --></a>",
      at: 10,
      line: 1,
      column: 11,
      why: DoubleHyphen,
    },
    {
      name: "a CDATA end in text",
      text: b"<a>\xc3\xa9]]></a>",
      at: 5,
      line: 1,
      column: 5,
      why: CDataEnd,
    },
    {
      name: "an XML declaration inside the root",
      text: b"<a><?xml version='1.0'?></a>",
      at: 3,
      line: 1,
      column: 4,
      why: BadInstruction,
    },
    {
      name: "a target with no space after it",
      text: b"<?p+?><a/>",
      at: 3,
      line: 1,
      column: 4,
      why: BadInstruction,
    },
    {
      name: "version 2.0",
      text: b"<?xml version='2.0'?><a/>",
      at: 15,
      line: 1,
      column: 16,
      why: BadDeclaration,
    },
    {
      name: "a declaration with its encoding first",
      text: b"<?xml encoding='UTF-8' version='1.0'?><a/>",
      at: 16,
      line: 1,
      column: 17,
      why: BadDeclaration,
    },
    {
      name: "an ampersand that begins nothing",
      text: b"<a>b & c</a>",
      at: 5,
      line: 1,
      column: 6,
      why: BadReference,
    },
    {
      name: "a reference with no semicolon",
      text: b"<a x='&amp'/>",
      at: 6,
      line: 1,
      column: 7,
      why: BadReference,
    },
    {
      name: "an entity nothing declares",
      text: b"<a>&nbsp;</a>",
      at: 3,
      line: 1,
      column: 4,
      why: UnknownEntity("nbsp"),
    },
    {
      name: "a reference to U+0000",
      text: b"<a>&#0;</a>",
      at: 3,
      line: 1,
      column: 4,
      why: IllegalReference(0),
    },
    {
      name: "a reference to a surrogate",
      text: b"<a>&#xD800;</a>",
      at: 3,
      line: 1,
      column: 4,
      why: IllegalReference(0xD800),
    },
    {
      name: "a reference past Unicode",
      text: b"<a>&#99999999999999999999;</a>",
      at: 3,
      line: 1,
      column: 4,
      why: IllegalReference(0x110000),
    },
    {
      name: "a prefix nothing binds",
      text: b"<a><p:b/></a>",
      at: 4,
      line: 1,
      column: 5,
      why: UnboundPrefix("p"),
    },
    {
      name: "a prefix out of scope",
      text: b"<a><b xmlns:p='u'/><c p:x='1'/></a>",
      at: 22,
      line: 1,
      column: 23,
      why: UnboundPrefix("p"),
    },
    {
      name: "the prefix xmlns declared",
      text: b"<a xmlns:xmlns='u'/>",
      at: 3,
      line: 1,
      column: 4,
      why: BadNamespace("xmlns"),
    },
    {
      name: "a prefix bound to nothing",
      text: b"<a xmlns:p=''/>",
      at: 3,
      line: 1,
      column: 4,
      why: BadNamespace("p"),
    },
    {
      name: "the prefix xml bound elsewhere",
      text: b"<a xmlns:xml='u'/>",
      at: 3,
      line: 1,
      column: 4,
      why: BadNamespace("xml"),
    },
    {
      name: "an element named with xmlns",
      text: b"<xmlns:a/>",
      at: 1,
      line: 1,
      column: 2,
      why: BadNamespace("xmlns"),
    },
  ]

test "refuses {c.name}" for c: Refused in refusals() {
  assert_eq(
    parse(c.text, default_limits()),
    Err({ at: c.at, line: c.line, column: c.column, why: c.why }),
  )
}

type Limited = { name: String, text: Bytes, why: Why }

fn past_limits() -> List<Limited> =
  [
    { name: "a third level", text: b"<a><b><c/></b></a>", why: TooDeep },
    { name: "a third attribute", text: b"<a x='1' y='2' xmlns:p='u'/>", why: TooManyAttributes },
    { name: "a name of nine bytes", text: b"<abcdefghi/>", why: NameTooLong },
    { name: "an attribute name of nine bytes", text: b"<a abcdefghi='1'/>", why: NameTooLong },
    { name: "text of nine bytes", text: b"<a>12345678&#57;</a>", why: TextTooLong },
    { name: "a value of nine bytes", text: b"<a x='123456789'/>", why: TextTooLong },
    { name: "a comment of nine bytes", text: b"<a/><!--123456789-->", why: TextTooLong },
    { name: "a ninth event", text: b"<a><b/>1<b/>2<b/>3<b/></a>", why: TooManyEvents },
    {
      name: "a sixty-fifth byte",
      text: bytes_concat_all([b"<a>", bytes::repeat(b" ", 58), b"</a>"]),
      why: TooLarge,
    },
  ]

test "a document past its limits is refused: {c.name}" for c: Limited in past_limits() {
  assert_eq(why_not(c.text, tight()), Some(c.why))
}

test "a document at its limits is read, and a limit that is not positive admits nothing" {
  assert_eq(why_not(b"<a x='1' y='2'><abcdefgh>12345678</abcdefgh><!--c--></a>", tight()), None);
  assert_eq(why_not(b"<a/>", { ..tight(), max_depth: 0 }), Some(TooDeep));
  assert_eq(why_not(b"<a/>", { ..tight(), max_events: 0 }), Some(TooManyEvents));
  assert_eq(why_not(b"<a x=''/>", { ..tight(), max_attributes: 0 }), Some(TooManyAttributes));
  let nested = |levels: Int|
    bytes_concat_all([bytes::repeat(b"<a>", levels), bytes::repeat(b"</a>", levels)]);
  let roomy: Limits = { ..default_limits(), max_depth: 1000000 };
  assert_eq(why_not(nested(deepest()), roomy), None);
  assert_eq(why_not(nested(deepest() + 1), roomy), Some(TooDeep))
}

test "a document is its events in order, with text between markup as one" {
  assert_eq(
    try {
      events(
        b"<?xml version=\"1.0\"?>\n<a x='1'>hi<b/>&amp;<![CDATA[<]]>&#x21;</a><!--c--><?p d ?>\n",
        default_limits(),
      )
    },
    Ok([
      XmlDeclaration({ version: "1.0", encoding: None, standalone: None }),
      StartElement({ name: name("a"), attributes: [attr(name("x"), "1")], declared: [] }),
      Characters("hi"),
      StartElement({ name: name("b"), attributes: [], declared: [] }),
      EndElement(name("b")),
      Characters("&<!"),
      EndElement(name("a")),
      Aside(Comment("c")),
      Aside(Instruction("p", "d ")),
    ]),
  );
  assert_eq(
    try {
      events(
        b"\xef\xbb\xbf<?xml version='1.1' encoding='utf-8' standalone='no'?><a><![CDATA[]]></a>",
        default_limits(),
      )
    },
    Ok([
      XmlDeclaration({ version: "1.1", encoding: Some("utf-8"), standalone: Some(false) }),
      StartElement({ name: name("a"), attributes: [], declared: [] }),
      EndElement(name("a")),
    ]),
  )
}

test "names are resolved against the declarations in scope, and the declarations are kept apart" {
  assert_eq(
    try {
      events(
        b"<a xmlns='u' xmlns:p='v' p:x='1' y='2'><p:b xmlns=''><c xml:lang='en'/></p:b></a>",
        default_limits(),
      )
    },
    Ok([
      StartElement({
        name: qualified("u", "a"),
        attributes: [attr(qualified("v", "x"), "1"), attr(name("y"), "2")],
        declared: [{ prefix: "", namespace: "u" }, { prefix: "p", namespace: "v" }],
      }),
      StartElement({
        name: qualified("v", "b"),
        attributes: [],
        declared: [{ prefix: "", namespace: "" }],
      }),
      StartElement({
        name: name("c"),
        attributes: [attr(qualified(xml_namespace(), "lang"), "en")],
        declared: [],
      }),
      EndElement(name("c")),
      EndElement(qualified("v", "b")),
      EndElement(qualified("u", "a")),
    ]),
  );
  let read = root_of("<p:a xmlns:p='u'/>");
  assert_eq(read.name, qualified("u", "a"));
  assert_eq(spelled(read.name.prefix), "p");
  assert_eq(spelled(read.declared), [{ prefix: "p", namespace: "u" }]);
  assert_eq(root_of("<p:a xmlns:p='u' p:k='1'/>"), root_of("<a xmlns='u' xmlns:q='u' q:k='1'/>"));
  assert(root_of("<p:a xmlns:p='u'/>") != root_of("<p:a xmlns:p='v'/>"))
}

test "a name is resolved under the scope it is read in, however often it was read before" {
  let spaces = |text: String|
    match try { events(bytes_of_string(text), default_limits()) } {
      Ok(all) ->
        fold(all, [], |found: List<String>, e: Event|
          match e { StartElement(s) -> push(found, s.name.namespace), _ -> found }),
      Err(_) -> [],
    };
  assert_eq(spaces("<p:a xmlns:p='u'><p:a xmlns:p='v'><p:a/></p:a><p:a/></p:a>"), [
    "u",
    "v",
    "v",
    "u",
  ]);
  assert_eq(spaces("<r xmlns='u'><a/><b xmlns='v'><a/><c><a/></c></b><a/></r>"), [
    "u",
    "u",
    "v",
    "v",
    "v",
    "v",
    "u",
  ]);
  assert_eq(
    root_of("<r k='1' xmlns:p='u'><a k='2' p:k='3'/><a k='4'/></r>"),
    element(name("r"), [attr(name("k"), "1")], [
      Element(element(name("a"), [attr(name("k"), "2"), attr(qualified("u", "k"), "3")], [])),
      Element(element(name("a"), [attr(name("k"), "4")], [])),
    ]),
  )
}

test "line ends are line feeds, and a value's white space is spaces unless a reference wrote it" {
  assert_eq(
    root_of(
      "<a x=' a\tb\r\nc\rd&#9;&#10;&#13; '>e\r\nf\rg&#13;<!--h\r\ni--><?p j\rk?><![CDATA[l\r\nm]]></a>",
    ),
    element(name("a"), [attr(name("x"), " a b c d\t\n\r ")], [
      Text("e\nf\ng\r"),
      Misc(Comment("h\ni")),
      Misc(Instruction("p", "j\nk")),
      Text("l\nm"),
    ]),
  )
}

test "UTF-16 under either mark reads as the UTF-8 document does" {
  let wide = |big: Bool, text: String|
    bytes_concat_all(
      map(string_chars(text), |ch: Char| {
        let unit = int_of_char(ch);
        if big { bytes_concat(byte_of_int(unit >> 8), byte_of_int(unit & 0xFF)) }
        else { bytes_concat(byte_of_int(unit & 0xFF), byte_of_int(unit >> 8)) }
      }),
    );
  let text = "<?xml version='1.0' encoding='UTF-16'?><a k='\u{e9}'>\u{4e2d}</a>";
  let expected = Ok(element(name("a"), [attr(name("k"), "\u{e9}")], [Text("\u{4e2d}")]));
  let root = |data: Bytes|
    match parse(data, default_limits()) { Ok(d) -> Ok(d.root), Err(refusal) -> Err(refusal.why) };
  assert_eq(root(bytes_concat(b"\xfe\xff", wide(true, text))), expected);
  assert_eq(root(bytes_concat(b"\xff\xfe", wide(false, text))), expected);
  assert_eq(
    root(b"\xfe\xff\x00<\x00a\x00>\xd8\x34\xdd\x1e\x00<\x00/\x00a\x00>"),
    Ok(element(name("a"), [], [Text("\u{1d11e}")])),
  );
  assert_eq(root(bytes_of_string(text)), Err(Encoding("UTF-16")));
  assert_eq(
    root(bytes_concat(b"\xfe\xff", wide(true, "<?xml version='1.0' encoding='UTF-8'?><a/>"))),
    Err(Encoding("UTF-8")),
  )
}

test "a cursor stops, skips and builds where its caller says" {
  let c = start(
    b"<r><skip><x>1</x><y/></skip><keep k='v'>2<z/></keep><more/></r>",
    default_limits(),
  );
  let read = try {
    let root = match next(c) { Some(step) -> step.rest, None -> c };
    let skipped = match next(root) { Some(step) -> skip(step.rest), None -> root };
    match next(skipped) {
      Some(step) -> match step.event {
        StartElement(opened) -> {
          let kept = subtree(opened, step.rest);
          { element: kept.element, at: kept.rest.at }
        },
        _ -> { element: plain("none", []), at: 0 },
      },
      None -> { element: plain("none", []), at: 0 },
    }
  };
  assert_eq(
    read,
    Ok({
      element: element(name("keep"), [attr(name("k"), "v")], [Text("2"), Element(plain("z", []))]),
      at: 52,
    }),
  );
  assert_eq(position(b"a\r\nb\xc3\xa9c\rd", 6), { offset: 6, line: 2, column: 3 });
  assert_eq(position(b"a\r\nb\xc3\xa9c\rd", 8), { offset: 8, line: 3, column: 1 });
  assert_eq(position(b"\xef\xbb\xbf<a>", 4), { offset: 4, line: 1, column: 2 });
  assert_eq(
    parse(b"\xef\xbb\xbf<a></b>", default_limits()),
    Err({ at: 6, line: 1, column: 4, why: Mismatched("a") }),
  )
}

test "a tree is written as it was spelled, and escaped where it stands" {
  assert_eq(rewritten("<a x='1'>hi<b/></a>"), "<a x=\"1\">hi<b/></a>");
  assert_eq(rewritten("<a  x = \"1\" ></a >"), "<a x=\"1\"/>");
  assert_eq(
    rewritten(
      "<?xml version='1.0' encoding='utf-8' standalone='yes'?>\n<!--c-->\n<a/>\n<?p  d ?>\n",
    ),
    "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?><!--c--><a/><?p d ?>",
  );
  assert_eq(
    rewritten("<a>1 &lt; 2 &amp; 3 > 2 <![CDATA[<&>]]> ]]&gt;&#13;</a>"),
    "<a>1 &lt; 2 &amp; 3 &gt; 2 &lt;&amp;&gt; ]]&gt;&#xD;</a>",
  );
  assert_eq(
    rewritten("<a x='a\tb\nc&#9;d&#10;e&#13;f\"g&apos;h&lt;'/>"),
    "<a x=\"a b c&#x9;d&#xA;e&#xD;f&quot;g'h&lt;\"/>",
  );
  let spelled_out = "<p:a xmlns:p=\"u\" xmlns=\"v\" xmlns:unused=\"w\"><b p:x=\"1\"/><c xmlns=\"\"/></p:a>";
  assert_eq(rewritten(spelled_out), spelled_out)
}

test "a namespace is declared where a name first needs it" {
  assert_eq(written(element(qualified("u", "a"), [], [])), Ok("<a xmlns=\"u\"/>"));
  assert_eq(
    written(element(prefixed("u", "p", "a"), [attr(qualified("u", "x"), "1")], [])),
    Ok("<p:a xmlns:p=\"u\" p:x=\"1\"/>"),
  );
  assert_eq(
    written(element(qualified("u", "a"), [attr(qualified("u", "x"), "1")], [])),
    Ok("<a xmlns=\"u\" xmlns:ns1=\"u\" ns1:x=\"1\"/>"),
  );
  assert_eq(
    written(
      element(qualified("u", "a"), [], [
        Element(plain("b", [Element(element(qualified("u", "c"), [], []))])),
      ]),
    ),
    Ok("<a xmlns=\"u\"><b xmlns=\"\"><c xmlns=\"u\"/></b></a>"),
  );
  assert_eq(
    written(
      element(
        prefixed("u", "p", "a"),
        [attr(prefixed("v", "p", "x"), "1"), attr(prefixed("w", "p", "y"), "2")],
        [
          Element(element(prefixed("v", "p", "b"), [], [])),
          Element(element(prefixed("u", "q", "c"), [], [])),
        ],
      ),
    ),
    Ok(
      "<p:a xmlns:p=\"u\" xmlns:ns1=\"v\" xmlns:ns2=\"w\" ns1:x=\"1\" ns2:y=\"2\"><p:b xmlns:p=\"v\"/><q:c xmlns:q=\"u\"/></p:a>",
    ),
  );
  assert_eq(
    written(element(name("a"), [attr(qualified(xml_namespace(), "lang"), "en")], [])),
    Ok("<a xml:lang=\"en\"/>"),
  );
  let defaulted: Element = {
    name: name("a"),
    attributes: [],
    children: [],
    declared: Spelling([{ prefix: "", namespace: "u" }, { prefix: "p", namespace: "v" }]),
  };
  assert_eq(written(defaulted), Ok("<a xmlns:p=\"v\"/>"))
}

type Unwritable = { name: String, tree: Element, why: Why }

fn hollow(children: List<Node>) -> Element =
  { name: name("a"), attributes: [], children: children, declared: Spelling([]) }

fn declaring_of(prefix: String, namespace: String) -> Element =
  {
    name: name("a"),
    attributes: [],
    children: [],
    declared: Spelling([{ prefix: prefix, namespace: namespace }]),
  }

fn unwritables() -> List<Unwritable> =
  [
    { name: "a name with a space", tree: plain("a b", []), why: NotAName("a b") },
    { name: "a name with a colon", tree: plain("a:b", []), why: NotAName("a:b") },
    { name: "an empty name", tree: plain("", []), why: NotAName("") },
    {
      name: "a prefix that is no name",
      tree: element(prefixed("u", "1", "a"), [], []),
      why: NotAName("1"),
    },
    {
      name: "the prefix xml on another namespace",
      tree: element(prefixed("u", "xml", "a"), [], []),
      why: NotAName("xml"),
    },
    {
      name: "an attribute called xmlns",
      tree: element(name("a"), [attr(name("xmlns"), "u")], []),
      why: NotAName("xmlns"),
    },
    {
      name: "an instruction's target with a colon",
      tree: plain("a", [Misc(Instruction("p:q", ""))]),
      why: NotAName("p:q"),
    },
    {
      name: "a name in the namespace of declarations",
      tree: element(qualified(xmlns_namespace(), "a"), [], []),
      why: BadNamespace("xmlns"),
    },
    { name: "two text nodes side by side", tree: hollow([Text("x"), Text("y")]), why: SplitText },
    { name: "an empty text node", tree: hollow([Text("")]), why: SplitText },
    { name: "a control character in text", tree: plain("a", [Text("\u{1}")]), why: IllegalChar(1) },
    {
      name: "U+FFFF in a value",
      tree: element(name("a"), [attr(name("x"), "\u{ffff}")], []),
      why: IllegalChar(0xFFFF),
    },
    {
      name: "a carriage return in a comment",
      tree: plain("a", [Misc(Comment("b\rc"))]),
      why: IllegalChar(13),
    },
    {
      name: "two hyphens in a comment",
      tree: plain("a", [Misc(Comment("b--c"))]),
      why: DoubleHyphen,
    },
    {
      name: "a comment that ends in a hyphen",
      tree: plain("a", [Misc(Comment("b-"))]),
      why: DoubleHyphen,
    },
    {
      name: "an instruction for xml",
      tree: plain("a", [Misc(Instruction("XML", ""))]),
      why: BadInstruction,
    },
    {
      name: "an instruction that ends itself",
      tree: plain("a", [Misc(Instruction("p", "a?>b"))]),
      why: BadInstruction,
    },
    {
      name: "an instruction's data led by a space",
      tree: plain("a", [Misc(Instruction("p", " a"))]),
      why: BadInstruction,
    },
    {
      name: "an attribute twice",
      tree: element(
        name("a"),
        [attr(prefixed("u", "p", "x"), "1"), attr(prefixed("u", "q", "x"), "2")],
        [],
      ),
      why: DuplicateAttribute("x"),
    },
    {
      name: "the prefix xmlns declared",
      tree: declaring_of("xmlns", "u"),
      why: BadNamespace("xmlns"),
    },
    {
      name: "a prefix declared for no namespace",
      tree: declaring_of("p", ""),
      why: BadNamespace("p"),
    },
    {
      name: "a prefix declared for the xml namespace",
      tree: declaring_of("p", xml_namespace()),
      why: BadNamespace("p"),
    },
    {
      name: "a prefix declared twice",
      tree: {
        name: name("a"),
        attributes: [],
        children: [],
        declared: Spelling([{ prefix: "p", namespace: "u" }, { prefix: "p", namespace: "v" }]),
      },
      why: BadNamespace("p"),
    },
  ]

test "a tree no document holds is refused: {c.name}" for c: Unwritable in unwritables() {
  assert_eq(written(c.tree), Err(c.why))
}

test "a tree past the deepest is refused, and a declaration is written for what it says" {
  let nested = fold(range(0, deepest()), plain("a", []), |inner: Element, _: Int|
    plain("a", [Element(inner)]));
  assert_eq(written(nested), Err(TooDeep));
  let declared = |version: String|
    encode(
      {
        declaration: Spelling(
          Some({ version: version, encoding: Some("latin1"), standalone: Some(false) }),
        ),
        before: [],
        root: plain("a", []),
        after: [],
      },
      Compact,
    );
  assert_eq(
    declared("1.1"),
    Ok(b"<?xml version=\"1.1\" encoding=\"UTF-8\" standalone=\"no\"?><a/>"),
  );
  assert_eq(declared("2"), Err(BadDeclaration))
}

test "indentation gives a line to each child of an element that holds no text, and to nothing else" {
  let doc: Document = {
    declaration: Spelling(Some({ version: "1.0", encoding: None, standalone: None })),
    before: [Comment("b")],
    root: plain("a", [
      Element(plain("b", [Element(plain("c", [])), Misc(Comment("d"))])),
      Element(plain("e", [Text("x"), Element(plain("f", [Element(plain("g", []))]))])),
    ]),
    after: [Instruction("p", "")],
  };
  assert_eq(
    encode(doc, Indented(2)),
    Ok(
      b"<?xml version=\"1.0\"?>\n<!--b-->\n<a>\n  <b>\n    <c/>\n    <!--d-->\n  </b>\n  <e>x<f><g/></f></e>\n</a>\n<?p?>\n",
    ),
  );
  assert_eq(
    encode(doc, Compact),
    Ok(b"<?xml version=\"1.0\"?><!--b--><a><b><c/><!--d--></b><e>x<f><g/></f></e></a><?p?>"),
  );
  assert_eq(
    without_indentation(root_of("<a>\n  <b> x </b>\n  <c>\n  </c>\n</a>")),
    plain("a", [Element(plain("b", [Text(" x ")])), Element(plain("c", []))]),
  )
}

test "the makers join text, and the lookups find by name whatever the prefix" {
  assert_eq(plain("a", [Text("x"), Text(""), Text("y"), Misc(Comment("c")), Text("")]).children, [
    Text("xy"),
    Misc(Comment("c")),
  ]);
  let root = root_of(
    "<r><a k='1' n:k='2' xmlns:n='u'>x<b>y</b></a><a>z<!--c--></a><n:a xmlns:n='u'><b/></n:a></r>",
  );
  assert_eq(len(elements(root)), 3);
  assert_eq(len(children(root, name("a"))), 2);
  assert_eq(
    map(children(root, prefixed("u", "other", "a")), |e: Element| spelled(e.name.prefix)),
    ["n"],
  );
  assert_eq(text(root), "xyz");
  assert_eq(len(descendants(root, name("b"))), 2);
  assert_eq(len(descendants(root, name("r"))), 0);
  let first_a = match child(root, name("a")) { Some(a) -> a, None -> root };
  assert_eq(attribute(first_a, name("k")), Some("1"));
  assert_eq(attribute(first_a, qualified("u", "k")), Some("2"));
  assert_eq(attribute(first_a, name("missing")), None);
  assert_eq(child(root, name("b")), None);
  assert_eq(match find(root, "a/b") { Some(b) -> text(b), None -> "none" }, "y");
  assert_eq(len(find_all(root, "a")), 2);
  assert_eq(len(find_all(root, "{u}a")), 1);
  assert_eq(len(find_all(root, "{u}a/b")), 1);
  assert_eq(find_all(root, ""), [root]);
  assert_eq(find_all(root, "{u"), []);
  assert_eq(find_all(root, "a//b"), []);
  assert_eq(find(root, "b"), None)
}

test "the raising reader raises what the other answers, and a task may perform it" {
  assert_eq(
    try { read(b"<a>", default_limits()) },
    Err({ at: 3, line: 1, column: 4, why: Truncated }),
  );
  let read_in_a_task = simulate {
    let t = task.spawn(|| try { read(b"<!DOCTYPE a><a/>", default_limits()) });
    task.join(t)
  };
  assert_eq(read_in_a_task, Err({ at: 0, line: 1, column: 1, why: Doctype }));
  assert_eq(try { write(document(plain("1", [])), Compact) }, Err(NotAName("1")))
}

fn filled_with(parts: List<String>, holes: List<List<Node>>) -> String / {abort.raise} =
  match compile(parts) {
    Err(refused) -> refused.message,
    Ok(t) -> match written(fill(t, holes)) { Ok(text) -> text, Err(why) -> explain(why) },
  }

fn misplaced(parts: List<String>) -> Option<{ offset: Int, part: Int }> / {abort.raise} =
  match compile(parts) {
    Ok(_) -> None,
    Err(refused) -> Some({ offset: refused.offset, part: refused.part }),
  }

test "a hole is characters in a value and nodes in content, and markup in neither" {
  assert_eq(
    filled_with(["<a href=", ">", "</a>"], [chars("x\" onclick=\"y"), chars("<script>&")]),
    "<a href=\"x&quot; onclick=&quot;y\">&lt;script&gt;&amp;</a>",
  );
  assert_eq(
    filled_with(["<a href='/u/", "?q=", "'>", " and ", "</a>"], [
      chars("a b"),
      [Element(plain("i", [Text("1")]))],
      [Element(plain("b", [])), Text("x")],
      [],
    ]),
    "<a href=\"/u/a b?q=1\"><b/>x and </a>",
  );
  assert_eq(filled_with(["<a>", "</a>"], []), "<a/>");
  assert_eq(filled_with(["<a k=", "/>"], []), "<a k=\"\"/>");
  assert_eq(filled_with(["<a k=", " j=", "/>"], [chars("1"), chars("2")]), "<a k=\"1\" j=\"2\"/>");
  assert_eq(
    filled_with(["<p:a xmlns:p='u'><![CDATA[", "]]><!--c--></p:a>"], [chars("]]>")]),
    "<p:a xmlns:p=\"u\">]]&gt;<!--c--></p:a>",
  )
}

test "a literal's markup is refused where it is no element, at the character or the hole" {
  assert_eq(misplaced(["<a>", "</a>"]), None);
  assert_eq(misplaced(["<a ", ">x</a>"]), Some({ offset: 3, part: 0 }));
  assert_eq(misplaced(["<", "/>"]), Some({ offset: 0, part: 0 }));
  assert_eq(misplaced(["<a k=", "", "/>"]), Some({ offset: 0, part: 1 }));
  assert_eq(misplaced(["<a/>", ""]), Some({ offset: 4, part: 0 }));
  assert_eq(misplaced(["<a><!-- ", " --></a>"]), Some({ offset: 8, part: 0 }));
  assert_eq(misplaced(["<a><?p ", "?></a>"]), Some({ offset: 7, part: 0 }));
  assert_eq(misplaced(["<a x=", " xmlns:p=", " y='", "'/>"]), Some({ offset: 9, part: 1 }));
  assert_eq(misplaced(["<a>", "</b>"]), Some({ offset: 0, part: 1 }));
  assert_eq(misplaced(["<a>"]), Some({ offset: 3, part: 0 }));
  assert_eq(misplaced(["<a/><b/>"]), Some({ offset: 4, part: 0 }));
  assert_eq(misplaced(["<!--c--><a/>"]), Some({ offset: 0, part: 0 }));
  assert_eq(misplaced(["<a>caf\u{e9} & ", "</a>"]), Some({ offset: 8, part: 0 }));
  assert_eq(misplaced(["<a>\u{fdd0}</a>"]), Some({ offset: 3, part: 0 }));
  assert_eq(misplaced(["<a>&#xFDD0;", "</a>"]), Some({ offset: 0, part: 0 }));
  assert_eq(literal("<a x='1'>t</a>"), Ok(element(name("a"), [attr(name("x"), "1")], [Text("t")])));
  assert_eq(literal("<a>"), Err({ message: explain(Truncated), offset: 3 }))
}
