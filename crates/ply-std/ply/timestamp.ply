//! The `timestamp"2026-10-04T12:30:00Z"` literal: a `std.date` instant at an offset, written as
//! RFC 3339 writes one and checked when the program is.
//!
//! A tag is a module, and `std.date`'s own reads a date, so the instant has this one. The type and
//! everything done with it are `std.date`'s.

import std.date (OffsetDateTime, Refusal, rfc3339_literal, unix_seconds)
import std.option (option_map)
import std.result (result_ok)

/// What a `timestamp"..."` literal is checked by: the instant `std.date`'s `parse_rfc3339` reads,
/// or why the text is none and the character it stops being one at.
pub fn literal(text: String) -> Result<OffsetDateTime, Refusal> = rfc3339_literal(text)

// --- Tests ------------------------------------------------------------------

test "the check answers the instant, or where the text stops being one" {
  assert_eq(option_map(result_ok(literal("1970-01-01T01:00:00+01:00")), unix_seconds), Some(0));
  assert_eq(
    literal("1970-01-01T01:00:00"),
    Err({ message: "an offset is `Z`, or `+` or `-` and hh:mm", offset: 19 }),
  )
}
