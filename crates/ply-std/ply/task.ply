//! Structured tasks: deadlines, races, gathers, retries and limits over the language's `task`.
//!
//! Every function here that starts tasks ends them before it answers. The tasks are started in
//! the `acquire` of a `bracket` whose `release` cancels and awaits each one, so when a combinator
//! answers, raises or is itself cancelled, what it started has stopped and has run its own
//! releases. A body handed to one runs as a task of its own: a raise in it is that task's and
//! not its caller's, so a body that can fail answers a `Result`.
//!
//! A deadline is an instant. `until` and `timeout` stop a body at one by cancelling its task,
//! which is the mechanism the language has, and say which instant through `deadline.at`, so
//! what runs inside, and every task started there, can read how long it has. Deadlines nest by
//! the earlier: an inner one that names a later instant is held to the outer. A program says
//! there is none above it with `unbounded`.
//!
//! Retrying, breaking a circuit, limiting a rate and keeping a retry budget are each a value and
//! the pure functions that step it, which take the reading of the clock they need. The caller
//! keeps the value, in a cell or threaded through: nothing here is ambient. A function that
//! steps one while it runs a body (`guarded`, `throttled`, `retry_budgeted`, `single_flight`)
//! takes `load` and `store`, how the caller reads what it keeps and puts one back, which over a
//! cell are `|| cell_get(c)` and `|s: S| cell_set(c, s)`. It reads and writes with nothing
//! between that another task could run in, so tasks sharing a cell see each step whole. Jitter
//! is drawn from `std.random`'s `entropy`, so a run that answers it from a seed waits what the
//! seed says.
//!
//! Under `simulate` every wait here is virtual time and every interleaving of what these start
//! is searched. Under `--host` the same waits are on the run's clock, and a task that waits is
//! parked alone while the others run.

import std.list (at, concat, sort)
import std.math (rem_euclid)
import std.random
import std.time (after, as_nanos, between, nanos_at)

// --- Scopes -----------------------------------------------------------------

/// What `inside` answers, handed a task running each of `bodies`. Every one of them has ended
/// when this answers, however it does: `inside` returning, a raise, or a cancel of the caller
/// cancels those still running and waits for each to finish releasing what it holds.
pub fn scoped<a, b | e>(
  bodies: List<() -> a / e>,
  inside: (List<Task<a>>) -> b / {task.write, abort.raise | e},
) -> b / {task.write, abort.raise | e} =
  bracket(|| map(bodies, |body: () -> a / e| task.spawn(body)), stopped, inside)

/// Cancels each of `kids` and waits for it to end.
fn stopped<a>(kids: List<Task<a>>) -> Unit / {task.write} = {
  fold(kids, (), |_u: Unit, kid: Task<a>| {
    task.cancel(kid);
    ()
  });
  fold(kids, (), |_u: Unit, kid: Task<a>| {
    task.await(kid);
    ()
  })
}

/// What `step` makes of the answers of `bodies` in the order they end, each beside its place
/// among them, from `init` until it answers `Stop` or every body has ended. The bodies still
/// running then are cancelled and awaited.
fn gathered<a, s | e>(
  bodies: List<() -> a / e>,
  init: s,
  step: (s, Int, a) -> Iter<s, s>,
) -> s / {task.write, abort.raise | e} = {
  let n = len(bodies);
  if n == 0 { init } else {
    let ended = task.channel(n);
    let racers = map(range(0, n), |i: Int|
      || {
        task.send(ended, (i, at(bodies, i)()));
        ()
      });
    scoped(racers, |_kids: List<Task<Unit>>|
      iterate({ state: init, heard: 0 }, n + 1, |so_far: { state: s, heard: Int }|
        if so_far.heard == n { Stop(so_far.state) } else {
          match task.recv(ended) {
            None -> Stop(so_far.state),
            Some(answer) -> match step(so_far.state, answer._0, answer._1) {
              Continue(next) -> Continue({ state: next, heard: so_far.heard + 1 }),
              Stop(last) -> Stop(last),
            },
          }
        }))
  }
}

// --- Several at once --------------------------------------------------------

/// What each of `bodies` answers, in their order, all of them run at once.
pub fn all<a | e>(bodies: List<() -> a / e>) -> List<a> / {task.write, abort.raise | e} =
  scoped(bodies, |kids: List<Task<a>>| map(kids, |kid: Task<a>| task.join(kid)))

/// What every one of `bodies` answered, in their order, or the first failure: the bodies still
/// running when one fails are cancelled, and have ended when this answers.
pub fn all_ok<a, x | e>(
  bodies: List<() -> Result<a, x> / e>,
) -> Result<List<a>, x> / {task.write, abort.raise | e} =
  match gathered(
      bodies,
      Ok(map_new()),
      |so_far: Result<Map<Int, a>, x>, i: Int, r: Result<a, x>|
        match ((so_far, r)) {
          (Ok(answers), Ok(answer)) -> Continue(Ok(map_insert(answers, i, answer))),
          (_, Err(failure)) -> Stop(Err(failure)),
          (Err(failure), _) -> Stop(Err(failure)),
        },
    ) {
    Ok(answers) -> Ok(map_values(answers)),
    Err(failure) -> Err(failure),
  }

/// The first success among `bodies`, the others cancelled, or every failure in their order.
pub fn first_ok<a, x | e>(
  bodies: List<() -> Result<a, x> / e>,
) -> Result<a, List<x>> / {task.write, abort.raise | e} =
  match gathered(
      bodies,
      Err(map_new()),
      |so_far: Result<a, Map<Int, x>>, i: Int, r: Result<a, x>|
        match ((so_far, r)) {
          (_, Ok(answer)) -> Stop(Ok(answer)),
          (Err(failures), Err(failure)) -> Continue(Err(map_insert(failures, i, failure))),
          (Ok(answer), _) -> Stop(Ok(answer)),
        },
    ) {
    Ok(answer) -> Ok(answer),
    Err(failures) -> Err(map_values(failures)),
  }

/// What the first of `bodies` to end answered, `None` of no bodies. The others are cancelled,
/// and have run their releases when this answers.
pub fn race<a | e>(bodies: List<() -> a / e>) -> Option<a> / {task.write, abort.raise | e} =
  gathered(bodies, None, |_none: Option<a>, _i: Int, answer: a| Stop(Some(answer)))

/// `f` of each of `xs`, in their order, at most `limit` of them running at once. Raises for a
/// `limit` below one.
pub fn map_concurrent<a, b | e>(
  xs: List<a>,
  limit: Int,
  f: (a) -> b / e,
) -> List<b> / {task.write, abort.raise | e} = {
  let n = len(xs);
  if limit < 1 {
    panic("`map_concurrent` runs at most `limit` at once, and this limit is below one")
  } else if n == 0 { [] } else {
    let jobs = task.channel(n);
    fold(range(0, n), (), |_u: Unit, i: Int| {
      task.send(jobs, (i, at(xs, i)));
      ()
    });
    task.close(jobs);
    let worker = ||
      iterate([], n + 1, |done: List<(Int, b)>|
        match task.recv(jobs) {
          Some(job) -> Continue(push(done, (job._0, f(job._1)))),
          None -> Stop(done),
        });
    let parts = all(map(range(0, min(limit, n)), |_i: Int| worker));
    map_values(
      fold(parts, map_new(), |placed: Map<Int, b>, part: List<(Int, b)>|
        fold(part, placed, |m: Map<Int, b>, done: (Int, b)| map_insert(m, done._0, done._1))),
    )
  }
}

// --- Deadlines --------------------------------------------------------------

/// The instant the work around a call must end by.
pub effect deadline {
  /// The earliest deadline around this call, `None` where `unbounded` says there is none.
  read at() -> Option<Instant>
  /// The work did not end by `at`.
  raise passed(at: Instant)
}

/// How work under a deadline ended.
pub type Timed<a> =
  /// It answered in time.
  | Done(a)
  /// The deadline came first, and the work was stopped there.
  | TimedOut

/// `body` with no deadline above it.
pub fn unbounded<a | e>(body: () -> a / {deadline.at | e}) -> a / e =
  handle { body() } with { deadline.at() -> None }

/// The earlier of two deadlines, where `None` is none at all.
pub fn earliest(a: Option<Instant>, b: Option<Instant>) -> Option<Instant> =
  match ((a, b)) {
    (Some(x), Some(y)) -> if nanos_at(x) <= nanos_at(y) { a } else { b },
    (Some(_), None) -> a,
    (None, _) -> b,
  }

/// How long is left before the deadline around this call, `None` where there is none; never
/// below zero.
pub fn remaining() -> Option<Duration> / {deadline.at, clock.read} =
  match deadline.at() {
    None -> None,
    Some(at) -> {
      let left = between(clock.now(), at);
      Some(if as_nanos(left) < 0 { Duration(0) } else { left })
    },
  }

/// Waits until the clock reads `at`; no wait at all for an instant that has passed.
pub fn sleep_until(at: Instant) -> Unit / {clock.read, clock.write} =
  clock.sleep(between(clock.now(), at))

/// `body` run as a task that is stopped at `at`. Inside `body`, and in every task started there,
/// `deadline.at` answers the instant it is held to: `at`, or the deadline already around this
/// call where that is no later, which then stops this call with its body and leaves it nothing
/// to answer. `TimedOut` says the task was cancelled at `at`: it has run its releases, and
/// whatever it had started through this module has ended.
pub fn until<a | e>(
  at: Instant,
  body: () -> a / {deadline.at | e},
) -> Timed<a> / {task.write, clock.read, clock.write, deadline.at | e} = {
  let around = deadline.at();
  let bound = match earliest(Some(at), around) { Some(earlier) -> earlier, None -> at };
  // What set a deadline at or before `at` stops this call's task at it, so no timer is its own.
  let timed = match around { Some(outer) -> nanos_at(at) < nanos_at(outer), None -> true };
  let left = between(clock.now(), bound);
  bracket(
    || {
      let worker = task.spawn(|| handle { body() } with { deadline.at() -> Some(bound) });
      let timers = if timed {
        [
          task.spawn(|| {
            clock.sleep(left);
            task.cancel(worker);
            ()
          }),
        ]
      } else { [] };
      { worker: worker, timers: timers }
    },
    |held: { worker: Task<a>, timers: List<Task<Unit>> }| {
      stopped(held.timers);
      stopped([held.worker])
    },
    |held: { worker: Task<a>, timers: List<Task<Unit>> }|
      match task.await(held.worker) { Some(answer) -> Done(answer), None -> TimedOut },
  )
}

/// `at`, or the deadline around this call where that is earlier.
fn held_to(at: Instant) -> Instant / {deadline.at} =
  match earliest(Some(at), deadline.at()) { Some(bound) -> bound, None -> at }

/// `until` the instant `d` from now.
pub fn timeout<a | e>(
  d: Duration,
  body: () -> a / {deadline.at | e},
) -> Timed<a> / {task.write, clock.read, clock.write, deadline.at | e} =
  until(after(clock.now(), d), body)

/// What `body` answers by `at`, as `until` runs it; raises `deadline.passed` with the instant it
/// was held to where it was stopped there.
pub fn by<a | e>(
  at: Instant,
  body: () -> a / {deadline.at | e},
) -> a / {task.write, clock.read, clock.write, deadline.at, deadline.passed | e} = {
  let bound = held_to(at);
  match until(bound, body) { Done(answer) -> answer, TimedOut -> deadline.passed(bound) }
}

/// `by` the instant `d` from now.
pub fn within<a | e>(
  d: Duration,
  body: () -> a / {deadline.at | e},
) -> a / {task.write, clock.read, clock.write, deadline.at, deadline.passed | e} =
  by(after(clock.now(), d), body)

// --- Permits ----------------------------------------------------------------

/// A count of permits tasks take turns holding. `semaphore` makes one.
pub opaque type Semaphore<c> = | Semaphore(c)

/// A semaphore as `semaphore` makes it.
pub type Permits = Semaphore<Chan<Unit>>

/// A semaphore of `permits` permits. Raises for a count below zero.
pub fn semaphore(permits: Int) -> Permits / {task.write, abort.raise} = {
  let tokens = task.channel(permits);
  fold(range(0, permits), (), |_u: Unit, _i: Int| {
    task.send(tokens, ());
    ()
  });
  Semaphore(tokens)
}

/// What `body` answers while it holds one of `sem`'s permits, waiting for one first. Waiters are
/// served in the order they began to wait. The permit goes back once, however `body` ends, a
/// cancel among them, and a task cancelled while it waits takes none.
pub fn with_permit<a | e>(sem: Permits, body: () -> a / e) -> a / {task.write | e} =
  match sem {
    Semaphore(tokens) -> with_hold[permit](task.recv(tokens), |_held: Option<Unit>| {
      task.send(tokens, ());
      ()
    }) { _permit -> body() },
  }

/// `Some` of what `body` answers while it holds one of `sem`'s permits, or `None`, without
/// running it, when none is free now.
pub fn try_with_permit<a | e>(sem: Permits, body: () -> a / e) -> Option<a> / {task.write | e} =
  match sem {
    Semaphore(tokens) -> with_hold[permit](
      task.select([(tokens, None)], false),
      |held: Option<(Int, Option<Unit>)>|
        match held {
          Some(_) -> {
            task.send(tokens, ());
            ()
          },
          None -> (),
        },
    ) { permit -> match hold_get(permit) { Some(_) -> Some(body()), None -> None } },
  }

// --- Retrying ---------------------------------------------------------------

/// How the wait before another attempt is spread, as the AWS Architecture Blog's "Exponential
/// Backoff And Jitter" names them. The ceiling after `n` failures is `min(cap, base * 2^(n-1))`.
pub type Jitter =
  /// The ceiling itself.
  | NoJitter
  /// Anywhere from nothing to the ceiling.
  | FullJitter
  /// Half the ceiling, and anywhere up to the other half.
  | EqualJitter
  /// Anywhere from `base` to three times the wait before, and no more than `cap`.
  | DecorrelatedJitter

/// How `retry` tries again. Every field is the caller's to choose: there is no default.
pub type Retry<x> = new {
  /// How many times the body may run in all; at least one.
  attempts: Int,
  /// The wait after the first failure, before jitter.
  base: Duration,
  /// The longest wait.
  cap: Duration,
  jitter: Jitter,
  /// Whether another attempt may follow this failure.
  retryable: (x) -> Bool,
  /// How long the attempts and the waits between them may take in all, held to the deadline
  /// around the call where that is earlier; `None` leaves only that deadline.
  within: Option<Duration>,
}

/// Why `retry` stopped at a failure.
pub type Reason =
  /// The body ran `attempts` times.
  | Spent
  /// `retryable` said no.
  | NotRetryable
  /// The wait before another attempt would have ended at or past the deadline.
  | OutOfTime
  /// The retry budget had no retry to give.
  | OverBudget

/// The failure `retry` stopped at, how many times the body had run, and why it ran no more.
pub type GaveUp<x> = new { last: x, attempts: Int, why: Reason }

/// The longest the wait after `failures` failures in a row may be: `base` doubled for each
/// failure after the first, and no more than `cap`.
pub fn wait_ceiling<x>(policy: Retry<x>, failures: Int) -> Duration = {
  let cap = as_nanos(policy.cap);
  Duration(
    fold(range(1, failures), min(cap, as_nanos(policy.base)), |wait: Int, _i: Int|
      if wait > cap / 2 { cap } else { wait * 2 }),
  )
}

/// How many waits the jitter chooses among after `failures` failures, the wait before having
/// been `previous` (`base` before the first): a draw below this picks one. At least one.
pub fn wait_choices<x>(policy: Retry<x>, failures: Int, previous: Duration) -> Int = {
  let ceiling = as_nanos(wait_ceiling(policy, failures));
  match policy.jitter {
    NoJitter -> 1,
    FullJitter -> ceiling + 1,
    EqualJitter -> ceiling / 2 + 1,
    DecorrelatedJitter -> decorrelated_top(policy, previous) - as_nanos(policy.base) + 1,
  }
}

/// The wait after `failures` failures that `draw` picks, a draw below `wait_choices`.
pub fn wait_of<x>(policy: Retry<x>, failures: Int, previous: Duration, draw: Int) -> Duration = {
  let ceiling = as_nanos(wait_ceiling(policy, failures));
  Duration(match policy.jitter {
    NoJitter -> ceiling,
    FullJitter -> draw,
    EqualJitter -> ceiling - ceiling / 2 + draw,
    DecorrelatedJitter -> min(as_nanos(policy.cap), as_nanos(policy.base) + draw),
  })
}

/// Three times the wait before, held between `base` and what an `Int` holds.
fn decorrelated_top<x>(policy: Retry<x>, previous: Duration) -> Int = {
  let before = max(as_nanos(policy.base), as_nanos(previous));
  if before > max_wait() / 3 { max_wait() } else { before * 3 }
}

/// A wait no jitter passes: about a hundred and forty-six years.
fn max_wait() -> Int = 4611686018427387904

/// What `body` answers, run again after each failure `policy` lets it retry: at most
/// `policy.attempts` times, waiting between attempts as `policy.jitter` spreads the waits, each
/// draw one `entropy.below`. `body` is handed the attempt it is, from 1. It stops at the first
/// success, and answers the failure it stopped at with why. A wait that would end at or past the
/// deadline is not begun. Raises for a policy of no attempts, a negative `base`, or a `cap`
/// below `base`.
pub fn retry<a, x | e>(
  policy: Retry<x>,
  body: (Int) -> Result<a, x> / e,
) -> Result<a, GaveUp<x>> / {clock.read, clock.write, random::entropy.below, deadline.at, abort.raise | e} =
  retried(policy, || true, body)

/// `retry` under a retry budget the caller keeps: the call pays into it, each retry draws on
/// it, and a retry it cannot pay for is not made.
pub fn retry_budgeted<a, x | e>(
  policy: Retry<x>,
  load: () -> Budget / e,
  store: (Budget) -> Unit / e,
  body: (Int) -> Result<a, x> / e,
) -> Result<a, GaveUp<x>> / {clock.read, clock.write, random::entropy.below, deadline.at, abort.raise | e} = {
  store(called(load()));
  retried(
    policy,
    ||
      match retrying(load()) {
        Some(rest) -> {
          store(rest);
          true
        },
        None -> false,
      },
    body,
  )
}

type Trying = { attempt: Int, previous: Duration }

fn retried<a, x | e>(
  policy: Retry<x>,
  allowed: () -> Bool / e,
  body: (Int) -> Result<a, x> / e,
) -> Result<a, GaveUp<x>> / {clock.read, clock.write, random::entropy.below, deadline.at, abort.raise | e} =
  if policy.attempts < 1 { panic("a retry policy allows at least one attempt") }
  else if as_nanos(policy.base) < 0 || as_nanos(policy.cap) < as_nanos(policy.base) {
    panic("a retry policy's waits run from a `base` of zero or more to a `cap` at or above it")
  } else {
    let bound = earliest(
      match policy.within { Some(d) -> Some(after(clock.now(), d)), None -> None },
      deadline.at(),
    );
    iterate({ attempt: 1, previous: policy.base }, policy.attempts + 1, |trying: Trying|
      match body(trying.attempt) {
        Ok(answer) -> Stop(Ok(answer)),
        Err(failure) -> if !(policy.retryable)(failure) { gave_up(failure, trying, NotRetryable) }
        else if trying.attempt >= policy.attempts { gave_up(failure, trying, Spent) }
        else if !allowed() { gave_up(failure, trying, OverBudget) } else {
          let choices = wait_choices(policy, trying.attempt, trying.previous);
          let draw = if choices <= 1 { 0 } else { random::below(choices) };
          let wait = wait_of(policy, trying.attempt, trying.previous, draw);
          if past(after(clock.now(), wait), bound) { gave_up(failure, trying, OutOfTime) } else {
            clock.sleep(wait);
            Continue({ attempt: trying.attempt + 1, previous: wait })
          }
        },
      })
  }

fn gave_up<a, x>(failure: x, trying: Trying, why: Reason) -> Iter<Trying, Result<a, GaveUp<x>>> =
  Stop(Err({ last: failure, attempts: trying.attempt, why: why }))

/// Whether `at` is at or past `bound`, which `None` never is.
fn past(at: Instant, bound: Option<Instant>) -> Bool =
  match bound { Some(b) -> nanos_at(at) >= nanos_at(b), None -> false }

// --- A retry budget ---------------------------------------------------------

/// How many retries the calls made so far have paid for. Each call pays in `percent`
/// hundredths of a retry and each retry takes a whole one, so over any run of calls at most
/// `percent` in a hundred are retries, beside the `reserve` it starts with and never banks past.
pub opaque type Budget = new { hundredths: Int, percent: Int, reserve: Int }

/// A budget that lets `percent` retries follow every hundred calls and starts with `reserve`
/// retries in hand. It banks no more than that many, or than one where that is none. Neither
/// number is below zero.
pub fn budget(percent: Int, reserve: Int) -> Budget = {
  let kept = max(0, reserve);
  { hundredths: kept * 100, percent: max(0, percent), reserve: kept }
}

/// The budget after a call pays into it.
pub fn called(b: Budget) -> Budget =
  { ..b, hundredths: min(max(1, b.reserve) * 100, b.hundredths + b.percent) }

/// The budget after a retry draws on it, or `None` where it has no whole retry to give.
pub fn retrying(b: Budget) -> Option<Budget> =
  if b.hundredths < 100 { None } else { Some({ ..b, hundredths: b.hundredths - 100 }) }

/// How many whole retries the budget could pay for now.
pub fn retries_left(b: Budget) -> Int = b.hundredths / 100

// --- A circuit breaker ------------------------------------------------------

/// Where a breaker stands.
pub type Circuit =
  /// Calls pass; this many have failed in a row.
  | Closed(Int)
  /// Calls are refused until this instant.
  | Open(Instant)
  /// One call at a time is let through to probe: this many have succeeded, and one is out now
  /// or not.
  | HalfOpen(Int, Bool)

/// A circuit breaker: it opens after `trip_after` failures in a row, refuses every call for
/// `cooldown`, then lets one call at a time probe, closing after `close_after` of them succeed
/// and opening again at the first that fails.
pub opaque type Breaker = new {
  trip_after: Int,
  cooldown: Duration,
  close_after: Int,
  circuit: Circuit,
}

/// A closed breaker. A `trip_after` or a `close_after` below one is one.
pub fn breaker(trip_after: Int, cooldown: Duration, close_after: Int) -> Breaker =
  {
    trip_after: max(1, trip_after),
    cooldown: cooldown,
    close_after: max(1, close_after),
    circuit: Closed(0),
  }

/// Where the breaker stands.
pub fn circuit(b: Breaker) -> Circuit = b.circuit

/// Whether a call may go at `now`, and the breaker after the asking. An open breaker past its
/// cooldown lets this call probe; a half-open one lets a call probe only while none is out.
/// `probe` says the call is one, which `record` or `abandoned` must then answer.
pub fn admit(b: Breaker, now: Instant) -> { breaker: Breaker, admitted: Bool, probe: Bool } =
  match b.circuit {
    Closed(_) -> { breaker: b, admitted: true, probe: false },
    Open(until) -> if nanos_at(now) < nanos_at(until) {
      { breaker: b, admitted: false, probe: false }
    } else { { breaker: { ..b, circuit: HalfOpen(0, true) }, admitted: true, probe: true } },
    HalfOpen(_, true) -> { breaker: b, admitted: false, probe: false },
    HalfOpen(passed, false) ->
      { breaker: { ..b, circuit: HalfOpen(passed, true) }, admitted: true, probe: true },
  }

/// The breaker after a call it admitted ended at `now`, well or not. A call that ends after the
/// breaker opened changes nothing.
pub fn record(b: Breaker, ok: Bool, now: Instant) -> Breaker =
  match b.circuit {
    Closed(failed) -> if ok { { ..b, circuit: Closed(0) } }
    else if failed + 1 >= b.trip_after { { ..b, circuit: Open(after(now, b.cooldown)) } }
    else { { ..b, circuit: Closed(failed + 1) } },
    Open(_) -> b,
    HalfOpen(passed, _) -> if !ok { { ..b, circuit: Open(after(now, b.cooldown)) } }
    else if passed + 1 >= b.close_after { { ..b, circuit: Closed(0) } }
    else { { ..b, circuit: HalfOpen(passed + 1, false) } },
  }

/// The breaker after a probe ended without an answer, as a cancelled one does: another may go.
pub fn abandoned(b: Breaker) -> Breaker =
  match b.circuit { HalfOpen(passed, true) -> { ..b, circuit: HalfOpen(passed, false) }, _ -> b }

/// How a call behind a breaker ended without its answer.
pub type Broken<x> =
  /// The breaker refused it, and the body did not run.
  | Rejected
  /// The body ran and failed.
  | Failed(x)

/// What `body` answers behind the breaker the caller keeps: refused without running while the
/// breaker says so, and recorded with the clock's reading when it ends. A probe that is
/// cancelled is given back, so another may go.
pub fn guarded<a, x | e>(
  load: () -> Breaker / e,
  store: (Breaker) -> Unit / e,
  body: () -> Result<a, x> / e,
) -> Result<a, Broken<x>> / {clock.read | e} = {
  let asked = clock.now();
  bracket(
    || {
      let answer = admit(load(), asked);
      store(answer.breaker);
      answer
    },
    |answer: { breaker: Breaker, admitted: Bool, probe: Bool }|
      if answer.probe { store(abandoned(load())) } else { () },
    |answer: { breaker: Breaker, admitted: Bool, probe: Bool }|
      if !answer.admitted { Err(Rejected) } else {
        let ended = body();
        let now = clock.now();
        store(record(load(), match ended { Ok(_) -> true, Err(_) -> false }, now));
        match ended { Ok(done) -> Ok(done), Err(failure) -> Err(Failed(failure)) }
      },
  )
}

// --- A rate limit -----------------------------------------------------------

/// A token bucket: `capacity` calls may go at once, and one more every `every` after.
pub opaque type Bucket = new {
  capacity: Int,
  every: Duration,
  /// When the bucket would be full again were nothing more taken.
  full_at: Instant,
}

/// A bucket full at `now`. A `capacity` below one is one, and an `every` below a nanosecond is
/// one.
pub fn bucket(capacity: Int, every: Duration, now: Instant) -> Bucket =
  { capacity: max(1, capacity), every: Duration(max(1, as_nanos(every))), full_at: now }

/// A token taken at `now`: the bucket after, and how long from `now` until the token is there
/// to use, nothing while the bucket holds one. Tokens are handed out in the order they are
/// reserved, so a wait is behind every reservation before it.
pub fn reserve(b: Bucket, now: Instant) -> { bucket: Bucket, wait: Duration } = {
  let every = as_nanos(b.every);
  let full_at = max(nanos_at(b.full_at), nanos_at(now)) + every;
  let ready = full_at - b.capacity * every;
  { bucket: { ..b, full_at: Instant(full_at) }, wait: Duration(max(0, ready - nanos_at(now))) }
}

/// The bucket after a token is taken at `now`, or `None` where it holds none then.
pub fn take(b: Bucket, now: Instant) -> Option<Bucket> = {
  let reserved = reserve(b, now);
  if as_nanos(reserved.wait) == 0 { Some(reserved.bucket) } else { None }
}

/// How many tokens the bucket holds at `now`.
pub fn tokens(b: Bucket, now: Instant) -> Int / {abort.raise} = {
  let owed = nanos_at(b.full_at) - nanos_at(now);
  if owed <= 0 { b.capacity }
  else { max(0, b.capacity - (owed + as_nanos(b.every) - 1) / as_nanos(b.every)) }
}

/// What `body` answers once the bucket the caller keeps has a token for it: the token is
/// reserved at once and the call waits its turn on the clock. A call cancelled while it waits
/// has spent its token.
pub fn throttled<a | e>(
  load: () -> Bucket / e,
  store: (Bucket) -> Unit / e,
  body: () -> a / e,
) -> a / {clock.read, clock.write | e} = {
  let now = clock.now();
  let reserved = reserve(load(), now);
  store(reserved.bucket);
  clock.sleep(reserved.wait);
  body()
}

// --- One run for many callers -----------------------------------------------

/// The runs under way, by key: `flights` is none. A caller keeps one in a cell opened inside the
/// region its tasks run in.
pub type Flights<k, a> = { next: Int, flying: Map<k, { id: Int, waiting: List<Chan<a>> }> }

/// No run under way.
pub fn flights<k, a>() -> Flights<k, a>
  where derivable(ord, k)
= { next: 0, flying: map_new() }

/// What `body` answers, run once for every caller that asks for `key` while it runs: the first
/// runs it and the others wait for its answer. A later caller, once it has answered, runs it
/// again. Where the caller running it is cancelled, one of those waiting runs it instead.
pub fn single_flight<k, a | e>(
  load: () -> Flights<k, a> / e,
  store: (Flights<k, a>) -> Unit / e,
  key: k,
  body: () -> a / e,
) -> a / {task.write, diverges | e}
  where derivable(ord, k)
= {
  let mine = task.channel(1);
  let now = load();
  match map_get(now.flying, key) {
    Some(flight) -> {
      store({
        ..now,
        flying: map_insert(now.flying, key, { ..flight, waiting: push(flight.waiting, mine) }),
      });
      match task.recv(mine) {
        Some(answer) -> answer,
        None -> single_flight(load, store, key, body),
      }
    },
    None -> {
      store({
        next: now.next + 1,
        flying: map_insert(now.flying, key, { id: now.next, waiting: [] }),
      });
      bracket(|| (), |_u: Unit| landed(load, store, key, now.next, None), |_u: Unit| {
        let answer = body();
        bracket(|| landed(load, store, key, now.next, Some(answer)), |_u: Unit| (), |_u: Unit|
          answer)
      })
    },
  }
}

/// Ends the flight `id` for `key`, if it is still the one under way: each caller waiting on it
/// is sent `answer`, or told there is none.
fn landed<k, a | e>(
  load: () -> Flights<k, a> / e,
  store: (Flights<k, a>) -> Unit / e,
  key: k,
  id: Int,
  answer: Option<a>,
) -> Unit / {task.write | e}
  where derivable(ord, k)
= {
  let now = load();
  match map_get(now.flying, key) {
    Some(flight) -> if flight.id != id { () } else {
      store({ ..now, flying: map_remove(now.flying, key) });
      fold(flight.waiting, (), |_u: Unit, waiter: Chan<a>|
        match answer {
          Some(x) -> {
            task.send(waiter, x);
            ()
          },
          None -> task.close(waiter),
        })
    },
    None -> (),
  }
}

// --- Ticks ------------------------------------------------------------------

/// What a ticker does when the work of one tick runs past the next.
pub type Missed =
  /// Ticks stay on the first schedule, the late ones coming one after another until it has
  /// caught up.
  | Burst
  /// The next tick is a whole period after the late one ended, and the schedule moves with it.
  | Delay
  /// The ticks missed are dropped: the next is the first on the schedule still to come.
  | Skip

/// When the tick after the one due at `due` is due, the work of that one having ended at
/// `now`. Raises for a period below a nanosecond.
pub fn next_due(
  missed: Missed,
  period: Duration,
  due: Instant,
  now: Instant,
) -> Instant / {abort.raise} = {
  let step = as_nanos(period);
  let late = nanos_at(now) - nanos_at(due);
  if step < 1 { panic("a ticker's period is at least a nanosecond") }
  else if late < step { after(due, period) } else {
    match missed {
      Burst -> after(due, period),
      Delay -> after(now, period),
      Skip -> Instant(nanos_at(due) + (late / step + 1) * step),
    }
  }
}

/// `tick` run each `period` from one period after now, at most `limit` times: it is handed
/// what the tick before answered, from `init`, and the instant it was due, and answers
/// `Continue` to tick again or `Stop` to end. Answers the last of those. `missed` says what
/// follows a tick that ran past the next. Raises for a period below a nanosecond.
pub fn every<s | e>(
  period: Duration,
  missed: Missed,
  limit: Int,
  init: s,
  tick: (s, Instant) -> Iter<s, s> / e,
) -> s / {clock.read, clock.write, abort.raise | e} =
  if limit < 1 { init } else {
    iterate(
      { state: init, due: next_due(missed, period, clock.now(), clock.now()), ticked: 0 },
      limit + 1,
      |ticking: { state: s, due: Instant, ticked: Int }|
        if ticking.ticked == limit { Stop(ticking.state) } else {
          sleep_until(ticking.due);
          match tick(ticking.state, ticking.due) {
            Stop(last) -> Stop(last),
            Continue(next) ->
              Continue({
                state: next,
                due: next_due(missed, period, ticking.due, clock.now()),
                ticked: ticking.ticked + 1,
              }),
          }
        },
    )
  }

// --- Tests ------------------------------------------------------------------

fn nap(n: Int) -> Int / {clock.write} = {
  clock.sleep(Duration(n));
  n
}

/// How many are inside now, and the most there have been at once.
type Gauge = { inside: Int, most: Int }

fn entered(g: Gauge) -> Gauge = { inside: g.inside + 1, most: max(g.most, g.inside + 1) }

fn left(g: Gauge) -> Gauge = { ..g, inside: g.inside - 1 }

/// Work that takes `work` under a timeout of `budget`: how it ends, and when.
type Bounded = { name: String, budget: Int, work: Int, ended: Timed<Int>, at: Int }

fn bounded() -> List<Bounded> =
  [
    { name: "work past it is stopped there", budget: 100, work: 250, ended: TimedOut, at: 100 },
    { name: "work inside it answers", budget: 100, work: 40, ended: Done(40), at: 40 },
    { name: "work that does not wait answers", budget: 100, work: 0, ended: Done(0), at: 0 },
  ]

test "a timeout runs on the virtual clock: {c.name}" for c: Bounded in bounded() {
  simulate {
    unbounded(|| {
      let ended = timeout(Duration(c.budget), || nap(c.work));
      assert_eq((ended, clock.now()), (c.ended, Instant(c.at)))
    })
  }
}

/// A count small enough that a law runs every interleaving at each one.
type Few = | Zero | One | Two | Three

fn count(n: Few) -> Int = match n { Zero -> 0, One -> 1, Two -> 2, Three -> 3 }

law "work ends before its timeout or is stopped at it, in every interleaving"
  forall (allowed: Few, taken: Few) {
    simulate {
      unbounded(|| {
        let budget = count(allowed);
        let work = count(taken);
        let ended = timeout(Duration(budget), || nap(work));
        let at = clock.now();
        if work < budget { ended == Done(work) && at == Instant(work) }
        else if work > budget { ended == TimedOut && at == Instant(budget) }
        else { at == Instant(budget) && (ended == Done(work) || ended == TimedOut) }
      })
    }
  }

/// Work that never ends in time under a timeout of `inner` inside one of `outer`.
type Nested = { name: String, outer: Int, inner: Int, ended: Timed<Timed<Int>>, at: Int }

fn nested() -> List<Nested> =
  [
    {
      name: "an inner one that names a later instant is stopped at the outer",
      outer: 50,
      inner: 200,
      ended: TimedOut,
      at: 50,
    },
    {
      name: "an inner one that names an earlier instant stops its work there",
      outer: 50,
      inner: 20,
      ended: Done(TimedOut),
      at: 20,
    },
  ]

test "timeouts nest by the earlier deadline: {c.name}" for c: Nested in nested() {
  simulate {
    unbounded(|| {
      let ended = timeout(Duration(c.outer), || timeout(Duration(c.inner), || nap(1000)));
      assert_eq((ended, clock.now()), (c.ended, Instant(c.at)))
    })
  }
}

test "work under two deadlines reads the earlier, whichever is the inner" {
  simulate {
    unbounded(|| {
      let read = timeout(Duration(50), || timeout(Duration(200), || deadline.at()));
      assert_eq(read, Done(Done(Some(Instant(50)))))
    })
  }
}

test "a task started under a deadline reads it, and none is read where there is none" {
  simulate {
    unbounded(|| {
      assert_eq(deadline.at(), None);
      assert_eq(remaining(), None);
      let read = until(Instant(30), || {
        let t = task.spawn(|| {
          clock.sleep(Duration(10));
          remaining()
        });
        task.join(t)
      });
      assert_eq(read, Done(Some(Duration(20))))
    })
  }
}

test "the raising form answers work that ends in time" {
  simulate { unbounded(|| assert_eq(try { within(Duration(5), || nap(3)) }, Ok(3))) }
}

test "the raising form raises the instant its work was held to" {
  simulate { unbounded(|| assert_eq(try { within(Duration(5), || nap(10)) }, Err(Instant(5)))) }
}

test "the raising form by an instant raises that instant" {
  simulate {
    unbounded(|| {
      clock.sleep(Duration(1));
      assert_eq(try { by(Instant(4), || nap(10)) }, Err(Instant(4)));
      assert_eq(clock.now(), Instant(4))
    })
  }
}

test "work a timeout stops has released what it held when the timeout answers" {
  with_cell[seen]([]) { c -> {
    simulate {
      unbounded(|| {
        let ended = timeout(Duration(5), ||
          bracket(
            || cell_set(c, push(cell_get(c), "open")),
            |_u: Unit| cell_set(c, push(cell_get(c), "close")),
            |_u: Unit| nap(10),
          ));
        assert_eq(ended, TimedOut);
        assert_eq(cell_get(c), ["open", "close"])
      })
    }
  } }
}

test "a cancelled timeout stops its work and its timer: nothing of either runs on" {
  with_cell[seen]([]) { c -> {
    simulate {
      let outer = task.spawn(||
        unbounded(||
          timeout(Duration(50), || {
            clock.sleep(Duration(10));
            cell_set(c, push(cell_get(c), "late"))
          })));
      clock.sleep(Duration(5));
      assert(task.cancel(outer));
      assert_eq(task.await(outer), None);
      assert_eq(clock.now(), Instant(5));
      clock.sleep(Duration(100));
      assert_eq(clock.now(), Instant(105))
    };
    assert_eq(cell_get(c), [])
  } }
}

test "each loser of a race has released what it held when the race answers" {
  with_cell[seen]([]) { c -> {
    let won = simulate {
      let runner = |name: String, takes: Int|
        || bracket(|| (), |_u: Unit| cell_set(c, push(cell_get(c), name)), |_u: Unit| nap(takes));
      let first = race([runner("a", 30), runner("b", 10), runner("c", 20)]);
      (first, cell_get(c), clock.now())
    };
    assert_eq(won._0, Some(10));
    assert_eq(sort(won._1), ["a", "b", "c"]);
    assert_eq(won._2, Instant(10))
  } }
}

law "a race answers the body that ends first and takes no longer, in every interleaving"
  forall (a: Few, b: Few, c: Few) where a != b && a != c && b != c {
    simulate {
      let first = min(count(a), min(count(b), count(c)));
      race([|| nap(count(a)), || nap(count(b)), || nap(count(c))]) == Some(first)
        && clock.now() == Instant(first)
    }
  }

test "a race of no bodies has no answer" {
  simulate {
    let none: List<() -> Int / {clock.write}> = [];
    assert_eq(race(none), None)
  }
}

test "all answers each body's answer in the bodies' order, and takes as long as the longest" {
  simulate {
    assert_eq(all([|| nap(30), || nap(10), || nap(20)]), [30, 10, 20]);
    assert_eq(clock.now(), Instant(30));
    let none: List<() -> Int / {clock.write}> = [];
    assert_eq(all(none), [])
  }
}

fn checked(takes: Int, ok: Bool) -> Result<Int, String> / {clock.write} = {
  clock.sleep(Duration(takes));
  if ok { Ok(takes) } else { Err("failed at " ++ int_to_string(takes)) }
}

test "all_ok answers every success in the bodies' order" {
  simulate {
    assert_eq(
      all_ok([|| checked(3, true), || checked(1, true), || checked(2, true)]),
      Ok([3, 1, 2]),
    )
  }
}

test "all_ok stops at the first failure, and no body is left running" {
  with_cell[seen]([]) { c -> {
    simulate {
      let late = |takes: Int|
        || {
          let r = checked(takes, true);
          cell_set(c, push(cell_get(c), "late"));
          r
        };
      assert_eq(all_ok([late(50), || checked(10, false), late(40)]), Err("failed at 10"));
      assert_eq(clock.now(), Instant(10));
      clock.sleep(Duration(100))
    };
    assert_eq(cell_get(c), [])
  } }
}

test "first_ok answers the first success and stops the rest" {
  simulate {
    let first = first_ok([|| checked(30, true), || checked(10, false), || checked(20, true)]);
    assert_eq((first, clock.now()), (Ok(20), Instant(20)))
  }
}

test "first_ok of bodies that all fail answers every failure in the bodies' order" {
  simulate {
    assert_eq(
      first_ok([|| checked(3, false), || checked(1, false)]),
      Err(["failed at 3", "failed at 1"]),
    )
  }
}

law "map_concurrent answers in the order given and never runs more than its limit at once"
  forall (items: Few, at_once: Few) where at_once != Zero && (items != Three || at_once != Three) {
    simulate {
      with_cell[gauge]({ inside: 0, most: 0 }) { g -> {
        let n = count(items);
        let got = map_concurrent(range(0, n), count(at_once), |x: Int| {
          cell_set(g, entered(cell_get(g)));
          task.yield();
          cell_set(g, left(cell_get(g)));
          x * 2
        });
        got == map(range(0, n), |x: Int| x * 2) && cell_get(g).most <= count(at_once)
          && cell_get(g).inside == 0
      } }
    }
  }

test "map_concurrent of nothing is nothing, and a limit below one raises" {
  simulate {
    let none: List<Int> = [];
    assert_eq(map_concurrent(none, 2, |x: Int| x), []);
    assert_eq(handle { map_concurrent([1], 0, |x: Int| x) } with { abort.raise(_m) -> [0 - 1] }, [
      0 - 1,
    ])
  }
}

law "a semaphore never admits more holders than it has permits, in every interleaving"
  forall (permits: Few, tasks: Few)
  where permits != Zero && permits != Three && (permits == One || tasks != Three) {
    simulate {
      with_cell[gauge]({ inside: 0, most: 0 }) { g -> {
        let sem = semaphore(count(permits));
        all(
          map(range(0, count(tasks)), |_i: Int|
            ||
              with_permit(sem, || {
                cell_set(g, entered(cell_get(g)));
                task.yield();
                cell_set(g, left(cell_get(g)))
              })),
        );
        cell_get(g).most <= count(permits) && cell_get(g).inside == 0
          && (count(tasks) == 0 || cell_get(g).most >= 1)
      } }
    }
  }

law "a semaphore of one permit admits its waiters in the order they asked, in every interleaving"
  forall (tasks: Few) {
    simulate {
      with_cell[order]({ asked: [], entered: [] }) { o -> {
        let sem = semaphore(1);
        all(
          map(range(0, count(tasks)), |i: Int|
            || {
              cell_set(o, { ..cell_get(o), asked: push(cell_get(o).asked, i) });
              with_permit(sem, || {
                cell_set(o, { ..cell_get(o), entered: push(cell_get(o).entered, i) });
                task.yield()
              })
            }),
        );
        cell_get(o).asked == cell_get(o).entered
      } }
    }
  }

test "a semaphore serves its waiters in the order they began to wait" {
  with_cell[seen]([]) { c -> {
    simulate {
      let sem = semaphore(1);
      let waiter = |name: String, from: Int|
        || {
          clock.sleep(Duration(from));
          with_permit(sem, || {
            cell_set(c, push(cell_get(c), name));
            clock.sleep(Duration(10))
          })
        };
      all([waiter("third", 3), waiter("first", 0), waiter("second", 2), waiter("fourth", 4)]);
      ()
    };
    assert_eq(cell_get(c), ["first", "second", "third", "fourth"])
  } }
}

test "a permit goes back however its holder ends: cancelled anywhere, or by a raise" {
  simulate {
    let sem = semaphore(1);
    let holder = task.spawn(|| with_permit(sem, || task.yield()));
    task.cancel(holder);
    task.await(holder);
    assert_eq(try_with_permit(sem, || 1), Some(1));
    let raised = handle { with_permit(sem, || panic("gone")) } with { abort.raise(_m) -> 0 };
    assert_eq(raised, 0);
    assert_eq(with_permit(sem, || try_with_permit(sem, || 2)), None);
    assert_eq(try_with_permit(sem, || 3), Some(3))
  }
}

test "scoped ends every task it started when its caller is cancelled" {
  with_cell[seen]([]) { c -> {
    simulate {
      let late = |name: String|
        || {
          clock.sleep(Duration(10));
          cell_set(c, push(cell_get(c), name))
        };
      let outer = task.spawn(||
        scoped([late("a"), late("b")], |_kids: List<Task<Unit>>| clock.sleep(Duration(100))));
      task.cancel(outer);
      task.await(outer);
      clock.sleep(Duration(50))
    };
    assert_eq(cell_get(c), [])
  } }
}

// --- Tests of retrying ------------------------------------------------------

fn spread(
  jitter: Jitter,
  base: Int,
  cap: Int,
  attempts: Int,
  within: Option<Duration>,
) -> Retry<String> =
  {
    attempts: attempts,
    base: Duration(base),
    cap: Duration(cap),
    jitter: jitter,
    retryable: |failure: String| failure != "fatal",
    within: within,
  }

fn refused(attempt: Int) -> Result<Int, String> = Err("no " ++ int_to_string(attempt))

/// The waits `failures` failures in a row make under `policy`, drawn from `r`, in all.
fn waited(policy: Retry<String>, r: random::Rand, failures: Int) -> Int / {abort.raise} =
  fold(
    range(1, failures + 1),
    { total: 0, previous: policy.base, rand: r },
    |so_far: { total: Int, previous: Duration, rand: random::Rand }, n: Int| {
      let choices = wait_choices(policy, n, so_far.previous);
      let drawn = if choices <= 1 { { value: 0, rand: so_far.rand } } else {
        match random::rand_below(so_far.rand, choices) {
          Some(d) -> d,
          None -> panic("a wait has at least one choice"),
        }
      };
      let wait = wait_of(policy, n, so_far.previous, drawn.value);
      { total: so_far.total + as_nanos(wait), previous: wait, rand: drawn.rand }
    },
  ).total

test "a retry without jitter waits its base doubled up to its cap, until its attempts are spent" {
  let ended = simulate {
    unbounded(||
      random::with_rand(random::rand(1), || {
        let last = retry(spread(NoJitter, 10, 40, 5, None), refused);
        (last, clock.now())
      }).value)
  };
  assert_eq(ended, (Err({ last: "no 5", attempts: 5, why: Spent }), Instant(110)))
}

type Spread = { name: String, jitter: Jitter }

fn spreads() -> List<Spread> =
  [
    { name: "none", jitter: NoJitter },
    { name: "full", jitter: FullJitter },
    { name: "equal", jitter: EqualJitter },
    { name: "decorrelated", jitter: DecorrelatedJitter },
  ]

test "a retry waits what its jitter makes of the draws the simulation's seed decides: {c.name}" for c: Spread in spreads(
  ) {
  simulate {
    unbounded(|| {
      let policy = spread(c.jitter, 10, 200, 5, None);
      let seeded = random::rand(sim.seed());
      random::with_rand(seeded, || {
        retry(policy, refused);
        ()
      });
      assert_eq(clock.now(), Instant(waited(policy, seeded, 4)))
    })
  }
}

test "a retry does not begin a wait that would end at or past its deadline" {
  let own = simulate {
    unbounded(||
      random::with_rand(random::rand(1), || {
        let last = retry(spread(NoJitter, 10, 40, 5, Some(Duration(25))), refused);
        (last, clock.now())
      }).value)
  };
  assert_eq(own, (Err({ last: "no 2", attempts: 2, why: OutOfTime }), Instant(10)));
  let around = simulate {
    unbounded(|| {
      let ended = until(Instant(25), ||
        random::with_rand(random::rand(1), ||
          retry(spread(NoJitter, 10, 40, 5, None), refused)).value);
      (ended, clock.now())
    })
  };
  assert_eq(around, (Done(Err({ last: "no 2", attempts: 2, why: OutOfTime })), Instant(10)))
}

test "a retry stops at a failure its policy does not retry, and at the first success" {
  let ended = simulate {
    unbounded(||
      random::with_rand(random::rand(1), || {
        let fatal = retry(spread(NoJitter, 10, 40, 5, None), |attempt: Int|
          if attempt < 2 { refused(attempt) } else { Err("fatal") });
        let at = clock.now();
        let third = retry(spread(NoJitter, 10, 40, 5, None), |attempt: Int|
          if attempt < 3 { refused(attempt) } else { Ok(attempt) });
        (fatal, at, third, clock.now())
      }).value)
  };
  assert_eq(ended._0, Err({ last: "fatal", attempts: 2, why: NotRetryable }));
  assert_eq(ended._1, Instant(10));
  assert_eq(ended._2, Ok(3));
  assert_eq(ended._3, Instant(40))
}

test "a retry under a budget is made only while the budget pays, and each call pays in" {
  with_cell[paid](budget(50, 1)) { b -> {
    let ended = simulate {
      unbounded(||
        random::with_rand(random::rand(1), || {
          let call = ||
            retry_budgeted(
              spread(NoJitter, 10, 40, 5, None),
              || cell_get(b),
              |next: Budget| cell_set(b, next),
              refused,
            );
          [call(), call(), call()]
        }).value)
    };
    assert_eq(ended, [over_budget(2), over_budget(1), over_budget(2)]);
    assert_eq(retries_left(cell_get(b)), 0)
  } }
}

fn over_budget(attempts: Int) -> Result<Int, GaveUp<String>> =
  Err({ last: "no " ++ int_to_string(attempts), attempts: attempts, why: OverBudget })

law "a budget never pays for more retries than its reserve and its share of the calls"
  forall (share: Int, held: Int, script: List<Bool>) {
    let percent = rem_euclid(share, 101);
    let reserve = rem_euclid(held, 4);
    let ran = fold(
      script,
      { budget: budget(percent, reserve), calls: 0, retries: 0 },
      |so_far: { budget: Budget, calls: Int, retries: Int }, call: Bool|
        if call { { ..so_far, budget: called(so_far.budget), calls: so_far.calls + 1 } } else {
          match retrying(so_far.budget) {
            Some(rest) -> { ..so_far, budget: rest, retries: so_far.retries + 1 },
            None -> so_far,
          }
        },
    );
    ran.retries * 100 <= reserve * 100 + percent * ran.calls
      && retries_left(ran.budget) <= max(1, reserve)
  }

fn doubled(base: Int, times: Int) -> Int =
  fold(range(0, times), base, |wait: Int, _i: Int| wait * 2)

law "without jitter a wait is the base doubled for each failure before it, and no more than the cap"
  forall (from: Int, room: Int, failed: Int) {
    let base = rem_euclid(from, 21);
    let extra = rem_euclid(room, 201);
    let failures = 1 + rem_euclid(failed, 8);
    let policy = spread(NoJitter, base, base + extra, 9, None);
    wait_choices(policy, failures, Duration(base)) == 1
      && wait_of(policy, failures, Duration(base), 0)
      == Duration(min(base + extra, doubled(base, failures - 1)))
  }

law "a wait is never past the cap nor below what its jitter keeps, whatever the draw"
  forall (jitter: Jitter, from: Int, room: Int, failed: Int, waited_before: Int, pick: Int) {
    let base = rem_euclid(from, 21);
    let extra = rem_euclid(room, 201);
    let failures = 1 + rem_euclid(failed, 8);
    let before = rem_euclid(waited_before, 301);
    let policy = spread(jitter, base, base + extra, 9, None);
    let ceiling = min(base + extra, doubled(base, failures - 1));
    let choices = wait_choices(policy, failures, Duration(before));
    let wait = as_nanos(wait_of(policy, failures, Duration(before), rem_euclid(pick, choices)));
    choices >= 1 && wait <= base + extra
      && (match jitter {
        NoJitter -> wait == ceiling,
        FullJitter -> wait >= 0 && wait <= ceiling,
        EqualJitter -> wait >= ceiling - ceiling / 2 && wait <= ceiling,
        DecorrelatedJitter -> wait >= base && wait <= max(base, before) * 3,
      })
  }

// --- Tests of the breaker, the bucket and single flight ---------------------

law "a closed breaker opens at the failure that makes its count, and a success starts the count again"
  forall (count_of: Int, failed: Int) {
    let trip = 1 + rem_euclid(count_of, 4);
    let fails = rem_euclid(failed, 6);
    let b = fold(range(0, fails), breaker(trip, Duration(10), 1), |b: Breaker, i: Int|
      record(b, false, Instant(i)));
    if fails >= trip { circuit(b) == Open(Instant(trip - 1 + 10)) } else {
      circuit(b) == Closed(fails) && circuit(record(b, true, Instant(9))) == Closed(0)
        && admit(b, Instant(9)).admitted
    }
  }

law "an open breaker refuses every call before its cooldown ends, and lets one probe from then on"
  forall (cools: Int, asks: Int) {
    let cooldown = rem_euclid(cools, 6);
    let asked = rem_euclid(asks, 9);
    let open = record(breaker(1, Duration(cooldown), 2), false, Instant(0));
    let first = admit(open, Instant(asked));
    let second = admit(first.breaker, Instant(asked));
    if asked < cooldown { !first.admitted && !first.probe && first.breaker == open } else {
      first.admitted && first.probe && circuit(first.breaker) == HalfOpen(0, true)
        && !second.admitted
        && admit(abandoned(first.breaker), Instant(asked)).admitted
    }
  }

law "a half-open breaker closes after its count of probes succeed, and opens at the first that fails"
  forall (closes: Int, passed: Int, later: Int) {
    let close = 1 + rem_euclid(closes, 3);
    let passes = rem_euclid(passed, 4);
    let now = 5 + rem_euclid(later, 5);
    let half = admit(record(breaker(1, Duration(5), close), false, Instant(0)), Instant(5)).breaker;
    let probed = fold(range(0, passes), half, |b: Breaker, _i: Int|
      admit(record(b, true, Instant(now)), Instant(now)).breaker);
    if passes >= close { circuit(probed) == Closed(0) } else {
      circuit(probed) == HalfOpen(passes, true)
        && circuit(record(probed, false, Instant(now))) == Open(Instant(now + 5))
    }
  }

test "a call behind a breaker is refused while it is open, probes after the cooldown, and closes it" {
  with_cell[state](breaker(2, Duration(10), 1)) { c -> {
    simulate {
      let call = |ok: Bool|
        guarded(|| cell_get(c), |b: Breaker| cell_set(c, b), ||
          if ok { Ok(1) } else { Err("down") });
      assert_eq(call(false), Err(Failed("down")));
      assert_eq(call(false), Err(Failed("down")));
      assert_eq(call(true), Err(Rejected));
      clock.sleep(Duration(10));
      assert_eq(call(true), Ok(1));
      assert_eq(circuit(cell_get(c)), Closed(0))
    }
  } }
}

fn slow_ok(takes: Int) -> Result<Int, String> / {clock.write} = {
  clock.sleep(Duration(takes));
  Ok(takes)
}

test "a probe that is cancelled is given back, so the next call may probe" {
  with_cell[state](record(breaker(1, Duration(0), 1), false, Instant(0))) { c -> {
    simulate {
      let call = |takes: Int|
        guarded(|| cell_get(c), |b: Breaker| cell_set(c, b), || slow_ok(takes));
      let probe = task.spawn(|| call(50));
      clock.sleep(Duration(1));
      assert_eq(call(1), Err(Rejected));
      assert(task.cancel(probe));
      assert_eq(task.await(probe), None);
      assert_eq(circuit(cell_get(c)), HalfOpen(0, false));
      assert_eq(call(1), Ok(1))
    }
  } }
}

law "a full bucket lets its capacity go at once and then one each period, in the order reserved"
  forall (holds: Int, period: Int, takes: Int) {
    let capacity = 1 + rem_euclid(holds, 3);
    let every = 1 + rem_euclid(period, 3);
    let taken = rem_euclid(takes, 7);
    let b = fold(
      range(0, taken),
      bucket(capacity, Duration(every), Instant(0)),
      |b: Bucket, _i: Int| reserve(b, Instant(0)).bucket,
    );
    reserve(b, Instant(0)).wait == Duration(max(0, taken + 1 - capacity) * every)
      && take(b, Instant(0)) == None == (taken >= capacity)
      && tokens(b, Instant(0)) == max(0, capacity - taken)
  }

law "a bucket left alone fills again, to its capacity and no further"
  forall (holds: Int, period: Int, takes: Int, rests: Int) {
    let capacity = 1 + rem_euclid(holds, 3);
    let every = 1 + rem_euclid(period, 3);
    let taken = rem_euclid(takes, capacity + 1);
    let idle = rem_euclid(rests, 13);
    let b = fold(
      range(0, taken),
      bucket(capacity, Duration(every), Instant(0)),
      |b: Bucket, _i: Int| reserve(b, Instant(0)).bucket,
    );
    tokens(b, Instant(idle)) == min(capacity, max(0, capacity - taken + idle / every))
  }

test "calls through a bucket go at once while it holds tokens, and then one each period" {
  with_cell[rate](bucket(2, Duration(10), Instant(0))) { c -> {
    let times = simulate {
      map(range(0, 5), |_i: Int|
        throttled(|| cell_get(c), |b: Bucket| cell_set(c, b), || clock.now()))
    };
    assert_eq(times, [Instant(0), Instant(0), Instant(10), Instant(20), Instant(30)])
  } }
}

test "tasks through one bucket are spaced as one caller's calls are, in every interleaving" {
  with_cell[rate](bucket(1, Duration(10), Instant(0))) { c -> {
    let times = simulate {
      all(
        map(range(0, 3), |_i: Int|
          || throttled(|| cell_get(c), |b: Bucket| cell_set(c, b), || clock.now())),
      )
    };
    assert_eq(sort(times), [Instant(0), Instant(10), Instant(20)])
  } }
}

test "callers that ask for one key while it runs share one run and its answer, in every interleaving" {
  with_cell[runs](0) { runs -> {
    let answers = simulate {
      let none: Flights<String, Int> = flights();
      with_cell[flying](none) { f -> {
        let ask = |key: String|
          ||
            single_flight(
              || cell_get(f),
              |next: Flights<String, Int>| cell_set(f, next),
              key,
              || {
                cell_set(runs, cell_get(runs) + 1);
                clock.sleep(Duration(10));
                string_len(key)
              },
            );
        all([
          ask("a"),
          ask("a"),
          || {
            clock.sleep(Duration(1));
            ask("a")()
          },
        ])
      } }
    };
    assert_eq(answers, [1, 1, 1]);
    assert_eq(cell_get(runs), 1)
  } }
}

test "callers that ask for different keys each run their own, and a later caller runs again" {
  with_cell[runs](0) { runs -> {
    let answers = simulate {
      let none: Flights<String, Int> = flights();
      with_cell[flying](none) { f -> {
        let ask = |key: String|
          ||
            single_flight(
              || cell_get(f),
              |next: Flights<String, Int>| cell_set(f, next),
              key,
              || {
                cell_set(runs, cell_get(runs) + 1);
                clock.sleep(Duration(10));
                string_len(key)
              },
            );
        let together = all([ask("a"), ask("bb")]);
        concat(together, [ask("a")()])
      } }
    };
    assert_eq(answers, [1, 2, 1]);
    assert_eq(cell_get(runs), 3)
  } }
}

test "where the caller running a flight is cancelled, a caller waiting on it runs it instead" {
  with_cell[runs](0) { runs -> {
    let ended = simulate {
      let none: Flights<String, Int> = flights();
      with_cell[flying](none) { f -> {
        let ask = ||
          single_flight(|| cell_get(f), |next: Flights<String, Int>| cell_set(f, next), "a", || {
            cell_set(runs, cell_get(runs) + 1);
            clock.sleep(Duration(10));
            7
          });
        let answers = unbounded(||
          all([
            || timeout(Duration(5), ask),
            || {
              clock.sleep(Duration(1));
              Done(ask())
            },
          ]));
        (answers, clock.now())
      } }
    };
    assert_eq(ended, ([TimedOut, Done(7)], Instant(15)));
    assert_eq(cell_get(runs), 2)
  } }
}

// --- Tests of ticks ---------------------------------------------------------

law "a tick whose work ended before the next was due leaves the schedule as it was, whatever the policy"
  forall (missed: Missed, every: Int, from: Int, took: Int) {
    let period = 1 + rem_euclid(every, 5);
    let due = rem_euclid(from, 6);
    let late = rem_euclid(took, period);
    next_due(missed, Duration(period), Instant(due), Instant(due + late)) == Instant(due + period)
  }

law "after a late tick a burst keeps the schedule, a delay starts a period from now, and a skip takes the schedule's next tick still to come"
  forall (every: Int, from: Int, took: Int) {
    let period = 1 + rem_euclid(every, 4);
    let due = rem_euclid(from, 5);
    let now = due + period + rem_euclid(took, 10);
    let next = |missed: Missed|
      nanos_at(next_due(missed, Duration(period), Instant(due), Instant(now)));
    let skipped = next(Skip);
    next(Burst) == due + period && next(Delay) == now + period && skipped > now
      && skipped <= now + period
      && (skipped - due) % period == 0
  }

fn ticked(missed: Missed) -> List<Int> / {clock.read, clock.write, abort.raise} =
  every(Duration(10), missed, 5, [], |seen: List<Int>, _due: Instant| {
    let ran = nanos_at(clock.now());
    if len(seen) == 1 { clock.sleep(Duration(25)) } else { () };
    Continue(push(seen, ran))
  })

test "a ticker whose second tick runs long catches up, starts over or skips, as its policy says" {
  assert_eq(simulate { ticked(Burst) }, [10, 20, 45, 45, 50]);
  assert_eq(simulate { ticked(Delay) }, [10, 20, 55, 65, 75]);
  assert_eq(simulate { ticked(Skip) }, [10, 20, 50, 60, 70])
}

test "a ticker ends when its tick says so, and never ticks past its limit" {
  simulate {
    let stopped = every(Duration(10), Burst, 9, 0, |count: Int, _due: Instant|
      if count == 2 { Stop(count + 1) } else { Continue(count + 1) });
    assert_eq((stopped, clock.now()), (3, Instant(30)));
    let limited = every(Duration(10), Burst, 2, 0, |count: Int, _due: Instant| Continue(count + 1));
    assert_eq((limited, clock.now()), (2, Instant(50)))
  }
}
