// std.show — any value written as `render` writes it, every item at every depth: what
// `derive show` and an interpolated string's holes call.

import std.value (Value, VRecord, VList, VCtor, VInt, VStr, VChar, render, render_all)

pub fn show<a>(x: a) -> String
  where derivable(show, a)
= render_all(reflect(x))

// A string or a character as itself and anything else as `show` writes it: an interpolated
// string's hole, `f"{x}"`.
pub fn display<a>(x: a) -> String
  where derivable(show, a)
= match reflect(x) { VStr(s) -> s, VChar(c) -> string_of_chars([c]), v -> render_all(v) }

fn joined(parts: List<String>, sep: String) -> String =
  fold(range(0, len(parts)), "", |acc: String, i: Int|
    match list_at(parts, i) { Some(p) -> if i == 0 { p } else { acc ++ sep ++ p }, None -> acc })

test "show writes any value as render does, every item at every depth" {
  assert_eq(show({ a: 1, b: [Some(2)] }), "{a: 1, b: [Some(2)]}");
  assert_eq(
    show({ a: 1, b: [Some(2)] }),
    render(
      VRecord([
        { name: "a", value: VInt(1) },
        { name: "b", value: VList([VCtor("Some", [VInt(2)])]) },
      ]),
    ),
  );
  assert_eq(show("a\"b"), "\"a\\\"b\"");
  assert_eq(show('x'), "'x'");
  assert_eq(
    show(range(0, 40)),
    "[" ++ joined(map(range(0, 40), |i: Int| int_to_string(i)), ", ") ++ "]",
  );
  assert_eq(show(array_of_list([1, 2])), "array_of_list([1, 2])");
  assert_eq(show(VInt(3)), "VInt(3)")
}

test "display writes a string or a character as itself and anything else as show does" {
  assert_eq(display("a\"b"), "a\"b");
  assert_eq(display('x'), "x");
  assert_eq(display(Some("x")), "Some(\"x\")");
  assert_eq(display(1.5), "1.5");
  assert_eq(display(()), "()")
}
