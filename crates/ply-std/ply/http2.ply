test "RFC 7541's example {s.name} decodes block by block to its fields and its table" for s: Story in stories(
  ) {
  fold(s.examples, decoder(s.capacity, 2), |d: Decoder, e: Example| {
    let got = decoded(d, bytes_of_hex(e.wire));
    assert_eq(
      map(got.fields, text_field),
      map(e.fields, |f: { name: String, value: String }| f.name ++ ": " ++ f.value),
    );
    assert_eq(got.decoder.table.size, e.table);
    got.decoder
  });
  ()
}

test "integers are written as RFC 7541 C.1 has them" {
  assert_eq(hex_of(integer(10, 5, 0)), "0a");
  assert_eq(hex_of(integer(1337, 5, 0)), "1f9a0a");
  assert_eq(hex_of(integer(42, 8, 0)), "2a");
  assert_eq(integer_at(bytes_of_hex("1f9a0a"), 0, 5), { value: 1337, next: 3 })
}

test "strings are Huffman-coded as RFC 7541 C.4 has them" {
  assert_eq(hex_of(huffman_encode(b"www.example.com")), "f1e3c2e5f23a6ba0ab90f4ff");
  assert_eq(hex_of(huffman_encode(b"no-cache")), "a8eb10649cbf");
  assert_eq(huffman_length(b"custom-key"), 8);
  assert_eq(array_get(huffman().codes, 256), 0x3FFF_FFFF);
  assert_eq(array_get(huffman().codes, 48), 0);
  assert_eq(array_get(huffman().codes, 47), 0x18)
}

law "a Huffman-coded string decodes to itself" =
  round_trip(huffman_encode, |b: Bytes|
    match try { huffman_decode(b) } { Ok(s) -> Some(s), Err(_) -> None })

test "a Huffman string that holds EOS, or is padded wrong, is refused" {
  // EOS whole, then a padding of eight ones, then a padding of zeros.
  assert_eq(
    refused_block(decoder(4096, 2), bytes_of_hex("0084ffffffff" ++ "8178")),
    "a Huffman string that holds EOS",
  );
  assert_eq(
    refused_block(decoder(4096, 2), bytes_of_hex("0081ff")),
    "a Huffman string padded with more than seven bits",
  );
  assert_eq(
    refused_block(decoder(4096, 2), bytes_of_hex("008100")),
    "a Huffman string padded with other than the first bits of EOS",
  )
}

test "a block that names what no table holds, or runs past its end, is refused" {
  assert_eq(refused_block(decoder(4096, 2), bytes_of_hex("80")), "index 0");
  assert_eq(refused_block(decoder(4096, 2), bytes_of_hex("be")), "index 62 past the tables");
  assert_eq(
    refused_block(decoder(4096, 2), bytes_of_hex("400a6375")),
    "a string that runs past the end of its block",
  );
  assert_eq(
    refused_block(decoder(4096, 2), bytes_of_hex("ff")),
    "an integer that runs past the end of its block",
  );
  assert_eq(
    refused_block(decoder(4096, 2), bytes_of_hex("ff8080808080")),
    "an integer of more than five continuation octets",
  );
  assert_eq(refused_block(decoder(4096, 2), bytes_of_hex("ffffffffff0f")), "an integer past 2^32")
}

test "table size updates come first, at most as many as allowed, and within the ceiling" {
  assert_eq(
    refused_block(decoder(4096, 2), bytes_of_hex("8220")),
    "a table size update after a field",
  );
  assert_eq(
    refused_block(decoder(4096, 2), bytes_of_hex("202020")),
    "more than 2 table size updates in a block",
  );
  assert_eq(
    refused_block(decoder(4096, 2), bytes_of_hex("3fe21f")),
    "a table size update to 4097 past the 4096 allowed",
  );
  assert_eq(decoded(decoder(4096, 2), bytes_of_hex("203fe11f82")).decoder.table.capacity, 4096);
  // A ceiling lowered under the table is owed an update by the next block.
  let lowered = with_ceiling(decoded(decoder(4096, 2), bytes_of_hex("82")).decoder, 100);
  assert_eq(
    refused_block(lowered, bytes_of_hex("82")),
    "a block that does not open with the table size update it owes",
  );
  assert_eq(decoded(lowered, bytes_of_hex("3f4582")).decoder.table.capacity, 100)
}

/// Fields drawn from what headers are: the static table's names and fields, names it lacks, values
/// that repeat, and fields larger than a small table.
fn vocabulary() -> List<Field> =
  [
    { name: b":method", value: b"GET" },
    { name: b":path", value: b"/" },
    { name: b":path", value: b"/search?q=a" },
    { name: b":authority", value: b"example.com" },
    { name: b"accept-encoding", value: b"gzip, deflate" },
    { name: b"accept-encoding", value: b"br" },
    { name: b"user-agent", value: b"ply/0.1" },
    { name: b"cookie", value: b"a=1" },
    { name: b"cookie", value: b"session=0123456789abcdef0123" },
    { name: b"authorization", value: b"Bearer abc" },
    { name: b"x-custom", value: b"one" },
    { name: b"x-custom", value: b"two" },
    { name: b"x-empty", value: b"" },
    { name: b"x-binary", value: b"\x00\x01\xfe\xff" },
    { name: b"x-long", value: repeat(b"0123456789", 30) },
    { name: b":status", value: b"200" },
    { name: b"content-type", value: b"text/html; charset=utf-8" },
    { name: b"set-cookie", value: b"id=7; HttpOnly" },
  ]

fn picked(picks: List<Int>) -> List<Field> / {abort.raise} =
  map(picks, |p: Int|
    at_or(vocabulary(), non_negative(p, len(vocabulary())), { name: b"", value: b"" }))

type Pair = { encoder: Encoder, decoder: Decoder, same: Bool }

law "blocks decode to the fields they were encoded from, as the table's size changes between them"
  forall (blocks: List<List<Int>>, sizes: List<Int>) {
    let end = fold(
      range(0, len(blocks)),
      { encoder: encoder(4096), decoder: decoder(4096, 2), same: true },
      |p: Pair, i: Int| {
        let size = at_or(sizes, i, -1);
        let e = if size < 0 { p.encoder } else { with_capacity(p.encoder, size % 4097) };
        let fields = picked(at_or(blocks, i, []));
        let written = encode(e, fields);
        match try { decode(p.decoder, written.block) } {
          Ok(got) ->
            {
              encoder: written.encoder,
              decoder: got.decoder,
              same: p.same && got.fields == fields && got.decoder.table == written.encoder.table,
            },
          Err(_) -> { ..p, same: false },
        }
      },
    );
    end.same
  }

test "a field in a table is written as its index, and a sensitive one is never indexed" {
  let first = encode(encoder(4096), [
    { name: b":method", value: b"GET" },
    { name: b"x-custom", value: b"one" },
    { name: b"authorization", value: b"secret" },
  ]);
  assert_eq(hex_of(bytes_slice(first.block, 0, 2)), "8240");
  let second = encode(first.encoder, [{ name: b"x-custom", value: b"one" }]);
  assert_eq(hex_of(second.block), "be");
  let fields = decoded(decoder(4096, 2), first.block).fields;
  assert_eq(map(fields, text_field), [":method: GET", "x-custom: one", "authorization: secret"]);
  // `0001` opens a never-indexed field, named here by the static table's index 23.
  assert(bytes_index_of(first.block, bytes_of_hex("1f08")) != None, None)
}

// --- Tests: exchanges ---------------------------------------------------------------

fn at(t: Int) -> Instant = at_millis(t)

/// A frame as a line: its type, its stream and what matters of the rest.
fn shown(f: Frame) -> String / {abort.raise} =
  match f {
    DataFrame(d) ->
      "DATA " ++ int_to_string(d.stream) ++ " " ++ int_to_string(bytes_len(d.data))
        ++ (if d.end_stream { " END_STREAM" } else { "" }),
    HeadersFrame(h) ->
      "HEADERS " ++ int_to_string(h.stream) ++ (if h.end_stream { " END_STREAM" } else { "" })
        ++ (if h.end_headers { "" } else { " CONTINUED" }),
    PriorityFrame(p) -> "PRIORITY " ++ int_to_string(p.stream),
    ResetFrame(r) -> "RST_STREAM " ++ int_to_string(r.stream) ++ " " ++ code_name(r.code),
    SettingsFrame(s) -> if s.ack { "SETTINGS ACK" } else { "SETTINGS" },
    PushPromiseFrame(p) -> "PUSH_PROMISE " ++ int_to_string(p.stream),
    PingFrame(p) -> if p.ack { "PING ACK" } else { "PING" },
    GoAwayFrame(g) -> "GOAWAY " ++ int_to_string(g.last_stream) ++ " " ++ code_name(g.code),
    WindowUpdateFrame(w) ->
      "WINDOW_UPDATE " ++ int_to_string(w.stream) ++ " " ++ int_to_string(w.increment),
    ContinuationFrame(c) ->
      "CONTINUATION " ++ int_to_string(c.stream) ++ (if c.end_headers { "" } else { " CONTINUED" }),
    UnknownFrame(u) -> "UNKNOWN " ++ int_to_string(u.kind),
  }

type Parsing = { at: Int, frames: List<Frame> }

/// The frames bytes a machine wrote hold.
fn frames_in(b: Bytes) -> List<Frame> / {abort.raise} =
  iterate({ at: 0, frames: [] }, bytes_len(b) + 1, |p: Parsing|
    match try { read_frame(b, p.at, largest_frame_size()) } {
      Ok(Some(r)) -> Continue({ at: r.next, frames: push(p.frames, r.frame) }),
      _ -> Stop(p.frames),
    })

fn wire(fs: List<Frame>) -> Bytes / {abort.raise} = bytes_concat_all(map(fs, encode_frame))

/// What a client opens with: the preface, its `SETTINGS`, and the acknowledgement of the
/// server's.
fn opening(settings: List<Setting>) -> Bytes / {abort.raise} =
  bytes_concat(
    preface(),
    wire([
      SettingsFrame({ ack: false, settings: settings }),
      SettingsFrame({ ack: true, settings: [] }),
    ]),
  )

fn block_of(fields: List<(String, String)>) -> Bytes / {abort.raise} =
  encode(
    encoder(4096),
    map(fields, |f: (String, String)|
      match f { (n, v) -> { name: bytes_of_string(n), value: bytes_of_string(v) } }),
  ).block

fn get_fields(path: String) -> List<(String, String)> =
  [(":method", "GET"), (":scheme", "https"), (":authority", "example.com"), (":path", path)]

fn headers(s: Int, fields: List<(String, String)>, end_stream: Bool) -> Frame / {abort.raise} =
  HeadersFrame({
    stream: s,
    block: block_of(fields),
    end_stream: end_stream,
    end_headers: true,
    priority: None,
    padding: None,
  })

fn get(s: Int, path: String) -> Bytes / {abort.raise} =
  encode_frame(headers(s, get_fields(path), true))

fn data(s: Int, b: Bytes, end: Bool) -> Bytes / {abort.raise} =
  encode_frame(DataFrame({ stream: s, data: b, end_stream: end, padding: None }))

fn echo(r: Request) -> Response / {abort.raise} =
  plain_text(200, r.method ++ " " ++ r.target ++ " " ++ string_of_bytes_lossy(r.body))

/// A request to example.com over `https`, with no field of its own.
fn asking(method: String, target: String, body: Bytes) -> Request =
  {
    method: method,
    scheme: "https",
    authority: "example.com",
    target: target,
    headers: map_new(),
    trailers: map_new(),
    body: body,
  }

fn first_value(h: Headers, name: String) -> Option<String> =
  match map_get(h, name) { Some(values) -> list_at(values, 0), None -> None }

type Served = { connection: Connection, frames: List<String>, events: List<Event> }

fn answered_all(
  c: Connection,
  events: List<Event>,
  app: (Request) -> Response / {abort.raise},
  t: Int,
) -> Connection / {abort.raise} =
  fold(events, c, |acc: Connection, e: Event|
    match e { Requested(q) -> respond(acc, q.stream, app(q.request), at(t)), _ -> acc })

/// A server with these limits fed `chunks` in turn at time 1, each request answered by `app` as
/// it arrives; what it wrote after its own `SETTINGS`, frame by frame.
fn served(
  limits: Limits,
  chunks: List<Bytes>,
  app: (Request) -> Response / {abort.raise},
) -> Served / {abort.raise} = {
  let start = take_output(server(limits, at(0)));
  fold(
    chunks,
    { connection: start.connection, frames: [], events: [] },
    |s: Served, chunk: Bytes| after(s, receive(s.connection, chunk, at(1)), app, 1),
  )
}

fn after(
  s: Served,
  r: Received,
  app: (Request) -> Response / {abort.raise},
  t: Int,
) -> Served / {abort.raise} = {
  let out = take_output(answered_all(r.connection, r.events, app, t));
  {
    connection: out.connection,
    frames: concat(s.frames, map(frames_in(out.bytes), shown)),
    events: concat(s.events, r.events),
  }
}

fn ticked(s: Served, t: Int) -> Served / {abort.raise} =
  after(s, tick(s.connection, at(t)), echo, t)

test "a GET is a request the application answers with HEADERS and then DATA" {
  let s = served(default_limits(), [bytes_concat(opening([]), get(1, "/a?b=1"))], echo);
  assert_eq(s.frames, ["SETTINGS ACK", "HEADERS 1", "DATA 1 11 END_STREAM"]);
  match s.events {
    [Requested(q)] -> {
      assert_eq(q.stream, 1);
      assert_eq(q.request.scheme, "https");
      assert_eq(q.request.target, "/a?b=1");
      assert_eq(q.request.authority, "example.com");
      assert_eq(q.request.method, "GET")
    },
    _ -> panic("one request, not " ++ int_to_string(len(s.events)) ++ " events"),
  };
  assert_eq(open_streams(s.connection), 0)
}

test "the server's first output is its SETTINGS and the window it adds to the connection's" {
  let start = take_output(server(default_limits(), at(0)));
  assert_eq(map(frames_in(start.bytes), shown), ["SETTINGS", "WINDOW_UPDATE 0 983041"])
}

test "a connection that does not open with the preface is closed at its first byte that differs" {
  let s = served(default_limits(), [b"GET / HTTP/1.1\r\n"], echo);
  assert_eq(s.frames, ["GOAWAY 0 PROTOCOL_ERROR"]);
  assert(finished(s.connection), None);
  let partial = served(default_limits(), [b"PRI * HTTP/2"], echo);
  assert_eq(partial.frames, []);
  assert(!finished(partial.connection), None)
}

test "a connection whose first frame is not SETTINGS is closed" {
  let s = served(
    default_limits(),
    [bytes_concat(preface(), wire([PingFrame({ ack: false, data: b"12345678" })]))],
    echo,
  );
  assert_eq(s.frames, ["GOAWAY 0 PROTOCOL_ERROR"])
}

test "SETTINGS are acknowledged and a PING is answered with its own payload" {
  let s = served(
    default_limits(),
    [opening([]), wire([PingFrame({ ack: false, data: b"abcdefgh" })])],
    echo,
  );
  assert_eq(s.frames, ["SETTINGS ACK", "PING ACK"])
}

test "bytes that come an octet at a time are read as the frames they make" {
  let all = bytes_concat_all([opening([]), get(1, "/"), get(3, "/x")]);
  let s = served(
    default_limits(),
    map(range(0, bytes_len(all)), |i: Int| bytes_slice(all, i, i + 1)),
    echo,
  );
  assert_eq(s.frames, [
    "SETTINGS ACK",
    "HEADERS 1",
    "DATA 1 6 END_STREAM",
    "HEADERS 3",
    "DATA 3 7 END_STREAM",
  ]);
  assert_eq(len(s.events), 2)
}

type Exchange = { name: String, input: List<Bytes>, output: List<String> }

/// Exchanges after h2spec's cases for RFC 9113: what a client sends, after its opening, and what
/// the server must answer.
fn exchanges() -> List<Exchange> / {abort.raise} =
  [
    {
      name: "DATA on an idle stream",
      input: [data(1, b"x", true)],
      output: ["GOAWAY 0 PROTOCOL_ERROR"],
    },
    {
      name: "RST_STREAM on an idle stream",
      input: [wire([ResetFrame({ stream: 1, code: Cancel })])],
      output: ["GOAWAY 0 PROTOCOL_ERROR"],
    },
    {
      name: "WINDOW_UPDATE on an idle stream",
      input: [wire([WindowUpdateFrame({ stream: 1, increment: 1 })])],
      output: ["GOAWAY 0 PROTOCOL_ERROR"],
    },
    {
      name: "a stream numbered below one already opened",
      input: [get(5, "/"), get(3, "/")],
      output: ["HEADERS 5", "DATA 5 6 END_STREAM", "GOAWAY 5 PROTOCOL_ERROR"],
    },
    {
      name: "an even stream from a client",
      input: [get(2, "/")],
      output: ["GOAWAY 0 PROTOCOL_ERROR"],
    },
    {
      name: "DATA on a stream whose request has ended",
      input: [bytes_concat(get(1, "/"), data(1, b"x", true))],
      output: ["RST_STREAM 1 STREAM_CLOSED"],
    },
    {
      name: "DATA on a closed stream",
      input: [get(1, "/"), data(1, b"x", true)],
      output: ["HEADERS 1", "DATA 1 6 END_STREAM", "GOAWAY 1 STREAM_CLOSED"],
    },
    {
      name: "HEADERS on a closed stream",
      input: [get(1, "/"), get(1, "/")],
      output: ["HEADERS 1", "DATA 1 6 END_STREAM", "GOAWAY 1 STREAM_CLOSED"],
    },
    {
      name: "a frame of an unknown type",
      input: [
        wire([
          UnknownFrame({ kind: 0x20, flags: 0xFF, stream: 1, payload: b"?" }),
          PingFrame({ ack: false, data: b"12345678" }),
        ]),
      ],
      output: ["PING ACK"],
    },
    {
      name: "a frame of an unknown type inside a field block",
      input: [
        wire([
          HeadersFrame({
            stream: 1,
            block: block_of(get_fields("/")),
            end_stream: true,
            end_headers: false,
            priority: None,
            padding: None,
          }),
          UnknownFrame({ kind: 0x20, flags: 0, stream: 1, payload: b"" }),
        ]),
      ],
      output: ["GOAWAY 0 PROTOCOL_ERROR"],
    },
    {
      name: "HEADERS inside another stream's field block",
      input: [
        wire([
          HeadersFrame({
            stream: 1,
            block: b"",
            end_stream: true,
            end_headers: false,
            priority: None,
            padding: None,
          }),
          headers(3, get_fields("/"), true),
        ]),
      ],
      output: ["GOAWAY 0 PROTOCOL_ERROR"],
    },
    {
      name: "a CONTINUATION with no field block open",
      input: [wire([ContinuationFrame({ stream: 1, block: b"", end_headers: true })])],
      output: ["GOAWAY 0 PROTOCOL_ERROR"],
    },
    {
      name: "a field block HPACK cannot read",
      input: [
        wire([
          HeadersFrame({
            stream: 1,
            block: bytes_of_hex("be"),
            end_stream: true,
            end_headers: true,
            priority: None,
            padding: None,
          }),
        ]),
      ],
      output: ["GOAWAY 0 COMPRESSION_ERROR"],
    },
    {
      name: "a stream that depends on itself",
      input: [
        wire([
          HeadersFrame({
            stream: 1,
            block: block_of(get_fields("/")),
            end_stream: true,
            end_headers: true,
            priority: Some({ depends_on: 1, exclusive: false, weight: 16 }),
            padding: None,
          }),
        ]),
      ],
      output: ["RST_STREAM 1 PROTOCOL_ERROR"],
    },
    {
      name: "a PRIORITY frame of the wrong length, confined to its open stream",
      input: [
        bytes_concat_all([
          encode_frame(headers(1, get_fields("/"), false)),
          bytes_of_hex("000004020000000001" ++ "00000003"),
          wire([PingFrame({ ack: false, data: b"12345678" })]),
        ]),
      ],
      output: ["RST_STREAM 1 FRAME_SIZE_ERROR", "PING ACK"],
    },
    {
      name: "a PRIORITY frame of the wrong length on an idle stream",
      input: [bytes_of_hex("000004020000000003" ++ "00000001")],
      output: ["GOAWAY 0 FRAME_SIZE_ERROR"],
    },
    {
      name: "a connection window past 2^31-1",
      input: [wire([WindowUpdateFrame({ stream: 0, increment: largest_window() })])],
      output: ["GOAWAY 0 FLOW_CONTROL_ERROR"],
    },
    {
      name: "a stream window past 2^31-1",
      input: [
        bytes_concat(
          encode_frame(headers(1, get_fields("/"), false)),
          wire([WindowUpdateFrame({ stream: 1, increment: largest_window() })]),
        ),
      ],
      output: ["RST_STREAM 1 FLOW_CONTROL_ERROR"],
    },
    {
      name: "a SETTINGS_INITIAL_WINDOW_SIZE that takes a stream's window past 2^31-1",
      input: [
        bytes_concat(
          encode_frame(headers(1, get_fields("/"), false)),
          wire([
            WindowUpdateFrame({ stream: 1, increment: largest_window() - default_window() }),
            SettingsFrame({ ack: false, settings: [InitialWindowSize(65536)] }),
          ]),
        ),
      ],
      output: ["GOAWAY 1 FLOW_CONTROL_ERROR"],
    },
    {
      name: "a PUSH_PROMISE sent to a server",
      input: [
        wire([
          PushPromiseFrame({
            stream: 1,
            promised: 2,
            block: b"",
            end_headers: true,
            padding: None,
          }),
        ]),
      ],
      output: ["GOAWAY 0 PROTOCOL_ERROR"],
    },
    {
      name: "a field block in CONTINUATION frames",
      input: [
        wire([
          HeadersFrame({
            stream: 1,
            block: bytes_slice(block_of(get_fields("/")), 0, 3),
            end_stream: true,
            end_headers: false,
            priority: None,
            padding: None,
          }),
          ContinuationFrame({
            stream: 1,
            block: bytes_slice(block_of(get_fields("/")), 3, bytes_len(block_of(get_fields("/")))),
            end_headers: true,
          }),
        ]),
      ],
      output: ["HEADERS 1", "DATA 1 6 END_STREAM"],
    },
    {
      name: "a request with a body and trailers",
      input: [
        bytes_concat_all([
          encode_frame(
            headers(
              1,
              push(push(drop_method(get_fields("/up")), (":method", "POST")), (
                "content-length",
                "4",
              )),
              false,
            ),
          ),
          data(1, b"ab", false),
          data(1, b"cd", false),
          encode_frame(headers(1, [("x-sum", "1")], true)),
        ]),
      ],
      output: ["HEADERS 1", "DATA 1 13 END_STREAM"],
    },
    {
      name: "a body other than its content-length",
      input: [
        bytes_concat(
          encode_frame(
            headers(1, push(drop_method(get_fields("/up")), ("content-length", "5")), false),
          ),
          data(1, b"abc", true),
        ),
      ],
      output: ["RST_STREAM 1 PROTOCOL_ERROR"],
    },
    {
      name: "trailers that do not end the stream",
      input: [
        bytes_concat(
          encode_frame(headers(1, get_fields("/"), false)),
          encode_frame(headers(1, [("x-sum", "1")], false)),
        ),
      ],
      output: ["RST_STREAM 1 PROTOCOL_ERROR"],
    },
    {
      name: "a CONNECT",
      input: [
        encode_frame(headers(1, [(":method", "CONNECT"), (":authority", "example.com:443")], true)),
      ],
      output: ["HEADERS 1", "DATA 1 22 END_STREAM"],
    },
    {
      name: "a request that expects 100-continue",
      input: [
        encode_frame(
          headers(
            1,
            concat(drop_method(get_fields("/")), [
              (":method", "POST"),
              ("expect", "100-continue"),
              ("content-length", "2"),
            ]),
            false,
          ),
        ),
        data(1, b"hi", true),
      ],
      output: ["HEADERS 1", "HEADERS 1", "DATA 1 9 END_STREAM"],
    },
  ]

/// `:method` comes first; these take it out so a test can give its own.
fn drop_method(fields: List<(String, String)>) -> List<(String, String)> =
  filter(fields, |f: (String, String)| match f { (n, _) -> n != ":method" })

test "after h2spec: {e.name}" for e: Exchange in exchanges() {
  let s = served(default_limits(), concat([opening([])], e.input), echo);
  assert_eq(drop(s.frames, 1), e.output)
}

type Bad = { name: String, fields: List<(String, String)> }

/// Requests RFC 9113 §8 calls malformed, which a server resets with `PROTOCOL_ERROR`.
fn malformed_requests() -> List<Bad> =
  [
    { name: "an uppercase field name", fields: push(get_fields("/"), ("X-Upper", "1")) },
    {
      name: "a pseudo-header after a regular field",
      fields: concat([("accept", "*/*")], get_fields("/")),
    },
    { name: "an unknown pseudo-header", fields: push(get_fields("/"), (":protocol", "websocket")) },
    { name: "a response's pseudo-header", fields: push(get_fields("/"), (":status", "200")) },
    { name: "a pseudo-header twice", fields: concat(get_fields("/"), [(":path", "/b")]) },
    { name: "no `:method`", fields: drop_method(get_fields("/")) },
    { name: "no `:path`", fields: [(":method", "GET"), (":scheme", "https")] },
    { name: "an empty `:path`", fields: [(":method", "GET"), (":scheme", "https"), (":path", "")] },
    {
      name: "a `:path` of `*` with GET",
      fields: [(":method", "GET"), (":scheme", "https"), (":path", "*")],
    },
    { name: "a connection field", fields: push(get_fields("/"), ("connection", "close")) },
    {
      name: "a transfer-encoding",
      fields: push(get_fields("/"), ("transfer-encoding", "chunked")),
    },
    { name: "`te` other than trailers", fields: push(get_fields("/"), ("te", "gzip")) },
    { name: "a value with a line feed", fields: push(get_fields("/"), ("x-a", "1\n2")) },
    { name: "a value with a space at its end", fields: push(get_fields("/"), ("x-a", "1 ")) },
    {
      name: "a `host` other than the `:authority`",
      fields: push(get_fields("/"), ("host", "other.example")),
    },
    {
      name: "userinfo in the `:authority`",
      fields: [
        (":method", "GET"),
        (":scheme", "https"),
        (":authority", "u@example.com"),
        (":path", "/"),
      ],
    },
    {
      name: "two content-lengths that differ",
      fields: concat(get_fields("/"), [("content-length", "1"), ("content-length", "2")]),
    },
  ]

test "a request with {b.name} is reset as malformed" for b: Bad in malformed_requests() {
  let s = served(default_limits(), [opening([]), encode_frame(headers(1, b.fields, true))], echo);
  assert_eq(s.frames, ["SETTINGS ACK", "RST_STREAM 1 PROTOCOL_ERROR"]);
  assert_eq(s.events, [])
}

test "cookies sent as several fields are one field to the application" {
  let s = served(
    default_limits(),
    [
      opening([]),
      encode_frame(
        headers(
          1,
          concat(get_fields("/"), [("cookie", "a=1"), ("accept", "*/*"), ("cookie", "b=2")]),
          true,
        ),
      ),
    ],
    echo,
  );
  match s.events {
    [Requested(q)] -> {
      assert_eq(map_get(q.request.headers, "cookie"), Some(["a=1; b=2"]));
      assert_eq(first_value(q.request.headers, "accept"), Some("*/*"))
    },
    _ -> panic("one request"),
  }
}

test "a response's body waits for the windows its client opens" {
  let s = served(
    default_limits(),
    [
      bytes_concat(opening([InitialWindowSize(1)]), get(1, "/")),
      wire([WindowUpdateFrame({ stream: 1, increment: 1 })]),
      wire([WindowUpdateFrame({ stream: 1, increment: 10 })]),
    ],
    echo,
  );
  assert_eq(s.frames, ["SETTINGS ACK", "HEADERS 1", "DATA 1 1", "DATA 1 1", "DATA 1 4 END_STREAM"])
}

test "a client's SETTINGS_INITIAL_WINDOW_SIZE moves the windows of streams already open" {
  let s = served(
    default_limits(),
    [
      bytes_concat(opening([InitialWindowSize(0)]), get(1, "/")),
      wire([SettingsFrame({ ack: false, settings: [InitialWindowSize(3)] })]),
    ],
    echo,
  );
  assert_eq(s.frames, ["SETTINGS ACK", "HEADERS 1", "SETTINGS ACK", "DATA 1 3"])
}

test "a response to HEAD, and a 204, carry no body" {
  let head = served(
    default_limits(),
    [
      opening([]),
      encode_frame(headers(1, push(drop_method(get_fields("/")), (":method", "HEAD")), true)),
    ],
    echo,
  );
  assert_eq(head.frames, ["SETTINGS ACK", "HEADERS 1 END_STREAM"]);
  let none = served(default_limits(), [opening([]), get(1, "/")], |_: Request|
    { status: 204, headers: map_new(), body: b"ignored" });
  assert_eq(none.frames, ["SETTINGS ACK", "HEADERS 1 END_STREAM"])
}

test "a stream past max_concurrent_streams is refused, and one later is taken" {
  let l = { ..default_limits(), max_concurrent_streams: 1 };
  let s = served(
    l,
    [
      opening([]),
      bytes_concat(encode_frame(headers(1, get_fields("/"), false)), get(3, "/")),
      data(1, b"", true),
      get(5, "/"),
    ],
    echo,
  );
  assert_eq(s.frames, [
    "SETTINGS ACK",
    "RST_STREAM 3 REFUSED_STREAM",
    "HEADERS 1",
    "DATA 1 6 END_STREAM",
    "HEADERS 5",
    "DATA 5 6 END_STREAM",
  ])
}

// --- Tests: the attacks ---------------------------------------------------------------

test "rapid reset: streams opened and reset past max_resets close the connection" {
  let l = { ..default_limits(), max_resets: 3 };
  let pairs = bytes_concat_all(
    map([1, 3, 5, 7, 9], |s: Int|
      bytes_concat(get(s, "/"), wire([ResetFrame({ stream: s, code: Cancel })]))),
  );
  let s = served(l, [opening([]), pairs], echo);
  assert_eq(s.frames, ["SETTINGS ACK", "GOAWAY 7 ENHANCE_YOUR_CALM"]);
  // No request reset in the same bytes reaches the application.
  assert_eq(filter(s.events, |e: Event| match e { Requested(_) -> true, _ -> false }), []);
  assert(finished(s.connection), None)
}

test "streams reset within the window count, and the count begins again after it" {
  let l = { ..default_limits(), max_resets: 2, window_ms: 100 };
  let start = take_output(server(l, at(0)));
  let one = receive(
    start.connection,
    bytes_concat(
      opening([]),
      bytes_concat(get(1, "/"), wire([ResetFrame({ stream: 1, code: Cancel })])),
    ),
    at(1),
  );
  let two = receive(
    one.connection,
    bytes_concat(get(3, "/"), wire([ResetFrame({ stream: 3, code: Cancel })])),
    at(2),
  );
  let three = receive(
    two.connection,
    bytes_concat(get(5, "/"), wire([ResetFrame({ stream: 5, code: Cancel })])),
    at(150),
  );
  assert(!finished(three.connection), None);
  let four = receive(
    three.connection,
    bytes_concat(get(7, "/"), wire([ResetFrame({ stream: 7, code: Cancel })])),
    at(151),
  );
  let five = receive(
    four.connection,
    bytes_concat(get(9, "/"), wire([ResetFrame({ stream: 9, code: Cancel })])),
    at(152),
  );
  assert(finished(five.connection), None)
}

test "a peer that makes the server reset its streams counts towards max_resets too" {
  let l = { ..default_limits(), max_resets: 2 };
  let bad = bytes_concat_all(
    map([1, 3, 5], |s: Int|
      encode_frame(headers(s, push(get_fields("/"), ("X-Upper", "1")), true))),
  );
  let s = served(l, [opening([]), bad], echo);
  assert_eq(s.frames, [
    "SETTINGS ACK",
    "RST_STREAM 1 PROTOCOL_ERROR",
    "RST_STREAM 3 PROTOCOL_ERROR",
    "GOAWAY 5 ENHANCE_YOUR_CALM",
  ])
}

test "CONTINUATION flood: a field block past max_continuations closes the connection" {
  let l = { ..default_limits(), max_continuations: 3 };
  let open = HeadersFrame({
    stream: 1,
    block: b"",
    end_stream: true,
    end_headers: false,
    priority: None,
    padding: None,
  });
  let more = map(range(0, 4), |_: Int|
    ContinuationFrame({ stream: 1, block: b"\x82", end_headers: false }));
  let s = served(l, [opening([]), wire(concat([open], more))], echo);
  assert_eq(s.frames, ["SETTINGS ACK", "GOAWAY 0 ENHANCE_YOUR_CALM"])
}

test "CONTINUATION flood: a field block past max_header_block closes the connection before it ends" {
  let l = { ..default_limits(), max_header_block: 100 };
  let open = HeadersFrame({
    stream: 1,
    block: repeat(b"\x82", 60),
    end_stream: true,
    end_headers: false,
    priority: None,
    padding: None,
  });
  let s = served(
    l,
    [
      opening([]),
      wire([
        open,
        ContinuationFrame({ stream: 1, block: repeat(b"\x82", 60), end_headers: false }),
      ]),
    ],
    echo,
  );
  assert_eq(s.frames, ["SETTINGS ACK", "GOAWAY 0 ENHANCE_YOUR_CALM"])
}

/// A first request that leaves a 4 KiB field in the server's table, and a second whose block of
/// a few dozen octets names it twenty times: its `:authority` is inserted first, so the field is
/// index 63.
fn bomb() -> List<Bytes> / {abort.raise} = {
  let planted = bytes_concat(
    block_of(get_fields("/")),
    bytes_concat_all([
      integer(0, 6, 0x40),
      string_literal(b"x-bomb"),
      string_literal(repeat(b"a", 4000)),
    ]),
  );
  let named = bytes_concat(block_of(get_fields("/")), repeat(bytes_of_hex("bf"), 20));
  [
    wire([
      HeadersFrame({
        stream: 1,
        block: planted,
        end_stream: true,
        end_headers: true,
        priority: None,
        padding: None,
      }),
    ]),
    wire([
      HeadersFrame({
        stream: 3,
        block: named,
        end_stream: true,
        end_headers: true,
        priority: None,
        padding: None,
      }),
    ]),
  ]
}

test "HPACK bomb: fields past max_header_list_size are answered 431, however short their block" {
  let s = served(default_limits(), concat([opening([])], bomb()), echo);
  let reason = "the fields are larger than 65536 octets\n";
  assert_eq(s.frames, [
    "SETTINGS ACK",
    "HEADERS 1",
    "DATA 1 6 END_STREAM",
    "HEADERS 3",
    "DATA 3 " ++ int_to_string(string_len(reason)) ++ " END_STREAM",
  ]);
  assert_eq(len(s.events), 1)
}

test "HPACK bomb: table size updates past max_table_size_updates, or past the table, close the connection" {
  let updates = HeadersFrame({
    stream: 1,
    block: bytes_concat(bytes_of_hex("202020"), block_of(get_fields("/"))),
    end_stream: true,
    end_headers: true,
    priority: None,
    padding: None,
  });
  assert_eq(served(default_limits(), [opening([]), wire([updates])], echo).frames, [
    "SETTINGS ACK",
    "GOAWAY 0 COMPRESSION_ERROR",
  ]);
  let past = HeadersFrame({
    stream: 1,
    block: bytes_concat(integer(4097, 5, 0x20), block_of(get_fields("/"))),
    end_stream: true,
    end_headers: true,
    priority: None,
    padding: None,
  });
  assert_eq(served(default_limits(), [opening([]), wire([past])], echo).frames, [
    "SETTINGS ACK",
    "GOAWAY 0 COMPRESSION_ERROR",
  ])
}

test "SETTINGS flood: SETTINGS past max_settings within the window close the connection" {
  let l = { ..default_limits(), max_settings: 3 };
  let more = wire(map(range(0, 3), |_: Int| SettingsFrame({ ack: false, settings: [] })));
  assert_eq(served(l, [opening([]), more], echo).frames, [
    "SETTINGS ACK",
    "SETTINGS ACK",
    "SETTINGS ACK",
    "GOAWAY 0 ENHANCE_YOUR_CALM",
  ])
}

test "PING flood: PINGs past max_pings within the window close the connection" {
  let l = { ..default_limits(), max_pings: 2 };
  let pings = wire(map(range(0, 3), |_: Int| PingFrame({ ack: false, data: b"12345678" })));
  assert_eq(served(l, [opening([]), pings], echo).frames, [
    "SETTINGS ACK",
    "PING ACK",
    "PING ACK",
    "GOAWAY 0 ENHANCE_YOUR_CALM",
  ])
}

test "frames that carry nothing past max_empty_frames close the connection" {
  let l = { ..default_limits(), max_empty_frames: 2 };
  let nothing = wire([
    PriorityFrame({ stream: 1, priority: { depends_on: 0, exclusive: false, weight: 16 } }),
    UnknownFrame({ kind: 0x30, flags: 0, stream: 0, payload: b"" }),
    PriorityFrame({ stream: 3, priority: { depends_on: 0, exclusive: false, weight: 16 } }),
  ]);
  assert_eq(served(l, [opening([]), nothing], echo).frames, [
    "SETTINGS ACK",
    "GOAWAY 0 ENHANCE_YOUR_CALM",
  ])
}

test "slow reader: a stream whose window stays shut past stall_ms is reset, and its bytes let go" {
  let l = { ..default_limits(), stall_ms: 1000 };
  let s = served(l, [bytes_concat(opening([InitialWindowSize(0)]), get(1, "/"))], echo);
  assert_eq(s.frames, ["SETTINGS ACK", "HEADERS 1"]);
  assert_eq(waiting(s.connection), 6);
  assert_eq(deadline(s.connection), Some(at(1001)));
  let early = ticked(s, 900);
  assert_eq(early.frames, s.frames);
  let late = ticked(early, 1001);
  assert_eq(late.frames, ["SETTINGS ACK", "HEADERS 1", "RST_STREAM 1 CANCEL"]);
  assert_eq(waiting(late.connection), 0)
}

test "slow reader: a stream opened while max_buffered octets wait is refused" {
  let l = { ..default_limits(), max_buffered: 10 };
  let s = served(
    l,
    [bytes_concat(opening([InitialWindowSize(0)]), get(1, "/0123456789")), get(3, "/")],
    echo,
  );
  assert_eq(s.frames, ["SETTINGS ACK", "HEADERS 1", "RST_STREAM 3 REFUSED_STREAM"])
}

test "a body past max_body is answered 413, and the stream reset once the answer is out" {
  let l = { ..default_limits(), max_body: 10 };
  let reason = "the body is longer than 10 octets\n";
  let s = served(
    l,
    [
      opening([]),
      bytes_concat(
        encode_frame(headers(1, get_fields("/"), false)),
        data(1, repeat(b"x", 11), false),
      ),
    ],
    echo,
  );
  assert_eq(s.frames, [
    "SETTINGS ACK",
    "HEADERS 1",
    "DATA 1 " ++ int_to_string(string_len(reason)) ++ " END_STREAM",
    "RST_STREAM 1 NO_ERROR",
  ])
}

test "a request not whole within request_timeout_ms is answered 408" {
  let l = { ..default_limits(), request_timeout_ms: 1000 };
  let s = served(l, [opening([]), encode_frame(headers(1, get_fields("/"), false))], echo);
  assert_eq(deadline(s.connection), Some(at(1001)));
  let late = ticked(s, 1001);
  let reason = "the request did not arrive whole within 1000 ms\n";
  assert_eq(late.frames, [
    "SETTINGS ACK",
    "HEADERS 1",
    "DATA 1 " ++ int_to_string(string_len(reason)) ++ " END_STREAM",
    "RST_STREAM 1 NO_ERROR",
  ])
}

test "SETTINGS the client never acknowledges close the connection with SETTINGS_TIMEOUT" {
  let l = { ..default_limits(), settings_timeout_ms: 500 };
  let s = served(
    l,
    [bytes_concat(preface(), wire([SettingsFrame({ ack: false, settings: [] })]))],
    echo,
  );
  assert_eq(deadline(s.connection), Some(at(500)));
  assert_eq(ticked(s, 500).frames, ["SETTINGS ACK", "GOAWAY 0 SETTINGS_TIMEOUT"])
}

test "an idle connection closes after idle_timeout_ms" {
  let l = { ..default_limits(), idle_timeout_ms: 2000 };
  let s = served(l, [opening([]), get(1, "/")], echo);
  assert_eq(deadline(s.connection), Some(at(2001)));
  let idle = ticked(s, 2001);
  assert_eq(drop(idle.frames, 3), ["GOAWAY 1 NO_ERROR"]);
  assert(finished(idle.connection), None)
}

test "after max_requests streams the server names the last it takes and ignores the rest" {
  let l = { ..default_limits(), max_requests: 2 };
  let s = served(
    l,
    [opening([]), bytes_concat_all([get(1, "/"), get(3, "/"), get(5, "/")]), data(5, b"x", true)],
    echo,
  );
  assert_eq(s.frames, [
    "SETTINGS ACK",
    "GOAWAY 3 NO_ERROR",
    "HEADERS 1",
    "DATA 1 6 END_STREAM",
    "HEADERS 3",
    "DATA 3 6 END_STREAM",
  ]);
  assert(finished(s.connection), None)
}

test "a drain takes the streams sent before its PING comes back, and only those" {
  let s = served(default_limits(), [opening([]), get(1, "/")], echo);
  let begun = take_output(drain(s.connection, at(2)));
  assert_eq(map(frames_in(begun.bytes), shown), ["GOAWAY 2147483647 NO_ERROR", "PING"]);
  assert(!finished(begun.connection), None);
  let late = after(
    { ..s, connection: begun.connection, frames: [] },
    receive(
      begun.connection,
      bytes_concat(get(3, "/"), wire([PingFrame({ ack: true, data: drain_ping() })])),
      at(3),
    ),
    echo,
    3,
  );
  assert_eq(late.frames, ["GOAWAY 3 NO_ERROR", "HEADERS 3", "DATA 3 6 END_STREAM"]);
  let ignored = after(late, receive(late.connection, get(5, "/"), at(4)), echo, 4);
  assert_eq(ignored.frames, late.frames);
  assert(finished(ignored.connection), None)
}

test "a drain whose PING never comes back names the last stream after drain_ms" {
  let s = served(
    default_limits(),
    [opening([]), encode_frame(headers(1, get_fields("/"), false))],
    echo,
  );
  let begun = take_output(drain(s.connection, at(2)));
  assert_eq(deadline(begun.connection), Some(at(1002)));
  let named = ticked({ ..s, connection: begun.connection, frames: [] }, 1002);
  assert_eq(named.frames, ["GOAWAY 1 NO_ERROR"]);
  assert(!finished(named.connection), None);
  let done = after(named, receive(named.connection, data(1, b"", true), at(1003)), echo, 1003);
  assert_eq(done.frames, ["GOAWAY 1 NO_ERROR", "HEADERS 1", "DATA 1 6 END_STREAM"]);
  assert(finished(done.connection), None)
}

// --- Tests: a client and a server ------------------------------------------------------

/// A client and a server joined by the bytes each has sent and the other not yet read.
type Ends = {
  client: Connection,
  server: Connection,
  up: Bytes,
  down: Bytes,
  events: List<Event>,
  step: Int,
}

fn joined(l: Limits) -> Ends / {abort.raise} =
  { client: client(l, at(0)), server: server(l, at(0)), up: b"", down: b"", events: [], step: 0 }

/// How many octets the delivery at step `i` carries of the `n` waiting: what `cuts` says in turn,
/// 1 to 200, or all of them where it says nothing.
fn piece(cuts: List<Int>, i: Int, n: Int) -> Int / {abort.raise} =
  if cuts == [] { n } else { min(n, 1 + (at_or(cuts, i % len(cuts), 0) % 200 + 200) % 200) }

fn asked(e: Ends, reqs: List<Request>) -> Ends / {abort.raise} =
  fold(reqs, e, |x: Ends, r: Request|
    match request(x.client, r, at(x.step)) {
      Some(sent) -> { ..x, client: sent.connection },
      None -> x,
    })

/// The two ends run until neither has a byte to send, or for `budget` steps: each step carries
/// part of what is waiting each way, as `cuts` says, and `app` answers each request as it arrives.
fn carried(
  e: Ends,
  app: (Request) -> Response / {abort.raise},
  cuts: List<Int>,
  budget: Int,
) -> Ends / {abort.raise} =
  iterate(e, budget + 1, |x: Ends| {
    let c = take_output(x.client);
    let s = take_output(x.server);
    let up = bytes_concat(x.up, c.bytes);
    let down = bytes_concat(x.down, s.bytes);
    if (bytes_len(up) == 0 && bytes_len(down) == 0) || x.step >= budget {
      Stop({ ..x, client: c.connection, server: s.connection, up: up, down: down })
    } else {
      let n = piece(cuts, x.step, bytes_len(up));
      let heard = receive(s.connection, bytes_slice(up, 0, n), at(x.step + 1));
      let m = piece(cuts, x.step + 1, bytes_len(down));
      let back = receive(c.connection, bytes_slice(down, 0, m), at(x.step + 1));
      Continue({
        client: back.connection,
        server: answered_all(heard.connection, heard.events, app, x.step + 1),
        up: bytes_slice(up, n, bytes_len(up)),
        down: bytes_slice(down, m, bytes_len(down)),
        events: concat(x.events, back.events),
        step: x.step + 1,
      })
    }
  })

fn answers(events: List<Event>) -> List<(Int, Int, String)> / {abort.raise} =
  fold(events, [], |acc: List<(Int, Int, String)>, e: Event|
    match e {
      Answered(a) ->
        push(acc, (a.stream, a.response.status, string_of_bytes_lossy(a.response.body))),
      Failed(f) -> push(acc, (f.stream, 0, f.reason)),
      Reset(r) -> push(acc, (r.stream, 0 - 1, code_name(r.code))),
      _ -> acc,
    })

test "a client's requests reach a server, and its answers come back on their streams" {
  let posted = { ..asking("POST", "/b", b"xyz"), trailers: map_insert(map_new(), "x-sum", ["3"]) };
  let e = carried(
    asked(joined(default_limits()), [asking("GET", "/a", b""), posted, asking("HEAD", "/c", b"")]),
    echo,
    [],
    50,
  );
  assert_eq(answers(e.events), [(1, 200, "GET /a "), (3, 200, "POST /b xyz"), (5, 200, "")]);
  match filter(e.events, |x: Event| match x { Answered(a) -> a.stream == 5, _ -> false }) {
    [Answered(a)] -> assert_eq(first_value(a.response.headers, "content-length"), Some("8")),
    _ -> panic("an answer on stream 5"),
  };
  assert_eq(open_streams(e.client), 0);
  assert_eq(open_streams(e.server), 0)
}

test "a request's trailers reach the server's application" {
  let posted = { ..asking("POST", "/b", b"xyz"), trailers: map_insert(map_new(), "x-sum", ["3"]) };
  let e = carried(
    asked(joined(default_limits()), [posted]),
    |r: Request|
      plain_text(200, match first_value(r.trailers, "x-sum") { Some(v) -> v, None -> "none" }),
    [],
    50,
  );
  assert_eq(answers(e.events), [(1, 200, "3")])
}

test "a client refuses a response whose head is malformed, and a server's PUSH_PROMISE" {
  let start = take_output(client(default_limits(), at(0)));
  let sent = match request(start.connection, asking("GET", "/", b""), at(0)) {
    Some(s) -> s.connection,
    None -> panic("a stream"),
  };
  let reply = wire([
    SettingsFrame({ ack: false, settings: [] }),
    headers(1, [(":status", "200"), (":path", "/")], true),
  ]);
  let r = receive(sent, reply, at(1));
  assert_eq(answers(r.events), [
    (1, 0, "the pseudo-header `:path`, which this message does not take"),
  ]);
  let pushed = receive(
    sent,
    wire([
      SettingsFrame({ ack: false, settings: [] }),
      PushPromiseFrame({ stream: 1, promised: 2, block: b"", end_headers: true, padding: None }),
    ]),
    at(1),
  );
  assert(finished(pushed.connection), None)
}

test "a client is told which of its streams a GOAWAY left untaken, and opens no more" {
  let opened_two = asked(joined(default_limits()), [
    asking("GET", "/a", b""),
    asking("GET", "/b", b""),
  ]);
  let c = take_output(opened_two.client);
  let told = receive(
    c.connection,
    wire([
      SettingsFrame({ ack: false, settings: [] }),
      GoAwayFrame({ last_stream: 1, code: NoError, debug: b"" }),
    ]),
    at(1),
  );
  assert_eq(answers(told.events), [(3, 0 - 1, "REFUSED_STREAM")]);
  assert_eq(request(told.connection, asking("GET", "/c", b""), at(2)) == None, true)
}

/// An answer of as many octets as the target, `/50`, says.
fn sized(r: Request) -> Response / {abort.raise} =
  {
    status: 200,
    headers: map_new(),
    body: repeat(
      b"x",
      match int_of_ascii(bytes_of_string(string_slice(r.target, 1, string_len(r.target)))) {
        Some(n) -> n,
        None -> 0,
      },
    ),
  }

/// `n` folded into `0` to `below`, for a sampled number to pick with.
fn non_negative(n: Int, below: Int) -> Int / {abort.raise} =
  if n < 0 { 0 - n % below } else { n % below }

type Ledger = { connection: Connection, sent: Map<Int, Int>, granted: Map<Int, Int>, held: Bool }

fn tallied(l: Ledger, bytes: Bytes, window: Int) -> Ledger / {abort.raise} =
  fold(frames_in(bytes), l, |x: Ledger, f: Frame|
    match f {
      DataFrame(d) -> {
        let sent = map_insert(
          map_insert(x.sent, d.stream, at_least(map_get(x.sent, d.stream)) + flow_length(f)),
          0,
          at_least(map_get(x.sent, 0)) + flow_length(f),
        );
        {
          ..x,
          sent: sent,
          held: x.held
            && at_least(map_get(sent, d.stream)) <= window + at_least(map_get(x.granted, d.stream))
            && at_least(map_get(sent, 0)) <= default_window() + at_least(map_get(x.granted, 0)),
        }
      },
      _ -> x,
    })

fn at_least(n: Option<Int>) -> Int = match n { Some(v) -> v, None -> 0 }

law "a server sends no more DATA than its client's windows allow, however they open"
  forall (window: Int, sizes: List<Int>, updates: List<Int>) {
    let w = non_negative(window, 1000);
    let gets = bytes_concat_all(
      map(range(0, 3), |i: Int|
        get(2 * i + 1, "/" ++ int_to_string(non_negative(at_or(sizes, i, 0), 70000)))),
    );
    let start = take_output(server(default_limits(), at(0)));
    let first = receive(
      start.connection,
      bytes_concat(opening([InitialWindowSize(w)]), gets),
      at(1),
    );
    let out = take_output(answered_all(first.connection, first.events, sized, 1));
    let opened_ledger = tallied(
      { connection: out.connection, sent: map_new(), granted: map_new(), held: true },
      out.bytes,
      w,
    );
    let end = fold(updates, opened_ledger, |x: Ledger, u: Int| {
      let s = at_or([0, 1, 3, 5], non_negative(u, 4), 0);
      let n = 1 + non_negative(u / 4, 40000);
      let r = receive(x.connection, wire([WindowUpdateFrame({ stream: s, increment: n })]), at(2));
      let o = take_output(r.connection);
      tallied(
        {
          ..x,
          connection: o.connection,
          granted: map_insert(x.granted, s, at_least(map_get(x.granted, s)) + n),
        },
        o.bytes,
        w,
      )
    });
    end.held
  }

fn posts(n: Int, size: Int) -> List<Request> / {abort.raise} =
  map(range(0, n), |i: Int| asking("POST", "/" ++ int_to_string(i), repeat(b"p", size)))

law "two exchanges larger than every stream window finish however the bytes between the ends are cut"
  forall (cuts: List<Int>) {
    let l = { ..default_limits(), initial_window: 100 };
    // An octet each way a step takes a step for each octet of both exchanges.
    let e = carried(asked(joined(l), posts(2, 1000)), echo, cuts, 12000);
    sort(answers(e.events))
      == [
        (1, 200, "POST /0 " ++ string_of_bytes(repeat(b"p", 1000))),
        (3, 200, "POST /1 " ++ string_of_bytes(repeat(b"p", 1000))),
      ]
  }

fn spawned(
  events: List<Event>,
  inbox: Chan<(Int, Response)>,
) -> Unit / {task.spawn, task.send, abort.raise} =
  match events {
    [] -> (),
    [Requested(q), ..rest] -> {
      task.spawn(|| task.send(inbox, (q.stream, sized(q.request))));
      spawned(rest, inbox)
    },
    [_, ..rest] -> spawned(rest, inbox),
  }

/// A connection on the one-core task model: each request is answered by a task of its own, and
/// the connection's task carries a step of bytes each way, then takes whatever answer is ready
/// without waiting, and waits for one only when no byte is left to carry. The schedule decides
/// where among the steps each answer lands.
fn multiplexed(
  e: Ends,
  inbox: Chan<(Int, Response)>,
  fuel: Int,
) -> Ends / {task.spawn, task.send, task.select, task.recv, abort.raise} =
  if fuel <= 0 || len(answers(e.events)) >= 2 { e } else {
    let c = take_output(e.client);
    let s = take_output(e.server);
    let heard = receive(s.connection, c.bytes, at(1));
    spawned(heard.events, inbox);
    let back = receive(c.connection, s.bytes, at(1));
    let quiet = bytes_len(c.bytes) == 0 && bytes_len(s.bytes) == 0;
    let ready = match task.select([(inbox, None)], quiet) {
      Some((_, Some(answer))) -> Some(answer),
      _ -> None,
    };
    let server_now = match ready {
      Some((stream, r)) -> respond(heard.connection, stream, r, at(1)),
      None -> heard.connection,
    };
    multiplexed(
      { ..e, client: back.connection, server: server_now, events: concat(e.events, back.events) },
      inbox,
      fuel - 1,
    )
  }

test "two answers larger than their windows finish under every interleaving of their streams" {
  simulate {
    let inbox = task.channel(4);
    let l = { ..default_limits(), initial_window: 40 };
    let e = multiplexed(
      asked(joined(l), [asking("GET", "/50", b""), asking("GET", "/45", b"")]),
      inbox,
      40,
    );
    assert_eq(sort(answers(e.events)), [
      (1, 200, string_of_bytes(repeat(b"x", 50))),
      (3, 200, string_of_bytes(repeat(b"x", 45))),
    ])
  }
}
