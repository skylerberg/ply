//! HTTP/2 (RFC 9113) and its header compression, HPACK (RFC 7541), as a machine with no I/O: bytes
//! in, events and bytes out.
//!
//! The frame codec reads and writes every frame type; `read_frame` refuses what the standard calls a
//! connection or a stream error by raising `http2.violated`. HPACK is an `Encoder` and a `Decoder`
//! over the static table, the Huffman code and a dynamic table each.
//!
//! A `Connection` is one end of a connection, a server's or a client's. `receive` gives it bytes
//! read from the peer and answers the `Event`s they make, `respond` and `request` give it messages
//! to send, and `take_output` answers what to write. A `Response` has the shape `std.http`'s has, so
//! either is the other, and `std.http` reads a `Request` as its own; it serves and fetches over this
//! machine, so an application does not know which wire carried a message. Time is what the caller
//! passes as `now`; `tick` acts on what a clock alone decides, and `deadline` says when it next
//! needs to run. The machine reads no socket and no clock, so an exchange is data, and two machines
//! handed each other's bytes are a test of both.
//!
//! What a peer may make one connection cost is `Limits`, and each known attack on HTTP/2 is one of
//! its fields: rapid reset (CVE-2023-44487) is `max_resets`, the CONTINUATION flood
//! `max_continuations` and `max_header_block`, an HPACK bomb `max_header_list_size`,
//! `max_table_size` and `max_table_size_updates`, SETTINGS and PING floods `max_settings` and
//! `max_pings`, frames that carry nothing `max_empty_frames`, and a reader that never opens its
//! window `stall_ms` and `max_buffered`. Past one, the stream or the connection is refused, and a
//! connection is refused with `GOAWAY`. `drain` closes one gracefully: the streams it took are
//! answered, and the peer is told which it did not take.
//!
//! Server push and the priority tree are not here: a server pushes nothing and both ends read
//! priorities and ignore them, as RFC 9113 lets them. A request to `CONNECT` is answered 501.

import std.bytes (bytes_of_hex, hex_of, int_of_ascii, is_blank, repeat, u32_be, u32_be_at)
import std.gen
import std.gen (Gen)
import std.laws (round_trip)
import std.list (at_or, concat, contains, drop, sort)
import std.string (ascii_lower, ascii_trim, join)
import std.time (at_millis)

// --- Errors -------------------------------------------------------------------

/// What a `RST_STREAM` or a `GOAWAY` says went wrong (RFC 9113 §7). A code the standard does not
/// assign keeps its number, and is read as `InternalError` is.
pub type ErrorCode =
  | NoError
  | ProtocolError
  | InternalError
  | FlowControlError
  | SettingsTimeout
  | StreamClosed
  | FrameSizeError
  | RefusedStream
  | Cancel
  | CompressionError
  | ConnectError
  | EnhanceYourCalm
  | InadequateSecurity
  | Http11Required
  | Unassigned(Int)

fn assigned_codes() -> List<ErrorCode> =
  [
    NoError,
    ProtocolError,
    InternalError,
    FlowControlError,
    SettingsTimeout,
    StreamClosed,
    FrameSizeError,
    RefusedStream,
    Cancel,
    CompressionError,
    ConnectError,
    EnhanceYourCalm,
    InadequateSecurity,
    Http11Required,
  ]

/// The code as RFC 9113 names it, `PROTOCOL_ERROR` for `ProtocolError`; an unassigned one as
/// its number in hexadecimal.
pub fn code_name(c: ErrorCode) -> String / {abort.raise} =
  match c {
    Unassigned(n) -> "0x" ++ hex_of(u32_be(n)),
    _ ->
      at_or(
        [
          "NO_ERROR",
          "PROTOCOL_ERROR",
          "INTERNAL_ERROR",
          "FLOW_CONTROL_ERROR",
          "SETTINGS_TIMEOUT",
          "STREAM_CLOSED",
          "FRAME_SIZE_ERROR",
          "REFUSED_STREAM",
          "CANCEL",
          "COMPRESSION_ERROR",
          "CONNECT_ERROR",
          "ENHANCE_YOUR_CALM",
          "INADEQUATE_SECURITY",
          "HTTP_1_1_REQUIRED",
        ],
        code_number(c),
        "",
      ),
  }

/// The code's number on the wire.
pub fn code_number(c: ErrorCode) -> Int =
  match c {
    NoError -> 0,
    ProtocolError -> 1,
    InternalError -> 2,
    FlowControlError -> 3,
    SettingsTimeout -> 4,
    StreamClosed -> 5,
    FrameSizeError -> 6,
    RefusedStream -> 7,
    Cancel -> 8,
    CompressionError -> 9,
    ConnectError -> 10,
    EnhanceYourCalm -> 11,
    InadequateSecurity -> 12,
    Http11Required -> 13,
    Unassigned(n) -> n,
  }

/// The code a number names; a number the standard does not assign is `Unassigned`.
pub fn code_of(n: Int) -> ErrorCode =
  if n < 0 { Unassigned(n) }
  else { match list_at(assigned_codes(), n) { Some(c) -> c, None -> Unassigned(n) } }

/// A peer's breach of the protocol: the code to answer it with, the stream it is confined to, `0`
/// for the whole connection, and what was wrong.
pub type Violation = new { code: ErrorCode, stream: Int, reason: String }

/// What this module raises where it refuses bytes.
pub effect http2 {
  /// The bytes break the protocol, as the violation says.
  raise violated(v: Violation)
}

fn violation<a>(code: ErrorCode, stream: Int, reason: String) -> a / {http2.violated} =
  http2.violated({ code: code, stream: stream, reason: reason })

// --- Frames -------------------------------------------------------------------

/// The connection preface a client opens with, before its first `SETTINGS` (RFC 9113 §3.4).
pub fn preface() -> Bytes = b"PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n"

/// The largest frame every endpoint takes until its peer allows more, and the least it may allow.
pub fn default_frame_size() -> Int = 16384

/// The largest frame size a peer may allow: a frame's length is 24 bits.
pub fn largest_frame_size() -> Int = 16777215

/// The largest flow-control window, and the largest stream identifier: 2^31-1.
pub fn largest_window() -> Int = 2147483647

/// The window every stream and the connection start with, until `SETTINGS` say otherwise.
pub fn default_window() -> Int = 65535

/// The dynamic table size HPACK starts with on each side.
pub fn default_table_size() -> Int = 4096

/// A stream's place in the tree RFC 7540 had clients build, which RFC 9113 leaves to be read and
/// ignored: the stream it depends on, whether exclusively, and its weight from 1 to 256.
pub type Priority = { depends_on: Int, exclusive: Bool, weight: Int }

/// One parameter of a `SETTINGS` frame (RFC 9113 §6.5.2). A reader keeps one the standard does not
/// define as `Unknown`, its identifier and its value, and nothing heeds it.
pub type Setting =
  | HeaderTableSize(Int)
  | EnablePush(Bool)
  | MaxConcurrentStreams(Int)
  | InitialWindowSize(Int)
  | MaxFrameSize(Int)
  | MaxHeaderListSize(Int)
  | Unknown(Int, Int)

/// A frame (RFC 9113 §6). `padding` is how many octets of padding a padded frame carries, `None` for
/// a frame without the flag. A `block` is a piece of a field block HPACK wrote, which a `HEADERS` or
/// `PUSH_PROMISE` frame and the `CONTINUATION` frames after it carry between them.
pub type Frame =
  | DataFrame({ stream: Int, data: Bytes, end_stream: Bool, padding: Option<Int> })
  | HeadersFrame({ stream: Int, block: Bytes, end_stream: Bool, end_headers: Bool, priority: Option<Priority>, padding: Option<Int> })
  | PriorityFrame({ stream: Int, priority: Priority })
  | ResetFrame({ stream: Int, code: ErrorCode })
  | SettingsFrame({ ack: Bool, settings: List<Setting> })
  | PushPromiseFrame({ stream: Int, promised: Int, block: Bytes, end_headers: Bool, padding: Option<Int> })
  | PingFrame({ ack: Bool, data: Bytes })
  | GoAwayFrame({ last_stream: Int, code: ErrorCode, debug: Bytes })
  | WindowUpdateFrame({ stream: Int, increment: Int })
  | ContinuationFrame({ stream: Int, block: Bytes, end_headers: Bool })
  /// A frame of a type RFC 9113 does not define, which a reader ignores.
  | UnknownFrame({ kind: Int, flags: Int, stream: Int, payload: Bytes })

/// The octets a frame takes from a flow-control window: its whole payload, padding included. Only
/// `DATA` frames take any.
pub fn flow_length(f: Frame) -> Int =
  match f {
    DataFrame(d) -> bytes_len(d.data) + (match d.padding { None -> 0, Some(n) -> n + 1 }),
    _ -> 0,
  }

fn flag(on: Bool, bit: Int) -> Int = if on { bit } else { 0 }

fn is_set(flags: Int, bit: Int) -> Bool = flags & bit != 0

fn word(b: Bytes, at: Int) -> Int / {abort.raise} =
  match u32_be_at(b, at) { Some(n) -> n, None -> 0 }

/// The bytes of a frame. Panics on one no peer may be sent: a payload past 2^24-1 octets, padding
/// past 255, a stream, a promised stream or an increment past 31 bits, or a ping that is not eight
/// octets.
pub fn encode_frame(f: Frame) -> Bytes / {abort.raise} =
  match f {
    DataFrame(d) ->
      framed(
        0,
        flag(d.end_stream, 0x1) | flag(d.padding != None, 0x8),
        d.stream,
        padded(d.data, d.padding),
      ),
    HeadersFrame(h) ->
      framed(
        1,
        flag(h.end_stream, 0x1) | flag(h.end_headers, 0x4) | flag(h.padding != None, 0x8)
          | flag(h.priority != None, 0x20),
        h.stream,
        padded(bytes_concat(priority_bytes(h.priority), h.block), h.padding),
      ),
    PriorityFrame(p) -> framed(2, 0, p.stream, priority_bytes(Some(p.priority))),
    ResetFrame(r) -> framed(3, 0, r.stream, u32_be(code_number(r.code))),
    SettingsFrame(s) ->
      framed(4, flag(s.ack, 0x1), 0, bytes_concat_all(map(s.settings, setting_bytes))),
    PushPromiseFrame(p) ->
      framed(
        5,
        flag(p.end_headers, 0x4) | flag(p.padding != None, 0x8),
        p.stream,
        padded(bytes_concat(u32_be(identifier(p.promised)), p.block), p.padding),
      ),
    PingFrame(p) -> if bytes_len(p.data) != 8 { panic("a PING carries eight octets") }
    else { framed(6, flag(p.ack, 0x1), 0, p.data) },
    GoAwayFrame(g) ->
      framed(
        7,
        0,
        0,
        bytes_concat_all([u32_be(identifier(g.last_stream)), u32_be(code_number(g.code)), g.debug]),
      ),
    WindowUpdateFrame(w) -> framed(8, 0, w.stream, u32_be(identifier(w.increment))),
    ContinuationFrame(c) -> framed(9, flag(c.end_headers, 0x4), c.stream, c.block),
    UnknownFrame(u) -> framed(u.kind, u.flags, u.stream, u.payload),
  }

fn identifier(n: Int) -> Int / {abort.raise} =
  if n < 0 || n > largest_window() { panic(int_to_string(n) ++ " is past 31 bits") } else { n }

fn framed(kind: Int, flags: Int, stream: Int, payload: Bytes) -> Bytes / {abort.raise} = {
  let n = bytes_len(payload);
  if n > largest_frame_size() {
    panic("a frame's payload is at most 16777215 octets, not " ++ int_to_string(n))
  } else {
    bytes_concat_all([
      byte_of_int(n >>> 16 & 0xFF),
      byte_of_int(n >>> 8 & 0xFF),
      byte_of_int(n & 0xFF),
      byte_of_int(kind),
      byte_of_int(flags),
      u32_be(identifier(stream)),
      payload,
    ])
  }
}

fn padded(body: Bytes, padding: Option<Int>) -> Bytes / {abort.raise} =
  match padding {
    None -> body,
    Some(n) -> if n < 0 || n > 255 { panic("padding is 0 to 255 octets") }
    else { bytes_concat_all([byte_of_int(n), body, repeat(b"\x00", n)]) },
  }

fn priority_bytes(p: Option<Priority>) -> Bytes / {abort.raise} =
  match p {
    None -> b"",
    Some(q) -> if q.weight < 1 || q.weight > 256 { panic("a weight is 1 to 256") } else {
      bytes_concat(
        u32_be(identifier(q.depends_on) | flag(q.exclusive, 0x8000_0000)),
        byte_of_int(q.weight - 1),
      )
    },
  }

fn setting_bytes(s: Setting) -> Bytes / {abort.raise} = {
  let pair = setting_pair(s);
  bytes_concat_all([
    byte_of_int(pair.id >>> 8 & 0xFF),
    byte_of_int(pair.id & 0xFF),
    u32_be(pair.value),
  ])
}

fn setting_pair(s: Setting) -> { id: Int, value: Int } =
  match s {
    HeaderTableSize(n) -> { id: 1, value: n },
    EnablePush(on) -> { id: 2, value: if on { 1 } else { 0 } },
    MaxConcurrentStreams(n) -> { id: 3, value: n },
    InitialWindowSize(n) -> { id: 4, value: n },
    MaxFrameSize(n) -> { id: 5, value: n },
    MaxHeaderListSize(n) -> { id: 6, value: n },
    Unknown(id, value) -> { id: id, value: value },
  }

/// A frame read, and where the bytes after it start.
pub type Read = { frame: Frame, next: Int }

/// The length of the frame whose header starts at `at`, or `None` where `buf` ends before its
/// header does.
pub fn frame_length(buf: Bytes, at: Int) -> Option<Int> / {abort.raise} =
  if at < 0 || bytes_len(buf) - at < 9 { None }
  else { Some(bytes_at(buf, at) << 16 | bytes_at(buf, at + 1) << 8 | bytes_at(buf, at + 2)) }

/// The frame at `at`, or `None` where `buf` ends before it does. A frame longer than `max_size` is
/// refused as soon as its header is in, before its payload is waited for. A violation confined to
/// a stream is raised only where reading the frame changed nothing else, so a reader can reset the
/// stream and go on after the frame, whose length its header gives.
pub fn read_frame(
  buf: Bytes,
  at: Int,
  max_size: Int,
) -> Option<Read> / {http2.violated, abort.raise} =
  match frame_length(buf, at) {
    None -> None,
    Some(length) -> if length > max_size {
      violation(
        FrameSizeError,
        0,
        "a frame of " ++ int_to_string(length) ++ " octets, past the " ++ int_to_string(max_size)
          ++ " allowed",
      )
    } else if bytes_len(buf) - at - 9 < length { None } else {
      Some({
        frame: frame_of(
          bytes_at(buf, at + 3),
          bytes_at(buf, at + 4),
          word(buf, at + 5) & 0x7FFF_FFFF,
          bytes_slice(buf, at + 9, at + 9 + length),
        ),
        next: at + 9 + length,
      })
    },
  }

fn frame_of(
  kind: Int,
  flags: Int,
  stream: Int,
  payload: Bytes,
) -> Frame / {http2.violated, abort.raise} =
  if kind == 0 { data_of(flags, stream, payload) }
  else if kind == 1 { headers_of(flags, stream, payload) }
  else if kind == 2 { priority_of(stream, payload) }
  else if kind == 3 { reset_of(stream, payload) }
  else if kind == 4 { settings_of(flags, stream, payload) }
  else if kind == 5 { push_promise_of(flags, stream, payload) }
  else if kind == 6 { ping_of(flags, stream, payload) }
  else if kind == 7 { goaway_of(stream, payload) }
  else if kind == 8 { window_update_of(stream, payload) }
  else if kind == 9 { continuation_of(flags, stream, payload) }
  else { UnknownFrame({ kind: kind, flags: flags, stream: stream, payload: payload }) }

fn on_stream(stream: Int, name: String) -> Unit / {http2.violated} =
  if stream == 0 { violation(ProtocolError, 0, "a " ++ name ++ " frame on stream 0") } else { () }

fn on_connection(stream: Int, name: String) -> Unit / {http2.violated} =
  if stream != 0 { violation(ProtocolError, 0, "a " ++ name ++ " frame on a stream") } else { () }

type Unpadded = { body: Bytes, padding: Option<Int> }

/// A padded payload without its padding. Padding as long as the payload is refused (§6.1).
fn unpadded(flags: Int, payload: Bytes) -> Unpadded / {http2.violated, abort.raise} =
  if !is_set(flags, 0x8) { { body: payload, padding: None } } else if bytes_len(payload) == 0 {
    violation(FrameSizeError, 0, "a padded frame without its pad length")
  } else {
    let pad = bytes_at(payload, 0);
    if pad >= bytes_len(payload) {
      violation(ProtocolError, 0, "padding as long as the frame that carries it")
    } else { { body: bytes_slice(payload, 1, bytes_len(payload) - pad), padding: Some(pad) } }
  }

fn priority_at(b: Bytes, at: Int) -> Priority / {abort.raise} = {
  let w = word(b, at);
  {
    depends_on: w & 0x7FFF_FFFF,
    exclusive: is_set(w, 0x8000_0000),
    weight: bytes_at(b, at + 4) + 1,
  }
}

fn data_of(flags: Int, stream: Int, payload: Bytes) -> Frame / {http2.violated, abort.raise} = {
  on_stream(stream, "DATA");
  let p = unpadded(flags, payload);
  DataFrame({ stream: stream, data: p.body, end_stream: is_set(flags, 0x1), padding: p.padding })
}

/// A `HEADERS` frame that makes its stream depend on itself is read as it is: its block must still
/// be decoded, so the stream error is the reader's to raise once it has been.
fn headers_of(flags: Int, stream: Int, payload: Bytes) -> Frame / {http2.violated, abort.raise} = {
  on_stream(stream, "HEADERS");
  let p = unpadded(flags, payload);
  let prioritized = is_set(flags, 0x20);
  if prioritized && bytes_len(p.body) < 5 {
    violation(FrameSizeError, 0, "a HEADERS frame too short for its priority")
  } else {
    HeadersFrame({
      stream: stream,
      block: if prioritized { bytes_slice(p.body, 5, bytes_len(p.body)) } else { p.body },
      end_stream: is_set(flags, 0x1),
      end_headers: is_set(flags, 0x4),
      priority: if prioritized { Some(priority_at(p.body, 0)) } else { None },
      padding: p.padding,
    })
  }
}

fn priority_of(stream: Int, payload: Bytes) -> Frame / {http2.violated, abort.raise} = {
  on_stream(stream, "PRIORITY");
  if bytes_len(payload) != 5 {
    violation(FrameSizeError, stream, "a PRIORITY frame of other than five octets")
  } else {
    let q = priority_at(payload, 0);
    if q.depends_on == stream {
      violation(ProtocolError, stream, "a stream that depends on itself")
    } else { PriorityFrame({ stream: stream, priority: q }) }
  }
}

fn reset_of(stream: Int, payload: Bytes) -> Frame / {http2.violated, abort.raise} = {
  on_stream(stream, "RST_STREAM");
  if bytes_len(payload) != 4 {
    violation(FrameSizeError, 0, "a RST_STREAM frame of other than four octets")
  } else { ResetFrame({ stream: stream, code: code_of(word(payload, 0)) }) }
}

fn settings_of(flags: Int, stream: Int, payload: Bytes) -> Frame / {http2.violated, abort.raise} = {
  on_connection(stream, "SETTINGS");
  if is_set(flags, 0x1) {
    if bytes_len(payload) != 0 {
      violation(FrameSizeError, 0, "a SETTINGS acknowledgement with a payload")
    } else { SettingsFrame({ ack: true, settings: [] }) }
  } else if bytes_len(payload) % 6 != 0 {
    violation(FrameSizeError, 0, "a SETTINGS frame whose length is not a multiple of six")
  } else {
    SettingsFrame({
      ack: false,
      settings: map(range(0, bytes_len(payload) / 6), |i: Int| setting_at(payload, i * 6)),
    })
  }
}

fn setting_at(b: Bytes, at: Int) -> Setting / {http2.violated, abort.raise} = {
  let id = bytes_at(b, at) << 8 | bytes_at(b, at + 1);
  let value = word(b, at + 2);
  if id == 1 { HeaderTableSize(value) } else if id == 2 {
    if value > 1 { violation(ProtocolError, 0, "SETTINGS_ENABLE_PUSH other than 0 or 1") }
    else { EnablePush(value == 1) }
  } else if id == 3 { MaxConcurrentStreams(value) } else if id == 4 {
    if value > largest_window() {
      violation(FlowControlError, 0, "SETTINGS_INITIAL_WINDOW_SIZE past 2^31-1")
    } else { InitialWindowSize(value) }
  } else if id == 5 {
    if value < default_frame_size() || value > largest_frame_size() {
      violation(ProtocolError, 0, "SETTINGS_MAX_FRAME_SIZE outside 16384 to 16777215")
    } else { MaxFrameSize(value) }
  } else if id == 6 { MaxHeaderListSize(value) }
  else { Unknown(id, value) }
}

fn push_promise_of(
  flags: Int,
  stream: Int,
  payload: Bytes,
) -> Frame / {http2.violated, abort.raise} = {
  on_stream(stream, "PUSH_PROMISE");
  let p = unpadded(flags, payload);
  if bytes_len(p.body) < 4 {
    violation(FrameSizeError, 0, "a PUSH_PROMISE frame too short for its promised stream")
  } else {
    PushPromiseFrame({
      stream: stream,
      promised: word(p.body, 0) & 0x7FFF_FFFF,
      block: bytes_slice(p.body, 4, bytes_len(p.body)),
      end_headers: is_set(flags, 0x4),
      padding: p.padding,
    })
  }
}

fn ping_of(flags: Int, stream: Int, payload: Bytes) -> Frame / {http2.violated, abort.raise} = {
  on_connection(stream, "PING");
  if bytes_len(payload) != 8 {
    violation(FrameSizeError, 0, "a PING frame of other than eight octets")
  } else { PingFrame({ ack: is_set(flags, 0x1), data: payload }) }
}

fn goaway_of(stream: Int, payload: Bytes) -> Frame / {http2.violated, abort.raise} = {
  on_connection(stream, "GOAWAY");
  if bytes_len(payload) < 8 {
    violation(FrameSizeError, 0, "a GOAWAY frame shorter than eight octets")
  } else {
    GoAwayFrame({
      last_stream: word(payload, 0) & 0x7FFF_FFFF,
      code: code_of(word(payload, 4)),
      debug: bytes_slice(payload, 8, bytes_len(payload)),
    })
  }
}

fn window_update_of(stream: Int, payload: Bytes) -> Frame / {http2.violated, abort.raise} =
  if bytes_len(payload) != 4 {
    violation(FrameSizeError, 0, "a WINDOW_UPDATE frame of other than four octets")
  } else {
    let increment = word(payload, 0) & 0x7FFF_FFFF;
    if increment == 0 { violation(ProtocolError, stream, "a window increment of 0") }
    else { WindowUpdateFrame({ stream: stream, increment: increment }) }
  }

fn continuation_of(flags: Int, stream: Int, payload: Bytes) -> Frame / {http2.violated} = {
  on_stream(stream, "CONTINUATION");
  ContinuationFrame({ stream: stream, block: payload, end_headers: is_set(flags, 0x4) })
}

// --- HPACK: integers and strings ------------------------------------------------

/// A header field as HPACK carries it: a name and a value, both octets.
pub type Field = { name: Bytes, value: Bytes }

fn compression<a>(reason: String) -> a / {http2.violated} = violation(CompressionError, 0, reason)

/// `n` as an integer whose first octet leaves it the low `prefix` bits and holds `bits` above them
/// (RFC 7541 §5.1).
fn integer(n: Int, prefix: Int, bits: Int) -> Bytes / {abort.raise} = {
  let top = (1 << prefix) - 1;
  if n < top { byte_of_int(bits | n) }
  else { bytes_concat(byte_of_int(bits | top), continued(n - top, [], 10)) }
}

fn continued(n: Int, out: List<Bytes>, fuel: Int) -> Bytes / {abort.raise} =
  if n < 128 || fuel <= 0 { bytes_concat_all(push(out, byte_of_int(n & 127))) }
  else { continued(n >>> 7, push(out, byte_of_int(n & 127 | 128)), fuel - 1) }

type Taken = { value: Int, next: Int }

/// The integer at `at` whose first octet gives it `prefix` bits. One of more than five continuation
/// octets, past 2^32, or that runs past the block is refused.
fn integer_at(b: Bytes, at: Int, prefix: Int) -> Taken / {http2.violated, abort.raise} = {
  let top = (1 << prefix) - 1;
  let first = bytes_at(b, at) & top;
  if first < top { { value: first, next: at + 1 } } else { integer_rest(b, at + 1, top, 0, 5) }
}

fn integer_rest(
  b: Bytes,
  at: Int,
  value: Int,
  shift: Int,
  fuel: Int,
) -> Taken / {http2.violated, abort.raise} =
  if fuel <= 0 { compression("an integer of more than five continuation octets") }
  else if at >= bytes_len(b) { compression("an integer that runs past the end of its block") }
  else {
    let octet = bytes_at(b, at);
    let v = value + ((octet & 127) << shift);
    if v > 0xFFFF_FFFF { compression("an integer past 2^32") }
    else if octet & 128 == 0 { { value: v, next: at + 1 } }
    else { integer_rest(b, at + 1, v, shift + 7, fuel - 1) }
  }

type Literal = { value: Bytes, next: Int }

/// The string literal at `at`, Huffman-decoded where its first bit says it is coded (§5.2).
fn string_at(b: Bytes, at: Int) -> Literal / {http2.violated, abort.raise} =
  if at >= bytes_len(b) { compression("a block that ends where a string should start") } else {
    let coded = bytes_at(b, at) & 0x80 != 0;
    let n = integer_at(b, at, 7);
    if n.value > bytes_len(b) - n.next {
      compression("a string that runs past the end of its block")
    } else {
      let raw = bytes_slice(b, n.next, n.next + n.value);
      { value: if coded { huffman_decode(raw) } else { raw }, next: n.next + n.value }
    }
  }

/// `s` as a string literal, Huffman-coded where that is shorter.
fn string_literal(s: Bytes) -> Bytes / {abort.raise} = {
  let coded = huffman_length(s);
  if coded < bytes_len(s) { bytes_concat(integer(coded, 7, 0x80), huffman_encode(s)) }
  else { bytes_concat(integer(bytes_len(s), 7, 0), s) }
}

