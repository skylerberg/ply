//! Object identifiers: the dotted numbers that name an algorithm, an attribute or an extension.
//!
//! An `Oid` is its arcs. A valid one has at least two: the first is 0, 1 or 2, and under 0 and 1
//! the second is below 40, which is what lets ASN.1 write the first two as one number. An arc is an
//! `Int`, so one past 63 bits has no `Oid`. `show` writes the dotted text, `parse` reads it back,
//! and `oid"1.2.840.113549.1.1.11"` is an `Oid` checked when the program is. `std.asn1` reads and
//! writes the encoded form.

import std.bytes (int_of_ascii, is_digit)
import std.list (all, concat)
import std.string (join)

/// An object identifier as its arcs, first to last.
pub type Oid = | Oid(List<Int>)

show for Oid by to_string

/// The arcs, first to last.
pub fn arcs(o: Oid) -> List<Int> = match o { Oid(arcs) -> arcs }

/// The identifier these arcs spell, or `None` where no identifier has them.
pub fn of_arcs(arcs: List<Int>) -> Option<Oid> =
  if is_valid(Oid(arcs)) { Some(Oid(arcs)) } else { None }

/// Whether the arcs are an identifier's: two or more, none negative, the first 0, 1 or 2, the
/// second below 40 under 0 and 1, and under 2 small enough that the two still fit one `Int`.
pub fn is_valid(o: Oid) -> Bool =
  match arcs(o) {
    [first, second, ..] ->
      all(arcs(o), |arc: Int| arc >= 0) && first <= 2
        && (if first < 2 { second < 40 } else { second <= 9223372036854775727 }),
    _ -> false,
  }

/// The dotted text: each arc in decimal, with `.` between them.
pub fn to_string(o: Oid) -> String = join(map(arcs(o), int_to_string), ".")

/// The identifier a dotted text names, or `None`: a `literal` without its reason.
pub fn parse(text: String) -> Option<Oid> / {abort.raise} =
  match literal(text) { Ok(o) -> Some(o), Err(_) -> None }

/// What an `oid"..."` literal is checked by: the identifier a dotted text names, or the first
/// character that keeps it from being one. An arc is written without a sign and without a leading
/// zero.
pub fn literal(text: String) -> Result<Oid, { message: String, offset: Int }> / {abort.raise} = {
  let scanned = fold(string_split(text, "."), { arcs: [], offset: 0, stray: None }, arc_scanned);
  match scanned.stray {
    Some(stray) -> Err(stray),
    None -> match scanned.arcs {
      [first, second, ..] -> if first > 2 {
        Err({ message: "the first arc is 0, 1 or 2", offset: 0 })
      } else if !is_valid(Oid(scanned.arcs)) {
        Err({
          message: if first < 2 { "under 0 and 1 the second arc is below 40" }
          else { "an arc past what an `Int` holds" },
          offset: string_len(int_to_string(first)) + 1,
        })
      } else { Ok(Oid(scanned.arcs)) },
      _ -> Err({ message: "an object identifier has at least two arcs", offset: string_len(text) }),
    },
  }
}

/// The arcs read so far, where the next one starts, and the first character that is no part of one.
type Scan = { arcs: List<Int>, offset: Int, stray: Option<{ message: String, offset: Int }> }

fn arc_scanned(s: Scan, part: String) -> Scan / {abort.raise} =
  if s.stray != None { s } else {
    let digits = bytes_of_string(part);
    let stops = match bytes_position(digits, 0, |b: Int| !is_digit(b)) {
      Some(i) -> string_len(string_of_bytes_lossy(bytes_slice(digits, 0, i))),
      None -> string_len(part),
    };
    let refused = |message: String, at: Int| { ..s, stray: Some({ message: message, offset: at }) };
    if stops < string_len(part) { refused("not a digit or a `.`", s.offset + stops) }
    else if stops == 0 { refused("an arc has at least one digit", s.offset) }
    else if stops > 1 && string_starts_with(part, "0") {
      refused("an arc has no leading zero", s.offset)
    } else {
      match int_of_ascii(digits) {
        None -> refused("an arc past what an `Int` holds", s.offset),
        Some(arc) -> { arcs: push(s.arcs, arc), offset: s.offset + stops + 1, stray: None },
      }
    }
  }

// --- Well-known identifiers ------------------------------------------------------

/// `rsaEncryption`, an RSA key (PKCS #1).
pub fn rsa_encryption() -> Oid = Oid([1, 2, 840, 113549, 1, 1, 1])

/// `sha256WithRSAEncryption`, an RSA PKCS #1 v1.5 signature over SHA-256.
pub fn sha256_with_rsa_encryption() -> Oid = Oid([1, 2, 840, 113549, 1, 1, 11])

/// `sha384WithRSAEncryption`, an RSA PKCS #1 v1.5 signature over SHA-384.
pub fn sha384_with_rsa_encryption() -> Oid = Oid([1, 2, 840, 113549, 1, 1, 12])

/// `sha512WithRSAEncryption`, an RSA PKCS #1 v1.5 signature over SHA-512.
pub fn sha512_with_rsa_encryption() -> Oid = Oid([1, 2, 840, 113549, 1, 1, 13])

/// `id-RSASSA-PSS`, an RSA signature with the PSS padding.
pub fn rsassa_pss() -> Oid = Oid([1, 2, 840, 113549, 1, 1, 10])

/// `id-ecPublicKey`, an elliptic-curve key, whose parameters name its curve.
pub fn ec_public_key() -> Oid = Oid([1, 2, 840, 10045, 2, 1])

/// `prime256v1`, the curve NIST calls P-256.
pub fn prime256v1() -> Oid = Oid([1, 2, 840, 10045, 3, 1, 7])

/// `secp384r1`, the curve NIST calls P-384.
pub fn secp384r1() -> Oid = Oid([1, 3, 132, 0, 34])

/// `ecdsa-with-SHA256`, an ECDSA signature over SHA-256.
pub fn ecdsa_with_sha256() -> Oid = Oid([1, 2, 840, 10045, 4, 3, 2])

/// `ecdsa-with-SHA384`, an ECDSA signature over SHA-384.
pub fn ecdsa_with_sha384() -> Oid = Oid([1, 2, 840, 10045, 4, 3, 3])

/// `id-Ed25519`, an Ed25519 key and its signatures.
pub fn ed25519() -> Oid = Oid([1, 3, 101, 112])

/// `id-X25519`, an X25519 key.
pub fn x25519() -> Oid = Oid([1, 3, 101, 110])

/// `id-sha256`, the SHA-256 digest.
pub fn sha256() -> Oid = Oid([2, 16, 840, 1, 101, 3, 4, 2, 1])

/// `id-sha384`, the SHA-384 digest.
pub fn sha384() -> Oid = Oid([2, 16, 840, 1, 101, 3, 4, 2, 2])

/// `id-sha512`, the SHA-512 digest.
pub fn sha512() -> Oid = Oid([2, 16, 840, 1, 101, 3, 4, 2, 3])

/// `commonName`, the `CN` of a distinguished name.
pub fn common_name() -> Oid = Oid([2, 5, 4, 3])

/// `countryName`, the `C` of a distinguished name.
pub fn country_name() -> Oid = Oid([2, 5, 4, 6])

/// `localityName`, the `L` of a distinguished name.
pub fn locality_name() -> Oid = Oid([2, 5, 4, 7])

/// `stateOrProvinceName`, the `ST` of a distinguished name.
pub fn state_or_province_name() -> Oid = Oid([2, 5, 4, 8])

/// `organizationName`, the `O` of a distinguished name.
pub fn organization_name() -> Oid = Oid([2, 5, 4, 10])

/// `organizationalUnitName`, the `OU` of a distinguished name.
pub fn organizational_unit_name() -> Oid = Oid([2, 5, 4, 11])

/// `subjectKeyIdentifier`, the certificate extension.
pub fn subject_key_identifier() -> Oid = Oid([2, 5, 29, 14])

/// `keyUsage`, the certificate extension.
pub fn key_usage() -> Oid = Oid([2, 5, 29, 15])

/// `subjectAltName`, the certificate extension.
pub fn subject_alt_name() -> Oid = Oid([2, 5, 29, 17])

/// `basicConstraints`, the certificate extension.
pub fn basic_constraints() -> Oid = Oid([2, 5, 29, 19])

/// `authorityKeyIdentifier`, the certificate extension.
pub fn authority_key_identifier() -> Oid = Oid([2, 5, 29, 35])

/// `extKeyUsage`, the certificate extension.
pub fn ext_key_usage() -> Oid = Oid([2, 5, 29, 37])

// --- Tests ------------------------------------------------------------------

type Stray = { text: String, message: String, offset: Int }

fn strays() -> List<Stray> =
  [
    { text: "", message: "an arc has at least one digit", offset: 0 },
    { text: "1", message: "an object identifier has at least two arcs", offset: 1 },
    { text: "1.", message: "an arc has at least one digit", offset: 2 },
    { text: ".1", message: "an arc has at least one digit", offset: 0 },
    { text: "1..2", message: "an arc has at least one digit", offset: 2 },
    { text: "1.2.x", message: "not a digit or a `.`", offset: 4 },
    { text: "1.2.8é0", message: "not a digit or a `.`", offset: 5 },
    { text: "1.-2", message: "not a digit or a `.`", offset: 2 },
    { text: "1.2 ", message: "not a digit or a `.`", offset: 3 },
    { text: "1.02", message: "an arc has no leading zero", offset: 2 },
    { text: "3.1", message: "the first arc is 0, 1 or 2", offset: 0 },
    { text: "1.40", message: "under 0 and 1 the second arc is below 40", offset: 2 },
    { text: "0.40.1", message: "under 0 and 1 the second arc is below 40", offset: 2 },
    { text: "1.2.9223372036854775808", message: "an arc past what an `Int` holds", offset: 4 },
    { text: "2.9223372036854775728", message: "an arc past what an `Int` holds", offset: 2 },
  ]

test "the literal's check refuses {c.text}" for c: Stray in strays() {
  assert_eq(literal(c.text), Err({ message: c.message, offset: c.offset }));
  assert_eq(parse(c.text), None)
}

test "a dotted text is its arcs, and show writes it back" {
  let o = Oid([1, 2, 840, 113549, 1, 1, 11]);
  assert_eq(parse("1.2.840.113549.1.1.11"), Some(o));
  assert_eq(literal("1.2.840.113549.1.1.11"), Ok(sha256_with_rsa_encryption()));
  assert_eq(to_string(o), "1.2.840.113549.1.1.11");
  assert_eq(f"{o}", "1.2.840.113549.1.1.11");
  assert_eq(parse("0.0"), Some(Oid([0, 0])));
  assert_eq(parse("1.39"), Some(Oid([1, 39])));
  assert_eq(parse("2.999.0"), Some(Oid([2, 999, 0])));
  assert_eq(parse("2.9223372036854775727"), Some(Oid([2, 9223372036854775727])));
  assert_eq(parse("1.2.9223372036854775807"), Some(Oid([1, 2, 9223372036854775807])))
}

test "arcs are an identifier's only where the first two say so" {
  assert_eq(of_arcs([2, 5, 4, 3]), Some(common_name()));
  assert_eq(arcs(common_name()), [2, 5, 4, 3]);
  assert_eq(of_arcs([]), None);
  assert_eq(of_arcs([1]), None);
  assert_eq(of_arcs([3, 1]), None);
  assert_eq(of_arcs([1, 40]), None);
  assert_eq(of_arcs([2, 40]), Some(Oid([2, 40])));
  assert_eq(of_arcs([1, 2, 0 - 1]), None);
  assert_eq(of_arcs([0 - 1, 2]), None)
}

law "an identifier's text reads back"
  forall (first: Int, second: Int, rest: List<Int>) {
    let o = Oid(concat([first & 1, second & 31], map(rest, |arc: Int| arc & 9223372036854775807)));
    is_valid(o) && parse(to_string(o)) == Some(o)
  }
