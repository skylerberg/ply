//! Base32 as RFC 4648 defines it, with and without padding, and Crockford's alphabet.
//!
//! RFC 4648 §6 is `encode`/`decode`: `A-Z2-7`, padded to a multiple of eight. §7, base32hex, is
//! `hex_encode`/`hex_decode`: `0-9A-V`, whose texts sort as their bytes do. Each has an `_unpadded`
//! pair, the form a one-time-password secret and a DNSSEC hash are carried in. Crockford's
//! alphabet leaves out the letters a reader confuses with digits and is never padded.
//!
//! Every decoder answers `None` for a text its encoder would not write, as `std.radix` says of
//! every alphabet: these are that module at five. What a person typed is not such a text until
//! `normalize` or `crockford_normalize` has made it one, so a decoder is lenient only where the
//! call says so.

import std.bytes (repeat)
import std.laws (idempotent, round_trip)
import std.radix
import std.string (ascii_lower, ascii_upper, join, replace)

/// RFC 4648 §6, padded.
pub fn encode(data: Bytes) -> String / {abort.raise}
  cost bytes_len(data)
= radix::encode(radix::base32(), data)

/// What `encode` wrote read back; `None` for any other text.
pub fn decode(text: String) -> Option<Bytes> / {abort.raise}
  cost string_len(text)
= radix::decode(radix::base32(), text)

/// What `decode` reads of a sealed text, sealed: the runtime decodes it without opening it, in
/// steps that follow its length alone. `None` for any other text, which is all it says of one.
pub fn decode_secret(text: Secret<String>) -> Option<Secret<Bytes>> / {abort.raise} =
  secret_decode("base32", text)

/// What `decode_unpadded(normalize(typed))` reads of a sealed text as a person typed it, sealed:
/// a one-time-password secret out of a configuration.
pub fn decode_typed_secret(typed: Secret<String>) -> Option<Secret<Bytes>> / {abort.raise} =
  secret_decode("base32-typed", typed)

/// RFC 4648 §6 without the padding.
pub fn encode_unpadded(data: Bytes) -> String / {abort.raise} =
  radix::encode(radix::unpadded(radix::base32()), data)

/// What `encode_unpadded` wrote read back; `None` for any other text, a padded one included.
pub fn decode_unpadded(text: String) -> Option<Bytes> / {abort.raise} =
  radix::decode(radix::unpadded(radix::base32()), text)

/// RFC 4648 §7, base32hex, padded.
pub fn hex_encode(data: Bytes) -> String / {abort.raise} = radix::encode(radix::base32hex(), data)

/// What `hex_encode` wrote read back; `None` for any other text.
pub fn hex_decode(text: String) -> Option<Bytes> / {abort.raise} =
  radix::decode(radix::base32hex(), text)

/// RFC 4648 §7 without the padding.
pub fn hex_encode_unpadded(data: Bytes) -> String / {abort.raise} =
  radix::encode(radix::unpadded(radix::base32hex()), data)

/// What `hex_encode_unpadded` wrote read back; `None` for any other text.
pub fn hex_decode_unpadded(text: String) -> Option<Bytes> / {abort.raise} =
  radix::decode(radix::unpadded(radix::base32hex()), text)

/// Crockford's alphabet, in upper case and with no check symbol.
pub fn crockford_encode(data: Bytes) -> String / {abort.raise} =
  radix::encode(radix::crockford(), data)

/// What `crockford_encode` wrote read back; `None` for any other text.
pub fn crockford_decode(text: String) -> Option<Bytes> / {abort.raise} =
  radix::decode(radix::crockford(), text)

/// A base32 text as a person typed it, made the one `decode_unpadded` reads: letters in upper
/// case, spaces, tabs and hyphens dropped, and the padding at its end dropped. Any other character
/// stays, for the decoder to refuse.
pub fn normalize(typed: String) -> String / {abort.raise} =
  unfilled(ascii_upper(without(typed, " \t-")))

/// A Crockford text as a person typed it, made the one `crockford_decode` reads, by the rules the
/// alphabet was chosen for: letters in upper case, `O` read as `0`, `I` and `L` as `1`, and hyphens
/// dropped.
pub fn crockford_normalize(typed: String) -> String =
  replace(replace(replace(ascii_upper(without(typed, "-")), "O", "0"), "I", "1"), "L", "1")

/// What a `base32"..."` literal is checked by: the bytes a padded text in RFC 4648 §6's alphabet
/// names, or where it stops being one.
pub fn literal(text: String) -> Result<Bytes, { message: String, offset: Int }> / {abort.raise} =
  match radix::parse(radix::base32(), text) {
    Ok(data) -> Ok(data),
    Err(r) ->
      Err({
        message: match r.why {
          radix::Stray -> if lower_at(text, r.at) { "base32 is written in upper case" }
          else { "not a base32 letter" },
          radix::Ragged -> "padded base32 is a multiple of eight characters",
          radix::Lone -> "the last letter completes no byte",
          radix::Loose -> "the last letter leaves bits no byte holds",
        },
        offset: r.at,
      }),
  }

/// Whether the character at `at` is an ASCII lower-case letter.
fn lower_at(text: String, at: Int) -> Bool / {abort.raise} =
  ascii_upper(string_slice(text, at, at + 1)) != string_slice(text, at, at + 1)

/// `text` with every character of `dropped` taken out.
fn without(text: String, dropped: String) -> String =
  fold(string_chars(dropped), text, |t: String, c: Char| replace(t, string_of_chars([c]), ""))

/// `text` without the `=` it ends in.
fn unfilled(text: String) -> String / {abort.raise} =
  string_slice(text, 0, filled_to(text, string_len(text)))

/// The length of the first `n` characters of `text` before the `=` they end in.
fn filled_to(text: String, n: Int) -> Int / {abort.raise} =
  if n > 0 && string_slice(text, n - 1, n) == "=" { filled_to(text, n - 1) } else { n }

// --- Tests ------------------------------------------------------------------

law "a decode of an encode is the bytes encoded" = round_trip(encode, decode)

law "an unpadded decode of an encode is the bytes encoded" =
  round_trip(encode_unpadded, decode_unpadded)

law "a base32hex decode of an encode is the bytes encoded" = round_trip(hex_encode, hex_decode)

law "an unpadded base32hex decode of an encode is the bytes encoded" =
  round_trip(hex_encode_unpadded, hex_decode_unpadded)

law "a Crockford decode of an encode is the bytes encoded" =
  round_trip(crockford_encode, crockford_decode)

law "a text made canonical is canonical" = idempotent(normalize)

law "a sealed text decodes to what its plain text does, sealed"
  forall (text: String) {
    decode_secret(secret_of_string(text))
      == (match decode(text) { Some(data) -> Some(secret_of_bytes(data)), None -> None })
  }

law "a sealed encoding decodes to its bytes, sealed"
  forall (data: Bytes) {
    decode_secret(secret_of_string(encode(data))) == Some(secret_of_bytes(data))
  }

law "a sealed text as typed decodes to what its plain text does once made canonical, sealed"
  forall (text: String) {
    decode_typed_secret(secret_of_string(text))
      == (match decode_unpadded(normalize(text)) {
        Some(data) -> Some(secret_of_bytes(data)),
        None -> None,
      })
  }

law "a sealed encoding typed back in lower case and in groups decodes to its bytes, sealed"
  forall (data: Bytes) {
    decode_typed_secret(secret_of_string(typed(encode(data)))) == Some(secret_of_bytes(data))
  }

law "a Crockford text made canonical is canonical" = idempotent(crockford_normalize)

/// An encoding as a person might type it back: in lower case, in groups of four.
fn typed(text: String) -> String / {abort.raise} = join(radix::wrap(ascii_lower(text), 4), " ")

law "what is typed back in lower case and in groups reads as the bytes encoded" =
  round_trip(|data: Bytes| typed(encode(data)), |text: String| decode_unpadded(normalize(text)))

law "a Crockford text typed back in lower case and hyphenated reads as the bytes encoded" =
  round_trip(|data: Bytes| ascii_lower(crockford_encode(data)) ++ "-", |text: String|
    crockford_decode(crockford_normalize(text)))

type Vector = { bytes: Bytes, text: String, hex: String }

/// RFC 4648, section 10.
fn rfc_4648() -> List<Vector> =
  [
    { bytes: b"", text: "", hex: "" },
    { bytes: b"f", text: "MY======", hex: "CO======" },
    { bytes: b"fo", text: "MZXQ====", hex: "CPNG====" },
    { bytes: b"foo", text: "MZXW6===", hex: "CPNMU===" },
    { bytes: b"foob", text: "MZXW6YQ=", hex: "CPNMUOG=" },
    { bytes: b"fooba", text: "MZXW6YTB", hex: "CPNMUOJ1" },
    { bytes: b"foobar", text: "MZXW6YTBOI======", hex: "CPNMUOJ1E8======" },
  ]

test "the RFC 4648 vector of {v.bytes} encodes and decodes" for v: Vector in rfc_4648() {
  assert_eq(encode(v.bytes), v.text);
  assert_eq(decode(v.text), Some(v.bytes));
  assert_eq(hex_encode(v.bytes), v.hex);
  assert_eq(hex_decode(v.hex), Some(v.bytes))
}

test "the RFC 4648 vector of {v.bytes} is the same letters unpadded" for v: Vector in rfc_4648() {
  assert_eq(encode_unpadded(v.bytes), unfilled(v.text));
  assert_eq(decode_unpadded(unfilled(v.text)), Some(v.bytes));
  assert_eq(hex_encode_unpadded(v.bytes), unfilled(v.hex));
  assert_eq(hex_decode_unpadded(unfilled(v.hex)), Some(v.bytes))
}

test "a decoder refuses what is not the canonical form" {
  // Lower case, a wrong length, padding in the middle or too long, a last letter that completes
  // no byte, and a last letter whose low bits are not zero.
  assert_eq(decode("mzxw6==="), None);
  assert_eq(decode("MZXW6"), None);
  assert_eq(decode("MZXW6=="), None);
  assert_eq(decode("MZ=W6==="), None);
  assert_eq(decode("MZXW6YTB========"), None);
  assert_eq(decode("MZX====="), None);
  assert_eq(decode("MZXW7==="), None);
  assert_eq(decode("MZXW1==="), None);
  // Each alphabet reads only its own letters, and an unpadded reader no padding.
  assert_eq(hex_decode("MZXW6==="), None);
  assert_eq(decode("CPNMUOJ1"), None);
  assert_eq(decode_unpadded("MZXW6==="), None);
  assert_eq(decode_unpadded("MZXW7"), None);
  assert_eq(hex_decode_unpadded("CPNMU==="), None)
}

test "a sealed text is read as a plain one is, and refused as one is" {
  let read = |text: String| decode_secret(secret_of_string(text));
  let as_typed = |text: String| decode_typed_secret(secret_of_string(text));
  assert_eq(read("MZXW6YTBOI======"), Some(secret_of_bytes(b"foobar")));
  assert_eq(read("MZXW6YQ="), Some(secret_of_bytes(b"foob")));
  assert_eq(read(""), Some(secret_of_bytes(b"")));
  assert_eq(read("mzxw6==="), None);
  assert_eq(read("MZXW6"), None);
  assert_eq(read("MZXW6=="), None);
  assert_eq(read("MZ=W6==="), None);
  assert_eq(read("MZXW6YTB========"), None);
  assert_eq(read("MZX====="), None);
  assert_eq(read("MZXW7==="), None);
  assert_eq(read("MZXW1==="), None);
  assert_eq(as_typed("mzxw 6ytb oi=="), Some(secret_of_bytes(b"foobar")));
  assert_eq(as_typed("jbsw y3dp-ehpk\t3pxp"), Some(secret_of_bytes(b"Hello!\xDE\xAD\xBE\xEF")));
  assert_eq(as_typed("=="), Some(secret_of_bytes(b"")));
  assert_eq(as_typed("MZ=W6"), None);
  assert_eq(as_typed("mzxw6 ?"), None);
  assert_eq(as_typed("MZXW7"), None)
}

test "Crockford's alphabet has no I, L, O or U, and reads only what it writes" {
  assert_eq(crockford_encode(b"\x00\x44\x32\x14\xc7"), "01234567");
  assert_eq(crockford_encode(b"\x84\x65\x3a\x56\xd7"), "GHJKMNPQ");
  assert_eq(crockford_encode(b"\xc6\x75\xbe\x77\xdf"), "RSTVWXYZ");
  assert_eq(crockford_encode(b"f"), "CR");
  assert_eq(crockford_decode("CR"), Some(b"f"));
  assert_eq(crockford_decode("cr"), None);
  assert_eq(crockford_decode("C-R"), None);
  assert_eq(crockford_decode("OI"), None);
  assert_eq(crockford_decode("UU"), None)
}

test "a typed secret is made canonical by name, never by the decoder" {
  assert_eq(normalize("jbsw y3dp-ehpk\t3pxp"), "JBSWY3DPEHPK3PXP");
  assert_eq(normalize("mzxw6==="), "MZXW6");
  assert_eq(normalize("=="), "");
  assert_eq(normalize("MZ=W6"), "MZ=W6");
  assert_eq(normalize("mzxw6 ?"), "MZXW6?");
  assert_eq(normalize("ı"), "ı");
  assert_eq(decode_unpadded(normalize("mzxw 6ytb oi==")), Some(b"foobar"));
  assert_eq(decode_unpadded("mzxw 6ytb oi=="), None);
  assert_eq(crockford_normalize("o1il-Cr"), "0111CR");
  assert_eq(crockford_decode(crockford_normalize("c-r")), Some(b"f"))
}

test "a literal's check answers the bytes, or where the text stops being canonical" {
  assert_eq(literal("MZXW6YQ="), Ok(b"foob"));
  assert_eq(literal(""), Ok(b""));
  assert_eq(literal("MZxW6YQ="), Err({ message: "base32 is written in upper case", offset: 2 }));
  assert_eq(literal("MZ1W6YQ="), Err({ message: "not a base32 letter", offset: 2 }));
  assert_eq(literal("MZ=W6YQ="), Err({ message: "not a base32 letter", offset: 2 }));
  assert_eq(
    literal("MZXW6"),
    Err({ message: "padded base32 is a multiple of eight characters", offset: 5 }),
  );
  assert_eq(literal("MZX====="), Err({ message: "the last letter completes no byte", offset: 2 }));
  assert_eq(
    literal("MZXW7==="),
    Err({ message: "the last letter leaves bits no byte holds", offset: 4 }),
  )
}

test "five bytes are at most a step either way, and nothing allocates but to grow the answer" {
  let within = |got: Int, most: Int|
    assert(got <= most, Some(int_to_string(got) ++ " is past " ++ int_to_string(most)));
  let written = |b: Bytes| metered(|| encode(b));
  let read = |b: Bytes| {
    let text = encode(b);
    metered(|| decode(text))
  };
  let short = repeat(b"\x5a\xc3\x01\xff\x10", 12);
  let long = repeat(b"\x5a\xc3\x01\xff\x10", 1036);
  within(written(long).steps - written(short).steps, 1024);
  within(read(long).steps - read(short).steps, 1024);
  within(written(long).allocations - written(short).allocations, 8);
  within(read(long).allocations - read(short).allocations, 8);
  // Thirty-two bytes end in a group short of five, which is read a letter at a time.
  let digest = repeat(b"\x5a", 32);
  within(written(digest).steps, 34);
  within(read(digest).steps, 44);
  within(written(digest).allocations, 10);
  within(read(digest).allocations, 20)
}
