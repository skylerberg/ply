//! The `cidr"10.0.0.0/8"` literal: a `std.ip` network, checked when the program is.
//!
//! A tag is a module, and `std.ip`'s own reads an address, so a network has this one. The type
//! and everything done with it are `std.ip`'s.

import std.ip (Prefix, parse_prefix, prefix_literal, render_prefix)
import std.result (result_ok)

/// What a `cidr"..."` literal is checked by: the network `std.ip`'s `parse_prefix` reads, or why
/// the text is none and the character it stops being one at.
pub fn literal(text: String) -> Result<Prefix, { message: String, offset: Int }> / {abort.raise} =
  prefix_literal(text)

// --- Tests ------------------------------------------------------------------

test "the check answers the network, or where the text stops being one" {
  assert_eq(result_ok(literal("10.0.0.0/8")), result_ok(parse_prefix("10.0.0.0/8")));
  assert_eq(
    match literal("2001:DB8::/32") { Ok(p) -> render_prefix(p), Err(_) -> "" },
    "2001:db8::/32",
  );
  assert_eq(
    literal("10.0.0.1/8"),
    Err({ message: "a bit past the prefix length is set", offset: 9 }),
  );
  assert_eq(literal("10.0.0.0"), Err({ message: "a `/` and a prefix length go here", offset: 8 }))
}
