// std.bin — a compact positional encoding, and what `derive bin for T` targets.
//
// Both ends know the type, so nothing names a field: a record is its fields in declared order, a
// variant its constructor's index and then its fields. Every value takes at least one byte, so a
// reader can refuse a count longer than the bytes left, and one value has one encoding.

// --- Errors -----------------------------------------------------------------

pub type BinError = { at: Int, message: String }

pub fn error_to_string(e: BinError) -> String =
  e.message ++ " (at byte " ++ int_to_string(e.at) ++ ")"

fn short(at: Int) -> BinError = { at: at, message: "the bytes end inside a value" }

fn refused(at: Int, message: String) -> BinError = { at: at, message: message }

// --- Codecs -----------------------------------------------------------------

pub type Taken<a> = { value: a, at: Int }

// `shape` digests the type's structure, names included, so bytes written under another
// definition of a type are told apart from its own.
pub type BinCodec<a> = {
  put: (Bytes, a) -> Bytes,
  take: (Bytes, Int) -> Result<Taken<a>, BinError>,
  shape: Shape,
}

// The deepest a derived codec over a recursive type nests, which is as deep as calls nest.
pub fn max_depth() -> Int = 10000

// A derived codec over a recursive type, past `max_depth` levels of it.
pub fn too_deep<a>() -> BinCodec<a> =
  {
    put: |_w: Bytes, _x: a| panic(nested_too_deep()),
    take: |_d: Bytes, at: Int| Err(refused(at, nested_too_deep())),
    shape: |_s: Shapes| panic(nested_too_deep()),
  }

fn nested_too_deep() -> String = "nested deeper than " ++ int_to_string(max_depth()) ++ " levels"

// --- Varints ----------------------------------------------------------------

// Seven bits a byte, low first, the high bit set on every byte but the last; `n` is read as its
// 64 unsigned bits.
// A negative value's first shift leaves it non-negative, and from there each shift lowers it.
pub fn put_varint(w: Bytes, n: Int) -> Bytes =
  if n >= 0 { unsigned_varint(w, n) }
  else { unsigned_varint(w ++ byte_of_int(n & 127 | 128), n >>> 7) }

fn unsigned_varint(w: Bytes, n: Int) -> Bytes =
  if n < 128 { w ++ byte_of_int(n) }
  else { unsigned_varint(w ++ byte_of_int(n & 127 | 128), n >>> 7) }

pub fn take_varint(d: Bytes, at: Int) -> Result<Taken<Int>, BinError> = {
  let b = byte_at(d, at);
  if b >= 0 && b < 128 { Ok({ value: b, at: at + 1 }) } else { varint_from(d, at, at, 0, 0) }
}

fn byte_at(d: Bytes, at: Int) -> Int = if at < bytes_len(d) { bytes_at(d, at) } else { 0 - 1 }

fn varint_from(
  d: Bytes,
  start: Int,
  at: Int,
  shift: Int,
  acc: Int,
) -> Result<Taken<Int>, BinError> = {
  if at >= bytes_len(d) { Err(short(at)) } else {
    let b = bytes_at(d, at);
    if shift == 63 && b > 1 { Err(refused(start, "a varint wider than 64 bits")) } else if b < 128 {
      if b == 0 && shift > 0 { Err(refused(start, "a varint with a redundant last byte")) }
      else { Ok({ value: acc | b << shift, at: at + 1 }) }
    } else { varint_from(d, start, at + 1, shift + 7, acc | (b & 127) << shift) }
  }
}

fn zig(n: Int) -> Int = n << 1 ^ n >> 63

fn unzig(z: Int) -> Int = z >>> 1 ^ 0 - (z & 1)

// A varint that must lie in `lo..=hi`.
fn take_ranged(d: Bytes, at: Int, lo: Int, hi: Int, what: String) -> Result<Taken<Int>, BinError> =
  match take_varint(d, at) {
    Err(e) -> Err(e),
    Ok(t) -> if t.value < lo || t.value > hi { Err(refused(at, "a varint outside " ++ what)) }
    else { t_ok(t.value, t.at) },
  }

fn take_zigzag(d: Bytes, at: Int, lo: Int, hi: Int, what: String) -> Result<Taken<Int>, BinError> =
  match take_varint(d, at) {
    Err(e) -> Err(e),
    Ok(t) -> {
      let n = unzig(t.value);
      if n < lo || n > hi { Err(refused(at, "a varint outside " ++ what)) } else { t_ok(n, t.at) }
    },
  }

fn t_ok<a>(value: a, at: Int) -> Result<Taken<a>, BinError> = Ok({ value: value, at: at })

// A count of what follows: each takes at least a byte, so a count past the bytes left is refused.
pub fn take_count(d: Bytes, at: Int) -> Result<Taken<Int>, BinError> =
  match take_varint(d, at) {
    Err(e) -> Err(e),
    Ok(t) -> if t.value < 0 || t.value > bytes_len(d) - t.at {
      Err(refused(at, "a count longer than the bytes left"))
    } else { Ok(t) },
  }

pub fn put_tag(w: Bytes, index: Int) -> Bytes = put_varint(w, index)

// The constructor index of a type with `count` constructors.
pub fn take_tag(d: Bytes, at: Int, count: Int) -> Result<Taken<Int>, BinError> =
  match take_varint(d, at) {
    Err(e) -> Err(e),
    Ok(t) -> if t.value < 0 || t.value >= count {
      Err(
        refused(
          at,
          "constructor " ++ int_to_string(t.value) ++ " of a type with " ++ int_to_string(count),
        ),
      )
    } else { Ok(t) },
  }

// --- Scalars ----------------------------------------------------------------

pub fn put_unit(w: Bytes, u: Unit) -> Bytes = w ++ byte_of_int(0)

pub fn take_unit(d: Bytes, at: Int) -> Result<Taken<Unit>, BinError> = {
  let b = byte_at(d, at);
  if b == 0 { t_ok((), at + 1) }
  else if b < 0 { Err(short(at)) }
  else { Err(refused(at, "a unit is the byte 0")) }
}

pub fn put_bool(w: Bytes, b: Bool) -> Bytes = w ++ byte_of_int(if b { 1 } else { 0 })

pub fn take_bool(d: Bytes, at: Int) -> Result<Taken<Bool>, BinError> = {
  let b = byte_at(d, at);
  if b == 0 { t_ok(false, at + 1) }
  else if b == 1 { t_ok(true, at + 1) }
  else if b < 0 { Err(short(at)) }
  else { Err(refused(at, "a boolean is the byte 0 or 1")) }
}

pub fn put_int(w: Bytes, n: Int) -> Bytes = put_varint(w, zig(n))

pub fn take_int(d: Bytes, at: Int) -> Result<Taken<Int>, BinError> = {
  let b = byte_at(d, at);
  if b >= 0 && b < 128 { Ok({ value: unzig(b), at: at + 1 }) } else {
    match varint_from(d, at, at, 0, 0) { Err(e) -> Err(e), Ok(t) -> t_ok(unzig(t.value), t.at) }
  }
}

// The IEEE-754 bits, little-endian, so every `NaN` keeps its payload.
pub fn put_float(w: Bytes, f: Float) -> Bytes = {
  let n = bits_of_float(f);
  bytes_concat_all([
    w,
    byte_of_int(n & 255),
    byte_of_int(n >>> 8 & 255),
    byte_of_int(n >>> 16 & 255),
    byte_of_int(n >>> 24 & 255),
    byte_of_int(n >>> 32 & 255),
    byte_of_int(n >>> 40 & 255),
    byte_of_int(n >>> 48 & 255),
    byte_of_int(n >>> 56 & 255),
  ])
}

pub fn take_float(d: Bytes, at: Int) -> Result<Taken<Float>, BinError> =
  if at + 8 > bytes_len(d) { Err(short(at)) } else {
    let low = int_of_u32(bytes_u32_le(d, at));
    let high = int_of_u32(bytes_u32_le(d, at + 4));
    t_ok(float_of_bits(low | high << 32), at + 8)
  }

pub fn put_bytes(w: Bytes, b: Bytes) -> Bytes = put_varint(w, bytes_len(b)) ++ b

// A length under 128 is one byte, which most are: read it in place.
pub fn take_bytes(d: Bytes, at: Int) -> Result<Taken<Bytes>, BinError> = {
  let n = byte_at(d, at);
  if n >= 0 && n < 128 && n <= bytes_len(d) - at - 1 {
    Ok({ value: bytes_slice(d, at + 1, at + 1 + n), at: at + 1 + n })
  } else {
    match take_count(d, at) {
      Err(e) -> Err(e),
      Ok(c) -> t_ok(bytes_slice(d, c.at, c.at + c.value), c.at + c.value),
    }
  }
}

pub fn put_string(w: Bytes, s: String) -> Bytes = put_bytes(w, bytes_of_string(s))

pub fn take_string(d: Bytes, at: Int) -> Result<Taken<String>, BinError> =
  match take_bytes(d, at) {
    Err(e) -> Err(e),
    Ok(t) -> if bytes_is_utf8(t.value) { t_ok(string_of_bytes(t.value), t.at) }
    else { Err(refused(at, "a string that is not UTF-8")) },
  }

// The decimal text, which keeps the scale: `1.50` reads back as `1.50`.
pub fn put_decimal(w: Bytes, d: Decimal) -> Bytes = put_string(w, decimal_to_string(d))

pub fn take_decimal(d: Bytes, at: Int) -> Result<Taken<Decimal>, BinError> =
  match take_string(d, at) {
    Err(e) -> Err(e),
    Ok(t) -> match decimal_of_string(t.value) {
      Some(x) -> t_ok(x, t.at),
      None -> Err(refused(at, "`" ++ t.value ++ "` is not a decimal")),
    },
  }

// --- Fixed widths -----------------------------------------------------------

// A byte holds the eight-bit widths whole; the rest are varints, zigzagged when signed.
pub fn put_char(w: Bytes, c: Char) -> Bytes = put_varint(w, int_of_char(c))

pub fn take_char(d: Bytes, at: Int) -> Result<Taken<Char>, BinError> =
  match take_varint(d, at) {
    Err(e) -> Err(e),
    Ok(t) -> match char_of_int(t.value) {
      Some(c) -> t_ok(c, t.at),
      None -> Err(refused(at, "a varint that is no Unicode scalar value")),
    },
  }

pub fn put_u8(w: Bytes, n: U8) -> Bytes = w ++ byte_of_int(int_of_u8(n))

pub fn take_u8(d: Bytes, at: Int) -> Result<Taken<U8>, BinError> = {
  let b = byte_at(d, at);
  if b < 0 { Err(short(at)) } else { t_ok(u8_of_int(b), at + 1) }
}

pub fn put_i8(w: Bytes, n: I8) -> Bytes = w ++ byte_of_int(int_of_i8(n) & 255)

pub fn take_i8(d: Bytes, at: Int) -> Result<Taken<I8>, BinError> = {
  let b = byte_at(d, at);
  if b < 0 { Err(short(at)) } else { t_ok(i8_of_int(if b > 127 { b - 256 } else { b }), at + 1) }
}

pub fn put_u16(w: Bytes, n: U16) -> Bytes = put_varint(w, int_of_u16(n))

pub fn take_u16(d: Bytes, at: Int) -> Result<Taken<U16>, BinError> =
  match take_ranged(d, at, 0, 65535, "`U16`") {
    Err(e) -> Err(e),
    Ok(t) -> t_ok(u16_of_int(t.value), t.at),
  }

pub fn put_u32(w: Bytes, n: U32) -> Bytes = put_varint(w, int_of_u32(n))

pub fn take_u32(d: Bytes, at: Int) -> Result<Taken<U32>, BinError> =
  match take_ranged(d, at, 0, 4294967295, "`U32`") {
    Err(e) -> Err(e),
    Ok(t) -> t_ok(u32_of_int(t.value), t.at),
  }

// A `U64` is the 64 bits a varint carries, moved through an `Int` in two halves.
pub fn put_u64(w: Bytes, n: U64) -> Bytes =
  put_varint(w, int_of_u64(n >>> 32) << 32 | int_of_u64(n & 0xFFFF_FFFFu64))

pub fn take_u64(d: Bytes, at: Int) -> Result<Taken<U64>, BinError> =
  match take_varint(d, at) {
    Err(e) -> Err(e),
    Ok(t) -> t_ok(u64_of_int(t.value >>> 32) << 32 | u64_of_int(t.value & 0xFFFF_FFFF), t.at),
  }

pub fn put_i16(w: Bytes, n: I16) -> Bytes = put_varint(w, zig(int_of_i16(n)))

pub fn take_i16(d: Bytes, at: Int) -> Result<Taken<I16>, BinError> =
  match take_zigzag(d, at, 0 - 32768, 32767, "`I16`") {
    Err(e) -> Err(e),
    Ok(t) -> t_ok(i16_of_int(t.value), t.at),
  }

pub fn put_i32(w: Bytes, n: I32) -> Bytes = put_varint(w, zig(int_of_i32(n)))

pub fn take_i32(d: Bytes, at: Int) -> Result<Taken<I32>, BinError> =
  match take_zigzag(d, at, 0 - 2147483648, 2147483647, "`I32`") {
    Err(e) -> Err(e),
    Ok(t) -> t_ok(i32_of_int(t.value), t.at),
  }

pub fn put_i64(w: Bytes, n: I64) -> Bytes = put_int(w, int_of_i64(n))

pub fn take_i64(d: Bytes, at: Int) -> Result<Taken<I64>, BinError> =
  match take_int(d, at) { Err(e) -> Err(e), Ok(t) -> t_ok(i64_of_int(t.value), t.at) }

pub fn put_u128(w: Bytes, n: U128) -> Bytes =
  if n < 128u128 { w ++ byte_of_int(int_of_u128(n)) }
  else { put_u128(w ++ byte_of_int(int_of_u128(n & 127u128) | 128), n >>> 7) }

pub fn take_u128(d: Bytes, at: Int) -> Result<Taken<U128>, BinError> =
  u128_from(d, at, at, 0, 0u128)

fn u128_from(
  d: Bytes,
  start: Int,
  at: Int,
  shift: Int,
  acc: U128,
) -> Result<Taken<U128>, BinError> = {
  if at >= bytes_len(d) { Err(short(at)) } else {
    let b = bytes_at(d, at);
    if shift == 126 && b > 3 { Err(refused(start, "a varint wider than 128 bits")) }
    else if b < 128 {
      if b == 0 && shift > 0 { Err(refused(start, "a varint with a redundant last byte")) }
      else { t_ok(acc | u128_of_int(b) << shift, at + 1) }
    } else { u128_from(d, start, at + 1, shift + 7, acc | u128_of_int(b & 127) << shift) }
  }
}

// Zigzagged in its own width, then written as its 128 unsigned bits.
pub fn put_i128(w: Bytes, n: I128) -> Bytes = i128_bits(w, n << 1 ^ n >> 127)

fn i128_bits(w: Bytes, z: I128) -> Bytes =
  if z >= 0i128 { unsigned_i128_bits(w, z) }
  else { unsigned_i128_bits(w ++ byte_of_int(int_of_i128(z & 127i128) | 128), z >>> 7) }

fn unsigned_i128_bits(w: Bytes, z: I128) -> Bytes =
  if z < 128i128 { w ++ byte_of_int(int_of_i128(z)) }
  else { unsigned_i128_bits(w ++ byte_of_int(int_of_i128(z & 127i128) | 128), z >>> 7) }

pub fn take_i128(d: Bytes, at: Int) -> Result<Taken<I128>, BinError> =
  i128_from(d, at, at, 0, 0i128)

fn i128_from(
  d: Bytes,
  start: Int,
  at: Int,
  shift: Int,
  acc: I128,
) -> Result<Taken<I128>, BinError> = {
  if at >= bytes_len(d) { Err(short(at)) } else {
    let b = bytes_at(d, at);
    if shift == 126 && b > 3 { Err(refused(start, "a varint wider than 128 bits")) }
    else if b < 128 {
      if b == 0 && shift > 0 { Err(refused(start, "a varint with a redundant last byte")) } else {
        let z = acc | i128_of_int(b) << shift;
        t_ok(z >>> 1 ^ 0i128 - (z & 1i128), at + 1)
      }
    } else { i128_from(d, start, at + 1, shift + 7, acc | i128_of_int(b & 127) << shift) }
  }
}

// --- Shapes -----------------------------------------------------------------

// A digest per sum type finished, and the sum types the walk is inside, which a reference back
// names instead of re-entering.
pub type Shapes = { done: Map<Bytes, Bytes>, open: List<Bytes> }
pub type Shaped = { digest: Bytes, shapes: Shapes }
pub type Shape = (Shapes) -> Shaped
pub type FieldShape = { name: String, shape: Shape }
pub type VariantShape = { name: String, fields: List<Shape> }

type Digests = { digests: List<Bytes>, shapes: Shapes }

fn named(name: String) -> Bytes = put_bytes(b"", bytes_of_string(name))

fn digests_of(s: Shapes, shapes: List<Shape>) -> Digests =
  fold(shapes, { digests: [], shapes: s }, |acc: Digests, f: Shape| {
    let r = f(acc.shapes);
    { digests: push(acc.digests, r.digest), shapes: r.shapes }
  })

fn digest(kind: Int, parts: List<Bytes>) -> Bytes =
  bytes_blake3(bytes_concat_all([byte_of_int(kind), bytes_concat_all(parts)]))

pub fn leaf_shape(name: String) -> Shape =
  |s: Shapes| { digest: digest(1, [named(name)]), shapes: s }

// A type the language declares, applied to its arguments.
pub fn applied_shape(s: Shapes, name: String, args: List<Shape>) -> Shaped = {
  let a = digests_of(s, args);
  {
    digest: digest(2, [named(name), put_varint(b"", len(args)), bytes_concat_all(a.digests)]),
    shapes: a.shapes,
  }
}

pub fn record_shape(s: Shapes, fields: List<FieldShape>) -> Shaped = {
  let walked = fold(fields, { digests: [], shapes: s }, |acc: Digests, f: FieldShape| {
    let r = (f.shape)(acc.shapes);
    { digests: push(acc.digests, named(f.name) ++ r.digest), shapes: r.shapes }
  });
  {
    digest: digest(3, [put_varint(b"", len(fields)), bytes_concat_all(walked.digests)]),
    shapes: walked.shapes,
  }
}

// `key` tells apart two sums that share a simple name; only `name` enters the digest, so moving a
// module leaves its shapes alone.
pub fn sum_shape(
  s: Shapes,
  key: String,
  name: String,
  args: List<Shape>,
  variants: List<VariantShape>,
) -> Shaped = {
  let a = digests_of(s, args);
  let head = bytes_concat_all([
    named(name),
    put_varint(b"", len(args)),
    bytes_concat_all(a.digests),
  ]);
  let k = named(key) ++ head;
  match map_get(a.shapes.done, k) {
    Some(d) -> { digest: d, shapes: a.shapes },
    None -> if fold(a.shapes.open, false, |seen: Bool, o: Bytes| seen || o == k) {
      { digest: digest(5, [head]), shapes: a.shapes }
    } else {
      let inside = { done: a.shapes.done, open: push(a.shapes.open, k) };
      let walked = fold(
        variants,
        { digests: [], shapes: inside },
        |acc: Digests, v: VariantShape| {
          let f = digests_of(acc.shapes, v.fields);
          {
            digests: push(
              acc.digests,
              bytes_concat_all([
                named(v.name),
                put_varint(b"", len(v.fields)),
                bytes_concat_all(f.digests),
              ]),
            ),
            shapes: f.shapes,
          }
        },
      );
      let d = digest(4, [head, put_varint(b"", len(variants)), bytes_concat_all(walked.digests)]);
      { digest: d, shapes: { done: map_insert(walked.shapes.done, k, d), open: a.shapes.open } }
    },
  }
}

// --- Scalar codecs ----------------------------------------------------------

pub fn unit_bin() -> BinCodec<Unit> = { put: put_unit, take: take_unit, shape: leaf_shape("Unit") }
pub fn bool_bin() -> BinCodec<Bool> = { put: put_bool, take: take_bool, shape: leaf_shape("Bool") }
pub fn int_bin() -> BinCodec<Int> = { put: put_int, take: take_int, shape: leaf_shape("Int") }

pub fn float_bin() -> BinCodec<Float> =
  { put: put_float, take: take_float, shape: leaf_shape("Float") }

pub fn decimal_bin() -> BinCodec<Decimal> =
  { put: put_decimal, take: take_decimal, shape: leaf_shape("Decimal") }

pub fn string_bin() -> BinCodec<String> =
  { put: put_string, take: take_string, shape: leaf_shape("String") }

pub fn bytes_bin() -> BinCodec<Bytes> =
  { put: put_bytes, take: take_bytes, shape: leaf_shape("Bytes") }

pub fn char_bin() -> BinCodec<Char> = { put: put_char, take: take_char, shape: leaf_shape("Char") }

pub fn u8_bin() -> BinCodec<U8> = { put: put_u8, take: take_u8, shape: leaf_shape("U8") }
pub fn u16_bin() -> BinCodec<U16> = { put: put_u16, take: take_u16, shape: leaf_shape("U16") }
pub fn u32_bin() -> BinCodec<U32> = { put: put_u32, take: take_u32, shape: leaf_shape("U32") }
pub fn u64_bin() -> BinCodec<U64> = { put: put_u64, take: take_u64, shape: leaf_shape("U64") }
pub fn u128_bin() -> BinCodec<U128> = { put: put_u128, take: take_u128, shape: leaf_shape("U128") }
pub fn i8_bin() -> BinCodec<I8> = { put: put_i8, take: take_i8, shape: leaf_shape("I8") }
pub fn i16_bin() -> BinCodec<I16> = { put: put_i16, take: take_i16, shape: leaf_shape("I16") }
pub fn i32_bin() -> BinCodec<I32> = { put: put_i32, take: take_i32, shape: leaf_shape("I32") }
pub fn i64_bin() -> BinCodec<I64> = { put: put_i64, take: take_i64, shape: leaf_shape("I64") }
pub fn i128_bin() -> BinCodec<I128> = { put: put_i128, take: take_i128, shape: leaf_shape("I128") }

// --- Structural codecs ------------------------------------------------------

pub fn list_bin<a>(item: BinCodec<a>) -> BinCodec<List<a>> =
  {
    put: |w: Bytes, xs: List<a>| fold(xs, put_varint(w, len(xs)), item.put),
    take: |d: Bytes, at: Int|
      match take_count(d, at) {
        Err(e) -> Err(e),
        Ok(n) -> take_items(d, n.at, n.value, item.take, []),
      },
    shape: |s: Shapes| applied_shape(s, "List", [item.shape]),
  }

// An array is written as a list is, under a shape of its own, so turning one into the other moves
// the shape's digest.
pub fn array_bin<a>(item: BinCodec<a>) -> BinCodec<Array<a>> = {
  let items = list_bin(item);
  {
    put: |w: Bytes, xs: Array<a>| (items.put)(w, array_to_list(xs)),
    take: |d: Bytes, at: Int|
      match (items.take)(d, at) {
        Ok(t) -> Ok({ value: array_of_list(t.value), at: t.at }),
        Err(e) -> Err(e),
      },
    shape: |s: Shapes| applied_shape(s, "Array", [item.shape]),
  }
}

fn take_items<a>(
  d: Bytes,
  at: Int,
  left: Int,
  take: (Bytes, Int) -> Result<Taken<a>, BinError>,
  acc: List<a>,
) -> Result<Taken<List<a>>, BinError> =
  if left <= 0 { t_ok(acc, at) } else {
    match take(d, at) {
      Err(e) -> Err(e),
      Ok(t) -> take_items(d, t.at, left - 1, take, push(acc, t.value)),
    }
  }

// Entries in key order; a reader refuses keys out of order, so a map has one encoding.
pub fn map_bin<k, v>(key: BinCodec<k>, value: BinCodec<v>) -> BinCodec<Map<k, v>>
  where derivable(ord, k)
=
  {
    put: |w: Bytes, m: Map<k, v>|
      map_fold(m, put_varint(w, map_len(m)), |acc: Bytes, x: k, y: v|
        (value.put)((key.put)(acc, x), y)),
    take: |d: Bytes, at: Int|
      match take_count(d, at) {
        Err(e) -> Err(e),
        Ok(n) -> take_entries(d, n.at, n.value, key, value, None, map_new()),
      },
    shape: |s: Shapes| applied_shape(s, "Map", [key.shape, value.shape]),
  }

fn take_entries<k, v>(
  d: Bytes,
  at: Int,
  left: Int,
  key: BinCodec<k>,
  value: BinCodec<v>,
  last: Option<k>,
  acc: Map<k, v>,
) -> Result<Taken<Map<k, v>>, BinError>
  where derivable(ord, k)
=
  if left <= 0 { t_ok(acc, at) } else {
    match (key.take)(d, at) {
      Err(e) -> Err(e),
      Ok(x) -> {
        let ordered = match last { None -> true, Some(l) -> compare_values(l, x.value) == Less };
        if !ordered { Err(refused(at, "a map key out of order")) } else {
          match (value.take)(d, x.at) {
            Err(e) -> Err(e),
            Ok(y) ->
              take_entries(
                d,
                y.at,
                left - 1,
                key,
                value,
                Some(x.value),
                map_insert(acc, x.value, y.value),
              ),
          }
        }
      },
    }
  }

pub fn option_bin<a>(item: BinCodec<a>) -> BinCodec<Option<a>> =
  {
    put: |w: Bytes, o: Option<a>|
      match o { None -> put_tag(w, 0), Some(x) -> (item.put)(put_tag(w, 1), x) },
    take: |d: Bytes, at: Int|
      match take_tag(d, at, 2) {
        Err(e) -> Err(e),
        Ok(t) -> if t.value == 0 { t_ok(None, t.at) } else {
          match (item.take)(d, t.at) { Err(e) -> Err(e), Ok(x) -> t_ok(Some(x.value), x.at) }
        },
      },
    shape: |s: Shapes| applied_shape(s, "Option", [item.shape]),
  }

pub fn result_bin<a, b>(ok: BinCodec<a>, err: BinCodec<b>) -> BinCodec<Result<a, b>> =
  {
    put: |w: Bytes, r: Result<a, b>|
      match r { Ok(x) -> (ok.put)(put_tag(w, 0), x), Err(x) -> (err.put)(put_tag(w, 1), x) },
    take: |d: Bytes, at: Int|
      match take_tag(d, at, 2) {
        Err(e) -> Err(e),
        Ok(t) -> if t.value == 0 {
          match (ok.take)(d, t.at) { Err(e) -> Err(e), Ok(x) -> t_ok(Ok(x.value), x.at) }
        } else {
          match (err.take)(d, t.at) { Err(e) -> Err(e), Ok(x) -> t_ok(Err(x.value), x.at) }
        },
      },
    shape: |s: Shapes| applied_shape(s, "Result", [ok.shape, err.shape]),
  }

pub fn iter_bin<a, b>(more: BinCodec<a>, done: BinCodec<b>) -> BinCodec<Iter<a, b>> =
  {
    put: |w: Bytes, i: Iter<a, b>|
      match i {
        Continue(x) -> (more.put)(put_tag(w, 0), x),
        Stop(x) -> (done.put)(put_tag(w, 1), x),
      },
    take: |d: Bytes, at: Int|
      match take_tag(d, at, 2) {
        Err(e) -> Err(e),
        Ok(t) -> if t.value == 0 {
          match (more.take)(d, t.at) { Err(e) -> Err(e), Ok(x) -> t_ok(Continue(x.value), x.at) }
        } else {
          match (done.take)(d, t.at) { Err(e) -> Err(e), Ok(x) -> t_ok(Stop(x.value), x.at) }
        },
      },
    shape: |s: Shapes| applied_shape(s, "Iter", [more.shape, done.shape]),
  }

// An `Instant` and a `Duration` are their nanoseconds.
pub fn instant_bin() -> BinCodec<Instant> =
  {
    put: |w: Bytes, t: Instant| match t { Instant(n) -> put_int(w, n) },
    take: |d: Bytes, at: Int|
      match take_int(d, at) { Err(e) -> Err(e), Ok(t) -> t_ok(Instant(t.value), t.at) },
    shape: |s: Shapes| applied_shape(s, "Instant", []),
  }

pub fn duration_bin() -> BinCodec<Duration> =
  {
    put: |w: Bytes, t: Duration| match t { Duration(n) -> put_int(w, n) },
    take: |d: Bytes, at: Int|
      match take_int(d, at) { Err(e) -> Err(e), Ok(t) -> t_ok(Duration(t.value), t.at) },
    shape: |s: Shapes| applied_shape(s, "Duration", []),
  }

pub fn ordering_bin() -> BinCodec<Ordering> =
  {
    put: |w: Bytes, o: Ordering| put_tag(w, match o { Less -> 0, Equal -> 1, Greater -> 2 }),
    take: |d: Bytes, at: Int|
      match take_tag(d, at, 3) {
        Err(e) -> Err(e),
        Ok(t) -> t_ok(match t.value { 0 -> Less, 1 -> Equal, _ -> Greater }, t.at),
      },
    shape: |s: Shapes| applied_shape(s, "Ordering", []),
  }

pub fn rounding_bin() -> BinCodec<Rounding> =
  {
    put: |w: Bytes, r: Rounding|
      put_tag(w, match r {
        HalfEven -> 0,
        HalfUp -> 1,
        Down -> 2,
        Up -> 3,
        Ceiling -> 4,
        Floor -> 5,
      }),
    take: |d: Bytes, at: Int|
      match take_tag(d, at, 6) {
        Err(e) -> Err(e),
        Ok(t) ->
          t_ok(
            match t.value {
              0 -> HalfEven,
              1 -> HalfUp,
              2 -> Down,
              3 -> Up,
              4 -> Ceiling,
              _ -> Floor,
            },
            t.at,
          ),
      },
    shape: |s: Shapes| applied_shape(s, "Rounding", []),
  }

// --- The two ends together --------------------------------------------------

pub fn encode<a>(x: a, codec: BinCodec<a>) -> Bytes = (codec.put)(b"", x)

// Refuses bytes left over after the value as well as bytes that end inside it.
pub fn decode<a>(data: Bytes, codec: BinCodec<a>) -> Result<a, BinError> =
  match (codec.take)(data, 0) {
    Err(e) -> Err(e),
    Ok(t) -> if t.at == bytes_len(data) { Ok(t.value) }
    else { Err(refused(t.at, "bytes follow the value")) },
  }

// The 32-byte digest of the codec's type: equal for two codecs of one definition, and different
// once a field, a constructor, a name or an order changes anywhere the type reaches.
pub fn shape_digest<a>(codec: BinCodec<a>) -> Bytes =
  (codec.shape)({ done: map_new(), open: [] }).digest

// --- Tests ------------------------------------------------------------------

fn round<a>(x: a, codec: BinCodec<a>) -> Bool = decode(encode(x, codec), codec) == Ok(x)

test "a varint is seven bits a byte, low first, and the widest Int takes ten" {
  assert_eq(encode(0, int_bin()), b"\x00");
  assert_eq(encode(0 - 1, int_bin()), b"\x01");
  assert_eq(encode(1, int_bin()), b"\x02");
  assert_eq(encode(64, int_bin()), b"\x80\x01");
  assert_eq(bytes_len(encode(9223372036854775807, int_bin())), 10);
  assert(round(9223372036854775807, int_bin()));
  assert(round(0 - 9223372036854775807 - 1, int_bin()));
  assert_eq(put_varint(b"", 300), b"\xac\x02")
}

test "every scalar round-trips, and a NaN keeps its bits" {
  assert(round((), unit_bin()));
  assert(round(true, bool_bin()) && round(false, bool_bin()));
  assert(round("héllo", string_bin()));
  assert(round(b"\x00\xff", bytes_bin()));
  assert(round(1.5, float_bin()) && round(0.0 - 2.5, float_bin()));
  let nan = float_of_bits(0x7FF8_0000_0000_0001);
  match decode(encode(nan, float_bin()), float_bin()) {
    Ok(f) -> assert_eq(bits_of_float(f), bits_of_float(nan)),
    Err(e) -> assert(false),
  };
  assert_eq(
    decimal_to_string(match decode(encode(1.50m, decimal_bin()), decimal_bin()) {
      Ok(d) -> d,
      Err(e) -> decimal_of_int(0),
    }),
    "1.50",
  )
}

test "every fixed width round-trips at both ends of its range" {
  assert(round(0u8, u8_bin()) && round(255u8, u8_bin()));
  assert(round(i8_of_int(0 - 128), i8_bin()) && round(127i8, i8_bin()));
  assert(round(65535u16, u16_bin()) && round(4294967295u32, u32_bin()));
  assert(round(0xFFFF_FFFF_FFFF_FFFFu64, u64_bin()) && round(0u64, u64_bin()));
  assert(round(i16_of_int(0 - 32768), i16_bin()) && round(2147483647i32, i32_bin()));
  assert(round(i64_of_int(0 - 9223372036854775807 - 1), i64_bin()));
  let top = match u128_of_string("340282366920938463463374607431768211455") {
    Some(n) -> n,
    None -> 0u128,
  };
  assert(round(top, u128_bin()) && round(0u128, u128_bin()));
  assert_eq(bytes_len(encode(top, u128_bin())), 19);
  let least = match i128_of_string("-170141183460469231731687303715884105728") {
    Some(n) -> n,
    None -> 0i128,
  };
  assert(round(least, i128_bin()) && round(0i128 - (least + 1i128), i128_bin()));
  assert(round(0i128 - 1i128, i128_bin()))
}

test "lists, maps, options, results and the declared sums round-trip" {
  assert(round([1, 2, 3], list_bin(int_bin())));
  assert(round([(), ()], list_bin(unit_bin())));
  assert(
    round(map_insert(map_insert(map_new(), "b", 2), "a", 1), map_bin(string_bin(), int_bin())),
  );
  assert(round(Some(Some(())), option_bin(option_bin(unit_bin()))));
  assert(round(None, option_bin(int_bin())));
  assert(round(Err("no"), result_bin(int_bin(), string_bin())));
  assert(round(Stop(3), iter_bin(string_bin(), int_bin())));
  assert(round(Greater, ordering_bin()) && round(Floor, rounding_bin()))
}

test "an array is written as a list is, and its shape is its own" {
  assert(round(array_of_list([1, 2, 3]), array_bin(int_bin())));
  assert(round(array_new(0, ()), array_bin(unit_bin())));
  assert_eq(encode(array_of_list([7]), array_bin(int_bin())), encode([7], list_bin(int_bin())));
  assert(shape_digest(array_bin(int_bin())) != shape_digest(list_bin(int_bin())))
}

test "a character is its scalar value, and a number that is none is refused" {
  assert_eq(encode('a', char_bin()), b"a");
  assert(round('\u{1F600}', char_bin()) && round('\u{0}', char_bin()));
  assert(round(['h', 'é'], list_bin(char_bin())));
  assert_eq(
    decode(put_varint(b"", 55296), char_bin()),
    Err({ at: 0, message: "a varint that is no Unicode scalar value" }),
  );
  assert(decode(put_varint(b"", 1114112), char_bin()) != Ok('a'))
}

test "an instant and a duration are their nanoseconds, and neither reads as the other" {
  assert(round(Instant(0 - 5), instant_bin()) && round(Duration(1_000_000_000), duration_bin()));
  assert_eq(encode(Duration(1), duration_bin()), encode(1, int_bin()));
  assert(shape_digest(instant_bin()) != shape_digest(duration_bin()));
  assert(shape_digest(duration_bin()) != shape_digest(int_bin()))
}

test "a reader refuses bytes that end early, bytes left over and bytes no value writes" {
  let c = list_bin(int_bin());
  let full = encode([1, 2, 3], c);
  assert_eq(decode(b"\x80", int_bin()), Err({ at: 1, message: "the bytes end inside a value" }));
  assert_eq(
    decode(bytes_slice(full, 0, 3), c),
    Err({ at: 0, message: "a count longer than the bytes left" }),
  );
  assert_eq(decode(full ++ b"\x00", c), Err({ at: 4, message: "bytes follow the value" }));
  assert(decode(b"\x02", bool_bin()) != Ok(true));
  assert(decode(b"\x80\x00", int_bin()) != Ok(0));
  assert(decode(b"\xff\xff\xff\xff\xff\xff\xff\xff\xff\x02", int_bin()) != Ok(0));
  assert(decode(b"\x01\xff", string_bin()) != Ok(""));
  assert(decode(b"\x05", list_bin(unit_bin())) != Ok([]));
  assert(decode(b"\x03", ordering_bin()) != Ok(Less));
  assert(decode(b"\x02\x02\x00\x00\x00", map_bin(int_bin(), unit_bin())) != Ok(map_new()));
  assert(decode(b"\x80\x02", u8_bin()) != Ok(0u8));
  assert(decode(b"\x80\x80\x04", u16_bin()) != Ok(0u16))
}

test "a shape tells types apart by structure and by name, and a recursive one finishes" {
  assert_eq(bytes_len(shape_digest(int_bin())), 32);
  assert(shape_digest(int_bin()) != shape_digest(i64_bin()));
  assert(shape_digest(list_bin(int_bin())) != shape_digest(option_bin(int_bin())));
  assert_eq(shape_digest(list_bin(int_bin())), shape_digest(list_bin(int_bin())));
  let a: Shape = |s: Shapes| record_shape(s, [{ name: "a", shape: int_bin().shape }]);
  let b: Shape = |s: Shapes| record_shape(s, [{ name: "b", shape: int_bin().shape }]);
  assert(a({ done: map_new(), open: [] }).digest != b({ done: map_new(), open: [] }).digest);
  assert(shape_digest(tree()) != shape_digest(list_bin(tree())))
}

// A hand-written recursive codec, as `derive bin` writes one: the shape names the type again.
fn tree() -> BinCodec<List<Int>> = tree_at(max_depth())

fn tree_at(depth: Int) -> BinCodec<List<Int>> =
  if depth <= 0 { too_deep() } else {
    {
      put: |w: Bytes, xs: List<Int>| w,
      take: |d: Bytes, at: Int| t_ok([], at),
      shape: |s: Shapes|
        sum_shape(s, "t.Tree", "Tree", [], [
          { name: "Leaf", fields: [] },
          { name: "Node", fields: [tree_at(depth - 1).shape, tree_at(depth - 1).shape] },
        ]),
    }
  }

// --- Laws -------------------------------------------------------------------

law "an Int's decode undoes its encode" forall (n: Int) { round(n, int_bin()) }

law "a list of strings survives the round trip"
  forall (xs: List<String>) {
    round(xs, list_bin(string_bin()))
  }
