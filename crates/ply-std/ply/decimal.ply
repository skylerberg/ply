//! A `Decimal`'s parts. The prelude computes with one; this says what it is made of: how many digits
//! follow its point, the same value without trailing zeros, its whole and fractional parts, and the
//! value a mantissa and a scale name.
//!
//! A `Decimal` keeps the scale it was written or computed at, so `1.5m` and `1.50m` are equal and print
//! differently: `scale` reads the one it holds. A quotient (`decimal_div`), a rounding
//! (`decimal_round`) and `of_parts` have exactly the scale they are asked for.

import std.math (pow)
import std.show (show)

/// The digits after the point.
pub fn scale(d: Decimal) -> Int = decimal_scale(d)

/// The same value at the least scale that holds it: `1.50m` is `1.5m`, `2.00m` is `2m`.
pub fn normalize(d: Decimal) -> Decimal / {abort.raise} =
  decimal_round(d, scale(d) - trailing_zeros(d), Down)

/// The whole part, toward zero.
pub fn trunc(d: Decimal) -> Decimal = decimal_round(d, 0, Down)

/// What `trunc` leaves: the part after the point, with `d`'s sign.
pub fn fract(d: Decimal) -> Decimal = d - trunc(d)

/// Whether the value is below zero.
pub fn is_negative(d: Decimal) -> Bool = d < decimal_of_int(0)

/// The distance from zero.
pub fn abs(d: Decimal) -> Decimal = if is_negative(d) { decimal_of_int(0) - d } else { d }

/// `mantissa / 10^scale` with exactly `scale` digits after the point, so `mantissa` is its digits;
/// `None` for a scale outside `0..=28`.
pub fn of_parts(mantissa: Int, scale: Int) -> Option<Decimal> / {abort.raise} =
  if scale < 0 || scale > 28 { None }
  else { Some(decimal_div(decimal_of_int(mantissa), power_of_ten(scale), scale, Down)) }

/// The greatest `Decimal`: a 96-bit mantissa at scale zero.
pub fn max_value() -> Decimal / {abort.raise} =
  match decimal_of_string("79228162514264337593543950335") {
    Some(d) -> d,
    None -> panic("the greatest Decimal parses"),
  }

/// The least `Decimal`, the greatest negated.
pub fn min_value() -> Decimal / {abort.raise} = decimal_of_int(0) - max_value()

fn power_of_ten(n: Int) -> Decimal =
  fold(range(0, n), decimal_of_int(1), |acc: Decimal, _: Int| acc * decimal_of_int(10))

fn trailing_zeros(d: Decimal) -> Int / {abort.raise} = {
  let text = decimal_to_string(d);
  zeros_before(text, string_len(text), scale(d))
}

fn zeros_before(text: String, end: Int, left: Int) -> Int / {abort.raise} =
  if left <= 0 || string_slice(text, end - 1, end) != "0" { 0 }
  else { 1 + zeros_before(text, end - 1, left - 1) }

test "scale is the digits a value holds after its point, zeros included" {
  assert_eq(scale(1.50m), 2);
  assert_eq(scale(1.5m), 1);
  assert_eq(scale(2m), 0);
  assert_eq(scale(0.00m), 2);
  assert_eq(scale(-3.125m), 3)
}

test "normalize drops trailing zeros and nothing else" {
  assert_eq(decimal_to_string(normalize(1.50m)), "1.5");
  assert_eq(decimal_to_string(normalize(2.00m)), "2");
  assert_eq(decimal_to_string(normalize(0.00m)), "0");
  assert_eq(decimal_to_string(normalize(1.25m)), "1.25");
  assert_eq(decimal_to_string(normalize(-7.10m)), "-7.1")
}

test "trunc goes toward zero and fract is what it leaves" {
  assert_eq(trunc(3.75m), 3m);
  assert_eq(trunc(-3.75m), -3m);
  assert_eq(fract(3.75m), 0.75m);
  assert_eq(fract(-3.75m), -0.75m);
  assert_eq(fract(4m), 0m)
}

test "sign and magnitude" {
  assert(is_negative(-0.5m));
  assert(!is_negative(0m));
  assert(!is_negative(0.5m));
  assert_eq(abs(-2.5m), 2.5m);
  assert_eq(abs(2.5m), 2.5m)
}

test "a mantissa and a scale name one value, at that scale" {
  assert_eq(of_parts(150, 2), Some(1.50m));
  assert_eq(show(of_parts(150, 2)), "Some(1.50)");
  assert_eq(show(of_parts(100, 2)), "Some(1.00)");
  assert_eq(show(of_parts(0, 2)), "Some(0.00)");
  assert_eq(show(of_parts(0 - 5, 3)), "Some(-0.005)");
  assert_eq(show(of_parts(7, 0)), "Some(7)");
  assert_eq(show(of_parts(1, 28)), "Some(0.0000000000000000000000000001)");
  assert_eq(of_parts(1, 29), None);
  assert_eq(of_parts(1, 0 - 1), None)
}

test "a quotient has the digits after its point that it was asked for" {
  assert_eq(show(decimal_div(3m, 2m, 3, HalfEven)), "1.500");
  assert_eq(show(decimal_div(1m, 3m, 3, HalfEven)), "0.333");
  assert_eq(show(decimal_div(100m, 100m, 2, Down)), "1.00");
  assert_eq(show(decimal_div(3.00m, 2m, 0, HalfEven)), "2");
  assert_eq(show(decimal_div(0m, 7m, 2, Up)), "0.00");
  assert_eq(show(decimal_div(0m - 1m, 3m, 2, Floor)), "-0.34");
  assert_eq(show(decimal_div(0m - 1m, 300m, 2, HalfEven)), "0.00")
}

test "a rounding fills with zeros what it does not round away" {
  assert_eq(show(decimal_round(1.5m, 3, HalfEven)), "1.500");
  assert_eq(show(decimal_round(1.50m, 1, HalfEven)), "1.5");
  assert_eq(show(decimal_round(7m, 2, Down)), "7.00");
  assert_eq(show(decimal_round(2.5m, 0, HalfEven)), "2");
  assert_eq(show(decimal_round(2.5m, 0, HalfUp)), "3");
  assert_eq(show(decimal_round(0m - 0.001m, 2, Floor)), "-0.01");
  assert_eq(show(decimal_round(0m - 0.001m, 2, HalfEven)), "0.00")
}

test "a quotient is rounded once, where it ends, however many digits it has" {
  assert_eq(show(decimal_div(2m, 3m, 28, Down)), "0.6666666666666666666666666666");
  assert_eq(show(decimal_div(2m, 3m, 28, HalfEven)), "0.6666666666666666666666666667");
  assert_eq(show(decimal_div(1m, 3m, 28, Up)), "0.3333333333333333333333333334");
  // Below a half by one part in ten to the twenty-ninth, which no decimal holds.
  assert_eq(show(decimal_div(4.9999999999999999999999999995m, 10m, 0, HalfUp)), "0");
  assert_eq(show(decimal_div(max_value(), 3m, 0, Down)), "26409387504754779197847983445")
}

test "a quotient or a rounding its scale leaves no room for is refused" {
  let overflow = |what: String| Err("`Decimal` overflow in " ++ what);
  assert_eq(try[abort.raise] { decimal_round(max_value(), 1, Down) }, overflow("rounding"));
  assert_eq(try[abort.raise] { decimal_round(8m, 28, Down) }, overflow("rounding"));
  assert_eq(show(decimal_round(7m, 28, Down)), "7.0000000000000000000000000000");
  assert_eq(try[abort.raise] { decimal_div(max_value(), 1m, 1, Down) }, overflow("division"));
  assert_eq(try[abort.raise] { decimal_div(1m, 0.1m, 28, Down) }, overflow("division"));
  assert_eq(try[abort.raise] { decimal_div(max_value(), 0.5m, 0, Down) }, overflow("division"));
  assert_eq(show(decimal_div(max_value(), 1m, 0, Down)), "79228162514264337593543950335")
}

/// `n / m` as a whole number rounded by `mode`: what the last digit of a quotient is held to.
fn whole_quotient(n: Int, m: Int, mode: Rounding) -> Int / {abort.raise} = {
  let q = n / m;
  let r = n % m;
  let negative = n < 0 != (m < 0);
  let away = if negative { q - 1 } else { q + 1 };
  let half = compare(2 * max(r, 0 - r), max(m, 0 - m));
  if r == 0 { q } else {
    match mode {
      Down -> q,
      Up -> away,
      Ceiling -> if negative { q } else { away },
      Floor -> if negative { away } else { q },
      HalfUp -> if half == Less { q } else { away },
      HalfEven -> if half == Greater || (half == Equal && q % 2 != 0) { away } else { q },
    }
  }
}

fn modes() -> List<Rounding> = [HalfEven, HalfUp, Down, Up, Ceiling, Floor]

fn mode_at(pick: Int) -> Rounding =
  match list_at(modes(), pick & 7) { Some(mode) -> mode, None -> HalfEven }

law "a mantissa at a scale has that scale, and is the mantissa once its point is moved back"
  forall (n: Int, k: Int) {
    match of_parts(n, k & 31) {
      Some(d) ->
        k & 31 <= 28 && scale(d) == k & 31 && d * power_of_ten(k & 31) == decimal_of_int(n),
      None -> k & 31 > 28,
    }
  }

/// The text of `mantissa` at `scale`, which is how a law reads a scale as well as a value.
fn written(mantissa: Int, scale: Int) -> Option<String> / {abort.raise} =
  match of_parts(mantissa, scale) { Some(d) -> Some(decimal_to_string(d)), None -> None }

law "a quotient of whole numbers is their quotient rounded once by its mode, at the scale asked"
  forall (n: Int, m: Int, k: Int, pick: Int) where m % 1000000 != 0 {
    let a = n % 1000000000;
    let b = m % 1000000;
    let places = k & 7;
    let mode = mode_at(pick);
    Some(decimal_to_string(decimal_div(decimal_of_int(a), decimal_of_int(b), places, mode)))
      == written(whole_quotient(a * pow(10, places), b, mode), places)
  }

law "a rounding is the mantissa's quotient by a power of ten, or the mantissa with zeros after it"
  forall (n: Int, k: Int, pick: Int) {
    let mantissa = n % 1000000000;
    let places = k & 15;
    let mode = mode_at(pick);
    let d = match of_parts(mantissa, 6) { Some(d) -> d, None -> 0m };
    Some(decimal_to_string(decimal_round(d, places, mode)))
      == (if places <= 6 { written(whole_quotient(mantissa, pow(10, 6 - places), mode), places) }
      else { written(mantissa * pow(10, places - 6), places) })
  }

test "the extremes are the 96-bit mantissa and its negation" {
  assert_eq(decimal_to_string(max_value()), "79228162514264337593543950335");
  assert_eq(decimal_to_string(min_value()), "-79228162514264337593543950335")
}
