// `decimal` — a `Decimal`'s parts. The prelude computes with one; this says what it is made of: how
// many digits follow its point, the same value without trailing zeros, its whole and fractional
// parts, and the value a mantissa and a scale name.
//
// A `Decimal` keeps the scale it was written or computed at, so `1.5m` and `1.50m` are equal and
// print differently: `scale` reads the one it holds.

/// The digits after the point.
pub fn scale(d: Decimal) -> Int = {
  let text = decimal_to_string(d);
  match point_of(text) { Some(at) -> string_len(text) - at - 1, None -> 0 }
}

/// The same value at the least scale that holds it: `1.50m` is `1.5m`, `2.00m` is `2m`.
pub fn normalize(d: Decimal) -> Decimal = decimal_round(d, scale(d) - trailing_zeros(d), Down)

/// The whole part, toward zero.
pub fn trunc(d: Decimal) -> Decimal = decimal_round(d, 0, Down)

/// What `trunc` leaves: the part after the point, with `d`'s sign.
pub fn fract(d: Decimal) -> Decimal = d - trunc(d)

pub fn is_negative(d: Decimal) -> Bool = d < decimal_of_int(0)

pub fn abs(d: Decimal) -> Decimal = if is_negative(d) { decimal_of_int(0) - d } else { d }

/// `mantissa / 10^scale`, at that scale; `None` for a scale outside `0..=28`.
pub fn of_parts(mantissa: Int, scale: Int) -> Option<Decimal> =
  if scale < 0 || scale > 28 { None }
  else { Some(decimal_div(decimal_of_int(mantissa), power_of_ten(scale), scale, Down)) }

/// The greatest `Decimal`: a 96-bit mantissa at scale zero.
pub fn max_value() -> Decimal =
  match decimal_of_string("79228162514264337593543950335") {
    Some(d) -> d,
    None -> panic("the greatest Decimal parses"),
  }

/// The least `Decimal`, the greatest negated.
pub fn min_value() -> Decimal = decimal_of_int(0) - max_value()

fn power_of_ten(n: Int) -> Decimal =
  fold(range(0, n), decimal_of_int(1), |acc: Decimal, _: Int| acc * decimal_of_int(10))

fn point_of(text: String) -> Option<Int> =
  if string_contains(text, ".") { Some(string_find(text, ".")) } else { None }

fn trailing_zeros(d: Decimal) -> Int = {
  let text = decimal_to_string(d);
  zeros_before(text, string_len(text), scale(d))
}

fn zeros_before(text: String, end: Int, left: Int) -> Int =
  if left <= 0 || string_slice(text, end - 1, end) != "0" { 0 }
  else { 1 + zeros_before(text, end - 1, left - 1) }

test "scale is the digits a value holds after its point, zeros included" {
  assert_eq(scale(1.50m), 2);
  assert_eq(scale(1.5m), 1);
  assert_eq(scale(2m), 0);
  assert_eq(scale(0.00m), 2);
  assert_eq(scale(-3.125m), 3)
}

test "normalize drops trailing zeros and nothing else" {
  assert_eq(decimal_to_string(normalize(1.50m)), "1.5");
  assert_eq(decimal_to_string(normalize(2.00m)), "2");
  assert_eq(decimal_to_string(normalize(0.00m)), "0");
  assert_eq(decimal_to_string(normalize(1.25m)), "1.25");
  assert_eq(decimal_to_string(normalize(-7.10m)), "-7.1")
}

test "trunc goes toward zero and fract is what it leaves" {
  assert_eq(trunc(3.75m), 3m);
  assert_eq(trunc(-3.75m), -3m);
  assert_eq(fract(3.75m), 0.75m);
  assert_eq(fract(-3.75m), -0.75m);
  assert_eq(fract(4m), 0m)
}

test "sign and magnitude" {
  assert(is_negative(-0.5m));
  assert(!is_negative(0m));
  assert(!is_negative(0.5m));
  assert_eq(abs(-2.5m), 2.5m);
  assert_eq(abs(2.5m), 2.5m)
}

test "a mantissa and a scale name one value, at that scale" {
  assert_eq(of_parts(150, 2), Some(1.50m));
  assert_eq(scale(match of_parts(150, 2) { Some(d) -> d, None -> 0m }), 2);
  assert_eq(of_parts(0 - 5, 1), Some(-0.5m));
  assert_eq(of_parts(7, 0), Some(7m));
  assert_eq(of_parts(1, 29), None);
  assert_eq(of_parts(1, 0 - 1), None)
}

test "the extremes are the 96-bit mantissa and its negation" {
  assert_eq(decimal_to_string(max_value()), "79228162514264337593543950335");
  assert_eq(decimal_to_string(min_value()), "-79228162514264337593543950335")
}
