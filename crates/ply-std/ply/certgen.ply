// Throwaway certificates for benches and tests: a self-signed localhost certificate, generated
// where the run is, so nothing checked in is trusted by anything.

pub nondet effect certgen {
  read issue() -> Issued
}

pub type Issued = {
  // The certificate and its private key, PEM-encoded, as `--tls NAME=CERT,KEY` wants them.
  certificate: String,
  key: String,
  // The certificate's DER bytes, for a client that trusts exactly this one.
  der: Bytes,
  // The certificate's SHA-256 fingerprint, lowercase hex; how `ply hosts` prints one.
  fingerprint: String,
}

// The one every bench asks for: `localhost`, and the names a local listener is reached by.
pub fn localhost() -> Issued / {certgen.issue bounded} = certgen.issue()

// --- Tests ------------------------------------------------------------------

// What a test hands the clause below in place of the host: the certificate it stands in for.
pub fn canned(certificate: String, key: String, der: Bytes, fingerprint: String) -> Issued =
  { certificate: certificate, key: key, der: der, fingerprint: fingerprint }

test "a program that asks for a certificate is tested without generating one" {
  let stood_in = canned("CERT", "KEY", b"der", "ab");
  let asked = handle {
    let issued = localhost();
    { cert: issued.certificate, key: issued.key, der: issued.der, at: issued.fingerprint }
  } with {
    certgen.issue() -> stood_in,
  };
  assert_eq(asked.cert, "CERT");
  assert_eq(asked.key, "KEY");
  assert_eq(asked.der, b"der");
  assert_eq(asked.at, "ab")
}
