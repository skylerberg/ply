import std.pkg (Manifest)

// The test package: what a `ply test` run decides, as Ply. The keys a result is filed under and
// the decision to re-run or not are here; the run itself — loading, discharging and reporting —
// stays in the runtime, which enters compiled bodies and holds a store.
fn package() -> Manifest = {
  name: "test",
  version: { major: 0, minor: 1, patch: 0 },
  prefix: None,
  runtime: { major: 0, minor: 16, patch: 0 },
  dependencies: [],
  entry: None,
}
