import std.pkg (Manifest)

// The suite: what a `ply test` run decides, as Ply. The keys a result is filed under, the decision
// to re-run or not, why a failure happened and what a program's claims cover are here; the run
// itself — loading, discharging and reporting — stays in the runtime, which enters compiled bodies
// and holds a store. It is `suite` and not `test` because `test` is a keyword: a package a program
// imports cannot be named one.
fn package() -> Manifest = {
  name: "suite",
  version: { major: 0, minor: 1, patch: 0 },
  prefix: None,
  runtime: { major: 0, minor: 16, patch: 0 },
  dependencies: [],
  entry: None,
}
