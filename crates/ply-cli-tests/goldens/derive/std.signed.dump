pub fn signature_bin() -> bin::BinCodec<Signature> = {put: |dw: Bytes, dv: Signature| bin::put_bytes(bin::put_bytes(dw, dv.signer), dv.signature), take: |dd: Bytes, dn: Int| match bin::take_bytes(dd, dn) {Err(de) -> Err(de), Ok(d0) -> match bin::take_bytes(dd, d0.at) {Err(de) -> Err(de), Ok(d1) -> Ok({value: {signer: d0.value, signature: d1.value}, at: d1.at})}}, shape: |ds: bin::Shapes| bin::record_shape(ds, [{name: "signer", shape: bin::bytes_bin().shape}, {name: "signature", shape: bin::bytes_bin().shape}])}S;
571;
pub fn signed_bin() -> bin::BinCodec<Signed> = {put: |dw: Bytes, dv: Signed| (bin::list_bin(signature_bin()).put)(bin::put_bytes(dw, dv.payload), dv.signatures), take: |dd: Bytes, dn: Int| match bin::take_bytes(dd, dn) {Err(de) -> Err(de), Ok(d0) -> match (bin::list_bin(signature_bin()).take)(dd, d0.at) {Err(de) -> Err(de), Ok(d1) -> Ok({value: {payload: d0.value, signatures: d1.value}, at: d1.at})}}, shape: |ds: bin::Shapes| bin::record_shape(ds, [{name: "payload", shape: bin::bytes_bin().shape}, {name: "signatures", shape: bin::list_bin(signature_bin()).shape}])}D;
0;
