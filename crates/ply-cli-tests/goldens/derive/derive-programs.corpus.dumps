fn order_bin() -> bin::BinCodec<Order> = {put: |dw: Bytes, dv: Order| (bin::option_bin(bin::string_bin()).put)((bin::list_bin(line_bin()).put)(bin::put_int(dw, dv.id), dv.lines), dv.note), take: |dd: Bytes, dn: Int| match bin::take_int(dd, dn) {Err(de) -> Err(de), Ok(d0) -> match (bin::list_bin(line_bin()).take)(dd, d0.at) {Err(de) -> Err(de), Ok(d1) -> match (bin::option_bin(bin::string_bin()).take)(dd, d1.at) {Err(de) -> Err(de), Ok(d2) -> Ok({value: {id: d0.value, lines: d1.value, note: d2.value}, at: d2.at})}}}, shape: |ds: bin::Shapes| bin::record_shape(ds, [{name: "id", shape: bin::int_bin().shape}, {name: "lines", shape: bin::list_bin(line_bin()).shape}, {name: "note", shape: bin::option_bin(bin::string_bin()).shape}])}S;
629;
fn line_bin() -> bin::BinCodec<Line> = {put: |dw: Bytes, dv: Line| bin::put_decimal(bin::put_u32(bin::put_string(dw, dv.sku), dv.qty), dv.price), take: |dd: Bytes, dn: Int| match bin::take_string(dd, dn) {Err(de) -> Err(de), Ok(d0) -> match bin::take_u32(dd, d0.at) {Err(de) -> Err(de), Ok(d1) -> match bin::take_decimal(dd, d1.at) {Err(de) -> Err(de), Ok(d2) -> Ok({value: {sku: d0.value, qty: d1.value, price: d2.value}, at: d2.at})}}}, shape: |ds: bin::Shapes| bin::record_shape(ds, [{name: "sku", shape: bin::string_bin().shape}, {name: "qty", shape: bin::u32_bin().shape}, {name: "price", shape: bin::decimal_bin().shape}])}S;
789;
fn status_bin() -> bin::BinCodec<Status> = {put: |dw: Bytes, dv: Status| match dv {Placed -> bin::put_tag(dw, 0), Shipped(d0, d1) -> bin::put_bool(bin::put_int(bin::put_tag(dw, 1), d0), d1), Lost -> bin::put_tag(dw, 2)}, take: |dd: Bytes, dn: Int| match bin::take_tag(dd, dn, 3) {Err(de) -> Err(de), Ok(dt) -> match dt.value {0 -> Ok({value: Placed, at: dt.at}), 1 -> match bin::take_int(dd, dt.at) {Err(de) -> Err(de), Ok(d0) -> match bin::take_bool(dd, d0.at) {Err(de) -> Err(de), Ok(d1) -> Ok({value: Shipped(d0.value, d1.value), at: d1.at})}}, _ -> Ok({value: Lost, at: dt.at})}}, shape: |ds: bin::Shapes| bin::sum_shape(ds, "t.Status", "Status", [], [{name: "Placed", fields: []}, {name: "Shipped", fields: [bin::int_bin().shape, bin::bool_bin().shape]}, {name: "Lost", fields: []}])}D;
