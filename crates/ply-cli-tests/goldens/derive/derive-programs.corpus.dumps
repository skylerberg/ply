M;2;S;1103;fn tree_bin<a>(a: bin::BinCodec<a>) -> bin::BinCodec<Tree<a>> where derivable(bin, a) = tree_bin_at(a, bin::max_depth())
fn tree_bin_at<a>(a: bin::BinCodec<a>, ddepth: Int) -> bin::BinCodec<Tree<a>> where derivable(bin, a) = if ddepth <= 0 {bin::too_deep()} else {{put: |dw: Bytes, dv: Tree<a>| match dv {Leaf -> bin::put_tag(dw, 0), Node(d0, d1, d2) -> (tree_bin_at(a, ddepth - 1).put)((a.put)((tree_bin_at(a, ddepth - 1).put)(bin::put_tag(dw, 1), d0), d1), d2)}, take: |dd: Bytes, dn: Int| match bin::take_tag(dd, dn, 2) {Err(de) -> Err(de), Ok(dt) -> match dt.value {0 -> Ok({value: Leaf, at: dt.at}), _ -> match (tree_bin_at(a, ddepth - 1).take)(dd, dt.at) {Err(de) -> Err(de), Ok(d0) -> match (a.take)(dd, d0.at) {Err(de) -> Err(de), Ok(d1) -> match (tree_bin_at(a, ddepth - 1).take)(dd, d1.at) {Err(de) -> Err(de), Ok(d2) -> Ok({value: Node(d0.value, d1.value, d2.value), at: d2.at})}}}}}, shape: |ds: bin::Shapes| bin::sum_shape(ds, "t.Tree", "Tree", [a.shape], [{name: "Leaf", fields: []}, {name: "Node", fields: [tree_bin_at(a, ddepth - 1).shape, a.shape, tree_bin_at(a, ddepth - 1).shape]}])}}S;2171;fn box_bin<k>(k: bin::BinCodec<k>) -> bin::BinCodec<Box<k>> where derivable(bin, k) = {put: |dw: Bytes, dv: Box<k>| ({put: |dw: Bytes, dv: {_0: Unit, _1: Bytes}| bin::put_bytes(bin::put_unit(dw, dv._0), dv._1), take: |dd: Bytes, dn: Int| match bin::take_unit(dd, dn) {Err(de) -> Err(de), Ok(d0) -> match bin::take_bytes(dd, d0.at) {Err(de) -> Err(de), Ok(d1) -> Ok({value: {_0: d0.value, _1: d1.value}, at: d1.at})}}, shape: |ds: bin::Shapes| bin::record_shape(ds, [{name: "_0", shape: bin::unit_bin().shape}, {name: "_1", shape: bin::bytes_bin().shape}])}.put)(bin::put_float(bin::put_i128((bin::map_bin(bin::int_bin(), k).put)(dw, dv.by), dv.wide), dv.ratio), dv.pair), take: |dd: Bytes, dn: Int| match (bin::map_bin(bin::int_bin(), k).take)(dd, dn) {Err(de) -> Err(de), Ok(d0) -> match bin::take_i128(dd, d0.at) {Err(de) -> Err(de), Ok(d1) -> match bin::take_float(dd, d1.at) {Err(de) -> Err(de), Ok(d2) -> match ({put: |dw: Bytes, dv: {_0: Unit, _1: Bytes}| bin::put_bytes(bin::put_unit(dw, dv._0), dv._1), take: |dd: Bytes, dn: Int| match bin::take_unit(dd, dn) {Err(de) -> Err(de), Ok(d0) -> match bin::take_bytes(dd, d0.at) {Err(de) -> Err(de), Ok(d1) -> Ok({value: {_0: d0.value, _1: d1.value}, at: d1.at})}}, shape: |ds: bin::Shapes| bin::record_shape(ds, [{name: "_0", shape: bin::unit_bin().shape}, {name: "_1", shape: bin::bytes_bin().shape}])}.take)(dd, d2.at) {Err(de) -> Err(de), Ok(d3) -> Ok({value: {by: d0.value, wide: d1.value, ratio: d2.value, pair: d3.value}, at: d3.at})}}}}, shape: |ds: bin::Shapes| bin::record_shape(ds, [{name: "by", shape: bin::map_bin(bin::int_bin(), k).shape}, {name: "wide", shape: bin::i128_bin().shape}, {name: "ratio", shape: bin::float_bin().shape}, {name: "pair", shape: {put: |dw: Bytes, dv: {_0: Unit, _1: Bytes}| bin::put_bytes(bin::put_unit(dw, dv._0), dv._1), take: |dd: Bytes, dn: Int| match bin::take_unit(dd, dn) {Err(de) -> Err(de), Ok(d0) -> match bin::take_bytes(dd, d0.at) {Err(de) -> Err(de), Ok(d1) -> Ok({value: {_0: d0.value, _1: d1.value}, at: d1.at})}}, shape: |ds: bin::Shapes| bin::record_shape(ds, [{name: "_0", shape: bin::unit_bin().shape}, {name: "_1", shape: bin::bytes_bin().shape}])}.shape}])}D;0;
