M;1;S;984;fn tree_json() -> json::JsonCodec<Tree> = tree_json_at(json::max_depth())
fn tree_json_at(ddepth: Int) -> json::JsonCodec<Tree> = if ddepth <= 0 {json::too_deep()} else {{encode: |dv: Tree| match dv {Leaf -> json::variant("Leaf", []), Node(d0, d1, d2) -> json::variant("Node", [(tree_json_at(ddepth - 1).encode)(d0), (json::int_json().encode)(d1), (tree_json_at(ddepth - 1).encode)(d2)])}, decode: |dj: json::Json| match json::variant_of(dj) {Err(de) -> Err(de), Ok(dt) -> if json::has_tag(dt, "Leaf") {Ok(Leaf)} else {if json::has_tag(dt, "Node") {match json::decode_and_then(json::variant_value(dt, 0), tree_json_at(ddepth - 1).decode) {Err(de) -> Err(de), Ok(d0) -> match json::decode_and_then(json::variant_value(dt, 1), json::int_json().decode) {Err(de) -> Err(de), Ok(d1) -> match json::decode_and_then(json::variant_value(dt, 2), tree_json_at(ddepth - 1).decode) {Err(de) -> Err(de), Ok(d2) -> Ok(Node(d0, d1, d2))}}}} else {json::unknown_variant(dt.tag, ["Leaf", "Node"])}}}}}D;1;!E0206:0:73:99:2:2;=0:73:99:1;=0:142:165:0;
