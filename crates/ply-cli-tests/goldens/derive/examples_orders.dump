pub fn order_json() -> json::JsonCodec<Order> = {encode: |dv: Order| json::object([{key: "customer", value: (json::string_json().encode)(dv.customer)}, {key: "lines", value: (json::list_json(line_json()).encode)(dv.lines)}]), decode: |dj: json::Json| match json::field(dj, "customer", json::string_json()) {Err(de) -> Err(de), Ok(d0) -> match json::field(dj, "lines", json::list_json(line_json())) {Err(de) -> Err(de), Ok(d1) -> Ok({customer: d0, lines: d1})}}}S;
