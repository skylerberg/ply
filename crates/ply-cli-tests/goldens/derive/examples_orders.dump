pub fn reply_json() -> json::JsonCodec<Reply> = {encode: |dv: Reply| match dv {Accepted(d0) -> json::variant("Accepted", [(receipt_json().encode)(d0)]), Rejected(d0) -> json::variant("Rejected", [(json::string_json().encode)(d0)])}, decode: |dj: json::Json| match json::variant_of(dj) {Err(de) -> Err(de), Ok(dt) -> if dt.tag == "Accepted" {match json::decode_and_then(json::variant_value(dt, 0), receipt_json().decode) {Err(de) -> Err(de), Ok(d0) -> Ok(Accepted(d0))}} else {if dt.tag == "Rejected" {match json::decode_and_then(json::variant_value(dt, 0), json::string_json().decode) {Err(de) -> Err(de), Ok(d0) -> Ok(Rejected(d0))}} else {json::unknown_variant(dt.tag, ["Accepted", "Rejected"])}}}}D;
