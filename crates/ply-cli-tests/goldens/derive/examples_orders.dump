pub fn line_json() -> json::JsonCodec<Line> = {encode: |dv: Line| json::object([{key: "sku", value: (json::string_json().encode)(dv.sku)}, {key: "qty", value: (json::int_json().encode)(dv.qty)}, {key: "unit_price", value: (json::decimal_json().encode)(dv.unit_price)}]), decode: |dj: json::Json| match json::field(dj, "sku", json::string_json()) {Err(de) -> Err(de), Ok(d0) -> match json::field(dj, "qty", json::int_json()) {Err(de) -> Err(de), Ok(d1) -> match json::field(dj, "unit_price", json::decimal_json()) {Err(de) -> Err(de), Ok(d2) -> Ok({sku: d0, qty: d1, unit_price: d2})}}}}S;
