pub fn receipt_json() -> json::JsonCodec<Receipt> = {encode: |dv: Receipt| json::object([{key: "customer", value: (json::string_json().encode)(dv.customer)}, {key: "items", value: (json::int_json().encode)(dv.items)}, {key: "total", value: (json::decimal_json().encode)(dv.total)}]), decode: |dj: json::Json| match json::field(dj, "customer", json::string_json()) {Err(de) -> Err(de), Ok(d0) -> match json::field(dj, "items", json::int_json()) {Err(de) -> Err(de), Ok(d1) -> match json::field(dj, "total", json::decimal_json()) {Err(de) -> Err(de), Ok(d2) -> Ok({customer: d0, items: d1, total: d2})}}}}S;
