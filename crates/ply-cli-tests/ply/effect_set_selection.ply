// What an effect set's spelling may not decide: renaming one, reordering or repeating its members,
// declaring one nothing uses, or writing out its expansion selects no test; widening one selects
// exactly the tests that reach it.

import harness (scratch, Ran, on_disk, program, write, said, warm_agrees, json_of, path, int, shown,
                Reached, Shelf)
import std.string

// `store` is handled in both tests, so both are cacheable and "selected zero" is about the cache.
fn source(web: String) -> String =
  \\effect store {
  \\  read  all[r]() -> List<Int>
  \\  write save[r](rows: List<Int>) -> Unit
  \\}
  \\
    ++ "\n"
    ++ web
    ++ "\n\n"
    ++
    \\fn list_orders() -> Int / {Web} = len(store.all[orders]())
    \\
    \\fn health() -> Int = 200
    \\
    \\test "orders are listed" {
    \\  handle { assert_eq(list_orders(), 0) } with { store.all[orders]() -> [] }
    \\}
    \\
    \\test "health is 200" {
    \\  assert_eq(health(), 200)
    \\}
    \\

fn narrow() -> String = "effect set Web = {store.read[orders], store.write[audit]}"

fn green(r: Ran) -> Ran = {
  assert(r.code == 0, Some(said(r)));
  r
}

// How many tests a run selects after `before` is edited into `after`.
fn selected_after(before: String, after: String) -> Int / {Reached, Shelf} = {
  program(before);
  let _ = green(on_disk(["test"]));
  write("m.ply", after);
  let report = json_of(green(on_disk(["test", "--json"])));
  int(path(report, ["selection", "selected"]))
}

test "renaming a set selects no tests" {
  scratch(|| {
    // The row has to be renamed with it, so the edit is the rename and nothing else.
    let renamed = string::replace(
      source("effect set Surface = {store.read[orders], store.write[audit]}"),
      "/ {Web}",
      "/ {Surface}",
    );
    assert(
      selected_after(source(narrow()), renamed) == 0,
      Some("a set's name is namespace metadata"),
    )
  })
}

test "reordering a set's members selects no tests" {
  scratch(|| {
    assert_eq(
      selected_after(
        source(narrow()),
        source("effect set Web = {store.write[audit], store.read[orders]}"),
      ),
      0,
    )
  })
}

test "writing a member twice selects no tests" {
  scratch(|| {
    assert_eq(
      selected_after(
        source(narrow()),
        source("effect set Web = {store.read[orders], store.write[audit], store.read[orders]}"),
      ),
      0,
    )
  })
}

test "declaring a set nothing uses selects no tests" {
  scratch(|| {
    assert_eq(
      selected_after(
        source(narrow()),
        source(narrow() ++ "\neffect set Unused = {store.read[inventory]}"),
      ),
      0,
    )
  })
}

test "replacing a set with its expansion selects no tests" {
  scratch(|| {
    // Written in the other order too: the annotation's spelling may not decide what a row means.
    let expanded = string::replace(
      source(""),
      "/ {Web}",
      "/ {store.write[audit], store.read[orders]}",
    );
    assert(selected_after(source(narrow()), expanded) == 0, Some("the alias was an abbreviation"))
  })
}

test "widening a set selects exactly the tests that reach it" {
  scratch(|| {
    assert_eq(
      selected_after(
        source(narrow()),
        source("effect set Web = {store.read[orders], store.write[audit], store.read[inventory]}"),
      ),
      1,
    )
  })
}

// A cold cache never exercises an invalidation, and an invalidation is the only thing that can be
// wrong.
test "a warm check agrees with a cold one across a sequence of set edits" {
  scratch(|| {
    program(source(narrow()));
    let steps = [
      narrow(),
      "effect set Web = {store.write[audit], store.read[orders]}",
      "effect set Inner = {store.read[orders]}\neffect set Web = {Inner, store.write[audit]}",
      "effect set Inner = {store.read[orders], store.read[inventory]}\neffect set Web = {Inner, store.write[audit]}",
      narrow() ++ "\neffect set Unused = {store.read[nothing]}",
    ];
    fold(range(0, len(steps)), (), |u: Unit, i: Int| {
      write("m.ply", source(match list_at(steps, i) { Some(w) -> w, None -> "" }));
      let _ = warm_agrees("step " ++ int_to_string(i));
      u
    })
  })
}
