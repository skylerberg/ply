//! What the host registers a handler for is what this tree declares: a registration for an
//! operation no declaration holds, a typo or one side of a rename, binds nothing anywhere and fails
//! no other test, so every one is held here to the prelude's effects and every shipped module's.

import harness (Here, Shipped, first_message, project)
import cli.hosts (tcb, Registration)
import compiler.front (EffectRow, OpRow)
import compiler.load
import compiler.unit (shipped)
import std.list (find)

/// Whether a registration for `registered` is for `e`: the language's and a shipped module's by
/// program-wide name, any other by the name its module declared it under.
fn names(registered: String, e: EffectRow) -> Bool / {abort.raise} = {
  let name = bytes_of_string(registered);
  let language = ["task", "clock", "random", "sim", "abort", "diverges"];
  if registered == "std" || string_starts_with(registered, "std.")
      || find(language, |l: String| l == registered) != None { e.name == name }
  else { e.simple_name == name }
}

/// What is wrong with `r` against `declared`, if anything.
fn misregistered(declared: List<EffectRow>, r: Registration) -> Option<String> / {abort.raise} =
  match find(declared, |e: EffectRow| names(r.effect, e)) {
    None ->
      Some(r.effect ++ "." ++ r.op ++ " (" ++ r.handler ++ "): no declaration holds the effect"),
    Some(e) -> if find(e.ops, |o: OpRow| o.name == bytes_of_string(r.op)) == None {
      Some(
        r.effect ++ "." ++ r.op ++ " (" ++ r.handler ++ "): the effect declares no such operation",
      )
    } else if !r.deterministic && !e.nondet {
      Some(
        r.effect ++ "." ++ r.op ++ " (" ++ r.handler
          ++ "): a nondeterministic handler on an effect not declared `nondet`",
      )
    } else { None },
  }

test/nondet "every operation the host registers is one the prelude or a shipped module declares, as it declares it" {
  let imports = fold(shipped.names(), "", |acc: String, n: String|
    if n == "std" || string_starts_with(n, "std.") { acc ++ "import " ++ n ++ "\n" } else { acc });
  project([{ path: "app.ply", text: imports ++ "\nfn main() -> Int = 0\n" }]);
  let declared = match load::load[cwd](".") {
    Err(diags) -> panic("the shipped modules load: " ++ first_message(diags)),
    Ok(l) -> l.front.dump.effects,
  };
  let wrong = fold(tcb.registrations[host](), [], |acc: List<String>, r: Registration|
    match misregistered(declared, r) { Some(why) -> push(acc, why), None -> acc });
  assert_eq(wrong, [])
}
