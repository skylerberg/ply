//! `ply bootstrap`: a native `ply` is built only against a runtime's library that links, and a
//! bootstrap that cannot link one writes nothing.

import harness (on_disk, working, stderr)
import std.fs (fs)

test/nondet "a bootstrap against a runtime's library that does not link refuses, and writes nothing" {
  let r = on_disk([
    "bootstrap",
    working(),
    "--runtime",
    working() ++ "/no-such-runtime.a",
    "--out",
    working() ++ "/ply",
  ]);
  assert(r.code != 0, Some("a `ply` was built against no runtime"));
  assert(stderr(r).contains("does not link"), Some(stderr(r)));
  assert(fs.read_file[cwd]("ply") == None, Some("a refused bootstrap wrote a `ply`"))
}
