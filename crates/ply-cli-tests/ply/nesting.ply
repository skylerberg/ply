//! No shipped definition nests deeper than the emitter has ever been asked to walk. The emitter
//! recurses over an expression, so depth is what costs it and not size; past what the thread's stack
//! holds, `emit.emit_roots_answer` raises in the bootstrap fixpoint, the most expensive place in CI
//! to learn it. This is a source-level proxy for that walk: bracket nesting, plus a level for each
//! `?`, which wraps the rest of its block in a `match`, and each `else if`, one more nested `if`.

import harness (shipped_dirs)
import std.fs (fs, Dir, File)
import std.list (concat)
import std.string
import cli.diagnostic (end_of_line)

/// Just past the deepest definition the compiler, the standard library and the program hold.
/// Raising it asks the emitter to recurse further than it ever has; flatten the definition instead.
fn deepest() -> Int = 32

/// The text with comments, string and byte literals and line strings removed, so brackets inside
/// them do not count.
fn bare(text: Bytes) -> Bytes / {abort.raise} = bare_from(text, 0, [], bytes_len(text) + 1)

/// `left` bounds the rounds: each moves on a byte at least.
fn bare_from(t: Bytes, i: Int, kept: List<Bytes>, left: Int) -> Bytes / {abort.raise} =
  if left <= 0 { panic("more rounds than bytes") } else {
    let n = bytes_len(t);
    let stop = if i >= n { n } else { bytes_scan_until(t, i, b"/\\\"", n - i) };
    let so_far = push(kept, bytes_slice(t, i, stop));
    if stop >= n { bytes_concat_all(so_far) } else {
      let c = bytes_at(t, stop);
      let next = if stop + 1 < n { bytes_at(t, stop + 1) } else { -1 };
      if (c == 47 && next == 47) || (c == 92 && next == 92) {
        bare_from(t, end_of_line(t, stop), so_far, left - 1)
      } else if c == 34 { bare_from(t, quote_end(t, stop + 1), so_far, left - 1) }
      else { bare_from(t, stop + 1, push(so_far, bytes_slice(t, stop, stop + 1)), left - 1) }
    }
  }

/// Just past the quote closing a literal that opened before `i`.
fn quote_end(t: Bytes, i: Int) -> Int / {abort.raise} =
  iterate(i, bytes_len(t) + 1, |j: Int|
    if j >= bytes_len(t) { Stop(j) }
    else if bytes_at(t, j) == 92 { Continue(j + 2) }
    else if bytes_at(t, j) == 34 { Stop(j + 1) }
    else { Continue(j + 1) })

fn count_of(t: Bytes, needle: Bytes) -> Int / {abort.raise} = len(bytes_split(t, needle)) - 1

fn depth(body: Bytes) -> Int / {abort.raise} = {
  let t = bare(body);
  let walked = fold(
    range(0, bytes_len(t)),
    { at: 0, most: 0 },
    |s: { at: Int, most: Int }, i: Int| {
      let c = bytes_at(t, i);
      if c == 40 || c == 91 || c == 123 {
        { at: s.at + 1, most: if s.at + 1 > s.most { s.at + 1 } else { s.most } }
      } else if c == 41 || c == 93 || c == 125 { { ..s, at: if s.at > 0 { s.at - 1 } else { 0 } } }
      else { s }
    },
  );
  walked.most + count_of(t, b"?") + count_of(t, b"else if")
}

/// A line that opens a top-level item, and what to report it as.
fn opens(line: String) -> Option<String> / {abort.raise} = {
  let rest = if string_starts_with(line, "pub ") { string_slice(line, 4, string_len(line)) }
  else { line };
  fold(["fn", "type", "test"], None, |found: Option<String>, word: String|
    match found {
      Some(_) -> found,
      None -> if string_starts_with(rest, word ++ " ") {
        Some(word ++ " " ++ item_name(string_slice(rest, string_len(word) + 1, string_len(rest))))
      } else { None },
    })
}

fn item_name(tail: String) -> String / {abort.raise} = {
  let b = bytes_of_string(tail);
  let from = if bytes_len(b) > 0 && bytes_at(b, 0) == 34 { 1 } else { 0 };
  let to = iterate(from, bytes_len(b) + 1, |j: Int|
    if j < bytes_len(b) && is_name_byte(bytes_at(b, j)) { Continue(j + 1) } else { Stop(j) });
  string_trim(string_of_bytes(bytes_slice(b, from, to)))
}

fn is_name_byte(c: Int) -> Bool =
  (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 || c == 32

type Item = { depth: Int, module: String, name: String }

/// Every top-level item of one module, each with its depth.
fn items_of(module: String, text: String) -> List<Item> / {abort.raise} = {
  let lines = string_split(text, "\n");
  let heads = filter(range(0, len(lines)), |i: Int|
    match list_at(lines, i) { Some(l) -> opens(l) != None, None -> false });
  map(range(0, len(heads)), |n: Int| {
    let i = match list_at(heads, n) { Some(x) -> x, None -> 0 };
    let end = match list_at(heads, n + 1) { Some(x) -> x, None -> len(lines) };
    let body = fold(range(i, end), "", |acc: String, j: Int|
      acc ++ (match list_at(lines, j) { Some(l) -> l ++ "\n", None -> "" }));
    let name = match list_at(lines, i) {
      Some(l) -> match opens(l) { Some(n2) -> n2, None -> "" },
      None -> "",
    };
    { depth: depth(bytes_of_string(body)), module: module, name: name }
  })
}

/// Every `.ply` file at or below `dir`, as `std.hash.legacy` is `hash/legacy.ply` below its tree,
/// and none under a hidden name, which is never entered: the store a run keeps there may hold more
/// files than one walk answers.
fn sources_below(dir: String) -> List<String> / {fs.list_dir[repo], fs.kind[repo], abort.raise} =
  iterate({ work: [dir], found: [] }, 1000000, |s: { work: List<String>, found: List<String> }|
    match s.work {
      [] -> Stop(s.found),
      [d, ..rest] -> match fs.list_dir[repo](d) {
        None -> if d == dir { panic("`" ++ dir ++ "` is in the repository") }
        else { Continue({ ..s, work: rest }) },
        Some(names) ->
          Continue(
            fold(
              names,
              { ..s, work: rest },
              |acc: { work: List<String>, found: List<String> }, n: String|
                if string_starts_with(n, ".") { acc } else {
                  let path = d ++ "/" ++ n;
                  match fs.kind[repo](path) {
                    Dir -> { ..acc, work: push(acc.work, path) },
                    File -> if string_ends_with(n, ".ply") {
                      { ..acc, found: push(acc.found, path) }
                    } else { acc },
                    _ -> acc,
                  }
                },
            ),
          ),
      },
    })

fn every_item() -> List<Item> / {fs.list_dir[repo], fs.kind[repo], fs.read_file[repo], abort.raise} =
  fold(shipped_dirs(), [], |acc: List<Item>, dir: String|
    fold(sources_below(dir), acc, |a: List<Item>, path: String|
      match fs.read_file[repo](path) {
        Some(text) -> concat(a, items_of(path, string_of_bytes(text))),
        None -> a,
      }))

fn shown_item(item: Item) -> String =
  item.module ++ " " ++ item.name ++ " (" ++ int_to_string(item.depth) ++ ")"

test/nondet "no shipped definition nests deeper than the emitter walks" {
  let all = every_item();
  assert(len(all) > 0, Some("no sources were scanned"));
  let over = filter(all, |item: Item| item.depth > deepest());
  assert(
    len(over) == 0,
    Some(
      "these nest deeper than " ++ int_to_string(deepest())
        ++ ", as deep as the emitter has ever walked; flatten them: "
        ++ string::join(map(over, shown_item), ", "),
    ),
  );
  // The bound is only worth keeping while something is near it.
  let most = fold(all, 0, |m: Int, item: Item| if item.depth > m { item.depth } else { m });
  assert(
    most > deepest() / 2,
    Some("nothing comes near " ++ int_to_string(deepest()) ++ " any more; lower the bound"),
  )
}
