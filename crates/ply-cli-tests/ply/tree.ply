//! What holds this suite to its boundary: every command goes through the harness, so no test can
//! start `ply` with an environment or flags of its own.

import std.fs (fs)
import std.list (drop)
import std.string (replace)

fn suite() -> String = "crates/ply-cli-tests/ply"

test/nondet "the harness is the only module that starts the `ply` binary" {
  let names = match fs.list_dir[repo](suite()) {
    Some(ns) -> ns,
    None -> panic("the suite is there"),
  };
  let offenders = filter(names, |name: String|
    string_ends_with(name, ".ply") && name != "harness.ply" && name != "tree.ply"
      && (match fs.read_file[repo](suite() ++ "/" ++ name) {
        Some(text) -> {
          let t = string_of_bytes(text);
          string_contains(t, "process.spawn[ply]") || string_contains(t, "process.start[ply]")
        },
        None -> false,
      }));
  assert_eq(offenders, [])
}

/// Each row of `MARSHALLED` in `claims.rs` as the strings it spells: the module that declares the
/// type, the type, and each case the claims family builds of it.
fn marshalled() -> List<List<String>> / {fs.read[repo], abort.raise} = {
  let rust = match fs.read_file[repo]("crates/ply-machine/src/claims.rs") {
    Some(t) -> string_of_bytes(t),
    None -> panic("the claims family's source is there"),
  };
  let table = match string_split(rust, "pub const MARSHALLED") {
    [_, after, ..] -> match string_split(after, "];") { [t, ..] -> t, [] -> "" },
    _ -> panic("`claims.rs` declares `MARSHALLED`"),
  };
  // A row is a tuple, so each `)` ends one; its literals are what lies between quotes.
  filter(
    map(string_split(table, ")"), |row: String|
      fold(range(0, len(string_split(row, "\""))), [], |acc: List<String>, i: Int|
        if i % 2 == 1 { push(acc, list_at_or(string_split(row, "\""), i, "")) } else { acc })),
    |row: List<String>| len(row) >= 2,
  )
}

fn list_at_or(xs: List<String>, i: Int, or: String) -> String =
  match list_at(xs, i) { Some(x) -> x, None -> or }

/// The file of the `prove` package, reached as `proof`, that declares the module `home`.
fn proof_module(home: String) -> String / {abort.raise} =
  "crates/ply-prove/ply/" ++ replace(string_slice(home, 6, string_len(home)), ".", "/")
    ++ ".ply"

// The claims family builds each judged point as a constructor named `<module>.<case>`, which the
// prover's program matches by the name its own declaration gives the case: a row that drifted from
// the declaration is a value no arm matches.
test/nondet "every constructor the claims family builds is declared where its table says" {
  let rows = marshalled();
  assert(len(rows) > 0, Some("`MARSHALLED` names no row"));
  fold(rows, (), |u: Unit, row: List<String>| {
    let home = list_at_or(row, 0, "");
    let ty = list_at_or(row, 1, "");
    assert(string_starts_with(home, "proof."), Some("`" ++ home ++ "` is not the prover's module"));
    let text = match fs.read_file[repo](proof_module(home)) {
      Some(t) -> string_of_bytes(t),
      None -> panic("`" ++ home ++ "` is no module of the prove package"),
    };
    let declared = match string_split(text, "pub type " ++ ty ++ " =") {
      [_, after, ..] -> match string_split(after, "\npub ") { [d, ..] -> d, [] -> "" },
      _ -> panic("`" ++ home ++ "` declares no `" ++ ty ++ "`"),
    };
    fold(drop(row, 2), (), |v: Unit, case: String|
      assert(
        string_contains(declared, "| " ++ case ++ "\n") || string_contains(declared, "| " ++ case ++ "("),
        Some("`" ++ ty ++ "` in `" ++ home ++ "` declares no case `" ++ case ++ "`"),
      ))
  })
}
