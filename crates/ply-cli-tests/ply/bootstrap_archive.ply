// `ply bootstrap`: the archive it writes holds the program it was made from and verifies against
// that tree, and stops describing it once the tree moves.

import harness (on_disk, program, write, working, stderr, json_of, at, str, truth, shown)
import cli.gzip (gunzip)
import std.bytes (hex_of)
import std.fs (fs)

fn source() -> String =
  \\type Shape = { wide: Int, tall: Int }
  \\pub fn area(s: Shape) -> Int = s.wide * s.tall
  \\pub fn twice(n: Int) -> Int = area({ wide: n, tall: 2 })
  \\

fn archive() -> String = working() ++ "/archive"

test/nondet "an archive is written and verifies against the tree it came from" {
  program(source());
  let first = on_disk(["bootstrap", working(), "--out", archive(), "--json"]);
  assert(first.code == 0, Some(stderr(first)));
  let wrote = json_of(first);
  assert(truth(at(wrote, "ok")), Some(shown(wrote)));
  let unit = match fs.read_file[cwd]("archive/unit.c.gz") {
    Some(b) -> b,
    None -> panic("no bundle was written"),
  };
  assert(fs.exists[cwd]("archive/SOURCES.digest"), Some("no sources digest was written"));
  // The C is the program, so it has to contain the definitions rather than merely exist.
  let text = match gunzip(unit) {
    Ok(c) -> string_of_bytes(c),
    Err(why) -> panic("the unit unpacks: " ++ why),
  };
  // The symbol as the unit's own table publishes it: `<name> <arity> <symbol> <entry>`.
  let symbol = match filter(string_split(text, "\n"), |l: String|
      string_starts_with(l, "\"m.area ")) {
    [line, ..] -> match list_at(string_split(line, " "), 2) {
      Some(s) -> s,
      None -> panic("the table names no symbol"),
    },
    [] -> panic("the artifact says what it calls `m.area`"),
  };
  assert(
    string_contains(text, "Word " ++ symbol ++ "(PlyCtx *ctx") && string_contains(text, "ply_bind"),
    Some("the artifact does not hold the program it was made from"),
  );
  assert(
    str(at(at(wrote, "archive"), "artifact")) == hex_of(bytes_blake3(unit)),
    Some("the report does not describe the bundle beside it: " ++ shown(wrote)),
  );
  let verify = on_disk(["bootstrap", working(), "--out", archive(), "--verify"]);
  assert(
    verify.code == 0,
    Some("the archive did not verify against the tree that wrote it:\n" ++ stderr(verify)),
  )
}

test/nondet "an archive stops describing a tree that moved" {
  program(source());
  assert_eq(on_disk(["bootstrap", working(), "--out", archive()]).code, 0);
  write("m.ply", source() ++ "\npub fn added(n: Int) -> Int = n + 1\n");
  assert(
    on_disk(["bootstrap", working(), "--out", archive(), "--verify"]).code != 0,
    Some("a definition was added and the archive still claimed to describe the tree"),
  )
}
