//! `ply bootstrap`: what it writes of a program this binary ships holds the program it was made from
//! and verifies against that tree, and stops describing it once the tree moves; any other program it
//! refuses.

import harness (on_disk, program, project, write, working, stderr, json_of, at, str, truth, shown)
import std.bytes (hex_of)
import std.fs (fs)
import std.gzip (try_gunzip)

/// A builder as `ply bootstrap` knows one: a `build` module entered at `main`.
fn builder() -> String =
  \\type Shape = { wide: Int, tall: Int }
  \\pub fn area(s: Shape) -> Int = s.wide * s.tall
  \\pub fn twice(n: Int) -> Int = area({ wide: n, tall: 2 })
  \\pub fn main() -> Unit = ()
  \\

fn out() -> String / {fs.read[cwd], fs.write[cwd], abort.raise} = working() ++ "/out"

fn read(path: String) -> Bytes / {fs.read[cwd], abort.raise} =
  match fs.read_file[cwd](path) { Some(b) -> b, None -> panic("`" ++ path ++ "` was not written") }

test/nondet "a builder is written as its launcher enters it and verifies against its tree" {
  project([{ path: "build.ply", text: builder() }]);
  let first = on_disk(["bootstrap", working(), "--out", out(), "--json"]);
  assert(first.code == 0, Some(stderr(first)));
  let wrote = json_of(first);
  assert(truth(at(wrote, "ok")), Some(shown(wrote)));
  assert(str(at(wrote, "entry")) == "build.main", Some(shown(wrote)));
  let runnable = read("out/build.run");
  assert(
    string_trim(string_of_bytes(read("out/build.digest"))) != "",
    Some("no digest was written"),
  );
  assert(
    string_len(string_trim(string_of_bytes(read("out/build.key")))) == 64,
    Some("no key a builder takes the runnable under was written"),
  );
  assert(
    str(at(at(wrote, "runnable"), "runnable")) == hex_of(bytes_blake3(runnable)),
    Some("the report does not describe the runnable beside it: " ++ shown(wrote)),
  );
  // The unit's C is the program, so the runnable has to carry the definitions rather than merely
  // exist; unpacked, its C lies in it as written.
  let text = match try_gunzip(runnable, 67108864) {
    Ok(c) -> string_of_bytes_lossy(c),
    Err(refusal) -> panic(f"the runnable does not unpack: {refusal}"),
  };
  // The symbol as the unit's own table publishes it: `<name> <arity> <symbol> <entry>`.
  let symbol = match filter(string_split(text, "\n"), |l: String|
      string_starts_with(l, "\"build.area ")) {
    [line, ..] -> match list_at(string_split(line, " "), 2) {
      Some(s) -> s,
      None -> panic("the table names no symbol"),
    },
    [] -> panic("the unit says what it calls `build.area`"),
  };
  assert(
    string_contains(text, "Word " ++ symbol ++ "(PlyCtx *ctx") && string_contains(text, "ply_bind"),
    Some("the unit does not hold the program it was made from"),
  );
  let verify = on_disk(["bootstrap", working(), "--out", out(), "--verify"]);
  assert(
    verify.code == 0,
    Some("the runnable did not verify against the tree that wrote it:\n" ++ stderr(verify)),
  )
}

// A program the launcher enters is evaluated by no later build, so what writes it keeps the values.
test/nondet "a runnable holds the value of each `const fn` its program holds" {
  project([
    {
      path: "build.ply",
      text: builder() ++ "\nconst fn table() -> List<Int> = [twice(2), twice(3)]\n",
    },
  ]);
  let wrote = on_disk(["bootstrap", working(), "--out", out()]);
  assert(wrote.code == 0, Some(stderr(wrote)));
  let text = match try_gunzip(read("out/build.run"), 67108864) {
    Ok(c) -> string_of_bytes_lossy(c),
    Err(refusal) -> panic(f"the runnable does not unpack: {refusal}"),
  };
  let symbol = match filter(string_split(text, "\n"), |l: String|
      string_starts_with(l, "\"build.table ")) {
    [line, ..] -> match list_at(string_split(line, " "), 2) {
      Some(s) -> s,
      None -> panic("the table names no symbol"),
    },
    [] -> panic("the unit says what it calls `build.table`"),
  };
  assert(
    string_contains(text, "static const char " ++ symbol ++ "_baked[] ="),
    Some("the unit holds `build.table` as a body to run, not as the value a build kept"),
  );
  // A `const fn` that raises refuses the program before anything of it is written.
  write(
    "build.ply",
    builder() ++ "\nconst fn table() -> List<Int> = [twice(2) / (twice(1) - 2)]\n",
  );
  let refused = on_disk(["bootstrap", working(), "--out", working() ++ "/other"]);
  assert(refused.code != 0 && string_contains(stderr(refused), "E0157"), Some(stderr(refused)));
  assert(fs.read_file[cwd]("other/build.run") == None, Some("a refused program was written"))
}

test/nondet "a runnable stops describing a tree that moved" {
  project([{ path: "build.ply", text: builder() }]);
  assert_eq(on_disk(["bootstrap", working(), "--out", out()]).code, 0);
  write("build.ply", builder() ++ "\npub fn added(n: Int) -> Int = n + 1\n");
  assert(
    on_disk(["bootstrap", working(), "--out", out(), "--verify"]).code != 0,
    Some("a definition was added and the runnable still claimed to describe the tree"),
  )
}

test/nondet "a program this binary does not ship is refused" {
  program("pub fn main() -> Unit = ()\n");
  let r = on_disk(["bootstrap", working(), "--out", out()]);
  assert(r.code != 0, Some("a program that is neither the builder nor `ply` was written"));
  assert(string_contains(stderr(r), "no program this binary ships"), Some(stderr(r)))
}
