// `Decimal` is exact, `Float` is IEEE, and neither is ever certified by a rule that does not hold of
// it: a decimal program checks, runs and tests clean, division and overflow are refused, and no
// float law is reported proved.

import harness (scratch, Ran, in_memory, on_disk, one, program, said, stdout, json_of, at, path,
                nth, items, str, int, shown)
import std.json (Json)

fn billing() -> String =
  \\pub type Line = { description: String, unit: Decimal, quantity: Int }
  \\
  \\pub fn line_total(l: Line) -> Decimal = l.unit * decimal_of_int(l.quantity)
  \\
  \\pub fn subtotal(lines: List<Line>) -> Decimal =
  \\  fold(lines, 0m, |acc, l: Line| acc + line_total(l))
  \\
  \\pub fn tax(net: Decimal, rate: Decimal) -> Decimal / {abort.raise} =
  \\  decimal_round(net * rate, 2, HalfEven)
  \\
  \\pub fn total(lines: List<Line>, rate: Decimal) -> Decimal / {abort.raise} =
  \\  subtotal(lines) + tax(subtotal(lines), rate)
  \\
  \\fn coffee() -> Line = { description: "coffee", unit: 3.75m, quantity: 4 }
  \\fn tea() -> Line = { description: "tea", unit: 2.20m, quantity: 3 }
  \\
  \\test "a subtotal is exact to the cent" {
  \\  assert_eq(subtotal([coffee(), tea()]), 21.60m)
  \\}
  \\
  \\test "a tenth plus two tenths is three tenths" {
  \\  assert_eq(0.1m + 0.2m, 0.3m)
  \\}
  \\
  \\test "binary floating point is not" {
  \\  assert(0.1 + 0.2 != 0.3)
  \\}
  \\
  \\test "a rounded tax names its mode" {
  \\  assert_eq(tax(21.60m, 0.0825m), 1.78m)
  \\}
  \\
  \\pub fn main() -> Decimal / {abort.raise} = total([coffee(), tea()], 0.0825m)
  \\

fn clean(r: Ran) -> Ran / {abort.raise} = {
  green(r);
  r
}

fn green(r: Ran) -> Unit / {abort.raise} = assert(r.code == 0, Some(said(r)))

test/nondet "a decimal program checks, runs and tests clean" {
  green(in_memory(one(billing()), ["check"]));
  program(billing());
  let run = clean(on_disk(["run"]));
  assert(
    string_contains(stdout(run), "23.38"),
    Some("21.60 plus 8.25% rounded half-to-even is 23.38: " ++ stdout(run)),
  );
  green(on_disk(["test"]))
}

test "decimal tests are cached exactly as any other are" {
  scratch(|| {
    program(billing());
    green(on_disk(["test"]));
    let report = json_of(clean(on_disk(["test", "--json"])));
    assert(
      int(path(report, ["selection", "selected"])) == 0,
      Some("nothing changed, so nothing re-runs: " ++ shown(report)),
    );
    assert(int(path(report, ["selection", "cached"])) == 4, Some(shown(report)))
  })
}

test "decimal division is E0209 and names decimal_div" {
  let r = in_memory(
    one("pub fn unit(total: Decimal, count: Decimal) -> Decimal / {abort.raise} = total / count\n"),
    ["check"],
  );
  assert(r.code != 0, Some(said(r)));
  assert(string_contains(said(r), "E0209"), Some(said(r)));
  assert(string_contains(said(r), "decimal_div"), Some(said(r)));
  assert(
    string_contains(said(r), "rounding nobody wrote down"),
    Some("the note is the argument, not decoration: " ++ said(r)),
  )
}

fn float_laws() -> String =
  \\pub fn scale(x: Float, k: Float) -> Float = x * k
  \\
  \\// False, at exactly one value.
  \\law "a float equals itself" forall (x: Float) { x == x }
  \\law "scaling by one changes nothing" forall (x: Float) { scale(x, 1.0) == x }
  \\
  \\// True at every `Float` there is, `NaN` included, and still not provable: `==`
  \\// on the type is not reflexive, so the rules that would decide it are unsound
  \\// over it whatever the sentence happens to say.
  \\law "nothing is both above and below itself" forall (x: Float) { !(x < x && x > x) }
  \\law "a float is a float" forall (x: Float, y: Float) where x < y { !(y < x) }
  \\
  \\pub fn main() -> Int = 0
  \\

fn labelled(obligations: List<Json>, label: String) -> Json / {abort.raise} =
  match filter(obligations, |o: Json| string_contains(str(at(o, "label")), label)) {
    [o, ..] -> o,
    [] -> panic("no obligation labelled `" ++ label ++ "`"),
  }

// Two laws false only at `NaN` and two true everywhere: the shape most likely to produce a wrong
// `proved`.
test "no float law is ever reported proved" {
  scratch(|| {
    program(float_laws());
    let report = json_of(on_disk(["prove", "--json"]));
    let obligations = items(at(report, "obligations"));
    assert(len(obligations) == 4, Some(shown(report)));
    fold(obligations, (), |u: Unit, o: Json|
      assert(
        str(at(o, "tier")) != "proved",
        Some("a Float obligation was certified: " ++ shown(o)),
      ));
    assert(int(path(report, ["summary", "proved"])) == 0, Some(shown(report)));
    // The counterexample to `x == x` is the value the type is defined by.
    let refuted = labelled(obligations, "equals itself");
    assert(str(at(refuted, "outcome")) == "refuted", Some(shown(refuted)));
    assert(
      str(at(nth(path(refuted, ["counterexample", "bindings"]), 0), "value")) == "NaN",
      Some(shown(refuted)),
    )
  })
}

// `Decimal`'s `==` is an equivalence relation, so the refusal above is about `Float`.
test "a decimal congruence is proved and decimal arithmetic is not" {
  scratch(|| {
    program(
      \\pub fn rounded(d: Decimal) -> Decimal = d
      \\
      \\law "a decimal congruence" forall (x: Decimal) { rounded(x) == rounded(x) }
      \\law "a decimal zero is additive" forall (x: Decimal) { x + 0m == x }
      \\
      \\pub fn main() -> Int = 0
      \\
    );
    let report = json_of(on_disk(["prove", "--json"]));
    let obligations = items(at(report, "obligations"));
    assert(str(at(labelled(obligations, "congruence"), "tier")) == "proved", Some(shown(report)));
    assert(str(at(labelled(obligations, "additive"), "tier")) != "proved", Some(shown(report)))
  })
}

// `-0.0` is the value most likely to make the engines disagree.
test "the two engines agree over the numeric types" {
  scratch(|| {
    program(
      \\fn signed_zero() -> Float = 0.0 - 0.0
      \\fn inverted() -> Float = 1.0 / (0.0 - 0.0)
      \\
      \\test "float arithmetic answers what it should" {
      \\  assert(inverted() == 1.0 / signed_zero());
      \\  assert_eq(0.1m + 0.2m, 0.3m);
      \\  assert(0.1 + 0.2 != 0.3)
      \\}
      \\
      \\pub fn main() -> Int = 0
      \\
    );
    green(on_disk(["test"]))
  })
}

test "a decimal overflow is reported rather than absorbed" {
  scratch(|| {
    program(
      \\fn ceiling() -> Decimal = 79228162514264337593543950335m
      \\
      \\test "an exact type refuses to lose a digit" {
      \\  assert_eq(ceiling() + 1m, ceiling())
      \\}
      \\
      \\pub fn main() -> Int = 0
      \\
    );
    let r = on_disk(["test"]);
    assert(r.code != 0, Some(said(r)));
    assert(string_contains(said(r), "`Decimal` overflow in addition"), Some(said(r)));
    assert(
      string_contains(said(r), "will not round to make room"),
      Some("the note is what separates this from a wrap: " ++ said(r)),
    )
  })
}
