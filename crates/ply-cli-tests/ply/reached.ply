//! The standard library and the compiler, each checked as the project it is: a definition nothing
//! reaches is one to delete, and only this run checks the measures their own definitions state.

import harness (Reached, Repo, Shipped, at, items, json_of, on_disk, repo, str)
import std.json (Json)
import std.string

fn checks_and_reaches_all(dir: String) -> Unit / {Reached, Shipped, Repo, abort.raise, diverges} = {
  let v = json_of(on_disk(["check", "--json", repo() ++ "/" ++ dir]));
  let found = fold(items(at(v, "diagnostics")), [], |a: List<String>, d: Json|
    if str(at(d, "code")) == "W0611" || str(at(d, "severity")) == "error" {
      push(a, str(at(d, "code")) ++ " " ++ str(at(d, "message")))
    } else { a });
  assert(
    found == [],
    Some(
      dir ++ " has errors, or definitions nothing reaches, which are to be deleted:\n  "
        ++ string::join(found, "\n  "),
    ),
  )
}

test/nondet "the standard library checks, and carries no definition nothing reaches" {
  checks_and_reaches_all("crates/ply-std/ply")
}

test/nondet "the compiler checks, and carries no definition nothing reaches" {
  checks_and_reaches_all("crates/ply-compiler/ply")
}
