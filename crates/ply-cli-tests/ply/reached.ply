// The standard library and the compiler, each checked as the project it is: a definition nothing
// reaches is one to delete, and only this run checks the measures their own definitions state.

import harness (at, items, json_of, on_disk, repo, str)
import std.json (Json)
import std.string

test/nondet "the standard library and the compiler check, and carry no definition nothing reaches" {
  let found = fold(
    ["crates/ply-std/ply", "crates/ply-compiler/ply"],
    [],
    |acc: List<String>, dir: String| {
      let v = json_of(on_disk(["check", "--json", repo() ++ "/" ++ dir]));
      fold(items(at(v, "diagnostics")), acc, |a: List<String>, d: Json|
        if str(at(d, "code")) == "W0611" || str(at(d, "severity")) == "error" {
          push(a, dir ++ ": " ++ str(at(d, "code")) ++ " " ++ str(at(d, "message")))
        } else { a })
    },
  );
  assert(
    found == [],
    Some(
      "errors, or definitions nothing reaches, which are to be deleted:\n  "
        ++ string::join(found, "\n  "),
    ),
  )
}
