//! A project's `ply.pkg`: none is the anonymous package, a well-formed one loads, and each way of
//! being malformed is refused where it stands.

import harness (scratch, Source, Ran, in_memory, on_disk, tree, project, stderr, Hermetic, Shipped)

fn good() -> String =
  \\import std.pkg (Manifest)
  \\fn package() -> Manifest = {name: "app", version: {major: 0, minor: 1, patch: 0}, prefix: None, runtime: {major: 0, minor: 1, patch: 0}, dependencies: [], entry: None}
  \\

fn files(manifest: Option<String>) -> List<Source> = {
  let module = [{ path: "m.ply", text: "fn main() -> Int = 1\n" }];
  match manifest { Some(m) -> push(module, { path: "ply.pkg", text: m }), None -> module }
}

fn checked(manifest: Option<String>) -> Ran / {Hermetic, Shipped, abort.raise, diverges} =
  in_memory(tree(files(manifest)), ["check"])

test "a project without a manifest is the anonymous package" {
  let r = checked(None);
  assert(r.code == 0, Some(stderr(r)))
}

test "a well-formed manifest loads on both paths" {
  scratch(|| {
    assert_eq(checked(Some(good())).code, 0);
    project(files(Some(good())));
    let tested = on_disk(["test"]);
    assert(tested.code == 0, Some(stderr(tested)))
  })
}

test "a manifest that is not one manifest fn is refused where it stands" {
  let r = checked(Some("fn package() -> Int = 1\n"));
  assert_eq(r.code, 2);
  assert(string_contains(stderr(r), "E0129"), Some(stderr(r)));
  assert(string_contains(stderr(r), "ply.pkg"), Some(stderr(r)))
}

test "a manifest body that runs is not a value" {
  scratch(|| {
    project(
      files(
        Some(
          \\import std.pkg (Manifest)
          \\fn package() -> Manifest = {name: greet("x"), version: {major: 0, minor: 0, patch: 1}, prefix: None, runtime: {major: 0, minor: 0, patch: 1}, dependencies: [], entry: None}
          \\
        ),
      ),
    );
    let r = on_disk(["test"]);
    assert_eq(r.code, 2);
    assert(string_contains(stderr(r), "E0130"), Some(stderr(r)))
  })
}

test "a manifest field that fails validation is named" {
  let r = checked(
    Some(
      \\import std.pkg (Manifest)
      \\fn package() -> Manifest = {name: "", version: {major: 0, minor: 0, patch: 1}, prefix: None, runtime: {major: 0, minor: 0, patch: 1}, dependencies: [], entry: None}
      \\
    ),
  );
  assert_eq(r.code, 2);
  assert(string_contains(stderr(r), "E0131"), Some(stderr(r)));
  assert(string_contains(stderr(r), "`name` must not be empty"), Some(stderr(r)))
}

test "a manifest with a syntax error reports the parse" {
  let r = checked(Some("fn package() -> Manifest = {name: \"app\"\n"));
  assert_eq(r.code, 2);
  assert(!string_contains(stderr(r), "E0129"), Some(stderr(r)));
  assert(
    string_contains(stderr(r), "E0001") || string_contains(stderr(r), "E0002"),
    Some(stderr(r)),
  )
}
