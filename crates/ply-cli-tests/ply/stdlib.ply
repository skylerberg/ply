//! The shipped modules as a project meets them: imported, checked, bound, hashed, tested and proved
//! like its own, under a prefix no project may take, and never counted as the project's.

import harness (scratch, Ran, Source, project, program, write, read, shipped_sources, in_memory,
                one, tree, on_disk, warm_agrees, seeding, said, stdout, stderr, json_of, at, path,
                nth, items, first, str, int, truth, shown, Hermetic, Reached, Repo, Shipped,
                inspected, reader_source, repo_file, std_tree, std_data, on_disk_shipping,
                over_tree, spawned, assert_ok, codes)
import compiler.front (shipped_data_wanted)
import compiler.items (parse, Item, IFn, IType, IEffect, IEffectSet, ISchema, OpDef, TDAlias,
                       is_pub)
import compiler.lexer (lex, Identifier, Token)
import compiler.parsing (Doc, Ident)
import compiler.type_syntax (TypeExpr, TRecord)
import compiler.unit (shipped)
import std.fs (MemFs)
import std.json (Json, Null)
import std.json
import std.list (sort, sort_by)
import std.process (process, Exited)
import std.string
import std.text (shell_join)

/// Handles every atom it can perform, so its test is `det` and cacheable.
fn importer() -> String =
  \\import std.net (net, drain)
  \\
  \\fn touch(port: Int) -> Int / {net.listen[listener], net.close[listener]} {
  \\  let l = net.listen[listener](port);
  \\  net.close[listener](l);
  \\  l
  \\}
  \\
  \\test "the imported effect is handled in memory" {
  \\  handle {
  \\    assert_eq(touch(8080), 3)
  \\  } with {
  \\    net.listen[listener](p) -> 3,
  \\    net.close[listener](l) -> (),
  \\  }
  \\}
  \\

fn app(text: String) -> MemFs / {abort.raise} = tree([{ path: "app.ply", text: text }])

fn checked(t: MemFs) -> Json / {Hermetic, Shipped, abort.raise, diverges} =
  json_of(in_memory(t, ["check", "--json"]))

fn named(list: Json, name: String) -> Option<Json> =
  match filter(items(list), |d: Json| str(at(d, "name")) == name) { [d, ..] -> Some(d), [] -> None }

fn has_named(list: Json, name: String) -> Bool = named(list, name) != None

/// A definition's hash, as `ply hash --json` gives it.
fn hash_of(answer: Json, name: String) -> String / {abort.raise} =
  match named(at(answer, "definitions"), name) {
    Some(d) -> str(at(d, "hash")),
    None -> panic("`" ++ name ++ "` is not in the program: " ++ shown(answer)),
  }

fn hashed(t: MemFs) -> Json / {Hermetic, Shipped, abort.raise, diverges} =
  json_of(in_memory(t, ["hash", "--json"]))

fn tests_hashed(answer: Json) -> List<String> =
  map(items(at(answer, "tests")), |t: Json| str(at(t, "hash")))

/// What `ply cache inspect` says is filed for `name`: each match's file.
fn filed_files(name: String) -> List<String> / {Reached, Shipped, abort.raise, diverges} =
  map(items(at(json_of(on_disk(["cache", "inspect", name, "--json"])), "matches")), |m: Json|
    str(at(m, "file")))

test "a project module can import std.net and it checks" {
  let answer = checked(app(importer()));
  assert(truth(at(answer, "ok")), Some(shown(answer)));
  assert(
    has_named(at(answer, "modules"), "std.net"),
    Some("the shipped module is not in the program"),
  );
  // `ply_host::tcp` registers against the program-wide name, qualified by the declaring module.
  assert(
    len(
        filter(items(at(answer, "effects")), |e: Json|
          str(at(e, "module")) == "std.net" && str(at(e, "name")) == "std.net.net"),
      )
      == 1,
    Some(shown(at(answer, "effects"))),
  );
  assert(has_named(at(answer, "definitions"), "std.net.drain"), None);
  // The row a host handler binds against, written in the qualified name.
  match named(at(answer, "definitions"), "app.touch") {
    Some(touch) ->
      assert_eq(
        str(at(touch, "footprint")),
        "{std.net.net.close[listener], std.net.net.listen[listener]}",
      ),
    None -> panic("`app.touch` is in the program"),
  }
}

test "a shipped module whose type states a key and its arithmetic loads where nothing of it is used" {
  scratch(|| {
    // The type is read whether or not the program reaches it, so the functions it states are too.
    program("import std.bigint\n\nfn main() -> Int = 1\n\ntest \"one\" { assert_eq(main(), 1) }\n");
    let checked = on_disk(["check"]);
    assert(checked.code == 0, Some(said(checked)));
    let r = on_disk(["test"]);
    assert(r.code == 0 && string_contains(said(r), "1 passed"), Some(said(r)));
    // Used only where an operator and a comparison reach them, they are the same functions.
    write(
      "m.ply",
      "import std.bigint (BigInt)\n\nfn same(a: BigInt, b: BigInt) -> Bool = a + b == b + a\n\nfn main() -> Int = 1\n",
    );
    let used = on_disk(["check"]);
    assert(used.code == 0, Some(said(used)))
  })
}

test "a project that imports std.net tests green" {
  scratch(|| {
    program(importer());
    let r = on_disk(["test"]);
    assert(r.code == 0, Some("got:\n" ++ said(r)));
    assert(string_contains(said(r), "the imported effect is handled"), Some(said(r)))
  })
}

test "ply hosts binds the shipped declaration under its qualified name" {
  scratch(|| {
    project([{ path: "app.ply", text: importer() }]);
    let r = on_disk(["hosts", "--host", "--json"]);
    assert(r.code == 0, Some("got:\n" ++ said(r)));
    let rows = items(at(json_of(r), "hosts"));
    assert(rows != [], Some("nothing bound: " ++ said(r)));
    assert(
      len(filter(rows, |row: Json| str(at(row, "effect")) != "std.net.net")) == 0,
      Some(said(r)),
    );
    assert(
      len(filter(rows, |row: Json| str(at(row, "triple")) == "std.net.net.listen[listener]")) > 0,
      Some(said(r)),
    );
    // A program declaring its own `net` reaches no handler: the registration names `std.net.net`
    // only.
    project([
      {
        path: "app.ply",
        text: "nondet effect net {\n  write listen[s](port: Int) -> Int\n}\nfn f() -> Int / {net.write[listener]} = net.listen[listener](1)\n",
      },
    ]);
    let other = on_disk(["hosts", "--host"]);
    assert(
      string_contains(said(other), "none serves an atom this program performs"),
      Some("a copied declaration must not bind:\n" ++ said(other)),
    )
  })
}

test "a project file under std collides with the built-in package" {
  let answer = checked(tree([{ path: "std/json.ply", text: "pub fn parse() -> Int = 1\n" }]));
  let diagnostics = items(at(answer, "diagnostics"));
  assert(len(diagnostics) == 1, Some(shown(answer)));
  let d = first(diagnostics);
  assert(str(at(d, "code")) == "E0133", Some(shown(d)));
  assert(string_contains(str(at(d, "message")), "std.json"), Some(shown(d)));
  assert(
    items(at(d, "labels")) != [],
    Some("E0133 must point at the file it is about: " ++ shown(d)),
  )
}

// Easy to miss when the rule is written as a prefix check.
test "a project file named std also collides" {
  let answer = checked(tree([{ path: "std.ply", text: "pub fn f() -> Int = 1\n" }]));
  assert(str(at(first(items(at(answer, "diagnostics"))), "code")) == "E0133", Some(shown(answer)));
  // And a name that merely starts with the letters is no collision.
  let ok = in_memory(tree([{ path: "stdlib.ply", text: "pub fn f() -> Int = 1\n" }]), ["check"]);
  assert(ok.code == 0, Some("`stdlib` is an ordinary module name: " ++ said(ok)))
}

test "importing a module that does not ship lists the ones that do" {
  let answer = checked(app("import std.nonesuch\nfn f() -> Int = 1\n"));
  let d = first(items(at(answer, "diagnostics")));
  assert(str(at(d, "code")) == "E0106", Some(shown(d)));
  assert(string_contains(shown(d), "std.net"), Some(shown(d)));
  assert(
    items(at(d, "labels")) != [],
    Some("the diagnostic must point at the import: " ++ shown(d)),
  )
}

fn rendering(u: String) -> String =
  "import std.uuid (Uuid, uuid_render)\npub fn shown(b: Bytes) -> String / {abort.raise} = {\n  let u"
    ++ u
    ++ " = { octets: b };\n  uuid_render(u)\n}\n"

test "a record with a `Uuid`'s field is no `Uuid`, and only `std.uuid` builds one" {
  let closed = first(items(at(checked(app(rendering(": Uuid"))), "diagnostics")));
  assert(str(at(closed, "code")) == "E0220", Some(shown(closed)));
  assert(string_contains(shown(closed), "uuid_of_octets"), Some(shown(closed)));
  let d = first(items(at(checked(app(rendering(""))), "diagnostics")));
  assert(str(at(d, "code")) == "E0201", Some(shown(d)));
  assert(string_contains(shown(d), "std.uuid.Uuid"), Some(shown(d)));
  let built = "import std.uuid (uuid_of_octets, uuid_render)\npub fn shown(b: Bytes) -> Option<String> / {abort.raise} =\n  match uuid_of_octets(b) { Some(u) -> Some(uuid_render(u)), None -> None }\n";
  assert_eq(items(at(checked(app(built)), "diagnostics")), [])
}

test "a program importing nothing from std loads nothing" {
  let answer = checked(app("fn f() -> Int = 1\n"));
  assert(len(items(at(answer, "modules"))) == 1, Some(shown(answer)));
  assert(
    len(
        filter(items(at(answer, "definitions")), |d: Json|
          string_starts_with(str(at(d, "name")), "std.")),
      )
      == 0,
    Some(shown(answer)),
  );
  assert(len(items(at(answer, "files"))) == 1, Some(shown(answer)))
}

fn net() -> String / {abort.raise} = string_of_bytes(embed("../../ply-std/ply/net.ply"))

test "copying a shipped module into a project produces identical hashes" {
  scratch(|| {
    let shipped = hashed(app(importer()));
    let copied_tree = tree([
      { path: "mine.ply", text: net() },
      {
        path: "app.ply",
        text: string::replace(
          importer(),
          "import std.net (net, drain)",
          "import mine (net, drain)",
        ),
      },
    ]);
    let copied = hashed(copied_tree);
    assert(
      hash_of(shipped, "std.net.drain") == hash_of(copied, "mine.drain"),
      Some("a stdlib definition must hash like a project one"),
    );
    // A reference contributes the referent's hash, so the importer is one definition in both
    // programs.
    assert_eq(hash_of(shipped, "app.touch"), hash_of(copied, "app.touch"));
    // An effect declaration is a declaration like any other, as the cache files it.
    program(importer());
    assert(on_disk(["check"]).code == 0, None);
    let shipped_net = str(at(inspected("std.net.net"), "hash"));
    project([
      { path: "mine.ply", text: net() },
      {
        path: "app.ply",
        text: string::replace(
          importer(),
          "import std.net (net, drain)",
          "import mine (net, drain)",
        ),
      },
    ]);
    assert(on_disk(["check"]).code == 0, None);
    assert(
      str(at(inspected("mine.net"), "hash")) == shipped_net,
      Some("an effect declaration is a declaration like any other"),
    )
  })
}

test "a shipped module is filed under its pseudo-path" {
  scratch(|| {
    program(importer());
    let r = on_disk(["check"]);
    assert(r.code == 0, Some(said(r)));
    // Filed under the name a shipped module is keyed by, which no file on disk has.
    assert_eq(filed_files("std.net.drain"), ["<std>/net.ply"])
  })
}

test "a warm check agrees with a cold one over a program that imports std" {
  scratch(|| {
    project([{ path: "app.ply", text: importer() }]);
    let _ = warm_agrees("cold");
    let warm = warm_agrees("warm");
    assert(
      has_named(at(warm, "definitions"), "std.net.drain"),
      Some("the shipped module is part of the answer: " ++ shown(warm)),
    )
  })
}

/// A project of one module, checked beside an empty cache and again beside what that check filed,
/// each time answering what a check of the same sources in memory does: the seeded answer.
fn checked_cold_and_warm(
  text: String,
) -> Json / {Reached, Hermetic, Shipped, abort.raise, diverges} = {
  project([{ path: "app.ply", text: text }]);
  let _ = warm_agrees("cold");
  warm_agrees("warm")
}

// `std.gzip` declares `effect gzip` beside `fn gzip`, and its readers raise through the effect.
test "a program importing only a reader of std.gzip loads the reader and no writer" {
  scratch(|| {
    let answer = checked_cold_and_warm(
      "import std.gzip (try_gunzip)\n\npub fn opens(data: Bytes) -> Bool / {abort.raise} =\n  match try_gunzip(data, 64) { Ok(_) -> true, Err(_) -> false }\n",
    );
    let loaded = at(answer, "definitions");
    assert(
      has_named(loaded, "std.gzip.try_gunzip") && !has_named(loaded, "std.gzip.deflate"),
      Some(shown(loaded)),
    )
  })
}

test "a program importing only std.gzip's writer loads it with what it calls" {
  scratch(|| {
    let answer = checked_cold_and_warm(
      "import std.gzip (gzip)\n\npub fn packed(data: Bytes) -> Bytes / {abort.raise} = gzip(data)\n",
    );
    let loaded = at(answer, "definitions");
    assert(
      has_named(loaded, "std.gzip.gzip") && has_named(loaded, "std.gzip.deflate")
        && !has_named(loaded, "std.gzip.try_gunzip"),
      Some(shown(loaded)),
    )
  })
}

test "renaming a project definition that calls std moves no hash" {
  let before = hashed(app(importer()));
  let after = hashed(app(string::replace(importer(), "touch", "poke")));
  assert(
    hash_of(before, "app.touch") == hash_of(after, "app.poke"),
    Some("renaming a definition changed its hash"),
  );
  assert_eq(hash_of(before, "std.net.drain"), hash_of(after, "std.net.drain"));
  assert(tests_hashed(before) == tests_hashed(after), Some("a test re-runs"))
}

test "a shipped module's tests are not a project's" {
  scratch(|| {
    let shipped = fold(
      items(at(json_of(in_memory(app(importer()), ["std", "--json"])), "modules")),
      0,
      |n: Int, m: Json| if str(at(m, "module")) == "std.net" { int(at(m, "tests")) } else { n },
    );
    assert(shipped > 0, Some("the fixture needs a shipped test to hide"));
    program(importer());
    let v = json_of(on_disk(["test", "--json"]));
    assert(int(path(v, ["selection", "total"])) == 1, Some(shown(v)));
    // A shipped test was never in this project's denominator, so it is not "filtered out" either.
    assert(int(path(v, ["selection", "filtered_out"])) == 0, Some(shown(v)));
    let all = json_of(on_disk(["test", "--std", "--json"]));
    assert(int(path(all, ["selection", "total"])) == 1 + shipped, Some(shown(all)));
    assert(int(at(all, "exit_code")) == 0, Some(shown(all)));
    // The run wrote nothing about the shipped test, so `--std` still has work to do.
    assert(int(path(all, ["selection", "cached"])) == 1, Some(shown(all)));
    assert(int(path(all, ["selection", "selected"])) == shipped, Some(shown(all)))
  })
}

// A stdlib `main` would make `ply run` ambiguous in a directory the user did not write.
test "entry points exclude the shipped modules" {
  scratch(|| {
    project([{ path: "app.ply", text: "import std.net (net)\nfn main() -> Int = 1\n" }]);
    let r = on_disk(["run"]);
    assert(r.code == 0, Some(said(r)));
    assert(
      string_trim(match list_at(r.out, len(r.out) - 1) { Some(l) -> l, None -> "" }) == "1",
      Some(said(r)),
    )
  })
}

/// The shipped modules in the table's order: sorted, as they are filed.
fn shipped_modules() -> List<Source> / {Shipped, abort.raise} =
  sort_sources(
    map(
      filter(shipped_sources(), |source: Source| string_starts_with(source.path, "std.")),
      |source: Source|
        { path: string_slice(source.path, 0, string_len(source.path) - 4), text: source.text },
    ),
  )

fn sort_sources(xs: List<Source>) -> List<Source> =
  sort_by(xs, |a: Source, b: Source| compare(a.path, b.path) == Less)

test "ply std lists the modules and prints a stable digest" {
  let t = app("fn f() -> Int = 1\n");
  let listing = in_memory(t, ["std"]);
  assert(listing.code == 0, Some("got:\n" ++ said(listing)));
  fold(["std.net", "std.json", "digest: b3:"], (), |u: Unit, needle: String|
    assert(string_contains(said(listing), needle), Some("got:\n" ++ said(listing))));
  let digest = || stdout(in_memory(t, ["std", "--digest"]));
  let once = digest();
  assert(once == digest(), Some("the digest moved between two runs"));
  assert(string_starts_with(once, "b3:"), Some(once));
  assert(string_len(string_trim(once)) == 15, Some(once));
  assert(
    string_contains(said(listing), string_trim(once)),
    Some("the two forms disagree:\n" ++ said(listing)),
  );
  let v = json_of(in_memory(t, ["std", "--json"]));
  assert(str(at(v, "digest")) == string_trim(once), Some(shown(v)));
  let listed = map(items(at(v, "modules")), |m: Json| str(at(m, "module")));
  assert(
    listed == map(shipped_modules(), |source: Source| source.path),
    Some("got:\n" ++ said(listing)),
  );
  fold(items(at(v, "modules")), (), |u: Unit, m: Json|
    assert(
      int(at(m, "definitions")) >= 1,
      Some("`" ++ str(at(m, "module")) ++ "` lists no definitions"),
    ))
}

test "ply std show written bare prints every shipped source" {
  let t = app("fn f() -> Int = 1\n");
  let r = in_memory(t, ["std", "--show"]);
  assert(r.code == 0, Some("got:\n" ++ said(r)));
  let every = fold(shipped_modules(), "", |acc: String, s: Source| acc ++ s.text);
  assert(stdout(r) == every, Some("`--show` did not print every source, back to back"));
  let v = json_of(in_memory(t, ["std", "--show", "--json"]));
  assert(
    map(items(at(v, "sources")), |s: Json| str(at(s, "module")))
      == map(shipped_modules(), |s: Source| s.path),
    Some(shown(v)),
  )
}

/// The `W0605` notices a `ply check` gives.
fn stdlib_notices() -> List<Json> / {Reached, Shipped, abort.raise, diverges} =
  filter(items(at(json_of(on_disk(["check", "--json"])), "diagnostics")), |d: Json|
    str(at(d, "code")) == "W0605")

test "neither a cold cache nor a warm one warns about the stdlib" {
  scratch(|| {
    project([{ path: "app.ply", text: importer() }]);
    assert(stdlib_notices() == [], Some("cold"));
    assert(stdlib_notices() == [], Some("warm"))
  })
}

fn test_hash(answer: Json, label: String) -> String / {abort.raise} =
  match filter(items(at(answer, "tests")), |t: Json| string_ends_with(str(at(t, "key")), label)) {
    [t, ..] -> str(at(t, "hash")),
    [] -> panic("no test labelled `" ++ label ++ "`"),
  }

test "editing one shipped definition moves exactly what reaches it" {
  let elsewhere = {
    path: "elsewhere.ply",
    text: "pub fn untouched() -> Int = 41 + 1\ntest \"untouched\" { assert_eq(untouched(), 42) }\n",
  };
  let before = hashed(
    tree([
      { path: "mine.ply", text: net() },
      { path: "reader.ply", text: reader_source("drain") },
      elsewhere,
    ]),
  );
  // The edit a compiler upgrade would make: one definition's body, nothing else in the module.
  let edited = string::replace(
    net(),
    "net.recv[l](c, 4096, timeout_ms)",
    "net.recv[l](c, 8192, timeout_ms)",
  );
  assert(edited != net(), Some("the edit landed"));
  let after = hashed(
    tree([
      { path: "mine.ply", text: edited },
      { path: "reader.ply", text: reader_source("drain") },
      elsewhere,
    ]),
  );
  assert(
    hash_of(before, "mine.drain") != hash_of(after, "mine.drain"),
    Some("the edited definition"),
  );
  assert(
    hash_of(before, "reader.read_all") != hash_of(after, "reader.read_all"),
    Some("a reference contributes the referent's hash, so a caller moves with it"),
  );
  // Everything else stands: the module's other definitions, and a module that reaches none of them.
  fold(["mine.head", "mine.tail", "elsewhere.untouched"], (), |u: Unit, name: String|
    assert(hash_of(before, name) == hash_of(after, name), Some(name)));
  // And the tests: exactly the one that reaches the edit is re-selected.
  assert(test_hash(before, "reads") != test_hash(after, "reads"), None);
  assert(test_hash(before, "untouched") == test_hash(after, "untouched"), None)
}

// `ply cache compact` walks the files on disk, and a shipped module has none.
test "compaction keeps the shipped modules it loaded" {
  scratch(|| {
    program(importer());
    let _ = on_disk(["test"]);
    assert(
      filed_files("std.net.drain") == ["<std>/net.ply"],
      Some("the run recorded nothing to compact"),
    );
    let r = on_disk(["cache", "compact"]);
    assert(r.code == 0, Some("got:\n" ++ said(r)));
    assert(
      filed_files("std.net.drain") == ["<std>/net.ply"],
      Some("compaction dropped a module this binary still ships"),
    )
  })
}

test "programs that reach different functions of one shipped module share what a load keeps of it" {
  scratch(|| {
    project([
      {
        path: "a.ply",
        text: "import std.json (Json, array)\nimport std.process (process)\n\npub fn main() -> Json = array([])\n",
      },
      {
        path: "b.ply",
        text: "import std.json (Json, int)\nimport std.fs (fs)\n\npub fn main() -> Json = int(1)\n",
      },
      {
        path: "c.ply",
        text: "import std.json (Json, array)\n\npub fn twice() -> Json = array([array([])])\n",
      },
    ]);
    // `b` reads `std.json` through what `a` kept and keeps it again beside modules `a` never
    // pulled; `c` reads it through that.
    fold(["a.ply", "b.ply", "c.ply"], (), |u: Unit, file: String| {
      let r = on_disk(["check", file]);
      assert(r.code == 0, Some(said(r)))
    })
  })
}

// CI runs the standard library's own tests and laws as `ply test --std` and `ply prove --std` over
// the corpus program that imports every module of it, each answered by its own key.
test/nondet "the corpus program that runs the standard library's own tests imports every module" {
  let imported = sort(
    fold(
      string::split(repo_file("crates/ply-corpus/stdlib/stdlib.ply"), "\n"),
      [],
      |acc: List<String>, line: String|
        if string_starts_with(line, "import ") {
          push(acc, string_slice(line, 7, string_len(line)))
        } else { acc },
    ),
  );
  let shipped_std = sort(filter(shipped.names(), |n: String| string_starts_with(n, "std.")));
  assert(
    imported == shipped_std,
    Some("imported: " ++ shown_names(imported) ++ "\nshipped: " ++ shown_names(shipped_std)),
  )
}

fn shown_names(names: List<String>) -> String = string::join(names, " ")

/// Words a shell reads into, or takes for its own where a command's name stands.
fn hostile_words() -> List<String> =
  [
    "",
    "plain",
    "a b",
    "it's",
    "'",
    "\"",
    "$HOME",
    "$(echo hi)",
    "`echo hi`",
    "a\\b",
    "\\",
    "a\nb",
    "a\tb",
    "x\ry",
    "*",
    "?",
    "[a-z]",
    "{a,b}",
    "~",
    "~root",
    "#x",
    "!x",
    "a;b",
    "a|b",
    "a&b",
    "a>b",
    "<",
    "(x)",
    "CC=gcc",
    "=ls",
    "--jobs=4",
    "-",
    "--",
    "if",
    "time",
    "{",
    "%1",
    "caf\u{e9}",
    "a\u{3000}b",
    "a'b\"c$d`e\\f",
  ]

// `std.text` holds its quoting to its own reader; only a shell can say a shell reads it so.
test/nondet "sh reads back every word std.text quotes for it, and takes none for its own grammar" {
  let line = |words: List<String>| match shell_join(words) { Some(l) -> l, None -> "" };
  let read = process.spawn[sh](["-c", "printf '%s\\001' " ++ line(hostile_words())], "", []);
  assert_eq(
    read.out,
    bytes_of_string(string::join(map(hostile_words(), |word: String| word ++ "\u{1}"), "")),
  );
  fold(
    ["if", "then", "do", "done", "for", "while", "case", "{", "}", "!", "CC=gcc"],
    (),
    |_: Unit, word: String| {
      let named = process.spawn[sh](["-c", line([word, "true"])], "", []);
      assert(named.ended == Exited(127), Some(word ++ " was read as the shell's own"))
    },
  )
}

test "a shipped module's laws are not a project's" {
  scratch(|| {
    program("import std.json\npub fn twice(n: Int) -> Int ensures result == n + n = n * 2\n");
    let mine = json_of(on_disk(["prove", "--json"]));
    let all = json_of(on_disk(["prove", "--std", "--json"]));
    assert(int(at(mine, "exit_code")) == 0, Some(shown(mine)));
    let owners = map(items(at(mine, "obligations")), |o: Json| str(at(o, "owner")));
    assert(owners == ["app.twice"] || owners == ["m.twice"], Some(shown(mine)));
    assert(len(items(at(all, "obligations"))) > len(owners), Some("`--std` adds nothing"));
    // The coverage denominator is the project's definitions, not the stdlib's.
    assert(int(path(mine, ["coverage", "definitions"])) == 1, Some(shown(mine)));
    assert(int(path(all, ["coverage", "definitions"])) > 100, Some(shown(at(all, "coverage"))))
  })
}

fn routed(literal: String) -> String =
  "import std.router\nimport std.http\npub type Endpoint = Health | GetItem\npub fn table() -> List<router::Route<Endpoint>> / {abort.raise} = [\n  {method: http::Get, path: router::pattern_of_string(\"/health\"), endpoint: Health},\n  {method: http::Get, path: router::pattern_of_string(\"/items/{sku}\"), endpoint: GetItem},\n]\npub fn slug(s: String) -> String = string_concat(\""
    ++ literal
    ++ "\", s)\npub fn hits(p: String) -> Bool / {abort.raise} =\n  match router::route(table(), http::Get, p) {\n    router::Found(_) -> true,\n    _ -> false,\n  }\ntest \"the table routes an item\" { assert_eq(hits(slug(\"bolt\")), true) }\n"

// A shipped module's tests are never resolved without `--std`, so its definitions must not stay
// permanently "changed".
test "a shipped definition the project never touched is not a suspect" {
  scratch(|| {
    project([{ path: "app.ply", text: routed("/items/") }]);
    let first_run = on_disk(["test"]);
    assert(first_run.code == 0, Some(said(first_run)));
    // One edit, to one definition the project owns.
    write("app.ply", routed("/goods/"));
    let v = json_of(on_disk(["test", "--json"]));
    let failure = nth(at(v, "failures"), 0);
    let suspects = map(items(at(failure, "suspects")), |s: Json| str(at(s, "name")));
    assert(suspects != [], Some("the edit has to be attributed to something: " ++ shown(v)));
    let shipped = filter(suspects, |n: String| string_starts_with(n, "std."));
    assert(
      shipped == [],
      Some(
        "nothing under `std` moved, so nothing under `std` is a suspect: "
          ++ string::join(shipped, ", "),
      ),
    );
    assert(str(nth(path(failure, ["culprit", "definitions"]), 0)) == "app.slug", Some(shown(v)))
  })
}

// --- A shipped module's data --------------------------------------------------------------------

/// A program over `std.oid`, which embeds `oid/names.txt`: `named` reaches the table a build makes
/// of the file, and `plain` a constant of the module that reaches none of it.
fn naming() -> String =
  \\import std.oid
  \\
  \\pub fn named() -> Option<String> = oid::name(oid::common_name())
  \\
  \\pub fn plain() -> Int = len(oid::arcs(oid::common_name()))
  \\
  \\fn main() -> Int = match named() { Some(n) -> string_len(n), None -> 0 }
  \\
  \\test "named" { assert_eq(named(), Some("commonName")) }
  \\

fn last_line(ran: Ran) -> String =
  string_trim(match list_at(ran.out, len(ran.out) - 1) { Some(l) -> l, None -> "" })

/// The data file `std.oid` embeds, under the name the shipped modules hold it by, as the tree has it.
fn oid_names() -> Source / {abort.raise} =
  match filter(std_data(), |d: { name: String, bytes: Bytes }| d.name == "std/oid/names.txt") {
    [d, ..] -> { path: d.name, text: string_of_bytes(d.bytes) },
    [] -> panic("the standard library's tree holds no `oid/names.txt`"),
  }

test "a program runs what a shipped module embedded, from the binary and from a built artifact" {
  scratch(|| {
    program(naming());
    assert_ok(on_disk(["check"]));
    let ran = on_disk(["run"]);
    assert(ran.code == 0 && last_line(ran) == "10", Some(said(ran)));
    let tested = on_disk(["test"]);
    assert(tested.code == 0 && string_contains(said(tested), "1 passed"), Some(said(tested)));
    assert_ok(on_disk(["build", ".", "-o", "m.plyx"]));
    let built = on_disk(["run", "m.plyx"]);
    assert(built.code == 0 && last_line(built) == "10", Some(said(built)))
  })
}

// The launcher lays the file out below the modules, and the program reads it off that directory.
test/nondet "a `ply` of its own reads the data file a shipped module embeds" {
  program(naming());
  let ran = spawned(["run"], []);
  assert(ran.code == 0 && last_line(ran) == "10", Some(said(ran)));
  let shown = spawned(["std", "--show", "std/oid/names.txt"], []);
  assert(shown.code == 0 && stdout(shown) == oid_names().text, Some(said(shown)))
}

test "a warm check agrees with a cold one over a program that reaches a shipped data file" {
  scratch(|| {
    project([{ path: "app.ply", text: naming() }]);
    let _ = warm_agrees("cold");
    let warm = warm_agrees("warm");
    assert(has_named(at(warm, "definitions"), "std.oid.registry"), Some(shown(warm)))
  })
}

test "editing a shipped data file moves exactly the definitions that reach it" {
  let renamed = {
    path: oid_names().path,
    text: string::replace(oid_names().text, "2.5.4.3 commonName", "2.5.4.3 cn"),
  };
  assert(renamed.text != oid_names().text, Some("the edit landed"));
  let hashes = |shipped: List<Source>|
    over_tree(app(naming()), || json_of(on_disk_shipping(["hash", "--json"], shipped))).value;
  let before = hashes([]);
  let after = hashes([renamed]);
  fold(
    ["std.oid.registry", "std.oid.name", "app.named", "app.main"],
    (),
    |u: Unit, name: String| assert(hash_of(before, name) != hash_of(after, name), Some(name)),
  );
  // The module's text did not move, and what reaches nothing of the file stands.
  fold(["std.oid.common_name", "std.oid.arcs", "app.plain"], (), |u: Unit, name: String|
    assert(hash_of(before, name) == hash_of(after, name), Some(name)));
  assert(tests_hashed(before) != tests_hashed(after), Some("the test that reads a name reruns"));
  // Handed the file as the binary ships it, a load answers as one handed nothing in its place.
  assert_eq(hashes([oid_names()]), before)
}

test "copying a shipped module and its data file into a project produces identical hashes" {
  let source = match filter(std_tree(), |f: { name: String, bytes: Bytes }| f.name == "oid.ply") {
    [f, ..] -> string_of_bytes(f.bytes),
    [] -> panic("the standard library's tree holds no `oid.ply`"),
  };
  let shipped = hashed(app(naming()));
  let copied = hashed(
    tree([
      { path: "mine.ply", text: source },
      { path: "oid/names.txt", text: oid_names().text },
      { path: "app.ply", text: string::replace(naming(), "import std.oid", "import mine as oid") },
    ]),
  );
  fold(["registry", "name", "common_name"], (), |u: Unit, name: String|
    assert_eq(hash_of(shipped, "std.oid." ++ name), hash_of(copied, "mine." ++ name)));
  assert_eq(hash_of(shipped, "app.named"), hash_of(copied, "app.named"))
}

test "a program that reaches nothing of a shipped module's data holds no definition the file moves" {
  let idle = "import std.oid\n\npub fn plain() -> Int = len(oid::arcs(oid::common_name()))\n";
  let answer = checked(app(idle));
  assert(truth(at(answer, "ok")), Some(shown(answer)));
  assert(has_named(at(answer, "definitions"), "std.oid.common_name"), Some(shown(answer)));
  fold(["std.oid.registry", "std.oid.name", "std.oid.named"], (), |u: Unit, name: String|
    assert(!has_named(at(answer, "definitions"), name), Some(name)));
  let hashes = |shipped: List<Source>|
    over_tree(app(idle), || json_of(on_disk_shipping(["hash", "--json"], shipped))).value;
  assert_eq(hashes([{ path: oid_names().path, text: "2.5.4.3 cn\n" }]), hashes([]))
}

/// A shipped module this binary does not ship, whose table a build makes of a data file beside it.
fn words() -> Source =
  {
    path: "std.words.ply",
    text:
      \\//! Words, one a line, for a test of a shipped table.
      \\
      \\fn parsed(text: Bytes) -> List<String> / {abort.raise} =
      \\  map(
      \\    filter(string_split(string_of_bytes(text), "\n"), |word: String| word != ""),
      \\    |word: String|
      \\      if string_contains(word, " ") { panic("`" ++ word ++ "` is two words") } else { word },
      \\  )
      \\
      \\/// The words the file beside this module holds, made when a program is built.
      \\pub const fn table() -> List<String> = parsed(embed("words/list.txt"))
      \\
      \\/// The same words, made where they are asked for.
      \\pub fn computed() -> List<String> / {abort.raise} = parsed(embed("words/list.txt"))
      \\
  }

fn word_list(text: String) -> Source = { path: "std/words/list.txt", text: text }

fn counting() -> String =
  \\import std.words
  \\
  \\fn main() -> Int = len(words::table())
  \\
  \\test "the table read is the table its body makes" {
  \\  assert_eq(words::table(), words::computed())
  \\}
  \\
  \\test "a second read of the table enters nothing of its body" {
  \\  let first = words::table();
  \\  let read = metered(|| words::table());
  \\  let nothing = metered(|| 0);
  \\  assert_eq(read.steps, nothing.steps);
  \\  assert_eq(read.allocations, nothing.allocations);
  \\  assert(metered(|| words::computed()).steps > read.steps);
  \\  assert_eq(len(first), 3)
  \\}
  \\

test "a shipped module's `const fn` over its data file is made by the build, and a run reads it at no cost" {
  let shipped = [words(), word_list("one\ntwo\nthree\n")];
  scratch(|| {
    program(counting());
    assert_ok(on_disk_shipping(["check"], shipped));
    let ran = on_disk_shipping(["run"], shipped);
    assert(ran.code == 0 && last_line(ran) == "3", Some(said(ran)));
    let tested = json_of(on_disk_shipping(["test", "--json", "--no-cache"], shipped));
    assert(int(path(tested, ["summary", "passed"])) == 2, Some(shown(tested)))
  });
  // Other bytes are another definition, so the build makes the table again.
  scratch(|| {
    program(counting());
    let longer = on_disk_shipping(["run"], [words(), word_list("one\ntwo\nthree\nfour\n")]);
    assert(longer.code == 0 && last_line(longer) == "4", Some(said(longer)))
  })
}

// The module's text stands across these checks, and each reads it through what the last one kept.
test "a check that kept a shipped module makes its table again when the data file moves" {
  scratch(|| {
    program(counting());
    let check = |list: String|
      on_disk_shipping(["check", "--explain", "--json"], [words(), word_list(list)]);
    assert_ok(check("one\ntwo\nthree\n"));
    assert_ok(check("one\ntwo\nthree\n"));
    let refused = json_of(check("one\ntwo words\n"));
    assert_eq(codes(refused), ["E0157"]);
    assert(string_contains(shown(refused), "`two words` is two words"), Some(shown(refused)));
    assert_ok(check("one\ntwo\nthree\n"))
  })
}

test "a data file the shipped modules do not hold is refused in the module that asks for it" {
  scratch(|| {
    program(counting());
    let v = json_of(on_disk_shipping(["check", "--json"], [words()]));
    // One for each call that asks for it.
    assert_eq(codes(v), ["E0146", "E0146"]);
    fold(items(at(v, "diagnostics")), (), |u: Unit, d: Json| {
      assert(string_contains(str(at(d, "message")), "words/list.txt"), Some(shown(d)));
      assert_eq(map(items(at(d, "labels")), |l: Json| str(at(l, "file"))), ["<std>/words.ply"])
    })
  })
}

test "ply std names the data a module embeds, prints it by name, and its digest covers it" {
  let t = app("fn f() -> Int = 1\n");
  let v = json_of(in_memory(t, ["std", "--json"]));
  let held = match named_module(v, "std.oid") {
    Some(m) -> items(at(m, "data")),
    None -> panic("`std.oid` is not listed: " ++ shown(v)),
  };
  assert_eq(map(held, |d: Json| str(at(d, "name"))), [oid_names().path]);
  assert_eq(map(held, |d: Json| int(at(d, "bytes"))), [string_len(oid_names().text)]);
  assert(
    match named_module(v, "std.list") { Some(m) -> items(at(m, "data")) == [], None -> false },
    Some("a module that embeds nothing lists no data"),
  );
  let listing = in_memory(t, ["std"]);
  assert(
    string_contains(said(listing), oid_names().path ++ " · ")
      && string_contains(said(listing), "embedded by std.oid"),
    Some(said(listing)),
  );
  let shown_data = in_memory(t, ["std", "--show", oid_names().path]);
  assert(shown_data.code == 0 && stdout(shown_data) == oid_names().text, Some(said(shown_data)));
  // Bare, it prints the modules' sources and no data file.
  assert(!string_contains(stdout(in_memory(t, ["std", "--show"])), "2.5.4.3 commonName"), None);
  let digest = |shipped: List<Source>|
    over_tree(t, || stdout(on_disk_shipping(["std", "--digest"], shipped))).value;
  assert_eq(digest([oid_names()]), digest([]));
  assert(digest([{ path: oid_names().path, text: "2.5.4.3 cn\n" }]) != digest([]), None)
}

fn named_module(listing: Json, name: String) -> Option<Json> =
  match filter(items(at(listing, "modules")), |m: Json| str(at(m, "module")) == name) {
    [m, ..] -> Some(m),
    [] -> None,
  }

test "ply doc documents a name of a shipped module that embeds a data file" {
  let r = in_memory(app("fn f() -> Int = 1\n"), ["doc", "std.oid.name"]);
  assert(r.code == 0 && string_contains(said(r), "well-known identifier"), Some(said(r)))
}

// A file the tree holds and no module embeds would ship in every binary and be read by nothing.
test "each data file the standard library's tree holds is one a module of it embeds" {
  let embedded = fold(std_tree(), [], |acc: List<String>, f: { name: String, bytes: Bytes }|
    if !string_ends_with(f.name, ".ply") || string_contains(f.name, "/") { acc } else {
      fold(
        shipped_data_wanted({
          name: bytes_of_string("std." ++ string_slice(f.name, 0, string_len(f.name) - 4)),
          src: f.bytes,
        }),
        acc,
        |a: List<String>, name: Bytes| push(a, string_of_bytes(name)),
      )
    });
  assert_eq(sort(map(std_data(), |d: { name: String, bytes: Bytes }| d.name)), sort(embedded))
}

/// `std.http` with each run of whitespace squeezed to one space, and to none inside a brace, so that
/// the scrapes below ask what it says rather than how the formatter laid it out.
fn shipped_http() -> String / {abort.raise} = {
  let source = embed("../../ply-std/ply/http.ply");
  string_of_bytes(
    fold(range(0, bytes_len(source)), b"", |out: Bytes, i: Int| {
      let c = bytes_at(source, i);
      let last = if bytes_len(out) == 0 { 0 } else { bytes_at(out, bytes_len(out) - 1) };
      if c == 32 || c == 10 || c == 9 || c == 13 {
        if bytes_len(out) == 0 || last == 32 || last == 123 { out } else { bytes_concat(out, b" ") }
      } else if c == 125 && last == 32 {
        bytes_concat(bytes_slice(out, 0, bytes_len(out) - 1), b"}")
      } else { bytes_concat(out, byte_of_int(c)) }
    }),
  )
}

fn after(text: String, marker: String) -> String / {abort.raise} =
  match string::split_once(text, marker) {
    Some(p) -> p.tail,
    None -> panic("`" ++ marker ++ "` is not in std.http"),
  }

fn before(text: String, marker: String) -> String / {abort.raise} =
  match string::split_once(text, marker) { Some(p) -> p.head, None -> text }

/// `Limits`' fields as `std.http` declares them, read by the parser rather than off the text.
fn limits_fields() -> List<String> / {abort.raise} = {
  let fields = fold(
    parse(embed("../../ply-std/ply/http.ply")).node.items,
    [],
    |acc: List<String>, it: Item|
      match it {
        IType(d) -> if d.name.name != b"Limits" { acc } else {
          match d.body {
            TDAlias(TRecord(r)) ->
              map(r.fields, |f: { name: Ident, ty: TypeExpr }| string_of_bytes(f.name.name)),
            _ -> acc,
          }
        },
        _ -> acc,
      },
  );
  assert(
    len(fields) >= 13,
    Some(
      "`Limits` shrank to " ++ int_to_string(len(fields))
        ++ " fields; these tests are about the cost of it growing",
    ),
  );
  fields
}

type Spread = { base: String, fields: List<{ name: String, value: String }> }

/// `func`'s `{..base, name: value, ..}` as written: the base, then each field it names.
fn record_update(func: String) -> Spread / {abort.raise} = {
  let body = after(shipped_http(), "fn " ++ func ++ "(");
  let inner = before(after(body, "{.."), "}");
  match filter(map(string_split(inner, ","), string_trim), |p: String| p != "") {
    [] -> panic("a spread names its base"),
    [base, ..rest] ->
      {
        base: base,
        fields: map(rest, |part: String|
          match string::split_once(part, ":") {
            Some(p) -> { name: string_trim(p.head), value: string_trim(p.tail) },
            None -> panic("`" ++ part ++ "` in `" ++ func ++ "` is not `name: value`"),
          }),
      },
  }
}

/// The field of `base` this value reads, if it reads one directly.
fn read_of_base(value: String, base: String) -> Option<String> / {abort.raise} =
  if string_starts_with(value, base ++ ".") {
    let rest = string_slice(value, string_len(base) + 1, string_len(value));
    if string_contains(rest, ".") { None } else { Some(rest) }
  } else { None }

/// Every `Limits` field `func` names must be one it deliberately varies; the spread copies the rest.
fn copies_every_limit_it_does_not_vary(
  func: String,
  base: String,
  varied: List<{ name: String, from: Option<String> }>,
) -> Unit / {abort.raise} = {
  let spread = record_update(func);
  assert(
    spread.base == base,
    Some("`" ++ func ++ "` spreads `" ++ spread.base ++ "`, not `" ++ base ++ "`"),
  );
  let limits = limits_fields();
  fold(spread.fields, (), |u: Unit, f: { name: String, value: String }|
    assert(
      len(filter(limits, |l: String| l == f.name)) > 0,
      Some("`" ++ func ++ "` sets `" ++ f.name ++ "`, which `Limits` does not have"),
    ));
  let actual = fold(
    spread.fields,
    [],
    |acc: List<{ name: String, from: Option<String> }>, f: { name: String, value: String }|
      match read_of_base(f.value, base) {
        Some(from) -> if from == f.name { acc }
        else { push(acc, { name: f.name, from: Some(from) }) },
        None -> push(acc, { name: f.name, from: None }),
      },
  );
  assert(
    actual == varied,
    Some(
      "in `" ++ func ++ "`, exactly these bounds may differ from `" ++ base
        ++ "`'s bound of their own name; anything else here is a mispaired limit",
    ),
  )
}

test "chunk_trailers copies every limit it does not replace" {
  copies_every_limit_it_does_not_vary("chunk_trailers", "state.limits", [
    { name: "max_header_bytes", from: Some("max_trailer_bytes") },
  ])
}

test "the limits helpers vary only the bounds they are named for" {
  copies_every_limit_it_does_not_vary("limits_keeping", "base", [
    { name: "max_keep_alive", from: None },
  ]);
  copies_every_limit_it_does_not_vary("limits_streaming", "base", [
    { name: "max_stream_chunks", from: None },
  ]);
  copies_every_limit_it_does_not_vary(
    "limits_with",
    "base",
    map(
      [
        "max_request_line",
        "max_header_bytes",
        "max_header_count",
        "max_body",
        "max_chunk_size",
        "max_chunk_line",
        "max_trailer_bytes",
      ],
      |n: String| { name: n, from: None },
    ),
  )
}

// Its seven written bounds are all `Int` parameters, so `max_chunk_size: chunk_line` would
// type-check.
test "limits_with pairs each bound with the parameter named after it" {
  let params = fold(
    string_split(before(after(shipped_http(), "fn limits_with("), ")"), ","),
    [],
    |acc: List<String>, p: String|
      match string::split_once(p, ":") { Some(x) -> push(acc, string_trim(x.head)), None -> acc },
  );
  let paired = fold(
    record_update("limits_with").fields,
    0,
    |n: Int, f: { name: String, value: String }|
      if len(filter(params, |p: String| p == f.value)) == 0 { n } else {
        assert(
          f.name == "max_" ++ f.value,
          Some(
            "`limits_with` passes `" ++ f.value ++ "` as `" ++ f.name
              ++ "`, and every `Limits` field is `Int`, so nothing else would have caught it",
          ),
        );
        n + 1
      },
  );
  assert(
    paired == len(params),
    Some("every parameter of `limits_with` must reach a bound, or one of them is dead"),
  )
}

/// What a module publishes that has no doc: every `pub` declaration, and each operation of a `pub`
/// effect, by name.
fn undocumented(module: String, src: Bytes) -> List<String> / {abort.raise} =
  fold(parse(src).node.items, [], |acc: List<String>, it: Item| {
    let named = |name: Bytes| module ++ "." ++ string_of_bytes(name);
    match it {
      IFn(d) -> if is_pub(d.vis) && bare(d.doc) { push(acc, named(d.name.name)) } else { acc },
      IType(d) -> if is_pub(d.vis) && bare(d.doc) { push(acc, named(d.name.name)) } else { acc },
      ISchema(d) -> if is_pub(d.vis) && bare(d.doc) { push(acc, named(d.name.name)) } else { acc },
      IEffectSet(d) -> if is_pub(d.vis) && bare(d.doc) { push(acc, named(d.name.name)) }
      else { acc },
      IEffect(d) -> if !is_pub(d.vis) { acc } else {
        let own = if bare(d.doc) { push(acc, named(d.name.name)) } else { acc };
        fold(d.ops, own, |a: List<String>, op: OpDef|
          if bare(op.doc) { push(a, named(d.name.name) ++ "." ++ string_of_bytes(op.name.name)) }
          else { a })
      },
      _ -> acc,
    }
  })

fn bare(doc: Option<Doc>) -> Bool = match doc { None -> true, Some(_) -> false }

/// A standard library module under its name in a program.
type Published = { module: String, src: Bytes }

fn std_modules() -> List<Published> / {abort.raise} =
  fold(std_tree(), [], |acc: List<Published>, f: { name: String, bytes: Bytes }|
    if !string_ends_with(f.name, ".ply") { acc } else {
      push(acc, { module: "std." ++ string_slice(f.name, 0, string_len(f.name) - 4), src: f.bytes })
    })

test "every name {m.module} publishes is documented" for m: Published in std_modules() {
  let missing = undocumented(m.module, m.src);
  assert(
    len(missing) == 0,
    Some("these are published without a `///` doc:\n" ++ string::join(missing, "\n")),
  )
}

/// The shipped modules that fold case or trim by Unicode's tables, each with the text of a
/// person's it reads that way. Every other one compares names and tokens, which take
/// `std.string`'s `ascii_lower`, `ascii_upper` and `ascii_trim`.
fn unicode_readers() -> List<{ module: String, why: String }> =
  [
    { module: "char", why: "its simple mappings are held to the prelude's full ones" },
    { module: "cli", why: "a manual page's title is the program's name in capitals" },
    { module: "glob", why: "`ignore_case` matches names as a file system that folds case does" },
    { module: "ini", why: "`any_case` matches a key as Python's `configparser` folds one" },
    { module: "semver", why: "`coerce` reads a version out of text a person typed" },
    { module: "string", why: "the ASCII forms are stated against the prelude's" },
    { module: "tar", why: "paths are compared as a file system that folds case compares them" },
    { module: "text", why: "a shell line is refused at white space of any script" },
    { module: "unicode", why: "its full mappings are held to the prelude's" },
  ]

/// Whether a source names `string_lower`, `string_upper` or `string_trim` outside its comments
/// and its literals.
fn reads_unicode(src: Bytes) -> Bool / {abort.raise} =
  fold(lex(src).tokens, false, |found: Bool, t: Token|
    found
      || (match t.kind {
        Identifier(name) ->
          name == b"string_lower" || name == b"string_upper" || name == b"string_trim",
        _ -> false,
      }))

test "a shipped module folds case and trims by ASCII, unless it is listed as reading a person's text" {
  let found = sort(
    fold(std_tree(), [], |acc: List<String>, f: { name: String, bytes: Bytes }|
      if string_ends_with(f.name, ".ply") && reads_unicode(f.bytes) {
        push(acc, string_slice(f.name, 0, string_len(f.name) - 4))
      } else { acc }),
  );
  let listed = map(unicode_readers(), |r: { module: String, why: String }| r.module);
  assert(
    found == listed,
    Some(
      "the modules that call `string_lower`, `string_upper` or `string_trim`:\n  "
        ++ string::join(found, " ")
        ++ "\nthe ones listed as reading a person's text:\n  "
        ++ string::join(listed, " ")
        ++ "\na name or a token takes `std.string`'s `ascii_lower`, `ascii_upper` or `ascii_trim`",
    ),
  )
}
