//! `std.password` under `--host`: each algorithm against its standard's vectors and against hash
//! strings other implementations wrote, and what a test that reaches the host for a hash is to
//! the cache.

import harness (scratch, program, on_disk, tested, json_of, at, path, nth, items, first, int, str,
                truth, shown, said)
import std.bytes (hex_of)
import std.json (Json)
import std.password
import std.password (kdf, Invalid, Valid, ValidNeedsRehash, Verdict)
import std.string (repeat)

fn filled(byte: Int, n: Int) -> Bytes / {abort.raise} =
  bytes_concat_all(map(range(0, n), |_: Int| byte_of_int(byte)))

/// An Argon2 variant and the tag RFC 9106 section 5 gives for it.
type Tagged = { variant: String, tag: String }

fn rfc_9106() -> List<Tagged> =
  [
    { variant: "argon2d", tag: "512b391b6f1162975371d30919734294f868e3be3984f3c1a13a4db9fabe4acb" },
    { variant: "argon2i", tag: "c814d9d1dc7f37aa13f0d77f2494bda1c8de6b016dd388d29952a4c4672b6ce8" },
    {
      variant: "argon2id",
      tag: "0d640df58d78766c08c037a34a8b53c9d01ef0452d75b65eb52520e96b01e659",
    },
  ]

// Under the RFC's secret and associated data, which the operation takes for this.
test "{c.variant} answers the tag RFC 9106 gives" for c: Tagged in rfc_9106() {
  let tag = kdf.argon2(
    c.variant,
    secret_of_bytes(filled(1, 32)),
    filled(2, 16),
    secret_of_bytes(filled(3, 8)),
    filled(4, 12),
    32,
    3,
    4,
    32,
  );
  assert_eq(hex_of(tag), c.tag)
}

/// One of RFC 7914 section 12's vectors, without the last, which fills a gigabyte.
type Mixed = { password: String, salt: String, log_n: Int, r: Int, p: Int, tag: String }

fn rfc_7914() -> List<Mixed> =
  [
    {
      password: "",
      salt: "",
      log_n: 4,
      r: 1,
      p: 1,
      tag: "77d6576238657b203b19ca42c18a0497f16b4844e3074ae8dfdffa3fede21442fcd0069ded0948f8326a753a0fc81f17e8d3e0fb2e0d3628cf35e20c38d18906",
    },
    {
      password: "password",
      salt: "NaCl",
      log_n: 10,
      r: 8,
      p: 16,
      tag: "fdbabe1c9d3472007856e7190d01e9fe7c6ad7cbc8237830e77376634b3731622eaf30d92e22a3886ff109279d9830dac727afb94a83ee6d8360cbdfa2cc0640",
    },
    {
      password: "pleaseletmein",
      salt: "SodiumChloride",
      log_n: 14,
      r: 8,
      p: 1,
      tag: "7023bdcb3afd7348461c06cd81fd38ebfda8fbba904f8e3ea9b543f6545da1f2d5432955613f0fcf62d49705242a9af9e61e85dc0d651e40dfcf017b45575887",
    },
  ]

test "scrypt under `{c.salt}` answers the tag RFC 7914 gives" for c: Mixed in rfc_7914() {
  let tag = kdf.scrypt(
    secret_bytes(secret_of_string(c.password)),
    bytes_of_string(c.salt),
    c.log_n,
    c.r,
    c.p,
    64,
  );
  assert_eq(hex_of(tag), c.tag)
}

test "bcrypt and PBKDF2 answer their published vectors" {
  // jBCrypt's `$2a$06$m0CrhHm10qJ3lXRY.5zDGO3rS2KdeeWLuGmsfGlMfOxih58VYVfxe`, RFC 6070's second
  // vector, and RFC 7914 section 11's first.
  assert_eq(
    hex_of(
      kdf.bcrypt(
        secret_of_bytes(b"a"),
        b"\xa3\x61\x2d\x8c\x9a\x37\xda\xc2\xf9\x9d\x94\xda\x03\xbd\x45\x21",
        6,
      ),
    ),
    "e6d53831f82060dc08a2e8489ce850ce48fbf976978738",
  );
  assert_eq(
    hex_of(kdf.pbkdf2("SHA-1", secret_of_bytes(b"password"), b"salt", 2, 20)),
    "ea6c014dc72d6f8ccd1ed92ace1d41f0d8de8957",
  );
  assert_eq(
    hex_of(kdf.pbkdf2("SHA-256", secret_of_bytes(b"passwd"), b"salt", 1, 64)),
    "55ac046e56e3089fec1691c22544b605f94185216dde0465e68b9d57c20dacbc49ca9cccf179b645991664b39d77ef317c71b845b1e30bd509112041d3a19783",
  )
}

/// A hash string another implementation wrote, the password it is of, and what `verify` answers
/// under `owasp_argon2id`.
type Foreign = { made_by: String, password: String, text: String, verdict: Verdict }

fn staple() -> String = "correct horse battery staple"

fn foreign() -> List<Foreign> =
  [
    {
      made_by: "libargon2 through argon2-cffi 25.1.0, and OpenSSL 3.6 through cryptography 50.0.2",
      password: staple(),
      text: "$argon2id$v=19$m=19456,t=2,p=1$AAECAwQFBgcICQoLDA0ODw$gYJZtjEAJqjg26xdLmknq8/bB7MiWPrE9hsYuA+SkIU",
      verdict: Valid,
    },
    {
      made_by: "libargon2's Argon2i",
      password: staple(),
      text: "$argon2i$v=19$m=19456,t=2,p=1$AAECAwQFBgcICQoLDA0ODw$dYFSDMHe7r6j8bNX+Py4zNJ4v3iefrxU8sJcdB2oaAY",
      verdict: ValidNeedsRehash,
    },
    {
      made_by: "libargon2's Argon2d",
      password: staple(),
      text: "$argon2d$v=19$m=19456,t=2,p=1$AAECAwQFBgcICQoLDA0ODw$TCaBtCxbgZYiqIhxXq+PsUVzIRAYPAlRckuiWVqaH94",
      verdict: ValidNeedsRehash,
    },
    {
      made_by: "libargon2 at RFC 9106's low-memory option, four lanes",
      password: staple(),
      text: "$argon2id$v=19$m=65536,t=3,p=4$AAECAwQFBgcICQoLDA0ODw$hTsnKkTbFCHAKWJmmlXrCZTzyrOF7RxMeSU+7hm6tJ4",
      verdict: ValidNeedsRehash,
    },
    {
      made_by: "libargon2 under eight bytes of salt, with sixteen of tag",
      password: staple(),
      text: "$argon2id$v=19$m=64,t=1,p=2$c29tZXNhbHQ$JOf2h4fID94lhr843SM7qQ",
      verdict: ValidNeedsRehash,
    },
    {
      made_by: "libargon2 of a password that is not ASCII",
      password: "pässwörd ☃",
      text: "$argon2id$v=19$m=19456,t=2,p=1$AAECAwQFBgcICQoLDA0ODw$HwYQHBoIqEYiD6HrqHlPAz1UUrb9iqeQEPI+isZaAOs",
      verdict: Valid,
    },
    {
      made_by: "libargon2 of the empty password",
      password: "",
      text: "$argon2id$v=19$m=19456,t=2,p=1$AAECAwQFBgcICQoLDA0ODw$MVSMP3rBIzE7F86FWHKNemRnE6hkgY2O2buZdxt7Gkw",
      verdict: Valid,
    },
    {
      made_by: "OpenSSL's scrypt through hashlib, and passlib 1.7.4",
      password: staple(),
      text: "$scrypt$ln=14,r=8,p=1$AAECAwQFBgcICQoLDA0ODw$11kKyiyYAc8G7rp3KmncMc44YlkdllIqxOa7pq0fMaU",
      verdict: ValidNeedsRehash,
    },
    {
      made_by: "OpenSSL's scrypt mixed sixteen times",
      password: staple(),
      text: "$scrypt$ln=10,r=8,p=16$AAECAwQFBgcICQoLDA0ODw$OojrDPu8KuoV5S4lhF+x5PSEGYD7+JBque7DK4lPa84",
      verdict: ValidNeedsRehash,
    },
    {
      made_by: "OpenSSL's scrypt at one of OWASP's costs",
      password: staple(),
      text: "$scrypt$ln=15,r=8,p=3$AAECAwQFBgcICQoLDA0ODw$ZwXboEbK+6uo3pibyojgA4zgNULQwM2WqPlWpy+G7mc",
      verdict: ValidNeedsRehash,
    },
    {
      made_by: "pyca's bcrypt 5.0.0 as `$2b$`",
      password: staple(),
      text: "$2b$05$CCCCCCCCCCCCCCCCCCCCC.poIKaw08HWUz4zkVKLs8VPIydUmXBPC",
      verdict: ValidNeedsRehash,
    },
    {
      made_by: "pyca's bcrypt as `$2a$`",
      password: staple(),
      text: "$2a$06$CCCCCCCCCCCCCCCCCCCCC.uGN1ufVX4zerW2S91Qo7fWPFIKWSmsC",
      verdict: ValidNeedsRehash,
    },
    {
      made_by: "pyca's bcrypt of a password that is not ASCII",
      password: "pässwörd ☃",
      text: "$2b$05$CCCCCCCCCCCCCCCCCCCCC./W/TLMHl.yAn.BG2BGPS.olYZ3mhcN6",
      verdict: ValidNeedsRehash,
    },
    {
      made_by: "Apache's htpasswd as `$2y$`",
      password: staple(),
      text: "$2y$05$uIDUI3FR2NCeusfJl/ZERexoQy/h86KuwGHAiy.srfI1lAK/.Ryna",
      verdict: ValidNeedsRehash,
    },
    {
      made_by: "passlib's PBKDF2 under SHA-256",
      password: staple(),
      text: "$pbkdf2-sha256$29000$AAECAwQFBgcICQoLDA0ODw$m/kLywdyNwK9GV2kWntRGvZzmeiVsuqehNWlLst2eWY",
      verdict: ValidNeedsRehash,
    },
    {
      made_by: "passlib's PBKDF2 under SHA-512",
      password: staple(),
      text: "$pbkdf2-sha512$25000$AAECAwQFBgcICQoLDA0ODw$SD45rjg2efG3ODIHQeklcrq1rgpKrbMw16UwshxvBWLgNENeDWMvNiO.Lj6BUMRx4V/sPJndUTpKWVbG79Akig",
      verdict: ValidNeedsRehash,
    },
    {
      made_by: "passlib's PBKDF2 under SHA-1",
      password: staple(),
      text: "$pbkdf2$131000$AAECAwQFBgcICQoLDA0ODw$NxAwx22dqUmlCPsB1ivyDvbzOTI",
      verdict: ValidNeedsRehash,
    },
    {
      made_by: "OpenSSL's PBKDF2 at OWASP's count, in the PHC form",
      password: staple(),
      text: "$pbkdf2-sha256$i=600000,l=32$AAECAwQFBgcICQoLDA0ODw$7xdxRO7JQgy8EJPSqLNEqSvFBtDU7JwCjdGfgyTYweY",
      verdict: ValidNeedsRehash,
    },
  ]

test "a hash by {c.made_by} verifies its password and no other" for c: Foreign in foreign() {
  let now = password::owasp_argon2id();
  assert_eq(password::verify(c.text, secret_of_string(c.password), now), c.verdict);
  assert_eq(password::verify(c.text, secret_of_string(c.password ++ "!"), now), Invalid)
}

test "a hash under a named salt is the string libargon2 writes, and scrypt's the one passlib does" {
  let secret = secret_of_string(staple());
  let salt = bytes_concat_all(map(range(0, 16), |i: Int| byte_of_int(i)));
  assert_eq(
    try { password::hash_with_salt(secret, password::owasp_argon2id(), salt) },
    Ok(
      "$argon2id$v=19$m=19456,t=2,p=1$AAECAwQFBgcICQoLDA0ODw$gYJZtjEAJqjg26xdLmknq8/bB7MiWPrE9hsYuA+SkIU",
    ),
  );
  assert_eq(
    try { password::hash_with_salt(secret, password::scrypt(14, 8, 1), salt) },
    Ok("$scrypt$ln=14,r=8,p=1$AAECAwQFBgcICQoLDA0ODw$11kKyiyYAc8G7rp3KmncMc44YlkdllIqxOa7pq0fMaU"),
  )
}

// pyca's bcrypt refuses a password past seventy-two bytes, so this hash is of the first
// seventy-two of eighty.
test "bcrypt checks the first seventy-two bytes of a password and nothing after them" {
  let stored = "$2b$05$CCCCCCCCCCCCCCCCCCCCC.XxrQqgBi/5Sxuq9soXzDtjIZ7w5pMfK";
  let eighty = repeat("0123456789", 8);
  let checked = |supplied: String|
    password::verify(stored, secret_of_string(supplied), password::owasp_argon2id());
  assert_eq(checked(eighty), ValidNeedsRehash);
  assert_eq(checked(string_slice(eighty, 0, 72)), ValidNeedsRehash);
  assert_eq(checked(string_slice(eighty, 0, 72) ++ "anything at all"), ValidNeedsRehash);
  assert_eq(checked(string_slice(eighty, 0, 71)), Invalid);
  assert_eq(checked(string_slice(eighty, 0, 71) ++ "x"), Invalid)
}

fn login() -> String =
  \\import std.password
  \\import std.password (kdf, ValidNeedsRehash)
  \\
  \\pub fn admits(stored: String, supplied: Secret<String>) -> Bool / {kdf.read, abort.raise} =
  \\  password::verify(stored, supplied, password::owasp_argon2id()) == ValidNeedsRehash
  \\
  \\test "a stored hash verifies" {
  \\  assert(
  \\    admits(
  \\      "$argon2id$v=19$m=64,t=1,p=2$c29tZXNhbHQ$JOf2h4fID94lhr843SM7qQ",
  \\      secret_of_string("correct horse battery staple"),
  \\    ),
  \\  )
  \\}
  \\
  \\test "a login under the stand-in reaches no host" {
  \\  let secret = secret_of_string("correct horse");
  \\  let admitted = try {
  \\    password::stand_in(||
  \\      admits(password::hash_with_salt(secret, password::owasp_argon2id(), b"saltsalt"), secret))
  \\  };
  \\  assert_eq(admitted, Ok(true))
  \\}
  \\

fn status_of(report: Json, name: String) -> String =
  match filter(items(at(report, "results")), |r: Json| str(at(r, "name")) == name) {
    [r, ..] -> str(at(r, "status")),
    [] -> "",
  }

// The runs it drives bind the host, so it runs against the disk.
test/nondet "a test that reaches a hash is E0424 without --host, and its pass under it is any binding's" {
  program(login());
  let hermetic = tested([]);
  assert(!truth(at(hermetic, "ok")), Some(shown(hermetic)));
  assert_eq(status_of(hermetic, "a stored hash verifies"), "failed");
  assert_eq(status_of(hermetic, "a login under the stand-in reaches no host"), "passed");
  assert_eq(str(path(nth(at(hermetic, "failures"), 0), ["diagnostic", "code"])), "E0424");
  assert(string_contains(shown(hermetic), "ply_host::password::argon2"), Some(shown(hermetic)));

  let hosted = tested(["--host"]);
  assert(truth(at(hosted, "ok")), Some(shown(hosted)));
  assert_eq(status_of(hosted, "a stored hash verifies"), "passed");
  // The handler is deterministic, so the pass is filed as a test's that reached no host is: a
  // second run under `--host` takes it, and so does a run without.
  fold([["--host"], []], (), |_: Unit, flags: List<String>| {
    let again = tested(flags);
    assert(truth(at(again, "ok")), Some(shown(again)));
    assert_eq(int(path(again, ["summary", "cached"])), 2);
    assert_eq(int(path(again, ["selection", "selected"])), 0)
  })
}

test "ply hosts lists each hash as deterministic, blocking and handed a secret" {
  scratch(|| {
    program(login());
    let listed = on_disk(["hosts", "--host", "--json"]);
    assert(listed.code == 0, Some(said(listed)));
    let rows = items(at(json_of(listed), "hosts"));
    assert_eq(map(rows, |row: Json| str(at(row, "triple"))), [
      "std.password.kdf.argon2",
      "std.password.kdf.bcrypt",
      "std.password.kdf.pbkdf2",
      "std.password.kdf.scrypt",
    ]);
    assert_eq(
      len(
        filter(rows, |row: Json|
          truth(at(row, "deterministic")) && truth(at(row, "blocking")) && truth(at(row, "secrets"))
            && !truth(at(row, "linear"))
            && !truth(at(row, "declared_nondet"))),
      ),
      4,
    );
    assert_eq(str(at(first(rows), "handler")), "ply_host::password::argon2")
  })
}
