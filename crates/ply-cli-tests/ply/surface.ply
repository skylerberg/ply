//! `ply defs`, `ply test --filter` and `ply callers`: every definition with its place, hash,
//! signature and references, the tests any filter selects, and what mentions or reaches one.

import harness (scratch, in_memory, one, program, on_disk, stdout, json_of, at, path, nth, items,
                str, int, shown)
import std.json (Json, Str, Array)
import std.list (sort)

fn source() -> String =
  \\fn one() -> Int = 1
  \\fn two() -> Int = one() + 1
  \\fn three() -> Int = two() + 1
  \\fn alone() -> Int = 3
  \\test "two is two" { assert_eq(two(), 2) }
  \\test "alone is three" { assert_eq(alone(), 3) }
  \\law "three is three" { three() == 3 }
  \\

fn names(j: Json) -> List<String> = map(items(j), |x: Json| str(at(x, "name")))

test "defs lists every definition with its place, hash, signature and references" {
  let v = json_of(in_memory(one(source()), ["defs", "--json"]));
  assert_eq(int(at(v, "exit_code")), 0);
  let defs = at(v, "definitions");
  assert_eq(names(defs), ["m.one", "m.two", "m.three", "m.alone"]);
  let two = nth(defs, 1);
  assert_eq(str(at(two, "type")), "() -> Int");
  assert_eq(str(at(two, "footprint")), "{}");
  assert_eq(map(items(at(two, "deps")), str), ["m.one"]);
  assert_eq(string_len(str(at(two, "hash"))), 64);
  assert(string_ends_with(str(at(two, "location")), "m.ply:2:1"), Some(shown(two)));
  assert_eq(int(at(two, "start")), 20);
  let filtered = stdout(in_memory(one(source()), ["defs", "--filter", "thr"]));
  assert(
    string_contains(filtered, "m.three") && !string_contains(filtered, "m.two"),
    Some(filtered),
  )
}

test "test runs every test any of its filters matches" {
  scratch(|| {
    program(source() ++ "test \"one is one\" { assert_eq(one(), 1) }\n");
    let v = json_of(
      on_disk(["test", "--json", "--no-cache", "--filter", "two", "--filter", "alone"]),
    );
    let ran = sort(map(items(at(v, "results")), |r: Json| str(at(r, "key"))));
    assert(ran == ["m.alone is three", "m.two is two"], Some(shown(v)));
    assert(at(v, "filters") == Array([Str("two"), Str("alone")]), Some(shown(v)))
  })
}

test "callers names what mentions a definition and what reaches it" {
  let v = json_of(in_memory(one(source()), ["callers", "one", "--json"]));
  assert_eq(str(path(v, ["definition", "name"])), "m.one");
  assert_eq(names(path(v, ["direct", "definitions"])), ["m.two"]);
  assert_eq(names(path(v, ["direct", "tests"])), []);
  assert_eq(names(path(v, ["transitive", "definitions"])), ["m.three", "m.two"]);
  assert_eq(names(path(v, ["transitive", "tests"])), ["two is two"]);
  assert_eq(names(path(v, ["transitive", "laws"])), ["three is three"]);
  let alone = stdout(in_memory(one(source()), ["callers", "m.alone"]));
  assert(string_contains(alone, "test \"alone is three\""), Some(alone));
  assert_eq(in_memory(one(source()), ["callers", "nothing"]).code, 2)
}
