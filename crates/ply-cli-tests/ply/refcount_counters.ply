// `ply run --json` reports what the machine reused, and the counts follow the program.

import harness (scratch, on_disk, program, json_of, at, path, int, shown, Reached, Shipped)
import std.json (Json, Number)

// The growing field last, so the machine can reuse at every step and the counts are round.
fn appends(n: Int) -> String =
  \\fn build(n: Int) -> List<Int> / {abort.raise} =
  \\  iterate({i: 0, out: []}, n + 1, |s: {i: Int, out: List<Int>}|
  \\    if s.i >= n { Stop(s.out) } else { Continue({i: s.i + 1, out: push(s.out, s.i)}) })
  \\fn main() -> Int / {abort.raise} = len(build(
    ++ int_to_string(n)
    ++ "))\n"

fn counters(n: Int) -> Json / {Reached, Shipped, abort.raise, diverges} = {
  program(appends(n));
  at(json_of(on_disk(["run", "--json", "m.ply"])), "counters")
}

test "the machine reports what it reused" {
  scratch(|| {
    let c = counters(200);
    assert(int(at(c, "updates")) == 200, Some("200 appends were made: " ++ shown(c)));
    // The C backend reads `s.out` with a count of its own rather than taking the field, so the ratio is not 1.0.
    match at(c, "in_place") {
      Number(ratio) -> assert(ratio >= 0m && ratio <= 1m, Some(shown(c))),
      _ -> panic("the reuse ratio is reported: " ++ shown(c)),
    }
  })
}

test "the counts follow the program rather than being a constant" {
  scratch(|| {
    assert_eq(int(at(counters(10), "updates")), 10);
    assert_eq(int(at(counters(200), "updates")), 200)
  })
}

fn fills(n: Int) -> String =
  \\fn fill(xs: Array<Int>, i: Int) -> Array<Int> / {abort.raise} =
  \\  if i >= array_len(xs) { xs } else { fill(array_set(xs, i, i), i + 1) }
  \\fn main() -> Int / {abort.raise} = array_len(fill(array_new(
    ++ int_to_string(n)
    ++ ", 0), 0))\n"

test "an array handed down to its last holder is written in place at every step" {
  scratch(|| {
    program(fills(100));
    let c = at(json_of(on_disk(["run", "--json", "m.ply"])), "counters");
    assert(int(at(c, "updates")) == 100, Some("100 writes were made: " ++ shown(c)));
    assert(int(at(c, "updates_in_place")) == 100, Some("every write is in place: " ++ shown(c)))
  })
}
