// `ply run --json` reports what the machine reused, and the counts follow the program.

import harness (on_disk, program, json_of, at, path, int, shown)
import std.json (Json, Number)

// The growing field last, so the machine can reuse at every step and the counts are round.
fn appends(n: Int) -> String =
  \\fn build(n: Int) -> List<Int> =
  \\  iterate({i: 0, out: []}, n + 1, |s: {i: Int, out: List<Int>}|
  \\    if s.i >= n { Stop(s.out) } else { Continue({i: s.i + 1, out: push(s.out, s.i)}) })
  \\fn main() -> Int = len(build(
    ++ int_to_string(n)
    ++ "))\n"

fn counters(n: Int) -> Json = {
  program(appends(n));
  at(json_of(on_disk(["run", "--json", "m.ply"])), "counters")
}

test/nondet "the machine reports what it reused" {
  let c = counters(200);
  assert(int(at(c, "updates")) == 200, Some("200 appends were made: " ++ shown(c)));
  // The tier reads `s.out` with a count of its own rather than taking the field, so the ratio is not 1.0.
  match at(c, "in_place") {
    Number(ratio) -> assert(ratio >= 0m && ratio <= 1m, Some(shown(c))),
    _ -> panic("the reuse ratio is reported: " ++ shown(c)),
  }
}

test/nondet "the counts follow the program rather than being a constant" {
  assert_eq(int(at(counters(10), "updates")), 10);
  assert_eq(int(at(counters(200), "updates")), 200)
}
