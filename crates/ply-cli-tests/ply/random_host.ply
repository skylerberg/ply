//! `std.random`: the entropy a run that is not simulated has. The prelude's `random` is the
//! scheduler's, answered with values a seed decides; a program that needs a value a server cannot
//! predict, a SASL nonce or a key, reads this instead, and the host draws it.

import harness (Here, Shipped, answered, bound_main, called, loaded, project)
import cli.machine (machine, default_options)
import std.string (split)
import std.value (Value, VBool, VStr)

effect set Driving = {machine.configure[run], machine.load[run], machine.bound[run], machine.call[run], machine.drop[run]}

fn drawing() -> String =
  \\import std.random (entropy, next, below, nonce)
  \\
  \\// Two draws are independent, so 63 bits each colliding is not a thing that happens.
  \\pub fn differs() -> Bool / {entropy.next} = next() != next()
  \\
  \\// A bound above zero is honoured, and a draw is the low end of the range.
  \\pub fn in_range() -> Bool / {entropy.below} = below(4) >= 0 && below(4) < 4
  \\
  \\pub fn named() -> String / {entropy.next} = nonce()
  \\
  \\// A bound the host cannot honour is refused rather than folded into range.
  \\pub fn no_range() -> Int / {entropy.below} = below(0)
  \\
  \\fn main() -> Int = 0
  \\

fn hosted() -> Unit / {Here, Shipped, Driving, abort.raise} = {
  project([{ path: "inner.ply", text: drawing() }]);
  loaded({ ..default_options(), host: true });
  bound_main()
}

test/nondet "a draw is the operating system's, and two of them are independent" {
  hosted();
  assert_eq(answered("differs", []), VBool(true));
  machine.drop[run]()
}

test/nondet "a bound above zero is honoured" {
  hosted();
  assert_eq(answered("in_range", []), VBool(true));
  machine.drop[run]()
}

test/nondet "a nonce names two draws" {
  hosted();
  let named = answered("named", []);
  machine.drop[run]();
  match named {
    VStr(text) -> {
      let parts = split(text, "-");
      assert_eq(len(parts), 2);
      assert(match parts { [first, ..] -> first != "", [] -> false }, Some(text))
    },
    _ -> assert(false, Some("a nonce is text")),
  }
}

test/nondet "a bound the host cannot honour is refused" {
  hosted();
  let refused = called("no_range", []);
  machine.drop[run]();
  assert(match refused { Err(d) -> string_contains(string_of_bytes_lossy(d.message), "above zero"), Ok(_) -> false }, None)
}
