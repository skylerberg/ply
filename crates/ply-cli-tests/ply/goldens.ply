// What each phase of the compiler makes of a corpus -- the examples, the kernel benchmarks, the
// shipped modules and the inputs under `crates/ply-cli-tests/phases` -- written as goldens under
// `crates/ply-cli-tests/goldens`, a directory a phase. Nothing compares them with what was there: a
// change's moved goldens are its effect on the phases, which its pull request lists and `refresh`
// commits on main. What these tests assert is that the corpus still reaches what the goldens cover.

import compiler.code
import compiler.derive
import compiler.hash
import compiler.infer
import compiler.items
import compiler.lexer
import compiler.resolve
import compiler.resolve (Source)
import compiler.rewrite
import std.bytes
import std.fs (fs)
import std.list (any, contains, find, flatten, last, sort, take)
import std.string

fn phases() -> String = "crates/ply-cli-tests/phases"

fn goldens() -> String = "crates/ply-cli-tests/goldens"

// --- The corpus -----------------------------------------------------------------

// An input a phase reads alone, and a program a phase reads whole, each named as its golden is.
type Input = { name: String, src: Bytes }

type Program = { name: String, modules: List<Source> }

fn read(path: String) -> Bytes / {fs.read[repo], abort.raise} =
  match fs.read_file[repo](path) {
    Some(b) -> b,
    None -> panic("the repository holds no `" ++ path ++ "`"),
  }

// Each `.ply` file directly in `dir`, by name, in byte order.
fn ply_names(dir: String) -> List<String> / {fs.read[repo], abort.raise} =
  match fs.list_dir[repo](dir) {
    Some(names) -> sort(filter(names, |n: String| string_ends_with(n, ".ply"))),
    None -> panic("the repository holds no directory `" ++ dir ++ "`"),
  }

fn stem(name: String) -> String / {abort.raise} = string_slice(name, 0, string_len(name) - 4)

// Each `.ply` file in `dir`, named by its path in the repository.
fn files_in(dir: String) -> List<Input> / {fs.read[repo], abort.raise} =
  map(ply_names(dir), |n: String| { name: dir ++ "/" ++ n, src: read(dir ++ "/" ++ n) })

// Each `.ply` file in `dir` as the module `prefix` and its stem name.
fn modules_in(dir: String, prefix: String) -> List<Source> / {fs.read[repo], abort.raise} =
  map(ply_names(dir), |n: String|
    { name: bytes_of_string(prefix ++ stem(n)), src: read(dir ++ "/" ++ n) })

fn std_modules() -> List<Source> / {fs.read[repo], abort.raise} =
  modules_in("crates/ply-std/ply", "std.")

fn examples() -> List<Source> / {fs.read[repo], abort.raise} = modules_in("examples", "")

// Each example as the program it is beside the standard library.
fn with_std(std: List<Source>) -> List<Program> / {fs.read[repo], abort.raise} =
  map(examples(), |e: Source|
    { name: "std + examples/" ++ string_of_bytes(e.name) ++ ".ply", modules: push(std, e) })

type Cut = { done: List<Bytes>, open: Option<List<Bytes>> }

// A bundle's records: what follows each `%%` line up to the next, the last one's final newline
// dropped. What comes before the first is the bundle's header.
fn bundle(text: Bytes) -> List<Bytes> / {abort.raise} = {
  let cut = fold(bytes_split(text, b"\n"), { done: [], open: None }, |c: Cut, line: Bytes|
    if line == b"%%" {
      {
        done: match c.open {
          Some(lines) -> push(c.done, bytes::join(lines, b"\n")),
          None -> c.done,
        },
        open: Some([]),
      }
    } else {
      match c.open { Some(lines) -> { done: c.done, open: Some(push(lines, line)) }, None -> c }
    });
  match cut.open {
    Some(lines) -> push(cut.done, without_final_newline(bytes::join(lines, b"\n"))),
    None -> cut.done,
  }
}

fn without_final_newline(b: Bytes) -> Bytes / {abort.raise} =
  if bytes_ends_with(b, b"\n") { bytes_slice(b, 0, bytes_len(b) - 1) } else { b }

// A bundle's records as inputs, each named `<file>#<index>`.
fn bundled(file: String) -> List<Input> / {fs.read[repo], abort.raise} = {
  let records = bundle(read(phases() ++ "/" ++ file));
  map(range(0, len(records)), |i: Int|
    {
      name: file ++ "#" ++ int_to_string(i),
      src: match list_at(records, i) { Some(r) -> r, None -> b"" },
    })
}

// A bundle's records as programs of the one module `module`.
fn bundled_modules(file: String, module: Bytes) -> List<Program> / {fs.read[repo], abort.raise} =
  map(bundled(file), |i: Input| { name: i.name, modules: [{ name: module, src: i.src }] })

// Programs, each after a `%%%` line, their modules split at `%%` lines, each module's first line its
// name. What comes before the first is the bundle's header.
fn programs(file: String) -> List<Program> / {fs.read[repo], abort.raise} = {
  let chunks = match bytes_split(read(phases() ++ "/" ++ file), b"\n%%%\n") {
    [_, ..rest] -> rest,
    [] -> [],
  };
  let found = fold(chunks, [], |acc: List<List<Source>>, chunk: Bytes| {
    let c = after_newlines(chunk);
    if string_trim(string_of_bytes_lossy(c)) == "" { acc }
    else { push(acc, map(bytes_split(c, b"\n%%\n"), module_of)) }
  });
  map(range(0, len(found)), |i: Int|
    {
      name: file ++ "#" ++ int_to_string(i),
      modules: match list_at(found, i) { Some(p) -> p, None -> [] },
    })
}

fn after_newlines(b: Bytes) -> Bytes / {abort.raise} =
  match bytes_position(b, 0, |c: Int| c != 10) {
    Some(i) -> bytes_slice(b, i, bytes_len(b)),
    None -> b"",
  }

fn module_of(m: Bytes) -> Source / {abort.raise} =
  match bytes_index_of_byte(m, 10) {
    Some(i) -> { name: trimmed(bytes_slice(m, 0, i)), src: bytes_slice(m, i + 1, bytes_len(m)) },
    None -> { name: trimmed(m), src: b"" },
  }

fn trimmed(b: Bytes) -> Bytes = bytes_of_string(string_trim(string_of_bytes_lossy(b)))

// --- The goldens ----------------------------------------------------------------

type Golden = { name: String, dump: Bytes }

// What is not alphanumeric, `.` or `-` is spelled `_` in a golden's file name.
fn safe(s: String) -> String =
  string_of_chars(map(string_chars(s), |c: Char| if is_safe(int_of_char(c)) { c } else { '_' }))

fn is_safe(n: Int) -> Bool =
  (n >= 48 && n <= 57) || (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || n == 46 || n == 45

type Record = { bundle: String, index: Int }

// A bundle's record, `<bundle>#<index>`, shares `<bundle>.dumps` with the bundle's others.
fn record_of(name: String) -> Option<Record> / {abort.raise} = {
  let parts = string_split(name, "#");
  match last(parts) {
    Some(index) if len(parts) > 1 && is_digits(index) -> match string::int_of_string(index) {
      Some(i) -> Some({ bundle: string::join(take(parts, len(parts) - 1), "#"), index: i }),
      None -> None,
    },
    _ -> None,
  }
}

fn is_digits(s: String) -> Bool / {abort.raise} =
  s != "" && all_bytes(bytes_of_string(s), |b: Int| b >= 48 && b <= 57)

fn all_bytes(b: Bytes, ok: (Int) -> Bool) -> Bool / {abort.raise} =
  match bytes_position(b, 0, |c: Int| !ok(c)) { Some(_) -> false, None -> true }

// A dump with no newline of its own goes one field per line under a `%;` header, so two changes to
// different definitions merge; one holding newlines is written as it is.
fn unfolded(dump: Bytes) -> Bytes / {abort.raise} =
  match bytes_index_of_byte(dump, 10) {
    Some(_) -> dump,
    None -> bytes_concat(b"%;\n", bytes::join(bytes_split(dump, b";"), b";\n")),
  }

// Each golden file of a phase and what it holds.
fn files_of(gs: List<Golden>) -> Map<String, Bytes> / {abort.raise} = {
  let pieces = fold(gs, map_new(), |acc: Map<String, List<Bytes>>, g: Golden|
    match record_of(g.name) {
      Some(r) -> {
        let file = safe(r.bundle) ++ ".dumps";
        let entry = bytes_concat_all([
          b"%%% ",
          bytes_of_string(int_to_string(r.index)),
          b"\n",
          unfolded(g.dump),
          b"\n",
        ]);
        map_insert(acc, file, push(match map_get(acc, file) { Some(es) -> es, None -> [] }, entry))
      },
      None -> map_insert(acc, safe(g.name) ++ ".dump", [unfolded(g.dump)]),
    });
  map_fold(pieces, map_new(), |acc: Map<String, Bytes>, file: String, es: List<Bytes>|
    map_insert(acc, file, bytes_concat_all(es)))
}

// The phase's directory holding exactly `gs`: each written, and any file no golden names removed.
fn written(phase: String, gs: List<Golden>) -> Unit / {fs.read[repo], fs.write[repo], abort.raise} = {
  let dir = goldens() ++ "/" ++ safe(phase);
  fs.create_dir[repo](goldens());
  fs.create_dir[repo](dir);
  let files = files_of(gs);
  map_fold(files, (), |_u: Unit, name: String, body: Bytes|
    assert(
      fs.write_file[repo](dir ++ "/" ++ name, body),
      Some("`" ++ dir ++ "/" ++ name ++ "` could not be written"),
    ));
  let stale = match fs.list_dir[repo](dir) {
    Some(names) -> filter(names, |n: String| !map_contains(files, n)),
    None -> [],
  };
  fold(stale, (), |_u: Unit, n: String|
    assert(
      fs.remove[repo](dir ++ "/" ++ n),
      Some("`" ++ dir ++ "/" ++ n ++ "` could not be removed"),
    ))
}

// --- Records ----------------------------------------------------------------------

// A dump's `;`-terminated records.
fn records(dump: Bytes) -> List<Bytes> / {abort.raise} =
  match bytes_split(dump, b";") {
    [] -> [],
    parts -> if last(parts) == Some(b"") { take(parts, len(parts) - 1) } else { parts },
  }

fn joined(rs: List<Bytes>) -> Bytes = bytes_concat_all(map(rs, |r: Bytes| bytes_concat(r, b";")))

fn at(t: Array<Bytes>, i: Int) -> Bytes = match array_at(t, i) { Some(r) -> r, None -> b"" }

fn slice(t: Array<Bytes>, from: Int, to: Int) -> List<Bytes> =
  map(range(from, min(to, array_len(t))), |i: Int| at(t, i))

// The whole-program resolution cut to its last module's records; a failed program's is kept whole.
fn own_resolved(dump: Bytes) -> Bytes / {abort.raise} = {
  let t = array_of_list(records(dump));
  let n = array_len(t);
  match string::int_of_string(string_of_bytes_lossy(at(t, 1))) {
    Some(count) if count > 0 && at(t, 0) == b"R" && at(t, 2) == b"M" -> {
      let walk = modules_kept(t, 2, bytes_of_string(int_to_string(count - 1)), []);
      let from = min(walk.at, n);
      let trees = first_at(t, from, b"P");
      let own = last_at(t, trees, n, b"P");
      joined(flatten([[at(t, 0), at(t, 1)], walk.kept, slice(t, from, trees), slice(t, own, n)]))
    },
    _ -> dump,
  }
}

type Walk = { at: Int, kept: List<Bytes> }

// From `i`, each module's `M` record and the entries after it, the module `last`'s kept.
fn modules_kept(t: Array<Bytes>, i: Int, last: Bytes, kept: List<Bytes>) -> Walk
  decreases array_len(t) - i
=
  if i >= array_len(t) || at(t, i) != b"M" { { at: i, kept: kept } } else {
    let j = entries_end(t, i + 3);
    modules_kept(t, j, last, if at(t, i + 1) == last { flatten([kept, slice(t, i, j)]) }
    else { kept })
  }

fn entries_end(t: Array<Bytes>, j: Int) -> Int =
  if j >= array_len(t) { j } else {
    let tag = at(t, j);
    if tag == b"B" || tag == b"S" { entries_end(t, j + 4) }
    else if tag == b"V" || tag == b"T" || tag == b"E" { entries_end(t, j + 5) }
    else { j }
  }

fn first_at(t: Array<Bytes>, from: Int, tag: Bytes) -> Int =
  if from >= array_len(t) || at(t, from) == tag { min(from, array_len(t)) }
  else { first_at(t, from + 1, tag) }

// The last record from `from` on that is `tag`, else `none`.
fn last_at(t: Array<Bytes>, from: Int, none: Int, tag: Bytes) -> Int =
  fold(range(from, array_len(t)), none, |found: Int, k: Int|
    if at(t, k) == tag { k } else { found })

type Keep = { keep: Bool, out: List<Bytes> }

// A whole-program dump cut to its last module's records, which a record tagged in `tags` opens with
// its key. A test's name can hold a `;`, so a record starts only where a tag is followed by a key;
// a key in `hashed` is a digest, under no module.
fn own_keyed(
  dump: Bytes,
  program: List<Source>,
  tags: List<Bytes>,
  hashed: List<Bytes>,
) -> Bytes / {abort.raise} = {
  let t = array_of_list(records(dump));
  match last(program) {
    Some(own) if contains(tags, at(t, 2)) -> {
      let names = map(program, |m: Source| m.name);
      let walk = fold(range(0, array_len(t)), { keep: true, out: [] }, |w: Keep, i: Int| {
        let token = at(t, i);
        let next = at(t, i + 1);
        let keep = if i >= 2 && contains(tags, token) {
          if contains(hashed, token) { w.keep || is_digest(next) }
          else if any(names, |m: Bytes| under(next, m)) { under(next, own.name) }
          else { w.keep }
        } else { w.keep };
        { keep: keep, out: if keep { push(w.out, token) } else { w.out } }
      });
      joined(walk.out)
    },
    _ -> dump,
  }
}

fn under(key: Bytes, m: Bytes) -> Bool / {abort.raise} =
  bytes_starts_with(key, m) && bytes_len(key) > bytes_len(m) && bytes_at(key, bytes_len(m)) == 46

fn is_digest(b: Bytes) -> Bool / {abort.raise} =
  bytes_len(b) == 64
    && all_bytes(b, |c: Int| (c >= 48 && c <= 57) || (c >= 97 && c <= 102) || (c >= 65 && c <= 70))

// --- The lexer ----------------------------------------------------------------------

// The lexer's dump with each float's text read to its bits, the form its goldens hold.
fn lexed(src: Bytes) -> Bytes / {abort.raise} =
  joined(map(records(bytes_of_string(lexer::dump(src))), float_bits))

fn float_bits(r: Bytes) -> Bytes / {abort.raise} =
  match bytes_split(r, b":") {
    [start, end, kind, text] if kind == b"f" -> match float_of_string(string_of_bytes_lossy(text)) {
      Some(f) ->
        bytes_concat_all([start, b":", end, b":f:", bytes_of_string(hex16(bits_of_float(f)))]),
      None -> r,
    },
    _ -> r,
  }

fn hex16(n: Int) -> String / {abort.raise} =
  string::join(
    map(range(0, 16), |i: Int| {
      let v = n >> 60 - 4 * i & 15;
      string_slice("0123456789abcdef", v, v + 1)
    }),
    "",
  )

// The non-ASCII cases of the lexer are its own tests; these are the corpus.
test/nondet "the lexer's goldens are what it makes of the corpus" {
  let inputs = flatten([
    files_in("examples"),
    files_in("benches/kernel"),
    files_in("crates/ply-std/ply"),
    files_in(phases() ++ "/lexer"),
  ]);
  written("lexer", map(inputs, |i: Input| { name: i.name, dump: lexed(i.src) }))
}

// --- The parser ---------------------------------------------------------------------

// Every tag the parser's dump can emit: its nodes, then its words.
fn emittable() -> List<Bytes> =
  [
    b"arm",
    b"atm",
    b"bnd",
    b"cst",
    b"der",
    b"dsp",
    b"eapp",
    b"ebin",
    b"eblk",
    b"ecel",
    b"eff",
    b"efld",
    b"ehnd",
    b"eif",
    b"elam",
    b"elit",
    b"elst",
    b"emat",
    b"epar",
    b"eprf",
    b"erec",
    b"erup",
    b"esim",
    b"etry",
    b"eun",
    b"evar",
    b"fn",
    b"reu",
    b"hcl",
    b"ident",
    b"imp",
    b"law",
    b"lnm",
    b"narg",
    b"op",
    b"pctr",
    b"plit",
    b"plst",
    b"prec",
    b"prm",
    b"pvar",
    b"por",
    b"pwld",
    b"qname",
    b"rcl",
    b"row",
    b"set",
    b"sexp",
    b"slet",
    b"slete",
    b"spc",
    b"tcon",
    b"tfn",
    b"tnm",
    b"trec",
    b"tst",
    b"tuni",
    b"tvar",
    b"ty",
    b"var",
    b"%add",
    b"%alias",
    b"%and",
    b"%bin",
    b"%bitand",
    b"%bitnot",
    b"%bitor",
    b"%bitxor",
    b"%bool",
    b"%bounded",
    b"%bytes",
    b"%char",
    b"%concat",
    b"%dec",
    b"%decreases",
    b"%div",
    b"%ensures",
    b"%eq",
    b"%false",
    b"%float",
    b"%ge",
    b"%gen",
    b"%gt",
    b"%hash",
    b"%int",
    b"%integer",
    b"%fixed",
    b"%json",
    b"%le",
    b"%lt",
    b"%mod",
    b"%mul",
    b"%names",
    b"%ne",
    b"%neg",
    b"%not",
    b"%numeric",
    b"%or",
    b"%ord",
    b"%show",
    b"%priv",
    b"%pub",
    b"%read",
    b"%rem",
    b"%requires",
    b"%shl",
    b"%shr",
    b"%str",
    b"%sub",
    b"%sum",
    b"%true",
    b"%unit",
    b"%ushr",
    b"%wide",
    b"%write",
  ]

// The node tags and words a dump reached: not a list's length `#`, an option's presence `?`, a
// payload `@`, a diagnostic `!` or its label `=`.
fn tags(dump: Bytes) -> Map<Bytes, Bool> / {abort.raise} =
  fold(records(dump), map_new(), |acc: Map<Bytes, Bool>, r: Bytes|
    if r == b"" || is_unreached(bytes_at(r, 0)) { acc }
    else if bytes_at(r, 0) == 37 { map_insert(acc, r, true) }
    else { map_insert(acc, match last(bytes_split(r, b":")) { Some(t) -> t, None -> b"" }, true) })

fn is_unreached(c: Int) -> Bool = c == 35 || c == 63 || c == 64 || c == 33 || c == 61

fn bangs(dump: Bytes) -> Int / {abort.raise} = len(bytes_split(dump, b"!")) - 1

test/nondet "the parser's goldens are what it makes of the corpus, which reaches every tag it can emit" {
  let fixtures = files_in(phases());
  let mined = bundled("reference-tests.corpus");
  assert(
    len(mined) > 700,
    Some("the mined bundle holds " ++ int_to_string(len(mined)) ++ " inputs; some have been lost"),
  );
  let dumped = |is: List<Input>|
    map(is, |i: Input| { name: i.name, dump: bytes_of_string(items::dump(i.src)) });
  let fixture_dumps = dumped(fixtures);
  let gs = flatten([
    dumped(files_in("examples")),
    dumped(files_in("crates/ply-std/ply")),
    fixture_dumps,
    dumped(mined),
  ]);
  written("parser", gs);
  let raised = fold(fixture_dumps, 0, |n: Int, g: Golden| n + bangs(g.dump));
  assert(
    raised >= 40,
    Some(
      "the fixtures raise " ++ int_to_string(raised)
        ++ " diagnostics; they exist to exercise the parser's recovery and something has stopped them reaching it",
    ),
  );
  let seen = fold(gs, map_new(), |acc: Map<Bytes, Bool>, g: Golden| map_merge(acc, tags(g.dump)));
  let listed = emittable();
  let unlisted = filter(map_keys(seen), |t: Bytes| !contains(listed, t));
  let missing = filter(listed, |t: Bytes| !map_contains(seen, t));
  assert(
    unlisted == [],
    Some(
      "the parser emitted tags `emittable` does not name: "
        ++ string_of_bytes(bytes::join(unlisted, b", ")),
    ),
  );
  assert(
    missing == [],
    Some(
      "the corpus no longer reaches " ++ string_of_bytes(bytes::join(missing, b", "))
        ++ "; an input that covered them has been deleted or changed",
    ),
  )
}

// --- The resolver -------------------------------------------------------------------

fn resolved_of(p: Program) -> Bytes / {abort.raise} =
  bytes_of_string(resolve::resolve_dump(p.modules))

test/nondet "the resolver's goldens are what it makes of the corpus" {
  let std = std_modules();
  let whole = flatten([
    [{ name: "the standard library", modules: std }],
    programs("reference-programs.corpus"),
    programs("resolve-programs.corpus"),
  ]);
  written(
    "resolve",
    flatten([
      map(whole, |p: Program| { name: p.name, dump: resolved_of(p) }),
      map(with_std(std), |p: Program| { name: p.name, dump: own_resolved(resolved_of(p)) }),
    ]),
  )
}

// --- The deriver --------------------------------------------------------------------

test/nondet "the deriver's goldens are what it makes of the corpus" {
  let alone = |prefix: String, dir: String|
    map(ply_names(dir), |n: String| {
      let name = prefix ++ stem(n);
      { name: name, modules: [{ name: bytes_of_string(name), src: read(dir ++ "/" ++ n) }] }
    });
  let ps = flatten([
    bundled_modules("derive-programs.corpus", b"t"),
    alone("examples/", "examples"),
    alone("std.", "crates/ply-std/ply"),
  ]);
  written(
    "derive",
    map(ps, |p: Program| { name: p.name, dump: bytes_of_string(derive::derive_dump(p.modules)) }),
  )
}

// --- The checker ----------------------------------------------------------------------

fn checked_of(p: Program) -> Bytes / {abort.raise} = bytes_of_string(infer::check_dump(p.modules))

fn known_of(p: Program) -> Bytes / {abort.raise} =
  bytes_of_string(infer::check_dump_known(p.modules))

test/nondet "the checker's goldens are what it makes of the corpus" {
  let std = std_modules();
  let whole = flatten([
    [{ name: "the standard library", modules: std }],
    programs("reference-programs.corpus"),
    programs("resolve-programs.corpus"),
    programs("check-programs.corpus"),
    bundled_modules("reference-checks.corpus", b"m"),
  ]);
  written(
    "infer.check_dump",
    flatten([
      map(whole, |p: Program| { name: p.name, dump: checked_of(p) }),
      map(with_std(std), |p: Program|
        {
          name: p.name,
          dump: own_keyed(checked_of(p), p.modules, [b"F", b"T", b"L", b"E", b"C"], []),
        }),
    ]),
  )
}

// Each program checked from what its own first check published.
test/nondet "the checker restored from its own interfaces answers its goldens over the corpus" {
  let ps = flatten([
    [{ name: "the standard library", modules: std_modules() }],
    programs("resolve-programs.corpus"),
    programs("check-programs.corpus"),
    programs("reference-programs.corpus"),
    bundled_modules("reference-checks.corpus", b"m"),
  ]);
  written("infer.check_dump_known", map(ps, |p: Program| { name: p.name, dump: known_of(p) }))
}

// The seam a definition-granular cache is built on, over the largest program there is: every
// definition is republished from the interface the first check stored for it, and the answer has to
// be the one walking the body gave. Held to the walked answer rather than to a golden, since a
// golden records a drift rather than refusing it.
test/nondet "the checker seeded from its own interfaces agrees on the compiler and the library" {
  let program = {
    name: "the standard library and the compiler",
    modules: flatten([std_modules(), modules_in("crates/ply-compiler/ply", "")]),
  };
  let head = bytes_of_string("K;" ++ int_to_string(len(program.modules)) ++ ";");
  let walked = checked_of(program);
  assert(
    bytes_starts_with(walked, head)
      && !bytes_starts_with(bytes_slice(walked, bytes_len(head), bytes_len(walked)), b"X;"),
    Some(
      "the standard library and the compiler do not check as one program:\n"
        ++ string_of_bytes_lossy(bytes_slice(walked, 0, min(4000, bytes_len(walked)))),
    ),
  );
  let seeded = known_of(program);
  assert(
    seeded == walked,
    Some(
      "over " ++ int_to_string(len(program.modules))
        ++ " modules, a definition published from its stored interface does not answer as the walked body did:\n"
        ++ first_difference(walked, seeded),
    ),
  )
}

// The first record two dumps disagree on, with the run-up to it from each.
fn first_difference(walked: Bytes, seeded: Bytes) -> String / {abort.raise} = {
  let a = array_of_list(records(walked));
  let b = array_of_list(records(seeded));
  let n = max(array_len(a), array_len(b));
  match find(range(0, n), |i: Int| array_at(a, i) != array_at(b, i)) {
    None -> "every record agrees, so they differ only in trailing bytes",
    Some(i) -> {
      let around = |t: Array<Bytes>|
        string::join(
          map(slice(t, max(0, i - 6), i + 8), |r: Bytes| "    " ++ string_of_bytes_lossy(r)),
          "\n",
        );
      "record " ++ int_to_string(i) ++ " differs\n  walked:\n" ++ around(a) ++ "\n  seeded:\n"
        ++ around(b)
    },
  }
}

// --- The hasher -------------------------------------------------------------------------

fn hashed_of(p: Program) -> Bytes / {abort.raise} = bytes_of_string(hash::hash_dump(p.modules))

test/nondet "the hasher's goldens are what it makes of the corpus" {
  let std = std_modules();
  let whole = flatten([
    [{ name: "the standard library", modules: std }],
    programs("resolve-programs.corpus"),
    programs("check-programs.corpus"),
    programs("reference-programs.corpus"),
    bundled_modules("reference-checks.corpus", b"m"),
    bundled_modules("reference-hashes.corpus", b"m"),
  ]);
  written(
    "hash",
    flatten([
      map(whole, |p: Program| { name: p.name, dump: hashed_of(p) }),
      map(with_std(std), |p: Program|
        {
          name: p.name,
          dump: own_keyed(
            hashed_of(p),
            p.modules,
            [b"H", b"Y", b"T", b"L", b"W", b"O", b"S", b"X", b"D", b"C"],
            [b"T", b"L", b"W"],
          ),
        }),
    ]),
  )
}

// --- The rewrites ---------------------------------------------------------------------------

test/nondet "the rewrites' goldens are what they make of the corpus" {
  let inputs = flatten([
    files_in("examples"),
    files_in("crates/ply-std/ply"),
    files_in(phases()),
    bundled("reference-tests.corpus"),
  ]);
  written(
    "rewrite",
    map(inputs, |i: Input| { name: i.name, dump: bytes_of_string(rewrite::dump_expanded(i.src)) }),
  )
}

// --- Effects ---------------------------------------------------------------------------------

// What this arms is the corpus, not a tier: if the last `handle` or the last `with cell` left it,
// effect work in the compiled tier would have nothing to be checked against. Counted on the lowering
// rather than the surface text: `with cell` reaches a `cell(` node its spelling does not contain, and
// `$` is how the lowering spells a resource a label parameter names.
test/nondet "the corpus still exercises every effect construct a tier has to carry" {
  let inputs = flatten([files_in("crates/ply-std/ply"), files_in("examples"), files_in(phases())]);
  let bodies = flatten(
    map(inputs, |i: Input|
      match bytes_split(bytes_of_string(code::lower_dump(i.src)), b"f:") {
        [_, ..rest] -> rest,
        [] -> [],
      }),
  );
  let reached = |tag: Bytes| any(bodies, |b: Bytes| bytes_index_of(b, tag) != None);
  let lost = filter([b"perform(", b"handle(", b"cell(", b"$"], |tag: Bytes| !reached(tag));
  assert(
    lost == [],
    Some(
      "no body in the corpus reaches " ++ string_of_bytes(bytes::join(lost, b", "))
        ++ " any more, so nothing checks the compiled tier's implementation of it",
    ),
  )
}
