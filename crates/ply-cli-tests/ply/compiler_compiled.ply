// The compiler's own tests, run with the C backend as the only engine: the emitter over its own
// sources once more. It takes every core a runner has, so CI gives it a runner of its own.

import harness (project, write, repo_file, on_disk, json_of)
import corpus (green, entered)
import std.fs (fs)

test/nondet "the C backend runs the compiler's own tests as the only engine" {
  project([]);
  match fs.list_dir[repo]("crates/ply-compiler/ply") {
    Some(names) ->
      fold(names, (), |u: Unit, name: String|
        if string_ends_with(name, ".ply") {
          write("compiler/" ++ name, repo_file("crates/ply-compiler/ply/" ++ name))
        } else { u }),
    None -> panic("the repository holds the compiler"),
  };
  // What the checker embeds from beside its package.
  write("prelude.ply", repo_file("crates/ply-compiler/prelude.ply"));
  let report = json_of(on_disk(["test", "compiler", "--no-cache", "--json"]));
  green(report, "the C backend over the compiler's own sources");
  entered(report, "the C backend")
}
