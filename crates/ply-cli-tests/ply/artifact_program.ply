//! The packages the `ply` program is built from, and the shipped modules it is built against. CI's
//! `refresh` job builds the artifact and its digest on main, so no pull request carries either.

import harness (scratch, Package, Source, project, repo, manifest_closure, program_packages,
                shipped_sources, shipped_drift, tree_digests, on_disk, in_memory, tree, spawned,
                said, stderr, json_of, at, items, first, str, shown)
import cli.sources (is_std, is_compiler)
import compiler.unit (shipped)
import std.json (Json)
import std.string

fn package(prefix: String, deps: List<String>) -> Package = { prefix: prefix, deps: deps }

test/nondet "the CLI tree is a package" {
  let cli = manifest_closure(repo() ++ "/crates/ply-cli/ply");
  // A run in this process keys reuse on a digest of the packages the program is built from, so the
  // harness has to name every one of them.
  assert(
    cli.dirs.len() == program_packages().len()
      && cli.dirs.filter(|d: String|
        program_packages().filter(|p: String| d.ends_with("/" ++ p)).len() == 1).len(
      )
      == cli.dirs.len(),
    Some(
      "the CLI is read from " ++ String::join(cli.dirs, ", ") ++ " and the harness digests "
        ++ String::join(program_packages(), ", "),
    ),
  );
  assert(
    cli.packages
      == [
        package("cli", ["suite", "sim", "store", "proof"]),
        package("suite", []),
        package("sim", []),
        package("store", []),
        package("proof", ["sim"]),
      ],
    Some(
      "the CLI tree's ply.pkg names it the `cli` package, closed over the suite, the search, the store and the prove package",
    ),
  )
}

// The harness hands `ply` the shipped modules from its trees, so the binary must ship those trees.
test "the binary carries the shipped modules' trees as they stand" {
  let drift = shipped_drift();
  assert(
    drift.len() == 0,
    Some("shipped other than the trees hold them: " ++ String::join(drift, ", ")),
  )
}

// A bootstrap lists a checkout's files so too: a pack stands only for the very files it lists.
test "the binary lists each file it ships by name and digest, as the trees hold them" {
  assert_eq(shipped.digests(), tree_digests())
}

test "the compiler is among the shipped modules under its own root and nothing may shadow it" {
  let modules = items(at(json_of(in_memory(tree([]), ["std", "--show", "--json"])), "sources")).map(
    |m: Json| str(at(m, "module")),
  );
  assert(modules.filter(|m: String| m == "std.path").len() == 1, Some(String::join(modules, " ")));
  assert(is_compiler("compiler.fmt"), None);
  assert(is_std("std.fs"), None);
  assert(!is_compiler("compilers.fmt") && !is_std("compilers.fmt"), None);
  assert(!is_compiler("fmt") && !is_std("fmt"), None);

  let collided = json_of(
    in_memory(tree([{ path: "compiler/fmt.ply", text: "pub fn f() -> Int = 1\n" }]), [
      "check",
      "--json",
    ]),
  );
  let diagnostics = items(at(collided, "diagnostics"));
  assert(diagnostics.len() == 1, Some(shown(collided)));
  assert(str(at(first(diagnostics), "code")) == "E0133", Some(shown(collided)));
  assert(str(at(first(diagnostics), "message")).contains("compiler.fmt"), Some(shown(collided)));

  // A name that merely starts with the letters is no collision.
  let ok = in_memory(tree([{ path: "compilers.ply", text: "pub fn f() -> Int = 1\n" }]), ["check"]);
  assert(ok.code == 0, Some("`compilers` is an ordinary module name: " ++ said(ok)))
}

/// The module path an `import` line opens with.
fn imported(line: String) -> String / {abort.raise} = {
  let rest = Bytes::of_string(line.slice("import ".len(), line.len()));
  let class = b"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.";
  String::of_bytes(rest.slice(0, rest.scan(0, class, rest.len())))
}

// The shipped modules are handed over as text, and the front end and the emitter each parse it:
// every import a shipped module makes must resolve there, an import of another package in full or
// the compiler package's own sibling.
test "every shipped module imports its siblings under the names they are filed under" {
  let modules = shipped_sources().map(|source: Source|
    { name: source.path.slice(0, source.path.len() - 4), text: source.text });
  let filed = modules.map(|m: { name: String, text: String }| m.name);
  let files = |n: String| filed.filter(|f: String| f == n).len() > 0;
  modules.fold((), |u: Unit, m: { name: String, text: String }|
    m.text.split("\n").filter(|l: String| l.starts_with("import ")).fold(
      u,
      |v: Unit, line: String| {
        let p = imported(line);
        assert(
          files(p) || (is_compiler(m.name) && files("compiler." ++ p)),
          Some("`" ++ m.name ++ "` imports `" ++ p ++ "`, which no shipped module is filed as"),
        )
      },
    ))
}

test "a program may import the formatter from the shipped modules" {
  scratch(|| {
    project([
      {
        path: "app.ply",
        text:
          \\import compiler.fmt (fmt_source)
          \\
          \\fn main() -> Bool / {abort.raise} =
          \\  match fmt_source(b"fn  f()->Int=1") {
          \\    Ok(text) -> text != b"fn  f()->Int=1",
          \\    Err(_) -> false,
          \\  }
          \\
      },
    ]);
    let r = on_disk(["check", "--json"]);
    assert(r.code == 0, Some(shown(json_of(r))))
  })
}

// The path argument every command defaults to is `.`, and a root bound to what that tidies to has
// to be a directory that resolves: an empty one is `E0454` before the program runs at all.
test "every ported command answers with no path argument" {
  scratch(|| {
    project([{ path: "m.ply", text: "pub fn one() -> Int = 1\n" }]);
    // `ply fmt --check` over a tree that needs no rewriting writes nothing; every other row does.
    [
      { args: ["defs"], writes: true },
      { args: ["defs", "--json"], writes: true },
      { args: ["hash"], writes: true },
      { args: ["hash", "--json"], writes: true },
      { args: ["doc", "one"], writes: true },
      { args: ["doc", "one", "--json"], writes: true },
      { args: ["show", "one"], writes: true },
      { args: ["show", "one", "--json"], writes: true },
      { args: ["callers", "one"], writes: true },
      { args: ["callers", "one", "--json"], writes: true },
      { args: ["std", "--digest"], writes: true },
      { args: ["explain", "E0001"], writes: true },
      { args: ["hosts"], writes: true },
      { args: ["hosts", "--json"], writes: true },
      { args: ["hosts", "--digest"], writes: true },
      { args: ["cache", "stats"], writes: true },
      { args: ["cache", "stats", "--json"], writes: true },
      { args: ["fmt", "--check"], writes: false },
    ].fold((), |u: Unit, c: { args: List<String>, writes: Bool }| {
      let r = on_disk(c.args);
      let shown_as = "`ply " ++ String::join(c.args, " ") ++ "`";
      assert(r.code == 0, Some(shown_as ++ " exited " ++ r.code.to_string() ++ "\n" ++ stderr(r)));
      assert(!c.writes || r.out.len() > 0, Some(shown_as ++ " wrote nothing"))
    })
  })
}
