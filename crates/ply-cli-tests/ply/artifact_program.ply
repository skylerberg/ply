// The packages the `ply` program is built from, and the shelf it is built against. CI's `refresh`
// job builds the artifact and its digest on main, so no pull request carries either.

import harness (scratch, Package, Source, project, repo, closure_of, manifest_closure,
                program_packages, shelved, shelf_drift, on_disk, in_memory, tree, spawned, said,
                stderr, json_of, at, items, first, str, shown)
import cli.sources (is_std, is_compiler)
import std.json (Json)
import std.string

fn package(prefix: String, deps: List<String>) -> Package = { prefix: prefix, deps: deps }

test/nondet "the CLI tree is a package" {
  let cli = manifest_closure(repo() ++ "/crates/ply-cli/ply");
  // A run in this process keys reuse on a digest of the packages the program is built from, so the
  // harness has to name every one of them.
  assert(
    len(cli.dirs) == len(program_packages())
      && len(
        filter(cli.dirs, |d: String|
          len(filter(program_packages(), |p: String| string_ends_with(d, "/" ++ p))) == 1),
      )
      == len(cli.dirs),
    Some(
      "the CLI is read from " ++ string::join(cli.dirs, ", ") ++ " and the harness digests "
        ++ string::join(program_packages(), ", "),
    ),
  );
  assert(
    cli.packages
      == [
        package("cli", ["suite", "sim", "store", "proof"]),
        package("suite", []),
        package("sim", []),
        package("store", []),
        package("proof", ["sim"]),
      ],
    Some(
      "the CLI tree's ply.pkg names it the `cli` package, closed over the suite, the search, the store and the prove package",
    ),
  )
}

test/nondet "the corpus tree is a package over the CLI" {
  assert(
    closure_of(repo() ++ "/crates/ply-corpus/ply")
      == [
        package("corpus", ["cli", "suite", "proof"]),
        package("cli", ["suite", "sim", "store", "proof"]),
        package("suite", []),
        package("proof", ["sim"]),
        package("sim", []),
        package("store", []),
      ],
    Some(
      "the corpus tree's ply.pkg names it the `corpus` package over the CLI's and the two packages it reads as the CLI does, the suite and the prove package",
    ),
  )
}

// The harness hands `ply` the shelf from its trees, so the binary must ship those trees.
test "the binary ships the shelf's trees as they stand" {
  let drift = shelf_drift();
  assert(
    len(drift) == 0,
    Some("shipped other than the trees hold them: " ++ string::join(drift, ", ")),
  )
}

test "the compiler is on the shelf under its own root and nothing may shadow it" {
  let modules = map(
    items(at(json_of(in_memory(tree([]), ["std", "--json"])), "modules")),
    |m: Json| str(at(m, "module")),
  );
  assert(len(filter(modules, |m: String| m == "std.path")) == 1, Some(string::join(modules, " ")));
  assert(is_compiler("compiler.fmt"), None);
  assert(is_std("std.fs"), None);
  assert(!is_compiler("compilers.fmt") && !is_std("compilers.fmt"), None);
  assert(!is_compiler("fmt") && !is_std("fmt"), None);

  let collided = json_of(
    in_memory(tree([{ path: "compiler/fmt.ply", text: "pub fn f() -> Int = 1\n" }]), [
      "check",
      "--json",
    ]),
  );
  let diagnostics = items(at(collided, "diagnostics"));
  assert(len(diagnostics) == 1, Some(shown(collided)));
  assert(str(at(first(diagnostics), "code")) == "E0133", Some(shown(collided)));
  assert(
    string_contains(str(at(first(diagnostics), "message")), "compiler.fmt"),
    Some(shown(collided)),
  );

  // A name that merely starts with the letters is no collision.
  let ok = in_memory(tree([{ path: "compilers.ply", text: "pub fn f() -> Int = 1\n" }]), ["check"]);
  assert(ok.code == 0, Some("`compilers` is an ordinary module name: " ++ said(ok)))
}

// The module path an `import` line opens with.
fn imported(line: String) -> String = {
  let rest = bytes_of_string(string_slice(line, string_len("import "), string_len(line)));
  let class = b"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.";
  string_of_bytes(bytes_slice(rest, 0, bytes_scan(rest, 0, class, bytes_len(rest))))
}

// The shelf hands over text, and the front end and the emitter each parse it: every import a
// shelved module makes must resolve there, an import of another package in full or the compiler
// package's own sibling.
test "every shelved module imports the shelf under the names it files them under" {
  let modules = map(shelved(), |s: Source|
    { name: string_slice(s.path, 0, string_len(s.path) - 4), text: s.text });
  let filed = map(modules, |m: { name: String, text: String }| m.name);
  let files = |n: String| len(filter(filed, |f: String| f == n)) > 0;
  fold(modules, (), |u: Unit, m: { name: String, text: String }|
    fold(
      filter(string_split(m.text, "\n"), |l: String| string_starts_with(l, "import ")),
      u,
      |v: Unit, line: String| {
        let p = imported(line);
        assert(
          files(p) || (is_compiler(m.name) && files("compiler." ++ p)),
          Some(
            "`" ++ m.name ++ "` imports `" ++ p ++ "`, which the shelf files under no such name",
          ),
        )
      },
    ))
}

test "a program may import the formatter off the shelf" {
  scratch(|| {
    project([
      {
        path: "app.ply",
        text:
          \\import compiler.fmt (fmt_source)
          \\
          \\fn main() -> Bool =
          \\  match fmt_source(b"fn  f()->Int=1") {
          \\    Ok(text) -> text != b"fn  f()->Int=1",
          \\    Err(_) -> false,
          \\  }
          \\
      },
    ]);
    let r = on_disk(["check", "--json"]);
    assert(r.code == 0, Some(shown(json_of(r))))
  })
}

// The path argument every command defaults to is `.`, and a root bound to what that tidies to has
// to be a directory that resolves: an empty one is `E0454` before the program runs at all.
test "every ported command answers with no path argument" {
  scratch(|| {
    project([{ path: "m.ply", text: "pub fn one() -> Int = 1\n" }]);
    // `ply fmt --check` over a tree that needs no rewriting writes nothing; every other row does.
    fold(
      [
        { args: ["defs"], writes: true },
        { args: ["defs", "--json"], writes: true },
        { args: ["hash"], writes: true },
        { args: ["hash", "--json"], writes: true },
        { args: ["doc", "one"], writes: true },
        { args: ["doc", "one", "--json"], writes: true },
        { args: ["show", "one"], writes: true },
        { args: ["show", "one", "--json"], writes: true },
        { args: ["callers", "one"], writes: true },
        { args: ["callers", "one", "--json"], writes: true },
        { args: ["std"], writes: true },
        { args: ["std", "--json"], writes: true },
        { args: ["std", "--digest"], writes: true },
        { args: ["explain", "E0001"], writes: true },
        { args: ["hosts"], writes: true },
        { args: ["hosts", "--json"], writes: true },
        { args: ["hosts", "--digest"], writes: true },
        { args: ["cache", "stats"], writes: true },
        { args: ["cache", "stats", "--json"], writes: true },
        { args: ["fmt", "--check"], writes: false },
      ],
      (),
      |u: Unit, c: { args: List<String>, writes: Bool }| {
        let r = on_disk(c.args);
        let shown_as = "`ply " ++ string::join(c.args, " ") ++ "`";
        assert(
          r.code == 0,
          Some(shown_as ++ " exited " ++ int_to_string(r.code) ++ "\n" ++ stderr(r)),
        );
        assert(!c.writes || len(r.out) > 0, Some(shown_as ++ " wrote nothing"))
      },
    )
  })
}
