//! `edit_gate`'s edits made to every module of the tree: each example within the examples, each of
//! the compiler's modules within its package, and each module of the standard library as the
//! examples read it, standing in for the one the binary ships. Too long for a pull request's lanes,
//! a seventh of it runs each night, and a pull request runs the cases of the modules it edits
//! (`ci-shards.sh sweep-matrix`).

import edit_gate (every_edit, disagreements, shipped_disagreements, held_through)
import harness (Source, scratch, project, example_files, compiler_tree, prelude_file, std_modules,
                StdModule)

fn ply_files(files: List<{ name: String, bytes: Bytes }>) -> List<{ name: String, bytes: Bytes }> =
  filter(files, |f: { name: String, bytes: Bytes }| string_ends_with(f.name, ".ply"))

fn examples() -> List<Source> / {abort.raise} =
  map(example_files(), |f: { name: String, bytes: Bytes }|
    { path: f.name, text: string_of_bytes(f.bytes) })

fn example_names() -> List<String> =
  map(ply_files(example_files()), |f: { name: String, bytes: Bytes }| f.name)

/// The compiler's package under `ply`, with the prelude it embeds from beside it.
fn compiler() -> List<Source> / {abort.raise} =
  push(
    map(compiler_tree(), |f: { name: String, bytes: Bytes }|
      { path: "ply/" ++ f.name, text: string_of_bytes(f.bytes) }),
    { path: "prelude.ply", text: string_of_bytes(prelude_file()) },
  )

fn compiler_names() -> List<String> =
  map(ply_files(compiler_tree()), |f: { name: String, bytes: Bytes }| f.name)

fn stds() -> List<String> / {abort.raise} = map(std_modules(), |m: StdModule| m.module)

fn std_module(name: String) -> StdModule / {abort.raise} =
  match filter(std_modules(), |m: StdModule| m.module == name) {
    [m, ..] -> m,
    [] -> panic("no module of the standard library is named `" ++ name ++ "`"),
  }

test "editing examples/{name} agrees warm and cold" for name: String in example_names() {
  scratch(|| {
    project(examples());
    held_through(disagreements(".", [name], every_edit()), 1)
  })
}

test "editing compiler/{name} agrees warm and cold" for name: String in compiler_names() {
  scratch(|| {
    project(compiler());
    held_through(disagreements("ply", ["ply/" ++ name], every_edit()), 1)
  })
}

test "editing {name} agrees warm and cold where the examples read it" for name: String in stds() {
  scratch(|| {
    project(examples());
    held_through(shipped_disagreements(".", std_module(name), every_edit()), 1)
  })
}
