// `ply test` as a person runs it: what it selects and why, what it remembers between runs, what it
// reports in text and in JSON, how it schedules, the binding it runs under, and the search it
// publishes.

import harness (scratch, Ran, Server, Source, in_memory, on_disk, on_disk_shipping, speaking,
                next_line, stop, one, program, project, write, stdout, stderr, said, json_of, at,
                path, nth, items, str, int, truth, shown, Here, Reached, Shelf, Spawned)
import compiler.unit (shipped)
import std.fs (fs)
import std.json
import std.json (Json, Null, Number, Array, Str)
import std.string
import std.time (time)
import std.list (concat)

fn green() -> String =
  \\fn double(x: Int) -> Int = x * 2
  \\
  \\fn main() -> Int = double(21)
  \\
  \\test "double doubles" { assert_eq(double(4), 8) }
  \\
  \\test "double of zero is zero" { assert_eq(double(0), 0) }
  \\

fn red() -> String =
  \\fn balance() -> Int = 0 - 5
  \\
  \\fn main() -> Int = balance()
  \\
  \\test "balance never goes negative" { assert_eq(balance(), 0) }
  \\
  \\test "this one is fine" { assert_eq(1 + 1, 2) }
  \\

// The first line a run printed, without the indent a report gives it.
fn first_line(ran: Ran) -> String / {abort.raise} =
  match ran.out { [l, ..] -> string::trim(l), [] -> "" }

fn tested(flags: List<String>) -> Json / {Reached, Shelf, abort.raise, diverges} =
  json_of(on_disk(concat(["test", "--json"], flags)))

fn refused(v: Json) -> Bool = at(v, "ok") == json::Bool(false)

fn code_of(v: Json) -> String = str(at(nth(at(v, "diagnostics"), 0), "code"))

fn number(j: Json) -> Float = match j { Number(d) -> float_of_decimal(d), _ -> -1.0 }

fn is_number(j: Json) -> Bool = match j { Number(_) -> true, _ -> false }

fn result_of(v: Json, name: String) -> Json =
  match filter(items(at(v, "results")), |r: Json| str(at(r, "name")) == name) {
    [r, ..] -> r,
    [] -> Null,
  }

fn status_of(v: Json, name: String) -> String = str(at(result_of(v, name), "status"))

fn selected_test(v: Json, name: String) -> Json / {abort.raise} =
  match filter(items(path(v, ["selection", "tests"])), |t: Json| str(at(t, "name")) == name) {
    [t, ..] -> t,
    [] -> panic("no selected test `" ++ name ++ "`: " ++ shown(v)),
  }

fn escape() -> String / {abort.raise} = string_of_bytes(b"\x1b")

// --- Selection and the cache --------------------------------------------------

test "test leads with the selection line" {
  scratch(|| {
    program(green());
    let r = on_disk(["test"]);
    assert(r.code == 0, Some(said(r)));
    assert(first_line(r) == "selected 2 of 2 (0 cached)", Some(stdout(r)));
    // The worker count is the machine's, which a deterministic run does not know.
    assert(string_contains(stdout(r), " worker"), Some(stdout(r)));
    assert(string_contains(stdout(r), "0 failed, 2 passed, 0 cached"), Some(stdout(r)))
  })
}

test "a second run selects nothing because the cache is exact" {
  scratch(|| {
    program(green());
    assert(on_disk(["test"]).code == 0, None);
    let again = on_disk(["test"]);
    assert(again.code == 0, Some(said(again)));
    assert(string_contains(stdout(again), "selected 0 of 2 (2 cached)"), Some(stdout(again)));
    assert(string_contains(stdout(again), "0 failed, 0 passed, 2 cached"), Some(stdout(again)))
  })
}

// The next report a watching run wrote, one document a line.
fn report(server: Server, what: String) -> Json / {Spawned, abort.raise} =
  match next_line(server, 60000) {
    None -> {
      stop(server);
      panic("`--watch` " ++ what)
    },
    Some(line) -> match json::parse_string(line) {
      Ok(v) -> v,
      Err(_) -> {
        stop(server);
        panic("`--watch` wrote a line that is no report: " ++ line)
      },
    },
  }

// `text` written over `file` until its modification time moves off `before`, which is the whole
// signal an unchanged save leaves: a filesystem that stamps coarsely would otherwise hand the
// watcher two equal walks.
fn saved(
  file: String,
  text: String,
  before: Option<Int>,
) -> Option<Int> / {Here, time.elapsed_ms, time.sleep_ms, abort.raise} = {
  let deadline = time.elapsed_ms() + 60000;
  iterate((), 60000, |u: Unit| {
    write(file, text);
    let after = fs.modified_ms[cwd](file);
    if after != before { Stop(after) } else if time.elapsed_ms() > deadline {
      panic("a save never moved the modification time of `" ++ file ++ "`")
    } else {
      time.sleep_ms(10);
      Continue(u)
    }
  })
}

test/nondet "watch reruns on a save and keeps the front end it already had" {
  program(green());
  let s = speaking(["test", "--watch", "--json"], []);
  let first = report(s, "reported no first iteration");
  // Saved byte for byte as it is: the common case, and the one that must not cost a front end.
  let stamped = saved("m.ply", green(), fs.modified_ms[cwd]("m.ply"));
  let second = report(s, "did not run again when the tree moved");
  // An edit, which the next report has to be about rather than the program the watch began with.
  let _ = saved("m.ply", red(), stamped);
  let edited = report(s, "did not report the edit");
  stop(s);
  assert(
    refused(edited),
    Some("the report after an edit tested the program the watch began with: " ++ shown(edited)),
  );
  assert(truth(at(first, "ok")), Some(shown(first)));
  assert(truth(at(second, "ok")), Some(shown(second)));
  // The save changed no byte, so the second iteration re-derived no front end.
  assert(
    number(path(second, ["front_end", "phases", "total"])) == 0.0,
    Some(
      "a warm iteration over an unchanged tree paid a front end anyway: "
        ++ shown(at(second, "front_end")),
    ),
  );
  assert(
    number(path(first, ["front_end", "phases", "total"])) > 0.0,
    Some(
      "the first iteration paid no front end either, so the assertion above proves nothing: "
        ++ shown(at(first, "front_end")),
    ),
  )
}

test "renaming a definition re-runs nothing" {
  scratch(|| {
    program("fn width() -> Int = 3\ntest \"width is three\" { assert_eq(width(), 3) }\n");
    assert(on_disk(["test"]).code == 0, None);
    write(
      "m.ply",
      "fn breadth() -> Int = 3\ntest \"width is three\" { assert_eq(breadth(), 3) }\n",
    );
    let text = stdout(on_disk(["test"]));
    assert(
      string_contains(text, "selected 0 of 1 (1 cached)"),
      Some("a rename rebuilt something:\n" ++ text),
    )
  })
}

test "editing a body re-runs exactly the tests that reach it" {
  scratch(|| {
    let tests = "test \"a is one\" { assert_eq(a(), 1) }\ntest \"b is two\" { assert_eq(b(), 2) }\n";
    program("fn a() -> Int = 1\nfn b() -> Int = 2\n" ++ tests);
    assert(on_disk(["test"]).code == 0, None);
    write("m.ply", "fn a() -> Int = len([1])\nfn b() -> Int = 2\n" ++ tests);
    let v = tested([]);
    assert(int(path(v, ["selection", "selected"])) == 1, Some(shown(v)));
    assert(int(path(v, ["selection", "cached"])) == 1, Some(shown(v)));
    assert(
      map(items(at(v, "results")), |r: Json| str(at(r, "name"))) == ["a is one"],
      Some(shown(v)),
    )
  })
}

test "an edit the compiler makes the same code of re-runs nothing" {
  scratch(|| {
    let tests = "test \"a is one\" { assert_eq(a(), 1) }\n";
    program("fn a() -> Int = 1\n" ++ tests);
    assert(on_disk(["test"]).code == 0, None);
    // Two literals under `+` are folded, so this body is emitted as the one it replaced.
    write("m.ply", "fn a() -> Int = 0 + 1\n" ++ tests);
    let v = tested([]);
    assert(int(path(v, ["selection", "selected"])) == 0, Some(shown(v)));
    assert(int(path(v, ["selection", "by_code"])) == 1, Some(shown(v)));
    assert(str(at(selected_test(v, "a is one"), "reason")) == "same_code", Some(shown(v)))
  })
}

// `ply test` loads twice: once to select, and once more to parse the modules a selected test needs a
// body from.
test "a nondet test elsewhere does not cost an edited module its body" {
  scratch(|| {
    let counted = |n: String|
      "fn size() -> Int = " ++ n ++ "\ntest \"size is known\" { assert_eq(size(), " ++ n ++ ") }\n";
    project([
      {
        path: "clock.ply",
        text:
          \\nondet effect wall { read now() -> Int }
          \\fn tick() -> Int / {wall.read} = wall.now()
          \\test/nondet "the clock ticks" { assert_eq(handle tick() with { wall.now() -> 1, }, 1) }
          \\
      },
      { path: "shape.ply", text: counted("3") },
    ]);
    assert(on_disk(["test"]).code == 0, None);
    write("shape.ply", counted("4"));
    let r = on_disk(["test"]);
    assert(r.code == 0, Some(said(r)));
    assert(
      string_contains(stdout(r), "size is known"),
      Some("the edited module's test did not run:\n" ++ stdout(r)),
    );
    assert(!string_contains(stdout(r), "cache clear"), Some("a body went missing:\n" ++ stdout(r)))
  })
}

test "a red test re-runs until it goes green" {
  scratch(|| {
    program(red());
    assert(on_disk(["test"]).code == 1, None);
    let r = on_disk(["test"]);
    assert(r.code == 1, Some(said(r)));
    assert(
      string_contains(stdout(r), "selected 1 of 2 (1 cached)"),
      Some("a failure was cached:\n" ++ stdout(r)),
    )
  })
}

test "--no-cache runs everything and records nothing" {
  scratch(|| {
    program(green());
    assert(on_disk(["test"]).code == 0, None);
    let text = stdout(on_disk(["test", "--no-cache"]));
    assert(string_contains(text, "selected 2 of 2 (0 cached)"), Some(text));
    assert(string_contains(text, "neither read nor recorded"), Some(text));
    let after = stdout(on_disk(["test"]));
    assert(
      string_contains(after, "selected 0 of 2 (2 cached)"),
      Some("--no-cache disturbed the real cache:\n" ++ after),
    )
  })
}

test "moving a definition between modules re-runs nothing" {
  scratch(|| {
    project([
      {
        path: "app.ply",
        text: "fn one() -> Int = 1\nfn two() -> Int = one() + one()\ntest \"two is two\" { assert_eq(two(), 2) }\n",
      },
    ]);
    assert(on_disk(["test"]).code == 0, None);
    write("lib.ply", "pub fn one() -> Int = 1\n");
    write(
      "app.ply",
      "import lib\nfn two() -> Int = lib::one() + lib::one()\ntest \"two is two\" { assert_eq(two(), 2) }\n",
    );
    let text = stdout(on_disk(["test"]));
    assert(
      string_contains(text, "selected 0 of 1 (1 cached)"),
      Some("moving a definition rebuilt something:\n" ++ text),
    )
  })
}

// The shelf as a `ply` whose `names` changed would ship it: each under the hash `to`.
fn moving(names: List<String>, to: String) -> List<Source> / {Shelf, abort.raise} =
  [
    {
      path: "definitions",
      text: string::join(
        map(string::split(string_of_bytes(shipped.definitions()), "\n"), |line: String|
          match filter(names, |n: String| string_starts_with(line, n ++ " ")) {
            [n, ..] -> n ++ " " ++ to,
            [] -> line,
          }),
        "\n",
      ),
    },
  ]

test "a compiler change that leaves a test's code alone re-runs nothing" {
  scratch(|| {
    program(green());
    assert(on_disk(["test"]).code == 0, None);
    let deciding = stdout(on_disk_shipping(["test"], moving(["tests.selected"], "a")));
    assert(
      string_contains(deciding, "selected 0 of 2 (2 cached, 2 by code)"),
      Some("a pass was not found by the code its test ran:\n" ++ deciding),
    );
    // Found by its code, a pass is filed again by its test: a run that loses the code passes keeps it.
    let refiled = stdout(
      on_disk_shipping(["test"], moving(["tests.selected", "tests.ran_job"], "a")),
    );
    assert(string_contains(refiled, "selected 0 of 2 (2 cached)"), Some(refiled));
    let running = stdout(
      on_disk_shipping(["test"], moving(["tests.selected", "tests.ran_job"], "b")),
    );
    assert(
      string_contains(running, "selected 2 of 2 (0 cached)"),
      Some("a change to what runs a test re-ran nothing:\n" ++ running),
    )
  })
}

// Modules load in path order but check in dependency order, and test indices are shared between the
// two.
test "an edit re-runs the test that reaches it when load order is not dependency order" {
  scratch(|| {
    let importer = |body: String|
      "import b\nfn one() -> Int = " ++ body ++ "\ntest \"a one\" { assert_eq(one(), 1) }\n";
    project([
      { path: "a.ply", text: importer("b::zero() + 1") },
      {
        path: "b.ply",
        text: "pub fn zero() -> Int = 0\ntest \"b zero\" { assert_eq(zero(), 0) }\n",
      },
    ]);
    let v = tested([]);
    assert(int(path(v, ["summary", "passed"])) == 2, Some(shown(v)));
    write("a.ply", importer("1 + b::zero()"));
    let again = tested([]);
    assert(int(path(again, ["selection", "selected"])) == 1, Some(shown(again)));
    assert(
      map(items(at(again, "results")), |r: Json| str(at(r, "key"))) == ["a.a one"],
      Some("the wrong test was re-run: " ++ shown(again)),
    )
  })
}

test "one edited test is the only one selected" {
  scratch(|| {
    project(
      concat(
        [
          { path: "leaf.ply", text: "pub fn one() -> Int = 1\n" },
          {
            path: "used.ply",
            text: "import leaf\npub fn two() -> Int = leaf::one() + 1\ntest \"two is two\" { assert_eq(two(), 2) }\n",
          },
        ],
        map(range(0, 4), |i: Int| {
          let n = int_to_string(i);
          {
            path: "far" ++ n ++ ".ply",
            text: "fn f" ++ n ++ "() -> Int = " ++ n ++ "\ntest \"far " ++ n ++ "\" { assert_eq(f"
              ++ n
              ++ "(), "
              ++ n
              ++ ") }\n",
          }
        }),
      ),
    );
    assert(on_disk(["test"]).code == 0, None);
    write(
      "used.ply",
      "import leaf\npub fn two() -> Int = leaf::one() + 1 + 0\ntest \"two is two\" { assert_eq(two(), 2) }\n",
    );
    let r = on_disk(["test", "--explain"]);
    assert(r.code == 0, Some(said(r)));
    assert(
      string_contains(stdout(r), "selected 1 of 5"),
      Some("one test must be selected:\n" ++ stdout(r)),
    )
  })
}

test "a multi-shot program runs and caches with no flags at all" {
  scratch(|| {
    program(
      \\effect amb {
      \\  read flip[coin]() -> Bool
      \\}
      \\
      \\test "both branches" {
      \\  with_cell[trace](0) { c -> {
      \\    let total = handle {
      \\      let b = amb.flip[coin]();
      \\      cell_set(c, cell_get(c) + 1);
      \\      if b { 10 } else { 20 }
      \\    } with {
      \\      amb.flip[coin]() resume k -> k(true) + k(false),
      \\      return x -> x
      \\    };
      \\    assert_eq(total, 30);
      \\    assert_eq(cell_get(c), 2)
      \\  } }
      \\}
      \\
    );
    let cold = on_disk(["test"]);
    assert(cold.code == 0, Some(stdout(cold)));
    assert(string_contains(stdout(cold), "1 passed"), Some(stdout(cold)));
    let warm = on_disk(["test"]);
    assert(warm.code == 0, Some(stdout(warm)));
    assert(string_contains(stdout(warm), "1 cached"), Some(stdout(warm)))
  })
}

test "the front end reports where its time went" {
  scratch(|| {
    program("fn f() -> Int = 1\ntest \"f is one\" { assert_eq(f(), 1) }\n");
    assert(on_disk(["test"]).code == 0, None);
    let phases = path(tested([]), ["front_end", "phases"]);
    let parts = ["read", "front", "write_back"];
    fold(concat(parts, ["total"]), (), |u: Unit, name: String|
      assert(
        is_number(at(phases, name)),
        Some("`" ++ name ++ "` is missing from " ++ shown(phases)),
      ));
    let gap = number(at(phases, "total"))
      - fold(parts, 0.0, |sum: Float, name: String| sum + number(at(phases, name)));
    assert(
      gap < 0.5 && gap > -0.5,
      Some("the total must account for the parts: " ++ shown(phases)),
    );
    assert(
      string_contains(stdout(on_disk(["check", "--explain"])), "front-end time"),
      Some("--explain must show the breakdown"),
    )
  })
}

// --- What a run reports -------------------------------------------------------

test "test exits one on a failure and names the suspects" {
  scratch(|| {
    program(red());
    let r = on_disk(["test"]);
    assert(r.code == 1, Some(said(r)));
    let text = stdout(r);
    assert(string_contains(text, "1 failed, 1 passed"), Some(text));
    assert(string_contains(text, "balance never goes negative"), Some(text));
    assert(string_contains(text, "assertion failed: expected 0, found -5"), Some(text));
    assert(string_contains(text, "at m.ply:"), Some(text));
    assert(string_contains(text, "suspects: m.balance"), Some(text))
  })
}

test "test exits two on a compile error" {
  let r = in_memory(one("fn f() -> Int = true\n"), ["test"]);
  assert(r.code == 2, Some(said(r)));
  assert(stdout(r) == "", Some(stdout(r)))
}

test "test --json is exactly one object on stdout" {
  scratch(|| {
    program(red());
    let r = on_disk(["test", "--json"]);
    assert(r.code == 1, Some(said(r)));
    assert(r.err == [], Some("--json must not write to stderr either: " ++ stderr(r)));
    let v = json_of(r);
    assert(str(at(v, "command")) == "test", Some(shown(v)));
    assert(refused(v), Some(shown(v)));
    assert(int(at(v, "exit_code")) == 1, Some(shown(v)));
    assert(int(path(v, ["summary", "failed"])) == 1, Some(shown(v)));
    assert(int(path(v, ["summary", "passed"])) == 1, Some(shown(v)));
    let failure = nth(at(v, "failures"), 0);
    assert(
      string_contains(str(at(failure, "name")), "balance never goes negative"),
      Some(shown(failure)),
    );
    assert(str(path(failure, ["diagnostic", "code"])) == "E0501", Some(shown(failure)));
    let label = nth(path(failure, ["diagnostic", "labels"]), 0);
    assert(str(at(label, "file")) == "m.ply", Some(shown(failure)));
    assert(is_number(path(label, ["start", "line"])), Some(shown(failure)));
    // Ranked, so a consumer reading only `suspects[0]` gets the best guess rather than the
    // alphabetically first.
    assert(str(at(nth(at(failure, "suspects"), 0), "name")) == "m.balance", Some(shown(failure)));
    assert(len(items(at(failure, "suspects"))) == 1, Some(shown(failure)));
    assert(
      map(items(path(v, ["selection", "tests"])), |t: Json| at(t, "selected"))
        == [json::Bool(true), json::Bool(true)],
      Some(shown(v)),
    );
    assert(
      match at(nth(path(v, ["selection", "groups"]), 0), "footprint") {
        Str(_) -> true,
        _ -> false,
      },
      Some(shown(v)),
    )
  })
}

test "json output carries no ansi escapes" {
  scratch(|| {
    program(red());
    let r = on_disk(["test", "--json", "--color", "always"]);
    assert(
      !string_contains(stdout(r), escape()),
      Some("--json must stay machine-readable under --color always"),
    );
    let _ = json_of(r);
    ()
  })
}

test "a pipe gets ascii marks and a terminal would get glyphs" {
  scratch(|| {
    program(green());
    let piped = on_disk(["test"]);
    assert(
      len(
          filter(piped.out, |l: String|
            string_starts_with(string::trim(l), "ok ") && string_contains(l, "double doubles")),
        )
        > 0,
      Some(stdout(piped)),
    );
    assert(!string_contains(stdout(piped), "✓"), Some(stdout(piped)));
    assert(!string_contains(stdout(piped), escape()), Some(stdout(piped)));
    program(green());
    let forced = stdout(on_disk(["test", "--color", "always"]));
    assert(string_contains(forced, "✓"), Some(forced));
    assert(string_contains(forced, escape()), Some(forced))
  })
}

test "test --json carries schema version six and a ranked suspect object" {
  scratch(|| {
    program(red());
    let r = on_disk(["test", "--json"]);
    assert(r.code == 1, Some(said(r)));
    let v = json_of(r);
    assert(int(at(v, "schema_version")) == 6, Some(shown(v)));
    let f = nth(at(v, "failures"), 0);
    assert(str(at(f, "key")) == "m.balance never goes negative", Some(shown(f)));
    assert(str(at(f, "name")) == "balance never goes negative", Some(shown(f)));
    assert(str(at(f, "module")) == "m", Some(shown(f)));
    assert(str(at(f, "status")) == "failed", Some(shown(f)));
    assert(at(f, "nondet") == json::Bool(false), Some(shown(f)));
    assert(string_len(str(at(f, "test_hash"))) == 64, Some(shown(f)));
    assert(str(path(f, ["location", "file"])) == "m.ply", Some(shown(f)));
    assert(int(path(f, ["location", "line"])) == 5, Some(shown(f)));
    assert(is_number(path(f, ["location", "end_column"])), Some(shown(f)));
    assert(str(path(f, ["diagnostic", "code"])) == "E0501", Some(shown(f)));
    assert(match path(f, ["culprit", "verdict"]) { Str(_) -> true, _ -> false }, Some(shown(f)));
    assert(
      match path(f, ["culprit", "definitions"]) { Array(_) -> true, _ -> false },
      Some(shown(f)),
    );
    assert(int(path(f, ["culprit", "search", "evaluated"])) == 0, Some(shown(f)));
    let suspect = nth(at(f, "suspects"), 0);
    assert(str(at(suspect, "name")) == "m.balance", Some(shown(f)));
    assert(at(suspect, "culprit") == json::Bool(false), Some(shown(f)));
    assert(string_len(str(at(suspect, "hash"))) == 64, Some(shown(f)));
    assert(at(suspect, "change") == Null, Some("nothing compared the two eras: " ++ shown(f)));
    assert(path(f, ["footprint", "declared"]) == Array([]), Some(shown(f)));
    assert(at(f, "defect") == json::Bool(false), Some(shown(f)));
    // The run searched nothing, so there is no interleaving to replay and no race to name.
    assert(at(f, "replay") == Null, Some(shown(f)));
    assert(at(f, "race") == Null, Some(shown(f)))
  })
}

test "a test that has never passed says why it has no culprit" {
  scratch(|| {
    program(red());
    let r = on_disk(["test"]);
    assert(r.code == 1, Some(said(r)));
    let text = stdout(r);
    assert(string_contains(text, "balance never goes negative"), Some(text));
    assert(string_contains(text, "assertion failed"), Some(text));
    assert(string_contains(text, "no culprit: this test has never passed"), Some(text));
    assert(
      !string_contains(text, "culprit: m."),
      Some("nothing was bisected, so no definition may be named:\n" ++ text),
    );
    assert(string_contains(text, "suspects: m.balance"), Some(text))
  })
}

test "two runs over one failure emit the same artifact" {
  scratch(|| {
    program(red());
    assert(shown(at(tested([]), "failures")) == shown(at(tested([]), "failures")), None)
  })
}

test "a module with no tests is a clean run that says so" {
  scratch(|| {
    program("fn f() -> Int = 1\n");
    let r = on_disk(["test"]);
    assert(r.code == 0, Some(said(r)));
    assert(string_contains(stdout(r), "selected 0 of 0 (0 cached)"), Some(stdout(r)));
    assert(string_contains(stdout(r), "no `test` items"), Some(stdout(r)))
  })
}

test "a nondet test in a det test is a compile error" {
  let r = in_memory(
    one(
      "nondet effect wall {\n  read now() -> Int\n}\ntest \"reads the clock\" { assert(wall.now() > 0) }\n",
    ),
    ["test", "--json"],
  );
  assert(r.code == 2, Some(said(r)));
  assert(code_of(json_of(r)) == "E0412", Some(said(r)))
}

// What a test performed is counted, so a measurement can price the operations a suite makes.
test "each result counts the operations its test performed" {
  scratch(|| {
    program(
      \\effect counter {
      \\  read tick[c]() -> Int
      \\}
      \\
      \\fn twice() -> Int / {counter.read[c]} = counter.tick[c]() + counter.tick[c]()
      \\
      \\test "ticks" { assert_eq(handle { twice() } with { counter.tick[c]() -> 1 }, 2) }
      \\
      \\test "pure" { assert_eq(1 + 1, 2) }
      \\
    );
    let v = tested(["--no-cache"]);
    let performs = |name: String|
      match at(result_of(v, name), "performs") {
        Number(d) -> match int_of_decimal(d, Down) { Some(n) -> n, None -> -1 },
        _ -> panic("`" ++ name ++ "` carries no count: " ++ shown(v)),
      };
    assert(performs("pure") == 0, Some(shown(v)));
    assert(performs("ticks") == 2, Some(shown(v)))
  })
}

// --- Filters and workers ------------------------------------------------------

test "filter narrows both the run and the denominator" {
  scratch(|| {
    program(green());
    let r = on_disk(["test", "--filter", "zero"]);
    assert(r.code == 0, Some(said(r)));
    let text = stdout(r);
    assert(string_contains(text, "selected 1 of 1 (0 cached)"), Some(text));
    assert(string_contains(text, "--filter hid 1 test"), Some(text));
    assert(string_contains(text, "double of zero is zero"), Some(text));
    assert(
      !string_contains(text, "double doubles"),
      Some("the filtered-out test still ran:\n" ++ text),
    )
  })
}

test "a filter matching nothing says so rather than claiming success quietly" {
  scratch(|| {
    program(green());
    let r = on_disk(["test", "--filter", "nonexistent"]);
    assert(r.code == 0, Some(said(r)));
    assert(string_contains(stdout(r), "selected 0 of 0"), Some(stdout(r)));
    assert(
      string_contains(stdout(r), "no test key contains a `--filter` substring"),
      Some(stdout(r)),
    )
  })
}

test "jobs is honoured and reported" {
  scratch(|| {
    program(green());
    let r = on_disk(["test", "--jobs", "1"]);
    assert(r.code == 0, Some(said(r)));
    assert(string_contains(stdout(r), "1 worker"), Some(stdout(r)));
    program(green());
    let v = tested(["-j", "3"]);
    assert(int(at(v, "workers")) == 3, Some(shown(v)))
  })
}

// --- Scheduling ---------------------------------------------------------------

test "explain reports a reason per test and a footprint per group" {
  scratch(|| {
    program(green());
    assert(on_disk(["test"]).code == 0, None);
    let text = stdout(on_disk(["test", "--explain"]));
    assert(string_contains(text, "skip"), Some("cached tests must be shown as skipped:\n" ++ text));
    assert(string_contains(text, "cached"), Some(text));
    assert(string_contains(text, "this exact hash already passed"), Some(text));
    assert(
      string_contains(text, "concurrency groups") || string_contains(text, "selected 0 of 2"),
      Some(text),
    );
    program(green());
    let cold = stdout(on_disk(["test", "--explain"]));
    assert(string_contains(cold, "run "), Some(cold));
    assert(string_contains(cold, "concurrency groups"), Some(cold));
    assert(string_contains(cold, "group 0 ·"), Some(cold));
    assert(
      string_contains(cold, "· {}"),
      Some("the group's defining footprint is missing:\n" ++ cold),
    );
    assert(string_contains(cold, "isolation: region"), Some(cold));
    assert(string_contains(cold, "region-isolated and free"), Some(cold))
  })
}

// The `cell` atoms reach the footprint only through a written row: nothing carries a cell out of its
// region.
test "explain separates a region label contention from a real one" {
  scratch(|| {
    program(
      \\fn touches(n: Int) -> Int / {cell.read[table], cell.write[table]} = n
      \\test "a" {
      \\  let seen = with_cell[table](1) { c -> { cell_set(c, 2); cell_get(c) } };
      \\  assert_eq(touches(seen), 2)
      \\}
      \\test "b" {
      \\  let seen = with_cell[table](3) { c -> { cell_set(c, 4); cell_get(c) } };
      \\  assert_eq(touches(seen), 4)
      \\}
      \\test "pure" { assert_eq(1, 1) }
      \\
    );
    let text = stdout(on_disk(["test", "--explain"]));
    assert(
      string_contains(
        text,
        "isolation: shared {cell.read[table], cell.write[table]} (region labels)",
      ),
      Some("a label contention must say it is one:\n" ++ text),
    );
    assert(string_contains(text, "isolation: region"), Some(text));
    assert(
      string_contains(text, "1 of 3 region-isolated and free"),
      Some("two writers of one label are not isolated any more:\n" ++ text),
    );
    assert(
      string_contains(text, "2 of them only over a region label"),
      Some("the cost of losing the fork is a number on every run:\n" ++ text),
    );
    assert(
      string_contains(text, "group 1 ·"),
      Some("two writers of one label may not share a group:\n" ++ text),
    );
    let v = tested([]);
    assert(int(path(v, ["selection", "parallelism", "region_contended"])) == 2, Some(shown(v)));
    assert(int(path(v, ["selection", "parallelism", "isolated"])) == 1, Some(shown(v)))
  })
}

test "a run reports how many tests cannot disturb another" {
  scratch(|| {
    program(green());
    let text = stdout(on_disk(["test"]));
    assert(string_contains(text, "isolated 2 of 2"), Some(text));
    // The writing test cannot pass, but the schedule is still about it, which is what is asserted.
    program(
      \\effect db {
      \\  write put[t](v: Int) -> Unit
      \\}
      \\fn store(v: Int) -> Int / {db.write[users]} = { db.put[users](v); v }
      \\test "writes" { assert_eq(store(1), 1) }
      \\test "pure" { assert_eq(1, 1) }
      \\
    );
    let v = tested([]);
    assert(int(path(v, ["selection", "isolated"])) == 1, Some(shown(v)));
    assert(int(path(v, ["selection", "parallelism", "total"])) == 2, Some(shown(v)));
    assert(int(path(v, ["selection", "parallelism", "shared"])) == 1, Some(shown(v)));
    let writes = selected_test(v, "writes");
    assert(str(at(writes, "isolation")) == "shared", Some(shown(writes)));
    assert(str(nth(at(writes, "shared_atoms"), 0)) == "m.db.write[users]", Some(shown(writes)));
    let pure = selected_test(v, "pure");
    assert(str(at(pure, "isolation")) == "region", Some(shown(pure)));
    assert(items(at(pure, "shared_atoms")) == [], Some(shown(pure)))
  })
}

// --- The binding --------------------------------------------------------------

test "test is hermetic without the flag and says which binding it used" {
  scratch(|| {
    program(green());
    let v = tested([]);
    assert(str(at(v, "binding")) == "hermetic", Some(shown(v)));
    assert(int(path(v, ["hosts", "operations"])) == 0, Some(shown(v)));
    assert(string_starts_with(str(path(v, ["hosts", "digest"])), "b3:"), Some(shown(v)));
    // Nothing is bound, so no test can reach a host handler.
    assert(int(path(v, ["selection", "host"])) == 0, Some(shown(v)));
    fold(items(path(v, ["selection", "tests"])), (), |u: Unit, t: Json| {
      assert(at(t, "host") == json::Bool(false), Some(shown(t)));
      assert(str(at(t, "isolation")) != "host", Some(shown(t)))
    })
  })
}

test/nondet "--host changes the binding a run reports" {
  program(green());
  let v = tested(["--host"]);
  assert(truth(at(v, "ok")), Some(shown(v)));
  assert(str(at(v, "binding")) == "host", Some(shown(v)));
  let s = at(v, "selection");
  assert(
    int(at(s, "isolated")) + int(at(s, "shared")) + int(at(s, "host")) == int(at(s, "total")),
    Some("the three buckets have to partition the corpus: " ++ shown(s)),
  )
}

test/nondet "a host run says so in the summary a person reads" {
  program(green());
  let bound = on_disk(["test", "--host"]);
  assert(bound.code == 0, Some(said(bound)));
  assert(string_contains(stdout(bound), "not cached"), Some(stdout(bound)));
  assert(string_contains(stdout(bound), "binding host"), Some(stdout(bound)));
  // And silent when nothing was asked for.
  let hermetic = stdout(on_disk(["test"]));
  assert(!string_contains(hermetic, "binding host"), Some(hermetic))
}

test/nondet "explain never reports more isolation under --host than without it" {
  program(green());
  let counts = |extra: List<String>| {
    let v = tested(concat(["--explain", "--no-cache"], extra));
    { isolated: int(path(v, ["selection", "isolated"])), host: int(path(v, ["selection", "host"])) }
  };
  let hermetic = counts([]);
  let bound = counts(["--host"]);
  assert(
    bound.isolated + bound.host <= hermetic.isolated + bound.host
      && bound.isolated <= hermetic.isolated,
    Some(
      "isolated grew under --host: " ++ int_to_string(hermetic.isolated) ++ " -> "
        ++ int_to_string(bound.isolated),
    ),
  )
}

// If a binding moved a hash, a row or an E0412 verdict, every cache would split on a flag.
test/nondet "a binding changes nothing the front end computes" {
  program(green());
  assert(stdout(on_disk(["hash", "--json"])) == stdout(on_disk(["hash", "--json"])), None);
  let hermetic = tested(["--no-cache"]);
  let bound = tested(["--no-cache", "--host"]);
  let hashes = |v: Json| map(items(path(v, ["selection", "tests"])), |t: Json| at(t, "hash"));
  assert(hashes(hermetic) == hashes(bound), None);
  assert(path(hermetic, ["selection", "total"]) == path(bound, ["selection", "total"]), None)
}

// A test is no process: it may start and drive the programs `--exec` names, and nothing else of
// `process`.
test/nondet "a test run binds what --exec names and withholds the rest of process" {
  program(
    \\import std.process (process, Discard, Keep)
    \\
    \\fn echoed() -> Bytes / {process.spawn[echo]} = process.spawn[echo](["hi"], "", []).out
    \\
    \\fn started() -> Option<Bytes> / {process.start[echo], process.wait[echo]} =
    \\  match process.start[echo](["hi"], "", [], { input: false, out: Keep, err: Discard }) {
    \\    Err(_) -> None,
    \\    Ok(child) -> match process.wait[echo](child, 0 - 1) { Some(f) -> Some(f.out), None -> None },
    \\  }
    \\
    \\fn said() -> Unit / {process.out[proc]} = process.out[proc]("hi")
    \\
    \\test/nondet "spawns echo" { assert_eq(echoed(), b"hi\n") }
    \\
    \\test/nondet "starts echo and waits for it" { assert_eq(started(), Some(b"hi\n")) }
    \\
    \\test/nondet "writes a line" { said() }
    \\
  );
  let v = tested(["--host", "--exec", "echo=/bin/echo"]);
  assert(status_of(v, "spawns echo") == "passed", Some(shown(v)));
  assert(status_of(v, "starts echo and waits for it") == "passed", Some(shown(v)));
  assert(status_of(v, "writes a line") == "failed", Some(shown(v)));
  assert(str(path(nth(at(v, "failures"), 0), ["diagnostic", "code"])) == "E0424", Some(shown(v)));
  // Without `--exec`, the label is unbound, and the refusal says how to bind it.
  let bare = stdout(on_disk(["test", "--host", "--filter", "spawns"]));
  assert(string_contains(bare, "no executable is bound to it"), Some(bare));
  assert(string_contains(bare, "--exec echo="), Some(bare))
}

// A test asks which labels its run bound, and an unbound one is answered rather than withheld.
test/nondet "a test asks which labels its run bound" {
  program(
    \\import std.process (process)
    \\
    \\fn echo_bound() -> Bool / {process.bound[echo]} = process.bound[echo]()
    \\
    \\fn cc_bound() -> Bool / {process.bound[cc]} = process.bound[cc]()
    \\
    \\test/nondet "echo is bound" { assert(echo_bound()) }
    \\
    \\test/nondet "cc is not bound" { assert(!cc_bound()) }
    \\
  );
  let granted = tested(["--host", "--exec", "echo=/bin/echo"]);
  assert(status_of(granted, "echo is bound") == "passed", Some(shown(granted)));
  assert(status_of(granted, "cc is not bound") == "passed", Some(shown(granted)));
  let bare = tested(["--host", "--no-cache"]);
  assert(status_of(bare, "echo is bound") == "failed", Some(shown(bare)));
  assert(status_of(bare, "cc is not bound") == "passed", Some(shown(bare)));
  assert(
    str(path(nth(at(bare, "failures"), 0), ["diagnostic", "code"])) != "E0424",
    Some(shown(bare)),
  )
}

test/nondet "a family the program does not declare is refused to a test run" {
  program(green());
  let r = on_disk(["test", "--json", "--host", "--allow", "machine"]);
  assert(r.code == 2, Some(said(r)));
  assert(code_of(json_of(r)) == "E0459", Some(said(r)))
}

// --- The search ---------------------------------------------------------------

// Ten simulated minutes cost a run no wall clock worth the name: a wait would take them all.
test "a simulated sleep is a jump rather than a wait" {
  scratch(|| {
    program(
      \\fn nap() -> Instant / {clock.write, clock.read} = {
      \\  clock.sleep(Duration(600_000_000_000));
      \\  clock.now()
      \\}
      \\
      \\test "ten simulated minutes cost no wall clock" {
      \\  simulate { assert_eq(nap(), Instant(600_000_000_000)) }
      \\}
      \\
    );
    let started = time.elapsed_ms();
    let r = on_disk(["test", "--no-cache"]);
    let took = time.elapsed_ms() - started;
    assert(r.code == 0, Some(said(r)));
    assert(
      took < 120000,
      Some("ten simulated minutes took " ++ int_to_string(took) ++ "ms of wall clock"),
    )
  })
}

test "the search plan is published so two runs can be compared" {
  scratch(|| {
    program(green());
    let sim = path(tested([]), ["options", "sim"]);
    assert(str(at(sim, "mode")) == "dpor", Some(shown(sim)));
    assert(int(at(sim, "seeds")) == 1, Some(shown(sim)));
    assert(at(sim, "seed") == Null, Some(shown(sim)));
    assert(at(sim, "measure_reduction") == json::Bool(false), Some(shown(sim)));
    assert(is_number(at(sim, "budget")), Some(shown(sim)));
    assert(is_number(at(sim, "steps")), Some(shown(sim)));
    let random = path(tested(["--sim", "random", "--seeds", "8"]), ["options", "sim"]);
    assert(str(at(random, "mode")) == "random", Some(shown(random)));
    assert(int(at(random, "seeds")) == 8, Some(shown(random)));
    assert(int(at(random, "budget")) == 1, Some(shown(random)))
  })
}

// The parent reads what each task wrote only after joining it: the join orders each read after its
// write, and only the steps' clocks tell the search so.
fn joined() -> String =
  \\effect tally {
  \\  write bump[r](by: Int) -> Unit
  \\}
  \\
  \\fn fill_left() -> Int / {tally.bump[left], task.yield} = {
  \\  tally.bump[left](1);
  \\  task.yield();
  \\  tally.bump[left](2);
  \\  3
  \\}
  \\
  \\fn fill_right() -> Int / {tally.bump[right], task.yield} = {
  \\  tally.bump[right](4);
  \\  task.yield();
  \\  tally.bump[right](5);
  \\  9
  \\}
  \\
  \\test "what the joined tasks wrote is read after the joins" {
  \\  with_cell[left](0) { l ->
  \\    with_cell[right](0) { r ->
  \\      handle {
  \\        simulate {
  \\          let a = task.spawn(|| fill_left());
  \\          let b = task.spawn(|| fill_right());
  \\          assert_eq(task.join(a) + task.join(b), 12);
  \\          assert_eq(cell_get(l), 3);
  \\          assert_eq(cell_get(r), 9)
  \\        }
  \\      } with {
  \\        tally.bump[left](n) -> cell_set(l, cell_get(l) + n),
  \\        tally.bump[right](n) -> cell_set(r, cell_get(r) + n),
  \\      }
  \\    }
  \\  }
  \\}
  \\

test "a measured reduction reports a clock-blind search that ran no fewer than the pruned one" {
  scratch(|| {
    program(joined());
    let v = tested(["--no-cache", "--measure-reduction"]);
    assert(int(path(v, ["summary", "passed"])) == 1, Some(shown(v)));
    let search = at(nth(at(v, "results"), 0), "simulation");
    let pruned = int(at(search, "explored"));
    assert(pruned >= 0, Some("a pruned count: " ++ shown(v)));
    assert(path(search, ["blind", "bounded"]) == json::Bool(false), Some(shown(v)));
    let blind = int(path(search, ["blind", "explored"]));
    assert(
      blind >= pruned,
      Some(
        int_to_string(blind) ++ " interleavings without the clocks against "
          ++ int_to_string(pruned)
          ++ " with them: "
          ++ shown(v),
      ),
    );
    assert(int(path(search, ["naive", "explored"])) >= 0, Some(shown(v)));
    let text = stdout(on_disk(["test", "--no-cache", "--measure-reduction"]));
    assert(string_contains(text, " · blind " ++ int_to_string(blind) ++ " · naive "), Some(text));
    let unmeasured = at(nth(at(tested(["--no-cache"]), "results"), 0), "simulation");
    assert(
      at(unmeasured, "blind") == Null && at(unmeasured, "naive") == Null,
      Some(shown(unmeasured)),
    )
  })
}

// A `random` search files a pass under each root it ran as well as under the whole plan, so a
// narrower plan whose every root already passed on its own is answered without searching again.
fn one_spawn() -> String =
  \\test "a sleeper costs no wall clock" {
  \\  simulate {
  \\    let t = task.spawn(|| { clock.sleep(Duration(30000000000)); clock.now() });
  \\    assert_eq(task.join(t), Instant(30000000000))
  \\  }
  \\}
  \\

test "a seeded test whose every root passed alone is cached under a narrower plan" {
  scratch(|| {
    program(one_spawn());
    let wide = tested(["--sim", "random", "--seeds", "8"]);
    assert(int(path(wide, ["summary", "passed"])) == 1, Some(shown(wide)));
    assert(
      int(path(wide, ["simulation", "simulated"])) == 1,
      Some("the test searched: " ++ shown(wide)),
    );
    let narrow = tested(["--sim", "random", "--seeds", "4"]);
    assert(int(path(narrow, ["selection", "selected"])) == 0, Some(shown(narrow)));
    assert(
      str(at(nth(path(narrow, ["selection", "tests"]), 0), "reason")) == "cached",
      Some(shown(narrow)),
    );
    assert(
      int(path(narrow, ["simulation", "simulated"])) == 0,
      Some("no root was searched again: " ++ shown(narrow)),
    )
  })
}

// A measurement asks for one root's trial by naming it: the roots searched are the ones named, and
// each passes on its own, so a narrower range inside it is answered without searching again.
test "a root range searches exactly those seeds" {
  scratch(|| {
    program(one_spawn());
    let v = tested(["--sim", "random", "--sim-roots", "5..7"]);
    assert(int(path(v, ["summary", "passed"])) == 1, Some(shown(v)));
    assert(map(items(path(v, ["options", "sim", "roots"])), int) == [5, 6], Some(shown(v)));
    assert(int(path(v, ["options", "sim", "seeds"])) == 2, Some(shown(v)));
    let one = tested(["--sim", "random", "--sim-roots", "6..7"]);
    assert(
      str(at(nth(path(one, ["selection", "tests"]), 0), "reason")) == "cached",
      Some(shown(one)),
    );
    assert(int(path(one, ["simulation", "simulated"])) == 0, Some(shown(one)));
    assert(on_disk(["test", "--sim-roots", "7..5"]).code == 2, None)
  })
}

test "a replay names one interleaving and says so" {
  scratch(|| {
    program(green());
    let r = on_disk(["test", "--json", "--seed", "7:3.0.2"]);
    assert(r.code == 0, Some(said(r)));
    let sim = path(json_of(r), ["options", "sim"]);
    assert(str(at(sim, "mode")) == "once", Some(shown(sim)));
    assert(str(at(sim, "seed")) == "7:3.0.2", Some(shown(sim)));
    assert(int(at(sim, "seeds")) == 1, Some(shown(sim)))
  })
}

// A seed that parses loosely replays something other than what failed.
test "a seed that is not a seed is refused before anything runs" {
  fold(["7:", "seven", "7.3", "0x", "1_000"], (), |u: Unit, bad: String| {
    let r = in_memory(one(green()), ["test", "--seed", bad]);
    assert(r.code == 2, Some("`" ++ bad ++ "` should not parse"));
    assert(string_contains(stderr(r), "is not a seed"), Some(stderr(r)))
  })
}

test "a flag with nothing to mean is refused" {
  // `--seed` names one interleaving, so nothing may widen the search beside it.
  fold(
    [["--sim", "dpor"], ["--seeds", "4"], ["--sim-budget", "4"]],
    (),
    |u: Unit, widening: List<String>| {
      let argv = concat(["test", "--seed", "7"], widening);
      assert(
        in_memory(one(green()), argv).code == 2,
        Some(string::join(argv, " ") ++ " should conflict"),
      )
    },
  );
  // `random` is one interleaving per seed, so it has no budget to spend.
  let r = in_memory(one(green()), ["test", "--sim", "random", "--sim-budget", "4"]);
  assert(r.code == 2, Some(said(r)));
  assert(string_contains(stderr(r), "--sim-budget"), Some(stderr(r)))
}

// Every field of the plan is in a seeded test's cache key, so changing one has to be visible.
test "widening the search does not disturb a corpus that never simulates" {
  scratch(|| {
    program(green());
    assert(int(path(tested([]), ["summary", "passed"])) == 2, None);
    let v = tested(["--sim-budget", "1024"]);
    assert(
      int(path(v, ["selection", "selected"])) == 0,
      Some("nothing here reads a seed: " ++ shown(v)),
    );
    assert(int(path(v, ["options", "sim", "budget"])) == 1024, Some(shown(v)));
    assert(int(path(v, ["simulation", "simulated"])) == 0, Some(shown(v)));
    assert(int(path(v, ["simulation", "interleavings"])) == 0, Some(shown(v)))
  })
}
