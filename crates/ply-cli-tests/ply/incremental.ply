//! The front-end cache on the path every command takes: a load reads what the last one filed before
//! it analyses, and files what it answered after. A warm check answers what a cold one does; that a
//! seeded analysis is sound through every kind of edit is the compiler's own property, and
//! `crates/ply-compiler/ply/front.ply` tests it over sessions of edits.

import compiler.load
import harness (scratch, Ran, Server, Source, example_files, project, write, read, working,
                loads_here, on_disk, serving, ended, finished, said, stderr, warm_agrees, seeding,
                seeding_at, json_of, at, path, items, first, str, int, truth, shown, in_memory,
                tree, sources_here, comparable, about_the_cache, reused_dir, Here, Reached, Shipped,
                codes, inspected, manifest)
import cli.machine (machine)
import std.bytes (hex_of)
import std.fs (fs)
import std.json (Json)
import std.string
import std.list (contains)

fn edit(name: String, from: String, to: String) -> Unit / {Here, abort.raise} =
  match read(name) {
    None -> panic("`" ++ name ++ "` reads"),
    Some(text) -> {
      assert(
        string_contains(text, from),
        Some("`" ++ from ++ "` is not in " ++ name ++ "; the fixture drifted"),
      );
      write(name, string::replace(text, from, to))
    },
  }

fn removed(name: String) -> Unit / {fs.remove[cwd], abort.raise} =
  assert(fs.remove[cwd](name), Some("`" ++ name ++ "` is removed"))

fn core() -> String =
  \\pub type Money = Int
  \\
  \\pub type Item =
  \\  | Book(String, Money)
  \\  | Note(String)
  \\
  \\pub effect db {
  \\  read  get[r](key: Int) -> Int
  \\  write put[r](key: Int, value: Int) -> Int
  \\}
  \\
  \\pub fn price(i: Item) -> Money =
  \\  match i {
  \\    Book(_, p) -> p,
  \\    Note(_) -> 0,
  \\  }
  \\
  \\pub fn twice<a>(x: a, f: (a) -> a) -> a = f(f(x))
  \\
  \\pub fn label(i: Item) -> String =
  \\  match i {
  \\    Book(t, _) -> t,
  \\    Note(t) -> t,
  \\  }
  \\
  \\test "a note is free" {
  \\  assert_eq(price(Note("n")), 0)
  \\}
  \\

fn shop() -> String =
  \\import core
  \\
  \\fn total(items: List<core::Item>) -> Int =
  \\  fold(items, 0, |acc, i: core::Item| acc + core::price(i))
  \\
  \\fn doubled(n: Int) -> Int = core::twice(n, |x: Int| x + x)
  \\
  \\fn stored(k: Int) -> Int / {core::db.read[cart]} = core::db.get[cart](k)
  \\
  \\test "a shelf adds up" {
  \\  assert_eq(total([core::Book("b", 3), core::Note("n")]), 3)
  \\}
  \\

fn leaf() -> String = "pub fn one() -> Int = 1\npub fn two() -> Int = one() + one()\n"

fn corpus() -> Unit / {Here, abort.raise} =
  project([
    { path: "core.ply", text: core() },
    { path: "shop.ply", text: shop() },
    { path: "leaf.ply", text: leaf() },
  ])

// Nothing in the corpus imports a shipped module, so every definition is the project's own.
test "a second check is seeded whole and an edit checks only what it moved" {
  scratch(|| {
    corpus();
    let cold = seeding();
    assert(cold.seeded == 0, Some("a cold cache seeds nothing"));
    let all = cold.checked;
    assert(all > 0, None);
    let warm = seeding();
    assert(
      warm.seeded == all && warm.checked == 0,
      Some("a warm check takes every definition from its filed rows"),
    );
    // Nothing references `two`, so its own hash is the only one the edit moves.
    edit("leaf.ply", "one() + one()", "one() + one() + 0");
    let edited = seeding();
    assert(
      edited.seeded == all - 1 && edited.checked == 1,
      Some("the edited definition is checked and every other one is seeded"),
    );
    let _ = warm_agrees("after the edit");
    ()
  })
}

// A module whose text stands keeps its tests as hashing fixed them, so an edit hashes the tests of
// the module it moved and no other.
test "an edit hashes only the tests of the module it moved" {
  scratch(|| {
    corpus();
    let cold = seeding();
    assert(cold.held == 0 && cold.hashed == 2, Some("a cold cache hashes every test"));
    let warm = seeding();
    assert(warm.held == 2 && warm.hashed == 0, Some("a warm check holds every test"));
    edit("shop.ply", "acc + core::price(i)", "core::price(i) + acc");
    let edited = seeding();
    assert(
      edited.held == 1 && edited.hashed == 1,
      Some("the moved module's test is hashed and the standing one's is held"),
    );
    let _ = warm_agrees("after the edit");
    ()
  })
}

/// `spin` and `hop` call each other without descending, and `wait` calls into them.
fn looping(above: String, between: String) -> String =
  above ++ "fn spin(n: Int) -> Int / {diverges} = hop(n + 1)\n" ++ between
    ++ "fn hop(n: Int) -> Int / {diverges} = spin(n)\n\npub fn wait(n: Int) -> Int / {diverges} = spin(n)\n"

test "a seeded definition that may not return says where its call is now" {
  scratch(|| {
    project([{ path: "m.ply", text: looping("", "") }]);
    let _ = seeding();
    write("m.ply", looping("pub fn aside() -> Int = 3\n\n", "\npub fn apart() -> Int = 4\n\n"));
    let moved = seeding();
    assert(moved.seeded == 3 && moved.checked == 2, Some("the moved definitions are seeded"));
    let _ = warm_agrees("after the definitions moved");
    ()
  })
}

fn stubbed() -> List<String> / {Reached, Shipped, abort.raise, diverges} =
  map(
    items(path(json_of(on_disk(["check", "--json", "--explain"])), ["front_end", "stubbed"])),
    str,
  )

// `shop` is warned of two definitions nothing uses, which a stub of it has no body to show.
test "a check reads a module that did not move as its stub, and warns of it what its source earned" {
  scratch(|| {
    corpus();
    let cold = warm_agrees("cold");
    assert(
      len(filter(items(at(cold, "diagnostics")), |d: Json| str(at(d, "code")) == "W0611")) == 2,
      Some(shown(cold)),
    );
    assert_eq(stubbed(), ["core", "leaf", "shop"]);
    edit("leaf.ply", "one() + one()", "one() + one() + 0");
    assert_eq(stubbed(), ["core", "shop"]);
    let _ = warm_agrees("after an edit nothing reaches");
    // `shop` imports `core`, so it is read from its source with it.
    edit("core.ply", "Note(_) -> 0", "Note(_) -> 0 + 0");
    assert_eq(stubbed(), ["leaf"]);
    let _ = warm_agrees("after an edit `shop` reaches");
    ()
  })
}

// No module's text says what it embeds, so a stub stands on that too.
test "a check sees that a file a module embeds is gone, though no module moved" {
  scratch(|| {
    project([
      { path: "words.ply", text: "pub fn words() -> Bytes = embed(\"words.txt\")\n" },
      {
        path: "count.ply",
        text: "import words\npub fn count() -> Int = bytes_len(words::words())\n",
      },
      { path: "words.txt", text: "one two\n" },
    ]);
    let _ = warm_agrees("cold");
    assert_eq(stubbed(), ["count", "words"]);
    removed("words.txt");
    assert_eq(stubbed(), []);
    let answer = warm_agrees("the embedded file is gone");
    assert(int(at(answer, "exit_code")) != 0, Some(shown(answer)))
  })
}

// A proof that a measure descends reads the bodies of what its module imports, and a stub has none.
test "a check that must show a measure reads the project's own modules from source" {
  scratch(|| {
    project([
      { path: "step.ply", text: "pub fn down(n: Int) -> Int = n - 1\n" },
      {
        path: "walk.ply",
        text: "import step\n\npub fn walk(n: Int) -> Int decreases n = if n <= 0 { 0 } else { walk(step::down(n)) }\n",
      },
    ]);
    let _ = warm_agrees("cold");
    assert_eq(stubbed(), ["step", "walk"]);
    edit("walk.ply", "{ 0 }", "{ 0 + 0 }");
    assert_eq(stubbed(), []);
    let answer = warm_agrees("after an edit to the definition that states the measure");
    assert(int(at(answer, "exit_code")) == 0, Some(shown(answer)))
  })
}

test "an unchanged check takes the answer its last one filed, and an edit checks again" {
  scratch(|| {
    corpus();
    let first = json_of(on_disk(["check", "--json"]));
    assert(!truth(path(first, ["front_end", "reused"])), Some(shown(first)));
    assert(truth(path(first, ["front_end", "filed"])), Some(shown(first)));
    let again = json_of(on_disk(["check", "--json"]));
    assert(truth(path(again, ["front_end", "reused"])), Some(shown(again)));
    assert_eq(comparable(again), comparable(first));
    edit("leaf.ply", "one() + one()", "one() + one() + 0");
    let edited = json_of(on_disk(["check", "--json"]));
    assert(!truth(path(edited, ["front_end", "reused"])), Some(shown(edited)))
  })
}

test "an unchanged listing takes the answer its last one kept, and an edit lists again" {
  scratch(|| {
    corpus();
    let first = json_of(on_disk(["defs", "--json"]));
    assert(!truth(path(first, ["front_end", "reused"])), Some(shown(first)));
    let again = json_of(on_disk(["defs", "--json"]));
    assert(truth(path(again, ["front_end", "reused"])), Some(shown(again)));
    assert_eq(shown(at(again, "definitions")), shown(at(first, "definitions")));
    edit("leaf.ply", "one() + one()", "one() + one() + 0");
    let edited = json_of(on_disk(["defs", "--json"]));
    assert(!truth(path(edited, ["front_end", "reused"])), Some(shown(edited)))
  })
}

test "a listing over a store the cache warned of is kept, and the next takes it back" {
  scratch(|| {
    corpus();
    let _ = on_disk(["check", "--explain"]);
    write(".ply-cache/store.idx", "not an index at all");
    let warned = json_of(on_disk(["defs", "--json"]));
    let again = json_of(on_disk(["defs", "--json"]));
    assert(truth(path(again, ["front_end", "reused"])), Some(shown(again)));
    assert_eq(shown(at(again, "definitions")), shown(at(warned, "definitions")))
  })
}

test "a check that cannot file its answer still answers, and says it filed nothing" {
  scratch(|| {
    corpus();
    write(reused_dir(), "a file where the directory would go");
    let unfiled = json_of(on_disk(["check", "--json"]));
    assert(truth(at(unfiled, "ok")), Some(shown(unfiled)));
    assert(!truth(path(unfiled, ["front_end", "filed"])), Some(shown(unfiled)));
    let again = json_of(on_disk(["check", "--json"]));
    assert(!truth(path(again, ["front_end", "reused"])), Some(shown(again)))
  })
}

test "a check the cache warned in files the program's own answer, which the next takes back" {
  scratch(|| {
    corpus();
    let _ = on_disk(["check", "--explain"]);
    write(".ply-cache/store.idx", "not an index at all");
    let about = |v: Json| filter(codes(v), |c: String| contains(about_the_cache(), c));
    let warned = json_of(on_disk(["check", "--json"]));
    assert(len(about(warned)) > 0, Some(shown(warned)));
    let again = json_of(on_disk(["check", "--json"]));
    assert(truth(path(again, ["front_end", "reused"])), Some(shown(again)));
    assert_eq(about(again), []);
    assert_eq(comparable(again), comparable(warned))
  })
}

fn held(body: String) -> String =
  "effect io { write close(n: Int) -> Unit }\n\npub fn aside() -> Int = 7\n\npub fn used(n: Int) -> Int / {io.close} = {\n  let got = with_hold[file](n, |x: Int| io.close(x)) { h -> "
    ++ body
    ++ " };\n  0\n}\n"

test "a warm check of an edited `with_hold` body refuses the escape a cold one refuses" {
  scratch(|| {
    project([{ path: "m.ply", text: held("hold_get(h) + 1") }]);
    let kept = warm_agrees("cold");
    assert(int(at(kept, "exit_code")) == 0, Some(shown(kept)));
    let _ = warm_agrees("warm");
    edit("m.ply", "hold_get(h) + 1", "{ let k = || hold_get(h); k() }");
    let inside = warm_agrees("after an edit that keeps the hold inside");
    assert(int(at(inside, "exit_code")) == 0, Some(shown(inside)));
    edit("m.ply", "{ let k = || hold_get(h); k() }", "|| hold_get(h)");
    let escaped = warm_agrees("after an edit that lets it out");
    assert_eq(codes(escaped), ["E0446"]);
    // The refusal is the edited definition's own: one beside it moving changes nothing of it.
    edit("m.ply", "pub fn aside() -> Int = 7", "pub fn aside() -> Int = 8");
    assert_eq(codes(warm_agrees("after an edit beside the escape")), ["E0446"])
  })
}

test "a project that imports `std.fs` and opens no file checks, cold and warm" {
  scratch(|| {
    project([
      {
        path: "m.ply",
        text: "import std.fs (fs)\n\npub fn size(p: String) -> Option<Int> / {fs.file_size[data]} = fs.file_size[data](p)\n",
      },
    ]);
    let cold = warm_agrees("cold");
    assert(int(at(cold, "exit_code")) == 0, Some(shown(cold)));
    let warm = warm_agrees("warm");
    assert(int(at(warm, "exit_code")) == 0, Some(shown(warm)))
  })
}

fn streaming() -> String =
  \\import std.fs
  \\import std.fs (fs)
  \\import std.io (io, reading, shut, fold_lines)
  \\
  \\pub fn count(path: String) -> Int / {fs.open[data], fs.read_chunk[data], fs.close[data], io.refused, io.too_long, io.closed, abort.raise} =
  \\  with_hold[file](reading[data](path), shut) { source ->
  \\    fold_lines(source, 65536, 1000000, 0, |n: Int, line: Bytes| n + 1) }
  \\
  \\test "a file's lines are counted over the twin" {
  \\  let tree = fs::mem_of([{ path: "a.txt", body: b"one\ntwo\nthree" }]);
  \\  assert_eq(fs::on_mem[data](tree, || count("a.txt")).value, 3)
  \\}
  \\

// The project names three of `std.io`'s functions, so its load is what those reach.
test "a project that streams a file through `std.io` checks and runs what it reaches, cold and warm" {
  scratch(|| {
    project([{ path: "m.ply", text: streaming() }]);
    let cold = warm_agrees("cold");
    assert(int(at(cold, "exit_code")) == 0, Some(shown(cold)));
    let ran = json_of(on_disk(["test", "--json"]));
    assert(
      int(path(ran, ["summary", "failed"])) == 0 && int(path(ran, ["summary", "passed"])) == 1,
      Some(shown(ran)),
    );
    edit("m.ply", "65536", "4096");
    let warm = warm_agrees("after an edit to the reader's chunk");
    assert(int(at(warm, "exit_code")) == 0, Some(shown(warm)));
    let again = json_of(on_disk(["test", "--json"]));
    assert(
      int(path(again, ["summary", "failed"])) == 0 && int(path(again, ["summary", "passed"])) == 1,
      Some(shown(again)),
    )
  })
}

test "a whole editing session agrees at every step" {
  scratch(|| {
    corpus();
    let _ = warm_agrees("step 0");
    let _ = warm_agrees("step 0, warm");
    edit("leaf.ply", "one() + one()", "one() + 1");
    let _ = warm_agrees("step 1: body");
    edit("core.ply", "pub fn label(", "pub fn title(");
    let _ = warm_agrees("step 2: rename");
    edit("core.ply", "Money", "Cost");
    let _ = warm_agrees("step 3: rename a type");
    write("extra.ply", "import leaf\npub fn four() -> Int = leaf::two() + 2\n");
    let _ = warm_agrees("step 4: add a file");
    edit("extra.ply", "leaf::two() + 2", "leaf::two() + 3");
    let _ = warm_agrees("step 5: edit the new file");
    removed("extra.ply");
    let _ = warm_agrees("step 6: delete it again");
    edit("core.ply", "effect db", "effect ledger");
    edit("shop.ply", "core::db.", "core::ledger.");
    let _ = warm_agrees("step 7: rename an effect");
    ()
  })
}

// `pick` names nothing of `Date`'s, so nothing but the type's own hash reaches the row it was filed
// under when the type was open.
test "a type made opaque refuses, warm, the module that built one while it was open" {
  scratch(|| {
    project([
      {
        path: "dates.ply",
        text: "pub type Date = new { day: Int }\n\npub fn first() -> Date = { day: 1 }\n\npub fn day(d: Date) -> Int = d.day\n",
      },
      {
        path: "app.ply",
        text: "import dates\n\nfn pick() -> Int = dates::day({ day: 2 })\n\nfn read() -> Int = dates::first().day\n\nfn main() -> Int = pick() + read()\n",
      },
    ]);
    let open = warm_agrees("open");
    assert_eq(codes(open), []);
    edit("dates.ply", "pub type Date", "pub opaque type Date");
    assert_eq(codes(warm_agrees("closed")), ["E0220"]);
    edit("dates.ply", "pub opaque type Date", "pub type Date");
    assert(warm_agrees("open again") == open, Some("an undone edit lands where it began"))
  })
}

/// Embedded, so a session over the corpus is cached until an example changes.
fn examples() -> Unit / {Here, abort.raise} =
  project(
    map(
      filter(example_files(), |f: { name: String, bytes: Bytes }| string_ends_with(f.name, ".ply")),
      |f: { name: String, bytes: Bytes }| { path: f.name, text: string_of_bytes(f.bytes) },
    ),
  )

fn is_word_byte(b: Int) -> Bool =
  (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95 || b >= 128

/// Renames every whole-identifier `from` in `name`, so which occurrences move is the program's
/// business and not its layout's.
fn rename(name: String, from: String, to: String) -> Unit / {Here, abort.raise} = {
  let text = match read(name) {
    Some(t) -> bytes_of_string(t),
    None -> panic("`" ++ name ++ "` reads"),
  };
  let needle = bytes_of_string(from);
  write(
    name,
    string_of_bytes(if bytes_len(needle) == 0 { text }
    else { renamed_from(text, needle, bytes_of_string(to), 0, 0, b"", bytes_len(text) + 1) }),
  )
}

/// `left` bounds the rounds: each moves on a byte at least.
fn renamed_from(
  text: Bytes,
  needle: Bytes,
  to: Bytes,
  from_at: Int,
  kept: Int,
  out: Bytes,
  left: Int,
) -> Bytes / {abort.raise} =
  if left <= 0 { panic("more rounds than bytes") } else {
    match bytes_index_of_from(text, needle, from_at) {
      None -> bytes_concat(out, bytes_slice(text, kept, bytes_len(text))),
      Some(at) -> {
        let end = at + bytes_len(needle);
        let before = at > 0 && is_word_byte(bytes_at(text, at - 1));
        let after = end < bytes_len(text) && is_word_byte(bytes_at(text, end));
        if before || after { renamed_from(text, needle, to, at + 1, kept, out, left - 1) } else {
          renamed_from(
            text,
            needle,
            to,
            end,
            end,
            bytes_concat_all([out, bytes_slice(text, kept, at), to]),
            left - 1,
          )
        }
      },
    }
  }

/// Whether a step's edit landed, asked of the checker rather than of the files: `module` declares
/// every name in `now` and none in `gone`, and the program still checks.
fn landed(
  answer: Json,
  step: String,
  module: String,
  now: List<String>,
  gone: List<String>,
) -> Unit / {abort.raise} = {
  let declared = match filter(items(at(answer, "modules")), |m: Json|
      str(at(m, "name")) == module) {
    [m, ..] -> map(items(at(m, "items")), str),
    [] -> panic(step ++ ": the answer has no module `" ++ module ++ "`"),
  };
  let has = |n: String| len(filter(declared, |d: String| d == n)) > 0;
  assert(
    truth(at(answer, "ok")) && len(filter(now, has)) == len(now) && len(filter(gone, has)) == 0,
    Some(
      step ++ ": `" ++ module ++ "` should declare " ++ string::join(now, ", ") ++ " and not "
        ++ string::join(gone, ", ")
        ++ " in a program that checks; it declares "
        ++ string::join(declared, ", ")
        ++ ", with diagnostics "
        ++ shown(at(answer, "diagnostics")),
    ),
  )
}

fn original(name: String) -> String / {Here, abort.raise} =
  match read(name) { Some(t) -> t, None -> panic(name ++ " reads") }

// One cache for every mutation: an invalidation is only ever wrong in some sequence of edits. Real
// code exercises handlers, regions, `nondet` effects and cross-module types the synthetic corpora
// do not, and a session ends by undoing its edits so a wrong answer shows up as a final state that
// is not the one it began in. Two sessions, each short enough to place beside the rest.
test "a session of edits to definitions over the example corpus agrees at every step" {
  scratch(|| {
    examples();
    let start = warm_agrees("step 0");
    let clock = original("clock.ply");
    let report = original("report.ply");
    let ledger = original("ledger.ply");

    write("clock.ply", clock ++ "\npub fn ticks() -> Int = 0\n");
    let s1 = "step 1: a definition appeared";
    landed(warm_agrees(s1), s1, "clock", ["clock.ticks"], []);

    write("report.ply", "// a note\n" ++ report);
    let _ = warm_agrees("step 2: a comment");

    rename("ledger.ply", "presented", "presented_value");
    rename("report.ply", "presented", "presented_value");
    let s3 = "step 3: a rename across modules";
    landed(warm_agrees(s3), s3, "ledger", ["ledger.presented_value"], ["ledger.presented"]);

    rename("report.ply", "Line", "Row");
    let s4 = "step 4: a type rename";
    landed(warm_agrees(s4), s4, "report", ["report.Row"], ["report.Line"]);

    write("clock.ply", clock);
    write("report.ply", report);
    write("ledger.ply", ledger);
    let end = warm_agrees("step 5: back to where it started");
    assert(start == end, Some("an undone session must land on the state it began in"))
  })
}

// Opens on a rename, so a module's coming and going is checked against a cache that has filed one.
test "a session of edits to modules over the example corpus agrees at every step" {
  scratch(|| {
    examples();
    let start = warm_agrees("step 0");
    let report = original("report.ply");
    let ledger = original("ledger.ply");

    rename("ledger.ply", "presented", "presented_value");
    rename("report.ply", "presented", "presented_value");
    let s1 = "step 1: a rename across modules";
    landed(warm_agrees(s1), s1, "ledger", ["ledger.presented_value"], ["ledger.presented"]);

    write("spare.ply", "pub fn spare() -> Int = 9\n");
    let _ = warm_agrees("step 2: a module appeared");

    assert(fs.rename[cwd]("spare.ply", "kept.ply"), Some("the module is renamed"));
    let _ = warm_agrees("step 3: it was renamed");

    removed("kept.ply");
    let _ = warm_agrees("step 4: and deleted");

    write("report.ply", report);
    write("ledger.ply", ledger);
    let end = warm_agrees("step 5: back to where it started");
    assert(start == end, Some("an undone session must land on the state it began in"))
  })
}

// A deleted import is an error however much of the program the cache still holds rows for.
test "deleting a file is reported rather than skipped past" {
  scratch(|| {
    corpus();
    write("extra.ply", "import leaf\npub fn three() -> Int = leaf::two()\n");
    let _ = warm_agrees("cold");
    removed("leaf.ply");
    let answer = warm_agrees("a dangling import");
    assert(int(at(answer, "exit_code")) == 2, Some(shown(answer)));
    assert(
      len(filter(items(at(answer, "diagnostics")), |d: Json| str(at(d, "code")) == "E0106")) > 0,
      Some(shown(answer)),
    )
  })
}

// Structurally identical definitions in two modules share a hash while their schemes name different
// types: each is filed under its own name, and each is seeded with its own row.
test "two definitions that share a hash each keep their own interface" {
  scratch(|| {
    let body = "pub type Thing = | Wrap(Int)\npub fn peel(t: Thing) -> Int = match t { Wrap(n) -> n }\n";
    project([{ path: "a.ply", text: body }, { path: "b.ply", text: body }]);
    let _ = warm_agrees("cold");
    let warm = warm_agrees("warm");
    let type_of = |name: String|
      match filter(items(at(warm, "definitions")), |d: Json| str(at(d, "name")) == name) {
        [d, ..] -> str(at(d, "type")),
        [] -> panic("`" ++ name ++ "` is in the answer"),
      };
    assert(
      type_of("a.peel") != type_of("b.peel"),
      Some("each definition's scheme must name its own module's type"),
    );
    let a = inspected("a.peel");
    let b = inspected("b.peel");
    assert(
      str(at(a, "hash")) == str(at(b, "hash")),
      Some(
        "the fixture is only interesting while the two hash alike: " ++ shown(a) ++ " " ++ shown(b),
      ),
    );
    // Each has a slot of its own under the shared hash, holding its own interface.
    assert(str(path(a, ["interface", "type"])) == "(a.Thing) -> Int", Some(shown(a)));
    assert(str(path(b, ["interface", "type"])) == "(b.Thing) -> Int", Some(shown(b)))
  })
}

test "a corrupt front-end cache degrades to a cold check and is repaired" {
  scratch(|| {
    corpus();
    let _ = warm_agrees("cold");
    write(".ply-cache/store.idx", "not an index at all");
    let r = on_disk(["check", "--json", "--explain"]);
    assert(r.code == 0, Some(said(r)));
    let answer = json_of(r);
    assert(
      len(
          filter(items(at(answer, "diagnostics")), |d: Json|
            string_starts_with(str(at(d, "code")), "W06")),
        )
        > 0,
      Some("a discarded cache is reported: " ++ shown(answer)),
    );
    assert(
      int(path(answer, ["front_end", "definitions", "seeded"])) == 0,
      Some("nothing is taken from a cache that did not read"),
    );
    let _ = warm_agrees("after the cache was rewritten");
    assert(seeding().checked == 0, Some("the run that met the damage filed a whole cache"))
  })
}

// Mangled in the payload rather than replaced: a valid header over undecodable entries is what a
// half-written append leaves.
test "a cache mangled mid-session degrades and recovers" {
  scratch(|| {
    corpus();
    let _ = warm_agrees("cold");
    edit("leaf.ply", "pub fn one() -> Int = 1", "pub fn one() -> Int = 2");
    let _ = warm_agrees("edited");
    let data = ".ply-cache/store.dat";
    let bytes = match fs.read_file[cwd](data) {
      Some(b) -> b,
      None -> panic("the data file reads"),
    };
    let mangled = bytes_concat_all(
      map(range(0, bytes_len(bytes)), |i: Int|
        byte_of_int(if i < 64 { bytes_at(bytes, i) } else { bytes_at(bytes, i) ^ 90 })),
    );
    assert(fs.write_file[cwd](data, mangled), Some("the data file is written"));
    let _ = warm_agrees("the cache was mangled");
    let _ = warm_agrees("and the run after that");
    ()
  })
}

// The shape a half-finished garbage collection would leave: an index whose data file is gone.
test "fingerprints without their interfaces are refused rather than believed" {
  scratch(|| {
    corpus();
    let _ = warm_agrees("cold");
    removed(".ply-cache/store.dat");
    let _ = warm_agrees("fingerprints with no interfaces behind them");
    let _ = warm_agrees("and the run after that");
    ()
  })
}

// Only a load of the whole project drops what the cache holds for files it did not read.
test "a single-file run does not spoil the whole project run after it" {
  scratch(|| {
    corpus();
    let _ = warm_agrees("cold");
    let r = on_disk(["check", "leaf.ply"]);
    assert(r.code == 0, Some(said(r)));
    let stats = json_of(on_disk(["cache", "stats", "--json"]));
    assert(
      int(path(stats, ["frontend", "sources"])) >= 3,
      Some("a single-file run must not have pruned the rest of the project: " ++ shown(stats)),
    );
    let _ = warm_agrees("whole project after a single-file run");
    ()
  })
}

// Two processes, so each files what it checked while the other may be reading.
test/nondet "two overlapping runs leave a cache that still agrees" {
  corpus();
  let one = serving(["check"], [], 0);
  let two = serving(["check", "."], [], 0);
  fold([one, two], (), |u: Unit, server: Server| {
    let r = finished(ended(server, 120000, "`ply check` never ended"));
    assert(r.code == 0, Some(said(r)))
  });
  let _ = warm_agrees("after two overlapping runs");
  edit("leaf.ply", "pub fn one() -> Int = 1", "pub fn one() -> Int = 3");
  let _ = warm_agrees("and an edit after them");
  ()
}

fn filed_nothing(what: String) -> Unit / {fs.exists[cwd], abort.raise} =
  assert(
    !fs.exists[cwd](".ply-cache/store.idx") && !fs.exists[cwd](".ply-cache/store.dat"),
    Some(what ++ " filed a front-end cache"),
  )

fn one_test() -> Unit / {Here, abort.raise} =
  project([
    { path: "m.ply", text: "pub fn main() -> Int = 1\ntest \"one\" { assert_eq(main(), 1) }\n" },
  ])

// What turns caching off files nothing: `ply build`, `ply hosts` and `--no-cache`.
test "a command that does not cache files nothing" {
  scratch(|| {
    one_test();
    let tested = on_disk(["test", "--no-cache"]);
    assert(tested.code == 0, Some(said(tested)));
    filed_nothing("`ply test --no-cache`");
    let hosts = on_disk(["hosts"]);
    assert(hosts.code == 0, Some(said(hosts)));
    filed_nothing("`ply hosts`");
    let built = on_disk(["build", ".", "--digest"]);
    assert(built.code == 0, Some(said(built)));
    filed_nothing("`ply build`")
  })
}

// Nor does a program's own load of a program, which runs the front end in the machine, as only the
// disk can be handed to.
test/nondet "a program's own load of a program files nothing" {
  one_test();
  // This test is a program, and loads one through the machine it is lent.
  assert(loads_here(), Some("the program loads"));
  machine.drop[run]();
  filed_nothing("a program's own load")
}

test/nondet "a run leaves the label it loaded through free" {
  project([{ path: "m.ply", text: "pub fn main() -> Unit = ()\n" }]);
  let ran = on_disk(["run"]);
  assert(ran.code == 0, Some(said(ran)));
  match load::load[cwd](".") {
    Err(_) -> panic("the program loads"),
    Ok(loaded) -> match machine.load[run](working(), loaded.front, loaded.unit) {
      Ok(_) -> (),
      Err(_) -> panic("the label was left holding the run's program"),
    },
  };
  machine.drop[run]()
}

fn lib_dep(at_path: String) -> String =
  "{name: \"lib\", prefix: None, min: {major: 0, minor: 0, patch: 1}, source: Path(\"" ++ at_path
    ++ "\")}"

// A dependency's module is filed under its package's identity, so moving the package keeps what was
// filed for it, and a changed dependency is checked again.
test "a dependency module is filed under its package and survives the package moving" {
  scratch(|| {
    project([
      { path: "app/ply.pkg", text: manifest("app", lib_dep("../lib")) },
      { path: "app/main.ply", text: "import lib.answer\nfn main() -> Int = answer::answer()\n" },
      { path: "lib/ply.pkg", text: manifest("lib", "") },
      { path: "lib/answer.ply", text: "pub fn answer() -> Int = 42\n" },
    ]);
    let r = on_disk(["check", "app"]);
    assert(r.code == 0, Some(stderr(r)));
    // The package is checked out somewhere else, and its manifest is unchanged: the rows filed for it
    // are the moved package's too.
    assert(fs.create_dir[cwd]("vendor"), None);
    assert(fs.rename[cwd]("lib", "vendor/lib"), Some("the package moves"));
    write("app/ply.pkg", manifest("app", lib_dep("../vendor/lib")));
    assert(seeding_at("app").checked == 0, Some("a moved package keeps the rows filed for it"));
    // A changed dependency is checked again where it changed; its caller reads its contract and
    // what it publishes, which the edit left alone.
    write("vendor/lib/answer.ply", "pub fn answer() -> Int = 40 + 2\n");
    assert(seeding_at("app").checked == 1, Some("the edit is checked, and nothing else"));
    // The number it answers is published, since a caller's measure may count by it.
    write("vendor/lib/answer.ply", "pub fn answer() -> Int = 43\n");
    assert(seeding_at("app").checked == 2, Some("the edit and its caller are checked"))
  })
}

// A warm `ply prove` answers every obligation from the cache, across modules that import one
// another.
test "a warm prove answers every obligation from the cache" {
  scratch(|| {
    project([
      {
        path: "base.ply",
        text:
          \\pub fn one() -> Int = 1
          \\
          \\pub fn bump(x: Int) -> Int
          \\  requires x < 100
          \\  ensures result > x
          \\= x + one()
          \\
      },
      {
        path: "app.ply",
        text:
          \\import base
          \\
          \\fn more(x: Int) -> Int
          \\  requires x < 50
          \\  ensures result > x
          \\= base::bump(x)
          \\
      },
      {
        path: "side.ply",
        text:
          \\fn zero(x: Int) -> Int
          \\  ensures result == 0
          \\= x - x
          \\
      },
    ]);
    let first_run = on_disk(["prove", "."]);
    assert(first_run.code == 0, Some(said(first_run)));
    let r = on_disk(["prove", ".", "--json"]);
    assert(r.code == 0, Some(said(r)));
    let v = json_of(r);
    assert(len(items(at(v, "obligations"))) == 3, Some(shown(v)));
    assert(
      int(at(v, "cached")) == 3,
      Some("every obligation is answered from the cache: " ++ shown(v)),
    )
  })
}

// A `reuse fn` is checked whole-program, so a warm check must refuse a broken promise as a cold one
// does.
test "a promise is known on every run and still refused" {
  scratch(|| {
    project([
      {
        path: "grow.ply",
        text: "reuse fn grow(xs: List<Int>, n: Int) -> List<Int> = {\n  let ys = push(xs, n);\n  if len(xs) < 0 { xs } else { ys }\n}\n",
      },
    ]);
    fold(["first", "second"], (), |u: Unit, run: String| {
      let answer = warm_agrees(run);
      assert(int(at(answer, "exit_code")) == 2, Some(run ++ ": " ++ shown(answer)));
      assert(
        len(filter(items(at(answer, "diagnostics")), |d: Json| str(at(d, "code")) == "E0127")) > 0,
        Some(run ++ ": " ++ shown(answer)),
      )
    })
  })
}

fn measured() -> String =
  \\import std.math (abs)
  \\
  \\pub fn distance(a: Int, b: Int) -> Int = abs(a - b)
  \\
  \\test "distance is symmetric" { assert_eq(distance(2, 5), distance(5, 2)) }
  \\

type Kept = { name: String, bytes: Bytes }

fn interfaces() -> String = ".ply-cache/interfaces"

/// The package of the shipped modules and the dependencies: what a check keeps of the project's own
/// modules lies beside it, named `.own`.
fn kept_package() -> Kept / {fs.list_dir[cwd], fs.read_file[cwd], abort.raise} =
  match fs.list_dir[cwd](interfaces()) {
    None -> panic("the store keeps no package"),
    Some(all) -> match filter(all, |n: String| !string_ends_with(n, ".own")) {
      [name] -> match fs.read_file[cwd](interfaces() ++ "/" ++ name) {
        Some(b) -> { name: name, bytes: b },
        None -> panic("`" ++ name ++ "` does not read"),
      },
      names -> panic("the store keeps one package, not " ++ int_to_string(len(names))),
    },
  }

test "a load through the compiled shipped modules answers what a load of its source does" {
  scratch(|| {
    project([{ path: "app.ply", text: measured() }]);
    let _ = warm_agrees("the load that cuts the package");
    let first = kept_package();
    let _ = warm_agrees("a load through it");
    assert(
      kept_package() == first,
      Some("a load that pulls nothing new keeps the package it read"),
    );
    write(
      "more.ply",
      "import std.option (option_unwrap_or)\npub fn or_zero(o: Option<Int>) -> Int = option_unwrap_or(o, 0)\n",
    );
    let _ = warm_agrees("a load that pulls a module the package lacks");
    let second = kept_package();
    assert(second.bytes != first.bytes, Some("the package is cut again to cover what was pulled"));
    let _ = warm_agrees("a load through the package cut again");
    let hashed = ["hash", "--deps", "--json"];
    let warm_hashes = comparable(json_of(on_disk(hashed)));
    let cold_hashes = comparable(json_of(in_memory(tree(sources_here()), hashed)));
    assert(
      warm_hashes == cold_hashes,
      Some("warm: " ++ shown(warm_hashes) ++ "\ncold: " ++ shown(cold_hashes)),
    );
    let single = ["check", "app.ply", "--json"];
    let warm_single = comparable(json_of(on_disk(single)));
    let cold_single = comparable(json_of(in_memory(tree(sources_here()), single)));
    assert(
      warm_single == cold_single,
      Some("warm: " ++ shown(warm_single) ++ "\ncold: " ++ shown(cold_single)),
    );
    assert(
      kept_package() == second,
      Some("a load that reaches part of the package keeps it whole"),
    );
    // `replace` and a mutant re-check a spliced program through the package the load read.
    write("distance.txt", "pub fn distance(a: Int, b: Int) -> Int = abs(b - a)\n");
    let replaced = on_disk(["replace", "distance", "--with", "distance.txt"]);
    assert(replaced.code == 0, Some(said(replaced)));
    let _ = warm_agrees("after a replacement");
    let mutate = ["test", "--mutate", "distance", "--json"];
    let warm = at(json_of(on_disk(mutate)), "mutants");
    let cold = at(json_of(in_memory(tree(sources_here()), mutate)), "mutants");
    assert(warm == cold, Some("warm: " ++ shown(warm) ++ "\ncold: " ++ shown(cold)));
    write(interfaces() ++ "/" ++ second.name, "not a package");
    let _ = warm_agrees("a load whose package does not read");
    assert(
      kept_package().bytes != b"not a package",
      Some("a package that does not read is cut again"),
    );
    assert(on_disk(["cache", "clear"]).code == 0, None);
    assert(!fs.exists[cwd](interfaces()), Some("clearing the cache discards the package"))
  })
}

fn packaged_project() -> Unit / {Here, abort.raise} =
  project([
    { path: "app/ply.pkg", text: manifest("app", lib_dep("../lib")) },
    {
      path: "app/main.ply",
      text:
        \\import lib.answer
        \\import lib.more
        \\
        \\pub fn main() -> Int = answer::answer() + more::more(1)
        \\
        \\pub fn bump(x: Int) -> Int
        \\  requires x < 100
        \\  ensures result > x
        \\= more::more(x)
        \\
        \\pub fn kept(x: Int) -> Int
        \\  ensures result == x
        \\= {
        \\  let _ = answer::answer();
        \\  x
        \\}
        \\
        \\test "main answers" { assert(main() > 0) }
        \\
    },
    { path: "lib/ply.pkg", text: manifest("lib", "") },
    { path: "lib/answer.ply", text: "pub fn answer() -> Int = 42\n\nfn helper() -> Int = 0\n" },
    {
      path: "lib/more.ply",
      text:
        \\import answer
        \\
        \\pub fn more(x: Int) -> Int
        \\  requires x < 100
        \\  ensures result > x
        \\= x + answer::answer()
        \\
    },
  ])

fn owners(v: Json) -> List<String> = map(items(at(v, "obligations")), |o: Json| str(at(o, "owner")))

test "a dependency read through its compiled package answers what its source does" {
  scratch(|| {
    packaged_project();
    let check = ["check", "app", "--explain", "--json"];
    let agrees = |what: String| {
      let warm = comparable(json_of(on_disk(check)));
      let cold = comparable(json_of(in_memory(tree(sources_here()), check)));
      assert(warm == cold, Some(what ++ "\nwarm: " ++ shown(warm) ++ "\ncold: " ++ shown(cold)))
    };
    agrees("the load that cuts the package");
    agrees("a load through it");
    assert(seeding_at("app").checked == 0, Some("the dependency is read through its stubs"));
    // A dependency's unused definition is its own package's to report.
    assert(!contains(codes(json_of(on_disk(["check", "app", "--json"]))), "W0611"), None);
    assert(contains(codes(json_of(on_disk(["check", "lib", "--json"]))), "W0611"), None);
    assert(on_disk(["prove", "app"]).code == 0, None);
    assert(on_disk(["test", "app"]).code == 0, None);
    edit("lib/answer.ply", "= 42", "= {\n  let _ = helper();\n  42\n}");
    // The dependency's body moved, and neither its contract nor what it publishes did: it alone is
    // checked again. A proof stands, and what runs the body runs again: the sampled `ensures` and
    // the test.
    assert(seeding_at("app").checked == 1, Some("only the edited definition is walked"));
    let proved = json_of(on_disk(["prove", "app", "--json"]));
    assert(int(at(proved, "cached")) == 1, Some(shown(proved)));
    assert(
      int(path(json_of(on_disk(["test", "app", "--json"])), ["selection", "cached"])) == 0,
      None,
    );
    agrees("after the dependency moved");
    agrees("through the package cut again");
    // A run answers for its own package; the dependency's obligation is its own run's.
    assert_eq(owners(json_of(on_disk(["prove", "app", "--json"]))), ["main.bump", "main.kept"]);
    assert_eq(owners(json_of(on_disk(["prove", "lib", "--json"]))), ["more.more"]);
    // `--workspace` runs each package it reaches by path as its own root, dependencies first.
    let both = items(at(json_of(on_disk(["prove", "app", "--workspace", "--json"])), "packages"));
    assert_eq(map(both, |p: Json| str(at(p, "root"))), ["lib", "app"]);
    assert_eq(map(both, |p: Json| owners(at(p, "answer"))), [
      ["more.more"],
      ["main.bump", "main.kept"],
    ])
  })
}

fn tiers(v: Json) -> List<String> = map(items(at(v, "obligations")), |o: Json| str(at(o, "tier")))

test "a dependent proves through a transparent definition, and is checked and proved again when its body moves" {
  scratch(|| {
    project([
      { path: "app/ply.pkg", text: manifest("app", lib_dep("../lib")) },
      {
        path: "app/main.ply",
        text: "import lib.same\n\npub fn kept(x: Int) -> Int\n  ensures result == x\n= same::same(x)\n",
      },
      { path: "lib/ply.pkg", text: manifest("lib", "") },
      { path: "lib/same.ply", text: "pub transparent fn same(x: Int) -> Int = x\n" },
    ]);
    assert_eq(tiers(json_of(on_disk(["prove", "app", "--json"]))), ["proved"]);
    assert(seeding_at("app").checked == 0, Some("a warm load walks nothing"));
    edit("lib/same.ply", "= x", "= x + 0");
    // The body is part of the contract: the dependent is checked and proved again.
    assert(seeding_at("app").checked == 2, Some("the edit and its dependent are walked"));
    let again = json_of(on_disk(["prove", "app", "--json"]));
    assert(int(at(again, "cached")) == 0, Some(shown(again)));
    assert_eq(tiers(again), ["proved"])
  })
}

test "a `reuse fn` keeps its promise through another package's `returns` clause" {
  scratch(|| {
    project([
      { path: "app/ply.pkg", text: manifest("app", lib_dep("../lib")) },
      {
        path: "app/main.ply",
        text: "import lib.lists\n\nreuse fn grow(n: Int) -> List<Int> = push(lists::made(n), n)\n",
      },
      { path: "lib/ply.pkg", text: manifest("lib", "") },
      {
        path: "lib/lists.ply",
        text: "pub fn made(n: Int) -> List<Int>\n  returns fresh\n= range(0, n)\n",
      },
    ]);
    let kept = json_of(on_disk(["check", "app", "--json"]));
    assert(int(at(kept, "exit_code")) == 0, Some(shown(kept)));
    assert(on_disk(["check", "lib"]).code == 0, None);
    // Without the clause nothing says the answer is fresh, whatever the body does.
    edit("lib/lists.ply", "  returns fresh\n", "");
    let refused = json_of(on_disk(["check", "app", "--json"]));
    assert(contains(codes(refused), "E0127"), Some(shown(refused)))
  })
}
