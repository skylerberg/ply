// The runtime's builtins and the compiler's prelude that types them: the same names, each call
// passing as many words as the checker binds it to, its witnesses first.

import compiler.emit (builtin_helper)
import compiler.front (BuiltinRow, builtin_rows)
import compiler.types (Atom, TyFn)
import compiler.unit (Helper, shipped)
import std.bytes

fn named(name: Bytes) -> String / {abort.raise} = "`" ++ string_of_bytes(name) ++ "`"

fn words(row: BuiltinRow) -> Int / {abort.raise} =
  row.witnesses
    + (match row.scheme.ty {
      TyFn(f) -> len(f.params),
      _ -> panic(named(row.name) ++ "'s scheme is not a function"),
    })

test "every builtin the prelude types passes the words the runtime's takes" {
  let runtime = fold(
    shipped.builtins(),
    map_new(),
    |acc: Map<Bytes, Int>, b: { name: Bytes, arity: Int, raises: Bool }|
      map_insert(acc, b.name, b.arity),
  );
  fold(builtin_rows(), (), |_u: Unit, row: BuiltinRow|
    match map_get(runtime, row.name) {
      None ->
        panic("the prelude types " ++ named(row.name) ++ ", which the runtime does not implement"),
      Some(n) ->
        assert(
          n == words(row),
          Some(
            named(row.name) ++ " takes " ++ int_to_string(n) ++ " words in the runtime and "
              ++ int_to_string(words(row))
              ++ " in the prelude's scheme",
          ),
        ),
    })
}

// A name no source can spell is the elaboration's to write, never a program's to call.
test "every builtin the runtime implements is one a program can call" {
  let typed = fold(builtin_rows(), map_new(), |acc: Map<Bytes, Bool>, row: BuiltinRow|
    map_insert(acc, row.name, true));
  let untyped = filter(
    map(shipped.builtins(), |b: { name: Bytes, arity: Int, raises: Bool }| b.name),
    |n: Bytes| !map_contains(typed, n) && !bytes_starts_with(n, b"?"),
  );
  assert(
    len(untyped) == 0,
    Some(
      "builtins no scheme in the prelude types: " ++ string_of_bytes(bytes::join(untyped, b", ")),
    ),
  )
}

fn typed_raises(row: BuiltinRow) -> Bool =
  match row.scheme.ty {
    TyFn(f) -> len(filter(f.effects.atoms, |a: Atom| a.effect == b"abort")) > 0,
    _ -> false,
  }

// The runtime answers a builtin's failure with a raise only where the scheme lets a `handle` see one.
test "every builtin raises exactly when its scheme says it may" {
  let runtime = fold(
    shipped.builtins(),
    map_new(),
    |acc: Map<Bytes, Bool>, b: { name: Bytes, arity: Int, raises: Bool }|
      map_insert(acc, b.name, b.raises),
  );
  fold(builtin_rows(), (), |_u: Unit, row: BuiltinRow|
    match map_get(runtime, row.name) {
      None -> (),
      Some(raises) ->
        assert(
          raises == typed_raises(row),
          Some(
            named(row.name) ++ (if typed_raises(row) { " raises" } else { " cannot raise" })
              ++ " by its scheme, and the runtime says "
              ++ (if raises { "it raises" } else { "it cannot" }),
          ),
        ),
    })
}

// The emitter writes a builtin's call as a call of the helper named for it.
test "every builtin has the helper the emitter calls it through, taking the words a call passes" {
  let helpers = fold(shipped.runtime().helpers, map_new(), |acc: Map<Bytes, Helper>, h: Helper|
    map_insert(acc, h.name, h));
  fold(shipped.builtins(), (), |_u: Unit, b: { name: Bytes, arity: Int, raises: Bool }|
    match map_get(helpers, builtin_helper(b.name)) {
      None -> panic("the runtime has no helper for " ++ named(b.name)),
      Some(h) ->
        assert(
          h.args == b.arity && h.answers,
          Some(
            named(b.name) ++ " passes " ++ int_to_string(b.arity) ++ " words, and its helper takes "
              ++ int_to_string(h.args),
          ),
        ),
    })
}
