// A JSON payload over a real socket, decoded and answered by the codecs `derive json` wrote.

import harness (Source, in_memory, tree, project, repo_file, reserve, serving, connection, exchange,
                returned, json_of, at, nth, str, shown, Hermetic, Repo, Shelf)
import std.fs (MemFs)
import std.string

fn startup_ms() -> Int = 30000

// The example, verbatim.
fn example() -> Source / {Repo, abort.raise} =
  { path: "orders.ply", text: repo_file("examples/orders.ply") }

// The `main` the example deliberately lacks, as a module of the test's own beside it.
fn entry(port: Int, connections: Int) -> Source =
  {
    path: "serve.ply",
    text: "import std.net (net)\nimport orders\n\nfn main() -> Int / {net.write[listener], net.write[conn], abort.raise} =\n  orders::listen_and_serve("
      ++ int_to_string(port)
      ++ ", "
      ++ int_to_string(connections)
      ++ ")\n",
  }

// The claim the socket test rests on: `ply show` finds no `fn` written for the codec a request is
// decoded with or the one its answer is encoded with, and names the `derive` declaring each.
fn the_codecs_are_derived(t: MemFs) -> Unit / {Hermetic, Shelf, abort.raise} =
  fold(
    [
      { codec: "order_json", declaration: "derive json for Order" },
      { codec: "reply_json", declaration: "derive json for Reply" },
    ],
    (),
    |u: Unit, c: { codec: String, declaration: String }| {
      let shown_by = json_of(in_memory(t, ["show", c.codec, "--json"]));
      let refusal = nth(at(shown_by, "diagnostics"), 0);
      assert(
        str(at(refusal, "code")) == "E0101"
          && str(at(nth(at(refusal, "labels"), 0), "snippet")) == c.declaration,
        Some(
          "`" ++ c.codec ++ "` should be declared by `" ++ c.declaration
            ++ "` and written by no `fn`; `ply show` answered "
            ++ shown(shown_by),
        ),
      )
    },
  )

fn post(body: String) -> Bytes =
  bytes_of_string(
    "POST /orders HTTP/1.1\r\nHost: 127.0.0.1\r\nContent-Type: application/json\r\nContent-Length: "
      ++ int_to_string(bytes_len(bytes_of_string(body)))
      ++ "\r\n\r\n"
      ++ body,
  )

fn body_of(response: String) -> String / {abort.raise} =
  match string::split_once(response, "\r\n\r\n") {
    Some(p) -> p.tail,
    None -> panic("a response has a blank line:\n" ++ response),
  }

test/nondet "a JSON payload over a real socket is decoded and answered by a derived codec" {
  the_codecs_are_derived(tree([example()]));
  let port = reserve();
  project([example(), entry(port, 2)]);
  let server = serving(["run", "--host"], [], port);

  let accepted = exchange(
    connection(server, startup_ms()),
    post("{\"customer\":\"ada\",\"lines\":[{\"sku\":\"widget\",\"qty\":3,\"unit_price\":1.05}]}"),
  );
  assert(string_starts_with(accepted, "HTTP/1.1 200 OK\r\n"), Some("got:\n" ++ accepted));
  assert(
    string_contains(accepted, "Content-Type: application/json\r\n"),
    Some("got:\n" ++ accepted),
  );
  // 3 x 1.05 exactly, and rendered at the scale the arithmetic produced.
  assert_eq(
    body_of(accepted),
    "{\"tag\":\"Accepted\",\"values\":[{\"customer\":\"ada\",\"items\":3,\"total\":3.15}]}",
  );

  let rejected = exchange(
    connection(server, startup_ms()),
    post(
      "{\"customer\":\"ada\",\"lines\":[{\"sku\":\"w\",\"qty\":\"three\",\"unit_price\":1.05}]}",
    ),
  );
  assert(string_starts_with(rejected, "HTTP/1.1 400 Bad Request\r\n"), Some("got:\n" ++ rejected));
  assert_eq(
    body_of(rejected),
    "{\"tag\":\"Rejected\",\"values\":[\"$.lines[0].qty: expected a number, found a string\"]}",
  );

  returned(server)
}
