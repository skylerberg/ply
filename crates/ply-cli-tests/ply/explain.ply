// `ply explain`: one line per code, as text and as a document, each from the one table.

import harness (Ran, in_memory, tree, stdout, stderr, json_of, at, str, int, items, nth, Hermetic,
                Shipped)
import std.json (Json)
import std.list (concat)

fn explain(argv: List<String>) -> Ran / {Hermetic, Shipped, abort.raise, diverges} =
  in_memory(tree([]), concat(["explain"], argv))

test "a code is explained in one line and as JSON" {
  let plain = explain(["e0302"]);
  assert_eq(plain.code, 0);
  assert_eq(stdout(plain), "E0302 effect not permitted by the written row\n");
  let v = json_of(explain(["W0611", "--json"]));
  assert_eq(str(at(v, "code")), "W0611");
  assert_eq(str(at(v, "severity")), "warning");
  assert_eq(
    str(at(v, "meaning")),
    "definition no `pub` item, `main`, test or law reaches; a leading `_` in its name keeps it quiet",
  );
  assert_eq(int(at(v, "exit_code")), 0)
}

test "the label instantiation code is explained like any other" {
  let meaning = "label instantiation: a call leaves a label unfilled or writes the wrong number of them, or a label-generic definition is used as a value";
  let plain = explain(["E0306"]);
  assert_eq(plain.code, 0);
  assert_eq(stdout(plain), "E0306 " ++ meaning ++ "\n");
  let v = json_of(explain(["e0306", "--json"]));
  assert_eq(str(at(v, "code")), "E0306");
  assert_eq(str(at(v, "severity")), "error");
  assert_eq(str(at(v, "meaning")), meaning)
}

test "a code nothing raises exits two and points at the list" {
  let unknown = explain(["E9999"]);
  assert_eq(unknown.code, 2);
  assert(string_contains(stderr(unknown), "explain --all"));
  let rows = items(at(json_of(explain(["--all", "--json"])), "codes"));
  assert_eq(str(at(nth(at(json_of(explain(["--all", "--json"])), "codes"), 0), "code")), "E0001");
  let lines = explain(["--all"]).out;
  assert_eq(len(rows), len(lines));
  assert_eq(lines, map(rows, |row: Json| str(at(row, "code")) ++ " " ++ str(at(row, "meaning"))))
}
