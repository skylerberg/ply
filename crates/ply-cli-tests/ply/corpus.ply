// The corpora the repository ships, run green on the C backend: the examples and the language
// corpus.

import harness (scratch, Ran, project, program, write, repo, working, repo_file, reserve, serving,
                connection, sent, heard, ended, finished, on_disk, spawned, said, stderr, json_of,
                at, path, items, str, int, truth, shown, in_memory, tree)
import std.fs (fs)
import std.json (Json)
import std.string
import std.string (int_of_string)

fn report_of(ran: Ran) -> Json / {abort.raise} = json_of(ran)

// The whole report is too long for a CI log line, so a red one names its failures and their
// diagnostics.
pub fn green(report: Json, what: String) -> Unit / {abort.raise} = {
  let failures = string::join(
    map(items(at(report, "failures")), |f: Json|
      str(at(f, "name")) ++ ": " ++ str(path(f, ["diagnostic", "code"])) ++ " "
        ++ str(path(f, ["diagnostic", "message"]))),
    "\n",
  );
  let why = if failures == "" { shown(at(report, "summary")) } else { failures };
  assert(truth(at(report, "ok")), Some(what ++ " is red:\n" ++ why));
  assert(int(path(report, ["summary", "failed"])) == 0, Some(what ++ " is red:\n" ++ why))
}

pub fn entered(report: Json, what: String) -> Unit / {abort.raise} =
  assert(
    int(path(report, ["backend", "entered"])) > 0,
    Some(
      what ++ " entered nothing, so the run is green over a seam no call reached: "
        ++ shown(at(report, "backend")),
    ),
  )

fn succeeded(ran: Ran) -> Unit / {abort.raise} = assert(ran.code == 0, Some(said(ran)))

// How many roots a `phases: emitter ...` line says the emitter was asked for, and `0` for any
// other line.
fn emitter_asked(line: String) -> Int / {abort.raise} =
  if !string_starts_with(line, "phases: emitter ") { 0 } else {
    match list_at(string_split(line, ", "), 2) {
      None -> 0,
      Some(asked) -> {
        let first = match string::split_once(asked, " ") { Some(p) -> p.head, None -> asked };
        match int_of_string(first) { Some(n) -> n, None -> 0 }
      },
    }
  }

// From an empty C cache and no recorded pass, so every body is emitted afresh and every test runs.
test/nondet "the Ply emitter compiles examples and the C backend runs them green" {
  project([]);
  let r = spawned(["test", repo() ++ "/examples", "--no-cache", "--json"], [
    { name: "PLY_C_CACHE", value: working() ++ "/cache" },
    { name: "PLY_C_PHASES", value: "1" },
  ]);
  let asked = len(filter(r.err, |l: String| emitter_asked(l) > 0)) > 0;
  assert(asked, Some("the emitter was asked for nothing from an empty cache:\n" ++ stderr(r)));
  let report = report_of(r);
  green(report, "the C backend over examples/");
  assert(str(path(report, ["backend", "name"])) == "c", Some(shown(at(report, "backend"))));
  entered(report, "the C backend");
  assert(
    int(path(report, ["backend", "units"])) > 0,
    Some(
      "no unit was compiled, so `c` is not a code generator here: " ++ shown(at(report, "backend")),
    ),
  )
}

// `std.json` parses an array by a cycle of tail calls, so on the C backend an array's length
// is bounded by memory and not by the call budget.
test "the C backend decodes a long array without nesting" {
  scratch(|| {
    program(
      \\import std.json (parse, Json, Array)
      \\
      \\fn long_array(n: Int) -> Bytes =
      \\  bytes_concat_all([b"[", bytes_concat_all(map(range(0, n), |_i: Int| b"7,")), b"7]"])
      \\
      \\test "a long array decodes" {
      \\  assert_eq(
      \\    match parse(long_array(100_000)) { Ok(Array(items)) -> len(items), _ -> -1 },
      \\    100_001)
      \\}
      \\
    );
    let report = report_of(on_disk(["test", ".", "--no-cache", "--json"]));
    green(report, "a long array on the C backend");
    entered(report, "the C backend")
  })
}

// Embedded, so the corpus's run is cached until a file in it changes.
fn lang_corpus() -> List<{ name: String, bytes: Bytes }> = embed_dir("../../../tests/lang")

test "the language corpus is green" {
  let files = map(lang_corpus(), |f: { name: String, bytes: Bytes }|
    { path: f.name, text: string_of_bytes(f.bytes) });
  succeeded(in_memory(tree(files), ["test", ".", "--no-cache"]))
}

test/nondet "the C backend judges the examples' specifications" {
  project([]);
  let r = spawned(["prove", repo() ++ "/examples", "--no-cache", "--json"], [
    { name: "PLY_C_REFUSALS", value: "1" },
    { name: "PLY_C_PHASES", value: "1" },
  ]);
  assert(
    len(filter(r.err, |l: String| string_starts_with(l, "entry:"))) > 0,
    Some("the C backend entered nothing while proving examples/:\n" ++ stderr(r)),
  );
  let report = report_of(r);
  let summary = at(report, "summary");
  assert(
    truth(at(report, "ok")) && int(at(summary, "obligations")) > 0
      && int(at(summary, "refuted")) == 0,
    Some("the C backend did not judge examples/'s specifications cleanly: " ++ shown(summary)),
  )
}

test/nondet "a served example answers its one connection and exits" {
  let port = reserve();
  project([{ path: "hello.ply", text: repo_file("examples/hello.ply") }]);
  let server = serving(
    [
      "run",
      "--host",
      "--set",
      "HELLO_PORT=" ++ int_to_string(port),
      "--set",
      "HELLO_CONNECTIONS=1",
    ],
    [],
    port,
  );
  let c = connection(server, 120000);
  sent(c, b"GET / HTTP/1.1\r\nHost: x\r\n\r\n");
  let answer = heard(c, 30000);
  let out = finished(ended(server, 30000, "the server did not return after its one connection"));
  assert(
    string_contains(answer, "hello from ply"),
    Some("the server did not answer the request:\n" ++ answer ++ "\n" ++ stderr(out)),
  );
  assert(out.code == 0, Some("the run exited " ++ int_to_string(out.code) ++ ":\n" ++ stderr(out)))
}

// The bytes a literal spells, escaped where a byte is not printable or would end the literal.
fn literal_of(n: Int) -> String / {abort.raise} =
  "b\""
    ++ string::join(
      map(range(0, n), |i: Int| {
        let b = i % 251;
        if b < 32 || b > 126 || b == 34 || b == 92 { "\\x" ++ hex2(b) }
        else { string_of_bytes(byte_of_int(b)) }
      }),
      "",
    )
    ++ "\""

fn hex2(b: Int) -> String / {abort.raise} = {
  let digits = "0123456789abcdef";
  string_slice(digits, b / 16, b / 16 + 1) ++ string_slice(digits, b % 16, b % 16 + 1)
}

// Sixty-four chunks: long enough that every loop comes round with a record its backend may have held
// back.
test "the C backend hashes a long input consistently" {
  scratch(|| {
    project([
      { path: "input.ply", text: "pub fn long() -> Bytes = " ++ literal_of(65536) ++ "\n" },
      {
        path: "h.ply",
        text:
          \\import std.hash (blake3)
          \\import input (long)
          \\test "a long input hashes to a stable digest" {
          \\  assert_eq(blake3(long()), blake3(long()))
          \\}
          \\pub fn digest() -> Bytes = blake3(long())
          \\
      },
    ]);
    green(
      report_of(on_disk(["test", ".", "--no-cache", "--json"])),
      "the C backend over a long input",
    )
  })
}
