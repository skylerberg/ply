//! `ply doc`: a definition's signature, doc, clauses, place and the laws that name it; a type's,
//! an effect's and a module's members; a builtin's declaration; and a shipped module's names.

import harness (in_memory, tree, one, said, stdout, json_of, at, path, nth, items, str, int, shown)
import std.json (Json)

fn source() -> String =
  \\fn unrelated() -> Int = 0
  \\
  \\/// The bound a fresh server starts with.
  \\/// It is positive.
  \\pub fn default_limit() -> Int = 1024
  \\
  \\/// Widens the bound alone.
  \\fn widened(limit: Int, by: Int) -> Int = limit + by
  \\
  \\// A comment for whoever maintains it, which documents nothing.
  \\fn undocumented(xs: List<Int>) -> Int = xs.len()
  \\

test "a definition is documented by its signature, its doc and its place" {
  let v = json_of(in_memory(one(source()), ["doc", "widened", "--json"]));
  assert(int(at(v, "exit_code")) == 0, Some(shown(v)));
  assert_eq(str(at(v, "kind")), "definition");
  assert_eq(str(at(v, "name")), "m.widened");
  assert_eq(str(at(v, "signature")), "fn widened(limit: Int, by: Int) -> Int");
  assert_eq(str(at(v, "doc")), "Widens the bound alone.");
  assert_eq(str(at(nth(at(v, "params"), 1), "name")), "by");
  assert_eq(str(at(nth(at(v, "params"), 1), "type")), "Int");
  assert_eq(str(at(v, "footprint")), "{}");
  assert_eq(str(at(v, "hash")).len(), 64);
  assert(str(at(v, "location")).ends_with("m.ply:8:1"), Some(shown(v)));
  let text = stdout(in_memory(one(source()), ["doc", "m.default_limit"]));
  assert(text.contains("pub fn default_limit() -> Int"), Some(text));
  assert(
    text.contains("The bound a fresh server starts with.\n") && text.contains("It is positive."),
    Some(text),
  );
  let limit = json_of(in_memory(one(source()), ["doc", "default_limit", "--json"]));
  assert_eq(str(at(limit, "summary")), "The bound a fresh server starts with.");
  let bare = json_of(in_memory(one(source()), ["doc", "undocumented", "--json"]));
  assert_eq(str(at(bare, "doc")), "");
  assert_eq(str(at(bare, "signature")), "fn undocumented(xs: List<Int>) -> Int")
}

fn specified() -> String =
  \\/// The sum of a list.
  \\pub fn total(xs: List<Int>) -> Int
  \\  requires xs.len() < 100
  \\  ensures result >= 0 || xs.len() > 0
  \\= xs.fold(0, |a: Int, x: Int| a + x)
  \\
  \\test "a total adds" { assert_eq(total([1, 2]), 3) }
  \\
  \\test "an empty total is zero" { assert_eq(total([]), 0) }
  \\
  \\law "a total of one is its element" forall (x: Int) { total([x]) == x }
  \\

test "a definition shows its clauses and the laws that name it, and no test" {
  let v = json_of(in_memory(one(specified()), ["doc", "total", "--json"]));
  assert(int(at(v, "exit_code")) == 0, Some(shown(v)));
  assert_eq(items(at(v, "clauses")).map(str), [
    "requires xs.len() < 100",
    "ensures result >= 0 || xs.len() > 0",
  ]);
  assert_eq(items(at(v, "laws")).map(str), ["a total of one is its element"]);
  let text = stdout(in_memory(one(specified()), ["doc", "total"]));
  assert(text.contains("laws \"a total of one is its element\""), Some(text));
  assert(!text.contains("a total adds"), Some(text))
}

fn binding() -> String =
  \\pub fn total(xs: List<Int>) -> Int = xs.fold(0, |a: Int, x: Int| a + x)
  \\
  \\pub fn count(xs: List<Int>) -> Int = xs.len()
  \\
  \\law "a total of one is its element" forall (count: Int) { total([count]) == count }
  \\

test "a law names what its sentence refers to, and not a definition its binder shares a name with" {
  let laws = |name: String|
    items(at(json_of(in_memory(one(binding()), ["doc", name, "--json"])), "laws")).map(str);
  assert_eq(laws("total"), ["a total of one is its element"]);
  assert_eq(laws("count"), [])
}

fn declarations() -> String =
  \\//! Orders, and what a shop does with them.
  \\//!
  \\//! Every price is in cents.
  \\
  \\/// An order as the shop holds it.
  \\pub type Order = {
  \\  /// Who bought it.
  \\  buyer: String,
  \\  cents: Int,
  \\}
  \\
  \\/// Where an order stands.
  \\pub type Status =
  \\  /// Placed, not paid.
  \\  | Open
  \\  /// Paid, with the receipt's number.
  \\  | Paid(Int)
  \\
  \\/// The shop's ledger.
  \\pub effect ledger {
  \\  /// Records an order and answers its number.
  \\  write record(o: Order) -> Int
  \\  read count() -> Int
  \\}
  \\
  \\/// What a till may do.
  \\pub effect set Till = {ledger.write}
  \\
  \\/// The cents of an order. Never negative.
  \\pub fn cents_of(o: Order) -> Int = if o.cents > 0 { o.cents } else { 0 }
  \\
  \\fn private_helper() -> Int = 1
  \\

fn member(v: Json, i: Int, field: String) -> String = str(at(nth(at(v, "members"), i), field))

test "a type is documented with each field or variant and its doc" {
  let order = json_of(in_memory(one(declarations()), ["doc", "Order", "--json"]));
  assert(int(at(order, "exit_code")) == 0, Some(shown(order)));
  assert_eq(str(at(order, "kind")), "type");
  assert_eq(str(at(order, "name")), "m.Order");
  assert_eq(str(at(order, "signature")), "pub type Order");
  assert_eq(str(at(order, "doc")), "An order as the shop holds it.");
  assert_eq(member(order, 0, "signature"), "buyer: String");
  assert_eq(member(order, 0, "doc"), "Who bought it.");
  assert_eq(member(order, 1, "signature"), "cents: Int");
  assert_eq(member(order, 1, "doc"), "");
  let status = json_of(in_memory(one(declarations()), ["doc", "m.Status", "--json"]));
  assert_eq(member(status, 1, "kind"), "variant");
  assert_eq(member(status, 1, "signature"), "Paid(Int)");
  assert_eq(member(status, 1, "doc"), "Paid, with the receipt's number.");
  assert(str(at(status, "location")).ends_with("m.ply:13:5"), Some(shown(status)))
}

test "a `new` record is documented as one, with each field and its doc" {
  let source = "/// A day.\npub type Date = new {\n  /// Four digits.\n  year: Int,\n  month: Int,\n}\n";
  let date = json_of(in_memory(one(source), ["doc", "Date", "--json"]));
  assert(int(at(date, "exit_code")) == 0, Some(shown(date)));
  assert_eq(str(at(date, "kind")), "type");
  assert_eq(str(at(date, "signature")), "pub type Date = new { .. }");
  assert_eq(str(at(date, "doc")), "A day.");
  assert_eq(member(date, 0, "kind"), "field");
  assert_eq(member(date, 0, "signature"), "year: Int");
  assert_eq(member(date, 0, "doc"), "Four digits.");
  assert_eq(member(date, 1, "signature"), "month: Int");
  assert_eq(member(date, 1, "doc"), "")
}

test "an opaque type is documented as one: a record with the fields any module reads, a sum with none of its constructors" {
  let source = "/// A day.\npub opaque type Date = new {\n  /// Four digits.\n  year: Int,\n}\n\n/// A pass.\npub opaque type Token = | Token(String)\n";
  let date = json_of(in_memory(one(source), ["doc", "Date", "--json"]));
  assert(int(at(date, "exit_code")) == 0, Some(shown(date)));
  assert_eq(str(at(date, "signature")), "pub opaque type Date = new { .. }");
  assert_eq(member(date, 0, "signature"), "year: Int");
  assert_eq(member(date, 0, "doc"), "Four digits.");
  let token = json_of(in_memory(one(source), ["doc", "m.Token", "--json"]));
  assert_eq(str(at(token, "signature")), "pub opaque type Token");
  assert_eq(str(at(token, "doc")), "A pass.");
  assert_eq(items(at(token, "members")), [])
}

test "an effect is documented with each operation, and an operation by `effect.op`" {
  let ledger = json_of(in_memory(one(declarations()), ["doc", "ledger", "--json"]));
  assert_eq(str(at(ledger, "kind")), "effect");
  assert_eq(str(at(ledger, "signature")), "pub effect ledger");
  assert_eq(member(ledger, 0, "signature"), "write record(o: Order) -> Int");
  assert_eq(member(ledger, 0, "doc"), "Records an order and answers its number.");
  assert_eq(member(ledger, 1, "signature"), "read count() -> Int");
  let op = json_of(in_memory(one(declarations()), ["doc", "ledger.record", "--json"]));
  assert_eq(str(at(op, "kind")), "operation");
  assert_eq(str(at(op, "name")), "m.ledger.record");
  assert_eq(str(at(op, "doc")), "Records an order and answers its number.");
  let set = json_of(in_memory(one(declarations()), ["doc", "Till", "--json"]));
  assert_eq(str(at(set, "kind")), "effect set");
  assert_eq(str(at(set, "signature")), "pub effect set Till = {ledger.write}");
  assert_eq(str(at(set, "doc")), "What a till may do.")
}

test "a module is documented by its `//!` lines and each thing it publishes by summary" {
  let v = json_of(in_memory(one(declarations()), ["doc", "m", "--json"]));
  assert(int(at(v, "exit_code")) == 0, Some(shown(v)));
  assert_eq(str(at(v, "kind")), "module");
  assert_eq(
    str(at(v, "doc")),
    "Orders, and what a shop does with them.\n\nEvery price is in cents.",
  );
  assert_eq(str(at(v, "summary")), "Orders, and what a shop does with them.");
  assert_eq(items(at(v, "members")).map(|m: Json| str(at(m, "name"))), [
    "Order",
    "Status",
    "ledger",
    "Till",
    "cents_of",
  ]);
  assert_eq(member(v, 4, "summary"), "The cents of an order.");
  let text = stdout(in_memory(one(declarations()), ["doc", "m"]));
  assert(
    text.contains(
      "pub fn cents_of(o: {buyer: String, cents: Int}) -> Int\n      The cents of an order.\n",
    ),
    Some(text),
  );
  assert(!text.contains("private_helper"), Some(text))
}

fn stated() -> String =
  \\//! What a codec is held to.
  \\
  \\/// `decode` reads back what `encode` wrote.
  \\///
  \\/// One direction only.
  \\pub law schema round_trip<a>(encode: (a) -> String, decode: (String) -> Option<a>)
  \\  forall (x: a) where encode(x) != "" { decode(encode(x)) == Some(x) }
  \\
  \\fn word(b: Bool) -> String = if b { "yes" } else { "no" }
  \\
  \\fn truth(s: String) -> Option<Bool> = if s == "yes" { Some(true) } else { Some(false) }
  \\
  \\law "a bool reads back" = round_trip(word, truth)
  \\

test "a schema is documented as it is written, with its doc and the laws that instantiate it" {
  let v = json_of(in_memory(one(stated()), ["doc", "round_trip", "--json"]));
  assert(int(at(v, "exit_code")) == 0, Some(shown(v)));
  assert_eq(str(at(v, "kind")), "law schema");
  assert_eq(str(at(v, "name")), "m.round_trip");
  assert_eq(
    str(at(v, "signature")),
    "pub law schema round_trip<a>(encode: (a) -> String, decode: (String) -> Option<a>) forall (x: a) where encode(x) != \"\" { decode(encode(x)) == Some(x) }",
  );
  assert_eq(str(at(v, "summary")), "`decode` reads back what `encode` wrote.");
  assert_eq(items(at(v, "laws")).map(str), ["a bool reads back"]);
  // The module lists it once, as a schema, and its guard's definition not at all.
  let m = json_of(in_memory(one(stated()), ["doc", "m", "--json"]));
  assert_eq(
    items(at(m, "members")).map(|x: Json| str(at(x, "kind")) ++ " " ++ str(at(x, "name"))),
    ["law schema round_trip"],
  )
}

test "a doc above an instantiation documents nothing, as above any law" {
  let r = in_memory(
    one(
      "law schema s(f: (Int) -> Int) forall (x: Int) { f(x) == x }\n\n/// stray\nlaw \"l\" = s(|n: Int| n)\n",
    ),
    ["check"],
  );
  assert(said(r).contains("E0003"), Some(said(r)))
}

test "a builtin is documented by what the prelude declares" {
  let v = json_of(in_memory(one(source()), ["doc", "Array::of_list", "--json"]));
  assert(int(at(v, "exit_code")) == 0, Some(shown(v)));
  assert_eq(str(at(v, "kind")), "builtin");
  assert_eq(str(at(v, "signature")), "Array::of_list<a>(xs: List<a>) -> Array<a>");
  assert_eq(str(at(nth(at(v, "params"), 0), "name")), "xs");
  let merge = stdout(in_memory(one(source()), ["doc", "Map::merge"]));
  assert(
    merge.contains("Map::merge<a, b>(a: Map<a, b>, b: Map<a, b>) -> Map<a, b>")
      && merge.contains("`b` wins"),
    Some(merge),
  );
  // Outside any project, a builtin still answers.
  let lone = json_of(in_memory(tree([]), ["doc", "List::len", "--json"]));
  assert_eq(str(at(lone, "signature")), "List::len<a>(xs: List<a>) -> Int")
}

test "a function the prelude writes in Ply is documented as its definition, with its place and hash" {
  let signature = "pub fn List::map<a, b | e>(xs: List<a>, f: (a) -> b / e) -> List<b> / e";
  let documented = |v: Json| {
    assert(int(at(v, "exit_code")) == 0, Some(shown(v)));
    assert_eq(str(at(v, "kind")), "definition");
    assert_eq(str(at(v, "signature")), signature);
    assert_eq(str(at(v, "module")), "std.prelude");
    assert(str(at(v, "location")).starts_with("<std>/prelude.ply:"), Some(shown(v)));
    assert_eq(str(at(v, "hash")).len(), 64)
  };
  documented(json_of(in_memory(one(source()), ["doc", "List::map", "--json"])));
  documented(json_of(in_memory(tree([]), ["doc", "List::map", "--json"])));
  // The prelude's page lists its natives, then what it writes in Ply.
  let prelude = json_of(in_memory(tree([]), ["doc", "std.prelude", "--json"]));
  assert_eq(str(at(prelude, "kind")), "module");
  assert_eq(str(at(prelude, "location")), "<std>/prelude.ply");
  let kind_of = |name: String|
    items(at(prelude, "members")).filter(|m: Json| str(at(m, "name")) == name).map(|m: Json|
      str(at(m, "kind")));
  assert_eq(kind_of("List::len"), ["builtin"]);
  assert_eq(kind_of("List::at"), ["definition"]);
  assert_eq(kind_of("List::map"), ["definition"]);
  // A type of the language's lists it among its functions.
  let list = json_of(in_memory(tree([]), ["doc", "List", "--json"]));
  assert_eq(
    items(at(list, "members")).filter(|m: Json| str(at(m, "name")) == "List::map").map(|m: Json|
      str(at(m, "signature"))),
    [signature],
  )
}

test "a type of the language's lists its functions, the prelude's and then its home module's" {
  let v = json_of(in_memory(tree([]), ["doc", "List", "--json"]));
  assert(int(at(v, "exit_code")) == 0, Some(shown(v)));
  assert_eq(str(at(v, "kind")), "type");
  let names = items(at(v, "members")).map(|m: Json| str(at(m, "name")));
  let place = |name: String| names.index_of(name);
  assert(place("List::len") != None && place("List::contains") != None, Some(shown(v)));
  assert(
    match ((place("List::len"), place("List::contains"))) {
      (Some(builtin), Some(home)) -> builtin < home,
      _ -> false,
    },
    Some(shown(v)),
  );
  assert_eq(in_memory(tree([]), ["doc", "Nothing", "--json"]).code, 2)
}

test "a name no program holds is looked for among the shipped modules" {
  let v = json_of(in_memory(one(source()), ["doc", "std.path.join", "--json"]));
  assert(int(at(v, "exit_code")) == 0, Some(shown(v)));
  assert_eq(str(at(v, "kind")), "definition");
  assert_eq(str(at(v, "signature")), "pub fn join(dir: String, name: String) -> String");
  assert(str(at(v, "location")).starts_with("<std>/path.ply:"), Some(shown(v)));
  let module = json_of(in_memory(tree([]), ["doc", "std.path", "--json"]));
  assert_eq(str(at(module, "kind")), "module");
  assert(items(at(module, "members")).len() > 0, Some(shown(module)));
  let many = in_memory(one(source()), ["doc", "join", "--json"]);
  assert_eq(many.code, 2);
  let notes = str(nth(at(nth(at(json_of(many), "diagnostics"), 0), "notes"), 0));
  assert(notes.contains("std.path.join") && notes.contains("std.mime.join"), Some(notes))
}

test "a shipped definition lists the laws its module holds of it, the same in a program that imports it" {
  let law = "insert does to a bit set what it does to a set";
  let named = |v: Json| items(at(v, "laws")).filter(|j: Json| str(j) == law).len() == 1;
  let alone = json_of(in_memory(tree([]), ["doc", "std.bitset.insert", "--json"]));
  assert(int(at(alone, "exit_code")) == 0, Some(shown(alone)));
  assert(named(alone), Some(shown(alone)));
  // A program that reads one function of the module is shown the page the toolchain documents.
  let importing = one("import std.bitset (empty, size)\nfn main() -> Int = size(empty())\n");
  let within = json_of(in_memory(importing, ["doc", "std.bitset.insert", "--json"]));
  assert_eq(shown(within), shown(alone));
  let module = json_of(in_memory(importing, ["doc", "std.bitset", "--json"]));
  assert(items(at(module, "members")).len() > 3, Some(shown(module)))
}

fn label_generic() -> String =
  \\effect net {
  \\  write send[s](payload: Bytes) -> Int
  \\}
  \\
  \\/// Writes under the resource its caller fills.
  \\pub fn relay<[l]>(payload: Bytes) -> Int / {net.send[l]} = net.send[l](payload)
  \\

test "a label-generic definition documents the binder it leaves to its caller" {
  let v = json_of(in_memory(one(label_generic()), ["doc", "relay", "--json"]));
  assert(int(at(v, "exit_code")) == 0, Some(shown(v)));
  assert_eq(str(at(v, "signature")), "pub fn relay<[l]>(payload: Bytes) -> Int / {m.net.send[l]}");
  assert_eq(str(at(v, "type")), "<[l]>(Bytes) -> Int / {m.net.send[l]}");
  assert_eq(str(at(nth(at(v, "params"), 0), "name")), "payload");
  assert_eq(str(at(v, "doc")), "Writes under the resource its caller fills.");
  let text = stdout(in_memory(one(label_generic()), ["doc", "relay"]));
  assert(text.contains("pub fn relay<[l]>(payload: Bytes) -> Int"), Some(text))
}

test "a name that is neither exits two with the unknown name code" {
  let r = in_memory(one(source()), ["doc", "nothing_here", "--json"]);
  assert_eq(r.code, 2);
  let v = json_of(r);
  assert(str(at(nth(at(v, "diagnostics"), 0), "code")) == "E0101", Some(shown(v)))
}

test "a doc comment that documents nothing stops the load with `E0003`" {
  let r = in_memory(one("fn f() -> Int = 1\n\n/// below nothing\n"), ["check", "--json"]);
  assert_eq(r.code, 2);
  let v = json_of(r);
  assert(str(at(nth(at(v, "diagnostics"), 0), "code")) == "E0003", Some(shown(v)))
}
