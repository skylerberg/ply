// `ply doc`: a definition's signature, the comment above it and its place, and a builtin's line
// from the compiler's table.

import harness (in_memory, tree, one, stdout, json_of, at, path, nth, str, int, shown)

fn source() -> String =
  \\fn unrelated() -> Int = 0
  \\
  \\// The bound a fresh server starts with.
  \\// It is positive.
  \\pub fn default_limit() -> Int = 1024
  \\
  \\// Widens the bound alone.
  \\fn widened(limit: Int, by: Int) -> Int = limit + by
  \\
  \\fn undocumented(xs: List<Int>) -> Int = len(xs)
  \\

test "a definition is documented by its signature, the comment above it and its place" {
  let v = json_of(in_memory(one(source()), ["doc", "widened", "--json"]));
  assert(int(at(v, "exit_code")) == 0, Some(shown(v)));
  assert_eq(str(at(v, "kind")), "definition");
  assert_eq(str(at(v, "name")), "m.widened");
  assert_eq(str(at(v, "signature")), "fn widened(limit: Int, by: Int) -> Int");
  assert_eq(str(at(v, "doc")), "Widens the bound alone.");
  assert_eq(str(at(nth(at(v, "params"), 1), "name")), "by");
  assert_eq(str(at(nth(at(v, "params"), 1), "type")), "Int");
  assert_eq(str(at(v, "footprint")), "{}");
  assert_eq(string_len(str(at(v, "hash"))), 64);
  assert(string_ends_with(str(at(v, "location")), "m.ply:8:1"), Some(shown(v)));
  let text = stdout(in_memory(one(source()), ["doc", "m.default_limit"]));
  assert(string_contains(text, "pub fn default_limit() -> Int"), Some(text));
  assert(
    string_contains(text, "The bound a fresh server starts with.\n")
      && string_contains(text, "It is positive."),
    Some(text),
  );
  let bare = json_of(in_memory(one(source()), ["doc", "undocumented", "--json"]));
  assert_eq(str(at(bare, "doc")), "");
  assert_eq(str(at(bare, "signature")), "fn undocumented(xs: List<Int>) -> Int")
}

test "a builtin is documented from the compiler's table with names and a note" {
  let v = json_of(in_memory(one(source()), ["doc", "map", "--json"]));
  assert(int(at(v, "exit_code")) == 0, Some(shown(v)));
  assert_eq(str(at(v, "kind")), "builtin");
  assert_eq(str(at(v, "signature")), "map<a, b | e>(xs: List<a>, f: (a) -> b / e) -> List<b> / e");
  assert_eq(str(at(nth(at(v, "params"), 0), "name")), "xs");
  let merge = stdout(in_memory(one(source()), ["doc", "map_merge"]));
  assert(
    string_contains(merge, "map_merge<a, b>(a: Map<a, b>, b: Map<a, b>) -> Map<a, b>")
      && string_contains(merge, "`b` wins"),
    Some(merge),
  );
  // Outside any project, a builtin still answers.
  let lone = json_of(in_memory(tree([]), ["doc", "len", "--json"]));
  assert_eq(str(at(lone, "signature")), "len<a>(xs: List<a>) -> Int")
}

fn label_generic() -> String =
  \\effect net {
  \\  write send[s](payload: Bytes) -> Int
  \\}
  \\
  \\// Writes under the resource its caller fills.
  \\pub fn relay<[l]>(payload: Bytes) -> Int / {net.send[l]} = net.send[l](payload)
  \\

test "a label-generic definition documents the binder it leaves to its caller" {
  let v = json_of(in_memory(one(label_generic()), ["doc", "relay", "--json"]));
  assert(int(at(v, "exit_code")) == 0, Some(shown(v)));
  assert_eq(str(at(v, "signature")), "pub fn relay<[l]>(payload: Bytes) -> Int / {m.net.send[l]}");
  assert_eq(str(at(v, "type")), "<[l]>(Bytes) -> Int / {m.net.send[l]}");
  assert_eq(str(at(nth(at(v, "params"), 0), "name")), "payload");
  assert_eq(str(at(v, "doc")), "Writes under the resource its caller fills.");
  let text = stdout(in_memory(one(label_generic()), ["doc", "relay"]));
  assert(string_contains(text, "pub fn relay<[l]>(payload: Bytes) -> Int"), Some(text))
}

test "a name that is neither exits two with the unknown name code" {
  let r = in_memory(one(source()), ["doc", "nothing_here", "--json"]);
  assert_eq(r.code, 2);
  let v = json_of(r);
  assert(str(at(nth(at(v, "diagnostics"), 0), "code")) == "E0101", Some(shown(v)))
}
