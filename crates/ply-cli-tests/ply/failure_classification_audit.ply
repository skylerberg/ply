// Every runtime failure the language defines is the program's, reported as a red test and
// bisected as one; only what the clock stopped is left unjudged.

import harness (scratch, Ran, program, write, on_disk, said, stdout, json_of, at, path, nth, items,
                first, str, int, truth, shown, concatenated, Reached, Shelf)
import std.fs (fs)
import std.json
import std.json (Json, Null, Array, Str)
import std.string

fn tested(flags: List<String>) -> Ran / {Reached, Shelf, abort.raise} =
  on_disk(concatenated(["test", "--json"], flags))

fn green(ran: Ran) -> Unit / {abort.raise} = assert(ran.code == 0, Some(said(ran)))

// The one failure of a run with one red test, with the status its result was given.
type Sole = { failure: Json, status: String }

fn sole_failure() -> Sole / {Reached, Shelf, abort.raise} = {
  let r = tested([]);
  let v = json_of(r);
  assert(r.code == 1, Some("a run with one red test exits 1: " ++ shown(v)));
  let failures = items(at(v, "failures"));
  assert(len(failures) == 1, Some("exactly one failure: " ++ shown(v)));
  { failure: first(failures), status: str(at(nth(at(v, "results"), 0), "status")) }
}

fn assert_program_error(s: Sole, what: String) -> Unit / {abort.raise} = {
  let f = shown(s.failure);
  assert(
    at(s.failure, "defect") == json_false(),
    Some(what ++ " is the program's behaviour, not a defect in Ply: " ++ f),
  );
  assert(
    str(path(s.failure, ["diagnostic", "code"])) != "E0505",
    Some(what ++ " must not carry the internal-error code: " ++ f),
  );
  assert(s.status == "failed", Some(what ++ " is a red test, not a panic: " ++ f));
  assert(
    str(path(s.failure, ["culprit", "skipped"])) != "panicked",
    Some(what ++ " must not have bisection suppressed as a Ply defect: " ++ f),
  )
}

fn json_false() -> Json = json::Bool(false)

fn message_of(s: Sole) -> String = str(path(s.failure, ["diagnostic", "message"]))

type Case = { what: String, source: String, needle: String }

fn cases() -> List<Case> =
  [
    {
      what: "a runaway recursion",
      source: "fn spin(n: Int) -> Int = 1 + spin(n + 1)\ntest \"spins\" { assert_eq(spin(0), 0) }\n",
      needle: "recursion limit",
    },
    {
      what: "a runaway mutual recursion",
      source: "fn spin(n: Int) -> Int = 1 + spun(n + 1)\nfn spun(n: Int) -> Int = 1 + spin(n + 1)\ntest \"spins across two definitions\" { assert_eq(spin(0), 0) }\n",
      needle: "recursion limit",
    },
    {
      what: "an integer overflow",
      source: "fn grow(n: Int) -> Int = n * 4611686018427387904\ntest \"grows\" { assert_eq(grow(21), 42) }\n",
      needle: "integer overflow",
    },
    {
      what: "a division by zero",
      source: "fn div(a: Int, b: Int) -> Int / {abort.raise} = a / b\ntest \"divides\" { assert_eq(div(1, 0), 0) }\n",
      needle: "division by zero",
    },
    {
      what: "a remainder by zero",
      source: "fn rem(a: Int, b: Int) -> Int / {abort.raise} = a % b\ntest \"remainders\" { assert_eq(rem(1, 0), 0) }\n",
      needle: "by zero",
    },
    {
      what: "an explicit panic",
      source: "fn boom(n: Int) -> Int / {abort.raise} = if n > 0 { panic(\"no\") } else { 0 }\ntest \"booms\" { assert_eq(boom(1), 0) }\n",
      needle: "panic: no",
    },
    {
      what: "a runaway range",
      source: "fn big() -> List<Int> = range(0, 99999999)\ntest \"ranges\" { assert_eq(len(big()), 1) }\n",
      needle: "exceeds the limit",
    },
    {
      what: "a refutable `let` that did not match",
      source: "type Shape = Circle(Int) | Tri(Int)\nfn radius(s: Shape) -> Int / {abort.raise} = { let Circle(r) = s; r }\ntest \"unwraps\" { assert_eq(radius(Tri(2)), 2) }\n",
      needle: "did not match",
    },
    {
      what: "a failing assert_eq",
      source: "fn one() -> Int = 1\ntest \"equals\" { assert_eq(one(), 2) }\n",
      needle: "assertion failed",
    },
    // One argument written, two passed: resolution splices in `message`'s `None`.
    {
      what: "a failing assert",
      source: "fn no() -> Bool = false\ntest \"holds\" { assert(no()) }\n",
      needle: "assertion failed",
    },
    {
      what: "a failing assert carrying its message",
      source: "fn no() -> Bool = false\ntest \"holds\" { assert(no(), Some(\"the balance must be positive\")) }\n",
      needle: "assertion failed",
    },
    {
      what: "a failing assert whose message was given by name",
      source: "fn no() -> Bool = false\ntest \"holds\" { assert(no(), message: Some(\"by name\")) }\n",
      needle: "assertion failed",
    },
  ]

// Round-robin parts: each case runs to a resource limit, and a CI partition is bounded by its
// slowest test.
fn every_language_defined_runtime_failure_is_a_program_error(
  index: Int,
  of: Int,
) -> Unit / {Reached, Shelf, abort.raise} =
  fold(range(0, len(cases())), (), |u: Unit, i: Int|
    if i % of != index { u } else {
      match list_at(cases(), i) {
        None -> u,
        Some(c) -> {
          program(c.source);
          let s = sole_failure();
          assert_program_error(s, c.what);
          assert(
            string_contains(message_of(s), c.needle),
            Some(
              c.what ++ ": expected a message containing `" ++ c.needle ++ "`, got "
                ++ message_of(s),
            ),
          )
        },
      }
    })

test "every language-defined runtime failure is a program error, part 1 of 3" {
  scratch(|| { every_language_defined_runtime_failure_is_a_program_error(0, 3) })
}

test "every language-defined runtime failure is a program error, part 2 of 3" {
  scratch(|| { every_language_defined_runtime_failure_is_a_program_error(1, 3) })
}

test "every language-defined runtime failure is a program error, part 3 of 3" {
  scratch(|| { every_language_defined_runtime_failure_is_a_program_error(2, 3) })
}

test "a failure inside a handler clause body is still the program's" {
  scratch(|| {
    fold(
      [
        { needle: "panic: seeded wrong", clause: "panic(\"seeded wrong\")" },
        { needle: "division by zero", clause: "len(range(0, 4 / 0))" },
        { needle: "recursion limit", clause: "spin(1)" },
        { needle: "integer overflow", clause: "4611686018427387904 * 4" },
      ],
      (),
      |u: Unit, c: { needle: String, clause: String }| {
        program(
          "effect db { read all[t]() -> List<Int> }\nfn spin(n: Int) -> Int = 1 + spin(n + 1)\nfn rows() -> List<Int> / {db.all[users]} = db.all[users]()\ntest \"counts\" {\n  handle { assert_eq(len(rows()), 2) } with {\n    db.all[users]() -> range(0, "
            ++ c.clause
            ++ "),\n  }\n}\n",
        );
        let s = sole_failure();
        assert_program_error(s, c.needle);
        assert(
          string_contains(message_of(s), c.needle),
          Some("expected `" ++ c.needle ++ "` from the clause body, got " ++ message_of(s)),
        )
      },
    )
  })
}

fn spin() -> String =
  "fn spin(n: Int) -> Int = spin(n + 1)\ntest \"spins\" { assert_eq(spin(0), 0) }\n"

test "a loop that never ends is a program error at its step budget" {
  scratch(|| {
    program(spin());
    fold(["1000", "5000000"], (), |u: Unit, budget: String| {
      let v = json_of(tested(["--no-cache", "--steps", budget]));
      let failure = nth(at(v, "failures"), 0);
      assert(at(failure, "defect") == json_false(), Some(shown(failure)));
      assert(str(path(failure, ["diagnostic", "code"])) == "E0503", Some(shown(failure)));
      assert(str(at(nth(at(v, "results"), 0), "status")) == "failed", Some(shown(v)));
      assert(
        string_contains(
          str(path(failure, ["diagnostic", "message"])),
          "budget of " ++ budget ++ " calls",
        ),
        Some(shown(failure)),
      )
    })
  })
}

// A budget the loop cannot spend leaves the verdict to the program, and a raised budget is a
// stronger claim than a small one: the same run, counted, not timed.
test "a long computation under its step budget still passes" {
  scratch(|| {
    program(
      "fn count(n: Int, acc: Int) -> Int = if n <= 0 { acc } else { count(n - 1, acc + n) }\ntest \"counts\" { assert_eq(count(200000, 0), 20000100000) }\n",
    );
    let r = tested(["--steps", "300000"]);
    let v = json_of(r);
    assert(r.code == 0, Some(shown(v)));
    assert(int(path(v, ["summary", "passed"])) == 1, Some(shown(v)));
    assert(int(path(v, ["summary", "failed"])) == 0, Some(shown(v)))
  })
}

// The clock describes the machine, so what it stops is no verdict: it is not a failure, it is
// recorded nowhere, and the run that could not finish it does not pass.
test/nondet "a run the clock stopped is abandoned rather than judged" {
  program(spin());
  let r = tested(["--timeout", "300", "--steps", "0"]);
  let v = json_of(r);
  assert(r.code == 1, Some("an unfinished run is not ok: " ++ shown(v)));
  assert(items(at(v, "failures")) == [], Some(shown(v)));
  assert(int(path(v, ["summary", "abandoned"])) == 1, Some(shown(v)));
  assert(int(path(v, ["summary", "failed"])) == 0, Some(shown(v)));
  assert(int(path(v, ["summary", "passed"])) == 0, Some(shown(v)));
  let result = nth(at(v, "results"), 0);
  assert(str(at(result, "status")) == "abandoned", Some(shown(v)));
  assert(at(result, "cached") == Null, Some(shown(v)));
  assert(str(path(result, ["diagnostic", "code"])) == "W0612", Some(shown(v)));
  // Nothing was recorded, so the next run starts the test again rather than believing it.
  let again = json_of(tested(["--timeout", "300", "--steps", "0"]));
  assert(int(path(again, ["summary", "cached"])) == 0, Some(shown(again)));
  assert(int(path(again, ["summary", "abandoned"])) == 1, Some(shown(again)))
}

test "the recursion limit is a program error" {
  scratch(|| {
    program("fn spin(n: Int) -> Int = 1 + spin(n + 1)\ntest \"spins\" { assert_eq(spin(0), 0) }\n");
    let failure = nth(at(json_of(tested([])), "failures"), 0);
    assert(at(failure, "defect") == json_false(), Some(shown(failure)));
    assert(str(path(failure, ["diagnostic", "code"])) == "E0502", Some(shown(failure)));
    assert(
      string_contains(
        str(path(failure, ["diagnostic", "message"])),
        "recursion limit of 10000 nested calls exceeded",
      ),
      Some(shown(failure)),
    )
  })
}

// Two independent edits, one benign: only running a mixture can say which caused the failure.
fn assert_bisected_to(culprit: String, innocent: String) -> Unit / {Reached, Shelf, abort.raise} = {
  let failure = nth(at(json_of(tested([])), "failures"), 0);
  let found = at(failure, "culprit");
  assert(at(failure, "defect") == json_false(), Some(shown(failure)));
  assert(str(at(found, "verdict")) == "bisected", Some(shown(found)));
  assert(at(found, "skipped") == Null, Some(shown(found)));
  assert(at(found, "definitions") == Array([Str(culprit)]), Some(shown(found)));
  assert(
    int(path(found, ["search", "evaluated"])) > 0,
    Some("a mixture was actually run: " ++ shown(found)),
  );
  // A consumer that reads only `suspects[0]` has to get the best guess: the program's verdict marks
  // the suspects it named, and they come first.
  let suspects = items(at(failure, "suspects"));
  assert(str(at(first(suspects), "name")) == culprit, Some(shown(failure)));
  assert(truth(at(first(suspects), "culprit")), Some(shown(failure)));
  assert(
    len(
        filter(suspects, |s: Json|
          str(at(s, "name")) == innocent && at(s, "culprit") == json_false()),
      )
      > 0,
    Some("the benign edit must be present and not named: " ++ shown(failure)),
  )
}

fn recursion() -> String =
  \\fn step(n: Int) -> Int = if n <= 0 { 0 } else { step(n - 1) }
  \\
  \\fn scale(a: Int, b: Int) -> Int = (a * b) + 0
  \\
  \\fn total(a: Int, b: Int) -> Int = scale(a, b) + step(3)
  \\
  \\test "total is scaled" { assert_eq(total(2, 3), 6) }
  \\

fn edited(text: String, edits: List<{ from: String, to: String }>) -> String / {abort.raise} =
  fold(edits, text, |t: String, e: { from: String, to: String }| {
    assert(string_contains(t, e.from), Some("the fixture no longer holds `" ++ e.from ++ "`"));
    string::replace(t, e.from, e.to)
  })

test "runaway recursion introduced by an edit is bisected to the culprit" {
  scratch(|| {
    program(recursion());
    green(on_disk(["test"]));
    write(
      "m.ply",
      edited(recursion(), [
        { from: "step(n - 1)", to: "step(n + 1)" },
        { from: "(a * b) + 0", to: "0 + (a * b)" },
      ]),
    );
    assert_bisected_to("m.step", "m.scale")
  })
}

fn overflow() -> String =
  \\fn grow(n: Int) -> Int = n * 2
  \\
  \\fn shift(n: Int) -> Int = (n + 0) * 1
  \\
  \\fn total(n: Int) -> Int = shift(grow(n))
  \\
  \\test "total doubles" { assert_eq(total(21), 42) }
  \\

test "an overflow introduced by an edit is bisected to the culprit" {
  scratch(|| {
    program(overflow());
    green(on_disk(["test"]));
    write(
      "m.ply",
      edited(overflow(), [
        { from: "n * 2", to: "n * 4611686018427387904" },
        { from: "(n + 0) * 1", to: "1 * (n + 0)" },
      ]),
    );
    assert_bisected_to("m.grow", "m.shift")
  })
}

fn matching() -> String =
  \\type Shape = Circle(Int) | Square(Int) | Tri(Int)
  \\
  \\fn area(s: Shape) -> Int / {abort.raise} = { let Circle(r) = s; r * 3 }
  \\
  \\fn pick(n: Int) -> Shape = if n <= 0 { Circle(1) } else { Tri(n) }
  \\
  \\fn shift(n: Int) -> Int = n + 0
  \\
  \\fn report(n: Int) -> Int / {abort.raise} = area(pick(shift(n)))
  \\
  \\test "the picked shape has an area" { assert_eq(report(0), 3) }
  \\

test "a pattern that stops matching is bisected to the culprit" {
  scratch(|| {
    program(matching());
    green(on_disk(["test"]));
    write(
      "m.ply",
      edited(matching(), [
        { from: "if n <= 0 { Circle(1) }", to: "if n < 0 { Circle(1) }" },
        { from: "fn shift(n: Int) -> Int = n + 0", to: "fn shift(n: Int) -> Int = 0 + n" },
      ]),
    );
    assert_bisected_to("m.pick", "m.shift")
  })
}

test "a match that stops being exhaustive never reaches the runner" {
  scratch(|| {
    let exhaustive =
      \\type Shape = Circle(Int) | Square(Int) | Tri(Int)
      \\
      \\fn area(s: Shape) -> Int = match s { Circle(r) -> r * 3, Square(a) -> a * a, Tri(b) -> b }
      \\
      \\fn pick(n: Int) -> Shape = if n <= 0 { Circle(1) } else { Tri(n) }
      \\
      \\test "the picked shape has an area" { assert_eq(area(pick(1)), 1) }
      \\
    ;
    program(exhaustive);
    green(on_disk(["test"]));
    write("m.ply", edited(exhaustive, [{ from: ", Tri(b) -> b", to: "" }]));
    let r = tested([]);
    let v = json_of(r);
    assert(r.code == 2, Some(shown(v)));
    assert(str(at(nth(at(v, "diagnostics"), 0), "code")) == "E0205", Some(shown(v)));
    assert(
      at(v, "failures") == Null,
      Some("nothing ran, so there is nothing to classify: " ++ shown(v)),
    )
  })
}

test "a runaway recursion costs a sibling failure nothing" {
  scratch(|| {
    let both = recursion() ++ "\ntest \"step bottoms out\" { assert_eq(step(3), 0) }\n";
    program(both);
    green(on_disk(["test"]));
    write(
      "m.ply",
      edited(both, [
        { from: "step(n - 1)", to: "step(n + 1)" },
        { from: "(a * b) + 0", to: "0 + (a * b)" },
      ]),
    );
    let v = json_of(tested([]));
    let failures = items(at(v, "failures"));
    assert(len(failures) == 2, Some(shown(v)));
    fold(failures, (), |u: Unit, failure: Json| {
      assert(at(failure, "defect") == json_false(), Some(shown(failure)));
      assert(
        path(failure, ["culprit", "definitions"]) == Array([Str("m.step")]),
        Some("both failures have the same cause: " ++ shown(failure)),
      )
    })
  })
}

// A nondet outcome is not a function of the definition set, so a mixture's answer would be
// evidence about nothing.
test "a nondet test that hits a runtime limit is skipped as nondet" {
  scratch(|| {
    program(
      "fn spin(n: Int) -> Int = 1 + spin(n + 1)\ntest/nondet \"spins\" { assert_eq(spin(0), 0) }\n",
    );
    let s = sole_failure();
    assert_program_error(s, "a runaway recursion in a nondet test");
    assert(str(path(s.failure, ["culprit", "verdict"])) == "not_attempted", Some(shown(s.failure)));
    assert(str(path(s.failure, ["culprit", "skipped"])) == "nondet", Some(shown(s.failure)))
  })
}

test "bisect never outranks the reason a runtime limit would have given" {
  scratch(|| {
    program(recursion());
    green(on_disk(["test"]));
    write("m.ply", edited(recursion(), [{ from: "step(n - 1)", to: "step(n + 1)" }]));
    let v = json_of(tested(["--bisect", "never"]));
    let failure = nth(at(v, "failures"), 0);
    let culprit = at(failure, "culprit");
    assert(str(at(culprit, "verdict")) == "not_attempted", Some(shown(culprit)));
    assert(str(at(culprit, "skipped")) == "not_requested", Some(shown(culprit)));
    assert(int(path(culprit, ["search", "evaluated"])) == 0, Some(shown(culprit)));
    assert(at(failure, "defect") == json_false(), Some(shown(failure)))
  })
}

test "a first-ever runtime limit is skipped as never passed" {
  scratch(|| {
    program("fn spin(n: Int) -> Int = 1 + spin(n + 1)\ntest \"spins\" { assert_eq(spin(0), 0) }\n");
    let s = sole_failure();
    assert(str(path(s.failure, ["culprit", "skipped"])) == "never_passed", Some(shown(s.failure)));
    assert(
      path(s.failure, ["culprit", "definitions"]) == Array([]),
      Some("nothing was bisected, so no definition may be named: " ++ shown(s.failure)),
    )
  })
}

test "a value the call limit permits is compared rather than aborting the run" {
  scratch(|| {
    program(
      "type Chain = Nil | Link(Chain)\nfn build(n: Int) -> Chain = if n <= 0 { Nil } else { Link(build(n - 1)) }\ntest \"chains compare equal\" { assert_eq(build(9800), build(9800)) }\ntest \"a sibling still reports\" { assert_eq(1, 1) }\n",
    );
    let r = tested([]);
    let v = json_of(r);
    assert(r.code == 0, Some(shown(v)));
    assert(int(path(v, ["summary", "failed"])) == 0, Some(shown(v)));
    assert(int(path(v, ["summary", "passed"])) == 2, Some(shown(v)))
  })
}

// Only reachable by iteration: a value built by recursion is at most as deep as the recursion that
// built it.
test "a value deeper than the bound is an ordinary program error" {
  scratch(|| {
    program(
      \\type Chain = Nil | Link(Chain)
      \\
      \\fn stack(n: Int) -> Chain = fold(range(0, n), Nil, |acc, x| Link(acc))
      \\
      \\test "deep values compare" { assert_eq(stack(20000), stack(20000)) }
      \\
    );
    let r = tested([]);
    let v = json_of(r);
    assert(r.code == 1, Some(shown(v)));
    let s = {
      failure: nth(at(v, "failures"), 0),
      status: str(at(nth(at(v, "results"), 0), "status")),
    };
    assert_program_error(s, "a value deeper than the bound");
    assert(str(path(s.failure, ["diagnostic", "code"])) == "E0502", Some(shown(s.failure)));
    assert(
      string_contains(message_of(s), "recursion limit of 10000 nested values exceeded"),
      Some(shown(s.failure)),
    )
  })
}

// No recursion in the program: a chain of `+` whose tree the front end and the emitter each walk
// once per term. Nothing in the compiler bounds how deep a definition may be; a walk that would
// cross the floor of the stack it is on is given another.
test "a deeply nested expression runs rather than aborting the run" {
  scratch(|| {
    program(
      "fn deep() -> Int = 1" ++ string::repeat(" + 1", 3000)
        ++ "\ntest \"deep\" { assert_eq(deep(), 3001) }\n",
    );
    let checked = on_disk(["check"]);
    assert(checked.code == 0, Some("the front end handles this depth: " ++ stdout(checked)));
    let r = tested(["--no-cache"]);
    let v = json_of(r);
    assert(r.code == 0, Some(shown(v)));
    assert(int(path(v, ["summary", "passed"])) == 1, Some(shown(v)))
  })
}
