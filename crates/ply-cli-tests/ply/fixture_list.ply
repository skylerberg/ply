// Embedded, so a test reading them is cached until a fixture changes.
fn fixtures() -> List<{ name: String, bytes: Bytes }> = embed_dir("../../../tests/fixtures")

// The fixture `name`, a file or a directory, as a project of its own.
fn copied(name: String) -> List<Source> / {abort.raise} = {
  let file = name ++ ".ply";
  let dir = name ++ "/";
  fold(fixtures(), [], |acc: List<Source>, f: { name: String, bytes: Bytes }|
    if f.name == file { push(acc, { path: file, text: string_of_bytes(f.bytes) }) }
    else if string_starts_with(f.name, dir) {
      push(acc, {
        path: string_slice(f.name, string_len(dir), string_len(f.name)),
        text: string_of_bytes(f.bytes),
      })
    } else { acc })
}

fn listing(errors: List<Json>) -> String =
  fold(errors, "", |acc: String, d: Json| {
    let at_line = match filter(items(at(d, "labels")), |l: Json| truth(at(l, "primary"))) {
      [l, ..] ->
        " at " ++ str(at(l, "file")) ++ ":" ++ int_to_string(int(path(l, ["start", "line"]))),
      [] -> "",
    };
    acc ++ "  " ++ str(at(d, "code")) ++ " " ++ str(at(d, "message")) ++ at_line ++ "\n"
  })

// Why the fixture does not check as listed, or `""` when it does.
fn misfit(f: Listed) -> String / {Hermetic, Shipped, abort.raise, diverges} = {
  let answer = json_of(in_memory(tree(copied(f.name)), ["check", "--json"]));
  let errors = filter(items(at(answer, "diagnostics")), |d: Json|
    str(at(d, "severity")) == "error");
  let found = sort(map(errors, |d: Json| str(at(d, "code"))));
  if found == sort(f.refused) { "" } else if f.refused == [] {
    "`tests/fixtures/" ++ f.name
      ++ "` does not compile, so nothing that runs it reaches what it is for:\n"
      ++ listing(errors)
  } else {
    "`tests/fixtures/" ++ f.name ++ "` exists to be refused with exactly "
      ++ string::join(f.refused, ", ")
      ++ ":\n"
      ++ listing(errors)
  }
}

test "every fixture checks as listed" {
  let misfits = filter(map(listed(), misfit), |m: String| m != "");
  assert(misfits == [], Some(string::join(misfits, "\n")))
}

// A fixture listed nowhere is one a change can break with nothing failing.
test "every fixture is listed" {
  let present = fold(fixtures(), [], |acc: List<String>, f: { name: String, bytes: Bytes }| {
    let n = match string::split_once(f.name, "/") {
      Some(p) -> p.head,
      None -> if string_ends_with(f.name, ".ply") {
        string_slice(f.name, 0, string_len(f.name) - 4)
      } else { "" },
    };
    if n == "" || len(filter(acc, |m: String| m == n)) > 0 { acc } else { push(acc, n) }
  });
  let names = map(listed(), |f: Listed| f.name);
  let unlisted = filter(present, |n: String| len(filter(names, |m: String| m == n)) == 0);
  let gone = filter(names, |n: String| len(filter(present, |m: String| m == n)) == 0);
  assert(
    unlisted == [],
    Some(
      "these fixtures are not listed: list each with the errors `ply check` refuses it with, or none: "
        ++ string::join(unlisted, ", "),
    ),
  );
  assert(
    gone == [],
    Some(
      "these are listed, and tests/fixtures holds no such program: " ++ string::join(gone, ", "),
    ),
  )
}

// Run as its header says, `span_abandoned.ply` answers its value with two spans still open; the run
// closes them `Abandoned`, warns of both innermost first, and still exits 0, since a warning is no
// failure.
test/nondet "a run warns of the spans its entry left open and exits zero" {
  project(copied("span_abandoned"));
  let run = ["run", "--host", "--trace", "json"];
  let warning = "2 spans were still open when their task or the entry point ended: `reserving` on `orders`, `order` on `orders`";
  // The trace goes to the process's own error stream, which only a process has.
  let r = spawned(push(run, "span_abandoned.ply"), []);
  assert(r.code == 0, Some(stderr(r)));
  assert(
    match list_at(r.out, len(r.out) - 1) { Some(l) -> string_trim(l) == "3", None -> false },
    Some("the entry's value is the answer: " ++ stderr(r)),
  );
  assert(
    len(filter(r.err, |l: String| string_trim(l) == "warning: " ++ warning)) > 0,
    Some("the run says nothing of the spans it closed: " ++ stderr(r)),
  );
  let closed = fold(
    filter(r.err, |l: String| string_starts_with(l, "{")),
    [],
    |acc: List<String>, l: String|
      match json::parse_string(l) {
        Ok(record) -> if str(at(record, "outcome")) == "abandoned" {
          push(acc, str(at(record, "name")))
        } else { acc },
        Err(_) -> acc,
      },
  );
  assert(closed == ["reserving", "order"], Some(stderr(r)));

  let document = json_of(spawned(concat(run, ["--json", "span_abandoned.ply"]), []));
  assert(int(at(document, "exit_code")) == 0, Some(shown(document)));
  let warned = filter(items(at(document, "diagnostics")), |d: Json| str(at(d, "code")) == "W0609");
  assert(len(warned) == 1, Some(shown(document)));
  assert(str(at(first(warned), "severity")) == "warning", Some(shown(document)));
  assert(str(at(first(warned), "message")) == warning, Some(shown(document)));
  assert(
    int(path(document, ["shutdown", "spans_left_open"])) == 2,
    Some("the report counts the spans the warning names: " ++ shown(document)),
  )
}

fn tested(flags: List<String>) -> Json / {Reached, Shipped, abort.raise, diverges} =
  json_of(on_disk(concat(["test", "--json", "--no-cache"], flags)))

fn only_failure(report: Json) -> Json / {abort.raise} =
  match items(at(report, "failures")) {
    [failure] -> failure,
    _ -> panic("expected exactly one failing test: " ++ shown(report)),
  }

// The byte range of `text` in the fixture `name`, which writes it once.
type Span = { start: Int, end: Int }

fn written_in(name: String, text: String) -> Span / {abort.raise} = {
  let source = match filter(copied(name), |f: Source| f.path == name ++ ".ply") {
    [f, ..] -> bytes_of_string(f.text),
    [] -> panic("`tests/fixtures` holds no `" ++ name ++ ".ply`"),
  };
  let needle = bytes_of_string(text);
  match bytes_index_of(source, needle) {
    None -> panic("`" ++ name ++ "` writes no `" ++ text ++ "`"),
    Some(at_byte) -> match bytes_index_of_from(source, needle, at_byte + 1) {
      Some(_) -> panic("`" ++ name ++ "` writes `" ++ text ++ "` more than once"),
      None -> { start: at_byte, end: at_byte + bytes_len(needle) },
    },
  }
}

// `channel_race.ply`'s receiver counts on the first sender spawned being heard first; the search
// sends the second one first, and the race it reports is the two sends, each where it was performed.
test "the search finds the channel race between two senders" {
  scratch(|| {
    project(copied("channel_race"));
    let searched = tested([]);
    assert(int(at(searched, "exit_code")) == 1, Some(shown(searched)));
    let failure = only_failure(searched);
    assert(
      str(path(failure, ["diagnostic", "message"]))
        == "assertion failed: expected Some(1), found Some(2)",
      Some(shown(failure)),
    );
    let race = at(failure, "race");
    let sides = [at(race, "left"), at(race, "right")];
    assert(
      sort(map(sides, |s: Json| str(at(s, "task")))) == ["@1", "@2"],
      Some("the race is between the two senders: " ++ shown(race)),
    );
    fold(
      [{ task: "@1", perform: "task.send(c, 1)" }, { task: "@2", perform: "task.send(c, 2)" }],
      (),
      |u: Unit, a: { task: String, perform: String }| {
        let side = match filter(sides, |s: Json| str(at(s, "task")) == a.task) {
          [s, ..] -> s,
          [] -> panic("no side of the race is " ++ a.task ++ ": " ++ shown(race)),
        };
        assert(
          str(at(side, "access")) == "task.chan.write[#0]",
          Some("each side writes the channel: " ++ shown(race)),
        );
        let span = written_in("channel_race", a.perform);
        assert(
          int(path(side, ["span", "start"])) == span.start
            && int(path(side, ["span", "end"])) == span.end,
          Some(a.task ++ "'s side is placed at `" ++ a.perform ++ "`: " ++ shown(race)),
        )
      },
    )
  })
}

// Run end to end, `bank_race.ply`'s two transfers pass; the search moves one's balance check ahead
// of the other's debit, so both pass a check only one should. The failure names the two sides of
// that reordering, each at the perform in `transfer` that made its access, and the seed it prints
// replays it.
test "the search finds the bank race and its seed replays it" {
  scratch(|| {
    project(copied("bank_race"));
    let searched = tested([]);
    assert(int(at(searched, "exit_code")) == 1, Some(shown(searched)));
    let failure = only_failure(searched);
    assert(
      str(at(failure, "key")) == "bank_race.no account is ever overdrawn",
      Some(shown(failure)),
    );
    assert(str(path(failure, ["diagnostic", "code"])) == "E0501", Some(shown(failure)));
    assert(
      str(path(failure, ["diagnostic", "message"])) == "assertion failed: expected 0, found 1",
      Some("alice is overdrawn: " ++ shown(failure)),
    );

    let race = at(failure, "race");
    let sides = [at(race, "left"), at(race, "right")];
    assert(
      sort(map(sides, |s: Json| str(at(s, "task")))) == ["@1", "@2"],
      Some("the race is between the two transfers: " ++ shown(race)),
    );
    assert(
      sort(map(sides, |s: Json| str(at(s, "access"))))
        == ["bank_race.bank.read[accounts]", "bank_race.bank.write[accounts]"],
      Some("one transfer's balance check is reordered against the other's debit: " ++ shown(race)),
    );
    fold(
      [
        { access: "bank_race.bank.read[accounts]", perform: "bank.balance[accounts](from)" },
        {
          access: "bank_race.bank.write[accounts]",
          perform: "bank.credit[accounts](from, -amount)",
        },
      ],
      (),
      |u: Unit, a: { access: String, perform: String }| {
        let side = match filter(sides, |s: Json| str(at(s, "access")) == a.access) {
          [s, ..] -> s,
          [] -> panic("no side of the race is `" ++ a.access ++ "`: " ++ shown(race)),
        };
        assert(
          str(at(side, "definition")) == "bank_race.transfer",
          Some(
            "`" ++ a.access ++ "` is named in the definition that performed it: " ++ shown(race),
          ),
        );
        let span = written_in("bank_race", a.perform);
        assert(
          int(path(side, ["span", "start"])) == span.start
            && int(path(side, ["span", "end"])) == span.end,
          Some(
            "`" ++ a.access ++ "` is placed at `" ++ a.perform
              ++ "`, where its step first touched the accounts: "
              ++ shown(race),
          ),
        )
      },
    );

    let seed = str(at(failure, "seed"));
    assert(seed != "", Some("a failure the search found carries its seed: " ++ shown(failure)));
    let test_name = "no account is ever overdrawn";
    assert(
      str(at(failure, "replay"))
        == "ply test --seed " ++ seed ++ " --filter \"" ++ test_name ++ "\"",
      Some(shown(failure)),
    );
    let replayed = tested(["--seed", seed, "--filter", test_name]);
    assert(
      path(only_failure(replayed), ["diagnostic", "message"])
        == path(failure, ["diagnostic", "message"]),
      Some("the seed the failure printed does not replay it: " ++ shown(replayed)),
    )
  })
}
