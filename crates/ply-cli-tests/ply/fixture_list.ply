// Every program under `tests/fixtures` is listed here with the errors `ply check` refuses it with,
// and checked before anything runs it for what it is for: one that exists to be refused is refused
// with exactly those errors, and every other one checks clean. A fixture a change to the language
// breaks fails as itself, rather than as the outcome some other test is waiting for.

import harness (scratch, Source, project, in_memory, tree, on_disk, spawned, said, stderr, json_of,
                at, path, items, first, str, int, truth, shown, Hermetic, Reached, Shipped)
import std.json
import std.json (Json)
import std.list (sort, concat)
import std.string

type Listed = { name: String, refused: List<String> }

fn listed() -> List<Listed> =
  [
    { name: "ambiguous_import", refused: ["E0108"] },
    { name: "arity_mismatch", refused: ["E0202"] },
    { name: "artifact_invalid", refused: [] },
    { name: "artifact_version", refused: [] },
    { name: "assertion_failed", refused: [] },
    { name: "bank_race", refused: [] },
