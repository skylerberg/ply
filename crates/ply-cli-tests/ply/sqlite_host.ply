//! `std.sqlite` over files: a program's databases under a root the host binds, held to that root by
//! the host's confinement and by the engine's own authorizer.

import harness (Here, Ran, Spawned, project, spawned, stderr, working)
import std.fs
import std.fs (fs, Entry, Dir)
import std.list (concat, flatten, sort_by)
import std.string (join, split)

fn sqlite_program() -> String =
  \\import std.process (process)
  \\import std.sql (stmt, PInt, PText, Row)
  \\import std.string (int_of_string, join)
  \\import std.sqlite
  \\import std.sqlite (sqlite, sql, Busy, Refused, Unopened, Create, ReadOnly, ReadWrite, Limits, Options)
  \\
  \\fn roomy() -> Limits = { sql_bytes: 10000, params: 100, rows: 100000, bytes: 10000000, steps: 1000000 }
  \\
  \\fn plain() -> Options = { strict: true, busy_ms: 50, statements: 8 }
  \\
  \\fn s(text: String) -> sqlite::Bound / {sql.refused, abort.raise} = sqlite::bound(stmt(text), [])
  \\
  \\fn refusal<a | e>(go: () -> a / {sql.refused | e}) -> String / e =
  \\  match try[sql.refused] { go() } {
  \\    Ok(_) -> "ran",
  \\    Err(Busy) -> "busy",
  \\    Err(Refused(_)) -> "refused",
  \\    Err(Unopened(_)) -> "unopened",
  \\    Err(_) -> "other",
  \\  }
  \\
  \\fn names<[d]>(conn: Hold<sqlite::Connection<[d]>>) -> List<String> / {hold.read, sqlite.query[d], sql.refused, abort.raise} =
  \\  map(sqlite::query(conn, s("select name from person order by id"), roomy()), |row: Row|
  \\    sqlite::text(row, "name"))
  \\
  \\// Written, closed, opened again and read back.
  \\pub fn round_trip() -> List<String> / {sqlite.read[app], sqlite.write[app], sql.refused, abort.raise} = {
  \\  with_hold[first](sqlite::opening[app]("data.db", Create, plain()), |c| sqlite::close(c)) { conn -> {
  \\    sqlite::execute(conn, s("create table person (id integer primary key, name text not null) strict"), roomy());
  \\    sqlite::transaction(conn, || {
  \\      sqlite::execute(conn, sqlite::bound(stmt("insert into person (name) values (?1)"), [PText("Ada")]), roomy());
  \\      sqlite::execute(conn, sqlite::bound(stmt("insert into person (name) values (?1)"), [PText("Grace")]), roomy())
  \\    })
  \\  } };
  \\  with_hold[second](sqlite::opening[app]("data.db", ReadOnly, plain()), |c| sqlite::close(c)) { conn -> names(conn) }
  \\}
  \\
  \\/// What the engine itself answers a statement the reader would have refused first.
  \\fn raw(text: String) -> String / {sqlite.read[app], sqlite.write[app]} =
  \\  match sqlite.open[app]("escape.db", Create, plain()) {
  \\    Err(f) -> f.kind,
  \\    Ok(conn) -> {
  \\      let said = match sqlite.execute[app](conn, text, [], roomy()).failure {
  \\        Some(f) -> f.kind,
  \\        None -> "ran",
  \\      };
  \\      sqlite.close[app](conn);
  \\      said
  \\    },
  \\  }
  \\
  \\pub fn escapes(outside: String) -> List<String> / {sqlite.read[app], sqlite.write[app]} =
  \\  [
  \\    raw("attach database '" ++ outside ++ "/attached.db' as other"),
  \\    raw("attach database 'file:" ++ outside ++ "/uri.db?mode=rwc' as other"),
  \\    raw("vacuum into '" ++ outside ++ "/vacuumed.db'"),
  \\    raw("select readfile('" ++ outside ++ "/secret.txt')"),
  \\    raw("select writefile('" ++ outside ++ "/written.txt', 'x')"),
  \\    raw("pragma temp_store_directory = '" ++ outside ++ "'"),
  \\    raw("select load_extension('" ++ outside ++ "/evil')"),
  \\  ]
  \\
  \\pub fn opens(path: String) -> String / {sqlite.read[app], sqlite.write[app], abort.raise} =
  \\  refusal(|| with_hold[opened_at](sqlite::opening[app](path, Create, plain()), |c| sqlite::close(c)) { conn ->
  \\    sqlite::execute(conn, s("create table if not exists t (n integer) strict"), roomy()) })
  \\
  \\pub fn backs_up(path: String) -> String / {sqlite.read[app], sqlite.write[app], abort.raise} =
  \\  refusal(|| with_hold[source](sqlite::opening[app]("data.db", ReadWrite, plain()), |c| sqlite::close(c)) { conn ->
  \\    sqlite::backup(conn, path) })
  \\
  \\pub fn unbound() -> String / {sqlite.read[nowhere], sqlite.write[nowhere], abort.raise} =
  \\  refusal(|| with_hold[nowhere_db](sqlite::opening[nowhere]("x.db", Create, plain()), |c| sqlite::close(c)) { conn -> 0 })
  \\
  \\// One connection writing in a transaction, another reading and then trying to write.
  \\pub fn together() -> List<String> / {sqlite.read[app], sqlite.write[app], sql.refused, abort.raise} =
  \\  with_hold[one](sqlite::opening[app]("data.db", ReadWrite, plain()), |c| sqlite::close(c)) { one ->
  \\    with_hold[two](sqlite::opening[app]("data.db", ReadWrite, plain()), |c| sqlite::close(c)) { two -> {
  \\      let during = sqlite::transaction(one, || {
  \\        sqlite::execute(one, sqlite::bound(stmt("insert into person (name) values (?1)"), [PText("Edsger")]), roomy());
  \\        [
  \\          string_of_int(len(names(two))),
  \\          refusal(|| sqlite::execute(two, s("insert into person (name) values ('Barbara')"), roomy())),
  \\          refusal(|| sqlite::transaction(two, || 0)),
  \\          string_of_int(len(names(one))),
  \\        ]
  \\      });
  \\      push(push(during, string_of_int(len(names(two)))), refusal(|| sqlite::execute(two, s("insert into person (name) values ('Barbara')"), roomy())))
  \\    } } }
  \\
  \\fn string_of_int(n: Int) -> String = int_to_string(n)
  \\
  \\// A large answer read a page at a time, from a statement the connection keeps open between pages.
  \\pub fn folded(rows: Int) -> Int / {sqlite.read[app], sqlite.write[app], sql.refused, abort.raise} =
  \\  with_hold[folding](sqlite::opening[app]("fold.db", Create, plain()), |c| sqlite::close(c)) { conn -> {
  \\    sqlite::execute(conn, s("create table if not exists n (i integer primary key) strict"), roomy());
  \\    sqlite::execute(conn, s("delete from n"), roomy());
  \\    sqlite::execute(
  \\      conn,
  \\      sqlite::bound(
  \\        stmt("with recursive c(i) as (select 1 union all select i + 1 from c where i < ?1) insert into n select i from c"),
  \\        [PInt(rows)],
  \\      ),
  \\      roomy(),
  \\    );
  \\    sqlite::fold_rows(conn, s("select i from n order by i"), roomy(), 64, 0, |acc: Int, row: Row|
  \\      acc + sqlite::int(row, "i"))
  \\  } }
  \\
  \\// A connection its entry never closes.
  \\pub fn left_open() -> Int / {sqlite.read[app], sqlite.write[app], sql.refused, abort.raise} = {
  \\  let conn = sqlite::opening[app]("left.db", Create, plain());
  \\  with_hold[left](conn, |_: sqlite::Connection<[app]>| ()) { held -> {
  \\    sqlite::execute(held, s("create table if not exists t (n integer) strict"), roomy());
  \\    sqlite::execute(held, s("insert into t values (1)"), roomy()).rows
  \\  } }
  \\}
  \\
  \\fn asked(scenario: List<String>) -> String / {sqlite.read[app], sqlite.write[app], sqlite.read[nowhere], sqlite.write[nowhere], sql.refused, abort.raise} =
  \\  match scenario {
  \\    ["round_trip"] -> join(round_trip(), ","),
  \\    ["escapes", outside] -> join(escapes(outside), ","),
  \\    ["opens", path] -> opens(path),
  \\    ["backs_up", path] -> backs_up(path),
  \\    ["unbound"] -> unbound(),
  \\    ["together"] -> join(together(), ","),
  \\    ["folded", rows] -> match int_of_string(rows) { Some(n) -> int_to_string(folded(n)), None -> panic("rows") },
  \\    ["left_open"] -> int_to_string(left_open()),
  \\    _ -> panic("no such scenario: " ++ join(scenario, " ")),
  \\  }
  \\
  \\/// The arguments as the scenarios they spell, a `+` between two.
  \\fn scenarios(args: List<String>) -> List<List<String>> = {
  \\  let split = fold(args, { done: [], open: [] }, |s: { done: List<List<String>>, open: List<String> }, a: String|
  \\    if a == "+" { { done: push(s.done, s.open), open: [] } } else { { ..s, open: push(s.open, a) } });
  \\  push(split.done, split.open)
  \\}
  \\
  \\// A line a scenario, in the order asked.
  \\fn main() -> Unit / {process.args[proc], process.out[proc], sqlite.read[app], sqlite.write[app], sqlite.read[nowhere], sqlite.write[nowhere], abort.raise} =
  \\  fold(scenarios(process.args[proc]()), (), |u: Unit, scenario: List<String>|
  \\    process.out[proc]("answer " ++ refusal_or(|| asked(scenario))))
  \\
  \\fn refusal_or<| e>(go: () -> String / {sql.refused | e}) -> String / e =
  \\  match try[sql.refused] { go() } { Ok(said) -> said, Err(_) -> "the engine refused" }
  \\

/// The program in a working directory holding the `root` a run binds as `app`, beside an `outside`
/// no label names.
fn rooted() -> Unit / {Here, abort.raise} = {
  project([{ path: "m.ply", text: sqlite_program() }]);
  let _ = fs.create_dir[cwd]("root");
  let _ = fs.create_dir[cwd]("outside");
}

/// The program run once over `scenarios`, in turn, by a `ply` whose `app` is `root`.
fn run_of(scenarios: List<List<String>>) -> Ran / {Here, Spawned, abort.raise} =
  spawned(
    fold(
      scenarios,
      ["run", "m.ply", "--host", "--fs", "app=" ++ working() ++ "/root", "--"],
      |argv: List<String>, scenario: List<String>|
        flatten([argv, if len(argv) > 6 { ["+"] } else { [] }, scenario]),
    ),
    [],
  )

/// What each of `scenarios` answered, in one run of the program.
fn answers(scenarios: List<List<String>>) -> List<String> / {Here, Spawned, abort.raise} = {
  let r = run_of(scenarios);
  let said = fold(r.out, [], |acc: List<String>, line: String|
    if string_starts_with(line, "answer ") { push(acc, string_slice(line, 7, string_len(line))) }
    else { acc });
  assert(r.code == 0 && len(said) == len(scenarios), Some(stderr(r)));
  said
}

fn answer(scenario: List<String>) -> String / {Here, Spawned, abort.raise} =
  join(answers([scenario]), "")

/// The code of the diagnostic a run of `scenario` ended with, or none where it answered.
fn refused(scenario: List<String>) -> Option<String> / {Here, Spawned, abort.raise} = {
  let r = run_of([scenario]);
  if r.code == 0 { None } else {
    match split(stderr(r), "Error[") {
      [_, after, ..] -> Some(string_slice(after, 0, 5)),
      _ -> panic("the run failed and named no diagnostic:\n" ++ stderr(r)),
    }
  }
}

/// Every file below `dir`, by its path from it, a link to a directory among them.
fn files(dir: String) -> List<String> / {Here, abort.raise} =
  match fs.walk[cwd](dir) {
    None -> [],
    Some(entries) ->
      sort_by(
        fold(entries, [], |acc: List<String>, e: Entry|
          match e.kind {
            Dir -> acc,
            _ -> push(acc, string_slice(e.path, string_len(dir) + 1, string_len(e.path))),
          }),
        |a: String, b: String| compare(a, b) == Less,
      ),
  }

fn prefix(path: String, n: Int) -> Bytes / {Here, abort.raise} =
  match fs.read_file[cwd](path) { Some(b) -> bytes_slice(b, 0, n), None -> b"" }

fn at(path: String) -> String / {Here, abort.raise} = working() ++ "/" ++ path

/// `path`, below the working directory, as a link in `root` names it: from the link's own directory.
fn from_root(path: String) -> String / {abort.raise} =
  if string_starts_with(path, "root/") { string_slice(path, 5, string_len(path)) }
  else { "../" ++ path }

fn linked(link: String, to: String) -> Unit / {Here, abort.raise} =
  assert(fs.symlink[cwd](link, from_root(to)), Some("a link is made"))

test/nondet "a database written and closed is read back from its file" {
  rooted();
  assert_eq(answer(["round_trip"]), "Ada,Grace");
  let file = match fs.read_file[cwd]("root/data.db") { Some(b) -> b, None -> b"" };
  assert_eq(bytes_slice(file, 0, 16), b"SQLite format 3\x00");
  // Bytes 18 and 19 are the file format's write and read versions: 2 is write-ahead logging.
  assert_eq((bytes_at(file, 18), bytes_at(file, 19)), (2, 2));
  // The log stays beside a database whose last connection only read.
  assert_eq(files("root"), ["data.db", "data.db-shm", "data.db-wal"])
}

test/nondet "the engine itself refuses every way out of the root" {
  rooted();
  let _ = fs.write_file[cwd]("outside/secret.txt", b"secret");
  // Attach, attach by URI, vacuum into, readfile, writefile, a pragma, load_extension.
  assert_eq(
    answer(["escapes", at("outside")]),
    "refused,refused,refused,statement,statement,refused,statement",
  );
  assert_eq(files("outside"), ["secret.txt"]);
  assert_eq(files("root"), ["escape.db"])
}

test/nondet "a path that leaves the root is refused before anything opens" {
  rooted();
  let outside = at("outside/abs.db");
  fold(["../outside/up.db", outside, "a/../../outside/up.db"], (), |u: Unit, path: String|
    assert_eq(refused(["opens", path]), Some("E0452")));
  assert_eq(answer(["round_trip"]), "Ada,Grace");
  fold(["../outside/copy.db", outside], (), |u: Unit, path: String|
    assert_eq(refused(["backs_up", path]), Some("E0452")));
  assert_eq(refused(["unbound"]), Some("E0451"));
  assert_eq(files("outside"), [])
}

test/nondet "a database is never opened through a symbolic link" {
  rooted();
  let _ = fs.create_dir[cwd]("root/dir");
  let _ = fs.write_file[cwd]("outside/out.db", b"");
  // A link to a database inside the root, a directory that is a link, links out of the root to a
  // file and to nothing, and the journal, the write-ahead log and its index the engine would open
  // beside a database, each a link to a file outside the root.
  linked("root/link.db", "root/real.db");
  linked("root/linked", "root/dir");
  linked("root/out.db", "outside/out.db");
  linked("root/gone.db", "outside/gone.db");
  let sides = [("_wal", "-wal"), ("_journal", "-journal"), ("_shm", "-shm")];
  fold(sides, (), |u: Unit, s: (String, String)|
    match s {
      (stem, suffix) -> linked("root/side" ++ stem ++ ".db" ++ suffix, "outside/target" ++ suffix),
    });
  assert_eq(
    answers(
      concat(
        [["opens", "real.db"], ["opens", "link.db"], ["opens", "linked/new.db"]],
        map(sides, |s: (String, String)|
          match s { (stem, _) -> ["opens", "side" ++ stem ++ ".db"] }),
      ),
    ),
    ["ran", "unopened", "unopened", "unopened", "unopened", "unopened"],
  );
  fold(["out.db", "gone.db"], (), |u: Unit, leaving: String|
    assert_eq(refused(["opens", leaving]), Some("E0452")));
  fold(sides, (), |u: Unit, s: (String, String)|
    match s {
      (stem, suffix) -> {
        let target = "outside/target" ++ suffix;
        assert(!fs.exists[cwd](target), Some(target ++ " was written through the link"));
        assert(
          !fs.exists[cwd]("root/side" ++ stem ++ ".db"),
          Some("side" ++ stem ++ ".db was made"),
        )
      },
    });
  assert_eq(fs.read_file[cwd]("outside/out.db"), Some(b""));
  assert_eq(files("outside"), ["out.db"]);
  // A backup is written to a new file, never through a link already there, and a link to where
  // nothing is outside the root leaves it whether or not anything is there.
  linked("root/copy.db", "root/missing.db");
  linked("root/away.db", "outside/copied.db");
  assert_eq(answers([["round_trip"], ["backs_up", "copy.db"]]), ["Ada,Grace", "refused"]);
  assert(!fs.exists[cwd]("root/missing.db"), Some("the backup went through the link"));
  assert_eq(refused(["backs_up", "away.db"]), Some("E0452"));
  assert_eq(answer(["backs_up", "kept.db"]), "ran");
  assert_eq(files("outside"), ["out.db"]);
  assert_eq(prefix("root/kept.db", 16), b"SQLite format 3\x00")
}

// The reader's rows inside the writer's transaction, the second writer's statement and transaction,
// the writer's own rows, then the reader's rows and its write after the commit.
test/nondet "a reader sees what was committed and a second writer is busy" {
  rooted();
  assert_eq(answers([["round_trip"], ["together"]]), ["Ada,Grace", "2,busy,busy,3,3,ran"])
}

test/nondet "a fold reads a statement the connection keeps open between pages" {
  rooted();
  assert_eq(answers([["folded", "1000"], ["folded", "64"], ["folded", "1"]]), [
    "500500",
    "2080",
    "1",
  ])
}

test/nondet "a connection a run leaves open is closed when the run ends" {
  rooted();
  assert_eq(answer(["left_open"]), "1");
  // Closed, so the log was folded into the database and removed with its index.
  assert_eq(files("root"), ["left.db"]);
  assert_eq(answer(["left_open"]), "1")
}
