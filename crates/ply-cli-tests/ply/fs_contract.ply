//! Every deterministic test of this suite runs over `MemFs`, so it must answer as the disk does.

import harness (fresh, in_memory, one, json_of, codes)
import std.fs
import std.fs (fs, Entry)

fn shown_bool(b: Bool) -> String = if b { "true" } else { "false" }

fn shown_opt_int(n: Option<Int>) -> String = match n { Some(v) -> int_to_string(v), None -> "none" }

fn shown_opt_text(b: Option<Bytes>) -> String =
  match b { Some(v) -> "\"" ++ string_of_bytes_lossy(v) ++ "\"", None -> "none" }

fn shown_opt_string(s: Option<String>) -> String = match s { Some(v) -> v, None -> "none" }

fn shown_names(names: Option<List<String>>) -> String =
  match names {
    Some(ns) ->
      "[" ++ fold(ns, "", |acc: String, n: String| if acc == "" { n } else { acc ++ " " ++ n })
        ++ "]",
    None -> "none",
  }

fn shown_kind(k: fs::Kind) -> String =
  match k {
    fs::File -> "file",
    fs::Dir -> "dir",
    fs::Symlink -> "symlink",
    fs::Missing -> "missing",
  }

fn shown_entries(es: Option<List<Entry>>) -> String =
  match es {
    Some(xs) ->
      fold(xs, "", |acc: String, e: Entry|
        acc ++ (if acc == "" { "" } else { " " }) ++ e.path ++ ":" ++ shown_kind(e.kind)),
    None -> "none",
  }

fn shown_mode(m: Option<fs::Mode>) -> String =
  match m { Some(v) -> fs::mode_text(v), None -> "none" }

/// A temp name is the run's own, so only its shape is compared.
fn shown_temp(made: Option<String>, dir: String, prefix: String) -> String / {fs.kind[cwd]} =
  match made {
    Some(p) ->
      "starts " ++ shown_bool(string_starts_with(p, dir ++ "/" ++ prefix)) ++ ", "
        ++ shown_kind(fs.kind[cwd](p)),
    None -> "none",
  }

/// The disk's root is wherever the suite started, the twin's `/w`.
fn shown_canonical(p: Option<String>, tail: String) -> String =
  match p { Some(v) -> "ends " ++ shown_bool(string_ends_with(v, tail)), None -> "none" }

fn owner_only() -> fs::Mode =
  {
    owner: { read: true, write: true, execute: false },
    group: { read: false, write: false, execute: false },
    other: { read: false, write: false, execute: false },
  }

/// Under `c/`, so the scratch marker is never touched.
fn script() -> List<String> / {fs.read[cwd], fs.write[cwd]} = {
  let made = fs.create_dir[cwd]("c/a/b");
  let again = fs.create_dir[cwd]("c/a/b");
  let wrote = fs.write_file[cwd]("c/a/b/f.txt", b"hello");
  let first = fs.append[cwd]("c/log", b"ab");
  let second = fs.append[cwd]("c/log", b"cd");
  let copied = fs.copy[cwd]("c/log", "c/log2");
  let copied_dir = fs.copy[cwd]("c/a", "c/a2");
  let moved = fs.rename[cwd]("c/log2", "c/a/moved");
  let _x = fs.write_file[cwd]("c/x", b"one");
  let _y = fs.write_file[cwd]("c/y", b"two");
  let over = fs.rename[cwd]("c/x", "c/y");
  let linked = fs.symlink[cwd]("c/link", "a/b/f.txt");
  let moded = fs.set_mode[cwd]("c/a/b/f.txt", owner_only());
  let stamped = fs.set_modified[cwd]("c/a/b/f.txt", 1700000000000);
  let locked = fs.lock[cwd]("c/held.lock");
  let contended = fs.lock[cwd]("c/held.lock");
  let released = fs.unlock[cwd]("c/held.lock");
  let unheld = fs.unlock[cwd]("c/held.lock");
  let temp = fs.temp_dir[cwd]("c", "t-");
  [
    "create_dir c/a/b -> " ++ shown_bool(made),
    "create_dir c/a/b again -> " ++ shown_bool(again),
    "write_file c/a/b/f.txt -> " ++ shown_bool(wrote),
    "read_file c/a/b/f.txt -> " ++ shown_opt_text(fs.read_file[cwd]("c/a/b/f.txt")),
    "read_file c/nope -> " ++ shown_opt_text(fs.read_file[cwd]("c/nope")),
    "file_size c/a/b/f.txt -> " ++ shown_opt_int(fs.file_size[cwd]("c/a/b/f.txt")),
    "exists c/a/b/f.txt -> " ++ shown_bool(fs.exists[cwd]("c/a/b/f.txt")),
    "exists c/nope -> " ++ shown_bool(fs.exists[cwd]("c/nope")),
    "kind c/a -> " ++ shown_kind(fs.kind[cwd]("c/a")),
    "kind c/a/b/f.txt -> " ++ shown_kind(fs.kind[cwd]("c/a/b/f.txt")),
    "kind c/nope -> " ++ shown_kind(fs.kind[cwd]("c/nope")),
    "append c/log ab -> " ++ shown_opt_int(first),
    "append c/log cd -> " ++ shown_opt_int(second),
    "read_at c/log 1 2 -> " ++ shown_opt_text(fs.read_at[cwd]("c/log", 1, 2)),
    "read_at c/log 3 5 -> " ++ shown_opt_text(fs.read_at[cwd]("c/log", 3, 5)),
    "read_at c/log 9 2 -> " ++ shown_opt_text(fs.read_at[cwd]("c/log", 9, 2)),
    "copy c/log c/log2 -> " ++ shown_bool(copied),
    "copy c/a c/a2 -> " ++ shown_bool(copied_dir),
    "rename c/log2 c/a/moved -> " ++ shown_bool(moved),
    "exists c/log2 -> " ++ shown_bool(fs.exists[cwd]("c/log2")),
    "read_file c/a/moved -> " ++ shown_opt_text(fs.read_file[cwd]("c/a/moved")),
    "rename c/x over c/y -> " ++ shown_bool(over),
    "read_file c/y -> " ++ shown_opt_text(fs.read_file[cwd]("c/y")),
    "symlink c/link a/b/f.txt -> " ++ shown_bool(linked),
    "kind c/link -> " ++ shown_kind(fs.kind[cwd]("c/link")),
    "resolved c/link -> " ++ shown_kind(fs.resolved[cwd]("c/link")),
    "read_link c/link -> " ++ shown_opt_string(fs.read_link[cwd]("c/link")),
    "read_link c/log -> " ++ shown_opt_string(fs.read_link[cwd]("c/log")),
    "read_file c/link -> " ++ shown_opt_text(fs.read_file[cwd]("c/link")),
    "set_mode c/a/b/f.txt rw------- -> " ++ shown_bool(moded),
    "mode c/a/b/f.txt -> " ++ shown_mode(fs.mode[cwd]("c/a/b/f.txt")),
    "set_modified c/a/b/f.txt -> " ++ shown_bool(stamped),
    "modified_ms c/a/b/f.txt -> " ++ shown_opt_int(fs.modified_ms[cwd]("c/a/b/f.txt")),
    "lock c/held.lock -> " ++ shown_bool(locked),
    "lock c/held.lock held -> " ++ shown_bool(contended),
    "unlock c/held.lock -> " ++ shown_bool(released),
    "unlock c/held.lock again -> " ++ shown_bool(unheld),
    "temp_dir c t- -> " ++ shown_temp(temp, "c", "t-"),
    // Removed before any listing: its name is the run's own.
    "remove_tree the temp dir -> "
      ++ shown_bool(match temp { Some(p) -> fs.remove_tree[cwd](p), None -> false }),
    "canonical c/a -> " ++ shown_canonical(fs.canonical[cwd]("c/a"), "/c/a"),
    "canonical c/nope -> " ++ shown_canonical(fs.canonical[cwd]("c/nope"), "/c/nope"),
    "sync c/log -> " ++ shown_bool(fs.sync[cwd]("c/log")),
    "sync c/nope -> " ++ shown_bool(fs.sync[cwd]("c/nope")),
    "list_dir c -> " ++ shown_names(fs.list_dir[cwd]("c")),
    "list_dir c/log -> " ++ shown_names(fs.list_dir[cwd]("c/log")),
    "list_dir c/nope -> " ++ shown_names(fs.list_dir[cwd]("c/nope")),
    "walk c/a -> " ++ shown_entries(fs.walk[cwd]("c/a")),
    "walk c/log -> " ++ shown_entries(fs.walk[cwd]("c/log")),
    "remove c/y -> " ++ shown_bool(fs.remove[cwd]("c/y")),
    "remove c/a -> " ++ shown_bool(fs.remove[cwd]("c/a")),
    "remove c/nope -> " ++ shown_bool(fs.remove[cwd]("c/nope")),
    "remove_tree c -> " ++ shown_bool(fs.remove_tree[cwd]("c")),
    "exists c -> " ++ shown_bool(fs.exists[cwd]("c")),
  ]
}

fn first_difference(disk: List<String>, twin: List<String>) -> Option<String> =
  fold(range(0, max(len(disk), len(twin))), None, |found: Option<String>, i: Int|
    match found {
      Some(_) -> found,
      None -> {
        let d = match list_at(disk, i) { Some(l) -> l, None -> "(nothing)" };
        let t = match list_at(twin, i) { Some(l) -> l, None -> "(nothing)" };
        if d == t { None } else { Some("the disk answered\n  " ++ d ++ "\nand the twin\n  " ++ t) }
      },
    })

test/nondet "the filesystem's twin answers every operation as the disk does" {
  fresh();
  let disk = script();
  let twin = fs::on_mem(fs::mem_empty(), || script()).value;
  match first_difference(disk, twin) { Some(why) -> panic(why), None -> () }
}

/// A descriptor is the run's own number, so only whether there is one is compared.
fn shown_opened(o: Result<Int, fs::Refused>) -> String =
  match o {
    Ok(_) -> "open",
    Err(fs::NotFound) -> "not found",
    Err(fs::Denied) -> "denied",
    Err(fs::NotAFile) -> "not a file",
    Err(fs::Unopened) -> "unopened",
  }

fn through<| e>(o: Result<Int, fs::Refused>, f: (Int) -> String / e) -> String / e =
  match o { Ok(file) -> f(file), Err(_) -> "no descriptor" }

/// The operations on an open file, under `s/`.
fn streamed() -> List<String> / {fs.read[cwd], fs.write[cwd]} = {
  let made = fs.create_dir[cwd]("s");
  let out = fs.open[cwd]("s/f", fs::ToWrite);
  let wrote = through(out, |d: Int|
    shown_bool(fs.write_chunk[cwd](d, b"hello ") && fs.write_chunk[cwd](d, b"world")));
  let unread = through(out, |d: Int| shown_opt_text(fs.read_chunk[cwd](d, 4)));
  let closed = through(out, |d: Int| shown_bool(fs.close[cwd](d)));
  let again = through(out, |d: Int| shown_bool(fs.close[cwd](d)));
  let late = through(out, |d: Int| shown_bool(fs.write_chunk[cwd](d, b"!")));
  let more = fs.open[cwd]("s/f", fs::ToAppend);
  let appended = through(more, |d: Int|
    shown_bool(fs.write_chunk[cwd](d, b"!") && fs.close[cwd](d)));
  let source = fs.open[cwd]("s/f", fs::ToRead);
  let chunks = through(source, |d: Int|
    shown_opt_text(fs.read_chunk[cwd](d, 5)) ++ " " ++ shown_opt_text(fs.read_chunk[cwd](d, 100))
      ++ " "
      ++ shown_opt_text(fs.read_chunk[cwd](d, 100))
      ++ " "
      ++ shown_opt_text(fs.read_chunk[cwd](d, 0)));
  let unwritten = through(source, |d: Int| shown_bool(fs.write_chunk[cwd](d, b"x")));
  let shut = through(source, |d: Int| shown_bool(fs.close[cwd](d)));
  let after = through(source, |d: Int| shown_opt_text(fs.read_chunk[cwd](d, 1)));
  [
    "create_dir s -> " ++ shown_bool(made),
    "open s/f to write -> " ++ shown_opened(out),
    "write_chunk twice -> " ++ wrote,
    "read_chunk of a file open to write -> " ++ unread,
    "close -> " ++ closed,
    "close again -> " ++ again,
    "write_chunk after close -> " ++ late,
    "open s/f to append -> " ++ shown_opened(more),
    "write_chunk and close -> " ++ appended,
    "open s/f to read -> " ++ shown_opened(source),
    "read_chunk 5, 100, 100, 0 -> " ++ chunks,
    "write_chunk of a file open to read -> " ++ unwritten,
    "close -> " ++ shut,
    "read_chunk after close -> " ++ after,
    "open s/nope to read -> " ++ shown_opened(fs.open[cwd]("s/nope", fs::ToRead)),
    "open s to read -> " ++ shown_opened(fs.open[cwd]("s", fs::ToRead)),
    "open s to write -> " ++ shown_opened(fs.open[cwd]("s", fs::ToWrite)),
    "open s/no/f to write -> " ++ shown_opened(fs.open[cwd]("s/no/f", fs::ToWrite)),
    "read_file s/f -> " ++ shown_opt_text(fs.read_file[cwd]("s/f")),
    "remove_tree s -> " ++ shown_bool(fs.remove_tree[cwd]("s")),
  ]
}

test/nondet "the twin answers every operation on an open file as the disk does" {
  fresh();
  let disk = streamed();
  let twin = fs::on_mem(fs::mem_empty(), || streamed()).value;
  match first_difference(disk, twin) { Some(why) -> panic(why), None -> () }
}

fn mebibyte() -> Int = 1048576

/// One read answers at most 64 MiB (`E0453`), so this file is a mebibyte past what `read_file`
/// would answer: written and read back through a descriptor, a chunk at a time.
fn over_the_bound() -> List<String> / {fs.read[cwd], fs.write[cwd], abort.raise} = {
  let block = fold(range(0, 16), b"0123456789abcdef", |b: Bytes, i: Int| bytes_concat(b, b));
  let blocks = 65;
  let out = fs.open[cwd]("large", fs::ToWrite);
  let wrote = through(out, |d: Int|
    shown_bool(
      fold(range(0, blocks), true, |ok: Bool, i: Int| ok && fs.write_chunk[cwd](d, block))
        && fs.close[cwd](d),
    ));
  let size = fs.file_size[cwd]("large");
  let source = fs.open[cwd]("large", fs::ToRead);
  let read = through(source, |d: Int| {
    let total = iterate({ bytes: 0, chunks: 0 }, blocks + 2, |s: { bytes: Int, chunks: Int }|
      match fs.read_chunk[cwd](d, 8 * mebibyte()) {
        Some(chunk) -> if bytes_len(chunk) == 0 { Stop(s) }
        else { Continue({ bytes: s.bytes + bytes_len(chunk), chunks: s.chunks + 1 }) },
        None -> Stop(s),
      });
    let closed = fs.close[cwd](d);
    int_to_string(total.bytes) ++ " bytes in " ++ int_to_string(total.chunks) ++ " chunks, closed "
      ++ shown_bool(closed)
  });
  assert(size == Some(blocks * mebibyte()) && blocks * mebibyte() > 64 * mebibyte());
  [
    "write 65 MiB -> " ++ wrote,
    "file_size large -> " ++ shown_opt_int(size),
    "read in 8 MiB chunks -> " ++ read,
    "remove large -> " ++ shown_bool(fs.remove[cwd]("large")),
  ]
}

test/nondet "a file over the bound of one read is read in chunks, on the disk and over the twin" {
  fresh();
  let disk = over_the_bound();
  let twin = fs::on_mem(fs::mem_empty(), || over_the_bound()).value;
  assert_eq(
    list_at(disk, 2),
    Some("read in 8 MiB chunks -> 68157440 bytes in 9 chunks, closed true"),
  );
  match first_difference(disk, twin) { Some(why) -> panic(why), None -> () }
}

// A descriptor has a place in its file that every read moves, so reading through one is a write
// of its root: two under one root may not run at once, and two under two roots may.
test "two open files under one root contend, and under two roots do not" {
  let both = |row: String, other: String|
    "import std.fs (fs)\n\npub fn both(a: Int, b: Int) -> (Option<Bytes>, Option<Bytes>) / {" ++ row
      ++ "} =\n  parallel { fs.read_chunk[left](a, 1), fs.read_chunk["
      ++ other
      ++ "](b, 1) }\n";
  let checked = |source: String| codes(json_of(in_memory(one(source), ["check", "--json"])));
  assert_eq(checked(both("fs.read_chunk[left]", "left")), ["E0309"]);
  assert_eq(checked(both("fs.read_chunk[left], fs.read_chunk[right]", "right")), [])
}
