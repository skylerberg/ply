//! What a project can do to the shipped modules, and what an upgrade of them does to a project: no
//! project names a module under `std`, a project module beside a shipped one collides loudly, and a
//! compiler that ships other modules re-runs exactly what the change reached.

import harness (scratch, Ran, Source, project, write, in_memory, tree, on_disk, on_disk_shipping,
                warm_agrees, shipped_sources, said, json_of, at, items, first, str, int, shown,
                Hermetic, Reached, Shipped, assert_ok, reader_source, StdModule, std_modules)
import cli.program (is_shipped)
import cli.sources (is_compiler, is_std)
import std.json (Json)
import std.list (any)
import std.string

fn codes_of(ran: Ran) -> List<String> / {abort.raise} =
  map(items(at(json_of(ran), "diagnostics")), |d: Json| str(at(d, "code")))

fn checked(files: List<Source>) -> Ran / {Hermetic, Shipped, abort.raise, diverges} =
  in_memory(tree(files), ["check", "--json"])

/// Every definition's or declaration's hash, by its program-wide name.
fn hash_of(answer: Json, name: String) -> String / {abort.raise} =
  match filter(items(at(answer, "definitions")), |d: Json| str(at(d, "name")) == name) {
    [d, ..] -> str(at(d, "hash")),
    [] -> panic("`" ++ name ++ "` is not in the program: " ++ shown(answer)),
  }

fn test_hash(answer: Json, key: String) -> String / {abort.raise} =
  match filter(items(at(answer, "tests")), |t: Json| str(at(t, "key")) == key) {
    [t, ..] -> str(at(t, "hash")),
    [] -> panic("no test `" ++ key ++ "`: " ++ shown(answer)),
  }

fn hashed(files: List<Source>) -> Json / {Hermetic, Shipped, abort.raise, diverges} =
  json_of(in_memory(tree(files), ["hash", "--json"]))

/// Handles every atom, so its test is `det` and cacheable, which makes "did it re-run?" answerable.
fn importer() -> String =
  \\import std.net (net, drain)
  \\
  \\pub fn read_all(c: Int) -> Bytes / {net.recv[conn], diverges} = drain[conn](c, b"", 1000)
  \\
  \\test "reads to the end" {
  \\  handle { assert_eq(read_all(1), b"") } with { net.recv[conn](c, m, t) -> Some(b"") }
  \\}
  \\

test "nothing a project can name lands under the reserved root" {
  // Every one of these derives a module name at or under `std` or `compiler`.
  fold(
    [
      { rel: "std.ply", expected: "std" },
      { rel: "std/json.ply", expected: "std.json" },
      { rel: "std/net.ply", expected: "std.net" },
      { rel: "std/http/server.ply", expected: "std.http.server" },
      { rel: "compiler/front.ply", expected: "compiler.front" },
      { rel: "compiler/items.ply", expected: "compiler.items" },
      { rel: "compiler/fmt.ply", expected: "compiler.fmt" },
    ],
    (),
    |u: Unit, c: { rel: String, expected: String }| {
      let codes = codes_of(checked([{ path: c.rel, text: "pub fn f() -> Int = 1\n" }]));
      assert(
        len(filter(codes, |x: String| x == "E0133")) > 0,
        Some(
          "`" ++ c.rel ++ "` would be `" ++ c.expected ++ "` and was accepted: "
            ++ string::join(codes, ", "),
        ),
      )
    },
  );
  // Near misses keep working: reserving a prefix reserves no name that merely starts with it.
  fold(
    ["stdlib.ply", "mine/std_helpers.ply", "a/std_thing.ply", "compilers.ply"],
    (),
    |u: Unit, rel: String| {
      let r = checked([{ path: rel, text: "pub fn f() -> Int = 1\n" }]);
      assert(r.code == 0, Some("`" ++ rel ++ "` was refused: " ++ said(r)))
    },
  )
}

test "naming a file under std directly cannot smuggle it in as a std module" {
  let answer = json_of(
    in_memory(tree([{ path: "std/json.ply", text: "pub fn parse(x: Int) -> Int = x\n" }]), [
      "check",
      "std/json.ply",
      "--json",
    ]),
  );
  let own = filter(map(items(at(answer, "modules")), |m: Json| str(at(m, "name"))), |n: String|
    !is_std(n));
  assert(own == ["json"], Some("a file under `std/` became a `std` module: " ++ shown(answer)));
  assert(
    len(filter(items(at(answer, "definitions")), |d: Json| str(at(d, "name")) == "json.parse"))
      == 1,
    Some(shown(answer)),
  )
}

test "a project module named net beside std.net is a loud collision" {
  let net = {
    path: "net.ply",
    text: "pub nondet effect net { read recv[r](conn: Int, max: Int) -> Bytes }\npub fn drain(c: Int, acc: Bytes) -> Bytes / {net.read[conn]} = acc\n",
  };
  let codes = codes_of(
    checked([
      net,
      { path: "app.ply", text: "import net\nimport std.net\npub fn f() -> Int = 1\n" },
    ]),
  );
  assert(
    len(filter(codes, |c: String| c == "E0110")) > 0,
    Some("one of the two silently won: " ++ string::join(codes, ", ")),
  );
  // `as` is the escape hatch: the two `net` effects then produce atoms under different
  // program-wide names.
  let r = checked([
    net,
    {
      path: "app.ply",
      text: "import net as mine\nimport std.net\npub fn f(c: Int) -> Bytes / {mine::net.read[conn]} = mine::drain(c, b\"\")\n",
    },
  ]);
  assert(r.code == 0, Some("`as` disambiguates: " ++ said(r)));
  let f = first(
    filter(items(at(json_of(r), "definitions")), |d: Json| str(at(d, "name")) == "app.f"),
  );
  assert(
    map(items(at(f, "atoms")), str) == ["net.net.read[conn]"],
    Some("the project's effect and the shipped one are not distinct: " ++ shown(f)),
  )
}

/// A project of modules named as the compiler's modules name their siblings, each declaring what
/// the compiler's module of that name declares at another type, beside one that imports the
/// library modules the compiler serves and calls all of them.
fn namesakes() -> List<Source> =
  [
    { path: "fmt.ply", text: "pub fn fmt_source(src: Int) -> Int = src\n" },
    { path: "items.ply", text: "pub fn parse(src: Int) -> Int = src\n" },
    { path: "lexer.ply", text: "pub fn lex(src: Int) -> Int = src\n" },
    { path: "parsing.ply", text: "pub type Span = | Nowhere\npub fn span_to(a: Int) -> Int = a\n" },
    {
      path: "app.ply",
      text:
        \\import std.checker
        \\import std.json
        \\import std.syntax
        \\import fmt (fmt_source)
        \\import items (parse)
        \\import lexer (lex)
        \\import parsing (span_to)
        \\
        \\pub fn mine() -> Int = fmt_source(1) + parse(2) + lex(3) + span_to(4)
        \\
        \\pub fn formatted() -> Bytes / {abort.raise} = syntax::formatted(b"fn  f()->Int = 1\n")
        \\
        \\pub fn checked_names() -> List<String> / {abort.raise} =
        \\  match checker::check_alone([{ path: "m.ply", text: b"fn f() -> Int = 1\n" }], { files: 1, bytes: 100 }) {
        \\    Ok(c) -> map(c.definitions, |d: checker::Definition| d.name),
        \\    Err(_) -> [],
        \\  }
        \\
        \\test "the shipped modules answer as they do anywhere, and the project's are its own" {
        \\  assert_eq(mine(), 10);
        \\  assert_eq(formatted(), b"fn f() -> Int = 1\n");
        \\  assert_eq(checked_names(), ["m.f"])
        \\}
        \\
    },
  ]

/// The module an `import` line names: `import std.list (at)` names `std.list`.
fn imported(line: String) -> String / {abort.raise} = {
  let rest = string_slice(line, 7, string_len(line));
  match string::split_once(rest, " ") { Some(x) -> x.head, None -> rest }
}

/// Each shipped module by its name, with the modules its `import` lines name as written.
fn shipped_imports() -> List<{ name: String, imports: List<String> }> / {Shipped, abort.raise} =
  map(shipped_sources(), |source: Source|
    {
      name: string_slice(source.path, 0, string_len(source.path) - 4),
      imports: map(
        filter(string_split(source.text, "\n"), |l: String| string_starts_with(l, "import ")),
        imported,
      ),
    })

// A shipped module's import resolves among the shipped modules alone: a project can name no module
// under `std` or `compiler` (above), and a bare import of the compiler's names its own sibling.
test "no cycle can be built between a project and the stdlib" {
  let files = namesakes();
  assert_ok(in_memory(tree(files), ["test"]));
  // What each shipped definition references, as the load resolved it: none of the project's.
  let own = map(files, |f: Source| string_slice(f.path, 0, string_len(f.path) - 4) ++ ".");
  let answer = json_of(in_memory(tree(files), ["hash", "--json", "--deps"]));
  let shipped = filter(items(at(answer, "definitions")), |d: Json|
    is_shipped(str(at(d, "module"))));
  assert(len(shipped) > 0, Some("the load reached no shipped definition: " ++ shown(answer)));
  fold(shipped, (), |u: Unit, d: Json|
    fold(items(at(d, "deps")), u, |v: Unit, dep: Json|
      assert(
        !any(own, |prefix: String| string_starts_with(str(dep), prefix)),
        Some(
          "the shipped `" ++ str(at(d, "name")) ++ "` references the project's `" ++ str(dep)
            ++ "`",
        ),
      )));
  assert(
    len(filter(items(at(answer, "definitions")), |d: Json| str(at(d, "name")) == "parsing.span_to"))
      == 1,
    Some("the project's own `parsing` is not its own: " ++ shown(answer)),
  )
}

test "{m.module} imports only shipped modules" for m: StdModule in std_modules() {
  fold(
    filter(string_split(string_of_bytes(m.src), "\n"), |l: String|
      string_starts_with(l, "import ")),
    (),
    |u: Unit, l: String|
      assert(
        is_shipped(imported(l)),
        Some(
          "`" ++ m.module ++ "` imports `" ++ imported(l)
            ++ "`, which neither the library nor the compiler holds",
        ),
      ),
  )
}

/// The library modules that import the compiler's, directly or through another library module.
fn over_compiler(
  modules: List<{ name: String, imports: List<String> }>,
) -> Map<String, Bool> / {abort.raise} =
  iterate(map_new(), len(modules) + 1, |held: Map<String, Bool>| {
    let grown = fold(
      modules,
      held,
      |acc: Map<String, Bool>, m: { name: String, imports: List<String> }|
        if !is_std(m.name) || map_contains(acc, m.name) { acc }
        else if any(m.imports, |i: String| is_compiler(i) || map_contains(acc, i)) {
          map_insert(acc, m.name, true)
        } else { acc },
    );
    if map_len(grown) == map_len(held) { Stop(grown) } else { Continue(grown) }
  })

// The other half: the compiler, which the builder builds, imports no library module that reaches
// back into it, so the library may import the compiler without a cycle.
test "no module of the compiler imports a library module that imports the compiler" {
  let modules = shipped_imports();
  let over = over_compiler(modules);
  assert(
    map_contains(over, "std.syntax") && map_contains(over, "std.checker"),
    Some("the library modules over the compiler are not found, so this test holds of nothing"),
  );
  let wrong = fold(modules, [], |acc: List<String>, m: { name: String, imports: List<String> }|
    if !is_compiler(m.name) { acc } else {
      fold(m.imports, acc, |a: List<String>, i: String|
        if map_contains(over, i) { push(a, m.name ++ " imports " ++ i) } else { a })
    });
  assert(
    wrong == [],
    Some("a cycle between the compiler and the library:\n" ++ string::join(wrong, "\n")),
  )
}

test "a definition that does not import std is unmoved by one that does" {
  let pure = {
    path: "pure.ply",
    text: "pub fn add(a: Int, b: Int) -> Int = a + b\ntest \"add\" { assert_eq(add(1, 2), 3) }\n",
  };
  let before = hashed([pure]);
  let after = hashed([
    pure,
    {
      path: "uses.ply",
      text: "import std.json\nimport std.net\npub fn zero() -> json::Json = json::Null\n",
    },
  ]);
  assert_eq(hash_of(before, "pure.add"), hash_of(after, "pure.add"));
  assert(
    test_hash(before, "pure.add") == test_hash(after, "pure.add"),
    Some("a test re-runs because an unrelated module imported `std`"),
  )
}

/// `std.net` as the compiler before this one shipped it: `edit` of what this one ships.
/// A shipped module a project's load would refuse were it to read its test, which does not parse,
/// or its helper only the test calls, which does not check; its law imports `std.laws`.
fn counted() -> Source =
  {
    path: "std.counted.ply",
    text: "//! Counting.\n\nimport std.laws (agrees)\n\n/// One more.\npub fn more(x: Int) -> Int = bump(x)\n\nfn bump(x: Int) -> Int = x + 1\n\nfn twice(x: Int) -> Int = \"two\"\n\ntest \"more adds one\" {\n  assert_eq(more(twice(1)) 3)\n}\n\nlaw \"more is bump\" = agrees(more, bump)\n",
  }

test "a project's load reads no test or law of a shipped module, nor what only they reach" {
  scratch(|| {
    project([
      {
        path: "m.ply",
        text: "import std.counted\n\n/// Two more.\npub fn two_more(x: Int) -> Int = counted::more(counted::more(x))\n",
      },
    ]);
    let ran = on_disk_shipping(["check", "--json"], [counted()]);
    assert_ok(ran);
    assert_eq(map(items(at(json_of(ran), "files")), str), ["m.ply", "<std>/counted.ply"])
  })
}

fn an_older_net<| e>(edit: (String) -> String / e) -> List<Source> / {abort.raise | e} = {
  let now = string_of_bytes(embed("../../ply-std/ply/net.ply"));
  let was = edit(now);
  assert(was != now, Some("the older `std.net` is the one this binary ships"));
  [{ path: "std.net.ply", text: was }]
}

fn with_comment(text: String) -> String = text ++ "\n// what the last compiler shipped\n"

test "an upgrade that moves no definition re-runs nothing" {
  scratch(|| {
    project([{ path: "app.ply", text: importer() }]);
    assert_ok(on_disk_shipping(["test"], an_older_net(with_comment)));
    // The test the project owns is unchanged, so `ply test` selects nothing.
    let r = on_disk(["test"]);
    assert(
      string_contains(said(r), "selected 0 of 1 (1 cached)"),
      Some("an upgrade that moved no definition re-ran a test:\n" ++ said(r)),
    )
  })
}

/// What `ply test` says of the shipped modules after a run under an older `std.net` filed the cache.
fn told_after_an_older_net() -> String / {Reached, Shipped, abort.raise, diverges} = {
  assert_ok(on_disk_shipping(["test"], an_older_net(with_comment)));
  said(on_disk(["test"]))
}

test "a change to a shipped module the project reads is named, and one to any other says nothing" {
  scratch(|| {
    project([{ path: "app.ply", text: importer() }]);
    let told = told_after_an_older_net();
    assert(
      string_contains(
        told,
        "shipped modules this load reads changed since the cache was written: std.net",
      ),
      Some(told),
    )
  });
  scratch(|| {
    project([
      { path: "app.ply", text: "pub fn one() -> Int = 1\ntest \"one\" { assert_eq(one(), 1) }\n" },
    ]);
    let told = told_after_an_older_net();
    assert(!string_contains(told, "W0605"), Some(told))
  })
}

test "an upgrade that moved a definition invalidates exactly its dependents" {
  scratch(|| {
    project([
      { path: "app.ply", text: importer() },
      {
        path: "elsewhere.ply",
        text: "pub fn untouched() -> Int = 41 + 1\ntest \"untouched\" { assert_eq(untouched(), 42) }\n",
      },
    ]);
    assert_ok(
      on_disk_shipping(
        ["test"],
        an_older_net(|t: String|
          string::replace(
            t,
            "match net.recv[l](c, 4096, timeout_ms) {",
            "match net.recv[l](c, 4095, timeout_ms) {",
          )),
      ),
    );
    // A cache written under an older `std.net` may be believed for none of what it moved.
    let _ = warm_agrees("after an upgrade that moved `std.net.drain`");
    ()
  })
}

test "renaming a shipped definition moves no hash" {
  let net = string_of_bytes(embed("../../ply-std/ply/net.ply"));
  let before = hashed([
    { path: "mine.ply", text: net },
    { path: "reader.ply", text: reader_source("drain") },
  ]);
  // Renaming it, and every reference to it, across a module boundary.
  let after = hashed([
    { path: "mine.ply", text: string::replace(net, "drain", "read_to_end") },
    { path: "reader.ply", text: reader_source("read_to_end") },
  ]);
  assert(
    hash_of(before, "mine.drain") == hash_of(after, "mine.read_to_end"),
    Some("renaming a shipped definition moved its own hash"),
  );
  assert(
    hash_of(before, "reader.read_all") == hash_of(after, "reader.read_all"),
    Some("renaming a shipped definition moved a caller's hash"),
  );
  assert(
    test_hash(before, "reader.reads") == test_hash(after, "reader.reads"),
    Some("renaming a shipped definition re-selected a test"),
  )
}
