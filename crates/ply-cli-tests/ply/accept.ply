//! `main` stores every snapshot the suite reads, as its commands render them now, in the
//! repository the run lends as `repo`, and answers what each took. It is run as the suite is, from
//! a scratch directory holding the marker: `ply run` of this package with `--host`, `--fs cwd=.`,
//! `--fs abs=/`, `--fs repo=` the repository, and `--allow` each of `machine`, `tester`, `claims`,
//! `hosts` and `shipped`.

import effect_sets
import harness (Hermetic, Shipped)
import std.fs (fs)
import std.snapshot
import std.snapshot (Change)

/// Where the suite's snapshots are stored, from the repository's root.
fn dir() -> String = "crates/ply-cli-tests/ply/snapshots"

fn main() -> List<{ name: String, change: Change }> / {Hermetic, Shipped, abort.raise, diverges, fs.read_file[repo], fs.create_dir[repo], fs.write_file[repo], snapshot::snapshot.unwritten} =
  map(effect_sets::snapshots(), |name: String|
    { name: name, change: snapshot::accept[repo](dir(), name, effect_sets::rendering(name)) })
