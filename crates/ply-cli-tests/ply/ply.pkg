import std.pkg (Manifest)

// `ply` as it ships, tested from outside: each command run in memory, on a scratch directory the
// run is started in, or as a process. The program's modules answer here as `cli.*`.
fn package() -> Manifest = {
  name: "clitests",
  version: { major: 0, minor: 1, patch: 0 },
  prefix: None,
  runtime: { major: 0, minor: 16, patch: 0 },
  dependencies: [
    {
      name: "cli",
      prefix: None,
      min: { major: 0, minor: 1, patch: 0 },
      source: Path("../../ply-cli/ply"),
    },
  ],
  entry: None,
}
