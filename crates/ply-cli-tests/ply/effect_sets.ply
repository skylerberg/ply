//! `effect set`s as `ply check --types` prints them: the expansion and never the alias, wrapped at a
//! fixed column, with the alias, its uses and what a row declares beyond its body under `--explain`,
//! which also says where a body can raise.

import harness (scratch, program, in_memory, one, on_disk, said, stdout, json_of, at, nth, items,
                str, int, shown, Hermetic, Shipped)
import std.fs (MemFs)
import std.json (Json, Null, Array, Str)
import std.string

/// Two `effect set`s, an endpoint that performs less than it declares, and endpoints that write their
/// rows out.
fn service() -> String =
  \\effect store {
  \\  read  all[table]() -> List<Int>
  \\  write save[table](rows: List<Int>) -> Unit
  \\}
  \\
  \\effect set Reads = { store.read[orders], store.read[users] }
  \\
  \\effect set Web = { Reads, store.read[inventory], store.write[orders] }
  \\
  \\effect set Unused = { store.read[audit] }
  \\
  \\pub fn table() -> List<Int> = [1, 2, 3]
  \\
  \\pub fn health() -> Int = 200
  \\
  \\pub fn list_orders() -> Int / {Reads} = len(store.all[orders]())
  \\
  \\pub fn create_order() -> Int / {Web} = {
  \\  store.save[orders](push(store.all[orders](), 1));
  \\  len(store.all[inventory]())
  \\}
  \\
  \\pub fn audit() -> Int / {store.read[audit], store.write[audit]} = {
  \\  store.save[audit]([1]);
  \\  len(store.all[audit]())
  \\}
  \\

fn module_block(text: String) -> String / {abort.raise} =
  match text.split_once("\n   m ") {
    Some(p) -> String::ascii_trim_end("   m " ++ p.tail),
    None -> panic("no module heading in:\n" ++ text),
  }

fn columns(line: String) -> Int / {abort.raise} = line.code_points().len()

fn types(t: MemFs, extra: List<String>) -> String / {Hermetic, Shipped, abort.raise, diverges} = {
  let r = in_memory(t, extra.fold(["check", "--types"], List::push));
  assert(r.code == 0, Some(said(r)));
  stdout(r)
}

/// The module's block of `ply check --types` over `source`, with `extra` flags.
fn block(
  source: String,
  extra: List<String>,
) -> String / {Hermetic, Shipped, abort.raise, diverges} = module_block(types(one(source), extra))

fn service_types() -> String =
  \\   m m.ply
  \\     effect store
  \\       read all[r]() -> List<Int>
  \\       write save[r](List<Int>) -> Unit
  \\     table        : () -> List<Int>
  \\     health       : () -> Int
  \\     list_orders  : () -> Int
  \\                    / {m.store.read[orders] bounded,
  \\                       m.store.read[users] bounded}
  \\     create_order : () -> Int
  \\                    / {m.store.read[inventory] bounded,
  \\                       m.store.read[orders] bounded,
  \\                       m.store.write[orders] bounded,
  \\                       m.store.read[users] bounded}
  \\     audit        : () -> Int
  \\                    / {m.store.read[audit] bounded,
  \\                       m.store.write[audit] bounded}

test "a service's per-endpoint footprints are legible in one command" {
  assert_eq(block(service(), []), service_types())
}

test "the expansion is printed without a flag and the alias is not" {
  let text = types(one(service()), []);
  ["Web", "Reads", "Unused"].fold((), |u: Unit, alias: String|
    assert(
      !text.contains(alias),
      Some("`ply check --types` printed the alias `" ++ alias ++ "`:\n" ++ text),
    ));
  assert(text.contains("m.store.write[orders]"), Some(text))
}

// The width is fixed rather than the terminal's, because this output is diffed.
test "no signature line runs past the column it wraps at" {
  [types(one(service()), []), types(one(service()), ["--explain"])].fold(
    (),
    |u: Unit, text: String|
      text.split("\n").fold(u, |v: Unit, line: String|
        assert(columns(line) <= 80, Some(columns(line).to_string() ++ " columns: " ++ line))),
  )
}

fn service_explained() -> String =
  \\   m m.ply
  \\     effect store
  \\       read all[r]() -> List<Int>
  \\       write save[r](List<Int>) -> Unit
  \\
  \\     effect set Reads
  \\       = {m.store.read[orders], m.store.read[users]}
  \\       used by 2 definitions
  \\
  \\     effect set Web
  \\       = {m.store.read[inventory], m.store.read[orders], m.store.write[orders],
  \\          m.store.read[users]}
  \\       used by 1 definition
  \\
  \\     effect set Unused
  \\       = {m.store.read[audit]}
  \\       used by 0 definitions
  \\
  \\     table        : () -> List<Int>
  \\     health       : () -> Int
  \\     list_orders  : () -> Int
  \\                    / {m.store.read[orders] bounded,
  \\                       m.store.read[users] bounded}
  \\       written as     / {Reads}
  \\       body performs  {m.store.all[orders]}
  \\       declared, not performed: m.store.read[users]
  \\     create_order : () -> Int
  \\                    / {m.store.read[inventory] bounded,
  \\                       m.store.read[orders] bounded,
  \\                       m.store.write[orders] bounded,
  \\                       m.store.read[users] bounded}
  \\       written as     / {Web}
  \\       body performs  {m.store.all[inventory], m.store.all[orders],
  \\                       m.store.save[orders]}
  \\       declared, not performed: m.store.read[users]
  \\     audit        : () -> Int
  \\                    / {m.store.read[audit] bounded,
  \\                       m.store.write[audit] bounded}

test "explain prints the set table, the alias and the difference it hides" {
  assert_eq(block(service(), ["--explain"]), service_explained())
}

test "an included set counts the definitions that reach it" {
  let text = types(one(service()), ["--explain"]);
  match text.split_once("effect set Reads") {
    Some(p) ->
      assert(
        p.tail.contains("used by 2 definitions"),
        Some("`Reads` is named by `list_orders` and reached through `Web`:\n" ++ text),
      ),
    None -> panic("the block is there:\n" ++ text),
  }
}

// Two runs over one tree, so the block is a function of the program and of nothing a run keeps.
test "explain prints the same bytes on every run" {
  scratch(|| {
    program(service());
    let typed = || {
      let r = on_disk(["check", "--types", "--explain"]);
      assert(r.code == 0, Some(said(r)));
      module_block(stdout(r))
    };
    assert_eq(typed(), typed())
  })
}

fn json_types(t: MemFs, extra: List<String>) -> Json / {Hermetic, Shipped, abort.raise, diverges} =
  json_of(in_memory(t, extra.fold(["check", "--json"], List::push)))

test "the JSON report carries the provenance only under explain" {
  let plain = json_types(one(service()), []);
  assert(at(nth(at(plain, "modules"), 0), "effect_sets") == Null, Some(shown(plain)));
  assert(at(nth(at(plain, "definitions"), 0), "written_as") == Null, Some(shown(plain)));

  let explained = json_types(one(service()), ["--explain"]);
  let sets = items(at(nth(at(explained, "modules"), 0), "effect_sets"));
  assert(
    sets.map(|s: Json| str(at(s, "name"))) == ["Reads", "Web", "Unused"],
    Some(shown(explained)),
  );
  assert(int(at(nth(Array(sets), 0), "used_by")) == 2, Some(shown(explained)));
  assert(
    at(nth(Array(sets), 0), "expansion")
      == Array([Str("m.store.read[orders]"), Str("m.store.read[users]")]),
    Some(shown(explained)),
  );
  let orders = match items(at(explained, "definitions")).filter(|d: Json|
      str(at(d, "name")) == "m.list_orders") {
    [d, ..] -> d,
    [] -> panic("list_orders: " ++ shown(explained)),
  };
  assert(at(orders, "written_as") == Array([Str("Reads")]), Some(shown(orders)));
  assert(at(orders, "performed") == Array([Str("m.store.all[orders]")]), Some(shown(orders)));
  assert(
    at(orders, "declared_not_performed") == Array([Str("m.store.read[users]")]),
    Some(shown(orders)),
  )
}

test "the JSON provenance is the same on every run" {
  scratch(|| {
    program(service());
    let explained = || json_of(on_disk(["check", "--json", "--explain"]));
    let once = explained();
    let twice = explained();
    assert(
      at(nth(at(once, "modules"), 0), "effect_sets")
        == at(nth(at(twice, "modules"), 0), "effect_sets"),
      Some(shown(once)),
    );
    assert(at(once, "definitions") == at(twice, "definitions"), Some(shown(once)))
  })
}

/// A read a condition holds inside both of its bounds, one it holds inside neither, a caller of
/// that one which also divides, and a row naming a raise its body cannot make.
fn reads() -> String =
  \\pub fn peek(b: Bytes, i: Int) -> Int =
  \\  if i < 0 || i >= bytes_len(b) { 0 - 1 } else { bytes_at(b, i) }
  \\
  \\pub fn unguarded(b: Bytes, i: Int) -> Int / {abort.raise} = bytes_at(b, i)
  \\
  \\pub fn shared(a: Int, b: Int) -> Int / {abort.raise} = unguarded(b"", a) + a / b
  \\
  \\pub fn wide(b: Bytes) -> Int / {abort.raise} = peek(b, 0)
  \\

fn reads_explained() -> String =
  \\   m m.ply
  \\     peek      : (Bytes, Int) -> Int
  \\     unguarded : (Bytes, Int) -> Int
  \\                 / {abort.raise bounded}
  \\       raises at m.ply:4:61: `bytes_at` requires `0 <= i`, which nothing on the way shows
  \\     shared    : (Int, Int) -> Int
  \\                 / {abort.raise bounded}
  \\       raises at m.ply:6:56: calls `m.unguarded`, whose row names the raise
  \\       raises at m.ply:6:76: divides by a value nothing on the way shows is other than zero
  \\     wide      : (Bytes) -> Int
  \\                 / {abort.raise bounded}
  \\       body performs  {}
  \\       declared, not performed: abort.raise

test "explain says where a body can raise and why, and which row names a raise no body makes" {
  assert_eq(block(reads(), ["--explain"]), reads_explained())
}

test "the JSON report files each raise with its place, its kind and the clause it misses" {
  let explained = json_types(one(reads()), ["--explain"]);
  let named = |name: String|
    match items(at(explained, "definitions")).filter(|d: Json| str(at(d, "name")) == name) {
      [d, ..] -> d,
      [] -> panic(name ++ ": " ++ shown(explained)),
    };
  let raise = nth(at(named("m.unguarded"), "raises"), 0);
  assert(at(raise, "at") == Str("m.ply:4:61"), Some(shown(raise)));
  assert(at(raise, "kind") == Str("unshown"), Some(shown(raise)));
  assert(at(raise, "callee") == Str("bytes_at"), Some(shown(raise)));
  assert(at(raise, "requires") == Str("0 <= i"), Some(shown(raise)));
  assert(
    items(at(named("m.shared"), "raises")).map(|r: Json| str(at(r, "kind")))
      == ["calls", "zero_divisor"],
    Some(shown(named("m.shared"))),
  );
  assert(at(named("m.peek"), "raises") == Array([]), Some(shown(named("m.peek"))));
  assert(at(named("m.wide"), "raises") == Array([]), Some(shown(named("m.wide"))));
  assert(
    at(named("m.wide"), "declared_not_performed") == Array([Str("abort.raise")]),
    Some(shown(named("m.wide"))),
  )
}

/// A law schema and a law over it: the compiler makes a definition of the schema with the row every
/// schema has, so that any law body fits it.
fn schema() -> String =
  \\pub law schema settles<a | e>(f: (a) -> a / e) forall (x: a) { f(f(x)) == f(x) }
  \\
  \\fn clamped(n: Int) -> Int = if n < 0 { 0 } else { n }
  \\
  \\law "clamping settles" = settles(clamped)
  \\

test "a law schema's definition names no row as unperformed, since no one wrote its row" {
  let explained = json_types(one(schema()), ["--explain"]);
  match items(at(explained, "definitions")).filter(|d: Json| str(at(d, "name")) == "m.settles") {
    [d, ..] -> {
      assert(at(d, "atoms") != Array([]), Some(shown(d)));
      assert(at(d, "declared_not_performed") == Array([]), Some(shown(d)))
    },
    [] -> panic("m.settles: " ++ shown(explained)),
  }
}

// The second run takes each definition from the rows the first filed, which hold its raises.
test "a run that walks no body says what the run that walked them said of their raises" {
  scratch(|| {
    program(reads());
    let typed = || {
      let r = on_disk(["check", "--types", "--explain"]);
      assert(r.code == 0, Some(said(r)));
      module_block(stdout(r))
    };
    let walked = typed();
    assert(walked.contains("raises at "), Some(walked));
    assert_eq(walked, typed())
  })
}

test "prove explain names what an over-broad row gave up" {
  scratch(|| {
    program(
      \\effect store {
      \\  read  all[table]() -> List<Int>
      \\  write save[table](rows: List<Int>) -> Unit
      \\}
      \\
      \\effect set Web = { store.read[orders], store.read[users], store.write[orders] }
      \\
      \\pub fn count() -> Int / {Web}
      \\  ensures result >= 0
      \\  = len(store.all[orders]())
      \\
    );
    let text = stdout(on_disk(["prove", "--explain"]));
    assert(
      text.contains("frame covers, body never touches:"),
      Some("an `ensures` under a wider row must say what it gave up:\n" ++ text),
    );
    assert(text.contains("m.store.read[users]"), Some(text));
    assert(!text.contains("Web"), Some("the alias name is provenance, never the claim:\n" ++ text));
    // A row exactly its body's gives nothing up, so the line is absent rather than empty.
    program("pub fn double(x: Int) -> Int\n  ensures result >= x\n  = x + x\n");
    let tight = stdout(on_disk(["prove", "--explain"]));
    assert(!tight.contains("frame covers"), Some(tight))
  })
}
