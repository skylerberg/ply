// What an emitter built from the shelf is a function of, read off its modules' `import` lines with
// no front end, held to the modules the front end pulls for the compiler: a shipped module the
// walk missed would move no kept answer and no stamp.

import harness (compiler_tree, std_tree)
import compiler.front (pulled_by)
import compiler.resolve (Source)
import compiler.unit (emitter_texts)
import std.list (concat, sort)

type File = { name: String, bytes: Bytes }

fn modules(prefix: String, files: List<File>) -> List<Source> / {abort.raise} =
  map(filter(files, |f: File| string_ends_with(f.name, ".ply")), |f: File|
    {
      name: bytes_of_string(prefix ++ string_slice(f.name, 0, string_len(f.name) - 4)),
      src: f.bytes,
    })

fn named(sources: List<Source>) -> List<String> / {abort.raise} =
  sort(map(sources, |s: Source| string_of_bytes(s.name)))

test "the emitter's identity covers the compiler and the shipped modules the front end pulls for it" {
  let std = modules("std.", std_tree());
  let compiler = modules("compiler.", compiler_tree());
  let texts = fold(concat(std, compiler), map_new(), |acc: Map<String, Bytes>, s: Source|
    map_insert(acc, string_of_bytes(s.name), s.src));
  let walked = map_keys(emitter_texts(map_keys(texts), |n: String| map_get(texts, n)));
  let pulled = match pulled_by(modules("", compiler_tree()), std) {
    Ok(names) -> sort(map(names, |n: Bytes| string_of_bytes(n))),
    Err(_) -> panic("the compiler's imports do not resolve"),
  };
  assert_eq(filter(walked, |n: String| string_starts_with(n, "std.")), pulled);
  assert_eq(filter(walked, |n: String| string_starts_with(n, "compiler.")), named(compiler))
}
