//! The compiler's phases over the inputs under `crates/ply-cli-tests/phases` -- the parser's
//! fixtures and corpora mined from the Rust reference's tests -- and over the standard library and
//! the compiler. Each test holds what every answer must be, never a record of an earlier one.

import compiler.code
import compiler.derive
import compiler.embed (EmbedAt, want_of_key)
import compiler.front (Dump, Embedded, KnownDefRow, ShippedData, Analysed, Refused, checked_staged,
                       dump_of, rows_of, shipped_data_embeds, shipped_pulled,
                       staged_pulling_std_with)
import compiler.hash
import compiler.infer
import compiler.items
import compiler.lexer
import compiler.load (tell_viewed)
import compiler.resolve
import compiler.resolve (Source, Diag)
import compiler.rewrite
import compiler.unit (shipped)
import harness (compiler_tree, example_files, phase_files, prelude_file, std_data, std_tree)
import std.bytes
import std.list (any, concat, find, flatten, last, somes, take)
import std.show (show)
import std.string
import cli.sources (stem)

type File = { name: String, bytes: Bytes }

// --- The inputs -----------------------------------------------------------------

/// An input a phase reads alone, and a program a phase reads whole.
type Input = { name: String, src: Bytes }

type Program = { name: String, modules: List<Source> }

fn is_ply(file: File) -> Bool / {abort.raise} = string_ends_with(file.name, ".ply")

/// Each `.ply` file directly in an embedded tree, and none in a directory below it.
fn top_level(files: List<File>) -> List<File> / {abort.raise} =
  filter(files, |file: File| is_ply(file) && !string_contains(file.name, "/"))

/// Each `.ply` file directly in a tree as the module `prefix` and its stem name.
fn modules_of(files: List<File>, prefix: String) -> List<Source> / {abort.raise} =
  map(top_level(files), |file: File|
    { name: bytes_of_string(prefix ++ stem(file.name)), src: file.bytes })

fn phases_file(name: String) -> Bytes / {abort.raise} =
  match filter(phase_files(), |file: File| file.name == name) {
    [file, ..] -> file.bytes,
    [] -> panic("`crates/ply-cli-tests/phases` holds no `" ++ name ++ "`"),
  }

type Cut = { done: List<Bytes>, open: Option<List<Bytes>> }

/// A bundle's records: what follows each `%%` line up to the next, the last one's final newline
/// dropped. What comes before the first is the bundle's header.
fn bundle(text: Bytes) -> List<Bytes> / {abort.raise} = {
  let cut = fold(bytes_split(text, b"\n"), { done: [], open: None }, |c: Cut, line: Bytes|
    if line == b"%%" {
      {
        done: match c.open {
          Some(lines) -> push(c.done, bytes::join(lines, b"\n")),
          None -> c.done,
        },
        open: Some([]),
      }
    } else {
      match c.open { Some(lines) -> { done: c.done, open: Some(push(lines, line)) }, None -> c }
    });
  match cut.open {
    Some(lines) -> push(cut.done, without_final_newline(bytes::join(lines, b"\n"))),
    None -> cut.done,
  }
}

fn without_final_newline(b: Bytes) -> Bytes / {abort.raise} =
  if bytes_ends_with(b, b"\n") { bytes_slice(b, 0, bytes_len(b) - 1) } else { b }

/// A bundle's records as inputs, each named `<file>#<index>`.
fn bundled(file: String) -> List<Input> / {abort.raise} = {
  let records = bundle(phases_file(file));
  map(range(0, len(records)), |i: Int|
    {
      name: file ++ "#" ++ int_to_string(i),
      src: match list_at(records, i) { Some(r) -> r, None -> b"" },
    })
}

/// A bundle's records as programs of the one module `module`.
fn bundled_modules(file: String, module: Bytes) -> List<Program> / {abort.raise} =
  map(bundled(file), |i: Input| { name: i.name, modules: [{ name: module, src: i.src }] })

/// Programs, each after a `%%%` line, their modules split at `%%` lines, each module's first line
/// its name. What comes before the first is the bundle's header.
fn programs(file: String) -> List<Program> / {abort.raise} = {
  let chunks = match bytes_split(phases_file(file), b"\n%%%\n") { [_, ..rest] -> rest, [] -> [] };
  let found = fold(chunks, [], |acc: List<List<Source>>, chunk: Bytes| {
    let c = after_newlines(chunk);
    if string_trim(string_of_bytes_lossy(c)) == "" { acc }
    else { push(acc, map(bytes_split(c, b"\n%%\n"), module_of)) }
  });
  map(range(0, len(found)), |i: Int|
    {
      name: file ++ "#" ++ int_to_string(i),
      modules: match list_at(found, i) { Some(p) -> p, None -> [] },
    })
}

fn after_newlines(b: Bytes) -> Bytes / {abort.raise} =
  match bytes_position(b, 0, |c: Int| c != 10) {
    Some(i) -> bytes_slice(b, i, bytes_len(b)),
    None -> b"",
  }

fn module_of(m: Bytes) -> Source / {abort.raise} =
  match bytes_index_of_byte(m, 10) {
    Some(i) -> { name: trimmed(bytes_slice(m, 0, i)), src: bytes_slice(m, i + 1, bytes_len(m)) },
    None -> { name: trimmed(m), src: b"" },
  }

fn trimmed(b: Bytes) -> Bytes = bytes_of_string(string_trim(string_of_bytes_lossy(b)))

/// The mined programs, which the resolver, the checker and the hasher each read whole.
fn corpus_programs() -> List<Program> / {abort.raise} =
  flatten([
    programs("reference-programs.corpus"),
    bundled_modules("reference-checks.corpus", b"m"),
    bundled_modules("reference-hashes.corpus", b"m"),
  ])

// --- Records ----------------------------------------------------------------------

/// A dump's `;`-terminated records.
fn records(dump: Bytes) -> List<Bytes> / {abort.raise} =
  match bytes_split(dump, b";") {
    [] -> [],
    parts -> if last(parts) == Some(b"") { take(parts, len(parts) - 1) } else { parts },
  }

type Span = { start: Int, end: Int }

/// The span a record of the lexer's or the parser's dump carries: a token's and a node's lead with
/// it, a diagnostic's follows its code, and a label's follows its `=`.
fn span_of(r: Bytes) -> Option<Span> / {abort.raise} = {
  let fields = bytes_split(r, b":");
  let int_at = |k: Int|
    match list_at(fields, k) {
      Some(f) -> string::int_of_string(string_of_bytes_lossy(f)),
      None -> None,
    };
  let from = |k: Int|
    match int_at(k) {
      Some(s) -> match int_at(k + 1) { Some(e) -> Some({ start: s, end: e }), None -> None },
      None -> None,
    };
  if bytes_len(r) == 0 { None }
  else if bytes_at(r, 0) >= 48 && bytes_at(r, 0) <= 57 { from(0) }
  else if bytes_at(r, 0) == 33 { from(1) }
  else if bytes_at(r, 0) == 61 { from_label(fields) }
  else { None }
}

fn from_label(fields: List<Bytes>) -> Option<Span> / {abort.raise} =
  match fields {
    [s, e, ..] -> match string::int_of_string(
        string_of_bytes_lossy(bytes_slice(s, 1, bytes_len(s))),
      ) {
      Some(start) -> match string::int_of_string(string_of_bytes_lossy(e)) {
        Some(end) -> Some({ start: start, end: end }),
        None -> None,
      },
      None -> None,
    },
    _ -> None,
  }

/// Whether every span `dump` carries lies inside a source of `n` bytes.
fn spans_inside(dump: Bytes, n: Int) -> Bool / {abort.raise} =
  !any(records(dump), |r: Bytes|
    match span_of(r) { Some(s) -> s.start < 0 || s.start > s.end || s.end > n, None -> false })

type Walk = { end: Int, ordered: Bool, last: Bytes }

/// Whether the lexer's tokens come in order, none over another, and end with the end of the input.
/// A diagnostic's record is `start:end:!:code`.
fn tokens_in_order(dump: Bytes, n: Int) -> Bool / {abort.raise} = {
  let tokens = filter(records(dump), |r: Bytes| list_at(bytes_split(r, b":"), 2) != Some(b"!"));
  let walk = fold(tokens, { end: 0, ordered: true, last: b"" }, |w: Walk, r: Bytes|
    match span_of(r) {
      Some(s) -> { end: s.end, ordered: w.ordered && s.start >= w.end, last: r },
      None -> { ..w, ordered: false },
    });
  walk.ordered && walk.last == bytes_of_string(int_to_string(n) ++ ":" ++ int_to_string(n) ++ ":e")
}

// --- The lexer, the parser and the rewrites ------------------------------------------

type Read = { phase: String, ok: Bool }

test "the lexer, the parser and the rewrites answer every input inside its bytes" {
  let mined = bundled("reference-tests.corpus");
  assert(
    len(mined) > 700,
    Some("the mined bundle holds " ++ int_to_string(len(mined)) ++ " inputs; some have been lost"),
  );
  let fixtures = map(filter(phase_files(), is_ply), |file: File|
    { name: file.name, src: file.bytes });
  let wrong = fold(flatten([fixtures, mined]), [], |acc: List<String>, i: Input| {
    let n = bytes_len(i.src);
    let lexed = bytes_of_string(lexer::dump(i.src));
    let reads = [
      { phase: "the lexer", ok: spans_inside(lexed, n) && tokens_in_order(lexed, n) },
      { phase: "the parser", ok: spans_inside(bytes_of_string(items::dump(i.src)), n) },
      {
        phase: "the rewrites",
        ok: spans_inside(bytes_of_string(rewrite::dump_expanded(i.src)), n),
      },
    ];
    fold(reads, acc, |a: List<String>, read: Read|
      if read.ok { a } else { push(a, read.phase ++ " over " ++ i.name) })
  });
  assert(
    wrong == [],
    Some(
      "a span outside the input, or tokens out of order: " ++ string::join(take(wrong, 10), ", "),
    ),
  );
  let raised = fold(top_level(phase_files()), 0, |count: Int, file: File|
    count
      + len(
        filter(records(bytes_of_string(items::dump(file.bytes))), |r: Bytes|
          bytes_starts_with(r, b"!")),
      ));
  assert(
    raised >= 40,
    Some(
      "the fixtures raise " ++ int_to_string(raised)
        ++ " diagnostics; they exist to exercise the parser's recovery and something has stopped them reaching it",
    ),
  )
}

// --- The deriver, the resolver and the hasher ------------------------------------------

test "the deriver, the resolver and the hasher answer every program" {
  let underived = filter(bundled_modules("derive-programs.corpus", b"t"), |program: Program|
    !string_starts_with(derive::derive_dump(program.modules), "M;"));
  // Each answer opens with the count of the modules it read.
  let head = |letter: String, program: Program|
    letter ++ ";" ++ int_to_string(len(program.modules)) ++ ";";
  let unanswered = filter(corpus_programs(), |program: Program|
    !string_starts_with(resolve::resolve_dump(program.modules), head("R", program))
      || !string_starts_with(hash::hash_dump(program.modules), head("K", program)));
  let named = |ps: List<Program>|
    string::join(map(take(ps, 10), |program: Program| program.name), ", ");
  assert(underived == [], Some("the deriver did not answer " ++ named(underived)));
  assert(
    unanswered == [],
    Some("the resolver or the hasher did not answer the whole of " ++ named(unanswered)),
  )
}

// --- The checker ----------------------------------------------------------------------

/// The first record two dumps disagree on, with the run-up to it from each.
fn first_difference(walked: Bytes, seeded: Bytes) -> String / {abort.raise} = {
  let a = array_of_list(records(walked));
  let b = array_of_list(records(seeded));
  let n = max(array_len(a), array_len(b));
  match find(range(0, n), |i: Int| array_at(a, i) != array_at(b, i)) {
    None -> "every record agrees, so they differ only in trailing bytes",
    Some(i) -> {
      let around = |t: Array<Bytes>|
        string::join(
          map(range(max(0, i - 6), min(i + 8, array_len(t))), |k: Int|
            "    " ++ string_of_bytes_lossy(match array_at(t, k) { Some(r) -> r, None -> b"" })),
          "\n",
        );
      "record " ++ int_to_string(i) ++ " differs\n  walked:\n" ++ around(a) ++ "\n  seeded:\n"
        ++ around(b)
    },
  }
}

type Unlike = { name: String, dumps: infer::Dumps }

// What a definition-granular cache is built on: a program checked again from the interfaces its
// first check published answers as walking the bodies did, diagnostics included.
test "a mined program checked from its own interfaces answers as its walked bodies do" {
  let unlike = fold(corpus_programs(), None, |found: Option<Unlike>, p: Program|
    match found {
      Some(_) -> found,
      None -> {
        let dumps = infer::check_dumps(p.modules);
        if dumps.seeded == dumps.walked { None } else { Some({ name: p.name, dumps: dumps }) }
      },
    });
  match unlike {
    None -> (),
    Some(u) ->
      panic(
        u.name ++ " checks otherwise from its own interfaces:\n"
          ++ first_difference(bytes_of_string(u.dumps.walked), bytes_of_string(u.dumps.seeded)),
      ),
  }
}

/// Each module of the toolchain's tree: the standard library's under `std.`, the compiler's as its
/// own modules import one another.
fn tree_modules() -> List<Source> / {abort.raise} =
  concat(modules_of(std_tree(), "std."), modules_of(compiler_tree(), ""))

// What a load reads a module's imports from: its header alone, wherever that says all of them.
test "{string_of_bytes_lossy(s.name)}'s header holds the imports its whole parse finds" for s: Source in tree_modules(
  ) {
  match items::header(s.src) {
    None -> (),
    Some(m) -> assert_eq(m.imports, items::parse(s.src).node.imports),
  }
}

/// A program the checker is run over: a standard library module under its bare name, as no project
/// module may be named under `std`, with the data files it embeds, its imports pulled from the
/// shipped modules for what it reaches; or the compiler with what it embeds.
type Part = { name: String, modules: List<Source>, embeds: List<Embedded> }

fn parts() -> List<Part> / {abort.raise} = {
  let data: List<ShippedData> = map(std_data(), |d: File|
    { name: bytes_of_string(d.name), bytes: d.bytes });
  push(
    map(modules_of(std_tree(), "std."), |s: Source| {
      let bare = bytes_slice(s.name, 4, bytes_len(s.name));
      {
        name: string_of_bytes_lossy(s.name),
        modules: [{ name: bare, src: s.src }],
        embeds: map(shipped_data_embeds(s, data), |e: EmbedAt|
          { root: b"", module: bare, want: want_of_key(e.key), read: e.read }),
      }
    }),
    {
      name: "the compiler",
      modules: modules_of(compiler_tree(), ""),
      embeds: [
        {
          root: b"",
          module: b"prelude_source",
          want: { path: b"../prelude.ply", dir: false },
          read: Ok([{ name: b"", bytes: prelude_file() }]),
        },
      ],
    },
  )
}

fn refusal(diags: List<Diag>) -> String / {abort.raise} =
  string::join(
    map(take(diags, 10), |d: Diag|
      string_of_bytes_lossy(d.code) ++ " " ++ string_of_bytes_lossy(d.message)),
    "\n",
  )

/// The first entry two tables part at, each as `show` writes it.
fn parting<a>(table: String, walked: List<a>, seeded: List<a>) -> Option<String> / {abort.raise}
  where derivable(eq, a), derivable(show, a)
=
  if walked == seeded { None } else {
    let n = max(len(walked), len(seeded));
    let at = match find(range(0, n), |i: Int| list_at(walked, i) != list_at(seeded, i)) {
      Some(i) -> i,
      None -> n,
    };
    let shown = |row: Option<a>| {
      let s = show(row);
      if string_len(s) > 1500 { string_slice(s, 0, 1500) ++ "..." } else { s }
    };
    Some(
      table ++ " " ++ int_to_string(at) ++ "\n  walked: " ++ shown(list_at(walked, at))
        ++ "\n  seeded: "
        ++ shown(list_at(seeded, at)),
    )
  }

/// Where the answer a walk made parts from the one made from the rows that walk published.
fn partings(walked: Dump, seeded: Dump) -> List<String> / {abort.raise} =
  somes([
    parting("diagnostic", walked.diags, seeded.diags),
    parting("definition", walked.defs, seeded.defs),
    parting("test", walked.tests, seeded.tests),
    parting("law", walked.laws, seeded.laws),
    parting("effect", walked.effects, seeded.effects),
    parting("constructor", walked.ctors, seeded.ctors),
    parting("definition's rows", walked.rows.defs, seeded.rows.defs),
    parting("test's rows", walked.rows.tests, seeded.rows.tests),
    parting("root", walked.emitter_roots, seeded.emitter_roots),
    parting("body", walked.bodies, seeded.bodies),
    parting("key", walked.keys, seeded.keys),
    if walked.walked == seeded.walked { None }
    else { Some("what the emitter reads of the bodies") },
  ])

// The same seam over the toolchain's own tree, a part at a time, and through the front end as the
// CLI seeds it: the rows a load files under their check keys, handed to the next load.
test "{p.name} checked from the rows its walk published answers as the walk did" for p: Part in parts(
  ) {
  let pkgs = { root: b"", manifest: None, supplied: [] };
  let held = |name: Bytes| shipped.module(string_of_bytes_lossy(name));
  let shipping = shipped_pulled(p.modules, pkgs, map(shipped.names(), bytes_of_string), held, held);
  let staged = staged_pulling_std_with(
    p.modules,
    shipping.read,
    pkgs,
    embeds: p.embeds,
    unread: shipping.unread,
    data: shipping.data,
  );
  tell_viewed(staged.viewed, true);
  match checked_staged(staged, [], []).out {
    Refused(diags) -> panic(p.name ++ " does not check:\n" ++ refusal(diags)),
    Analysed(walk) -> {
      let rows = rows_of(walk);
      match checked_staged(staged, rows.defs, rows.tests).out {
        Refused(diags) ->
          panic(p.name ++ " does not check from the rows its walk published:\n" ++ refusal(diags)),
        Analysed(seeding) -> {
          let walked = dump_of(Analysed(walk));
          let seeded = dump_of(Analysed(seeding));
          assert(
            walked == seeded,
            Some(
              "a definition published from its rows does not answer as its walked body did:\n"
                ++ string::join(partings(walked, seeded), "\n"),
            ),
          );
          let taken = fold(seeding.checked.seeded, map_new(), |acc: Map<Bytes, Bool>, n: Bytes|
            map_insert(acc, n, true));
          assert_eq(
            filter(map(rows.defs, |r: KnownDefRow| r.name), |n: Bytes| !map_contains(taken, n)),
            [],
          );
          assert_eq(len(seeding.checked.seeded_tests), len(rows.tests))
        },
      }
    },
  }
}

// --- Effects ---------------------------------------------------------------------------------

// What this arms is the corpus, not a backend: if the last `handle` or the last `with cell` left
// the examples and the fixtures, effect work in the C backend would have nothing to be checked
// against. Counted on the lowering rather than the surface text: `with cell` reaches a `cell(` node
// its spelling does not contain, and `$` is how the lowering spells a resource a label parameter
// names.
test "the corpus still exercises every effect construct a backend has to carry" {
  let inputs = concat(top_level(example_files()), top_level(phase_files()));
  let bodies = flatten(
    map(inputs, |file: File|
      match bytes_split(bytes_of_string(code::lower_dump(file.bytes)), b"f:") {
        [_, ..rest] -> rest,
        [] -> [],
      }),
  );
  let reached = |tag: Bytes| any(bodies, |b: Bytes| bytes_index_of(b, tag) != None);
  let lost = filter([b"perform(", b"handle(", b"cell(", b"$"], |tag: Bytes| !reached(tag));
  assert(
    lost == [],
    Some(
      "no body in the corpus reaches " ++ string_of_bytes(bytes::join(lost, b", "))
        ++ " any more, so nothing checks the C backend's implementation of it",
    ),
  )
}
