//! What a program embeds, read beside the module that asks and run as the program's own: a file, a
//! directory's files below it with what a cache or a tool hides passed over, and what a shipped
//! module embeds from beside it in the binary.

import harness (Source, assert_ok, in_memory, said, tree)

test "a program runs what it embedded, a directory's hidden files passed over" {
  let ran = in_memory(
    tree([
      {
        path: "sub/m.ply",
        text: "fn one() -> Bytes = embed(\"../data.txt\")\nfn all() -> List<{ name: String, bytes: Bytes }> = embed_dir(\"files\")\n\ntest \"embedded\" {\n  assert_eq(one(), b\"hi\");\n  assert_eq(map(all(), |f: { name: String, bytes: Bytes }| f.name), [\"a.txt\", \"b.txt\", \"deeper/c.txt\"]);\n  assert_eq(map(all(), |f: { name: String, bytes: Bytes }| f.bytes), [b\"A\", b\"B\", b\"C\"])\n}\n",
      },
      { path: "data.txt", text: "hi" },
      { path: "sub/files/b.txt", text: "B" },
      { path: "sub/files/a.txt", text: "A" },
      { path: "sub/files/deeper/c.txt", text: "C" },
      { path: "sub/files/.cache/d.txt", text: "not read" },
      { path: "sub/files/.hidden", text: "not read" },
    ]),
    ["test", "--no-cache"],
  );
  assert_ok(ran);
  assert(said(ran).contains("1 passed"), Some(said(ran)))
}

// `std.oid` embeds `oid/names.txt` from beside it, which a program has no file for: the load asks
// the binary for it by name.
test "a program runs what a shipped module it imports embedded" {
  let ran = in_memory(
    tree([
      {
        path: "m.ply",
        text: "import std.oid\n\ntest \"named\" {\n  assert_eq(oid::name(oid::common_name()), Some(\"commonName\"));\n  assert_eq(oid::named(\"id-Ed25519\"), Some(oid::ed25519()))\n}\n",
      },
    ]),
    ["test", "--no-cache"],
  );
  assert_ok(ran);
  assert(said(ran).contains("1 passed"), Some(said(ran)))
}

// `std.hash.legacy` is `hash/legacy.ply` below the library, beside `std.hash`'s `hash.ply`.
test "a shipped module below the library is imported by its place, beside its parent" {
  let ran = in_memory(
    tree([
      {
        path: "m.ply",
        text: "import std.hash (sha256)\nimport std.hash.legacy (sha1)\nimport std.bytes\n\ntest \"both\" {\n  assert_eq(sha1(b\"abc\").hex_of(), \"a9993e364706816aba3e25717850c26c9cd0d89d\");\n  assert_eq(bytes_len(sha256(b\"abc\")), 32)\n}\n",
      },
    ]),
    ["test", "--no-cache"],
  );
  assert_ok(ran);
  assert(said(ran).contains("1 passed"), Some(said(ran)))
}
