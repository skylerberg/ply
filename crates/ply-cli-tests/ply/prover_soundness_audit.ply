//! No claim is proved that the program does not establish, read where a person reads it: the
//! document `ply prove --json` writes.

import harness (scratch, program, project, on_disk, said, stderr, json_of, at, path, items, str,
                int, truth, shown, Reached, Shipped, outcome_of, proved, proved_here, rules_of,
                tier_of)
import std.json (Json, Null, Str, Object, Array)
import std.string
import std.list (concat)

/// `proof.goal`'s `default_unfold_depth`: no certificate inlines deeper.
fn unfold_depth() -> Int = 3

/// The obligation whose label holds `needle`.
fn obligation(report: Json, needle: String) -> Json / {abort.raise} =
  match filter(items(at(report, "obligations")), |o: Json|
      string_contains(str(at(o, "label")), needle)) {
    [o, ..] -> o,
    [] -> panic("no obligation labelled `" ++ needle ++ "` in " ++ shown(report)),
  }

fn gap(o: Json) -> String = str(at(o, "gap"))

fn never_proved(report: Json, needle: String) -> Json / {abort.raise} = {
  let o = obligation(report, needle);
  assert(tier_of(o) != "proved", Some("`" ++ needle ++ "` came back proved: " ++ shown(o)));
  o
}

test "no false claim is ever proved" {
  scratch(|| {
    let report = proved(
      \\type Color = Red | Green | Blue
      \\type Wrap = W(Color)
      \\
      \\fn score(c: Color) -> Int = match c { Red -> 1, Green -> 2, Blue -> 3 }
      \\fn unwrapped(w: Wrap) -> Int = match w { W(Red) -> 1, _ -> 2 }
      \\fn is_red(c: Color) -> Bool = match c { Red -> true, _ -> false }
      \\
      \\// Division is uninterpreted: nothing follows from it, not even with a literal divisor.
      \\law "halving" forall (x: Int) { x / 2 * 2 == x }
      \\law "by one" forall (x: Int) { x / 1 == x }
      \\law "modulo" forall (x: Int) { x % 1 == 0 }
      \\// `x * y` with both factors symbolic is not linear arithmetic.
      \\law "square" forall (x: Int) { x * x >= x }
      \\// Two distinct uninterpreted symbols are neither provably equal nor provably distinct.
      \\law "two functions" forall (f: (Int) -> Int, g: (Int) -> Int, x: Int) { f(x) == g(x) }
      \\// A case analysis over every constructor still evaluates each arm, and one of them is 3.
      \\law "under three" forall (c: Color) { score(c) < 3 }
      \\// A nested constructor pattern is not split, so the `match` stays uninterpreted.
      \\law "always two" forall (w: Wrap) { unwrapped(w) == 2 }
      \\// `++` is uninterpreted, and congruence over it says nothing about whether it commutes.
      \\law "concat commutes" forall (s: String, t: String) { s ++ t == t ++ s }
      \\// List literals are injective in their elements, which is why this is false rather than unknown.
      \\law "one element" forall (x: Int, y: Int) { [x] == [y] }
      \\// A record is its fields, so two records agreeing on one field is not extensionality.
      \\law "half a record" forall (x: Int, y: Int) { { a: x, b: 0 } == { a: x, b: y } }
      \\// The wildcard arm is reached for two of three constructors.
      \\law "always red" forall (c: Color) { is_red(c) }
      \\
    );
    fold(
      [
        "\"halving\"",
        "\"by one\"",
        "\"modulo\"",
        "\"square\"",
        "\"two functions\"",
        "\"under three\"",
        "\"always two\"",
        "\"concat commutes\"",
        "\"one element\"",
        "\"half a record\"",
        "\"always red\"",
      ],
      (),
      |u: Unit, needle: String| {
        let o = never_proved(report, needle);
        assert(
          len(
              filter(["refuted", "property", "example", "unattempted"], |x: String|
                x == outcome_of(o)),
            )
            == 1,
          Some("`" ++ needle ++ "` came back " ++ shown(o)),
        )
      },
    )
  })
}

// Two calls to a definition that performs may answer differently, so they may not share a term.
test "an effectful call is not a function of its arguments" {
  scratch(|| {
    let o = never_proved(
      proved(
        \\effect db {
        \\  read get[r](k: Int) -> Int
        \\}
        \\
        \\fn fetch(k: Int) -> Int / {db.read[main]} = db.get[main](k)
        \\
        \\fn difference(k: Int) -> Int / {db.read[main]}
        \\  ensures result == 0
        \\= fetch(k) - fetch(k)
        \\
      ),
      "m.difference",
    );
    assert(outcome_of(o) == "unattempted", Some(shown(o)));
    assert(
      string_contains(gap(o), "no handler"),
      Some("an ensures on an effectful definition is a reported gap: " ++ shown(o)),
    )
  })
}

// A spec expression's row must be empty, so a clause cannot call an effectful definition at all.
test "a clause that performs is rejected before the prover sees it" {
  scratch(|| {
    program(
      \\effect db {
      \\  read get[r](k: Int) -> Int
      \\}
      \\
      \\fn fetch(k: Int) -> Int / {db.read[main]} = db.get[main](k)
      \\
      \\fn echo(k: Int) -> Int / {db.read[main]}
      \\  ensures result == fetch(k)
      \\= fetch(k)
      \\
    );
    let r = on_disk(["prove"]);
    assert(r.code == 2, Some("a spec may not perform an effect: " ++ said(r)));
    assert(string_contains(stderr(r), "E0417"), Some(stderr(r)))
  })
}

// An unsatisfiable guard makes `guard implies body` valid and meaningless.
test "an unsatisfiable guard is vacuous and never proved" {
  scratch(|| {
    let report = proved(
      \\law "impossible" forall (x: Int) where x > 0 && x < 0 { x == 5 }
      \\law "impossible by parity" forall (x: Int) where x % 2 == 0 && x % 2 == 1 { x == 5 }
      \\
    );
    fold(["\"impossible\"", "\"impossible by parity\""], (), |u: Unit, needle: String| {
      let o = never_proved(report, needle);
      assert(outcome_of(o) == "vacuous", Some(shown(o)));
      assert(str(at(o, "vacuity")) == "the guard admits no value", Some(shown(o)))
    });
    assert(int(at(report, "exit_code")) == 1, Some(shown(report)))
  })
}

test "a binder of an uninhabited type never carries a proof" {
  scratch(|| {
    let o = never_proved(
      proved("type Bad = Wrap(Bad)\n\nlaw \"a claim about nothing\" forall (b: Bad) { b == b }\n"),
      "a claim about nothing",
    );
    assert(outcome_of(o) == "unattempted", Some(shown(o)));
    assert(string_contains(gap(o), "can be generated for `b`"), Some(shown(o)))
  })
}

test "recursion stops the unfolding and the bound is named" {
  scratch(|| {
    let report = proved(
      \\fn sum_to(n: Int) -> Int = if n <= 0 { 0 } else { n + sum_to(n - 1) }
      \\
      \\fn twice(x: Int) -> Int = x + x
      \\
      \\law "the sum is triangular" forall (n: Int) where n > 0 && n < 1000
      \\  { sum_to(n) * 2 == n * n + n }
      \\law "twice is doubling" forall (x: Int) where x > -1000 && x < 1000
      \\  { twice(x) == 2 * x }
      \\
    );
    let _ = never_proved(report, "the sum is triangular");
    let twice = obligation(report, "twice is doubling");
    assert(tier_of(twice) == "proved", Some(shown(twice)));
    let depths = map(rules_of(twice, "unfold"), |fields: Json| int(at(fields, "depth")));
    assert(
      depths != [] && len(filter(depths, |d: Int| d < 0 || d > unfold_depth())) == 0,
      Some(shown(twice)),
    )
  })
}

/// A `simulate` region reached by two tasks, with a handler standing in for the resource, once per
/// law.
type Concurrent = { label: String, header: String, spawned: String }

fn concurrency_laws(laws: List<Concurrent>) -> String =
  fold(
    laws,
    \\effect chan {
    \\  write put[q](v: Int) -> Unit
    \\}
    \\
    \\fn worker(v: Int) -> Unit / {chan.write[q], clock.read} {
    \\  let t = clock.now();
    \\  chan.put[q](v)
    \\}
    \\
    ,
    |source: String, l: Concurrent|
      source ++ "\nlaw \"" ++ l.label ++ "\"" ++ l.header
        ++ " {\n  with_cell[q]([]) { q -> {\n    handle {\n      simulate {\n        let a = task.spawn(|| worker("
        ++ l.spawned
        ++ "));\n        let b = task.spawn(|| worker(2));\n        task.join(a);\n        task.join(b);\n        len(cell_get(q)) == 2\n      }\n    } with {\n      chan.put[q](v) -> cell_set(q, push(cell_get(q), v)),\n    }\n  } }\n}\n",
  )

/// What makes an interleaving proof one: an admitted guard, a search that ran, and a claim about one
/// program rather than a polymorphic one.
fn an_interleaving_proof(o: Json) -> Unit / {abort.raise} = {
  assert(tier_of(o) == "proved", Some(shown(o)));
  assert(truth(path(o, ["certificate", "guard_satisfiable"])), Some(shown(o)));
  assert(path(o, ["certificate", "sorts"]) == Array([]), Some(shown(o)));
  let searched = rules_of(o, "exhaustive_interleaving");
  assert(
    len(searched) == 1
      && int(at(match list_at(searched, 0) { Some(s) -> s, None -> Null }, "interleavings")) > 0,
    Some(shown(o)),
  )
}

fn points_of(o: Json) -> List<Int> =
  map(rules_of(o, "exhaustive_enumeration"), |e: Json| int(at(e, "points")))

test "a concurrency law is proved only when both domains were covered" {
  scratch(|| {
    let report = proved(
      concurrency_laws([
        { label: "two writers land twice", header: "", spawned: "1" },
        {
          label: "two writers over a flip",
          header: " forall (flip: Bool)",
          spawned: "if flip { 1 } else { 3 }",
        },
        { label: "two writers over a unit", header: " forall (u: Unit)", spawned: "1" },
      ]),
    );
    let ground = obligation(report, "two writers land twice");
    an_interleaving_proof(ground);
    assert(
      rules_of(ground, "exhaustive_enumeration") == [],
      Some(
        "a ground law has no value domain, so it names only the interleaving search: "
          ++ shown(ground),
      ),
    );
    let flipped = obligation(report, "two writers over a flip");
    an_interleaving_proof(flipped);
    assert(
      points_of(flipped) == [2],
      Some("both coverage claims have to be named: " ++ shown(flipped)),
    );
    // A one-point domain was covered too, and the certificate says which.
    let unit = obligation(report, "two writers over a unit");
    an_interleaving_proof(unit);
    assert(points_of(unit) == [1], Some(shown(unit)))
  })
}

test "an Int binder drops a concurrency law to property" {
  scratch(|| {
    project([
      {
        path: "concurrency_law_binder.ply",
        text: string_of_bytes(embed("../../../tests/fixtures/concurrency_law_binder.ply")),
      },
    ]);
    let report = proved_here([]);
    let o = obligation(report, "no interleaving");
    assert(
      tier_of(o) == "property",
      Some("exhaustive over schedules says nothing about an `Int` binder: " ++ shown(o)),
    )
  })
}

test "a sampled schedule search never proves" {
  scratch(|| {
    program(concurrency_laws([{ label: "two writers land twice", header: "", spawned: "1" }]));
    fold(
      [["--sim", "random", "--seeds", "4"], ["--seed", "7"]],
      (),
      |u: Unit, flags: List<String>| {
        let _ = never_proved(proved_here(flags), "two writers land twice");
        ()
      },
    )
  })
}

// A body that entered no `simulate` region emptied a frontier it never filled, so `exhaustive:
// true` is about nothing.
test "a search that reached no region never proves" {
  scratch(|| {
    let report = proved(
      \\effect chan {
      \\  write put[q](v: Int) -> Unit
      \\}
      \\
      \\fn worker(v: Int) -> Unit / {chan.write[q], clock.read} {
      \\  let t = clock.now();
      \\  chan.put[q](v)
      \\}
      \\
      \\law "sometimes concurrent" forall (flip: Bool) {
      \\  if flip {
      \\    with_cell[q]([]) { q -> {
      \\      handle {
      \\        simulate {
      \\          let a = task.spawn(|| worker(1));
      \\          let b = task.spawn(|| worker(2));
      \\          task.join(a);
      \\          task.join(b);
      \\          len(cell_get(q)) == 2
      \\        }
      \\      } with {
      \\        chan.put[q](v) -> cell_set(q, push(cell_get(q), v)),
      \\      }
      \\    } }
      \\  } else {
      \\    true
      \\  }
      \\}
      \\
    );
    let _ = never_proved(report, "sometimes concurrent");
    ()
  })
}

test "gap: a definition that never returns still carries a proof" {
  scratch(|| {
    let report = proved(
      \\fn spin(x: Int) -> Int / {diverges} = spin(x)
      \\
      \\fn go(x: Int) -> Int / {diverges}
      \\  ensures result == spin(x)
      \\= spin(x)
      \\
      \\law "spin is a function" forall (x: Int) { spin(x) == spin(x) }
      \\
      \\law "a divisor is a function" forall (a: Int, b: Int) { a / b == a / b }
      \\
    );
    fold(
      [
        { needle: "m.go", raised: "did not finish within its budget" },
        { needle: "spin is a function", raised: "did not finish within its budget" },
        { needle: "a divisor is a function", raised: "division by zero" },
      ],
      (),
      |u: Unit, c: { needle: String, raised: String }| {
        let o = never_proved(report, c.needle);
        assert(
          outcome_of(o) == "unattempted",
          Some(
            "`" ++ c.needle ++ "` is a theorem about a total symbol and not about this program: "
              ++ shown(o),
          ),
        );
        assert(
          string_starts_with(gap(o), "raised: ") && string_contains(gap(o), c.raised),
          Some("`" ++ c.needle ++ "` is a gap because the program ran and raised: " ++ shown(o)),
        )
      },
    );
    // Nothing is covered, which is the half a reviewer reads: coverage counts only a claim that
    // holds.
    assert(int(path(report, ["coverage", "covered"])) == 0, Some(shown(report)))
  })
}

test "gap: a guard outside the generator's range is still decided" {
  scratch(|| {
    let o = obligation(
      proved(
        "law \"a narrow window\" forall (x: Int) where x > 1000000 && x < 1000010 { x > 0 }\n",
      ),
      "a narrow window",
    );
    assert(
      tier_of(o) == "proved",
      Some("the guard admits nine values and the body is decided over all of them: " ++ shown(o)),
    )
  })
}

// `==` on `Float` is not reflexive, so congruence closure over it is unsound.
test "no obligation that can reach a Float is proved" {
  scratch(|| {
    let report = proved(
      \\type Rate = Float
      \\type Box<a> = B(a)
      \\type Money = Cents(Float)
      \\type Row = R({rate: Float})
      \\
      \\law "visible binder" forall (x: Float) { x == x }
      \\law "visible literal" forall (n: Int) { 1.5 == 1.5 }
      \\law "visible container" forall (xs: List<Float>) { xs == xs }
      \\law "visible map" forall (m: Map<String, Float>) { m == m }
      \\law "visible alias" forall (r: Rate) { r == r }
      \\law "visible parameter" forall (b: Box<Float>) { b == b }
      \\// These reach a `Float` through a declaration rather than the binder's written type.
      \\law "hidden in a variant" forall (m: Money) { m == m }
      \\law "hidden in a record type" forall (r: Row) { r == r }
      \\law "hidden behind a list" forall (xs: List<Money>) { xs == xs }
      \\law "hidden behind an option" forall (o: Option<Money>) { o == o }
      \\
    );
    let over_claimed = map(
      filter(items(at(report, "obligations")), |o: Json| tier_of(o) == "proved"),
      |o: Json| str(at(o, "label")),
    );
    assert(
      over_claimed == [],
      Some(
        "these obligations mention a `Float` and came back proved: "
          ++ string::join(over_claimed, ", "),
      ),
    );
    assert(int(path(report, ["summary", "obligations"])) == 10, Some(shown(report)))
  })
}

test "an ensures over a hidden Float is not proved" {
  scratch(|| {
    let report = proved(
      "pub type Money = Cents(Float)\npub fn keep(m: Money) -> Money\n  ensures result == m\n= m\nlaw \"destructured\" forall (m: Money) { match m { Cents(x) -> x == x } }\n",
    );
    let _ = never_proved(report, "m.keep");
    let _ = never_proved(report, "destructured");
    ()
  })
}

// `Decimal`'s `==` is an equivalence relation, so congruence over it is sound.
test "decimal is congruent and never arithmetic" {
  scratch(|| {
    let report = proved(
      "fn scaled(d: Decimal) -> Decimal = d\nlaw \"congruence\" forall (x: Decimal) { scaled(x) == scaled(x) }\nlaw \"additive\" forall (x: Decimal) { x + 0m == x }\nlaw \"commutes\" forall (x: Decimal, y: Decimal) { x + y == y + x }\nlaw \"ordered\" forall (x: Decimal) { x >= x }\nlaw \"scale is value\" forall (n: Int) { 1.5m == 1.50m }\n",
    );
    fold(["\"congruence\"", "\"scale is value\""], (), |u: Unit, needle: String| {
      let o = obligation(report, needle);
      assert(tier_of(o) == "proved", Some(shown(o)))
    });
    fold(["\"additive\"", "\"commutes\"", "\"ordered\""], (), |u: Unit, needle: String| {
      let _ = never_proved(report, needle);
      ()
    })
  })
}

// There is no theory of arrays: nothing about `map_get` after `map_insert`, or about `map_len`,
// may be concluded.
test "a map is opaque to the prover" {
  scratch(|| {
    let report = proved(
      "law \"reflexive\" forall (m: Map<String, Int>) { m == m }\nlaw \"get after insert\" forall (m: Map<String, Int>, k: String, v: Int) { map_get(map_insert(m, k, v), k) == Some(v) }\nlaw \"insert grows\" forall (m: Map<String, Int>, k: String, v: Int) { map_len(map_insert(m, k, v)) == map_len(m) + 1 }\nlaw \"keys match len\" forall (m: Map<String, Int>) { len(map_keys(m)) == map_len(m) }\n",
    );
    assert(tier_of(obligation(report, "\"reflexive\"")) == "proved", Some(shown(report)));
    fold(["get after insert", "insert grows", "keys match len"], (), |u: Unit, needle: String| {
      let _ = never_proved(report, needle);
      ()
    })
  })
}

// Two occurrences of one `Bytes` literal are deliberately not one term, so even the last is not
// proved.
test "the byte builtins are uninterpreted" {
  scratch(|| {
    let report = proved(
      "law \"index of self\" forall (b: Bytes) { bytes_index_of(b, b) == Some(0) }\nlaw \"empty needle\" forall (b: Bytes) { bytes_index_of(b, b\"\") == Some(0) }\nlaw \"starts with itself\" forall (b: Bytes) { bytes_starts_with(b, b) }\nlaw \"scan is bounded\" forall (b: Bytes, f: Int, s: Bytes, m: Int) { bytes_scan(b, f, s, m) <= f + m }\nlaw \"split rejoins\" forall (b: Bytes) { len(bytes_split(b, b\",\")) >= 1 }\nlaw \"two literals\" forall (n: Int) { b\"ab\" == b\"ab\" }\n",
    );
    fold(
      [
        "index of self",
        "empty needle",
        "starts with itself",
        "scan is bounded",
        "split rejoins",
        "two literals",
      ],
      (),
      |u: Unit, needle: String| {
        let _ = never_proved(report, needle);
        ()
      },
    )
  })
}

// A derived dictionary is an ordinary record of closures, outside the fragment.
test "a derived dictionary carries no proof" {
  scratch(|| {
    let report = proved(
      "pub type Point = P(Int)\nderive eq for Point\nderive ord for Point\nlaw \"eq is reflexive\" forall (p: Point) { (point_eq().eq)(p, p) }\nlaw \"ord is reflexive\" forall (p: Point) { (point_ord().compare)(p, p) == Equal }\n",
    );
    fold(["eq is reflexive", "ord is reflexive"], (), |u: Unit, needle: String| {
      let _ = never_proved(report, needle);
      ()
    })
  })
}
