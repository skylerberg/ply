// `ply test --coverage` and `--mutate`: what no test reaches, and what the tests would let through.

import harness (on_disk, program, read, json_of, at, path, nth, items, str, int, shown, first)
import std.fs (fs)
import std.json (Json)

fn source() -> String =
  \\fn add(a: Int, b: Int) -> Int = a + b
  \\fn clamp(n: Int) -> Int = if n < 0 { 0 } else { n }
  \\fn unused(n: Int) -> Int = n * 2 + 0
  \\test "add adds" { assert_eq(add(2, 3), 5); assert_eq(add(0, 1), 1) }
  \\test "clamp keeps a positive" { assert_eq(clamp(5), 5); assert_eq(clamp(-3), 0) }
  \\

fn texts(j: Json) -> List<String> = map(items(j), str)

test/nondet "coverage names the definitions no test reaches" {
  program(source());
  let v = json_of(on_disk(["test", "--coverage", "--json"]));
  assert(int(at(v, "exit_code")) == 0, Some(shown(v)));
  assert_eq(texts(path(v, ["coverage", "unreached"])), ["m.unused"]);
  let add = filter(items(path(v, ["coverage", "definitions"])), |d: Json|
    str(at(d, "name")) == "m.add");
  assert_eq(texts(at(first(add), "reached_by")), ["m.add adds"])
}

test/nondet "a mutant the tests let through survives and fails the run" {
  program(source());
  let r = on_disk(["test", "--mutate", "clamp", "--json"]);
  let v = json_of(r);
  let m = at(v, "mutants");
  assert(int(at(m, "definitions")) == 1, Some(shown(m)));
  assert(int(at(m, "killed")) >= 1, Some(shown(m)));
  assert(int(at(m, "survived")) >= 1, Some(shown(m)));
  let survivor = nth(at(m, "survivors"), 0);
  assert_eq(str(at(survivor, "definition")), "m.clamp");
  assert_eq(texts(at(survivor, "tests")), ["m.clamp keeps a positive"]);
  assert(int(path(survivor, ["location", "line"])) >= 2, Some(shown(survivor)));
  assert(int(at(v, "exit_code")) == 1, Some("a survivor fails the run: " ++ shown(v)));
  assert_eq(r.code, 1)
}

test/nondet "every mutant of a well-tested definition is killed and the cache is untouched" {
  program(source());
  assert_eq(on_disk(["test"]).code, 0);
  let stored = ||
    map([".ply-cache/store.idx", ".ply-cache/store.dat"], |f: String| fs.read_file[cwd](f));
  let before = stored();
  let v = json_of(on_disk(["test", "--mutate", "m.add", "--json"]));
  let m = at(v, "mutants");
  assert(int(at(m, "survived")) == 0, Some(shown(m)));
  assert(int(at(m, "killed")) >= 1, Some(shown(m)));
  assert(int(at(v, "exit_code")) == 0, Some(shown(v)));
  assert(stored() == before, Some("a mutant left something in the cache"))
}

test/nondet "a definition no test reaches is reported rather than mutated" {
  program(source());
  let m = at(json_of(on_disk(["test", "--mutate", "--json"])), "mutants");
  assert_eq(texts(at(m, "unreached")), ["m.unused"]);
  assert_eq(int(at(m, "definitions")), 3);
  assert_eq(on_disk(["test", "--mutate", "nothing"]).code, 2)
}
