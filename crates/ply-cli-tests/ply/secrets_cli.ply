//! A failing test over credentials, as a person and a document read it: what failed and that a
//! secret was there, and never the payload.

import harness (Hermetic, Shipped, in_memory, one, said)

// Each payload is assembled at run time, so the source line a failure quotes does not hold it.
fn printed_nowhere(
  program: String,
  payloads: List<String>,
) -> Unit / {Hermetic, Shipped, abort.raise, diverges} = {
  let tree = one(program);
  let text = in_memory(tree, ["test", "--no-cache"]);
  let json = in_memory(tree, ["test", "--no-cache", "--json"]);
  assert(text.code != 0 && json.code != 0, Some(said(text)));
  fold(payloads, (), |u: Unit, p: String|
    assert(
      !string_contains(said(text), p) && !string_contains(said(json), p),
      Some(said(text) ++ said(json)),
    ));
  assert(string_contains(said(text), "Secret"), Some(said(text)))
}

test "a failing assertion over secrets prints no payload" {
  printed_nowhere(
    "test \"two logins differ\" {\n  assert_eq(\n    {user: \"ada\", password: secret_of_string(\"hun\" ++ \"ter2\")},\n    {user: \"ada\", password: secret_of_string(\"correct\" ++ \"-horse\")})\n}\n",
    ["hunter2", "correct-horse"],
  )
}

test "a failing assertion over secrets of bytes prints no payload" {
  printed_nowhere(
    "test \"two keys differ\" {\n  assert_eq(secret_of_bytes(b\"hun\" ++ b\"ter2\"), secret_concat(secret_of_bytes(b\"corr\" ++ b\"ect-\"), secret_of_bytes(b\"hor\" ++ b\"se\")))\n}\n",
    ["hunter2", "horse"],
  )
}
