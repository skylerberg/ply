//! `ply prove` and `ply review`: the coverage a reviewer reads first, one report however the work
//! was split or whatever the cache answered, the review of what changed since the last accepted
//! one, and each obligation proved or failing the run with what stopped it.

import harness (scratch, program, write, on_disk, said, stdout, json_of, at, path, nth, items,
                first, str, int, truth, shown, Reached, Shipped)
import std.json
import std.json (Json, Null, Object, Array, Str)
import std.string
import std.list (concat)

fn unspecified() -> String =
  "fn double(x: Int) -> Int = x * 2\n\nfn triple(x: Int) -> Int = x * 3\n\nfn main() -> Int = double(21)\n"

fn proved_json(flags: List<String>) -> Json / {Reached, Shipped, abort.raise, diverges} =
  json_of(on_disk(concat(["prove", "--json"], flags)))

fn without(j: Json, keys: List<String>) -> Json =
  match j {
    Object(m) ->
      Object(fold(keys, m, |acc: Map<String, Json>, k: String| map_insert(acc, k, Null))),
    other -> other,
  }

test "prove leads with the review surface" {
  scratch(|| {
    program(unspecified());
    let r = on_disk(["prove"]);
    assert(r.code == 0, Some(said(r)));
    let first_line = match list_at(r.out, 0) { Some(l) -> l, None -> "" };
    assert(
      string_contains(first_line, "3 definitions")
        && string_contains(first_line, "0 carry an obligation"),
      Some("the coverage line has to be first: " ++ stdout(r)),
    );
    assert(
      string_contains(stdout(r), "3 not covered by a claim that holds: m.double, m.main, m.triple"),
      Some("uncovered definitions are a list to work through, not only a number: " ++ stdout(r)),
    );
    assert(string_contains(stdout(r), "0 obligations"), Some(stdout(r)))
  })
}

test "prove json is one object carrying the coverage block" {
  scratch(|| {
    program(unspecified());
    let r = on_disk(["prove", "--json"]);
    assert(r.code == 0, Some(said(r)));
    let v = json_of(r);
    assert(int(at(v, "schema_version")) == 1, Some(shown(v)));
    assert(str(at(v, "command")) == "prove", Some(shown(v)));
    assert(truth(at(v, "ok")), Some(shown(v)));
    assert(int(path(v, ["coverage", "definitions"])) == 3, Some(shown(v)));
    assert(int(path(v, ["coverage", "covered"])) == 0, Some(shown(v)));
    assert(int(at(v, "specified")) == 0, Some(shown(v)));
    assert(len(items(path(v, ["coverage", "uncovered"]))) == 3, Some(shown(v)));
    assert(int(path(v, ["plan", "prove_budget"])) > 0, Some(shown(v)));
    assert(items(at(v, "obligations")) == [], Some(shown(v)))
  })
}

test "prove json is byte-identical across runs and job counts" {
  scratch(|| {
    program(unspecified());
    // The clock is the one thing that legitimately differs.
    assert(
      without(proved_json(["--jobs", "1"]), ["duration_ms"])
        == without(proved_json(["--jobs", "16"]), ["duration_ms"]),
      None,
    )
  })
}

// Recording what an obligation exercised as seen would empty the next `ply test`'s suspect set.
test "proving does not touch what the next test run suspects" {
  scratch(|| {
    program(unspecified());
    let before = at(json_of(on_disk(["cache", "stats", "--json"])), "definitions_seen");
    assert(on_disk(["prove"]).code == 0, None);
    assert(at(json_of(on_disk(["cache", "stats", "--json"])), "definitions_seen") == before, None)
  })
}

/// Proofs and a refutation, so the determinism and cache checks have something to disagree about.
fn specified() -> String =
  \\fn one(x: Int) -> Int
  \\  ensures result >= 0
  \\= 1
  \\
  \\fn size_of(xs: List<Int>) -> Int
  \\  ensures result >= 0
  \\= len(xs)
  \\
  \\law "length is never negative"
  \\  forall (xs: List<Int>) {
  \\    size_of(xs) >= 0
  \\  }
  \\
  \\law "a batch never holds more than one entry"
  \\  forall (xs: List<Int>) {
  \\    len(xs) <= 1
  \\  }
  \\

/// The clock and where each answer came from legitimately differ between warm and cold.
fn artifact(v: Json) -> Json = without(v, ["duration_ms", "cached"])

// A program with no obligations cannot catch an order that depends on the worker pool.
test "prove json agrees across job counts over real obligations" {
  scratch(|| {
    program(specified());
    let one = artifact(proved_json(["--jobs", "1", "--no-cache"]));
    let many = artifact(proved_json(["--jobs", "16", "--no-cache"]));
    // A length is known to be non-negative, so both `ensures` and the first law are proved.
    assert(int(path(one, ["summary", "proved"])) == 3, Some(shown(one)));
    assert(int(path(one, ["summary", "refuted"])) == 1, Some(shown(one)));
    assert(one == many, None)
  })
}

test "a cached run reports exactly what a fresh one does" {
  scratch(|| {
    program(specified());
    let fresh = artifact(proved_json(["--no-cache"]));
    // Populate, then read back.
    let _ = on_disk(["prove", "--json"]);
    let warm = proved_json([]);
    assert(int(at(warm, "cached")) > 0, Some("the second run has to have read something"));
    assert(fresh == artifact(warm), None)
  })
}

// `--reach` asks the static prover about every obligation, whatever answered it, so a claim the cache
// answered carries what a fresh discharge's would; unasked, no claim carries one.
test "a cached run reports the same reach as a fresh one" {
  scratch(|| {
    program(specified());
    let fresh = artifact(proved_json(["--reach", "--no-cache"]));
    let unasked = proved_json([]);
    assert(
      len(filter(items(at(unasked, "obligations")), |o: Json| at(o, "reach") != Null)) == 0,
      Some(shown(unasked)),
    );
    let warm_raw = proved_json(["--reach"]);
    assert(int(at(warm_raw, "cached")) > 0, Some("the second run has to have read something"));
    let warm = artifact(warm_raw);
    assert(fresh == warm, None);
    assert(
      len(
          filter(items(at(warm, "obligations")), |o: Json|
            str(path(o, ["reach", "decision"])) == ""),
        )
        == 0,
      Some("every claim here is one the static prover sees: " ++ shown(warm)),
    )
  })
}

// A proof made by running every point is filed under the key of what it ran, and the next run reads
// it back from there rather than walking the domain again.
test "a claim proved by walking its domain is read back rather than walked again" {
  scratch(|| {
    program(
      \\type Day = | Mon | Tue | Wed
      \\
      \\fn next(d: Day) -> Day = match d { Mon -> Tue, Tue -> Wed, Wed -> Mon }
      \\
      \\law "three days on is the same day" forall (d: Day) {
      \\  fold(range(0, 3), d, |day: Day, _i: Int| next(day)) == d
      \\}
      \\
    );
    let first_run = proved_json([]);
    let law = nth(at(first_run, "obligations"), 0);
    assert(str(at(law, "outcome")) == "proved", Some(shown(first_run)));
    assert(truth(path(law, ["certificate", "ran"])), Some(shown(law)));
    assert(int(at(first_run, "cached")) == 0, Some(shown(first_run)));
    let second = proved_json([]);
    assert(int(at(second, "cached")) == 1, Some(shown(second)));
    assert(at(second, "warnings") == Array([]), Some("and nothing was refused: " ++ shown(second)));
    assert(artifact(first_run) == artifact(second), None);
    let explained = stdout(on_disk(["prove", "--explain"]));
    assert(string_contains(explained, "from: cached proof"), Some(explained));
    assert(!string_contains(explained, "cache refused"), Some(explained))
  })
}

fn owned(v: Json, owner: String) -> Json =
  match filter(items(at(v, "obligations")), |o: Json| str(at(o, "owner")) == owner) {
    [o, ..] -> o,
    _ -> Null,
  }

/// A bound the body shows, and one it outgrows.
fn clauses() -> String =
  \\fn total(xs: List<Int>) -> Int
  \\  cost len(xs)
  \\= fold(xs, 0, |a: Int, x: Int| a + x)
  \\
  \\fn wrong(xs: List<Int>) -> Int
  \\  cost 1
  \\= fold(xs, 0, |a: Int, x: Int| a + x)
  \\

// A bound is proved from the body or it is not proved: nothing measures a run to stand in for one.
test "a `cost` clause its body shows is proved, and one it outgrows is unproved where it grows" {
  scratch(|| {
    program(clauses());
    let r = on_disk(["prove", "--no-cache"]);
    assert(r.code == 1, Some(said(r)));
    let v = proved_json(["--no-cache"]);
    let total = owned(v, "m.total");
    assert(str(at(total, "kind")) == "cost", Some(shown(total)));
    assert(str(at(total, "outcome")) == "proved", Some(shown(total)));
    assert(!truth(path(total, ["certificate", "ran"])), Some(shown(total)));
    assert(
      fold(items(path(total, ["certificate", "rules"])), false, |found: Bool, rule: Json|
        found || str(path(rule, ["cost_bound", "def"])) == "m.total"),
      Some(shown(total)),
    );
    let wrong = owned(v, "m.wrong");
    assert(str(at(wrong, "outcome")) == "unproved", Some(shown(wrong)));
    assert(str(at(wrong, "gap_kind")) == "open", Some(shown(wrong)));
    assert(str(at(nth(at(wrong, "stuck"), 0), "kind")) == "unbounded", Some(shown(wrong)));
    assert(
      len(filter(items(at(v, "diagnostics")), |d: Json| str(at(d, "code")) == "E0474")) == 1,
      Some(shown(v)),
    )
  })
}

/// A bound over what a function given costs, one call composing it, and one bound too low for it.
fn named_costs() -> String =
  \\fn total(xs: List<Int>) -> Int = fold(xs, 0, |a: Int, x: Int| a + x)
  \\
  \\fn each_of<| e>(xs: List<Int>, f: (Int) -> Int / e cost k) -> Int / e
  \\  cost len(xs) * k
  \\= fold(xs, 0, |a: Int, x: Int| a + f(x))
  \\
  \\fn pairs(xs: List<Int>, ys: List<Int>) -> Int
  \\  cost len(xs) * (len(ys) + 1)
  \\= each_of(xs, |_x: Int| total(ys))
  \\
  \\fn too_cheap<| e>(xs: List<Int>, f: (Int) -> Int / e cost k) -> Int / e
  \\  cost k
  \\= fold(xs, 0, |a: Int, x: Int| a + f(x))
  \\

test "a cost name composes a bound with the function given, and a bound too low for it is unproved" {
  scratch(|| {
    program(named_costs());
    let v = proved_json(["--no-cache"]);
    assert(str(at(owned(v, "m.each_of"), "outcome")) == "proved", Some(shown(v)));
    assert(str(at(owned(v, "m.pairs"), "outcome")) == "proved", Some(shown(v)));
    assert(str(at(owned(v, "m.too_cheap"), "outcome")) == "unproved", Some(shown(v)));
    assert(int(path(v, ["summary", "unproved"])) == 1, Some(shown(v)))
  })
}

test "review reports everything as unreviewed until something is accepted" {
  scratch(|| {
    program(unspecified());
    let r = on_disk(["review", "--changed"]);
    assert(r.code == 0, Some(said(r)));
    assert(string_contains(stdout(r), "3 definitions"), Some(stdout(r)));
    assert(string_contains(stdout(r), "never reviewed"), Some(stdout(r)))
  })
}

test "accepting a review makes the next one quiet" {
  scratch(|| {
    program(unspecified());
    let accepted = on_disk(["review", "--accept"]);
    assert(accepted.code == 0, Some(said(accepted)));
    assert(string_contains(stdout(accepted), "3 definitions accepted"), Some(stdout(accepted)));
    let r = on_disk(["review", "--changed"]);
    assert(r.code == 0, Some(said(r)));
    assert(
      string_contains(stdout(r), "no definition changed since the last accepted review"),
      Some(stdout(r)),
    )
  })
}

// A definition's spec is the set of its claims, however they were gathered: a baseline read back
// from the store is the same spec it was accepted as.
test "accepting a review of claims makes the next one quiet" {
  scratch(|| {
    program(specified());
    assert(on_disk(["review", "--accept"]).code == 0, None);
    let r = on_disk(["review", "--changed"]);
    assert(
      string_contains(stdout(r), "no definition changed since the last accepted review"),
      Some(stdout(r)),
    )
  })
}

test "an unspecified change is reported as invisible rather than as nothing" {
  scratch(|| {
    program(unspecified());
    let _ = on_disk(["review", "--accept"]);
    write("m.ply", string::replace(unspecified(), "x * 2", "x + x"));
    let r = on_disk(["review", "--changed"]);
    assert(r.code == 0, Some(said(r)));
    let text = stdout(r);
    assert(string_contains(text, "m.double · implementation changed · no spec"), Some(text));
    assert(string_contains(text, "read the implementation, line by line"), Some(text));
    assert(
      string_contains(
        text,
        "carry no obligation that holds, so this run says nothing about whether their behaviour changed",
      ),
      Some("the limit has to be visible at the point of use: " ++ text),
    );
    assert(
      !string_contains(text, "nothing changed"),
      Some("an unspecified change is still a change: " ++ text),
    )
  })
}

test "review json names what moved and what the claim covers" {
  scratch(|| {
    program(unspecified());
    let _ = on_disk(["review", "--accept"]);
    write("m.ply", string::replace(unspecified(), "x * 3", "x + x + x"));
    let v = json_of(on_disk(["review", "--changed", "--json"]));
    assert(str(at(v, "command")) == "review", Some(shown(v)));
    assert(int(at(v, "definitions")) == 3, Some(shown(v)));
    assert(int(at(v, "unspecified_changed")) == 1, Some(shown(v)));
    assert(int(at(v, "specified_changed")) == 0, Some(shown(v)));
    let changed = items(at(v, "changed"));
    assert(len(changed) == 1, Some(shown(v)));
    assert(str(at(first(changed), "name")) == "m.triple", Some(shown(v)));
    assert(str(at(first(changed), "implementation")) == "changed", Some(shown(v)));
    assert(str(at(first(changed), "spec")) == "none", Some(shown(v)));
    assert(string_contains(str(at(v, "headline")), "carry no obligation"), Some(shown(v)))
  })
}

test "renaming a definition loses its baseline rather than its history" {
  scratch(|| {
    program(unspecified());
    let _ = on_disk(["review", "--accept"]);
    write("m.ply", string::replace(unspecified(), "triple", "treble"));
    let changed = items(at(json_of(on_disk(["review", "--changed", "--json"])), "changed"));
    assert(len(changed) == 1, None);
    assert(str(at(first(changed), "name")) == "m.treble", None);
    assert(str(at(first(changed), "implementation")) == "never reviewed", None)
  })
}

test "a change under an obligation nothing proves is never reported as checked" {
  scratch(|| {
    let effectful =
      \\effect db {
      \\  read  get[r](key: Int) -> Int
      \\  write put[r](key: Int, value: Int) -> Int
      \\}
      \\
      \\fn stored(k: Int) -> Int / {db.read[rows]}
      \\  ensures result >= 0
      \\= db.get[rows](k)
      \\
    ;
    program(effectful);
    let _ = on_disk(["review", "--accept"]);
    write("m.ply", string::replace(effectful, "= db.get[rows](k)", "= db.get[rows](k) + 1"));
    let r = on_disk(["review", "--changed"]);
    assert(r.code == 1, Some("a claim nothing proves fails the run: " ++ said(r)));
    let text = stdout(r);
    assert(
      string_contains(text, "m.stored · implementation changed · spec unchanged"),
      Some(text),
    );
    assert(string_contains(text, "unproved"), Some(text));
    assert(
      string_contains(text, "not covered by a claim that holds: m.stored"),
      Some("the definition a reader still has to read has to be named: " ++ text),
    );
    assert(
      !string_contains(text, "no specified behaviour changed"),
      Some("nothing here established anything: " ++ text),
    );
    let v = json_of(on_disk(["review", "--changed", "--json"]));
    assert(!truth(at(v, "ok")), Some(shown(v)));
    assert(int(at(v, "undischarged")) == 1, Some(shown(v)));
    // The count the headline discloses the blind spot with, and the sentence an agent would act on.
    assert(int(at(v, "specified_changed")) == 0, Some(shown(v)));
    assert(int(at(v, "unspecified_changed")) == 1, Some(shown(v)));
    let change = nth(at(v, "changed"), 0);
    assert(!truth(at(change, "specified")) && at(change, "specified") != Null, Some(shown(change)));
    assert(
      str(at(change, "advice"))
        == "no obligation on this definition holds: read the implementation, line by line",
      Some(shown(change)),
    );
    assert(int(path(v, ["coverage", "covered"])) == 0, Some(shown(v)));
    assert(path(v, ["coverage", "uncovered"]) == Array([Str("m.stored")]), Some(shown(v)));
    let obligation = nth(at(change, "obligations"), 0);
    assert(str(at(obligation, "outcome")) == "unproved", Some(shown(obligation)));
    assert(str(at(obligation, "gap_kind")) == "unhandled_effect", Some(shown(obligation)))
  })
}

// A frame names each write as a row names its resource: bracketed, and nothing for an effect that
// has none.
test "a frame names each write as a row does" {
  scratch(|| {
    program(
      \\effect db {
      \\  write put[r](key: Int, value: Int) -> Int
      \\}
      \\
      \\effect audit {
      \\  write note(n: Int) -> Unit
      \\}
      \\
      \\fn stored(k: Int) -> Int / {db.write[rows], audit.write}
      \\  ensures result >= 0
      \\= {
      \\  audit.note(k);
      \\  db.put[rows](k, 1)
      \\}
      \\
    );
    let v = proved_json(["--no-cache"]);
    assert(
      str(at(nth(at(v, "obligations"), 0), "frame")) == "writes m.audit, m.db[rows]",
      Some(shown(v)),
    )
  })
}

test "a guard nothing shows empty is no vacuity: its claim is unproved" {
  scratch(|| {
    program(
      \\fn seen(xs: List<Int>, x: Int) -> Bool =
      \\  match xs {
      \\    [y, ..rest] -> if y == x { true } else { seen(rest, x) },
      \\    _ -> false,
      \\  }
      \\
      \\law "a narrow window" forall (xs: List<Int>, x: Int)
      \\  where x > 1000000 && x < 1000010 { seen(push(xs, x), x) }
      \\
    );
    let r = on_disk(["prove", "--no-cache"]);
    assert(r.code == 1, Some("a claim nothing proves fails the run: " ++ said(r)));
    let text = stdout(r);
    assert(string_contains(text, "unproved"), Some(text));
    assert(!string_contains(text, "vacuous"), Some("the guard admits nine values: " ++ text));
    let v = proved_json(["--no-cache"]);
    assert(!truth(at(v, "ok")), Some(shown(v)));
    assert(
      map(items(at(v, "diagnostics")), |d: Json| str(at(d, "code"))) == ["E0474"],
      Some(shown(v)),
    );
    let law = nth(at(v, "obligations"), 0);
    assert(str(at(law, "outcome")) == "unproved", Some(shown(v)));
    assert(str(at(law, "gap_kind")) == "open", Some(shown(v)));
    assert(int(path(v, ["coverage", "covered"])) == 0, Some(shown(v)))
  })
}

// A guard that holds an `Int` between two literals leaves a domain a run walks whole, so a claim
// no proof decides is proved, or refuted, at every value the guard admits.
test "a claim whose guard holds its Int between two literals is judged at every value" {
  scratch(|| {
    let over = |ends: String, guard: String|
      "fn ends_a_square(d: Int) -> Bool = " ++ ends
        ++ "\n\nlaw \"a square's last digit\" forall (n: Int) where "
        ++ guard
        ++ " { ends_a_square((n * n) % 10) }\n";
    let all = "d == 0 || d == 1 || d == 4 || d == 5 || d == 6 || d == 9";
    program(over(all, "n >= 0 && n <= 40"));
    let held = nth(at(proved_json(["--no-cache"]), "obligations"), 0);
    assert(str(at(held, "outcome")) == "proved", Some(shown(held)));
    assert(truth(path(held, ["certificate", "ran"])), Some(shown(held)));
    assert(
      string_contains(str(path(held, ["certificate", "summary"])), "41 points of Int 0..=40"),
      Some(shown(held)),
    );
    // One digit short of the claim, which the walk reaches at the first square that ends in it.
    program(over("d == 0 || d == 1 || d == 4 || d == 5 || d == 6", "n >= 0 && n <= 40"));
    let short = nth(at(proved_json(["--no-cache"]), "obligations"), 0);
    assert(str(at(short, "outcome")) == "refuted", Some(shown(short)));
    assert(
      str(at(nth(path(short, ["counterexample", "bindings"]), 0), "value")) == "3",
      Some(shown(short)),
    )
  })
}

fn by_label(v: Json, needle: String) -> Json / {abort.raise} =
  match filter(items(at(v, "obligations")), |o: Json|
      string_contains(str(at(o, "label")), needle)) {
    [o, ..] -> o,
    [] -> panic("no obligation for `" ++ needle ++ "`: " ++ shown(v)),
  }

test "a postcondition that raises at the boundary is not proved" {
  scratch(|| {
    program(
      \\fn inc(x: Int) -> Int
      \\  ensures result > x
      \\= x + 1
      \\
      \\fn bounded(x: Int) -> Int
      \\  requires x < 100
      \\  ensures result > x
      \\= x + 1
      \\
    );
    let v = proved_json(["--no-cache"]);
    let inc = by_label(v, "m.inc");
    assert(
      str(at(inc, "outcome")) == "unproved",
      Some(
        "`x + 1 > x` has no answer at `i64::MAX`, so nothing proves it of every input: "
          ++ shown(v),
      ),
    );
    assert(at(inc, "certificate") == Null, Some(shown(inc)));
    assert(str(at(by_label(v, "m.bounded"), "outcome")) == "proved", Some(shown(v)));
    assert(
      path(v, ["coverage", "uncovered"]) == Array([Str("m.inc")]),
      Some("a definition whose only claim is unproved is one a reviewer still has to read"),
    )
  })
}

// A closure cannot cross out of the C backend, so it declines `adder`'s answer; `inc` is unproved
// on its own.
test "a proposition the C backend declines is a defect in Ply and not an unproved claim" {
  scratch(|| {
    program(
      \\fn adder(n: Int) -> (Int) -> Int
      \\  ensures result(1) == n + 1
      \\= |x: Int| x + n
      \\
      \\fn inc(x: Int) -> Int
      \\  ensures result > x
      \\= x + 1
      \\
    );
    let r = on_disk(["prove", "--no-cache", "--json"]);
    let v = json_of(r);
    let declined = by_label(v, "m.adder");
    assert(
      str(at(declined, "outcome")) == "defect",
      Some("the control must be an entry the C backend declines: " ++ shown(declined)),
    );
    assert(
      at(declined, "gap") == Null && at(declined, "gap_kind") == Null,
      Some("Ply's failure is no gap in the claim: " ++ shown(declined)),
    );
    assert(str(path(declined, ["defect", "code"])) == "E0505", Some(shown(declined)));
    assert(
      string_contains(str(path(declined, ["defect", "message"])), "declined"),
      Some(shown(declined)),
    );
    assert(
      string_contains(str(path(declined, ["defect", "summary"])), "this is a defect in Ply"),
      Some(shown(declined)),
    );
    let open = by_label(v, "m.inc");
    assert(str(at(open, "outcome")) == "unproved", Some(shown(open)));
    assert(int(path(v, ["summary", "defect"])) == 1, Some(shown(v)));
    assert(int(path(v, ["summary", "unproved"])) == 1, Some(shown(v)));
    let codes = map(items(at(v, "diagnostics")), |d: Json| str(at(d, "code")));
    assert(
      len(filter(codes, |c: String| c == "E0474")) == 1,
      Some("only the program's own claim is E0474: " ++ string::join(codes, ", ")),
    );
    assert(len(filter(codes, |c: String| c == "E0505")) > 0, Some(string::join(codes, ", ")));
    assert(r.code == 1, Some("a defect fails the run, as one fails `ply test`: " ++ shown(v)));
    assert(!truth(at(v, "ok")), Some(shown(v)))
  })
}

// A claim over a fixed width is judged over the values it names: the seam reads each width as its
// type says, so a law over `U8` is refuted at the byte that breaks it and proved over the 256 that
// hold, and a clause no byte satisfies is vacuous rather than misread.
test "a claim over a fixed width is judged over the values it names" {
  scratch(|| {
    program(
      \\fn narrow(n: Int) -> U8 / {abort.raise}
      \\  requires n >= 0 && n < 256
      \\  ensures int_of_u8(result) < 256
      \\= u8_of_int(n)
      \\
      \\fn low_bit(b: U8) -> Int
      \\  requires int_of_u8(b) > 300
      \\  ensures result < 2
      \\= int_of_u8(b & 1u8)
      \\
      \\type Byte = | Byte(U8)
      \\
      \\law "no byte is seven" forall (b: U8) { int_of_u8(b) != 7 }
      \\
      \\law "every byte fits" forall (b: U8) { int_of_u8(b) < 256 }
      \\
      \\law "no Byte is seven" forall (b: Byte) { match b { Byte(x) -> int_of_u8(x) != 7 } }
      \\
    );
    let r = on_disk(["prove", "--no-cache", "--json"]);
    let v = json_of(r);
    fold(
      [
        { needle: "no byte is seven", value: "7" },
        { needle: "no Byte is seven", value: "Byte(7)" },
      ],
      (),
      |u: Unit, c: { needle: String, value: String }| {
        let o = by_label(v, c.needle);
        assert(str(at(o, "outcome")) == "refuted", Some(shown(o)));
        let binding = nth(path(o, ["counterexample", "bindings"]), 0);
        assert(str(at(binding, "name")) == "b", Some(shown(o)));
        assert(str(at(binding, "value")) == c.value, Some(shown(o)))
      },
    );
    assert(
      str(at(nth(path(by_label(v, "no byte is seven"), ["counterexample", "bindings"]), 0), "type"))
        == "U8",
      Some(shown(v)),
    );
    let fits = by_label(v, "every byte fits");
    assert(str(at(fits, "outcome")) == "proved", Some(shown(fits)));
    let enumerated = fold(
      items(path(fits, ["certificate", "rules"])),
      [],
      |acc: List<Json>, rule: Json|
        match at(rule, "exhaustive_enumeration") { Null -> acc, e -> push(acc, e) },
    );
    assert(
      len(enumerated) == 1 && int(at(first(enumerated), "points")) == 256,
      Some("every byte was checked: " ++ shown(fits)),
    );
    assert(str(at(by_label(v, "m.low_bit"), "outcome")) == "vacuous", Some(shown(v)));
    assert(str(at(by_label(v, "m.narrow"), "outcome")) != "defect", Some(shown(v)));
    assert(int(path(v, ["summary", "defect"])) == 0, Some(shown(v)));
    assert(int(path(v, ["summary", "refuted"])) == 2, Some(shown(v)));
    assert(r.code == 1, Some(shown(v)))
  })
}

fn outcomes() -> List<{ label: String, outcome: String }> / {Reached, Shipped, abort.raise, diverges} =
  map(items(at(proved_json([]), "obligations")), |o: Json|
    { label: str(at(o, "label")), outcome: str(at(o, "outcome")) })

// A cached proof survives every plan widening, so only a key over the whole transitive closure keeps
// it current.
test "editing what a proof rests on re-opens it" {
  scratch(|| {
    // Two links between the claim and its value, so the second edit tests the transitive half.
    let good =
      \\fn leaf() -> Int = 1
      \\
      \\fn base() -> Int = leaf()
      \\
      \\fn shift(x: Int) -> Int
      \\  requires x > 0 && x < 1000
      \\  ensures result == x + 1
      \\= x + base()
      \\
      \\law "shift agrees with base" forall (x: Int) where x > 0 && x < 1000
      \\  { shift(x) == x + base() }
      \\
    ;
    fold(
      [
        {
          what: "the body",
          from: "= x + base()\n",
          to: "= x + base() + 1\n",
          refuted: ["ensures", "law"],
        },
        {
          what: "the spec",
          from: "ensures result == x + 1",
          to: "ensures result == x + 3",
          refuted: ["ensures"],
        },
        {
          what: "a transitive dependency",
          from: "fn leaf() -> Int = 1",
          to: "fn leaf() -> Int = 2",
          refuted: ["ensures"],
        },
      ],
      (),
      |u: Unit, e: { what: String, from: String, to: String, refuted: List<String> }| {
        program(good);
        let first_outcomes = outcomes();
        assert(
          len(filter(first_outcomes, |o: { label: String, outcome: String }| o.outcome != "proved"))
            == 0,
          Some("the baseline is two proofs"),
        );
        let broken = string::replace(good, e.from, e.to);
        assert(broken != good, Some("the edit to " ++ e.what ++ " matched nothing"));
        write("m.ply", broken);
        let after = outcomes();
        fold(e.refuted, u, |w: Unit, kind: String|
          match filter(after, |o: { label: String, outcome: String }|
              string_contains(o.label, kind)) {
            [found, ..] ->
              assert(
                found.outcome == "refuted",
                Some(
                  "editing " ++ e.what ++ " left `" ++ found.label ++ "` cached as `"
                    ++ found.outcome
                    ++ "`, which is a proof of something no longer true",
                ),
              ),
            [] -> panic("no `" ++ kind ++ "` obligation after editing " ++ e.what),
          })
      },
    )
  })
}

// A finite domain is walked in a fixed order, so the point that fails is the one reported.
test "an enumerated refutation is reported at the point that fails" {
  scratch(|| {
    program(
      \\type Day = Mon | Tue | Wed | Thu | Fri | Sat | Sun
      \\
      \\fn rank(d: Day) -> Int =
      \\  match d { Mon -> 1, Tue -> 2, Wed -> 3, Thu -> 4, Fri -> 5, Sat -> 6, Sun -> 7 }
      \\
      \\law "every day is early" forall (d: Day) { rank(d) / 1 < 7 }
      \\
    );
    let o = nth(at(proved_json(["--no-cache"]), "obligations"), 0);
    assert(str(at(o, "outcome")) == "refuted", Some(shown(o)));
    assert(
      str(at(nth(path(o, ["counterexample", "bindings"]), 0), "value")) == "Sun",
      Some(shown(o)),
    )
  })
}

// A claim over a domain no run walks is tried at a few small values and at the literals it is
// written with, which is where a claim about a bound fails.
test "a claim is refuted at a literal it is written with" {
  scratch(|| {
    program("law \"the bound holds\"\n  forall (n: Int) {\n    n < 100\n  }\n");
    let r = on_disk(["prove"]);
    assert(r.code == 1, Some(said(r)));
    let text = stdout(r);
    assert(string_contains(text, "refuted"), Some(text));
    assert(string_contains(text, "→  n = 100"), Some(text))
  })
}

fn obligation(report: Json, label: String) -> Json =
  first(filter(items(at(report, "obligations")), |o: Json| str(at(o, "label")) == label))

test "an instantiation is discharged as its schema's body written out, and names its schema" {
  scratch(|| {
    let over = |laws: String|
      "fn clamp(n: Int) -> Int = if n > 10 { 10 } else { n }\n\nfn reverse(xs: List<Int>) -> List<Int> =\n  match xs { [] -> [], [x, ..rest] -> push(reverse(rest), x) }\n\n"
        ++ laws;
    program(
      over(
        \\law "clamp settles" forall (x: Int) { clamp(clamp(x)) == clamp(x) }
        \\
        \\law "reverse twice" forall (x: List<Int>) { reverse(reverse(x)) == x }
        \\
        \\law "small values are fixed" forall (x: Int) where x > 0 && x < 10 { clamp(x) == x }
        \\
      ),
    );
    let written = proved_json(["--no-cache"]);
    program(
      over(
        \\law schema idempotent<a>(f: (a) -> a) forall (x: a) { f(f(x)) == f(x) }
        \\
        \\law schema involution<a>(f: (a) -> a) forall (x: a) { f(f(x)) == x }
        \\
        \\law schema fixed_within(f: (Int) -> Int, low: Int, high: Int)
        \\  forall (x: Int) where x > low && x < high { f(x) == x }
        \\
        \\law "clamp settles" = idempotent(clamp)
        \\
        \\law "reverse twice" = involution(reverse)
        \\
        \\law "small values are fixed" = fixed_within(clamp, 0, 10)
        \\
      ),
    );
    let made = proved_json(["--no-cache"]);
    assert(at(made, "exit_code") == at(written, "exit_code"), Some(shown(made)));
    // A schema's own definitions are what is claimed, not definitions to carry a claim.
    assert(at(made, "coverage") == at(written, "coverage"), Some(shown(at(made, "coverage"))));
    let schema_of = |label: String, outcome: String| {
      let m = obligation(made, "law \"" ++ label ++ "\"");
      let w = obligation(written, "law \"" ++ label ++ "\"");
      assert(str(at(m, "outcome")) == outcome && str(at(w, "outcome")) == outcome, Some(shown(m)));
      assert(at(m, "certificate") == at(w, "certificate"), Some(shown(m) ++ "\n" ++ shown(w)));
      assert(at(m, "gap") == at(w, "gap"), Some(shown(m) ++ "\n" ++ shown(w)));
      assert(at(m, "guarded") == at(w, "guarded"), Some(shown(m)));
      assert(at(w, "schema") == Null, Some(shown(w)));
      str(at(m, "schema"))
    };
    assert(schema_of("clamp settles", "proved") == "m.idempotent", Some(shown(made)));
    // An induction over a list is one the prover does not make.
    assert(schema_of("reverse twice", "unproved") == "m.involution", Some(shown(made)));
    assert(schema_of("small values are fixed", "proved") == "m.fixed_within", Some(shown(made)))
  })
}

test "a refuted instantiation is refuted at the schema's binder, where it is written" {
  scratch(|| {
    program(
      \\fn x(n: Int) -> Int = if n > 0 { 0 } else { n }
      \\
      \\law schema involution<a>(f: (a) -> a) forall (x: a) { f(f(x)) == x }
      \\
      \\law "a clamp undoes itself" = involution(x)
      \\
    );
    let r = on_disk(["prove", "--no-cache"]);
    assert(r.code == 1, Some(said(r)));
    assert(string_contains(stdout(r), "forall (x: Int)"), Some(stdout(r)));
    assert(string_contains(stdout(r), "schema: m.involution"), Some(stdout(r)));
    let o = obligation(
      json_of(on_disk(["prove", "--no-cache", "--json"])),
      "law \"a clamp undoes itself\"",
    );
    assert(str(at(o, "outcome")) == "refuted", Some(shown(o)));
    assert(str(at(o, "location")) == "m.ply:5:1", Some(shown(o)));
    assert(str(at(nth(path(o, ["counterexample", "bindings"]), 0), "name")) == "x", Some(shown(o)))
  })
}

test "a schema takes what raises a refusal of its own, and quantifies the `new` record it is given" {
  scratch(|| {
    let over = |laws: String|
      "type Sign = new { negative: Bool }\n\neffect reader {\n  raise refused(at: Int)\n}\n\nfn shown(s: Sign) -> String = if s.negative { \"-\" } else { \"+\" }\n\nfn read(t: String) -> Option<Sign> / {reader.refused} =\n  if t == \"-\" { Some({ negative: true }) }\n  else if t == \"+\" { Some({ negative: false }) }\n  else { reader.refused(string_len(t)) }\n\nfn digit(n: Int) -> Int / {reader.refused} = if n < 0 { reader.refused(n) } else { n % 10 }\n\n"
        ++ laws;
    program(
      over(
        \\law "a sign reads back" forall (x: Sign) { read(shown(x)) == Some(x) }
        \\
        \\law "a digit settles" forall (x: Int) { digit(digit(x)) == digit(x) }
        \\
      ),
    );
    let written = proved_json(["--no-cache"]);
    program(
      over(
        \\law schema reads_back<a, b | e>(shown: (a) -> b / e, read: (b) -> Option<a> / e)
        \\  forall (x: a) { read(shown(x)) == Some(x) }
        \\
        \\law schema settles<a | e>(f: (a) -> a / e) forall (x: a) { f(f(x)) == f(x) }
        \\
        \\law "a sign reads back" = reads_back(shown, read)
        \\
        \\law "a digit settles" = settles(digit)
        \\
      ),
    );
    let made = proved_json(["--no-cache"]);
    let same = |label: String, key: String| {
      let m = obligation(made, "law \"" ++ label ++ "\"");
      let w = obligation(written, "law \"" ++ label ++ "\"");
      assert(at(m, key) != Null && at(m, key) == at(w, key), Some(shown(m) ++ "\n" ++ shown(w)));
      assert(at(m, "outcome") == at(w, "outcome"), Some(shown(m) ++ "\n" ++ shown(w)));
      m
    };
    // A `new` record of two values is every value there is of it, to the schema as to the law.
    let sign = same("a sign reads back", "certificate");
    assert(
      string_contains(str(path(sign, ["certificate", "summary"])), "2 points of m.Sign"),
      Some(shown(sign)),
    );
    // A refusal of the program's own leaves the claim unproved at the point that raised it.
    let digit = same("a digit settles", "gap");
    assert(str(at(digit, "gap_kind")) == "raised", Some(shown(digit)));
    assert(string_contains(str(at(digit, "gap")), "m.reader.refused"), Some(shown(digit)))
  })
}

fn reads_back() -> String =
  "law schema reads_back<a, b | e>(shown: (a) -> b / e, read: (b) -> Option<a> / e)\n  forall (x: a) { read(shown(x)) == Some(x) }\n\n"

// A claim ranges over a type another module keeps opaque, and nothing outside that module builds a
// value of one: no run tries such a claim, so nothing refutes it and no point of it is shown.
test "a claim over a type another module keeps opaque is never run" {
  scratch(|| {
    program(
      "import std.html (Html, render)\n\n" ++ reads_back()
        ++ "law \"no page is a word\" forall (xs: List<Html>) { len(filter(xs, |x: Html| render(x) == \"word\")) == 0 }\n\nlaw \"a page reads back\" = reads_back(render, |s: String| -> Option<Html> { None })\n\nfn width(page: Html) -> Int / {abort.raise}\n  ensures result != 7\n= string_len(render(page))\n",
    );
    assert(on_disk(["check"]).code == 0, None);
    let report = proved_json(["--no-cache"]);
    fold(
      [
        obligation(report, "law \"no page is a word\""),
        obligation(report, "law \"a page reads back\""),
        owned(report, "m.width"),
      ],
      (),
      |u: Unit, o: Json| {
        assert(str(at(o, "outcome")) == "unproved", Some(shown(o)));
        assert(at(o, "counterexample") == Null && at(o, "raised_at") == Null, Some(shown(o)))
      },
    )
  })
}

test "an instantiation is refused where it is written, for what it is given and what it quantifies" {
  scratch(|| {
    let over = |law: String|
      "fn id(n: Int) -> Int = n\n\nfn held(c: Cell<Int>) -> Cell<Int> = c\n\nlaw schema same<a>(f: (a) -> a) forall (x: a) { f(x) == x }\n\n"
        ++ law
        ++ "\n";
    let refused = |law: String, code: String, at_text: String| {
      program(over(law));
      let r = on_disk(["check"]);
      assert(r.code != 0, Some(said(r)));
      assert(
        string_contains(said(r), "Error[" ++ code ++ "]") && string_contains(said(r), at_text),
        Some(said(r)),
      )
    };
    refused("law \"l\" = id(id)", "E0472", "`id` is not a law schema");
    refused(
      "law \"l\" = same(id, id)",
      "E0202",
      "the schema `same` takes 1 argument, but 2 were supplied",
    );
    refused("law \"l\" = same(int_to_string)", "E0201", "m.ply:7:16");
    refused(
      "law \"l\" = same(held)",
      "E0418",
      "the schema `same` binds `x`, which is a `Cell<Int>` here",
    )
  })
}
