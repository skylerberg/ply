// A fixture under `tests/fixtures/lang/` states in `// raises <test> :: <text>` lines which of its
// tests fail with `E0502` carrying `<text>`, and in `// footprint <definition> :: <row>` lines what
// the checker infers. The raises hold on both engines: the one the binary ships, run in memory, and
// the emitter built from the repository's sources, which `PLY_C_EMITTER` selects for a process.

import harness (Ran, in_memory, one, program, spawned, repo, said, json_of, at, items, str, shown,
                Here, Hermetic, Repo, Shelf, Spawned)
import std.json (Json, Str)
import std.string

// Embedded, so a test that reads one is cached until a fixture changes.
fn fixtures() -> List<{ name: String, bytes: Bytes }> = embed_dir("../../../tests/fixtures/lang")

fn fixture(name: String) -> String =
  match filter(fixtures(), |f: { name: String, bytes: Bytes }| f.name == name ++ ".ply") {
    [f, ..] -> string_of_bytes(f.bytes),
    [] -> panic("`tests/fixtures/lang` holds no `" ++ name ++ ".ply`"),
  }

type Stated = { test: String, text: String }

// Every `// <word> <first> :: <second>` line of a fixture.
fn stated(source: String, word: String) -> List<Stated> =
  fold(string_split(source, "\n"), [], |acc: List<Stated>, line: String| {
    let lead = "// " ++ word ++ " ";
    if !string_starts_with(line, lead) { acc } else {
      let rest = string_slice(line, string_len(lead), string_len(line));
      match string::split_once(rest, " :: ") {
        Some(p) -> push(acc, { test: string_trim(p.head), text: string_trim(p.tail) }),
        None -> panic("`" ++ word ++ " <name> :: <text>`: " ++ line),
      }
    }
  })

// The message, labels and notes of a diagnostic as one text: the machine labels a span, and
// compiled code, which has none, says the same in a note.
fn carried(d: Json) -> String = {
  let texts = |key: String|
    string::join(
      map(items(at(d, key)), |x: Json| match x { Str(s) -> s, _ -> str(at(x, "message")) }),
      " ",
    );
  str(at(d, "message")) ++ " " ++ texts("labels") ++ " " ++ texts("notes")
}

fn raises(name: String, source: String) -> List<Stated> = {
  let expected = stated(source, "raises");
  assert(len(expected) > 0, Some(name ++ " states no raises"));
  expected
}

// The engine the binary ships, over the fixture alone: its pass is cached.
fn on_the_machine(name: String) -> Unit / {Hermetic, Shelf} = {
  let source = fixture(name);
  judged(
    name,
    "the machine",
    raises(name, source),
    in_memory(one(source), ["test", "--json", "--no-cache"]),
  )
}

// The emitter built from the repository's sources, which only a process of its own selects.
fn on_the_tier(name: String) -> Unit / {Spawned, Here, Repo} = {
  let source = fixture(name);
  let expected = raises(name, source);
  program(source);
  judged(
    name,
    "the tier",
    expected,
    spawned(["test", "--json", "--no-cache"], [
      { name: "PLY_C_EMITTER", value: "ply:" ++ repo() ++ "/crates/ply-compiler/ply" },
    ]),
  )
}

fn judged(name: String, engine: String, expected: List<Stated>, r: Ran) -> Unit = {
  let failed = items(at(json_of(r), "failures"));
  fold(expected, (), |u: Unit, e: Stated| {
    let failure = match filter(failed, |f: Json| str(at(f, "name")) == e.test) {
      [f, ..] -> f,
      [] -> panic(name ++ ": `" ++ e.test ++ "` did not fail on " ++ engine ++ ": " ++ said(r)),
    };
    let d = at(failure, "diagnostic");
    assert(
      str(at(d, "code")) == "E0502",
      Some(name ++ ": `" ++ e.test ++ "` on " ++ engine ++ ": " ++ shown(d)),
    );
    assert(
      string_contains(carried(d), e.text),
      Some(
        name ++ ": `" ++ e.test ++ "` on " ++ engine ++ " raised without `" ++ e.text ++ "`: "
          ++ shown(d),
      ),
    )
  });
  assert(
    len(failed) == len(expected),
    Some(name ++ " on " ++ engine ++ ": every failure must be an expected raise: " ++ said(r)),
  )
}

test "the footprints the checker infers are the ones stated" {
  let source = fixture("footprints");
  let expected = stated(source, "footprint");
  assert(len(expected) > 0, Some("the fixture states footprints"));
  let defs = items(at(json_of(in_memory(one(source), ["check", "--json"])), "definitions"));
  fold(expected, (), |u: Unit, e: Stated| {
    let name = "m." ++ e.test;
    match filter(defs, |d: Json| str(at(d, "name")) == name) {
      [d, ..] -> assert(str(at(d, "footprint")) == e.text, Some("`" ++ name ++ "`: " ++ shown(d))),
      [] -> panic("`" ++ name ++ "` is not reported"),
    }
  })
}

test "the call bound counts nesting calls only, on the machine" {
  on_the_machine("recursion_raise")
}

test/nondet "the call bound counts nesting calls only, on the tier" {
  on_the_tier("recursion_raise")
}

test "the numeric raises hold on the machine" { on_the_machine("numbers_raise") }

test/nondet "the numeric raises hold on the tier" { on_the_tier("numbers_raise") }

test "the shift and overflow raises hold on the machine" { on_the_machine("bits_raise") }

test/nondet "the shift and overflow raises hold on the tier" { on_the_tier("bits_raise") }

test "a width raises at its type through every binder on the machine" {
  on_the_machine("widths_raise")
}

test/nondet "a width raises at its type through every binder on the tier" {
  on_the_tier("widths_raise")
}

test "the byte builtins' raises hold on the machine" { on_the_machine("bytes_raise") }

test/nondet "the byte builtins' raises hold on the tier" { on_the_tier("bytes_raise") }

test "the list update raises hold on the machine" { on_the_machine("lists_raise") }

test/nondet "the list update raises hold on the tier" { on_the_tier("lists_raise") }
