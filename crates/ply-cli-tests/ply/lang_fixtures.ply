//! A fixture under `tests/fixtures/lang/` states in `// raises <test> :: <text>` lines which of its
//! tests fail with `E0502` carrying `<text>`, and in `// footprint <definition> :: <row>` lines what
//! the checker infers.

import harness (Ran, in_memory, one, said, json_of, at, items, str, int, shown, Hermetic, Shipped)
import std.json (Json, Str)
import std.string

/// Embedded, so a test that reads one is cached until a fixture changes.
fn fixtures() -> List<{ name: String, bytes: Bytes }> = embed_dir("../../../tests/fixtures/lang")

fn fixture(name: String) -> String / {abort.raise} =
  match filter(fixtures(), |f: { name: String, bytes: Bytes }| f.name == name ++ ".ply") {
    [f, ..] -> string_of_bytes(f.bytes),
    [] -> panic("`tests/fixtures/lang` holds no `" ++ name ++ ".ply`"),
  }

type Stated = { test: String, text: String }

/// Every `// <word> <first> :: <second>` line of a fixture.
fn stated(source: String, word: String) -> List<Stated> / {abort.raise} =
  fold(string_split(source, "\n"), [], |acc: List<Stated>, line: String| {
    let lead = "// " ++ word ++ " ";
    if !string_starts_with(line, lead) { acc } else {
      let rest = string_slice(line, string_len(lead), string_len(line));
      match string::split_once(rest, " :: ") {
        Some(p) -> push(acc, { test: string_trim(p.head), text: string_trim(p.tail) }),
        None -> panic("`" ++ word ++ " <name> :: <text>`: " ++ line),
      }
    }
  })

/// The message, labels and notes of a diagnostic as one text: the machine labels a span, and
/// compiled code, which has none, says the same in a note.
fn carried(d: Json) -> String = {
  let texts = |key: String|
    string::join(
      map(items(at(d, key)), |x: Json| match x { Str(s) -> s, _ -> str(at(x, "message")) }),
      " ",
    );
  str(at(d, "message")) ++ " " ++ texts("labels") ++ " " ++ texts("notes")
}

fn raises(name: String, source: String) -> List<Stated> / {abort.raise} = {
  let expected = stated(source, "raises");
  assert(len(expected) > 0, Some(name ++ " states no raises"));
  expected
}

/// The fixture alone, its raises judged on the C backend.
fn raises_hold(name: String) -> Unit / {Hermetic, Shipped, abort.raise, diverges} = {
  let source = fixture(name);
  judged(name, raises(name, source), in_memory(one(source), ["test", "--json", "--no-cache"]))
}

/// A fixture whose every test holds.
fn holds(name: String) -> Unit / {Hermetic, Shipped, abort.raise, diverges} = {
  let r = in_memory(one(fixture(name)), ["test", "--json", "--no-cache"]);
  let v = json_of(r);
  assert(len(items(at(v, "failures"))) == 0, Some(name ++ ": " ++ said(r)));
  assert(int(at(at(v, "summary"), "passed")) > 0, Some(name ++ " ran nothing: " ++ said(r)))
}

test "what a call costs is counted" { holds("costs") }

fn judged(name: String, expected: List<Stated>, ran: Ran) -> Unit / {abort.raise} = {
  let failed = items(at(json_of(ran), "failures"));
  fold(expected, (), |u: Unit, e: Stated| {
    let failure = match filter(failed, |f: Json| str(at(f, "name")) == e.test) {
      [f, ..] -> f,
      [] -> panic(name ++ ": `" ++ e.test ++ "` did not fail: " ++ said(ran)),
    };
    let d = at(failure, "diagnostic");
    assert(str(at(d, "code")) == "E0502", Some(name ++ ": `" ++ e.test ++ "`: " ++ shown(d)));
    assert(
      string_contains(carried(d), e.text),
      Some(name ++ ": `" ++ e.test ++ "` raised without `" ++ e.text ++ "`: " ++ shown(d)),
    )
  });
  assert(
    len(failed) == len(expected),
    Some(name ++ ": every failure must be an expected raise: " ++ said(ran)),
  )
}

test "the footprints the checker infers are the ones stated" {
  let source = fixture("footprints");
  let expected = stated(source, "footprint");
  assert(len(expected) > 0, Some("the fixture states footprints"));
  let defs = items(at(json_of(in_memory(one(source), ["check", "--json"])), "definitions"));
  fold(expected, (), |u: Unit, e: Stated| {
    let name = "m." ++ e.test;
    match filter(defs, |d: Json| str(at(d, "name")) == name) {
      [d, ..] -> assert(str(at(d, "footprint")) == e.text, Some("`" ++ name ++ "`: " ++ shown(d))),
      [] -> panic("`" ++ name ++ "` is not reported"),
    }
  })
}

test "the call bound counts nesting calls only" { raises_hold("recursion_raise") }

test "the numeric raises hold" { raises_hold("numbers_raise") }

test "the shift and overflow raises hold" { raises_hold("bits_raise") }

test "a width raises at its type through every binder" { raises_hold("widths_raise") }

test "the byte builtins' raises hold" { raises_hold("bytes_raise") }

test "the list update raises hold" { raises_hold("lists_raise") }

test "a raise nothing answers fails its test with what it carried" {
  raises_hold("unanswered_raise")
}
