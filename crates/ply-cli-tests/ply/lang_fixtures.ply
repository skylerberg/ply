// A fixture under `tests/fixtures/lang/` states in `// raises <test> :: <text>` lines which of its
// tests fail with `E0502` carrying `<text>`, and in `// footprint <definition> :: <row>` lines what
// the checker infers. The raises hold on both engines: the one the binary ships, and the emitter
// built from the repository's sources, which `PLY_C_EMITTER` selects for a process.

import harness (on_disk, in_memory, one, program, spawned, repo, repo_file, said, json_of, at,
                items, str, shown)
import std.json (Json, Str)
import std.string

fn fixture(name: String) -> String = repo_file("tests/fixtures/lang/" ++ name ++ ".ply")

type Stated = { test: String, text: String }

// Every `// <word> <first> :: <second>` line of a fixture.
fn stated(source: String, word: String) -> List<Stated> =
  fold(string_split(source, "\n"), [], |acc: List<Stated>, line: String| {
    let lead = "// " ++ word ++ " ";
    if !string_starts_with(line, lead) { acc } else {
      let rest = string_slice(line, string_len(lead), string_len(line));
      match string::split_once(rest, " :: ") {
        Some(p) -> push(acc, { test: string_trim(p.head), text: string_trim(p.tail) }),
        None -> panic("`" ++ word ++ " <name> :: <text>`: " ++ line),
      }
    }
  })

// The message, labels and notes of a diagnostic as one text: the machine labels a span, and
// compiled code, which has none, says the same in a note.
fn carried(d: Json) -> String = {
  let texts = |key: String|
    string::join(
      map(items(at(d, key)), |x: Json| match x { Str(s) -> s, _ -> str(at(x, "message")) }),
      " ",
    );
  str(at(d, "message")) ++ " " ++ texts("labels") ++ " " ++ texts("notes")
}

fn check(name: String, tier_only: Bool) -> Unit = {
  let source = fixture(name);
  let expected = stated(source, "raises");
  assert(len(expected) > 0, Some(name ++ " states no raises"));
  program(source);
  let r = if tier_only {
    spawned(["test", "--json", "--no-cache"], [
      { name: "PLY_C_EMITTER", value: "ply:" ++ repo() ++ "/crates/ply-compiler/ply" },
    ])
  } else { on_disk(["test", "--json", "--no-cache"]) };
  let engine = if tier_only { "the tier" } else { "the machine" };
  let failed = items(at(json_of(r), "failures"));
  fold(expected, (), |u: Unit, e: Stated| {
    let failure = match filter(failed, |f: Json| str(at(f, "name")) == e.test) {
      [f, ..] -> f,
      [] -> panic(name ++ ": `" ++ e.test ++ "` did not fail on " ++ engine ++ ": " ++ said(r)),
    };
    let d = at(failure, "diagnostic");
    assert(
      str(at(d, "code")) == "E0502",
      Some(name ++ ": `" ++ e.test ++ "` on " ++ engine ++ ": " ++ shown(d)),
    );
    assert(
      string_contains(carried(d), e.text),
      Some(
        name ++ ": `" ++ e.test ++ "` on " ++ engine ++ " raised without `" ++ e.text ++ "`: "
          ++ shown(d),
      ),
    )
  });
  assert(
    len(failed) == len(expected),
    Some(name ++ " on " ++ engine ++ ": every failure must be an expected raise: " ++ said(r)),
  )
}

test/nondet "the footprints the checker infers are the ones stated" {
  let source = fixture("footprints");
  let expected = stated(source, "footprint");
  assert(len(expected) > 0, Some("the fixture states footprints"));
  let defs = items(at(json_of(in_memory(one(source), ["check", "--json"])), "definitions"));
  fold(expected, (), |u: Unit, e: Stated| {
    let name = "m." ++ e.test;
    match filter(defs, |d: Json| str(at(d, "name")) == name) {
      [d, ..] -> assert(str(at(d, "footprint")) == e.text, Some("`" ++ name ++ "`: " ++ shown(d))),
      [] -> panic("`" ++ name ++ "` is not reported"),
    }
  })
}

test/nondet "the call bound counts nesting calls only, on both engines" {
  check("recursion_raise", false);
  check("recursion_raise", true)
}

test/nondet "the numeric raises are the same on both engines" {
  check("numbers_raise", false);
  check("numbers_raise", true)
}

test/nondet "the shift and overflow raises are the same on both engines" {
  check("bits_raise", false);
  check("bits_raise", true)
}

test/nondet "a width raises at its type through every binder on both engines" {
  check("widths_raise", false);
  check("widths_raise", true)
}

test/nondet "the byte builtins' raises are the same on both engines" {
  check("bytes_raise", false);
  check("bytes_raise", true)
}

test/nondet "the list update raises are the same on both engines" {
  check("lists_raise", false);
  check("lists_raise", true)
}
