// A map-valued test passes whatever order its maps were built in, and its pass is cached.

import harness (scratch, on_disk, program, stdout)

// The orders are data rather than source, so the second run is a cache read of the same definitions.
fn source() -> String =
  \\fn build(ks: List<Int>) -> Map<Int, Int> =
  \\  fold(ks, map_new(), |m, k| map_insert(m, k, k * 10))
  \\
  \\fn ascending() -> List<Int> = [1, 2, 3, 4, 5]
  \\fn descending() -> List<Int> = [5, 4, 3, 2, 1]
  \\fn shuffled() -> List<Int> = [3, 1, 5, 2, 4]
  \\
  \\test "insertion order does not change the value" {
  \\  assert_eq(build(ascending()), build(descending()));
  \\  assert_eq(build(ascending()), build(shuffled()));
  \\  assert_eq(map_keys(build(shuffled())), [1, 2, 3, 4, 5]);
  \\  assert_eq(map_fold(build(descending()), 0, |acc, k, v| acc * 10 + k), 12345)
  \\}
  \\

test "a test over maps built in different orders passes and then caches" {
  scratch(|| {
    program(source());
    let first = on_disk(["test"]);
    assert(first.code == 0, Some(stdout(first)));
    assert(string_contains(stdout(first), "selected 1 of 1 (0 cached)"), Some(stdout(first)));
    assert(string_contains(stdout(first), "0 failed, 1 passed, 0 cached"), Some(stdout(first)));
    let second = on_disk(["test"]);
    assert(second.code == 0, Some(stdout(second)));
    assert(
      string_contains(stdout(second), "selected 0 of 1 (1 cached)"),
      Some("a map-valued pass must be cacheable:\n" ++ stdout(second)),
    )
  })
}

test "a map-valued program passes with the cache bypassed" {
  scratch(|| {
    program(source());
    let r = on_disk(["test", "--no-cache"]);
    assert(r.code == 0, Some(stdout(r)))
  })
}
