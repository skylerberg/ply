//! A law over maps is discharged, and a refuted one shrinks its witness toward the empty map.

import harness (scratch, on_disk, program, json_of, at, path, nth, items, str, shown)
import std.json (Json, Null)

fn holds() -> String =
  \\fn size(m: Map<String, Int>) -> Int = map_len(m)
  \\
  \\law "a map's key count is its length"
  \\  forall (m: Map<String, Int>) {
  \\    len(map_keys(m)) == size(m)
  \\  }
  \\
  \\law "inserting a key you already have does not grow the map"
  \\  forall (m: Map<String, Int>, k: String, v: Int) where map_contains(m, k) {
  \\    map_len(map_insert(m, k, v)) == map_len(m)
  \\  }
  \\

test "a law over a map is discharged" {
  scratch(|| {
    program(holds());
    let r = on_disk(["prove", "--json"]);
    let v = json_of(r);
    assert(r.code == 0, Some(shown(v)));
    let obligations = items(at(v, "obligations"));
    assert(len(obligations) == 2, Some(shown(v)));
    fold(obligations, (), |u: Unit, o: Json| {
      // A binder the generator refuses reports a gap and no tier, which is what `E0418` looks like.
      assert(
        str(at(o, "tier")) != "",
        Some("a map law must earn a tier rather than a gap: " ++ shown(o)),
      );
      assert(at(o, "gap") == Null, Some(shown(o)))
    });
    // The unguarded law is sampled over the whole domain, so it earns the stronger label.
    assert(str(at(nth(at(v, "obligations"), 0), "tier")) == "property", Some(shown(v)))
  })
}

// Entries shrink before values, so the witness is the smallest map that still breaks the law.
test "a refuted map law shrinks toward the empty map" {
  scratch(|| {
    program(
      \\law "every map is empty"
      \\  forall (m: Map<String, Int>) {
      \\    map_len(m) == 0
      \\  }
      \\
    );
    let r = on_disk(["prove", "--json"]);
    assert(r.code == 1, Some("a false law must fail the run"));
    let o = nth(at(json_of(r), "obligations"), 0);
    assert(str(at(o, "outcome")) == "refuted", Some(shown(o)));
    let binding = nth(path(o, ["counterexample", "bindings"]), 0);
    assert(str(at(binding, "name")) == "m", Some(shown(o)));
    // Any larger witness means the shrinker stopped early or never entered the map.
    assert(str(at(binding, "value")) == "{\"\": 0}", Some(shown(o)));
    assert(
      at(nth(path(o, ["counterexample", "original"]), 0), "value") != at(binding, "value"),
      Some("the witness must have been shrunk, not merely drawn: " ++ shown(o)),
    )
  })
}
