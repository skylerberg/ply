// `ply build` and the `.plyx` it writes: the closure of one entry point and nothing else, the same
// bytes wherever it was built, refused when any part of it is not what was built, and run as its
// source runs. A tampered artifact is resealed, so what refuses it is the check under test and not
// the digest.

import harness (scratch, Source, program, project, write, on_disk, spawned, said, stdout, stderr,
                json_of, at, path, nth, items, str, int, truth, shown, Reached, Shelf)
import compiler.plyx (Header, Section, Placed, decode, encode, digest_of, domain, offset_digest,
                      format)
import cli.gzip (gunzip)
import std.bytes (u32_le, u32_at, hex_of)
import std.fs (fs)
import std.json
import std.json (Json, Null, Array, Str)
import std.string
import std.list (concat, contains)

fn source() -> String =
  \\effect log { write emit[c](msg: String) -> Unit }
  \\
  \\type Colour = | Red | Blue(Int)
  \\
  \\pub fn shade(c: Colour) -> Int = match c { Red -> 0, Blue(n) -> n }
  \\
  \\pub fn even(n: Int) -> Bool = if n == 0 { true } else { odd(n - 1) }
  \\
  \\pub fn odd(n: Int) -> Bool = if n == 0 { false } else { even(n - 1) }
  \\
  \\pub fn announce(msg: String) -> Unit / {log.write[audit]} = log.emit[audit](msg)
  \\
  \\fn unreached() -> Int = 99
  \\
  \\fn main() -> Int =
  \\  shade(Blue(20)) + shade(Blue(21)) + if even(2) { 1 } else { 0 }
  \\
  \\test "shade reads a payload" { assert_eq(shade(Blue(7)), 7) }
  \\
  \\law "even and odd disagree"
  \\  forall (n: Int) where n >= 0 && n < 4 {
  \\    even(n) != odd(n)
  \\  }
  \\

fn bytes_of(file: String) -> Bytes / {fs.read_file[cwd], abort.raise} =
  match fs.read_file[cwd](file) { Some(b) -> b, None -> panic("`" ++ file ++ "` was not written") }

fn put(file: String, b: Bytes) -> Unit / {fs.write_file[cwd], abort.raise} =
  if !fs.write_file[cwd](file, b) { panic("could not write `" ++ file ++ "`") }

// What `ply build` wrote to `out` for the program in the working directory.
fn built_to(out: String) -> Bytes / {Reached, Shelf, abort.raise} = {
  let r = on_disk(["build", ".", "-o", out]);
  assert(r.code == 0, Some(said(r)));
  bytes_of(out)
}

fn built() -> Bytes / {Reached, Shelf, abort.raise} = built_to("m.plyx")

fn ran(file: String) -> Json / {Reached, Shelf, abort.raise} =
  json_of(on_disk(["run", file, "--json"]))

// `b` written to `file` and run.
fn ran_bytes(file: String, b: Bytes) -> Json / {Reached, Shelf, abort.raise} = {
  put(file, b);
  ran(file)
}

fn diagnostic(report: Json) -> Json = nth(at(report, "diagnostics"), 0)

fn code_of(report: Json) -> String = str(at(diagnostic(report), "code"))

fn refused(report: Json) -> Bool = at(report, "ok") == json::Bool(false)

// --- The artifact as the container lays it out --------------------------------

// The header a writer supplies and each section's payload, in the order the file holds them.
type Parts = { head: Header, sections: List<Section> }

fn parts_of(b: Bytes) -> Parts / {abort.raise} =
  match decode(b) {
    Err(e) -> panic("the artifact does not open: " ++ string_of_bytes_lossy(e.message)),
    Ok(o) ->
      {
        head: { frontend: o.frontend, runtime: o.runtime, stdlib: o.stdlib, entry: o.entry },
        sections: map(o.sections, |p: Placed|
          { name: p.name, count: p.count, payload: bytes_slice(b, p.at, p.at + p.len) }),
      },
  }

// Where the container placed each section of `b`.
fn parts_placed(b: Bytes) -> List<Placed> / {abort.raise} =
  match decode(b) {
    Err(e) -> panic("the artifact does not open: " ++ string_of_bytes_lossy(e.message)),
    Ok(o) -> o.sections,
  }

// Laid out and sealed as `ply build` writes one, so a reader checks it as it would a build.
fn sealed(parts: Parts) -> Bytes / {abort.raise} = {
  let laid = encode(parts.head, parts.sections);
  match digest_of(domain(), laid) {
    None -> panic("a container this short carries no digest"),
    Some(d) ->
      bytes_concat_all([
        bytes_slice(laid, 0, offset_digest()),
        d,
        bytes_slice(laid, offset_digest() + 32, bytes_len(laid)),
      ]),
  }
}

fn section(parts: Parts, name: Bytes) -> Section / {abort.raise} =
  match filter(parts.sections, |s: Section| s.name == name) {
    [s, ..] -> s,
    [] -> panic("the artifact carries no `" ++ string_of_bytes(name) ++ "` section"),
  }

fn replaced(parts: Parts, s: Section) -> Parts =
  { ..parts, sections: map(parts.sections, |x: Section| if x.name == s.name { s } else { x }) }

fn word(b: Bytes, i: Int) -> Int / {abort.raise} =
  match u32_at(b, i) { Some(w) -> w, None -> panic("a record runs past its section") }

type Body = { hash: Bytes, body: Bytes }

// Each record is the hash, the body's length, and the body.
fn bodies_of(parts: Parts) -> List<Body> / {abort.raise} = {
  let s = section(parts, b"bodies");
  let walked = fold(
    range(0, s.count),
    { at: 0, out: [] },
    |acc: { at: Int, out: List<Body> }, _i: Int| {
      let n = word(s.payload, acc.at + 32);
      {
        at: acc.at + 36 + n,
        out: push(acc.out, {
          hash: bytes_slice(s.payload, acc.at, acc.at + 32),
          body: bytes_slice(s.payload, acc.at + 36, acc.at + 36 + n),
        }),
      }
    },
  );
  walked.out
}

fn with_bodies(parts: Parts, bodies: List<Body>) -> Parts / {abort.raise} =
  replaced(parts, {
    name: b"bodies",
    count: len(bodies),
    payload: bytes_concat_all(
      map(bodies, |b: Body| bytes_concat_all([b.hash, u32_le(bytes_len(b.body)), b.body])),
    ),
  })

type Named = { name: String, hash: Bytes }

// Each record is where its name lies in the string section, the name's length, and the hash.
fn names_of(parts: Parts) -> List<Named> / {abort.raise} = {
  let s = section(parts, b"names");
  let strings = section(parts, b"strings").payload;
  map(range(0, s.count), |i: Int| {
    let off = word(s.payload, i * 40);
    {
      name: string_of_bytes(bytes_slice(strings, off, off + word(s.payload, i * 40 + 4))),
      hash: bytes_slice(s.payload, i * 40 + 8, i * 40 + 40),
    }
  })
}

// Each name's text is written once, in record order, as the writer lays the string section out.
fn with_names(parts: Parts, names: List<Named>) -> Parts / {abort.raise} = {
  let laid = fold(
    names,
    { strings: b"", placed: map_new(), records: [] },
    |acc: { strings: Bytes, placed: Map<String, Int>, records: List<Bytes> }, named: Named| {
      let known = map_get(acc.placed, named.name);
      let offset = match known { Some(o) -> o, None -> bytes_len(acc.strings) };
      let text = bytes_of_string(named.name);
      {
        strings: match known { Some(_) -> acc.strings, None -> bytes_concat(acc.strings, text) },
        placed: map_insert(acc.placed, named.name, offset),
        records: push(
          acc.records,
          bytes_concat_all([u32_le(offset), u32_le(bytes_len(text)), named.hash]),
        ),
      }
    },
  );
  replaced(
    replaced(parts, { name: b"names", count: len(names), payload: bytes_concat_all(laid.records) }),
    { name: b"strings", count: bytes_len(laid.strings), payload: laid.strings },
  )
}

// Each record is a module's path and its text, each after its length.
fn shipped_files(parts: Parts) -> List<Source> / {abort.raise} = {
  let s = section(parts, b"closure");
  let walked = fold(
    range(0, s.count),
    { at: 0, out: [] },
    |acc: { at: Int, out: List<Source> }, _i: Int| {
      let path_len = word(s.payload, acc.at);
      let text_at = acc.at + 8 + path_len;
      let text_len = word(s.payload, acc.at + 4 + path_len);
      {
        at: text_at + text_len,
        out: push(acc.out, {
          path: string_of_bytes(bytes_slice(s.payload, acc.at + 4, acc.at + 4 + path_len)),
          text: string_of_bytes(bytes_slice(s.payload, text_at, text_at + text_len)),
        }),
      }
    },
  );
  walked.out
}

fn with_files(parts: Parts, files: List<Source>) -> Parts / {abort.raise} =
  replaced(parts, {
    name: b"closure",
    count: len(files),
    payload: bytes_concat_all(
      map(files, |f: Source| {
        let file = bytes_of_string(f.path);
        let text = bytes_of_string(f.text);
        bytes_concat_all([u32_le(bytes_len(file)), file, u32_le(bytes_len(text)), text])
      }),
    ),
  })

// What the runnable holds, unpacked: its files, its front end's answer and its unit's C, each
// spelled out in the value encoding.
fn runnable_text(parts: Parts) -> String / {abort.raise} =
  match gunzip(section(parts, b"runnable").payload) {
    Ok(b) -> string_of_bytes_lossy(b),
    Err(why) -> panic("the runnable does not unpack: " ++ why),
  }

fn filled(byte: Int) -> Bytes / {abort.raise} =
  bytes_concat_all(map(range(0, 32), |_i: Int| byte_of_int(byte)))

// --- Tests --------------------------------------------------------------------

// What the tamper tests below rest on: an artifact read back and written again is the artifact.
test "an artifact read back section by section and written again is the same bytes" {
  scratch(|| {
    program(source());
    let b = built();
    let p = parts_of(b);
    assert(sealed(p) == b, Some("resealing moved the bytes"));
    let rewritten = with_files(
      with_names(with_bodies(p, bodies_of(p)), names_of(p)),
      shipped_files(p),
    );
    assert(sealed(rewritten) == b, Some("a section read and written back moved the bytes"));
    assert(truth(at(ran_bytes("again.plyx", sealed(rewritten)), "ok")), None)
  })
}

// Where a program was built and what its cache held are not in what was built.
test "two builds from two roots are byte-identical" {
  scratch(|| {
    project([{ path: "cold/m.ply", text: source() }, { path: "warm/m.ply", text: source() }]);
    let warmed = on_disk(["test", "warm"]);
    assert(warmed.code == 0, Some(said(warmed)));
    assert(fs.exists[cwd]("warm/.ply-cache"), Some("the second root's cache should be warm"));
    assert(on_disk(["build", "cold", "-o", "cold.plyx"]).code == 0, None);
    assert(on_disk(["build", "warm", "-o", "warm.plyx"]).code == 0, None);
    assert(bytes_of("cold.plyx") == bytes_of("warm.plyx"), None);
    let cold = on_disk(["build", "cold", "--digest"]).out;
    assert(cold == on_disk(["build", "warm", "--digest"]).out, None);
    let digest = string::join(cold, "");
    assert(string_starts_with(digest, "b3:") && string_len(digest) == 15, Some(digest))
  })
}

// Once in this process and once in a `ply` of its own, so neither decides the bytes.
test/nondet "ply build twice writes the same bytes" {
  program(source());
  let one = built_to("one.plyx");
  let two = spawned(["build", ".", "-o", "two.plyx"], []);
  assert(two.code == 0, Some(said(two)));
  assert(one == bytes_of("two.plyx"), None)
}

test "an artifact carries no test, no law and nothing unreached" {
  scratch(|| {
    program(source());
    let b = built();
    let p = parts_of(b);
    let names = map(names_of(p), |n: Named| n.name);
    let listed = string::join(names, ", ");
    assert(
      contains(names, "m.main") && contains(names, "m.shade") && contains(names, "m.Colour"),
      Some(listed),
    );
    assert(contains(names, "m.even") && contains(names, "m.odd"), Some(listed));
    assert(
      !contains(names, "m.unreached"),
      Some("a definition nothing reaches is not in the closure: " ++ listed),
    );
    assert(
      !contains(names, "m.announce") && !contains(names, "m.log"),
      Some("only what `main` reaches: " ++ listed),
    );
    assert(
      len(filter(names, |n: String| string_contains(n, "ply_tests"))) == 0,
      Some("no test key may appear: " ++ listed),
    );
    // A test or a law is declared by its name, so a closure that spells neither declares neither.
    let shipped = [string_of_bytes_lossy(b), runnable_text(p)];
    fold(
      ["unreached", "announce", "shade reads a payload", "even and odd disagree"],
      (),
      |u: Unit, w: String|
        fold(shipped, u, |v: Unit, text: String|
          assert(!string_contains(text, w), Some("`" ++ w ++ "` shipped"))),
    )
  })
}

test "every body is filed under the hash the hash command prints" {
  scratch(|| {
    program(source());
    let report = json_of(on_disk(["hash", ".", "--json"]));
    let p = parts_of(built());
    let names = names_of(p);
    let bodies = map(bodies_of(p), |b: Body| hex_of(b.hash));
    let checked = fold(items(at(report, "definitions")), 0, |n: Int, e: Json|
      match filter(names, |x: Named| x.name == str(at(e, "name"))) {
        [filed, ..] -> {
          assert(
            hex_of(filed.hash) == str(at(e, "hash")),
            Some("`" ++ filed.name ++ "` is filed under a different hash"),
          );
          assert(contains(bodies, hex_of(filed.hash)), Some("`" ++ filed.name ++ "` has no body"));
          n + 1
        },
        [] -> n,
      });
    assert(checked >= 4, Some("only " ++ int_to_string(checked) ++ " definitions were compared"))
  })
}

test "an artifact runs to the same value as its source" {
  scratch(|| {
    program(source());
    let from_source = on_disk(["run", "m.ply"]);
    assert(from_source.code == 0, Some(said(from_source)));
    let _ = built();
    let from_artifact = on_disk(["run", "m.plyx"]);
    assert(from_artifact.code == 0, Some(said(from_artifact)));
    assert(string_contains(stdout(from_source), "42"), Some(stdout(from_source)));
    assert(string_contains(stdout(from_artifact), "42"), Some(stdout(from_artifact)))
  })
}

test "an artifact run binds nothing without host" {
  scratch(|| {
    program(source());
    let _ = built();
    let report = ran("m.plyx");
    assert(str(at(report, "binding")) == "hermetic", Some(shown(report)))
  })
}

test "a failure in an artifact carries no line number" {
  scratch(|| {
    program("fn main() -> Int / {abort.raise} = 1 / 0\n");
    let _ = built();
    let from_source = ran("m.ply");
    let d = diagnostic(from_source);
    assert(int(path(nth(at(d, "labels"), 0), ["start", "line"])) == 1, Some(shown(from_source)));
    assert(
      str(at(d, "message")) == "division by zero",
      Some("the program's own failure, not the seam's: " ++ shown(from_source)),
    );
    let failed = ran("m.plyx");
    assert(refused(failed), Some(shown(failed)));
    assert(code_of(failed) == code_of(from_source), Some(shown(failed)));
    assert(path(nth(at(diagnostic(failed), "labels"), 0), ["start"]) == Null, Some(shown(failed)))
  })
}

test "a closure that is not the closure is refused" {
  scratch(|| {
    program(source());
    let p = parts_of(built());
    let files = shipped_files(p);
    let altered = map(files, |f: Source|
      { ..f, text: string::replace(f.text, "Blue(20)", "Blue(19)") });
    assert(altered != files, Some("the closure spells the literal"));
    let garbled = match files {
      [f, ..rest] -> concat([{ ..f, text: "fn (" }], rest),
      [] -> panic("the closure is empty"),
    };
    fold(
      [{ what: "altered", files: altered }, { what: "garbled", files: garbled }],
      (),
      |u: Unit, c: { what: String, files: List<Source> }| {
        let report = ran_bytes("t.plyx", sealed(with_files(p, c.files)));
        assert(
          code_of(report) == "E0443",
          Some(
            "a closure that is not the program must not be believed (" ++ c.what ++ "): "
              ++ shown(report),
          ),
        )
      },
    )
  })
}

// A runnable is held to the artifact around it: one another build wrote is not this program.
test "a runnable that is not the artifact's is refused" {
  scratch(|| {
    program(source());
    let p = parts_of(built());
    program("fn main() -> Int = 7\n");
    let other = parts_of(built_to("other.plyx"));
    let report = ran_bytes("t.plyx", sealed(replaced(p, section(other, b"runnable"))));
    assert(code_of(report) == "E0443", Some(shown(report)))
  })
}

test "a flipped bit in a body is E0443 naming the definition" {
  scratch(|| {
    program(source());
    let b = built();
    // The first record is where the container placed the bodies; its payload, past the 32-byte key and
    // length prefix.
    let record = match filter(parts_placed(b), |s: Placed| s.name == b"bodies") {
      [s, ..] -> s.at,
      [] -> panic("the artifact carries no bodies"),
    };
    let flipped = bytes_concat_all([
      bytes_slice(b, 0, record + 36),
      byte_of_int(bytes_at(b, record + 36) ^ 0x40),
      bytes_slice(b, record + 37, bytes_len(b)),
    ]);
    let report = ran_bytes("bad.plyx", flipped);
    assert(refused(report), Some(shown(report)));
    assert(code_of(report) == "E0443", Some(shown(report)));
    let message = str(at(diagnostic(report), "message"));
    assert(string_contains(message, "offset " ++ int_to_string(record)), Some(message));
    let first = match bodies_of(parts_of(b)) {
      [x, ..] -> x,
      [] -> panic("the artifact carries no body"),
    };
    assert(string_contains(message, string_slice(hex_of(first.hash), 0, 12)), Some(message))
  })
}

test "no prefix of an artifact is believed" {
  scratch(|| {
    program(source());
    let b = built();
    let n = bytes_len(b);
    fold([0, 1, 100, 187, 188, 200, n / 2, n - 1], (), |u: Unit, cut: Int| {
      let report = ran_bytes("t.plyx", bytes_slice(b, 0, cut));
      assert(code_of(report) == "E0443", Some("at " ++ int_to_string(cut) ++ ": " ++ shown(report)))
    });
    assert(truth(at(ran_bytes("t.plyx", b), "ok")), None)
  })
}

test "removing a body is E0443" {
  scratch(|| {
    program(source());
    let p = parts_of(built());
    let victim = match filter(names_of(p), |named: Named| named.name == "m.shade") {
      [named, ..] -> named.hash,
      [] -> panic("`shade` is in the closure"),
    };
    let without = sealed(
      with_names(
        with_bodies(p, filter(bodies_of(p), |b: Body| b.hash != victim)),
        filter(names_of(p), |named: Named| named.hash != victim),
      ),
    );
    assert(
      match decode(without) { Ok(_) -> true, Err(_) -> false },
      Some("the container still verifies"),
    );
    let report = ran_bytes("open.plyx", without);
    assert(code_of(report) == "E0443", Some(shown(report)))
  })
}

// Rebuild the artifact versus transfer it again: opposite responses, so two codes.
test "another compiler or runtime is E0444 and not E0443" {
  scratch(|| {
    program(source());
    let p = parts_of(built());
    fold(
      [
        { what: "compiler", head: { ..p.head, frontend: filled(7) } },
        { what: "runtime", head: { ..p.head, runtime: filled(7) } },
      ],
      (),
      |u: Unit, c: { what: String, head: Header }| {
        let report = ran_bytes("old.plyx", sealed({ ..p, head: c.head }));
        assert(code_of(report) == "E0444", Some("another " ++ c.what ++ ": " ++ shown(report)))
      },
    )
  })
}

test "a differing stdlib digest is W0605 and the run proceeds" {
  scratch(|| {
    program(source());
    let p = parts_of(built());
    put("std.plyx", sealed({ ..p, head: { ..p.head, stdlib: filled(11) } }));
    let r = on_disk(["run", "std.plyx", "--json"]);
    let report = json_of(r);
    assert(truth(at(report, "ok")), Some(shown(report)));
    assert(str(at(report, "value")) == "42", Some(shown(report)));
    assert(string_contains(said(r), "W0605"), Some(said(r)))
  })
}

test "a file that is not an artifact says so" {
  scratch(|| {
    program(source());
    assert(code_of(ran_bytes("junk.plyx", b"not a program at all")) == "E0443", None)
  })
}

test "the digest is one line and agrees with the build" {
  scratch(|| {
    program(source());
    let printed = on_disk(["build", ".", "--digest"]).out;
    assert(len(printed) == 1, Some(string::join(printed, "\n")));
    let digest = string::trim(string::join(printed, ""));
    assert(string_starts_with(digest, "b3:") && string_len(digest) == 15, Some(digest));
    assert(!fs.exists[cwd]("m.plyx"), Some("`--digest` writes no file"));
    let report = json_of(on_disk(["build", ".", "-o", "m.plyx", "--json"]));
    assert(str(at(report, "digest")) == digest, Some(shown(report)))
  })
}

test "the digest moves with the closure and with nothing else" {
  scratch(|| {
    program(source());
    let before = built();
    fold(
      [
        {
          what: "an unreached definition",
          edited: string::replace(
            source(),
            "fn unreached() -> Int = 99",
            "fn unreached() -> Int = 98",
          ),
        },
        {
          what: "a new unreached type",
          edited: source() ++ "\ntype Spare = | Unused | Kept(Int)\n",
        },
        {
          what: "a test",
          edited: string::replace(
            source(),
            "assert_eq(shade(Blue(7)), 7)",
            "assert_eq(shade(Blue(8)), 8)",
          ),
        },
        { what: "a law", edited: string::replace(source(), "n >= 0 && n < 4", "n >= 0 && n < 5") },
        {
          what: "a local's name",
          edited: string::replace(source(), "Blue(n) -> n", "Blue(k) -> k"),
        },
      ],
      (),
      |u: Unit, e: { what: String, edited: String }| {
        assert(e.edited != source(), Some(e.what ++ ": the edit did not apply"));
        write("m.ply", e.edited);
        assert(built() == before, Some(e.what ++ " moved the artifact"))
      },
    );
    write("m.ply", string::replace(source(), "Blue(21)", "Blue(22)"));
    assert(digest_of(domain(), built()) != digest_of(domain(), before), None)
  })
}

test "diff reports added, changed, dropped and what a change is reached by" {
  scratch(|| {
    program(source());
    let _ = built_to("old.plyx");
    write(
      "m.ply",
      string::replace(
        string::replace(source(), "Red -> 0", "Red -> 1"),
        "fn unreached() -> Int = 99",
        "fn restock() -> Int = 1\nfn unreached() -> Int = 99",
      ),
    );
    let report = json_of(on_disk(["build", ".", "--diff", "old.plyx", "--json"]));
    let changed = map(items(at(report, "changed")), str);
    assert(contains(changed, "m.shade"), Some(shown(report)));
    assert(
      contains(changed, "m.main"),
      Some("changing a callee changes its caller: " ++ shown(report)),
    );
    assert(items(at(report, "added")) == [], Some(shown(report)));
    assert(items(at(report, "dropped")) == [], Some(shown(report)));
    // The reverse closure: every definition that reaches a changed one, and a definition reaches itself.
    let reached = map(items(at(report, "reached")), str);
    fold(changed, (), |u: Unit, name: String|
      assert(contains(reached, name), Some(name ++ " does not reach itself")));
    assert(contains(reached, "m.main"), Some(shown(report)));
    assert(!contains(reached, "m.Colour"), Some("a type reaches no function"));
    assert(int(at(report, "artifact_bytes")) > 0, Some(shown(report)))
  })
}

test "diff counts an addition and a removal" {
  scratch(|| {
    program("fn helper() -> Int = 1\nfn main() -> Int = helper()\n");
    let _ = built_to("old.plyx");
    write("m.ply", "fn other() -> Int = 2\nfn main() -> Int = other()\n");
    let report = json_of(on_disk(["build", ".", "--diff", "old.plyx", "--json"]));
    assert(at(report, "added") == Array([Str("m.other")]), Some(shown(report)));
    assert(at(report, "dropped") == Array([Str("m.helper")]), Some(shown(report)));
    assert(at(report, "changed") == Array([Str("m.main")]), Some(shown(report)))
  })
}

test "a rename moves a name and no hash" {
  scratch(|| {
    program("fn helper() -> Int = 1\nfn main() -> Int = helper()\n");
    let before = parts_of(built_to("old.plyx"));
    write("m.ply", "fn assistant() -> Int = 1\nfn main() -> Int = assistant()\n");
    let report = json_of(on_disk(["build", ".", "--diff", "old.plyx", "--json"]));
    assert(at(report, "added") == Array([Str("m.assistant")]), Some(shown(report)));
    assert(at(report, "dropped") == Array([Str("m.helper")]), Some(shown(report)));
    assert(at(report, "changed") == Array([]), Some(shown(report)));
    assert(
      bodies_of(before) == bodies_of(parts_of(built_to("new.plyx"))),
      Some("a rename may not move a body"),
    )
  })
}

// The directory built and run, and the value its artifact ran to, which its source runs to too.
fn runs_as_its_source() -> Json / {Reached, Shelf, abort.raise} = {
  let _ = built_to("app.plyx");
  let from_source = ran(".");
  let from_artifact = ran("app.plyx");
  assert(truth(at(from_source, "ok")), Some(shown(from_source)));
  assert(at(from_artifact, "value") == at(from_source, "value"), Some(shown(from_artifact)));
  at(from_artifact, "value")
}

test "modules sharing a last segment ship and run" {
  scratch(|| {
    project([
      { path: "left/util.ply", text: "pub fn one() -> Int = 1\n" },
      { path: "right/util.ply", text: "pub fn two() -> Int = 20\n" },
      {
        path: "m.ply",
        text: "import left.util as l\nimport right.util as r\n\nfn main() -> Int = l::one() + r::two()\n",
      },
    ]);
    assert(runs_as_its_source() == Str("21"), None);
    let files = map(shipped_files(parts_of(bytes_of("app.plyx"))), |f: Source| f.path);
    assert(files == ["left/util.ply", "m.ply", "right/util.ply"], Some(string::join(files, ", ")))
  })
}

test "two names for one body ship and run" {
  scratch(|| {
    program("fn one() -> Int = 1\nfn uno() -> Int = 1\nfn main() -> Int = one() + uno() * 10\n");
    assert(runs_as_its_source() == Str("11"), None);
    let names = names_of(parts_of(bytes_of("app.plyx")));
    let hash = |name: String|
      map(filter(names, |named: Named| named.name == name), |named: Named| hex_of(named.hash));
    assert(hash("m.one") != [], Some(string::join(map(names, |named: Named| named.name), ", ")));
    assert(hash("m.one") == hash("m.uno"), Some("one body, two names"))
  })
}

// Run as a process: the binary a build measures is the one that runs it.
test/nondet "the build prints the artifact's size beside the binary's" {
  program(source());
  let printed = stdout(spawned(["build", ".", "-o", "m.plyx"], []));
  assert(string_contains(printed, "artifact"), Some(printed));
  assert(string_contains(printed, "binary"), Some(printed));
  let report = json_of(spawned(["build", ".", "-o", "m.plyx", "--json"], []));
  assert(int(at(report, "format")) == format(), Some(shown(report)));
  assert(json::get(report, "sources") == None, Some(shown(report)));
  let artifact_bytes = int(at(report, "artifact_bytes"));
  let binary_bytes = int(at(report, "binary_bytes"));
  assert(artifact_bytes == bytes_len(bytes_of("m.plyx")), Some(shown(report)));
  assert(
    binary_bytes > artifact_bytes,
    Some(
      "the ratio the whole-artifact decision argued from: artifact "
        ++ int_to_string(artifact_bytes)
        ++ ", binary "
        ++ int_to_string(binary_bytes),
    ),
  )
}

test "entry names the closure and ambiguity is refused" {
  scratch(|| {
    project([
      { path: "a.ply", text: "fn main() -> Int = 1\n" },
      { path: "b.ply", text: "fn main() -> Int = 2\n" },
    ]);
    assert(on_disk(["build", "."]).code != 0, None);
    let r = on_disk(["build", ".", "--entry", "a.main", "-o", "a.plyx"]);
    assert(r.code == 0, Some(said(r)));
    assert(str(at(ran("a.plyx"), "value")) == "1", None)
  })
}

test "entry can name something other than main" {
  scratch(|| {
    program("fn serve() -> Int = 7\nfn main() -> Int = 1\n");
    let report = json_of(on_disk(["build", ".", "--entry", "serve", "-o", "s.plyx", "--json"]));
    assert(str(at(report, "entry")) == "m.serve", Some(shown(report)));
    assert(str(at(ran("s.plyx"), "value")) == "7", None)
  })
}

test "the default output is named after the module" {
  scratch(|| {
    program(source());
    assert(on_disk(["build", "."]).code == 0, None);
    assert(fs.exists[cwd]("m.plyx"), None)
  })
}

test "a program that does not check produces no artifact" {
  scratch(|| {
    program("fn main() -> Int = true\n");
    assert(on_disk(["build", ".", "-o", "m.plyx"]).code == 2, None);
    assert(!fs.exists[cwd]("m.plyx"), None)
  })
}

test "the output directory is created" {
  scratch(|| {
    program(source());
    assert(on_disk(["build", ".", "-o", "dist/nested/m.plyx"]).code == 0, None);
    assert(fs.exists[cwd]("dist/nested/m.plyx"), None)
  })
}

fn service() -> String =
  \\import std.net (net)
  \\
  \\fn main() -> Int / {net.write[listener]} = net.listen[listener](0)
  \\

test "an artifact keeps the names a host handler is registered against" {
  scratch(|| {
    program(service());
    let _ = built_to("svc.plyx");
    let from_source = ran("m.ply");
    let from_artifact = ran("svc.plyx");
    assert(code_of(from_source) == "E0424", Some(shown(from_source)));
    assert(code_of(from_artifact) == code_of(from_source), Some(shown(from_artifact)));
    let message = str(at(diagnostic(from_artifact), "message"));
    assert(
      string_contains(message, "std.net.net.listen[listener]"),
      Some("the artifact lost the name a handler is registered against: " ++ message),
    );
    assert(
      path(nth(at(diagnostic(from_artifact), "labels"), 0), ["start"]) == Null,
      Some(shown(from_artifact)),
    )
  })
}

test "the entry point keeps its program-wide name" {
  scratch(|| {
    program(source());
    let report = json_of(on_disk(["build", ".", "-o", "m.plyx", "--json"]));
    assert(str(at(report, "entry")) == "m.main", Some(shown(report)));
    let p = parts_of(bytes_of("m.plyx"));
    assert(
      map(filter(names_of(p), |named: Named| named.hash == p.head.entry), |named: Named| named.name)
        == ["m.main"],
      None,
    );
    assert(str(at(ran("m.plyx"), "value")) == "42", None)
  })
}

test "an entry point that takes an argument is refused" {
  scratch(|| {
    program("fn serve(port: Int) -> Int = port\nfn main() -> Int = serve(1)\n");
    let report = json_of(on_disk(["build", ".", "--entry", "serve", "--json"]));
    assert(refused(report), Some(shown(report)));
    assert(code_of(report) == "E0201", Some(shown(report)));
    assert(!fs.exists[cwd]("m.plyx"), None)
  })
}

fn ready() -> String =
  \\import std.signal (signal)
  \\
  \\pub fn ready() -> Int / {signal.read} = if signal.stopping() { 503 } else { 200 }
  \\
  \\fn main() -> Int / {signal.read} = ready()
  \\

// Spawned: `--host` binds the signal handler of the process the run is in.
test/nondet "an artifact run binds the signal handler a source run binds" {
  program(ready());
  let _ = built();
  let source = json_of(spawned(["run", "m.ply", "--host", "--trace", "off", "--json"], []));
  let shipped = json_of(spawned(["run", "m.plyx", "--host", "--trace", "off", "--json"], []));
  assert(truth(at(source, "ok")), Some(shown(source)));
  assert(truth(at(shipped, "ok")), Some(shown(shipped)));
  assert(at(shipped, "value") == at(source, "value"), None);
  assert(str(at(shipped, "value")) == "200", Some(shown(shipped)));
  // Reported the same way, so a deployment reads one `shutdown` shape whichever form it shipped.
  assert(path(shipped, ["shutdown", "requested"]) == json::Bool(false), Some(shown(shipped)));
  assert(
    path(shipped, ["shutdown", "drain_ms"]) == path(source, ["shutdown", "drain_ms"]),
    Some(shown(shipped)),
  );
  assert(int(path(shipped, ["shutdown", "spans_left_open"])) == 0, Some(shown(shipped)));
  // Without `--host` it is still `E0424`: the flag is the only way out.
  let hermetic = ran("m.plyx");
  assert(refused(hermetic), Some(shown(hermetic)));
  assert(code_of(hermetic) == "E0424", Some(shown(hermetic)))
}

// A configuration schema, the entry point, and a definition only the schema reaches.
fn with_schema() -> String =
  \\import std.config
  \\
  \\pub fn required_keys() -> List<config::Key> = [
  \\  {name: "API_KEY", shape: config::SSecret, required: true, default: None},
  \\]
  \\
  \\pub fn spec() -> config::ConfigSpec = {keys: required_keys()}
  \\
  \\fn main() -> Int = 1
  \\

// The runs are spawned: a configuration is read from the environment of the process it starts in.
test/nondet "a config schema named at build time is in the artifact and still refuses" {
  program(with_schema());
  // Without the flag the schema is outside the closure, so naming it at run is a refusal.
  assert(on_disk(["build", "-o", "bare.plyx"]).code == 0, None);
  let bare_run = json_of(
    spawned(["run", "bare.plyx", "--host", "--config-schema", "m.spec", "--json"], []),
  );
  assert(refused(bare_run), Some(shown(bare_run)));
  assert(code_of(bare_run) == "E0440", Some(shown(bare_run)));
  assert(
    string_contains(
      str(at(diagnostic(bare_run), "message")),
      "names no definition in this program",
    ),
    Some(
      "the schema is absent from the artifact, rather than entered and declined: "
        ++ shown(bare_run),
    ),
  );
  // Named at build time, the schema ships, and the artifact refuses to start on the missing key as
  // the source does.
  let build = stdout(on_disk(["build", "--config-schema", "m.spec", "-o", "with.plyx"]));
  assert(string_contains(build, "startup m.spec"), Some(build));
  let missing = json_of(
    spawned(["run", "with.plyx", "--host", "--config-schema", "m.spec", "--json"], []),
  );
  assert(refused(missing), Some(shown(missing)));
  assert(code_of(missing) == "E0441", Some(shown(missing)));
  // And starts once the key is supplied: the schema is applied, not merely present.
  let served = json_of(
    spawned(
      [
        "run",
        "with.plyx",
        "--host",
        "--config-schema",
        "m.spec",
        "--set",
        "API_KEY=hunter2",
        "--trace",
        "off",
        "--json",
      ],
      [],
    ),
  );
  assert(truth(at(served, "ok")), Some(shown(served)));
  // The extra definitions are the schema's closure and nothing else.
  let bare = json_of(on_disk(["build", "--json", "-o", "b2.plyx"]));
  let schemed = json_of(on_disk(["build", "--json", "--config-schema", "m.spec", "-o", "w2.plyx"]));
  assert(items(at(bare, "startup")) == [], Some(shown(bare)));
  assert(str(nth(at(schemed, "startup"), 0)) == "m.spec", Some(shown(schemed)));
  assert(
    int(at(schemed, "definitions")) > int(at(bare, "definitions")),
    Some("the schema's closure is in the artifact: " ++ shown(bare) ++ " vs " ++ shown(schemed)),
  );
  assert(
    at(bare, "digest") != at(schemed, "digest"),
    Some("an artifact that carries a schema is a different artifact"),
  );
  // And it is still the closure of its roots: no test, no law, no fixture.
  let names = map(names_of(parts_of(bytes_of("w2.plyx"))), |n: Named| n.name);
  assert(
    len(filter(names, |n: String| string_contains(n, "test"))) == 0,
    Some(string::join(names, ", ")),
  )
}

test "a build schema that names nothing is refused at build time" {
  scratch(|| {
    program(with_schema());
    let out = on_disk(["build", "--config-schema", "m.absent", "-o", "x.plyx"]);
    assert(out.code != 0, Some(said(out)));
    assert(string_contains(said(out), "E0440"), Some(said(out)));
    assert(string_contains(said(out), "this program has: m.spec"), Some(said(out)));
    assert(!fs.exists[cwd]("x.plyx"), None)
  })
}

// Exits 7 when its caller bound a program to `cc` and 9 when it did not, and starts nothing.
fn asks_for_cc() -> String =
  \\import std.process (process)
  \\
  \\fn main() -> Unit / {process.bound[cc], process.exit[proc]} =
  \\  process.exit[proc](if process.bound[cc]() { 7 } else { 9 })
  \\

// `ply run` over an artifact answers from its own `--exec`. Spawned, since the program exits.
test/nondet "an artifact asks whether its caller bound the label it would start" {
  program(asks_for_cc());
  let _ = built();
  fold(
    [{ exec: ["--exec", "cc=/bin/sh"], code: 7 }, { exec: [], code: 9 }],
    (),
    |u: Unit, c: { exec: List<String>, code: Int }| {
      let out = spawned(concat(["run", "m.plyx", "--host"], c.exec), []);
      assert(
        out.code == c.code,
        Some("run with " ++ string::join(c.exec, " ") ++ ":\n" ++ stderr(out)),
      )
    },
  )
}

// --- Signing ---------------------------------------------------------------------

test "a signed artifact runs under --require-signer, and an unsigned or wrongly signed one is E0460" {
  scratch(|| {
    program(source());
    let made = on_disk(["keygen", "release.key", "--json"]);
    assert(made.code == 0, Some(said(made)));
    assert(on_disk(["keygen", "other.key"]).code == 0, None);
    assert(on_disk(["keygen", "release.key"]).code != 0, Some("a key was written over"));
    let _ = built();
    let trusting = |keys: List<String>|
      json_of(
        on_disk(
          concat(
            ["run", "m.plyx", "--json"],
            fold(keys, [], |acc: List<String>, k: String| concat(acc, ["--require-signer", k])),
          ),
        ),
      );
    let unsigned = trusting(["release.key.pub"]);
    assert(code_of(unsigned) == "E0460", Some(shown(unsigned)));

    let signed = on_disk(["build", ".", "-o", "m.plyx", "--sign", "release.key", "--json"]);
    assert(signed.code == 0, Some(said(signed)));
    assert_eq(str(at(json_of(signed), "signed_by")), str(at(json_of(made), "key")));
    let ok = trusting(["release.key.pub"]);
    assert(!refused(ok), Some(shown(ok)));
    let elsewhere = trusting(["other.key.pub"]);
    assert(code_of(elsewhere) == "E0460", Some(shown(elsewhere)));
    assert(!refused(trusting(["other.key.pub", "release.key.pub"])), None);
    // A secret key is not a public one.
    assert_eq(code_of(trusting(["release.key"])), "E0462");

    // The same bytes verify; a build of other sources leaves the signature vouching for bytes it no
    // longer sits beside.
    let verified = on_disk(["build", ".", "-o", "m.plyx", "--verify", "--json"]);
    assert(verified.code == 0, Some(said(verified)));
    assert_eq(map(items(at(json_of(verified), "signers")), str), [str(at(json_of(made), "key"))]);
    write("m.ply", string::replace(source(), "Blue(21)", "Blue(22)"));
    let moved = json_of(on_disk(["build", ".", "-o", "m.plyx", "--verify", "--json"]));
    assert(
      code_of(moved) == "E0461" && string_contains(shown(moved), "these sources build"),
      Some(shown(moved)),
    );
    let _ = built();
    let stale = trusting(["release.key.pub"]);
    assert(code_of(stale) == "E0460", Some(shown(stale)));
    assert(string_contains(shown(stale), "vouch for"), Some(shown(stale)))
  })
}
