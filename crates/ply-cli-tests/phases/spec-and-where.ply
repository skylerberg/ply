// `requires`/`ensures` in both orders, a `where` with two constraints, and a `decreases` measure.
fn f<a, b>(x: a, y: b) -> Int
  where derivable(json, a), derivable(ord, b)
  requires true
  ensures result >= 0
  = 0
fn g(n: Int) -> Int ensures result > n requires n > 0 = n + 1
fn h<a>(x: a) -> Bytes where derivable(hash, a) = digest(x)
fn k<a, b>(x: a, y: b) -> a where numeric(a), integer(b) = x
fn steps(i: Int, n: Int) -> Int
  requires i <= n
  decreases n - i
  = if i < n { steps(i + 1, n) } else { i }
