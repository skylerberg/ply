// The error half of the try operator and default arguments's parser rules. Three diagnostics
// arrive with them and none is raised by any real `.ply` file in the tree:
// E0120 a default on a lambda parameter, E0123 a named argument on a
// `perform`, E0124 a positional argument after a named one. Two more are
// `UNEXPECTED_TOKEN` at shapes only a record update can reach.
type R = {x: Int, y: Int}

// E0124: one per offending positional, each with the first named argument as a
// secondary label.
fn one_after(r: R) -> Int = f(x: 1, 2)
fn several_after(r: R) -> Int = f(x: 1, 2, y: 3, 4)

// E0123: an operation's arguments are positional, one diagnostic per name.
fn on_a_perform() -> Int = db.get[users](key: 1)
fn two_on_a_perform() -> Int = db.get[users](1, key: 2, mode: 3)
fn qualified_perform() -> Int = store::db.get[users](key: 1)

// E0120: a lambda has no name a call could omit an argument of. The default is
// parsed either way, so the refusal is a diagnostic rather than "expected `,`".
fn a_lambda_default() -> Int = (|x: Int = 1| x)(2)
fn two_lambda_defaults() -> Int = (|x: Int = 1, y = 2| x)(3)
fn an_untyped_lambda_default() -> Int = (|x = 1| x)(4)

// `...b` is one dot too many, and it is reported as itself rather than as
// "expected a name, found `.`".
fn three_dots(r: R) -> R = {...r, x: 1}

// A record update has one base, written first.
fn two_bases(r: R, s: R) -> R = {..r, ..s}

// The base is a path, not an arbitrary expression.
fn a_call_base(r: R) -> R = {..r(), x: 1}
fn a_literal_base() -> R = {..1, x: 1}

// A missing comma after the base.
fn no_comma(r: R) -> R = {..r x: 1}

// An empty base, and an unclosed one.
fn empty_base() -> R = {..}
fn unclosed_base(r: R) -> R = {..r, x: 1

// A named argument with no value, and one whose name is not a name.
fn no_value() -> Int = f(x: )
fn nested_bad(r: R) -> Int = f(x: {..r, }, 2)
