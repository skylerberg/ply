// An or-pattern at the top of an arm, nested under a constructor, and parenthesised; a
// `let ... else` whose pattern is one.
type Shape = | Circle(Int) | Square(Int) | Point

fn size(s: Shape) -> Int =
  match s {
    Circle(n) | Square(n) -> n,
    Point -> 0,
  }

fn small(xs: List<Int>) -> Bool = match xs { [] | [_] -> true, _ -> false }

fn side(o: Option<Shape>) -> Int = {
  let Some(Circle(n) | Square(n)) = o else { -1 };
  n
}

fn digit(c: Int) -> Bool = match c { (0 | 1 | 2) | 3 -> true, _ -> false }

fn first_or_zero(xs: List<Int>) -> Int = {
  let [x, ..] = xs else { 0 };
  x
}
