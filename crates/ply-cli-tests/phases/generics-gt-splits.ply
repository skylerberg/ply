// The two token rewrites `expect_gt` performs: `>>` closing two nested argument
// lists, and `>=` where a type parameter list is followed immediately by `=`.
type Pair<a>= a
type Nest<a> = Map<Int, List<Map<a, Int>>>
fn f<a, b | e>(m: Map<a, List<b>>) -> Map<List<a>, b> / {db.read | e} = g(m)
fn g<|e>(x: Int) -> Int / e = x
fn h<a|>(x: a) -> a = x
