// `ply`, as a program: one artifact, one entry point, one command word. The Rust side parses the
// command line with `clap`, so an unknown flag never reaches here; it hands over the command, the
// flags this program reads, and the paths relative to the root it bound as `cwd`. The modules this
// binary ships are bound as the root `shelf`, since a program cannot read the binary it runs in.

import std.process (process, Captured, captured, args_step, out_step, err_step, exit_step)
import std.fs (fs)
import std.json (Json, Str, Bool, Number, object, to_string)
import std.time (time)
import args (Flags, read, style_of)
import report (Answer, compile_error, schema_version)
import style (Style, red)
import bootstrap
import build
import cache
import callers
import check
import claims (prover)
import defs
import doc
import explain
import fmt
import hashes
import hosts
import prove
import replace
import review
import run
import show
import stdlib
import tests

// `ply run` writes its own disclosures here rather than in its answer: they are about an entry
// that has not run yet, and the answer is collected after it has.
fn answer_of(
  command: String,
  flags: Flags,
) -> Answer / {process.out[proc], process.err[proc], fs.kind[cwd], fs.list_dir[cwd], fs.read_file[cwd], fs.write_file[cwd], fs.list_dir[shelf], fs.read_file[shelf], time.elapsed_ms, hosts::tcb.preview[host], hosts::tcb.open[host], cache::store.statistics[cache], cache::store.matches[cache], cache::store.compacted[cache], cache::store.cleared[cache], replace::edit.item[replace], bootstrap::archive.emitted[bootstrap], bootstrap::archive.land[bootstrap], build::builder.loaded[build], build::builder.made[build], build::builder.sealed[build], build::builder.previous[build], build::builder.stored[build], run::runner.loaded[run], run::runner.bound[run], run::runner.entered[run], tests::tester.loaded[corpus], tests::tester.bound[corpus], tests::tester.ran[corpus], prover.collected[claims], prover.discharged[claims], prover.reviewed[claims], prover.accepted[claims]} =
  if command == "bootstrap" { bootstrap::run(flags) }
  else if command == "build" { build::run(flags) }
  else if command == "cache" { cache::run(flags) }
  else if command == "callers" { callers::run(flags) }
  else if command == "check" { check::run(flags) }
  else if command == "defs" { defs::run(flags) }
  else if command == "hash" { hashes::run(flags) }
  else if command == "doc" { doc::run(flags) }
  else if command == "explain" { explain::run(flags) }
  else if command == "hosts" { hosts::run(flags) }
  else if command == "prove" { prove::run(flags) }
  else if command == "replace" { replace::run(flags) }
  else if command == "review" { review::run(flags) }
  else if command == "run" { run::run(flags) }
  else if command == "show" { show::run(flags) }
  else if command == "std" { stdlib::run(flags) }
  else if command == "test" { tests::run(flags) }
  else if command == "fmt" { fmt::run(flags) }
  else { unknown_command(style_of(flags), command) }

// Every command this program answers, in the order `dispatch` tries them.
fn commands() -> List<String> =
  [
    "bootstrap",
    "build",
    "cache",
    "callers",
    "check",
    "defs",
    "doc",
    "explain",
    "fmt",
    "hash",
    "hosts",
    "prove",
    "replace",
    "review",
    "run",
    "show",
    "std",
    "test",
  ]

// A word no arm claims is refused rather than dispatched. `fmt` has an arm of its own, so no word
// may reach it by falling through: `ply frobnicate` would otherwise rewrite the tree.
fn unknown_command(s: Style, command: String) -> Answer = {
  let message = "`" ++ command ++ "` is not a `ply` command; try one of " ++ joined(commands());
  {
    json: object([
      { key: "command", value: Str(command) },
      { key: "schema_version", value: Number(decimal_of_int(schema_version())) },
      { key: "ok", value: Bool(false) },
      { key: "exit_code", value: Number(decimal_of_int(compile_error())) },
      { key: "error", value: Str(message) },
    ]),
    lines: [],
    errs: [red(s, "error") ++ ": " ++ message],
    code: compile_error(),
  }
}

fn joined(words: List<String>) -> String =
  match words { [] -> "", [last] -> last, [first, ..rest] -> first ++ ", " ++ joined(rest) }

fn say(lines: List<String>) -> Unit / {process.out[proc]} =
  match lines {
    [] -> (),
    [first, ..rest] -> {
      process.out[proc](first);
      say(rest)
    },
  }

fn complain(lines: List<String>) -> Unit / {process.err[proc]} =
  match lines {
    [] -> (),
    [first, ..rest] -> {
      process.err[proc](first);
      complain(rest)
    },
  }

fn said(answer: Answer, flags: Flags) -> Unit / {process.out[proc], process.err[proc]} =
  if flags.json { process.out[proc](to_string(answer.json)) } else {
    say(answer.lines);
    complain(answer.errs)
  }

// Polling rather than watching: the walk is owed anyway, so a watcher would add a dependency for
// no latency.
fn poll_ms() -> Int = 120

// One blank line between reports, which a stream of documents must not carry.
fn parted(flags: Flags) -> Unit / {process.out[proc]} =
  if flags.json { () } else { process.out[proc]("") }

// `--watch`, which never returns: a report, then another one whenever the tree moves. The baseline
// is stamped before a run and never after — a walk after it folds a save made while it ran into
// the baseline, and that save is the one the next report exists to notice.
fn watching(
  flags: Flags,
) -> Int / {process.out[proc], process.err[proc], time.sleep_ms, tests::tester.loaded[corpus], tests::tester.bound[corpus], tests::tester.ran[corpus], tests::tester.stamped[corpus]} = {
  let baseline: Option<List<String>> = tests::tester.stamped[corpus]();
  said(tests::run(flags), flags);
  watched(flags, baseline)
}

// A walk that failed reports `None`, and two of those are not a tree that held still: the report
// is owed again, and it is the run that says what is wrong with the tree.
fn moved(now: Option<List<String>>, baseline: Option<List<String>>) -> Bool =
  match now {
    None -> true,
    Some(now) -> match baseline { None -> true, Some(baseline) -> now != baseline },
  }

fn watched(
  flags: Flags,
  baseline: Option<List<String>>,
) -> Int / {process.out[proc], process.err[proc], time.sleep_ms, tests::tester.loaded[corpus], tests::tester.bound[corpus], tests::tester.ran[corpus], tests::tester.stamped[corpus]} = {
  time.sleep_ms(poll_ms());
  let now: Option<List<String>> = tests::tester.stamped[corpus]();
  if moved(now, baseline) {
    parted(flags);
    said(tests::run(flags), flags);
    watched(flags, now)
  } else { watched(flags, baseline) }
}

fn dispatch(
  argv: List<String>,
) -> Int / {process.out[proc], process.err[proc], fs.kind[cwd], fs.list_dir[cwd], fs.read_file[cwd], fs.write_file[cwd], fs.list_dir[shelf], fs.read_file[shelf], time.elapsed_ms, time.sleep_ms, hosts::tcb.preview[host], hosts::tcb.open[host], cache::store.statistics[cache], cache::store.matches[cache], cache::store.compacted[cache], cache::store.cleared[cache], replace::edit.item[replace], bootstrap::archive.emitted[bootstrap], bootstrap::archive.land[bootstrap], build::builder.loaded[build], build::builder.made[build], build::builder.sealed[build], build::builder.previous[build], build::builder.stored[build], run::runner.loaded[run], run::runner.bound[run], run::runner.entered[run], tests::tester.loaded[corpus], tests::tester.bound[corpus], tests::tester.ran[corpus], tests::tester.stamped[corpus], prover.collected[claims], prover.discharged[claims], prover.reviewed[claims], prover.accepted[claims]} =
  match argv {
    [] -> compile_error(),
    [command, ..rest] -> {
      let flags: Flags = read(rest);
      // `--watch` is `ply test`'s alone, and a run carrying it writes reports until it is killed.
      if flags.watch { watching(flags) } else {
        let answer: Answer = answer_of(command, flags);
        said(answer, flags);
        answer.code
      }
    },
  }

fn main() -> Unit / {process.args[proc], process.out[proc], process.err[proc], process.exit[proc], fs.kind[cwd], fs.list_dir[cwd], fs.read_file[cwd], fs.write_file[cwd], fs.list_dir[shelf], fs.read_file[shelf], time.elapsed_ms, time.sleep_ms, hosts::tcb.preview[host], hosts::tcb.open[host], cache::store.statistics[cache], cache::store.matches[cache], cache::store.compacted[cache], cache::store.cleared[cache], replace::edit.item[replace], bootstrap::archive.emitted[bootstrap], bootstrap::archive.land[bootstrap], build::builder.loaded[build], build::builder.made[build], build::builder.sealed[build], build::builder.previous[build], build::builder.stored[build], run::runner.loaded[run], run::runner.bound[run], run::runner.entered[run], tests::tester.loaded[corpus], tests::tester.bound[corpus], tests::tester.ran[corpus], tests::tester.stamped[corpus], prover.collected[claims], prover.discharged[claims], prover.reviewed[claims], prover.accepted[claims]} =
  process.exit[proc](dispatch(process.args[proc]()))

// --- Tests ------------------------------------------------------------------

// The lines a run wrote and the code it asked to exit with, over a program that touches no tree.
fn explained(argv: List<String>) -> Captured =
  with_cell[twin](captured(argv)) { io -> {
    handle {
      main()
    } with {
      process.args[proc]() -> args_step(cell_get(io)),
      process.out[proc](text) -> cell_set(io, out_step(cell_get(io), text)),
      process.err[proc](text) -> cell_set(io, err_step(cell_get(io), text)),
      process.exit[proc](code) resume k -> cell_set(io, exit_step(cell_get(io), code)),
      fs.kind[cwd](p) -> panic("`ply explain` reaches no tree"),
      fs.list_dir[cwd](p) -> panic("`ply explain` reaches no tree"),
      fs.read_file[cwd](p) -> panic("`ply explain` reaches no tree"),
      fs.write_file[cwd](p, body) -> panic("`ply explain` reaches no tree"),
      fs.list_dir[shelf](p) -> panic("`ply explain` reaches no shelf"),
      fs.read_file[shelf](p) -> panic("`ply explain` reaches no shelf"),
      time.elapsed_ms() -> 0,
      time.sleep_ms(ms) -> panic("`ply explain` waits for nothing"),
      hosts::tcb.preview[host]() -> panic("`ply explain` binds no host"),
      hosts::tcb.open[host]() -> panic("`ply explain` binds no host"),
      cache::store.statistics[cache]() -> panic("`ply explain` opens no store"),
      cache::store.matches[cache]() -> panic("`ply explain` opens no store"),
      cache::store.compacted[cache]() -> panic("`ply explain` opens no store"),
      cache::store.cleared[cache]() -> panic("`ply explain` opens no store"),
      replace::edit.item[replace]() -> panic("`ply explain` reads no replacement"),
      bootstrap::archive.emitted[bootstrap]() -> panic("`ply explain` emits no archive"),
      bootstrap::archive.land[bootstrap](manifest) -> panic("`ply explain` writes no archive"),
      build::builder.loaded[build]() -> panic("`ply explain` builds nothing"),
      build::builder.made[build](entry, startup, reaches) -> panic("`ply explain` builds nothing"),
      build::builder.sealed[build](container) -> panic("`ply explain` builds nothing"),
      build::builder.previous[build]() -> panic("`ply explain` builds nothing"),
      build::builder.stored[build](path, body) -> panic("`ply explain` builds nothing"),
      prover.collected[claims]() -> panic("`ply explain` collects no claims"),
      prover.discharged[claims](wanted) -> panic("`ply explain` discharges nothing"),
      prover.reviewed[claims]() -> panic("`ply explain` reviews nothing"),
      prover.accepted[claims]() -> panic("`ply explain` accepts no baseline"),
      run::runner.loaded[run]() -> panic("`ply explain` runs no program"),
      run::runner.bound[run](entry) -> panic("`ply explain` binds no host"),
      run::runner.entered[run]() -> panic("`ply explain` runs no program"),
      tests::tester.loaded[corpus]() -> panic("`ply explain` runs no tests"),
      tests::tester.bound[corpus]() -> panic("`ply explain` binds no host"),
      tests::tester.ran[corpus]() -> panic("`ply explain` runs no tests"),
      tests::tester.stamped[corpus]() -> panic("`ply explain` watches no tree"),
    };
    cell_get(io)
  } }

test "a walk that failed is not a tree that held still" {
  let one: Option<List<String>> = Some(["m.ply 1 2"]);
  let same: Option<List<String>> = Some(["m.ply 1 2"]);
  let other: Option<List<String>> = Some(["m.ply 9 2"]);
  let unread: Option<List<String>> = None;
  assert(!moved(one, same));
  assert(moved(other, one));
  // Both ends unread: equal values, and still owed a report.
  assert(moved(unread, unread));
  assert(moved(unread, one));
  assert(moved(one, unread));
}

test "the command word picks the command, and its code is the run's" {
  let one = explained(["explain", "E0302"]);
  assert_eq(one.out, ["E0302 effect not permitted by the written row"]);
  assert_eq(one.err, []);
  assert_eq(one.code, Some(0))
}

test "a command that refuses writes to the error stream and exits 2" {
  let bad = explained(["explain", "E9999"]);
  assert_eq(bad.out, []);
  assert_eq(len(bad.err), 1);
  assert_eq(bad.code, Some(2))
}

// The keys come back in byte order, `code` before `command`, so the document is read and not matched.
test "`--json` writes one document on the output stream and nothing else" {
  let json = explained(["explain", "E0302", "--json"]);
  assert_eq(len(json.out), 1);
  assert_eq(json.err, []);
  let text = match list_at(json.out, 0) { Some(l) -> l, None -> "" };
  assert(string_starts_with(text, "{"));
  assert(string_ends_with(text, "}"));
  assert(string_contains(text, "\"command\":\"explain\""));
  assert(string_contains(text, "\"exit_code\":0"))
}

test "a word that is no command is refused, never run as `ply fmt`" {
  let answer = explained(["frobnicate"]);
  // Nothing on the output stream: `fmt` would have written the files it rewrote.
  assert_eq(answer.out, []);
  assert_eq(answer.code, Some(2));
  let said = match list_at(answer.err, 0) { Some(l) -> l, None -> "" };
  assert(string_contains(said, "frobnicate"));
  assert(string_contains(said, "is not a `ply` command"))
}

test "every command the dispatch answers is one `commands` lists" {
  // The list is what an unknown word is told to try, so a command missing from it is a command
  // nobody is told about.
  assert_eq(len(commands()), 18);
  assert(string_contains(joined(commands()), "fmt"));
  assert(string_contains(joined(commands()), "bootstrap"));
  assert(string_contains(joined(commands()), "test"))
}

test "no command word at all is a refusal, and nothing is written" {
  let empty = explained([]);
  assert_eq(empty.out, []);
  assert_eq(empty.err, []);
  assert_eq(empty.code, Some(2))
}
