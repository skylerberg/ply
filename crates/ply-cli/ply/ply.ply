// `ply run` writes its own disclosures here rather than in its answer: they are about an entry
// that has not run yet, and the answer is collected after it has.
fn answer_of(
  command: String,
  flags: Flags,
  p: Parsed,
) -> Answer / {builder.git[vcs], process.out[proc], process.err[proc], fs.kind[cwd], fs.kind[abs], fs.resolved[cwd], fs.resolved[abs], fs.create_dir[cwd], fs.create_dir[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.write_file[cwd], fs.write_file[abs], fs.list_dir[shelf], fs.read_file[shelf], time.elapsed_ms, time.elapsed_us, env.binary_version[sys], env.shipped_digest[sys], machine::machine.configure[run], prover.configure[claims], hosts::tcb.preview[host], replace::edit.item[replace], bootstrap::archive.emitted[bootstrap], builder.loaded[build], builder.made[build], builder.previous[build], builder.unit[build], machine::machine.load[run], machine::machine.opened[run], machine::machine.reuse[run], machine::machine.reload[run], machine::machine.bound[run], machine::machine.enter[run], machine::machine.drop[run], prover.collected[claims], prover.prepared[claims], prover.judged[claims], prover.interleaved[claims], prover.ended[claims], fs.remove[abs], fs.rename[abs], env.var[sys], net.connect[registry], net.connect_tls[registry], net.handshake[registry], net.send[registry], net.recv[registry], net.close[registry], tester::tester.configure[corpus], tester::tester.unit[corpus], tester::tester.bound[corpus], tester::tester.hosted[corpus], tester::tester.ended[corpus], tester::tester.executed[corpus], tester::tester.interleaved[corpus], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, env.pwd[sys], machine::machine.schema[run], env.vars[sys], tester::tester.schema[corpus], prover.schema[claims], hosts::tcb.schema[host]} =
  if command == "bootstrap" { bootstrap::run(flags) }
  else if command == "new" { new::run(flags, new::options_from(p)) }
  else if command == "build" { build::run(flags) }
  else if command == "cache" { cache::run(flags) }
  else if command == "callers" { callers::run(flags) }
  else if command == "check" { check::run(flags) }
  else if command == "defs" { defs::run(flags) }
  else if command == "hash" { hashes::run(flags) }
  else if command == "doc" { doc::run(flags) }
  else if command == "explain" { explain::run(flags) }
  else if command == "hosts" { hosts::run(flags, machine::options_from(p)) }
  else if command == "prove" { prove::run(flags, claims::options_from(p, root_of_flags(flags))) }
  else if command == "replace" { replace::run(flags) }
  else if command == "resolve" { resolve::run(flags) }
  else if command == "vendor" { vendor::run(flags) }
  else if command == "why" { why::run(flags) }
  else if command == "publish" { publish::run(flags) }
  else if command == "yank" { yank::run(flags, yank::options_from(p)) }
  else if command == "review" { review::run(flags, claims::options_from(p, root_of_flags(flags))) }
  else if command == "run" { run::run(flags, machine::options_from(p)) }
  else if command == "show" { show::run(flags) }
  else if command == "std" { stdlib::run(flags) }
  else if command == "test" { tests::run(flags, tests::options_from(p, root_of_flags(flags))) }
  else if command == "fmt" { fmt::run(flags) }
  else { panic("the parser refused the word first; `cmdline` owns this refusal") }

// `--workspace`: the command run for every package the path reaches by a path dependency, each as
// its own root, and then for the path itself.
fn across(
  command: String,
  flags: Flags,
  p: Parsed,
) -> Answer / {builder.git[vcs], process.out[proc], process.err[proc], fs.kind[cwd], fs.kind[abs], fs.resolved[cwd], fs.resolved[abs], fs.create_dir[cwd], fs.create_dir[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.write_file[cwd], fs.write_file[abs], fs.list_dir[shelf], fs.read_file[shelf], time.elapsed_ms, time.elapsed_us, env.binary_version[sys], env.shipped_digest[sys], machine::machine.configure[run], prover.configure[claims], hosts::tcb.preview[host], replace::edit.item[replace], bootstrap::archive.emitted[bootstrap], builder.loaded[build], builder.made[build], builder.previous[build], builder.unit[build], machine::machine.load[run], machine::machine.opened[run], machine::machine.reuse[run], machine::machine.reload[run], machine::machine.bound[run], machine::machine.enter[run], machine::machine.drop[run], prover.collected[claims], prover.prepared[claims], prover.judged[claims], prover.interleaved[claims], prover.ended[claims], fs.remove[abs], fs.rename[abs], env.var[sys], net.connect[registry], net.connect_tls[registry], net.handshake[registry], net.send[registry], net.recv[registry], net.close[registry], tester::tester.configure[corpus], tester::tester.unit[corpus], tester::tester.bound[corpus], tester::tester.hosted[corpus], tester::tester.ended[corpus], tester::tester.executed[corpus], tester::tester.interleaved[corpus], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, env.pwd[sys], machine::machine.schema[run], env.vars[sys], tester::tester.schema[corpus], prover.schema[claims], hosts::tcb.schema[host], time.elapsed_us} = {
  let deps = map(workspace::path_packages(sources::load_resolved(flags.paths)), |dir: String| {
    let r = paths::resolve(dir);
    {
      display: r.display,
      answer: answer_of(command, { ..flags, paths: [r], root: r.display, workspace: false }, p),
    }
  });
  let own = { display: flags.root, answer: answer_of(command, { ..flags, workspace: false }, p) };
  workspace::combined(args::style_of(flags), command, push(deps, own))
}

// Every command this program answers, in the order `dispatch` tries them.
fn commands() -> List<String> =
  [
    "bootstrap",
    "build",
    "cache",
    "callers",
    "check",
    "defs",
    "doc",
    "explain",
    "fmt",
    "hash",
    "hosts",
    "new",
    "prove",
    "replace",
    "resolve",
    "vendor",
    "why",
    "publish",
    "yank",
    "review",
    "run",
    "show",
    "std",
    "test",
  ]

// The target path the command loads, as the machine names it: the resolved root's absolute form.
fn root_of_flags(flags: Flags) -> String =
  match list_at(flags.paths, 0) { Some(r) -> r.machine, None -> "." }

// A word no arm claims is refused rather than dispatched. `fmt` has an arm of its own, so no word
// may reach it by falling through: `ply frobnicate` would otherwise rewrite the tree.
fn joined(words: List<String>) -> String =
  match words { [] -> "", [last] -> last, [first, ..rest] -> first ++ ", " ++ joined(rest) }

fn say(lines: List<String>) -> Unit / {process.out[proc]} =
  match lines {
    [] -> (),
    [first, ..rest] -> {
      process.out[proc](first);
      say(rest)
    },
  }

fn complain(lines: List<String>) -> Unit / {process.err[proc]} =
  match lines {
    [] -> (),
    [first, ..rest] -> {
      process.err[proc](first);
      complain(rest)
    },
  }

fn said(answer: Answer, flags: Flags) -> Unit / {process.out[proc], process.err[proc]} =
  if flags.json { process.out[proc](to_string(answer.json)) } else {
    say(answer.lines);
    complain(answer.errs)
  }

// Polling rather than watching: the walk is owed anyway, so a watcher would add a dependency for
// no latency.
fn poll_ms() -> Int = 120

// One blank line between reports, which a stream of documents must not carry.
fn parted(flags: Flags) -> Unit / {process.out[proc]} =
  if flags.json { () } else { process.out[proc]("") }

// `--watch`, which never returns: a report, then another one whenever the tree moves. The baseline
// is stamped before a run and never after — a walk after it folds a save made while it ran into
// the baseline, and that save is the one the next report exists to notice.
fn watching(
  flags: Flags,
  options: tester::Options,
) -> Int / {builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shelf], fs.read_file[shelf], time.elapsed_ms, time.elapsed_us, process.out[proc], process.err[proc], time.sleep_ms, tester::tester.configure[corpus], tester::tester.unit[corpus], tester::tester.bound[corpus], tester::tester.hosted[corpus], tester::tester.ended[corpus], tester::tester.executed[corpus], tester::tester.interleaved[corpus], fs.modified_ms[cwd], fs.modified_ms[abs], fs.file_size[cwd], fs.file_size[abs], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, env.var[sys], env.pwd[sys], tester::tester.schema[corpus], env.vars[sys], fs.resolved[cwd], fs.resolved[abs]} = {
  let baseline: Option<List<String>> = tests::stamped(flags.paths);
  let first = tests::iterated(flags, options, None);
  said(first.answer, flags);
  watched(flags, options, baseline, first.held)
}

// A walk that failed reports `None`, and two of those are not a tree that held still: the report
// is owed again, and it is the run that says what is wrong with the tree.
fn moved(now: Option<List<String>>, baseline: Option<List<String>>) -> Bool =
  match now {
    None -> true,
    Some(now) -> match baseline { None -> true, Some(baseline) -> now != baseline },
  }

fn watched(
  flags: Flags,
  options: tester::Options,
  baseline: Option<List<String>>,
  held: Option<program::Timed>,
) -> Int / {builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shelf], fs.read_file[shelf], time.elapsed_ms, time.elapsed_us, process.out[proc], process.err[proc], time.sleep_ms, tester::tester.configure[corpus], tester::tester.unit[corpus], tester::tester.bound[corpus], tester::tester.hosted[corpus], tester::tester.ended[corpus], tester::tester.executed[corpus], tester::tester.interleaved[corpus], fs.modified_ms[cwd], fs.modified_ms[abs], fs.file_size[cwd], fs.file_size[abs], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, env.var[sys], env.pwd[sys], tester::tester.schema[corpus], env.vars[sys], fs.resolved[cwd], fs.resolved[abs]} = {
  time.sleep_ms(poll_ms());
  let now: Option<List<String>> = tests::stamped(flags.paths);
  if moved(now, baseline) {
    parted(flags);
    let next = tests::iterated(flags, options, held);
    said(next.answer, flags);
    watched(flags, options, now, next.held)
  } else { watched(flags, options, baseline, held) }
}

fn dispatch(
  p: Parsed,
  styled: Bool,
) -> Int / {builder.git[vcs], process.out[proc], process.err[proc], fs.kind[cwd], fs.kind[abs], fs.resolved[cwd], fs.resolved[abs], fs.create_dir[cwd], fs.create_dir[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.write_file[cwd], fs.write_file[abs], fs.list_dir[shelf], fs.read_file[shelf], time.elapsed_ms, time.elapsed_us, time.sleep_ms, env.var[sys], env.terminal[sys], env.binary_version[sys], env.pwd[sys], env.shipped_digest[sys], machine::machine.configure[run], prover.configure[claims], hosts::tcb.preview[host], replace::edit.item[replace], bootstrap::archive.emitted[bootstrap], builder.loaded[build], builder.made[build], builder.previous[build], builder.unit[build], machine::machine.configure[run], machine::machine.load[run], machine::machine.opened[run], machine::machine.reuse[run], machine::machine.reload[run], machine::machine.bound[run], machine::machine.enter[run], machine::machine.drop[run], prover.configure[claims], prover.collected[claims], prover.prepared[claims], prover.judged[claims], prover.interleaved[claims], prover.ended[claims], fs.remove[abs], fs.rename[abs], net.connect[registry], net.connect_tls[registry], net.handshake[registry], net.send[registry], net.recv[registry], net.close[registry], tester::tester.configure[corpus], tester::tester.unit[corpus], tester::tester.bound[corpus], tester::tester.hosted[corpus], tester::tester.ended[corpus], tester::tester.executed[corpus], tester::tester.interleaved[corpus], fs.modified_ms[cwd], fs.modified_ms[abs], fs.file_size[cwd], fs.file_size[abs], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, machine::machine.schema[run], env.vars[sys], tester::tester.schema[corpus], prover.schema[claims], hosts::tcb.schema[host]} = {
  let command = cmdline::nth_of(p.path, 0, "");
  let resolved = paths::resolve_all(command, p);
  let display = match cmdline::nth_of(p.path, 0, "") {
    _ -> match list_at(resolved, 0) { Some(r) -> r.display, None -> "." },
  };
  let flags: Flags = args::from_parsed(
    p,
    styled,
    display,
    resolved,
    paths::resolve_flag(p, "stamp"),
  );
  if flags.watch { watching(flags, tests::options_from(p, root_of_flags(flags))) } else {
    let answer: Answer = if flags.workspace { across(command, flags, p) }
    else { answer_of(command, flags, p) };
    said(answer, flags);
    answer.code
  }
}

// The whole line is the program's to read now: the surface is `surface.ply`'s declaration of it,
// and a refusal is the parser's shape — the error, the usage, and the way to help. Help and
// version print and exit 0; a refusal never runs a command.
pub fn main() -> Unit / {builder.git[vcs], process.args[proc], process.out[proc], process.err[proc], fs.kind[cwd], fs.kind[abs], fs.resolved[cwd], fs.resolved[abs], fs.create_dir[cwd], fs.create_dir[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.write_file[cwd], fs.write_file[abs], fs.list_dir[shelf], fs.read_file[shelf], time.elapsed_ms, time.elapsed_us, time.sleep_ms, env.var[sys], env.terminal[sys], env.binary_version[sys], env.pwd[sys], env.shipped_digest[sys], machine::machine.configure[run], prover.configure[claims], hosts::tcb.preview[host], replace::edit.item[replace], bootstrap::archive.emitted[bootstrap], builder.loaded[build], builder.made[build], builder.previous[build], builder.unit[build], machine::machine.configure[run], machine::machine.load[run], machine::machine.opened[run], machine::machine.reuse[run], machine::machine.reload[run], machine::machine.bound[run], machine::machine.enter[run], machine::machine.drop[run], prover.configure[claims], prover.collected[claims], prover.prepared[claims], prover.judged[claims], prover.interleaved[claims], prover.ended[claims], process.exit[proc], fs.remove[abs], fs.rename[abs], net.connect[registry], net.connect_tls[registry], net.handshake[registry], net.send[registry], net.recv[registry], net.close[registry], tester::tester.configure[corpus], tester::tester.unit[corpus], tester::tester.bound[corpus], tester::tester.hosted[corpus], tester::tester.ended[corpus], tester::tester.executed[corpus], tester::tester.interleaved[corpus], fs.modified_ms[cwd], fs.modified_ms[abs], fs.file_size[cwd], fs.file_size[abs], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, machine::machine.schema[run], env.vars[sys], tester::tester.schema[corpus], prover.schema[claims], hosts::tcb.schema[host]} = {
  let argv = process.args[proc]();
  let version = env.binary_version[sys]();
  match parse(spec(version), argv) {
    Help(text) -> {
      process.out[proc](text);
      process.exit[proc](ok_code())
    },
    Version(text) -> {
      process.out[proc](text);
      process.exit[proc](ok_code())
    },
    Refused(text) -> {
      complain([text]);
      process.exit[proc](compile_error())
    },
    Run(parsed) -> {
      let styled = env::styled(value(parsed, "color"));
      process.exit[proc](dispatch(parsed, styled))
    },
  }
}

// --- Tests ------------------------------------------------------------------

// The lines a run wrote and the code it asked to exit with, over a program that touches no tree.
fn explained(argv: List<String>) -> Captured =
  with_cell[twin](captured(argv)) { io -> {
    handle {
      main()
    } with {
      process.args[proc]() -> args_step(cell_get(io)),
      process.out[proc](text) -> cell_set(io, out_step(cell_get(io), text)),
      process.err[proc](text) -> cell_set(io, err_step(cell_get(io), text)),
      process.exit[proc](code) resume k -> cell_set(io, exit_step(cell_get(io), code)),
      env.var[sys](name) -> None,
      env.vars[sys]() -> [],
      env.terminal[sys](stream) -> false,
      env.binary_version[sys]() -> "0.0.0-test",
      env.pwd[sys]() -> "/w",
      env.shipped_digest[sys]() -> "b3:test",
      fs.kind[cwd](p) -> panic("`ply explain` reaches no tree"),
      fs.kind[abs](p) -> panic("`ply explain` reaches no tree"),
      fs.resolved[cwd](p) -> Dir,
      fs.resolved[abs](p) -> panic("`ply explain` reaches no tree"),
      fs.list_dir[cwd](p) -> panic("`ply explain` reaches no tree"),
      fs.list_dir[abs](p) -> panic("`ply explain` reaches no tree"),
      fs.read_file[cwd](p) -> panic("`ply explain` reaches no tree"),
      fs.read_file[abs](p) -> panic("`ply explain` reaches no tree"),
      fs.write_file[cwd](p, body) -> panic("`ply explain` reaches no tree"),
      fs.write_file[abs](p, body) -> panic("`ply explain` reaches no tree"),
      fs.create_dir[cwd](p) -> panic("`ply explain` reaches no tree"),
      fs.create_dir[abs](p) -> panic("`ply explain` reaches no tree"),
      fs.remove[abs](p) -> panic("`ply explain` reaches no tree"),
      fs.rename[abs](from, to) -> panic("`ply explain` reaches no tree"),
      fs.read_at[cwd](p, offset, n) -> panic("`ply explain` reaches no tree"),
      fs.exists[cwd](p) -> panic("`ply explain` reaches no tree"),
      fs.file_size[cwd](p) -> panic("`ply explain` reaches no tree"),
      fs.modified_ms[cwd](p) -> panic("`ply explain` reaches no tree"),
      fs.append[cwd](p, body) -> panic("`ply explain` reaches no tree"),
      fs.sync[cwd](p) -> panic("`ply explain` reaches no tree"),
      fs.lock[cwd](p) -> panic("`ply explain` reaches no tree"),
      fs.unlock[cwd](p) -> panic("`ply explain` reaches no tree"),
      fs.copy[cwd](from, to) -> panic("`ply explain` reaches no tree"),
      fs.remove_tree[cwd](p) -> panic("`ply explain` reaches no tree"),
      fs.temp_dir[cwd](dir, prefix) -> panic("`ply explain` reaches no tree"),
      fs.canonical[cwd](p) -> panic("`ply explain` reaches no tree"),
      fs.mode[cwd](p) -> panic("`ply explain` reaches no tree"),
      fs.set_mode[cwd](p, m) -> panic("`ply explain` reaches no tree"),
      fs.symlink[cwd](p, target) -> panic("`ply explain` reaches no tree"),
      fs.read_link[cwd](p) -> panic("`ply explain` reaches no tree"),
      fs.walk[cwd](p) -> panic("`ply explain` reaches no tree"),
      fs.set_modified[cwd](p, ms) -> panic("`ply explain` reaches no tree"),
      fs.read_at[abs](p, offset, n) -> panic("`ply explain` reaches no tree"),
      fs.exists[abs](p) -> panic("`ply explain` reaches no tree"),
      fs.file_size[abs](p) -> panic("`ply explain` reaches no tree"),
      fs.modified_ms[abs](p) -> panic("`ply explain` reaches no tree"),
      fs.append[abs](p, body) -> panic("`ply explain` reaches no tree"),
      fs.sync[abs](p) -> panic("`ply explain` reaches no tree"),
      fs.lock[abs](p) -> panic("`ply explain` reaches no tree"),
      fs.unlock[abs](p) -> panic("`ply explain` reaches no tree"),
      fs.copy[abs](from, to) -> panic("`ply explain` reaches no tree"),
      fs.remove_tree[abs](p) -> panic("`ply explain` reaches no tree"),
      fs.temp_dir[abs](dir, prefix) -> panic("`ply explain` reaches no tree"),
      fs.canonical[abs](p) -> panic("`ply explain` reaches no tree"),
      fs.mode[abs](p) -> panic("`ply explain` reaches no tree"),
      fs.set_mode[abs](p, m) -> panic("`ply explain` reaches no tree"),
      fs.symlink[abs](p, target) -> panic("`ply explain` reaches no tree"),
      fs.read_link[abs](p) -> panic("`ply explain` reaches no tree"),
      fs.walk[abs](p) -> panic("`ply explain` reaches no tree"),
      fs.set_modified[abs](p, ms) -> panic("`ply explain` reaches no tree"),
      fs.remove[cwd](p) -> panic("`ply explain` reaches no tree"),
      fs.rename[cwd](from, to) -> panic("`ply explain` reaches no tree"),
