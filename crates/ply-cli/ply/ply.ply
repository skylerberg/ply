      fs.list_dir[shelf](p) -> panic("`ply explain` reaches no shelf"),
      fs.read_file[shelf](p) -> panic("`ply explain` reaches no shelf"),
      time.elapsed_ms() -> 0,
      // The twin's readings are milliseconds, so a microsecond reading is the same number a
      // thousand times finer.
      time.elapsed_us() -> 0,
      time.sleep_ms(ms) -> panic("`ply explain` waits for nothing"),
      hosts::tcb.schema[host](root, front, name) -> panic("`ply explain` configures no program"),
