//! What a command keeps in the store between runs and reads back: for `ply test` the keys passes are
//! filed under, each test's baseline, the definitions seen pass, and the bodies and interfaces a
//! failure's diagnosis reads; for `ply prove` and `ply review` evidence and accepted baselines.

import std.bin
import std.fs (fs, mem_empty)
import std.random (entropy)
import std.time (time)
import std.bytes (bytes_of_hex, hex_of)
import compiler.front (DefInterface, FiledBody, FiledDef, body_encoding, body_key,
                       def_interface_bin)
import compiler.resolve (Diag)
import loads
import paths
import store.tables
import store.twin (on_twin)
import suite.conclude (Filing, Named, PassRecord)
import suite.select (Pass)
import claims (proofs, Accepted)
import env (env)
import proof.obligation (Record)
import tester (ledger, Filed)
import sources (under_abs)

/// The upstream `PLY_CACHE_UPSTREAM` names, as an absolute path read under `abs`.
pub type Upstream = { root: String, publish: Bool }

/// The store a run reads its results from and files them in.
pub type OpenStore = { place: loads::Place, cache: tables::Cache }

/// The store a command reads and files in: none under `--no-cache`, which also ignores the upstream.
pub fn store_for(
  paths: List<paths::Resolved>,
  no_cache: Bool,
) -> Option<OpenStore> / {fs.read[cwd], fs.read[abs], env.var[sys], env.pwd[sys], fs.read_file[shipped], abort.raise} =
  if no_cache { None } else { Some(open_store(paths, upstream_of_env(), loads::shipped_stamps())) }

fn upstream_of_env() -> Option<Upstream> / {env.var[sys], env.pwd[sys]} =
  match env.var[sys]("PLY_CACHE_UPSTREAM") {
    None -> None,
    Some(root) -> if root == "" { None } else {
      {
        let absolute = if string_starts_with(root, "/") { root }
        else { env.pwd[sys]() ++ "/" ++ root };
        Some({ root: absolute, publish: env.var[sys]("PLY_CACHE_UPSTREAM_READONLY") == None })
      }
    },
  }

pub fn open_store(
  paths: List<paths::Resolved>,
  upstream: Option<Upstream>,
  stamps: tables::Stamps,
) -> OpenStore / {fs.read[cwd], fs.read[abs], abort.raise} = {
  let place = loads::place_of(paths, stamps);
  let c = if place.label == "cwd" { tables::open_cache[cwd](place.dir, stamps) }
  else { tables::open_cache[abs](place.dir, stamps) };
  {
    place: place,
    cache: match upstream {
      Some(up) -> tables::with_upstream[abs](c, under_abs(up.root), up.publish),
      None -> c,
    },
  }
}

fn hex_set(xs: List<Bytes>) -> Map<String, Bool> / {abort.raise} =
  fold(xs, map_new(), |m: Map<String, Bool>, k: Bytes| map_insert(m, hex_of(k), true))

// --- The tests' -------------------------------------------------------------

/// An answer read from the store, and the store as reading it left it.
type StoreRead<a> = { value: a, cache: tables::Cache }

fn passes_over<[r], [u]>(
  c0: tables::Cache,
  keys: List<String>,
) -> StoreRead<List<Option<Bytes>>> / {fs.read[r], fs.read[u], abort.raise} =
  fold(keys, { value: [], cache: c0 }, |acc: StoreRead<List<Option<Bytes>>>, key: String| {
    let got = tables::pass_trace[r, u](acc.cache, bytes_of_hex(key));
    { value: push(acc.value, got.value), cache: got.cache }
  })

fn code_passes_over<[r], [u]>(
  c0: tables::Cache,
  keys: List<String>,
) -> StoreRead<List<Option<Bytes>>> / {fs.read[r], fs.read[u], abort.raise} =
  fold(keys, { value: [], cache: c0 }, |acc: StoreRead<List<Option<Bytes>>>, key: String| {
    let got = tables::code_pass_trace[r, u](acc.cache, bytes_of_hex(key));
    { value: push(acc.value, got.value), cache: got.cache }
  })

fn seen_over<[r]>(
  cache: tables::Cache,
  hashes: List<String>,
) -> List<Bool> / {fs.read[r], abort.raise} =
  map(hashes, |h: String| tables::knows_definition[r](cache, bytes_of_hex(h)))

fn named_list(m: Map<String, Bytes>) -> List<Named> / {abort.raise} =
  map_fold(m, [], |acc: List<Named>, name: String, hash: Bytes|
    push(acc, { name: name, hash: hex_of(hash) }))

fn named_map(xs: List<Named>) -> Map<String, Bytes> / {abort.raise} =
  fold(xs, map_new(), |m: Map<String, Bytes>, named: Named|
    map_insert(m, named.name, bytes_of_hex(named.hash)))

fn pass_records_over<[r]>(
  c0: tables::Cache,
  keys: List<String>,
) -> StoreRead<List<Option<PassRecord>>> / {fs.read[r], abort.raise} =
  fold(keys, { value: [], cache: c0 }, |acc: StoreRead<List<Option<PassRecord>>>, key: String| {
    let got = tables::pass_record[r](acc.cache, key);
    {
      value: push(acc.value, match got.value {
        Some(rec) ->
          Some({
            test: hex_of(rec.test_hash),
            closure: named_list(rec.closure),
            decls: named_list(rec.decls),
          }),
        None -> None,
      }),
      cache: got.cache,
    }
  })

/// A body filed under another encoding is not one this compiler reads.
fn bodies_over<[r]>(
  c0: tables::Cache,
  hashes: List<String>,
) -> StoreRead<List<Option<Bytes>>> / {fs.read[r], abort.raise} =
  fold(hashes, { value: [], cache: c0 }, |acc: StoreRead<List<Option<Bytes>>>, h: String| {
    let got = tables::body[r](acc.cache, bytes_of_hex(h));
    {
      value: push(acc.value, match got.value {
        Some(b) -> if b.encoding == body_encoding() { Some(b.bytes) } else { None },
        None -> None,
      }),
      cache: got.cache,
    }
  })

fn interfaces_over<[r]>(
  c0: tables::Cache,
  asked: List<{ hash: String, name: String }>,
) -> StoreRead<List<Option<DefInterface>>> / {fs.read[r], abort.raise} =
  fold(
    asked,
    { value: [], cache: c0 },
    |acc: StoreRead<List<Option<DefInterface>>>, a: { hash: String, name: String }| {
      let got = tables::def_of[r](acc.cache, bytes_of_hex(a.hash), a.name);
      {
        value: push(acc.value, match got.value {
          Some(bytes) -> match bin::decode(bytes, def_interface_bin()) {
            Ok(v) -> Some(v),
            Err(_) -> None,
          },
          None -> None,
        }),
        cache: got.cache,
      }
    },
  )

/// What a pass ran, put under the hash and name each was filed by.
fn kept_over<[r]>(
  c0: tables::Cache,
  defs: List<FiledDef>,
  bodies: List<FiledBody>,
) -> tables::Cache / {fs.read[r], abort.raise} =
  fold(
    bodies,
    fold(defs, c0, |c: tables::Cache, d: FiledDef|
      tables::put_def[r](
        c,
        d.hash,
        string_of_bytes_lossy(d.name),
        bin::encode(d.interface, def_interface_bin()),
      )),
    |c: tables::Cache, b: FiledBody|
      tables::put_body[r](c, b.hash, { encoding: body_encoding(), bytes: b.body }),
  )

/// What a filing puts, before anything is flushed: a pass already kept on the same trace, or a
/// sighting already kept, is not put again.
fn noted<[r], [u]>(
  c0: tables::Cache,
  f: Filing,
) -> tables::Cache / {fs.read[r], fs.read[u], abort.raise} = {
  let seen = hex_set(tables::seen_keys(c0));
  let c1 = fold(
    f.codes,
    fold(f.passes, c0, |c: tables::Cache, p: Pass| {
      let held = tables::pass_trace[r, u](c, bytes_of_hex(p.key));
      if held.value == Some(p.trace) { held.cache }
      else { tables::put_passed(held.cache, bytes_of_hex(p.key), p.trace) }
    }),
    |c: tables::Cache, p: Pass| {
      let held = tables::code_pass_trace[r, u](c, bytes_of_hex(p.key));
      if held.value == Some(p.trace) { held.cache }
      else { tables::put_passed_code(held.cache, bytes_of_hex(p.key), p.trace) }
    },
  );
  let c2 = fold(f.records, c1, |c: tables::Cache, e: { key: String, record: PassRecord }|
    tables::put_pass_record[r](c, e.key, {
      test_hash: bytes_of_hex(e.record.test),
      closure: named_map(e.record.closure),
      decls: named_map(e.record.decls),
    }));
  fold(f.seen, c2, |c: tables::Cache, hash: String|
    if map_contains(seen, hash) { c } else { tables::observe_definition(c, bytes_of_hex(hash)) })
}

fn filed_over<[r]>(
  cache: tables::Cache,
  f: Filing,
) -> tables::Cache / {fs.read[r], fs.write[r], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, abort.raise} =
  tables::flush_shared[r, abs](noted[r, abs](cache, f))

/// The store with what it had to say taken.
fn quiet(k: OpenStore) -> OpenStore =
  { ..k, cache: { ..k.cache, store: { ..k.cache.store, warnings: [] } } }

fn said(cache: tables::Cache) -> List<Diag> = loads::diags_of(tables::warnings(cache))

/// `ply test`'s reads and writes, over the store a run opened, each said once.
pub fn with_ledger<a | e>(
  kept: Option<OpenStore>,
  go: () -> a / {ledger.opened, ledger.passes, ledger.code_passes, ledger.seen, ledger.baselines, ledger.bodies, ledger.interfaces, ledger.history, ledger.filed | e},
) -> a / {abort.raise, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms | e} =
  with_cell[books](kept) { held -> {
    let read = |k: OpenStore, c: tables::Cache| cell_set(held, Some({ ..k, cache: c }));
    handle {
      go()
    } with {
      ledger.opened() -> match cell_get(held) {
        None -> [],
        Some(k) -> {
          cell_set(held, Some(quiet(k)));
          said(k.cache)
        },
      },
      ledger.passes(keys) -> match cell_get(held) {
        None -> map(keys, |key: String| None),
        Some(k) -> {
          let o = if k.place.label == "cwd" { passes_over[cwd, abs](k.cache, keys) }
          else { passes_over[abs, abs](k.cache, keys) };
          read(k, o.cache);
          o.value
        },
      },
      ledger.code_passes(keys) -> match cell_get(held) {
        None -> map(keys, |key: String| None),
        Some(k) -> {
          let o = if k.place.label == "cwd" { code_passes_over[cwd, abs](k.cache, keys) }
          else { code_passes_over[abs, abs](k.cache, keys) };
          read(k, o.cache);
          o.value
        },
      },
      ledger.seen(hashes) -> match cell_get(held) {
        None -> map(hashes, |h: String| false),
        Some(k) -> if k.place.label == "cwd" { seen_over[cwd](k.cache, hashes) }
        else { seen_over[abs](k.cache, hashes) },
      },
      ledger.baselines(keys) -> match cell_get(held) {
        None -> map(keys, |key: String| None),
        Some(k) -> {
          let o = if k.place.label == "cwd" { pass_records_over[cwd](k.cache, keys) }
          else { pass_records_over[abs](k.cache, keys) };
          read(k, o.cache);
          o.value
        },
      },
      ledger.bodies(hashes) -> match cell_get(held) {
        None -> map(hashes, |h: String| None),
        Some(k) -> {
          let o = if k.place.label == "cwd" { bodies_over[cwd](k.cache, hashes) }
          else { bodies_over[abs](k.cache, hashes) };
          read(k, o.cache);
          o.value
        },
      },
      ledger.interfaces(asked) -> match cell_get(held) {
        None -> map(asked, |a: { hash: String, name: String }| None),
        Some(k) -> {
          let o = if k.place.label == "cwd" { interfaces_over[cwd](k.cache, asked) }
          else { interfaces_over[abs](k.cache, asked) };
          read(k, o.cache);
          o.value
        },
      },
      ledger.history(defs, bodies) -> match cell_get(held) {
        None -> (),
        Some(k) -> {
          let c = if k.place.label == "cwd" { kept_over[cwd](k.cache, defs, bodies) }
          else { kept_over[abs](k.cache, defs, bodies) };
          cell_set(held, Some({ ..k, cache: c }))
        },
      },
      ledger.filed(f) -> match cell_get(held) {
        None -> { unflushed: None, warnings: [] },
        Some(k) -> {
          let c = if k.place.label == "cwd" { filed_over[cwd](k.cache, f) }
          else { filed_over[abs](k.cache, f) };
          cell_set(held, Some(quiet({ ..k, cache: c })));
          { unflushed: None, warnings: said(c) }
        },
      },
    }
  } }

// --- The prover's -----------------------------------------------------------

fn cached_over<[r]>(
  cache: tables::Cache,
  keys: List<String>,
) -> List<Option<Bytes>> / {fs.read[r], fs.read[abs], abort.raise} =
  map(keys, |key: String| tables::evidence_shared[r, abs](cache, bytes_of_hex(key)).value)

fn cached_of(
  kept: Option<OpenStore>,
  keys: List<String>,
) -> List<Option<Bytes>> / {fs.read[cwd], fs.read[abs], abort.raise} =
  match kept {
    None -> map(keys, |k: String| None),
    Some(k) -> if k.place.label == "cwd" { cached_over[cwd](k.cache, keys) }
    else { cached_over[abs](k.cache, keys) },
  }

type StoreWrite = { kept: Option<OpenStore>, diags: List<Diag> }

/// The store after a write, its warnings said once.
fn wrote(k: OpenStore, cache: tables::Cache) -> StoreWrite =
  {
    kept: Some({ ..k, cache: { ..cache, store: { ..cache.store, warnings: [] } } }),
    diags: loads::diags_of(tables::warnings(cache)),
  }

fn flushed(
  k: OpenStore,
  cache: tables::Cache,
) -> StoreWrite / {fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, abort.raise} =
  wrote(k, if k.place.label == "cwd" { tables::flush_shared[cwd, abs](cache) }
  else { tables::flush_shared[abs, abs](cache) })

fn recorded(
  kept: Option<OpenStore>,
  entries: List<{ key: String, evidence: Bytes }>,
) -> StoreWrite / {fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, abort.raise} =
  match kept {
    None -> { kept: None, diags: [] },
    Some(k) ->
      flushed(
        k,
        fold(entries, k.cache, |cache: tables::Cache, e: { key: String, evidence: Bytes }|
          tables::put_evidence(cache, bytes_of_hex(e.key), e.evidence)),
      ),
  }

fn baselines_over<[r]>(
  cache: tables::Cache,
  names: List<String>,
) -> List<{ name: String, record: Record }> / {fs.read[r], abort.raise} =
  fold(names, [], |acc: List<{ name: String, record: Record }>, name: String|
    match tables::review[r](cache, name).value {
      None -> acc,
      Some(rv) ->
        push(acc, {
          name: name,
          record: { def_hash: hex_of(rv.def), specs: map(rv.specs, hex_of) },
        }),
    })

fn baselines_of(
  kept: Option<OpenStore>,
  names: List<String>,
) -> List<{ name: String, record: Record }> / {fs.read[cwd], fs.read[abs], abort.raise} =
  match kept {
    None -> [],
    Some(k) -> if k.place.label == "cwd" { baselines_over[cwd](k.cache, names) }
    else { baselines_over[abs](k.cache, names) },
  }

fn accepted_of(
  kept: Option<OpenStore>,
  records: List<{ name: String, record: Record }>,
) -> { kept: Option<OpenStore>, accepted: Accepted } / {fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, abort.raise} =
  match kept {
    None -> { kept: None, accepted: { definitions: len(records), stored: false, warnings: [] } },
    Some(k) -> {
      let w = flushed(
        k,
        fold(records, k.cache, |cache: tables::Cache, r: { name: String, record: Record }|
          tables::put_review(cache, r.name, {
            def: bytes_of_hex(r.record.def_hash),
            specs: map(r.record.specs, bytes_of_hex),
          })),
      );
      {
        kept: w.kept,
        accepted: {
          definitions: len(records),
          stored: !fold(w.diags, false, |hit: Bool, diag: Diag| hit || diag.code == b"W0601"),
          warnings: w.diags,
        },
      }
    },
  }

/// The prover's reads and writes, over the store a run opened: evidence by key, its own or the
/// upstream's.
pub fn with_evidence<a | e>(
  kept: Option<OpenStore>,
  go: () -> a / {proofs.cached, proofs.record | e},
) -> a / {abort.raise, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms | e} =
  with_cell[store](kept) { held -> {
    handle {
      go()
    } with {
      proofs.cached(keys) -> cached_of(cell_get(held), keys),
      proofs.record(entries) -> {
        let w = recorded(cell_get(held), entries);
        cell_set(held, w.kept);
        w.diags
      },
    }
  } }

/// The same, and the baseline a reader accepted for each definition.
pub fn with_review<a | e>(
  kept: Option<OpenStore>,
  go: () -> a / {proofs.cached, proofs.record, proofs.baselines, proofs.accepted | e},
) -> a / {abort.raise, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms | e} =
  with_cell[store](kept) { held -> {
    handle {
      go()
    } with {
      proofs.cached(keys) -> cached_of(cell_get(held), keys),
      proofs.record(entries) -> {
        let w = recorded(cell_get(held), entries);
        cell_set(held, w.kept);
        w.diags
      },
      proofs.baselines(names) -> baselines_of(cell_get(held), names),
      proofs.accepted(records) -> {
        let a = accepted_of(cell_get(held), records);
        cell_set(held, a.kept);
        a.accepted
      },
    }
  } }

// --- Tests ------------------------------------------------------------------

fn hash_hex(s: String) -> String / {abort.raise} = hex_of(bytes_blake3(bytes_of_string(s)))

/// A body that is its own component, filed under the hash of its payload.
fn solo(payload: String) -> { hash: Bytes, body: Bytes } / {abort.raise} = {
  let body = byte_of_int(0) ++ bytes_of_string(payload);
  { hash: match body_key(body) { Some(k) -> k, None -> b"" }, body: body }
}

fn a_filing() -> Filing / {abort.raise} =
  {
    passes: [{ key: hash_hex("t key"), trace: b"file\tcwd\ta\td\n" }],
    codes: [{ key: hash_hex("t code"), trace: b"" }],
    records: [
      {
        key: "m.t",
        record: { test: hash_hex("t"), closure: [{ name: "m.f", hash: hash_hex("f") }], decls: [] },
      },
    ],
    seen: [hash_hex("f")],
  }

fn built() -> tables::Stamps = { runtime: "runtime", code: "code" }

/// What a later run reads back of a filing, beside a body filed before it, and what one whose
/// runtime stamp moved reads of its code keys.
fn read_back(
  f: Filing,
) -> { passes: List<Option<Bytes>>, codes: List<Option<Bytes>>, moved: List<Option<Bytes>>, seen: List<Bool>, baselines: List<Option<PassRecord>>, bodies: List<Option<Bytes>> } / {abort.raise} = {
  let b = solo("old f");
  on_twin(mem_empty(), || {
    let c0 = tables::put_body[mem](tables::open_cache[mem]("cache", built()), b.hash, {
      encoding: body_encoding(),
      bytes: b.body,
    });
    let c1 = tables::flush_cache[mem](noted[mem, mem](c0, f));
    let r = tables::open_cache[mem]("cache", built());
    let moved = tables::open_cache[mem]("cache", { ..built(), runtime: "another" });
    {
      passes: passes_over[mem, mem](r, [hash_hex("t key"), hash_hex("other")]).value,
      codes: code_passes_over[mem, mem](r, [hash_hex("t code"), hash_hex("t key")]).value,
      moved: fold(
        code_passes_over[mem, mem](moved, [hash_hex("t code")]).value,
        passes_over[mem, mem](moved, [hash_hex("t key")]).value,
        |acc: List<Option<Bytes>>, o: Option<Bytes>| push(acc, o),
      ),
      seen: seen_over[mem](r, [hash_hex("f"), hash_hex("g")]),
      baselines: pass_records_over[mem](r, ["m.t", "m.u"]).value,
      bodies: bodies_over[mem](r, [hex_of(b.hash), hash_hex("missing")]).value,
    }
  }).value
}

test "a run's passes, baselines and sightings are kept, and read back by key" {
  let back = read_back(a_filing());
  assert_eq(back.passes, [Some(b"file\tcwd\ta\td\n"), None]);
  assert_eq(back.codes, [Some(b""), None]);
  // Another runtime stamp drops the passes keyed by test, and keeps the ones keyed by code.
  assert_eq(back.moved, [None, Some(b"")]);
  assert_eq(back.seen, [true, false]);
  assert_eq(back.baselines, [
    Some({ test: hash_hex("t"), closure: [{ name: "m.f", hash: hash_hex("f") }], decls: [] }),
    None,
  ]);
  assert_eq(back.bodies, [Some(solo("old f").body), None])
}

// Bodies outlive a build: what keeps an older build's from being read is that its baselines do not.
test "another build's baselines are dropped with its passes, and a body under another encoding is not read" {
  let mine = solo("f as this build stores it");
  let theirs = solo("f as another stored it");
  let back = on_twin(mem_empty(), || {
    let filed = tables::put_body[mem](
      tables::put_body[mem](tables::open_cache[mem]("cache", built()), mine.hash, {
        encoding: body_encoding(),
        bytes: mine.body,
      }),
      theirs.hash,
      { encoding: body_encoding() + 1, bytes: theirs.body },
    );
    let c1 = tables::flush_cache[mem](noted[mem, mem](filed, a_filing()));
    let moved = tables::open_cache[mem]("cache", { ..built(), runtime: "another" });
    {
      baselines: pass_records_over[mem](moved, ["m.t"]).value,
      bodies: bodies_over[mem](moved, [hex_of(mine.hash), hex_of(theirs.hash)]).value,
    }
  }).value;
  assert_eq(back.baselines, [None]);
  assert_eq(back.bodies, [Some(mine.body), None])
}

test "a filing of nothing keeps nothing" {
  let back = read_back({ passes: [], codes: [], records: [], seen: [] });
  assert_eq(back.passes, [None, None]);
  assert_eq(back.seen, [false, false]);
  assert_eq(back.baselines, [None, None])
}
