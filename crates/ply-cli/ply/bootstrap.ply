//! `ply bootstrap` — a program this binary ships written out as its launcher enters it: the builder
//! (`build.main`, the compiler's own) or `ply` itself (`ply.main`), each as `<stem>.run` beside the
//! `<stem>.digest` the launcher gates it on and the `<stem>.key` a builder takes it under for
//! another text that enters the same definition. The front end, the emission and the runnable are this
//! program's, and so is what `--verify` makes of them.

import args (Flags, style_of)
import build (Def, defs_of)
import builder (builder)
import diagnostic (Place)
import env (env)
import paths (Rooted, child, create_dir, read_file, spelled, write_file)
import program (Timed, load_diagnostics, front_of, timed_load)
import report (Answer, ok_code, compile_error, refused, reported)
import style (Style, plain)
import units (emit, whole)
import compiler.embed (EmbedAt, EmbedFile)
import compiler.front (Analysis, shipped_dump)
import compiler.hash (hex)
import compiler.load (every_root)
import compiler.resolve (Diag, error_at)
import compiler.unit (shipped, program_key)
import std.fs (fs)
import std.hash (blake3)
import std.json (Json, Str, Bool, Number, Array, object)
import std.random (entropy)
import std.time (time)
import compiler.parsing (no_module)

/// What `ply bootstrap` is configured with, as the program parses it.
pub type Options = { out: String, verify: Bool }

/// A program this binary ships: the definition it enters, and the name its files go by.
pub type Shipped = { entry: String, stem: String }

pub fn programs() -> List<Shipped> =
  [{ entry: "build.main", stem: "build" }, { entry: "ply.main", stem: "ply" }]

/// The two digests a runnable is described by: the one its launcher gates it on, and over its bytes.
pub type Described = { digest: String, runnable: String }

pub type Emitted = {
  program: Shipped,
  /// What the launcher gates the program on, which `<stem>.digest` holds.
  digest: String,
  /// Over `<stem>.run`, which is what `--verify` checks.
  runnable: String,
  /// What a builder keeps the program under, which `<stem>.key` holds; empty for an entry the front
  /// end gave no hash.
  key: String,
  definitions: Int,
  bytes: Int,
  /// The bytes of every file the program's modules embed, a shipped module's data among them. The
  /// runnable's unit holds what its definitions reach of them, so a binary that enters it reads none.
  embedded: Int,
  /// Where the files go, whether or not they are there.
  at: String,
  /// The files on disk as `--verify` read them; `None` when there are none, and on a run that wrote.
  recorded: Option<Described>,
}

fn described(emitted: Emitted) -> Json =
  object([
    { key: "digest", value: Str(emitted.digest) },
    { key: "runnable", value: Str(emitted.runnable) },
  ])

fn described_json(d: Described) -> Json =
  object([{ key: "digest", value: Str(d.digest) }, { key: "runnable", value: Str(d.runnable) }])

// --- Refusals -----------------------------------------------------------------

fn nowhere(message: String, label: Bytes) -> Diag =
  error_at(b"E0502", no_module(), { start: 0, end: 0 }, bytes_of_string(message), label, [])

fn no_runnable(at: String) -> Diag =
  nowhere("no runnable at " ++ at, b"`--verify` compares against a runnable already written")

fn not_shipped(found: List<Shipped>) -> Diag =
  nowhere(
    if len(found) == 0 { "this is no program this binary ships" }
    else { "this is more than one program this binary ships" },
    b"`ply bootstrap` writes the builder (`build.main`) or `ply` itself (`ply.main`); `ply build` builds any other program",
  )

fn refusing(style: Style, diag: Diag) -> Answer / {abort.raise} =
  reported(style, "bootstrap", [diag], [])

// --- `--verify` -------------------------------------------------------------------

fn agrees(emitted: Emitted) -> Answer =
  {
    json: object([
      { key: "command", value: Str("bootstrap") },
      { key: "ok", value: Bool(true) },
      { key: "exit_code", value: Number(decimal_of_int(ok_code())) },
      { key: "verified", value: described(emitted) },
    ]),
    lines: ["the runnable describes this tree: " ++ emitted.digest],
    errs: [],
    code: ok_code(),
  }

fn differs(emitted: Emitted, recorded: Described) -> Answer =
  {
    json: object([
      { key: "command", value: Str("bootstrap") },
      { key: "ok", value: Bool(false) },
      { key: "exit_code", value: Number(decimal_of_int(compile_error())) },
      { key: "recorded", value: described_json(recorded) },
      { key: "emitted", value: described(emitted) },
    ]),
    lines: [],
    errs: [
      "the runnable does not describe this tree:",
      "  recorded " ++ recorded.digest ++ " " ++ recorded.runnable,
      "  emitted  " ++ emitted.digest ++ " " ++ emitted.runnable,
    ],
    code: compile_error(),
  }

fn verified(style: Style, emitted: Emitted) -> Answer / {abort.raise} =
  match emitted.recorded {
    None -> refusing(style, no_runnable(emitted.at)),
    Some(d) -> if d.digest == emitted.digest && d.runnable == emitted.runnable { agrees(emitted) }
    else { differs(emitted, d) },
  }

// --- What a run writes ----------------------------------------------------------

pub fn wrote(emitted: Emitted) -> Answer =
  {
    json: object([
      { key: "command", value: Str("bootstrap") },
      { key: "ok", value: Bool(true) },
      { key: "exit_code", value: Number(decimal_of_int(ok_code())) },
      { key: "entry", value: Str(emitted.program.entry) },
      { key: "wrote", value: Str(emitted.at) },
      { key: "embedded", value: Number(decimal_of_int(emitted.embedded)) },
      { key: "runnable", value: described(emitted) },
    ]),
    lines: [
      emitted.program.entry ++ ": " ++ int_to_string(emitted.definitions) ++ " definitions, "
        ++ int_to_string(emitted.bytes)
        ++ " bytes of C, "
        ++ int_to_string(emitted.embedded)
        ++ " bytes embedded",
      "digest   " ++ emitted.digest,
      "runnable " ++ emitted.runnable,
      "wrote    " ++ emitted.at,
    ],
    errs: [],
    code: ok_code(),
  }

fn runnable_file(p: Shipped) -> String = p.stem ++ ".run"

fn digest_file(p: Shipped) -> String = p.stem ++ ".digest"

fn unwritable(at: String) -> Diag =
  nowhere("could not write the runnable at " ++ at, b"the runnable could not be written")

fn recorded_at(
  out: Rooted,
  p: Shipped,
) -> Option<Described> / {fs.read_file[cwd], fs.read_file[abs], abort.raise} =
  match read_file(child(out, digest_file(p))) {
    None -> None,
    Some(digest) -> match read_file(child(out, runnable_file(p))) {
      None -> None,
      Some(bytes) ->
        Some({
          digest: string_trim(string_of_bytes(digest)),
          runnable: string_of_bytes(hex(blake3(bytes))),
        }),
    },
  }

fn key_file(p: Shipped) -> String = p.stem ++ ".key"

/// The runnable, the digest it is gated on, and the key a builder takes it under.
fn landed(
  out: Rooted,
  emitted: Emitted,
  bytes: Bytes,
) -> Bool / {fs.create_dir[cwd], fs.create_dir[abs], fs.write_file[cwd], fs.write_file[abs]} =
  create_dir(out) && write_file(child(out, runnable_file(emitted.program)), bytes)
    && write_file(child(out, digest_file(emitted.program)), bytes_of_string(emitted.digest ++ "\n"))
    && write_file(child(out, key_file(emitted.program)), bytes_of_string(emitted.key ++ "\n"))

fn embedded_bytes(embeds: List<EmbedAt>) -> Int =
  fold(embeds, 0, |acc: Int, embed: EmbedAt|
    match embed.read {
      Ok(files) -> fold(files, acc, |sum: Int, file: EmbedFile| sum + bytes_len(file.bytes)),
      Err(_) -> acc,
    })

/// What the definition the program enters hashes to.
fn entry_hash(analysis: Analysis, p: Shipped) -> Option<Bytes> =
  fold(analysis.hashes.defs, None, |acc: Option<Bytes>, d: { name: Bytes, hash: Bytes }|
    if d.name == bytes_of_string(p.entry) { Some(d.hash) } else { acc })

/// Which program this binary ships the tree is, by the definition it holds that one of them enters.
fn shipped_of(analysis: Analysis) -> List<Shipped> = {
  let names = map(defs_of(analysis), |def: Def| def.name);
  filter(programs(), |p: Shipped| len(filter(names, |n: String| n == p.entry)) > 0)
}

pub fn run(
  flags: Flags,
) -> Answer / {builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, time.elapsed_us, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, emit.unit, env.shipped_digest[sys], env.builder_digest[sys], shipped.runnable, shipped.runtime, shipped.definitions, abort.raise, diverges, shipped.reached} = {
  let s = style_of(flags);
  let options = options_of(flags);
  let t: Timed = timed_load(flags.paths, false, false);
  match t.program.whole {
    None -> refused(s, "bootstrap", load_diagnostics(t.program), t.program.places),
    Some(w) -> match shipped_of(w) {
      [p] -> {
        let front = front_of(t, w);
        match whole(front) {
          Err(diags) -> reported(s, "bootstrap", diags, t.program.places),
          Ok(unit) -> {
            let bytes = shipped.runnable(p.entry, front.files, shipped_dump(front.dump), unit);
            let out = spelled(options.out);
            let emitted = {
              program: p,
              digest: if p.stem == "build" { env.builder_digest[sys]() }
              else { env.shipped_digest[sys]() },
              runnable: string_of_bytes(hex(blake3(bytes))),
              key: match entry_hash(w, p) {
                Some(h) ->
                  string_of_bytes(program_key(h, shipped.runtime(), shipped.definitions())),
                None -> "",
              },
              definitions: len(every_root(front)),
              bytes: bytes_len(unit),
              embedded: embedded_bytes(front.dump.embeds),
              at: options.out,
              recorded: None,
            };
            if options.verify { verified(s, { ..emitted, recorded: recorded_at(out, p) }) }
            else if landed(out, emitted, bytes) { wrote(emitted) }
            else { refusing(s, unwritable(options.out)) }
          },
        }
      },
      found -> refusing(s, not_shipped(found)),
    },
  }
}

/// The options the runnable is written under, from the parsed line.
fn options_of(flags: Flags) -> Options =
  { out: match flags.out { Some(o) -> o, None -> "bootstrap" }, verify: flags.action == "verify" }

// --- Tests ------------------------------------------------------------------

fn a_runnable() -> Emitted =
  {
    program: { entry: "ply.main", stem: "ply" },
    digest: "1a2b",
    runnable: "3c4d",
    key: "5e6f",
    definitions: 12,
    bytes: 4096,
    embedded: 1810,
    at: "bootstrap",
    recorded: None,
  }

test "a run that wrote the runnable reports both digests and where it landed" {
  let answer = wrote(a_runnable());
  assert_eq(answer.code, 0);
  assert_eq(answer.lines, [
    "ply.main: 12 definitions, 4096 bytes of C, 1810 bytes embedded",
    "digest   1a2b",
    "runnable 3c4d",
    "wrote    bootstrap",
  ])
}

test "`--verify` takes a runnable that says what this tree builds, and refuses one that does not" {
  let s = plain();
  let same = verified(s, { ..a_runnable(), recorded: Some({ digest: "1a2b", runnable: "3c4d" }) });
  assert_eq(same.code, 0);
  assert_eq(same.lines, ["the runnable describes this tree: 1a2b"]);
  let moved = verified(s, { ..a_runnable(), recorded: Some({ digest: "ffff", runnable: "3c4d" }) });
  assert_eq(moved.code, 2);
  assert_eq(list_at(moved.errs, 0), Some("the runnable does not describe this tree:"))
}

test "`--verify` with no runnable to compare against says where it looked" {
  let answer = verified(plain(), a_runnable());
  assert_eq(answer.code, 2);
  assert(answer.errs != [])
}
