// `ply bootstrap` — the compiler written out as the bundle the runtime builds its emitter from: its
// unit's C gzipped as `unit.c.gz`, beside the `SOURCES.digest` of the modules it came from. The
// front end, the emission and the unit are this program's, and so is what `--verify` makes of them.

import args (Flags, style_of)
import cache (Front)
import builder (builder)
import diagnostic (Place)
import paths (Rooted, child, create_dir, read_file, spelled, write_file)
import program (Timed, front_of, outside, timed_load)
import report (Answer, ok_code, compile_error, refused, reported)
import style (Style, plain)
import units (emit, every_root, whole)
import compiler.front (ModuleRow)
import compiler.hash (hex)
import compiler.resolve (Diag, diag1)
import std.fs (fs)
import std.hash (blake3)
import std.json (Json, Str, Bool, Number, Array, object)
import std.random (entropy)
import std.time (time)

// What `ply bootstrap` is configured with, as the program parses it.
pub type Options = { out: String, verify: Bool }

// The two digests an archive is described by: over the sources it came from, and over the
// gzipped C it holds.
pub type Described = { source: String, artifact: String }

pub type Emitted = {
  // Over the module texts, sorted: the version the archive is of, which `SOURCES.digest` holds.
  source: String,
  // Over `unit.c.gz`, which is what `--verify` checks.
  artifact: String,
  definitions: Int,
  bytes: Int,
  // Where the bundle lives, whether or not one is there.
  at: String,
  // The bundle on disk as `--verify` read it; `None` when there is none, and on a run that wrote.
  recorded: Option<Described>,
}

fn described(e: Emitted) -> Json =
  object([{ key: "source", value: Str(e.source) }, { key: "artifact", value: Str(e.artifact) }])

fn described_json(d: Described) -> Json =
  object([{ key: "source", value: Str(d.source) }, { key: "artifact", value: Str(d.artifact) }])

// --- Refusals -----------------------------------------------------------------

fn nowhere(message: String, label: Bytes) -> Diag =
  diag1(b"E0502", outside(), { start: 0, end: 0 }, bytes_of_string(message), label, [])

fn no_archive(at: String) -> Diag =
  nowhere("no archive at " ++ at, b"`--verify` compares against an archive already written")

fn refusing(s: Style, d: Diag) -> Answer / {abort.raise} = reported(s, "bootstrap", [d], [])

// --- `--verify` -------------------------------------------------------------------

fn agrees(e: Emitted) -> Answer =
  {
    json: object([
      { key: "command", value: Str("bootstrap") },
      { key: "ok", value: Bool(true) },
      { key: "exit_code", value: Number(decimal_of_int(ok_code())) },
      { key: "verified", value: described(e) },
    ]),
    lines: ["the archive describes this tree: " ++ e.source],
    errs: [],
    code: ok_code(),
  }

fn differs(e: Emitted, recorded: Described) -> Answer =
  {
    json: object([
      { key: "command", value: Str("bootstrap") },
      { key: "ok", value: Bool(false) },
      { key: "exit_code", value: Number(decimal_of_int(compile_error())) },
      { key: "recorded", value: described_json(recorded) },
      { key: "emitted", value: described(e) },
    ]),
    lines: [],
    errs: [
      "the archive does not describe this tree:",
      "  recorded " ++ recorded.source ++ " " ++ recorded.artifact,
      "  emitted  " ++ e.source ++ " " ++ e.artifact,
    ],
    code: compile_error(),
  }

fn verified(s: Style, e: Emitted) -> Answer / {abort.raise} =
  match e.recorded {
    None -> refusing(s, no_archive(e.at)),
    Some(d) -> if d.source == e.source && d.artifact == e.artifact { agrees(e) }
    else { differs(e, d) },
  }

// --- The archive a run writes -------------------------------------------------------

pub fn wrote(e: Emitted) -> Answer =
  {
    json: object([
      { key: "command", value: Str("bootstrap") },
      { key: "ok", value: Bool(true) },
      { key: "exit_code", value: Number(decimal_of_int(ok_code())) },
      { key: "wrote", value: Str(e.at) },
      { key: "archive", value: described(e) },
    ]),
    lines: [
      int_to_string(e.definitions) ++ " definitions, " ++ int_to_string(e.bytes) ++ " bytes of C",
      "source   " ++ e.source,
      "artifact " ++ e.artifact,
      "wrote    " ++ e.at,
    ],
    errs: [],
    code: ok_code(),
  }

fn unit_file() -> String = "unit.c.gz"

fn sources_file() -> String = "SOURCES.digest"

// The version an archive is of: every module the program was built from, its own and the shipped
// ones it pulled, by name, as the runtime digests the emitter it embeds.
fn sources_digest(front: Front) -> String / {abort.raise} = {
  let named = map_values(
    fold(front.dump.modules, map_new(), |acc: Map<Bytes, Bytes>, m: ModuleRow|
      map_insert(
        acc,
        m.name,
        bytes_concat_all([
          m.name,
          b"\x00",
          match list_at(front.files, m.index) { Some(f) -> f.text, None -> b"" },
          b"\x00",
        ]),
      )),
  );
  string_slice(string_of_bytes(hex(blake3(bytes_concat_all(named)))), 0, 16)
}

fn unwritable(at: String) -> Diag =
  nowhere("could not write the archive at " ++ at, b"the archive could not be written")

fn recorded_at(
  out: Rooted,
) -> Option<Described> / {fs.read_file[cwd], fs.read_file[abs], abort.raise} =
  match read_file(child(out, sources_file())) {
    None -> None,
    Some(digest) -> match read_file(child(out, unit_file())) {
      None -> None,
      Some(unit) ->
        Some({
          source: string_trim(string_of_bytes(digest)),
          artifact: string_of_bytes(hex(blake3(unit))),
        }),
    },
  }

fn landed(
  out: Rooted,
  packed: Bytes,
  source: String,
) -> Bool / {fs.create_dir[cwd], fs.create_dir[abs], fs.write_file[cwd], fs.write_file[abs]} =
  create_dir(out) && write_file(child(out, unit_file()), packed)
    && write_file(child(out, sources_file()), bytes_of_string(source ++ "\n"))

pub fn run(
  flags: Flags,
) -> Answer / {builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shelf], fs.read_file[shelf], time.elapsed_ms, time.elapsed_us, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, emit.unit, abort.raise} = {
  let s = style_of(flags);
  let options = options_of(flags);
  let t: Timed = timed_load(flags.paths, false, false);
  match t.program.whole {
    None -> refused(s, "bootstrap", t.program.diags, t.program.places),
    Some(w) -> {
      let front = front_of(t, w);
      match whole(front) {
        Err(diags) -> reported(s, "bootstrap", diags, t.program.places),
        Ok(text) -> {
          let packed = bytes_gzip(text);
          let out = spelled(options.out);
          let emitted = {
            source: sources_digest(front),
            artifact: string_of_bytes(hex(blake3(packed))),
            definitions: len(every_root(front)),
            bytes: bytes_len(text),
            at: options.out,
            recorded: None,
          };
          if options.verify { verified(s, { ..emitted, recorded: recorded_at(out) }) }
          else if landed(out, packed, emitted.source) { wrote(emitted) }
          else { refusing(s, unwritable(options.out)) }
        },
      }
    },
  }
}

// The options the archive is written under, from the parsed line.
fn options_of(flags: Flags) -> Options =
  { out: match flags.out { Some(o) -> o, None -> "bootstrap" }, verify: flags.action == "verify" }

// --- Tests ------------------------------------------------------------------

fn an_archive() -> Emitted =
  {
    source: "1a2b",
    artifact: "3c4d",
    definitions: 12,
    bytes: 4096,
    at: "bootstrap",
    recorded: None,
  }

test "a run that wrote the archive reports both digests and where it landed" {
  let answer = wrote(an_archive());
  assert_eq(answer.code, 0);
  assert_eq(answer.lines, [
    "12 definitions, 4096 bytes of C",
    "source   1a2b",
    "artifact 3c4d",
    "wrote    bootstrap",
  ])
}

test "`--verify` takes an archive that says what this tree emits, and refuses one that does not" {
  let s = plain();
  let same = verified(s, { ..an_archive(), recorded: Some({ source: "1a2b", artifact: "3c4d" }) });
  assert_eq(same.code, 0);
  assert_eq(same.lines, ["the archive describes this tree: 1a2b"]);
  let moved = verified(s, { ..an_archive(), recorded: Some({ source: "ffff", artifact: "3c4d" }) });
  assert_eq(moved.code, 2);
  assert_eq(list_at(moved.errs, 0), Some("the archive does not describe this tree:"))
}

test "`--verify` with no archive to compare against says where it looked" {
  let answer = verified(plain(), an_archive());
  assert_eq(answer.code, 2);
  assert(answer.errs != [])
}
