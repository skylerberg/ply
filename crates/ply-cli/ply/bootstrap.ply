//! `ply bootstrap` — a native `ply` built from a checkout by this one. The runtime's library is the
//! one cargo built of the checkout's Rust, which describes itself; the builder is a program that
//! enters the checkout's compiler, built here against that description over the checkout's shipped
//! modules, which this `ply`'s packed answers answer for wherever they did not move; the builder
//! builds the checkout's `ply` and holds its constants on that runtime; that is linked into a native
//! `ply`, which answers the shipped modules; and its pack carries the shipped modules, those answers
//! and what its front end answered of the definition it enters. The builder and the pack are each
//! kept in the toolchain's cache under what decides them, so a bootstrap of what an earlier one built
//! makes neither again. Only the shipped modules the builder pulls are built by this `ply`'s
//! compiler, so only they cannot use a language rule the checkout introduces.

import args (Flags, no_flags, style_of)
import env (env)
import program (Timed, front_of, timed_uncached_over, program_view)
import report (Answer, ok_code, compile_error, refused, reported)
import sources (Project, shipped_names)
import compiler.cc
import compiler.cc (Toolchain, compilers, toolchain)
import compiler.front (linked_of)
import compiler.interface (sized)
import compiler.load (LoadedAnalysis, every_root)
import compiler.native
import compiler.native (Packed)
import compiler.parsing (no_module)
import compiler.resolve (Diag, error_at)
import compiler.unit (Runtime, shipped, emitted, emitter_identity, held, identity_of, read_kept,
                      write_kept)
import std.bytes (hex_of, u64_at, u64_le)
import std.fs
import std.fs (fs, Entry, File)
import std.hash (blake3)
import std.json (Json, Str, Bool, object)
import std.list (at, concat)
import std.string (join, replace)
import std.process (process)
import std.random (entropy)
import std.time (time)
import std.path (below_root, parent)

/// What a bootstrap is told: the checkout, the profile it compiles under, the runtime's library and
/// where the `ply` it builds goes.
pub type Options = { root: String, profile: String, library: String, out: String }

/// `path` made absolute against the working directory `pwd`.
fn absolute(pwd: String, path: String) -> String =
  if string_starts_with(path, "/") { path } else if path == "." { pwd } else { pwd ++ "/" ++ path }

fn options_of(flags: Flags) -> Options / {env.pwd[sys]} = {
  let pwd = env.pwd[sys]();
  let root = match list_at(flags.paths, 0) { Some(r) -> r.absolute, None -> pwd };
  let profile = match flags.profile { Some("release") -> "release", _ -> "development" };
  let target = root ++ "/target/" ++ (if profile == "release" { "release" } else { "debug" });
  {
    root: root,
    profile: profile,
    library: match flags.runtime {
      Some(l) -> absolute(pwd, l),
      None -> target ++ "/libply_native.a",
    },
    out: match flags.out { Some(o) -> absolute(pwd, o), None -> target ++ "/ply" },
  }
}

fn nowhere(message: String) -> Diag =
  error_at(b"E0502", no_module(), { start: 0, end: 0 }, bytes_of_string(message), b"", [])

/// What a native program's objects compile at under `profile`.
fn level_of(profile: String) -> String = if profile == "release" { "-O2" } else { "-O0" }

// --- The checkout's shipped modules ---------------------------------------------------

/// Where a checkout keeps the standard library, the compiler and the builtins it declares.
fn std_dir() -> String = "crates/ply-std/ply"

fn compiler_dir() -> String = "crates/ply-compiler/ply"

fn prelude_path() -> String = "crates/ply-compiler/prelude.ply"

/// One file a shipped root holds, by the name it is read under there, and the path a pack keeps it
/// under.
type Shipping = { name: String, path: String, bytes: Bytes }

/// Every file below `dir` but those in a hidden directory, a cache, by its path below it.
fn files_below(
  root: String,
  dir: String,
) -> List<{ rel: String, bytes: Bytes }> / {fs.read[abs], abort.raise} =
  match fs.walk[abs](below_root(root ++ "/" ++ dir)) {
    None -> [],
    Some(entries) ->
      fold(entries, [], |acc: List<{ rel: String, bytes: Bytes }>, e: Entry|
        match e.kind {
          File -> {
            let rel = string_slice(
              e.path,
              string_len(below_root(root ++ "/" ++ dir)) + 1,
              string_len(e.path),
            );
            if string_starts_with(rel, ".") || string_contains(rel, "/.") { acc } else {
              match fs.read_file[abs](e.path) {
                Some(bytes) -> push(acc, { rel: rel, bytes: bytes }),
                None -> acc,
              }
            }
          },
          _ -> acc,
        }),
  }

/// The checkout's shipped modules and data, each as a shipped root names it and a pack keeps it:
/// `std.hash.legacy.ply` for `hash/legacy.ply`, `std/<path>` for a data file, `compiler.<stem>.ply`
/// for a module of the compiler, and `compiler.prelude.ply` for its builtins.
fn shipping(root: String) -> List<Shipping> / {fs.read[abs], abort.raise} = {
  let std_files = map(files_below(root, std_dir()), |f: { rel: String, bytes: Bytes }|
    if string_ends_with(f.rel, ".ply") {
      {
        name: "std." ++ replace(string_slice(f.rel, 0, string_len(f.rel) - 4), "/", ".") ++ ".ply",
        path: std_dir() ++ "/" ++ f.rel,
        bytes: f.bytes,
      }
    } else { { name: "std/" ++ f.rel, path: std_dir() ++ "/" ++ f.rel, bytes: f.bytes } });
  let compiler_files = fold(
    files_below(root, compiler_dir()),
    [],
    |acc: List<Shipping>, f: { rel: String, bytes: Bytes }|
      if string_ends_with(f.rel, ".ply") && !string_contains(f.rel, "/") {
        push(acc, {
          name: "compiler." ++ string_slice(f.rel, 0, string_len(f.rel) - 4) ++ ".ply",
          path: compiler_dir() ++ "/" ++ f.rel,
          bytes: f.bytes,
        })
      } else { acc },
  );
  let prelude = match fs.read_file[abs](below_root(root ++ "/" ++ prelude_path())) {
    Some(bytes) -> [{ name: "compiler.prelude.ply", path: prelude_path(), bytes: bytes }],
    None -> [],
  };
  concat(concat(std_files, compiler_files), prelude)
}

fn module_names(files: List<Shipping>) -> List<String> / {abort.raise} =
  fold(files, [], |acc: List<String>, f: Shipping|
    if string_ends_with(f.name, ".ply") {
      push(acc, string_slice(f.name, 0, string_len(f.name) - 4))
    } else { acc })

/// Whether `files` are the very shipped modules this `ply` carries: each file as it carries it, and
/// no module of its own left out.
fn carried(
  files: List<Shipping>,
) -> Bool / {fs.list_dir[shipped], fs.read_file[shipped], abort.raise} =
  len(shipped_names()) == len(module_names(files))
    && fold(files, true, |same: Bool, f: Shipping|
      same && fs.read_file[shipped](f.name) == Some(f.bytes))

/// `body` with the shipped modules as `files` hold them in place of this `ply`'s own: what a load of
/// the checkout's compiler compiles it against. Packed answers still answer where they agree with
/// what they read, and are taken as standing for these files only where they are the very ones this
/// `ply` carries.
fn over_shipping<a | e>(
  files: List<Shipping>,
  body: () -> a / {fs.list_dir[shipped], fs.read_file[shipped], shipped.names, shipped.module, shipped.answer | e},
) -> a / {fs.list_dir[shipped], fs.read_file[shipped], shipped.answer, abort.raise | e} = {
  let by_name = fold(files, map_new(), |acc: Map<String, Bytes>, f: Shipping|
    map_insert(acc, f.name, f.bytes));
  let names = module_names(files);
  let stands = carried(files);
  handle {
    body()
  } with {
    fs.list_dir[shipped](dir) -> if dir == "." {
      match fs.list_dir[shipped](".") {
        Some(own) ->
          Some(
            concat(
              filter(own, |n: String| !string_ends_with(n, ".ply") && n != "std"),
              map_keys(by_name),
            ),
          ),
        None -> Some(map_keys(by_name)),
      }
    } else { fs.list_dir[shipped](dir) },
    fs.read_file[shipped](name) -> match map_get(by_name, name) {
      Some(bytes) -> Some(bytes),
      None -> fs.read_file[shipped](name),
    },
    shipped.names() -> names,
    shipped.module(name) -> match map_get(by_name, name ++ ".ply") {
      Some(bytes) -> Some(bytes),
      None -> map_get(by_name, name),
    },
    shipped.answer(path) -> if path == "standing" && !stands { None } else { shipped.answer(path) },
  }
}

// --- Building -------------------------------------------------------------------------

/// What a bootstrap's builds reach beside the loads they make: the compilers and their cache, the
/// checkout and where the `ply` it builds goes, below the filesystem's root.
pub effect set Bootstraps = {compilers.write[cc], toolchain.read, toolchain.write, fs.read[abs], fs.write[abs], shipped.front, time.elapsed_ms}

fn failed<a>(why: String) -> Result<a, List<Diag>> = Err([nowhere(why)])

/// The toolchain native programs compile with under `profile`: `cc`, which links them too.
fn toolchain_for(profile: String) -> Result<Toolchain, List<Diag>> / {compilers.read[cc]} =
  match compilers.found[cc]() {
    None -> failed("no `cc` is installed to compile C with"),
    Some(compiler) -> Ok(cc::toolchain_of(compiler, level_of(profile))),
  }

/// The runtime the library at `library` is, as a program linked with it and nothing else says.
fn described(
  t: Toolchain,
  library: String,
  work: String,
) -> Result<Runtime, List<Diag>> / {compilers.write[cc], toolchain.read, toolchain.write, abort.raise} =
  match cc::executable[cc](
      t,
      native::describer_c(),
      [],
      concat([library], toolchain.libraries()),
      work,
    ) {
    Err(why) -> failed("the runtime's library at `" ++ library ++ "` does not link: " ++ why),
    Ok(exe) -> {
      let ran = toolchain.ran(relative(exe), []);
      if ran.code != 0 {
        failed("the runtime's library does not describe itself: " ++ string_of_bytes_lossy(ran.err))
      } else {
        match native::runtime_of(ran.out) {
          Some(r) -> Ok(r),
          None ->
            failed("the runtime's library describes itself in a form this `ply` does not read"),
        }
      }
    },
  }

/// `path`, an absolute one below the toolchain's cache, as the cache names it.
fn relative(path: String) -> String / {toolchain.read, abort.raise} = {
  let cache = toolchain.cache();
  if string_starts_with(path, cache ++ "/") {
    string_slice(path, string_len(cache) + 1, string_len(path))
  } else { path }
}

/// `objects` and the native `main` linked with the runtime's library into an executable: its path
/// below the cache.
fn linked(
  t: Toolchain,
  objects: Result<List<String>, String>,
  library: String,
  work: String,
) -> Result<String, List<Diag>> / {compilers.write[cc], toolchain.read, toolchain.write, abort.raise} =
  match objects {
    Err(why) -> failed(why),
    Ok(objects) -> match cc::executable[cc](
        t,
        native::main_c(),
        objects,
        concat([library], toolchain.libraries()),
        work,
      ) {
      Err(why) -> failed(why),
      Ok(exe) -> Ok(exe),
    },
  }

/// The executable at `exe` with `pack` after it.
fn packed_after(
  exe: String,
  pack: Bytes,
) -> Result<String, List<Diag>> / {toolchain.read, toolchain.write, abort.raise} =
  if toolchain.appended(relative(exe), pack) { Ok(exe) }
  else { failed("the pack could not be written after `" ++ exe ++ "`") }

/// What every native `ply` and builder carries: the shipped modules as a pack keeps them, and the
/// program's own front end.
fn packed_with(files: List<Shipping>, front: Bytes, more: List<Packed>) -> Bytes =
  native::pack(
    concat(
      push(map(files, |f: Shipping| { path: f.path, bytes: f.bytes }), {
        path: native::front_path(),
        bytes: front,
      }),
      more,
    ),
  )

// --- What a bootstrap keeps ----------------------------------------------------------------

/// What names the shipped modules `files` hold, whatever order they were read in.
fn shipped_key(files: List<Shipping>) -> Bytes =
  blake3(
    bytes_concat_all(
      map_fold(
        fold(files, map_new(), |acc: Map<String, Bytes>, f: Shipping|
          map_insert(acc, f.name, bytes_concat(sized(bytes_of_string(f.path)), blake3(f.bytes)))),
        [b"ply shipped modules 1\0"],
        |acc: List<Bytes>, name: String, held: Bytes|
          push(push(acc, sized(bytes_of_string(name))), held),
      ),
    ),
  )

/// What an executable linked here is a function of besides its objects' C: the compiler and what
/// every compile and link passes it, the `main` it is entered through, and the runtime's library,
/// `library` its digest and `libraries` what is linked after it.
fn linking_key(t: Toolchain, library: Bytes, libraries: List<String>) -> Bytes =
  blake3(
    bytes_concat_all([
      b"ply native link 1\0",
      sized(t.identity),
      sized(bytes_of_string(t.level)),
      sized(bytes_of_string(join(concat(cc::float_flags(), native::native_flags()), " "))),
      sized(native::main_c()),
      sized(library),
      sized(bytes_of_string(join(libraries, " "))),
    ]),
  )

/// How many bytes of the runtime's library one read takes: under what a read may answer at once.
fn library_range() -> Int = 16777216

/// What the file at `path` holds, as the digest of the digests of each `step` bytes of it in turn,
/// so a file larger than one read answers is still named by its bytes: none where it does not read.
fn ranged_digest(path: String, step: Int) -> Option<Bytes> / {fs.read[abs], abort.raise} =
  match fs.file_size[abs](path) {
    None -> None,
    Some(size) -> match fold(
        range(0, (size + step - 1) / step),
        Some([]),
        |held: Option<List<Bytes>>, i: Int|
          match held {
            None -> None,
            Some(digests) -> match fs.read_at[abs](path, i * step, step) {
              Some(bytes) -> Some(push(digests, blake3(bytes))),
              None -> None,
            },
          },
      ) {
      Some(digests) -> Some(blake3(bytes_concat_all(digests))),
      None -> None,
    },
  }

/// The definition a builder is a function of besides what it is made from: the one that builds it,
/// whose hash covers the front end, the emitter and how the builder's C is linked and packed. So a
/// `ply` whose own differs builds its builder itself, and a bootstrap it could not run fails here
/// and not in the checkouts a release of it would be handed.
fn builder_roots() -> List<Bytes> = [b"bootstrap.builder_built"]

/// Where the cache keeps the builder of the shipped modules `shipped` names, linked as `linking`
/// names and built by the definitions `building` identifies.
fn builder_kept(shipped: Bytes, linking: Bytes, building: Bytes) -> String / {abort.raise} = {
  let key = blake3(
    bytes_concat_all([
      b"ply builder 1\0",
      sized(builder_text()),
      sized(bytes_of_string(builder_entry())),
      shipped,
      linking,
      sized(building),
    ]),
  );
  hex_of(key) ++ ".builder"
}

/// The definition a `ply`'s pack is a function of besides what it is made from: the one that makes
/// it, whose hash covers how the shipped modules are answered, gathered and laid out.
fn pack_roots() -> List<Bytes> = [b"bootstrap.packed"]

/// Where the cache keeps the pack of the `ply` whose front end is `front` and whose C is `sources`,
/// over the shipped modules `shipped` names, linked as `linking` names, and packed by the
/// definitions `packing` identifies.
fn pack_kept(
  shipped: Bytes,
  linking: Bytes,
  front: Bytes,
  sources: List<cc::Source>,
  packing: Bytes,
) -> String / {abort.raise} = {
  let key = blake3(
    bytes_concat_all([
      b"ply pack 1\0",
      shipped,
      linking,
      blake3(front),
      sized(cc::manifest(sources)),
      sized(packing),
    ]),
  );
  hex_of(key) ++ ".pack"
}

/// The pack a `ply` carries, and how many records its shipped modules are answered in.
type Packing = { answered: Int, pack: Bytes }

/// `p` as the cache keeps it: the count, then the pack.
fn kept_of(p: Packing) -> Bytes = bytes_concat(u64_le(p.answered), p.pack)

/// What `kept_of` kept: nothing for bytes that are not a count and then a whole pack.
fn unkept(bytes: Bytes) -> Option<Packing> / {abort.raise} = {
  let size = bytes_len(bytes);
  match ((u64_at(bytes, 0), if size < 32 { None } else { u64_at(bytes, size - 24) })) {
    (Some(answered), Some(held)) -> if held == size - 32 && bytes_ends_with(bytes, b"PLYPACK1") {
      Some({ answered: answered, pack: bytes_slice(bytes, 8, size) })
    } else { None },
    _ -> None,
  }
}

// --- The builder ------------------------------------------------------------------------

/// The builder's own module: it enters the checkout's compiler, and the rest of the builder is the
/// shipped modules that reaches.
fn builder_text() -> Bytes =
  b"import compiler.build\nimport compiler.build (Builds)\nimport std.process (process)\n\npub fn main() -> Unit / {Builds, process.args[proc], process.exit[proc]} = build::main()\n"

fn builder_entry() -> String = "builder.main"

/// The builder as a load takes it: its one module, read from no directory.
fn builder_project() -> Project = {
  let text = builder_text();
  {
    files: [
      {
        path: "builder.ply",
        module: "builder",
        text: text,
        at: { label: "abs", path: "builder.ply" },
      },
    ],
    sources: [{ name: b"builder", src: text }],
    diags: [],
    manifest: None,
    packages: [],
    root_key: "",
  }
}

/// A builder below the cache, and whether it was taken as an earlier bootstrap kept it.
type Builder = { path: String, taken: Bool }

/// The builder of the checkout's shipped modules on `runtime`, at `kept` below the cache: the one an
/// earlier bootstrap kept there, or else built here and kept. A shipped module that did not move
/// since this `ply` was built is answered by what this `ply` carries.
fn builder_built(
  options: Options,
  t: Toolchain,
  runtime: Runtime,
  files: List<Shipping>,
  kept: String,
  work: String,
) -> Result<Builder, List<Diag>> / {Bootstraps, shipped.definitions, env.bodies[sys], shipped.answer, fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], entropy.next, time.now_ms, shipped.reached, abort.raise} = {
  let path = toolchain.cache() ++ "/" ++ kept;
  if toolchain.holds(kept) { Ok({ path: path, taken: true }) } else {
    let started = time.elapsed_ms();
    let t_load: Timed = over_shipping(files, ||
      timed_uncached_over([], builder_project(), started));
    match program_view(t_load.program) {
      None -> Err(t_load.program.diags),
      Some(w) -> {
        let front = front_of(t_load, w);
        let offered = every_root(front);
        let bodies = below_root(env.bodies[sys]());
        let emission = emitted(
          runtime,
          front.dump,
          map(front.files, |f: { path: String, name: String, text: Bytes }| f.text),
          offered,
          emitter_identity(shipped.definitions()),
          |k: Bytes| read_kept[abs](bodies, k),
          |k: Bytes, bytes: Bytes| write_kept[abs](bodies, k, bytes),
        );
        match ((
            held(front.dump, offered, emission),
            linked_of(front.dump, bytes_of_string(builder_entry()), len(front.files)),
          )) {
          (Err(diags), _) -> Err(diags),
          (_, None) -> failed("the builder defines no `" ++ builder_entry() ++ "` to enter"),
          (Ok(c), Some(carried)) -> match linked(
              t,
              cc::objects[cc](t, cc::split(c), native::native_flags(), work),
              options.library,
              work,
            ) {
            Err(diags) -> Err(diags),
            Ok(exe) -> match packed_after(exe, packed_with(files, shipped.front(carried), [])) {
              Err(diags) -> Err(diags),
              Ok(whole) -> if toolchain.moved(relative(whole), kept) {
                Ok({ path: path, taken: false })
              } else { failed("the builder could not be kept in the toolchain's cache") },
            },
          },
        }
      },
    }
  }
}

/// The checkout's `ply` built by `builder`: its front end, the sources of its C, which the cache
/// keeps, and what the builder said of its steps where `phases` asked it to.
fn ply_built(
  options: Options,
  builder: String,
  work: String,
  phases: Bool,
) -> Result<{ front: Bytes, sources: List<cc::Source>, said: Bytes }, List<Diag>> / {toolchain.read, toolchain.write, fs.read[abs], abort.raise} = {
  let cache = toolchain.cache();
  let front = cache ++ "/" ++ work ++ "/ply.front";
  let manifest = cache ++ "/" ++ work ++ "/ply.sources";
  let memo = cache ++ "/memo-" ++ (if options.profile == "release" { "release" } else { "debug" });
  let ran = toolchain.ran(relative(builder), [
    options.root ++ "/crates/ply-cli/ply",
    "ply.main",
    front,
    manifest,
    memo,
    "kept",
    if phases { "phases" } else { "quiet" },
  ]);
  if ran.code != 0 {
    failed("the builder did not build `ply`:\n" ++ string_of_bytes_lossy(ran.err))
  } else {
    match ((fs.read_file[abs](below_root(front)), fs.read_file[abs](below_root(manifest)))) {
      (Some(f), Some(m)) -> match cc::manifested(m) {
        Some(sources) -> Ok({ front: f, sources: sources, said: ran.err }),
        None -> failed("the builder's manifest of `ply`'s C does not read"),
      },
      _ -> failed("what the builder built could not be read back"),
    }
  }
}

/// What `ply` answers of the shipped modules, as its pack carries it: each record and output of the
/// store its `std --answers` wrote below `work`, gzipped, and the claim that they stand.
fn answers(
  ply: String,
  work: String,
) -> Result<List<Packed>, List<Diag>> / {toolchain.read, toolchain.write, fs.read[abs], abort.raise} = {
  let store = toolchain.cache() ++ "/" ++ work ++ "/answers";
  let ran = toolchain.ran(relative(ply), ["std", "--answers", store]);
  if ran.code != 0 {
    failed("the new `ply` did not answer the shipped modules:\n" ++ string_of_bytes_lossy(ran.err))
  } else {
    let gathered = fold(["records", "outputs"], [], |acc: List<Packed>, sub: String|
      match fs.list_dir[abs](below_root(store ++ "/" ++ sub)) {
        None -> acc,
        Some(names) ->
          fold(names, acc, |a: List<Packed>, n: String|
            if string_starts_with(n, ".") || string_ends_with(n, ".tmp") { a } else {
              match fs.read_file[abs](below_root(store ++ "/" ++ sub ++ "/" ++ n)) {
                Some(bytes) ->
                  push(a, { path: "answers/" ++ sub ++ "/" ++ n, bytes: bytes_gzip(bytes) }),
                None -> a,
              }
            }),
      });
    match fs.read_file[abs](below_root(store ++ "/standing")) {
      None -> failed("the new `ply` wrote no claim that its answers stand"),
      Some(claim) -> Ok(push(gathered, { path: "answers/standing", bytes: bytes_gzip(claim) })),
    }
  }
}

/// The pack the `ply` at `exe` carries: the shipped modules, its front end and what it answers of
/// them. A copy that carries only its front end answers for the one that carries the answers too.
fn packed(
  exe: String,
  files: List<Shipping>,
  front: Bytes,
  work: String,
) -> Result<Packing, List<Diag>> / {toolchain.read, toolchain.write, fs.read[abs], fs.write[abs], abort.raise} = {
  let answering = exe ++ "-answering";
  if !fs.copy[abs](below_root(exe), below_root(answering)) {
    failed("the new `ply` could not be copied to answer with")
  } else {
    match packed_after(answering, packed_with(files, front, [])) {
      Err(diags) -> Err(diags),
      Ok(_) -> match answers(answering, work) {
        Err(diags) -> Err(diags),
        Ok(answered) -> Ok({ answered: len(answered), pack: packed_with(files, front, answered) }),
      },
    }
  }
}

/// The pack of the `ply` at `exe`, at `kept` below the cache: the one an earlier bootstrap kept
/// there, or else made here and kept. `taken` is whether it was kept.
fn pack_made(
  exe: String,
  files: List<Shipping>,
  front: Bytes,
  kept: String,
  work: String,
) -> Result<{ packing: Packing, taken: Bool }, List<Diag>> / {toolchain.read, toolchain.write, fs.read[abs], fs.write[abs], abort.raise} = {
  let had = if !toolchain.holds(kept) { None }
  else { match toolchain.held(kept) { Some(bytes) -> unkept(bytes), None -> None } };
  match had {
    Some(p) -> Ok({ packing: p, taken: true }),
    None -> match packed(exe, files, front, work) {
      Err(diags) -> Err(diags),
      Ok(p) -> if toolchain.written(kept, kept_of(p)) { Ok({ packing: p, taken: false }) }
      else { failed("the pack could not be kept in the toolchain's cache") },
    },
  }
}

/// A step of a bootstrap and the milliseconds it took.
type Took = { step: String, ms: Int }

fn took(steps: List<Took>, step: String, since: Int) -> List<Took> / {time.elapsed_ms} =
  push(steps, { step: step, ms: time.elapsed_ms() - since })

/// What a bootstrap that built `ply` made: how many records its answers are, what each step took,
/// and what the builder said of its own.
type Built = { answered: Int, steps: List<Took>, said: Bytes }

fn wrote(options: Options, built: Built, phases: Bool) -> Answer =
  {
    json: object([
      { key: "command", value: Str("bootstrap") },
      { key: "ok", value: Bool(true) },
      { key: "wrote", value: Str(options.out) },
    ]),
    lines: concat(
      [
        "built `ply` from " ++ options.root ++ " under " ++ options.profile
          ++ ", its shipped modules answered in "
          ++ int_to_string(built.answered)
          ++ " records",
        "wrote " ++ options.out,
      ],
      if !phases { [] } else {
        concat(
          map(built.steps, |t: Took| "phases: " ++ t.step ++ " " ++ int_to_string(t.ms) ++ "ms"),
          filter(map(bytes_split(built.said, b"\n"), string_of_bytes_lossy), |l: String| l != ""),
        )
      },
    ),
    errs: [],
    code: ok_code(),
  }

/// The `ply` at `exe` written to `out` with its pack, every directory above `out` made: by a copy
/// beside `out` and a rename, so a process running the one there keeps its file.
fn installed(
  exe: String,
  out: String,
  pack: Bytes,
) -> Result<Unit, List<Diag>> / {fs.write[abs], entropy.next, abort.raise} = {
  let tmp = out ++ "." ++ int_to_string(entropy.next()) ++ ".tmp";
  if fs.create_dir[abs](below_root(parent(out))) && fs.copy[abs](below_root(exe), below_root(tmp))
      && fs.append[abs](below_root(tmp), pack) != None
      && fs.rename[abs](below_root(tmp), below_root(out)) { Ok(()) } else {
    let _ = fs.remove[abs](below_root(tmp));
    failed("the new `ply` could not be written to `" ++ out ++ "`")
  }
}

/// What names what every step of one bootstrap is made from: its shipped modules, and how it links.
type Keys = { shipped: Bytes, linking: Bytes }

/// The checkout's `ply` built below `work`, each step timed into `steps`.
fn bootstrapped(
  options: Options,
  t: Toolchain,
  files: List<Shipping>,
  work: String,
  phases: Bool,
) -> Result<Built, List<Diag>> / {Bootstraps, shipped.definitions, env.bodies[sys], shipped.answer, fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], entropy.next, time.now_ms, shipped.reached, abort.raise} = {
  let started = time.elapsed_ms();
  match described(t, options.library, work) {
    Err(diags) -> Err(diags),
    Ok(runtime) -> match ranged_digest(below_root(options.library), library_range()) {
      None -> failed("the runtime's library at `" ++ options.library ++ "` could not be read"),
      Some(library) -> {
        let keys = {
          shipped: shipped_key(files),
          linking: linking_key(t, library, toolchain.libraries()),
        };
        let steps = took([], "described the runtime", started);
        let at = time.elapsed_ms();
        match builder_built(
            options,
            t,
            runtime,
            files,
            builder_kept(
              keys.shipped,
              keys.linking,
              identity_of(shipped.definitions(), builder_roots()),
            ),
            work,
          ) {
          Err(diags) -> Err(diags),
          Ok(builder) -> {
            let steps = took(
              steps,
              if builder.taken { "took the kept builder" } else { "built the builder" },
              at,
            );
            let at = time.elapsed_ms();
            match ply_built(options, builder.path, work, phases) {
              Err(diags) -> Err(diags),
              Ok(made) -> {
                let steps = took(steps, "built `ply`", at);
                let at = time.elapsed_ms();
                match linked(
                    t,
                    cc::objects_kept[cc](t, made.sources, native::native_flags(), work),
                    options.library,
                    work,
                  ) {
                  Err(diags) -> Err(diags),
                  Ok(exe) ->
                    finished(
                      options,
                      files,
                      keys,
                      made,
                      exe,
                      work,
                      took(steps, "compiled and linked `ply`", at),
                    ),
                }
              },
            }
          },
        }
      },
    },
  }
}

/// The `ply` linked at `exe` written where it goes with its pack, the last steps timed after `steps`.
fn finished(
  options: Options,
  files: List<Shipping>,
  keys: Keys,
  made: { front: Bytes, sources: List<cc::Source>, said: Bytes },
  exe: String,
  work: String,
  steps: List<Took>,
) -> Result<Built, List<Diag>> / {toolchain.read, toolchain.write, fs.read[abs], fs.write[abs], shipped.definitions, time.elapsed_ms, entropy.next, abort.raise} = {
  let at = time.elapsed_ms();
  let kept = pack_kept(
    keys.shipped,
    keys.linking,
    made.front,
    made.sources,
    identity_of(shipped.definitions(), pack_roots()),
  );
  match pack_made(exe, files, made.front, kept, work) {
    Err(diags) -> Err(diags),
    Ok(p) -> {
      let steps = took(
        steps,
        if p.taken { "took the kept pack" } else { "answered the shipped modules" },
        at,
      );
      let at = time.elapsed_ms();
      match installed(exe, options.out, p.packing.pack) {
        Err(diags) -> Err(diags),
        Ok(_) ->
          Ok({
            answered: p.packing.answered,
            steps: took(steps, "packed and wrote `ply`", at),
            said: made.said,
          }),
      }
    },
  }
}

pub fn run(
  flags: Flags,
) -> Answer / {Bootstraps, compilers.read[cc], env.pwd[sys], env.var[sys], shipped.definitions, env.bodies[sys], shipped.answer, fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], entropy.next, time.now_ms, shipped.reached, abort.raise} = {
  let s = style_of(flags);
  let options = options_of(flags);
  let files = shipping(options.root);
  let phases = env.var[sys]("PLY_C_PHASES") != None;
  let built = match ((toolchain_for(options.profile), toolchain.scratch())) {
    (Err(diags), _) -> Err(diags),
    (_, None) -> failed("the toolchain's cache has no room to build in"),
    (Ok(t), Some(work)) -> {
      let result = bootstrapped(options, t, files, work, phases);
      toolchain.cleared(work);
      result
    },
  };
  match built {
    Err(diags) -> reported(s, "bootstrap", diags, []),
    Ok(b) -> wrote(options, b, phases),
  }
}

// A path outside the working directory is spelled under `abs` without its leading `/`.
test "a checkout named outside the working directory is the path it names" {
  let elsewhere = {
    label: "abs",
    spelling: "src/ply",
    display: "/src/ply",
    inside: ".",
    absolute: "/src/ply",
    machine: "/src/ply",
  };
  let options = handle {
    options_of({ ..no_flags(), paths: [elsewhere] })
  } with {
    env.pwd[sys]() -> "/home/me",
  };
  assert_eq(options.root, "/src/ply");
  assert_eq(options.library, "/src/ply/target/debug/libply_native.a");
  assert_eq(options.out, "/src/ply/target/debug/ply")
}

// The CI's first bootstrap writes below `target/stage1`, which no build made before it.
test "a ply installed below a directory not yet made is written there" {
  let ran = fs::on_mem[abs](fs::mem_of([{ path: "work/exe", body: b"code" }]), ||
    handle { installed("/work/exe", "/out/stage1/ply", b"pack") } with { entropy.next() -> 7 });
  assert_eq(ran.value, Ok(()));
  assert_eq(fs::mem_read(ran.tree, "out/stage1/ply"), Some(b"codepack"));
  assert_eq(fs::mem_list(ran.tree, "out/stage1"), Some(["ply"]))
}

fn two_shipped() -> List<Shipping> =
  [
    { name: "std.a.ply", path: "pack/a.ply", bytes: b"pub fn a() -> Int = 1\n" },
    { name: "std/a/data.txt", path: "pack/a/data.txt", bytes: b"data" },
  ]

test "the shipped modules' key moves with a module's bytes and its name, and not with their order" {
  let files = two_shipped();
  let key = shipped_key(files);
  assert_eq(shipped_key([at(files, 1), at(files, 0)]), key);
  assert(shipped_key([{ ..at(files, 0), bytes: b"pub fn a() -> Int = 2\n" }, at(files, 1)]) != key);
  assert(shipped_key([{ ..at(files, 0), name: "std.b.ply" }, at(files, 1)]) != key);
  assert(shipped_key([at(files, 0)]) != key)
}

test "a link's key moves with the compiler, its level, the library and what is linked after it" {
  let t = { identity: b"cc 1", support: [], level: "-O2" };
  let key = linking_key(t, b"library", ["-lm"]);
  assert_eq(linking_key(t, b"library", ["-lm"]), key);
  assert(linking_key({ ..t, identity: b"cc 2" }, b"library", ["-lm"]) != key);
  assert(linking_key({ ..t, level: "-O0" }, b"library", ["-lm"]) != key);
  assert(linking_key(t, b"another", ["-lm"]) != key);
  assert(linking_key(t, b"library", ["-lm", "-ldl"]) != key)
}

// A development build's library is larger than one read answers.
test "a file's digest is of its ranges' digests, however many reads it takes" {
  let tree = fs::mem_of([{ path: "lib/a", body: b"0123456789" }]);
  let over = |path: String, step: Int| fs::on_mem[abs](tree, || ranged_digest(path, step)).value;
  assert_eq(
    over("lib/a", 4),
    Some(blake3(bytes_concat_all([blake3(b"0123"), blake3(b"4567"), blake3(b"89")]))),
  );
  assert_eq(over("lib/a", 16), Some(blake3(blake3(b"0123456789"))));
  assert_eq(over("lib/absent", 4), None)
}

test "a builder is kept under its shipped modules, its link and the definitions that build it" {
  let kept = builder_kept(b"shipped", b"linking", b"building");
  assert(string_ends_with(kept, ".builder"));
  assert_eq(builder_kept(b"shipped", b"linking", b"building"), kept);
  assert(builder_kept(b"moved", b"linking", b"building") != kept);
  assert(builder_kept(b"shipped", b"moved", b"building") != kept);
  assert(builder_kept(b"shipped", b"linking", b"moved") != kept)
}

test "a pack is kept under its program's front end and C, and the definitions that pack it" {
  let sources = [{ label: "0a", digest: "d1" }];
  let kept = pack_kept(b"shipped", b"linking", b"front", sources, b"packing");
  assert_eq(pack_kept(b"shipped", b"linking", b"front", sources, b"packing"), kept);
  assert(pack_kept(b"shipped", b"linking", b"moved", sources, b"packing") != kept);
  assert(
    pack_kept(b"shipped", b"linking", b"front", [{ label: "0a", digest: "d2" }], b"packing")
      != kept,
  );
  assert(pack_kept(b"shipped", b"linking", b"front", sources, b"moved") != kept);
  assert(pack_kept(b"moved", b"linking", b"front", sources, b"packing") != kept)
}

test "a kept pack reads back with its count, and bytes that are not a whole pack read as none" {
  let p = { answered: 3, pack: packed_with(two_shipped(), b"front", []) };
  let kept = kept_of(p);
  assert_eq(unkept(kept), Some(p));
  assert_eq(unkept(bytes_slice(kept, 0, bytes_len(kept) - 1)), None);
  assert_eq(unkept(bytes_concat(kept, b"x")), None);
  assert_eq(unkept(b"short"), None)
}

test "files are the ones this ply carries where each reads as it carries it and none is left out" {
  let files = two_shipped();
  let module = at(files, 0).bytes;
  let own = |held: List<{ path: String, body: Bytes }>|
    fs::on_mem[shipped](fs::mem_of(held), || carried(files)).value;
  let data = { path: "std/a/data.txt", body: b"data" };
  assert(own([{ path: "std.a.ply", body: module }, data]));
  assert(!own([{ path: "std.a.ply", body: b"moved" }, data]));
  assert(!own([{ path: "std.a.ply", body: module }, { path: "std.b.ply", body: b"" }, data]));
  assert(!own([{ path: "std.a.ply", body: module }]))
}
