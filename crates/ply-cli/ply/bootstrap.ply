// `ply bootstrap` — the front end written out as the bundle the runtime builds it from: the C
// gzipped as `unit.c.gz`, beside the `SOURCES.digest` of the modules it came from. Producing
// that C, hashing it and landing the two files is the emitter's work, which is the host's side
// of this command; what `--verify` makes of it and what either run says are here.

import args (Flags, style_of)
import diagnostic (Place)
import program (outside)
import report (Answer, ok_code, compile_error, refused, reported)
import style (Style, plain)
import compiler.resolve (Diag, diag1)
import std.json (Json, Str, Bool, Number, Array, object)

// The emission. `emitted` has already run when the program performs it, so what comes back is
// what was done: the bundle is on disk beside whatever `--verify` read back from it.
pub nondet effect archive {
  write emitted[r](options: Options) -> Result<Emitted, Refusal>
}

// What `ply bootstrap` is configured with, as the program parses it.
pub type Options = { path: String, out: String, verify: Bool, profile: String }

// Why nothing was emitted. `compilation` is a program that did not check, which is the user's to
// fix and is tallied as such.
pub type Refusal = { diags: List<Diag>, places: List<Place>, compilation: Bool }

// The two digests an archive is described by: over the sources it came from, and over the
// gzipped C it holds.
pub type Described = { source: String, artifact: String }

pub type Emitted = {
  // Over the module texts, sorted: the version the archive is of, which `SOURCES.digest` holds.
  source: String,
  // Over `unit.c.gz`, which is what `--verify` checks.
  artifact: String,
  definitions: Int,
  refusals: Int,
  bytes: Int,
  // Where the bundle lives, whether or not one is there.
  at: String,
  // The bundle on disk as `--verify` read it; `None` when there is none, and on a run that wrote.
  recorded: Option<Described>,
}

fn described(e: Emitted) -> Json =
  object([{ key: "source", value: Str(e.source) }, { key: "artifact", value: Str(e.artifact) }])

fn described_json(d: Described) -> Json =
  object([{ key: "source", value: Str(d.source) }, { key: "artifact", value: Str(d.artifact) }])

// --- Refusals -----------------------------------------------------------------

fn nowhere(message: String, label: Bytes) -> Diag =
  diag1(b"E0502", outside(), { start: 0, end: 0 }, bytes_of_string(message), label, [])

fn no_archive(at: String) -> Diag =
  nowhere("no archive at " ++ at, b"`--verify` compares against an archive already written")

fn stopped(s: Style, why: Refusal) -> Answer =
  if why.compilation { refused(s, "bootstrap", why.diags, why.places) }
  else { reported(s, "bootstrap", why.diags, why.places) }

fn refusing(s: Style, d: Diag) -> Answer =
  stopped(s, { diags: [d], places: [], compilation: false })

// --- `--verify` -------------------------------------------------------------------

fn agrees(e: Emitted) -> Answer =
  {
    json: object([
      { key: "command", value: Str("bootstrap") },
      { key: "ok", value: Bool(true) },
      { key: "exit_code", value: Number(decimal_of_int(ok_code())) },
      { key: "verified", value: described(e) },
    ]),
    lines: ["the archive describes this tree: " ++ e.source],
    errs: [],
    code: ok_code(),
  }

fn differs(e: Emitted, recorded: Described) -> Answer =
  {
    json: object([
      { key: "command", value: Str("bootstrap") },
      { key: "ok", value: Bool(false) },
      { key: "exit_code", value: Number(decimal_of_int(compile_error())) },
      { key: "recorded", value: described_json(recorded) },
      { key: "emitted", value: described(e) },
    ]),
    lines: [],
    errs: [
      "the archive does not describe this tree:",
      "  recorded " ++ recorded.source ++ " " ++ recorded.artifact,
      "  emitted  " ++ e.source ++ " " ++ e.artifact,
    ],
    code: compile_error(),
  }

fn verified(s: Style, e: Emitted) -> Answer =
  match e.recorded {
    None -> refusing(s, no_archive(e.at)),
    Some(d) -> if d.source == e.source && d.artifact == e.artifact { agrees(e) }
    else { differs(e, d) },
  }

// --- The archive a run writes -------------------------------------------------------

pub fn wrote(e: Emitted) -> Answer =
  {
    json: object([
      { key: "command", value: Str("bootstrap") },
      { key: "ok", value: Bool(true) },
      { key: "exit_code", value: Number(decimal_of_int(ok_code())) },
      { key: "wrote", value: Str(e.at) },
      { key: "archive", value: described(e) },
    ]),
    lines: [
      int_to_string(e.definitions) ++ " definitions, " ++ int_to_string(e.refusals) ++ " refused, "
        ++ int_to_string(e.bytes)
        ++ " bytes of C",
      "source   " ++ e.source,
      "artifact " ++ e.artifact,
      "wrote    " ++ e.at,
    ],
    errs: [],
    code: ok_code(),
  }

pub fn run(flags: Flags) -> Answer / {archive.emitted[bootstrap]} = {
  let s = style_of(flags);
  match archive.emitted[bootstrap](options_of(flags)) {
    Err(why) -> stopped(s, why),
    Ok(e) -> if flags.action == "verify" { verified(s, e) } else { wrote(e) },
  }
}

// The options the archive is written under, from the parsed line.
fn options_of(flags: Flags) -> Options =
  {
    path: match list_at(flags.paths, 0) { Some(r) -> r.machine, None -> "." },
    out: match flags.out { Some(o) -> o, None -> "bootstrap" },
    verify: flags.action == "verify",
    profile: match flags.profile { Some(p) -> p, None -> "release" },
  }

// --- Tests ------------------------------------------------------------------

fn an_archive() -> Emitted =
  {
    source: "1a2b",
    artifact: "3c4d",
    definitions: 12,
    refusals: 0,
    bytes: 4096,
    at: "bootstrap",
    recorded: None,
  }

test "a run that wrote the archive reports both digests and where it landed" {
  let answer = wrote(an_archive());
  assert_eq(answer.code, 0);
  assert_eq(answer.lines, [
    "12 definitions, 0 refused, 4096 bytes of C",
    "source   1a2b",
    "artifact 3c4d",
    "wrote    bootstrap",
  ])
}

test "`--verify` takes an archive that says what this tree emits, and refuses one that does not" {
  let s = plain();
  let same = verified(s, { ..an_archive(), recorded: Some({ source: "1a2b", artifact: "3c4d" }) });
  assert_eq(same.code, 0);
  assert_eq(same.lines, ["the archive describes this tree: 1a2b"]);
  let moved = verified(s, { ..an_archive(), recorded: Some({ source: "ffff", artifact: "3c4d" }) });
  assert_eq(moved.code, 2);
  assert_eq(list_at(moved.errs, 0), Some("the archive does not describe this tree:"))
}

test "`--verify` with no archive to compare against says where it looked" {
  let answer = verified(plain(), an_archive());
  assert_eq(answer.code, 2);
  assert(answer.errs != [])
}
