// `ply build` — a deployable artifact, or what a build changes against a deployed one. The front
// end is this program's own load, handed to the Rust side; the emitter is the Rust side's: a
// compiled unit is not a value a program can hold. Everything below decides which entry is built,
// what the container carries, where it lands, and what both forms say. The container itself is
// `compiler.plyx`, which owns the magic, the header and the section table.

import args (Flags, no_flags, style_of)
import builder (Compiled, Loaded, Made, Named, Previous, Reach, Refusal)
import builder (builder)
import cache (Front)
import config_schema
import lock
import paths (Resolved, Rooted, displayed, here, write_file)
import paths
import compiler.diag (parse_all)
import compiler.infer (DefInfo)
import compiler.plyx (Head, digest_of, digest_text, domain, encode, encode_named, format,
                      library_domain, library_magic, off_digest)
import compiler.resolve (Diag, Label, diag, diag1)
import compiler.tycore (TyFn)
import diagnostic (Place, all_to_json, all_to_text)
import entry (At, Main, Module, entry_point, marked, no_module, nowhere)
import env (env)
import sources (File)
import program (Program, Timed, front_of, is_shipped, no_front, timed_uncached)
import plyz
import report (Answer, ind, ok_code, count_of, plural, refused, reported, warning_lines)
import std.fs (fs, Missing)
import std.time (time)
import std.list (sort_by)
import std.json (Json, Null, Str, Bool, Number, Array, object, to_string)
import std.pkg (Manifest, render_version)
import compiler.front (Whole, Analysed, Refused, analyse)
import style (Style, plain, bold, green, red)
import semantics
import signing (Provenance, head_commit, provenance_bytes, provenance_of, seed_of, signatures_path,
                unkeyed)
import std.signed
import std.signed (Signature, countersigned, signed_bytes, signed_of)
import std.bytes (hex_of)

// The container with its digest written into the field no range of the digest covers: `digest`
// is the short form a report prints, and `full` the digest itself.
pub type Sealed = { bytes: Bytes, digest: String, full: Bytes }

// The digest is `compiler.plyx`'s, which says the domain, the field and the ranges; sealing is that
// digest and a splice, so the program does it itself.
fn seal(container: Bytes) -> Result<Sealed, Refusal> / {abort.raise} =
  sealed_at(container, domain())

// A library's container is the same file under a domain of its own: a library digest is never read
// as a program digest, and the ranges `compiler.plyx` covers are the same ones.
fn sealed_at(container: Bytes, into: Bytes) -> Result<Sealed, Refusal> / {abort.raise} =
  match digest_of(into, container) {
    None ->
      Err({
        diags: [
          diag(
            b"E0443",
            bytes_of_string(
              "a container of " ++ int_to_string(bytes_len(container))
                ++ " bytes is no container at all",
            ),
            [],
            [],
          ),
        ],
        places: [],
      }),
    Some(d) -> {
      let at = off_digest();
      Ok({
        bytes: bytes_concat_all([
          bytes_slice(container, 0, at),
          d,
          bytes_slice(container, at + 32, bytes_len(container)),
        ]),
        digest: string_slice(digest_text(d), 0, 15),
        full: d,
      })
    },
  }

// --- Small things -----------------------------------------------------------

// The build's root is the line's first positional's absolute form, or the working directory.
fn root_of(flags: Flags) -> String =
  match list_at(flags.paths, 0) { Some(r) -> r.machine, None -> "." }

fn at<a>(xs: List<a>, i: Int, spare: a) -> a = match list_at(xs, i) { Some(x) -> x, None -> spare }

fn appended<a>(head: List<a>, tail: List<a>) -> List<a> =
  fold(tail, head, |acc: List<a>, x: a| push(acc, x))

fn repeated(text: String, n: Int) -> String =
  fold(range(0, n), "", |acc: String, i: Int| acc ++ text)

fn joined(parts: List<String>, sep: String) -> String =
  fold(range(0, len(parts)), "", |acc: String, i: Int|
    if i == 0 { at(parts, i, "") } else { acc ++ sep ++ at(parts, i, "") })

fn padded(text: String, width: Int) -> String =
  if string_len(text) >= width { text } else { text ++ repeated(" ", width - string_len(text)) }

fn num(n: Int) -> Json = Number(decimal_of_int(n))

fn opt_num(v: Option<Int>) -> Json = match v { Some(n) -> num(n), None -> Null }

fn strings(xs: List<String>) -> Json = Array(map(xs, |x: String| Str(x)))

fn holds(names: List<String>, wanted: String) -> Bool =
  len(filter(names, |x: String| x == wanted)) > 0

// --- Sizes and lists a person reads -----------------------------------------

fn pow1024(k: Int) -> Int = fold(range(0, k), 1, |acc: Int, i: Int| acc * 1024)

fn units() -> List<String> = ["B", "KB", "MB"]

// The largest unit `n` fills; megabytes is the last one this report names.
fn unit_of(n: Int) -> Int =
  fold(range(1, 3), 0, |acc: Int, k: Int| if n >= pow1024(k) { k } else { acc })

fn one_decimal(tenths: Int) -> String =
  int_to_string(tenths / 10) ++ "." ++ int_to_string(tenths % 10)

// Bytes exactly, and one decimal of the largest unit above that.
fn human(n: Int) -> String / {abort.raise} = {
  let unit = unit_of(n);
  let divisor = pow1024(unit);
  if unit == 0 { int_to_string(n) ++ " B" }
  else { one_decimal((n * 10 + divisor / 2) / divisor) ++ " " ++ at(units(), unit, "B") }
}

fn shown() -> Int = 8

// The first eight names, and a count of the rest: a diff of a whole program is not a listing.
fn listed(all: List<String>) -> String = {
  let n = len(all);
  let kept = if n < shown() { n } else { shown() };
  let head = joined(map(range(0, kept), |i: Int| at(all, i, "")), ", ");
  if n <= shown() { head } else { head ++ ", and " ++ int_to_string(n - shown()) ++ " more" }
}

// `desk.run` becomes `desk.plyx`: the module is what a deployment thinks it ships.
fn default_output(entry: String) -> String / {abort.raise} = {
  let parts = string_split(entry, ".");
  if len(parts) < 2 { entry ++ ".plyx" } else { at(parts, len(parts) - 2, entry) ++ ".plyx" }
}

// --- Which entry is built ---------------------------------------------------

// One definition `--entry` may name.
pub type Def = { name: String, simple: String, module: String, at: At, arity: Int }

fn def_of(d: DefInfo) -> Def =
  {
    name: string_of_bytes_lossy(d.name),
    simple: string_of_bytes_lossy(d.simple_name),
    module: string_of_bytes_lossy(d.module),
    at: { module: d.at.module, start: d.at.span.start, end: d.at.span.end },
    arity: match d.scheme.ty { TyFn(f) -> len(f.params), _ -> 0 },
  }

// The program's own definitions, a shipped module's left out, in the order its files were read and
// then as written.
pub fn defs_of(w: Whole) -> List<Def> =
  sort_by(
    map(filter(w.checked.defs, |d: DefInfo| !is_shipped(string_of_bytes_lossy(d.module))), def_of),
    |a: Def, b: Def|
      a.at.module < b.at.module || (a.at.module == b.at.module && a.at.start <= b.at.start),
  )

fn matching(defs: List<Def>, named: String) -> List<Def> =
  filter(defs, |d: Def| d.name == named || d.simple == named)

fn declarations(ds: List<Def>) -> List<Label> =
  fold(ds, [], |acc: List<Label>, d: Def|
    push(
      acc,
      marked(d.at, len(acc) == 0, bytes_of_string("`" ++ d.module ++ "` declares it here")),
    ))

fn ambiguous(named: String, ds: List<Def>) -> Diag / {abort.raise} =
  diag(
    b"E0112",
    bytes_of_string(count_of(len(ds), "definition") ++ " are named `" ++ named ++ "`"),
    declarations(ds),
    [b"name it in full, as `<module>.<name>`"],
  )

// An artifact runs by calling its entry point with nothing.
fn entry_arity(d: Def) -> Diag / {abort.raise} =
  diag(
    b"E0201",
    bytes_of_string(
      "`" ++ d.name ++ "` takes " ++ count_of(d.arity, "argument")
        ++ ", and a deployed artifact is started with none",
    ),
    [marked(d.at, true, b"this cannot be an entry point")],
    [b"wrap it in a nullary function and name that instead"],
  )

fn no_entry(named: String) -> Diag =
  diag1(
    b"E0101",
    no_module(),
    { start: 0, end: 0 },
    bytes_of_string("no definition named `" ++ named ++ "`"),
    b"there is nothing to build a closure from",
    [b"`--entry` takes a program-wide name (`app.serve`) or a simple one"],
  )

fn entry_named(defs: List<Def>, named: String) -> Result<String, Diag> / {abort.raise} = {
  let hits = matching(defs, named);
  match hits {
    [] -> Err(no_entry(named)),
    [only, ..rest] -> if len(rest) > 0 { Err(ambiguous(named, hits)) }
    else if only.arity > 0 { Err(entry_arity(only)) }
    else { Ok(only.name) },
  }
}

fn entry_of(p: Loaded, defs: List<Def>, flags: Flags) -> Result<String, Diag> / {abort.raise} =
  match flags.entry {
    None -> match entry_point(p.mains, p.modules) { Ok(m) -> Ok(m.name), Err(d) -> Err(d) },
    Some(named) -> entry_named(defs, named),
  }

// The schema shipped at build time is what lets the deployed artifact be run with the same flag,
// so the flag is resolved as a run resolves it.
fn startup_of(w: Whole, flags: Flags) -> Result<List<String>, Diag> / {abort.raise} =
  match flags.config_schema {
    None -> Ok([]),
    Some(named) -> match config_schema::resolved(w, named) {
      Err(d) -> Err(d),
      Ok(name) -> Ok([name]),
    },
  }

// --- What a build changes ---------------------------------------------------

pub type Diff = {
  added: List<String>,
  changed: List<String>,
  dropped: List<String>,
  unchanged: Int,
  reached: List<String>,
}

fn name_at(ns: List<Named>, i: Int) -> String =
  match list_at(ns, i) { Some(n) -> n.name, None -> "" }

// The names are sorted and carry no pair twice, so one run of them is one name.
fn distinct(ns: List<Named>) -> List<String> =
  fold(range(0, len(ns)), [], |acc: List<String>, i: Int|
    if i > 0 && name_at(ns, i - 1) == name_at(ns, i) { acc } else { push(acc, name_at(ns, i)) })

fn hashes_of(ns: List<Named>, wanted: String) -> List<String> =
  map(filter(ns, |n: Named| n.name == wanted), |n: Named| n.hash)

fn compared(before: List<Named>, after: List<Named>, reaches: List<Reach>) -> Diff = {
  let was = distinct(before);
  let now = distinct(after);
  let added = filter(now, |nm: String| !holds(was, nm));
  let kept = filter(now, |nm: String| holds(was, nm));
  let changed = filter(kept, |nm: String| hashes_of(after, nm) != hashes_of(before, nm));
  let moved = appended(added, changed);
  {
    added: added,
    changed: changed,
    dropped: filter(was, |nm: String| !holds(now, nm)),
    unchanged: len(kept) - len(changed),
    // A definition reaches itself, so a changed one is always among these.
    reached: map(
      filter(reaches, |r: Reach| len(filter(r.reaches, |n: String| holds(moved, n))) > 0),
      |r: Reach| r.name,
    ),
  }
}

fn row(label: String, ns: List<String>) -> String / {abort.raise} = {
  let head = ind() ++ padded(label, 11) ++ count_of(len(ns), "definition");
  if len(ns) == 0 { head } else { head ++ "   " ++ listed(ns) }
}

fn diff_lines(
  s: Style,
  entry: String,
  was: String,
  now: String,
  d: Diff,
  warnings: List<Diag>,
) -> List<String> / {abort.raise} = {
  let head = appended(warning_lines(s, warnings), [
    ind() ++ bold(s, entry) ++ " " ++ was ++ " → " ++ now,
    "",
  ]);
  let rows = appended(head, [
    row(green(s, "added"), d.added),
    row(bold(s, "changed"), d.changed),
    row(red(s, "dropped"), d.dropped),
    ind() ++ padded("unchanged", 11) ++ count_of(d.unchanged, "definition"),
  ]);
  if len(d.reached) == 0 { rows } else {
    appended(rows, [
      "",
      ind() ++ "reached by a changed definition: " ++ count_of(len(d.reached), "definition"),
      ind() ++ "  " ++ listed(d.reached),
    ])
  }
}

fn diff_json(
  entry: String,
  against: String,
  was: String,
  now: String,
  d: Diff,
  bytes: Int,
  binary: Option<Int>,
  warnings: List<Diag>,
) -> Json / {abort.raise} =
  object([
    { key: "command", value: Str("build") },
    { key: "ok", value: Bool(true) },
    { key: "exit_code", value: num(ok_code()) },
    { key: "entry", value: Str(entry) },
    { key: "against", value: Str(against) },
    { key: "was", value: Str(was) },
    { key: "now", value: Str(now) },
    { key: "added", value: strings(d.added) },
    { key: "changed", value: strings(d.changed) },
    { key: "dropped", value: strings(d.dropped) },
    { key: "unchanged", value: num(d.unchanged) },
    { key: "reached", value: strings(d.reached) },
    { key: "artifact_bytes", value: num(bytes) },
    { key: "binary_bytes", value: opt_num(binary) },
    { key: "diagnostics", value: all_to_json(warnings, []) },
  ])

// --- What a build says ------------------------------------------------------

fn binary_line(s: Style, p: Loaded) -> String / {abort.raise} =
  match p.binary_bytes {
    Some(n) -> ind() ++ bold(s, "binary") ++ " ply " ++ p.version ++ " · " ++ human(n),
    None -> ind() ++ bold(s, "binary") ++ " ply " ++ p.version ++ " · size unavailable",
  }

// Printed even when empty: without a schema an artifact cannot refuse a missing credential.
fn startup_line(s: Style, roots: List<String>) -> String / {abort.raise} =
  if len(roots) == 0 {
    ind() ++ bold(s, "startup") ++ " none — this artifact cannot be run with `--config-schema`"
  } else { ind() ++ bold(s, "startup") ++ " " ++ joined(roots, " · ") }

fn built_lines(
  s: Style,
  p: Loaded,
  m: Made,
  x: Sealed,
  out: String,
) -> List<String> / {abort.raise} =
  [
    ind() ++ green(s, "built") ++ " " ++ m.entry ++ " · " ++ x.digest,
    ind() ++ bold(s, "artifact") ++ " " ++ int_to_string(m.definitions) ++ " "
      ++ plural(m.definitions, "definition")
      ++ " · "
      ++ human(bytes_len(x.bytes))
      ++ " · "
      ++ out,
    binary_line(s, p),
    startup_line(s, m.startup),
  ]

fn built_json(
  p: Loaded,
  m: Made,
  x: Sealed,
  out: String,
  signer: Option<String>,
) -> Json / {abort.raise} =
  object([
    { key: "command", value: Str("build") },
    { key: "ok", value: Bool(true) },
    { key: "exit_code", value: num(ok_code()) },
    { key: "root", value: Str(p.root) },
    { key: "entry", value: Str(m.entry) },
    { key: "entry_hash", value: Str(m.entry_hash) },
    { key: "startup", value: strings(m.startup) },
    { key: "artifact", value: Str(out) },
    { key: "digest", value: Str(x.digest) },
    { key: "format", value: num(format()) },
    { key: "definitions", value: num(m.definitions) },
    { key: "names", value: num(len(m.names)) },
    { key: "unit", value: Bool(m.unit) },
    { key: "artifact_bytes", value: num(bytes_len(x.bytes)) },
    { key: "binary_bytes", value: opt_num(p.binary_bytes) },
    { key: "signed_by", value: signer_json(signer) },
    { key: "diagnostics", value: all_to_json(m.warnings, p.places) },
  ])

// `--digest` is the one line a deployment pins: not the report, and no file.
fn digest_json(m: Made, x: Sealed) -> Json =
  object([
    { key: "command", value: Str("build") },
    { key: "ok", value: Bool(true) },
    { key: "exit_code", value: num(ok_code()) },
    { key: "entry", value: Str(m.entry) },
    { key: "digest", value: Str(x.digest) },
  ])

// --- Signing and verifying what a build writes ---------------------------------------
// A signature is detached, in `<artifact>.sig`: the artifact's digest is the same whoever signs it,
// and a second signer of the same build adds a signature beside the first.

fn signing_key(
  flags: Flags,
) -> Result<Option<Bytes>, Diag> / {fs.read_file[cwd], fs.read_file[abs], abort.raise} =
  match flags.sign {
    None -> Ok(None),
    Some(path) -> match paths::read_file(paths::spelled(path)) {
      None -> Err(unkeyed(path, "cannot be read")),
      Some(b) -> match seed_of(string_of_bytes_lossy(b)) {
        Ok(seed) -> Ok(Some(seed)),
        Err(why) -> Err(unkeyed(path, "does not hold a secret key: " ++ why)),
      },
    },
  }

fn built_provenance(
  flags: Flags,
  p: Loaded,
  kind: String,
  name: String,
  x: Sealed,
) -> Provenance / {fs.kind[abs], fs.read_file[abs], abort.raise} =
  {
    kind: kind,
    name: name,
    digest: digest_text(x.full),
    builder: "ply " ++ p.version,
    semantics: semantics::version(),
    commit: head_commit(resolved_root(flags).absolute),
  }

// The signatures beside `out` with this key's among them: kept while they vouch for this build,
// started again when they vouch for another.
fn signed(
  seed: Option<Bytes>,
  out: String,
  what: Provenance,
) -> Result<Option<String>, Diag> / {fs.read_file[cwd], fs.read_file[abs], fs.write_file[cwd], fs.write_file[abs], abort.raise} =
  match seed {
    None -> Ok(None),
    Some(key) -> {
      let at = paths::spelled(signatures_path(out));
      let payload = provenance_bytes(what);
      let held = match paths::read_file(at) {
        None -> None,
        Some(b) -> match signed_of(b) {
          Some(x) -> if x.payload == payload { Some(x) } else { None },
          None -> None,
        },
      };
      let next = countersigned(
        match held { Some(x) -> x, None -> { payload: payload, signatures: [] } },
        key,
      );
      if write_file(at, signed_bytes(next)) {
        Ok(
          Some(
            hex_of(match list_at(next.signatures, len(next.signatures) - 1) {
              Some(g) -> g.signer,
              None -> b"",
            }),
          ),
        )
      } else { Err(unstored(signatures_path(out))) }
    },
  }

fn signer_json(signer: Option<String>) -> Json = match signer { Some(h) -> Str(h), None -> Null }

fn signer_lines(s: Style, signer: Option<String>) -> List<String> / {abort.raise} =
  match signer { Some(h) -> [ind() ++ bold(s, "signed") ++ " " ++ h], None -> [] }

fn unverified(path: String, why: String) -> Diag =
  diag1(
    b"E0461",
    no_module(),
    { start: 0, end: 0 },
    bytes_of_string("`" ++ path ++ "` " ++ why),
    b"not what these sources build",
    [b"`ply build --verify` builds in memory and writes nothing; `ply build` writes what it built"],
  )

// `--verify`: the file `out` holds, held to what these sources build, and every signature beside
// it to the build it says it vouches for.
fn verified(
  s: Style,
  p: Loaded,
  out: String,
  x: Sealed,
  into: Bytes,
) -> Answer / {fs.read_file[cwd], fs.read_file[abs], abort.raise} =
  match paths::read_file(paths::spelled(out)) {
    None -> reported(s, "build", [unverified(out, "cannot be read")], p.places),
    Some(held) -> if held != x.bytes {
      let sealed = match digest_of(into, held) { Some(d) -> digest_text(d), None -> "no digest" };
      reported(
        s,
        "build",
        [
          unverified(
            out,
            "seals " ++ sealed ++ ", and these sources build " ++ digest_text(x.full),
          ),
        ],
        p.places,
      )
    } else {
      let sig = signatures_path(out);
      match paths::read_file(paths::spelled(sig)) {
        None -> verified_answer(s, out, x, [], None),
        Some(b) -> match signed_of(b) {
          None -> reported(s, "build", [unverified(sig, "does not read as signatures")], p.places),
          Some(g) -> match provenance_of(g.payload) {
            None ->
              reported(s, "build", [unverified(sig, "says nothing a build vouches for")], p.places),
            Some(what) -> if what.digest != digest_text(x.full) {
              reported(s, "build", [unverified(sig, "vouches for " ++ what.digest)], p.places)
            } else {
              match filter(g.signatures, |one: Signature| !signed::holds(one, g.payload)) {
                [] ->
                  verified_answer(
                    s,
                    out,
                    x,
                    map(g.signatures, |one: Signature| hex_of(one.signer)),
                    Some(what),
                  ),
                [bad, ..] ->
                  reported(
                    s,
                    "build",
                    [
                      unverified(
                        sig,
                        "holds a signature by " ++ hex_of(bad.signer) ++ " that does not verify",
                      ),
                    ],
                    p.places,
                  ),
              }
            },
          },
        },
      }
    },
  }

fn verified_answer(
  s: Style,
  out: String,
  x: Sealed,
  signers: List<String>,
  what: Option<Provenance>,
) -> Answer / {abort.raise} =
  {
    json: object([
      { key: "command", value: Str("build") },
      { key: "ok", value: Bool(true) },
      { key: "exit_code", value: num(ok_code()) },
      { key: "verified", value: Bool(true) },
      { key: "artifact", value: Str(out) },
      { key: "digest", value: Str(digest_text(x.full)) },
      { key: "signers", value: strings(signers) },
      {
        key: "provenance",
        value: match what {
          None -> Null,
          Some(v) ->
            object([
              { key: "kind", value: Str(v.kind) },
              { key: "name", value: Str(v.name) },
              { key: "builder", value: Str(v.builder) },
              { key: "semantics", value: Str(v.semantics) },
              { key: "commit", value: Str(v.commit) },
            ]),
        },
      },
    ]),
    lines: fold(
      map(signers, |h: String| ind() ++ "  " ++ bold(s, "signed") ++ " " ++ h),
      [
        ind() ++ green(s, "verified") ++ " " ++ out ++ " · " ++ x.digest ++ " · "
          ++ (if len(signers) == 0 { "unsigned" } else { count_of(len(signers), "signature") }),
      ],
      |acc: List<String>, l: String| push(acc, l),
    ),
    errs: [],
    code: ok_code(),
  }

// --- The command ------------------------------------------------------------

fn unstored(path: String) -> Diag =
  diag1(
    b"E0502",
    no_module(),
    { start: 0, end: 0 },
    bytes_of_string("could not write `" ++ path ++ "`"),
    b"the artifact was built but not stored",
    [],
  )

fn stored(
  out: String,
  body: Bytes,
) -> Result<Unit, Refusal> / {fs.create_dir[cwd], fs.create_dir[abs], fs.write_file[cwd], fs.write_file[abs], abort.raise} = {
  let at = paths::spelled(out);
  let room = match paths::parent_of(at) { Some(dir) -> paths::create_dir(dir), None -> true };
  if room && write_file(at, body) { Ok(()) } else { Err({ diags: [unstored(out)], places: [] }) }
}

fn written(
  s: Style,
  flags: Flags,
  p: Loaded,
  m: Made,
  x: Sealed,
) -> Answer / {fs.create_dir[cwd], fs.create_dir[abs], fs.write_file[cwd], fs.write_file[abs], fs.kind[abs], fs.read_file[cwd], fs.read_file[abs], abort.raise} = {
  let out = match flags.out { Some(v) -> v, None -> default_output(m.entry) };
  match signing_key(flags) {
    Err(d) -> reported(s, "build", [d], p.places),
    Ok(seed) -> match stored(out, x.bytes) {
      Err(why) -> reported(s, "build", why.diags, p.places),
      Ok(_) -> match signed(seed, out, built_provenance(flags, p, "program", m.entry, x)) {
        Err(d) -> reported(s, "build", [d], p.places),
        Ok(signer) ->
          {
            json: built_json(p, m, x, out, signer),
            lines: fold(
              signer_lines(s, signer),
              built_lines(s, p, m, x, out),
              |acc: List<String>, l: String| push(acc, l),
            ),
            errs: all_to_text(s, m.warnings, p.places),
            code: ok_code(),
          },
      },
    },
  }
}

fn differed(
  s: Style,
  p: Loaded,
  m: Made,
  x: Sealed,
  old: String,
) -> Answer / {builder.previous[build], fs.read_file[cwd], fs.read_file[abs], abort.raise} =
  match builder.previous[build](old, paths::read_file(paths::spelled(old))) {
    Err(why) -> reported(s, "build", why.diags, why.places),
    Ok(was) -> {
      let d = compared(was.names, m.names, m.reaches);
      {
        json: diff_json(
          m.entry,
          old,
          was.digest,
          x.digest,
          d,
          bytes_len(x.bytes),
          p.binary_bytes,
          was.warnings,
        ),
        lines: diff_lines(s, m.entry, was.digest, x.digest, d, was.warnings),
        errs: [],
        code: ok_code(),
      }
    },
  }

fn delivered(
  s: Style,
  flags: Flags,
  p: Loaded,
  m: Made,
  x: Sealed,
) -> Answer / {builder.previous[build], fs.read_file[cwd], fs.read_file[abs], fs.create_dir[cwd], fs.create_dir[abs], fs.write_file[cwd], fs.write_file[abs], fs.kind[abs], abort.raise} =
  match flags.diff {
    Some(old) -> differed(s, p, m, x, old),
    None -> if flags.digest {
      { json: digest_json(m, x), lines: [x.digest], errs: [], code: ok_code() }
    } else if flags.action == "verify" {
      verified(s, p, match flags.out { Some(v) -> v, None -> default_output(m.entry) }, x, domain())
    } else { written(s, flags, p, m, x) },
  }

fn is_diffed(flags: Flags) -> Bool = match flags.diff { Some(_) -> true, None -> false }

fn assembled(
  s: Style,
  flags: Flags,
  p: Loaded,
  entry: String,
  startup: List<String>,
) -> Answer / {builder.made[build], builder.previous[build], fs.read_file[cwd], fs.read_file[abs], fs.create_dir[cwd], fs.create_dir[abs], fs.write_file[cwd], fs.write_file[abs], fs.kind[abs], abort.raise} =
  match builder.made[build](entry, startup, is_diffed(flags)) {
    Err(why) -> reported(s, "build", why.diags, p.places),
    Ok(m) -> match seal(encode(m.head, m.sections)) {
      Err(why) -> reported(s, "build", why.diags, p.places),
      Ok(x) -> delivered(s, flags, p, m, x),
    },
  }

fn chosen(
  s: Style,
  flags: Flags,
  loaded: Program,
  p: Loaded,
  defs: List<Def>,
  startup: Result<List<String>, Diag>,
) -> Answer / {builder.made[build], builder.previous[build], fs.read_file[cwd], fs.read_file[abs], fs.create_dir[cwd], fs.create_dir[abs], builder.unit[build], fs.write_file[cwd], fs.write_file[abs], fs.kind[abs], abort.raise} =
  match entry_of(p, defs, flags) {
    // Nothing to build as a program. A library — a package that names no entry and declares no
    // `main` — is built as the package itself; anything else keeps the entry point's refusal.
    Err(d) -> if flags.entry == None && len(p.mains) == 0 { library(s, flags, loaded, p, defs, d) }
    else { reported(s, "build", [d], p.places) },
    Ok(entry) -> match startup {
      Err(d) -> reported(s, "build", [d], p.places),
      Ok(roots) -> assembled(s, flags, p, entry, roots),
    },
  }

pub fn run(
  flags: Flags,
) -> Answer / {builder.git[vcs], builder.loaded[build], builder.made[build], builder.previous[build], fs.read_file[cwd], fs.read_file[abs], fs.create_dir[cwd], fs.create_dir[abs], builder.unit[build], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shelf], fs.read_file[shelf], fs.write_file[cwd], fs.write_file[abs], time.elapsed_ms, time.elapsed_us, abort.raise} = {
  let s: Style = style_of(flags);
  let t: Timed = timed_uncached(flags.paths);
  match t.program.whole {
    None -> refused(s, "build", t.program.diags, t.program.places),
    Some(w) -> built_over(s, flags, t.program, defs_of(w), startup_of(w, flags), front_of(t, w)),
  }
}

// The build, over the program `run` loaded, what it decided of it, and the front end it handed the
// Rust side.
fn built_over(
  s: Style,
  flags: Flags,
  loaded: Program,
  defs: List<Def>,
  startup: Result<List<String>, Diag>,
  front: Front,
) -> Answer / {builder.loaded[build], builder.made[build], builder.previous[build], fs.read_file[cwd], fs.read_file[abs], fs.create_dir[cwd], fs.create_dir[abs], builder.unit[build], fs.read_file[cwd], fs.read_file[abs], fs.write_file[cwd], fs.write_file[abs], fs.kind[abs], abort.raise} = {
  let r = resolved_root(flags);
  let locked: Result<Option<lock::Lock>, String> = lock::read(r);
  match builder.loaded[build](root_of(flags), front) {
    Err(why) -> refused(s, "build", why.diags, why.places),
    Ok(p) -> match locked {
      Err(why) -> reported(s, "build", [lock::refused(r, why)], p.places),
      Ok(existing) -> match pinned_ok(r, existing, p) {
        Some(d) -> reported(s, "build", [d], p.places),
        None -> {
          let answer = chosen(s, flags, loaded, p, defs, startup);
          if answer.code == ok_code() { pinned(r, existing, p) };
          answer
        },
      },
    },
  }
}

// Every dependency the lock pins must be the one this load found: a build may not ship what the
// lockfile does not describe.
fn pinned_ok(r: Resolved, existing: Option<lock::Lock>, p: Loaded) -> Option<Diag> =
  match existing {
    None -> None,
    Some(lock) -> match lock::verified(r, lock, p.pins) { Ok(_) -> None, Err(d) -> Some(d) },
  }

fn unchanged(existing: Option<lock::Lock>, pins: List<lock::Pinned>) -> Bool =
  match existing {
    None -> false,
    Some(l) -> l.version == lock::format() && map(l.packages, lock::pin_of) == pins,
  }

fn pinned(
  r: Resolved,
  existing: Option<lock::Lock>,
  p: Loaded,
) -> Unit / {fs.write_file[cwd], fs.write_file[abs], abort.raise} =
  if unchanged(existing, p.pins) { () } else {
    write_file(lock::path_of(r), bytes_of_string(lock::text(existing, p.pins, [])));
    ()
  }

// The root the command was pointed at, as the resolved path the lockfile is read and written under.
fn resolved_root(flags: Flags) -> Resolved =
  match list_at(flags.paths, 0) { Some(r) -> r, None -> here() }

// --- A library ----------------------------------------------------------------------

fn member(xs: List<String>, x: String) -> Bool =
  fold(xs, false, |found: Bool, y: String| found || y == x)

fn library_name(m: Manifest) -> String = m.name ++ " " ++ render_version(m.version)

fn library_output(flags: Flags, name: String) -> String =
  match flags.out { Some(v) -> v, None -> name ++ ".plyz" }

// A library: a package whose manifest names no entry and whose own modules declare no `main`. It
// has no closure to ship, so what a build makes of it is the package itself — its sources, its
// manifest and a unit of every definition they declare — under a container of its own.
fn library(
  s: Style,
  flags: Flags,
  loaded: Program,
  p: Loaded,
  defs: List<Def>,
  refused: Diag,
) -> Answer / {fs.create_dir[cwd], fs.create_dir[abs], builder.unit[build], fs.write_file[cwd], fs.write_file[abs], fs.kind[abs], fs.read_file[cwd], fs.read_file[abs], abort.raise} =
  match loaded.whole {
    // The load behind this report found no entry point; a package that cannot be read keeps that.
    None -> reported(s, "build", [refused], p.places),
    Some(w) -> match w.manifest {
      // An anonymous directory is not a library: there is no package to write down.
      None -> reported(s, "build", [refused], p.places),
      Some(m) -> if m.entry != None { reported(s, "build", [refused], p.places) }
      else { library_writing(s, flags, p, loaded, defs, m) },
    },
  }

/// A library's archive, sealed, with what a report says of it: the definitions its unit compiled.
pub type Packed = { own: List<Def>, unit: Compiled, x: Sealed }

/// The archive a library ships as: what `ply build` writes and `ply publish` uploads, one function
/// so the two are the same bytes.
pub fn packed(
  loaded: Program,
  defs: List<Def>,
) -> Result<Packed, Refusal> / {builder.unit[build], abort.raise} = {
  let owned = map(loaded.files, |f: File| f.module);
  let own = filter(defs, |d: Def| member(owned, d.module));
  match builder.unit[build](map(own, |d: Def| d.name)) {
    Err(why) -> Err(why),
    Ok(compiled) -> {
      let manifest = match loaded.pkgs.manifest { Some(text) -> text, None -> b"" };
      let container = encode_named(
        library_magic(),
        compiled.head,
        plyz::sections(loaded.files, manifest, compiled),
      );
      match sealed_at(container, library_domain()) {
        Err(why) -> Err(why),
        Ok(x) -> Ok({ own: own, unit: compiled, x: x }),
      }
    },
  }
}

fn library_writing(
  s: Style,
  flags: Flags,
  p: Loaded,
  loaded: Program,
  defs: List<Def>,
  m: Manifest,
) -> Answer / {fs.create_dir[cwd], fs.create_dir[abs], builder.unit[build], fs.write_file[cwd], fs.write_file[abs], fs.kind[abs], fs.read_file[cwd], fs.read_file[abs], abort.raise} =
  match packed(loaded, defs) {
    Err(why) -> reported(s, "build", why.diags, p.places),
    Ok(k) -> {
      let out = library_output(flags, m.name);
      if flags.action == "verify" { verified(s, p, out, k.x, library_domain()) } else {
        match signing_key(flags) {
          Err(d) -> reported(s, "build", [d], p.places),
          Ok(seed) -> match stored(out, k.x.bytes) {
            Err(why) -> reported(s, "build", why.diags, p.places),
            Ok(_) -> match signed(
                seed,
                out,
                built_provenance(flags, p, "library", library_name(m), k.x),
              ) {
              Err(d) -> reported(s, "build", [d], p.places),
              Ok(signer) ->
                {
                  json: library_json(p, m, k.own, k.unit, k.x, out, signer),
                  lines: fold(
                    signer_lines(s, signer),
                    library_lines(s, m, len(loaded.files), k.own, k.unit, k.x, out),
                    |acc: List<String>, l: String| push(acc, l),
                  ),
                  errs: [],
                  code: ok_code(),
                },
            },
          },
        }
      }
    },
  }

fn library_lines(
  s: Style,
  m: Manifest,
  modules: Int,
  own: List<Def>,
  unit: Compiled,
  x: Sealed,
  out: String,
) -> List<String> / {abort.raise} =
  [
    ind() ++ green(s, "built") ++ " " ++ library_name(m) ++ " · " ++ x.digest,
    ind() ++ bold(s, "library") ++ " " ++ count_of(modules, "module") ++ " · "
      ++ count_of(bytes_len(x.bytes), "byte")
      ++ " · "
      ++ out,
    ind() ++ bold(s, "unit") ++ " " ++ count_of(len(own), "definition") ++ " compiled",
  ]

fn library_json(
  p: Loaded,
  m: Manifest,
  own: List<Def>,
  unit: Compiled,
  x: Sealed,
  out: String,
  signer: Option<String>,
) -> Json / {abort.raise} =
  object([
    { key: "command", value: Str("build") },
    { key: "ok", value: Bool(true) },
    { key: "exit_code", value: num(ok_code()) },
    { key: "library", value: Bool(true) },
    { key: "root", value: Str(p.root) },
    { key: "name", value: Str(m.name) },
    { key: "version", value: Str(render_version(m.version)) },
    { key: "definitions", value: num(len(own)) },
    { key: "artifact", value: Str(out) },
    { key: "digest", value: Str(x.digest) },
    { key: "format", value: num(format()) },
    { key: "unit", value: Bool(bytes_len(unit.payload) > 0) },
    { key: "artifact_bytes", value: num(bytes_len(x.bytes)) },
    { key: "signed_by", value: signer_json(signer) },
    { key: "diagnostics", value: all_to_json([], p.places) },
  ])

// --- Tests ------------------------------------------------------------------

fn a_def(name: String, simple: String, module: String, arity: Int) -> Def =
  { name: name, simple: simple, module: module, at: nowhere(), arity: arity }

fn some_defs() -> List<Def> =
  [
    a_def("m.main", "main", "m", 0),
    a_def("m.serve", "serve", "m", 1),
    a_def("m.spec", "spec", "m", 0),
    a_def("left.util", "util", "left", 0),
    a_def("right.util", "util", "right", 0),
  ]

fn a_main() -> Main = { name: "m.main", module: "m", path: "m.ply", at: nowhere() }

fn a_load() -> Loaded =
  {
    root: "/p",
    mains: [a_main()],
    modules: [{ name: "m", path: "m.ply", at: nowhere() }],
    places: [],
    pins: [],
    binary_bytes: Some(12582912),
    version: "0.16.0",
  }

fn a_head() -> Head = { frontend: b"", runtime: b"", stdlib: b"", entry: b"" }

fn a_made() -> Made =
  {
    entry: "m.main",
    entry_hash: "9f2c1a4e",
    startup: [],
    head: a_head(),
    sections: [{ name: b"bodies", count: 1, payload: b"AA" }],
    definitions: 1,
    names: [{ name: "m.main", hash: "aa" }],
    unit: true,
    reaches: [],
    warnings: [],
  }

fn flags_of(json: Bool) -> Flags = { ..no_flags(), json: json }

test "a size is exact in bytes and one decimal above that" {
  assert_eq(human(0), "0 B");
  assert_eq(human(512), "512 B");
  assert_eq(human(2048), "2.0 KB");
  assert_eq(human(3145728), "3.0 MB")
}

test "a long list is counted rather than printed whole" {
  let many = map(range(0, 20), |i: Int| "m.d" ++ int_to_string(i));
  assert(string_ends_with(listed(many), "and 12 more"));
  assert_eq(listed(["m.a", "m.b", "m.c"]), "m.a, m.b, m.c");
  assert_eq(listed([]), "")
}

test "the default output is named after the entry point's module" {
  assert_eq(default_output("desk.run"), "desk.plyx");
  assert_eq(default_output("store.orders.main"), "orders.plyx");
  assert_eq(default_output("main"), "main.plyx")
}

test "`--entry` takes a program-wide name or a simple one" {
  assert_eq(entry_named(some_defs(), "m.main"), Ok("m.main"));
  assert_eq(entry_named(some_defs(), "spec"), Ok("m.spec"))
}

test "an entry point that takes an argument is refused, and so is a name nothing declares" {
  match entry_named(some_defs(), "serve") {
    Ok(_) -> panic("a definition that takes an argument cannot be an entry point"),
    Err(d) -> {
      assert_eq(d.code, b"E0201");
      assert(string_contains(string_of_bytes_lossy(d.message), "takes 1 argument"))
    },
  };
  match entry_named(some_defs(), "absent") {
    Ok(_) -> panic("a name nothing declares is not an entry point"),
    Err(d) -> assert_eq(d.code, b"E0101"),
  }
}

test "a simple name two modules declare says which two" {
  match entry_named(some_defs(), "util") {
    Ok(_) -> panic("two definitions named `util` is not one entry point"),
    Err(d) -> {
      assert_eq(d.code, b"E0112");
      assert_eq(d.message, b"2 definitions are named `util`");
      assert_eq(len(d.labels), 2);
      assert_eq(at(d.labels, 0, marked(nowhere(), false, b"")).primary, true);
      assert_eq(at(d.labels, 1, marked(nowhere(), true, b"")).primary, false)
    },
  }
}

fn a_whole() -> Whole / {abort.raise} = {
  let src = b"type Key = { name: String }\ntype ConfigSpec = { keys: List<Key> }\npub fn spec() -> ConfigSpec = { keys: [] }\nfn main() -> Int = 1\nfn serve(port: Int) -> Int = port\n";
  match analyse(parse_all([{ name: b"m", src: src }])) {
    Refused(_) -> panic("the fixture checks"),
    Analysed(w) -> w,
  }
}

test "the definitions `--entry` may name are the program's own, as written, with their arity" {
  assert_eq(map(defs_of(a_whole()), |d: Def| (d.name, d.simple, d.module, d.arity)), [
    ("m.spec", "spec", "m", 0),
    ("m.main", "main", "m", 0),
    ("m.serve", "serve", "m", 1),
  ])
}

test "a schema is resolved as a run resolves it, and one that is not stops the build" {
  match startup_of(a_whole(), { ..no_flags(), config_schema: Some("m.absent") }) {
    Ok(_) -> panic("a schema nothing declares cannot ship"),
    Err(d) -> {
      assert_eq(d.code, b"E0440");
      assert_eq(d.message, b"`--config-schema m.absent` names no definition in this program");
      assert_eq(d.notes_text, [b"this program has: m.spec"])
    },
  };
  // The artifact is run with the flag it was built with, so a simple name is no more a schema here.
  match startup_of(a_whole(), { ..no_flags(), config_schema: Some("spec") }) {
    Ok(_) -> panic("a simple name is not the name a run takes"),
    Err(d) -> assert_eq(d.code, b"E0440"),
  };
  match startup_of(a_whole(), { ..no_flags(), config_schema: Some("m.serve") }) {
    Ok(_) -> panic("a function that takes an argument is no schema"),
    Err(d) -> assert_eq(d.code, b"E0440"),
  };
  assert_eq(startup_of(a_whole(), { ..no_flags(), config_schema: Some("m.spec") }), Ok(["m.spec"]));
  assert_eq(startup_of(a_whole(), no_flags()), Ok([]))
}

test "a rename adds a name and drops one without changing a body" {
  let was = [{ name: "m.helper", hash: "aa" }, { name: "m.main", hash: "bb" }];
  let now = [{ name: "m.assistant", hash: "aa" }, { name: "m.main", hash: "bb" }];
  let d = compared(was, now, []);
  assert_eq(d.added, ["m.assistant"]);
  assert_eq(d.dropped, ["m.helper"]);
  assert_eq(d.changed, []);
  assert_eq(d.unchanged, 1)
}

test "a changed callee changes its caller, and what reaches a change is listed" {
  let was = [{ name: "m.main", hash: "aa" }, { name: "m.shade", hash: "bb" }];
  let now = [
    { name: "m.main", hash: "a1" },
    { name: "m.other", hash: "cc" },
    { name: "m.shade", hash: "b1" },
  ];
  let reaches = [
    { name: "m.Colour", reaches: ["m.Colour"] },
    { name: "m.main", reaches: ["m.main", "m.shade"] },
    { name: "m.shade", reaches: ["m.shade"] },
  ];
  let d = compared(was, now, reaches);
  assert_eq(d.added, ["m.other"]);
  assert_eq(d.changed, ["m.main", "m.shade"]);
  assert_eq(d.dropped, []);
  assert_eq(d.unchanged, 0);
  assert_eq(d.reached, ["m.main", "m.shade"])
}

test "one name filed under two hashes is one name" {
  let twice = [{ name: "m.main", hash: "aa" }, { name: "m.main", hash: "bb" }];
  assert_eq(distinct(twice), ["m.main"]);
  assert_eq(compared(twice, twice, []).unchanged, 1);
  assert_eq(compared([{ name: "m.main", hash: "aa" }], twice, []).changed, ["m.main"])
}

test "the diff reads as three rows, a tally, and what a change is reached by" {
  let d: Diff = {
    added: ["m.other"],
    changed: ["m.main"],
    dropped: [],
    unchanged: 2,
    reached: ["m.main"],
  };
  assert_eq(diff_lines(plain(), "m.main", "b3:aaa", "b3:bbb", d, []), [
    "   m.main b3:aaa → b3:bbb",
    "",
    "   added      1 definition   m.other",
    "   changed    1 definition   m.main",
    "   dropped    0 definitions",
    "   unchanged  2 definitions",
    "",
    "   reached by a changed definition: 1 definition",
    "     m.main",
  ])
}

// A program the fixture never loads: the Rust side's answer, which the test hands in, is the load.
fn no_program() -> Program =
  {
    files: [],
    places: [],
    diags: [],
    whole: None,
    pkgs: { root: b"", manifest: None, supplied: [] },
    through: [],
    embeds: [],
  }

// `stores` is whether the artifact's file can be written.
fn answered_over(
  flags: Flags,
  p: Result<Loaded, Refusal>,
  m: Result<Made, Refusal>,
  was: Result<Previous, Refusal>,
  stores: Bool,
) -> Answer / {abort.raise} =
  handle {
    built_over(style_of(flags), flags, no_program(), some_defs(), Ok([]), no_front())
  } with {
    builder.loaded[build](root, front) -> p,
    builder.made[build](entry, startup, reaches) -> m,
    builder.previous[build](path, bytes) -> was,
    // A test's project has whatever lockfile it says it has, and a build writes the one that
    // records the load's pins.
    fs.read_file[cwd](path) -> lockfile(path),
    fs.read_file[abs](path) -> lockfile(path),
    fs.create_dir[cwd](path) -> stores,
    fs.create_dir[abs](path) -> stores,
    fs.write_file[cwd](path, body) -> stores || string_ends_with(path, "ply.lock"),
    fs.write_file[abs](path, body) -> stores || string_ends_with(path, "ply.lock"),
    // The fixture is checked out nowhere, so its provenance names no commit.
    fs.kind[abs](path) -> Missing,
    // A library's path is only reached by a test that means it: the fixture is a program.
    builder.unit[build](names) -> no_unit(names),
  }

// The fixture has no library to compile: a test that asks for a unit is asking about a path the
// fixture does not take, and the answer says so rather than inventing one.
fn no_unit(names: List<String>) -> Result<Compiled, Refusal> = Err({ diags: [], places: [] })

// The lockfile a test's project holds: none, so a build pins what it loaded.
fn lockfile(path: String) -> Option<Bytes> = None

fn nothing() -> Refusal = { diags: [], places: [] }

fn a_build(flags: Flags) -> Answer / {abort.raise} =
  answered_over(flags, Ok(a_load()), Ok(a_made()), Err(nothing()), true)

test "a build says what it wrote, where, and what the artifact and the binary weigh" {
  let answer = a_build(flags_of(false));
  assert_eq(answer.code, 0);
  assert_eq(answer.errs, []);
  assert_eq(answer.lines, [
    "   built m.main · b3:7a04b78da535",
    "   artifact 1 definition · 210 B · m.plyx",
    "   binary ply 0.16.0 · 12.0 MB",
    "   startup none — this artifact cannot be run with `--config-schema`",
  ])
}

test "the object keys off `command` and `exit_code`, and names the file it wrote" {
  let text = to_string(a_build(flags_of(true)).json);
  assert(string_contains(text, "\"command\":\"build\""));
  assert(string_contains(text, "\"exit_code\":0"));
  assert(string_contains(text, "\"entry\":\"m.main\""));
  assert(string_contains(text, "\"artifact\":\"m.plyx\""));
  assert(string_contains(text, "\"digest\":\"b3:7a04b78da535\""));
  assert(string_contains(text, "\"definitions\":1"));
  assert(string_contains(text, "\"names\":1"));
  assert(string_contains(text, "\"unit\":true"));
  assert(string_contains(text, "\"artifact_bytes\":210"));
  assert(string_contains(text, "\"root\":\"/p\""));
  assert(string_contains(text, "\"format\":" ++ int_to_string(format())))
}

test "`-o` names the file, and the entry's module names it otherwise" {
  let answer = a_build({ ..no_flags(), out: Some("dist/app.plyx") });
  assert_eq(at(answer.lines, 1, ""), "   artifact 1 definition · 210 B · dist/app.plyx")
}

test "`--digest` writes the one line a deployment pins and nothing else" {
  let answer = answered_over(
    { ..no_flags(), digest: true },
    Ok(a_load()),
    Ok(a_made()),
    Err(nothing()),
    false,
  );
  assert_eq(answer.lines, ["b3:7a04b78da535"]);
  assert_eq(answer.errs, []);
  assert_eq(answer.code, 0)
}

test "`--diff` reports against a deployed artifact and writes no file" {
  let was: Previous = {
    digest: "b3:000000000000",
    names: [{ name: "m.helper", hash: "cc" }],
    warnings: [],
  };
  let answer = answered_over(
    { ..no_flags(), diff: Some("old.plyx"), json: true },
    Ok(a_load()),
    Ok(a_made()),
    Ok(was),
    false,
  );
  assert_eq(answer.code, 0);
  let text = to_string(answer.json);
  assert(string_contains(text, "\"against\":\"old.plyx\""));
  assert(string_contains(text, "\"was\":\"b3:000000000000\""));
  assert(string_contains(text, "\"now\":\"b3:7a04b78da535\""));
  assert(string_contains(text, "\"added\":[\"m.main\"]"));
  assert(string_contains(text, "\"dropped\":[\"m.helper\"]"))
}

test "a program that does not load is the load's own refusal, with the tally under it" {
  let why: Refusal = {
    diags: [
      {
        code: b"E0201",
        notes: 0,
        labels: [],
        text: b"",
        message: b"type mismatch",
        notes_text: [],
        severity: b"error",
        fixes: [],
      },
    ],
    places: [],
  };
  let answer = answered_over(flags_of(false), Err(why), Err(nothing()), Err(nothing()), false);
  assert_eq(answer.code, 2);
  assert_eq(answer.lines, []);
  assert_eq(answer.errs, ["Error[E0201]: type mismatch", ind() ++ "compilation failed (1 error)"])
}

test "an artifact that cannot be written is exit 2 with no tally" {
  let answer = answered_over(
    { ..flags_of(false), out: Some("dist/m.plyx") },
    Ok(a_load()),
    Ok(a_made()),
    Err(nothing()),
    false,
  );
  assert_eq(answer.code, 2);
  assert_eq(answer.lines, []);
  assert_eq(answer.errs, ["Error[E0502]: could not write `dist/m.plyx`"])
}

test "an entry point the flags name badly stops the build before anything is made" {
  let answer = answered_over(
    { ..no_flags(), entry: Some("serve") },
    Ok(a_load()),
    Err(nothing()),
    Err(nothing()),
    false,
  );
  assert_eq(answer.code, 2);
  assert_eq(
    at(answer.errs, 0, ""),
    "Error[E0201]: `m.serve` takes 1 argument, and a deployed artifact is started with none",
  )
}
