//! `ply build` — a deployable artifact, or what a build changes against a deployed one. The front
//! end is this program's own load and `deployed` makes the artifact of it; everything below decides
//! which entry is built, where the artifact lands, and what both forms say. The container itself is
//! `compiler.plyx`, which owns the magic, the header and the section table.

import compiler.load (LoadedAnalysis, SourceFile)
import args (Flags, no_flags, style_of, root_of)
import entries
import std.path (normalize)
import builder (Loaded, Refusal)
import builder (builder)
import deployed (Compiled, Made, Named, Previous, Reach, artifacts, deploying)
import units (emit)
import compiler.unit (shipped)
import config_schema
import lock
import paths (Resolved, Rooted, displayed, here, write_file)
import paths
import compiler.diagnostics (parse_all)
