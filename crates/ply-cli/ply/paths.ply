//! The path a command was given, resolved. The launcher binds `cwd` to the working directory and
//! `abs` to the filesystem's root: a path that stays under the working directory is addressed
//! under `cwd`, and one that leaves it is addressed under `abs`, root-relative, after a lexical
//! normalize. `resolve` is where that is decided; everything after it carries the answer as a
//! `Rooted` path. A command that loads a project finds its root: the nearest directory at or above
//! what its line names, or the working directory where it names nothing, that holds a `ply.pkg`.

import std.cli
import env (env)
import std.fs (fs, Kind, File, Dir, Symlink, Missing, MemFs, Written, mem_create_dir, mem_empty,
               mem_kind, mem_list, mem_of, mem_read, mem_resolved, mem_symlink, mem_write)
import std.path (below_root, file_name, is_absolute, join, normalize, parent, strip_dot)
import std.list

/// A command's path argument, resolved: the label its fs reads spell, the project root it reports
/// and the machine loads by, and the path inside that root (`.` for the whole of it).
pub type Resolved = {
  /// `cwd` while the root stays under the working directory, else `abs`.
  label: String,
  /// The project root, spelled for the label (`pwd`-relative, or root-relative under `abs`).
  spelling: String,
  /// The project root as reports print it: relative to the working directory when it can be.
  display: String,
  /// What the line named inside the root. A command narrows to it, and a load reads it in place
  /// of the root's every module only where the root holds no `ply.pkg`.
  inside: String,
  /// The project root, absolute: the key a package walk roots at and resolves dependencies against.
  absolute: String,
  /// The project root as the machine spells it: the working-directory spelling while it stays
  /// under it (so the spans a run reports read as given), the absolute form once it leaves.
  machine: String,
}

/// The path with `prefix` dropped when it starts with it.
pub fn strip_prefix(path: String, prefix: String) -> Option<String> / {abort.raise} =
  if path == prefix { Some("") }
  else if path.starts_with(prefix ++ "/") { Some(path.slice(prefix.len() + 1, path.len())) }
  else { None }

/// What the path names, following a symlink to its target, as the root names it.
fn kind_of(label: String, spelling: String) -> String / {fs.resolved[cwd], fs.resolved[abs]} = {
  let kind = if label == "cwd" { fs.resolved[cwd](spelling) } else { fs.resolved[abs](spelling) };
  match kind { File -> "file", Dir -> "dir", Symlink -> "symlink", Missing -> "missing" }
}

/// The nearest directory at or above the path, walking up from a name that names nothing. Each step
/// up is shorter, so the spelling's length bounds the steps.
fn nearest_dir(
  label: String,
  spelling: String,
) -> String / {fs.resolved[cwd], fs.resolved[abs], abort.raise} =
  iterate(spelling, spelling.len() + 2, |at: String|
    if kind_of(label, at) == "dir" || at == "." || at == "" || parent(at) == at { Stop(at) }
    else { Continue(parent(at)) })

fn display_of(pwd: String, full: String) -> String / {abort.raise} =
  match strip_prefix(full, pwd) { Some(rest) -> if rest == "" { "." } else { rest }, None -> full }

fn absolute_of(pwd: String, label: String, spelling: String) -> String =
  normalize(if label == "cwd" { join(pwd, spelling) } else { "/" ++ spelling })

/// How `full`, an absolute path, is addressed from the working directory `pwd`: its label, and its
/// spelling under it.
fn addressed(pwd: String, full: String) -> (String, String) / {abort.raise} =
  match strip_prefix(full, pwd) {
    Some(rest) -> ("cwd", if rest == "" { "." } else { rest }),
    None -> ("abs", below_root(full)),
  }

/// The absolute directory `dir` as a project root, with `inside` named in it.
fn root_at(pwd: String, dir: String, inside: String) -> Resolved / {abort.raise} = {
  let (label, spelling) = addressed(pwd, dir);
  {
    label: label,
    spelling: spelling,
    display: display_of(pwd, dir),
    inside: inside,
    absolute: dir,
    machine: if label == "cwd" { spelling } else { dir },
  }
}

/// The path as it stands: a directory is a root, a file is in the root that holds it, and a name
/// that names nothing is in the nearest directory above it.
pub fn resolve(
  arg: String,
) -> Resolved / {fs.resolved[cwd], fs.resolved[abs], env.pwd[sys], abort.raise} = {
  let pwd = env.pwd[sys]();
  let full = normalize(if is_absolute(strip_dot(arg)) { arg } else { join(pwd, strip_dot(arg)) });
  let (label, spelling) = addressed(pwd, full);
  match kind_of(label, spelling) {
    "dir" -> root_at(pwd, full, "."),
    "file" -> root_at(pwd, parent(full), file_name(full)),
    _ -> {
      // Nothing there: the nearest directory above it is rooted, so the program reports the name.
      let dir = nearest_dir(label, spelling);
      root_at(pwd, absolute_of(pwd, label, dir), match strip_prefix(spelling, dir) {
        Some(rest) -> rest,
        None -> spelling,
      })
    },
  }
}

/// The nearest directory at or above `dir`, an absolute path, that holds a `ply.pkg`: the root of
/// the package `dir` is part of. `None` where no directory up to the filesystem's root holds one,
/// and for a relative path.
pub fn package_of(dir: String) -> Option<String> / {fs.resolved[abs], abort.raise} =
  iterate(normalize(dir), dir.len() + 2, |at: String|
    if !is_absolute(at) { Stop(None) }
    else if fs.resolved[abs](below_root(join(at, "ply.pkg"))) == File { Stop(Some(at)) }
    else if at == "/" { Stop(None) }
    else { Continue(parent(at)) })

/// `resolved` in the package that holds it: rooted at the nearest directory at or above its root
/// that holds a `ply.pkg`, with what it named as the path inside. Itself where no package holds it,
/// and where it names a file that is no module, which is read as it stands.
pub fn in_package(resolved: Resolved) -> Resolved / {fs.resolved[abs], env.pwd[sys], abort.raise} =
  if resolved.inside != "." && !resolved.inside.ends_with(".ply") { resolved } else {
    match package_of(resolved.absolute) {
      None -> resolved,
      Some(root) -> match strip_prefix(resolved.absolute, if root == "/" { "" } else { root }) {
        None -> resolved,
        Some(below) ->
          root_at(env.pwd[sys](), root, if below == "" { resolved.inside }
          else if resolved.inside == "." { below }
          else { join(below, resolved.inside) }),
      },
    }
  }

/// The fs spelling of the whole resolved path (the root's spelling joined with the inside path).
fn address(resolved: Resolved) -> String =
  if resolved.inside == "." { resolved.spelling } else { join(resolved.spelling, resolved.inside) }

/// Whether `path`, a file's place below the root, is what the line named or is under it.
pub fn names(resolved: Resolved, path: String) -> Bool =
  resolved.inside == "." || path == resolved.inside || path.starts_with(resolved.inside ++ "/")

/// Whether a line that resolved to `resolved` names `path`: every path, where it resolved to none.
pub fn names_any(resolved: List<Resolved>, path: String) -> Bool =
  resolved.len() == 0 || resolved.fold(false, |hit: Bool, r: Resolved| hit || names(r, path))

/// The whole resolved path as a report spells it.
pub fn given(resolved: Resolved) -> String = displayed(rooted(resolved))

/// A path as one root spells it, read and written through that root and no other.
pub type Rooted = { label: String, path: String }

/// The whole resolved path, under the root it resolved to.
pub fn rooted(resolved: Resolved) -> Rooted = { label: resolved.label, path: address(resolved) }

/// An absolute path under the filesystem's root, any other under the working directory.
pub fn spelled(path: String) -> Rooted / {abort.raise} =
  if is_absolute(path) {
    let full = normalize(path);
    { label: "abs", path: full.slice(1, full.len()) }
  } else { { label: "cwd", path: normalize(path) } }

pub fn parent_of(p: Rooted) -> Option<Rooted> = {
  let dir = parent(p.path);
  if dir == "" || dir == "." || dir == "/" { None } else { Some({ label: p.label, path: dir }) }
}

/// A file in the root's own directory, whatever the path named inside it: where a package keeps its
/// `ply.pkg` and its `ply.lock`.
pub fn in_root(resolved: Resolved, name: String) -> Rooted =
  child({ label: resolved.label, path: resolved.spelling }, name)

/// A name in a rooted directory, under the directory's root.
pub fn child(dir: Rooted, name: String) -> Rooted = { label: dir.label, path: join(dir.path, name) }

/// The path as a report prints it: as spelled under the working directory, absolute outside it.
pub fn displayed(p: Rooted) -> String = if p.label == "cwd" { p.path } else { "/" ++ p.path }

pub fn read_file(p: Rooted) -> Option<Bytes> / {fs.read_file[cwd], fs.read_file[abs]} =
  if p.label == "cwd" { fs.read_file[cwd](p.path) } else { fs.read_file[abs](p.path) }

pub fn write_file(p: Rooted, body: Bytes) -> Bool / {fs.write_file[cwd], fs.write_file[abs]} =
  if p.label == "cwd" { fs.write_file[cwd](p.path, body) } else { fs.write_file[abs](p.path, body) }

/// The secret a file holds between `before` and `after` in `encoding`, never a plain value.
pub fn read_secret(
  p: Rooted,
  before: Bytes,
  encoding: String,
  after: Bytes,
) -> Option<Secret<Bytes>> / {fs.read_secret[cwd], fs.read_secret[abs]} =
  if p.label == "cwd" { fs.read_secret[cwd](p.path, before, encoding, after) }
  else { fs.read_secret[abs](p.path, before, encoding, after) }

/// A secret between `before` and `after` in `encoding`, as a file its owner alone may read, the
/// secret never a plain value.
pub fn write_secret(
  p: Rooted,
  before: Bytes,
  secret: Secret<Bytes>,
  encoding: String,
  after: Bytes,
) -> Bool / {fs.write_secret[cwd], fs.write_secret[abs]} =
  if p.label == "cwd" { fs.write_secret[cwd](p.path, before, secret, encoding, after) }
  else { fs.write_secret[abs](p.path, before, secret, encoding, after) }

/// What the path names; a symlink is reported as one and never followed.
pub fn kind(p: Rooted) -> Kind / {fs.kind[cwd], fs.kind[abs]} =
  if p.label == "cwd" { fs.kind[cwd](p.path) } else { fs.kind[abs](p.path) }

pub fn list_dir(p: Rooted) -> Option<List<String>> / {fs.list_dir[cwd], fs.list_dir[abs]} =
  if p.label == "cwd" { fs.list_dir[cwd](p.path) } else { fs.list_dir[abs](p.path) }

pub fn modified_ms(p: Rooted) -> Option<Int> / {fs.modified_ms[cwd], fs.modified_ms[abs]} =
  if p.label == "cwd" { fs.modified_ms[cwd](p.path) } else { fs.modified_ms[abs](p.path) }

pub fn file_size(p: Rooted) -> Option<Int> / {fs.file_size[cwd], fs.file_size[abs]} =
  if p.label == "cwd" { fs.file_size[cwd](p.path) } else { fs.file_size[abs](p.path) }

pub fn create_dir(p: Rooted) -> Bool / {fs.create_dir[cwd], fs.create_dir[abs]} =
  if p.label == "cwd" { fs.create_dir[cwd](p.path) } else { fs.create_dir[abs](p.path) }

/// The walked path's prefix that module naming drops: the root's own spelling, so a file names
/// its stem and a directory's walk names what is under it. `strip_prefix` adds the separator.
pub fn root_prefix(resolved: Resolved) -> String =
  if resolved.spelling == "." { "" } else { resolved.spelling }

/// The paths a command's line names. The name a query command looks up is not a path, nor is any
/// word of a command that loads no project.
fn named_by(command: String, parsed: cli::Parsed) -> List<String> =
  if command == "doc" || command == "show" || command == "callers" || command == "replace"
      || command == "why" { drop_first(parsed.positionals) }
  else if command == "cache" && parsed.path.at_or(1, "") == "inspect" {
    drop_first(parsed.positionals)
  } else if loads_nothing(command) { [] }
  else { parsed.positionals }

/// The commands that load no project: what they act on is not found from where they run.
fn loads_nothing(command: String) -> Bool =
  command == "explain" || command == "std" || command == "yank" || command == "contracts"
    || command == "keygen"
    || command == "attest"

/// The command's paths, resolved. One that loads a project acts on the package each path is part
/// of, and on the package the working directory is part of where its line names no path: `Err`
/// holds the working directory when no package holds it. `ply new` and `ply bootstrap` take their
/// path as it stands, as `ply fmt` takes the ones it is given, and a command that loads no project
/// is given the working directory.
pub fn resolve_all(
  command: String,
  parsed: cli::Parsed,
) -> Result<List<Resolved>, String> / {fs.resolved[cwd], fs.resolved[abs], env.pwd[sys], abort.raise} = {
  let named = named_by(command, parsed);
  if loads_nothing(command) { Ok([resolve(".")]) }
  else if command == "new" || command == "bootstrap" || (command == "fmt" && named.len() > 0) {
    Ok(named.map(|path: String| resolve(path)))
  } else if named.len() > 0 { Ok(named.map(|path: String| in_package(resolve(path)))) } else {
    let pwd = env.pwd[sys]();
    match package_of(pwd) { Some(root) -> Ok([root_at(pwd, root, ".")]), None -> Err(pwd) }
  }
}

fn drop_first(xs: List<String>) -> List<String> = match xs { [] -> [], [_, ..rest] -> rest }

/// The working directory, unresolved: what an empty path list means.
pub fn here() -> Resolved =
  { label: "cwd", spelling: ".", display: ".", inside: ".", absolute: ".", machine: "." }

/// A path in the working directory, for tests that build one by hand.
pub fn at_cwd(spelling: String) -> Resolved =
  {
    label: "cwd",
    spelling: spelling,
    display: spelling,
    inside: ".",
    absolute: spelling,
    machine: spelling,
  }

/// A root outside the working directory, as `resolve` answers one.
pub fn at_abs(spelling: String) -> Resolved =
  {
    label: "abs",
    spelling: spelling,
    display: "/" ++ spelling,
    inside: ".",
    absolute: "/" ++ spelling,
    machine: "/" ++ spelling,
  }

// --- Checkouts -----------------------------------------------------------------

/// What an absolute path names under `abs`, a symlink reported as one.
fn kind_at_root(path: String) -> Kind / {fs.kind[abs], abort.raise} =
  fs.kind[abs](path.slice(1, path.len()))

/// The checkout an absolute directory is part of: the nearest directory at or above it that holds a
/// `.git`, the directory a clone keeps or the file a worktree or a submodule keeps in its place.
/// `None` outside every checkout and for a relative path; the filesystem's root is never one.
pub fn checkout_of(dir: String) -> Option<String> / {fs.kind[abs], abort.raise} =
  iterate(normalize(dir), dir.len() + 2, |at: String|
    if !is_absolute(at) || at == "/" { Stop(None) }
    else if kind_at_root(join(at, ".git")) != Missing { Stop(Some(at)) }
    else { Continue(parent(at)) })

/// Whether the absolute directory `dir` is part of the checkout at `tree`, so that a commit of the
/// checkout holds what is in it: at or below `tree`, and with no directory from it up to `tree` a
/// symlink, whose target a commit does not hold, or a checkout of its own (a nested repository or a
/// submodule), whose files the outer commit does not hold either.
pub fn in_checkout(tree: String, dir: String) -> Bool / {fs.kind[abs], abort.raise} =
  iterate(normalize(dir), dir.len() + 2, |at: String|
    if at == tree { Stop(true) }
    else if !at.starts_with(tree ++ "/") { Stop(false) }
    else if kind_at_root(at) != Dir || kind_at_root(join(at, ".git")) != Missing { Stop(false) }
    else { Continue(parent(at)) })

// --- Tests ------------------------------------------------------------------

test "a rooted path prints as spelled under the working directory, and absolute outside it" {
  assert_eq(displayed({ label: "cwd", path: "sub/m.ply" }), "sub/m.ply");
  assert_eq(displayed({ label: "abs", path: "srv/app/m.ply" }), "/srv/app/m.ply");
  assert_eq(displayed({ label: "abs", path: "" }), "/")
}

test "a rooted path is read and written through its own root, never the other" {
  let read = handle {
    read_file({ label: "abs", path: "srv/m.ply" })
  } with {
    fs.read_file[cwd](p) -> panic("a path under `abs` is read under `abs`"),
    fs.read_file[abs](p) -> if p == "srv/m.ply" { Some(b"text") } else { None },
  };
  assert_eq(read, Some(b"text"));
  let wrote = handle {
    write_file({ label: "cwd", path: "m.ply" }, b"text")
  } with {
    fs.write_file[cwd](p, body) -> p == "m.ply" && body == b"text",
    fs.write_file[abs](p, body) -> panic("a path under `cwd` is written under `cwd`"),
  };
  assert(wrote)
}

test "a rooted path is looked at and listed through its own root, never the other" {
  let here = mem_of([{ path: "app/m.ply", body: b"fn m() -> Int = 1" }]);
  let root = mem_of([{ path: "srv/app/m.ply", body: b"fn m() -> Int = 2" }]);
  let kinds = handle {
    [
      kind({ label: "cwd", path: "app" }),
      kind({ label: "cwd", path: "app/m.ply" }),
      kind({ label: "abs", path: "app" }),
      kind({ label: "abs", path: "srv/app/m.ply" }),
    ]
  } with {
    fs.kind[cwd](p) -> mem_kind(here, p),
    fs.kind[abs](p) -> mem_kind(root, p),
  };
  assert_eq(kinds, [Dir, File, Missing, File]);
  let listed = handle {
    [
      list_dir({ label: "cwd", path: "." }),
      list_dir({ label: "abs", path: "srv/app" }),
      list_dir({ label: "abs", path: "app" }),
    ]
  } with {
    fs.list_dir[cwd](p) -> mem_list(here, p),
    fs.list_dir[abs](p) -> mem_list(root, p),
  };
  assert_eq(listed, [Some(["app"]), Some(["m.ply"]), None])
}

test "a directory is made through its own root, and a child of it is written there" {
  with_cell[twin](mem_empty()) { a -> {
    let made: Rooted = { label: "abs", path: "srv/demo" };
    let wrote = handle {
      create_dir(made) && write_file(child(made, "ply.pkg"), b"pkg")
    } with {
      fs.create_dir[cwd](p) -> panic("a path under `abs` is made under `abs`"),
      fs.create_dir[abs](p) -> {
        let w: Written = mem_create_dir(cell_get(a), p);
        cell_set(a, w.fs);
        w.ok
      },
      fs.write_file[cwd](p, body) -> panic("a path under `abs` is written under `abs`"),
      fs.write_file[abs](p, body) -> {
        let w: Written = mem_write(cell_get(a), p, body);
        cell_set(a, w.fs);
        w.ok
      },
    };
    assert(wrote);
    assert_eq(mem_kind(cell_get(a), "srv/demo"), Dir);
    assert_eq(mem_read(cell_get(a), "srv/demo/ply.pkg"), Some(b"pkg"))
  } }
}

test "a child keeps its directory's root, and the working directory's `.` adds no segment" {
  assert_eq(child({ label: "cwd", path: "." }, "m.ply"), { label: "cwd", path: "m.ply" });
  assert_eq(child({ label: "cwd", path: "app" }, "m.ply"), { label: "cwd", path: "app/m.ply" });
  assert_eq(child({ label: "abs", path: "" }, "m.ply"), { label: "abs", path: "m.ply" });
  assert_eq(displayed(child({ label: "abs", path: "srv/app" }, "m.ply")), "/srv/app/m.ply")
}

/// One disk under `/`, with the working directory at `pwd`, bound as the launcher binds the roots.
fn resolved_at(disk: MemFs, pwd: String, arg: String) -> Resolved / {abort.raise} =
  handle {
    resolve(arg)
  } with {
    env.pwd[sys]() -> pwd,
    fs.resolved[cwd](p) -> mem_resolved(disk, join(pwd.slice(1, pwd.len()), p)),
    fs.resolved[abs](p) -> mem_resolved(disk, p),
  }

fn a_disk() -> MemFs / {abort.raise} =
  mem_of([
    { path: "w/m.ply", body: b"fn m() -> Int = 1" },
    { path: "w/app/main.ply", body: b"fn main() -> Int = 1" },
    { path: "srv/lib/x.ply", body: b"pub fn x() -> Int = 1" },
  ])

test "a file's root is its directory, so a package's own files are beside the file named" {
  let file = resolved_at(a_disk(), "/w", "app/main.ply");
  assert_eq(rooted(file), { label: "cwd", path: "app/main.ply" });
  assert_eq(in_root(file, "ply.lock"), { label: "cwd", path: "app/ply.lock" });
  assert_eq(file.absolute, "/w/app");
  let dir = resolved_at(a_disk(), "/w", "app");
  assert_eq(in_root(dir, "ply.lock"), in_root(file, "ply.lock"));
  assert_eq(dir.absolute, file.absolute);
  // The working directory's own file: its spelling is `.`, which adds no segment.
  assert_eq(in_root(resolved_at(a_disk(), "/w", "m.ply"), "ply.pkg"), {
    label: "cwd",
    path: "ply.pkg",
  });
  let outside = resolved_at(a_disk(), "/w", "../srv/lib/x.ply");
  assert_eq(in_root(outside, "ply.lock"), { label: "abs", path: "srv/lib/ply.lock" });
  assert_eq(displayed(in_root(outside, "ply.lock")), "/srv/lib/ply.lock");
  assert_eq(outside.absolute, "/srv/lib")
}

/// A repository with a nested one, a submodule, a link out of it and a registry slot in a project's
/// cache; a linked worktree; and directories in none.
pub fn checkouts() -> MemFs / {abort.raise} =
  mem_symlink(
    mem_of([
      { path: "repo/.git/HEAD", body: b"ref: refs/heads/main\n" },
      { path: "repo/app/ply.pkg", body: b"" },
      { path: "repo/app/.ply-cache/registry/r/ply.pkg", body: b"" },
      { path: "repo/libs/a/ply.pkg", body: b"" },
      { path: "repo/nested/.git/HEAD", body: b"ref: refs/heads/main\n" },
      { path: "repo/nested/b/ply.pkg", body: b"" },
      { path: "repo/sub/.git", body: b"gitdir: ../.git/modules/sub\n" },
      { path: "repo/sub/c/ply.pkg", body: b"" },
      { path: "repo-b/d/ply.pkg", body: b"" },
      { path: "other/e/ply.pkg", body: b"" },
      { path: "wt/.git", body: b"gitdir: /repo/.git/worktrees/wt\n" },
      { path: "wt/lib/ply.pkg", body: b"" },
    ]),
    "repo/link",
    "../other/e",
  ).fs

test "a checkout is the nearest directory up with a `.git`, a directory or a worktree's file" {
  let found = |dir: String|
    handle { checkout_of(dir) } with { fs.kind[abs](p) -> mem_kind(checkouts(), p) };
  assert_eq(found("/repo/app"), Some("/repo"));
  assert_eq(found("/repo"), Some("/repo"));
  assert_eq(found("/repo/nested/b"), Some("/repo/nested"));
  assert_eq(found("/repo/sub/c"), Some("/repo/sub"));
  assert_eq(found("/wt/lib"), Some("/wt"));
  assert_eq(found("/other/e"), None);
  assert_eq(found("repo/app"), None)
}

test "a directory is part of a checkout below it, and not through a link or another checkout" {
  let part = |tree: String, dir: String|
    handle { in_checkout(tree, dir) } with { fs.kind[abs](p) -> mem_kind(checkouts(), p) };
  assert(part("/repo", "/repo/libs/a"));
  assert(part("/repo", "/repo/libs/a/../../app"));
  // The checkout's own root is part of it.
  assert(part("/repo", "/repo"));
  assert(part("/wt", "/wt/lib"));
  // A sibling whose name only begins like the checkout's.
  assert(!part("/repo", "/repo-b/d"));
  assert(!part("/repo", "/other/e"));
  // Another repository, and a submodule: the outer commit holds neither one's files.
  assert(!part("/repo", "/repo/nested/b"));
  assert(!part("/repo", "/repo/sub/c"));
  // A link: the commit holds the link, and not the tree it points at.
  assert(!part("/repo", "/repo/link"));
  // A name that names nothing.
  assert(!part("/repo", "/repo/gone"))
}

test "a path that names nothing yet is rooted at the nearest directory above it" {
  // `--stamp ../gate` from a subdirectory: a file to write, outside the working directory.
  let gate = resolved_at(a_disk(), "/w/app", "../gate");
  assert_eq(rooted(gate), { label: "abs", path: "w/gate" });
  assert_eq(displayed(rooted(gate)), "/w/gate");
  assert_eq(gate.absolute, "/w");
  assert_eq(gate.display, "/w");
  // `ply new store/orders`: two levels to make, under the working directory.
  let made = resolved_at(a_disk(), "/w", "store/orders");
  assert_eq(rooted(made), { label: "cwd", path: "store/orders" });
  assert_eq(made.absolute, "/w")
}

/// A package with a subdirectory and a package of its own below it, and a directory no package holds.
fn packages() -> MemFs / {abort.raise} =
  mem_of([
    { path: "repo/app/ply.pkg", body: b"" },
    { path: "repo/app/main.ply", body: b"fn main() -> Int = 1" },
    { path: "repo/app/store/orders.ply", body: b"pub fn total() -> Int = 1" },
    { path: "repo/app/tools/ply.pkg", body: b"" },
    { path: "repo/app/tools/gen.ply", body: b"fn main() -> Int = 2" },
    { path: "loose/a.ply", body: b"fn a() -> Int = 1" },
  ])

/// Each root a command's line resolves to over `packages` from `pwd`, with what it names inside.
fn asked_at(
  pwd: String,
  command: String,
  positionals: List<String>,
) -> List<String> / {abort.raise} = {
  let disk = packages();
  let asked = handle {
    resolve_all(command, { path: [command], flags: [], positionals: positionals, argv: [] })
  } with {
    env.pwd[sys]() -> pwd,
    fs.resolved[cwd](p) -> mem_resolved(disk, normalize(join(below_root(pwd), p))),
    fs.resolved[abs](p) -> mem_resolved(disk, p),
  };
  match asked {
    Err(nowhere) -> ["no package holds " ++ nowhere],
    Ok(rs) -> rs.map(|r: Resolved| r.machine ++ " " ++ r.inside),
  }
}

test "a path is in the package that holds it, and stands as it is where none does" {
  // Named from beside it: the root is above the working directory, so the machine spells it whole.
  assert_eq(asked_at("/repo/app/store", "check", ["orders.ply"]), ["/repo/app store/orders.ply"]);
  assert_eq(asked_at("/repo/app", "test", ["store"]), [". store"]);
  assert_eq(asked_at("/repo", "run", ["app/main.ply"]), ["app main.ply"]);
  // A package below another is its own: nothing of it is the outer one's.
  assert_eq(asked_at("/repo/app", "run", ["tools/gen.ply"]), ["tools gen.ply"]);
  assert_eq(asked_at("/repo", "check", ["../loose/a.ply"]), ["/loose a.ply"]);
  assert_eq(asked_at("/loose", "check", ["."]), [". ."])
}

test "a line that names no path is the package the working directory is part of, or none" {
  assert_eq(asked_at("/repo/app/store", "check", []), ["/repo/app ."]);
  assert_eq(asked_at("/repo/app", "doc", ["total"]), [". ."]);
  assert_eq(asked_at("/repo/app/tools", "fmt", []), [". ."]);
  assert_eq(asked_at("/loose", "check", []), ["no package holds /loose"]);
  assert_eq(asked_at("/loose", "doc", ["std.list"]), ["no package holds /loose"]);
  // `ply fmt` rewrites the files it is given, whatever package holds them.
  assert_eq(asked_at("/repo/app", "fmt", ["store"]), ["store ."]);
  assert_eq(asked_at("/loose", "explain", ["E0302"]), [". ."])
}
