// The path a command was given, resolved. The launcher binds `cwd` to the working directory and
// `abs` to the filesystem's root: a path that stays under the working directory is addressed
// under `cwd` as today, and one that leaves it is addressed under `abs`, root-relative, after a
// lexical normalize. The program is the tool, and the tool reads where it is told.

import cmdline
import env (env)
import std.fs (fs, File, Dir, Symlink, Missing)
import std.path (file_name, is_absolute, join, normalize, parent, strip_dot)

// A command's path argument, resolved: the label its fs reads spell, the project root it reports
// and the machine loads by, and the path inside that root (`.` for the whole of it).
pub type Resolved = {
  // `cwd` while the path stays under the working directory, else `abs`.
  label: String,
  // The project root, spelled for the label (`pwd`-relative, or root-relative under `abs`).
  spelling: String,
  // The project root as reports print it: relative to the working directory when it can be.
  display: String,
  inside: String,
  // The absolute path, which the machine's own loads take.
  absolute: String,
  // The spelling the machine loads by: the working-directory spelling while the path stays
  // under it (so the spans a run reports read as given), the absolute form once it leaves.
  machine: String,
}

// The path with `prefix` dropped when it starts with it.
pub fn strip_prefix(path: String, prefix: String) -> Option<String> =
  if path == prefix { Some("") } else if string_starts_with(path, prefix ++ "/") {
    Some(string_slice(path, string_len(prefix) + 1, string_len(path)))
  } else { None }

// What the path names, following a symlink to its target, as the root names it.
fn kind_of(label: String, spelling: String) -> String / {fs.resolved[cwd], fs.resolved[abs]} = {
  let kind = if label == "cwd" { fs.resolved[cwd](spelling) } else { fs.resolved[abs](spelling) };
  match kind { File -> "file", Dir -> "dir", Symlink -> "symlink", Missing -> "missing" }
}

// The nearest directory at or above the path, walking up from a name that names nothing.
fn nearest_dir(label: String, spelling: String) -> String / {fs.resolved[cwd], fs.resolved[abs]} =
  if kind_of(label, spelling) == "dir" { spelling }
  else if spelling == "." || spelling == "" { spelling }
  else { nearest_dir(label, parent(spelling)) }

fn display_of(pwd: String, full: String) -> String =
  match strip_prefix(full, pwd) { Some(rest) -> if rest == "" { "." } else { rest }, None -> full }

pub fn resolve(arg: String) -> Resolved / {fs.resolved[cwd], fs.resolved[abs], env.pwd[sys]} = {
  let pwd = env.pwd[sys]();
  let full = normalize(if is_absolute(strip_dot(arg)) { arg } else { join(pwd, strip_dot(arg)) });
  let (label, spelling) = match strip_prefix(full, pwd) {
    Some(rest) -> ("cwd", if rest == "" { "." } else { rest }),
    None -> ("abs", string_slice(full, 1, string_len(full))),
  };
  // The machine takes the path as given: a file names the one module to load, a directory the
  // walk under it.
  let machine_spelling = if label == "cwd" { spelling } else { full };
  match kind_of(label, spelling) {
    "dir" ->
      {
        label: label,
        spelling: spelling,
        display: display_of(pwd, full),
        inside: ".",
        absolute: full,
        machine: machine_spelling,
      },
    "file" -> {
      let dir = parent(full);
      let (dlabel, dspelling) = match strip_prefix(dir, pwd) {
        Some(rest) -> ("cwd", if rest == "" { "." } else { rest }),
        None -> ("abs", string_slice(dir, 1, string_len(dir))),
      };
      {
        label: dlabel,
        spelling: dspelling,
        display: display_of(pwd, dir),
        inside: file_name(full),
        absolute: full,
        machine: machine_spelling,
      }
    },
    _ -> {
      // Nothing there: the nearest directory above it is rooted, so the program reports the name.
      let dir = nearest_dir(label, spelling);
      {
        label: label,
        spelling: dir,
        display: display_of(pwd, dir),
        inside: match strip_prefix(spelling, dir) { Some(rest) -> rest, None -> spelling },
        absolute: full,
        machine: machine_spelling,
      }
    },
  }
}

// The fs spelling of the whole resolved path (the root's spelling joined with the inside path).
pub fn address(r: Resolved) -> String =
  if r.inside == "." { r.spelling } else { join(r.spelling, r.inside) }

// The prefix a walked path shares with the root it was found under, which the module's name drops.
// The walked path's prefix that module naming drops: the root's own spelling, so a file names
// its stem and a directory's walk names what is under it. `strip_prefix` adds the separator.
pub fn root_prefix(r: Resolved) -> String = if r.spelling == "." { "" } else { r.spelling }

// The path as a report prints it: the working directory's own display form under it, else the
// absolute form.
pub fn shown(r: Resolved, spelling: String) -> String =
  match strip_prefix(spelling, r.spelling) {
    Some(rest) -> if r.display == "." { rest } else { join(r.display, rest) },
    None -> spelling,
  }

// The command's path arguments, each resolved against the working directory. The name a query
// command looks up is not a path; an empty list is the working directory.
pub fn resolve_all(
  command: String,
  p: cmdline::Parsed,
) -> List<Resolved> / {fs.resolved[cwd], fs.resolved[abs], env.pwd[sys]} = {
  let paths = if command == "doc" || command == "show" || command == "callers"
      || command == "replace"
      || command == "explain" { drop_first(p.positionals) } else if command == "cache"
      && cmdline::nth_of(p.path, 1, "") == "inspect" { drop_first(p.positionals) }
  else { p.positionals };
  if len(paths) == 0 { [resolve(".")] } else { map(paths, |path: String| resolve(path)) }
}

// The one the machine loads: the last path argument, resolved.
pub fn path_arg(command: String, p: cmdline::Parsed) -> String =
  match list_at(resolve_all(command, p), 0) { Some(r) -> r.absolute, None -> "." }

fn drop_first(xs: List<String>) -> List<String> = match xs { [] -> [], [_, ..rest] -> rest }

// The working directory, unresolved: what an empty path list means.
pub fn here() -> Resolved =
  { label: "cwd", spelling: ".", display: ".", inside: ".", absolute: ".", machine: "." }

// A path in the working directory, for tests that build one by hand.
pub fn at_cwd(spelling: String) -> Resolved =
  {
    label: "cwd",
    spelling: spelling,
    display: spelling,
    inside: ".",
    absolute: spelling,
    machine: spelling,
  }
