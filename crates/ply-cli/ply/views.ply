//! What a trace's views of the shipped modules say now. A load that read a shipped module for
//! what its program reaches tells the recorder so (`compiler.load.tell_viewed`), and the trace then
//! holds a `shipform` line for the module and a `shipdef` line for each function reached, in place
//! of the whole module. A view stands while its module's text does; where the text moved, while the
//! module's form and each of those functions hash as they did, so a function nothing reached moves
//! nothing. A data file a module embeds is a read of its own in the trace, which no view stands for.

import compiler.front (ShippedView, Shipping, shipped_viewer, shipped_views)
import compiler.resolve (Source)
import compiler.hash (hex)
import compiler.interface (imported)
import compiler.items (builtins_module, prelude_text)
import sources (shipping_for)
import std.fs (fs)
import std.hash (blake3)

pub type Form = { module: Bytes, text: Bytes, form: Bytes }

pub type Reached = { module: Bytes, name: Bytes, hash: Bytes }

pub type Viewed = { forms: List<Form>, defs: List<Reached> }

/// A trace as the recorder reads it again, without its views, and the views.
pub type Split = { rest: Bytes, viewed: Viewed }

pub fn split(trace: Bytes) -> Split = {
  let parted = trace.split(b"\n").fold(
    { rest: [], forms: [], defs: [] },
    |acc: { rest: List<Bytes>, forms: List<Form>, defs: List<Reached> }, line: Bytes|
      match line.split(b"\t") {
        [b"shipform", module, text, form] ->
          { ..acc, forms: acc.forms.push({ module: module, text: text, form: form }) },
        [b"shipdef", module, name, hash] ->
          { ..acc, defs: acc.defs.push({ module: module, name: name, hash: hash }) },
        _ -> if line.len() == 0 { acc } else { { ..acc, rest: acc.rest.push(line).push(b"\n") } },
      },
  );
  { rest: Bytes::concat_all(parted.rest), viewed: { forms: parted.forms, defs: parted.defs } }
}

/// The shipped modules as they stand now, for a set of views: the digest of each named module's text
/// as an importer reads it, none for one this binary does not ship; and each module whose text moved
/// since a view of it, with what it pulls, read whole, or none where reading it whole was refused.
pub type Now = { texts: Map<Bytes, Option<Bytes>>, whole: Option<Map<Bytes, Whole>> }

/// A module read whole: its form and each of its functions' hashes by name.
pub type Whole = { form: Bytes, hashes: Map<Bytes, Bytes> }

/// `read` answers a shipped module's text as a module importing it reads it now, or `None` for one
/// this binary does not ship.
pub fn now_for<| e>(
  viewed: List<Viewed>,
  read: (Bytes) -> Option<Bytes> / e,
) -> Now / {fs.list_dir[shipped], fs.read_file[shipped], abort.raise | e} = {
  let named = viewed.fold(Map::new(), |acc: Map<Bytes, Bool>, v: Viewed|
    v.forms.fold(acc, |a: Map<Bytes, Bool>, f: Form| a.insert(f.module, true)));
  let texts = named.fold(Map::new(), |acc: Map<Bytes, Option<Bytes>>, module: Bytes, b: Bool|
    acc.insert(module, match read(module) { Some(text) -> Some(hex(blake3(text))), None -> None }));
  let moved = viewed.fold(Map::new(), |acc: Map<Bytes, Bool>, v: Viewed|
    v.forms.fold(acc, |a: Map<Bytes, Bool>, f: Form|
      match texts.get(f.module) {
        Some(Some(now)) -> if now == f.text { a } else { a.insert(f.module, true) },
        _ -> a,
      }));
  let modules = moved.keys();
  if modules.len() == 0 { { texts: texts, whole: Some(Map::new()) } } else {
    let shipping = shipping_for([shipped_viewer(modules)], {
      root: b"",
      manifest: None,
      supplied: [],
    });
    {
      texts: texts,
      whole: match shipped_views(modules, shipping.read, shipping.unread, shipping.data) {
        Err(_) -> None,
        Ok(views) ->
          Some(
            views.fold(Map::new(), |acc: Map<Bytes, Whole>, v: ShippedView|
              acc.insert(v.module, {
                form: v.form,
                hashes: v.defs.fold(
                  Map::new(),
                  |h: Map<Bytes, Bytes>, d: { name: Bytes, hash: Bytes }| h.insert(d.name, d.hash),
                ),
              })),
          ),
      },
    }
  }
}

/// What a load read of each shipped module, by name, where it read them as a module importing them
/// does (`reached`); nothing where it read them whole.
pub fn held_texts(shipping: Shipping, reached: Bool) -> Map<Bytes, Bytes> =
  if !reached { Map::new() } else {
    shipping.read.fold(Map::new(), |acc: Map<Bytes, Bytes>, s: Source| acc.insert(s.name, s.src))
  }

/// The shipped module `name` as `held` holds it, or as a module importing it reads it now where
/// `held` holds none of it.
pub fn read_held(
  held: Map<Bytes, Bytes>,
  name: Bytes,
) -> Option<Bytes> / {fs.read_file[shipped], abort.raise} =
  match held.get(name) {
    Some(text) -> Some(text),
    None -> if name == builtins_module() { Some(prelude_text()) } else {
      match fs.read_file[shipped](String::of_bytes_lossy(name) ++ ".ply") {
        Some(text) -> Some(imported(text)),
        None -> None,
      }
    },
  }

/// The views of every trace in `traces`.
pub fn viewed_in(traces: List<Bytes>) -> List<Viewed> = traces.map(|t: Bytes| split(t).viewed)

/// The first view in `viewed` that no longer stands, as a person reads it; `None` when all do.
pub fn moved(now: Now, viewed: Viewed) -> Option<String> = {
  let module = |m: Bytes| Some("the shipped module `" ++ String::of_bytes_lossy(m) ++ "`");
  // Each module whose text stands, and each whose text moved but whose form stands, read whole.
  let held = viewed.forms.fold(
    { why: None, same: Map::new(), read: Map::new() },
    |acc: { why: Option<String>, same: Map<Bytes, Bool>, read: Map<Bytes, Whole> }, f: Form|
      if acc.why != None { acc } else {
        match now.texts.get(f.module) {
          Some(Some(text)) -> if text == f.text { { ..acc, same: acc.same.insert(f.module, true) } }
          else {
            match match now.whole { Some(whole) -> whole.get(f.module), None -> None } {
              Some(w) -> if w.form == f.form { { ..acc, read: acc.read.insert(f.module, w) } }
              else { { ..acc, why: module(f.module) } },
              None -> { ..acc, why: module(f.module) },
            }
          },
          _ -> { ..acc, why: module(f.module) },
        }
      },
  );
  if held.why != None { held.why } else {
    viewed.defs.fold(None, |acc: Option<String>, d: Reached|
      if acc != None { acc } else {
        match held.read.get(d.module) {
          Some(w) -> if w.hashes.get(d.name) == Some(d.hash) { None }
          else { Some("the shipped definition `" ++ String::of_bytes_lossy(d.name) ++ "`") },
          None -> if held.same.contains(d.module) { None } else { module(d.module) },
        }
      })
  }
}

// --- Tests ------------------------------------------------------------------

test "a trace's views are split from the reads the recorder holds" {
  let s = split(
    b"file\tcwd\ta.ply\t\tabc\nshipform\tstd.list\tt1\tf1\nshipdef\tstd.list\tstd.list.take\th1\nshipped\t\td0\n",
  );
  assert_eq(s.rest, b"file\tcwd\ta.ply\t\tabc\nshipped\t\td0\n");
  assert_eq(s.viewed.forms, [{ module: b"std.list", text: b"t1", form: b"f1" }]);
  assert_eq(s.viewed.defs, [{ module: b"std.list", name: b"std.list.take", hash: b"h1" }])
}

test "a view stands while its text does, and otherwise while its form and functions do" {
  let viewed = {
    forms: [{ module: b"std.list", text: b"t1", form: b"f1" }],
    defs: [{ module: b"std.list", name: b"std.list.take", hash: b"h1" }],
  };
  let whole = |form: Bytes, defs: List<{ name: Bytes, hash: Bytes }>|
    Some(
      Map::new().insert(b"std.list", {
        form: form,
        hashes: defs.fold(Map::new(), |h: Map<Bytes, Bytes>, d: { name: Bytes, hash: Bytes }|
          h.insert(d.name, d.hash)),
      }),
    );
  let texts = |t: Option<Bytes>| Map::new().insert(b"std.list", t);
  assert_eq(moved({ texts: texts(Some(b"t1")), whole: None }, viewed), None);
  let added = whole(b"f1", [
    { name: b"std.list.take", hash: b"h1" },
    { name: b"std.list.later", hash: b"h9" },
  ]);
  assert_eq(moved({ texts: texts(Some(b"t2")), whole: added }, viewed), None);
  assert_eq(
    moved(
      { texts: texts(Some(b"t2")), whole: whole(b"f1", [{ name: b"std.list.take", hash: b"h2" }]) },
      viewed,
    ),
    Some("the shipped definition `std.list.take`"),
  );
  assert_eq(
    moved(
      { texts: texts(Some(b"t2")), whole: whole(b"f2", [{ name: b"std.list.take", hash: b"h1" }]) },
      viewed,
    ),
    Some("the shipped module `std.list`"),
  );
  assert_eq(
    moved({ texts: texts(None), whole: Some(Map::new()) }, viewed),
    Some("the shipped module `std.list`"),
  );
  assert_eq(
    moved({ texts: texts(Some(b"t2")), whole: None }, viewed),
    Some("the shipped module `std.list`"),
  );
  // A function whose module the view gives no form for holds nothing.
  assert_eq(
    moved({ texts: texts(Some(b"t1")), whole: None }, { ..viewed, forms: [] }),
    Some("the shipped module `std.list`"),
  )
}
