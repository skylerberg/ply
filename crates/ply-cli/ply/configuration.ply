// A run's configuration, resolved before anything is bound: `--set`, then `--config` files, then
// the environment, then the schema's defaults, checked against the `ConfigSpec` the target's own
// unit evaluated. A binding is handed what this resolves and answers `config.get` and
// `config.secret` from it; everything a run says about its configuration is said here.

import compiler.resolve (Diag, error_at)
import entry (no_module)
import env (env)
import machine (ConfigOptions, Configured)
import paths
import report (count_of, plural)
import std.config (Key, Shape, SText, SInt, SBool, SSecret)
import std.fs (fs)
import std.json (Json, Null, Str, Bool, Number, Array, object, to_string)
import std.list (sort)
import std.string (int_of_string, lines, split_once, join, code_points, of_code_points)
import std.value (Value, VRecord, VList, VStr, VCtor, VBool, Field)

// Which source supplied a value, highest precedence first. A file is named as the line wrote it.
pub type Source = | BySet | ByFile(String) | ByEnvironment | ByDefault

pub type Supplied = { value: String, source: Source }

// Every key any source supplied with the source that won, and how much was read: the `--set`
// arguments, the `--config` files and the environment's variables.
pub type Sources = {
  supplied: Map<String, Supplied>,
  sets: Int,
  files: List<String>,
  environment: Int,
}

pub type Resolved = { value: String, source: Source, shape: Option<Shape> }

// The named schema function and what it declares, in its own order.
pub type Schema = { function: String, keys: List<Key> }

// What a run resolved: every key a source supplied or a default filled, with the shape the schema
// declared for it, or none for a key no schema mentions.
pub type Configuration = {
  values: Map<String, Resolved>,
  schema: Option<Schema>,
  sets: Int,
  files: List<String>,
  environment: Int,
}

pub type Resolution = { configuration: Configuration, warnings: List<Diag> }

// What a run with no `--host` holds: nothing, whatever the environment has.
pub fn unopened() -> Configuration =
  { values: map_new(), schema: None, sets: 0, files: [], environment: 0 }

// Whether any source was read: a run that read none discloses no configuration.
pub fn opened(configuration: Configuration) -> Bool =
  configuration.schema != None || configuration.environment > 0 || configuration.sets > 0
    || len(configuration.files) > 0

// --- Words ------------------------------------------------------------------

pub fn shape_word(s: Shape) -> String =
  match s { SText -> "SText", SInt -> "SInt", SBool -> "SBool", SSecret -> "SSecret" }

// As a report's `source` column prints it.
pub fn source_word(source: Source) -> String =
  match source {
    BySet -> "--set",
    ByFile(path) -> path,
    ByEnvironment -> "env",
    ByDefault -> "default",
  }

// As a diagnostic names it.
fn source_text(source: Source) -> String =
  match source {
    BySet -> "--set",
    ByFile(path) -> "--config " ++ path,
    ByEnvironment -> "the process environment",
    ByDefault -> "the schema's default",
  }

fn is_explicit(source: Source) -> Bool =
  match source { BySet -> true, ByFile(_) -> true, _ -> false }

fn is_secret(shape: Option<Shape>) -> Bool = shape == Some(SSecret)

pub fn redacted() -> String = "****"

// --- Reading the sources ----------------------------------------------------

fn error(code: Bytes, message: String, label: String, notes: List<String>) -> Diag =
  error_at(
    code,
    no_module(),
    { start: 0, end: 0 },
    bytes_of_string(message),
    bytes_of_string(label),
    map(notes, bytes_of_string),
  )

fn unavailable(message: String, label: String, notes: List<String>) -> Diag =
  error(b"E0440", message, label, notes)

fn is_letter(c: Int) -> Bool = (c >= 65 && c <= 90) || (c >= 97 && c <= 122)

fn is_digit(c: Int) -> Bool = c >= 48 && c <= 57

fn char_of(c: Int) -> String = match of_code_points([c]) { Some(t) -> t, None -> "?" }

// A key is an identifier extended with `.`, in every source alike.
fn key_refusal(key: String) -> Option<String> =
  match code_points(key) {
    [] -> Some("it has an empty key"),
    [first, ..rest] -> if !(is_letter(first) || first == 95) {
      Some(
        "`" ++ key ++ "` starts with `" ++ char_of(first)
          ++ "`, and a key starts with a letter or `_`",
      )
    } else {
      match filter(rest, |c: Int| !(is_letter(c) || is_digit(c) || c == 95 || c == 46)) {
        [] -> None,
        [bad, ..others] ->
          Some(
            "`" ++ key ++ "` contains `" ++ char_of(bad)
              ++ "`, and a key is letters, digits, `_` and `.`",
          ),
      }
    },
  }

// `text` without the ASCII bytes `drop` names at either end.
fn trimmed(text: String, drop: List<Int>) -> String = {
  let b = bytes_of_string(text);
  let dropped = |i: Int| fold(drop, false, |hit: Bool, d: Int| hit || bytes_at(b, i) == d);
  let start = iterate(0, bytes_len(b) + 1, |i: Int|
    if i < bytes_len(b) && dropped(i) { Continue(i + 1) } else { Stop(i) });
  let end = iterate(bytes_len(b), bytes_len(b) + 1, |j: Int|
    if j > start && dropped(j - 1) { Continue(j - 1) } else { Stop(j) });
  string_of_bytes(bytes_slice(b, start, end))
}

fn blanks() -> List<Int> = [32, 9]

// One `KEY=VALUE` line, or `None` for a blank line or a comment.
fn parsed_line(line: String) -> Result<Option<{ key: String, value: String }>, String> = {
  let t = trimmed(line, [32, 9, 13]);
  if t == "" || string_starts_with(t, "#") { Ok(None) } else {
    match split_once(t, "=") {
      None -> Err("it has no `=`"),
      Some(cut) -> {
        let key = trimmed(cut.head, blanks());
        match key_refusal(key) {
          Some(why) -> Err(why),
          None -> Ok(Some({ key: key, value: trimmed(cut.tail, blanks()) })),
        }
      },
    }
  }
}

fn unreadable(path: String, why: Option<String>) -> Diag =
  unavailable(
    "`--config " ++ path ++ "` could not be read"
      ++ (match why { Some(w) -> ": " ++ w, None -> "" }),
    "this file is the run's configuration",
    [
      "the file is `KEY=VALUE`, one per line, with `#` comments and no quoting",
      "correct the path, or drop the `--config` and supply the keys with `--set KEY=VALUE`",
    ],
  )

fn bad_line(path: String, number: Int, line: String, why: String) -> Diag =
  unavailable(
    "`" ++ path ++ "` line " ++ int_to_string(number) ++ " is not `KEY=VALUE`: " ++ why,
    "this line is the run's configuration",
    [
      "the line reads `" ++ trimmed(line, [32, 9, 13, 10]) ++ "`",
      "a key is letters, digits, `_` and `.`, starting with a letter or `_`; the value is the rest of the line",
      "a whole-line `#` is a comment; a `#` after the `=` is part of the value, because there is no quoting to escape it with",
    ],
  )

fn bad_set(argument: String, why: String) -> Diag =
  unavailable(
    "`--set " ++ argument ++ "` is not `KEY=VALUE`: " ++ why,
    "this argument is the run's configuration",
    ["write `--set KEY=VALUE`, once per key; the last `--set` of a key wins"],
  )

// A `--config` file as the run read it: its path as the line wrote it, and its bytes when it read.
pub type Read = { path: String, text: Option<Bytes> }

type Gathered = { supplied: Map<String, Supplied>, diags: List<Diag> }

fn filed(gathered: Gathered, f: Read) -> Gathered =
  match f.text {
    None -> { ..gathered, diags: push(gathered.diags, unreadable(f.path, None)) },
    Some(b) -> if !bytes_is_utf8(b) {
      { ..gathered, diags: push(gathered.diags, unreadable(f.path, Some("it is not UTF-8"))) }
    } else {
      let ls = lines(string_of_bytes(b));
      fold(range(0, len(ls)), gathered, |acc: Gathered, i: Int| {
        let line = match list_at(ls, i) { Some(l) -> l, None -> "" };
        match parsed_line(line) {
          Ok(None) -> acc,
          Ok(Some(kv)) ->
            {
              ..acc,
              supplied: map_insert(acc.supplied, kv.key, {
                value: kv.value,
                source: ByFile(f.path),
              }),
            },
          Err(why) -> { ..acc, diags: push(acc.diags, bad_line(f.path, i + 1, line, why)) },
        }
      })
    },
  }

// `--set`, then `--config`, then the environment, read once; lowest precedence first, so the last
// write for a key wins and records its source.
pub fn sources_of(
  sets: List<String>,
  files: List<Read>,
  environment: List<{ name: String, value: String }>,
) -> Result<Sources, List<Diag>> = {
  let from_env = fold(
    environment,
    map_new(),
    |m: Map<String, Supplied>, v: { name: String, value: String }|
      if key_refusal(v.name) == None {
        map_insert(m, v.name, { value: v.value, source: ByEnvironment })
      } else { m },
  );
  let from_files = fold(files, { supplied: from_env, diags: [] }, filed);
  let all = fold(sets, from_files, |acc: Gathered, argument: String|
    match parsed_line(argument) {
      Ok(Some(kv)) ->
        { ..acc, supplied: map_insert(acc.supplied, kv.key, { value: kv.value, source: BySet }) },
      // A `--set` was typed on purpose, so a blank or comment is a mistake here.
      Ok(None) -> { ..acc, diags: push(acc.diags, bad_set(argument, "it supplies no key")) },
      Err(why) -> { ..acc, diags: push(acc.diags, bad_set(argument, why)) },
    });
  if len(all.diags) > 0 { Err(all.diags) } else {
    Ok({
      supplied: all.supplied,
      sets: len(sets),
      files: map(files, |f: Read| f.path),
      environment: len(environment),
    })
  }
}

// --- The schema -------------------------------------------------------------

fn malformed(function: String, why: String) -> Diag =
  unavailable(
    "`--config-schema " ++ function ++ "` returned something that is not a `ConfigSpec`: " ++ why,
    "this value decides what the run requires of its configuration",
    [
      "a `ConfigSpec` is `{keys: List<Key>}`, and a `Key` is `{name, shape, required, default}`",
      "build it with `std.config`'s `spec`, `required`, `optional` and `with_default`",
    ],
  )

fn field(fields: List<Field>, name: String) -> Option<Value> =
  fold(fields, None, |found: Option<Value>, f: Field|
    match found { Some(_) -> found, None -> if f.name == name { Some(f.value) } else { None } })

fn shape_of(ctor: String) -> Option<Shape> =
  if ctor == "std.config.SText" { Some(SText) }
  else if ctor == "std.config.SInt" { Some(SInt) }
  else if ctor == "std.config.SBool" { Some(SBool) }
  else if ctor == "std.config.SSecret" { Some(SSecret) }
  else { None }

fn key_of(value: Value, function: String) -> Result<Key, Diag> =
  match value {
    VRecord(fields) -> match field(fields, "name") {
      Some(VStr(name)) -> match field(fields, "shape") {
        Some(VCtor(ctor, _)) -> match shape_of(ctor) {
          None ->
            Err(
              malformed(
                function,
                "`" ++ name ++ "` has the shape `" ++ ctor
                  ++ "`, which is not one of `std.config`'s",
              ),
            ),
          Some(shape) -> match field(fields, "required") {
            Some(VBool(required)) -> match field(fields, "default") {
              Some(VCtor("None", [])) ->
                Ok({ name: name, shape: shape, required: required, default: None }),
              Some(VCtor("Some", [VStr(text)])) ->
                Ok({ name: name, shape: shape, required: required, default: Some(text) }),
              Some(VCtor("Some", _)) ->
                Err(malformed(function, "`" ++ name ++ "`'s default is not a string")),
              _ -> Err(malformed(function, "`" ++ name ++ "` has no `default`")),
            },
            _ -> Err(malformed(function, "`" ++ name ++ "` has no `required` flag")),
          },
        },
        _ -> Err(malformed(function, "`" ++ name ++ "` has no `shape`")),
      },
      _ -> Err(malformed(function, "a key has no `name` string")),
    },
    _ -> Err(malformed(function, "a key in `keys` is not a record")),
  }

fn twice(name: String) -> Diag =
  unavailable(
    "the configuration schema declares `" ++ name ++ "` twice",
    "a key is declared once or the run cannot resolve it",
    [
      "two declarations of one key may disagree about its shape, and which one applied would depend on the order the schema function built its list in",
      "remove the duplicate from the `ConfigSpec`",
    ],
  )

fn declared_once(keys: List<Key>) -> Option<Diag> = {
  let walked = fold(
    keys,
    { seen: map_new(), dup: None },
    |acc: { seen: Map<String, Bool>, dup: Option<String> }, k: Key|
      match acc.dup {
        Some(_) -> acc,
        None -> if map_contains(acc.seen, k.name) { { ..acc, dup: Some(k.name) } }
        else { { ..acc, seen: map_insert(acc.seen, k.name, true) } },
      },
  );
  match walked.dup { Some(name) -> Some(twice(name)), None -> None }
}

// `{ keys: List<Key> }`, checked on the value: a partial read would drop a required key.
pub fn schema_of(value: Value, function: String) -> Result<Schema, Diag> =
  match value {
    VRecord(fields) -> match field(fields, "keys") {
      Some(VList(items)) -> {
        let keys = fold(items, Ok([]), |acc: Result<List<Key>, Diag>, item: Value|
          match acc {
            Err(d) -> Err(d),
            Ok(done) -> match key_of(item, function) {
              Ok(k) -> Ok(push(done, k)),
              Err(d) -> Err(d),
            },
          });
        match keys {
          Err(d) -> Err(d),
          Ok(ks) -> match declared_once(ks) {
            Some(d) -> Err(d),
            None -> Ok({ function: function, keys: ks }),
          },
        }
      },
      _ -> Err(malformed(function, "it has no `keys` list")),
    },
    _ -> Err(malformed(function, "it is not a record")),
  }

// --- Resolving --------------------------------------------------------------

// Why a value is not of its shape, or `None` when it is. An `Int` is what `int_of_string` reads.
fn shape_refusal(shape: Shape, value: String) -> Option<String> =
  match shape {
    SText -> None,
    SInt -> match int_of_string(value) { Some(_) -> None, None -> Some("is not an `Int`") },
    SBool -> if value == "true" || value == "false" { None }
    else { Some("is neither `true` nor `false`") },
    SSecret -> if value == "" { Some("is empty, and an empty credential is an unset one") }
    else { None },
  }

fn missing(k: Key, s: Sources) -> Diag = {
  let files = if len(s.files) == 0 { "no `--config` file" } else {
    "the `--config` " ++ plural(len(s.files), "file") ++ " "
      ++ join(map(s.files, |f: String| "`" ++ f ++ "`"), ", ")
  };
  error(
    b"E0441",
    "the configuration schema requires `" ++ k.name ++ "` (`" ++ shape_word(k.shape)
      ++ "`) and nothing supplies it",
    "this key is the run's configuration",
    [
      "the run looked in: " ++ int_to_string(s.sets) ++ " `--set` " ++ plural(s.sets, "argument")
        ++ ", "
        ++ files
        ++ ", "
        ++ int_to_string(s.environment)
        ++ " environment "
        ++ plural(s.environment, "variable")
        ++ ", and the schema's own default",
      "supply it with `--set " ++ k.name ++ "=...`, put it in a `--config` file, or export it",
      "this is refused before anything is bound: a service that discovers a key is missing on its first request has already told a client it was listening",
    ],
  )
}

fn invalid(k: Key, r: Resolved, why: String) -> Diag =
  error(
    b"E0442",
    "`" ++ k.name ++ "` is declared `" ++ shape_word(k.shape) ++ "` and " ++ source_text(r.source)
      ++ " supplied a value that "
      ++ why,
    "this value is the run's configuration",
    [
      if k.shape == SSecret {
        "the value is not printed, because a diagnostic's message reaches stderr, `--json` and a cached failure report"
      } else { "the value is `" ++ r.value ++ "`" },
      "change what " ++ source_text(r.source) ++ " supplies, or declare `" ++ k.name
        ++ "` with a shape it satisfies",
    ],
  )

fn undeclared(key: String, source: Source, schema: Schema) -> Diag = {
  let names = sort(map(schema.keys, |k: Key| k.name));
  let declared = if len(names) == 0 { "the schema declares no keys at all" }
  else { "the schema declares: " ++ join(names, ", ") };
  let d = error(
    b"W0607",
    source_text(source) ++ " supplies `" ++ key
      ++ "`, which the configuration schema does not declare",
    "nothing in this program reads this key",
    [
      declared,
      "only `--set` and `--config` are checked: an environment is full of names that have nothing to do with this program",
    ],
  );
  { ..d, severity: b"warning" }
}

type Walk = { values: Map<String, Resolved>, diags: List<Diag> }

fn checked(acc: Walk, s: Sources, k: Key) -> Walk = {
  let found: Option<Resolved> = match map_get(s.supplied, k.name) {
    Some(sup) -> Some({ value: sup.value, source: sup.source, shape: Some(k.shape) }),
    None -> match k.default {
      Some(d) -> Some({ value: d, source: ByDefault, shape: Some(k.shape) }),
      None -> None,
    },
  };
  match found {
    None -> if k.required { { ..acc, diags: push(acc.diags, missing(k, s)) } } else { acc },
    Some(r) -> match shape_refusal(k.shape, r.value) {
      Some(why) -> { ..acc, diags: push(acc.diags, invalid(k, r, why)) },
      None -> { ..acc, values: map_insert(acc.values, k.name, r) },
    },
  }
}

// Every source's keys, then the schema's checked against them: every missing and invalid key is
// reported at once, and a key an explicit source supplied that the schema does not declare warns.
pub fn resolved(s: Sources, schema: Option<Schema>) -> Result<Resolution, List<Diag>> = {
  let supplied = map_fold(
    s.supplied,
    map_new(),
    |m: Map<String, Resolved>, key: String, sup: Supplied|
      map_insert(m, key, { value: sup.value, source: sup.source, shape: None }),
  );
  let walked = match schema {
    None -> { values: supplied, diags: [] },
    Some(sc) ->
      fold(sc.keys, { values: supplied, diags: [] }, |acc: Walk, k: Key| checked(acc, s, k)),
  };
  let warnings = match schema {
    None -> [],
    Some(sc) -> {
      let declared = fold(sc.keys, map_new(), |m: Map<String, Bool>, k: Key|
        map_insert(m, k.name, true));
      map_fold(s.supplied, [], |diags: List<Diag>, key: String, sup: Supplied|
        if is_explicit(sup.source) && !map_contains(declared, key) {
          push(diags, undeclared(key, sup.source, sc))
        } else { diags })
    },
  };
  if len(walked.diags) > 0 { Err(walked.diags) } else {
    Ok({
      configuration: {
        values: walked.values,
        schema: schema,
        sets: s.sets,
        files: s.files,
        environment: s.environment,
      },
      warnings: warnings,
    })
  }
}

// What the command's configuration flags come to: nothing without `--host`; otherwise every source,
// read once, checked against the schema `evaluated` enters on the target's own unit.
pub fn opened_by<| e>(
  host: Bool,
  flags: ConfigOptions,
  evaluated: (String) -> Result<Value, List<Diag>> / e,
) -> Result<Resolution, List<Diag>> / {env.vars[sys], env.pwd[sys], fs.resolved[cwd], fs.resolved[abs], fs.read_file[cwd], fs.read_file[abs] | e} =
  if !host { Ok({ configuration: unopened(), warnings: [] }) } else {
    let files = map(flags.files, |path: String|
      { path: path, text: paths::read_file(paths::rooted(paths::resolve(path))) });
    match sources_of(flags.set, files, env.vars[sys]()) {
      Err(diags) -> Err(diags),
      Ok(sources) -> match flags.schema {
        None -> resolved(sources, None),
        Some(function) -> match evaluated(function) {
          Err(diags) -> Err(diags),
          Ok(v) -> match schema_of(v, function) {
            Err(d) -> Err([d]),
            Ok(schema) -> resolved(sources, Some(schema)),
          },
        },
      },
    }
  }

// --- What a binding is handed -----------------------------------------------

pub fn configured(configuration: Configuration) -> Configured =
  {
    values: map_fold(
      configuration.values,
      [],
      |acc: List<{ key: String, value: String, secret: Bool }>, key: String, r: Resolved|
        push(acc, { key: key, value: r.value, secret: is_secret(r.shape) }),
    ),
    schema: match configuration.schema {
      None -> None,
      Some(sc) ->
        Some({
          function: sc.function,
          keys: map(sc.keys, |k: Key| { name: k.name, shape: shape_word(k.shape) }),
        }),
    },
    opened: opened(configuration),
  }

// --- What a run says about it -----------------------------------------------

pub type ReportKey = { name: String, value: String, source: String, secret: Bool }

pub type KeyShape = { name: String, shape: String }

pub type ReportSchema = { function: String, keys: List<KeyShape> }

// The configuration as a report shows it: the sources read, the schema, and every declared key the
// run resolved with the source that won, a secret's value never.
pub type Report = {
  sets: Int,
  files: List<String>,
  environment: Int,
  defaults: Int,
  schema: Option<ReportSchema>,
  resolved: Int,
  secret: Int,
  keys: List<ReportKey>,
}

pub fn report(configuration: Configuration) -> Report = {
  let declared = map_fold(
    configuration.values,
    [],
    |acc: List<ReportKey>, key: String, r: Resolved|
      match r.shape {
        None -> acc,
        Some(shape) ->
          push(acc, {
            name: key,
            value: if shape == SSecret { redacted() } else { r.value },
            source: source_word(r.source),
            secret: shape == SSecret,
          }),
      },
  );
  {
    sets: configuration.sets,
    files: configuration.files,
    environment: configuration.environment,
    defaults: len(filter(declared, |k: ReportKey| k.source == "default")),
    schema: match configuration.schema {
      None -> None,
      Some(sc) ->
        Some({
          function: sc.function,
          keys: map(sc.keys, |k: Key| { name: k.name, shape: shape_word(k.shape) }),
        }),
    },
    resolved: len(declared),
    secret: len(filter(declared, |k: ReportKey| k.secret)),
    keys: declared,
  }
}

// The one line a run's start-up banner carries, when it read any source: the declared keys it
// resolved, counted by the source that won.
pub fn banner(configuration: Configuration) -> String = {
  let won = map_fold(configuration.values, [], |acc: List<Resolved>, key: String, r: Resolved|
    if r.shape == None { acc } else { push(acc, r) });
  let counted = |hit: (Source) -> Bool| len(filter(won, |r: Resolved| hit(r.source)));
  let parts = fold(
    [
      { n: counted(|source: Source| source == ByEnvironment), what: "environment" },
      { n: counted(|source: Source| source == BySet), what: "--set" },
      {
        n: counted(|source: Source| match source { ByFile(_) -> true, _ -> false }),
        what: "--config",
      },
      { n: counted(|source: Source| source == ByDefault), what: "default" },
    ],
    [count_of(len(won), "key")],
    |acc: List<String>, p: { n: Int, what: String }|
      if p.n > 0 { push(acc, int_to_string(p.n) ++ " " ++ p.what) } else { acc },
  );
  let secrets = len(filter(won, |r: Resolved| is_secret(r.shape)));
  join(
    if secrets > 0 { push(parts, count_of(secrets, "secret") ++ " (values not shown)") }
    else { parts },
    " · ",
  )
}

fn num(n: Int) -> Json = Number(decimal_of_int(n))

pub fn report_json(r: Report) -> Json =
  object([
    {
      key: "sources",
      value: object([
        { key: "set", value: num(r.sets) },
        { key: "files", value: Array(map(r.files, |f: String| Str(f))) },
        { key: "environment", value: num(r.environment) },
      ]),
    },
    {
      key: "schema",
      value: match r.schema {
        None -> Null,
        Some(v) ->
          object([
            { key: "function", value: Str(v.function) },
            {
              key: "keys",
              value: Array(
                map(v.keys, |k: KeyShape|
                  object([
                    { key: "name", value: Str(k.name) },
                    { key: "shape", value: Str(k.shape) },
                  ])),
              ),
            },
          ]),
      },
    },
    { key: "resolved", value: num(r.resolved) },
    { key: "secret", value: num(r.secret) },
    {
      key: "keys",
      value: Array(
        map(r.keys, |k: ReportKey|
          object([
            { key: "name", value: Str(k.name) },
            { key: "value", value: Str(k.value) },
            { key: "source", value: Str(k.source) },
            { key: "secret", value: Bool(k.secret) },
          ])),
      ),
    },
  ])

// --- Tests ------------------------------------------------------------------

fn file(path: String, text: String) -> Read = { path: path, text: Some(bytes_of_string(text)) }

fn var(name: String, value: String) -> { name: String, value: String } =
  { name: name, value: value }

fn read_ok(
  sets: List<String>,
  files: List<Read>,
  environment: List<{ name: String, value: String }>,
) -> Sources =
  match sources_of(sets, files, environment) { Ok(s) -> s, Err(_) -> panic("the sources read") }

fn read_err(
  sets: List<String>,
  files: List<Read>,
  environment: List<{ name: String, value: String }>,
) -> List<Diag> =
  match sources_of(sets, files, environment) {
    Ok(_) -> panic("a source was refused"),
    Err(ds) -> ds,
  }

fn spec_of(keys: List<Key>) -> Option<Schema> = Some({ function: "m.spec", keys: keys })

fn resolved_ok(s: Sources, schema: Option<Schema>) -> Resolution =
  match resolved(s, schema) { Ok(r) -> r, Err(_) -> panic("the configuration resolves") }

fn resolved_err(s: Sources, schema: Option<Schema>) -> List<Diag> =
  match resolved(s, schema) { Ok(_) -> panic("the configuration was refused"), Err(ds) -> ds }

fn value_of(resolution: Resolution, key: String) -> Option<String> =
  match map_get(resolution.configuration.values, key) { Some(v) -> Some(v.value), None -> None }

fn source_of(resolution: Resolution, key: String) -> Option<Source> =
  match map_get(resolution.configuration.values, key) { Some(v) -> Some(v.source), None -> None }

fn codes(diags: List<Diag>) -> List<Bytes> = map(diags, |diag: Diag| diag.code)

fn rendered(diag: Diag) -> String =
  string_of_bytes_lossy(diag.message) ++ " "
    ++ join(map(diag.notes_text, |n: Bytes| string_of_bytes_lossy(n)), " ")

fn says(diag: Diag, text: String) -> Bool = string_contains(rendered(diag), text)

fn first(ds: List<Diag>) -> Diag =
  match list_at(ds, 0) { Some(d) -> d, None -> panic("a diagnostic was raised") }

fn key(name: String, shape: Shape) -> Key =
  { name: name, shape: shape, required: false, default: None }

fn needed(name: String, shape: Shape) -> Key = { ..key(name, shape), required: true }

test "precedence walks down as sources are removed: --set, then a file, then the environment" {
  let schema = spec_of([{ ..key("DESK_REGION", SText), default: Some("default") }]);
  let tree = [file("deploy.env", "DESK_REGION=file\n")];
  let env = [var("DESK_REGION", "environment")];
  let all = resolved_ok(read_ok(["DESK_REGION=set"], tree, env), schema);
  assert_eq(value_of(all, "DESK_REGION"), Some("set"));
  assert_eq(source_of(all, "DESK_REGION"), Some(BySet));
  let no_set = resolved_ok(read_ok([], tree, env), schema);
  assert_eq(value_of(no_set, "DESK_REGION"), Some("file"));
  assert_eq(source_of(no_set, "DESK_REGION"), Some(ByFile("deploy.env")));
  let no_files = resolved_ok(read_ok([], [], env), schema);
  assert_eq(source_of(no_files, "DESK_REGION"), Some(ByEnvironment));
  let nothing = resolved_ok(read_ok([], [], []), schema);
  assert_eq(value_of(nothing, "DESK_REGION"), Some("default"));
  assert_eq(source_of(nothing, "DESK_REGION"), Some(ByDefault))
}

test "a later file wins over an earlier one, and the last --set of a key wins" {
  let files = resolved_ok(
    read_ok(
      [],
      [
        file("base.env", "DESK_REGION=eu\nDESK_PORT=8137\n"),
        file("override.env", "DESK_REGION=us\n"),
      ],
      [],
    ),
    None,
  );
  assert_eq(value_of(files, "DESK_REGION"), Some("us"));
  assert_eq(value_of(files, "DESK_PORT"), Some("8137"));
  assert_eq(
    value_of(resolved_ok(read_ok(["K=first", "K=second"], [], []), None), "K"),
    Some("second"),
  )
}

test "a malformed file names the file, the line and what is wrong with it" {
  let ds = read_err(
    [],
    [file("deploy.env", "DESK_REGION=eu\nthis line has no equals\n=empty\nDESK-PORT=8137\n")],
    [],
  );
  assert_eq(codes(ds), [b"E0440", b"E0440", b"E0440"]);
  let at = |i: Int| match list_at(ds, i) { Some(d) -> d, None -> panic("three were raised") };
  assert(says(at(0), "`deploy.env` line 2 is not `KEY=VALUE`: it has no `=`"));
  assert(says(at(1), "line 3") && says(at(1), "empty key"));
  assert(says(at(2), "line 4") && says(at(2), "contains `-`"))
}

test "a file that will not read, or is not text, is E0440 naming it" {
  let missing = first(read_err([], [{ path: "missing.env", text: None }], []));
  assert_eq(missing.code, b"E0440");
  assert(says(missing, "`--config missing.env` could not be read"));
  let binary = first(read_err([], [{ path: "blob.env", text: Some(b"\xff\xfe") }], []));
  assert(says(binary, "it is not UTF-8"))
}

test "a --set that is not KEY=VALUE is E0440 and says what to write" {
  let bad = ["DESK_PORT", "=8137", "1DESK=8137", "", "# a comment"];
  assert_eq(map(bad, |b: String| codes(read_err([b], [], []))), map(bad, |b: String| [b"E0440"]));
  assert(
    fold(bad, true, |ok: Bool, b: String|
      ok && says(first(read_err([b], [], [])), "write `--set KEY=VALUE`")),
  )
}

// There is no quoting to escape a `#` with, so a password containing one must survive.
test "comments are whole lines, a hash in a value survives, and blanks around either side go" {
  let r = resolved_ok(
    read_ok(
      [],
      [
        file(
          "deploy.env",
          "# a comment\n\n   # an indented comment\nDESK_REGION = eu \nDESK_KEY=pa#ss\n\t\r\n",
        ),
      ],
      [],
    ),
    None,
  );
  assert_eq(value_of(r, "DESK_REGION"), Some("eu"));
  assert_eq(value_of(r, "DESK_KEY"), Some("pa#ss"))
}

test "the value is the rest of the line, and an empty value is a value" {
  assert_eq(
    value_of(resolved_ok(read_ok(["DESK_DSN=a=b=c"], [], []), None), "DESK_DSN"),
    Some("a=b=c"),
  );
  assert_eq(value_of(resolved_ok(read_ok(["DESK_REGION="], [], []), None), "DESK_REGION"), Some(""))
}

// Refusing would fail a `--host` run on any machine with an exported shell function.
test "an environment name that is not a key is skipped rather than refused" {
  let r = resolved_ok(
    read_ok([], [], [var("BASH_FUNC_x%%", "() { :; }"), var("DESK_REGION", "eu")]),
    None,
  );
  assert_eq(value_of(r, "DESK_REGION"), Some("eu"));
  assert_eq(value_of(r, "BASH_FUNC_x%%"), None)
}

test "a required key nothing supplies is E0441 naming every place the run looked" {
  let d = first(
    resolved_err(
      read_ok([], [file("deploy.env", "")], [var("PATH", "/bin")]),
      spec_of([needed("DESK_API_KEY", SSecret)]),
    ),
  );
  assert_eq(d.code, b"E0441");
  assert(says(d, "requires `DESK_API_KEY` (`SSecret`) and nothing supplies it"));
  assert(
    says(
      d,
      "the run looked in: 0 `--set` arguments, the `--config` file `deploy.env`, 1 environment variable, and the schema's own default",
    ),
  )
}

test "a required key with a default is supplied by the default" {
  let r = resolved_ok(
    read_ok([], [], []),
    spec_of([{ ..needed("DESK_REGION", SText), default: Some("eu") }]),
  );
  assert_eq(value_of(r, "DESK_REGION"), Some("eu"))
}

test "a value that is not of its shape is E0442 naming the source and showing the value" {
  let d = first(
    resolved_err(read_ok(["DESK_PORT=eight"], [], []), spec_of([needed("DESK_PORT", SInt)])),
  );
  assert_eq(d.code, b"E0442");
  assert(says(d, "`DESK_PORT` is declared `SInt` and --set supplied a value that is not an `Int`"));
  assert(says(d, "the value is `eight`"))
}

test "an Int is what int_of_string reads, and a Bool is true or false and nothing else" {
  let int = spec_of([needed("N", SInt)]);
  assert_eq(value_of(resolved_ok(read_ok(["N=-17"], [], []), int), "N"), Some("-17"));
  assert_eq(codes(resolved_err(read_ok(["N=+17"], [], []), int)), [b"E0442"]);
  let flag = spec_of([needed("DESK_DEBUG", SBool)]);
  assert_eq(
    value_of(resolved_ok(read_ok(["DESK_DEBUG=false"], [], []), flag), "DESK_DEBUG"),
    Some("false"),
  );
  assert(
    fold(["True", "yes", "1", ""], true, |ok: Bool, bad: String|
      ok && codes(resolved_err(read_ok(["DESK_DEBUG=" ++ bad], [], []), flag)) == [b"E0442"]),
  )
}

test "a malformed secret is E0442 and its value is not printed" {
  let d = first(
    resolved_err(read_ok(["DESK_API_KEY=  "], [], []), spec_of([needed("DESK_API_KEY", SSecret)])),
  );
  assert_eq(d.code, b"E0442");
  assert(says(d, "the value is not printed"));
  assert(!string_contains(rendered(d), "  "))
}

test "an undeclared explicit key is W0607 listing the declared ones, an environment name is not" {
  let r = resolved_ok(
    read_ok(["DESK_PROT=8137"], [file("deploy.env", "DESK_RGION=eu\n")], [
      var("PATH", "/bin"),
      var("HOME", "/root"),
    ]),
    spec_of([key("DESK_REGION", SText)]),
  );
  assert_eq(codes(r.warnings), [b"W0607", b"W0607"]);
  assert_eq(map(r.warnings, |diag: Diag| diag.severity), [b"warning", b"warning"]);
  assert(
    fold(r.warnings, false, |hit: Bool, diag: Diag|
      hit || says(diag, "--set supplies `DESK_PROT`")),
  );
  assert(
    fold(r.warnings, false, |hit: Bool, diag: Diag|
      hit || says(diag, "--config deploy.env supplies `DESK_RGION`")),
  );
  assert(says(first(r.warnings), "the schema declares: DESK_REGION"));
  assert_eq(resolved_ok(read_ok(["ANYTHING=1"], [], []), None).warnings, [])
}

test "every missing and invalid key is reported at once" {
  let ds = resolved_err(
    read_ok(["C=three"], [], []),
    spec_of([needed("A", SText), needed("B", SText), needed("C", SInt)]),
  );
  assert_eq(codes(ds), [b"E0441", b"E0441", b"E0442"])
}

test "a binding is handed every value, which keys are secret, and the schema's names and shapes" {
  let r = resolved_ok(
    read_ok(["DESK_API_KEY=s3cret", "DESK_REGION=eu", "EXTRA=1"], [], []),
    spec_of([needed("DESK_REGION", SText), needed("DESK_API_KEY", SSecret)]),
  );
  let c = configured(r.configuration);
  assert_eq(c.values, [
    { key: "DESK_API_KEY", value: "s3cret", secret: true },
    { key: "DESK_REGION", value: "eu", secret: false },
    { key: "EXTRA", value: "1", secret: false },
  ]);
  assert_eq(
    c.schema,
    Some({
      function: "m.spec",
      keys: [{ name: "DESK_REGION", shape: "SText" }, { name: "DESK_API_KEY", shape: "SSecret" }],
    }),
  );
  assert(c.opened);
  assert(!configured(unopened()).opened);
  assert(configured(resolved_ok(read_ok([], [], [var("PATH", "/bin")]), None).configuration).opened)
}

test "a report lists only the declared keys, and a secret's value never" {
  let r = resolved_ok(
    read_ok(["DESK_API_KEY=hunter2"], [file("deploy.env", "DESK_PORT=8137\n")], [
      var("PATH", "/bin"),
    ]),
    spec_of([
      needed("DESK_PORT", SInt),
      needed("DESK_API_KEY", SSecret),
      { ..key("DESK_REGION", SText), default: Some("eu") },
    ]),
  );
  let rep = report(r.configuration);
  assert_eq(rep.keys, [
    { name: "DESK_API_KEY", value: "****", source: "--set", secret: true },
    { name: "DESK_PORT", value: "8137", source: "deploy.env", secret: false },
    { name: "DESK_REGION", value: "eu", source: "default", secret: false },
  ]);
  assert_eq((rep.resolved, rep.secret, rep.defaults, rep.environment), (3, 1, 1, 1));
  assert_eq(
    banner(r.configuration),
    "3 keys · 1 --set · 1 --config · 1 default · 1 secret (values not shown)",
  );
  assert(!string_contains(to_string(report_json(rep)), "hunter2"))
}

// --- Schemas as values ---

fn record(fields: List<{ name: String, value: Value }>) -> Value = VRecord(fields)

fn a_key_value(name: String, shape: String, required: Bool, default: Option<String>) -> Value =
  record([
    {
      name: "default",
      value: match default { Some(d) -> VCtor("Some", [VStr(d)]), None -> VCtor("None", []) },
    },
    { name: "name", value: VStr(name) },
    { name: "required", value: VBool(required) },
    { name: "shape", value: VCtor(shape, []) },
  ])

fn a_spec_value(keys: List<Value>) -> Value = record([{ name: "keys", value: VList(keys) }])

test "a ConfigSpec value decodes into the keys the run resolves, in its own order" {
  let v = a_spec_value([
    a_key_value("DESK_PORT", "std.config.SInt", true, None),
    a_key_value("DESK_REGION", "std.config.SText", false, Some("eu")),
  ]);
  assert_eq(
    schema_of(v, "desk.config"),
    Ok({
      function: "desk.config",
      keys: [needed("DESK_PORT", SInt), { ..key("DESK_REGION", SText), default: Some("eu") }],
    }),
  )
}

test "a value that is not a ConfigSpec is refused rather than partly read" {
  let refused = |v: Value|
    match schema_of(v, "desk.config") { Ok(_) -> "", Err(d) -> string_of_bytes_lossy(d.message) };
  let prefix = "`--config-schema desk.config` returned something that is not a `ConfigSpec`: ";
  assert_eq(refused(VStr("x")), prefix ++ "it is not a record");
  assert_eq(refused(record([])), prefix ++ "it has no `keys` list");
  assert_eq(refused(a_spec_value([VStr("x")])), prefix ++ "a key in `keys` is not a record");
  assert_eq(
    refused(a_spec_value([a_key_value("K", "other.SText", true, None)])),
    prefix ++ "`K` has the shape `other.SText`, which is not one of `std.config`'s",
  );
  assert_eq(
    refused(
      a_spec_value([
        record([
          { name: "name", value: VStr("K") },
          { name: "shape", value: VCtor("std.config.SInt", []) },
        ]),
      ]),
    ),
    prefix ++ "`K` has no `required` flag",
  )
}

// Which of two disagreeing declarations applied would depend on the schema's list order.
test "a schema that declares a key twice is refused" {
  match schema_of(
      a_spec_value([
        a_key_value("DESK_REGION", "std.config.SText", false, None),
        a_key_value("DESK_REGION", "std.config.SInt", false, None),
      ]),
      "desk.config",
    ) {
    Ok(_) -> panic("one name, two declarations"),
    Err(d) -> {
      assert_eq(d.code, b"E0440");
      assert(says(d, "the configuration schema declares `DESK_REGION` twice"))
    },
  }
}
