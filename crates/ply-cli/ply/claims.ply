// The obligations a project carries, and what became of each: what `ply prove` and `ply review`
// are both about. The load, the store and the prover are the Rust side's — a front end is not a
// value a program can hold, discharging a claim enters compiled bodies, and an entry does not nest
// on the thread this program is itself running on. Which claims are asked for, the keys their
// evidence is read and filed under, what the coverage, the review and the baseline come to, every
// line and key of both reports, and the code each run exits with are decided here.

import cmdline (Parsed, has, parse_nat, value, values_of)
import proof.shrink (Offer, Reply)
import proof.world (Built, Obligation, World, walks)
import machine
import compiler.front (Whole)
import compiler.infer (DefInfo)
import compiler.resolve (Diag, diag, diag1)
import signature (provenance)
import std.bytes (bytes_of_hex, hex_of)
// An obligation's key folds in the simulation's digest, which is the suite's own encoding.
import suite.select (Search, digest_of)
import proof.keys (plan_digest, prove_key)
import diagnostic (Place, Spot, spot_of)
import entry (At, no_module)
import report (Answer, ind, ok_code, count_of, plural, reported, refused)
import std.json (Json, Null, Str, Bool, Number, Array, Object, Member, object)
import style (Style, plain, dim, red, green, yellow)
// What a run decides lives in the suite, which is where the runtime reads it from; these are the
// names and the words it marshals, so a program that reports on them shares the one definition.
import proof.obligation (Binding, CacheRefused, Cases, Certificate, Change, Changed, ClaimRow,
                         Counter, Coverage, Def, Defect, Ensures, Evidence, Example, Falsified,
                         Fault, Frame, Fresh, FromProof, FromSample, Gap, GuardNotSampled, Held,
                         Instantiation, Kept, Kind, Law, Laws, Moved, Never, NoCaseKept, NotDrawn,
                         Outcome, Point, Proof, Property, Proved, Pure, Raised, ReachesHost, Reason,
                         Record, Refuted, Rejected, Sampled, Tier, Unattempted, Uncached, Unchanged,
                         Undrawn, Ungeneratable, UnhandledEffect, Unsatisfiable, Vacuity, Vacuous,
                         Writes, Written, cases_summary, certificate_summary, coverage,
                         evidence_summary, fault_message, fault_notes, fault_summary, filings,
                         frame_summary, gap_summary, gap_word, hits, laws_of, reason_word, select,
                         specified, tier_word, vacuity_summary, verdict_of)
import std.value (VBool, VInt, VList, render)

// What the Rust side collects, discharges, reviews and accepts, in that order. Collecting comes
// first and once; a run then either accepts a baseline or discharges what it was asked for, and
// only a discharged run has a review to read.
// The job the run is configured with, as the program parses it: the report flags, the search
// bounds, and the host it may bind. `--changed`/`--accept` stay flags; `review` binds nothing.
pub type Options = {
  path: String,
  no_incremental: Bool,
  no_cache: Bool,
  std: Bool,
  jobs: Option<Int>,
  host: Bool,
  tls: List<machine::TlsCred>,
  trust: List<String>,
  fs: List<machine::Named>,
  config: machine::ConfigOpts,
  trace: machine::TraceOpts,
  prove: ProveOpts,
  sim: machine::SimOpts,
}

pub type ProveOpts = {
  cases: Option<Int>,
  roots: Option<Int>,
  budget: Option<Int>,
  shrink_budget: Option<Int>,
  steps: Option<Int>,
}

pub nondet effect prover {
  // The world is the program as the prover reads it, built here: its declared types, its
  // definitions' signatures, and the obligations it owes with the search each one goes to, which
  // `discharged` names by position.
  write configure[claims](options: Options, front: Front, world: World) -> Unit
  read collected[claims]() -> Result<Collected, Refusal>
  // What the obligation cache holds under each key the program names, spelled out: a proof, a
  // sample, or something the runtime cannot read. Every key is the program's: this is the only side
  // that encodes one.
  read outcomes[claims](keys: List<String>) -> List<Option<String>>
  read discharged[claims](choice: Choice) -> Result<Discharged, Refusal>
  // Files the evidence of each discharge just made, by its place in the run, under the key this
  // program chose for it, and answers what storing it had to say.
  write record[claims](entries: List<{ at: Int, key: String }>) -> List<Diag>
  // One point of one obligation's guard, at a root and case the caller chose: what a search over
  // cases is made of, one case at a time. The index is the claim's place in the collection, as
  // `discharged` reads its wants, and the root is the seed a counterexample reports.
  read replay[claims](index: Int, root: Int, case: Int) -> Result<Point, Refusal>
  // What the static tier alone answers for each of these claims, by its place in the collection,
  // whether or not anything discharged it this run: `None` for one it never sees, such as a law over
  // interleavings. A measurement a run asks for, not a step of a discharge.
  read reaches[claims](claims: List<Int>) -> Result<List<Option<Reach>>, Refusal>
  // A counterexample is not finished when it is found: the walk that makes it small is this side's,
  // and it drives it one question at a time. The runtime keeps the values — a program cannot hold a
  // value of a type it never named — and regenerates them from the draw it reports.
  read shrink[claims](claim: Int) -> Result<Option<Int>, Refusal>
  read offers[claims](i: Int) -> Result<Option<Offer>, Refusal>
  read would[claims](i: Int, position: Int) -> Result<Bool, Refusal>
  write accept[claims](i: Int, position: Int) -> Result<Unit, Refusal>
  read settled[claims]() -> Result<Option<Settled>, Refusal>
  // The baseline a reader accepted for each of these definitions, where there is one.
  read baselines[claims](names: List<String>) -> List<{ name: String, record: Record }>
  write accepted[claims](records: List<{ name: String, record: Record }>) -> Accepted
}

// The walk's own vocabulary (`Ask`, `Reply`, `Offer`) is `proof.shrink`'s: the operations below are
// the runtime's half of it.

// The counterexample the walk settled on, and the one it started from: both in the words a report
// prints, so a caller only replaces what the walk changed.
pub type Settled = { bindings: List<Binding>, original: List<Binding> }

// --- What the Rust side answers with ---

// The options record, built from the parsed line. `--changed`/`--accept` stay flags.
pub fn options_from(p: Parsed, root: String) -> Options = {
  let machine_options = machine::options_from(p);
  {
    path: root,
    no_incremental: has(p, "no-incremental"),
    no_cache: has(p, "no-cache"),
    std: has(p, "std"),
    jobs: match value(p, "jobs") { Some(v) -> parse_nat(v), None -> None },
    host: machine_options.host,
    tls: machine_options.tls,
    trust: machine_options.trust,
    fs: machine_options.fs,
    config: machine_options.config,
    trace: machine_options.trace,
    prove: {
      cases: opt_nat(p, "prove-cases"),
      roots: opt_nat(p, "prove-roots"),
      budget: opt_nat(p, "prove-budget"),
      shrink_budget: opt_nat(p, "shrink-budget"),
      steps: opt_nat(p, "prove-steps"),
    },
    sim: machine::sim_options_from(p),
  }
}

fn opt_nat(p: Parsed, long: String) -> Option<Int> =
  match value(p, long) { Some(v) -> parse_nat(v), None -> None }

pub type Refused = { diags: List<Diag>, places: List<Place> }

// Three refusals, because each owes a reader a different last line: a program that did not
// compile, a registration that does not match it, and a cache that would not open at all.
pub type Refusal = | Broken(Refused) | Unbound(Refused) | Trouble(Refused)

// An `ensures` is one of its owner's clauses, in the order they are written; a law is the label it
// was written with, when it has one.

pub type Claim = {
  key: String,
  // `law/host`: a verdict against the world, which is never cached.
  host: Bool,
  owner: String,
  kind: Kind,
  guarded: Bool,
  frame: Frame,
  // Where the claim is written, as a label points at it.
  at: At,
  // Declared atoms the owner's body never touched, which `--explain` lays out under the row.
  unperformed: List<String>,
  // Whether a counterexample to it is walked down: only a point drawn one at a time has a draw to
  // walk from.
  walks: Bool,
}

// What the program decided about a run of obligations: which ones it reports on, by collection
// index, which of those the cache could not answer for, in that order, and the key each answered
// one's evidence is read back from, by its place in the run. How each is discharged is its
// obligation's own strategy.
pub type Choice = { claims: List<Int>, runs: List<Int>, read: List<{ at: Int, key: String }> }

pub type Sim = { mode: String, roots: List<Int>, budget: Int, steps: Int, path: List<Int> }

// What an obligation weaker than a proof was discharged against, and cached under.
pub type Plan = {
  cases: Int,
  roots: List<Int>,
  prove_budget: Int,
  shrink_budget: Int,
  step_budget: Int,
  sim: Sim,
}

// What the runtime loaded for a run: the places its spans point into, what loading it had to say,
// and the plan the run discharges under.
pub type Collected = { places: List<Place>, warnings: List<Diag>, plan: Plan }

// What this side built of its own claims: one per obligation of the world, in its order; the
// definitions and laws the run answers for; and the trouble that cost it an obligation.
pub type Claimed = {
  claims: List<Claim>,
  defs: List<Def>,
  laws: List<Written>,
  warnings: List<Diag>,
}

pub type Collection = {
  places: List<Place>,
  warnings: List<Diag>,
  claims: List<Claim>,
  // Every definition in scope, in the checker's order.
  defs: List<Def>,
  laws: List<Written>,
  plan: Plan,
}

pub fn collection_of(got: Collected, mine: Claimed) -> Collection =
  {
    places: got.places,
    warnings: also(got.warnings, mine.warnings),
    claims: mine.claims,
    defs: mine.defs,
    laws: mine.laws,
    plan: got.plan,
  }

// Every obligation of the world as a claim a report reads, with what its owner's row declares and its
// body never performs.
pub fn own_claims(w: Whole, built: Built) -> Claimed = {
  let defs = fold(w.checked.defs, map_new(), |acc: Map<String, DefInfo>, d: DefInfo|
    map_insert(acc, string_of_bytes_lossy(d.name), d));
  {
    claims: map(built.world.obligations, |o: Obligation|
      {
        key: o.key,
        host: o.host,
        owner: o.owner,
        kind: o.kind,
        guarded: o.guarded,
        frame: o.frame,
        at: o.at,
        unperformed: match o.kind {
          Law(_) -> [],
          Ensures(_) -> match map_get(defs, o.owner) {
            Some(d) -> provenance(d).unperformed,
            None -> [],
          },
        },
        walks: walks(o.strategy),
      }),
    defs: built.defs,
    laws: built.laws,
    warnings: built.warnings,
  }
}

// What the runtime discharged, parallel to the claims the run asked for.
pub type Discharged = { outcomes: List<Outcome>, duration_ms: Decimal, warnings: List<Diag> }

// What the static tier alone answered for one obligation, and every place it left the decidable
// fragment on the way: `kind` names the construct, and `about` the definition or reason it names.
pub type Reach = {
  decision: String,
  steps: Int,
  blockers: List<{ kind: String, about: Option<String> }>,
}

// A run of obligations as a report reads it: what became of each claim it asked for, where each
// answer came from, and the accounting over them.
pub type Verdicts = {
  // Parallel to the indices the run asked for.
  outcomes: List<Outcome>,
  // What the static tier alone answers for each, when the run asked: parallel to `outcomes`.
  reaches: Option<List<Option<Reach>>>,
  reasons: List<Reason>,
  coverage: Coverage,
  cached: Int,
  // Definitions carrying at least one obligation, whatever became of it.
  specified: Int,
  duration_ms: Decimal,
  warnings: List<Diag>,
}

pub type Accepted = { definitions: Int, stored: Bool, warnings: List<Diag> }

// One claim and what became of it, which is what every row and every object is written from.
pub type Row = { claim: Claim, outcome: Outcome, reason: Reason, reach: Option<Reach> }

// --- Small things -----------------------------------------------------------

pub fn num(n: Int) -> Json = Number(decimal_of_int(n))

pub fn nth(xs: List<String>, i: Int) -> String = match list_at(xs, i) { Some(x) -> x, None -> "" }

pub fn joined(parts: List<String>, sep: String) -> String =
  fold(range(0, len(parts)), "", |acc: String, i: Int|
    if i == 0 { nth(parts, i) } else { acc ++ sep ++ nth(parts, i) })

pub fn also<a>(head: List<a>, tail: List<a>) -> List<a> =
  fold(tail, head, |acc: List<a>, x: a| push(acc, x))

pub fn spaces(n: Int) -> String = fold(range(0, n), "", |acc: String, i: Int| acc ++ " ")

pub fn pad_right(s: String, n: Int) -> String =
  if string_len(s) >= n { s } else { s ++ spaces(n - string_len(s)) }

pub fn texts(xs: List<String>) -> Json = Array(map(xs, |x: String| Str(x)))

fn two_places(n: Int) -> String = if n < 10 { "0" ++ int_to_string(n) } else { int_to_string(n) }

// Seconds to two places, as a reading rather than a measurement to compare. Counted in
// hundredths, because a quotient's own scale is what it divides out to and not what it is read at.
pub fn seconds(ms: Decimal) -> String = {
  let hundredths = match int_of_decimal(decimal_div(ms, 10m, 0, HalfUp), Down) {
    Some(n) -> n,
    None -> 0,
  };
  int_to_string(hundredths / 100) ++ "." ++ two_places(hundredths % 100)
}

// A lazy read and a later flush can each report the same unreadable file, and a reader is owed
// the trouble once.
pub fn once_each(ds: List<Diag>) -> List<Diag> =
  fold(ds, [], |acc: List<Diag>, d: Diag|
    if fold(acc, false, |seen: Bool, k: Diag|
        seen || (k.code == d.code && k.message == d.message)) { acc }
    else { push(acc, d) })

// `path:line:col`, one-based, as every other command prints a place.
pub fn located(places: List<Place>, at: At) -> Option<String> =
  if at.module == no_module() { None } else {
    match list_at(places, at.module) {
      None -> None,
      Some(p) -> {
        let spot: Spot = spot_of(p.text, at.start);
        Some(p.path ++ ":" ++ int_to_string(spot.line) ++ ":" ++ int_to_string(spot.col))
      },
    }
  }

// As Rust prints a string it is quoting: the escapes a label could carry, and nothing else.
fn escaped(text: String) -> String =
  fold(string_split(text, "\\"), "", |acc: String, part: String|
    if acc == "" { part } else { acc ++ "\\\\" ++ part })

pub fn quoted(text: String) -> String = {
  let parts = string_split(escaped(text), "\"");
  "\""
    ++ fold(range(0, len(parts)), "", |acc: String, i: Int|
      if i == 0 { nth(parts, i) } else { acc ++ "\\\"" ++ nth(parts, i) })
    ++ "\""
}

// --- Naming a claim ---------------------------------------------------------

pub fn label_of(c: Claim) -> String =
  match c.kind {
    Ensures(index) -> c.owner ++ " ensures #" ++ int_to_string(index),
    Law(named) -> match named { Some(label) -> "law " ++ quoted(label), None -> "law " ++ c.owner },
  }

pub fn kind_word(c: Claim) -> String = match c.kind { Ensures(_) -> "ensures", Law(_) -> "law" }

pub fn outcome_word(o: Outcome) -> String =
  match o {
    Held(h) -> tier_word(h.tier),
    Refuted(_) -> "refuted",
    Vacuous(_) -> "vacuous",
    Unattempted(_) -> "unattempted",
    Defect(_) -> "defect",
  }

pub fn holds(o: Outcome) -> Bool = match o { Held(_) -> true, _ -> false }

pub fn tier_of(o: Outcome) -> Option<Tier> = match o { Held(h) -> Some(h.tier), _ -> None }

pub fn rendered(bindings: List<Binding>) -> String =
  joined(map(bindings, |b: Binding| b.name ++ " = " ++ render(b.value)), ", ")

pub fn quantifier(c: Claim, bindings: List<Binding>) -> String =
  if len(bindings) == 0 { "no binders" }
  else { "forall (" ++ joined(map(bindings, |b: Binding| b.name ++ ": " ++ b.ty), ", ") ++ ")" }

// What a row says after the tier and the claim's name.
pub fn detail_of(r: Row, places: List<Place>) -> String =
  match r.outcome {
    Held(h) -> evidence_summary(h.tier, h.evidence),
    Unattempted(gap) -> gap_summary(gap),
    Vacuous(v) -> vacuity_summary(v.why),
    Refuted(_) -> match located(places, r.claim.at) { Some(at) -> at, None -> "" },
    Defect(f) -> fault_summary(f),
  }

// `!` for Ply's own failure, as `ply test` marks a defect.
pub fn mark_of(s: Style, o: Outcome) -> String =
  match o {
    Held(_) -> green(s, "✓"),
    Unattempted(_) -> yellow(s, "~"),
    Defect(_) -> yellow(s, "!"),
    _ -> red(s, "✗"),
  }

// --- Counting ---------------------------------------------------------------

pub fn count_where(rows: List<Row>, want: (Outcome) -> Bool) -> Int =
  len(filter(rows, |r: Row| want(r.outcome)))

pub fn at_tier(rows: List<Row>, tier: Tier) -> Int =
  count_where(rows, |o: Outcome| tier_of(o) == Some(tier))

pub fn refuted_of(rows: List<Row>) -> Int =
  count_where(rows, |o: Outcome| match o { Refuted(_) -> true, _ -> false })

pub fn vacuous_of(rows: List<Row>) -> Int =
  count_where(rows, |o: Outcome| match o { Vacuous(_) -> true, _ -> false })

pub fn unattempted_of(rows: List<Row>) -> Int =
  count_where(rows, |o: Outcome| match o { Unattempted(_) -> true, _ -> false })

pub fn defect_of(rows: List<Row>) -> Int =
  count_where(rows, |o: Outcome| match o { Defect(_) -> true, _ -> false })

pub fn held_of(rows: List<Row>) -> Int = count_where(rows, |o: Outcome| holds(o))

// A refuted or vacuous claim fails the run, as Ply's own failure on one does; a gap does not.
pub fn failed(rows: List<Row>) -> Bool =
  refuted_of(rows) > 0 || vacuous_of(rows) > 0 || defect_of(rows) > 0

// At least one claim the program makes does not hold, or Ply failed discharging one.
pub fn failure() -> Int = 1

pub fn code_of(rows: List<Row>) -> Int = if failed(rows) { failure() } else { ok_code() }

// The rows a run reports on: the claims it asked for, paired with what came back for each.
pub fn rows_of(claims: List<Claim>, wanted: List<Int>, v: Verdicts) -> List<Row> =
  fold(range(0, len(wanted)), [], |acc: List<Row>, i: Int|
    match list_at(claims, match list_at(wanted, i) { Some(k) -> k, None -> -1 }) {
      None -> acc,
      Some(c) -> match list_at(v.outcomes, i) {
        None -> acc,
        Some(o) ->
          push(acc, {
            claim: c,
            outcome: o,
            reason: match list_at(v.reasons, i) { Some(r) -> r, None -> Fresh },
            reach: match v.reaches {
              Some(reached) -> match list_at(reached, i) { Some(r) -> r, None -> None },
              None -> None,
            },
          }),
      },
    })

// --- What a run decides -------------------------------------------------------

/// What each law speaks about, among the definitions in scope.
pub fn laws_in(c: Collection) -> Laws = laws_of(map(c.defs, |d: Def| d.name), c.laws)

/// The digest of the plan everything weaker than a proof is filed under.
pub fn plan_digest_of(p: Plan) -> Bytes =
  plan_digest(
    p.cases,
    p.prove_budget,
    p.step_budget,
    p.roots,
    digest_of({
      mode: p.sim.mode,
      roots: p.sim.roots,
      budget: p.sim.budget,
      steps: p.sim.steps,
      path: p.sim.path,
    }),
  )

// A refusal is reported: a cache that silently declines looks like a slow prover.
fn refusal_warning(text: String) -> Diag = {
  let d: Diag = diag(b"W0602", bytes_of_string(text), [], [
    b"the obligation was discharged again, so no claim rests on it",
    b"run `ply cache clear` if it happens again",
  ]);
  { ..d, severity: b"warning" }
}

// One claim's outcome, as the accounting over a run reads it.
fn claim_row(c: Claim, o: Outcome) -> ClaimRow =
  {
    owner: c.owner,
    kind: c.kind,
    tier: tier_of(o),
    holds: holds(o),
    discharged: match o { Unattempted(_) -> false, Defect(_) -> false, _ -> true },
  }

/// The rows a run's accounting reads, parallel to the claims it asked for.
pub fn claim_rows(c: Collection, wanted: List<Int>, outcomes: List<Outcome>) -> List<ClaimRow> =
  fold(range(0, len(wanted)), [], |acc: List<ClaimRow>, i: Int|
    match list_at(c.claims, match list_at(wanted, i) { Some(k) -> k, None -> -1 }) {
      None -> acc,
      Some(claim) -> match list_at(outcomes, i) {
        None -> acc,
        Some(o) -> push(acc, claim_row(claim, o)),
      },
    })

/// A run of obligations, decided: what the cache answered for each claim the run reports on, what
/// the runtime discharged, the evidence filed after, and the accounting a report reads.
pub fn decided(
  c: Collection,
  wanted: List<Int>,
  use_cache: Bool,
) -> Result<Verdicts, Refusal> / {prover.outcomes[claims], prover.discharged[claims], prover.record[claims]} = {
  let digest = plan_digest_of(c.plan);
  let asked = map(wanted, |i: Int| blank_claim(c.claims, i));
  let keys = map(asked, |claim: Claim|
    { bare: claim.key, planned: hex_of(prove_key(bytes_of_hex(claim.key), digest)) });
  let answers = map(keys, |k: { bare: String, planned: String }| {
    let held = prover.outcomes[claims]([k.bare, k.planned]);
    verdict_of(k.bare, k.planned, held_at(held, 0), held_at(held, 1))
  });
  let hosted = map(asked, |claim: Claim| claim.host);
  let selection = select(hosted, answers, use_cache);
  let choice = {
    claims: wanted,
    runs: selection.to_discharge,
    read: fold(range(0, len(selection.from)), [], |acc: List<{ at: Int, key: String }>, at: Int|
      match list_at(selection.from, at) {
        Some(Some(key)) -> push(acc, { at: at, key: key }),
        _ -> acc,
      }),
  };
  match prover.discharged[claims](choice) {
    Err(why) -> Err(why),
    Ok(d) -> {
      let filed = filings(
        keys,
        hosted,
        map(d.outcomes, tier_of),
        selection.to_discharge,
        use_cache,
      );
      let stored = if len(filed) == 0 { [] } else { prover.record[claims](filed) };
      let laws = laws_in(c);
      let names = map(c.defs, |x: Def| x.name);
      Ok({
        outcomes: d.outcomes,
        reaches: None,
        reasons: selection.reasons,
        coverage: coverage(names, laws, claim_rows(c, wanted, d.outcomes)),
        cached: hits(selection),
        specified: specified(
          names,
          laws,
          map(c.claims, |claim: Claim| { owner: claim.owner, kind: claim.kind }),
        ),
        duration_ms: d.duration_ms,
        warnings: also(also(map(selection.warnings, refusal_warning), d.warnings), stored),
      })
    },
  }
}

// The n-th answer, or none when the runtime answered fewer than were asked.
fn held_at(held: List<Option<String>>, i: Int) -> Option<String> =
  match list_at(held, i) { Some(x) -> x, None -> None }

// The claim at a collection index, or a blank one: a fixture's collection may be shorter than the
// indices a test hands it.
pub fn blank_claim(cs: List<Claim>, i: Int) -> Claim =
  match list_at(cs, i) {
    Some(c) -> c,
    None ->
      {
        key: "",
        host: false,
        owner: "",
        kind: Ensures(0),
        guarded: false,
        frame: Pure,
        at: { module: 0, start: 0, end: 0 },
        unperformed: [],
        walks: false,
      },
  }

// --- The lines a reader reads ------------------------------------------------

// How much of the program carries a claim at all, then what is left to read line by line.
pub fn coverage_lines(s: Style, cov: Coverage, carried: Int, explain: Bool) -> List<String> = {
  let unspecified = if cov.definitions > carried { cov.definitions - carried } else { 0 };
  let head = ind() ++ count_of(cov.definitions, "definition") ++ " · " ++ int_to_string(carried)
    ++ " carry an obligation · "
    ++ int_to_string(unspecified)
    ++ " do not";
  if len(cov.uncovered) == 0 { [head] } else {
    let shown = if explain || len(cov.uncovered) < 6 { len(cov.uncovered) } else { 6 };
    let rest = len(cov.uncovered) - shown;
    let tail = if rest > 0 { ", and " ++ int_to_string(rest) ++ " more (`--explain` for all)" }
    else { "" };
    let names = joined(map(range(0, shown), |i: Int| nth(cov.uncovered, i)), ", ");
    [
      head,
      ind()
        ++ dim(
          s,
          int_to_string(len(cov.uncovered)) ++ " not covered by a claim that holds: " ++ names
            ++ tail,
        ),
    ]
  }
}

// `~` for a gap, because a gap is not a failure: nothing was established, and nothing was refuted.
pub fn row_head(s: Style, r: Row, places: List<Place>) -> String = {
  let detail = detail_of(r, places);
  let painted = match r.outcome { Vacuous(_) -> detail, _ -> dim(s, detail) };
  ind() ++ mark_of(s, r.outcome) ++ " " ++ pad_right(outcome_word(r.outcome), 11) ++ " "
    ++ pad_right(label_of(r.claim), 40)
    ++ " "
    ++ painted
}

pub fn under() -> String = ind() ++ "    "

// --- The document ------------------------------------------------------------

pub fn bindings_json(bindings: List<Binding>) -> Json =
  Array(
    map(bindings, |b: Binding|
      object([
        { key: "name", value: Str(b.name) },
        { key: "type", value: Str(b.ty) },
        { key: "value", value: Str(render(b.value)) },
      ])),
  )

fn instantiations_json(xs: List<Instantiation>) -> Json =
  Array(
    map(xs, |x: Instantiation|
      object([{ key: "var", value: Str(x.var) }, { key: "type", value: Str(x.ty) }])),
  )

fn certificate_json(c: Certificate) -> Json =
  object([
    { key: "rules", value: c.rules },
    { key: "steps", value: num(c.steps) },
    { key: "guard_satisfiable", value: Bool(c.guard_satisfiable) },
    { key: "sorts", value: texts(c.sorts) },
    { key: "summary", value: Str(certificate_summary(c)) },
  ])

fn cases_json(tier: Tier, c: Cases) -> Json =
  object([
    { key: "generated", value: num(c.generated) },
    { key: "kept", value: num(c.kept) },
    { key: "rejected", value: num(c.rejected) },
    { key: "roots", value: Array(map(c.roots, |r: Int| num(r))) },
    { key: "instantiations", value: instantiations_json(c.instantiations) },
    { key: "summary", value: Str(cases_summary(tier, c)) },
  ])

fn counterexample_json(cx: Counter) -> Json =
  object([
    { key: "bindings", value: bindings_json(cx.bindings) },
    { key: "original", value: bindings_json(cx.original) },
    { key: "shrinks", value: num(cx.shrinks) },
    { key: "root", value: num(cx.root) },
    { key: "case", value: num(cx.case) },
    { key: "seed", value: match cx.seed { Some(text) -> Str(text), None -> Null } },
  ])

// What the outcome adds to the object every row writes.
fn outcome_members(o: Outcome) -> List<Member> =
  match o {
    Held(h) -> match h.evidence {
      Proof(c) -> [{ key: "certificate", value: certificate_json(c) }],
      Sampled(c) -> [{ key: "cases", value: cases_json(h.tier, c) }],
    },
    Refuted(cx) -> [{ key: "counterexample", value: counterexample_json(cx) }],
    Vacuous(v) -> [{ key: "vacuity", value: Str(vacuity_summary(v.why)) }],
    Unattempted(gap) ->
      also(
        [
          { key: "gap", value: Str(gap_summary(gap)) },
          { key: "gap_kind", value: Str(gap_word(gap)) },
        ],
        match gap {
          Raised(r) -> if len(r.bindings) == 0 { [] }
          else { [{ key: "raised_at", value: bindings_json(r.bindings) }] },
          _ -> [],
        },
      ),
    Defect(f) -> [{ key: "defect", value: fault_json(f) }],
  }

fn fault_json(f: Fault) -> Json =
  object([
    { key: "code", value: Str(f.code) },
    { key: "message", value: Str(fault_message(f)) },
    { key: "bindings", value: bindings_json(f.bindings) },
    { key: "summary", value: Str(fault_summary(f)) },
  ])

fn index_members(c: Claim) -> List<Member> =
  match c.kind { Ensures(index) -> [{ key: "index", value: num(index) }], Law(_) -> [] }

// `reached` is whether the run asked the static tier about every claim, which is when a claim carries
// what it answered.
pub fn obligation_json(r: Row, places: List<Place>, reached: Bool) -> Json =
  object(
    also(
      also(
        also(
          [
            { key: "key", value: Str(r.claim.key) },
            { key: "owner", value: Str(r.claim.owner) },
            { key: "label", value: Str(label_of(r.claim)) },
            { key: "kind", value: Str(kind_word(r.claim)) },
            { key: "guarded", value: Bool(r.claim.guarded) },
            { key: "frame", value: Str(frame_summary(r.claim.frame)) },
            {
              key: "location",
              value: match located(places, r.claim.at) { Some(at) -> Str(at), None -> Null },
            },
            { key: "outcome", value: Str(outcome_word(r.outcome)) },
            {
              key: "tier",
              value: match tier_of(r.outcome) { Some(t) -> Str(tier_word(t)), None -> Null },
            },
          ],
          if reached { [{ key: "reach", value: reach_json(r.reach) }] } else { [] },
        ),
        index_members(r.claim),
      ),
      outcome_members(r.outcome),
    ),
  )

// What the static tier alone answered: `null` for a claim it never sees, such as a law over
// interleavings.
fn reach_json(v: Option<Reach>) -> Json =
  match v {
    None -> Null,
    Some(reach) ->
      object([
        { key: "decision", value: Str(reach.decision) },
        { key: "steps", value: num(reach.steps) },
        {
          key: "blockers",
          value: Array(
            map(reach.blockers, |b: { kind: String, about: Option<String> }|
              object([
                { key: "kind", value: Str(b.kind) },
                { key: "about", value: match b.about { Some(a) -> Str(a), None -> Null } },
              ])),
          ),
        },
      ]),
  }

pub fn coverage_json(cov: Coverage) -> Json =
  object([
    { key: "definitions", value: num(cov.definitions) },
    { key: "covered", value: num(cov.covered) },
    { key: "uncovered", value: texts(cov.uncovered) },
    {
      key: "by_tier",
      value: object(
        map(cov.by_tier, |b: { tier: Tier, count: Int }|
          { key: tier_word(b.tier), value: num(b.count) }),
      ),
    },
  ])

fn sim_json(s: Sim) -> Json =
  object([
    { key: "mode", value: Str(s.mode) },
    { key: "roots", value: Array(map(s.roots, |r: Int| num(r))) },
    { key: "budget", value: num(s.budget) },
    { key: "steps", value: num(s.steps) },
  ])

pub fn plan_json(p: Plan) -> Json =
  object([
    { key: "cases", value: num(p.cases) },
    { key: "roots", value: Array(map(p.roots, |r: Int| num(r))) },
    { key: "prove_budget", value: num(p.prove_budget) },
    { key: "shrink_budget", value: num(p.shrink_budget) },
    { key: "step_budget", value: num(p.step_budget) },
    { key: "sim", value: sim_json(p.sim) },
  ])

// --- What a run raises about the claims that did not hold ---------------------

fn span_of(at: At) -> { start: Int, end: Int } = { start: at.start, end: at.end }

fn refutation(r: Row, cx: Counter) -> Diag = {
  let shrank = "shrank from " ++ rendered(cx.original) ++ " in " ++ int_to_string(cx.shrinks) ++ " "
    ++ plural(cx.shrinks, "step");
  let notes = [
    bytes_of_string(quantifier(r.claim, cx.bindings)),
    bytes_of_string(shrank),
    bytes_of_string("root " ++ int_to_string(cx.root) ++ " · case " ++ int_to_string(cx.case)),
  ];
  diag1(
    b"E0419",
    r.claim.at.module,
    span_of(r.claim.at),
    bytes_of_string(label_of(r.claim) ++ " is false at " ++ rendered(cx.bindings)),
    b"this claim does not hold",
    match cx.seed {
      Some(seed) -> push(notes, bytes_of_string("replay with `--seed " ++ seed ++ "`")),
      None -> notes,
    },
  )
}

fn vacuity(r: Row, guard: At, why: Vacuity) -> Diag =
  diag1(
    b"E0420",
    guard.module,
    span_of(guard),
    bytes_of_string(label_of(r.claim) ++ " is vacuous: " ++ vacuity_summary(why)),
    b"this guard admits nothing",
    [
      b"an obligation over an empty domain is trivially valid and says nothing",
      b"widen the guard, or delete the claim",
    ],
  )

// A gap is a warning: nothing was refuted, and nothing was established either.
fn undischarged(r: Row, gap: Gap) -> Diag = {
  let noted = match gap {
    Raised(raise) -> if len(raise.bindings) == 0 { [] }
    else { [bytes_of_string("shrunk to " ++ rendered(raise.bindings) ++ ", which still raises")] },
    GuardNotSampled(g) ->
      [
        bytes_of_string("the guard admits " ++ rendered(g.witness)),
        b"the generator draws from the whole type, so a narrow guard is a gap in the search rather than a defect in the spec",
      ],
    _ -> [],
  };
  let d: Diag = diag1(
    b"W0604",
    r.claim.at.module,
    span_of(r.claim.at),
    bytes_of_string(label_of(r.claim) ++ " was not discharged: " ++ gap_summary(gap)),
    b"no tier is claimed for this",
    also([b"this definition is not covered; a reader still has to read it"], noted),
  );
  { ..d, severity: b"warning" }
}

// Ply's own code over the claim it stopped, never the `W0604` that blames the program.
fn defect(r: Row, f: Fault) -> Diag = {
  let at = if len(f.bindings) == 0 { [] } else { [bytes_of_string("at " ++ rendered(f.bindings))] };
  diag1(
    bytes_of_string(f.code),
    r.claim.at.module,
    span_of(r.claim.at),
    bytes_of_string(label_of(r.claim) ++ " was not discharged: " ++ fault_summary(f)),
    b"Ply failed discharging this",
    also(map(fault_notes(f), bytes_of_string), at),
  )
}

pub fn diagnostics_of(rows: List<Row>) -> List<Diag> =
  fold(rows, [], |acc: List<Diag>, r: Row|
    match r.outcome {
      Held(_) -> acc,
      Refuted(cx) -> push(acc, refutation(r, cx)),
      Vacuous(v) -> push(acc, vacuity(r, v.guard, v.why)),
      Unattempted(gap) -> push(acc, undischarged(r, gap)),
      Defect(f) -> push(acc, defect(r, f)),
    })

// --- Refusals -----------------------------------------------------------------

// A registration that does not match the program is a start-up failure: nothing was discharged.
fn unbound(s: Style, command: String, why: Refused) -> Answer = {
  let answer: Answer = reported(s, command, why.diags, why.places);
  let tally = ind() ++ red(s, "no host handler was bound") ++ " ("
    ++ count_of(len(why.diags), "error")
    ++ ")";
  {
    ..answer,
    json: match answer.json {
      Object(m) -> Object(map_insert(m, "binding", Str("host"))),
      other -> other,
    },
    errs: push(answer.errs, tally),
  }
}

pub fn refusal(s: Style, command: String, why: Refusal) -> Answer =
  match why {
    Broken(r) -> refused(s, command, r.diags, r.places),
    Unbound(r) -> unbound(s, command, r),
    Trouble(r) -> reported(s, command, r.diags, r.places),
  }

// --- Tests ------------------------------------------------------------------

pub fn a_loc() -> At = { module: 0, start: 3, end: 7 }

pub fn a_claim(owner: String, kind: Kind) -> Claim =
  {
    key: "abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789",
    host: false,
    owner: owner,
    kind: kind,
    guarded: false,
    frame: Pure,
    at: a_loc(),
    unperformed: [],
    walks: false,
  }

pub fn a_place() -> Place = { path: "m.ply", text: b"fn f() -> Int = 1\nfn g() -> Int = 2\n" }

pub fn a_plan() -> Plan =
  {
    cases: 200,
    roots: [0],
    prove_budget: 10000,
    shrink_budget: 500,
    step_budget: 1000000000,
    sim: { mode: "dpor", roots: [0], budget: 256, steps: 100000, path: [] },
  }

pub fn proved(rules: Json, steps: Int) -> Outcome =
  Held({
    tier: Proved,
    evidence: Proof({ rules: rules, steps: steps, guard_satisfiable: true, sorts: [] }),
  })

pub fn a_counter() -> Counter =
  {
    bindings: [{ name: "xs", ty: "List<Int>", value: VList([VInt(0), VInt(0)]) }],
    original: [{ name: "xs", ty: "List<Int>", value: VList([VInt(7), VInt(9)]) }],
    shrinks: 2,
    root: 0,
    case: 11,
    seed: None,
  }

test "a claim is named by its clause's place among its owner's, or by the law's own label" {
  assert_eq(label_of(a_claim("m.one", Ensures(0))), "m.one ensures #0");
  assert_eq(
    label_of(a_claim("m.short", Law(Some("a batch is small")))),
    "law \"a batch is small\"",
  );
  assert_eq(label_of(a_claim("m.nameless", Law(None))), "law m.nameless");
  assert_eq(kind_word(a_claim("m.one", Ensures(0))), "ensures");
  assert_eq(kind_word(a_claim("m.one", Law(None))), "law")
}

test "a label is quoted as Rust quotes it, with a quote and a backslash escaped" {
  assert_eq(quoted("plain"), "\"plain\"");
  assert_eq(quoted("say \"hi\""), "\"say \\\"hi\\\"\"");
  assert_eq(quoted("a\\b"), "\"a\\\\b\"")
}

test "a certificate names each rule once, counts the unfoldings, and ends in its steps" {
  let rules = Array([
    Str("propositional"),
    Str("linear_arithmetic"),
    Str("propositional"),
    Object(
      map_insert(
        map_new(),
        "unfold",
        object([{ key: "def", value: Str("m.double") }, { key: "depth", value: num(1) }]),
      ),
    ),
  ]);
  assert_eq(
    certificate_summary({ rules: rules, steps: 179, guard_satisfiable: true, sorts: [] }),
    "propositional · linear arithmetic · 1 unfolding · 179 steps",
  );
  let none = Array([]);
  assert_eq(
    certificate_summary({ rules: none, steps: 1, guard_satisfiable: true, sorts: ["a"] }),
    "uninterpreted a · 1 steps",
  )
}

test "a rule with fields of its own is read from the tag the prover wrote it under" {
  let enumerated = Array([
    Object(
      map_insert(
        map_new(),
        "exhaustive_enumeration",
        object([{ key: "domain", value: Str("Bool") }, { key: "points", value: num(2) }]),
      ),
    ),
  ]);
  assert_eq(
    certificate_summary({ rules: enumerated, steps: 2, guard_satisfiable: true, sorts: [] }),
    "exhaustive over 2 points of Bool · 2 steps",
  );
  let split = Array([
    Object(
      map_insert(
        map_new(),
        "case_split",
        object([{ key: "ty", value: Str("Colour") }, { key: "arms", value: num(3) }]),
      ),
    ),
  ]);
  assert_eq(
    certificate_summary({ rules: split, steps: 4, guard_satisfiable: true, sorts: [] }),
    "case analysis over Colour (3 arms) · 4 steps",
  )
}

// The property tier claims coverage; below it a run has concrete cases and says so.
test "how a sampled discharge reads depends on whether it kept enough to claim coverage" {
  let kept: Cases = { generated: 200, kept: 200, rejected: 0, roots: [0], instantiations: [] };
  assert_eq(cases_summary(Property, kept), "200 cases · 0 rejected");
  let few: Cases = {
    generated: 200,
    kept: 3,
    rejected: 197,
    roots: [0, 1],
    instantiations: [{ var: "a", ty: "Int" }],
  };
  assert_eq(
    cases_summary(Example, few),
    "3 of 200 cases kept · guard rejected 197 · 2 roots · a := Int",
  )
}

test "a gap says what stopped it, and a vacuity what the guard admits" {
  assert_eq(gap_summary(UnhandledEffect(None)), "no handler for what it performs");
  assert_eq(
    gap_summary(UnhandledEffect(Some("{db.read[rows]}"))),
    "performs {db.read[rows]}: no handler",
  );
  assert_eq(
    gap_summary(ReachesHost("{db.read[users]}")),
    "reaches the host ({db.read[users]}); run `ply prove --host`",
  );
  assert_eq(
    gap_summary(Ungeneratable({ param: "f", ty: "(Int) -> Int" })),
    "no value of `(Int) -> Int` can be generated for `f`",
  );
  assert_eq(vacuity_summary(Unsatisfiable), "the guard admits no value");
  assert_eq(vacuity_summary(NoCaseKept(200)), "the guard kept none of 200 cases")
}

test "a row is the tier, the claim and what it rests on, in fixed columns" {
  let r: Row = {
    claim: a_claim("m.one", Ensures(0)),
    outcome: proved(Array([Str("congruence")]), 2),
    reason: Fresh,
    reach: None,
  };
  assert_eq(
    row_head(plain(), r, [a_place()]),
    "   ✓ proved      m.one ensures #0                         congruence · 2 steps",
  )
}

test "a refuted claim is E0419 over the claim, and a gap is W0604 over the same place" {
  let refuted: Row = {
    claim: a_claim("m.short", Law(Some("a batch is small"))),
    outcome: Refuted(a_counter()),
    reason: Fresh,
    reach: None,
  };
  let ds = diagnostics_of([refuted]);
  assert_eq(len(ds), 1);
  let d: Diag = match list_at(ds, 0) { Some(x) -> x, None -> panic("one diagnostic") };
  assert_eq(d.code, b"E0419");
  assert_eq(d.severity, b"error");
  assert_eq(d.message, b"law \"a batch is small\" is false at xs = [0, 0]");
  assert_eq(d.notes_text, [
    b"forall (xs: List<Int>)",
    b"shrank from xs = [7, 9] in 2 steps",
    b"root 0 \xc2\xb7 case 11",
  ]);
  let gap: Row = {
    claim: a_claim("m.stored", Ensures(0)),
    outcome: Unattempted(UnhandledEffect(Some("{db.read[rows]}"))),
    reason: Fresh,
    reach: None,
  };
  let warnings = diagnostics_of([gap]);
  let w: Diag = match list_at(warnings, 0) { Some(x) -> x, None -> panic("one diagnostic") };
  assert_eq(w.code, b"W0604");
  assert_eq(w.severity, b"warning");
  assert_eq(
    w.message,
    b"m.stored ensures #0 was not discharged: performs {db.read[rows]}: no handler",
  )
}

pub fn a_fault() -> Fault =
  {
    code: "E0505",
    message: "the compiled tier declined to enter `m.law`",
    notes: ["this is Ply's fault, not the program's"],
    values: [],
    bindings: [{ name: "b", ty: "Bool", value: VBool(true) }],
  }

test "Ply's failure is its own error over the claim, never the program's gap" {
  let r: Row = {
    claim: a_claim("m.one", Ensures(0)),
    outcome: Defect(a_fault()),
    reason: Fresh,
    reach: None,
  };
  let d: Diag = match diagnostics_of([r]) { [x] -> x, _ -> panic("one diagnostic") };
  assert_eq(d.code, b"E0505");
  assert_eq(d.severity, b"error");
  assert_eq(
    d.message,
    b"m.one ensures #0 was not discharged: Ply failed rather than the program, so this is a defect in Ply: the compiled tier declined to enter `m.law`",
  );
  assert_eq(d.notes_text, [b"this is Ply's fault, not the program's", b"at b = true"]);
  assert_eq(unattempted_of([r]), 0);
  assert_eq(defect_of([r]), 1);
  // It fails the run, as a defect fails `ply test`, and it establishes nothing.
  assert_eq(code_of([r]), failure());
  assert(
    string_starts_with(
      row_head(plain(), r, [a_place()]),
      "   ! defect      m.one ensures #0                         Ply failed rather than the program",
    ),
  );
  let row: ClaimRow = match claim_rows(a_collection_of([r.claim]), [0], [r.outcome]) {
    [x] -> x,
    _ -> panic("one row"),
  };
  assert_eq(row.holds, false);
  assert_eq(row.discharged, false);
  assert_eq(row.tier, None)
}

fn a_collection_of(cs: List<Claim>) -> Collection =
  { places: [a_place()], warnings: [], claims: cs, defs: [], laws: [], plan: a_plan() }

test "a claim that holds raises nothing at all" {
  let held: Row = {
    claim: a_claim("m.one", Ensures(0)),
    outcome: proved(Array([]), 1),
    reason: FromProof,
    reach: None,
  };
  assert_eq(len(diagnostics_of([held])), 0)
}

test "the coverage line leads with the surface, and names what is left to read" {
  let cov: Coverage = {
    definitions: 3,
    covered: 0,
    uncovered: ["m.double", "m.main", "m.triple"],
    by_tier: [],
  };
  assert_eq(coverage_lines(plain(), cov, 0, false), [
    "   3 definitions · 0 carry an obligation · 3 do not",
    "   3 not covered by a claim that holds: m.double, m.main, m.triple",
  ])
}

test "past six uncovered definitions the rest are counted rather than listed" {
  let names = map(range(0, 8), |i: Int| "m.d" ++ int_to_string(i));
  let cov: Coverage = { definitions: 8, covered: 0, uncovered: names, by_tier: [] };
  let lines = coverage_lines(plain(), cov, 0, false);
  assert(string_contains(nth(lines, 1), "and 2 more (`--explain` for all)"));
  assert(!string_contains(nth(lines, 1), "m.d6"));
  assert(string_contains(nth(coverage_lines(plain(), cov, 0, true), 1), "m.d7"))
}

test "seconds are two places, whatever the clock read" {
  assert_eq(seconds(0.974m), "0.00");
  assert_eq(seconds(1500m), "1.50");
  assert_eq(seconds(12345.6m), "12.35");
  assert_eq(seconds(decimal_of_int(0)), "0.00")
}

// The empty job: nothing bound, nothing cached, the defaults.
pub fn no_options() -> Options =
  {
    path: ".",
    no_incremental: false,
    no_cache: false,
    std: false,
    jobs: None,
    host: false,
    tls: [],
    trust: [],
    fs: [],
    config: machine::default_options().config,
    trace: machine::default_options().trace,
    prove: { cases: None, roots: None, budget: None, shrink_budget: None, steps: None },
    sim: machine::no_sim_options(),
  }

// A collection with nothing of this side's in it yet, from what the runtime loaded: what a fixture
// hands a run that is told what the runtime answered.
pub fn collected_part(c: Collection) -> Collected =
  { places: c.places, warnings: c.warnings, plan: c.plan }

pub fn claimed_part(c: Collection) -> Claimed =
  { claims: c.claims, defs: c.defs, laws: c.laws, warnings: [] }

// The world a run whose claims a fixture spells out hands the runtime: the fixture's runtime reads
// none of it.
pub fn no_world() -> World = { decls: [], signatures: [], obligations: [] }
