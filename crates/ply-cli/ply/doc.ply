//! `ply doc` — what a name documents, as an agent reads it. A definition: its signature with the
//! parameter names the source wrote, its doc and clauses, its place, hash and footprint, and the
//! laws that name it. A law schema: the same, under the schema as it is written. A type, an effect
//! or a module: its doc and its members'. A builtin: what the prelude declares. Each page is read
//! off what its module answers it documents, which the memo store keeps for a project's modules
//! and the toolchain carries for the standard library's, so no command parses a module to print
//! one. A name under `std` is the toolchain's wherever the command runs; any other is looked for
//! in the program, then among the builtins, then the standard library.

import env (env)
import compiler.unit (shipped)
import std.random (entropy)
import std.time (time)
import builder (builder)
import args (Flags, style_of)
import diagnostic (Place, spot_of)
import program (Program, timed_over, unknown_def, noted, pseudo_path, is_shipped)
import program
import queried (shipped_declaring, shipped_documented)
import report (Answer, schema_version, ok_code, indent, refused, reported)
import sources (is_std, load_resolved, shipped_names)
import sources
import std.term (Style, bold, dim, plain)
import compiler.front (Frame, Outline)
import compiler.infer (Builtin, builtin_named, builtins)
import compiler.items (parse)
import compiler.pages (Page, Member, Typed, Pages, Signed, bare_page, lines_of, signature)
import compiler.prelude_source
import compiler.resolve (Diag, qualify)
import compiler.types (scheme_text)
import std.fs (fs)
import std.json (Json, Null, Str, Bool, Number, Array, object, string_or_null, strings)
import std.list (contains, find)
import std.string (join, index_of)

/// A page as an answer prints it: with the module that declares what it documents, and its place
/// where it has one.
pub type Placed = { page: Page, module: Option<String>, location: Option<String> }

fn unplaced(page: Page) -> Placed = { page: page, module: None, location: None }

/// A doc's first sentence: its first paragraph as one line, up to the first `. `.
pub fn summary_of(doc: List<String>) -> String / {abort.raise} = {
  let first = fold(
    doc,
    { done: false, text: "" },
    |acc: { done: Bool, text: String }, l: String|
      if acc.done { acc }
      else if l == "" { { done: true, text: acc.text } }
      else { { done: false, text: if acc.text == "" { l } else { acc.text ++ " " ++ l } } },
  );
  match index_of(first.text, ". ") {
    Some(i) -> string_slice(first.text, 0, i + 1),
    None -> first.text,
  }
}

// --- The prelude ------------------------------------------------------------------

fn builtin_signature(found: Builtin) -> Signed / {abort.raise} =
  signature(
    "",
    string_of_bytes_lossy(found.name),
    found.scheme,
    map(found.params, |n: Bytes| string_of_bytes_lossy(n)),
  )

fn builtin_page(query: String) -> Option<Page> / {abort.raise} =
  match builtin_named(bytes_of_string(query)) {
    None -> None,
    Some(found) -> {
      let signed: Signed = builtin_signature(found);
      Some({
        ..bare_page("builtin", string_of_bytes_lossy(found.name), signed.text),
        ty: string_of_bytes_lossy(scheme_text(found.scheme)),
        params: signed.params,
        doc: map(found.doc, |l: Bytes| string_of_bytes_lossy(l)),
        clauses: map(found.clauses, |c: Bytes| string_of_bytes_lossy(c)),
      })
    },
  }

/// The prelude as a module: its doc, and every builtin by summary.
fn prelude_page() -> Page / {abort.raise} =
  {
    ..bare_page("module", "prelude", "prelude"),
    doc: lines_of(parse(prelude_source::text()).node.doc),
    members: map(builtins(), |b: Builtin|
      {
        kind: "builtin",
        name: string_of_bytes_lossy(b.name),
        signature: builtin_signature(b).text,
        doc: map(b.doc, |l: Bytes| string_of_bytes_lossy(l)),
      }),
  }

// --- Naming one thing --------------------------------------------------------------

/// A query that names nothing may still name a builtin, which the page for it says.
fn unknown_name(query: String, names: List<String>) -> Diag = {
  let d: Diag = unknown_def(query, names);
  if len(names) > 0 { d }
  else { noted(d, b"a builtin is named by its bare name, as in `ply doc map`") }
}

/// A page, beside the module that documents it.
type Held = { module: Bytes, page: Page }

type Lookup = | Found(Placed) | Many(List<String>) | Nothing

/// The modules a full name may be under: each whose name it is, or leads it.
fn holding(modules: List<Bytes>, q: Bytes) -> List<Bytes> =
  filter(modules, |m: Bytes| q == m || bytes_starts_with(q, bytes_concat(m, b".")))

/// Each page of each of `modules`, as `documented` answers them in that order.
fn held_of(modules: List<Bytes>, documented: List<Pages>) -> List<Held> =
  fold(range(0, len(modules)), [], |acc: List<Held>, i: Int|
    match ((list_at(modules, i), list_at(documented, i))) {
      (Some(m), Some(d)) ->
        fold(d.pages, acc, |held: List<Held>, page: Page| push(held, { module: m, page: page })),
      _ -> acc,
    })

fn label(h: Held) -> String =
  if h.page.kind == "definition" { h.page.name } else { h.page.name ++ " (" ++ h.page.kind ++ ")" }

/// The page a query names: a full name, or a simple name that names exactly one. `Err` holds what a
/// simple name matched, and is empty when nothing did.
fn resolved(held: List<Held>, query: String) -> Result<Held, List<String>> =
  match find(held, |h: Held| h.page.name == query) {
    Some(h) -> Ok(h),
    None -> match filter(held, |h: Held| h.page.simple == query) {
      [] -> Err([]),
      [only] -> Ok(only),
      many -> Err(map(many, label)),
    },
  }

/// `path:line:col`, one-based, as every other command prints a place.
fn place_in(path: String, text: Bytes, at: Int) -> String / {abort.raise} = {
  let spot = spot_of(text, at);
  path ++ ":" ++ int_to_string(spot.line) ++ ":" ++ int_to_string(spot.col)
}

/// A page of a module read at `path`, whose text is `text`: a module's own page stands at its file,
/// and any other where the text declares it.
fn placed(h: Held, path: String, text: Bytes) -> Placed / {abort.raise} =
  if h.page.kind == "module" { { page: h.page, module: None, location: Some(path) } } else {
    {
      page: h.page,
      module: Some(string_of_bytes_lossy(h.module)),
      location: Some(place_in(path, text, h.page.at)),
    }
  }

fn looked<| e>(
  found: Result<Held, List<String>>,
  place: (Held) -> Placed / {abort.raise | e},
) -> Lookup / {abort.raise | e} =
  match found {
    Ok(h) -> Found(place(h)),
    Err(names) -> if len(names) > 0 { Many(names) } else { Nothing },
  }

/// What a simple name's first word is: the declaration an `effect.op` is under, or the name itself.
fn head_of(q: Bytes) -> Bytes / {abort.raise} =
  match bytes_index_of(q, b".") { Some(i) -> bytes_slice(q, 0, i), None -> q }

/// A name among the standard library's modules: under the module that leads a full name, or in
/// whichever declares a simple one.
fn shipped_named(
  query: String,
) -> Lookup / {fs.list_dir[shipped], fs.read_file[shipped], shipped.answer, abort.raise} = {
  let q = bytes_of_string(query);
  let under = holding(filter(shipped_names(), |n: Bytes| is_std(string_of_bytes_lossy(n))), q);
  let asked = if len(under) > 0 { under }
  else { match map_get(shipped_declaring(), q) { Some(modules) -> modules, None -> [] } };
  looked(resolved(held_of(asked, shipped_documented(asked)), query), |h: Held| {
    let module = string_of_bytes_lossy(h.module);
    placed(h, pseudo_path(module), match fs.read_file[shipped](module ++ ".ply") {
      Some(text) -> text,
      None -> b"",
    })
  })
}

/// A name the program does not hold: a builtin's, else one of the standard library's.
fn elsewhere(
  query: String,
) -> Lookup / {fs.list_dir[shipped], fs.read_file[shipped], shipped.answer, abort.raise} =
  if query == "prelude" { Found(unplaced(prelude_page())) } else {
    match builtin_page(query) { Some(page) -> Found(unplaced(page)), None -> shipped_named(query) }
  }

/// Whether the module `o` outlines could declare what a simple name whose first word is `head`
/// names: a function, a type or an effect its outline lists, or an effect set, which it does not.
fn could_declare(o: Outline, head: Bytes) -> Bool =
  len(o.set_texts) > 0 || contains(o.declared, qualify(o.name, head))

/// A name among a load's modules, its own and each it pulled: under the module that leads a full
/// name, or in whichever could declare a simple one.
fn in_program(
  flags: Flags,
  project: sources::Project,
  loaded: Program,
  frame: Frame,
) -> Lookup / {fs.list_dir[shipped], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], fs.read_file[shipped], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], shipped.answer, abort.raise} = {
  let q = bytes_of_string(flags.query);
  let under = holding(map(frame.outlines, |o: Outline| o.name), q);
  let asked = if len(under) > 0 { under } else {
    let head = head_of(q);
    map(filter(frame.outlines, |o: Outline| could_declare(o, head)), |o: Outline| o.name)
  };
  let documented = program::documented(
    flags.paths,
    project,
    map(asked, |m: Bytes|
      { module: m, shipped: is_shipped(string_of_bytes_lossy(m)), tested: false }),
  );
  looked(resolved(held_of(asked, documented), flags.query), |h: Held| {
    let at = fold(range(0, len(frame.outlines)), None, |found: Option<Place>, i: Int|
      match found {
        Some(_) -> found,
        None -> match list_at(frame.outlines, i) {
          Some(o) -> if o.name == h.module { list_at(loaded.places, i) } else { None },
          None -> None,
        },
      });
    match at {
      Some(place) -> placed(h, place.path, place.text),
      None -> { page: h.page, module: Some(string_of_bytes_lossy(h.module)), location: None },
    }
  })
}

// --- The answer -----------------------------------------------------------------

fn joined_lines(lines: List<String>) -> String =
  fold(range(0, len(lines)), "", |acc: String, i: Int|
    match list_at(lines, i) { Some(l) -> if i == 0 { l } else { acc ++ "\n" ++ l }, None -> acc })

fn member_json(m: Member) -> Json / {abort.raise} =
  object([
    { key: "kind", value: Str(m.kind) },
    { key: "name", value: Str(m.name) },
    { key: "signature", value: Str(m.signature) },
    { key: "doc", value: Str(joined_lines(m.doc)) },
    { key: "summary", value: Str(summary_of(m.doc)) },
  ])

fn page_json(p: Placed) -> Json / {abort.raise} = {
  let page = p.page;
  object([
    { key: "command", value: Str("doc") },
    { key: "schema_version", value: Number(decimal_of_int(schema_version())) },
    { key: "ok", value: Bool(true) },
    { key: "exit_code", value: Number(decimal_of_int(ok_code())) },
    { key: "kind", value: Str(page.kind) },
    { key: "name", value: Str(page.name) },
    { key: "signature", value: Str(page.signature) },
    { key: "type", value: Str(page.ty) },
    {
      key: "params",
      value: Array(
        map(page.params, |named: Typed|
          object([{ key: "name", value: Str(named.name) }, { key: "type", value: Str(named.ty) }])),
      ),
    },
    { key: "doc", value: Str(joined_lines(page.doc)) },
    { key: "summary", value: Str(summary_of(page.doc)) },
    { key: "clauses", value: strings(page.clauses) },
    { key: "members", value: Array(map(page.members, member_json)) },
    { key: "module", value: string_or_null(p.module) },
    { key: "location", value: string_or_null(p.location) },
    { key: "hash", value: string_or_null(page.hash) },
    { key: "footprint", value: string_or_null(page.footprint) },
    { key: "laws", value: strings(page.laws) },
  ])
}

fn said(style: Style, label: String, value: Option<String>, lines: List<String>) -> List<String> =
  match value { None -> lines, Some(v) -> push(lines, indent() ++ dim(style, label) ++ " " ++ v) }

fn listed(style: Style, label: String, names: List<String>, lines: List<String>) -> List<String> =
  if len(names) == 0 { lines } else {
    push(
      lines,
      indent() ++ dim(style, label) ++ " " ++ join(map(names, |n: String| "\"" ++ n ++ "\""), ", "),
    )
  }

/// A module lists what it publishes by summary; a type or an effect gives each member its whole doc.
fn member_lines(whole: Bool, m: Member, lines: List<String>) -> List<String> / {abort.raise} = {
  let head = push(push(lines, ""), indent() ++ m.signature);
  let words = if whole { m.doc } else {
    let s = summary_of(m.doc);
    if s == "" { [] } else { [s] }
  };
  fold(words, head, |acc: List<String>, l: String| push(acc, deep(l)))
}

/// A line of prose under a heading; an empty one stays empty rather than ending in blanks.
fn deep(l: String) -> String = if l == "" { "" } else { indent() ++ indent() ++ l }

pub fn page_text(style: Style, p: Placed) -> List<String> / {abort.raise} = {
  let page = p.page;
  let head = fold(
    page.doc,
    ["", indent() ++ bold(style, page.signature)],
    |acc: List<String>, l: String| push(acc, deep(l)),
  );
  let clauses = fold(page.clauses, head, |acc: List<String>, c: String|
    push(acc, indent() ++ indent() ++ dim(style, c)));
  let members = fold(page.members, clauses, |acc: List<String>, m: Member|
    member_lines(page.kind != "module", m, acc));
  let stood = said(style, "at", p.location, push(members, ""));
  let touched = said(style, "touches", page.footprint, stood);
  let hashed = said(style, "hash", page.hash, touched);
  let lawed = listed(style, "laws", page.laws, hashed);
  let kinded = match p.location {
    Some(_) -> lawed,
    None -> push(lawed, indent() ++ dim(style, "kind") ++ " " ++ page.kind),
  };
  push(kinded, "")
}

fn answered(style: Style, p: Placed) -> Answer / {abort.raise} =
  { json: page_json(p), lines: page_text(style, p), errs: [], code: ok_code() }

/// The answer for a name no program holds: a builtin's page or a standard library module's, else
/// `fallback`, what refused the program, or that nothing is so named, beside `more`.
fn looked_elsewhere(
  style: Style,
  query: String,
  places: List<Place>,
  fallback: List<Diag>,
  more: List<Diag>,
) -> Answer / {fs.list_dir[shipped], fs.read_file[shipped], shipped.answer, abort.raise} =
  match elsewhere(query) {
    Found(p) -> answered(style, p),
    Many(names) -> reported(style, "doc", [unknown_name(query, names)], places),
    Nothing -> if len(fallback) > 0 { refused(style, "doc", fallback, places) }
    else { reported(style, "doc", push_all([unknown_name(query, [])], more), places) },
  }

fn push_all(to: List<Diag>, more: List<Diag>) -> List<Diag> =
  fold(more, to, |acc: List<Diag>, d: Diag| push(acc, d))

/// The page for a name where no package holds the working directory: a builtin's or a standard
/// library module's, which no project decides. `nowhere` says so beside a name neither holds.
pub fn unrooted(
  flags: Flags,
  nowhere: Diag,
) -> Answer / {fs.list_dir[shipped], fs.read_file[shipped], shipped.answer, abort.raise} =
  looked_elsewhere(style_of(flags), flags.query, [], [], [nowhere])

pub fn run(
  flags: Flags,
) -> Answer / {shipped.answer, env.reused[sys], builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, time.elapsed_ms, abort.raise, diverges, shipped.reached} = {
  let s = style_of(flags);
  // `std` is the toolchain's: its pages are the same wherever the command runs, and no project is
  // read for one.
  if is_std(flags.query) { looked_elsewhere(s, flags.query, [], [], []) } else {
    let project = load_resolved(flags.paths);
    let loaded: Program = timed_over(flags.paths, project, time.elapsed_ms()).program;
    match loaded.frame {
      None -> looked_elsewhere(s, flags.query, loaded.places, loaded.diags, []),
      Some(frame) -> match in_program(flags, project, loaded, frame) {
        Found(p) -> answered(s, p),
        Many(names) -> reported(s, "doc", [unknown_name(flags.query, names)], loaded.places),
        Nothing -> looked_elsewhere(s, flags.query, loaded.places, [], []),
      },
    }
  }
}

// --- Tests ------------------------------------------------------------------

test "a doc's summary is its first sentence, its first paragraph joined into one line" {
  assert_eq(
    summary_of(["The bound a fresh server starts with.", "It is positive."]),
    "The bound a fresh server starts with.",
  );
  assert_eq(
    summary_of(["One line that runs on", "to a second, and stops", "", "Then more."]),
    "One line that runs on to a second, and stops",
  );
  assert_eq(summary_of(["`1.5` is not `1.50`. Equal, though."]), "`1.5` is not `1.50`.");
  assert_eq(summary_of([]), "")
}

test "a builtin prints with the parameter names and the doc the prelude declares" {
  match builtin_page("map") {
    None -> panic("`map` is a builtin"),
    Some(page) -> {
      assert_eq(page.kind, "builtin");
      assert_eq(page.signature, "map<a, b | e>(xs: List<a>, f: (a) -> b / e) -> List<b> / e")
    },
  };
  match builtin_page("list_at") {
    None -> panic("`list_at` is a builtin"),
    Some(page) -> assert_eq(page.doc, ["`None` if `i` is negative or past the end."]),
  };
  match builtin_page("len") {
    None -> panic("`len` is a builtin"),
    Some(page) -> assert_eq(page.signature, "len<a>(xs: List<a>) -> Int"),
  };
  match builtin_page("bytes_at") {
    None -> panic("`bytes_at` is a builtin"),
    Some(page) ->
      assert_eq(page.clauses, [
        "requires 0 <= i && i < bytes_len(b)",
        "ensures 0 <= result && result <= 255",
      ]),
  };
  assert_eq(match builtin_page("nothing_here") { Some(_) -> true, None -> false }, false)
}

test "a name nothing declares is `E0101`, and an ambiguous one says which" {
  assert_eq(unknown_name("nothing_here", []).code, b"E0101");
  let many = unknown_name("total", ["a.total", "b.total (effect)"]);
  assert_eq(many.message, b"`total` names 2 definitions");
  assert_eq(many.notes_text, [b"one of: a.total, b.total (effect)"])
}

/// The pages two modules document, each beside its module.
fn two_modules() -> List<Held> =
  held_of([b"a", b"b"], [
    {
      pages: [
        bare_page("module", "a", "a"),
        { ..bare_page("definition", "a.total", "fn total() -> Int"), simple: "total" },
        {
          ..bare_page("operation", "a.ledger.record", "write record() -> Unit"),
          simple: "ledger.record",
        },
      ],
    },
    {
      pages: [
        bare_page("module", "b", "b"),
        { ..bare_page("effect", "b.total", "effect total"), simple: "total" },
      ],
    },
  ])

test "a query names a page by its full name, or by a simple name only one page goes by" {
  let named = |query: String|
    match resolved(two_modules(), query) { Ok(h) -> [h.page.name], Err(names) -> names };
  assert_eq(named("a.total"), ["a.total"]);
  assert_eq(named("b"), ["b"]);
  assert_eq(named("ledger.record"), ["a.ledger.record"]);
  assert_eq(named("total"), ["a.total", "b.total (effect)"]);
  assert_eq(named("nothing_here"), []);
  // A full name is under the module that leads it, and under no other.
  assert_eq(holding([b"a", b"ab", b"a.b"], b"a.b.c"), [b"a", b"a.b"])
}

test "a page with no place names its kind instead" {
  let page: Page = {
    ..bare_page("builtin", "len", "len<a>(xs: List<a>) -> Int"),
    ty: "<a>(List<a>) -> Int",
    params: [{ name: "xs", ty: "List<a>" }],
  };
  assert_eq(page_text(plain(), unplaced(page)), [
    "",
    "   len<a>(xs: List<a>) -> Int",
    "",
    "   kind builtin",
    "",
  ])
}

test "a module lists each member by summary, and a type gives each member its whole doc" {
  let members = [
    { kind: "definition", name: "one", signature: "pub fn one() -> Int", doc: ["One. And more."] },
  ];
  assert_eq(
    page_text(plain(), {
      page: { ..bare_page("module", "m", "m"), members: members },
      module: None,
      location: Some("m.ply"),
    }),
    ["", "   m", "", "   pub fn one() -> Int", "      One.", "", "   at m.ply", ""],
  );
  assert_eq(
    page_text(plain(), {
      page: { ..bare_page("type", "m.T", "type T"), members: members },
      module: Some("m"),
      location: Some("m.ply:1:1"),
    }),
    [
      "",
      "   type T",
      "",
      "   pub fn one() -> Int",
      "      One. And more.",
      "",
      "   at m.ply:1:1",
      "",
    ],
  )
}

test "a page says the laws that name what it documents, and where it stands by line and column" {
  let h: Held = {
    module: b"m",
    page: {
      ..bare_page("definition", "m.twice", "pub fn twice(n: Int) -> Int"),
      simple: "twice",
      at: 12,
      laws: ["twice doubles"],
    },
  };
  let p = placed(h, "m.ply", b"// a line\n  fn twice");
  assert_eq(p.module, Some("m"));
  assert_eq(p.location, Some("m.ply:2:3"));
  assert_eq(page_text(plain(), p), [
    "",
    "   pub fn twice(n: Int) -> Int",
    "",
    "   at m.ply:2:3",
    "   laws \"twice doubles\"",
    "",
  ])
}

test "the prelude is a module page: its doc and every builtin with its own" {
  let page = prelude_page();
  assert_eq(page.kind, "module");
  assert(len(page.doc) > 0);
  assert_eq(len(page.members), len(builtins()));
  let at = filter(page.members, |m: Member| m.name == "list_at");
  assert_eq(map(at, |m: Member| m.doc), [["`None` if `i` is negative or past the end."]])
}
