// `ply doc` — one definition or builtin as an agent reads it: the signature with the parameter
// names the source wrote, the comment above it, its place, its hash and what it touches.

import std.random (entropy)
import std.time (time)
import builder (builder)
import args (Flags, style_of)
import program (Program, load_program, published, tables_of, location_of, place_of, hash_of,
                resolve_def, unknown_def, noted)
import report (Answer, schema_version, ok_code, indent, refused, reported)
import style (Style, bold, dim)
import compiler.front (Analysis)
import compiler.infer (DefInfo, builtin_named)
import compiler.items (Item, IFn, FnDef, Vis, VPub, VPriv)
import compiler.exprs (Param)
import compiler.resolve (ParsedModule, Diag, qualify)
import compiler.types (Printer, Scheme, Type, TyFn, printer_new, print_scheme, print_ty, print_row,
                       scheme_text, row_text)
import std.fs (fs)
import std.json (Json, Null, Str, Bool, Number, Array, object, string_or_null)
import std.string (join)

pub type Named = { name: String, ty: String }

pub type Page = {
  kind: String,
  name: String,
  signature: String,
  ty: String,
  params: List<Named>,
  doc: List<String>,
  note: String,
  module: Option<String>,
  location: Option<String>,
  hash: Option<String>,
  footprint: Option<String>,
}

// --- The signature ----------------------------------------------------------
// `prefix name<generics>(p: T, ...) -> R / row`, with the parameters named as the source did and
// every variable named by one printer, so the generics, the parameters and the row agree.

type Printing = { printer: Printer, pairs: List<Named> }

pub type Signed = { text: String, params: List<Named> }

fn printed_params(
  printer: Printer,
  ts: List<Type>,
  names: List<String>,
) -> Printing / {abort.raise} =
  fold(range(0, len(ts)), { printer: printer, pairs: [] }, |acc: Printing, i: Int|
    match list_at(ts, i) {
      None -> acc,
      Some(t) -> {
        let out = print_ty(acc.printer, t);
        let written = match list_at(names, i) { Some(n) -> n, None -> "_" ++ int_to_string(i) };
        {
          printer: out.printer,
          pairs: push(acc.pairs, { name: written, ty: string_of_bytes_lossy(out.text) }),
        }
      },
    })

// What the scheme prints before its first `(`: the quantifier list, or nothing.
fn generics_of(full: Bytes) -> String / {abort.raise} =
  match bytes_index_of(full, b"(") {
    Some(i) -> string_of_bytes_lossy(bytes_slice(full, 0, i)),
    None -> "",
  }

pub fn signature(
  prefix: String,
  name: String,
  scheme: Scheme,
  names: List<String>,
) -> Signed / {abort.raise} = {
  let full = print_scheme(printer_new(), scheme);
  match scheme.ty {
    TyFn(f) -> {
      let ps: Printing = printed_params(full.printer, f.params, names);
      let row = print_row(ps.printer, f.effects);
      let effects = if row.text == b"{}" { "" } else { " / " ++ string_of_bytes_lossy(row.text) };
      let ret = print_ty(row.printer, f.ret);
      {
        text: prefix ++ name ++ generics_of(full.text) ++ "("
          ++ join(map(ps.pairs, |named: Named| named.name ++ ": " ++ named.ty), ", ")
          ++ ") -> "
          ++ string_of_bytes_lossy(ret.text)
          ++ effects,
        params: ps.pairs,
      }
    },
    _ -> { text: prefix ++ name ++ ": " ++ string_of_bytes_lossy(full.text), params: [] },
  }
}

// --- The comment above a definition -------------------------------------------

fn last_newline(text: Bytes) -> Option<Int> / {abort.raise} =
  fold(range(0, bytes_len(text)), None, |acc: Option<Int>, i: Int|
    if bytes_at(text, i) == 10 { Some(i) } else { acc })

fn reversed(xs: List<String>) -> List<String> =
  fold(range(0, len(xs)), [], |acc: List<String>, k: Int|
    match list_at(xs, len(xs) - 1 - k) { Some(x) -> push(acc, x), None -> acc })

fn without_trailing_blank(xs: List<String>) -> List<String> =
  if len(xs) > 0 && (match list_at(xs, len(xs) - 1) { Some(l) -> l == "", None -> false }) {
    fold(range(0, len(xs) - 1), [], |acc: List<String>, i: Int|
      match list_at(xs, i) { Some(x) -> push(acc, x), None -> acc })
  } else { xs }

type Taking = { taken: List<String>, stopped: Bool }

fn one_space_off(text: String) -> String / {abort.raise} =
  if string_starts_with(text, " ") { string_slice(text, 1, string_len(text)) } else { text }

fn take_one(acc: Taking, lines: List<String>, i: Int) -> Taking / {abort.raise} =
  if acc.stopped { acc } else {
    let trimmed = string_trim(match list_at(lines, i) { Some(l) -> l, None -> "" });
    if string_starts_with(trimmed, "//") {
      {
        taken: push(acc.taken, one_space_off(string_slice(trimmed, 2, string_len(trimmed)))),
        stopped: false,
      }
    } else { { taken: acc.taken, stopped: true } }
  }

// The `//` lines directly above the definition, stopping at a blank or non-comment line.
pub fn comment_above(text: Bytes, start: Int) -> List<String> / {abort.raise} = {
  let head = bytes_slice(text, 0, if start > bytes_len(text) { bytes_len(text) } else { start });
  let cut = match last_newline(head) { Some(i) -> i + 1, None -> 0 };
  let lines = without_trailing_blank(
    string_split(string_of_bytes_lossy(bytes_slice(head, 0, cut)), "\n"),
  );
  let out: Taking = fold(
    range(0, len(lines)),
    { taken: [], stopped: false },
    |acc: Taking, k: Int| take_one(acc, lines, len(lines) - 1 - k),
  );
  reversed(out.taken)
}

// --- What the source wrote for one definition ----------------------------------

pub type Written = { public: Bool, reuse: Bool, params: List<String> }

fn of_fn(d: FnDef) -> Written =
  {
    public: match d.vis { VPub -> true, VPriv -> false },
    reuse: match d.reuse { Some(_) -> true, None -> false },
    params: map(d.params, |p: Param| string_of_bytes_lossy(p.name.name)),
  }

fn written_in(parsed: ParsedModule, name: Bytes, acc: Option<Written>) -> Option<Written> =
  fold(parsed.module.items, acc, |a: Option<Written>, it: Item|
    match a {
      Some(_) -> a,
      None -> match it {
        IFn(d) -> if qualify(parsed.name, d.name.name) == name { Some(of_fn(d)) } else { None },
        _ -> None,
      },
    })

pub fn written_of(analysis: Analysis, name: Bytes) -> Written =
  match fold(analysis.mods, None, |acc: Option<Written>, parsed: ParsedModule|
      written_in(parsed, name, acc)) {
    Some(x) -> x,
    None -> { public: false, reuse: false, params: [] },
  }

// --- The pages ------------------------------------------------------------------

fn definition_page(
  program: Program,
  analysis: Analysis,
  def_info: DefInfo,
) -> Page / {abort.raise} = {
  let written: Written = written_of(analysis, def_info.name);
  let prefix = (if written.public { "pub " } else { "" })
    ++ (if written.reuse { "reuse " } else { "" })
    ++ "fn ";
  let signed: Signed = signature(
    prefix,
    string_of_bytes_lossy(def_info.simple_name),
    def_info.scheme,
    written.params,
  );
  {
    kind: "definition",
    name: string_of_bytes_lossy(def_info.name),
    signature: signed.text,
    ty: string_of_bytes_lossy(scheme_text(def_info.scheme)),
    params: signed.params,
    doc: match place_of(program, def_info.at) {
      Some(place) -> comment_above(place.text, def_info.at.span.start),
      None -> [],
    },
    note: "",
    module: Some(string_of_bytes_lossy(def_info.module)),
    location: location_of(program, def_info.at),
    hash: hash_of(tables_of(analysis.hashes), def_info.name),
    footprint: Some(string_of_bytes_lossy(row_text({ atoms: def_info.footprint, tail: None }))),
  }
}

fn builtin_page(query: String) -> Option<Page> / {abort.raise} =
  match builtin_named(bytes_of_string(query)) {
    None -> None,
    Some(found) -> {
      let signed: Signed = signature(
        "",
        string_of_bytes_lossy(found.name),
        found.scheme,
        map(found.params, |n: Bytes| string_of_bytes_lossy(n)),
      );
      Some({
        kind: "builtin",
        name: string_of_bytes_lossy(found.name),
        signature: signed.text,
        ty: string_of_bytes_lossy(scheme_text(found.scheme)),
        params: signed.params,
        doc: [],
        note: string_of_bytes_lossy(found.note),
        module: None,
        location: None,
        hash: None,
        footprint: None,
      })
    },
  }

// --- Naming one definition --------------------------------------------------------

// A query that names nothing may still name a builtin, which the page for it says.
fn unknown_name(query: String, names: List<String>) -> Diag = {
  let d: Diag = unknown_def(query, names);
  if len(names) > 0 { d }
  else { noted(d, b"a builtin is named by its bare name, as in `ply doc map`") }
}

pub fn resolve(defs: List<DefInfo>, query: String) -> Result<DefInfo, Diag> =
  match resolve_def(defs, query) { Ok(d) -> Ok(d), Err(names) -> Err(unknown_name(query, names)) }

// --- The answer -----------------------------------------------------------------

fn joined_lines(lines: List<String>) -> String =
  fold(range(0, len(lines)), "", |acc: String, i: Int|
    match list_at(lines, i) { Some(l) -> if i == 0 { l } else { acc ++ "\n" ++ l }, None -> acc })

fn page_json(page: Page) -> Json =
  object([
    { key: "command", value: Str("doc") },
    { key: "schema_version", value: Number(decimal_of_int(schema_version())) },
    { key: "ok", value: Bool(true) },
    { key: "exit_code", value: Number(decimal_of_int(ok_code())) },
    { key: "kind", value: Str(page.kind) },
    { key: "name", value: Str(page.name) },
    { key: "signature", value: Str(page.signature) },
    { key: "type", value: Str(page.ty) },
    {
      key: "params",
      value: Array(
        map(page.params, |named: Named|
          object([{ key: "name", value: Str(named.name) }, { key: "type", value: Str(named.ty) }])),
      ),
    },
    { key: "doc", value: Str(joined_lines(page.doc)) },
    { key: "note", value: Str(page.note) },
    { key: "module", value: string_or_null(page.module) },
    { key: "location", value: string_or_null(page.location) },
    { key: "hash", value: string_or_null(page.hash) },
    { key: "footprint", value: string_or_null(page.footprint) },
  ])

fn said(
  style: Style,
  label: String,
  value: Option<String>,
  lines: List<String>,
) -> List<String> / {abort.raise} =
  match value { None -> lines, Some(v) -> push(lines, indent() ++ dim(style, label) ++ " " ++ v) }

pub fn page_text(style: Style, page: Page) -> List<String> / {abort.raise} = {
  let head = fold(
    page.doc,
    ["", indent() ++ bold(style, page.signature)],
    |acc: List<String>, l: String| push(acc, indent() ++ indent() ++ l),
  );
  let noted = if page.note == "" { head } else { push(head, indent() ++ indent() ++ page.note) };
  let placed = said(style, "at", page.location, push(noted, ""));
  let touched = said(style, "touches", page.footprint, placed);
  let hashed = said(style, "hash", page.hash, touched);
  let kinded = match page.location {
    Some(_) -> hashed,
    None -> push(hashed, indent() ++ dim(style, "kind") ++ " " ++ page.kind),
  };
  push(kinded, "")
}

fn answered(style: Style, page: Page) -> Answer / {abort.raise} =
  { json: page_json(page), lines: page_text(style, page), errs: [], code: ok_code() }

pub fn run(
  flags: Flags,
) -> Answer / {builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shelf], fs.read_file[shelf], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, abort.raise} = {
  let loaded: Program = load_program(flags.paths);
  let s = style_of(flags);
  match loaded.whole {
    None -> match builtin_page(flags.query) {
      Some(page) -> answered(s, page),
      None -> refused(s, "doc", loaded.diags, loaded.places),
    },
    Some(w) -> match resolve(published(w), flags.query) {
      Ok(d) -> answered(s, definition_page(loaded, w, d)),
      Err(unknown) -> match builtin_page(flags.query) {
        Some(page) -> answered(s, page),
        None -> reported(s, "doc", [unknown], loaded.places),
      },
    },
  }
}

// --- Tests ------------------------------------------------------------------

fn documented() -> Bytes =
  b"// The bound a fresh server starts with.\n// It is positive.\npub fn default_limit() -> Int = 100\n\nfn plain() -> Int = 1\n"

test "the comment above a definition is its `//` lines, one leading space off each" {
  assert_eq(comment_above(documented(), 61), [
    "The bound a fresh server starts with.",
    "It is positive.",
  ]);
  // Nothing above the first line, and a blank line stops the walk.
  assert_eq(comment_above(documented(), 0), []);
  assert_eq(comment_above(documented(), 97), [])
}

test "a builtin prints with the parameter names the compiler's table holds" {
  match builtin_page("map") {
    None -> panic("`map` is a builtin"),
    Some(page) -> {
      assert_eq(page.kind, "builtin");
      assert_eq(page.signature, "map<a, b | e>(xs: List<a>, f: (a) -> b / e) -> List<b> / e");
      assert_eq(page.module, None);
      assert_eq(page.location, None)
    },
  };
  match builtin_page("len") {
    None -> panic("`len` is a builtin"),
    Some(page) -> assert_eq(page.signature, "len<a>(xs: List<a>) -> Int"),
  };
  assert_eq(match builtin_page("nothing_here") { Some(_) -> true, None -> false }, false)
}

test "a name nothing declares is `E0101`, and an ambiguous one says which" {
  assert_eq(unknown_name("nothing_here", []).code, b"E0101");
  let many = unknown_name("total", ["a.total", "b.total"]);
  assert_eq(many.message, b"`total` names 2 definitions");
  assert_eq(many.notes_text, [b"one of: a.total, b.total"])
}

test "a page with no place names its kind instead" {
  let page: Page = {
    kind: "builtin",
    name: "len",
    signature: "len<a>(xs: List<a>) -> Int",
    ty: "<a>(List<a>) -> Int",
    params: [{ name: "xs", ty: "List<a>" }],
    doc: [],
    note: "",
    module: None,
    location: None,
    hash: None,
    footprint: None,
  };
  assert_eq(page_text({ styled: false }, page), [
    "",
    "   len<a>(xs: List<a>) -> Int",
    "",
    "   kind builtin",
    "",
  ])
}
