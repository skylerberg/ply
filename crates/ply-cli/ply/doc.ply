//! `ply doc` — what a name documents, as an agent reads it. A definition: its signature with the
//! parameter names the source wrote, its doc and clauses, its place, hash and footprint, and the
//! tests and laws that name it. A law schema: the same, under the schema as it is written. A type,
//! an effect or a module: its doc and its members'. A builtin: what the prelude declares. A name
//! the program does not hold is looked for among the builtins, then the shipped modules.

import compiler.unit (shipped)
import std.random (entropy)
import std.time (time)
import builder (builder)
import args (Flags, style_of)
import diagnostic (Place, spot_of)
import program (Program, Tables, load_program, published, tables_of, hash_of, unknown_def, noted,
                pseudo_path)
import report (Answer, schema_version, ok_code, indent, refused, reported)
import sources (is_std, shipped_modules)
import style (Style, bold, dim)
import compiler.diagnostics (ParsedSource, parse_all)
import compiler.front (Analysis, Analysed, Refused, analyse)
import compiler.infer (DefInfo, TestInfo, LawInfo, Builtin, builtin_named, builtins)
import compiler.prelude_source
import compiler.items (parse, Item, IFn, IType, IEffect, IEffectSet, FnDef, TypeDef, TDAlias, TDSum,
                       VariantDef, EffectDef, OpDef, EffectSetDef, FieldDoc, SpecClause, ImportDecl,
                       ReturnsFresh, ReturnsParam, Vis, VPub, VPriv, TDNominal, SchemaDef,
                       schema_of)
import compiler.exprs (Param)
import compiler.parsing (Doc, Ident, Span)
import compiler.resolve (ParsedModule, Diag, Source, qualify)
import compiler.type_syntax (TypeExpr, TRecord, ty_span, generics_text)
import compiler.types (Printer, Scheme, Type, TyFn, printer_new, print_scheme, print_ty, print_row,
                       scheme_text, row_text)
import std.bytes
import std.fs (fs)
import std.json (Json, Null, Str, Bool, Number, Array, object, string_or_null, strings)
import std.list (concat, contains, find)
import std.string (join, index_of, replace, trim)

pub type Named = { name: String, ty: String }

/// A variant, field or operation of a declaration, or what a module publishes.
pub type Member = { kind: String, name: String, signature: String, doc: List<String> }

pub type Page = {
  kind: String,
  name: String,
  signature: String,
  ty: String,
  params: List<Named>,
  doc: List<String>,
  clauses: List<String>,
  members: List<Member>,
  module: Option<String>,
  location: Option<String>,
  hash: Option<String>,
  footprint: Option<String>,
  tests: List<String>,
  laws: List<String>,
}

fn bare_page(kind: String, name: String, signature: String) -> Page =
  {
    kind: kind,
    name: name,
    signature: signature,
    ty: "",
    params: [],
    doc: [],
    clauses: [],
    members: [],
    module: None,
    location: None,
    hash: None,
    footprint: None,
    tests: [],
    laws: [],
  }

// --- The signature ----------------------------------------------------------
// `prefix name<generics>(p: T, ...) -> R / row`, with the parameters named as the source did and
// every variable named by one printer, so the generics, the parameters and the row agree.

type Printing = { printer: Printer, pairs: List<Named> }

pub type Signed = { text: String, params: List<Named> }

fn printed_params(
  printer: Printer,
  ts: List<Type>,
  names: List<String>,
) -> Printing / {abort.raise} =
  fold(range(0, len(ts)), { printer: printer, pairs: [] }, |acc: Printing, i: Int|
    match list_at(ts, i) {
      None -> acc,
      Some(t) -> {
        let out = print_ty(acc.printer, t);
        let written = match list_at(names, i) { Some(n) -> n, None -> "_" ++ int_to_string(i) };
        {
          printer: out.printer,
          pairs: push(acc.pairs, { name: written, ty: string_of_bytes_lossy(out.text) }),
        }
      },
    })

/// What the scheme prints before its first `(`: the quantifier list, or nothing.
fn generics_of(full: Bytes) -> String / {abort.raise} =
  match bytes_index_of(full, b"(") {
    Some(i) -> string_of_bytes_lossy(bytes_slice(full, 0, i)),
    None -> "",
  }

pub fn signature(
  prefix: String,
  name: String,
  scheme: Scheme,
  names: List<String>,
) -> Signed / {abort.raise} = {
  let full = print_scheme(printer_new(), scheme);
  match scheme.ty {
    TyFn(f) -> {
      let ps: Printing = printed_params(full.printer, f.params, names);
      let row = print_row(ps.printer, f.effects);
      let effects = if row.text == b"{}" { "" } else { " / " ++ string_of_bytes_lossy(row.text) };
      let ret = print_ty(row.printer, f.ret);
      {
        text: prefix ++ name ++ generics_of(full.text) ++ "("
          ++ join(map(ps.pairs, |named: Named| named.name ++ ": " ++ named.ty), ", ")
          ++ ") -> "
          ++ string_of_bytes_lossy(ret.text)
          ++ effects,
        params: ps.pairs,
      }
    },
    _ -> { text: prefix ++ name ++ ": " ++ string_of_bytes_lossy(full.text), params: [] },
  }
}

// --- Docs -------------------------------------------------------------------

fn lines_of(doc: Option<Doc>) -> List<String> =
  match doc { Some(d) -> map(d.lines, |l: Bytes| string_of_bytes_lossy(l)), None -> [] }

/// A doc's first sentence: its first paragraph as one line, up to the first `. `.
pub fn summary_of(doc: List<String>) -> String / {abort.raise} = {
  let first = fold(
    doc,
    { done: false, text: "" },
    |acc: { done: Bool, text: String }, l: String|
      if acc.done { acc }
      else if l == "" { { done: true, text: acc.text } }
      else { { done: false, text: if acc.text == "" { l } else { acc.text ++ " " ++ l } } },
  );
  match index_of(first.text, ". ") {
    Some(i) -> string_slice(first.text, 0, i + 1),
    None -> first.text,
  }
}

/// Written text on one line: comment lines dropped, each line break one space, and no space or
/// trailing comma left against a closing bracket.
pub fn one_line(text: String) -> String / {abort.raise} = {
  let kept = filter(map(string_split(text, "\n"), |l: String| trim(l)), |l: String|
    l != "" && !string_starts_with(l, "//"));
  let joined = join(kept, " ");
  let closed = replace(replace(replace(joined, ", )", ")"), ", ]", "]"), ", }", " }");
  replace(replace(replace(closed, "( ", "("), "[ ", "["), " )", ")")
}

// --- Where a page reads from ------------------------------------------------------

/// An analysis, and each of its modules' places by the index a location names.
type Shelf = { analysis: Analysis, places: List<Place> }

fn text_of(shelf: Shelf, module: Int) -> Bytes =
  match list_at(shelf.places, module) { Some(p) -> p.text, None -> b"" }

fn sliced(shelf: Shelf, module: Int, span: Span) -> String / {abort.raise} = {
  let text = text_of(shelf, module);
  if span.start > span.end || span.end > bytes_len(text) { "" }
  else { one_line(string_of_bytes_lossy(bytes_slice(text, span.start, span.end))) }
}

/// `path:line:col`, one-based, as every other command prints a place.
fn placed(shelf: Shelf, module: Int, span: Span) -> Option<String> / {abort.raise} =
  match list_at(shelf.places, module) {
    None -> None,
    Some(place) -> {
      let spot = spot_of(place.text, span.start);
      Some(place.path ++ ":" ++ int_to_string(spot.line) ++ ":" ++ int_to_string(spot.col))
    },
  }

fn module_name_at(shelf: Shelf, module: Int) -> Option<String> =
  match list_at(shelf.analysis.mods, module) {
    Some(m) -> Some(string_of_bytes_lossy(m.name)),
    None -> None,
  }

/// The modules a query could name something in: the one its full name is under, and each that
/// declares its simple name.
fn could_name(parsed: ParsedModule, q: Bytes) -> Bool / {abort.raise} =
  q == parsed.name || bytes_starts_with(q, bytes_concat(parsed.name, b"."))
    || len(filter(declared_in(0, parsed), |e: Entry| e.simple == q)) > 0
    || len(
      filter(parsed.module.items, |it: Item| match it { IFn(d) -> d.name.name == q, _ -> false }),
    )
    > 0

fn imports_of(parsed: ParsedModule) -> List<Bytes> =
  map(parsed.module.imports, |d: ImportDecl| bytes::join(map(d.path, |i: Ident| i.name), b"."))

/// `names` and every module they import, transitively.
fn imported_closure(all: List<ParsedSource>, names: List<Bytes>) -> List<Bytes> / {abort.raise} =
  iterate(names, len(all) + 1, |held: List<Bytes>| {
    let grown = fold(all, held, |acc: List<Bytes>, p: ParsedSource|
      if !contains(held, p.name) { acc } else {
        fold(imports_of(p.module), acc, |a: List<Bytes>, n: Bytes|
          if contains(a, n) { a } else { push(a, n) })
      });
    if len(grown) == len(held) { Stop(held) } else { Continue(grown) }
  })

/// The shipped modules a query could name something in, and what they import, analysed apart from any
/// program: where a name no program holds is looked for. A name none of them declares analyses nothing.
fn shipped_shelf(
  query: String,
) -> Option<Shelf> / {builder.git[vcs], fs.list_dir[shipped], fs.read_file[shipped], abort.raise} = {
  let srcs = filter(shipped_modules(), |src: Source| is_std(string_of_bytes_lossy(src.name)));
  let parsed = parse_all(srcs);
  let q = bytes_of_string(query);
  let wanted = map(filter(parsed, |p: ParsedSource| could_name(p.module, q)), |p: ParsedSource|
    p.name);
  if len(wanted) == 0 { None } else {
    let closure = imported_closure(parsed, wanted);
    let chosen = filter(srcs, |src: Source| contains(closure, src.name));
    match analyse(parse_all(chosen)) {
      Refused(_) -> None,
      Analysed(w) -> {
        let texts = fold(chosen, map_new(), |acc: Map<Bytes, Bytes>, src: Source|
          map_insert(acc, src.name, src.src));
        Some({
          analysis: w,
          places: map(w.mods, |m: ParsedModule|
            {
              path: pseudo_path(string_of_bytes_lossy(m.name)),
              text: match map_get(texts, m.name) { Some(t) -> t, None -> b"" },
            }),
        })
      },
    }
  }
}

// --- What a name can name ----------------------------------------------------------

type Target =
  | TDef(DefInfo)
  | TType({ module: Int, def: TypeDef })
  | TEffect({ module: Int, def: EffectDef })
  | TOp({ module: Int, effect: EffectDef, op: OpDef })
  | TSet({ module: Int, def: EffectSetDef })
  | TModule(Int)

/// `simple` is what a query may name it by alone: a declaration's own name, an operation's
/// `effect.op`, and nothing for a module, which only its full name names.
type Entry = { full: Bytes, simple: Bytes, kind: String, target: Target }

fn declared_in(index: Int, parsed: ParsedModule) -> List<Entry> =
  fold(
    parsed.module.items,
    [{ full: parsed.name, simple: b"", kind: "module", target: TModule(index) }],
    |acc: List<Entry>, it: Item|
      match it {
        IType(d) ->
          push(acc, {
            full: qualify(parsed.name, d.name.name),
            simple: d.name.name,
            kind: "type",
            target: TType({ module: index, def: d }),
          }),
        IEffect(d) -> {
          let full = qualify(parsed.name, d.name.name);
          let own = {
            full: full,
            simple: d.name.name,
            kind: "effect",
            target: TEffect({ module: index, def: d }),
          };
          fold(d.ops, push(acc, own), |a: List<Entry>, op: OpDef|
            push(a, {
              full: bytes_concat_all([full, b".", op.name.name]),
              simple: bytes_concat_all([d.name.name, b".", op.name.name]),
              kind: "operation",
              target: TOp({ module: index, effect: d, op: op }),
            }))
        },
        IEffectSet(d) ->
          push(acc, {
            full: qualify(parsed.name, d.name.name),
            simple: d.name.name,
            kind: "effect set",
            target: TSet({ module: index, def: d }),
          }),
        _ -> acc,
      },
  )

fn entries_of(shelf: Shelf) -> List<Entry> = {
  let defs = map(published(shelf.analysis), |d: DefInfo|
    { full: d.name, simple: d.simple_name, kind: "definition", target: TDef(d) });
  fold(range(0, len(shelf.analysis.mods)), defs, |acc: List<Entry>, i: Int|
    match list_at(shelf.analysis.mods, i) {
      Some(m) -> concat(acc, declared_in(i, m)),
      None -> acc,
    })
}

fn entry_label(e: Entry) -> String =
  if e.kind == "definition" { string_of_bytes_lossy(e.full) }
  else { string_of_bytes_lossy(e.full) ++ " (" ++ e.kind ++ ")" }

/// The entry a query names: a full name, or a simple name that names exactly one. `Err` holds what a
/// simple name matched, and is empty when nothing did.
fn resolved(entries: List<Entry>, query: String) -> Result<Entry, List<String>> = {
  let q = bytes_of_string(query);
  match find(entries, |e: Entry| e.full == q) {
    Some(e) -> Ok(e),
    None -> {
      let matching = filter(entries, |e: Entry| e.simple == q);
      match list_at(matching, 0) {
        None -> Err([]),
        Some(e) -> if len(matching) == 1 { Ok(e) } else { Err(map(matching, entry_label)) },
      }
    },
  }
}

// --- The pages ------------------------------------------------------------------

fn visibility(v: Vis) -> String = match v { VPub -> "pub ", VPriv -> "" }

pub type Written = { public: Bool, reuse: Bool, params: List<String> }

fn of_fn(d: FnDef) -> Written =
  {
    public: match d.vis { VPub -> true, VPriv -> false },
    reuse: match d.reuse { Some(_) -> true, None -> false },
    params: map(d.params, |p: Param| string_of_bytes_lossy(p.name.name)),
  }

fn fn_named(parsed: ParsedModule, name: Bytes) -> Option<FnDef> =
  fold(parsed.module.items, None, |acc: Option<FnDef>, it: Item|
    match acc {
      Some(_) -> acc,
      None -> match it {
        IFn(d) -> if qualify(parsed.name, d.name.name) == name { Some(d) } else { None },
        _ -> None,
      },
    })

fn fn_signature(def_info: DefInfo, found: Option<FnDef>) -> Signed / {abort.raise} = {
  let written = match found {
    Some(d) -> of_fn(d),
    None -> { public: false, reuse: false, params: [] },
  };
  let prefix = (if written.public { "pub " } else { "" })
    ++ (if written.reuse { "reuse " } else { "" })
    ++ "fn ";
  signature(prefix, string_of_bytes_lossy(def_info.simple_name), def_info.scheme, written.params)
}

/// What a caller may rely on beyond the signature: what the answer shares, then each clause as written.
fn clauses_of(shelf: Shelf, module: Int, d: FnDef) -> List<String> / {abort.raise} = {
  let returns = match d.returns {
    Some(ReturnsFresh(_)) -> ["returns fresh"],
    Some(ReturnsParam(p)) -> ["returns " ++ string_of_bytes_lossy(p.name)],
    None -> [],
  };
  concat(returns, map(d.spec, |c: SpecClause| sliced(shelf, module, c.span)))
}

type Naming = { tests: List<String>, laws: List<String> }

/// The tests and laws whose own text names `name`: the examples a definition is shown by.
fn named_by(shelf: Shelf, tables: Tables, name: Bytes) -> Naming = {
  let keys = map_fold(
    tables.deps,
    map_new(),
    |acc: Map<Bytes, Bool>, key: Bytes, names: List<Bytes>|
      if contains(names, name) { map_insert(acc, key, true) } else { acc },
  );
  {
    tests: fold(shelf.analysis.checked.tests, [], |acc: List<String>, t: TestInfo|
      if map_contains(keys, t.key) { push(acc, string_of_bytes_lossy(t.name)) } else { acc }),
    laws: fold(shelf.analysis.checked.laws, [], |acc: List<String>, l: LawInfo|
      if map_contains(keys, l.key) { push(acc, string_of_bytes_lossy(l.name)) } else { acc }),
  }
}

/// A schema as it is written: its parameters, its binders and guard, and the body it claims.
fn schema_signature(shelf: Shelf, module: Int, d: SchemaDef) -> String / {abort.raise} =
  visibility(d.vis) ++ sliced(shelf, module, d.span)

/// A definition a schema declares is documented as the schema: what it is written as, and the laws
/// that instantiate it.
fn definition_page(shelf: Shelf, tables: Tables, def_info: DefInfo) -> Page / {abort.raise} = {
  let module = def_info.at.module;
  let parsed = list_at(shelf.analysis.mods, module);
  let found = match parsed { Some(m) -> fn_named(m, def_info.name), None -> None };
  let schema = match ((parsed, found)) { (Some(m), Some(d)) -> schema_of(m.module, d), _ -> None };
  let signed: Signed = fn_signature(def_info, found);
  let naming = named_by(shelf, tables, def_info.name);
  {
    kind: match schema { Some(_) -> "law schema", None -> "definition" },
    name: string_of_bytes_lossy(def_info.name),
    signature: match schema { Some(d) -> schema_signature(shelf, module, d), None -> signed.text },
    ty: string_of_bytes_lossy(scheme_text(def_info.scheme)),
    params: signed.params,
    doc: match found { Some(d) -> lines_of(d.doc), None -> [] },
    clauses: match found { Some(d) -> clauses_of(shelf, module, d), None -> [] },
    members: [],
    module: Some(string_of_bytes_lossy(def_info.module)),
    location: placed(shelf, module, def_info.at.span),
    hash: hash_of(tables, def_info.name),
    footprint: Some(string_of_bytes_lossy(row_text({ atoms: def_info.footprint, tail: None }))),
    tests: naming.tests,
    laws: naming.laws,
  }
}

fn type_head(d: TypeDef) -> String / {abort.raise} =
  visibility(d.vis) ++ "type " ++ string_of_bytes_lossy(d.name.name)
    ++ string_of_bytes_lossy(generics_text(d.generics))

fn field_doc(docs: List<FieldDoc>, name: Bytes) -> List<String> =
  match find(docs, |f: FieldDoc| f.name == name) { Some(f) -> lines_of(Some(f.doc)), None -> [] }

fn type_signature(shelf: Shelf, module: Int, d: TypeDef) -> String / {abort.raise} =
  match d.body {
    TDAlias(t) -> match t {
      TRecord(_) -> type_head(d),
      _ -> type_head(d) ++ " = " ++ sliced(shelf, module, ty_span(t)),
    },
    // Its fields are its members, as an alias's are; the head says it is a type of its own.
    TDNominal(_) -> type_head(d) ++ " = new { .. }",
    TDSum(_) -> type_head(d),
  }

fn type_members(shelf: Shelf, module: Int, d: TypeDef) -> List<Member> / {abort.raise} =
  match d.body {
    TDSum(vs) ->
      map(vs, |v: VariantDef|
        {
          kind: "variant",
          name: string_of_bytes_lossy(v.name.name),
          signature: sliced(shelf, module, v.span),
          doc: lines_of(v.doc),
        }),
    TDAlias(t) -> field_members(shelf, module, d, t),
    TDNominal(t) -> field_members(shelf, module, d, t),
  }

fn field_members(
  shelf: Shelf,
  module: Int,
  d: TypeDef,
  t: TypeExpr,
) -> List<Member> / {abort.raise} =
  match t {
    TRecord(r) ->
      map(r.fields, |f: { name: Ident, ty: TypeExpr }|
        {
          kind: "field",
          name: string_of_bytes_lossy(f.name.name),
          signature: string_of_bytes_lossy(f.name.name) ++ ": "
            ++ sliced(shelf, module, ty_span(f.ty)),
          doc: field_doc(d.field_docs, f.name.name),
        }),
    _ -> [],
  }

/// A declaration's page: its place, and its hash where the program hashes one under its name.
fn declared_page(
  shelf: Shelf,
  tables: Tables,
  kind: String,
  full: Bytes,
  module: Int,
  span: Span,
) -> Page / {abort.raise} =
  {
    ..bare_page(kind, string_of_bytes_lossy(full), ""),
    module: module_name_at(shelf, module),
    location: placed(shelf, module, span),
    hash: hash_of(tables, full),
  }

fn effect_head(d: EffectDef) -> String =
  visibility(d.vis) ++ (if d.is_nondet { "nondet " } else { "" }) ++ "effect "
    ++ string_of_bytes_lossy(d.name.name)

fn op_member(shelf: Shelf, module: Int, op: OpDef) -> Member / {abort.raise} =
  {
    kind: "operation",
    name: string_of_bytes_lossy(op.name.name),
    signature: sliced(shelf, module, op.span),
    doc: lines_of(op.doc),
  }

fn set_signature(shelf: Shelf, module: Int, d: EffectSetDef) -> String / {abort.raise} =
  visibility(d.vis) ++ sliced(shelf, module, d.span)

/// What a module publishes, in its order, each with its signature and doc.
fn module_members(shelf: Shelf, module: Int, parsed: ParsedModule) -> List<Member> / {abort.raise} = {
  let defs = fold(published(shelf.analysis), map_new(), |acc: Map<Bytes, DefInfo>, d: DefInfo|
    map_insert(acc, d.name, d));
  fold(parsed.module.items, [], |acc: List<Member>, it: Item|
    match it {
      IFn(d) -> match d.vis {
        VPriv -> acc,
        VPub -> match ((
            map_get(defs, qualify(parsed.name, d.name.name)),
            schema_of(parsed.module, d),
          )) {
          (None, _) -> acc,
          (Some(def_info), None) ->
            push(acc, {
              kind: "definition",
              name: string_of_bytes_lossy(d.name.name),
              signature: fn_signature(def_info, Some(d)).text,
              doc: lines_of(d.doc),
            }),
          // A schema is listed once, as itself, and not again as the definition its guard is.
          (Some(_), Some(schema)) -> if schema.name.name != d.name.name { acc } else {
            push(acc, {
              kind: "law schema",
              name: string_of_bytes_lossy(d.name.name),
              signature: schema_signature(shelf, module, schema),
              doc: lines_of(d.doc),
            })
          },
        },
      },
      IType(d) -> match d.vis {
        VPriv -> acc,
        VPub ->
          push(acc, {
            kind: "type",
            name: string_of_bytes_lossy(d.name.name),
            signature: type_signature(shelf, module, d),
            doc: lines_of(d.doc),
          }),
      },
      IEffect(d) -> match d.vis {
        VPriv -> acc,
        VPub ->
          push(acc, {
            kind: "effect",
            name: string_of_bytes_lossy(d.name.name),
            signature: effect_head(d),
            doc: lines_of(d.doc),
          }),
      },
      IEffectSet(d) -> match d.vis {
        VPriv -> acc,
        VPub ->
          push(acc, {
            kind: "effect set",
            name: string_of_bytes_lossy(d.name.name),
            signature: set_signature(shelf, module, d),
            doc: lines_of(d.doc),
          }),
      },
      _ -> acc,
    })
}

fn page_of(shelf: Shelf, e: Entry) -> Page / {abort.raise} = {
  let tables = tables_of(shelf.analysis.hashes);
  match e.target {
    TDef(d) -> definition_page(shelf, tables, d),
    TType(x) ->
      {
        ..declared_page(shelf, tables, "type", e.full, x.module, x.def.span),
        signature: type_signature(shelf, x.module, x.def),
        doc: lines_of(x.def.doc),
        members: type_members(shelf, x.module, x.def),
      },
    TEffect(x) ->
      {
        ..declared_page(shelf, tables, "effect", e.full, x.module, x.def.span),
        signature: effect_head(x.def),
        doc: lines_of(x.def.doc),
        members: map(x.def.ops, |op: OpDef| op_member(shelf, x.module, op)),
      },
    TOp(x) ->
      {
        ..declared_page(shelf, tables, "operation", e.full, x.module, x.op.span),
        signature: sliced(shelf, x.module, x.op.span),
        doc: lines_of(x.op.doc),
      },
    TSet(x) ->
      {
        ..declared_page(shelf, tables, "effect set", e.full, x.module, x.def.span),
        signature: set_signature(shelf, x.module, x.def),
        doc: lines_of(x.def.doc),
      },
    TModule(i) -> match list_at(shelf.analysis.mods, i) {
      None -> bare_page("module", string_of_bytes_lossy(e.full), string_of_bytes_lossy(e.full)),
      Some(parsed) ->
        {
          ..bare_page("module", string_of_bytes_lossy(e.full), string_of_bytes_lossy(e.full)),
          doc: lines_of(parsed.module.doc),
          members: module_members(shelf, i, parsed),
          location: match list_at(shelf.places, i) { Some(p) -> Some(p.path), None -> None },
        },
    },
  }
}

fn builtin_signature(found: Builtin) -> Signed / {abort.raise} =
  signature(
    "",
    string_of_bytes_lossy(found.name),
    found.scheme,
    map(found.params, |n: Bytes| string_of_bytes_lossy(n)),
  )

fn builtin_page(query: String) -> Option<Page> / {abort.raise} =
  match builtin_named(bytes_of_string(query)) {
    None -> None,
    Some(found) -> {
      let signed: Signed = builtin_signature(found);
      Some({
        ..bare_page("builtin", string_of_bytes_lossy(found.name), signed.text),
        ty: string_of_bytes_lossy(scheme_text(found.scheme)),
        params: signed.params,
        doc: map(found.doc, |l: Bytes| string_of_bytes_lossy(l)),
      })
    },
  }

/// The prelude as a module: its doc, and every builtin by summary.
fn prelude_page() -> Page / {abort.raise} =
  {
    ..bare_page("module", "prelude", "prelude"),
    doc: lines_of(parse(prelude_source::text()).node.doc),
    members: map(builtins(), |b: Builtin|
      {
        kind: "builtin",
        name: string_of_bytes_lossy(b.name),
        signature: builtin_signature(b).text,
        doc: map(b.doc, |l: Bytes| string_of_bytes_lossy(l)),
      }),
  }

// --- Naming one thing --------------------------------------------------------------

/// A query that names nothing may still name a builtin, which the page for it says.
fn unknown_name(query: String, names: List<String>) -> Diag = {
  let d: Diag = unknown_def(query, names);
  if len(names) > 0 { d }
  else { noted(d, b"a builtin is named by its bare name, as in `ply doc map`") }
}

type Lookup = | Found(Page) | Many(List<String>) | Nothing

/// A name the program does not hold: a builtin's, else a shipped module's.
fn elsewhere(
  query: String,
) -> Lookup / {builder.git[vcs], fs.list_dir[shipped], fs.read_file[shipped], abort.raise} =
  if query == "prelude" { Found(prelude_page()) } else {
    match builtin_page(query) {
      Some(page) -> Found(page),
      None -> match shipped_shelf(query) {
        None -> Nothing,
        Some(shelf) -> match resolved(entries_of(shelf), query) {
          Ok(e) -> Found(page_of(shelf, e)),
          Err(names) -> if len(names) > 0 { Many(names) } else { Nothing },
        },
      },
    }
  }

// --- The answer -----------------------------------------------------------------

fn joined_lines(lines: List<String>) -> String =
  fold(range(0, len(lines)), "", |acc: String, i: Int|
    match list_at(lines, i) { Some(l) -> if i == 0 { l } else { acc ++ "\n" ++ l }, None -> acc })

fn member_json(m: Member) -> Json / {abort.raise} =
  object([
    { key: "kind", value: Str(m.kind) },
    { key: "name", value: Str(m.name) },
    { key: "signature", value: Str(m.signature) },
    { key: "doc", value: Str(joined_lines(m.doc)) },
    { key: "summary", value: Str(summary_of(m.doc)) },
  ])

fn page_json(page: Page) -> Json / {abort.raise} =
  object([
    { key: "command", value: Str("doc") },
    { key: "schema_version", value: Number(decimal_of_int(schema_version())) },
    { key: "ok", value: Bool(true) },
    { key: "exit_code", value: Number(decimal_of_int(ok_code())) },
    { key: "kind", value: Str(page.kind) },
    { key: "name", value: Str(page.name) },
    { key: "signature", value: Str(page.signature) },
    { key: "type", value: Str(page.ty) },
    {
      key: "params",
      value: Array(
        map(page.params, |named: Named|
          object([{ key: "name", value: Str(named.name) }, { key: "type", value: Str(named.ty) }])),
      ),
    },
    { key: "doc", value: Str(joined_lines(page.doc)) },
    { key: "summary", value: Str(summary_of(page.doc)) },
    { key: "clauses", value: strings(page.clauses) },
    { key: "members", value: Array(map(page.members, member_json)) },
    { key: "module", value: string_or_null(page.module) },
    { key: "location", value: string_or_null(page.location) },
    { key: "hash", value: string_or_null(page.hash) },
    { key: "footprint", value: string_or_null(page.footprint) },
    { key: "tests", value: strings(page.tests) },
    { key: "laws", value: strings(page.laws) },
  ])

fn said(
  style: Style,
  label: String,
  value: Option<String>,
  lines: List<String>,
) -> List<String> / {abort.raise} =
  match value { None -> lines, Some(v) -> push(lines, indent() ++ dim(style, label) ++ " " ++ v) }

fn listed(
  style: Style,
  label: String,
  names: List<String>,
  lines: List<String>,
) -> List<String> / {abort.raise} =
  if len(names) == 0 { lines } else {
    push(
      lines,
      indent() ++ dim(style, label) ++ " " ++ join(map(names, |n: String| "\"" ++ n ++ "\""), ", "),
    )
  }

/// A module lists what it publishes by summary; a type or an effect gives each member its whole doc.
fn member_lines(whole: Bool, m: Member, lines: List<String>) -> List<String> / {abort.raise} = {
  let head = push(push(lines, ""), indent() ++ m.signature);
  let words = if whole { m.doc } else {
    let s = summary_of(m.doc);
    if s == "" { [] } else { [s] }
  };
  fold(words, head, |acc: List<String>, l: String| push(acc, deep(l)))
}

/// A line of prose under a heading; an empty one stays empty rather than ending in blanks.
fn deep(l: String) -> String = if l == "" { "" } else { indent() ++ indent() ++ l }

pub fn page_text(style: Style, page: Page) -> List<String> / {abort.raise} = {
  let head = fold(
    page.doc,
    ["", indent() ++ bold(style, page.signature)],
    |acc: List<String>, l: String| push(acc, deep(l)),
  );
  let clauses = fold(page.clauses, head, |acc: List<String>, c: String|
    push(acc, indent() ++ indent() ++ dim(style, c)));
  let members = fold(page.members, clauses, |acc: List<String>, m: Member|
    member_lines(page.kind != "module", m, acc));
  let placed = said(style, "at", page.location, push(members, ""));
  let touched = said(style, "touches", page.footprint, placed);
  let hashed = said(style, "hash", page.hash, touched);
  let tested = listed(style, "tests", page.tests, hashed);
  let lawed = listed(style, "laws", page.laws, tested);
  let kinded = match page.location {
    Some(_) -> lawed,
    None -> push(lawed, indent() ++ dim(style, "kind") ++ " " ++ page.kind),
  };
  push(kinded, "")
}

fn answered(style: Style, page: Page) -> Answer / {abort.raise} =
  { json: page_json(page), lines: page_text(style, page), errs: [], code: ok_code() }

fn looked_elsewhere(
  style: Style,
  query: String,
  program: Program,
  fallback: List<Diag>,
) -> Answer / {builder.git[vcs], fs.list_dir[shipped], fs.read_file[shipped], abort.raise} =
  match elsewhere(query) {
    Found(page) -> answered(style, page),
    Many(names) -> reported(style, "doc", [unknown_name(query, names)], program.places),
    Nothing -> if len(fallback) > 0 { refused(style, "doc", fallback, program.places) }
    else { reported(style, "doc", [unknown_name(query, [])], program.places) },
  }

pub fn run(
  flags: Flags,
) -> Answer / {builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, abort.raise, diverges, shipped.reached} = {
  let loaded: Program = load_program(flags.paths);
  let s = style_of(flags);
  match loaded.whole {
    None -> looked_elsewhere(s, flags.query, loaded, loaded.diags),
    Some(w) -> {
      let shelf = { analysis: w, places: loaded.places };
      match resolved(entries_of(shelf), flags.query) {
        Ok(e) -> answered(s, page_of(shelf, e)),
        Err(names) -> if len(names) > 0 {
          reported(s, "doc", [unknown_name(flags.query, names)], loaded.places)
        } else { looked_elsewhere(s, flags.query, loaded, []) },
      }
    },
  }
}

// --- Tests ------------------------------------------------------------------

test "a doc's summary is its first sentence, its first paragraph joined into one line" {
  assert_eq(
    summary_of(["The bound a fresh server starts with.", "It is positive."]),
    "The bound a fresh server starts with.",
  );
  assert_eq(
    summary_of(["One line that runs on", "to a second, and stops", "", "Then more."]),
    "One line that runs on to a second, and stops",
  );
  assert_eq(summary_of(["`1.5` is not `1.50`. Equal, though."]), "`1.5` is not `1.50`.");
  assert_eq(summary_of([]), "")
}

test "written text reads on one line, without a comment or a closing comma" {
  assert_eq(
    one_line("read walk[r](\n    path: String,\n  ) -> Option<List<Entry>>"),
    "read walk[r](path: String) -> Option<List<Entry>>",
  );
  assert_eq(
    one_line("{\n  // the label\n  name: String,\n  size: Int,\n}"),
    "{ name: String, size: Int }",
  )
}

test "a builtin prints with the parameter names and the doc the prelude declares" {
  match builtin_page("map") {
    None -> panic("`map` is a builtin"),
    Some(page) -> {
      assert_eq(page.kind, "builtin");
      assert_eq(page.signature, "map<a, b | e>(xs: List<a>, f: (a) -> b / e) -> List<b> / e");
      assert_eq(page.module, None);
      assert_eq(page.location, None)
    },
  };
  match builtin_page("list_at") {
    None -> panic("`list_at` is a builtin"),
    Some(page) -> assert_eq(page.doc, ["`None` if `i` is negative or past the end."]),
  };
  match builtin_page("len") {
    None -> panic("`len` is a builtin"),
    Some(page) -> assert_eq(page.signature, "len<a>(xs: List<a>) -> Int"),
  };
  assert_eq(match builtin_page("nothing_here") { Some(_) -> true, None -> false }, false)
}

test "a name nothing declares is `E0101`, and an ambiguous one says which" {
  assert_eq(unknown_name("nothing_here", []).code, b"E0101");
  let many = unknown_name("total", ["a.total", "b.total (effect)"]);
  assert_eq(many.message, b"`total` names 2 definitions");
  assert_eq(many.notes_text, [b"one of: a.total, b.total (effect)"])
}

test "a page with no place names its kind instead" {
  let page: Page = {
    ..bare_page("builtin", "len", "len<a>(xs: List<a>) -> Int"),
    ty: "<a>(List<a>) -> Int",
    params: [{ name: "xs", ty: "List<a>" }],
  };
  assert_eq(page_text({ styled: false }, page), [
    "",
    "   len<a>(xs: List<a>) -> Int",
    "",
    "   kind builtin",
    "",
  ])
}

test "a module lists each member by summary, and a type gives each member its whole doc" {
  let members = [
    { kind: "definition", name: "one", signature: "pub fn one() -> Int", doc: ["One. And more."] },
  ];
  assert_eq(
    page_text({ styled: false }, {
      ..bare_page("module", "m", "m"),
      members: members,
      location: Some("m.ply"),
    }),
    ["", "   m", "", "   pub fn one() -> Int", "      One.", "", "   at m.ply", ""],
  );
  assert_eq(
    page_text({ styled: false }, {
      ..bare_page("type", "m.T", "type T"),
      members: members,
      location: Some("m.ply:1:1"),
    }),
    [
      "",
      "   type T",
      "",
      "   pub fn one() -> Int",
      "      One. And more.",
      "",
      "   at m.ply:1:1",
      "",
    ],
  )
}

test "the prelude is a module page: its doc and every builtin with its own" {
  let page = prelude_page();
  assert_eq(page.kind, "module");
  assert(len(page.doc) > 0);
  assert_eq(len(page.members), len(builtins()));
  let at = filter(page.members, |m: Member| m.name == "list_at");
  assert_eq(map(at, |m: Member| m.doc), [["`None` if `i` is negative or past the end."]])
}
