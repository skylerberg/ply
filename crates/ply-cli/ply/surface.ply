// The `ply` command line as one declaration: every command, flag, positional and refusal rule, as
// a `cmdline` spec. The parser and help renderer are `cmdline`'s; this module is the data, the
// value shapes (`--seed`, `--tls`, `--fs`, `--exec`), and the one cross-rule a flag cannot say
// alone (`--sim random` against `--sim-budget`).

import cmdline (Choice, Command, Flag, Help, Nat, Outcome, Parsed, Pos, Positional, Refused, Run,
                Spec, Switch, Text, Version, bare, body, checking, command, conflicting, defaulted,
                excused, has, many, parse, parse_nat, path_of, positional, range_of, repeated,
                requiring, switch, value, valued, values_of, with_default, with_extra,
                with_positionals, with_short, with_subs, with_trailing)
import sim.plan
import std.string (split_once)

// --- The value shapes -----------------------------------------------------------

// A seed is `7` for a whole search or `7:3.0.2` for one interleaving: a `u64` root, then `u16`
// choices dot-joined, decimal or `0x` hexadecimal, as `sim.plan` reads it.
fn seed_ok(text: String) -> Result<Unit, String> / {abort.raise} =
  match plan::parse_seed(text) {
    Some(_) -> Ok(()),
    None ->
      Err(
        "`" ++ text
          ++ "` is not a seed; write `7` for a whole search or `7:3.0.2` for one interleaving, and copy the one the failure printed",
      ),
  }

fn digit_char(c: String) -> Bool = at_least(c, "0") && at_most(c, "9")

// Single-character comparisons are byte comparisons, so `compare` on one char is the ASCII order.
fn at_least(a: String, b: String) -> Bool = match compare(a, b) { Less -> false, _ -> true }

fn at_most(a: String, b: String) -> Bool = match compare(a, b) { Greater -> false, _ -> true }

// A resource label is an identifier: letters, digits and `_`, not starting with a digit.
fn label_char(c: String) -> Bool =
  digit_char(c) || (at_least(c, "a") && at_most(c, "z")) || (at_least(c, "A") && at_most(c, "Z"))
    || c == "_"

fn label_chars(name: String, at: Int) -> Bool / {abort.raise} =
  if at >= string_len(name) { true }
  else { label_char(string_slice(name, at, at + 1)) && label_chars(name, at + 1) }

fn is_label(name: String) -> Bool / {abort.raise} =
  string_len(name) > 0 && !digit_char(string_slice(name, 0, 1)) && label_chars(name, 0)

// `--tls api=certs/api.pem,certs/api.key`: a name, then the two paths.
fn credential_ok(text: String) -> Result<Unit, String> / {abort.raise} =
  match split_once(text, "=") {
    None -> Err(credential_err(text, "there is no `=`")),
    Some(pair) -> match split_once(pair.tail, ",") {
      None -> Err(credential_err(text, "there is no `,` between the certificate and the key")),
      Some(paths) -> if pair.head == "" { Err(credential_err(text, "the credential has no name")) }
      else if paths.head == "" || paths.tail == "" { Err(credential_err(text, "a path is empty")) }
      else { Ok(()) },
    },
  }

fn credential_err(text: String, why: String) -> String =
  "`" ++ text ++ "` is not a TLS credential: " ++ why ++ "; write `--tls NAME=CERT.pem,KEY.pem`"

// `--fs src=./crates`: a resource label, then a path.
fn root_ok(text: String) -> Result<Unit, String> / {abort.raise} =
  match split_once(text, "=") {
    None -> Err(root_err(text, "there is no `=`")),
    Some(pair) -> if pair.head == "" { Err(root_err(text, "the root has no name")) }
    else if pair.tail == "" { Err(root_err(text, "the path is empty")) }
    else if !is_label(pair.head) { Err(root_err(text, label_why("a root's"))) }
    else { Ok(()) },
  }

fn root_err(text: String, why: String) -> String =
  "`" ++ text ++ "` is not a filesystem root: " ++ why ++ "; write `--fs NAME=PATH`"

// `--exec cc=/usr/bin/cc`: the same shape, for a program a label may start.
fn executable_ok(text: String) -> Result<Unit, String> / {abort.raise} =
  match split_once(text, "=") {
    None -> Err(executable_err(text, "there is no `=`")),
    Some(pair) -> if pair.head == "" { Err(executable_err(text, "the executable has no name")) }
    else if pair.tail == "" { Err(executable_err(text, "the path is empty")) }
    else if !is_label(pair.head) { Err(executable_err(text, label_why("an executable's"))) }
    else { Ok(()) },
  }

fn executable_err(text: String, why: String) -> String =
  "`" ++ text ++ "` is not an executable: " ++ why ++ "; write `--exec NAME=PATH`"

fn label_why(whose: String) -> String =
  whose
    ++ " name is a resource label, so it is an identifier: letters, digits and `_`, not starting with a digit"

// --- The flag groups shared across commands ----------------------------------------

fn json_flag() -> Flag = switch("json", "Emit one JSON object on stdout and nothing else.")

fn path_positional() -> Positional =
  defaulted(
    "PATH",
    "A `.ply` file, or a project root whose `*.ply` files are modules named by path.",
    ".",
  )

fn filter_flag(help: String) -> Flag = valued("filter", "SUBSTRING", Text, help)

fn jobs_flag() -> Flag =
  with_short(valued("jobs", "N", Pos, "Worker threads. Defaults to one per core."), "j")

fn profile_flag(default: String, help: String) -> Flag =
  with_default(valued("profile", "PROFILE", Text, help), default)

fn simulation_flags() -> List<Flag> =
  [
    conflicting(seed_flag(), ["sim", "seeds", "sim-roots", "sim-budget"]),
    with_default(
      valued(
        "sim",
        "MODE",
        Choice(["once", "random", "dpor"]),
        "Which search each simulated test runs.",
      ),
      "dpor",
    ),
    valued(
      "seeds",
      "N",
      Pos,
      "Seeds per simulated test, from 0. Defaults to 1 under `dpor` and 64 under `random`.",
    ),
    conflicting(
      checking(
        valued(
          "sim-roots",
          "FROM..TO",
          Text,
          "Search the seeds from FROM up to but not including TO instead: `5..6` is seed 5 alone.",
        ),
        sim_roots_ok,
      ),
      ["seeds"],
    ),
    valued("sim-budget", "N", Pos, "Interleavings per seed. Only `dpor` searches more than one."),
    valued(
      "sim-steps",
      "N",
      Pos,
      "Scheduling steps one interleaving may take before it reports no progress.",
    ),
    switch(
      "measure-reduction",
      "Also run the search twice more, unpruned and blind to the order spawns and joins impose, and report what each cost.",
    ),
  ]

fn sim_roots_ok(text: String) -> Result<Unit, String> / {abort.raise} =
  match range_of(text) {
    Some(_) -> Ok(()),
    None ->
      Err(
        "`" ++ text
          ++ "` is not a range of seeds; write `FROM..TO` with FROM below TO, as in `5..6` for seed 5",
      ),
  }

fn seed_flag() -> Flag =
  checking(
    valued(
      "seed",
      "SEED",
      Text,
      "Replay exactly one interleaving: `7`, or `7:3.0.2`. Implies `--sim once`.",
    ),
    seed_ok,
  )

fn tls_flags() -> List<Flag> =
  [
    repeated(
      requiring(
        checking(
          valued(
            "tls",
            "NAME=CERT,KEY",
            Text,
            "TLS credential: `--tls api=certs/api.pem,certs/api.key`. Repeatable, one per listener.",
          ),
          credential_ok,
        ),
        ["host"],
      ),
    ),
    repeated(
      requiring(
        valued(
          "trust",
          "CERT.pem",
          Text,
          "A certificate `net.connect_tls` trusts beside the built-in roots. Repeatable.",
        ),
        ["host"],
      ),
    ),
  ]

fn fs_flags() -> List<Flag> =
  [
    repeated(
      requiring(
        checking(
          valued(
            "fs",
            "NAME=PATH",
            Text,
            "Filesystem root: `--fs src=./crates`. Repeatable, one root per resource label.",
          ),
          root_ok,
        ),
        ["host"],
      ),
    ),
  ]

fn exec_flags() -> List<Flag> =
  [
    repeated(
      requiring(
        checking(
          valued(
            "exec",
            "NAME=PATH",
            Text,
            "Program a `process.spawn` or `process.start` label may start: `--exec cc=/usr/bin/cc`. Repeatable.",
          ),
          executable_ok,
        ),
        ["host"],
      ),
    ),
  ]

fn allow_flags() -> List<Flag> =
  [
    repeated(
      requiring(
        checking(
          valued(
            "allow",
            "NAME",
            Text,
            "Lend the program a privileged family it declares: `machine`, `tester`, `claims`, `hosts` or `shipped`. Repeatable.",
          ),
          family_ok,
        ),
        ["host"],
      ),
    ),
  ]

fn family_ok(text: String) -> Result<Unit, String> / {abort.raise} =
  if text == "" { Err("a family needs a name") }
  else if bytes_at(bytes_of_string(text), 0) < 97 || bytes_at(bytes_of_string(text), 0) > 122 {
    Err("a family name is lower-case letters and `_`")
  } else { Ok(()) }

fn config_flags() -> List<Flag> =
  [
    repeated(
      requiring(
        valued(
          "set",
          "KEY=VALUE",
          Text,
          "A configuration value: `--set DESK_REGION=eu`. Repeatable; highest precedence, last wins.",
        ),
        ["host"],
      ),
    ),
    repeated(
      requiring(
        valued(
          "config",
          "PATH",
          Text,
          "A `KEY=VALUE` file, one pair per line, no quoting. Repeatable; a later file wins.",
        ),
        ["host"],
      ),
    ),
    requiring(
      valued(
        "config-schema",
        "MODULE.FN",
        Text,
        "`<module>.<fn>`: a nullary pure function returning a `ConfigSpec`, checked at start-up.",
      ),
      ["host"],
    ),
  ]

fn trace_flags() -> List<Flag> =
  [
    with_default(
      requiring(
        valued(
          "trace",
          "SINK",
          Choice(["json", "text", "off"]),
          "Where a `trace` record goes: `json` lines or `text` lines on stderr, or `off`.",
        ),
        ["host"],
      ),
      "json",
    ),
    with_default(
      requiring(
        valued(
          "trace-level",
          "LEVEL",
          Choice(["debug", "info", "warn", "error"]),
          "The lowest level the sink writes; spans and metrics are `info`.",
        ),
        ["host"],
      ),
      "info",
    ),
  ]

fn shutdown_flags() -> List<Flag> =
  [
    with_default(
      requiring(
        valued(
          "drain-ms",
          "MS",
          Nat,
          "How long in-flight requests have to finish after accepting stops (else `W0608`, exit 3).",
        ),
        ["host"],
      ),
      "30000",
    ),
    with_default(
      requiring(
        valued(
          "drain-lead-ms",
          "MS",
          Nat,
          "How long accept keeps running after the signal, so a readiness route can answer `503`.",
        ),
        ["host"],
      ),
      "0",
    ),
  ]

fn prove_flags() -> List<Flag> =
  [
    valued(
      "prove-cases",
      "N",
      Pos,
      "Candidate binder tuples drawn per root; fewer than 25 kept can only report `example`.",
    ),
    valued("prove-roots", "N", Pos, "Generator roots, each drawing its own case set."),
    valued(
      "prove-budget",
      "N",
      Pos,
      "Static inference steps per obligation; a spent budget reports `property`.",
    ),
    valued(
      "shrink-budget",
      "N",
      Pos,
      "Evaluations a counterexample may be shrunk by; in no cache key, since failures never are.",
    ),
    valued(
      "prove-steps",
      "N",
      Nat,
      "Calls per evaluation of a claim (default 1000000000); 0 is no bound. It keys the result.",
    ),
  ]

// The lists joined into one command's flags.
fn flat(xss: List<List<Flag>>) -> List<Flag> =
  fold(xss, [], |acc: List<Flag>, xs: List<Flag>|
    fold(xs, acc, |a: List<Flag>, flag: Flag| push(a, flag)))

// The one rule a flag cannot say alone: `--sim-budget` against `--sim random`'s value.
fn sim_conflict(parsed: Parsed) -> Result<Unit, String> =
  if value(parsed, "sim") == Some("random") && has(parsed, "sim-budget") {
    Err(
      "`--sim-budget` has no meaning under `--sim random`, which runs one interleaving per seed; widen the search with `--seeds N`, or use `--sim dpor` to spend a budget per seed",
    )
  } else { Ok(()) }

// --- The commands -------------------------------------------------------------------

fn new_cmd() -> Command =
  with_positionals(
    command("new", "Start a package: a `ply.pkg`, a first module and a first test.", [
      valued("name", "NAME", Text, "The package's name; the last segment of the path when absent."),
      switch("lib", "A library: no `main`, and a `pub` definition to import."),
      json_flag(),
    ]),
    [positional("PATH", "The directory to make the package in; its last segment names it.")],
  )

fn workspace_flag() -> Flag =
  switch(
    "workspace",
    "Also run every package this one reaches by a path dependency, each as its own root, dependencies first.",
  )

fn verify_deps_flag() -> Flag =
  switch(
    "verify-deps",
    "Read every dependency from source, and refuse one whose published interface does not re-derive from it (E0149).",
  )

fn check_cmd() -> Command =
  with_positionals(
    command("check", "Typecheck a file or directory.", [
      switch("types", "Print the inferred signature and footprint of every definition."),
      switch(
        "costs",
        "Print, for every `push`, `list_set` and `array_set`, whether it updates in place or copies.",
      ),
      json_flag(),
      switch("explain", "Report where the front end's time went, and where every row came from."),
      workspace_flag(),
      verify_deps_flag(),
    ]),
    [path_positional()],
  )

fn test_cmd() -> Command =
  with_extra(
    with_positionals(
      command(
        "test",
        "Select, schedule and run the tests.",
        flat([
          [
            json_flag(),
            switch(
              "explain",
              "Show why each test was selected or skipped, and how concurrency groups formed.",
            ),
            switch("no-cache", "Neither read nor write the result cache: every test runs."),
            repeated(
              filter_flag(
                "Only consider tests whose `<module>.<label>` key contains this substring. Repeatable: a test any of them matches runs.",
              ),
            ),
            jobs_flag(),
            with_default(
              valued(
                "steps",
                "N",
                Nat,
                "Calls one test may make; past it the test fails with E0503. 0 is no bound.",
              ),
              "1000000000",
            ),
            with_default(
              valued(
                "timeout",
                "MS",
                Nat,
                "Wall clock per test, in milliseconds; past it the run is abandoned rather than judged, and nothing it did is recorded. 0 is no clock.",
              ),
              "60000",
            ),
            with_default(
              valued(
                "bisect",
                "WHEN",
                Choice(["auto", "always", "never"]),
                "Attribute a failure to its change; `auto` bisects only a det test that has passed before.",
              ),
              "auto",
            ),
            with_default(
              valued(
                "bisect-budget",
                "N",
                Nat,
                "Hybrid programs a bisection may evaluate; counted, not timed, so runs agree.",
              ),
              "64",
            ),
            switch(
              "coverage",
              "Which tests reach each definition, and the definitions none reaches.",
            ),
            bare(
              valued(
                "mutate",
                "DEF",
                Text,
                "After a green run, change each definition (or DEF) one operator or literal at a time and re-run the tests that reach it; a mutant every one of them passes is reported.",
              ),
              "*",
            ),
            with_default(
              valued(
                "mutate-budget",
                "N",
                Nat,
                "Mutants a run may judge; counted, not timed, so runs agree.",
              ),
              "64",
            ),
            profile_flag(
              "development",
              "C toolchain: `development` (`tcc`, else `cc -O0`) or `release` (`cc -O2`).",
            ),
            switch(
              "watch",
              "Stay running: re-select and re-run whenever a `.ply` file under the path changes.",
            ),
            conflicting(workspace_flag(), ["watch"]),
            verify_deps_flag(),
            switch(
              "host",
              "Bind the real host handlers; a pass that reaches one stands for this binding alone.",
            ),
            switch(
              "std",
              "Also select the tests declared by the modules that ship with the compiler.",
            ),
          ],
          tls_flags(),
          fs_flags(),
          exec_flags(),
          allow_flags(),
          config_flags(),
          simulation_flags(),
        ]),
      ),
      [path_positional()],
    ),
    sim_conflict,
  )

fn prove_cmd() -> Command =
  with_extra(
    with_positionals(
      command(
        "prove",
        "Discharge every obligation and report the tier each was discharged at.",
        flat([
          [
            json_flag(),
            switch(
              "explain",
              "Show where each discharge came from: the cache, a proof, or a search.",
            ),
            switch(
              "reach",
              "Also ask the static tier alone about every obligation, cached or not, and report what it decided and where it stopped (`--json`).",
            ),
            switch(
              "no-cache",
              "Neither read nor write the obligation cache: every obligation is discharged again.",
            ),
            filter_flag("Only consider obligations whose owner contains this substring."),
            jobs_flag(),
            switch("no-incremental", "Neither read nor write the front-end cache."),
            switch(
              "std",
              "Also discharge the laws declared by the modules that ship with the compiler.",
            ),
            workspace_flag(),
            verify_deps_flag(),
            switch("host", "Bind the real host handlers, so that a `law/host` is attempted."),
          ],
          tls_flags(),
          fs_flags(),
          config_flags(),
          trace_flags(),
          prove_flags(),
          simulation_flags(),
        ]),
      ),
      [path_positional()],
    ),
    sim_conflict,
  )

fn review_cmd() -> Command =
  with_extra(
    with_positionals(
      command(
        "review",
        "Report what changed and whether its specification and obligations still hold.",
        flat([
          [
            switch(
              "changed",
              "Report only what moved since the last accepted review (the default).",
            ),
            conflicting(
              switch(
                "accept",
                "Record the current definitions and specifications as reviewed, keyed by name.",
              ),
              ["changed"],
            ),
            json_flag(),
            switch("no-cache", "Neither read nor write the obligation cache."),
            switch("no-incremental", "Neither read nor write the front-end cache."),
            switch(
              "std",
              "Also review the definitions the modules that ship with the compiler declare.",
            ),
          ],
          prove_flags(),
          simulation_flags(),
        ]),
      ),
      [path_positional()],
    ),
    sim_conflict,
  )

fn run_cmd() -> Command =
  with_trailing(
    with_positionals(
      command(
        "run",
        "Evaluate `main` (a directory must hold exactly one), or run a built `.plyx`.",
        flat([
          [
            json_flag(),
            switch(
              "explain",
              "Say whether the front end ran or an earlier run's answer was reused, and where the load's time went.",
            ),
            with_default(
              valued(
                "steps",
                "N",
                Nat,
                "Calls the entry point may make; past it the run fails with E0503. 0 is no bound, which is the default: an entry that serves forever is a program, not a runaway.",
              ),
              "0",
            ),
            with_default(
              valued(
                "timeout",
                "MS",
                Nat,
                "Wall clock for the entry point, in milliseconds; past it the run is abandoned rather than judged. 0 is no clock.",
              ),
              "0",
            ),
            checking(
              valued(
                "seed",
                "SEED",
                Text,
                "The interleaving a `simulate` region takes: `7`, or `7:3.0.2`.",
              ),
              seed_ok,
            ),
            switch(
              "host",
              "Bind the real host handlers; unbound, reaching the boundary is a diagnostic.",
            ),
            profile_flag(
              "development",
              "C toolchain: `development` (`tcc`, else `cc -O0`) or `release` (`cc -O2`).",
            ),
            repeated(
              valued(
                "require-signer",
                "KEY",
                Text,
                "Run a built artifact only when the public key file KEY signed it. Repeatable: any of them may.",
              ),
            ),
          ],
          tls_flags(),
          fs_flags(),
          exec_flags(),
          allow_flags(),
          config_flags(),
          trace_flags(),
          shutdown_flags(),
        ]),
      ),
      [path_positional()],
    ),
  )

fn build_cmd() -> Command =
  with_positionals(
    command("build", "Write a deployable artifact: the transitive closure of one entry point.", [
      with_short(
        valued(
          "output",
          "FILE",
          Text,
          "Where to write the artifact. Defaults to `<entry module>.plyx` in the working directory.",
        ),
        "o",
      ),
      valued(
        "entry",
        "NAME",
        Text,
        "The definition whose closure is shipped: `app.serve` or a simple name. Defaults to `main`.",
      ),
      valued(
        "config-schema",
        "MODULE.FN",
        Text,
        "Also ship this `--config-schema` function's closure, so the artifact takes the same flag.",
      ),
      conflicting(
        switch(
          "digest",
          "Print `b3:...` and nothing else: the line a deployment pins. Writes no file.",
        ),
        ["json", "diff", "output"],
      ),
      conflicting(
        valued(
          "diff",
          "OLD.plyx",
          Text,
          "Report what this build changes relative to a deployed artifact. Writes no file.",
        ),
        ["output"],
      ),
      conflicting(
        valued(
          "sign",
          "KEY",
          Text,
          "Sign what the build writes with the secret key file KEY (`ply keygen`), in `<artifact>.sig` beside it.",
        ),
        ["digest", "diff", "verify"],
      ),
      conflicting(
        switch(
          "verify",
          "Hold the file `-o` names, and every signature beside it, to what these sources build. Writes no file.",
        ),
        ["digest", "diff"],
      ),
      json_flag(),
    ]),
    [path_positional()],
  )

fn attest_cmd() -> Command =
  with_positionals(
    command(
      "attest",
      "Run a published version's tests, claims and promises over what the registry serves; with `--sign`, send the registry the signed answer.",
      [
        valued(
          "sign",
          "KEY",
          Text,
          "Sign the attestation with the secret key file KEY and send it to `PLY_REGISTRY`, which keeps one signed by its attester's key.",
        ),
        json_flag(),
      ],
    ),
    [
      positional("NAME", "The package's name."),
      positional("VERSION", "The published version, such as `0.2.0`."),
    ],
  )

fn keygen_cmd() -> Command =
  with_positionals(
    command(
      "keygen",
      "Write an Ed25519 key pair to sign builds with: the secret key at PATH, its public key at PATH.pub.",
      [json_flag()],
    ),
    [positional("PATH", "Where the secret key is written; it is never written over.")],
  )

fn hosts_cmd() -> Command =
  with_positionals(
    command(
      "hosts",
      "List every host handler this binary can bind: the trusted computing base.",
      flat([
        [
          switch(
            "host",
            "List the handlers as bound; registration errors are reported either way.",
          ),
          conflicting(json_flag(), ["digest"]),
          switch("digest", "Print `b3:...` and nothing else: the line a CI check pins."),
        ],
        tls_flags(),
        fs_flags(),
        config_flags(),
        trace_flags(),
        shutdown_flags(),
      ]),
    ),
    [path_positional()],
  )

fn std_cmd() -> Command =
  command("std", "List the modules that ship with this compiler, and the digest over them.", [
    conflicting(json_flag(), ["digest"]),
    switch("digest", "Print `b3:...` and nothing else: the line a CI check pins."),
    bare(
      valued(
        "show",
        "MODULE",
        Text,
        "Print each module's source instead of listing it; written bare, prints every one.",
      ),
      "*",
    ),
  ])

fn explain_cmd() -> Command =
  with_positionals(
    command("explain", "What a diagnostic code means; `--all` lists every code.", [
      switch("all", "List every code with its meaning."),
      json_flag(),
    ]),
    [excused(positional("CODE", "A code such as `E0302` or `W0611`."), "all")],
  )

fn doc_cmd() -> Command =
  with_positionals(
    command(
      "doc",
      "A definition or builtin: its signature with parameter names, the comment above it, its place.",
      [json_flag()],
    ),
    [
      positional(
        "NAME",
        "A program-wide name (`store.orders.place`), a simple name unique in the program, or a builtin.",
      ),
      path_positional(),
    ],
  )

fn fmt_cmd() -> Command =
  with_positionals(
    command(
      "fmt",
      "Rewrite `.ply` files in the canonical layout; a file that does not parse is left alone.",
      [
        switch(
          "check",
          "Write nothing; list the files that would change and exit 1 if there are any.",
        ),
        // `--json` is a report, and a report that rewrote every file it named
        // is the one shape this command must not have: `ply fmt --json <dir>`
        // was read as a dry run and reformatted fourteen examples. Requiring
        // `--check` makes the two impossible to confuse.
        requiring(json_flag(), ["check"]),
      ],
    ),
    [
      many(
        defaulted(
          "PATHS",
          "`.ply` files, or directories whose `*.ply` files are formatted (a hidden directory, one named `target`, and a symlink are passed over).",
          ".",
        ),
      ),
    ],
  )

fn show_cmd() -> Command =
  with_positionals(
    command(
      "show",
      "One `fn` or `type` as its file holds it: the comment lines above it, `pub`, and the body.",
      [json_flag()],
    ),
    [
      positional(
        "NAME",
        "A program-wide name (`store.orders.place`) or a simple name unique in the program: a `fn` or a `type`.",
      ),
      path_positional(),
    ],
  )

fn replace_cmd() -> Command =
  with_positionals(
    command(
      "replace",
      "Rewrite one `fn` or `type` from a file or stdin, formatted, leaving every other byte of the file alone.",
      [
        valued("with", "FILE", Text, "The file holding the new definition; stdin when absent."),
        switch("check", "Write nothing; report whether the file would change."),
        json_flag(),
      ],
    ),
    [
      positional(
        "NAME",
        "A program-wide name (`store.orders.place`) or a simple name unique in the program: a `fn` or a `type`.",
      ),
      path_positional(),
    ],
  )

fn hash_cmd() -> Command =
  with_positionals(
    command("hash", "Print the content hash of every definition.", [
      switch("deps", "Also print each definition's direct references and transitive closure."),
      json_flag(),
    ]),
    [path_positional()],
  )

fn resolve_cmd() -> Command =
  with_positionals(
    command("resolve", "Write the lockfile from this project's manifest closure.", [json_flag()]),
    [path_positional()],
  )

fn vendor_cmd() -> Command =
  with_positionals(
    command(
      "vendor",
      "Copy this project's dependencies into `vendor/`, so it builds with no cache and no network.",
      [json_flag()],
    ),
    [path_positional()],
  )

fn publish_cmd() -> Command =
  with_positionals(
    command(
      "publish",
      "Upload this library's `.plyz` to the registry `PLY_REGISTRY` names, under `PLY_REGISTRY_TOKEN`.",
      [json_flag()],
    ),
    [path_positional()],
  )

fn yank_cmd() -> Command =
  with_positionals(
    command(
      "yank",
      "Mark a published version yanked: a new resolution passes it over, a lock that pins it keeps it.",
      [json_flag()],
    ),
    [
      positional("NAME", "The package's name, as its `ply.pkg` declares it."),
      positional("VERSION", "The version to yank, such as `0.2.0`."),
    ],
  )

fn contracts_cmd() -> Command =
  with_positionals(
    command(
      "contracts",
      "List what each public definition of a registry package promises that moved between two of its versions, and the bump that needs.",
      [json_flag()],
    ),
    [
      positional("NAME", "The package's name, as its `ply.pkg` declares it."),
      positional("FROM", "The earlier version, such as `0.1.0`."),
      positional("TO", "The later version, such as `0.2.0`."),
    ],
  )

fn why_cmd() -> Command =
  with_positionals(
    command("why", "Why a package is in this project's closure: the packages that reach it.", [
      json_flag(),
    ]),
    [positional("NAME", "A package's name, as `ply.pkg` declares it."), path_positional()],
  )

fn defs_cmd() -> Command =
  with_positionals(
    command("defs", "Every definition with its place, hash, signature and footprint.", [
      filter_flag("Only definitions whose program-wide name contains this substring."),
      json_flag(),
    ]),
    [path_positional()],
  )

fn callers_cmd() -> Command =
  with_positionals(
    command(
      "callers",
      "What mentions a definition: definitions, tests and laws, directly and through calls.",
      [json_flag()],
    ),
    [
      positional(
        "DEF",
        "A program-wide name (`store.orders.place`) or a simple name unique in the program.",
      ),
      path_positional(),
    ],
  )

fn bootstrap_cmd() -> Command =
  with_positionals(
    command(
      "bootstrap",
      "Write a program this binary ships as its launcher enters it: the builder or `ply` itself.",
      [
        with_default(
          valued("out", "DIR", Text, "Where `<stem>.run` and its `<stem>.digest` go."),
          "bootstrap",
        ),
        switch(
          "verify",
          "Re-emit and compare against the runnable there, writing nothing; non-zero on mismatch.",
        ),
        json_flag(),
      ],
    ),
    [positional("PATH", "A `.ply` file, or a project root: the program to write out.")],
  )

fn cache_scope(name: String, about: String) -> Command =
  with_positionals(command(name, about, [json_flag()]), [
    defaulted(
      "PATH",
      "The project whose `.ply-cache` is meant; a `.ply` file means its directory.",
      ".",
    ),
  ])

fn cache_cmd() -> Command =
  with_subs(command("cache", "Read, reclaim or discard what the caches hold.", []), [
    cache_scope("clear", "Discard every cached result, so the next run re-proves everything."),
    cache_scope(
      "stats",
      "Report where the cache lives, how much it holds, and what is reclaimable.",
    ),
    cache_scope("compact", "Reclaim the space nothing points at any more."),
    with_positionals(
      command(
        "inspect",
        "Print what the cache holds for one definition, resolved and readable.",
        [json_flag()],
      ),
      [
        positional(
          "DEF",
          "A program-wide name, a name as its module wrote it, or a hash prefix of 4+ hex digits.",
        ),
        defaulted(
          "PATH",
          "The project whose `.ply-cache` is meant; a `.ply` file means its directory.",
          ".",
        ),
      ],
    ),
  ])

// The whole surface: the about the binary was built with, the one global flag, and the commands
// in the order the help lists them.
pub fn spec(version: String) -> Spec = {
  let root = command("", "Ply — a language where the verification loop collapses toward zero", [
    with_default(
      valued(
        "color",
        "COLOR",
        Choice(["auto", "always", "never"]),
        "Colour and the ✓/✗ marks; `auto` uses them only on a terminal with NO_COLOR unset.",
      ),
      "auto",
    ),
  ]);
  {
    bin: "ply",
    version: version,
    root: with_subs(root, [
      new_cmd(),
      check_cmd(),
      test_cmd(),
      prove_cmd(),
      review_cmd(),
      run_cmd(),
      build_cmd(),
      hosts_cmd(),
      std_cmd(),
      explain_cmd(),
      doc_cmd(),
      fmt_cmd(),
      show_cmd(),
      replace_cmd(),
      hash_cmd(),
      defs_cmd(),
      resolve_cmd(),
      vendor_cmd(),
      why_cmd(),
      publish_cmd(),
      yank_cmd(),
      contracts_cmd(),
      keygen_cmd(),
      attest_cmd(),
      callers_cmd(),
      bootstrap_cmd(),
      cache_cmd(),
    ]),
  }
}

pub fn parsed(argv: List<String>) -> Parsed / {abort.raise} =
  match parse(spec("0.0.0-test"), argv) { Run(p) -> p, _ -> panic("the line parses") }

// --- Tests ----------------------------------------------------------------------

fn ply_parse(argv: List<String>) -> Outcome / {abort.raise} = parse(spec("0.0.0-test"), argv)

fn ran(argv: List<String>) -> Parsed / {abort.raise} =
  match ply_parse(argv) { Run(p) -> p, _ -> panic("the line was refused, not run") }

fn refusal(argv: List<String>) -> String / {abort.raise} =
  match ply_parse(argv) {
    Refused(text) -> text,
    Run(p) -> panic("the line ran"),
    Help(_) -> panic("the line was help"),
    Version(_) -> panic("the line was the version"),
  }

test "the spec declares every top-level command" {
  assert_eq(len(body(spec("0.0.0-test").root).subs), 27)
}

test "the path defaults to the current directory" {
  assert_eq(path_of(ran(["test"])), ".");
  assert_eq(path_of(ran(["check"])), ".");
  // `doc` takes its name first; the path is the one after it.
  assert_eq(ran(["doc", "std.json"]).positionals, ["std.json", "."])
}

test "colour is accepted after the subcommand as well as before it" {
  assert_eq(value(ran(["test", "--color", "always"]), "color"), Some("always"));
  assert_eq(value(ran(["--color=never", "test"]), "color"), Some("never"))
}

test "zero jobs is refused rather than silently meaning auto" {
  assert(string_contains(refusal(["test", "--jobs", "0"]), "invalid value '0' for '--jobs <N>'"));
  assert_eq(value(ran(["test", "-j", "4"]), "jobs"), Some("4"))
}

test "cache requires an action" {
  assert(string_contains(refusal(["cache"]), "requires a subcommand"));
  assert_eq(ran(["cache", "stats"]).path, ["cache", "stats"]);
  assert_eq(ran(["cache", "clear"]).path, ["cache", "clear"]);
  assert_eq(ran(["cache", "compact"]).path, ["cache", "compact"])
}

test "inspect needs something to look up" {
  assert(string_contains(refusal(["cache", "inspect"]), "<DEF>"));
  let p = ran(["cache", "inspect", "9f2c", "src"]);
  assert_eq(p.positionals, ["9f2c", "src"])
}

test "a TLS credential parses into its name and its two files, repeatably" {
  let p = ran([
    "run",
    "--host",
    "--tls",
    "api=certs/api.pem,certs/api.key",
    "--tls",
    "admin=certs/admin.pem,certs/admin.key",
  ]);
  assert_eq(values_of(p, "tls"), [
    "api=certs/api.pem,certs/api.key",
    "admin=certs/admin.pem,certs/admin.key",
  ])
}

test "a credential that is not name-cert-key is refused with the form" {
  for_bad(["api", "api=only.pem", "=a.pem,b.key", "api=,b.key"])
}

fn for_bad(bads: List<String>) -> Unit / {abort.raise} =
  match bads {
    [] -> (),
    [bad, ..rest] -> {
      let text = refusal(["run", "--host", "--tls", bad]);
      assert(string_contains(text, "--tls NAME=CERT.pem,KEY.pem"));
      for_bad(rest)
    },
  }

test "TLS without `--host` is refused rather than ignored" {
  assert(string_contains(refusal(["run", "--tls", "api=a.pem,b.key"]), "requires '--host'"));
  assert(string_contains(refusal(["test", "--tls", "api=a.pem,b.key"]), "requires '--host'"));
  assert(string_contains(refusal(["hosts", "--tls", "api=a.pem,b.key"]), "requires '--host'"));
  assert_eq(
    value(ran(["hosts", "--host", "--tls", "api=a.pem,b.key"]), "tls"),
    Some("api=a.pem,b.key"),
  )
}

test "the bisection switches default to auto and refuse a fourth word" {
  let p = ran(["test"]);
  assert_eq(value(p, "bisect"), Some("auto"));
  assert(
    string_contains(
      refusal(["test", "--bisect", "sometimes"]),
      "[possible values: auto, always, never]",
    ),
  );
  assert_eq(value(ran(["test", "--bisect", "never"]), "bisect"), Some("never"))
}

test "the simulation flags conflict with a seed" {
  let text = refusal(["test", "--seed", "7", "--sim", "random"]);
  assert(string_contains(text, "'--seed <SEED>' cannot be used with '--sim'"))
}

test "`--sim-budget` under `--sim random` is the one cross-value rule" {
  let text = refusal(["test", "--sim", "random", "--sim-budget", "10"]);
  assert(string_contains(text, "`--sim-budget` has no meaning under `--sim random`"));
  assert(has(ran(["test", "--sim", "dpor", "--sim-budget", "10"]), "sim-budget"))
}

test "a seed is a root, or a root and its choices" {
  assert(has(ran(["test", "--seed", "7"]), "seed"));
  assert(has(ran(["test", "--seed", "7:3.0.2"]), "seed"));
  assert(has(ran(["test", "--seed", "0x1F"]), "seed"));
  assert(string_contains(refusal(["test", "--seed", "7:"]), "is not a seed"));
  assert(string_contains(refusal(["test", "--seed", "7:65536"]), "is not a seed"));
  assert(string_contains(refusal(["test", "--seed", "not-a-seed"]), "is not a seed"))
}

test "`--digest` writes no file, so it conflicts with everything that does" {
  assert(string_contains(refusal(["build", "--digest", "--json"]), "cannot be used with"));
  assert(
    string_contains(refusal(["build", "--digest", "--diff", "old.plyx"]), "cannot be used with"),
  );
  assert(string_contains(refusal(["build", "--digest", "-o", "x.plyx"]), "cannot be used with"));
  assert(string_contains(refusal(["hosts", "--digest", "--json"]), "cannot be used with"));
  assert(string_contains(refusal(["std", "--digest", "--json"]), "cannot be used with"))
}

test "review accepts or reports, never both" {
  assert(
    string_contains(
      refusal(["review", "--accept", "--changed"]),
      "'--accept' cannot be used with '--changed'",
    ),
  )
}

test "explain takes a code or `--all`, and says so" {
  assert(string_contains(refusal(["explain"]), "<CODE>"));
  assert(has(ran(["explain", "--all"]), "all"));
  assert_eq(path_of(ran(["explain", "E0302"])), "E0302")
}

test "`--mutate` with no value is every definition" {
  assert_eq(value(ran(["test", "--mutate"]), "mutate"), Some("*"));
  assert_eq(value(ran(["test", "--mutate", "m.f"]), "mutate"), Some("m.f"));
  // A flag word after it leaves the bare value in place.
  let p = ran(["test", "--mutate", "--json"]);
  assert_eq(value(p, "mutate"), Some("*"));
  assert(has(p, "json"))
}

test "`std --show` with no module is every module" {
  assert_eq(value(ran(["std", "--show"]), "show"), Some("*"));
  assert_eq(value(ran(["std", "--show", "std.json"]), "show"), Some("std.json"))
}

test "run's words after `--` are the program's own" {
  let p = ran(["run", "app.plyx", "--host", "--", "--port", "8080"]);
  assert_eq(p.positionals, ["app.plyx"]);
  assert_eq(p.argv, ["--port", "8080"])
}

test "an unknown subcommand is rejected" {
  assert(string_contains(refusal(["frobnicate"]), "unrecognized subcommand 'frobnicate'"))
}

test "every command answers help" {
  for_help([
    "new",
    "check",
    "test",
    "prove",
    "review",
    "run",
    "build",
    "hosts",
    "std",
    "explain",
    "doc",
    "fmt",
    "show",
    "replace",
    "hash",
    "defs",
    "resolve",
    "vendor",
    "why",
    "publish",
    "yank",
    "contracts",
    "keygen",
    "attest",
    "callers",
    "bootstrap",
    "cache",
  ])
}

fn for_help(cmds: List<String>) -> Unit / {abort.raise} =
  match cmds {
    [] -> (),
    [cmd, ..rest] -> {
      match ply_parse([cmd, "--help"]) {
        Help(text) -> {
          assert(string_contains(text, "Usage: ply " ++ cmd ++ " "));
          assert(string_contains(text, "Print help"))
        },
        _ -> panic("`--help` is help"),
      };
      for_help(rest)
    },
  }

test "the version answers at the top and under a command" {
  match ply_parse(["--version"]) {
    Version(text) -> assert_eq(text, "ply 0.0.0-test"),
    _ -> panic("--version is the version"),
  };
  match ply_parse(["cache", "stats", "--version"]) {
    Version(_) -> (),
    _ -> panic("a command's --version is the version"),
  }
}

test "the top help names every command, the about, and the global flag" {
  match ply_parse(["--help"]) {
    Help(text) -> {
      assert(
        string_contains(
          text,
          "Ply — a language where the verification loop collapses toward zero",
        ),
      );
      assert(string_contains(text, "Usage: ply [OPTIONS] <COMMAND>"));
      assert(string_contains(text, "check"));
      assert(string_contains(text, "cache"));
      assert(string_contains(text, "--color <COLOR>"));
      assert(string_contains(text, "[possible values: auto, always, never]"))
    },
    _ -> panic("top-level --help is help"),
  }
}

test "a profile stands alone and the host flags want `--host`" {
  assert(has(ran(["test", "--profile", "release"]), "profile"));
  assert(string_contains(refusal(["run", "--fs", "src=./crates"]), "requires '--host'"));
  assert(string_contains(refusal(["run", "--drain-ms", "5000"]), "requires '--host'"));
  assert(string_contains(refusal(["prove", "--trace", "text"]), "requires '--host'"))
}

test "`contracts` takes a name and two versions and no path" {
  assert_eq(ran(["contracts", "orders", "0.1.0", "0.2.0"]).positionals, [
    "orders",
    "0.1.0",
    "0.2.0",
  ]);
  assert(string_contains(refusal(["contracts", "orders", "0.1.0"]), "<TO>"))
}

test "`attest` takes a name and a version and no path" {
  assert_eq(ran(["attest", "orders", "0.1.0", "--sign", "k"]).positionals, ["orders", "0.1.0"]);
  assert(string_contains(refusal(["attest", "orders"]), "<VERSION>"))
}

test "a yank takes a name and a version and no path" {
  let p = ran(["yank", "orders", "0.2.0"]);
  assert_eq(p.positionals, ["orders", "0.2.0"]);
  assert(string_contains(refusal(["yank", "orders"]), "<VERSION>"));
  assert_eq(path_of(ran(["publish"])), ".")
}

test "a filesystem root and an executable name their shape" {
  assert(string_contains(refusal(["run", "--host", "--fs", "9bad=./x"]), "an identifier"));
  assert(string_contains(refusal(["run", "--host", "--fs", "src="]), "the path is empty"));
  assert(string_contains(refusal(["run", "--host", "--exec", "cc"]), "there is no `=`"));
  assert(has(ran(["run", "--host", "--fs", "src=./crates", "--exec", "cc=/usr/bin/cc"]), "exec"))
}

// A test that spawns a program or drives a nested machine binds what `ply run` would, under `--host`.
test "a test run takes `--exec` and `--allow` under `--host`, and no trace switch" {
  let p = ran(["test", "--host", "--exec", "ply=/usr/bin/ply", "--allow", "machine"]);
  assert(has(p, "exec"));
  assert_eq(values_of(p, "allow"), ["machine"]);
  assert(string_contains(refusal(["test", "--exec", "ply=/usr/bin/ply"]), "requires '--host'"));
  assert(string_contains(refusal(["test", "--allow", "machine"]), "requires '--host'"));
  assert(string_contains(refusal(["test", "--trace", "auto"]), "--trace"))
}

test "a proof run asks the static tier about every obligation only when `--reach` says so" {
  assert(has(ran(["prove", "--json", "--reach"]), "reach"));
  assert(!has(ran(["prove", "--json"]), "reach"));
  assert(string_contains(refusal(["review", "--reach"]), "--reach"))
}
