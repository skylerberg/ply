// A path on the command line turned into the front end's input: the files under it, each named by
// its place relative to the root, and the shipped modules the run binds as the root `shelf`.

import std.fs (fs)
import std.bytes (u64_le)
import std.hash (blake3)
import compiler.hash (hex)
import std.path (join)
import compiler.front (module_of)
import compiler.resolve (Source, Diag, Label, diag1)
import builder (builder)
import compiler.pkg (Supplied, wants)
import paths
import paths (Rooted, displayed, read_file)
import walk (Failure, Found, named, nothing, is_ply)

// One module of the program: its place below the root, which names it, and its bytes.
pub type File = {
  path: String,
  module: String,
  text: Bytes,
  // Where it was read, which is where a rewrite of it goes.
  at: Rooted,
}

// A dependency package the walk read: its manifest text and its modules, as files for
// placing and as sources for the front end.
pub type DepPackage = {
  /// The key the front end judges it by: a directory for a path dependency, a git key for one
  /// fetched, and the same key either way when it is vendored.
  root: String,
  /// Where its files are: the path itself, the fetched tree, or the vendored copy.
  dir: String,
  manifest: Option<Bytes>,
  files: List<File>,
}

// One vendored package: the want it answers, and the directory `ply vendor` put it in.
pub type Vendored = { want: String, dir: String }

// The program as the front end takes it, with whatever the walk could not turn into a module.
pub type Project = {
  files: List<File>,
  sources: List<Source>,
  diags: List<Diag>,
  manifest: Option<File>,
  packages: List<DepPackage>,
  // The key the package walk rooted at, which dependency paths resolve against.
  root_key: String,
}

pub fn is_std(name: String) -> Bool = name == "std" || string_starts_with(name, "std.")

pub fn is_compiler(name: String) -> Bool =
  name == "compiler" || string_starts_with(name, "compiler.")

// --- Reading them ---------------------------------------------------------------

fn outside() -> Int = 4294967295

fn nowhere(code: Bytes, message: String, label: Bytes, notes: List<Bytes>) -> Diag =
  diag1(code, outside(), { start: 0, end: 0 }, bytes_of_string(message), label, notes)

// A refused file is recorded for its place alone, so the label names it; `m` is that place.
fn at_file(code: Bytes, m: Int, message: String, label: Bytes, notes: List<Bytes>) -> Diag =
  diag1(code, m, { start: 0, end: 0 }, bytes_of_string(message), label, notes)

fn unaddressable(m: Int, path: String, why: String) -> Diag =
  at_file(
    b"E0111",
    m,
    "`" ++ path ++ "` cannot be a module: " ++ why,
    b"this file is not addressable as a module",
    [b"rename it so every directory and the file stem is a plain identifier"],
  )

fn unreadable(path: String) -> Diag =
  nowhere(b"E0502", "could not read `" ++ path ++ "`", b"this path could not be loaded", [
    b"pass a `.ply` file or a directory containing one; the default is `.`",
  ])

pub fn nothing_here(path: String) -> Diag =
  nowhere(b"E0502", "no `.ply` files under `" ++ path ++ "`", b"nothing to compile", [
    b"name a `.ply` file, or a directory that contains one",
    b"directories whose name starts with `.` are not searched",
  ])

// A refused file joins `files` so a label can point at it, and never joins `sources`.
fn refused_file(p: Project, f: File, d: Diag) -> Project =
  { ..p, files: push(p.files, f), diags: push(p.diags, d) }

fn placed(p: Project, at: Rooted, path: String, text: Bytes) -> Project = {
  let here = len(p.files);
  match module_of(path) {
    Err(why) ->
      refused_file(
        p,
        { path: path, module: "", text: text, at: at },
        unaddressable(here, path, why),
      ),
    // The built-in packages' prefixes collide at the front end, which reports them.
    Ok(name) -> {
      {
        ..p,
        files: push(p.files, { path: path, module: name, text: text, at: at }),
        sources: push(p.sources, { name: bytes_of_string(name), src: text }),
      }
    },
  }
}

// One file the walk found, read through its own root and named by its place below `strip`.
fn one_file(
  strip: String,
  p: Project,
  at: Rooted,
) -> Project / {fs.read_file[cwd], fs.read_file[abs]} =
  match read_file(at) {
    None -> { ..p, diags: push(p.diags, unreadable(displayed(at))) },
    Some(text) -> {
      let display = match paths::strip_prefix(at.path, strip) {
        Some(rest) -> if rest == "" { at.path } else { rest },
        None -> at.path,
      };
      placed(p, at, display, text)
    },
  }

fn empty() -> Project =
  { files: [], sources: [], diags: [], manifest: None, packages: [], root_key: "" }

// Every `.ply` file the walk found, in path order, with the ones that cannot be modules refused.
fn read(found: Found, strip: String) -> Project / {fs.read_file[cwd], fs.read_file[abs]} = {
  let filed: Project = fold(map_values(found.files), empty(), |acc: Project, at: Rooted|
    one_file(strip, acc, at));
  fold(found.errors, filed, |acc: Project, e: Failure|
    { ..acc, diags: push(acc.diags, unreadable(e.path)) })
}

// Every path a command was given, each found and read under the root it resolved to, and merged.
pub fn load_resolved(
  rs: List<paths::Resolved>,
) -> Project / {builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs]} = {
  let rs = if len(rs) == 0 { [paths::here()] } else { rs };
  let merged = fold(rs, empty(), |acc: Project, r: paths::Resolved|
    merge(acc, with_manifest(r, read(named(nothing(), paths::rooted(r)), paths::root_prefix(r)))));
  match list_at(rs, 0) {
    None -> merged,
    Some(first) ->
      {
        ..merged,
        packages: walk_packages(first.absolute, merged.manifest),
        root_key: first.absolute,
      },
  }
}

// --- The package walk ---------------------------------------------------------
// What the root's manifest asks for, round by round, under `abs` so a sibling directory is
// as reachable as a child one. All judgments about the graph are the front end's; this walk
// only reads what `wants` names.

fn read_dep_modules(
  root: String,
) -> List<File> / {builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs]} = {
  let swept = at_abs(root);
  let found = named(nothing(), swept);
  fold(map_values(found.files), [], |acc: List<File>, at: Rooted|
    match paths::strip_prefix(at.path, swept.path) {
      None -> acc,
      Some(rest) -> match read_file(at) {
        None -> acc,
        Some(text) -> match module_of(rest) {
          Err(_) -> acc,
          Ok(name) -> push(acc, { path: root ++ "/" ++ rest, module: name, text: text, at: at }),
        },
      },
    })
}

// `abs` is rooted at the filesystem's root and takes paths relative to it, so an absolute key
// reads as its own spelling without the leading slash.
pub fn under_abs(path: String) -> String =
  if string_starts_with(path, "/") { string_slice(path, 1, string_len(path)) } else { path }

fn at_abs(path: String) -> Rooted = { label: "abs", path: under_abs(path) }

fn read_dep(
  root: Bytes,
  dir: String,
) -> DepPackage / {builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs]} = {
  let here = string_of_bytes_lossy(root);
  match read_file(at_abs(join(dir, "ply.pkg"))) {
    None -> { root: here, dir: dir, manifest: None, files: [] },
    Some(text) -> { root: here, dir: dir, manifest: Some(text), files: read_dep_modules(dir) },
  }
}

// --- Vendored packages ----------------------------------------------------------
// `ply vendor` copies a closure into `vendor/`, one directory per package, and writes an index of
// which want each answers. A walk that finds the index reads those trees and asks nothing else:
// that is what makes a vendored checkout build anywhere, with no cache and no git.

pub fn index_path(project: String) -> String = join(project, "vendor/index")

/// The index a project holds, or none: a project that was not vendored reads nothing extra.
pub fn vendored(
  project: String,
) -> List<Vendored> / {builder.git[vcs], fs.read_file[cwd], fs.read_file[abs]} =
  match read_file(at_abs(index_path(project))) { None -> [], Some(text) -> index_of(text) }

// One line per package: `<want>\t<dir>`, in the order `ply vendor` wrote them.
fn index_of(text: Bytes) -> List<Vendored> =
  fold(bytes_split(text, b"\n"), [], |acc: List<Vendored>, line: Bytes|
    match bytes_index_of(line, b"\t") {
      None -> acc,
      Some(tab) ->
        push(acc, {
          want: string_of_bytes_lossy(bytes_slice(line, 0, tab)),
          dir: string_of_bytes_lossy(bytes_slice(line, tab + 1, bytes_len(line))),
        }),
    })

// The index holds a directory relative to the project, so it survives the project moving; what the
// walk needs is where that is *here*, which is why the root is an argument.
pub fn from_vendor(project: String, items: List<Vendored>, want: Bytes) -> Option<String> =
  fold(items, None, |found: Option<String>, v: Vendored|
    match found {
      Some(_) -> found,
      None -> if bytes_of_string(v.want) == want { Some(join(project, v.dir)) } else { None },
    })

fn walk_round(
  root: String,
  vendored: List<Vendored>,
  known: List<Bytes>,
  manifests: List<Supplied>,
  supplied: List<DepPackage>,
) -> List<DepPackage> / {builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs]} =
  match wants(known, manifests) {
    [] -> supplied,
    wanted -> {
      let next = fold(
        wanted,
        { known: known, manifests: manifests, supplied: supplied },
        |acc: { known: List<Bytes>, manifests: List<Supplied>, supplied: List<DepPackage> }, want: Bytes| {
          match tree_of(root, vendored, want) {
            // A fetch that failed contributes no package: the walk has asked, and the front end's
            // judgment says the dependency was not fetched, naming the key it wanted.
            None -> { ..acc, known: push(acc.known, want) },
            Some(tree) -> {
              let package = read_dep(want, tree);
              {
                known: push(acc.known, want),
                manifests: push(acc.manifests, {
                  root: want,
                  manifest: package.manifest,
                  modules: [],
                }),
                supplied: push(acc.supplied, package),
              }
            },
          }
        },
      );
      walk_round(root, vendored, next.known, next.manifests, next.supplied)
    },
  }

fn walk_packages(
  root: String,
  manifest: Option<File>,
) -> List<DepPackage> / {builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs]} = {
  let root_key = bytes_of_string(root);
  walk_round(
    root,
    vendored(root),
    [root_key],
    [
      {
        root: root_key,
        manifest: match manifest { None -> None, Some(f) -> Some(f.text) },
        modules: [],
      },
    ],
    [],
  )
}

// Where a want's files are: a path is its own directory, and a git key names a tree the project's
// cache holds, fetched when it is not there yet. The key is what the package is *named* by, so a
// fetch that moves a tree changes nothing the front end sees.
pub fn tree_of(
  project: String,
  vendored: List<Vendored>,
  want: Bytes,
) -> Option<String> / {builder.git[vcs]} =

  // A vendored copy answers the want whether it is a path or a git key: that is what it is for.
  match from_vendor(project, vendored, want) {
    Some(dir) -> Some(dir),
    None -> fetched(project, want),
  }

fn fetched(project: String, want: Bytes) -> Option<String> / {builder.git[vcs]} =
  if bytes_starts_with(want, b"git+") {
    // A fetch that failed has nothing to read: the front end then reports the dependency as one
    // that was not fetched, which is what a reader can act on (`ply check` names the key).
    match builder.git[vcs](project, string_of_bytes_lossy(want)) {
      Err(_) -> None,
      Ok(dir) -> Some(dir),
    }
  } else { Some(string_of_bytes_lossy(want)) }

// The root's `ply.pkg`, when there is one; the first root to have one wins the merge.
fn with_manifest(
  r: paths::Resolved,
  p: Project,
) -> Project / {fs.read_file[cwd], fs.read_file[abs]} =
  match p.manifest {
    Some(_) -> p,
    None -> {
      let at = paths::in_root(r, "ply.pkg");
      match read_file(at) {
        None -> p,
        Some(text) ->
          { ..p, manifest: Some({ path: displayed(at), module: "", text: text, at: at }) },
      }
    },
  }

fn merge(a: Project, b: Project) -> Project = {
  let files = fold(b.files, a.files, |acc: List<File>, f: File| push(acc, f));
  let sources = fold(b.sources, a.sources, |acc: List<Source>, s: Source| push(acc, s));
  {
    files: files,
    sources: sources,
    diags: fold(b.diags, a.diags, |acc: List<Diag>, d: Diag| push(acc, d)),
    manifest: match a.manifest { Some(_) -> a.manifest, None -> b.manifest },
    packages: fold(b.packages, a.packages, |acc: List<DepPackage>, p: DepPackage| push(acc, p)),
    root_key: if a.root_key == "" { b.root_key } else { a.root_key },
  }
}

// --- The shelf ----------------------------------------------------------------
// The modules this binary ships, one flat directory of `<dotted name>.ply`, bound as `shelf`.

fn stem(name: String) -> String = string_slice(name, 0, string_len(name) - 4)

// The digest over the shipped modules among `srcs`: each module as its name's length and bytes then
// its source's own hash, hashed in name order.
pub fn shipped_digest_of(srcs: List<Source>) -> String = {
  let parts = map(
    filter(srcs, |src: Source| is_std(string_of_bytes_lossy(src.name))),
    |src: Source|
      bytes_concat_all([
        u64_le(string_len(string_of_bytes_lossy(src.name))),
        src.name,
        blake3(src.src),
      ]),
  );
  "b3:" ++ string_of_bytes(bytes_slice(hex(blake3(bytes_concat_all(parts))), 0, 12))
}

pub fn shelf() -> List<Source> / {builder.git[vcs], fs.list_dir[shelf], fs.read_file[shelf]} =
  match fs.list_dir[shelf](".") {
    None -> [],
    Some(names) ->
      fold(names, [], |acc: List<Source>, name: String|
        if !is_ply(name) { acc } else {
          match fs.read_file[shelf](name) {
            None -> acc,
            Some(src) -> push(acc, { name: bytes_of_string(stem(name)), src: src }),
          }
        }),
  }

// --- Tests ------------------------------------------------------------------

test "a path names a module by its place, and a segment that is not an identifier does not" {
  assert_eq(module_of("m.ply"), Ok("m"));
  assert_eq(module_of("store/orders.ply"), Ok("store.orders"));
  assert_eq(module_of("a/b/c.ply"), Ok("a.b.c"));
  assert_eq(module_of("_kept.ply"), Ok("_kept"));
  assert_eq(module_of("my-file.ply"), Err("`my-file` is not an identifier"));
  assert_eq(module_of("9lives.ply"), Err("`9lives` is not an identifier"));
  assert_eq(module_of("a b/c.ply"), Err("`a b` is not an identifier"));
  // The rule is ASCII: a non-ASCII segment is refused here as the lexer refuses it in source.
  assert_eq(module_of("café.ply"), Err("`café` is not an identifier"))
}

test "the reserved roots are the ones this binary ships under" {
  assert(is_std("std"));
  assert(is_std("std.json"));
  assert(!is_std("standard"));
  assert(is_compiler("compiler"));
  assert(is_compiler("compiler.fmt"));
  assert(!is_compiler("compilers"))
}

// The walk's answer for files it found in the working directory.
fn found_here(names: List<String>) -> Found =
  {
    files: fold(names, map_new(), |acc: Map<String, Rooted>, path: String|
      map_insert(acc, path, { label: "cwd", path: path })),
    errors: [],
  }

test "a file that cannot be a module is refused and does not reach the front end" {
  let p = handle {
    read(found_here(["m.ply", "my-file.ply"]), "")
  } with {
    fs.read_file[cwd](path) -> Some(b"fn f() -> Int = 1\n"),
    fs.read_file[abs](path) -> panic("nothing here leaves the working directory"),
  };
  assert_eq(len(p.sources), 1);
  assert_eq(len(p.diags), 1);
  assert_eq(match list_at(p.diags, 0) { Some(d) -> d.code, None -> b"" }, b"E0111");
  // The refused file is kept only so the label can name it.
  assert_eq(map(p.files, |f: File| f.path), ["m.ply", "my-file.ply"]);
  assert_eq(
    match list_at(p.diags, 0) { Some(d) -> map(d.labels, |l: Label| l.module), None -> [] },
    [1],
  )
}

test "a project file under the compiler root walks on to the front end's collision" {
  let p = handle {
    read(found_here(["compiler/fmt.ply"]), "")
  } with {
    fs.read_file[cwd](path) -> Some(b"fn f() -> Int = 1\n"),
    fs.read_file[abs](path) -> panic("nothing here leaves the working directory"),
  };
  assert_eq(len(p.diags), 0);
  assert_eq(match list_at(p.sources, 0) { Some(s) -> s.name, None -> b"" }, b"compiler.fmt")
}

test "a project file under std walks on to the front end's collision" {
  let p = handle {
    read(found_here(["std/json.ply"]), "")
  } with {
    fs.read_file[cwd](path) -> Some(b"fn f() -> Int = 1\n"),
    fs.read_file[abs](path) -> panic("nothing here leaves the working directory"),
  };
  assert_eq(len(p.diags), 0);
  assert_eq(match list_at(p.sources, 0) { Some(s) -> s.name, None -> b"" }, b"std.json")
}

test "a file found outside the working directory is read there, named below its root" {
  let found: Found = {
    files: map_insert(map_new(), "/srv/app/store/orders.ply", {
      label: "abs",
      path: "srv/app/store/orders.ply",
    }),
    errors: [],
  };
  let p = handle {
    read(found, "srv/app")
  } with {
    fs.read_file[cwd](path) -> panic("a file found under `abs` is read under `abs`"),
    fs.read_file[abs](path) -> if path == "srv/app/store/orders.ply" {
      Some(b"fn f() -> Int = 1\n")
    } else { None },
  };
  assert_eq(len(p.diags), 0);
  assert_eq(map(p.files, |f: File| f.path), ["store/orders.ply"]);
  assert_eq(map(p.files, |f: File| f.at), [{ label: "abs", path: "srv/app/store/orders.ply" }]);
  assert_eq(match list_at(p.sources, 0) { Some(s) -> s.name, None -> b"" }, b"store.orders")
}

test "the manifest is the one in the root's directory, whichever file in it the path named" {
  let file: paths::Resolved = {
    label: "abs",
    spelling: "srv/app",
    display: "/srv/app",
    inside: "main.ply",
    absolute: "/srv/app",
    machine: "/srv/app/main.ply",
  };
  let p = handle {
    with_manifest(file, empty())
  } with {
    fs.read_file[cwd](path) -> panic("a root under `abs` is read under `abs`"),
    fs.read_file[abs](path) -> if path == "srv/app/ply.pkg" { Some(b"manifest") } else { None },
  };
  match p.manifest {
    None -> panic("the manifest beside the file was not read"),
    Some(f) -> {
      assert_eq(f.path, "/srv/app/ply.pkg");
      assert_eq(f.at, { label: "abs", path: "srv/app/ply.pkg" })
    },
  }
}

test "the shelf hands back one source per `.ply` file, named by its stem" {
  let out = handle {
    shelf()
  } with {
    builder.git[vcs](root, key) -> Err({ diags: [], places: [] }),
    fs.list_dir[shelf](p) -> Some(["std.json.ply", "README.md", "compiler.fmt.ply"]),
    fs.read_file[shelf](p) -> Some(bytes_of_string(p)),
  };
  assert_eq(map(out, |s: Source| s.name), [b"std.json", b"compiler.fmt"])
}
