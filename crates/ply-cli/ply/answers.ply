//! A test run's answer, kept for the next run over the same command and files: one that ran nothing
//! answers the next exactly while every pass it took still stands and every shipped definition its
//! program reached hashes as it did, so that run answers without loading the program. The answer is
//! filed in the test store under a key of the `ply` program, the walk and the command line, beside
//! the keys whose passes it took and the views its load told of the shipped modules.

import compiler.hash (hex)
import compiler.interface (sized)
import reused
import sources (Project)
import std.bin
import std.fs (fs)
import std.hash (blake3)

/// What a run that ran nothing answered: the lines it printed before its answer, the answer, the
/// keys of the passes it took, and its load's views of the shipped modules, as a trace holds them.
pub type Kept = {
  opening: List<String>,
  lines: List<String>,
  errs: List<String>,
  code: Int,
  json: String,
  passes: List<String>,
  views: Bytes,
}

derive bin for Kept

/// The `ply` program running and the runtime it runs on: what its definitions hash to and the
/// runtime's stamps, which leave out every shipped definition the program does not reach.
pub fn program() -> Bytes / {fs.read_file[shipped], abort.raise} =
  blake3(
    bytes_concat_all([
      sized(match fs.read_file[shipped]("definitions") { Some(b) -> b, None -> b"" }),
      sized(match fs.read_file[shipped]("stamps") { Some(b) -> b, None -> b"" }),
    ]),
  )

/// The key a run's answer is kept under: the program, its whole command line, and every file its
/// walk read. Where it ran is not in it: a path the line names relatively is in what the walk read,
/// and a trace names what it read under the root that held it.
pub fn key_of(program: Bytes, argv: List<String>, project: Project) -> String / {abort.raise} =
  string_of_bytes(
    hex(
      blake3(
        bytes_concat_all([
          sized(b"ply test answer 1"),
          sized(bytes_of_string(int_to_string(len(argv)))),
          bytes_concat_all(map(argv, |a: String| sized(bytes_of_string(a)))),
          sized(
            bytes_of_string(
              reused::key_of({ stamp: string_of_bytes(hex(program)), version: "" }, project, None),
            ),
          ),
        ]),
      ),
    ),
  )

pub fn encoded(k: Kept) -> Bytes / {abort.raise} = bin::encode(k, kept_bin())

pub fn decoded(b: Bytes) -> Option<Kept> / {abort.raise} =
  match bin::decode(b, kept_bin()) { Ok(k) -> Some(k), Err(_) -> None }

// --- Tests ------------------------------------------------------------------

test "a kept answer reads back as it was written" {
  let k = {
    opening: ["head"],
    lines: ["0 failed"],
    errs: [],
    code: 0,
    json: "{}",
    passes: ["ab", "cd"],
    views: b"shipform\tstd.list\tt\tf\n",
  };
  assert_eq(decoded(encoded(k)), Some(k));
  assert_eq(decoded(b"not one"), None)
}
