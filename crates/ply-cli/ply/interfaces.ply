//! The interface a registry published for a dependency, which `ply resolve` leaves in the
//! dependency's slot: where it lies, and whether it re-derives from the dependency's source.

import std.bin
import std.fs (fs)
import compiler.front (Analysis)
import compiler.interface (Interface, ModuleInterface, interface_of, interface_bin, envelope_of)
import compiler.pkg (PackageSources, closure, registry_dir)
import compiler.resolve (Diag, Source, error_at)
import semantics
import sources (under_abs)
import compiler.parsing (no_module)

/// Each module of `pkgs`' dependencies a load of `roots` reads, named as the closure names it.
pub fn dependency_sources(
  pkgs: PackageSources,
  roots: List<Bytes>,
) -> List<Source> / {abort.raise} =
  map(closure(pkgs, roots).modules, |m: { pkg: Int, src: Source }| m.src)

// --- Published interfaces --------------------------------------------------------------
// `ply resolve` leaves the interface a registry published for a dependency in the dependency's slot,
// under the semantics it was cut with, where a walk never reads a module.

pub fn slot_interface(slot: String) -> String = slot ++ "/.interface/" ++ semantics::version()

/// What the registry's attester signed of the dependency, beside it the same way.
pub fn slot_attestation(slot: String) -> String = slot ++ "/.attestation/" ++ semantics::version()

/// The slots among the roots of a walk's packages: its registry dependencies.
pub fn slots(root_key: String, roots: List<String>) -> List<String> / {abort.raise} = {
  let dir = string_of_bytes_lossy(registry_dir(bytes_of_string(root_key))) ++ "/";
  filter(roots, |r: String| string_starts_with(r, dir))
}

pub fn slot_read(slot: String) -> Option<Bytes> / {fs.read_file[abs], abort.raise} =
  fs.read_file[abs](under_abs(slot_interface(slot)))

// --- Re-deriving a published interface -------------------------------------------------

fn underived_diag(slot: String, what: String) -> Diag =
  error_at(
    b"E0149",
    no_module(),
    { start: 0, end: 0 },
    bytes_of_string(
      "the interface published for `" ++ last_segment(slot)
        ++ "` does not re-derive from its source: "
        ++ what
        ++ " differs",
    ),
    b"not what the package's source makes",
    [
      b"the registry that served it, or the slot `ply resolve` left it in, holds what no analysis of the package cuts",
      b"the load read every dependency from source, so nothing it answered relies on the interface",
    ],
  )

fn last_segment(path: String) -> String =
  match list_at(string_split(path, "/"), len(string_split(path, "/")) - 1) {
    Some(s) -> s,
    None -> path,
  }

fn first_some<a>(xs: List<a>, f: (a) -> Option<String>) -> Option<String> =
  fold(xs, None, |found: Option<String>, x: a| match found { Some(_) -> found, None -> f(x) })

/// What `published` holds that `own`, the same modules cut from this load's analysis, does not.
fn difference(published: Interface, own: Interface) -> Option<String> = {
  let modules = fold(
    own.modules,
    map_new(),
    |acc: Map<Bytes, ModuleInterface>, m: ModuleInterface| map_insert(acc, m.exports.module, m),
  );
  first_some(published.modules, |m: ModuleInterface| {
    let named = "`" ++ string_of_bytes_lossy(m.exports.module) ++ "`";
    match map_get(modules, m.exports.module) {
      None -> Some(named),
      Some(o) -> if o.exports != m.exports { Some(named ++ "'s exports") }
      else if o.hashes != m.hashes { Some(named ++ "'s hashes") }
      else { None },
    }
  })
}

/// A published interface cut under these semantics.
fn decoded(bytes: Bytes) -> Option<Interface> / {abort.raise} =
  match envelope_of(bytes) {
    None -> None,
    Some(e) -> if e.semantics != bytes_of_string(semantics::version()) { None }
    else { match bin::decode(e.payload, interface_bin()) { Err(_) -> None, Ok(p) -> Some(p) } },
  }

/// Each published interface that stands, against what this load's own analysis cuts of the same
/// modules, each read from its text among `sources`. The load read every dependency from source, so
/// `analysis` is the interface's own derivation.
pub fn underived(
  slots: List<String>,
  sources: List<Source>,
  analysis: Analysis,
) -> List<Diag> / {fs.read_file[abs], abort.raise} =
  fold(slots, [], |acc: List<Diag>, slot: String|
    match slot_read(slot) {
      None -> acc,
      Some(bytes) -> match decoded(bytes) {
        None -> acc,
        Some(p) -> match difference(
            p,
            interface_of(analysis, sources, map(p.modules, |m: ModuleInterface| m.exports.module)),
          ) {
          None -> acc,
          Some(what) -> push(acc, underived_diag(slot, what)),
        },
      },
    })
