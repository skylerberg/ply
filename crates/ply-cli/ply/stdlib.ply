// `ply std` — the modules that ship with the compiler, as the shelf this run was bound holds
// them. The digest is the binary's own fact and travels in a flag, as colour does.

import args (Flags, style_of)
import diagnostic (all_to_json, all_to_text, errors_of)
import program (outside)
import report (Answer, schema_version, ok_code, compile_error, ind, count_of)
import sources (is_std, shelf)
import show (source_lines)
import style (Style)
import compiler.diag (parse_all)
import compiler.hash (hex)
import compiler.front (Whole, Refused, Analysed, analyse, module_items)
import compiler.infer (CtorInfo, TestInfo)
import compiler.resolve (Source, Mod, Diag, diag1)
import std.fs (fs)
import std.bytes (u64_le)
import std.hash (blake3)
import std.json (Json, Str, Bool, Number, Array, object)

// One shipped module: what it declares, what it tests and how big it is.
pub type Row = { name: String, definitions: Int, tests: Int, bytes: Int }

fn shipped() -> List<Source> / {fs.list_dir[shelf], fs.read_file[shelf]} =
  filter(shelf(), |src: Source| is_std(string_of_bytes_lossy(src.name)))

// The digest over the shipped modules, computed where they are read: each module as its name's
// length and bytes then its source's own hash, hashed in name order.
fn std_digest() -> String / {fs.list_dir[shelf], fs.read_file[shelf]} = {
  let parts = map(shipped(), |src: Source|
    bytes_concat_all([
      u64_le(string_len(string_of_bytes_lossy(src.name))),
      src.name,
      blake3(src.src),
    ]));
  "b3:" ++ string_of_bytes(bytes_slice(hex(blake3(bytes_concat_all(parts))), 0, 12))
}

fn joined(parts: List<String>, sep: String) -> String =
  fold(range(0, len(parts)), "", |acc: String, i: Int|
    match list_at(parts, i) { Some(x) -> if i == 0 { x } else { acc ++ sep ++ x }, None -> acc })

// --- The rows -----------------------------------------------------------------

fn module_named(w: Whole, name: Bytes) -> Option<Mod> =
  fold(w.mods, None, |acc: Option<Mod>, mo: Mod|
    match acc { Some(_) -> acc, None -> if mo.name == name { Some(mo) } else { None } })

// A constructor is reached through its type rather than declared on its own.
fn ctors_in(w: Whole, name: Bytes) -> Int =
  fold(w.checked.ctors, 0, |acc: Int, c: CtorInfo| if c.module == name { acc + 1 } else { acc })

fn tests_in(w: Whole, name: Bytes) -> Int =
  fold(w.checked.tests, 0, |acc: Int, x: TestInfo| if x.module == name { acc + 1 } else { acc })

fn row_of(w: Whole, src: Source) -> Row = {
  let items = match module_named(w, src.name) { Some(mo) -> len(module_items(mo)), None -> 0 };
  let ctors = ctors_in(w, src.name);
  {
    name: string_of_bytes_lossy(src.name),
    definitions: if items > ctors { items - ctors } else { 0 },
    tests: tests_in(w, src.name),
    bytes: bytes_len(src.src),
  }
}

fn rows_of(w: Whole, srcs: List<Source>) -> List<Row> = map(srcs, |src: Source| row_of(w, src))

// A shipped module the front end refuses is Ply's fault, never the user's.
fn shipped_refused(ds: List<Diag>) -> Diag =
  diag1(
    b"E0505",
    outside(),
    { start: 0, end: 0 },
    bytes_of_string("the shipped modules do not compile: " ++ why_of(ds)),
    b"this is a defect in the compiler's own sources, not in this program",
    [b"please report it with the version of `ply` that produced it"],
  )

fn why_of(ds: List<Diag>) -> String =
  joined(
    map(errors_of(ds), |d: Diag|
      string_of_bytes_lossy(d.message) ++ " [" ++ string_of_bytes_lossy(d.code) ++ "]"),
    "; ",
  )

// --- The listing ----------------------------------------------------------------

fn headers() -> List<String> = ["MODULE", "DEFINITIONS", "TESTS", "BYTES"]

fn cells_of(r: Row) -> List<String> =
  [r.name, int_to_string(r.definitions), int_to_string(r.tests), int_to_string(r.bytes)]

fn cell_at(row: List<String>, i: Int) -> String = match list_at(row, i) { Some(c) -> c, None -> "" }

fn width_at(rows: List<List<String>>, i: Int) -> Int =
  fold(rows, 0, |acc: Int, row: List<String>| {
    let w = string_len(cell_at(row, i));
    if w > acc { w } else { acc }
  })

fn spaces(n: Int) -> String = fold(range(0, n), "", |acc: String, i: Int| acc ++ " ")

fn padded(text: String, width: Int) -> String = text ++ spaces(width - string_len(text))

// Every column but the last is padded to its width and followed by two spaces.
fn laid_out(row: List<String>, widths: List<Int>) -> String =
  fold(range(0, len(row)), "", |acc: String, i: Int|
    if i + 1 == len(row) { acc ++ cell_at(row, i) } else {
      acc ++ padded(cell_at(row, i), match list_at(widths, i) { Some(w) -> w, None -> 0 }) ++ "  "
    })

fn grid_of(rows: List<Row>) -> List<List<String>> =
  fold(rows, [headers()], |acc: List<List<String>>, r: Row| push(acc, cells_of(r)))

fn table(rows: List<Row>) -> List<String> = {
  let grid = grid_of(rows);
  let widths = map(range(0, len(headers())), |i: Int| width_at(grid, i));
  map(grid, |row: List<String>| laid_out(row, widths))
}

fn total(rows: List<Row>) -> Int = fold(rows, 0, |acc: Int, r: Row| acc + r.definitions)

fn appended(head: List<String>, tail: List<String>) -> List<String> =
  fold(tail, head, |acc: List<String>, l: String| push(acc, l))

// Every line without the indent, so the shape is testable without a terminal.
pub fn listing(rows: List<Row>, digest: String) -> List<String> = {
  let head = [
    count_of(len(rows), "module") ++ " · " ++ count_of(total(rows), "definition")
      ++ " · shipped with this compiler",
    "",
  ];
  let body = if len(rows) == 0 { ["this build ships no stdlib module"] } else { table(rows) };
  appended(appended(head, body), [
    "",
    "`import std.<name>` to use one; `ply std --show <name>` prints its source",
    "",
    "digest: " ++ digest,
  ])
}

fn indented(lines: List<String>) -> List<String> =
  map(lines, |l: String| if l == "" { "" } else { ind() ++ l })

// --- The documents ----------------------------------------------------------------

fn row_json(r: Row) -> Json =
  object([
    { key: "module", value: Str(r.name) },
    { key: "definitions", value: Number(decimal_of_int(r.definitions)) },
    { key: "tests", value: Number(decimal_of_int(r.tests)) },
    { key: "bytes", value: Number(decimal_of_int(r.bytes)) },
  ])

fn listing_json(rows: List<Row>, digest: String) -> Json =
  object([
    { key: "command", value: Str("std") },
    { key: "schema_version", value: Number(decimal_of_int(schema_version())) },
    { key: "ok", value: Bool(true) },
    { key: "exit_code", value: Number(decimal_of_int(ok_code())) },
    { key: "modules", value: Array(map(rows, row_json)) },
    { key: "definitions", value: Number(decimal_of_int(total(rows))) },
    { key: "digest", value: Str(digest) },
    { key: "diagnostics", value: Array([]) },
  ])

fn listed(rows: List<Row>, digest: String) -> Answer =
  {
    json: listing_json(rows, digest),
    lines: appended([""], indented(listing(rows, digest))),
    errs: [],
    code: ok_code(),
  }

fn digested(digest: String) -> Answer =
  {
    json: object([
      { key: "command", value: Str("std") },
      { key: "schema_version", value: Number(decimal_of_int(schema_version())) },
      { key: "ok", value: Bool(true) },
      { key: "exit_code", value: Number(decimal_of_int(ok_code())) },
      { key: "digest", value: Str(digest) },
    ]),
    lines: [digest],
    errs: [],
    code: ok_code(),
  }

fn sourced(name: String, text: Bytes) -> Answer = {
  let source = string_of_bytes_lossy(text);
  {
    json: object([
      { key: "command", value: Str("std") },
      { key: "schema_version", value: Number(decimal_of_int(schema_version())) },
      { key: "ok", value: Bool(true) },
      { key: "exit_code", value: Number(decimal_of_int(ok_code())) },
      { key: "module", value: Str(name) },
      { key: "source", value: Str(source) },
    ]),
    lines: source_lines(source),
    errs: [],
    code: ok_code(),
  }
}

fn stopped(s: Style, d: Diag) -> Answer =
  {
    json: object([
      { key: "command", value: Str("std") },
      { key: "schema_version", value: Number(decimal_of_int(schema_version())) },
      { key: "ok", value: Bool(false) },
      { key: "exit_code", value: Number(decimal_of_int(compile_error())) },
      { key: "diagnostics", value: all_to_json([d], []) },
    ]),
    lines: [],
    errs: all_to_text(s, [d], []),
    code: compile_error(),
  }

// --- What a run answers -------------------------------------------------------------

pub fn unknown_module(query: String, names: List<String>) -> Diag =
  diag1(
    b"E0106",
    outside(),
    { start: 0, end: 0 },
    bytes_of_string("no module named `" ++ query ++ "` ships with this compiler"),
    b"not found",
    [
      bytes_of_string(
        "the stdlib holds: " ++ joined(map(names, |n: String| "`" ++ n ++ "`"), ", "),
      ),
      b"`ply std` lists them with the digest this binary was built from",
    ],
  )

fn shown(s: Style, query: String, srcs: List<Source>) -> Answer =
  match fold(srcs, None, |acc: Option<Source>, src: Source|
      match acc {
        Some(_) -> acc,
        None -> if string_of_bytes_lossy(src.name) == query { Some(src) } else { None },
      }) {
    Some(src) -> sourced(query, src.src),
    None ->
      stopped(s, unknown_module(query, map(srcs, |src: Source| string_of_bytes_lossy(src.name)))),
  }

fn counted(s: Style, flags: Flags, srcs: List<Source>) -> Answer =
  match analyse(parse_all(srcs)) {
    Refused(ds) -> stopped(s, shipped_refused(ds)),
    Analysed(w) -> listed(rows_of(w, srcs), std_digest()),
  }

pub fn run(flags: Flags) -> Answer / {fs.list_dir[shelf], fs.read_file[shelf]} = {
  let s = style_of(flags);
  if flags.digest { digested(std_digest()) }
  else if flags.query != "" { shown(s, flags.query, shipped()) }
  else { counted(s, flags, shipped()) }
}

// --- Tests ------------------------------------------------------------------

fn two_rows() -> List<Row> =
  [
    { name: "std.bytes", definitions: 12, tests: 4, bytes: 3100 },
    { name: "std.json", definitions: 130, tests: 40, bytes: 29000 },
  ]

test "the listing opens on the tally, lays the columns out and ends on the digest" {
  let lines = listing(two_rows(), "b3:1f2e3d4c5b6a");
  assert_eq(
    match list_at(lines, 0) { Some(l) -> l, None -> "" },
    "2 modules · 142 definitions · shipped with this compiler",
  );
  assert_eq(match list_at(lines, 1) { Some(l) -> l, None -> "" }, "");
  assert_eq(
    match list_at(lines, 2) { Some(l) -> l, None -> "" },
    "MODULE     DEFINITIONS  TESTS  BYTES",
  );
  assert_eq(
    match list_at(lines, 3) { Some(l) -> l, None -> "" },
    "std.bytes  12           4      3100",
  );
  assert_eq(
    match list_at(lines, len(lines) - 1) { Some(l) -> l, None -> "" },
    "digest: b3:1f2e3d4c5b6a",
  )
}

test "a build that ships nothing says so instead of laying out an empty table" {
  let lines = listing([], "b3:000000000000");
  assert_eq(
    match list_at(lines, 0) { Some(l) -> l, None -> "" },
    "0 modules · 0 definitions · shipped with this compiler",
  );
  assert_eq(
    match list_at(lines, 2) { Some(l) -> l, None -> "" },
    "this build ships no stdlib module",
  )
}

test "`--digest` is the one line a CI check pins, and nothing else" {
  let answer = digested("b3:1f2e3d4c5b6a");
  assert_eq(answer.lines, ["b3:1f2e3d4c5b6a"]);
  assert_eq(answer.errs, []);
  assert_eq(answer.code, 0)
}

test "a module that ships with no such name is `E0106` and lists the ones that do" {
  let d = unknown_module("std.nope", ["std.bytes", "std.json"]);
  assert_eq(d.code, b"E0106");
  assert_eq(d.message, b"no module named `std.nope` ships with this compiler");
  assert_eq(
    match list_at(d.notes_text, 0) { Some(n) -> n, None -> b"" },
    b"the stdlib holds: `std.bytes`, `std.json`",
  )
}

test "a module's source is written back as its own lines" {
  let answer = sourced("std.m", b"pub fn one() -> Int = 1\n");
  assert_eq(answer.lines, ["pub fn one() -> Int = 1"]);
  assert_eq(answer.code, 0)
}
