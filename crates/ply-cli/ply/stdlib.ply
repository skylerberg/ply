//! `ply std` — the modules that ship with the compiler and the data files they embed, as the
//! directory this run was bound as `shipped` holds them.

import builder (builder)
import args (Flags, style_of)
import diagnostic (all_to_json, all_to_text, errors_of, errors_text)
import report (Answer, schema_version, ok_code, compile_error, indent, count_of)
import sources (is_std, shipped_modules, shipped_data, shipped_digest_of)
import queried
import show (source_lines)
import doc (summary_of)
import std.term (Style, plain)
import compiler.hash (hex)
import compiler.unit (shipped, identity_of)
import compiler.front (ShippedData, parse_shipped, shipped_data_wanted)
import compiler.items (Item, IFn, IType, IEffect, ITest)
import compiler.resolve (Source, ParsedModule, Diag, error_at)
import std.fs (fs)
import std.hash (blake3)
import std.json (Json, Str, Bool, Number, Array, object)
import std.list
import std.string
import std.text
import hosts (indented)
import compiler.parsing (no_module, dummy_span)
import std.path (below_root)

/// A data file a shipped module embeds: the name `--show` prints it by, and its size.
pub type Held = { name: String, bytes: Int }

/// One shipped module: what it declares, what it tests, how big it is, the data files it embeds
/// and the first sentence of its doc.
pub type Row = {
  name: String,
  definitions: Int,
  tests: Int,
  bytes: Int,
  data: List<Held>,
  summary: String,
}

/// The standard library's modules in name order, which their files' is not: `std.hash.legacy.ply`
/// sorts before `std.hash.ply`.
fn shipped() -> List<Source> / {fs.list_dir[shipped], fs.read_file[shipped], abort.raise} =
  shipped_modules().filter(|src: Source| is_std(String::of_bytes_lossy(src.name))).sort_by_key(
    |src: Source| String::of_bytes_lossy(src.name),
  )

// --- The rows -----------------------------------------------------------------

/// What a module declares on its own, a constructor being reached through its type.
fn declared(parsed: ParsedModule) -> Int =
  parsed.module.items.fold(0, |n: Int, item: Item|
    match item { IFn(_) -> n + 1, IType(_) -> n + 1, IEffect(_) -> n + 1, _ -> n })

fn tested(parsed: ParsedModule) -> Int =
  parsed.module.items.fold(0, |n: Int, item: Item| match item { ITest(_) -> n + 1, _ -> n })

/// The data files `src` embeds, of those the shipped modules hold.
fn held_by(src: Source, data: List<ShippedData>) -> List<Held> / {abort.raise} =
  shipped_data_wanted(src).fold([], |acc: List<Held>, name: Bytes|
    data.fold(acc, |a: List<Held>, d: ShippedData|
      if d.name == name { a.push({ name: String::of_bytes_lossy(name), bytes: d.bytes.len() }) }
      else { a }))

fn row_of(parsed: ParsedModule, src: Source, data: List<ShippedData>) -> Row / {abort.raise} =
  {
    name: String::of_bytes_lossy(src.name),
    definitions: declared(parsed),
    tests: tested(parsed),
    bytes: src.src.len(),
    data: held_by(src, data),
    summary: match parsed.module.doc {
      Some(d) -> summary_of(d.lines.map(|l: Bytes| String::of_bytes_lossy(l))),
      None -> "",
    },
  }

/// Each module's row, read off its parse: nothing the listing says needs the modules checked.
fn rows_of(srcs: List<Source>, data: List<ShippedData>) -> List<Row> / {abort.raise} = {
  let parsed = parse_shipped(srcs, srcs, data);
  range(0, srcs.len()).map(|i: Int| row_of(parsed.get(i).module, srcs.get(i), data))
}

// --- The listing ----------------------------------------------------------------

fn headers() -> List<String> = ["MODULE", "DEFINITIONS", "TESTS", "BYTES", "DATA", "SUMMARY"]

fn data_bytes(row: Row) -> Int = row.data.fold(0, |acc: Int, held: Held| acc + held.bytes)

fn cells_of(row: Row) -> List<String> =
  [
    row.name,
    row.definitions.to_string(),
    row.tests.to_string(),
    row.bytes.to_string(),
    data_bytes(row).to_string(),
    row.summary,
  ]

fn grid_of(rows: List<Row>) -> List<List<String>> =
  rows.fold([headers()], |acc: List<List<String>>, row: Row| acc.push(cells_of(row)))

/// Every column but the last is padded to its width and followed by two spaces.
fn table(rows: List<Row>) -> List<String> = text::table(grid_of(rows))

fn total(rows: List<Row>) -> Int = rows.fold(0, |acc: Int, row: Row| acc + row.definitions)

/// Every line without the indent, so the shape is testable without a terminal.
pub fn listing(rows: List<Row>, digest: String) -> List<String> / {abort.raise} = {
  let head = [
    count_of(rows.len(), "module") ++ " · " ++ count_of(total(rows), "definition")
      ++ " · shipped with this compiler",
    "",
  ];
  let body = if rows.len() == 0 { ["this build ships no stdlib module"] } else { table(rows) };
  head.concat(body).concat(embedded(rows)).concat([
    "",
    "`import std.<name>` to use one; `ply doc std.<name>` documents it and `ply std --show <name>` prints its source, or a data file by its name",
    "",
    "digest: " ++ digest,
  ])
}

/// A line for each data file a module embeds, under a blank one; nothing where none embeds any.
fn embedded(rows: List<Row>) -> List<String> / {abort.raise} = {
  let lines = rows.fold([], |acc: List<String>, row: Row|
    row.data.fold(acc, |a: List<String>, held: Held|
      a.push(
        held.name ++ " · " ++ count_of(held.bytes, "byte") ++ " · embedded by " ++ row.name,
      )));
  if lines.len() == 0 { [] } else { [""].concat(lines) }
}

// --- The documents ----------------------------------------------------------------

fn row_json(row: Row) -> Json =
  object([
    { key: "module", value: Str(row.name) },
    { key: "definitions", value: Number(Decimal::of_int(row.definitions)) },
    { key: "tests", value: Number(Decimal::of_int(row.tests)) },
    { key: "bytes", value: Number(Decimal::of_int(row.bytes)) },
    {
      key: "data",
      value: Array(
        row.data.map(|held: Held|
          object([
            { key: "name", value: Str(held.name) },
            { key: "bytes", value: Number(Decimal::of_int(held.bytes)) },
          ])),
      ),
    },
    { key: "summary", value: Str(row.summary) },
  ])

fn listing_json(rows: List<Row>, digest: String) -> Json =
  object([
    { key: "command", value: Str("std") },
    { key: "schema_version", value: Number(Decimal::of_int(schema_version())) },
    { key: "ok", value: Bool(true) },
    { key: "exit_code", value: Number(Decimal::of_int(ok_code())) },
    { key: "modules", value: Array(rows.map(row_json)) },
    { key: "definitions", value: Number(Decimal::of_int(total(rows))) },
    { key: "digest", value: Str(digest) },
    { key: "diagnostics", value: Array([]) },
  ])

fn listed(rows: List<Row>, digest: String) -> Answer / {abort.raise} =
  {
    json: listing_json(rows, digest),
    lines: [""].concat(indented(listing(rows, digest))),
    errs: [],
    code: ok_code(),
  }

fn digested(digest: String) -> Answer =
  {
    json: object([
      { key: "command", value: Str("std") },
      { key: "schema_version", value: Number(Decimal::of_int(schema_version())) },
      { key: "ok", value: Bool(true) },
      { key: "exit_code", value: Number(Decimal::of_int(ok_code())) },
      { key: "digest", value: Str(digest) },
    ]),
    lines: [digest],
    errs: [],
    code: ok_code(),
  }

/// What `--show` prints of one thing the shipped modules hold: a module's source under `module`,
/// or a data file's bytes as text under `data`.
fn sourced(kind: String, name: String, text: Bytes) -> Answer = {
  let source = String::of_bytes_lossy(text);
  {
    json: object([
      { key: "command", value: Str("std") },
      { key: "schema_version", value: Number(Decimal::of_int(schema_version())) },
      { key: "ok", value: Bool(true) },
      { key: "exit_code", value: Number(Decimal::of_int(ok_code())) },
      { key: kind, value: Str(name) },
      { key: "source", value: Str(source) },
    ]),
    lines: source_lines(source),
    errs: [],
    code: ok_code(),
  }
}

/// `--show` written bare: every shipped source, in name order, back to back. One run of
/// the program answers every shipped module, which is what lets a check compare it in one spawn.
fn every_source(srcs: List<Source>) -> Answer = {
  let text = String::of_bytes_lossy(Bytes::concat_all(srcs.map(|src: Source| src.src)));
  {
    json: object([
      { key: "command", value: Str("std") },
      { key: "schema_version", value: Number(Decimal::of_int(schema_version())) },
      { key: "ok", value: Bool(true) },
      { key: "exit_code", value: Number(Decimal::of_int(ok_code())) },
      {
        key: "sources",
        value: Array(
          srcs.map(|src: Source|
            object([
              { key: "module", value: Str(String::of_bytes_lossy(src.name)) },
              { key: "source", value: Str(String::of_bytes_lossy(src.src)) },
            ])),
        ),
      },
      { key: "diagnostics", value: Array([]) },
    ]),
    lines: source_lines(text),
    errs: [],
    code: ok_code(),
  }
}

fn stopped(style: Style, diag: Diag) -> Answer / {abort.raise} =
  {
    json: object([
      { key: "command", value: Str("std") },
      { key: "schema_version", value: Number(Decimal::of_int(schema_version())) },
      { key: "ok", value: Bool(false) },
      { key: "exit_code", value: Number(Decimal::of_int(compile_error())) },
      { key: "diagnostics", value: all_to_json([diag], []) },
    ]),
    lines: [],
    errs: all_to_text(style, [diag], []),
    code: compile_error(),
  }

// --- What a run answers -------------------------------------------------------------

/// `data` names the data files the modules embed, which `--show` prints by name as it does a module.
pub fn unknown_module(query: String, names: List<String>, data: List<String>) -> Diag = {
  let ticked = |held: List<String>| String::join(held.map(|n: String| "`" ++ n ++ "`"), ", ");
  let also = if data.len() == 0 { [] }
  else { [Bytes::of_string("and the data files its modules embed: " ++ ticked(data))] };
  error_at(
    b"E0106",
    no_module(),
    dummy_span(),
    Bytes::of_string("no module named `" ++ query ++ "` ships with this compiler"),
    b"not found",
    [Bytes::of_string("the stdlib holds: " ++ ticked(names))].concat(also).concat([
      b"`ply std` lists them with the digest this binary was built from",
    ]),
  )
}

fn shown(
  style: Style,
  query: String,
  srcs: List<Source>,
  data: List<ShippedData>,
) -> Answer / {abort.raise} =
  match srcs.filter(|src: Source| String::of_bytes_lossy(src.name) == query) {
    [src, ..] -> sourced("module", query, src.src),
    [] -> match data.filter(|d: ShippedData| String::of_bytes_lossy(d.name) == query) {
      [d, ..] -> sourced("data", query, d.bytes),
      [] ->
        stopped(
          style,
          unknown_module(
            query,
            srcs.map(|src: Source| String::of_bytes_lossy(src.name)),
            data.map(|held: ShippedData| String::of_bytes_lossy(held.name)),
          ),
        ),
    },
  }

fn counted(srcs: List<Source>, data: List<ShippedData>) -> Answer / {abort.raise} =
  listed(rows_of(srcs, data), shipped_digest_of(srcs, data))

/// The definition this `ply`'s answers of the shipped modules are a function of besides the modules:
/// the one that answers them, whose hash covers each query, how a record is kept and how the store
/// they are written into is laid out.
fn answering_roots() -> List<Bytes> = [b"stdlib.answers"]

/// `--answering`: what names how this `ply` answers the shipped modules, on one line and nothing
/// else. Two that print the same answer the same shipped modules alike, so `ply bootstrap` keeps
/// what one answered under it and the other takes that.
pub fn answering() -> Answer / {shipped.definitions, abort.raise} = {
  let identity = String::of_bytes_lossy(identity_of(shipped.definitions(), answering_roots()));
  {
    json: object([
      { key: "command", value: Str("std") },
      { key: "schema_version", value: Number(Decimal::of_int(schema_version())) },
      { key: "ok", value: Bool(true) },
      { key: "exit_code", value: Number(Decimal::of_int(ok_code())) },
      { key: "answering", value: Str(identity) },
    ]),
    lines: [identity],
    errs: [],
    code: ok_code(),
  }
}

/// `--answers DIR`: every shipped module answered, through the store `work` names beside the stage of
/// reused answers, into the memo store at `dir`, an absolute path, which then holds what they
/// answer.
pub fn answers(
  dir: String,
  reused: String,
) -> Answer / {fs.list_dir[shipped], fs.read_file[shipped], fs.read[abs], fs.write[abs], abort.raise} = {
  let names = shipped_modules().map(|s: Source| s.name);
  let work = below_root(queried::shipped_work(reused));
  if fs.create_dir[abs](work) {
    fs.write_file[abs](work ++ "/.used", b"");
    ()
  };
  let records = queried::shipped_answers[abs, abs](work, below_root(dir), names);
  {
    json: object([
      { key: "schema_version", value: Number(Decimal::of_int(schema_version())) },
      { key: "modules", value: Number(Decimal::of_int(names.len())) },
      { key: "records", value: Number(Decimal::of_int(records)) },
    ]),
    lines: [
      indent() ++ "answered " ++ count_of(names.len(), "shipped module") ++ " into "
        ++ count_of(records, "record")
        ++ " at "
        ++ dir,
    ],
    errs: [],
    code: ok_code(),
  }
}

pub fn run(flags: Flags) -> Answer / {fs.list_dir[shipped], fs.read_file[shipped], abort.raise} = {
  let s = style_of(flags);
  let srcs = shipped();
  if flags.query == "*" && !flags.digest { every_source(srcs) } else {
    let data = shipped_data(srcs);
    if flags.digest { digested(shipped_digest_of(srcs, data)) }
    else if flags.query != "" { shown(s, flags.query, srcs, data) }
    else { counted(srcs, data) }
  }
}

// --- Tests ------------------------------------------------------------------

fn two_rows() -> List<Row> =
  [
    {
      name: "std.bytes",
      definitions: 12,
      tests: 4,
      bytes: 3100,
      data: [],
      summary: "Integers in bytes.",
    },
    {
      name: "std.json",
      definitions: 130,
      tests: 40,
      bytes: 29000,
      data: [{ name: "std/json/escapes.txt", bytes: 96 }, { name: "std/json/words.txt", bytes: 4 }],
      summary: "",
    },
  ]

test "the listing opens on the tally, lays the columns out and ends on the digest" {
  let lines = listing(two_rows(), "b3:1f2e3d4c5b6a");
  assert_eq(
    match lines.at(0) { Some(l) -> l, None -> "" },
    "2 modules · 142 definitions · shipped with this compiler",
  );
  assert_eq(match lines.at(1) { Some(l) -> l, None -> "" }, "");
  assert_eq(
    match lines.at(2) { Some(l) -> l, None -> "" },
    "MODULE     DEFINITIONS  TESTS  BYTES  DATA  SUMMARY",
  );
  assert_eq(
    match lines.at(3) { Some(l) -> l, None -> "" },
    "std.bytes  12           4      3100   0     Integers in bytes.",
  );
  assert_eq(
    match lines.at(4) { Some(l) -> l, None -> "" },
    "std.json   130          40     29000  100",
  );
  assert_eq(match lines.at(lines.len() - 1) { Some(l) -> l, None -> "" }, "digest: b3:1f2e3d4c5b6a")
}

test "the listing names each data file a module embeds, and a build that embeds none names none" {
  assert_eq(embedded(two_rows()), [
    "",
    "std/json/escapes.txt · 96 bytes · embedded by std.json",
    "std/json/words.txt · 4 bytes · embedded by std.json",
  ]);
  assert_eq(embedded([]), [])
}

test "`--show` prints a data file by the name the listing gives it, and a module by its own" {
  let srcs = [{ name: b"std.m", src: b"pub fn list() -> Bytes = embed(\"m/list.txt\")\n" }];
  let data = [{ name: b"std/m/list.txt", bytes: b"one\ntwo\n" }];
  assert_eq(shown(plain(), "std/m/list.txt", srcs, data).lines, ["one", "two"]);
  assert_eq(shown(plain(), "std.m", srcs, data).lines, [
    "pub fn list() -> Bytes = embed(\"m/list.txt\")",
  ]);
  assert_eq(shown(plain(), "std/m/gone.txt", srcs, data).code, 2);
  assert_eq(rows_of(srcs, data).map(|row: Row| row.data), [[{ name: "std/m/list.txt", bytes: 8 }]])
}

test "a build that ships nothing says so instead of laying out an empty table" {
  let lines = listing([], "b3:000000000000");
  assert_eq(
    match lines.at(0) { Some(l) -> l, None -> "" },
    "0 modules · 0 definitions · shipped with this compiler",
  );
  assert_eq(match lines.at(2) { Some(l) -> l, None -> "" }, "this build ships no stdlib module")
}

test "`--digest` is the one line a CI check pins, and nothing else" {
  let answer = digested("b3:1f2e3d4c5b6a");
  assert_eq(answer.lines, ["b3:1f2e3d4c5b6a"]);
  assert_eq(answer.errs, []);
  assert_eq(answer.code, 0)
}

test "`--show` written bare prints every source back to back, in name order" {
  let answer = every_source([
    { name: Bytes::of_string("std.bytes"), src: b"fn a() -> Int = 1\n" },
    { name: Bytes::of_string("std.json"), src: b"fn b() -> Int = 2\n" },
  ]);
  assert_eq(answer.lines, ["fn a() -> Int = 1", "fn b() -> Int = 2"]);
  assert_eq(answer.errs, []);
  assert_eq(answer.code, 0)
}

test "a module that ships with no such name is `E0106` and lists the ones that do" {
  let d = unknown_module("std.nope", ["std.bytes", "std.json"], []);
  assert_eq(d.code, b"E0106");
  assert_eq(d.message, b"no module named `std.nope` ships with this compiler");
  assert_eq(
    match d.notes_text.at(0) { Some(n) -> n, None -> b"" },
    b"the stdlib holds: `std.bytes`, `std.json`",
  );
  assert_eq(d.notes_text.len(), 2);
  assert_eq(
    unknown_module("std/m/gone.txt", ["std.m"], ["std/m/list.txt"]).notes_text.at(1),
    Some(b"and the data files its modules embed: `std/m/list.txt`"),
  )
}

test "a module's source is written back as its own lines" {
  let answer = sourced("module", "std.m", b"pub fn one() -> Int = 1\n");
  assert_eq(answer.lines, ["pub fn one() -> Int = 1"]);
  assert_eq(answer.code, 0)
}
