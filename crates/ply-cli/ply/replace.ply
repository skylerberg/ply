// `ply replace` — one definition rewritten from new text, formatted, with every other byte of its
// file kept and no other definition's name or hash moved. Reading the new text is the host's: it
// is a file the Rust side was pointed at, or this process's own stdin.

import args (Flags, no_flags, style_of)
import diagnostic (Place, all_to_json, all_to_text, errors_of)
import program (Program, load_program, outside)
import report (Answer, schema_version, ok_code, compile_error, refused)
import show (Shown, locate)
import sources (shelf)
import style (Style)
import compiler.front (Whole, Pulled, Refused, Analysed, analyse_pulling_std)
import compiler.fmt (replace_item)
import compiler.hash (HashOutput)
import compiler.resolve (Source, Diag, diag1)
import std.fs (fs)
import std.json (Json, Null, Str, Bool, Number, object)

// The item to put in place of the one named, as the Rust side reads it: `--with FILE`, else
// stdin. It is performed only once a definition to replace has been named, so a run that names
// nothing never waits on a stream.
pub nondet effect edit {
  read item[r]() -> Result<String, String>
}

// --- Refusals -----------------------------------------------------------------

fn backticked(names: List<String>) -> String =
  joined(map(names, |n: String| "`" ++ n ++ "`"), ", ")

fn joined(parts: List<String>, sep: String) -> String =
  fold(range(0, len(parts)), "", |acc: String, i: Int|
    match list_at(parts, i) { Some(x) -> if i == 0 { x } else { acc ++ sep ++ x }, None -> acc })

fn unreadable(why: String) -> Diag =
  diag1(b"E0502", outside(), { start: 0, end: 0 }, bytes_of_string(why),
        b"the replacement could not be read", [])

fn unwritable(path: String) -> Diag =
  diag1(b"E0502", outside(), { start: 0, end: 0 },
        bytes_of_string("could not write `" ++ path ++ "`"), b"the file could not be written", [])

// The replacement is not one item of the same kind and name.
fn not_one_item(shown: Shown, why: String) -> Diag =
  diag1(b"E0128", shown.at.module, shown.at.span, bytes_of_string(why), b"the definition to replace",
        [b"the replacement is one item of the same kind and name"])

// The replacement would leave a different program behind.
fn not_the_same(shown: Shown, message: String) -> Diag =
  diag1(b"E0128", shown.at.module, shown.at.span, bytes_of_string(message),
        b"the definition to replace", [b"nothing was written"])

fn why_of(ds: List<Diag>) -> String =
  joined(map(errors_of(ds), |d: Diag|
           string_of_bytes_lossy(d.message) ++ " [" ++ string_of_bytes_lossy(d.code) ++ "]"), "; ")

// --- The same program ------------------------------------------------------------

fn pairs_map(xs: List<{ name: Bytes, hash: Bytes }>) -> Map<Bytes, Bytes> =
  fold(xs, map_new(), |acc: Map<Bytes, Bytes>, x: { name: Bytes, hash: Bytes }|
    map_insert(acc, x.name, x.hash))

fn names_map(xs: List<{ name: Bytes, hash: Bytes }>, into: Map<Bytes, Bool>) -> Map<Bytes, Bool> =
  fold(xs, into, |acc: Map<Bytes, Bool>, x: { name: Bytes, hash: Bytes }| map_insert(acc, x.name, true))

// Everything the program declares, whether or not a body was hashed for it.
fn declared(h: HashOutput) -> Map<Bytes, Bool> = names_map(h.decls, names_map(h.defs, map_new()))

fn absent_from(these: Map<Bytes, Bool>, those: Map<Bytes, Bool>) -> List<String> =
  map_fold(these, [], |acc: List<String>, key: Bytes, held: Bool|
    match map_get(those, key) { Some(_) -> acc, None -> push(acc, string_of_bytes_lossy(key)) })

fn what_moved(added: List<String>, removed: List<String>) -> String =
  if len(added) == 0 { "removes " ++ backticked(removed) }
  else if len(removed) == 0 { "adds " ++ backticked(added) }
  else { "adds " ++ backticked(added) ++ " and removes " ++ backticked(removed) }

fn holds_name(xs: List<{ name: Bytes, hash: Bytes }>, name: Bytes) -> Bool =
  fold(xs, false, |acc: Bool, x: { name: Bytes, hash: Bytes }| acc || x.name == name)

fn shifted(was: Map<Bytes, Bytes>, now: Map<Bytes, Bytes>, skip: Bytes, into: List<String>) -> List<String> =
  map_fold(was, into, |acc: List<String>, key: Bytes, hash: Bytes|
    if key != skip && map_get(now, key) != Some(hash) { push(acc, string_of_bytes_lossy(key)) } else { acc })

// A `type` or `effect` hashes over what it references, so replacing one may move another's hash;
// nothing references a `fn` by hash, so replacing a `fn` may move no declaration.
pub fn moved_names(before: HashOutput, after: HashOutput, name: Bytes) -> List<String> = {
  let own = shifted(pairs_map(before.own), pairs_map(after.own), name, []);
  if !holds_name(before.defs, name) { own }
  else { shifted(pairs_map(before.decls), pairs_map(after.decls), b"", own) }
}

pub fn compared(before: HashOutput, after: HashOutput, name: String) -> Option<String> = {
  let was = declared(before);
  let now = declared(after);
  let added = absent_from(now, was);
  let removed = absent_from(was, now);
  if len(added) > 0 || len(removed) > 0 {
    Some("the replacement of `" ++ name ++ "` " ++ what_moved(added, removed))
  } else {
    let moved = moved_names(before, after, bytes_of_string(name));
    if len(moved) == 0 { None }
    else { Some("the replacement of `" ++ name ++ "` also changes " ++ backticked(moved)) }
  }
}

// The program with one file's text in place of what the walk read, as the front end takes it.
fn spliced(p: Program, at: Int, text: Bytes) -> List<Source> =
  map(range(0, len(p.files)), |i: Int|
    match list_at(p.files, i) {
      None -> { name: b"", src: b"" },
      Some(f) -> { name: bytes_of_string(f.module), src: if i == at { text } else { f.text } },
    })

fn still_the_same(p: Program, before: HashOutput, shown: Shown, text: Bytes) -> Option<Diag>
  / {fs.list_dir[shelf], fs.read_file[shelf]} = {
  let out: Pulled = analyse_pulling_std(spliced(p, shown.at.module, text), shelf());
  match out.out {
    Refused(ds) ->
      Some(not_the_same(shown, "with `" ++ shown.name ++ "` replaced, the program does not check: "
                               ++ why_of(ds))),
    Analysed(after) ->
      match compared(before, after.hashes, shown.name) {
        None -> None,
        Some(message) -> Some(not_the_same(shown, message)),
      },
  }
}

// --- The answer -------------------------------------------------------------------

fn said(flags: Flags, shown: Option<Shown>, changed: Bool) -> List<String> =
  match shown {
    None -> [],
    Some(x) ->
      if !changed { [x.name ++ " in " ++ x.path ++ " is unchanged"] }
      else if flags.check { ["would replace " ++ x.path] }
      else { ["replaced " ++ x.name ++ " in " ++ x.path] },
  }

fn name_json(shown: Option<Shown>) -> Json = match shown { Some(x) -> Str(x.name), None -> Null }

fn file_json(shown: Option<Shown>) -> Json = match shown { Some(x) -> Str(x.path), None -> Null }

pub fn answered(s: Style, flags: Flags, shown: Option<Shown>, changed: Bool, diags: List<Diag>,
                places: List<Place>) -> Answer = {
  let code = if len(diags) == 0 { ok_code() } else { compile_error() };
  let lines = if len(diags) > 0 { [] } else { said(flags, shown, changed) };
  { json: object([{ key: "command", value: Str("replace") },
                  { key: "schema_version", value: Number(decimal_of_int(schema_version())) },
                  { key: "ok", value: Bool(len(diags) == 0) },
                  { key: "exit_code", value: Number(decimal_of_int(code)) },
                  { key: "name", value: name_json(shown) },
                  { key: "file", value: file_json(shown) },
                  { key: "changed", value: Bool(changed) },
                  { key: "diagnostics", value: all_to_json(diags, places) }]),
    lines: lines,
    errs: all_to_text(s, diags, places),
    code: code }
}

fn stopped(s: Style, flags: Flags, p: Program, shown: Shown, d: Diag) -> Answer =
  answered(s, flags, Some(shown), false, [d], p.places)

fn written(s: Style, flags: Flags, p: Program, shown: Shown, text: Bytes) -> Answer
  / {fs.write_file[cwd]} =
  if flags.check { answered(s, flags, Some(shown), true, [], p.places) }
  else if fs.write_file[cwd](shown.path, text) { answered(s, flags, Some(shown), true, [], p.places) }
  else { stopped(s, flags, p, shown, unwritable(shown.path)) }

fn replaced(s: Style, flags: Flags, p: Program, before: HashOutput, shown: Shown, item: String) -> Answer
  / {fs.list_dir[shelf], fs.read_file[shelf], fs.write_file[cwd]} =
  match replace_item(shown.text, bytes_of_string(shown.simple), bytes_of_string(item)) {
    Err(why) -> stopped(s, flags, p, shown, not_one_item(shown, string_of_bytes_lossy(why))),
    Ok(text) ->
      if text == shown.text { answered(s, flags, Some(shown), false, [], p.places) }
      else {
        match still_the_same(p, before, shown, text) {
          Some(d) -> stopped(s, flags, p, shown, d),
          None -> written(s, flags, p, shown, text),
        }
      },
  }

fn rewritten(s: Style, flags: Flags, p: Program, w: Whole, shown: Shown) -> Answer
  / {fs.list_dir[shelf], fs.read_file[shelf], fs.write_file[cwd], edit.item[replace]} =
  if shown.at.module >= len(p.files) {
    stopped(s, flags, p, shown,
            not_the_same(shown, "`" ++ shown.name
                                ++ "` ships with the compiler, and no file of this program holds it"))
  } else {
    match edit.item[replace]() {
      Err(why) -> stopped(s, flags, p, shown, unreadable(why)),
      Ok(item) -> replaced(s, flags, p, w.hashes, shown, item),
    }
  }

pub fn run(flags: Flags) -> Answer
  / {fs.kind[cwd], fs.list_dir[cwd], fs.read_file[cwd], fs.write_file[cwd],
     fs.list_dir[shelf], fs.read_file[shelf], edit.item[replace]} = {
  let loaded: Program = load_program(flags.paths);
  let s = style_of(flags);
  match loaded.whole {
    None -> refused(s, "replace", loaded.diags, loaded.places),
    Some(w) ->
      match locate(loaded, w, flags.query) {
        Err(d) -> answered(s, flags, None, false, [d], loaded.places),
        Ok(shown) -> rewritten(s, flags, loaded, w, shown),
      },
  }
}

// --- Tests ------------------------------------------------------------------

fn hashes_of(defs: List<{ name: Bytes, hash: Bytes }>, own: List<{ name: Bytes, hash: Bytes }>,
             decls: List<{ name: Bytes, hash: Bytes }>) -> HashOutput =
  { defs: defs, own: own, decls: decls, tests: [], laws: [], specs: [], spec_texts: [],
    law_texts: [], deps: [], closure: [], bodies: [], test_bodies: [] }

fn one_fn(two: Bytes) -> HashOutput =
  hashes_of([{ name: b"m.one", hash: b"aa" }, { name: b"m.two", hash: two }],
            [{ name: b"m.one", hash: b"aa" }, { name: b"m.two", hash: two }], [])

fn a_shown() -> Shown =
  { name: "m.two", simple: "two", at: { module: 0, span: { start: 0, end: 10 } }, path: "m.ply",
    text: b"fn two() -> Int = 2\n", start: 0, end: 20 }

fn flags_of(check: Bool) -> Flags = {..no_flags(), check: check}

test "a replacement that moves only the definition named leaves the same program behind" {
  assert_eq(compared(one_fn(b"bb"), one_fn(b"cc"), "m.two"), None)
}

test "a replacement that moves another definition's hash names it" {
  let after = hashes_of([{ name: b"m.one", hash: b"zz" }, { name: b"m.two", hash: b"cc" }],
                        [{ name: b"m.one", hash: b"zz" }, { name: b"m.two", hash: b"cc" }], []);
  assert_eq(compared(one_fn(b"bb"), after, "m.two"),
            Some("the replacement of `m.two` also changes `m.one`"))
}

test "a replacement that renames a definition says what it added and what it took away" {
  let renamed = hashes_of([{ name: b"m.one", hash: b"aa" }, { name: b"m.twice", hash: b"bb" }],
                          [{ name: b"m.one", hash: b"aa" }, { name: b"m.twice", hash: b"bb" }], []);
  assert_eq(compared(one_fn(b"bb"), renamed, "m.two"),
            Some("the replacement of `m.two` adds `m.twice` and removes `m.two`"))
}

test "replacing a `fn` may move no declaration's hash, and replacing a declaration may" {
  let as_fn = hashes_of([{ name: b"m.two", hash: b"bb" }], [], [{ name: b"m.Shape", hash: b"dd" }]);
  let after = hashes_of([{ name: b"m.two", hash: b"cc" }], [], [{ name: b"m.Shape", hash: b"ee" }]);
  assert_eq(moved_names(as_fn, after, b"m.two"), ["m.Shape"]);
  let as_type = hashes_of([], [], [{ name: b"m.Shape", hash: b"dd" }]);
  let moved = hashes_of([], [], [{ name: b"m.Shape", hash: b"ee" }]);
  assert_eq(moved_names(as_type, moved, b"m.Shape"), [])
}

test "the line a run writes says what it did, and a run that located nothing writes none" {
  assert_eq(said(flags_of(false), Some(a_shown()), false), ["m.two in m.ply is unchanged"]);
  assert_eq(said(flags_of(false), Some(a_shown()), true), ["replaced m.two in m.ply"]);
  assert_eq(said(flags_of(true), Some(a_shown()), true), ["would replace m.ply"]);
  assert_eq(said(flags_of(false), None, false), [])
}

test "a refusal exits 2, writes no line, and renders the diagnostic to the error stream" {
  let answer = answered({ styled: false }, flags_of(false), Some(a_shown()), false,
                        [not_the_same(a_shown(), "the replacement of `m.two` adds `m.twice`")], []);
  assert_eq(answer.code, 2);
  assert_eq(answer.lines, []);
  assert_eq(match list_at(answer.errs, 0) { Some(l) -> l, None -> "" },
            "Error[E0128]: the replacement of `m.two` adds `m.twice`")
}
