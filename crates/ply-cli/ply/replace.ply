//! `ply replace` — one definition rewritten from new text, formatted, with every other byte of its
//! file kept and no other definition's name or hash moved. The new text is a file the line names,
//! or this process's own standard input.

import std.random (entropy)
import std.time (time)
import std.process (process)
import builder (builder)
import args (Flags, no_flags, style_of)
import paths
import paths (Rooted, displayed, write_file)
import diagnostic (all_to_json, all_to_text, errors_of, errors_text)
import program (Program, load_program, reanalysed)
import compiler.load (tell_viewed)
import compiler.unit (shipped)
import report (Answer, schema_version, ok_code, compile_error, refused)
import show (Shown, locate)
import sources (File)
import style (Style)
import compiler.front (Analysis, Pulled, Refused, Analysed)
import compiler.fmt (replace_item)
import compiler.hash (HashOutput, no_hashes, by_name)
import compiler.resolve (Source, Diag, error_at)
import std.fs (fs)
import std.json (Json, Null, Str, Bool, Number, object)
import std.string (join)
import compiler.parsing (no_module)

/// The item to put in place of the one named: `--with FILE`, else standard input. It is performed
/// only once a definition to replace has been named, so a run that names nothing never waits on a
/// stream.
pub nondet effect edit {
  read item[r](replacement: Option<String>) -> Result<String, String>
}

/// `body` with the item it asks for read here.
pub fn reading<a | e>(
  body: () -> a / {edit.item[replace] | e},
) -> a / {diverges, fs.read_file[cwd], fs.read_file[abs], process.line[proc], abort.raise | e} =
  handle { body() } with { edit.item[replace](named) -> item(named) }

fn item(
  named: Option<String>,
) -> Result<String, String> / {fs.read_file[cwd], fs.read_file[abs], process.line[proc], abort.raise, diverges} =
  match named {
    None -> Ok(input("")),
    Some(file) -> match paths::read_file(paths::spelled(file)) {
      None -> Err("could not read `" ++ file ++ "`"),
      Some(text) -> if bytes_is_utf8(text) { Ok(string_of_bytes(text)) }
      else { Err("could not read `" ++ file ++ "`: it is not UTF-8") },
    },
  }

/// Every line of standard input, each ended as a file ends its lines.
fn input(read: String) -> String / {process.line[proc], diverges} =
  match process.line[proc]() { Some(line) -> input(read ++ line ++ "\n"), None -> read }

// --- Refusals -----------------------------------------------------------------

fn backticked(names: List<String>) -> String = join(map(names, |n: String| "`" ++ n ++ "`"), ", ")

fn unreadable(why: String) -> Diag =
  error_at(
    b"E0502",
    no_module(),
    { start: 0, end: 0 },
    bytes_of_string(why),
    b"the replacement could not be read",
    [],
  )

fn unwritable(path: String) -> Diag =
  error_at(
    b"E0502",
    no_module(),
    { start: 0, end: 0 },
    bytes_of_string("could not write `" ++ path ++ "`"),
    b"the file could not be written",
    [],
  )

/// The replacement is not one item of the same kind and name.
fn not_one_item(shown: Shown, why: String) -> Diag =
  error_at(
    b"E0128",
    shown.at.module,
    shown.at.span,
    bytes_of_string(why),
    b"the definition to replace",
    [b"the replacement is one item of the same kind and name"],
  )

/// The replacement would leave a different program behind.
fn not_the_same(shown: Shown, message: String) -> Diag =
  error_at(
    b"E0128",
    shown.at.module,
    shown.at.span,
    bytes_of_string(message),
    b"the definition to replace",
    [b"nothing was written"],
  )

// --- The same program ------------------------------------------------------------

fn names_map(xs: List<{ name: Bytes, hash: Bytes }>, into: Map<Bytes, Bool>) -> Map<Bytes, Bool> =
  fold(xs, into, |acc: Map<Bytes, Bool>, x: { name: Bytes, hash: Bytes }|
    map_insert(acc, x.name, true))

/// Everything the program declares, whether or not a body was hashed for it.
fn declared(h: HashOutput) -> Map<Bytes, Bool> = names_map(h.decls, names_map(h.defs, map_new()))

fn absent_from(these: Map<Bytes, Bool>, those: Map<Bytes, Bool>) -> List<String> =
  map_fold(these, [], |acc: List<String>, key: Bytes, held: Bool|
    match map_get(those, key) { Some(_) -> acc, None -> push(acc, string_of_bytes_lossy(key)) })

fn what_moved(added: List<String>, removed: List<String>) -> String =
  if len(added) == 0 { "removes " ++ backticked(removed) }
  else if len(removed) == 0 { "adds " ++ backticked(added) }
  else { "adds " ++ backticked(added) ++ " and removes " ++ backticked(removed) }

fn holds_name(xs: List<{ name: Bytes, hash: Bytes }>, name: Bytes) -> Bool =
  fold(xs, false, |acc: Bool, x: { name: Bytes, hash: Bytes }| acc || x.name == name)

fn shifted(
  was: Map<Bytes, Bytes>,
  now: Map<Bytes, Bytes>,
  skip: Bytes,
  into: List<String>,
) -> List<String> =
  map_fold(was, into, |acc: List<String>, key: Bytes, hash: Bytes|
    if key != skip && map_get(now, key) != Some(hash) { push(acc, string_of_bytes_lossy(key)) }
    else { acc })

/// A `type` or `effect` hashes over what it references, so replacing one may move another's hash;
/// nothing references a `fn` by hash, so replacing a `fn` may move no declaration.
pub fn moved_names(before: HashOutput, after: HashOutput, name: Bytes) -> List<String> = {
  let own = shifted(by_name(before.own), by_name(after.own), name, []);
  if !holds_name(before.defs, name) { own }
  else { shifted(by_name(before.decls), by_name(after.decls), b"", own) }
}

pub fn compared(before: HashOutput, after: HashOutput, name: String) -> Option<String> = {
  let was = declared(before);
  let now = declared(after);
  let added = absent_from(now, was);
  let removed = absent_from(was, now);
  if len(added) > 0 || len(removed) > 0 {
    Some("the replacement of `" ++ name ++ "` " ++ what_moved(added, removed))
  } else {
    let moved = moved_names(before, after, bytes_of_string(name));
    if len(moved) == 0 { None }
    else { Some("the replacement of `" ++ name ++ "` also changes " ++ backticked(moved)) }
  }
}

/// The program with one file's text in place of what the walk read, as the front end takes it.
fn spliced(program: Program, at: Int, text: Bytes) -> List<Source> =
  map(range(0, len(program.files)), |i: Int|
    match list_at(program.files, i) {
      None -> { name: b"", src: b"" },
      Some(f) -> { name: bytes_of_string(f.module), src: if i == at { text } else { f.text } },
    })

fn still_the_same(
  program: Program,
  analysis: Analysis,
  shown: Shown,
  text: Bytes,
) -> Option<Diag> / {builder.git[vcs], fs.list_dir[shipped], fs.read_file[shipped], abort.raise, shipped.reached} = {
  let before: HashOutput = analysis.hashes;
  let out: Pulled = reanalysed(
    program,
    analysis,
    spliced(program, shown.at.module, text),
    program.pkgs,
  );
  tell_viewed(out.viewed, false);
  match out.out {
    Refused(ds) ->
      Some(
        not_the_same(
          shown,
          "with `" ++ shown.name ++ "` replaced, the program does not check: " ++ errors_text(ds),
        ),
      ),
    Analysed(after) -> match compared(before, after.hashes, shown.name) {
      None -> None,
      Some(message) -> Some(not_the_same(shown, message)),
    },
  }
}

// --- The answer -------------------------------------------------------------------

/// The file of this program that holds the definition, as the load read it; none for a shipped one.
fn file_of(program: Program, shown: Shown) -> Option<File> = list_at(program.files, shown.at.module)

fn said(p: Program, flags: Flags, shown: Option<Shown>, changed: Bool) -> List<String> =
  match shown {
    None -> [],
    Some(x) -> {
      let path = match file_of(p, x) { Some(f) -> displayed(f.at), None -> x.path };
      if !changed { [x.name ++ " in " ++ path ++ " is unchanged"] }
      else if flags.check { ["would replace " ++ path] }
      else { ["replaced " ++ x.name ++ " in " ++ path] }
    },
  }

fn name_json(shown: Option<Shown>) -> Json = match shown { Some(x) -> Str(x.name), None -> Null }

fn file_json(shown: Option<Shown>) -> Json = match shown { Some(x) -> Str(x.path), None -> Null }

pub fn answered(
  style: Style,
  flags: Flags,
  program: Program,
  shown: Option<Shown>,
  changed: Bool,
  diags: List<Diag>,
) -> Answer / {abort.raise} = {
  let code = if len(diags) == 0 { ok_code() } else { compile_error() };
  let lines = if len(diags) > 0 { [] } else { said(program, flags, shown, changed) };
  {
    json: object([
      { key: "command", value: Str("replace") },
      { key: "schema_version", value: Number(decimal_of_int(schema_version())) },
      { key: "ok", value: Bool(len(diags) == 0) },
      { key: "exit_code", value: Number(decimal_of_int(code)) },
      { key: "name", value: name_json(shown) },
      { key: "file", value: file_json(shown) },
      { key: "changed", value: Bool(changed) },
      { key: "diagnostics", value: all_to_json(diags, program.places) },
    ]),
    lines: lines,
    errs: all_to_text(style, diags, program.places),
    code: code,
  }
}

fn stopped(
  style: Style,
  flags: Flags,
  program: Program,
  shown: Shown,
  diag: Diag,
) -> Answer / {abort.raise} = answered(style, flags, program, Some(shown), false, [diag])

fn written(
  style: Style,
  flags: Flags,
  program: Program,
  shown: Shown,
  file: File,
  text: Bytes,
) -> Answer / {fs.write_file[cwd], fs.write_file[abs], abort.raise} =
  if flags.check { answered(style, flags, program, Some(shown), true, []) }
  else if write_file(file.at, text) { answered(style, flags, program, Some(shown), true, []) }
  else { stopped(style, flags, program, shown, unwritable(displayed(file.at))) }

fn replaced(
  style: Style,
  flags: Flags,
  program: Program,
  analysis: Analysis,
  shown: Shown,
  file: File,
  item: String,
) -> Answer / {builder.git[vcs], fs.list_dir[shipped], fs.read_file[shipped], fs.write_file[cwd], fs.write_file[abs], abort.raise, shipped.reached} =
  match replace_item(shown.text, bytes_of_string(shown.simple), bytes_of_string(item)) {
    Err(why) ->
      stopped(style, flags, program, shown, not_one_item(shown, string_of_bytes_lossy(why))),
    Ok(text) -> if text == shown.text { answered(style, flags, program, Some(shown), false, []) }
    else {
      match still_the_same(program, analysis, shown, text) {
        Some(d) -> stopped(style, flags, program, shown, d),
        None -> written(style, flags, program, shown, file, text),
      }
    },
  }

fn rewritten(
  style: Style,
  flags: Flags,
  program: Program,
  analysis: Analysis,
  shown: Shown,
) -> Answer / {builder.git[vcs], fs.list_dir[shipped], fs.read_file[shipped], fs.write_file[cwd], fs.write_file[abs], edit.item[replace], abort.raise, shipped.reached} =
  match file_of(program, shown) {
    None ->
      stopped(
        style,
        flags,
        program,
        shown,
        not_the_same(
          shown,
          "`" ++ shown.name ++ "` ships with the compiler, and no file of this program holds it",
        ),
      ),
    Some(file) -> match edit.item[replace](flags.out) {
      Err(why) -> stopped(style, flags, program, shown, unreadable(why)),
      Ok(item) -> replaced(style, flags, program, analysis, shown, file, item),
    },
  }

pub fn run(
  flags: Flags,
) -> Answer / {builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.write_file[cwd], fs.write_file[abs], fs.list_dir[shipped], fs.read_file[shipped], edit.item[replace], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, abort.raise, diverges, shipped.reached} = {
  let loaded: Program = load_program(flags.paths);
  let s = style_of(flags);
  match loaded.whole {
    None -> refused(s, "replace", loaded.diags, loaded.places),
    Some(w) -> match locate(loaded, w, flags.query) {
      Err(d) -> answered(s, flags, loaded, None, false, [d]),
      Ok(shown) -> rewritten(s, flags, loaded, w, shown),
    },
  }
}

// --- Tests ------------------------------------------------------------------

fn hashes_of(
  defs: List<{ name: Bytes, hash: Bytes }>,
  own: List<{ name: Bytes, hash: Bytes }>,
  decls: List<{ name: Bytes, hash: Bytes }>,
) -> HashOutput = { ..no_hashes(), defs: defs, own: own, decls: decls }

fn one_fn(two: Bytes) -> HashOutput =
  hashes_of(
    [{ name: b"m.one", hash: b"aa" }, { name: b"m.two", hash: two }],
    [{ name: b"m.one", hash: b"aa" }, { name: b"m.two", hash: two }],
    [],
  )

fn a_shown() -> Shown =
  {
    name: "m.two",
    simple: "two",
    at: { module: 0, span: { start: 0, end: 10 } },
    path: "m.ply",
    text: b"fn two() -> Int = 2\n",
    start: 0,
    end: 20,
  }

fn flags_of(check: Bool) -> Flags = { ..no_flags(), check: check }

/// The file `a_shown` is in, as the load read it from `rooted`.
fn a_file(rooted: Rooted) -> File = { path: "m.ply", module: "m", text: a_shown().text, at: rooted }

fn a_program(rooted: Rooted) -> Program =
  {
    files: [a_file(rooted)],
    places: [],
    diags: [],
    cache_warnings: [],
    whole: None,
    pkgs: { root: b"", manifest: None, supplied: [] },
    through: [],
    embeds: [],
    shipping: { read: [], unread: [], data: [] },
    reached: true,
    viewed: [],
  }

test "a replacement that moves only the definition named leaves the same program behind" {
  assert_eq(compared(one_fn(b"bb"), one_fn(b"cc"), "m.two"), None)
}

test "a replacement that moves another definition's hash names it" {
  let after = hashes_of(
    [{ name: b"m.one", hash: b"zz" }, { name: b"m.two", hash: b"cc" }],
    [{ name: b"m.one", hash: b"zz" }, { name: b"m.two", hash: b"cc" }],
    [],
  );
  assert_eq(
    compared(one_fn(b"bb"), after, "m.two"),
    Some("the replacement of `m.two` also changes `m.one`"),
  )
}

test "a replacement that renames a definition says what it added and what it took away" {
  let renamed = hashes_of(
    [{ name: b"m.one", hash: b"aa" }, { name: b"m.twice", hash: b"bb" }],
    [{ name: b"m.one", hash: b"aa" }, { name: b"m.twice", hash: b"bb" }],
    [],
  );
  assert_eq(
    compared(one_fn(b"bb"), renamed, "m.two"),
    Some("the replacement of `m.two` adds `m.twice` and removes `m.two`"),
  )
}

test "replacing a `fn` may move no declaration's hash, and replacing a declaration may" {
  let as_fn = hashes_of([{ name: b"m.two", hash: b"bb" }], [], [{ name: b"m.Shape", hash: b"dd" }]);
  let after = hashes_of([{ name: b"m.two", hash: b"cc" }], [], [{ name: b"m.Shape", hash: b"ee" }]);
  assert_eq(moved_names(as_fn, after, b"m.two"), ["m.Shape"]);
  let as_type = hashes_of([], [], [{ name: b"m.Shape", hash: b"dd" }]);
  let moved = hashes_of([], [], [{ name: b"m.Shape", hash: b"ee" }]);
  assert_eq(moved_names(as_type, moved, b"m.Shape"), [])
}

test "the line a run writes says what it did, and a run that located nothing writes none" {
  let p = a_program({ label: "cwd", path: "m.ply" });
  assert_eq(said(p, flags_of(false), Some(a_shown()), false), ["m.two in m.ply is unchanged"]);
  assert_eq(said(p, flags_of(false), Some(a_shown()), true), ["replaced m.two in m.ply"]);
  assert_eq(said(p, flags_of(true), Some(a_shown()), true), ["would replace m.ply"]);
  assert_eq(said(p, flags_of(false), None, false), [])
}

test "the file a run names is the one the load read, wherever its root is" {
  let under = a_program({ label: "cwd", path: "app/m.ply" });
  assert_eq(said(under, flags_of(false), Some(a_shown()), true), ["replaced m.two in app/m.ply"]);
  let outside_it = a_program({ label: "abs", path: "srv/app/m.ply" });
  assert_eq(said(outside_it, flags_of(true), Some(a_shown()), true), [
    "would replace /srv/app/m.ply",
  ])
}

test "a replacement is written back where the load read the file, through its own root" {
  let at: Rooted = { label: "abs", path: "srv/app/m.ply" };
  let answer = handle {
    written(
      { styled: false },
      flags_of(false),
      a_program(at),
      a_shown(),
      a_file(at),
      b"fn two() -> Int = 1 + 1\n",
    )
  } with {
    fs.write_file[cwd](path, body) -> panic("a file read under `abs` is written under `abs`"),
    fs.write_file[abs](path, body) -> path == "srv/app/m.ply",
  };
  assert_eq(answer.code, 0);
  assert_eq(answer.lines, ["replaced m.two in /srv/app/m.ply"])
}

test "a refusal exits 2, writes no line, and renders the diagnostic to the error stream" {
  let answer = answered(
    { styled: false },
    flags_of(false),
    a_program({ label: "cwd", path: "m.ply" }),
    Some(a_shown()),
    false,
    [not_the_same(a_shown(), "the replacement of `m.two` adds `m.twice`")],
  );
  assert_eq(answer.code, 2);
  assert_eq(answer.lines, []);
  assert_eq(
    match list_at(answer.errs, 0) { Some(l) -> l, None -> "" },
    "Error[E0128]: the replacement of `m.two` adds `m.twice`",
  )
}
