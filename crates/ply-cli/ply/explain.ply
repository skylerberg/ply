    meaning_of("W0612", "run abandoned at its wall clock; nothing recorded"),
  ]

pub fn severity_of(code: String) -> String =
  if string_starts_with(code, "W") { "warning" } else { "error" }

pub fn find(code: String) -> Option<Meaning> =
  fold(meanings(), None, |acc: Option<Meaning>, row: Meaning|
    match acc { Some(_) -> acc, None -> if row.code == code { Some(row) } else { None } })

fn row_json(row: Meaning) -> Json =
  object([
    { key: "code", value: Str(row.code) },
    { key: "severity", value: Str(severity_of(row.code)) },
    { key: "meaning", value: Str(row.meaning) },
  ])

fn head(ok: Bool, code: Int) -> List<{ key: String, value: Json }> =
  [
    { key: "command", value: Str("explain") },
    { key: "schema_version", value: Number(decimal_of_int(schema_version())) },
    { key: "ok", value: Bool(ok) },
    { key: "exit_code", value: Number(decimal_of_int(code)) },
  ]

fn listing(style: Style) -> Answer / {abort.raise} =
  {
    json: object(
      push(head(true, ok_code()), { key: "codes", value: Array(map(meanings(), row_json)) }),
    ),
    lines: map(meanings(), |row: Meaning| bold(style, row.code) ++ " " ++ row.meaning),
    errs: [],
    code: ok_code(),
  }

fn one(style: Style, row: Meaning) -> Answer / {abort.raise} =
  {
    json: object(
      push(
        push(push(head(true, ok_code()), { key: "code", value: Str(row.code) }), {
          key: "severity",
          value: Str(severity_of(row.code)),
        }),
        { key: "meaning", value: Str(row.meaning) },
      ),
    ),
    lines: [bold(style, row.code) ++ " " ++ row.meaning],
    errs: [],
    code: ok_code(),
  }

fn unknown(style: Style, code: String) -> Answer / {abort.raise} = {
  let message = "`" ++ code
    ++ "` is not a code this compiler raises; `ply explain --all` lists them";
  {
    json: object(
      push(push(head(false, compile_error()), { key: "code", value: Str(code) }), {
        key: "error",
        value: Str(message),
      }),
    ),
    lines: [],
    errs: [red(style, "error") ++ ": " ++ message],
    code: compile_error(),
  }
}

pub fn run(flags: Flags) -> Answer / {abort.raise} = {
  let s = style_of(flags);
  if flags.all { listing(s) } else {
    let code = string_upper(flags.query);
    match find(code) { Some(row) -> one(s, row), None -> unknown(s, code) }
  }
}

// --- Tests ------------------------------------------------------------------

test "a code is one line, and its own document under `--json`" {
  let answer = run({ ..no_flags(), query: "e0302" });
  assert_eq(answer.code, 0);
  assert_eq(answer.lines, ["E0302 effect not permitted by the written row"]);
  assert_eq(answer.errs, [])
}

test "a code nothing raises is exit 2 and points at the list" {
  let answer = run({ ..no_flags(), query: "E9999" });
  assert_eq(answer.code, 2);
  assert_eq(answer.lines, []);
  assert_eq(answer.errs, [
    "error: `E9999` is not a code this compiler raises; `ply explain --all` lists them",
  ])
}

test "`--all` lists every row, warnings among them, in the table's order" {
  let answer = run(from_argv("explain", ["--all"]));
  assert_eq(answer.code, 0);
  assert_eq(len(answer.lines), len(meanings()));
  assert_eq(match list_at(answer.lines, 0) { Some(l) -> l, None -> "" }, "E0001 unexpected token");
  assert_eq(severity_of("W0611"), "warning");
  assert_eq(severity_of("E0001"), "error")
}

test "no code is explained twice" {
  let seen = fold(meanings(), map_new(), |acc: Map<String, Bool>, row: Meaning|
    map_insert(acc, row.code, true));
  assert_eq(map_len(seen), len(meanings()))
}
