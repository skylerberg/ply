// `ply explain` — what a diagnostic code means. The table is `ply_span::MEANINGS` row for row, and
// a test in `ply-cli-tests` holds the two to each other; the registry the compiler raises from is
// still the Rust one, so a code added there without a row here fails that test.

import args (Flags, read, style_of)
import report (Answer, schema_version, ok_code, compile_error)
import style (Style, bold, red)
import std.json (Json, Str, Bool, Number, Array, object)

pub type Meaning = { code: String, meaning: String }

fn m(code: String, meaning: String) -> Meaning = { code: code, meaning: meaning }

pub fn meanings() -> List<Meaning> = [
  m("E0001", "unexpected token"),
  m("E0002", "unterminated string or byte-string literal"),
  m("E0101", "unknown name (including no `main` to run)"),
  m("E0102", "unknown type"),
  m("E0103", "unknown effect"),
  m("E0104", "unknown operation"),
  m("E0105", "duplicate definition, or a reserved name"),
  m("E0106", "unknown module"),
  m("E0107", "private name"),
  m("E0108", "ambiguous import"),
  m("E0109", "module cycle"),
  m("E0110", "duplicate import"),
  m("E0111", "file path that cannot name a module"),
  m("E0112", "ambiguous entry point"),
  m("E0113", "project module under the reserved root `std`"),
  m("E0114", "unknown `effect set`, including a `pub` or qualified one"),
  m("E0115", "`effect set` cycle"),
  m("E0116", "record update base with no shape this file can name"),
  m("E0117", "record update naming a field the base lacks"),
  m("E0118", "`?` with no written `Result`/`Option` return type to exit through"),
  m("E0119", "`?` where its early exit would change what runs or drop an annotation"),
  m("E0120", "parameter default on a lambda, operation or handler clause"),
  m("E0121", "parameter default that is not a pure, closed value"),
  m("E0122", "default on a `pub fn` naming something its module does not export"),
  m("E0123", "named argument naming no parameter, or one twice"),
  m("E0124", "positional argument after a named one"),
  m("E0125", "parameter left unfilled by a call that used a name"),
  m("E0126", "top-level `fn` missing a parameter or return type"),
  m("E0127", "`reuse fn` with an append that cannot reuse its list"),
  m("E0128", "`ply replace` refused: the result would not check or would move another definition"),
  m("E0201", "type mismatch"),
  m("E0202", "arity mismatch"),
  m("E0203", "occurs check"),
  m("E0204", "not a function"),
  m("E0205", "non-exhaustive match"),
  m("E0206", "not derivable, including an unordered `Map` key"),
  m("E0207", "unknown deriver"),
  m("E0208", "orphan `derive`"),
  m("E0209", "`/` on `Decimal`"),
  m("E0210", "numeric operand type nothing determines"),
  m("E0211", "integer literal out of range for its fixed width"),
  m("E0301", "unbound row variable"),
  m("E0302", "effect not permitted by the written row"),
  m("E0303", "unhandled effect (compiler defect)"),
  m("E0304", "resource label required"),
  m("E0305", "`handle` with no clause for an operation its body performs on a handled atom"),
  m("E0306", "label instantiation: a call leaves a label unfilled or writes the wrong number of them, or a label-generic definition is used as a value"),
  m("E0307", "mutually recursive definitions binding different label parameters"),
  m("E0412", "nondeterministic effect in a deterministic test"),
  m("E0413", "`Task` escapes its region"),
  m("E0414", "deadlock, or spent step budget"),
  m("E0415", "replay did not reproduce the schedule (Ply's fault)"),
  m("E0416", "nested `simulate`"),
  m("E0417", "effect in a spec, guard or law body"),
  m("E0418", "`forall` binder type that cannot be quantified"),
  m("E0419", "obligation refuted by a counterexample"),
  m("E0420", "vacuous obligation: the guard admits nothing"),
  m("E0421", "host registration for something undeclared"),
  m("E0422", "two host registrations for one atom"),
  m("E0423", "host handler determinism disagrees with the declaration"),
  m("E0424", "operation reached the host boundary with nothing bound"),
  m("E0425", "host operation reached from a test the search re-runs"),
  m("E0426", "continuation resumed twice across an at-most-once host operation"),
  m("E0427", "host handler answered an atom outside the entry point's footprint"),
  m("E0428", "`blocking` host handler answered inline"),
  m("E0429", "`net.listen_tls` named a credential the run lacks"),
  m("E0430", "`--tls` credential that does not load"),
  m("E0431", "no database configured"),
  m("E0432", "statement text the driver refuses"),
  m("E0433", "server refused to prepare a statement"),
  m("E0434", "statement touches a table outside the footprint"),
  m("E0435", "live database differs from the schema (reserved)"),
  m("E0436", "database operation from a task not owning the transaction"),
  m("E0437", "connection pool exhausted"),
  m("E0438", "live schema has an unmodellable trigger, rule or cascade (reserved)"),
  m("E0439", "`Secret` passed to a host operation not allowed one"),
  m("E0440", "configuration source unreadable"),
  m("E0441", "required configuration key missing"),
  m("E0442", "configuration value of the wrong shape"),
  m("E0443", "artifact does not verify"),
  m("E0444", "artifact built under another version"),
  m("E0445", "`trace.exit` of a span not open on this task"),
  m("E0446", "value outlives its region"),
  m("E0447", "two regions in scope under one name"),
  m("E0449", "region handle reaching a runtime boundary"),
  m("E0450", "compiled backend cannot be attached"),
  m("E0451", "`fs` label with no root bound"),
  m("E0452", "path leaves its root"),
  m("E0453", "read over the bound"),
  m("E0454", "`--fs` root that is not a directory"),
  m("E0455", "the program asked to exit with a code"),
  m("E0456", "`process.spawn` label with no executable bound"),
  m("E0457", "`--exec` path that cannot be executed"),
  m("E0458", "captured output over the bound"),
  m("E0501", "assertion failed"),
  m("E0502", "runtime error: `panic`, division by zero, overflow, bad index, spent budget, call limit"),
  m("E0503", "ran past its time budget"),
  m("E0505", "Ply broke one of its own invariants"),
  m("W0601", "cache unreadable"),
  m("W0602", "cache corrupt"),
  m("W0603", "cache from another version"),
  m("W0604", "obligation undecided at every tier"),
  m("W0605", "standard library changed since the cache was written"),
  m("W0606", "host runtime could not release every resource"),
  m("W0607", "supplied configuration key the schema does not declare"),
  m("W0608", "drain deadline expired with requests in flight"),
  m("W0609", "spans still open when an entry point ended"),
  m("W0610", "reference cycle, never freed"),
  m("W0611", "definition no `pub` item, `main`, test or law reaches; a leading `_` in its name keeps it quiet"),
]

pub fn severity_of(code: String) -> String = if string_starts_with(code, "W") { "warning" } else { "error" }

pub fn find(code: String) -> Option<Meaning> =
  fold(meanings(), None, |acc: Option<Meaning>, row: Meaning|
    match acc { Some(_) -> acc, None -> if row.code == code { Some(row) } else { None } })

fn row_json(row: Meaning) -> Json =
  object([{ key: "code", value: Str(row.code) },
          { key: "severity", value: Str(severity_of(row.code)) },
          { key: "meaning", value: Str(row.meaning) }])

fn head(ok: Bool, code: Int) -> List<{ key: String, value: Json }> =
  [{ key: "command", value: Str("explain") },
   { key: "schema_version", value: Number(decimal_of_int(schema_version())) },
   { key: "ok", value: Bool(ok) },
   { key: "exit_code", value: Number(decimal_of_int(code)) }]

fn listing(s: Style) -> Answer =
  { json: object(push(head(true, ok_code()),
                      { key: "codes", value: Array(map(meanings(), row_json)) })),
    lines: map(meanings(), |row: Meaning| bold(s, row.code) ++ " " ++ row.meaning),
    errs: [],
    code: ok_code() }

fn one(s: Style, row: Meaning) -> Answer =
  { json: object(push(push(push(head(true, ok_code()),
                                { key: "code", value: Str(row.code) }),
                           { key: "severity", value: Str(severity_of(row.code)) }),
                      { key: "meaning", value: Str(row.meaning) })),
    lines: [bold(s, row.code) ++ " " ++ row.meaning],
    errs: [],
    code: ok_code() }

fn unknown(s: Style, code: String) -> Answer = {
  let message = "`" ++ code ++ "` is not a code this compiler raises; `ply explain --all` lists them";
  { json: object(push(push(head(false, compile_error()),
                           { key: "code", value: Str(code) }),
                      { key: "error", value: Str(message) })),
    lines: [],
    errs: [red(s, "error") ++ ": " ++ message],
    code: compile_error() }
}

pub fn run(flags: Flags) -> Answer = {
  let s = style_of(flags);
  if flags.all { listing(s) } else {
    let code = string_upper(match list_at(flags.paths, 0) { Some(c) -> c, None -> "" });
    match find(code) { Some(row) -> one(s, row), None -> unknown(s, code) }
  }
}

// --- Tests ------------------------------------------------------------------

test "a code is one line, and its own document under `--json`" {
  let answer = run(read(["e0302"]));
  assert_eq(answer.code, 0);
  assert_eq(answer.lines, ["E0302 effect not permitted by the written row"]);
  assert_eq(answer.errs, [])
}

test "a code nothing raises is exit 2 and points at the list" {
  let answer = run(read(["E9999"]));
  assert_eq(answer.code, 2);
  assert_eq(answer.lines, []);
  assert_eq(answer.errs, ["error: `E9999` is not a code this compiler raises; `ply explain --all` lists them"])
}

test "`--all` lists every row, warnings among them, in the table's order" {
  let answer = run(read(["--all"]));
  assert_eq(answer.code, 0);
  assert_eq(len(answer.lines), len(meanings()));
  assert_eq(match list_at(answer.lines, 0) { Some(l) -> l, None -> "" }, "E0001 unexpected token");
  assert_eq(severity_of("W0611"), "warning");
  assert_eq(severity_of("E0001"), "error")
}

test "no code is explained twice" {
  let seen = fold(meanings(), map_new(), |acc: Map<String, Bool>, row: Meaning| map_insert(acc, row.code, true));
  assert_eq(map_len(seen), len(meanings()))
}
