// `ply fmt`, as a program. The Rust command builds this into an artifact and enters it with the
// command line as `process.args` and the working directory bound as the root `cwd`, so every path
// here is relative to it and one that leaves it is the host's refusal.

import std.process (process, Captured, captured, args_step, out_step, err_step, exit_step)
import std.fs (fs, File, Dir, Symlink, Missing, MemFs, mem_of, mem_read, mem_kind, mem_list, mem_write)
import std.path (join, extension, strip_dot)
import std.json (Str, Bool, Number, Array, object, to_string)
import compiler.fmt (fmt_source)

// --- The command line -------------------------------------------------------

type Flags = { check: Bool, json: Bool, paths: List<String> }

// Every word that is not a flag is a path; `clap` has already refused any other flag.
fn read_flags(args: List<String>) -> Flags =
  fold(args, { check: false, json: false, paths: [] }, |acc: Flags, arg: String|
    if arg == "--check" { {..acc, check: true} }
    else if arg == "--json" { {..acc, json: true} }
    else { {..acc, paths: push(acc.paths, strip_dot(arg))} })

// --- Finding the files ------------------------------------------------------

type Failure = { path: String, why: String }

// A set kept as a map: the paths come back sorted and deduped, so `./m.ply` and `m.ply` are one.
type Found = { files: Map<String, Bool>, errors: List<Failure> }

fn nothing() -> Found = { files: map_new(), errors: [] }

fn keep(found: Found, path: String) -> Found =
  {..found, files: map_insert(found.files, path, true)}

fn refuse(found: Found, path: String, why: String) -> Found =
  {..found, errors: push(found.errors, { path: path, why: why })}

// A hidden directory holds caches and VCS metadata, and `target` holds build output.
fn skipped(name: String) -> Bool = string_starts_with(name, ".") || name == "target"

fn is_ply(name: String) -> Bool = extension(name) == Some("ply")

// A path the command line named: a file is taken whatever it is called, a directory is walked, and
// a symlink is refused rather than followed, since a rewrite through one leaves the root.
fn named(found: Found, path: String) -> Found / {fs.kind[cwd], fs.list_dir[cwd]} =
  match fs.kind[cwd](path) {
    File -> keep(found, path),
    Dir -> walk(found, path),
    Symlink -> refuse(found, path, "a symlink is not formatted"),
    Missing -> refuse(found, path, "could not read"),
  }

// One entry of a directory, which the walk never follows and never reports.
fn entry(found: Found, path: String, name: String) -> Found / {fs.kind[cwd], fs.list_dir[cwd]} =
  match fs.kind[cwd](path) {
    File -> if is_ply(name) { keep(found, path) } else { found },
    Dir -> if skipped(name) { found } else { walk(found, path) },
    Symlink -> found,
    Missing -> found,
  }

fn walk(found: Found, dir: String) -> Found / {fs.kind[cwd], fs.list_dir[cwd]} =
  match fs.list_dir[cwd](dir) {
    None -> refuse(found, dir, "could not read"),
    Some(names) -> fold(names, found, |acc: Found, name: String| entry(acc, join(dir, name), name)),
  }

// --- Formatting -------------------------------------------------------------

type Outcome = { path: String, changed: Bool }

type Report = { files: List<Outcome>, errors: List<Failure> }

fn noted(report: Report, path: String, changed: Bool) -> Report =
  {..report, files: push(report.files, { path: path, changed: changed })}

fn failed(report: Report, path: String, why: String) -> Report =
  {..report, errors: push(report.errors, { path: path, why: why })}

// One file, written back only when the layout moved and `--check` was not asked for.
fn format_one(report: Report, check: Bool, path: String) -> Report
  / {fs.read_file[cwd], fs.write_file[cwd]} =
  match fs.read_file[cwd](path) {
    None -> failed(report, path, "could not read"),
    Some(src) ->
      match fmt_source(src) {
        Err(why) -> failed(report, path, string_of_bytes_lossy(why)),
        Ok(out) ->
          if out == src { noted(report, path, false) }
          else if check { noted(report, path, true) }
          else if fs.write_file[cwd](path, out) { noted(report, path, true) }
          else { failed(report, path, "could not write") },
      },
  }

// The paths as given, or `.`; each is found first, so the files are formatted in path order.
fn sweep(flags: Flags) -> Report
  / {fs.kind[cwd], fs.list_dir[cwd], fs.read_file[cwd], fs.write_file[cwd]} = {
  let wanted = if len(flags.paths) == 0 { ["."] } else { flags.paths };
  let found: Found = fold(wanted, nothing(), |acc: Found, path: String| named(acc, path));
  let start: Report = { files: [], errors: found.errors };
  fold(map_keys(found.files), start, |acc: Report, path: String| format_one(acc, flags.check, path))
}

// --- The report -------------------------------------------------------------

fn schema_version() -> Int = 1

fn changed_of(report: Report) -> List<Outcome> = filter(report.files, |f: Outcome| f.changed)

// An error is `2` whatever else happened; `--check` with work left to do is `1`.
fn exit_code(report: Report, check: Bool) -> Int =
  if len(report.errors) > 0 { 2 }
  else if check && len(changed_of(report)) > 0 { 1 }
  else { 0 }

fn json_report(report: Report, code: Int) -> String =
  to_string(object([
    { key: "command", value: Str("fmt") },
    { key: "schema_version", value: Number(decimal_of_int(schema_version())) },
    { key: "ok", value: Bool(code == 0) },
    { key: "exit_code", value: Number(decimal_of_int(code)) },
    { key: "files", value: Array(map(report.files, |f: Outcome|
        object([{ key: "path", value: Str(f.path) },
                { key: "changed", value: Bool(f.changed) }]))) },
    { key: "errors", value: Array(map(report.errors, |e: Failure|
        object([{ key: "path", value: Str(e.path) },
                { key: "error", value: Str(e.why) }]))) },
  ]))

fn say_changed(verb: String, files: List<Outcome>) -> Unit / {process.out[proc]} =
  match files {
    [] -> (),
    [first, ..rest] -> { process.out[proc](verb ++ first.path); say_changed(verb, rest) },
  }

fn say_errors(errors: List<Failure>) -> Unit / {process.err[proc]} =
  match errors {
    [] -> (),
    [first, ..rest] -> {
      process.err[proc]("error: " ++ first.path ++ ": " ++ first.why);
      say_errors(rest)
    },
  }

fn say(report: Report, flags: Flags, code: Int) -> Unit / {process.out[proc], process.err[proc]} =
  if flags.json { process.out[proc](json_report(report, code)) }
  else {
    say_changed(if flags.check { "would format " } else { "formatted " }, changed_of(report));
    say_errors(report.errors)
  }

fn main() -> Unit
  / {process.args[proc], process.out[proc], process.err[proc], process.exit[proc], fs.kind[cwd], fs.list_dir[cwd], fs.read_file[cwd], fs.write_file[cwd]} = {
  let flags = read_flags(process.args[proc]());
  let report = sweep(flags);
  let code = exit_code(report, flags.check);
  say(report, flags, code);
  process.exit[proc](code)
}

// --- Tests ------------------------------------------------------------------

// The two twins a run is entered over: one tree, one process.
type World = { tree: MemFs, io: Captured }

fn unformatted() -> Bytes = b"fn  add(a: Int,b: Int)->Int = a+b\n"

fn seeded(files: List<{path: String, body: Bytes}>, args: List<String>) -> World =
  { tree: mem_of(files), io: captured(args) }

// `main` over the twins: the tree it left and every line it wrote.
fn run_over(files: List<{path: String, body: Bytes}>, args: List<String>) -> World =
  with_cell[twin](seeded(files, args)) { w -> {
    handle {
      main()
    } with {
      process.args[proc]() -> args_step(cell_get(w).io),
      process.out[proc](text) -> {
        let now: World = cell_get(w);
        cell_set(w, {..now, io: out_step(now.io, text)})
      },
      process.err[proc](text) -> {
        let now: World = cell_get(w);
        cell_set(w, {..now, io: err_step(now.io, text)})
      },
      process.exit[proc](code) resume k -> {
        let now: World = cell_get(w);
        cell_set(w, {..now, io: exit_step(now.io, code)})
      },
      fs.kind[cwd](p) -> mem_kind(cell_get(w).tree, p),
      fs.list_dir[cwd](p) -> mem_list(cell_get(w).tree, p),
      fs.read_file[cwd](p) -> mem_read(cell_get(w).tree, p),
      fs.write_file[cwd](p, body) -> {
        let now: World = cell_get(w);
        let written = mem_write(now.tree, p, body);
        cell_set(w, {..now, tree: written.fs});
        written.ok
      },
    };
    cell_get(w)
  } }

fn line_at(lines: List<String>, i: Int) -> String =
  match list_at(lines, i) { Some(line) -> line, None -> "" }

test "a file is rewritten once, and a second run over the answer changes nothing" {
  let once = run_over([{path: "m.ply", body: unformatted()}], []);
  assert_eq(once.io.out, ["formatted m.ply"]);
  assert_eq(once.io.err, []);
  assert_eq(once.io.code, Some(0));
  match mem_read(once.tree, "m.ply") {
    None -> panic("the file was written back"),
    Some(body) -> {
      assert(body != unformatted());
      let twice = run_over([{path: "m.ply", body: body}], []);
      assert_eq(twice.io.out, []);
      assert_eq(twice.io.code, Some(0));
      assert_eq(mem_read(twice.tree, "m.ply"), Some(body))
    },
  }
}

test "`--check` names what would change, writes nothing and exits 1" {
  let run = run_over([{path: "m.ply", body: unformatted()}], ["--check"]);
  assert_eq(run.io.out, ["would format m.ply"]);
  assert_eq(run.io.code, Some(1));
  assert_eq(mem_read(run.tree, "m.ply"), Some(unformatted()))
}

test "a file that does not parse is reported with its diagnostic and left as it was" {
  let broken = b"fn f( = 1\n";
  let run = run_over([{path: "m.ply", body: broken}], []);
  assert_eq(run.io.out, []);
  assert_eq(run.io.code, Some(2));
  assert_eq(mem_read(run.tree, "m.ply"), Some(broken));
  assert_eq(len(run.io.err), 1);
  assert(string_starts_with(line_at(run.io.err, 0), "error: m.ply: "));
  assert(string_contains(line_at(run.io.err, 0), "E0001"))
}

test "a path that names nothing is an error, and the run exits 2" {
  let run = run_over([{path: "m.ply", body: unformatted()}], ["absent.ply"]);
  assert_eq(run.io.out, []);
  assert_eq(run.io.err, ["error: absent.ply: could not read"]);
  assert_eq(run.io.code, Some(2));
  // Nothing else was reached, so the file the walk would have found is untouched.
  assert_eq(mem_read(run.tree, "m.ply"), Some(unformatted()))
}

test "the JSON document is one object, its keys in order, and nothing else is written" {
  let run = run_over([{path: "m.ply", body: unformatted()}], ["--json", "--check"]);
  assert_eq(run.io.err, []);
  assert_eq(run.io.code, Some(1));
  assert_eq(run.io.out, [string_of_bytes(
    b"{\"command\":\"fmt\",\"errors\":[],\"exit_code\":1,\"files\":[{\"changed\":true,\"path\":\"m.ply\"}],\"ok\":false,\"schema_version\":1}")])
}

test "the walk passes over a symlink, a hidden directory, `target` and anything not `.ply`" {
  let tree = mem_of([
    {path: "m.ply", body: b"fn m() -> Int = 1"},
    {path: "notes.txt", body: b"x"},
    {path: "sub/deep.ply", body: b"fn d() -> Int = 1"},
    {path: ".git/config.ply", body: b"fn g() -> Int = 1"},
    {path: "target/built.ply", body: b"fn b() -> Int = 1"},
    {path: "link.ply", body: b"fn l() -> Int = 1"},
  ]);
  let found = handle {
    named(nothing(), ".")
  } with {
    fs.list_dir[cwd](p) -> mem_list(tree, p),
    fs.kind[cwd](p) -> if p == "link.ply" { Symlink } else { mem_kind(tree, p) },
  };
  assert_eq(map_keys(found.files), ["m.ply", "sub/deep.ply"]);
  assert_eq(found.errors, [])
}

test "a named symlink is refused rather than followed" {
  let found = handle {
    named(nothing(), "link.ply")
  } with {
    fs.kind[cwd](p) -> Symlink,
    fs.list_dir[cwd](p) -> panic("a symlink is never walked"),
  };
  assert_eq(map_keys(found.files), []);
  assert_eq(found.errors, [{ path: "link.ply", why: "a symlink is not formatted" }])
}

test "a named file is taken whatever it is called, and a walked one only when it is `.ply`" {
  let tree = mem_of([{path: "notes.txt", body: b"x"}]);
  let both = handle {
    walk(named(nothing(), "notes.txt"), ".")
  } with {
    fs.list_dir[cwd](p) -> mem_list(tree, p),
    fs.kind[cwd](p) -> mem_kind(tree, p),
  };
  assert_eq(map_keys(both.files), ["notes.txt"])
}

test "the flags are read in any order and every other word is a path, with `./` stripped" {
  let flags = read_flags(["--json", "./a.ply", "--check", "b/c.ply"]);
  assert(flags.check);
  assert(flags.json);
  assert_eq(flags.paths, ["a.ply", "b/c.ply"]);
  let bare = read_flags([]);
  assert(!bare.check);
  assert(!bare.json);
  assert_eq(bare.paths, [])
}

test "the exit code is 2 for an error, 1 for `--check` with work left, and 0 otherwise" {
  let clean: Report = { files: [{ path: "a.ply", changed: false }], errors: [] };
  let moved: Report = { files: [{ path: "a.ply", changed: true }], errors: [] };
  let broken: Report = { files: [], errors: [{ path: "a.ply", why: "could not read" }] };
  assert_eq(exit_code(clean, false), 0);
  assert_eq(exit_code(clean, true), 0);
  assert_eq(exit_code(moved, false), 0);
  assert_eq(exit_code(moved, true), 1);
  assert_eq(exit_code(broken, true), 2)
}
