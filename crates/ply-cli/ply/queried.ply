//! A project's modules answered through the memo store: the world the compiler's queries read, as
//! the walk and the toolchain's shipped modules hold it.

import std.fs (fs)
import compiler.memo
import compiler.memo (Query, Record, Run, Tally, memo_keep, started, tallies)
import compiler.memo_files
import compiler.unit (shipped)
import compiler.checking (Answered, OwnFile, OwnPackage, World, asked_all, evaluator_of, hashed_all,
                          identity_of, looked, refused_first, registry, shipped_all,
                          shipped_queries, world_of, world_placing)
import compiler.hash (Fixing, no_fixing)
import sources (Project, File, DepPackage, Embed, embed_now, embed_of)
import compiler.embed (EmbedAt, EmbedWant, want_of_key)
import std.bytes (hex_of)

fn own_file(f: File) -> OwnFile = { module: bytes_of_string(f.module), text: f.text }

/// The world a load of `project` reads.
fn world(project: Project) -> World / {abort.raise} =
  world_of(
    {
      root: bytes_of_string(project.root_key),
      manifest: match project.manifest { None -> None, Some(f) -> Some(f.text) },
      files: map(project.files, own_file),
    },
    map(project.packages, |p: DepPackage|
      { root: bytes_of_string(p.root), manifest: p.manifest, files: map(p.files, own_file) }),
  )

/// What `answers` say the load's own modules embed, each beside its module's file.
fn embeds_answered(
  project: Project,
  w: World,
  answers: List<Answered>,
) -> List<Embed> / {abort.raise} =
  fold(answers, [], |acc: List<Embed>, a: Answered|
    match world_placing(w, a.module) {
      None -> acc,
      Some(p) ->
        fold(a.answer.shape.embeds, acc, |es: List<Embed>, e: EmbedAt|
          match embed_of(project, p.package, p.relative, want_of_key(e.key), e.read) {
            Some(x) -> push(es, x),
            None -> es,
          }),
    })

fn shipped_module(name: Bytes) -> Option<Bytes> / {fs.read_file[shipped]} =
  fs.read_file[shipped](string_of_bytes_lossy(name) ++ ".ply")

fn shipped_data(name: Bytes) -> Option<Bytes> / {fs.read_file[shipped]} =
  fs.read_file[shipped](string_of_bytes_lossy(name))

fn shipped_names() -> List<Bytes> / {fs.list_dir[shipped], abort.raise} =
  match fs.list_dir[shipped](".") {
    None -> [],
    Some(names) ->
      fold(names, [], |acc: List<Bytes>, n: String|
        if string_ends_with(n, ".ply") {
          push(acc, bytes_of_string(string_slice(n, 0, string_len(n) - 4)))
        } else { acc }),
  }

/// The queries, each under the hash the program running gives its definition and the evaluator it
/// runs on, which the toolchain ships beside its modules.
fn running() -> Map<Bytes, Query> / {fs.read_file[shipped], abort.raise} =
  match ((fs.read_file[shipped]("definitions"), fs.read_file[shipped]("stamps"))) {
    (Some(d), Some(stamps)) -> registry(d, evaluator_of(stamps)),
    _ -> panic("the toolchain ships no `definitions` or no `stamps`"),
  }

/// What each module of a load answered, the shipped modules it pulled in the order it pulled them,
/// what hashing fixed of each where none refuses, and what the run did of each query to answer them.
pub type Queried = {
  answers: List<Answered>,
  pulled: List<Bytes>,
  fixing: Fixing,
  embeds: List<Embed>,
  tallies: List<Tally>,
}

/// What a load with no modules to answer answers.
pub fn nothing() -> Queried =
  { answers: [], pulled: [], fixing: no_fixing(), embeds: [], tallies: [] }

type Asked = { answers: List<Answered>, pulled: List<Bytes>, fixing: Fixing }

/// What `own` and each shipped module they pull answer over `run`, `asked` pulled whatever imports
/// them and each shipped one read with its tests where `tested` says, and what hashing fixed of each
/// where none refuses.
fn asked(
  qs: Map<Bytes, Query>,
  own: List<Bytes>,
  asked: List<Bytes>,
  tested: Bool,
  run: Run,
) -> { run: Run, value: Asked } / {memo_keep.read, memo_keep.write, abort.raise} = {
  let all = asked_all(qs, own, asked, tested, run);
  let answers = all.value.answers;
  let pulled = all.value.pulled;
  if len(refused_first(answers)) > 0 {
    { run: all.run, value: { answers: answers, pulled: pulled, fixing: no_fixing() } }
  } else {
    let fixed = hashed_all(qs, own, pulled, tested, all.run);
    { run: fixed.run, value: { answers: answers, pulled: pulled, fixing: fixed.value } }
  }
}

/// What each module of `project`'s own packages answers, and each shipped module they pull, `always`
/// whatever imports them, read with its tests where `tested` says, through the memo store in `dir`,
/// with what the toolchain ships answered for its shipped modules beside it.
pub fn answered<[r]>(
  dir: String,
  project: Project,
  always: List<Bytes>,
  tested: Bool,
) -> Queried / {fs.list_dir[shipped], fs.read[r], fs.write[r], fs.read_file[shipped], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], shipped.answer, abort.raise} = {
  let qs = running();
  let w = world(project);
  let done = memo_files::kept[r](
    dir,
    |path: String| shipped.answer(path),
    |kind: Bytes, at: Bytes|
      looked(
        w,
        shipped_module,
        shipped_data,
        shipped_names,
        |k: Int, m: Bytes, want: EmbedWant| embed_now(project, k, m, want),
        kind,
        at,
      ),
    || asked(qs, w.own, always, tested, started(qs)),
  );
  {
    answers: done.value.answers,
    pulled: done.value.pulled,
    fixing: done.value.fixing,
    embeds: embeds_answered(project, w, done.value.answers),
    tallies: tallies(done.run),
  }
}

/// What each of `shipped`, the shipped modules, answers to each query a load cannot cheaply answer
/// again, through the memo store in `work`, written into the store `out`, which holds those answers
/// and nothing else: the store `cargo pack` packs beside the shipped modules. How many records it
/// wrote.
pub fn shipped_answers<[r], [w]>(
  work: String,
  out: String,
  shipped: List<Bytes>,
) -> Int / {fs.list_dir[shipped], fs.read[r], fs.write[r], fs.write[w], fs.read_file[shipped], abort.raise} = {
  let qs = running();
  let nowhere = world_of({ root: b"", manifest: None, files: [] }, []);
  let done = memo_files::kept[r](
    work,
    |_: String| None,
    |kind: Bytes, at: Bytes|
      looked(
        nowhere,
        shipped_module,
        shipped_data,
        shipped_names,
        |k: Int, m: Bytes, want: EmbedWant| Err(b"no file is there"),
        kind,
        at,
      ),
    || shipped_all(qs, shipped, started(qs)),
  );
  let wanted = fold(shipped_queries(), map_new(), |acc: Map<Bytes, Bool>, name: Bytes|
    match map_get(qs, name) { Some(q) -> map_insert(acc, q.hash, true), None -> acc });
  let keys = map_fold(done.settled, [], |acc: List<Bytes>, key: Bytes, _: Bytes| push(acc, key));
  memo_files::copied[r, w](
    work,
    out,
    filter(keys, |key: Bytes|
      match memo_files::record_at[r](work, key) {
        Some(rec) -> map_contains(wanted, rec.query),
        None -> false,
      }),
  )
}

/// The store `ply std --answers` answers the shipped modules through, beside the stage of reused
/// answers `reused` names, under the identity of the queries that answer: what a later answering by
/// a `ply` of these queries takes as kept.
pub fn shipped_work(reused: String) -> String / {fs.read_file[shipped], abort.raise} = {
  let cut = fold(range(0, string_len(reused)), 0 - 1, |acc: Int, i: Int|
    if string_slice(reused, i, i + 1) == "/" { i } else { acc });
  let name = "memo-std-" ++ identity_of(running());
  if cut < 0 { name } else { string_slice(reused, 0, cut) ++ "/" ++ name }
}

/// [`answered`] with no store of the project's: what the toolchain ships answered for the shipped
/// modules is read, the rest is answered afresh, and nothing is kept.
pub fn answered_afresh(
  project: Project,
  always: List<Bytes>,
  tested: Bool,
) -> Queried / {fs.list_dir[shipped], fs.read_file[shipped], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], shipped.answer, abort.raise} = {
  let qs = running();
  let w = world(project);
  let done = memo::fresh(
    |path: String| shipped.answer(path),
    |kind: Bytes, at: Bytes|
      looked(
        w,
        shipped_module,
        shipped_data,
        shipped_names,
        |k: Int, m: Bytes, want: EmbedWant| embed_now(project, k, m, want),
        kind,
        at,
      ),
    || asked(qs, w.own, always, tested, started(qs)),
  );
  {
    answers: done.value.answers,
    pulled: done.value.pulled,
    fixing: done.value.fixing,
    embeds: embeds_answered(project, w, done.value.answers),
    tallies: tallies(done.run),
  }
}

/// The hash each query has now, which a record of any other hash will never be asked by again.
pub fn current() -> Map<Bytes, Bool> / {fs.read_file[shipped], abort.raise} =
  map_fold(running(), map_new(), |acc: Map<Bytes, Bool>, _: Bytes, q: Query|
    map_insert(acc, q.hash, true))
