//! A project's modules answered through the memo store: the world the compiler's queries read, as
//! the walk and the toolchain's shipped modules hold it.

import std.fs (fs)
import compiler.memo (Query, Run, Tally, tallies)
import compiler.memo_files
import compiler.checking (Answered, OwnFile, OwnPackage, World, asked_all, evaluator_of,
                          identity_of, looked, registry, world_of)
import sources (Project, File, DepPackage, Embed, under_abs)
import env (env)
import std.list (concat)

fn own_file(f: File) -> OwnFile =
  { module: bytes_of_string(f.module), path: bytes_of_string(f.path), text: f.text }

/// The world a load of `project` reads.
fn world(project: Project) -> World / {abort.raise} =
  world_of(
    {
      root: bytes_of_string(project.root_key),
      manifest: match project.manifest { None -> None, Some(f) -> Some(f.text) },
      files: map(project.files, own_file),
    },
    map(project.packages, |p: DepPackage|
      { root: bytes_of_string(p.root), manifest: p.manifest, files: map(p.files, own_file) }),
    map(project.embeds, |e: Embed| e.embedded),
  )

fn shipped_module(name: Bytes) -> Option<Bytes> / {fs.read_file[shipped]} =
  fs.read_file[shipped](string_of_bytes_lossy(name) ++ ".ply")

fn shipped_data(name: Bytes) -> Option<Bytes> / {fs.read_file[shipped]} =
  fs.read_file[shipped](string_of_bytes_lossy(name))

/// The queries, each under the hash the program running gives its definition and the evaluator it
/// runs on, which the toolchain ships beside its modules.
fn running() -> Map<Bytes, Query> / {fs.read_file[shipped], abort.raise} =
  match ((fs.read_file[shipped]("definitions"), fs.read_file[shipped]("stamps"))) {
    (Some(d), Some(stamps)) -> registry(d, evaluator_of(stamps)),
    _ -> panic("the toolchain ships no `definitions` or no `stamps`"),
  }

/// What each module of a load answered, and what the run did of each query to answer it.
pub type Queried = { answers: List<Answered>, tallies: List<Tally> }

fn queried_of(done: { run: Run, value: List<Answered> }) -> Queried =
  { answers: done.value, tallies: tallies(done.run) }

/// The memo store this machine keeps what the shipped modules answer in, for every project's loads
/// by queries of these hashes: a stage of its own beside the `reused` one, marked used as a stage is.
fn machine_memo(qs: Map<Bytes, Query>) -> String / {env.reused[sys], fs.write[abs], abort.raise} = {
  let reused = under_abs(env.reused[sys]());
  let cut = fold(range(0, string_len(reused)), 0 - 1, |acc: Int, i: Int|
    if string_slice(reused, i, i + 1) == "/" { i } else { acc });
  let identity = identity_of(qs);
  let dir = if cut < 0 { "memo-shipped-" ++ identity }
  else { string_slice(reused, 0, cut) ++ "/memo-shipped-" ++ identity };
  if fs.create_dir[abs](dir) {
    fs.write_file[abs](dir ++ "/.used", b"");
    ()
  };
  dir
}

/// What each module of `project`'s own packages answers, and each shipped module of `shipped`,
/// through the memo store in `dir`. A shipped module answers alike in every project, so what it
/// answers is kept in the machine's store, which a project's run reads beside its own.
pub fn answered<[r]>(
  dir: String,
  project: Project,
  shipped: List<Bytes>,
) -> Queried / {fs.read[r], fs.write[r], fs.read[abs], fs.write[abs], fs.read_file[shipped], env.reused[sys], abort.raise} = {
  let qs = running();
  let w = world(project);
  let machine = machine_memo(qs);
  let nowhere = world_of({ root: b"", manifest: None, files: [] }, [], []);
  let held = memo_files::kept[abs, abs](
    machine,
    None,
    |kind: Bytes, at: Bytes| looked(nowhere, shipped_module, shipped_data, kind, at),
    |run: Run| asked_all(qs, [], shipped, run),
  );
  let own = memo_files::kept[r, abs](
    dir,
    Some(machine),
    |kind: Bytes, at: Bytes| looked(w, shipped_module, shipped_data, kind, at),
    |run: Run| asked_all(qs, w.own, [], run),
  );
  { answers: concat(own.value, held.value), tallies: summed(tallies(own.run), tallies(held.run)) }
}

/// What two runs did of each query, together.
fn summed(a: List<Tally>, b: List<Tally>) -> List<Tally> =
  fold(b, a, |acc: List<Tally>, t: Tally|
    if fold(acc, false, |seen: Bool, u: Tally| seen || u.query == t.query) {
      map(acc, |u: Tally|
        if u.query == t.query { { ..u, took: u.took + t.took, ran: u.ran + t.ran } } else { u })
    } else { push(acc, t) })

/// [`answered`] with no store: everything is answered afresh, and nothing is kept.
pub fn answered_afresh(
  project: Project,
  shipped: List<Bytes>,
) -> Queried / {fs.read_file[shipped], abort.raise} = {
  let qs = running();
  let w = world(project);
  queried_of(
    memo_files::fresh(
      |kind: Bytes, at: Bytes| looked(w, shipped_module, shipped_data, kind, at),
      |run: Run| asked_all(qs, w.own, shipped, run),
    ),
  )
}

/// The hash each query has now, which a record of any other hash will never be asked by again.
pub fn current() -> Map<Bytes, Bool> / {fs.read_file[shipped], abort.raise} =
  map_fold(running(), map_new(), |acc: Map<Bytes, Bool>, _: Bytes, q: Query|
    map_insert(acc, q.hash, true))
