//! What a definition's hashes, its checked answer and a claim's verdict mean, as one version. What a
//! package publishes about its definitions, its interface and its attestations, is keyed by it, so two
//! builds that agree on it read each other's, and a build that changes what one of them means reads
//! none of the other's.

import fingerprint
import std.bytes (hex_of)

/// The first sixteen hex digits of what those meanings come to over `fingerprint`'s corpus.
fn head() -> String / {abort.raise} =
  string_slice(hex_of(fingerprint::fingerprint(fingerprint::corpus())), 0, 16)

/// The version: `head`, which a build evaluates and keeps, so it moves with a change to any of those
/// meanings and no source states it.
pub const fn version() -> String = head()

// --- Tests ------------------------------------------------------------------

test "the version a build kept is the head of the fingerprint these sources answer" {
  assert_eq(version(), head());
  assert_eq(string_len(version()), 16)
}
