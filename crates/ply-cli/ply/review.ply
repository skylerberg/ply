// `ply review` — what changed since the last accepted review, and whether the claims about it
// still hold. A definition carrying no obligation that holds is reported as one this run says
// nothing about: an unreviewed change is not the same as no change.

import compiler.load (LoadedAnalysis)
import std.random (entropy)
import args (Flags, from_argv, style_of)
import claims
import env (env)
import results
import proof.rules (Congruence)
import program (Timed, load_diagnostics, front_of, owned_of, no_front, timed_load, timed_uncached)
import proof.world (Built, World, world_of)
import machine
import units
import units (emit)
import claims (Broken, Options, prover, proofs, Accepted, Claim, Claimed, Collected, Collection,
               Discharged, Refusal, Row, Verdicts, a_claim, a_counter, a_fault, a_place, claim_rows,
               claimed_part, code_of, collected_part, collection_of, coverage_json, coverage_lines,
               decided, detail_of, diagnostics_of, failure, label_of, laws_in, mark_of, no_statics,
               no_world, obligation_json, a_plan, once_each, outcome_word, own_claims, plan_json,
               proved, refusal, rows_of, Statics, statics_of, discharge_runs)
import proof.decide (Static)
import proof.obligation (Change, Changed, Changes, Coverage, Def, Defect, Ensures, Fresh, Gap,
                         Moved, Never, Outcome, Outgrown, Record, Refuted, Tier, Unattempted,
                         Unchanged, UnhandledEffect, record_map, records, review, claimed,
                         is_specified, plural)
import builder (builder)
import std.fs (fs)
import std.time (time)
import compiler.resolve (Diag)
import diagnostic (Place, all_to_json)
import report (Answer, indent, ok_code, schema_version, count_of, warning_lines)
import std.json (Json, Str, Bool, Number, Array, object, to_string, int)
import std.list (at_or, concat)
import style (Style, bold, dim, red)
import std.string (pad_right)
import prove (a_collection)

// --- How a changed definition reads ------------------------------------------

fn moved_word(m: Moved) -> String =
  match m { Unchanged -> "unchanged", Changed -> "changed", Never -> "never reviewed" }

fn row_of(change: Change) -> String =
  match change.implementation {
    Never -> change.name ++ " · never reviewed",
    _ -> {
      let spec = if claimed(change) { "spec " ++ moved_word(change.spec) } else { "no spec" };
      change.name ++ " · implementation " ++ moved_word(change.implementation) ++ " · " ++ spec
    },
  }

fn never_accepted() -> String = "never accepted: review the spec and the implementation once"

fn review_both() -> String = "review both; the tier says how much the machine already checked"

// What a reader is left to do, which is the whole point of the command.
fn advice(change: Change) -> String =
  if !is_specified(change) {
    if claimed(change) {
      "no obligation on this definition holds: read the implementation, line by line"
    } else { "read the implementation, line by line, exactly as today" }
  } else {
    match change.implementation {
      Never -> never_accepted(),
      Changed -> match change.spec {
        Never -> never_accepted(),
        Unchanged -> "review the obligations, not the diff",
        Changed -> review_both(),
      },
      Unchanged -> match change.spec {
        Never -> never_accepted(),
        Changed -> "review the spec diff; the implementation did not move",
        Unchanged -> review_both(),
      },
    }
  }

// --- What the run says it established -----------------------------------------

fn specified_of(changes: Changes) -> Int =
  len(filter(changes.changed, |change: Change| is_specified(change)))

fn unspecified_of(changes: Changes) -> Int = len(changes.changed) - specified_of(changes)

fn were(n: Int) -> String = if n == 1 { "was" } else { "were" }

fn claim_of(changes: Changes) -> String / {abort.raise} =
  if changes.broken > 0 && changes.broken == changes.undischarged {
    int_to_string(changes.broken) ++ " " ++ plural(changes.broken, "obligation")
      ++ " on a changed definition "
      ++ were(changes.broken)
      ++ " not discharged, so nothing here was established"
  } else if changes.broken > 0 {
    int_to_string(changes.broken) ++ " " ++ plural(changes.broken, "obligation")
      ++ " on a changed definition no longer hold"
  } else if specified_of(changes) == 0 { "no specified behaviour changed" } else {
    "no specified behaviour changed: every obligation on the "
      ++ int_to_string(specified_of(changes))
      ++ " specified of them still holds"
  }

// A definition nothing claims can change without this run noticing, which is a blind spot the
// headline has to carry rather than a quiet success.
pub fn headline_of(changes: Changes) -> String / {abort.raise} =
  if len(changes.changed) == 0 { "no definition changed since the last accepted review" } else {
    let unspecified = unspecified_of(changes);
    if unspecified == 0 { claim_of(changes) } else {
      let count = if unspecified == len(changes.changed) {
        "all " ++ int_to_string(len(changes.changed)) ++ " of them"
      } else { int_to_string(unspecified) ++ " of " ++ int_to_string(len(changes.changed)) };
      claim_of(changes) ++ " · " ++ count
        ++ " carry no obligation that holds, so this run says nothing about whether their behaviour changed"
    }
  }

// --- The lines a reader reads --------------------------------------------------

fn detail_line(style: Style, row: Row, places: List<Place>) -> String / {abort.raise} = {
  // What a refutation says here is that the claim stopped holding; where it fails is `ply prove`'s
  // business, and this command is read for what moved.
  let detail = match row.outcome {
    Refuted(_) -> "no longer holds",
    Outgrown(_) -> "no longer holds",
    _ -> detail_of(row, places),
  };
  indent() ++ "  " ++ mark_of(style, row.outcome) ++ " "
    ++ pad_right(outcome_word(row.outcome), 11, " ")
    ++ " "
    ++ pad_right(label_of(row.claim), 40, " ")
    ++ " "
    ++ dim(style, detail)
}

fn entry_lines(
  style: Style,
  change: Change,
  rows: List<Row>,
  places: List<Place>,
) -> List<String> / {abort.raise} = {
  let head = [indent() ++ bold(style, row_of(change))];
  let listed = fold(change.obligations, head, |acc: List<String>, index: Int|
    match list_at(rows, index) {
      None -> acc,
      Some(r) -> push(acc, detail_line(style, r, places)),
    });
  push(push(listed, indent() ++ "  " ++ dim(style, "→ " ++ advice(change))), "")
}

fn changed_line(changes: Changes, cov: Coverage) -> String / {abort.raise} =
  indent() ++ int_to_string(len(changes.changed)) ++ " of "
    ++ count_of(cov.definitions, "definition")
    ++ " changed since the last accepted review · "
    ++ int_to_string(changes.reviewed)
    ++ " of them have a baseline"

fn noted_lines(style: Style, warnings: List<Diag>) -> List<String> / {abort.raise} =
  if len(warnings) == 0 { [] } else { concat(warning_lines(style, warnings), [""]) }

fn headline_line(style: Style, changes: Changes) -> String / {abort.raise} = {
  let headline = headline_of(changes);
  indent() ++ (if changes.broken > 0 { red(style, headline) } else { headline })
}

fn lines_of(
  style: Style,
  collection: Collection,
  v: Verdicts,
  changes: Changes,
  rows: List<Row>,
  warnings: List<Diag>,
) -> List<String> / {abort.raise} = {
  let head = concat(
    concat(coverage_lines(style, v.coverage, v.specified, false), [
      changed_line(changes, v.coverage),
    ]),
    [""],
  );
  let listed = fold(changes.changed, head, |acc: List<String>, change: Change|
    concat(acc, entry_lines(style, change, rows, collection.places)));
  concat(concat(listed, noted_lines(style, warnings)), [headline_line(style, changes)])
}

// --- The document ---------------------------------------------------------------

fn spec_word(change: Change) -> String =
  if claimed(change) { moved_word(change.spec) } else { "none" }

fn change_json(change: Change, rows: List<Row>, places: List<Place>) -> Json / {abort.raise} =
  object([
    { key: "name", value: Str(change.name) },
    { key: "implementation", value: Str(moved_word(change.implementation)) },
    { key: "spec", value: Str(spec_word(change)) },
    { key: "specified", value: Bool(is_specified(change)) },
    { key: "advice", value: Str(advice(change)) },
    {
      key: "obligations",
      value: Array(
        fold(change.obligations, [], |acc: List<Json>, index: Int|
          match list_at(rows, index) {
            None -> acc,
            Some(r) -> push(acc, obligation_json(r, places, false)),
          }),
      ),
    },
  ])

fn document(
  collection: Collection,
  v: Verdicts,
  changes: Changes,
  rows: List<Row>,
  code: Int,
  warnings: List<Diag>,
) -> Json / {abort.raise} =
  object([
    { key: "schema_version", value: int(schema_version()) },
    { key: "command", value: Str("review") },
    { key: "action", value: Str("changed") },
    { key: "ok", value: Bool(code == ok_code()) },
    { key: "exit_code", value: int(code) },
    { key: "definitions", value: int(v.coverage.definitions) },
    { key: "specified", value: int(v.specified) },
    { key: "reviewed", value: int(changes.reviewed) },
    { key: "coverage", value: coverage_json(v.coverage) },
    { key: "plan", value: plan_json(collection.plan) },
    { key: "duration_ms", value: Number(v.duration_ms) },
    // Not `changed`: an unspecified definition can change without anything here noticing.
    { key: "headline", value: Str(headline_of(changes)) },
    { key: "specified_changed", value: int(specified_of(changes)) },
    { key: "unspecified_changed", value: int(unspecified_of(changes)) },
    { key: "broken", value: int(changes.broken) },
    { key: "undischarged", value: int(changes.undischarged) },
    {
      key: "changed",
      value: Array(
        map(changes.changed, |change: Change| change_json(change, rows, collection.places)),
      ),
    },
    { key: "diagnostics", value: all_to_json(diagnostics_of(rows), collection.places) },
    { key: "warnings", value: all_to_json(warnings, collection.places) },
  ])

// --- Accepting a baseline --------------------------------------------------------

fn accepted_document(
  warnings: List<Diag>,
  definitions: Int,
  code: Int,
  places: List<Place>,
) -> Json / {abort.raise} =
  object([
    { key: "schema_version", value: int(schema_version()) },
    { key: "command", value: Str("review") },
    { key: "action", value: Str("accept") },
    { key: "ok", value: Bool(code == ok_code()) },
    { key: "exit_code", value: int(code) },
    { key: "accepted", value: int(definitions) },
    { key: "warnings", value: all_to_json(warnings, places) },
  ])

// A baseline keyed by name is the one a reader can still look up: a hash nobody can read says
// nothing about what they accepted.
fn accepted_lines(
  style: Style,
  warnings: List<Diag>,
  definitions: Int,
) -> List<String> / {abort.raise} =
  concat(
    [
      indent() ++ count_of(definitions, "definition") ++ " accepted as reviewed",
      indent()
        ++ dim(
          style,
          "the baseline is keyed by name, so renaming one loses its baseline and reports it as unreviewed",
        ),
    ],
    warning_lines(style, warnings),
  )

fn accepted_answer(style: Style, collection: Collection, a: Accepted) -> Answer / {abort.raise} = {
  let warnings = once_each(concat(collection.warnings, a.warnings));
  let code = if a.stored { ok_code() } else { failure() };
  {
    json: accepted_document(warnings, a.definitions, code, collection.places),
    lines: accepted_lines(style, warnings, a.definitions),
    errs: [],
    code: code,
  }
}

// --- The answer -------------------------------------------------------------------

fn reviewed_answer(
  style: Style,
  collection: Collection,
  v: Verdicts,
  changes: Changes,
  rows: List<Row>,
) -> Answer / {abort.raise} = {
  let warnings = once_each(concat(collection.warnings, v.warnings));
  let code = code_of(rows);
  {
    json: document(collection, v, changes, rows, code, warnings),
    lines: lines_of(style, collection, v, changes, rows, warnings),
    errs: [],
    code: code,
  }
}

fn all_of(claims: List<Claim>) -> List<Int> = range(0, len(claims))

// A review reports on everything the collection holds: what moved since the baseline a reader
// accepted, and what became of the claims that went with it.
fn changed_answer<| e>(
  style: Style,
  collection: Collection,
  use_cache: Bool,
  statics: Statics,
  discharge: (Collection, List<Int>, List<Static>) -> Result<Discharged, Refusal> / e,
) -> Answer / {abort.raise, proofs.record, proofs.baselines, proofs.cached | e} = {
  let wanted = all_of(collection.claims);
  match decided(
      collection,
      wanted,
      use_cache,
      statics,
      false,
      |runs: List<Int>, settled: List<Static>| discharge(collection, runs, settled),
    ) {
    Err(why) -> refusal(style, "review", why),
    Ok(v) -> {
      let laws = laws_in(collection);
      let ch = review(
        map(collection.defs, |def: Def| def.name),
        laws,
        record_map(records(collection.defs, laws)),
        record_map(proofs.baselines(map(collection.defs, |def: Def| def.name))),
        claim_rows(collection, wanted, v.outcomes),
      );
      reviewed_answer(style, collection, v, ch, rows_of(collection.claims, wanted, v))
    },
  }
}

pub fn run(
  flags: Flags,
  options: Options,
) -> Answer / {builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shelf], fs.read_file[shelf], time.elapsed_ms, time.elapsed_us, env.var[sys], env.pwd[sys], prover.configure[claims], prover.collected[claims], prover.prepared[claims], prover.judged[claims], prover.interleaved[claims], prover.ended[claims], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, emit.unit, prover.compiled[claims], abort.raise, diverges} = {
  let s: Style = style_of(flags);
  let t: Timed = if options.no_incremental { timed_uncached(flags.paths) }
  else { timed_load(flags.paths, !options.std) };
  match t.program.whole {
    // A load refusal is the same kind of answer the machine's own refusals are, so it
    // reads through the one renderer: nothing was proved, and the diagnostics say why.
    None ->
      refusal(
        s,
        "review",
        Broken({ diags: load_diagnostics(t.program), places: t.program.places }),
      ),
    Some(w) -> {
      // The shipped modules' claims are the toolchain's, unless the run asks for them too.
      let owned = owned_of(w, options.std);
      let built: Built = world_of(w, owned);
      results::with_review(results::store_for(flags.paths, options.no_cache), ||
        review_over(
          s,
          flags,
          options,
          front_of(t, w),
          built.world,
          own_claims(w, built),
          statics_of(w, built.world, owned),
          |collection: Collection, runs: List<Int>, settled: List<Static>|
            claims::discharged_over(
              front_of(t, w),
              collection,
              runs,
              settled,
              machine::unconfigured(),
            ),
        ))
    },
  }
}

// The review itself, over the front end `run` loaded, the claims it built from it, and the static
// prover over them.
fn review_over<| e>(
  style: Style,
  flags: Flags,
  options: Options,
  front: LoadedAnalysis,
  world: World,
  mine: Claimed,
  statics: Statics,
  discharge: (Collection, List<Int>, List<Static>) -> Result<Discharged, Refusal> / e,
) -> Answer / {abort.raise, prover.configure[claims], prover.collected[claims], proofs.record, proofs.baselines, proofs.accepted, proofs.cached | e} = {
  prover.configure[claims](options, front, world);
  match prover.collected[claims]() {
    Err(why) -> refusal(style, "review", why),
    // What a reader accepts is every definition's claims as they stand now.
    Ok(got) -> {
      let c = collection_of(got, mine, options);
      if flags.action == "accept" {
        accepted_answer(style, c, proofs.accepted(records(c.defs, laws_in(c))))
      } else { changed_answer(style, c, !options.no_cache, statics, discharge) }
    },
  }
}

// --- Tests ------------------------------------------------------------------

fn covering(definitions: Int) -> Coverage =
  { definitions: definitions, covered: 0, uncovered: [], by_tier: [] }

fn verdicts(outcomes: List<Outcome>, definitions: Int) -> Verdicts =
  {
    outcomes: outcomes,
    reaches: None,
    reasons: map(outcomes, |outcome: Outcome| Fresh),
    coverage: covering(definitions),
    cached: 0,
    specified: len(outcomes),
    duration_ms: decimal_of_int(0),
    warnings: [],
  }

fn no_changes() -> Changes = { reviewed: 0, changed: [], broken: 0, undischarged: 0 }

fn a_change(
  name: String,
  implementation: Moved,
  spec: Moved,
  obligations: List<Int>,
  holding: Int,
) -> Change =
  {
    name: name,
    implementation: implementation,
    spec: spec,
    obligations: obligations,
    holding: holding,
  }

// What a review says about the changes it was handed.
fn reviewed_over(
  flags: Flags,
  collection: Collection,
  v: Verdicts,
  changes: Changes,
  a: Accepted,
) -> Answer / {abort.raise} =
  if flags.action == "accept" { accepted_over(flags, collection, a) } else {
    reviewed_answer(
      style_of(flags),
      collection,
      v,
      changes,
      rows_of(collection.claims, all_of(collection.claims), v),
    )
  }

// A whole run against a runtime that answers these: the baselines it holds, what it discharged, and
// what it made of the records it was asked to accept.
fn ran_over(
  flags: Flags,
  c: Collection,
  d: Discharged,
  held: List<{ name: String, record: Record }>,
  a: Accepted,
) -> Answer / {abort.raise} =
  handle {
    review_over(
      style_of(flags),
      flags,
      claims::no_options(),
      no_front(),
      no_world(),
      claimed_part(c),
      no_statics(None),
      |_c: Collection, runs: List<Int>, _settled: List<Static>|
        Ok({
          ..d,
          outcomes: fold(runs, [], |out: List<Outcome>, i: Int|
            match list_at(d.outcomes, i) { Some(o) -> push(out, o), None -> out }),
        }),
    )
  } with {
    prover.configure[claims](options, front, world) -> (),
    prover.collected[claims]() -> Ok(collected_part(c)),
    proofs.cached(keys) -> map(keys, |_k: String| None),
    proofs.record(entries) -> [],
    proofs.baselines(names) -> held,
    proofs.accepted(records) -> { ..a, definitions: len(records) },
  }

fn accepted_over(flags: Flags, collection: Collection, a: Accepted) -> Answer / {abort.raise} =
  ran_over(flags, collection, { outcomes: [], duration_ms: decimal_of_int(0), warnings: [] }, [], a)

fn nothing_accepted() -> Accepted = { definitions: 0, stored: true, warnings: [] }

fn changed_flags() -> Flags / {abort.raise} = from_argv("review", [])

fn one_claim() -> List<Claim> = [a_claim("m.double", Ensures(0))]

test "a definition that carries no obligation that holds is reported as unread, not as checked" {
  let ch: Changes = {
    ..no_changes(),
    reviewed: 3,
    changed: [a_change("m.double", Changed, Never, [], 0)],
  };
  let answer = reviewed_over(
    changed_flags(),
    a_collection([]),
    verdicts([], 3),
    ch,
    nothing_accepted(),
  );
  assert_eq(answer.code, 0);
  assert_eq(
    at_or(answer.lines, 1, ""),
    "   1 of 3 definitions changed since the last accepted review · 3 of them have a baseline",
  );
  assert_eq(at_or(answer.lines, 3, ""), "   m.double · implementation changed · no spec");
  assert_eq(
    at_or(answer.lines, 4, ""),
    "     → read the implementation, line by line, exactly as today",
  );
  assert(
    string_contains(
      at_or(answer.lines, len(answer.lines) - 1, ""),
      "carry no obligation that holds, so this run says nothing about whether their behaviour changed",
    ),
  )
}

test "nothing changed is said outright, so a quiet run is not read as an empty one" {
  let answer = reviewed_over(
    changed_flags(),
    a_collection([]),
    verdicts([], 2),
    no_changes(),
    nothing_accepted(),
  );
  assert_eq(
    at_or(answer.lines, len(answer.lines) - 1, ""),
    "   no definition changed since the last accepted review",
  )
}

// An obligation nothing discharged never held, so the headline may not claim it stopped holding.
test "an undischarged obligation on a changed definition says nothing was established" {
  let ch: Changes = {
    ..no_changes(),
    reviewed: 1,
    broken: 1,
    undischarged: 1,
    changed: [a_change("m.stored", Changed, Unchanged, [0], 0)],
  };
  let gap = Unattempted(UnhandledEffect(Some("{db.read[rows]}")));
  let answer = reviewed_over(
    changed_flags(),
    a_collection(one_claim()),
    verdicts([gap], 1),
    ch,
    nothing_accepted(),
  );
  let headline = at_or(answer.lines, len(answer.lines) - 1, "");
  assert(string_contains(headline, "1 obligation on a changed definition was not discharged"));
  assert(!string_contains(headline, "no longer hold"));
  assert_eq(at_or(answer.lines, 3, ""), "   m.stored · implementation changed · spec unchanged");
  assert(string_contains(at_or(answer.lines, 4, ""), "unattempted"));
  assert_eq(answer.code, 0)
}

// Ply's failure refutes nothing, so the headline may only say the obligation was not discharged.
test "an obligation Ply failed on under a changed definition was not discharged, and fails the run" {
  let c = {
    ..a_collection(one_claim()),
    defs: [{ name: "m.double", hash: Some("h2"), specs: [] }],
  };
  let answer = ran_over(
    changed_flags(),
    c,
    { outcomes: [Defect(a_fault())], duration_ms: decimal_of_int(0), warnings: [] },
    [{ name: "m.double", record: { def_hash: "h1", specs: [] } }],
    nothing_accepted(),
  );
  assert_eq(answer.code, 1);
  let headline = at_or(answer.lines, len(answer.lines) - 1, "");
  assert(string_contains(headline, "1 obligation on a changed definition was not discharged"));
  assert(!string_contains(headline, "no longer hold"));
  assert(len(filter(answer.lines, |l: String| string_contains(l, "! defect"))) == 1)
}

test "a refuted obligation under a changed definition is exit 1 and says it no longer holds" {
  let ch: Changes = {
    ..no_changes(),
    reviewed: 1,
    broken: 1,
    changed: [a_change("m.double", Changed, Unchanged, [0], 0)],
  };
  let answer = reviewed_over(
    changed_flags(),
    a_collection(one_claim()),
    verdicts([Refuted(a_counter())], 1),
    ch,
    nothing_accepted(),
  );
  assert_eq(answer.code, 1);
  assert(string_contains(at_or(answer.lines, 4, ""), "no longer holds"));
  assert(
    string_contains(
      at_or(answer.lines, len(answer.lines) - 1, ""),
      "1 obligation on a changed definition no longer hold",
    ),
  )
}

test "what a reader is left to do depends on which half moved" {
  assert_eq(
    advice(a_change("m.a", Changed, Unchanged, [0], 1)),
    "review the obligations, not the diff",
  );
  assert_eq(
    advice(a_change("m.a", Unchanged, Changed, [0], 1)),
    "review the spec diff; the implementation did not move",
  );
  assert_eq(
    advice(a_change("m.a", Never, Never, [0], 1)),
    "never accepted: review the spec and the implementation once",
  );
  assert_eq(
    advice(a_change("m.a", Changed, Changed, [0], 1)),
    "review both; the tier says how much the machine already checked",
  );
  assert_eq(
    advice(a_change("m.a", Changed, Changed, [0], 0)),
    "no obligation on this definition holds: read the implementation, line by line",
  )
}

test "the object names what moved, what it covers and the sentence to act on" {
  let ch: Changes = {
    ..no_changes(),
    reviewed: 3,
    changed: [a_change("m.double", Changed, Never, [0], 1)],
  };
  let answer = reviewed_over(
    from_argv("review", ["--json"]),
    a_collection(one_claim()),
    verdicts([proved([], 1)], 3),
    ch,
    nothing_accepted(),
  );
  let text = to_string(answer.json);
  assert(string_contains(text, "\"command\":\"review\""));
  assert(string_contains(text, "\"action\":\"changed\""));
  assert(string_contains(text, "\"definitions\":3"));
  assert(string_contains(text, "\"specified_changed\":1"));
  assert(string_contains(text, "\"unspecified_changed\":0"));
  assert(string_contains(text, "\"implementation\":\"changed\""));
  assert(string_contains(text, "\"spec\":\"never reviewed\""));
  assert(string_contains(text, "\"outcome\":\"proved\""))
}

test "a definition with no obligation at all reports `none` rather than a spec that never moved" {
  let e = a_change("m.double", Changed, Never, [], 0);
  assert_eq(spec_word(e), "none");
  assert_eq(row_of(e), "m.double · implementation changed · no spec");
  assert_eq(row_of(a_change("m.new", Never, Never, [], 0)), "m.new · never reviewed")
}

fn three() -> Collection =
  a_collection([a_claim("m.a", Ensures(0)), a_claim("m.b", Ensures(0)), a_claim("m.c", Ensures(0))])

test "`--accept` records a baseline and says what a name change costs" {
  let accepted: Accepted = { definitions: 0, stored: true, warnings: [] };
  let answer = reviewed_over(
    from_argv("review", ["--accept"]),
    three(),
    verdicts([], 3),
    no_changes(),
    accepted,
  );
  assert_eq(answer.code, 0);
  assert_eq(answer.lines, [
    "   3 definitions accepted as reviewed",
    "   the baseline is keyed by name, so renaming one loses its baseline and reports it as unreviewed",
  ]);
  assert(string_contains(to_string(answer.json), "\"action\":\"accept\""));
  assert(string_contains(to_string(answer.json), "\"accepted\":3"))
}

// A baseline that was not written is not a baseline, whatever the run printed.
test "a baseline that could not be stored is exit 1 and says so" {
  let e: Diag = {
    code: b"W0304",
    notes: 0,
    labels: [],
    text: b"",
    message: b"the cache would not flush",
    notes_text: [],
    severity: b"error",
    fixes: [],
  };
  let accepted: Accepted = { definitions: 0, stored: false, warnings: [e] };
  let answer = reviewed_over(
    from_argv("review", ["--accept"]),
    three(),
    verdicts([], 3),
    no_changes(),
    accepted,
  );
  assert_eq(answer.code, 1);
  assert_eq(at_or(answer.lines, 2, ""), "   error: the cache would not flush");
  assert(string_contains(to_string(answer.json), "\"ok\":false"))
}

test "a review decides what moved from the baselines the runtime holds" {
  let c = {
    ..a_collection([]),
    defs: [
      { name: "m.double", hash: Some("h2"), specs: [] },
      { name: "m.same", hash: Some("h1"), specs: [] },
    ],
  };
  let answer = ran_over(
    changed_flags(),
    c,
    { outcomes: [], duration_ms: decimal_of_int(0), warnings: [] },
    [
      { name: "m.double", record: { def_hash: "h1", specs: [] } },
      { name: "m.same", record: { def_hash: "h1", specs: [] } },
    ],
    nothing_accepted(),
  );
  assert_eq(at_or(answer.lines, 0, ""), "   2 definitions · 0 carry an obligation · 2 do not");
  assert_eq(at_or(answer.lines, 1, ""), "   2 not covered by a claim that holds: m.double, m.same");
  assert_eq(
    at_or(answer.lines, 2, ""),
    "   1 of 2 definitions changed since the last accepted review · 2 of them have a baseline",
  );
  assert_eq(at_or(answer.lines, 4, ""), "   m.double · implementation changed · no spec")
}
