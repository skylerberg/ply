// `ply callers` — what mentions a definition: directly, and through any number of calls.

import std.random (entropy)
import std.time (time)
import builder (builder)
import args (Flags, style_of)
import program (Program, Tables, load_program, published, tables_of, location_of, resolve_def,
                unknown_def, own_tests, own_laws, reached_from)
import report (Answer, schema_version, ok_code, indent, count_of, refused, reported)
import style (Style, bold)
import compiler.front (Analysis)
import compiler.hash (no_hashes)
import compiler.infer (DefInfo, TestInfo, LawInfo)
import std.fs (fs)
import std.json (Json, Null, Str, Bool, Number, Array, object)

// The keys that mention a definition, sorted into what each one names. A key that is none of the
// three is a declaration and is dropped.
type Group = { definitions: List<DefInfo>, tests: List<TestInfo>, laws: List<LawInfo> }

type Index = { defs: Map<Bytes, DefInfo>, tests: Map<Bytes, TestInfo>, laws: Map<Bytes, LawInfo> }

fn indexed(program: Program, analysis: Analysis) -> Index =
  {
    defs: fold(analysis.checked.defs, map_new(), |acc: Map<Bytes, DefInfo>, def_info: DefInfo|
      map_insert(acc, def_info.name, def_info)),
    tests: fold(
      own_tests(program, analysis),
      map_new(),
      |acc: Map<Bytes, TestInfo>, x: TestInfo| map_insert(acc, x.key, x),
    ),
    laws: fold(own_laws(program, analysis), map_new(), |acc: Map<Bytes, LawInfo>, x: LawInfo|
      map_insert(acc, x.key, x)),
  }

fn holds(names: List<Bytes>, name: Bytes) -> Bool =
  fold(names, false, |acc: Bool, n: Bytes| acc || n == name)

// Every key whose own references name it.
fn referrers(tables: Tables, name: Bytes) -> List<Bytes> =
  map_fold(tables.deps, [], |acc: List<Bytes>, key: Bytes, names: List<Bytes>|
    if holds(names, name) { push(acc, key) } else { acc })

fn sorted_into(ix: Index, keys: List<Bytes>) -> Group =
  fold(keys, { definitions: [], tests: [], laws: [] }, |acc: Group, key: Bytes|
    match map_get(ix.defs, key) {
      Some(d) -> { ..acc, definitions: push(acc.definitions, d) },
      None -> match map_get(ix.tests, key) {
        Some(x) -> { ..acc, tests: push(acc.tests, x) },
        None -> match map_get(ix.laws, key) {
          Some(x) -> { ..acc, laws: push(acc.laws, x) },
          None -> acc,
        },
      },
    })

fn summary(group: Group) -> String / {abort.raise} =
  count_of(len(group.definitions), "definition") ++ ", " ++ count_of(len(group.tests), "test")
    ++ ", "
    ++ count_of(len(group.laws), "law")

// --- The listing ------------------------------------------------------------

fn quoted(name: Bytes) -> String = "\"" ++ string_of_bytes_lossy(name) ++ "\""

fn group_lines(title: String, group: Group, lines: List<String>) -> List<String> / {abort.raise} = {
  let head = push(lines, indent() ++ title ++ ": " ++ summary(group));
  let after_defs = fold(group.definitions, head, |acc: List<String>, def_info: DefInfo|
    push(acc, indent() ++ indent() ++ string_of_bytes_lossy(def_info.name)));
  let after_tests = fold(group.tests, after_defs, |acc: List<String>, x: TestInfo|
    push(acc, indent() ++ indent() ++ "test " ++ quoted(x.name)));
  fold(group.laws, after_tests, |acc: List<String>, x: LawInfo|
    push(acc, indent() ++ indent() ++ "law " ++ quoted(x.name)))
}

fn text_lines(
  style: Style,
  name: Bytes,
  direct: Group,
  transitive: Group,
) -> List<String> / {abort.raise} =
  group_lines(
    "reached from",
    transitive,
    group_lines("mentioned by", direct, ["", indent() ++ bold(style, string_of_bytes_lossy(name))]),
  )

// --- The document -----------------------------------------------------------

fn opt_str(v: Option<String>) -> Json = match v { Some(x) -> Str(x), None -> Null }

fn definition_json(program: Program, def_info: DefInfo) -> Json / {abort.raise} =
  object([
    { key: "name", value: Str(string_of_bytes_lossy(def_info.name)) },
    { key: "location", value: opt_str(location_of(program, def_info.at)) },
  ])

fn test_json(program: Program, test_info: TestInfo) -> Json / {abort.raise} =
  object([
    { key: "index", value: Number(decimal_of_int(test_info.index)) },
    { key: "key", value: Str(string_of_bytes_lossy(test_info.key)) },
    { key: "name", value: Str(string_of_bytes_lossy(test_info.name)) },
    { key: "module", value: Str(string_of_bytes_lossy(test_info.module)) },
    { key: "location", value: opt_str(location_of(program, test_info.at)) },
  ])

fn law_json(program: Program, law_info: LawInfo) -> Json / {abort.raise} =
  object([
    { key: "index", value: Number(decimal_of_int(law_info.index)) },
    { key: "key", value: Str(string_of_bytes_lossy(law_info.key)) },
    { key: "name", value: Str(string_of_bytes_lossy(law_info.name)) },
    { key: "module", value: Str(string_of_bytes_lossy(law_info.module)) },
    { key: "location", value: opt_str(location_of(program, law_info.at)) },
  ])

fn group_json(program: Program, group: Group) -> Json / {abort.raise} =
  object([
    {
      key: "definitions",
      value: Array(map(group.definitions, |def_info: DefInfo| definition_json(program, def_info))),
    },
    { key: "tests", value: Array(map(group.tests, |x: TestInfo| test_json(program, x))) },
    { key: "laws", value: Array(map(group.laws, |x: LawInfo| law_json(program, x))) },
  ])

fn answered(
  style: Style,
  program: Program,
  def_info: DefInfo,
  direct: Group,
  transitive: Group,
) -> Answer / {abort.raise} =
  {
    json: object([
      { key: "command", value: Str("callers") },
      { key: "schema_version", value: Number(decimal_of_int(schema_version())) },
      { key: "ok", value: Bool(true) },
      { key: "exit_code", value: Number(decimal_of_int(ok_code())) },
      {
        key: "definition",
        value: object([
          { key: "name", value: Str(string_of_bytes_lossy(def_info.name)) },
          { key: "module", value: Str(string_of_bytes_lossy(def_info.module)) },
          { key: "location", value: opt_str(location_of(program, def_info.at)) },
        ]),
      },
      { key: "direct", value: group_json(program, direct) },
      { key: "transitive", value: group_json(program, transitive) },
      { key: "diagnostics", value: Array([]) },
    ]),
    lines: text_lines(style, def_info.name, direct, transitive),
    errs: [],
    code: ok_code(),
  }

fn mentioned(
  style: Style,
  program: Program,
  analysis: Analysis,
  def_info: DefInfo,
) -> Answer / {abort.raise} = {
  let tables: Tables = tables_of(analysis.hashes);
  let ix: Index = indexed(program, analysis);
  answered(
    style,
    program,
    def_info,
    sorted_into(ix, referrers(tables, def_info.name)),
    sorted_into(ix, reached_from(tables, def_info.name)),
  )
}

pub fn run(
  flags: Flags,
) -> Answer / {builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shelf], fs.read_file[shelf], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, abort.raise} = {
  let loaded: Program = load_program(flags.paths);
  let s = style_of(flags);
  match loaded.whole {
    None -> refused(s, "callers", loaded.diags, loaded.places),
    Some(w) -> match resolve_def(published(w), flags.query) {
      Err(names) -> reported(s, "callers", [unknown_def(flags.query, names)], loaded.places),
      Ok(d) -> mentioned(s, loaded, w, d),
    },
  }
}

// --- Tests ------------------------------------------------------------------

fn a_test(name: Bytes, key: Bytes, index: Int) -> TestInfo =
  {
    name: name,
    module: b"m",
    key: key,
    index: index,
    nondet: false,
    footprint: [],
    at: { module: 0, span: { start: 0, end: 0 } },
  }

fn a_law(name: Bytes, key: Bytes, index: Int) -> LawInfo =
  {
    name: name,
    module: b"m",
    key: key,
    index: index,
    binders: [],
    has_guard: false,
    host: false,
    cost: false,
    footprint: [],
    at: { module: 0, span: { start: 0, end: 0 } },
  }

fn edges(pairs: List<{ name: Bytes, names: List<Bytes> }>) -> Map<Bytes, List<Bytes>> =
  fold(pairs, map_new(), |acc: Map<Bytes, List<Bytes>>, x: { name: Bytes, names: List<Bytes> }|
    map_insert(acc, x.name, x.names))

fn a_table() -> Tables =
  {
    defs: map_new(),
    own: map_new(),
    deps: edges([{ name: b"m.two", names: [b"m.one"] }, { name: b"m.three", names: [b"m.two"] }]),
    specs: map_new(),
    hashes: {
      ..no_hashes(),
      refs: {
        names: [b"m.one", b"m.two", b"m.three"],
        edges: [[], [0], [1]],
        starts: map_of_entries([
          { key: b"m.one", value: [0] },
          { key: b"m.two", value: [1] },
          { key: b"m.three", value: [2] },
        ]),
      },
    },
  }

test "what mentions a definition is what names it, and what reaches it is every closure holding it" {
  assert_eq(referrers(a_table(), b"m.one"), [b"m.two"]);
  assert_eq(referrers(a_table(), b"m.three"), []);
  // A key whose own closure holds it is not one of its own callers.
  assert_eq(reached_from(a_table(), b"m.one"), [b"m.three", b"m.two"])
}

test "a key that names no definition, test or law is a declaration and is dropped" {
  let ix: Index = {
    defs: map_new(),
    tests: map_insert(map_new(), b"m.two is two", a_test(b"two is two", b"m.two is two", 0)),
    laws: map_insert(map_new(), b"m.three", a_law(b"three is three", b"m.three", 0)),
  };
  let g = sorted_into(ix, [b"m.two is two", b"m.three", b"m.Shape"]);
  assert_eq(len(g.definitions), 0);
  assert_eq(map(g.tests, |x: TestInfo| x.name), [b"two is two"]);
  assert_eq(map(g.laws, |x: LawInfo| x.name), [b"three is three"]);
  assert_eq(summary(g), "0 definitions, 1 test, 1 law")
}

test "a group is titled, counted, and one indented line each" {
  let g: Group = { definitions: [], tests: [a_test(b"two is two", b"m.two is two", 0)], laws: [] };
  assert_eq(group_lines("mentioned by", g, []), [
    "   mentioned by: 0 definitions, 1 test, 0 laws",
    "      test \"two is two\"",
  ])
}
