// How `ply check --types` lays a signature out, and the effect-set provenance `--explain` adds.
// The width is fixed rather than the terminal's, because this output is diffed.

import compiler.types (Atom, Row, RNamed, RSingleton, Type, TyVar, TyCon, TyFn, Scheme, Printer,
                       printer_new, reserve_atoms, print_atom_list, print_row, print_scheme,
                       atom_text, atom_covers, atoms_covered, row_empty, row_closed, row_is_pure,
                       named_type)
import compiler.type_syntax (Mode, MRead, MWrite)
import compiler.infer (DefInfo)
import compiler.termination (Ends, Diverges, Site, unknown_summary)
import compiler.front (SetView)
import report (count_of)
import std.list (at_or, concat)
import std.string (pad_right, repeat)

// Counted from the terminal's left edge, so callers subtract their indent.
pub fn width() -> Int = 80

// A row as separate atoms, so no atom is ever broken across a line. `tail` is named by the same
// printer as the head it was lifted out of, so the two agree on it.
pub type RowText = { atoms: List<String>, tail: Option<String> }

// A signature split at its top-level effect row; `row` is `None` for a pure definition, which
// prints no row at all.
pub type Split = { head: String, row: Option<RowText> }

// One `effect set` as `--explain` reports it.
pub type SetLine = { name: String, atoms: List<String>, used_by: Int }

// What a definition's row was written as, and what its body actually performed. `performed` is
// `None` when it equals the declared row.
pub type Provenance = {
  aliases: List<String>,
  performed: Option<List<String>>,
  unperformed: List<String>,
}

fn trim_end(s: String) -> String / {abort.raise} =
  string_slice(
    s,
    0,
    fold(range(0, string_len(s)), string_len(s), |end: Int, _i: Int|
      if end > 0 && string_slice(s, end - 1, end) == " " { end - 1 } else { end }),
  )

// --- The split ------------------------------------------------------------------

fn whole(scheme: Scheme) -> Split / {abort.raise} =
  { head: string_of_bytes_lossy(print_scheme(printer_new(), scheme).text), row: None }

fn lifted(scheme: Scheme, params: List<Type>, ret: Type, effects: Row) -> Split / {abort.raise} = {
  // The row is printed apart from the head it was lifted out of, so the printer is told what it
  // holds before it names a label of its own.
  let reserved: Printer = reserve_atoms(printer_new(), effects.atoms);
  let head = print_scheme(reserved, {
    ty_vars: scheme.ty_vars,
    row_vars: scheme.row_vars,
    label_vars: scheme.label_vars,
    ty: TyFn({ params: params, ret: ret, effects: row_empty() }),
  });
  let listed = print_atom_list(head.printer, effects.atoms);
  let tail = match effects.tail {
    None -> None,
    Some(v) ->
      Some(string_of_bytes_lossy(print_row(listed.printer, { atoms: [], tail: Some(v) }).text)),
  };
  {
    head: string_of_bytes_lossy(head.text),
    row: Some({ atoms: map(listed.texts, string_of_bytes_lossy), tail: tail }),
  }
}

pub fn split(scheme: Scheme) -> Split / {abort.raise} =
  match scheme.ty {
    TyFn(f) -> if row_is_pure(f.effects) { whole(scheme) }
    else { lifted(scheme, f.params, f.ret, f.effects) },
    _ -> whole(scheme),
  }

// --- Placing items across lines --------------------------------------------------

type Filling = { lines: List<String>, line: String, col: Int }

// Places `items` across lines, `first` before the first line and `rest` before every other.
pub fn fill(
  first: String,
  rest: String,
  items: List<String>,
  suffix: String,
  width: Int,
) -> List<String> / {abort.raise} =
  if len(items) == 0 { [first ++ suffix] } else {
    let start = string_len(rest);
    let opened = string_len(first);
    let empty: Filling = { lines: [], line: first, col: opened };
    let out = fold(range(0, len(items)), empty, |acc: Filling, i: Int| {
      let item = match list_at(items, i) { Some(x) -> x, None -> "" };
      let last = i + 1 == len(items);
      let piece = if last { item ++ suffix } else { item ++ ", " };
      // The separator's trailing space may overflow, so an exact fit is not wrapped.
      let printed = if last { string_len(piece) } else { string_len(piece) - 1 };
      let fresh = if len(acc.lines) == 0 { opened } else { start };
      let placed: Filling = if acc.col > fresh && acc.col + printed > width {
        { lines: push(acc.lines, trim_end(acc.line)), line: rest, col: start }
      } else { acc };
      { lines: placed.lines, line: placed.line ++ piece, col: placed.col + string_len(piece) }
    });
    push(out.lines, trim_end(out.line))
  }

// `/ {a, b, c}`, wrapped, with continuations aligned inside the brace. A last atom too long to take
// the row variable beside it leaves the variable a line of its own.
fn row_lines(indent: Int, gutter: String, r: RowText) -> List<String> / {abort.raise} = {
  let room = width() - indent;
  match r.tail {
    Some(t) -> if len(r.atoms) == 0 { [gutter ++ "/ " ++ t] } else {
      let tailed = fill(gutter ++ "/ {", gutter ++ "   ", r.atoms, " | " ++ t ++ "}", room);
      if fold(tailed, true, |fits: Bool, l: String| fits && string_len(l) <= room) { tailed } else {
        push(
          fill(gutter ++ "/ {", gutter ++ "   ", r.atoms, "", room),
          gutter ++ "   | " ++ t ++ "}",
        )
      }
    },
    None -> fill(gutter ++ "/ {", gutter ++ "   ", r.atoms, "}", room),
  }
}

pub fn definition_lines(
  indent: Int,
  label_width: Int,
  label: String,
  scheme: Scheme,
) -> List<String> / {abort.raise} = split_lines(indent, label_width, label, split(scheme))

// The signature with each atom of its row, and its row variable, marked with how many times a call
// performs it: `bounded`, or `scaling` with the input.
pub fn counted_lines(
  indent: Int,
  label_width: Int,
  label: String,
  def_info: DefInfo,
  call_at: Option<String>,
) -> List<String> / {abort.raise} = {
  let sp: Split = split(def_info.scheme);
  let marked = match ((sp.row, def_info.scheme.ty)) {
    (Some(r), TyFn(f)) ->
      {
        ..sp,
        row: Some({
          atoms: map(range(0, len(r.atoms)), |i: Int|
            at_or(r.atoms, i, "") ++ " "
              ++ (match list_at(f.effects.atoms, i) {
                Some(a) -> class_of(atoms_covered(def_info.scaling, a)),
                None -> "",
              })),
          tail: match r.tail {
            Some(t) -> Some(t ++ " " ++ class_of(len(def_info.repeats) > 0)),
            None -> None,
          },
        }),
      },
    _ -> sp,
  };
  let lines = split_lines(indent, label_width, label, marked);
  // A definition that may not return says so on a line of its own, beneath its row.
  match def_info.ending {
    Diverges(d) ->
      push(
        lines,
        repeat(" ", held(label_width, label) + 3) ++ "diverges: "
          ++ why(d.through, len(d.loop) > 0, call_at),
      ),
    _ -> lines,
  }
}

// Why a definition may not return, at the call by which it may not where the source says.
// With no loop, the check stopped short of reading the whole recursion.
fn why(through: Option<Bytes>, looped: Bool, call_at: Option<String>) -> String = {
  let at_ = match call_at { Some(p) -> " at " ++ p, None -> "" };
  match through {
    None -> if looped { "its recursion" ++ at_ ++ " is not seen to descend" }
    else { "its recursion" ++ at_ ++ " is past what the check follows" },
    Some(name) ->
      "calls `" ++ string_of_bytes_lossy(name) ++ "`" ++ at_ ++ ", which may not return",
  }
}

fn class_of(scaling: Bool) -> String = if scaling { "scaling" } else { "bounded" }

fn split_lines(
  indent: Int,
  label_width: Int,
  label: String,
  sp: Split,
) -> List<String> / {abort.raise} = {
  let head = pad_right(label, label_width, " ") ++ " : " ++ sp.head;
  match sp.row {
    None -> [head],
    Some(r) -> concat([head], row_lines(indent, repeat(" ", held(label_width, label) + 3), r)),
  }
}

fn held(label_width: Int, label: String) -> Int =
  if label_width > string_len(label) { label_width } else { string_len(label) }

// --- Effect sets ------------------------------------------------------------------

fn includes_of(sets: List<SetView>, name: Bytes) -> List<Bytes> =
  fold(sets, [], |acc: List<Bytes>, s: SetView| if s.name == name { s.includes } else { acc })

fn with_name(names: List<Bytes>, name: Bytes) -> List<Bytes> =
  if fold(names, false, |acc: Bool, n: Bytes| acc || n == name) { names } else { push(names, name) }

fn one_round(sets: List<SetView>, seen: List<Bytes>) -> List<Bytes> =
  fold(seen, seen, |acc: List<Bytes>, n: Bytes|
    fold(includes_of(sets, n), acc, |a: List<Bytes>, x: Bytes| with_name(a, x)))

// Every set a row reaches, directly or through another set. A set cannot include itself, so the
// number of sets bounds the rounds.
fn reached(sets: List<SetView>, aliases: List<Bytes>) -> List<Bytes> =
  fold(range(0, len(sets) + 1), fold(aliases, [], with_name), |acc: List<Bytes>, i: Int|
    one_round(sets, acc))

fn bumped(uses: Map<Bytes, Int>, name: Bytes) -> Map<Bytes, Int> =
  match map_get(uses, name) {
    Some(k) -> map_insert(uses, name, k + 1),
    None -> map_insert(uses, name, 1),
  }

fn counted(sets: List<SetView>, defs: List<DefInfo>) -> Map<Bytes, Int> =
  fold(defs, map_new(), |acc: Map<Bytes, Int>, def_info: DefInfo|
    fold(reached(sets, def_info.row_aliases), acc, bumped))

// The sets a module declares, each with the definitions whose written row named it.
pub fn effect_sets(sets: List<SetView>, defs: List<DefInfo>) -> List<SetLine> / {abort.raise} = {
  let uses = counted(sets, defs);
  map(sets, |s: SetView|
    {
      name: string_of_bytes_lossy(s.name),
      atoms: map(s.atoms, |a: Atom| string_of_bytes_lossy(atom_text(a))),
      used_by: match map_get(uses, s.name) { Some(k) -> k, None -> 0 },
    })
}

pub fn set_lines(v: SetLine, indent: Int) -> List<String> / {abort.raise} =
  concat(
    concat(["effect set " ++ v.name], fill("  = {", "     ", v.atoms, "}", width() - indent)),
    ["  used by " ++ count_of(v.used_by, "definition")],
  )

// --- Provenance --------------------------------------------------------------------

fn performs(performed: List<Atom>, declared: Atom) -> Bool =
  fold(performed, false, |acc: Bool, p: Atom| acc || atom_covers(declared, p))

pub fn provenance(def_info: DefInfo) -> Provenance / {abort.raise} = {
  // Declared atoms covering nothing the body performed.
  let undone = filter(def_info.footprint, |a: Atom| !performs(def_info.performed, a));
  let unperformed = map(print_atom_list(printer_new(), undone).texts, string_of_bytes_lossy);
  let performed: Option<List<String>> = if len(unperformed) == 0 { None } else {
    Some(map(print_atom_list(printer_new(), def_info.performed).texts, string_of_bytes_lossy))
  };
  {
    aliases: map(def_info.row_aliases, string_of_bytes_lossy),
    performed: performed,
    unperformed: unperformed,
  }
}

pub fn is_bare(p: Provenance) -> Bool =
  len(p.aliases) == 0 && (match p.performed { None -> true, Some(_) -> false })

pub fn provenance_lines(p: Provenance, indent: Int) -> List<String> / {abort.raise} = {
  let room = width() - indent;
  let written = if len(p.aliases) == 0 { [] }
  else { fill("  written as     / {", "                     ", p.aliases, "}", room) };
  let performed = match p.performed {
    None -> written,
    Some(atoms) ->
      concat(written, fill("  body performs  {", "                  ", atoms, "}", room)),
  };
  if len(p.unperformed) == 0 { performed }
  else { concat(performed, fill("  declared, not performed: ", "    ", p.unperformed, "", room)) }
}

// Each atom's text, a label variable named against the rest, so `[l]` means one thing among them.
pub fn atom_texts(atoms: List<Atom>) -> List<String> / {abort.raise} =
  map(print_atom_list(printer_new(), atoms).texts, string_of_bytes_lossy)

// --- Tests ------------------------------------------------------------------

fn fn_scheme(effects: Row, row_vars: List<Int>) -> Scheme =
  {
    ty_vars: [],
    row_vars: row_vars,
    label_vars: [],
    ty: TyFn({ params: [named_type(b"Request")], ret: named_type(b"Response"), effects: effects }),
  }

fn named(eff: Bytes, mode: Mode, resource: Option<Bytes>) -> Atom =
  {
    effect: eff,
    mode: mode,
    op: None,
    resource: match resource { Some(r) -> RNamed(r), None -> RSingleton },
  }

test "a pure definition prints no row at all" {
  assert_eq(definition_lines(5, 12, "endpoint_of", fn_scheme(row_empty(), [])), [
    "endpoint_of  : (Request) -> Response",
  ])
}

// Wrapped at a fixed column, with the atoms hanging under the first rather than run off the edge.
test "a long row wraps inside the brace and aligns" {
  let row = row_closed([
    named(b"db", MRead, Some(b"inventory")),
    named(b"db", MRead, Some(b"orders")),
    named(b"db", MRead, Some(b"users")),
    named(b"db", MWrite, Some(b"orders")),
    named(b"http", MWrite, Some(b"outbound")),
    named(b"log", MWrite, None),
  ]);
  assert_eq(definition_lines(5, 12, "create_order", fn_scheme(row, [])), [
    "create_order : (Request) -> Response",
    "               / {db.read[inventory], db.read[orders], db.write[orders],",
    "                  db.read[users], http.write[outbound], log.write}",
  ])
}

// A row variable is named once, by one printer, so the quantifier and the row cannot drift apart.
test "a row variable survives the split with one name" {
  let row: Row = { atoms: [named(b"net", MWrite, Some(b"conn"))], tail: Some(3) };
  assert_eq(definition_lines(5, 4, "serve", fn_scheme(row, [3])), [
    "serve : <| e>(Request) -> Response",
    "        / {net.write[conn] | e}",
  ]);
  assert_eq(definition_lines(5, 3, "run", fn_scheme({ atoms: [], tail: Some(0) }, [0])), [
    "run : <| e>(Request) -> Response",
    "      / e",
  ])
}

test "a type variable keeps its letter across the split" {
  let sc: Scheme = {
    ty_vars: [1],
    row_vars: [2],
    label_vars: [],
    ty: TyFn({
      params: [TyVar(1)],
      ret: TyVar(1),
      effects: { atoms: [named(b"log", MWrite, None)], tail: Some(2) },
    }),
  };
  assert_eq(definition_lines(5, 2, "id", sc), ["id : <a | e>(a) -> a", "     / {log.write | e}"])
}

fn counted_def(row: Row, scaling: List<Atom>, repeats: List<Int>) -> DefInfo =
  {
    ..def_of([], row.atoms, row.atoms),
    scheme: fn_scheme(row, match row.tail { Some(v) -> [v], None -> [] }),
    scaling: scaling,
    repeats: repeats,
  }

test "each atom and the row variable print with how many times a call performs them" {
  let query = named(b"db", MRead, Some(b"orders"));
  let log = named(b"log", MWrite, None);
  let row: Row = { atoms: [query, log], tail: Some(3) };
  assert_eq(counted_lines(5, 4, "find", counted_def(row, [query], [0]), None), [
    "find : <| e>(Request) -> Response",
    "       / {db.read[orders] scaling, log.write bounded | e scaling}",
  ]);
  assert_eq(counted_lines(5, 4, "find", counted_def(row, [], []), None), [
    "find : <| e>(Request) -> Response",
    "       / {db.read[orders] bounded, log.write bounded | e bounded}",
  ])
}

// The variable is glued to the last atom unless that runs past the column, where it takes a line.
test "a row variable too wide to sit beside the last atom takes a line of its own" {
  let long = named(b"a_very_long_effect_name_that_fills_a_line", MWrite, Some(b"a_long_label"));
  let row: Row = { atoms: [long], tail: Some(3) };
  assert_eq(counted_lines(5, 4, "wide", counted_def(row, [long], [0]), None), [
    "wide : <| e>(Request) -> Response",
    "       / {a_very_long_effect_name_that_fills_a_line.write[a_long_label] scaling",
    "          | e scaling}",
  ])
}

fn spot(caller: Bytes) -> Site = { caller: caller, span: { start: 4, end: 9 } }

test "a definition that may not return says by which call, and where" {
  let pure: Row = { atoms: [], tail: None };
  let looping = {
    ..counted_def(pure, [], []),
    ending: Diverges({ at: spot(b"m.spin"), through: None, loop: [spot(b"m.spin")] }),
  };
  let calling = {
    ..counted_def(pure, [], []),
    ending: Diverges({ at: spot(b"m.wait"), through: Some(b"m.spin"), loop: [] }),
  };
  assert_eq(counted_lines(5, 4, "spin", looping, Some("m.ply:3:5")), [
    "spin : (Request) -> Response",
    "       diverges: its recursion at m.ply:3:5 is not seen to descend",
  ]);
  assert_eq(counted_lines(5, 4, "wait", calling, Some("m.ply:7:3")), [
    "wait : (Request) -> Response",
    "       diverges: calls `m.spin` at m.ply:7:3, which may not return",
  ]);
  assert_eq(counted_lines(5, 4, "wait", calling, None), [
    "wait : (Request) -> Response",
    "       diverges: calls `m.spin`, which may not return",
  ]);
  let unread = {
    ..counted_def(pure, [], []),
    ending: Diverges({ at: spot(b"m.wide"), through: None, loop: [] }),
  };
  assert_eq(counted_lines(5, 4, "wide", unread, Some("m.ply:3:5")), [
    "wide : (Request) -> Response",
    "       diverges: its recursion at m.ply:3:5 is past what the check follows",
  ])
}

test "filling never splits an item, even when one item is too wide" {
  let wide = fold(range(0, 90), "", |acc: String, i: Int| acc ++ "a");
  assert_eq(fill("[", " ", [wide, "b"], "]", 20), ["[" ++ wide ++ ",", " b]"]);
  assert_eq(fill("= {", "   ", [], "}", 40), ["= {}"])
}

test "the set block names the set and spells out its expansion" {
  let view: SetLine = {
    name: "Web",
    used_by: 4,
    atoms: [
      "db.read[inventory]",
      "db.read[orders]",
      "db.read[users]",
      "db.write[orders]",
      "http.write[outbound]",
      "log.write",
    ],
  };
  assert_eq(set_lines(view, 5), [
    "effect set Web",
    "  = {db.read[inventory], db.read[orders], db.read[users], db.write[orders],",
    "     http.write[outbound], log.write}",
    "  used by 4 definitions",
  ]);
  assert_eq(set_lines({ name: "Web", atoms: ["log.write"], used_by: 1 }, 5), [
    "effect set Web",
    "  = {log.write}",
    "  used by 1 definition",
  ])
}

fn def_of(aliases: List<Bytes>, declared: List<Atom>, performed: List<Atom>) -> DefInfo =
  {
    name: b"m.create_order",
    module: b"m",
    simple_name: b"create_order",
    scheme: fn_scheme(row_empty(), []),
    footprint: declared,
    performed: performed,
    scaling: [],
    repeats: [],
    bounded: [],
    tail_bounded: false,
    ending: Ends,
    summary: unknown_summary(),
    row_aliases: aliases,
    constraints: [],
    spec: [],
    at: { module: 0, span: { start: 0, end: 0 } },
  }

test "provenance names the alias and the difference the alias hides" {
  let p = provenance(
    def_of(
      [b"Web"],
      [
        named(b"db", MRead, Some(b"orders")),
        named(b"db", MRead, Some(b"users")),
        named(b"log", MWrite, None),
      ],
      [named(b"db", MRead, Some(b"users")), named(b"log", MWrite, None)],
    ),
  );
  assert_eq(provenance_lines(p, 5), [
    "  written as     / {Web}",
    "  body performs  {db.read[users], log.write}",
    "  declared, not performed: db.read[orders]",
  ])
}

test "an alias the body uses completely reports only how it was written" {
  let exact = [named(b"log", MWrite, None)];
  let p = provenance(def_of([b"Web"], exact, exact));
  assert_eq(provenance_lines(p, 5), ["  written as     / {Web}"]);
  assert_eq(p.unperformed, []);
  let bare = provenance(def_of([], [], []));
  assert(is_bare(bare));
  assert_eq(provenance_lines(bare, 5), [])
}

test "a written row wider than its body is reported without any alias" {
  let p = provenance(
    def_of([], [named(b"db", MRead, Some(b"orders")), named(b"log", MWrite, None)], [
      named(b"log", MWrite, None),
    ]),
  );
  assert_eq(provenance_lines(p, 5), [
    "  body performs  {log.write}",
    "  declared, not performed: db.read[orders]",
  ])
}

test "a set is used by every definition that reaches it, through another set or not" {
  let reads: SetView = {
    name: b"Reads",
    includes: [],
    atoms: [named(b"m.store", MRead, Some(b"orders"))],
  };
  let web: SetView = {
    name: b"Web",
    includes: [b"Reads"],
    atoms: [named(b"m.store", MRead, Some(b"orders")), named(b"m.store", MWrite, Some(b"orders"))],
  };
  let unused: SetView = { name: b"Unused", includes: [], atoms: [] };
  let lines = effect_sets([reads, web, unused], [
    def_of([b"Reads"], [], []),
    def_of([b"Web"], [], []),
  ]);
  assert_eq(map(lines, |l: SetLine| l.name), ["Reads", "Web", "Unused"]);
  assert_eq(map(lines, |l: SetLine| l.used_by), [2, 1, 0]);
  assert_eq(match list_at(lines, 1) { Some(l) -> l.atoms, None -> [] }, [
    "m.store.read[orders]",
    "m.store.write[orders]",
  ])
}
