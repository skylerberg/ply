// The program a command answers about: the files a path names, the shipped modules they pulled off
// the shelf, and every table the front end holds for them. One load per invocation, as the Rust
// driver did one.

import std.fs (fs)
import std.time (time)
import compiler.front (Refused, Analysed, Whole, Pulled, analyse_pulling_std_with, module_items,
                       module_imports)
import compiler.pkg (Pkgs, Supplied)
import compiler.hash (HashOutput, hex)
import compiler.items (Item, IFn)
import compiler.infer (DefInfo, Loc)
import compiler.resolve (Source, Mod, Diag, Label, diag1, qualify)
import compiler.tycore (TyCon, TyFn)
import diagnostic (Place, spot_of)
import paths
import sources (File, Project, DepPackage, load, load_resolved, shelf, nothing_here, is_std,
                is_compiler)

// `whole` is `None` exactly when `diags` holds an error: a stage that reported stopped the rest.
pub type Program = {
  files: List<File>,
  places: List<Place>,
  diags: List<Diag>,
  whole: Option<Whole>,
}

pub type ModuleView = { name: String, path: String }

// A module as `ply check` reports it: what it declares and what it imports, beside its place.
// `index` is the one a label's module points into.
pub type ModuleFacts = {
  index: Int,
  name: String,
  path: String,
  imports: List<String>,
  items: List<String>,
}

// A load with the clock read between its two halves, for the command that reports where the time went.
pub type Timed = { program: Program, read_ms: Int, front_ms: Int }

// --- Where a shipped module's text is said to live ------------------------------

fn joined(segments: List<String>, sep: String) -> String =
  fold(range(0, len(segments)), "", |acc: String, i: Int|
    match list_at(segments, i) { Some(s) -> if i == 0 { s } else { acc ++ sep ++ s }, None -> acc })

fn without_first(segments: List<String>) -> List<String> =
  fold(range(1, len(segments)), [], |acc: List<String>, i: Int|
    match list_at(segments, i) { Some(s) -> push(acc, s), None -> acc })

// `std.json` is `<std>/json.ply`, as the cache keys it and as a rendered span names it.
pub fn pseudo_path(name: String) -> String = {
  let segments = string_split(name, ".");
  match list_at(segments, 0) {
    None -> name,
    Some(root) -> "<" ++ root ++ ">/" ++ joined(without_first(segments), "/") ++ ".ply",
  }
}

fn shelf_place(texts: Map<String, Bytes>, name: String) -> Place =
  { path: pseudo_path(name), text: match map_get(texts, name) { Some(t) -> t, None -> b"" } }

fn appended<a>(head: List<a>, tail: List<a>) -> List<a> =
  fold(tail, head, |acc: List<a>, x: a| push(acc, x))

// --- Loading --------------------------------------------------------------------

fn broken(project: Project, places: List<Place>, diags: List<Diag>) -> Program =
  { files: project.files, places: places, diags: diags, whole: None }

fn own_places(project: Project) -> List<Place> =
  map(project.files, |f: File| { path: f.path, text: f.text })

fn supplied(project: Project) -> List<Supplied> =
  map(project.packages, |p: DepPackage|
    {
      root: bytes_of_string(p.root),
      manifest: p.manifest,
      modules: map(p.files, |f: File| { name: bytes_of_string(f.module), src: f.text }),
    })

fn dep_places(project: Project) -> List<Place> =
  fold(project.packages, [], |acc: List<Place>, p: DepPackage|
    fold(p.files, acc, |acc2: List<Place>, f: File| push(acc2, { path: f.path, text: f.text })))

// Manifest places in slot order: the root's first, then each dependency's in walk order.
fn manifest_places(project: Project) -> List<Place> = {
  let deps = fold(project.packages, [], |acc: List<Place>, p: DepPackage|
    match p.manifest {
      None -> acc,
      Some(text) -> push(acc, { path: p.root ++ "/ply.pkg", text: text }),
    });
  match project.manifest {
    None -> deps,
    Some(f) -> {
      let root: List<Place> = [{ path: f.path, text: f.text }];
      fold(deps, root, |acc: List<Place>, pl: Place| push(acc, pl))
    },
  }
}

fn analysed(project: Project, shelved: List<Source>) -> Program = {
  let texts = fold(shelved, map_new(), |acc: Map<String, Bytes>, s: Source|
    map_insert(acc, string_of_bytes_lossy(s.name), s.src));
  let pkgs: Pkgs = {
    root: bytes_of_string(project.root_key),
    manifest: match project.manifest { None -> None, Some(f) -> Some(f.text) },
    supplied: supplied(project),
  };
  let pulled: Pulled = analyse_pulling_std_with(project.sources, shelved, [], [], pkgs);
  let shelved_places = map(pulled.pulled, |n: Bytes| shelf_place(texts, string_of_bytes_lossy(n)));
  let places = appended(
    appended(appended(own_places(project), dep_places(project)), shelved_places),
    manifest_places(project),
  );
  match pulled.out {
    Refused(ds) -> broken(project, places, ds),
    Analysed(w) -> { files: project.files, places: places, diags: w.warnings, whole: Some(w) },
  }
}

// A project worth pulling a shelf for: one the walk read whole and that holds at least one module.
fn usable(project: Project) -> Bool = len(project.diags) == 0 && len(project.sources) > 0

fn assembled(project: Project, shelved: List<Source>, paths: List<paths::Resolved>) -> Program =
  if len(project.diags) > 0 { broken(project, own_places(project), project.diags) } else if len(
        project.sources,
      )
      == 0 {
    broken(project, [], [
      nothing_here(match list_at(paths, 0) { Some(r) -> r.display, None -> "." }),
    ])
  } else { analysed(project, shelved) }

pub fn load_program(
  paths: List<paths::Resolved>,
) -> Program / {fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shelf], fs.read_file[shelf]} = {
  let project: Project = load_resolved(paths);
  let shelved: List<Source> = if usable(project) { shelf() } else { [] };
  assembled(project, shelved, paths)
}

// The same load, with the readings a `--explain` run prints: what the walk and the shelf cost, and
// what the front end cost over them.
pub fn timed_load(
  paths: List<paths::Resolved>,
) -> Timed / {fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shelf], fs.read_file[shelf], time.elapsed_ms} = {
  let started = time.elapsed_ms();
  let project: Project = load_resolved(paths);
  let shelved: List<Source> = if usable(project) { shelf() } else { [] };
  let read_done = time.elapsed_ms();
  let p: Program = assembled(project, shelved, paths);
  { program: p, read_ms: read_done - started, front_ms: time.elapsed_ms() - read_done }
}

// --- Reading the tables ----------------------------------------------------------

pub fn modules_of(p: Program, w: Whole) -> List<ModuleView> =
  map(range(0, len(w.mods)), |i: Int|
    {
      name: match list_at(w.mods, i) { Some(mo) -> string_of_bytes_lossy(mo.name), None -> "" },
      path: match list_at(p.places, i) { Some(place) -> place.path, None -> "" },
    })

fn texts(bs: List<Bytes>) -> List<String> = map(bs, |b: Bytes| string_of_bytes_lossy(b))

pub fn module_facts(p: Program, w: Whole) -> List<ModuleFacts> =
  map(range(0, len(w.mods)), |i: Int|
    match list_at(w.mods, i) {
      None -> { index: i, name: "", path: "", imports: [], items: [] },
      Some(mo) ->
        {
          index: i,
          name: string_of_bytes_lossy(mo.name),
          path: match list_at(p.places, i) { Some(place) -> place.path, None -> "" },
          imports: texts(module_imports(mo)),
          items: texts(module_items(mo)),
        },
    })

// The modules as the front end took them: the project's own files first, then the shelf it pulled,
// in the order the label indices count.
pub fn sourced(p: Program, w: Whole) -> List<Source> =
  map(range(0, len(w.mods)), |i: Int|
    {
      name: match list_at(w.mods, i) { Some(mo) -> mo.name, None -> b"" },
      src: match list_at(p.places, i) { Some(place) -> place.text, None -> b"" },
    })

fn first_primary(labels: List<Label>) -> Option<Label> =
  fold(labels, None, |acc: Option<Label>, l: Label|
    match acc { Some(_) -> acc, None -> if l.primary { Some(l) } else { None } })

// A diagnostic raised inside a module the project did not write, which is the shelf's business.
pub fn is_shelved(p: Program, d: Diag) -> Bool =
  match first_primary(d.labels) { Some(l) -> l.module >= len(p.files), None -> false }

// The module index a span outside every module carries.
pub fn outside() -> Int = 4294967295

pub fn place_of(p: Program, at: Loc) -> Option<Place> =
  if at.module == outside() { None } else { list_at(p.places, at.module) }

// `path:line:col`, one-based, as every other command prints a place.
pub fn location_of(p: Program, at: Loc) -> Option<String> =
  match place_of(p, at) {
    None -> None,
    Some(place) -> {
      let spot = spot_of(place.text, at.span.start);
      Some(place.path ++ ":" ++ int_to_string(spot.line) ++ ":" ++ int_to_string(spot.col))
    },
  }

type Picking = { seen: Map<Bytes, Bool>, out: List<DefInfo> }

fn pick(acc: Picking, by_name: Map<Bytes, DefInfo>, name: Bytes) -> Picking =
  match map_get(acc.seen, name) {
    Some(_) -> acc,
    None -> match map_get(by_name, name) {
      None -> acc,
      Some(d) -> { seen: map_insert(acc.seen, name, true), out: push(acc.out, d) },
    },
  }

fn module_fns(acc: List<Bytes>, mo: Mod) -> List<Bytes> =
  fold(mo.module.items, acc, |a: List<Bytes>, it: Item|
    match it { IFn(d) -> push(a, qualify(mo.name, d.name.name)), _ -> a })

// Every definition in the order its file declares it, module by module, as `ply defs` lists them
// and as the driver's `published_order` orders them; anything the tree does not name follows.
pub fn published(w: Whole) -> List<DefInfo> = {
  let by_name = fold(w.checked.defs, map_new(), |acc: Map<Bytes, DefInfo>, d: DefInfo|
    map_insert(acc, d.name, d));
  let named = fold(w.mods, [], |acc: List<Bytes>, mo: Mod| module_fns(acc, mo));
  let first: Picking = fold(named, { seen: map_new(), out: [] }, |acc: Picking, name: Bytes|
    pick(acc, by_name, name));
  let all: Picking = fold(w.checked.defs, first, |acc: Picking, d: DefInfo|
    pick(acc, by_name, d.name));
  all.out
}

// --- Naming one definition --------------------------------------------------------

// The definition a query names: a program-wide name, or a simple name that names exactly one.
// `Err` holds the program-wide names a simple name matched, and is empty when nothing matched.
pub fn resolve_def(defs: List<DefInfo>, query: String) -> Result<DefInfo, List<String>> = {
  let exact = fold(defs, None, |acc: Option<DefInfo>, d: DefInfo|
    match acc {
      Some(_) -> acc,
      None -> if string_of_bytes_lossy(d.name) == query { Some(d) } else { None },
    });
  match exact {
    Some(d) -> Ok(d),
    None -> {
      let matching = filter(defs, |d: DefInfo| string_of_bytes_lossy(d.simple_name) == query);
      match list_at(matching, 0) {
        None -> Err([]),
        Some(d) -> if len(matching) == 1 { Ok(d) }
        else { Err(map(matching, |x: DefInfo| string_of_bytes_lossy(x.name))) },
      }
    },
  }
}

// What [`resolve_def`] refused, as a diagnostic: nothing of that name, or more than one.
pub fn unknown_def(query: String, names: List<String>) -> Diag =
  if len(names) == 0 {
    diag1(
      b"E0101",
      outside(),
      { start: 0, end: 0 },
      bytes_of_string("no definition is named `" ++ query ++ "`"),
      b"not a definition of this program",
      [
        b"the query is a program-wide name such as `store.orders.place`, or a simple name unique in the program",
      ],
    )
  } else {
    diag1(
      b"E0101",
      outside(),
      { start: 0, end: 0 },
      bytes_of_string("`" ++ query ++ "` names " ++ int_to_string(len(names)) ++ " definitions"),
      b"say which",
      [bytes_of_string("one of: " ++ joined(names, ", "))],
    )
  }

// One more note under a diagnostic, counted as the constructor counts them.
pub fn noted(d: Diag, note: Bytes) -> Diag =
  { ..d, notes: d.notes + 1, notes_text: push(d.notes_text, note) }

// The hash tables the dump writes as lists, indexed once so a lookup is not a scan.
pub type Tables = {
  defs: Map<Bytes, Bytes>,
  own: Map<Bytes, Bytes>,
  deps: Map<Bytes, List<Bytes>>,
  closure: Map<Bytes, List<Bytes>>,
  specs: Map<Bytes, Int>,
}

pub fn tables_of(h: HashOutput) -> Tables =
  {
    defs: fold(h.defs, map_new(), |acc: Map<Bytes, Bytes>, x: { name: Bytes, hash: Bytes }|
      map_insert(acc, x.name, x.hash)),
    own: fold(h.own, map_new(), |acc: Map<Bytes, Bytes>, x: { name: Bytes, hash: Bytes }|
      map_insert(acc, x.name, x.hash)),
    deps: fold(
      h.deps,
      map_new(),
      |acc: Map<Bytes, List<Bytes>>, x: { name: Bytes, names: List<Bytes> }|
        map_insert(acc, x.name, x.names),
    ),
    closure: fold(
      h.closure,
      map_new(),
      |acc: Map<Bytes, List<Bytes>>, x: { name: Bytes, names: Map<Bytes, Bool> }|
        map_insert(
          acc,
          x.name,
          map_fold(x.names, [], |ns: List<Bytes>, k: Bytes, v: Bool| push(ns, k)),
        ),
    ),
    specs: fold(
      h.specs,
      map_new(),
      |acc: Map<Bytes, Int>, x: { name: Bytes, hashes: List<Bytes> }|
        map_insert(acc, x.name, len(x.hashes)),
    ),
  }

// A definition's hash as `ply hash` prints it: sixty-four hex characters, or nothing when the
// program declares the name without hashing a body for it.
pub fn hash_of(t: Tables, name: Bytes) -> Option<String> =
  match map_get(t.defs, name) { Some(h) -> Some(string_of_bytes_lossy(hex(h))), None -> None }

pub fn own_of(t: Tables, name: Bytes) -> Option<String> =
  match map_get(t.own, name) { Some(h) -> Some(string_of_bytes_lossy(hex(h))), None -> None }

pub fn deps_of(t: Tables, name: Bytes) -> List<String> =
  match map_get(t.deps, name) {
    Some(ns) -> map(ns, |n: Bytes| string_of_bytes_lossy(n)),
    None -> [],
  }

pub fn closure_of(t: Tables, name: Bytes) -> List<String> =
  match map_get(t.closure, name) {
    Some(ns) -> map(ns, |n: Bytes| string_of_bytes_lossy(n)),
    None -> [],
  }

pub fn specs_of(t: Tables, name: Bytes) -> Int =
  match map_get(t.specs, name) { Some(n) -> n, None -> 0 }

pub fn short_of(hex_text: String) -> String = string_slice(hex_text, 0, 12)

pub fn is_shipped(module: String) -> Bool = is_std(module) || is_compiler(module)

// --- Tests ------------------------------------------------------------------

test "a shipped module's text is said to live under its root, outside the identifier space" {
  assert_eq(pseudo_path("std.json"), "<std>/json.ply");
  assert_eq(pseudo_path("std.http.server"), "<std>/http/server.ply");
  assert_eq(pseudo_path("compiler.fmt"), "<compiler>/fmt.ply")
}

test "a shipped module is one under a reserved root and nothing else" {
  assert(is_shipped("std"));
  assert(is_shipped("std.json"));
  assert(is_shipped("compiler.front"));
  assert(!is_shipped("standard"));
  assert(!is_shipped("m"))
}

fn named(name: Bytes, simple: Bytes) -> DefInfo =
  {
    name: name,
    module: b"m",
    simple_name: simple,
    scheme: {
      ty_vars: [],
      row_vars: [],
      label_vars: [],
      ty: TyFn({
        params: [],
        ret: TyCon({ name: b"Int", args: [] }),
        effects: { atoms: [], tail: None },
      }),
    },
    footprint: [],
    performed: [],
    row_aliases: [],
    constraints: [],
    spec: [],
    internally_effectful: false,
    at: { module: 0, span: { start: 0, end: 0 } },
  }

test "a query is a program-wide name, or a simple name that names exactly one definition" {
  let defs = [named(b"a.total", b"total"), named(b"b.total", b"total"), named(b"a.one", b"one")];
  assert_eq(match resolve_def(defs, "a.total") { Ok(d) -> d.name, Err(_) -> b"" }, b"a.total");
  assert_eq(match resolve_def(defs, "one") { Ok(d) -> d.name, Err(_) -> b"" }, b"a.one");
  assert_eq(match resolve_def(defs, "total") { Ok(_) -> [], Err(ns) -> ns }, [
    "a.total",
    "b.total",
  ]);
  assert_eq(match resolve_def(defs, "absent") { Ok(_) -> ["found"], Err(ns) -> ns }, [])
}

test "a name nothing declares is `E0101`, and an ambiguous one says which" {
  assert_eq(unknown_def("absent", []).code, b"E0101");
  assert_eq(unknown_def("absent", []).message, b"no definition is named `absent`");
  let many = unknown_def("total", ["a.total", "b.total"]);
  assert_eq(many.message, b"`total` names 2 definitions");
  assert_eq(many.notes_text, [b"one of: a.total, b.total"]);
  assert_eq(noted(many, b"and one more").notes, 2)
}

test "a span outside every module has no place and no location" {
  let p: Program = {
    files: [],
    places: [{ path: "m.ply", text: b"fn f() -> Int = 1\n" }],
    diags: [],
    whole: None,
  };
  assert_eq(location_of(p, { module: 4294967295, span: { start: 0, end: 0 } }), None);
  assert_eq(location_of(p, { module: 0, span: { start: 3, end: 4 } }), Some("m.ply:1:4"))
}
