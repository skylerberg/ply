//! The program a command answers about: the files a path names, the shipped modules they pulled off
//! the shipped modules, and every table the front end holds for them. One load per invocation. A
//! load reads the front-end cache before it analyses and files the answer after, so a run checks
//! what moved since the last one and takes the rest from its rows.

import compiler.load (LoadedAnalysis)
import std.fs (fs)
import std.time (time)
import compiler.front (Refused, Analysed, Analysis, Pulled, Rows, DefInterface, Shipping,
                       analyse_pulling_std_with, dump_of, embeds_now, filing, module_items,
                       module_imports, no_rows, pins_pulling, rows_of)
import compiler.pkg (PackageSources, Pinned, Supplied)
import compiler.interface (CompiledPackage, CompiledModule, Original, merged_interfaces)
import interfaces
import compiler.hash
import compiler.hash (HashOutput, Prior, hex)
import std.hash (blake3)
import compiler.items (Item, IFn)
import compiler.infer (DefInfo, TestInfo, LawInfo, Location)
import compiler.embed (EmbedReader)
import compiler.termination (Ends, unknown_summary)
import compiler.resolve (Source, ParsedModule, Diag, Label, error_at, qualify)
import compiler.types (TyCon, TyFn)
import diagnostic (Place, spot_of)
import paths
import proof.statics (Unshown, unshown)
import proof.world (measures_in)
import sources (File, Project, DepPackage, Embed, load_resolved, shipping_for, no_shipping,
                shipped_listed, nothing_here, is_std, is_compiler)
import store.tables (Stamps)
import builder (builder)
import loads
import loads (Sources, SourceFile, SourcePackage, Recorded, StdlibMoved, ShippedEntry)
import std.random (entropy)
import std.list (concat)
import std.string (join)
import compiler.parsing (no_module)

/// `whole` is `None` exactly when `diags` holds an error: a stage that reported stopped the rest.
/// `cache_warnings` is what the front-end cache said of itself, which a run that never read the cache
/// has no part of; `diags` is the program's own.
/// `pkgs` and `through` are kept so a re-analysis (`ply replace`, a mutant) reads what the load did.
pub type Program = {
  files: List<File>,
  places: List<Place>,
  diags: List<Diag>,
  cache_warnings: List<Diag>,
  whole: Option<Analysis>,
  pkgs: PackageSources,
  through: List<CompiledPackage>,
  embeds: List<Embed>,
  /// The shipped modules the load read, which a splice of it pulls again.
  shipping: Shipping,
  /// Whether a shipped module was read only for what the program reaches, rather than whole.
  reached: Bool,
}

/// Every diagnostic a load reports: what the front-end cache said of itself, then the program's.
pub fn load_diagnostics(program: Program) -> List<Diag> =
  concat(program.cache_warnings, program.diags)

pub type ModuleView = { name: String, path: String }

/// A module as `ply check` reports it: what it declares and what it imports, beside its place.
/// `index` is the one a label's module points into.
pub type ModuleFacts = {
  index: Int,
  name: String,
  path: String,
  imports: List<String>,
  items: List<String>,
}

/// A load with the clock read between its phases, for the command that reports where the time went:
/// the walk, the shipped modules and the cache read; the front end; and filing its answer. `cached`
/// says whether the load read and filed the front-end cache at all.
pub type Timed = { program: Program, read_ms: Int, front_ms: Int, file_ms: Int, cached: Bool }

// --- Where a shipped module's text is said to live ------------------------------

fn without_first(segments: List<String>) -> List<String> =
  fold(range(1, len(segments)), [], |acc: List<String>, i: Int|
    match list_at(segments, i) { Some(s) -> push(acc, s), None -> acc })

/// `std.json` is `<std>/json.ply`, as the cache keys it and as a rendered span names it.
pub fn pseudo_path(name: String) -> String / {abort.raise} = {
  let segments = string_split(name, ".");
  match list_at(segments, 0) {
    None -> name,
    Some(root) -> "<" ++ root ++ ">/" ++ join(without_first(segments), "/") ++ ".ply",
  }
}

fn shipped_place(texts: Map<String, Bytes>, name: String) -> Place / {abort.raise} =
  { path: pseudo_path(name), text: match map_get(texts, name) { Some(t) -> t, None -> b"" } }

// --- Loading --------------------------------------------------------------------

fn broken(project: Project, shipping: Shipping, places: List<Place>, diags: List<Diag>) -> Program =
  {
    files: project.files,
    places: places,
    diags: diags,
    cache_warnings: [],
    whole: None,
    pkgs: pkgs_of(project),
    through: [],
    embeds: project.embeds,
    shipping: shipping,
    reached: true,
  }

/// What a load of this project is made of: its root key and manifest text, and every dependency
/// the walk read. The front end takes this as its package closure.
pub fn pkgs_of(project: Project) -> PackageSources =
  {
    root: bytes_of_string(project.root_key),
    manifest: match project.manifest { None -> None, Some(f) -> Some(f.text) },
    supplied: supplied(project),
  }

fn own_places(project: Project) -> List<Place> =
  map(project.files, |file: File| { path: file.path, text: file.text })

fn supplied(project: Project) -> List<Supplied> =
  map(project.packages, |package: DepPackage|
    {
      root: bytes_of_string(package.root),
      manifest: package.manifest,
      modules: map(package.files, |file: File|
        { name: bytes_of_string(file.module), src: file.text }),
    })

fn dep_places(project: Project) -> List<Place> =
  fold(project.packages, [], |acc: List<Place>, package: DepPackage|
    fold(package.files, acc, |places: List<Place>, file: File|
      push(places, { path: file.path, text: file.text })))

/// Manifest places in slot order: the root's first, then each dependency's in walk order.
fn manifest_places(project: Project) -> List<Place> = {
  let deps = fold(project.packages, [], |acc: List<Place>, package: DepPackage|
    match package.manifest {
      None -> acc,
      Some(text) -> push(acc, { path: package.root ++ "/ply.pkg", text: text }),
    });
  match project.manifest {
    None -> deps,
    Some(f) -> {
      let root: List<Place> = [{ path: f.path, text: f.text }];
      fold(deps, root, |acc: List<Place>, place: Place| push(acc, place))
    },
  }
}

/// A walk's own places, in the order a front end places them: the root's modules and then each
/// dependency's, and the manifests, which follow whatever it pulls from the shipped modules.
pub type Placed = { modules: List<Place>, manifests: List<Place> }

pub fn placed_of(project: Project) -> Placed =
  { modules: concat(own_places(project), dep_places(project)), manifests: manifest_places(project) }

/// A covered module parses from its stub; its place keeps the source the emitter reads.
fn front_end(
  sources: List<Source>,
  shipping: Shipping,
  rows: Rows,
  pkgs: PackageSources,
  through: List<CompiledPackage>,
  embeds: List<Embed>,
  priors: List<Prior>,
  reached: Bool,
) -> Pulled / {abort.raise} =
  analyse_pulling_std_with(
    sources,
    shipping.read,
    rows.defs,
    rows.tests,
    pkgs,
    merged_interfaces(through),
    map(embeds, |embed: Embed| embed.embedded),
    priors,
    unread: shipping.unread,
    reached: reached,
  )

/// Seeded with what the load published, so only what the splice moved is walked again.
pub fn reanalysed(
  program: Program,
  analysis: Analysis,
  sources: List<Source>,
  pkgs: PackageSources,
) -> Pulled / {abort.raise} =
  front_end(
    sources,
    program.shipping,
    rows_of(analysis),
    pkgs,
    program.through,
    program.embeds,
    analysis.hashes.priors,
    program.reached,
  )

fn analysed(
  project: Project,
  shipping: Shipping,
  rows: Rows,
  through: List<CompiledPackage>,
  priors: List<Prior>,
  mine: interfaces::Own,
  reached: Bool,
) -> Program / {abort.raise} = {
  let first = analysed_through(project, shipping, rows, through, priors, mine, reached);
  if !first.starved { first.program } else {
    analysed_through(
      project,
      shipping,
      rows,
      through,
      priors,
      interfaces::no_own(),
      reached,
    ).program
  }
}

/// A load read through `mine`, the stubs of the project's own modules. It is `starved` where a
/// module it read from source states a measure: the proof of one reads the bodies of what its
/// module imports, and a stub has none.
type Loaded = { program: Program, starved: Bool }

fn loaded(program: Program) -> Loaded = { program: program, starved: false }

fn analysed_through(
  project: Project,
  shipping: Shipping,
  rows: Rows,
  through: List<CompiledPackage>,
  priors: List<Prior>,
  mine: interfaces::Own,
  reached: Bool,
) -> Loaded / {abort.raise} = {
  let texts = fold(shipping.read, map_new(), |acc: Map<String, Bytes>, source: Source|
    map_insert(acc, string_of_bytes_lossy(source.name), source.src));
  let pkgs: PackageSources = pkgs_of(project);
  let read = concat(through, mine.through);
  let pulled: Pulled = front_end(
    project.sources,
    shipping,
    rows,
    pkgs,
    read,
    project.embeds,
    priors,
    reached,
  );
  let shipped_places = map(pulled.pulled, |n: Bytes|
    shipped_place(texts, string_of_bytes_lossy(n)));
  let own = placed_of(project);
  let places = concat(concat(own.modules, shipped_places), own.manifests);
  let own = fold(project.sources, map_new(), |acc: Map<Bytes, Bool>, source: Source|
    map_insert(acc, source.name, true));
  let stubbed = fold(mine.through, map_new(), |acc: Map<Bytes, Bool>, p: CompiledPackage|
    fold(p.modules, acc, |a: Map<Bytes, Bool>, m: CompiledModule| map_insert(a, m.name, true)));
  // The check that kept a module's stub showed its measures, and its text and all it reaches stand.
  let fresh = |m: Bytes| map_contains(own, m) && !map_contains(stubbed, m);
  match pulled.out {
    Refused(ds) -> loaded(broken(project, shipping, places, ds)),
    Analysed(w) -> if len(mine.through) > 0 && len(measures_in(w, fresh)) > 0 {
      { program: broken(project, shipping, places, []), starved: true }
    } else {
      match unshown(w, fresh) {
        [] -> {
          let warnings = interfaces::warned_with(w.mods, w.warnings, mine);
          loaded({
            files: project.files,
            places: places,
            diags: warnings,
            cache_warnings: [],
            whole: Some({ ..w, warnings: warnings }),
            pkgs: pkgs,
            through: read,
            embeds: project.embeds,
            shipping: shipping,
            reached: reached,
          })
        },
        missing -> loaded(broken(project, shipping, places, map(missing, undescended))),
      }
    },
  }
}

fn undescended(u: Unshown) -> Diag / {abort.raise} =
  error_at(
    b"E0467",
    u.measure.at.module,
    { start: u.measure.at.start, end: u.measure.at.end },
    bytes_of_string(
      "no proof shows `" ++ u.measure.owner
        ++ "`'s measure descends at every call its group makes back into itself",
    ),
    b"this measure is not shown",
    push(map(u.why, bytes_of_string), if u.ends {
      b"the checker sees it end without the measure, which can be deleted"
    } else {
      b"a definition is read as ending on its measure only once a proof shows it; restructure it so the checker sees it descend, or state a measure a proof can follow"
    }),
  )

/// A project worth pulling shipped modules for: one the walk read whole and that holds at least one
/// module.
pub fn usable(project: Project) -> Bool = len(project.diags) == 0 && len(project.sources) > 0

fn assembled(
  project: Project,
  shipping: Shipping,
  paths: List<paths::Resolved>,
  rows: Rows,
  through: List<CompiledPackage> = [],
  priors: List<Prior> = [],
  own: interfaces::Own = { through: [], names: [], warned: [] },
  reached: Bool = true,
) -> Program / {abort.raise} =
  if len(project.diags) > 0 { broken(project, shipping, own_places(project), project.diags) }
  else if len(project.sources) == 0 {
    broken(project, shipping, [], [
      nothing_here(match list_at(paths, 0) { Some(r) -> r.display, None -> "." }),
    ])
  } else { analysed(project, shipping, rows, through, priors, own, reached) }

/// The toolchain's own tree: its shipped modules are its roots, not a dependency.
fn claims_shipped_modules(project: Project, shipping: Shipping) -> Bool = {
  let names = fold(shipped_listed(shipping), map_new(), |acc: Map<Bytes, Bool>, name: Bytes|
    map_insert(acc, name, true));
  fold(project.sources, false, |acc: Bool, source: Source| acc || map_contains(names, source.name))
}

fn interfaced_for(interfaced: Bool, project: Project, shipping: Shipping) -> Bool =
  interfaced && usable(project) && len(shipped_listed(shipping)) > 0
    && !claims_shipped_modules(project, shipping)

fn originals_of(project: Project, shipping: Shipping) -> List<Original> / {abort.raise} =
  interfaces::originals(
    pkgs_of(project),
    map(project.sources, |source: Source| source.name),
    shipping.read,
  )

/// A verifying load reads no compiled package, which may carry a published interface over whole.
fn through_of(
  paths: List<paths::Resolved>,
  project: Project,
  shipping: Shipping,
  stamps: Stamps,
  interfaced: Bool,
  verify: Bool,
) -> List<CompiledPackage> / {fs.read[cwd], fs.read[abs], abort.raise} =
  if verify || !interfaced_for(interfaced, project, shipping) { [] } else {
    let place = loads::place_of(paths, stamps);
    let found = originals_of(project, shipping);
    let read = embeds_read(project, shipping);
    let own = if place.label == "cwd" { interfaces::read_through[cwd](place, found, read) }
    else { interfaces::read_through[abs](place, found, read) };
    interfaces::beside(own, interfaces::published(slots_of(project), found, read))
  }

/// What each module embeds, as the walk and the shipped modules read it.
fn embeds_read(project: Project, shipping: Shipping) -> EmbedReader / {abort.raise} =
  embeds_now(
    pkgs_of(project),
    project.sources,
    shipping.read,
    map(project.embeds, |embed: Embed| embed.embedded),
  )

/// Every module a load may read, as it stands now: a root module's text stands over a shipped one
/// its tree claims the name of.
fn every_original(project: Project, shipping: Shipping) -> List<Original> / {abort.raise} =
  concat(
    originals_of(project, shipping),
    interfaces::own_originals(pkgs_of(project), project.sources),
  )

/// Only a check of the whole project, which answers for no body, reads its own modules as stubs.
fn own_stubs(paths: List<paths::Resolved>, project: Project, own: Bool, verify: Bool) -> Bool =
  own && !verify && usable(project) && whole_project(paths)

fn own_read(
  paths: List<paths::Resolved>,
  project: Project,
  shipping: Shipping,
  stamps: Stamps,
  rows: Rows,
  own: Bool,
  verify: Bool,
) -> interfaces::Own / {fs.read[cwd], fs.read[abs], abort.raise} =
  if !own_stubs(paths, project, own, verify) { interfaces::no_own() } else {
    let place = loads::place_of(paths, stamps);
    let found = every_original(project, shipping);
    let read = embeds_read(project, shipping);
    if place.label == "cwd" { interfaces::own_through[cwd](place, found, rows.defs, read) }
    else { interfaces::own_through[abs](place, found, rows.defs, read) }
  }

fn own_keeping(
  paths: List<paths::Resolved>,
  project: Project,
  shipping: Shipping,
  stamps: Stamps,
  own: Bool,
  verify: Bool,
  program: Program,
) -> Unit / {fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, abort.raise} =
  match program.whole {
    None -> (),
    Some(w) -> if !own_stubs(paths, project, own, verify) { () } else {
      let place = loads::place_of(paths, stamps);
      let found = every_original(project, shipping);
      if place.label == "cwd" {
        interfaces::own_kept[cwd](place, found, w, program.through, program.diags)
      } else { interfaces::own_kept[abs](place, found, w, program.through, program.diags) }
    },
  }

fn slots_of(project: Project) -> List<String> / {abort.raise} =
  interfaces::slots(project.root_key, map(project.packages, |package: DepPackage| package.root))

/// Each published interface against what this load cut from source; one that differs refuses the load.
fn verified(
  project: Project,
  shipping: Shipping,
  verify: Bool,
  program: Program,
) -> Program / {fs.read_file[abs], abort.raise} =
  match program.whole {
    None -> program,
    Some(w) -> if !verify { program } else {
      match interfaces::underived(
          slots_of(project),
          originals_of(project, shipping),
          w,
          embeds_read(project, shipping),
        ) {
        [] -> program,
        refused -> { ..program, diags: concat(program.diags, refused), whole: None },
      }
    },
  }

fn refreshing(
  paths: List<paths::Resolved>,
  project: Project,
  shipping: Shipping,
  stamps: Stamps,
  interfaced: Bool,
  through: List<CompiledPackage>,
  program: Program,
) -> Unit / {fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, abort.raise} =
  match program.whole {
    None -> (),
    Some(w) -> if !interfaced_for(interfaced, project, shipping) { () } else {
      let place = loads::place_of(paths, stamps);
      let found = originals_of(project, shipping);
      if place.label == "cwd" { interfaces::refreshed[cwd](place, found, w, through) }
      else { interfaces::refreshed[abs](place, found, w, through) }
    },
  }

// --- The front-end cache ---------------------------------------------------------

fn nothing_recorded() -> Recorded =
  {
    defs: [],
    tests: [],
    stdlib: None,
    warnings: [],
    intact: map_new(),
    filed_load: None,
    priors: [],
  }

fn rows_recorded(k: Recorded) -> Rows =
  { defs: map(k.defs, |d: DefInterface| d.row), tests: k.tests }

/// Only a load of the whole project may drop what the cache holds for files it did not read.
fn whole_project(paths: List<paths::Resolved>) -> Bool =
  match paths { [] -> true, [r] -> r.inside == ".", _ -> false }

/// A package's manifest digest is the identity the store files its sources under: blake3 of the
/// manifest text. A package with no manifest has no modules.
fn packages_of(pkgs: PackageSources) -> List<SourcePackage> / {abort.raise} =
  fold(pkgs.supplied, [], |acc: List<SourcePackage>, s: Supplied|
    match s.manifest {
      None -> acc,
      Some(text) ->
        push(acc, {
          root: string_of_bytes_lossy(s.root),
          digest: string_of_bytes(hex(blake3(text))),
        }),
    })

fn source_of(file: File) -> SourceFile = { path: file.path, name: file.module, text: file.text }

/// Every file a load may read before it knows which shipped modules it pulls: its own, each
/// dependency's, and every shipped module.
fn read_sources(project: Project, shipping: Shipping) -> Sources / {abort.raise} =
  {
    files: concat(
      concat(
        map(project.files, source_of),
        fold(project.packages, [], |acc: List<SourceFile>, package: DepPackage|
          concat(acc, map(package.files, source_of))),
      ),
      map(shipping.read, |source: Source| {
        let name = string_of_bytes_lossy(source.name);
        { path: pseudo_path(name), name: name, text: source.src }
      }),
    ),
    packages: packages_of(pkgs_of(project)),
  }

/// The files are the *places* and not the modules: a `ply.pkg` is a file the front end read and a
/// source id it answers under, so one entry per place is what keeps the ids of everything after it
/// where the machine's reader expects them. A manifest carries no module, and the runtime files one
/// under `pkg`.
fn placed_sources(program: Program, analysis: Analysis) -> List<SourceFile> = {
  let named = modules_of(program, analysis);
  map(range(0, len(program.places)), |i: Int|
    {
      path: match list_at(program.places, i) { Some(place) -> place.path, None -> "" },
      name: match list_at(named, i) { Some(m) -> m.name, None -> "pkg" },
      text: match list_at(program.places, i) { Some(place) -> place.text, None -> b"" },
    })
}

fn recorded_for(
  paths: List<paths::Resolved>,
  project: Project,
  shipping: Shipping,
  stamps: Stamps,
) -> Recorded / {fs.read[cwd], fs.read[abs], abort.raise} =
  if usable(project) {
    let place = loads::place_of(paths, stamps);
    let sources = read_sources(project, shipping);
    if place.label == "cwd" { loads::known[cwd](place, sources) }
    else { loads::known[abs](place, sources) }
  } else { nothing_recorded() }

fn same_diag(a: Diag, b: Diag) -> Bool = a.code == b.code && a.message == b.message

/// What the filing warned about that the read had not already said.
fn unsaid(said: List<Diag>, more: List<Diag>) -> List<Diag> =
  filter(more, |d: Diag| !fold(said, false, |acc: Bool, s: Diag| acc || same_diag(s, d)))

fn stdlib_changed(modules: List<String>, reached: Int) -> Diag = {
  let what = if reached == 0 { "no definition this program reaches changed" }
  else if reached == 1 { "1 definition this program reaches changed" }
  else { int_to_string(reached) ++ " definitions this program reaches changed" };
  {
    code: b"W0605",
    notes: 3,
    labels: [],
    text: b"",
    message: bytes_of_string(
      "shipped modules this load reads changed since the cache was written: "
        ++ join(modules, ", "),
    ),
    notes_text: [
      bytes_of_string(what),
      b"a `std` definition hashes like any other, so only what a change reached re-runs",
      b"`ply std` lists the shipped modules and their digest",
    ],
    severity: b"warning",
    fixes: [],
  }
}

/// What a change to the shipped modules a load reads did to this project, said by the load that
/// files over the old filing: every definition whose closure reaches a shipped one that now hashes
/// differently.
pub fn stdlib_notice(moved: Option<StdlibMoved>, h: HashOutput) -> List<Diag> / {abort.raise} =
  match moved {
    None -> [],
    Some(m) -> {
      let defs = hash::by_name(h.defs);
      let decls = hash::by_name(h.decls);
      let changed = fold(m.entries, map_new(), |acc: Map<Bytes, Bool>, e: ShippedEntry| {
        let now = match map_get(defs, e.name) {
          Some(x) -> Some(x),
          None -> map_get(decls, e.name),
        };
        if now == Some(e.hash) { acc } else { map_insert(acc, e.name, true) }
      });
      let reached = hash::reaching(h, changed);
      let counted = |xs: List<{ name: Bytes, hash: Bytes }>|
        fold(xs, 0, |n: Int, x: { name: Bytes, hash: Bytes }|
          if map_contains(reached, x.name) { n + 1 } else { n });
      [stdlib_changed(m.modules, counted(h.defs) + counted(h.decls))]
    },
  }

/// What a filing writes, beyond the compiler the store's stamp names: the files the load placed and
/// the packages their keys name, each name's hashes and check key, the shipped modules and the
/// load's reach. An interface or a body is a function of the hash it is filed under.
fn load_digest(
  files: List<SourceFile>,
  packages: List<SourcePackage>,
  hashes: HashOutput,
  checks: List<{ name: Bytes, hash: Bytes }>,
  whole: Bool,
) -> Bytes = {
  let counted = |count: Int| bytes_of_string(int_to_string(count) ++ "\0");
  let named = |entries: List<{ name: Bytes, hash: Bytes }>|
    bytes_concat(
      counted(len(entries)),
      bytes_concat_all(
        map(entries, |entry: { name: Bytes, hash: Bytes }|
          bytes_concat_all([entry.name, b"\0", entry.hash])),
      ),
    );
  blake3(
    bytes_concat_all([
      b"ply.load.1\0",
      counted(len(files)),
      bytes_concat_all(
        map(files, |file: SourceFile|
          bytes_concat_all([
            bytes_of_string(file.path ++ "\0" ++ file.name ++ "\0"),
            blake3(file.text),
          ])),
      ),
      counted(len(packages)),
      bytes_concat_all(
        map(packages, |package: SourcePackage|
          bytes_of_string(package.root ++ "\0" ++ package.digest ++ "\0")),
      ),
      named(hashes.defs),
      named(checks),
      named(hashes.decls),
      counted(len(hashes.tests)),
      bytes_concat_all(hashes.tests),
      if whole { b"\0whole" } else { b"\0part" },
    ]),
  )
}

/// A load that checked files what it published; the store's trouble is the run's warnings and
/// never its failure.
fn filed(
  paths: List<paths::Resolved>,
  shipping: Shipping,
  stamps: Stamps,
  k: Recorded,
  program: Program,
) -> Program / {fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, abort.raise} =
  match program.whole {
    None -> { ..program, cache_warnings: k.warnings },
    Some(w) -> {
      let place = loads::place_of(paths, stamps);
      let sources = { files: placed_sources(program, w), packages: packages_of(program.pkgs) };
      let whole = whole_project(paths);
      let load = load_digest(sources.files, sources.packages, w.hashes, w.checked.checks, whole);
      let held = fold(range(0, len(w.mods)), true, |all: Bool, i: Int|
        all
          && (match list_at(sources.files, i) {
            Some(f) -> map_contains(k.intact, f.path),
            None -> true,
          }));
      // The last filing was of this load and the store still holds all it wrote: filing it again
      // would write nothing.
      let more = if held && len(k.warnings) == 0 && k.filed_load == Some(load)
          && len(k.priors) == len(w.hashes.priors) { [] } else if place.label == "cwd" {
        loads::file[cwd](place, sources, filing(w), whole, load, w.hashes.priors)
      } else { loads::file[abs](place, sources, filing(w), whole, load, w.hashes.priors) };
      {
        ..program,
        cache_warnings: concat(
          concat(k.warnings, stdlib_notice(k.stdlib, w.hashes)),
          unsaid(k.warnings, more),
        ),
      }
    },
  }

/// `interfaced` is false for a run whose scope takes in the shipped modules: it reads their source.
/// `verify` seeds nothing and reads every dependency from source, then holds each published interface
/// to that reading.
pub fn load_program(
  paths: List<paths::Resolved>,
  interfaced: Bool = true,
  verify: Bool = false,
) -> Program / {builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, abort.raise, diverges} = {
  let project: Project = load_resolved(paths);
  let shipping: Shipping = if usable(project) { shipping_for(project.sources, pkgs_of(project)) }
  else { no_shipping() };
  let stamps = loads::shipped_stamps();
  let k: Recorded = recorded_for(paths, project, shipping, stamps);
  let rows = if verify { no_rows() } else { rows_recorded(k) };
  let through = through_of(paths, project, shipping, stamps, interfaced, verify);
  let p: Program = verified(
    project,
    shipping,
    verify,
    assembled(
      project,
      shipping,
      paths,
      rows,
      through,
      if verify { [] } else { k.priors },
      reached: interfaced,
    ),
  );
  refreshing(paths, project, shipping, stamps, interfaced, through, p);
  filed(paths, shipping, stamps, k, p)
}

/// What a load of these paths would pin, with nothing parsed, checked or filed; or what refuses the
/// walk or the package closure, beside the places a refusal is rendered against.
pub fn pins_for(
  paths: List<paths::Resolved>,
) -> Result<List<Pinned>, { diags: List<Diag>, places: List<Place> }> / {builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], abort.raise, diverges} = {
  let project: Project = load_resolved(paths);
  if len(project.diags) > 0 { Err({ diags: project.diags, places: own_places(project) }) } else {
    match pins_pulling(
        project.sources,
        pkgs_of(project),
        map(project.embeds, |e: Embed| e.embedded),
      ) {
      Ok(pins) -> Ok(pins),
      Err(diags) -> {
        let own = placed_of(project);
        Err({ diags: diags, places: concat(own.modules, own.manifests) })
      },
    }
  }
}

/// A load that neither reads nor files the front-end cache: what `ply build` and `ply hosts` take,
/// and what a command's switch off the cache asks for.
pub fn load_uncached(
  paths: List<paths::Resolved>,
) -> Program / {builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], abort.raise, diverges} = {
  let project: Project = load_resolved(paths);
  let shipping: Shipping = if usable(project) { shipping_for(project.sources, pkgs_of(project)) }
  else { no_shipping() };
  assembled(project, shipping, paths, no_rows())
}

/// What the load answered, for the machine to read rather than load again. The dump carries the
/// load's warnings, the cache's among them, so a command the machine reports for says them too.
pub fn front_of(timed: Timed, analysis: Analysis) -> LoadedAnalysis / {abort.raise} =
  {
    dump: dump_of(Analysed({ ..analysis, warnings: load_diagnostics(timed.program) })),
    files: placed_sources(timed.program, analysis),
    read_ms: timed.read_ms,
    front_ms: timed.front_ms,
    file_ms: timed.file_ms,
    cached: timed.cached,
  }

/// The front end a command's test hands an effect that takes one: these tests read what a report
/// says about what they were given, so nothing loads, and the record exists only because the
/// effect takes one.
pub fn no_front() -> LoadedAnalysis / {abort.raise} =
  { dump: dump_of(Refused([])), files: [], read_ms: 0, front_ms: 0, file_ms: 0, cached: false }

/// The same load, with the readings a `--explain` run prints: what the walk, the shipped modules and
/// the cache read cost, what the front end cost over them, and what filing its answer cost.
pub fn timed_load(
  paths: List<paths::Resolved>,
  interfaced: Bool = true,
  verify: Bool = false,
) -> Timed / {builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, time.elapsed_us, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, abort.raise, diverges} = {
  let started = time.elapsed_ms();
  timed_over(paths, load_resolved(paths), started, interfaced, verify)
}

/// [`timed_load`] over a walk already made, with the clock as it read before the walk. `own` reads
/// each of the root package's modules that stands as the last such load kept it through its stub: a
/// load that answers for no body of theirs.
pub fn timed_over(
  paths: List<paths::Resolved>,
  project: Project,
  started: Int,
  interfaced: Bool = true,
  verify: Bool = false,
  own: Bool = false,
) -> Timed / {builder.git[vcs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, abort.raise} = {
  let shipping: Shipping = if usable(project) { shipping_for(project.sources, pkgs_of(project)) }
  else { no_shipping() };
  let stamps = loads::shipped_stamps();
  let k: Recorded = recorded_for(paths, project, shipping, stamps);
  let rows = if verify { no_rows() } else { rows_recorded(k) };
  let through = through_of(paths, project, shipping, stamps, interfaced, verify);
  let mine = own_read(paths, project, shipping, stamps, rows, own, verify);
  let read_done = time.elapsed_ms();
  let p: Program = verified(
    project,
    shipping,
    verify,
    assembled(
      project,
      shipping,
      paths,
      rows,
      through,
      if verify { [] } else { k.priors },
      mine,
      interfaced,
    ),
  );
  let front_done = time.elapsed_ms();
  refreshing(paths, project, shipping, stamps, interfaced, through, p);
  own_keeping(paths, project, shipping, stamps, own, verify, p);
  let kept: Program = filed(paths, shipping, stamps, k, p);
  {
    program: kept,
    read_ms: read_done - started,
    front_ms: front_done - read_done,
    file_ms: time.elapsed_ms() - front_done,
    cached: true,
  }
}

/// [`timed_load`], neither reading nor filing the front-end cache.
pub fn timed_uncached(
  paths: List<paths::Resolved>,
  verify: Bool = false,
  reached: Bool = true,
) -> Timed / {builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, time.elapsed_us, abort.raise, diverges} = {
  let started = time.elapsed_ms();
  timed_uncached_over(paths, load_resolved(paths), started, verify, reached)
}

/// [`timed_uncached`] over a walk already made, with the clock as it read before the walk.
pub fn timed_uncached_over(
  paths: List<paths::Resolved>,
  project: Project,
  started: Int,
  verify: Bool = false,
  reached: Bool = true,
) -> Timed / {builder.git[vcs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, fs.read_file[abs], abort.raise} = {
  let shipping: Shipping = if usable(project) { shipping_for(project.sources, pkgs_of(project)) }
  else { no_shipping() };
  let read_done = time.elapsed_ms();
  let p: Program = verified(
    project,
    shipping,
    verify,
    assembled(project, shipping, paths, no_rows(), reached: reached),
  );
  {
    program: p,
    read_ms: read_done - started,
    front_ms: time.elapsed_ms() - read_done,
    file_ms: 0,
    cached: false,
  }
}

/// Whether a walk read what an earlier load was made of, byte for byte: then that load's answer is
/// this one's, and nothing need be derived again.
pub fn unmoved(project: Project, program: Program) -> Bool =
  len(project.diags) == 0 && project.files == program.files && pkgs_of(project) == program.pkgs
    && project.embeds == program.embeds

// --- Reading the tables ----------------------------------------------------------

pub fn modules_of(program: Program, analysis: Analysis) -> List<ModuleView> =
  map(range(0, len(analysis.mods)), |i: Int|
    {
      name: match list_at(analysis.mods, i) {
        Some(mo) -> string_of_bytes_lossy(mo.name),
        None -> "",
      },
      path: match list_at(program.places, i) { Some(place) -> place.path, None -> "" },
    })

pub fn module_facts(program: Program, analysis: Analysis) -> List<ModuleFacts> / {abort.raise} =
  map(range(0, len(analysis.mods)), |i: Int|
    match list_at(analysis.mods, i) {
      None -> { index: i, name: "", path: "", imports: [], items: [] },
      Some(mo) ->
        {
          index: i,
          name: string_of_bytes_lossy(mo.name),
          path: match list_at(program.places, i) { Some(place) -> place.path, None -> "" },
          imports: map(module_imports(mo), string_of_bytes_lossy),
          items: map(module_items(mo), string_of_bytes_lossy),
        },
    })

/// The modules as the front end took them: the project's own files first, then the shipped modules
/// it pulled, in the order the label indices count.
pub fn sourced(program: Program, analysis: Analysis) -> List<Source> =
  map(range(0, len(analysis.mods)), |i: Int|
    {
      name: match list_at(analysis.mods, i) { Some(mo) -> mo.name, None -> b"" },
      src: match list_at(program.places, i) { Some(place) -> place.text, None -> b"" },
    })

fn first_primary(labels: List<Label>) -> Option<Label> =
  fold(labels, None, |acc: Option<Label>, label: Label|
    match acc { Some(_) -> acc, None -> if label.primary { Some(label) } else { None } })

/// What a run answers for: its root package's modules, and the shipped ones when it asks for them.
/// Another package's definitions are claimed by their specs: that package's own run proves them.
pub fn owned_of(analysis: Analysis, std: Bool) -> (Bytes) -> Bool = {
  let roots = fold(range(0, len(analysis.mods)), map_new(), |acc: Map<Bytes, Bool>, i: Int|
    match ((list_at(analysis.mods, i), list_at(analysis.module_packages, i))) {
      (Some(m), Some(pkg)) -> if pkg == 0 { map_insert(acc, m.name, true) } else { acc },
      _ -> acc,
    });
  |m: Bytes| map_contains(roots, m) || (std && is_shipped(string_of_bytes_lossy(m)))
}

/// A diagnostic raised inside a module the project did not write, which is the shipped modules'
/// business. A run reports its own modules' tests and laws, however its dependencies were read.
pub fn own_tests(program: Program, analysis: Analysis) -> List<TestInfo> =
  filter(analysis.checked.tests, |test_info: TestInfo| test_info.at.module < len(program.files))

pub fn own_laws(program: Program, analysis: Analysis) -> List<LawInfo> =
  filter(analysis.checked.laws, |law_info: LawInfo| law_info.at.module < len(program.files))

pub fn in_shipped_module(program: Program, diag: Diag) -> Bool =
  match first_primary(diag.labels) { Some(l) -> l.module >= len(program.files), None -> false }

pub fn place_of(program: Program, location: Location) -> Option<Place> =
  if location.module == no_module() { None } else { list_at(program.places, location.module) }

/// `path:line:col`, one-based, as every other command prints a place.
pub fn location_of(program: Program, location: Location) -> Option<String> / {abort.raise} =
  match place_of(program, location) {
    None -> None,
    Some(place) -> {
      let spot = spot_of(place.text, location.span.start);
      Some(place.path ++ ":" ++ int_to_string(spot.line) ++ ":" ++ int_to_string(spot.col))
    },
  }

type Picking = { seen: Map<Bytes, Bool>, out: List<DefInfo> }

fn pick(acc: Picking, by_name: Map<Bytes, DefInfo>, name: Bytes) -> Picking =
  match map_get(acc.seen, name) {
    Some(_) -> acc,
    None -> match map_get(by_name, name) {
      None -> acc,
      Some(d) -> { seen: map_insert(acc.seen, name, true), out: push(acc.out, d) },
    },
  }

fn module_fns(acc: List<Bytes>, parsed: ParsedModule) -> List<Bytes> =
  fold(parsed.module.items, acc, |a: List<Bytes>, it: Item|
    match it { IFn(d) -> push(a, qualify(parsed.name, d.name.name)), _ -> a })

/// Every definition in the order its file declares it, module by module, as `ply defs` lists them
/// and as the driver's `published_order` orders them; anything the tree does not name follows.
pub fn published(analysis: Analysis) -> List<DefInfo> = {
  let by_name = fold(
    analysis.checked.defs,
    map_new(),
    |acc: Map<Bytes, DefInfo>, def_info: DefInfo| map_insert(acc, def_info.name, def_info),
  );
  let named = fold(analysis.mods, [], |acc: List<Bytes>, parsed: ParsedModule|
    module_fns(acc, parsed));
  let first: Picking = fold(named, { seen: map_new(), out: [] }, |acc: Picking, name: Bytes|
    pick(acc, by_name, name));
  let all: Picking = fold(analysis.checked.defs, first, |acc: Picking, def_info: DefInfo|
    pick(acc, by_name, def_info.name));
  all.out
}

// --- Naming one definition --------------------------------------------------------

/// The definition a query names: a program-wide name, or a simple name that names exactly one.
/// `Err` holds the program-wide names a simple name matched, and is empty when nothing matched.
pub fn resolve_def(defs: List<DefInfo>, query: String) -> Result<DefInfo, List<String>> = {
  let exact = fold(defs, None, |acc: Option<DefInfo>, d: DefInfo|
    match acc {
      Some(_) -> acc,
      None -> if string_of_bytes_lossy(d.name) == query { Some(d) } else { None },
    });
  match exact {
    Some(d) -> Ok(d),
    None -> {
      let matching = filter(defs, |d: DefInfo| string_of_bytes_lossy(d.simple_name) == query);
      match list_at(matching, 0) {
        None -> Err([]),
        Some(d) -> if len(matching) == 1 { Ok(d) }
        else { Err(map(matching, |x: DefInfo| string_of_bytes_lossy(x.name))) },
      }
    },
  }
}

/// What [`resolve_def`] refused, as a diagnostic: nothing of that name, or more than one.
pub fn unknown_def(query: String, names: List<String>) -> Diag =
  if len(names) == 0 {
    error_at(
      b"E0101",
      no_module(),
      { start: 0, end: 0 },
      bytes_of_string("no definition is named `" ++ query ++ "`"),
      b"not a definition of this program",
      [
        b"the query is a program-wide name such as `store.orders.place`, or a simple name unique in the program",
      ],
    )
  } else {
    error_at(
      b"E0101",
      no_module(),
      { start: 0, end: 0 },
      bytes_of_string("`" ++ query ++ "` names " ++ int_to_string(len(names)) ++ " definitions"),
      b"say which",
      [bytes_of_string("one of: " ++ join(names, ", "))],
    )
  }

/// One more note under a diagnostic, counted as the constructor counts them.
pub fn noted(diag: Diag, note: Bytes) -> Diag =
  { ..diag, notes: diag.notes + 1, notes_text: push(diag.notes_text, note) }

/// The hash tables the dump writes as lists, indexed once so a lookup is not a scan, and the
/// hashing itself, which a closure is walked over when one is asked for.
pub type Tables = {
  defs: Map<Bytes, Bytes>,
  own: Map<Bytes, Bytes>,
  deps: Map<Bytes, List<Bytes>>,
  specs: Map<Bytes, Int>,
  hashes: HashOutput,
}

pub fn tables_of(h: HashOutput) -> Tables =
  {
    defs: fold(h.defs, map_new(), |acc: Map<Bytes, Bytes>, x: { name: Bytes, hash: Bytes }|
      map_insert(acc, x.name, x.hash)),
    own: fold(h.own, map_new(), |acc: Map<Bytes, Bytes>, x: { name: Bytes, hash: Bytes }|
      map_insert(acc, x.name, x.hash)),
    deps: fold(
      h.deps,
      map_new(),
      |acc: Map<Bytes, List<Bytes>>, x: { name: Bytes, names: List<Bytes> }|
        map_insert(acc, x.name, x.names),
    ),
    specs: fold(
      h.specs,
      map_new(),
      |acc: Map<Bytes, Int>, x: { name: Bytes, hashes: List<Bytes> }|
        map_insert(acc, x.name, len(x.hashes)),
    ),
    hashes: h,
  }

/// A definition's hash as `ply hash` prints it: sixty-four hex characters, or nothing when the
/// program declares the name without hashing a body for it.
pub fn hash_of(tables: Tables, name: Bytes) -> Option<String> / {abort.raise} =
  match map_get(tables.defs, name) { Some(h) -> Some(string_of_bytes_lossy(hex(h))), None -> None }

pub fn own_of(tables: Tables, name: Bytes) -> Option<String> / {abort.raise} =
  match map_get(tables.own, name) { Some(h) -> Some(string_of_bytes_lossy(hex(h))), None -> None }

pub fn deps_of(tables: Tables, name: Bytes) -> List<String> =
  match map_get(tables.deps, name) {
    Some(ns) -> map(ns, |n: Bytes| string_of_bytes_lossy(n)),
    None -> [],
  }

pub fn closure_of(tables: Tables, name: Bytes) -> List<String> / {abort.raise} =
  map(map_keys(hash::closure_of(tables.hashes, [name])), |n: Bytes| string_of_bytes_lossy(n))

/// Every name and key whose closure holds `name`, but `name` itself.
pub fn reached_from(tables: Tables, name: Bytes) -> List<Bytes> / {abort.raise} =
  filter(map_keys(hash::reaching(tables.hashes, map_insert(map_new(), name, true))), |key: Bytes|
    key != name)

pub fn specs_of(tables: Tables, name: Bytes) -> Int =
  match map_get(tables.specs, name) { Some(n) -> n, None -> 0 }

pub fn short_of(hex_text: String) -> String / {abort.raise} = string_slice(hex_text, 0, 12)

pub fn is_shipped(module: String) -> Bool = is_std(module) || is_compiler(module)

// --- Tests ------------------------------------------------------------------

test "a shipped module's text is said to live under its root, outside the identifier space" {
  assert_eq(pseudo_path("std.json"), "<std>/json.ply");
  assert_eq(pseudo_path("std.http.server"), "<std>/http/server.ply");
  assert_eq(pseudo_path("compiler.fmt"), "<compiler>/fmt.ply")
}

test "a shipped module is one under a reserved root and nothing else" {
  assert(is_shipped("std"));
  assert(is_shipped("std.json"));
  assert(is_shipped("compiler.front"));
  assert(!is_shipped("standard"));
  assert(!is_shipped("m"))
}

fn named(name: Bytes, simple: Bytes) -> DefInfo =
  {
    name: name,
    module: b"m",
    simple_name: simple,
    scheme: {
      ty_vars: [],
      row_vars: [],
      label_vars: [],
      ty: TyFn({
        params: [],
        ret: TyCon({ name: b"Int", args: [] }),
        effects: { atoms: [], tail: None },
      }),
    },
    footprint: [],
    performed: [],
    scaling: [],
    repeats: [],
    bounded: [],
    tail_bounded: false,
    ending: Ends,
    summary: unknown_summary(),
    row_aliases: [],
    constraints: [],
    spec: [],
    at: { module: 0, span: { start: 0, end: 0 } },
  }

test "a query is a program-wide name, or a simple name that names exactly one definition" {
  let defs = [named(b"a.total", b"total"), named(b"b.total", b"total"), named(b"a.one", b"one")];
  assert_eq(match resolve_def(defs, "a.total") { Ok(d) -> d.name, Err(_) -> b"" }, b"a.total");
  assert_eq(match resolve_def(defs, "one") { Ok(d) -> d.name, Err(_) -> b"" }, b"a.one");
  assert_eq(match resolve_def(defs, "total") { Ok(_) -> [], Err(ns) -> ns }, [
    "a.total",
    "b.total",
  ]);
  assert_eq(match resolve_def(defs, "absent") { Ok(_) -> ["found"], Err(ns) -> ns }, [])
}

test "a name nothing declares is `E0101`, and an ambiguous one says which" {
  assert_eq(unknown_def("absent", []).code, b"E0101");
  assert_eq(unknown_def("absent", []).message, b"no definition is named `absent`");
  let many = unknown_def("total", ["a.total", "b.total"]);
  assert_eq(many.message, b"`total` names 2 definitions");
  assert_eq(many.notes_text, [b"one of: a.total, b.total"]);
  assert_eq(noted(many, b"and one more").notes, 2)
}

fn two_defs() -> HashOutput =
  {
    ..hash::no_hashes(),
    defs: [{ name: b"app.reads", hash: b"r1" }, { name: b"app.pure", hash: b"p1" }],
    decls: [{ name: b"std.net.net", hash: b"n2" }],
    refs: {
      names: [b"app.reads", b"app.pure", b"std.net.net"],
      edges: [[2], [], []],
      starts: map_of_entries([
        { key: b"app.reads", value: [0] },
        { key: b"app.pure", value: [1] },
        { key: b"std.net.net", value: [2] },
      ]),
      cases: map_new(),
    },
  }

test "a moved stdlib is said once, counting what reaches a shipped definition that moved" {
  assert_eq(stdlib_notice(None, two_defs()), []);
  let moved = Some({ modules: ["std.net"], entries: [{ name: b"std.net.net", hash: b"n1" }] });
  let said = stdlib_notice(moved, two_defs());
  assert_eq(map(said, |d: Diag| d.code), [b"W0605"]);
  assert_eq(map(said, |d: Diag| d.message), [
    b"shipped modules this load reads changed since the cache was written: std.net",
  ]);
  // `app.reads` and the effect itself reach it; `app.pure` does not.
  assert_eq(
    match list_at(said, 0) { Some(d) -> list_at(d.notes_text, 0), None -> None },
    Some(b"2 definitions this program reaches changed"),
  );
  let same = Some({ modules: ["std.net"], entries: [{ name: b"std.net.net", hash: b"n2" }] });
  assert_eq(
    match list_at(stdlib_notice(same, two_defs()), 0) {
      Some(d) -> list_at(d.notes_text, 0),
      None -> None,
    },
    Some(b"no definition this program reaches changed"),
  )
}

test "only a load of one directory is a load of the whole project" {
  let here = paths::here();
  assert(whole_project([]));
  assert(whole_project([here]));
  assert(!whole_project([{ ..here, inside: "m.ply" }]));
  assert(!whole_project([here, here]))
}

test "a load's digest moves with each file it placed, shipped ones among them, hash and reach" {
  let files = [{ path: "m.ply", name: "m", text: b"f" }];
  let h = { ..hash::no_hashes(), defs: [{ name: b"m.f", hash: blake3(b"f") }] };
  let base = load_digest(files, [], h, [], true);
  assert_eq(load_digest(files, [], h, [], true), base);
  assert(load_digest([{ path: "m.ply", name: "m", text: b"g" }], [], h, [], true) != base);
  let shipped = { path: "<std>/net.ply", name: "std.net", text: b"n" };
  assert(load_digest(push(files, shipped), [], h, [], true) != base);
  assert(load_digest(files, [{ root: "dep", digest: "d" }], h, [], true) != base);
  assert(load_digest(files, [], h, h.defs, true) != base);
  assert(load_digest(files, [], { ..h, tests: [blake3(b"t")] }, [], true) != base);
  assert(load_digest(files, [], h, [], false) != base)
}

test "a warning the cache read already gave is not given again by the filing" {
  let read = [stdlib_changed(["std.a"], 0)];
  assert_eq(unsaid(read, [stdlib_changed(["std.a"], 0)]), []);
  assert_eq(len(unsaid(read, [stdlib_changed(["std.b"], 0)])), 1)
}

test "a span outside every module has no place and no location" {
  let p: Program = {
    files: [],
    places: [{ path: "m.ply", text: b"fn f() -> Int = 1\n" }],
    diags: [],
    cache_warnings: [],
    whole: None,
    pkgs: { root: b"", manifest: None, supplied: [] },
    through: [],
    embeds: [],
    shipping: { read: [], unread: [] },
    reached: true,
  };
  assert_eq(location_of(p, { module: no_module(), span: { start: 0, end: 0 } }), None);
  assert_eq(location_of(p, { module: 0, span: { start: 3, end: 4 } }), Some("m.ply:1:4"))
}
