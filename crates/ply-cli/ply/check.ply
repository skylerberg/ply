// `ply check` — the front end over a program, and as much of what it inferred as the flags ask
// for. The summary line is the whole answer by default; `--types` prints every module's surface,
// `--explain` says where the time went and where each row came from, and `--costs` says where an
// update copies.

import std.random (entropy)
import builder (builder)
import args (Flags, style_of)
import appends (costs_of, priced, promised, promises, report_lines, unresolved)
import diagnostic (Place, all_to_json)
import program (Program, Timed, ModuleFacts, timed_load, module_facts, published, is_shelved,
                own_tests)
import report (Answer, ok_code, count_of, indent, plural, refused, warning_lines)
import signature (SetLine, counted_lines, effect_sets, provenance, provenance_lines, set_lines)
import style (Style, bold, dim, green)
import compiler.costs (Report)
import compiler.front (Analysis, effect_sets_of)
import compiler.infer (DefInfo, TestInfo, EffectInfo, OpInfo)
import compiler.resolve (Diag)
import compiler.types (Atom, Type, printer_new, print_atom_list, scheme_text, row_text, type_text,
                       atom_text, append)
import compiler.type_syntax (Mode, MRead, MWrite, MBad)
import std.fs (fs)
import std.json (Json, Member, Str, Bool, Number, Array, object)
import std.time (time)

// `indent()` plus the two spaces that put a definition under its module heading.
fn types_indent() -> Int = 5

fn under() -> String = indent() ++ "  "

fn texts(bs: List<Bytes>) -> List<String> = map(bs, |b: Bytes| string_of_bytes_lossy(b))

fn json_strings(ss: List<String>) -> List<Json> = map(ss, |s: String| Str(s))

fn number(n: Int) -> Json = Number(decimal_of_int(n))

fn spaces(n: Int) -> String = fold(range(0, n), "", |acc: String, i: Int| acc ++ " ")

fn pad_left(s: String, n: Int) -> String =
  if string_len(s) >= n { s } else { spaces(n - string_len(s)) ++ s }

fn pad_right(s: String, n: Int) -> String =
  if string_len(s) >= n { s } else { s ++ spaces(n - string_len(s)) }

fn commas(xs: List<String>) -> String =
  fold(range(0, len(xs)), "", |acc: String, i: Int|
    match list_at(xs, i) { Some(x) -> if i == 0 { x } else { acc ++ ", " ++ x }, None -> acc })

// As the reference prints a test's name: the bytes, with the ones that would close the quotes escaped.
fn quoted(s: String) -> String / {abort.raise} = {
  let b = bytes_of_string(s);
  string_of_bytes_lossy(
    bytes_concat_all([
      b"\"",
      bytes_concat_all(
        map(range(0, bytes_len(b)), |i: Int| {
          let c = bytes_at(b, i);
          if c == 34 { b"\\\"" }
          else if c == 92 { b"\\\\" }
          else if c == 10 { b"\\n" }
          else if c == 13 { b"\\r" }
          else if c == 9 { b"\\t" }
          else { bytes_slice(b, i, i + 1) }
        }),
      ),
      b"\"",
    ]),
  )
}

fn mode_text(m: Mode) -> String = match m { MRead -> "read", MWrite -> "write", MBad -> "" }

fn scheme_of(def_info: DefInfo) -> String / {abort.raise} =
  string_of_bytes_lossy(scheme_text(def_info.scheme))

fn footprint_of(atoms: List<Atom>) -> String / {abort.raise} =
  string_of_bytes_lossy(row_text({ atoms: atoms, tail: None }))

fn atoms_of(atoms: List<Atom>) -> List<String> / {abort.raise} =
  texts(print_atom_list(printer_new(), atoms).texts)

fn mine(name: String, defs: List<DefInfo>) -> List<DefInfo> =
  filter(defs, |def_info: DefInfo| string_of_bytes_lossy(def_info.module) == name)

// --- Where the time went ----------------------------------------------------------
// The clock the program reads counts whole milliseconds, so that is what a phase is reported in.

type Phase = { label: String, ms: Int }

fn share(ms: Int, total: Int) -> String / {abort.raise} = {
  // Per mille is tenths of a percent, so one division answers both digits.
  let tenths = if total == 0 { 0 } else { ms * 1000 / total };
  pad_left(int_to_string(tenths / 10) ++ "." ++ int_to_string(tenths % 10), 5) ++ "%"
}

fn phase_line(style: Style, phase: Phase, total: Int) -> String / {abort.raise} =
  under() ++ pad_right(phase.label, 11) ++ " " ++ pad_left(int_to_string(phase.ms), 8) ++ "ms "
    ++ dim(style, share(phase.ms, total))

// Longest first, so what dominated a run is read first; a tie keeps the order the load ran them in.
fn ordered(phases: List<Phase>) -> List<Phase> =
  fold(phases, [], |acc: List<Phase>, p: Phase| {
    let before = filter(acc, |q: Phase| q.ms >= p.ms);
    append(push(before, p), filter(acc, |q: Phase| q.ms < p.ms))
  })

fn phase_lines(style: Style, timed: Timed) -> List<String> / {abort.raise} = {
  let total = timed.read_ms + timed.front_ms + timed.file_ms;
  let rows = ordered([
    { label: "read", ms: timed.read_ms },
    { label: "front", ms: timed.front_ms },
    { label: "write back", ms: timed.file_ms },
  ]);
  append(
    append(
      ["", indent() ++ bold(style, "front-end time")],
      map(rows, |phase: Phase| phase_line(style, phase, total)),
    ),
    [under() ++ pad_right("total", 11) ++ " " ++ pad_left(int_to_string(total), 8) ++ "ms"],
  )
}

fn phases_json(timed: Timed) -> Json =
  object([
    { key: "read", value: number(timed.read_ms) },
    { key: "front", value: number(timed.front_ms) },
    { key: "write_back", value: number(timed.file_ms) },
    { key: "total", value: number(timed.read_ms + timed.front_ms + timed.file_ms) },
  ])

// --- Where the answer came from ---------------------------------------------------
// A definition whose hash has not moved since the cache filed it is taken from its filed rows, and
// every other one is checked.

type Seeding = { seeded: Int, checked: Int }

fn seeding_of(analysis: Analysis) -> Seeding = {
  let seeded = len(analysis.checked.seeded);
  { seeded: seeded, checked: len(analysis.checked.defs) - seeded }
}

fn count_line(label: String, n: Int) -> String / {abort.raise} =
  under() ++ pad_right(label, 11) ++ " " ++ pad_left(int_to_string(n), 8) ++ " "
    ++ plural(n, "definition")

fn seeding_lines(style: Style, analysis: Analysis) -> List<String> / {abort.raise} = {
  let x = seeding_of(analysis);
  [
    "",
    indent() ++ bold(style, "front-end cache"),
    count_line("seeded", x.seeded),
    count_line("checked", x.checked),
    under() ++ pad_right("stubbed", 11) ++ " " ++ pad_left(int_to_string(len(analysis.stubs)), 8)
      ++ " "
      ++ plural(len(analysis.stubs), "module"),
  ]
}

fn seeding_json(analysis: Analysis) -> Json = {
  let x = seeding_of(analysis);
  object([{ key: "seeded", value: number(x.seeded) }, { key: "checked", value: number(x.checked) }])
}

// --- `--types` ---------------------------------------------------------------------

fn op_line(style: Style, o: OpInfo) -> String / {abort.raise} = {
  let resource = if o.resource_param { "[r]" } else { "" };
  indent() ++ "    " ++ dim(style, mode_text(o.mode)) ++ " " ++ string_of_bytes_lossy(o.name)
    ++ resource
    ++ "("
    ++ commas(map(o.params, |t: Type| string_of_bytes_lossy(type_text(t))))
    ++ ") -> "
    ++ string_of_bytes_lossy(type_text(o.ret))
}

fn effect_lines(
  style: Style,
  lines: List<String>,
  effect_info: EffectInfo,
) -> List<String> / {abort.raise} = {
  let marker = if effect_info.nondet { "nondet effect" } else { "effect" };
  let head = push(
    lines,
    under() ++ dim(style, marker) ++ " "
      ++ bold(style, string_of_bytes_lossy(effect_info.simple_name)),
  );
  fold(effect_info.ops, head, |acc: List<String>, o: OpInfo| push(acc, op_line(style, o)))
}

fn set_block(lines: List<String>, v: SetLine) -> List<String> / {abort.raise} =
  fold(set_lines(v, types_indent()), push(lines, ""), |acc: List<String>, l: String|
    push(acc, under() ++ l))

fn set_blocks(lines: List<String>, sets: List<SetLine>) -> List<String> / {abort.raise} = {
  let blocks = fold(sets, lines, set_block);
  if len(sets) == 0 { blocks } else { push(blocks, "") }
}

fn widest(defs: List<DefInfo>) -> Int =
  fold(defs, 0, |acc: Int, def_info: DefInfo| {
    let n = string_len(string_of_bytes_lossy(def_info.simple_name));
    if n > acc { n } else { acc }
  })

fn def_block(
  style: Style,
  explain: Bool,
  width: Int,
  lines: List<String>,
  def_info: DefInfo,
) -> List<String> / {abort.raise} = {
  let said = fold(
    counted_lines(types_indent(), width, string_of_bytes_lossy(def_info.simple_name), def_info),
    lines,
    |acc: List<String>, l: String| push(acc, under() ++ l),
  );
  if !explain { said } else {
    fold(
      provenance_lines(provenance(def_info), types_indent()),
      said,
      |acc: List<String>, l: String| push(acc, under() ++ dim(style, l)),
    )
  }
}

fn test_line(style: Style, test_info: TestInfo) -> String / {abort.raise} = {
  let kind = if test_info.nondet { "test/nondet" } else { "test" };
  under() ++ dim(style, kind) ++ " " ++ quoted(string_of_bytes_lossy(test_info.name)) ++ " : "
    ++ dim(style, footprint_of(test_info.footprint))
}

fn module_block(
  style: Style,
  explain: Bool,
  analysis: Analysis,
  defs: List<DefInfo>,
  tests: List<TestInfo>,
  lines: List<String>,
  mo: ModuleFacts,
) -> List<String> / {abort.raise} = {
  let head = fold(
    mo.imports,
    push(push(lines, ""), indent() ++ bold(style, mo.name) ++ " " ++ dim(style, mo.path)),
    |acc: List<String>, im: String| push(acc, under() ++ dim(style, "import") ++ " " ++ im),
  );
  let ours = mine(mo.name, defs);
  let effected = fold(
    filter(analysis.checked.effects, |effect_info: EffectInfo|
      string_of_bytes_lossy(effect_info.module) == mo.name),
    head,
    |acc: List<String>, effect_info: EffectInfo| effect_lines(style, acc, effect_info),
  );
  let setted = if !explain { effected } else { set_blocks(effected, sets_of(analysis, mo, ours)) };
  let width = widest(ours);
  let defined = fold(ours, setted, |acc: List<String>, def_info: DefInfo|
    def_block(style, explain, width, acc, def_info));
  fold(
    filter(tests, |test_info: TestInfo| string_of_bytes_lossy(test_info.module) == mo.name),
    defined,
    |acc: List<String>, test_info: TestInfo| push(acc, test_line(style, test_info)),
  )
}

fn sets_of(
  analysis: Analysis,
  mo: ModuleFacts,
  defs: List<DefInfo>,
) -> List<SetLine> / {abort.raise} =
  match list_at(analysis.mods, mo.index) {
    None -> [],
    Some(m) -> effect_sets(effect_sets_of(analysis.r, analysis.checked.effects, mo.index, m), defs),
  }

fn type_lines(
  style: Style,
  explain: Bool,
  analysis: Analysis,
  views: List<ModuleFacts>,
  defs: List<DefInfo>,
  tests: List<TestInfo>,
) -> List<String> / {abort.raise} =
  fold(views, [], |acc: List<String>, mo: ModuleFacts|
    module_block(style, explain, analysis, defs, tests, acc, mo))

// --- The JSON document ---------------------------------------------------------------

fn set_json(v: SetLine) -> Json =
  object([
    { key: "name", value: Str(v.name) },
    { key: "expansion", value: Array(json_strings(v.atoms)) },
    { key: "used_by", value: number(v.used_by) },
  ])

fn module_json(
  explain: Bool,
  analysis: Analysis,
  defs: List<DefInfo>,
  mo: ModuleFacts,
) -> Json / {abort.raise} = {
  let named: List<Member> = [
    { key: "name", value: Str(mo.name) },
    { key: "file", value: Str(mo.path) },
    { key: "imports", value: Array(json_strings(mo.imports)) },
    { key: "items", value: Array(json_strings(mo.items)) },
  ];
  let fields: List<Member> = if !explain { named } else {
    push(named, {
      key: "effect_sets",
      value: Array(map(sets_of(analysis, mo, mine(mo.name, defs)), set_json)),
    })
  };
  object(fields)
}

fn provenance_fields(def_info: DefInfo) -> List<Member> / {abort.raise} =
  [
    { key: "written_as", value: Array(json_strings(texts(def_info.row_aliases))) },
    {
      key: "performed",
      value: Array(
        json_strings(map(def_info.performed, |a: Atom| string_of_bytes_lossy(atom_text(a)))),
      ),
    },
    { key: "declared_not_performed", value: Array(json_strings(provenance(def_info).unperformed)) },
  ]

fn definition_json(explain: Bool, def_info: DefInfo) -> Json / {abort.raise} = {
  let named: List<Member> = [
    { key: "name", value: Str(string_of_bytes_lossy(def_info.name)) },
    { key: "module", value: Str(string_of_bytes_lossy(def_info.module)) },
    { key: "simple_name", value: Str(string_of_bytes_lossy(def_info.simple_name)) },
    { key: "type", value: Str(scheme_of(def_info)) },
    { key: "footprint", value: Str(footprint_of(def_info.footprint)) },
    { key: "atoms", value: Array(json_strings(atoms_of(def_info.footprint))) },
    { key: "scaling", value: Array(json_strings(atoms_of(def_info.scaling))) },
    { key: "repeats", value: Array(map(def_info.repeats, |i: Int| number(i))) },
  ];
  let fields: List<Member> = if !explain { named }
  else { fold(provenance_fields(def_info), named, |acc: List<Member>, f: Member| push(acc, f)) };
  object(fields)
}

fn test_json(test_info: TestInfo) -> Json / {abort.raise} =
  object([
    { key: "index", value: number(test_info.index) },
    { key: "key", value: Str(string_of_bytes_lossy(test_info.key)) },
    { key: "name", value: Str(string_of_bytes_lossy(test_info.name)) },
    { key: "module", value: Str(string_of_bytes_lossy(test_info.module)) },
    { key: "nondet", value: Bool(test_info.nondet) },
    { key: "footprint", value: Str(footprint_of(test_info.footprint)) },
  ])

fn op_json(o: OpInfo) -> Json / {abort.raise} =
  object([
    { key: "name", value: Str(string_of_bytes_lossy(o.name)) },
    { key: "mode", value: Str(mode_text(o.mode)) },
    { key: "resource_param", value: Bool(o.resource_param) },
    {
      key: "params",
      value: Array(json_strings(map(o.params, |t: Type| string_of_bytes_lossy(type_text(t))))),
    },
    { key: "returns", value: Str(string_of_bytes_lossy(type_text(o.ret))) },
  ])

fn effect_json(effect_info: EffectInfo) -> Json / {abort.raise} =
  object([
    { key: "name", value: Str(string_of_bytes_lossy(effect_info.name)) },
    { key: "module", value: Str(string_of_bytes_lossy(effect_info.module)) },
    { key: "simple_name", value: Str(string_of_bytes_lossy(effect_info.simple_name)) },
    { key: "nondet", value: Bool(effect_info.nondet) },
    { key: "operations", value: Array(map(effect_info.ops, op_json)) },
  ])

fn document(
  flags: Flags,
  timed: Timed,
  analysis: Analysis,
  views: List<ModuleFacts>,
  defs: List<DefInfo>,
  warnings: List<Diag>,
) -> Json / {abort.raise} = {
  let p: Program = timed.program;
  object([
    { key: "command", value: Str("check") },
    { key: "ok", value: Bool(true) },
    { key: "exit_code", value: number(ok_code()) },
    { key: "root", value: Str(flags.root) },
    { key: "files", value: Array(json_strings(map(p.places, |place: Place| place.path))) },
    {
      key: "modules",
      value: Array(map(views, |mo: ModuleFacts| module_json(flags.explain, analysis, defs, mo))),
    },
    {
      key: "definitions",
      value: Array(map(defs, |def_info: DefInfo| definition_json(flags.explain, def_info))),
    },
    { key: "tests", value: Array(map(own_tests(p, analysis), test_json)) },
    { key: "effects", value: Array(map(analysis.checked.effects, effect_json)) },
    {
      key: "front_end",
      value: object([
        { key: "phases", value: phases_json(timed) },
        { key: "definitions", value: seeding_json(analysis) },
        { key: "stubbed", value: Array(json_strings(texts(analysis.stubs))) },
      ]),
    },
    { key: "diagnostics", value: all_to_json(warnings, p.places) },
  ])
}

// --- The answer -----------------------------------------------------------------------

fn summary(
  style: Style,
  analysis: Analysis,
  defs: List<DefInfo>,
  tests: List<TestInfo>,
) -> String / {abort.raise} =
  indent() ++ green(style, "checked") ++ " " ++ count_of(len(analysis.mods), "module") ++ ", "
    ++ count_of(len(defs), "definition")
    ++ ", "
    ++ count_of(len(tests), "test")

fn costed(
  style: Style,
  flags: Flags,
  places: List<Place>,
  report: Report,
  lines: List<String>,
) -> List<String> / {abort.raise} =
  if !flags.costs { lines } else { append(lines, report_lines(style, places, report)) }

fn answered(
  style: Style,
  flags: Flags,
  timed: Timed,
  analysis: Analysis,
  report: Report,
  warnings: List<Diag>,
) -> Answer / {abort.raise} = {
  let views = module_facts(timed.program, analysis);
  let defs = published(analysis);
  let tests = own_tests(timed.program, analysis);
  let head = append([summary(style, analysis, defs, tests)], warning_lines(style, warnings));
  let explained = if flags.explain {
    append(append(head, phase_lines(style, timed)), seeding_lines(style, analysis))
  } else { head };
  let typed = if flags.types {
    append(explained, type_lines(style, flags.explain, analysis, views, defs, tests))
  } else { explained };
  {
    json: if flags.json { document(flags, timed, analysis, views, defs, warnings) }
    else { object([]) },
    lines: costed(style, flags, timed.program.places, report, typed),
    errs: [],
    code: ok_code(),
  }
}

// The cost pass answers both `--costs` and the `reuse fn` promise, and runs at most once.
fn checked(
  style: Style,
  flags: Flags,
  timed: Timed,
  analysis: Analysis,
) -> Answer / {priced.report, abort.raise} = {
  let kept = promised(timed.program, analysis);
  let asked = kept || flags.costs;
  let nothing: Report = { ok: true, rounds: 0, defs: [], unkept: [] };
  let r: Report = if asked { costs_of(timed.program, analysis) } else { nothing };
  let broken = if !r.ok { [unresolved()] } else if kept { promises(r) } else { [] };
  if len(broken) > 0 { refused(style, "check", broken, timed.program.places) } else {
    answered(
      style,
      flags,
      timed,
      analysis,
      r,
      filter(timed.program.diags, |diag: Diag| !is_shelved(timed.program, diag)),
    )
  }
}

pub fn run(
  flags: Flags,
) -> Answer / {builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shelf], fs.read_file[shelf], time.elapsed_ms, time.elapsed_us, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, priced.report, abort.raise} = {
  let t: Timed = timed_load(flags.paths, true, flags.verify_deps);
  match t.program.whole {
    None -> refused(style_of(flags), "check", t.program.diags, t.program.places),
    Some(w) -> checked(style_of(flags), flags, t, w),
  }
}

// --- Tests ------------------------------------------------------------------

fn plain() -> Style = { styled: false }

test "a share is a tenth of a percent, and a run that took no time at all is not a division" {
  assert_eq(share(984, 1000), " 98.4%");
  assert_eq(share(1, 1000), "  0.1%");
  assert_eq(share(0, 0), "  0.0%")
}

test "the longest phase is printed first, and the total accounts for all three" {
  let lines = phase_lines(plain(), {
    program: {
      files: [],
      places: [],
      diags: [],
      whole: None,
      pkgs: { root: b"", manifest: None, supplied: [] },
      through: [],
      embeds: [],
    },
    read_ms: 2,
    front_ms: 90,
    file_ms: 8,
    cached: true,
  });
  assert_eq(lines, [
    "",
    "   front-end time",
    "     front             90ms  90.0%",
    "     write back         8ms   8.0%",
    "     read               2ms   2.0%",
    "     total            100ms",
  ])
}

test "phases that took the same time are read in the order the load ran them" {
  assert_eq(
    map(
      ordered([
        { label: "read", ms: 0 },
        { label: "front", ms: 0 },
        { label: "write back", ms: 0 },
      ]),
      |phase: Phase| phase.label,
    ),
    ["read", "front", "write back"],
  )
}

test "the cache reading says how many definitions were seeded and how many were checked" {
  assert_eq(count_line("seeded", 2950), "     seeded          2950 definitions");
  assert_eq(count_line("checked", 1), "     checked            1 definition")
}

test "a test name is printed as the reference prints it, with the quotes escaped" {
  assert_eq(quoted("two is two"), "\"two is two\"");
  assert_eq(quoted("a \"quoted\" name"), "\"a \\\"quoted\\\" name\"")
}
