//! `ply check` — the front end over a program, and as much of what it inferred as the flags ask
//! for. The summary line is the whole answer by default; `--types` prints every module's surface,
//! `--explain` says where the time went and where each row came from, and `--costs` says where an
//! update copies.

import compiler.memo (Tally)
import compiler.unit (shipped)
import std.random (entropy)
import builder (builder)
import args (Flags, style_of, no_flags, root_of)
import appends (costs_of, priced, promised, promises, report_lines, unresolved)
import literals (literal, unsettled)
import diagnostic (Place, all_to_json)
import program (Program, Timed, ModuleReport, timed_over, module_reports, published,
                in_shipped_module, own_tests, placed_of, location_of, whole_of, no_program,
                program_view, command_kept, keep_command, resolved_fields)
import queried
import queried (command_key)
import env (env)
import paths
import paths (Resolved)
import sources (Project, load_resolved)
import std.bytes (hex_of)
import compiler.hash (hex)
import std.bin
import std.hash (blake3)
import report (Answer, ok_code, count_of, indent, refused, warning_lines)
import signature (SetLine, Provenance, counted_lines, effect_sets, provenance, provenance_lines,
                  set_lines, atom_texts, raise_text, raise_kind)
import std.term (Style, bold, dim, green, plain)
import compiler.costs (Report, Costing)
import compiler.termination (Ends, Stated, Diverges, Site)
import compiler.front (View, Frame, Outline, functions_of, tests_of)
import compiler.infer (DefInfo, TestInfo, EffectInfo, OpInfo, Location, dump_flag, Raise, Unshown,
                       Unguarded, Calls)
import compiler.resolve (Diag, Label)
import compiler.types (Atom, Type, printer_new, print_atom_list, scheme_text, row_text, type_text,
                       atom_text)
import compiler.type_syntax (Mode, MRead, MWrite, MBad, MRaise, is_raise)
import std.fs (fs)
import std.json (Json, Member, Str, Bool, Number, Array, Object, Null, object, parse_string,
                 to_string, int)
import std.time (time)
import std.list (at, at_or, concat)
import std.string (join, pad_right, repeat, pad_left)
import defs (scheme_of)
import proof.obligation (plural)
import compiler.interface (sized)

/// `indent()` plus the two spaces that put a definition under its module heading.
fn types_indent() -> Int = 5

fn under() -> String = indent() ++ "  "

fn json_strings(ss: List<String>) -> List<Json> = map(ss, |s: String| Str(s))

/// As the reference prints a test's name: the bytes, with the ones that would close the quotes escaped.
pub fn quoted(s: String) -> String = {
  let b = bytes_of_string(s);
  string_of_bytes_lossy(
    bytes_concat_all([
      b"\"",
      bytes_concat_all(
        map(range(0, bytes_len(b)), |i: Int| {
          let c = bytes_at(b, i);
          if c == 34 { b"\\\"" }
          else if c == 92 { b"\\\\" }
          else if c == 10 { b"\\n" }
          else if c == 13 { b"\\r" }
          else if c == 9 { b"\\t" }
          else { bytes_slice(b, i, i + 1) }
        }),
      ),
      b"\"",
    ]),
  )
}

fn mode_text(m: Mode) -> String =
  match m { MRead -> "read", MWrite -> "write", MBad -> "", MRaise -> "raise" }

fn footprint_of(atoms: List<Atom>) -> String / {abort.raise} =
  string_of_bytes_lossy(row_text({ atoms: atoms, tail: None }))

fn mine(name: String, defs: List<DefInfo>) -> List<DefInfo> =
  filter(defs, |def_info: DefInfo| string_of_bytes_lossy(def_info.module) == name)

// --- Where the time went ----------------------------------------------------------
// The clock the program reads counts whole milliseconds, so that is what a phase is reported in.

type Phase = { label: String, ms: Int }

fn share(ms: Int, total: Int) -> String = {
  // Per mille is tenths of a percent, so one division answers both digits.
  let tenths = if total == 0 { 0 } else { ms * 1000 / total };
  pad_left(int_to_string(tenths / 10) ++ "." ++ int_to_string(tenths % 10), 5, " ") ++ "%"
}

fn phase_line(style: Style, phase: Phase, total: Int) -> String =
  under() ++ pad_right(phase.label, 11, " ") ++ " " ++ pad_left(int_to_string(phase.ms), 8, " ")
    ++ "ms "
    ++ dim(style, share(phase.ms, total))

/// Longest first, so what dominated a run is read first; a tie keeps the order the load ran them in.
fn ordered(phases: List<Phase>) -> List<Phase> =
  fold(phases, [], |acc: List<Phase>, p: Phase| {
    let before = filter(acc, |q: Phase| q.ms >= p.ms);
    concat(push(before, p), filter(acc, |q: Phase| q.ms < p.ms))
  })

fn phase_lines(style: Style, timed: Timed) -> List<String> = {
  let total = timed.read_ms + timed.front_ms + timed.file_ms;
  let rows = ordered([
    { label: "read", ms: timed.read_ms },
    { label: "front", ms: timed.front_ms },
    { label: "write back", ms: timed.file_ms },
  ]);
  concat(
    concat(
      ["", indent() ++ bold(style, "front-end time")],
      map(rows, |phase: Phase| phase_line(style, phase, total)),
    ),
    [
      under() ++ pad_right("total", 11, " ") ++ " " ++ pad_left(int_to_string(total), 8, " ")
        ++ "ms",
    ],
  )
}

fn phases_json(timed: Timed) -> Json =
  object([
    { key: "read", value: int(timed.read_ms) },
    { key: "front", value: int(timed.front_ms) },
    { key: "write_back", value: int(timed.file_ms) },
    { key: "total", value: int(timed.read_ms + timed.front_ms + timed.file_ms) },
  ])

// --- Where the answer came from ---------------------------------------------------
// Each query a load asked answers from its record where every read the record made answers the
// same, and runs again where one does not.

fn count_line(label: String, n: Int, noun: String = "definition") -> String / {abort.raise} =
  under() ++ pad_right(label, 11, " ") ++ " " ++ pad_left(int_to_string(n), 8, " ") ++ " "
    ++ plural(n, noun)

fn tally_lines(style: Style, program: Program) -> List<String> =
  concat(
    ["", indent() ++ bold(style, "memo")],
    map(program.tallies, |t: Tally|
      under() ++ pad_right(string_of_bytes_lossy(t.query), 11, " ") ++ " "
        ++ pad_left(int_to_string(t.took), 8, " ")
        ++ " taken "
        ++ pad_left(int_to_string(t.ran), 8, " ")
        ++ " run"),
  )

/// What the cost pass walked, where it ran: the bodies it walked rather than took as an earlier run
/// kept them, and the modules it lowered to walk them.
fn cost_lines(style: Style, pass: Option<Costing>) -> List<String> / {abort.raise} =
  match pass {
    None -> [],
    Some(c) ->
      [
        "",
        indent() ++ bold(style, "cost pass"),
        count_line("walked", c.walked, "body"),
        count_line("lowered", c.lowered, "module"),
      ],
  }

fn cost_json(pass: Option<Costing>) -> Json =
  match pass {
    None -> Null,
    Some(c) ->
      object([{ key: "walked", value: int(c.walked) }, { key: "lowered", value: int(c.lowered) }]),
  }

fn tallies_json(program: Program) -> Json =
  Array(
    map(program.tallies, |t: Tally|
      object([
        { key: "query", value: Str(string_of_bytes_lossy(t.query)) },
        { key: "taken", value: int(t.took) },
        { key: "run", value: int(t.ran) },
      ])),
  )

// --- `--types` ---------------------------------------------------------------------

fn op_line(style: Style, o: OpInfo) -> String / {abort.raise} = {
  let resource = if o.resource_param { "[r]" } else { "" };
  indent() ++ "    " ++ dim(style, mode_text(o.mode)) ++ " " ++ string_of_bytes_lossy(o.name)
    ++ resource
    ++ "("
    ++ join(map(o.params, |t: Type| string_of_bytes_lossy(type_text(t))), ", ")
    ++ ")"
    ++ (if is_raise(o.mode) { "" } else { " -> " ++ string_of_bytes_lossy(type_text(o.ret)) })
}

fn effect_lines(
  style: Style,
  lines: List<String>,
  effect_info: EffectInfo,
) -> List<String> / {abort.raise} = {
  let marker = if effect_info.nondet { "nondet effect" } else { "effect" };
  let head = push(
    lines,
    under() ++ dim(style, marker) ++ " "
      ++ bold(style, string_of_bytes_lossy(effect_info.simple_name)),
  );
  fold(effect_info.ops, head, |acc: List<String>, o: OpInfo| push(acc, op_line(style, o)))
}

fn set_block(lines: List<String>, v: SetLine) -> List<String> / {abort.raise} =
  fold(set_lines(v, types_indent()), push(lines, ""), |acc: List<String>, l: String|
    push(acc, under() ++ l))

fn set_blocks(lines: List<String>, sets: List<SetLine>) -> List<String> / {abort.raise} = {
  let blocks = fold(sets, lines, set_block);
  if len(sets) == 0 { blocks } else { push(blocks, "") }
}

fn widest(defs: List<DefInfo>) -> Int =
  fold(defs, 0, |acc: Int, def_info: DefInfo| {
    let n = string_len(string_of_bytes_lossy(def_info.simple_name));
    if n > acc { n } else { acc }
  })

/// What a definition's row declares and its body does not perform. A definition a law schema is
/// carries the row the compiler gives every schema so that any law body fits it, and is held to none.
fn provenance_in(schemas: Map<Bytes, Bool>, def_info: DefInfo) -> Provenance / {abort.raise} =
  if map_contains(schemas, def_info.name) {
    { ..provenance(def_info), performed: None, unperformed: [] }
  } else { provenance(def_info) }

fn def_block(
  style: Style,
  explain: Bool,
  program: Program,
  schemas: Map<Bytes, Bool>,
  located: Map<Bytes, Location>,
  width: Int,
  lines: List<String>,
  def_info: DefInfo,
) -> List<String> / {abort.raise} = {
  let said = fold(
    counted_lines(
      types_indent(),
      width,
      string_of_bytes_lossy(def_info.simple_name),
      def_info,
      diverging_at(program, located, def_info),
    ),
    lines,
    |acc: List<String>, l: String| push(acc, under() ++ l),
  );
  if !explain { said } else {
    fold(
      concat(
        provenance_lines(provenance_in(schemas, def_info), types_indent()),
        map(def_info.raises, |r: Raise|
          "  raises"
            ++ (match raise_at(program, def_info, r) { Some(p) -> " at " ++ p, None -> "" })
            ++ ": "
            ++ raise_text(r.why)),
      ),
      said,
      |acc: List<String>, l: String| push(acc, under() ++ dim(style, l)),
    )
  }
}

/// Where a raise is: in its definition's body, where that body is now.
fn raise_at(program: Program, def_info: DefInfo, r: Raise) -> Option<String> / {abort.raise} = {
  let start = def_info.at.span.start;
  location_of(program, {
    module: def_info.at.module,
    span: { start: start + r.span.start, end: start + r.span.end },
  })
}

fn raise_json(program: Program, def_info: DefInfo, r: Raise) -> Json / {abort.raise} = {
  let named = |name: Bytes| Str(string_of_bytes_lossy(name));
  let said: List<Member> = [
    { key: "at", value: match raise_at(program, def_info, r) { Some(p) -> Str(p), None -> Null } },
    { key: "kind", value: Str(raise_kind(r.why)) },
    { key: "why", value: Str(raise_text(r.why)) },
  ];
  object(match r.why {
    Unshown(u) ->
      push(push(said, { key: "callee", value: named(u.callee) }), {
        key: "requires",
        value: named(u.needs),
      }),
    Unguarded(name) -> push(said, { key: "callee", value: named(name) }),
    Calls(name) -> push(said, { key: "callee", value: named(name) }),
    _ -> said,
  })
}

/// Each definition's location, by its qualified name.
fn locations(defs: List<DefInfo>) -> Map<Bytes, Location> =
  fold(defs, map_new(), |acc: Map<Bytes, Location>, def_info: DefInfo|
    map_insert(acc, def_info.name, def_info.at))

/// Where a call is: in its caller's body, where that body is now.
fn site_at(
  program: Program,
  located: Map<Bytes, Location>,
  site: Site,
) -> Option<String> / {abort.raise} =
  match map_get(located, site.caller) {
    Some(caller) -> {
      let start = caller.span.start;
      location_of(program, {
        module: caller.module,
        span: { start: start + site.span.start, end: start + site.span.end },
      })
    },
    None -> None,
  }

/// Where the call is by which a definition may not return.
fn diverging_at(
  program: Program,
  located: Map<Bytes, Location>,
  def_info: DefInfo,
) -> Option<String> / {abort.raise} =
  match def_info.ending { Diverges(d) -> site_at(program, located, d.at), _ -> None }

fn test_line(style: Style, test_info: TestInfo) -> String / {abort.raise} = {
  let kind = if test_info.nondet { "test/nondet" } else { "test" };
  under() ++ dim(style, kind) ++ " " ++ quoted(string_of_bytes_lossy(test_info.name)) ++ " : "
    ++ dim(style, footprint_of(test_info.footprint))
}

fn module_block(
  style: Style,
  explain: Bool,
  program: Program,
  analysis: View,
  schemas: Map<Bytes, Bool>,
  located: Map<Bytes, Location>,
  defs: List<DefInfo>,
  tests: List<TestInfo>,
  lines: List<String>,
  mo: ModuleReport,
) -> List<String> / {abort.raise} = {
  let head = fold(
    mo.imports,
    push(push(lines, ""), indent() ++ bold(style, mo.name) ++ " " ++ dim(style, mo.path)),
    |acc: List<String>, im: String| push(acc, under() ++ dim(style, "import") ++ " " ++ im),
  );
  let ours = mine(mo.name, defs);
  let effected = fold(
    filter(analysis.checked.effects, |effect_info: EffectInfo|
      string_of_bytes_lossy(effect_info.module) == mo.name),
    head,
    |acc: List<String>, effect_info: EffectInfo| effect_lines(style, acc, effect_info),
  );
  let setted = if !explain { effected } else { set_blocks(effected, sets_of(analysis, mo, ours)) };
  let width = widest(ours);
  let defined = fold(ours, setted, |acc: List<String>, def_info: DefInfo|
    def_block(style, explain, program, schemas, located, width, acc, def_info));
  fold(
    filter(tests, |test_info: TestInfo| string_of_bytes_lossy(test_info.module) == mo.name),
    defined,
    |acc: List<String>, test_info: TestInfo| push(acc, test_line(style, test_info)),
  )
}

fn sets_of(view: View, mo: ModuleReport, defs: List<DefInfo>) -> List<SetLine> / {abort.raise} =
  match list_at(view.frame.outlines, mo.index) { None -> [], Some(o) -> effect_sets(o.sets, defs) }

/// Each schema the program declares, and each schema's guard, by program-wide name.
fn schemas_of(view: View) -> Map<Bytes, Bool> =
  fold(view.frame.outlines, map_new(), |acc: Map<Bytes, Bool>, o: Outline|
    fold(o.schemas, acc, |a: Map<Bytes, Bool>, n: Bytes| map_insert(a, n, true)))

fn type_lines(
  style: Style,
  explain: Bool,
  program: Program,
  analysis: View,
  views: List<ModuleReport>,
  defs: List<DefInfo>,
  tests: List<TestInfo>,
) -> List<String> / {abort.raise} = {
  let located = locations(defs);
  let schemas = schemas_of(analysis);
  fold(views, [], |acc: List<String>, mo: ModuleReport|
    module_block(style, explain, program, analysis, schemas, located, defs, tests, acc, mo))
}

// --- The JSON document ---------------------------------------------------------------

fn set_json(v: SetLine) -> Json =
  object([
    { key: "name", value: Str(v.name) },
    { key: "expansion", value: Array(json_strings(v.atoms)) },
    { key: "used_by", value: int(v.used_by) },
  ])

fn module_json(
  explain: Bool,
  analysis: View,
  defs: List<DefInfo>,
  mo: ModuleReport,
) -> Json / {abort.raise} = {
  let named: List<Member> = [
    { key: "name", value: Str(mo.name) },
    { key: "file", value: Str(mo.path) },
    { key: "imports", value: Array(json_strings(mo.imports)) },
    { key: "items", value: Array(json_strings(mo.items)) },
  ];
  let fields: List<Member> = if !explain { named } else {
    push(named, {
      key: "effect_sets",
      value: Array(map(sets_of(analysis, mo, mine(mo.name, defs)), set_json)),
    })
  };
  object(fields)
}

fn provenance_fields(
  program: Program,
  schemas: Map<Bytes, Bool>,
  def_info: DefInfo,
) -> List<Member> / {abort.raise} =
  [
    {
      key: "written_as",
      value: Array(json_strings(map(def_info.row_aliases, string_of_bytes_lossy))),
    },
    {
      key: "performed",
      value: Array(
        json_strings(map(def_info.performed, |a: Atom| string_of_bytes_lossy(atom_text(a)))),
      ),
    },
    {
      key: "declared_not_performed",
      value: Array(json_strings(provenance_in(schemas, def_info).unperformed)),
    },
    {
      key: "raises",
      value: Array(map(def_info.raises, |r: Raise| raise_json(program, def_info, r))),
    },
  ]

fn definition_json(
  program: Program,
  explain: Bool,
  schemas: Map<Bytes, Bool>,
  located: Map<Bytes, Location>,
  hash: Bytes,
  def_info: DefInfo,
) -> Json / {abort.raise} = {
  let named: List<Member> = [
    { key: "name", value: Str(string_of_bytes_lossy(def_info.name)) },
    { key: "module", value: Str(string_of_bytes_lossy(def_info.module)) },
    { key: "simple_name", value: Str(string_of_bytes_lossy(def_info.simple_name)) },
    { key: "hash", value: Str(string_of_bytes(hex(hash))) },
    { key: "type", value: Str(scheme_of(def_info)) },
    { key: "footprint", value: Str(footprint_of(def_info.footprint)) },
    { key: "atoms", value: Array(json_strings(atom_texts(def_info.footprint))) },
    { key: "scaling", value: Array(json_strings(atom_texts(def_info.scaling))) },
    { key: "repeats", value: Array(map(def_info.repeats, |i: Int| int(i))) },
    { key: "ending", value: ending_json(program, located, def_info) },
  ];
  let fields: List<Member> = if !explain { named } else {
    fold(provenance_fields(program, schemas, def_info), named, |acc: List<Member>, f: Member|
      push(acc, f))
  };
  object(fields)
}

/// How a definition's calls are known to return; one that may not names the call and where it is.
fn ending_json(
  program: Program,
  located: Map<Bytes, Location>,
  def_info: DefInfo,
) -> Json / {abort.raise} =
  match def_info.ending {
    Ends -> object([{ key: "kind", value: Str("ends") }]),
    Stated -> object([{ key: "kind", value: Str("stated") }]),
    Diverges(d) ->
      object([
        { key: "kind", value: Str("diverges") },
        {
          key: "through",
          value: match d.through { Some(n) -> Str(string_of_bytes_lossy(n)), None -> Null },
        },
        {
          key: "at",
          value: match diverging_at(program, located, def_info) { Some(p) -> Str(p), None -> Null },
        },
        {
          key: "loop",
          value: Array(
            map(d.loop, |site: Site|
              match site_at(program, located, site) { Some(p) -> Str(p), None -> Null }),
          ),
        },
      ]),
  }

fn test_json(hash: Bytes, test_info: TestInfo) -> Json / {abort.raise} =
  object([
    { key: "index", value: int(test_info.index) },
    { key: "key", value: Str(string_of_bytes_lossy(test_info.key)) },
    { key: "name", value: Str(string_of_bytes_lossy(test_info.name)) },
    { key: "module", value: Str(string_of_bytes_lossy(test_info.module)) },
    { key: "hash", value: Str(string_of_bytes(hex(hash))) },
    { key: "nondet", value: Bool(test_info.nondet) },
    { key: "footprint", value: Str(footprint_of(test_info.footprint)) },
  ])

fn op_json(o: OpInfo) -> Json / {abort.raise} =
  object([
    { key: "name", value: Str(string_of_bytes_lossy(o.name)) },
    { key: "mode", value: Str(mode_text(o.mode)) },
    { key: "resource_param", value: Bool(o.resource_param) },
    {
      key: "params",
      value: Array(json_strings(map(o.params, |t: Type| string_of_bytes_lossy(type_text(t))))),
    },
    { key: "returns", value: Str(string_of_bytes_lossy(type_text(o.ret))) },
  ])

fn effect_json(effect_info: EffectInfo) -> Json / {abort.raise} =
  object([
    { key: "name", value: Str(string_of_bytes_lossy(effect_info.name)) },
    { key: "module", value: Str(string_of_bytes_lossy(effect_info.module)) },
    { key: "simple_name", value: Str(string_of_bytes_lossy(effect_info.simple_name)) },
    { key: "nondet", value: Bool(effect_info.nondet) },
    { key: "operations", value: Array(map(effect_info.ops, op_json)) },
  ])

fn document(
  flags: Flags,
  timed: Timed,
  analysis: View,
  views: List<ModuleReport>,
  defs: List<DefInfo>,
  warnings: List<Diag>,
  pass: Option<Costing>,
) -> Json / {abort.raise} = {
  let p: Program = timed.program;
  let located = locations(defs);
  let schemas = schemas_of(analysis);
  let hashes = fold(
    analysis.frame.hashes.defs,
    map_new(),
    |acc: Map<Bytes, Bytes>, d: { name: Bytes, hash: Bytes }| map_insert(acc, d.name, d.hash),
  );
  object([
    { key: "command", value: Str("check") },
    { key: "ok", value: Bool(true) },
    { key: "exit_code", value: int(ok_code()) },
    { key: "root", value: Str(flags.root) },
    { key: "files", value: Array(json_strings(map(p.places, |place: Place| place.path))) },
    {
      key: "modules",
      value: Array(map(views, |mo: ModuleReport| module_json(flags.explain, analysis, defs, mo))),
    },
    {
      key: "definitions",
      value: Array(
        map(defs, |def_info: DefInfo|
          definition_json(
            p,
            flags.explain,
            schemas,
            located,
            match map_get(hashes, def_info.name) { Some(h) -> h, None -> b"" },
            def_info,
          )),
      ),
    },
    {
      key: "tests",
      value: Array(
        map(own_tests(p, analysis), |t: TestInfo|
          test_json(
            match map_get(analysis.frame.hashes.tests, t.key) { Some(h) -> h, None -> b"" },
            t,
          )),
      ),
    },
    { key: "effects", value: Array(map(analysis.checked.effects, effect_json)) },
    {
      key: "front_end",
      value: object([
        { key: "phases", value: phases_json(timed) },
        { key: "queries", value: tallies_json(timed.program) },
      ]),
    },
    { key: "cost_pass", value: cost_json(pass) },
    { key: "diagnostics", value: all_to_json(warnings, p.places) },
  ])
}

// --- The answer -----------------------------------------------------------------------

/// The modules, definitions and own tests `frame` holds of `program`.
fn summary(style: Style, program: Program, frame: Frame) -> String / {abort.raise} =
  indent() ++ green(style, "checked") ++ " " ++ count_of(len(frame.outlines), "module") ++ ", "
    ++ count_of(functions_of(frame), "definition")
    ++ ", "
    ++ count_of(tests_of(frame, len(program.files)), "test")

fn costed(
  style: Style,
  flags: Flags,
  places: List<Place>,
  report: Report,
  lines: List<String>,
) -> List<String> / {abort.raise} =
  if !flags.costs { lines } else { concat(lines, report_lines(style, places, report)) }

/// The answer over `frame`: the check's tables are read only for `--types` and `--json`, which list
/// them.
fn answered(
  style: Style,
  flags: Flags,
  timed: Timed,
  frame: Frame,
  pass: Option<Costing>,
  warnings: List<Diag>,
) -> Answer / {abort.raise} = {
  let head = concat([summary(style, timed.program, frame)], warning_lines(style, warnings));
  let explained = if flags.explain {
    concat(
      concat(concat(head, phase_lines(style, timed)), tally_lines(style, timed.program)),
      cost_lines(style, pass),
    )
  } else { head };
  let read = if flags.types || flags.json { program_view(timed.program) } else { None };
  let listed = |v: View|
    {
      views: module_reports(timed.program, frame),
      defs: published(v),
      tests: own_tests(timed.program, v),
    };
  let typed = match read {
    Some(v) -> if !flags.types { explained } else {
      let l = listed(v);
      concat(
        explained,
        type_lines(style, flags.explain, timed.program, v, l.views, l.defs, l.tests),
      )
    },
    None -> explained,
  };
  {
    json: match read {
      Some(v) -> if !flags.json { object([]) } else {
        let l = listed(v);
        document(flags, timed, v, l.views, l.defs, warnings, pass)
      },
      None -> object([]),
    },
    lines: match pass {
      Some(c) -> costed(style, flags, timed.program.places, c.report, typed),
      None -> typed,
    },
    errs: [],
    code: ok_code(),
  }
}

/// The cost pass answers both `--costs` and the `reuse fn` promise, and runs at most once, over the
/// program analysed whole.
fn checked(
  style: Style,
  flags: Flags,
  timed: Timed,
  frame: Frame,
) -> Answer / {priced.report, literal.verdicts, literal.statements, abort.raise} = {
  let kept = promised(timed.program, frame);
  let pass = if !kept && !flags.costs { Ok(None) } else {
    match whole_of(timed.program) {
      Ok(w) -> Ok(Some(costs_of(timed.program, w))),
      Err(diags) -> Err(diags),
    }
  };
  let unkept = match pass {
    Err(diags) -> diags,
    Ok(None) -> [],
    Ok(Some(c)) -> if !c.report.ok { [unresolved()] }
    else if kept { promises(c.report) }
    else { [] },
  };
  let broken = if len(unkept) > 0 { unkept }
  else { unsettled(timed, frame, root_of(flags).machine) };
  if len(broken) > 0 { refused(style, "check", broken, timed.program.places) } else {
    answered(
      style,
      flags,
      timed,
      frame,
      match pass { Ok(p) -> p, Err(_) -> None },
      filter(timed.program.diags, |diag: Diag| !in_shipped_module(timed.program, diag)),
    )
  }
}

// --- An unchanged check ---------------------------------------------------------------
// A check's answer is a function of what its load asked, its walk, what each registry slot holds,
// the `ply` that answered and its flags; the memo store keeps it as a record of those, which a later
// check takes back while nothing it read moved.

/// A check's answer as the memo store keeps it.
type Replay = { lines: List<String>, errs: List<String>, code: Int, json: String }

derive bin for Replay

/// What names a check and the flags that shape its answer: the paths it was given and its root,
/// which its reports are relative to, and what it prints.
fn asked_of(flags: Flags) -> Bytes =
  bytes_concat_all([
    sized(b"ply check"),
    dump_flag(flags.json),
    dump_flag(flags.types),
    dump_flag(flags.costs),
    dump_flag(flags.color),
    dump_flag(flags.verify_deps),
    sized(bytes_of_string(flags.root)),
    resolved_fields(flags.paths),
  ])

fn filed_answer(a: Answer) -> Bytes / {abort.raise} =
  bin::encode({ lines: a.lines, errs: a.errs, code: a.code, json: to_string(a.json) }, replay_bin())

fn replayed(entry: Option<Bytes>) -> Option<Answer> / {abort.raise} =
  match entry {
    None -> None,
    Some(bytes) -> match bin::decode(bytes, replay_bin()) {
      Err(_) -> None,
      Ok(r) -> match parse_string(r.json) {
        Ok(json) -> Some({ json: json, lines: r.lines, errs: r.errs, code: r.code }),
        Err(_) -> None,
      },
    },
  }

/// The answer with its `front_end` member as `front` makes it: what the front end did is this run's,
/// whatever answer it takes.
fn with_front(a: Answer, front: (Json) -> Json) -> Answer =
  match a.json {
    Object(members) ->
      {
        ..a,
        json: Object(
          map_insert(
            members,
            "front_end",
            front(match map_get(members, "front_end") { Some(f) -> f, None -> Null }),
          ),
        ),
      },
    _ -> a,
  }

fn reuse_said(front: Json, said: List<Member>) -> Json =
  match front {
    Object(members) ->
      Object(
        fold(said, members, |acc: Map<String, Json>, m: Member| map_insert(acc, m.key, m.value)),
      ),
    _ -> object(said),
  }

/// A check run now, beside its load, and the answer a later check may take back: one the front end
/// answered whole.
fn checked_now(
  flags: Flags,
  project: Project,
  started: Int,
) -> { answer: Answer, filed: Option<Answer>, program: Program } / {shipped.answer, fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, priced.report, literal.verdicts, literal.statements, abort.raise, shipped.reached, env.reused[sys]} = {
  let t: Timed = timed_over(flags.paths, project, started, true, flags.verify_deps);
  match t.program.frame {
    None ->
      {
        answer: refused(style_of(flags), "check", t.program.diags, t.program.places),
        filed: None,
        program: t.program,
      },
    Some(f) -> {
      let answer = checked(style_of(flags), flags, t, f);
      { answer: answer, filed: Some(answer), program: t.program }
    },
  }
}

pub fn run(
  flags: Flags,
) -> Answer / {shipped.answer, builder.git[vcs], fs.kind[cwd], fs.kind[abs], fs.list_dir[cwd], fs.list_dir[abs], fs.read_file[cwd], fs.read_file[abs], fs.list_dir[shipped], fs.read_file[shipped], time.elapsed_ms, fs.read[cwd], fs.write[cwd], fs.read[abs], fs.write[abs], entropy.next, time.now_ms, priced.report, literal.verdicts, literal.statements, env.reused[sys], abort.raise, diverges, shipped.reached} = {
  let started = time.elapsed_ms();
  let project = load_resolved(flags.paths);
  // `--explain` says what this run's own phases took, which no kept answer knows.
  if flags.explain { checked_now(flags, project, started).answer } else {
    let key = command_key(queried::program(), asked_of(flags));
    let shown = hex_of(key);
    let kept = command_kept(flags.paths, project, key);
    match replayed(kept.output) {
      Some(answer) -> if !flags.json { answer } else {
        with_front(answer, |_: Json|
          object([{ key: "reused", value: Bool(true) }, { key: "key", value: Str(shown) }]))
      },
      None -> {
        let now = checked_now(flags, project, started);
        let filed = match now.filed {
          Some(own) ->
            keep_command(flags.paths, project, key, now.program, filed_answer(own), kept.marks),
          None -> false,
        };
        if !flags.json { now.answer } else {
          with_front(now.answer, |front: Json|
            reuse_said(front, [
              { key: "reused", value: Bool(false) },
              { key: "key", value: Str(shown) },
              { key: "filed", value: Bool(filed) },
            ]))
        }
      },
    }
  }
}

// --- Tests ------------------------------------------------------------------

test "a check is asked under its paths, root and the flags that shape its answer, and reads back whole" {
  let flags = { ..no_flags(), paths: [paths::here()] };
  let base = asked_of(flags);
  assert_eq(asked_of(flags), base);
  assert(asked_of({ ..flags, types: true }) != base);
  assert(asked_of({ ..flags, json: true }) != base);
  assert(asked_of({ ..flags, costs: true }) != base);
  assert(asked_of({ ..flags, color: true }) != base);
  assert(asked_of({ ..flags, verify_deps: true }) != base);
  assert(asked_of({ ..flags, paths: [paths::at_cwd("app")] }) != base);
  let answer: Answer = {
    json: object([{ key: "ok", value: Bool(true) }]),
    lines: ["   checked 1 module"],
    errs: ["a note"],
    code: 0,
  };
  assert_eq(replayed(Some(filed_answer(answer))), Some(answer));
  assert_eq(replayed(Some(b"not an answer")), None)
}

test "a share is a tenth of a percent, and a run that took no time at all is not a division" {
  assert_eq(share(984, 1000), " 98.4%");
  assert_eq(share(1, 1000), "  0.1%");
  assert_eq(share(0, 0), "  0.0%")
}

test "the longest phase is printed first, and the total accounts for all three" {
  let lines = phase_lines(plain(), {
    program: no_program(),
    read_ms: 2,
    front_ms: 90,
    file_ms: 8,
    cached: true,
  });
  assert_eq(lines, [
    "",
    "   front-end time",
    "     front             90ms  90.0%",
    "     write back         8ms   8.0%",
    "     read               2ms   2.0%",
    "     total            100ms",
  ])
}

test "phases that took the same time are read in the order the load ran them" {
  assert_eq(
    map(
      ordered([
        { label: "read", ms: 0 },
        { label: "front", ms: 0 },
        { label: "write back", ms: 0 },
      ]),
      |phase: Phase| phase.label,
    ),
    ["read", "front", "write back"],
  )
}

test "the cache reading says how many definitions were seeded and how many were checked" {
  assert_eq(count_line("seeded", 2950), "     seeded          2950 definitions");
  assert_eq(count_line("checked", 1), "     checked            1 definition")
}

test "a test name is printed as the reference prints it, with the quotes escaped" {
  assert_eq(quoted("two is two"), "\"two is two\"");
  assert_eq(quoted("a \"quoted\" name"), "\"a \\\"quoted\\\" name\"")
}
