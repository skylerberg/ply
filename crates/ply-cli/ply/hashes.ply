// `ply hash` — every definition and test under the hash content addressing keys it by, grouped by
// the module that declares it. The grouping is the one thing here that could be mistaken for part
// of a hash, so the listing says it is not.

import args (Flags, style_of)
import program (Program, ModuleView, Tables, load_program, published, tables_of, modules_of,
                deps_of, closure_of, hash_of, short_of)
import report (Answer, ok_code, count_of, ind, refused)
import style (Style, bold, dim)
import compiler.front (Whole)
import compiler.hash (hex)
import compiler.infer (DefInfo, TestInfo)
import std.fs (fs)
import std.json (Json, Null, Str, Bool, Number, Array, object)
import sources (File)

pub fn note() -> String =
  "module names, imports and `pub` are erased by normalization: moving a definition between modules changes no hash"

fn blank() -> String = "------------"

fn opt_str(v: Option<String>) -> Json = match v { Some(s) -> Str(s), None -> Null }

fn names_json(names: List<String>) -> Json = Array(map(names, |n: String| Str(n)))

fn edges(t: Tables, deps: Bool, key: Bytes, entry: List<{ key: String, value: Json }>) -> List<{ key: String, value: Json }> =
  if !deps { entry } else {
    push(push(entry, { key: "deps", value: names_json(deps_of(t, key)) }),
         { key: "closure", value: names_json(closure_of(t, key)) })
  }

fn definition_json(t: Tables, deps: Bool, d: DefInfo) -> Json = {
  let hash = hash_of(t, d.name);
  object(edges(t, deps, d.name,
    [{ key: "name", value: Str(string_of_bytes_lossy(d.name)) },
     { key: "module", value: Str(string_of_bytes_lossy(d.module)) },
     { key: "simple_name", value: Str(string_of_bytes_lossy(d.simple_name)) },
     { key: "hash", value: opt_str(hash) },
     { key: "short", value: opt_str(match hash { Some(h) -> Some(short_of(h)), None -> None }) }]))
}

fn test_hash(w: Whole, index: Int) -> Option<String> =
  match list_at(w.hashes.tests, index) { Some(h) -> Some(string_of_bytes_lossy(hex(h))), None -> None }

fn test_json(w: Whole, t: Tables, deps: Bool, x: TestInfo) -> Json =
  object(edges(t, deps, x.key,
    [{ key: "index", value: Number(decimal_of_int(x.index)) },
     { key: "key", value: Str(string_of_bytes_lossy(x.key)) },
     { key: "name", value: Str(string_of_bytes_lossy(x.name)) },
     { key: "module", value: Str(string_of_bytes_lossy(x.module)) },
     { key: "hash", value: opt_str(test_hash(w, x.index)) }]))

fn module_json(mo: ModuleView) -> Json =
  object([{ key: "name", value: Str(mo.name) }, { key: "file", value: Str(mo.path) }])

// --- The listing ------------------------------------------------------------

fn edge_lines(s: Style, t: Tables, key: Bytes, lines: List<String>) -> List<String> = {
  let named = deps_of(t, key);
  let reached = closure_of(t, key);
  let with_deps = if len(named) == 0 { lines } else {
    push(lines, ind() ++ "                " ++ dim(s, "deps:") ++ " " ++ commas(named))
  };
  if len(reached) == 0 { with_deps } else {
    push(with_deps, ind() ++ "                " ++ dim(s, "closure:") ++ " " ++ commas(reached))
  }
}

fn commas(names: List<String>) -> String =
  fold(range(0, len(names)), "", |acc: String, i: Int|
    match list_at(names, i) { Some(n) -> if i == 0 { n } else { acc ++ ", " ++ n }, None -> acc })

fn quoted(name: String) -> String = "\"" ++ name ++ "\""

fn def_lines(s: Style, t: Tables, deps: Bool, lines: List<String>, d: DefInfo) -> List<String> = {
  let hash = match hash_of(t, d.name) { Some(h) -> short_of(h), None -> blank() };
  let said = push(lines, ind() ++ "  " ++ dim(s, hash) ++ "  " ++ string_of_bytes_lossy(d.simple_name));
  if deps { edge_lines(s, t, d.name, said) } else { said }
}

fn test_lines(s: Style, w: Whole, t: Tables, deps: Bool, lines: List<String>, x: TestInfo) -> List<String> = {
  let hash = match test_hash(w, x.index) { Some(h) -> short_of(h), None -> blank() };
  let said = push(lines, ind() ++ "  " ++ dim(s, hash) ++ "  " ++ dim(s, "test") ++ " "
                         ++ quoted(string_of_bytes_lossy(x.name)));
  if deps { edge_lines(s, t, x.key, said) } else { said }
}

fn module_lines(s: Style, w: Whole, t: Tables, deps: Bool, defs: List<DefInfo>, lines: List<String>,
                mo: ModuleView) -> List<String> = {
  let head = push(push(lines, ""), ind() ++ bold(s, mo.name) ++ " " ++ dim(s, mo.path));
  let mine = filter(defs, |d: DefInfo| string_of_bytes_lossy(d.module) == mo.name);
  let after_defs = fold(mine, head, |acc: List<String>, d: DefInfo| def_lines(s, t, deps, acc, d));
  let its_tests = filter(w.checked.tests, |x: TestInfo| string_of_bytes_lossy(x.module) == mo.name);
  fold(its_tests, after_defs, |acc: List<String>, x: TestInfo| test_lines(s, w, t, deps, acc, x))
}

fn tally(s: Style, w: Whole, defs: Int) -> List<String> = {
  let tests = len(w.hashes.tests);
  let modules = len(w.mods);
  ["", ind() ++ count_of(defs, "definition") ++ " · " ++ count_of(tests, "test") ++ " · "
      ++ count_of(modules, "module"),
   ind() ++ dim(s, note())]
}

fn answered(s: Style, flags: Flags, p: Program, w: Whole) -> Answer = {
  let t: Tables = tables_of(w.hashes);
  let defs = published(w);
  let views = modules_of(p, w);
  let listed = fold(views, [], |acc: List<String>, mo: ModuleView| module_lines(s, w, t, flags.deps, defs, acc, mo));
  { json: object([{ key: "command", value: Str("hash") },
                  { key: "ok", value: Bool(true) },
                  { key: "exit_code", value: Number(decimal_of_int(ok_code())) },
                  { key: "root", value: Str(flags.root) },
                  { key: "files", value: Array(map(p.files, |f: File| Str(f.path))) },
                  { key: "modules", value: Array(map(views, module_json)) },
                  { key: "module_is_hashed", value: Bool(false) },
                  { key: "note", value: Str(note()) },
                  { key: "definitions", value: Array(map(defs, |d: DefInfo| definition_json(t, flags.deps, d))) },
                  { key: "tests", value: Array(map(w.checked.tests, |x: TestInfo| test_json(w, t, flags.deps, x))) },
                  { key: "diagnostics", value: Array([]) }]),
    lines: fold(tally(s, w, len(w.hashes.defs)), listed, |acc: List<String>, l: String| push(acc, l)),
    errs: [],
    code: ok_code() }
}

pub fn run(flags: Flags) -> Answer
  / {fs.kind[cwd], fs.list_dir[cwd], fs.read_file[cwd], fs.list_dir[shelf], fs.read_file[shelf]} = {
  let loaded: Program = load_program(flags.paths);
  match loaded.whole {
    None -> refused(style_of(flags), "hash", loaded.diags, loaded.places),
    Some(w) -> answered(style_of(flags), flags, loaded, w),
  }
}

// --- Tests ------------------------------------------------------------------

fn table_of(deps: List<{ name: Bytes, names: List<Bytes> }>) -> Tables =
  { defs: map_new(), own: map_new(),
    deps: fold(deps, map_new(), |acc: Map<Bytes, List<Bytes>>, x: { name: Bytes, names: List<Bytes> }|
      map_insert(acc, x.name, x.names)),
    closure: map_new(), specs: map_new() }

test "the note names what the grouping is not" {
  assert(string_contains(note(), "changes no hash"));
  assert_eq(blank(), "------------")
}

test "a name list is comma-separated, as the listing prints it" {
  assert_eq(commas([]), "");
  assert_eq(commas(["m.one"]), "m.one");
  assert_eq(commas(["m.one", "m.two"]), "m.one, m.two")
}

test "`--deps` adds the references and the closure, and nothing when there are none" {
  let t = table_of([{ name: b"m.two", names: [b"m.one"] }]);
  let said = edge_lines({ styled: false }, t, b"m.two", []);
  assert_eq(len(said), 1);
  assert(string_ends_with(match list_at(said, 0) { Some(l) -> l, None -> "" }, "deps: m.one"));
  assert_eq(edge_lines({ styled: false }, t, b"m.one", []), [])
}

test "a test is listed under its quoted name" {
  assert_eq(quoted("two is two"), "\"two is two\"")
}
